def bookOnePower : List ℤ → ℝ → ℝ
  | [], _ => 0
  | coefficient :: coefficients, x =>
      coefficient + x * bookOnePower coefficients x

def bookOneHomogenized : List ℤ → Polynomial ℤ
  | [] => 0
  | coefficient :: coefficients =>
      (coefficient * 1000 ^ coefficients.length :
          Polynomial ℤ) +
        (3 + 97 * Polynomial.X) *
          bookOneHomogenized coefficients

lemma eval₂_bookOneHomogenized
    (coefficients : List ℤ) (x : ℝ) :
    Polynomial.eval₂ (Int.castRingHom ℝ) x
        (bookOneHomogenized coefficients) *
          1000 =
      1000 ^ coefficients.length *
        bookOnePower coefficients
          ((3 + 97 * x) / 1000) := by
  induction coefficients with
  | nil =>
      simp [bookOneHomogenized, bookOnePower]
  | cons coefficient coefficients ih =>
      simp only [bookOneHomogenized, bookOnePower,
        List.length_cons, Polynomial.eval₂_add,
        Polynomial.eval₂_mul, Polynomial.eval₂_X]
      simp only [Polynomial.eval₂_ofNat] at *
      simp only [← Polynomial.C_eq_intCast,
        Polynomial.eval₂_C, Polynomial.eval₂_pow,
        Polynomial.eval₂_ofNat] at *
      rw [pow_succ]
      field_simp
      linear_combination (3 + 97 * x) * ih

def bookOneBernsteinPolynomial : Polynomial ℤ :=
  ∑ i ∈ Finset.range 84,
    (bookOneBernsteinCoeffs.getD i 0 : Polynomial ℤ) *
      Polynomial.X ^ i *
        ((1 : Polynomial ℤ) - Polynomial.X) ^ (83 - i)

set_option maxHeartbeats 0 in
-- Exact normalization of the degree-83 polynomial identity exceeds the default heartbeat budget.
set_option maxRecDepth 20000 in
-- The same exact normalization exceeds the default simplifier recursion depth.
lemma book_one_polynomial_identity :
    ((bookOneScale : ℤ) : Polynomial ℤ) *
        bookOneHomogenized bookOnePowerCoeffs =
      (1000 ^ 83 : Polynomial ℤ) *
        bookOneBernsteinPolynomial := by
  norm_num [bookOneBernsteinPolynomial,
    bookOneHomogenized, bookOnePowerCoeffs,
    bookOneBernsteinCoeffs, bookOneScale,
    decimalNat, Finset.sum_range_succ]
  ring

end

