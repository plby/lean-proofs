import Arxiv.Arxiv2411_18291.SparseSignedAbsorber
import Arxiv.Arxiv2411_18291.BoundedRepresentation
import Arxiv.Arxiv2411_18291.BoundedMultiplicityRepresentation

/-!
# Absorbing every leave generated by a sparse clique family

Add the uniformly chosen local decoders, normalize all integral
representations, and apply the sparse signed absorber. The input family
may have any fixed edge multiplicity bound; its integer coefficients are
unrestricted. Constructing a sparse generating family with such a fixed
bound is the remaining integral-absorber task.
-/

open Finset Filter

noncomputable section

namespace Arxiv2411_18291

variable {V : Type*} [Fintype V] [DecidableEq V] {q r : ℕ}

theorem IsGraphBounded.union {G H : Hypergraph V (r + 1)} {θ η : ℝ}
    (hG : IsGraphBounded G θ) (hH : IsGraphBounded H η) : IsGraphBounded (G ∪ H) (θ + η) := by
  intro S
  rw [filter_union]
  have hc : (((G.filter fun e => S.val ⊆ e.val) ∪
      (H.filter fun e => S.val ⊆ e.val)).card : ℝ) ≤
      (G.filter fun e => S.val ⊆ e.val).card + (H.filter fun e => S.val ⊆ e.val).card := by
    exact_mod_cast card_union_le (G.filter fun e => S.val ⊆ e.val)
      (H.filter fun e => S.val ⊆ e.val)
  exact hc.trans_lt ((add_lt_add (hG S) (hH S)).trans_eq (add_mul _ _ _).symm)

/-- All leaves integrally generated by `D` can be absorbed by the same host. -/
def AbsorbsGeneratedLeaves (D : Finset (Block V q)) (B H : Hypergraph V r) : Prop :=
  ∀ J : Hypergraph V r, J ⊆ B → GeneratedBy D (indicator J) → HasDecomposition q (H ∪ J)

omit [Fintype V] [DecidableEq V] in
theorem exists_sparse_absorber_for_generated_leaves_of_multiplicity
    (hqr : r + 1 < q) (M₀ : ℕ) {ρ : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ K : ℝ, 1 ≤ K ∧ ∀ᶠ n : ℕ in atTop, ∀ B : Hypergraph (Fin n) (r + 1),
      ∀ D : Finset (Block (Fin n) q), IsGraphBounded B ((n : ℝ) ^ (-ρ)) →
      cliqueSupport (r + 1) D ⊆ B →
      (∀ e : Block (Fin n) (r + 1), (D.filter fun Q => e.val ⊆ Q.val).card ≤ M₀) →
      ∃ H : Hypergraph (Fin n) (r + 1), HasDecomposition q H ∧ Disjoint H B ∧
        IsGraphBounded H (K * (n : ℝ) ^ (-ρ)) ∧ AbsorbsGeneratedLeaves D B H := by
  let C : ℕ := (M₀ + 1) * (2 ^ q * (r + 1).factorial)
  let M : ℕ := M₀ + q.choose (r + 1)
  let Kdec : ℝ := 1 + 4 * (r + 1).factorial * (q + (r + 1)).choose (r + 1)
  let A : ℝ := (M : ℝ) * (1 + Kdec)
  have hC : 0 < C := by dsimp [C]; positivity
  have hM : 0 < M := Nat.add_pos_right M₀ (Nat.choose_pos hqr.le)
  have hMreal : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hKdec : 1 ≤ Kdec := by
    apply le_add_of_nonneg_right
    positivity
  have hA : 1 ≤ A := one_le_mul_of_one_le_of_one_le hMreal (by linarith)
  have hscale : 1 + Kdec ≤ A := by
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hMreal
      (show 0 ≤ 1 + Kdec by linarith)
  obtain ⟨K, hK, habs⟩ :=
    exists_sparse_absorber_for_bounded_representations hqr C M hC hA hρ hρ1
  refine ⟨K, hK, ?_⟩
  filter_upwards [habs,
    eventually_exists_bounded_multiplicity_representation_family hqr M₀ hρ hρ1]
    with n hhost hdecode
  intro B D hB hDB hmult
  obtain ⟨D₂, hD₂, hB₂, hrep⟩ := hdecode B D hB hDB hmult
  let B' := B ∪ cliqueSupport (r + 1) D₂
  let D' := D ∪ D₂
  have hb : IsGraphBounded B' ((1 + Kdec) * (n : ℝ) ^ (-ρ)) := by
    rw [add_mul, one_mul]
    exact hB.union hB₂
  have hdsub : cliqueSupport (r + 1) D' ⊆ B' := by
    dsimp only [D', B', cliqueSupport]
    rw [union_biUnion]
    exact union_subset_union hDB Subset.rfl
  have hm (e : Block (Fin n) (r + 1)) : (D'.filter fun Q => e.val ⊆ Q.val).card ≤ M := by
    dsimp only [D', M]
    rw [filter_union]
    exact (card_union_le _ _).trans (Nat.add_le_add (hmult e) (hD₂.multiplicity e))
  have hd : IsCliqueFamilyBounded r D' (A * (n : ℝ) ^ (-ρ)) := by
    simpa only [A, mul_assoc] using hb.cliqueFamilyBounded D' hM hm hdsub
  have hb' : IsGraphBounded B' (A * (n : ℝ) ^ (-ρ)) :=
    hb.mono (mul_le_mul_of_nonneg_right hscale (Real.rpow_nonneg (Nat.cast_nonneg n) _))
  obtain ⟨H, hH, hdis, hbound, hAbs⟩ := hhost D' B' hd hb' hdsub hm
  refine ⟨H, hH, Disjoint.mono_right subset_union_left hdis, hbound, ?_⟩
  intro J hJB hgen
  obtain ⟨Φ, hΦ, hs, hc⟩ := hrep J hJB hgen
  exact hAbs J (hJB.trans subset_union_left) Φ hc hs hΦ

omit [Fintype V] [DecidableEq V] in
theorem exists_sparse_absorber_for_generated_leaves (hqr : r + 1 < q) {ρ : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ K : ℝ, 1 ≤ K ∧ ∀ᶠ n : ℕ in atTop, ∀ B : Hypergraph (Fin n) (r + 1),
      ∀ D : Finset (Block (Fin n) q), IsGraphBounded B ((n : ℝ) ^ (-ρ)) →
      cliqueSupport (r + 1) D ⊆ B →
      (∀ e : Block (Fin n) (r + 1), (D.filter fun Q => e.val ⊆ Q.val).card ≤ 2) →
      ∃ H : Hypergraph (Fin n) (r + 1), HasDecomposition q H ∧ Disjoint H B ∧
        IsGraphBounded H (K * (n : ℝ) ^ (-ρ)) ∧ AbsorbsGeneratedLeaves D B H :=
  exists_sparse_absorber_for_generated_leaves_of_multiplicity hqr 2 hρ hρ1

end Arxiv2411_18291
