import Arxiv.Arxiv2411_18291.IntegralExchangeGeneration
import Arxiv.Arxiv2411_18291.ModularCliqueGenerators
import Arxiv.Arxiv2411_18291.CoefficientReduction

/-!
# Lifting modular subgroup membership to an integral representation

Every element of the subgroup generated by modular clique vectors is the
projection of an integer boundary on the same clique family. Local decoders
then correct its difference from the requested vector, provided that the
decoder support contains both vectors.
-/

open Finset

noncomputable section

namespace Arxiv2411_18291

variable {V : Type*} {q r : ℕ}

def modularProjection (N : ℕ) : (Block V r → ℤ) →+ (Block V r → ZMod N) where
  toFun := fun J e => (J e : ZMod N)
  map_zero' := by funext e; exact Int.cast_zero
  map_add' := by intro J K; funext e; exact Int.cast_add (J e) (K e)

variable [Fintype V] [DecidableEq V]

theorem modularProjection_clique (N : ℕ) (Q : Block V q) :
    modularProjection N (indicator (cliqueEdges r Q)) = modularCliqueVector N r Q := by
  funext e
  simp only [modularProjection, AddMonoidHom.coe_mk, ZeroHom.coe_mk, indicator,
    mem_cliqueEdges, modularCliqueVector]
  split_ifs <;> norm_num

theorem boundary_eq_sum_zsmul (Φ : Block V q → ℤ) :
    boundary r Φ = ∑ Q : Block V q, Φ Q • indicator (cliqueEdges r Q) := by
  funext e
  simp only [Finset.sum_apply, zsmul_eq_mul, Pi.mul_apply, Pi.intCast_apply, Int.cast_id,
    indicator, mem_cliqueEdges, mul_ite, mul_one, mul_zero, boundary]

theorem GeneratedBy.modular_mem {D F : Finset (Block V q)} {J : Block V r → ℤ}
    (hJ : GeneratedBy D J) (N : ℕ)
    (hD : ∀ Q ∈ D, modularCliqueVector N r Q ∈ generatedSubgroup (modularCliqueVector N r) F) :
    modularProjection N J ∈ generatedSubgroup (modularCliqueVector N r) F := by
  obtain ⟨Φ, rfl, hsΦ⟩ := hJ
  rw [boundary_eq_sum_zsmul, map_sum]
  apply AddSubgroup.sum_mem
  intro Q _
  rw [map_zsmul, modularProjection_clique]
  by_cases hQ : Q ∈ D
  · exact AddSubgroup.zsmul_mem _ (hD Q hQ) (Φ Q)
  · rw [hsΦ Q hQ, zero_zsmul]
    exact AddSubgroup.zero_mem _

theorem exists_integral_boundary_of_modular_generated (N : ℕ) (D : Finset (Block V q))
    {J : Block V r → ZMod N} (hJ : J ∈ generatedSubgroup (modularCliqueVector N r) D) :
    ∃ K : Block V r → ℤ, GeneratedBy D K ∧ modularProjection N K = J := by
  change J ∈ AddSubgroup.closure (modularCliqueVector N r '' (D : Set (Block V q))) at hJ
  induction hJ using AddSubgroup.closure_induction with
  | mem J hJ =>
    obtain ⟨Q, hQ, rfl⟩ := hJ
    exact ⟨indicator (cliqueEdges r Q), generatedBy_clique hQ, modularProjection_clique N Q⟩
  | zero => exact ⟨0, GeneratedBy.zero D, map_zero _⟩
  | add J L _ _ hJ hL =>
    obtain ⟨K, hK, hKJ⟩ := hJ
    obtain ⟨M, hM, hML⟩ := hL
    exact ⟨K + M, hK.add hM, by rw [map_add, hKJ, hML]⟩
  | neg J _ hJ =>
    obtain ⟨K, hK, hKJ⟩ := hJ
    refine ⟨-K, ?_, by rw [map_neg, hKJ]⟩
    simpa only [zero_sub] using (GeneratedBy.zero D).sub hK

theorem generatedBy_of_modular_membership (N : ℕ) (D F : Finset (Block V q))
    (E : Hypergraph V r) (hDF : D ⊆ F) (hDE : cliqueSupport r D ⊆ E)
    (hdecode : ∀ K : Block V r → ℤ, (∀ e, e ∉ E → K e = 0) →
      (∀ e, (N : ℤ) ∣ K e) → GeneratedBy F K)
    (J : Block V r → ℤ) (hsupport : ∀ e, e ∉ E → J e = 0)
    (hmod : modularProjection N J ∈ generatedSubgroup (modularCliqueVector N r) D) :
    GeneratedBy F J := by
  obtain ⟨K, hK, hKJ⟩ := exists_integral_boundary_of_modular_generated N D hmod
  have hKsupport : ∀ e, e ∉ E → K e = 0 := by
    obtain ⟨Φ, rfl, hsΦ⟩ := hK
    exact boundary_zero_outside_support D E Φ hsΦ hDE
  have hdifference : ∀ e, e ∉ E → (J - K) e = 0 := by
    intro e he
    rw [Pi.sub_apply, hsupport e he, hKsupport e he, sub_self]
  have hdiv (e : Block V r) : (N : ℤ) ∣ (J - K) e := by
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ N).mp
    have he : (K e : ZMod N) = (J e : ZMod N) := congrFun hKJ e
    rw [Pi.sub_apply, Int.cast_sub, he, sub_self]
  have hdiff := hdecode (J - K) hdifference hdiv
  simpa only [sub_add_cancel] using hdiff.add (hK.mono hDF)

end Arxiv2411_18291
