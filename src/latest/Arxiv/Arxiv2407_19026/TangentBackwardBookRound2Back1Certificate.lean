def evalPower : List ℤ → ℝ → ℝ
  | [], _ => 0
  | coefficient :: coefficients, x =>
      coefficient + x * evalPower coefficients x

def homogenizedAffine
    (denominator : ℕ) (left width : ℤ)
    (coefficients : List ℤ) : Polynomial ℤ :=
  match coefficients with
  | [] => 0
  | coefficient :: rest =>
      (coefficient * denominator ^ rest.length : Polynomial ℤ) +
        (Polynomial.C left + Polynomial.C width * Polynomial.X) *
          homogenizedAffine denominator left width rest

lemma eval₂_homogenizedAffine
    (denominator : ℕ) (left width : ℤ)
    (coefficients : List ℤ) (x : ℝ)
    (hden : denominator ≠ 0) :
    Polynomial.eval₂ (Int.castRingHom ℝ) x
        (homogenizedAffine denominator left width coefficients) *
        denominator =
      denominator ^ coefficients.length *
        evalPower coefficients
          (((left : ℝ) + (width : ℝ) * x) / denominator) := by
  induction coefficients with
  | nil =>
      simp [homogenizedAffine, evalPower]
  | cons coefficient coefficients ih =>
      simp only [homogenizedAffine, evalPower, List.length_cons,
        Polynomial.eval₂_add, Polynomial.eval₂_mul,
        Polynomial.eval₂_X]
      simp only [← Polynomial.C_eq_intCast,
        Polynomial.eval₂_C, Polynomial.eval₂_pow] at *
      rw [pow_succ]
      field_simp [hden]
      norm_num at *
      ring_nf at ih ⊢
      linear_combination
        ((left : ℝ) + (width : ℝ) * x) * ih

def bernsteinPolynomial (degree : ℕ)
    (coefficients : List ℕ) : Polynomial ℤ :=
  ∑ i ∈ Finset.range (degree + 1),
    (coefficients.getD i 0 : Polynomial ℤ) *
      Polynomial.X ^ i *
        ((1 : Polynomial ℤ) - Polynomial.X) ^
          (degree - i)

set_option maxHeartbeats 0 in
-- Normalizing the exact degree-49 blue-fit identity exceeds the default heartbeat budget.
set_option maxRecDepth 30000 in
-- The expanded integer polynomial also needs deeper simplifier recursion.
lemma blue_polynomial_identity :
    ((blueIdentityScale : ℤ) : Polynomial ℤ) *
        homogenizedAffine 1000 378 222
          bluePowerCoeffs =
      (1000 ^ 49 : Polynomial ℤ) *
        bernsteinPolynomial 49
          blueBernsteinCoeffs := by
  norm_num (config := { maxSteps := 1000000 })
    [bernsteinPolynomial, homogenizedAffine,
    bluePowerCoeffs, blueBernsteinCoeffs,
    blueIdentityScale, decimalNat,
    Finset.sum_range_succ]
  ring

