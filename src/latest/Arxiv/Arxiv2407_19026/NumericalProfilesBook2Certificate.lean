def bookTwoPower : List ℤ → ℝ → ℝ
  | [], _ => 0
  | coefficient :: coefficients, x =>
      coefficient + x * bookTwoPower coefficients x

def bookTwoHomogenized : List ℤ → Polynomial ℤ
  | [] => 0
  | coefficient :: coefficients =>
      (coefficient * 10 ^ coefficients.length :
          Polynomial ℤ) +
        (1 + 4 * Polynomial.X) *
          bookTwoHomogenized coefficients

lemma eval₂_bookTwoHomogenized
    (coefficients : List ℤ) (x : ℝ) :
    Polynomial.eval₂ (Int.castRingHom ℝ) x
        (bookTwoHomogenized coefficients) *
          10 =
      10 ^ coefficients.length *
        bookTwoPower coefficients
          ((1 + 4 * x) / 10) := by
  induction coefficients with
  | nil =>
      simp [bookTwoHomogenized, bookTwoPower]
  | cons coefficient coefficients ih =>
      simp only [bookTwoHomogenized, bookTwoPower,
        List.length_cons, Polynomial.eval₂_add,
        Polynomial.eval₂_mul, Polynomial.eval₂_X]
      simp only [Polynomial.eval₂_ofNat] at *
      simp only [← Polynomial.C_eq_intCast,
        Polynomial.eval₂_C, Polynomial.eval₂_pow,
        Polynomial.eval₂_ofNat] at *
      simp only [Polynomial.eval₂_one] at *
      rw [pow_succ]
      field_simp
      linear_combination (1 + 4 * x) * ih

def bookTwoBernsteinPolynomial : Polynomial ℤ :=
  ∑ i ∈ Finset.range 84,
    (bookTwoBernsteinCoeffs.getD i 0 : Polynomial ℤ) *
      Polynomial.X ^ i *
        ((1 : Polynomial ℤ) - Polynomial.X) ^ (83 - i)

set_option maxHeartbeats 0 in
-- Exact normalization of the degree-83 polynomial identity exceeds the default heartbeat budget.
set_option maxRecDepth 20000 in
-- The same exact normalization exceeds the default simplifier recursion depth.
lemma book_two_polynomial_identity :
    ((bookTwoScale : ℤ) : Polynomial ℤ) *
        bookTwoHomogenized bookTwoPowerCoeffs =
      (10 ^ 83 : Polynomial ℤ) *
        bookTwoBernsteinPolynomial := by
  norm_num [bookTwoBernsteinPolynomial,
    bookTwoHomogenized, bookTwoPowerCoeffs,
    bookTwoBernsteinCoeffs, bookTwoScale,
    decimalNat, Finset.sum_range_succ]
  ring

