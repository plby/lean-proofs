def forwardCoordPowerRound3 : List ℤ → ℝ → ℝ
  | [], _ => 0
  | coefficient :: coefficients, x =>
      coefficient + x * forwardCoordPowerRound3 coefficients x

def forwardCoordHomogenizedRound3 : List ℤ → Polynomial ℤ
  | [] => 0
  | coefficient :: coefficients =>
      (coefficient * 250 ^ coefficients.length :
          Polynomial ℤ) +
        (25 + 42 * Polynomial.X) *
          forwardCoordHomogenizedRound3 coefficients

lemma eval₂_forwardCoordHomogenizedRound3
    (coefficients : List ℤ) (x : ℝ) :
    Polynomial.eval₂ (Int.castRingHom ℝ) x
        (forwardCoordHomogenizedRound3 coefficients) *
          250 =
      250 ^ coefficients.length *
        forwardCoordPowerRound3 coefficients
          ((25 + 42 * x) / 250) := by
  induction coefficients with
  | nil =>
      simp [forwardCoordHomogenizedRound3,
        forwardCoordPowerRound3]
  | cons coefficient coefficients ih =>
      simp only [forwardCoordHomogenizedRound3,
        forwardCoordPowerRound3, List.length_cons,
        Polynomial.eval₂_add, Polynomial.eval₂_mul,
        Polynomial.eval₂_X]
      simp only [Polynomial.eval₂_ofNat] at *
      simp only [← Polynomial.C_eq_intCast,
        Polynomial.eval₂_C, Polynomial.eval₂_pow,
        Polynomial.eval₂_ofNat] at *
      rw [pow_succ]
      field_simp
      linear_combination (25 + 42 * x) * ih

