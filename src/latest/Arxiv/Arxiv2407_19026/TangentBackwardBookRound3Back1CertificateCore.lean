def bookPowerScale : ℕ :=
  bookNumeratorScale * 1000 ^ 110

def bookPowerCoeffs : List ℤ :=
  bookAffineTail0

set_option maxHeartbeats 500000 in
-- Checking the exact 111-coefficient affine identity exceeds the default budget.
set_option maxRecDepth 100000 in
-- Its definitional reduction also exceeds the default recursion depth.
lemma book_power_coeffs_affine :
    integerPowerAffine 1000 375 225 bookNumeratorCoeffs =
      bookPowerCoeffs := by
  rfl

set_option maxRecDepth 100000 in
-- Specializing the affine evaluator to 111 coefficients exceeds the default recursion depth.
lemma book_affine_eval (u : ℝ) :
    evalIntegerPower bookPowerCoeffs u * 1000 =
      1000 ^ 111 *
        evalIntegerPower bookNumeratorCoeffs
          (((375 : ℝ) + (225 : ℝ) * u) / 1000) := by
  rw [← book_power_coeffs_affine]
  have haffine :=
    evalIntegerPower_affine
      1000 375 225 bookNumeratorCoeffs u (by norm_num)
  rw [bookNumeratorCoeffs,
    bookNumeratorTail0_length] at haffine
  exact haffine

set_option maxHeartbeats 0 in
-- Exact Horner evaluation of the degree-110 margin on the left half exceeds the default budget.
set_option maxRecDepth 100000 in
-- The recursive rational interval calculation needs a deeper recursion limit.
lemma book_horner_lower_left :
    0 <
      (integerHornerInterval bookPowerCoeffs
        ({ lo := 0, hi := 1 / 2, le := by norm_num } :
          LeanCert.Core.IntervalRat)).lo := by
  norm_num (config := { maxSteps := 10000000 })
    [integerHornerInterval, bookPowerCoeffs,
    bookAffineTail0,
    LeanCert.Core.IntervalRat.singleton,
    LeanCert.Core.IntervalRat.add,
    LeanCert.Core.IntervalRat.mul,
    LeanCert.Core.IntervalRat.min4,
    LeanCert.Core.IntervalRat.max4,
    decimalNat]

