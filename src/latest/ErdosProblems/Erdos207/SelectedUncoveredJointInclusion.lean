import ErdosProblems.Erdos207.KernelJointInclusion

/-!
# Joint selection and survival for finite Markov kernels

The preliminary KSSS packing needs a mixed estimate: some prescribed
triangles are selected while some prescribed graph edges survive uncovered.
This file proves the abstract recurrence.  A transition grows the selected
set by at most one and shrinks the uncovered set.  Conditional survival of a
fixed edge set contributes `theta ^ |B|`; insertion of one missing selected
item contributes `delta`.
-/

namespace Erdos207

open Finset
open scoped BigOperators NNReal

noncomputable section

/-- A kernel only removes elements from the tracked uncovered set. -/
def IsAntitoneSetKernel
    {Omega Z : Type*} [Fintype Omega] [DecidableEq Z]
    (K : Omega → FiniteLaw Omega) (U : Omega → Finset Z) : Prop :=
  ∀ omega, (K omega).SupportedOn fun omega' ↦ U omega' ⊆ U omega

/-- The simultaneous event that all prescribed selected objects have
appeared and all prescribed uncovered objects still survive. -/
def SelectedUncoveredEvent
    {Omega W Z : Type*} [DecidableEq W] [DecidableEq Z]
    (R : Omega → Finset W) (U : Omega → Finset Z)
    (Q : Finset W) (B : Finset Z) (omega : Omega) : Prop :=
  Q ⊆ R omega ∧ B ⊆ U omega

/-- Recursive envelope generated by the mixed one-step recurrence. -/
def selectedUncoveredEnvelope (delta theta : ℝ≥0) (b : ℕ) :
    ℕ → ℕ → ℝ≥0
  | 0, 0 => 1
  | 0, _q + 1 => 0
  | t + 1, 0 => theta ^ b * selectedUncoveredEnvelope delta theta b t 0
  | t + 1, q + 1 =>
      theta ^ b * selectedUncoveredEnvelope delta theta b t (q + 1) +
        (q + 1 : ℕ) * delta *
          selectedUncoveredEnvelope delta theta b t q

@[simp]
lemma selectedUncoveredEnvelope_zero_zero (delta theta : ℝ≥0) (b : ℕ) :
    selectedUncoveredEnvelope delta theta b 0 0 = 1 := rfl

@[simp]
lemma selectedUncoveredEnvelope_zero_succ
    (delta theta : ℝ≥0) (b q : ℕ) :
    selectedUncoveredEnvelope delta theta b 0 (q + 1) = 0 := rfl

@[simp]
lemma selectedUncoveredEnvelope_succ_zero
    (delta theta : ℝ≥0) (b t : ℕ) :
    selectedUncoveredEnvelope delta theta b (t + 1) 0 =
      theta ^ b * selectedUncoveredEnvelope delta theta b t 0 := rfl

@[simp]
lemma selectedUncoveredEnvelope_succ_succ
    (delta theta : ℝ≥0) (b t q : ℕ) :
    selectedUncoveredEnvelope delta theta b (t + 1) (q + 1) =
      theta ^ b * selectedUncoveredEnvelope delta theta b t (q + 1) +
        (q + 1 : ℕ) * delta *
          selectedUncoveredEnvelope delta theta b t q := rfl

/-- Closed form of the mixed recurrence.  The descending factorial counts
the possible ordered insertion times; every other transition contributes
one full prescribed-edge survival factor. -/
theorem selectedUncoveredEnvelope_eq_descFactorial
    (delta theta : ℝ≥0) (b t q : ℕ) :
    selectedUncoveredEnvelope delta theta b t q =
      (t.descFactorial q : ℝ≥0) * delta ^ q *
        (theta ^ b) ^ (t - q) := by
  induction t generalizing q with
  | zero =>
      cases q <;> simp
  | succ t ih =>
      cases q with
      | zero =>
          simp [ih, pow_succ, mul_comm]
      | succ q =>
          rw [selectedUncoveredEnvelope_succ_succ, ih, ih]
          by_cases hlt : q < t
          · have hsub : t + 1 - (q + 1) = t - q := by omega
            have hpow : t - q = (t - (q + 1)) + 1 := by omega
            rw [hsub, hpow, pow_succ]
            have hdesc :
                (t + 1).descFactorial (q + 1) =
                  (q + 1) * t.descFactorial q +
                    t.descFactorial (q + 1) := by
              rw [Nat.succ_descFactorial_succ]
              simp only [Nat.descFactorial_succ]
              rw [← Nat.add_mul]
              congr 1
              omega
            rw [hdesc]
            push_cast
            ring
          · by_cases heq : q = t
            · subst q
              have hzero : t.descFactorial (t + 1) = 0 :=
                Nat.descFactorial_eq_zero_iff_lt.mpr (by omega)
              have hdf : (t + 1).descFactorial (t + 1) =
                  (t + 1) * t.factorial := by
                rw [Nat.succ_descFactorial_succ,
                  Nat.descFactorial_self]
              rw [hzero, Nat.descFactorial_self, hdf]
              push_cast
              simp [pow_succ]
              ring
            · have htq : t < q := by omega
              rw [Nat.descFactorial_eq_zero_iff_lt.mpr (by omega : t < q + 1),
                Nat.descFactorial_eq_zero_iff_lt.mpr htq,
                Nat.descFactorial_eq_zero_iff_lt.mpr
                  (by omega : t + 1 < q + 1)]
              simp

/-- The ordered insertion-time factor is at most the corresponding power of
the horizon. -/
theorem selectedUncoveredEnvelope_le_horizon
    (delta theta : ℝ≥0) (b t q : ℕ) :
    selectedUncoveredEnvelope delta theta b t q ≤
      (t : ℝ≥0) ^ q * delta ^ q *
        (theta ^ b) ^ (t - q) := by
  rw [selectedUncoveredEnvelope_eq_descFactorial]
  gcongr
  exact_mod_cast Nat.descFactorial_le_pow t q

/-- Product form used in (8.7): a cumulative insertion hazard controls each
prescribed selected triangle, while the remaining transitions control each
prescribed surviving edge. -/
theorem selectedUncoveredEnvelope_le_product
    (delta theta alpha eta : ℝ≥0) (b t q : ℕ)
    (hselected : (t : ℝ≥0) * delta ≤ alpha)
    (hsurvived : theta ^ (t - q) ≤ eta) :
    selectedUncoveredEnvelope delta theta b t q ≤
      alpha ^ q * eta ^ b := by
  calc
    selectedUncoveredEnvelope delta theta b t q ≤
        (t : ℝ≥0) ^ q * delta ^ q *
          (theta ^ b) ^ (t - q) :=
      selectedUncoveredEnvelope_le_horizon delta theta b t q
    _ = (((t : ℝ≥0) * delta) ^ q) *
          ((theta ^ (t - q)) ^ b) := by
      rw [mul_pow]
      congr 1
      simp only [← pow_mul, Nat.mul_comm]
    _ ≤ alpha ^ q * eta ^ b := by
      exact mul_le_mul (pow_le_pow_left' hselected q)
        (pow_le_pow_left' hsurvived b) zero_le zero_le

/-- The `NNReal` indicator of a proposition, totalized noncomputably. -/
noncomputable def nnrealIndicator (P : Prop) : ℝ≥0 :=
  by
    classical
    exact if P then 1 else 0

/-- A scalar retained exactly when a proposition holds. -/
noncomputable def nnrealIndicatorMul (P : Prop) (x : ℝ≥0) : ℝ≥0 :=
  by
    classical
    exact if P then x else 0

/-- One transition satisfies the mixed selected/surviving-set recurrence. -/
theorem kernel_probability_selectedUncovered_le
    {Omega W Z : Type*} [Fintype Omega]
    [DecidableEq W] [DecidableEq Z]
    (K : Omega → FiniteLaw Omega)
    (R : Omega → Finset W) (U : Omega → Finset Z)
    (delta theta : ℝ≥0)
    (hsingle : IsMonotoneSingleInsertionKernel K R)
    (hantitone : IsAntitoneSetKernel K U)
    (hsurvive : ∀ omega B, B ⊆ U omega →
      (K omega).probability (fun omega' ↦ B ⊆ U omega') ≤
        theta ^ B.card)
    (hpoint : ∀ omega x, x ∉ R omega → ∀ B, B ⊆ U omega →
      (K omega).probability (fun omega' ↦
        x ∈ R omega' ∧ B ⊆ U omega') ≤ delta)
    (omega : Omega) (Q : Finset W) (B : Finset Z) :
    (K omega).probability (SelectedUncoveredEvent R U Q B) ≤
      theta ^ B.card * nnrealIndicator
          (SelectedUncoveredEvent R U Q B omega) +
        ∑ x ∈ Q,
          nnrealIndicatorMul
            (SelectedUncoveredEvent R U (Q.erase x) B omega) delta := by
  classical
  by_cases hBU : B ⊆ U omega
  · by_cases hQR : Q ⊆ R omega
    · calc
        (K omega).probability (SelectedUncoveredEvent R U Q B) ≤
            (K omega).probability (fun omega' ↦ B ⊆ U omega') := by
          apply FiniteLaw.probability_mono
          intro omega' h
          exact h.2
        _ ≤ theta ^ B.card := hsurvive omega B hBU
        _ ≤ theta ^ B.card *
              nnrealIndicator (SelectedUncoveredEvent R U Q B omega) +
            ∑ x ∈ Q,
              nnrealIndicatorMul
                (SelectedUncoveredEvent R U (Q.erase x) B omega) delta := by
          simp only [SelectedUncoveredEvent, hQR, hBU, and_self,
            nnrealIndicator, if_true, mul_one]
          exact le_add_of_nonneg_right zero_le
    · have himp : ∀ omega',
          (R omega ⊆ R omega' ∧ (R omega' \ R omega).card ≤ 1) →
          SelectedUncoveredEvent R U Q B omega' →
          ∃ x ∈ Q, SelectedUncoveredEvent R U (Q.erase x) B omega ∧
            x ∈ R omega' ∧ B ⊆ U omega' := by
        intro omega' homega' htarget
        obtain ⟨x, hxQ, hxnot, herase⟩ :=
          exists_erase_subset_of_sdiff_card_le_one
            htarget.1 homega'.2 hQR
        exact ⟨x, hxQ, ⟨herase, hBU⟩, htarget.1 hxQ, htarget.2⟩
      have hmono : (K omega).probability
          (SelectedUncoveredEvent R U Q B) ≤
          (K omega).probability (fun omega' ↦
            ∃ x ∈ Q, SelectedUncoveredEvent R U (Q.erase x) B omega ∧
              x ∈ R omega' ∧ B ⊆ U omega') :=
        (K omega).probability_mono_of_supported (hsingle omega) himp
      have hunion := (K omega).probability_exists_le Q (fun x omega' ↦
        SelectedUncoveredEvent R U (Q.erase x) B omega ∧
          x ∈ R omega' ∧ B ⊆ U omega')
      calc
        (K omega).probability (SelectedUncoveredEvent R U Q B) ≤
            (K omega).probability (fun omega' ↦
              ∃ x ∈ Q,
                SelectedUncoveredEvent R U (Q.erase x) B omega ∧
                  x ∈ R omega' ∧ B ⊆ U omega') := hmono
        _ ≤ ∑ x ∈ Q, (K omega).probability (fun omega' ↦
              SelectedUncoveredEvent R U (Q.erase x) B omega ∧
                x ∈ R omega' ∧ B ⊆ U omega') := hunion
        _ ≤ ∑ x ∈ Q,
              nnrealIndicatorMul
                (SelectedUncoveredEvent R U (Q.erase x) B omega) delta := by
          apply sum_le_sum
          intro x hxQ
          by_cases hxold :
              SelectedUncoveredEvent R U (Q.erase x) B omega
          · simp only [nnrealIndicatorMul, if_pos hxold]
            have hxnotR : x ∉ R omega := by
              intro hxR
              apply hQR
              intro y hyQ
              by_cases hyx : y = x
              · simpa [hyx] using hxR
              · exact hxold.1 (mem_erase.mpr ⟨hyx, hyQ⟩)
            exact ((K omega).probability_mono fun omega' h ↦ h.2).trans
              (hpoint omega x hxnotR B hBU)
          · have hfalse : (fun omega' ↦
                SelectedUncoveredEvent R U (Q.erase x) B omega ∧
                  x ∈ R omega' ∧ B ⊆ U omega') =
                (fun _ : Omega ↦ False) := by
              funext omega'
              exact propext ⟨fun h ↦ hxold h.1, False.elim⟩
            rw [hfalse, FiniteLaw.probability_false]
            simp [nnrealIndicatorMul, hxold]
        _ = theta ^ B.card *
              nnrealIndicator (SelectedUncoveredEvent R U Q B omega) +
            ∑ x ∈ Q,
              nnrealIndicatorMul
                (SelectedUncoveredEvent R U (Q.erase x) B omega) delta := by
          simp [SelectedUncoveredEvent, nnrealIndicator,
            nnrealIndicatorMul, hQR]
  · have himpossible : ∀ omega',
        U omega' ⊆ U omega →
        ¬ SelectedUncoveredEvent R U Q B omega' := by
      intro omega' hsub htarget
      exact hBU (htarget.2.trans hsub)
    have hzero : (K omega).probability
        (SelectedUncoveredEvent R U Q B) = 0 := by
      apply le_antisymm
      · calc
          (K omega).probability (SelectedUncoveredEvent R U Q B) ≤
              (K omega).probability (fun _ ↦ False) := by
            apply (K omega).probability_mono_of_supported (hantitone omega)
            intro omega' hsub htarget
            exact himpossible omega' hsub htarget
          _ = 0 := FiniteLaw.probability_false _
      · exact zero_le
    rw [hzero]
    exact zero_le

/-- Averaging the one-step estimate gives the recurrence for one bind. -/
theorem bind_probability_selectedUncovered_le
    {Omega W Z : Type*} [Fintype Omega]
    [DecidableEq W] [DecidableEq Z]
    (K : Omega → FiniteLaw Omega)
    (R : Omega → Finset W) (U : Omega → Finset Z)
    (delta theta : ℝ≥0)
    (hsingle : IsMonotoneSingleInsertionKernel K R)
    (hantitone : IsAntitoneSetKernel K U)
    (hsurvive : ∀ omega B, B ⊆ U omega →
      (K omega).probability (fun omega' ↦ B ⊆ U omega') ≤
        theta ^ B.card)
    (hpoint : ∀ omega x, x ∉ R omega → ∀ B, B ⊆ U omega →
      (K omega).probability (fun omega' ↦
        x ∈ R omega' ∧ B ⊆ U omega') ≤ delta)
    (L : FiniteLaw Omega) (Q : Finset W) (B : Finset Z) :
    (FiniteLaw.bind L K).probability (SelectedUncoveredEvent R U Q B) ≤
      theta ^ B.card *
          L.probability (SelectedUncoveredEvent R U Q B) +
        delta * ∑ x ∈ Q,
          L.probability (SelectedUncoveredEvent R U (Q.erase x) B) := by
  classical
  rw [FiniteLaw.probability_bind]
  calc
    (∑ omega, L.mass omega *
        (K omega).probability (SelectedUncoveredEvent R U Q B)) ≤
      ∑ omega, L.mass omega *
        (theta ^ B.card *
            nnrealIndicator (SelectedUncoveredEvent R U Q B omega) +
          ∑ x ∈ Q,
            nnrealIndicatorMul
              (SelectedUncoveredEvent R U (Q.erase x) B omega) delta) := by
      apply sum_le_sum
      intro omega homega
      simpa only [mul_comm] using mul_le_mul_left
        (kernel_probability_selectedUncovered_le K R U delta theta
          hsingle hantitone hsurvive hpoint omega Q B) (L.mass omega)
    _ = theta ^ B.card *
          L.probability (SelectedUncoveredEvent R U Q B) +
        delta * ∑ x ∈ Q,
          L.probability (SelectedUncoveredEvent R U (Q.erase x) B) := by
      simp only [mul_add, sum_add_distrib]
      congr 1
      · unfold FiniteLaw.probability
        rw [Finset.mul_sum]
        apply sum_congr rfl
        intro omega homega
        by_cases h : SelectedUncoveredEvent R U Q B omega <;>
          simp [nnrealIndicator, h, mul_comm]
      · rw [show (∑ omega, L.mass omega *
              ∑ x ∈ Q,
                nnrealIndicatorMul
                  (SelectedUncoveredEvent R U (Q.erase x) B omega) delta) =
            ∑ omega, ∑ x ∈ Q, L.mass omega *
              nnrealIndicatorMul
                (SelectedUncoveredEvent R U (Q.erase x) B omega) delta by
            apply sum_congr rfl
            intro omega homega
            rw [Finset.mul_sum]]
        rw [Finset.sum_comm, Finset.mul_sum]
        apply sum_congr rfl
        intro x hx
        unfold FiniteLaw.probability
        rw [Finset.mul_sum]
        apply sum_congr rfl
        intro omega homega
        by_cases h : SelectedUncoveredEvent R U (Q.erase x) B omega <;>
          simp [nnrealIndicatorMul, h, mul_comm]

/-- Iterating the kernel from disjoint selected requirements and initially
surviving uncovered requirements is bounded by the recursive envelope. -/
theorem iterateKernel_probability_selectedUncovered_le
    {Omega W Z : Type*} [Fintype Omega] [DecidableEq Omega]
    [DecidableEq W] [DecidableEq Z]
    (K : Omega → FiniteLaw Omega)
    (R : Omega → Finset W) (U : Omega → Finset Z)
    (delta theta : ℝ≥0)
    (hsingle : IsMonotoneSingleInsertionKernel K R)
    (hantitone : IsAntitoneSetKernel K U)
    (hsurvive : ∀ omega B, B ⊆ U omega →
      (K omega).probability (fun omega' ↦ B ⊆ U omega') ≤
        theta ^ B.card)
    (hpoint : ∀ omega x, x ∉ R omega → ∀ B, B ⊆ U omega →
      (K omega).probability (fun omega' ↦
        x ∈ R omega' ∧ B ⊆ U omega') ≤ delta)
    (omega0 : Omega) (Q : Finset W) (B : Finset Z)
    (hdisjoint : Disjoint Q (R omega0)) (hB0 : B ⊆ U omega0)
    (t : ℕ) :
    (FiniteLaw.iterateKernel K t (FiniteLaw.pure omega0)).probability
        (SelectedUncoveredEvent R U Q B) ≤
      selectedUncoveredEnvelope delta theta B.card t Q.card := by
  classical
  induction t generalizing Q with
  | zero =>
      simp only [FiniteLaw.iterateKernel, FiniteLaw.probability_pure]
      by_cases hQ : Q = ∅
      · subst Q
        simp [SelectedUncoveredEvent, hB0]
      · have hnot : ¬ Q ⊆ R omega0 := by
          intro hsub
          obtain ⟨x, hxQ⟩ := nonempty_iff_ne_empty.mpr hQ
          exact disjoint_left.mp hdisjoint hxQ (hsub hxQ)
        obtain ⟨q, hq⟩ : ∃ q, Q.card = q + 1 :=
          Nat.exists_eq_succ_of_ne_zero
            (card_ne_zero.mpr (nonempty_iff_ne_empty.mpr hQ))
        simp [SelectedUncoveredEvent, hnot, hq]
  | succ t ih =>
      rw [FiniteLaw.iterateKernel_succ_right]
      have hrec := bind_probability_selectedUncovered_le
        K R U delta theta hsingle hantitone hsurvive hpoint
          (FiniteLaw.iterateKernel K t (FiniteLaw.pure omega0)) Q B
      by_cases hQ : Q = ∅
      · subst Q
        have hempty := ih ∅ (by simp)
        have hempty' :
            (FiniteLaw.iterateKernel K t
              (FiniteLaw.pure omega0)).probability
                (SelectedUncoveredEvent R U ∅ B) ≤
              selectedUncoveredEnvelope delta theta B.card t 0 := by
          simpa using hempty
        calc
          (FiniteLaw.bind
              (FiniteLaw.iterateKernel K t (FiniteLaw.pure omega0)) K).probability
                (SelectedUncoveredEvent R U ∅ B) ≤
              theta ^ B.card *
                (FiniteLaw.iterateKernel K t
                  (FiniteLaw.pure omega0)).probability
                    (SelectedUncoveredEvent R U ∅ B) := by
            simpa using hrec
          _ ≤ theta ^ B.card *
                selectedUncoveredEnvelope delta theta B.card t 0 := by
            simpa only [mul_comm] using
              mul_le_mul_left hempty' (theta ^ B.card)
          _ = selectedUncoveredEnvelope delta theta B.card (t + 1) 0 := rfl
      · obtain ⟨q, hq⟩ : ∃ q, Q.card = q + 1 :=
          Nat.exists_eq_succ_of_ne_zero
            (card_ne_zero.mpr (nonempty_iff_ne_empty.mpr hQ))
        have hQbound := ih Q hdisjoint
        have hQbound' :
            (FiniteLaw.iterateKernel K t
              (FiniteLaw.pure omega0)).probability
                (SelectedUncoveredEvent R U Q B) ≤
              selectedUncoveredEnvelope delta theta B.card t (q + 1) := by
          simpa only [hq] using hQbound
        have herase (x : W) (hx : x ∈ Q) :
            (FiniteLaw.iterateKernel K t
              (FiniteLaw.pure omega0)).probability
                (SelectedUncoveredEvent R U (Q.erase x) B) ≤
              selectedUncoveredEnvelope delta theta B.card t q := by
          have hd : Disjoint (Q.erase x) (R omega0) :=
            hdisjoint.mono_left (erase_subset x Q)
          have h := ih (Q.erase x) hd
          simpa [card_erase_of_mem hx, hq] using h
        have hsum :
            (∑ x ∈ Q,
              (FiniteLaw.iterateKernel K t
                (FiniteLaw.pure omega0)).probability
                  (SelectedUncoveredEvent R U (Q.erase x) B)) ≤
              ∑ _x ∈ Q,
                selectedUncoveredEnvelope delta theta B.card t q := by
          apply sum_le_sum
          intro x hx
          exact herase x hx
        calc
          (FiniteLaw.bind
              (FiniteLaw.iterateKernel K t (FiniteLaw.pure omega0)) K).probability
                (SelectedUncoveredEvent R U Q B) ≤
              theta ^ B.card *
                  (FiniteLaw.iterateKernel K t
                    (FiniteLaw.pure omega0)).probability
                      (SelectedUncoveredEvent R U Q B) +
                delta * ∑ x ∈ Q,
                  (FiniteLaw.iterateKernel K t
                    (FiniteLaw.pure omega0)).probability
                      (SelectedUncoveredEvent R U (Q.erase x) B) := hrec
          _ ≤ theta ^ B.card *
                selectedUncoveredEnvelope delta theta B.card t (q + 1) +
              delta * ∑ _x ∈ Q,
                selectedUncoveredEnvelope delta theta B.card t q := by
            apply add_le_add
            · simpa only [mul_comm] using
                mul_le_mul_left hQbound' (theta ^ B.card)
            · simpa only [mul_comm] using
                mul_le_mul_left hsum delta
          _ = selectedUncoveredEnvelope delta theta B.card
                (t + 1) (q + 1) := by
            simp [hq, mul_assoc, mul_left_comm]
          _ = selectedUncoveredEnvelope delta theta B.card
                (t + 1) Q.card := by rw [hq]

end

end Erdos207
