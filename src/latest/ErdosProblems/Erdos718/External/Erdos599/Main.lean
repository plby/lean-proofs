namespace Erdos599

/-! ### Regular-cardinal closure points

Mathlib's club/stationary API supplies intersections of fewer than the
cofinality many clubs, but not yet the closure-point and pressing-down lemmas
used by Aharoni--Berger.  We first prove the basic closure-point club.  The
proof is the standard countable iteration: at `x`, choose a strict upper bound
for `x` and for `f '' Iic x`; regularity makes that image noncofinal. -/

open Cardinal Order

attribute [local instance]
  WellFoundedLT.toOrderBot WellFoundedLT.conditionallyCompleteLinearOrderBot

/-- Closure points of a self-map of a well-order. -/
def regularClosurePoints {α : Type} [LinearOrder α] (f : α → α) : Set α :=
  {a | ∀ b < a, f b < a}

theorem exists_regularClosureStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) :
    ∃ y, x < y ∧ ∀ b ≤ x, f b < y := by
  let S : Set α := f '' Set.Iic x
  have hIic : #(Set.Iic x) < #α := by
    apply Cardinal.mk_Iic_lt x
    · exact Cardinal.ord_cardinalMk
    · exact huncountable.le
  have hSlt : #S < #α := Cardinal.mk_image_le.trans_lt hIic
  have hnotCofinal : ¬ IsCofinal S := by
    intro hcof
    have hle : cof α ≤ #S := cof_le hcof
    rw [Order.cof_eq_cardinalMk] at hle
    exact hSlt.2 hle
  rcases not_isCofinal_iff.mp hnotCofinal with ⟨z, hz⟩
  rcases exists_gt (max x z) with ⟨y, hy⟩
  refine ⟨y, (le_max_left x z).trans_lt hy, ?_⟩
  intro b hbx
  have hfbz : f b < z := hz (f b) ⟨b, hbx, rfl⟩
  exact hfbz.trans (lt_of_le_of_lt (le_max_right x z) hy)

/-- One closure step, chosen classically from
`exists_regularClosureStep`. -/
noncomputable def regularClosureStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) : α :=
  Classical.choose (exists_regularClosureStep huncountable f x)

theorem lt_regularClosureStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) :
    x < regularClosureStep huncountable f x :=
  (Classical.choose_spec (exists_regularClosureStep huncountable f x)).1

theorem map_lt_regularClosureStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) {b : α}
    (hbx : b ≤ x) : f b < regularClosureStep huncountable f x :=
  (Classical.choose_spec (exists_regularClosureStep huncountable f x)).2 b hbx

/-- The natural-number iteration of the closure step. -/
noncomputable def regularClosureIter {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) : ℕ → α
  | 0 => x
  | n + 1 => regularClosureStep huncountable f
      (regularClosureIter huncountable f x n)

@[simp] theorem regularClosureIter_zero {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) :
    regularClosureIter huncountable f x 0 = x := rfl

@[simp] theorem regularClosureIter_succ {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) (n : ℕ) :
    regularClosureIter huncountable f x (n + 1) =
      regularClosureStep huncountable f
        (regularClosureIter huncountable f x n) := rfl

theorem regularClosureIter_strictMono {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) :
    StrictMono (regularClosureIter huncountable f x) := by
  apply strictMono_nat_of_lt_succ
  intro n
  rw [regularClosureIter_succ]
  exact lt_regularClosureStep huncountable f _

theorem regularClosureIter_bddAbove {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) (x : α) :
    BddAbove (Set.range (regularClosureIter huncountable f x)) := by
  apply BddAbove.of_not_isCofinal
  intro hcof
  have hle := (cof_le hcof).trans Cardinal.mk_range_le
  rw [Order.cof_eq_cardinalMk] at hle
  have hNat : #(ℕ) = ℵ₀ := by simp
  rw [hNat] at hle
  exact huncountable.2 hle

/-- On an uncountable regular well-order, closure points of every self-map
form a club. -/
theorem isClub_regularClosurePoints {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (f : α → α) :
    IsClub (regularClosurePoints f) := by
  refine ⟨?_, ?_⟩
  · rw [dirSupClosed_iff_of_linearOrder]
    intro d hd _hdne a ha b hba
    rcases (lt_isLUB_iff ha).mp hba with ⟨c, hcd, hbc⟩
    exact (hd hcd b hbc).trans_le (ha.1 hcd)
  · intro x
    let u := regularClosureIter huncountable f x
    let a := sSup (Set.range u)
    have huBdd : BddAbove (Set.range u) :=
      regularClosureIter_bddAbove huncountable f x
    have huLUB : IsLUB (Set.range u) a :=
      isLUB_csSup (Set.range_nonempty u) huBdd
    refine ⟨a, ?_, ?_⟩
    · intro b hba
      rcases (lt_isLUB_iff huLUB).mp hba with ⟨c, ⟨n, rfl⟩, hbn⟩
      have hfstep : f b < u (n + 1) := by
        change f b < regularClosureStep huncountable f (u n)
        exact map_lt_regularClosureStep huncountable f _ hbn.le
      exact hfstep.trans_le (huLUB.1 ⟨n + 1, rfl⟩)
    · have hxRange : x ∈ Set.range u := ⟨0, rfl⟩
      exact huLUB.1 hxRange

/-- The diagonal intersection of a family of sets indexed by a well-order. -/
def diagonalIntersection {α : Type} [LinearOrder α]
    (C : α → Set α) : Set α :=
  {a | ∀ i < a, a ∈ C i}

/-- At `x`, intersect the first `x + 1` clubs.  Regularity says this is still
a club because `Iic x` has cardinality below the ambient cardinal. -/
theorem isClub_iInter_Iic {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (C : α → Set α)
    (hC : ∀ i, IsClub (C i)) (x : α) :
    IsClub (⋂ i : Set.Iic x, C i.1) := by
  apply IsClub.iInter
  · rw [Order.cof_eq_cardinalMk]
    exact ne_of_gt huncountable
  · simpa [Order.cof_eq_cardinalMk] using
      (Cardinal.mk_Iic_lt x Cardinal.ord_cardinalMk huncountable.le)
  · intro i
    exact hC i.1

/-- There is a point strictly above `x` in every club with index at most
`x`. -/
theorem exists_diagonalClubStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (C : α → Set α)
    (hC : ∀ i, IsClub (C i)) (x : α) :
    ∃ y, x < y ∧ ∀ i ≤ x, y ∈ C i := by
  rcases exists_gt x with ⟨z, hxz⟩
  let D : Set α := ⋂ i : Set.Iic x, C i.1
  have hD : IsClub D := isClub_iInter_Iic huncountable C hC x
  rcases hD.isCofinal z with ⟨y, hyD, hzy⟩
  refine ⟨y, hxz.trans_le hzy, ?_⟩
  intro i hix
  exact Set.mem_iInter.mp hyD ⟨i, hix⟩

/-- A classically chosen diagonal-club step. -/
noncomputable def diagonalClubStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (C : α → Set α)
    (hC : ∀ i, IsClub (C i)) (x : α) : α :=
  Classical.choose (exists_diagonalClubStep huncountable C hC x)

theorem lt_diagonalClubStep {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (C : α → Set α)
    (hC : ∀ i, IsClub (C i)) (x : α) :
    x < diagonalClubStep huncountable C hC x :=
  (Classical.choose_spec (exists_diagonalClubStep huncountable C hC x)).1

theorem diagonalClubStep_mem {α : Type} [LinearOrder α] [Nonempty α]
    [WellFoundedLT α] [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (C : α → Set α)
    (hC : ∀ i, IsClub (C i)) {i x : α} (hix : i ≤ x) :
    diagonalClubStep huncountable C hC x ∈ C i :=
  (Classical.choose_spec (exists_diagonalClubStep huncountable C hC x)).2 i hix

/-- Diagonal intersections of clubs are club on an uncountable regular
well-order. -/
theorem isClub_diagonalIntersection
    {α : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) (C : α → Set α)
    (hC : ∀ i, IsClub (C i)) :
    IsClub (diagonalIntersection C) := by
  refine ⟨?_, ?_⟩
  · rw [dirSupClosed_iff_of_linearOrder]
    intro d hd hdne a ha i hia
    let t : Set α := d ∩ Set.Ioi i
    have htne : t.Nonempty := by
      rcases (lt_isLUB_iff ha).mp hia with ⟨c, hcd, hic⟩
      exact ⟨c, hcd, hic⟩
    have htsub : t ⊆ C i := by
      rintro c ⟨hcd, hic⟩
      exact hd hcd i hic
    have htLUB : IsLUB t a := by
      refine ⟨?_, ?_⟩
      · rintro c ⟨hcd, _⟩
        exact ha.1 hcd
      · intro z hz
        apply ha.2
        intro c hcd
        by_cases hic : i < c
        · exact hz ⟨hcd, hic⟩
        · rcases htne with ⟨e, hed, hie⟩
          exact (le_of_not_gt hic).trans (hie.le.trans (hz ⟨hed, hie⟩))
    exact (hC i).isLUB_mem htsub htne htLUB
  · intro x
    let step : α → α := diagonalClubStep huncountable C hC
    have hstepClub := isClub_regularClosurePoints huncountable step
    rcases hstepClub.isCofinal x with ⟨a, haClosure, hxa⟩
    refine ⟨a, ?_, hxa⟩
    intro i hia
    let t : Set α := step '' Set.Ico i a
    have htne : t.Nonempty := by
      refine ⟨step i, ⟨i, ⟨le_rfl, hia⟩, rfl⟩⟩
    have htsub : t ⊆ C i := by
      rintro y ⟨z, ⟨hiz, _hza⟩, rfl⟩
      exact diagonalClubStep_mem huncountable C hC hiz
    have htLUB : IsLUB t a := by
      refine ⟨?_, ?_⟩
      · rintro y ⟨z, ⟨_hiz, hza⟩, rfl⟩
        exact (haClosure z hza).le
      · intro y hy
        apply le_of_forall_lt
        intro z hza
        let w := max i z
        have hwa : w < a := max_lt hia hza
        have hzw : z ≤ w := le_max_right i z
        have hwstep : w < step w :=
          lt_diagonalClubStep huncountable C hC w
        have hstepY : step w ≤ y := by
          apply hy
          exact ⟨w, ⟨le_max_left i z, hwa⟩, rfl⟩
        exact hzw.trans_lt (hwstep.trans_le hstepY)
    exact (hC i).isLUB_mem htsub htne htLUB

/-- Fodor's pressing-down lemma for uncountable regular well-orders. -/
theorem exists_stationary_fiber_of_regressive
    {α : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {S : Set α} (hS : IsStationary S)
    (f : α → α) (hreg : ∀ x ∈ S, f x < x) :
    ∃ i, IsStationary {x | x ∈ S ∧ f x = i} := by
  classical
  by_contra hno
  push Not at hno
  have hnonstationary : ∀ i, ¬ IsStationary {x | x ∈ S ∧ f x = i} := hno
  choose C hCclub hCdisjoint using fun i =>
    not_isStationary_iff.mp (hnonstationary i)
  have hdiag : IsClub (diagonalIntersection C) :=
    isClub_diagonalIntersection huncountable C hCclub
  rcases hS hdiag with ⟨x, hxS, hxDiag⟩
  have hxC : x ∈ C (f x) := hxDiag (f x) (hreg x hxS)
  exact Set.disjoint_left.mp (hCdisjoint (f x)) ⟨hxS, rfl⟩ hxC

/-- A stationary subset of an uncountable regular well-order admits no
injective regressive map.  This is the injective form of Fodor's lemma used
in the popularity arguments. -/
theorem not_injective_regressive_of_isStationary
    {α : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {S : Set α} (hS : IsStationary S)
    (g : S → α) (hreg : ∀ x, g x < x.1) : ¬ Function.Injective g := by
  intro hinj
  classical
  let inv : α → α := fun y =>
    if h : ∃ x : S, g x = y then (Classical.choose h).1 else ⊥
  have hinv (x : S) : inv (g x) = x.1 := by
    have hex : ∃ z : S, g z = g x := ⟨x, rfl⟩
    simp only [inv, dif_pos hex]
    have heq : Classical.choose hex = x :=
      hinj (Classical.choose_spec hex)
    exact congrArg Subtype.val heq
  rcases hS (isClub_regularClosurePoints huncountable inv) with
    ⟨x, hxS, hxClosure⟩
  let xS : S := ⟨x, hxS⟩
  have hlt : inv (g xS) < x := hxClosure (g xS) (hreg xS)
  rw [hinv xS] at hlt
  exact (lt_irrefl x hlt).elim

/-- Aharoni--Berger Lemma 8.5, the stationary transversal lemma.  If a
stationary set is covered by nonstationary nonempty pieces, one can choose one
point from every piece so that the range of the choice is still stationary. -/
theorem exists_stationary_range_choice
    {α : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {U : Type} (Ξ : U → Set α)
    (hne : ∀ u, (Ξ u).Nonempty)
    (hnonstationary : ∀ u, ¬ IsStationary (Ξ u))
    (hunion : IsStationary (⋃ u, Ξ u)) :
    ∃ g : U → α, (∀ u, g u ∈ Ξ u) ∧ IsStationary (Set.range g) := by
  classical
  let S : Set α := ⋃ u, Ξ u
  rcases hunion.nonempty with ⟨x₀, hx₀⟩
  rcases Set.mem_iUnion.mp hx₀ with ⟨u₀, hu₀⟩
  let owner : α → U := fun x =>
    if hx : x ∈ S then Classical.choose (Set.mem_iUnion.mp hx) else u₀
  have owner_mem {x : α} (hx : x ∈ S) : x ∈ Ξ (owner x) := by
    simp only [owner, dif_pos hx]
    exact Classical.choose_spec (Set.mem_iUnion.mp hx)
  let fiber : U → Set α := fun u => {x | x ∈ S ∧ owner x = u}
  have fiber_subset (u : U) : fiber u ⊆ Ξ u := by
    rintro x ⟨hxS, hxu⟩
    simpa [hxu] using owner_mem hxS
  have fiber_nonstationary (u : U) : ¬ IsStationary (fiber u) := by
    intro hstationary
    exact hnonstationary u (hstationary.mono (fiber_subset u))
  let least : α → α := fun x =>
    if hx : x ∈ S then
      wellFounded_lt.min (fiber (owner x)) ⟨x, hx, rfl⟩
    else ⊥
  have least_mem {x : α} (hx : x ∈ S) :
      least x ∈ fiber (owner x) := by
    simp only [least, dif_pos hx]
    exact wellFounded_lt.min_mem _ _
  have least_le {x : α} (hx : x ∈ S) : least x ≤ x := by
    simp only [least, dif_pos hx]
    have hxfiber : x ∈ fiber (owner x) := ⟨hx, rfl⟩
    exact wellFounded_lt.min_le hxfiber
  let E : Set α := {x | x ∈ S ∧ least x = x}
  let R : Set α := {x | x ∈ S ∧ least x < x}
  have hsplit : S = R ∪ E := by
    ext x
    constructor
    · intro hx
      by_cases heq : least x = x
      · exact Or.inr ⟨hx, heq⟩
      · exact Or.inl ⟨hx, lt_of_le_of_ne (least_le hx) heq⟩
    · rintro (hx | hx) <;> exact hx.1
  have hcof : cof α ≠ ℵ₀ := by
    rw [Order.cof_eq_cardinalMk]
    exact ne_of_gt huncountable
  have hE : IsStationary E := by
    by_contra hEnonstationary
    have hRunion : IsStationary (R ∪ E) := hsplit ▸ hunion
    have hR : IsStationary R :=
      (isStationary_union_iff hcof).mp hRunion |>.resolve_right hEnonstationary
    have hregressive : ∀ x ∈ R, least x < x := fun _ hx => hx.2
    rcases exists_stationary_fiber_of_regressive huncountable hR least hregressive with
      ⟨i, hi⟩
    rcases hi.nonempty with ⟨x, hxR, hxLeast⟩
    have hxS : x ∈ S := hxR.1
    have hsubset : {y | y ∈ R ∧ least y = i} ⊆ fiber (owner x) := by
      rintro y ⟨hyR, hyLeast⟩
      have hyS : y ∈ S := hyR.1
      have hleast : least y = least x := hyLeast.trans hxLeast.symm
      have hyOwnerLeast : owner (least y) = owner y := (least_mem hyS).2
      have hxOwnerLeast : owner (least x) = owner x := (least_mem hxS).2
      refine ⟨hyS, ?_⟩
      calc
        owner y = owner (least y) := hyOwnerLeast.symm
        _ = owner (least x) := congrArg owner hleast
        _ = owner x := hxOwnerLeast
    exact fiber_nonstationary (owner x) (hi.mono hsubset)
  let g : U → α := fun u =>
    if h : (fiber u).Nonempty then wellFounded_lt.min (fiber u) h
    else Classical.choose (hne u)
  have g_mem (u : U) : g u ∈ Ξ u := by
    by_cases h : (fiber u).Nonempty
    · apply fiber_subset u
      simpa only [g, dif_pos h] using wellFounded_lt.min_mem (fiber u) h
    · simpa only [g, dif_neg h] using Classical.choose_spec (hne u)
  have E_subset_range : E ⊆ Set.range g := by
    rintro x ⟨hxS, hxLeast⟩
    have hfiber : (fiber (owner x)).Nonempty := ⟨x, hxS, rfl⟩
    refine ⟨owner x, ?_⟩
    simp only [g, dif_pos hfiber]
    simpa only [least, dif_pos hxS] using hxLeast
  exact ⟨g, g_mem, hE.mono E_subset_range⟩

/-- Every strict upper tail in a linear order without a maximum is club. -/
theorem isClub_Ioi_of_noMax {α : Type} [LinearOrder α] [NoMaxOrder α]
    (x : α) : IsClub (Set.Ioi x) := by
  refine ⟨?_, ?_⟩
  · rw [dirSupClosed_iff_of_linearOrder]
    intro d hd hdne a ha
    rcases hdne with ⟨y, hyd⟩
    exact (hd hyd).trans_le (ha.1 hyd)
  · intro a
    rcases exists_gt (max x a) with ⟨b, hb⟩
    exact ⟨b, (le_max_left x a).trans_lt hb,
      (le_max_right x a).trans hb.le⟩

/-- A stationary set in an order without a maximum cannot have at most one
point. -/
theorem not_subsingleton_of_isStationary {α : Type} [LinearOrder α]
    [NoMaxOrder α] {S : Set α} (hS : IsStationary S) :
    ¬ S.Subsingleton := by
  intro hsub
  rcases hS.nonempty with ⟨x, hxS⟩
  rcases hS (isClub_Ioi_of_noMax x) with ⟨y, hyS, hxy⟩
  exact hxy.ne (hsub hyS hxS).symm

/-- A set of vertices meets every finite simple `A`--`B` path. -/
def Separates {V : Type} (G : SimpleGraph V) (A B S : Set V) : Prop :=
  ∀ a ∈ A, ∀ b ∈ B, ∀ q : G.Walk a b,
    q.IsPath → ∃ v ∈ q.support, v ∈ S

/-- The source side is trimmed when every source has a finite path to the
target that encounters no other source.  This is the undirected version of
Aharoni--Berger's standing convention that no edge enters the source side. -/
def IsTrimmedWeb {V : Type} (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∀ a ∈ A, ∃ b ∈ B, ∃ q : G.Walk a b,
    q.IsPath ∧ ∀ x ∈ q.support, x ∈ A → x = a

/-- The roof of `S` (with target side `B`) consists of vertices from which
every finite simple path to `B` meets `S`. -/
def roof {V : Type} (G : SimpleGraph V) (B S : Set V) : Set V :=
  {v | ∀ b ∈ B, ∀ q : G.Walk v b,
    q.IsPath → ∃ x ∈ q.support, x ∈ S}

/-- The vertices of `S` that remain exposed to `B` after all other vertices
of `S` are forbidden.  This is Aharoni--Berger's `E(S)`. -/
def essentialVertices {V : Type} (G : SimpleGraph V) (B S : Set V) : Set V :=
  {s | s ∈ S ∧ s ∉ roof G B (S \ {s})}

/-- The strict interior of a roof is `RF(S) \ E(S)`.  Notice that this can
contain inessential vertices of `S`; using `RF(S) \ S` here would give the
wrong quotient web. -/
def interiorRoof {V : Type} (G : SimpleGraph V) (B S : Set V) : Set V :=
  roof G B S \ essentialVertices G B S

/-- Source side of the quotient web `Γ/S`.  The underlying graph deletes the
strict roof interior; the exposed part of `S` is promoted to the new source
side, while old sources not swallowed by that interior remain sources. -/
def quotientSource {V : Type} (G : SimpleGraph V)
    (A B S : Set V) : Set V :=
  (A ∪ S) \ interiorRoof G B S

theorem separates_iff_subset_roof {V : Type} {G : SimpleGraph V}
    {A B S : Set V} :
    Separates G A B S ↔ A ⊆ roof G B S := by
  rfl

/-- Every vertex of `S` is roofed by `S`, since it is the first vertex of
each path starting there. -/
theorem subset_roof {V : Type} (G : SimpleGraph V) (B S : Set V) :
    S ⊆ roof G B S := by
  intro s hs b hb q hq
  exact ⟨s, q.start_mem_support, hs⟩

/-- Roofs are monotone in the set doing the separating. -/
theorem roof_mono {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (hST : S ⊆ T) :
    roof G B S ⊆ roof G B T := by
  intro v hv b hb q hq
  rcases hv b hb q hq with ⟨x, hxq, hxS⟩
  exact ⟨x, hxq, hST hxS⟩

/-- Passing to a spanning subgraph can only enlarge a roof, since there are
fewer paths to the target that must meet the separating set. -/
theorem roof_antitone_graph {V : Type} {G H : SimpleGraph V}
    (hHG : H ≤ G) (B S : Set V) :
    roof G B S ⊆ roof H B S := by
  intro v hv b hb q hq
  let q' := q.mapLe hHG
  have hq' : q'.IsPath := hq.mapLe hHG
  rcases hv b hb q' hq' with ⟨x, hxq, hxS⟩
  exact ⟨x, by simpa [q', Walk.support_mapLe_eq_support] using hxq, hxS⟩

/-- A point in the strict roof of `S` is already roofed by `S` with that
point removed. -/
theorem mem_roof_sdiff_singleton_of_mem_interiorRoof {V : Type}
    {G : SimpleGraph V} {B S : Set V} {x : V}
    (hx : x ∈ interiorRoof G B S) :
    x ∈ roof G B (S \ {x}) := by
  by_cases hxS : x ∈ S
  · by_contra hnot
    exact hx.2 ⟨hxS, hnot⟩
  · intro b hb q hq
    rcases hx.1 b hb q hq with ⟨s, hsq, hsS⟩
    exact ⟨s, hsq, hsS, fun hsx => hxS (hsx ▸ hsS)⟩

/-- If `x` is roofed without using itself, removing `x` from a separator
still roofs every other point already roofed by the separator. -/
theorem mem_roof_sdiff_singleton_of_ne_of_mem_roof
    {V : Type} {G : SimpleGraph V} {B S : Set V} {x z : V}
    (hx : x ∈ roof G B (S \ {x})) (hzx : z ≠ x)
    (hz : z ∈ roof G B S) :
    z ∈ roof G B (S \ {x}) := by
  classical
  intro b hb q hq
  rcases hz b hb q hq with ⟨s, hsq, hsS⟩
  by_cases hsx : s = x
  · subst s
    rcases hx b hb (q.dropUntil x hsq) (hq.dropUntil hsq) with
      ⟨t, htSuffix, htS⟩
    exact ⟨t, q.support_dropUntil_subset_support hsq htSuffix, htS⟩
  · exact ⟨s, hsq, hsS, by simpa using hsx⟩

/-- Enlarging the target side can only shrink a roof. -/
theorem roof_antitone_target {V : Type} {G : SimpleGraph V} {B C S : Set V}
    (hBC : B ⊆ C) :
    roof G C S ⊆ roof G B S := by
  intro v hv b hb
  exact hv b (hBC hb)

@[simp] theorem roof_empty_target {V : Type} (G : SimpleGraph V) (S : Set V) :
    roof G ∅ S = Set.univ := by
  apply Set.eq_univ_iff_forall.mpr
  intro v b hb
  exact (Set.notMem_empty b hb).elim

@[simp] theorem roof_univ {V : Type} (G : SimpleGraph V) (B : Set V) :
    roof G B Set.univ = Set.univ := by
  apply Set.eq_univ_iff_forall.mpr
  intro v b hb q hq
  exact ⟨v, q.start_mem_support, Set.mem_univ v⟩

/-- The roof operation is idempotent.  The substantive inclusion uses the
suffix of a path beginning at its first roof vertex. -/
@[simp] theorem roof_roof {V : Type} (G : SimpleGraph V) (B S : Set V) :
    roof G B (roof G B S) = roof G B S := by
  classical
  apply Set.Subset.antisymm
  · intro v hv b hb q hq
    rcases hv b hb q hq with ⟨x, hxq, hxroof⟩
    rcases hxroof b hb (q.dropUntil x hxq) (hq.dropUntil hxq) with
      ⟨s, hsSuffix, hsS⟩
    exact ⟨s, q.support_dropUntil_subset_support hxq hsSuffix, hsS⟩
  · exact roof_mono (subset_roof G B S)

/-- On the target side, being in the roof is equivalent to already belonging
to the separator.  The reverse implication uses the zero-edge path. -/
theorem mem_roof_of_mem_target_iff {V : Type} {G : SimpleGraph V}
    {B S : Set V} {b : V} (hb : b ∈ B) :
    b ∈ roof G B S ↔ b ∈ S := by
  constructor
  · intro hroof
    rcases hroof b hb (.nil : G.Walk b b) (by simp) with ⟨x, hx, hxS⟩
    have hxb : x = b := by simpa using hx
    simpa [hxb] using hxS
  · exact fun hbS => subset_roof G B S hbS

theorem target_inter_roof {V : Type} (G : SimpleGraph V) (B S : Set V) :
    B ∩ roof G B S = B ∩ S := by
  ext b
  simp only [Set.mem_inter_iff]
  constructor
  · rintro ⟨hb, hroof⟩
    exact ⟨hb, (mem_roof_of_mem_target_iff hb).mp hroof⟩
  · rintro ⟨hb, hbS⟩
    exact ⟨hb, (mem_roof_of_mem_target_iff hb).mpr hbS⟩

/-- The strict interior is disjoint from the exposed, essential boundary. -/
theorem interiorRoof_disjoint {V : Type} (G : SimpleGraph V) (B S : Set V) :
    Disjoint (interiorRoof G B S) (essentialVertices G B S) := by
  exact Set.disjoint_sdiff_left

/-- Target vertices never lie in the strict interior of a roof.  A target
vertex roofed by `S` belongs to `S`, and the trivial path at that vertex shows
that it is exposed. -/
theorem target_disjoint_interiorRoof {V : Type} (G : SimpleGraph V)
    (B S : Set V) : Disjoint B (interiorRoof G B S) := by
  rw [Set.disjoint_left]
  intro b hb hbi
  have hbS : b ∈ S := (mem_roof_of_mem_target_iff hb).mp hbi.1
  apply hbi.2
  refine ⟨hbS, ?_⟩
  intro hroof
  rcases hroof b hb (.nil : G.Walk b b) (by simp) with
    ⟨x, hx, hxS, hxb⟩
  have : x = b := by simpa using hx
  exact hxb this

/-- The spanning graph obtained by isolating every vertex of `X`.  This is
equivalent to using the induced graph on `Xᶜ`, but retains the ambient vertex
type and therefore avoids coercions through nested quotient subtypes. -/
def outsideGraph {V : Type} (G : SimpleGraph V) (X : Set V) : SimpleGraph V where
  Adj u v := G.Adj u v ∧ u ∉ X ∧ v ∉ X
  symm.symm u v huv := ⟨G.symm.symm u v huv.1, huv.2.2, huv.2.1⟩
  loopless.irrefl u huu := G.loopless.irrefl u huu.1

@[simp] theorem outsideGraph_adj {V : Type} {G : SimpleGraph V}
    {X : Set V} {u v : V} :
    (outsideGraph G X).Adj u v ↔ G.Adj u v ∧ u ∉ X ∧ v ∉ X := by
  rfl

theorem outsideGraph_le {V : Type} (G : SimpleGraph V) (X : Set V) :
    outsideGraph G X ≤ G := by
  intro u v huv
  exact huv.1

@[simp] theorem outsideGraph_empty {V : Type} (G : SimpleGraph V) :
    outsideGraph G ∅ = G := by
  ext u v
  simp [outsideGraph_adj]

/-- Successive vertex deletions are the same as deleting their union.  Keeping
this equality explicit is useful when the transfinite construction repeatedly
passes to exterior webs. -/
@[simp] theorem outsideGraph_outsideGraph {V : Type} (G : SimpleGraph V)
    (X Y : Set V) :
    outsideGraph (outsideGraph G X) Y = outsideGraph G (X ∪ Y) := by
  ext u v
  simp [outsideGraph_adj, and_assoc, and_left_comm, and_comm]

theorem outsideGraph_mono {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (X : Set V) :
    outsideGraph G X ≤ outsideGraph H X := by
  intro u v huv
  exact ⟨hGH huv.1, huv.2⟩

theorem outsideGraph_antitone {V : Type} (G : SimpleGraph V)
    {X Y : Set V} (hXY : X ⊆ Y) :
    outsideGraph G Y ≤ outsideGraph G X := by
  intro u v huv
  exact ⟨huv.1, fun huX => huv.2.1 (hXY huX),
    fun hvX => huv.2.2 (hXY hvX)⟩

/-- Vertices just outside `X` that are adjacent to a vertex of `X`.  In a
directed web this is the outward neighbourhood `N⁺(X) \ X`; symmetry makes
the undirected formulation independent of orientation. -/
def outerBoundary {V : Type} (G : SimpleGraph V) (X : Set V) : Set V :=
  {v | v ∉ X ∧ ∃ x ∈ X, G.Adj x v}

theorem outerBoundary_mono_graph {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (X : Set V) :
    outerBoundary G X ⊆ outerBoundary H X := by
  rintro v ⟨hvX, x, hxX, hxv⟩
  exact ⟨hvX, x, hxX, hGH hxv⟩

/-- Reinterpret a walk all of whose support avoids `X` as a walk in the
spanning exterior graph. -/
def Walk.toOutsideGraph {V : Type} {G : SimpleGraph V} {X : Set V}
    {u v : V} (p : G.Walk u v) (houtside : ∀ x ∈ p.support, x ∉ X) :
    (outsideGraph G X).Walk u v :=
  match p with
  | .nil => .nil
  | .cons huv q =>
      .cons ⟨huv, houtside _ (by simp), houtside _ (by simp)⟩
        (toOutsideGraph q fun x hx => houtside x (by simp [hx]))
termination_by p.length
decreasing_by simp

@[simp] theorem Walk.support_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} {u v : V} (p : G.Walk u v)
    (houtside : ∀ x ∈ p.support, x ∉ X) :
    (Erdos599.Walk.toOutsideGraph p houtside).support = p.support := by
  induction p with
  | nil => simp [Erdos599.Walk.toOutsideGraph]
  | @cons u v w huv p ih =>
      rw [Erdos599.Walk.toOutsideGraph]
      change u :: (Erdos599.Walk.toOutsideGraph p _).support = u :: p.support
      exact congrArg (List.cons u) (ih _)

@[simp] theorem Walk.length_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} {u v : V} (p : G.Walk u v)
    (houtside : ∀ x ∈ p.support, x ∉ X) :
    (Erdos599.Walk.toOutsideGraph p houtside).length = p.length := by
  have hleft := (Erdos599.Walk.toOutsideGraph p houtside).length_support
  rw [Erdos599.Walk.support_toOutsideGraph] at hleft
  have hright := p.length_support
  omega

@[simp] theorem Walk.getVert_toOutsideGraph {V : Type}
    {G : SimpleGraph V} {X : Set V} {u v : V} (p : G.Walk u v)
    (houtside : ∀ x ∈ p.support, x ∉ X) (n : ℕ) :
    (Erdos599.Walk.toOutsideGraph p houtside).getVert n = p.getVert n := by
  rw [(Erdos599.Walk.toOutsideGraph p houtside).getVert_eq_getD_support,
    p.getVert_eq_getD_support,
    Erdos599.Walk.support_toOutsideGraph]

theorem Walk.isPath_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} {u v : V} {p : G.Walk u v} (hp : p.IsPath)
    (houtside : ∀ x ∈ p.support, x ∉ X) :
    (Erdos599.Walk.toOutsideGraph p houtside).IsPath := by
  apply (SimpleGraph.Walk.isPath_def _).mpr
  rw [Erdos599.Walk.support_toOutsideGraph]
  exact (SimpleGraph.Walk.isPath_def _).mp hp

/-- Every vertex of a walk in the exterior graph avoids the deleted set,
provided its initial vertex does. -/
theorem Walk.vertex_not_mem_of_outsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} {u v : V} (p : (outsideGraph G X).Walk u v)
    (hu : u ∉ X) {x : V} (hx : x ∈ p.support) : x ∉ X := by
  rcases Walk.mem_support_iff_exists_getVert.mp hx with ⟨n, rfl, hn⟩
  cases n with
  | zero => simpa using hu
  | succ n =>
      have hnpos : 0 < n + 1 := by omega
      have hnle : n + 1 ≤ p.length := by simpa using hn
      have hnlt : n < p.length := by omega
      exact (p.adj_getVert_succ hnlt).2.2

/-- A deleted (hence isolated) non-target vertex lies in the strict roof of
every set in the exterior graph. -/
theorem mem_interiorRoof_outsideGraph_of_mem_deleted
    {V : Type} {G : SimpleGraph V} {B D S : Set V} {x : V}
    (hxD : x ∈ D) (hxB : x ∉ B) :
    x ∈ interiorRoof (outsideGraph G D) B S := by
  have hroofAny : ∀ R : Set V, x ∈ roof (outsideGraph G D) B R := by
    intro R b hb q _hq
    cases q with
    | nil => exact (hxB hb).elim
    | @cons _ y _ hxy q => exact (hxy.2.1 hxD).elim
  refine ⟨hroofAny S, ?_⟩
  intro hxEssential
  exact hxEssential.2 (hroofAny (S \ {x}))

/-- An exterior separator becomes an ambient separator after adjoining the
deleted vertex. -/
theorem separates_union_singleton_of_outside {V : Type}
    {G : SimpleGraph V} {A B S : Set V} {x : V}
    (hsep : Separates (outsideGraph G {x}) A (B \ {x}) S) :
    Separates G A B (S ∪ {x}) := by
  classical
  intro a ha b hb q hq
  by_cases hxq : x ∈ q.support
  · exact ⟨x, hxq, Or.inr (Set.mem_singleton x)⟩
  · have houtside : ∀ v ∈ q.support, v ∉ ({x} : Set V) := by
      intro v hv hvx
      exact hxq (Set.mem_singleton_iff.mp hvx ▸ hv)
    let qE : (outsideGraph G {x}).Walk a b :=
      Erdos599.Walk.toOutsideGraph q houtside
    have hqE : qE.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq houtside
    have hbx : b ≠ x := by
      intro hbx
      apply hxq
      simpa [hbx] using q.end_mem_support
    rcases hsep a ha b ⟨hb, by simpa using hbx⟩ qE hqE with
      ⟨v, hvqE, hvS⟩
    have hvq : v ∈ q.support := by
      simpa [qE] using hvqE
    exact ⟨v, hvq, Or.inl hvS⟩

/-- Indexed characterization of membership in the oriented dart list of a
finite walk. -/
theorem Walk.mem_darts_iff_exists_getVert {V : Type} {G : SimpleGraph V}
    {u v : V} (p : G.Walk u v) {d : G.Dart} :
    d ∈ p.darts ↔
      ∃ i < p.length,
        d.toProd = (p.getVert i, p.getVert (i + 1)) := by
  constructor
  · intro hd
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hd
    refine ⟨i, by simpa using hi, ?_⟩
    simpa using congrArg Dart.toProd (p.darts_getElem_eq_getVert i hi)
  · rintro ⟨i, hi, hd⟩
    have hiDarts : i < p.darts.length := by simpa using hi
    apply List.mem_iff_getElem.mpr
    refine ⟨i, hiDarts, ?_⟩
    apply Dart.ext
    calc
      p.darts[i].toProd = (p.getVert i, p.getVert (i + 1)) := by
        simpa using congrArg Dart.toProd
          (p.darts_getElem_eq_getVert i hiDarts)
      _ = d.toProd := hd.symm

theorem essentialVertices_subset {V : Type} (G : SimpleGraph V) (B S : Set V) :
    essentialVertices G B S ⊆ S := by
  exact fun _ h => h.1

theorem quotientSource_eq {V : Type} (G : SimpleGraph V)
    (A B S : Set V) :
    quotientSource G A B S =
      (A \ interiorRoof G B S) ∪ essentialVertices G B S := by
  ext v
  constructor
  · rintro ⟨hvA | hvS, hvInterior⟩
    · exact Or.inl ⟨hvA, hvInterior⟩
    · right
      by_contra hvEssential
      exact hvInterior ⟨subset_roof G B S hvS, hvEssential⟩
  · rintro (hvA | hvEssential)
    · exact ⟨Or.inl hvA.1, hvA.2⟩
    · refine ⟨Or.inr (essentialVertices_subset G B S hvEssential), ?_⟩
      exact fun hvInterior => hvInterior.2 hvEssential

/-- The part of a quotient source side lying in the quotienting set is
exactly its exposed essential boundary. -/
theorem quotientSource_inter_self {V : Type} (G : SimpleGraph V)
    (A B S : Set V) :
    quotientSource G A B S ∩ S = essentialVertices G B S := by
  apply Set.Subset.antisymm
  · rintro v ⟨hvSource, hvS⟩
    refine ⟨hvS, ?_⟩
    intro hvRoofOther
    exact hvSource.2 ⟨subset_roof G B S hvS,
      fun hvEssential => hvEssential.2 hvRoofOther⟩
  · intro v hvEssential
    refine ⟨?_, hvEssential.1⟩
    exact ⟨Or.inr hvEssential.1,
      fun hvInterior => hvInterior.2 hvEssential⟩

/-- If all old sources are already under the roof of `S`, quotienting leaves
exactly the exposed boundary as the new source side. -/
theorem quotientSource_eq_essentialVertices_of_subset_roof {V : Type}
    {G : SimpleGraph V} {A B S : Set V} (hA : A ⊆ roof G B S) :
    quotientSource G A B S = essentialVertices G B S := by
  rw [quotientSource_eq]
  apply Set.union_eq_right.mpr
  rintro v ⟨hvA, hvInterior⟩
  by_contra hvEssential
  exact hvInterior ⟨hA hvA, hvEssential⟩

/-- An essential vertex has a finite simple path to `B` that meets `S` only
at that vertex. -/
theorem mem_essentialVertices_iff {V : Type} {G : SimpleGraph V}
    {B S : Set V} {s : V} :
    s ∈ essentialVertices G B S ↔
      s ∈ S ∧ ∃ b ∈ B, ∃ q : G.Walk s b,
        q.IsPath ∧ ∀ x ∈ q.support, x ∈ S → x = s := by
  classical
  simp only [essentialVertices, Set.mem_ofPred_eq, roof, Set.mem_sdiff,
    Set.mem_singleton_iff]
  constructor
  · rintro ⟨hs, hnotroof⟩
    push Not at hnotroof
    rcases hnotroof with ⟨b, hb, q, hq, havoid⟩
    exact ⟨hs, b, hb, q, hq, havoid⟩
  · rintro ⟨hs, b, hb, q, hq, honly⟩
    refine ⟨hs, ?_⟩
    intro hroof
    rcases hroof b hb q hq with ⟨x, hxq, hxS, hxs⟩
    exact hxs (honly x hxq hxS)

/-- Strict roof interiors are monotone in the separating set.  The only
non-formal point is exposure: if `x` were exposed in the larger set, its
private path to `B` must meet the smaller set because `x` is roofed by it;
that meeting can only be `x`, and hence exposes `x` in the smaller set too. -/
theorem interiorRoof_mono {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (hST : S ⊆ T) :
    interiorRoof G B S ⊆ interiorRoof G B T := by
  intro x hx
  refine ⟨roof_mono hST hx.1, ?_⟩
  intro hxEssential
  rcases mem_essentialVertices_iff.mp hxEssential with
    ⟨hxT, b, hb, q, hq, honlyT⟩
  apply hx.2
  apply mem_essentialVertices_iff.mpr
  rcases hx.1 b hb q hq with ⟨s, hsq, hsS⟩
  have hsx : s = x := honlyT s hsq (hST hsS)
  refine ⟨hsx ▸ hsS, b, hb, q, hq, ?_⟩
  intro z hzq hzS
  exact honlyT z hzq (hST hzS)

/-- Once `S ⊆ T`, deleting the strict interior roof of `S` does not
change the roof of `T`.  Indeed an original path avoiding `T` cannot enter
that deleted interior: its suffix would then have to meet `S`, hence `T`. -/
theorem roof_outsideGraph_interiorRoof_eq_of_subset {V : Type}
    {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ T) :
    roof (outsideGraph G (interiorRoof G B S)) B T = roof G B T := by
  classical
  apply Set.Subset.antisymm
  · intro v hv b hb q hq
    by_cases hmeet : ∃ x ∈ q.support, x ∈ T
    · exact hmeet
    · push Not at hmeet
      have houtside : ∀ x ∈ q.support, x ∉ interiorRoof G B S := by
        intro x hxq hxInterior
        rcases hxInterior.1 b hb (q.dropUntil x hxq) (hq.dropUntil hxq) with
          ⟨s, hsSuffix, hsS⟩
        exact hmeet s (q.support_dropUntil_subset_support hxq hsSuffix)
          (hST hsS)
      let q' : (outsideGraph G (interiorRoof G B S)).Walk v b :=
        Erdos599.Walk.toOutsideGraph q houtside
      have hq' : q'.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph hq houtside
      rcases hv b hb q' hq' with ⟨x, hxq', hxT⟩
      exact ⟨x, by simpa [q'] using hxq', hxT⟩
  · intro v hv b hb q hq
    let qG : G.Walk v b := q.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    have hqG : qG.IsPath := hq.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    rcases hv b hb qG hqG with ⟨x, hxqG, hxT⟩
    exact ⟨x, by simpa [qG, Walk.support_mapLe_eq_support] using hxqG, hxT⟩

/-- A finite walk that meets a set has a last indexed occurrence of that
set.  Keeping the index in the conclusion is convenient for taking the
corresponding suffix. -/
theorem exists_last_index_of_support_meets {V : Type} {G : SimpleGraph V}
    {a b : V} (q : G.Walk a b) (S : Set V)
    (h : ∃ s ∈ q.support, s ∈ S) :
    ∃ n ≤ q.length, q.getVert n ∈ S ∧
      ∀ m ≤ q.length, n < m → q.getVert m ∉ S := by
  classical
  rcases h with ⟨s, hsq, hsS⟩
  rcases Walk.mem_support_iff_exists_getVert.mp hsq with ⟨n₀, hn₀, hn₀le⟩
  let indices : Finset ℕ :=
    (Finset.range (q.length + 1)).filter fun n => q.getVert n ∈ S
  have hindices : indices.Nonempty := by
    refine ⟨n₀, ?_⟩
    simp only [indices, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, hn₀ ▸ hsS⟩
  let n := indices.max' hindices
  have hnmem : n ∈ indices := indices.max'_mem hindices
  have hnle : n ≤ q.length := by
    have hnlt : n < q.length + 1 :=
      Finset.mem_range.mp (Finset.mem_filter.mp hnmem).1
    omega
  refine ⟨n, hnle, (Finset.mem_filter.mp hnmem).2, ?_⟩
  intro m hmle hnm hmS
  have hmMem : m ∈ indices := by
    simp only [indices, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, hmS⟩
  exact (not_lt_of_ge (indices.le_max' m hmMem)) hnm

/-- A finite walk that meets a set has a first indexed occurrence of that
set. -/
theorem exists_first_index_of_support_meets {V : Type} {G : SimpleGraph V}
    {a b : V} (q : G.Walk a b) (S : Set V)
    (h : ∃ s ∈ q.support, s ∈ S) :
    ∃ n ≤ q.length, q.getVert n ∈ S ∧
      ∀ m ≤ q.length, m < n → q.getVert m ∉ S := by
  classical
  rcases h with ⟨s, hsq, hsS⟩
  rcases Walk.mem_support_iff_exists_getVert.mp hsq with ⟨n₀, hn₀, hn₀le⟩
  have hex : ∃ n, n ≤ q.length ∧ q.getVert n ∈ S :=
    ⟨n₀, hn₀le, hn₀ ▸ hsS⟩
  let n := Nat.find hex
  have hn := Nat.find_spec hex
  refine ⟨n, hn.1, hn.2, ?_⟩
  intro m hm hmn hmS
  have hle : n ≤ m := Nat.find_min' hex ⟨hm, hmS⟩
  omega

/-- Last occurrence of a set among the positions up to a prescribed bound. -/
theorem exists_last_index_le_of_mem {V : Type} {G : SimpleGraph V}
    {a b : V} (q : G.Walk a b) (S : Set V) {j : ℕ}
    (h : ∃ n ≤ j, q.getVert n ∈ S) :
    ∃ n ≤ j, q.getVert n ∈ S ∧
      ∀ m ≤ j, n < m → q.getVert m ∉ S := by
  classical
  let indices : Finset ℕ :=
    (Finset.range (j + 1)).filter fun n => q.getVert n ∈ S
  have hindices : indices.Nonempty := by
    rcases h with ⟨n, hnj, hnS⟩
    refine ⟨n, ?_⟩
    simp only [indices, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, hnS⟩
  let n := indices.max' hindices
  have hnmem : n ∈ indices := indices.max'_mem hindices
  have hnj : n ≤ j := by
    have := Finset.mem_range.mp (Finset.mem_filter.mp hnmem).1
    omega
  refine ⟨n, hnj, (Finset.mem_filter.mp hnmem).2, ?_⟩
  intro m hmj hnm hmS
  have hmMem : m ∈ indices := by
    simp only [indices, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, hmS⟩
  exact (not_lt_of_ge (indices.le_max' m hmMem)) hnm

/-- In a simple path, a suffix beginning at `w` contains the original start
vertex only when `w` is that start vertex. -/
theorem start_mem_support_dropUntil_iff {V : Type} [DecidableEq V] {G : SimpleGraph V}
    {u v w : V} {p : G.Walk u v} (hp : p.IsPath) (hw : w ∈ p.support) :
    u ∈ (p.dropUntil w hw).support ↔ w = u := by
  classical
  constructor
  · intro hu
    rcases Walk.mem_support_iff_exists_getVert.mp hu with ⟨m, hm, hmle⟩
    rw [p.dropUntil_eq_drop hw] at hm
    simp only [Walk.getVert_copy, Walk.drop_getVert] at hm
    have hk : p.support.idxOf w + m ≤ p.length := by
      rw [p.length_dropUntil] at hmle
      have hidx : p.support.idxOf w ≤ p.length := by
        have := List.idxOf_lt_length_of_mem hw
        rw [p.length_support] at this
        omega
      omega
    have hzero : p.support.idxOf w + m = 0 :=
      (hp.getVert_eq_start_iff hk).mp hm
    have hidxzero : p.support.idxOf w = 0 := by omega
    calc
      w = p.getVert (p.support.idxOf w) := (p.getVert_support_idxOf hw).symm
      _ = p.getVert 0 := by rw [hidxzero]
      _ = u := p.getVert_zero
  · rintro rfl
    exact (p.dropUntil w hw).start_mem_support

/-- Away from the already deleted strict interior of `S`, exposure in the
quotient by `S` is the same as exposure in the original graph for every
larger set `T`. -/
theorem mem_essentialVertices_outsideGraph_interiorRoof_iff_of_subset
    {V : Type} {G : SimpleGraph V} {B S T : Set V} {x : V}
    (hST : S ⊆ T) (hxOutside : x ∉ interiorRoof G B S) :
    x ∈ essentialVertices (outsideGraph G (interiorRoof G B S)) B T ↔
      x ∈ essentialVertices G B T := by
  classical
  constructor
  · intro hxEssential
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨hxT, b, hb, q, hq, honly⟩
    let qG : G.Walk x b := q.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    have hqG : qG.IsPath := hq.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    apply mem_essentialVertices_iff.mpr
    refine ⟨hxT, b, hb, qG, hqG, ?_⟩
    intro z hzqG hzT
    apply honly z (by
      simpa [qG, Walk.support_mapLe_eq_support] using hzqG) hzT
  · intro hxEssential
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨hxT, b, hb, q, hq, honly⟩
    have houtside : ∀ y ∈ q.support, y ∉ interiorRoof G B S := by
      intro y hyq hyInterior
      rcases hyInterior.1 b hb (q.dropUntil y hyq) (hq.dropUntil hyq) with
        ⟨s, hsSuffix, hsS⟩
      have hsOnQ : s ∈ q.support :=
        q.support_dropUntil_subset_support hyq hsSuffix
      have hsx : s = x := honly s hsOnQ (hST hsS)
      subst s
      have hyx : y = x := (start_mem_support_dropUntil_iff hq hyq).mp hsSuffix
      subst y
      exact hxOutside hyInterior
    let q' : (outsideGraph G (interiorRoof G B S)).Walk x b :=
      Erdos599.Walk.toOutsideGraph q houtside
    have hq' : q'.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq houtside
    apply mem_essentialVertices_iff.mpr
    refine ⟨hxT, b, hb, q', hq', ?_⟩
    intro z hzq' hzT
    apply honly z (by simpa [q'] using hzq') hzT

/-- The deleted vertex set of two nested quotients is exactly the strict
interior deleted by the larger quotient.  This is the graph part of
Aharoni--Berger Lemma 2.27 in the spanning-graph representation. -/
theorem interiorRoof_union_interiorRoof_outsideGraph_eq_of_subset
    {V : Type} {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ T) :
    interiorRoof G B S ∪
        interiorRoof (outsideGraph G (interiorRoof G B S)) B T =
      interiorRoof G B T := by
  ext x
  by_cases hxS : x ∈ interiorRoof G B S
  · constructor
    · intro _
      exact interiorRoof_mono hST hxS
    · intro _
      exact Or.inl hxS
  · have hroof := roof_outsideGraph_interiorRoof_eq_of_subset
      (G := G) (B := B) hST
    have hessential :=
      mem_essentialVertices_outsideGraph_interiorRoof_iff_of_subset hST hxS
    constructor
    · rintro (hxOld | hxNew)
      · exact (hxS hxOld).elim
      · refine ⟨?_, ?_⟩
        · rw [← hroof]
          exact hxNew.1
        · intro hxEssential
          exact hxNew.2 (hessential.mpr hxEssential)
    · intro hxNew
      right
      refine ⟨?_, ?_⟩
      · rw [hroof]
        exact hxNew.1
      · intro hxEssential
        exact hxNew.2 (hessential.mp hxEssential)

/-- The first deleted strict interior is itself deleted at the second nested
quotient.  Its vertices are isolated in the first quotient, cannot be target
vertices, and consequently cannot be exposed there. -/
theorem interiorRoof_subset_interiorRoof_outsideGraph_of_subset
    {V : Type} {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ T) :
    interiorRoof G B S ⊆
      interiorRoof (outsideGraph G (interiorRoof G B S)) B T := by
  intro x hx
  refine ⟨?_, ?_⟩
  · rw [roof_outsideGraph_interiorRoof_eq_of_subset
      (G := G) (B := B) hST]
    exact (interiorRoof_mono hST hx).1
  · intro hxEssential
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨_xT, b, hb, q, _hq, _honly⟩
    cases q with
    | nil =>
        exact Set.disjoint_left.mp
          (target_disjoint_interiorRoof G B S) hb hx
    | cons h _q =>
        exact h.2.1 hx

/-- Thus the strict interior of `T` computed after quotienting by `S` is
already exactly the original strict interior of `T`. -/
theorem interiorRoof_outsideGraph_interiorRoof_eq_of_subset
    {V : Type} {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ T) :
    interiorRoof (outsideGraph G (interiorRoof G B S)) B T =
      interiorRoof G B T := by
  calc
    interiorRoof (outsideGraph G (interiorRoof G B S)) B T =
        interiorRoof G B S ∪
          interiorRoof (outsideGraph G (interiorRoof G B S)) B T :=
      (Set.union_eq_right.mpr
        (interiorRoof_subset_interiorRoof_outsideGraph_of_subset hST)).symm
    _ = interiorRoof G B T :=
      interiorRoof_union_interiorRoof_outsideGraph_eq_of_subset hST

/-- Nested quotients also preserve the exposed boundary of the larger set. -/
theorem essentialVertices_outsideGraph_interiorRoof_eq_of_subset
    {V : Type} {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ T) :
    essentialVertices (outsideGraph G (interiorRoof G B S)) B T =
      essentialVertices G B T := by
  ext x
  by_cases hxS : x ∈ interiorRoof G B S
  · have hxH :=
      interiorRoof_subset_interiorRoof_outsideGraph_of_subset hST hxS
    have hxG := interiorRoof_mono hST hxS
    constructor
    · intro hxEssential
      exact (Set.disjoint_left.mp
        (interiorRoof_disjoint
          (outsideGraph G (interiorRoof G B S)) B T)
        hxH hxEssential).elim
    · intro hxEssential
      exact (Set.disjoint_left.mp (interiorRoof_disjoint G B T)
        hxG hxEssential).elim
  · exact
      mem_essentialVertices_outsideGraph_interiorRoof_iff_of_subset hST hxS

/-- Graphs of nested quotients agree with the graph of the larger quotient
(Aharoni--Berger Lemma 2.27, graph component). -/
theorem outsideGraph_nestedQuotient_eq_of_subset
    {V : Type} {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ T) :
    outsideGraph (outsideGraph G (interiorRoof G B S))
        (interiorRoof (outsideGraph G (interiorRoof G B S)) B T) =
      outsideGraph G (interiorRoof G B T) := by
  rw [outsideGraph_outsideGraph,
    interiorRoof_union_interiorRoof_outsideGraph_eq_of_subset hST]

/-- The source sides of nested quotients agree with the source side of the
larger quotient (Aharoni--Berger Lemma 2.27, source component). -/
theorem quotientSource_nested_eq_of_subset {V : Type}
    {G : SimpleGraph V} {A B S T : Set V} (hST : S ⊆ T) :
    quotientSource (outsideGraph G (interiorRoof G B S))
        (quotientSource G A B S) B T =
      quotientSource G A B T := by
  have hI := interiorRoof_outsideGraph_interiorRoof_eq_of_subset
    (G := G) (B := B) hST
  unfold quotientSource
  rw [hI]
  ext x
  simp only [Set.mem_sdiff, Set.mem_union]
  constructor
  · rintro ⟨hOldOrT, hxNotT⟩
    refine ⟨?_, hxNotT⟩
    rcases hOldOrT with hOld | hxT
    · rcases hOld.1 with hxA | hxS
      · exact Or.inl hxA
      · exact Or.inr (hST hxS)
    · exact Or.inr hxT
  · rintro ⟨hxAorT, hxNotT⟩
    refine ⟨?_, hxNotT⟩
    rcases hxAorT with hxA | hxT
    · left
      exact ⟨Or.inl hxA, fun hxS =>
        hxNotT (interiorRoof_mono hST hxS)⟩
    · exact Or.inr hxT

/-! The subset form of the preceding quotient identities is convenient for
literal increasing chains of separators.  Successive stop-over sets in a
half-way linkage are only increasing in *roof order*: the old stop-over is
separated from `B` by the new one.  The following variants record exactly
that more general hypothesis. -/

/-- Deleting the strict roof of `S` does not change the roof of `T` whenever
`T` already roofs every point of `S`. -/
theorem roof_outsideGraph_interiorRoof_eq_of_subset_roof {V : Type}
    {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ roof G B T) :
    roof (outsideGraph G (interiorRoof G B S)) B T = roof G B T := by
  classical
  apply Set.Subset.antisymm
  · intro v hv b hb q hq
    by_cases hmeet : ∃ x ∈ q.support, x ∈ T
    · exact hmeet
    · push Not at hmeet
      have houtside : ∀ x ∈ q.support, x ∉ interiorRoof G B S := by
        intro x hxq hxInterior
        rcases hxInterior.1 b hb (q.dropUntil x hxq) (hq.dropUntil hxq) with
          ⟨s, hsSuffix, hsS⟩
        have hsOnQ : s ∈ q.support :=
          q.support_dropUntil_subset_support hxq hsSuffix
        rcases hST hsS b hb (q.dropUntil s hsOnQ) (hq.dropUntil hsOnQ) with
          ⟨t, htSuffix, htT⟩
        exact hmeet t
          (q.support_dropUntil_subset_support hsOnQ htSuffix) htT
      let q' : (outsideGraph G (interiorRoof G B S)).Walk v b :=
        Erdos599.Walk.toOutsideGraph q houtside
      have hq' : q'.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph hq houtside
      rcases hv b hb q' hq' with ⟨x, hxq', hxT⟩
      exact ⟨x, by simpa [q'] using hxq', hxT⟩
  · intro v hv b hb q hq
    let qG : G.Walk v b := q.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    have hqG : qG.IsPath := hq.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    rcases hv b hb qG hqG with ⟨x, hxqG, hxT⟩
    exact ⟨x, by simpa [qG, Walk.support_mapLe_eq_support] using hxqG, hxT⟩

/-- Strict roofs are monotone in roof order, not merely under literal
inclusion of the separating sets. -/
theorem interiorRoof_mono_of_subset_roof {V : Type}
    {G : SimpleGraph V} {B S T : Set V} (hST : S ⊆ roof G B T) :
    interiorRoof G B S ⊆ interiorRoof G B T := by
  classical
  intro x hx
  have hxRoofT : x ∈ roof G B T := by
    rw [← roof_roof G B T]
    exact roof_mono hST hx.1
  refine ⟨hxRoofT, ?_⟩
  intro hxEssentialT
  rcases mem_essentialVertices_iff.mp hxEssentialT with
    ⟨hxT, b, hb, q, hq, hqOnlyT⟩
  rcases hx.1 b hb q hq with ⟨s, hsq, hsS⟩
  rcases hST hsS b hb (q.dropUntil s hsq) (hq.dropUntil hsq) with
    ⟨t, htSuffix, htT⟩
  have htq : t ∈ q.support :=
    q.support_dropUntil_subset_support hsq htSuffix
  have htx : t = x := hqOnlyT t htq htT
  have hxsuffix : x ∈ (q.dropUntil s hsq).support := htx ▸ htSuffix
  have hsx : s = x := (start_mem_support_dropUntil_iff hq hsq).mp hxsuffix
  apply hx.2
  apply mem_essentialVertices_iff.mpr
  refine ⟨hsx ▸ hsS, b, hb, q, hq, ?_⟩
  intro z hzq hzS
  rcases hST hzS b hb (q.dropUntil z hzq) (hq.dropUntil hzq) with
    ⟨u, huSuffix, huT⟩
  have huq : u ∈ q.support :=
    q.support_dropUntil_subset_support hzq huSuffix
  have hux : u = x := hqOnlyT u huq huT
  have hxsuffix' : x ∈ (q.dropUntil z hzq).support := hux ▸ huSuffix
  exact (start_mem_support_dropUntil_iff hq hzq).mp hxsuffix'

/-- Away from the first strict roof, exposure of the later stop-over is the
same before and after quotienting, under the roof-order hypothesis. -/
theorem mem_essentialVertices_outsideGraph_interiorRoof_iff_of_subset_roof
    {V : Type} {G : SimpleGraph V} {B S T : Set V} {x : V}
    (hST : S ⊆ roof G B T) (hxOutside : x ∉ interiorRoof G B S) :
    x ∈ essentialVertices (outsideGraph G (interiorRoof G B S)) B T ↔
      x ∈ essentialVertices G B T := by
  classical
  constructor
  · intro hxEssential
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨hxT, b, hb, q, hq, honly⟩
    let qG : G.Walk x b := q.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    have hqG : qG.IsPath := hq.mapLe
      (outsideGraph_le G (interiorRoof G B S))
    apply mem_essentialVertices_iff.mpr
    refine ⟨hxT, b, hb, qG, hqG, ?_⟩
    intro z hzqG hzT
    exact honly z (by
      simpa [qG, Walk.support_mapLe_eq_support] using hzqG) hzT
  · intro hxEssential
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨hxT, b, hb, q, hq, honlyT⟩
    have houtside : ∀ y ∈ q.support, y ∉ interiorRoof G B S := by
      intro y hyq hyInterior
      rcases hyInterior.1 b hb (q.dropUntil y hyq) (hq.dropUntil hyq) with
        ⟨s, hsSuffix, hsS⟩
      have hsOnQ : s ∈ q.support :=
        q.support_dropUntil_subset_support hyq hsSuffix
      rcases hST hsS b hb (q.dropUntil s hsOnQ) (hq.dropUntil hsOnQ) with
        ⟨t, htSuffix, htT⟩
      have htOnQ : t ∈ q.support :=
        q.support_dropUntil_subset_support hsOnQ htSuffix
      have htx : t = x := honlyT t htOnQ htT
      have hxAfterS : x ∈ (q.dropUntil s hsOnQ).support := htx ▸ htSuffix
      have hsx : s = x :=
        (start_mem_support_dropUntil_iff hq hsOnQ).mp hxAfterS
      have hxAfterY : x ∈ (q.dropUntil y hyq).support := hsx ▸ hsSuffix
      have hyx : y = x :=
        (start_mem_support_dropUntil_iff hq hyq).mp hxAfterY
      exact hxOutside (hyx ▸ hyInterior)
    let q' : (outsideGraph G (interiorRoof G B S)).Walk x b :=
      Erdos599.Walk.toOutsideGraph q houtside
    have hq' : q'.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq houtside
    apply mem_essentialVertices_iff.mpr
    refine ⟨hxT, b, hb, q', hq', ?_⟩
    intro z hzq' hzT
    exact honlyT z (by simpa [q'] using hzq') hzT

/-- The two deleted strict roofs collapse to the later strict roof under
roof-order nesting. -/
theorem interiorRoof_union_interiorRoof_outsideGraph_eq_of_subset_roof
    {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (hST : S ⊆ roof G B T) :
    interiorRoof G B S ∪
        interiorRoof (outsideGraph G (interiorRoof G B S)) B T =
      interiorRoof G B T := by
  ext x
  by_cases hxS : x ∈ interiorRoof G B S
  · constructor
    · intro _
      exact interiorRoof_mono_of_subset_roof hST hxS
    · intro _
      exact Or.inl hxS
  · have hroof := roof_outsideGraph_interiorRoof_eq_of_subset_roof
      (G := G) (B := B) hST
    have hessential :=
      mem_essentialVertices_outsideGraph_interiorRoof_iff_of_subset_roof
        hST hxS
    constructor
    · rintro (hxOld | hxNew)
      · exact (hxS hxOld).elim
      · refine ⟨?_, ?_⟩
        · rw [← hroof]
          exact hxNew.1
        · intro hxEssential
          exact hxNew.2 (hessential.mpr hxEssential)
    · intro hxNew
      right
      refine ⟨?_, ?_⟩
      · rw [hroof]
        exact hxNew.1
      · intro hxEssential
        exact hxNew.2 (hessential.mp hxEssential)

/-- The old deleted interior is also deleted by the second quotient under
roof-order nesting. -/
theorem interiorRoof_subset_interiorRoof_outsideGraph_of_subset_roof
    {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (hST : S ⊆ roof G B T) :
    interiorRoof G B S ⊆
      interiorRoof (outsideGraph G (interiorRoof G B S)) B T := by
  intro x hx
  refine ⟨?_, ?_⟩
  · rw [roof_outsideGraph_interiorRoof_eq_of_subset_roof
      (G := G) (B := B) hST]
    exact (interiorRoof_mono_of_subset_roof hST hx).1
  · intro hxEssential
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨_xT, b, hb, q, _hq, _honly⟩
    cases q with
    | nil =>
        exact Set.disjoint_left.mp
          (target_disjoint_interiorRoof G B S) hb hx
    | cons h _q =>
        exact h.2.1 hx

/-- The second quotient's deleted interior is already the ambient strict
roof of the later stop-over. -/
theorem interiorRoof_outsideGraph_interiorRoof_eq_of_subset_roof
    {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (hST : S ⊆ roof G B T) :
    interiorRoof (outsideGraph G (interiorRoof G B S)) B T =
      interiorRoof G B T := by
  calc
    interiorRoof (outsideGraph G (interiorRoof G B S)) B T =
        interiorRoof G B S ∪
          interiorRoof (outsideGraph G (interiorRoof G B S)) B T :=
      (Set.union_eq_right.mpr
        (interiorRoof_subset_interiorRoof_outsideGraph_of_subset_roof hST)).symm
    _ = interiorRoof G B T :=
      interiorRoof_union_interiorRoof_outsideGraph_eq_of_subset_roof hST

/-- Graphs of roof-nested quotients agree with the direct later quotient. -/
theorem outsideGraph_nestedQuotient_eq_of_subset_roof
    {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (hST : S ⊆ roof G B T) :
    outsideGraph (outsideGraph G (interiorRoof G B S))
        (interiorRoof (outsideGraph G (interiorRoof G B S)) B T) =
      outsideGraph G (interiorRoof G B T) := by
  rw [outsideGraph_outsideGraph,
    interiorRoof_union_interiorRoof_outsideGraph_eq_of_subset_roof hST]

/-- Source sides of roof-nested quotients agree with the direct later
quotient. -/
theorem quotientSource_nested_eq_of_subset_roof {V : Type}
    {G : SimpleGraph V} {A B S T : Set V}
    (hST : S ⊆ roof G B T) :
    quotientSource (outsideGraph G (interiorRoof G B S))
        (quotientSource G A B S) B T =
      quotientSource G A B T := by
  have hI := interiorRoof_outsideGraph_interiorRoof_eq_of_subset_roof
    (G := G) (B := B) hST
  unfold quotientSource
  rw [hI]
  ext x
  simp only [Set.mem_sdiff, Set.mem_union]
  constructor
  · rintro ⟨hOldOrT, hxNotT⟩
    refine ⟨?_, hxNotT⟩
    rcases hOldOrT with hOld | hxT
    · rcases hOld.1 with hxA | hxS
      · exact Or.inl hxA
      · right
        have hxRoofT : x ∈ roof G B T := hST hxS
        have hxEssentialT : x ∈ essentialVertices G B T := by
          by_contra hxNotEssential
          exact hxNotT ⟨hxRoofT, hxNotEssential⟩
        exact essentialVertices_subset G B T hxEssentialT
    · exact Or.inr hxT
  · rintro ⟨hxAorT, hxNotT⟩
    refine ⟨?_, hxNotT⟩
    rcases hxAorT with hxA | hxT
    · left
      exact ⟨Or.inl hxA, fun hxS =>
        hxNotT (interiorRoof_mono_of_subset_roof hST hxS)⟩
    · exact Or.inr hxT

/-- The last `S`-vertex of a finite path to `B` belongs to `E(S)`. -/
theorem exists_mem_support_essentialVertices {V : Type} {G : SimpleGraph V}
    {a b : V} {B S : Set V} {q : G.Walk a b}
    (hb : b ∈ B) (hq : q.IsPath) (h : ∃ s ∈ q.support, s ∈ S) :
    ∃ s ∈ q.support, s ∈ essentialVertices G B S := by
  classical
  rcases exists_last_index_of_support_meets q S h with
    ⟨n, hnle, hnS, hnlast⟩
  let s := q.getVert n
  refine ⟨s, q.getVert_mem_support n, (mem_essentialVertices_iff).mpr
    ⟨hnS, b, hb, q.drop n, hq.drop n, ?_⟩⟩
  intro x hxq hxS
  rcases Walk.mem_support_iff_exists_getVert.mp hxq with ⟨m, hm, hmle⟩
  have hnmle : n + m ≤ q.length := by
    rw [Walk.drop_length] at hmle
    omega
  have hnmS : q.getVert (n + m) ∈ S := by
    rw [← q.drop_getVert n m, hm]
    exact hxS
  have hm0 : m = 0 := by
    by_contra hm0
    exact hnlast (n + m) hnmle (by omega) hnmS
  subst m
  simpa [s] using hm.symm

/-- Trimming a separator to its essential vertices preserves separation
(Aharoni--Berger Lemma 2.14).  On a fixed finite path, choose the last
separator vertex; the suffix starting there certifies essentiality. -/
theorem essentialVertices_separates {V : Type} {G : SimpleGraph V}
    {A B S : Set V} (hS : Separates G A B S) :
    Separates G A B (essentialVertices G B S) := by
  classical
  intro a ha b hb q hq
  rcases hS a ha b hb q hq with ⟨s₀, hs₀q, hs₀S⟩
  rcases Walk.mem_support_iff_exists_getVert.mp hs₀q with ⟨n₀, hn₀, hn₀le⟩
  let indices : Finset ℕ :=
    (Finset.range (q.length + 1)).filter fun n => q.getVert n ∈ S
  have hindices : indices.Nonempty := by
    refine ⟨n₀, ?_⟩
    simp only [indices, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, hn₀ ▸ hs₀S⟩
  let n := indices.max' hindices
  have hnmem : n ∈ indices := indices.max'_mem hindices
  have hnle : n ≤ q.length := by
    have : n < q.length + 1 := Finset.mem_range.mp (Finset.mem_filter.mp hnmem).1
    omega
  have hnS : q.getVert n ∈ S := (Finset.mem_filter.mp hnmem).2
  let s := q.getVert n
  refine ⟨s, q.getVert_mem_support n, (mem_essentialVertices_iff).mpr
    ⟨hnS, b, hb, q.drop n, hq.drop n, ?_⟩⟩
  intro x hxq hxS
  rcases Walk.mem_support_iff_exists_getVert.mp hxq with ⟨m, hm, hmle⟩
  have hnmle : n + m ≤ q.length := by
    rw [Walk.drop_length] at hmle
    omega
  have hnmS : q.getVert (n + m) ∈ S := by
    rw [← q.drop_getVert n m, hm]
    exact hxS
  have hnmMem : n + m ∈ indices := by
    simp only [indices, Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, hnmS⟩
  have hmn : n + m ≤ n := indices.le_max' (n + m) hnmMem
  have hm0 : m = 0 := by omega
  subst m
  simpa [s] using hm.symm

/-- The exposed boundary is a minimal separator from itself to the target.
The private path supplied by exposure witnesses necessity of each point. -/
theorem essentialVertices_minimal_self_separator {V : Type}
    (G : SimpleGraph V) (B S : Set V) :
    Minimal (Separates G (essentialVertices G B S) B)
      (essentialVertices G B S) := by
  constructor
  · intro e he b hb q hq
    exact ⟨e, q.start_mem_support, he⟩
  · intro T hT hTE e he
    rcases mem_essentialVertices_iff.mp he with
      ⟨heS, b, hb, q, hq, hqOnly⟩
    rcases hT e he b hb q hq with ⟨x, hxq, hxT⟩
    have hxE : x ∈ essentialVertices G B S := hTE hxT
    have hxe : x = e := hqOnly x hxq
      (essentialVertices_subset G B S hxE)
    simpa [hxe] using hxT

/-- The exposed boundary remains a minimal separator in the quotient's
exterior graph.  Each exposure witness has an exterior tail: a later roof
vertex would force a second visit to `S`. -/
theorem essentialVertices_minimal_outside_separator {V : Type}
    (G : SimpleGraph V) (B S : Set V) :
    Minimal
      (Separates (outsideGraph G (interiorRoof G B S))
        (essentialVertices G B S) B)
      (essentialVertices G B S) := by
  classical
  constructor
  · intro e he b hb q hq
    exact ⟨e, q.start_mem_support, he⟩
  · intro T hT hTE e he
    rcases mem_essentialVertices_iff.mp he with
      ⟨heS, b, hb, q, hq, hqOnly⟩
    have hqOutside : ∀ y ∈ q.support, y ∉ interiorRoof G B S := by
      intro y hy hyInterior
      by_cases hye : y = e
      · subst y
        exact Set.disjoint_left.mp (interiorRoof_disjoint G B S)
          hyInterior he
      · rcases hyInterior.1 b hb (q.dropUntil y hy) (hq.dropUntil hy) with
          ⟨s, hsSuffix, hsS⟩
        have hsOnQ : s ∈ q.support := q.support_dropUntil_subset_support hy hsSuffix
        have hse : s = e := hqOnly s hsOnQ hsS
        subst s
        exact hye ((start_mem_support_dropUntil_iff hq hy).mp hsSuffix)
    let q' := Erdos599.Walk.toOutsideGraph q hqOutside
    have hq' : q'.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq hqOutside
    rcases hT e he b hb q' hq' with ⟨x, hxq, hxT⟩
    have hxqOriginal : x ∈ q.support := by
      have := hxq
      rw [Erdos599.Walk.support_toOutsideGraph] at this
      exact this
    have hxE : x ∈ essentialVertices G B S := hTE hxT
    have hxe : x = e := hqOnly x hxqOriginal
      (essentialVertices_subset G B S hxE)
    simpa [hxe] using hxT

/-- Trimming does not change the roof. -/
@[simp] theorem roof_essentialVertices {V : Type} (G : SimpleGraph V)
    (B S : Set V) :
    roof G B (essentialVertices G B S) = roof G B S := by
  apply Set.Subset.antisymm
  · exact roof_mono (essentialVertices_subset G B S)
  · intro v hv b hb q hq
    have hsep : Separates G {v} B S := by
      intro x hx
      have hxv : x = v := Set.mem_singleton_iff.mp hx
      subst x
      exact hv
    exact essentialVertices_separates hsep v (Set.mem_singleton v) b hb q hq

/-- The essential boundary is trimmed: trimming it again removes nothing. -/
@[simp] theorem essentialVertices_idem {V : Type} (G : SimpleGraph V)
    (B S : Set V) :
    essentialVertices G B (essentialVertices G B S) =
      essentialVertices G B S := by
  apply Set.Subset.antisymm
  · exact essentialVertices_subset G B (essentialVertices G B S)
  · intro s hs
    rcases mem_essentialVertices_iff.mp hs with ⟨hsS, b, hb, q, hq, honly⟩
    apply mem_essentialVertices_iff.mpr
    refine ⟨hs, b, hb, q, hq, ?_⟩
    intro x hxq hxEssential
    exact honly x hxq (essentialVertices_subset G B S hxEssential)

/-- Aharoni--Berger Lemma 2.17: if `E(D) ⊆ C ⊆ D`, then `C` and `D`
have the same essential boundary. -/
theorem essentialVertices_eq_of_between {V : Type} {G : SimpleGraph V}
    {B C D : Set V}
    (hEDC : essentialVertices G B D ⊆ C) (hCD : C ⊆ D) :
    essentialVertices G B C = essentialVertices G B D := by
  apply Set.Subset.antisymm
  · intro s hsC
    rcases mem_essentialVertices_iff.mp hsC with ⟨hsCmem, b, hb, q, hq, honly⟩
    have hsDmem : s ∈ D := hCD hsCmem
    rcases exists_mem_support_essentialVertices hb hq
        ⟨s, q.start_mem_support, hsDmem⟩ with ⟨y, hyq, hyD⟩
    have hys : y = s := honly y hyq (hEDC hyD)
    simpa [hys] using hyD
  · intro s hsD
    rcases mem_essentialVertices_iff.mp hsD with ⟨hsDmem, b, hb, q, hq, honly⟩
    apply mem_essentialVertices_iff.mpr
    refine ⟨hEDC hsD, b, hb, q, hq, ?_⟩
    intro x hxq hxC
    exact honly x hxq (hCD hxC)

/-- The exposed boundary depends only on the roof: `E(RF(S)) = E(S)`. -/
theorem essentialVertices_roof {V : Type} (G : SimpleGraph V)
    (B S : Set V) :
    essentialVertices G B (roof G B S) = essentialVertices G B S := by
  symm
  apply essentialVertices_eq_of_between
  · intro x hx
    rcases mem_essentialVertices_iff.mp hx with
      ⟨hxRoof, b, hb, q, hq, honly⟩
    rcases hxRoof b hb q hq with ⟨y, hyq, hyS⟩
    have hyRoof : y ∈ roof G B S := subset_roof G B S hyS
    have hyx : y = x := honly y hyq hyRoof
    simpa [hyx] using hyS
  · exact subset_roof G B S

theorem essentialVertices_eq_of_roof_eq {V : Type} {G : SimpleGraph V}
    {B S T : Set V} (h : roof G B S = roof G B T) :
    essentialVertices G B S = essentialVertices G B T := by
  rw [← essentialVertices_roof G B S, h, essentialVertices_roof]

/-- Taking the roof of a separator does not change its strict roof. -/
@[simp] theorem interiorRoof_roof {V : Type} (G : SimpleGraph V)
    (B S : Set V) :
    interiorRoof G B (roof G B S) = interiorRoof G B S := by
  unfold interiorRoof
  rw [roof_roof, essentialVertices_roof]

/-- Strict roofs are monotone for the roof order, not merely for inclusion
of the underlying separators. -/
theorem interiorRoof_mono_of_roof_subset {V : Type} {G : SimpleGraph V}
    {B S T : Set V} (h : roof G B S ⊆ roof G B T) :
    interiorRoof G B S ⊆ interiorRoof G B T := by
  have h' := interiorRoof_mono (G := G) (B := B) h
  simpa using h'

/-- Passing to a spanning subgraph and shrinking the target preserves every
point already lying in a strict roof. -/
theorem interiorRoof_mono_subgraph_antitone_target
    {V : Type} {G H : SimpleGraph V} {B C S : Set V}
    (hHG : H ≤ G) (hCB : C ⊆ B) :
    interiorRoof G B S ⊆ interiorRoof H C S := by
  intro x hx
  refine ⟨?_, ?_⟩
  · intro c hc q hq
    let qG : G.Walk x c := q.mapLe hHG
    have hqG : qG.IsPath := hq.mapLe hHG
    rcases hx.1 c (hCB hc) qG hqG with ⟨s, hsqG, hsS⟩
    exact ⟨s, by simpa [qG, Walk.support_mapLe_eq_support] using hsqG, hsS⟩
  · intro hxEssential
    apply hx.2
    rcases mem_essentialVertices_iff.mp hxEssential with
      ⟨hxS, c, hc, q, hq, honly⟩
    let qG : G.Walk x c := q.mapLe hHG
    have hqG : qG.IsPath := hq.mapLe hHG
    apply mem_essentialVertices_iff.mpr
    refine ⟨hxS, c, hCB hc, qG, hqG, ?_⟩
    intro z hzqG hzS
    exact honly z (by
      simpa [qG, Walk.support_mapLe_eq_support] using hzqG) hzS

/-- Aharoni--Berger Observation 2.18.  Two disjoint sets that roof each
other modulo `S` and `T` are jointly roofed by `S ∪ T`.  The proof takes the
last `X ∪ Y` vertex of a hypothetical avoiding path. -/
theorem union_subset_roof_of_mutual {V : Type} {G : SimpleGraph V}
    {B S T X Y : Set V} (hXY : Disjoint X Y)
    (hX : X ⊆ roof G B (T ∪ Y)) (hY : Y ⊆ roof G B (S ∪ X)) :
    X ∪ Y ⊆ roof G B (S ∪ T) := by
  classical
  intro z hz b hb q hq
  by_contra hmeet
  push Not at hmeet
  rcases exists_last_index_of_support_meets q (X ∪ Y)
      ⟨z, q.start_mem_support, hz⟩ with ⟨n, hnle, hnXY, hnlast⟩
  let x := q.getVert n
  have hsuffixOnly :
      ∀ w ∈ (q.drop n).support, w ∈ X ∪ Y → w = x := by
    intro w hwq hwXY
    rcases Walk.mem_support_iff_exists_getVert.mp hwq with ⟨m, hm, hmle⟩
    have hnmle : n + m ≤ q.length := by
      rw [Walk.drop_length] at hmle
      omega
    have hnmXY : q.getVert (n + m) ∈ X ∪ Y := by
      rw [← q.drop_getVert n m, hm]
      exact hwXY
    have hm0 : m = 0 := by
      by_contra hm0
      exact hnlast (n + m) hnmle (by omega) hnmXY
    subst m
    simpa [x] using hm.symm
  rcases hnXY with hx | hy
  · rcases hX hx b hb (q.drop n) (hq.drop n) with ⟨w, hwq, hw⟩
    rcases hw with hwT | hwY
    · exact hmeet w ((q.isSubwalk_drop n).support_subset hwq) (Or.inr hwT)
    · have hwx : w = x := hsuffixOnly w hwq (Or.inr hwY)
      have hxY : x ∈ Y := by simpa [hwx] using hwY
      exact Set.disjoint_left.mp hXY hx hxY
  · rcases hY hy b hb (q.drop n) (hq.drop n) with ⟨w, hwq, hw⟩
    rcases hw with hwS | hwX
    · exact hmeet w ((q.isSubwalk_drop n).support_subset hwq) (Or.inl hwS)
    · have hwx : w = x := hsuffixOnly w hwq (Or.inl hwX)
      have hxX : x ∈ X := by simpa [hwx] using hwX
      exact Set.disjoint_left.mp hXY hxX hy

/-- Aharoni--Berger Lemma 2.19.  A set whose roof lies between the roofs of
`R` and a trimmed `T` separates `R` from `T`. -/
theorem separates_of_roof_chain {V : Type} {G : SimpleGraph V}
    {B R S T : Set V}
    (htrim : essentialVertices G B T = T)
    (hRS : roof G B R ⊆ roof G B S)
    (hST : roof G B S ⊆ roof G B T) :
    Separates G R T S := by
  classical
  intro r hr t ht p hp
  have htEssential : t ∈ essentialVertices G B T := by
    rw [htrim]
    exact ht
  rcases mem_essentialVertices_iff.mp htEssential with
    ⟨htT, b, hb, q, hq, hqOnly⟩
  have hrRoofS : r ∈ roof G B S :=
    hRS (subset_roof G B R hr)
  let w : G.Path r b := (p.append q).toPath
  rcases hrRoofS b hb (w : G.Walk r b) w.property with ⟨y, hyw, hyS⟩
  have hyAppend : y ∈ (p.append q).support :=
    (p.append q).support_toPath_subset_support hyw
  rw [p.support_append_eq_support_dropLast_append q] at hyAppend
  rcases List.mem_append.mp hyAppend with hyp | hyq
  · exact ⟨y, List.mem_of_mem_dropLast hyp, hyS⟩
  · have hyRoofT : y ∈ roof G B T := hST (subset_roof G B S hyS)
    rcases hyRoofT b hb (q.dropUntil y hyq) (hq.dropUntil hyq) with
      ⟨z, hzq, hzT⟩
    have hzt : z = t := hqOnly z (q.support_dropUntil_subset_support hyq hzq) hzT
    have htSuffix : t ∈ (q.dropUntil y hyq).support := by
      simpa [hzt] using hzq
    have hyt : y = t := (start_mem_support_dropUntil_iff hq hyq).mp htSuffix
    exact ⟨y, hyt ▸ p.end_mem_support, hyS⟩

/-- Aharoni--Berger Lemma 2.16.  The last point of a finite path in
`RF(S)` is either exposed in `E(S)` or is the terminal point of the path. -/
theorem exists_last_roof_vertex_essential_or_end {V : Type}
    {G : SimpleGraph V} {B S : Set V} {a b : V} {p : G.Walk a b}
    (h : ∃ x ∈ p.support, x ∈ roof G B S) :
    ∃ x ∈ p.support, x ∈ roof G B S ∧
      (x ∈ essentialVertices G B S ∨ x = b) := by
  classical
  rcases exists_last_index_of_support_meets p (roof G B S) h with
    ⟨n, hnle, hnRoof, hnlast⟩
  let x := p.getVert n
  refine ⟨x, p.getVert_mem_support n, hnRoof, ?_⟩
  by_cases hn : n = p.length
  · exact Or.inr (by simp [x, hn])
  · have hnlt : n < p.length := lt_of_le_of_ne hnle hn
    let u := p.getVert (n + 1)
    have huNotRoof : u ∉ roof G B S := by
      exact hnlast (n + 1) (by omega) (by omega)
    simp only [roof, Set.mem_ofPred_eq] at huNotRoof
    push Not at huNotRoof
    rcases huNotRoof with ⟨c, hcB, q, hq, hqAvoid⟩
    have hadj : G.Adj x u := by
      exact p.adj_getVert_succ hnlt
    have hxNotRoof (T : Set V) (hTS : T ⊆ S) (hxT : x ∉ T) :
        x ∉ roof G B T := by
      intro hxRoof
      let r : G.Walk x c := q.cons hadj
      let rPath : G.Path x c := r.toPath
      rcases hxRoof c hcB (rPath : G.Walk x c) rPath.property with
        ⟨y, hyrPath, hyT⟩
      have hyr : y ∈ r.support := r.support_toPath_subset_support hyrPath
      simp only [r, Walk.support_cons, List.mem_cons] at hyr
      rcases hyr with hyx | hyq
      · exact hxT (hyx ▸ hyT)
      · exact hqAvoid y hyq (hTS hyT)
    have hxS : x ∈ S := by
      by_contra hxS
      exact hxNotRoof S (fun _ => id) hxS hnRoof
    exact Or.inl ⟨hxS, hxNotRoof (S \ {x}) (Set.sdiff_subset) (by simp)⟩

/-- Indexed form of Lemma 2.16, retaining the maximality property needed to
construct the suffix used by the arrow operation. -/
theorem exists_last_roof_index {V : Type} {G : SimpleGraph V}
    {B S : Set V} {a b : V} (p : G.Walk a b)
    (h : ∃ x ∈ p.support, x ∈ roof G B S) :
    ∃ n ≤ p.length, p.getVert n ∈ roof G B S ∧
      (p.getVert n ∈ essentialVertices G B S ∨ n = p.length) ∧
      ∀ m ≤ p.length, n < m → p.getVert m ∉ roof G B S := by
  classical
  rcases exists_last_index_of_support_meets p (roof G B S) h with
    ⟨n, hnle, hnRoof, hnlast⟩
  refine ⟨n, hnle, hnRoof, ?_, hnlast⟩
  by_cases hn : n = p.length
  · exact Or.inr hn
  · have hnlt : n < p.length := lt_of_le_of_ne hnle hn
    let x := p.getVert n
    let u := p.getVert (n + 1)
    have huNotRoof : u ∉ roof G B S := hnlast (n + 1) (by omega) (by omega)
    simp only [roof, Set.mem_ofPred_eq] at huNotRoof
    push Not at huNotRoof
    rcases huNotRoof with ⟨c, hcB, q, hq, hqAvoid⟩
    have hadj : G.Adj x u := p.adj_getVert_succ hnlt
    have hxNotRoof (T : Set V) (hTS : T ⊆ S) (hxT : x ∉ T) :
        x ∉ roof G B T := by
      intro hxRoof
      let r : G.Walk x c := q.cons hadj
      let rPath : G.Path x c := r.toPath
      rcases hxRoof c hcB (rPath : G.Walk x c) rPath.property with
        ⟨y, hyrPath, hyT⟩
      have hyr : y ∈ r.support := r.support_toPath_subset_support hyrPath
      simp only [r, Walk.support_cons, List.mem_cons] at hyr
      rcases hyr with hyx | hyq
      · exact hxT (hyx ▸ hyT)
      · exact hqAvoid y hyq (hTS hyT)
    have hxS : x ∈ S := by
      by_contra hxS
      exact hxNotRoof S (fun _ => id) hxS hnRoof
    exact Or.inl ⟨hxS, hxNotRoof (S \ {x}) Set.sdiff_subset (by simp)⟩

/-- The set-theoretic lower limit of a family indexed by an order: membership
from some index onward. -/
def orderLiminf {ι V : Type} [Preorder ι] (S : ι → Set V) : Set V :=
  {v | ∃ i, ∀ j, i ≤ j → v ∈ S j}

/-- Aharoni--Berger Lemma 2.21, in a slightly more general linearly indexed
form.  If each earlier set is roofed by every later set, the roof of the
lower limit contains every earlier roof.  Finiteness enters through the last
vertex of a fixed finite witness path. -/
theorem iUnion_roof_subset_roof_orderLiminf {ι V : Type} [LinearOrder ι]
    {G : SimpleGraph V} {B : Set V} (S : ι → Set V)
    (hchain : ∀ ⦃i j⦄, i < j → S i ⊆ roof G B (S j)) :
    (⋃ i, roof G B (S i)) ⊆ roof G B (orderLiminf S) := by
  classical
  intro v hv
  rcases Set.mem_iUnion.mp hv with ⟨i, hvi⟩
  intro b hb q hq
  rcases hvi b hb q hq with ⟨y, hyq, hySi⟩
  have hUnionMeet : ∃ y ∈ q.support, y ∈ ⋃ i, S i :=
    ⟨y, hyq, Set.mem_iUnion.mpr ⟨i, hySi⟩⟩
  rcases exists_last_index_of_support_meets q (⋃ i, S i) hUnionMeet with
    ⟨n, hnle, hnUnion, hnlast⟩
  let t := q.getVert n
  rcases Set.mem_iUnion.mp hnUnion with ⟨k, htk⟩
  refine ⟨t, q.getVert_mem_support n, ?_⟩
  refine ⟨k, ?_⟩
  intro j hkj
  rcases hkj.eq_or_lt with hkj | hkj
  · simpa [hkj] using htk
  · have htRoof : t ∈ roof G B (S j) := hchain hkj htk
    rcases htRoof b hb (q.drop n) (hq.drop n) with ⟨z, hzq, hzSj⟩
    rcases Walk.mem_support_iff_exists_getVert.mp hzq with ⟨m, hm, hmle⟩
    have hnmle : n + m ≤ q.length := by
      rw [Walk.drop_length] at hmle
      omega
    have hnmUnion : q.getVert (n + m) ∈ ⋃ i, S i := by
      rw [← q.drop_getVert n m, hm]
      exact Set.mem_iUnion.mpr ⟨j, hzSj⟩
    have hm0 : m = 0 := by
      by_contra hm0
      exact hnlast (n + m) hnmle (by omega) hnmUnion
    subst m
    have hzt : z = t := by simpa [t] using hm.symm
    simpa [hzt] using hzSj

/-- The active indices of a finite or one-way-infinite path.  `some k`
means that the path has indices `0, ..., k`; `none` means that every natural
number is active. -/
def longPathActive (terminalIndex : Option ℕ) (n : ℕ) : Prop :=
  match terminalIndex with
  | some k => n ≤ k
  | none => True

/-- A simple directed traversal in an undirected graph that is either finite
or a one-way infinite ray.  Aharoni--Berger's paths always have an initial
vertex, and these are precisely the two path shapes used by their warps.

Values of `vertex` beyond the terminal index of a finite path are deliberately
ignored.  This representation makes restriction and ordinal-limit operations
use ordinary subsets of `ℕ`, while `injective` and `adjacent` enforce the path
laws on exactly the active indices. -/
structure LongPath {V : Type} (G : SimpleGraph V) where
  terminalIndex : Option ℕ
  vertex : ℕ → V
  injective : Set.InjOn vertex {n | longPathActive terminalIndex n}
  adjacent : ∀ n, longPathActive terminalIndex (n + 1) →
    G.Adj (vertex n) (vertex (n + 1))

namespace LongPath

theorem active_mono {o : Option ℕ} {m n : ℕ} (hmn : m ≤ n)
    (hn : longPathActive o n) : longPathActive o m := by
  cases o with
  | none => trivial
  | some k =>
      simp only [longPathActive] at hn ⊢
      exact hmn.trans hn

def initial {V : Type} {G : SimpleGraph V} (p : LongPath G) : V :=
  p.vertex 0

def terminal? {V : Type} {G : SimpleGraph V} (p : LongPath G) : Option V :=
  p.terminalIndex.map p.vertex

/-- An active occurrence which is not the terminal occurrence has an active
successor. -/
theorem active_succ_of_active_of_terminal_ne {V : Type}
    {G : SimpleGraph V} (p : LongPath G) {n : ℕ}
    (hn : longPathActive p.terminalIndex n)
    (hterminal : p.terminal? ≠ some (p.vertex n)) :
    longPathActive p.terminalIndex (n + 1) := by
  cases h : p.terminalIndex with
  | none => simp [longPathActive, h]
  | some k =>
      have hnk : n ≤ k := by simpa [longPathActive, h] using hn
      have hnlt : n < k := by
        by_contra hnlt
        have hkn : k ≤ n := Nat.le_of_not_gt hnlt
        have hknEq : k = n := le_antisymm hkn hnk
        apply hterminal
        simp [terminal?, h, hknEq]
      simpa [longPathActive, h] using hnlt

def vertexSet {V : Type} {G : SimpleGraph V} (p : LongPath G) : Set V :=
  {v | ∃ n, longPathActive p.terminalIndex n ∧ p.vertex n = v}

/-- The oriented darts traversed by a long path.  Unlike Mathlib's
undirected `edgeSet`, orientation matters for alternating walks: a dart of a
warp is removed precisely when the alternating walk traverses its symmetric
dart. -/
def dartSet {V : Type} {G : SimpleGraph V} (p : LongPath G) : Set G.Dart :=
  {d | ∃ n, longPathActive p.terminalIndex (n + 1) ∧
    d.1 = (p.vertex n, p.vertex (n + 1))}

theorem fst_mem_vertexSet_of_mem_dartSet {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {d : G.Dart} (hd : d ∈ p.dartSet) :
    d.fst ∈ p.vertexSet := by
  rcases hd with ⟨n, hn, hd⟩
  exact ⟨n, active_mono (Nat.le_succ n) hn,
    (congrArg Prod.fst hd).symm⟩

theorem snd_mem_vertexSet_of_mem_dartSet {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {d : G.Dart} (hd : d ∈ p.dartSet) :
    d.snd ∈ p.vertexSet := by
  rcases hd with ⟨n, hn, hd⟩
  exact ⟨n + 1, hn, (congrArg Prod.snd hd).symm⟩

/-- A simple directed traversal never contains both orientations of one
edge. -/
theorem symm_not_mem_dartSet {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {d : G.Dart} (hd : d ∈ p.dartSet) :
    d.symm ∉ p.dartSet := by
  rintro ⟨m, hm, hdm⟩
  rcases hd with ⟨n, hn, hdn⟩
  change d.toProd.swap = (p.vertex m, p.vertex (m + 1)) at hdm
  rw [hdn] at hdm
  have hnm : p.vertex (n + 1) = p.vertex m := congrArg Prod.fst hdm
  have hmn : p.vertex n = p.vertex (m + 1) := congrArg Prod.snd hdm
  have hn0 := active_mono (Nat.le_succ n) hn
  have hm0 := active_mono (Nat.le_succ m) hm
  have hindex₁ : n + 1 = m := p.injective hn hm0 hnm
  have hindex₂ : n = m + 1 := p.injective hn0 hm hmn
  omega

theorem dart_eq_of_fst_eq {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {d e : G.Dart}
    (hd : d ∈ p.dartSet) (he : e ∈ p.dartSet) (hfst : d.fst = e.fst) :
    d = e := by
  rcases hd with ⟨n, hn, hdn⟩
  rcases he with ⟨m, hm, hem⟩
  have hn0 := active_mono (Nat.le_succ n) hn
  have hm0 := active_mono (Nat.le_succ m) hm
  have hvertex : p.vertex n = p.vertex m := by
    calc
      p.vertex n = d.fst := (congrArg Prod.fst hdn).symm
      _ = e.fst := hfst
      _ = p.vertex m := congrArg Prod.fst hem
  have hnm : n = m := p.injective hn0 hm0 hvertex
  subst m
  apply Dart.ext
  exact hdn.trans hem.symm

theorem dart_eq_of_snd_eq {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {d e : G.Dart}
    (hd : d ∈ p.dartSet) (he : e ∈ p.dartSet) (hsnd : d.snd = e.snd) :
    d = e := by
  rcases hd with ⟨n, hn, hdn⟩
  rcases he with ⟨m, hm, hem⟩
  have hvertex : p.vertex (n + 1) = p.vertex (m + 1) := by
    calc
      p.vertex (n + 1) = d.snd := (congrArg Prod.snd hdn).symm
      _ = e.snd := hsnd
      _ = p.vertex (m + 1) := congrArg Prod.snd hem
  have hnm : n + 1 = m + 1 := p.injective hn hm hvertex
  have hnm' : n = m := by omega
  subst m
  apply Dart.ext
  exact hdn.trans hem.symm

def IsFinite {V : Type} {G : SimpleGraph V} (p : LongPath G) : Prop :=
  ∃ n, p.terminalIndex = some n

def IsRay {V : Type} {G : SimpleGraph V} (p : LongPath G) : Prop :=
  p.terminalIndex = none

/-- `q` is a forward extension of `p`: every active position and vertex of
`p` is retained by `q`. -/
def Forward {V : Type} {G : SimpleGraph V} (p q : LongPath G) : Prop :=
  ∀ n, longPathActive p.terminalIndex n →
    longPathActive q.terminalIndex n ∧ q.vertex n = p.vertex n

theorem Forward.refl {V : Type} {G : SimpleGraph V} (p : LongPath G) :
    p.Forward p := by
  exact fun _ hn => ⟨hn, rfl⟩

theorem Forward.trans {V : Type} {G : SimpleGraph V} {p q r : LongPath G}
    (hpq : p.Forward q) (hqr : q.Forward r) : p.Forward r := by
  intro n hn
  rcases hpq n hn with ⟨hnq, heq⟩
  rcases hqr n hnq with ⟨hnr, heq'⟩
  exact ⟨hnr, heq'.trans heq⟩

theorem Forward.vertexSet_subset {V : Type} {G : SimpleGraph V}
    {p q : LongPath G} (hpq : p.Forward q) :
    p.vertexSet ⊆ q.vertexSet := by
  rintro v ⟨n, hn, hnv⟩
  have hq := hpq n hn
  exact ⟨n, hq.1, hq.2.trans hnv⟩

theorem dartSet_mono_forward {V : Type} {G : SimpleGraph V}
    {p q : LongPath G} (hpq : p.Forward q) :
    p.dartSet ⊆ q.dartSet := by
  rintro d ⟨n, hn, hd⟩
  have hn0 := hpq n (active_mono (Nat.le_succ n) hn)
  have hn1 := hpq (n + 1) hn
  refine ⟨n, hn1.1, ?_⟩
  calc
    d.1 = (p.vertex n, p.vertex (n + 1)) := hd
    _ = (q.vertex n, q.vertex (n + 1)) := by rw [hn0.2, hn1.2]

/-- A finite long path is normalized when all irrelevant values after its
terminal index repeat its initial vertex.  Rays are normalized vacuously. -/
def IsNormalized {V : Type} {G : SimpleGraph V} (p : LongPath G) : Prop :=
  ∀ n, ¬ longPathActive p.terminalIndex n → p.vertex n = p.vertex 0

/-- Canonical representative of a long path, changing only values outside
the active index set. -/
noncomputable def normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : LongPath G := by
  classical
  exact {
    terminalIndex := p.terminalIndex
    vertex := fun n => if longPathActive p.terminalIndex n then p.vertex n
      else p.vertex 0
    injective := by
      intro m hm n hn hmn
      change longPathActive p.terminalIndex m at hm
      change longPathActive p.terminalIndex n at hn
      apply p.injective hm hn
      change (if longPathActive p.terminalIndex m then p.vertex m else p.vertex 0) =
        (if longPathActive p.terminalIndex n then p.vertex n else p.vertex 0) at hmn
      rw [if_pos hm, if_pos hn] at hmn
      exact hmn
    adjacent := by
      intro n hn
      have hnPrev := active_mono (Nat.le_succ n) hn
      simp only [hn, hnPrev, ↓reduceIte]
      exact p.adjacent n hn }

@[simp] theorem terminalIndex_normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.normalize.terminalIndex = p.terminalIndex := rfl

theorem vertex_normalize_of_active {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n : ℕ} (hn : longPathActive p.terminalIndex n) :
    p.normalize.vertex n = p.vertex n := by
  classical
  change (if longPathActive p.terminalIndex n then p.vertex n else p.vertex 0) =
    p.vertex n
  rw [if_pos hn]

theorem isNormalized_normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.normalize.IsNormalized := by
  classical
  intro n hn
  have hn' : ¬ longPathActive p.terminalIndex n := by simpa using hn
  have hzero : longPathActive p.terminalIndex 0 := by
    cases p.terminalIndex <;> simp [longPathActive]
  rw [vertex_normalize_of_active p hzero]
  change (if longPathActive p.terminalIndex n then p.vertex n else p.vertex 0) =
    p.vertex 0
  rw [if_neg hn']

theorem forward_normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.Forward p.normalize := by
  intro n hn
  exact ⟨hn, vertex_normalize_of_active p hn⟩

theorem normalize_forward {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.normalize.Forward p := by
  intro n hn
  exact ⟨hn, (vertex_normalize_of_active p hn).symm⟩

@[simp] theorem vertexSet_normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.normalize.vertexSet = p.vertexSet := by
  ext v
  constructor
  · rintro ⟨n, hn, hnv⟩
    exact ⟨n, hn, (vertex_normalize_of_active p hn).symm.trans hnv⟩
  · rintro ⟨n, hn, hnv⟩
    exact ⟨n, hn, (vertex_normalize_of_active p hn).trans hnv⟩

@[simp] theorem initial_normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.normalize.initial = p.initial := by
  classical
  have hzero : longPathActive p.terminalIndex 0 := by
    cases p.terminalIndex <;> simp [longPathActive]
  change (if longPathActive p.terminalIndex 0 then p.vertex 0 else p.vertex 0) =
    p.vertex 0
  rw [if_pos hzero]

@[simp] theorem terminal?_normalize {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : p.normalize.terminal? = p.terminal? := by
  simp only [terminal?, terminalIndex_normalize]
  cases h : p.terminalIndex with
  | none => simp
  | some n =>
      simp only [Option.map_some]
      exact congrArg some
        (vertex_normalize_of_active p (n := n) (by simp [h, longPathActive]))

/-- On normalized paths, mutual forward extension is equality. -/
theorem eq_of_mutual_forward {V : Type} {G : SimpleGraph V}
    {p q : LongPath G} (hp : p.IsNormalized) (hq : q.IsNormalized)
    (hpq : p.Forward q) (hqp : q.Forward p) : p = q := by
  have hterminal : p.terminalIndex = q.terminalIndex := by
    cases hpidx : p.terminalIndex with
    | none =>
        cases hqidx : q.terminalIndex with
        | none => rfl
        | some k =>
            have hactive : longPathActive p.terminalIndex (k + 1) := by
              simp [hpidx, longPathActive]
            have := (hpq (k + 1) hactive).1
            simp [hqidx, longPathActive] at this
    | some k =>
        cases hqidx : q.terminalIndex with
        | none =>
            have hactive : longPathActive q.terminalIndex (k + 1) := by
              simp [hqidx, longPathActive]
            have := (hqp (k + 1) hactive).1
            simp [hpidx, longPathActive] at this
        | some l =>
            have hk : k ≤ l := by
              have hactive : longPathActive p.terminalIndex k := by
                simp [hpidx, longPathActive]
              simpa [hqidx, longPathActive] using (hpq k hactive).1
            have hl : l ≤ k := by
              have hactive : longPathActive q.terminalIndex l := by
                simp [hqidx, longPathActive]
              simpa [hpidx, longPathActive] using (hqp l hactive).1
            simp [hpidx, hqidx, le_antisymm hk hl]
  have hvertex : p.vertex = q.vertex := by
    funext n
    by_cases hn : longPathActive p.terminalIndex n
    · exact (hpq n hn).2.symm
    · have hnq : ¬ longPathActive q.terminalIndex n := by
        simpa [hterminal] using hn
      rw [hp n hn, hq n hnq]
      have hzero : longPathActive p.terminalIndex 0 := by
        cases p.terminalIndex <;> simp [longPathActive]
      exact (hpq 0 hzero).2.symm
  cases p
  cases q
  cases hterminal
  cases hvertex
  rfl

/-- Long paths with their irrelevant tail values fixed canonically. -/
def NormalizedPath {V : Type} (G : SimpleGraph V) :=
  {p : LongPath G // p.IsNormalized}

instance {V : Type} {G : SimpleGraph V} : LE (NormalizedPath G) :=
  ⟨fun p q => p.1.Forward q.1⟩

instance {V : Type} {G : SimpleGraph V} : PartialOrder (NormalizedPath G) where
  le_refl p := Forward.refl p.1
  le_trans _ _ _ hpq hqr := Forward.trans hpq hqr
  le_antisymm p q hpq hqp :=
    Subtype.ext (eq_of_mutual_forward p.2 q.2 hpq hqp)

/-- The canonical normalized representative, as an element of the path
extension partial order. -/
noncomputable def toNormalized {V : Type} {G : SimpleGraph V}
    (p : LongPath G) : NormalizedPath G :=
  ⟨p.normalize, p.isNormalized_normalize⟩

/-- Indices that occur in at least one member of a family of long paths. -/
def limitActiveSet {ι V : Type} {G : SimpleGraph V}
    (P : ι → LongPath G) : Set ℕ :=
  {n | ∃ i, longPathActive (P i).terminalIndex n}

theorem limitActiveSet_nonempty {ι V : Type} [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G) :
    (limitActiveSet P).Nonempty := by
  let i : ι := Classical.choice inferInstance
  refine ⟨0, i, ?_⟩
  cases h : (P i).terminalIndex <;> simp [longPathActive]

theorem limitActiveSet_lower {ι V : Type} {G : SimpleGraph V}
    (P : ι → LongPath G) {m n : ℕ} (hmn : m ≤ n)
    (hn : n ∈ limitActiveSet P) : m ∈ limitActiveSet P := by
  rcases hn with ⟨i, hi⟩
  exact ⟨i, active_mono hmn hi⟩

/-- Terminal index of the direct limit of a nonempty family of paths.  A
finite union of active initial segments has its largest active index; an
infinite lower set of naturals is all of `ℕ` and therefore yields a ray. -/
noncomputable def limitTerminalIndex {ι V : Type} [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G) : Option ℕ := by
  classical
  by_cases hfinite : (limitActiveSet P).Finite
  · exact some (hfinite.toFinset.max' (by
      simpa using limitActiveSet_nonempty P))
  · exact none

theorem active_limitTerminalIndex_iff {ι V : Type} [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G) (n : ℕ) :
    longPathActive (limitTerminalIndex P) n ↔ n ∈ limitActiveSet P := by
  classical
  unfold limitTerminalIndex
  split_ifs with hfinite
  · simp only [longPathActive]
    let s := hfinite.toFinset
    have hsne : s.Nonempty := by
      simpa [s] using limitActiveSet_nonempty P
    change n ≤ s.max' hsne ↔ n ∈ limitActiveSet P
    constructor
    · intro hn
      have hmax : s.max' hsne ∈ limitActiveSet P := by
        simpa [s] using s.max'_mem hsne
      exact limitActiveSet_lower P hn hmax
    · intro hn
      apply s.le_max'
      simpa [s] using hn
  · simp only [longPathActive, true_iff]
    by_contra hn
    have hsub : limitActiveSet P ⊆ Set.Iio n := by
      intro m hm
      have hnotle : ¬ n ≤ m := by
        intro hnm
        exact hn (limitActiveSet_lower P hnm hm)
      exact lt_of_not_ge hnotle
    have hIio : (Set.Iio n).Finite := by
      rw [show Set.Iio n = (Finset.range n : Set ℕ) by ext m; simp]
      exact Finset.finite_toSet _
    exact hfinite (hIio.subset hsub)

/-- The terminal index whose active positions are a prescribed nonempty
lower set of natural numbers.  A finite lower set has a greatest element;
an infinite one is all of `ℕ` and represents a ray. -/
noncomputable def lowerSetTerminalIndex (I : Set ℕ)
    (hne : I.Nonempty) : Option ℕ := by
  classical
  if hfinite : I.Finite then
    exact some (hfinite.toFinset.max' (by simpa using hne))
  else
    exact none

theorem active_lowerSetTerminalIndex_iff (I : Set ℕ)
    (hne : I.Nonempty)
    (hlower : ∀ {m n}, m ≤ n → n ∈ I → m ∈ I) (n : ℕ) :
    longPathActive (lowerSetTerminalIndex I hne) n ↔ n ∈ I := by
  classical
  unfold lowerSetTerminalIndex
  split_ifs with hfinite
  · simp only [longPathActive]
    let s := hfinite.toFinset
    have hsne : s.Nonempty := by simpa [s] using hne
    change n ≤ s.max' hsne ↔ n ∈ I
    constructor
    · intro hn
      have hmax : s.max' hsne ∈ I := by
        simpa [s] using s.max'_mem hsne
      exact hlower hn hmax
    · intro hn
      apply s.le_max'
      simpa [s] using hn
  · simp only [longPathActive, true_iff]
    by_contra hn
    have hsub : I ⊆ Set.Iio n := by
      intro m hm
      have hnotle : ¬ n ≤ m := by
        intro hnm
        exact hn (hlower hnm hm)
      exact lt_of_not_ge hnotle
    have hIio : (Set.Iio n).Finite := by
      rw [show Set.Iio n = (Finset.range n : Set ℕ) by ext m; simp]
      exact Finset.finite_toSet _
    exact hfinite (hIio.subset hsub)

/-- Restrict a long path to a nonempty lower set of its active positions. -/
noncomputable def restrictToLowerSet {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (I : Set ℕ) (hne : I.Nonempty)
    (hlower : ∀ {m n}, m ≤ n → n ∈ I → m ∈ I)
    (hsub : I ⊆ {n | longPathActive p.terminalIndex n}) : LongPath G where
  terminalIndex := lowerSetTerminalIndex I hne
  vertex := p.vertex
  injective := by
    intro m hm n hn hmn
    apply p.injective (hsub ((active_lowerSetTerminalIndex_iff
      I hne hlower m).mp hm))
      (hsub ((active_lowerSetTerminalIndex_iff I hne hlower n).mp hn)) hmn
  adjacent := by
    intro n hn
    apply p.adjacent n
    exact hsub ((active_lowerSetTerminalIndex_iff
      I hne hlower (n + 1)).mp hn)

@[simp] theorem active_restrictToLowerSet_iff {V : Type}
    {G : SimpleGraph V} (p : LongPath G) (I : Set ℕ)
    (hne : I.Nonempty)
    (hlower : ∀ {m n}, m ≤ n → n ∈ I → m ∈ I)
    (hsub : I ⊆ {n | longPathActive p.terminalIndex n}) (n : ℕ) :
    longPathActive (p.restrictToLowerSet I hne hlower hsub).terminalIndex n ↔
      n ∈ I :=
  active_lowerSetTerminalIndex_iff I hne hlower n

@[simp] theorem vertex_restrictToLowerSet {V : Type}
    {G : SimpleGraph V} (p : LongPath G) (I : Set ℕ)
    (hne : I.Nonempty)
    (hlower : ∀ {m n}, m ≤ n → n ∈ I → m ∈ I)
    (hsub : I ⊆ {n | longPathActive p.terminalIndex n}) (n : ℕ) :
    (p.restrictToLowerSet I hne hlower hsub).vertex n = p.vertex n := rfl

theorem restrictToLowerSet_forward {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (I : Set ℕ) (hne : I.Nonempty)
    (hlower : ∀ {m n}, m ≤ n → n ∈ I → m ∈ I)
    (hsub : I ⊆ {n | longPathActive p.terminalIndex n}) :
    (p.restrictToLowerSet I hne hlower hsub).Forward p := by
  intro n hn
  exact ⟨hsub ((active_restrictToLowerSet_iff
    p I hne hlower hsub n).mp hn), rfl⟩

noncomputable def limitVertex {ι V : Type} [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G) (n : ℕ) : V := by
  classical
  by_cases h : n ∈ limitActiveSet P
  · exact (P (Classical.choose h)).vertex n
  · exact (P (Classical.choice inferInstance)).vertex 0

theorem limitVertex_eq_of_active {ι V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j))
    {i : ι} {n : ℕ} (hi : longPathActive (P i).terminalIndex n) :
    limitVertex P n = (P i).vertex n := by
  classical
  have hmem : n ∈ limitActiveSet P := ⟨i, hi⟩
  unfold limitVertex
  rw [dif_pos hmem]
  let j := Classical.choose hmem
  have hj : longPathActive (P j).terminalIndex n := Classical.choose_spec hmem
  rcases le_total j i with hji | hij
  · exact (hchain hji n hj).2.symm
  · exact (hchain hij n hi).2

/-- Direct limit of a nonempty linearly ordered forward chain of long paths. -/
noncomputable def limit {ι V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j)) : LongPath G where
  terminalIndex := limitTerminalIndex P
  vertex := limitVertex P
  injective := by
    intro m hm n hn hmn
    have hmSet : m ∈ limitActiveSet P :=
      (active_limitTerminalIndex_iff P m).mp hm
    have hnSet : n ∈ limitActiveSet P :=
      (active_limitTerminalIndex_iff P n).mp hn
    rcases hmSet with ⟨i, hi⟩
    rcases hnSet with ⟨j, hj⟩
    let k := max i j
    have hik : i ≤ k := le_max_left i j
    have hjk : j ≤ k := le_max_right i j
    have hmK := (hchain hik m hi).1
    have hnK := (hchain hjk n hj).1
    apply (P k).injective hmK hnK
    rw [← limitVertex_eq_of_active P hchain hmK,
      ← limitVertex_eq_of_active P hchain hnK]
    exact hmn
  adjacent := by
    intro n hn
    have hnSet : n + 1 ∈ limitActiveSet P :=
      (active_limitTerminalIndex_iff P (n + 1)).mp hn
    rcases hnSet with ⟨i, hi⟩
    have hiPrev : longPathActive (P i).terminalIndex n :=
      active_mono (Nat.le_succ n) hi
    rw [limitVertex_eq_of_active P hchain hiPrev,
      limitVertex_eq_of_active P hchain hi]
    exact (P i).adjacent n hi

theorem forward_limit {ι V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j)) (i : ι) :
    (P i).Forward (limit P hchain) := by
  intro n hn
  constructor
  · exact (active_limitTerminalIndex_iff P n).mpr ⟨i, hn⟩
  · exact limitVertex_eq_of_active P hchain hn

theorem isNormalized_limit {ι V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j)) :
    (limit P hchain).IsNormalized := by
  classical
  intro n hn
  have hnSet : n ∉ limitActiveSet P := by
    intro hmem
    exact hn ((active_limitTerminalIndex_iff P n).mpr hmem)
  let i : ι := Classical.choice inferInstance
  have hi0 : longPathActive (P i).terminalIndex 0 := by
    cases (P i).terminalIndex <;> simp [longPathActive]
  have hnValue : limitVertex P n = (P i).vertex 0 := by
    unfold limitVertex
    rw [dif_neg hnSet]
  change limitVertex P n = limitVertex P 0
  rw [hnValue, limitVertex_eq_of_active P hchain hi0]

def shiftedTerminalIndex (o : Option ℕ) (k : ℕ) : Option ℕ :=
  o.map fun n => n - k

theorem active_shiftedTerminalIndex_iff {o : Option ℕ} {k n : ℕ}
    (hk : longPathActive o k) :
    longPathActive (shiftedTerminalIndex o k) n ↔
      longPathActive o (k + n) := by
  cases o with
  | none => simp [shiftedTerminalIndex, longPathActive]
  | some t =>
      simp only [longPathActive] at hk
      simp [shiftedTerminalIndex, longPathActive]
      omega

/-- The suffix of a long path starting at an active index. -/
def tail {V : Type} {G : SimpleGraph V} (p : LongPath G)
    (k : ℕ) (hk : longPathActive p.terminalIndex k) : LongPath G where
  terminalIndex := shiftedTerminalIndex p.terminalIndex k
  vertex := fun n => p.vertex (k + n)
  injective := by
    intro m hm n hn hmn
    have hm' : longPathActive p.terminalIndex (k + m) :=
      (active_shiftedTerminalIndex_iff hk).mp hm
    have hn' : longPathActive p.terminalIndex (k + n) :=
      (active_shiftedTerminalIndex_iff hk).mp hn
    have := p.injective hm' hn' hmn
    omega
  adjacent := by
    intro n hn
    have hn' : longPathActive p.terminalIndex (k + n + 1) := by
      have := (active_shiftedTerminalIndex_iff hk).mp hn
      simpa [Nat.add_assoc] using this
    exact p.adjacent (k + n) hn'

@[simp] theorem initial_tail {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (k : ℕ) (hk : longPathActive p.terminalIndex k) :
    (p.tail k hk).initial = p.vertex k := by
  simp [tail, initial]

@[simp] theorem terminal?_tail {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (k : ℕ) (hk : longPathActive p.terminalIndex k) :
    (p.tail k hk).terminal? = p.terminal? := by
  cases h : p.terminalIndex with
  | none => simp [tail, terminal?, shiftedTerminalIndex, h]
  | some t =>
      have hkt : k ≤ t := by simpa [longPathActive, h] using hk
      simp only [tail, terminal?, shiftedTerminalIndex, h, Option.map_some]
      congr 1
      congr 1
      omega

theorem vertexSet_tail_subset {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (k : ℕ) (hk : longPathActive p.terminalIndex k) :
    (p.tail k hk).vertexSet ⊆ p.vertexSet := by
  rintro v ⟨n, hn, hv⟩
  exact ⟨k + n, (active_shiftedTerminalIndex_iff hk).mp hn, hv⟩

@[simp] theorem vertexSet_tail_terminal {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (k : ℕ) (hk : p.terminalIndex = some k)
    (hkActive : longPathActive p.terminalIndex k) :
    (p.tail k hkActive).vertexSet = {p.vertex k} := by
  ext v
  constructor
  · rintro ⟨n, hn, hv⟩
    have hn0 : n = 0 := by
      simp only [tail, shiftedTerminalIndex, hk, Option.map_some, longPathActive,
        Nat.sub_self] at hn
      omega
    subst n
    simpa [tail] using hv.symm
  · intro hv
    have hv' : v = p.vertex k := Set.mem_singleton_iff.mp hv
    refine ⟨0, ?_, ?_⟩
    · simp [tail, shiftedTerminalIndex, hk, longPathActive]
    · simpa [tail] using hv'.symm

def appendedTerminalIndex (k : ℕ) (o : Option ℕ) : Option ℕ :=
  o.map fun n => k + n

def appendVertex {V : Type} {G : SimpleGraph V} (p q : LongPath G)
    (k n : ℕ) : V :=
  if n < k then p.vertex n else q.vertex (n - k)

theorem active_appendedTerminalIndex_of_lt {o : Option ℕ} {k n : ℕ}
    (hn : n < k) : longPathActive (appendedTerminalIndex k o) n := by
  cases o <;> simp [appendedTerminalIndex, longPathActive]
  omega

theorem active_sub_of_active_appendedTerminalIndex {o : Option ℕ} {k n : ℕ}
    (hkn : k ≤ n) (hn : longPathActive (appendedTerminalIndex k o) n) :
    longPathActive o (n - k) := by
  cases o with
  | none => trivial
  | some t =>
      simp only [appendedTerminalIndex, Option.map_some, longPathActive] at hn ⊢
      omega

theorem active_add_appendedTerminalIndex {o : Option ℕ} {k n : ℕ}
    (hn : longPathActive o n) :
    longPathActive (appendedTerminalIndex k o) (k + n) := by
  cases o with
  | none => trivial
  | some t =>
      simp only [longPathActive] at hn
      simp [appendedTerminalIndex, longPathActive]
      omega

/-- Concatenate a finite long path `p` with a finite path or ray `q`.
Their vertex sets are required to meet only at the common joining vertex. -/
def append {V : Type} {G : SimpleGraph V} (p q : LongPath G) (k : ℕ)
    (hpk : p.terminalIndex = some k)
    (hjoin : q.initial = p.vertex k)
    (hinter : p.vertexSet ∩ q.vertexSet ⊆ {p.vertex k}) : LongPath G where
  terminalIndex := appendedTerminalIndex k q.terminalIndex
  vertex := appendVertex p q k
  injective := by
    intro m hm n hn hmn
    by_cases hmk : m < k <;> by_cases hnk : n < k
    · simp only [appendVertex, if_pos hmk, if_pos hnk] at hmn
      apply p.injective
      · simpa [hpk, longPathActive] using hmk.le
      · simpa [hpk, longPathActive] using hnk.le
      · exact hmn
    · have hkn : k ≤ n := le_of_not_gt hnk
      simp only [appendVertex, if_pos hmk, if_neg hnk] at hmn
      have hmActive : longPathActive p.terminalIndex m := by
        simpa [hpk, longPathActive] using hmk.le
      have hnSubActive : longPathActive q.terminalIndex (n - k) :=
        active_sub_of_active_appendedTerminalIndex hkn hn
      have hmMem : p.vertex m ∈ p.vertexSet := ⟨m, hmActive, rfl⟩
      have hnMem : q.vertex (n - k) ∈ q.vertexSet := ⟨n - k, hnSubActive, rfl⟩
      have hmJoin : p.vertex m = p.vertex k :=
        Set.mem_singleton_iff.mp (hinter ⟨hmMem, hmn ▸ hnMem⟩)
      have hkActive : longPathActive p.terminalIndex k := by simp [hpk, longPathActive]
      have : m = k := p.injective hmActive hkActive hmJoin
      omega
    · have hkm : k ≤ m := le_of_not_gt hmk
      simp only [appendVertex, if_neg hmk, if_pos hnk] at hmn
      have hmSubActive : longPathActive q.terminalIndex (m - k) :=
        active_sub_of_active_appendedTerminalIndex hkm hm
      have hnActive : longPathActive p.terminalIndex n := by
        simpa [hpk, longPathActive] using hnk.le
      have hmMem : q.vertex (m - k) ∈ q.vertexSet := ⟨m - k, hmSubActive, rfl⟩
      have hnMem : p.vertex n ∈ p.vertexSet := ⟨n, hnActive, rfl⟩
      have hnJoin : p.vertex n = p.vertex k :=
        Set.mem_singleton_iff.mp (hinter ⟨hnMem, hmn.symm ▸ hmMem⟩)
      have hkActive : longPathActive p.terminalIndex k := by simp [hpk, longPathActive]
      have : n = k := p.injective hnActive hkActive hnJoin
      omega
    · have hkm : k ≤ m := le_of_not_gt hmk
      have hkn : k ≤ n := le_of_not_gt hnk
      simp only [appendVertex, if_neg hmk, if_neg hnk] at hmn
      have hmSubActive : longPathActive q.terminalIndex (m - k) :=
        active_sub_of_active_appendedTerminalIndex hkm hm
      have hnSubActive : longPathActive q.terminalIndex (n - k) :=
        active_sub_of_active_appendedTerminalIndex hkn hn
      have hsub : m - k = n - k := q.injective hmSubActive hnSubActive hmn
      omega
  adjacent := by
    intro n hn
    by_cases hnk : n < k
    · by_cases hsucc : n + 1 < k
      · simp only [appendVertex, if_pos hnk, if_pos hsucc]
        apply p.adjacent n
        simp [hpk, longPathActive]
        omega
      · have heq : n + 1 = k := by omega
        simp only [appendVertex, if_pos hnk, if_neg hsucc]
        have hadj := p.adjacent n (by simp [hpk, longPathActive, heq])
        have hq0 : q.vertex 0 = p.vertex k := hjoin
        simpa [heq, hq0] using hadj
    · have hkn : k ≤ n := le_of_not_gt hnk
      have hsuccNot : ¬ n + 1 < k := by omega
      simp only [appendVertex, if_neg hnk, if_neg hsuccNot]
      have heq : n + 1 - k = (n - k) + 1 := by omega
      have hactive : longPathActive q.terminalIndex ((n - k) + 1) := by
        have := active_sub_of_active_appendedTerminalIndex (by omega : k ≤ n + 1) hn
        simpa [heq] using this
      simpa [heq] using q.adjacent (n - k) hactive

theorem forward_append {V : Type} {G : SimpleGraph V}
    (p q : LongPath G) (k : ℕ) (hpk : p.terminalIndex = some k)
    (hjoin : q.initial = p.vertex k)
    (hinter : p.vertexSet ∩ q.vertexSet ⊆ {p.vertex k}) :
    p.Forward (p.append q k hpk hjoin hinter) := by
  intro n hn
  have hnk : n ≤ k := by simpa [hpk, longPathActive] using hn
  by_cases hlt : n < k
  · exact ⟨active_appendedTerminalIndex_of_lt hlt,
      by simp [append, appendVertex, hlt]⟩
  · have hne : ¬ k < k := lt_irrefl k
    have hnkEq : n = k := by omega
    subst n
    have hactive : longPathActive
        (appendedTerminalIndex k q.terminalIndex) k := by
      have := active_add_appendedTerminalIndex
        (o := q.terminalIndex) (k := k) (n := 0) (by
          cases q.terminalIndex <;> simp [longPathActive])
      simpa using this
    refine ⟨hactive, ?_⟩
    simp only [append, appendVertex, if_neg hne, Nat.sub_self]
    simpa [initial] using hjoin

@[simp] theorem initial_append {V : Type} {G : SimpleGraph V}
    (p q : LongPath G) (k : ℕ) (hpk : p.terminalIndex = some k)
    (hjoin : q.initial = p.vertex k)
    (hinter : p.vertexSet ∩ q.vertexSet ⊆ {p.vertex k}) :
    (p.append q k hpk hjoin hinter).initial = p.initial := by
  by_cases hk : 0 < k
  · simp [append, initial, appendVertex, hk]
  · have hk0 : k = 0 := by omega
    subst k
    simp [append, initial, appendVertex] at hjoin ⊢
    exact hjoin

@[simp] theorem terminal?_append {V : Type} {G : SimpleGraph V}
    (p q : LongPath G) (k : ℕ) (hpk : p.terminalIndex = some k)
    (hjoin : q.initial = p.vertex k)
    (hinter : p.vertexSet ∩ q.vertexSet ⊆ {p.vertex k}) :
    (p.append q k hpk hjoin hinter).terminal? = q.terminal? := by
  cases hq : q.terminalIndex with
  | none => simp [append, terminal?, appendedTerminalIndex, hq]
  | some t =>
      simp only [append, terminal?, appendedTerminalIndex, hq, Option.map_some]
      congr 1
      simp [appendVertex]

@[simp] theorem vertexSet_append {V : Type} {G : SimpleGraph V}
    (p q : LongPath G) (k : ℕ) (hpk : p.terminalIndex = some k)
    (hjoin : q.initial = p.vertex k)
    (hinter : p.vertexSet ∩ q.vertexSet ⊆ {p.vertex k}) :
    (p.append q k hpk hjoin hinter).vertexSet = p.vertexSet ∪ q.vertexSet := by
  ext v
  constructor
  · rintro ⟨n, hn, hv⟩
    by_cases hnk : n < k
    · exact Or.inl ⟨n, by simpa [hpk, longPathActive] using hnk.le,
        by simpa [append, appendVertex, hnk] using hv⟩
    · have hkn : k ≤ n := le_of_not_gt hnk
      exact Or.inr ⟨n - k, active_sub_of_active_appendedTerminalIndex hkn hn,
        by simpa [append, appendVertex, hnk] using hv⟩
  · intro hv
    rcases hv with hvp | hvq
    · rcases hvp with ⟨n, hn, hv⟩
      have hnk : n ≤ k := by simpa [hpk, longPathActive] using hn
      by_cases hlt : n < k
      · exact ⟨n, active_appendedTerminalIndex_of_lt hlt,
          by simpa [append, appendVertex, hlt] using hv⟩
      · have hne : ¬k < k := lt_irrefl k
        have hnkeq : n = k := by omega
        subst n
        have hactive : longPathActive
            (appendedTerminalIndex k q.terminalIndex) k := by
          have := active_add_appendedTerminalIndex
            (o := q.terminalIndex) (k := k) (n := 0) (by
              cases q.terminalIndex <;> simp [longPathActive])
          simpa using this
        refine ⟨k, hactive, ?_⟩
        simp only [append, appendVertex, if_neg hne, Nat.sub_self]
        rw [show q.vertex 0 = p.vertex k by simpa [initial] using hjoin]
        exact hv
    · rcases hvq with ⟨n, hn, hv⟩
      have hnot : ¬k + n < k := by omega
      exact ⟨k + n, active_add_appendedTerminalIndex hn,
        by simpa [append, appendVertex, hnot] using hv⟩

/-- The finite initial segment through an active index. -/
def prefixWalk {V : Type} {G : SimpleGraph V} (p : LongPath G) :
    ∀ n, longPathActive p.terminalIndex n → G.Walk p.initial (p.vertex n)
  | 0, _ => .nil
  | n + 1, hn =>
      (p.prefixWalk n (active_mono (Nat.le_succ n) hn)).concat (p.adjacent n hn)

theorem mem_support_prefixWalk_iff {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n : ℕ} (hn : longPathActive p.terminalIndex n) {v : V} :
    v ∈ (p.prefixWalk n hn).support ↔
      ∃ m ≤ n, p.vertex m = v := by
  induction n with
  | zero =>
      simp [prefixWalk, initial, eq_comm]
  | succ n ih =>
      simp only [prefixWalk, Walk.support_concat, List.mem_append,
        List.mem_singleton]
      constructor
      · intro hv
        rcases hv with hv | hv
        · rcases (ih (active_mono (Nat.le_succ n) hn)).mp hv with ⟨m, hm, hmv⟩
          exact ⟨m, hm.trans (Nat.le_succ n), hmv⟩
        · exact ⟨n + 1, le_rfl, hv.symm⟩
      · rintro ⟨m, hm, hmv⟩
        rcases Nat.lt_or_eq_of_le hm with hm | rfl
        · exact Or.inl ((ih (active_mono (Nat.le_succ n) hn)).mpr
            ⟨m, Nat.le_of_lt_succ hm, hmv⟩)
        · exact Or.inr hmv.symm

@[simp] theorem length_prefixWalk {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n : ℕ} (hn : longPathActive p.terminalIndex n) :
    (p.prefixWalk n hn).length = n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [prefixWalk, Walk.length_concat]
      rw [ih]

theorem getVert_prefixWalk_of_le {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n m : ℕ} (hn : longPathActive p.terminalIndex n)
    (hm : m ≤ n) :
    (p.prefixWalk n hn).getVert m = p.vertex m := by
  induction n generalizing m with
  | zero =>
      have hm0 : m = 0 := by omega
      subst m
      simp [prefixWalk, initial]
  | succ n ih =>
      rcases Nat.lt_or_eq_of_le hm with hmn | rfl
      · rw [prefixWalk, Walk.concat_eq_append, Walk.getVert_append']
        have hlen : m ≤ (p.prefixWalk n
            (active_mono (Nat.le_succ n) hn)).length := by
          rw [p.length_prefixWalk]
          omega
        rw [if_pos hlen]
        exact ih (active_mono (Nat.le_succ n) hn) (by omega)
      · simpa [p.length_prefixWalk hn] using
          (p.prefixWalk (n + 1) hn).getVert_length

theorem prefixWalk_isPath {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n : ℕ} (hn : longPathActive p.terminalIndex n) :
    (p.prefixWalk n hn).IsPath := by
  induction n with
  | zero => exact Walk.IsPath.nil
  | succ n ih =>
      apply (ih (active_mono (Nat.le_succ n) hn)).concat
      · intro hmem
        rcases (p.mem_support_prefixWalk_iff
          (active_mono (Nat.le_succ n) hn)).mp hmem with ⟨m, hm, hvertex⟩
        have hactiveM := active_mono (hm.trans (Nat.le_succ n)) hn
        have heq : m = n + 1 := p.injective hactiveM hn hvertex
        omega

/-- The finite segment of a long path from active position `n` through
active position `m`. -/
def segmentWalk {V : Type} {G : SimpleGraph V} (p : LongPath G)
    {n m : ℕ} (hm : longPathActive p.terminalIndex m) (hnm : n ≤ m) :
    G.Walk (p.vertex n) (p.vertex m) :=
  ((p.prefixWalk m hm).drop n).copy
    (p.getVert_prefixWalk_of_le hm hnm) rfl

@[simp] theorem length_segmentWalk {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n m : ℕ} (hm : longPathActive p.terminalIndex m)
    (hnm : n ≤ m) :
    (p.segmentWalk hm hnm).length = m - n := by
  simp [segmentWalk, Walk.drop_length]

theorem getVert_segmentWalk {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n m k : ℕ} (hm : longPathActive p.terminalIndex m)
    (hnm : n ≤ m) (hk : k ≤ m - n) :
    (p.segmentWalk hm hnm).getVert k = p.vertex (n + k) := by
  simp only [segmentWalk, Walk.getVert_copy, Walk.drop_getVert]
  apply p.getVert_prefixWalk_of_le hm
  omega

theorem segmentWalk_isPath {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n m : ℕ} (hm : longPathActive p.terminalIndex m)
    (hnm : n ≤ m) : (p.segmentWalk hm hnm).IsPath := by
  simpa [segmentWalk] using (p.prefixWalk_isPath hm).drop n

theorem mem_support_segmentWalk_iff {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n m : ℕ} (hm : longPathActive p.terminalIndex m)
    (hnm : n ≤ m) {v : V} :
    v ∈ (p.segmentWalk hm hnm).support ↔
      ∃ k, n ≤ k ∧ k ≤ m ∧ p.vertex k = v := by
  constructor
  · intro hv
    rcases Walk.mem_support_iff_exists_getVert.mp hv with ⟨j, hjv, hj⟩
    refine ⟨n + j, by omega, by
      rw [p.length_segmentWalk hm hnm] at hj
      omega, ?_⟩
    rw [← p.getVert_segmentWalk hm hnm (by
      rw [p.length_segmentWalk hm hnm] at hj
      exact hj)]
    exact hjv
  · rintro ⟨k, hnk, hkm, hkv⟩
    let j := k - n
    have hj : j ≤ (p.segmentWalk hm hnm).length := by
      rw [p.length_segmentWalk hm hnm]
      omega
    apply Walk.mem_support_iff_exists_getVert.mpr
    refine ⟨j, ?_, hj⟩
    rw [p.getVert_segmentWalk hm hnm (by
      rw [p.length_segmentWalk hm hnm] at hj
      exact hj)]
    simpa [j, Nat.add_sub_of_le hnk] using hkv

theorem reverse_segmentWalk_getVert {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {n m k : ℕ} (hm : longPathActive p.terminalIndex m)
    (hnm : n ≤ m) (hk : k ≤ m - n) :
    (p.segmentWalk hm hnm).reverse.getVert k = p.vertex (m - k) := by
  rw [Walk.getVert_reverse, p.length_segmentWalk hm hnm,
    p.getVert_segmentWalk hm hnm]
  · congr
    omega
  · omega

theorem initial_mem_vertexSet {V : Type} {G : SimpleGraph V} (p : LongPath G) :
    p.initial ∈ p.vertexSet := by
  refine ⟨0, ?_, rfl⟩
  cases p.terminalIndex <;> simp [longPathActive]

theorem terminal_mem_vertexSet {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {v : V} (hv : p.terminal? = some v) :
    v ∈ p.vertexSet := by
  cases h : p.terminalIndex with
  | none => simp [terminal?, h] at hv
  | some n =>
      simp only [terminal?, h, Option.map_some, Option.some.injEq] at hv
      exact ⟨n, by simp [longPathActive, h], hv⟩

theorem terminal?_eq_some_iff {V : Type} {G : SimpleGraph V}
    {p : LongPath G} {v : V} :
    p.terminal? = some v ↔
      ∃ k, p.terminalIndex = some k ∧ p.vertex k = v := by
  cases h : p.terminalIndex with
  | none => simp [terminal?, h]
  | some k => simp [terminal?, h]

/-- A forward prefix of a finite path is finite. -/
theorem Forward.exists_terminal_of_terminal {V : Type} {G : SimpleGraph V}
    {p q : LongPath G} (hpq : p.Forward q) {t : V}
    (hqt : q.terminal? = some t) :
    ∃ x, p.terminal? = some x := by
  rcases terminal?_eq_some_iff.mp hqt with ⟨l, hql, hlt⟩
  cases hp : p.terminalIndex with
  | none =>
      have hpActive : longPathActive p.terminalIndex (l + 1) := by
        simp [hp, longPathActive]
      have hqActive := (hpq (l + 1) hpActive).1
      simp [hql, longPathActive] at hqActive
  | some k =>
      exact ⟨p.vertex k, by simp [terminal?, hp]⟩

/-- If a prefix contains the terminal vertex of the path it extends, that
vertex is already the terminal of the prefix. -/
theorem Forward.terminal_of_mem_of_terminal {V : Type}
    {G : SimpleGraph V} {p q : LongPath G} (hpq : p.Forward q)
    {t : V} (hqt : q.terminal? = some t) (htp : t ∈ p.vertexSet) :
    p.terminal? = some t := by
  rcases terminal?_eq_some_iff.mp hqt with ⟨k, hkq, hkt⟩
  rcases htp with ⟨n, hnp, hnt⟩
  have hnq := hpq n hnp
  have hkActive : longPathActive q.terminalIndex k := by
    simp [hkq, longPathActive]
  have hnk : n = k :=
    q.injective hnq.1 hkActive (hnq.2.trans (hnt.trans hkt.symm))
  subst n
  cases hp : p.terminalIndex with
  | none =>
      have hnextP : longPathActive p.terminalIndex (k + 1) := by
        simp [hp, longPathActive]
      have hnextQ := (hpq (k + 1) hnextP).1
      simp [hkq, longPathActive] at hnextQ
  | some l =>
      have hkl : k ≤ l := by simpa [hp, longPathActive] using hnp
      have hlk : l ≤ k := by
        by_contra hlk
        have hnextP : longPathActive p.terminalIndex (k + 1) := by
          simpa [hp, longPathActive] using (show k + 1 ≤ l by omega)
        have hnextQ := (hpq (k + 1) hnextP).1
        simpa [hkq, longPathActive] using hnextQ
      have hl : l = k := le_antisymm hlk hkl
      simp [terminal?, hp, hl, hnt, hkt]

/-- A vertex that is eventually always the terminal of a forward chain is
the terminal of its direct limit (Observation 2.9 at path level). -/
theorem terminal?_limit_of_eventually {ι V : Type} [LinearOrder ι]
    [Nonempty ι] {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j))
    {v : V} (h : ∃ i, ∀ j, i ≤ j → (P j).terminal? = some v) :
    (limit P hchain).terminal? = some v := by
  classical
  rcases h with ⟨i₀, hi₀⟩
  have hiTerm := hi₀ i₀ le_rfl
  rcases terminal?_eq_some_iff.mp hiTerm with ⟨k, hkFinite, hkv⟩
  have hkActive : longPathActive (P i₀).terminalIndex k := by
    simp [hkFinite, longPathActive]
  have hlimitActive : longPathActive (limitTerminalIndex P) k :=
    (active_limitTerminalIndex_iff P k).mpr ⟨i₀, hkActive⟩
  have hnextNot : ¬ longPathActive (limitTerminalIndex P) (k + 1) := by
    intro hnext
    rcases (active_limitTerminalIndex_iff P (k + 1)).mp hnext with ⟨j, hj⟩
    let m := max i₀ j
    have hi₀m : i₀ ≤ m := le_max_left i₀ j
    have hjm : j ≤ m := le_max_right i₀ j
    have hkM := (hchain hi₀m k hkActive).1
    have hnextM := (hchain hjm (k + 1) hj).1
    have hmTerm := hi₀ m hi₀m
    rcases terminal?_eq_some_iff.mp hmTerm with ⟨l, hlFinite, hlv⟩
    have hlActive : longPathActive (P m).terminalIndex l := by
      simp [hlFinite, longPathActive]
    have hvertexK : (P m).vertex k = v :=
      (hchain hi₀m k hkActive).2.trans hkv
    have hkl : k = l := (P m).injective hkM hlActive (hvertexK.trans hlv.symm)
    have : k + 1 ≤ l := by simpa [hlFinite, longPathActive] using hnextM
    omega
  have hterminalIndex : limitTerminalIndex P = some k := by
    cases ht : limitTerminalIndex P with
    | none =>
        exact (hnextNot (by simp [ht, longPathActive])).elim
    | some t =>
        have hkt : k ≤ t := by simpa [ht, longPathActive] using hlimitActive
        have hnot : ¬ k + 1 ≤ t := by
          intro hle
          exact hnextNot (by simpa [ht, longPathActive] using hle)
        have htk : t ≤ k := by omega
        simpa [le_antisymm htk hkt]
  apply terminal?_eq_some_iff.mpr
  refine ⟨k, hterminalIndex, ?_⟩
  exact (limitVertex_eq_of_active P hchain hkActive).trans hkv

theorem vertexSet_eq_support_prefixWalk {V : Type} {G : SimpleGraph V}
    (p : LongPath G) {k : ℕ} (hk : p.terminalIndex = some k)
    (hkActive : longPathActive p.terminalIndex k) :
    p.vertexSet = {v | v ∈ (p.prefixWalk k hkActive).support} := by
  ext v
  rw [Set.mem_ofPred_eq, p.mem_support_prefixWalk_iff hkActive]
  constructor
  · rintro ⟨n, hn, hnv⟩
    exact ⟨n, by simpa [hk, longPathActive] using hn, hnv⟩
  · rintro ⟨n, hnk, hnv⟩
    exact ⟨n, by simpa [hk, longPathActive], hnv⟩

/-- A Mathlib finite simple walk is a finite `LongPath`. -/
def ofWalk {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (hp : p.IsPath) : LongPath G where
  terminalIndex := some p.length
  vertex := p.getVert
  injective := by
    simpa [longPathActive] using hp.getVert_injOn
  adjacent := by
    intro n hn
    apply p.adj_getVert_succ
    simpa [longPathActive] using hn

@[simp] theorem initial_ofWalk {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (hp : p.IsPath) :
    (ofWalk p hp).initial = a := by
  simp [ofWalk, initial]

@[simp] theorem terminal?_ofWalk {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (hp : p.IsPath) :
    (ofWalk p hp).terminal? = some b := by
  simp [ofWalk, terminal?, p.getVert_length]

@[simp] theorem vertexSet_ofWalk {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (hp : p.IsPath) :
    (ofWalk p hp).vertexSet = {v | v ∈ p.support} := by
  ext v
  constructor
  · rintro ⟨n, hn, rfl⟩
    simp only [ofWalk, longPathActive, Set.mem_ofPred_eq] at hn ⊢
    exact p.getVert_mem_support n
  · intro hv
    simp only [Set.mem_ofPred_eq] at hv
    rcases Walk.mem_support_iff_exists_getVert.mp hv with ⟨n, hvn, hn⟩
    exact ⟨n, by simpa [longPathActive], hvn⟩

/-- Regard a long path in a spanning subgraph as a path in the ambient
graph. -/
def mapLE {V : Type} {G H : SimpleGraph V} (hGH : G ≤ H)
    (p : LongPath G) : LongPath H where
  terminalIndex := p.terminalIndex
  vertex := p.vertex
  injective := p.injective
  adjacent n hn := hGH (p.adjacent n hn)

/-- Reinterpret a finite path or ray whose vertices avoid `X` as a long path
in the spanning graph obtained by isolating `X`. -/
def toOutsideGraph {V : Type} {G : SimpleGraph V} {X : Set V}
    (p : LongPath G) (houtside : ∀ v ∈ p.vertexSet, v ∉ X) :
    LongPath (outsideGraph G X) where
  terminalIndex := p.terminalIndex
  vertex := p.vertex
  injective := p.injective
  adjacent n hn := by
    refine ⟨p.adjacent n hn, houtside _ ?_, houtside _ ?_⟩
    · exact ⟨n, active_mono (Nat.le_succ n) hn, rfl⟩
    · exact ⟨n + 1, hn, rfl⟩

@[simp] theorem initial_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (p : LongPath G) (houtside : ∀ v ∈ p.vertexSet, v ∉ X) :
    (p.toOutsideGraph houtside).initial = p.initial := rfl

@[simp] theorem terminal?_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (p : LongPath G) (houtside : ∀ v ∈ p.vertexSet, v ∉ X) :
    (p.toOutsideGraph houtside).terminal? = p.terminal? := rfl

@[simp] theorem vertexSet_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (p : LongPath G) (houtside : ∀ v ∈ p.vertexSet, v ∉ X) :
    (p.toOutsideGraph houtside).vertexSet = p.vertexSet := rfl

@[simp] theorem mapLE_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (p : LongPath G) (houtside : ∀ v ∈ p.vertexSet, v ∉ X) :
    (p.toOutsideGraph houtside).mapLE (outsideGraph_le G X) = p := by
  cases p
  rfl

@[simp] theorem initial_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (p : LongPath G) :
    (p.mapLE hGH).initial = p.initial := rfl

@[simp] theorem terminal?_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (p : LongPath G) :
    (p.mapLE hGH).terminal? = p.terminal? := rfl

@[simp] theorem vertexSet_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (p : LongPath G) :
    (p.mapLE hGH).vertexSet = p.vertexSet := rfl

theorem vertex_not_mem_of_outsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (p : LongPath (outsideGraph G X))
    (hinitial : p.initial ∉ X) {v : V} (hv : v ∈ p.vertexSet) : v ∉ X := by
  rcases hv with ⟨n, hn, rfl⟩
  cases n with
  | zero => simpa [initial] using hinitial
  | succ n =>
      exact (p.adjacent n hn).2.2

end LongPath

/-- A warp in the sense needed by the infinitary proof: a pairwise
vertex-disjoint family of finite paths and rays. -/
structure Warp {V : Type} (G : SimpleGraph V) where
  ι : Type
  path : ι → LongPath G
  disjoint : Pairwise fun i j => Disjoint (path i).vertexSet (path j).vertexSet

namespace Warp

/-- Regard a warp in a spanning subgraph as a warp in the ambient graph. -/
def mapLE {V : Type} {G H : SimpleGraph V} (hGH : G ≤ H)
    (W : Warp G) : Warp H where
  ι := W.ι
  path i := (W.path i).mapLE hGH
  disjoint := by simpa using W.disjoint

/-- A warp assembled from an already-indexed disjoint path family. -/
def ofPaths {κ V : Type} {G : SimpleGraph V} (P : κ → LongPath G)
    (hdisjoint : Pairwise fun a b =>
      Disjoint (P a).vertexSet (P b).vertexSet) : Warp G where
  ι := κ
  path := P
  disjoint := hdisjoint

/-- Direct limit of a linearly ordered, pointwise-forward family of warps
with a fixed path index type. -/
noncomputable def limitOfPaths {ι κ V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → κ → LongPath G)
    (hchain : ∀ a ⦃i j⦄, i ≤ j → (P i a).Forward (P j a))
    (hdisjoint : ∀ i, Pairwise fun a b =>
      Disjoint (P i a).vertexSet (P i b).vertexSet) : Warp G where
  ι := κ
  path := fun a => LongPath.limit (fun i => P i a) (hchain a)
  disjoint := by
    intro a b hab
    rw [Set.disjoint_left]
    intro v hva hvb
    rcases hva with ⟨m, hm, hmv⟩
    rcases hvb with ⟨n, hn, hnv⟩
    have hmSet : m ∈ LongPath.limitActiveSet (fun i => P i a) :=
      (LongPath.active_limitTerminalIndex_iff (fun i => P i a) m).mp hm
    have hnSet : n ∈ LongPath.limitActiveSet (fun i => P i b) :=
      (LongPath.active_limitTerminalIndex_iff (fun i => P i b) n).mp hn
    rcases hmSet with ⟨i, hmi⟩
    rcases hnSet with ⟨j, hnj⟩
    let k := max i j
    have hik : i ≤ k := le_max_left i j
    have hjk : j ≤ k := le_max_right i j
    have hmk := (hchain a hik m hmi).1
    have hnk := (hchain b hjk n hnj).1
    have hvaK : v ∈ (P k a).vertexSet := by
      refine ⟨m, hmk, ?_⟩
      rw [← LongPath.limitVertex_eq_of_active (fun i => P i a) (hchain a) hmk]
      exact hmv
    have hvbK : v ∈ (P k b).vertexSet := by
      refine ⟨n, hnk, ?_⟩
      rw [← LongPath.limitVertex_eq_of_active (fun i => P i b) (hchain b) hnk]
      exact hnv
    exact Set.disjoint_left.mp (hdisjoint k hab) hvaK hvbK

theorem path_forward_limitOfPaths {ι κ V : Type} [LinearOrder ι]
    [Nonempty ι] {G : SimpleGraph V} (P : ι → κ → LongPath G)
    (hchain : ∀ a ⦃i j⦄, i ≤ j → (P i a).Forward (P j a))
    (hdisjoint : ∀ i, Pairwise fun a b =>
      Disjoint (P i a).vertexSet (P i b).vertexSet)
    (i : ι) (a : κ) :
    (P i a).Forward ((limitOfPaths P hchain hdisjoint).path a) := by
  exact LongPath.forward_limit (fun j => P j a) (hchain a) i

theorem stage_vertexSet_subset_limitOfPaths {ι κ V : Type} [LinearOrder ι]
    [Nonempty ι] {G : SimpleGraph V} (P : ι → κ → LongPath G)
    (hchain : ∀ a ⦃i j⦄, i ≤ j → (P i a).Forward (P j a))
    (hdisjoint : ∀ i, Pairwise fun a b =>
      Disjoint (P i a).vertexSet (P i b).vertexSet)
    (i : ι) :
    {v | ∃ a, v ∈ (P i a).vertexSet} ⊆
      {v | ∃ a, v ∈ ((limitOfPaths P hchain hdisjoint).path a).vertexSet} := by
  rintro v ⟨a, n, hn, hnv⟩
  have hf := path_forward_limitOfPaths P hchain hdisjoint i a n hn
  exact ⟨a, n, hf.1, hf.2.trans hnv⟩

def vertexSet {V : Type} {G : SimpleGraph V} (W : Warp G) : Set V :=
  {v | ∃ i, v ∈ (W.path i).vertexSet}

/-- The oriented dart set of all components of a warp. -/
def dartSet {V : Type} {G : SimpleGraph V} (W : Warp G) : Set G.Dart :=
  {d | ∃ i, d ∈ (W.path i).dartSet}

/-- The underlying unoriented edges of a warp. -/
def edgeSet {V : Type} {G : SimpleGraph V} (W : Warp G) : Set (Sym2 V) :=
  Dart.edge '' W.dartSet

theorem mem_edgeSet_iff {V : Type} {G : SimpleGraph V}
    {W : Warp G} {e : Sym2 V} :
    e ∈ W.edgeSet ↔ ∃ d ∈ W.dartSet, d.edge = e := by
  rfl

theorem fst_mem_vertexSet_of_mem_dartSet {V : Type} {G : SimpleGraph V}
    {W : Warp G} {d : G.Dart} (hd : d ∈ W.dartSet) :
    d.fst ∈ W.vertexSet := by
  rcases hd with ⟨i, hi⟩
  exact ⟨i, LongPath.fst_mem_vertexSet_of_mem_dartSet hi⟩

theorem snd_mem_vertexSet_of_mem_dartSet {V : Type} {G : SimpleGraph V}
    {W : Warp G} {d : G.Dart} (hd : d ∈ W.dartSet) :
    d.snd ∈ W.vertexSet := by
  rcases hd with ⟨i, hi⟩
  exact ⟨i, LongPath.snd_mem_vertexSet_of_mem_dartSet hi⟩

/-- A warp consistently orients every one of its edges. -/
theorem symm_not_mem_dartSet {V : Type} {G : SimpleGraph V}
    {W : Warp G} {d : G.Dart} (hd : d ∈ W.dartSet) :
    d.symm ∉ W.dartSet := by
  rintro ⟨j, hj⟩
  rcases hd with ⟨i, hi⟩
  by_cases hij : i = j
  · subst j
    exact LongPath.symm_not_mem_dartSet hi hj
  · have hdSndI : d.snd ∈ (W.path i).vertexSet :=
      LongPath.snd_mem_vertexSet_of_mem_dartSet hi
    have hdSndJ : d.snd ∈ (W.path j).vertexSet := by
      have := LongPath.fst_mem_vertexSet_of_mem_dartSet hj
      simpa using this
    exact Set.disjoint_left.mp (W.disjoint hij) hdSndI hdSndJ

theorem dart_eq_of_fst_eq {V : Type} {G : SimpleGraph V}
    {W : Warp G} {d e : G.Dart} (hd : d ∈ W.dartSet)
    (he : e ∈ W.dartSet) (hfst : d.fst = e.fst) : d = e := by
  rcases hd with ⟨i, hi⟩
  rcases he with ⟨j, hj⟩
  by_cases hij : i = j
  · subst j
    exact LongPath.dart_eq_of_fst_eq hi hj hfst
  · have hdFstI : d.fst ∈ (W.path i).vertexSet :=
      LongPath.fst_mem_vertexSet_of_mem_dartSet hi
    have hdFstJ : d.fst ∈ (W.path j).vertexSet := by
      have := LongPath.fst_mem_vertexSet_of_mem_dartSet hj
      simpa [hfst] using this
    exact (Set.disjoint_left.mp (W.disjoint hij) hdFstI hdFstJ).elim

theorem dart_eq_of_snd_eq {V : Type} {G : SimpleGraph V}
    {W : Warp G} {d e : G.Dart} (hd : d ∈ W.dartSet)
    (he : e ∈ W.dartSet) (hsnd : d.snd = e.snd) : d = e := by
  rcases hd with ⟨i, hi⟩
  rcases he with ⟨j, hj⟩
  by_cases hij : i = j
  · subst j
    exact LongPath.dart_eq_of_snd_eq hi hj hsnd
  · have hdSndI : d.snd ∈ (W.path i).vertexSet :=
      LongPath.snd_mem_vertexSet_of_mem_dartSet hi
    have hdSndJ : d.snd ∈ (W.path j).vertexSet := by
      have := LongPath.snd_mem_vertexSet_of_mem_dartSet hj
      simpa [hsnd] using this
    exact (Set.disjoint_left.mp (W.disjoint hij) hdSndI hdSndJ).elim

/-- The natural-number position of an oriented dart on its member of a
warp.  The value outside the dart set is irrelevant. -/
noncomputable def dartDepth {V : Type} {G : SimpleGraph V}
    (W : Warp G) (d : G.Dart) : ℕ := by
  classical
  exact if hd : ∃ n, ∃ i,
      longPathActive (W.path i).terminalIndex (n + 1) ∧
        d.toProd = ((W.path i).vertex n, (W.path i).vertex (n + 1))
    then Nat.find hd
  else 0

theorem dartDepth_eq_of_mem {V : Type} {G : SimpleGraph V}
    {W : Warp G} {d : G.Dart} {i : W.ι} {n : ℕ}
    (hn : longPathActive (W.path i).terminalIndex (n + 1))
    (hdn : d.toProd = ((W.path i).vertex n, (W.path i).vertex (n + 1))) :
    W.dartDepth d = n := by
  classical
  have hd : ∃ m, ∃ j,
      longPathActive (W.path j).terminalIndex (m + 1) ∧
        d.toProd = ((W.path j).vertex m, (W.path j).vertex (m + 1)) :=
    ⟨n, i, hn, hdn⟩
  let m : ℕ := Nat.find hd
  rcases Nat.find_spec hd with ⟨j, hm, hdm⟩
  have hij : i = j := by
    by_contra hne
    have hdI : d.fst ∈ (W.path i).vertexSet :=
      LongPath.fst_mem_vertexSet_of_mem_dartSet ⟨n, hn, hdn⟩
    have hdJ : d.fst ∈ (W.path j).vertexSet :=
      LongPath.fst_mem_vertexSet_of_mem_dartSet ⟨m, hm, hdm⟩
    exact Set.disjoint_left.mp (W.disjoint hne) hdI hdJ
  subst j
  have hnActive := LongPath.active_mono (Nat.le_succ n) hn
  have hmActive0 := LongPath.active_mono (Nat.le_succ m) hm
  have hvertex : (W.path i).vertex n = (W.path i).vertex m := by
    calc
      (W.path i).vertex n = d.fst := (congrArg Prod.fst hdn).symm
      _ = (W.path i).vertex m := congrArg Prod.fst hdm
  have hnm : n = m := (W.path i).injective hnActive hmActive0 hvertex
  simp [dartDepth, hd, m, hnm]

/-- Along two consecutive original warp darts the depth strictly
increases.  Equivalently, following original darts backwards strictly
decreases a natural-number rank. -/
theorem dartDepth_lt_of_snd_eq_fst {V : Type} {G : SimpleGraph V}
    {W : Warp G} {e d : G.Dart} (he : e ∈ W.dartSet)
    (hd : d ∈ W.dartSet) (hjoin : e.snd = d.fst) :
    W.dartDepth e < W.dartDepth d := by
  rcases he with ⟨i, n, hn, hen⟩
  rcases hd with ⟨j, m, hm, hdm⟩
  have hvertex : (W.path i).vertex (n + 1) = (W.path j).vertex m := by
    calc
      (W.path i).vertex (n + 1) = e.snd :=
        (congrArg Prod.snd hen).symm
      _ = d.fst := hjoin
      _ = (W.path j).vertex m := congrArg Prod.fst hdm
  have hij : i = j := by
    by_contra hne
    have heSnd : e.snd ∈ (W.path i).vertexSet :=
      LongPath.snd_mem_vertexSet_of_mem_dartSet ⟨n, hn, hen⟩
    have heSndJ : e.snd ∈ (W.path j).vertexSet := by
      have := LongPath.fst_mem_vertexSet_of_mem_dartSet
        (show d ∈ (W.path j).dartSet from ⟨m, hm, hdm⟩)
      simpa [hjoin] using this
    exact Set.disjoint_left.mp (W.disjoint hne) heSnd heSndJ
  subst j
  have hm0 := LongPath.active_mono (Nat.le_succ m) hm
  have hsuccEq : n + 1 = m :=
    (W.path i).injective hn hm0 hvertex
  rw [W.dartDepth_eq_of_mem hn hen, W.dartDepth_eq_of_mem hm hdm]
  omega

def initialSet {V : Type} {G : SimpleGraph V} (W : Warp G) : Set V :=
  Set.range fun i => (W.path i).initial

/-- Only finite members contribute a terminal vertex, as in the paper. -/
def terminalSet {V : Type} {G : SimpleGraph V} (W : Warp G) : Set V :=
  {v | ∃ i, (W.path i).terminal? = some v}

theorem no_dart_from_terminal {V : Type} {G : SimpleGraph V}
    {W : Warp G} {t : V} (ht : t ∈ W.terminalSet)
    {d : G.Dart} (hd : d ∈ W.dartSet) (hdt : d.fst = t) : False := by
  rcases ht with ⟨i, hit⟩
  rcases LongPath.terminal?_eq_some_iff.mp hit with
    ⟨k, hkFinite, hkt⟩
  rcases hd with ⟨j, n, hn, hdn⟩
  by_cases hij : i = j
  · subst j
    have hn0 := LongPath.active_mono (Nat.le_succ n) hn
    have hvertex : (W.path i).vertex n = (W.path i).vertex k := by
      calc
        (W.path i).vertex n = d.fst := (congrArg Prod.fst hdn).symm
        _ = t := hdt
        _ = (W.path i).vertex k := hkt.symm
    have hkActive : longPathActive (W.path i).terminalIndex k := by
      simp [hkFinite, longPathActive]
    have hnk : n = k := (W.path i).injective hn0 hkActive hvertex
    have : n + 1 ≤ k := by
      simpa [hkFinite, longPathActive] using hn
    omega
  · have htI : t ∈ (W.path i).vertexSet :=
      LongPath.terminal_mem_vertexSet hit
    have htJ : t ∈ (W.path j).vertexSet := by
      have hdFst := LongPath.fst_mem_vertexSet_of_mem_dartSet
        (show d ∈ (W.path j).dartSet from ⟨n, hn, hdn⟩)
      simpa [hdt] using hdFst
    exact Set.disjoint_left.mp (W.disjoint (Ne.symm hij)) htJ htI

theorem no_dart_to_initial {V : Type} {G : SimpleGraph V}
    {W : Warp G} {a : V} (ha : a ∈ W.initialSet)
    {d : G.Dart} (hd : d ∈ W.dartSet) (hda : d.snd = a) : False := by
  rcases ha with ⟨i, rfl⟩
  rcases hd with ⟨j, n, hn, hdn⟩
  by_cases hij : i = j
  · subst j
    have hvertex : (W.path i).vertex (n + 1) =
        (W.path i).vertex 0 := by
      calc
        (W.path i).vertex (n + 1) = d.snd :=
          (congrArg Prod.snd hdn).symm
        _ = (W.path i).initial := hda
        _ = (W.path i).vertex 0 := rfl
    have hzero : longPathActive (W.path i).terminalIndex 0 :=
      by cases (W.path i).terminalIndex <;> simp [longPathActive]
    have : n + 1 = 0 := (W.path i).injective hn hzero hvertex
    omega
  · have haI : (W.path i).initial ∈ (W.path i).vertexSet :=
      (W.path i).initial_mem_vertexSet
    have haJ : (W.path i).initial ∈ (W.path j).vertexSet := by
      have hdSnd := LongPath.snd_mem_vertexSet_of_mem_dartSet
        (show d ∈ (W.path j).dartSet from ⟨n, hn, hdn⟩)
      simpa [hda] using hdSnd
    exact Set.disjoint_left.mp (W.disjoint (Ne.symm hij)) haJ haI

theorem exists_dart_from_of_mem_vertexSet_not_terminal {V : Type}
    {G : SimpleGraph V} {W : Warp G} {x : V} (hx : x ∈ W.vertexSet)
    (hxTerminal : x ∉ W.terminalSet) :
    ∃ d ∈ W.dartSet, d.fst = x := by
  rcases hx with ⟨i, n, hn, hnx⟩
  have hsucc : longPathActive (W.path i).terminalIndex (n + 1) := by
    cases hidx : (W.path i).terminalIndex with
    | none => simp [longPathActive]
    | some k =>
        simp only [hidx, longPathActive] at hn ⊢
        have hne : n ≠ k := by
          intro hnk
          apply hxTerminal
          refine ⟨i, ?_⟩
          rw [LongPath.terminal?_eq_some_iff]
          exact ⟨k, hidx, by simpa [hnk] using hnx⟩
        omega
  let d : G.Dart :=
    ⟨((W.path i).vertex n, (W.path i).vertex (n + 1)),
      (W.path i).adjacent n hsucc⟩
  refine ⟨d, ⟨i, n, hsucc, rfl⟩, ?_⟩
  exact hnx

theorem exists_dart_to_of_mem_vertexSet_not_initial {V : Type}
    {G : SimpleGraph V} {W : Warp G} {x : V} (hx : x ∈ W.vertexSet)
    (hxInitial : x ∉ W.initialSet) :
    ∃ d ∈ W.dartSet, d.snd = x := by
  rcases hx with ⟨i, n, hn, hnx⟩
  have hn0 : n ≠ 0 := by
    intro hzero
    apply hxInitial
    refine ⟨i, ?_⟩
    change (W.path i).vertex 0 = x
    simpa [hzero] using hnx
  have hpredActive : longPathActive (W.path i).terminalIndex ((n - 1) + 1) := by
    have hidx : n - 1 + 1 = n := by omega
    simpa [hidx] using hn
  have hidx : n - 1 + 1 = n := by omega
  let d : G.Dart :=
    ⟨((W.path i).vertex (n - 1), (W.path i).vertex n), by
      simpa [hidx] using (W.path i).adjacent (n - 1) hpredActive⟩
  refine ⟨d, ⟨i, n - 1, hpredActive, ?_⟩, ?_⟩
  · simp [d, hidx]
  · exact hnx

/-- Distinct paths of a warp have distinct initial vertices. -/
theorem initial_injective {V : Type} {G : SimpleGraph V} (W : Warp G) :
    Function.Injective (fun i => (W.path i).initial) := by
  intro i j hij
  by_contra hne
  have hi : (W.path i).initial ∈ (W.path i).vertexSet :=
    (W.path i).initial_mem_vertexSet
  have hj : (W.path i).initial ∈ (W.path j).vertexSet := by
    simpa [hij] using (W.path j).initial_mem_vertexSet
  exact Set.disjoint_left.mp (W.disjoint hne) hi hj

/-- A warp with countably many initial vertices has a countable carrier.
Every long path is indexed by `ℕ`, and disjointness injects path indices into
the initial set. -/
theorem vertexSet_countable_of_initialSet {V : Type} {G : SimpleGraph V}
    (W : Warp G) (hinit : W.initialSet.Countable) :
    W.vertexSet.Countable := by
  classical
  let f : W.ι → W.initialSet := fun i => ⟨(W.path i).initial, ⟨i, rfl⟩⟩
  have hf : Function.Injective f := by
    intro i j hij
    exact W.initial_injective (congrArg Subtype.val hij)
  letI : Countable W.initialSet := hinit.to_subtype
  letI : Countable W.ι := hf.countable
  let g : W.ι × ℕ → V := fun z => (W.path z.1).vertex z.2
  apply (Set.countable_range g).mono
  rintro v ⟨i, n, hn, hnv⟩
  exact ⟨(i, n), hnv⟩

theorem terminalSet_countable_of_initialSet {V : Type}
    {G : SimpleGraph V} (W : Warp G) (hinit : W.initialSet.Countable) :
    W.terminalSet.Countable := by
  apply (W.vertexSet_countable_of_initialSet hinit).mono
  rintro v ⟨i, hi⟩
  exact ⟨i, LongPath.terminal_mem_vertexSet hi⟩

/-- The subwarp carried by a chosen set of path indices. -/
def restrictIndices {V : Type} {G : SimpleGraph V} (W : Warp G)
    (I : Set W.ι) : Warp G where
  ι := I
  path i := W.path i.1
  disjoint := by
    intro i j hij
    apply W.disjoint
    intro h
    exact hij (Subtype.ext h)

/-- Adjoin one path to a warp whose whole vertex set is disjoint from it. -/
def addPath {V : Type} {G : SimpleGraph V} (p : LongPath G) (W : Warp G)
    (hdisjoint : Disjoint p.vertexSet W.vertexSet) : Warp G where
  ι := Sum Unit W.ι
  path
    | .inl _ => p
    | .inr i => W.path i
  disjoint := by
    intro i j hij
    cases i with
    | inl i =>
        cases j with
        | inl j =>
            exact (hij (congrArg Sum.inl (Subsingleton.elim i j))).elim
        | inr j =>
            rw [Set.disjoint_left]
            intro v hvp hvj
            exact Set.disjoint_left.mp hdisjoint hvp ⟨j, hvj⟩
    | inr i =>
        cases j with
        | inl j =>
            rw [Set.disjoint_left]
            intro v hvi hvp
            exact Set.disjoint_left.mp hdisjoint hvp ⟨i, hvi⟩
        | inr j =>
            apply W.disjoint
            intro hij'
            exact hij (congrArg Sum.inr hij')

@[simp] theorem vertexSet_addPath {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (W : Warp G)
    (hdisjoint : Disjoint p.vertexSet W.vertexSet) :
    (W.addPath p hdisjoint).vertexSet = p.vertexSet ∪ W.vertexSet := by
  ext v
  simp [vertexSet, addPath]

@[simp] theorem initialSet_addPath {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (W : Warp G)
    (hdisjoint : Disjoint p.vertexSet W.vertexSet) :
    (W.addPath p hdisjoint).initialSet = {p.initial} ∪ W.initialSet := by
  ext v
  simp [initialSet, addPath, eq_comm]

@[simp] theorem terminalSet_addPath {V : Type} {G : SimpleGraph V}
    (p : LongPath G) (W : Warp G)
    (hdisjoint : Disjoint p.vertexSet W.vertexSet) :
    (W.addPath p hdisjoint).terminalSet =
      {v | p.terminal? = some v} ∪ W.terminalSet := by
  ext v
  simp [terminalSet, addPath]

@[simp] theorem vertexSet_restrictIndices {V : Type} {G : SimpleGraph V}
    (W : Warp G) (I : Set W.ι) :
    (W.restrictIndices I).vertexSet =
      {v | ∃ i, i ∈ I ∧ v ∈ (W.path i).vertexSet} := by
  ext v
  simp [vertexSet, restrictIndices]

@[simp] theorem initialSet_restrictIndices {V : Type} {G : SimpleGraph V}
    (W : Warp G) (I : Set W.ι) :
    (W.restrictIndices I).initialSet =
      {v | ∃ i, i ∈ I ∧ (W.path i).initial = v} := by
  ext v
  simp [initialSet, restrictIndices]

@[simp] theorem terminalSet_restrictIndices {V : Type} {G : SimpleGraph V}
    (W : Warp G) (I : Set W.ι) :
    (W.restrictIndices I).terminalSet =
      {v | ∃ i, i ∈ I ∧ (W.path i).terminal? = some v} := by
  ext v
  simp [terminalSet, restrictIndices]

theorem vertexSet_restrictIndices_subset {V : Type} {G : SimpleGraph V}
    (W : Warp G) (I : Set W.ι) :
    (W.restrictIndices I).vertexSet ⊆ W.vertexSet := by
  rw [vertexSet_restrictIndices]
  rintro v ⟨i, hi, hv⟩
  exact ⟨i, hv⟩

theorem initialSet_restrictIndices_subset {V : Type} {G : SimpleGraph V}
    (W : Warp G) (I : Set W.ι) :
    (W.restrictIndices I).initialSet ⊆ W.initialSet := by
  rw [initialSet_restrictIndices]
  rintro v ⟨i, hi, hiv⟩
  exact ⟨i, hiv⟩

theorem terminalSet_restrictIndices_subset {V : Type} {G : SimpleGraph V}
    (W : Warp G) (I : Set W.ι) :
    (W.restrictIndices I).terminalSet ⊆ W.terminalSet := by
  rw [terminalSet_restrictIndices]
  rintro v ⟨i, hi, hiv⟩
  exact ⟨i, hiv⟩

/-- The fractured part of a warp issued from a set `X`: retain precisely the
components whose initial vertex belongs to `X`.  In the quotient construction
these are the components promoted from the exposed boundary of `X`. -/
def issuedFrom {V : Type} {G : SimpleGraph V} (W : Warp G)
    (X : Set V) : Warp G :=
  W.restrictIndices {i | (W.path i).initial ∈ X}

@[simp] theorem initialSet_issuedFrom {V : Type} {G : SimpleGraph V}
    (W : Warp G) (X : Set V) :
    (W.issuedFrom X).initialSet = W.initialSet ∩ X := by
  ext v
  change v ∈ (W.restrictIndices {i | (W.path i).initial ∈ X}).initialSet ↔
    v ∈ W.initialSet ∩ X
  rw [initialSet_restrictIndices]
  constructor
  · rintro ⟨i, hiX, hiv⟩
    exact ⟨⟨i, hiv⟩, hiv ▸ hiX⟩
  · rintro ⟨⟨i, hiv⟩, hvX⟩
    refine ⟨i, ?_, hiv⟩
    simpa [hiv] using hvX

theorem vertexSet_issuedFrom_subset {V : Type} {G : SimpleGraph V}
    (W : Warp G) (X : Set V) :
    (W.issuedFrom X).vertexSet ⊆ W.vertexSet := by
  exact W.vertexSet_restrictIndices_subset _

/-- A fractured warp issued from a countable boundary has countable carrier,
even when the ambient warp and source side are arbitrarily large. -/
theorem vertexSet_issuedFrom_countable {V : Type} {G : SimpleGraph V}
    (W : Warp G) {X : Set V} (hX : X.Countable) :
    (W.issuedFrom X).vertexSet.Countable := by
  apply (W.issuedFrom X).vertexSet_countable_of_initialSet
  rw [initialSet_issuedFrom]
  exact hX.mono Set.inter_subset_right

/-- The subwarp `W⟨X⟩` in Aharoni--Berger notation: retain precisely the
paths which meet `X` somewhere (not only those whose initial vertex is in
`X`). -/
def meeting {V : Type} {G : SimpleGraph V} (W : Warp G)
    (X : Set V) : Warp G :=
  W.restrictIndices {i | ∃ x ∈ (W.path i).vertexSet, x ∈ X}

theorem vertexSet_meeting_subset {V : Type} {G : SimpleGraph V}
    (W : Warp G) (X : Set V) :
    (W.meeting X).vertexSet ⊆ W.vertexSet :=
  W.vertexSet_restrictIndices_subset _

/-- A vertex set is closed under the components of a warp when every path
which meets it is wholly contained in it.  This is the causal invariant used
in the strengthened countable closing argument. -/
def IsClosedOn {V : Type} {G : SimpleGraph V} (W : Warp G)
    (R : Set V) : Prop :=
  (W.meeting R).vertexSet ⊆ R

theorem IsClosedOn.path_subset {V : Type} {G : SimpleGraph V}
    {W : Warp G} {R : Set V} (hW : W.IsClosedOn R) (i : W.ι)
    (hmeet : ∃ x ∈ (W.path i).vertexSet, x ∈ R) :
    (W.path i).vertexSet ⊆ R := by
  intro v hv
  apply hW
  rw [meeting, vertexSet_restrictIndices]
  exact ⟨i, hmeet, hv⟩

theorem isClosedOn_of_path_subset {V : Type} {G : SimpleGraph V}
    {W : Warp G} {R : Set V}
    (hW : ∀ i : W.ι, (∃ x ∈ (W.path i).vertexSet, x ∈ R) →
      (W.path i).vertexSet ⊆ R) :
    W.IsClosedOn R := by
  intro v hv
  rw [meeting, vertexSet_restrictIndices] at hv
  rcases hv with ⟨i, hi, hvi⟩
  exact hW i hi hvi

theorem IsClosedOn.mapLE {V : Type} {G H : SimpleGraph V}
    {W : Warp G} {R : Set V} (hW : W.IsClosedOn R) (hGH : G ≤ H) :
    (W.mapLE hGH).IsClosedOn R := by
  apply isClosedOn_of_path_subset
  intro i hmeet
  change (W.path i).vertexSet ⊆ R
  change ∃ x ∈ (W.path i).vertexSet, x ∈ R at hmeet
  exact hW.path_subset i hmeet

theorem IsClosedOn.of_mapLE {V : Type} {G H : SimpleGraph V}
    {W : Warp G} {R : Set V} (hGH : G ≤ H)
    (hW : (W.mapLE hGH).IsClosedOn R) : W.IsClosedOn R := by
  apply isClosedOn_of_path_subset
  intro i hmeet
  change ((W.mapLE hGH).path i).vertexSet ⊆ R
  apply hW.path_subset i
  change ∃ x ∈ (W.path i).vertexSet, x ∈ R
  exact hmeet

/-- Disjointness makes the family of paths meeting a countable set
countable: choose one meeting point on each path and inject path indices into
the countable set. -/
theorem vertexSet_meeting_countable {V : Type} {G : SimpleGraph V}
    (W : Warp G) {X : Set V} (hX : X.Countable) :
    (W.meeting X).vertexSet.Countable := by
  classical
  let I : Set W.ι := {i | ∃ x ∈ (W.path i).vertexSet, x ∈ X}
  let point : I → X := fun i =>
    ⟨Classical.choose i.property,
      (Classical.choose_spec i.property).2⟩
  have hpointPath (i : I) : (point i : V) ∈ (W.path i.1).vertexSet :=
    (Classical.choose_spec i.property).1
  have hpoint : Function.Injective point := by
    intro i j hij
    apply Subtype.ext
    by_contra hijIndex
    have hd := W.disjoint hijIndex
    exact Set.disjoint_left.mp hd (hpointPath i)
      (congrArg Subtype.val hij ▸ hpointPath j)
  letI : Countable X := hX.to_subtype
  letI : Countable I := hpoint.countable
  have hInitial : (W.meeting X).initialSet.Countable := by
    apply (Set.countable_range fun i : I => (W.path i.1).initial).mono
    rintro v ⟨i, hiv⟩
    exact ⟨i, hiv⟩
  exact (W.meeting X).vertexSet_countable_of_initialSet hInitial

/-- Reinterpret a warp avoiding `X` as a warp in the spanning exterior
graph. -/
def toOutsideGraph {V : Type} {G : SimpleGraph V} {X : Set V}
    (W : Warp G) (houtside : Disjoint W.vertexSet X) :
    Warp (outsideGraph G X) where
  ι := W.ι
  path i := (W.path i).toOutsideGraph fun v hv =>
    Set.disjoint_left.mp houtside ⟨i, hv⟩
  disjoint := by
    intro i j hij
    simpa using W.disjoint hij

@[simp] theorem path_initial_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (W : Warp G) (houtside : Disjoint W.vertexSet X)
    (i : W.ι) :
    ((W.toOutsideGraph houtside).path i).initial = (W.path i).initial := rfl

@[simp] theorem path_terminal?_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (W : Warp G) (houtside : Disjoint W.vertexSet X)
    (i : W.ι) :
    ((W.toOutsideGraph houtside).path i).terminal? = (W.path i).terminal? := rfl

@[simp] theorem vertexSet_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (W : Warp G) (houtside : Disjoint W.vertexSet X) :
    (W.toOutsideGraph houtside).vertexSet = W.vertexSet := rfl

@[simp] theorem initialSet_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (W : Warp G) (houtside : Disjoint W.vertexSet X) :
    (W.toOutsideGraph houtside).initialSet = W.initialSet := rfl

@[simp] theorem terminalSet_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (W : Warp G) (houtside : Disjoint W.vertexSet X) :
    (W.toOutsideGraph houtside).terminalSet = W.terminalSet := rfl

@[simp] theorem mapLE_toOutsideGraph {V : Type} {G : SimpleGraph V}
    {X : Set V} (W : Warp G) (houtside : Disjoint W.vertexSet X) :
    (W.toOutsideGraph houtside).mapLE (outsideGraph_le G X) = W := by
  cases W
  rfl

@[simp] theorem vertexSet_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (W : Warp G) : (W.mapLE hGH).vertexSet = W.vertexSet := rfl

@[simp] theorem initialSet_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (W : Warp G) : (W.mapLE hGH).initialSet = W.initialSet := rfl

@[simp] theorem terminalSet_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (W : Warp G) : (W.mapLE hGH).terminalSet = W.terminalSet := rfl

/-- An ambient dart belongs to a lifted warp exactly when it has the same
ordered endpoints as a dart of the original warp. -/
theorem mem_dartSet_mapLE_iff {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (W : Warp G) (d : H.Dart) :
    d ∈ (W.mapLE hGH).dartSet ↔
      ∃ e : G.Dart, e ∈ W.dartSet ∧ e.toProd = d.toProd := by
  constructor
  · rintro ⟨i, n, hn, hdn⟩
    let e : G.Dart :=
      ⟨((W.path i).vertex n, (W.path i).vertex (n + 1)),
        (W.path i).adjacent n hn⟩
    refine ⟨e, ⟨i, n, hn, rfl⟩, ?_⟩
    exact hdn.symm
  · rintro ⟨e, ⟨i, n, hn, hen⟩, hed⟩
    refine ⟨i, n, hn, ?_⟩
    exact hed.symm.trans hen

@[simp] theorem edgeSet_mapLE {V : Type} {G H : SimpleGraph V}
    (hGH : G ≤ H) (W : Warp G) :
    (W.mapLE hGH).edgeSet = W.edgeSet := by
  ext s
  constructor
  · rintro ⟨d, hd, rfl⟩
    rcases (mem_dartSet_mapLE_iff hGH W d).mp hd with
      ⟨e, he, hed⟩
    refine ⟨e, he, ?_⟩
    change s(e.fst, e.snd) = s(d.fst, d.snd)
    rw [show e.fst = d.fst from congrArg Prod.fst hed,
      show e.snd = d.snd from congrArg Prod.snd hed]
  · rintro ⟨e, he, rfl⟩
    let d : H.Dart := ⟨e.toProd, hGH e.adj⟩
    refine ⟨d, (mem_dartSet_mapLE_iff hGH W d).mpr
      ⟨e, he, rfl⟩, ?_⟩
    rfl

/-- Terminal vertices that persist from some stage onward remain terminals
in the pointwise direct limit.  Pairwise disjointness forces the path index
carrying a persistent vertex to stabilize. -/
theorem orderLiminf_terminalSet_subset_limitOfPaths
    {ι κ V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → κ → LongPath G)
    (hchain : ∀ a ⦃i j⦄, i ≤ j → (P i a).Forward (P j a))
    (hdisjoint : ∀ i, Pairwise fun a b =>
      Disjoint (P i a).vertexSet (P i b).vertexSet) :
    orderLiminf (fun i => {v | ∃ a, (P i a).terminal? = some v}) ⊆
      (limitOfPaths P hchain hdisjoint).terminalSet := by
  classical
  intro v hv
  rcases hv with ⟨i₀, hi₀⟩
  rcases hi₀ i₀ le_rfl with ⟨a₀, ha₀⟩
  refine ⟨a₀, LongPath.terminal?_limit_of_eventually
    (fun i => P i a₀) (hchain a₀) ?_⟩
  refine ⟨i₀, ?_⟩
  intro j hi₀j
  rcases hi₀ j hi₀j with ⟨a, ha⟩
  by_cases haa₀ : a = a₀
  · simpa [haa₀] using ha
  · have hva : v ∈ (P j a).vertexSet :=
      LongPath.terminal_mem_vertexSet ha
    rcases LongPath.terminal?_eq_some_iff.mp ha₀ with
      ⟨k, hkFinite, hkv⟩
    have hkActive : longPathActive (P i₀ a₀).terminalIndex k := by
      simp [hkFinite, longPathActive]
    have hforward := hchain a₀ hi₀j k hkActive
    have hva₀ : v ∈ (P j a₀).vertexSet :=
      ⟨k, hforward.1, hforward.2.trans hkv⟩
    exact (Set.disjoint_left.mp (hdisjoint j haa₀) hva hva₀).elim

theorem initialSet_subset_vertexSet {V : Type} {G : SimpleGraph V}
    (W : Warp G) : W.initialSet ⊆ W.vertexSet := by
  rintro v ⟨i, rfl⟩
  exact ⟨i, (W.path i).initial_mem_vertexSet⟩

theorem terminalSet_subset_vertexSet {V : Type} {G : SimpleGraph V}
    (W : Warp G) : W.terminalSet ⊆ W.vertexSet := by
  rintro v ⟨i, hi⟩
  exact ⟨i, LongPath.terminal_mem_vertexSet hi⟩

def IsStarting {V : Type} {G : SimpleGraph V} (W : Warp G) (A : Set V) : Prop :=
  W.initialSet ⊆ A

def IsWave {V : Type} {G : SimpleGraph V} (W : Warp G) (A B : Set V) : Prop :=
  W.IsStarting A ∧ Separates G A B W.terminalSet

def IsHindrance {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A B : Set V) : Prop :=
  W.IsWave A B ∧ ¬ A ⊆ W.initialSet

/-- Directed-web paths never re-enter their source side.  For the symmetric
graph representation this condition records the same orientation convention
explicitly. -/
def IsSourceClean {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A : Set V) : Prop :=
  ∀ i v, v ∈ (W.path i).vertexSet → v ∈ A → v = (W.path i).initial

def IsTrivialOn {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A : Set V) : Prop :=
  W.initialSet = A ∧ W.vertexSet = A

def IsCleanLoose {V : Type} (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∀ W : Warp G, W.IsWave A B → W.IsSourceClean A → W.IsTrivialOn A

/-- A linkage contains one finite path starting at every source and ending
in the target. -/
def IsLinkage {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A B : Set V) : Prop :=
  W.initialSet = A ∧ ∀ i, ∃ b ∈ B, (W.path i).terminal? = some b

def IsCleanLinkage {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A B : Set V) : Prop :=
  W.IsLinkage A B ∧ W.IsSourceClean A

/-- The source-clean version of ``unhindered''.  The directed proof works in
webs in which paths cannot enter the source side; in the symmetric encoding
that convention is recorded by `IsSourceClean`. -/
def IsCleanUnhindered {V : Type} (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∀ W : Warp G, W.IsWave A B → W.IsSourceClean A → A ⊆ W.initialSet

/-- A hindrance satisfying the source-orientation convention.  Bundling the
cleanliness proof makes deletion and quotient obstructions usable directly
against `IsCleanUnhindered`. -/
def IsCleanHindrance {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A B : Set V) : Prop :=
  W.IsHindrance A B ∧ W.IsSourceClean A

theorem isCleanUnhindered_iff_no_cleanHindrance {V : Type}
    {G : SimpleGraph V} {A B : Set V} :
    IsCleanUnhindered G A B ↔
      ∀ W : Warp G, ¬ W.IsCleanHindrance A B := by
  constructor
  · intro h W hW
    exact hW.1.2 (h W hW.1.1 hW.2)
  · intro h W hW hclean
    by_contra hmiss
    exact h W ⟨⟨hW, hmiss⟩, hclean⟩

theorem not_isCleanUnhindered_iff_exists_cleanHindrance {V : Type}
    {G : SimpleGraph V} {A B : Set V} :
    ¬ IsCleanUnhindered G A B ↔
      ∃ W : Warp G, W.IsCleanHindrance A B := by
  rw [isCleanUnhindered_iff_no_cleanHindrance]
  push Not
  rfl

theorem IsSourceClean.mapLE {V : Type} {G H : SimpleGraph V}
    {A : Set V} {W : Warp G} (hW : W.IsSourceClean A) (hGH : G ≤ H) :
    (W.mapLE hGH).IsSourceClean A := by
  intro i v hv ha
  exact hW i v hv ha

theorem IsSourceClean.toOutsideGraph {V : Type} {G : SimpleGraph V}
    {A X : Set V} {W : Warp G} (hW : W.IsSourceClean A)
    (houtside : Disjoint W.vertexSet X) :
    (W.toOutsideGraph houtside).IsSourceClean A := by
  intro i v hv ha
  exact hW i v hv ha

/-- A wave that avoids a deleted set remains a wave after the deletion.  The
source and target sides are restricted because isolated vertices of the
spanning exterior graph are deliberately retained in the ambient type. -/
theorem IsWave.toOutsideGraph {V : Type} {G : SimpleGraph V}
    {A B X : Set V} {W : Warp G} (hW : W.IsWave A B)
    (houtside : Disjoint W.vertexSet X) :
    (W.toOutsideGraph houtside).IsWave (A \ X) (B \ X) := by
  refine ⟨?_, ?_⟩
  · change W.initialSet ⊆ A \ X
    intro a ha
    refine ⟨hW.1 ha, ?_⟩
    intro haX
    exact Set.disjoint_left.mp houtside
      (W.initialSet_subset_vertexSet ha) haX
  · intro a ha b hb q hq
    let qG : G.Walk a b := q.mapLe (outsideGraph_le G X)
    have hqG : qG.IsPath := hq.mapLe (outsideGraph_le G X)
    rcases hW.2 a ha.1 b hb.1 qG hqG with ⟨v, hvq, hvW⟩
    refine ⟨v, ?_, ?_⟩
    · simpa [qG, Walk.support_mapLe_eq_support] using hvq
    · simpa using hvW

/-- If the deleted vertices contain no sources, a hindrance avoiding them
remains a hindrance.  This is the easy, disjoint-carrier case of
Aharoni--Berger Lemma 3.31. -/
theorem IsHindrance.toOutsideGraph {V : Type} {G : SimpleGraph V}
    {A B X : Set V} {W : Warp G} (hW : W.IsHindrance A B)
    (houtside : Disjoint W.vertexSet X) (hAX : Disjoint A X) :
    (W.toOutsideGraph houtside).IsHindrance (A \ X) (B \ X) := by
  refine ⟨hW.1.toOutsideGraph houtside, ?_⟩
  intro hcover
  apply hW.2
  intro a ha
  have haX : a ∉ X := fun hax =>
    Set.disjoint_left.mp hAX ha hax
  exact hcover ⟨ha, haX⟩

/-- Source-clean hindrances are preserved by a deletion disjoint from both
their carrier and the source side. -/
theorem IsCleanHindrance.toOutsideGraph {V : Type} {G : SimpleGraph V}
    {A B X : Set V} {W : Warp G} (hW : W.IsCleanHindrance A B)
    (houtside : Disjoint W.vertexSet X) (hAX : Disjoint A X) :
    (W.toOutsideGraph houtside).IsCleanHindrance (A \ X) (B \ X) := by
  refine ⟨hW.1.toOutsideGraph houtside hAX, ?_⟩
  intro i v hv ha
  exact hW.2 i v hv ha.1

theorem IsTrivialOn.mapLE {V : Type} {G H : SimpleGraph V}
    {A : Set V} {W : Warp G} (hW : W.IsTrivialOn A) (hGH : G ≤ H) :
    (W.mapLE hGH).IsTrivialOn A := by
  simpa [IsTrivialOn] using hW

theorem IsLinkage.mapLE {V : Type} {G H : SimpleGraph V}
    {A B : Set V} {W : Warp G} (hW : W.IsLinkage A B) (hGH : G ≤ H) :
    (W.mapLE hGH).IsLinkage A B := by
  refine ⟨by simpa [IsLinkage] using hW.1, ?_⟩
  intro i
  rcases hW.2 i with ⟨b, hb, hi⟩
  refine ⟨b, hb, ?_⟩
  change ((W.path i).mapLE hGH).terminal? = some b
  rw [LongPath.terminal?_mapLE]
  exact hi

theorem IsCleanLinkage.mapLE {V : Type} {G H : SimpleGraph V}
    {A B : Set V} {W : Warp G} (hW : W.IsCleanLinkage A B) (hGH : G ≤ H) :
    (W.mapLE hGH).IsCleanLinkage A B := by
  exact ⟨hW.1.mapLE hGH, hW.2.mapLE hGH⟩

theorem IsCleanLoose.isCleanUnhindered {V : Type} {G : SimpleGraph V}
    {A B : Set V} (h : IsCleanLoose G A B) :
    IsCleanUnhindered G A B := by
  intro W hW hclean
  rw [(h W hW hclean).1]

theorem IsCleanUnhindered.not_isHindrance {V : Type}
    {G : SimpleGraph V} {A B : Set V}
    (h : IsCleanUnhindered G A B) {W : Warp G}
    (hW : W.IsWave A B) (hclean : W.IsSourceClean A) :
    ¬ W.IsHindrance A B := by
  intro hh
  exact hh.2 (h W hW hclean)

theorem IsStarting.restrictIndices {V : Type} {G : SimpleGraph V}
    {A : Set V} {W : Warp G} (hW : W.IsStarting A) (I : Set W.ι) :
    (W.restrictIndices I).IsStarting A := by
  exact (W.initialSet_restrictIndices_subset I).trans hW

theorem IsSourceClean.restrictIndices {V : Type} {G : SimpleGraph V}
    {A : Set V} {W : Warp G} (hW : W.IsSourceClean A)
    (I : Set W.ι) :
    (W.restrictIndices I).IsSourceClean A := by
  intro i v hv ha
  exact hW i.1 v hv ha

theorem IsWave.restrictIndices_of_roof_eq {V : Type}
    {G : SimpleGraph V} {A B : Set V} {W : Warp G}
    (hW : W.IsWave A B) (I : Set W.ι)
    (hroof : roof G B (W.restrictIndices I).terminalSet =
      roof G B W.terminalSet) :
    (W.restrictIndices I).IsWave A B := by
  refine ⟨hW.1.restrictIndices I, ?_⟩
  rw [separates_iff_subset_roof, hroof]
  exact (separates_iff_subset_roof.mp hW.2)

/-- Removing the terminal vertex of one member of a wave and discarding that
member leaves a wave in the deleted web.  This elementary deletion fact is
used repeatedly in the finite-deletion and safe-path arguments. -/
theorem IsWave.erasePath_isWave_deleteTerminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {W : Warp G}
    (hW : W.IsWave A B) (i : W.ι) {t : V}
    (hit : (W.path i).terminal? = some t) :
    let I : Set W.ι := {j | j ≠ i}
    let R := W.restrictIndices I
    ∃ houtside : Disjoint R.vertexSet {t},
      (R.toOutsideGraph houtside).IsWave (A \ {t}) (B \ {t}) := by
  classical
  let I : Set W.ι := {j | j ≠ i}
  let R := W.restrictIndices I
  have htPath : t ∈ (W.path i).vertexSet :=
    LongPath.terminal_mem_vertexSet hit
  have houtside : Disjoint R.vertexSet {t} := by
    change Disjoint (W.restrictIndices I).vertexSet {t}
    rw [Set.disjoint_left]
    rw [vertexSet_restrictIndices]
    rintro v ⟨j, hjI, hvj⟩ hvt
    have hvt' : v = t := Set.mem_singleton_iff.mp hvt
    subst v
    exact Set.disjoint_left.mp (W.disjoint (Ne.symm hjI)) htPath hvj
  refine ⟨houtside, ?_⟩
  let U := R.toOutsideGraph houtside
  refine ⟨?_, ?_⟩
  · change U.initialSet ⊆ A \ {t}
    rw [show U.initialSet = R.initialSet by simp [U]]
    rintro v ⟨j, hjv⟩
    have hvA : v ∈ A := hW.1 ⟨j.1, hjv⟩
    refine ⟨hvA, ?_⟩
    intro hvt
    have hvt' : v = t := Set.mem_singleton_iff.mp hvt
    have hjt : (R.path j).initial = t := hjv.trans hvt'
    apply Set.disjoint_left.mp houtside
      ⟨j, (R.path j).initial_mem_vertexSet⟩
      (Set.mem_singleton_iff.mpr hjt)
  · intro a ha b hb q hq
    let qG : G.Walk a b := q.mapLe (outsideGraph_le G {t})
    have hqG : qG.IsPath := hq.mapLe (outsideGraph_le G {t})
    rcases hW.2 a ha.1 b hb.1 qG hqG with ⟨x, hxq, hxTerminal⟩
    have hxq' : x ∈ q.support := by
      simpa [qG, Walk.support_mapLe_eq_support] using hxq
    have hxt : x ≠ t := by
      intro hxt
      subst x
      exact Erdos599.Walk.vertex_not_mem_of_outsideGraph q ha.2 hxq'
        (Set.mem_singleton t)
    rcases hxTerminal with ⟨j, hjx⟩
    have hji : j ≠ i := by
      intro hji
      subst j
      exact hxt (Option.some.inj (hjx.symm.trans hit))
    refine ⟨x, hxq', ?_⟩
    exact ⟨⟨j, hji⟩, hjx⟩

theorem IsWave.exists_hindrance_deleteTerminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {W : Warp G}
    (hW : W.IsWave A B) (i : W.ι) {t : V}
    (hit : (W.path i).terminal? = some t)
    (hiA : (W.path i).initial ∈ A)
    (hitne : (W.path i).initial ≠ t) :
    ∃ U : Warp (outsideGraph G {t}),
      U.IsHindrance (A \ {t}) (B \ {t}) := by
  classical
  let I : Set W.ι := {j | j ≠ i}
  let R := W.restrictIndices I
  rcases hW.erasePath_isWave_deleteTerminal i hit with
    ⟨houtside, hwave⟩
  let U := R.toOutsideGraph houtside
  refine ⟨U, hwave, ?_⟩
  intro hcover
  let a := (W.path i).initial
  have haSource : a ∈ A \ {t} := by
    exact ⟨hiA, fun hat => hitne (Set.mem_singleton_iff.mp hat)⟩
  rcases hcover haSource with ⟨j, hja⟩
  have hji : j.1 ≠ i := j.2
  have haI : a ∈ (W.path i).vertexSet :=
    (W.path i).initial_mem_vertexSet
  have haJ : a ∈ (W.path j.1).vertexSet := by
    have : (W.path j.1).initial = a := hja
    simpa [this] using (W.path j.1).initial_mem_vertexSet
  exact Set.disjoint_left.mp (W.disjoint (Ne.symm hji)) haI haJ

/-- The deletion wave obtained by discarding one path preserves the
source-clean orientation convention. -/
theorem IsSourceClean.erasePath_toOutsideGraph {V : Type}
    {G : SimpleGraph V} {A : Set V} {W : Warp G}
    (hW : W.IsSourceClean A) (i : W.ι) {t : V}
    (hit : (W.path i).terminal? = some t) :
    let I : Set W.ι := {j | j ≠ i}
    let R := W.restrictIndices I
    ∀ houtside : Disjoint R.vertexSet {t},
      (R.toOutsideGraph houtside).IsSourceClean (A \ {t}) := by
  classical
  intro I R houtside j v hv ha
  exact hW j.1 v hv ha.1

/-- If deleting the terminal of a nontrivial path of a source-clean wave
were still clean-unhindered, the remaining paths would both form a wave and
miss the discarded path's source.  This is the elementary obstruction used
at each finite-deletion step of the safe-path argument. -/
theorem IsWave.not_isCleanUnhindered_deleteTerminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {W : Warp G}
    (hW : W.IsWave A B) (hclean : W.IsSourceClean A)
    (i : W.ι) {t : V} (hit : (W.path i).terminal? = some t)
    (hiA : (W.path i).initial ∈ A)
    (hitne : (W.path i).initial ≠ t) :
    ¬ IsCleanUnhindered (outsideGraph G {t}) (A \ {t}) (B \ {t}) := by
  intro hunhindered
  classical
  let I : Set W.ι := {j | j ≠ i}
  let R := W.restrictIndices I
  rcases hW.erasePath_isWave_deleteTerminal i hit with
    ⟨houtside, hwave⟩
  let U := R.toOutsideGraph houtside
  have hUclean : U.IsSourceClean (A \ {t}) := by
    exact hclean.erasePath_toOutsideGraph i hit houtside
  have hcover : A \ {t} ⊆ U.initialSet :=
    hunhindered U hwave hUclean
  let a := (W.path i).initial
  have haSource : a ∈ A \ {t} :=
    ⟨hiA, fun hat => hitne (Set.mem_singleton_iff.mp hat)⟩
  rcases hcover haSource with ⟨j, hja⟩
  have hji : j.1 ≠ i := j.2
  have haI : a ∈ (W.path i).vertexSet :=
    (W.path i).initial_mem_vertexSet
  have haJ : a ∈ (W.path j.1).vertexSet := by
    have : (W.path j.1).initial = a := hja
    simpa [this] using (W.path j.1).initial_mem_vertexSet
  exact Set.disjoint_left.mp (W.disjoint (Ne.symm hji)) haI haJ

/-- Bundled form of the preceding deletion obstruction. -/
theorem IsWave.exists_cleanHindrance_deleteTerminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {W : Warp G}
    (hW : W.IsWave A B) (hclean : W.IsSourceClean A)
    (i : W.ι) {t : V} (hit : (W.path i).terminal? = some t)
    (hiA : (W.path i).initial ∈ A)
    (hitne : (W.path i).initial ≠ t) :
    ∃ U : Warp (outsideGraph G {t}),
      U.IsCleanHindrance (A \ {t}) (B \ {t}) := by
  rw [← not_isCleanUnhindered_iff_exists_cleanHindrance]
  exact hW.not_isCleanUnhindered_deleteTerminal hclean i hit hiA hitne

/-- Deleting a non-source vertex preserves a clean hindrance whenever that
vertex is either outside the hindrance or occurs only as a terminal.  The
remaining case in finite-deletion stability is therefore precisely deletion
of an internal point of a hindrance path, where alternating-path rerouting is
needed. -/
theorem IsCleanHindrance.exists_deleteVertex_of_not_internal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {W : Warp G}
    (hW : W.IsCleanHindrance A B) {v : V} (hvA : v ∉ A)
    (hvterminal : ∀ i, v ∈ (W.path i).vertexSet →
      (W.path i).terminal? = some v) :
    ∃ U : Warp (outsideGraph G {v}),
      U.IsCleanHindrance (A \ {v}) (B \ {v}) := by
  classical
  by_cases hvW : v ∈ W.vertexSet
  · rcases hvW with ⟨i, hvi⟩
    have hit : (W.path i).terminal? = some v := hvterminal i hvi
    have hiA : (W.path i).initial ∈ A := hW.1.1.1 ⟨i, rfl⟩
    have hine : (W.path i).initial ≠ v := by
      intro h
      exact hvA (h ▸ hiA)
    exact hW.1.1.exists_cleanHindrance_deleteTerminal
      hW.2 i hit hiA hine
  · have houtside : Disjoint W.vertexSet {v} := by
      rw [Set.disjoint_left]
      intro x hx hxv
      have hxv' : x = v := Set.mem_singleton_iff.mp hxv
      exact hvW (hxv' ▸ hx)
    have hAX : Disjoint A {v} := by
      rw [Set.disjoint_left]
      intro x hx hxv
      have hxv' : x = v := Set.mem_singleton_iff.mp hxv
      exact hvA (hxv' ▸ hx)
    exact ⟨W.toOutsideGraph houtside,
      hW.toOutsideGraph houtside hAX⟩

/-- The source-clean form of Aharoni--Berger Lemma 3.31.  It is isolated as
a proposition because Section 6 uses it only once, to move a finite boundary
certificate past a finite ground-stage deletion. -/
def FiniteHindranceDeletion : Prop :=
  ∀ (V : Type) (G : SimpleGraph V) (A B X : Set V),
    X.Finite → Disjoint A X → ¬ IsCleanUnhindered G A B →
      ¬ IsCleanUnhindered (outsideGraph G X) (A \ X) (B \ X)

/-- Aharoni--Berger Lemma 6.2, in the symmetric exterior-graph model.  A
wave outside `X` is already a wave in the original graph if every last exit
from `X` is roofed by that exterior wave. -/
theorem IsWave.mapLE_of_outerBoundary_roof
    {V : Type} {G : SimpleGraph V} {A B X : Set V}
    (U : Warp (outsideGraph G X)) (hU : U.IsWave A B)
    (hBX : Disjoint B X)
    (hboundary : outerBoundary G X ⊆
      roof (outsideGraph G X) B U.terminalSet) :
    (U.mapLE (outsideGraph_le G X)).IsWave A B := by
  classical
  refine ⟨?_, ?_⟩
  · simpa [IsStarting] using hU.1
  · intro a ha b hb q hq
    by_cases hmeet : ∃ x ∈ q.support, x ∈ X
    · rcases exists_last_index_of_support_meets q X hmeet with
        ⟨n, hnle, hnX, hnlast⟩
      have hbX : b ∉ X := fun hbX =>
        Set.disjoint_left.mp hBX hb hbX
      have hnlt : n < q.length := by
        have hne : n ≠ q.length := by
          intro hne
          apply hbX
          simpa [hne] using hnX
        omega
      let y := q.getVert (n + 1)
      have hyX : y ∉ X := by
        exact hnlast (n + 1) (by omega) (by omega)
      have hyBoundary : y ∈ outerBoundary G X := by
        exact ⟨hyX, q.getVert n, hnX, q.adj_getVert_succ hnlt⟩
      have hsuffixOutside :
          ∀ z ∈ (q.drop (n + 1)).support, z ∉ X := by
        intro z hz hzX
        rcases Walk.mem_support_iff_exists_getVert.mp hz with
          ⟨m, hm, hmle⟩
        have hindexle : n + 1 + m ≤ q.length := by
          rw [Walk.drop_length] at hmle
          omega
        have hindexX : q.getVert (n + 1 + m) ∈ X := by
          rw [← q.drop_getVert (n + 1) m, hm]
          exact hzX
        exact hnlast (n + 1 + m) hindexle (by omega) hindexX
      let r := Erdos599.Walk.toOutsideGraph
        (q.drop (n + 1)) hsuffixOutside
      have hrPath : r.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph
          (hq.drop (n + 1)) hsuffixOutside
      rcases hboundary hyBoundary b hb r hrPath with
        ⟨z, hzr, hzTerminal⟩
      have hzrDrop : z ∈ (q.drop (n + 1)).support := by
        have := hzr
        rw [Erdos599.Walk.support_toOutsideGraph] at this
        exact this
      exact ⟨z, (q.isSubwalk_drop (n + 1)).support_subset hzrDrop,
        hzTerminal⟩
    · have houtside : ∀ x ∈ q.support, x ∉ X := by
        intro x hx hxX
        exact hmeet ⟨x, hx, hxX⟩
      let r := Erdos599.Walk.toOutsideGraph q houtside
      have hrPath : r.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph hq houtside
      rcases hU.2 a ha b hb r hrPath with ⟨z, hzr, hzTerminal⟩
      have hzq : z ∈ q.support := by
        have := hzr
        rw [Erdos599.Walk.support_toOutsideGraph] at this
        exact this
      exact ⟨z, hzq, hzTerminal⟩

/-- Superset form of Lemma 6.2 used at the end of the safe-tree argument.
The real deletion set `X` is contained in a larger rooted set `T`.  A path
which uses `X` must, before reaching the target outside `T`, leave `T` at an
outer-boundary vertex; roofing all such exits therefore lifts the exterior
wave to the original web. -/
theorem IsWave.mapLE_of_subset_outerBoundary_roof
    {V : Type} {G : SimpleGraph V} {A B X T : Set V}
    (U : Warp (outsideGraph G X))
    (hU : U.IsWave (A \ X) (B \ X))
    (hXT : X ⊆ T) (hBT : Disjoint B T)
    (hboundary : outerBoundary G T ⊆
      roof (outsideGraph G X) (B \ X) U.terminalSet) :
    (U.mapLE (outsideGraph_le G X)).IsWave A B := by
  classical
  refine ⟨?_, ?_⟩
  · intro v hv
    have hvU : v ∈ U.initialSet := by simpa using hv
    exact (hU.1 hvU).1
  · intro a ha b hb q hq
    by_cases hmeetX : ∃ x ∈ q.support, x ∈ X
    · have hmeetT : ∃ x ∈ q.support, x ∈ T := by
        rcases hmeetX with ⟨x, hxq, hxX⟩
        exact ⟨x, hxq, hXT hxX⟩
      rcases exists_last_index_of_support_meets q T hmeetT with
        ⟨n, hnle, hnT, hnlast⟩
      have hbT : b ∉ T := fun hbT => Set.disjoint_left.mp hBT hb hbT
      have hnlt : n < q.length := by
        have hne : n ≠ q.length := by
          intro hne
          apply hbT
          simpa [hne] using hnT
        omega
      let y := q.getVert (n + 1)
      have hyT : y ∉ T := hnlast (n + 1) (by omega) (by omega)
      have hyBoundary : y ∈ outerBoundary G T :=
        ⟨hyT, q.getVert n, hnT, q.adj_getVert_succ hnlt⟩
      have hsuffixOutside : ∀ z ∈ (q.drop (n + 1)).support, z ∉ X := by
        intro z hz hzX
        rcases Walk.mem_support_iff_exists_getVert.mp hz with
          ⟨m, hm, hmle⟩
        have hindexle : n + 1 + m ≤ q.length := by
          rw [Walk.drop_length] at hmle
          omega
        have hindexT : q.getVert (n + 1 + m) ∈ T := by
          rw [← q.drop_getVert (n + 1) m, hm]
          exact hXT hzX
        exact hnlast (n + 1 + m) hindexle (by omega) hindexT
      let r := Erdos599.Walk.toOutsideGraph
        (q.drop (n + 1)) hsuffixOutside
      have hrPath : r.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph
          (hq.drop (n + 1)) hsuffixOutside
      rcases hboundary hyBoundary b ⟨hb, fun hbX => hbT (hXT hbX)⟩
          r hrPath with ⟨z, hzr, hzTerminal⟩
      have hzrDrop : z ∈ (q.drop (n + 1)).support := by
        simpa [r] using hzr
      exact ⟨z, (q.isSubwalk_drop (n + 1)).support_subset hzrDrop,
        by simpa using hzTerminal⟩
    · have houtside : ∀ x ∈ q.support, x ∉ X := by
        intro x hx hxX
        exact hmeetX ⟨x, hx, hxX⟩
      let r := Erdos599.Walk.toOutsideGraph q houtside
      have hrPath : r.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph hq houtside
      have haX : a ∉ X := fun haX => hmeetX ⟨a, q.start_mem_support, haX⟩
      have hbX : b ∉ X := fun hbX =>
        Set.disjoint_left.mp hBT hb (hXT hbX)
      rcases hU.2 a ⟨ha, haX⟩ b ⟨hb, hbX⟩ r hrPath with
        ⟨z, hzr, hzTerminal⟩
      exact ⟨z, by simpa [r] using hzr, by simpa using hzTerminal⟩

theorem IsSourceClean.mapLE_of_outside_sdiff
    {V : Type} {G : SimpleGraph V} {A X : Set V}
    {U : Warp (outsideGraph G X)}
    (hstart : U.IsStarting (A \ X))
    (hclean : U.IsSourceClean (A \ X)) :
    (U.mapLE (outsideGraph_le G X)).IsSourceClean A := by
  intro i v hv hvA
  have hiOutside : (U.path i).initial ∉ X := (hstart ⟨i, rfl⟩).2
  have hvOutside : v ∉ X :=
    (U.path i).vertex_not_mem_of_outsideGraph hiOutside hv
  exact hclean i v hv ⟨hvA, hvOutside⟩

theorem vertexSet_disjoint_interior_of_outside_starting
    {V : Type} {G : SimpleGraph V} {B S : Set V}
    {U : Warp (outsideGraph G (interiorRoof G B S))}
    (hU : U.IsStarting (essentialVertices G B S)) :
    Disjoint U.vertexSet (interiorRoof G B S) := by
  rw [Set.disjoint_left]
  rintro v ⟨i, hvi⟩ hvInterior
  have hiEssential : (U.path i).initial ∈ essentialVertices G B S :=
    hU ⟨i, rfl⟩
  have hiOutside : (U.path i).initial ∉ interiorRoof G B S := by
    intro hiInterior
    exact Set.disjoint_left.mp (interiorRoof_disjoint G B S)
      hiInterior hiEssential
  exact (U.path i).vertex_not_mem_of_outsideGraph hiOutside hvi hvInterior

/-- Every path of an exterior warp stays outside the deleted set, provided
its initial vertices do.  This is the generic deletion lemma underlying the
specialized strict-roof statement above. -/
theorem vertexSet_disjoint_of_outside_initialSet
    {V : Type} {G : SimpleGraph V} {X : Set V}
    {U : Warp (outsideGraph G X)}
    (hU : Disjoint U.initialSet X) :
    Disjoint U.vertexSet X := by
  rw [Set.disjoint_left]
  rintro v ⟨i, hvi⟩ hvX
  have hiOutside : (U.path i).initial ∉ X := by
    intro hiX
    exact Set.disjoint_left.mp hU ⟨i, rfl⟩ hiX
  exact (U.path i).vertex_not_mem_of_outsideGraph hiOutside hvi hvX

/-- Deleting a source preserves clean unhinderedness.  An exterior clean
hindrance could be mapped back to the ambient graph and augmented by the
singleton path at the deleted source; its old missing source would remain
missing, contradicting ambient clean unhinderedness. -/
theorem IsCleanUnhindered.deleteSource {V : Type} {G : SimpleGraph V}
    {A B : Set V} (hG : IsCleanUnhindered G A B) {a : V} (ha : a ∈ A) :
    IsCleanUnhindered (outsideGraph G {a}) (A \ {a}) (B \ {a}) := by
  classical
  rw [isCleanUnhindered_iff_no_cleanHindrance]
  intro W hW
  rcases hW with ⟨⟨hWwave, hWmissing⟩, hWclean⟩
  let W' : Warp G := W.mapLE (outsideGraph_le G {a})
  let p : LongPath G :=
    LongPath.ofWalk (.nil : G.Walk a a) (by simp)
  have hWoutside : Disjoint W.vertexSet ({a} : Set V) := by
    rw [Set.disjoint_left]
    rintro v ⟨i, hvi⟩ hva
    have hiSource : (W.path i).initial ∈ A \ ({a} : Set V) :=
      hWwave.1 ⟨i, rfl⟩
    exact (W.path i).vertex_not_mem_of_outsideGraph
      hiSource.2 hvi hva
  have hpW : Disjoint p.vertexSet W'.vertexSet := by
    change Disjoint p.vertexSet W.vertexSet
    simpa [p] using hWoutside.symm
  let U : Warp G := W'.addPath p hpW
  have hUwave : U.IsWave A B := by
    constructor
    · rw [IsStarting]
      intro v hv
      rw [show U.initialSet = {a} ∪ W'.initialSet by
        simp [U, p]] at hv
      rcases hv with hva | hvW
      · simpa [p] using hva ▸ ha
      · have hvW' : v ∈ W.initialSet := by simpa [W'] using hvW
        exact (hWwave.1 hvW').1
    · intro x hx b hb q hq
      by_cases haq : a ∈ q.support
      · refine ⟨a, haq, ?_⟩
        rw [show U.terminalSet = {a} ∪ W'.terminalSet by
          simp [U, p]]
        exact Or.inl (Set.mem_singleton a)
      · have houtside : ∀ v ∈ q.support, v ∉ ({a} : Set V) := by
          intro v hv hva
          exact haq (Set.mem_singleton_iff.mp hva ▸ hv)
        let q' : (outsideGraph G {a}).Walk x b :=
          Erdos599.Walk.toOutsideGraph q houtside
        have hq' : q'.IsPath :=
          Erdos599.Walk.isPath_toOutsideGraph hq houtside
        have hxa : x ≠ a := by
          intro hxa
          exact haq (hxa ▸ q.start_mem_support)
        have hba : b ≠ a := by
          intro hba
          exact haq (hba ▸ q.end_mem_support)
        rcases hWwave.2 x ⟨hx, by simpa using hxa⟩ b
            ⟨hb, by simpa using hba⟩ q' hq' with ⟨z, hzq', hzW⟩
        have hzq : z ∈ q.support := by
          simpa [q'] using hzq'
        refine ⟨z, hzq, ?_⟩
        rw [show U.terminalSet = {a} ∪ W'.terminalSet by
          simp [U, p]]
        exact Or.inr (by simpa [W'] using hzW)
  have hUclean : U.IsSourceClean A := by
    intro i v hv hvA
    cases i with
    | inl i =>
        cases i
        simpa [U, Warp.addPath, p, LongPath.vertexSet_ofWalk] using hv
    | inr i =>
        have hvW : v ∈ (W.path i).vertexSet := by
          exact hv
        have hvne : v ≠ a := by
          intro hva
          have hiSource : (W.path i).initial ∈ A \ ({a} : Set V) :=
            hWwave.1 ⟨i, rfl⟩
          exact (W.path i).vertex_not_mem_of_outsideGraph hiSource.2
            hvW (Set.mem_singleton_iff.mpr hva)
        exact hWclean i v hvW ⟨hvA, by simpa using hvne⟩
  have hUcover : A ⊆ U.initialSet := hG U hUwave hUclean
  apply hWmissing
  intro v hvA
  have hvU : v ∈ U.initialSet := hUcover hvA.1
  rw [show U.initialSet = {a} ∪ W'.initialSet by simp [U, p]] at hvU
  rcases hvU with hva | hvW
  · exact (hvA.2 hva).elim
  · simpa [W'] using hvW

theorem IsLinkage.isStarting {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsLinkage A B) : W.IsStarting A := by
  rw [IsStarting, hW.1]

theorem IsLinkage.terminalSet_subset {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsLinkage A B) :
    W.terminalSet ⊆ B := by
  rintro b ⟨i, hib⟩
  rcases hW.2 i with ⟨c, hcB, hic⟩
  have hbc : b = c := Option.some.inj (hib.symm.trans hic)
  simpa [hbc] using hcB

def IsUnhindered {V : Type} (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∀ W : Warp G, W.IsWave A B → A ⊆ W.initialSet

def IsSelfRoofing {V : Type} {G : SimpleGraph V} (W : Warp G)
    (B : Set V) : Prop :=
  W.vertexSet ⊆ roof G B W.terminalSet

def RoofLE {V : Type} {G : SimpleGraph V} (B : Set V)
    (U W : Warp G) : Prop :=
  roof G B U.terminalSet ⊆ roof G B W.terminalSet

/-- A normalized, pointwise-forward wave extension of a fixed warp.  Fixing
the old path index type is exactly what the arrow operation does. -/
structure WaveExtension {V : Type} {G : SimpleGraph V} (W : Warp G)
    (A B : Set V) where
  path : W.ι → LongPath.NormalizedPath G
  baseForward : ∀ i, (W.path i).Forward (path i).1
  disjoint : Pairwise fun i j =>
    Disjoint ((path i).1.vertexSet) ((path j).1.vertexSet)
  isWave : (ofPaths (fun i => (path i).1) disjoint).IsWave A B

namespace WaveExtension

def toWarp {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (X : WaveExtension W A B) : Warp G :=
  ofPaths (fun i => (X.path i).1) X.disjoint

instance {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V} :
    LE (WaveExtension W A B) :=
  ⟨fun X Y => ∀ i, (X.path i).1.Forward (Y.path i).1⟩

instance {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V} :
    PartialOrder (WaveExtension W A B) where
  le_refl X i := LongPath.Forward.refl (X.path i).1
  le_trans _ _ _ hXY hYZ i := LongPath.Forward.trans (hXY i) (hYZ i)
  le_antisymm X Y hXY hYX := by
    have hpath : X.path = Y.path := by
      funext i
      apply Subtype.ext
      exact LongPath.eq_of_mutual_forward
        (X.path i).2 (Y.path i).2 (hXY i) (hYX i)
    cases X
    cases Y
    cases hpath
    rfl

theorem vertexSet_subset_of_le {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} {X Y : WaveExtension W A B}
    (hXY : X ≤ Y) : X.toWarp.vertexSet ⊆ Y.toWarp.vertexSet := by
  rintro v ⟨i, n, hn, hnv⟩
  have hf := hXY i n hn
  exact ⟨i, n, hf.1, hf.2.trans hnv⟩

theorem dartSet_subset_of_le {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} {X Y : WaveExtension W A B}
    (hXY : X ≤ Y) : X.toWarp.dartSet ⊆ Y.toWarp.dartSet := by
  rintro d ⟨i, hi⟩
  exact ⟨i, LongPath.dartSet_mono_forward (hXY i) hi⟩

/-- Once a component of `X` reaches its terminal index `k`, the suffix of
the corresponding component of a forward extension `Y` meets the old warp
only at that old terminal. -/
theorem tail_intersection_toWarp_eq {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} {X Y : WaveExtension W A B}
    (hXY : X ≤ Y) (a : W.ι) {k : ℕ} {x : V}
    (hkFinite : (X.path a).1.terminalIndex = some k)
    (hkx : (X.path a).1.vertex k = x)
    (hkY : longPathActive (Y.path a).1.terminalIndex k) :
    ∀ z ∈ ((Y.path a).1.tail k hkY).vertexSet,
      z ∈ X.toWarp.vertexSet → z = x := by
  classical
  let hkX : longPathActive (X.path a).1.terminalIndex k := by
    simp [hkFinite, longPathActive]
  intro z hzTail hzX
  rcases hzTail with ⟨n, hn, hnz⟩
  have hknActive : longPathActive (Y.path a).1.terminalIndex (k + n) :=
    (LongPath.active_shiftedTerminalIndex_iff hkY).mp hn
  have hYaz : (Y.path a).1.vertex (k + n) = z := hnz
  rcases hzX with ⟨c, m, hm, hmz⟩
  have hcm := hXY c m hm
  have hYcz : (Y.path c).1.vertex m = z := hcm.2.trans hmz
  by_cases hac : a = c
  · subst c
    have hindex : k + n = m :=
      (Y.path a).1.injective hknActive hcm.1
        (hYaz.trans hYcz.symm)
    have hmk : m ≤ k := by
      change longPathActive (X.path a).1.terminalIndex m at hm
      simpa [hkFinite, longPathActive] using hm
    have hnzero : n = 0 := by omega
    subst n
    exact hYaz.symm.trans ((hXY a k hkX).2.trans hkx)
  · have hzYa : z ∈ (Y.path a).1.vertexSet :=
      ⟨k + n, hknActive, hYaz⟩
    have hzYc : z ∈ (Y.path c).1.vertexSet :=
      ⟨m, hcm.1, hYcz⟩
    exact (Set.disjoint_left.mp (Y.disjoint hac) hzYa hzYc).elim

/-- Every wave gives a canonical member of its forward-extension order. -/
noncomputable def base {V : Type} {G : SimpleGraph V} {W : Warp G}
    {A B : Set V} (hW : W.IsWave A B) : WaveExtension W A B where
  path i := LongPath.toNormalized (W.path i)
  baseForward i := LongPath.forward_normalize (W.path i)
  disjoint := by
    intro i j hij
    simpa [LongPath.toNormalized] using W.disjoint hij
  isWave := by
    constructor
    · simpa [LongPath.toNormalized, ofPaths, IsStarting, initialSet] using hW.1
    · simpa [LongPath.toNormalized, ofPaths, terminalSet] using hW.2

@[simp] theorem terminalSet_toWarp_base {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B) :
    (base hW).toWarp.terminalSet = W.terminalSet := by
  ext v
  simp [base, toWarp, ofPaths, terminalSet, LongPath.toNormalized]

@[simp] theorem vertexSet_toWarp_base {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B) :
    (base hW).toWarp.vertexSet = W.vertexSet := by
  ext v
  simp [base, toWarp, ofPaths, vertexSet, LongPath.toNormalized]

end WaveExtension

/-- Indices of the finite paths whose terminals are essential in the whole
terminal set. -/
def EssentialIndex {V : Type} {G : SimpleGraph V} (W : Warp G)
    (B : Set V) :=
  {i : W.ι // ∃ v, (W.path i).terminal? = some v ∧
    v ∈ essentialVertices G B W.terminalSet}

/-- Aharoni--Berger's pathwise notion of an essential component.  The
terminal has a path to the target avoiding the *whole* warp except at its
initial terminal vertex.  For waves this agrees with membership of the
terminal in `essentialVertices`; keeping the stronger formulation is useful
for alternating-path arguments. -/
def IsEssentialPath {V : Type} {G : SimpleGraph V} (W : Warp G)
    (B : Set V) (i : W.ι) : Prop :=
  ∃ t, (W.path i).terminal? = some t ∧
    ∃ b ∈ B, ∃ q : G.Walk t b,
      q.IsPath ∧ ∀ x ∈ q.support, x ∈ W.vertexSet → x = t

/-- The terminal vertices of the pathwise essential components. -/
def essentialTerminalSet {V : Type} {G : SimpleGraph V} (W : Warp G)
    (B : Set V) : Set V :=
  {t | ∃ i, (W.path i).terminal? = some t ∧ W.IsEssentialPath B i}

theorem essentialTerminalSet_subset_terminalSet {V : Type}
    {G : SimpleGraph V} (W : Warp G) (B : Set V) :
    W.essentialTerminalSet B ⊆ W.terminalSet := by
  rintro t ⟨i, hit, -⟩
  exact ⟨i, hit⟩

/-- Avoiding the whole warp certainly avoids its terminal set, so every
pathwise essential terminal is exposed in the terminal separator. -/
theorem essentialTerminalSet_subset_essentialVertices {V : Type}
    {G : SimpleGraph V} (W : Warp G) (B : Set V) :
    W.essentialTerminalSet B ⊆ essentialVertices G B W.terminalSet := by
  rintro t ⟨i, hit, htEssential⟩
  rcases htEssential with ⟨u, hiu, b, hb, q, hq, honly⟩
  have htu : t = u := Option.some.inj (hit.symm.trans hiu)
  subst u
  apply mem_essentialVertices_iff.mpr
  refine ⟨⟨i, hit⟩, b, hb, q, hq, ?_⟩
  intro x hxq hxTerminal
  exact honly x hxq (W.terminalSet_subset_vertexSet hxTerminal)

/-- On a wave, exposure of a terminal already supplies the stronger
Aharoni--Berger avoidance witness.  Take the last intersection of the
private terminal-to-target path with the warp.  Prefixing that suffix by the
warp component through the last intersection gives an `A`--`B` path; the
wave property forces the last intersection itself to be a terminal, and
privacy then forces it to be the original terminal. -/
theorem IsWave.essentialVertices_subset_essentialTerminalSet {V : Type}
    {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B) :
    essentialVertices G B W.terminalSet ⊆ W.essentialTerminalSet B := by
  classical
  intro t htEssential
  rcases mem_essentialVertices_iff.mp htEssential with
    ⟨htTerminal, b, hb, q, hq, hqOnlyTerminal⟩
  rcases htTerminal with ⟨i, hit⟩
  have htWarp : t ∈ W.vertexSet :=
    W.terminalSet_subset_vertexSet ⟨i, hit⟩
  have hmeet : ∃ x ∈ q.support, x ∈ W.vertexSet :=
    ⟨t, q.start_mem_support, htWarp⟩
  rcases exists_last_index_of_support_meets q W.vertexSet hmeet with
    ⟨n, hnle, hnWarp, hnlast⟩
  let y := q.getVert n
  have hyWarp : y ∈ W.vertexSet := hnWarp
  rcases hyWarp with ⟨j, m, hm, hmy⟩
  have htailOnly :
      ∀ z ∈ (q.drop n).support, z ∈ W.vertexSet → z = y := by
    intro z hzTail hzWarp
    rcases Walk.mem_support_iff_exists_getVert.mp hzTail with
      ⟨r, hrz, hrle⟩
    have hnrle : n + r ≤ q.length := by
      rw [Walk.drop_length] at hrle
      omega
    by_cases hr0 : r = 0
    · subst r
      have hyz : y = z := by
        simpa [y] using hrz
      exact hyz.symm
    · have hnrWarp : q.getVert (n + r) ∈ W.vertexSet := by
        rw [← q.drop_getVert n r, hrz]
        exact hzWarp
      exact (hnlast (n + r) hnrle (by omega) hnrWarp).elim
  let pref : G.Walk (W.path j).initial y :=
    ((W.path j).prefixWalk m hm).copy rfl hmy
  let tail : G.Walk y b := q.drop n
  let combined : G.Walk (W.path j).initial b := pref.append tail
  let combinedPath : G.Path (W.path j).initial b := combined.toPath
  have hjA : (W.path j).initial ∈ A := hW.1 ⟨j, rfl⟩
  rcases hW.2 (W.path j).initial hjA b hb
      (combinedPath : G.Walk (W.path j).initial b) combinedPath.property with
    ⟨z, hzCombinedPath, hzTerminal⟩
  have hzCombined : z ∈ combined.support :=
    combined.support_toPath_subset_support hzCombinedPath
  have hzy : z = y := by
    rw [show combined = pref.append tail by rfl,
      pref.support_append_eq_support_dropLast_append tail] at hzCombined
    rcases List.mem_append.mp hzCombined with hzPrefDrop | hzTail
    · have hzPref : z ∈ pref.support := List.mem_of_mem_dropLast hzPrefDrop
      have hzPrefOriginal :
          z ∈ ((W.path j).prefixWalk m hm).support := by
        simpa [pref] using hzPref
      rcases ((W.path j).mem_support_prefixWalk_iff hm).mp hzPrefOriginal with
        ⟨l, hlm, hlz⟩
      rcases hzTerminal with ⟨k, hkz⟩
      by_cases hjk : j = k
      · subst k
        rcases LongPath.terminal?_eq_some_iff.mp hkz with
          ⟨r, hrFinite, hrz⟩
        have hlActive : longPathActive (W.path j).terminalIndex l :=
          LongPath.active_mono hlm hm
        have hrActive : longPathActive (W.path j).terminalIndex r := by
          simp [hrFinite, longPathActive]
        have hlr : l = r := (W.path j).injective hlActive hrActive
          (hlz.trans hrz.symm)
        have hmr : m ≤ r := by
          simpa [hrFinite, longPathActive] using hm
        have hmrEq : m = r := by omega
        calc
          z = (W.path j).vertex r := hrz.symm
          _ = (W.path j).vertex m := by rw [hmrEq]
          _ = y := hmy
      · have hzPathJ : z ∈ (W.path j).vertexSet :=
          ⟨l, LongPath.active_mono hlm hm, hlz⟩
        have hzPathK : z ∈ (W.path k).vertexSet :=
          LongPath.terminal_mem_vertexSet hkz
        exact (Set.disjoint_left.mp (W.disjoint hjk) hzPathJ hzPathK).elim
    · have hzTailOriginal : z ∈ (q.drop n).support := by
        simpa [tail] using hzTail
      exact htailOnly z hzTailOriginal
        (W.terminalSet_subset_vertexSet hzTerminal)
  have hyTerminal : y ∈ W.terminalSet := hzy ▸ hzTerminal
  have hyt : y = t :=
    hqOnlyTerminal y (q.getVert_mem_support n) hyTerminal
  have hnzero : n = 0 := by
    apply (hq.getVert_eq_start_iff hnle).mp
    simpa [y] using hyt
  have hqOnlyWarp : ∀ x ∈ q.support, x ∈ W.vertexSet → x = t := by
    intro x hxq hxWarp
    rcases Walk.mem_support_iff_exists_getVert.mp hxq with
      ⟨r, hrx, hrle⟩
    by_cases hr0 : r = 0
    · subst r
      simpa using hrx.symm
    · have hrNotWarp := hnlast r hrle (by omega)
      exact (hrNotWarp (hrx ▸ hxWarp)).elim
  refine ⟨i, hit, t, hit, b, hb, q, hq, hqOnlyWarp⟩

@[simp] theorem IsWave.essentialTerminalSet_eq_essentialVertices {V : Type}
    {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B) :
    W.essentialTerminalSet B = essentialVertices G B W.terminalSet := by
  apply Set.Subset.antisymm
  · exact W.essentialTerminalSet_subset_essentialVertices B
  · exact hW.essentialVertices_subset_essentialTerminalSet

/-- Componentwise form of the preceding equality. -/
theorem IsWave.isEssentialPath_iff_terminal_essential {V : Type}
    {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B) {i : W.ι} {t : V}
    (hit : (W.path i).terminal? = some t) :
    W.IsEssentialPath B i ↔
      t ∈ essentialVertices G B W.terminalSet := by
  constructor
  · intro hi
    apply W.essentialTerminalSet_subset_essentialVertices B
    exact ⟨i, hit, hi⟩
  · intro ht
    have htStrong : t ∈ W.essentialTerminalSet B :=
      hW.essentialVertices_subset_essentialTerminalSet ht
    rcases htStrong with ⟨j, hjt, hjEssential⟩
    have hji : j = i := by
      by_contra hji
      have htj : t ∈ (W.path j).vertexSet :=
        LongPath.terminal_mem_vertexSet hjt
      have hti : t ∈ (W.path i).vertexSet :=
        LongPath.terminal_mem_vertexSet hit
      exact Set.disjoint_left.mp (W.disjoint hji) htj hti
    simpa [hji] using hjEssential

/-- The essential subwarp `E(W)`.  Rays and paths with inessential terminals
are discarded. -/
def essential {V : Type} {G : SimpleGraph V} (W : Warp G)
    (B : Set V) : Warp G where
  ι := W.EssentialIndex B
  path := fun i => W.path i.1
  disjoint := by
    intro i j hij
    apply W.disjoint
    intro h
    exact hij (Subtype.ext h)

/-- Data certifying that one finite path of `U` can be carried forward along
a suffix of a path of `W`, without that suffix meeting the old warp anywhere
except at the joining terminal. -/
structure ExtensionData {V : Type} {G : SimpleGraph V}
    (U W : Warp G) (i : U.ι) where
  endIndex : ℕ
  finite : (U.path i).terminalIndex = some endIndex
  carrier : W.ι
  meetIndex : ℕ
  meetActive : longPathActive (W.path carrier).terminalIndex meetIndex
  join : (W.path carrier).vertex meetIndex = (U.path i).vertex endIndex
  avoidsOld :
    ((W.path carrier).tail meetIndex meetActive).vertexSet ∩ U.vertexSet ⊆
      {(U.path i).vertex endIndex}

def ExtensionData.extendedPath {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d : ExtensionData U W i) : LongPath G :=
  (U.path i).append
    ((W.path d.carrier).tail d.meetIndex d.meetActive) d.endIndex d.finite
    (by simpa using d.join)
    (by
      intro v hv
      exact d.avoidsOld ⟨hv.2, ⟨i, hv.1⟩⟩)

@[simp] theorem ExtensionData.initial_extendedPath {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {i : U.ι}
    (d : ExtensionData U W i) :
    d.extendedPath.initial = (U.path i).initial := by
  unfold ExtensionData.extendedPath
  apply LongPath.initial_append

@[simp] theorem ExtensionData.terminal?_extendedPath {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {i : U.ι}
    (d : ExtensionData U W i) :
    d.extendedPath.terminal? = (W.path d.carrier).terminal? := by
  calc
    d.extendedPath.terminal? =
        ((W.path d.carrier).tail d.meetIndex d.meetActive).terminal? := by
      unfold ExtensionData.extendedPath
      apply LongPath.terminal?_append
    _ = (W.path d.carrier).terminal? :=
      LongPath.terminal?_tail _ _ _

theorem ExtensionData.vertexSet_extendedPath {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {i : U.ι}
    (d : ExtensionData U W i) :
    d.extendedPath.vertexSet = (U.path i).vertexSet ∪
      ((W.path d.carrier).tail d.meetIndex d.meetActive).vertexSet := by
  unfold ExtensionData.extendedPath
  apply LongPath.vertexSet_append

theorem ExtensionData.end_mem_path {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d : ExtensionData U W i) :
    (U.path i).vertex d.endIndex ∈ (U.path i).vertexSet := by
  refine ⟨d.endIndex, ?_, rfl⟩
  simp [d.finite, longPathActive]

theorem ExtensionData.end_mem_oldWarp {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d : ExtensionData U W i) :
    (U.path i).vertex d.endIndex ∈ U.vertexSet :=
  ⟨i, d.end_mem_path⟩

theorem ExtensionData.endIndex_eq {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d e : ExtensionData U W i) :
    d.endIndex = e.endIndex := by
  exact Option.some.inj (d.finite.symm.trans e.finite)

/-- Extension data for one old path have a unique carrier path in the new
warp.  Both proposed carriers contain the same old terminal, so disjointness
of the new warp forces their indices to agree. -/
theorem ExtensionData.carrier_eq {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d e : ExtensionData U W i) :
    d.carrier = e.carrier := by
  by_contra hcarrier
  have hend : d.endIndex = e.endIndex := d.endIndex_eq e
  have hdMem : (U.path i).vertex d.endIndex ∈ (W.path d.carrier).vertexSet := by
    exact ⟨d.meetIndex, d.meetActive, d.join⟩
  have heMem : (U.path i).vertex d.endIndex ∈ (W.path e.carrier).vertexSet := by
    exact ⟨e.meetIndex, e.meetActive, e.join.trans (by rw [hend])⟩
  exact Set.disjoint_left.mp (W.disjoint hcarrier) hdMem heMem

theorem ExtensionData.meetIndex_eq {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d e : ExtensionData U W i) :
    d.meetIndex = e.meetIndex := by
  have hcarrier : d.carrier = e.carrier := d.carrier_eq e
  have heActive : longPathActive
      (W.path d.carrier).terminalIndex e.meetIndex := by
    simpa [hcarrier] using e.meetActive
  apply (W.path d.carrier).injective d.meetActive heActive
  calc
    (W.path d.carrier).vertex d.meetIndex =
        (U.path i).vertex d.endIndex := d.join
    _ = (U.path i).vertex e.endIndex := by rw [d.endIndex_eq e]
    _ = (W.path e.carrier).vertex e.meetIndex := e.join.symm
    _ = (W.path d.carrier).vertex e.meetIndex := by rw [hcarrier]

/-- Two different old paths cannot both be carried by suffixes of the same
new path: the earlier suffix would meet the other old terminal. -/
theorem ExtensionData.carrier_ne {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i j : U.ι} (hij : i ≠ j)
    (d : ExtensionData U W i) (e : ExtensionData U W j) :
    d.carrier ≠ e.carrier := by
  intro hcarrier
  have heActive : longPathActive (W.path d.carrier).terminalIndex e.meetIndex := by
    simpa [hcarrier] using e.meetActive
  have heJoin : (W.path d.carrier).vertex e.meetIndex =
      (U.path j).vertex e.endIndex := by
    simpa [hcarrier] using e.join
  have htermNe : (U.path i).vertex d.endIndex ≠ (U.path j).vertex e.endIndex := by
    intro hterm
    exact Set.disjoint_left.mp (U.disjoint hij) d.end_mem_path
      (hterm ▸ e.end_mem_path)
  rcases lt_trichotomy d.meetIndex e.meetIndex with hde | hde | hed
  · have hadd : d.meetIndex + (e.meetIndex - d.meetIndex) = e.meetIndex := by
      omega
    have htailActive : longPathActive
        (LongPath.shiftedTerminalIndex (W.path d.carrier).terminalIndex d.meetIndex)
        (e.meetIndex - d.meetIndex) := by
      apply (LongPath.active_shiftedTerminalIndex_iff d.meetActive).mpr
      simpa [hadd] using heActive
    have htailMem : (U.path j).vertex e.endIndex ∈
        ((W.path d.carrier).tail d.meetIndex d.meetActive).vertexSet := by
      refine ⟨e.meetIndex - d.meetIndex, htailActive, ?_⟩
      simpa [LongPath.tail, hadd] using heJoin
    have hEq := Set.mem_singleton_iff.mp
      (d.avoidsOld ⟨htailMem, e.end_mem_oldWarp⟩)
    exact htermNe hEq.symm
  · have hterm : (U.path i).vertex d.endIndex =
        (U.path j).vertex e.endIndex := by
      exact d.join.symm.trans (by simpa [hde] using heJoin)
    exact htermNe hterm
  · have hdActive : longPathActive
        (W.path e.carrier).terminalIndex d.meetIndex := by
      simpa [hcarrier] using d.meetActive
    have hdJoin : (W.path e.carrier).vertex d.meetIndex =
        (U.path i).vertex d.endIndex := by
      simpa [hcarrier] using d.join
    have hadd : e.meetIndex + (d.meetIndex - e.meetIndex) = d.meetIndex := by
      omega
    have htailActive : longPathActive
        (LongPath.shiftedTerminalIndex (W.path e.carrier).terminalIndex e.meetIndex)
        (d.meetIndex - e.meetIndex) := by
      apply (LongPath.active_shiftedTerminalIndex_iff e.meetActive).mpr
      simpa [hadd] using hdActive
    have htailMem : (U.path i).vertex d.endIndex ∈
        ((W.path e.carrier).tail e.meetIndex e.meetActive).vertexSet := by
      refine ⟨d.meetIndex - e.meetIndex, htailActive, ?_⟩
      simpa [LongPath.tail, hadd] using hdJoin
    have hEq := Set.mem_singleton_iff.mp
      (e.avoidsOld ⟨htailMem, d.end_mem_oldWarp⟩)
    exact htermNe hEq

theorem ExtensionData.disjoint_extendedPath {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i j : U.ι} (hij : i ≠ j)
    (d : ExtensionData U W i) (e : ExtensionData U W j) :
    Disjoint d.extendedPath.vertexSet e.extendedPath.vertexSet := by
  rw [Set.disjoint_left, d.vertexSet_extendedPath, e.vertexSet_extendedPath]
  intro v hvd hve
  rcases hvd with hvdi | hvdt <;> rcases hve with hvei | hvet
  · exact Set.disjoint_left.mp (U.disjoint hij) hvdi hvei
  · have hvOld : v ∈ U.vertexSet := ⟨i, hvdi⟩
    have hvEnd := Set.mem_singleton_iff.mp (e.avoidsOld ⟨hvet, hvOld⟩)
    have hEndInI : (U.path j).vertex e.endIndex ∈ (U.path i).vertexSet := by
      simpa [hvEnd] using hvdi
    exact Set.disjoint_left.mp (U.disjoint hij) hEndInI e.end_mem_path
  · have hvOld : v ∈ U.vertexSet := ⟨j, hvei⟩
    have hvEnd := Set.mem_singleton_iff.mp (d.avoidsOld ⟨hvdt, hvOld⟩)
    have hEndInJ : (U.path i).vertex d.endIndex ∈ (U.path j).vertexSet := by
      simpa [hvEnd] using hvei
    exact Set.disjoint_left.mp (U.disjoint hij) d.end_mem_path hEndInJ
  · have hcarrier := d.carrier_ne hij e
    exact Set.disjoint_left.mp (W.disjoint hcarrier)
      ((W.path d.carrier).vertexSet_tail_subset d.meetIndex d.meetActive hvdt)
      ((W.path e.carrier).vertexSet_tail_subset e.meetIndex e.meetActive hvet)

theorem ExtensionData.disjoint_extendedPath_old {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i j : U.ι} (hij : i ≠ j)
    (d : ExtensionData U W i) :
    Disjoint d.extendedPath.vertexSet (U.path j).vertexSet := by
  rw [Set.disjoint_left, d.vertexSet_extendedPath]
  intro v hv hVj
  rcases hv with hVi | htail
  · exact Set.disjoint_left.mp (U.disjoint hij) hVi hVj
  · have hvOld : v ∈ U.vertexSet := ⟨j, hVj⟩
    have hvEnd := Set.mem_singleton_iff.mp (d.avoidsOld ⟨htail, hvOld⟩)
    have hEndInJ : (U.path i).vertex d.endIndex ∈ (U.path j).vertexSet := by
      simpa [hvEnd] using hVj
    exact Set.disjoint_left.mp (U.disjoint hij) d.end_mem_path hEndInJ

/-- The path obtained by carrying `U.path i` forward along `W` whenever the
extension condition is satisfiable. -/
noncomputable def arrowPath {V : Type} {G : SimpleGraph V}
    (U W : Warp G) (i : U.ι) : LongPath G := by
  classical
  exact if h : Nonempty (ExtensionData U W i) then
      (Classical.choice h).extendedPath
    else U.path i

/-- Aharoni--Berger's binary arrow operation on warps. -/
noncomputable def arrow {V : Type} {G : SimpleGraph V}
    (U W : Warp G) : Warp G where
  ι := U.ι
  path := arrowPath U W
  disjoint := by
    classical
    intro i j hij
    by_cases hi : Nonempty (ExtensionData U W i)
    · by_cases hj : Nonempty (ExtensionData U W j)
      · simpa [arrowPath, hi, hj] using
          (Classical.choice hi).disjoint_extendedPath hij (Classical.choice hj)
      · simpa [arrowPath, hi, hj] using
          (Classical.choice hi).disjoint_extendedPath_old hij
    · by_cases hj : Nonempty (ExtensionData U W j)
      · simpa [arrowPath, hi, hj] using
          ((Classical.choice hj).disjoint_extendedPath_old hij.symm).symm
      · simpa [arrowPath, hi, hj] using U.disjoint hij

@[simp] theorem initial_arrowPath {V : Type} {G : SimpleGraph V}
    (U W : Warp G) (i : U.ι) :
    (arrowPath U W i).initial = (U.path i).initial := by
  classical
  simp only [arrowPath]
  split_ifs with h
  · exact (Classical.choice h).initial_extendedPath
  · rfl

theorem forward_arrowPath {V : Type} {G : SimpleGraph V}
    (U W : Warp G) (i : U.ι) :
    (U.path i).Forward (arrowPath U W i) := by
  classical
  simp only [arrowPath]
  split_ifs with h
  · unfold ExtensionData.extendedPath
    apply LongPath.forward_append
  · exact LongPath.Forward.refl _

@[simp] theorem initialSet_arrow {V : Type} {G : SimpleGraph V}
    (U W : Warp G) : (arrow U W).initialSet = U.initialSet := by
  classical
  ext v
  simp [arrow, initialSet]

theorem oldPath_vertexSet_subset_arrowPath {V : Type} {G : SimpleGraph V}
    (U W : Warp G) (i : U.ι) :
    (U.path i).vertexSet ⊆ (arrowPath U W i).vertexSet := by
  classical
  simp only [arrowPath]
  split_ifs with h
  · rw [(Classical.choice h).vertexSet_extendedPath]
    exact Set.subset_union_left
  · exact fun _ => id

theorem vertexSet_subset_arrow {V : Type} {G : SimpleGraph V}
    (U W : Warp G) : U.vertexSet ⊆ (arrow U W).vertexSet := by
  rintro v ⟨i, hvi⟩
  exact ⟨i, oldPath_vertexSet_subset_arrowPath U W i hvi⟩

/-- Binary arrow composition preserves the directed-web source convention.
An appended suffix cannot contain its carrier's source unless it starts at
that source; in that case the joining endpoint was already a source on the
old component. -/
theorem IsSourceClean.arrow {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {A : Set V}
    (hU : U.IsSourceClean A) (hW : W.IsSourceClean A) :
    (arrow U W).IsSourceClean A := by
  classical
  intro i v hv hvA
  change v ∈ (arrowPath U W i).vertexSet at hv
  change v = (arrowPath U W i).initial
  simp only [arrowPath] at hv ⊢
  split_ifs with h
  · let d := Classical.choice h
    simp only [dif_pos h] at hv ⊢
    change v ∈ d.extendedPath.vertexSet at hv
    rw [d.vertexSet_extendedPath] at hv
    rcases hv with hvOld | hvTail
    · exact (hU i v hvOld hvA).trans
        (Classical.choice h).initial_extendedPath.symm
    · have hvCarrier : v ∈ (W.path d.carrier).vertexSet :=
        (W.path d.carrier).vertexSet_tail_subset
          d.meetIndex d.meetActive hvTail
      have hvInitial := hW d.carrier v hvCarrier hvA
      rcases hvTail with ⟨r, hrActive, hrv⟩
      have hmrActive : longPathActive (W.path d.carrier).terminalIndex
          (d.meetIndex + r) :=
        (LongPath.active_shiftedTerminalIndex_iff d.meetActive).mp hrActive
      have hzero : longPathActive (W.path d.carrier).terminalIndex 0 := by
        cases (W.path d.carrier).terminalIndex <;> simp [longPathActive]
      have hmrValue : (W.path d.carrier).vertex (d.meetIndex + r) = v := by
        simpa [LongPath.tail] using hrv
      have hzeroValue : (W.path d.carrier).vertex 0 = v := by
        simpa [LongPath.initial] using hvInitial.symm
      have hindex : d.meetIndex + r = 0 :=
        (W.path d.carrier).injective hmrActive hzero
          (hmrValue.trans hzeroValue.symm)
      have hmeet : d.meetIndex = 0 := by omega
      have hendValue : (U.path i).vertex d.endIndex = v := by
        calc
          (U.path i).vertex d.endIndex =
              (W.path d.carrier).vertex d.meetIndex := d.join.symm
          _ = (W.path d.carrier).vertex 0 := by rw [hmeet]
          _ = v := hzeroValue
      have hvOld : v ∈ (U.path i).vertexSet := by
        simpa [hendValue] using d.end_mem_path
      exact (hU i v hvOld hvA).trans
        (Classical.choice h).initial_extendedPath.symm
  · simp only [dif_neg h] at hv ⊢
    exact hU i v hv hvA

/-- Causal component-closure is preserved by binary arrow composition. -/
theorem IsClosedOn.arrow {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {R : Set V}
    (hU : U.IsClosedOn R) (hW : W.IsClosedOn R) :
    (arrow U W).IsClosedOn R := by
  apply isClosedOn_of_path_subset
  intro i hmeet
  change (arrowPath U W i).vertexSet ⊆ R
  change ∃ x ∈ (arrowPath U W i).vertexSet, x ∈ R at hmeet
  classical
  simp only [arrowPath] at hmeet ⊢
  by_cases h : Nonempty (ExtensionData U W i)
  · simp only [dif_pos h] at hmeet ⊢
    let d := Classical.choice h
    rw [d.vertexSet_extendedPath] at hmeet ⊢
    rcases hmeet with ⟨x, hxOld | hxTail, hxR⟩
    · have hUPath : (U.path i).vertexSet ⊆ R :=
        hU.path_subset i ⟨x, hxOld, hxR⟩
      have hendR : (U.path i).vertex d.endIndex ∈ R :=
        hUPath d.end_mem_path
      have hendW : (U.path i).vertex d.endIndex ∈
          (W.path d.carrier).vertexSet :=
        ⟨d.meetIndex, d.meetActive, d.join⟩
      have hWPath : (W.path d.carrier).vertexSet ⊆ R :=
        hW.path_subset d.carrier
          ⟨(U.path i).vertex d.endIndex, hendW, hendR⟩
      exact Set.union_subset hUPath
        ((W.path d.carrier).vertexSet_tail_subset
          d.meetIndex d.meetActive |>.trans hWPath)
    · have hxW : x ∈ (W.path d.carrier).vertexSet :=
        (W.path d.carrier).vertexSet_tail_subset
          d.meetIndex d.meetActive hxTail
      have hWPath : (W.path d.carrier).vertexSet ⊆ R :=
        hW.path_subset d.carrier ⟨x, hxW, hxR⟩
      have hendW : (U.path i).vertex d.endIndex ∈
          (W.path d.carrier).vertexSet :=
        ⟨d.meetIndex, d.meetActive, d.join⟩
      have hendR : (U.path i).vertex d.endIndex ∈ R := hWPath hendW
      have hUPath : (U.path i).vertexSet ⊆ R :=
        hU.path_subset i
          ⟨(U.path i).vertex d.endIndex, d.end_mem_path, hendR⟩
      exact Set.union_subset hUPath
        ((W.path d.carrier).vertexSet_tail_subset
          d.meetIndex d.meetActive |>.trans hWPath)
  · simp only [dif_neg h] at hmeet ⊢
    exact hU.path_subset i hmeet

theorem terminalSet_arrow_subset {V : Type} {G : SimpleGraph V}
    (U W : Warp G) :
    (arrow U W).terminalSet ⊆ U.terminalSet ∪ W.terminalSet := by
  classical
  rintro v ⟨i, hi⟩
  simp only [arrow, arrowPath] at hi
  split_ifs at hi with h
  · exact Or.inr ⟨(Classical.choice h).carrier,
      (Classical.choice h).terminal?_extendedPath.symm.trans hi⟩
  · exact Or.inl ⟨i, hi⟩

theorem terminal_mem_arrow_of_extension {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι} (d : ExtensionData U W i) {v : V}
    (hv : (W.path d.carrier).terminal? = some v) :
    v ∈ (arrow U W).terminalSet := by
  classical
  let h : Nonempty (ExtensionData U W i) := ⟨d⟩
  let chosen := Classical.choice h
  have hcarrier : chosen.carrier = d.carrier := chosen.carrier_eq d
  refine ⟨i, ?_⟩
  change (arrowPath U W i).terminal? = some v
  rw [show arrowPath U W i = chosen.extendedPath by
    simp [arrowPath, h, chosen]]
  rw [chosen.terminal?_extendedPath]
  simpa [hcarrier] using hv

theorem ExtensionData.tail_vertexSet_subset_arrow {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {i : U.ι}
    (d : ExtensionData U W i) :
    ((W.path d.carrier).tail d.meetIndex d.meetActive).vertexSet ⊆
      (arrow U W).vertexSet := by
  classical
  let h : Nonempty (ExtensionData U W i) := ⟨d⟩
  let chosen := Classical.choice h
  have hcarrier : chosen.carrier = d.carrier := chosen.carrier_eq d
  have hmeet : chosen.meetIndex = d.meetIndex := chosen.meetIndex_eq d
  intro x hx
  refine ⟨i, ?_⟩
  change x ∈ (arrowPath U W i).vertexSet
  rw [show arrowPath U W i = chosen.extendedPath by
    simp [arrowPath, h, chosen]]
  rw [chosen.vertexSet_extendedPath]
  apply Or.inr
  simpa [hcarrier, hmeet] using hx

theorem terminal_mem_arrow_of_not_extension {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {i : U.ι}
    (h : ¬ Nonempty (ExtensionData U W i)) {v : V}
    (hv : (U.path i).terminal? = some v) :
    v ∈ (arrow U W).terminalSet := by
  classical
  refine ⟨i, ?_⟩
  change (arrowPath U W i).terminal? = some v
  simpa [arrowPath, h] using hv

/-- The left-terminal case in the proof that arrows of waves are waves.
An essential terminal of `U ∪ W` that already terminates `U` either is
absent from `W` (so its old path is retained) or is itself a terminal of
`W` (so the old path is carried to that same terminal). -/
theorem terminal_mem_arrow_of_left_essential {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {B : Set V} (hWroof : W.IsSelfRoofing B) {z : V}
    (hzU : z ∈ U.terminalSet)
    (hzEssential : z ∈ essentialVertices G B (U.terminalSet ∪ W.terminalSet)) :
    z ∈ (arrow U W).terminalSet := by
  classical
  rcases hzU with ⟨i, hiTerminal⟩
  by_cases hzWvertex : z ∈ W.vertexSet
  · have hzRoofW : z ∈ roof G B W.terminalSet := hWroof hzWvertex
    rcases mem_essentialVertices_iff.mp hzEssential with
      ⟨_, b, hb, q, hq, hqOnly⟩
    rcases hzRoofW b hb q hq with ⟨y, hyq, hyWTerminal⟩
    have hyz : y = z := hqOnly y hyq (Or.inr hyWTerminal)
    have hzWTerminal : z ∈ W.terminalSet := by simpa [hyz] using hyWTerminal
    rcases LongPath.terminal?_eq_some_iff.mp hiTerminal with
      ⟨k, hkFinite, hkz⟩
    rcases hzWTerminal with ⟨j, hjTerminal⟩
    rcases LongPath.terminal?_eq_some_iff.mp hjTerminal with
      ⟨l, hlFinite, hlz⟩
    have hlActive : longPathActive (W.path j).terminalIndex l := by
      simp [hlFinite, longPathActive]
    let d : ExtensionData U W i := {
      endIndex := k
      finite := hkFinite
      carrier := j
      meetIndex := l
      meetActive := hlActive
      join := hlz.trans hkz.symm
      avoidsOld := by
        intro x hx
        have hxz : x = z := by
          have hxTail := hx.1
          rw [(W.path j).vertexSet_tail_terminal l hlFinite hlActive] at hxTail
          exact (Set.mem_singleton_iff.mp hxTail).trans hlz
        exact Set.mem_singleton_iff.mpr (hxz.trans hkz.symm) }
    exact terminal_mem_arrow_of_extension d hjTerminal
  · have hnoExtension : ¬ Nonempty (ExtensionData U W i) := by
      rintro ⟨d⟩
      rcases LongPath.terminal?_eq_some_iff.mp hiTerminal with
        ⟨k, hkFinite, hkz⟩
      have hdk : d.endIndex = k :=
        Option.some.inj (d.finite.symm.trans hkFinite)
      apply hzWvertex
      refine ⟨d.carrier, d.meetIndex, d.meetActive, ?_⟩
      calc
        (W.path d.carrier).vertex d.meetIndex =
            (U.path i).vertex d.endIndex := d.join
        _ = (U.path i).vertex k := by rw [hdk]
        _ = z := hkz
    exact terminal_mem_arrow_of_not_extension hnoExtension hiTerminal

/-- The right-terminal case in the arrow lemma.  On the `W`-path ending at
an essential terminal, take the last point roofed by `U`.  It cannot be the
right endpoint unless that endpoint already terminates `U`; hence it is an
essential terminal of `U`, and the remaining suffix supplies extension data. -/
theorem terminal_mem_arrow_of_right_essential {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {A B : Set V} (hU : U.IsWave A B) (hW : W.IsWave A B)
    (hUroof : U.IsSelfRoofing B)
    {z : V} (hzW : z ∈ W.terminalSet) (hzNotU : z ∉ U.terminalSet)
    (hzEssential : z ∈ essentialVertices G B (U.terminalSet ∪ W.terminalSet)) :
    z ∈ (arrow U W).terminalSet := by
  classical
  rcases hzW with ⟨j, hjTerminal⟩
  rcases LongPath.terminal?_eq_some_iff.mp hjTerminal with
    ⟨l, hlFinite, hlz⟩
  have hlActive : longPathActive (W.path j).terminalIndex l := by
    simp [hlFinite, longPathActive]
  let pref := (W.path j).prefixWalk l hlActive
  have hstartA : (W.path j).initial ∈ A := hW.1 ⟨j, rfl⟩
  have hstartRoof : (W.path j).initial ∈ roof G B U.terminalSet :=
    separates_iff_subset_roof.mp hU.2 hstartA
  have hmeet : ∃ x ∈ pref.support, x ∈ roof G B U.terminalSet :=
    ⟨(W.path j).initial, pref.start_mem_support, hstartRoof⟩
  rcases exists_last_roof_index pref hmeet with
    ⟨n, hnle, hnRoof, hnEssential | hnEnd, hnlast⟩
  · have hnl : n ≤ l := by simpa [pref] using hnle
    have hget : pref.getVert n = (W.path j).vertex n := by
      exact (W.path j).getVert_prefixWalk_of_le hlActive hnl
    have hvertexEssential : (W.path j).vertex n ∈
        essentialVertices G B U.terminalSet := by
      simpa [hget] using hnEssential
    have hvertexTerminal : (W.path j).vertex n ∈ U.terminalSet :=
      essentialVertices_subset G B U.terminalSet hvertexEssential
    rcases hvertexTerminal with ⟨i, hiTerminal⟩
    rcases LongPath.terminal?_eq_some_iff.mp hiTerminal with
      ⟨k, hkFinite, hkVertex⟩
    have hnActive : longPathActive (W.path j).terminalIndex n :=
      LongPath.active_mono hnl hlActive
    let d : ExtensionData U W i := {
      endIndex := k
      finite := hkFinite
      carrier := j
      meetIndex := n
      meetActive := hnActive
      join := hkVertex.symm
      avoidsOld := by
        intro x hx
        rcases hx.1 with ⟨m, hmActive, hmVertex⟩
        have hnmActive : longPathActive (W.path j).terminalIndex (n + m) :=
          (LongPath.active_shiftedTerminalIndex_iff hnActive).mp hmActive
        have hnml : n + m ≤ l := by
          simpa [hlFinite, longPathActive] using hnmActive
        have hxRoof : x ∈ roof G B U.terminalSet :=
          hUroof hx.2
        have hgetnm : pref.getVert (n + m) = (W.path j).vertex (n + m) :=
          (W.path j).getVert_prefixWalk_of_le hlActive hnml
        have hroofnm : pref.getVert (n + m) ∈ roof G B U.terminalSet := by
          rw [hgetnm]
          have hmVertex' : (W.path j).vertex (n + m) = x := by
            simpa [LongPath.tail] using hmVertex
          exact hmVertex' ▸ hxRoof
        have hm0 : m = 0 := by
          by_contra hm0
          exact hnlast (n + m) (by simpa [pref] using hnml) (by omega) hroofnm
        subst m
        have hxJoin : x = (W.path j).vertex n := by
          simpa [LongPath.tail] using hmVertex.symm
        exact Set.mem_singleton_iff.mpr (hxJoin.trans hkVertex.symm) }
    exact terminal_mem_arrow_of_extension d hjTerminal
  · have hnEqL : n = l := by
      have hprefLength : pref.length = l := by simp [pref]
      exact hnEnd.trans hprefLength
    have hzRoof : z ∈ roof G B U.terminalSet := by
      have hgetEnd : pref.getVert n = z := by
        rw [hnEqL]
        exact ((W.path j).getVert_prefixWalk_of_le hlActive le_rfl).trans hlz
      simpa [hgetEnd] using hnRoof
    rcases mem_essentialVertices_iff.mp hzEssential with
      ⟨_, b, hb, q, hq, hqOnly⟩
    rcases hzRoof b hb q hq with ⟨y, hyq, hyU⟩
    have hyz : y = z := hqOnly y hyq (Or.inl hyU)
    exact (hzNotU (by simpa [hyz] using hyU)).elim

@[simp] theorem terminalSet_essential {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B : Set V) :
    (W.essential B).terminalSet = essentialVertices G B W.terminalSet := by
  ext v
  constructor
  · rintro ⟨i, hi⟩
    rcases i.property with ⟨t, hit, htEssential⟩
    have hvt : v = t := Option.some.inj (hi.symm.trans hit)
    exact hvt ▸ htEssential
  · intro hvEssential
    have hvTerminal : v ∈ W.terminalSet :=
      essentialVertices_subset G B W.terminalSet hvEssential
    rcases hvTerminal with ⟨i, hi⟩
    exact ⟨⟨i, v, hi, hvEssential⟩, hi⟩

theorem IsWave.essential {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B) :
    (W.essential B).IsWave A B := by
  constructor
  · rintro v ⟨i, rfl⟩
    exact hW.1 ⟨i.1, rfl⟩
  · rw [terminalSet_essential]
    exact essentialVertices_separates hW.2

/-- The warp of singleton paths at every source. -/
def trivial {V : Type} (G : SimpleGraph V) (A : Set V) : Warp G where
  ι := A
  path := fun i => LongPath.ofWalk (.nil : G.Walk i i) (by simp)
  disjoint := by
    intro i j hij
    rw [LongPath.vertexSet_ofWalk, LongPath.vertexSet_ofWalk, Set.disjoint_left]
    intro v hvi hvj
    simp only [Set.mem_ofPred_eq, Walk.support_nil, List.mem_singleton] at hvi hvj
    exact hij (Subtype.ext (hvi.symm.trans hvj))

@[simp] theorem initialSet_trivial {V : Type} (G : SimpleGraph V) (A : Set V) :
    (trivial G A).initialSet = A := by
  ext v
  simp [initialSet, trivial]

@[simp] theorem terminalSet_trivial {V : Type} (G : SimpleGraph V) (A : Set V) :
    (trivial G A).terminalSet = A := by
  ext v
  simp [terminalSet, trivial]

theorem trivial_isWave {V : Type} (G : SimpleGraph V) (A B : Set V) :
    (trivial G A).IsWave A B := by
  constructor
  · rw [IsStarting, initialSet_trivial]
  · rw [terminalSet_trivial]
    intro a ha b hb q hq
    exact ⟨a, q.start_mem_support, ha⟩

theorem trivial_isSourceClean {V : Type} (G : SimpleGraph V) (A : Set V) :
    (trivial G A).IsSourceClean A := by
  intro i v hv _
  simpa [trivial, LongPath.vertexSet_ofWalk] using hv

/-!
### Total warps

The alternating-walk proofs used in the finite-deletion lemma are most
convenient when the path family has a (possibly singleton) member indexed by
every source.  Aharoni and Berger use this convention implicitly.  The
following construction changes only the indexing convention: every old path
is retained, while an uncovered source receives its singleton path.
-/

/-- The unique path index whose initial vertex is `a`. -/
noncomputable def sourceIndex {V : Type} {G : SimpleGraph V}
    (W : Warp G) {a : V} (ha : a ∈ W.initialSet) : W.ι :=
  Classical.choose ha

@[simp] theorem initial_sourceIndex {V : Type} {G : SimpleGraph V}
    (W : Warp G) {a : V} (ha : a ∈ W.initialSet) :
    (W.path (W.sourceIndex ha)).initial = a := by
  exact Classical.choose_spec ha

/-- The path assigned to a source after totalization.  An old path is used
when its initial vertex is already present, and otherwise the singleton path
at the source is inserted. -/
noncomputable def sourcePath {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (a : A) : LongPath G := by
  classical
  exact if ha : (a : V) ∈ W.initialSet then
      W.path (W.sourceIndex ha)
    else
      LongPath.ofWalk (.nil : G.Walk a a) (by simp)

theorem sourcePath_of_mem {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (a : A) (ha : (a : V) ∈ W.initialSet) :
    W.sourcePath A a = W.path (W.sourceIndex ha) := by
  simp [sourcePath, ha]

theorem sourcePath_of_not_mem {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (a : A) (ha : (a : V) ∉ W.initialSet) :
    W.sourcePath A a = LongPath.ofWalk (.nil : G.Walk a a) (by simp) := by
  simp [sourcePath, ha]

@[simp] theorem initial_sourcePath {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (a : A) :
    (W.sourcePath A a).initial = a := by
  classical
  by_cases ha : (a : V) ∈ W.initialSet
  · rw [W.sourcePath_of_mem A a ha, W.initial_sourceIndex ha]
  · rw [W.sourcePath_of_not_mem A a ha]
    simp

/-- Totalize a source-clean warp by adding singleton paths at its missing
sources.  Source-cleanliness is exactly what makes the new singleton paths
disjoint from the old ones. -/
noncomputable def totalize {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (hclean : W.IsSourceClean A) : Warp G where
  ι := A
  path := W.sourcePath A
  disjoint := by
    classical
    intro a b hab
    by_cases ha : (a : V) ∈ W.initialSet
    · by_cases hb : (b : V) ∈ W.initialSet
      · rw [W.sourcePath_of_mem A a ha, W.sourcePath_of_mem A b hb]
        apply W.disjoint
        intro hindex
        apply hab
        apply Subtype.ext
        calc
          (a : V) = (W.path (W.sourceIndex ha)).initial :=
            (W.initial_sourceIndex ha).symm
          _ = (W.path (W.sourceIndex hb)).initial := by rw [hindex]
          _ = (b : V) := W.initial_sourceIndex hb
      · rw [W.sourcePath_of_mem A a ha, W.sourcePath_of_not_mem A b hb,
          LongPath.vertexSet_ofWalk, Set.disjoint_left]
        intro v hva hvb
        simp only [Set.mem_ofPred_eq, Walk.support_nil,
          List.mem_singleton] at hvb
        apply hab
        apply Subtype.ext
        have hbInitial : (b : V) = (W.path (W.sourceIndex ha)).initial :=
          hclean (W.sourceIndex ha) b (hvb ▸ hva) b.property
        exact hbInitial.trans (W.initial_sourceIndex ha) |>.symm
    · by_cases hb : (b : V) ∈ W.initialSet
      · rw [W.sourcePath_of_not_mem A a ha, W.sourcePath_of_mem A b hb,
          LongPath.vertexSet_ofWalk, Set.disjoint_left]
        intro v hva hvb
        simp only [Set.mem_ofPred_eq, Walk.support_nil,
          List.mem_singleton] at hva
        apply hab
        apply Subtype.ext
        have haInitial : (a : V) = (W.path (W.sourceIndex hb)).initial :=
          hclean (W.sourceIndex hb) a (hva ▸ hvb) a.property
        exact haInitial.trans (W.initial_sourceIndex hb)
      · rw [W.sourcePath_of_not_mem A a ha, W.sourcePath_of_not_mem A b hb,
          LongPath.vertexSet_ofWalk, LongPath.vertexSet_ofWalk,
          Set.disjoint_left]
        intro v hva hvb
        simp only [Set.mem_ofPred_eq, Walk.support_nil,
          List.mem_singleton] at hva hvb
        exact hab (Subtype.ext (hva.symm.trans hvb))

@[simp] theorem path_totalize {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (hclean : W.IsSourceClean A) (a : A) :
    (W.totalize A hclean).path a = W.sourcePath A a := rfl

@[simp] theorem initialSet_totalize {V : Type} {G : SimpleGraph V}
    (W : Warp G) (A : Set V) (hclean : W.IsSourceClean A) :
    (W.totalize A hclean).initialSet = A := by
  ext v
  simp [initialSet, totalize]

theorem sourcePath_at_initial {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A : Set V} (hstart : W.IsStarting A) (i : W.ι) :
    W.sourcePath A ⟨(W.path i).initial, hstart ⟨i, rfl⟩⟩ = W.path i := by
  classical
  let a : A := ⟨(W.path i).initial, hstart ⟨i, rfl⟩⟩
  have ha : (a : V) ∈ W.initialSet := ⟨i, rfl⟩
  rw [W.sourcePath_of_mem A a ha]
  apply congrArg W.path
  apply W.initial_injective
  exact W.initial_sourceIndex ha

theorem vertexSet_subset_totalize {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A : Set V} (hstart : W.IsStarting A)
    (hclean : W.IsSourceClean A) :
    W.vertexSet ⊆ (W.totalize A hclean).vertexSet := by
  rintro v ⟨i, hvi⟩
  let a : A := ⟨(W.path i).initial, hstart ⟨i, rfl⟩⟩
  refine ⟨a, ?_⟩
  simpa [a, sourcePath_at_initial hstart i] using hvi

theorem terminalSet_subset_totalize {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A : Set V} (hstart : W.IsStarting A)
    (hclean : W.IsSourceClean A) :
    W.terminalSet ⊆ (W.totalize A hclean).terminalSet := by
  rintro v ⟨i, hiv⟩
  let a : A := ⟨(W.path i).initial, hstart ⟨i, rfl⟩⟩
  refine ⟨a, ?_⟩
  simpa [a, sourcePath_at_initial hstart i] using hiv

@[simp] theorem vertexSet_totalize {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A : Set V} (hstart : W.IsStarting A)
    (hclean : W.IsSourceClean A) :
    (W.totalize A hclean).vertexSet =
      W.vertexSet ∪ (A \ W.initialSet) := by
  classical
  ext v
  change (∃ a : A, v ∈ (W.sourcePath A a).vertexSet) ↔
    v ∈ W.vertexSet ∪ (A \ W.initialSet)
  constructor
  · rintro ⟨a, hva⟩
    by_cases ha : (a : V) ∈ W.initialSet
    · left
      exact ⟨W.sourceIndex ha, by
        simpa [W.sourcePath_of_mem A a ha] using hva⟩
    · right
      have hva' : v = (a : V) := by
        rw [W.sourcePath_of_not_mem A a ha,
          LongPath.vertexSet_ofWalk] at hva
        simpa using hva
      simpa [hva'] using And.intro a.property ha
  · rintro (hvW | hvMissing)
    · exact vertexSet_subset_totalize hstart hclean hvW
    · rcases hvMissing with ⟨hvA, hvNotInitial⟩
      let a : A := ⟨v, hvA⟩
      refine ⟨a, ?_⟩
      change v ∈ (W.sourcePath A a).vertexSet
      rw [W.sourcePath_of_not_mem A a hvNotInitial,
        LongPath.vertexSet_ofWalk]
      simp [a]

@[simp] theorem terminalSet_totalize {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A : Set V} (hstart : W.IsStarting A)
    (hclean : W.IsSourceClean A) :
    (W.totalize A hclean).terminalSet =
      W.terminalSet ∪ (A \ W.initialSet) := by
  classical
  ext v
  change (∃ a : A, (W.sourcePath A a).terminal? = some v) ↔
    v ∈ W.terminalSet ∪ (A \ W.initialSet)
  constructor
  · rintro ⟨a, hva⟩
    by_cases ha : (a : V) ∈ W.initialSet
    · left
      exact ⟨W.sourceIndex ha, by
        simpa [W.sourcePath_of_mem A a ha] using hva⟩
    · right
      have hva' : (a : V) = v := by
        rw [W.sourcePath_of_not_mem A a ha,
          LongPath.terminal?_ofWalk] at hva
        exact Option.some.inj hva
      simpa [← hva'] using And.intro a.property ha
  · rintro (hvW | hvMissing)
    · exact terminalSet_subset_totalize hstart hclean hvW
    · rcases hvMissing with ⟨hvA, hvNotInitial⟩
      let a : A := ⟨v, hvA⟩
      refine ⟨a, ?_⟩
      change (W.sourcePath A a).terminal? = some v
      rw [W.sourcePath_of_not_mem A a hvNotInitial,
        LongPath.terminal?_ofWalk]

theorem IsSourceClean.totalize {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A : Set V} (hclean : W.IsSourceClean A) :
    (W.totalize A hclean).IsSourceClean A := by
  classical
  change ∀ a : A, ∀ v, v ∈ (W.sourcePath A a).vertexSet →
    v ∈ A → v = (W.sourcePath A a).initial
  intro a v hv hvA
  by_cases ha : (a : V) ∈ W.initialSet
  · rw [W.sourcePath_of_mem A a ha] at hv ⊢
    exact hclean (W.sourceIndex ha) v hv hvA
  · rw [W.sourcePath_of_not_mem A a ha,
      LongPath.vertexSet_ofWalk] at hv
    simpa using hv

theorem IsWave.totalize {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B)
    (hclean : W.IsSourceClean A) :
    (W.totalize A hclean).IsWave A B := by
  refine ⟨by rw [IsStarting, initialSet_totalize], ?_⟩
  intro a ha b hb q hq
  rcases hW.2 a ha b hb q hq with ⟨v, hvq, hvterminal⟩
  exact ⟨v, hvq, terminalSet_subset_totalize hW.1 hclean hvterminal⟩

/-- Package the totalization of a source-clean wave as a normalized total
wave.  This is the representation-changing converse to forgetting a
`TotalWave`'s fixed source index type. -/
noncomputable def IsWave.toTotalWave {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B)
    (hclean : W.IsSourceClean A) : WaveExtension (trivial G A) A B := by
  let T := W.totalize A hclean
  let path : A → LongPath.NormalizedPath G := fun a ↦
    LongPath.toNormalized (T.path a)
  refine {
    path := path
    baseForward := ?_
    disjoint := ?_
    isWave := ?_ }
  · intro a n hn
    have hn0 : n = 0 := by
      simpa [trivial, LongPath.ofWalk, longPathActive] using hn
    subst n
    have hactive : longPathActive (T.path a).terminalIndex 0 := by
      cases (T.path a).terminalIndex <;> simp [longPathActive]
    refine ⟨?_, ?_⟩
    · change longPathActive (T.path a).normalize.terminalIndex 0
      simpa using hactive
    change (path a).1.vertex 0 = ((trivial G A).path a).vertex 0
    calc
      (path a).1.vertex 0 = (T.path a).vertex 0 := by
        exact LongPath.vertex_normalize_of_active (T.path a) hactive
      _ = (a.1 : V) := by
        change (W.sourcePath A a).initial = (a.1 : V)
        exact W.initial_sourcePath A a
      _ = ((trivial G A).path a).vertex 0 := by
        change (a.1 : V) = ((trivial G A).path a).initial
        exact (LongPath.initial_ofWalk (.nil : G.Walk a.1 a.1) (by simp)).symm
  · intro a b hab
    change Disjoint ((T.path a).normalize.vertexSet)
      ((T.path b).normalize.vertexSet)
    simpa using T.disjoint hab
  · have hT := hW.totalize hclean
    constructor
    · change ∀ v, (∃ i : A, (T.path i).normalize.initial = v) → v ∈ A
      rintro v ⟨i, hiv⟩
      have hi : (T.path i).normalize.initial = (i : V) := by
        rw [LongPath.initial_normalize]
        change (W.sourcePath A i).initial = (i : V)
        exact W.initial_sourcePath A i
      rw [hi] at hiv
      exact hiv ▸ i.property
    · intro a ha b hb q hq
      rcases hT.2 a ha b hb q hq with ⟨v, hvq, i, hiv⟩
      refine ⟨v, hvq, i, ?_⟩
      change (T.path i).normalize.terminal? = some v
      simpa using hiv

/-- A total wave is a normalized wave extending the singleton path at every
source.  Thus its index type is literally `A`, and its component at `a`
starts at `a`. -/
abbrev TotalWave {V : Type} (G : SimpleGraph V) (A B : Set V) :=
  WaveExtension (trivial G A) A B

namespace TotalWave

@[simp] theorem path_initial {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) (a : A) :
    (X.path a).1.initial = a := by
  have hzero : longPathActive ((trivial G A).path a).terminalIndex 0 := by
    simp [trivial, LongPath.ofWalk, longPathActive]
  have hf := X.baseForward a 0 hzero
  change (X.path a).1.vertex 0 = (a : V)
  calc
    (X.path a).1.vertex 0 = ((trivial G A).path a).vertex 0 := hf.2
    _ = (a : V) := by simp [trivial, LongPath.ofWalk]

@[simp] theorem initialSet_toWarp {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) :
    X.toWarp.initialSet = A := by
  ext v
  change (∃ a : A, (X.path a).1.initial = v) ↔ v ∈ A
  simp

theorem path_eq_of_le_of_terminal_eq {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y) (a : A)
    {t : V} (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t) :
    (X.path a).1 = (Y.path a).1 := by
  rcases LongPath.terminal?_eq_some_iff.mp htX with ⟨m, hm, hmt⟩
  rcases LongPath.terminal?_eq_some_iff.mp htY with ⟨n, hn, hnt⟩
  have hmActive : longPathActive (X.path a).1.terminalIndex m := by
    simp [hm, longPathActive]
  have hmY := hXY a m hmActive
  have hnActive : longPathActive (Y.path a).1.terminalIndex n := by
    simp [hn, longPathActive]
  have hmn : m = n := (Y.path a).1.injective hmY.1 hnActive
    (hmY.2.trans (hmt.trans hnt.symm))
  subst n
  have hterminal : (X.path a).1.terminalIndex =
      (Y.path a).1.terminalIndex := hm.trans hn.symm
  apply LongPath.eq_of_mutual_forward (X.path a).2 (Y.path a).2 (hXY a)
  intro k hkY
  have hkX : longPathActive (X.path a).1.terminalIndex k := by
    simpa [hterminal] using hkY
  exact ⟨hkX, (hXY a k hkX).2.symm⟩

/-- The sources whose component terminal is essential in the terminal
separator.  This is Shafer's `ess_G(W)`, expressed using the already
formalized essential-boundary operator. -/
def essentialSources {V : Type} {G : SimpleGraph V} {A B : Set V}
    (X : TotalWave G A B) : Set A :=
  {a | ∃ t, (X.path a).1.terminal? = some t ∧
    t ∈ essentialVertices G B X.toWarp.terminalSet}

/-- Every total wave is source-clean.  If a source vertex lies on the
component indexed by `a`, its own component also contains that vertex as its
initial point; disjointness therefore forces the two indices to agree. -/
theorem isSourceClean {V : Type} {G : SimpleGraph V} {A B : Set V}
    (X : TotalWave G A B) : X.toWarp.IsSourceClean A := by
  change ∀ a : A, ∀ v, v ∈ (X.path a).1.vertexSet →
    v ∈ A → v = (X.path a).1.initial
  intro a v hv hvA
  let b : A := ⟨v, hvA⟩
  have hvb : v ∈ (X.path b).1.vertexSet := by
    have hinitial : (X.path b).1.initial = v := by
      simpa [b] using X.path_initial b
    exact hinitial ▸ (X.path b).1.initial_mem_vertexSet
  have hab : a = b := by
    by_contra hab
    exact Set.disjoint_left.mp (X.disjoint hab) hv hvb
  have hva : v = (a : V) := by
    simpa [b] using congrArg Subtype.val hab.symm
  exact hva.trans (X.path_initial a).symm

/-- In a clean-unhindered web, every source of every total wave is
essential.  Otherwise delete the inessential component.  The essential
boundary still separates, so the remaining source-clean subwarp is a clean
hindrance missing precisely that component's source. -/
theorem essentialSources_eq_univ_of_isCleanUnhindered {V : Type}
    {G : SimpleGraph V} {A B : Set V}
    (hG : IsCleanUnhindered G A B) (X : TotalWave G A B) :
    X.essentialSources = Set.univ := by
  classical
  apply Set.eq_univ_iff_forall.mpr
  intro a
  by_contra ha
  let I : Set A := {b | b ≠ a}
  let R : Warp G := X.toWarp.restrictIndices I
  have hRwave : R.IsWave A B := by
    constructor
    · exact X.isWave.1.restrictIndices I
    · have hEssentialSeparates := essentialVertices_separates X.isWave.2
      intro u hu v hv q hq
      rcases hEssentialSeparates u hu v hv q hq with
        ⟨z, hzq, hzEssential⟩
      have hzTerminal : z ∈ X.toWarp.terminalSet :=
        essentialVertices_subset G B X.toWarp.terminalSet hzEssential
      change ∃ b : A, (X.path b).1.terminal? = some z at hzTerminal
      rcases hzTerminal with ⟨b, hbz⟩
      have hba : b ≠ a := by
        intro hba
        subst b
        exact ha ⟨z, hbz, hzEssential⟩
      exact ⟨z, hzq, ⟨⟨b, hba⟩, hbz⟩⟩
  have hRclean : R.IsSourceClean A :=
    X.isSourceClean.restrictIndices I
  have haInitial : (a : V) ∈ R.initialSet :=
    hG R hRwave hRclean a.property
  change ∃ b : {b : A // b ∈ I},
    (X.path b.1).1.initial = (a : V) at haInitial
  rcases haInitial with ⟨b, hbaInitial⟩
  have hba : (b.1 : V) = a := by
    calc
      (b.1 : V) = (X.path b.1).1.initial := (X.path_initial b.1).symm
      _ = a := hbaInitial
  apply b.2
  exact Subtype.ext hba

/-- Clean unhinderedness is exactly the assertion that every component of
every total wave is essential.  The reverse direction totalizes a clean
hindrance.  A missing source receives a singleton component, but the old
hindrance terminals already separate that source from `B`, so that singleton
cannot be essential. -/
theorem isCleanUnhindered_iff_forall_totalWave_essentialSources_eq_univ
    {V : Type} {G : SimpleGraph V} {A B : Set V} :
    IsCleanUnhindered G A B ↔
      ∀ X : TotalWave G A B, X.essentialSources = Set.univ := by
  constructor
  · intro hG X
    exact essentialSources_eq_univ_of_isCleanUnhindered hG X
  · intro hall
    rw [isCleanUnhindered_iff_no_cleanHindrance]
    intro W hW
    rcases hW with ⟨⟨hWwave, hWmiss⟩, hWclean⟩
    rcases Set.not_subset.mp hWmiss with ⟨a, haA, haMissing⟩
    let a₀ : A := ⟨a, haA⟩
    let X : TotalWave G A B := hWwave.toTotalWave hWclean
    have haEssential : a₀ ∈ X.essentialSources := by
      rw [hall X]
      exact Set.mem_univ a₀
    rcases haEssential with ⟨t, htX, htEssential⟩
    have hpathTerminal : (X.path a₀).1.terminal? = some a := by
      simp [X, IsWave.toTotalWave, LongPath.toNormalized, a₀,
        W.sourcePath_of_not_mem A a₀ haMissing]
    have hta : t = a :=
      Option.some.inj (htX.symm.trans hpathTerminal)
    subst t
    rcases mem_essentialVertices_iff.mp htEssential with
      ⟨-, b, hb, q, hq, hqOnlyX⟩
    rcases hWwave.2 a haA b hb q hq with ⟨z, hzq, hzWTerminal⟩
    have hzXTerminal : z ∈ X.toWarp.terminalSet := by
      rcases hzWTerminal with ⟨i, hiz⟩
      let i₀ : A := ⟨(W.path i).initial, hWwave.1 ⟨i, rfl⟩⟩
      refine ⟨i₀, ?_⟩
      change (X.path i₀).1.terminal? = some z
      simp only [X, IsWave.toTotalWave, LongPath.toNormalized,
        LongPath.terminal?_normalize]
      change (W.sourcePath A i₀).terminal? = some z
      rw [sourcePath_at_initial hWwave.1 i]
      exact hiz
    have hza : z = a := hqOnlyX z hzq hzXTerminal
    subst z
    apply haMissing
    rcases hzWTerminal with ⟨i, hiTerminal⟩
    have haOnPath : a ∈ (W.path i).vertexSet :=
      LongPath.terminal_mem_vertexSet hiTerminal
    exact ⟨i, (hWclean i a haOnPath haA).symm⟩

/-- Replace one inessential component of a right-hand total wave by the
corresponding component of a left-hand prefix wave.  Removing an inessential
right terminal preserves separation, and the shorter left component only adds
its terminal back to the separator. -/
noncomputable def replaceInessentialPath {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X Y : TotalWave G A B) (hXY : X ≤ Y) (a : A)
    (ha : a ∉ Y.essentialSources) : TotalWave G A B := by
  classical
  let path : A → LongPath.NormalizedPath G :=
    fun b ↦ if b = a then X.path a else Y.path b
  have path_self : path a = X.path a := by
    simp only [path, if_pos rfl]
  have path_of_ne : ∀ {b : A}, b ≠ a → path b = Y.path b := by
    intro b hba
    simp only [path, if_neg hba]
  have hbase : ∀ b, ((trivial G A).path b).Forward (path b).1 := by
    intro b
    by_cases hba : b = a
    · subst b
      rw [path_self]
      exact X.baseForward a
    · rw [path_of_ne hba]
      exact Y.baseForward b
  have hdisjoint : Pairwise fun b c =>
      Disjoint ((path b).1.vertexSet) ((path c).1.vertexSet) := by
    intro b c hbc
    by_cases hba : b = a
    · subst b
      have hca : c ≠ a := by
        intro hca
        exact hbc (hca ▸ rfl)
      have hsub := (hXY a).vertexSet_subset
      have hd := Y.disjoint hca.symm
      rw [path_self, path_of_ne hca, Set.disjoint_left]
      change Disjoint (Y.path a).1.vertexSet (Y.path c).1.vertexSet at hd
      rw [Set.disjoint_left] at hd
      intro v hvb hvc
      apply hd (hsub ?_) hvc
      exact hvb
    · by_cases hca : c = a
      · subst c
        have hsub := (hXY a).vertexSet_subset
        have hd := Y.disjoint hba
        rw [path_of_ne hba, path_self, Set.disjoint_left]
        change Disjoint (Y.path b).1.vertexSet (Y.path a).1.vertexSet at hd
        rw [Set.disjoint_left] at hd
        intro v hvb hvc
        apply hd hvb (hsub ?_)
        exact hvc
      · rw [path_of_ne hba, path_of_ne hca]
        exact Y.disjoint hbc
  refine {
    path := path
    baseForward := hbase
    disjoint := hdisjoint
    isWave := ?_ }
  constructor
  · rintro v ⟨b, rfl⟩
    change A at b
    change (path b).1.initial ∈ A
    have hzero : longPathActive ((trivial G A).path b).terminalIndex 0 := by
      simp [trivial, LongPath.ofWalk, longPathActive]
    have hf := hbase b 0 hzero
    have hinitial : (path b).1.initial = (b : V) := by
      change (path b).1.vertex 0 = (b : V)
      calc
        (path b).1.vertex 0 = ((trivial G A).path b).vertex 0 := hf.2
        _ = (b : V) := by simp [trivial, LongPath.ofWalk]
    rw [hinitial]
    exact b.property
  · have hEssentialSeparates := essentialVertices_separates Y.isWave.2
    intro u hu v hv q hq
    rcases hEssentialSeparates u hu v hv q hq with
      ⟨z, hzq, hzEssential⟩
    refine ⟨z, hzq, ?_⟩
    have hzTerminal : z ∈ Y.toWarp.terminalSet :=
      essentialVertices_subset G B Y.toWarp.terminalSet hzEssential
    rcases hzTerminal with ⟨b, hbz⟩
    change A at b
    change (Y.path b).1.terminal? = some z at hbz
    have hba : b ≠ a := by
      intro hba
      subst b
      apply ha
      exact ⟨z, hbz, hzEssential⟩
    refine ⟨b, ?_⟩
    change (path b).1.terminal? = some z
    rw [path_of_ne hba]
    exact hbz

theorem le_replaceInessentialPath {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y) (a : A)
    (ha : a ∉ Y.essentialSources) :
    X ≤ replaceInessentialPath X Y hXY a ha := by
  classical
  intro b
  change A at b
  by_cases hba : b = a
  · subst b
    simpa [replaceInessentialPath] using
      (LongPath.Forward.refl (X.path a).1)
  · simp only [replaceInessentialPath]
    rw [if_neg hba]
    exact hXY b

@[simp] theorem replaceInessentialPath_path_self {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a : A) (ha : a ∉ Y.essentialSources) :
    (replaceInessentialPath X Y hXY a ha).path a = X.path a := by
  classical
  simp [replaceInessentialPath]

theorem replaceInessentialPath_path_of_ne {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a b : A) (ha : a ∉ Y.essentialSources)
    (hba : b ≠ a) :
    (replaceInessentialPath X Y hXY a ha).path b = Y.path b := by
  classical
  simp only [replaceInessentialPath]
  rw [if_neg hba]

/-- Reinterpret a total wave avoiding one vertex in the graph with that
vertex deleted.  The source set is unchanged: avoidance of the whole total
wave already implies that the deleted vertex is not a source. -/
noncomputable def toOutsideVertex {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) (x : V)
    (hx : x ∉ X.toWarp.vertexSet) :
    TotalWave (outsideGraph G {x}) A (B \ {x}) := by
  classical
  let outsidePath : ∀ a : A, ∀ v ∈ (X.path a).1.vertexSet, v ∉ ({x} : Set V) := by
    intro a v hv hvx
    apply hx
    have hvx' : v = x := Set.mem_singleton_iff.mp hvx
    exact hvx' ▸ ⟨a, hv⟩
  let path : A → LongPath.NormalizedPath (outsideGraph G {x}) := fun a ↦
    ⟨(X.path a).1.toOutsideGraph (outsidePath a), by
      intro n hn
      exact (X.path a).2 n hn⟩
  refine {
    path := path
    baseForward := ?_
    disjoint := ?_
    isWave := ?_ }
  · intro a n hn
    have hf := X.baseForward a n hn
    exact hf
  · intro a b hab
    simpa [path] using X.disjoint hab
  · constructor
    · rintro v ⟨a, rfl⟩
      change A at a
      change (path a).1.initial ∈ A
      have hstart : (path a).1.initial = (a : V) := by
        simpa [path] using X.path_initial a
      rw [hstart]
      exact a.property
    · intro u hu v hv q hq
      let qG : G.Walk u v := q.mapLe (outsideGraph_le G {x})
      have hqG : qG.IsPath := hq.mapLe (outsideGraph_le G {x})
      rcases X.isWave.2 u hu v hv.1 qG hqG with ⟨z, hzq, hzT⟩
      have hzq' : z ∈ q.support := by
        simpa [qG, Walk.support_mapLe_eq_support] using hzq
      rcases hzT with ⟨a, ha⟩
      change A at a
      change (X.path a).1.terminal? = some z at ha
      refine ⟨z, hzq', a, ?_⟩
      change (path a).1.terminal? = some z
      simpa [path] using ha

@[simp] theorem toOutsideVertex_path_mapLE {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) (x : V)
    (hx : x ∉ X.toWarp.vertexSet) (a : A) :
    (((toOutsideVertex X x hx).path a).1.mapLE
      (outsideGraph_le G {x})) = (X.path a).1 := by
  classical
  simp [toOutsideVertex]

@[simp] theorem toOutsideVertex_terminal {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) (x : V)
    (hx : x ∉ X.toWarp.vertexSet) (a : A) :
    ((toOutsideVertex X x hx).path a).1.terminal? =
      (X.path a).1.terminal? := by
  classical
  simp [toOutsideVertex]

/-- Regard the paths of a total wave in a spanning subgraph as paths in an
ambient graph, provided their (unchanged) terminal set separates the desired
ambient source and target sets. -/
noncomputable def mapLEOfSeparates {V : Type} {H G : SimpleGraph V}
    {A B C : Set V} (hHG : H ≤ G) (Y : TotalWave H A C)
    (hsep : Separates G A B Y.toWarp.terminalSet) :
    TotalWave G A B := by
  let path : A → LongPath.NormalizedPath G := fun a ↦
    ⟨(Y.path a).1.mapLE hHG, by
      intro n hn
      exact (Y.path a).2 n hn⟩
  refine {
    path := path
    baseForward := ?_
    disjoint := ?_
    isWave := ?_ }
  · intro a n hn
    exact Y.baseForward a n hn
  · intro a b hab
    simpa [path] using Y.disjoint hab
  · constructor
    · rintro v ⟨a, rfl⟩
      change A at a
      change (path a).1.initial ∈ A
      have hstart : (path a).1.initial = (a : V) := by
        simpa [path] using Y.path_initial a
      rw [hstart]
      exact a.property
    · intro u hu v hv q hq
      rcases hsep u hu v hv q hq with ⟨z, hzq, hzT⟩
      rcases hzT with ⟨a, ha⟩
      change A at a
      change (Y.path a).1.terminal? = some z at ha
      refine ⟨z, hzq, a, ?_⟩
      change (path a).1.terminal? = some z
      simpa [path] using ha

@[simp] theorem mapLEOfSeparates_path {V : Type} {H G : SimpleGraph V}
    {A B C : Set V} (hHG : H ≤ G) (Y : TotalWave H A C)
    (hsep : Separates G A B Y.toWarp.terminalSet) (a : A) :
    (mapLEOfSeparates hHG Y hsep).path a =
      ⟨(Y.path a).1.mapLE hHG, by
        intro n hn
        exact (Y.path a).2 n hn⟩ := by
  rfl

/-- Forget the target side of a total wave while retaining its paths
definitionally.  The empty target imposes no separation condition. -/
noncomputable def toEmptyTarget {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) : TotalWave G A ∅ where
  path := X.path
  baseForward := X.baseForward
  disjoint := X.disjoint
  isWave := ⟨X.isWave.1, by
    intro a ha b hb
    exact (Set.notMem_empty b hb).elim⟩

@[simp] theorem toEmptyTarget_path {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X : TotalWave G A B) (a : A) :
    (toEmptyTarget X).path a = X.path a := rfl

/-- Lift a total wave from a spanning subgraph to the ambient graph while
forgetting its target side.  This packages the same path family as a total
wave with empty target, so it can be used by the purely combinatorial
alternating-walk machinery before ambient separation has been established. -/
noncomputable def mapLEToEmptyTarget {V : Type} {H G : SimpleGraph V}
    {A C : Set V} (hHG : H ≤ G) (Y : TotalWave H A C) :
    TotalWave G A ∅ :=
  mapLEOfSeparates hHG Y (by
    intro a ha b hb
    exact (Set.notMem_empty b hb).elim)

@[simp] theorem mapLEToEmptyTarget_path {V : Type}
    {H G : SimpleGraph V} {A C : Set V} (hHG : H ≤ G)
    (Y : TotalWave H A C) (a : A) :
    (mapLEToEmptyTarget hHG Y).path a =
      ⟨(Y.path a).1.mapLE hHG, by
        intro n hn
        exact (Y.path a).2 n hn⟩ := by
  rfl

@[simp] theorem mapLEToEmptyTarget_toWarp {V : Type}
    {H G : SimpleGraph V} {A C : Set V} (hHG : H ≤ G)
    (Y : TotalWave H A C) :
    (mapLEToEmptyTarget hHG Y).toWarp = Y.toWarp.mapLE hHG := by
  rfl

theorem toEmptyTarget_le_mapLEToEmptyTarget_of_outside {V : Type}
    {G : SimpleGraph V} {A B : Set V} (X : TotalWave G A B)
    {x : V} (hx : x ∉ X.toWarp.vertexSet)
    (Y : TotalWave (outsideGraph G {x}) A (B \ {x}))
    (hXY : toOutsideVertex X x hx ≤ Y) :
    toEmptyTarget X ≤
      mapLEToEmptyTarget (outsideGraph_le G {x}) Y := by
  intro a n hn
  have h := hXY a n hn
  exact h

/-- `Y` is a good extension of `X` when no source essential for `X` becomes
inessential.  Essential sources can only disappear under forward extension,
so this inclusion is the substantive direction of equality. -/
def IsGoodExtension {V : Type} {G : SimpleGraph V} {A B : Set V}
    (X Y : TotalWave G A B) : Prop :=
  X ≤ Y ∧ X.essentialSources ⊆ Y.essentialSources

/-- A finite `(Y-X)`-alternating walk in the sense of Shafer Definition
3.8.  Darts outside `Y` are traversed forward; darts of `Y` are traversed
backward.  Repeated vertices are allowed only on `Y`, no unoriented edge is
repeated, and every positive-index visit to `Y` is incident with a `Y` edge
of the alternating walk. -/
def IsAlternatingWalk {V : Type} {G : SimpleGraph V} {A B : Set V}
    (X Y : TotalWave G A B) {t z : V} (R : G.Walk t z) : Prop :=
  (∀ v ∈ R.support, v ∈ X.toWarp.vertexSet →
      v ∈ X.toWarp.terminalSet) ∧
  (∀ d ∈ R.darts,
      d.symm ∈ Y.toWarp.dartSet ∨
        (d ∉ Y.toWarp.dartSet ∧ d.symm ∉ Y.toWarp.dartSet)) ∧
  (∀ i j, i ≤ R.length → j ≤ R.length → i ≠ j →
      R.getVert i = R.getVert j →
      R.getVert i ∈ Y.toWarp.vertexSet) ∧
  R.edges.Nodup ∧
  (∀ i, 0 < i → i ≤ R.length →
      R.getVert i ∈ Y.toWarp.vertexSet →
      s(R.getVert (i - 1), R.getVert i) ∈ Y.toWarp.edgeSet ∨
        (i < R.length ∧
          s(R.getVert i, R.getVert (i + 1)) ∈ Y.toWarp.edgeSet))

theorem isAlternatingWalk_nil {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X Y : TotalWave G A B) {t : V}
    (ht : t ∈ X.toWarp.terminalSet) :
    X.IsAlternatingWalk Y (.nil : G.Walk t t) := by
  refine ⟨?_, by simp, ?_, by simp, ?_⟩
  · intro v hv hvX
    simp only [Walk.support_nil, List.mem_singleton] at hv
    subst v
    exact ht
  · intro i j hi hj hij heq
    simp at hi hj
    exact (hij (by omega)).elim
  · intro i hi hile
    simp at hile
    omega

/-- A simple path starting at a left terminal and otherwise avoiding the
right warp is alternating: all of its darts are external, and simplicity
discharges both repetition conditions. -/
theorem isAlternatingWalk_of_isPath_of_avoids_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} (hXY : X ≤ Y) (htX : t ∈ X.toWarp.terminalSet)
    (q : G.Walk t z) (hq : q.IsPath)
    (havoid : ∀ v ∈ q.support,
      v ∈ Y.toWarp.vertexSet → v = t) :
    X.IsAlternatingWalk Y q := by
  classical
  refine ⟨?_, ?_, ?_, hq.isTrail.edges_nodup, ?_⟩
  · intro v hvq hvX
    have hvY : v ∈ Y.toWarp.vertexSet :=
      WaveExtension.vertexSet_subset_of_le hXY hvX
    exact (havoid v hvq hvY) ▸ htX
  · intro d hdq
    right
    constructor
    · intro hdY
      have hfstY := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hdY
      have hsndY := Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hdY
      have hfst : d.fst = t :=
        havoid d.fst (q.dart_fst_mem_support_of_mem_darts hdq) hfstY
      have hsnd : d.snd = t :=
        havoid d.snd (q.dart_snd_mem_support_of_mem_darts hdq) hsndY
      exact d.fst_ne_snd (hfst.trans hsnd.symm)
    · intro hdY
      have hfstY := Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hdY
      have hsndY := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hdY
      have hfst : d.fst = t :=
        havoid d.fst (q.dart_fst_mem_support_of_mem_darts hdq) hfstY
      have hsnd : d.snd = t :=
        havoid d.snd (q.dart_snd_mem_support_of_mem_darts hdq) hsndY
      exact d.fst_ne_snd (hfst.trans hsnd.symm)
  · intro i j hi hj hij heq
    exact (hij (hq.getVert_injOn hi hj heq)).elim
  · intro i hi0 hile hiY
    have hit : q.getVert i = t :=
      havoid (q.getVert i) (q.getVert_mem_support i) hiY
    have hzero : q.getVert 0 = t := q.getVert_zero
    have hiEq : i = 0 := hq.getVert_injOn hile
      (Nat.zero_le q.length) (hit.trans hzero.symm)
    omega

/-- Alternation is invariant under reinterpreting all paths and the walk in
a supergraph. -/
theorem IsAlternatingWalk.mapLEToEmptyTarget {V : Type}
    {H G : SimpleGraph V} {A C : Set V}
    {X Y : TotalWave H A C} {t z : V} {R : H.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (hHG : H ≤ G) :
    (mapLEToEmptyTarget hHG X).IsAlternatingWalk
      (mapLEToEmptyTarget hHG Y) (R.mapLe hHG) := by
  classical
  rw [IsAlternatingWalk, mapLEToEmptyTarget_toWarp,
    mapLEToEmptyTarget_toWarp]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro v hvR hvX
    have hvR' : v ∈ R.support := by
      simpa [Walk.support_mapLe_eq_support] using hvR
    have hvX' : v ∈ X.toWarp.vertexSet := by
      simpa using hvX
    have hvT := hR.1 v hvR' hvX'
    simpa using hvT
  · intro d hdR
    rw [Walk.darts_map] at hdR
    rcases List.mem_map.mp hdR with ⟨e, heR, hed⟩
    have hedProd : e.toProd = d.toProd := by
      simpa using congrArg Dart.toProd hed
    rcases hR.2.1 e heR with heBack | heOutside
    · left
      apply (Warp.mem_dartSet_mapLE_iff hHG Y.toWarp d.symm).mpr
      refine ⟨e.symm, heBack, ?_⟩
      change e.toProd.swap = d.toProd.swap
      exact congrArg Prod.swap hedProd
    · right
      constructor
      · intro hdY
        rcases (Warp.mem_dartSet_mapLE_iff hHG Y.toWarp d).mp hdY with
          ⟨f, hfY, hfd⟩
        have hfe : f = e := Dart.ext _ _ (hfd.trans hedProd.symm)
        exact heOutside.1 (hfe ▸ hfY)
      · intro hdY
        rcases (Warp.mem_dartSet_mapLE_iff hHG Y.toWarp d.symm).mp hdY with
          ⟨f, hfY, hfd⟩
        have hfe : f = e.symm := by
          apply Dart.ext
          change f.toProd = e.toProd.swap
          exact hfd.trans (congrArg Prod.swap hedProd).symm
        exact heOutside.2 (hfe ▸ hfY)
  · intro i j hi hj hij heq
    have hi' : i ≤ R.length := by simpa [Walk.length_mapLe] using hi
    have hj' : j ≤ R.length := by simpa [Walk.length_mapLe] using hj
    have heq' : R.getVert i = R.getVert j := by simpa using heq
    have hv := hR.2.2.1 i j hi' hj' hij heq'
    simpa using hv
  · simpa [Walk.edges_mapLe_eq_edges] using hR.2.2.2.1
  · intro i hi0 hile hiY
    have hile' : i ≤ R.length := by
      simpa [Walk.length_mapLe] using hile
    have hiY' : R.getVert i ∈ Y.toWarp.vertexSet := by
      simpa using hiY
    rcases hR.2.2.2.2 i hi0 hile' hiY' with hprev | hnext
    · left
      simpa [Warp.edgeSet_mapLE] using hprev
    · right
      refine ⟨?_, ?_⟩
      · simpa [Walk.length_mapLe] using hnext.1
      · simpa [Warp.edgeSet_mapLE] using hnext.2

/-- Copying the endpoint indices of a walk does not change whether it is
alternating. -/
theorem IsAlternatingWalk.copy {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} {t z t' z' : V}
    {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (ht : t = t') (hz : z = z') :
    X.IsAlternatingWalk Y (R.copy ht hz) := by
  simpa [IsAlternatingWalk] using hR

/-- Append a continuation whose new part satisfies the five local
alternating-walk conditions.  This is the bookkeeping lemma used twice in
Shafer's last-contact argument: first for a backwards segment of a `Y` path,
and then for an outside segment followed by one backwards `Y` edge. -/
theorem IsAlternatingWalk.append_of_compatible {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z w : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (q : G.Walk z w)
    (hXq : ∀ v ∈ q.support, v ∈ X.toWarp.vertexSet →
      v ∈ X.toWarp.terminalSet)
    (hdartq : ∀ d ∈ q.darts,
      d.symm ∈ Y.toWarp.dartSet ∨
        (d ∉ Y.toWarp.dartSet ∧ d.symm ∉ Y.toWarp.dartSet))
    (hrepeatq : ∀ i j, i ≤ q.length → j ≤ q.length → i ≠ j →
      q.getVert i = q.getVert j →
      q.getVert i ∈ Y.toWarp.vertexSet)
    (hcross : ∀ v ∈ R.support, v ∈ q.support.tail →
      v ∈ Y.toWarp.vertexSet)
    (hedgesq : q.edges.Nodup)
    (hedgesCross : R.edges.Disjoint q.edges)
    (hincidentq : ∀ i, 0 < i → i ≤ q.length →
      q.getVert i ∈ Y.toWarp.vertexSet →
      s(q.getVert (i - 1), q.getVert i) ∈ Y.toWarp.edgeSet ∨
        (i < q.length ∧
          s(q.getVert i, q.getVert (i + 1)) ∈ Y.toWarp.edgeSet)) :
    X.IsAlternatingWalk Y (R.append q) := by
  classical
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro v hv hvX
    rcases (Walk.mem_support_append_iff R q).mp hv with hvR | hvq
    · exact hR.1 v hvR hvX
    · exact hXq v hvq hvX
  · intro d hd
    rw [Walk.darts_append] at hd
    rcases List.mem_append.mp hd with hdR | hdq
    · exact hR.2.1 d hdR
    · exact hdartq d hdq
  · intro i j hi hj hij heq
    rw [Walk.length_append] at hi hj
    by_cases hiR : i ≤ R.length
    · by_cases hjR : j ≤ R.length
      · have heqR : R.getVert i = R.getVert j := by
          simpa [Walk.getVert_append', hiR, hjR] using heq
        have hmem := hR.2.2.1 i j hiR hjR hij heqR
        simpa [Walk.getVert_append', hiR] using hmem
      · have hjNew : R.length < j := Nat.lt_of_not_ge hjR
        have hviR : R.getVert i ∈ R.support := Walk.getVert_mem_support _ _
        have hvjq : q.getVert (j - R.length) ∈ q.support.tail := by
          apply q.getVert_mem_tail_support
          · exact Walk.not_nil_iff_lt_length.mpr (by omega)
          · omega
        have heq' : R.getVert i = q.getVert (j - R.length) := by
          simpa [Walk.getVert_append', hiR, show ¬ j ≤ R.length by omega]
            using heq
        have hmem := hcross (R.getVert i) hviR (heq'.symm ▸ hvjq)
        simpa [Walk.getVert_append', hiR] using hmem
    · have hiNew : R.length < i := Nat.lt_of_not_ge hiR
      by_cases hjR : j ≤ R.length
      · have hviq : q.getVert (i - R.length) ∈ q.support.tail := by
          apply q.getVert_mem_tail_support
          · exact Walk.not_nil_iff_lt_length.mpr (by omega)
          · omega
        have hvjR : R.getVert j ∈ R.support := Walk.getVert_mem_support _ _
        have heq' : q.getVert (i - R.length) = R.getVert j := by
          simpa [Walk.getVert_append', show ¬ i ≤ R.length by omega, hjR]
            using heq
        have hmem := hcross (R.getVert j) hvjR
          (heq'.symm ▸ hviq)
        simpa [Walk.getVert_append', show ¬ i ≤ R.length by omega]
          using (heq'.symm ▸ hmem)
      · have hjNew : R.length < j := Nat.lt_of_not_ge hjR
        have hiq : i - R.length ≤ q.length := by omega
        have hjq : j - R.length ≤ q.length := by omega
        have hne : i - R.length ≠ j - R.length := by omega
        have heqq : q.getVert (i - R.length) =
            q.getVert (j - R.length) := by
          simpa [Walk.getVert_append', show ¬ i ≤ R.length by omega,
            show ¬ j ≤ R.length by omega] using heq
        have hmem := hrepeatq (i - R.length) (j - R.length)
          hiq hjq hne heqq
        simpa [Walk.getVert_append', show ¬ i ≤ R.length by omega]
          using hmem
  · rw [Walk.edges_append]
    exact List.nodup_append'.mpr ⟨hR.2.2.2.1, hedgesq, hedgesCross⟩
  · intro i hi0 hi hYi
    rw [Walk.length_append] at hi
    by_cases hiR : i ≤ R.length
    · have hYiR : R.getVert i ∈ Y.toWarp.vertexSet := by
        simpa [Walk.getVert_append', hiR] using hYi
      rcases hR.2.2.2.2 i hi0 hiR hYiR with hprev | hnext
      · left
        simpa [Walk.getVert_append', hiR,
          show i - 1 ≤ R.length by omega] using hprev
      · right
        refine ⟨?_, ?_⟩
        · rw [Walk.length_append]
          omega
        simpa [Walk.getVert_append', hiR,
          show i + 1 ≤ R.length by omega] using hnext.2
    · have hiNew : R.length < i := Nat.lt_of_not_ge hiR
      let k := i - R.length
      have hk0 : 0 < k := by omega
      have hkq : k ≤ q.length := by omega
      have hYk : q.getVert k ∈ Y.toWarp.vertexSet := by
        simpa [k, Walk.getVert_append, show ¬ i < R.length by omega]
          using hYi
      rcases hincidentq k hk0 hkq hYk with hprev | hnext
      · left
        have hprevIdx : i - 1 - R.length = k - 1 := by omega
        simpa [k, Walk.getVert_append, show ¬ i < R.length by omega,
          show ¬ i - 1 < R.length by omega, hprevIdx] using hprev
      · right
        refine ⟨?_, ?_⟩
        · rw [Walk.length_append]
          omega
        have hnextIdx : i + 1 - R.length = k + 1 := by omega
        simpa [k, Walk.getVert_append, show ¬ i < R.length by omega,
          show ¬ i + 1 < R.length by omega, hnextIdx] using hnext.2

/-- A backwards segment of one component of `Y` may be appended to an
alternating walk, provided its new edges have not already been used and its
vertices meet `X` only at terminals. -/
theorem IsAlternatingWalk.append_reverse_segment {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t : V} {a : A} {n m : ℕ}
    (hm : longPathActive (Y.path a).1.terminalIndex m) (hnm : n ≤ m)
    {R : G.Walk t ((Y.path a).1.vertex m)}
    (hR : X.IsAlternatingWalk Y R)
    (hXsegment : ∀ k, n ≤ k → k ≤ m →
      (Y.path a).1.vertex k ∈ X.toWarp.vertexSet →
      (Y.path a).1.vertex k ∈ X.toWarp.terminalSet)
    (hedgesCross : R.edges.Disjoint
      ((Y.path a).1.segmentWalk hm hnm).reverse.edges) :
    X.IsAlternatingWalk Y
      (R.append ((Y.path a).1.segmentWalk hm hnm).reverse) := by
  classical
  let q := ((Y.path a).1.segmentWalk hm hnm).reverse
  have hqPath : q.IsPath := ((Y.path a).1.segmentWalk_isPath hm hnm).reverse
  have hqVertex (i : ℕ) (hi : i ≤ q.length) :
      q.getVert i ∈ Y.toWarp.vertexSet := by
    refine ⟨a, m - i, LongPath.active_mono ?_ hm, ?_⟩
    · omega
    · exact (((Y.path a).1.reverse_segmentWalk_getVert hm hnm (by
          simpa [q] using hi))).symm
  have hqDart (d : G.Dart) (hd : d ∈ q.darts) :
      d.symm ∈ Y.toWarp.dartSet := by
    have hds : d.symm ∈ ((Y.path a).1.segmentWalk hm hnm).darts := by
      simpa [q, Walk.mem_darts_reverse] using hd
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert
      ((Y.path a).1.segmentWalk hm hnm)).mp hds with ⟨i, hi, hdi⟩
    have hilength : i < m - n := by
      simpa using hi
    refine ⟨a, n + i, LongPath.active_mono (by omega) hm, ?_⟩
    calc
      d.symm.toProd =
          (((Y.path a).1.segmentWalk hm hnm).getVert i,
            ((Y.path a).1.segmentWalk hm hnm).getVert (i + 1)) := hdi
      _ = ((Y.path a).1.vertex (n + i),
          (Y.path a).1.vertex (n + i + 1)) := by
        rw [(Y.path a).1.getVert_segmentWalk hm hnm (by omega),
          (Y.path a).1.getVert_segmentWalk hm hnm (by omega)]
        congr 2 <;> omega
  apply hR.append_of_compatible q
  · intro v hv hvX
    rw [show q.support =
        ((Y.path a).1.segmentWalk hm hnm).support.reverse by simp [q]] at hv
    have hv' : v ∈ ((Y.path a).1.segmentWalk hm hnm).support := by
      simpa using hv
    rcases ((Y.path a).1.mem_support_segmentWalk_iff hm hnm).mp hv' with
      ⟨k, hnk, hkm, hkv⟩
    exact hkv.symm ▸ hXsegment k hnk hkm (hkv ▸ hvX)
  · intro d hd
    exact Or.inl (hqDart d hd)
  · intro i j hi hj hij heq
    exact (hij (hqPath.getVert_injOn hi hj heq)).elim
  · intro v hvR hvq
    rcases Walk.mem_support_iff_exists_getVert.mp
        (List.mem_of_mem_tail hvq) with ⟨i, hiv, hi⟩
    exact hiv.symm ▸ hqVertex i hi
  · exact hqPath.isTrail.edges_nodup
  · exact hedgesCross
  · intro i hi0 hi hYi
    left
    have hilast : i - 1 < q.length := by omega
    let d : G.Dart := q.darts[i - 1]'(by simpa using hilast)
    have hdq : d ∈ q.darts := List.getElem_mem ..
    refine (Y.toWarp.mem_edgeSet_iff).mpr ⟨d.symm, hqDart d hdq, ?_⟩
    have hdedge : d.edge = s(q.getVert (i - 1), q.getVert i) := by
      calc
        d.edge = (q.darts[i - 1]'(by simpa using hilast)).edge := rfl
        _ = q.edges[i - 1]'(by simpa using hilast) :=
          Walk.edge_getElem_darts (p := q) (i := i - 1)
            (by simpa using hilast)
        _ = s(q.getVert (i - 1), q.getVert i) := by
          rw [Walk.getElem_edges]
          congr 2
          omega
    simpa [hdedge]

/-- A prefix of an alternating walk is alternating when it is trivial or
its last edge belongs to `Y`.  All conditions are inherited; the hypothesis
is exactly what supplies condition (vii) at the new endpoint. -/
theorem IsAlternatingWalk.take_of_zero_or_previous_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (i : ℕ) (hi : i ≤ R.length)
    (hend : i = 0 ∨ R.getVert i ∉ Y.toWarp.vertexSet ∨
      s(R.getVert (i - 1), R.getVert i) ∈ Y.toWarp.edgeSet) :
    X.IsAlternatingWalk Y (R.take i) := by
  classical
  have hlength : (R.take i).length = i := by simp [hi]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro v hv hvX
    rw [Walk.support_take] at hv
    exact hR.1 v (List.mem_of_mem_take hv) hvX
  · intro d hd
    rw [Walk.darts_take] at hd
    exact hR.2.1 d (List.mem_of_mem_take hd)
  · intro j k hj hk hjk heq
    rw [hlength] at hj hk
    have heqR : R.getVert j = R.getVert k := by
      simpa [Walk.take_getVert, Nat.min_eq_right hj,
        Nat.min_eq_right hk] using heq
    have hmem := hR.2.2.1 j k (hj.trans hi) (hk.trans hi) hjk heqR
    simpa [Walk.take_getVert, Nat.min_eq_right hj] using hmem
  · rw [Walk.edges_take]
    exact hR.2.2.2.1.take
  · intro j hj0 hj hYj
    rw [hlength] at hj
    have hget (k : ℕ) (hk : k ≤ i) :
        (R.take i).getVert k = R.getVert k := by
      simp [Walk.take_getVert, Nat.min_eq_right hk]
    have hYjR : R.getVert j ∈ Y.toWarp.vertexSet := by
      simpa [hget j hj] using hYj
    rcases Nat.lt_or_eq_of_le hj with hji | rfl
    · rcases hR.2.2.2.2 j hj0 (hj.trans hi) hYjR with
        hprev | hnext
      · left
        simpa [hget j hj, hget (j - 1) (by omega)] using hprev
      · right
        refine ⟨by simpa [hlength] using hji, ?_⟩
        simpa [hget j hj, hget (j + 1) (by omega)] using hnext.2
    · rcases hend with hiZero | hiOutside | hprev
      · subst j
        omega
      · exact (hiOutside hYjR).elim
      · left
        simpa [hget j le_rfl, hget (j - 1) (by omega)] using hprev

/-- Before the first visit to the strict suffix `(n,k]` of a `Y` component,
the used prefix edges are disjoint from the backwards segment `[n,k]`.
Indeed, any common edge is traversed backwards in both walks, and its tail is
a strict-suffix vertex occurring before the alleged first visit. -/
theorem IsAlternatingWalk.edges_take_disjoint_reverse_segment_of_first
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (a : A) {n k i : ℕ}
    (hk : longPathActive (Y.path a).1.terminalIndex k) (hnk : n ≤ k)
    (hi : i ≤ R.length)
    (hfirst : ∀ j, j < i → ∀ r, n < r → r ≤ k →
      R.getVert j ≠ (Y.path a).1.vertex r) :
    (R.take i).edges.Disjoint
      ((Y.path a).1.segmentWalk hk hnk).reverse.edges := by
  classical
  rw [List.disjoint_left]
  intro e heR heSeg
  rw [Walk.edges_eq_map_darts, List.mem_map] at heR heSeg
  rcases heR with ⟨dR, hdRTake, hdREdge⟩
  rcases heSeg with ⟨dS, hdSSeg, hdSEdge⟩
  have hdRFull : dR ∈ R.darts := by
    rw [Walk.darts_take] at hdRTake
    exact List.mem_of_mem_take hdRTake
  have hdSSymmY : dS.symm ∈ Y.toWarp.dartSet := by
    have hdForward : dS.symm ∈
        ((Y.path a).1.segmentWalk hk hnk).darts := by
      simpa [Walk.mem_darts_reverse] using hdSSeg
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert
      ((Y.path a).1.segmentWalk hk hnk)).mp hdForward with
      ⟨j, hj, hdj⟩
    have hjlt : j < k - n := by simpa using hj
    refine ⟨a, n + j, LongPath.active_mono (by omega) hk, ?_⟩
    calc
      dS.symm.toProd =
          (((Y.path a).1.segmentWalk hk hnk).getVert j,
            ((Y.path a).1.segmentWalk hk hnk).getVert (j + 1)) := hdj
      _ = ((Y.path a).1.vertex (n + j),
          (Y.path a).1.vertex (n + j + 1)) := by
        rw [(Y.path a).1.getVert_segmentWalk hk hnk (by omega),
          (Y.path a).1.getVert_segmentWalk hk hnk (by omega)]
        congr 2 <;> omega
  have hdSEdgeY : dS.edge ∈ Y.toWarp.edgeSet :=
    (Y.toWarp.mem_edgeSet_iff).mpr ⟨dS.symm, hdSSymmY, by simp⟩
  have hdREdgeY : dR.edge ∈ Y.toWarp.edgeSet := by
    exact hdREdge ▸ (hdSEdge ▸ hdSEdgeY)
  have hdRSymmY : dR.symm ∈ Y.toWarp.dartSet :=
    by
      rcases hR.2.1 dR hdRFull with hreverse | hexternal
      · exact hreverse
      · rcases (Y.toWarp.mem_edgeSet_iff).mp hdREdgeY with
          ⟨d, hdY, hedge⟩
        rcases (dart_edge_eq_iff d dR).mp hedge with heq | heq
        · exact (hexternal.1 (heq ▸ hdY)).elim
        · exact (hexternal.2 (by simpa [heq] using hdY)).elim
  have hsymmEq : dR.symm = dS.symm := by
    have hedge : dR.symm.edge = dS.symm.edge := by
      simpa [hdREdge, hdSEdge]
    rcases (dart_edge_eq_iff dR.symm dS.symm).mp hedge with heq | heq
    · exact heq
    · exact (Y.toWarp.symm_not_mem_dartSet hdRSymmY
        (by simpa [heq] using hdSSymmY)).elim
  have hdEq : dR = dS := by
    have := congrArg Dart.symm hsymmEq
    simpa using this
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert
    ((Y.path a).1.segmentWalk hk hnk).reverse).mp hdSSeg with
    ⟨s, hslt, hds⟩
  have hslt' : s < k - n := by simpa using hslt
  let r := k - s
  have hnr : n < r := by omega
  have hrk : r ≤ k := by omega
  have hdSFst : dS.fst = (Y.path a).1.vertex r := by
    have hfst : dS.fst =
        ((Y.path a).1.segmentWalk hk hnk).reverse.getVert s :=
      congrArg Prod.fst hds
    exact hfst.trans ((Y.path a).1.reverse_segmentWalk_getVert hk hnk
      (Nat.le_of_lt hslt'))
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert (R.take i)).mp
      hdRTake with ⟨j, hjlt, hdj⟩
  have hjlt' : j < i := by simpa [hi] using hjlt
  have hdRFst : dR.fst = R.getVert j := by
    have := congrArg Prod.fst hdj
    simpa [Walk.take_getVert, Nat.min_eq_right (Nat.le_of_lt hjlt')]
      using this
  exact hfirst j hjlt' r hnr hrk <| by
    calc
      R.getVert j = dR.fst := hdRFst.symm
      _ = dS.fst := congrArg (fun d : G.Dart => d.fst) hdEq
      _ = (Y.path a).1.vertex r := hdSFst

theorem IsAlternatingWalk.dart_not_mem_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {d : G.Dart} (hd : d ∈ R.darts) :
    d ∉ Y.toWarp.dartSet := by
  rcases hR.2.1 d hd with hreverse | hexternal
  · have hnot := Y.toWarp.symm_not_mem_dartSet hreverse
    simpa using hnot
  · exact hexternal.1

theorem IsAlternatingWalk.symm_mem_right_iff_edge_mem {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {d : G.Dart} (hd : d ∈ R.darts) :
    d.symm ∈ Y.toWarp.dartSet ↔ d.edge ∈ Y.toWarp.edgeSet := by
  constructor
  · intro hsymm
    exact ⟨d.symm, hsymm, by simp⟩
  · rintro ⟨e, heY, hed⟩
    have heq : e = d ∨ e = d.symm :=
      (dart_edge_eq_iff e d).mp hed
    rcases heq with rfl | heq
    · exact (hR.dart_not_mem_right hd heY).elim
    · simpa [heq] using heY

theorem IsAlternatingWalk.symm_not_mem_darts {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {d : G.Dart} (hd : d ∈ R.darts) : d.symm ∉ R.darts := by
  intro hdsymm
  have hnodup := hR.2.2.2.1
  change (R.darts.map Dart.edge).Nodup at hnodup
  have hinj := List.inj_on_of_nodup_map hnodup hd hdsymm
    (by simp : d.edge = d.symm.edge)
  exact d.symm_ne hinj.symm

theorem IsAlternatingWalk.index_eq_of_darts_getElem_eq {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {i j : ℕ} (hi : i < R.length) (hj : j < R.length)
    (hij : R.darts[i]'(by simpa using hi) =
      R.darts[j]'(by simpa using hj)) : i = j := by
  have hedge : R.edges[i]'(by simpa using hi) =
      R.edges[j]'(by simpa using hj) := by
    calc
      R.edges[i]'(by simpa using hi) =
          (R.darts[i]'(by simpa using hi)).edge :=
        (Walk.edge_getElem_darts (p := R) (i := i)
          (by simpa using hi)).symm
      _ = (R.darts[j]'(by simpa using hj)).edge :=
        congrArg Dart.edge hij
      _ = R.edges[j]'(by simpa using hj) :=
        Walk.edge_getElem_darts (p := R) (i := j) (by simpa using hj)
  exact hR.2.2.2.1.getElem_inj_iff.mp hedge

/-- The oriented symmetric-difference construction from Shafer Lemma 3.10:
delete a `Y` dart when `R` traverses it backwards, and insert an `R` dart
when its underlying edge is outside `Y`. -/
def toggleDartSet {V : Type} {G : SimpleGraph V} {A B : Set V}
    (Y : TotalWave G A B) {t z : V} (R : G.Walk t z) : Set G.Dart :=
  {d | (d ∈ Y.toWarp.dartSet ∧ d.symm ∉ R.darts) ∨
    (d ∈ R.darts ∧ d.symm ∉ Y.toWarp.dartSet)}

theorem IsAlternatingWalk.mem_toggleDartSet_of_external {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {d : G.Dart} (hd : d ∈ R.darts)
    (hexternal : d.symm ∉ Y.toWarp.dartSet) :
    d ∈ Y.toggleDartSet R := by
  exact Or.inr ⟨hd, hexternal⟩

theorem IsAlternatingWalk.reverse_not_mem_toggleDartSet {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {d : G.Dart} (hd : d ∈ R.darts)
    (hreverse : d.symm ∈ Y.toWarp.dartSet) :
    d.symm ∉ Y.toggleDartSet R := by
  rintro (hold | hnew)
  · exact hold.2 (by simpa using hd)
  · exact hR.symm_not_mem_darts hd hnew.1

theorem mem_toggleDartSet_of_right_of_not_reverse_walk {V : Type}
    {G : SimpleGraph V} {A B : Set V} {Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} {d : G.Dart}
    (hdY : d ∈ Y.toWarp.dartSet) (hdR : d.symm ∉ R.darts) :
    d ∈ Y.toggleDartSet R := by
  exact Or.inl ⟨hdY, hdR⟩

/-- If an alternating walk leaves a vertex of `Y` along an edge outside
`Y`, then (away from the initial vertex) it entered that vertex by
traversing a dart of `Y` backwards. -/
theorem IsAlternatingWalk.previous_symm_mem_right_of_external {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {i : ℕ} (hi0 : 0 < i) (hi : i < R.length)
    (hiY : R.getVert i ∈ Y.toWarp.vertexSet)
    (hcurExternal :
      (R.darts[i]'(by simpa using hi)).symm ∉ Y.toWarp.dartSet) :
    (R.darts[i - 1]'(by simpa using (show i - 1 < R.length by omega))).symm ∈
      Y.toWarp.dartSet := by
  have hcurMem : R.darts[i]'(by simpa using hi) ∈ R.darts :=
    List.getElem_mem ..
  have hcurEdge :
      s(R.getVert i, R.getVert (i + 1)) ∉ Y.toWarp.edgeSet := by
    intro hedge
    have hedge' : (R.darts[i]'(by simpa using hi)).edge ∈
        Y.toWarp.edgeSet := by
      simpa [Walk.getElem_edges, Walk.edge_getElem_darts] using hedge
    exact hcurExternal ((hR.symm_mem_right_iff_edge_mem hcurMem).mpr hedge')
  have hprevEdge :
      s(R.getVert (i - 1), R.getVert i) ∈ Y.toWarp.edgeSet := by
    rcases hR.2.2.2.2 i hi0 (Nat.le_of_lt hi) hiY with hprev | hnext
    · exact hprev
    · exact (hcurEdge hnext.2).elim
  have hprevLt : i - 1 < R.length := by omega
  have hprevMem : R.darts[i - 1]'(by simpa using hprevLt) ∈ R.darts :=
    List.getElem_mem ..
  apply (hR.symm_mem_right_iff_edge_mem hprevMem).mpr
  have hedge :
      (R.darts[i - 1]'(by simpa using hprevLt)).edge =
        s(R.getVert (i - 1), R.getVert i) := by
    rw [Walk.edge_getElem_darts]
    rw [Walk.getElem_edges]
    congr 2
    omega
  rwa [hedge]

/-- Dually, if an alternating walk enters a vertex of `Y` along an edge
outside `Y`, then it leaves that vertex (unless it is the last vertex) by
traversing a dart of `Y` backwards. -/
theorem IsAlternatingWalk.next_symm_mem_right_of_external {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    {i : ℕ} (hi : i < R.length)
    (hsuccY : R.getVert (i + 1) ∈ Y.toWarp.vertexSet)
    (hcurExternal :
      (R.darts[i]'(by simpa using hi)).symm ∉ Y.toWarp.dartSet) :
    ∃ hnext : i + 1 < R.length,
      (R.darts[i + 1]'(by simpa using hnext)).symm ∈
        Y.toWarp.dartSet := by
  have hcurMem : R.darts[i]'(by simpa using hi) ∈ R.darts :=
    List.getElem_mem ..
  have hcurEdge :
      s(R.getVert i, R.getVert (i + 1)) ∉ Y.toWarp.edgeSet := by
    intro hedge
    have hedge' : (R.darts[i]'(by simpa using hi)).edge ∈
        Y.toWarp.edgeSet := by
      simpa [Walk.getElem_edges, Walk.edge_getElem_darts] using hedge
    exact hcurExternal ((hR.symm_mem_right_iff_edge_mem hcurMem).mpr hedge')
  have hincident := hR.2.2.2.2 (i + 1) (by omega)
    (by omega : i + 1 ≤ R.length) hsuccY
  rcases hincident with hprevious | hnext
  · exact (hcurEdge (by simpa using hprevious)).elim
  · refine ⟨hnext.1, ?_⟩
    have hnextMem :
        R.darts[i + 1]'(by simpa using hnext.1) ∈ R.darts :=
      List.getElem_mem ..
    apply (hR.symm_mem_right_iff_edge_mem hnextMem).mpr
    simpa [Walk.getElem_edges, Walk.edge_getElem_darts] using hnext.2

/-- At a common tail, a surviving dart of `Y` and a newly inserted
external dart of an alternating walk must be the same dart.  Otherwise the
previous reversed `Y` dart would either leave the starting terminal or be
the allegedly surviving dart that the walk deletes. -/
theorem IsAlternatingWalk.rightDart_eq_externalWalkDart_of_fst_eq
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    {d e : G.Dart} (hdY : d ∈ Y.toWarp.dartSet)
    (hdSurvives : d.symm ∉ R.darts) (heR : e ∈ R.darts)
    (heExternal : e.symm ∉ Y.toWarp.dartSet)
    (hfst : d.fst = e.fst) : d = e := by
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heR with
    ⟨i, hi, hie⟩
  have hielem : R.darts[i]'(by simpa using hi) = e := by
    apply Dart.ext
    calc
      (R.darts[i]'(by simpa using hi)).toProd =
          (R.getVert i, R.getVert (i + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert i (by simpa using hi))
      _ = e.toProd := hie.symm
  have heFst : e.fst = R.getVert i := congrArg Prod.fst hie
  have hiY : R.getVert i ∈ Y.toWarp.vertexSet := by
    have hdFst : d.fst ∈ Y.toWarp.vertexSet :=
      Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hdY
    simpa [hfst, heFst] using hdFst
  by_cases hi0 : i = 0
  · subst i
    have hdt : d.fst = t := by
      calc
        d.fst = e.fst := hfst
        _ = R.getVert 0 := heFst
        _ = t := R.getVert_zero
    exact (Y.toWarp.no_dart_from_terminal ht hdY hdt).elim
  · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
    have hprevious := hR.previous_symm_mem_right_of_external hiPos hi hiY
      (by simpa [hielem] using heExternal)
    have hprevLt : i - 1 < R.length := by omega
    let p : G.Dart := R.darts[i - 1]'(by simpa using hprevLt)
    have hpMem : p ∈ R.darts := List.getElem_mem ..
    have hpSymmY : p.symm ∈ Y.toWarp.dartSet := by
      simpa [p] using hprevious
    have hpSymmFst : p.symm.fst = d.fst := by
      calc
        p.symm.fst = R.getVert i := by
          change p.snd = R.getVert i
          dsimp [p]
          have hsnd := congrArg (fun q : G.Dart => q.snd)
            (R.darts_getElem_eq_getVert (i - 1) (by simpa using hprevLt))
          have hidx : i - 1 + 1 = i := by omega
          simpa only [hidx] using hsnd
        _ = e.fst := heFst.symm
        _ = d.fst := hfst.symm
    have heq : p.symm = d :=
      Y.toWarp.dart_eq_of_fst_eq hpSymmY hdY hpSymmFst
    have hdSymm : d.symm = p := by
      rw [← heq]
      simp
    exact (hdSurvives (hdSymm ▸ hpMem)).elim

/-- Two external darts inserted by an alternating walk cannot have the same
tail.  At distinct occurrences that common tail is a vertex of `Y`; the
forced predecessor darts of `Y` then coincide, contradicting the fact that
the alternating walk repeats no unoriented edge. -/
theorem IsAlternatingWalk.externalWalkDart_eq_of_fst_eq
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    {d e : G.Dart} (hdR : d ∈ R.darts)
    (hdExternal : d.symm ∉ Y.toWarp.dartSet) (heR : e ∈ R.darts)
    (heExternal : e.symm ∉ Y.toWarp.dartSet)
    (hfst : d.fst = e.fst) : d = e := by
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdR with
    ⟨i, hi, hid⟩
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heR with
    ⟨j, hj, hje⟩
  have hidelem : R.darts[i]'(by simpa using hi) = d := by
    apply Dart.ext
    calc
      (R.darts[i]'(by simpa using hi)).toProd =
          (R.getVert i, R.getVert (i + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert i (by simpa using hi))
      _ = d.toProd := hid.symm
  have hjelem : R.darts[j]'(by simpa using hj) = e := by
    apply Dart.ext
    calc
      (R.darts[j]'(by simpa using hj)).toProd =
          (R.getVert j, R.getVert (j + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert j (by simpa using hj))
      _ = e.toProd := hje.symm
  have hdFst : d.fst = R.getVert i := congrArg Prod.fst hid
  have heFst : e.fst = R.getVert j := congrArg Prod.fst hje
  by_cases hij : i = j
  · subst j
    exact hidelem.symm.trans hjelem
  · have hvertex : R.getVert i = R.getVert j := by
      calc
        R.getVert i = d.fst := hdFst.symm
        _ = e.fst := hfst
        _ = R.getVert j := heFst
    have hiY : R.getVert i ∈ Y.toWarp.vertexSet :=
      hR.2.2.1 i j (Nat.le_of_lt hi) (Nat.le_of_lt hj) hij hvertex
    have hjY : R.getVert j ∈ Y.toWarp.vertexSet := hvertex ▸ hiY
    by_cases hi0 : i = 0
    · subst i
      have hjPos : 0 < j := Nat.pos_of_ne_zero (Ne.symm hij)
      have hprevJ := hR.previous_symm_mem_right_of_external hjPos hj hjY
        (by simpa [hjelem] using heExternal)
      have hjPrevLt : j - 1 < R.length := by omega
      have hprevFst :
          (R.darts[j - 1]'(by simpa using hjPrevLt)).symm.fst = t := by
        change (R.darts[j - 1]'(by simpa using hjPrevLt)).snd = t
        have hsnd := congrArg (fun q : G.Dart => q.snd)
          (R.darts_getElem_eq_getVert (j - 1)
            (by simpa using hjPrevLt))
        have hidx : j - 1 + 1 = j := by omega
        have : (R.darts[j - 1]'(by simpa using hjPrevLt)).snd =
            R.getVert j := by simpa only [hidx] using hsnd
        calc
          (R.darts[j - 1]'(by simpa using hjPrevLt)).snd =
              R.getVert j := this
          _ = R.getVert 0 := hvertex.symm
          _ = t := R.getVert_zero
      exact (Y.toWarp.no_dart_from_terminal ht hprevJ hprevFst).elim
    · by_cases hj0 : j = 0
      · subst j
        have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
        have hprevI := hR.previous_symm_mem_right_of_external hiPos hi hiY
          (by simpa [hidelem] using hdExternal)
        have hiPrevLt : i - 1 < R.length := by omega
        have hprevFst :
            (R.darts[i - 1]'(by simpa using hiPrevLt)).symm.fst = t := by
          change (R.darts[i - 1]'(by simpa using hiPrevLt)).snd = t
          have hsnd := congrArg (fun q : G.Dart => q.snd)
            (R.darts_getElem_eq_getVert (i - 1)
              (by simpa using hiPrevLt))
          have hidx : i - 1 + 1 = i := by omega
          have : (R.darts[i - 1]'(by simpa using hiPrevLt)).snd =
              R.getVert i := by simpa only [hidx] using hsnd
          calc
            (R.darts[i - 1]'(by simpa using hiPrevLt)).snd =
                R.getVert i := this
            _ = R.getVert 0 := hvertex
            _ = t := R.getVert_zero
        exact (Y.toWarp.no_dart_from_terminal ht hprevI hprevFst).elim
      · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
        have hjPos : 0 < j := Nat.pos_of_ne_zero hj0
        have hprevI := hR.previous_symm_mem_right_of_external hiPos hi hiY
          (by simpa [hidelem] using hdExternal)
        have hprevJ := hR.previous_symm_mem_right_of_external hjPos hj hjY
          (by simpa [hjelem] using heExternal)
        have hiPrevLt : i - 1 < R.length := by omega
        have hjPrevLt : j - 1 < R.length := by omega
        have hprevIFst :
            (R.darts[i - 1]'(by simpa using hiPrevLt)).symm.fst =
              R.getVert i := by
          change (R.darts[i - 1]'(by simpa using hiPrevLt)).snd =
            R.getVert i
          have hsnd := congrArg (fun q : G.Dart => q.snd)
            (R.darts_getElem_eq_getVert (i - 1)
              (by simpa using hiPrevLt))
          have hidx : i - 1 + 1 = i := by omega
          simpa only [hidx] using hsnd
        have hprevJFst :
            (R.darts[j - 1]'(by simpa using hjPrevLt)).symm.fst =
              R.getVert j := by
          change (R.darts[j - 1]'(by simpa using hjPrevLt)).snd =
            R.getVert j
          have hsnd := congrArg (fun q : G.Dart => q.snd)
            (R.darts_getElem_eq_getVert (j - 1)
              (by simpa using hjPrevLt))
          have hidx : j - 1 + 1 = j := by omega
          simpa only [hidx] using hsnd
        have hsymmEq :
            (R.darts[i - 1]'(by simpa using hiPrevLt)).symm =
              (R.darts[j - 1]'(by simpa using hjPrevLt)).symm :=
          Y.toWarp.dart_eq_of_fst_eq hprevI hprevJ
            (hprevIFst.trans (hvertex.trans hprevJFst.symm))
        have hdartEq :
            R.darts[i - 1]'(by simpa using hiPrevLt) =
              R.darts[j - 1]'(by simpa using hjPrevLt) := by
          have := congrArg Dart.symm hsymmEq
          simpa using this
        have hedgeEq :
            R.edges[i - 1]'(by simpa using hiPrevLt) =
              R.edges[j - 1]'(by simpa using hjPrevLt) := by
          calc
            R.edges[i - 1]'(by simpa using hiPrevLt) =
                (R.darts[i - 1]'(by simpa using hiPrevLt)).edge :=
              (Walk.edge_getElem_darts
                (p := R) (i := i - 1) (by simpa using hiPrevLt)).symm
            _ = (R.darts[j - 1]'(by simpa using hjPrevLt)).edge :=
              congrArg Dart.edge hdartEq
            _ = R.edges[j - 1]'(by simpa using hjPrevLt) :=
              Walk.edge_getElem_darts
                (p := R) (i := j - 1) (by simpa using hjPrevLt)
        have hindex : i - 1 = j - 1 :=
          hR.2.2.2.1.getElem_inj_iff.mp hedgeEq
        exact (hij (by omega)).elim

/-- The toggled oriented edge set has outdegree at most one at every
vertex.  This is the outgoing-degree half of Shafer Lemma 3.10. -/
theorem IsAlternatingWalk.toggleDart_eq_of_fst_eq
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    {d e : G.Dart} (hd : d ∈ Y.toggleDartSet R)
    (he : e ∈ Y.toggleDartSet R) (hfst : d.fst = e.fst) : d = e := by
  rcases hd with hdOld | hdNew
  · rcases he with heOld | heNew
    · exact Y.toWarp.dart_eq_of_fst_eq hdOld.1 heOld.1 hfst
    · exact hR.rightDart_eq_externalWalkDart_of_fst_eq ht
        hdOld.1 hdOld.2 heNew.1 heNew.2 hfst
  · rcases he with heOld | heNew
    · exact (hR.rightDart_eq_externalWalkDart_of_fst_eq ht
        heOld.1 heOld.2 hdNew.1 hdNew.2 hfst.symm).symm
    · exact hR.externalWalkDart_eq_of_fst_eq ht
        hdNew.1 hdNew.2 heNew.1 heNew.2 hfst

/-- At a common head, a surviving dart of `Y` and a newly inserted
external dart coincide.  The forced following reversed `Y` dart would
otherwise be that surviving dart and hence delete it. -/
theorem IsAlternatingWalk.rightDart_eq_externalWalkDart_of_snd_eq
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R)
    {d e : G.Dart} (hdY : d ∈ Y.toWarp.dartSet)
    (hdSurvives : d.symm ∉ R.darts) (heR : e ∈ R.darts)
    (heExternal : e.symm ∉ Y.toWarp.dartSet)
    (hsnd : d.snd = e.snd) : d = e := by
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heR with
    ⟨i, hi, hie⟩
  have hielem : R.darts[i]'(by simpa using hi) = e := by
    apply Dart.ext
    calc
      (R.darts[i]'(by simpa using hi)).toProd =
          (R.getVert i, R.getVert (i + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert i (by simpa using hi))
      _ = e.toProd := hie.symm
  have heSnd : e.snd = R.getVert (i + 1) := congrArg Prod.snd hie
  have hsuccY : R.getVert (i + 1) ∈ Y.toWarp.vertexSet := by
    have hdSnd : d.snd ∈ Y.toWarp.vertexSet :=
      Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hdY
    simpa [hsnd, heSnd] using hdSnd
  rcases hR.next_symm_mem_right_of_external hi hsuccY
      (by simpa [hielem] using heExternal) with ⟨hnextLt, hnextY⟩
  let q : G.Dart := R.darts[i + 1]'(by simpa using hnextLt)
  have hqMem : q ∈ R.darts := List.getElem_mem ..
  have hqSymmY : q.symm ∈ Y.toWarp.dartSet := by
    simpa [q] using hnextY
  have hqSymmSnd : q.symm.snd = d.snd := by
    change q.fst = d.snd
    have hfst := congrArg (fun r : G.Dart => r.fst)
      (R.darts_getElem_eq_getVert (i + 1) (by simpa using hnextLt))
    have hqFst : q.fst = R.getVert (i + 1) := by
      simpa only [q] using hfst
    calc
      q.fst = R.getVert (i + 1) := hqFst
      _ = e.snd := heSnd.symm
      _ = d.snd := hsnd.symm
  have heq : q.symm = d :=
    Y.toWarp.dart_eq_of_snd_eq hqSymmY hdY hqSymmSnd
  have hdSymm : d.symm = q := by
    rw [← heq]
    simp
  exact (hdSurvives (hdSymm ▸ hqMem)).elim

/-- Two external darts inserted by an alternating walk cannot have the same
head.  Distinct common-head occurrences force equal following reversed
`Y` darts, again contradicting the no-repeated-edge condition. -/
theorem IsAlternatingWalk.externalWalkDart_eq_of_snd_eq
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R)
    {d e : G.Dart} (hdR : d ∈ R.darts)
    (hdExternal : d.symm ∉ Y.toWarp.dartSet) (heR : e ∈ R.darts)
    (heExternal : e.symm ∉ Y.toWarp.dartSet)
    (hsnd : d.snd = e.snd) : d = e := by
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdR with
    ⟨i, hi, hid⟩
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heR with
    ⟨j, hj, hje⟩
  have hidelem : R.darts[i]'(by simpa using hi) = d := by
    apply Dart.ext
    calc
      (R.darts[i]'(by simpa using hi)).toProd =
          (R.getVert i, R.getVert (i + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert i (by simpa using hi))
      _ = d.toProd := hid.symm
  have hjelem : R.darts[j]'(by simpa using hj) = e := by
    apply Dart.ext
    calc
      (R.darts[j]'(by simpa using hj)).toProd =
          (R.getVert j, R.getVert (j + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert j (by simpa using hj))
      _ = e.toProd := hje.symm
  have hdSnd : d.snd = R.getVert (i + 1) := congrArg Prod.snd hid
  have heSnd : e.snd = R.getVert (j + 1) := congrArg Prod.snd hje
  by_cases hij : i = j
  · subst j
    exact hidelem.symm.trans hjelem
  · have hvertex : R.getVert (i + 1) = R.getVert (j + 1) := by
      calc
        R.getVert (i + 1) = d.snd := hdSnd.symm
        _ = e.snd := hsnd
        _ = R.getVert (j + 1) := heSnd
    have hindices : i + 1 ≠ j + 1 := by omega
    have hiSuccY : R.getVert (i + 1) ∈ Y.toWarp.vertexSet :=
      hR.2.2.1 (i + 1) (j + 1) (by omega) (by omega)
        hindices hvertex
    have hjSuccY : R.getVert (j + 1) ∈ Y.toWarp.vertexSet :=
      hvertex ▸ hiSuccY
    rcases hR.next_symm_mem_right_of_external hi hiSuccY
        (by simpa [hidelem] using hdExternal) with ⟨hiNext, hnextI⟩
    rcases hR.next_symm_mem_right_of_external hj hjSuccY
        (by simpa [hjelem] using heExternal) with ⟨hjNext, hnextJ⟩
    have hnextIFst :
        (R.darts[i + 1]'(by simpa using hiNext)).symm.snd =
          R.getVert (i + 1) := by
      change (R.darts[i + 1]'(by simpa using hiNext)).fst =
        R.getVert (i + 1)
      have hfst := congrArg (fun q : G.Dart => q.fst)
        (R.darts_getElem_eq_getVert (i + 1) (by simpa using hiNext))
      simpa using hfst
    have hnextJFst :
        (R.darts[j + 1]'(by simpa using hjNext)).symm.snd =
          R.getVert (j + 1) := by
      change (R.darts[j + 1]'(by simpa using hjNext)).fst =
        R.getVert (j + 1)
      have hfst := congrArg (fun q : G.Dart => q.fst)
        (R.darts_getElem_eq_getVert (j + 1) (by simpa using hjNext))
      simpa using hfst
    have hsymmEq :
        (R.darts[i + 1]'(by simpa using hiNext)).symm =
          (R.darts[j + 1]'(by simpa using hjNext)).symm :=
      Y.toWarp.dart_eq_of_snd_eq hnextI hnextJ
        (hnextIFst.trans (hvertex.trans hnextJFst.symm))
    have hdartEq :
        R.darts[i + 1]'(by simpa using hiNext) =
          R.darts[j + 1]'(by simpa using hjNext) := by
      have := congrArg Dart.symm hsymmEq
      simpa using this
    have hedgeEq :
        R.edges[i + 1]'(by simpa using hiNext) =
          R.edges[j + 1]'(by simpa using hjNext) := by
      calc
        R.edges[i + 1]'(by simpa using hiNext) =
            (R.darts[i + 1]'(by simpa using hiNext)).edge :=
          (Walk.edge_getElem_darts
            (p := R) (i := i + 1) (by simpa using hiNext)).symm
        _ = (R.darts[j + 1]'(by simpa using hjNext)).edge :=
          congrArg Dart.edge hdartEq
        _ = R.edges[j + 1]'(by simpa using hjNext) :=
          Walk.edge_getElem_darts
            (p := R) (i := j + 1) (by simpa using hjNext)
    have hindex : i + 1 = j + 1 :=
      hR.2.2.2.1.getElem_inj_iff.mp hedgeEq
    exact (hij (by omega)).elim

/-- The toggled oriented edge set has indegree at most one at every
vertex.  Together with `toggleDart_eq_of_fst_eq`, this gives the local
degree structure needed to decompose it into directed paths and cycles. -/
theorem IsAlternatingWalk.toggleDart_eq_of_snd_eq
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R)
    {d e : G.Dart} (hd : d ∈ Y.toggleDartSet R)
    (he : e ∈ Y.toggleDartSet R) (hsnd : d.snd = e.snd) : d = e := by
  rcases hd with hdOld | hdNew
  · rcases he with heOld | heNew
    · exact Y.toWarp.dart_eq_of_snd_eq hdOld.1 heOld.1 hsnd
    · exact hR.rightDart_eq_externalWalkDart_of_snd_eq
        hdOld.1 hdOld.2 heNew.1 heNew.2 hsnd
  · rcases he with heOld | heNew
    · exact (hR.rightDart_eq_externalWalkDart_of_snd_eq
        heOld.1 heOld.2 hdNew.1 hdNew.2 hsnd.symm).symm
    · exact hR.externalWalkDart_eq_of_snd_eq
        hdNew.1 hdNew.2 heNew.1 heNew.2 hsnd

/-- No toggled dart enters an initial vertex of `Y`.  An inserted external
dart doing so would force a following reversed `Y` dart that also enters
that initial vertex, impossible in a warp. -/
theorem IsAlternatingWalk.no_toggleDart_to_initial
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) {a : V}
    (ha : a ∈ Y.toWarp.initialSet) {d : G.Dart}
    (hd : d ∈ Y.toggleDartSet R) (hda : d.snd = a) : False := by
  rcases hd with hdOld | hdNew
  · exact Y.toWarp.no_dart_to_initial ha hdOld.1 hda
  · rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdNew.1 with
      ⟨i, hi, hid⟩
    have hidelem : R.darts[i]'(by simpa using hi) = d := by
      apply Dart.ext
      calc
        (R.darts[i]'(by simpa using hi)).toProd =
            (R.getVert i, R.getVert (i + 1)) := by
          simpa using congrArg Dart.toProd
            (R.darts_getElem_eq_getVert i (by simpa using hi))
        _ = d.toProd := hid.symm
    have hdSnd : d.snd = R.getVert (i + 1) := congrArg Prod.snd hid
    have hsuccY : R.getVert (i + 1) ∈ Y.toWarp.vertexSet := by
      have haVertex : a ∈ Y.toWarp.vertexSet :=
        Y.toWarp.initialSet_subset_vertexSet ha
      have heq : R.getVert (i + 1) = a := hdSnd.symm.trans hda
      simpa [heq] using haVertex
    rcases hR.next_symm_mem_right_of_external hi hsuccY
        (by simpa [hidelem] using hdNew.2) with ⟨hnext, hnextY⟩
    have hnextSnd :
        (R.darts[i + 1]'(by simpa using hnext)).symm.snd = a := by
      change (R.darts[i + 1]'(by simpa using hnext)).fst = a
      have hfst := congrArg (fun q : G.Dart => q.fst)
        (R.darts_getElem_eq_getVert (i + 1) (by simpa using hnext))
      have : (R.darts[i + 1]'(by simpa using hnext)).fst =
          R.getVert (i + 1) := by simpa using hfst
      exact this.trans (hdSnd.symm.trans hda)
    exact Y.toWarp.no_dart_to_initial ha hnextY hnextSnd

/-- Every dart of the left-hand warp survives the toggle.  If the
alternating walk traversed its reverse, it would next visit the dart's
nonterminal tail, contradicting the defining avoidance of nonterminal
vertices of the left warp. -/
theorem IsAlternatingWalk.mem_toggleDartSet_of_left {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (hXY : X ≤ Y) {d : G.Dart} (hdX : d ∈ X.toWarp.dartSet) :
    d ∈ Y.toggleDartSet R := by
  have hdY : d ∈ Y.toWarp.dartSet :=
    WaveExtension.dartSet_subset_of_le hXY hdX
  refine Or.inl ⟨hdY, ?_⟩
  intro hreverse
  have htailSupport : d.fst ∈ R.support := by
    have := Walk.dart_snd_mem_support_of_mem_darts R hreverse
    simpa using this
  have htailX := X.toWarp.fst_mem_vertexSet_of_mem_dartSet hdX
  have htailTerminal := hR.1 d.fst htailSupport htailX
  exact X.toWarp.no_dart_from_terminal htailTerminal hdX rfl

/-- A directed edge set with functional predecessor and successor relations,
rooted at a set `A` that no dart enters.  Its source-rooted components are
exactly the path components retained after the cycle deletion in Shafer
Lemma 3.10. -/
structure RootedDartSystem {V : Type} (G : SimpleGraph V) (A : Set V) where
  darts : Set G.Dart
  out_unique : ∀ {d e}, d ∈ darts → e ∈ darts → d.fst = e.fst → d = e
  in_unique : ∀ {d e}, d ∈ darts → e ∈ darts → d.snd = e.snd → d = e
  no_enter : ∀ {a}, a ∈ A → ∀ {d}, d ∈ darts → d.snd ≠ a

namespace RootedDartSystem

def HasOutgoing {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (x : V) : Prop :=
  ∃ d ∈ D.darts, d.fst = x

def HasIncoming {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (x : V) : Prop :=
  ∃ d ∈ D.darts, d.snd = x

/-- The uniquely determined next vertex when one exists; at a sink its value
is irrelevant and is chosen to be the current vertex. -/
noncomputable def successor {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (x : V) : V := by
  classical
  exact if h : D.HasOutgoing x then (Classical.choose h).snd else x

noncomputable def predecessor {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (x : V) : V := by
  classical
  exact if h : D.HasIncoming x then (Classical.choose h).fst else x

theorem exists_dart_successor {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) {x : V} (hx : D.HasOutgoing x) :
    ∃ d ∈ D.darts, d.fst = x ∧ d.snd = D.successor x := by
  let d : G.Dart := Classical.choose hx
  have hd := Classical.choose_spec hx
  refine ⟨d, hd.1, hd.2, ?_⟩
  simp [successor, hx, d]

theorem exists_dart_predecessor {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) {x : V} (hx : D.HasIncoming x) :
    ∃ d ∈ D.darts, d.fst = D.predecessor x ∧ d.snd = x := by
  let d : G.Dart := Classical.choose hx
  have hd := Classical.choose_spec hx
  refine ⟨d, hd.1, ?_, hd.2⟩
  simp [predecessor, hx, d]

noncomputable def backChain {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (x : V) : ℕ → V
  | 0 => x
  | n + 1 => D.predecessor (D.backChain x n)

@[simp] theorem backChain_zero {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (x : V) :
    D.backChain x 0 = x := rfl

@[simp] theorem backChain_succ {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (x : V) (n : ℕ) :
    D.backChain x (n + 1) = D.predecessor (D.backChain x n) := rfl

theorem backChain_ne_of_lt_of_sink {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) {x : V}
    (hsink : ¬ D.HasOutgoing x)
    (hin : ∀ n, D.HasIncoming (D.backChain x n)) {m n : ℕ}
    (hmn : m < n) : D.backChain x m ≠ D.backChain x n := by
  induction m generalizing n with
  | zero =>
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
      intro heq
      rcases D.exists_dart_predecessor (hin k) with
        ⟨d, hd, hfst, hsnd⟩
      apply hsink
      refine ⟨d, hd, ?_⟩
      calc
        d.fst = D.predecessor (D.backChain x k) := hfst
        _ = D.backChain x (k + 1) := rfl
        _ = D.backChain x 0 := heq.symm
        _ = x := rfl
  | succ m ih =>
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
      have hmk : m < k := by omega
      intro heq
      rcases D.exists_dart_predecessor (hin m) with
        ⟨d, hd, hdfst, hdsnd⟩
      rcases D.exists_dart_predecessor (hin k) with
        ⟨e, he, hefst, hesnd⟩
      have hde : d = e := D.out_unique hd he (by
        calc
          d.fst = D.predecessor (D.backChain x m) := hdfst
          _ = D.backChain x (m + 1) := rfl
          _ = D.backChain x (k + 1) := heq
          _ = D.predecessor (D.backChain x k) := rfl
          _ = e.fst := hefst.symm)
      apply ih hmk
      calc
        D.backChain x m = d.snd := hdsnd.symm
        _ = e.snd := congrArg (fun q : G.Dart => q.snd) hde
        _ = D.backChain x k := hesnd

theorem backChain_injective_of_sink {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) {x : V}
    (hsink : ¬ D.HasOutgoing x)
    (hin : ∀ n, D.HasIncoming (D.backChain x n)) :
    Function.Injective (D.backChain x) := by
  intro m n hmn
  rcases lt_trichotomy m n with hlt | rfl | hgt
  · exact (D.backChain_ne_of_lt_of_sink hsink hin hlt hmn).elim
  · rfl
  · exact (D.backChain_ne_of_lt_of_sink hsink hin hgt hmn.symm).elim

noncomputable def chainVertex {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (a : V) : ℕ → V
  | 0 => a
  | n + 1 => D.successor (D.chainVertex a n)

@[simp] theorem chainVertex_zero {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (a : V) :
    D.chainVertex a 0 = a := rfl

@[simp] theorem chainVertex_succ {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (a : V) (n : ℕ) :
    D.chainVertex a (n + 1) = D.successor (D.chainVertex a n) := rfl

/-- The first sink reached by the successor orbit, or `none` when the orbit
continues forever. -/
noncomputable def chainTerminalIndex {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (a : V) : Option ℕ := by
  classical
  exact if h : ∃ n, ¬ D.HasOutgoing (D.chainVertex a n)
    then some (Nat.find h)
    else none

theorem hasOutgoing_of_active_succ {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (a : V) {n : ℕ}
    (hn : longPathActive (D.chainTerminalIndex a) (n + 1)) :
    D.HasOutgoing (D.chainVertex a n) := by
  classical
  by_cases hstop : ∃ k, ¬ D.HasOutgoing (D.chainVertex a k)
  · have hnlt : n < Nat.find hstop := by
      simpa [chainTerminalIndex, hstop, longPathActive] using hn
    by_contra hout
    exact Nat.find_min hstop hnlt hout
  · exact Classical.byContradiction fun hout => hstop ⟨n, hout⟩

theorem active_succ_of_active_of_hasOutgoing {V : Type}
    {G : SimpleGraph V} {A : Set V} (D : RootedDartSystem G A)
    (a : V) {n : ℕ} (hn : longPathActive (D.chainTerminalIndex a) n)
    (hout : D.HasOutgoing (D.chainVertex a n)) :
    longPathActive (D.chainTerminalIndex a) (n + 1) := by
  classical
  by_cases hstop : ∃ k, ¬ D.HasOutgoing (D.chainVertex a k)
  · have hnLt : n < Nat.find hstop := by
      by_contra hnot
      have hfindLe : Nat.find hstop ≤ n := Nat.le_of_not_gt hnot
      have hnLeFind : n ≤ Nat.find hstop := by
        simpa [chainTerminalIndex, hstop, longPathActive] using hn
      have heq : n = Nat.find hstop := le_antisymm hnLeFind hfindLe
      have hno : ¬ D.HasOutgoing (D.chainVertex a n) := by
        simpa [heq] using Nat.find_spec hstop
      exact hno hout
    simpa [chainTerminalIndex, hstop, longPathActive] using
      (show n + 1 ≤ Nat.find hstop by omega)
  · simp [chainTerminalIndex, hstop, longPathActive]

theorem not_hasOutgoing_at_terminal {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (a : V) {k : ℕ}
    (hk : D.chainTerminalIndex a = some k) :
    ¬ D.HasOutgoing (D.chainVertex a k) := by
  classical
  unfold chainTerminalIndex at hk
  split at hk
  next hstop =>
    have hfind : Nat.find hstop = k := Option.some.inj hk
    simpa [hfind] using Nat.find_spec hstop
  next hstop => simp at hk

theorem exists_step_dart {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (a : V) {n : ℕ}
    (hn : longPathActive (D.chainTerminalIndex a) (n + 1)) :
    ∃ d ∈ D.darts,
      d.fst = D.chainVertex a n ∧ d.snd = D.chainVertex a (n + 1) := by
  rcases D.exists_dart_successor (D.hasOutgoing_of_active_succ a hn) with
    ⟨d, hd, hfst, hsnd⟩
  exact ⟨d, hd, hfst, by simpa using hsnd⟩

theorem adjacent_chainVertex {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (a : V) (n : ℕ)
    (hn : longPathActive (D.chainTerminalIndex a) (n + 1)) :
    G.Adj (D.chainVertex a n) (D.chainVertex a (n + 1)) := by
  rcases D.exists_step_dart a hn with ⟨d, hd, hfst, hsnd⟩
  simpa [hfst, hsnd] using d.adj

theorem chainVertex_ne_of_lt {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) {a : V} (ha : a ∈ A) {m n : ℕ}
    (hmn : m < n)
    (hn : longPathActive (D.chainTerminalIndex a) n) :
    D.chainVertex a m ≠ D.chainVertex a n := by
  induction m generalizing n with
  | zero =>
      intro heq
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
      rcases D.exists_step_dart a hn with ⟨d, hd, hfst, hsnd⟩
      apply D.no_enter ha hd
      calc
        d.snd = D.chainVertex a (k + 1) := hsnd
        _ = D.chainVertex a 0 := heq.symm
        _ = a := by simp
  | succ m ih =>
      intro heq
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
      have hmk : m < k := by omega
      have hmActive :
          longPathActive (D.chainTerminalIndex a) (m + 1) :=
        LongPath.active_mono (by omega) hn
      have hkActive :
          longPathActive (D.chainTerminalIndex a) k :=
        LongPath.active_mono (Nat.le_succ k) hn
      rcases D.exists_step_dart a hmActive with
        ⟨d, hd, hdfst, hdsnd⟩
      rcases D.exists_step_dart a hn with
        ⟨e, he, hefst, hesnd⟩
      have hde : d = e := D.in_unique hd he (by
        calc
          d.snd = D.chainVertex a (m + 1) := hdsnd
          _ = D.chainVertex a (k + 1) := heq
          _ = e.snd := hesnd.symm)
      apply ih hmk hkActive
      calc
        D.chainVertex a m = d.fst := hdfst.symm
        _ = e.fst := congrArg (fun q : G.Dart => q.fst) hde
        _ = D.chainVertex a k := hefst

theorem chainVertex_injective {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) {a : V} (ha : a ∈ A) :
    Set.InjOn (D.chainVertex a)
      {n | longPathActive (D.chainTerminalIndex a) n} := by
  intro m hm n hn hmn
  rcases lt_trichotomy m n with hlt | rfl | hgt
  · exact (D.chainVertex_ne_of_lt ha hlt hn hmn).elim
  · rfl
  · exact (D.chainVertex_ne_of_lt ha hgt hm hmn.symm).elim

theorem chainVertex_ne_of_sources_ne {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) {a b : V}
    (ha : a ∈ A) (hb : b ∈ A) (hab : a ≠ b) {m n : ℕ}
    (hm : longPathActive (D.chainTerminalIndex a) m)
    (hn : longPathActive (D.chainTerminalIndex b) n) :
    D.chainVertex a m ≠ D.chainVertex b n := by
  induction m generalizing n with
  | zero =>
      cases n with
      | zero => simpa using hab
      | succ k =>
          intro heq
          rcases D.exists_step_dart b hn with ⟨d, hd, hfst, hsnd⟩
          apply D.no_enter ha hd
          calc
            d.snd = D.chainVertex b (k + 1) := hsnd
            _ = D.chainVertex a 0 := heq.symm
            _ = a := by simp
  | succ m ih =>
      cases n with
      | zero =>
          intro heq
          rcases D.exists_step_dart a hm with ⟨d, hd, hfst, hsnd⟩
          apply D.no_enter hb hd
          calc
            d.snd = D.chainVertex a (m + 1) := hsnd
            _ = D.chainVertex b 0 := heq
            _ = b := by simp
      | succ k =>
          intro heq
          have hmPrev : longPathActive (D.chainTerminalIndex a) m :=
            LongPath.active_mono (Nat.le_succ m) hm
          have hkPrev : longPathActive (D.chainTerminalIndex b) k :=
            LongPath.active_mono (Nat.le_succ k) hn
          rcases D.exists_step_dart a hm with
            ⟨d, hd, hdfst, hdsnd⟩
          rcases D.exists_step_dart b hn with
            ⟨e, he, hefst, hesnd⟩
          have hde : d = e := D.in_unique hd he (by
            calc
              d.snd = D.chainVertex a (m + 1) := hdsnd
              _ = D.chainVertex b (k + 1) := heq
              _ = e.snd := hesnd.symm)
          apply ih hmPrev hkPrev
          calc
            D.chainVertex a m = d.fst := hdfst.symm
            _ = e.fst := congrArg (fun q : G.Dart => q.fst) hde
            _ = D.chainVertex b k := hefst

noncomputable def chainLongPath {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) (a : A) : LongPath G where
  terminalIndex := D.chainTerminalIndex a
  vertex := D.chainVertex a
  injective := D.chainVertex_injective a.property
  adjacent := D.adjacent_chainVertex a

@[simp] theorem chainLongPath_initial {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) (a : A) :
    (D.chainLongPath a).initial = a := rfl

theorem chainLongPath_disjoint {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) {a b : A} (hab : a ≠ b) :
    Disjoint (D.chainLongPath a).vertexSet
      (D.chainLongPath b).vertexSet := by
  apply Set.disjoint_left.mpr
  intro v hvA hvB
  rcases hvA with ⟨m, hm, hmv⟩
  rcases hvB with ⟨n, hn, hnv⟩
  exact D.chainVertex_ne_of_sources_ne a.property b.property
    (fun h => hab (Subtype.ext h)) hm hn (hmv.trans hnv.symm)

noncomputable def toWarp {V : Type} {G : SimpleGraph V} {A : Set V}
    (D : RootedDartSystem G A) : Warp G where
  ι := A
  path := D.chainLongPath
  disjoint := fun _ _ hab => D.chainLongPath_disjoint hab

@[simp] theorem initialSet_toWarp {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) :
    D.toWarp.initialSet = A := by
  change Set.range (fun x : A => (D.chainLongPath x).initial) = A
  ext a
  simp

theorem dartSet_toWarp_subset {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) :
    D.toWarp.dartSet ⊆ D.darts := by
  intro d hd
  change ∃ a : A, d ∈ (D.chainLongPath a).dartSet at hd
  rcases hd with ⟨a, n, hn, hdn⟩
  change longPathActive (D.chainTerminalIndex a) (n + 1) at hn
  change d.toProd =
    (D.chainVertex a n, D.chainVertex a (n + 1)) at hdn
  rcases D.exists_step_dart a hn with ⟨e, he, heFst, heSnd⟩
  have hde : d = e := by
    apply Dart.ext
    calc
      d.toProd =
          (D.chainVertex a n, D.chainVertex a (n + 1)) := hdn
      _ = e.toProd := by
        apply Prod.ext
        · exact heFst.symm
        · exact heSnd.symm
  exact hde ▸ he

theorem terminalSet_toWarp {V : Type} {G : SimpleGraph V}
    {A : Set V} (D : RootedDartSystem G A) :
    D.toWarp.terminalSet =
      {x | x ∈ D.toWarp.vertexSet ∧ ¬ D.HasOutgoing x} := by
  classical
  ext x
  constructor
  · intro hx
    change ∃ a : A, (D.chainLongPath a).terminal? = some x at hx
    rcases hx with ⟨a, hterm⟩
    rcases LongPath.terminal?_eq_some_iff.mp hterm with
      ⟨k, hk, hkx⟩
    change D.chainTerminalIndex a = some k at hk
    change D.chainVertex a k = x at hkx
    refine ⟨?_, ?_⟩
    · change ∃ a : A, x ∈ (D.chainLongPath a).vertexSet
      refine ⟨a, k, ?_, hkx⟩
      change longPathActive (D.chainTerminalIndex a) k
      simp [hk, longPathActive]
    have hno := D.not_hasOutgoing_at_terminal a hk
    rwa [hkx] at hno
  · rintro ⟨hxVertex, hxNo⟩
    change ∃ a : A, x ∈ (D.chainLongPath a).vertexSet at hxVertex
    rcases hxVertex with ⟨a, n, hn, hnx⟩
    change longPathActive (D.chainTerminalIndex a) n at hn
    change D.chainVertex a n = x at hnx
    have hstop : ∃ k, ¬ D.HasOutgoing (D.chainVertex a k) :=
      ⟨n, by simpa [hnx] using hxNo⟩
    have hfindLe : Nat.find hstop ≤ n :=
      Nat.find_min' hstop (by simpa [hnx] using hxNo)
    have hnLe : n ≤ Nat.find hstop := by
      simpa [chainTerminalIndex, hstop, longPathActive] using hn
    have heq : Nat.find hstop = n := le_antisymm hfindLe hnLe
    change ∃ a : A, (D.chainLongPath a).terminal? = some x
    refine ⟨a, LongPath.terminal?_eq_some_iff.mpr ⟨n, ?_, hnx⟩⟩
    change D.chainTerminalIndex a = some n
    simp [chainTerminalIndex, hstop, heq]

theorem exists_incoming_of_mem_vertexSet_of_not_mem {V : Type}
    {G : SimpleGraph V} {A : Set V} (D : RootedDartSystem G A) {x : V}
    (hx : x ∈ D.toWarp.vertexSet) (hxA : x ∉ A) :
    ∃ d ∈ D.darts, d.snd = x := by
  change ∃ a : A, x ∈ (D.chainLongPath a).vertexSet at hx
  rcases hx with ⟨a, n, hn, hnx⟩
  change longPathActive (D.chainTerminalIndex a) n at hn
  change D.chainVertex a n = x at hnx
  cases n with
  | zero =>
      exact (hxA (by simpa [← hnx] using a.property)).elim
  | succ k =>
      rcases D.exists_step_dart a hn with ⟨d, hd, hfst, hsnd⟩
      exact ⟨d, hd, hsnd.trans hnx⟩

theorem snd_mem_toWarp_vertexSet_of_fst_mem {V : Type}
    {G : SimpleGraph V} {A : Set V} (D : RootedDartSystem G A)
    {d : G.Dart} (hd : d ∈ D.darts)
    (hfst : d.fst ∈ D.toWarp.vertexSet) :
    d.snd ∈ D.toWarp.vertexSet := by
  change ∃ a : A, d.fst ∈ (D.chainLongPath a).vertexSet at hfst
  rcases hfst with ⟨a, n, hn, hnx⟩
  change longPathActive (D.chainTerminalIndex a) n at hn
  change D.chainVertex a n = d.fst at hnx
  have hout : D.HasOutgoing (D.chainVertex a n) :=
    ⟨d, hd, hnx.symm⟩
  have hnSucc : longPathActive (D.chainTerminalIndex a) (n + 1) := by
    classical
    by_cases hs : ∃ k, ¬ D.HasOutgoing (D.chainVertex a k)
    · have hnLt : n < Nat.find hs := by
        by_contra hnot
        have hfindLe : Nat.find hs ≤ n := Nat.le_of_not_gt hnot
        have hactive : longPathActive (D.chainTerminalIndex a) n := hn
        have hnLeFind : n ≤ Nat.find hs := by
          simpa [chainTerminalIndex, hs, longPathActive] using hactive
        have heq : n = Nat.find hs := le_antisymm hnLeFind hfindLe
        have hno : ¬ D.HasOutgoing (D.chainVertex a n) := by
          simpa [heq] using Nat.find_spec hs
        exact hno hout
      simpa [chainTerminalIndex, hs, longPathActive] using (show n + 1 ≤ Nat.find hs by omega)
    · simp [chainTerminalIndex, hs, longPathActive]
  rcases D.exists_step_dart a hnSucc with ⟨e, he, heFst, heSnd⟩
  have hed : e = d := D.out_unique he hd (heFst.trans hnx)
  change ∃ a : A, d.snd ∈ (D.chainLongPath a).vertexSet
  refine ⟨a, n + 1, hnSucc, ?_⟩
  exact heSnd.symm.trans (congrArg (fun q : G.Dart => q.snd) hed)

/-- A source-rooted path decomposition cannot discard a sink component when
the ambient functional digraph differs from a naturally ranked path family
by only finitely many darts.  Otherwise following predecessors forever gives
an injective backward chain.  Beyond the finitely many exceptional darts,
the old path depth would then decrease indefinitely in `ℕ`. -/
theorem sink_mem_toWarp_of_finite_perturbation {V : Type}
    {G : SimpleGraph V} {A : Set V} (D : RootedDartSystem G A)
    (oldDarts newDarts : Set G.Dart) (rank : G.Dart → ℕ)
    (hnewFinite : newDarts.Finite)
    (hcover : D.darts ⊆ oldDarts ∪ newDarts)
    (hrank : ∀ {e d}, e ∈ oldDarts → d ∈ oldDarts →
      e.snd = d.fst → rank e < rank d)
    (hincoming : ∀ {y}, y ∉ A → D.HasOutgoing y → D.HasIncoming y)
    {x : V} (hsink : ¬ D.HasOutgoing x) (hxIncoming : D.HasIncoming x) :
    x ∈ D.toWarp.vertexSet := by
  classical
  by_contra hxReach
  have hstate : ∀ n,
      D.HasIncoming (D.backChain x n) ∧
        D.backChain x n ∉ D.toWarp.vertexSet := by
    intro n
    induction n with
    | zero => exact ⟨hxIncoming, by simpa using hxReach⟩
    | succ n ih =>
        rcases D.exists_dart_predecessor ih.1 with
          ⟨d, hd, hdfst, hdsnd⟩
        have hpredNotReach :
            D.predecessor (D.backChain x n) ∉ D.toWarp.vertexSet := by
          intro hpredReach
          have hfstReach : d.fst ∈ D.toWarp.vertexSet := by
            simpa [hdfst] using hpredReach
          have hsndReach := D.snd_mem_toWarp_vertexSet_of_fst_mem hd hfstReach
          exact ih.2 (by simpa [hdsnd] using hsndReach)
        have hpredNotA : D.predecessor (D.backChain x n) ∉ A := by
          intro hpredA
          apply hpredNotReach
          apply D.toWarp.initialSet_subset_vertexSet
          simpa [D.initialSet_toWarp] using hpredA
        have hpredOutgoing :
            D.HasOutgoing (D.predecessor (D.backChain x n)) :=
          ⟨d, hd, hdfst⟩
        exact ⟨hincoming hpredNotA hpredOutgoing, hpredNotReach⟩
  let e : ℕ → G.Dart := fun n =>
    Classical.choose (D.exists_dart_predecessor (hstate n).1)
  have heSpec (n : ℕ) :
      e n ∈ D.darts ∧
        (e n).fst = D.backChain x (n + 1) ∧
        (e n).snd = D.backChain x n := by
    have h := Classical.choose_spec
      (D.exists_dart_predecessor (hstate n).1)
    exact ⟨h.1, by simpa [e] using h.2.1, by simpa [e] using h.2.2⟩
  have hbackInjective : Function.Injective (D.backChain x) :=
    D.backChain_injective_of_sink hsink (fun n => (hstate n).1)
  have heInjective : Function.Injective e := by
    intro m n hmn
    apply hbackInjective
    calc
      D.backChain x m = (e m).snd := (heSpec m).2.2.symm
      _ = (e n).snd := congrArg (fun q : G.Dart => q.snd) hmn
      _ = D.backChain x n := (heSpec n).2.2
  have hnewPreimage : (e ⁻¹' newDarts).Finite :=
    hnewFinite.preimage heInjective.injOn
  rcases hnewPreimage.bddAbove with ⟨N, hN⟩
  let N₀ := N + 1
  have heOld (k : ℕ) : e (N₀ + k) ∈ oldDarts := by
    rcases hcover (heSpec (N₀ + k)).1 with hold | hnew
    · exact hold
    · have hle : N₀ + k ≤ N := hN hnew
      simp only [N₀] at hle
      omega
  have hdecr (k : ℕ) :
      rank (e (N₀ + (k + 1))) < rank (e (N₀ + k)) := by
    apply hrank (heOld (k + 1)) (heOld k)
    calc
      (e (N₀ + (k + 1))).snd =
          D.backChain x (N₀ + (k + 1)) := (heSpec _).2.2
      _ = D.backChain x ((N₀ + k) + 1) := by congr 1 <;> omega
      _ = (e (N₀ + k)).fst := (heSpec _).2.1.symm
  have hrankBound : ∀ k,
      rank (e (N₀ + k)) + k ≤ rank (e N₀) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
        have hlt := hdecr k
        have hidx : N₀ + (k + 1) = N₀ + Nat.succ k := by omega
        omega
  have := hrankBound (rank (e N₀) + 1)
  omega

end RootedDartSystem

/-- The rooted partial functional digraph obtained by toggling along an
alternating walk. -/
def toggleRootedSystem {V : Type} {G : SimpleGraph V} {A B : Set V}
    {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet) :
    RootedDartSystem G A where
  darts := Y.toggleDartSet R
  out_unique := fun hd he hfst => hR.toggleDart_eq_of_fst_eq ht hd he hfst
  in_unique := fun hd he hsnd => hR.toggleDart_eq_of_snd_eq hd he hsnd
  no_enter := by
    intro a ha d hd hda
    apply hR.no_toggleDart_to_initial
      (by simpa [Y.initialSet_toWarp] using ha) hd hda

/-- The path components of the toggled graph that are rooted at `A`; the
other components are precisely those discarded by the cycle-removal step. -/
noncomputable def switchedWarp {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet) :
    Warp G :=
  (toggleRootedSystem hR ht).toWarp

@[simp] theorem switchedWarp_initialSet {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet) :
    (switchedWarp hR ht).initialSet = A := by
  exact RootedDartSystem.initialSet_toWarp _

theorem switchedWarp_dartSet_subset_toggle {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet) :
    (switchedWarp hR ht).dartSet ⊆ Y.toggleDartSet R := by
  exact RootedDartSystem.dartSet_toWarp_subset _

/-- Each source-rooted component of the switched warp extends the
corresponding component of the left-hand warp. -/
theorem left_path_forward_switchedWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hXY : X ≤ Y)
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (a : A) :
    (X.path a).1.Forward ((switchedWarp hR ht).path a) := by
  let D := toggleRootedSystem hR ht
  intro n hn
  change longPathActive (D.chainTerminalIndex a) n ∧
    D.chainVertex a n = (X.path a).1.vertex n
  induction n with
  | zero =>
      constructor
      · cases D.chainTerminalIndex a <;> simp [longPathActive]
      · have hstart := X.path_initial a
        change (a : V) = (X.path a).1.vertex 0
        exact hstart.symm
  | succ n ih =>
      have hnPrev : longPathActive (X.path a).1.terminalIndex n :=
        LongPath.active_mono (Nat.le_succ n) hn
      have ihPrev := ih hnPrev
      let d : G.Dart :=
        ⟨((X.path a).1.vertex n, (X.path a).1.vertex (n + 1)),
          (X.path a).1.adjacent n hn⟩
      have hdX : d ∈ X.toWarp.dartSet :=
        ⟨a, n, hn, by rfl⟩
      have hdD : d ∈ D.darts := hR.mem_toggleDartSet_of_left hXY hdX
      have hdFst : d.fst = D.chainVertex a n := by
        change (X.path a).1.vertex n = D.chainVertex a n
        exact ihPrev.2.symm
      have hout : D.HasOutgoing (D.chainVertex a n) :=
        ⟨d, hdD, hdFst⟩
      have hnD : longPathActive (D.chainTerminalIndex a) (n + 1) :=
        D.active_succ_of_active_of_hasOutgoing a ihPrev.1 hout
      rcases D.exists_dart_successor hout with
        ⟨e, heD, heFst, heSnd⟩
      have hde : d = e := D.out_unique hdD heD
        (hdFst.trans heFst.symm)
      refine ⟨hnD, ?_⟩
      calc
        D.chainVertex a (n + 1) = D.successor (D.chainVertex a n) := rfl
        _ = e.snd := heSnd.symm
        _ = d.snd := congrArg (fun q : G.Dart => q.snd) hde.symm
        _ = (X.path a).1.vertex (n + 1) := rfl

theorem left_paths_forward_switchedWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hXY : X ≤ Y)
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet) :
    ∀ a, (X.path a).1.Forward ((switchedWarp hR ht).path a) :=
  left_path_forward_switchedWarp hXY hR ht

theorem reachable_toggle_sink_mem_right_or_eq_end {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z x : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (hxReach : x ∈ (switchedWarp hR ht).vertexSet)
    (hxSink : ¬ (toggleRootedSystem hR ht).HasOutgoing x) :
    x ∈ Y.toWarp.vertexSet ∨ x = z := by
  classical
  by_cases hxY : x ∈ Y.toWarp.vertexSet
  · exact Or.inl hxY
  · right
    by_contra hxz
    have hxA : x ∉ A := by
      intro hxA
      exact hxY (Y.toWarp.initialSet_subset_vertexSet
        (by simpa [Y.initialSet_toWarp] using hxA))
    have hxReach' : x ∈ (toggleRootedSystem hR ht).toWarp.vertexSet :=
      hxReach
    rcases RootedDartSystem.exists_incoming_of_mem_vertexSet_of_not_mem
        (toggleRootedSystem hR ht) hxReach' hxA with ⟨e, heD, heSnd⟩
    change e ∈ Y.toggleDartSet R at heD
    rcases heD with heOld | heNew
    · have heY := Y.toWarp.snd_mem_vertexSet_of_mem_dartSet heOld.1
      exact (hxY (by simpa [heSnd] using heY)).elim
    · rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heNew.1 with
        ⟨i, hi, hie⟩
      have heAt : R.darts[i]'(by simpa using hi) = e := by
        apply Dart.ext
        calc
          (R.darts[i]'(by simpa using hi)).toProd =
              (R.getVert i, R.getVert (i + 1)) := by
            simpa using congrArg Dart.toProd
              (R.darts_getElem_eq_getVert i (by simpa using hi))
          _ = e.toProd := hie.symm
      have heSndAt : e.snd = R.getVert (i + 1) := congrArg Prod.snd hie
      have hiNext : i + 1 < R.length := by
        have hle : i + 1 ≤ R.length := by omega
        apply lt_of_le_of_ne hle
        intro heq
        apply hxz
        calc
          x = e.snd := heSnd.symm
          _ = R.getVert (i + 1) := heSndAt
          _ = R.getVert R.length := by rw [heq]
          _ = z := R.getVert_length
      let q : G.Dart := R.darts[i + 1]'(by simpa using hiNext)
      have hqMem : q ∈ R.darts := List.getElem_mem ..
      have hqFst : q.fst = x := by
        have hfst := congrArg (fun r : G.Dart => r.fst)
          (R.darts_getElem_eq_getVert (i + 1) (by simpa using hiNext))
        have : q.fst = R.getVert (i + 1) := by simpa [q] using hfst
        exact this.trans (heSndAt.symm.trans heSnd)
      have hqExternal : q.symm ∉ Y.toWarp.dartSet := by
        intro hqY
        have hvertex := Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hqY
        apply hxY
        simpa [hqFst] using hvertex
      apply hxSink
      exact ⟨q, hR.mem_toggleDartSet_of_external hqMem hqExternal, hqFst⟩

theorem reachable_toggle_sink_mem_terminal_or_eq_end {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z x : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (hxReach : x ∈ (switchedWarp hR ht).vertexSet)
    (hxSink : ¬ (toggleRootedSystem hR ht).HasOutgoing x) :
    x ∈ Y.toWarp.terminalSet ∨ x = z := by
  classical
  rcases reachable_toggle_sink_mem_right_or_eq_end hR ht hxReach hxSink with
    hxY | hxz
  · by_cases hxTerminal : x ∈ Y.toWarp.terminalSet
    · exact Or.inl hxTerminal
    · right
      by_contra hxz
      rcases Y.toWarp.exists_dart_from_of_mem_vertexSet_not_terminal
          hxY hxTerminal with ⟨d, hdY, hdFst⟩
      have hdReverseR : d.symm ∈ R.darts := by
        by_contra hnot
        apply hxSink
        exact ⟨d, Or.inl ⟨hdY, hnot⟩, hdFst⟩
      rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdReverseR with
        ⟨j, hj, hjd⟩
      have hdAt : R.darts[j]'(by simpa using hj) = d.symm := by
        apply Dart.ext
        calc
          (R.darts[j]'(by simpa using hj)).toProd =
              (R.getVert j, R.getVert (j + 1)) := by
            simpa using congrArg Dart.toProd
              (R.darts_getElem_eq_getVert j (by simpa using hj))
          _ = d.symm.toProd := hjd.symm
      have harrival : R.getVert (j + 1) = x := by
        have hsnd : d.symm.snd = R.getVert (j + 1) :=
          congrArg Prod.snd hjd
        calc
          R.getVert (j + 1) = d.symm.snd := hsnd.symm
          _ = d.fst := rfl
          _ = x := hdFst
      have hjNext : j + 1 < R.length := by
        have hle : j + 1 ≤ R.length := by omega
        apply lt_of_le_of_ne hle
        intro heq
        apply hxz
        calc
          x = R.getVert (j + 1) := harrival.symm
          _ = R.getVert R.length := by rw [heq]
          _ = z := R.getVert_length
      let q : G.Dart := R.darts[j + 1]'(by simpa using hjNext)
      have hqMem : q ∈ R.darts := List.getElem_mem ..
      have hqFst : q.fst = x := by
        have hfst := congrArg (fun r : G.Dart => r.fst)
          (R.darts_getElem_eq_getVert (j + 1) (by simpa using hjNext))
        have : q.fst = R.getVert (j + 1) := by simpa [q] using hfst
        exact this.trans harrival
      have hqY : q.symm ∈ Y.toWarp.dartSet := by
        rcases hR.2.1 q hqMem with hreverse | hexternal
        · exact hreverse
        · apply (hxSink ⟨q, Or.inr ⟨hqMem, hexternal.2⟩, hqFst⟩).elim
      by_cases hxA : x ∈ A
      · have hxInitial : x ∈ Y.toWarp.initialSet := by
          simpa [Y.initialSet_toWarp] using hxA
        apply (Y.toWarp.no_dart_to_initial hxInitial hqY)
        simpa [hqFst]
      · have hxReach' : x ∈ (toggleRootedSystem hR ht).toWarp.vertexSet :=
          hxReach
        rcases RootedDartSystem.exists_incoming_of_mem_vertexSet_of_not_mem
            (toggleRootedSystem hR ht) hxReach' hxA with
          ⟨e, heD, heSnd⟩
        change e ∈ Y.toggleDartSet R at heD
        rcases heD with heOld | heNew
        · have heq : e = q.symm :=
            Y.toWarp.dart_eq_of_snd_eq heOld.1 hqY (by
              calc
                e.snd = x := heSnd
                _ = q.symm.snd := by simp [hqFst])
          apply heOld.2
          have : e.symm = q := by rw [heq]; simp
          exact this ▸ hqMem
        · rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heNew.1 with
            ⟨i, hi, hie⟩
          have heAt : R.darts[i]'(by simpa using hi) = e := by
            apply Dart.ext
            calc
              (R.darts[i]'(by simpa using hi)).toProd =
                  (R.getVert i, R.getVert (i + 1)) := by
                simpa using congrArg Dart.toProd
                  (R.darts_getElem_eq_getVert i (by simpa using hi))
              _ = e.toProd := hie.symm
          have heArrival : R.getVert (i + 1) = x := by
            have hsnd : e.snd = R.getVert (i + 1) :=
              congrArg Prod.snd hie
            exact hsnd.symm.trans heSnd
          have hiNext : i + 1 < R.length := by
            have hle : i + 1 ≤ R.length := by omega
            apply lt_of_le_of_ne hle
            intro heq
            apply hxz
            calc
              x = R.getVert (i + 1) := heArrival.symm
              _ = R.getVert R.length := by rw [heq]
              _ = z := R.getVert_length
          let r : G.Dart := R.darts[i + 1]'(by simpa using hiNext)
          have hrMem : r ∈ R.darts := List.getElem_mem ..
          have hrFst : r.fst = x := by
            have hfst := congrArg (fun s : G.Dart => s.fst)
              (R.darts_getElem_eq_getVert (i + 1)
                (by simpa using hiNext))
            have : r.fst = R.getVert (i + 1) := by simpa [r] using hfst
            exact this.trans heArrival
          have hrY : r.symm ∈ Y.toWarp.dartSet := by
            rcases hR.2.1 r hrMem with hreverse | hexternal
            · exact hreverse
            · apply (hxSink ⟨r, Or.inr ⟨hrMem, hexternal.2⟩, hrFst⟩).elim
          have hsymmEq : r.symm = q.symm :=
            Y.toWarp.dart_eq_of_snd_eq hrY hqY (by simp [hrFst, hqFst])
          have hrq : r = q := by
            have := congrArg Dart.symm hsymmEq
            simpa using this
          have hindices : i + 1 = j + 1 :=
            hR.index_eq_of_darts_getElem_eq hiNext hjNext (by simpa [r, q] using hrq)
          have hij : i = j := by omega
          subst j
          have hed : e = d.symm := heAt.symm.trans hdAt
          apply heNew.2
          rw [hed]
          simpa using hdY
  · exact Or.inr hxz

theorem firstDart_external_of_common_terminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hXY : X ≤ Y) (a : A)
    (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t)
    (hR : X.IsAlternatingWalk Y R) (hpos : 0 < R.length) :
    (R.darts[0]'(by simpa using hpos)).symm ∉ Y.toWarp.dartSet := by
  classical
  let d : G.Dart := R.darts[0]'(by simpa using hpos)
  have hdMem : d ∈ R.darts := List.getElem_mem ..
  rcases hR.2.1 d hdMem with hreverse | hexternal
  · have hpath : (X.path a).1 = (Y.path a).1 :=
      path_eq_of_le_of_terminal_eq hXY a htX htY
    change ∃ i : A, d.symm ∈ (Y.path i).1.dartSet at hreverse
    have hdFst : d.fst = t := by
      have hfst := congrArg (fun q : G.Dart => q.fst)
        (R.darts_getElem_eq_getVert 0 (by simpa using hpos))
      simpa [d, R.getVert_zero] using hfst
    rcases hreverse with ⟨i, hi⟩
    have htA : t ∈ (Y.path a).1.vertexSet :=
      LongPath.terminal_mem_vertexSet htY
    have htI : t ∈ (Y.path i).1.vertexSet := by
      have hsnd := LongPath.snd_mem_vertexSet_of_mem_dartSet hi
      simpa [hdFst] using hsnd
    have hia : i = a := by
      by_contra hne
      exact (Set.disjoint_left.mp (Y.disjoint hne) htI htA).elim
    subst i
    have hdX : d.symm ∈ X.toWarp.dartSet := by
      change ∃ i : A, d.symm ∈ (X.path i).1.dartSet
      refine ⟨a, ?_⟩
      rw [hpath]
      exact hi
    have hdSndX : d.snd ∈ X.toWarp.vertexSet := by
      have hfstX := X.toWarp.fst_mem_vertexSet_of_mem_dartSet hdX
      simpa using hfstX
    have hdSndTerminal : d.snd ∈ X.toWarp.terminalSet :=
      hR.1 d.snd (Walk.dart_snd_mem_support_of_mem_darts R hdMem) hdSndX
    exact (X.toWarp.no_dart_from_terminal hdSndTerminal hdX (by simp)).elim
  · exact hexternal.2

theorem start_hasOutgoing_of_ne_end {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} {t z : V}
    {R : G.Walk t z} (hXY : X ≤ Y) (a : A)
    (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t)
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (htz : t ≠ z) :
    (toggleRootedSystem hR ht).HasOutgoing t := by
  have hpos : 0 < R.length := by
    have hne : R.length ≠ 0 := by
      intro hzero
      apply htz
      calc
        t = R.getVert 0 := R.getVert_zero.symm
        _ = R.getVert R.length := by rw [hzero]
        _ = z := R.getVert_length
    omega
  let d : G.Dart := R.darts[0]'(by simpa using hpos)
  have hdMem : d ∈ R.darts := List.getElem_mem ..
  have hdExternal := firstDart_external_of_common_terminal
    hXY a htX htY hR hpos
  have hdFst : d.fst = t := by
    have hfst := congrArg (fun q : G.Dart => q.fst)
      (R.darts_getElem_eq_getVert 0 (by simpa using hpos))
    simpa [d, R.getVert_zero] using hfst
  exact ⟨d, Or.inr ⟨hdMem, by simpa [d] using hdExternal⟩, hdFst⟩

theorem old_terminal_ne_start_is_toggle_sink {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z y : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (hy : y ∈ Y.toWarp.terminalSet) (hyt : y ≠ t) :
    ¬ (toggleRootedSystem hR ht).HasOutgoing y := by
  rintro ⟨d, hdD, hdFst⟩
  change d ∈ Y.toggleDartSet R at hdD
  rcases hdD with hdOld | hdNew
  · exact Y.toWarp.no_dart_from_terminal hy hdOld.1 hdFst
  · rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdNew.1 with
      ⟨i, hi, hid⟩
    have hdAt : R.darts[i]'(by simpa using hi) = d := by
      apply Dart.ext
      calc
        (R.darts[i]'(by simpa using hi)).toProd =
            (R.getVert i, R.getVert (i + 1)) := by
          simpa using congrArg Dart.toProd
            (R.darts_getElem_eq_getVert i (by simpa using hi))
        _ = d.toProd := hid.symm
    have hdFstAt : d.fst = R.getVert i := congrArg Prod.fst hid
    by_cases hi0 : i = 0
    · subst i
      apply hyt
      calc
        y = d.fst := hdFst.symm
        _ = R.getVert 0 := hdFstAt
        _ = t := R.getVert_zero
    · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
      have hyVertex : R.getVert i ∈ Y.toWarp.vertexSet := by
        have := Y.toWarp.terminalSet_subset_vertexSet hy
        have heq : R.getVert i = y := hdFstAt.symm.trans hdFst
        simpa [heq] using this
      have hprevious := hR.previous_symm_mem_right_of_external
        hiPos hi hyVertex (by simpa [hdAt] using hdNew.2)
      have hprevFst :
          (R.darts[i - 1]'(by simpa using (show i - 1 < R.length by
            omega))).symm.fst = y := by
        change (R.darts[i - 1]'(by simpa using
          (show i - 1 < R.length by omega))).snd = y
        have hsnd := congrArg (fun q : G.Dart => q.snd)
          (R.darts_getElem_eq_getVert (i - 1)
            (by simpa using (show i - 1 < R.length by omega)))
        have hidx : i - 1 + 1 = i := by omega
        have : (R.darts[i - 1]'(by simpa using
            (show i - 1 < R.length by omega))).snd = R.getVert i := by
          simpa only [hidx] using hsnd
        exact this.trans (hdFstAt.symm.trans hdFst)
      exact Y.toWarp.no_dart_from_terminal hy hprevious hprevFst

theorem lastDart_symm_mem_right_of_end_mem {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (hpos : 0 < R.length) (hzY : z ∈ Y.toWarp.vertexSet) :
    (R.darts[R.length - 1]'(by simpa using
      (show R.length - 1 < R.length by omega))).symm ∈
      Y.toWarp.dartSet := by
  let l : G.Dart := R.darts[R.length - 1]'(by simpa using
    (show R.length - 1 < R.length by omega))
  have hlMem : l ∈ R.darts := List.getElem_mem ..
  have hincident := hR.2.2.2.2 R.length hpos (le_refl _) (by
    simpa [R.getVert_length] using hzY)
  have hlastEdge :
      s(R.getVert (R.length - 1), R.getVert R.length) ∈
        Y.toWarp.edgeSet := by
    rcases hincident with hprevious | hnext
    · exact hprevious
    · exact (Nat.lt_irrefl _ hnext.1).elim
  apply (hR.symm_mem_right_iff_edge_mem hlMem).mpr
  have hedge : l.edge =
      s(R.getVert (R.length - 1), R.getVert R.length) := by
    dsimp [l]
    rw [Walk.edge_getElem_darts]
    rw [Walk.getElem_edges]
    congr 2
    omega
  rwa [hedge]

theorem end_is_toggle_sink {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} {t z : V}
    {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (ht : t ∈ Y.toWarp.terminalSet) :
    ¬ (toggleRootedSystem hR ht).HasOutgoing z := by
  classical
  rintro ⟨d, hdD, hdFst⟩
  change d ∈ Y.toggleDartSet R at hdD
  by_cases hzero : R.length = 0
  · have hzt : z = t := by
      calc
        z = R.getVert R.length := R.getVert_length.symm
        _ = R.getVert 0 := by rw [hzero]
        _ = t := R.getVert_zero
    rcases hdD with hdOld | hdNew
    · exact Y.toWarp.no_dart_from_terminal (hzt ▸ ht) hdOld.1
        (by simpa [hzt] using hdFst)
    · have hdarts : R.darts = [] := List.eq_nil_of_length_eq_zero (by
        simpa using hzero)
      simpa [hdarts] using hdNew.1
  · have hpos : 0 < R.length := Nat.pos_of_ne_zero hzero
    let l : G.Dart := R.darts[R.length - 1]'(by simpa using
      (show R.length - 1 < R.length by omega))
    have hlMem : l ∈ R.darts := List.getElem_mem ..
    have hlSnd : l.snd = z := by
      have hsnd := congrArg (fun q : G.Dart => q.snd)
        (R.darts_getElem_eq_getVert (R.length - 1)
          (by simpa using (show R.length - 1 < R.length by omega)))
      have hidx : R.length - 1 + 1 = R.length := by omega
      simpa [l, hidx, R.getVert_length] using hsnd
    rcases hdD with hdOld | hdNew
    · have hzY : z ∈ Y.toWarp.vertexSet := by
        have := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hdOld.1
        simpa [hdFst] using this
      have hlY := lastDart_symm_mem_right_of_end_mem hR hpos hzY
      have heq : d = l.symm :=
        Y.toWarp.dart_eq_of_fst_eq hdOld.1 hlY (by
          calc
            d.fst = z := hdFst
            _ = l.symm.fst := by simp [hlSnd])
      apply hdOld.2
      have : d.symm = l := by rw [heq]; simp
      exact this ▸ hlMem
    · rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdNew.1 with
        ⟨i, hi, hid⟩
      have hdAt : R.darts[i]'(by simpa using hi) = d := by
        apply Dart.ext
        calc
          (R.darts[i]'(by simpa using hi)).toProd =
              (R.getVert i, R.getVert (i + 1)) := by
            simpa using congrArg Dart.toProd
              (R.darts_getElem_eq_getVert i (by simpa using hi))
          _ = d.toProd := hid.symm
      have hdFstAt : d.fst = R.getVert i := congrArg Prod.fst hid
      have hiz : R.getVert i = R.getVert R.length := by
        calc
          R.getVert i = d.fst := hdFstAt.symm
          _ = z := hdFst
          _ = R.getVert R.length := R.getVert_length.symm
      have hiNeLength : i ≠ R.length := by omega
      have hzY : z ∈ Y.toWarp.vertexSet := by
        have := hR.2.2.1 i R.length (Nat.le_of_lt hi) (le_refl _)
          hiNeLength hiz
        have heq : z = R.getVert i := hdFst.symm.trans hdFstAt
        simpa [heq] using this
      have hlY := lastDart_symm_mem_right_of_end_mem hR hpos hzY
      by_cases hi0 : i = 0
      · subst i
        have hzt : z = t := by
          calc
            z = d.fst := hdFst.symm
            _ = R.getVert 0 := hdFstAt
            _ = t := R.getVert_zero
        have hlFst : l.symm.fst = t := by
          change l.snd = t
          exact hlSnd.trans hzt
        exact Y.toWarp.no_dart_from_terminal ht hlY
          (by simpa [l] using hlFst)
      · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
        have hprevious := hR.previous_symm_mem_right_of_external
          hiPos hi (by
            have heq : R.getVert i = z := hdFstAt.symm.trans hdFst
            simpa [heq] using hzY)
          (by simpa [hdAt] using hdNew.2)
        have hprevLt : i - 1 < R.length := by omega
        have hprevSnd :
            (R.darts[i - 1]'(by simpa using hprevLt)).snd = z := by
          have hsnd := congrArg (fun q : G.Dart => q.snd)
            (R.darts_getElem_eq_getVert (i - 1)
              (by simpa using hprevLt))
          have hidx : i - 1 + 1 = i := by omega
          have : (R.darts[i - 1]'(by simpa using hprevLt)).snd =
              R.getVert i := by simpa only [hidx] using hsnd
          exact this.trans (hdFstAt.symm.trans hdFst)
        have hsymmEq :
            (R.darts[i - 1]'(by simpa using hprevLt)).symm = l.symm :=
          Y.toWarp.dart_eq_of_fst_eq hprevious hlY (by
            simpa [hprevSnd, hlSnd])
        have hdartEq : R.darts[i - 1]'(by simpa using hprevLt) = l := by
          have := congrArg Dart.symm hsymmEq
          simpa using this
        have hindex : i - 1 = R.length - 1 :=
          hR.index_eq_of_darts_getElem_eq hprevLt
            (show R.length - 1 < R.length by omega) (by simpa [l] using hdartEq)
        omega

theorem exists_toggle_incoming_of_old_outgoing_of_not_source {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z x : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    {d : G.Dart} (hdY : d ∈ Y.toWarp.dartSet)
    (hdSurvives : d.symm ∉ R.darts) (hdFst : d.fst = x)
    (hxA : x ∉ A) :
    ∃ e ∈ Y.toggleDartSet R, e.snd = x := by
  have hxY : x ∈ Y.toWarp.vertexSet := by
    have := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hdY
    simpa [hdFst] using this
  have hxInitial : x ∉ Y.toWarp.initialSet := by
    simpa [Y.initialSet_toWarp] using hxA
  rcases Y.toWarp.exists_dart_to_of_mem_vertexSet_not_initial hxY hxInitial with
    ⟨e, heY, heSnd⟩
  by_cases heSurvives : e.symm ∉ R.darts
  · exact ⟨e, Or.inl ⟨heY, heSurvives⟩, heSnd⟩
  · push_neg at heSurvives
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heSurvives with
      ⟨i, hi, hie⟩
    have heAt : R.darts[i]'(by simpa using hi) = e.symm := by
      apply Dart.ext
      calc
        (R.darts[i]'(by simpa using hi)).toProd =
            (R.getVert i, R.getVert (i + 1)) := by
          simpa using congrArg Dart.toProd
            (R.darts_getElem_eq_getVert i (by simpa using hi))
        _ = e.symm.toProd := hie.symm
    have hdeparture : R.getVert i = x := by
      have hfst : e.symm.fst = R.getVert i := congrArg Prod.fst hie
      calc
        R.getVert i = e.symm.fst := hfst.symm
        _ = e.snd := rfl
        _ = x := heSnd
    have hiPos : 0 < i := by
      by_contra hi0
      have hi0' : i = 0 := Nat.eq_zero_of_not_pos hi0
      subst i
      have hxt : x = t := by
        calc
          x = R.getVert 0 := hdeparture.symm
          _ = t := R.getVert_zero
      exact Y.toWarp.no_dart_from_terminal (hxt ▸ ht) hdY
        (by simpa [hxt] using hdFst)
    have hprevLt : i - 1 < R.length := by omega
    let p : G.Dart := R.darts[i - 1]'(by simpa using hprevLt)
    have hpMem : p ∈ R.darts := List.getElem_mem ..
    have hpSnd : p.snd = x := by
      have hsnd := congrArg (fun q : G.Dart => q.snd)
        (R.darts_getElem_eq_getVert (i - 1) (by simpa using hprevLt))
      have hidx : i - 1 + 1 = i := by omega
      have : p.snd = R.getVert i := by simpa [p, hidx] using hsnd
      exact this.trans hdeparture
    rcases hR.2.1 p hpMem with hpReverse | hpExternal
    · have hpFst : p.symm.fst = x := by simpa [hpSnd]
      have heq : p.symm = d :=
        Y.toWarp.dart_eq_of_fst_eq hpReverse hdY (hpFst.trans hdFst.symm)
      apply (hdSurvives ?_).elim
      have : d.symm = p := by rw [← heq]; simp
      exact this ▸ hpMem
    · exact ⟨p, Or.inr ⟨hpMem, hpExternal.2⟩, hpSnd⟩

theorem exists_toggle_incoming_of_external_outgoing_of_not_source {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z x : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    {d : G.Dart} (hdR : d ∈ R.darts)
    (hdExternal : d.symm ∉ Y.toWarp.dartSet) (hdFst : d.fst = x)
    (hxA : x ∉ A) :
    ∃ e ∈ Y.toggleDartSet R, e.snd = x := by
  classical
  rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp hdR with
    ⟨i, hi, hid⟩
  have hdAt : R.darts[i]'(by simpa using hi) = d := by
    apply Dart.ext
    calc
      (R.darts[i]'(by simpa using hi)).toProd =
          (R.getVert i, R.getVert (i + 1)) := by
        simpa using congrArg Dart.toProd
          (R.darts_getElem_eq_getVert i (by simpa using hi))
      _ = d.toProd := hid.symm
  have hdeparture : R.getVert i = x := by
    have hfst : d.fst = R.getVert i := congrArg Prod.fst hid
    exact hfst.symm.trans hdFst
  by_cases hi0 : i = 0
  · subst i
    have hxt : x = t := by
      calc
        x = R.getVert 0 := hdeparture.symm
        _ = t := R.getVert_zero
    have hxY : x ∈ Y.toWarp.vertexSet :=
      hxt ▸ Y.toWarp.terminalSet_subset_vertexSet ht
    have hxInitial : x ∉ Y.toWarp.initialSet := by
      simpa [Y.initialSet_toWarp] using hxA
    rcases Y.toWarp.exists_dart_to_of_mem_vertexSet_not_initial
        hxY hxInitial with ⟨e, heY, heSnd⟩
    by_cases heSurvives : e.symm ∉ R.darts
    · exact ⟨e, Or.inl ⟨heY, heSurvives⟩, heSnd⟩
    · push_neg at heSurvives
      rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heSurvives with
        ⟨j, hj, hje⟩
      have heAt : R.darts[j]'(by simpa using hj) = e.symm := by
        apply Dart.ext
        calc
          (R.darts[j]'(by simpa using hj)).toProd =
              (R.getVert j, R.getVert (j + 1)) := by
            simpa using congrArg Dart.toProd
              (R.darts_getElem_eq_getVert j (by simpa using hj))
          _ = e.symm.toProd := hje.symm
      have hjPos : 0 < j := by
        by_contra hj0
        have hj0' : j = 0 := Nat.eq_zero_of_not_pos hj0
        subst j
        have hed : d = e.symm := hdAt.symm.trans heAt
        apply hdExternal
        rw [hed]
        simpa using heY
      have hprevLt : j - 1 < R.length := by omega
      let p : G.Dart := R.darts[j - 1]'(by simpa using hprevLt)
      have hpMem : p ∈ R.darts := List.getElem_mem ..
      have hpSnd : p.snd = x := by
        have hsnd := congrArg (fun q : G.Dart => q.snd)
          (R.darts_getElem_eq_getVert (j - 1) (by simpa using hprevLt))
        have hidx : j - 1 + 1 = j := by omega
        have hpj : p.snd = R.getVert j := by simpa [p, hidx] using hsnd
        have hjeFst : e.symm.fst = R.getVert j := congrArg Prod.fst hje
        exact hpj.trans (hjeFst.symm.trans (by simpa using heSnd))
      rcases hR.2.1 p hpMem with hpReverse | hpExternal
      · have hpFst : p.symm.fst = t := by
          change p.snd = t
          exact hpSnd.trans hxt
        exact (Y.toWarp.no_dart_from_terminal ht hpReverse hpFst).elim
      · exact ⟨p, Or.inr ⟨hpMem, hpExternal.2⟩, hpSnd⟩
  · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
    have hprevLt : i - 1 < R.length := by omega
    let p : G.Dart := R.darts[i - 1]'(by simpa using hprevLt)
    have hpMem : p ∈ R.darts := List.getElem_mem ..
    have hpSnd : p.snd = x := by
      have hsnd := congrArg (fun q : G.Dart => q.snd)
        (R.darts_getElem_eq_getVert (i - 1) (by simpa using hprevLt))
      have hidx : i - 1 + 1 = i := by omega
      have : p.snd = R.getVert i := by simpa [p, hidx] using hsnd
      exact this.trans hdeparture
    rcases hR.2.1 p hpMem with hpReverse | hpExternal
    · have hpOutFst : p.symm.fst = x := by simpa [hpSnd]
      have hxY : x ∈ Y.toWarp.vertexSet := by
        have := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hpReverse
        rw [hpOutFst] at this
        exact this
      have hxInitial : x ∉ Y.toWarp.initialSet := by
        simpa [Y.initialSet_toWarp] using hxA
      rcases Y.toWarp.exists_dart_to_of_mem_vertexSet_not_initial
          hxY hxInitial with ⟨e, heY, heSnd⟩
      by_cases heSurvives : e.symm ∉ R.darts
      · exact ⟨e, Or.inl ⟨heY, heSurvives⟩, heSnd⟩
      · push_neg at heSurvives
        rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heSurvives with
          ⟨j, hj, hje⟩
        have heAt : R.darts[j]'(by simpa using hj) = e.symm := by
          apply Dart.ext
          calc
            (R.darts[j]'(by simpa using hj)).toProd =
                (R.getVert j, R.getVert (j + 1)) := by
              simpa using congrArg Dart.toProd
                (R.darts_getElem_eq_getVert j (by simpa using hj))
            _ = e.symm.toProd := hje.symm
        have hjPos : 0 < j := by
          by_contra hj0
          have hj0' : j = 0 := Nat.eq_zero_of_not_pos hj0
          subst j
          have hxt : x = t := by
            have hjeFst : e.symm.fst = R.getVert 0 :=
              congrArg Prod.fst hje
            calc
              x = e.snd := heSnd.symm
              _ = e.symm.fst := rfl
              _ = R.getVert 0 := hjeFst
              _ = t := R.getVert_zero
          exact Y.toWarp.no_dart_from_terminal (hxt ▸ ht) hpReverse
            (hpOutFst.trans hxt)
        have hrLt : j - 1 < R.length := by omega
        let r : G.Dart := R.darts[j - 1]'(by simpa using hrLt)
        have hrMem : r ∈ R.darts := List.getElem_mem ..
        have hrSnd : r.snd = x := by
          have hsnd := congrArg (fun q : G.Dart => q.snd)
            (R.darts_getElem_eq_getVert (j - 1) (by simpa using hrLt))
          have hidx : j - 1 + 1 = j := by omega
          have hrj : r.snd = R.getVert j := by simpa [r, hidx] using hsnd
          have hjeFst : e.symm.fst = R.getVert j := congrArg Prod.fst hje
          exact hrj.trans (hjeFst.symm.trans (by simpa using heSnd))
        rcases hR.2.1 r hrMem with hrReverse | hrExternal
        · have hrOutFst : r.symm.fst = x := by simpa [hrSnd]
          have hsymmEq : r.symm = p.symm :=
            Y.toWarp.dart_eq_of_fst_eq hrReverse hpReverse
              (hrOutFst.trans hpOutFst.symm)
          have hrp : r = p := by
            have := congrArg Dart.symm hsymmEq
            simpa using this
          have hindices : j - 1 = i - 1 :=
            hR.index_eq_of_darts_getElem_eq hrLt hprevLt
              (by simpa [r, p] using hrp)
          have hji : j = i := by omega
          subst j
          have hed : d = e.symm := hdAt.symm.trans heAt
          have : d.symm ∈ Y.toWarp.dartSet := by
            rw [hed]
            simpa using heY
          exact (hdExternal this).elim
        · exact ⟨r, Or.inr ⟨hrMem, hrExternal.2⟩, hrSnd⟩
    · exact ⟨p, Or.inr ⟨hpMem, hpExternal.2⟩, hpSnd⟩

theorem exists_toggle_incoming_of_outgoing_of_not_source {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z x : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (hxA : x ∉ A) (hout : (toggleRootedSystem hR ht).HasOutgoing x) :
    ∃ e ∈ Y.toggleDartSet R, e.snd = x := by
  rcases hout with ⟨d, hdD, hdFst⟩
  change d ∈ Y.toggleDartSet R at hdD
  rcases hdD with hdOld | hdNew
  · exact exists_toggle_incoming_of_old_outgoing_of_not_source
      hR ht hdOld.1 hdOld.2 hdFst hxA
  · exact exists_toggle_incoming_of_external_outgoing_of_not_source
      hR ht hdNew.1 hdNew.2 hdFst hxA

theorem toggle_sink_mem_switchedWarp_of_incoming {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z x : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (hsink : ¬ (toggleRootedSystem hR ht).HasOutgoing x)
    (hxIncoming : (toggleRootedSystem hR ht).HasIncoming x) :
    x ∈ (switchedWarp hR ht).vertexSet := by
  let D := toggleRootedSystem hR ht
  change x ∈ D.toWarp.vertexSet
  apply D.sink_mem_toWarp_of_finite_perturbation
      Y.toWarp.dartSet {d | d ∈ R.darts} Y.toWarp.dartDepth
  · exact R.darts.finite_toSet
  · intro d hd
    change d ∈ Y.toggleDartSet R at hd
    rcases hd with hold | hnew
    · exact Or.inl hold.1
    · exact Or.inr hnew.1
  · intro e d he hd hed
    exact Y.toWarp.dartDepth_lt_of_snd_eq_fst he hd hed
  · intro y hyA hout
    exact exists_toggle_incoming_of_outgoing_of_not_source hR ht hyA hout
  · exact hsink
  · exact hxIncoming

theorem old_terminal_ne_start_mem_switchedWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z y : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet)
    (hy : y ∈ Y.toWarp.terminalSet) (hyt : y ≠ t) :
    y ∈ (switchedWarp hR ht).vertexSet := by
  classical
  by_cases hyA : y ∈ A
  · apply (switchedWarp hR ht).initialSet_subset_vertexSet
    simpa [switchedWarp_initialSet] using hyA
  have hyVertex := Y.toWarp.terminalSet_subset_vertexSet hy
  have hyInitial : y ∉ Y.toWarp.initialSet := by
    simpa [Y.initialSet_toWarp] using hyA
  rcases Y.toWarp.exists_dart_to_of_mem_vertexSet_not_initial
      hyVertex hyInitial with ⟨e, heY, heSnd⟩
  have hyIncoming : (toggleRootedSystem hR ht).HasIncoming y := by
    by_cases heSurvives : e.symm ∉ R.darts
    · exact ⟨e, Or.inl ⟨heY, heSurvives⟩, heSnd⟩
    · push Not at heSurvives
      rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heSurvives with
        ⟨i, hi, hie⟩
      have heAt : R.darts[i]'(by simpa using hi) = e.symm := by
        apply Dart.ext
        calc
          (R.darts[i]'(by simpa using hi)).toProd =
              (R.getVert i, R.getVert (i + 1)) := by
            simpa using congrArg Dart.toProd
              (R.darts_getElem_eq_getVert i (by simpa using hi))
          _ = e.symm.toProd := hie.symm
      have hdeparture : R.getVert i = y := by
        have hfst : e.symm.fst = R.getVert i := congrArg Prod.fst hie
        calc
          R.getVert i = e.symm.fst := hfst.symm
          _ = e.snd := rfl
          _ = y := heSnd
      have hiPos : 0 < i := by
        by_contra hi0
        have hi0' : i = 0 := Nat.eq_zero_of_not_pos hi0
        subst i
        apply hyt
        calc
          y = R.getVert 0 := hdeparture.symm
          _ = t := R.getVert_zero
      have hprevLt : i - 1 < R.length := by omega
      let p : G.Dart := R.darts[i - 1]'(by simpa using hprevLt)
      have hpMem : p ∈ R.darts := List.getElem_mem ..
      have hpSnd : p.snd = y := by
        have hsnd := congrArg (fun q : G.Dart => q.snd)
          (R.darts_getElem_eq_getVert (i - 1) (by simpa using hprevLt))
        have hidx : i - 1 + 1 = i := by omega
        have : p.snd = R.getVert i := by simpa [p, hidx] using hsnd
        exact this.trans hdeparture
      rcases hR.2.1 p hpMem with hpReverse | hpExternal
      · exact (Y.toWarp.no_dart_from_terminal hy hpReverse (by
          change p.snd = y
          exact hpSnd)).elim
      · exact ⟨p, Or.inr ⟨hpMem, hpExternal.2⟩, hpSnd⟩
  exact toggle_sink_mem_switchedWarp_of_incoming hR ht
    (old_terminal_ne_start_is_toggle_sink hR ht hy hyt) hyIncoming

theorem end_mem_switchedWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z}
    (hR : X.IsAlternatingWalk Y R) (ht : t ∈ Y.toWarp.terminalSet) :
    z ∈ (switchedWarp hR ht).vertexSet := by
  classical
  by_cases hzA : z ∈ A
  · apply (switchedWarp hR ht).initialSet_subset_vertexSet
    simpa [switchedWarp_initialSet] using hzA
  have hzIncoming : (toggleRootedSystem hR ht).HasIncoming z := by
    by_cases hzero : R.length = 0
    · have hzt : z = t := by
        calc
          z = R.getVert R.length := R.getVert_length.symm
          _ = R.getVert 0 := by rw [hzero]
          _ = t := R.getVert_zero
      have hzVertex : z ∈ Y.toWarp.vertexSet :=
        hzt ▸ Y.toWarp.terminalSet_subset_vertexSet ht
      have hzInitial : z ∉ Y.toWarp.initialSet := by
        simpa [Y.initialSet_toWarp] using hzA
      rcases Y.toWarp.exists_dart_to_of_mem_vertexSet_not_initial
          hzVertex hzInitial with ⟨e, heY, heSnd⟩
      have hdarts : R.darts = [] := List.eq_nil_of_length_eq_zero (by
        simpa using hzero)
      exact ⟨e, Or.inl ⟨heY, by simp [hdarts]⟩, heSnd⟩
    · have hpos : 0 < R.length := Nat.pos_of_ne_zero hzero
      have hlastLt : R.length - 1 < R.length := by omega
      let l : G.Dart := R.darts[R.length - 1]'(by simpa using hlastLt)
      have hlMem : l ∈ R.darts := List.getElem_mem ..
      have hlSnd : l.snd = z := by
        have hsnd := congrArg (fun q : G.Dart => q.snd)
          (R.darts_getElem_eq_getVert (R.length - 1)
            (by simpa using hlastLt))
        have hidx : R.length - 1 + 1 = R.length := by omega
        simpa [l, hidx, R.getVert_length] using hsnd
      rcases hR.2.1 l hlMem with hlReverse | hlExternal
      · have hzVertex : z ∈ Y.toWarp.vertexSet := by
          have := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hlReverse
          simpa [hlSnd] using this
        have hzInitial : z ∉ Y.toWarp.initialSet := by
          simpa [Y.initialSet_toWarp] using hzA
        rcases Y.toWarp.exists_dart_to_of_mem_vertexSet_not_initial
            hzVertex hzInitial with ⟨e, heY, heSnd⟩
        by_cases heSurvives : e.symm ∉ R.darts
        · exact ⟨e, Or.inl ⟨heY, heSurvives⟩, heSnd⟩
        · push Not at heSurvives
          rcases (Erdos599.Walk.mem_darts_iff_exists_getVert R).mp heSurvives with
            ⟨i, hi, hie⟩
          have heAt : R.darts[i]'(by simpa using hi) = e.symm := by
            apply Dart.ext
            calc
              (R.darts[i]'(by simpa using hi)).toProd =
                  (R.getVert i, R.getVert (i + 1)) := by
                simpa using congrArg Dart.toProd
                  (R.darts_getElem_eq_getVert i (by simpa using hi))
              _ = e.symm.toProd := hie.symm
          have hdeparture : R.getVert i = z := by
            have hfst : e.symm.fst = R.getVert i := congrArg Prod.fst hie
            calc
              R.getVert i = e.symm.fst := hfst.symm
              _ = e.snd := rfl
              _ = z := heSnd
          have hiPos : 0 < i := by
            by_contra hi0
            have hi0' : i = 0 := Nat.eq_zero_of_not_pos hi0
            subst i
            have hzt : z = t := by
              calc
                z = R.getVert 0 := hdeparture.symm
                _ = t := R.getVert_zero
            exact Y.toWarp.no_dart_from_terminal ht hlReverse (by
              calc
                l.symm.fst = z := by simpa using hlSnd
                _ = t := hzt)
          have hprevLt : i - 1 < R.length := by omega
          let p : G.Dart := R.darts[i - 1]'(by simpa using hprevLt)
          have hpMem : p ∈ R.darts := List.getElem_mem ..
          have hpSnd : p.snd = z := by
            have hsnd := congrArg (fun q : G.Dart => q.snd)
              (R.darts_getElem_eq_getVert (i - 1) (by simpa using hprevLt))
            have hidx : i - 1 + 1 = i := by omega
            have : p.snd = R.getVert i := by simpa [p, hidx] using hsnd
            exact this.trans hdeparture
          rcases hR.2.1 p hpMem with hpReverse | hpExternal
          · have hsymm : p.symm = l.symm :=
              Y.toWarp.dart_eq_of_fst_eq hpReverse hlReverse (by
                calc
                  p.symm.fst = z := by simpa using hpSnd
                  _ = l.symm.fst := by simpa using hlSnd.symm)
            have hpl : p = l := by
              have := congrArg Dart.symm hsymm
              simpa using this
            have hindices : i - 1 = R.length - 1 :=
              hR.index_eq_of_darts_getElem_eq hprevLt hlastLt
                (by simpa [p, l] using hpl)
            omega
          · exact ⟨p, Or.inr ⟨hpMem, hpExternal.2⟩, hpSnd⟩
      · exact ⟨l, Or.inr ⟨hlMem, hlExternal.2⟩, hlSnd⟩
  exact toggle_sink_mem_switchedWarp_of_incoming hR ht
    (end_is_toggle_sink hR ht) hzIncoming

theorem switchedWarp_terminalSet_subset_exchange {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hXY : X ≤ Y) (a : A)
    (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t)
    (hR : X.IsAlternatingWalk Y R) :
    (switchedWarp hR ⟨a, htY⟩).terminalSet ⊆
      (Y.toWarp.terminalSet \ {t}) ∪ {z} := by
  intro x hx
  let ht : t ∈ Y.toWarp.terminalSet := ⟨a, htY⟩
  have hx' : x ∈ (toggleRootedSystem hR ht).toWarp.terminalSet := hx
  rw [RootedDartSystem.terminalSet_toWarp] at hx'
  rcases reachable_toggle_sink_mem_terminal_or_eq_end hR ht hx'.1 hx'.2 with
    hxY | hxz
  · by_cases hxt : x = t
    · subst x
      by_cases htz : t = z
      · exact Or.inr (by simpa [htz])
      · exact (hx'.2 (start_hasOutgoing_of_ne_end
          hXY a htX htY hR ht htz)).elim
    · exact Or.inl ⟨hxY, by simpa using hxt⟩
  · exact Or.inr (by simpa [hxz])

/-- Shafer Lemma 3.10, terminal calculation: toggling along the finite
alternating walk replaces exactly its common starting terminal by its final
vertex. -/
theorem switchedWarp_terminalSet_eq_exchange {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hXY : X ≤ Y) (a : A)
    (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t)
    (hR : X.IsAlternatingWalk Y R) :
    (switchedWarp hR ⟨a, htY⟩).terminalSet =
      (Y.toWarp.terminalSet \ {t}) ∪ {z} := by
  let ht : t ∈ Y.toWarp.terminalSet := ⟨a, htY⟩
  apply Set.Subset.antisymm
  · exact switchedWarp_terminalSet_subset_exchange hXY a htX htY hR
  · intro x hx
    change x ∈ (toggleRootedSystem hR ht).toWarp.terminalSet
    rw [RootedDartSystem.terminalSet_toWarp]
    rcases hx with hxOld | hxEnd
    · have hxt : x ≠ t := by simpa using hxOld.2
      exact ⟨old_terminal_ne_start_mem_switchedWarp hR ht hxOld.1 hxt,
        old_terminal_ne_start_is_toggle_sink hR ht hxOld.1 hxt⟩
    · have hxz : x = z := by simpa using hxEnd
      subst x
      exact ⟨end_mem_switchedWarp hR ht, end_is_toggle_sink hR ht⟩

/-- Shafer Lemma 3.10 in the indexed form used below: switching along an
alternating walk produces a warp extending the left warp path by path and
performs exactly the asserted one-terminal exchange. -/
theorem alternatingWalk_switching {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    {t z : V} {R : G.Walk t z} (hXY : X ≤ Y) (a : A)
    (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t)
    (hR : X.IsAlternatingWalk Y R) :
    (∀ b, (X.path b).1.Forward
      ((switchedWarp hR ⟨a, htY⟩).path b)) ∧
    (switchedWarp hR ⟨a, htY⟩).terminalSet =
      (Y.toWarp.terminalSet \ {t}) ∪ {z} := by
  exact ⟨left_paths_forward_switchedWarp hXY hR ⟨a, htY⟩,
    switchedWarp_terminalSet_eq_exchange hXY a htX htY hR⟩

/-- A vertex is alternatingly reachable from `t` relative to the pair
`(X,Y)` when it occurs on a finite alternating walk.  This is the notion used
in Shafer's Definition 3.9: the alternating extension stops at the last
vertex of a right-hand component which *lies on* such a walk. -/
def IsAlternatingReachable {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X Y : TotalWave G A B) (t v : V) : Prop :=
  ∃ (z : V) (R : G.Walk t z), X.IsAlternatingWalk Y R ∧ v ∈ R.support

/-- Active indices of the alternating-reachability extension on one source
path.  We retain all of `X` and the lower closure, inside the corresponding
`Y` path, of every alternatingly reachable index. -/
def alternatingActiveSet {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X Y : TotalWave G A B) (t : V) (a : A) : Set ℕ :=
  {n | longPathActive (X.path a).1.terminalIndex n ∨
    ∃ m, n ≤ m ∧ longPathActive (Y.path a).1.terminalIndex m ∧
      IsAlternatingReachable X Y t ((Y.path a).1.vertex m)}

theorem alternatingActiveSet_nonempty {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X Y : TotalWave G A B) (t : V) (a : A) :
    (alternatingActiveSet X Y t a).Nonempty := by
  refine ⟨0, Or.inl ?_⟩
  cases (X.path a).1.terminalIndex <;> simp [longPathActive]

theorem alternatingActiveSet_lower {V : Type} {G : SimpleGraph V}
    {A B : Set V} (X Y : TotalWave G A B) (t : V) (a : A)
    {m n : ℕ} (hmn : m ≤ n) (hn : n ∈ alternatingActiveSet X Y t a) :
    m ∈ alternatingActiveSet X Y t a := by
  rcases hn with hnX | ⟨k, hnk, hkY, hkReach⟩
  · exact Or.inl (LongPath.active_mono hmn hnX)
  · exact Or.inr ⟨k, hmn.trans hnk, hkY, hkReach⟩

theorem alternatingActiveSet_subset_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) :
    alternatingActiveSet X Y t a ⊆
      {n | longPathActive (Y.path a).1.terminalIndex n} := by
  intro n hn
  rcases hn with hnX | ⟨m, hnm, hmY, -⟩
  · exact (hXY a n hnX).1
  · exact LongPath.active_mono hnm hmY

noncomputable def alternatingPath {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y)
    (t : V) (a : A) : LongPath G :=
  (Y.path a).1.restrictToLowerSet
    (alternatingActiveSet X Y t a)
    (alternatingActiveSet_nonempty X Y t a)
    (alternatingActiveSet_lower X Y t a)
    (alternatingActiveSet_subset_right hXY t a)

@[simp] theorem active_alternatingPath_iff {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) (n : ℕ) :
    longPathActive (alternatingPath hXY t a).terminalIndex n ↔
      n ∈ alternatingActiveSet X Y t a := by
  unfold alternatingPath
  apply LongPath.active_restrictToLowerSet_iff

@[simp] theorem vertex_alternatingPath {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) (n : ℕ) :
    (alternatingPath hXY t a).vertex n = (Y.path a).1.vertex n := by
  unfold alternatingPath
  rfl

theorem left_forward_alternatingPath {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) :
    (X.path a).1.Forward (alternatingPath hXY t a) := by
  intro n hn
  refine ⟨(active_alternatingPath_iff hXY t a n).mpr (Or.inl hn), ?_⟩
  exact (vertex_alternatingPath hXY t a n).trans (hXY a n hn).2

theorem alternatingPath_forward_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) :
    (alternatingPath hXY t a).Forward (Y.path a).1 := by
  unfold alternatingPath
  apply LongPath.restrictToLowerSet_forward

theorem reachable_vertex_mem_alternatingPath {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) {n : ℕ}
    (hn : longPathActive (Y.path a).1.terminalIndex n)
    (hreach : IsAlternatingReachable X Y t ((Y.path a).1.vertex n)) :
    (Y.path a).1.vertex n ∈ (alternatingPath hXY t a).vertexSet := by
  refine ⟨n, (active_alternatingPath_iff hXY t a n).mpr ?_,
    (vertex_alternatingPath hXY t a n).symm⟩
  exact Or.inr ⟨n, le_rfl, hn, hreach⟩

noncomputable def alternatingWarp {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y)
    (t : V) : Warp G :=
  Warp.ofPaths (alternatingPath hXY t) (by
    intro a b hab
    rw [Set.disjoint_left]
    intro v hva hvb
    have hvaY := (alternatingPath_forward_right hXY t a).vertexSet_subset hva
    have hvbY := (alternatingPath_forward_right hXY t b).vertexSet_subset hvb
    exact Set.disjoint_left.mp (Y.disjoint hab) hvaY hvbY)

@[simp] theorem alternatingWarp_initialSet {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) :
    (alternatingWarp hXY t).initialSet = A := by
  ext v
  constructor
  · rintro ⟨a, ha⟩
    have hstart := Y.path_initial a
    change (alternatingPath hXY t a).initial = v at ha
    have hpathStart : (alternatingPath hXY t a).initial =
        (Y.path a).1.initial := vertex_alternatingPath hXY t a 0
    rw [hpathStart, hstart] at ha
    exact ha ▸ a.property
  · intro hv
    let a : A := ⟨v, hv⟩
    refine ⟨a, ?_⟩
    change (alternatingPath hXY t a).initial = v
    calc
      (alternatingPath hXY t a).initial = (Y.path a).1.initial :=
        vertex_alternatingPath hXY t a 0
      _ = (a : V) := Y.path_initial a
      _ = v := rfl

theorem alternatingWarp_vertexSet_subset_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) :
    (alternatingWarp hXY t).vertexSet ⊆ Y.toWarp.vertexSet := by
  rintro v ⟨a, hva⟩
  exact ⟨a, (alternatingPath_forward_right hXY t a).vertexSet_subset hva⟩

/-- The alternating extension contains the whole left warp. -/
theorem left_vertexSet_subset_alternatingWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) :
    X.toWarp.vertexSet ⊆ (alternatingWarp hXY t).vertexSet := by
  rintro v ⟨a, hva⟩
  exact ⟨a, (left_forward_alternatingPath hXY t a).vertexSet_subset hva⟩

/-- If the successor of a vertex on a right-hand component is not retained
by the alternating extension, then that vertex cannot be an interior vertex
of the left warp. -/
theorem right_predecessor_mem_left_is_terminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) (a : A) {n : ℕ}
    (hsuccY : longPathActive (Y.path a).1.terminalIndex (n + 1))
    (hnext : (Y.path a).1.vertex (n + 1) ∉
      (alternatingWarp hXY t).vertexSet)
    (hpred : (Y.path a).1.vertex n ∈ X.toWarp.vertexSet) :
    (Y.path a).1.vertex n ∈ X.toWarp.terminalSet := by
  classical
  rcases hpred with ⟨b, k, hkX, hkv⟩
  have hkY := hXY b k hkX
  have hnY := LongPath.active_mono (Nat.le_succ n) hsuccY
  have hba : b = a := by
    by_contra hba
    have hva : (Y.path a).1.vertex n ∈ (Y.path a).1.vertexSet :=
      ⟨n, hnY, rfl⟩
    have hvb : (Y.path a).1.vertex n ∈ (Y.path b).1.vertexSet :=
      ⟨k, hkY.1, hkY.2.trans hkv⟩
    exact Set.disjoint_left.mp (Y.disjoint hba) hvb hva
  subst b
  have hkn : k = n :=
    (Y.path a).1.injective hkY.1 hnY (hkY.2.trans hkv)
  subst k
  by_contra hnotTerminal
  have hnotExact : (X.path a).1.terminal? ≠
      some ((X.path a).1.vertex n) := by
    intro hterm
    apply hnotTerminal
    refine ⟨a, ?_⟩
    exact hterm.trans (congrArg some (hkv.trans rfl))
  have hsuccX : longPathActive (X.path a).1.terminalIndex (n + 1) :=
    (X.path a).1.active_succ_of_active_of_terminal_ne hkX hnotExact
  have hsuccAlt := left_forward_alternatingPath hXY t a (n + 1) hsuccX
  apply hnext
  refine ⟨a, n + 1, hsuccAlt.1, ?_⟩
  calc
    (alternatingPath hXY t a).vertex (n + 1) =
        (Y.path a).1.vertex (n + 1) := vertex_alternatingPath hXY t a (n + 1)

/-- A terminal of `Y` which is retained by the alternating prefix warp is
also a terminal of that prefix warp. -/
theorem right_terminal_mem_alternatingWarp_terminalSet {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) {v : V}
    (hvY : v ∈ Y.toWarp.terminalSet)
    (hvU : v ∈ (alternatingWarp hXY t).vertexSet) :
    v ∈ (alternatingWarp hXY t).terminalSet := by
  classical
  change ∃ a, (Y.path a).1.terminal? = some v at hvY
  change ∃ b, v ∈ (alternatingPath hXY t b).vertexSet at hvU
  rcases hvY with ⟨a, ha⟩
  rcases hvU with ⟨b, hb⟩
  have hab : a = b := by
    by_contra hab
    have hva : v ∈ (Y.path a).1.vertexSet :=
      LongPath.terminal_mem_vertexSet ha
    have hvb : v ∈ (Y.path b).1.vertexSet :=
      (alternatingPath_forward_right hXY t b).vertexSet_subset hb
    exact Set.disjoint_left.mp (Y.disjoint hab) hva hvb
  subst b
  refine ⟨a, ?_⟩
  exact (alternatingPath_forward_right hXY t a).terminal_of_mem_of_terminal
    ha hb

/-- On an `A`--`B` path, the last vertex belonging to a wave is a terminal
of that wave.  Prefix the wave component through the vertex to the remaining
suffix of the path and apply the separator property. -/
theorem last_wave_vertex_is_terminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} (X : TotalWave G A B)
    {a b : V} (ha : a ∈ A) (hb : b ∈ B) (q : G.Walk a b)
    (hq : q.IsPath) {n : ℕ} (hn : n ≤ q.length)
    (hnX : q.getVert n ∈ X.toWarp.vertexSet)
    (hnlast : ∀ m ≤ q.length, n < m →
      q.getVert m ∉ X.toWarp.vertexSet) :
    q.getVert n ∈ X.toWarp.terminalSet := by
  classical
  change ∃ c, q.getVert n ∈ (X.path c).1.vertexSet at hnX
  rcases hnX with ⟨c, k, hkX, hkw⟩
  let pref : G.Walk (X.path c).1.initial (q.getVert n) :=
    ((X.path c).1.prefixWalk k hkX).copy rfl hkw
  let combined : G.Walk (X.path c).1.initial b := pref.append (q.drop n)
  let r : G.Path (X.path c).1.initial b := combined.toPath
  have hstart : (X.path c).1.initial ∈ A := X.isWave.1 ⟨c, rfl⟩
  rcases X.isWave.2 (X.path c).1.initial hstart b hb
      (r : G.Walk (X.path c).1.initial b) r.property with
    ⟨v, hvr, hvTerminal⟩
  have hvCombined : v ∈ combined.support :=
    combined.support_toPath_subset_support hvr
  rw [show combined = pref.append (q.drop n) by rfl,
    Walk.mem_support_append_iff] at hvCombined
  rcases hvCombined with hvPref | hvDrop
  · have hvPref' : v ∈ ((X.path c).1.prefixWalk k hkX).support := by
      change v ∈ (((X.path c).1.prefixWalk k hkX).copy rfl hkw).support
        at hvPref
      simpa only [Walk.support_copy] using hvPref
    rcases ((X.path c).1.mem_support_prefixWalk_iff hkX).mp hvPref' with
      ⟨m, hmk, hmv⟩
    change ∃ d, (X.path d).1.terminal? = some v at hvTerminal
    rcases hvTerminal with ⟨d, hd⟩
    have hdc : d = c := by
      by_contra hdc
      have hvd : v ∈ (X.path d).1.vertexSet :=
        LongPath.terminal_mem_vertexSet hd
      have hvc : v ∈ (X.path c).1.vertexSet :=
        ⟨m, LongPath.active_mono hmk hkX, hmv⟩
      exact Set.disjoint_left.mp (X.disjoint hdc) hvd hvc
    subst d
    rcases LongPath.terminal?_eq_some_iff.mp hd with
      ⟨l, hlFinite, hlv⟩
    have hlX : longPathActive (X.path c).1.terminalIndex l := by
      simp [hlFinite, longPathActive]
    have hmX := LongPath.active_mono hmk hkX
    have hml : m = l :=
      (X.path c).1.injective hmX hlX (hmv.trans hlv.symm)
    have hkl : k = l := by
      have hkle : k ≤ l := by simpa [hlFinite, longPathActive] using hkX
      omega
    refine ⟨c, ?_⟩
    calc
      (X.path c).1.terminal? = some v := hd
      _ = some (q.getVert n) := by
        congr 1
        calc
          v = (X.path c).1.vertex k := by rw [hkl, hlv]
          _ = q.getVert n := hkw
  · rcases Walk.mem_support_iff_exists_getVert.mp hvDrop with
      ⟨j, hjv, hjle⟩
    have hglobalLe : n + j ≤ q.length := by
      rw [Walk.drop_length] at hjle
      omega
    have hglobalX : q.getVert (n + j) ∈ X.toWarp.vertexSet := by
      have hvX := X.toWarp.terminalSet_subset_vertexSet hvTerminal
      rw [← q.drop_getVert n j, hjv]
      exact hvX
    have hj0 : j = 0 := by
      by_contra hj0
      exact hnlast (n + j) hglobalLe (by omega) hglobalX
    subst j
    have hvn : v = q.getVert n := by simpa using hjv.symm
    exact hvn ▸ hvTerminal

/-- For an exterior wave, a last contact on an ambient `A`--`B` path is a
wave terminal whenever the deleted vertex occurs strictly before that
contact.  The suffix after the contact avoids the deleted vertex, so it can
be prefixed by the exterior wave component and tested against the exterior
separator. -/
theorem last_exterior_wave_vertex_after_deleted_is_terminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {x : V}
    (U : TotalWave (outsideGraph G {x}) A (B \ {x}))
    {a b : V} (ha : a ∈ A) (hb : b ∈ B) (q : G.Walk a b)
    (hq : q.IsPath) {ix n : ℕ} (hix : ix ≤ q.length)
    (hixx : q.getVert ix = x) (hn : n ≤ q.length) (hixn : ix < n)
    (hnU : q.getVert n ∈ U.toWarp.vertexSet)
    (hnlast : ∀ m ≤ q.length, n < m →
      q.getVert m ∉ U.toWarp.vertexSet) :
    q.getVert n ∈ U.toWarp.terminalSet := by
  classical
  change ∃ c, q.getVert n ∈ (U.path c).1.vertexSet at hnU
  rcases hnU with ⟨c, k, hkU, hkw⟩
  let pref : (outsideGraph G {x}).Walk
      (U.path c).1.initial (q.getVert n) :=
    ((U.path c).1.prefixWalk k hkU).copy rfl hkw
  have hxNotDrop : ∀ v ∈ (q.drop n).support,
      v ∉ ({x} : Set V) := by
    intro v hv hvx
    have hvx' : v = x := Set.mem_singleton_iff.mp hvx
    rcases Walk.mem_support_iff_exists_getVert.mp hv with
      ⟨j, hjv, hjle⟩
    have hglobal : n + j ≤ q.length := by
      rw [Walk.drop_length] at hjle
      omega
    have hget : q.getVert (n + j) = x := by
      calc
        q.getVert (n + j) = (q.drop n).getVert j :=
          (q.drop_getVert n j).symm
        _ = v := hjv
        _ = x := hvx'
    have hindex : n + j = ix :=
      hq.getVert_injOn hglobal hix (hget.trans hixx.symm)
    omega
  let suffix : (outsideGraph G {x}).Walk (q.getVert n) b :=
    Erdos599.Walk.toOutsideGraph (q.drop n) hxNotDrop
  let combined : (outsideGraph G {x}).Walk (U.path c).1.initial b :=
    pref.append suffix
  let r : (outsideGraph G {x}).Path (U.path c).1.initial b :=
    combined.toPath
  have hstart : (U.path c).1.initial ∈ A := U.isWave.1 ⟨c, rfl⟩
  have hbx : b ≠ x := by
    intro hbx
    have hblength : q.getVert q.length = x := by simpa [hbx]
    have hilength : ix = q.length :=
      hq.getVert_injOn hix
        (show q.length ≤ q.length from le_rfl)
        (hixx.trans hblength.symm)
    omega
  rcases U.isWave.2 (U.path c).1.initial hstart b
      ⟨hb, by simpa using hbx⟩
      (r : (outsideGraph G {x}).Walk (U.path c).1.initial b)
      r.property with ⟨v, hvr, hvTerminal⟩
  have hvCombined : v ∈ combined.support :=
    combined.support_toPath_subset_support hvr
  rw [show combined = pref.append suffix by rfl,
    Walk.mem_support_append_iff] at hvCombined
  rcases hvCombined with hvPref | hvSuffix
  · have hvPref' : v ∈ ((U.path c).1.prefixWalk k hkU).support := by
      change v ∈ (((U.path c).1.prefixWalk k hkU).copy rfl hkw).support
        at hvPref
      simpa only [Walk.support_copy] using hvPref
    rcases ((U.path c).1.mem_support_prefixWalk_iff hkU).mp hvPref' with
      ⟨m, hmk, hmv⟩
    change ∃ d, (U.path d).1.terminal? = some v at hvTerminal
    rcases hvTerminal with ⟨d, hd⟩
    have hdc : d = c := by
      by_contra hdc
      have hvd : v ∈ (U.path d).1.vertexSet :=
        LongPath.terminal_mem_vertexSet hd
      have hvc : v ∈ (U.path c).1.vertexSet :=
        ⟨m, LongPath.active_mono hmk hkU, hmv⟩
      exact Set.disjoint_left.mp (U.disjoint hdc) hvd hvc
    subst d
    rcases LongPath.terminal?_eq_some_iff.mp hd with
      ⟨l, hlFinite, hlv⟩
    have hlU : longPathActive (U.path c).1.terminalIndex l := by
      simp [hlFinite, longPathActive]
    have hmU := LongPath.active_mono hmk hkU
    have hml : m = l :=
      (U.path c).1.injective hmU hlU (hmv.trans hlv.symm)
    have hkl : k = l := by
      have hkle : k ≤ l := by simpa [hlFinite, longPathActive] using hkU
      omega
    refine ⟨c, ?_⟩
    calc
      (U.path c).1.terminal? = some v := hd
      _ = some (q.getVert n) := by
        congr 1
        calc
          v = (U.path c).1.vertex k := by rw [hkl, hlv]
          _ = q.getVert n := hkw
  · have hvDrop : v ∈ (q.drop n).support := by
      simpa [suffix] using hvSuffix
    rcases Walk.mem_support_iff_exists_getVert.mp hvDrop with
      ⟨j, hjv, hjle⟩
    have hglobalLe : n + j ≤ q.length := by
      rw [Walk.drop_length] at hjle
      omega
    have hglobalU : q.getVert (n + j) ∈ U.toWarp.vertexSet := by
      have hvU := U.toWarp.terminalSet_subset_vertexSet hvTerminal
      rw [← q.drop_getVert n j, hjv]
      exact hvU
    have hj0 : j = 0 := by
      by_contra hj0
      exact hnlast (n + j) hglobalLe (by omega) hglobalU
    subst j
    have hvn : v = q.getVert n := by simpa using hjv.symm
    exact hvn ▸ hvTerminal

/-- Along one component of a forward extension, once a position is known
not to be an interior vertex of the left warp, every later vertex which
still belongs to the left warp is necessarily a left terminal.  Pairwise
disjointness first identifies the component, and injectivity then identifies
the terminal index. -/
theorem right_tail_meets_left_only_terminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a : A) {n : ℕ}
    (hnY : longPathActive (Y.path a).1.terminalIndex n)
    (hnGate : (Y.path a).1.vertex n ∈ X.toWarp.vertexSet →
      (Y.path a).1.vertex n ∈ X.toWarp.terminalSet) :
    ∀ k, n ≤ k → longPathActive (Y.path a).1.terminalIndex k →
      (Y.path a).1.vertex k ∈ X.toWarp.vertexSet →
      (Y.path a).1.vertex k ∈ X.toWarp.terminalSet := by
  classical
  intro k hnk hkY hkXwarp
  rcases hkXwarp with ⟨c, l, hlX, hlv⟩
  have hlY := hXY c l hlX
  have hsame : a = c := by
    by_contra hac
    have hvaY : (Y.path a).1.vertex k ∈ (Y.path a).1.vertexSet :=
      ⟨k, hkY, rfl⟩
    have hvcY : (Y.path a).1.vertex k ∈ (Y.path c).1.vertexSet :=
      ⟨l, hlY.1, hlY.2.trans hlv⟩
    exact Set.disjoint_left.mp (Y.disjoint hac) hvaY hvcY
  subst c
  have hkl : k = l :=
    (Y.path a).1.injective hkY hlY.1 (hlY.2.trans hlv).symm
  subst l
  have hkX : longPathActive (X.path a).1.terminalIndex k := hlX
  have hnX : longPathActive (X.path a).1.terminalIndex n :=
    LongPath.active_mono hnk hkX
  have hnXY := hXY a n hnX
  have hnInX : (Y.path a).1.vertex n ∈ X.toWarp.vertexSet :=
    ⟨a, n, hnX, hnXY.2.symm⟩
  have hnTerminal := hnGate hnInX
  change ∃ b, (X.path b).1.terminal? =
    some ((Y.path a).1.vertex n) at hnTerminal
  rcases hnTerminal with ⟨b, hb⟩
  have hba : b = a := by
    by_contra hba
    have hbnX : (Y.path a).1.vertex n ∈ (X.path b).1.vertexSet :=
      LongPath.terminal_mem_vertexSet hb
    rcases hbnX with ⟨r, hrX, hrv⟩
    have hrY := hXY b r hrX
    have hYa : (Y.path a).1.vertex n ∈ (Y.path a).1.vertexSet :=
      ⟨n, hnY, rfl⟩
    have hYb : (Y.path a).1.vertex n ∈ (Y.path b).1.vertexSet :=
      ⟨r, hrY.1, hrY.2.trans hrv⟩
    exact Set.disjoint_left.mp (Y.disjoint hba) hYb hYa
  subst b
  rcases LongPath.terminal?_eq_some_iff.mp hb with
    ⟨r, hrFinite, hrv⟩
  have hrX : longPathActive (X.path a).1.terminalIndex r := by
    simp [hrFinite, longPathActive]
  have hnr : n = r := by
    apply (X.path a).1.injective hnX hrX
    calc
      (X.path a).1.vertex n = (Y.path a).1.vertex n := hnXY.2.symm
      _ = (X.path a).1.vertex r := hrv.symm
  have hkn : k = n := by
    have hkr : k ≤ r := by simpa [hrFinite, longPathActive] using hkX
    omega
  change ∃ b, (X.path b).1.terminal? = some ((Y.path a).1.vertex k)
  refine ⟨a, ?_⟩
  simpa [hkn] using hb

/-- The first new vertex of the right warp on a path issuing from the
distinguished common terminal is alternating-reachable.  The path prefix is
external to the right warp; appending one right-warp edge backwards supplies
the endpoint-incidence condition in Definition 3.8. -/
theorem first_right_contact_mem_alternatingWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a₀ : A) {t b : V}
    (htX : (X.path a₀).1.terminal? = some t)
    (htY : (Y.path a₀).1.terminal? = some t)
    (q : G.Walk t b) (hq : q.IsPath) {n : ℕ}
    (hnle : n ≤ q.length)
    (hnY : q.getVert n ∈ Y.toWarp.vertexSet)
    (hnne : q.getVert n ≠ t)
    (hfirst : ∀ j, j ≤ q.length → j < n →
      q.getVert j ∈ Y.toWarp.vertexSet → q.getVert j = t) :
    q.getVert n ∈ (alternatingWarp hXY t).vertexSet := by
  classical
  by_contra hnU
  have hnX : q.getVert n ∉ X.toWarp.vertexSet := by
    intro h
    exact hnU (left_vertexSet_subset_alternatingWarp hXY t h)
  have htTerm : t ∈ X.toWarp.terminalSet := ⟨a₀, htX⟩
  have hpathEq : (X.path a₀).1 = (Y.path a₀).1 :=
    path_eq_of_le_of_terminal_eq hXY a₀ htX htY
  rcases hnY with ⟨c, k, hkY, hky⟩
  change A at c
  change longPathActive (Y.path c).1.terminalIndex k at hkY
  change (Y.path c).1.vertex k = q.getVert n at hky
  have hkpos : 0 < k := by
    by_contra hkpos
    have hk0 : k = 0 := by omega
    subst k
    apply hnX
    refine ⟨c, ?_⟩
    have hstart : (X.path c).1.initial = q.getVert n := by
      calc
        (X.path c).1.initial = (c : V) := X.path_initial c
        _ = (Y.path c).1.initial := (Y.path_initial c).symm
        _ = q.getVert n := hky
    exact hstart.symm ▸ (X.path c).1.initial_mem_vertexSet
  have hkPred : longPathActive (Y.path c).1.terminalIndex (k - 1) :=
    LongPath.active_mono (by omega) hkY
  let y := q.getVert n
  let pred := (Y.path c).1.vertex (k - 1)
  have hky' : (Y.path c).1.vertex k = y := hky
  have hyYPath : y ∈ (Y.path c).1.vertexSet := ⟨k, hkY, hky'⟩
  have htYPath : t ∈ (Y.path a₀).1.vertexSet :=
    LongPath.terminal_mem_vertexSet htY
  have hyX_of_same_path {d : A}
      (htd : t ∈ (Y.path d).1.vertexSet)
      (hyd : y ∈ (Y.path d).1.vertexSet) :
      y ∈ X.toWarp.vertexSet := by
    have hda : d = a₀ := by
      by_contra hda
      exact Set.disjoint_left.mp (Y.disjoint hda) htd htYPath
    subst d
    change ∃ e : A, y ∈ (X.path e).1.vertexSet
    refine ⟨a₀, ?_⟩
    rw [hpathEq]
    exact hyd
  have hnpos : 0 < n := by
    by_contra hn0
    have hnzero : n = 0 := by omega
    exact hnne (by simpa [hnzero])
  let qp : LongPath G := LongPath.ofWalk q hq
  have hnActive : longPathActive qp.terminalIndex n := by
    simp [qp, LongPath.ofWalk, longPathActive, hnle]
  have hsegStart : qp.vertex 0 = t := by
    simpa [qp, LongPath.ofWalk] using q.getVert_zero
  have hsegEnd : qp.vertex n = y := by rfl
  let seg : G.Walk t y :=
    (qp.segmentWalk hnActive (Nat.zero_le n)).copy hsegStart hsegEnd
  let segY : G.Walk t ((Y.path c).1.vertex k) :=
    seg.copy rfl hky'.symm
  have hback : G.Adj ((Y.path c).1.vertex k) pred := by
    have hkSucc : longPathActive (Y.path c).1.terminalIndex (k - 1 + 1) := by
      simpa [Nat.sub_add_cancel (by omega : 1 ≤ k)] using hkY
    simpa [pred, Nat.sub_add_cancel (by omega : 1 ≤ k)] using
      ((Y.path c).1.adjacent (k - 1) hkSucc).symm
  let cont : G.Walk t pred := segY.concat hback
  have hsegLength : seg.length = n := by
    change ((qp.segmentWalk hnActive (Nat.zero_le n)).copy
      hsegStart hsegEnd).length = n
    rw [Walk.length_copy]
    simpa only [Nat.sub_zero] using
      qp.length_segmentWalk hnActive (Nat.zero_le n)
  have hcontLength : cont.length = n + 1 := by
    simp [cont, segY, hsegLength]
  have hcontGet (j : ℕ) (hj : j ≤ n) :
      cont.getVert j = q.getVert j := by
    rw [show cont = segY.concat hback by rfl, Walk.concat_eq_append,
      Walk.getVert_append']
    have hjSeg : j ≤ segY.length := by simpa [segY, hsegLength]
    rw [if_pos hjSeg, Walk.getVert_copy]
    change seg.getVert j = q.getVert j
    rw [show seg =
      (qp.segmentWalk hnActive (Nat.zero_le n)).copy hsegStart hsegEnd by rfl,
      Walk.getVert_copy]
    change (qp.segmentWalk hnActive (Nat.zero_le n)).getVert j = _
    rw [qp.getVert_segmentWalk hnActive (Nat.zero_le n) hj]
    simp [qp, LongPath.ofWalk]
  have hcontLast : cont.getVert (n + 1) = pred := by
    rw [← hcontLength]
    exact cont.getVert_length
  have hsegYGet (j : ℕ) (hj : j ≤ n) :
      segY.getVert j = q.getVert j := by
    change (seg.copy rfl hky'.symm).getVert j = _
    rw [Walk.getVert_copy]
    change seg.getVert j = q.getVert j
    rw [show seg =
      (qp.segmentWalk hnActive (Nat.zero_le n)).copy hsegStart hsegEnd by rfl,
      Walk.getVert_copy]
    change (qp.segmentWalk hnActive (Nat.zero_le n)).getVert j = _
    rw [qp.getVert_segmentWalk hnActive (Nat.zero_le n) hj]
    simp [qp, LongPath.ofWalk]
  have hsegYPath : segY.IsPath := by
    apply Walk.IsPath.mk'
    change (seg.copy rfl hky'.symm).support.Nodup
    rw [Walk.support_copy]
    change seg.support.Nodup
    rw [show seg =
      (qp.segmentWalk hnActive (Nat.zero_le n)).copy hsegStart hsegEnd by rfl,
      Walk.support_copy]
    exact (qp.segmentWalk_isPath hnActive (Nat.zero_le n)).support_nodup
  let lastDart : G.Dart :=
    ⟨(pred, (Y.path c).1.vertex k), by
      have hkSucc : longPathActive
          (Y.path c).1.terminalIndex (k - 1 + 1) := by
        simpa [Nat.sub_add_cancel (by omega : 1 ≤ k)] using hkY
      simpa [pred, Nat.sub_add_cancel (by omega : 1 ≤ k)] using
        (Y.path c).1.adjacent (k - 1) hkSucc⟩
  have hlastDartY : lastDart ∈ Y.toWarp.dartSet := by
    change ∃ d : A, lastDart ∈ (Y.path d).1.dartSet
    refine ⟨c, k - 1, ?_, ?_⟩
    · simpa [Nat.sub_add_cancel (by omega : 1 ≤ k)] using hkY
    simp [lastDart, pred, Nat.sub_add_cancel (by omega : 1 ≤ k)]
  have hfinalEdgeY : s((Y.path c).1.vertex k, pred) ∈
      Y.toWarp.edgeSet := by
    apply (Y.toWarp.mem_edgeSet_iff).mpr
    refine ⟨lastDart, hlastDartY, ?_⟩
    simp [lastDart, pred]
  have hqDartExternal : ∀ (j : ℕ), j < n → ∀ δ : G.Dart,
      δ.toProd = (q.getVert j, q.getVert (j + 1)) →
      δ ∉ Y.toWarp.dartSet ∧ δ.symm ∉ Y.toWarp.dartSet := by
    intro j hjn δ hδ
    have hjle : j ≤ q.length := by omega
    have hj1le : j + 1 ≤ q.length := by omega
    have hfst : δ.fst = q.getVert j := congrArg Prod.fst hδ
    have hsnd : δ.snd = q.getVert (j + 1) := congrArg Prod.snd hδ
    have external_of_mem
        (hδY : δ ∈ Y.toWarp.dartSet) : False := by
      have hjY : q.getVert j ∈ Y.toWarp.vertexSet :=
        hfst.symm ▸ Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hδY
      have hjt : q.getVert j = t := hfirst j hjle hjn hjY
      have hj1Y : q.getVert (j + 1) ∈ Y.toWarp.vertexSet :=
        hsnd.symm ▸ Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hδY
      by_cases hj1n : j + 1 < n
      · have hj1t := hfirst (j + 1) hj1le hj1n hj1Y
        have hjeq : j = j + 1 := hq.getVert_injOn hjle hj1le
          (hjt.trans hj1t.symm)
        omega
      · have hj1eq : j + 1 = n := by omega
        have hyd : y ∈ Y.toWarp.vertexSet := by simpa [y, hj1eq] using hj1Y
        change ∃ d : A, δ ∈ (Y.path d).1.dartSet at hδY
        rcases hδY with ⟨d, hd⟩
        have htd : t ∈ (Y.path d).1.vertexSet := by
          have := LongPath.fst_mem_vertexSet_of_mem_dartSet hd
          simpa [hjt, hfst] using this
        have hyd' : y ∈ (Y.path d).1.vertexSet := by
          have := LongPath.snd_mem_vertexSet_of_mem_dartSet hd
          simpa [y, hj1eq, hsnd] using this
        exact hnX (hyX_of_same_path htd hyd')
    have external_of_symm_mem
        (hδY : δ.symm ∈ Y.toWarp.dartSet) : False := by
      have hjY : q.getVert j ∈ Y.toWarp.vertexSet := by
        have := Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hδY
        simpa [hfst] using this
      have hjt : q.getVert j = t := hfirst j hjle hjn hjY
      have hj1Y : q.getVert (j + 1) ∈ Y.toWarp.vertexSet := by
        have := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hδY
        simpa [hsnd] using this
      by_cases hj1n : j + 1 < n
      · have hj1t := hfirst (j + 1) hj1le hj1n hj1Y
        have hjeq : j = j + 1 := hq.getVert_injOn hjle hj1le
          (hjt.trans hj1t.symm)
        omega
      · have hj1eq : j + 1 = n := by omega
        change ∃ d : A, δ.symm ∈ (Y.path d).1.dartSet at hδY
        rcases hδY with ⟨d, hd⟩
        have htd : t ∈ (Y.path d).1.vertexSet := by
          have := LongPath.snd_mem_vertexSet_of_mem_dartSet hd
          simpa [hjt, hfst] using this
        have hyd' : y ∈ (Y.path d).1.vertexSet := by
          have := LongPath.fst_mem_vertexSet_of_mem_dartSet hd
          simpa [y, hj1eq, hsnd] using this
        exact hnX (hyX_of_same_path htd hyd')
    exact ⟨fun h ↦ external_of_mem h, fun h ↦ external_of_symm_mem h⟩
  have hsegEdgesOutside : ∀ ε ∈ segY.edges,
      ε ∉ Y.toWarp.edgeSet := by
    intro ε hεSeg hεY
    rw [Walk.edges_eq_map_darts, List.mem_map] at hεSeg
    rcases hεSeg with ⟨δ, hδSeg, rfl⟩
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert segY).mp hδSeg with
      ⟨j, hj, hδpair⟩
    have hjlt : j < n := by simpa [segY, hsegLength] using hj
    have hpair : δ.toProd = (q.getVert j, q.getVert (j + 1)) := by
      calc
        δ.toProd = (segY.getVert j, segY.getVert (j + 1)) := hδpair
        _ = (q.getVert j, q.getVert (j + 1)) := by
          rw [hsegYGet j (by omega), hsegYGet (j + 1) (by omega)]
    have hExt := hqDartExternal j hjlt δ hpair
    rcases (Y.toWarp.mem_edgeSet_iff).mp hεY with ⟨η, hηY, hηedge⟩
    rcases (dart_edge_eq_iff η δ).mp hηedge with hEq | hEq
    · exact hExt.1 (hEq.symm ▸ hηY)
    · exact hExt.2 (by simpa [hEq] using hηY)
  have hmemSeg {v : V} : v ∈ seg.support ↔
      ∃ j, j ≤ n ∧ q.getVert j = v := by
    change v ∈ ((qp.segmentWalk hnActive (Nat.zero_le n)).copy
      hsegStart hsegEnd).support ↔ _
    rw [Walk.support_copy]
    simpa only [qp, LongPath.ofWalk, Nat.zero_le, true_and, zero_add] using
      qp.mem_support_segmentWalk_iff hnActive (Nat.zero_le n) (v := v)
  have hpredY : pred ∈ Y.toWarp.vertexSet :=
    ⟨c, k - 1, hkPred, rfl⟩
  have hpredNotSeg : pred ∉ segY.support := by
    intro hp
    have hp' : pred ∈ seg.support := by simpa [segY] using hp
    rcases hmemSeg.mp hp' with ⟨j, hjn, hjp⟩
    rcases Nat.lt_or_eq_of_le hjn with hjlt | rfl
    · have hjt := hfirst j (by omega) hjlt (hjp.symm ▸ hpredY)
      have htc : t ∈ (Y.path c).1.vertexSet := by
        rw [← hjt, hjp]
        exact ⟨k - 1, hkPred, rfl⟩
      exact hnX (hyX_of_same_path htc hyYPath)
    · have hkp : (Y.path c).1.vertex k = (Y.path c).1.vertex (k - 1) :=
        hky'.trans hjp
      have := (Y.path c).1.injective hkY hkPred hkp
      omega
  have hcontPath : cont.IsPath := by
    apply Walk.IsPath.mk'
    rw [show cont = segY.concat hback by rfl, Walk.support_concat]
    rw [List.nodup_append]
    refine ⟨hsegYPath.support_nodup, by simp, ?_⟩
    intro v hv w hw
    simp only [List.mem_singleton] at hw
    subst w
    exact fun hvp ↦ hpredNotSeg (hvp ▸ hv)
  have hXcont : ∀ v ∈ cont.support,
      v ∈ X.toWarp.vertexSet → v ∈ X.toWarp.terminalSet := by
    intro v hv hvX
    rw [show cont = segY.concat hback by rfl, Walk.support_concat,
      List.mem_append, List.mem_singleton] at hv
    rcases hv with hvSeg | rfl
    · have hvSeg' : v ∈ seg.support := by simpa [segY] using hvSeg
      rcases hmemSeg.mp hvSeg' with ⟨j, hjn, hjv⟩
      rcases Nat.lt_or_eq_of_le hjn with hjlt | rfl
      · have hvY := WaveExtension.vertexSet_subset_of_le hXY hvX
        have hjt := hfirst j (by omega) hjlt (hjv ▸ hvY)
        have hvt : v = t := hjv.symm.trans hjt
        exact hvt ▸ htTerm
      · exact (hnX (hjv ▸ hvX)).elim
    · apply right_predecessor_mem_left_is_terminal
        (hXY := hXY) t c (n := k - 1)
      · simpa [Nat.sub_add_cancel (by omega : 1 ≤ k)] using hkY
      · simpa [Nat.sub_add_cancel (by omega : 1 ≤ k), hky'] using hnU
      · exact hvX
  have hyInCont : y ∈ cont.support := by
    rw [show cont = segY.concat hback by rfl, Walk.support_concat,
      List.mem_append]
    exact Or.inl (by simpa [segY] using seg.end_mem_support)
  have hAlt : X.IsAlternatingWalk Y cont := by
    have hnil := isAlternatingWalk_nil X Y htTerm
    have hcontStart : (.nil : G.Walk t t).append cont = cont := by simp
    rw [← hcontStart]
    apply hnil.append_of_compatible cont hXcont
    · intro δ hδcont
      rcases (Erdos599.Walk.mem_darts_iff_exists_getVert cont).mp hδcont with
        ⟨j, hj, hδpair⟩
      have hjlt : j < n + 1 := by simpa [hcontLength] using hj
      by_cases hjSeg : j < n
      · have hpair : δ.toProd = (q.getVert j, q.getVert (j + 1)) := by
          calc
            δ.toProd = (cont.getVert j, cont.getVert (j + 1)) := hδpair
            _ = (q.getVert j, q.getVert (j + 1)) := by
              rw [hcontGet j (by omega), hcontGet (j + 1) (by omega)]
        exact Or.inr (hqDartExternal j hjSeg δ hpair)
      · have hjEq : j = n := by omega
        left
        change ∃ d : A, δ.symm ∈ (Y.path d).1.dartSet
        refine ⟨c, k - 1, ?_, ?_⟩
        · simpa [Nat.sub_add_cancel (by omega : 1 ≤ k)] using hkY
        have hδpair' : δ.toProd =
            ((Y.path c).1.vertex k, pred) := by
          calc
            δ.toProd = (cont.getVert j, cont.getVert (j + 1)) := hδpair
            _ = (q.getVert n, pred) := by
              rw [hjEq, hcontGet n le_rfl, hcontLast]
            _ = ((Y.path c).1.vertex k, pred) := by rw [hky']
        change δ.toProd.swap = _
        rw [hδpair']
        simp [pred, Nat.sub_add_cancel (by omega : 1 ≤ k)]
    · intro i j hi hj hij heq
      exact (hij (hcontPath.getVert_injOn hi hj heq)).elim
    · intro v hvNil _hvTail
      simp only [Walk.support_nil, List.mem_singleton] at hvNil
      subst v
      exact Y.toWarp.terminalSet_subset_vertexSet ⟨a₀, htY⟩
    · rw [show cont = segY.concat hback by rfl, Walk.edges_concat,
        List.nodup_concat]
      exact ⟨fun hlast ↦ hsegEdgesOutside _ hlast hfinalEdgeY,
        hsegYPath.isTrail.edges_nodup⟩
    · simp
    · intro i hi0 hiLe hYi
      rw [hcontLength] at hiLe
      by_cases hiSeg : i < n
      · have hqY : q.getVert i ∈ Y.toWarp.vertexSet := by
          rw [← hcontGet i (by omega)]
          exact hYi
        have hit := hfirst i (by omega) hiSeg hqY
        have hzero : q.getVert 0 = t := q.getVert_zero
        have hiEq0 : i = 0 := hq.getVert_injOn (hiSeg.le.trans hnle)
          (Nat.zero_le q.length) (hit.trans hzero.symm)
        omega
      by_cases hiBoundary : i = n
      · right
        refine ⟨by rw [hcontLength]; omega, ?_⟩
        have hcurr : cont.getVert i = (Y.path c).1.vertex k := by
          calc
            cont.getVert i = q.getVert n := by
              rw [hiBoundary, hcontGet n le_rfl]
            _ = (Y.path c).1.vertex k := hky.symm
        have hnext : cont.getVert (i + 1) = pred := by
          rw [hiBoundary]
          exact hcontLast
        rw [hcurr, hnext]
        exact hfinalEdgeY
      · have hiLast : i = n + 1 := by omega
        left
        have hprev : cont.getVert (i - 1) = (Y.path c).1.vertex k := by
          calc
            cont.getVert (i - 1) = q.getVert n := by
              rw [show i - 1 = n by omega, hcontGet n le_rfl]
            _ = (Y.path c).1.vertex k := hky.symm
        have hcurr : cont.getVert i = pred := by rw [hiLast, hcontLast]
        rw [hprev, hcurr]
        exact hfinalEdgeY
  apply hnU
  change ∃ d : A, y ∈ (alternatingPath hXY t d).vertexSet
  refine ⟨c, ?_⟩
  have hyInCont' : (Y.path c).1.vertex k ∈ cont.support :=
    hky'.symm ▸ hyInCont
  have hm := reachable_vertex_mem_alternatingPath hXY t c hkY
    (⟨pred, cont, hAlt, hyInCont'⟩ : IsAlternatingReachable X Y t
      ((Y.path c).1.vertex k))
  exact hky' ▸ hm

/-- If an ambient path reaches a deleted vertex and meets the exterior right
warp before doing so, its first such contact belongs to the exterior
alternating prefix.  The strict prefix ending at that contact avoids the
deleted endpoint and can therefore be reinterpreted in the exterior graph. -/
theorem exists_right_contact_mem_alternatingWarp_before_deleted {V : Type}
    {G : SimpleGraph V} {A B : Set V} {x : V}
    {X Y : TotalWave (outsideGraph G {x}) A B}
    (hXY : X ≤ Y) (a₀ : A) {t : V}
    (htX : (X.path a₀).1.terminal? = some t)
    (htY : (Y.path a₀).1.terminal? = some t)
    (hxY : x ∉ Y.toWarp.vertexSet)
    (p : G.Walk t x) (hp : p.IsPath)
    (hmeet : ∃ y ∈ p.support,
      y ∈ Y.toWarp.vertexSet \ {t}) :
    ∃ y ∈ p.support,
      y ∈ (alternatingWarp hXY t).vertexSet ∧ y ≠ t := by
  classical
  rcases exists_first_index_of_support_meets p
      (Y.toWarp.vertexSet \ {t}) hmeet with
    ⟨n, hnle, hnDiff, hfirst⟩
  let y := p.getVert n
  have hySupport : y ∈ p.support := p.getVert_mem_support n
  have hyY : y ∈ Y.toWarp.vertexSet := hnDiff.1
  have hyne : y ≠ t := by simpa [y] using hnDiff.2
  have hyx : y ≠ x := by
    intro hyx
    apply hxY
    simpa only [hyx] using hyY
  let r : G.Walk t y := p.takeUntil y hySupport
  have hrPath : r.IsPath := hp.takeUntil hySupport
  have hrLength : r.length = n := by
    apply hp.getVert_injOn (p.length_takeUntil_le_length hySupport) hnle
    have hend := p.getVert_length_takeUntil hySupport
    simpa [r, y] using hend
  have hxNotR : x ∉ r.support := by
    exact Walk.endpoint_notMem_support_takeUntil hp hySupport hyx.symm
  have hrOutside : ∀ v ∈ r.support, v ∉ ({x} : Set V) := by
    intro v hv hvx
    exact hxNotR (Set.mem_singleton_iff.mp hvx ▸ hv)
  let rE : (outsideGraph G {x}).Walk t y :=
    Erdos599.Walk.toOutsideGraph r hrOutside
  have hrEPath : rE.IsPath :=
    Erdos599.Walk.isPath_toOutsideGraph hrPath hrOutside
  have hrELength : rE.length = n := by
    simpa [rE] using hrLength
  have hyEnd : rE.getVert rE.length = y := rE.getVert_length
  have hfirstE : ∀ j, j ≤ rE.length → j < rE.length →
      rE.getVert j ∈ Y.toWarp.vertexSet → rE.getVert j = t := by
    intro j hjle hjlt hjY
    have hjleR : j ≤ r.length := by simpa [rE] using hjle
    have hgetR : r.getVert j = p.getVert j :=
      p.getVert_takeUntil hySupport hjleR
    have hgetE : rE.getVert j = p.getVert j := by
      simpa [rE] using hgetR
    by_contra hjt
    apply hfirst j
    · omega
    · simpa [hrELength] using hjlt
    · exact ⟨hgetE.symm ▸ hjY, by simpa [hgetE] using hjt⟩
  have hyAlt : y ∈ (alternatingWarp hXY t).vertexSet := by
    have hcontact := first_right_contact_mem_alternatingWarp
      hXY a₀ htX htY rE hrEPath
      (n := rE.length) le_rfl
      (by rw [hyEnd]; exact hyY) (by rw [hyEnd]; exact hyne) hfirstE
    simpa [hyEnd] using hcontact
  exact ⟨y, hySupport, hyAlt, hyne⟩

/-- A nonterminal vertex of the alternating prefix is the endpoint of an
alternating walk provided that, when it lies in the left warp, it is a left
terminal.  This packages the first-contact/backwards-splice argument used
internally in the proof of Lemma 3.11 and needed once more in Lemma 3.12. -/
theorem exists_alternatingWalk_of_mem_not_terminal_of_left_gate {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) {z : V}
    (hzU : z ∈ (alternatingWarp hXY t).vertexSet)
    (hzNotTerminal : z ∉ (alternatingWarp hXY t).terminalSet)
    (hzGate : z ∈ X.toWarp.vertexSet → z ∈ X.toWarp.terminalSet) :
    ∃ R : G.Walk t z, X.IsAlternatingWalk Y R := by
  classical
  change ∃ d, z ∈ (alternatingPath hXY t d).vertexSet at hzU
  rcases hzU with ⟨d, nz, hnzU, hnzv⟩
  have hnzY : longPathActive (Y.path d).1.terminalIndex nz :=
    (alternatingPath_forward_right hXY t d nz hnzU).1
  have hnzEq : (Y.path d).1.vertex nz = z := by
    calc
      (Y.path d).1.vertex nz = (alternatingPath hXY t d).vertex nz :=
        (vertex_alternatingPath hXY t d nz).symm
      _ = z := hnzv
  have hnzNotTerminal :
      (alternatingPath hXY t d).terminal? ≠
        some ((alternatingPath hXY t d).vertex nz) := by
    intro hterm
    apply hzNotTerminal
    change ∃ e, (alternatingPath hXY t e).terminal? = some z
    exact ⟨d, hterm.trans (congrArg some
      ((vertex_alternatingPath hXY t d nz).trans hnzEq))⟩
  have hnzSucc : longPathActive
      (alternatingPath hXY t d).terminalIndex (nz + 1) :=
    (alternatingPath hXY t d).active_succ_of_active_of_terminal_ne
      hnzU hnzNotTerminal
  have hactiveSet :=
    (active_alternatingPath_iff hXY t d (nz + 1)).mp hnzSucc
  rcases hactiveSet with hXsucc | ⟨m, hnm, hmY, hmReach⟩
  · have hnzX : longPathActive (X.path d).1.terminalIndex nz :=
      LongPath.active_mono (Nat.le_succ nz) hXsucc
    have hnzXY := hXY d nz hnzX
    have hzX : z ∈ X.toWarp.vertexSet :=
      ⟨d, nz, hnzX, hnzXY.2.symm.trans hnzEq⟩
    have hzTerminal := hzGate hzX
    change ∃ e, (X.path e).1.terminal? = some z at hzTerminal
    rcases hzTerminal with ⟨e, he⟩
    have hed : e = d := by
      by_contra hed
      have hze : z ∈ (X.path e).1.vertexSet :=
        LongPath.terminal_mem_vertexSet he
      have hzd : z ∈ (X.path d).1.vertexSet :=
        ⟨nz, hnzX, hnzXY.2.symm.trans hnzEq⟩
      exact Set.disjoint_left.mp (X.disjoint hed) hze hzd
    subst e
    rcases LongPath.terminal?_eq_some_iff.mp he with
      ⟨l, hlFinite, hlv⟩
    have hlX : longPathActive (X.path d).1.terminalIndex l := by
      simp [hlFinite, longPathActive]
    have hnzl : nz = l := (X.path d).1.injective hnzX hlX <| by
      calc
        (X.path d).1.vertex nz = (Y.path d).1.vertex nz := hnzXY.2.symm
        _ = z := hnzEq
        _ = (X.path d).1.vertex l := hlv.symm
    have : nz + 1 ≤ l := by
      simpa [hlFinite, longPathActive] using hXsucc
    omega
  · rcases hmReach with ⟨rend, R, hR, hmR⟩
    let strictSuffix : Set V :=
      {v | ∃ r, nz < r ∧ r ≤ m ∧ (Y.path d).1.vertex r = v}
    have hmStrict : (Y.path d).1.vertex m ∈ strictSuffix :=
      ⟨m, by omega, le_rfl, rfl⟩
    rcases exists_first_index_of_support_meets R strictSuffix
        ⟨(Y.path d).1.vertex m, hmR, hmStrict⟩ with
      ⟨i, hiR, hiSuffix, hiFirst⟩
    rcases hiSuffix with ⟨k', hnzk', hk'm, hik'⟩
    have hk'Y : longPathActive (Y.path d).1.terminalIndex k' :=
      LongPath.active_mono hk'm hmY
    have hYi : R.getVert i ∈ Y.toWarp.vertexSet :=
      ⟨d, k', hk'Y, hik'⟩
    have hchoose : ∃ (s r : ℕ),
        s ≤ R.length ∧ nz ≤ r ∧ r ≤ k' ∧
        R.getVert s = (Y.path d).1.vertex r ∧
        X.IsAlternatingWalk Y (R.take s) ∧
        (∀ j, j < s → ∀ u, nz < u → u ≤ r →
          R.getVert j ≠ (Y.path d).1.vertex u) := by
      by_cases hi0 : i = 0
      · refine ⟨0, k', by omega, by omega, le_rfl, ?_, ?_, ?_⟩
        · simpa [hi0] using hik'.symm
        · apply hR.take_of_zero_or_previous_right 0 (by omega)
          exact Or.inl rfl
        · intro j hj
          omega
      · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
        rcases hR.2.2.2.2 i hiPos hiR hYi with hprev | hnext
        · refine ⟨i, k', hiR, by omega, le_rfl, hik'.symm, ?_, ?_⟩
          · exact hR.take_of_zero_or_previous_right i hiR
              (Or.inr (Or.inr hprev))
          · intro j hj u hnu hur heq
            exact hiFirst j (hj.le.trans hiR) hj
              ⟨u, hnu, hur.trans hk'm, heq.symm⟩
        · have hiNext : i + 1 ≤ R.length := by omega
          have hk'Pos : 0 < k' := by omega
          let walkDart : G.Dart := R.darts[i]'(by simpa using hnext.1)
          have hwalkDartMem : walkDart ∈ R.darts := List.getElem_mem ..
          have hwalkSymmY : walkDart.symm ∈ Y.toWarp.dartSet := by
            apply (hR.symm_mem_right_iff_edge_mem hwalkDartMem).mpr
            simpa [walkDart, Walk.getElem_edges,
              Walk.edge_getElem_darts] using hnext.2
          have hkPredActive : longPathActive
              (Y.path d).1.terminalIndex (k' - 1 + 1) := by
            simpa [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr
              (by omega : k' ≠ 0))] using hk'Y
          let pathDart : G.Dart :=
            ⟨((Y.path d).1.vertex (k' - 1), (Y.path d).1.vertex k'), by
              simpa [Nat.sub_add_cancel (by omega : 1 ≤ k')] using
                (Y.path d).1.adjacent (k' - 1) hkPredActive⟩
          have hpathDartY : pathDart ∈ Y.toWarp.dartSet := by
            change ∃ e, pathDart ∈ (Y.path e).1.dartSet
            refine ⟨d, k' - 1, hkPredActive, ?_⟩
            simp [pathDart, Nat.sub_add_cancel (by omega : 1 ≤ k')]
          have hsameDart : walkDart.symm = pathDart := by
            apply Y.toWarp.dart_eq_of_snd_eq hwalkSymmY hpathDartY
            change walkDart.fst = (Y.path d).1.vertex k'
            have hfst := congrArg (fun e : G.Dart ↦ e.fst)
              (R.darts_getElem_eq_getVert i (by simpa using hnext.1))
            calc
              walkDart.fst = R.getVert i := by simpa [walkDart] using hfst
              _ = (Y.path d).1.vertex k' := hik'.symm
          have hnextVertex : R.getVert (i + 1) =
              (Y.path d).1.vertex (k' - 1) := by
            have hsnd := congrArg (fun e : G.Dart ↦ e.snd)
              (R.darts_getElem_eq_getVert i (by simpa using hnext.1))
            have heq := congrArg (fun e : G.Dart ↦ e.fst) hsameDart
            change walkDart.snd = pathDart.fst at heq
            calc
              R.getVert (i + 1) = walkDart.snd := by
                simpa [walkDart] using hsnd.symm
              _ = pathDart.fst := heq
              _ = (Y.path d).1.vertex (k' - 1) := rfl
          refine ⟨i + 1, k' - 1, hiNext, by omega, by omega,
            hnextVertex, ?_, ?_⟩
          · apply hR.take_of_zero_or_previous_right (i + 1) hiNext
            right
            right
            simpa using hnext.2
          · intro j hj u hnu hur heq
            by_cases hji : j = i
            · subst j
              have hku : k' = u :=
                (Y.path d).1.injective hk'Y
                  (LongPath.active_mono (hur.trans (by omega)) hk'Y)
                  (hik'.trans heq)
              omega
            · exact hiFirst j (by omega) (by omega)
                ⟨u, hnu, hur.trans (by omega), heq.symm⟩
    rcases hchoose with ⟨s, r', hsR, hnzr, hrk, hsEq, hsAlt, hsFirst⟩
    have hrY : longPathActive (Y.path d).1.terminalIndex r' :=
      LongPath.active_mono (hrk.trans hk'm) hmY
    let R' : G.Walk t ((Y.path d).1.vertex r') :=
      (R.take s).copy rfl hsEq
    have hR' : X.IsAlternatingWalk Y R' := by
      exact hsAlt.copy rfl hsEq
    have hsegmentX : ∀ u, nz ≤ u → u ≤ r' →
        (Y.path d).1.vertex u ∈ X.toWarp.vertexSet →
        (Y.path d).1.vertex u ∈ X.toWarp.terminalSet := by
      have htail := right_tail_meets_left_only_terminal hXY d hnzY (by
        intro hzX
        exact hnzEq ▸ hzGate (hnzEq.symm ▸ hzX))
      intro u hnu hur huX
      exact htail u hnu (LongPath.active_mono hur hrY) huX
    have hcrossEdges : R'.edges.Disjoint
        ((Y.path d).1.segmentWalk hrY hnzr).reverse.edges := by
      simpa [R'] using hR.edges_take_disjoint_reverse_segment_of_first
        d hrY hnzr hsR hsFirst
    let Zwalk : G.Walk t ((Y.path d).1.vertex nz) :=
      R'.append ((Y.path d).1.segmentWalk hrY hnzr).reverse
    have hZalt : X.IsAlternatingWalk Y Zwalk := by
      exact hR'.append_reverse_segment hrY hnzr hsegmentX hcrossEdges
    let Rz : G.Walk t z := Zwalk.copy rfl hnzEq
    have hRz : X.IsAlternatingWalk Y Rz := hZalt.copy rfl hnzEq
    exact ⟨Rz, hRz⟩

/-- Endpoint reachability implies the occurrence-based reachability used in
the definition of the alternating prefix. -/
theorem alternating_reachable_of_mem_not_terminal_of_left_gate {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t : V) {z : V}
    (hzU : z ∈ (alternatingWarp hXY t).vertexSet)
    (hzNotTerminal : z ∉ (alternatingWarp hXY t).terminalSet)
    (hzGate : z ∈ X.toWarp.vertexSet → z ∈ X.toWarp.terminalSet) :
    IsAlternatingReachable X Y t z := by
  rcases exists_alternatingWalk_of_mem_not_terminal_of_left_gate
      hXY t hzU hzNotTerminal hzGate with ⟨R, hR⟩
  exact ⟨z, R, hR, R.end_mem_support⟩

/-- Shafer Lemma 3.11: the componentwise prefix of `Y` through all vertices
reachable by finite `(Y-X)`-alternating walks from an `X` terminal is again
a wave. -/
theorem alternatingWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) {t : V} (htX : t ∈ X.toWarp.terminalSet) :
    (alternatingWarp hXY t).IsWave A B := by
  classical
  constructor
  · rw [Warp.IsStarting, alternatingWarp_initialSet]
  · intro a ha b hb q hq
    by_contra hmeet
    push Not at hmeet
    have haInitial : a ∈ X.toWarp.initialSet := by
      rw [TotalWave.initialSet_toWarp]
      exact ha
    have haX : a ∈ X.toWarp.vertexSet :=
      X.toWarp.initialSet_subset_vertexSet haInitial
    rcases exists_last_index_of_support_meets q X.toWarp.vertexSet
        ⟨a, q.start_mem_support, haX⟩ with
      ⟨nw, hnwLe, hnwX, hnwLast⟩
    have hwTerminal : q.getVert nw ∈ X.toWarp.terminalSet :=
      last_wave_vertex_is_terminal X ha hb q hq hnwLe hnwX hnwLast
    have hnwX' := hnwX
    change ∃ c, q.getVert nw ∈ (X.path c).1.vertexSet at hnwX'
    rcases hnwX' with ⟨c, k, hkX, hkw⟩
    let pref : G.Walk (X.path c).1.initial (q.getVert nw) :=
      ((X.path c).1.prefixWalk k hkX).copy rfl hkw
    let combined : G.Walk (X.path c).1.initial b :=
      pref.append (q.drop nw)
    have hcombinedAvoid : ∀ v ∈ combined.support,
        v ∉ (alternatingWarp hXY t).terminalSet := by
      intro v hv
      rw [show combined = pref.append (q.drop nw) by rfl,
        Walk.mem_support_append_iff] at hv
      rcases hv with hvPref | hvDrop
      · intro hvTerminal
        have hvPref' : v ∈ ((X.path c).1.prefixWalk k hkX).support := by
          change v ∈ (((X.path c).1.prefixWalk k hkX).copy rfl hkw).support
            at hvPref
          simpa only [Walk.support_copy] using hvPref
        rcases ((X.path c).1.mem_support_prefixWalk_iff hkX).mp hvPref' with
          ⟨m, hmk, hmv⟩
        change ∃ d, (alternatingPath hXY t d).terminal? = some v
          at hvTerminal
        rcases hvTerminal with ⟨d, hd⟩
        have hdc : d = c := by
          by_contra hdc
          have hvd : v ∈ (alternatingPath hXY t d).vertexSet :=
            LongPath.terminal_mem_vertexSet hd
          have hvcX : v ∈ (X.path c).1.vertexSet :=
            ⟨m, LongPath.active_mono hmk hkX, hmv⟩
          have hvc : v ∈ (alternatingPath hXY t c).vertexSet :=
            (left_forward_alternatingPath hXY t c).vertexSet_subset hvcX
          exact Set.disjoint_left.mp
            ((alternatingWarp hXY t).disjoint hdc) hvd hvc
        subst d
        have hXterm : (X.path c).1.terminal? = some v :=
          (left_forward_alternatingPath hXY t c).terminal_of_mem_of_terminal
            hd ⟨m, LongPath.active_mono hmk hkX, hmv⟩
        rcases LongPath.terminal?_eq_some_iff.mp hXterm with
          ⟨l, hlFinite, hlv⟩
        have hlX : longPathActive (X.path c).1.terminalIndex l := by
          simp [hlFinite, longPathActive]
        have hmX := LongPath.active_mono hmk hkX
        have hml : m = l :=
          (X.path c).1.injective hmX hlX (hmv.trans hlv.symm)
        have hkl : k = l := by
          have hkle : k ≤ l := by simpa [hlFinite, longPathActive] using hkX
          omega
        have hvw : v = q.getVert nw := by
          calc
            v = (X.path c).1.vertex k := by rw [hkl, hlv]
            _ = q.getVert nw := hkw
        exact hmeet (q.getVert nw) (q.getVert_mem_support nw)
          (hvw.symm ▸ ⟨c, hd⟩)
      · exact hmeet v ((q.isSubwalk_drop nw).support_subset hvDrop)
    let r : G.Path (X.path c).1.initial b := combined.toPath
    have hstart : (X.path c).1.initial ∈ A := X.isWave.1 ⟨c, rfl⟩
    rcases Y.isWave.2 (X.path c).1.initial hstart b hb
        (r : G.Walk (X.path c).1.initial b) r.property with
      ⟨y, hyr, hyTerminal⟩
    have hyCombined : y ∈ combined.support :=
      combined.support_toPath_subset_support hyr
    have hyNotU : y ∉ (alternatingWarp hXY t).vertexSet := by
      intro hyU
      exact hcombinedAvoid y hyCombined
        (right_terminal_mem_alternatingWarp_terminalSet hXY t hyTerminal hyU)
    rw [show combined = pref.append (q.drop nw) by rfl,
      Walk.mem_support_append_iff] at hyCombined
    have hyDrop : y ∈ (q.drop nw).support := by
      rcases hyCombined with hyPref | hyDrop
      · have hyPref' : y ∈ ((X.path c).1.prefixWalk k hkX).support := by
          change y ∈ (((X.path c).1.prefixWalk k hkX).copy rfl hkw).support
            at hyPref
          simpa only [Walk.support_copy] using hyPref
        rcases ((X.path c).1.mem_support_prefixWalk_iff hkX).mp hyPref' with
          ⟨m, hmk, hmy⟩
        have hyX : y ∈ (X.path c).1.vertexSet :=
          ⟨m, LongPath.active_mono hmk hkX, hmy⟩
        exact (hyNotU ⟨c,
          (left_forward_alternatingPath hXY t c).vertexSet_subset hyX⟩).elim
      · exact hyDrop
    let outsideU : Set V :=
      Y.toWarp.vertexSet \ (alternatingWarp hXY t).vertexSet
    have hyOutside : y ∈ outsideU :=
      ⟨Y.toWarp.terminalSet_subset_vertexSet hyTerminal, hyNotU⟩
    rcases exists_first_index_of_support_meets (q.drop nw) outsideU
        ⟨y, hyDrop, hyOutside⟩ with
      ⟨jy, hjyLe, hjyOutside, hjyFirst⟩
    let iy := nw + jy
    have hiyLe : iy ≤ q.length := by
      rw [Walk.drop_length] at hjyLe
      omega
    have hiyOutside : q.getVert iy ∈ outsideU := by
      simpa [iy, q.drop_getVert] using hjyOutside
    have hwnU : q.getVert nw ∈ (alternatingWarp hXY t).vertexSet := by
      exact ⟨c, (left_forward_alternatingPath hXY t c).vertexSet_subset
        ⟨k, hkX, hkw⟩⟩
    rcases exists_last_index_le_of_mem q
        (alternatingWarp hXY t).vertexSet
        (j := iy) ⟨nw, by omega, hwnU⟩ with
      ⟨iz, hizLe, hizU, hizLast⟩
    have hnwiz : nw ≤ iz := by
      by_contra hnwiz
      exact hizLast nw (by omega) (by omega) hwnU
    have hiziy : iz < iy := by
      by_contra hnot
      have heq : iz = iy := le_antisymm hizLe (Nat.le_of_not_gt hnot)
      exact hiyOutside.2 (heq ▸ hizU)
    have hzGate : q.getVert iz ∈ X.toWarp.vertexSet →
        q.getVert iz ∈ X.toWarp.terminalSet := by
      intro hzX
      have hiznw : iz = nw := by
        by_contra hiznw
        exact hnwLast iz (by omega) (by omega) hzX
      simpa [hiznw] using hwTerminal
    have hizU' := hizU
    change ∃ d, q.getVert iz ∈ (alternatingPath hXY t d).vertexSet
      at hizU'
    rcases hizU' with ⟨d, nz, hnzU, hnzv⟩
    have hnzY : longPathActive (Y.path d).1.terminalIndex nz :=
      (alternatingPath_forward_right hXY t d nz hnzU).1
    have hnzEq : (Y.path d).1.vertex nz = q.getVert iz := by
      calc
        (Y.path d).1.vertex nz = (alternatingPath hXY t d).vertex nz :=
          (vertex_alternatingPath hXY t d nz).symm
        _ = q.getVert iz := hnzv
    have hnzNotTerminal :
        (alternatingPath hXY t d).terminal? ≠
          some ((alternatingPath hXY t d).vertex nz) := by
      intro hterm
      apply hmeet (q.getVert iz) (q.getVert_mem_support iz)
      change ∃ e, (alternatingPath hXY t e).terminal? = some (q.getVert iz)
      exact ⟨d, hterm.trans (congrArg some
        ((vertex_alternatingPath hXY t d nz).trans hnzEq))⟩
    have hnzSucc : longPathActive
        (alternatingPath hXY t d).terminalIndex (nz + 1) :=
      (alternatingPath hXY t d).active_succ_of_active_of_terminal_ne
        hnzU hnzNotTerminal
    have hactiveSet :=
      (active_alternatingPath_iff hXY t d (nz + 1)).mp hnzSucc
    rcases hactiveSet with hXsucc | ⟨m, hnm, hmY, hmReach⟩
    · have hnzX : longPathActive (X.path d).1.terminalIndex nz :=
        LongPath.active_mono (Nat.le_succ nz) hXsucc
      have hnzXY := hXY d nz hnzX
      have hzX : q.getVert iz ∈ X.toWarp.vertexSet :=
        ⟨d, nz, hnzX, hnzXY.2.symm.trans hnzEq⟩
      have hzTerminal := hzGate hzX
      change ∃ e, (X.path e).1.terminal? = some (q.getVert iz)
        at hzTerminal
      rcases hzTerminal with ⟨e, he⟩
      have hed : e = d := by
        by_contra hed
        have hze : q.getVert iz ∈ (X.path e).1.vertexSet :=
          LongPath.terminal_mem_vertexSet he
        have hzd : q.getVert iz ∈ (X.path d).1.vertexSet :=
          ⟨nz, hnzX, hnzXY.2.symm.trans hnzEq⟩
        exact Set.disjoint_left.mp (X.disjoint hed) hze hzd
      subst e
      rcases LongPath.terminal?_eq_some_iff.mp he with
        ⟨l, hlFinite, hlv⟩
      have hlX : longPathActive (X.path d).1.terminalIndex l := by
        simp [hlFinite, longPathActive]
      have hnzl : nz = l := (X.path d).1.injective hnzX hlX <| by
        calc
          (X.path d).1.vertex nz = (Y.path d).1.vertex nz := hnzXY.2.symm
          _ = q.getVert iz := hnzEq
          _ = (X.path d).1.vertex l := hlv.symm
      have : nz + 1 ≤ l := by
        simpa [hlFinite, longPathActive] using hXsucc
      omega
    · rcases hmReach with ⟨rend, R, hR, hmR⟩
      let strictSuffix : Set V :=
        {v | ∃ r, nz < r ∧ r ≤ m ∧ (Y.path d).1.vertex r = v}
      have hmStrict : (Y.path d).1.vertex m ∈ strictSuffix :=
        ⟨m, by omega, le_rfl, rfl⟩
      rcases exists_first_index_of_support_meets R strictSuffix
          ⟨(Y.path d).1.vertex m, hmR, hmStrict⟩ with
        ⟨i, hiR, hiSuffix, hiFirst⟩
      rcases hiSuffix with ⟨k', hnzk', hk'm, hik'⟩
      have hk'Y : longPathActive (Y.path d).1.terminalIndex k' :=
        LongPath.active_mono hk'm hmY
      have hYi : R.getVert i ∈ Y.toWarp.vertexSet :=
        ⟨d, k', hk'Y, hik'⟩
      have hchoose : ∃ (s r : ℕ),
          s ≤ R.length ∧ nz ≤ r ∧ r ≤ k' ∧
          R.getVert s = (Y.path d).1.vertex r ∧
          X.IsAlternatingWalk Y (R.take s) ∧
          (∀ j, j < s → ∀ u, nz < u → u ≤ r →
            R.getVert j ≠ (Y.path d).1.vertex u) := by
        by_cases hi0 : i = 0
        · refine ⟨0, k', by omega, by omega, le_rfl, ?_, ?_, ?_⟩
          · simpa [hi0] using hik'.symm
          · apply hR.take_of_zero_or_previous_right 0 (by omega)
            exact Or.inl rfl
          · intro j hj
            omega
        · have hiPos : 0 < i := Nat.pos_of_ne_zero hi0
          rcases hR.2.2.2.2 i hiPos hiR hYi with hprev | hnext
          · refine ⟨i, k', hiR, by omega, le_rfl, hik'.symm, ?_, ?_⟩
            · exact hR.take_of_zero_or_previous_right i hiR
                (Or.inr (Or.inr hprev))
            · intro j hj u hnu hur heq
              exact hiFirst j (hj.le.trans hiR) hj
                ⟨u, hnu, hur.trans hk'm, heq.symm⟩
          · have hiNext : i + 1 ≤ R.length := by omega
            have hk'Pos : 0 < k' := by omega
            let walkDart : G.Dart := R.darts[i]'(by simpa using hnext.1)
            have hwalkDartMem : walkDart ∈ R.darts := List.getElem_mem ..
            have hwalkSymmY : walkDart.symm ∈ Y.toWarp.dartSet := by
              apply (hR.symm_mem_right_iff_edge_mem hwalkDartMem).mpr
              simpa [walkDart, Walk.getElem_edges,
                Walk.edge_getElem_darts] using hnext.2
            have hkPredActive : longPathActive
                (Y.path d).1.terminalIndex (k' - 1 + 1) := by
              simpa [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr
                (by omega : k' ≠ 0))] using hk'Y
            let pathDart : G.Dart :=
              ⟨((Y.path d).1.vertex (k' - 1), (Y.path d).1.vertex k'), by
                simpa [Nat.sub_add_cancel (by omega : 1 ≤ k')] using
                  (Y.path d).1.adjacent (k' - 1) hkPredActive⟩
            have hpathDartY : pathDart ∈ Y.toWarp.dartSet := by
              change ∃ e, pathDart ∈ (Y.path e).1.dartSet
              refine ⟨d, k' - 1, hkPredActive, ?_⟩
              simp [pathDart, Nat.sub_add_cancel (by omega : 1 ≤ k')]
            have hsameDart : walkDart.symm = pathDart := by
              apply Y.toWarp.dart_eq_of_snd_eq hwalkSymmY hpathDartY
              change walkDart.fst = (Y.path d).1.vertex k'
              have hfst := congrArg (fun e : G.Dart => e.fst)
                (R.darts_getElem_eq_getVert i (by simpa using hnext.1))
              calc
                walkDart.fst = R.getVert i := by simpa [walkDart] using hfst
                _ = (Y.path d).1.vertex k' := hik'.symm
            have hnextVertex : R.getVert (i + 1) =
                (Y.path d).1.vertex (k' - 1) := by
              have hsnd := congrArg (fun e : G.Dart => e.snd)
                (R.darts_getElem_eq_getVert i (by simpa using hnext.1))
              have heq := congrArg (fun e : G.Dart => e.fst) hsameDart
              change walkDart.snd = pathDart.fst at heq
              calc
                R.getVert (i + 1) = walkDart.snd := by
                  simpa [walkDart] using hsnd.symm
                _ = pathDart.fst := heq
                _ = (Y.path d).1.vertex (k' - 1) := rfl
            refine ⟨i + 1, k' - 1, hiNext, by omega, by omega,
              hnextVertex, ?_, ?_⟩
            · apply hR.take_of_zero_or_previous_right (i + 1) hiNext
              right
              right
              simpa using hnext.2
            · intro j hj u hnu hur heq
              by_cases hji : j = i
              · subst j
                have hku : k' = u :=
                  (Y.path d).1.injective hk'Y
                    (LongPath.active_mono (hur.trans (by omega)) hk'Y)
                    (hik'.trans heq)
                omega
              · exact hiFirst j (by omega) (by omega)
                  ⟨u, hnu, hur.trans (by omega), heq.symm⟩
      rcases hchoose with ⟨s, r', hsR, hnzr, hrk, hsEq, hsAlt, hsFirst⟩
      have hrY : longPathActive (Y.path d).1.terminalIndex r' :=
        LongPath.active_mono (hrk.trans hk'm) hmY
      let R' : G.Walk t ((Y.path d).1.vertex r') :=
        (R.take s).copy rfl hsEq
      have hR' : X.IsAlternatingWalk Y R' := by
        exact hsAlt.copy rfl hsEq
      have hsegmentX : ∀ u, nz ≤ u → u ≤ r' →
          (Y.path d).1.vertex u ∈ X.toWarp.vertexSet →
          (Y.path d).1.vertex u ∈ X.toWarp.terminalSet :=
        by
          have htail := right_tail_meets_left_only_terminal hXY d hnzY (by
            intro hzX
            exact hnzEq ▸ hzGate (hnzEq.symm ▸ hzX))
          intro u hnu hur huX
          exact htail u hnu (LongPath.active_mono hur hrY) huX
      have hcrossEdges : R'.edges.Disjoint
          ((Y.path d).1.segmentWalk hrY hnzr).reverse.edges := by
        simpa [R'] using hR.edges_take_disjoint_reverse_segment_of_first
          d hrY hnzr hsR hsFirst
      let Zwalk : G.Walk t ((Y.path d).1.vertex nz) :=
        R'.append ((Y.path d).1.segmentWalk hrY hnzr).reverse
      have hZalt : X.IsAlternatingWalk Y Zwalk := by
        exact hR'.append_reverse_segment hrY hnzr hsegmentX hcrossEdges
      have hZend : (Y.path d).1.vertex nz = q.getVert iz := hnzEq
      let Rz : G.Walk t (q.getVert iz) := Zwalk.copy rfl hZend
      have hRz : X.IsAlternatingWalk Y Rz := hZalt.copy rfl hZend
      have hreachZ : IsAlternatingReachable X Y t (q.getVert iz) :=
        ⟨q.getVert iz, Rz, hRz, Rz.end_mem_support⟩
      have hiyY : q.getVert iy ∈ Y.toWarp.vertexSet := hiyOutside.1
      change ∃ e : A, q.getVert iy ∈ (Y.path e).1.vertexSet at hiyY
      rcases hiyY with ⟨e, ky, hkyY, hkyEq⟩
      have hkyPos : 0 < ky := by
        by_contra hnot
        have hky0 : ky = 0 := by omega
        have hiyA : q.getVert iy ∈ A := by
          have heq : q.getVert iy = (e : V) := by
            calc
              q.getVert iy = (Y.path e).1.vertex 0 := by
                simpa [hky0] using hkyEq.symm
              _ = (e : V) := by
                simpa [LongPath.initial] using Y.path_initial e
          exact heq.symm ▸ e.property
        have hiyInit : q.getVert iy ∈
            (alternatingWarp hXY t).initialSet := by
          rw [alternatingWarp_initialSet]
          exact hiyA
        exact hiyOutside.2
          ((alternatingWarp hXY t).initialSet_subset_vertexSet hiyInit)
      have hbetweenNotY : ∀ j, iz < j → j < iy →
          q.getVert j ∉ Y.toWarp.vertexSet := by
        intro j hizj hjiy hjY
        have hjLe : j ≤ iy := by omega
        have hjNotU : q.getVert j ∉
            (alternatingWarp hXY t).vertexSet :=
          hizLast j hjLe hizj
        have hjOutside : q.getVert j ∈ outsideU := ⟨hjY, hjNotU⟩
        have hnwj : nw ≤ j := hnwiz.trans (Nat.le_of_lt hizj)
        have hdropLe : j - nw ≤ (q.drop nw).length := by
          rw [Walk.drop_length]
          omega
        have hdropLt : j - nw < jy := by
          dsimp [iy] at hjiy
          omega
        apply hjyFirst (j - nw) hdropLe hdropLt
        simpa [q.drop_getVert, Nat.add_sub_of_le hnwj] using hjOutside
      rcases exists_last_index_le_of_mem q {v | v ∈ Rz.support}
          (j := iy) ⟨iz, hizLe, Rz.end_mem_support⟩ with
        ⟨ir, hirLe, hirRz, hirLast⟩
      have hizir : iz ≤ ir := by
        by_contra hnot
        exact hirLast iz hizLe (by omega) Rz.end_mem_support
