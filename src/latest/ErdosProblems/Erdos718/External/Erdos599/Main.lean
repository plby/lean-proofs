            · have hiLast : i = iy - ir + 1 := by omega
              left
              have hprev : cont.getVert (i - 1) =
                  (Y.path e).1.vertex ky := by
                rw [show i - 1 = iy - ir by omega,
                  hcontGet (iy - ir) (by omega)]
                rw [show ir + (iy - ir) = iy by omega, hkyEq]
              have hcurr : cont.getVert i =
                  (Y.path e).1.vertex (ky - 1) := by
                rw [hiLast]
                exact hcontLast
              rw [hprev, hcurr]
              exact hfinalEdgeY
        · rw [Walk.mem_support_append_iff]
          exact Or.inr (hkyEq ▸ hyInCont)
      apply hiyOutside.2
      change ∃ a : A, q.getVert iy ∈
        (alternatingPath hXY t a).vertexSet
      refine ⟨e, ?_⟩
      simpa only [hkyEq] using
        reachable_vertex_mem_alternatingPath hXY t e hkyY hreachY

/-- The normalized total-wave representative of the alternating prefix.
Normalizing changes no active vertex, so Lemma 3.11 supplies its wave
property while its componentwise construction records that it extends the
left total wave. -/
noncomputable def alternatingTotalWave {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y)
    (t : V) (htX : t ∈ X.toWarp.terminalSet) : TotalWave G A B where
  path a := LongPath.toNormalized (alternatingPath hXY t a)
  baseForward a :=
    (X.baseForward a).trans
      ((left_forward_alternatingPath hXY t a).trans
        (LongPath.forward_normalize (alternatingPath hXY t a)))
  disjoint := by
    intro a b hab
    simpa [LongPath.toNormalized, alternatingWarp, Warp.ofPaths] using
      (alternatingWarp hXY t).disjoint hab
  isWave := by
    have hU := alternatingWarp_isWave hXY htX
    constructor
    · rintro v ⟨a, rfl⟩
      change (alternatingPath hXY t a).normalize.initial ∈ A
      rw [LongPath.initial_normalize]
      exact hU.1 ⟨a, rfl⟩
    · intro a ha b hb q hq
      rcases hU.2 a ha b hb q hq with ⟨v, hvq, i, hi⟩
      refine ⟨v, hvq, i, ?_⟩
      change (alternatingPath hXY t i).normalize.terminal? = some v
      rw [LongPath.terminal?_normalize]
      simpa [alternatingWarp, Warp.ofPaths] using hi

theorem le_alternatingTotalWave {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y)
    (t : V) (htX : t ∈ X.toWarp.terminalSet) :
    X ≤ alternatingTotalWave hXY t htX := by
  intro a
  exact (left_forward_alternatingPath hXY t a).trans
    (LongPath.forward_normalize (alternatingPath hXY t a))

/-- A common finite terminal of the two input components is still the
terminal of that component in the alternating total wave. -/
theorem alternatingTotalWave_terminal_of_common {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a : A) {t : V}
    (htX : (X.path a).1.terminal? = some t)
    (htY : (Y.path a).1.terminal? = some t) :
    ((alternatingTotalWave hXY t ⟨a, htX⟩).path a).1.terminal? =
      some t := by
  have htInX : t ∈ (X.path a).1.vertexSet :=
    LongPath.terminal_mem_vertexSet htX
  have htInAlt : t ∈ (alternatingPath hXY t a).vertexSet :=
    (left_forward_alternatingPath hXY t a).vertexSet_subset htInX
  have htAlt : (alternatingPath hXY t a).terminal? = some t :=
    (alternatingPath_forward_right hXY t a).terminal_of_mem_of_terminal
      htY htInAlt
  simpa [alternatingTotalWave, LongPath.toNormalized] using htAlt

/-- If the distinguished component is inessential in the right wave, it is
also inessential in the alternating total wave.  Indeed, an essential path
for the alternating wave must first meet `Y` away from the common terminal;
the first-contact lemma puts that vertex back in the alternating wave, a
contradiction.  This is the inessentiality assertion used in Shafer's proof
of Lemma 3.12. -/
theorem alternatingTotalWave_not_mem_essentialSources {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a₀ : A) {t : V}
    (htX : (X.path a₀).1.terminal? = some t)
    (htY : (Y.path a₀).1.terminal? = some t)
    (haY : a₀ ∉ Y.essentialSources) :
    a₀ ∉ (alternatingTotalWave hXY t ⟨a₀, htX⟩).essentialSources := by
  classical
  let U := alternatingTotalWave hXY t ⟨a₀, htX⟩
  have htU : (U.path a₀).1.terminal? = some t := by
    simpa [U] using
      alternatingTotalWave_terminal_of_common hXY a₀ htX htY
  intro haU
  rcases haU with ⟨u, huU, huEssential⟩
  have hut : u = t := Option.some.inj (huU.symm.trans htU)
  subst u
  have hUStrong : U.toWarp.IsEssentialPath B a₀ :=
    (U.isWave.isEssentialPath_iff_terminal_essential htU).mpr huEssential
  rcases hUStrong with
    ⟨u, huU', b, hb, q, hq, hqOnlyU⟩
  have hut' : u = t := Option.some.inj (huU'.symm.trans htU)
  subst u
  have hYNotStrong : ¬ Y.toWarp.IsEssentialPath B a₀ := by
    intro hYStrong
    apply haY
    refine ⟨t, htY, ?_⟩
    exact (Y.isWave.isEssentialPath_iff_terminal_essential htY).mp hYStrong
  have hmeet : ∃ y ∈ q.support,
      y ∈ Y.toWarp.vertexSet \ {t} := by
    by_contra hmeet
    apply hYNotStrong
    refine ⟨t, htY, b, hb, q, hq, ?_⟩
    intro v hvq hvY
    by_contra hvt
    apply hmeet
    exact ⟨v, hvq, hvY, hvt⟩
  rcases exists_first_index_of_support_meets q
      (Y.toWarp.vertexSet \ {t}) hmeet with
    ⟨n, hnle, hnDiff, hfirstDiff⟩
  have hnne : q.getVert n ≠ t := by
    simpa using hnDiff.2
  have hfirst : ∀ j, j ≤ q.length → j < n →
      q.getVert j ∈ Y.toWarp.vertexSet → q.getVert j = t := by
    intro j hjle hjn hjY
    by_contra hjt
    exact hfirstDiff j hjle hjn ⟨hjY, hjt⟩
  have hnAlt := first_right_contact_mem_alternatingWarp
    hXY a₀ htX htY q hq hnle hnDiff.1 hnne hfirst
  rcases hnAlt with ⟨d, hd⟩
  have hnU : q.getVert n ∈ U.toWarp.vertexSet := by
    refine ⟨d, ?_⟩
    have hd' : q.getVert n ∈
        (alternatingPath hXY t d).vertexSet := by
      simpa only [alternatingWarp, Warp.ofPaths] using hd
    change q.getVert n ∈ (U.path d).1.vertexSet
    change q.getVert n ∈ (alternatingPath hXY t d).normalize.vertexSet
    simpa using hd'
  have hnt : q.getVert n = t :=
    hqOnlyU (q.getVert n) (q.getVert_mem_support n) hnU
  exact hnne hnt

/-- In the hard case of the one-point lifting argument, the exterior
alternating wave cannot already separate the ambient web.  Otherwise every
path from its distinguished terminal to the ambient target meets the wave
away from that terminal, making the same source inessential in an ambient
forward extension and contradicting the no-bad-extension hypothesis. -/
theorem not_separates_alternatingTotalWave_of_no_direct_path {V : Type}
    {G : SimpleGraph V} {A B : Set V} (X : TotalWave G A B)
    (hNoBad : ∀ Z : TotalWave G A B, X ≤ Z →
      X.essentialSources ⊆ Z.essentialSources)
    {x : V} (hx : x ∉ X.toWarp.vertexSet)
    (Y : TotalWave (outsideGraph G {x}) A (B \ {x}))
    (hXY : toOutsideVertex X x hx ≤ Y) (a₀ : A) {t : V}
    (haX : a₀ ∈ X.essentialSources)
    (htX : (X.path a₀).1.terminal? = some t)
    (htY : (Y.path a₀).1.terminal? = some t)
    (haY : a₀ ∉ Y.essentialSources)
    (hnoDirect : ¬ ∃ q : G.Walk t x, q.IsPath ∧
      ∀ v ∈ q.support, v ∈ Y.toWarp.vertexSet → v = t) :
    ¬ Separates G A B
      (alternatingTotalWave hXY t
        ⟨a₀, (toOutsideVertex_terminal X x hx a₀).trans htX⟩).toWarp.terminalSet := by
  classical
  let Xo := toOutsideVertex X x hx
  have htXo : (Xo.path a₀).1.terminal? = some t := by
    simpa [Xo] using htX
  let U := alternatingTotalWave hXY t ⟨a₀, htXo⟩
  have htU : (U.path a₀).1.terminal? = some t := by
    simpa [U] using
      alternatingTotalWave_terminal_of_common hXY a₀ htXo htY
  have haU : a₀ ∉ U.essentialSources := by
    simpa [U] using
      alternatingTotalWave_not_mem_essentialSources
        hXY a₀ htXo htY haY
  have hXoU : Xo ≤ U := by
    simpa [U] using le_alternatingTotalWave hXY t ⟨a₀, htXo⟩
  have htVertex : t ∈ X.toWarp.vertexSet :=
    ⟨a₀, LongPath.terminal_mem_vertexSet htX⟩
  have htx : t ≠ x := by
    intro htx
    exact hx (htx ▸ htVertex)
  have hxA : x ∉ A := by
    intro hxA
    apply hx
    apply X.toWarp.initialSet_subset_vertexSet
    rw [X.initialSet_toWarp]
    exact hxA
  have hxY : x ∉ Y.toWarp.vertexSet := by
    rintro ⟨a, hxa⟩
    change A at a
    have hinit : (Y.path a).1.initial ∉ ({x} : Set V) := by
      simpa [Y.path_initial a] using
        (show (a : V) ≠ x from fun hax ↦ hxA (hax ▸ a.property))
    have := (Y.path a).1.vertex_not_mem_of_outsideGraph hinit hxa
    exact this (Set.mem_singleton x)
  have hNotStrong : ¬ U.toWarp.IsEssentialPath (B \ {x}) a₀ := by
    intro hStrong
    apply haU
    refine ⟨t, htU, ?_⟩
    exact (U.isWave.isEssentialPath_iff_terminal_essential htU).mp hStrong
  have hall : ∀ b ∈ B, ∀ q : G.Walk t b, q.IsPath →
      ∃ v ∈ q.support, v ∈ U.toWarp.vertexSet ∧ v ≠ t := by
    intro b hb q hq
    by_cases hxq : x ∈ q.support
    · let px : G.Walk t x := q.takeUntil x hxq
      have hpx : px.IsPath := hq.takeUntil hxq
      have hmeetY : ∃ y ∈ px.support,
          y ∈ Y.toWarp.vertexSet \ {t} := by
        by_contra hmeetY
        apply hnoDirect
        refine ⟨px, hpx, ?_⟩
        intro v hvpx hvY
        by_contra hvt
        apply hmeetY
        exact ⟨v, hvpx, hvY, hvt⟩
      rcases exists_right_contact_mem_alternatingWarp_before_deleted
          hXY a₀ htXo htY hxY px hpx hmeetY with
        ⟨v, hvpx, hvAlt, hvt⟩
      have hvq : v ∈ q.support :=
        q.support_takeUntil_subset_support hxq hvpx
      have hvU : v ∈ U.toWarp.vertexSet := by
        rcases hvAlt with ⟨d, hd⟩
        refine ⟨d, ?_⟩
        have hd' : v ∈ (alternatingPath hXY t d).vertexSet := by
          simpa only [alternatingWarp, Warp.ofPaths] using hd
        change v ∈ (U.path d).1.vertexSet
        change v ∈ (alternatingPath hXY t d).normalize.vertexSet
        simpa using hd'
      exact ⟨v, hvq, hvU, hvt⟩
    · have houtside : ∀ v ∈ q.support, v ∉ ({x} : Set V) := by
        intro v hv hvx
        exact hxq (Set.mem_singleton_iff.mp hvx ▸ hv)
      let qE : (outsideGraph G {x}).Walk t b :=
        Erdos599.Walk.toOutsideGraph q houtside
      have hqE : qE.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph hq houtside
      have hbx : b ≠ x := by
        intro hbx
        apply hxq
        simpa [hbx] using q.end_mem_support
      by_contra hmeetU
      apply hNotStrong
      refine ⟨t, htU, b, ⟨hb, by simpa using hbx⟩,
        qE, hqE, ?_⟩
      intro v hvqE hvU
      by_contra hvt
      apply hmeetU
      refine ⟨v, ?_, hvU, hvt⟩
      simpa [qE] using hvqE
  intro hsep
  let Ua := mapLEOfSeparates (outsideGraph_le G {x}) U hsep
  have hXUa : X ≤ Ua := by
    intro a n hn
    have h := hXoU a n hn
    exact h
  have haUa : a₀ ∈ Ua.essentialSources := hNoBad Ua hXUa haX
  rcases haUa with ⟨u, huUa, huEssential⟩
  have hut : u = t := by
    have huU : (U.path a₀).1.terminal? = some u := by
      simpa [Ua] using huUa
    exact Option.some.inj (huU.symm.trans htU)
  subst u
  have hStrong : Ua.toWarp.IsEssentialPath B a₀ :=
    (Ua.isWave.isEssentialPath_iff_terminal_essential huUa).mpr huEssential
  rcases hStrong with ⟨u, huUa', b, hb, q, hq, hqOnly⟩
  have hut' : u = t := Option.some.inj (huUa'.symm.trans huUa)
  subst u
  rcases hall b hb q hq with ⟨v, hvq, hvU, hvt⟩
  have hvUa : v ∈ Ua.toWarp.vertexSet := by
    rcases hvU with ⟨a, hva⟩
    change v ∈ (U.path a).1.vertexSet at hva
    refine ⟨a, ?_⟩
    change v ∈ (Ua.path a).1.vertexSet
    change v ∈ ((U.path a).1.mapLE (outsideGraph_le G {x})).vertexSet
    simpa using hva
  exact hvt (hqOnly v hvq hvUa)

/-- On an ambient separator-avoiding path through the deleted vertex, the
last contact with the exterior alternating wave occurs before the deleted
vertex and is alternating-reachable.  Lastness makes every possible contact
with the left warp a left terminal, which is exactly the gate required by
`alternating_reachable_of_mem_not_terminal_of_left_gate`. -/
theorem exists_reachable_last_contact_before_deleted {V : Type}
    {G : SimpleGraph V} {A B : Set V} (X : TotalWave G A B)
    {x : V} (hx : x ∉ X.toWarp.vertexSet)
    (Y : TotalWave (outsideGraph G {x}) A (B \ {x}))
    (hXY : toOutsideVertex X x hx ≤ Y) {t : V}
    (htXo : t ∈ (toOutsideVertex X x hx).toWarp.terminalSet)
    {a b : V} (ha : a ∈ A) (hb : b ∈ B)
    (q : G.Walk a b) (hq : q.IsPath)
    (havoid : ∀ v ∈ q.support,
      v ∉ (alternatingTotalWave hXY t htXo).toWarp.terminalSet)
    (hxq : x ∈ q.support) :
    ∃ (iz ix : ℕ), iz < ix ∧ ix ≤ q.length ∧
      q.getVert ix = x ∧
      q.getVert iz ∈ (alternatingWarp hXY t).vertexSet ∧
      (∃ R : (outsideGraph G {x}).Walk t (q.getVert iz),
        (toOutsideVertex X x hx).IsAlternatingWalk Y R) ∧
      (∀ m ≤ q.length, iz < m →
        q.getVert m ∉ (alternatingWarp hXY t).vertexSet) := by
  classical
  let Xo := toOutsideVertex X x hx
  let U := alternatingTotalWave hXY t htXo
  rcases Walk.mem_support_iff_exists_getVert.mp hxq with
    ⟨ix, hixx, hixle⟩
  have haU : a ∈ U.toWarp.vertexSet := by
    apply U.toWarp.initialSet_subset_vertexSet
    rw [U.initialSet_toWarp]
    exact ha
  rcases exists_last_index_of_support_meets q U.toWarp.vertexSet
      ⟨a, q.start_mem_support, haU⟩ with
    ⟨iz, hizle, hizU, hizlast⟩
  have hizNotTerminal : q.getVert iz ∉ U.toWarp.terminalSet :=
    havoid (q.getVert iz) (q.getVert_mem_support iz)
  have hixNotLt : ¬ ix < iz := by
    intro hixiz
    have hzTerminal := last_exterior_wave_vertex_after_deleted_is_terminal
      U ha hb q hq hixle hixx hizle hixiz hizU hizlast
    exact hizNotTerminal hzTerminal
  have hxU : x ∉ U.toWarp.vertexSet := by
    rintro ⟨c, hcx⟩
    change A at c
    have hinit : (U.path c).1.initial ∉ ({x} : Set V) := by
      have hxA : x ∉ A := by
        intro hxA
        apply hx
        apply X.toWarp.initialSet_subset_vertexSet
        rw [X.initialSet_toWarp]
        exact hxA
      simpa [U.path_initial c] using
        (show (c : V) ≠ x from fun hcx ↦ hxA (hcx ▸ c.property))
    have := (U.path c).1.vertex_not_mem_of_outsideGraph hinit hcx
    exact this (Set.mem_singleton x)
  have hizix : iz < ix := by
    have hizleix : iz ≤ ix := Nat.le_of_not_gt hixNotLt
    exact lt_of_le_of_ne hizleix (by
      intro hizix
      apply hxU
      have : q.getVert iz = x := hizix ▸ hixx
      exact this ▸ hizU)
  have hizAlt : q.getVert iz ∈ (alternatingWarp hXY t).vertexSet := by
    rcases hizU with ⟨d, hd⟩
    refine ⟨d, ?_⟩
    have hd' : q.getVert iz ∈ (U.path d).1.vertexSet := hd
    change q.getVert iz ∈ (alternatingPath hXY t d).normalize.vertexSet at hd'
    have : q.getVert iz ∈ (alternatingPath hXY t d).vertexSet := by
      simpa using hd'
    simpa only [alternatingWarp, Warp.ofPaths] using this
  have hizAltNotTerminal :
      q.getVert iz ∉ (alternatingWarp hXY t).terminalSet := by
    intro hzTerm
    apply hizNotTerminal
    rcases hzTerm with ⟨d, hd⟩
    refine ⟨d, ?_⟩
    change (U.path d).1.terminal? = some (q.getVert iz)
    change (alternatingPath hXY t d).normalize.terminal? = some (q.getVert iz)
    rw [LongPath.terminal?_normalize]
    simpa only [alternatingWarp, Warp.ofPaths] using hd
  have hzGate : q.getVert iz ∈ Xo.toWarp.vertexSet →
      q.getVert iz ∈ Xo.toWarp.terminalSet := by
    intro hzXo
    have hzX : q.getVert iz ∈ X.toWarp.vertexSet := by
      rcases hzXo with ⟨c, hc⟩
      change q.getVert iz ∈ (Xo.path c).1.vertexSet at hc
      refine ⟨c, ?_⟩
      have hcmap : q.getVert iz ∈
          ((Xo.path c).1.mapLE (outsideGraph_le G {x})).vertexSet := by
        simpa using hc
      rw [show ((Xo.path c).1.mapLE (outsideGraph_le G {x})) =
          (X.path c).1 by
        simpa [Xo] using toOutsideVertex_path_mapLE X x hx c] at hcmap
      exact hcmap
    have hzTermX := last_wave_vertex_is_terminal X ha hb q hq hizle hzX (by
      intro m hmle hizm hmX
      apply hizlast m hmle hizm
      rcases hmX with ⟨c, hc⟩
      have hcmap : q.getVert m ∈
          ((Xo.path c).1.mapLE (outsideGraph_le G {x})).vertexSet := by
        rw [show ((Xo.path c).1.mapLE (outsideGraph_le G {x})) =
            (X.path c).1 by
          simpa [Xo] using toOutsideVertex_path_mapLE X x hx c]
        exact hc
      have hmXo : q.getVert m ∈ Xo.toWarp.vertexSet := by
        refine ⟨c, ?_⟩
        change q.getVert m ∈ (Xo.path c).1.vertexSet
        simpa using hcmap
      exact WaveExtension.vertexSet_subset_of_le
        (le_alternatingTotalWave hXY t htXo) hmXo)
    rcases hzTermX with ⟨c, hc⟩
    refine ⟨c, ?_⟩
    change (Xo.path c).1.terminal? = some (q.getVert iz)
    exact (toOutsideVertex_terminal X x hx c).trans hc
  have hzReach := exists_alternatingWalk_of_mem_not_terminal_of_left_gate
    hXY t hizAlt hizAltNotTerminal hzGate
  refine ⟨iz, ix, hizix, hixle, hixx, hizAlt, hzReach, ?_⟩
  intro m hmle hizm hmAlt
  apply hizlast m hmle hizm
  rcases hmAlt with ⟨d, hd⟩
  refine ⟨d, ?_⟩
  have hd' : q.getVert m ∈ (alternatingPath hXY t d).vertexSet := by
    simpa only [alternatingWarp, Warp.ofPaths] using hd
  change q.getVert m ∈ (U.path d).1.vertexSet
  change q.getVert m ∈ (alternatingPath hXY t d).normalize.vertexSet
  simpa using hd'

/-- An alternating walk can be extended along a simple path segment whose
strictly later vertices avoid the right warp.  The old walk is first trimmed
at its last intersection with the segment; consequently the remaining path
segment has no repeated vertex or edge with the retained prefix.  This is the
last-intersection splice in the final paragraph of Shafer's Lemma 3.12. -/
theorem IsAlternatingWalk.exists_extend_along_path_avoiding_right {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y)
    {t a b : V} {q : G.Walk a b} (hq : q.IsPath)
    {iz ix : ℕ} (hizix : iz < ix) (hixle : ix ≤ q.length)
    {R : G.Walk t (q.getVert iz)} (hR : X.IsAlternatingWalk Y R)
    (havoidY : ∀ m, iz < m → m ≤ ix →
      q.getVert m ∉ Y.toWarp.vertexSet) :
    ∃ S : G.Walk t (q.getVert ix), X.IsAlternatingWalk Y S := by
  classical
  rcases exists_last_index_le_of_mem q {v | v ∈ R.support}
      (j := ix) ⟨iz, hizix.le, R.end_mem_support⟩ with
    ⟨ir, hirix, hirR, hirLast⟩
  have hizir : iz ≤ ir := by
    by_contra hnot
    exact hirLast iz hizix.le (by omega) R.end_mem_support
  obtain ⟨sr, hsrle, hsrEq, hsrAlt⟩ :
      ∃ sr ≤ R.length, R.getVert sr = q.getVert ir ∧
        X.IsAlternatingWalk Y (R.take sr) := by
    by_cases hiriz : ir = iz
    · subst ir
      refine ⟨R.length, le_rfl, by simp, ?_⟩
      rw [R.take_of_length_le le_rfl]
      exact hR.copy rfl (by simp)
    · rcases Walk.mem_support_iff_exists_getVert.mp hirR with
        ⟨sr, hsrEq, hsrle⟩
      refine ⟨sr, hsrle, hsrEq, ?_⟩
      apply hR.take_of_zero_or_previous_right sr hsrle
      right
      left
      exact hsrEq.symm ▸ havoidY ir (by omega) hirix
  let Rpre : G.Walk t (q.getVert ir) :=
    (R.take sr).copy rfl hsrEq
  have hRpre : X.IsAlternatingWalk Y Rpre :=
    hsrAlt.copy rfl hsrEq
  let qp : LongPath G := LongPath.ofWalk q hq
  have hixActive : longPathActive qp.terminalIndex ix := by
    simp [qp, LongPath.ofWalk, longPathActive, hixle]
  let seg : G.Walk (q.getVert ir) (q.getVert ix) :=
    (qp.segmentWalk hixActive hirix).copy rfl rfl
  have hsegLength : seg.length = ix - ir := by
    change ((qp.segmentWalk hixActive hirix).copy rfl rfl).length = _
    simpa only [Walk.length_copy] using
      qp.length_segmentWalk hixActive hirix
  have hsegGet (j : ℕ) (hj : j ≤ ix - ir) :
      seg.getVert j = q.getVert (ir + j) := by
    change ((qp.segmentWalk hixActive hirix).copy rfl rfl).getVert j = _
    rw [Walk.getVert_copy,
      qp.getVert_segmentWalk hixActive hirix hj]
    rfl
  have hsegPath : seg.IsPath := by
    apply Walk.IsPath.mk'
    change ((qp.segmentWalk hixActive hirix).copy rfl rfl).support.Nodup
    rw [Walk.support_copy]
    exact (qp.segmentWalk_isPath hixActive hirix).support_nodup
  have hmemSeg {v : V} : v ∈ seg.support ↔
      ∃ m, ir ≤ m ∧ m ≤ ix ∧ q.getVert m = v := by
    change v ∈ ((qp.segmentWalk hixActive hirix).copy rfl rfl).support ↔ _
    rw [Walk.support_copy]
    simpa only [qp, LongPath.ofWalk] using
      qp.mem_support_segmentWalk_iff hixActive hirix (v := v)
  have hstartNotTail : q.getVert ir ∉ seg.support.tail := by
    have hnd := hsegPath.support_nodup
    rw [← seg.cons_tail_support] at hnd
    exact (List.nodup_cons.mp hnd).1
  have htailNotR : ∀ v ∈ seg.support.tail, v ∉ R.support := by
    intro v hvTail hvR
    have hvSeg : v ∈ seg.support :=
      seg.mem_support_iff.mpr (Or.inr hvTail)
    rcases hmemSeg.mp hvSeg with ⟨m, hirm, hmix, hmv⟩
    have hirmStrict : ir < m := by
      rcases Nat.lt_or_eq_of_le hirm with h | rfl
      · exact h
      · exact (hstartNotTail (hmv ▸ hvTail)).elim
    exact hirLast m hmix hirmStrict (hmv ▸ hvR)
  have hXseg : ∀ v ∈ seg.support,
      v ∈ X.toWarp.vertexSet → v ∈ X.toWarp.terminalSet := by
    intro v hvSeg hvX
    rcases hmemSeg.mp hvSeg with ⟨m, hirm, hmix, hmv⟩
    rcases Nat.lt_or_eq_of_le hirm with hirmStrict | rfl
    · have hmY := WaveExtension.vertexSet_subset_of_le hXY hvX
      exact (havoidY m (hizir.trans_lt hirmStrict) hmix
        (hmv ▸ hmY)).elim
    · exact hmv ▸ hRpre.1 (q.getVert ir) Rpre.end_mem_support
        (hmv.symm ▸ hvX)
  have hdartSeg : ∀ d ∈ seg.darts,
      d.symm ∈ Y.toWarp.dartSet ∨
        (d ∉ Y.toWarp.dartSet ∧ d.symm ∉ Y.toWarp.dartSet) := by
    intro d hd
    right
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert seg).mp hd with
      ⟨j, hj, hdPair⟩
    have hjlt : j < ix - ir := by simpa [hsegLength] using hj
    have hsnd : d.snd = q.getVert (ir + j + 1) := by
      calc
        d.snd = seg.getVert (j + 1) := congrArg Prod.snd hdPair
        _ = q.getVert (ir + (j + 1)) := hsegGet (j + 1) (by omega)
        _ = q.getVert (ir + j + 1) := by congr 1 <;> omega
    have hsndNotY : d.snd ∉ Y.toWarp.vertexSet := by
      rw [hsnd]
      apply havoidY (ir + j + 1)
      · omega
      · omega
    constructor
    · intro hdY
      exact hsndNotY (Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hdY)
    · intro hdY
      exact hsndNotY (Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hdY)
  have hcross : ∀ v ∈ Rpre.support, v ∈ seg.support.tail →
      v ∈ Y.toWarp.vertexSet := by
    intro v hvR hvTail
    have hvRfull : v ∈ R.support := by
      change v ∈ ((R.take sr).copy rfl hsrEq).support at hvR
      rw [Walk.support_copy, Walk.support_take] at hvR
      exact List.mem_of_mem_take hvR
    exact (htailNotR v hvTail hvRfull).elim
  have hedgesCross : Rpre.edges.Disjoint seg.edges := by
    rw [List.disjoint_left]
    intro e heRpre heSeg
    have heR : e ∈ R.edges := by
      change e ∈ ((R.take sr).copy rfl hsrEq).edges at heRpre
      rw [Walk.edges_copy, Walk.edges_take] at heRpre
      exact List.mem_of_mem_take heRpre
    rw [Walk.edges_eq_map_darts, List.mem_map] at heR heSeg
    rcases heR with ⟨dR, hdR, hdREdge⟩
    rcases heSeg with ⟨dS, hdS, hdSEdge⟩
    have hsndR : dS.snd ∈ R.support := by
      have hedge : dR.edge = dS.edge := hdREdge.trans hdSEdge.symm
      rcases (dart_edge_eq_iff dR dS).mp hedge with hEq | hEq
      · subst dR
        exact R.dart_snd_mem_support_of_mem_darts hdR
      · have hfst : dS.snd = dR.fst := by
          simpa [hEq]
        exact hfst.symm ▸ R.dart_fst_mem_support_of_mem_darts hdR
    have hsndTail : dS.snd ∈ seg.support.tail := by
      rcases (Erdos599.Walk.mem_darts_iff_exists_getVert seg).mp hdS with
        ⟨j, hj, hdPair⟩
      have hsnd : dS.snd = seg.getVert (j + 1) :=
        congrArg Prod.snd hdPair
      rw [hsnd]
      apply seg.getVert_mem_tail_support
      · exact Walk.not_nil_iff_lt_length.mpr (by omega)
      · omega
    exact htailNotR dS.snd hsndTail hsndR
  have hincident : ∀ i, 0 < i → i ≤ seg.length →
      seg.getVert i ∈ Y.toWarp.vertexSet →
      s(seg.getVert (i - 1), seg.getVert i) ∈ Y.toWarp.edgeSet ∨
        (i < seg.length ∧
          s(seg.getVert i, seg.getVert (i + 1)) ∈ Y.toWarp.edgeSet) := by
    intro i hi0 hile hiY
    have hiSub : i ≤ ix - ir := by simpa [hsegLength] using hile
    have hget := hsegGet i hiSub
    exact (havoidY (ir + i) (by omega) (by omega) (hget.symm ▸ hiY)).elim
  refine ⟨Rpre.append seg, ?_⟩
  apply hRpre.append_of_compatible seg hXseg hdartSeg
  · intro i j hi hj hij heq
    exact (hij (hsegPath.getVert_injOn hi hj heq)).elim
  · exact hcross
  · exact hsegPath.isTrail.edges_nodup
  · exact hedgesCross
  · exact hincident

/-- At a nonterminal vertex of the alternating prefix, every incident edge
of the right warp continues inside that prefix.  Disjointness of the right
warp identifies the unique component containing the vertex. -/
theorem right_dart_neighbor_mem_alternatingWarp_of_nonterminal {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (t z : V)
    (hzU : z ∈ (alternatingWarp hXY t).vertexSet)
    (hzNotTerminal : z ∉ (alternatingWarp hXY t).terminalSet)
    {δ : G.Dart} (hδY : δ ∈ Y.toWarp.dartSet) :
    (δ.fst = z → δ.snd ∈ (alternatingWarp hXY t).vertexSet) ∧
      (δ.snd = z → δ.fst ∈ (alternatingWarp hXY t).vertexSet) := by
  classical
  change ∃ d, z ∈ (alternatingPath hXY t d).vertexSet at hzU
  rcases hzU with ⟨d, nz, hnzU, hnzEq⟩
  have hnzY : longPathActive (Y.path d).1.terminalIndex nz :=
    (alternatingPath_forward_right hXY t d nz hnzU).1
  have hnzValue : (Y.path d).1.vertex nz = z := by
    calc
      (Y.path d).1.vertex nz = (alternatingPath hXY t d).vertex nz :=
        (vertex_alternatingPath hXY t d nz).symm
      _ = z := hnzEq
  have hnzNotTerminal' :
      (alternatingPath hXY t d).terminal? ≠
        some ((alternatingPath hXY t d).vertex nz) := by
    intro hterm
    apply hzNotTerminal
    change ∃ e, (alternatingPath hXY t e).terminal? = some z
    exact ⟨d, hterm.trans (congrArg some
      ((vertex_alternatingPath hXY t d nz).trans hnzValue))⟩
  have hnzSucc : longPathActive
      (alternatingPath hXY t d).terminalIndex (nz + 1) :=
    (alternatingPath hXY t d).active_succ_of_active_of_terminal_ne
      hnzU hnzNotTerminal'
  constructor
  · intro hδfst
    change ∃ a : A, δ ∈ (Y.path a).1.dartSet at hδY
    rcases hδY with ⟨a, l, hlY, hδPair⟩
    have hlY0 := LongPath.active_mono (Nat.le_succ l) hlY
    have hza : z ∈ (Y.path a).1.vertexSet := by
      refine ⟨l, hlY0, ?_⟩
      exact (congrArg Prod.fst hδPair).symm.trans hδfst
    have hzd : z ∈ (Y.path d).1.vertexSet :=
      ⟨nz, hnzY, hnzValue⟩
    have had : a = d := by
      by_contra had
      exact Set.disjoint_left.mp (Y.disjoint had) hza hzd
    subst a
    have hln : l = nz := (Y.path d).1.injective hlY0 hnzY <| by
      calc
        (Y.path d).1.vertex l = δ.fst :=
          (congrArg Prod.fst hδPair).symm
        _ = z := hδfst
        _ = (Y.path d).1.vertex nz := hnzValue.symm
    subst l
    change ∃ a : A, δ.snd ∈ (alternatingPath hXY t a).vertexSet
    refine ⟨d, nz + 1, hnzSucc, ?_⟩
    calc
      (alternatingPath hXY t d).vertex (nz + 1) =
          (Y.path d).1.vertex (nz + 1) :=
        vertex_alternatingPath hXY t d (nz + 1)
      _ = δ.snd := (congrArg Prod.snd hδPair).symm
  · intro hδsnd
    change ∃ a : A, δ ∈ (Y.path a).1.dartSet at hδY
    rcases hδY with ⟨a, l, hlY, hδPair⟩
    have hza : z ∈ (Y.path a).1.vertexSet := by
      refine ⟨l + 1, hlY, ?_⟩
      exact (congrArg Prod.snd hδPair).symm.trans hδsnd
    have hzd : z ∈ (Y.path d).1.vertexSet :=
      ⟨nz, hnzY, hnzValue⟩
    have had : a = d := by
      by_contra had
      exact Set.disjoint_left.mp (Y.disjoint had) hza hzd
    subst a
    have hln : l + 1 = nz := (Y.path d).1.injective hlY hnzY <| by
      calc
        (Y.path d).1.vertex (l + 1) = δ.snd :=
          (congrArg Prod.snd hδPair).symm
        _ = z := hδsnd
        _ = (Y.path d).1.vertex nz := hnzValue.symm
    change ∃ a : A, δ.fst ∈ (alternatingPath hXY t a).vertexSet
    refine ⟨d, l, LongPath.active_mono (by omega) hnzU, ?_⟩
    calc
      (alternatingPath hXY t d).vertex l = (Y.path d).1.vertex l :=
        vertex_alternatingPath hXY t d l
      _ = δ.fst := (congrArg Prod.fst hδPair).symm

/-- Starting from an alternating-reachable nonterminal of the alternating
prefix, the first later contact of a simple path with the right warp also
belongs to the alternating prefix.  The last-intersection splice reaches the
predecessor of the contact; one external edge followed by one right-warp edge
backwards then witnesses reachability of the contact itself. -/
theorem first_right_contact_after_reachable_mem_alternatingWarp {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) {t a b : V} (q : G.Walk a b) (hq : q.IsPath)
    {iz iy : ℕ} (hiziy : iz < iy) (hiyle : iy ≤ q.length)
    (hizU : q.getVert iz ∈ (alternatingWarp hXY t).vertexSet)
    (hizNotTerminal :
      q.getVert iz ∉ (alternatingWarp hXY t).terminalSet)
    {R : G.Walk t (q.getVert iz)} (hR : X.IsAlternatingWalk Y R)
    (hbetween : ∀ m, iz < m → m < iy →
      q.getVert m ∉ Y.toWarp.vertexSet)
    (hiyY : q.getVert iy ∈ Y.toWarp.vertexSet) :
    q.getVert iy ∈ (alternatingWarp hXY t).vertexSet := by
  classical
  by_contra hiyNotU
  let ip := iy - 1
  have hipiy : ip < iy := by
    dsimp [ip]
    omega
  have hizip : iz ≤ ip := by
    dsimp [ip]
    omega
  have hiple : ip ≤ q.length := hipiy.le.trans hiyle
  obtain ⟨Rpre, hRpre⟩ :
      ∃ Rpre : G.Walk t (q.getVert ip),
        X.IsAlternatingWalk Y Rpre := by
    by_cases hipEq : ip = iz
    · refine ⟨R.copy rfl (congrArg q.getVert hipEq.symm), ?_⟩
      exact hR.copy rfl (congrArg q.getVert hipEq.symm)
    · apply hR.exists_extend_along_path_avoiding_right hXY hq
        (iz := iz) (ix := ip)
      · omega
      · exact hiple
      · intro m hizm hmip
        exact hbetween m hizm (hmip.trans_lt hipiy)
  have hadj : G.Adj (q.getVert ip) (q.getVert iy) := by
    have h := q.adj_getVert_succ (i := ip) (by omega)
    simpa [ip, Nat.sub_add_cancel (by omega : 1 ≤ iy)] using h
  let δq : G.Dart := ⟨(q.getVert ip, q.getVert iy), hadj⟩
  have hδqExternal :
      δq ∉ Y.toWarp.dartSet ∧ δq.symm ∉ Y.toWarp.dartSet := by
    constructor
    · intro hδY
      by_cases hipEq : ip = iz
      · have hnext :=
          (right_dart_neighbor_mem_alternatingWarp_of_nonterminal
            hXY t (q.getVert iz) hizU hizNotTerminal hδY).1
      
        apply hiyNotU
        apply hnext
        simp [δq, hipEq]
      · have hipY := Y.toWarp.fst_mem_vertexSet_of_mem_dartSet hδY
        exact hbetween ip (by omega) hipiy (by simpa [δq] using hipY)
    · intro hδY
      by_cases hipEq : ip = iz
      · have hnext :=
          (right_dart_neighbor_mem_alternatingWarp_of_nonterminal
            hXY t (q.getVert iz) hizU hizNotTerminal hδY).2
        apply hiyNotU
        simpa [δq, hipEq] using hnext (by simp [δq, hipEq])
      · have hipY := Y.toWarp.snd_mem_vertexSet_of_mem_dartSet hδY
        exact hbetween ip (by omega) hipiy (by simpa [δq] using hipY)
  change ∃ e : A, q.getVert iy ∈ (Y.path e).1.vertexSet at hiyY
  rcases hiyY with ⟨e, ky, hkyY, hkyEq⟩
  have hkyPos : 0 < ky := by
    by_contra hnot
    have hky0 : ky = 0 := by omega
    apply hiyNotU
    apply left_vertexSet_subset_alternatingWarp hXY t
    refine ⟨e, ?_⟩
    have hinit : (e : V) ∈ (X.path e).1.vertexSet := by
      simpa [X.path_initial e] using (X.path e).1.initial_mem_vertexSet
    have heq : (e : V) = q.getVert iy := by
      calc
        (e : V) = (Y.path e).1.vertex 0 := by
          simpa [LongPath.initial] using (Y.path_initial e).symm
        _ = q.getVert iy := by simpa [hky0] using hkyEq
    exact heq ▸ hinit
  have hkyPred : longPathActive (Y.path e).1.terminalIndex (ky - 1) :=
    LongPath.active_mono (by omega) hkyY
  let y := q.getVert iy
  let pred := (Y.path e).1.vertex (ky - 1)
  have hyEq : (Y.path e).1.vertex ky = y := hkyEq
  let seg : G.Walk (q.getVert ip) y :=
    ((.nil : G.Walk (q.getVert ip) (q.getVert ip)).concat hadj).copy
      rfl rfl
  let segY : G.Walk (q.getVert ip) ((Y.path e).1.vertex ky) :=
    seg.copy rfl hyEq.symm
  have hback : G.Adj ((Y.path e).1.vertex ky) pred := by
    have hsucc : longPathActive (Y.path e).1.terminalIndex (ky - 1 + 1) := by
      simpa [Nat.sub_add_cancel (by omega : 1 ≤ ky)] using hkyY
    simpa [pred, Nat.sub_add_cancel (by omega : 1 ≤ ky)] using
      ((Y.path e).1.adjacent (ky - 1) hsucc).symm
  let cont : G.Walk (q.getVert ip) pred := segY.concat hback
  have hsegLength : seg.length = 1 := by simp [seg]
  have hsegYLength : segY.length = 1 := by simp [segY, hsegLength]
  have hcontLength : cont.length = 2 := by
    simp [cont, hsegYLength]
  have hgetZero : cont.getVert 0 = q.getVert ip := by simp [cont, segY, seg]
  have hgetOne : cont.getVert 1 = (Y.path e).1.vertex ky := by
    rw [show cont = segY.concat hback by rfl, Walk.concat_eq_append,
      Walk.getVert_append']
    rw [if_pos (by simpa [hsegYLength])]
    rw [← hsegYLength]
    exact segY.getVert_length
  have hgetTwo : cont.getVert 2 = pred := by
    rw [← hcontLength]
    exact cont.getVert_length
  let lastDart : G.Dart :=
    ⟨(pred, (Y.path e).1.vertex ky), by
      have hsucc : longPathActive
          (Y.path e).1.terminalIndex (ky - 1 + 1) := by
        simpa [Nat.sub_add_cancel (by omega : 1 ≤ ky)] using hkyY
      simpa [pred, Nat.sub_add_cancel (by omega : 1 ≤ ky)] using
        (Y.path e).1.adjacent (ky - 1) hsucc⟩
  have hlastDartY : lastDart ∈ Y.toWarp.dartSet := by
    change ∃ d : A, lastDart ∈ (Y.path d).1.dartSet
    refine ⟨e, ky - 1, ?_, ?_⟩
    · simpa [Nat.sub_add_cancel (by omega : 1 ≤ ky)] using hkyY
    · simp [lastDart, pred, Nat.sub_add_cancel (by omega : 1 ≤ ky)]
  have hfinalEdgeY :
      s((Y.path e).1.vertex ky, pred) ∈ Y.toWarp.edgeSet := by
    apply (Y.toWarp.mem_edgeSet_iff).mpr
    refine ⟨lastDart, hlastDartY, ?_⟩
    simp [lastDart, pred]
  have hsegDart (d : G.Dart) (hd : d ∈ segY.darts) : d = δq := by
    rw [Walk.darts_copy] at hd
    have hmem : d ∈
        ((.nil : G.Walk (q.getVert ip) (q.getVert ip)).concat hadj).darts := by
      simpa [seg] using hd
    simpa [δq] using hmem
  have hsegEdgesOutside : ∀ ε ∈ segY.edges,
      ε ∉ Y.toWarp.edgeSet := by
    intro ε hε hεY
    rw [Walk.edges_eq_map_darts, List.mem_map] at hε
    rcases hε with ⟨d, hd, rfl⟩
    have hdEq := hsegDart d hd
    subst d
    rcases (Y.toWarp.mem_edgeSet_iff).mp hεY with
      ⟨d, hdY, hdEdge⟩
    rcases (dart_edge_eq_iff d δq).mp hdEdge with hEq | hEq
    · exact hδqExternal.1 (hEq.symm ▸ hdY)
    · exact hδqExternal.2 (by simpa [hEq] using hdY)
  have hXcont : ∀ v ∈ cont.support,
      v ∈ X.toWarp.vertexSet → v ∈ X.toWarp.terminalSet := by
    intro v hv hvX
    have hvCases : v = q.getVert ip ∨ v = y ∨ v = pred := by
      simpa [cont, segY, seg] using hv
    rcases hvCases with rfl | rfl | rfl
    · exact hRpre.1 (q.getVert ip) Rpre.end_mem_support hvX
    · exact (hiyNotU (left_vertexSet_subset_alternatingWarp hXY t
        (by simpa [y] using hvX))).elim
    · apply right_predecessor_mem_left_is_terminal hXY t e
      · simpa [Nat.sub_add_cancel (by omega : 1 ≤ ky)] using hkyY
      · simpa [Nat.sub_add_cancel (by omega : 1 ≤ ky), hyEq, y] using
          hiyNotU
      · exact hvX
  have hdartCont : ∀ d ∈ cont.darts,
      d.symm ∈ Y.toWarp.dartSet ∨
        (d ∉ Y.toWarp.dartSet ∧ d.symm ∉ Y.toWarp.dartSet) := by
    intro d hd
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert cont).mp hd with
      ⟨i, hi, hdPair⟩
    have hiLt : i < 2 := by simpa [hcontLength] using hi
    rcases Nat.eq_zero_or_pos i with rfl | hiPos
    · right
      have hdEq : d = δq := by
        apply Dart.ext
        calc
          d.toProd = (cont.getVert 0, cont.getVert 1) := hdPair
          _ = (q.getVert ip, q.getVert iy) := by
            rw [hgetZero, hgetOne, hyEq]
          _ = δq.toProd := rfl
      simpa [hdEq] using hδqExternal
    · have hiOne : i = 1 := by omega
      left
      change ∃ c : A, d.symm ∈ (Y.path c).1.dartSet
      refine ⟨e, ky - 1, ?_, ?_⟩
      · simpa [Nat.sub_add_cancel (by omega : 1 ≤ ky)] using hkyY
      · change d.toProd.swap = _
        calc
          d.toProd.swap =
              (cont.getVert (i + 1), cont.getVert i) := by
            rw [hdPair]
            simp
          _ = (pred, (Y.path e).1.vertex ky) := by
            rw [hiOne, hgetOne, hgetTwo]
          _ = _ := by simp [pred, Nat.sub_add_cancel (by omega : 1 ≤ ky)]
  have hrepeatCont : ∀ i j, i ≤ cont.length → j ≤ cont.length →
      i ≠ j → cont.getVert i = cont.getVert j →
      cont.getVert i ∈ Y.toWarp.vertexSet := by
    intro i j hi hj hij heq
    rw [hcontLength] at hi hj
    by_cases hiOne : i = 1
    · subst i
      rw [hgetOne]
      exact ⟨e, ky, hkyY, rfl⟩
    by_cases hjOne : j = 1
    · subst j
      have hyMem : cont.getVert 1 ∈ Y.toWarp.vertexSet := by
        rw [hgetOne]
        exact ⟨e, ky, hkyY, rfl⟩
      exact heq ▸ hyMem
    have hiCases : i = 0 ∨ i = 2 := by omega
    have hjCases : j = 0 ∨ j = 2 := by omega
    rcases hiCases with rfl | rfl <;> rcases hjCases with rfl | rfl
    · exact (hij rfl).elim
    · have heq' : q.getVert ip = pred := by
        calc
          q.getVert ip = cont.getVert 0 := hgetZero.symm
          _ = cont.getVert 2 := heq
          _ = pred := hgetTwo
      rw [hgetZero]
      exact heq' ▸ ⟨e, ky - 1, hkyPred, rfl⟩
    · rw [hgetTwo]
      exact ⟨e, ky - 1, hkyPred, rfl⟩
    · exact (hij rfl).elim
  have hcross : ∀ v ∈ Rpre.support, v ∈ cont.support.tail →
      v ∈ Y.toWarp.vertexSet := by
    intro v hvR hvTail
    have hvCases : v = y ∨ v = pred := by
      simpa [cont, segY, seg] using hvTail
    rcases hvCases with rfl | rfl
    · exfalso
      apply hiyNotU
      change ∃ c : A, y ∈ (alternatingPath hXY t c).vertexSet
      refine ⟨e, ?_⟩
      have hm := reachable_vertex_mem_alternatingPath hXY t e hkyY
        (⟨q.getVert ip, Rpre, hRpre, hyEq ▸ hvR⟩ :
          IsAlternatingReachable X Y t ((Y.path e).1.vertex ky))
      exact hyEq ▸ hm
    · exact ⟨e, ky - 1, hkyPred, rfl⟩
  have hedgesCont : cont.edges.Nodup := by
    have hsegYPath : segY.IsPath := by
      apply Walk.IsPath.mk'
      simpa [segY, seg] using hadj.ne
    rw [show cont = segY.concat hback by rfl, Walk.edges_concat,
      List.nodup_concat]
    exact ⟨fun hlast => hsegEdgesOutside _ hlast hfinalEdgeY,
      hsegYPath.isTrail.edges_nodup⟩
  have hedgesCross : Rpre.edges.Disjoint cont.edges := by
    rw [List.disjoint_left]
    intro ε hεR hεC
    rw [Walk.edges_eq_map_darts, List.mem_map] at hεR hεC
    rcases hεR with ⟨dR, hdR, hdREdge⟩
    rcases hεC with ⟨dC, hdC, hdCEdge⟩
    rcases (Erdos599.Walk.mem_darts_iff_exists_getVert cont).mp hdC with
      ⟨i, hi, hdCPair⟩
    have hiLt : i < 2 := by simpa [hcontLength] using hi
    have hdRFst := Rpre.dart_fst_mem_support_of_mem_darts hdR
    have hdRSnd := Rpre.dart_snd_mem_support_of_mem_darts hdR
    have hedge : dC.edge = dR.edge := hdCEdge.trans hdREdge.symm
    have hyR : y ∈ Rpre.support := by
      rcases Nat.eq_zero_or_pos i with rfl | hiPos
      · have hySnd : dC.snd = y := by
          calc
            dC.snd = cont.getVert 1 := congrArg Prod.snd hdCPair
            _ = y := by rw [hgetOne, hyEq]
        rw [← hySnd]
        rcases (dart_edge_eq_iff dC dR).mp hedge with hEq | hEq
        · rw [hEq]
          exact hdRSnd
        · rw [hEq]
          simpa using hdRFst
      · have hiOne : i = 1 := by omega
        have hyFst : dC.fst = y := by
          calc
            dC.fst = cont.getVert i := congrArg Prod.fst hdCPair
            _ = y := by rw [hiOne, hgetOne, hyEq]
        rw [← hyFst]
        rcases (dart_edge_eq_iff dC dR).mp hedge with hEq | hEq
        · rw [hEq]
          exact hdRFst
        · rw [hEq]
          simpa using hdRSnd
    apply hiyNotU
    change ∃ c : A, y ∈ (alternatingPath hXY t c).vertexSet
    refine ⟨e, ?_⟩
    have hm := reachable_vertex_mem_alternatingPath hXY t e hkyY
      (⟨q.getVert ip, Rpre, hRpre, hyEq ▸ hyR⟩ :
        IsAlternatingReachable X Y t ((Y.path e).1.vertex ky))
    exact hyEq ▸ hm
  have hincident : ∀ i, 0 < i → i ≤ cont.length →
      cont.getVert i ∈ Y.toWarp.vertexSet →
      s(cont.getVert (i - 1), cont.getVert i) ∈ Y.toWarp.edgeSet ∨
        (i < cont.length ∧
          s(cont.getVert i, cont.getVert (i + 1)) ∈ Y.toWarp.edgeSet) := by
    intro i hi0 hile _hiY
    rw [hcontLength] at hile
    by_cases hiOne : i = 1
    · right
      refine ⟨by rw [hcontLength]; omega, ?_⟩
      rw [hiOne, hgetOne, hgetTwo]
      exact hfinalEdgeY
    · have hiTwo : i = 2 := by omega
      left
      rw [hiTwo, show 2 - 1 = 1 by omega, hgetOne, hgetTwo]
      exact hfinalEdgeY
  have hAlt : X.IsAlternatingWalk Y (Rpre.append cont) := by
    apply hRpre.append_of_compatible cont hXcont hdartCont hrepeatCont
      hcross hedgesCont hedgesCross hincident
  apply hiyNotU
  change ∃ c : A, q.getVert iy ∈ (alternatingPath hXY t c).vertexSet
  refine ⟨e, ?_⟩
  have hySupport : (Y.path e).1.vertex ky ∈
      (Rpre.append cont).support := by
    rw [Walk.mem_support_append_iff]
    right
    rw [← hgetOne]
    exact cont.getVert_mem_support 1
  exact hkyEq ▸ reachable_vertex_mem_alternatingPath hXY t e hkyY
    (⟨pred, Rpre.append cont, hAlt, hySupport⟩ :
      IsAlternatingReachable X Y t ((Y.path e).1.vertex ky))

/-- The hard case of the one-point lifting argument supplies an ambient
alternating walk ending at the deleted vertex.  A first forbidden contact of
the counterpath with the exterior right warp would, by the preceding lemma,
belong to the alternating prefix, contradicting lastness.  The remaining
segment is therefore external and can be spliced after mapping both waves
back to the ambient graph. -/
theorem exists_ambient_alternatingWalk_to_deleted {V : Type}
    {G : SimpleGraph V} {A B : Set V} (X : TotalWave G A B)
    {x : V} (hx : x ∉ X.toWarp.vertexSet)
    (Y : TotalWave (outsideGraph G {x}) A (B \ {x}))
    (hXY : toOutsideVertex X x hx ≤ Y) {t : V}
    (htXo : t ∈ (toOutsideVertex X x hx).toWarp.terminalSet)
    {a b : V} (ha : a ∈ A) (hb : b ∈ B)
    (q : G.Walk a b) (hq : q.IsPath)
    (havoid : ∀ v ∈ q.support,
      v ∉ (alternatingTotalWave hXY t htXo).toWarp.terminalSet)
    (hxq : x ∈ q.support) :
    ∃ R : G.Walk t x,
      (mapLEToEmptyTarget (outsideGraph_le G {x})
        (toOutsideVertex X x hx)).IsAlternatingWalk
      (mapLEToEmptyTarget (outsideGraph_le G {x}) Y) R := by
  classical
  let Xo := toOutsideVertex X x hx
  let U := alternatingTotalWave hXY t htXo
  rcases exists_reachable_last_contact_before_deleted
      X hx Y hXY htXo ha hb q hq havoid hxq with
    ⟨iz, ix, hizix, hixle, hixx, hizU, hRexists, hizLast⟩
  rcases hRexists with ⟨Rz, hRz⟩
  have hizNotTerminal :
      q.getVert iz ∉ (alternatingWarp hXY t).terminalSet := by
    intro hzTerm
    apply havoid (q.getVert iz) (q.getVert_mem_support iz)
    rcases hzTerm with ⟨d, hd⟩
    refine ⟨d, ?_⟩
    change (U.path d).1.terminal? = some (q.getVert iz)
    change (alternatingPath hXY t d).normalize.terminal? =
      some (q.getVert iz)
    rw [LongPath.terminal?_normalize]
    simpa only [alternatingWarp, Warp.ofPaths] using hd
  have hxA : x ∉ A := by
    intro hxA
    apply hx
    apply X.toWarp.initialSet_subset_vertexSet
    rw [X.initialSet_toWarp]
    exact hxA
  have hxY : x ∉ Y.toWarp.vertexSet := by
    rintro ⟨c, hcx⟩
    change A at c
    have hinit : (Y.path c).1.initial ∉ ({x} : Set V) := by
      simpa [Y.path_initial c] using
        (show (c : V) ≠ x from fun hcx => hxA (hcx ▸ c.property))
    have hout := (Y.path c).1.vertex_not_mem_of_outsideGraph hinit hcx
    exact hout (Set.mem_singleton x)
  have hnoY : ∀ m, iz < m → m < ix →
      q.getVert m ∉ Y.toWarp.vertexSet := by
    intro m hizm hmix hmY
    let contactIndices : Set ℕ :=
      {n | iz < n ∧ n < ix ∧ q.getVert n ∈ Y.toWarp.vertexSet}
    have hmContact : m ∈ contactIndices := ⟨hizm, hmix, hmY⟩
    let iy := Nat.find (show ∃ n, n ∈ contactIndices from ⟨m, hmContact⟩)
    have hiyContact : iy ∈ contactIndices :=
      Nat.find_spec (show ∃ n, n ∈ contactIndices from ⟨m, hmContact⟩)
    have hiziy : iz < iy := hiyContact.1
    have hiyix : iy < ix := hiyContact.2.1
    have hiyY : q.getVert iy ∈ Y.toWarp.vertexSet := hiyContact.2.2
    have hbetween : ∀ j, iz < j → j < iy →
        q.getVert j ∉ Y.toWarp.vertexSet := by
      intro j hizj hjiy hjY
      have hjContact : j ∈ contactIndices :=
        ⟨hizj, hjiy.trans hiyix, hjY⟩
      have hiyj : iy ≤ j := Nat.find_min'
        (show ∃ n, n ∈ contactIndices from ⟨m, hmContact⟩) hjContact
      omega
    have hiyNotU :
        q.getVert iy ∉ (alternatingWarp hXY t).vertexSet :=
      hizLast iy (hiyix.le.trans hixle) hiziy
    let qp : LongPath G := LongPath.ofWalk q hq
    have hiyActive : longPathActive qp.terminalIndex iy := by
      simp [qp, LongPath.ofWalk, longPathActive,
        hiyix.le.trans hixle]
    let seg : G.Walk (q.getVert iz) (q.getVert iy) :=
      (qp.segmentWalk hiyActive hiziy.le).copy rfl rfl
    have hsegLength : seg.length = iy - iz := by
      change ((qp.segmentWalk hiyActive hiziy.le).copy rfl rfl).length = _
      simpa only [Walk.length_copy] using
        qp.length_segmentWalk hiyActive hiziy.le
    have hsegGet (j : ℕ) (hj : j ≤ iy - iz) :
        seg.getVert j = q.getVert (iz + j) := by
      change ((qp.segmentWalk hiyActive hiziy.le).copy rfl rfl).getVert j = _
      rw [Walk.getVert_copy,
        qp.getVert_segmentWalk hiyActive hiziy.le hj]
      rfl
    have hsegPath : seg.IsPath := by
      apply Walk.IsPath.mk'
      change ((qp.segmentWalk hiyActive hiziy.le).copy rfl rfl).support.Nodup
      rw [Walk.support_copy]
      exact (qp.segmentWalk_isPath hiyActive hiziy.le).support_nodup
    have hsegOutside : ∀ v ∈ seg.support, v ∉ ({x} : Set V) := by
      intro v hv hvx
      change v = x at hvx
      have hv' : v ∈ (qp.segmentWalk hiyActive hiziy.le).support := by
        change v ∈ ((qp.segmentWalk hiyActive hiziy.le).copy rfl rfl).support
          at hv
        rw [Walk.support_copy] at hv
        exact hv
      rcases (qp.mem_support_segmentWalk_iff hiyActive hiziy.le).mp hv' with
        ⟨j, hizj, hjiy, hjv⟩
      have hjle : j ≤ q.length := hjiy.trans (hiyix.le.trans hixle)
      have hjeq : j = ix := hq.getVert_injOn hjle hixle <| by
        calc
          q.getVert j = v := hjv
          _ = x := hvx
          _ = q.getVert ix := hixx.symm
      omega
    let segE : (outsideGraph G {x}).Walk
        (q.getVert iz) (q.getVert iy) :=
      Erdos599.Walk.toOutsideGraph seg hsegOutside
    have hsegEPath : segE.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hsegPath hsegOutside
    have hsegELength : segE.length = iy - iz := by
      simpa [segE] using hsegLength
    have hsegEGet (j : ℕ) (hj : j ≤ iy - iz) :
        segE.getVert j = q.getVert (iz + j) := by
      simpa [segE] using hsegGet j hj
    have hsegEZero : segE.getVert 0 = q.getVert iz := by
      rw [hsegEGet 0 (by omega)]
      congr 1
    let Rzero : (outsideGraph G {x}).Walk t (segE.getVert 0) :=
      Rz.copy rfl hsegEZero.symm
    have hRzero : (toOutsideVertex X x hx).IsAlternatingWalk Y Rzero :=
      hRz.copy rfl hsegEZero.symm
    have hizUzero : segE.getVert 0 ∈
        (alternatingWarp hXY t).vertexSet := hsegEZero.symm ▸ hizU
    have hizNotTerminalZero : segE.getVert 0 ∉
        (alternatingWarp hXY t).terminalSet := by
      simpa [hsegEZero] using hizNotTerminal
    have hcontact := first_right_contact_after_reachable_mem_alternatingWarp
      hXY segE hsegEPath (iz := 0) (iy := iy - iz)
      (by omega) (by rw [hsegELength]) hizUzero hizNotTerminalZero
      (R := Rzero) hRzero
      (by
        intro j hj0 hjlt hjY
        have hjPos : 0 < j := hj0
        have hindex : iz < iz + j := by omega
        have hbefore : iz + j < iy := by omega
        apply hbetween (iz + j) hindex hbefore
        simpa [hsegEGet j (by omega)] using hjY)
      (by
        have hend : segE.getVert (iy - iz) = q.getVert iy := by
          rw [hsegEGet (iy - iz) le_rfl]
          congr 1
          omega
        exact hend.symm ▸ hiyY)
    apply hiyNotU
    have hend : segE.getVert (iy - iz) = q.getVert iy := by
      rw [hsegEGet (iy - iz) le_rfl]
      congr 1
      omega
    exact hend ▸ hcontact
  let Xa := mapLEToEmptyTarget (outsideGraph_le G {x}) Xo
  let Ya := mapLEToEmptyTarget (outsideGraph_le G {x}) Y
  have hXYa : Xa ≤ Ya := by
    intro c n hn
    exact hXY c n hn
  have hRza : Xa.IsAlternatingWalk Ya
      (Rz.mapLe (outsideGraph_le G {x})) := by
    simpa [Xa, Ya, Xo] using
      hRz.mapLEToEmptyTarget (outsideGraph_le G {x})
  have havoidYa : ∀ m, iz < m → m ≤ ix →
      q.getVert m ∉ Ya.toWarp.vertexSet := by
    intro m hizm hmix hmYa
    have hmY : q.getVert m ∈ Y.toWarp.vertexSet := by
      simpa [Ya] using hmYa
    rcases Nat.lt_or_eq_of_le hmix with hmLt | rfl
    · exact hnoY m hizm hmLt hmY
    · exact hxY (hixx ▸ hmY)
  rcases hRza.exists_extend_along_path_avoiding_right
      hXYa hq hizix hixle havoidYa with ⟨S, hS⟩
  refine ⟨S.copy rfl hixx, ?_⟩
  exact hS.copy rfl hixx

/-- Normalize the source-rooted components produced by switching.  If the
terminal exchange set separates the ambient web, the result is a total wave
extending the left wave and having exactly that terminal set. -/
theorem exists_totalWave_of_alternatingWalk {V : Type}
    {G : SimpleGraph V} {A B C : Set V} {X Y : TotalWave G A C}
    (hXY : X ≤ Y) (a₀ : A) {t z : V}
    (htX : (X.path a₀).1.terminal? = some t)
    (htY : (Y.path a₀).1.terminal? = some t)
    {R : G.Walk t z} (hR : X.IsAlternatingWalk Y R)
    (hsep : Separates G A B ((Y.toWarp.terminalSet \ {t}) ∪ {z})) :
    ∃ Z : TotalWave G A B,
      (∀ c, (X.path c).1.Forward (Z.path c).1) ∧
      Z.toWarp.terminalSet = (Y.toWarp.terminalSet \ {t}) ∪ {z} := by
  classical
  have hswitch := alternatingWalk_switching hXY a₀ htX htY hR
  let W := switchedWarp hR ⟨a₀, htY⟩
  have hWsep : Separates G A B W.terminalSet := by
    rw [hswitch.2]
    exact hsep
  let Z : TotalWave G A B := {
    path := fun c => LongPath.toNormalized (W.path c)
    baseForward := by
      intro c
      exact (X.baseForward c).trans
        ((hswitch.1 c).trans (LongPath.forward_normalize (W.path c)))
    disjoint := by
      intro c d hcd
      simpa [LongPath.toNormalized] using W.disjoint hcd
    isWave := by
      constructor
      · rintro v ⟨c, rfl⟩
        change (W.path c).normalize.initial ∈ A
        rw [LongPath.initial_normalize]
        have hc : (W.path c).initial ∈ W.initialSet := ⟨c, rfl⟩
        have hinitial : W.initialSet = A := by
          simpa [W] using switchedWarp_initialSet hR ⟨a₀, htY⟩
        rw [hinitial] at hc
        exact hc
      · intro a ha b hb q hq
        rcases hWsep a ha b hb q hq with ⟨v, hvq, c, hc⟩
        refine ⟨v, hvq, c, ?_⟩
        change (W.path c).normalize.terminal? = some v
        simpa using hc }
  refine ⟨Z, ?_, ?_⟩
  · intro c
    exact (hswitch.1 c).trans (LongPath.forward_normalize (W.path c))
  · calc
      Z.toWarp.terminalSet = W.terminalSet := by
        ext v
        change (∃ c : A, (W.path c).normalize.terminal? = some v) ↔
          ∃ c : A, (W.path c).terminal? = some v
        constructor <;> rintro ⟨c, hc⟩ <;> refine ⟨c, ?_⟩
        · simpa [LongPath.terminal?_normalize] using hc
        · simpa [LongPath.terminal?_normalize] using hc
      _ = (Y.toWarp.terminalSet \ {t}) ∪ {z} := hswitch.2

/-- A total wave has no bad extensions if every forward wave extension is
good. -/
def HasNoBadExtensions {V : Type} {G : SimpleGraph V} {A B : Set V}
    (X : TotalWave G A B) : Prop :=
  ∀ Y : TotalWave G A B, X ≤ Y →
    X.essentialSources ⊆ Y.essentialSources

/-- Essential sources are antitone under forward extension.  The old
component is a finite prefix of the new essential component.  Its terminal
is joined to the new terminal by the remaining suffix, after which the new
component's whole-warp avoidance path is followed. -/
theorem essentialSources_antitone {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} (hXY : X ≤ Y) :
    Y.essentialSources ⊆ X.essentialSources := by
  classical
  intro a ha
  rcases ha with ⟨t, hYt, htEssential⟩
  have hYStrong : Y.toWarp.IsEssentialPath B a :=
    (Y.isWave.isEssentialPath_iff_terminal_essential hYt).mpr htEssential
  rcases hYStrong with ⟨u, hYu, b, hb, q, hq, hqOnlyY⟩
  have hut : u = t := Option.some.inj (hYu.symm.trans hYt)
  subst u
  rcases (hXY a).exists_terminal_of_terminal hYt with ⟨x, hXx⟩
  rcases LongPath.terminal?_eq_some_iff.mp hXx with
    ⟨k, hkFinite, hkx⟩
  have hkX : longPathActive (X.path a).1.terminalIndex k := by
    simp [hkFinite, longPathActive]
  have hkY : longPathActive (Y.path a).1.terminalIndex k :=
    (hXY a k hkX).1
  let suffix : LongPath G := (Y.path a).1.tail k hkY
  have hsuffixTerminal : suffix.terminal? = some t := by
    exact (LongPath.terminal?_tail (Y.path a).1 k hkY).trans hYt
  rcases LongPath.terminal?_eq_some_iff.mp hsuffixTerminal with
    ⟨d, hdFinite, hdt⟩
  have hdActive : longPathActive suffix.terminalIndex d := by
    simp [hdFinite, longPathActive]
  have hsuffixInitial : suffix.initial = x := by
    calc
      suffix.initial = (Y.path a).1.vertex k := by simp [suffix]
      _ = (X.path a).1.vertex k := (hXY a k hkX).2
      _ = x := hkx
  let seg : G.Walk x t :=
    (suffix.prefixWalk d hdActive).copy hsuffixInitial hdt
  have hsegSubset :
      ∀ z ∈ seg.support, z ∈ suffix.vertexSet := by
    intro z hz
    have hz' : z ∈ (suffix.prefixWalk d hdActive).support := by
      simpa [seg] using hz
    rcases (suffix.mem_support_prefixWalk_iff hdActive).mp hz' with
      ⟨m, hmd, hmz⟩
    exact ⟨m, LongPath.active_mono hmd hdActive, hmz⟩
  let combined : G.Walk x b := seg.append q
  let r : G.Path x b := combined.toPath
  have htailIntersection :=
    WaveExtension.tail_intersection_toWarp_eq hXY a hkFinite hkx hkY
  have hrOnlyX : ∀ z ∈ (r : G.Walk x b).support,
      z ∈ X.toWarp.vertexSet → z = x := by
    intro z hzr hzX
    have hzCombined : z ∈ combined.support :=
      combined.support_toPath_subset_support hzr
    rw [show combined = seg.append q by rfl,
      seg.support_append_eq_support_dropLast_append q] at hzCombined
    rcases List.mem_append.mp hzCombined with hzSegDrop | hzq
    · have hzSeg : z ∈ seg.support := List.mem_of_mem_dropLast hzSegDrop
      exact htailIntersection z (hsegSubset z hzSeg) hzX
    · have hzY : z ∈ Y.toWarp.vertexSet :=
        WaveExtension.vertexSet_subset_of_le hXY hzX
      have hzt : z = t := hqOnlyY z hzq hzY
      have htSuffix : t ∈ suffix.vertexSet :=
        LongPath.terminal_mem_vertexSet hsuffixTerminal
      have htX : t ∈ X.toWarp.vertexSet := hzt ▸ hzX
      exact hzt.trans (htailIntersection t htSuffix htX)
  have hXStrong : X.toWarp.IsEssentialPath B a :=
    ⟨x, hXx, b, hb, (r : G.Walk x b), r.property, hrOnlyX⟩
  have hxEssential : x ∈ essentialVertices G B X.toWarp.terminalSet :=
    (X.isWave.isEssentialPath_iff_terminal_essential hXx).mp hXStrong
  exact ⟨x, hXx, hxEssential⟩

theorem isGoodExtension_iff {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X Y : TotalWave G A B} :
    X.IsGoodExtension Y ↔
      X ≤ Y ∧ X.essentialSources = Y.essentialSources := by
  constructor
  · rintro ⟨hXY, hforward⟩
    exact ⟨hXY, Set.Subset.antisymm hforward
      (essentialSources_antitone hXY)⟩
  · rintro ⟨hXY, heq⟩
    exact ⟨hXY, by rw [heq]⟩

theorem hasNoBadExtensions_iff {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X : TotalWave G A B} :
    X.HasNoBadExtensions ↔
      ∀ Y : TotalWave G A B, X ≤ Y →
        X.essentialSources = Y.essentialSources := by
  constructor
  · intro h Y hXY
    exact Set.Subset.antisymm (h Y hXY)
      (essentialSources_antitone hXY)
  · intro h Y hXY
    rw [h Y hXY]

theorem hasNoBadExtensions_of_isMax {V : Type} {G : SimpleGraph V}
    {A B : Set V} {X : TotalWave G A B} (hX : IsMax X) :
    X.HasNoBadExtensions := by
  intro Y hXY
  have hYX : Y ≤ X := hX hXY
  have hEq : X = Y := le_antisymm hXY hYX
  subst Y
  exact Set.Subset.rfl

end TotalWave

/-- Unhinderedness forces the directed-web trimming convention: otherwise,
deleting one source from the trivial wave gives a clean hindrance. -/
theorem IsCleanUnhindered.isTrimmedWeb {V : Type} {G : SimpleGraph V}
    {A B : Set V} (h : IsCleanUnhindered G A B) :
    IsTrimmedWeb G A B := by
  classical
  intro a ha
  by_contra hno
  let T : Set V := A \ {a}
  let W : Warp G := trivial G T
  have hWStarting : W.IsStarting A := by
    rw [IsStarting]
    simp only [W, initialSet_trivial]
    exact Set.diff_subset
  have hWSeparates : Separates G A B W.terminalSet := by
    simp only [W, terminalSet_trivial]
    intro x hx b hb q hq
    by_cases hxa : x = a
    · subst x
      have hnotClean : ¬ ∀ y ∈ q.support, y ∈ A → y = a := by
        intro hclean
        exact hno ⟨b, hb, q, hq, hclean⟩
      push Not at hnotClean
      rcases hnotClean with ⟨y, hyq, hyA, hya⟩
      exact ⟨y, hyq, hyA, by simpa [T, Set.mem_singleton_iff] using hya⟩
    · exact ⟨x, q.start_mem_support, hx, by simpa [T] using hxa⟩
  have hWClean : W.IsSourceClean A := by
    intro i v hv _
    simpa [W, trivial, LongPath.vertexSet_ofWalk] using hv
  have haInitial : a ∈ W.initialSet := h W ⟨hWStarting, hWSeparates⟩ hWClean ha
  simpa [W, T] using haInitial

theorem not_hindrance_of_unhindered {V : Type} {G : SimpleGraph V}
    {A B : Set V} (h : IsUnhindered G A B) (W : Warp G) :
    ¬ W.IsHindrance A B := by
  intro hW
  exact hW.2 (h W hW.1)

/-- Aharoni--Berger Lemma 3.7 (the self-roofing lemma): every vertex on a
wave is separated from `B` by the finite terminal vertices of that wave.
The finite prefix through a proposed escaping vertex, followed by an
escaping path, would contradict the wave separator. -/
theorem IsWave.vertexSet_subset_roof {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B) :
    W.vertexSet ⊆ roof G B W.terminalSet := by
  classical
  rintro x ⟨i, n, hn, hvx⟩
  subst x
  by_contra hnotRoof
  simp only [roof, Set.mem_ofPred_eq] at hnotRoof
  push Not at hnotRoof
  rcases hnotRoof with ⟨b, hb, q, hq, hqAvoid⟩
  let pref := (W.path i).prefixWalk n hn
  let combined : G.Walk (W.path i).initial b := pref.append q
  let combinedPath : G.Path (W.path i).initial b := combined.toPath
  have hstartA : (W.path i).initial ∈ A := hW.1 ⟨i, rfl⟩
  rcases hW.2 (W.path i).initial hstartA b hb
      (combinedPath : G.Walk (W.path i).initial b) combinedPath.property with
    ⟨y, hyCombinedPath, hyTerminal⟩
  have hyCombined : y ∈ combined.support :=
    combined.support_toPath_subset_support hyCombinedPath
  rw [show combined = pref.append q by rfl,
    pref.support_append_eq_support_dropLast_append q] at hyCombined
  rcases List.mem_append.mp hyCombined with hyPrefixDrop | hyq
  · have hyPrefix : y ∈ pref.support := List.mem_of_mem_dropLast hyPrefixDrop
    rcases hyTerminal with ⟨j, hjTerminal⟩
    by_cases hij : i = j
    · subst j
      cases hk : (W.path i).terminalIndex with
      | none => simp [LongPath.terminal?, hk] at hjTerminal
      | some k =>
          have hkActive : longPathActive (W.path i).terminalIndex k := by
            simp [longPathActive, hk]
          have hvertexK : (W.path i).vertex k = y := by
            simpa [LongPath.terminal?, hk] using hjTerminal
          rcases ((W.path i).mem_support_prefixWalk_iff hn).mp hyPrefix with
            ⟨m, hmn, hvertexM⟩
          have hmActive : longPathActive (W.path i).terminalIndex m :=
            LongPath.active_mono hmn hn
          have hmk : m = k := (W.path i).injective hmActive hkActive
            (hvertexM.trans hvertexK.symm)
          have hnk : n = k := by
            have : n ≤ k := by simpa [longPathActive, hk] using hn
            omega
          have hyEnd : y = (W.path i).vertex n := by
            rw [hnk, hvertexK]
          have hendNotDrop : (W.path i).vertex n ∉ pref.support.dropLast := by
            have hnodup := ((W.path i).prefixWalk_isPath hn).support_nodup
            have hnodupAppend :
                (pref.support.dropLast ++ [(W.path i).vertex n]).Nodup := by
              rw [pref.dropLast_support_concat]
              exact hnodup
            exact List.disjoint_singleton.mp hnodupAppend.disjoint
          exact hendNotDrop (hyEnd ▸ hyPrefixDrop)
    · have hyPathJ : y ∈ (W.path j).vertexSet :=
        LongPath.terminal_mem_vertexSet hjTerminal
      have hyPathI : y ∈ (W.path i).vertexSet := by
        rcases ((W.path i).mem_support_prefixWalk_iff hn).mp hyPrefix with
          ⟨m, hm, hmy⟩
        exact ⟨m, LongPath.active_mono hm hn, hmy⟩
      exact Set.disjoint_left.mp (W.disjoint hij) hyPathI hyPathJ
  · exact hqAvoid y hyq hyTerminal

/-- A wave in the quotient by `Z`, regarded in the original graph, is
self-roofing there (Aharoni--Berger Corollary 3.10).  An ambient escape path
which enters the deleted strict roof has a last `Z`-roof vertex; that vertex
is exposed, hence is a quotient source, and its exterior suffix is separated
by the quotient wave. -/
theorem IsWave.mapLE_isSelfRoofing_of_quotient
    {V : Type} {G : SimpleGraph V} {A B Z : Set V}
    {W : Warp (outsideGraph G (interiorRoof G B Z))}
    (hW : W.IsWave (quotientSource G A B Z) B) :
    (W.mapLE (outsideGraph_le G (interiorRoof G B Z))).IsSelfRoofing B := by
  classical
  intro x hx b hb q hq
  change x ∈ W.vertexSet at hx
  by_cases hmeet : ∃ z ∈ q.support, z ∈ roof G B Z
  · rcases exists_last_roof_index q hmeet with
      ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
    let z := q.getVert n
    have hzEssential : z ∈ essentialVertices G B Z := by
      rcases hnBoundary with hzEssential | hnEnd
      · simpa [z] using hzEssential
      · have hzb : z = b := by simpa [z, hnEnd]
        have hbOutside : b ∉ interiorRoof G B Z := by
          intro hbInterior
          exact Set.disjoint_left.mp (target_disjoint_interiorRoof G B Z)
            hb hbInterior
        change z ∈ roof G B Z at hnRoof
        rw [hzb] at hnRoof ⊢
        by_contra hbNotEssential
        exact hbOutside ⟨hnRoof, hbNotEssential⟩
    have hsuffixOutside :
        ∀ y ∈ (q.drop n).support, y ∉ interiorRoof G B Z := by
      intro y hy
      rcases Walk.mem_support_iff_exists_getVert.mp hy with ⟨m, hym, hmle⟩
      have hnmle : n + m ≤ q.length := by
        rw [Walk.drop_length] at hmle
        omega
      have hyGet : q.getVert (n + m) = y := by
        rw [← q.drop_getVert n m]
        exact hym
      by_cases hm0 : m = 0
      · subst m
        have hyz : y = z := by simpa [z] using hyGet.symm
        rw [hyz]
        intro hzInterior
        exact Set.disjoint_left.mp (interiorRoof_disjoint G B Z)
          hzInterior hzEssential
      · have hnotRoof : q.getVert (n + m) ∉ roof G B Z :=
          hnlast (n + m) hnmle (by omega)
        rw [hyGet] at hnotRoof
        intro hyInterior
        exact hnotRoof hyInterior.1
    let r := Erdos599.Walk.toOutsideGraph (q.drop n) hsuffixOutside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph (hq.drop n) hsuffixOutside
    have hzSource : z ∈ quotientSource G A B Z := by
      rw [quotientSource_eq]
      exact Or.inr hzEssential
    rcases hW.2 z hzSource b hb r hrPath with ⟨t, htr, htTerminal⟩
    have htq : t ∈ q.support := by
      have htdrop : t ∈ (q.drop n).support := by
        simpa [r] using htr
      exact (q.isSubwalk_drop n).support_subset htdrop
    exact ⟨t, htq, by simpa using htTerminal⟩
  · have houtside : ∀ z ∈ q.support, z ∉ interiorRoof G B Z := by
      intro z hzq hzInterior
      exact hmeet ⟨z, hzq, hzInterior.1⟩
    let r := Erdos599.Walk.toOutsideGraph q houtside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq houtside
    rcases hW.vertexSet_subset_roof hx b hb r hrPath with
      ⟨t, htr, htTerminal⟩
    exact ⟨t, by simpa [r] using htr, by simpa using htTerminal⟩

/-- The terminal set of a quotient wave separates the original source side
from the target side after the quotient warp is regarded in the ambient
graph.  This is the separator half of the quotient calculus used in
Aharoni--Berger Lemma 3.15. -/
theorem IsWave.separates_terminalSet_mapLE_of_quotient
    {V : Type} {G : SimpleGraph V} {A B Z : Set V}
    {W : Warp (outsideGraph G (interiorRoof G B Z))}
    (hW : W.IsWave (quotientSource G A B Z) B) :
    Separates G A B
      (W.mapLE (outsideGraph_le G (interiorRoof G B Z))).terminalSet := by
  classical
  intro a ha b hb q hq
  by_cases hmeet : ∃ z ∈ q.support, z ∈ roof G B Z
  · rcases exists_last_roof_index q hmeet with
      ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
    let z := q.getVert n
    have hzEssential : z ∈ essentialVertices G B Z := by
      rcases hnBoundary with hzEssential | hnEnd
      · simpa [z] using hzEssential
      · have hzb : z = b := by simpa [z, hnEnd]
        have hbOutside : b ∉ interiorRoof G B Z := by
          intro hbInterior
          exact Set.disjoint_left.mp (target_disjoint_interiorRoof G B Z)
            hb hbInterior
        change z ∈ roof G B Z at hnRoof
        rw [hzb] at hnRoof ⊢
        by_contra hbNotEssential
        exact hbOutside ⟨hnRoof, hbNotEssential⟩
    have hsuffixOutside :
        ∀ y ∈ (q.drop n).support, y ∉ interiorRoof G B Z := by
      intro y hy
      rcases Walk.mem_support_iff_exists_getVert.mp hy with ⟨m, hym, hmle⟩
      have hnmle : n + m ≤ q.length := by
        rw [Walk.drop_length] at hmle
        omega
      have hyGet : q.getVert (n + m) = y := by
        rw [← q.drop_getVert n m]
        exact hym
      by_cases hm0 : m = 0
      · subst m
        have hyz : y = z := by simpa [z] using hyGet.symm
        rw [hyz]
        intro hzInterior
        exact Set.disjoint_left.mp (interiorRoof_disjoint G B Z)
          hzInterior hzEssential
      · have hnotRoof : q.getVert (n + m) ∉ roof G B Z :=
          hnlast (n + m) hnmle (by omega)
        rw [hyGet] at hnotRoof
        intro hyInterior
        exact hnotRoof hyInterior.1
    let r := Erdos599.Walk.toOutsideGraph (q.drop n) hsuffixOutside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph (hq.drop n) hsuffixOutside
    have hzSource : z ∈ quotientSource G A B Z := by
      rw [quotientSource_eq]
      exact Or.inr hzEssential
    rcases hW.2 z hzSource b hb r hrPath with ⟨t, htr, htTerminal⟩
    have htq : t ∈ q.support := by
      have htdrop : t ∈ (q.drop n).support := by
        simpa [r] using htr
      exact (q.isSubwalk_drop n).support_subset htdrop
    exact ⟨t, htq, by simpa using htTerminal⟩
  · have houtside : ∀ z ∈ q.support, z ∉ interiorRoof G B Z := by
      intro z hzq hzInterior
      exact hmeet ⟨z, hzq, hzInterior.1⟩
    let r := Erdos599.Walk.toOutsideGraph q houtside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq houtside
    have haSource : a ∈ quotientSource G A B Z := by
      refine ⟨Or.inl ha, ?_⟩
      intro haInterior
      exact hmeet ⟨a, q.start_mem_support, haInterior.1⟩
    rcases hW.2 a haSource b hb r hrPath with ⟨t, htr, htTerminal⟩
    exact ⟨t, by simpa [r] using htr, by simpa using htTerminal⟩

/-- Quotient lifting after an additional real deletion.  A source of the
undeleted web, or a vertex of the quotient wave, is roofed in `G - Q` by the
ambient image of that wave.  This is the common path argument behind the
self-roofing and separator hypotheses in the Section 6 application of
Aharoni--Berger Lemma 3.15. -/
theorem IsWave.mem_roof_mapLE_of_quotient_delete
    {V : Type} {G : SimpleGraph V} {A B Z Q : Set V}
    {W : Warp (outsideGraph
      (outsideGraph G (interiorRoof G B Z)) Q)}
    (hW : W.IsWave ((quotientSource G A B Z) \ Q) (B \ Q))
    {x : V} (hx : x ∈ (A ∪ roof G B Z) \ Q ∨
      x ∈ W.vertexSet ∨
      (x ∈ roof (outsideGraph
        (outsideGraph G (interiorRoof G B Z)) Q) (B \ Q) W.terminalSet ∧
        x ∉ Q)) :
    x ∈ roof (outsideGraph G Q) (B \ Q)
      (W.mapLE (outsideGraph_mono
        (outsideGraph_le G (interiorRoof G B Z)) Q)).terminalSet := by
  classical
  have hxQ : x ∉ Q := by
    rcases hx with hxA | hxW
    · exact hxA.2
    · rcases hxW with hxW | hxRoof
      · rcases hxW with ⟨i, hxi⟩
        have hiSource := hW.1 ⟨i, rfl⟩
        exact (W.path i).vertex_not_mem_of_outsideGraph hiSource.2 hxi
      · exact hxRoof.2
  intro b hb q hq
  let qG := q.mapLe (outsideGraph_le G Q)
  have hqG : qG.IsPath := hq.mapLe _
  by_cases hmeet : ∃ z ∈ qG.support, z ∈ roof G B Z
  · rcases exists_last_roof_index qG hmeet with
      ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
    let z := qG.getVert n
    have hzEssential : z ∈ essentialVertices G B Z := by
      rcases hnBoundary with hzEssential | hnEnd
      · simpa [z] using hzEssential
      · have hzb : z = b := by simpa [z, hnEnd]
        have hbOutside : b ∉ interiorRoof G B Z := by
          intro hbInterior
          exact Set.disjoint_left.mp (target_disjoint_interiorRoof G B Z)
            hb.1 hbInterior
        change z ∈ roof G B Z at hnRoof
        rw [hzb] at hnRoof ⊢
        by_contra hbNotEssential
        exact hbOutside ⟨hnRoof, hbNotEssential⟩
    have hsuffixOutside :
        ∀ y ∈ (qG.drop n).support, y ∉ interiorRoof G B Z := by
      intro y hy
      rcases Walk.mem_support_iff_exists_getVert.mp hy with ⟨m, hym, hmle⟩
      have hnmle : n + m ≤ qG.length := by
        rw [Walk.drop_length] at hmle
        omega
      have hyGet : qG.getVert (n + m) = y := by
        rw [← qG.drop_getVert n m]
        exact hym
      by_cases hm0 : m = 0
      · subst m
        have hyz : y = z := by simpa [z] using hyGet.symm
        rw [hyz]
        intro hzInterior
        exact Set.disjoint_left.mp (interiorRoof_disjoint G B Z)
          hzInterior hzEssential
      · have hnotRoof : qG.getVert (n + m) ∉ roof G B Z :=
          hnlast (n + m) hnmle (by omega)
        rw [hyGet] at hnotRoof
        exact fun hyInterior => hnotRoof hyInterior.1
    let r₀ := Erdos599.Walk.toOutsideGraph (qG.drop n) hsuffixOutside
    have hr₀Path : r₀.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph (hqG.drop n) hsuffixOutside
    have hr₀OutsideQ : ∀ y ∈ r₀.support, y ∉ Q := by
      intro y hyr
      have hyDrop : y ∈ (qG.drop n).support := by
        simpa [r₀] using hyr
      have hyqG : y ∈ qG.support :=
        (qG.isSubwalk_drop n).support_subset hyDrop
      have hyq : y ∈ q.support := by
        simpa [qG, Walk.support_mapLe_eq_support] using hyqG
      exact Erdos599.Walk.vertex_not_mem_of_outsideGraph q hxQ hyq
    let r := Erdos599.Walk.toOutsideGraph r₀ hr₀OutsideQ
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hr₀Path hr₀OutsideQ
    have hzSource : z ∈ quotientSource G A B Z := by
      rw [quotientSource_eq]
      exact Or.inr hzEssential
    have hzqG : z ∈ qG.support := qG.getVert_mem_support n
    have hzq : z ∈ q.support := by
      simpa [qG, Walk.support_mapLe_eq_support] using hzqG
    have hzQ : z ∉ Q :=
      Erdos599.Walk.vertex_not_mem_of_outsideGraph q hxQ hzq
    rcases hW.2 z ⟨hzSource, hzQ⟩ b hb r hrPath with
      ⟨t, htr, htTerminal⟩
    have htDrop : t ∈ (qG.drop n).support := by
      simpa [r, r₀] using htr
    have htqG : t ∈ qG.support :=
      (qG.isSubwalk_drop n).support_subset htDrop
    exact ⟨t, by simpa [qG, Walk.support_mapLe_eq_support] using htqG,
      by simpa using htTerminal⟩
  · have houtside : ∀ z ∈ qG.support, z ∉ interiorRoof G B Z := by
      intro z hzq hzInterior
      exact hmeet ⟨z, hzq, hzInterior.1⟩
    let r₀ := Erdos599.Walk.toOutsideGraph qG houtside
    have hr₀Path : r₀.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hqG houtside
    have hr₀OutsideQ : ∀ y ∈ r₀.support, y ∉ Q := by
      intro y hyr
      have hyqG : y ∈ qG.support := by simpa [r₀] using hyr
      have hyq : y ∈ q.support := by
        simpa [qG, Walk.support_mapLe_eq_support] using hyqG
      exact Erdos599.Walk.vertex_not_mem_of_outsideGraph q hxQ hyq
    let r := Erdos599.Walk.toOutsideGraph r₀ hr₀OutsideQ
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hr₀Path hr₀OutsideQ
    rcases hx with hxA | hxW
    · have hxNotQ := hxA.2
      rcases hxA.1 with hxA | hxRoof
      · have hxSource : x ∈ (quotientSource G A B Z) \ Q := by
          refine ⟨⟨Or.inl hxA, ?_⟩, hxNotQ⟩
          intro hxInterior
          exact hmeet ⟨x, qG.start_mem_support, hxInterior.1⟩
        rcases hW.2 x hxSource b hb r hrPath with
          ⟨t, htr, htTerminal⟩
        exact ⟨t, by simpa [r, r₀, qG] using htr,
          by simpa using htTerminal⟩
      · exact (hmeet ⟨x, qG.start_mem_support, hxRoof⟩).elim
    · rcases hxW with hxW | hxRoof
      · rcases hW.vertexSet_subset_roof hxW b hb r hrPath with
          ⟨t, htr, htTerminal⟩
        exact ⟨t, by simpa [r, r₀, qG] using htr,
          by simpa using htTerminal⟩
      · rcases hxRoof.1 b hb r hrPath with ⟨t, htr, htTerminal⟩
        exact ⟨t, by simpa [r, r₀, qG] using htr,
          by simpa using htTerminal⟩

theorem IsWave.mapLE_isSelfRoofing_of_quotient_delete
    {V : Type} {G : SimpleGraph V} {A B Z Q : Set V}
    {W : Warp (outsideGraph
      (outsideGraph G (interiorRoof G B Z)) Q)}
    (hW : W.IsWave ((quotientSource G A B Z) \ Q) (B \ Q)) :
    (W.mapLE (outsideGraph_mono
      (outsideGraph_le G (interiorRoof G B Z)) Q)).IsSelfRoofing (B \ Q) := by
  intro x hx
  exact hW.mem_roof_mapLE_of_quotient_delete (Or.inr (Or.inl hx))

theorem IsWave.separates_terminalSet_mapLE_of_quotient_delete
    {V : Type} {G : SimpleGraph V} {A B Z Q : Set V}
    {W : Warp (outsideGraph
      (outsideGraph G (interiorRoof G B Z)) Q)}
    (hW : W.IsWave ((quotientSource G A B Z) \ Q) (B \ Q)) :
    Separates (outsideGraph G Q) (A \ Q) (B \ Q)
      (W.mapLE (outsideGraph_mono
        (outsideGraph_le G (interiorRoof G B Z)) Q)).terminalSet := by
  rw [separates_iff_subset_roof]
  intro x hx
  exact hW.mem_roof_mapLE_of_quotient_delete
    (Or.inl ⟨Or.inl hx.1, hx.2⟩)

theorem IsWave.roof_quotientSet_subset_mapLE_of_quotient_delete
    {V : Type} {G : SimpleGraph V} {A B Z Q : Set V}
    {W : Warp (outsideGraph
      (outsideGraph G (interiorRoof G B Z)) Q)}
    (hW : W.IsWave ((quotientSource G A B Z) \ Q) (B \ Q)) :
    roof G B Z \ Q ⊆ roof (outsideGraph G Q) (B \ Q)
      (W.mapLE (outsideGraph_mono
        (outsideGraph_le G (interiorRoof G B Z)) Q)).terminalSet := by
  intro x hx
  exact hW.mem_roof_mapLE_of_quotient_delete
    (Or.inl ⟨Or.inr hx.1, hx.2⟩)

theorem IsWave.roof_small_subset_mapLE_of_quotient_delete
    {V : Type} {G : SimpleGraph V} {A B Z Q : Set V}
    {W : Warp (outsideGraph
      (outsideGraph G (interiorRoof G B Z)) Q)}
    (hW : W.IsWave ((quotientSource G A B Z) \ Q) (B \ Q)) :
    roof (outsideGraph (outsideGraph G (interiorRoof G B Z)) Q)
        (B \ Q) W.terminalSet \ Q ⊆
      roof (outsideGraph G Q) (B \ Q)
        (W.mapLE (outsideGraph_mono
          (outsideGraph_le G (interiorRoof G B Z)) Q)).terminalSet := by
  intro x hx
  exact hW.mem_roof_mapLE_of_quotient_delete
    (Or.inr (Or.inr ⟨hx.1, hx.2⟩))

namespace TotalWave

/-- The component shortened by `replaceInessentialPath` is still
inessential.  An exposed path from its shortened terminal must meet a
right-wave terminal.  That terminal lies on the replaced component; its
remaining suffix then witnesses that the old right terminal was essential,
contrary to the replacement hypothesis. -/
theorem replaceInessentialPath_not_mem_essentialSources {V : Type}
    {G : SimpleGraph V} {A B : Set V} {X Y : TotalWave G A B}
    (hXY : X ≤ Y) (a : A) (ha : a ∉ Y.essentialSources)
    {t : V} (htX : (X.path a).1.terminal? = some t) :
    a ∉ (replaceInessentialPath X Y hXY a ha).essentialSources := by
  classical
  let Z := replaceInessentialPath X Y hXY a ha
  intro haZ
  rcases haZ with ⟨u, huZ, huEssential⟩
  have huZ' : (X.path a).1.terminal? = some u := by
    simpa [Z] using huZ
  have hut : u = t := Option.some.inj (huZ'.symm.trans htX)
  subst u
  rcases mem_essentialVertices_iff.mp huEssential with
    ⟨-, b, hb, q, hq, hqOnlyZ⟩
  have htYPath : t ∈ (Y.path a).1.vertexSet :=
    (hXY a).vertexSet_subset (LongPath.terminal_mem_vertexSet htX)
  have htRoof : t ∈ roof G B Y.toWarp.terminalSet :=
    Y.isWave.vertexSet_subset_roof ⟨a, htYPath⟩
  rcases htRoof b hb q hq with ⟨s, hsq, hsY⟩
  rcases hsY with ⟨c, hcY⟩
  change A at c
  change (Y.path c).1.terminal? = some s at hcY
  have hca : c = a := by
    by_contra hca
    have hsZ : s ∈ Z.toWarp.terminalSet := by
      refine ⟨c, ?_⟩
      change (Z.path c).1.terminal? = some s
      rw [replaceInessentialPath_path_of_ne hXY a c ha hca]
      exact hcY
    have hst : s = t := hqOnlyZ s hsq hsZ
    subst s
    have htC : t ∈ (Y.path c).1.vertexSet :=
      LongPath.terminal_mem_vertexSet hcY
    exact Set.disjoint_left.mp (Y.disjoint (Ne.symm hca)) htYPath htC
  subst c
  apply ha
  refine ⟨s, hcY, (mem_essentialVertices_iff).mpr ?_⟩
  refine ⟨⟨a, hcY⟩, b, hb, q.dropUntil s hsq, hq.dropUntil hsq, ?_⟩
  intro v hvq hvY
  rcases hvY with ⟨c, hcYv⟩
  change A at c
  change (Y.path c).1.terminal? = some v at hcYv
  by_cases hca : c = a
  · subst c
    exact Option.some.inj (hcYv.symm.trans hcY)
  · have hvZ : v ∈ Z.toWarp.terminalSet := by
      refine ⟨c, ?_⟩
      change (Z.path c).1.terminal? = some v
      rw [replaceInessentialPath_path_of_ne hXY a c ha hca]
      exact hcYv
    have hvt : v = t :=
      hqOnlyZ v (q.support_dropUntil_subset_support hsq hvq) hvZ
    have htSuffix : t ∈ (q.dropUntil s hsq).support := hvt ▸ hvq
    have hst : s = t :=
      (start_mem_support_dropUntil_iff hq hsq).mp htSuffix
    exact hvt.trans hst.symm

/-- Shafer Lemma 3.12 (one-point lifting).  If deleting a vertex outside a
total wave admits an exterior extension in which one formerly essential
source becomes inessential, then an ambient forward extension of the wave
can be made to terminate at the deleted vertex. -/
theorem exists_extension_terminal_of_outside_essential_loss {V : Type}
    {G : SimpleGraph V} {A B : Set V} (X : TotalWave G A B)
    (hNoBad : X.HasNoBadExtensions) {x : V}
    (hx : x ∉ X.toWarp.vertexSet)
    (Y : TotalWave (outsideGraph G {x}) A (B \ {x}))
    (hXY : toOutsideVertex X x hx ≤ Y) (a₀ : A)
    (haX : a₀ ∈ X.essentialSources)
    (haY : a₀ ∉ Y.essentialSources) :
    ∃ Z : TotalWave G A B, X ≤ Z ∧ x ∈ Z.toWarp.terminalSet := by
  classical
  rcases haX with ⟨t, htX, htEssential⟩
  let Xo := toOutsideVertex X x hx
  have htXo : (Xo.path a₀).1.terminal? = some t := by
    exact (toOutsideVertex_terminal X x hx a₀).trans htX
  let Y' := replaceInessentialPath Xo Y hXY a₀ haY
  have hXY' : Xo ≤ Y' := by
    simpa [Y'] using le_replaceInessentialPath hXY a₀ haY
  have htY' : (Y'.path a₀).1.terminal? = some t := by
    calc
      (Y'.path a₀).1.terminal? = (Xo.path a₀).1.terminal? := by
        rw [show Y'.path a₀ = Xo.path a₀ by
          simpa [Y'] using replaceInessentialPath_path_self hXY a₀ haY]
      _ = some t := htXo
  have haY' : a₀ ∉ Y'.essentialSources := by
    simpa [Y'] using replaceInessentialPath_not_mem_essentialSources
      hXY a₀ haY htXo
  let Xa := mapLEToEmptyTarget (outsideGraph_le G {x}) Xo
  let Ya := mapLEToEmptyTarget (outsideGraph_le G {x}) Y'
  have hXYa : Xa ≤ Ya := by
    intro c n hn
    exact hXY' c n hn
  have hXaPath (c : A) : (Xa.path c).1 = (X.path c).1 := by
    change ((Xo.path c).1.mapLE (outsideGraph_le G {x})) = (X.path c).1
    simpa [Xo] using toOutsideVertex_path_mapLE X x hx c
  have htXa : (Xa.path a₀).1.terminal? = some t := by
    rw [hXaPath]
    exact htX
  have htYa : (Ya.path a₀).1.terminal? = some t := by
    simpa [Ya] using htY'
  have hsepExterior : Separates (outsideGraph G {x}) A (B \ {x})
      (Y'.toWarp.terminalSet \ {t}) := by
    have hEss := essentialVertices_separates Y'.isWave.2
    intro a ha b hb q hq
    rcases hEss a ha b hb q hq with ⟨v, hvq, hvEssential⟩
    have hvTerminal : v ∈ Y'.toWarp.terminalSet :=
      essentialVertices_subset _ _ _ hvEssential
    have hvt : v ≠ t := by
      intro hvt
      subst v
      apply haY'
      exact ⟨t, htY', hvEssential⟩
    exact ⟨v, hvq, hvTerminal, by simpa using hvt⟩
  have hsepAmbient' : Separates G A B
      ((Y'.toWarp.terminalSet \ {t}) ∪ {x}) :=
    separates_union_singleton_of_outside hsepExterior
  have hsepAmbient : Separates G A B
      ((Ya.toWarp.terminalSet \ {t}) ∪ {x}) := by
    simpa [Ya] using hsepAmbient'
  have hAlt : ∃ R : G.Walk t x, Xa.IsAlternatingWalk Ya R := by
    by_cases hdirect : ∃ p : G.Walk t x, p.IsPath ∧
        ∀ v ∈ p.support, v ∈ Y'.toWarp.vertexSet → v = t
    · rcases hdirect with ⟨p, hp, hpAvoid⟩
      refine ⟨p, isAlternatingWalk_of_isPath_of_avoids_right
        hXYa ⟨a₀, htXa⟩ p hp ?_⟩
      intro v hvp hvYa
      apply hpAvoid v hvp
      simpa [Ya] using hvYa
    · have hnotSep := not_separates_alternatingTotalWave_of_no_direct_path
        X hNoBad hx Y' hXY' a₀ ⟨t, htX, htEssential⟩ htX htY' haY'
        hdirect
      unfold Separates at hnotSep
      push Not at hnotSep
      rcases hnotSep with ⟨a, ha, b, hb, q, hq, havoid⟩
      have hxq : x ∈ q.support := by
        by_contra hxq
        have houtside : ∀ v ∈ q.support, v ∉ ({x} : Set V) := by
          intro v hv hvx
          exact hxq (Set.mem_singleton_iff.mp hvx ▸ hv)
        let qE : (outsideGraph G {x}).Walk a b :=
          Erdos599.Walk.toOutsideGraph q houtside
        have hqE : qE.IsPath :=
          Erdos599.Walk.isPath_toOutsideGraph hq houtside
        have hbx : b ≠ x := by
          intro hbx
          apply hxq
          simpa [hbx] using q.end_mem_support
        rcases (alternatingTotalWave hXY' t ⟨a₀, htXo⟩).isWave.2
            a ha b ⟨hb, by simpa using hbx⟩ qE hqE with
          ⟨v, hvqE, hvTerminal⟩
        apply havoid v
        · simpa [qE] using hvqE
        · exact hvTerminal
      simpa [Xa, Ya, Xo] using
        exists_ambient_alternatingWalk_to_deleted
          X hx Y' hXY' ⟨a₀, htXo⟩ ha hb q hq havoid hxq
  rcases hAlt with ⟨R, hR⟩
  rcases exists_totalWave_of_alternatingWalk
      hXYa a₀ htXa htYa hR hsepAmbient with
    ⟨Z, hforward, hterminal⟩
  refine ⟨Z, ?_, ?_⟩
  · intro c
    rw [← hXaPath c]
    exact hforward c
  · rw [hterminal]
    exact Or.inr (Set.mem_singleton x)

/-- Aharoni--Berger Lemma 3.32, obtained from the one-point lifting lemma.
If deleting a non-source vertex makes a clean-unhindered web hindered, then
some ambient total wave terminates at the deleted vertex.

The left wave used in Lemma 3.12 is the trivial total wave.  It avoids `x`
because `x ∉ A`, and clean unhinderedness makes all of its extensions good.
The failed exterior essential-source criterion supplies the required bad
extension; every exterior total wave extends the trivial one. -/
theorem exists_totalWave_terminal_of_delete_not_isCleanUnhindered
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hG : IsCleanUnhindered G A B) {x : V} (hxA : x ∉ A)
    (hdelete : ¬ IsCleanUnhindered (outsideGraph G {x})
      (A \ {x}) (B \ {x})) :
    ∃ Z : TotalWave G A B, x ∈ Z.toWarp.terminalSet := by
  classical
  have hAdelete : A \ ({x} : Set V) = A := by
    ext v
    simp only [Set.mem_diff, Set.mem_singleton_iff]
    constructor
    · exact fun hv ↦ hv.1
    · intro hvA
      exact ⟨hvA, fun hvx ↦ hxA (hvx ▸ hvA)⟩
  let X : TotalWave G A B :=
    WaveExtension.base (trivial_isWave G A B)
  have hxX : x ∉ X.toWarp.vertexSet := by
    intro hx
    change ∃ a : A, x ∈ (X.path a).1.vertexSet at hx
    rcases hx with ⟨a, hxa⟩
    have hxa' : x = (a : V) := by
      simpa [X, WaveExtension.base, trivial, LongPath.toNormalized] using hxa
    exact hxA (hxa' ▸ a.property)
  have hNoBad : X.HasNoBadExtensions := by
    intro Y _
    rw [essentialSources_eq_univ_of_isCleanUnhindered hG X,
      essentialSources_eq_univ_of_isCleanUnhindered hG Y]
  have hdelete' : ¬ IsCleanUnhindered (outsideGraph G {x})
      A (B \ {x}) := by
    simpa [hAdelete] using hdelete
  have hnotAll : ¬ ∀ Y : TotalWave (outsideGraph G {x}) A (B \ {x}),
      Y.essentialSources = Set.univ := by
    intro hall
    exact hdelete'
      (isCleanUnhindered_iff_forall_totalWave_essentialSources_eq_univ.mpr hall)
  push Not at hnotAll
  rcases hnotAll with ⟨Y, hYnotUniv⟩
  rcases (Set.ne_univ_iff_exists_notMem Y.essentialSources).mp hYnotUniv with
    ⟨a₀, haY⟩
  have hXY : toOutsideVertex X x hxX ≤ Y := by
    intro a n hn
    have hnzero : n = 0 := by
      change n ≤ 0 at hn
      omega
    subst n
    constructor
    · cases hidx : (Y.path a).1.terminalIndex <;>
        simp [hidx, longPathActive]
    · exact (Y.path_initial a).trans
        ((toOutsideVertex X x hxX).path_initial a).symm
  have haX : a₀ ∈ X.essentialSources := by
    rw [essentialSources_eq_univ_of_isCleanUnhindered hG X]
    exact Set.mem_univ a₀
  rcases exists_extension_terminal_of_outside_essential_loss
      X hNoBad hxX Y hXY a₀ haX haY with ⟨Z, -, hxZ⟩
  exact ⟨Z, hxZ⟩

end TotalWave

/-!
### Finite deletion of hindrances

The difficult case of Aharoni--Berger Lemma 3.31 is when the deleted point
is internal to one of the paths of a hindrance.  The preceding alternating
machinery gives a short proof.  Totalize the hindrance and distinguish a
source which it misses.  That source is inessential in the total wave.  Its
alternating closure either avoids the point being deleted, in which case it
is a bad total wave in the allegedly unhindered deletion web, or contains the
point.  In the latter case the point is already a terminal, or switching along
an alternating walk ending there makes it a terminal.  Removing that terminal
then leaves a clean hindrance in the deletion web.
-/

/-- Essentiality in a one-point deletion lifts to the ambient total wave when
the total wave avoids the deleted point.  The exterior private path is simply
mapped to the ambient graph. -/
theorem TotalWave.mem_essentialSources_of_toOutsideVertex
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (X : TotalWave G A B) {x : V} (hx : x ∉ X.toWarp.vertexSet)
    (a : A)
    (ha : a ∈ (TotalWave.toOutsideVertex X x hx).essentialSources) :
    a ∈ X.essentialSources := by
  classical
  let Xo := TotalWave.toOutsideVertex X x hx
  rcases ha with ⟨t, htXo, htEssential⟩
  have htX : (X.path a).1.terminal? = some t := by
    exact (TotalWave.toOutsideVertex_terminal X x hx a).symm.trans htXo
  have hStrongO : Xo.toWarp.IsEssentialPath (B \ {x}) a :=
    (Xo.isWave.isEssentialPath_iff_terminal_essential htXo).mpr htEssential
  rcases hStrongO with ⟨u, huXo, b, hb, q, hq, hqOnly⟩
  have hut : u = t := Option.some.inj (huXo.symm.trans htXo)
  subst u
  have hStrong : X.toWarp.IsEssentialPath B a := by
    refine ⟨t, htX, b, hb.1,
      q.mapLe (outsideGraph_le G {x}), hq.mapLe (outsideGraph_le G {x}), ?_⟩
    intro v hvq hvX
    have hvqO : v ∈ q.support := by
      simpa [Walk.support_mapLe_eq_support] using hvq
    have hvXo : v ∈ Xo.toWarp.vertexSet := by
      change ∃ c : A, v ∈ (X.path c).1.vertexSet at hvX
      rcases hvX with ⟨c, hvc⟩
      refine ⟨c, ?_⟩
      change v ∈ (Xo.path c).1.vertexSet
      have hvc' : v ∈
          (((Xo.path c).1.mapLE (outsideGraph_le G {x})).vertexSet) := by
        rw [TotalWave.toOutsideVertex_path_mapLE]
        exact hvc
      simpa using hvc'
    exact hqOnly v hvqO hvXo
  exact ⟨t, htX,
    (X.isWave.isEssentialPath_iff_terminal_essential htX).mp hStrong⟩

/-- Aharoni--Berger Lemma 3.31 for a singleton deletion, in the source-clean
symmetric encoding. -/
theorem not_isCleanUnhindered_outside_singleton_of_not_isCleanUnhindered
    {V : Type} {G : SimpleGraph V} {A B : Set V} {x : V}
    (hxA : x ∉ A) (hG : ¬ IsCleanUnhindered G A B) :
    ¬ IsCleanUnhindered (outsideGraph G {x}) (A \ {x}) (B \ {x}) := by
  classical
  intro houtside
  have hAdiff : A \ ({x} : Set V) = A := by
    ext v
    simp only [Set.mem_diff, Set.mem_singleton_iff]
    constructor
    · exact fun hv ↦ hv.1
    · intro hvA
      exact ⟨hvA, fun hvx ↦ hxA (hvx ▸ hvA)⟩
  have houtside' : IsCleanUnhindered
      (outsideGraph G {x}) A (B \ {x}) := by
    simpa only [hAdiff] using houtside
  rcases (not_isCleanUnhindered_iff_exists_cleanHindrance.mp hG) with
    ⟨W, hW⟩
  rcases Set.not_subset.mp hW.1.2 with ⟨a, haA, haMissing⟩
  let a₀ : A := ⟨a, haA⟩
  let X : TotalWave G A B :=
    WaveExtension.base (Warp.trivial_isWave G A B)
  let Y : TotalWave G A B := hW.1.1.toTotalWave hW.2
  have hXY : X ≤ Y := by
    intro c n hn
    have hnzero : n = 0 := by
      change n ≤ 0 at hn
      omega
    subst n
    constructor
    · cases hidx : (Y.path c).1.terminalIndex <;>
        simp [hidx, longPathActive]
    · exact (Y.path_initial c).trans (X.path_initial c).symm
  have htX : (X.path a₀).1.terminal? = some a := by
    simp [X, WaveExtension.base, Warp.trivial, LongPath.toNormalized, a₀]
  have htY : (Y.path a₀).1.terminal? = some a := by
    simp [Y, IsWave.toTotalWave, LongPath.toNormalized, a₀,
      W.sourcePath_of_not_mem A a₀ haMissing]
  have haY : a₀ ∉ Y.essentialSources := by
    intro haEssential
    rcases haEssential with ⟨t, htY', htEssential⟩
    have hta : t = a := Option.some.inj (htY'.symm.trans htY)
    subst t
    rcases mem_essentialVertices_iff.mp htEssential with
      ⟨-, b, hb, q, hq, hqOnlyY⟩
    rcases hW.1.1.2 a haA b hb q hq with ⟨z, hzq, hzWTerminal⟩
    have hzYTerminal : z ∈ Y.toWarp.terminalSet := by
      rcases hzWTerminal with ⟨i, hiz⟩
      let i₀ : A := ⟨(W.path i).initial, hW.1.1.1 ⟨i, rfl⟩⟩
      refine ⟨i₀, ?_⟩
      change (Y.path i₀).1.terminal? = some z
      simp only [Y, IsWave.toTotalWave, LongPath.toNormalized,
        LongPath.terminal?_normalize]
      change (W.sourcePath A i₀).terminal? = some z
      rw [sourcePath_at_initial hW.1.1.1 i]
      exact hiz
    have hza : z = a := hqOnlyY z hzq hzYTerminal
    subst z
    apply haMissing
    rcases hzWTerminal with ⟨i, hiTerminal⟩
    have haOnPath : a ∈ (W.path i).vertexSet :=
      LongPath.terminal_mem_vertexSet hiTerminal
    exact ⟨i, (hW.2 i a haOnPath haA).symm⟩
  let U : TotalWave G A B :=
    TotalWave.alternatingTotalWave hXY a ⟨a₀, htX⟩
  have hUvertex : U.toWarp.vertexSet =
      (TotalWave.alternatingWarp hXY a).vertexSet := by
    ext v
    change (∃ c : A,
      v ∈ (TotalWave.alternatingPath hXY a c).normalize.vertexSet) ↔
        ∃ c : A, v ∈ (TotalWave.alternatingPath hXY a c).vertexSet
    simp only [LongPath.vertexSet_normalize]
  have hUterminal : U.toWarp.terminalSet =
      (TotalWave.alternatingWarp hXY a).terminalSet := by
    ext v
    change (∃ c : A,
      (TotalWave.alternatingPath hXY a c).normalize.terminal? = some v) ↔
        ∃ c : A,
          (TotalWave.alternatingPath hXY a c).terminal? = some v
    simp only [LongPath.terminal?_normalize]
  have haU : a₀ ∉ U.essentialSources := by
    simpa [U] using
      TotalWave.alternatingTotalWave_not_mem_essentialSources
        hXY a₀ htX htY haY
  have hterminalFalse : ∀ Z : TotalWave G A B,
      x ∈ Z.toWarp.terminalSet → False := by
    intro Z hxTerminal
    rcases hxTerminal with ⟨c, hcx⟩
    have hcA : (Z.path c).1.initial ∈ A :=
      Z.isWave.1 ⟨c, rfl⟩
    have hcxne : (Z.path c).1.initial ≠ x := by
      intro h
      exact hxA (h ▸ hcA)
    rcases Z.isWave.exists_cleanHindrance_deleteTerminal
        Z.isSourceClean c hcx hcA hcxne with ⟨R, hR⟩
    exact (isCleanUnhindered_iff_no_cleanHindrance.mp houtside R hR)
  by_cases hxU : x ∈ U.toWarp.vertexSet
  · by_cases hxTerminal : x ∈ U.toWarp.terminalSet
    · exact hterminalFalse U hxTerminal
    · have hxX : x ∉ X.toWarp.vertexSet := by
        intro hx
        change ∃ c : A, x ∈ (X.path c).1.vertexSet at hx
        rcases hx with ⟨c, hxc⟩
        have hxc' : x = (c : V) := by
          simpa [X, WaveExtension.base, Warp.trivial,
            LongPath.toNormalized] using hxc
        exact hxA (hxc' ▸ c.property)
      rcases TotalWave.exists_alternatingWalk_of_mem_not_terminal_of_left_gate
          hXY a (by rw [← hUvertex]; exact hxU)
          (by rw [← hUterminal]; exact hxTerminal)
          (fun hx ↦ (hxX hx).elim) with ⟨R, hR⟩
      have hsepWithout : Separates G A B (Y.toWarp.terminalSet \ {a}) := by
        intro c hc b hb q hq
        rcases essentialVertices_separates Y.isWave.2 c hc b hb q hq with
          ⟨z, hzq, hzEssential⟩
        have hzTerminal : z ∈ Y.toWarp.terminalSet :=
          essentialVertices_subset G B Y.toWarp.terminalSet hzEssential
        have hza : z ≠ a := by
          intro hza
          subst z
          apply haY
          exact ⟨a, htY, hzEssential⟩
        exact ⟨z, hzq, hzTerminal, by simpa using hza⟩
      have hsepExchange : Separates G A B
          ((Y.toWarp.terminalSet \ {a}) ∪ {x}) := by
        intro c hc b hb q hq
        rcases hsepWithout c hc b hb q hq with ⟨z, hzq, hz⟩
        exact ⟨z, hzq, Or.inl hz⟩
      rcases TotalWave.exists_totalWave_of_alternatingWalk
          hXY a₀ htX htY hR hsepExchange with ⟨Z, -, hZterminal⟩
      apply hterminalFalse Z
      rw [hZterminal]
      exact Or.inr (Set.mem_singleton x)
  · have haOutside : a₀ ∈
        (TotalWave.toOutsideVertex U x hxU).essentialSources := by
      rw [TotalWave.essentialSources_eq_univ_of_isCleanUnhindered houtside'
        (TotalWave.toOutsideVertex U x hxU)]
      exact Set.mem_univ a₀
    exact haU (TotalWave.mem_essentialSources_of_toOutsideVertex
      U hxU a₀ haOutside)

/-- Aharoni--Berger Lemma 3.31: deleting a finite set of non-source vertices
from a hindered source-clean web leaves it hindered. -/
theorem finiteHindranceDeletion : FiniteHindranceDeletion := by
  classical
  intro V G A B D hD
  induction D, hD using Set.Finite.induction_on generalizing G A B with
  | empty =>
      intro _ hG
      simpa using hG
  | @insert x D hxD hD ih =>
      intro hAD hG
      have hxA : x ∉ A := by
        intro hxA
        exact Set.disjoint_left.mp hAD hxA (Set.mem_insert x D)
      have hAD' : Disjoint (A \ ({x} : Set V)) D := by
        rw [Set.disjoint_left]
        intro v hvA hvD
        exact Set.disjoint_left.mp hAD hvA.1 (Set.mem_insert_of_mem x hvD)
      have hxBad :=
        not_isCleanUnhindered_outside_singleton_of_not_isCleanUnhindered
          hxA hG
      have hDBad := ih (outsideGraph G {x})
        (A \ {x}) (B \ {x}) hAD' hxBad
      have hGraph : outsideGraph (outsideGraph G {x}) D =
          outsideGraph G (insert x D) := by
        simpa only [outsideGraph_outsideGraph, Set.insert_eq]
      have hSource : (A \ {x}) \ D = A \ insert x D := by
        ext v
        simp
        tauto
      have hTarget : (B \ {x}) \ D = B \ insert x D := by
        ext v
        simp
        tauto
      simpa only [hGraph, hSource, hTarget] using hDBad

/-!
### Quotienting a warp

The graph quotient alone is not enough for the Section 6 limit: every stage
warp must be cut into its path components in the larger quotient.  The next
definitions implement Aharoni--Berger Definition 2.29 in the `LongPath`
encoding.  A component begins either at the old initial vertex or at an
exposed vertex of the quotienting set.  After that initial position it
continues exactly while its vertices stay outside the full roof.
-/

/-- A position of an old warp at which a component of the quotient warp
starts. -/
structure WarpQuotientStart {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) where
  carrier : W.ι
  index : ℕ
  active : longPathActive (W.path carrier).terminalIndex index
  outside : (W.path carrier).vertex index ∉ interiorRoof G B X
  starts : index = 0 ∨
    (W.path carrier).vertex index ∈ essentialVertices G B X

/-- Active offsets of the quotient component beginning at `s`.  Offset zero
is always retained; every later offset is retained precisely when all
positive positions up to it avoid the full roof. -/
def quotientSegmentIndexSet {V : Type} {G : SimpleGraph V}
    {W : Warp G} {B X : Set V} (s : WarpQuotientStart W B X) : Set ℕ :=
  {k | longPathActive (W.path s.carrier).terminalIndex (s.index + k) ∧
    ∀ j, 0 < j → j ≤ k →
      (W.path s.carrier).vertex (s.index + j) ∉ roof G B X}

theorem quotientSegmentIndexSet_zero_mem {V : Type} {G : SimpleGraph V}
    {W : Warp G} {B X : Set V} (s : WarpQuotientStart W B X) :
    0 ∈ quotientSegmentIndexSet s := by
  refine ⟨by simpa using s.active, ?_⟩
  intro j hj _
  omega

theorem quotientSegmentIndexSet_lower {V : Type} {G : SimpleGraph V}
    {W : Warp G} {B X : Set V} (s : WarpQuotientStart W B X)
    {m n : ℕ} (hmn : m ≤ n) (hn : n ∈ quotientSegmentIndexSet s) :
    m ∈ quotientSegmentIndexSet s := by
  refine ⟨LongPath.active_mono (by omega) hn.1, ?_⟩
  intro j hj hjm
  exact hn.2 j hj (hjm.trans hmn)

/-- The old-path component beginning at `s`, regarded in the exterior graph
of the quotient. -/
noncomputable def quotientSegment {V : Type} {G : SimpleGraph V}
    {W : Warp G} {B X : Set V} (s : WarpQuotientStart W B X) :
    LongPath (outsideGraph G (interiorRoof G B X)) where
  terminalIndex := LongPath.lowerSetTerminalIndex
    (quotientSegmentIndexSet s) ⟨0, quotientSegmentIndexSet_zero_mem s⟩
  vertex k := (W.path s.carrier).vertex (s.index + k)
  injective := by
    intro m hm n hn hmn
    have hmSet := (LongPath.active_lowerSetTerminalIndex_iff
      (quotientSegmentIndexSet s) ⟨0, quotientSegmentIndexSet_zero_mem s⟩
      (fun {_ _} hle hmem => quotientSegmentIndexSet_lower s hle hmem) m).mp hm
    have hnSet := (LongPath.active_lowerSetTerminalIndex_iff
      (quotientSegmentIndexSet s) ⟨0, quotientSegmentIndexSet_zero_mem s⟩
      (fun {_ _} hle hmem => quotientSegmentIndexSet_lower s hle hmem) n).mp hn
    have hindex : s.index + m = s.index + n :=
      (W.path s.carrier).injective hmSet.1 hnSet.1 hmn
    omega
  adjacent := by
    intro k hk
    have hkSet := (LongPath.active_lowerSetTerminalIndex_iff
      (quotientSegmentIndexSet s) ⟨0, quotientSegmentIndexSet_zero_mem s⟩
      (fun {_ _} hle hmem => quotientSegmentIndexSet_lower s hle hmem)
      (k + 1)).mp hk
    refine ⟨?_, ?_, ?_⟩
    · simpa [Nat.add_assoc] using
        (W.path s.carrier).adjacent (s.index + k) hkSet.1
    · by_cases hk0 : k = 0
      · subst k
        simpa using s.outside
      · intro hkInterior
        exact hkSet.2 k (by omega) (by omega) hkInterior.1
    · intro hkInterior
      exact hkSet.2 (k + 1) (by omega) (by omega) hkInterior.1

@[simp] theorem active_quotientSegment_iff {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V}
    (s : WarpQuotientStart W B X) (k : ℕ) :
    longPathActive (quotientSegment s).terminalIndex k ↔
      k ∈ quotientSegmentIndexSet s := by
  exact LongPath.active_lowerSetTerminalIndex_iff
    (quotientSegmentIndexSet s) ⟨0, quotientSegmentIndexSet_zero_mem s⟩
    (fun {_ _} hle hmem => quotientSegmentIndexSet_lower s hle hmem) k

@[simp] theorem vertex_quotientSegment {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V}
    (s : WarpQuotientStart W B X) (k : ℕ) :
    (quotientSegment s).vertex k =
      (W.path s.carrier).vertex (s.index + k) := rfl

@[simp] theorem initial_quotientSegment {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V}
    (s : WarpQuotientStart W B X) :
    (quotientSegment s).initial =
      (W.path s.carrier).vertex s.index := by
  simp [LongPath.initial]

theorem mem_vertexSet_quotientSegment_iff {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V}
    (s : WarpQuotientStart W B X) {v : V} :
    v ∈ (quotientSegment s).vertexSet ↔
      ∃ k, k ∈ quotientSegmentIndexSet s ∧
        (W.path s.carrier).vertex (s.index + k) = v := by
  simp [LongPath.vertexSet]

theorem disjoint_quotientSegment {V : Type} {G : SimpleGraph V}
    {W : Warp G} {B X : Set V} {s t : WarpQuotientStart W B X}
    (hst : s ≠ t) :
    Disjoint (quotientSegment s).vertexSet
      (quotientSegment t).vertexSet := by
  classical
  rw [Set.disjoint_left]
  intro v hsv htv
  rcases mem_vertexSet_quotientSegment_iff s |>.mp hsv with
    ⟨k, hk, hkv⟩
  rcases mem_vertexSet_quotientSegment_iff t |>.mp htv with
    ⟨l, hl, hlv⟩
  by_cases hcarrier : s.carrier = t.carrier
  · have habs : s.index + k = t.index + l := by
      apply (W.path s.carrier).injective hk.1 (by simpa [hcarrier] using hl.1)
      simpa [hcarrier] using hkv.trans hlv.symm
    have hindex : s.index ≠ t.index := by
      intro hindex
      apply hst
      cases s
      cases t
      simp_all
    rcases lt_or_gt_of_ne hindex with hlt | hgt
    · have htPositive : 0 < t.index - s.index := by omega
      have htLe : t.index - s.index ≤ k := by omega
      have hsNotRoof := hk.2 (t.index - s.index) htPositive htLe
      have htEssential :
          (W.path t.carrier).vertex t.index ∈ essentialVertices G B X := by
        rcases t.starts with htZero | htEssential
        · omega
        · exact htEssential
      have htRoof : (W.path t.carrier).vertex t.index ∈ roof G B X :=
        subset_roof G B X (essentialVertices_subset G B X htEssential)
      apply hsNotRoof
      simpa [hcarrier, Nat.add_sub_of_le hlt.le] using htRoof
    · have hsPositive : 0 < s.index - t.index := by omega
      have hsLe : s.index - t.index ≤ l := by omega
      have htNotRoof := hl.2 (s.index - t.index) hsPositive hsLe
      have hsEssential :
          (W.path s.carrier).vertex s.index ∈ essentialVertices G B X := by
        rcases s.starts with hsZero | hsEssential
        · omega
        · exact hsEssential
      have hsRoof : (W.path s.carrier).vertex s.index ∈ roof G B X :=
        subset_roof G B X (essentialVertices_subset G B X hsEssential)
      apply htNotRoof
      simpa [hcarrier, Nat.add_sub_of_le hgt.le] using hsRoof
  · have hsOld : v ∈ (W.path s.carrier).vertexSet :=
      ⟨s.index + k, hk.1, hkv⟩
    have htOld : v ∈ (W.path t.carrier).vertexSet :=
      ⟨t.index + l, hl.1, hlv⟩
    exact Set.disjoint_left.mp (W.disjoint hcarrier) hsOld htOld

/-- Exposed quotient-source vertices not lying on the old warp are inserted
as singleton components. -/
def MissingQuotientVertex {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) :=
  {x : V // x ∈ essentialVertices G B X ∧ x ∉ W.vertexSet}

def QuotientWarpIndex {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) :=
  Sum (WarpQuotientStart W B X) (MissingQuotientVertex W B X)

/-- The path family of Definition 2.29: old components cut at roof entries,
together with missing exposed vertices as singleton paths. -/
noncomputable def quotientWarpPath {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) : QuotientWarpIndex W B X →
      LongPath (outsideGraph G (interiorRoof G B X))
  | .inl s => quotientSegment s
  | .inr x => LongPath.ofWalk
      (.nil : (outsideGraph G (interiorRoof G B X)).Walk x.1 x.1) (by simp)

/-- Aharoni--Berger's quotient `W/X` of a warp. -/
noncomputable def quotientWarp {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) :
    Warp (outsideGraph G (interiorRoof G B X)) where
  ι := QuotientWarpIndex W B X
  path := quotientWarpPath W B X
  disjoint := by
    classical
    intro i j hij
    cases i with
    | inl s =>
        cases j with
        | inl t =>
            apply disjoint_quotientSegment
            intro hst
            exact hij (congrArg Sum.inl hst)
        | inr x =>
            rw [Set.disjoint_left]
            intro v hvS hvx
            have hvOld : v ∈ W.vertexSet := by
              rcases (mem_vertexSet_quotientSegment_iff s).mp hvS with
                ⟨k, hk, hkv⟩
              exact ⟨s.carrier, k + s.index, by
                refine ⟨?_, ?_⟩
                · simpa [Nat.add_comm] using hk.1
                · simpa [Nat.add_comm] using hkv⟩
            have hvx' : v = x.1 := by
              simpa [quotientWarpPath, LongPath.vertexSet_ofWalk] using hvx
            exact x.property.2 (hvx' ▸ hvOld)
    | inr x =>
        cases j with
        | inl t =>
            rw [Set.disjoint_left]
            intro v hvx hvT
            have hvOld : v ∈ W.vertexSet := by
              rcases (mem_vertexSet_quotientSegment_iff t).mp hvT with
                ⟨k, hk, hkv⟩
              exact ⟨t.carrier, k + t.index, by
                refine ⟨?_, ?_⟩
                · simpa [Nat.add_comm] using hk.1
                · simpa [Nat.add_comm] using hkv⟩
            have hvx' : v = x.1 := by
              simpa [quotientWarpPath, LongPath.vertexSet_ofWalk] using hvx
            exact x.property.2 (hvx' ▸ hvOld)
        | inr y =>
            rw [Set.disjoint_left]
            intro v hvx hvy
            have hvx' : v = x.1 := by
              simpa [quotientWarpPath, LongPath.vertexSet_ofWalk] using hvx
            have hvy' : v = y.1 := by
              simpa [quotientWarpPath, LongPath.vertexSet_ofWalk] using hvy
            apply hij
            apply congrArg Sum.inr
            apply Subtype.ext
            exact hvx'.symm.trans hvy'

@[simp] theorem path_quotientWarp_inl {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) (s : WarpQuotientStart W B X) :
    (quotientWarp W B X).path (.inl s) = quotientSegment s := rfl

@[simp] theorem path_quotientWarp_inr {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) (x : MissingQuotientVertex W B X) :
    (quotientWarp W B X).path (.inr x) = LongPath.ofWalk
      (.nil : (outsideGraph G (interiorRoof G B X)).Walk x.1 x.1)
      (by simp) := rfl

/-- Quotienting preserves causal component-closure when the quotienting set
is already contained in the closed set.  Old quotient segments lie on one
old component; inserted singleton components lie in the quotienting set. -/
theorem IsClosedOn.quotientWarp {V : Type} {G : SimpleGraph V}
    {W : Warp G} {B X R : Set V} (hW : W.IsClosedOn R)
    (hXR : X ⊆ R) :
    (quotientWarp W B X).IsClosedOn R := by
  apply isClosedOn_of_path_subset
  intro i hmeet
  cases i with
  | inl s =>
      have hmeetOld : ∃ x ∈ (W.path s.carrier).vertexSet, x ∈ R := by
        rcases hmeet with ⟨x, hxSegment, hxR⟩
        rcases (mem_vertexSet_quotientSegment_iff s).mp hxSegment with
          ⟨k, hk, hkx⟩
        exact ⟨x, ⟨s.index + k, hk.1, hkx⟩, hxR⟩
      have hOld := hW.path_subset s.carrier hmeetOld
      intro v hv
      rcases (mem_vertexSet_quotientSegment_iff s).mp hv with
        ⟨k, hk, hkv⟩
      exact hOld ⟨s.index + k, hk.1, hkv⟩
  | inr x =>
      have hxR : x.1 ∈ R :=
        hXR (essentialVertices_subset G B X x.property.1)
      intro v hv
      have hvx : v = x.1 := by
        simpa [quotientWarpPath, LongPath.vertexSet_ofWalk] using hv
      simpa [hvx] using hxR

/-- Exact source formula for the quotient warp (Aharoni--Berger Lemma 2.34). -/
theorem initialSet_quotientWarp {V : Type} {G : SimpleGraph V}
    (W : Warp G) (B X : Set V) :
    (quotientWarp W B X).initialSet =
      (W.initialSet ∪ X) \ interiorRoof G B X := by
  classical
  ext x
  constructor
  · rintro ⟨j, hjx⟩
    cases j with
    | inl s =>
        have hvalue : (W.path s.carrier).vertex s.index = x := by
          simpa using hjx
        refine ⟨?_, ?_⟩
        · rcases s.starts with hsZero | hsEssential
          · left
            refine ⟨s.carrier, ?_⟩
            simpa [LongPath.initial, hsZero] using hvalue
          · exact Or.inr (hvalue ▸
              essentialVertices_subset G B X hsEssential)
        · simpa [hvalue] using s.outside
    | inr y =>
        have hyx : y.1 = x := by
          simpa [LongPath.initial, LongPath.ofWalk] using hjx
        refine ⟨Or.inr (hyx ▸
          essentialVertices_subset G B X y.property.1), ?_⟩
        intro hxInterior
        exact Set.disjoint_left.mp (interiorRoof_disjoint G B X)
          hxInterior (hyx ▸ y.property.1)
  · rintro ⟨hxOldOrX, hxOutside⟩
    rcases hxOldOrX with hxOld | hxX
    · rcases hxOld with ⟨i, hix⟩
      let s : WarpQuotientStart W B X := {
        carrier := i
        index := 0
        active := by
          cases (W.path i).terminalIndex <;> simp [longPathActive]
        outside := by
          change (W.path i).vertex 0 ∉ interiorRoof G B X
          rw [show (W.path i).vertex 0 = x by
            simpa [LongPath.initial] using hix]
          exact hxOutside
        starts := Or.inl rfl }
      refine ⟨Sum.inl s, ?_⟩
      simpa [s, LongPath.initial] using hix
    · have hxEssential : x ∈ essentialVertices G B X := by
        refine ⟨hxX, ?_⟩
        intro hxRoofOther
        exact hxOutside ⟨subset_roof G B X hxX,
          fun hxEssential => hxEssential.2 hxRoofOther⟩
      by_cases hxW : x ∈ W.vertexSet
      · rcases hxW with ⟨i, n, hn, hnx⟩
        let s : WarpQuotientStart W B X := {
          carrier := i
          index := n
          active := hn
          outside := by simpa [hnx] using hxOutside
          starts := Or.inr (by simpa [hnx] using hxEssential) }
        refine ⟨Sum.inl s, ?_⟩
        simpa [s, LongPath.initial] using hnx
      · let y : MissingQuotientVertex W B X := ⟨x, hxEssential, hxW⟩
        refine ⟨Sum.inr y, ?_⟩
        change (LongPath.ofWalk
          (.nil : (outsideGraph G (interiorRoof G B X)).Walk x x)
          (by simp)).initial = x
        rfl

theorem terminal?_quotientSegment_of_greatest {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V}
    (s : WarpQuotientStart W B X) {k : ℕ}
    (hk : k ∈ quotientSegmentIndexSet s)
    (hgreatest : ∀ m, m ∈ quotientSegmentIndexSet s → m ≤ k) :
    (quotientSegment s).terminal? = some
      ((W.path s.carrier).vertex (s.index + k)) := by
  have hkActive : longPathActive (quotientSegment s).terminalIndex k :=
    (active_quotientSegment_iff s k).mpr hk
  cases hterm : (quotientSegment s).terminalIndex with
  | none =>
      have hsuccActive :
          longPathActive (quotientSegment s).terminalIndex (k + 1) := by
        simp [hterm, longPathActive]
      have hsuccSet := (active_quotientSegment_iff s (k + 1)).mp hsuccActive
      have := hgreatest (k + 1) hsuccSet
      omega
  | some r =>
      have hkr : k ≤ r := by
        simpa [hterm, longPathActive] using hkActive
      have hrk : r ≤ k := by
        by_contra hrk
        have hsuccLe : k + 1 ≤ r := by omega
        have hsuccActive :
            longPathActive (quotientSegment s).terminalIndex (k + 1) := by
          simpa [hterm, longPathActive]
        have hsuccSet :=
          (active_quotientSegment_iff s (k + 1)).mp hsuccActive
        exact (not_le_of_gt (Nat.lt_succ_self k)) (hgreatest (k + 1) hsuccSet)
      have hr : r = k := le_antisymm hrk hkr
      subst r
      simp [LongPath.terminal?, hterm]

/-- Every old terminal that survives the strict-roof deletion is a terminal
of the quotient warp (the first term in Lemma 2.34's terminal inclusion). -/
theorem terminal_mem_quotientWarp_of_terminal_not_interior
    {V : Type} {G : SimpleGraph V} {W : Warp G} {B X : Set V} {t : V}
    (ht : t ∈ W.terminalSet) (htOutside : t ∉ interiorRoof G B X) :
    t ∈ (quotientWarp W B X).terminalSet := by
  classical
  rcases ht with ⟨i, hit⟩
  rcases LongPath.terminal?_eq_some_iff.mp hit with
    ⟨k, hkFinite, hkt⟩
  have hkActive : longPathActive (W.path i).terminalIndex k := by
    simp [hkFinite, longPathActive]
  let q := (W.path i).prefixWalk k hkActive
  by_cases hmeet : ∃ z ∈ q.support, z ∈ roof G B X
  · rcases exists_last_roof_index q hmeet with
      ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
    have hnleK : n ≤ k := by simpa [q] using hnle
    have hnActive : longPathActive (W.path i).terminalIndex n :=
      LongPath.active_mono hnleK hkActive
    have hnGet : q.getVert n = (W.path i).vertex n := by
      exact (W.path i).getVert_prefixWalk_of_le hkActive hnleK
    have hnRoof' : (W.path i).vertex n ∈ roof G B X := by
      simpa [hnGet] using hnRoof
    have hnEssential :
        (W.path i).vertex n ∈ essentialVertices G B X := by
      rcases hnBoundary with hnEssential | hnEnd
      · simpa [hnGet] using hnEssential
      · have hnk : n = k := by simpa [q] using hnEnd
        have hnt : (W.path i).vertex n = t := by simpa [hnk] using hkt
        by_contra hnNotEssential
        apply htOutside
        rw [← hnt]
        exact ⟨hnRoof', hnNotEssential⟩
    have hnOutside : (W.path i).vertex n ∉ interiorRoof G B X := by
      intro hnInterior
      exact Set.disjoint_left.mp (interiorRoof_disjoint G B X)
        hnInterior hnEssential
    let s : WarpQuotientStart W B X := {
      carrier := i
      index := n
      active := hnActive
      outside := hnOutside
      starts := Or.inr hnEssential }
    have hoffset : k - n ∈ quotientSegmentIndexSet s := by
      refine ⟨?_, ?_⟩
      · have hsum : n + (k - n) = k := Nat.add_sub_of_le hnleK
        simpa [s, hsum] using hkActive
      · intro j hjpos hjle
        have hnjle : n + j ≤ k := by omega
        have hnlt : n < n + j := by omega
        have hnot := hnlast (n + j) (by simpa [q] using hnjle) hnlt
        have hget : q.getVert (n + j) =
            (W.path i).vertex (n + j) :=
          (W.path i).getVert_prefixWalk_of_le hkActive hnjle
        simpa [s, hget] using hnot
    have hgreatest : ∀ m, m ∈ quotientSegmentIndexSet s → m ≤ k - n := by
      intro m hm
      have hnmle : n + m ≤ k := by
        simpa [s, hkFinite, longPathActive] using hm.1
      omega
    refine ⟨Sum.inl s, ?_⟩
    change (quotientSegment s).terminal? = some t
    rw [terminal?_quotientSegment_of_greatest s hoffset hgreatest]
    congr 1
    have hsum : n + (k - n) = k := Nat.add_sub_of_le hnleK
    simpa [s, hsum] using hkt
  · push Not at hmeet
    have hzeroOutside :
        (W.path i).vertex 0 ∉ interiorRoof G B X := by
      intro hzero
      exact hmeet ((W.path i).vertex 0)
        ((W.path i).mem_support_prefixWalk_iff hkActive |>.mpr
          ⟨0, Nat.zero_le k, rfl⟩) hzero.1
    let s : WarpQuotientStart W B X := {
      carrier := i
      index := 0
      active := by
        cases (W.path i).terminalIndex <;> simp [longPathActive]
      outside := hzeroOutside
      starts := Or.inl rfl }
    have hkSet : k ∈ quotientSegmentIndexSet s := by
      refine ⟨by simpa [s] using hkActive, ?_⟩
      intro j hjpos hjle hjRoof
      exact hmeet ((W.path i).vertex j)
        ((W.path i).mem_support_prefixWalk_iff hkActive |>.mpr
          ⟨j, hjle, rfl⟩) (by simpa [s] using hjRoof)
    have hgreatest : ∀ m, m ∈ quotientSegmentIndexSet s → m ≤ k := by
      intro m hm
      simpa [s, hkFinite, longPathActive] using hm.1
    refine ⟨Sum.inl s, ?_⟩
    change (quotientSegment s).terminal? = some t
    rw [terminal?_quotientSegment_of_greatest s hkSet hgreatest]
    simpa [s] using congrArg some hkt

/-- Missing exposed vertices are singleton terminals of the quotient warp
(the second term in Lemma 2.34's terminal inclusion). -/
theorem terminal_mem_quotientWarp_of_essential_not_mem {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V} {x : V}
    (hxEssential : x ∈ essentialVertices G B X)
    (hxW : x ∉ W.vertexSet) :
    x ∈ (quotientWarp W B X).terminalSet := by
  let y : MissingQuotientVertex W B X := ⟨x, hxEssential, hxW⟩
  refine ⟨Sum.inr y, ?_⟩
  change (LongPath.ofWalk
    (.nil : (outsideGraph G (interiorRoof G B X)).Walk x x)
    (by simp)).terminal? = some x
  rfl

theorem terminalSet_quotientWarp_lower_bound {V : Type}
    {G : SimpleGraph V} (W : Warp G) (B X : Set V) :
    (W.terminalSet \ interiorRoof G B X) ∪
        (essentialVertices G B X \ W.vertexSet) ⊆
      (quotientWarp W B X).terminalSet := by
  rintro x (hx | hx)
  · exact terminal_mem_quotientWarp_of_terminal_not_interior hx.1 hx.2
  · exact terminal_mem_quotientWarp_of_essential_not_mem hx.1 hx.2

/-- Waves stay waves on taking quotients (Aharoni--Berger Lemma 3.5). -/
theorem IsWave.quotientWarp {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B X : Set V} (hW : W.IsWave A B) :
    (quotientWarp W B X).IsWave (quotientSource G A B X) B := by
  classical
  constructor
  · rw [IsStarting, initialSet_quotientWarp]
    rintro x ⟨hxOldOrX, hxOutside⟩
    refine ⟨?_, hxOutside⟩
    rcases hxOldOrX with hxOld | hxX
    · exact Or.inl (hW.1 hxOld)
    · exact Or.inr hxX
  · intro a ha b hb q hq
    let qG : G.Walk a b :=
      q.mapLe (outsideGraph_le G (interiorRoof G B X))
    have hqG : qG.IsPath :=
      hq.mapLe (outsideGraph_le G (interiorRoof G B X))
    have haUnion : a ∈ A ∪ X := ha.1
    have haRelevant :
        a ∈ roof G B W.terminalSet ∪ essentialVertices G B X := by
      rcases haUnion with haA | haX
      · exact Or.inl (separates_iff_subset_roof.mp hW.2 haA)
      · right
        refine ⟨haX, ?_⟩
        intro haRoofOther
        exact ha.2 ⟨subset_roof G B X haX,
          fun haEssential => haEssential.2 haRoofOther⟩
    have hmeet : ∃ z ∈ qG.support,
        z ∈ roof G B W.terminalSet ∪ essentialVertices G B X :=
      ⟨a, qG.start_mem_support, haRelevant⟩
    rcases exists_last_index_of_support_meets qG
        (roof G B W.terminalSet ∪ essentialVertices G B X) hmeet with
      ⟨n, hnle, hnRelevant, hnlast⟩
    let t := qG.getVert n
    have htqG : t ∈ qG.support := qG.getVert_mem_support n
    have htq : t ∈ q.support := by
      simpa [qG, Walk.support_mapLe_eq_support] using htqG
    have htOutsideX : t ∉ interiorRoof G B X :=
      Erdos599.Walk.vertex_not_mem_of_outsideGraph q ha.2 htq
    have hroofConsequences (htRoof : t ∈ roof G B W.terminalSet) :
        t ∈ W.terminalSet ∧
          t ∉ interiorRoof G B W.terminalSet := by
      rcases exists_last_roof_index qG
          ⟨t, htqG, htRoof⟩ with
        ⟨m, hmle, hmRoof, hmBoundary, hmlast⟩
      have hnm : n ≤ m := by
        by_contra hnm
        exact hmlast n hnle (by omega) htRoof
      have hmn : m ≤ n := by
        by_contra hmn
        exact hnlast m hmle (by omega) (Or.inl hmRoof)
      have hmnEq : m = n := le_antisymm hmn hnm
      subst m
      rcases hmBoundary with htEssential | hnEnd
      · exact ⟨essentialVertices_subset G B W.terminalSet htEssential,
          fun htInterior => Set.disjoint_left.mp
            (interiorRoof_disjoint G B W.terminalSet)
            htInterior htEssential⟩
      · have htb : t = b := by
          simpa [t, hnEnd] using qG.getVert_length
        have hbTerminal : b ∈ W.terminalSet :=
          (mem_roof_of_mem_target_iff hb).mp (by simpa [htb] using htRoof)
        have hbOutside : b ∉ interiorRoof G B W.terminalSet :=
          fun hbInterior => Set.disjoint_left.mp
            (target_disjoint_interiorRoof G B W.terminalSet) hb hbInterior
        exact ⟨by simpa [htb] using hbTerminal,
          by simpa [htb] using hbOutside⟩
    rcases hnRelevant with htRoof | htEssentialX
    · exact ⟨t, htq,
        terminal_mem_quotientWarp_of_terminal_not_interior
          (hroofConsequences htRoof).1 htOutsideX⟩
    · have htOutsideW : t ∉ interiorRoof G B W.terminalSet := by
        intro htInterior
        exact (hroofConsequences htInterior.1).2 htInterior
      by_cases htW : t ∈ W.vertexSet
      · have htRoofW : t ∈ roof G B W.terminalSet :=
          hW.vertexSet_subset_roof htW
        have htEssentialW :
            t ∈ essentialVertices G B W.terminalSet := by
          by_contra htNotEssential
          exact htOutsideW ⟨htRoofW, htNotEssential⟩
        exact ⟨t, htq,
          terminal_mem_quotientWarp_of_terminal_not_interior
            (essentialVertices_subset G B W.terminalSet htEssentialW)
            htOutsideX⟩
      · exact ⟨t, htq,
          terminal_mem_quotientWarp_of_essential_not_mem htEssentialX htW⟩

/-- A total wave after deleting `X` induces a wave in the quotient by `X`.
This is the deletion-to-quotient form used in the closing argument.  A
quotient path meeting `X` meets an exposed vertex, which is supplied as a
singleton component; a quotient path avoiding `X` is a path in the deletion
web and is therefore met by the old terminal set. -/
theorem TotalWave.deletionQuotientWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B X : Set V}
    (Z : TotalWave (outsideGraph G X) (A \ X) (B \ X)) :
    (quotientWarp
      (Z.toWarp.mapLE (outsideGraph_le G X)) B X).IsWave
      (quotientSource G A B X) B := by
  classical
  let W : Warp G := Z.toWarp.mapLE (outsideGraph_le G X)
  have hZInitial : Disjoint Z.toWarp.initialSet X := by
    rw [TotalWave.initialSet_toWarp]
    exact Set.disjoint_sdiff_left
  have hZOutside : Disjoint Z.toWarp.vertexSet X :=
    vertexSet_disjoint_of_outside_initialSet hZInitial
  have hWOutside : Disjoint W.vertexSet X := by
    simpa [W] using hZOutside
  constructor
  · rw [IsStarting, initialSet_quotientWarp]
    intro x hx
    refine ⟨?_, hx.2⟩
    rcases hx.1 with hxInitial | hxX
    · have hxAX : x ∈ A \ X := by
        change x ∈ Z.toWarp.initialSet at hxInitial
        rw [TotalWave.initialSet_toWarp] at hxInitial
        exact hxInitial
      exact Or.inl hxAX.1
    · exact Or.inr hxX
  · intro a ha b hb q hq
    have hqOutsideInterior : ∀ x ∈ q.support,
        x ∉ interiorRoof G B X := by
      intro x hx
      exact Erdos599.Walk.vertex_not_mem_of_outsideGraph q ha.2 hx
    by_cases hmeetX : ∃ x ∈ q.support, x ∈ X
    · rcases hmeetX with ⟨x, hxq, hxX⟩
      have hxEssential : x ∈ essentialVertices G B X := by
        refine ⟨hxX, ?_⟩
        intro hxRoofOther
        exact hqOutsideInterior x hxq
          ⟨subset_roof G B X hxX,
            fun hxEssential => hxEssential.2 hxRoofOther⟩
      have hxW : x ∉ W.vertexSet := fun hxW =>
        Set.disjoint_left.mp hWOutside hxW hxX
      exact ⟨x, hxq,
        terminal_mem_quotientWarp_of_essential_not_mem hxEssential hxW⟩
    · push Not at hmeetX
      have haX : a ∉ X := fun haX => hmeetX a q.start_mem_support haX
      have hbX : b ∉ X := fun hbX => hmeetX b q.end_mem_support hbX
      have haA : a ∈ A := by
        rcases ha.1 with haA | haX'
        · exact haA
        · exact (haX haX').elim
      let qG : G.Walk a b :=
        q.mapLe (outsideGraph_le G (interiorRoof G B X))
      have hqG : qG.IsPath :=
        hq.mapLe (outsideGraph_le G (interiorRoof G B X))
      have hqOutsideX : ∀ x ∈ qG.support, x ∉ X := by
        intro x hx hxX
        apply hmeetX x
        · simpa [qG, Walk.support_mapLe_eq_support] using hx
        · exact hxX
      let qX : (outsideGraph G X).Walk a b :=
        Erdos599.Walk.toOutsideGraph qG hqOutsideX
      have hqX : qX.IsPath :=
        Erdos599.Walk.isPath_toOutsideGraph hqG hqOutsideX
      rcases Z.isWave.2 a ⟨haA, haX⟩ b ⟨hb, hbX⟩ qX hqX with
        ⟨t, htqX, htTerminal⟩
      have htq : t ∈ q.support := by
        have htqG : t ∈ qG.support := by
          simpa [qX] using htqX
        simpa [qG, Walk.support_mapLe_eq_support] using htqG
      have htW : t ∈ W.terminalSet := by
        change t ∈
          (Z.toWarp.mapLE (outsideGraph_le G X)).terminalSet
        rw [terminalSet_mapLE]
        exact htTerminal
      exact ⟨t, htq,
        terminal_mem_quotientWarp_of_terminal_not_interior htW
          (hqOutsideInterior t htq)⟩

/-- Quotienting preserves the source-orientation convention.  An old
quotient segment cannot encounter an old source except at the original
index zero, and it cannot encounter a vertex of the quotienting set at a
positive offset because every such vertex lies in the corresponding roof.
The inserted missing components are singletons. -/
theorem IsSourceClean.quotientWarp {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B X : Set V} (hW : W.IsSourceClean A) :
    (quotientWarp W B X).IsSourceClean (quotientSource G A B X) := by
  classical
  intro j v hv hsource
  cases j with
  | inl s =>
      rcases (mem_vertexSet_quotientSegment_iff s).mp hv with
        ⟨k, hk, hkv⟩
      rcases hsource.1 with hvA | hvX
      · have hvOld : v ∈ (W.path s.carrier).vertexSet :=
          ⟨s.index + k, hk.1, hkv⟩
        have hvInitial : v = (W.path s.carrier).initial :=
          hW s.carrier v hvOld hvA
        have hzero : longPathActive
            (W.path s.carrier).terminalIndex 0 := by
          cases (W.path s.carrier).terminalIndex <;>
            simp [longPathActive]
        have hindex : s.index + k = 0 := by
          apply (W.path s.carrier).injective hk.1 hzero
          simpa [LongPath.initial] using hkv.trans hvInitial
        have hsindex : s.index = 0 := by omega
        have hkzero : k = 0 := by omega
        subst k
        simpa [initial_quotientSegment] using hkv.symm
      · by_cases hkzero : k = 0
        · subst k
          simpa [initial_quotientSegment] using hkv.symm
        · have hvNotRoof := hk.2 k (Nat.pos_of_ne_zero hkzero) le_rfl
          exact (hvNotRoof (hkv ▸ subset_roof G B X hvX)).elim
  | inr x =>
      have hvx : v = x.1 := by
        simpa [quotientWarpPath, LongPath.vertexSet_ofWalk] using hv
      simpa [hvx, quotientWarpPath, LongPath.initial_ofWalk]

/-- Reinterpret a total wave after replacing its endpoint sets by equal
sets.  The paths, disjointness, and wave proof are unchanged. -/
def TotalWave.castEndpoints {V : Type} {G : SimpleGraph V}
    {A A' B B' : Set V} (hA : A = A') (hB : B = B')
    (Z : TotalWave G A B) : TotalWave G A' B' := by
  subst A'
  subst B'
  exact Z

@[simp] theorem TotalWave.toWarp_castEndpoints {V : Type}
    {G : SimpleGraph V} {A A' B B' : Set V}
    (hA : A = A') (hB : B = B') (Z : TotalWave G A B) :
    (Z.castEndpoints hA hB).toWarp = Z.toWarp := by
  subst A'
  subst B'
  rfl

/-- The deletion-to-quotient wave lemma with endpoint sets already known to
avoid the deleted set. -/
theorem TotalWave.deletionQuotientWarp_isWave_of_disjoint
    {V : Type} {G : SimpleGraph V} {A B X : Set V}
    (Z : TotalWave (outsideGraph G X) A B)
    (hAX : Disjoint A X) (hBX : Disjoint B X) :
    (quotientWarp
      (Z.toWarp.mapLE (outsideGraph_le G X)) B X).IsWave
      (quotientSource G A B X) B := by
  have hA : A = A \ X := (hAX.sdiff_eq_left).symm
  have hB : B = B \ X := (hBX.sdiff_eq_left).symm
  let Z' : TotalWave (outsideGraph G X) (A \ X) (B \ X) :=
    Z.castEndpoints hA hB
  have hZ' := Z'.deletionQuotientWarp_isWave
  simpa [Z', hAX.sdiff_eq_left, hBX.sdiff_eq_left] using hZ'

/-- The roof part of Aharoni--Berger Lemma 3.27.  A point roofed after
genuine deletion and not swallowed by the quotienting roof remains roofed
by the quotient warp. -/
theorem TotalWave.roof_delete_sdiff_interior_subset_deletionQuotientWarp
    {V : Type} {G : SimpleGraph V} {A B X : Set V}
    (Z : TotalWave (outsideGraph G X) A B)
    (hAX : Disjoint A X) (hBX : Disjoint B X) :
    roof (outsideGraph G X) B Z.toWarp.terminalSet \
        interiorRoof G B X ⊆
      roof (outsideGraph G (interiorRoof G B X)) B
        (quotientWarp
          (Z.toWarp.mapLE (outsideGraph_le G X)) B X).terminalSet := by
  classical
  let W : Warp G := Z.toWarp.mapLE (outsideGraph_le G X)
  have hZInitial : Disjoint Z.toWarp.initialSet X := by
    rw [TotalWave.initialSet_toWarp]
    exact hAX
  have hZOutside : Disjoint Z.toWarp.vertexSet X :=
    vertexSet_disjoint_of_outside_initialSet hZInitial
  have hWOutside : Disjoint W.vertexSet X := by
    simpa [W] using hZOutside
  intro z hz b hb q hq
  have hqOutsideInterior : ∀ x ∈ q.support,
      x ∉ interiorRoof G B X := by
    intro x hx
    exact Erdos599.Walk.vertex_not_mem_of_outsideGraph q hz.2 hx
  by_cases hmeetX : ∃ x ∈ q.support, x ∈ X
  · rcases hmeetX with ⟨x, hxq, hxX⟩
    have hxEssential : x ∈ essentialVertices G B X := by
      refine ⟨hxX, ?_⟩
      intro hxRoofOther
      exact hqOutsideInterior x hxq
        ⟨subset_roof G B X hxX,
          fun hxEssential => hxEssential.2 hxRoofOther⟩
    have hxW : x ∉ W.vertexSet := fun hxW =>
      Set.disjoint_left.mp hWOutside hxW hxX
    exact ⟨x, hxq,
      terminal_mem_quotientWarp_of_essential_not_mem hxEssential hxW⟩
  · push Not at hmeetX
    have hzX : z ∉ X := fun hzX =>
      hmeetX z q.start_mem_support hzX
    have hbX : b ∉ X := fun hbX =>
      Set.disjoint_left.mp hBX hb hbX
    let qG : G.Walk z b :=
      q.mapLe (outsideGraph_le G (interiorRoof G B X))
    have hqG : qG.IsPath :=
      hq.mapLe (outsideGraph_le G (interiorRoof G B X))
    have hqOutsideX : ∀ x ∈ qG.support, x ∉ X := by
      intro x hx hxX
      apply hmeetX x
      · simpa [qG, Walk.support_mapLe_eq_support] using hx
      · exact hxX
    let qX : (outsideGraph G X).Walk z b :=
      Erdos599.Walk.toOutsideGraph qG hqOutsideX
    have hqX : qX.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hqG hqOutsideX
    rcases hz.1 b hb qX hqX with ⟨t, htqX, htTerminal⟩
    have htq : t ∈ q.support := by
      have htqG : t ∈ qG.support := by
        simpa [qX] using htqX
      simpa [qG, Walk.support_mapLe_eq_support] using htqG
    have htW : t ∈ W.terminalSet := by
      change t ∈
        (Z.toWarp.mapLE (outsideGraph_le G X)).terminalSet
      rw [terminalSet_mapLE]
      exact htTerminal
    exact ⟨t, htq,
      terminal_mem_quotientWarp_of_terminal_not_interior htW
        (hqOutsideInterior t htq)⟩

/-- Strict-roof form of the deletion-to-quotient lemma.  If the point lies
on the deletion wave (and hence outside the deleted set), then strict
roofing is preserved by the quotient warp. -/
theorem TotalWave.interiorRoof_delete_subset_deletionQuotientWarp
    {V : Type} {G : SimpleGraph V} {A B X : Set V}
    (Z : TotalWave (outsideGraph G X) A B)
    (hAX : Disjoint A X) (hBX : Disjoint B X) {z : V}
    (hzVertex : z ∈ Z.toWarp.vertexSet)
    (hz : z ∈ interiorRoof
      (outsideGraph G X) B Z.toWarp.terminalSet) :
    z ∈ interiorRoof (outsideGraph G (interiorRoof G B X)) B
      (quotientWarp
        (Z.toWarp.mapLE (outsideGraph_le G X)) B X).terminalSet := by
  classical
  let W : Warp G := Z.toWarp.mapLE (outsideGraph_le G X)
  let U : Warp (outsideGraph G (interiorRoof G B X)) :=
    quotientWarp W B X
  have hZInitial : Disjoint Z.toWarp.initialSet X := by
    rw [TotalWave.initialSet_toWarp]
    exact hAX
  have hZOutside : Disjoint Z.toWarp.vertexSet X :=
    vertexSet_disjoint_of_outside_initialSet hZInitial
  have hWOutside : Disjoint W.vertexSet X := by
    simpa [W] using hZOutside
  have hzX : z ∉ X := fun hzX =>
    Set.disjoint_left.mp hZOutside hzVertex hzX
  by_cases hzNotInterior : z ∈ interiorRoof G B X
  · exact mem_interiorRoof_outsideGraph_of_mem_deleted hzNotInterior
      (fun hzB => Set.disjoint_left.mp
        (target_disjoint_interiorRoof G B X) hzB hzNotInterior)
  have hzRoof : z ∈ roof
      (outsideGraph G (interiorRoof G B X)) B U.terminalSet := by
    exact Z.roof_delete_sdiff_interior_subset_deletionQuotientWarp
      hAX hBX ⟨hz.1, hzNotInterior⟩
  refine ⟨hzRoof, ?_⟩
  intro hzEssential
  rcases mem_essentialVertices_iff.mp hzEssential with
    ⟨hzTerminal, b, hb, q, hq, hqOnlyU⟩
  have hqOutsideInterior : ∀ x ∈ q.support,
      x ∉ interiorRoof G B X := by
    intro x hx
    exact Erdos599.Walk.vertex_not_mem_of_outsideGraph q
      hzNotInterior hx
  have hqOutsideX : ∀ x ∈ q.support, x ∉ X := by
    intro x hxq hxX
    have hxEssential : x ∈ essentialVertices G B X := by
      refine ⟨hxX, ?_⟩
      intro hxRoofOther
      exact hqOutsideInterior x hxq
        ⟨subset_roof G B X hxX,
          fun hxEssential => hxEssential.2 hxRoofOther⟩
    have hxW : x ∉ W.vertexSet := fun hxW =>
      Set.disjoint_left.mp hWOutside hxW hxX
    have hxTerminal : x ∈ U.terminalSet :=
      terminal_mem_quotientWarp_of_essential_not_mem hxEssential hxW
    have hxz : x = z := hqOnlyU x hxq hxTerminal
    exact hzX (hxz ▸ hxX)
  let qG : G.Walk z b :=
    q.mapLe (outsideGraph_le G (interiorRoof G B X))
  have hqG : qG.IsPath :=
    hq.mapLe (outsideGraph_le G (interiorRoof G B X))
  have hqGOutsideX : ∀ x ∈ qG.support, x ∉ X := by
    intro x hx
    apply hqOutsideX x
    simpa [qG, Walk.support_mapLe_eq_support] using hx
  let qX : (outsideGraph G X).Walk z b :=
    Erdos599.Walk.toOutsideGraph qG hqGOutsideX
  have hqX : qX.IsPath :=
    Erdos599.Walk.isPath_toOutsideGraph hqG hqGOutsideX
  have hzTerminalZ : z ∈ Z.toWarp.terminalSet := by
    rcases hz.1 b hb qX hqX with ⟨t, htqX, htTerminal⟩
    have htqG : t ∈ qG.support := by
      simpa [qX] using htqX
    have htq : t ∈ q.support := by
      simpa [qG, Walk.support_mapLe_eq_support] using htqG
    have htNotInterior : t ∉ interiorRoof G B X :=
      hqOutsideInterior t htq
    have htW : t ∈ W.terminalSet := by
      change t ∈
        (Z.toWarp.mapLE (outsideGraph_le G X)).terminalSet
      rw [terminalSet_mapLE]
      exact htTerminal
    have htU : t ∈ U.terminalSet :=
      terminal_mem_quotientWarp_of_terminal_not_interior htW htNotInterior
    have htz : t = z := hqOnlyU t htq htU
    exact htz ▸ htTerminal
  apply hz.2
  apply mem_essentialVertices_iff.mpr
  refine ⟨hzTerminalZ, b, hb, qX, hqX, ?_⟩
  intro t htqX htTerminal
  have htqG : t ∈ qG.support := by
    simpa [qX] using htqX
  have htq : t ∈ q.support := by
    simpa [qG, Walk.support_mapLe_eq_support] using htqG
  have htNotInterior : t ∉ interiorRoof G B X :=
    hqOutsideInterior t htq
  have htW : t ∈ W.terminalSet := by
    change t ∈
      (Z.toWarp.mapLE (outsideGraph_le G X)).terminalSet
    rw [terminalSet_mapLE]
    exact htTerminal
  have htU : t ∈ U.terminalSet :=
    terminal_mem_quotientWarp_of_terminal_not_interior htW htNotInterior
  exact hqOnlyU t htq htU

/-- Quotienting a warp preserves the roof of its old terminal set.  Points
deleted by the strict roof have no path to the target in the quotient;
otherwise an old terminal met by a quotient path survives as a quotient
terminal. -/
theorem roof_terminalSet_subset_roof_quotientWarp {V : Type}
    {G : SimpleGraph V} {W : Warp G} {B X : Set V} :
    roof G B W.terminalSet ⊆
      roof (outsideGraph G (interiorRoof G B X)) B
        (quotientWarp W B X).terminalSet := by
  classical
  intro x hx b hb q hq
  by_cases hxInterior : x ∈ interiorRoof G B X
  · cases q with
    | nil =>
        exact (Set.disjoint_left.mp (target_disjoint_interiorRoof G B X)
          hb hxInterior).elim
    | @cons _ y _ hxy r =>
        exact (hxy.2.1 hxInterior).elim
  · let qG : G.Walk x b :=
      q.mapLe (outsideGraph_le G (interiorRoof G B X))
    have hqG : qG.IsPath :=
      hq.mapLe (outsideGraph_le G (interiorRoof G B X))
    rcases hx b hb qG hqG with ⟨t, htqG, htTerminal⟩
    have htq : t ∈ q.support := by
      simpa [qG, Walk.support_mapLe_eq_support] using htqG
    have htOutside : t ∉ interiorRoof G B X :=
      Erdos599.Walk.vertex_not_mem_of_outsideGraph q hxInterior htq
    exact ⟨t, htq,
      terminal_mem_quotientWarp_of_terminal_not_interior
        htTerminal htOutside⟩

/-- Aharoni--Berger Lemma 2.35: an old strict-roof point which survives the
quotient remains strictly roofed by the quotient warp. -/
theorem interiorRoof_terminalSet_inter_compl_subset_quotientWarp
    {V : Type} {G : SimpleGraph V} {W : Warp G} {B X : Set V} :
    interiorRoof G B W.terminalSet \ interiorRoof G B X ⊆
      interiorRoof (outsideGraph G (interiorRoof G B X)) B
        (quotientWarp W B X).terminalSet := by
  classical
  intro x hx
  refine ⟨roof_terminalSet_subset_roof_quotientWarp hx.1.1, ?_⟩
  intro hxEssential
  rcases mem_essentialVertices_iff.mp hxEssential with
    ⟨hxTerminalQ, b, hb, q, hq, hqOnlyQ⟩
  let qG : G.Walk x b :=
    q.mapLe (outsideGraph_le G (interiorRoof G B X))
  have hqG : qG.IsPath :=
    hq.mapLe (outsideGraph_le G (interiorRoof G B X))
  have hxTerminalW : x ∈ W.terminalSet := by
    rcases hx.1.1 b hb qG hqG with ⟨t, htqG, htW⟩
    have htq : t ∈ q.support := by
      simpa [qG, Walk.support_mapLe_eq_support] using htqG
    have htOutside : t ∉ interiorRoof G B X :=
      Erdos599.Walk.vertex_not_mem_of_outsideGraph q hx.2 htq
    have htQ : t ∈ (quotientWarp W B X).terminalSet :=
      terminal_mem_quotientWarp_of_terminal_not_interior htW htOutside
    have htx : t = x := hqOnlyQ t htq htQ
    simpa [htx] using htW
  apply hx.1.2
  apply mem_essentialVertices_iff.mpr
  refine ⟨hxTerminalW, b, hb, qG, hqG, ?_⟩
  intro z hzqG hzW
  have hzq : z ∈ q.support := by
    simpa [qG, Walk.support_mapLe_eq_support] using hzqG
  have hzOutside : z ∉ interiorRoof G B X :=
    Erdos599.Walk.vertex_not_mem_of_outsideGraph q hx.2 hzq
  have hzQ : z ∈ (quotientWarp W B X).terminalSet :=
    terminal_mem_quotientWarp_of_terminal_not_interior hzW hzOutside
  exact hqOnlyQ z hzq hzQ

/-- A wave in the quotient by `S` can be quotiented once more by a larger
set `T` and transported, using the nested-quotient identities, to a wave in
the direct quotient by `T`. -/
theorem IsWave.exists_quotientWarp_nested {V : Type} {G : SimpleGraph V}
    {A B S T : Set V}
    {W : Warp (outsideGraph G (interiorRoof G B S))}
    (hW : W.IsWave (quotientSource G A B S) B) (hST : S ⊆ T) :
    ∃ U : Warp (outsideGraph G (interiorRoof G B T)),
      U.IsWave (quotientSource G A B T) B := by
  have hGraph := outsideGraph_nestedQuotient_eq_of_subset
    (G := G) (B := B) hST
  have hSource := quotientSource_nested_eq_of_subset
    (G := G) (A := A) (B := B) hST
  rw [← hGraph, ← hSource]
  exact ⟨Erdos599.Warp.quotientWarp W B T, hW.quotientWarp⟩

/-- Transport a warp along equality of its ambient graphs. -/
def castGraph {V : Type} {G H : SimpleGraph V} (hGH : G = H)
    (W : Warp G) : Warp H := hGH ▸ W

theorem IsSourceClean.castGraph {V : Type} {G H : SimpleGraph V}
    {W : Warp G} {A : Set V} (hW : W.IsSourceClean A) (hGH : G = H) :
    (Erdos599.Warp.castGraph hGH W).IsSourceClean A := by
  subst H
  exact hW

theorem IsClosedOn.castGraph {V : Type} {G H : SimpleGraph V}
    {W : Warp G} {R : Set V} (hW : W.IsClosedOn R) (hGH : G = H) :
    (Erdos599.Warp.castGraph hGH W).IsClosedOn R := by
  subst H
  exact hW

@[simp] theorem terminalSet_castGraph {V : Type} {G H : SimpleGraph V}
    (hGH : G = H) (W : Warp G) :
    (Erdos599.Warp.castGraph hGH W).terminalSet = W.terminalSet := by
  subst H
  rfl

@[simp] theorem initialSet_castGraph {V : Type} {G H : SimpleGraph V}
    (hGH : G = H) (W : Warp G) :
    (Erdos599.Warp.castGraph hGH W).initialSet = W.initialSet := by
  subst H
  rfl

@[simp] theorem vertexSet_castGraph {V : Type} {G H : SimpleGraph V}
    (hGH : G = H) (W : Warp G) :
    (Erdos599.Warp.castGraph hGH W).vertexSet = W.vertexSet := by
  subst H
  rfl

theorem mem_roof_terminalSet_castGraph_iff {V : Type}
    {G H : SimpleGraph V} (hGH : G = H) (W : Warp G)
    (B : Set V) (x : V) :
    x ∈ roof H B (Erdos599.Warp.castGraph hGH W).terminalSet ↔
      x ∈ roof G B W.terminalSet := by
  subst H
  rfl

theorem IsWave.castGraph {V : Type} {G H : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B) (hGH : G = H) :
    (Erdos599.Warp.castGraph hGH W).IsWave A B := by
  subst H
  exact hW

/-- The concrete nested quotient warp, transported to the direct quotient
graph.  Keeping this definition (rather than only an existence theorem)
preserves access to its path-component formula in the closing argument. -/
noncomputable def quotientWarpNested {V : Type} {G : SimpleGraph V}
    {B S T : Set V} (W : Warp (outsideGraph G (interiorRoof G B S)))
    (hST : S ⊆ T) : Warp (outsideGraph G (interiorRoof G B T)) :=
  Erdos599.Warp.castGraph
    (outsideGraph_nestedQuotient_eq_of_subset (G := G) (B := B) hST)
    (Erdos599.Warp.quotientWarp W B T)

theorem IsClosedOn.quotientWarpNested {V : Type} {G : SimpleGraph V}
    {B S T R : Set V}
    {W : Warp (outsideGraph G (interiorRoof G B S))}
    (hW : W.IsClosedOn R) (hST : S ⊆ T) (hTR : T ⊆ R) :
    (Erdos599.Warp.quotientWarpNested W hST).IsClosedOn R := by
  unfold Erdos599.Warp.quotientWarpNested
  exact (hW.quotientWarp hTR).castGraph
    (outsideGraph_nestedQuotient_eq_of_subset
      (G := G) (B := B) hST)

theorem IsWave.quotientWarpNested {V : Type} {G : SimpleGraph V}
    {A B S T : Set V}
    {W : Warp (outsideGraph G (interiorRoof G B S))}
    (hW : W.IsWave (quotientSource G A B S) B) (hST : S ⊆ T) :
    (Erdos599.Warp.quotientWarpNested W hST).IsWave
      (quotientSource G A B T) B := by
  have hGraph := outsideGraph_nestedQuotient_eq_of_subset
    (G := G) (B := B) hST
  have hU := (hW.quotientWarp (X := T)).castGraph hGraph
  rw [quotientSource_nested_eq_of_subset
    (G := G) (A := A) (B := B) hST] at hU
  exact hU

/-- Source-cleanliness survives a nested quotient and its transport to the
direct quotient graph. -/
theorem IsSourceClean.quotientWarpNested {V : Type} {G : SimpleGraph V}
    {A B S T : Set V}
    {W : Warp (outsideGraph G (interiorRoof G B S))}
    (hW : W.IsSourceClean (quotientSource G A B S)) (hST : S ⊆ T) :
    (Erdos599.Warp.quotientWarpNested W hST).IsSourceClean
      (quotientSource G A B T) := by
  have hGraph := outsideGraph_nestedQuotient_eq_of_subset
    (G := G) (B := B) hST
  have hU := (hW.quotientWarp (B := B) (X := T)).castGraph hGraph
  rw [quotientSource_nested_eq_of_subset
    (G := G) (A := A) (B := B) hST] at hU
  exact hU

/-- The old terminal roof survives a nested quotient, after transporting
the twice-quotiented warp to the direct quotient graph. -/
theorem roof_terminalSet_subset_roof_quotientWarpNested {V : Type}
    {G : SimpleGraph V} {B S T : Set V}
    (W : Warp (outsideGraph G (interiorRoof G B S))) (hST : S ⊆ T) :
    roof (outsideGraph G (interiorRoof G B S)) B W.terminalSet ⊆
      roof (outsideGraph G (interiorRoof G B T)) B
        (Erdos599.Warp.quotientWarpNested W hST).terminalSet := by
  intro x hx
  let H := outsideGraph G (interiorRoof G B S)
  let U := Erdos599.Warp.quotientWarp W B T
  have hxU : x ∈
      roof (outsideGraph H (interiorRoof H B T)) B U.terminalSet :=
    roof_terminalSet_subset_roof_quotientWarp (G := H)
      (W := W) (B := B) (X := T) hx
  have hGraph :
      outsideGraph H (interiorRoof H B T) =
        outsideGraph G (interiorRoof G B T) :=
    outsideGraph_nestedQuotient_eq_of_subset
      (G := G) (B := B) hST
  change x ∈ roof (outsideGraph G (interiorRoof G B T)) B
    (Erdos599.Warp.castGraph hGraph U).terminalSet
  exact (mem_roof_terminalSet_castGraph_iff hGraph U B x).mpr hxU

/-- A strict-roof point of a wave in the quotient by `S` remains strictly
roofed after quotienting by a larger set `T`, provided the point itself lies
in `T` and is not a target.  If it is swallowed by the larger quotient this
is immediate from isolation; otherwise it is exactly Lemma 2.35. -/
theorem interiorRoof_terminalSet_subset_quotientWarpNested_of_mem
    {V : Type} {G : SimpleGraph V} {B S T : Set V}
    (W : Warp (outsideGraph G (interiorRoof G B S))) (hST : S ⊆ T)
    {x : V} (hxT : x ∈ T) (hxB : x ∉ B)
    (hxStrict : x ∈ interiorRoof
      (outsideGraph G (interiorRoof G B S)) B W.terminalSet) :
    x ∈ interiorRoof (outsideGraph G (interiorRoof G B T)) B
      (Erdos599.Warp.quotientWarpNested W hST).terminalSet := by
  let H := outsideGraph G (interiorRoof G B S)
  let U := Erdos599.Warp.quotientWarp W B T
  have hGraph :
      outsideGraph H (interiorRoof H B T) =
        outsideGraph G (interiorRoof G B T) :=
    outsideGraph_nestedQuotient_eq_of_subset
      (G := G) (B := B) hST
  by_cases hxDeleted : x ∈ interiorRoof H B T
  · have hxDirect : x ∈ interiorRoof G B T := by
      rw [← interiorRoof_outsideGraph_interiorRoof_eq_of_subset
        (G := G) (B := B) hST]
      exact hxDeleted
    exact mem_interiorRoof_outsideGraph_of_mem_deleted
      hxDirect hxB
  · have hxU : x ∈ interiorRoof
        (outsideGraph H (interiorRoof H B T)) B U.terminalSet :=
      interiorRoof_terminalSet_inter_compl_subset_quotientWarp
        (G := H) (W := W) (B := B) (X := T) ⟨hxStrict, hxDeleted⟩
    subst H
    subst U
    change x ∈ interiorRoof
      (outsideGraph G (interiorRoof G B T)) B
      (Erdos599.Warp.castGraph hGraph
        (Erdos599.Warp.quotientWarp W B T)).terminalSet
    rw [terminalSet_castGraph, ← hGraph]
    exact hxU

/-- A total wave in the quotient web by an arbitrary vertex set `X`.  The
spanning graph deletes the strict roof of `X`, while the source side is the
old surviving sources together with the exposed boundary of `X`. -/
abbrev QuotientTotalWave {V : Type} (G : SimpleGraph V)
    (A B X : Set V) :=
  TotalWave (outsideGraph G (interiorRoof G B X))
    (quotientSource G A B X) B

/-- The components of a quotient total wave issued from the quotienting set
start exactly on its exposed essential boundary. -/
theorem initialSet_issuedFrom_quotientTotalWave {V : Type}
    {G : SimpleGraph V} {A B X : Set V} (W : QuotientTotalWave G A B X) :
    (W.toWarp.issuedFrom X).initialSet = essentialVertices G B X := by
  rw [initialSet_issuedFrom, TotalWave.initialSet_toWarp,
    quotientSource_inter_self]

/-- Consequently, the fractured part of a quotient wave over a countable set
has countable carrier.  This is the cardinal estimate used at every step of
the Section 6 closing-up recursion. -/
theorem vertexSet_issuedFrom_quotientTotalWave_countable {V : Type}
    {G : SimpleGraph V} {A B X : Set V} (W : QuotientTotalWave G A B X)
    (hX : X.Countable) :
    (W.toWarp.issuedFrom X).vertexSet.Countable :=
  W.toWarp.vertexSet_issuedFrom_countable hX

theorem vertexSet_meeting_quotientTotalWave_countable {V : Type}
    {G : SimpleGraph V} {A B X : Set V} (W : QuotientTotalWave G A B X)
    (hX : X.Countable) :
    (W.toWarp.meeting X).vertexSet.Countable :=
  W.toWarp.vertexSet_meeting_countable hX

/-- One closing-up step from Aharoni--Berger equation (6.4).  Besides the old
countable set it adds finite certificates for relevant boundary vertices,
countable certificates for old bounded tree vertices, and the tree vertices
met by the fractured quotient warp. -/
def quotientClosingStep {V : Type} {G : SimpleGraph V}
    {A B : Set V} (T Y Q X : Set V) (W : QuotientTotalWave G A B X)
    (boundaryCertificate boundedCertificate : V → Set V) : Set V :=
  X ∪
    (⋃ z ∈ Y ∩ (W.toWarp.meeting X).vertexSet,
      boundaryCertificate z) ∪
    (⋃ t ∈ X \ Q, boundedCertificate t) ∪
    ((W.toWarp.meeting X).vertexSet ∩ T)

/-- Every closing-up step remains countable.  This isolates the complete
cardinal calculation in (6.4); no countability assumption is made on the
ambient graph, source side, target side, or tree. -/
theorem quotientClosingStep_countable {V : Type} {G : SimpleGraph V}
    {A B T Y Q X : Set V} (W : QuotientTotalWave G A B X)
    (boundaryCertificate boundedCertificate : V → Set V)
    (hX : X.Countable)
    (hboundary : ∀ z ∈ Y, (boundaryCertificate z).Finite)
    (hbounded : ∀ t, (boundedCertificate t).Countable) :
    (quotientClosingStep T Y Q X W
      boundaryCertificate boundedCertificate).Countable := by
  let C := (W.toWarp.meeting X).vertexSet
  have hC : C.Countable :=
    vertexSet_meeting_quotientTotalWave_countable W hX
  have hYC : (Y ∩ C).Countable := hC.mono Set.inter_subset_right
  have hBoundaryUnion :
      (⋃ z ∈ Y ∩ C, boundaryCertificate z).Countable := by
    apply hYC.biUnion
    intro z hz
    exact (hboundary z hz.1).countable
  have hXQ : (X \ Q).Countable := hX.mono Set.sdiff_subset
  have hBoundedUnion :
      (⋃ t ∈ X \ Q, boundedCertificate t).Countable := by
    apply hXQ.biUnion
    intro t _
    exact hbounded t
  have hCT : (C ∩ T).Countable := hC.mono Set.inter_subset_left
  exact ((hX.union hBoundaryUnion).union hBoundedUnion).union hCT

/-- If all certificate sets lie in the safe tree, one closing-up step stays
inside that tree. -/
theorem quotientClosingStep_subset_tree {V : Type} {G : SimpleGraph V}
    {A B T Y Q X : Set V} (W : QuotientTotalWave G A B X)
    (boundaryCertificate boundedCertificate : V → Set V)
    (hX : X ⊆ T)
    (hboundary : ∀ z ∈ Y, boundaryCertificate z ⊆ T)
    (hbounded : ∀ t, boundedCertificate t ⊆ T) :
    quotientClosingStep T Y Q X W
      boundaryCertificate boundedCertificate ⊆ T := by
  intro x hx
  unfold quotientClosingStep at hx
  rcases hx with (((hxX | hxBoundary) | hxBounded) | hxTree)
  · exact hX hxX
  · rcases Set.mem_iUnion.mp hxBoundary with ⟨z, hz⟩
    rcases Set.mem_iUnion.mp hz with ⟨hzYC, hxCertificate⟩
    exact hboundary z hzYC.1 hxCertificate
  · rcases Set.mem_iUnion.mp hxBounded with ⟨t, ht⟩
    rcases Set.mem_iUnion.mp ht with ⟨_htXQ, hxCertificate⟩
    exact hbounded t hxCertificate
  · exact hxTree.2

/-- A boundary certificate selected by the fractured quotient warp is included
in the next closing-up set. -/
theorem boundaryCertificate_subset_quotientClosingStep {V : Type}
    {G : SimpleGraph V} {A B T Y Q X : Set V}
    (W : QuotientTotalWave G A B X)
    (boundaryCertificate boundedCertificate : V → Set V) {z : V}
    (hz : z ∈ Y ∩ (W.toWarp.meeting X).vertexSet) :
    boundaryCertificate z ⊆
      quotientClosingStep T Y Q X W
        boundaryCertificate boundedCertificate := by
  intro x hx
  unfold quotientClosingStep
  exact Or.inl <| Or.inl <| Or.inr <|
    Set.mem_iUnion.mpr ⟨z, Set.mem_iUnion.mpr ⟨hz, hx⟩⟩

/-- The boundedness certificate of every old bounded tree vertex is included
in the next closing-up set. -/
theorem boundedCertificate_subset_quotientClosingStep {V : Type}
    {G : SimpleGraph V} {A B T Y Q X : Set V}
    (W : QuotientTotalWave G A B X)
    (boundaryCertificate boundedCertificate : V → Set V) {t : V}
    (ht : t ∈ X \ Q) :
    boundedCertificate t ⊆
      quotientClosingStep T Y Q X W
        boundaryCertificate boundedCertificate := by
  intro x hx
  unfold quotientClosingStep
  exact Or.inl <| Or.inr <|
    Set.mem_iUnion.mpr ⟨t, Set.mem_iUnion.mpr ⟨ht, hx⟩⟩

/-- Every tree vertex met by the fractured quotient warp belongs to the next
closing-up set. -/
theorem meeting_inter_tree_subset_quotientClosingStep {V : Type}
    {G : SimpleGraph V} {A B T Y Q X : Set V}
    (W : QuotientTotalWave G A B X)
    (boundaryCertificate boundedCertificate : V → Set V) :
    (W.toWarp.meeting X).vertexSet ∩ T ⊆
      quotientClosingStep T Y Q X W
        boundaryCertificate boundedCertificate := by
  intro x hx
  unfold quotientClosingStep
  exact Or.inr hx

/-- A vertex set carrying the finite-deletion invariant used in the rooted
tree construction of Aharoni--Berger Theorem 6.1.  We record connectivity
instead of choosing parent edges: every vertex has a finite path from the
root whose support stays in the set.  The second clause says that the root
is the only source admitted into the set. -/
def IsSafeRootSet {V : Type} (G : SimpleGraph V) (A B : Set V)
    (a : V) (T : Set V) : Prop :=
  a ∈ T ∧
    (∀ x ∈ T, x ∈ A → x = a) ∧
    (∀ x ∈ T, ∃ q : G.Walk a x,
      q.IsPath ∧ {v | v ∈ q.support} ⊆ T) ∧
    ∀ F : Set V, F.Finite → F ⊆ T \ {a} →
      IsCleanUnhindered (outsideGraph G ({a} ∪ F))
        (A \ ({a} ∪ F)) (B \ ({a} ∪ F))

/-- The singleton root starts the safe rooted-set construction. -/
theorem isSafeRootSet_singleton {V : Type} {G : SimpleGraph V}
    {A B : Set V} (hG : IsCleanUnhindered G A B) {a : V} (ha : a ∈ A) :
    IsSafeRootSet G A B a {a} := by
  classical
  refine ⟨Set.mem_singleton a, ?_, ?_, ?_⟩
  · intro x hx _hxA
    exact Set.mem_singleton_iff.mp hx
  · intro x hx
    have hxa : x = a := Set.mem_singleton_iff.mp hx
    subst x
    refine ⟨(.nil : G.Walk a a), by simp, ?_⟩
    simpa using (Set.subset_refl ({a} : Set V))
  · intro F hF hFsub
    have hFempty : F = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro x hx
      have hxEmpty : x ∈ ({a} : Set V) \ {a} := hFsub hx
      exact hxEmpty.2 hxEmpty.1
    subst F
    simpa using hG.deleteSource ha

/-- The union of a nonempty inclusion chain of safe rooted sets is safe.
The only compactness step is that a finite deletion set contained in the
union is already contained in one member of the chain. -/
theorem isSafeRootSet_sUnion_chain {V : Type} {G : SimpleGraph V}
    {A B : Set V} {a : V} {c : Set (Set V)}
    (hc : IsChain (· ⊆ ·) c) (hcne : c.Nonempty)
    (hsafe : ∀ T ∈ c, IsSafeRootSet G A B a T) :
    IsSafeRootSet G A B a (⋃₀ c) := by
  classical
  rcases hcne with ⟨T₀, hT₀c⟩
  refine ⟨⟨T₀, hT₀c, (hsafe T₀ hT₀c).1⟩, ?_, ?_, ?_⟩
  · rintro x ⟨T, hTc, hxT⟩ hxA
    exact (hsafe T hTc).2.1 x hxT hxA
  · rintro x ⟨T, hTc, hxT⟩
    rcases (hsafe T hTc).2.2.1 x hxT with ⟨q, hq, hqT⟩
    exact ⟨q, hq, fun v hv => ⟨T, hTc, hqT hv⟩⟩
  · intro F hF hFsub
    have hFsUnion : F ⊆ ⋃₀ c := fun x hx => (hFsub hx).1
    rcases hc.directedOn.exists_mem_subset_of_finite_of_subset_sUnion
        ⟨T₀, hT₀c⟩ hF hFsUnion with ⟨T, hTc, hFT⟩
    apply (hsafe T hTc).2.2.2 F hF
    intro x hx
    exact ⟨hFT hx, (hFsub hx).2⟩

/-- Zorn's lemma supplies a maximal safe rooted set. -/
theorem exists_maximal_isSafeRootSet {V : Type} {G : SimpleGraph V}
    {A B : Set V} (hG : IsCleanUnhindered G A B) {a : V} (ha : a ∈ A) :
    ∃ T : Set V, Maximal (IsSafeRootSet G A B a) T := by
  classical
  rcases zorn_subset_nonempty {T : Set V | IsSafeRootSet G A B a T}
      (fun c hc hchain hcne => by
        refine ⟨⋃₀ c, isSafeRootSet_sUnion_chain hchain hcne ?_, ?_⟩
        · intro T hTc
          exact hc hTc
        · intro T hTc
          exact Set.subset_sUnion_of_mem hTc)
      ({a} : Set V) (isSafeRootSet_singleton hG ha) with
    ⟨T, -, hTmax⟩
  exact ⟨T, hTmax⟩

/-- If no safe path starts at `a`, a maximal safe rooted set cannot meet the
target side.  A path inside the rooted set has finite support, so its support
minus the root is an allowed finite deletion. -/
theorem IsSafeRootSet.disjoint_target_of_no_safePath {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : IsSafeRootSet G A B a T)
    (hno : ¬ ∃ b ∈ B, ∃ q : G.Walk a b,
      q.IsPath ∧
      (∀ x ∈ q.support, x ∈ A → x = a) ∧
      IsCleanUnhindered
        (outsideGraph G {x | x ∈ q.support})
        (A \ {x | x ∈ q.support})
        (B \ {x | x ∈ q.support})) :
    Disjoint T B := by
  classical
  rw [Set.disjoint_left]
  intro b hbT hbB
  rcases hT.2.2.1 b hbT with ⟨q, hq, hqT⟩
  let X : Set V := {x | x ∈ q.support}
  let F : Set V := X \ {a}
  have haX : a ∈ X := by
    exact q.start_mem_support
  have hFfinite : F.Finite := by
    simpa [F, X] using
      (q.support.finite_toSet.sdiff :
        ({x | x ∈ q.support} \ ({a} : Set V)).Finite)
  have hFsub : F ⊆ T \ {a} := by
    intro x hx
    exact ⟨hqT hx.1, hx.2⟩
  have hXeq : ({a} : Set V) ∪ F = X := by
    ext x
    constructor
    · rintro (hxa | hxF)
      · exact Set.mem_singleton_iff.mp hxa ▸ haX
      · exact hxF.1
    · intro hxX
      by_cases hxa : x = a
      · exact Or.inl (Set.mem_singleton_iff.mpr hxa)
      · exact Or.inr ⟨hxX, by simpa using hxa⟩
  apply hno
  refine ⟨b, hbB, q, hq, ?_, ?_⟩
  · intro x hx hxA
    exact hT.2.1 x (hqT hx) hxA
  · simpa [X, hXeq] using hT.2.2.2 F hFfinite hFsub

/-- Every non-source boundary vertex of a maximal safe rooted set has a
finite critical-deletion certificate.  More precisely, after deleting the
root and finitely many old tree vertices there is a total wave whose terminal
set contains that boundary vertex.  This is the formal boundary-certificate
step in Section 6. -/
theorem MaximalSafeRootSet.exists_boundary_totalWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a y : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (hyBoundary : y ∈ outerBoundary G T) (hyA : y ∉ A) :
    ∃ F : Set V, F.Finite ∧ F ⊆ T \ {a} ∧
      ∃ Z : TotalWave
          (outsideGraph G ({a} ∪ F))
          (A \ ({a} ∪ F)) (B \ ({a} ∪ F)),
        y ∈ Z.toWarp.terminalSet := by
  classical
  rcases hyBoundary with ⟨hyT, x, hxT, hxy⟩
  have hrootInsert : a ∈ insert y T := Or.inr hT.prop.1
  have hsourceInsert : ∀ z ∈ insert y T, z ∈ A → z = a := by
    rintro z (rfl | hzT) hzA
    · exact (hyA hzA).elim
    · exact hT.prop.2.1 z hzT hzA
  have hconnectedInsert : ∀ z ∈ insert y T, ∃ q : G.Walk a z,
      q.IsPath ∧ {v | v ∈ q.support} ⊆ insert y T := by
    rintro z (hzy | hzT)
    · subst z
      rcases hT.prop.2.2.1 x hxT with ⟨q, hq, hqT⟩
      have hyq : y ∉ q.support := by
        intro hyq
        exact hyT (hqT hyq)
      refine ⟨q.concat hxy, hq.concat hyq hxy, ?_⟩
      intro v hv
      rw [Walk.support_concat] at hv
      rcases List.mem_append.mp hv with hvq | hvy
      · exact Or.inr (hqT hvq)
      · exact Or.inl (List.mem_singleton.mp hvy)
    · rcases hT.prop.2.2.1 z hzT with ⟨q, hq, hqT⟩
      exact ⟨q, hq, fun v hv => Or.inr (hqT hv)⟩
  have hnotInsert : ¬ IsSafeRootSet G A B a (insert y T) :=
    hT.not_prop_of_ssuperset (Set.ssubset_insert hyT)
  have hnotInvariant : ¬ ∀ F : Set V, F.Finite →
      F ⊆ insert y T \ {a} →
      IsCleanUnhindered (outsideGraph G ({a} ∪ F))
        (A \ ({a} ∪ F)) (B \ ({a} ∪ F)) := by
    intro hinvariant
    exact hnotInsert
      ⟨hrootInsert, hsourceInsert, hconnectedInsert, hinvariant⟩
  push Not at hnotInvariant
  rcases hnotInvariant with ⟨F, hFfinite, hFsub, hFbad⟩
  have hyF : y ∈ F := by
    by_contra hyF
    have hFT : F ⊆ T \ {a} := by
      intro z hzF
      have hz := hFsub hzF
      rcases hz.1 with hzy | hzT
      · exact (hyF (hzy ▸ hzF)).elim
      · exact ⟨hzT, hz.2⟩
    exact hFbad (hT.prop.2.2.2 F hFfinite hFT)
  let F₀ : Set V := F \ {y}
  have hF₀finite : F₀.Finite := by
    exact hFfinite.sdiff
  have hF₀sub : F₀ ⊆ T \ {a} := by
    intro z hzF₀
    have hz := hFsub hzF₀.1
    rcases hz.1 with hzy | hzT
    · exact (hzF₀.2 (Set.mem_singleton_iff.mpr hzy)).elim
    · exact ⟨hzT, hz.2⟩
  have hdeleteSet : (({a} : Set V) ∪ F₀) ∪ {y} = {a} ∪ F := by
    ext z
    simp only [Set.mem_union, Set.mem_singleton_iff, F₀, Set.mem_diff]
    constructor
    · rintro ((hza | ⟨hzF, -⟩) | hzy)
      · exact Or.inl hza
      · exact Or.inr hzF
      · exact Or.inr (hzy ▸ hyF)
    · rintro (hza | hzF)
      · exact Or.inl (Or.inl hza)
      · by_cases hzy : z = y
        · exact Or.inr hzy
        · exact Or.inl (Or.inr ⟨hzF, by simpa using hzy⟩)
  have hbase : IsCleanUnhindered
      (outsideGraph G ({a} ∪ F₀))
      (A \ ({a} ∪ F₀)) (B \ ({a} ∪ F₀)) :=
    hT.prop.2.2.2 F₀ hF₀finite hF₀sub
  have hyResidual : y ∉ A \ (({a} : Set V) ∪ F₀) := by
    exact fun hy => hyA hy.1
  have hdelete : ¬ IsCleanUnhindered
      (outsideGraph (outsideGraph G ({a} ∪ F₀)) {y})
      ((A \ ({a} ∪ F₀)) \ {y})
      ((B \ ({a} ∪ F₀)) \ {y}) := by
    simpa only [outsideGraph_outsideGraph, Set.sdiff_sdiff,
      hdeleteSet] using hFbad
  rcases TotalWave.exists_totalWave_terminal_of_delete_not_isCleanUnhindered
      hbase hyResidual hdelete with ⟨Z, hyZ⟩
  exact ⟨F₀, hF₀finite, hF₀sub, Z, hyZ⟩

/-- The boundary certificate can be chosen for every boundary vertex.  A
boundary vertex that is itself an old source needs no finite tree deletion:
after deleting only the root, its singleton component in the trivial total
wave is already a terminal. -/
theorem MaximalSafeRootSet.exists_boundary_totalWave_all {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a y : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (hyBoundary : y ∈ outerBoundary G T) :
    ∃ F : Set V, F.Finite ∧ F ⊆ T \ {a} ∧
      ∃ Z : TotalWave
          (outsideGraph G ({a} ∪ F))
          (A \ ({a} ∪ F)) (B \ ({a} ∪ F)),
        y ∈ Z.toWarp.terminalSet := by
  classical
  by_cases hyA : y ∈ A
  · have hya : y ≠ a := by
      intro hya
      subst y
      exact hyBoundary.1 hT.prop.1
    refine ⟨∅, Set.finite_empty, by simp, ?_⟩
    let D : Set V := ({a} : Set V) ∪ ∅
    let R : Set V := A \ D
    let C : Set V := B \ D
    let Z : TotalWave (outsideGraph G D) R C :=
      WaveExtension.base (trivial_isWave (outsideGraph G D) R C)
    refine ⟨Z, ?_⟩
    let i : R := ⟨y, hyA, by simpa [D] using hya⟩
    refine ⟨i, ?_⟩
    change (Z.path i).1.terminal? = some y
    simp [Z, WaveExtension.base, i, R, trivial, LongPath.toNormalized]
  · exact MaximalSafeRootSet.exists_boundary_totalWave hT hyBoundary hyA

/-- A packaged finite-deletion certificate for one boundary vertex of the
maximal safe rooted set. -/
structure BoundaryWaveCertificate {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a y : V) where
  deleted : Set V
  finite_deleted : deleted.Finite
  deleted_subset_tree : deleted ⊆ T \ {a}
  wave : TotalWave
    (outsideGraph G ({a} ∪ deleted))
    (A \ ({a} ∪ deleted)) (B \ ({a} ∪ deleted))
  terminal_mem : y ∈ wave.toWarp.terminalSet

/-- Every outer-boundary vertex admits a packaged certificate. -/
theorem MaximalSafeRootSet.exists_boundaryWaveCertificate {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a y : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (hyBoundary : y ∈ outerBoundary G T) :
    Nonempty (BoundaryWaveCertificate G A B T a y) := by
  rcases MaximalSafeRootSet.exists_boundary_totalWave_all hT hyBoundary with
    ⟨F, hFfinite, hFsub, Z, hyZ⟩
  exact ⟨⟨F, hFfinite, hFsub, Z, hyZ⟩⟩

/-- A fixed certificate for a boundary vertex.  The subtype index records the
boundary hypothesis so no arbitrary default wave is needed. -/
noncomputable def boundaryWaveCertificate {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : BoundaryWaveCertificate G A B T a y :=
  Classical.choice <|
    MaximalSafeRootSet.exists_boundaryWaveCertificate hT y.property

/-- The finite-set-valued certificate function used by the closing recursion;
off the boundary it is empty. -/
noncomputable def boundaryCertificateSet {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (y : V) : Set V := by
  classical
  exact if hy : y ∈ outerBoundary G T then
      (boundaryWaveCertificate hT ⟨y, hy⟩).deleted
    else ∅

theorem boundaryCertificateSet_finite {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (y : V) :
    (boundaryCertificateSet hT y).Finite := by
  classical
  by_cases hy : y ∈ outerBoundary G T
  · simpa [boundaryCertificateSet, hy] using
      (boundaryWaveCertificate hT ⟨y, hy⟩).finite_deleted
  · simp [boundaryCertificateSet, hy]

theorem boundaryCertificateSet_subset_tree {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a y : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (hy : y ∈ outerBoundary G T) :
    boundaryCertificateSet hT y ⊆ T \ {a} := by
  classical
  simpa [boundaryCertificateSet, hy] using
    (boundaryWaveCertificate hT ⟨y, hy⟩).deleted_subset_tree

/-- The fixed finite set really carries a total wave terminating at the
corresponding boundary vertex. -/
theorem boundaryCertificateSet_has_totalWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a y : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (hy : y ∈ outerBoundary G T) :
    ∃ Z : TotalWave
        (outsideGraph G ({a} ∪ boundaryCertificateSet hT y))
        (A \ ({a} ∪ boundaryCertificateSet hT y))
        (B \ ({a} ∪ boundaryCertificateSet hT y)),
      y ∈ Z.toWarp.terminalSet := by
  classical
  let C := boundaryWaveCertificate hT ⟨y, hy⟩
  have hdeleted : boundaryCertificateSet hT y = C.deleted := by
    simp [boundaryCertificateSet, hy, C]
  rw [hdeleted]
  exact ⟨C.wave, C.terminal_mem⟩

/-- For a boundary vertex which is not a source, deleting that vertex after
its finite boundary certificate produces a clean hindrance.  This is the
one-terminal obstruction fed into finite hindrance deletion in Assertion
6.8. -/
theorem boundaryCertificate_delete_terminal_not_isCleanUnhindered
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a y : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (hy : y ∈ outerBoundary G T) (hyA : y ∉ A) :
    ¬ IsCleanUnhindered
      (outsideGraph
        (outsideGraph (outsideGraph G {a})
          (boundaryCertificateSet hT y)) {y})
      (((A \ {a}) \ boundaryCertificateSet hT y) \ {y})
      (((B \ {a}) \ boundaryCertificateSet hT y) \ {y}) := by
  classical
  rcases boundaryCertificateSet_has_totalWave hT hy with ⟨Z, hyZ⟩
  rcases hyZ with ⟨i, hit⟩
  have hiA : (Z.path i).1.initial ∈
      A \ ({a} ∪ boundaryCertificateSet hT y) := by
    rw [Z.path_initial i]
    exact i.property
  have hine : (Z.path i).1.initial ≠ y := by
    intro hiy
    exact hyA (hiy ▸ hiA.1)
  rw [not_isCleanUnhindered_iff_exists_cleanHindrance]
  rw [show outsideGraph (outsideGraph G {a})
      (boundaryCertificateSet hT y) =
      outsideGraph G ({a} ∪ boundaryCertificateSet hT y) by
    simp [outsideGraph_outsideGraph]]
  simpa [outsideGraph_outsideGraph, Set.sdiff_sdiff,
    Set.union_assoc, Set.union_comm, Set.union_left_comm] using
    Z.isWave.exists_cleanHindrance_deleteTerminal
      Z.isSourceClean i hit hiA hine

/-- A countable quotient certificate witnessing that a tree vertex is
bounded in the sense of Aharoni--Berger Section 6.  The root is already
deleted from the base web, and `vertices` is the paper's set `G_t`. -/
structure BoundedTreeCertificate {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a t : V) where
  vertices : Set V
  countable_vertices : vertices.Countable
  vertices_subset_tree : vertices ⊆ T \ {a}
  wave : Warp (outsideGraph (outsideGraph G {a})
    (interiorRoof (outsideGraph G {a}) (B \ {a}) vertices))
  isWave : wave.IsWave
    (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a}) vertices)
    (B \ {a})
  strictly_roofs : t ∈ interiorRoof
    (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a}) vertices))
    (B \ {a}) wave.terminalSet

/-- A vertex is bounded when it has a countable quotient wave strictly
roofing it. -/
def IsBoundedTreeVertex {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a t : V) : Prop :=
  Nonempty (BoundedTreeCertificate G A B T a t)

/-- The persistent set `Q` consists of the unbounded vertices of the safe
tree. -/
def unboundedTreeVertices {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a : V) : Set V :=
  {t | t ∈ T ∧ ¬ IsBoundedTreeVertex G A B T a t}

/-- Choose the paper's `G_t` for a bounded vertex and use the empty set away
from the bounded part of the tree. -/
noncomputable def boundedCertificateSet {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a t : V) : Set V := by
  classical
  exact if ht : IsBoundedTreeVertex G A B T a t then
      (Classical.choice ht).vertices
    else ∅

theorem boundedCertificateSet_countable {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a t : V) :
    (boundedCertificateSet G A B T a t).Countable := by
  classical
  by_cases ht : IsBoundedTreeVertex G A B T a t
  · simpa [boundedCertificateSet, ht] using
      (Classical.choice ht).countable_vertices
  · simp [boundedCertificateSet, ht]

theorem boundedCertificateSet_subset_tree {V : Type} (G : SimpleGraph V)
    (A B T : Set V) (a t : V) :
    boundedCertificateSet G A B T a t ⊆ T := by
  classical
  by_cases ht : IsBoundedTreeVertex G A B T a t
  · exact (by simpa [boundedCertificateSet, ht] using
      (Classical.choice ht).vertices_subset_tree.trans Set.sdiff_subset)
  · simp [boundedCertificateSet, ht]

theorem boundedCertificateSet_subset_tree_sdiff {V : Type}
    (G : SimpleGraph V) (A B T : Set V) (a t : V) :
    boundedCertificateSet G A B T a t ⊆ T \ {a} := by
  classical
  by_cases ht : IsBoundedTreeVertex G A B T a t
  · simpa [boundedCertificateSet, ht] using
      (Classical.choice ht).vertices_subset_tree
  · simp [boundedCertificateSet, ht]

theorem isBounded_of_mem_tree_not_mem_unbounded {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (htT : t ∈ T) (htQ : t ∉ unboundedTreeVertices G A B T a) :
    IsBoundedTreeVertex G A B T a t := by
  by_contra htBounded
  exact htQ ⟨htT, htBounded⟩

/-- For a tree vertex outside `Q`, the chosen countable set comes with the
strict-roofing quotient wave required in condition (c) of Proposition 6.3. -/
theorem boundedCertificateSet_has_wave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (htT : t ∈ T) (htQ : t ∉ unboundedTreeVertices G A B T a) :
    ∃ W : Warp (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (boundedCertificateSet G A B T a t))),
      W.IsWave
        (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
          (boundedCertificateSet G A B T a t)) (B \ {a}) ∧
      t ∈ interiorRoof
        (outsideGraph (outsideGraph G {a})
          (interiorRoof (outsideGraph G {a}) (B \ {a})
            (boundedCertificateSet G A B T a t)))
        (B \ {a}) W.terminalSet := by
  classical
  have htBounded := isBounded_of_mem_tree_not_mem_unbounded htT htQ
  let C := Classical.choice htBounded
  have hvertices : boundedCertificateSet G A B T a t = C.vertices := by
    simp [boundedCertificateSet, htBounded, C]
  rw [hvertices]
  exact ⟨C.wave, C.isWave, C.strictly_roofs⟩

/-- On a finite member of a wave, every vertex except its own terminal lies
in the strict roof interior. -/
theorem IsWave.path_sdiff_terminal_subset_interiorRoof
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B) {i : W.ι} {t : V}
    (hit : (W.path i).terminal? = some t) :
    (W.path i).vertexSet \ {t} ⊆ interiorRoof G B W.terminalSet := by
  intro x hx
  refine ⟨hW.vertexSet_subset_roof ⟨i, hx.1⟩, ?_⟩
  intro hxEssential
  have hxTerminal : x ∈ W.terminalSet :=
    essentialVertices_subset G B W.terminalSet hxEssential
  rcases hxTerminal with ⟨j, hjx⟩
  by_cases hij : i = j
  · subst j
    have hxt : x = t := Option.some.inj (hjx.symm.trans hit)
    exact hx.2 (by simpa [hxt])
  · have hxj : x ∈ (W.path j).vertexSet :=
      LongPath.terminal_mem_vertexSet hjx
    exact Set.disjoint_left.mp (W.disjoint hij) hx.1 hxj

/-- Every nonterminal vertex of a wave lies in the strict interior of its
terminal roof.  This also covers components which are one-way infinite. -/
theorem IsWave.vertexSet_sdiff_terminalSet_subset_interiorRoof
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B) :
    W.vertexSet \ W.terminalSet ⊆
      interiorRoof G B W.terminalSet := by
  intro x hx
  refine ⟨hW.vertexSet_subset_roof hx.1, ?_⟩
  intro hxEssential
  exact hx.2 (essentialVertices_subset G B W.terminalSet hxEssential)

/-- The roof-order consequence of forward extension (Corollary 3.11).  The
stated hypothesis is only the vertex-set inclusion supplied by extension. -/
theorem IsWave.roofLE_of_vertexSet_subset {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {A B : Set V} (hW : W.IsWave A B)
    (hUW : U.vertexSet ⊆ W.vertexSet) : RoofLE B U W := by
  have hterminal : U.terminalSet ⊆ roof G B W.terminalSet := by
    intro v hv
    exact hW.vertexSet_subset_roof (hUW (U.terminalSet_subset_vertexSet hv))
  intro v hv
  have : v ∈ roof G B (roof G B W.terminalSet) := roof_mono hterminal hv
  simpa using this

/-- The pointwise direct limit of a linearly ordered forward chain of waves
with fixed path indices is again a wave.  This is the limit-stage principle
behind Aharoni--Berger's transfinite wave construction: Lemma 2.21 preserves
the separator, while persistent terminals survive in the path limit. -/
theorem IsWave.limitOfPathChain {ι κ V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} {A B : Set V} (P : ι → κ → LongPath G)
    (hchain : ∀ a ⦃i j⦄, i ≤ j → (P i a).Forward (P j a))
    (hdisjoint : ∀ i, Pairwise fun a b =>
      Disjoint (P i a).vertexSet (P i b).vertexSet)
    (hW : ∀ i, (ofPaths (P i) (hdisjoint i)).IsWave A B) :
    (limitOfPaths P hchain hdisjoint).IsWave A B := by
  classical
  let T : ι → Set V := fun i =>
    {v | ∃ a, (P i a).terminal? = some v}
  constructor
  · rintro v ⟨a, rfl⟩
    let i₀ : ι := Classical.choice inferInstance
    have hzero : longPathActive (P i₀ a).terminalIndex 0 := by
      cases (P i₀ a).terminalIndex <;> simp [longPathActive]
    have hforward := path_forward_limitOfPaths P hchain hdisjoint i₀ a 0 hzero
    have hstart : (P i₀ a).initial ∈ A := (hW i₀).1 ⟨a, rfl⟩
    change ((limitOfPaths P hchain hdisjoint).path a).vertex 0 ∈ A
    change (P i₀ a).vertex 0 ∈ A at hstart
    rw [hforward.2]
    exact hstart
  · apply separates_iff_subset_roof.mpr
    have hroofChain : ∀ ⦃i j⦄, i < j → T i ⊆ roof G B (T j) := by
      intro i j hij v hv
      rcases hv with ⟨a, ha⟩
      rcases LongPath.terminal_mem_vertexSet ha with ⟨n, hn, hnv⟩
      have hforward := hchain a hij.le n hn
      have hvj : v ∈ (ofPaths (P j) (hdisjoint j)).vertexSet :=
        ⟨a, n, hforward.1, hforward.2.trans hnv⟩
      exact (hW j).vertexSet_subset_roof hvj
    have hliminf : orderLiminf T ⊆
        (limitOfPaths P hchain hdisjoint).terminalSet := by
      simpa [T] using
        orderLiminf_terminalSet_subset_limitOfPaths P hchain hdisjoint
    intro a ha
    let i₀ : ι := Classical.choice inferInstance
    have haStage : a ∈ roof G B (T i₀) := by
      have := separates_iff_subset_roof.mp (hW i₀).2 ha
      simpa [T, ofPaths, terminalSet] using this
    have haUnion : a ∈ ⋃ i, roof G B (T i) :=
      Set.mem_iUnion.mpr ⟨i₀, haStage⟩
    have haLiminf : a ∈ roof G B (orderLiminf T) :=
      iUnion_roof_subset_roof_orderLiminf T hroofChain haUnion
    exact roof_mono hliminf haLiminf

namespace WaveExtension

/-- Every nonempty chain in the normalized forward-extension order has an
upper bound, obtained by the pointwise direct limit. -/
theorem chain_bddAbove {V : Type} {G : SimpleGraph V} {W : Warp G}
    {A B : Set V} (c : Set (WaveExtension W A B))
    (hc : IsChain (· ≤ ·) c) (hne : c.Nonempty) : BddAbove c := by
  classical
  let C := {X : WaveExtension W A B // X ∈ c}
  letI : Nonempty C := Set.nonempty_coe_sort.mpr hne
  letI : LinearOrder C := hc.linearOrder
  let P : C → W.ι → LongPath G := fun X i => (X.1.path i).1
  have hchain : ∀ i ⦃X Y : C⦄, X ≤ Y →
      (P X i).Forward (P Y i) := by
    intro i X Y hXY
    exact hXY i
  have hdisjoint : ∀ X : C, Pairwise fun i j =>
      Disjoint (P X i).vertexSet (P X j).vertexSet := by
    intro X
    exact X.1.disjoint
  have hwave : ∀ X : C,
      (ofPaths (P X) (hdisjoint X)).IsWave A B := by
    intro X
    exact X.1.isWave
  let X₀ : C := Classical.choice inferInstance
  let upper : WaveExtension W A B := {
    path := fun i =>
      ⟨LongPath.limit (fun X => P X i) (hchain i),
        LongPath.isNormalized_limit (fun X => P X i) (hchain i)⟩
    baseForward := by
      intro i
      exact (X₀.1.baseForward i).trans
        (LongPath.forward_limit (fun X => P X i) (hchain i) X₀)
    disjoint := (limitOfPaths P hchain hdisjoint).disjoint
    isWave := IsWave.limitOfPathChain P hchain hdisjoint hwave }
  refine ⟨upper, ?_⟩
  intro X hX i
  let x : C := ⟨X, hX⟩
  exact LongPath.forward_limit (fun Y => P Y i) (hchain i) x

/-- Zorn's lemma supplies a forward-maximal wave extension of every wave. -/
theorem exists_isMax {V : Type} {G : SimpleGraph V} {W : Warp G}
    {A B : Set V} (hW : W.IsWave A B) :
    ∃ X : WaveExtension W A B, IsMax X := by
  letI : Nonempty (WaveExtension W A B) := ⟨base hW⟩
  exact zorn_le_nonempty fun c hc hne => chain_bddAbove c hc hne

end WaveExtension

namespace TotalWave

/-- Zorn's maximal total wave, in the exact representation used by the
alternating-walk lemmas. -/
theorem exists_isMax {V : Type} (G : SimpleGraph V) (A B : Set V) :
    ∃ X : TotalWave G A B, IsMax X := by
  exact WaveExtension.exists_isMax (trivial_isWave G A B)

/-- Transport a total wave along equality of its ambient spanning graph. -/
def castGraph {V : Type} {G H : SimpleGraph V} {A B : Set V}
    (hGH : G = H) (W : TotalWave G A B) : TotalWave H A B := by
  subst H
  exact W

@[simp] theorem terminalSet_castGraph {V : Type}
    {G H : SimpleGraph V} {A B : Set V} (hGH : G = H)
    (W : TotalWave G A B) :
    (castGraph hGH W).toWarp.terminalSet = W.toWarp.terminalSet := by
  subst H
  rfl

@[simp] theorem castGraph_path_terminalIndex {V : Type}
    {G H : SimpleGraph V} {A B : Set V} (hGH : G = H)
    (W : TotalWave G A B) (i : A) :
    ((castGraph hGH W).path i).1.terminalIndex =
      (W.path i).1.terminalIndex := by
  subst H
  rfl

@[simp] theorem castGraph_path_vertex {V : Type}
    {G H : SimpleGraph V} {A B : Set V} (hGH : G = H)
    (W : TotalWave G A B) (i : A) (n : ℕ) :
    ((castGraph hGH W).path i).1.vertex n =
      (W.path i).1.vertex n := by
  subst H
  rfl

/-- Reinterpret a total wave in a further exterior graph when its carrier
and both endpoint sets avoid the new deletion set. -/
noncomputable def toOutsideGraphSame {V : Type} {G : SimpleGraph V}
    {A B D : Set V} (W : TotalWave G A B)
    (hout : Disjoint W.toWarp.vertexSet D)
    (hAD : Disjoint A D) (hBD : Disjoint B D) :
    TotalWave (outsideGraph G D) A B := by
  let U := W.toWarp.toOutsideGraph hout
  refine {
    path := fun i =>
      ⟨U.path i, by
        exact (W.path i).2⟩
    baseForward := ?_
    disjoint := U.disjoint
    isWave := ?_ }
  · intro i n hn
    have hforward := W.baseForward i n hn
    exact hforward
  · have hU := W.isWave.toOutsideGraph hout
    change U.IsWave A B
    rw [hAD.sdiff_eq_left, hBD.sdiff_eq_left] at hU
    exact hU

@[simp] theorem toOutsideGraphSame_path_terminalIndex {V : Type}
    {G : SimpleGraph V} {A B D : Set V} (W : TotalWave G A B)
    (hout : Disjoint W.toWarp.vertexSet D)
    (hAD : Disjoint A D) (hBD : Disjoint B D) (i : A) :
    ((W.toOutsideGraphSame hout hAD hBD).path i).1.terminalIndex =
      (W.path i).1.terminalIndex := rfl

@[simp] theorem toOutsideGraphSame_path_vertex {V : Type}
    {G : SimpleGraph V} {A B D : Set V} (W : TotalWave G A B)
    (hout : Disjoint W.toWarp.vertexSet D)
    (hAD : Disjoint A D) (hBD : Disjoint B D) (i : A) (n : ℕ) :
    ((W.toOutsideGraphSame hout hAD hBD).path i).1.vertex n =
      (W.path i).1.vertex n := rfl

end TotalWave

/-- A canonical pathwise-maximal total wave in an arbitrary quotient web. -/
noncomputable def maximalQuotientTotalWave {V : Type} (G : SimpleGraph V)
    (A B X : Set V) : QuotientTotalWave G A B X :=
  Classical.choose <| TotalWave.exists_isMax
    (outsideGraph G (interiorRoof G B X))
    (quotientSource G A B X) B

theorem maximalQuotientTotalWave_isMax {V : Type} (G : SimpleGraph V)
    (A B X : Set V) : IsMax (maximalQuotientTotalWave G A B X) :=
  Classical.choose_spec <| TotalWave.exists_isMax
    (outsideGraph G (interiorRoof G B X))
    (quotientSource G A B X) B

/-- Package the chosen bounded certificate together with its strict-roof
property after transporting its certificate set to the canonical choice. -/
noncomputable def boundedCertificateWaveOfBounded {V : Type}
    (G : SimpleGraph V) (A B T : Set V) (a t : V)
    (ht : IsBoundedTreeVertex G A B T a t) :
    {W : Warp (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (boundedCertificateSet G A B T a t))) //
      W.IsWave
        (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
          (boundedCertificateSet G A B T a t)) (B \ {a}) ∧
      t ∈ interiorRoof
        (outsideGraph (outsideGraph G {a})
          (interiorRoof (outsideGraph G {a}) (B \ {a})
            (boundedCertificateSet G A B T a t)))
        (B \ {a}) W.terminalSet} := by
  classical
  let C := Classical.choice ht
  have hvertices : boundedCertificateSet G A B T a t = C.vertices := by
    simp [boundedCertificateSet, ht, C]
  rw [hvertices]
  exact ⟨C.wave, C.isWave, C.strictly_roofs⟩

/-- A canonical quotient wave attached to every potential bounded tree
vertex.  We always choose a pathwise-maximal total wave.  In the bounded
case roof-maximality transfers the strict-roof witness from the original
certificate, while totality gives the source-cleanliness needed by the
later arrow limit. -/
noncomputable def boundedCertificateWave {V : Type}
    (G : SimpleGraph V) (A B T : Set V) (a t : V) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (boundedCertificateSet G A B T a t))) :=
  (maximalQuotientTotalWave (outsideGraph G {a})
    (A \ {a}) (B \ {a}) (boundedCertificateSet G A B T a t)).toWarp

theorem boundedCertificateWave_isWave {V : Type}
    (G : SimpleGraph V) (A B T : Set V) (a t : V) :
    (boundedCertificateWave G A B T a t).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
      (boundedCertificateSet G A B T a t)) (B \ {a}) :=
  (maximalQuotientTotalWave (outsideGraph G {a})
    (A \ {a}) (B \ {a})
    (boundedCertificateSet G A B T a t)).isWave

theorem boundedCertificateWave_isSourceClean {V : Type}
    (G : SimpleGraph V) (A B T : Set V) (a t : V) :
    (boundedCertificateWave G A B T a t).IsSourceClean
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (boundedCertificateSet G A B T a t)) :=
  (maximalQuotientTotalWave (outsideGraph G {a})
    (A \ {a}) (B \ {a})
    (boundedCertificateSet G A B T a t)).isSourceClean

/-- Keys for the countable family of quotient waves used in the causal
closing construction: boundary certificates and bounded-tree certificates. -/
inductive SafeTreeWaveKey (V : Type)
  | boundary (z : V)
  | bounded (t : V)
deriving DecidableEq

namespace SafeTreeWaveKey

noncomputable def certificateSet {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) :
    SafeTreeWaveKey V → Set V
  | .boundary z => boundaryCertificateSet hT z
  | .bounded t => boundedCertificateSet G A B T a t

noncomputable def wave {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (k : SafeTreeWaveKey V) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (k.certificateSet hT))) :=
  match k with
  | .boundary z => (maximalQuotientTotalWave (outsideGraph G {a})
      (A \ {a}) (B \ {a}) (boundaryCertificateSet hT z)).toWarp
  | .bounded t => boundedCertificateWave G A B T a t

theorem wave_isWave {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (k : SafeTreeWaveKey V) :
    (k.wave hT).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (k.certificateSet hT)) (B \ {a}) := by
  cases k with
  | boundary z =>
      exact (maximalQuotientTotalWave (outsideGraph G {a})
        (A \ {a}) (B \ {a}) (boundaryCertificateSet hT z)).isWave
  | bounded t =>
      exact boundedCertificateWave_isWave G A B T a t

theorem wave_isSourceClean {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (k : SafeTreeWaveKey V) :
    (k.wave hT).IsSourceClean
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (k.certificateSet hT)) := by
  cases k with
  | boundary z =>
      exact (maximalQuotientTotalWave (outsideGraph G {a})
        (A \ {a}) (B \ {a}) (boundaryCertificateSet hT z)).isSourceClean
  | bounded t =>
      exact boundedCertificateWave_isSourceClean G A B T a t

/-- Regard a certificate quotient wave in the common web with only the root
deleted.  Vertex sets are unchanged by this spanning-subgraph inclusion. -/
noncomputable def ambientWarp {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (k : SafeTreeWaveKey V) :
    Warp (outsideGraph G {a}) :=
  (k.wave hT).mapLE
    (outsideGraph_le (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (k.certificateSet hT)))

theorem certificateSet_countable {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T) (k : SafeTreeWaveKey V) :
    (k.certificateSet hT).Countable := by
  cases k with
  | boundary z =>
      exact (boundaryCertificateSet_finite hT z).countable
  | bounded t =>
      exact boundedCertificateSet_countable G A B T a t

end SafeTreeWaveKey

/-- Certificate-wave keys relevant at one causal closing stage.  The
distinguished boundary key is always retained; other boundary keys are
activated by the current causal vertex set, and bounded keys by the current
quotienting set. -/
def safeTreeCausalKeys {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (X R : Set V) : Set (SafeTreeWaveKey V) :=
  {SafeTreeWaveKey.boundary y.1} ∪
    SafeTreeWaveKey.boundary '' (outerBoundary G T ∩ R) ∪
    SafeTreeWaveKey.bounded ''
      (X \ unboundedTreeVertices G A B T a)

theorem safeTreeCausalKeys_countable {V : Type} {G : SimpleGraph V}
    {A B T X R : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hX : X.Countable) (hR : R.Countable) :
    (safeTreeCausalKeys hT y X R).Countable := by
  unfold safeTreeCausalKeys
  exact ((Set.countable_singleton (SafeTreeWaveKey.boundary y.1)).union
    ((hR.mono Set.inter_subset_right).image _)).union
    ((hX.mono Set.sdiff_subset).image _)

theorem safeTreeCausalKeys_mono {V : Type} {G : SimpleGraph V}
    {A B T X X' R R' : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hXX' : X ⊆ X') (hRR' : R ⊆ R') :
    safeTreeCausalKeys hT y X R ⊆ safeTreeCausalKeys hT y X' R' := by
  intro k hk
  rcases hk with (hk | hk) | hk
  · exact Or.inl <| Or.inl hk
  · exact Or.inl <| Or.inr <| Set.image_mono
      (Set.inter_subset_inter_right _ hRR') hk
  · exact Or.inr <| Set.image_mono
      (Set.sdiff_subset_sdiff hXX' (Set.Subset.rfl)) hk

/-- One step of the causal countable closure.  `X` is the quotienting set;
`R` records all vertices causally connected to `X` along every currently
relevant certificate wave. -/
noncomputable def safeTreeCausalStep {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (s : Set V × Set V) : Set V × Set V :=
  let K := safeTreeCausalKeys hT y s.1 s.2
  let X' := s.1 ∪ (⋃ k ∈ K,
    SafeTreeWaveKey.certificateSet hT k) ∪ (s.2 ∩ (T \ {a}))
  let R' := s.2 ∪ X' ∪ ⋃ k ∈ K,
    ((SafeTreeWaveKey.ambientWarp hT k).meeting s.2).vertexSet
  (X', R')

noncomputable def safeTreeCausalStages {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : ℕ → Set V × Set V
  | 0 => (boundaryCertificateSet hT y.1,
      boundaryCertificateSet hT y.1)
  | n + 1 => safeTreeCausalStep hT y (safeTreeCausalStages hT y n)

noncomputable def safeTreeCausalX {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) : Set V :=
  (safeTreeCausalStages hT y n).1

noncomputable def safeTreeCausalR {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) : Set V :=
  (safeTreeCausalStages hT y n).2

noncomputable def safeTreeCausalXLimit {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : Set V :=
  ⋃ n, safeTreeCausalX hT y n

noncomputable def safeTreeCausalRLimit {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : Set V :=
  ⋃ n, safeTreeCausalR hT y n

@[simp] theorem safeTreeCausalX_zero {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeCausalX hT y 0 = boundaryCertificateSet hT y.1 := rfl

@[simp] theorem safeTreeCausalR_zero {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeCausalR hT y 0 = boundaryCertificateSet hT y.1 := rfl

@[simp] theorem safeTreeCausalX_succ {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeCausalX hT y (n + 1) =
      safeTreeCausalX hT y n ∪ (⋃ k ∈ safeTreeCausalKeys hT y
          (safeTreeCausalX hT y n) (safeTreeCausalR hT y n),
          SafeTreeWaveKey.certificateSet hT k) ∪
        (safeTreeCausalR hT y n ∩ (T \ {a})) := rfl

@[simp] theorem safeTreeCausalR_succ {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeCausalR hT y (n + 1) =
      safeTreeCausalR hT y n ∪ safeTreeCausalX hT y (n + 1) ∪
        ⋃ k ∈ safeTreeCausalKeys hT y
          (safeTreeCausalX hT y n) (safeTreeCausalR hT y n),
          ((SafeTreeWaveKey.ambientWarp hT k).meeting
            (safeTreeCausalR hT y n)).vertexSet := rfl

theorem safeTreeCausalX_subset_succ {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeCausalX hT y n ⊆ safeTreeCausalX hT y (n + 1) := by
  rw [safeTreeCausalX_succ]
  exact Set.subset_union_left.trans Set.subset_union_left

theorem safeTreeCausalR_subset_succ {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeCausalR hT y n ⊆ safeTreeCausalR hT y (n + 1) := by
  rw [safeTreeCausalR_succ]
  exact Set.subset_union_left.trans Set.subset_union_left

theorem safeTreeCausalX_mono {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Monotone (safeTreeCausalX hT y) :=
  monotone_nat_of_le_succ (safeTreeCausalX_subset_succ hT y)

theorem safeTreeCausalR_mono {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Monotone (safeTreeCausalR hT y) :=
  monotone_nat_of_le_succ (safeTreeCausalR_subset_succ hT y)

theorem safeTreeCausalX_subset_R {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ∀ n, safeTreeCausalX hT y n ⊆ safeTreeCausalR hT y n := by
  intro n
  cases n with
  | zero => exact Set.Subset.rfl
  | succ n =>
      rw [safeTreeCausalR_succ]
      exact Set.subset_union_right.trans Set.subset_union_left

theorem safeTreeCausalStages_countable {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ∀ n, (safeTreeCausalX hT y n).Countable ∧
      (safeTreeCausalR hT y n).Countable := by
  intro n
  induction n with
  | zero =>
      have h := (boundaryCertificateSet_finite hT y.1).countable
      exact ⟨by simpa using h, by simpa using h⟩
  | succ n ih =>
      let K := safeTreeCausalKeys hT y
        (safeTreeCausalX hT y n) (safeTreeCausalR hT y n)
      have hK : K.Countable := safeTreeCausalKeys_countable
        hT y ih.1 ih.2
      have hCert : (⋃ k ∈ K,
          SafeTreeWaveKey.certificateSet hT k).Countable := by
        apply hK.biUnion
        intro k _
        exact SafeTreeWaveKey.certificateSet_countable hT k
      have hTree : (safeTreeCausalR hT y n ∩ (T \ {a})).Countable :=
        ih.2.mono Set.inter_subset_left
      have hXnext : (safeTreeCausalX hT y (n + 1)).Countable := by
        rw [safeTreeCausalX_succ]
        exact (ih.1.union hCert).union hTree
      have hMeet : (⋃ k ∈ K,
          ((SafeTreeWaveKey.ambientWarp hT k).meeting
            (safeTreeCausalR hT y n)).vertexSet).Countable := by
        apply hK.biUnion
        intro k _
        exact (SafeTreeWaveKey.ambientWarp hT k).vertexSet_meeting_countable
          ih.2
      refine ⟨hXnext, ?_⟩
      rw [safeTreeCausalR_succ]
      exact (ih.2.union hXnext).union hMeet

theorem safeTreeCausalXLimit_countable {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalXLimit hT y).Countable := by
  unfold safeTreeCausalXLimit
  exact Set.countable_iUnion fun n => (safeTreeCausalStages_countable hT y n).1

theorem safeTreeCausalRLimit_countable {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalRLimit hT y).Countable := by
  unfold safeTreeCausalRLimit
  exact Set.countable_iUnion fun n => (safeTreeCausalStages_countable hT y n).2

theorem safeTreeCausalXLimit_subset_RLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeCausalXLimit hT y ⊆ safeTreeCausalRLimit hT y := by
  rintro x hx
  rcases Set.mem_iUnion.mp hx with ⟨n, hxn⟩
  exact Set.mem_iUnion.mpr ⟨n, safeTreeCausalX_subset_R hT y n hxn⟩

theorem SafeTreeWaveKey.certificateSet_subset_tree_sdiff_of_mem_causalKeys
    {V : Type} {G : SimpleGraph V} {A B T X R : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) {k : SafeTreeWaveKey V}
    (hk : k ∈ safeTreeCausalKeys hT y X R) :
    k.certificateSet hT ⊆ T \ {a} := by
  rcases hk with (hk | hk) | hk
  · have hky : k = SafeTreeWaveKey.boundary y.1 :=
      Set.mem_singleton_iff.mp hk
    subst k
    exact boundaryCertificateSet_subset_tree hT y.property
  · rcases hk with ⟨z, hz, rfl⟩
    exact boundaryCertificateSet_subset_tree hT hz.1
  · rcases hk with ⟨t, _ht, rfl⟩
    exact boundedCertificateSet_subset_tree_sdiff G A B T a t

theorem safeTreeCausalX_subset_tree_sdiff {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ∀ n, safeTreeCausalX hT y n ⊆ T \ {a} := by
  intro n
  induction n with
  | zero =>
      simpa using boundaryCertificateSet_subset_tree hT y.property
  | succ n ih =>
      rw [safeTreeCausalX_succ]
      refine Set.union_subset (Set.union_subset ih ?_) Set.inter_subset_right
      rintro x hx
      rcases Set.mem_iUnion.mp hx with ⟨k, hx⟩
      rcases Set.mem_iUnion.mp hx with ⟨hk, hxCert⟩
      exact SafeTreeWaveKey.certificateSet_subset_tree_sdiff_of_mem_causalKeys
        hT y hk hxCert

theorem safeTreeCausalXLimit_subset_tree_sdiff {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeCausalXLimit hT y ⊆ T \ {a} := by
  rintro x hx
  rcases Set.mem_iUnion.mp hx with ⟨n, hxn⟩
  exact safeTreeCausalX_subset_tree_sdiff hT y n hxn

theorem safeTreeCausalX_subset_limit {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeCausalX hT y n ⊆ safeTreeCausalXLimit hT y :=
  fun _ hx => Set.mem_iUnion.mpr ⟨n, hx⟩

theorem safeTreeCausalR_subset_limit {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeCausalR hT y n ⊆ safeTreeCausalRLimit hT y :=
  fun _ hx => Set.mem_iUnion.mpr ⟨n, hx⟩

theorem safeTreeCausalKey_certificate_subset_succ {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) {k : SafeTreeWaveKey V}
    (hk : k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalX hT y n) (safeTreeCausalR hT y n)) :
    k.certificateSet hT ⊆ safeTreeCausalX hT y (n + 1) := by
  intro x hx
  rw [safeTreeCausalX_succ]
  exact Or.inl <| Or.inr <| Set.mem_iUnion.mpr
    ⟨k, Set.mem_iUnion.mpr ⟨hk, hx⟩⟩

/-- Every key relevant for the two final causal unions was already relevant
at a finite stage. -/
theorem safeTreeCausalKey_mem_stage {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) {k : SafeTreeWaveKey V}
    (hk : k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y)) :
    ∃ n, k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalX hT y n) (safeTreeCausalR hT y n) := by
  rcases hk with (hk | hk) | hk
  · refine ⟨0, Or.inl <| Or.inl hk⟩
  · rcases hk with ⟨z, ⟨hzY, hzR⟩, rfl⟩
    rcases Set.mem_iUnion.mp hzR with ⟨n, hzn⟩
    refine ⟨n, Or.inl <| Or.inr ?_⟩
    exact ⟨z, ⟨hzY, hzn⟩, rfl⟩
  · rcases hk with ⟨t, ⟨htX, htQ⟩, rfl⟩
    rcases Set.mem_iUnion.mp htX with ⟨n, htn⟩
    refine ⟨n, Or.inr ?_⟩
    exact ⟨t, ⟨htn, htQ⟩, rfl⟩

theorem safeTreeCausalKey_certificate_subset_limit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) {k : SafeTreeWaveKey V}
    (hk : k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y)) :
    k.certificateSet hT ⊆ safeTreeCausalXLimit hT y := by
  rcases safeTreeCausalKey_mem_stage hT y hk with ⟨n, hkn⟩
  exact (safeTreeCausalKey_certificate_subset_succ hT y n hkn).trans
    (safeTreeCausalX_subset_limit hT y (n + 1))

/-- At the causal limit every relevant ambient certificate warp is closed
under the final active vertex set. -/
theorem safeTreeCausalKey_ambientWarp_isClosedOn {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) {k : SafeTreeWaveKey V}
    (hk : k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y)) :
    (SafeTreeWaveKey.ambientWarp hT k).IsClosedOn
      (safeTreeCausalRLimit hT y) := by
  apply Warp.isClosedOn_of_path_subset
  intro i hmeet v hv
  rcases hmeet with ⟨x, hxi, hxR⟩
  rcases Set.mem_iUnion.mp hxR with ⟨n, hxn⟩
  rcases safeTreeCausalKey_mem_stage hT y hk with ⟨m, hkm⟩
  let l := max n m
  have hnl : n ≤ l := le_max_left n m
  have hml : m ≤ l := le_max_right n m
  have hkl : k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalX hT y l) (safeTreeCausalR hT y l) := by
    exact safeTreeCausalKeys_mono hT y
      (safeTreeCausalX_mono hT y hml)
      (safeTreeCausalR_mono hT y hml) hkm
  have hxl : x ∈ safeTreeCausalR hT y l :=
    safeTreeCausalR_mono hT y hnl hxn
  have hvMeet : v ∈
      ((SafeTreeWaveKey.ambientWarp hT k).meeting
        (safeTreeCausalR hT y l)).vertexSet := by
    rw [Warp.meeting, Warp.vertexSet_restrictIndices]
    exact ⟨i, ⟨x, hxi, hxl⟩, hv⟩
  have hvNext : v ∈ safeTreeCausalR hT y (l + 1) := by
    rw [safeTreeCausalR_succ]
    exact Or.inr <| Set.mem_iUnion.mpr
      ⟨k, Set.mem_iUnion.mpr ⟨hkl, hvMeet⟩⟩
  exact safeTreeCausalR_subset_limit hT y (l + 1) hvNext

/-- The final countable set of causal certificate-wave keys. -/
def SafeTreeCausalFinalKey {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :=
  {k : SafeTreeWaveKey V // k ∈ safeTreeCausalKeys hT y
    (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y)}

def safeTreeCausalBoundaryKey {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : SafeTreeCausalFinalKey hT y :=
  ⟨SafeTreeWaveKey.boundary y.1,
    Or.inl (Or.inl (Set.mem_singleton _))⟩

theorem safeTreeCausalFinalKeys_countable {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalKeys hT y
      (safeTreeCausalXLimit hT y)
      (safeTreeCausalRLimit hT y)).Countable :=
  safeTreeCausalKeys_countable hT y
    (safeTreeCausalXLimit_countable hT y)
    (safeTreeCausalRLimit_countable hT y)

/-- A surjective natural-number enumeration of the final key family. -/
noncomputable def safeTreeCausalKeyEnumeration {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    {e : ℕ → SafeTreeCausalFinalKey hT y // Function.Surjective e} := by
  letI : Countable (SafeTreeCausalFinalKey hT y) :=
    (safeTreeCausalFinalKeys_countable hT y).to_subtype
  letI : Nonempty (SafeTreeCausalFinalKey hT y) :=
    ⟨safeTreeCausalBoundaryKey hT y⟩
  let h := exists_surjective_nat (SafeTreeCausalFinalKey hT y)
  exact ⟨Classical.choose h, Classical.choose_spec h⟩

/-- Quotient one relevant certificate wave by the full causal closing set,
transporting it into the common final quotient web. -/
noncomputable def safeTreeCausalFinalWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (k : SafeTreeCausalFinalKey hT y) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (safeTreeCausalXLimit hT y))) :=
  Erdos599.Warp.quotientWarpNested (k.1.wave hT)
    (safeTreeCausalKey_certificate_subset_limit hT y k.property)

theorem safeTreeCausalFinalWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (k : SafeTreeCausalFinalKey hT y) :
    (safeTreeCausalFinalWarp hT y k).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y)) (B \ {a}) := by
  unfold safeTreeCausalFinalWarp
  exact (SafeTreeWaveKey.wave_isWave hT k.1).quotientWarpNested
    (safeTreeCausalKey_certificate_subset_limit hT y k.property)

theorem safeTreeCausalFinalWarp_isSourceClean {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (k : SafeTreeCausalFinalKey hT y) :
    (safeTreeCausalFinalWarp hT y k).IsSourceClean
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y)) := by
  unfold safeTreeCausalFinalWarp
  exact (SafeTreeWaveKey.wave_isSourceClean hT k.1).quotientWarpNested
    (safeTreeCausalKey_certificate_subset_limit hT y k.property)

theorem safeTreeCausalFinalWarp_isClosedOn {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (k : SafeTreeCausalFinalKey hT y) :
    (safeTreeCausalFinalWarp hT y k).IsClosedOn
      (safeTreeCausalRLimit hT y) := by
  unfold safeTreeCausalFinalWarp
  apply Warp.IsClosedOn.quotientWarpNested
  · apply Warp.IsClosedOn.of_mapLE
      (outsideGraph_le (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (k.1.certificateSet hT)))
    exact safeTreeCausalKey_ambientWarp_isClosedOn hT y k.property
  · exact safeTreeCausalXLimit_subset_RLimit hT y

/-- Put the distinguished boundary wave first, then enumerate every final
relevant key.  Repetitions are harmless and make the indexing total. -/
noncomputable def safeTreeCausalWaveSequence {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : ℕ →
      Warp (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
  | 0 => safeTreeCausalFinalWarp hT y (safeTreeCausalBoundaryKey hT y)
  | n + 1 => safeTreeCausalFinalWarp hT y
      ((safeTreeCausalKeyEnumeration hT y).1 n)

theorem safeTreeCausalWaveSequence_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : ∀ n,
    (safeTreeCausalWaveSequence hT y n).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y)) (B \ {a}) := by
  intro n
  cases n with
  | zero => exact safeTreeCausalFinalWarp_isWave hT y _
  | succ n => exact safeTreeCausalFinalWarp_isWave hT y _

theorem safeTreeCausalWaveSequence_isSourceClean {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : ∀ n,
    (safeTreeCausalWaveSequence hT y n).IsSourceClean
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y)) := by
  intro n
  cases n with
  | zero => exact safeTreeCausalFinalWarp_isSourceClean hT y _
  | succ n => exact safeTreeCausalFinalWarp_isSourceClean hT y _

theorem safeTreeCausalWaveSequence_isClosedOn {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : ∀ n,
    (safeTreeCausalWaveSequence hT y n).IsClosedOn
      (safeTreeCausalRLimit hT y) := by
  intro n
  cases n with
  | zero => exact safeTreeCausalFinalWarp_isClosedOn hT y _
  | succ n => exact safeTreeCausalFinalWarp_isClosedOn hT y _

/-- A quotient warp in a web that already deletes `a` cannot acquire `a`,
provided neither the surviving old sources nor the quotienting set contains
it.  This rules out the isolated-singleton corner case by inspecting the
exact quotient source. -/
theorem QuotientTotalWave.not_mem_vertexSet_of_base_deleted {V : Type}
    {G : SimpleGraph V} {A B X : Set V} {a : V}
    (W : QuotientTotalWave (outsideGraph G {a}) A B X)
    (haA : a ∉ A) (haX : a ∉ X) : a ∉ W.toWarp.vertexSet := by
  rintro ⟨i, hai⟩
  have hiSource : (W.path i).1.initial ∈
      quotientSource (outsideGraph G {a}) A B X := by
    have hiInitial : (W.path i).1.initial ∈ W.toWarp.initialSet := ⟨i, rfl⟩
    rw [TotalWave.initialSet_toWarp] at hiInitial
    exact hiInitial
  have hia : (W.path i).1.initial ≠ a := by
    intro hia
    have haUnion : a ∈ A ∪ X := by
      simpa [hia] using hiSource.1
    exact haUnion.elim haA haX
  let p : LongPath (outsideGraph G {a}) :=
    (W.path i).1.mapLE
      (outsideGraph_le (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) B X))
  have hap : a ∉ p.vertexSet := by
    intro hap
    exact (p.vertex_not_mem_of_outsideGraph (by simpa [p] using hia) hap)
      (Set.mem_singleton a)
  change a ∈ (W.path i).1.vertexSet at hai
  exact hap hai

/-- The natural-number closing-up recursion from Section 6.  At stage `n`
we take a maximal total wave in the quotient by the current countable set and
apply `quotientClosingStep`. -/
noncomputable def quotientClosingSequence {V : Type} (G : SimpleGraph V)
    (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) : ℕ → Set V :=
  Nat.rec X₀ fun _ X =>
    quotientClosingStep T Y Q X (maximalQuotientTotalWave G A B X)
      boundaryCertificate boundedCertificate

@[simp] theorem quotientClosingSequence_zero {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) :
    quotientClosingSequence G A B T Y Q X₀
      boundaryCertificate boundedCertificate 0 = X₀ := rfl

@[simp] theorem quotientClosingSequence_succ {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) :
    quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate (n + 1) =
      quotientClosingStep T Y Q
        (quotientClosingSequence G A B T Y Q X₀
          boundaryCertificate boundedCertificate n)
        (maximalQuotientTotalWave G A B
          (quotientClosingSequence G A B T Y Q X₀
            boundaryCertificate boundedCertificate n))
        boundaryCertificate boundedCertificate := rfl

theorem quotientClosingSequence_subset_succ {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) :
    quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n ⊆
      quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate (n + 1) := by
  rw [quotientClosingSequence_succ]
  unfold quotientClosingStep
  intro x hx
  exact Or.inl (Or.inl (Or.inl hx))

theorem quotientClosingSequence_monotone {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) :
    Monotone (quotientClosingSequence G A B T Y Q X₀
      boundaryCertificate boundedCertificate) := by
  apply monotone_nat_of_le_succ
  exact quotientClosingSequence_subset_succ G A B T Y Q X₀
    boundaryCertificate boundedCertificate

theorem quotientClosingSequence_countable {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V)
    (hX₀ : X₀.Countable)
    (hboundary : ∀ z ∈ Y, (boundaryCertificate z).Finite)
    (hbounded : ∀ t, (boundedCertificate t).Countable) :
    ∀ n, (quotientClosingSequence G A B T Y Q X₀
      boundaryCertificate boundedCertificate n).Countable := by
  intro n
  induction n with
  | zero => simpa using hX₀
  | succ n ih =>
      rw [show n + 1 = Nat.succ n by omega,
        ← Nat.add_one, quotientClosingSequence_succ]
      exact quotientClosingStep_countable
        (maximalQuotientTotalWave G A B
          (quotientClosingSequence G A B T Y Q X₀
            boundaryCertificate boundedCertificate n))
        boundaryCertificate boundedCertificate ih hboundary hbounded

theorem quotientClosingSequence_subset_tree {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V)
    (hX₀ : X₀ ⊆ T)
    (hboundary : ∀ z ∈ Y, boundaryCertificate z ⊆ T)
    (hbounded : ∀ t, boundedCertificate t ⊆ T) :
    ∀ n, quotientClosingSequence G A B T Y Q X₀
      boundaryCertificate boundedCertificate n ⊆ T := by
  intro n
  induction n with
  | zero => simpa using hX₀
  | succ n ih =>
      rw [show n + 1 = Nat.succ n by omega,
        ← Nat.add_one, quotientClosingSequence_succ]
      exact quotientClosingStep_subset_tree
        (maximalQuotientTotalWave G A B
          (quotientClosingSequence G A B T Y Q X₀
            boundaryCertificate boundedCertificate n))
        boundaryCertificate boundedCertificate ih hboundary hbounded

/-- The union of all finite closing stages. -/
def quotientClosingLimit {V : Type} (G : SimpleGraph V)
    (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) : Set V :=
  ⋃ n, quotientClosingSequence G A B T Y Q X₀
    boundaryCertificate boundedCertificate n

theorem quotientClosingLimit_countable {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V)
    (hX₀ : X₀.Countable)
    (hboundary : ∀ z ∈ Y, (boundaryCertificate z).Finite)
    (hbounded : ∀ t, (boundedCertificate t).Countable) :
    (quotientClosingLimit G A B T Y Q X₀
      boundaryCertificate boundedCertificate).Countable := by
  apply Set.countable_iUnion
  exact quotientClosingSequence_countable G A B T Y Q X₀
    boundaryCertificate boundedCertificate hX₀ hboundary hbounded

theorem quotientClosingLimit_subset_tree {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V)
    (hX₀ : X₀ ⊆ T)
    (hboundary : ∀ z ∈ Y, boundaryCertificate z ⊆ T)
    (hbounded : ∀ t, boundedCertificate t ⊆ T) :
    quotientClosingLimit G A B T Y Q X₀
      boundaryCertificate boundedCertificate ⊆ T := by
  rintro x hx
  rcases Set.mem_iUnion.mp hx with ⟨n, hxn⟩
  exact quotientClosingSequence_subset_tree G A B T Y Q X₀
    boundaryCertificate boundedCertificate hX₀ hboundary hbounded n hxn

theorem quotientClosingSequence_subset_limit {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) :
    quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n ⊆
      quotientClosingLimit G A B T Y Q X₀
        boundaryCertificate boundedCertificate := by
  exact Set.subset_iUnion _ n

/-- Every finite boundary certificate requested at stage `n` is present at
stage `n + 1`. -/
theorem boundaryCertificate_subset_quotientClosingSequence_succ {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) {z : V}
    (hz : z ∈ Y ∩
      ((maximalQuotientTotalWave G A B
        (quotientClosingSequence G A B T Y Q X₀
          boundaryCertificate boundedCertificate n)).toWarp.meeting
            (quotientClosingSequence G A B T Y Q X₀
              boundaryCertificate boundedCertificate n)).vertexSet) :
    boundaryCertificate z ⊆
      quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate (n + 1) := by
  rw [quotientClosingSequence_succ]
  exact boundaryCertificate_subset_quotientClosingStep
    (maximalQuotientTotalWave G A B
      (quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n))
    boundaryCertificate boundedCertificate hz

/-- Every finite boundary certificate requested at a finite stage is present
in the countable closing limit. -/
theorem boundaryCertificate_subset_quotientClosingLimit {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) {z : V}
    (hz : z ∈ Y ∩
      ((maximalQuotientTotalWave G A B
        (quotientClosingSequence G A B T Y Q X₀
          boundaryCertificate boundedCertificate n)).toWarp.meeting
            (quotientClosingSequence G A B T Y Q X₀
              boundaryCertificate boundedCertificate n)).vertexSet) :
    boundaryCertificate z ⊆
      quotientClosingLimit G A B T Y Q X₀
        boundaryCertificate boundedCertificate := by
  exact (boundaryCertificate_subset_quotientClosingSequence_succ
      G A B T Y Q X₀ boundaryCertificate boundedCertificate n hz).trans
    (quotientClosingSequence_subset_limit G A B T Y Q X₀
      boundaryCertificate boundedCertificate (n + 1))

/-- Every boundedness certificate requested at stage `n` is present at stage
`n + 1`. -/
theorem boundedCertificate_subset_quotientClosingSequence_succ {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) {t : V}
    (ht : t ∈
      quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n \ Q) :
    boundedCertificate t ⊆
      quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate (n + 1) := by
  rw [quotientClosingSequence_succ]
  exact boundedCertificate_subset_quotientClosingStep
    (maximalQuotientTotalWave G A B
      (quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n))
    boundaryCertificate boundedCertificate ht

/-- Every boundedness certificate requested at a finite stage is present in
the countable closing limit. -/
theorem boundedCertificate_subset_quotientClosingLimit {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) {t : V}
    (ht : t ∈
      quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n \ Q) :
    boundedCertificate t ⊆
      quotientClosingLimit G A B T Y Q X₀
        boundaryCertificate boundedCertificate := by
  exact (boundedCertificate_subset_quotientClosingSequence_succ
      G A B T Y Q X₀ boundaryCertificate boundedCertificate n ht).trans
    (quotientClosingSequence_subset_limit G A B T Y Q X₀
      boundaryCertificate boundedCertificate (n + 1))

/-- Every tree vertex met by the fractured quotient warp at stage `n` is
present at stage `n + 1`. -/
theorem meeting_inter_tree_subset_quotientClosingSequence_succ {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) :
    ((maximalQuotientTotalWave G A B
      (quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n)).toWarp.meeting
          (quotientClosingSequence G A B T Y Q X₀
            boundaryCertificate boundedCertificate n)).vertexSet ∩ T ⊆
      quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate (n + 1) := by
  rw [quotientClosingSequence_succ]
  exact meeting_inter_tree_subset_quotientClosingStep
    (maximalQuotientTotalWave G A B
      (quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n))
    boundaryCertificate boundedCertificate

/-- Every tree vertex met by a fractured finite-stage quotient warp lies in
the countable closing limit. -/
theorem meeting_inter_tree_subset_quotientClosingLimit {V : Type}
    (G : SimpleGraph V) (A B T Y Q X₀ : Set V)
    (boundaryCertificate boundedCertificate : V → Set V) (n : ℕ) :
    ((maximalQuotientTotalWave G A B
      (quotientClosingSequence G A B T Y Q X₀
        boundaryCertificate boundedCertificate n)).toWarp.meeting
          (quotientClosingSequence G A B T Y Q X₀
            boundaryCertificate boundedCertificate n)).vertexSet ∩ T ⊆
      quotientClosingLimit G A B T Y Q X₀
        boundaryCertificate boundedCertificate := by
  exact (meeting_inter_tree_subset_quotientClosingSequence_succ
      G A B T Y Q X₀ boundaryCertificate boundedCertificate n).trans
    (quotientClosingSequence_subset_limit G A B T Y Q X₀
      boundaryCertificate boundedCertificate (n + 1))

/-- The concrete closing sequence attached to a maximal safe tree and one
chosen outer-boundary vertex.  It is the direct formal counterpart of the
sets `X_i` in Proposition 6.3. -/
noncomputable def safeTreeClosingSequence {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : ℕ → Set V :=
  quotientClosingSequence (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a)

/-- The countable set `X` obtained by closing the initial boundary
certificate under all three requirements of equation (6.4). -/
noncomputable def safeTreeClosingLimit {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) : Set V :=
  quotientClosingLimit (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a)

@[simp] theorem safeTreeClosingSequence_zero {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeClosingSequence hT y 0 = boundaryCertificateSet hT y := rfl

theorem safeTreeClosingSequence_countable {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ∀ n, (safeTreeClosingSequence hT y n).Countable := by
  exact quotientClosingSequence_countable
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a)
    (boundaryCertificateSet_finite hT y).countable
    (fun z _hz => boundaryCertificateSet_finite hT z)
    (boundedCertificateSet_countable G A B T a)

theorem safeTreeClosingLimit_countable {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeClosingLimit hT y).Countable := by
  exact quotientClosingLimit_countable
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a)
    (boundaryCertificateSet_finite hT y).countable
    (fun z _hz => boundaryCertificateSet_finite hT z)
    (boundedCertificateSet_countable G A B T a)

theorem safeTreeClosingLimit_subset_tree {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeClosingLimit hT y ⊆ T := by
  exact quotientClosingLimit_subset_tree
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a)
    (fun x hx =>
      (boundaryCertificateSet_subset_tree hT y.property hx).1)
    (fun z hz x hx =>
      (boundaryCertificateSet_subset_tree (y := z) hT hz hx).1)
    (boundedCertificateSet_subset_tree G A B T a)

theorem boundaryCertificate_subset_safeTreeClosingLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    boundaryCertificateSet hT y ⊆ safeTreeClosingLimit hT y := by
  exact quotientClosingSequence_subset_limit
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a) 0

theorem safeTreeClosingSequence_subset_limit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    safeTreeClosingSequence hT y n ⊆ safeTreeClosingLimit hT y := by
  exact quotientClosingSequence_subset_limit
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a) n

/-- No closing stage reintroduces the root that was deleted from the base
web.  In the last summand of (6.4), this uses the exact quotient-source
formula to exclude an isolated singleton component at the root. -/
theorem safeTreeClosingSequence_root_not_mem {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ∀ n, a ∉ safeTreeClosingSequence hT y n := by
  intro n
  induction n with
  | zero =>
      intro ha
      exact (boundaryCertificateSet_subset_tree hT y.property ha).2
        (Set.mem_singleton a)
  | succ n ih =>
      change a ∉ quotientClosingSequence
        (outsideGraph G {a}) (A \ {a}) (B \ {a})
        T (outerBoundary G T) (unboundedTreeVertices G A B T a)
        (boundaryCertificateSet hT y)
        (boundaryCertificateSet hT)
        (boundedCertificateSet G A B T a) (Nat.succ n)
      rw [show Nat.succ n = n + 1 by omega, quotientClosingSequence_succ]
      intro ha
      unfold quotientClosingStep at ha
      rcases ha with (((haOld | haBoundary) | haBounded) | haTree)
      · exact ih haOld
      · rcases Set.mem_iUnion.mp haBoundary with ⟨z, hz⟩
        rcases Set.mem_iUnion.mp hz with ⟨hzBoundary, haCertificate⟩
        exact (boundaryCertificateSet_subset_tree
          (y := z) hT hzBoundary.1 haCertificate).2
          (Set.mem_singleton a)
      · rcases Set.mem_iUnion.mp haBounded with ⟨t, ht⟩
        rcases Set.mem_iUnion.mp ht with ⟨_ht, haCertificate⟩
        exact (boundedCertificateSet_subset_tree_sdiff
          G A B T a t haCertificate).2 (Set.mem_singleton a)
      · let X := safeTreeClosingSequence hT y n
        let W := maximalQuotientTotalWave
          (outsideGraph G {a}) (A \ {a}) (B \ {a}) X
        have haW : a ∉ W.toWarp.vertexSet :=
          QuotientTotalWave.not_mem_vertexSet_of_base_deleted W
            (by simp) (by simpa [X] using ih)
        apply haW
        exact vertexSet_meeting_subset W.toWarp X haTree.1

theorem safeTreeClosingLimit_root_not_mem {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    a ∉ safeTreeClosingLimit hT y := by
  intro ha
  change a ∈ ⋃ n, safeTreeClosingSequence hT y n at ha
  rcases Set.mem_iUnion.mp ha with ⟨n, han⟩
  exact safeTreeClosingSequence_root_not_mem hT y n han

theorem safeTreeClosingLimit_subset_tree_sdiff {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    safeTreeClosingLimit hT y ⊆ T \ {a} := by
  intro x hx
  refine ⟨safeTreeClosingLimit_subset_tree hT y hx, ?_⟩
  intro hxa
  subst x
  exact safeTreeClosingLimit_root_not_mem hT y hx

/-- Condition (c), at the set-theoretic level: the chosen `G_t` of every
bounded vertex that enters the closing limit is itself contained in the
limit. -/
theorem boundedCertificate_subset_safeTreeClosingLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T)
    (ht : t ∈ safeTreeClosingLimit hT y \
      unboundedTreeVertices G A B T a) :
    boundedCertificateSet G A B T a t ⊆ safeTreeClosingLimit hT y := by
  have htUnion : t ∈ ⋃ n, safeTreeClosingSequence hT y n := ht.1
  rcases Set.mem_iUnion.mp htUnion with ⟨n, htn⟩
  exact boundedCertificate_subset_quotientClosingLimit
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a) n ⟨htn, ht.2⟩

theorem boundedCertificate_subset_safeTreeClosingSequence_succ
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ)
    (ht : t ∈ safeTreeClosingSequence hT y n \
      unboundedTreeVertices G A B T a) :
    boundedCertificateSet G A B T a t ⊆
      safeTreeClosingSequence hT y (n + 1) := by
  exact boundedCertificate_subset_quotientClosingSequence_succ
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a) n ht

/-- Every bounded vertex in the limit therefore has both its countable set
inside the limit and its fixed strict-roofing quotient wave. -/
theorem safeTreeClosingLimit_bounded_certificate {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T)
    (ht : t ∈ safeTreeClosingLimit hT y \
      unboundedTreeVertices G A B T a) :
    boundedCertificateSet G A B T a t ⊆ safeTreeClosingLimit hT y ∧
      ∃ W : Warp (outsideGraph (outsideGraph G {a})
          (interiorRoof (outsideGraph G {a}) (B \ {a})
            (boundedCertificateSet G A B T a t))),
        W.IsWave
          (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
            (boundedCertificateSet G A B T a t)) (B \ {a}) ∧
        t ∈ interiorRoof
          (outsideGraph (outsideGraph G {a})
            (interiorRoof (outsideGraph G {a}) (B \ {a})
              (boundedCertificateSet G A B T a t)))
          (B \ {a}) W.terminalSet := by
  refine ⟨boundedCertificate_subset_safeTreeClosingLimit hT y ht, ?_⟩
  exact boundedCertificateSet_has_wave
    (safeTreeClosingLimit_subset_tree hT y ht.1) ht.2

/-- Condition (d) at each finite stage: every tree vertex met by the
fractured maximal quotient warp is already in the final closing set. -/
theorem safeTreeStage_meeting_inter_tree_subset_limit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    ((maximalQuotientTotalWave (outsideGraph G {a})
      (A \ {a}) (B \ {a})
      (safeTreeClosingSequence hT y n)).toWarp.meeting
        (safeTreeClosingSequence hT y n)).vertexSet ∩ T ⊆
      safeTreeClosingLimit hT y := by
  exact meeting_inter_tree_subset_quotientClosingLimit
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a) n

/-- Condition (b) at each finite stage: every boundary certificate requested
by the fractured maximal quotient warp is contained in the final set. -/
theorem safeTreeStage_boundaryCertificate_subset_limit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a z : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ)
    (hz : z ∈ outerBoundary G T ∩
      ((maximalQuotientTotalWave (outsideGraph G {a})
        (A \ {a}) (B \ {a})
        (safeTreeClosingSequence hT y n)).toWarp.meeting
          (safeTreeClosingSequence hT y n)).vertexSet) :
    boundaryCertificateSet hT z ⊆ safeTreeClosingLimit hT y := by
  exact boundaryCertificate_subset_quotientClosingLimit
    (outsideGraph G {a}) (A \ {a}) (B \ {a})
    T (outerBoundary G T) (unboundedTreeVertices G A B T a)
    (boundaryCertificateSet hT y)
    (boundaryCertificateSet hT)
    (boundedCertificateSet G A B T a) n hz

/-- The stage-`n` maximal wave, quotiented by the full closing limit and
transported to the fixed final quotient graph. -/
noncomputable def safeTreeStageLimitWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (safeTreeClosingLimit hT y))) :=
  Erdos599.Warp.quotientWarpNested
    (maximalQuotientTotalWave (outsideGraph G {a})
      (A \ {a}) (B \ {a})
      (safeTreeClosingSequence hT y n)).toWarp
    (quotientClosingSequence_subset_limit
      (outsideGraph G {a}) (A \ {a}) (B \ {a})
      T (outerBoundary G T) (unboundedTreeVertices G A B T a)
      (boundaryCertificateSet hT y)
      (boundaryCertificateSet hT)
      (boundedCertificateSet G A B T a) n)

theorem safeTreeStageLimitWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ) :
    (safeTreeStageLimitWarp hT y n).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeClosingLimit hT y))
      (B \ {a}) := by
  unfold safeTreeStageLimitWarp
  apply IsWave.quotientWarpNested
  exact (maximalQuotientTotalWave (outsideGraph G {a})
    (A \ {a}) (B \ {a})
    (safeTreeClosingSequence hT y n)).isWave

/-- The exposed boundary of the union of two wave terminal sets is retained
by their arrow.  This is the substantive terminal calculation in
Aharoni--Berger Lemma 3.13. -/
theorem essential_union_subset_terminalSet_arrow {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {A B : Set V}
    (hU : U.IsWave A B) (hW : W.IsWave A B) :
    essentialVertices G B (U.terminalSet ∪ W.terminalSet) ⊆
      (arrow U W).terminalSet := by
  intro z hzEssential
  have hzUnion : z ∈ U.terminalSet ∪ W.terminalSet :=
    essentialVertices_subset G B (U.terminalSet ∪ W.terminalSet) hzEssential
  rcases hzUnion with hzU | hzW
  · exact terminal_mem_arrow_of_left_essential
      hW.vertexSet_subset_roof hzU hzEssential
  · by_cases hzU : z ∈ U.terminalSet
    · exact terminal_mem_arrow_of_left_essential
        hW.vertexSet_subset_roof hzU hzEssential
    · exact terminal_mem_arrow_of_right_essential hU hW
        hU.vertexSet_subset_roof hzW hzU hzEssential

theorem essentialVertices_terminalSet_arrow {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {A B : Set V}
    (hU : U.IsWave A B) (hW : W.IsWave A B) :
    essentialVertices G B (arrow U W).terminalSet =
      essentialVertices G B (U.terminalSet ∪ W.terminalSet) := by
  apply essentialVertices_eq_of_between
  · exact essential_union_subset_terminalSet_arrow hU hW
  · exact terminalSet_arrow_subset U W

/-- The arrow roof contains the roof of its right-hand wave. -/
theorem IsWave.roof_right_subset_arrow {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {A B : Set V} (hU : U.IsWave A B)
    (hW : W.IsWave A B) :
    roof G B W.terminalSet ⊆
      roof G B (arrow U W).terminalSet := by
  have hEssential := essentialVertices_terminalSet_arrow hU hW
  have hRoof : roof G B (arrow U W).terminalSet =
      roof G B (U.terminalSet ∪ W.terminalSet) := by
    rw [← roof_essentialVertices G B (arrow U W).terminalSet,
      hEssential, roof_essentialVertices]
  intro x hx
  rw [hRoof]
  exact roof_mono Set.subset_union_right hx

/-- Aharoni--Berger Lemma 3.18 in inclusion form: strict-roof points of the
left wave remain strict-roof points after one arrow composition. -/
theorem IsWave.interiorRoof_subset_arrow {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {A B : Set V} (hU : U.IsWave A B)
    (hW : W.IsWave A B) :
    interiorRoof G B U.terminalSet ⊆
      interiorRoof G B (arrow U W).terminalSet := by
  have hInteriorUnion : interiorRoof G B U.terminalSet ⊆
      interiorRoof G B (U.terminalSet ∪ W.terminalSet) :=
    interiorRoof_mono Set.subset_union_left
  have hEssential := essentialVertices_terminalSet_arrow hU hW
  have hRoof : roof G B (arrow U W).terminalSet =
      roof G B (U.terminalSet ∪ W.terminalSet) := by
    rw [← roof_essentialVertices G B (arrow U W).terminalSet,
      hEssential, roof_essentialVertices]
  intro x hx
  have hxUnion := hInteriorUnion hx
  refine ⟨by simpa [hRoof] using hxUnion.1, ?_⟩
  intro hxArrowEssential
  exact hxUnion.2 (by simpa [hEssential] using hxArrowEssential)

/-- The symmetric half of Lemma 3.18: strict-roof points of the right wave
also enter the strict roof of the arrow. -/
theorem IsWave.interiorRoof_right_subset_arrow {V : Type}
    {G : SimpleGraph V} {U W : Warp G} {A B : Set V}
    (hU : U.IsWave A B) (hW : W.IsWave A B) :
    interiorRoof G B W.terminalSet ⊆
      interiorRoof G B (arrow U W).terminalSet := by
  have hInteriorUnion : interiorRoof G B W.terminalSet ⊆
      interiorRoof G B (U.terminalSet ∪ W.terminalSet) :=
    interiorRoof_mono Set.subset_union_right
  have hEssential := essentialVertices_terminalSet_arrow hU hW
  have hRoof : roof G B (arrow U W).terminalSet =
      roof G B (U.terminalSet ∪ W.terminalSet) := by
    rw [← roof_essentialVertices G B (arrow U W).terminalSet,
      hEssential, roof_essentialVertices]
  intro x hx
  have hxUnion := hInteriorUnion hx
  refine ⟨by simpa [hRoof] using hxUnion.1, ?_⟩
  intro hxArrowEssential
  exact hxUnion.2 (by simpa [hEssential] using hxArrowEssential)

/-- Aharoni--Berger Lemma 3.13: the arrow of two waves is a wave. -/
theorem IsWave.arrow {V : Type} {G : SimpleGraph V}
    {U W : Warp G} {A B : Set V} (hU : U.IsWave A B)
    (hW : W.IsWave A B) :
    (arrow U W).IsWave A B := by
  constructor
  · simpa [IsStarting] using hU.1
  · have hUnionSep : Separates G A B (U.terminalSet ∪ W.terminalSet) := by
      intro a ha b hb q hq
      rcases hU.2 a ha b hb q hq with ⟨v, hvq, hvU⟩
      exact ⟨v, hvq, Or.inl hvU⟩
    have hEssentialSep := essentialVertices_separates hUnionSep
    intro a ha b hb q hq
    rcases hEssentialSep a ha b hb q hq with ⟨v, hvq, hvEssential⟩
    exact ⟨v, hvq, essential_union_subset_terminalSet_arrow hU hW hvEssential⟩

/-- Deletion form of Aharoni--Berger Lemma 3.12/3.15.  The right warp need
not itself be a wave in the deletion graph.  It suffices that its terminal
set separates in the ambient graph, that it is ambient self-roofing, and
that every component has a suffix which starts in the deletion roof and
avoids the deleted set.  The last condition is exactly what the first-exit
argument of Corollary 6.9 supplies. -/
theorem IsWave.arrow_delete_of_roofed_suffix
    {V : Type} {G : SimpleGraph V} {R A B : Set V}
    {U : Warp (outsideGraph G R)} {W : Warp G}
    (hU : U.IsWave A B) (hWroof : W.IsSelfRoofing B)
    (hWsep : Separates G A B W.terminalSet)
    (hRroof : R ⊆ roof G B W.terminalSet)
    (hWtermR : Disjoint W.terminalSet R)
    (hsuffix : ∀ j : W.ι, ∃ n,
      longPathActive (W.path j).terminalIndex n ∧
      (W.path j).vertex n ∈
        roof (outsideGraph G R) B U.terminalSet ∧
      ∀ m, longPathActive (W.path j).terminalIndex m → n ≤ m →
        (W.path j).vertex m ∉ R) :
    (Warp.arrow (U.mapLE (outsideGraph_le G R)) W).IsWave A B ∧
      RoofLE B W (Warp.arrow (U.mapLE (outsideGraph_le G R)) W) := by
  classical
  let U' := U.mapLE (outsideGraph_le G R)
  have hEssential : essentialVertices G B
      (U'.terminalSet ∪ W.terminalSet) ⊆
        (Warp.arrow U' W).terminalSet := by
    intro z hzEssential
    have hzUnion : z ∈ U'.terminalSet ∪ W.terminalSet :=
      essentialVertices_subset G B (U'.terminalSet ∪ W.terminalSet)
        hzEssential
    rcases hzUnion with hzU | hzW
    · exact terminal_mem_arrow_of_left_essential hWroof hzU hzEssential
    · by_cases hzU : z ∈ U'.terminalSet
      · exact terminal_mem_arrow_of_left_essential hWroof hzU hzEssential
      · rcases hzW with ⟨j, hjTerminal⟩
        rcases hsuffix j with ⟨s, hsActive, hsRoof, hsAvoid⟩
        let P := (W.path j).tail s hsActive
        have hPavoid : ∀ v ∈ P.vertexSet, v ∉ R := by
          rintro v ⟨m, hmActive, hmv⟩
          have hsmActive : longPathActive (W.path j).terminalIndex (s + m) :=
            (LongPath.active_shiftedTerminalIndex_iff hsActive).mp hmActive
          have hvalue : (W.path j).vertex (s + m) = v := by
            simpa [P, LongPath.tail] using hmv
          rw [← hvalue]
          exact hsAvoid (s + m) hsmActive (by omega)
        let PE := P.toOutsideGraph hPavoid
        have hPETerminal : PE.terminal? = some z := by
          simpa [PE, P] using hjTerminal
        rcases LongPath.terminal?_eq_some_iff.mp hPETerminal with
          ⟨l, hlFinite, hlz⟩
        have hlActive : longPathActive PE.terminalIndex l := by
          simp [hlFinite, longPathActive]
        let pref := PE.prefixWalk l hlActive
        have hstartRoof : PE.initial ∈
            roof (outsideGraph G R) B U.terminalSet := by
          simpa [PE, P] using hsRoof
        have hmeet : ∃ x ∈ pref.support,
            x ∈ roof (outsideGraph G R) B U.terminalSet :=
          ⟨PE.initial, pref.start_mem_support, hstartRoof⟩
        rcases exists_last_roof_index pref hmeet with
          ⟨n, hnle, hnRoof, hnEssential | hnEnd, hnlast⟩
        · have hnl : n ≤ l := by simpa [pref] using hnle
          have hgetPE : pref.getVert n = PE.vertex n :=
            PE.getVert_prefixWalk_of_le hlActive hnl
          have huEssential : PE.vertex n ∈
              essentialVertices (outsideGraph G R) B U.terminalSet := by
            simpa [hgetPE] using hnEssential
          have huTerminal : PE.vertex n ∈ U.terminalSet :=
            essentialVertices_subset (outsideGraph G R) B U.terminalSet
              huEssential
          rcases huTerminal with ⟨i, hiTerminal⟩
          rcases LongPath.terminal?_eq_some_iff.mp hiTerminal with
            ⟨k, hkFinite, hku⟩
          have hnPEActive : longPathActive PE.terminalIndex n :=
            LongPath.active_mono hnl hlActive
          have hsnActive : longPathActive (W.path j).terminalIndex (s + n) :=
            (LongPath.active_shiftedTerminalIndex_iff hsActive).mp hnPEActive
          have hPEvalue : PE.vertex n = (W.path j).vertex (s + n) := rfl
          let d : ExtensionData U' W i := {
            endIndex := k
            finite := hkFinite
            carrier := j
            meetIndex := s + n
            meetActive := hsnActive
            join := hPEvalue ▸ hku.symm
            avoidsOld := by
              intro v hv
              rcases hv.1 with ⟨r, hrActive, hrv⟩
              have hsnrActive : longPathActive (W.path j).terminalIndex
                  ((s + n) + r) :=
                (LongPath.active_shiftedTerminalIndex_iff hsnActive).mp hrActive
              have hnrPEActive : longPathActive PE.terminalIndex (n + r) := by
                apply (LongPath.active_shiftedTerminalIndex_iff hsActive).mpr
                simpa [Nat.add_assoc] using hsnrActive
              have hnrl : n + r ≤ l := by
                simpa [hlFinite, longPathActive] using hnrPEActive
              have hvRoof : v ∈
                  roof (outsideGraph G R) B U.terminalSet :=
                hU.vertexSet_subset_roof hv.2
              have hgetnr : pref.getVert (n + r) = PE.vertex (n + r) :=
                PE.getVert_prefixWalk_of_le hlActive hnrl
              have hroofnr : pref.getVert (n + r) ∈
                  roof (outsideGraph G R) B U.terminalSet := by
                rw [hgetnr]
                have hrValue : PE.vertex (n + r) = v := by
                  change (W.path j).vertex (s + (n + r)) = v
                  change (W.path j).vertex ((s + n) + r) = v at hrv
                  simpa [Nat.add_assoc] using hrv
                exact hrValue ▸ hvRoof
              have hr0 : r = 0 := by
                by_contra hr0
                exact hnlast (n + r) (by simpa [pref] using hnrl)
                  (by omega) hroofnr
              subst r
              have hvJoin : v = (W.path j).vertex (s + n) := by
                simpa [LongPath.tail] using hrv.symm
              exact Set.mem_singleton_iff.mpr (hvJoin.trans hku.symm) }
          exact terminal_mem_arrow_of_extension d hjTerminal
        · have hnEqL : n = l := by
            have hprefLength : pref.length = l := by simp [pref]
            exact hnEnd.trans hprefLength
          have hzRoof : z ∈
              roof (outsideGraph G R) B U.terminalSet := by
            have hgetEnd : pref.getVert n = z := by
              rw [hnEqL]
              exact (PE.getVert_prefixWalk_of_le hlActive le_rfl).trans hlz
            simpa [hgetEnd] using hnRoof
          let D : Set V := U'.terminalSet ∪ W.terminalSet
          have hRroofD : R ⊆ roof G B D := by
            intro r hr
            exact roof_mono Set.subset_union_right (hRroof hr)
          have hRoofEq : roof G B (D ∪ R) = roof G B D := by
            apply Set.Subset.antisymm
            · have hsub : D ∪ R ⊆ roof G B D := by
                exact Set.union_subset (subset_roof G B D) hRroofD
              intro x hx
              have := roof_mono hsub hx
              simpa using this
            · exact roof_mono Set.subset_union_left
          have hEssentialEq : essentialVertices G B (D ∪ R) =
              essentialVertices G B D :=
            essentialVertices_eq_of_roof_eq hRoofEq
          have hzLarge : z ∈ essentialVertices G B (D ∪ R) := by
            rw [hEssentialEq]
            exact hzEssential
          rcases mem_essentialVertices_iff.mp hzLarge with
            ⟨_, b, hb, q, hq, hqOnly⟩
          have hzNotR : z ∉ R := by
            exact fun hzR => Set.disjoint_left.mp hWtermR ⟨j, hjTerminal⟩ hzR
          have hqOutside : ∀ x ∈ q.support, x ∉ R := by
            intro x hxq hxR
            have hxz : x = z := hqOnly x hxq (Or.inr hxR)
            exact hzNotR (hxz ▸ hxR)
          let qE := Erdos599.Walk.toOutsideGraph q hqOutside
          have hqE : qE.IsPath :=
            Erdos599.Walk.isPath_toOutsideGraph hq hqOutside
          rcases hzRoof b hb qE hqE with ⟨y, hyqE, hyU⟩
          have hyq : y ∈ q.support := by simpa [qE] using hyqE
          have hyMapped : y ∈ U'.terminalSet := by simpa [U'] using hyU
          have hyz : y = z := hqOnly y hyq (Or.inl (Or.inl hyMapped))
          exact (hzU (by simpa [hyz] using hyMapped)).elim
  have hArrowWave : (Warp.arrow U' W).IsWave A B := by
    constructor
    · simpa [U', IsStarting] using hU.1
    · have hUnionSep : Separates G A B (U'.terminalSet ∪ W.terminalSet) := by
        intro a ha b hb q hq
        rcases hWsep a ha b hb q hq with ⟨v, hvq, hvW⟩
        exact ⟨v, hvq, Or.inr hvW⟩
      have hEssentialSep := essentialVertices_separates hUnionSep
      intro a ha b hb q hq
      rcases hEssentialSep a ha b hb q hq with ⟨v, hvq, hvEssential⟩
      exact ⟨v, hvq, hEssential hvEssential⟩
  refine ⟨hArrowWave, ?_⟩
  intro x hx
  have hxUnion : x ∈ roof G B (U'.terminalSet ∪ W.terminalSet) :=
    roof_mono Set.subset_union_right hx
  have hxEssential : x ∈ roof G B
      (essentialVertices G B (U'.terminalSet ∪ W.terminalSet)) := by
    simpa using hxUnion
  exact roof_mono hEssential hxEssential

namespace WaveExtension

/-- Arrow-composition, followed by normalization, is again an element of the
fixed-base wave-extension order. -/
noncomputable def arrowExtension {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (X : WaveExtension W A B)
    (U : Warp G) (hU : U.IsWave A B) : WaveExtension W A B where
  path i := LongPath.toNormalized ((arrow X.toWarp U).path i)
  baseForward i :=
    (X.baseForward i).trans <| (forward_arrowPath X.toWarp U i).trans <|
      LongPath.forward_normalize ((arrow X.toWarp U).path i)
  disjoint := by
    intro i j hij
    simpa [LongPath.toNormalized] using (arrow X.toWarp U).disjoint hij
  isWave := by
    have hArrow : (arrow X.toWarp U).IsWave A B := X.isWave.arrow hU
    constructor
    · rintro v ⟨i, rfl⟩
      change (arrowPath X.toWarp U i).normalize.initial ∈ A
      have hstart := hArrow.1
      change (Set.range fun i : W.ι => (arrowPath X.toWarp U i).initial) ⊆ A
        at hstart
      simpa using hstart ⟨i, rfl⟩
    · have hsep := hArrow.2
      change Separates G A B
        {v | ∃ i : W.ι, (arrowPath X.toWarp U i).terminal? = some v}
        at hsep
      change Separates G A B
        {v | ∃ i : W.ι,
          (arrowPath X.toWarp U i).normalize.terminal? = some v}
      intro a ha b hb q hq
      rcases hsep a ha b hb q hq with ⟨v, hvq, i, hi⟩
      exact ⟨v, hvq, i, by simpa⟩

@[simp] theorem terminalSet_toWarp_arrowExtension {V : Type}
    {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (X : WaveExtension W A B) (U : Warp G) (hU : U.IsWave A B) :
    (X.arrowExtension U hU).toWarp.terminalSet =
      (arrow X.toWarp U).terminalSet := by
  ext v
  change (∃ i : W.ι,
      ((arrow X.toWarp U).path i).normalize.terminal? = some v) ↔
    ∃ i : W.ι, ((arrow X.toWarp U).path i).terminal? = some v
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, by simpa using hi⟩
  · rintro ⟨i, hi⟩
    exact ⟨i, by simpa using hi⟩

theorem le_arrowExtension {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (X : WaveExtension W A B)
    (U : Warp G) (hU : U.IsWave A B) : X ≤ X.arrowExtension U hU := by
  intro i
  exact (forward_arrowPath X.toWarp U i).trans
    (LongPath.forward_normalize ((arrow X.toWarp U).path i))

/-- Successive normalized arrow-composition of a sequence of waves, all in
one fixed web. -/
noncomputable def arrowSequence {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    ℕ → WaveExtension (U 0) A B
  | 0 => base (hU 0)
  | n + 1 => (arrowSequence U hU n).arrowExtension (U (n + 1)) (hU (n + 1))

@[simp] theorem arrowSequence_zero {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    arrowSequence U hU 0 = base (hU 0) := rfl

@[simp] theorem arrowSequence_succ {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B)
    (n : ℕ) :
    arrowSequence U hU (n + 1) =
      (arrowSequence U hU n).arrowExtension (U (n + 1)) (hU (n + 1)) := rfl

theorem arrowSequence_monotone {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    Monotone (arrowSequence U hU) := by
  apply monotone_nat_of_le_succ
  intro n
  rw [arrowSequence_succ]
  exact le_arrowExtension (arrowSequence U hU n) (U (n + 1)) (hU (n + 1))

theorem base_isSourceClean {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B)
    (hclean : W.IsSourceClean A) :
    (base hW).toWarp.IsSourceClean A := by
  intro i v hv hvA
  change v ∈ (W.path i).normalize.vertexSet at hv
  rw [LongPath.vertexSet_normalize] at hv
  have hvi := hclean i v hv hvA
  change v = (W.path i).normalize.initial
  simpa using hvi

theorem arrowExtension_isSourceClean {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (X : WaveExtension W A B)
    (U : Warp G) (hU : U.IsWave A B)
    (hXclean : X.toWarp.IsSourceClean A) (hUclean : U.IsSourceClean A) :
    (X.arrowExtension U hU).toWarp.IsSourceClean A := by
  intro i v hv hvA
  change v ∈ ((arrow X.toWarp U).path i).normalize.vertexSet at hv
  rw [LongPath.vertexSet_normalize] at hv
  have hvi := hXclean.arrow hUclean i v hv hvA
  change v = ((arrow X.toWarp U).path i).normalize.initial
  simpa using hvi

theorem arrowSequence_isSourceClean {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B)
    (hclean : ∀ n, (U n).IsSourceClean A) :
    ∀ n, (arrowSequence U hU n).toWarp.IsSourceClean A := by
  intro n
  induction n with
  | zero => exact base_isSourceClean (hU 0) (hclean 0)
  | succ n ih =>
      rw [arrowSequence_succ]
      exact arrowExtension_isSourceClean
        (arrowSequence U hU n) (U (n + 1)) (hU (n + 1))
        ih (hclean (n + 1))

/-- Normalizing an arrow extension does not change any component vertex
set, hence preserves causal component-closure. -/
theorem arrowExtension_isClosedOn {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B R : Set V} (X : WaveExtension W A B)
    (U : Warp G) (hU : U.IsWave A B)
    (hXclosed : X.toWarp.IsClosedOn R) (hUclosed : U.IsClosedOn R) :
    (X.arrowExtension U hU).toWarp.IsClosedOn R := by
  apply isClosedOn_of_path_subset
  intro i hmeet
  change ((arrow X.toWarp U).path i).normalize.vertexSet ⊆ R
  change ∃ x ∈ ((arrow X.toWarp U).path i).normalize.vertexSet,
    x ∈ R at hmeet
  rw [LongPath.vertexSet_normalize] at hmeet ⊢
  exact (hXclosed.arrow hUclosed).path_subset i hmeet

theorem arrowSequence_isClosedOn {V : Type} {G : SimpleGraph V}
    {A B R : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B)
    (hclosed : ∀ n, (U n).IsClosedOn R) :
    ∀ n, (arrowSequence U hU n).toWarp.IsClosedOn R := by
  intro n
  induction n with
  | zero =>
      apply isClosedOn_of_path_subset
      intro i hmeet
      change ((U 0).path i).normalize.vertexSet ⊆ R
      change ∃ x ∈ ((U 0).path i).normalize.vertexSet, x ∈ R at hmeet
      rw [LongPath.vertexSet_normalize] at hmeet ⊢
      exact (hclosed 0).path_subset i hmeet
  | succ n ih =>
      rw [arrowSequence_succ]
      exact arrowExtension_isClosedOn
        (arrowSequence U hU n) (U (n + 1)) (hU (n + 1))
        ih (hclosed (n + 1))

/-- The wave introduced at a finite stage is strictly roofed by the finite
arrow composition through that stage. -/
theorem interiorRoof_stage_subset_arrowSequence {V : Type}
    {G : SimpleGraph V} {A B : Set V}
    (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) (n : ℕ) :
    interiorRoof G B (U n).terminalSet ⊆
      interiorRoof G B (arrowSequence U hU n).toWarp.terminalSet := by
  cases n with
  | zero => simpa
  | succ n =>
      intro x hx
      have hxArrow :=
        (arrowSequence U hU n).isWave.interiorRoof_right_subset_arrow
          (hU (n + 1)) hx
      change x ∈ interiorRoof G B
        (arrowSequence U hU (n + 1)).toWarp.terminalSet
      rw [arrowSequence_succ, terminalSet_toWarp_arrowExtension]
      exact hxArrow

/-- The pointwise direct limit of the finite arrow compositions. -/
noncomputable def arrowLimit {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    Warp G :=
  limitOfPaths
    (fun n i => ((arrowSequence U hU n).path i).1)
    (fun i _ _ hnm => arrowSequence_monotone U hU hnm i)
    (fun n => (arrowSequence U hU n).disjoint)

theorem arrowLimit_isWave {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    (arrowLimit U hU).IsWave A B := by
  unfold arrowLimit
  exact IsWave.limitOfPathChain
    (fun n i => ((arrowSequence U hU n).path i).1)
    (fun i _ _ hnm => arrowSequence_monotone U hU hnm i)
    (fun n => (arrowSequence U hU n).disjoint)
    (fun n => (arrowSequence U hU n).isWave)

theorem arrowLimit_isSourceClean {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B)
    (hclean : ∀ n, (U n).IsSourceClean A) :
    (arrowLimit U hU).IsSourceClean A := by
  let P : ℕ → (U 0).ι → LongPath G := fun n i =>
    ((arrowSequence U hU n).path i).1
  have hchain : ∀ i ⦃m n : ℕ⦄, m ≤ n → (P m i).Forward (P n i) :=
    fun i _ _ hmn => arrowSequence_monotone U hU hmn i
  intro i v hv hvA
  change v ∈ (LongPath.limit (fun n => P n i) (hchain i)).vertexSet at hv
  rcases hv with ⟨k, hkLimit, hkv⟩
  rcases (LongPath.active_limitTerminalIndex_iff (fun n => P n i) k).mp
      hkLimit with ⟨n, hkn⟩
  have hvn : v ∈ (P n i).vertexSet := by
    refine ⟨k, hkn, ?_⟩
    exact (LongPath.limitVertex_eq_of_active
      (fun n => P n i) (hchain i) hkn).symm.trans hkv
  have hstage := arrowSequence_isSourceClean U hU hclean n i v hvn hvA
  have hzero : longPathActive (P n i).terminalIndex 0 := by
    cases (P n i).terminalIndex <;> simp [longPathActive]
  have hforward := path_forward_limitOfPaths
    (fun n i => P n i) hchain
    (fun n => (arrowSequence U hU n).disjoint) n i 0 hzero
  change v = (LongPath.limit (fun n => P n i) (hchain i)).initial
  exact hstage.trans (by
    change (P n i).vertex 0 =
      (LongPath.limit (fun n => P n i) (hchain i)).vertex 0
    exact hforward.2.symm)

/-- Causal component-closure also survives the pointwise countable direct
limit: any two vertices of a limit component already coexist at one finite
arrow stage. -/
theorem arrowLimit_isClosedOn {V : Type} {G : SimpleGraph V}
    {A B R : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B)
    (hclosed : ∀ n, (U n).IsClosedOn R) :
    (arrowLimit U hU).IsClosedOn R := by
  apply isClosedOn_of_path_subset
  intro i hmeet v hv
  let P : ℕ → (U 0).ι → LongPath G := fun n i =>
    ((arrowSequence U hU n).path i).1
  have hchain : ∀ a ⦃m n : ℕ⦄, m ≤ n → (P m a).Forward (P n a) :=
    fun a _ _ hmn => arrowSequence_monotone U hU hmn a
  rcases hmeet with ⟨x, ⟨m, hm, hmx⟩, hxR⟩
  rcases hv with ⟨n, hn, hnv⟩
  have hmSet : m ∈ LongPath.limitActiveSet (fun k => P k i) :=
    (LongPath.active_limitTerminalIndex_iff (fun k => P k i) m).mp hm
  have hnSet : n ∈ LongPath.limitActiveSet (fun k => P k i) :=
    (LongPath.active_limitTerminalIndex_iff (fun k => P k i) n).mp hn
  rcases hmSet with ⟨j, hmj⟩
  rcases hnSet with ⟨k, hnk⟩
  let l := max j k
  have hjl : j ≤ l := le_max_left j k
  have hkl : k ≤ l := le_max_right j k
  have hml : longPathActive (P l i).terminalIndex m :=
    (hchain i hjl m hmj).1
  have hnl : longPathActive (P l i).terminalIndex n :=
    (hchain i hkl n hnk).1
  have hxl : x ∈ (P l i).vertexSet := by
    refine ⟨m, hml, ?_⟩
    rw [← LongPath.limitVertex_eq_of_active
      (fun k => P k i) (hchain i) hml]
    exact hmx
  have hvl : v ∈ (P l i).vertexSet := by
    refine ⟨n, hnl, ?_⟩
    rw [← LongPath.limitVertex_eq_of_active
      (fun k => P k i) (hchain i) hnl]
    exact hnv
  exact (arrowSequence_isClosedOn U hU hclosed l).path_subset i
    ⟨x, hxl, hxR⟩ hvl

/-- The causal Section 6 wave is the arrow limit of all relevant certificate
waves after quotienting them by the common causal closing set. -/
noncomputable def safeTreeCausalLimitWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (safeTreeCausalXLimit hT y))) :=
  arrowLimit
    (safeTreeCausalWaveSequence hT y)
    (safeTreeCausalWaveSequence_isWave hT y)

theorem safeTreeCausalLimitWave_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalLimitWave hT y).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y)) (B \ {a}) :=
  arrowLimit_isWave
    (safeTreeCausalWaveSequence hT y)
    (safeTreeCausalWaveSequence_isWave hT y)

theorem safeTreeCausalLimitWave_isSourceClean {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalLimitWave hT y).IsSourceClean
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y)) := by
  exact arrowLimit_isSourceClean
    (safeTreeCausalWaveSequence hT y)
    (safeTreeCausalWaveSequence_isWave hT y)
    (safeTreeCausalWaveSequence_isSourceClean hT y)

theorem safeTreeCausalLimitWave_isClosedOn {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalLimitWave hT y).IsClosedOn
      (safeTreeCausalRLimit hT y) := by
  exact arrowLimit_isClosedOn
    (safeTreeCausalWaveSequence hT y)
    (safeTreeCausalWaveSequence_isWave hT y)
    (safeTreeCausalWaveSequence_isClosedOn hT y)

theorem safeTreeCausalLimitWave_meeting_subset_RLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ((safeTreeCausalLimitWave hT y).meeting
      (safeTreeCausalXLimit hT y)).vertexSet ⊆
        safeTreeCausalRLimit hT y := by
  rintro v hv
  rw [Warp.meeting, Warp.vertexSet_restrictIndices] at hv
  rcases hv with ⟨i, hiMeet, hvi⟩
  apply (safeTreeCausalLimitWave_isClosedOn hT y).path_subset i
    ⟨Classical.choose hiMeet,
      (Classical.choose_spec hiMeet).1,
      safeTreeCausalXLimit_subset_RLimit hT y
        (Classical.choose_spec hiMeet).2⟩
  exact hvi

/-- The causal limit wave contains no copy of the deleted root. -/
theorem safeTreeCausalLimitWave_root_not_mem_vertexSet {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    a ∉ (safeTreeCausalLimitWave hT y).vertexSet := by
  rintro ⟨i, hai⟩
  let H := outsideGraph G ({a} : Set V)
  let X := safeTreeCausalXLimit hT y
  let p : LongPath H :=
    ((safeTreeCausalLimitWave hT y).path i).mapLE
      (outsideGraph_le H (interiorRoof H (B \ {a}) X))
  have hiSource : ((safeTreeCausalLimitWave hT y).path i).initial ∈
      quotientSource H (A \ {a}) (B \ {a}) X := by
    exact (safeTreeCausalLimitWave_isWave hT y).1 ⟨i, rfl⟩
  have hiNe : p.initial ≠ a := by
    intro hia
    have hia' : ((safeTreeCausalLimitWave hT y).path i).initial = a := by
      simpa [p] using hia
    rw [hia'] at hiSource
    have haX : a ∈ X := by
      simpa using hiSource.1
    exact (safeTreeCausalXLimit_subset_tree_sdiff hT y haX).2
      (Set.mem_singleton a)
  have hap : a ∉ p.vertexSet := by
    intro hap
    exact (p.vertex_not_mem_of_outsideGraph hiNe hap) (Set.mem_singleton a)
  exact hap hai

/-- Causal condition (b): every boundary certificate requested by a final
component meeting the quotienting set is already contained in that set. -/
theorem safeTreeCausalLimit_boundaryCertificate_subset {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a z : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T)
    (hz : z ∈ outerBoundary G T ∩
      ((safeTreeCausalLimitWave hT y).meeting
        (safeTreeCausalXLimit hT y)).vertexSet) :
    boundaryCertificateSet hT z ⊆ safeTreeCausalXLimit hT y := by
  have hzR : z ∈ safeTreeCausalRLimit hT y :=
    safeTreeCausalLimitWave_meeting_subset_RLimit hT y hz.2
  let k : SafeTreeWaveKey V := .boundary z
  have hk : k ∈ safeTreeCausalKeys hT y
      (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y) := by
    exact Or.inl <| Or.inr ⟨z, ⟨hz.1, hzR⟩, rfl⟩
  exact safeTreeCausalKey_certificate_subset_limit hT y hk

/-- Causal condition (d): every tree vertex on a final component meeting the
quotienting set belongs to the quotienting set. -/
theorem safeTreeCausalLimit_meeting_inter_tree_subset_XLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    ((safeTreeCausalLimitWave hT y).meeting
      (safeTreeCausalXLimit hT y)).vertexSet ∩ T ⊆
        safeTreeCausalXLimit hT y := by
  rintro z ⟨hzMeet, hzT⟩
  have hzR : z ∈ safeTreeCausalRLimit hT y :=
    safeTreeCausalLimitWave_meeting_subset_RLimit hT y hzMeet
  have hza : z ≠ a := by
    intro hza
    subst z
    exact safeTreeCausalLimitWave_root_not_mem_vertexSet hT y
      (Warp.vertexSet_meeting_subset
        (safeTreeCausalLimitWave hT y)
        (safeTreeCausalXLimit hT y) hzMeet)
  rcases Set.mem_iUnion.mp hzR with ⟨n, hzn⟩
  apply safeTreeCausalX_subset_limit hT y (n + 1)
  rw [safeTreeCausalX_succ]
  exact Or.inr ⟨hzn, hzT, by simpa using hza⟩

/-- The first wave is below the countable arrow limit in the roof order.
Although the intermediate arrow compositions are normalized, their paths
extend the original first paths pointwise, and the direct limit extends the
zeroth normalized stage. -/
theorem roof_first_subset_roof_arrowLimit {V : Type} {G : SimpleGraph V}
    {A B : Set V} (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    roof G B (U 0).terminalSet ⊆
      roof G B (arrowLimit U hU).terminalSet := by
  apply (arrowLimit_isWave U hU).roofLE_of_vertexSet_subset
  rintro v ⟨i, n, hn, hnv⟩
  have hstage := (arrowSequence U hU 0).baseForward i n hn
  have hlimit := path_forward_limitOfPaths
    (fun m i => ((arrowSequence U hU m).path i).1)
    (fun i _ _ hmn => arrowSequence_monotone U hU hmn i)
    (fun m => (arrowSequence U hU m).disjoint) 0 i n hstage.1
  exact ⟨i, n, hlimit.1, hlimit.2.trans (hstage.2.trans hnv)⟩

/-- Strict-roof points of the first wave remain strict-roof points of the
countable arrow limit.  For the non-essentiality clause, remove the point
from every finite-stage terminal set and apply the lower-limit roof lemma;
all eventually persistent terminals survive in the pointwise path limit. -/
theorem interiorRoof_first_subset_interiorRoof_arrowLimit
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) :
    interiorRoof G B (U 0).terminalSet ⊆
      interiorRoof G B (arrowLimit U hU).terminalSet := by
  classical
  let T : ℕ → Set V := fun n => (arrowSequence U hU n).toWarp.terminalSet
  have hInteriorStage : ∀ n,
      interiorRoof G B (U 0).terminalSet ⊆ interiorRoof G B (T n) := by
    intro n
    induction n with
    | zero =>
        simpa [T]
    | succ n ih =>
        intro x hx
        have hxPrev : x ∈ interiorRoof G B
            (arrowSequence U hU n).toWarp.terminalSet := by
          simpa [T] using ih hx
        have hxArrow :=
          (arrowSequence U hU n).isWave.interiorRoof_subset_arrow
            (hU (n + 1)) hxPrev
        change x ∈ interiorRoof G B
          (arrowSequence U hU (n + 1)).toWarp.terminalSet
        rw [arrowSequence_succ, terminalSet_toWarp_arrowExtension]
        exact hxArrow
  intro x hx
  refine ⟨roof_first_subset_roof_arrowLimit U hU hx.1, ?_⟩
  intro hxEssential
  let S : ℕ → Set V := fun n => T n \ {x}
  have hxRoofS : ∀ n, x ∈ roof G B (S n) := by
    intro n
    exact mem_roof_sdiff_singleton_of_mem_interiorRoof
      (hInteriorStage n hx)
  have hchain : ∀ ⦃i j : ℕ⦄, i < j → S i ⊆ roof G B (S j) := by
    intro i j hij z hz
    have hforward : (arrowSequence U hU i).toWarp.vertexSet ⊆
        (arrowSequence U hU j).toWarp.vertexSet :=
      vertexSet_subset_of_le (arrowSequence_monotone U hU hij.le)
    have hzRoof : z ∈ roof G B (T j) := by
      apply (arrowSequence U hU j).isWave.vertexSet_subset_roof
      apply hforward
      exact (arrowSequence U hU i).toWarp.terminalSet_subset_vertexSet hz.1
    exact mem_roof_sdiff_singleton_of_ne_of_mem_roof
      (hxRoofS j) hz.2 hzRoof
  have hxUnion : x ∈ ⋃ n, roof G B (S n) :=
    Set.mem_iUnion.mpr ⟨0, hxRoofS 0⟩
  have hxLiminf : x ∈ roof G B (orderLiminf S) :=
    iUnion_roof_subset_roof_orderLiminf S hchain hxUnion
  have hliminfSubset : orderLiminf S ⊆
      (arrowLimit U hU).terminalSet \ {x} := by
    rintro z ⟨n, hn⟩
    have hzT : z ∈ orderLiminf T :=
      ⟨n, fun j hnj => (hn j hnj).1⟩
    have hzLimit := orderLiminf_terminalSet_subset_limitOfPaths
      (fun m i => ((arrowSequence U hU m).path i).1)
      (fun i _ _ hmn => arrowSequence_monotone U hU hmn i)
      (fun m => (arrowSequence U hU m).disjoint) (by
        simpa [T, toWarp, ofPaths, terminalSet] using hzT)
    refine ⟨?_, (hn n le_rfl).2⟩
    exact hzLimit
  exact hxEssential.2 (roof_mono hliminfSubset hxLiminf)

/-- The strict roof of any finite arrow-composition stage persists in the
countable arrow limit.  This tail form is needed when a certificate is first
introduced after stage zero. -/
theorem interiorRoof_arrowSequence_subset_interiorRoof_arrowLimit
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (U : ℕ → Warp G) (hU : ∀ n, (U n).IsWave A B) (k : ℕ) :
    interiorRoof G B (arrowSequence U hU k).toWarp.terminalSet ⊆
      interiorRoof G B (arrowLimit U hU).terminalSet := by
  classical
  let T : ℕ → Set V := fun n =>
    (arrowSequence U hU (k + n)).toWarp.terminalSet
  have hInteriorStage : ∀ n,
      interiorRoof G B (arrowSequence U hU k).toWarp.terminalSet ⊆
        interiorRoof G B (T n) := by
    intro n
    induction n with
    | zero => simpa [T]
    | succ n ih =>
        intro x hx
        have hxPrev : x ∈ interiorRoof G B
            (arrowSequence U hU (k + n)).toWarp.terminalSet := by
          simpa [T] using ih hx
        have hxArrow :=
          (arrowSequence U hU (k + n)).isWave.interiorRoof_subset_arrow
            (hU (k + n + 1)) hxPrev
        have hidx : k + (n + 1) = (k + n) + 1 := by omega
        change x ∈ interiorRoof G B
          (arrowSequence U hU (k + (n + 1))).toWarp.terminalSet
        rw [hidx, arrowSequence_succ, terminalSet_toWarp_arrowExtension]
        exact hxArrow
  intro x hx
  have hxRoof : x ∈ roof G B (arrowLimit U hU).terminalSet := by
    have hvertex : (arrowSequence U hU k).toWarp.vertexSet ⊆
        (arrowLimit U hU).vertexSet := by
      rintro v ⟨i, n, hn, hnv⟩
      have hlimit := path_forward_limitOfPaths
        (fun m i => ((arrowSequence U hU m).path i).1)
        (fun i _ _ hmn => arrowSequence_monotone U hU hmn i)
        (fun m => (arrowSequence U hU m).disjoint) k i n hn
      exact ⟨i, n, hlimit.1, hlimit.2.trans hnv⟩
    exact (arrowLimit_isWave U hU).roofLE_of_vertexSet_subset hvertex hx.1
  refine ⟨hxRoof, ?_⟩
  intro hxEssential
  let S : ℕ → Set V := fun n => T n \ {x}
  have hxRoofS : ∀ n, x ∈ roof G B (S n) := by
    intro n
    exact mem_roof_sdiff_singleton_of_mem_interiorRoof
      (hInteriorStage n hx)
  have hchain : ∀ ⦃i j : ℕ⦄, i < j → S i ⊆ roof G B (S j) := by
    intro i j hij z hz
    have hforward : (arrowSequence U hU (k + i)).toWarp.vertexSet ⊆
        (arrowSequence U hU (k + j)).toWarp.vertexSet :=
      vertexSet_subset_of_le
        (arrowSequence_monotone U hU (by omega))
    have hzRoof : z ∈ roof G B (T j) := by
      apply (arrowSequence U hU (k + j)).isWave.vertexSet_subset_roof
      apply hforward
      exact (arrowSequence U hU (k + i)).toWarp.terminalSet_subset_vertexSet
        hz.1
    exact mem_roof_sdiff_singleton_of_ne_of_mem_roof
      (hxRoofS j) hz.2 hzRoof
  have hxUnion : x ∈ ⋃ n, roof G B (S n) :=
    Set.mem_iUnion.mpr ⟨0, hxRoofS 0⟩
  have hxLiminf : x ∈ roof G B (orderLiminf S) :=
    iUnion_roof_subset_roof_orderLiminf S hchain hxUnion
  have hliminfSubset : orderLiminf S ⊆
      (arrowLimit U hU).terminalSet \ {x} := by
    rintro z ⟨n, hn⟩
    have hzTail : z ∈ orderLiminf T :=
      ⟨n, fun j hnj => (hn j hnj).1⟩
    have hzAll : z ∈ orderLiminf (fun m =>
        (arrowSequence U hU m).toWarp.terminalSet) := by
      rcases hzTail with ⟨n₀, hn₀⟩
      refine ⟨k + n₀, ?_⟩
      intro j hj
      have hkj : k ≤ j := by omega
      let m := j - k
      have hkm : k + m = j := Nat.add_sub_of_le hkj
      have hn₀m : n₀ ≤ m := by omega
      simpa [T, hkm] using hn₀ m hn₀m
    have hzLimit := orderLiminf_terminalSet_subset_limitOfPaths
      (fun m i => ((arrowSequence U hU m).path i).1)
      (fun i _ _ hmn => arrowSequence_monotone U hU hmn i)
      (fun m => (arrowSequence U hU m).disjoint) (by
        simpa [toWarp, ofPaths, terminalSet] using hzAll)
    refine ⟨hzLimit, (hn n le_rfl).2⟩
  exact hxEssential.2 (roof_mono hliminfSubset hxLiminf)

/-- A pathwise maximal extension absorbs arrow-composition with any wave. -/
theorem terminalSet_arrow_eq_of_isMax {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} {X : WaveExtension W A B}
    (hX : IsMax X) (U : Warp G) (hU : U.IsWave A B) :
    (arrow X.toWarp U).terminalSet = X.toWarp.terminalSet := by
  let Y := X.arrowExtension U hU
  have hXY : X ≤ Y := le_arrowExtension X U hU
  have hYX : Y ≤ X := hX hXY
  have hpath (i : W.ι) :
      ((arrow X.toWarp U).path i).normalize = (X.path i).1 := by
    exact LongPath.eq_of_mutual_forward
      (LongPath.isNormalized_normalize _)
      (X.path i).2 (hYX i) (hXY i)
  change {v | ∃ i : W.ι, ((arrow X.toWarp U).path i).terminal? = some v} =
    {v | ∃ i : W.ι, (X.path i).1.terminal? = some v}
  ext v
  constructor
  · rintro ⟨i, hi⟩
    refine ⟨i, ?_⟩
    rw [← hpath i, LongPath.terminal?_normalize]
    exact hi
  · rintro ⟨i, hi⟩
    refine ⟨i, ?_⟩
    rw [← hpath i] at hi
    simpa using hi

/-- Pathwise maximality implies maximality in the roof order among all
waves, not merely among extensions with the fixed index type. -/
theorem roofLE_of_isMax {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} {X : WaveExtension W A B}
    (hX : IsMax X) (U : Warp G) (hU : U.IsWave A B) :
    RoofLE B U X.toWarp := by
  have hterminal := terminalSet_arrow_eq_of_isMax hX U hU
  have hXWave : X.toWarp.IsWave A B := X.isWave
  have hessential := essentialVertices_terminalSet_arrow hXWave hU
  have hboundary :
      essentialVertices G B X.toWarp.terminalSet =
        essentialVertices G B (X.toWarp.terminalSet ∪ U.terminalSet) := by
    calc
      essentialVertices G B X.toWarp.terminalSet =
          essentialVertices G B (arrow X.toWarp U).terminalSet :=
        congrArg (essentialVertices G B) hterminal.symm
      _ = essentialVertices G B
          (X.toWarp.terminalSet ∪ U.terminalSet) := hessential
  have hroof : roof G B X.toWarp.terminalSet =
      roof G B (X.toWarp.terminalSet ∪ U.terminalSet) := by
    rw [← roof_essentialVertices G B X.toWarp.terminalSet,
      ← roof_essentialVertices G B (X.toWarp.terminalSet ∪ U.terminalSet),
      hboundary]
  intro v hv
  have hvUnion : v ∈ roof G B (X.toWarp.terminalSet ∪ U.terminalSet) :=
    roof_mono Set.subset_union_right hv
  rw [← hroof] at hvUnion
  exact hvUnion

/-- Every wave has a roof-maximal forward extension. -/
theorem IsWave.exists_roofMaximal {V : Type} {G : SimpleGraph V}
    {W : Warp G} {A B : Set V} (hW : W.IsWave A B) :
    ∃ M : Warp G, M.IsWave A B ∧
      (∀ U : Warp G, U.IsWave A B → RoofLE B U M) := by
  rcases exists_isMax hW with ⟨X, hX⟩
  exact ⟨X.toWarp, X.isWave, fun U hU => roofLE_of_isMax hX U hU⟩

end WaveExtension

/-- The canonical maximal quotient wave retains the strict-roof witness
of every bounded certificate.  This is stated here because its proof uses
roof maximality of pathwise-maximal wave extensions. -/
theorem boundedCertificateWave_strictly_roofs {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (htT : t ∈ T) (htQ : t ∉ unboundedTreeVertices G A B T a) :
    t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (boundedCertificateSet G A B T a t)))
      (B \ {a})
      (boundedCertificateWave G A B T a t).terminalSet := by
  classical
  have htBounded := isBounded_of_mem_tree_not_mem_unbounded htT htQ
  let C := boundedCertificateWaveOfBounded G A B T a t htBounded
  let M := maximalQuotientTotalWave (outsideGraph G {a})
    (A \ {a}) (B \ {a}) (boundedCertificateSet G A B T a t)
  have hCM : RoofLE (B \ {a}) C.1 M.toWarp := by
    exact WaveExtension.roofLE_of_isMax
      (maximalQuotientTotalWave_isMax (outsideGraph G {a})
        (A \ {a}) (B \ {a}) (boundedCertificateSet G A B T a t))
      C.1 C.2.1
  have htM := interiorRoof_mono_of_roof_subset hCM C.2.2
  simpa [boundedCertificateWave, M] using htM

/-- A bounded tree vertex present at stage `n` is strictly roofed by the
stage-`n+1` maximal wave after transport to the final quotient.  This is the
finite-stage core of condition (c) in Proposition 6.3. -/
theorem safeTreeStageLimitWarp_succ_strictly_roofs
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (n : ℕ)
    (ht : t ∈ safeTreeClosingSequence hT y n \
      unboundedTreeVertices G A B T a)
    (htB : t ∉ B) :
    t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeClosingLimit hT y)))
      (B \ {a}) (safeTreeStageLimitWarp hT y (n + 1)).terminalSet := by
  classical
  let H := outsideGraph G ({a} : Set V)
  let A₀ := A \ ({a} : Set V)
  let B₀ := B \ ({a} : Set V)
  let F := boundedCertificateSet G A B T a t
  let X := safeTreeClosingSequence hT y n
  let X' := safeTreeClosingSequence hT y (n + 1)
  let L := safeTreeClosingLimit hT y
  have htL : t ∈ L :=
    safeTreeClosingSequence_subset_limit hT y n ht.1
  rcases (safeTreeClosingLimit_bounded_certificate hT y
      ⟨htL, ht.2⟩).2 with ⟨W, hWwave, htWambient⟩
  have hFX' : F ⊆ X' := by
    exact boundedCertificate_subset_safeTreeClosingSequence_succ
      hT y n ht
  let U : Warp (outsideGraph H (interiorRoof H B₀ X')) :=
    Erdos599.Warp.quotientWarpNested W hFX'
  have hUW : U.IsWave (quotientSource H A₀ B₀ X') B₀ := by
    exact hWwave.quotientWarpNested hFX'
  have htW : t ∈ interiorRoof
      (outsideGraph H (interiorRoof H B₀ F)) B₀ W.terminalSet :=
    by simpa [H, B₀, F] using htWambient
  have htX' : t ∈ X' := by
    exact quotientClosingSequence_subset_succ
      (outsideGraph G {a}) (A \ {a}) (B \ {a})
      T (outerBoundary G T) (unboundedTreeVertices G A B T a)
      (boundaryCertificateSet hT y)
      (boundaryCertificateSet hT)
      (boundedCertificateSet G A B T a) n ht.1
  have htB₀ : t ∉ B₀ := fun h => htB h.1
  have htU : t ∈ interiorRoof
      (outsideGraph H (interiorRoof H B₀ X')) B₀ U.terminalSet := by
    exact interiorRoof_terminalSet_subset_quotientWarpNested_of_mem
      W hFX' htX' htB₀ htW
  let M := maximalQuotientTotalWave H A₀ B₀ X'
  have hroofUM : roof (outsideGraph H (interiorRoof H B₀ X')) B₀
      U.terminalSet ⊆
      roof (outsideGraph H (interiorRoof H B₀ X')) B₀
        M.toWarp.terminalSet := by
    exact WaveExtension.roofLE_of_isMax
      (maximalQuotientTotalWave_isMax H A₀ B₀ X') U hUW
  have htM : t ∈ interiorRoof
      (outsideGraph H (interiorRoof H B₀ X')) B₀ M.toWarp.terminalSet :=
    interiorRoof_mono_of_roof_subset hroofUM htU
  have hX'L : X' ⊆ L :=
    safeTreeClosingSequence_subset_limit hT y (n + 1)
  have htFinal : t ∈ interiorRoof
      (outsideGraph H (interiorRoof H B₀ L)) B₀
      (Erdos599.Warp.quotientWarpNested M.toWarp hX'L).terminalSet := by
    exact interiorRoof_terminalSet_subset_quotientWarpNested_of_mem
      M.toWarp hX'L (hX'L htX') htB₀ htM
  simpa [H, B₀, X', L, M, safeTreeStageLimitWarp] using htFinal

/-- The Section 6 countable arrow-limit wave in the quotient by the closing
set `X`. -/
noncomputable def safeTreeLimitWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (safeTreeClosingLimit hT y))) :=
  WaveExtension.arrowLimit
    (fun n => safeTreeStageLimitWarp hT y n)
    (safeTreeStageLimitWarp_isWave hT y)

theorem safeTreeLimitWave_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeLimitWave hT y).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeClosingLimit hT y))
      (B \ {a}) := by
  exact WaveExtension.arrowLimit_isWave
    (fun n => safeTreeStageLimitWarp hT y n)
    (safeTreeStageLimitWarp_isWave hT y)

/-- The boundary certificate forces `y` under the roof of the first maximal
quotient wave.  This is condition (a) before the first wave is transported
to the final closing quotient. -/
theorem boundary_mem_roof_safeTreeStageZero {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    y.1 ∈ roof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (boundaryCertificateSet hT y)))
      (B \ {a})
      (maximalQuotientTotalWave (outsideGraph G {a})
        (A \ {a}) (B \ {a})
        (boundaryCertificateSet hT y)).toWarp.terminalSet := by
  classical
  let G₀ := outsideGraph G ({a} : Set V)
  let A₀ := A \ ({a} : Set V)
  let B₀ := B \ ({a} : Set V)
  let F := boundaryCertificateSet hT y
  rcases boundaryCertificateSet_has_totalWave hT y.property with
    ⟨Z, hyZ⟩
  have hZoriginal : ∃ Z₀ : TotalWave
      (outsideGraph G ({a} ∪ boundaryCertificateSet hT y))
      (A \ ({a} ∪ boundaryCertificateSet hT y))
      (B \ ({a} ∪ boundaryCertificateSet hT y)),
      y.1 ∈ Z₀.toWarp.terminalSet := ⟨Z, hyZ⟩
  have hZpair : ∃ Z₀ : TotalWave
      (outsideGraph G₀ F) (A₀ \ F) (B₀ \ F),
      y.1 ∈ Z₀.toWarp.terminalSet := by
    have hGraph : outsideGraph G₀ F =
        outsideGraph G ({a} ∪ boundaryCertificateSet hT y) := by
      simp [G₀, F]
    have hSource : A₀ \ F =
        A \ ({a} ∪ boundaryCertificateSet hT y) := by
      simp [A₀, F, Set.sdiff_sdiff]
    have hTarget : B₀ \ F =
        B \ ({a} ∪ boundaryCertificateSet hT y) := by
      simp [B₀, F, Set.sdiff_sdiff]
    rw [hGraph, hSource, hTarget]
    exact hZoriginal
  rcases hZpair with ⟨hZ, hyZ'⟩
  let W : Warp G₀ := hZ.toWarp.mapLE (outsideGraph_le G₀ F)
  let U : Warp (outsideGraph G₀ (interiorRoof G₀ B₀ F)) :=
    quotientWarp W B₀ F
  have hU : U.IsWave (quotientSource G₀ A₀ B₀ F) B₀ := by
    exact TotalWave.deletionQuotientWarp_isWave hZ
  by_cases hyInterior : y.1 ∈ interiorRoof G₀ B₀ F
  · intro b hb q hq
    cases q with
    | nil =>
        exact (Set.disjoint_left.mp
          (target_disjoint_interiorRoof G₀ B₀ F)
          hb hyInterior).elim
    | @cons _ z _ hyz r =>
        exact (hyz.2.1 hyInterior).elim
  · have hyW : y.1 ∈ W.terminalSet := by
      change y.1 ∈
        (hZ.toWarp.mapLE (outsideGraph_le G₀ F)).terminalSet
      rw [terminalSet_mapLE]
      exact hyZ'
    have hyU : y.1 ∈ U.terminalSet :=
      terminal_mem_quotientWarp_of_terminal_not_interior hyW hyInterior
    have hyRoofU : y.1 ∈ roof
        (outsideGraph G₀ (interiorRoof G₀ B₀ F)) B₀
        U.terminalSet :=
      subset_roof _ _ _ hyU
    exact WaveExtension.roofLE_of_isMax
      (maximalQuotientTotalWave_isMax G₀ A₀ B₀ F)
      U hU hyRoofU

/-- Condition (a) after the first maximal wave has been quotiented by the
whole closing limit and transported to the common final quotient graph. -/
theorem boundary_mem_roof_safeTreeStageLimitWarp_zero {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    y.1 ∈ roof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeClosingLimit hT y)))
      (B \ {a}) (safeTreeStageLimitWarp hT y 0).terminalSet := by
  let hsub : boundaryCertificateSet hT y ⊆
      safeTreeClosingLimit hT y :=
    boundaryCertificate_subset_safeTreeClosingLimit hT y
  have hy := roof_terminalSet_subset_roof_quotientWarpNested
    (maximalQuotientTotalWave (outsideGraph G {a})
      (A \ {a}) (B \ {a}) (boundaryCertificateSet hT y)).toWarp
    hsub (boundary_mem_roof_safeTreeStageZero hT y)
  simpa [safeTreeStageLimitWarp, safeTreeClosingSequence_zero] using hy

/-- Condition (a) for the actual countable arrow-limit wave: the selected
outer-boundary vertex is roofed by its terminal set. -/
theorem boundary_mem_roof_safeTreeLimitWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    y.1 ∈ roof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeClosingLimit hT y)))
      (B \ {a}) (safeTreeLimitWave hT y).terminalSet := by
  exact WaveExtension.roof_first_subset_roof_arrowLimit
    (fun n => safeTreeStageLimitWarp hT y n)
    (safeTreeStageLimitWarp_isWave hT y)
    (boundary_mem_roof_safeTreeStageLimitWarp_zero hT y)

/-- Condition (c) for the actual countable arrow-limit wave: every bounded
tree vertex in the closing set lies in the strict roof of the limit. -/
theorem safeTreeLimitWave_strictly_roofs_bounded
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (ht : t ∈ safeTreeClosingLimit hT y \
      unboundedTreeVertices G A B T a) :
    t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeClosingLimit hT y)))
      (B \ {a}) (safeTreeLimitWave hT y).terminalSet := by
  have htUnion : t ∈ ⋃ n, safeTreeClosingSequence hT y n := ht.1
  rcases Set.mem_iUnion.mp htUnion with ⟨n, htn⟩
  have htB : t ∉ B := fun htB =>
    Set.disjoint_left.mp hTB
      (safeTreeClosingLimit_subset_tree hT y
        (Set.mem_iUnion.mpr ⟨n, htn⟩)) htB
  let U := fun n => safeTreeStageLimitWarp hT y n
  let hU := safeTreeStageLimitWarp_isWave hT y
  have htStage : t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeClosingLimit hT y)))
      (B \ {a}) (U (n + 1)).terminalSet := by
    exact safeTreeStageLimitWarp_succ_strictly_roofs
      hT y n ⟨htn, ht.2⟩ htB
  have htFinite :=
    WaveExtension.interiorRoof_stage_subset_arrowSequence
      U hU (n + 1) htStage
  have htLimit :=
    WaveExtension.interiorRoof_arrowSequence_subset_interiorRoof_arrowLimit
      U hU (n + 1) htFinite
  simpa [safeTreeLimitWave, U, hU] using htLimit

/-- Causal condition (a) before the final arrow limit: the distinguished
boundary certificate wave remains roofing after quotienting by the full
causal set. -/
theorem boundary_mem_roof_safeTreeCausalFinalWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    y.1 ∈ roof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a})
      (safeTreeCausalFinalWarp hT y
        (safeTreeCausalBoundaryKey hT y)).terminalSet := by
  let k := safeTreeCausalBoundaryKey hT y
  have hsub : boundaryCertificateSet hT y.1 ⊆
      safeTreeCausalXLimit hT y :=
    safeTreeCausalKey_certificate_subset_limit hT y k.property
  have hy := roof_terminalSet_subset_roof_quotientWarpNested
    (maximalQuotientTotalWave (outsideGraph G {a})
      (A \ {a}) (B \ {a}) (boundaryCertificateSet hT y.1)).toWarp
    hsub (boundary_mem_roof_safeTreeStageZero hT y)
  simpa [safeTreeCausalFinalWarp, safeTreeCausalBoundaryKey, k,
    SafeTreeWaveKey.wave, SafeTreeWaveKey.certificateSet] using hy

theorem boundary_mem_roof_safeTreeCausalLimitWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    y.1 ∈ roof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a})
      (WaveExtension.safeTreeCausalLimitWave hT y).terminalSet := by
  exact WaveExtension.roof_first_subset_roof_arrowLimit
    (safeTreeCausalWaveSequence hT y)
    (safeTreeCausalWaveSequence_isWave hT y)
    (boundary_mem_roof_safeTreeCausalFinalWarp hT y)

/-- A bounded vertex of the final causal quotienting set is strictly roofed
by its own transported certificate wave. -/
theorem safeTreeCausalFinalWarp_strictly_roofs_bounded
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (ht : t ∈ safeTreeCausalXLimit hT y \
      unboundedTreeVertices G A B T a) :
    let k : SafeTreeWaveKey V := .bounded t
    let hk : k ∈ safeTreeCausalKeys hT y
        (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y) :=
      Or.inr ⟨t, ht, rfl⟩
    t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a})
      (safeTreeCausalFinalWarp hT y ⟨k, hk⟩).terminalSet := by
  dsimp only
  let H := outsideGraph G ({a} : Set V)
  let B₀ := B \ ({a} : Set V)
  let F := boundedCertificateSet G A B T a t
  let X := safeTreeCausalXLimit hT y
  have htT : t ∈ T :=
    (safeTreeCausalXLimit_subset_tree_sdiff hT y ht.1).1
  have htB : t ∉ B := fun htB => Set.disjoint_left.mp hTB htT htB
  have htRaw : t ∈ interiorRoof
      (outsideGraph H (interiorRoof H B₀ F)) B₀
      (boundedCertificateWave G A B T a t).terminalSet := by
    simpa [H, B₀, F] using
    boundedCertificateWave_strictly_roofs htT ht.2
  have hFX : F ⊆ X := by
    exact safeTreeCausalKey_certificate_subset_limit hT y
      (Or.inr ⟨t, ht, rfl⟩)
  have htFinal :=
    interiorRoof_terminalSet_subset_quotientWarpNested_of_mem
      (boundedCertificateWave G A B T a t) hFX ht.1
      (fun htB₀ => htB htB₀.1) htRaw
  simpa [safeTreeCausalFinalWarp, SafeTreeWaveKey.wave,
    SafeTreeWaveKey.certificateSet, H, B₀, F, X] using htFinal

/-- Causal condition (c) for the actual arrow limit. -/
theorem safeTreeCausalLimitWave_strictly_roofs_bounded
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (ht : t ∈ safeTreeCausalXLimit hT y \
      unboundedTreeVertices G A B T a) :
    t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a})
      (WaveExtension.safeTreeCausalLimitWave hT y).terminalSet := by
  let key : SafeTreeWaveKey V := .bounded t
  have hkey : key ∈ safeTreeCausalKeys hT y
      (safeTreeCausalXLimit hT y) (safeTreeCausalRLimit hT y) :=
    Or.inr ⟨t, ht, rfl⟩
  let k : SafeTreeCausalFinalKey hT y := ⟨key, hkey⟩
  rcases (safeTreeCausalKeyEnumeration hT y).2 k with ⟨n, hn⟩
  have htStage : t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a}) (safeTreeCausalWaveSequence hT y (n + 1)).terminalSet := by
    change t ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a})
      (safeTreeCausalFinalWarp hT y
        ((safeTreeCausalKeyEnumeration hT y).1 n)).terminalSet
    rw [hn]
    exact safeTreeCausalFinalWarp_strictly_roofs_bounded hT y hTB ht
  have htFinite :=
    WaveExtension.interiorRoof_stage_subset_arrowSequence
      (safeTreeCausalWaveSequence hT y)
      (safeTreeCausalWaveSequence_isWave hT y) (n + 1) htStage
  have htLimit :=
    WaveExtension.interiorRoof_arrowSequence_subset_interiorRoof_arrowLimit
      (safeTreeCausalWaveSequence hT y)
      (safeTreeCausalWaveSequence_isWave hT y) (n + 1) htFinite
  exact htLimit

/-- The essential components of the causal wave which meet the quotienting
set, denoted `E(W)⟨X⟩` in Section 6. -/
noncomputable def safeTreeCausalEssentialMeeting {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (safeTreeCausalXLimit hT y))) :=
  ((WaveExtension.safeTreeCausalLimitWave hT y).essential (B \ {a})).meeting
    (safeTreeCausalXLimit hT y)

/-- First half of Aharoni--Berger (6.5): every tree terminal of the
essential fractured warp is unbounded. -/
theorem safeTreeCausalEssentialMeeting_terminal_inter_tree_subset_unbounded
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    (safeTreeCausalEssentialMeeting hT y).terminalSet ∩ T ⊆
      unboundedTreeVertices G A B T a := by
  rintro t ⟨htTerminal, htT⟩
  rcases htTerminal with ⟨i, hit⟩
  let W := WaveExtension.safeTreeCausalLimitWave hT y
  have hiMeet : ∃ x ∈ (W.path i.1.1).vertexSet,
      x ∈ safeTreeCausalXLimit hT y := i.property
  rcases i.1.property with ⟨u, hiu, huEssential⟩
  have htu : t = u := Option.some.inj (hit.symm.trans hiu)
  have htEssential : t ∈ essentialVertices
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a}) W.terminalSet := htu ▸ huEssential
  have htMeeting : t ∈
      (W.meeting (safeTreeCausalXLimit hT y)).vertexSet := by
    rw [Warp.meeting, Warp.vertexSet_restrictIndices]
    exact ⟨i.1.1, hiMeet, LongPath.terminal_mem_vertexSet hit⟩
  have htX : t ∈ safeTreeCausalXLimit hT y :=
    WaveExtension.safeTreeCausalLimit_meeting_inter_tree_subset_XLimit
      hT y ⟨htMeeting, htT⟩
  refine ⟨htT, ?_⟩
  intro htBounded
  have htNotQ : t ∉ unboundedTreeVertices G A B T a := by
    intro htQ
    exact htQ.2 htBounded
  have htStrict := safeTreeCausalLimitWave_strictly_roofs_bounded
    hT y hTB ⟨htX, htNotQ⟩
  exact Set.disjoint_left.mp
    (interiorRoof_disjoint
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a}) W.terminalSet)
    htStrict htEssential

/-- Second half of (6.5): an unbounded tree vertex on an essential
fractured component can occur only as that component's terminal. -/
theorem safeTreeCausalEssentialMeeting_vertex_inter_unbounded_subset_terminal
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalEssentialMeeting hT y).vertexSet ∩
      unboundedTreeVertices G A B T a ⊆
        (safeTreeCausalEssentialMeeting hT y).terminalSet := by
  rintro q ⟨hqVertex, hqQ⟩
  rcases hqVertex with ⟨i, hqi⟩
  let W := WaveExtension.safeTreeCausalLimitWave hT y
  rcases i.1.property with ⟨t, hit, htEssential⟩
  by_cases hiq : (W.path i.1.1).terminal? = some q
  · exact ⟨i, hiq⟩
  · have hqt : q ≠ t := by
      intro hqt
      apply hiq
      simpa [hqt] using hit
    have hqStrict : q ∈ interiorRoof
        (outsideGraph (outsideGraph G {a})
          (interiorRoof (outsideGraph G {a}) (B \ {a})
            (safeTreeCausalXLimit hT y)))
        (B \ {a}) W.terminalSet := by
      exact (WaveExtension.safeTreeCausalLimitWave_isWave hT y
        ).path_sdiff_terminal_subset_interiorRoof hit ⟨hqi, by simpa using hqt⟩
    have hqBounded : IsBoundedTreeVertex G A B T a q := by
      refine ⟨{
        vertices := safeTreeCausalXLimit hT y
        countable_vertices := safeTreeCausalXLimit_countable hT y
        vertices_subset_tree := safeTreeCausalXLimit_subset_tree_sdiff hT y
        wave := W
        isWave := WaveExtension.safeTreeCausalLimitWave_isWave hT y
        strictly_roofs := hqStrict }⟩
    exact (hqQ.2 hqBounded).elim

/-- The second inclusion of (6.5) holds on every essential component, not
only after explicitly restricting to components meeting `X`: an internal
unbounded point would make the countable final quotient itself a boundedness
certificate. -/
theorem safeTreeCausalEssential_path_unbounded_eq_terminal
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a q : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T)
    (i : (WaveExtension.safeTreeCausalLimitWave hT y).EssentialIndex
      (B \ {a}))
    (hqi : q ∈ ((WaveExtension.safeTreeCausalLimitWave hT y).path i.1).vertexSet)
    (hqQ : q ∈ unboundedTreeVertices G A B T a) :
    ∃ t, ((WaveExtension.safeTreeCausalLimitWave hT y).path i.1).terminal? =
      some t ∧ q = t := by
  let W := WaveExtension.safeTreeCausalLimitWave hT y
  rcases i.property with ⟨t, hit, htEssential⟩
  refine ⟨t, hit, ?_⟩
  by_contra hqt
  have hqStrict : q ∈ interiorRoof
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (B \ {a}) W.terminalSet := by
    exact (WaveExtension.safeTreeCausalLimitWave_isWave hT y
      ).path_sdiff_terminal_subset_interiorRoof hit ⟨hqi, by simpa using hqt⟩
  have hqBounded : IsBoundedTreeVertex G A B T a q := by
    refine ⟨{
      vertices := safeTreeCausalXLimit hT y
      countable_vertices := safeTreeCausalXLimit_countable hT y
      vertices_subset_tree := safeTreeCausalXLimit_subset_tree_sdiff hT y
      wave := W
      isWave := WaveExtension.safeTreeCausalLimitWave_isWave hT y
      strictly_roofs := hqStrict }⟩
  exact hqQ.2 hqBounded

/-- Discard precisely the essential components whose terminal belongs to
the unbounded tree set `Q`. -/
noncomputable def safeTreeCausalEssentialAwayUnbounded {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Warp (outsideGraph (outsideGraph G {a})
      (interiorRoof (outsideGraph G {a}) (B \ {a})
        (safeTreeCausalXLimit hT y))) :=
  let E := (WaveExtension.safeTreeCausalLimitWave hT y).essential (B \ {a})
  E.restrictIndices {i | ∃ t, (E.path i).terminal? = some t ∧
    t ∉ unboundedTreeVertices G A B T a}

theorem safeTreeCausalEssentialAwayUnbounded_disjoint {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Disjoint (safeTreeCausalEssentialAwayUnbounded hT y).vertexSet
      (unboundedTreeVertices G A B T a) := by
  rw [Set.disjoint_left]
  rintro q ⟨i, hqi⟩ hqQ
  rcases i.property with ⟨t, hit, htNotQ⟩
  have hqt := safeTreeCausalEssential_path_unbounded_eq_terminal
    hT y i.1 hqi hqQ
  rcases hqt with ⟨u, hiu, hqu⟩
  have htu : t = u := Option.some.inj (hit.symm.trans hiu)
  exact htNotQ (htu ▸ hqu ▸ hqQ)

noncomputable def safeTreeCausalEssentialGroundWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Warp (outsideGraph
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y)))
      (unboundedTreeVertices G A B T a)) :=
  (safeTreeCausalEssentialAwayUnbounded hT y).toOutsideGraph
    (safeTreeCausalEssentialAwayUnbounded_disjoint hT y)

/-- After deleting `Q`, the retained essential components remain a wave.
Any exterior path is separated by the full essential wave, and its meeting
terminal cannot be one of the deleted vertices. -/
theorem safeTreeCausalEssentialGroundWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalEssentialGroundWarp hT y).IsWave
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y) \
          unboundedTreeVertices G A B T a)
      ((B \ {a}) \ unboundedTreeVertices G A B T a) := by
  let W := WaveExtension.safeTreeCausalLimitWave hT y
  let E := W.essential (B \ {a})
  let R := safeTreeCausalEssentialAwayUnbounded hT y
  let Q := unboundedTreeVertices G A B T a
  let S := quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
    (safeTreeCausalXLimit hT y)
  have hE : E.IsWave S (B \ {a}) := by
    exact (WaveExtension.safeTreeCausalLimitWave_isWave hT y).essential
  have hRQ : Disjoint R.vertexSet Q :=
    safeTreeCausalEssentialAwayUnbounded_disjoint hT y
  constructor
  · change R.initialSet ⊆ S \ Q
    intro v hv
    have hvE : v ∈ E.initialSet := by
      change v ∈ (E.restrictIndices {i | ∃ t,
        (E.path i).terminal? = some t ∧ t ∉ Q}).initialSet at hv
      exact E.initialSet_restrictIndices_subset _ hv
    refine ⟨hE.1 hvE, ?_⟩
    intro hvQ
    exact Set.disjoint_left.mp hRQ (R.initialSet_subset_vertexSet hv) hvQ
  · intro s hs b hb p hp
    let pE := p.mapLe (outsideGraph_le
      (outsideGraph (outsideGraph G {a})
        (interiorRoof (outsideGraph G {a}) (B \ {a})
          (safeTreeCausalXLimit hT y))) Q)
    have hpE : pE.IsPath := hp.mapLe _
    rcases hE.2 s hs.1 b hb.1 pE hpE with ⟨z, hzp, hzE⟩
    have hzp' : z ∈ p.support := by
      simpa [pE, Walk.support_mapLe_eq_support] using hzp
    have hzNotQ : z ∉ Q :=
      Erdos599.Walk.vertex_not_mem_of_outsideGraph p hs.2 hzp'
    rcases hzE with ⟨j, hjz⟩
    refine ⟨z, hzp', ?_⟩
    change z ∈ R.terminalSet
    exact ⟨⟨j, z, hjz, hzNotQ⟩, hjz⟩

theorem safeTreeCausalEssentialGroundWarp_isSourceClean {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    (safeTreeCausalEssentialGroundWarp hT y).IsSourceClean
      (quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
        (safeTreeCausalXLimit hT y) \
          unboundedTreeVertices G A B T a) := by
  let W := WaveExtension.safeTreeCausalLimitWave hT y
  let E := W.essential (B \ {a})
  let R := safeTreeCausalEssentialAwayUnbounded hT y
  let Q := unboundedTreeVertices G A B T a
  let S := quotientSource (outsideGraph G {a}) (A \ {a}) (B \ {a})
    (safeTreeCausalXLimit hT y)
  have hEclean : E.IsSourceClean S := by
    intro i v hv hvS
    exact WaveExtension.safeTreeCausalLimitWave_isSourceClean hT y
      i.1 v hv hvS
  have hRclean : R.IsSourceClean S := by
    exact hEclean.restrictIndices _
  have hRcleanQ : R.IsSourceClean (S \ Q) := by
    intro i v hv hvSQ
    exact hRclean i v hv hvSQ.1
  exact hRcleanQ.toOutsideGraph
    (safeTreeCausalEssentialAwayUnbounded_disjoint hT y)

/-- Condition (a) survives discarding the `Q`-terminal components and
passing to the exterior graph. -/
theorem boundary_mem_roof_safeTreeCausalEssentialGroundWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    y.1 ∈ roof
      (outsideGraph
        (outsideGraph (outsideGraph G {a})
          (interiorRoof (outsideGraph G {a}) (B \ {a})
            (safeTreeCausalXLimit hT y)))
        (unboundedTreeVertices G A B T a))
      ((B \ {a}) \ unboundedTreeVertices G A B T a)
      (safeTreeCausalEssentialGroundWarp hT y).terminalSet := by
  let W := WaveExtension.safeTreeCausalLimitWave hT y
  let E := W.essential (B \ {a})
  let R := safeTreeCausalEssentialAwayUnbounded hT y
  let Q := unboundedTreeVertices G A B T a
  let H := outsideGraph (outsideGraph G {a})
    (interiorRoof (outsideGraph G {a}) (B \ {a})
      (safeTreeCausalXLimit hT y))
  have hyW := boundary_mem_roof_safeTreeCausalLimitWave hT y
  have hyE : y.1 ∈ roof H (B \ {a}) E.terminalSet := by
    rw [Warp.terminalSet_essential]
    simpa [E, H] using
      (show y.1 ∈ roof H (B \ {a})
        (essentialVertices H (B \ {a}) W.terminalSet) by
        simpa [H] using
          (show y.1 ∈ roof H (B \ {a}) W.terminalSet from hyW))
  intro b hb p hp
  have hyNotQ : y.1 ∉ Q := by
    intro hyQ
    exact y.property.1 hyQ.1
  let pE := p.mapLe (outsideGraph_le H Q)
  have hpE : pE.IsPath := hp.mapLe _
  rcases hyE b hb.1 pE hpE with ⟨z, hzp, hzE⟩
  have hzp' : z ∈ p.support := by
    simpa [pE, Walk.support_mapLe_eq_support] using hzp
  have hzNotQ : z ∉ Q :=
    Erdos599.Walk.vertex_not_mem_of_outsideGraph p hyNotQ hzp'
  rcases hzE with ⟨j, hjz⟩
  refine ⟨z, hzp', ?_⟩
  change z ∈ R.terminalSet
  exact ⟨⟨j, z, hjz, hzNotQ⟩, hjz⟩

/-- A total enumeration of the countable quotienting set, using `none` to
cover the empty-set case uniformly. -/
noncomputable def safeTreeCausalXEnumeration {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    {e : ℕ → Option (safeTreeCausalXLimit hT y) // Function.Surjective e} := by
  letI : Countable (safeTreeCausalXLimit hT y) :=
    (safeTreeCausalXLimit_countable hT y).to_subtype
  let h := exists_surjective_nat (Option (safeTreeCausalXLimit hT y))
  exact ⟨Classical.choose h, Classical.choose_spec h⟩

/-- One finite stage in the quotient-to-ground recursion. -/
structure GroundWaveStage {V : Type} (H : SimpleGraph V)
    (A B X : Set V) where
  deleted : Set V
  finite_deleted : deleted.Finite
  deleted_subset : deleted ⊆ X
  wave : TotalWave (outsideGraph H deleted) A B
  roof_maximal : ∀ U : Warp (outsideGraph H deleted),
    U.IsWave A B → RoofLE B U wave.toWarp

/-- Process one optional point of `X`: a point already on the accumulated
wave is skipped; otherwise it is deleted and a new maximal wave is
arrow-composed in the enlarged finite deletion web. -/
noncomputable def groundWaveStep {V : Type} {H : SimpleGraph V}
    {A B X : Set V} (hAX : Disjoint A X) (hBX : Disjoint B X)
    (s : GroundWaveStage H A B X) (ox : Option X) :
    GroundWaveStage H A B X := by
  classical
  cases ox with
  | none => exact s
  | some x =>
      by_cases hx : (x : V) ∈ s.wave.toWarp.vertexSet
      · exact s
      · let D' : Set V := insert (x : V) s.deleted
        have hfinite : D'.Finite := s.finite_deleted.insert (x : V)
        have hsubset : D' ⊆ X := by
          intro v hv
          rcases hv with hvx | hvD
          · simpa [hvx] using x.property
          · exact s.deleted_subset hvD
        have hout : Disjoint s.wave.toWarp.vertexSet ({x.1} : Set V) := by
          rw [Set.disjoint_left]
          intro v hv hvx
          exact hx (Set.mem_singleton_iff.mp hvx ▸ hv)
        have hApoint : Disjoint A ({x.1} : Set V) := by
          rw [Set.disjoint_left]
          intro v hvA hvx
          exact Set.disjoint_left.mp hAX hvA
            (Set.mem_singleton_iff.mp hvx ▸ x.property)
        have hBpoint : Disjoint B ({x.1} : Set V) := by
          rw [Set.disjoint_left]
          intro v hvB hvx
          exact Set.disjoint_left.mp hBX hvB
            (Set.mem_singleton_iff.mp hvx ▸ x.property)
        let C₀ := s.wave.toOutsideGraphSame hout hApoint hBpoint
        have hGraph : outsideGraph (outsideGraph H s.deleted) {x.1} =
            outsideGraph H D' := by
          simp [D', outsideGraph_outsideGraph, Set.union_comm]
        let C : TotalWave (outsideGraph H D') A B :=
          TotalWave.castGraph hGraph C₀
        let M := Classical.choose
          (TotalWave.exists_isMax (outsideGraph H D') A B)
        have hMmax : IsMax M := Classical.choose_spec
          (TotalWave.exists_isMax (outsideGraph H D') A B)
        let N : TotalWave (outsideGraph H D') A B :=
          C.arrowExtension M.toWarp M.isWave
        exact {
          deleted := D'
          finite_deleted := hfinite
          deleted_subset := hsubset
          wave := N
          roof_maximal := by
            intro U hU
            have hUM : RoofLE B U M.toWarp :=
              WaveExtension.roofLE_of_isMax hMmax U hU
            have hMN : RoofLE B M.toWarp N.toWarp := by
              have hterm : N.toWarp.terminalSet =
                  (arrow C.toWarp M.toWarp).terminalSet := by
                simpa [N] using
                  (WaveExtension.terminalSet_toWarp_arrowExtension
                    C M.toWarp M.isWave)
              intro v hv
              rw [hterm]
              exact C.isWave.roof_right_subset_arrow M.isWave hv
            exact hUM.trans hMN }

def GroundWaveStage.ambientWarp {V : Type} {H : SimpleGraph V}
    {A B X : Set V} (s : GroundWaveStage H A B X) : Warp H :=
  s.wave.toWarp.mapLE (outsideGraph_le H s.deleted)

theorem groundWaveStep_deleted_mono {V : Type} {H : SimpleGraph V}
    {A B X : Set V} (hAX : Disjoint A X) (hBX : Disjoint B X)
    (s : GroundWaveStage H A B X) (ox : Option X) :
    s.deleted ⊆ (groundWaveStep hAX hBX s ox).deleted := by
  classical
  cases ox with
  | none => exact Set.Subset.rfl
  | some x =>
      by_cases hx : (x : V) ∈ s.wave.toWarp.vertexSet
      · simpa [groundWaveStep, hx]
      · simp only [groundWaveStep, hx, dite_false]
        exact Set.subset_insert (x : V) s.deleted

theorem groundWaveStep_processed {V : Type} {H : SimpleGraph V}
    {A B X : Set V} (hAX : Disjoint A X) (hBX : Disjoint B X)
    (s : GroundWaveStage H A B X) (x : X) :
    (x : V) ∈ (groundWaveStep hAX hBX s (some x)).deleted ∨
      (x : V) ∈ s.wave.toWarp.vertexSet := by
  classical
  by_cases hx : (x : V) ∈ s.wave.toWarp.vertexSet
  · exact Or.inr hx
  · left
    simp [groundWaveStep, hx]

/-- One ground step extends every accumulated ambient path pointwise. -/
theorem groundWaveStep_ambient_forward {V : Type} {H : SimpleGraph V}
    {A B X : Set V} (hAX : Disjoint A X) (hBX : Disjoint B X)
    (s : GroundWaveStage H A B X) (ox : Option X) (i : A) :
    (s.ambientWarp.path i).Forward
      ((groundWaveStep hAX hBX s ox).ambientWarp.path i) := by
  classical
  cases ox with
  | none => exact LongPath.Forward.refl _
  | some x =>
      simp only [groundWaveStep]
      by_cases hx : (x : V) ∈ s.wave.toWarp.vertexSet
      · rw [dif_pos hx]
        exact LongPath.Forward.refl _
      ·
        rw [dif_neg hx]
        let D' : Set V := insert (x : V) s.deleted
        have hout : Disjoint s.wave.toWarp.vertexSet ({x.1} : Set V) := by
          rw [Set.disjoint_left]
          intro v hv hvx
          exact hx (Set.mem_singleton_iff.mp hvx ▸ hv)
        have hApoint : Disjoint A ({x.1} : Set V) := by
          rw [Set.disjoint_left]
          intro v hvA hvx
          exact Set.disjoint_left.mp hAX hvA
            (Set.mem_singleton_iff.mp hvx ▸ x.property)
        have hBpoint : Disjoint B ({x.1} : Set V) := by
          rw [Set.disjoint_left]
          intro v hvB hvx
          exact Set.disjoint_left.mp hBX hvB
            (Set.mem_singleton_iff.mp hvx ▸ x.property)
        let C₀ := s.wave.toOutsideGraphSame hout hApoint hBpoint
        have hGraph : outsideGraph (outsideGraph H s.deleted) {x.1} =
            outsideGraph H D' := by
          simp [D', outsideGraph_outsideGraph, Set.union_comm]
        let C : TotalWave (outsideGraph H D') A B :=
          TotalWave.castGraph hGraph C₀
        let M := Classical.choose
          (TotalWave.exists_isMax (outsideGraph H D') A B)
        have hforward := WaveExtension.le_arrowExtension
          C M.toWarp M.isWave i
        intro n hn
        have hnS : longPathActive (s.wave.path i).1.terminalIndex n := hn
        have hnC : longPathActive (C.path i).1.terminalIndex n := by
          simpa [C, C₀] using hnS
        rcases hforward n hnC with ⟨hnN, hvN⟩
        constructor
        · exact hnN
        · simpa [C, C₀, GroundWaveStage.ambientWarp, Warp.mapLE,
            LongPath.mapLE, WaveExtension.toWarp, Warp.ofPaths] using hvN

theorem safeTreeGround_source_disjoint_X {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) :
    Disjoint (A \ {a}) (safeTreeCausalXLimit hT y) := by
  rw [Set.disjoint_left]
  intro x hxA hxX
  have hxTree := safeTreeCausalXLimit_subset_tree_sdiff hT y hxX
  have hxa := hT.prop.2.1 x hxTree.1 hxA.1
  exact hxA.2 (by simpa [hxa])

theorem safeTreeGround_target_disjoint_X {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    Disjoint (B \ {a}) (safeTreeCausalXLimit hT y) := by
  rw [Set.disjoint_left]
  intro x hxB hxX
  exact Set.disjoint_left.mp hTB
    (safeTreeCausalXLimit_subset_tree_sdiff hT y hxX).1 hxB.1

/-- The safe-tree invariant, restated in the root-deleted web.  Since the
causal closing set contains neither residual sources nor residual targets,
deleting one of its finite subsets does not change either side of the web. -/
theorem safeTree_isCleanUnhindered_after_finite_X_deletion {V : Type}
    {G : SimpleGraph V} {A B T E : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (hEfinite : E.Finite) (hEX : E ⊆ safeTreeCausalXLimit hT y) :
    IsCleanUnhindered (outsideGraph (outsideGraph G {a}) E)
      (A \ {a}) (B \ {a}) := by
  have hET : E ⊆ T \ {a} :=
    hEX.trans (safeTreeCausalXLimit_subset_tree_sdiff hT y)
  have hsafe := hT.prop.2.2.2 E hEfinite hET
  have hAE : Disjoint (A \ {a}) E := by
    exact (safeTreeGround_source_disjoint_X hT y).mono_right hEX
  have hBE : Disjoint (B \ {a}) E := by
    exact (safeTreeGround_target_disjoint_X hT y hTB).mono_right hEX
  have hAeq : A \ ({a} ∪ E) = A \ {a} := by
    rw [← Set.sdiff_sdiff, sdiff_eq_self_iff_disjoint]
    exact hAE.symm
  have hBeq : B \ ({a} ∪ E) = B \ {a} := by
    rw [← Set.sdiff_sdiff, sdiff_eq_self_iff_disjoint]
    exact hBE.symm
  rw [show outsideGraph (outsideGraph G {a}) E =
      outsideGraph G ({a} ∪ E) by simp [outsideGraph_outsideGraph]]
  rw [← hAeq, ← hBeq]
  exact hsafe

noncomputable def safeTreeGroundStages {V : Type} {G : SimpleGraph V}
    {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) : ℕ →
    GroundWaveStage (outsideGraph G {a}) (A \ {a}) (B \ {a})
      (safeTreeCausalXLimit hT y)
  | 0 => {
      deleted := ∅
      finite_deleted := Set.finite_empty
      deleted_subset := Set.empty_subset _
      wave := Classical.choose
        (TotalWave.exists_isMax
          (outsideGraph (outsideGraph G {a}) ∅) (A \ {a}) (B \ {a}))
      roof_maximal := by
        intro U hU
        exact WaveExtension.roofLE_of_isMax
          (Classical.choose_spec
            (TotalWave.exists_isMax
              (outsideGraph (outsideGraph G {a}) ∅)
              (A \ {a}) (B \ {a}))) U hU }
  | n + 1 => groundWaveStep
      (safeTreeGround_source_disjoint_X hT y)
      (safeTreeGround_target_disjoint_X hT y hTB)
      (safeTreeGroundStages hT y hTB n)
      ((safeTreeCausalXEnumeration hT y).1 n)

noncomputable def safeTreeGroundDeletedLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) : Set V :=
  ⋃ n, (safeTreeGroundStages hT y hTB n).deleted

theorem safeTreeGround_deleted_subset_succ {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    (safeTreeGroundStages hT y hTB n).deleted ⊆
      (safeTreeGroundStages hT y hTB (n + 1)).deleted := by
  simpa [safeTreeGroundStages] using groundWaveStep_deleted_mono
    (safeTreeGround_source_disjoint_X hT y)
    (safeTreeGround_target_disjoint_X hT y hTB)
    (safeTreeGroundStages hT y hTB n)
    ((safeTreeCausalXEnumeration hT y).1 n)

theorem safeTreeGround_deleted_mono {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    {m n : ℕ} (hmn : m ≤ n) :
    (safeTreeGroundStages hT y hTB m).deleted ⊆
      (safeTreeGroundStages hT y hTB n).deleted := by
  induction n, hmn using Nat.le_induction with
  | base => exact Set.Subset.rfl
  | succ n hmn ih =>
      exact ih.trans (safeTreeGround_deleted_subset_succ hT y hTB n)

theorem safeTreeGround_ambient_forward_succ {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (n : ℕ) (i : ↥(A \ {a})) :
    ((safeTreeGroundStages hT y hTB n).ambientWarp.path i).Forward
      ((safeTreeGroundStages hT y hTB (n + 1)).ambientWarp.path i) := by
  simpa [safeTreeGroundStages] using groundWaveStep_ambient_forward
    (safeTreeGround_source_disjoint_X hT y)
    (safeTreeGround_target_disjoint_X hT y hTB)
    (safeTreeGroundStages hT y hTB n)
    ((safeTreeCausalXEnumeration hT y).1 n) i

theorem safeTreeGround_ambient_forward_mono {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    {m n : ℕ} (hmn : m ≤ n) (i : ↥(A \ {a})) :
    ((safeTreeGroundStages hT y hTB m).ambientWarp.path i).Forward
      ((safeTreeGroundStages hT y hTB n).ambientWarp.path i) := by
  induction n, hmn using Nat.le_induction with
  | base => exact LongPath.Forward.refl _
  | succ n hmn ih =>
      exact ih.trans (safeTreeGround_ambient_forward_succ hT y hTB n i)

theorem safeTreeGroundDeletedLimit_subset_X {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    safeTreeGroundDeletedLimit hT y hTB ⊆ safeTreeCausalXLimit hT y := by
  intro v hv
  change v ∈ ⋃ n : ℕ, (safeTreeGroundStages hT y hTB n).deleted at hv
  rcases Set.mem_iUnion.mp hv with ⟨n, hv⟩
  exact (safeTreeGroundStages hT y hTB n).deleted_subset hv

theorem safeTreeCausalEssentialGroundWarp_terminalSet_disjoint_groundDeleted
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    Disjoint (safeTreeCausalEssentialGroundWarp hT y).terminalSet
      (safeTreeGroundDeletedLimit hT y hTB) := by
  rw [Set.disjoint_left]
  rintro r ⟨j, hjr⟩ hrR
  rcases j.property with ⟨t, hjt, htQ⟩
  have htr : t = r := Option.some.inj (hjt.symm.trans hjr)
  have hrX : r ∈ safeTreeCausalXLimit hT y :=
    safeTreeGroundDeletedLimit_subset_X hT y hTB hrR
  have hrT : r ∈ T :=
    (safeTreeCausalXLimit_subset_tree_sdiff hT y hrX).1
  let jm : (safeTreeCausalEssentialMeeting hT y).ι :=
    ⟨j.1, ⟨r, LongPath.terminal_mem_vertexSet hjr, hrX⟩⟩
  have hrMeeting : r ∈ (safeTreeCausalEssentialMeeting hT y).terminalSet :=
    ⟨jm, hjr⟩
  have hrQ :=
    safeTreeCausalEssentialMeeting_terminal_inter_tree_subset_unbounded
      hT y hTB ⟨hrMeeting, hrT⟩
  exact htQ (htr ▸ hrQ)

theorem safeTreeGround_deleted_subset_limit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    (safeTreeGroundStages hT y hTB n).deleted ⊆
      safeTreeGroundDeletedLimit hT y hTB := by
  intro v hv
  exact Set.mem_iUnion.mpr ⟨n, hv⟩

theorem GroundWaveStage.ambientWarp_disjoint_deleted
    {V : Type} {H : SimpleGraph V} {A B X : Set V}
    (s : GroundWaveStage H A B X) (hAX : Disjoint A X) :
    Disjoint s.ambientWarp.vertexSet s.deleted := by
  change Disjoint s.wave.toWarp.vertexSet s.deleted
  apply Warp.vertexSet_disjoint_of_outside_initialSet
  rw [TotalWave.initialSet_toWarp]
  rw [Set.disjoint_left]
  intro v hvA hvD
  exact Set.disjoint_left.mp hAX hvA (s.deleted_subset hvD)

theorem safeTreeGroundStage_disjoint_deletedLimit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    Disjoint (safeTreeGroundStages hT y hTB n).ambientWarp.vertexSet
      (safeTreeGroundDeletedLimit hT y hTB) := by
  rw [Set.disjoint_left]
  intro v hv hvl
  change v ∈ ⋃ m : ℕ, (safeTreeGroundStages hT y hTB m).deleted at hvl
  rcases Set.mem_iUnion.mp hvl with ⟨m, hvm⟩
  rcases le_total n m with hnm | hmn
  · rcases hv with ⟨i, hvi⟩
    have hvi' := (safeTreeGround_ambient_forward_mono
      hT y hTB hnm i).vertexSet_subset hvi
    exact Set.disjoint_left.mp
      ((safeTreeGroundStages hT y hTB m).ambientWarp_disjoint_deleted
        (safeTreeGround_source_disjoint_X hT y)) ⟨i, hvi'⟩ hvm
  · have hvm' := safeTreeGround_deleted_mono hT y hTB hmn hvm
    exact Set.disjoint_left.mp
      ((safeTreeGroundStages hT y hTB n).ambientWarp_disjoint_deleted
        (safeTreeGround_source_disjoint_X hT y)) hv hvm'

/-- Every finite ground stage, reinterpreted after the union of all deletions,
is a wave in one fixed exterior graph. -/
noncomputable def safeTreeGroundCommonWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    Warp (outsideGraph (outsideGraph G {a})
      (safeTreeGroundDeletedLimit hT y hTB)) :=
  (safeTreeGroundStages hT y hTB n).ambientWarp.toOutsideGraph
    (safeTreeGroundStage_disjoint_deletedLimit hT y hTB n)

theorem safeTreeGroundCommonWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    (safeTreeGroundCommonWarp hT y hTB n).IsWave
      (A \ {a}) (B \ {a}) := by
  let s := safeTreeGroundStages hT y hTB n
  let R := safeTreeGroundDeletedLimit hT y hTB
  have hDR : s.deleted ⊆ R :=
    safeTreeGround_deleted_subset_limit hT y hTB n
  have hle : outsideGraph (outsideGraph G {a}) R ≤
      outsideGraph (outsideGraph G {a}) s.deleted :=
    outsideGraph_antitone (outsideGraph G {a}) hDR
  have hs := s.wave.isWave
  constructor
  · rintro v ⟨i, hiv⟩
    apply hs.1
    refine ⟨i, ?_⟩
    exact hiv
  · intro u hu v hv q hq
    let q' := q.mapLe hle
    have hq' : q'.IsPath := hq.mapLe hle
    rcases hs.2 u hu v hv q' hq' with ⟨z, hzq, hzterm⟩
    refine ⟨z, ?_, ?_⟩
    · simpa [q', Walk.support_mapLe_eq_support] using hzq
    · rcases hzterm with ⟨i, hiz⟩
      exact ⟨i, hiz⟩

theorem safeTreeGroundCommonWarp_isSourceClean {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    (safeTreeGroundCommonWarp hT y hTB n).IsSourceClean (A \ {a}) := by
  let s := safeTreeGroundStages hT y hTB n
  have hambient : s.ambientWarp.IsSourceClean (A \ {a}) :=
    s.wave.isSourceClean.mapLE (outsideGraph_le (outsideGraph G {a}) s.deleted)
  exact hambient.toOutsideGraph
    (safeTreeGroundStage_disjoint_deletedLimit hT y hTB n)

/-- A roof proved in the graph of a finite ground stage remains a roof in
the common graph obtained after all ground deletions. -/
theorem safeTreeGroundStage_roof_subset_common {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundStages hT y hTB n).deleted)
      (B \ {a}) (safeTreeGroundStages hT y hTB n).wave.toWarp.terminalSet ⊆
    roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB))
      (B \ {a}) (safeTreeGroundCommonWarp hT y hTB n).terminalSet := by
  have hle : outsideGraph (outsideGraph G {a})
      (safeTreeGroundDeletedLimit hT y hTB) ≤
      outsideGraph (outsideGraph G {a})
        (safeTreeGroundStages hT y hTB n).deleted :=
    outsideGraph_antitone (outsideGraph G {a})
      (safeTreeGround_deleted_subset_limit hT y hTB n)
  have hroof := roof_antitone_graph hle (B \ {a})
    (safeTreeGroundStages hT y hTB n).wave.toWarp.terminalSet
  simpa [safeTreeGroundCommonWarp, GroundWaveStage.ambientWarp] using hroof

theorem safeTreeGroundCommonWarp_forward {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    {m n : ℕ} (hmn : m ≤ n) (i : ↥(A \ {a})) :
    ((safeTreeGroundCommonWarp hT y hTB m).path i).Forward
      ((safeTreeGroundCommonWarp hT y hTB n).path i) := by
  intro k hk
  have hf := safeTreeGround_ambient_forward_mono hT y hTB hmn i k hk
  exact hf

/-- The ground wave obtained by taking the pointwise direct limit of the
finite-deletion stages. -/
noncomputable def safeTreeGroundLimitWarp {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    Warp (outsideGraph (outsideGraph G {a})
      (safeTreeGroundDeletedLimit hT y hTB)) :=
  Warp.limitOfPaths
    (fun n i => (safeTreeGroundCommonWarp hT y hTB n).path i)
    (fun i _ _ hmn => safeTreeGroundCommonWarp_forward hT y hTB hmn i)
    (fun n => (safeTreeGroundCommonWarp hT y hTB n).disjoint)

theorem safeTreeGroundLimitWarp_isWave {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    (safeTreeGroundLimitWarp hT y hTB).IsWave
      (A \ {a}) (B \ {a}) := by
  unfold safeTreeGroundLimitWarp
  exact Warp.IsWave.limitOfPathChain
    (fun n i => (safeTreeGroundCommonWarp hT y hTB n).path i)
    (fun i _ _ hmn => safeTreeGroundCommonWarp_forward hT y hTB hmn i)
    (fun n => (safeTreeGroundCommonWarp hT y hTB n).disjoint)
    (fun n => safeTreeGroundCommonWarp_isWave hT y hTB n)

theorem safeTreeGroundLimitWarp_isSourceClean {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    (safeTreeGroundLimitWarp hT y hTB).IsSourceClean (A \ {a}) := by
  let P : ℕ → ↥(A \ {a}) → LongPath
      (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB)) :=
    fun n i => (safeTreeGroundCommonWarp hT y hTB n).path i
  have hchain : ∀ i ⦃m n : ℕ⦄, m ≤ n → (P m i).Forward (P n i) :=
    fun i _ _ hmn => safeTreeGroundCommonWarp_forward hT y hTB hmn i
  intro i v hv hvA
  change v ∈ (LongPath.limit (fun n => P n i) (hchain i)).vertexSet at hv
  rcases hv with ⟨k, hkLimit, hkv⟩
  rcases (LongPath.active_limitTerminalIndex_iff (fun n => P n i) k).mp
      hkLimit with ⟨n, hkn⟩
  have hvn : v ∈ (P n i).vertexSet := by
    refine ⟨k, hkn, ?_⟩
    exact (LongPath.limitVertex_eq_of_active
      (fun n => P n i) (hchain i) hkn).symm.trans hkv
  have hstage := safeTreeGroundCommonWarp_isSourceClean hT y hTB n
    i v hvn hvA
  have hzero : longPathActive (P n i).terminalIndex 0 := by
    cases (P n i).terminalIndex <;> simp [longPathActive]
  have hforward := Warp.path_forward_limitOfPaths
    (fun n i => P n i) hchain
    (fun n => (safeTreeGroundCommonWarp hT y hTB n).disjoint) n i 0 hzero
  change v = (LongPath.limit (fun n => P n i) (hchain i)).initial
  exact hstage.trans (by
    change (P n i).vertex 0 =
      (LongPath.limit (fun n => P n i) (hchain i)).vertex 0
    exact hforward.2.symm)

/-- The roof of every finite ground stage is contained in the roof of the
pointwise direct-limit ground wave.  This is the monotone-roof half of the
limit construction used in Assertion 6.7. -/
theorem safeTreeGroundCommonWarp_roof_subset_limit {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    RoofLE (B \ {a}) (safeTreeGroundCommonWarp hT y hTB n)
      (safeTreeGroundLimitWarp hT y hTB) := by
  apply (safeTreeGroundLimitWarp_isWave hT y hTB).roofLE_of_vertexSet_subset
  unfold safeTreeGroundLimitWarp
  exact Warp.stage_vertexSet_subset_limitOfPaths
    (fun n i => (safeTreeGroundCommonWarp hT y hTB n).path i)
    (fun i _ _ hmn => safeTreeGroundCommonWarp_forward hT y hTB hmn i)
    (fun n => (safeTreeGroundCommonWarp hT y hTB n).disjoint) n

/-- Every vertex carried by a finite ground-stage wave is roofed by the
limiting ground wave, in the common exterior graph. -/
theorem safeTreeGroundStage_vertexSet_subset_limit_roof {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) (n : ℕ) :
    (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet ⊆
      roof (outsideGraph (outsideGraph G {a})
          (safeTreeGroundDeletedLimit hT y hTB))
        (B \ {a}) (safeTreeGroundLimitWarp hT y hTB).terminalSet := by
  intro v hv
  have hvStage : v ∈ roof (outsideGraph (outsideGraph G {a})
      (safeTreeGroundStages hT y hTB n).deleted)
      (B \ {a})
      (safeTreeGroundStages hT y hTB n).wave.toWarp.terminalSet :=
    (safeTreeGroundStages hT y hTB n).wave.isWave.vertexSet_subset_roof hv
  have hvCommon := safeTreeGroundStage_roof_subset_common hT y hTB n hvStage
  exact safeTreeGroundCommonWarp_roof_subset_limit hT y hTB n hvCommon

/-- A boundary vertex which is itself an old source is already carried by
every total ground-stage wave, hence is roofed by the ground limit. -/
theorem safeTreeGroundLimit_roofs_boundary_source {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (hyA : y.1 ∈ A) :
    y.1 ∈ roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB))
      (B \ {a}) (safeTreeGroundLimitWarp hT y hTB).terminalSet := by
  apply safeTreeGroundStage_vertexSet_subset_limit_roof hT y hTB 0
  apply Warp.initialSet_subset_vertexSet
  rw [TotalWave.initialSet_toWarp]
  refine ⟨hyA, ?_⟩
  intro hya
  have : y.1 = a := Set.mem_singleton_iff.mp hya
  apply y.property.1
  rw [this]
  exact hT.prop.1

/-- Every point of the enumerated quotient set is either eventually deleted
or lies on the limiting ground wave. -/
theorem safeTreeGround_X_subset_deleted_union_vertexSet {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    safeTreeCausalXLimit hT y ⊆
      safeTreeGroundDeletedLimit hT y hTB ∪
        (safeTreeGroundLimitWarp hT y hTB).vertexSet := by
  intro x hx
  let x' : safeTreeCausalXLimit hT y := ⟨x, hx⟩
  rcases (safeTreeCausalXEnumeration hT y).2 (some x') with ⟨n, hn⟩
  have hp := groundWaveStep_processed
    (safeTreeGround_source_disjoint_X hT y)
    (safeTreeGround_target_disjoint_X hT y hTB)
    (safeTreeGroundStages hT y hTB n) x'
  have hp' : x ∈ (safeTreeGroundStages hT y hTB (n + 1)).deleted ∨
      x ∈ (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet := by
    simpa [safeTreeGroundStages, hn, x'] using hp
  rcases hp' with hxD | hxW
  · exact Or.inl (safeTreeGround_deleted_subset_limit hT y hTB (n + 1) hxD)
  · right
    have hxCommon : x ∈ (safeTreeGroundCommonWarp hT y hTB n).vertexSet := by
      exact hxW
    unfold safeTreeGroundLimitWarp
    apply Warp.stage_vertexSet_subset_limitOfPaths
      (fun n i => (safeTreeGroundCommonWarp hT y hTB n).path i)
      (fun i _ _ hmn => safeTreeGroundCommonWarp_forward hT y hTB hmn i)
      (fun n => (safeTreeGroundCommonWarp hT y hTB n).disjoint) n
    exact hxCommon

/-- A point of the enumerated closing set has already been processed at one
finite stage.  This is the finite-stage version of the preceding limit
statement. -/
theorem safeTreeGround_exists_stage_processed {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a x : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (hx : x ∈ safeTreeCausalXLimit hT y) :
    ∃ n, x ∈ (safeTreeGroundStages hT y hTB n).deleted ∨
      x ∈ (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet := by
  let x' : safeTreeCausalXLimit hT y := ⟨x, hx⟩
  rcases (safeTreeCausalXEnumeration hT y).2 (some x') with ⟨n, hn⟩
  have hp := groundWaveStep_processed
    (safeTreeGround_source_disjoint_X hT y)
    (safeTreeGround_target_disjoint_X hT y hTB)
    (safeTreeGroundStages hT y hTB n) x'
  have hp' : x ∈ (safeTreeGroundStages hT y hTB (n + 1)).deleted ∨
      x ∈ (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet := by
    simpa [safeTreeGroundStages, hn, x'] using hp
  rcases hp' with hxD | hxW
  · exact ⟨n + 1, Or.inl hxD⟩
  · exact ⟨n, Or.inr hxW⟩

/-- Once a point is deleted or lies on the stage wave, it has the same
alternative at every later stage. -/
theorem safeTreeGround_processed_mono {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a x : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    {m n : ℕ} (hmn : m ≤ n)
    (hx : x ∈ (safeTreeGroundStages hT y hTB m).deleted ∨
      x ∈ (safeTreeGroundStages hT y hTB m).wave.toWarp.vertexSet) :
    x ∈ (safeTreeGroundStages hT y hTB n).deleted ∨
      x ∈ (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet := by
  rcases hx with hxD | ⟨i, hxi⟩
  · exact Or.inl (safeTreeGround_deleted_mono hT y hTB hmn hxD)
  · right
    exact ⟨i, (safeTreeGround_ambient_forward_mono
      hT y hTB hmn i).vertexSet_subset hxi⟩

/-- All points of a finite subset of the closing set are processed by one
common ground stage. -/
theorem safeTreeGround_finite_subset_stage_processed {V : Type}
    {G : SimpleGraph V} {A B T F : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (hFfinite : F.Finite) (hFX : F ⊆ safeTreeCausalXLimit hT y) :
    ∃ n, F ⊆ (safeTreeGroundStages hT y hTB n).deleted ∪
      (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet := by
  induction F, hFfinite using Set.Finite.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert x F hxF hFfinite ih =>
      have hxX : x ∈ safeTreeCausalXLimit hT y :=
        hFX (Set.mem_insert x F)
      have hFX' : F ⊆ safeTreeCausalXLimit hT y := by
        intro v hv
        exact hFX (Set.mem_insert_of_mem x hv)
      rcases safeTreeGround_exists_stage_processed hT y hTB hxX with
        ⟨m, hxm⟩
      rcases ih hFX' with ⟨n, hFn⟩
      refine ⟨max m n, ?_⟩
      rintro v (hvx | hvF)
      · subst v
        exact safeTreeGround_processed_mono hT y hTB
          (Nat.le_max_left m n) hxm
      · exact safeTreeGround_processed_mono hT y hTB
          (Nat.le_max_right m n) (hFn hvF)

/-- A finite terminal of a pointwise forward limit is already the terminal
of one finite stage. -/
theorem LongPath.exists_stage_terminal_of_limit_terminal
    {ι V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j))
    {t : V} (ht : (LongPath.limit P hchain).terminal? = some t) :
    ∃ i, (P i).terminal? = some t := by
  rcases LongPath.terminal?_eq_some_iff.mp ht with ⟨k, hk, hkt⟩
  change LongPath.limitTerminalIndex P = some k at hk
  have hkActive : longPathActive (LongPath.limitTerminalIndex P) k := by
    simp [hk, longPathActive]
  rcases (LongPath.active_limitTerminalIndex_iff P k).mp hkActive with
    ⟨i, hi⟩
  have hit : t ∈ (P i).vertexSet := by
    refine ⟨k, hi, ?_⟩
    exact (LongPath.limitVertex_eq_of_active P hchain hi).symm.trans hkt
  exact ⟨i, (LongPath.forward_limit P hchain i).terminal_of_mem_of_terminal
    ht hit⟩

/-- Every vertex of a pointwise forward limit already occurs at one finite
stage. -/
theorem LongPath.exists_stage_vertex_of_mem_limit
    {ι V : Type} [LinearOrder ι] [Nonempty ι]
    {G : SimpleGraph V} (P : ι → LongPath G)
    (hchain : ∀ ⦃i j⦄, i ≤ j → (P i).Forward (P j))
    {v : V} (hv : v ∈ (LongPath.limit P hchain).vertexSet) :
    ∃ i, v ∈ (P i).vertexSet := by
  rcases hv with ⟨n, hn, hnv⟩
  rcases (LongPath.active_limitTerminalIndex_iff P n).mp hn with ⟨i, hi⟩
  refine ⟨i, n, hi, ?_⟩
  exact (LongPath.limitVertex_eq_of_active P hchain hi).symm.trans hnv

/-- No finite ground stage can terminate at a tree vertex: deleting that
terminal would produce a clean hindrance, contradicting the safe-tree
finite-deletion invariant. -/
theorem safeTreeGroundStage_terminal_not_mem_tree {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a t : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (n : ℕ) (i : ↥(A \ {a}))
    (hit : ((safeTreeGroundStages hT y hTB n).wave.path i).1.terminal? =
      some t) :
    t ∉ T := by
  classical
  intro htT
  let s := safeTreeGroundStages hT y hTB n
  have hDtree : s.deleted ⊆ T \ {a} := by
    intro x hx
    exact safeTreeCausalXLimit_subset_tree_sdiff hT y
      (s.deleted_subset hx)
  have htAmbient : t ∈ (s.ambientWarp.path i).vertexSet := by
    exact LongPath.terminal_mem_vertexSet hit
  have hiOutside : (s.ambientWarp.path i).initial ∉ ({a} : Set V) := by
    have hiInitial : (s.ambientWarp.path i).initial = (i : V) := by
      exact s.wave.path_initial i
    rw [hiInitial]
    exact i.property.2
  have htaSet : t ∉ ({a} : Set V) :=
    (s.ambientWarp.path i).vertex_not_mem_of_outsideGraph
      hiOutside htAmbient
  have hta : t ≠ a := by simpa using htaSet
  let F : Set V := insert t s.deleted
  have hFfinite : F.Finite := s.finite_deleted.insert t
  have hFsub : F ⊆ T \ {a} := by
    rintro x (hxt | hxD)
    · exact ⟨hxt ▸ htT, by simpa [hxt] using hta⟩
    · exact hDtree hxD
  have hiA : (s.wave.path i).1.initial ∈ A \ {a} := by
    simpa using i.property
  have hitne : (s.wave.path i).1.initial ≠ t := by
    intro heq
    have htA : t ∈ A := by
      rw [← heq]
      exact hiA.1
    exact hta (hT.prop.2.1 t htT htA)
  have hnot := s.wave.isWave.not_isCleanUnhindered_deleteTerminal
    s.wave.isSourceClean i hit hiA hitne
  have hsafe := hT.prop.2.2.2 F hFfinite hFsub
  have hGraph :
      outsideGraph (outsideGraph (outsideGraph G {a}) s.deleted) {t} =
        outsideGraph G ({a} ∪ F) := by
    simp [F, outsideGraph_outsideGraph, Set.union_assoc,
      Set.union_comm, Set.union_left_comm]
    rw [Set.insert_comm a t]
  have hAeq : ((A \ {a}) \ {t}) = A \ ({a} ∪ F) := by
    ext x
    constructor
    · rintro ⟨⟨hxA, hxa⟩, hxt⟩
      refine ⟨hxA, ?_⟩
      rintro (hxa' | hxF)
      · exact hxa hxa'
      · rcases hxF with hxt' | hxD
        · exact hxt (Set.mem_singleton_iff.mpr hxt')
        · have hxTree := hDtree hxD
          have hroot := hT.prop.2.1 x hxTree.1 hxA
          exact hxa (Set.mem_singleton_iff.mpr hroot)
    · rintro ⟨hxA, hxAvoid⟩
      refine ⟨⟨hxA, ?_⟩, ?_⟩
      · intro hxa
        exact hxAvoid (Or.inl hxa)
      · intro hxt
        have hxt' : x = t := Set.mem_singleton_iff.mp hxt
        exact hxAvoid (Or.inr (by simpa [F, hxt']))
  have hBeq : ((B \ {a}) \ {t}) = B \ ({a} ∪ F) := by
    ext x
    constructor
    · rintro ⟨⟨hxB, hxa⟩, hxt⟩
      refine ⟨hxB, ?_⟩
      rintro (hxa' | hxF)
      · exact hxa hxa'
      · rcases hxF with hxt' | hxD
        · exact hxt (Set.mem_singleton_iff.mpr hxt')
        · exact Set.disjoint_left.mp hTB (hDtree hxD).1 hxB
    · rintro ⟨hxB, hxAvoid⟩
      refine ⟨⟨hxB, ?_⟩, ?_⟩
      · intro hxa
        exact hxAvoid (Or.inl hxa)
      · intro hxt
        have hxt' : x = t := Set.mem_singleton_iff.mp hxt
        exact hxAvoid (Or.inr (by simpa [F, hxt']))
  apply hnot
  rw [hGraph, hAeq, hBeq]
  exact hsafe

/-- Any tree vertex lying on a finite ground stage is bounded.  The finite
deleted set is its certificate, and the deletion wave passes to the
corresponding quotient while preserving strict roofing. -/
theorem safeTreeGroundStage_vertex_isBounded {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a q : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (n : ℕ) (hqT : q ∈ T)
    (hqW : q ∈ (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet) :
    IsBoundedTreeVertex G A B T a q := by
  classical
  let H := outsideGraph G ({a} : Set V)
  let A₀ := A \ ({a} : Set V)
  let B₀ := B \ ({a} : Set V)
  let s := safeTreeGroundStages hT y hTB n
  have hAD : Disjoint A₀ s.deleted := by
    rw [Set.disjoint_left]
    intro x hxA hxD
    exact Set.disjoint_left.mp (safeTreeGround_source_disjoint_X hT y)
      hxA (s.deleted_subset hxD)
  have hBD : Disjoint B₀ s.deleted := by
    rw [Set.disjoint_left]
    intro x hxB hxD
    exact Set.disjoint_left.mp (safeTreeGround_target_disjoint_X hT y hTB)
      hxB (s.deleted_subset hxD)
  have hqNotTerminal : q ∉ s.wave.toWarp.terminalSet := by
    rintro ⟨i, hiq⟩
    exact safeTreeGroundStage_terminal_not_mem_tree hT y hTB n i hiq hqT
  have hqInterior : q ∈ interiorRoof
      (outsideGraph H s.deleted) B₀ s.wave.toWarp.terminalSet := by
    exact s.wave.isWave.vertexSet_sdiff_terminalSet_subset_interiorRoof
      ⟨hqW, hqNotTerminal⟩
  let U : Warp (outsideGraph H (interiorRoof H B₀ s.deleted)) :=
    quotientWarp
      (s.wave.toWarp.mapLE (outsideGraph_le H s.deleted)) B₀ s.deleted
  refine ⟨{
    vertices := s.deleted
    countable_vertices := s.finite_deleted.countable
    vertices_subset_tree := ?_
    wave := U
    isWave := ?_
    strictly_roofs := ?_ }⟩
  · intro x hx
    exact safeTreeCausalXLimit_subset_tree_sdiff hT y
      (s.deleted_subset hx)
  · exact s.wave.deletionQuotientWarp_isWave_of_disjoint hAD hBD
  · exact s.wave.interiorRoof_delete_subset_deletionQuotientWarp
      hAD hBD hqW hqInterior

/-- The pointwise limit of the ground stages also has no terminal in the
safe tree.  A finite terminal of the limit already occurs at a finite stage,
where the safe-tree deletion invariant excludes it. -/
theorem safeTreeGroundLimit_terminalSet_disjoint_tree {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    Disjoint (safeTreeGroundLimitWarp hT y hTB).terminalSet T := by
  rw [Set.disjoint_left]
  rintro t ⟨i, hit⟩ htT
  let P : ℕ → LongPath
      (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB)) :=
    fun n => (safeTreeGroundCommonWarp hT y hTB n).path i
  have hchain : ∀ ⦃m n⦄, m ≤ n → (P m).Forward (P n) := by
    intro m n hmn
    exact safeTreeGroundCommonWarp_forward hT y hTB hmn i
  have hit' : (LongPath.limit P hchain).terminal? = some t := by
    simpa [safeTreeGroundLimitWarp, Warp.limitOfPaths, P] using hit
  rcases LongPath.exists_stage_terminal_of_limit_terminal P hchain hit' with
    ⟨n, hnt⟩
  have hstage :
      ((safeTreeGroundStages hT y hTB n).wave.path i).1.terminal? =
        some t := by
    exact hnt
  exact safeTreeGroundStage_terminal_not_mem_tree hT y hTB n i hstage htT

/-- Assertion 6.6: the limiting ground wave avoids every unbounded tree
vertex.  A vertex on the direct limit already lies on a finite stage, where
the preceding finite quotient certificate would make it bounded. -/
theorem safeTreeGroundLimit_vertexSet_disjoint_unbounded {V : Type}
    {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    Disjoint (safeTreeGroundLimitWarp hT y hTB).vertexSet
      (unboundedTreeVertices G A B T a) := by
  rw [Set.disjoint_left]
  rintro q ⟨i, hqi⟩ hqQ
  let P : ℕ → LongPath
      (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB)) :=
    fun n => (safeTreeGroundCommonWarp hT y hTB n).path i
  have hchain : ∀ ⦃m n⦄, m ≤ n → (P m).Forward (P n) := by
    intro m n hmn
    exact safeTreeGroundCommonWarp_forward hT y hTB hmn i
  have hqi' : q ∈ (LongPath.limit P hchain).vertexSet := by
    simpa [safeTreeGroundLimitWarp, Warp.limitOfPaths, P] using hqi
  rcases LongPath.exists_stage_vertex_of_mem_limit P hchain hqi' with
    ⟨n, hqn⟩
  have hqStage :
      q ∈ (safeTreeGroundStages hT y hTB n).wave.toWarp.vertexSet := by
    exact ⟨i, hqn⟩
  exact hqQ.2
    (safeTreeGroundStage_vertex_isBounded hT y hTB n hqQ.1 hqStage)

/-- A source-clean exterior wave can be spliced onto the corresponding
essential terminals of an old wave.  Every exterior terminal then occurs as
a terminal of the arrow-composed warp. -/
theorem terminalSet_mapLE_subset_arrow_of_exterior
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hUstart : U.IsStarting (essentialVertices G B W.terminalSet))
    (hUclean : U.IsSourceClean (essentialVertices G B W.terminalSet)) :
    (U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))).terminalSet ⊆
      (arrow W
        (U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet)))).terminalSet := by
  classical
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))
  have hExterior : Disjoint U.vertexSet (interiorRoof G B W.terminalSet) :=
    vertexSet_disjoint_interior_of_outside_starting hUstart
  rintro z ⟨j, hjz⟩
  let e := (U.path j).initial
  have heEssential : e ∈ essentialVertices G B W.terminalSet :=
    hUstart ⟨j, rfl⟩
  have heTerminal : e ∈ W.terminalSet :=
    essentialVertices_subset G B W.terminalSet heEssential
  rcases heTerminal with ⟨i, hiTerminal⟩
  rcases LongPath.terminal?_eq_some_iff.mp hiTerminal with
    ⟨k, hkFinite, hkVertex⟩
  have hjZero : longPathActive (U'.path j).terminalIndex 0 := by
    cases (U'.path j).terminalIndex <;> simp [longPathActive]
  let d : ExtensionData W U' i := {
    endIndex := k
    finite := hkFinite
    carrier := j
    meetIndex := 0
    meetActive := hjZero
    join := by
      change (U.path j).vertex 0 = (W.path i).vertex k
      exact hkVertex.symm
    avoidsOld := by
      rintro x ⟨hxTail, hxOld⟩
      have hxMapped : x ∈ (U'.path j).vertexSet :=
        (U'.path j).vertexSet_tail_subset 0 hjZero hxTail
      have hxUPath : x ∈ (U.path j).vertexSet := by
        exact hxMapped
      have hxU : x ∈ U.vertexSet := ⟨j, hxUPath⟩
      have hxOutside : x ∉ interiorRoof G B W.terminalSet := by
        intro hxInterior
        exact Set.disjoint_left.mp hExterior hxU hxInterior
      have hxRoof : x ∈ roof G B W.terminalSet :=
        hW.vertexSet_subset_roof hxOld
      have hxEssential : x ∈ essentialVertices G B W.terminalSet := by
        by_contra hxNotEssential
        exact hxOutside ⟨hxRoof, hxNotEssential⟩
      have hxInitial : x = (U.path j).initial :=
        hUclean j x hxUPath hxEssential
      exact Set.mem_singleton_iff.mpr (hxInitial.trans hkVertex.symm) }
  apply terminal_mem_arrow_of_extension d
  exact hjz

theorem vertexSet_mapLE_subset_arrow_of_exterior
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hUstart : U.IsStarting (essentialVertices G B W.terminalSet))
    (hUclean : U.IsSourceClean (essentialVertices G B W.terminalSet)) :
    (U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))).vertexSet ⊆
      (arrow W
        (U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet)))).vertexSet := by
  classical
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))
  have hExterior : Disjoint U.vertexSet (interiorRoof G B W.terminalSet) :=
    vertexSet_disjoint_interior_of_outside_starting hUstart
  rintro x ⟨j, hxPath⟩
  let e := (U.path j).initial
  have heEssential : e ∈ essentialVertices G B W.terminalSet :=
    hUstart ⟨j, rfl⟩
  have heTerminal : e ∈ W.terminalSet :=
    essentialVertices_subset G B W.terminalSet heEssential
  rcases heTerminal with ⟨i, hiTerminal⟩
  rcases LongPath.terminal?_eq_some_iff.mp hiTerminal with
    ⟨k, hkFinite, hkVertex⟩
  have hjZero : longPathActive (U'.path j).terminalIndex 0 := by
    cases (U'.path j).terminalIndex <;> simp [longPathActive]
  let d : ExtensionData W U' i := {
    endIndex := k
    finite := hkFinite
    carrier := j
    meetIndex := 0
    meetActive := hjZero
    join := by
      change (U.path j).vertex 0 = (W.path i).vertex k
      exact hkVertex.symm
    avoidsOld := by
      rintro y ⟨hyTail, hyOld⟩
      have hyMapped : y ∈ (U'.path j).vertexSet :=
        (U'.path j).vertexSet_tail_subset 0 hjZero hyTail
      have hyUPath : y ∈ (U.path j).vertexSet := hyMapped
      have hyU : y ∈ U.vertexSet := ⟨j, hyUPath⟩
      have hyOutside : y ∉ interiorRoof G B W.terminalSet := by
        intro hyInterior
        exact Set.disjoint_left.mp hExterior hyU hyInterior
      have hyRoof : y ∈ roof G B W.terminalSet :=
        hW.vertexSet_subset_roof hyOld
      have hyEssential : y ∈ essentialVertices G B W.terminalSet := by
        by_contra hyNotEssential
        exact hyOutside ⟨hyRoof, hyNotEssential⟩
      have hyInitial : y = (U.path j).initial :=
        hUclean j y hyUPath hyEssential
      exact Set.mem_singleton_iff.mpr (hyInitial.trans hkVertex.symm) }
  apply d.tail_vertexSet_subset_arrow
  rcases hxPath with ⟨n, hn, hnx⟩
  refine ⟨n, ?_, ?_⟩
  · apply (LongPath.active_shiftedTerminalIndex_iff hjZero).mpr
    simpa using hn
  · change (U'.path j).vertex (0 + n) = x
    simpa using hnx

/-- The exterior continuation roofs every point already roofed by the old
wave.  Starting at the last old-roof point of a path produces a path in the
quotient graph, where the exterior wave supplies a terminal. -/
theorem roof_terminalSet_subset_roof_mapLE_of_exterior_wave
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hU : U.IsWave (essentialVertices G B W.terminalSet) B) :
    roof G B W.terminalSet ⊆
      roof G B
        (U.mapLE
          (outsideGraph_le G (interiorRoof G B W.terminalSet))).terminalSet := by
  classical
  intro x hxRoof b hb q hq
  have hmeet : ∃ z ∈ q.support, z ∈ roof G B W.terminalSet :=
    ⟨x, q.start_mem_support, hxRoof⟩
  rcases exists_last_roof_index q hmeet with
    ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
  have hxEssential : q.getVert n ∈
      essentialVertices G B W.terminalSet := by
    rcases hnBoundary with hnEssential | hnEnd
    · exact hnEssential
    · have hxb : q.getVert n = b := by simpa [hnEnd]
      have hbOutside : b ∉ interiorRoof G B W.terminalSet := by
        intro hbInterior
        exact Set.disjoint_left.mp
          (target_disjoint_interiorRoof G B W.terminalSet) hb hbInterior
      rw [hxb]
      by_contra hbNotEssential
      exact hbOutside ⟨by simpa [hxb] using hnRoof, hbNotEssential⟩
  have hsuffixOutside :
      ∀ z ∈ (q.drop n).support,
        z ∉ interiorRoof G B W.terminalSet := by
    intro z hz
    rcases Walk.mem_support_iff_exists_getVert.mp hz with ⟨m, hzm, hmle⟩
    have hnmle : n + m ≤ q.length := by
      rw [Walk.drop_length] at hmle
      omega
    have hzGet : q.getVert (n + m) = z := by
      rw [← q.drop_getVert n m]
      exact hzm
    by_cases hm0 : m = 0
    · subst m
      have hzx : z = q.getVert n := by simpa using hzGet.symm
      rw [hzx]
      intro hzInterior
      exact Set.disjoint_left.mp
        (interiorRoof_disjoint G B W.terminalSet)
        hzInterior hxEssential
    · have hnotRoof : q.getVert (n + m) ∉
          roof G B W.terminalSet :=
        hnlast (n + m) hnmle (by omega)
      rw [hzGet] at hnotRoof
      exact fun hzInterior => hnotRoof hzInterior.1
  let r := Erdos599.Walk.toOutsideGraph (q.drop n) hsuffixOutside
  have hrPath : r.IsPath :=
    Erdos599.Walk.isPath_toOutsideGraph (hq.drop n) hsuffixOutside
  rcases hU.2 (q.getVert n) hxEssential b hb r hrPath with
    ⟨z, hzr, hzTerminal⟩
  have hzrDrop : z ∈ (q.drop n).support := by
    have := hzr
    rw [Erdos599.Walk.support_toOutsideGraph] at this
    exact this
  exact ⟨z, (q.isSubwalk_drop n).support_subset hzrDrop, hzTerminal⟩

/-- A point roofed by an exterior wave is roofed by its ambient image once
the old wave is continued through that exterior.  A path which enters the
old strict roof is handled by the preceding lemma; a path avoiding it is
itself an exterior path. -/
theorem roof_exterior_subset_roof_mapLE_of_exterior_wave
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hU : U.IsWave (essentialVertices G B W.terminalSet) B) :
    roof (outsideGraph G (interiorRoof G B W.terminalSet)) B U.terminalSet ⊆
      roof G B
        (U.mapLE
          (outsideGraph_le G (interiorRoof G B W.terminalSet))).terminalSet := by
  classical
  intro z hzRoof b hb q hq
  by_cases hmeet : ∃ x ∈ q.support,
      x ∈ interiorRoof G B W.terminalSet
  · rcases hmeet with ⟨x, hxq, hxInterior⟩
    have hxMapped := roof_terminalSet_subset_roof_mapLE_of_exterior_wave
      hW U hU hxInterior.1
    rcases hxMapped b hb (q.dropUntil x hxq) (hq.dropUntil hxq) with
      ⟨t, htSuffix, htTerminal⟩
    exact ⟨t, q.support_dropUntil_subset_support hxq htSuffix, htTerminal⟩
  · push Not at hmeet
    let r := Erdos599.Walk.toOutsideGraph q hmeet
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq hmeet
    rcases hzRoof b hb r hrPath with ⟨t, htr, htTerminal⟩
    have htq : t ∈ q.support := by
      simpa [r] using htr
    exact ⟨t, htq, htTerminal⟩

/-- Roof form of quotient-wave composition. -/
theorem IsWave.roof_exterior_subset_arrow
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hU : U.IsWave (essentialVertices G B W.terminalSet) B)
    (hUclean : U.IsSourceClean (essentialVertices G B W.terminalSet)) :
    roof (outsideGraph G (interiorRoof G B W.terminalSet)) B U.terminalSet ⊆
      roof G B
        (Warp.arrow W
          (U.mapLE
            (outsideGraph_le G (interiorRoof G B W.terminalSet)))).terminalSet := by
  exact (roof_exterior_subset_roof_mapLE_of_exterior_wave hW U hU).trans
    (roof_mono
      (terminalSet_mapLE_subset_arrow_of_exterior
        hW U hU.1 hUclean))

theorem separates_terminalSet_mapLE_of_exterior_wave
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hU : U.IsWave (essentialVertices G B W.terminalSet) B) :
    Separates G A B
      (U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))).terminalSet := by
  classical
  intro a ha b hb q hq
  have haRoof : a ∈ roof G B W.terminalSet :=
    separates_iff_subset_roof.mp hW.2 ha
  have hmeet : ∃ x ∈ q.support, x ∈ roof G B W.terminalSet :=
    ⟨a, q.start_mem_support, haRoof⟩
  rcases exists_last_roof_index q hmeet with
    ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
  let x := q.getVert n
  have hxEssential : x ∈ essentialVertices G B W.terminalSet := by
    rcases hnBoundary with hxEssential | hnEnd
    · exact hxEssential
    · have hxb : x = b := by simpa [x, hnEnd]
      have hbOutside : b ∉ interiorRoof G B W.terminalSet := by
        intro hbInterior
        exact Set.disjoint_left.mp
          (target_disjoint_interiorRoof G B W.terminalSet) hb hbInterior
      change x ∈ roof G B W.terminalSet at hnRoof
      rw [hxb] at hnRoof ⊢
      by_contra hbNotEssential
      exact hbOutside ⟨hnRoof, hbNotEssential⟩
  have hsuffixOutside :
      ∀ y ∈ (q.drop n).support, y ∉ interiorRoof G B W.terminalSet := by
    intro y hy
    rcases Walk.mem_support_iff_exists_getVert.mp hy with ⟨m, hym, hmle⟩
    have hnmle : n + m ≤ q.length := by
      rw [Walk.drop_length] at hmle
      omega
    have hyGet : q.getVert (n + m) = y := by
      rw [← q.drop_getVert n m]
      exact hym
    by_cases hm0 : m = 0
    · subst m
      have hyx : y = x := by simpa [x] using hyGet.symm
      rw [hyx]
      intro hxInterior
      exact Set.disjoint_left.mp
        (interiorRoof_disjoint G B W.terminalSet) hxInterior hxEssential
    · have hnotRoof : q.getVert (n + m) ∉ roof G B W.terminalSet :=
        hnlast (n + m) hnmle (by omega)
      rw [hyGet] at hnotRoof
      exact fun hyInterior => hnotRoof hyInterior.1
  let r := Erdos599.Walk.toOutsideGraph (q.drop n) hsuffixOutside
  have hrPath : r.IsPath :=
    Erdos599.Walk.isPath_toOutsideGraph (hq.drop n) hsuffixOutside
  rcases hU.2 (q.getVert n) (by simpa [x] using hxEssential) b hb
      r hrPath with ⟨z, hzr, hzTerminal⟩
  have hzrDrop : z ∈ (q.drop n).support := by
    have := hzr
    rw [Erdos599.Walk.support_toOutsideGraph] at this
    exact this
  exact ⟨z, (q.isSubwalk_drop n).support_subset hzrDrop, hzTerminal⟩

/-- Quotient-wave composition (Aharoni--Berger Lemma 3.25), stated using
the spanning exterior graph.  A last roof vertex starts an exterior suffix
of every original `A`--`B` path. -/
theorem IsWave.arrow_exterior
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hU : U.IsWave (essentialVertices G B W.terminalSet) B)
    (hUclean : U.IsSourceClean (essentialVertices G B W.terminalSet)) :
    (Warp.arrow W
      (U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet)))).IsWave A B := by
  classical
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))
  have hterminal : U'.terminalSet ⊆ (Warp.arrow W U').terminalSet := by
    exact terminalSet_mapLE_subset_arrow_of_exterior hW U hU.1 hUclean
  constructor
  · simpa [IsStarting] using hW.1
  · intro a ha b hb q hq
    have haRoof : a ∈ roof G B W.terminalSet :=
      separates_iff_subset_roof.mp hW.2 ha
    have hmeet : ∃ x ∈ q.support, x ∈ roof G B W.terminalSet :=
      ⟨a, q.start_mem_support, haRoof⟩
    rcases exists_last_roof_index q hmeet with
      ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
    let x := q.getVert n
    have hxEssential : x ∈ essentialVertices G B W.terminalSet := by
      rcases hnBoundary with hxEssential | hnEnd
      · exact hxEssential
      · have hxb : x = b := by simpa [x, hnEnd]
        have hbOutside : b ∉ interiorRoof G B W.terminalSet := by
          intro hbInterior
          exact Set.disjoint_left.mp
            (target_disjoint_interiorRoof G B W.terminalSet) hb hbInterior
        change x ∈ roof G B W.terminalSet at hnRoof
        rw [hxb] at hnRoof ⊢
        by_contra hbNotEssential
        exact hbOutside ⟨hnRoof, hbNotEssential⟩
    have hsuffixOutside :
        ∀ y ∈ (q.drop n).support, y ∉ interiorRoof G B W.terminalSet := by
      intro y hy
      rcases Walk.mem_support_iff_exists_getVert.mp hy with ⟨m, hym, hmle⟩
      have hnmle : n + m ≤ q.length := by
        rw [Walk.drop_length] at hmle
        omega
      have hyGet : q.getVert (n + m) = y := by
        rw [← q.drop_getVert n m]
        exact hym
      by_cases hm0 : m = 0
      · subst m
        have hyx : y = x := by simpa [x] using hyGet.symm
        rw [hyx]
        intro hxInterior
        exact Set.disjoint_left.mp
          (interiorRoof_disjoint G B W.terminalSet) hxInterior hxEssential
      · have hnotRoof : q.getVert (n + m) ∉ roof G B W.terminalSet :=
          hnlast (n + m) hnmle (by omega)
        rw [hyGet] at hnotRoof
        exact fun hyInterior => hnotRoof hyInterior.1
    let r := Erdos599.Walk.toOutsideGraph (q.drop n) hsuffixOutside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph (hq.drop n) hsuffixOutside
    rcases hU.2 (q.getVert n) (by simpa [x] using hxEssential) b hb
        r hrPath with
      ⟨z, hzr, hzTerminal⟩
    have hzrDrop : z ∈ (q.drop n).support := by
      have := hzr
      rw [Erdos599.Walk.support_toOutsideGraph] at this
      exact this
    have hzq : z ∈ q.support := (q.isSubwalk_drop n).support_subset hzrDrop
    exact ⟨z, hzq, hterminal hzTerminal⟩

/-- Aharoni--Berger Corollary 3.28 in the form used by Assertion 6.7.
If `W` is roof-maximal and already roofs every genuinely deleted vertex,
then it also roofs every point roofed by a total wave in the deletion web.

The proof sends the deletion wave first to the quotient by `S`, then to the
quotient by the whole old roof.  The latter quotient is the same exterior
web as the quotient by `W`; quotient-wave composition produces an ambient
wave, which roof-maximality compares back to `W`. -/
theorem TotalWave.roof_delete_subset_of_roofMaximal
    {V : Type} {G : SimpleGraph V} {A B S : Set V} {W : Warp G}
    (hW : W.IsWave A B)
    (hmax : ∀ U : Warp G, U.IsWave A B → RoofLE B U W)
    (Z : TotalWave (outsideGraph G S) A B)
    (hAS : Disjoint A S) (hBS : Disjoint B S)
    (hSroof : S ⊆ roof G B W.terminalSet) :
    roof (outsideGraph G S) B Z.toWarp.terminalSet ⊆
      roof G B W.terminalSet := by
  classical
  let T : Set V := roof G B W.terminalSet
  have hST : S ⊆ T := hSroof
  let U₀ : Warp (outsideGraph G (interiorRoof G B S)) :=
    quotientWarp
      (Z.toWarp.mapLE (outsideGraph_le G S)) B S
  have hU₀wave : U₀.IsWave (quotientSource G A B S) B := by
    exact Z.deletionQuotientWarp_isWave_of_disjoint hAS hBS
  have hU₀clean : U₀.IsSourceClean (quotientSource G A B S) := by
    exact (Z.isSourceClean.mapLE (outsideGraph_le G S)).quotientWarp
  let U : Warp (outsideGraph G (interiorRoof G B T)) :=
    Erdos599.Warp.quotientWarpNested U₀ hST
  have hUwave : U.IsWave (quotientSource G A B T) B := by
    exact hU₀wave.quotientWarpNested hST
  have hUclean : U.IsSourceClean (quotientSource G A B T) := by
    exact hU₀clean.quotientWarpNested hST
  have hAroofT : A ⊆ roof G B T := by
    intro a ha
    simpa [T] using (separates_iff_subset_roof.mp hW.2 ha)
  have hSourceT : quotientSource G A B T =
      essentialVertices G B W.terminalSet := by
    calc
      quotientSource G A B T = essentialVertices G B T :=
        quotientSource_eq_essentialVertices_of_subset_roof hAroofT
      _ = essentialVertices G B W.terminalSet := by
        simpa [T] using essentialVertices_roof G B W.terminalSet
  have hGraphT : outsideGraph G (interiorRoof G B T) =
      outsideGraph G (interiorRoof G B W.terminalSet) := by
    simp [T]
  let U' : Warp (outsideGraph G (interiorRoof G B W.terminalSet)) :=
    Erdos599.Warp.castGraph hGraphT U
  have hU'wave : U'.IsWave
      (essentialVertices G B W.terminalSet) B := by
    have h := hUwave.castGraph hGraphT
    rw [hSourceT] at h
    exact h
  have hU'clean : U'.IsSourceClean
      (essentialVertices G B W.terminalSet) := by
    have h := hUclean.castGraph hGraphT
    rw [hSourceT] at h
    exact h
  let C : Warp G := Warp.arrow W
    (U'.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet)))
  have hCwave : C.IsWave A B := by
    exact hW.arrow_exterior U' hU'wave hU'clean
  have hCmax : roof G B C.terminalSet ⊆ roof G B W.terminalSet :=
    hmax C hCwave
  intro z hz
  by_cases hzInterior : z ∈ interiorRoof G B S
  · have hRoofS : roof G B S ⊆ roof G B W.terminalSet := by
      have h := roof_mono (G := G) (B := B) hST
      simpa only [T, roof_roof] using h
    exact hRoofS hzInterior.1
  · have hzU₀ : z ∈
        roof (outsideGraph G (interiorRoof G B S)) B U₀.terminalSet := by
      exact Z.roof_delete_sdiff_interior_subset_deletionQuotientWarp
        hAS hBS ⟨hz, hzInterior⟩
    have hzU : z ∈
        roof (outsideGraph G (interiorRoof G B T)) B U.terminalSet := by
      exact roof_terminalSet_subset_roof_quotientWarpNested U₀ hST hzU₀
    have hzU' : z ∈
        roof (outsideGraph G (interiorRoof G B W.terminalSet)) B
          U'.terminalSet := by
      exact (mem_roof_terminalSet_castGraph_iff hGraphT U B z).mpr hzU
    have hzC : z ∈ roof G B C.terminalSet := by
      exact hW.roof_exterior_subset_arrow U' hU'wave hU'clean hzU'
    exact hCmax hzC

/-- Assertion 6.8, conditional only on Aharoni--Berger Lemma 3.31.  The
finite boundary certificate is processed at one ground stage.  Its points
already on the stage wave form `S`; the other stage deletions are moved past
the certificate by finite hindrance deletion.  Lemma 3.32 then supplies a
total wave terminating at the boundary point, and Corollary 3.28 compares
that wave with the roof-maximal ground-stage wave. -/
theorem safeTreeGroundLimit_roofs_boundary_of_certificate_subset
    (hfinite : FiniteHindranceDeletion)
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y z : outerBoundary G T) (hTB : Disjoint T B)
    (hFX : boundaryCertificateSet hT z.1 ⊆ safeTreeCausalXLimit hT y) :
    z.1 ∈ roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB))
      (B \ {a}) (safeTreeGroundLimitWarp hT y hTB).terminalSet := by
  classical
  by_cases hyA : z.1 ∈ A
  · apply safeTreeGroundStage_vertexSet_subset_limit_roof hT y hTB 0
    apply Warp.initialSet_subset_vertexSet
    rw [TotalWave.initialSet_toWarp]
    exact ⟨hyA, fun hza => z.property.1 (Set.mem_singleton_iff.mp hza ▸ hT.prop.1)⟩
  let F : Set V := boundaryCertificateSet hT z.1
  have hFfinite : F.Finite := boundaryCertificateSet_finite hT z.1
  rcases safeTreeGround_finite_subset_stage_processed hT y hTB
      hFfinite hFX with ⟨n, hprocessed⟩
  let s := safeTreeGroundStages hT y hTB n
  let D : Set V := s.deleted
  let S : Set V := F \ D
  have hDX : D ⊆ safeTreeCausalXLimit hT y := by
    exact s.deleted_subset
  have hSvertex : S ⊆ s.wave.toWarp.vertexSet := by
    intro x hx
    rcases hprocessed hx.1 with hxD | hxW
    · exact (hx.2 hxD).elim
    · exact hxW
  have hAS : Disjoint (A \ {a}) S := by
    exact (safeTreeGround_source_disjoint_X hT y).mono_right
      (Set.sdiff_subset.trans hFX)
  have hBS : Disjoint (B \ {a}) S := by
    exact (safeTreeGround_target_disjoint_X hT y hTB).mono_right
      (Set.sdiff_subset.trans hFX)
  have hSroof : S ⊆ roof (outsideGraph (outsideGraph G {a}) D)
      (B \ {a}) s.wave.toWarp.terminalSet := by
    exact hSvertex.trans s.wave.isWave.vertexSet_subset_roof
  have hboundaryBad :=
    boundaryCertificate_delete_terminal_not_isCleanUnhindered
      hT z.property hyA
  have hDminusFfinite : (D \ F).Finite := s.finite_deleted.sdiff
  have hADminusF : Disjoint
      (((A \ {a}) \ F) \ {z.1}) (D \ F) := by
    rw [Set.disjoint_left]
    intro x hxA hxD
    exact Set.disjoint_left.mp (safeTreeGround_source_disjoint_X hT y)
      hxA.1.1 (hDX hxD.1)
  have hbadMoved := hfinite V
    (outsideGraph (outsideGraph (outsideGraph G {a}) F) {z.1})
    (((A \ {a}) \ F) \ {z.1})
    (((B \ {a}) \ F) \ {z.1}) (D \ F)
    hDminusFfinite hADminusF hboundaryBad
  let E : Set V := D ∪ F
  have hGraphMoved :
      outsideGraph
          (outsideGraph
            (outsideGraph (outsideGraph G {a}) F) {z.1}) (D \ F) =
        outsideGraph (outsideGraph (outsideGraph G {a}) E) {z.1} := by
    simp only [outsideGraph_outsideGraph]
    congr 1
    ext x
    simp [E]
    tauto
  have hAmoved :
      ((((A \ {a}) \ F) \ {z.1}) \ (D \ F)) =
        (A \ {a}) \ {z.1} := by
    ext x
    constructor
    · exact fun hx => ⟨hx.1.1.1, hx.1.2⟩
    · intro hx
      refine ⟨⟨⟨hx.1, ?_⟩, hx.2⟩, ?_⟩
      · intro hxF
        exact Set.disjoint_left.mp (safeTreeGround_source_disjoint_X hT y)
          hx.1 (hFX hxF)
      · intro hxDF
        exact Set.disjoint_left.mp (safeTreeGround_source_disjoint_X hT y)
          hx.1 (hDX hxDF.1)
  have hBmoved :
      ((((B \ {a}) \ F) \ {z.1}) \ (D \ F)) =
        (B \ {a}) \ {z.1} := by
    ext x
    constructor
    · exact fun hx => ⟨hx.1.1.1, hx.1.2⟩
    · intro hx
      refine ⟨⟨⟨hx.1, ?_⟩, hx.2⟩, ?_⟩
      · intro hxF
        exact Set.disjoint_left.mp
          (safeTreeGround_target_disjoint_X hT y hTB) hx.1 (hFX hxF)
      · intro hxDF
        exact Set.disjoint_left.mp
          (safeTreeGround_target_disjoint_X hT y hTB) hx.1 (hDX hxDF.1)
  have hdelete : ¬ IsCleanUnhindered
      (outsideGraph (outsideGraph (outsideGraph G {a}) E) {z.1})
      ((A \ {a}) \ {z.1}) ((B \ {a}) \ {z.1}) := by
    simpa only [hGraphMoved, hAmoved, hBmoved] using hbadMoved
  have hEfinite : E.Finite := s.finite_deleted.union hFfinite
  have hEX : E ⊆ safeTreeCausalXLimit hT y := Set.union_subset hDX hFX
  have hbase : IsCleanUnhindered
      (outsideGraph (outsideGraph G {a}) E) (A \ {a}) (B \ {a}) :=
    safeTree_isCleanUnhindered_after_finite_X_deletion
      hT y hTB hEfinite hEX
  have hyResidual : z.1 ∉ A \ {a} := fun hy => hyA hy.1
  rcases TotalWave.exists_totalWave_terminal_of_delete_not_isCleanUnhindered
      hbase hyResidual hdelete with ⟨Z₀, hyZ₀⟩
  have hGraphStage :
      outsideGraph (outsideGraph (outsideGraph G {a}) D) S =
        outsideGraph (outsideGraph G {a}) E := by
    simp only [outsideGraph_outsideGraph]
    congr 1
    ext x
    simp [S, E]
    tauto
  let Z : TotalWave
      (outsideGraph (outsideGraph (outsideGraph G {a}) D) S)
      (A \ {a}) (B \ {a}) := TotalWave.castGraph hGraphStage.symm Z₀
  have hyZ : z.1 ∈ Z.toWarp.terminalSet := by
    simpa [Z] using hyZ₀
  have hyStage : z.1 ∈ roof
      (outsideGraph (outsideGraph G {a}) D)
      (B \ {a}) s.wave.toWarp.terminalSet := by
    have hyZroof : z.1 ∈ roof
        (outsideGraph (outsideGraph (outsideGraph G {a}) D) S)
        (B \ {a}) Z.toWarp.terminalSet :=
      Z.isWave.vertexSet_subset_roof
        (Z.toWarp.terminalSet_subset_vertexSet hyZ)
    exact (TotalWave.roof_delete_subset_of_roofMaximal
      (W := s.wave.toWarp) s.wave.isWave s.roof_maximal Z
      hAS hBS hSroof) hyZroof
  have hyCommon := safeTreeGroundStage_roof_subset_common
    hT y hTB n (by simpa [s, D] using hyStage)
  exact safeTreeGroundCommonWarp_roof_subset_limit hT y hTB n hyCommon

theorem safeTreeGroundLimit_roofs_boundary_of_finiteHindranceDeletion
    (hfinite : FiniteHindranceDeletion)
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    y.1 ∈ roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB))
      (B \ {a}) (safeTreeGroundLimitWarp hT y hTB).terminalSet := by
  apply safeTreeGroundLimit_roofs_boundary_of_certificate_subset
    hfinite hT y y hTB
  intro x hx
  apply safeTreeCausalX_subset_limit hT y 0
  simpa using hx

/-- Assertion 6.8 with Aharoni--Berger Lemma 3.31 discharged by
`finiteHindranceDeletion`. -/
theorem safeTreeGroundLimit_roofs_boundary
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    y.1 ∈ roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB))
      (B \ {a}) (safeTreeGroundLimitWarp hT y hTB).terminalSet := by
  exact safeTreeGroundLimit_roofs_boundary_of_finiteHindranceDeletion
    finiteHindranceDeletion hT y hTB

theorem safeTreeGroundLimit_roofs_relevant_boundary
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a z : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B)
    (hzBoundary : z ∈ outerBoundary G T)
    (hzMeeting : z ∈ ((WaveExtension.safeTreeCausalLimitWave hT y).meeting
      (safeTreeCausalXLimit hT y)).vertexSet) :
    z ∈ roof (outsideGraph (outsideGraph G {a})
        (safeTreeGroundDeletedLimit hT y hTB))
      (B \ {a}) (safeTreeGroundLimitWarp hT y hTB).terminalSet := by
  apply safeTreeGroundLimit_roofs_boundary_of_certificate_subset
    finiteHindranceDeletion hT y ⟨z, hzBoundary⟩ hTB
  exact WaveExtension.safeTreeCausalLimit_boundaryCertificate_subset hT y
    ⟨hzBoundary, hzMeeting⟩

/-- Proposition 6.3 for one boundary vertex.  The causal quotient wave is
brought back to the ground by the limiting real-deletion wave.  Corollary
6.9 supplies, component by component, an `R`-avoiding suffix starting in the
ground roof, so the deletion-arrow lemma produces a wave in `Γ-a-Q` which
still roofs the prescribed boundary vertex. -/
theorem exists_safeTreeBoundaryWave
    {V : Type} {G : SimpleGraph V} {A B T : Set V} {a : V}
    (hT : Maximal (IsSafeRootSet G A B a) T)
    (y : outerBoundary G T) (hTB : Disjoint T B) :
    ∃ U : Warp (outsideGraph (outsideGraph G {a})
        (unboundedTreeVertices G A B T a)),
      U.IsWave
        ((A \ {a}) \ unboundedTreeVertices G A B T a)
        ((B \ {a}) \ unboundedTreeVertices G A B T a) ∧
      U.IsSourceClean
        ((A \ {a}) \ unboundedTreeVertices G A B T a) ∧
      y.1 ∈ roof
        (outsideGraph (outsideGraph G {a})
          (unboundedTreeVertices G A B T a))
        ((B \ {a}) \ unboundedTreeVertices G A B T a) U.terminalSet := by
  classical
  let H := outsideGraph G ({a} : Set V)
  let A₀ := A \ ({a} : Set V)
  let B₀ := B \ ({a} : Set V)
  let X := safeTreeCausalXLimit hT y
  let Q := unboundedTreeVertices G A B T a
  let R := safeTreeGroundDeletedLimit hT y hTB
  let C := safeTreeCausalEssentialGroundWarp hT y
  let hCK :
      outsideGraph (outsideGraph H (interiorRoof H B₀ X)) Q ≤
        outsideGraph H Q :=
    outsideGraph_mono (outsideGraph_le H (interiorRoof H B₀ X)) Q
  let W : Warp (outsideGraph H Q) := C.mapLE hCK
  let V₀ := safeTreeGroundLimitWarp hT y hTB
  have hVQ : Disjoint V₀.vertexSet Q :=
    safeTreeGroundLimit_vertexSet_disjoint_unbounded hT y hTB
  let VQ := V₀.toOutsideGraph hVQ
  have hGraph : outsideGraph (outsideGraph H R) Q =
      outsideGraph (outsideGraph H Q) R := by
    simp [outsideGraph_outsideGraph, Set.union_comm]
  let U : Warp (outsideGraph (outsideGraph H Q) R) :=
    Erdos599.Warp.castGraph hGraph VQ
  have hUwave : U.IsWave (A₀ \ Q) (B₀ \ Q) := by
    exact (safeTreeGroundLimitWarp_isWave hT y hTB
      |>.toOutsideGraph hVQ).castGraph hGraph
  have hUclean : U.IsSourceClean (A₀ \ Q) := by
    have hclean := (safeTreeGroundLimitWarp_isSourceClean hT y hTB
      |>.toOutsideGraph hVQ).castGraph hGraph
    intro i v hv hvAQ
    exact hclean i v hv hvAQ.1
  have hCwave : C.IsWave
      ((quotientSource H A₀ B₀ X) \ Q) (B₀ \ Q) := by
    exact safeTreeCausalEssentialGroundWarp_isWave hT y
  have hCclean : C.IsSourceClean
      ((quotientSource H A₀ B₀ X) \ Q) := by
    exact safeTreeCausalEssentialGroundWarp_isSourceClean hT y
  have hWroof : W.IsSelfRoofing (B₀ \ Q) := by
    exact hCwave.mapLE_isSelfRoofing_of_quotient_delete
  have hWsep : Separates (outsideGraph H Q) (A₀ \ Q) (B₀ \ Q)
      W.terminalSet := by
    exact hCwave.separates_terminalSet_mapLE_of_quotient_delete
  have hRX : R ⊆ X := by
    exact safeTreeGroundDeletedLimit_subset_X hT y hTB
  have hRT : R ⊆ T := by
    exact hRX.trans (safeTreeCausalXLimit_subset_tree_sdiff hT y) |>.trans
      Set.sdiff_subset
  have hCnotInterior (j : C.ι) {v : V}
      (hv : v ∈ (C.path j).vertexSet) :
      v ∉ interiorRoof H B₀ X := by
    let p := (C.path j).mapLE
      (outsideGraph_le (outsideGraph H (interiorRoof H B₀ X)) Q)
    have hiSource := hCwave.1 ⟨j, rfl⟩
    have hiOutside : p.initial ∉ interiorRoof H B₀ X := hiSource.1.2
    exact p.vertex_not_mem_of_outsideGraph hiOutside hv
  have hCnotQ (j : C.ι) {v : V} (hv : v ∈ (C.path j).vertexSet) :
      v ∉ Q := by
    have hiSource := hCwave.1 ⟨j, rfl⟩
    exact (C.path j).vertex_not_mem_of_outsideGraph hiSource.2 hv
  have hRroof : R ⊆ roof (outsideGraph H Q) (B₀ \ Q) W.terminalSet := by
    intro r hrR
    by_cases hrQ : r ∈ Q
    · have hrNotB : r ∉ B₀ \ Q := fun hrB => hrB.2 hrQ
      exact (mem_interiorRoof_outsideGraph_of_mem_deleted
        (G := H) (S := W.terminalSet) hrQ hrNotB).1
    · have hrRoof : r ∈ roof H B₀ X :=
        subset_roof H B₀ X (hRX hrR)
      exact hCwave.roof_quotientSet_subset_mapLE_of_quotient_delete
        ⟨hrRoof, hrQ⟩
  have hWtermR : Disjoint W.terminalSet R := by
    simpa [W] using
      safeTreeCausalEssentialGroundWarp_terminalSet_disjoint_groundDeleted
        hT y hTB
  have hWcleanA : W.IsSourceClean (A₀ \ Q) := by
    intro j v hv hvA
    apply hCclean j v hv
    exact ⟨⟨Or.inl hvA.1, hCnotInterior j hv⟩, hvA.2⟩
  have hsuffix : ∀ j : W.ι, ∃ n,
      longPathActive (W.path j).terminalIndex n ∧
      (W.path j).vertex n ∈
        roof (outsideGraph (outsideGraph H Q) R) (B₀ \ Q) U.terminalSet ∧
      ∀ m, longPathActive (W.path j).terminalIndex m → n ≤ m →
        (W.path j).vertex m ∉ R := by
    intro j
    have hiSource := hCwave.1 ⟨j, rfl⟩
    rcases hiSource.1.1 with hiA | hiX
    · have hzero : longPathActive (W.path j).terminalIndex 0 := by
        cases (W.path j).terminalIndex <;> simp [longPathActive]
      have hiAQ : (W.path j).initial ∈ A₀ \ Q := by
        exact ⟨hiA, hiSource.2⟩
      have hiRoof : (W.path j).vertex 0 ∈
          roof (outsideGraph (outsideGraph H Q) R) (B₀ \ Q) U.terminalSet := by
        exact separates_iff_subset_roof.mp hUwave.2 hiAQ
      refine ⟨0, hzero, by simpa [LongPath.initial] using hiRoof, ?_⟩
      intro m hm _hm0 hmR
      have hmX : (W.path j).vertex m ∈ X := hRX hmR
      have hmSource : (W.path j).vertex m ∈
          (quotientSource H A₀ B₀ X) \ Q := by
        exact ⟨⟨Or.inr hmX, hCnotInterior j ⟨m, hm, rfl⟩⟩,
          hCnotQ j ⟨m, hm, rfl⟩⟩
      have hEq := hCclean j ((W.path j).vertex m)
        ⟨m, hm, rfl⟩ hmSource
      have hinitX : (C.path j).initial ∈ X := by
        rw [← hEq]
        exact hmX
      exact Set.disjoint_left.mp (safeTreeGround_source_disjoint_X hT y)
        hiA hinitX
    · rcases j.property with ⟨t, hjt, htQ⟩
      have hiMeet : ∃ x ∈
          ((WaveExtension.safeTreeCausalLimitWave hT y).path j.1.1).vertexSet,
          x ∈ X :=
        ⟨(W.path j).initial, (W.path j).initial_mem_vertexSet, hiX⟩
      let jm : (safeTreeCausalEssentialMeeting hT y).ι := ⟨j.1, hiMeet⟩
      have htMeeting : t ∈
          (safeTreeCausalEssentialMeeting hT y).terminalSet := ⟨jm, hjt⟩
      have htT : t ∉ T := by
        intro htT
        have htQ' :=
          safeTreeCausalEssentialMeeting_terminal_inter_tree_subset_unbounded
            hT y hTB ⟨htMeeting, htT⟩
        exact htQ htQ'
      rcases LongPath.terminal?_eq_some_iff.mp hjt with
        ⟨k, hkFinite, hkt⟩
      have hkFiniteW : (W.path j).terminalIndex = some k := by
        exact hkFinite
      have hkActive : longPathActive (W.path j).terminalIndex k := by
        simp [hkFiniteW, longPathActive]
      let pref := (W.path j).prefixWalk k hkActive
      have hmeetOutside : ∃ z ∈ pref.support, z ∈ Tᶜ := by
        refine ⟨t, ?_, htT⟩
        have : pref.getVert k = t :=
          (W.path j).getVert_prefixWalk_of_le hkActive le_rfl |>.trans hkt
        exact this ▸ pref.getVert_mem_support k
      rcases exists_first_index_of_support_meets pref Tᶜ hmeetOutside with
        ⟨n, hnle, hnOutside, hnfirst⟩
      have hnpos : 0 < n := by
        by_contra hnpos
        have hnzero : n = 0 := by omega
        subst n
        apply hnOutside
        have hiT := safeTreeCausalXLimit_subset_tree_sdiff hT y hiX
        rw [(W.path j).getVert_prefixWalk_of_le hkActive (Nat.zero_le k)]
        change (C.path j).vertex 0 ∈ T
        simpa [LongPath.initial] using hiT.1
      have hnleK : n ≤ k := by simpa [pref] using hnle
      have hnActive : longPathActive (W.path j).terminalIndex n :=
        LongPath.active_mono hnleK hkActive
      let z := pref.getVert n
      have hzOutside : z ∉ T := hnOutside
      have hpredT : pref.getVert (n - 1) ∈ T := by
        by_contra hpredT
        exact hnfirst (n - 1) (by omega) (by omega) hpredT
      have hpredlt : n - 1 < pref.length := by
        have : n ≤ pref.length := hnle
        omega
      have hzBoundary : z ∈ outerBoundary G T := by
        refine ⟨hzOutside, pref.getVert (n - 1), hpredT, ?_⟩
        have hadj := pref.adj_getVert_succ hpredlt
        have hindex : n - 1 + 1 = n := by omega
        simpa [z, hindex] using hadj.1.1
      have hzPath : z ∈
          ((WaveExtension.safeTreeCausalLimitWave hT y).path j.1.1).vertexSet := by
        refine ⟨n, hnActive, ?_⟩
        exact (W.path j).getVert_prefixWalk_of_le hkActive hnleK |>.symm
      have hzMeeting : z ∈
          ((WaveExtension.safeTreeCausalLimitWave hT y).meeting X).vertexSet := by
        rw [Warp.meeting, Warp.vertexSet_restrictIndices]
        exact ⟨j.1.1, hiMeet, hzPath⟩
      have hzGround := safeTreeGroundLimit_roofs_relevant_boundary
        hT y hTB hzBoundary hzMeeting
      have hzDeleted := roof_antitone_graph
        (outsideGraph_le (outsideGraph H R) Q) B₀ V₀.terminalSet hzGround
      have hzShrunk := roof_antitone_target
        (Set.sdiff_subset : B₀ \ Q ⊆ B₀) hzDeleted
      have hzU : z ∈ roof (outsideGraph (outsideGraph H Q) R)
          (B₀ \ Q) U.terminalSet := by
        simpa [U, VQ, hGraph] using hzShrunk
      refine ⟨n, hnActive, ?_, ?_⟩
      · change (W.path j).vertex n ∈
          roof (outsideGraph (outsideGraph H Q) R) (B₀ \ Q) U.terminalSet
        rw [← (W.path j).getVert_prefixWalk_of_le hkActive hnleK]
        exact hzU
      · intro m hm hnm hmR
        have hmX : (W.path j).vertex m ∈ X := hRX hmR
        have hmSource : (W.path j).vertex m ∈
            (quotientSource H A₀ B₀ X) \ Q := by
          exact ⟨⟨Or.inr hmX, hCnotInterior j ⟨m, hm, rfl⟩⟩,
            hCnotQ j ⟨m, hm, rfl⟩⟩
        have hEq := hCclean j ((W.path j).vertex m)
          ⟨m, hm, rfl⟩ hmSource
        change (C.path j).vertex m = (C.path j).initial at hEq
        have hzero : longPathActive (W.path j).terminalIndex 0 := by
          cases (W.path j).terminalIndex <;> simp [longPathActive]
        have hEq' : (W.path j).vertex m = (W.path j).vertex 0 := by
          exact hEq
        have hmzero : m = 0 := (W.path j).injective hm hzero hEq'
        omega
  have hArrowData := hUwave.arrow_delete_of_roofed_suffix
    hWroof hWsep hRroof hWtermR hsuffix
  have hArrow : (Warp.arrow
      (U.mapLE (outsideGraph_le (outsideGraph H Q) R)) W).IsWave
      (A₀ \ Q) (B₀ \ Q) := hArrowData.1
  let Z := Warp.arrow
    (U.mapLE (outsideGraph_le (outsideGraph H Q) R)) W
  have hZclean : Z.IsSourceClean (A₀ \ Q) := by
    exact (hUclean.mapLE (outsideGraph_le (outsideGraph H Q) R)).arrow hWcleanA
  have hyC := boundary_mem_roof_safeTreeCausalEssentialGroundWarp hT y
  have hyNotQ : y.1 ∉ Q := fun hyQ => y.property.1 hyQ.1
  have hyW : y.1 ∈ roof (outsideGraph H Q) (B₀ \ Q) W.terminalSet := by
    exact hCwave.roof_small_subset_mapLE_of_quotient_delete ⟨hyC, hyNotQ⟩
  have hyZ : y.1 ∈ roof (outsideGraph H Q) (B₀ \ Q) Z.terminalSet := by
    exact hArrowData.2 hyW
  refine ⟨Z, ?_, ?_, ?_⟩
  · simpa [H, A₀, B₀, Q, Z] using hArrow
  · simpa [H, A₀, Q, Z] using hZclean
  · simpa [H, B₀, Q, Z] using hyZ

/-- A roof-maximal wave has a clean-loose quotient (Aharoni--Berger
Lemma 3.26).  If an exterior wave contained a genuinely new vertex, splicing
it onto `W` would put that exterior vertex inside the maximal roof. -/
theorem IsWave.cleanLoose_exterior_of_roofMaximal
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (hmax : ∀ Z : Warp G, Z.IsWave A B → RoofLE B Z W) :
    IsCleanLoose (outsideGraph G (interiorRoof G B W.terminalSet))
      (essentialVertices G B W.terminalSet) B := by
  classical
  intro U hU hUclean
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))
  let C := Warp.arrow W U'
  have hC : C.IsWave A B := hW.arrow_exterior U hU hUclean
  have hroof : roof G B C.terminalSet ⊆ roof G B W.terminalSet :=
    hmax C hC
  have hvertexC : U'.vertexSet ⊆ C.vertexSet :=
    vertexSet_mapLE_subset_arrow_of_exterior hW U hU.1 hUclean
  have hExterior : Disjoint U.vertexSet (interiorRoof G B W.terminalSet) :=
    vertexSet_disjoint_interior_of_outside_starting hU.1
  have hvertexEssential :
      U.vertexSet ⊆ essentialVertices G B W.terminalSet := by
    intro x hxU
    have hxMapped : x ∈ U'.vertexSet := hxU
    have hxRoofC : x ∈ roof G B C.terminalSet :=
      hC.vertexSet_subset_roof (hvertexC hxMapped)
    have hxRoofW : x ∈ roof G B W.terminalSet := hroof hxRoofC
    have hxOutside : x ∉ interiorRoof G B W.terminalSet := by
      intro hxInterior
      exact Set.disjoint_left.mp hExterior hxU hxInterior
    by_contra hxNotEssential
    exact hxOutside ⟨hxRoofW, hxNotEssential⟩
  have hterminalEssential :
      U.terminalSet ⊆ essentialVertices G B W.terminalSet :=
    fun _ hx => hvertexEssential (U.terminalSet_subset_vertexSet hx)
  have hEssentialTerminal :
      essentialVertices G B W.terminalSet ⊆ U.terminalSet :=
    (essentialVertices_minimal_outside_separator G B W.terminalSet).2
      hU.2 hterminalEssential
  have hterminalInitial : U.terminalSet ⊆ U.initialSet := by
    rintro z ⟨i, hiz⟩
    have hzPath : z ∈ (U.path i).vertexSet :=
      LongPath.terminal_mem_vertexSet hiz
    have hzEssential := hvertexEssential ⟨i, hzPath⟩
    exact ⟨i, (hUclean i z hzPath hzEssential).symm⟩
  constructor
  · apply Set.Subset.antisymm hU.1
    exact hEssentialTerminal.trans hterminalInitial
  · apply Set.Subset.antisymm hvertexEssential
    exact hEssentialTerminal.trans hterminalInitial |>.trans U.initialSet_subset_vertexSet

end Warp

/-- A finite-character warp: a pairwise vertex-disjoint family of finite
simple paths.  Aharoni--Berger also use warps containing rays; this structure
is the finite fragment used for linkages and the final witnesses. -/
structure FCWarp {V : Type} (G : SimpleGraph V) where
  ι : Type
  start : ι → V
  finish : ι → V
  path : ∀ i, G.Walk (start i) (finish i)
  isPath : ∀ i, (path i).IsPath
  disjoint : Pairwise fun i j =>
    Disjoint {v | v ∈ (path i).support} {v | v ∈ (path j).support}

namespace FCWarp

def vertexSet {V : Type} {G : SimpleGraph V} (W : FCWarp G) : Set V :=
  {v | ∃ i, v ∈ (W.path i).support}

def initialSet {V : Type} {G : SimpleGraph V} (W : FCWarp G) : Set V :=
  Set.range W.start

def terminalSet {V : Type} {G : SimpleGraph V} (W : FCWarp G) : Set V :=
  Set.range W.finish

def IsStarting {V : Type} {G : SimpleGraph V} (W : FCWarp G) (A : Set V) : Prop :=
  W.initialSet ⊆ A

def CoversSources {V : Type} {G : SimpleGraph V} (W : FCWarp G) (A : Set V) : Prop :=
  A ⊆ W.initialSet

def EndsIn {V : Type} {G : SimpleGraph V} (W : FCWarp G) (B : Set V) : Prop :=
  W.terminalSet ⊆ B

/-- A finite-character wave has sources in `A` and its terminal set separates
`A` from `B`. -/
def IsWave {V : Type} {G : SimpleGraph V} (W : FCWarp G) (A B : Set V) : Prop :=
  W.IsStarting A ∧ Separates G A B W.terminalSet

/-- A wave is a hindrance when it fails to start at every source. -/
def IsHindrance {V : Type} {G : SimpleGraph V} (W : FCWarp G)
    (A B : Set V) : Prop :=
  W.IsWave A B ∧ ¬ W.CoversSources A

/-- A web is unhindered when every finite-character wave starts at every
source.  This is the finite-warp fragment of Aharoni--Berger's notion; their
full definition quantifies over warps that may also contain rays. -/
def IsUnhindered {V : Type} (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∀ W : FCWarp G, W.IsWave A B → W.CoversSources A

/-- A finite linkage starts at every source and ends in the target set. -/
def IsLinkage {V : Type} {G : SimpleGraph V} (W : FCWarp G)
    (A B : Set V) : Prop :=
  W.IsStarting A ∧ W.CoversSources A ∧ W.EndsIn B

/-- The warp of singleton paths at all vertices of `A`. -/
def trivial {V : Type} (G : SimpleGraph V) (A : Set V) : FCWarp G where
  ι := A
  start := Subtype.val
  finish := Subtype.val
  path := fun _ => .nil
  isPath := fun _ => by simp
  disjoint := by
    intro i j hij
    rw [Set.disjoint_left]
    intro v hvi hvj
    simp only [Set.mem_ofPred_eq, Walk.support_nil, List.mem_singleton] at hvi hvj
    exact hij (Subtype.ext (hvi.symm.trans hvj))

@[simp] theorem initialSet_trivial {V : Type} (G : SimpleGraph V) (A : Set V) :
    (trivial G A).initialSet = A := by
  ext v
  simp [initialSet, trivial]

@[simp] theorem terminalSet_trivial {V : Type} (G : SimpleGraph V) (A : Set V) :
    (trivial G A).terminalSet = A := by
  ext v
  simp [terminalSet, trivial]

theorem trivial_isWave {V : Type} (G : SimpleGraph V) (A B : Set V) :
    (trivial G A).IsWave A B := by
  constructor
  · rw [IsStarting, initialSet_trivial]
  · rw [terminalSet_trivial]
    intro a ha b hb q hq
    exact ⟨a, q.start_mem_support, ha⟩

theorem linkage_not_hindrance {V : Type} {G : SimpleGraph V}
    {W : FCWarp G} {A B : Set V} (hlink : W.IsLinkage A B) :
    ¬ W.IsHindrance A B := by
  intro hh
  exact hh.2 hlink.2.1

theorem coversSources_of_unhindered {V : Type} {G : SimpleGraph V}
    {A B : Set V} (hunhindered : IsUnhindered G A B)
    {W : FCWarp G} (hW : W.IsWave A B) :
    W.CoversSources A :=
  hunhindered W hW

/-- A wave whose finite paths already finish in `B` is an exact
Erdős--Menger witness: use the terminal vertices as the transversal.  This
lemma records the final extraction after the infinitary construction has
produced such a terminal wave. -/
theorem hasErdosMengerPair_of_wave_endsIn {V : Type} {G : SimpleGraph V}
    {A B : Set V} {W : FCWarp G}
    (hW : W.IsWave A B) (hB : W.EndsIn B) :
    ∃ (ι : Type) (a b : ι → V) (p : ∀ i, G.Walk (a i) (b i)) (S : Set V),
      (∀ i, a i ∈ A) ∧
      (∀ i, b i ∈ B) ∧
      (∀ i, (p i).IsPath) ∧
      (Pairwise fun i j =>
        Disjoint {v | v ∈ (p i).support} {v | v ∈ (p j).support}) ∧
      S ⊆ {v | ∃ i, v ∈ (p i).support} ∧
      (∀ i, ∃! v, v ∈ S ∧ v ∈ (p i).support) ∧
      Separates G A B S := by
  classical
  refine ⟨W.ι, W.start, W.finish, W.path, W.terminalSet,
    ?_, ?_, W.isPath, W.disjoint, ?_, ?_, hW.2⟩
  · intro i
    exact hW.1 ⟨i, rfl⟩
  · intro i
    exact hB ⟨i, rfl⟩
  · intro v hv
    rcases hv with ⟨i, rfl⟩
    exact ⟨i, (W.path i).end_mem_support⟩
  · intro i
    refine ⟨W.finish i, ⟨⟨i, rfl⟩, (W.path i).end_mem_support⟩, ?_⟩
    intro v hv
    rcases hv.1 with ⟨j, hvj⟩
    by_cases hij : i = j
    · simpa [hij] using hvj.symm
    · have hd := W.disjoint hij
      exact (Set.disjoint_left.mp hd hv.2
        (hvj ▸ (W.path j).end_mem_support)).elim

/-- Regard a finite-character warp as a warp that happens to contain no
rays. -/
def toWarp {V : Type} {G : SimpleGraph V} (W : FCWarp G) : Warp G where
  ι := W.ι
  path := fun i => LongPath.ofWalk (W.path i) (W.isPath i)
  disjoint := by
    intro i j hij
    simpa using W.disjoint hij

@[simp] theorem initialSet_toWarp {V : Type} {G : SimpleGraph V}
    (W : FCWarp G) : W.toWarp.initialSet = W.initialSet := by
  ext v
  simp [Warp.initialSet, FCWarp.initialSet, toWarp]

@[simp] theorem terminalSet_toWarp {V : Type} {G : SimpleGraph V}
    (W : FCWarp G) : W.toWarp.terminalSet = W.terminalSet := by
  ext v
  simp [Warp.terminalSet, FCWarp.terminalSet, toWarp]

@[simp] theorem vertexSet_toWarp {V : Type} {G : SimpleGraph V}
    (W : FCWarp G) : W.toWarp.vertexSet = W.vertexSet := by
  ext v
  simp [Warp.vertexSet, FCWarp.vertexSet, toWarp]

theorem isWave_toWarp {V : Type} {G : SimpleGraph V}
    {W : FCWarp G} {A B : Set V} (hW : W.IsWave A B) :
    W.toWarp.IsWave A B := by
  constructor
  · simpa [Warp.IsStarting, FCWarp.IsStarting] using hW.1
  · simpa using hW.2

end FCWarp

/-- A finite simple path whose endpoints lie in `A` and `B`.  This packages
the dependent endpoint indices of `SimpleGraph.Walk`. -/
structure ABPath {V : Type} (G : SimpleGraph V) (A B : Set V) where
  left : V
  right : V
  left_mem : left ∈ A
  right_mem : right ∈ B
  walk : G.Walk left right
  isPath : walk.IsPath

/-- The vertex set of a packaged path. -/
def ABPath.vertices {V : Type} {G : SimpleGraph V} {A B : Set V}
    (p : ABPath G A B) : Set V :=
  {v | v ∈ p.walk.support}

/-- The hypergraph whose edges are supports of finite simple `A`--`B` paths. -/
def pathHypergraph {V : Type} (G : SimpleGraph V) (A B : Set V) : Set (Set V) :=
  Set.range (ABPath.vertices : ABPath G A B → Set V)

/-- A disjoint subfamily of a hypergraph. -/
def IsPacking {V : Type} (F P : Set (Set V)) : Prop :=
  P ⊆ F ∧
    ∀ e, e ∈ P → ∀ f, f ∈ P → e ≠ f → Disjoint e f

/-- A vertex cover of a hypergraph. -/
def IsCover {V : Type} (F : Set (Set V)) (S : Set V) : Prop :=
  ∀ e ∈ F, ∃ v, v ∈ e ∧ v ∈ S

/-- A hypergraph of finite nonempty edges has an inclusion-minimal cover
below any prescribed cover.  At a descending-chain limit, finiteness of a
fixed edge prevents all of its vertices from disappearing. -/
theorem exists_minimal_cover {V : Type} {F : Set (Set V)}
    (hfinite : ∀ e ∈ F, e.Finite) {U : Set V} (hU : IsCover F U) :
    ∃ S ⊆ U, Minimal (IsCover F) S := by
  classical
  apply zorn_superset_nonempty {S | IsCover F S} _ U hU
  intro c hc hchain hcne
  refine ⟨⋂₀ c, ?_, fun S hSc => Set.sInter_subset_of_mem hSc⟩
  intro e heF
  by_contra hmeet
  push Not at hmeet
  let d : Set (Set V) := (fun S : Set V => Sᶜ) '' c
  have hdne : d.Nonempty := hcne.image _
  have hdchain : IsChain (· ⊆ ·) d := by
    intro X hX Y hY hXY
    rcases hX with ⟨S, hSc, rfl⟩
    rcases hY with ⟨T, hTc, rfl⟩
    rcases hchain.total hSc hTc with hST | hTS
    · exact Or.inr (Set.compl_subset_compl.mpr hST)
    · exact Or.inl (Set.compl_subset_compl.mpr hTS)
  have heSub : e ⊆ ⋃₀ d := by
    intro v hve
    have hvNotInter : v ∉ ⋂₀ c := hmeet v hve
    simp only [Set.mem_sInter] at hvNotInter
    push Not at hvNotInter
    rcases hvNotInter with ⟨S, hSc, hvS⟩
    exact ⟨Sᶜ, ⟨S, hSc, rfl⟩, hvS⟩
  rcases hdchain.directedOn.exists_mem_subset_of_finite_of_subset_sUnion
      hdne (hfinite e heF) heSub with ⟨T, hTd, heT⟩
  rcases hTd with ⟨S, hSc, rfl⟩
  rcases hc hSc e heF with ⟨v, hve, hvS⟩
  exact (heT hve) hvS

/-- Every point of a minimal cover has a private hyperedge: an edge whose
intersection with the cover is exactly that point. -/
theorem MinimalCover.exists_private_edge {V : Type} {F : Set (Set V)}
    {S : Set V} (hS : Minimal (IsCover F) S) {s : V} (hs : s ∈ S) :
    ∃ e ∈ F, s ∈ e ∧ ∀ v ∈ e, v ∈ S → v = s := by
  classical
  have hnot : ¬ IsCover F (S \ {s}) :=
    hS.not_prop_of_lt (Set.sdiff_singleton_ssubset.mpr hs)
  rw [IsCover] at hnot
  push Not at hnot
  rcases hnot with ⟨e, heF, heAvoid⟩
  rcases hS.prop e heF with ⟨v, hve, hvS⟩
  have hvs : v = s := by
    by_contra hvs
    exact heAvoid v hve ⟨hvS, by simpa using hvs⟩
  refine ⟨e, heF, hvs ▸ hve, ?_⟩
  intro w hwe hwS
  by_contra hws
  exact heAvoid w hwe ⟨hwS, by simpa using hws⟩

/-- Zorn's lemma supplies a maximal disjoint subfamily of any hypergraph. -/
theorem exists_maximal_packing {V : Type} (F : Set (Set V)) :
    ∃ P, Maximal (IsPacking F) P := by
  classical
  apply zorn_subset
  intro c hc hchain
  refine ⟨⋃₀ c, ?_, ?_⟩
  · constructor
    · rintro e ⟨P, hPc, heP⟩
      exact (hc hPc).1 heP
    · intro e he f hf hef
      rcases he with ⟨P, hPc, heP⟩
      rcases hf with ⟨Q, hQc, hfQ⟩
      rcases hchain.total hPc hQc with hPQ | hQP
      · exact (hc hQc).2 e (hPQ heP) f hfQ hef
      · exact (hc hPc).2 e heP f (hQP hfQ) hef
  · intro P hPc
    exact Set.subset_sUnion_of_mem hPc

/-- Every nonempty hyperedge meets the union of a maximal packing. -/
theorem MaximalPacking.meets_sUnion {V : Type} {F P : Set (Set V)}
    (hP : Maximal (IsPacking F) P) {e : Set V}
    (heF : e ∈ F) (he : e.Nonempty) :
    ∃ v, v ∈ e ∧ v ∈ ⋃₀ P := by
  classical
  by_contra hmeet
  push Not at hmeet
  have hdisj : ∀ f ∈ P, Disjoint e f := by
    intro f hf
    exact Set.disjoint_left.mpr fun v hve hvf => hmeet v hve ⟨f, hf, hvf⟩
  have hinsert : IsPacking F (insert e P) := by
    constructor
    · intro f hf
      rcases hf with rfl | hf
      · exact heF
      · exact hP.prop.1 hf
    · intro f hf g hg hfg
      rcases hf with rfl | hf <;> rcases hg with rfl | hg
      · exact (hfg rfl).elim
      · exact hdisj g hg
      · exact (hdisj f hf).symm
      · exact hP.prop.2 f hf g hg hfg
  have heP : e ∈ P := by
    rw [hP.eq_of_subset hinsert (Set.subset_insert e P)]
    exact Set.mem_insert e P
  rcases he with ⟨v, hve⟩
  exact hmeet v hve ⟨e, heP, hve⟩

/-- A regular-cardinal finite-set dichotomy.  A family of nonempty finite
sets with at least `#μ` members either has a disjoint subfamily of size
`#μ`, or one point belongs to at least `#μ` members.  This is the
finite-support pigeonhole step used in Aharoni's fan-amalgamation argument. -/
theorem finiteSetFamily_large_packing_or_large_point
    {I V μ : Type} (s : I → Set V)
    (hfinite : ∀ i, (s i).Finite) (hnonempty : ∀ i, (s i).Nonempty)
    (hμreg : (#μ).IsRegular) (hμinf : ℵ₀ ≤ #μ) (hI : #μ ≤ #I) :
    (∃ P : Set (Set V), #μ ≤ #P ∧ IsPacking (Set.range s) P) ∨
      ∃ v : V, #μ ≤ #({i : I | v ∈ s i} : Set I) := by
  classical
  rcases exists_maximal_packing (Set.range s) with ⟨P, hP⟩
  by_cases hlarge : #μ ≤ #P
  · exact Or.inl ⟨P, hlarge, hP.prop⟩
  · have hPsmall : #P < #μ := lt_of_not_ge hlarge
    have hUnionSmall : #(⋃₀ P) < #μ := by
      rw [Set.sUnion_eq_biUnion]
      exact (Cardinal.card_biUnion_lt_iff_forall_of_isRegular
        hμreg hPsmall).2 (by
          intro e he
          rw [← Classical.choose_spec (hP.prop.1 he)]
          exact (Cardinal.mk_lt_aleph0_iff.mpr
            (hfinite (Classical.choose (hP.prop.1 he)))).trans_le hμinf)
    let hit : I → (⋃₀ P : Set V) := fun i =>
      ⟨Classical.choose
          (MaximalPacking.meets_sUnion hP ⟨i, rfl⟩ (hnonempty i)),
        (Classical.choose_spec
          (MaximalPacking.meets_sUnion hP ⟨i, rfl⟩ (hnonempty i))).2⟩
    have hhit_mem (i : I) : (hit i : V) ∈ s i := by
      exact (Classical.choose_spec
        (MaximalPacking.meets_sUnion hP ⟨i, rfl⟩ (hnonempty i))).1
    rcases Cardinal.infinite_pigeonhole_card hit (#μ) hI hμinf (by
        rw [hμreg.cof_ord]
        exact hUnionSmall) with ⟨v, hv⟩
    refine Or.inr ⟨v.1, hv.trans ?_⟩
    apply Cardinal.mk_le_mk_of_subset
    intro i hi
    have hiv : hit i = v := by simpa using hi
    simpa [hiv] using hhit_mem i

/-- Index-set form of `finiteSetFamily_large_packing_or_large_point`.
The large packing can be pulled back to a large set of original family
indices, because choosing one representing index for each packed set is
injective. -/
theorem finiteSetFamily_large_pairwiseDisjoint_or_large_point
    {I V μ : Type} (s : I → Set V)
    (hfinite : ∀ i, (s i).Finite) (hnonempty : ∀ i, (s i).Nonempty)
    (hμreg : (#μ).IsRegular) (hμinf : ℵ₀ ≤ #μ) (hI : #μ ≤ #I) :
    (∃ J : Set I, #μ ≤ #J ∧ J.PairwiseDisjoint s) ∨
      ∃ v : V, #μ ≤ #({i : I | v ∈ s i} : Set I) := by
  classical
  rcases finiteSetFamily_large_packing_or_large_point s hfinite hnonempty
      hμreg hμinf hI with hpack | hpoint
  · rcases hpack with ⟨P, hlarge, hP⟩
    let idx : P → I := fun e => Classical.choose (hP.1 e.2)
    have hidx_spec (e : P) : s (idx e) = e.1 :=
      Classical.choose_spec (hP.1 e.2)
    have hidx : Function.Injective idx := by
      intro e f hef
      apply Subtype.ext
      rw [← hidx_spec e, ← hidx_spec f, hef]
    refine Or.inl ⟨Set.range idx, ?_, ?_⟩
    · rw [Cardinal.mk_range_eq idx hidx]
      exact hlarge
    · rintro i ⟨e, rfl⟩ j ⟨f, rfl⟩ hij
      change Disjoint (s (idx e)) (s (idx f))
      rw [hidx_spec e, hidx_spec f]
      exact hP.2 e.1 e.2 f.1 f.2 (fun hef => hij (congrArg idx (Subtype.ext hef)))
  · exact Or.inr hpoint

/-- Removing a subsingleton from a set of at least an infinite cardinal does
not lower it below that cardinal. -/
theorem le_mk_sdiff_of_le_mk_of_subsingleton
    {I μ : Type} {S T : Set I} (hμinf : ℵ₀ ≤ #μ)
    (hS : #μ ≤ #S) (hT : T.Subsingleton) :
    #μ ≤ #(S \ T : Set I) := by
  by_contra hnot
  have hdiff : #(S \ T : Set I) < #μ := lt_of_not_ge hnot
  have hTlt : #T < #μ :=
    hT.cardinalMk_le_one.trans_lt (Cardinal.one_lt_aleph0.trans_le hμinf)
  have hSlt : #S < #μ :=
    (Cardinal.le_mk_sdiff_add_mk S T).trans_lt
      (Cardinal.add_lt_of_lt hμinf hdiff hTlt)
  exact (not_lt_of_ge hS) hSlt

/-- The elementary maximal-family argument: there is a disjoint path packing
whose full vertex union meets every `A`--`B` path.  The Aharoni--Berger core
strengthens this full union to one chosen vertex per packed path. -/
theorem exists_maximal_path_packing_cover {V : Type}
    (G : SimpleGraph V) (A B : Set V) :
    ∃ P, IsPacking (pathHypergraph G A B) P ∧
      ∀ e ∈ pathHypergraph G A B, ∃ v, v ∈ e ∧ v ∈ ⋃₀ P := by
  classical
  rcases exists_maximal_packing (pathHypergraph G A B) with ⟨P, hP⟩
  refine ⟨P, hP.prop, ?_⟩
  intro e he
  apply MaximalPacking.meets_sUnion hP he
  rcases he with ⟨p, rfl⟩
  exact ⟨p.left, p.walk.start_mem_support⟩

/-- Covering the path hypergraph is definitionally the same mathematical
condition as separating `A` from `B`. -/
theorem isCover_pathHypergraph_iff {V : Type} {G : SimpleGraph V}
    {A B S : Set V} :
    IsCover (pathHypergraph G A B) S ↔ Separates G A B S := by
  constructor
  · intro hcover a ha b hb q hq
    let p : ABPath G A B := ⟨a, b, ha, hb, q, hq⟩
    rcases hcover p.vertices ⟨p, rfl⟩ with ⟨v, hvp, hvS⟩
    exact ⟨v, hvp, hvS⟩
  · intro hsep e he
    rcases he with ⟨p, rfl⟩
    rcases hsep p.left p.left_mem p.right p.right_mem p.walk p.isPath with
      ⟨v, hvp, hvS⟩
    exact ⟨v, hvp, hvS⟩

theorem pathHypergraph_edge_finite {V : Type} {G : SimpleGraph V}
    {A B : Set V} {e : Set V} (he : e ∈ pathHypergraph G A B) :
    e.Finite := by
  rcases he with ⟨p, rfl⟩
  exact p.walk.support.finite_toSet

/-- Hence every `A`--`B` separator contains an inclusion-minimal separator. -/
theorem exists_minimal_separator {V : Type} {G : SimpleGraph V}
    {A B U : Set V} (hU : Separates G A B U) :
    ∃ S ⊆ U, Minimal (Separates G A B) S := by
  have hU' : IsCover (pathHypergraph G A B) U :=
    isCover_pathHypergraph_iff.mpr hU
  rcases exists_minimal_cover
      (F := pathHypergraph G A B) (fun e he => pathHypergraph_edge_finite he) hU' with
    ⟨S, hSU, hS⟩
  refine ⟨S, hSU, isCover_pathHypergraph_iff.mp hS.prop, ?_⟩
  intro T hT hTS
  exact hS.2 (isCover_pathHypergraph_iff.mpr hT) hTS

/-- Minimality supplies, for each separator vertex, an `A`--`B` path that
meets the separator nowhere else. -/
theorem MinimalSeparator.exists_path_meeting_only {V : Type}
    {G : SimpleGraph V} {A B S : Set V}
    (hS : Minimal (Separates G A B) S) {s : V} (hs : s ∈ S) :
    ∃ p : ABPath G A B,
      s ∈ p.vertices ∧ ∀ v ∈ p.vertices, v ∈ S → v = s := by
  have hS' : Minimal (IsCover (pathHypergraph G A B)) S := by
    refine ⟨isCover_pathHypergraph_iff.mpr hS.prop, ?_⟩
    intro T hT hTS
    exact hS.2 (isCover_pathHypergraph_iff.mp hT) hTS
  rcases MinimalCover.exists_private_edge hS' hs with
    ⟨e, ⟨p, rfl⟩, hse, hprivate⟩
  exact ⟨p, hse, hprivate⟩

/-- The source side of the exterior quotient associated with any boundary
is trimmed.  Minimality of the essential boundary supplies the private
source-to-target path. -/
theorem essentialVertices_isTrimmedWeb_outside {V : Type}
    (G : SimpleGraph V) (B S : Set V) :
    IsTrimmedWeb (outsideGraph G (interiorRoof G B S))
      (essentialVertices G B S) B := by
  classical
  intro e he
  have hmin := essentialVertices_minimal_outside_separator G B S
  rcases MinimalSeparator.exists_path_meeting_only hmin he with
    ⟨p, hep, hpOnly⟩
  have hleft : p.left = e :=
    hpOnly p.left p.walk.start_mem_support p.left_mem
  subst e
  exact ⟨p.right, p.right_mem, p.walk, p.isPath,
    fun x hx hxE => hpOnly x hx hxE⟩

/-- Combining the two elementary Zorn arguments gives a disjoint path
packing and a minimal separator contained in its full vertex union.  What is
still missing here is simultaneous orthogonality: the minimal separator can
meet one packed path more than once. -/
theorem exists_packing_and_minimal_separator {V : Type}
    (G : SimpleGraph V) (A B : Set V) :
    ∃ (P : Set (Set V)) (S : Set V),
      IsPacking (pathHypergraph G A B) P ∧
      Minimal (Separates G A B) S ∧
      S ⊆ ⋃₀ P := by
  rcases exists_maximal_path_packing_cover G A B with ⟨P, hP, hcover⟩
  have hsep : Separates G A B (⋃₀ P) :=
    isCover_pathHypergraph_iff.mp hcover
  rcases exists_minimal_separator hsep with ⟨S, hSsub, hS⟩
  exact ⟨P, S, hP, hS, hSsub⟩

/-- A structural Kőnig pair for a hypergraph: a disjoint subfamily and a
vertex cover choosing precisely one point of every member of the subfamily. -/
def HasKonigPair {V : Type} (F : Set (Set V)) : Prop :=
  ∃ (P : Set (Set V)) (S : Set V),
    P ⊆ F ∧
    (∀ e, e ∈ P → ∀ f, f ∈ P → e ≠ f → Disjoint e f) ∧
    S ⊆ ⋃₀ P ∧
    (∀ e ∈ P, ∃! v, v ∈ S ∧ v ∈ e) ∧
    (∀ e ∈ F, ∃ v, v ∈ e ∧ v ∈ S)

/-- Finite cardinal equality upgrades a packing/cover pair to structural
orthogonality.  This is the extraction step used after finite Menger. -/
theorem hasKonigPair_of_finite_equinumerous {V : Type} {F P : Set (Set V)}
    {S : Set V} (hP : IsPacking F P) (hS : IsCover F S)
    (hPfinite : P.Finite) (hSfinite : S.Finite) (hcard : P.ncard = S.ncard) :
    HasKonigPair F := by
  classical
  have hex (e : P) : ∃ v, v ∈ (e : Set V) ∧ v ∈ S :=
    hS (e : Set V) (hP.1 e.property)
  choose chosen hchosen_edge hchosen_S using hex
  let point : P → S := fun e => ⟨chosen e, hchosen_S e⟩
  have hpoint_injective : Function.Injective point := by
    intro e f hef
    apply Subtype.ext
    by_contra hne
    have hef' : (e : Set V) ≠ (f : Set V) := by
      intro h
      exact hne h
    have hd := hP.2 (e : Set V) e.property (f : Set V) f.property hef'
    have hval : chosen e = chosen f := congrArg Subtype.val hef
    exact Set.disjoint_left.mp hd (hchosen_edge e) (hval ▸ hchosen_edge f)
  let _ : Fintype P := hPfinite.fintype
  let _ : Fintype S := hSfinite.fintype
  have hpoint_bijective : Function.Bijective point := by
    apply (Fintype.bijective_iff_injective_and_card point).mpr
    refine ⟨hpoint_injective, ?_⟩
    rw [Set.fintypeCard_eq_ncard, Set.fintypeCard_eq_ncard, hcard]
  refine ⟨P, S, hP.1, hP.2, ?_, ?_, hS⟩
  · intro v hvS
    rcases hpoint_bijective.2 ⟨v, hvS⟩ with ⟨e, he⟩
    have hval : chosen e = v := congrArg Subtype.val he
    exact ⟨e, e.property, hval ▸ hchosen_edge e⟩
  · intro e heP
    let i : P := ⟨e, heP⟩
    refine ⟨chosen i, ⟨hchosen_S i, hchosen_edge i⟩, ?_⟩
    intro v hv
    rcases hpoint_bijective.2 ⟨v, hv.1⟩ with ⟨j, hj⟩
    have hjv : chosen j = v := congrArg Subtype.val hj
    have hji : j = i := by
      by_contra hji
      have hsets : (j : Set V) ≠ (i : Set V) := by
        intro h
        exact hji (Subtype.ext h)
      have hd := hP.2 (j : Set V) j.property (i : Set V) i.property hsets
      exact Set.disjoint_left.mp hd (hchosen_edge j) (by simpa [hjv] using hv.2)
    exact hjv.symm.trans (congrArg chosen hji)

/-- The witness package in the Formal Conjectures statement of Erdős Problem 599. -/
def HasErdosMengerPair {V : Type} (G : SimpleGraph V) (A B : Set V) : Prop :=
  ∃ (ι : Type) (a b : ι → V) (p : ∀ i, G.Walk (a i) (b i)) (S : Set V),
    (∀ i, a i ∈ A) ∧
    (∀ i, b i ∈ B) ∧
    (∀ i, (p i).IsPath) ∧
    (Pairwise fun i j =>
      Disjoint {v | v ∈ (p i).support} {v | v ∈ (p j).support}) ∧
    S ⊆ {v | ∃ i, v ∈ (p i).support} ∧
    (∀ i, ∃! v, v ∈ S ∧ v ∈ (p i).support) ∧
    Separates G A B S

/-- The final quotient-splicing step of Aharoni--Berger.  A clean linkage in
the exterior of a wave is attached to the essential members of the wave.
The old essential boundary, rather than the endpoints of the quotient
linkage, is the orthogonal separator. -/
theorem hasErdosMengerPair_of_exterior_cleanLinkage
    {V : Type} {G : SimpleGraph V} {W : Warp G} {A B : Set V}
    (hW : W.IsWave A B)
    (U : Warp (outsideGraph G (interiorRoof G B W.terminalSet)))
    (hU : U.IsCleanLinkage (essentialVertices G B W.terminalSet) B) :
    HasErdosMengerPair G A B := by
  classical
  let E := essentialVertices G B W.terminalSet
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B W.terminalSet))
  have heEssential (j : U.ι) : (U.path j).initial ∈ E := by
    change (U.path j).initial ∈ essentialVertices G B W.terminalSet
    rw [← hU.1.1]
    exact ⟨j, rfl⟩
  have holdExists (j : U.ι) :
      ∃ i : W.ι, (W.path i).terminal? = some (U.path j).initial := by
    exact essentialVertices_subset G B W.terminalSet (heEssential j)
  choose old holdTerminal using holdExists
  have holdFiniteExists (j : U.ι) :=
    LongPath.terminal?_eq_some_iff.mp (holdTerminal j)
  choose oldEnd holdFinite holdVertex using holdFiniteExists
  have htargetExists (j : U.ι) := hU.1.2 j
  choose target htargetB htargetTerminal using htargetExists
  have hjZero (j : U.ι) : longPathActive (U'.path j).terminalIndex 0 := by
    cases (U'.path j).terminalIndex <;> simp [longPathActive]
  have hExterior : Disjoint U.vertexSet
      (interiorRoof G B W.terminalSet) :=
    Warp.vertexSet_disjoint_interior_of_outside_starting hU.1.isStarting
  let d (j : U.ι) : Warp.ExtensionData W U' (old j) := {
    endIndex := oldEnd j
    finite := holdFinite j
    carrier := j
    meetIndex := 0
    meetActive := hjZero j
    join := by
      change (U.path j).vertex 0 = (W.path (old j)).vertex (oldEnd j)
      exact (holdVertex j).symm
    avoidsOld := by
      rintro x ⟨hxTail, hxOld⟩
      have hxMapped : x ∈ (U'.path j).vertexSet :=
        (U'.path j).vertexSet_tail_subset 0 (hjZero j) hxTail
      have hxUPath : x ∈ (U.path j).vertexSet := hxMapped
      have hxU : x ∈ U.vertexSet := ⟨j, hxUPath⟩
      have hxOutside : x ∉ interiorRoof G B W.terminalSet := by
        intro hxInterior
        exact Set.disjoint_left.mp hExterior hxU hxInterior
      have hxRoof : x ∈ roof G B W.terminalSet :=
        hW.vertexSet_subset_roof hxOld
      have hxEssential : x ∈ essentialVertices G B W.terminalSet := by
        by_contra hxNotEssential
        exact hxOutside ⟨hxRoof, hxNotEssential⟩
      have hxInitial : x = (U.path j).initial :=
        hU.2 j x hxUPath hxEssential
      exact Set.mem_singleton_iff.mpr
        (hxInitial.trans (holdVertex j).symm) }
  have hdTerminal (j : U.ι) :
      (d j).extendedPath.terminal? = some (target j) := by
    rw [(d j).terminal?_extendedPath]
    exact htargetTerminal j
  have hdfiniteExists (j : U.ι) :=
    LongPath.terminal?_eq_some_iff.mp (hdTerminal j)
  choose finalIndex hfinalFinite hfinalVertex using hdfiniteExists
  have hfinalActive (j : U.ι) :
      longPathActive (d j).extendedPath.terminalIndex (finalIndex j) := by
    simp [hfinalFinite j, longPathActive]
  have holdInjective : Function.Injective old := by
    intro j k holdEq
    by_contra hjk
    have hsome : some (U.path j).initial = some (U.path k).initial :=
      (holdTerminal j).symm.trans (by simpa [holdEq] using holdTerminal k)
    have hinitial : (U.path j).initial = (U.path k).initial :=
      Option.some.inj hsome
    have hjmem := (U.path j).initial_mem_vertexSet
    have hkmem : (U.path j).initial ∈ (U.path k).vertexSet := by
      simpa [hinitial] using (U.path k).initial_mem_vertexSet
    exact Set.disjoint_left.mp (U.disjoint hjk) hjmem hkmem
  let P : FCWarp G := {
    ι := U.ι
    start := fun j => (d j).extendedPath.initial
    finish := target
    path := fun j =>
      ((d j).extendedPath.prefixWalk (finalIndex j) (hfinalActive j)).copy
        rfl (hfinalVertex j)
    isPath := by
      intro j
      have hp := (d j).extendedPath.prefixWalk_isPath (hfinalActive j)
      simpa [SimpleGraph.Walk.isPath_def] using hp
    disjoint := by
      intro j k hjk
      have hd := (d j).disjoint_extendedPath
        (fun h => hjk (holdInjective h)) (d k)
      rw [(d j).extendedPath.vertexSet_eq_support_prefixWalk
          (hfinalFinite j) (hfinalActive j),
        (d k).extendedPath.vertexSet_eq_support_prefixWalk
          (hfinalFinite k) (hfinalActive k)] at hd
      simpa using hd }
  have hsupport (j : U.ι) :
      {x | x ∈ (P.path j).support} = (d j).extendedPath.vertexSet := by
    symm
    rw [(d j).extendedPath.vertexSet_eq_support_prefixWalk
      (hfinalFinite j) (hfinalActive j)]
    simp [P]
  have hOldEssentialUnique (j : U.ι) {x : V}
      (hxOld : x ∈ (W.path (old j)).vertexSet)
      (hxE : x ∈ E) : x = (U.path j).initial := by
    have hxTerminal : x ∈ W.terminalSet :=
      essentialVertices_subset G B W.terminalSet hxE
    rcases hxTerminal with ⟨i, hiTerminal⟩
    by_cases hi : i = old j
    · subst i
      exact Option.some.inj (hiTerminal.symm.trans (holdTerminal j))
    · have hxi : x ∈ (W.path i).vertexSet :=
        LongPath.terminal_mem_vertexSet hiTerminal
      exact (Set.disjoint_left.mp (W.disjoint (Ne.symm hi)) hxOld hxi).elim
  have hExtendedEssentialUnique (j : U.ι) {x : V}
      (hx : x ∈ (d j).extendedPath.vertexSet) (hxE : x ∈ E) :
      x = (U.path j).initial := by
    rw [(d j).vertexSet_extendedPath] at hx
    rcases hx with hxOld | hxNew
    · exact hOldEssentialUnique j hxOld hxE
    · have hxMapped : x ∈ (U'.path j).vertexSet :=
        (U'.path j).vertexSet_tail_subset 0 (hjZero j) hxNew
      have hxU : x ∈ (U.path j).vertexSet := hxMapped
      exact hU.2 j x hxU hxE
  refine ⟨P.ι, P.start, P.finish, P.path, E, ?_, ?_, P.isPath,
    P.disjoint, ?_, ?_, ?_⟩
  · intro j
    change (d j).extendedPath.initial ∈ A
    rw [(d j).initial_extendedPath]
    exact hW.1 ⟨old j, rfl⟩
  · intro j
    exact htargetB j
  · intro x hxE
    have hxInitial : x ∈ U.initialSet := by
      rw [hU.1.1]
      exact hxE
    rcases hxInitial with ⟨j, hj⟩
    refine ⟨j, ?_⟩
    apply (Set.ext_iff.mp (hsupport j) x).mpr
    rw [(d j).vertexSet_extendedPath]
    apply Or.inl
    have hjTerminal : (W.path (old j)).terminal? = some x := by
      simpa [hj] using holdTerminal j
    exact LongPath.terminal_mem_vertexSet hjTerminal
  · intro j
    let e := (U.path j).initial
    have heE : e ∈ E := heEssential j
    have heExtended : e ∈ (d j).extendedPath.vertexSet := by
      rw [(d j).vertexSet_extendedPath]
      exact Or.inl (LongPath.terminal_mem_vertexSet (holdTerminal j))
    refine ⟨e, ⟨heE, ?_⟩, ?_⟩
    · exact (Set.ext_iff.mp (hsupport j) e).mpr heExtended
    · intro x hx
      have hxExtended : x ∈ (d j).extendedPath.vertexSet := by
        exact (Set.ext_iff.mp (hsupport j) x).mp hx.2
      exact (hExtendedEssentialUnique j hxExtended hx.1).trans rfl
  · exact essentialVertices_separates hW.2

/-- The one remaining global combinatorial assertion in the
Aharoni--Berger reduction: every trimmed clean-loose web is linkable by a
source-clean warp. -/
def CleanLooseLinkability : Prop :=
  ∀ (V : Type) (G : SimpleGraph V) (A B : Set V),
    IsTrimmedWeb G A B → Warp.IsCleanLoose G A B →
    ∃ W : Warp G, W.IsCleanLinkage A B

/-- Aharoni--Berger's safe one-point removal assertion (Theorem 6.1),
stated for the source-clean symmetric encoding used here. -/
def SafePathRemoval : Prop :=
  ∀ (V : Type) (G : SimpleGraph V) (A B : Set V),
    Warp.IsCleanUnhindered G A B → ∀ a ∈ A,
      ∃ b ∈ B, ∃ q : G.Walk a b,
        q.IsPath ∧
        (∀ x ∈ q.support, x ∈ A → x = a) ∧
        Warp.IsCleanUnhindered
          (outsideGraph G {x | x ∈ q.support})
          (A \ {x | x ∈ q.support})
          (B \ {x | x ∈ q.support})

/-- Aharoni--Berger Theorem 6.1.  If no safe path left `a`, a maximal safe
rooted set `T` would be disjoint from the target.  Proposition 6.3 supplies,
for every outer-boundary vertex of `T`, a wave in `G-a-Q` roofing that
vertex.  A roof-maximal total wave dominates all of them; Lemma 6.2 then
lifts it to a source-clean hindrance of the original web, contradicting
clean unhinderedness. -/
theorem safePathRemoval : SafePathRemoval := by
  intro V G A B hG a ha
  classical
  by_cases haB : a ∈ B
  · refine ⟨a, haB, (.nil : G.Walk a a), by simp, ?_, ?_⟩
    · intro x hx _hxA
      simpa using hx
    · simpa using hG.deleteSource ha
  · by_contra hno
    rcases Warp.exists_maximal_isSafeRootSet hG ha with ⟨T, hT⟩
    have hTB : Disjoint T B :=
      hT.prop.disjoint_target_of_no_safePath hno
    let Q := Warp.unboundedTreeVertices G A B T a
    let H := outsideGraph G ({a} : Set V)
    let K := outsideGraph H Q
    let A₀ := A \ ({a} : Set V)
    let B₀ := B \ ({a} : Set V)
    let A' := A₀ \ Q
    let B' := B₀ \ Q
    let M := Classical.choose (Warp.TotalWave.exists_isMax K A' B')
    have hMmax : IsMax M :=
      Classical.choose_spec (Warp.TotalWave.exists_isMax K A' B')
    have hboundary : outerBoundary G T ⊆
        roof K B' M.toWarp.terminalSet := by
      intro z hz
      let y : outerBoundary G T := ⟨z, hz⟩
      rcases Warp.exists_safeTreeBoundaryWave hT y hTB with
        ⟨U, hUwave, _hUclean, hzU⟩
      have hUM : Warp.RoofLE B' U M.toWarp :=
        Warp.WaveExtension.roofLE_of_isMax hMmax U hUwave
      exact hUM hzU
    let D : Set V := {a} ∪ Q
    have hKD : K = outsideGraph G D := by
      simp [K, H, D, outsideGraph_outsideGraph]
    let M' : Warp (outsideGraph G D) :=
      Erdos599.Warp.castGraph hKD M.toWarp
    have hAD : A \ D = A' := by
      simp [D, A', A₀, Set.sdiff_sdiff]
    have hBD : B \ D = B' := by
      simp [D, B', B₀, Set.sdiff_sdiff]
    have hM'wave : M'.IsWave (A \ D) (B \ D) := by
      have h := M.isWave.castGraph hKD
      simpa [M', Warp.WaveExtension.toWarp, hAD, hBD] using h
    have hM'clean : M'.IsSourceClean (A \ D) := by
      have h := M.isSourceClean.castGraph hKD
      simpa [M', hAD] using h
    have hDT : D ⊆ T := by
      rintro x (hxa | hxQ)
      · exact Set.mem_singleton_iff.mp hxa ▸ hT.prop.1
      · exact hxQ.1
    have hboundary' : outerBoundary G T ⊆
        roof (outsideGraph G D) (B \ D) M'.terminalSet := by
      intro z hz
      have hzM := hboundary hz
      simpa [M', hBD, hKD] using hzM
    have hZwave := Warp.IsWave.mapLE_of_subset_outerBoundary_roof
      M' hM'wave hDT hTB.symm hboundary'
    have hZclean := Warp.IsSourceClean.mapLE_of_outside_sdiff
      hM'wave.1 hM'clean
    have haInitial := hG
      (M'.mapLE (outsideGraph_le G D)) hZwave hZclean ha
    change a ∈ M'.initialSet at haInitial
    rw [Warp.initialSet_castGraph, Warp.TotalWave.initialSet_toWarp] at haInitial
    exact haInitial.1.2 (Set.mem_singleton a)

/-- One finite stage of the countable safe-removal construction. -/
structure SafeStage {V : Type} (G : SimpleGraph V) (A B : Set V) where
  deleted : Set V
  unhindered : Warp.IsCleanUnhindered (outsideGraph G deleted)
    (A \ deleted) (B \ deleted)

/-- The result of processing one enumerated source.  A source already deleted
is skipped; otherwise the safe path is recorded and its support is added to
the deleted set. -/
structure SafeStepResult {V : Type} {G : SimpleGraph V} {A B : Set V}
    (s : SafeStage G A B) (a : V) where
  next : SafeStage G A B
  chosen : Option (LongPath G)
  chosen_some_iff : chosen.isSome ↔ a ∉ s.deleted
  none_deleted : chosen = none → next.deleted = s.deleted
  some_spec : ∀ p, chosen = some p →
    next.deleted = s.deleted ∪ p.vertexSet ∧
    p.initial = a ∧
    (∃ b ∈ B, p.terminal? = some b) ∧
    Disjoint p.vertexSet s.deleted ∧
    (∀ v ∈ p.vertexSet, v ∈ A → v = a)

/-- Process one source in a safe-removal stage. -/
noncomputable def safeStep (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (s : SafeStage G A B) (a : V) (ha : a ∈ A) :
    SafeStepResult s a := by
  classical
  by_cases hadel : a ∈ s.deleted
  · exact {
      next := s
      chosen := none
      chosen_some_iff := by simp [hadel]
      none_deleted := fun _ => rfl
      some_spec := by simp }
  · have haResidual : a ∈ A \ s.deleted := ⟨ha, hadel⟩
    have hex := hsafe V (outsideGraph G s.deleted) (A \ s.deleted)
      (B \ s.deleted) s.unhindered a haResidual
    let b : V := Classical.choose hex
    have hbrest := Classical.choose_spec hex
    have hb : b ∈ B \ s.deleted := hbrest.1
    let q : (outsideGraph G s.deleted).Walk a b :=
      Classical.choose hbrest.2
    have hqrest := Classical.choose_spec hbrest.2
    have hq : q.IsPath := hqrest.1
    have hsource := hqrest.2.1
    have hresidual := hqrest.2.2
    let r : LongPath (outsideGraph G s.deleted) := LongPath.ofWalk q hq
    let p : LongPath G := r.mapLE (outsideGraph_le G s.deleted)
    have hpVertex : p.vertexSet = {v | v ∈ q.support} := by
      simp [p, r]
    have hpDisjoint : Disjoint p.vertexSet s.deleted := by
      rw [Set.disjoint_left]
      intro v hvp hvdel
      have hvr : v ∈ r.vertexSet := by
        simpa [p] using hvp
      have hrInitial : r.initial = a := by simp [r]
      exact r.vertex_not_mem_of_outsideGraph (hrInitial ▸ hadel) hvr hvdel
    let d : Set V := s.deleted ∪ p.vertexSet
    change Warp.IsCleanUnhindered
      (outsideGraph (outsideGraph G s.deleted) {x | x ∈ q.support})
      ((A \ s.deleted) \ {x | x ∈ q.support})
      ((B \ s.deleted) \ {x | x ∈ q.support}) at hresidual
    have hnextUnhindered : Warp.IsCleanUnhindered
        (outsideGraph G d) (A \ d) (B \ d) := by
      simpa [d, p, r, Set.sdiff_sdiff] using hresidual
    let next : SafeStage G A B := ⟨d, hnextUnhindered⟩
    exact {
      next := next
      chosen := some p
      chosen_some_iff := by simp [hadel]
      none_deleted := by simp
      some_spec := by
        intro p' hp'
        have hp'eq : p' = p := Option.some.inj hp'.symm
        subst p'
        refine ⟨rfl, ?_, ?_, hpDisjoint, ?_⟩
        · simp [p, r]
        · exact ⟨b, hb.1, by simpa [p, r]⟩
        · intro v hvp hvA
          have hvq : v ∈ q.support := by
            simpa [hpVertex] using hvp
          have hvOutside : v ∉ s.deleted := by
            intro hvdel
            exact Set.disjoint_left.mp hpDisjoint hvp hvdel
          exact hsource v hvq ⟨hvA, hvOutside⟩ }

def initialSafeStage {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) : SafeStage G A B where
  deleted := ∅
  unhindered := by simpa using hunhindered

/-- The finite stages obtained by processing a countable enumeration of the
source side. -/
noncomputable def safeStageSeq (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) :
    ℕ → SafeStage G A B := fun n =>
  Nat.rec (initialSafeStage hunhindered)
    (fun k s => (safeStep hsafe s (e k) (e k).property).next) n

/-- The path, if any, chosen while processing the `n`th enumerated source. -/
noncomputable def safeChosen (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    (n : ℕ) : Option (LongPath G) :=
  (safeStep hsafe (safeStageSeq hsafe hunhindered e n)
    (e n) (e n).property).chosen

@[simp] theorem safeStageSeq_zero (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) :
    safeStageSeq hsafe hunhindered e 0 = initialSafeStage hunhindered := rfl

@[simp] theorem safeStageSeq_succ (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) (n : ℕ) :
    safeStageSeq hsafe hunhindered e (n + 1) =
      (safeStep hsafe (safeStageSeq hsafe hunhindered e n)
        (e n) (e n).property).next := rfl

theorem safeStageSeq_deleted_succ (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) (n : ℕ) :
    (safeStageSeq hsafe hunhindered e (n + 1)).deleted =
      match safeChosen hsafe hunhindered e n with
      | none => (safeStageSeq hsafe hunhindered e n).deleted
      | some p => (safeStageSeq hsafe hunhindered e n).deleted ∪ p.vertexSet := by
  let s := safeStageSeq hsafe hunhindered e n
  let r := safeStep hsafe s (e n) (e n).property
  change r.next.deleted = match r.chosen with
    | none => s.deleted
    | some p => s.deleted ∪ p.vertexSet
  cases h : r.chosen with
  | none => exact r.none_deleted h
  | some p => exact (r.some_spec p h).1

theorem safeStageSeq_deleted_subset_succ (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) (n : ℕ) :
    (safeStageSeq hsafe hunhindered e n).deleted ⊆
      (safeStageSeq hsafe hunhindered e (n + 1)).deleted := by
  rw [safeStageSeq_deleted_succ]
  cases h : safeChosen hsafe hunhindered e n <;> simp

theorem safeStageSeq_deleted_mono (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    {m n : ℕ} (hmn : m ≤ n) :
    (safeStageSeq hsafe hunhindered e m).deleted ⊆
      (safeStageSeq hsafe hunhindered e n).deleted := by
  induction n, hmn using Nat.le_induction with
  | base => exact Set.Subset.rfl
  | succ n hmn ih =>
      exact ih.trans (safeStageSeq_deleted_subset_succ hsafe hunhindered e n)

theorem safeChosen_isSome_iff (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) (n : ℕ) :
    (safeChosen hsafe hunhindered e n).isSome ↔
      (e n : V) ∉ (safeStageSeq hsafe hunhindered e n).deleted := by
  exact (safeStep hsafe (safeStageSeq hsafe hunhindered e n)
    (e n) (e n).property).chosen_some_iff

theorem safeChosen_some_spec (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    {n : ℕ} {p : LongPath G} (hp : safeChosen hsafe hunhindered e n = some p) :
    (safeStageSeq hsafe hunhindered e (n + 1)).deleted =
        (safeStageSeq hsafe hunhindered e n).deleted ∪ p.vertexSet ∧
      p.initial = e n ∧
      (∃ b ∈ B, p.terminal? = some b) ∧
      Disjoint p.vertexSet (safeStageSeq hsafe hunhindered e n).deleted ∧
      (∀ v ∈ p.vertexSet, v ∈ A → v = e n) := by
  exact (safeStep hsafe (safeStageSeq hsafe hunhindered e n)
    (e n) (e n).property).some_spec p hp

def SafeChosenIndex (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) :=
  {n : ℕ // (safeChosen hsafe hunhindered e n).isSome}

noncomputable def safeChosenPath (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    (i : SafeChosenIndex hsafe hunhindered e) : LongPath G :=
  Classical.choose (Option.isSome_iff_exists.mp i.property)

theorem safeChosen_eq_some_path (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    (i : SafeChosenIndex hsafe hunhindered e) :
    safeChosen hsafe hunhindered e i.1 =
      some (safeChosenPath hsafe hunhindered e i) :=
  Classical.choose_spec (Option.isSome_iff_exists.mp i.property)

theorem safeChosenPath_pairwise_disjoint (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) :
    Pairwise fun i j : SafeChosenIndex hsafe hunhindered e =>
      Disjoint (safeChosenPath hsafe hunhindered e i).vertexSet
        (safeChosenPath hsafe hunhindered e j).vertexSet := by
  intro i j hij
  let pi := safeChosenPath hsafe hunhindered e i
  let pj := safeChosenPath hsafe hunhindered e j
  have hi := safeChosen_some_spec hsafe hunhindered e
    (safeChosen_eq_some_path hsafe hunhindered e i)
  have hj := safeChosen_some_spec hsafe hunhindered e
    (safeChosen_eq_some_path hsafe hunhindered e j)
  have hne : i.1 ≠ j.1 := by
    intro h
    exact hij (Subtype.ext h)
  rcases lt_or_gt_of_ne hne with hijNat | hjiNat
  · rw [Set.disjoint_left]
    intro v hvi hvj
    have hviNext : v ∈
        (safeStageSeq hsafe hunhindered e (i.1 + 1)).deleted := by
      rw [hi.1]
      exact Or.inr hvi
    have hviStage : v ∈
        (safeStageSeq hsafe hunhindered e j.1).deleted :=
      safeStageSeq_deleted_mono hsafe hunhindered e
        (Nat.succ_le_of_lt hijNat) hviNext
    exact Set.disjoint_left.mp hj.2.2.2.1 hvj hviStage
  · rw [Set.disjoint_left]
    intro v hvi hvj
    have hvjNext : v ∈
        (safeStageSeq hsafe hunhindered e (j.1 + 1)).deleted := by
      rw [hj.1]
      exact Or.inr hvj
    have hvjStage : v ∈
        (safeStageSeq hsafe hunhindered e i.1).deleted :=
      safeStageSeq_deleted_mono hsafe hunhindered e
        (Nat.succ_le_of_lt hjiNat) hvjNext
    exact Set.disjoint_left.mp hi.2.2.2.1 hvi hvjStage

noncomputable def countableSafeWarp (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A) : Warp G :=
  Warp.ofPaths (safeChosenPath hsafe hunhindered e)
    (safeChosenPath_pairwise_disjoint hsafe hunhindered e)

/-- Every source vertex in a finite deleted set is the initial vertex of an
earlier recorded path.  Source-cleanliness is what rules out accidental
deletion by somebody else's path. -/
theorem mem_safeStageSeq_deleted_exists_chosen_initial
    (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    {n : ℕ} {a : V} (ha : a ∈ A)
    (hadel : a ∈ (safeStageSeq hsafe hunhindered e n).deleted) :
    ∃ i : SafeChosenIndex hsafe hunhindered e,
      i.1 < n ∧ (safeChosenPath hsafe hunhindered e i).initial = a := by
  induction n with
  | zero =>
      simpa [safeStageSeq, initialSafeStage] using hadel
  | succ n ih =>
      have hrec := safeStageSeq_deleted_succ hsafe hunhindered e n
      cases hchosen : safeChosen hsafe hunhindered e n with
      | none =>
          rw [hrec, hchosen] at hadel
          rcases ih hadel with ⟨i, hin, hi⟩
          exact ⟨i, hin.trans (Nat.lt_succ_self n), hi⟩
      | some p =>
          rw [hrec, hchosen] at hadel
          rcases hadel with haOld | hap
          · rcases ih haOld with ⟨i, hin, hi⟩
            exact ⟨i, hin.trans (Nat.lt_succ_self n), hi⟩
          · have hspec := safeChosen_some_spec hsafe hunhindered e hchosen
            let i : SafeChosenIndex hsafe hunhindered e :=
              ⟨n, by simp [hchosen]⟩
            have hip : safeChosenPath hsafe hunhindered e i = p := by
              apply Option.some.inj
              exact (safeChosen_eq_some_path hsafe hunhindered e i).symm.trans hchosen
            refine ⟨i, Nat.lt_succ_self n, ?_⟩
            rw [hip, hspec.2.1]
            exact (hspec.2.2.2.2 a hap ha).symm

theorem countableSafeWarp_isCleanLinkage (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) (e : ℕ → A)
    (he : Function.Surjective e) :
    (countableSafeWarp hsafe hunhindered e).IsCleanLinkage A B := by
  classical
  let W := countableSafeWarp hsafe hunhindered e
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · ext a
    constructor
    · rintro ⟨i, hi⟩
      have hspec := safeChosen_some_spec hsafe hunhindered e
        (safeChosen_eq_some_path hsafe hunhindered e i)
      have hi' : (safeChosenPath hsafe hunhindered e i).initial = a := by
        exact hi
      rw [hspec.2.1] at hi'
      exact hi' ▸ (e i.1).property
    · intro ha
      let a' : A := ⟨a, ha⟩
      rcases he a' with ⟨n, hen⟩
      have henVal : (e n : V) = a := congrArg Subtype.val hen
      by_cases hadel : a ∈
          (safeStageSeq hsafe hunhindered e n).deleted
      · rcases mem_safeStageSeq_deleted_exists_chosen_initial
          hsafe hunhindered e ha hadel with ⟨i, _, hi⟩
        exact ⟨i, hi⟩
      · have henot : (e n : V) ∉
            (safeStageSeq hsafe hunhindered e n).deleted := by
          simpa [henVal] using hadel
        have hisSome : (safeChosen hsafe hunhindered e n).isSome :=
          (safeChosen_isSome_iff hsafe hunhindered e n).2 henot
        let i : SafeChosenIndex hsafe hunhindered e := ⟨n, hisSome⟩
        have hspec := safeChosen_some_spec hsafe hunhindered e
          (safeChosen_eq_some_path hsafe hunhindered e i)
        refine ⟨i, ?_⟩
        change (safeChosenPath hsafe hunhindered e i).initial = a
        exact hspec.2.1.trans henVal
  · intro i
    have hspec := safeChosen_some_spec hsafe hunhindered e
      (safeChosen_eq_some_path hsafe hunhindered e i)
    exact hspec.2.2.1
  · intro i v hv hvA
    have hspec := safeChosen_some_spec hsafe hunhindered e
      (safeChosen_eq_some_path hsafe hunhindered e i)
    change v = (safeChosenPath hsafe hunhindered e i).initial
    exact (hspec.2.2.2.2 v hv hvA).trans hspec.2.1.symm

/-- The zero-source base case of the linkability induction. -/
theorem exists_cleanLinkage_empty {V : Type} (G : SimpleGraph V)
    (B : Set V) :
    ∃ W : Warp G, W.IsCleanLinkage ∅ B := by
  let W := Warp.trivial G ∅
  refine ⟨W, ⟨?_, ?_⟩⟩
  · refine ⟨by simp [W], ?_⟩
    intro i
    exact (Set.notMem_empty i i.property).elim
  · intro i
    exact (Set.notMem_empty i i.property).elim

/-- A trimmed web with one source is linked by the trimming path itself.
This is the first nonempty base case used in the cardinal induction. -/
theorem exists_cleanLinkage_singleton {V : Type} {G : SimpleGraph V}
    {a : V} {B : Set V} (htrim : IsTrimmedWeb G {a} B) :
    ∃ W : Warp G, W.IsCleanLinkage {a} B := by
  classical
  rcases htrim a (Set.mem_singleton a) with
    ⟨b, hb, q, hq, hclean⟩
  let P : Unit → LongPath G := fun _ => LongPath.ofWalk q hq
  have hdisjoint : Pairwise fun i j : Unit =>
      Disjoint (P i).vertexSet (P j).vertexSet := by
    intro i j hij
    exact (hij (Subsingleton.elim i j)).elim
  let W : Warp G := Warp.ofPaths P hdisjoint
  refine ⟨W, ⟨?_, ?_⟩⟩
  · refine ⟨?_, ?_⟩
    · ext v
      simp [W, P, Warp.initialSet, Warp.ofPaths]
    · intro i
      refine ⟨b, hb, ?_⟩
      cases i
      simp [W, P, Warp.ofPaths]
  · intro i v hv hvA
    have hva : v = a := Set.mem_singleton_iff.mp hvA
    cases i
    simpa [W, P, Warp.ofPaths, hva]

/-- Reassemble a linkage after deleting one source-clean finite path.  The
deleted path supplies its own source, while a clean linkage of all remaining
sources lives in the exterior graph and hence is vertex-disjoint from it. -/
theorem exists_cleanLinkage_of_safe_path
    {V : Type} {G : SimpleGraph V} {A B : Set V}
    {a b : V} (ha : a ∈ A) (hb : b ∈ B)
    (q : G.Walk a b) (hq : q.IsPath)
    (hsource : ∀ x ∈ q.support, x ∈ A → x = a)
    (U : Warp (outsideGraph G {x | x ∈ q.support}))
    (hU : U.IsCleanLinkage (A \ {x | x ∈ q.support})
      (B \ {x | x ∈ q.support})) :
    ∃ W : Warp G, W.IsCleanLinkage A B := by
  classical
  let X : Set V := {x | x ∈ q.support}
  let p : LongPath G := LongPath.ofWalk q hq
  let U' : Warp G := U.mapLE (outsideGraph_le G X)
  have hpVertex : p.vertexSet = X := by
    simp [p, X]
  have hUInitial : U.initialSet = A \ X := by
    simpa [X] using hU.1.1
  have hUInitialDisjoint : Disjoint U.initialSet X := by
    rw [hUInitial, Set.disjoint_left]
    exact fun _ hx hxX => hx.2 hxX
  have hUVertexDisjoint : Disjoint U.vertexSet X :=
    Warp.vertexSet_disjoint_of_outside_initialSet hUInitialDisjoint
  have hpUDisjoint : Disjoint p.vertexSet U'.vertexSet := by
    change Disjoint p.vertexSet U.vertexSet
    rw [hpVertex]
    exact hUVertexDisjoint.symm
  let W : Warp G := U'.addPath p hpUDisjoint
  refine ⟨W, ⟨?_, ?_⟩⟩
  · refine ⟨?_, ?_⟩
    · simp only [W, Warp.initialSet_addPath, U', Warp.initialSet_mapLE]
      rw [hUInitial]
      ext v
      constructor
      · rintro (hv | hv)
        · have hva : v = a := by
            simpa [p] using hv
          exact hva ▸ ha
        · exact hv.1
      · intro hvA
        by_cases hvX : v ∈ X
        · left
          have hva : v = a := hsource v (by simpa [X] using hvX) hvA
          simpa [p, hva]
        · right
          exact ⟨hvA, hvX⟩
    · intro i
      cases i with
      | inl i =>
          cases i
          refine ⟨b, hb, ?_⟩
          simp [W, Warp.addPath, p]
      | inr i =>
          rcases hU.1.2 i with ⟨c, hcB, hic⟩
          refine ⟨c, hcB.1, ?_⟩
          change (U.path i).terminal? = some c
          exact hic
  · intro i v hv hvA
    cases i with
    | inl i =>
        cases i
        have hvX : v ∈ X := by
          rw [← hpVertex]
          simpa [W, Warp.addPath] using hv
        have hva : v = a := hsource v (by simpa [X] using hvX) hvA
        simpa [W, Warp.addPath, p] using hva
    | inr i =>
        have hvU : v ∈ (U.path i).vertexSet := by
          exact hv
        have hiOutside : (U.path i).initial ∉ X := by
          have hiInitial : (U.path i).initial ∈ U.initialSet := ⟨i, rfl⟩
          rw [hUInitial] at hiInitial
          exact hiInitial.2
        have hvOutside : v ∉ X :=
          (U.path i).vertex_not_mem_of_outsideGraph hiOutside hvU
        have hclean := hU.2 i v hvU
          (show v ∈ A \ {x | x ∈ q.support} from
            ⟨hvA, by simpa [X] using hvOutside⟩)
        exact hclean

/-- Safe one-point removal already proves the full linkability assertion when
the source side is finite.  No limit stage occurs in this induction. -/
theorem exists_cleanLinkage_of_finite_unhindered
    (hsafe : SafePathRemoval) {V : Type} {G : SimpleGraph V}
    {A B : Set V} (hA : A.Finite)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    ∃ W : Warp G, W.IsCleanLinkage A B := by
  classical
  induction A, hA using Set.Finite.induction_on generalizing G B with
  | empty => exact exists_cleanLinkage_empty G B
  | @insert a A ha hA ih =>
      have haInsert : a ∈ insert a A := Set.mem_insert a A
      rcases hsafe V G (insert a A) B hunhindered a haInsert with
        ⟨b, hb, q, hq, hsource, hresidual⟩
      let X : Set V := {x | x ∈ q.support}
      have haX : a ∈ X := by
        exact q.start_mem_support
      have hdiff : insert a A \ X = A := by
        ext x
        constructor
        · intro hx
          rcases hx.1 with hxa | hxA
          · exact (hx.2 (hxa ▸ haX)).elim
          · exact hxA
        · intro hxA
          refine ⟨Or.inr hxA, ?_⟩
          intro hxX
          have hxa : x = a := hsource x (by simpa [X] using hxX) (Or.inr hxA)
          exact ha (hxa ▸ hxA)
      have hresidual' : Warp.IsCleanUnhindered
          (outsideGraph G X) A (B \ X) := by
        simpa [X, hdiff] using hresidual
      rcases ih hresidual' with ⟨U, hU⟩
      apply exists_cleanLinkage_of_safe_path (A := insert a A)
        haInsert hb q hq hsource U
      simpa [X, hdiff] using hU

/-- Safe one-point removal links every countable source side.  Only finite
successor stages are used: the final warp simply collects the paths selected
while processing a surjective natural-number enumeration. -/
theorem exists_cleanLinkage_of_countable_unhindered
    (hsafe : SafePathRemoval) {V : Type} {G : SimpleGraph V}
    {A B : Set V} (hA : A.Countable)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    ∃ W : Warp G, W.IsCleanLinkage A B := by
  classical
  by_cases hAempty : A = ∅
  · subst A
    exact exists_cleanLinkage_empty G B
  · have hAne : A.Nonempty := Set.nonempty_iff_ne_empty.mpr hAempty
    letI : Nonempty A := hAne.to_subtype
    letI : Countable A := hA.to_subtype
    rcases exists_surjective_nat A with ⟨e, he⟩
    exact ⟨countableSafeWarp hsafe hunhindered e,
      countableSafeWarp_isCleanLinkage hsafe hunhindered e he⟩

/-! ### The countable extension (Hilbert-hotel) construction

The linkability induction needs a slightly stronger countable statement than
the preceding theorem.  A countable set `A₀` of sources has to be inserted
into an already existing linkage `F` of `A \ A₀`.  Whenever a newly chosen
safe path meets a member of `F`, the initial vertex of that member must itself
be processed.  The schedule below makes this bookkeeping explicit.  Even
stages enumerate `A₀`; an odd stage with code `Nat.pair i k` examines the
`k`th vertex of the path chosen at stage `i`.  Since `i ≤ Nat.pair i k`, the
examined path has already been chosen. -/

/-- State of the countable extension recursion.  `history i` records the
optional path chosen at stage `i`; entries beyond the current stage are
irrelevant. -/
structure HotelStage {V : Type} (G : SimpleGraph V) (A B : Set V) where
  safe : SafeStage G A B
  history : ℕ → Option (LongPath G)

/-- Regard the fixed enumeration of `A₀` as an enumeration by elements of
the ambient source set `A`. -/
def hotelRoot {V : Type} {A A₀ : Set V} (hA₀ : A₀ ⊆ A)
    (root : ℕ → A₀) (n : ℕ) : A :=
  ⟨root n, hA₀ (root n).property⟩

/-- The initial vertex of an old-linkage path, regarded as an element of the
ambient source set. -/
def hotelOldSource {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B) (j : F.ι) : A :=
  ⟨(F.path j).initial, by
    have hj : (F.path j).initial ∈ F.initialSet := ⟨j, rfl⟩
    rw [hF.1.1] at hj
    exact hj.1⟩

/-- The source processed at stage `n`.  At even stages this is the next
enumerated member of `A₀`.  At odd stages we decode a pair `(i,k)` and, if
the `k`th vertex of the path recorded at stage `i` lies on a member of `F`,
process the initial vertex of that member.  All failed tests fall back to the
first root, which is harmless because already deleted sources are skipped. -/
noncomputable def hotelTask
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (history : ℕ → Option (LongPath G)) (n : ℕ) : A := by
  classical
  exact
    if n % 2 = 0 then hotelRoot hA₀ root (n / 2)
    else
      let code := n / 2
      let i := (Nat.unpair code).1
      let k := (Nat.unpair code).2
      match history i with
      | none => hotelRoot hA₀ root 0
      | some p =>
          if hk : longPathActive p.terminalIndex k then
            if hmeet : ∃ j : F.ι, p.vertex k ∈ (F.path j).vertexSet then
              hotelOldSource F hF (Classical.choose hmeet)
            else hotelRoot hA₀ root 0
          else hotelRoot hA₀ root 0

/-- Initial state for the countable extension recursion. -/
def initialHotelStage {V : Type} {G : SimpleGraph V} {A B : Set V}
    (hunhindered : Warp.IsCleanUnhindered G A B) : HotelStage G A B where
  safe := initialSafeStage hunhindered
  history := fun _ => none

/-- One step of the countable extension recursion. -/
noncomputable def hotelStep (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (n : ℕ) (s : HotelStage G A B) : HotelStage G A B := by
  let a := hotelTask hA₀ root F hF s.history n
  let r := safeStep hsafe s.safe a a.property
  exact {
    safe := r.next
    history := Function.update s.history n r.chosen }

/-- The finite stages of the countable extension recursion. -/
noncomputable def hotelStageSeq (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    ℕ → HotelStage G A B := fun n =>
  Nat.rec (initialHotelStage hunhindered)
    (fun k s => hotelStep hsafe hA₀ root F hF k s) n

/-- The optional safe path selected at extension stage `n`. -/
noncomputable def hotelChosen (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    Option (LongPath G) :=
  let s := hotelStageSeq hsafe hA₀ root F hF hunhindered n
  let a := hotelTask hA₀ root F hF s.history n
  (safeStep hsafe s.safe a a.property).chosen

@[simp] theorem hotelStageSeq_zero (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    hotelStageSeq hsafe hA₀ root F hF hunhindered 0 =
      initialHotelStage hunhindered := rfl

@[simp] theorem hotelStageSeq_succ (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    hotelStageSeq hsafe hA₀ root F hF hunhindered (n + 1) =
      hotelStep hsafe hA₀ root F hF n
        (hotelStageSeq hsafe hA₀ root F hF hunhindered n) := rfl

/-- The history field at a successor stage stores the choice just made. -/
theorem hotelStageSeq_history_self (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    (hotelStageSeq hsafe hA₀ root F hF hunhindered (n + 1)).history n =
      hotelChosen hsafe hA₀ root F hF hunhindered n := by
  classical
  simp [hotelStageSeq_succ, hotelStep, hotelChosen]

/-- Earlier history entries are never changed. -/
theorem hotelStageSeq_history_eq_chosen (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    {i n : ℕ} (hin : i < n) :
    (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history i =
      hotelChosen hsafe hA₀ root F hF hunhindered i := by
  classical
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases hinEq : i = n
      · subst i
        exact hotelStageSeq_history_self hsafe hA₀ root F hF hunhindered n
      · rw [hotelStageSeq_succ]
        simp only [hotelStep]
        rw [Function.update_of_ne hinEq]
        exact ih (by omega)

theorem hotelStageSeq_deleted_succ (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    (hotelStageSeq hsafe hA₀ root F hF hunhindered (n + 1)).safe.deleted =
      match hotelChosen hsafe hA₀ root F hF hunhindered n with
      | none =>
          (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted
      | some p =>
          (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted ∪
            p.vertexSet := by
  let s := hotelStageSeq hsafe hA₀ root F hF hunhindered n
  let a := hotelTask hA₀ root F hF s.history n
  let r := safeStep hsafe s.safe a a.property
  change r.next.deleted = match r.chosen with
    | none => s.safe.deleted
    | some p => s.safe.deleted ∪ p.vertexSet
  cases h : r.chosen with
  | none => exact r.none_deleted h
  | some p => exact (r.some_spec p h).1

theorem hotelStageSeq_deleted_subset_succ (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted ⊆
      (hotelStageSeq hsafe hA₀ root F hF hunhindered (n + 1)).safe.deleted := by
  rw [hotelStageSeq_deleted_succ]
  cases h : hotelChosen hsafe hA₀ root F hF hunhindered n <;> simp

theorem hotelStageSeq_deleted_mono (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    {m n : ℕ} (hmn : m ≤ n) :
    (hotelStageSeq hsafe hA₀ root F hF hunhindered m).safe.deleted ⊆
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted := by
  induction n, hmn using Nat.le_induction with
  | base => exact Set.Subset.rfl
  | succ n hmn ih =>
      exact ih.trans
        (hotelStageSeq_deleted_subset_succ hsafe hA₀ root F hF hunhindered n)

theorem hotelChosen_isSome_iff (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    (hotelChosen hsafe hA₀ root F hF hunhindered n).isSome ↔
      (hotelTask hA₀ root F hF
          (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n : V) ∉
        (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted := by
  exact (safeStep hsafe
    (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe
    (hotelTask hA₀ root F hF
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n)
    (hotelTask hA₀ root F hF
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n).property).chosen_some_iff

theorem hotelChosen_some_spec (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    {n : ℕ} {p : LongPath G}
    (hp : hotelChosen hsafe hA₀ root F hF hunhindered n = some p) :
    (hotelStageSeq hsafe hA₀ root F hF hunhindered (n + 1)).safe.deleted =
        (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted ∪
          p.vertexSet ∧
      p.initial = hotelTask hA₀ root F hF
        (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n ∧
      (∃ b ∈ B, p.terminal? = some b) ∧
      Disjoint p.vertexSet
        (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted ∧
      (∀ v ∈ p.vertexSet, v ∈ A →
        v = hotelTask hA₀ root F hF
          (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n) := by
  exact (safeStep hsafe
    (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe
    (hotelTask hA₀ root F hF
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n)
    (hotelTask hA₀ root F hF
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n).property).some_spec p hp

def HotelChosenIndex (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :=
  {n : ℕ // (hotelChosen hsafe hA₀ root F hF hunhindered n).isSome}

noncomputable def hotelChosenPath (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (i : HotelChosenIndex hsafe hA₀ root F hF hunhindered) : LongPath G :=
  Classical.choose (Option.isSome_iff_exists.mp i.property)

theorem hotelChosen_eq_some_path (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (i : HotelChosenIndex hsafe hA₀ root F hF hunhindered) :
    hotelChosen hsafe hA₀ root F hF hunhindered i.1 =
      some (hotelChosenPath hsafe hA₀ root F hF hunhindered i) :=
  Classical.choose_spec (Option.isSome_iff_exists.mp i.property)

theorem hotelChosenPath_pairwise_disjoint (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    Pairwise fun i j : HotelChosenIndex hsafe hA₀ root F hF hunhindered =>
      Disjoint
        (hotelChosenPath hsafe hA₀ root F hF hunhindered i).vertexSet
        (hotelChosenPath hsafe hA₀ root F hF hunhindered j).vertexSet := by
  intro i j hij
  let pi := hotelChosenPath hsafe hA₀ root F hF hunhindered i
  let pj := hotelChosenPath hsafe hA₀ root F hF hunhindered j
  have hi := hotelChosen_some_spec hsafe hA₀ root F hF hunhindered
    (hotelChosen_eq_some_path hsafe hA₀ root F hF hunhindered i)
  have hj := hotelChosen_some_spec hsafe hA₀ root F hF hunhindered
    (hotelChosen_eq_some_path hsafe hA₀ root F hF hunhindered j)
  have hne : i.1 ≠ j.1 := by
    intro h
    exact hij (Subtype.ext h)
  rcases lt_or_gt_of_ne hne with hijNat | hjiNat
  · rw [Set.disjoint_left]
    intro v hvi hvj
    have hviNext : v ∈
        (hotelStageSeq hsafe hA₀ root F hF hunhindered (i.1 + 1)).safe.deleted := by
      rw [hi.1]
      exact Or.inr hvi
    have hviStage : v ∈
        (hotelStageSeq hsafe hA₀ root F hF hunhindered j.1).safe.deleted :=
      hotelStageSeq_deleted_mono hsafe hA₀ root F hF hunhindered
        (Nat.succ_le_of_lt hijNat) hviNext
    exact Set.disjoint_left.mp hj.2.2.2.1 hvj hviStage
  · rw [Set.disjoint_left]
    intro v hvi hvj
    have hvjNext : v ∈
        (hotelStageSeq hsafe hA₀ root F hF hunhindered (j.1 + 1)).safe.deleted := by
      rw [hj.1]
      exact Or.inr hvj
    have hvjStage : v ∈
        (hotelStageSeq hsafe hA₀ root F hF hunhindered i.1).safe.deleted :=
      hotelStageSeq_deleted_mono hsafe hA₀ root F hF hunhindered
        (Nat.succ_le_of_lt hjiNat) hvjNext
    exact Set.disjoint_left.mp hi.2.2.2.1 hvi hvjStage

/-- Every source vertex deleted by a finite extension stage is the initial
vertex of a path chosen at an earlier stage. -/
theorem mem_hotelStageSeq_deleted_exists_chosen_initial
    (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    {n : ℕ} {a : V} (ha : a ∈ A)
    (hadel : a ∈
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted) :
    ∃ i : HotelChosenIndex hsafe hA₀ root F hF hunhindered,
      i.1 < n ∧
        (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial = a := by
  induction n with
  | zero =>
      simpa [hotelStageSeq, initialHotelStage, initialSafeStage] using hadel
  | succ n ih =>
      have hrec := hotelStageSeq_deleted_succ
        hsafe hA₀ root F hF hunhindered n
      cases hchosen : hotelChosen hsafe hA₀ root F hF hunhindered n with
      | none =>
          rw [hrec, hchosen] at hadel
          rcases ih hadel with ⟨i, hin, hi⟩
          exact ⟨i, hin.trans (Nat.lt_succ_self n), hi⟩
      | some p =>
          rw [hrec, hchosen] at hadel
          rcases hadel with haOld | hap
          · rcases ih haOld with ⟨i, hin, hi⟩
            exact ⟨i, hin.trans (Nat.lt_succ_self n), hi⟩
          · have hspec := hotelChosen_some_spec
              hsafe hA₀ root F hF hunhindered hchosen
            let i : HotelChosenIndex hsafe hA₀ root F hF hunhindered :=
              ⟨n, by simp [hchosen]⟩
            have hip : hotelChosenPath hsafe hA₀ root F hF hunhindered i = p := by
              apply Option.some.inj
              exact (hotelChosen_eq_some_path
                hsafe hA₀ root F hF hunhindered i).symm.trans hchosen
            refine ⟨i, Nat.lt_succ_self n, ?_⟩
            rw [hip, hspec.2.1]
            exact (hspec.2.2.2.2 a hap ha).symm

/-- Every task presented to the safe-removal recursion is eventually the
initial vertex of one of the selected paths (possibly one selected earlier). -/
theorem hotelTask_exists_chosen_initial (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    ∃ i : HotelChosenIndex hsafe hA₀ root F hF hunhindered,
      (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial =
        hotelTask hA₀ root F hF
          (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n := by
  classical
  let a := hotelTask hA₀ root F hF
    (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n
  cases hchosen : hotelChosen hsafe hA₀ root F hF hunhindered n with
  | some p =>
      let i : HotelChosenIndex hsafe hA₀ root F hF hunhindered :=
        ⟨n, by simp [hchosen]⟩
      refine ⟨i, ?_⟩
      have hip : hotelChosenPath hsafe hA₀ root F hF hunhindered i = p := by
        apply Option.some.inj
        exact (hotelChosen_eq_some_path
          hsafe hA₀ root F hF hunhindered i).symm.trans hchosen
      rw [hip]
      exact (hotelChosen_some_spec
        hsafe hA₀ root F hF hunhindered hchosen).2.1
  | none =>
      have hnotSome :
          ¬ (hotelChosen hsafe hA₀ root F hF hunhindered n).isSome := by
        simp [hchosen]
      have hadel : (a : V) ∈
          (hotelStageSeq hsafe hA₀ root F hF hunhindered n).safe.deleted := by
        exact not_not.mp
          (mt (hotelChosen_isSome_iff
            hsafe hA₀ root F hF hunhindered n).mpr hnotSome)
      rcases mem_hotelStageSeq_deleted_exists_chosen_initial
        hsafe hA₀ root F hF hunhindered a.property hadel with ⟨i, _, hi⟩
      exact ⟨i, hi⟩

@[simp] theorem hotelTask_even
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (history : ℕ → Option (LongPath G)) (n : ℕ) :
    hotelTask hA₀ root F hF history (2 * n) = hotelRoot hA₀ root n := by
  simp [hotelTask]

/-- An odd schedule entry really selects the old-linkage path met at the
decoded vertex.  Disjointness of `F` makes the path containing that vertex
unique. -/
theorem hotelTask_odd_of_meets
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (history : ℕ → Option (LongPath G))
    {i k : ℕ} {p : LongPath G} {j : F.ι}
    (hi : history i = some p)
    (hk : longPathActive p.terminalIndex k)
    (hv : p.vertex k ∈ (F.path j).vertexSet) :
    (hotelTask hA₀ root F hF history (2 * Nat.pair i k + 1) : V) =
      (F.path j).initial := by
  classical
  have hodd : (2 * Nat.pair i k + 1) % 2 ≠ 0 := by omega
  have hdiv : (2 * Nat.pair i k + 1) / 2 = Nat.pair i k := by omega
  have hmeet : ∃ l : F.ι, p.vertex k ∈ (F.path l).vertexSet := ⟨j, hv⟩
  rw [hotelTask]
  simp only [hodd, ↓reduceDIte, hdiv, Nat.unpair_pair, hi]
  simp only [hk, ↓reduceDIte, hmeet]
  let l : F.ι := Classical.choose hmeet
  have hlv : p.vertex k ∈ (F.path l).vertexSet := Classical.choose_spec hmeet
  have hlj : l = j := by
    by_contra hne
    exact Set.disjoint_left.mp (F.disjoint hne) hlv hv
  exact congrArg (fun t : F.ι => (F.path t).initial) hlj

/-- Every enumerated root is the initial vertex of a selected safe path. -/
theorem hotelRoot_exists_chosen_initial (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) (n : ℕ) :
    ∃ i : HotelChosenIndex hsafe hA₀ root F hF hunhindered,
      (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial =
        (root n : V) := by
  rcases hotelTask_exists_chosen_initial
    hsafe hA₀ root F hF hunhindered (2 * n) with ⟨i, hi⟩
  refine ⟨i, ?_⟩
  rw [hotelTask_even] at hi
  exact hi

/-- If a selected safe path meets a member of the old linkage, the initial
vertex of that old path is eventually selected too. -/
theorem hotel_intersection_closure (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (i : HotelChosenIndex hsafe hA₀ root F hF hunhindered)
    (j : F.ι) {v : V}
    (hvi : v ∈
      (hotelChosenPath hsafe hA₀ root F hF hunhindered i).vertexSet)
    (hvj : v ∈ (F.path j).vertexSet) :
    ∃ r : HotelChosenIndex hsafe hA₀ root F hF hunhindered,
      (hotelChosenPath hsafe hA₀ root F hF hunhindered r).initial =
        (F.path j).initial := by
  rcases hvi with ⟨k, hk, hkv⟩
  let code := Nat.pair i.1 k
  let n := 2 * code + 1
  have hin : i.1 < n := by
    have hle : i.1 ≤ code := Nat.left_le_pair i.1 k
    dsimp [n, code]
    omega
  have hhistory :
      (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history i.1 =
        some (hotelChosenPath hsafe hA₀ root F hF hunhindered i) := by
    rw [hotelStageSeq_history_eq_chosen hsafe hA₀ root F hF hunhindered hin]
    exact hotelChosen_eq_some_path hsafe hA₀ root F hF hunhindered i
  have htask :
      (hotelTask hA₀ root F hF
        (hotelStageSeq hsafe hA₀ root F hF hunhindered n).history n : V) =
          (F.path j).initial := by
    dsimp [n, code]
    apply hotelTask_odd_of_meets hA₀ root F hF
      (hotelStageSeq hsafe hA₀ root F hF hunhindered
        (2 * Nat.pair i.1 k + 1)).history hhistory hk
    simpa [hkv] using hvj
  rcases hotelTask_exists_chosen_initial
    hsafe hA₀ root F hF hunhindered n with ⟨r, hr⟩
  exact ⟨r, hr.trans htask⟩

/-- Initial vertices of the paths selected by the countable extension. -/
noncomputable def hotelSelectedInitials (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) : Set V :=
  Set.range fun i : HotelChosenIndex hsafe hA₀ root F hF hunhindered =>
    (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial

/-- Indices of old-linkage paths whose initial vertices were not absorbed by
the safe-path recursion. -/
noncomputable def HotelRemainingIndex (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :=
  {j : F.ι // (F.path j).initial ∉
    hotelSelectedInitials hsafe hA₀ root F hF hunhindered}

noncomputable def hotelCombinedPath (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    (HotelChosenIndex hsafe hA₀ root F hF hunhindered ⊕
      HotelRemainingIndex hsafe hA₀ root F hF hunhindered) → LongPath G
  | Sum.inl i => hotelChosenPath hsafe hA₀ root F hF hunhindered i
  | Sum.inr j => F.path j.1

theorem hotelCombinedPath_pairwise_disjoint (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    Pairwise fun i j :
        (HotelChosenIndex hsafe hA₀ root F hF hunhindered ⊕
          HotelRemainingIndex hsafe hA₀ root F hF hunhindered) =>
      Disjoint
        (hotelCombinedPath hsafe hA₀ root F hF hunhindered i).vertexSet
        (hotelCombinedPath hsafe hA₀ root F hF hunhindered j).vertexSet := by
  intro i j hij
  cases i with
  | inl i =>
      cases j with
      | inl j =>
          apply hotelChosenPath_pairwise_disjoint
            hsafe hA₀ root F hF hunhindered
          intro hij'
          exact hij (congrArg Sum.inl hij')
      | inr j =>
          rw [Set.disjoint_left]
          intro v hvi hvj
          rcases hotel_intersection_closure
            hsafe hA₀ root F hF hunhindered i j.1 hvi hvj with ⟨r, hr⟩
          exact j.property ⟨r, hr⟩
  | inr i =>
      cases j with
      | inl j =>
          rw [Set.disjoint_left]
          intro v hvi hvj
          rcases hotel_intersection_closure
            hsafe hA₀ root F hF hunhindered j i.1 hvj hvi with ⟨r, hr⟩
          exact i.property ⟨r, hr⟩
      | inr j =>
          apply F.disjoint
          intro hij'
          apply hij
          congr
          exact Subtype.ext hij'

/-- The linkage obtained by the Hilbert-hotel construction: all selected
safe paths, followed by the old paths that they did not absorb. -/
noncomputable def hotelCombinedWarp (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) : Warp G :=
  Warp.ofPaths (hotelCombinedPath hsafe hA₀ root F hF hunhindered)
    (hotelCombinedPath_pairwise_disjoint
      hsafe hA₀ root F hF hunhindered)

theorem hotelChosenPath_initial_mem (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (i : HotelChosenIndex hsafe hA₀ root F hF hunhindered) :
    (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial ∈ A := by
  have hspec := hotelChosen_some_spec hsafe hA₀ root F hF hunhindered
    (hotelChosen_eq_some_path hsafe hA₀ root F hF hunhindered i)
  rw [hspec.2.1]
  exact (hotelTask hA₀ root F hF
    (hotelStageSeq hsafe hA₀ root F hF hunhindered i.1).history i.1).property

theorem hotelChosenPath_endsIn (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (i : HotelChosenIndex hsafe hA₀ root F hF hunhindered) :
    ∃ b ∈ B,
      (hotelChosenPath hsafe hA₀ root F hF hunhindered i).terminal? = some b := by
  exact (hotelChosen_some_spec hsafe hA₀ root F hF hunhindered
    (hotelChosen_eq_some_path hsafe hA₀ root F hF hunhindered i)).2.2.1

theorem hotelChosenPath_sourceClean (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (i : HotelChosenIndex hsafe hA₀ root F hF hunhindered)
    {v : V}
    (hv : v ∈
      (hotelChosenPath hsafe hA₀ root F hF hunhindered i).vertexSet)
    (hvA : v ∈ A) :
    v = (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial := by
  have hspec := hotelChosen_some_spec hsafe hA₀ root F hF hunhindered
    (hotelChosen_eq_some_path hsafe hA₀ root F hF hunhindered i)
  exact (hspec.2.2.2.2 v hv hvA).trans hspec.2.1.symm

/-- The Hilbert-hotel warp links all of `A`: countably many new sources are
inserted, and exactly the old paths made obsolete by an intersection are
discarded. -/
theorem hotelCombinedWarp_isCleanLinkage (hsafe : SafePathRemoval)
    {V : Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (hA₀ : A₀ ⊆ A) (root : ℕ → A₀) (hroot : Function.Surjective root)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hunhindered : Warp.IsCleanUnhindered G A B) :
    (hotelCombinedWarp hsafe hA₀ root F hF hunhindered).IsCleanLinkage A B := by
  classical
  let W := hotelCombinedWarp hsafe hA₀ root F hF hunhindered
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · ext a
    constructor
    · rintro ⟨i, hi⟩
      cases i with
      | inl i =>
          have hi' :
              (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial = a := by
            simpa [W, hotelCombinedWarp, hotelCombinedPath, Warp.ofPaths] using hi
          exact hi' ▸
            hotelChosenPath_initial_mem hsafe hA₀ root F hF hunhindered i
      | inr i =>
          have hi' : (F.path i.1).initial = a := by
            simpa [W, hotelCombinedWarp, hotelCombinedPath, Warp.ofPaths] using hi
          have hmem : (F.path i.1).initial ∈ A \ A₀ := by
            rw [← hF.1.1]
            exact ⟨i.1, rfl⟩
          exact hi' ▸ hmem.1
    · intro ha
      by_cases ha₀ : a ∈ A₀
      · rcases hroot ⟨a, ha₀⟩ with ⟨n, hn⟩
        rcases hotelRoot_exists_chosen_initial
          hsafe hA₀ root F hF hunhindered n with ⟨i, hi⟩
        refine ⟨Sum.inl i, ?_⟩
        change (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial = a
        exact hi.trans (congrArg Subtype.val hn)
      · have haDiff : a ∈ A \ A₀ := ⟨ha, ha₀⟩
        have haF : a ∈ F.initialSet := by
          rw [hF.1.1]
          exact haDiff
        rcases haF with ⟨j, hj⟩
        by_cases hselected : (F.path j).initial ∈
            hotelSelectedInitials hsafe hA₀ root F hF hunhindered
        · rcases hselected with ⟨i, hi⟩
          refine ⟨Sum.inl i, ?_⟩
          change (hotelChosenPath hsafe hA₀ root F hF hunhindered i).initial = a
          exact hi.trans hj
        · let j' : HotelRemainingIndex hsafe hA₀ root F hF hunhindered :=
            ⟨j, hselected⟩
          refine ⟨Sum.inr j', ?_⟩
          change (F.path j).initial = a
          exact hj
  · intro i
    cases i with
    | inl i =>
        exact hotelChosenPath_endsIn hsafe hA₀ root F hF hunhindered i
    | inr i =>
        exact hF.1.2 i.1
  · intro i v hv hvA
    cases i with
    | inl i =>
        exact hotelChosenPath_sourceClean
          hsafe hA₀ root F hF hunhindered i hv hvA
    | inr j =>
        by_cases hvA₀ : v ∈ A₀
        · rcases hroot ⟨v, hvA₀⟩ with ⟨n, hn⟩
          rcases hotelRoot_exists_chosen_initial
            hsafe hA₀ root F hF hunhindered n with ⟨r, hr⟩
          have hrv : v ∈
              (hotelChosenPath hsafe hA₀ root F hF hunhindered r).vertexSet := by
            have hinit :=
              (hotelChosenPath hsafe hA₀ root F hF hunhindered r).initial_mem_vertexSet
            have hrvEq :
                (hotelChosenPath hsafe hA₀ root F hF hunhindered r).initial = v :=
              hr.trans (congrArg Subtype.val hn)
            simpa [hrvEq] using hinit
          rcases hotel_intersection_closure
            hsafe hA₀ root F hF hunhindered r j.1 hrv hv with ⟨s, hs⟩
          exact (j.property ⟨s, hs⟩).elim
        · exact hF.2 j.1 v hv ⟨hvA, hvA₀⟩

/-- Countable extension clause `(clubsuit)` of Aharoni--Berger Theorem 9.2.
Safe one-point removal lets a countable source set be inserted into any
pre-existing linkage of the other sources. -/
theorem exists_cleanLinkage_of_countable_extension
    (hsafe : SafePathRemoval) {V : Type} {G : SimpleGraph V}
    {A A₀ B : Set V} (hA₀ : A₀ ⊆ A) (hcount : A₀.Countable)
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ W : Warp G, W.IsCleanLinkage A B := by
  classical
  by_cases hA₀empty : A₀ = ∅
  · subst A₀
    have hdiff : A \ (∅ : Set V) = A := by simp
    exact ⟨F, by simpa [hdiff] using hF⟩
  · have hA₀ne : A₀.Nonempty := Set.nonempty_iff_ne_empty.mpr hA₀empty
    letI : Nonempty A₀ := hA₀ne.to_subtype
    letI : Countable A₀ := hcount.to_subtype
    rcases exists_surjective_nat A₀ with ⟨root, hroot⟩
    exact ⟨hotelCombinedWarp hsafe hA₀ root F hF hunhindered,
      hotelCombinedWarp_isCleanLinkage
        hsafe hA₀ root hroot F hF hunhindered⟩

/-! ### Amalgamating a competitor-closed family

The last step in the singular-cardinal case of Aharoni--Berger's cardinal
induction is purely order-theoretic.  One has a family of linkages `W i`,
linking source sets `C i`, and an old linkage `F`.  Each covered source uses
the linkage having its least possible rank.  Every source not covered by the
family keeps its old `F`-path.  The competitor-closure hypotheses say that a
path meeting a path chosen at rank `i` has its own source already in `C i`.
Minimality of ranks then rules out all intersections.

The definitions and theorem below isolate this argument from the cardinal
construction that supplies the family.  This is the formal counterpart of
the paragraph following Assertion 9.18 in the paper. -/

/-- Sources covered by at least one member of a family of source sets. -/
def CompetitorCoveredSource {I V : Type} (C : I → Set V) :=
  {a : V // ∃ i, a ∈ C i}

/-- The least row containing a covered source. -/
noncomputable def competitorCoveredRank {I V : Type} [LinearOrder I]
    [WellFoundedLT I] (C : I → Set V) (a : CompetitorCoveredSource C) : I :=
  wellFounded_lt.min {i | a.1 ∈ C i} a.property

theorem competitorCoveredRank_mem {I V : Type} [LinearOrder I]
    [WellFoundedLT I] (C : I → Set V) (a : CompetitorCoveredSource C) :
    a.1 ∈ C (competitorCoveredRank C a) := by
  exact wellFounded_lt.min_mem {i | a.1 ∈ C i} a.property

theorem competitorCoveredRank_min {I V : Type} [LinearOrder I]
    [WellFoundedLT I] (C : I → Set V) (a : CompetitorCoveredSource C)
    (i : I) (hi : a.1 ∈ C i) : competitorCoveredRank C a ≤ i := by
  change wellFounded_lt.min {j | a.1 ∈ C j} a.property ≤ i
  exact WellFounded.min_le (β := I) wellFounded_lt
    (s := {j : I | a.1 ∈ C j}) (x := i) hi

/-- The actual path of a linkage beginning at a specified source. -/
noncomputable def linkagePathAt {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B) (a : C) :
    LongPath G := by
  have ha : (a : V) ∈ W.initialSet := by
    rw [hW.1]
    exact a.property
  exact W.path (W.sourceIndex ha)

@[simp] theorem linkagePathAt_initial {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B) (a : C) :
    (linkagePathAt W hW a).initial = a := by
  unfold linkagePathAt
  apply W.initial_sourceIndex

theorem linkagePathAt_endsIn {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B) (a : C) :
    ∃ b ∈ B, (linkagePathAt W hW a).terminal? = some b := by
  unfold linkagePathAt
  apply hW.2

theorem linkagePathAt_sourceClean {V : Type} {G : SimpleGraph V}
    {A C B : Set V} (W : Warp G) (hW : W.IsLinkage C B)
    (hclean : W.IsSourceClean A) (a : C) {v : V}
    (hv : v ∈ (linkagePathAt W hW a).vertexSet) (hvA : v ∈ A) :
    v = a := by
  have hi : (linkagePathAt W hW a).initial = a :=
    linkagePathAt_initial W hW a
  unfold linkagePathAt at hv
  exact (hclean _ v hv hvA).trans hi

theorem linkagePathAt_disjoint {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B)
    {a b : C} (hab : a ≠ b) :
    Disjoint (linkagePathAt W hW a).vertexSet
      (linkagePathAt W hW b).vertexSet := by
  unfold linkagePathAt
  apply W.disjoint
  intro hij
  apply hab
  apply Subtype.ext
  calc
    (a : V) = (linkagePathAt W hW a).initial :=
      (linkagePathAt_initial W hW a).symm
    _ = (linkagePathAt W hW b).initial := by simp [linkagePathAt, hij]
    _ = (b : V) := linkagePathAt_initial W hW b

/-! ### Regular-cardinal unbalanced webs

Section 8 of Aharoni--Berger associates to every regular-cardinal ladder
hindrance an auxiliary `κ`-unbalanced web.  The elementary first fact about
such a web is Lemma 8.3: it is unlinkable.  A hypothetical linkage chooses a
distinct target for every chosen source.  After choosing one source above
each source rank, the target ranks form an injective regressive map on a
stationary set, contradicting Fodor's lemma. -/

/-- The target reached by the linkage path beginning at a specified source. -/
noncomputable def linkageTerminalAt {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B) (a : C) : B := by
  have hend := linkagePathAt_endsIn W hW a
  exact ⟨Classical.choose hend, (Classical.choose_spec hend).1⟩

theorem linkagePathAt_terminalAt {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B) (a : C) :
    (linkagePathAt W hW a).terminal? = some (linkageTerminalAt W hW a) := by
  unfold linkageTerminalAt
  exact (Classical.choose_spec (linkagePathAt_endsIn W hW a)).2

/-- Vertex-disjoint linkage paths have distinct terminal vertices. -/
theorem linkageTerminalAt_injective {V : Type} {G : SimpleGraph V}
    {C B : Set V} (W : Warp G) (hW : W.IsLinkage C B) :
    Function.Injective (linkageTerminalAt W hW) := by
  intro a b hab
  by_contra hne
  have hd := linkagePathAt_disjoint W hW hne
  have ha : (linkageTerminalAt W hW a : V) ∈
      (linkagePathAt W hW a).vertexSet :=
    LongPath.terminal_mem_vertexSet (linkagePathAt_terminalAt W hW a)
  have hb : (linkageTerminalAt W hW a : V) ∈
      (linkagePathAt W hW b).vertexSet := by
    have hb' : (linkageTerminalAt W hW b : V) ∈
        (linkagePathAt W hW b).vertexSet :=
      LongPath.terminal_mem_vertexSet (linkagePathAt_terminalAt W hW b)
    simpa [hab] using hb'
  exact Set.disjoint_left.mp hd ha hb

/-- Aharoni--Berger Definition 8.2.  Source ranks are stationary, target
ranks are injective, and every finite source-to-target path strictly lowers
rank.  The path formulation is stated for `LongPath`, the ambient path type
used by warps; the terminal equation requires the path to be finite. -/
structure KappaUnbalanced (α : Type) [LinearOrder α] {V : Type}
    (G : SimpleGraph V) (C B : Set V) where
  sourceRank : C → α
  targetRank : B → α
  sourceStationary : IsStationary (Set.range sourceRank)
  targetRank_injective : Function.Injective targetRank
  rank_decreases : ∀ (p : LongPath G) (a : C) (b : B),
    p.initial = a → p.terminal? = some b → targetRank b < sourceRank a

/-- A source having a prescribed rank, selected from the range witness. -/
noncomputable def KappaUnbalanced.sourceAt
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) (i : Set.range K.sourceRank) : C :=
  Classical.choose i.property

@[simp] theorem KappaUnbalanced.sourceRank_sourceAt
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) (i : Set.range K.sourceRank) :
    K.sourceRank (K.sourceAt i) = i.1 :=
  Classical.choose_spec i.property

/-- The target-rank map induced on the stationary source-rank range by a
hypothetical linkage. -/
noncomputable def KappaUnbalanced.linkageRankMap
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) (W : Warp G) (hW : W.IsLinkage C B) :
    Set.range K.sourceRank → α := fun i =>
  K.targetRank (linkageTerminalAt W hW (K.sourceAt i))

theorem KappaUnbalanced.linkageRankMap_regressive
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) (W : Warp G) (hW : W.IsLinkage C B)
    (i : Set.range K.sourceRank) :
    K.linkageRankMap W hW i < i.1 := by
  rw [← K.sourceRank_sourceAt i]
  exact K.rank_decreases (linkagePathAt W hW (K.sourceAt i))
    (K.sourceAt i) (linkageTerminalAt W hW (K.sourceAt i))
    (linkagePathAt_initial W hW (K.sourceAt i))
    (linkagePathAt_terminalAt W hW (K.sourceAt i))

theorem KappaUnbalanced.linkageRankMap_injective
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) (W : Warp G) (hW : W.IsLinkage C B) :
    Function.Injective (K.linkageRankMap W hW) := by
  intro i j hij
  have htarget : linkageTerminalAt W hW (K.sourceAt i) =
      linkageTerminalAt W hW (K.sourceAt j) :=
    K.targetRank_injective hij
  have hsource : K.sourceAt i = K.sourceAt j :=
    linkageTerminalAt_injective W hW htarget
  apply Subtype.ext
  rw [← K.sourceRank_sourceAt i, ← K.sourceRank_sourceAt j, hsource]

/-- Aharoni--Berger Lemma 8.3: an uncountable regular `κ`-unbalanced web is
unlinkable. -/
theorem KappaUnbalanced.not_exists_linkage
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) :
    ¬ ∃ W : Warp G, W.IsLinkage C B := by
  rintro ⟨W, hW⟩
  exact (not_injective_regressive_of_isStationary huncountable
    K.sourceStationary (K.linkageRankMap W hW)
    (K.linkageRankMap_regressive W hW))
    (K.linkageRankMap_injective W hW)

/-- Strong form of Lemma 8.3: the source ranks used by any partial
`C`--`B` warp form a nonstationary set. -/
theorem KappaUnbalanced.not_isStationary_initialRanks
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {C B : Set V}
    (K : KappaUnbalanced α G C B) (W : Warp G)
    (hstart : W.initialSet ⊆ C)
    (hends : ∀ i, ∃ b ∈ B, (W.path i).terminal? = some b) :
    ¬ IsStationary
      (Set.range (fun a : W.initialSet =>
        K.sourceRank ⟨a.1, hstart a.2⟩)) := by
  intro hstationary
  let C' : Set V := W.initialSet
  let K' : KappaUnbalanced α G C' B := {
    sourceRank := fun a => K.sourceRank ⟨a.1, hstart a.2⟩
    targetRank := K.targetRank
    sourceStationary := hstationary
    targetRank_injective := K.targetRank_injective
    rank_decreases := by
      intro p a b hpa hpb
      exact K.rank_decreases p ⟨a.1, hstart a.2⟩ b hpa hpb }
  apply K'.not_exists_linkage huncountable
  exact ⟨W, rfl, hends⟩

/-! ### Joined path families and popularity

Section 8 uses families whose distinct paths may meet, but only in the common
join set.  We retain the endpoint-cleanliness clauses of the paper's
`X`--`T` path convention explicitly. -/

structure JoinedABPathFamily {V : Type} (G : SimpleGraph V)
    (X T : Set V) where
  ι : Type
  path : ι → ABPath G X T
  source_only : ∀ i v, v ∈ (path i).vertices → v ∈ X → v = (path i).left
  target_only : ∀ i v, v ∈ (path i).vertices → v ∈ T → v = (path i).right
  joined : Pairwise fun i j =>
    (path i).vertices ∩ (path j).vertices ⊆ T

namespace JoinedABPathFamily

/-- Initial vertices represented by a joined family. -/
def sourceSet {V : Type} {G : SimpleGraph V} {X T : Set V}
    (F : JoinedABPathFamily G X T) : Set V :=
  {x | ∃ i, (F.path i).left = x}

/-- The first index at which a finite walk meets a prescribed set. -/
theorem exists_hitIndex {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (U : Set V)
    (hhit : ∃ v ∈ p.support, v ∈ U) :
    ∃ n, n ≤ p.length ∧ p.getVert n ∈ U := by
  rcases hhit with ⟨v, hvp, hvU⟩
  rcases Walk.mem_support_iff_exists_getVert.mp hvp with ⟨n, hnv, hn⟩
  exact ⟨n, hn, hnv ▸ hvU⟩

noncomputable def firstHitIndex {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (U : Set V)
    (hhit : ∃ v ∈ p.support, v ∈ U) : ℕ :=
  by
    classical
    exact Nat.find (exists_hitIndex p U hhit)

theorem firstHitIndex_spec {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (U : Set V)
    (hhit : ∃ v ∈ p.support, v ∈ U) :
    firstHitIndex p U hhit ≤ p.length ∧
      p.getVert (firstHitIndex p U hhit) ∈ U := by
  classical
  change Nat.find (exists_hitIndex p U hhit) ≤ p.length ∧
    p.getVert (Nat.find (exists_hitIndex p U hhit)) ∈ U
  exact Nat.find_spec (exists_hitIndex p U hhit)

theorem firstHitIndex_minimal {V : Type} {G : SimpleGraph V} {a b : V}
    (p : G.Walk a b) (U : Set V)
    (hhit : ∃ v ∈ p.support, v ∈ U) {m : ℕ}
    (hm : m < firstHitIndex p U hhit) :
    p.getVert m ∉ U := by
  classical
  intro hmU
  apply Nat.find_min (exists_hitIndex p U hhit) (by
    simpa only [firstHitIndex] using hm)
  exact ⟨hm.le.trans (firstHitIndex_spec p U hhit).1, hmU⟩

/-- The prefix ending at the first hit has no earlier point in the target
set. -/
theorem firstHit_take_target_only {V : Type} {G : SimpleGraph V}
    {a b : V} (p : G.Walk a b) (U : Set V)
    (hhit : ∃ v ∈ p.support, v ∈ U) {v : V}
    (hv : v ∈ (p.take (firstHitIndex p U hhit)).support) (hvU : v ∈ U) :
    v = p.getVert (firstHitIndex p U hhit) := by
  rcases Walk.mem_support_iff_exists_getVert.mp hv with ⟨m, hmv, hm⟩
  have hindex : firstHitIndex p U hhit ≤ p.length :=
    (firstHitIndex_spec p U hhit).1
  have hmle : m ≤ firstHitIndex p U hhit := by
    simpa [Walk.take_length, Nat.min_eq_left hindex] using hm
  have hmeq : m = firstHitIndex p U hhit := by
    apply le_antisymm hmle
    apply le_of_not_gt
    intro hmlt
    have hpv : p.getVert m = v := by
      simpa [Walk.take_getVert, Nat.min_eq_right hmle] using hmv
    exact firstHitIndex_minimal p U hhit hmlt (hpv ▸ hvU)
  have hpv : p.getVert m = v := by
    simpa [Walk.take_getVert, Nat.min_eq_right hmle] using hmv
  simpa [hmeq] using hpv.symm

/-- A family of finite source-clean paths ending at one common vertex.  The
paths are not assumed disjoint; this is the input object for the elementary
large in-fan extraction. -/
structure SourceCleanInFamily {V : Type} (G : SimpleGraph V)
    (X : Set V) (y : V) where
  ι : Type
  path : ι → ABPath G X {y}
  source_only : ∀ i v, v ∈ (path i).vertices → v ∈ X → v = (path i).left
  left_injective : Function.Injective fun i => (path i).left
  left_ne_target : ∀ i, (path i).left ≠ y

namespace SourceCleanInFamily

/-- Initial vertices represented by a source-clean in-family. -/
def sourceSet {V : Type} {G : SimpleGraph V} {X : Set V} {y : V}
    (F : SourceCleanInFamily G X y) : Set V :=
  {x | ∃ i, (F.path i).left = x}

/-- Prefix a finite path at its first occurrence of a specified vertex. -/
noncomputable def prefixAt {V : Type} {G : SimpleGraph V}
    {X T : Set V} (p : ABPath G X T) (z : V) (hz : z ∈ p.vertices) :
    ABPath G X {z} := by
  let hhit : ∃ v ∈ p.walk.support, v ∈ ({z} : Set V) :=
    ⟨z, hz, Set.mem_singleton z⟩
  let n := firstHitIndex p.walk {z} hhit
  exact {
    left := p.left
    right := p.walk.getVert n
    left_mem := p.left_mem
    right_mem := (firstHitIndex_spec p.walk {z} hhit).2
    walk := p.walk.take n
    isPath := p.isPath.take n }

theorem prefixAt_right {V : Type} {G : SimpleGraph V}
    {X T : Set V} (p : ABPath G X T) (z : V) (hz : z ∈ p.vertices) :
    (prefixAt p z hz).right = z := by
  exact Set.mem_singleton_iff.mp (prefixAt p z hz).right_mem

theorem prefixAt_vertices_subset {V : Type} {G : SimpleGraph V}
    {X T : Set V} (p : ABPath G X T) (z : V) (hz : z ∈ p.vertices) :
    (prefixAt p z hz).vertices ⊆ p.vertices := by
  exact (p.walk.isSubwalk_take _).support_subset

theorem prefixAt_source_only {V : Type} {G : SimpleGraph V}
    {X T : Set V} (p : ABPath G X T)
    (hsource : ∀ v, v ∈ p.vertices → v ∈ X → v = p.left)
    (z : V) (hz : z ∈ p.vertices) :
    ∀ v, v ∈ (prefixAt p z hz).vertices → v ∈ X →
      v = (prefixAt p z hz).left := by
  intro v hv hvX
  exact hsource v (prefixAt_vertices_subset p z hz hv) hvX

theorem prefixAt_target_only {V : Type} {G : SimpleGraph V}
    {X T : Set V} (p : ABPath G X T) (z : V) (hz : z ∈ p.vertices) :
    ∀ v, v ∈ (prefixAt p z hz).vertices → v ∈ ({z} : Set V) →
      v = (prefixAt p z hz).right := by
  intro v _ hvz
  exact (Set.mem_singleton_iff.mp hvz).trans (prefixAt_right p z hz).symm

theorem prefixAt_length_lt {V : Type} {G : SimpleGraph V}
    {X T : Set V} (p : ABPath G X T) (z : V) (hz : z ∈ p.vertices)
    (hzright : z ≠ p.right) :
    (prefixAt p z hz).walk.length < p.walk.length := by
  let hhit : ∃ v ∈ p.walk.support, v ∈ ({z} : Set V) :=
    ⟨z, hz, Set.mem_singleton z⟩
  let n := firstHitIndex p.walk {z} hhit
  have hnle : n ≤ p.walk.length := (firstHitIndex_spec p.walk {z} hhit).1
  have hnne : n ≠ p.walk.length := by
    intro hn
    have hzEnd : p.walk.getVert n = z :=
      Set.mem_singleton_iff.mp (firstHitIndex_spec p.walk {z} hhit).2
    apply hzright
    simpa [hn] using hzEnd.symm
  have hnlt : n < p.walk.length := lt_of_le_of_ne hnle hnne
  simpa [prefixAt, hhit, n, Walk.take_length, Nat.min_eq_left hnle] using hnlt

/-- A regular-cardinal family of source-distinct finite paths into one vertex,
with a uniform finite length bound, contains a joined subfamily of the same
cardinality.  The join vertex is allowed to move backwards along the paths;
all represented sources still come from the original family.

This is the bounded-length finite-support induction at the heart of the
in-fan extraction used in Section 8. -/
theorem exists_large_joined_subfamily_of_length_le
    {V μ : Type} {G : SimpleGraph V} {X : Set V} {y : V}
    (F : SourceCleanInFamily G X y)
    (hμreg : (#μ).IsRegular) (hμinf : ℵ₀ ≤ #μ)
    (hcard : #μ ≤ #F.ι) (n : ℕ)
    (hlen : ∀ i, (F.path i).walk.length ≤ n) :
    ∃ z : V, ∃ W : JoinedABPathFamily G X {z},
      #μ ≤ #W.ι ∧ W.sourceSet ⊆ F.sourceSet := by
  classical
  induction n generalizing F y with
  | zero =>
      exfalso
      have hμpos : 0 < #μ := Cardinal.aleph0_pos.trans_le hμinf
      have hIpos : 0 < #F.ι := hμpos.trans_le hcard
      obtain ⟨i⟩ := Cardinal.mk_ne_zero_iff.mp (ne_of_gt hIpos)
      have hi0 : (F.path i).walk.length = 0 := Nat.le_zero.mp (hlen i)
      have hlr : (F.path i).left = (F.path i).right :=
        (F.path i).walk.eq_of_length_eq_zero hi0
      exact F.left_ne_target i
        (hlr.trans (Set.mem_singleton_iff.mp (F.path i).right_mem))
  | succ n ih =>
      let supportAway : F.ι → Set V := fun i => (F.path i).vertices \ {y}
      have hfinite : ∀ i, (supportAway i).Finite := by
        intro i
        exact (F.path i).walk.support.finite_toSet.sdiff
      have hnonempty : ∀ i, (supportAway i).Nonempty := by
        intro i
        refine ⟨(F.path i).left, (F.path i).walk.start_mem_support, ?_⟩
        exact fun h => F.left_ne_target i (Set.mem_singleton_iff.mp h)
      rcases finiteSetFamily_large_pairwiseDisjoint_or_large_point
          supportAway hfinite hnonempty hμreg hμinf hcard with
        hpacking | hpoint
      · rcases hpacking with ⟨J, hJlarge, hJdisjoint⟩
        let W : JoinedABPathFamily G X {y} := {
          ι := J
          path := fun i => F.path i.1
          source_only := fun i => F.source_only i.1
          target_only := by
            intro i v _ hv
            exact (Set.mem_singleton_iff.mp hv).trans
              (Set.mem_singleton_iff.mp (F.path i.1).right_mem).symm
          joined := by
            intro i j hij v hv
            apply Set.mem_singleton_iff.mpr
            by_contra hvy
            have hij' : i.1 ≠ j.1 := fun h => hij (Subtype.ext h)
            have hd : Disjoint (supportAway i.1) (supportAway j.1) :=
              hJdisjoint i.2 j.2 hij'
            exact Set.disjoint_left.mp hd ⟨hv.1, hvy⟩ ⟨hv.2, hvy⟩ }
        refine ⟨y, W, hJlarge, ?_⟩
        rintro x ⟨i, rfl⟩
        exact ⟨i.1, rfl⟩
      · rcases hpoint with ⟨z, hzlarge⟩
        let D : Set F.ι := {i | z ∈ supportAway i}
        let Bad : Set F.ι := {i | (F.path i).left = z}
        have hBad : Bad.Subsingleton := by
          intro i hi j hj
          exact F.left_injective (hi.trans hj.symm)
        have hGood : #μ ≤ #(D \ Bad : Set F.ι) :=
          le_mk_sdiff_of_le_mk_of_subsingleton hμinf hzlarge hBad
        let F' : SourceCleanInFamily G X z := {
          ι := (D \ Bad : Set F.ι)
          path := fun i => prefixAt (F.path i.1) z i.2.1.1
          source_only := fun i => prefixAt_source_only
            (F.path i.1) (F.source_only i.1) z i.2.1.1
          left_injective := by
            intro i j hij
            apply Subtype.ext
            apply F.left_injective
            exact hij
          left_ne_target := by
            intro i hi
            exact i.2.2 hi }
        have hF'len : ∀ i, (F'.path i).walk.length ≤ n := by
          intro i
          have hzright : z ≠ (F.path i.1).right := by
            intro hzr
            apply i.2.1.2
            exact Set.mem_singleton_iff.mpr
              (hzr.trans (Set.mem_singleton_iff.mp (F.path i.1).right_mem))
          have hlt := prefixAt_length_lt (F.path i.1) z i.2.1.1 hzright
          have hle := hlen i.1
          change (prefixAt (F.path i.1) z i.2.1.1).walk.length ≤ n
          omega
        rcases ih F' hGood hF'len with ⟨w, W, hWlarge, hWsource⟩
        refine ⟨w, W, hWlarge, hWsource.trans ?_⟩
        rintro x ⟨i, hi⟩
        exact ⟨i.1, hi⟩

end SourceCleanInFamily

/-- A finite path advanced to its first encounter with `U`; if it has not
yet met `U`, append the supplied final edge.  The result records exactly the
properties needed to preserve joinedness. -/
structure AdvanceData {V : Type} {G : SimpleGraph V} {X T : Set V}
    (p : ABPath G X T) (U : Set V) where
  path : ABPath G X U
  left_eq : path.left = p.left
  vertices_subset : path.vertices ⊆ p.vertices ∪ U
  source_only : ∀ v, v ∈ path.vertices → v ∈ X → v = path.left
  target_only : ∀ v, v ∈ path.vertices → v ∈ U → v = path.right

noncomputable def advanceData {V : Type} {G : SimpleGraph V}
    {X T U : Set V} (p : ABPath G X T)
    (hsource : ∀ v, v ∈ p.vertices → v ∈ X → v = p.left)
    (hXU : Disjoint X U) (z : V) (hzU : z ∈ U)
    (hadj : G.Adj p.right z) : AdvanceData p U := by
  classical
  by_cases hhit : ∃ v ∈ p.walk.support, v ∈ U
  · let n := firstHitIndex p.walk U hhit
    let q := p.walk.take n
    have hn : n ≤ p.walk.length := (firstHitIndex_spec p.walk U hhit).1
    have hqSub : q.support ⊆ p.walk.support :=
      (p.walk.isSubwalk_take n).support_subset
    exact {
      path := {
        left := p.left
        right := p.walk.getVert n
        left_mem := p.left_mem
        right_mem := (firstHitIndex_spec p.walk U hhit).2
        walk := q
        isPath := p.isPath.take n }
      left_eq := rfl
      vertices_subset := by
        intro v hv
        exact Or.inl (hqSub hv)
      source_only := by
        intro v hv hvX
        exact hsource v (hqSub hv) hvX
      target_only := by
        intro v hv hvU
        exact firstHit_take_target_only p.walk U hhit hv hvU }
  · have hzNotMem : z ∉ p.walk.support := by
      intro hz
      exact hhit ⟨z, hz, hzU⟩
    exact {
      path := {
        left := p.left
        right := z
        left_mem := p.left_mem
        right_mem := hzU
        walk := p.walk.concat hadj
        isPath := p.isPath.concat hzNotMem hadj }
      left_eq := rfl
      vertices_subset := by
        intro v hv
        simp only [ABPath.vertices, Walk.support_concat, List.mem_append,
          List.mem_singleton] at hv
        rcases hv with hv | rfl
        · exact Or.inl hv
        · exact Or.inr hzU
      source_only := by
        intro v hv hvX
        simp only [ABPath.vertices, Walk.support_concat, List.mem_append,
          List.mem_singleton] at hv
        rcases hv with hv | rfl
        · exact hsource v hv hvX
        · exact (Set.disjoint_left.mp hXU hvX hzU).elim
      target_only := by
        intro v hv hvU
        simp only [ABPath.vertices, Walk.support_concat, List.mem_append,
          List.mem_singleton] at hv
        rcases hv with hv | hv
        · exact (hhit ⟨v, hv, hvU⟩).elim
        · exact hv }

/-- Advancing one path for each of a set of distinct old terminals produces
a family joined at the new target set. -/
noncomputable def advanceDistinctTerminals {I V : Type}
    {G : SimpleGraph V} {X T U : Set V}
    (F : JoinedABPathFamily G X T) (e : I → F.ι)
    (hterminal : Function.Injective fun i => (F.path (e i)).right)
    (hXU : Disjoint X U) (z : I → V) (hzU : ∀ i, z i ∈ U)
    (hadj : ∀ i, G.Adj (F.path (e i)).right (z i)) :
    JoinedABPathFamily G X U := by
  let d : ∀ i, AdvanceData (F.path (e i)) U := fun i =>
    advanceData (F.path (e i)) (F.source_only (e i)) hXU
      (z i) (hzU i) (hadj i)
  refine {
    ι := I
    path := fun i => (d i).path
    source_only := fun i => (d i).source_only
    target_only := fun i => (d i).target_only
    joined := ?_ }
  intro i j hij v hv
  have he : e i ≠ e j := by
    intro heq
    apply hij
    apply hterminal
    simpa using congrArg (fun k => (F.path k).right) heq
  have holdDisjoint : Disjoint (F.path (e i)).vertices
      (F.path (e j)).vertices := by
    rw [Set.disjoint_left]
    intro w hwi hwj
    have hwT : w ∈ T := F.joined he ⟨hwi, hwj⟩
    have hwiEnd : w = (F.path (e i)).right :=
      F.target_only (e i) w hwi hwT
    have hwjEnd : w = (F.path (e j)).right :=
      F.target_only (e j) w hwj hwT
    exact hij (hterminal (hwiEnd.symm.trans hwjEnd))
  rcases (d i).vertices_subset hv.1 with hvi | hvi
  · rcases (d j).vertices_subset hv.2 with hvj | hvj
    · exact (Set.disjoint_left.mp holdDisjoint hvi hvj).elim
    · exact hvj
  · exact hvi

theorem sourceRank_advanceDistinctTerminals {I α V : Type}
    [LinearOrder α] {G : SimpleGraph V} {X Y T U : Set V}
    (K : KappaUnbalanced α G X Y)
    (F : JoinedABPathFamily G X T) (e : I → F.ι)
    (hterminal : Function.Injective fun i => (F.path (e i)).right)
    (hXU : Disjoint X U) (z : I → V) (hzU : ∀ i, z i ∈ U)
    (hadj : ∀ i, G.Adj (F.path (e i)).right (z i)) (i : I) :
    K.sourceRank
        ⟨((advanceDistinctTerminals F e hterminal hXU z hzU hadj).path i).left,
          ((advanceDistinctTerminals F e hterminal hXU z hzU hadj).path i).left_mem⟩ =
      K.sourceRank ⟨(F.path (e i)).left, (F.path (e i)).left_mem⟩ := by
  apply congrArg K.sourceRank
  apply Subtype.ext
  exact (advanceData (F.path (e i)) (F.source_only (e i)) hXU
    (z i) (hzU i) (hadj i)).left_eq

/-- Source ranks represented by a joined family. -/
def sourceRankRange {α V : Type} [LinearOrder α] {G : SimpleGraph V}
    {X Y T : Set V} (K : KappaUnbalanced α G X Y)
    (F : JoinedABPathFamily G X T) : Set α :=
  Set.range fun i => K.sourceRank ⟨(F.path i).left, (F.path i).left_mem⟩

theorem sourceRankRange_mono_of_sourceSet_subset
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {X Y T U : Set V}
    (K : KappaUnbalanced α G X Y)
    {F : JoinedABPathFamily G X T} {W : JoinedABPathFamily G X U}
    (hsource : F.sourceSet ⊆ W.sourceSet) :
    F.sourceRankRange K ⊆ W.sourceRankRange K := by
  rintro r ⟨i, rfl⟩
  rcases hsource ⟨i, rfl⟩ with ⟨j, hj⟩
  refine ⟨j, ?_⟩
  apply congrArg K.sourceRank
  apply Subtype.ext
  exact hj

/-- Source ranks of precisely those paths ending at `t`. -/
def terminalSourceRankSet {α V : Type} [LinearOrder α]
    {G : SimpleGraph V} {X Y T : Set V}
    (K : KappaUnbalanced α G X Y) (F : JoinedABPathFamily G X T)
    (t : V) : Set α :=
  {r | ∃ i, (F.path i).right = t ∧
    K.sourceRank ⟨(F.path i).left, (F.path i).left_mem⟩ = r}

/-- Restrict a joined family to the paths having one prescribed terminal.
Endpoint cleanliness sharpens the join set to the singleton terminal. -/
def terminalSubfamily {V : Type} {G : SimpleGraph V} {X T : Set V}
    (F : JoinedABPathFamily G X T) (t : V) :
    JoinedABPathFamily G X {t} where
  ι := {i : F.ι // (F.path i).right = t}
  path i := {
    left := (F.path i.1).left
    right := (F.path i.1).right
    left_mem := (F.path i.1).left_mem
    right_mem := Set.mem_singleton_iff.mpr i.2
    walk := (F.path i.1).walk
    isPath := (F.path i.1).isPath }
  source_only i := F.source_only i.1
  target_only := by
    intro i v _ hv
    exact (Set.mem_singleton_iff.mp hv).trans i.2.symm
  joined := by
    intro i j hij v hv
    have hval : i.1 ≠ j.1 := by
      intro h
      exact hij (Subtype.ext h)
    have hvT : v ∈ T := F.joined hval hv
    have hvRight : v = (F.path i.1).right :=
      F.target_only i.1 v hv.1 hvT
    exact Set.mem_singleton_iff.mpr (hvRight.trans i.2)

/-- Restrict a joined family to paths whose terminals lie in a smaller target
set. -/
def restrictTarget {V : Type} {G : SimpleGraph V} {X T : Set V}
    (F : JoinedABPathFamily G X T) (U : Set V) (hUT : U ⊆ T) :
    JoinedABPathFamily G X U where
  ι := {i : F.ι // (F.path i).right ∈ U}
  path i := {
    left := (F.path i.1).left
    right := (F.path i.1).right
    left_mem := (F.path i.1).left_mem
    right_mem := i.2
    walk := (F.path i.1).walk
    isPath := (F.path i.1).isPath }
  source_only i := F.source_only i.1
  target_only := by
    intro i v hv hvU
    exact F.target_only i.1 v hv (hUT hvU)
  joined := by
    intro i j hij v hv
    have hval : i.1 ≠ j.1 := by
      intro h
      exact hij (Subtype.ext h)
    have hvT : v ∈ T := F.joined hval hv
    have hvRight : v = (F.path i.1).right :=
      F.target_only i.1 v hv.1 hvT
    exact hvRight ▸ i.2

theorem sourceRankRange_terminalSubfamily {α V : Type} [LinearOrder α]
    {G : SimpleGraph V} {X Y T : Set V}
    (K : KappaUnbalanced α G X Y) (F : JoinedABPathFamily G X T)
    (t : V) :
    (F.terminalSubfamily t).sourceRankRange K =
      F.terminalSourceRankSet K t := by
  ext r
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i.1, i.2, rfl⟩
  · rintro ⟨i, hit, hir⟩
    exact ⟨⟨i, hit⟩, hir⟩

end JoinedABPathFamily

/-- The non-circular fan-amalgamation input of Aharoni--Berger Lemma 8.6,
parameterized by its cardinal bound. -/
def JoinedFanAmalgamationAt {V : Type} (κ : Type) (G : SimpleGraph V)
    (X : Set V) : Prop :=
  ∀ (C : Set V), #κ < #C →
    ∀ fan : (c : C) → JoinedABPathFamily G X {c.1},
      ∃ W : JoinedABPathFamily G X C,
        (Pairwise fun i j => Disjoint (W.path i).vertices (W.path j).vertices) ∧
          ∃ c : C, (fan c).sourceSet ⊆ W.sourceSet

/-- Popularity from Section 8.  A set is popular if it already contains a
source, or supports a joined family carrying stationarily many source ranks. -/
def KappaUnbalanced.IsPopular {α V : Type} [LinearOrder α]
    {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) (T : Set V) : Prop :=
  (X ∩ T).Nonempty ∨
    ∃ F : JoinedABPathFamily G X T, IsStationary (F.sourceRankRange K)

/-- Strong popularity: the stationary joined family can be chosen genuinely
pairwise vertex-disjoint, hence is a finite-path warp. -/
def KappaUnbalanced.IsStronglyPopular {α V : Type} [LinearOrder α]
    {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) (T : Set V) : Prop :=
  ∃ F : JoinedABPathFamily G X T,
    (Pairwise fun i j => Disjoint (F.path i).vertices (F.path j).vertices) ∧
      IsStationary (F.sourceRankRange K)

/-- The set of individually popular vertices. -/
def KappaUnbalanced.popularVertices {α V : Type} [LinearOrder α]
    {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) : Set V :=
  {v | K.IsPopular {v}}

theorem KappaUnbalanced.source_subset_popularVertices
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) :
    X ⊆ K.popularVertices := by
  intro x hx
  exact Or.inl ⟨x, hx, Set.mem_singleton x⟩

theorem KappaUnbalanced.IsStronglyPopular.isPopular
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {X Y T : Set V}
    {K : KappaUnbalanced α G X Y} (h : K.IsStronglyPopular T) :
    K.IsPopular T := by
  rcases h with ⟨F, _, hstationary⟩
  exact Or.inr ⟨F, hstationary⟩

theorem KappaUnbalanced.isPopular_singleton_of_stationary_terminalSourceRankSet
    {α V : Type} [LinearOrder α] {G : SimpleGraph V} {X Y T : Set V}
    (K : KappaUnbalanced α G X Y) (F : JoinedABPathFamily G X T)
    (t : V) (hstationary : IsStationary (F.terminalSourceRankSet K t)) :
    K.IsPopular {t} := by
  refine Or.inr ⟨F.terminalSubfamily t, ?_⟩
  rwa [JoinedABPathFamily.sourceRankRange_terminalSubfamily]

/-- For a joined family ending on the target side of an unbalanced web,
stationarily many represented source ranks concentrate at one terminal.  This
is the Fodor argument in the base case of Assertion 8.8. -/
theorem KappaUnbalanced.exists_stationary_terminalSourceRankSet
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y T : Set V}
    (K : KappaUnbalanced α G X Y) (F : JoinedABPathFamily G X T)
    (hTY : T ⊆ Y) (hstationary : IsStationary (F.sourceRankRange K)) :
    ∃ t ∈ T, IsStationary (F.terminalSourceRankSet K t) := by
  classical
  let R : Set α := F.sourceRankRange K
  let rankIndex : R → F.ι := fun r => Classical.choose r.2
  have rankIndex_spec (r : R) :
      K.sourceRank ⟨(F.path (rankIndex r)).left,
        (F.path (rankIndex r)).left_mem⟩ = r.1 :=
    Classical.choose_spec r.2
  let terminalAt : R → Y := fun r =>
    ⟨(F.path (rankIndex r)).right,
      hTY (F.path (rankIndex r)).right_mem⟩
  let regressiveMap : α → α := fun r =>
    if hr : r ∈ R then K.targetRank (terminalAt ⟨r, hr⟩) else ⊥
  have hregressive : ∀ r ∈ R, regressiveMap r < r := by
    intro r hr
    simp only [regressiveMap, dif_pos hr]
    calc
      K.targetRank (terminalAt ⟨r, hr⟩) <
          K.sourceRank ⟨(F.path (rankIndex ⟨r, hr⟩)).left,
            (F.path (rankIndex ⟨r, hr⟩)).left_mem⟩ :=
        K.rank_decreases
          (LongPath.ofWalk (F.path (rankIndex ⟨r, hr⟩)).walk
            (F.path (rankIndex ⟨r, hr⟩)).isPath)
          ⟨(F.path (rankIndex ⟨r, hr⟩)).left,
            (F.path (rankIndex ⟨r, hr⟩)).left_mem⟩
          (terminalAt ⟨r, hr⟩) (by simp) (by simp [terminalAt])
      _ = r := rankIndex_spec ⟨r, hr⟩
  have hR : IsStationary R := hstationary
  rcases exists_stationary_fiber_of_regressive huncountable hR
      regressiveMap hregressive with ⟨β, hβ⟩
  rcases hβ.nonempty with ⟨r₀, hr₀R, hr₀β⟩
  let i₀ : F.ι := rankIndex ⟨r₀, hr₀R⟩
  let t : V := (F.path i₀).right
  refine ⟨t, (F.path i₀).right_mem, ?_⟩
  apply hβ.mono
  rintro r ⟨hrR, hrβ⟩
  let i : F.ι := rankIndex ⟨r, hrR⟩
  have htargetRank : K.targetRank (terminalAt ⟨r, hrR⟩) =
      K.targetRank (terminalAt ⟨r₀, hr₀R⟩) := by
    have hleft : regressiveMap r = β := hrβ
    have hright : regressiveMap r₀ = β := hr₀β
    simpa only [regressiveMap, dif_pos hrR, dif_pos hr₀R] using
      hleft.trans hright.symm
  have hterminal : (F.path i).right = t := by
    have hsubtype : terminalAt ⟨r, hrR⟩ = terminalAt ⟨r₀, hr₀R⟩ :=
      K.targetRank_injective htargetRank
    exact congrArg Subtype.val hsubtype
  exact ⟨i, hterminal, rankIndex_spec ⟨r, hrR⟩⟩

/-- A strongly popular set cannot lie on the target side of an unbalanced
web.  Fodor concentrates stationarily many ranks at one terminal, whereas
disjointness permits at most one represented rank at that terminal. -/
theorem KappaUnbalanced.not_isStronglyPopular_of_subset_target
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y T : Set V}
    (K : KappaUnbalanced α G X Y) (hTY : T ⊆ Y) :
    ¬ K.IsStronglyPopular T := by
  rintro ⟨F, hdisjoint, hstationary⟩
  rcases K.exists_stationary_terminalSourceRankSet huncountable F hTY
      hstationary with ⟨t, _, htStationary⟩
  apply not_subsingleton_of_isStationary htStationary
  intro r hr s hs
  rcases hr with ⟨i, hit, hir⟩
  rcases hs with ⟨j, hjt, hjs⟩
  have hij : i = j := by
    by_contra hne
    have hitVertex : t ∈ (F.path i).vertices := by
      change t ∈ (F.path i).walk.support
      simpa [← hit] using (F.path i).walk.end_mem_support
    have hjtVertex : t ∈ (F.path j).vertices := by
      change t ∈ (F.path j).walk.support
      simpa [← hjt] using (F.path j).walk.end_mem_support
    exact (Set.disjoint_left.mp (hdisjoint hne) hitVertex hjtVertex).elim
  subst j
  exact hir.symm.trans hjs

/-! ### Breadth-first popularity separator

The proof of Aharoni--Berger Theorem 8.4 grows the nonpopular vertices
backwards from the target side.  Whenever the next backward layer reaches a
popular vertex, that vertex is placed in the separator.  The following
finite-walk lemma isolates the purely graph-theoretic part of that argument;
the later cardinal argument only has to supply the set of popular vertices
and control the size and structure of the resulting frontiers. -/

namespace PopularityLayers

/-- The one-step neighbourhood of a set. -/
def setNeighbors {V : Type} (G : SimpleGraph V) (S : Set V) : Set V :=
  {v | ∃ w ∈ S, G.Adj v w}

/-- Vertices reached after exactly `n` backward steps from the nonpopular
part of `Y`, while remaining outside the popular set `P`. -/
def unpopularLayer {V : Type} (G : SimpleGraph V) (Y P : Set V) :
    ℕ → Set V
  | 0 => Y \ P
  | n + 1 => setNeighbors G (unpopularLayer G Y P n) \ P

/-- The popular frontier encountered at the corresponding backward step. -/
def popularFrontier {V : Type} (G : SimpleGraph V) (Y P : Set V) :
    ℕ → Set V
  | 0 => Y ∩ P
  | n + 1 => setNeighbors G (unpopularLayer G Y P n) ∩ P

/-- The union of all popular frontiers. -/
def separator {V : Type} (G : SimpleGraph V) (Y P : Set V) : Set V :=
  ⋃ n, popularFrontier G Y P n

theorem popularFrontier_subset_separator {V : Type} (G : SimpleGraph V)
    (Y P : Set V) (n : ℕ) :
    popularFrontier G Y P n ⊆ separator G Y P := by
  intro v hv
  exact Set.mem_iUnion.mpr ⟨n, hv⟩

theorem popularFrontier_subset_popular {V : Type} (G : SimpleGraph V)
    (Y P : Set V) (n : ℕ) :
    popularFrontier G Y P n ⊆ P := by
  intro v hv
  cases n with
  | zero => exact hv.2
  | succ n => exact hv.2

theorem unpopularLayer_not_mem {V : Type} (G : SimpleGraph V)
    (Y P : Set V) (n : ℕ) {v : V}
    (hv : v ∈ unpopularLayer G Y P n) : v ∉ P := by
  cases n with
  | zero => exact hv.2
  | succ n => exact hv.2

/-- If a walk ends in the `n`th unpopular layer and avoids every popular
frontier, its start lies in the layer obtained by adding the walk length.
This is the finite backward induction in Theorem 8.4. -/
theorem walk_start_mem_unpopularLayer {V : Type} {G : SimpleGraph V}
    {Y P : Set V} {a b : V} (q : G.Walk a b) (n : ℕ)
    (hb : b ∈ unpopularLayer G Y P n)
    (havoid : ∀ v ∈ q.support, v ∉ separator G Y P) :
    a ∈ unpopularLayer G Y P (n + q.length) := by
  induction q generalizing n with
  | nil => simpa using hb
  | @cons u v w hadj q ih =>
      have htail : ∀ x ∈ q.support, x ∉ separator G Y P := by
        intro x hx
        exact havoid x (by simp [hx])
      have hv : v ∈ unpopularLayer G Y P (n + q.length) :=
        ih n hb htail
      have huN : u ∈ setNeighbors G
          (unpopularLayer G Y P (n + q.length)) :=
        ⟨v, hv, hadj⟩
      have huNotP : u ∉ P := by
        intro huP
        exact (havoid u (by simp))
          (popularFrontier_subset_separator G Y P (n + q.length + 1)
            ⟨huN, huP⟩)
      have hu : u ∈ unpopularLayer G Y P ((n + q.length) + 1) :=
        ⟨huN, huNotP⟩
      simpa [Walk.length_cons, Nat.add_assoc] using hu

/-- The union of the popular frontiers separates every source contained in
the popular set from the target side. -/
theorem separator_separates {V : Type} (G : SimpleGraph V)
    (X Y P : Set V) (hXP : X ⊆ P) :
    Separates G X Y (separator G Y P) := by
  classical
  intro a ha b hb q _
  by_contra hmiss
  have havoid : ∀ v ∈ q.support, v ∉ separator G Y P := by
    intro v hv hvs
    exact hmiss ⟨v, hv, hvs⟩
  have hbNotP : b ∉ P := by
    intro hbP
    apply havoid b q.end_mem_support
    apply popularFrontier_subset_separator G Y P 0
    exact ⟨hb, hbP⟩
  have hbLayer : b ∈ unpopularLayer G Y P 0 := ⟨hb, hbNotP⟩
  have haLayer : a ∈ unpopularLayer G Y P q.length := by
    simpa using walk_start_mem_unpopularLayer q 0 hbLayer havoid
  exact unpopularLayer_not_mem G Y P q.length haLayer (hXP ha)

end PopularityLayers

/-- Successor mechanism in Assertion 8.8.  A stationary joined family ending
in individually nonpopular vertices can be thinned to one path per terminal
by Lemma 8.5.  If every old terminal has an edge into an individually
nonpopular set `U`, advancing those disjoint representatives to their first
hit of `U` makes `U` popular. -/
theorem KappaUnbalanced.isPopular_of_joined_neighbors
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y T U : Set V}
    (K : KappaUnbalanced α G X Y) (F : JoinedABPathFamily G X T)
    (hstationary : IsStationary (F.sourceRankRange K))
    (hTnonpopular : ∀ t ∈ T, ¬ K.IsPopular {t})
    (hUnonpopular : ∀ u ∈ U, ¬ K.IsPopular {u})
    (hneighbors : T ⊆ PopularityLayers.setNeighbors G U) :
    K.IsPopular U := by
  classical
  let terminalSet : Set V := {t | ∃ i, (F.path i).right = t}
  let Term : Type := terminalSet
  let Ξ : Term → Set α := fun t => F.terminalSourceRankSet K t.1
  have hΞne (t : Term) : (Ξ t).Nonempty := by
    rcases t.2 with ⟨i, hi⟩
    exact ⟨K.sourceRank ⟨(F.path i).left, (F.path i).left_mem⟩,
      i, hi, rfl⟩
  have hΞnonstationary (t : Term) : ¬ IsStationary (Ξ t) := by
    intro ht
    have htT : t.1 ∈ T := by
      rcases t.2 with ⟨i, hi⟩
      simpa [← hi] using (F.path i).right_mem
    exact hTnonpopular t.1 htT
      (K.isPopular_singleton_of_stationary_terminalSourceRankSet F t.1 ht)
  have hΞunion : IsStationary (⋃ t, Ξ t) := by
    apply hstationary.mono
    rintro r ⟨i, rfl⟩
    let t : Term := ⟨(F.path i).right, ⟨i, rfl⟩⟩
    apply Set.mem_iUnion.mpr
    refine ⟨t, ?_⟩
    exact ⟨i, rfl, rfl⟩
  rcases exists_stationary_range_choice huncountable Ξ hΞne
      hΞnonstationary hΞunion with ⟨g, hgMem, hgStationary⟩
  let e : Term → F.ι := fun t => Classical.choose (hgMem t)
  have e_terminal (t : Term) : (F.path (e t)).right = t.1 :=
    (Classical.choose_spec (hgMem t)).1
  have e_rank (t : Term) :
      K.sourceRank ⟨(F.path (e t)).left, (F.path (e t)).left_mem⟩ = g t :=
    (Classical.choose_spec (hgMem t)).2
  have hterminal : Function.Injective fun t : Term => (F.path (e t)).right := by
    intro s t hst
    apply Subtype.ext
    calc
      s.1 = (F.path (e s)).right := (e_terminal s).symm
      _ = (F.path (e t)).right := hst
      _ = t.1 := e_terminal t
  have hXU : Disjoint X U := by
    rw [Set.disjoint_left]
    intro x hxX hxU
    exact hUnonpopular x hxU (K.source_subset_popularVertices hxX)
  let z : Term → V := fun t =>
    Classical.choose (hneighbors (F.path (e t)).right_mem)
  have hzU (t : Term) : z t ∈ U :=
    (Classical.choose_spec (hneighbors (F.path (e t)).right_mem)).1
  have hadj (t : Term) : G.Adj (F.path (e t)).right (z t) :=
    (Classical.choose_spec (hneighbors (F.path (e t)).right_mem)).2
  let F' : JoinedABPathFamily G X U :=
    F.advanceDistinctTerminals e hterminal hXU z hzU hadj
  refine Or.inr ⟨F', ?_⟩
  apply hgStationary.mono
  rintro r ⟨t, rfl⟩
  refine ⟨t, ?_⟩
  change K.sourceRank ⟨(F'.path t).left, (F'.path t).left_mem⟩ = g t
  rw [show K.sourceRank ⟨(F'.path t).left, (F'.path t).left_mem⟩ =
      K.sourceRank ⟨(F.path (e t)).left, (F.path (e t)).left_mem⟩ by
    exact JoinedABPathFamily.sourceRank_advanceDistinctTerminals
      K F e hterminal hXU z hzU hadj t]
  exact e_rank t

/-- Assertion 8.8 at the base layer: the nonpopular part of the target side
is not popular as a set.  Fodor's lemma concentrates any purported joined
family at one target, making that target individually popular. -/
theorem KappaUnbalanced.not_isPopular_unpopularLayer_zero
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) :
    ¬ K.IsPopular
      (PopularityLayers.unpopularLayer G Y K.popularVertices 0) := by
  intro hpopular
  rcases hpopular with hsource | ⟨F, hstationary⟩
  · rcases hsource with ⟨x, hxX, hxLayer⟩
    exact hxLayer.2 (K.source_subset_popularVertices hxX)
  · have htarget :
        PopularityLayers.unpopularLayer G Y K.popularVertices 0 ⊆ Y :=
      fun _ hx => hx.1
    rcases K.exists_stationary_terminalSourceRankSet huncountable F htarget
        hstationary with ⟨t, htLayer, htStationary⟩
    have htPopular : K.IsPopular {t} :=
      K.isPopular_singleton_of_stationary_terminalSourceRankSet F t htStationary
    exact htLayer.2 htPopular

/-- Aharoni--Berger Assertion 8.8: every backward nonpopular layer is
unpopular even as a set. -/
theorem KappaUnbalanced.not_isPopular_unpopularLayer
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) (n : ℕ) :
    ¬ K.IsPopular
      (PopularityLayers.unpopularLayer G Y K.popularVertices n) := by
  induction n with
  | zero => exact K.not_isPopular_unpopularLayer_zero huncountable
  | succ n ih =>
      intro hpopular
      rcases hpopular with hsource | ⟨F, hstationary⟩
      · rcases hsource with ⟨x, hxX, hxLayer⟩
        exact (PopularityLayers.unpopularLayer_not_mem G Y
          K.popularVertices (n + 1) hxLayer)
          (K.source_subset_popularVertices hxX)
      · apply ih
        apply K.isPopular_of_joined_neighbors huncountable F hstationary
        · intro t ht
          exact PopularityLayers.unpopularLayer_not_mem G Y
            K.popularVertices (n + 1) ht
        · intro u hu
          exact PopularityLayers.unpopularLayer_not_mem G Y
            K.popularVertices n hu
        · intro t ht
          exact ht.1

/-- Hereditary form of Aharoni--Berger Assertion 8.9: no subset of a
popular frontier is strongly popular. -/
theorem KappaUnbalanced.not_isStronglyPopular_of_subset_popularFrontier
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y C : Set V}
    (K : KappaUnbalanced α G X Y) (n : ℕ)
    (hC : C ⊆ PopularityLayers.popularFrontier G Y K.popularVertices n) :
    ¬ K.IsStronglyPopular C := by
  cases n with
  | zero =>
      apply K.not_isStronglyPopular_of_subset_target huncountable
      intro t ht
      exact (hC ht).1
  | succ n =>
      rintro ⟨F, hdisjoint, hstationary⟩
      have hterminal : Function.Injective fun i => (F.path i).right := by
        intro i j hij
        by_contra hne
        have hiVertex : (F.path i).right ∈ (F.path i).vertices := by
          exact (F.path i).walk.end_mem_support
        have hjVertex : (F.path i).right ∈ (F.path j).vertices := by
          change (F.path i).right ∈ (F.path j).walk.support
          simpa [← hij] using (F.path j).walk.end_mem_support
        exact (Set.disjoint_left.mp (hdisjoint hne) hiVertex hjVertex).elim
      have hXU : Disjoint X
          (PopularityLayers.unpopularLayer G Y K.popularVertices n) := by
        rw [Set.disjoint_left]
        intro x hxX hxU
        exact (PopularityLayers.unpopularLayer_not_mem G Y
          K.popularVertices n hxU) (K.source_subset_popularVertices hxX)
      let z : F.ι → V := fun i =>
        Classical.choose (hC (F.path i).right_mem).1
      have hzU (i : F.ι) :
          z i ∈ PopularityLayers.unpopularLayer G Y K.popularVertices n :=
        (Classical.choose_spec (hC (F.path i).right_mem).1).1
      have hadj (i : F.ι) : G.Adj (F.path i).right (z i) :=
        (Classical.choose_spec (hC (F.path i).right_mem).1).2
      let F' : JoinedABPathFamily G X
          (PopularityLayers.unpopularLayer G Y K.popularVertices n) :=
        F.advanceDistinctTerminals id hterminal hXU z hzU hadj
      apply K.not_isPopular_unpopularLayer huncountable n
      refine Or.inr ⟨F', ?_⟩
      apply hstationary.mono
      rintro r ⟨i, rfl⟩
      refine ⟨i, ?_⟩
      change K.sourceRank ⟨(F'.path i).left, (F'.path i).left_mem⟩ =
        K.sourceRank ⟨(F.path i).left, (F.path i).left_mem⟩
      exact JoinedABPathFamily.sourceRank_advanceDistinctTerminals
        K F id hterminal hXU z hzU hadj i

/-- Aharoni--Berger Assertion 8.9: no popular frontier is strongly popular. -/
theorem KappaUnbalanced.not_isStronglyPopular_popularFrontier
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) (n : ℕ) :
    ¬ K.IsStronglyPopular
      (PopularityLayers.popularFrontier G Y K.popularVertices n) :=
  K.not_isStronglyPopular_of_subset_popularFrontier huncountable n
    (Set.Subset.rfl)

/-- Assertion 8.10 from the fan-amalgamation lemma: outside the source side,
each popular frontier has cardinal at most the rank cardinal. -/
theorem KappaUnbalanced.mk_popularFrontier_sdiff_source_le
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y)
    (hamalg : JoinedFanAmalgamationAt α G X) (n : ℕ) :
    #{v // v ∈ PopularityLayers.popularFrontier G Y K.popularVertices n \ X} ≤ #α := by
  classical
  let C : Set V :=
    PopularityLayers.popularFrontier G Y K.popularVertices n \ X
  change #C ≤ #α
  by_contra hle
  have hlt : #α < #C := lt_of_not_ge hle
  have hfan (c : C) :
      ∃ F : JoinedABPathFamily G X {c.1},
        IsStationary (F.sourceRankRange K) := by
    have hcPopular : K.IsPopular {c.1} :=
      PopularityLayers.popularFrontier_subset_popular G Y
        K.popularVertices n c.2.1
    rcases hcPopular with hcSource | hcFamily
    · rcases hcSource with ⟨x, hxX, hxc⟩
      have hxcEq : x = c.1 := Set.mem_singleton_iff.mp hxc
      exact (c.2.2 (hxcEq ▸ hxX)).elim
    · exact hcFamily
  choose fan hfanStationary using hfan
  rcases hamalg C hlt fan with ⟨W, hWdisjoint, c, hcSource⟩
  have hWstationary : IsStationary (W.sourceRankRange K) :=
    (hfanStationary c).mono
      (JoinedABPathFamily.sourceRankRange_mono_of_sourceSet_subset K hcSource)
  apply K.not_isStronglyPopular_of_subset_popularFrontier huncountable n
    (show C ⊆ PopularityLayers.popularFrontier G Y K.popularVertices n from
      Set.sdiff_subset)
  exact ⟨W, hWdisjoint, hWstationary⟩

/-- The full breadth-first separator is not strongly popular.  A stationary
warp ending in its countable union of frontiers would have a stationary
restriction to one frontier. -/
theorem KappaUnbalanced.not_isStronglyPopular_popularitySeparator
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y) :
    ¬ K.IsStronglyPopular
      (PopularityLayers.separator G Y K.popularVertices) := by
  rintro ⟨F, hdisjoint, hstationary⟩
  let P : ℕ → Set V := fun n =>
    PopularityLayers.popularFrontier G Y K.popularVertices n
  let S : Set V := PopularityLayers.separator G Y K.popularVertices
  have hPS (n : ℕ) : P n ⊆ S :=
    PopularityLayers.popularFrontier_subset_separator G Y
      K.popularVertices n
  let F' : (n : ℕ) → JoinedABPathFamily G X (P n) := fun n =>
    F.restrictTarget (P n) (hPS n)
  have hUnion : (⋃ n, (F' n).sourceRankRange K) = F.sourceRankRange K := by
    ext r
    constructor
    · intro hr
      rcases Set.mem_iUnion.mp hr with ⟨n, i, hir⟩
      exact ⟨i.1, hir⟩
    · rintro ⟨i, rfl⟩
      have hiS : (F.path i).right ∈ S := (F.path i).right_mem
      rcases Set.mem_iUnion.mp hiS with ⟨n, hin⟩
      apply Set.mem_iUnion.mpr
      exact ⟨n, ⟨⟨i, hin⟩, rfl⟩⟩
  have hcof : cof α ≠ ℵ₀ := by
    rw [Order.cof_eq_cardinalMk]
    exact ne_of_gt huncountable
  have hUnionStationary : IsStationary (⋃ n, (F' n).sourceRankRange K) := by
    rw [hUnion]
    exact hstationary
  rcases (isStationary_iUnion_iff_of_countable hcof).mp hUnionStationary with
    ⟨n, hn⟩
  apply K.not_isStronglyPopular_popularFrontier huncountable n
  refine ⟨F' n, ?_, hn⟩
  intro i j hij
  exact hdisjoint (fun h => hij (Subtype.ext h))

/-- The complete cardinal estimate in Theorem 8.4, conditional only on its
explicit fan-amalgamation lemma. -/
theorem KappaUnbalanced.mk_popularitySeparator_sdiff_source_le
    {α V : Type} [LinearOrder α] [Nonempty α] [WellFoundedLT α]
    [IsRegularCardinalOrder α] [NoMaxOrder α]
    (huncountable : ℵ₀ < #α) {G : SimpleGraph V} {X Y : Set V}
    (K : KappaUnbalanced α G X Y)
    (hamalg : JoinedFanAmalgamationAt α G X) :
    #{v // v ∈ PopularityLayers.separator G Y K.popularVertices \ X} ≤ #α := by
  let C : ℕ → Set V := fun n =>
    PopularityLayers.popularFrontier G Y K.popularVertices n \ X
  have hsep : PopularityLayers.separator G Y K.popularVertices \ X =
      ⋃ n, C n := by
    ext v
    simp only [PopularityLayers.separator, Set.mem_diff, Set.mem_iUnion, C]
    constructor
    · rintro ⟨⟨n, hvn⟩, hvX⟩
      exact ⟨n, hvn, hvX⟩
    · rintro ⟨n, hvn, hvX⟩
      exact ⟨⟨n, hvn⟩, hvX⟩
  rw [hsep]
  calc
    #(⋃ n, C n) ≤ #ℕ * ⨆ n, #(C n) := Cardinal.mk_iUnion_le C
    _ ≤ ℵ₀ * #α := by
      apply mul_le_mul'
      · simp
      · apply ciSup_le'
        intro n
        exact K.mk_popularFrontier_sdiff_source_le huncountable hamalg n
    _ = #α := Cardinal.aleph0_mul_eq huncountable.le

/-! ### Competitor cardinality

Definition 9.16 calls two sources competitors in a union of warps when their
paths meet.  A fixed path is countable, and in each warp at most one path can
contain a specified vertex.  Consequently, in a union indexed by `I`, every
source has at most `#(I × I × ℕ)` competitors.  The explicit encoding below
is the cardinal bookkeeping used by the singular matrix construction. -/

/-- Witness that paths beginning at `a` and `b` in a family of warps meet. -/
structure WarpFamilyCompetitorWitness {I V : Type} {G : SimpleGraph V}
    (W : I → Warp G) (a b : V) where
  leftWarp : I
  leftPath : (W leftWarp).ι
  rightWarp : I
  rightPath : (W rightWarp).ι
  left_initial : ((W leftWarp).path leftPath).initial = a
  right_initial : ((W rightWarp).path rightPath).initial = b
  leftIndex : ℕ
  leftActive : longPathActive ((W leftWarp).path leftPath).terminalIndex leftIndex
  rightIndex : ℕ
  rightActive : longPathActive
    ((W rightWarp).path rightPath).terminalIndex rightIndex
  meet : ((W leftWarp).path leftPath).vertex leftIndex =
    ((W rightWarp).path rightPath).vertex rightIndex

/-- Competitors in the union of an indexed family of warps. -/
def WarpFamilyCompetitor {I V : Type} {G : SimpleGraph V}
    (W : I → Warp G) (a b : V) : Prop :=
  Nonempty (WarpFamilyCompetitorWitness W a b)

/-- A chosen meeting witness for a competitor. -/
noncomputable def warpFamilyCompetitorWitness
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G) (a : V)
    (b : {b // WarpFamilyCompetitor W a b}) :
    WarpFamilyCompetitorWitness W a b.1 :=
  Classical.choice b.property

/-- The two warp indices and a vertex index on the left path encode a
competitor. -/
noncomputable def warpFamilyCompetitorCode
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G) (a : V) :
    {b // WarpFamilyCompetitor W a b} → I × I × ℕ := fun b =>
  let d := warpFamilyCompetitorWitness W a b
  (d.leftWarp, d.rightWarp, d.leftIndex)

theorem warpFamilyCompetitorCode_injective
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G) (a : V) :
    Function.Injective (warpFamilyCompetitorCode W a) := by
  intro b c hcode
  generalize hd : warpFamilyCompetitorWitness W a b = d at hcode
  generalize he : warpFamilyCompetitorWitness W a c = e at hcode
  rcases d with
    ⟨di, dj, dk, dl, hdja, hdlb, dn, hdn, dm, hdm, hdmeet⟩
  rcases e with
    ⟨ei, ej, ek, el, heja, helc, en, hen, em, hem, hemeet⟩
  have htuple : (di, dk, dn) = (ei, ek, en) := by
    simpa only [warpFamilyCompetitorCode, hd, he] using hcode
  have hi : di = ei := congrArg (fun x : I × I × ℕ => x.1) htuple
  have hk : dk = ek := congrArg (fun x : I × I × ℕ => x.2.1) htuple
  have hn : dn = en := congrArg (fun x : I × I × ℕ => x.2.2) htuple
  subst ei
  subst ek
  subst en
  have hleftPath : dj = ej := by
    apply (W di).initial_injective
    exact hdja.trans heja.symm
  have hvd : ((W di).path dj).vertex dn ∈
      ((W dk).path dl).vertexSet := by
    exact ⟨dm, hdm, hdmeet.symm⟩
  have hve : ((W di).path dj).vertex dn ∈
      ((W dk).path el).vertexSet := by
    refine ⟨em, hem, ?_⟩
    rw [hleftPath]
    exact hemeet.symm
  have hrightPath : dl = el := by
    by_contra hne
    exact Set.disjoint_left.mp ((W dk).disjoint hne) hvd hve
  apply Subtype.ext
  exact hdlb.symm.trans (by
    rw [hrightPath]
    exact helc)

/-- Every source has at most `#(I × I × ℕ)` competitors in a union of
`I` warps. -/
theorem mk_warpFamilyCompetitors_le
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G) (a : V) :
    #({b // WarpFamilyCompetitor W a b}) ≤ #(I × I × ℕ) :=
  Cardinal.mk_le_of_injective (warpFamilyCompetitorCode_injective W a)

/-- For an infinite index type, the preceding bound is exactly `#I`, as
used in Assertion 9.17. -/
theorem mk_warpFamilyCompetitors_le_index
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G) (a : V)
    (hI : ℵ₀ ≤ #I) :
    #({b // WarpFamilyCompetitor W a b}) ≤ #I := by
  refine (mk_warpFamilyCompetitors_le W a).trans_eq ?_
  simp only [Cardinal.mk_prod, Cardinal.mk_nat, Cardinal.lift_id]
  rw [Cardinal.mul_aleph0_eq hI, Cardinal.mul_eq_self hI]

/-! ### Countable closure under a small-neighborhood relation

The singular matrix repeatedly closes one row under competitors.  The next
generic construction packages the exact cardinal calculation: if the seed
and every one-step neighborhood have size at most an infinite cardinal
`#I`, then the closure obtained in `ω` steps still has size at most `#I`. -/

/-- Add every one-step `R`-successor of a point already in `S`. -/
def relationClosureStep {V : Type} (R : V → V → Prop) (S : Set V) : Set V :=
  S ∪ {b | ∃ a ∈ S, R a b}

/-- The finite stages of closure under `R`. -/
def relationClosureIter {V : Type} (R : V → V → Prop) (S : Set V) :
    ℕ → Set V
  | 0 => S
  | n + 1 => relationClosureStep R (relationClosureIter R S n)

/-- The closure under `R`, obtained as the union of all finite stages. -/
def relationClosure {V : Type} (R : V → V → Prop) (S : Set V) : Set V :=
  ⋃ n, relationClosureIter R S n

theorem subset_relationClosureStep {V : Type} (R : V → V → Prop)
    (S : Set V) : S ⊆ relationClosureStep R S :=
  Set.subset_union_left

theorem relationClosureIter_subset_succ {V : Type} (R : V → V → Prop)
    (S : Set V) (n : ℕ) :
    relationClosureIter R S n ⊆ relationClosureIter R S (n + 1) := by
  exact subset_relationClosureStep R (relationClosureIter R S n)

theorem relationClosureIter_monotone {V : Type} (R : V → V → Prop)
    (S : Set V) : Monotone (relationClosureIter R S) := by
  intro m n hmn
  induction n, hmn using Nat.le_induction with
  | base => exact Set.Subset.rfl
  | succ n _ ih => exact ih.trans (relationClosureIter_subset_succ R S n)

theorem subset_relationClosure {V : Type} (R : V → V → Prop)
    (S : Set V) : S ⊆ relationClosure R S := by
  intro a ha
  exact Set.mem_iUnion.mpr ⟨0, ha⟩

/-- The countable union really is closed: a witness belongs at some finite
stage, so its successor belongs at the following stage. -/
theorem relationClosure_closed {V : Type} (R : V → V → Prop)
    (S : Set V) {a b : V} (ha : a ∈ relationClosure R S) (hab : R a b) :
    b ∈ relationClosure R S := by
  rcases Set.mem_iUnion.mp ha with ⟨n, han⟩
  apply Set.mem_iUnion.mpr
  refine ⟨n + 1, ?_⟩
  exact Or.inr ⟨a, han, hab⟩

/-- A closure stays inside any set containing its seed and every right-hand
endpoint of the relation. -/
theorem relationClosure_subset_of_right_mem {V : Type}
    (R : V → V → Prop) (S T : Set V) (hS : S ⊆ T)
    (hR : ∀ a b, R a b → b ∈ T) :
    relationClosure R S ⊆ T := by
  intro b hb
  rcases Set.mem_iUnion.mp hb with ⟨n, hbn⟩
  induction n with
  | zero => exact hS hbn
  | succ n ih =>
      change b ∈ relationClosureStep R (relationClosureIter R S n) at hbn
      rcases hbn with hbn | ⟨a, _ha, hab⟩
      · exact ih hbn
      · exact hR a b hab

theorem mk_relationClosureStep_le {I V : Type} (R : V → V → Prop)
    (S : Set V) (hI : ℵ₀ ≤ #I) (hS : #S ≤ #I)
    (hR : ∀ a, #({b // R a b}) ≤ #I) :
    #(relationClosureStep R S) ≤ #I := by
  let N : V → Set V := fun a => {b | R a b}
  have hsuccEq : {b | ∃ a ∈ S, R a b} = ⋃ a : S, N a.1 := by
    ext b
    simp [N]
  have hN (a : S) : #(N a.1) ≤ #I := by
    change #({b // R a.1 b}) ≤ #I
    exact hR a.1
  have hsucc : #(⋃ a : S, N a.1) ≤ #I := by
    calc
      #(⋃ a : S, N a.1) ≤ #S * ⨆ a : S, #(N a.1) :=
        Cardinal.mk_iUnion_le _
      _ ≤ #I * #I := mul_le_mul' hS (ciSup_le' hN)
      _ = #I := Cardinal.mul_eq_self hI
  unfold relationClosureStep
  rw [hsuccEq]
  exact (Cardinal.mk_union_le S (⋃ a : S, N a.1)).trans
    ((add_le_add hS hsucc).trans_eq (Cardinal.add_eq_self hI))

theorem mk_relationClosureIter_le {I V : Type} (R : V → V → Prop)
    (S : Set V) (hI : ℵ₀ ≤ #I) (hS : #S ≤ #I)
    (hR : ∀ a, #({b // R a b}) ≤ #I) :
    ∀ n, #(relationClosureIter R S n) ≤ #I
  | 0 => hS
  | n + 1 => mk_relationClosureStep_le R _ hI
      (mk_relationClosureIter_le R S hI hS hR n) hR

/-- An `ω`-closure under neighborhoods of size at most `#I` has size at most
`#I` whenever `I` is infinite. -/
theorem mk_relationClosure_le {I V : Type} (R : V → V → Prop)
    (S : Set V) (hI : ℵ₀ ≤ #I) (hS : #S ≤ #I)
    (hR : ∀ a, #({b // R a b}) ≤ #I) :
    #(relationClosure R S) ≤ #I := by
  unfold relationClosure
  calc
    #(⋃ n, relationClosureIter R S n) ≤
        #ℕ * ⨆ n, #(relationClosureIter R S n) :=
      Cardinal.mk_iUnion_le _
    _ ≤ #I * #I := by
      apply mul_le_mul'
      · simpa only [Cardinal.mk_nat] using hI
      · exact ciSup_le' fun n => mk_relationClosureIter_le R S hI hS hR n
    _ = #I := Cardinal.mul_eq_self hI

/-- The row closure used in Definition 9.16. -/
def competitorClosure {I V : Type} {G : SimpleGraph V}
    (W : I → Warp G) (S : Set V) : Set V :=
  relationClosure (WarpFamilyCompetitor W) S

theorem subset_competitorClosure {I V : Type} {G : SimpleGraph V}
    (W : I → Warp G) (S : Set V) : S ⊆ competitorClosure W S :=
  subset_relationClosure _ _

theorem competitorClosure_closed {I V : Type} {G : SimpleGraph V}
    (W : I → Warp G) (S : Set V) {a b : V}
    (ha : a ∈ competitorClosure W S) (hab : WarpFamilyCompetitor W a b) :
    b ∈ competitorClosure W S :=
  relationClosure_closed _ _ ha hab

/-- The right-hand endpoint of a competitor pair is the initial vertex of
one of the paths in the family. -/
theorem warpFamilyCompetitor_right_mem_initialSet
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G) {a b : V}
    (hab : WarpFamilyCompetitor W a b) :
    ∃ i, b ∈ (W i).initialSet := by
  rcases hab with ⟨d⟩
  exact ⟨d.rightWarp, d.rightPath, d.right_initial⟩

/-- Closing sources under competitors preserves a common ambient source
set when every warp in the family starts there. -/
theorem competitorClosure_subset_of_initialSet
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G)
    (S A : Set V) (hS : S ⊆ A)
    (hW : ∀ i, (W i).initialSet ⊆ A) :
    competitorClosure W S ⊆ A := by
  apply relationClosure_subset_of_right_mem _ _ _ hS
  intro a b hab
  rcases warpFamilyCompetitor_right_mem_initialSet W hab with ⟨i, hbi⟩
  exact hW i hbi

theorem mk_competitorClosure_le_index {I V : Type} {G : SimpleGraph V}
    (W : I → Warp G) (S : Set V) (hI : ℵ₀ ≤ #I) (hS : #S ≤ #I) :
    #(competitorClosure W S) ≤ #I := by
  exact mk_relationClosure_le _ S hI hS
    (fun a => mk_warpFamilyCompetitors_le_index W a hI)

/-! ### Competitors in pointwise forward limits

Assertion 9.18 takes the limit of each column of the `μ × ω` matrix.  A
meeting in two limit paths already occurs at a common finite stage, because
each of its two vertices enters at a finite stage and the paths only extend
forward. -/

/-- The `n`th family of warps in a pointwise-forward matrix. -/
def forwardWarpFamilyStage {I V : Type} {G : SimpleGraph V} (K : I → Type)
    (P : ∀ (n : ℕ) (i : I), K i → LongPath G)
    (hdisjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
      Disjoint (P n i a).vertexSet (P n i b).vertexSet)
    (n : ℕ) : I → Warp G := fun i =>
  Warp.ofPaths (P n i) (hdisjoint n i)

/-- The componentwise direct limit of a pointwise-forward matrix. -/
noncomputable def forwardWarpFamilyLimit
    {I V : Type} {G : SimpleGraph V} (K : I → Type)
    (P : ∀ (n : ℕ) (i : I), K i → LongPath G)
    (hchain : ∀ (i : I) (a : K i) ⦃n m : ℕ⦄,
      n ≤ m → (P n i a).Forward (P m i a))
    (hdisjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
      Disjoint (P n i a).vertexSet (P n i b).vertexSet) :
    I → Warp G := fun i =>
  Warp.limitOfPaths (fun n a => P n i a)
    (fun a _ _ hnm => hchain i a hnm) (fun n => hdisjoint n i)

/-- Every competitor in a componentwise forward limit is already a
competitor at some common finite stage. -/
theorem warpFamilyCompetitor_forwardLimit_exists_stage
    {I V : Type} {G : SimpleGraph V} (K : I → Type)
    (P : ∀ (n : ℕ) (i : I), K i → LongPath G)
    (hchain : ∀ (i : I) (a : K i) ⦃n m : ℕ⦄,
      n ≤ m → (P n i a).Forward (P m i a))
    (hdisjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
      Disjoint (P n i a).vertexSet (P n i b).vertexSet)
    {a b : V}
    (hcomp : WarpFamilyCompetitor
      (forwardWarpFamilyLimit K P hchain hdisjoint) a b) :
    ∃ n, WarpFamilyCompetitor
      (forwardWarpFamilyStage K P hdisjoint n) a b := by
  rcases hcomp with ⟨d⟩
  rcases d with
    ⟨li, lp, ri, rp, hla, hrb, lx, hlx, rx, hrx, hmeet⟩
  let PL : ℕ → LongPath G := fun n => P n li lp
  let PR : ℕ → LongPath G := fun n => P n ri rp
  have hchainL : ∀ ⦃n m⦄, n ≤ m → (PL n).Forward (PL m) := by
    intro n m hnm
    exact hchain li lp hnm
  have hchainR : ∀ ⦃n m⦄, n ≤ m → (PR n).Forward (PR m) := by
    intro n m hnm
    exact hchain ri rp hnm
  change (LongPath.limit PL hchainL).initial = a at hla
  change (LongPath.limit PR hchainR).initial = b at hrb
  let v := (LongPath.limit PL hchainL).vertex lx
  have hvL : v ∈ (LongPath.limit PL hchainL).vertexSet :=
    ⟨lx, hlx, rfl⟩
  have hvR : v ∈ (LongPath.limit PR hchainR).vertexSet := by
    refine ⟨rx, hrx, ?_⟩
    exact hmeet.symm
  rcases Warp.LongPath.exists_stage_vertex_of_mem_limit PL hchainL hvL with
    ⟨ln, lpos, hlpos, hlv⟩
  rcases Warp.LongPath.exists_stage_vertex_of_mem_limit PR hchainR hvR with
    ⟨rn, rpos, hrpos, hrv⟩
  let n := max ln rn
  have hln : ln ≤ n := le_max_left _ _
  have hrn : rn ≤ n := le_max_right _ _
  have hlForward := hchainL hln lpos hlpos
  have hrForward := hchainR hrn rpos hrpos
  have hzeroL : longPathActive (PL n).terminalIndex 0 := by
    cases (PL n).terminalIndex <;> simp [longPathActive]
  have hzeroR : longPathActive (PR n).terminalIndex 0 := by
    cases (PR n).terminalIndex <;> simp [longPathActive]
  have htoLimitL : (PL n).initial = (LongPath.limit PL hchainL).initial := by
    exact (LongPath.forward_limit PL hchainL n 0 hzeroL).2.symm
  have htoLimitR : (PR n).initial = (LongPath.limit PR hchainR).initial := by
    exact (LongPath.forward_limit PR hchainR n 0 hzeroR).2.symm
  refine ⟨n, ⟨{
    leftWarp := li
    leftPath := lp
    rightWarp := ri
    rightPath := rp
    left_initial := ?_
    right_initial := ?_
    leftIndex := lpos
    leftActive := hlForward.1
    rightIndex := rpos
    rightActive := hrForward.1
    meet := ?_ }⟩⟩
  · exact htoLimitL.trans hla
  · exact htoLimitR.trans hrb
  · exact (hlForward.2.trans hlv).trans (hrForward.2.trans hrv).symm

/-- A competitor witnessed at one stage remains a competitor at every later
stage of a pointwise-forward matrix. -/
theorem warpFamilyCompetitor_forwardStage_mono
    {I V : Type} {G : SimpleGraph V} (K : I → Type)
    (P : ∀ (n : ℕ) (i : I), K i → LongPath G)
    (hchain : ∀ (i : I) (a : K i) ⦃n m : ℕ⦄,
      n ≤ m → (P n i a).Forward (P m i a))
    (hdisjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
      Disjoint (P n i a).vertexSet (P n i b).vertexSet)
    {n m : ℕ} (hnm : n ≤ m) {a b : V}
    (hcomp : WarpFamilyCompetitor
      (forwardWarpFamilyStage K P hdisjoint n) a b) :
    WarpFamilyCompetitor
      (forwardWarpFamilyStage K P hdisjoint m) a b := by
  rcases hcomp with ⟨d⟩
  rcases d with
    ⟨li, lp, ri, rp, hla, hrb, lx, hlx, rx, hrx, hmeet⟩
  have hleft := hchain li lp hnm lx hlx
  have hright := hchain ri rp hnm rx hrx
  have hzeroL : longPathActive (P n li lp).terminalIndex 0 := by
    cases (P n li lp).terminalIndex <;> simp [longPathActive]
  have hzeroR : longPathActive (P n ri rp).terminalIndex 0 := by
    cases (P n ri rp).terminalIndex <;> simp [longPathActive]
  have hinitialL := (hchain li lp hnm 0 hzeroL).2
  have hinitialR := (hchain ri rp hnm 0 hzeroR).2
  exact ⟨{
    leftWarp := li
    leftPath := lp
    rightWarp := ri
    rightPath := rp
    left_initial := hinitialL.trans hla
    right_initial := hinitialR.trans hrb
    leftIndex := lx
    leftActive := hleft.1
    rightIndex := rx
    rightActive := hright.1
    meet := (hleft.2.trans hmeet).trans hright.2.symm }⟩

/-- Two intersecting paths in an indexed warp family witness that their
initial vertices are competitors. -/
theorem warpFamilyCompetitor_of_not_disjoint
    {I V : Type} {G : SimpleGraph V} (W : I → Warp G)
    {i k : I} {j : (W i).ι} {l : (W k).ι}
    (hmeet : ¬ Disjoint ((W i).path j).vertexSet ((W k).path l).vertexSet) :
    WarpFamilyCompetitor W ((W i).path j).initial ((W k).path l).initial := by
  rcases Set.not_disjoint_iff.mp hmeet with ⟨v, hvj, hvl⟩
  rcases hvj with ⟨n, hn, hvn⟩
  rcases hvl with ⟨m, hm, hvm⟩
  exact ⟨{
    leftWarp := i
    leftPath := j
    rightWarp := k
    rightPath := l
    left_initial := rfl
    right_initial := rfl
    leftIndex := n
    leftActive := hn
    rightIndex := m
    rightActive := hm
    meet := hvn.trans hvm.symm }⟩

/-- The family used in the singular construction: the old linkage at
`none`, and the new ranked linkages at `some i`. -/
def competitorWarpFamily {I V : Type} {G : SimpleGraph V}
    (F : Warp G) (W : I → Warp G) : Option I → Warp G
  | none => F
  | some i => W i

/-- A row closed under competitors from the old linkage and every ranked
linkage still has size at most the infinite rank cardinal. -/
theorem mk_competitorClosure_old_ranked_le_index
    {I V : Type} {G : SimpleGraph V} (F : Warp G) (W : I → Warp G)
    (S : Set V) (hI : ℵ₀ ≤ #I) (hS : #S ≤ #I) :
    #(competitorClosure (competitorWarpFamily F W) S) ≤ #I := by
  have hOption : #(Option I) = #I := by
    rw [Cardinal.mk_option, Cardinal.add_one_eq hI]
  have hInfiniteOption : ℵ₀ ≤ #(Option I) := hOption.symm ▸ hI
  have hSeedOption : #S ≤ #(Option I) := hOption.symm ▸ hS
  have hbound := mk_competitorClosure_le_index
    (competitorWarpFamily F W) S hInfiniteOption hSeedOption
  rwa [hOption] at hbound

/-- Capacity form of the row-closure estimate.  The family may be indexed
by a smaller infinite type `I`, while the seed and resulting closure are
measured against the row capacity `#K`. -/
theorem mk_competitorClosure_old_ranked_le_capacity
    {I K V : Type} {G : SimpleGraph V} (F : Warp G) (W : I → Warp G)
    (S : Set V) (hI : ℵ₀ ≤ #I) (hIK : #I ≤ #K)
    (hK : ℵ₀ ≤ #K) (hS : #S ≤ #K) :
    #(competitorClosure (competitorWarpFamily F W) S) ≤ #K := by
  have hOption : #(Option I) = #I := by
    rw [Cardinal.mk_option, Cardinal.add_one_eq hI]
  have hInfiniteOption : ℵ₀ ≤ #(Option I) := hOption.symm ▸ hI
  apply mk_relationClosure_le _ S hK hS
  intro a
  exact (mk_warpFamilyCompetitors_le_index
    (competitorWarpFamily F W) a hInfiniteOption).trans
      (hOption.le.trans hIK)

/-- A competitor in the family consisting of one fixed old warp and a
pointwise-forward limit of ranked warps is witnessed at a finite stage. -/
theorem warpFamilyCompetitor_old_forwardLimit_exists_stage
    {I V : Type} {G : SimpleGraph V} (F : Warp G) (K : I → Type)
    (P : ∀ (n : ℕ) (i : I), K i → LongPath G)
    (hchain : ∀ (i : I) (a : K i) ⦃n m : ℕ⦄,
      n ≤ m → (P n i a).Forward (P m i a))
    (hdisjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
      Disjoint (P n i a).vertexSet (P n i b).vertexSet)
    {a b : V}
    (hcomp : WarpFamilyCompetitor
      (competitorWarpFamily F
        (forwardWarpFamilyLimit K P hchain hdisjoint)) a b) :
    ∃ n, WarpFamilyCompetitor
      (competitorWarpFamily F
        (forwardWarpFamilyStage K P hdisjoint n)) a b := by
  rcases hcomp with ⟨d⟩
  rcases d with
    ⟨li, lp, ri, rp, hla, hrb, lx, hlx, rx, hrx, hmeet⟩
  cases li with
  | none =>
      cases ri with
      | none =>
          refine ⟨0, ⟨{
            leftWarp := none
            leftPath := lp
            rightWarp := none
            rightPath := rp
            left_initial := hla
            right_initial := hrb
            leftIndex := lx
            leftActive := hlx
            rightIndex := rx
            rightActive := hrx
            meet := hmeet }⟩⟩
      | some ri =>
          let PR : ℕ → LongPath G := fun n => P n ri rp
          have hchainR : ∀ ⦃n m⦄, n ≤ m → (PR n).Forward (PR m) := by
            intro n m hnm
            exact hchain ri rp hnm
          let v := (F.path lp).vertex lx
          have hvR : v ∈ (LongPath.limit PR hchainR).vertexSet := by
            refine ⟨rx, hrx, ?_⟩
            exact hmeet.symm
          rcases Warp.LongPath.exists_stage_vertex_of_mem_limit
              PR hchainR hvR with ⟨n, rpos, hrpos, hrv⟩
          have hzeroR : longPathActive (PR n).terminalIndex 0 := by
            cases (PR n).terminalIndex <;> simp [longPathActive]
          have htoLimitR :
              (PR n).initial = (LongPath.limit PR hchainR).initial := by
            exact (LongPath.forward_limit PR hchainR n 0 hzeroR).2.symm
          change (LongPath.limit PR hchainR).initial = b at hrb
          refine ⟨n, ⟨{
            leftWarp := none
            leftPath := lp
            rightWarp := some ri
            rightPath := rp
            left_initial := hla
            right_initial := htoLimitR.trans hrb
            leftIndex := lx
            leftActive := hlx
            rightIndex := rpos
            rightActive := hrpos
            meet := ?_ }⟩⟩
          exact hrv.symm
  | some li =>
      cases ri with
      | none =>
          let PL : ℕ → LongPath G := fun n => P n li lp
          have hchainL : ∀ ⦃n m⦄, n ≤ m → (PL n).Forward (PL m) := by
            intro n m hnm
            exact hchain li lp hnm
          let v := (F.path rp).vertex rx
          have hvL : v ∈ (LongPath.limit PL hchainL).vertexSet := by
            refine ⟨lx, hlx, ?_⟩
            exact hmeet
          rcases Warp.LongPath.exists_stage_vertex_of_mem_limit
              PL hchainL hvL with ⟨n, lpos, hlpos, hlv⟩
          have hzeroL : longPathActive (PL n).terminalIndex 0 := by
            cases (PL n).terminalIndex <;> simp [longPathActive]
          have htoLimitL :
              (PL n).initial = (LongPath.limit PL hchainL).initial := by
            exact (LongPath.forward_limit PL hchainL n 0 hzeroL).2.symm
          change (LongPath.limit PL hchainL).initial = a at hla
          refine ⟨n, ⟨{
            leftWarp := some li
            leftPath := lp
            rightWarp := none
            rightPath := rp
            left_initial := htoLimitL.trans hla
            right_initial := hrb
            leftIndex := lpos
            leftActive := hlpos
            rightIndex := rx
            rightActive := hrx
            meet := ?_ }⟩⟩
          exact hlv
      | some ri =>
          have hcomp' : WarpFamilyCompetitor
              (forwardWarpFamilyLimit K P hchain hdisjoint) a b := ⟨{
            leftWarp := li
            leftPath := lp
            rightWarp := ri
            rightPath := rp
            left_initial := hla
            right_initial := hrb
            leftIndex := lx
            leftActive := hlx
            rightIndex := rx
            rightActive := hrx
            meet := hmeet }⟩
          rcases warpFamilyCompetitor_forwardLimit_exists_stage
              K P hchain hdisjoint hcomp' with ⟨n, ⟨e⟩⟩
          exact ⟨n, ⟨{
            leftWarp := some e.leftWarp
            leftPath := e.leftPath
            rightWarp := some e.rightWarp
            rightPath := e.rightPath
            left_initial := e.left_initial
            right_initial := e.right_initial
            leftIndex := e.leftIndex
            leftActive := e.leftActive
            rightIndex := e.rightIndex
            rightActive := e.rightActive
            meet := e.meet }⟩⟩

/-- The preceding fixed-old-warp competitors also persist from one finite
stage to every later stage. -/
theorem warpFamilyCompetitor_old_forwardStage_mono
    {I V : Type} {G : SimpleGraph V} (F : Warp G) (K : I → Type)
    (P : ∀ (n : ℕ) (i : I), K i → LongPath G)
    (hchain : ∀ (i : I) (a : K i) ⦃n m : ℕ⦄,
      n ≤ m → (P n i a).Forward (P m i a))
    (hdisjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
      Disjoint (P n i a).vertexSet (P n i b).vertexSet)
    {n m : ℕ} (hnm : n ≤ m) {a b : V}
    (hcomp : WarpFamilyCompetitor
      (competitorWarpFamily F
        (forwardWarpFamilyStage K P hdisjoint n)) a b) :
    WarpFamilyCompetitor
      (competitorWarpFamily F
        (forwardWarpFamilyStage K P hdisjoint m)) a b := by
  rcases hcomp with ⟨d⟩
  rcases d with
    ⟨li, lp, ri, rp, hla, hrb, lx, hlx, rx, hrx, hmeet⟩
  cases li with
  | none =>
      cases ri with
      | none => exact ⟨{
          leftWarp := none
          leftPath := lp
          rightWarp := none
          rightPath := rp
          left_initial := hla
          right_initial := hrb
          leftIndex := lx
          leftActive := hlx
          rightIndex := rx
          rightActive := hrx
          meet := hmeet }⟩
      | some ri =>
          have hright := hchain ri rp hnm rx hrx
          have hzero : longPathActive (P n ri rp).terminalIndex 0 := by
            cases (P n ri rp).terminalIndex <;> simp [longPathActive]
          have hinitial := (hchain ri rp hnm 0 hzero).2
          exact ⟨{
            leftWarp := none
            leftPath := lp
            rightWarp := some ri
            rightPath := rp
            left_initial := hla
            right_initial := hinitial.trans hrb
            leftIndex := lx
            leftActive := hlx
            rightIndex := rx
            rightActive := hright.1
            meet := hmeet.trans hright.2.symm }⟩
  | some li =>
      cases ri with
      | none =>
          have hleft := hchain li lp hnm lx hlx
          have hzero : longPathActive (P n li lp).terminalIndex 0 := by
            cases (P n li lp).terminalIndex <;> simp [longPathActive]
          have hinitial := (hchain li lp hnm 0 hzero).2
          exact ⟨{
            leftWarp := some li
            leftPath := lp
            rightWarp := none
            rightPath := rp
            left_initial := hinitial.trans hla
            right_initial := hrb
            leftIndex := lx
            leftActive := hleft.1
            rightIndex := rx
            rightActive := hrx
            meet := hleft.2.trans hmeet }⟩
      | some ri =>
          have hleft := hchain li lp hnm lx hlx
          have hright := hchain ri rp hnm rx hrx
          have hzeroL : longPathActive (P n li lp).terminalIndex 0 := by
            cases (P n li lp).terminalIndex <;> simp [longPathActive]
          have hzeroR : longPathActive (P n ri rp).terminalIndex 0 := by
            cases (P n ri rp).terminalIndex <;> simp [longPathActive]
          have hinitialL := (hchain li lp hnm 0 hzeroL).2
          have hinitialR := (hchain ri rp hnm 0 hzeroR).2
          exact ⟨{
            leftWarp := some li
            leftPath := lp
            rightWarp := some ri
            rightPath := rp
            left_initial := hinitialL.trans hla
            right_initial := hinitialR.trans hrb
            leftIndex := lx
            leftActive := hleft.1
            rightIndex := rx
            rightActive := hright.1
            meet := (hleft.2.trans hmeet).trans hright.2.symm }⟩

/-- The old-linkage paths retained after all sources covered by `C` have
been assigned a path of least rank. -/
def CompetitorRemainingIndex {I V : Type} {G : SimpleGraph V}
    (C : I → Set V) (F : Warp G) :=
  {j : F.ι // ¬ ∃ i, (F.path j).initial ∈ C i}

/-- A least-rank chosen path for every covered source. -/
noncomputable def competitorChosenPath {I V : Type} {G : SimpleGraph V}
    {B : Set V} (C : I → Set V) (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a))
    (a : CompetitorCoveredSource C) : LongPath G :=
  linkagePathAt (W (rank a)) (hW (rank a)) ⟨a.1, hrank a⟩

@[simp] theorem competitorChosenPath_initial
    {I V : Type} {G : SimpleGraph V} {B : Set V}
    (C : I → Set V) (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a))
    (a : CompetitorCoveredSource C) :
    (competitorChosenPath C W hW rank hrank a).initial = a.1 := by
  exact linkagePathAt_initial (W (rank a)) (hW (rank a)) ⟨a.1, hrank a⟩

/-- The path family used in the singular amalgamation: first the least-rank
paths, then the untouched paths of the old linkage. -/
noncomputable def competitorCombinedPath {I V : Type}
    {G : SimpleGraph V} {B : Set V}
    (C : I → Set V) (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a)) (F : Warp G) :
    (CompetitorCoveredSource C ⊕ CompetitorRemainingIndex C F) →
      LongPath G
  | Sum.inl a => competitorChosenPath C W hW rank hrank a
  | Sum.inr j => F.path j.1

/-- Competitor closure makes the combined family pairwise disjoint.  The
`closedW` hypothesis handles competitors coming from another new linkage;
`closedF` handles competitors coming from the old linkage. -/
theorem competitorCombinedPath_pairwise_disjoint
    {I V : Type} [LinearOrder I] {G : SimpleGraph V}
    {B : Set V} (C : I → Set V) (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a))
    (hmin : ∀ (a : CompetitorCoveredSource C) i,
      a.1 ∈ C i → rank a ≤ i)
    (sameRankDisjoint : ∀ (a b : CompetitorCoveredSource C), a ≠ b →
      rank a = rank b →
      Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet)
    (F : Warp G)
    (closedW : ∀ (a b : CompetitorCoveredSource C),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet →
      b.1 ∈ C (rank a))
    (closedF : ∀ (a : CompetitorCoveredSource C) (j : F.ι),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (F.path j).vertexSet →
      (F.path j).initial ∈ C (rank a)) :
    Pairwise fun x y :
        (CompetitorCoveredSource C ⊕ CompetitorRemainingIndex C F) =>
      Disjoint (competitorCombinedPath C W hW rank hrank F x).vertexSet
        (competitorCombinedPath C W hW rank hrank F y).vertexSet := by
  intro x y hxy
  cases x with
  | inl a =>
      cases y with
      | inl b =>
          by_cases hab : a = b
          · exact (hxy (congrArg Sum.inl hab)).elim
          · by_contra hmeet
            change ¬ Disjoint
              (competitorChosenPath C W hW rank hrank a).vertexSet
              (competitorChosenPath C W hW rank hrank b).vertexSet at hmeet
            rcases lt_trichotomy (rank a) (rank b) with hlt | heq | hgt
            · have hbEarly := closedW a b hmeet
              exact (not_le_of_gt hlt) (hmin b (rank a) hbEarly)
            · exact hmeet (sameRankDisjoint a b hab heq)
            · have haEarly := closedW b a (by
                simpa [disjoint_comm] using hmeet)
              exact (not_le_of_gt hgt) (hmin a (rank b) haEarly)
      | inr j =>
          by_contra hmeet
          have hmeet' : ¬ Disjoint
              (competitorChosenPath C W hW rank hrank a).vertexSet
              (F.path j.1).vertexSet := by
            change ¬ Disjoint
              (competitorCombinedPath C W hW rank hrank F (Sum.inl a)).vertexSet
              (competitorCombinedPath C W hW rank hrank F (Sum.inr j)).vertexSet
              at hmeet
            exact hmeet
          exact j.property ⟨rank a, closedF a j.1 hmeet'⟩
  | inr i =>
      cases y with
      | inl b =>
          by_contra hmeet
          have hmeet' : ¬ Disjoint
              (competitorChosenPath C W hW rank hrank b).vertexSet
              (F.path i.1).vertexSet := by
            intro hd
            exact hmeet hd.symm
          exact i.property ⟨rank b, closedF b i.1 hmeet'⟩
      | inr j =>
          apply F.disjoint
          intro hij
          apply hxy
          exact congrArg Sum.inr (Subtype.ext hij)

/-- The warp associated with a competitor-closed family. -/
noncomputable def competitorCombinedWarp
    {I V : Type} [LinearOrder I] {G : SimpleGraph V}
    {B : Set V} (C : I → Set V) (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a))
    (hmin : ∀ (a : CompetitorCoveredSource C) i,
      a.1 ∈ C i → rank a ≤ i)
    (sameRankDisjoint : ∀ (a b : CompetitorCoveredSource C), a ≠ b →
      rank a = rank b →
      Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet)
    (F : Warp G)
    (closedW : ∀ (a b : CompetitorCoveredSource C),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet →
      b.1 ∈ C (rank a))
    (closedF : ∀ (a : CompetitorCoveredSource C) (j : F.ι),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (F.path j).vertexSet →
      (F.path j).initial ∈ C (rank a)) : Warp G :=
  Warp.ofPaths (competitorCombinedPath C W hW rank hrank F)
    (competitorCombinedPath_pairwise_disjoint C W hW rank hrank hmin
      sameRankDisjoint F closedW closedF)

/-- Singular-cardinal final amalgamation (Assertions 9.17--9.18).  Once the
cardinal induction has produced a competitor-closed ranked family covering
`A₀`, this theorem turns it and the old linkage of `A \ A₀` into a clean
linkage of all of `A`. -/
theorem exists_cleanLinkage_of_competitor_closed
    {I V : Type} [LinearOrder I] {G : SimpleGraph V}
    {A A₀ B : Set V} (C : I → Set V) (hCA : ∀ i, C i ⊆ A)
    (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (hWclean : ∀ i, (W i).IsSourceClean A)
    (hA₀cover : A₀ ⊆ {a | ∃ i, a ∈ C i})
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a))
    (hmin : ∀ (a : CompetitorCoveredSource C) i,
      a.1 ∈ C i → rank a ≤ i)
    (sameRankDisjoint : ∀ (a b : CompetitorCoveredSource C), a ≠ b →
      rank a = rank b →
      Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (closedW : ∀ (a b : CompetitorCoveredSource C),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet →
      b.1 ∈ C (rank a))
    (closedF : ∀ (a : CompetitorCoveredSource C) (j : F.ι),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (F.path j).vertexSet →
      (F.path j).initial ∈ C (rank a)) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  classical
  let U := competitorCombinedWarp C W hW rank hrank hmin sameRankDisjoint F
    closedW closedF
  refine ⟨U, ⟨?_, ?_⟩⟩
  · refine ⟨?_, ?_⟩
    · ext a
      constructor
      · rintro ⟨k, hk⟩
        cases k with
        | inl x =>
            have hax : x.1 = a := by
              simpa [U, competitorCombinedWarp, competitorCombinedPath,
                Warp.ofPaths] using hk
            exact hax ▸ hCA (rank x) (hrank x)
        | inr j =>
            have haj : (F.path j.1).initial = a := by
              simpa [U, competitorCombinedWarp, competitorCombinedPath,
                Warp.ofPaths] using hk
            rw [← haj]
            have hjInitial : (F.path j.1).initial ∈ F.initialSet := ⟨j.1, rfl⟩
            rw [hF.1.1] at hjInitial
            exact hjInitial.1
      · intro ha
        by_cases hcovered : ∃ i, a ∈ C i
        · let x : CompetitorCoveredSource C := ⟨a, hcovered⟩
          refine ⟨Sum.inl x, ?_⟩
          change (competitorChosenPath C W hW rank hrank x).initial = a
          exact competitorChosenPath_initial C W hW rank hrank x
        · have ha₀ : a ∉ A₀ := fun ha₀ => hcovered (hA₀cover ha₀)
          have haF : a ∈ F.initialSet := by
            rw [hF.1.1]
            exact ⟨ha, ha₀⟩
          rcases haF with ⟨j, hj⟩
          have hjRemain : ¬ ∃ i, (F.path j).initial ∈ C i := by
            simpa [hj] using hcovered
          let j' : CompetitorRemainingIndex C F := ⟨j, hjRemain⟩
          refine ⟨Sum.inr j', ?_⟩
          change (F.path j).initial = a
          exact hj
    · intro k
      cases k with
      | inl x =>
          exact linkagePathAt_endsIn
            (W (rank x)) (hW (rank x)) ⟨x.1, hrank x⟩
      | inr j => exact hF.1.2 j.1
  · intro k v hv hvA
    cases k with
    | inl x =>
        change v ∈ (competitorChosenPath C W hW rank hrank x).vertexSet at hv
        change v = (competitorChosenPath C W hW rank hrank x).initial
        have hsc := linkagePathAt_sourceClean
          (W (rank x)) (hW (rank x)) (hWclean (rank x))
          ⟨x.1, hrank x⟩ hv hvA
        exact hsc.trans
          (competitorChosenPath_initial C W hW rank hrank x).symm
    | inr j =>
        by_cases hvA₀ : v ∈ A₀
        · let x : CompetitorCoveredSource C := ⟨v, hA₀cover hvA₀⟩
          have hvChosen : v ∈
              (competitorChosenPath C W hW rank hrank x).vertexSet := by
            have hi :=
              (competitorChosenPath C W hW rank hrank x).initial_mem_vertexSet
            simpa [competitorChosenPath_initial C W hW rank hrank x] using hi
          have hmeet : ¬ Disjoint
              (competitorChosenPath C W hW rank hrank x).vertexSet
              (F.path j.1).vertexSet := by
            intro hd
            exact Set.disjoint_left.mp hd hvChosen hv
          exact (j.property ⟨rank x, closedF x j.1 hmeet⟩).elim
        · exact hF.2 j.1 v hv ⟨hvA, hvA₀⟩

/-- Assertion 9.18 in its natural family form.  Closure under competitors in
the single family consisting of `F` and all `W i` automatically yields the
same-rank disjointness and both closure hypotheses required by the explicit
least-rank amalgamation above. -/
theorem exists_cleanLinkage_of_competitor_family_closed
    {I V : Type} [LinearOrder I] {G : SimpleGraph V}
    {A A₀ B : Set V} (C : I → Set V) (hCA : ∀ i, C i ⊆ A)
    (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (hWclean : ∀ i, (W i).IsSourceClean A)
    (hA₀cover : A₀ ⊆ {a | ∃ i, a ∈ C i})
    (rank : CompetitorCoveredSource C → I)
    (hrank : ∀ a, a.1 ∈ C (rank a))
    (hmin : ∀ (a : CompetitorCoveredSource C) i,
      a.1 ∈ C i → rank a ≤ i)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hclosed : ∀ i a, a ∈ C i → ∀ b,
      WarpFamilyCompetitor (competitorWarpFamily F W) a b → b ∈ C i) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  classical
  have sameRankDisjoint : ∀ (a b : CompetitorCoveredSource C), a ≠ b →
      rank a = rank b →
      Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet := by
    intro a b hab hrankEq
    have hbRank : b.1 ∈ C (rank a) := by
      simpa only [hrankEq] using hrank b
    let pb := linkagePathAt (W (rank a)) (hW (rank a)) ⟨b.1, hbRank⟩
    have path_transport (i j : I) (e : i = j) :
        ∀ (hi : b.1 ∈ C i) (hj : b.1 ∈ C j),
          linkagePathAt (W j) (hW j) ⟨b.1, hj⟩ =
            linkagePathAt (W i) (hW i) ⟨b.1, hi⟩ := by
      subst j
      intro hi hj
      rfl
    have hpb : competitorChosenPath C W hW rank hrank b = pb := by
      exact path_transport (rank a) (rank b) hrankEq hbRank (hrank b)
    rw [hpb]
    change Disjoint
      (linkagePathAt (W (rank a)) (hW (rank a))
        ⟨a.1, hrank a⟩).vertexSet pb.vertexSet
    apply linkagePathAt_disjoint
    intro heq
    have habval : a.1 = b.1 :=
      congrArg (fun x : {v // v ∈ C (rank a)} => x.1) heq
    exact hab (Subtype.ext habval)
  have closedW : ∀ (a b : CompetitorCoveredSource C),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (competitorChosenPath C W hW rank hrank b).vertexSet →
      b.1 ∈ C (rank a) := by
    intro a b hmeet
    have haInit : a.1 ∈ (W (rank a)).initialSet := by
      rw [(hW (rank a)).1]
      exact hrank a
    have hbInit : b.1 ∈ (W (rank b)).initialSet := by
      rw [(hW (rank b)).1]
      exact hrank b
    let ia := (W (rank a)).sourceIndex haInit
    let ib := (W (rank b)).sourceIndex hbInit
    have hmeet' : ¬ Disjoint
        ((competitorWarpFamily F W (some (rank a))).path ia).vertexSet
        ((competitorWarpFamily F W (some (rank b))).path ib).vertexSet := by
      simpa [competitorWarpFamily, ia, ib, competitorChosenPath,
        linkagePathAt] using hmeet
    have hc₀ := warpFamilyCompetitor_of_not_disjoint
      (competitorWarpFamily F W) hmeet'
    have hc : WarpFamilyCompetitor (competitorWarpFamily F W) a.1 b.1 := by
      simpa [competitorWarpFamily, ia, ib] using hc₀
    exact hclosed (rank a) a.1 (hrank a) b.1 hc
  have closedF : ∀ (a : CompetitorCoveredSource C) (j : F.ι),
      ¬ Disjoint
        (competitorChosenPath C W hW rank hrank a).vertexSet
        (F.path j).vertexSet →
      (F.path j).initial ∈ C (rank a) := by
    intro a j hmeet
    have haInit : a.1 ∈ (W (rank a)).initialSet := by
      rw [(hW (rank a)).1]
      exact hrank a
    let ia := (W (rank a)).sourceIndex haInit
    have hmeet' : ¬ Disjoint
        ((competitorWarpFamily F W (some (rank a))).path ia).vertexSet
        ((competitorWarpFamily F W none).path j).vertexSet := by
      simpa [competitorWarpFamily, ia, competitorChosenPath,
        linkagePathAt] using hmeet
    have hc₀ := warpFamilyCompetitor_of_not_disjoint
      (competitorWarpFamily F W) hmeet'
    have hc : WarpFamilyCompetitor (competitorWarpFamily F W)
        a.1 (F.path j).initial := by
      simpa [competitorWarpFamily, ia] using hc₀
    exact hclosed (rank a) a.1 (hrank a) (F.path j).initial hc
  exact exists_cleanLinkage_of_competitor_closed C hCA W hW hWclean
    hA₀cover rank hrank hmin sameRankDisjoint F hF closedW closedF

/-- Assertion 9.18 with the least-rank choice discharged canonically by the
well-order on the cofinal index set. -/
theorem exists_cleanLinkage_of_wellOrdered_competitor_family_closed
    {I V : Type} [LinearOrder I] [WellFoundedLT I] {G : SimpleGraph V}
    {A A₀ B : Set V} (C : I → Set V) (hCA : ∀ i, C i ⊆ A)
    (W : I → Warp G)
    (hW : ∀ i, (W i).IsLinkage (C i) B)
    (hWclean : ∀ i, (W i).IsSourceClean A)
    (hA₀cover : A₀ ⊆ {a | ∃ i, a ∈ C i})
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hclosed : ∀ i a, a ∈ C i → ∀ b,
      WarpFamilyCompetitor (competitorWarpFamily F W) a b → b ∈ C i) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  exact exists_cleanLinkage_of_competitor_family_closed C hCA W hW hWclean
    hA₀cover (competitorCoveredRank C) (competitorCoveredRank_mem C)
    (competitorCoveredRank_min C) F hF hclosed

/-! ### Extracting the closed family from the singular matrix

Assertion 9.17 constructs a matrix whose columns are forward chains of
linkages.  The active source set in a row grows with the finite stage, every
source is eventually activated, and the next stage activates every competitor
of an already active source.  The structure below records precisely these
properties.  Assertion 9.18 is then a formal consequence of the finite-stage
competitor lemmas proved above. -/

/-- The data and invariants of the countable forward-extension matrix used in
the singular-cardinal construction. -/
structure ForwardCompetitorMatrix (I : Type) {V : Type} (G : SimpleGraph V)
    (A B : Set V) (F : Warp G) where
  K : I → Type
  source : ∀ i, K i → V
  path : ∀ (n : ℕ) (i : I), K i → LongPath G
  chain : ∀ (i : I) (a : K i) ⦃n m : ℕ⦄,
    n ≤ m → (path n i a).Forward (path m i a)
  disjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
    Disjoint (path n i a).vertexSet (path n i b).vertexSet
  initial : ∀ (n : ℕ) (i : I) (a : K i),
    (path n i a).initial = source i a
  active : ℕ → I → Set V
  active_mono : ∀ (i : I) ⦃n m : ℕ⦄,
    n ≤ m → active n i ⊆ active m i
  active_subset_source : ∀ (n : ℕ) (i : I),
    active n i ⊆ Set.range (source i)
  active_subset_A : ∀ (n : ℕ) (i : I), active n i ⊆ A
  activated : ∀ (i : I) (a : K i), ∃ n, source i a ∈ active n i
  eventual_terminal : ∀ (i : I) (a : K i),
    ∃ n b, b ∈ B ∧ ∀ m, n ≤ m → (path m i a).terminal? = some b
  clean : ∀ (n : ℕ) (i : I),
    (forwardWarpFamilyStage K path disjoint n i).IsSourceClean A
  competitor_succ : ∀ (n : ℕ) (i : I) (a : K i),
    source i a ∈ active n i → ∀ b,
      WarpFamilyCompetitor
        (competitorWarpFamily F
          (forwardWarpFamilyStage K path disjoint n))
        (source i a) b →
      b ∈ active (n + 1) i

namespace ForwardCompetitorMatrix

/-- The source set assigned to one column of the matrix. -/
def sourceSet {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) (i : I) : Set V :=
  Set.range (M.source i)

/-- The componentwise direct limit of a forward competitor matrix. -/
noncomputable def limitWarp {I V : Type} {G : SimpleGraph V}
    {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) : I → Warp G :=
  forwardWarpFamilyLimit M.K M.path M.chain M.disjoint

@[simp] theorem limitWarp_path_initial
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) (i : I) (a : M.K i) :
    ((M.limitWarp i).path a).initial = M.source i a := by
  have hzero : longPathActive (M.path 0 i a).terminalIndex 0 := by
    cases (M.path 0 i a).terminalIndex <;> simp [longPathActive]
  have hforward := LongPath.forward_limit
    (fun n => M.path n i a) (fun _ _ hnm => M.chain i a hnm) 0 0 hzero
  exact hforward.2.trans (M.initial 0 i a)

/-- Every matrix column limits to a linkage of its prescribed source set. -/
theorem limitWarp_isLinkage
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) (i : I) :
    (M.limitWarp i).IsLinkage (M.sourceSet i) B := by
  constructor
  · ext v
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨a, (M.limitWarp_path_initial i a).symm.trans ha⟩
    · rintro ⟨a, rfl⟩
      exact ⟨a, M.limitWarp_path_initial i a⟩
  · intro a
    rcases M.eventual_terminal i a with ⟨n, b, hb, heventual⟩
    refine ⟨b, hb, ?_⟩
    change (LongPath.limit (fun m => M.path m i a)
      (fun _ _ hnm => M.chain i a hnm)).terminal? = some b
    exact LongPath.terminal?_limit_of_eventually
      (fun m => M.path m i a) (fun _ _ hnm => M.chain i a hnm)
      ⟨n, heventual⟩

/-- Source cleanliness passes from every finite matrix stage to the direct
limit of each column. -/
theorem limitWarp_isSourceClean
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) (i : I) :
    (M.limitWarp i).IsSourceClean A := by
  intro a v hv hvA
  change v ∈ (LongPath.limit (fun n => M.path n i a)
    (fun _ _ hnm => M.chain i a hnm)).vertexSet at hv
  rcases Warp.LongPath.exists_stage_vertex_of_mem_limit
      (fun n => M.path n i a) (fun _ _ hnm => M.chain i a hnm) hv with
    ⟨n, hvn⟩
  have hstage := M.clean n i a v hvn hvA
  exact hstage.trans
    ((M.initial n i a).trans (M.limitWarp_path_initial i a).symm)

theorem sourceSet_subset_A
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) (i : I) :
    M.sourceSet i ⊆ A := by
  rintro _ ⟨a, rfl⟩
  rcases M.activated i a with ⟨n, ha⟩
  exact M.active_subset_A n i ha

/-- The source set in every limiting column is closed under competitors from
the fixed old linkage and all limiting columns. -/
theorem sourceSet_competitor_closed
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F) (i : I) {a b : V}
    (ha : a ∈ M.sourceSet i)
    (hab : WarpFamilyCompetitor
      (competitorWarpFamily F M.limitWarp) a b) :
    b ∈ M.sourceSet i := by
  rcases ha with ⟨x, rfl⟩
  rcases M.activated i x with ⟨n, hactive⟩
  rcases warpFamilyCompetitor_old_forwardLimit_exists_stage
      F M.K M.path M.chain M.disjoint hab with ⟨m, hstage⟩
  let N := max n m
  have hactiveN : M.source i x ∈ M.active N i :=
    M.active_mono i (Nat.le_max_left n m) hactive
  have hstageN : WarpFamilyCompetitor
      (competitorWarpFamily F
        (forwardWarpFamilyStage M.K M.path M.disjoint N))
      (M.source i x) b :=
    warpFamilyCompetitor_old_forwardStage_mono
      F M.K M.path M.chain M.disjoint (Nat.le_max_right n m) hstage
  exact M.active_subset_source (N + 1) i
    (M.competitor_succ N i x hactiveN b hstageN)

/-- Assertion 9.18: a forward competitor matrix whose column source sets
cover `A₀` yields a clean linkage of all sources after amalgamation with the
old linkage of `A \ A₀`. -/
theorem exists_cleanLinkage
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {G : SimpleGraph V} {A A₀ B : Set V} {F : Warp G}
    (M : ForwardCompetitorMatrix I G A B F)
    (hA₀cover : A₀ ⊆ {a | ∃ i : I, a ∈ M.sourceSet i})
    (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  exact exists_cleanLinkage_of_wellOrdered_competitor_family_closed
    M.sourceSet M.sourceSet_subset_A M.limitWarp M.limitWarp_isLinkage
    M.limitWarp_isSourceClean hA₀cover F hF
    (fun i a ha b hab => M.sourceSet_competitor_closed i ha hab)

end ForwardCompetitorMatrix

/-! ### Restricting the global half-way process to activated sources

In Assertion 9.17 the half-way warp at a finite stage is indexed by all
sources. Only the sources in the current active set are known to have reached
the target; the other components merely end at the current stop-over set.
Assertion 9.18 restricts a column to sources activated at some finite stage.
The following interface and restriction theorem make that step explicit. -/

/-- A competitor witness is preserved when every path of one indexed warp
family is included, with the same underlying long path, in another family. -/
theorem warpFamilyCompetitor_mono_paths
    {J V : Type} {G : SimpleGraph V} {W Z : J → Warp G}
    (e : ∀ j, (W j).ι → (Z j).ι)
    (he : ∀ j i, (W j).path i = (Z j).path (e j i))
    {a b : V} (h : WarpFamilyCompetitor W a b) :
    WarpFamilyCompetitor Z a b := by
  rcases h with ⟨d⟩
  refine ⟨{
    leftWarp := d.leftWarp
    leftPath := e d.leftWarp d.leftPath
    rightWarp := d.rightWarp
    rightPath := e d.rightWarp d.rightPath
    left_initial := by simpa [← he] using d.left_initial
    right_initial := by simpa [← he] using d.right_initial
    leftIndex := d.leftIndex
    leftActive := by simpa [← he] using d.leftActive
    rightIndex := d.rightIndex
    rightActive := by simpa [← he] using d.rightActive
    meet := by simpa [← he] using d.meet }⟩

/-- Finite-stage data supplied by the half-way-linkage construction in
Assertion 9.17. Each column is a forward chain of global source-indexed
warps. The set `active n i` records the sources whose components have already
reached `B`. Once active, the terminal persists. -/
structure GlobalForwardCompetitorProcess (I : Type) {V : Type}
    (G : SimpleGraph V) (A B : Set V) (F : Warp G) where
  path : ℕ → I → A → LongPath G
  chain : ∀ (i : I) (a : A) ⦃n m : ℕ⦄,
    n ≤ m → (path n i a).Forward (path m i a)
  disjoint : ∀ (n : ℕ) (i : I), Pairwise fun a b =>
    Disjoint (path n i a).vertexSet (path n i b).vertexSet
  initial : ∀ (n : ℕ) (i : I) (a : A),
    (path n i a).initial = a
  clean : ∀ (n : ℕ) (i : I),
    (forwardWarpFamilyStage (fun _ : I => A) path disjoint n i).IsSourceClean A
  active : ℕ → I → Set V
  active_mono : ∀ (i : I) ⦃n m : ℕ⦄,
    n ≤ m → active n i ⊆ active m i
  active_subset_A : ∀ (n : ℕ) (i : I), active n i ⊆ A
  active_has_terminal : ∀ (n : ℕ) (i : I) (a : A),
    a.1 ∈ active n i →
      ∃ b, b ∈ B ∧ ∀ m, n ≤ m → (path m i a).terminal? = some b
  competitor_succ : ∀ (n : ℕ) (i : I) (a : A),
    a.1 ∈ active n i → ∀ b,
      WarpFamilyCompetitor
        (competitorWarpFamily F
          (forwardWarpFamilyStage (fun _ : I => A) path disjoint n))
        a.1 b →
      b ∈ active (n + 1) i

namespace GlobalForwardCompetitorProcess

/-- Sources in a column which are active at at least one finite stage. -/
def ActivatedSource {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (P : GlobalForwardCompetitorProcess I G A B F)
    (i : I) :=
  {a : A // ∃ n, a.1 ∈ P.active n i}

/-- Forget the activation witness attached to an activated source. -/
def restrictedPath {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (P : GlobalForwardCompetitorProcess I G A B F)
    (n : ℕ) (i : I) (a : P.ActivatedSource i) : LongPath G :=
  P.path n i a.1

theorem restricted_disjoint {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (P : GlobalForwardCompetitorProcess I G A B F)
    (n : ℕ) (i : I) : Pairwise fun a b : P.ActivatedSource i =>
      Disjoint (P.restrictedPath n i a).vertexSet
        (P.restrictedPath n i b).vertexSet := by
  intro a b hab
  apply P.disjoint n i
  intro h
  apply hab
  exact Subtype.ext h

/-- The restricted stage embeds path-for-path in the corresponding global
half-way stage. -/
def restrictedStageEmbedding {I V : Type} {G : SimpleGraph V}
    {A B : Set V} {F : Warp G}
    (P : GlobalForwardCompetitorProcess I G A B F) (n : ℕ) :
    ∀ j : Option I,
      (competitorWarpFamily F
        (forwardWarpFamilyStage P.ActivatedSource P.restrictedPath
          P.restricted_disjoint n) j).ι →
      (competitorWarpFamily F
        (forwardWarpFamilyStage (fun _ : I => A) P.path P.disjoint n) j).ι
  | none => id
  | some _ => fun a => a.1

theorem restrictedStageEmbedding_path {I V : Type} {G : SimpleGraph V}
    {A B : Set V} {F : Warp G}
    (P : GlobalForwardCompetitorProcess I G A B F) (n : ℕ)
    (j : Option I)
    (x : (competitorWarpFamily F
      (forwardWarpFamilyStage P.ActivatedSource P.restrictedPath
        P.restricted_disjoint n) j).ι) :
    (competitorWarpFamily F
      (forwardWarpFamilyStage P.ActivatedSource P.restrictedPath
        P.restricted_disjoint n) j).path x =
    (competitorWarpFamily F
      (forwardWarpFamilyStage (fun _ : I => A) P.path P.disjoint n) j).path
      (P.restrictedStageEmbedding n j x) := by
  cases j <;> rfl

/-- Restricting every half-way warp to eventually activated sources turns the
global process of Assertion 9.17 into the fixed-index matrix consumed by
Assertion 9.18. -/
noncomputable def toForwardCompetitorMatrix
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (P : GlobalForwardCompetitorProcess I G A B F) :
    ForwardCompetitorMatrix I G A B F where
  K := P.ActivatedSource
  source := fun _ a => a.1
  path := P.restrictedPath
  chain := fun i a _ _ hnm => P.chain i a.1 hnm
  disjoint := P.restricted_disjoint
  initial := fun n i a => P.initial n i a.1
  active := P.active
  active_mono := P.active_mono
  active_subset_source := by
    intro n i v hv
    have hvA : v ∈ A := P.active_subset_A n i hv
    exact ⟨⟨⟨v, hvA⟩, n, hv⟩, rfl⟩
  active_subset_A := P.active_subset_A
  activated := by
    intro i a
    exact a.2
  eventual_terminal := by
    intro i a
    rcases a.2 with ⟨n, hn⟩
    rcases P.active_has_terminal n i a.1 hn with ⟨b, hb, hterm⟩
    exact ⟨n, b, hb, hterm⟩
  clean := by
    intro n i a v hv hvA
    exact P.clean n i a.1 v hv hvA
  competitor_succ := by
    intro n i a ha b hab
    apply P.competitor_succ n i a.1 ha b
    exact warpFamilyCompetitor_mono_paths
      (P.restrictedStageEmbedding n)
      (P.restrictedStageEmbedding_path n) hab

@[simp] theorem toForwardCompetitorMatrix_sourceSet
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (P : GlobalForwardCompetitorProcess I G A B F) (i : I) :
    (P.toForwardCompetitorMatrix.sourceSet i) =
      {a | a ∈ A ∧ ∃ n, a ∈ P.active n i} := by
  ext a
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨x.1.property, x.2⟩
  · rintro ⟨ha, n, hn⟩
    exact ⟨⟨⟨a, ha⟩, n, hn⟩, rfl⟩

/-- Assertions 9.17--9.18 with the restriction step discharged. -/
theorem exists_cleanLinkage
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {G : SimpleGraph V} {A A₀ B : Set V} {F : Warp G}
    (P : GlobalForwardCompetitorProcess I G A B F)
    (hA₀cover : A₀ ⊆ {a | ∃ i : I, ∃ n, a ∈ P.active n i})
    (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  apply P.toForwardCompetitorMatrix.exists_cleanLinkage _ hF
  intro a ha
  rcases hA₀cover ha with ⟨i, n, hn⟩
  refine ⟨i, ?_⟩
  rw [P.toForwardCompetitorMatrix_sourceSet]
  exact ⟨P.active_subset_A n i hn, n, hn⟩

end GlobalForwardCompetitorProcess

/-! ### The finite successor recursion of Assertion 9.17 -/

/-- One global half-way stage before the countable competitor closure is
iterated. Paths belonging to active sources already terminate in `B`. -/
structure GlobalForwardStage (I : Type) {V : Type} (G : SimpleGraph V)
    (A B : Set V) where
  path : I → A → LongPath G
  disjoint : ∀ i, Pairwise fun a b =>
    Disjoint (path i a).vertexSet (path i b).vertexSet
  initial : ∀ i a, (path i a).initial = a
  clean : ∀ i,
    (Warp.ofPaths (path i) (disjoint i)).IsSourceClean A
  active : I → Set V
  active_subset_A : ∀ i, active i ⊆ A
  active_has_terminal : ∀ i (a : A), a.1 ∈ active i →
    ∃ b ∈ B, (path i a).terminal? = some b

namespace GlobalForwardStage

/-- A valid successor stage. All paths extend forward, active sets grow,
already active paths freeze after reaching `B`, and every current competitor
of an active source is activated at the successor. -/
structure Extends {I V : Type} {G : SimpleGraph V} {A B : Set V}
    (F : Warp G) (S T : GlobalForwardStage I G A B) : Prop where
  path_forward : ∀ i a, (S.path i a).Forward (T.path i a)
  active_mono : ∀ i, S.active i ⊆ T.active i
  active_path_fixed : ∀ i (a : A), a.1 ∈ S.active i →
    T.path i a = S.path i a
  competitor_next : ∀ i (a : A), a.1 ∈ S.active i → ∀ b,
    WarpFamilyCompetitor
      (competitorWarpFamily F (fun j =>
        Warp.ofPaths (S.path j) (S.disjoint j))) a.1 b →
    b ∈ T.active i

/-- Iteration of a chosen half-way successor operator. -/
def iterate {I V : Type} {G : SimpleGraph V} {A B : Set V}
    (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B) :
    ℕ → GlobalForwardStage I G A B
  | 0 => S₀
  | n + 1 => next (iterate S₀ next n)

@[simp] theorem iterate_zero {I V : Type} {G : SimpleGraph V}
    {A B : Set V} (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B) :
    iterate S₀ next 0 = S₀ := rfl

@[simp] theorem iterate_succ {I V : Type} {G : SimpleGraph V}
    {A B : Set V} (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B)
    (n : ℕ) :
    iterate S₀ next (n + 1) = next (iterate S₀ next n) := rfl

theorem iterate_path_forward
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B)
    (hnext : ∀ S, Extends F S (next S))
    (i : I) (a : A) ⦃n m : ℕ⦄ (hnm : n ≤ m) :
    ((iterate S₀ next n).path i a).Forward
      ((iterate S₀ next m).path i a) := by
  induction m, hnm using Nat.le_induction with
  | base => exact LongPath.Forward.refl _
  | succ m hnm ih =>
      rw [iterate_succ]
      exact LongPath.Forward.trans ih
        ((hnext (iterate S₀ next m)).path_forward i a)

theorem iterate_active_mono
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B)
    (hnext : ∀ S, Extends F S (next S))
    (i : I) ⦃n m : ℕ⦄ (hnm : n ≤ m) :
    (iterate S₀ next n).active i ⊆ (iterate S₀ next m).active i := by
  induction m, hnm using Nat.le_induction with
  | base => exact fun _ => id
  | succ m hnm ih =>
      rw [iterate_succ]
      exact Set.Subset.trans ih
        ((hnext (iterate S₀ next m)).active_mono i)

theorem iterate_path_eq_of_active
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B)
    (hnext : ∀ S, Extends F S (next S))
    (i : I) (a : A) ⦃n m : ℕ⦄ (hnm : n ≤ m)
    (ha : a.1 ∈ (iterate S₀ next n).active i) :
    (iterate S₀ next m).path i a = (iterate S₀ next n).path i a := by
  induction m, hnm using Nat.le_induction with
  | base => rfl
  | succ m hnm ih =>
      rw [iterate_succ]
      rw [(hnext (iterate S₀ next m)).active_path_fixed i a
        (iterate_active_mono S₀ next hnext i hnm ha)]
      exact ih

/-- A local successor theorem produces the entire global process required by
the matrix restriction theorem. -/
noncomputable def processOfSuccessor
    {I V : Type} {G : SimpleGraph V} {A B : Set V} (F : Warp G)
    (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B)
    (hnext : ∀ S, Extends F S (next S)) :
    GlobalForwardCompetitorProcess I G A B F where
  path := fun n => (iterate S₀ next n).path
  chain := fun i a _ _ hnm => iterate_path_forward S₀ next hnext i a hnm
  disjoint := fun n => (iterate S₀ next n).disjoint
  initial := fun n => (iterate S₀ next n).initial
  clean := fun n => (iterate S₀ next n).clean
  active := fun n => (iterate S₀ next n).active
  active_mono := fun i _ _ hnm => iterate_active_mono S₀ next hnext i hnm
  active_subset_A := fun n => (iterate S₀ next n).active_subset_A
  active_has_terminal := by
    intro n i a ha
    rcases (iterate S₀ next n).active_has_terminal i a ha with
      ⟨b, hb, hterm⟩
    refine ⟨b, hb, ?_⟩
    intro m hnm
    rw [iterate_path_eq_of_active S₀ next hnext i a hnm ha]
    exact hterm
  competitor_succ := by
    intro n i a ha b hab
    exact (hnext (iterate S₀ next n)).competitor_next i a ha b hab

/-- The initial active rows and successor operator imply the singular
extension conclusion once those rows cover `A₀`. -/
theorem exists_cleanLinkage_of_successor
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {G : SimpleGraph V} {A A₀ B : Set V} {F : Warp G}
    (S₀ : GlobalForwardStage I G A B)
    (next : GlobalForwardStage I G A B → GlobalForwardStage I G A B)
    (hnext : ∀ S, Extends F S (next S))
    (hcover : A₀ ⊆ {a | ∃ i : I, a ∈ S₀.active i})
    (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  let P := processOfSuccessor F S₀ next hnext
  apply P.exists_cleanLinkage _ hF
  intro a ha
  rcases hcover ha with ⟨i, hi⟩
  exact ⟨i, 0, hi⟩

end GlobalForwardStage

namespace GlobalForwardStage

/-- A sequence whose consecutive terms satisfy `Extends` has pointwise
forward paths at every pair of comparable natural-number stages. -/
theorem sequence_path_forward
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S : ℕ → GlobalForwardStage I G A B)
    (hsucc : ∀ n, Extends F (S n) (S (n + 1)))
    (i : I) (a : A) ⦃n m : ℕ⦄ (hnm : n ≤ m) :
    (S n).path i a |>.Forward ((S m).path i a) := by
  induction m, hnm using Nat.le_induction with
  | base => exact LongPath.Forward.refl _
  | succ m _ ih => exact ih.trans ((hsucc m).path_forward i a)

theorem sequence_active_mono
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S : ℕ → GlobalForwardStage I G A B)
    (hsucc : ∀ n, Extends F (S n) (S (n + 1)))
    (i : I) ⦃n m : ℕ⦄ (hnm : n ≤ m) :
    (S n).active i ⊆ (S m).active i := by
  induction m, hnm using Nat.le_induction with
  | base => exact fun _ => id
  | succ m _ ih => exact ih.trans ((hsucc m).active_mono i)

theorem sequence_path_eq_of_active
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S : ℕ → GlobalForwardStage I G A B)
    (hsucc : ∀ n, Extends F (S n) (S (n + 1)))
    (i : I) (a : A) ⦃n m : ℕ⦄ (hnm : n ≤ m)
    (ha : a.1 ∈ (S n).active i) :
    (S m).path i a = (S n).path i a := by
  induction m, hnm using Nat.le_induction with
  | base => rfl
  | succ m hnm ih =>
      rw [(hsucc m).active_path_fixed i a
        (sequence_active_mono S hsucc i hnm ha)]
      exact ih

/-- Sequence form of the finite-stage process constructor.  This avoids
forcing a successor operation to forget auxiliary data retained by a stage. -/
noncomputable def processOfSequence
    {I V : Type} {G : SimpleGraph V} {A B : Set V} (F : Warp G)
    (S : ℕ → GlobalForwardStage I G A B)
    (hsucc : ∀ n, Extends F (S n) (S (n + 1))) :
    GlobalForwardCompetitorProcess I G A B F where
  path := fun n => (S n).path
  chain := fun i a _ _ hnm => sequence_path_forward S hsucc i a hnm
  disjoint := fun n => (S n).disjoint
  initial := fun n => (S n).initial
  clean := fun n => (S n).clean
  active := fun n => (S n).active
  active_mono := fun i _ _ hnm => sequence_active_mono S hsucc i hnm
  active_subset_A := fun n => (S n).active_subset_A
  active_has_terminal := by
    intro n i a ha
    rcases (S n).active_has_terminal i a ha with ⟨b, hb, hterm⟩
    refine ⟨b, hb, ?_⟩
    intro m hnm
    rw [sequence_path_eq_of_active S hsucc i a hnm ha]
    exact hterm
  competitor_succ := by
    intro n i a ha b hab
    exact (hsucc n).competitor_next i a ha b hab

/-- The sequence version of Assertions 9.17--9.18. -/
theorem exists_cleanLinkage_of_sequence
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {G : SimpleGraph V} {A A₀ B : Set V} {F : Warp G}
    (S : ℕ → GlobalForwardStage I G A B)
    (hsucc : ∀ n, Extends F (S n) (S (n + 1)))
    (hcover : A₀ ⊆ {a | ∃ i : I, a ∈ (S 0).active i})
    (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  let P := processOfSequence F S hsucc
  apply P.exists_cleanLinkage _ hF
  intro a ha
  rcases hcover ha with ⟨i, hi⟩
  exact ⟨i, 0, hi⟩

end GlobalForwardStage

/-! ### Clean half-way linkages

Definition 9.1 packages the object advanced at every finite stage of the
singular recursion.  Its stop-over is an inclusion-minimal separator, the
warp links every old source to that stop-over, and the quotient beyond the
stop-over is unhindered.  A distinguished subset of sources has already
been carried all the way to the original target. -/

/-- Every vertex of an inclusion-minimal separator is exposed. -/
theorem essentialVertices_eq_of_minimal_separator
    {V : Type} {G : SimpleGraph V} {A B C : Set V}
    (hC : Minimal (Separates G A B) C) :
    essentialVertices G B C = C := by
  classical
  apply Set.Subset.antisymm
  · exact essentialVertices_subset G B C
  · intro c hc
    rcases MinimalSeparator.exists_path_meeting_only hC hc with
      ⟨p, hcp, hpOnly⟩
    rw [mem_essentialVertices_iff]
    refine ⟨hc, p.right, p.right_mem,
      p.walk.dropUntil c hcp, p.isPath.dropUntil hcp, ?_⟩
    intro x hxDrop hxC
    exact hpOnly x (p.walk.support_dropUntil_subset_support hcp hxDrop) hxC

/-- For a minimal `A`--`B` separator, the source side exposed by quotienting
is exactly the stop-over itself. -/
theorem quotientSource_eq_of_minimal_separator
    {V : Type} {G : SimpleGraph V} {A B C : Set V}
    (hC : Minimal (Separates G A B) C) :
    quotientSource G A B C = C := by
  rw [quotientSource_eq_essentialVertices_of_subset_roof
    (separates_iff_subset_roof.mp hC.prop),
    essentialVertices_eq_of_minimal_separator hC]

/-- A separator in the quotient lifts to a separator in the ambient graph.
The last point of the old roof on a proposed ambient path is exposed and its
remaining suffix lies in the quotient. -/
theorem separates_of_quotient_separator
    {V : Type} {G : SimpleGraph V} {A B C D : Set V}
    (hD : Separates (outsideGraph G (interiorRoof G B C))
      (quotientSource G A B C) B D) :
    Separates G A B D := by
  classical
  intro a ha b hb q hq
  by_cases hmeet : ∃ z ∈ q.support, z ∈ roof G B C
  · rcases exists_last_roof_index q hmeet with
      ⟨n, hnle, hnRoof, hnBoundary, hnlast⟩
    let z := q.getVert n
    have hzEssential : z ∈ essentialVertices G B C := by
      rcases hnBoundary with hzEssential | hnEnd
      · simpa [z] using hzEssential
      · have hzb : z = b := by simpa [z, hnEnd]
        have hbOutside : b ∉ interiorRoof G B C := by
          intro hbInterior
          exact Set.disjoint_left.mp (target_disjoint_interiorRoof G B C)
            hb hbInterior
        change z ∈ roof G B C at hnRoof
        rw [hzb] at hnRoof ⊢
        by_contra hbNotEssential
        exact hbOutside ⟨hnRoof, hbNotEssential⟩
    have hsuffixOutside :
        ∀ y ∈ (q.drop n).support, y ∉ interiorRoof G B C := by
      intro y hy (hyInterior : y ∈ interiorRoof G B C)
      rcases Walk.mem_support_iff_exists_getVert.mp hy with ⟨m, hym, hmle⟩
      have hnmle : n + m ≤ q.length := by
        rw [Walk.drop_length] at hmle
        omega
      have hyGet : q.getVert (n + m) = y := by
        rw [← q.drop_getVert n m]
        exact hym
      by_cases hm0 : m = 0
      · subst m
        have hyz : y = z := by simpa [z] using hyGet.symm
        exact Set.disjoint_left.mp (interiorRoof_disjoint G B C)
          (hyz ▸ hyInterior) hzEssential
      · have hnotRoof : q.getVert (n + m) ∉ roof G B C :=
          hnlast (n + m) hnmle (by omega)
        rw [hyGet] at hnotRoof
        exact hnotRoof hyInterior.1
    let r := Erdos599.Walk.toOutsideGraph (q.drop n) hsuffixOutside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph (hq.drop n) hsuffixOutside
    have hzSource : z ∈ quotientSource G A B C := by
      rw [quotientSource_eq]
      exact Or.inr hzEssential
    rcases hD z hzSource b hb r hrPath with ⟨t, htr, htD⟩
    have htq : t ∈ q.support := by
      have htdrop : t ∈ (q.drop n).support := by simpa [r] using htr
      exact (q.isSubwalk_drop n).support_subset htdrop
    exact ⟨t, htq, htD⟩
  · have houtside : ∀ z ∈ q.support, z ∉ interiorRoof G B C := by
      intro z hzq hzInterior
      exact hmeet ⟨z, hzq, hzInterior.1⟩
    let r := Erdos599.Walk.toOutsideGraph q houtside
    have hrPath : r.IsPath :=
      Erdos599.Walk.isPath_toOutsideGraph hq houtside
    have haSource : a ∈ quotientSource G A B C := by
      refine ⟨Or.inl ha, ?_⟩
      intro haInterior
      exact hmeet ⟨a, q.start_mem_support, haInterior.1⟩
    rcases hD a haSource b hb r hrPath with ⟨t, htr, htD⟩
    exact ⟨t, by simpa [r] using htr, htD⟩

/-- The prefix through the unique `C`-vertex of a private path lies under
the roof of `C`. -/
theorem privatePrefix_subset_roof
    {V : Type} [DecidableEq V] {G : SimpleGraph V} {A B C : Set V}
    (hC : Separates G A B C) (p : ABPath G A B) {c : V}
    (hcp : c ∈ p.walk.support)
    (hpOnly : ∀ v ∈ p.walk.support, v ∈ C → v = c) :
    ∀ x ∈ (p.walk.takeUntil c hcp).support, x ∈ roof G B C := by
  have hcC : c ∈ C := by
    rcases hC p.left p.left_mem p.right p.right_mem p.walk p.isPath with
      ⟨z, hzP, hzC⟩
    exact hpOnly z hzP hzC ▸ hzC
  intro x hx b hb q hq
  by_contra hno
  push Not at hno
  have hxP : x ∈ p.walk.support :=
    p.walk.support_takeUntil_subset_support hcp hx
  have hxc : x ≠ c := by
    intro hxc
    subst x
    exact hno c q.start_mem_support hcC
  let pref : G.Walk p.left x := p.walk.takeUntil x hxP
  have hcNotPref : c ∉ pref.support := by
    exact p.walk.notMem_support_takeUntil_support_takeUntil_subset
      hxc hcp hx
  let combined : G.Walk p.left b := pref.append q
  let r : G.Path p.left b := combined.toPath
  rcases hC p.left p.left_mem b hb (r : G.Walk p.left b) r.property with
    ⟨z, hzr, hzC⟩
  have hzCombined : z ∈ combined.support :=
    combined.support_toPath_subset_support hzr
  rw [show combined = pref.append q by rfl,
    pref.support_append_eq_support_dropLast_append q] at hzCombined
  rcases List.mem_append.mp hzCombined with hzPref | hzq
  · have hzP : z ∈ p.vertices :=
      p.walk.support_takeUntil_subset_support hxP
        (List.mem_of_mem_dropLast hzPref)
    have hzc : z = c := hpOnly z hzP hzC
    exact hcNotPref (hzc ▸ List.mem_of_mem_dropLast hzPref)
  · exact hno z hzq hzC

/-- A minimal separator in the quotient contains no vertex deleted by the
first quotient. -/
theorem minimalSeparator_disjoint_quotientInterior
    {V : Type} {G : SimpleGraph V} {A B C D : Set V}
    (hD : Minimal
      (Separates (outsideGraph G (interiorRoof G B C))
        (quotientSource G A B C) B) D) :
    Disjoint D (interiorRoof G B C) := by
  classical
  rw [Set.disjoint_left]
  intro d hdD hdInterior
  rcases MinimalSeparator.exists_path_meeting_only hD hdD with
    ⟨p, hdp, _hpOnly⟩
  have hstartOutside : p.left ∉ interiorRoof G B C := p.left_mem.2
  exact (Erdos599.Walk.vertex_not_mem_of_outsideGraph
    p.walk hstartOutside hdp) hdInterior

/-- Minimal stop-overs compose through a quotient. -/
theorem minimalSeparator_of_quotient
    {V : Type} {G : SimpleGraph V} {A B C D : Set V}
    (hC : Minimal (Separates G A B) C)
    (hD : Minimal
      (Separates (outsideGraph G (interiorRoof G B C))
        (quotientSource G A B C) B) D) :
    Minimal (Separates G A B) D := by
  classical
  have hsource : quotientSource G A B C = C :=
    quotientSource_eq_of_minimal_separator hC
  refine ⟨separates_of_quotient_separator hD.prop, ?_⟩
  intro T hT hTD
  apply hD.2
  · intro c hcSource b hb q hq
    have hcC : c ∈ C := by simpa [hsource] using hcSource
    rcases MinimalSeparator.exists_path_meeting_only hC hcC with
      ⟨p, hcp, hpOnly⟩
    let pref : G.Walk p.left c := p.walk.takeUntil c hcp
    let qG : G.Walk c b :=
      q.mapLe (outsideGraph_le G (interiorRoof G B C))
    let combined : G.Walk p.left b := pref.append qG
    let r : G.Path p.left b := combined.toPath
    rcases hT p.left p.left_mem b hb (r : G.Walk p.left b) r.property with
      ⟨x, hxr, hxT⟩
    have hxCombined : x ∈ combined.support :=
      combined.support_toPath_subset_support hxr
    rw [show combined = pref.append qG by rfl,
      pref.support_append_eq_support_dropLast_append qG] at hxCombined
    rcases List.mem_append.mp hxCombined with hxPref | hxqG
    · have hxPref' : x ∈ pref.support := List.mem_of_mem_dropLast hxPref
      have hxRoofC : x ∈ roof G B C := by
        exact privatePrefix_subset_roof hC.prop p hcp hpOnly x hxPref'
      have hxD : x ∈ D := hTD hxT
      have hxOutside : x ∉ interiorRoof G B C := fun hxInterior =>
        Set.disjoint_left.mp (minimalSeparator_disjoint_quotientInterior hD)
          hxD hxInterior
      have hxEssential : x ∈ essentialVertices G B C := by
        by_contra hxNotEssential
        exact hxOutside ⟨hxRoofC, hxNotEssential⟩
      have hxc : x = c := hpOnly x
        (p.walk.support_takeUntil_subset_support hcp hxPref')
        (essentialVertices_subset G B C hxEssential)
      refine ⟨c, q.start_mem_support, ?_⟩
      exact hxc ▸ hxT
    · exact ⟨x, by simpa [qG, Walk.support_mapLe_eq_support] using hxqG,
        hxT⟩
  · exact hTD

/-- The source-clean form of Aharoni--Berger's half-way linkage.  `active`
records the old sources whose components already end in the original target
`B`; other components end only at the current minimal stop-over. -/
structure CleanHalfWayLinkage {V : Type} (G : SimpleGraph V)
    (A B active : Set V) where
  stop : Set V
  warp : Warp G
  isLinkage : warp.IsLinkage A stop
  sourceClean : warp.IsSourceClean A
  vertexSet_subset_roof : warp.vertexSet ⊆ roof G B stop
  stopClean : ∀ i v, v ∈ (warp.path i).vertexSet → v ∈ stop →
    (warp.path i).terminal? = some v
  stop_minimal : Minimal (Separates G A B) stop
  quotient_unhindered : Warp.IsCleanUnhindered
    (outsideGraph G (interiorRoof G B stop))
    (quotientSource G A B stop) B
  active_subset : active ⊆ A
  active_endsIn : ∀ (a : A), a.1 ∈ active →
    ∃ b ∈ B, (linkagePathAt warp isLinkage a).terminal? = some b

namespace CleanHalfWayLinkage

/-- A clean linkage in the quotient beyond a half-way stop-over attaches to
every old component.  The resulting arrow warp is a clean ambient linkage.
This is the finite-path composition used at every successor stage of
Assertion 9.17. -/
theorem arrow_isCleanLinkage
    {V : Type} {G : SimpleGraph V} {A B active D : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (U : Warp (outsideGraph G (interiorRoof G B H.stop)))
    (hU : U.IsLinkage (quotientSource G A B H.stop) D)
    (hUclean : U.IsSourceClean (quotientSource G A B H.stop)) :
    (Warp.arrow H.warp
      (U.mapLE (outsideGraph_le G (interiorRoof G B H.stop)))).IsCleanLinkage
        A D := by
  classical
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  have hsource : quotientSource G A B H.stop = H.stop :=
    quotientSource_eq_of_minimal_separator H.stop_minimal
  have hUstart : U.IsStarting (quotientSource G A B H.stop) :=
    hU.isStarting
  have hUstartEssential :
      U.IsStarting (essentialVertices G B H.stop) := by
    simpa [hsource, essentialVertices_eq_of_minimal_separator H.stop_minimal]
      using hUstart
  have hExterior : Disjoint U.vertexSet (interiorRoof G B H.stop) :=
    Warp.vertexSet_disjoint_interior_of_outside_starting hUstartEssential
  have extension (i : H.warp.ι) : Nonempty (Warp.ExtensionData H.warp U' i) := by
    rcases H.isLinkage.2 i with ⟨c, hcStop, hic⟩
    rcases LongPath.terminal?_eq_some_iff.mp hic with
      ⟨k, hkFinite, hkVertex⟩
    have hcSource : c ∈ quotientSource G A B H.stop := by
      rw [hsource]
      exact hcStop
    have hcInitial : c ∈ U.initialSet := by
      rw [hU.1]
      exact hcSource
    let j := U.sourceIndex hcInitial
    have hjZero : longPathActive (U'.path j).terminalIndex 0 := by
      cases (U'.path j).terminalIndex <;> simp [longPathActive]
    refine ⟨{
      endIndex := k
      finite := hkFinite
      carrier := j
      meetIndex := 0
      meetActive := hjZero
      join := by
        change (U.path j).vertex 0 = (H.warp.path i).vertex k
        calc
          (U.path j).vertex 0 = (U.path j).initial := rfl
          _ = c := U.initial_sourceIndex hcInitial
          _ = (H.warp.path i).vertex k := hkVertex.symm
      avoidsOld := by
        rintro x ⟨hxTail, hxOld⟩
        have hxMapped : x ∈ (U'.path j).vertexSet :=
          (U'.path j).vertexSet_tail_subset 0 hjZero hxTail
        have hxUPath : x ∈ (U.path j).vertexSet := hxMapped
        have hxU : x ∈ U.vertexSet := ⟨j, hxUPath⟩
        have hxOutside : x ∉ interiorRoof G B H.stop := by
          intro hxInterior
          exact Set.disjoint_left.mp hExterior hxU hxInterior
        have hxRoof : x ∈ roof G B H.stop :=
          H.vertexSet_subset_roof hxOld
        have hxEssential : x ∈ essentialVertices G B H.stop := by
          by_contra hxNotEssential
          exact hxOutside ⟨hxRoof, hxNotEssential⟩
        have hxSource : x ∈ quotientSource G A B H.stop := by
          rw [hsource]
          exact essentialVertices_subset G B H.stop hxEssential
        have hxInitial : x = (U.path j).initial :=
          hUclean j x hxUPath hxSource
        exact Set.mem_singleton_iff.mpr
          (calc
            x = (U.path j).initial := hxInitial
            _ = c := by simpa [j] using U.initial_sourceIndex hcInitial
            _ = (H.warp.path i).vertex k := hkVertex.symm) }⟩
  have hUcleanA : U'.IsSourceClean A := by
    intro j x hxPath hxA
    have hxU : x ∈ U.vertexSet := ⟨j, hxPath⟩
    have hxOutside : x ∉ interiorRoof G B H.stop := by
      intro hxInterior
      exact Set.disjoint_left.mp hExterior hxU hxInterior
    have hxSource : x ∈ quotientSource G A B H.stop :=
      ⟨Or.inl hxA, hxOutside⟩
    exact hUclean j x hxPath hxSource
  refine ⟨⟨?_, ?_⟩, H.sourceClean.arrow hUcleanA⟩
  · rw [Warp.initialSet_arrow, H.isLinkage.1]
  · intro i
    let d := Classical.choice (extension i)
    rcases hU.2 d.carrier with ⟨z, hzD, hzTerminal⟩
    refine ⟨z, hzD, ?_⟩
    change (Warp.arrowPath H.warp U' i).terminal? = some z
    simp only [Warp.arrowPath, dif_pos (extension i)]
    change d.extendedPath.terminal? = some z
    exact d.terminal?_extendedPath.trans hzTerminal

/-- If an old component ends at the quotient source `c` and the canonical
quotient component from `c` ends at `b`, then the corresponding arrow
component also ends at `b`. -/
theorem arrowPath_terminal_of_quotient_source
    {V : Type} {G : SimpleGraph V} {A B active D : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (U : Warp (outsideGraph G (interiorRoof G B H.stop)))
    (hU : U.IsLinkage (quotientSource G A B H.stop) D)
    (hUclean : U.IsSourceClean (quotientSource G A B H.stop))
    (i : H.warp.ι) {c b : V}
    (hic : (H.warp.path i).terminal? = some c)
    (hcSource : c ∈ quotientSource G A B H.stop)
    (hb : (U.path (U.sourceIndex (by rw [hU.1]; exact hcSource))).terminal? =
      some b) :
    (Warp.arrowPath H.warp
      (U.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) i).terminal? =
      some b := by
  classical
  let U' := U.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  have hsource : quotientSource G A B H.stop = H.stop :=
    quotientSource_eq_of_minimal_separator H.stop_minimal
  have hUstartEssential : U.IsStarting
      (essentialVertices G B H.stop) := by
    simpa [hsource, essentialVertices_eq_of_minimal_separator H.stop_minimal]
      using hU.isStarting
  have hExterior : Disjoint U.vertexSet (interiorRoof G B H.stop) :=
    Warp.vertexSet_disjoint_interior_of_outside_starting hUstartEssential
  rcases LongPath.terminal?_eq_some_iff.mp hic with
    ⟨k, hkFinite, hkVertex⟩
  let j := U.sourceIndex (by rw [hU.1]; exact hcSource)
  have hjZero : longPathActive (U'.path j).terminalIndex 0 := by
    cases (U'.path j).terminalIndex <;> simp [longPathActive]
  let d : Warp.ExtensionData H.warp U' i := {
    endIndex := k
    finite := hkFinite
    carrier := j
    meetIndex := 0
    meetActive := hjZero
    join := by
      change (U.path j).vertex 0 = (H.warp.path i).vertex k
      calc
        (U.path j).vertex 0 = (U.path j).initial := rfl
        _ = c := U.initial_sourceIndex (by rw [hU.1]; exact hcSource)
        _ = (H.warp.path i).vertex k := hkVertex.symm
    avoidsOld := by
      rintro x ⟨hxTail, hxOld⟩
      have hxMapped : x ∈ (U'.path j).vertexSet :=
        (U'.path j).vertexSet_tail_subset 0 hjZero hxTail
      have hxUPath : x ∈ (U.path j).vertexSet := hxMapped
      have hxU : x ∈ U.vertexSet := ⟨j, hxUPath⟩
      have hxOutside : x ∉ interiorRoof G B H.stop := by
        intro hxInterior
        exact Set.disjoint_left.mp hExterior hxU hxInterior
      have hxRoof : x ∈ roof G B H.stop :=
        H.vertexSet_subset_roof hxOld
      have hxEssential : x ∈ essentialVertices G B H.stop := by
        by_contra hxNotEssential
        exact hxOutside ⟨hxRoof, hxNotEssential⟩
      have hxSource : x ∈ quotientSource G A B H.stop := by
        rw [hsource]
        exact essentialVertices_subset G B H.stop hxEssential
      have hxInitial : x = (U.path j).initial :=
        hUclean j x hxUPath hxSource
      exact Set.mem_singleton_iff.mpr
        (calc
          x = (U.path j).initial := hxInitial
          _ = c := by simpa [j] using
            U.initial_sourceIndex (by rw [hU.1]; exact hcSource)
          _ = (H.warp.path i).vertex k := hkVertex.symm) }
  let hex : Nonempty (Warp.ExtensionData H.warp U' i) := ⟨d⟩
  let chosen := Classical.choice hex
  have hcarrier : chosen.carrier = d.carrier := chosen.carrier_eq d
  change (Warp.arrowPath H.warp U' i).terminal? = some b
  rw [show Warp.arrowPath H.warp U' i = chosen.extendedPath by
    simp [Warp.arrowPath, hex, chosen]]
  rw [chosen.terminal?_extendedPath]
  change (U.path chosen.carrier).terminal? = some b
  simpa [hcarrier, d, j] using hb

/-- Advance an old half-way component along another warp, except that a
component which has already reached `B` is frozen.  Freezing is required in
the symmetric graph encoding of a directed web, where the paper's convention
"no edge leaves `B`" is not definitionally present. -/
noncomputable def advancePath
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G) (a : A) :
    LongPath G := by
  classical
  have haInitial : a.1 ∈ H.warp.initialSet := by
    rw [H.isLinkage.1]
    exact a.property
  exact if a.1 ∈ active then
      linkagePathAt H.warp H.isLinkage a
    else
      Warp.arrowPath H.warp U (H.warp.sourceIndex haInitial)

@[simp] theorem advancePath_initial
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G) (a : A) :
    (advancePath H U a).initial = a := by
  classical
  simp only [advancePath]
  split_ifs
  · exact linkagePathAt_initial H.warp H.isLinkage a
  · rw [Warp.initial_arrowPath]
    apply H.warp.initial_sourceIndex

theorem linkagePathAt_forward_advancePath
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G) (a : A) :
    (linkagePathAt H.warp H.isLinkage a).Forward
      (advancePath H U a) := by
  classical
  simp only [advancePath]
  split_ifs
  · exact LongPath.Forward.refl _
  · unfold linkagePathAt
    exact Warp.forward_arrowPath H.warp U _

theorem advancePath_eq_of_active
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G) (a : A)
    (ha : a.1 ∈ active) :
    advancePath H U a = linkagePathAt H.warp H.isLinkage a := by
  simp [advancePath, ha]

theorem advancePath_vertexSet_subset_arrow
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G) (a : A) :
    (advancePath H U a).vertexSet ⊆
      (Warp.arrowPath H.warp U
        (H.warp.sourceIndex (by rw [H.isLinkage.1]; exact a.property))).vertexSet := by
  classical
  simp only [advancePath]
  split_ifs
  · unfold linkagePathAt
    exact Warp.oldPath_vertexSet_subset_arrowPath H.warp U _
  · exact fun _ ↦ id

theorem advancePath_disjoint
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G) :
    Pairwise fun a b : A ↦
      Disjoint (advancePath H U a).vertexSet
        (advancePath H U b).vertexSet := by
  classical
  intro a b hab
  have haInitial : a.1 ∈ H.warp.initialSet := by
    rw [H.isLinkage.1]
    exact a.property
  have hbInitial : b.1 ∈ H.warp.initialSet := by
    rw [H.isLinkage.1]
    exact b.property
  let ia := H.warp.sourceIndex haInitial
  let ib := H.warp.sourceIndex hbInitial
  have hiab : ia ≠ ib := by
    intro hEq
    apply hab
    apply Subtype.ext
    calc
      a.1 = (H.warp.path ia).initial :=
        (H.warp.initial_sourceIndex haInitial).symm
      _ = (H.warp.path ib).initial := by rw [hEq]
      _ = b.1 := H.warp.initial_sourceIndex hbInitial
  have hd := (Warp.arrow H.warp U).disjoint hiab
  change Disjoint (Warp.arrowPath H.warp U ia).vertexSet
    (Warp.arrowPath H.warp U ib).vertexSet at hd
  rw [Set.disjoint_left] at hd ⊢
  intro v hva hvb
  exact hd
    (advancePath_vertexSet_subset_arrow H U a hva)
    (advancePath_vertexSet_subset_arrow H U b hvb)

theorem advancePath_sourceClean
    {V : Type} {G : SimpleGraph V} {A B active : Set V}
    (H : CleanHalfWayLinkage G A B active) (U : Warp G)
    (hUclean : U.IsSourceClean A) :
    (Warp.ofPaths (advancePath H U) (advancePath_disjoint H U)).IsSourceClean A := by
  intro a v hv hvA
  have haInitial : a.1 ∈ H.warp.initialSet := by
    rw [H.isLinkage.1]
    exact a.property
  have hvArrow : v ∈
      (Warp.arrowPath H.warp U (H.warp.sourceIndex haInitial)).vertexSet :=
    advancePath_vertexSet_subset_arrow H U a hv
  have hclean := H.sourceClean.arrow hUclean
  have hvEq : v =
      (Warp.arrowPath H.warp U (H.warp.sourceIndex haInitial)).initial :=
    hclean (H.warp.sourceIndex haInitial) v hvArrow hvA
  calc
    v = (Warp.arrowPath H.warp U
        (H.warp.sourceIndex haInitial)).initial := hvEq
    _ = a.1 := by
      rw [Warp.initial_arrowPath]
      exact H.warp.initial_sourceIndex haInitial
    _ = (advancePath H U a).initial :=
      (advancePath_initial H U a).symm

/-- The old sources selected for the next stage, viewed as the stop-over
vertices at which their present components enter the quotient. -/
def boundaryActive
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active) : Set V :=
  {c | ∃ a : A, a.1 ∈ nextActive ∧
    (linkagePathAt H.warp H.isLinkage a).terminal? = some c}

/-- After a roof-nested quotient linkage is mapped back to the ambient
graph, every frozen or arrow-advanced old component lies below the new
stop-over. -/
theorem advancePath_vertexSet_subset_newRoof
    {V : Type} {G : SimpleGraph V} {A B active Qactive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B Qactive)
    (hCD : H.stop ⊆ roof G B Q.stop) (a : A) :
    (advancePath H
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) a).vertexSet ⊆
      roof G B Q.stop := by
  classical
  let U := Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  intro v hv
  have hvArrow : v ∈
      (Warp.arrowPath H.warp U
        (H.warp.sourceIndex (by rw [H.isLinkage.1]; exact a.property))).vertexSet :=
    advancePath_vertexSet_subset_arrow H U a hv
  simp only [Warp.arrowPath] at hvArrow
  split at hvArrow
  next hExt =>
    let d := Classical.choice hExt
    change v ∈ d.extendedPath.vertexSet at hvArrow
    rw [d.vertexSet_extendedPath] at hvArrow
    rcases hvArrow with hvOld | hvTail
    · rw [← roof_roof G B Q.stop]
      exact roof_mono hCD
        (H.vertexSet_subset_roof ⟨H.warp.sourceIndex
          (by rw [H.isLinkage.1]; exact a.property), hvOld⟩)
    · have hvQ : v ∈ (Q.warp.path d.carrier).vertexSet := by
        exact (Q.warp.path d.carrier).vertexSet_tail_subset
          d.meetIndex d.meetActive hvTail
      have hvQuotientRoof : v ∈
          roof (outsideGraph G (interiorRoof G B H.stop)) B Q.stop :=
        Q.vertexSet_subset_roof ⟨d.carrier, hvQ⟩
      simpa only [roof_outsideGraph_interiorRoof_eq_of_subset_roof hCD] using
        hvQuotientRoof
  next hNoExt =>
    exact (by
      rw [← roof_roof G B Q.stop]
      exact roof_mono hCD
        (H.vertexSet_subset_roof ⟨H.warp.sourceIndex
          (by rw [H.isLinkage.1]; exact a.property), hvArrow⟩))

/-- An arrow-extended component meets the next minimal stop-over only at its
terminal vertex.  This is the path-level cleanliness needed to iterate
half-way linkages. -/
theorem arrowPath_stopClean_newStop
    {V : Type} {G : SimpleGraph V} {A B active Qactive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B Qactive)
    (i : H.warp.ι) (v : V)
    (hv : v ∈ (Warp.arrowPath H.warp
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) i).vertexSet)
    (hvD : v ∈ Q.stop) :
    (Warp.arrowPath H.warp
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) i).terminal? =
      some v := by
  classical
  let U := Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  have hDoutside : v ∉ interiorRoof G B H.stop := by
    intro hvInterior
    exact Set.disjoint_left.mp
      (minimalSeparator_disjoint_quotientInterior Q.stop_minimal)
      hvD hvInterior
  simp only [Warp.arrowPath] at hv ⊢
  by_cases hExt : Nonempty (Warp.ExtensionData H.warp
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) i)
  · simp only [dif_pos hExt] at hv ⊢
    let d := Classical.choice hExt
    change v ∈ d.extendedPath.vertexSet at hv
    change d.extendedPath.terminal? = some v
    rw [d.vertexSet_extendedPath] at hv
    rcases hv with hvOld | hvTail
    · have hvRoof : v ∈ roof G B H.stop :=
        H.vertexSet_subset_roof ⟨i, hvOld⟩
      have hvEssential : v ∈ essentialVertices G B H.stop := by
        by_contra hvNotEssential
        exact hDoutside ⟨hvRoof, hvNotEssential⟩
      have hvC : v ∈ H.stop :=
        essentialVertices_subset G B H.stop hvEssential
      have hOldTerminal : (H.warp.path i).terminal? = some v :=
        H.stopClean i v hvOld hvC
      rcases LongPath.terminal?_eq_some_iff.mp hOldTerminal with
        ⟨k, hkFinite, hkVertex⟩
      have hdk : d.endIndex = k :=
        Option.some.inj (d.finite.symm.trans hkFinite)
      have hvQ : v ∈ (Q.warp.path d.carrier).vertexSet := by
        refine ⟨d.meetIndex, d.meetActive, ?_⟩
        change (Q.warp.path d.carrier).vertex d.meetIndex = v
        calc
          (Q.warp.path d.carrier).vertex d.meetIndex =
              (H.warp.path i).vertex d.endIndex := d.join
          _ = (H.warp.path i).vertex k := by rw [hdk]
          _ = v := hkVertex
      exact d.terminal?_extendedPath.trans
        (Q.stopClean d.carrier v hvQ hvD)
    · have hvQ : v ∈ (Q.warp.path d.carrier).vertexSet :=
        (Q.warp.path d.carrier).vertexSet_tail_subset
          d.meetIndex d.meetActive hvTail
      exact d.terminal?_extendedPath.trans
        (Q.stopClean d.carrier v hvQ hvD)
  · simp only [dif_neg hExt] at hv ⊢
    have hvRoof : v ∈ roof G B H.stop :=
      H.vertexSet_subset_roof ⟨i, hv⟩
    have hvEssential : v ∈ essentialVertices G B H.stop := by
      by_contra hvNotEssential
      exact hDoutside ⟨hvRoof, hvNotEssential⟩
    exact H.stopClean i v hv
      (essentialVertices_subset G B H.stop hvEssential)

/-- Freezing already-active components preserves the preceding stop-clean
property, while every other component inherits it from arrow composition. -/
theorem advancePath_stopClean_newStop
    {V : Type} {G : SimpleGraph V} {A B active Qactive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B Qactive)
    (a : A) (v : V)
    (hv : v ∈ (advancePath H
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) a).vertexSet)
    (hvD : v ∈ Q.stop) :
    (advancePath H
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) a).terminal? =
      some v := by
  classical
  let U := Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  simp only [advancePath] at hv ⊢
  by_cases ha : a.1 ∈ active
  · simp only [if_pos ha] at hv ⊢
    have hDoutside : v ∉ interiorRoof G B H.stop := by
      intro hvInterior
      exact Set.disjoint_left.mp
        (minimalSeparator_disjoint_quotientInterior Q.stop_minimal)
        hvD hvInterior
    have hvRoof : v ∈ roof G B H.stop :=
      H.vertexSet_subset_roof ⟨H.warp.sourceIndex
        (by rw [H.isLinkage.1]; exact a.property), hv⟩
    have hvEssential : v ∈ essentialVertices G B H.stop := by
      by_contra hvNotEssential
      exact hDoutside ⟨hvRoof, hvNotEssential⟩
    exact H.stopClean
      (H.warp.sourceIndex (by rw [H.isLinkage.1]; exact a.property)) v hv
      (essentialVertices_subset G B H.stop hvEssential)
  · simp only [if_neg ha] at hv ⊢
    exact arrowPath_stopClean_newStop H Q
      (H.warp.sourceIndex (by rw [H.isLinkage.1]; exact a.property)) v hv hvD

/-- A source selected for the next active set ends in `B` after the quotient
linkage is attached.  Old active components are frozen; every other selected
source activates the quotient component beginning at its old terminal. -/
theorem advancePath_endsIn_of_mem_nextActive
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B
      (boundaryActive (nextActive := nextActive) H))
    (a : A) (haNext : a.1 ∈ nextActive) :
    ∃ b ∈ B, (advancePath H
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) a).terminal? =
      some b := by
  classical
  by_cases haOld : a.1 ∈ active
  · rcases H.active_endsIn a haOld with ⟨b, hb, hab⟩
    exact ⟨b, hb, by simpa [advancePath, haOld] using hab⟩
  · have haInitial : a.1 ∈ H.warp.initialSet := by
      rw [H.isLinkage.1]
      exact a.property
    let i := H.warp.sourceIndex haInitial
    rcases H.isLinkage.2 i with ⟨c, hcStop, hic⟩
    have hsource : quotientSource G A B H.stop = H.stop :=
      quotientSource_eq_of_minimal_separator H.stop_minimal
    have hcSource : c ∈ quotientSource G A B H.stop := by
      rw [hsource]
      exact hcStop
    have hcBoundary : c ∈ boundaryActive (nextActive := nextActive) H := by
      refine ⟨a, haNext, ?_⟩
      change (H.warp.path i).terminal? = some c
      exact hic
    let ca : quotientSource G A B H.stop := ⟨c, hcSource⟩
    rcases Q.active_endsIn ca hcBoundary with ⟨b, hb, hcb⟩
    refine ⟨b, hb, ?_⟩
    simp only [advancePath, if_neg haOld]
    apply arrowPath_terminal_of_quotient_source H Q.warp Q.isLinkage
      Q.sourceClean i hic hcSource
    unfold linkagePathAt at hcb
    simpa [ca] using hcb

/-- Every advanced component terminates at the new stop-over.  In the frozen
case the old component already ends in `B`; since it also ends at the old
stop and the new stop roofs the old one, that target vertex belongs to the
new stop. -/
theorem advancePath_endsIn_newStop
    {V : Type} {G : SimpleGraph V} {A B active Qactive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B Qactive)
    (hCD : H.stop ⊆ roof G B Q.stop) (a : A) :
    ∃ d ∈ Q.stop, (advancePath H
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) a).terminal? =
      some d := by
  classical
  have haInitial : a.1 ∈ H.warp.initialSet := by
    rw [H.isLinkage.1]
    exact a.property
  let i := H.warp.sourceIndex haInitial
  by_cases haOld : a.1 ∈ active
  · rcases H.active_endsIn a haOld with ⟨b, hb, hab⟩
    rcases H.isLinkage.2 i with ⟨c, hc, hic⟩
    have hcb : c = b := Option.some.inj (hic.symm.trans hab)
    subst c
    have hbD : b ∈ Q.stop :=
      (mem_roof_of_mem_target_iff hb).mp (hCD hc)
    exact ⟨b, hbD, by simpa [advancePath, haOld] using hab⟩
  · have hArrow := arrow_isCleanLinkage H Q.warp Q.isLinkage Q.sourceClean
    rcases hArrow.1.2 i with ⟨d, hd, hid⟩
    refine ⟨d, hd, ?_⟩
    change (Warp.arrowPath H.warp
      (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) i).terminal? =
      some d at hid
    simpa [advancePath, haOld, i] using hid

/-- A clean quotient linkage remains source-clean for the original source
set after being mapped into the ambient graph.  A quotient path cannot enter
the deleted strict roof, so any original source on it is itself a quotient
source. -/
theorem mappedQuotient_sourceClean_original
    {V : Type} {G : SimpleGraph V} {A B active Qactive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B Qactive) :
    (Q.warp.mapLE
      (outsideGraph_le G (interiorRoof G B H.stop))).IsSourceClean A := by
  have hsource : quotientSource G A B H.stop = H.stop :=
    quotientSource_eq_of_minimal_separator H.stop_minimal
  have hStartEssential : Q.warp.IsStarting
      (essentialVertices G B H.stop) := by
    simpa [hsource, essentialVertices_eq_of_minimal_separator H.stop_minimal]
      using Q.isLinkage.isStarting
  have hExterior : Disjoint Q.warp.vertexSet (interiorRoof G B H.stop) :=
    Warp.vertexSet_disjoint_interior_of_outside_starting hStartEssential
  intro j x hxPath hxA
  have hxQ : x ∈ Q.warp.vertexSet := ⟨j, hxPath⟩
  have hxOutside : x ∉ interiorRoof G B H.stop := by
    intro hxInterior
    exact Set.disjoint_left.mp hExterior hxQ hxInterior
  have hxSource : x ∈ quotientSource G A B H.stop :=
    ⟨Or.inl hxA, hxOutside⟩
  exact Q.sourceClean j x hxPath hxSource

/-- Successor composition for clean half-way linkages.  The quotient
half-way linkage is attached to every unfinished old component, finished
components are frozen, and the quotient's minimal stop-over becomes the new
ambient stop-over. -/
noncomputable def compose
    {V : Type} {G : SimpleGraph V}
    {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B
      (boundaryActive (nextActive := nextActive) H))
    (hnextSubset : nextActive ⊆ A) :
    CleanHalfWayLinkage G A B nextActive := by
  classical
  let U := Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  have hsource : quotientSource G A B H.stop = H.stop :=
    quotientSource_eq_of_minimal_separator H.stop_minimal
  have hSelfSource : quotientSource G H.stop B H.stop = H.stop := by
    rw [quotientSource_eq_essentialVertices_of_subset_roof
      (subset_roof G B H.stop),
      essentialVertices_eq_of_minimal_separator H.stop_minimal]
  have hSepCD : Separates G H.stop B Q.stop := by
    apply separates_of_quotient_separator (A := H.stop) (C := H.stop)
    simpa [hsource, hSelfSource] using Q.stop_minimal.prop
  have hCD : H.stop ⊆ roof G B Q.stop :=
    separates_iff_subset_roof.mp hSepCD
  let W := Warp.ofPaths (advancePath H U) (advancePath_disjoint H U)
  have hWLink : W.IsLinkage A Q.stop := by
    constructor
    · change Set.range (fun a : A => (advancePath H U a).initial) = A
      ext v
      constructor
      · rintro ⟨a, rfl⟩
        simpa using a.property
      · intro hv
        refine ⟨⟨v, hv⟩, ?_⟩
        exact advancePath_initial H U ⟨v, hv⟩
    · intro a
      exact advancePath_endsIn_newStop H Q hCD a
  refine {
    stop := Q.stop
    warp := W
    isLinkage := hWLink
    sourceClean := ?_
    vertexSet_subset_roof := ?_
    stopClean := ?_
    stop_minimal := minimalSeparator_of_quotient H.stop_minimal Q.stop_minimal
    quotient_unhindered := ?_
    active_subset := hnextSubset
    active_endsIn := ?_ }
  · exact advancePath_sourceClean H U
      (mappedQuotient_sourceClean_original H Q)
  · rintro v ⟨a, hva⟩
    exact advancePath_vertexSet_subset_newRoof H Q hCD a hva
  · intro a v hv hvStop
    exact advancePath_stopClean_newStop H Q a v hv hvStop
  · have hGraph := outsideGraph_nestedQuotient_eq_of_subset_roof
      (G := G) (B := B) hCD
    have hSource := quotientSource_nested_eq_of_subset_roof
      (G := G) (A := A) (B := B) hCD
    simpa only [hGraph, hSource] using Q.quotient_unhindered
  · intro a ha
    rcases advancePath_endsIn_of_mem_nextActive H Q a ha with
      ⟨b, hb, hab⟩
    refine ⟨b, hb, ?_⟩
    unfold linkagePathAt
    have haInitial : a.1 ∈ W.initialSet := by
      rw [hWLink.1]
      exact a.property
    have hidx (h : a.1 ∈ W.initialSet) : W.sourceIndex h = a := by
      apply Subtype.ext
      calc
        (W.sourceIndex h : A).1 =
            (W.path (W.sourceIndex h)).initial := by
          exact (advancePath_initial H U (W.sourceIndex h)).symm
        _ = a.1 := W.initial_sourceIndex h
    simp only [hidx]
    change (advancePath H U a).terminal? = some b
    exact hab

/-- The canonical source-indexed component of a composed half-way linkage is
definitionally the frozen arrow path used to construct it. -/
@[simp] theorem linkagePathAt_compose
    {V : Type} {G : SimpleGraph V}
    {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (Q : CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B H.stop))
      (quotientSource G A B H.stop) B
      (boundaryActive (nextActive := nextActive) H))
    (hnextSubset : nextActive ⊆ A) (a : A) :
    linkagePathAt (compose H Q hnextSubset).warp
        (compose H Q hnextSubset).isLinkage a =
      advancePath H
        (Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))) a := by
  classical
  let C := compose H Q hnextSubset
  let U := Q.warp.mapLE (outsideGraph_le G (interiorRoof G B H.stop))
  have haInitial : a.1 ∈ C.warp.initialSet := by
    rw [C.isLinkage.1]
    exact a.property
  have hidx (h : a.1 ∈ C.warp.initialSet) : C.warp.sourceIndex h = a := by
    apply Subtype.ext
    calc
      (C.warp.sourceIndex h : A).1 =
          (C.warp.path (C.warp.sourceIndex h)).initial := by
        exact (advancePath_initial H U (C.warp.sourceIndex h)).symm
      _ = a.1 := C.warp.initial_sourceIndex h
  unfold linkagePathAt
  change C.warp.path (C.warp.sourceIndex _) = _
  simp only [hidx]
  change advancePath H U a = _
  rfl

/-- The stage obtained by freezing active components and arrow-advancing all
other components.  The only terminal input is the mathematical assertion
that every newly active component has reached `B`. -/
noncomputable def advanceStage
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {active nextActive : I → Set V}
    (H : ∀ i, CleanHalfWayLinkage G A B (active i))
    (U : I → Warp G) (hUclean : ∀ i, (U i).IsSourceClean A)
    (hnextSubset : ∀ i, nextActive i ⊆ A)
    (hnextEnds : ∀ i (a : A), a.1 ∈ nextActive i →
      ∃ b ∈ B, (advancePath (H i) (U i) a).terminal? = some b) :
    GlobalForwardStage I G A B where
  path := fun i ↦ advancePath (H i) (U i)
  disjoint := fun i ↦ advancePath_disjoint (H i) (U i)
  initial := fun i ↦ advancePath_initial (H i) (U i)
  clean := fun i ↦ advancePath_sourceClean (H i) (U i) (hUclean i)
  active := nextActive
  active_subset_A := hnextSubset
  active_has_terminal := hnextEnds

/-- A clean half-way linkage, indexed canonically by its source set, is one
column of a global finite stage. -/
noncomputable def toGlobalForwardStage
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {active : I → Set V}
    (H : ∀ i, CleanHalfWayLinkage G A B (active i)) :
    GlobalForwardStage I G A B where
  path := fun i a ↦ linkagePathAt (H i).warp (H i).isLinkage a
  disjoint := by
    intro i a b hab
    exact linkagePathAt_disjoint (H i).warp (H i).isLinkage hab
  initial := by
    intro i a
    exact linkagePathAt_initial (H i).warp (H i).isLinkage a
  clean := by
    intro i a v hv hvA
    exact (linkagePathAt_sourceClean (H i).warp (H i).isLinkage
      (H i).sourceClean a hv hvA).trans
        (linkagePathAt_initial (H i).warp (H i).isLinkage a).symm
  active := active
  active_subset_A := fun i ↦ (H i).active_subset
  active_has_terminal := fun i ↦ (H i).active_endsIn

@[simp] theorem toGlobalForwardStage_path
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {active : I → Set V}
    (H : ∀ i, CleanHalfWayLinkage G A B (active i)) (i : I) (a : A) :
    (toGlobalForwardStage H).path i a =
      linkagePathAt (H i).warp (H i).isLinkage a := rfl

@[simp] theorem toGlobalForwardStage_active
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {active : I → Set V}
    (H : ∀ i, CleanHalfWayLinkage G A B (active i)) (i : I) :
    (toGlobalForwardStage H).active i = active i := rfl

/-- The advance construction is a successor in the abstract finite-stage
recursion as soon as the new active set contains the old one and its current
competitors. -/
theorem toGlobalForwardStage_extends_advanceStage
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    {active nextActive : I → Set V}
    (H : ∀ i, CleanHalfWayLinkage G A B (active i))
    (U : I → Warp G) (hUclean : ∀ i, (U i).IsSourceClean A)
    (hnextSubset : ∀ i, nextActive i ⊆ A)
    (hnextEnds : ∀ i (a : A), a.1 ∈ nextActive i →
      ∃ b ∈ B, (advancePath (H i) (U i) a).terminal? = some b)
    (hmono : ∀ i, active i ⊆ nextActive i)
    (hcompetitor : ∀ i (a : A), a.1 ∈ active i → ∀ b,
      WarpFamilyCompetitor
        (competitorWarpFamily F (fun j ↦ (H j).warp)) a.1 b →
      b ∈ nextActive i) :
    GlobalForwardStage.Extends F
      (toGlobalForwardStage H)
      (advanceStage H U hUclean hnextSubset hnextEnds) := by
  refine ⟨?_, hmono, ?_, ?_⟩
  · intro i a
    exact linkagePathAt_forward_advancePath (H i) (U i) a
  · intro i a ha
    exact advancePath_eq_of_active (H i) (U i) a ha
  · intro i a ha b hab
    apply hcompetitor i a ha b
    let e : ∀ j : Option I,
        (competitorWarpFamily F (fun k ↦
          Warp.ofPaths ((toGlobalForwardStage H).path k)
            ((toGlobalForwardStage H).disjoint k)) j).ι →
        (competitorWarpFamily F (fun k ↦ (H k).warp) j).ι
      | none => id
      | some k => fun x ↦ (H k).warp.sourceIndex (by
          rw [(H k).isLinkage.1]
          exact x.property)
    apply warpFamilyCompetitor_mono_paths e _ hab
    intro j x
    cases j with
    | none => rfl
    | some k =>
        change linkagePathAt (H k).warp (H k).isLinkage x =
          (H k).warp.path (e (some k) x)
        rfl

/-! ### Half-way families retaining quotient data

The abstract forward-stage recursion forgets the stop-over and quotient
unhinderedness used to construct its successor.  The following retained-data
stage lets Assertion 9.17 iterate the genuine half-way successor and then
forgets that extra data only when invoking the already verified matrix limit.
-/

structure FamilyStage (I : Type) {V : Type} (G : SimpleGraph V)
    (A B : Set V) where
  active : I → Set V
  halfWay : ∀ i, CleanHalfWayLinkage G A B (active i)

namespace FamilyStage

noncomputable def toForwardStage
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    (S : FamilyStage I G A B) : GlobalForwardStage I G A B :=
  toGlobalForwardStage S.halfWay

@[simp] theorem toForwardStage_path
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    (S : FamilyStage I G A B) (i : I) (a : A) :
    S.toForwardStage.path i a =
      linkagePathAt (S.halfWay i).warp (S.halfWay i).isLinkage a := rfl

@[simp] theorem toForwardStage_active
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    (S : FamilyStage I G A B) (i : I) :
    S.toForwardStage.active i = S.active i := rfl

/-- All data chosen at one singular-matrix successor.  Each row closes its
active set under present competitors and obtains the next half-way linkage
inside the quotient beyond its current stop. -/
structure StepData
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    (F : Warp G) (S : FamilyStage I G A B) where
  nextActive : I → Set V
  next_subset : ∀ i, nextActive i ⊆ A
  active_mono : ∀ i, S.active i ⊆ nextActive i
  competitor_next : ∀ i (a : A), a.1 ∈ S.active i → ∀ b,
    WarpFamilyCompetitor
      (competitorWarpFamily F (fun j => (S.halfWay j).warp)) a.1 b →
    b ∈ nextActive i
  quotient : ∀ i, CleanHalfWayLinkage
    (outsideGraph G (interiorRoof G B (S.halfWay i).stop))
    (quotientSource G A B (S.halfWay i).stop) B
    (boundaryActive (nextActive := nextActive i) (S.halfWay i))

noncomputable def StepData.next
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} {S : FamilyStage I G A B}
    (D : StepData F S) : FamilyStage I G A B where
  active := D.nextActive
  halfWay i := compose (S.halfWay i) (D.quotient i) (D.next_subset i)

/-- Forgetting the retained quotient data turns a half-way successor into
the exact abstract forward-stage successor used by the matrix theorem. -/
theorem StepData.extends
    {I V : Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} {S : FamilyStage I G A B}
    (D : StepData F S) :
    GlobalForwardStage.Extends F S.toForwardStage D.next.toForwardStage := by
  classical
  refine ⟨?_, D.active_mono, ?_, ?_⟩
  · intro i a
    rw [toForwardStage_path, toForwardStage_path]
    change (linkagePathAt (S.halfWay i).warp
      (S.halfWay i).isLinkage a).Forward
      (linkagePathAt
        (compose (S.halfWay i) (D.quotient i) (D.next_subset i)).warp
        (compose (S.halfWay i) (D.quotient i) (D.next_subset i)).isLinkage a)
    rw [linkagePathAt_compose]
    exact linkagePathAt_forward_advancePath (S.halfWay i)
      ((D.quotient i).warp.mapLE
        (outsideGraph_le G (interiorRoof G B (S.halfWay i).stop))) a
  · intro i a ha
    rw [toForwardStage_path, toForwardStage_path]
    change linkagePathAt
      (compose (S.halfWay i) (D.quotient i) (D.next_subset i)).warp
      (compose (S.halfWay i) (D.quotient i) (D.next_subset i)).isLinkage a =
      linkagePathAt (S.halfWay i).warp (S.halfWay i).isLinkage a
    rw [linkagePathAt_compose]
    exact advancePath_eq_of_active (S.halfWay i)
      ((D.quotient i).warp.mapLE
        (outsideGraph_le G (interiorRoof G B (S.halfWay i).stop))) a ha
  · intro i a ha b hab
    apply D.competitor_next i a ha b
    let e : ∀ j : Option I,
        (competitorWarpFamily F (fun k =>
          Warp.ofPaths (S.toForwardStage.path k)
            (S.toForwardStage.disjoint k)) j).ι →
        (competitorWarpFamily F (fun k => (S.halfWay k).warp) j).ι
      | none => id
      | some k => fun x => (S.halfWay k).warp.sourceIndex (by
          rw [(S.halfWay k).isLinkage.1]
          exact x.property)
    apply warpFamilyCompetitor_mono_paths e _ hab
    intro j x
    cases j with
    | none => rfl
    | some k =>
        change linkagePathAt (S.halfWay k).warp
          (S.halfWay k).isLinkage x =
          (S.halfWay k).warp.path (e (some k) x)
        rfl

/-- Iterate a chosen retained-data half-way successor. -/
noncomputable def iterate
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : FamilyStage I G A B)
    (next : ∀ S : FamilyStage I G A B, StepData F S) :
    ℕ → FamilyStage I G A B
  | 0 => S₀
  | n + 1 => (next (iterate S₀ next n)).next

@[simp] theorem iterate_zero
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : FamilyStage I G A B)
    (next : ∀ S : FamilyStage I G A B, StepData F S) :
    iterate S₀ next 0 = S₀ := rfl

@[simp] theorem iterate_succ
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : FamilyStage I G A B)
    (next : ∀ S : FamilyStage I G A B, StepData F S) (n : ℕ) :
    iterate S₀ next (n + 1) = (next (iterate S₀ next n)).next := rfl

theorem iterate_forward_extends
    {I V : Type} {G : SimpleGraph V} {A B : Set V} {F : Warp G}
    (S₀ : FamilyStage I G A B)
    (next : ∀ S : FamilyStage I G A B, StepData F S) (n : ℕ) :
    GlobalForwardStage.Extends F
      (iterate S₀ next n).toForwardStage
      (iterate S₀ next (n + 1)).toForwardStage := by
  rw [iterate_succ]
  exact (next (iterate S₀ next n)).extends

/-- Retained-data form of the singular finite-stage recursion. -/
theorem exists_cleanLinkage_of_successors
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {G : SimpleGraph V} {A A₀ B : Set V} {F : Warp G}
    (S₀ : FamilyStage I G A B)
    (next : ∀ S : FamilyStage I G A B, StepData F S)
    (hcover : A₀ ⊆ {a | ∃ i : I, a ∈ S₀.active i})
    (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  apply GlobalForwardStage.exists_cleanLinkage_of_sequence
    (fun n => (iterate S₀ next n).toForwardStage)
    (iterate_forward_extends S₀ next) _ hF
  simpa using hcover

end FamilyStage

/-- Choose the old source whose current component produces a specified active
boundary vertex. -/
noncomputable def boundaryActiveSource
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (c : boundaryActive (nextActive := nextActive) H) :
    {a : A // a.1 ∈ nextActive} :=
  ⟨Classical.choose c.property, (Classical.choose_spec c.property).1⟩

theorem boundaryActiveSource_terminal
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active)
    (c : boundaryActive (nextActive := nextActive) H) :
    (linkagePathAt H.warp H.isLinkage (boundaryActiveSource H c).1).terminal? =
      some c.1 :=
  (Classical.choose_spec c.property).2

theorem boundaryActiveSource_injective
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active) :
    Function.Injective
      (boundaryActiveSource (nextActive := nextActive) H) := by
  intro c d hcd
  apply Subtype.ext
  have hpath : linkagePathAt H.warp H.isLinkage
      (boundaryActiveSource H c).1 =
      linkagePathAt H.warp H.isLinkage (boundaryActiveSource H d).1 := by
    rw [congrArg Subtype.val hcd]
  apply Option.some.inj
  calc
    some c.1 =
        (linkagePathAt H.warp H.isLinkage
          (boundaryActiveSource H c).1).terminal? :=
      (boundaryActiveSource_terminal H c).symm
    _ = (linkagePathAt H.warp H.isLinkage
          (boundaryActiveSource H d).1).terminal? := by rw [hpath]
    _ = some d.1 := boundaryActiveSource_terminal H d

/-- The active quotient boundary is no larger than the selected old source
set. -/
theorem mk_boundaryActive_le
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active) :
    #(boundaryActive (nextActive := nextActive) H) ≤ #nextActive := by
  let f : boundaryActive (nextActive := nextActive) H → nextActive := fun c =>
    ⟨(boundaryActiveSource H c).1.1, (boundaryActiveSource H c).2⟩
  apply Cardinal.mk_le_of_injective (f := f)
  intro c d hcd
  apply boundaryActiveSource_injective H
  have hV : (boundaryActiveSource H c).1.1 =
      (boundaryActiveSource H d).1.1 :=
    congrArg (fun x : nextActive => x.1) hcd
  have hA : (boundaryActiveSource H c).1 =
      (boundaryActiveSource H d).1 :=
    Subtype.ext hV
  exact Subtype.ext hA

/-- Every active boundary point is the old minimal stop-over, hence is a
source of the quotient. -/
theorem boundaryActive_subset_quotientSource
    {V : Type} {G : SimpleGraph V} {A B active nextActive : Set V}
    (H : CleanHalfWayLinkage G A B active) :
    boundaryActive (nextActive := nextActive) H ⊆
      quotientSource G A B H.stop := by
  intro c hc
  rcases hc with ⟨a, _ha, hac⟩
  rcases linkagePathAt_endsIn H.warp H.isLinkage a with
    ⟨d, hdStop, had⟩
  have hdc : d = c := Option.some.inj (had.symm.trans hac)
  have hcStop : c ∈ H.stop := hdc ▸ hdStop
  rw [quotientSource_eq_of_minimal_separator H.stop_minimal]
  exact hcStop

end CleanHalfWayLinkage


/-! ### Cardinal-bounded half-way supplies

The singular step of Theorem 9.2 is an induction step: half-way linkages for
all source sets of size at most a row cardinal are used, both in the original
web and in every quotient web.  The following predicate and bounded retained
stage package exactly that induction hypothesis. -/

/-- Half-way linkability for active source sets of cardinality at most `#K`. -/
def CleanHalfWayLinkabilityAt (K : Type) : Prop :=
  ∀ (V : Type) (G : SimpleGraph V) (A B active : Set V),
    active ⊆ A → #active ≤ #K → Warp.IsCleanUnhindered G A B →
    Nonempty (CleanHalfWayLinkage G A B active)

/-- The extension clause `(♣)` of Theorem 9.2 at cardinal capacity `#K`. -/
def CleanExtensionLinkabilityAt (K : Type) : Prop :=
  ∀ (V : Type) (G : SimpleGraph V) (A A₀ B : Set V),
    A₀ ⊆ A → #A₀ ≤ #K → Warp.IsCleanUnhindered G A B →
    ∀ F : Warp G, F.IsCleanLinkage (A \ A₀) B →
      ∃ W : Warp G, W.IsCleanLinkage A B

/-- Both clauses of Theorem 9.2 at one cardinal capacity. -/
def CleanCardinalLinkabilityAt (K : Type) : Prop :=
  CleanExtensionLinkabilityAt K ∧ CleanHalfWayLinkabilityAt K

theorem CleanHalfWayLinkabilityAt.mono {K L : Type}
    (h : #K ≤ #L) (hsupply : CleanHalfWayLinkabilityAt L) :
    CleanHalfWayLinkabilityAt K := by
  intro V G A B active hactive hcard hunhindered
  exact hsupply V G A B active hactive (hcard.trans h) hunhindered

theorem CleanExtensionLinkabilityAt.mono {K L : Type}
    (h : #K ≤ #L) (hext : CleanExtensionLinkabilityAt L) :
    CleanExtensionLinkabilityAt K := by
  intro V G A A₀ B hA₀ hcard hunhindered F hF
  exact hext V G A A₀ B hA₀ (hcard.trans h) hunhindered F hF

/-- The verified Hilbert-hotel construction proves `(♣)` at every countable
capacity. -/
theorem cleanExtensionLinkabilityAt_of_mk_le_aleph0 (K : Type)
    (hK : #K ≤ ℵ₀) : CleanExtensionLinkabilityAt K := by
  intro V G A A₀ B hA₀ hcard hunhindered F hF
  have hcount : A₀.Countable :=
    Cardinal.le_aleph0_iff_set_countable.mp (hcard.trans hK)
  exact exists_cleanLinkage_of_countable_extension
    safePathRemoval hA₀ hcount hunhindered F hF

namespace CleanHalfWayLinkage.FamilyStage

/-- A retained half-way family whose `i`th active row is bounded by `#(K i)`. -/
structure Bounded (I : Type) (K : I → Type) {V : Type}
    (G : SimpleGraph V) (A B : Set V) where
  stage : FamilyStage I G A B
  active_card : ∀ i, #(stage.active i) ≤ #(K i)

/-- Construct an initial bounded family from rowwise half-way supplies. -/
noncomputable def Bounded.ofSupply
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    (active : I → Set V) (hactive : ∀ i, active i ⊆ A)
    (hcard : ∀ i, #(active i) ≤ #(K i))
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (hsupply : ∀ i, CleanHalfWayLinkabilityAt (K i)) :
    Bounded I K G A B where
  stage := {
    active := active
    halfWay := fun i => Classical.choice
      (hsupply i V G A B (active i) (hactive i) (hcard i) hunhindered) }
  active_card := hcard

/-- A successor datum together with the cardinal bound needed to iterate it. -/
structure BoundedStepData
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    (F : Warp G) (S : Bounded I K G A B) where
  data : StepData F S.stage
  next_card : ∀ i, #(data.nextActive i) ≤ #(K i)

/-- The bounded stage produced by a bounded successor datum. -/
noncomputable def BoundedStepData.next
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} {S : Bounded I K G A B}
    (D : BoundedStepData F S) : Bounded I K G A B where
  stage := D.data.next
  active_card := D.next_card

/-- Build one cardinal-bounded singular-matrix successor.  The active row is
closed under all present competitors; its boundary in the quotient is no
larger than the row; the row's half-way supply then advances the linkage. -/
noncomputable def Bounded.stepData
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (S : Bounded I K G A B)
    (hI : ℵ₀ ≤ #I) (hIK : ∀ i, #I ≤ #(K i))
    (hK : ∀ i, ℵ₀ ≤ #(K i))
    (hF : F.initialSet ⊆ A)
    (hsupply : ∀ i, CleanHalfWayLinkabilityAt (K i)) :
    BoundedStepData F S := by
  classical
  let W : I → Warp G := fun j => (S.stage.halfWay j).warp
  let C : I → Set V := fun i =>
    competitorClosure (competitorWarpFamily F W) (S.stage.active i)
  have hFamily : ∀ o : Option I,
      (competitorWarpFamily F W o).initialSet ⊆ A := by
    intro o
    cases o with
    | none => exact hF
    | some j =>
        change (S.stage.halfWay j).warp.initialSet ⊆ A
        rw [(S.stage.halfWay j).isLinkage.1]
  have hCA (i : I) : C i ⊆ A := by
    exact competitorClosure_subset_of_initialSet
      (competitorWarpFamily F W) (S.stage.active i) A
      (S.stage.halfWay i).active_subset hFamily
  have hCcard (i : I) : #(C i) ≤ #(K i) := by
    exact mk_competitorClosure_old_ranked_le_capacity F W
      (S.stage.active i) hI (hIK i) (hK i) (S.active_card i)
  have hboundaryCard (i : I) :
      #(CleanHalfWayLinkage.boundaryActive
          (nextActive := C i) (S.stage.halfWay i)) ≤ #(K i) :=
    (CleanHalfWayLinkage.mk_boundaryActive_le (S.stage.halfWay i)).trans
      (hCcard i)
  have hboundarySubset (i : I) :
      CleanHalfWayLinkage.boundaryActive
          (nextActive := C i) (S.stage.halfWay i) ⊆
        quotientSource G A B (S.stage.halfWay i).stop :=
    CleanHalfWayLinkage.boundaryActive_subset_quotientSource
      (S.stage.halfWay i)
  let Q : ∀ i, CleanHalfWayLinkage
      (outsideGraph G (interiorRoof G B (S.stage.halfWay i).stop))
      (quotientSource G A B (S.stage.halfWay i).stop) B
      (CleanHalfWayLinkage.boundaryActive
        (nextActive := C i) (S.stage.halfWay i)) := fun i =>
    Classical.choice
      (hsupply i V
        (outsideGraph G (interiorRoof G B (S.stage.halfWay i).stop))
        (quotientSource G A B (S.stage.halfWay i).stop) B
        (CleanHalfWayLinkage.boundaryActive
          (nextActive := C i) (S.stage.halfWay i))
        (hboundarySubset i) (hboundaryCard i)
        (S.stage.halfWay i).quotient_unhindered)
  refine {
    data := {
      nextActive := C
      next_subset := hCA
      active_mono := fun i => subset_competitorClosure
        (competitorWarpFamily F W) (S.stage.active i)
      competitor_next := ?_
      quotient := Q }
    next_card := hCcard }
  intro i a ha b hab
  exact competitorClosure_closed (competitorWarpFamily F W)
    (S.stage.active i) (subset_competitorClosure
      (competitorWarpFamily F W) (S.stage.active i) ha) hab

end CleanHalfWayLinkage.FamilyStage

namespace CleanHalfWayLinkage.FamilyStage

/-- Iterate bounded retained-data successors. -/
noncomputable def Bounded.iterate
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (S₀ : Bounded I K G A B)
    (next : ∀ S : Bounded I K G A B, BoundedStepData F S) :
    ℕ → Bounded I K G A B
  | 0 => S₀
  | n + 1 => (next (Bounded.iterate S₀ next n)).next

@[simp] theorem Bounded.iterate_zero
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (S₀ : Bounded I K G A B)
    (next : ∀ S : Bounded I K G A B, BoundedStepData F S) :
    Bounded.iterate S₀ next 0 = S₀ := rfl

@[simp] theorem Bounded.iterate_succ
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (S₀ : Bounded I K G A B)
    (next : ∀ S : Bounded I K G A B, BoundedStepData F S) (n : ℕ) :
    Bounded.iterate S₀ next (n + 1) =
      (next (Bounded.iterate S₀ next n)).next := rfl

/-- Consecutive bounded stages give exactly the forward extension required by
the already verified finite-stage matrix limit. -/
theorem Bounded.iterate_stage_extends
    {I V : Type} {K : I → Type} {G : SimpleGraph V} {A B : Set V}
    {F : Warp G} (S₀ : Bounded I K G A B)
    (next : ∀ S : Bounded I K G A B, BoundedStepData F S) (n : ℕ) :
    GlobalForwardStage.Extends F
      (Bounded.iterate S₀ next n).stage.toForwardStage
      (Bounded.iterate S₀ next (n + 1)).stage.toForwardStage := by
  rw [Bounded.iterate_succ]
  exact (next (Bounded.iterate S₀ next n)).data.extends

/-- The bounded retained recursion supplies the matrix required for the
singular final amalgamation. -/
theorem exists_cleanLinkage_of_bounded_successors
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {K : I → Type} {G : SimpleGraph V} {A A₀ B : Set V} {F : Warp G}
    (S₀ : Bounded I K G A B)
    (next : ∀ S : Bounded I K G A B, BoundedStepData F S)
    (hcover : A₀ ⊆ {a | ∃ i : I, a ∈ S₀.stage.active i})
    (hF : F.IsCleanLinkage (A \ A₀) B) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  apply GlobalForwardStage.exists_cleanLinkage_of_sequence
    (fun n => (Bounded.iterate S₀ next n).stage.toForwardStage)
    (Bounded.iterate_stage_extends S₀ next) _ hF
  simpa using hcover

/-- Abstract singular induction step for the half-way theorem.  A cofinal
family of row capacities covers the distinguished source set, and the
half-way theorem at each smaller capacity is reused in every quotient. -/
theorem exists_cleanLinkage_of_bounded_halfWay_rows
    {I V : Type} [LinearOrder I] [WellFoundedLT I]
    {K : I → Type} {G : SimpleGraph V} {A A₀ B : Set V}
    (seed : I → Set V) (hseedA : ∀ i, seed i ⊆ A)
    (hseedCard : ∀ i, #(seed i) ≤ #(K i))
    (hcover : A₀ ⊆ {a | ∃ i : I, a ∈ seed i})
    (hI : ℵ₀ ≤ #I) (hIK : ∀ i, #I ≤ #(K i))
    (hK : ∀ i, ℵ₀ ≤ #(K i))
    (hunhindered : Warp.IsCleanUnhindered G A B)
    (F : Warp G) (hF : F.IsCleanLinkage (A \ A₀) B)
    (hsupply : ∀ i, CleanHalfWayLinkabilityAt (K i)) :
    ∃ U : Warp G, U.IsCleanLinkage A B := by
  let S₀ : Bounded I K G A B :=
    Bounded.ofSupply seed hseedA hseedCard hunhindered hsupply
  have hFstart : F.initialSet ⊆ A := by
    rw [hF.1.1]
    exact Set.diff_subset
  let next : ∀ S : Bounded I K G A B, BoundedStepData F S := fun S =>
    S.stepData hI hIK hK hFstart hsupply
  exact exists_cleanLinkage_of_bounded_successors S₀ next hcover hF

/-- Pure cardinal interface for a singular cofinal decomposition: every set
of size at most `#K` is covered by rows bounded by the capacities `R i`. -/
def CardinalRowCover (K I : Type) (R : I → Type) : Prop :=
  ∀ (V : Type) (S : Set V), #S ≤ #K →
    ∃ seed : I → Set V,
      (∀ i, seed i ⊆ S) ∧
      (∀ i, #(seed i) ≤ #(R i)) ∧
      S ⊆ {a | ∃ i : I, a ∈ seed i}

/-- The singular matrix turns rowwise half-way supplies plus the pure
cofinal-cover cardinal arithmetic into the extension clause at `#K`. -/
theorem cleanExtensionLinkabilityAt_of_bounded_halfWay_rows
    {K I : Type} [LinearOrder I] [WellFoundedLT I]
    (R : I → Type) (hcoverRows : CardinalRowCover K I R)
    (hI : ℵ₀ ≤ #I) (hIR : ∀ i, #I ≤ #(R i))
    (hR : ∀ i, ℵ₀ ≤ #(R i))
    (hsupply : ∀ i, CleanHalfWayLinkabilityAt (R i)) :
    CleanExtensionLinkabilityAt K := by
  intro V G A A₀ B hA₀ hA₀card hunhindered F hF
  rcases hcoverRows V A₀ hA₀card with
    ⟨seed, hseedA₀, hseedCard, hseedCover⟩
  exact exists_cleanLinkage_of_bounded_halfWay_rows seed
    (fun i => (hseedA₀ i).trans hA₀) hseedCard hseedCover
    hI hIR hR hunhindered F hF hsupply

end CleanHalfWayLinkage.FamilyStage





/-- Safe one-point removal already proves the full Erdős--Menger conclusion
when the original source side is countable.  The maximal initial wave has a
countable terminal set, so its essential exterior source is countable as
well; the preceding recursion therefore links the entire exterior, and the
quotient-splicing theorem supplies the orthogonal separator. -/
theorem hasErdosMengerPair_of_safePathRemoval_of_countable
    (hsafe : SafePathRemoval) {V : Type} (G : SimpleGraph V)
    (A B : Set V) (hA : A.Countable) :
    HasErdosMengerPair G A B := by
  rcases Warp.WaveExtension.IsWave.exists_roofMaximal
      (Warp.trivial_isWave G A B) with
    ⟨W, hW, hmax⟩
  let H := outsideGraph G (interiorRoof G B W.terminalSet)
  let E := essentialVertices G B W.terminalSet
  have hWinitial : W.initialSet.Countable := hA.mono hW.1
  have hWterminal : W.terminalSet.Countable :=
    W.terminalSet_countable_of_initialSet hWinitial
  have hE : E.Countable := by
    exact hWterminal.mono (essentialVertices_subset G B W.terminalSet)
  have hloose : Warp.IsCleanLoose H E B := by
    exact hW.cleanLoose_exterior_of_roofMaximal hmax
  have hunhindered : Warp.IsCleanUnhindered H E B :=
    hloose.isCleanUnhindered
  rcases exists_cleanLinkage_of_countable_unhindered
      hsafe hE hunhindered with ⟨U, hU⟩
  exact hasErdosMengerPair_of_exterior_cleanLinkage hW U hU

/-- A proof of clean-loose linkability, together with the maximal-wave and
quotient calculus above, implies the full Erdős--Menger pair theorem. -/
theorem hasErdosMengerPair_of_cleanLooseLinkability
    (hlink : CleanLooseLinkability)
    {V : Type} (G : SimpleGraph V) (A B : Set V) :
    HasErdosMengerPair G A B := by
  rcases Warp.WaveExtension.IsWave.exists_roofMaximal
      (Warp.trivial_isWave G A B) with
    ⟨W, hW, hmax⟩
  let H := outsideGraph G (interiorRoof G B W.terminalSet)
  let E := essentialVertices G B W.terminalSet
  have htrim : IsTrimmedWeb H E B := by
    exact essentialVertices_isTrimmedWeb_outside G B W.terminalSet
  have hloose : Warp.IsCleanLoose H E B := by
    exact hW.cleanLoose_exterior_of_roofMaximal hmax
  rcases hlink V H E B htrim hloose with ⟨U, hU⟩
  exact hasErdosMengerPair_of_exterior_cleanLinkage hW U hU

/-- Extract the exact Formal Conjectures witness tuple from an orthogonal
packing/cover pair for the `A`--`B` path hypergraph. -/
theorem hasErdosMengerPair_of_hasKonigPair {V : Type}
    {G : SimpleGraph V} {A B : Set V}
    (h : HasKonigPair (pathHypergraph G A B)) :
    HasErdosMengerPair G A B := by
  classical
  rcases h with ⟨P, S, hPF, hPdisj, hSsub, horth, hcover⟩
  let PathFor : P → ABPath G A B := fun e =>
    Classical.choose (hPF e.property)
  have hPathFor (e : P) : (PathFor e).vertices = e :=
    Classical.choose_spec (hPF e.property)
  have hsupport (e : P) :
      {v | v ∈ (PathFor e).walk.support} = (e : Set V) := by
    simpa [ABPath.vertices] using hPathFor e
  refine ⟨P, fun e => (PathFor e).left, fun e => (PathFor e).right,
    fun e => (PathFor e).walk, S, fun e => (PathFor e).left_mem,
    fun e => (PathFor e).right_mem, fun e => (PathFor e).isPath, ?_, ?_, ?_, ?_⟩
  · intro e f hef
    have hne : (e : Set V) ≠ (f : Set V) := by
      intro hco
      exact hef (Subtype.ext hco)
    have hd : Disjoint (e : Set V) (f : Set V) :=
      hPdisj (e : Set V) e.property (f : Set V) f.property hne
    rw [hsupport e, hsupport f]
    exact hd
  · intro v hv
    rcases hSsub hv with ⟨e, heP, hve⟩
    let i : P := ⟨e, heP⟩
    refine ⟨i, ?_⟩
    exact (Set.ext_iff.mp (hsupport i) v).mpr hve
  · intro e
    rcases horth (e : Set V) e.property with ⟨v, ⟨hvS, hve⟩, hv⟩
    refine ⟨v, ⟨hvS, (Set.ext_iff.mp (hsupport e) v).mpr hve⟩, ?_⟩
    intro w hw
    apply hv w
    exact ⟨hw.1, (Set.ext_iff.mp (hsupport e) w).mp hw.2⟩
  · intro a ha b hb q hq
    let r : ABPath G A B := ⟨a, b, ha, hb, q, hq⟩
    have hr : r.vertices ∈ pathHypergraph G A B := ⟨r, rfl⟩
    rcases hcover r.vertices hr with ⟨v, hvr, hvS⟩
    exact ⟨v, hvr, hvS⟩

/-- Conversely, the exact witness tuple induces an orthogonal
packing/cover pair in the path hypergraph. -/
theorem hasKonigPair_pathHypergraph_of_hasErdosMengerPair {V : Type}
    {G : SimpleGraph V} {A B : Set V}
    (h : HasErdosMengerPair G A B) :
    HasKonigPair (pathHypergraph G A B) := by
  classical
  rcases h with ⟨ι, a, b, p, S, ha, hb, hp, hdisj, hSsub, horth, hsep⟩
  let supportSet : ι → Set V := fun i => {v | v ∈ (p i).support}
  refine ⟨Set.range supportSet, S, ?_, ?_, ?_, ?_, ?_⟩
  · rintro e ⟨i, rfl⟩
    let r : ABPath G A B := ⟨a i, b i, ha i, hb i, p i, hp i⟩
    exact ⟨r, rfl⟩
  · rintro e ⟨i, rfl⟩ f ⟨j, rfl⟩ hef
    have hij : i ≠ j := by
      intro hij
      apply hef
      exact congrArg supportSet hij
    exact hdisj hij
  · intro v hv
    rcases hSsub hv with ⟨i, hvi⟩
    exact ⟨supportSet i, ⟨i, rfl⟩, hvi⟩
  · rintro e ⟨i, rfl⟩
    exact horth i
  · rintro e ⟨r, rfl⟩
    rcases hsep r.left r.left_mem r.right r.right_mem r.walk r.isPath with
      ⟨v, hvr, hvS⟩
    exact ⟨v, hvr, hvS⟩

theorem hasKonigPair_pathHypergraph_iff {V : Type}
    {G : SimpleGraph V} {A B : Set V} :
    HasKonigPair (pathHypergraph G A B) ↔ HasErdosMengerPair G A B := by
  exact ⟨hasErdosMengerPair_of_hasKonigPair,
    hasKonigPair_pathHypergraph_of_hasErdosMengerPair⟩

/-- The empty packing is orthogonal to the empty separator when no
`A`--`B` path exists. -/
theorem hasErdosMengerPair_of_no_path {V : Type} (G : SimpleGraph V)
    (A B : Set V)
    (h : ¬ ∃ (a : V), a ∈ A ∧ ∃ (b : V), b ∈ B ∧
      ∃ q : G.Walk a b, q.IsPath) :
    HasErdosMengerPair G A B := by
  refine ⟨Empty, Empty.elim, Empty.elim, fun i => i.elim, ∅,
    fun i => i.elim, fun i => i.elim, fun i => i.elim, fun i => i.elim,
    fun _ hv => hv.elim, fun i => i.elim, ?_⟩
  intro a ha b hb q hq
  exact (h ⟨a, ha, b, hb, q, hq⟩).elim

/-- If the source side is empty, the empty path family and empty separator work. -/
theorem hasErdosMengerPair_empty_left {V : Type} (G : SimpleGraph V) (B : Set V) :
    HasErdosMengerPair G ∅ B := by
  apply hasErdosMengerPair_of_no_path
  rintro ⟨a, ha, -⟩
  exact Set.notMem_empty a ha

/-- If the target side is empty, the empty path family and empty separator work. -/
theorem hasErdosMengerPair_empty_right {V : Type} (G : SimpleGraph V) (A : Set V) :
    HasErdosMengerPair G A ∅ := by
  apply hasErdosMengerPair_of_no_path
  rintro ⟨_, _, b, hb, -⟩
  exact Set.notMem_empty b hb

/-- A single `A`--`B` path is an Erdős--Menger packing when one of its
vertices already separates all `A`--`B` paths. -/
theorem hasErdosMengerPair_of_singleton_separator {V : Type}
    {G : SimpleGraph V} {A B : Set V} {a b s : V}
    (ha : a ∈ A) (hb : b ∈ B) (p : G.Walk a b) (hp : p.IsPath)
    (hs : s ∈ p.support) (hsep : Separates G A B {s}) :
    HasErdosMengerPair G A B := by
  refine ⟨Unit, fun _ => a, fun _ => b, fun _ => p, {s},
    fun _ => ha, fun _ => hb, fun _ => hp, ?_, ?_, ?_, hsep⟩
  · intro i j hij
    exact (hij (Subsingleton.elim i j)).elim
  · intro v hv
    have hvs : v = s := Set.mem_singleton_iff.mp hv
    exact ⟨(), hvs ▸ hs⟩
  · intro i
    refine ⟨s, ⟨Set.mem_singleton s, hs⟩, ?_⟩
    intro v hv
    exact Set.mem_singleton_iff.mp hv.1

/-- Exact target-level extraction.  The premise isolates the sole infinitary
combinatorial core: the strong Kőnig property of every `A`--`B` path
hypergraph. -/
theorem erdos_599_of_pathHypergraph_konig
    (strongKonig : ∀ (V : Type) (G : SimpleGraph V) (A B : Set V),
      Disjoint A B → G.IsIndepSet A → G.IsIndepSet B →
      HasKonigPair (pathHypergraph G A B)) :
    True ↔
      ∀ (V : Type) (G : SimpleGraph V) (A B : Set V),
        Disjoint A B → G.IsIndepSet A → G.IsIndepSet B →
        ∃ (ι : Type) (a b : ι → V) (p : ∀ i, G.Walk (a i) (b i)) (S : Set V),
          (∀ i, a i ∈ A) ∧
          (∀ i, b i ∈ B) ∧
          (∀ i, (p i).IsPath) ∧
          (Pairwise fun i j =>
            Disjoint {v | v ∈ (p i).support} {v | v ∈ (p j).support}) ∧
          S ⊆ {v | ∃ i, v ∈ (p i).support} ∧
          (∀ i, ∃! v, v ∈ S ∧ v ∈ (p i).support) ∧
          (∀ a' ∈ A, ∀ b' ∈ B, ∀ q : G.Walk a' b',
            q.IsPath → ∃ v ∈ q.support, v ∈ S) := by
  constructor
  · intro _ V G A B hAB hA hB
    exact hasErdosMengerPair_of_hasKonigPair (strongKonig V G A B hAB hA hB)
  · intro _
    trivial

end Erdos599
