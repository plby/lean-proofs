open Polynomial
open NumberField
open scoped KummerExtension

namespace Erdos1214

noncomputable section

/-- The elementary two-generator Kummer calculation used after the Chebotarev step.
If an `l`-th root of `b` lies in the irreducible Kummer extension obtained by adjoining an
`l`-th root of `a`, then the class of `b` is generated by the class of `a` modulo `l`-th
powers. -/
private theorem kummer_relation_of_root
    {K : Type*} [Field K] {l : ℕ} [NeZero l]
    {ζ a b : K} (hζ : IsPrimitiveRoot ζ l) (hb : b ≠ 0)
    (hirr : Irreducible (X ^ l - C a))
    (c : AdjoinRoot (X ^ l - C a))
    (hc : c ^ l = algebraMap K (AdjoinRoot (X ^ l - C a)) b) :
    ∃ j < l, ∃ z : K, b = a ^ j * z ^ l := by
  let : Fact (Irreducible (X ^ l - C a)) := ⟨hirr⟩
  have hf : X ^ l - C a ≠ 0 :=
    X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero (NeZero.ne l)) a
  let pb := AdjoinRoot.powerBasis hf
  have hdim : pb.dim = l := by
    simp [pb]
  let B : Module.Basis (Fin l) K (AdjoinRoot (X ^ l - C a)) :=
    pb.basis.reindex (finCongr hdim)
  let η : rootsOfUnity l K := rootsOfUnity.mkOfPowEq ζ hζ.pow_eq_one
  let τ : AdjoinRoot (X ^ l - C a) ≃ₐ[K] AdjoinRoot (X ^ l - C a) :=
    autAdjoinRootXPowSubC l a η
  have hτroot : τ (AdjoinRoot.root (X ^ l - C a)) =
      algebraMap K (AdjoinRoot (X ^ l - C a)) ζ *
        AdjoinRoot.root (X ^ l - C a) := by
    simpa [τ, η, Algebra.smul_def] using autAdjoinRootXPowSubC_root a η
  have hB (i : Fin l) : B i = AdjoinRoot.root (X ^ l - C a) ^ (i : ℕ) := by
    simp [B, pb, Module.Basis.reindex_apply, AdjoinRoot.powerBasis_gen]
  have hsum : ∑ i : Fin l, (B.repr c i) • B i = c := B.sum_repr c
  have hτB (i : Fin l) : τ (B i) = (ζ ^ (i : ℕ)) • B i := by
    rw [hB, map_pow, hτroot, mul_pow, ← map_pow, Algebra.smul_def]
  have hτsum : τ c = ∑ i : Fin l,
      (B.repr c i * ζ ^ (i : ℕ)) • B i := by
    calc
      τ c = τ (∑ i : Fin l, (B.repr c i) • B i) := congrArg τ hsum.symm
      _ = ∑ i : Fin l, (B.repr c i * ζ ^ (i : ℕ)) • B i := by
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [map_smul, hτB, smul_smul]
  have hcoord (i : Fin l) :
      B.repr (τ c) i = ζ ^ (i : ℕ) * B.repr c i := by
    rw [hτsum, B.repr_sum_self]
    exact mul_comm _ _
  have hc0 : c ≠ 0 := by
    intro h
    rw [h, zero_pow (NeZero.ne l)] at hc
    exact hb ((algebraMap K (AdjoinRoot (X ^ l - C a))).injective (by simpa using hc.symm))
  let ξ := τ c / c
  have hξpow : ξ ^ l = 1 := by
    dsimp [ξ]
    rw [div_pow, ← map_pow, hc, τ.commutes]
    exact div_self ((map_ne_zero_iff
      (algebraMap K (AdjoinRoot (X ^ l - C a)))
      (algebraMap K (AdjoinRoot (X ^ l - C a))).injective).mpr hb)
  have hζL : IsPrimitiveRoot (algebraMap K (AdjoinRoot (X ^ l - C a)) ζ) l :=
    hζ.map_of_injective (algebraMap K (AdjoinRoot (X ^ l - C a))).injective
  obtain ⟨j, hj, hjξ⟩ := hζL.eq_pow_of_pow_eq_one hξpow
  have hτc : τ c = algebraMap K (AdjoinRoot (X ^ l - C a)) (ζ ^ j) * c := by
    rw [map_pow, hjξ]
    simpa [ξ] using (div_mul_cancel₀ (τ c) hc0).symm
  let jf : Fin l := ⟨j, hj⟩
  have hcoef (i : Fin l) (hij : i ≠ jf) : B.repr c i = 0 := by
    have heq := congrArg (fun z ↦ B.repr z i) hτc
    rw [hcoord] at heq
    have hrhs : B.repr
        (algebraMap K (AdjoinRoot (X ^ l - C a)) (ζ ^ j) * c) i =
        ζ ^ j * B.repr c i := by
      rw [← Algebra.smul_def, map_smul]
      rfl
    rw [hrhs] at heq
    have hpows : ζ ^ (i : ℕ) ≠ ζ ^ j := by
      intro h
      have hi_eq : (i : ℕ) = j := hζ.injOn_pow (Finset.mem_range.mpr i.isLt)
        (Finset.mem_range.mpr hj) h
      exact hij (Fin.ext hi_eq)
    have hzero : (ζ ^ (i : ℕ) - ζ ^ j) * B.repr c i = 0 := by
      rw [sub_mul, heq, sub_self]
    exact (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr hpows)
  let z : K := B.repr c jf
  have hcform : c = algebraMap K (AdjoinRoot (X ^ l - C a)) z *
      AdjoinRoot.root (X ^ l - C a) ^ j := by
    rw [← hsum, Finset.sum_eq_single jf]
    · dsimp [z, jf]
      rw [Algebra.smul_def, hB]
      simp only [AdjoinRoot.algebraMap_eq]
    · intro i _ hne
      simp [hcoef i hne]
    · intro hnot
      exact (hnot (Finset.mem_univ jf)).elim
  refine ⟨j, hj, z, ?_⟩
  apply (algebraMap K (AdjoinRoot (X ^ l - C a))).injective
  rw [← hc, hcform, mul_pow, ← pow_mul, Nat.mul_comm j l, pow_mul,
    root_X_pow_sub_C_pow]
  simp [AdjoinRoot.algebraMap_eq, map_mul, map_pow, mul_comm]

/-- Transfer the original rational-prime support hypothesis through a prime of a number-field
extension.  This is the only place where prime ideals are converted back to rational primes. -/
private theorem support_transfer_at_liesOver
    {K E : Type*} [Field K] [NumberField K] [Field E] [NumberField E]
    [Algebra K E] {𝔭 : Ideal (𝓞 K)} [𝔭.IsPrime]
    {𝔓 : Ideal (𝓞 E)} [𝔓.IsPrime] [𝔓.LiesOver 𝔭]
    {x y n : ℕ}
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1))
    (h𝔭ne : 𝔭 ≠ ⊥) (hn : 1 ≤ n)
    (hxmem : ((x ^ n - 1 : ℕ) : 𝓞 E) ∈ 𝔓) :
    ((y ^ n - 1 : ℕ) : 𝓞 E) ∈ 𝔓 := by
  have hxmemK : ((x ^ n - 1 : ℕ) : 𝓞 K) ∈ 𝔭 := by
    rw [Ideal.LiesOver.over (P := 𝔓) (p := 𝔭), Ideal.under, Ideal.mem_comap]
    simpa using hxmem
  have hunderPrime : (𝔭.under ℤ).IsPrime := Ideal.IsPrime.under ℤ 𝔭
  have hunderNe : 𝔭.under ℤ ≠ ⊥ := Ideal.IsIntegral.comap_ne_bot ℤ h𝔭ne
  obtain ⟨p, hp, hpunder⟩ :
      ∃ p : ℕ, p.Prime ∧ 𝔭.under ℤ = Ideal.span {(p : ℤ)} := by
    rcases Ideal.isPrime_int_iff.mp hunderPrime with hbot | h
    · exact (hunderNe hbot).elim
    · exact h
  have hxmemZ : ((x ^ n - 1 : ℕ) : ℤ) ∈ 𝔭.under ℤ := by
    rw [Ideal.under, Ideal.mem_comap]
    simpa using hxmemK
  have hpdiv : p ∣ x ^ n - 1 := by
    rw [hpunder, Ideal.mem_span_singleton] at hxmemZ
    exact Int.natCast_dvd_natCast.mp hxmemZ
  have hydiv : p ∣ y ^ n - 1 := (hsupport n hn p hp).mp hpdiv
  have hymemZ : ((y ^ n - 1 : ℕ) : ℤ) ∈ 𝔭.under ℤ := by
    rw [hpunder, Ideal.mem_span_singleton]
    exact Int.natCast_dvd_natCast.mpr hydiv
  have hymemK : ((y ^ n - 1 : ℕ) : 𝓞 K) ∈ 𝔭 := by
    rw [Ideal.under, Ideal.mem_comap] at hymemZ
    simpa using hymemZ
  have : ((y ^ n - 1 : ℕ) : 𝓞 K) ∈ 𝔓.under (𝓞 K) := by
    rw [← Ideal.LiesOver.over (P := 𝔓) (p := 𝔭)]
    exact hymemK
  rw [Ideal.under, Ideal.mem_comap] at this
  simpa using this

/-- Chebotarev contradiction at the heart of the support argument.  The automorphism `σ` fixes
an `l`-th root of `x` and multiplies an `l`-th root of `y` by a primitive `l`-th root of unity.
Chebotarev supplies a conjugate arithmetic Frobenius.  Reduction modulo its prime then transfers
`x^n = 1` to `y^n = 1`, forcing the primitive root of unity to reduce to `1` at a prime not above
`l`. -/
private theorem kummer_chebotarev_contradiction
    {K E : Type*} [Field K] [NumberField K] [Field E] [NumberField E]
    [Algebra K E] [IsGalois K E]
    {l x y : ℕ} (hl : l.Prime) (hx : 1 ≤ x) (hy : 1 ≤ y)
    {ζ : K} (hζ : IsPrimitiveRoot ζ l)
    {α β : E} (hαpow : α ^ l = (x : E)) (hβpow : β ^ l = (y : E))
    (σ : E ≃ₐ[K] E) (hσα : σ α = α)
    (hσβ : σ β = algebraMap K E ζ * β)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1)) : False := by
  let : NeZero l := ⟨hl.ne_zero⟩
  let S : Set (Ideal (𝓞 K)) := {𝔭 | 𝔭.IsPrime ∧ Chebotarev.UnramifiedIn K E 𝔭 ∧
    Chebotarev.frobeniusClass K E 𝔭 = ConjClasses.mk σ}
  have hS : S.Infinite := Chebotarev.infinite_setOf_frobenius_class
    (K := K) (L := E) (ConjClasses.mk σ)
  let bad : Set (Ideal (𝓞 K)) := {𝔭 | 𝔭.IsPrime ∧ 𝔭 ≠ ⊥ ∧
    ((l * x * y : ℕ) : 𝓞 K) ∈ 𝔭}
  have hprod : l * x * y ≠ 0 :=
    mul_ne_zero (mul_ne_zero hl.ne_zero (by omega)) (by omega)
  have hbad : bad.Finite := Chebotarev.finite_primes_natCast_mem K (l * x * y) hprod
  rcases (hS.sdiff hbad).nonempty with ⟨𝔭, h𝔭⟩
  have h𝔭S : 𝔭 ∈ S := h𝔭.1
  have h𝔭bad : 𝔭 ∉ bad := h𝔭.2
  change 𝔭.IsPrime ∧ Chebotarev.UnramifiedIn K E 𝔭 ∧
    Chebotarev.frobeniusClass K E 𝔭 = ConjClasses.mk σ at h𝔭S
  rcases h𝔭S with ⟨h𝔭prime, hunr, hclass⟩
  let : 𝔭.IsPrime := h𝔭prime
  have h𝔭ne : 𝔭 ≠ ⊥ := Chebotarev.UnramifiedIn.ne_bot K E hunr
  have hprodnot : ((l * x * y : ℕ) : 𝓞 K) ∉ 𝔭 := by
    intro h
    exact h𝔭bad ⟨h𝔭prime, h𝔭ne, h⟩
  have hl𝔭 : (l : 𝓞 K) ∉ 𝔭 := by
    intro h
    apply hprodnot
    simpa [Nat.cast_mul, mul_assoc] using 𝔭.mul_mem_right (x * y : 𝓞 K) h
  have hx𝔭 : (x : 𝓞 K) ∉ 𝔭 := by
    intro h
    apply hprodnot
    have := 𝔭.mul_mem_left (l : 𝓞 K) (𝔭.mul_mem_right (y : 𝓞 K) h)
    simpa [Nat.cast_mul, mul_assoc] using this
  have hy𝔭 : (y : 𝓞 K) ∉ 𝔭 := by
    intro h
    apply hprodnot
    have := 𝔭.mul_mem_left (l * x : 𝓞 K) h
    simpa [Nat.cast_mul, mul_assoc] using this
  obtain ⟨𝔓, h𝔓prime, h𝔓lo, h𝔓ne⟩ :=
    Chebotarev.exists_prime_liesOver K E 𝔭 h𝔭ne
  let : 𝔓.IsPrime := h𝔓prime
  let : 𝔓.LiesOver 𝔭 := h𝔓lo
  let : 𝔓.IsMaximal := h𝔓prime.isMaximal h𝔓ne
  let : Finite (𝓞 E ⧸ 𝔓) :=
    Chebotarev.UnramifiedIn.finite_quotient K E hunr 𝔓 h𝔓lo
  let ρ : E ≃ₐ[K] E := arithFrobAt (𝓞 K) Gal(E/K) 𝔓
  have hρfrob : IsArithFrobAt (𝓞 K) ρ 𝔓 :=
    IsArithFrobAt.arithFrobAt (𝓞 K) Gal(E/K) 𝔓
  have hρclass : Chebotarev.frobeniusClass K E 𝔭 = ConjClasses.mk ρ :=
    Chebotarev.frobeniusClass_eq_mk_of_isArithFrobAt K E 𝔭 hunr ρ 𝔓 hρfrob h𝔓lo
  have hconj : IsConj σ ρ := by
    rw [← ConjClasses.mk_eq_mk_iff_isConj, ← hclass, hρclass]
  obtain ⟨g, hg⟩ := isConj_iff.mp hconj
  have hρeq : ρ = g * σ * g⁻¹ := hg.symm
  let α' : E := g α
  let β' : E := g β
  have hρα : ρ α' = α' := by
    rw [hρeq]
    simp [α', hσα]
  have hρβ : ρ β' = algebraMap K E ζ * β' := by
    rw [hρeq]
    simp [β', hσβ]
  have hα'pow : α' ^ l = (x : E) := by
    dsimp [α']
    rw [← map_pow, hαpow]
    simp
  have hβ'pow : β' ^ l = (y : E) := by
    dsimp [β']
    rw [← map_pow, hβpow]
    simp
  have hαint : IsIntegral ℤ α' :=
    IsIntegral.of_pow hl.pos (hα'pow ▸ isIntegral_natCast x)
  have hβint : IsIntegral ℤ β' :=
    IsIntegral.of_pow hl.pos (hβ'pow ▸ isIntegral_natCast y)
  let aI : 𝓞 E := ⟨α', hαint⟩
  let bI : 𝓞 E := ⟨β', hβint⟩
  have hl𝔓 : (l : 𝓞 E) ∉ 𝔓 := by
    intro h
    apply hl𝔭
    have : (l : 𝓞 K) ∈ 𝔓.under (𝓞 K) := by
      rw [Ideal.under, Ideal.mem_comap]
      simpa using h
    rwa [← Ideal.LiesOver.over (P := 𝔓) (p := 𝔭)] at this
  have hx𝔓 : (x : 𝓞 E) ∉ 𝔓 := by
    intro h
    apply hx𝔭
    have : (x : 𝓞 K) ∈ 𝔓.under (𝓞 K) := by
      rw [Ideal.under, Ideal.mem_comap]
      simpa using h
    rwa [← Ideal.LiesOver.over (P := 𝔓) (p := 𝔭)] at this
  have hy𝔓 : (y : 𝓞 E) ∉ 𝔓 := by
    intro h
    apply hy𝔭
    have : (y : 𝓞 K) ∈ 𝔓.under (𝓞 K) := by
      rw [Ideal.under, Ideal.mem_comap]
      simpa using h
    rwa [← Ideal.LiesOver.over (P := 𝔓) (p := 𝔭)] at this
  let q := Nat.card (𝓞 K ⧸ 𝔓.under (𝓞 K))
  have hqnorm : q = Ideal.absNorm 𝔭 := by
    dsimp [q]
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply,
      Ideal.LiesOver.over (P := 𝔓) (p := 𝔭)]
  have hq0 : q ≠ 0 := by
    rw [hqnorm, Ne, Ideal.absNorm_eq_zero_iff]
    exact h𝔭ne
  have hq1 : q ≠ 1 := by
    rw [hqnorm, Ne, Ideal.absNorm_eq_one_iff]
    exact h𝔭prime.ne_top
  have hqgt : 1 < q := by omega
  have hζE : IsPrimitiveRoot (algebraMap K E ζ) l :=
    hζ.map_of_injective (algebraMap K E).injective
  let zI : 𝓞 E := hζE.toInteger
  have hzactI := hρfrob.apply_of_pow_eq_one
    hζE.toInteger_isPrimitiveRoot.pow_eq_one hl𝔓
  have hzact := congrArg (algebraMap (𝓞 E) E) hzactI
  have hzpow : algebraMap K E ζ ^ q = algebraMap K E ζ := by
    change ρ (algebraMap K E ζ) = algebraMap K E ζ ^ q at hzact
    rw [ρ.commutes] at hzact
    exact hzact.symm
  have hmod : q ≡ 1 [MOD l] := by
    have hpows : algebraMap K E ζ ^ q = algebraMap K E ζ ^ 1 := by simpa using hzpow
    have hm : q ≡ 1 [MOD orderOf (algebraMap K E ζ)] :=
      (hζE.isOfFinOrder hl.ne_zero).pow_eq_pow_iff_modEq.mp hpows
    simpa [hζE.eq_orderOf] using hm
  have hldvd : l ∣ q - 1 :=
    (Nat.modEq_iff_dvd' (by omega : 1 ≤ q)).mp hmod.symm
  let n := (q - 1) / l
  have hln : l * n = q - 1 := Nat.mul_div_cancel' hldvd
  have hn : 1 ≤ n := by
    apply Nat.one_le_iff_ne_zero.mpr
    intro hn0
    rw [hn0, mul_zero] at hln
    omega
  let Q := 𝓞 E ⧸ 𝔓
  let : Field Q := Ideal.Quotient.field 𝔓
  let abar : Q := Ideal.Quotient.mk 𝔓 aI
  let bbar : Q := Ideal.Quotient.mk 𝔓 bI
  let zbar : Q := Ideal.Quotient.mk 𝔓 zI
  have haIpow : aI ^ l = (x : 𝓞 E) := by
    ext
    exact hα'pow
  have hbIpow : bI ^ l = (y : 𝓞 E) := by
    ext
    exact hβ'pow
  have habarne : abar ≠ 0 := by
    intro h
    have haImem : aI ∈ 𝔓 := Ideal.Quotient.eq_zero_iff_mem.mp h
    exact hx𝔓 (haIpow ▸ Ideal.pow_mem_of_mem 𝔓 haImem l hl.pos)
  have hbbarne : bbar ≠ 0 := by
    intro h
    have hbImem : bI ∈ 𝔓 := Ideal.Quotient.eq_zero_iff_mem.mp h
    exact hy𝔓 (hbIpow ▸ Ideal.pow_mem_of_mem 𝔓 hbImem l hl.pos)
  have hρaI : (MulSemiringAction.toAlgHom (𝓞 K) (𝓞 E) ρ) aI = aI := by
    ext
    exact hρα
  have hρbI : (MulSemiringAction.toAlgHom (𝓞 K) (𝓞 E) ρ) bI = zI * bI := by
    ext
    exact hρβ
  have habarpowq : abar ^ q = abar := by
    have h := hρfrob.mk_apply aI
    rw [hρaI] at h
    exact h.symm
  have hbbarpowq : bbar ^ q = zbar * bbar := by
    have h := hρfrob.mk_apply bI
    rw [hρbI, map_mul] at h
    exact h.symm
  have habarpred : abar ^ (q - 1) = 1 := by
    apply mul_right_cancel₀ habarne
    rw [one_mul, ← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ q), habarpowq]
  have hxbar : ((x : 𝓞 E) : Q) ^ n = 1 := by
    rw [← haIpow, map_pow, ← pow_mul, hln, habarpred]
  have hxmem : ((x ^ n - 1 : ℕ) : 𝓞 E) ∈ 𝔓 := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simpa [Nat.cast_sub (one_le_pow₀ hx), map_sub, map_pow] using sub_eq_zero.mpr hxbar
  have hymem : ((y ^ n - 1 : ℕ) : 𝓞 E) ∈ 𝔓 :=
    support_transfer_at_liesOver hsupport h𝔭ne hn hxmem
  have hybar : ((y : 𝓞 E) : Q) ^ n = 1 := by
    have hzero : (((y ^ n - 1 : ℕ) : 𝓞 E) : Q) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hymem
    simpa [Nat.cast_sub (one_le_pow₀ hy), map_sub, map_pow, sub_eq_zero] using hzero
  have hbbarpred : bbar ^ (q - 1) = 1 := by
    calc
      bbar ^ (q - 1) = (bbar ^ l) ^ n := by rw [← hln, pow_mul]
      _ = (((y : 𝓞 E) : Q)) ^ n := by rw [← map_pow, hbIpow]
      _ = 1 := hybar
  have hbbarpowq' : bbar ^ q = bbar := by
    rw [show q = (q - 1) + 1 by omega, pow_succ, hbbarpred, one_mul]
  have hzbar : zbar = 1 := by
    apply mul_right_cancel₀ hbbarne
    rw [one_mul, ← hbbarpowq, hbbarpowq']
  have hzmem : zI - 1 ∈ 𝔓 := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one]
    change zbar - 1 = 0
    rw [hzbar, sub_self]
  have hzdiv : zI - 1 ∣ (l : 𝓞 E) :=
    sub_one_dvd_natCast_of_pow_eq_one hζE.toInteger_isPrimitiveRoot.pow_eq_one
      (hζE.toInteger_isPrimitiveRoot.ne_one hl.one_lt)
  exact hl𝔓 (𝔓.mem_of_dvd hzdiv hzmem)

/-- For every prime `l`, the one-sided support hypothesis puts `y` in the subgroup generated by
`x` and `l`-th powers in the cyclotomic field `ℚ(ζ_l)`. -/
private theorem support_kummer_relation
    {x y : ℕ} (hx : 1 ≤ x) (hy : 1 ≤ y)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1))
    (l : ℕ) (hl : l.Prime) :
    let K := CyclotomicField l ℚ
    ∃ j < l, ∃ z : K, (y : K) = (x : K) ^ j * z ^ l := by
  let : NeZero l := ⟨hl.ne_zero⟩
  let K := CyclotomicField l ℚ
  let : IsCyclotomicExtension {l} ℚ K :=
    CyclotomicField.isCyclotomicExtension l ℚ
  let ζ : K := IsCyclotomicExtension.zeta l ℚ K
  have hζ : IsPrimitiveRoot ζ l := IsCyclotomicExtension.zeta_spec l ℚ K
  have hroots : (primitiveRoots l K).Nonempty :=
    ⟨ζ, (mem_primitiveRoots hl.pos).mpr hζ⟩
  let a : K := x
  let b : K := y
  by_cases ha : ∃ u : K, u ^ l = a
  · obtain ⟨u, hu⟩ := ha
    by_cases hb : ∃ v : K, v ^ l = b
    · obtain ⟨v, hv⟩ := hb
      exact ⟨0, hl.pos, v, by simp [b, hv]⟩
    · have hirrb : Irreducible (X ^ l - C b) :=
        (X_pow_sub_C_irreducible_iff_of_prime hl).mpr fun v hv ↦ hb ⟨v, hv⟩
      let : Fact (Irreducible (X ^ l - C b)) := ⟨hirrb⟩
      let E := AdjoinRoot (X ^ l - C b)
      let : FiniteDimensional K E :=
        (AdjoinRoot.powerBasis hirrb.ne_zero).finite
      let : NumberField E := NumberField.of_module_finite K E
      let : IsSplittingField K E (X ^ l - C b) :=
        isSplittingField_AdjoinRoot_X_pow_sub_C hroots hirrb
      let : IsGalois K E :=
        isGalois_of_isSplittingField_X_pow_sub_C hroots hirrb E
      let η : rootsOfUnity l K := rootsOfUnity.mkOfPowEq ζ hζ.pow_eq_one
      let σ : E ≃ₐ[K] E := autAdjoinRootXPowSubC l b η
      have hαpow : (algebraMap K E u) ^ l = (x : E) := by
        calc
          (algebraMap K E u) ^ l = algebraMap K E (u ^ l) := by rw [map_pow]
          _ = algebraMap K E a := by rw [hu]
          _ = algebraMap K E (x : K) := rfl
          _ = (x : E) := map_natCast (algebraMap K E) x
      have hβpow : (AdjoinRoot.root (X ^ l - C b) : E) ^ l = (y : E) := by
        calc
          (AdjoinRoot.root (X ^ l - C b) : E) ^ l =
              AdjoinRoot.of (X ^ l - C b) b := root_X_pow_sub_C_pow l b
          _ = algebraMap K E b := by rw [AdjoinRoot.algebraMap_eq]
          _ = algebraMap K E (y : K) := rfl
          _ = (y : E) := map_natCast (algebraMap K E) y
      have hσα : σ (algebraMap K E u) = algebraMap K E u := σ.commutes u
      have hσβ : σ (AdjoinRoot.root (X ^ l - C b)) =
          algebraMap K E ζ * AdjoinRoot.root (X ^ l - C b) := by
        change σ (AdjoinRoot.root (X ^ l - C b)) =
          AdjoinRoot.of (X ^ l - C b) ζ * AdjoinRoot.root (X ^ l - C b)
        simpa [σ, η, Algebra.smul_def] using autAdjoinRootXPowSubC_root b η
      exact (kummer_chebotarev_contradiction hl hx hy hζ hαpow hβpow σ hσα hσβ
        hsupport).elim
  · have hirra : Irreducible (X ^ l - C a) :=
      (X_pow_sub_C_irreducible_iff_of_prime hl).mpr fun u hu ↦ ha ⟨u, hu⟩
    let : Fact (Irreducible (X ^ l - C a)) := ⟨hirra⟩
    let A := AdjoinRoot (X ^ l - C a)
    let : FiniteDimensional K A :=
      (AdjoinRoot.powerBasis hirra.ne_zero).finite
    let : NumberField A := NumberField.of_module_finite K A
    let : IsSplittingField K A (X ^ l - C a) :=
      isSplittingField_AdjoinRoot_X_pow_sub_C hroots hirra
    let : IsGalois K A :=
      isGalois_of_isSplittingField_X_pow_sub_C hroots hirra A
    by_cases hbA : ∃ c : A, c ^ l = algebraMap K A b
    · obtain ⟨c, hc⟩ := hbA
      exact kummer_relation_of_root hζ (by
        exact_mod_cast (show y ≠ 0 by omega)) hirra c hc
    · have hirrbA : Irreducible
          (X ^ l - C (algebraMap K A b)) :=
        (X_pow_sub_C_irreducible_iff_of_prime hl).mpr fun c hc ↦ hbA ⟨c, hc⟩
      let : Fact (Irreducible (X ^ l - C (algebraMap K A b))) := ⟨hirrbA⟩
      let E := AdjoinRoot (X ^ l - C (algebraMap K A b))
      let : FiniteDimensional A E :=
        (AdjoinRoot.powerBasis hirrbA.ne_zero).finite
      let : NumberField E := NumberField.of_module_finite A E
      let : IsScalarTower K A E := inferInstance
      have hirrb : Irreducible (X ^ l - C b) :=
        (X_pow_sub_C_irreducible_iff_of_prime hl).mpr fun v hv ↦ hbA ⟨algebraMap K A v, by
          rw [← map_pow, hv]
        ⟩
      have hab : a ≠ b := by
        intro hab
        apply hbA
        refine ⟨AdjoinRoot.root (X ^ l - C a), ?_⟩
        rw [root_X_pow_sub_C_pow, ← hab, AdjoinRoot.algebraMap_eq]
      have hpoly : X ^ l - C a ≠ X ^ l - C b := by
        intro h
        apply hab
        exact C_injective (sub_right_inj.mp h)
      have hcop : IsCoprime (X ^ l - C a) (X ^ l - C b) := by
        rcases hirra.isCoprime_or_dvd (X ^ l - C b) with h | h
        · exact h
        · exact (hpoly (Polynomial.eq_of_monic_of_associated
            (monic_X_pow_sub_C a hl.ne_zero) (monic_X_pow_sub_C b hl.ne_zero)
            (hirra.associated_of_dvd hirrb h))).elim
      let : IsSplittingField A E
          ((X ^ l - C b).map (algebraMap K A)) := by
        simpa [map_sub, map_pow] using
          (isSplittingField_AdjoinRoot_X_pow_sub_C
            (show (primitiveRoots l A).Nonempty from
              ⟨algebraMap K A ζ, (mem_primitiveRoots hl.pos).mpr
                (hζ.map_of_injective (algebraMap K A).injective)⟩)
            hirrbA)
      let : IsSplittingField K E ((X ^ l - C a) * (X ^ l - C b)) :=
        Polynomial.IsSplittingField.mul (K := A) E (X ^ l - C a) (X ^ l - C b)
          hirra.ne_zero hirrb.ne_zero
      have hsepA : (X ^ l - C a).Separable :=
        separable_X_pow_sub_C_of_irreducible hroots a hirra
      have hsepB : (X ^ l - C b).Separable :=
        separable_X_pow_sub_C_of_irreducible hroots b hirrb
      let : IsGalois K E := IsGalois.of_separable_splitting_field
        (hsepA.mul hsepB hcop)
      let ηA : rootsOfUnity l A := rootsOfUnity.mkOfPowEq (algebraMap K A ζ)
        (by rw [← map_pow, hζ.pow_eq_one, map_one])
      let σA : E ≃ₐ[A] E := autAdjoinRootXPowSubC l (algebraMap K A b) ηA
      let σ : E ≃ₐ[K] E := σA.restrictScalars K
      let αE : E := algebraMap A E (AdjoinRoot.root (X ^ l - C a))
      let βE : E := AdjoinRoot.root (X ^ l - C (algebraMap K A b))
      have hαpow : αE ^ l = (x : E) := by
        calc
          αE ^ l = algebraMap A E
              ((AdjoinRoot.root (X ^ l - C a) : A) ^ l) := by
                dsimp [αE]
                rw [map_pow]
          _ = algebraMap A E (algebraMap K A a) := by
                rw [root_X_pow_sub_C_pow]
                rfl
          _ = algebraMap K E a := by
                rw [IsScalarTower.algebraMap_apply K A E]
          _ = algebraMap K E (x : K) := rfl
          _ = (x : E) := map_natCast (algebraMap K E) x
      have hβpow : βE ^ l = (y : E) := by
        calc
          βE ^ l = AdjoinRoot.of (X ^ l - C (algebraMap K A b))
              (algebraMap K A b) := by
                dsimp [βE]
                exact root_X_pow_sub_C_pow l (algebraMap K A b)
          _ = algebraMap A E (algebraMap K A b) := by
                rfl
          _ = algebraMap K E b := by
                rw [IsScalarTower.algebraMap_apply K A E]
          _ = algebraMap K E (y : K) := rfl
          _ = (y : E) := map_natCast (algebraMap K E) y
      have hσα : σ αE = αE := by
        exact σA.commutes (AdjoinRoot.root (X ^ l - C a))
      have hσβ : σ βE = algebraMap K E ζ * βE := by
        have hσβA : σA βE = algebraMap A E (algebraMap K A ζ) * βE := by
          dsimp [βE, σA]
          change (autAdjoinRootXPowSubC l (algebraMap K A b) ηA)
              (AdjoinRoot.root (X ^ l - C (algebraMap K A b))) =
            AdjoinRoot.of (X ^ l - C (algebraMap K A b)) (algebraMap K A ζ) *
              AdjoinRoot.root (X ^ l - C (algebraMap K A b))
          simpa [ηA, Algebra.smul_def] using
            autAdjoinRootXPowSubC_root (algebraMap K A b) ηA
        calc
          σ βE = σA βE := rfl
          _ = algebraMap A E (algebraMap K A ζ) * βE := hσβA
          _ = algebraMap K E ζ * βE := by
                rw [IsScalarTower.algebraMap_apply K A E]
      exact (kummer_chebotarev_contradiction hl hx hy hζ hαpow hβpow σ hσα hσβ
        hsupport).elim

/-- Taking the rational norm of the cyclotomic Kummer relation gives one congruence,
with a coefficient independent of the rational prime whose valuation is used. -/
private theorem support_valuation_modeq
    {x y : ℕ} (hx : 1 ≤ x) (hy : 1 ≤ y)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1))
    (l : ℕ) (hl : l.Prime) :
    ∃ j < l, ∀ r : ℕ, r.Prime →
      (padicValNat r y : ℤ) ≡ (j : ℤ) * padicValNat r x [ZMOD l] := by
  let : NeZero l := ⟨hl.ne_zero⟩
  let K := CyclotomicField l ℚ
  let : IsCyclotomicExtension {l} ℚ K :=
    CyclotomicField.isCyclotomicExtension l ℚ
  obtain ⟨j, hj, z, hzrel⟩ := support_kummer_relation hx hy hsupport l hl
  have hrel : algebraMap ℚ K (y : ℚ) =
      (algebraMap ℚ K (x : ℚ)) ^ j * z ^ l := by
    simpa only [map_natCast] using hzrel
  have hz : z ≠ 0 := by
    intro hz
    have hy0 : (y : K) = 0 := by simpa [hz, hl.ne_zero] using hzrel
    exact (Nat.cast_ne_zero.mpr (by omega : y ≠ 0)) hy0
  have hdim : Module.finrank ℚ K = l - 1 := by
    rw [IsCyclotomicExtension.Rat.finrank l K, Nat.totient_prime hl]
  have hnorm : (y : ℚ) ^ (l - 1) =
      ((x : ℚ) ^ (l - 1)) ^ j * (Algebra.norm ℚ z) ^ l := by
    have hn := congrArg (Algebra.norm ℚ) hrel
    simpa only [map_mul, map_pow, Algebra.norm_algebraMap, hdim] using hn
  have hnormz : Algebra.norm ℚ z ≠ 0 := Algebra.norm_ne_zero_iff.mpr hz
  refine ⟨j, hj, ?_⟩
  intro r hr
  let : Fact r.Prime := ⟨hr⟩
  have hv := congrArg (padicValRat r) hnorm
  have hval : ((l - 1 : ℕ) : ℤ) * padicValNat r y =
      ((l - 1 : ℕ) : ℤ) * ((j : ℤ) * padicValNat r x) +
        (l : ℤ) * padicValRat r (Algebra.norm ℚ z) := by
    rw [padicValRat.mul
      (pow_ne_zero _ (pow_ne_zero _ (Nat.cast_ne_zero.mpr (by omega : x ≠ 0))))
      (pow_ne_zero _ hnormz)] at hv
    simp only [padicValRat.pow, padicValRat.of_nat] at hv
    linear_combination hv
  have hmodD : ((l - 1 : ℕ) : ℤ) * padicValNat r y ≡
      ((l - 1 : ℕ) : ℤ) * ((j : ℤ) * padicValNat r x) [ZMOD l] := by
    rw [Int.modEq_iff_dvd]
    use -padicValRat r (Algebra.norm ℚ z)
    linear_combination -hval
  have hD : ((l - 1 : ℕ) : ℤ) ≡ -1 [ZMOD l] := by
    rw [Int.modEq_iff_dvd]
    rw [Int.natCast_sub (by omega : 1 ≤ l)]
    use -1
    ring
  have hneg : (-1 : ℤ) * padicValNat r y ≡
      (-1 : ℤ) * ((j : ℤ) * padicValNat r x) [ZMOD l] :=
    (hD.mul Int.ModEq.rfl).symm.trans (hmodD.trans (hD.mul Int.ModEq.rfl))
  simpa using hneg.neg

/-- Every two-by-two minor of the rational-prime valuation vectors of `x` and `y`
vanishes.  A prime larger than the absolute value of a chosen minor detects this. -/
private theorem valuation_minor_eq_zero
    {x y : ℕ} (hx : 1 ≤ x) (hy : 1 ≤ y)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1))
    (r s : ℕ) (hr : r.Prime) (hs : s.Prime) :
    (padicValNat r x : ℤ) * padicValNat s y -
      (padicValNat s x : ℤ) * padicValNat r y = 0 := by
  let D : ℤ := (padicValNat r x : ℤ) * padicValNat s y -
    (padicValNat s x : ℤ) * padicValNat r y
  obtain ⟨l, hlD, hl⟩ := Nat.exists_infinite_primes (D.natAbs + 1)
  obtain ⟨j, -, hj⟩ := support_valuation_modeq hx hy hsupport l hl
  have hjr := hj r hr
  have hjs := hj s hs
  have hmul1 : (padicValNat r x : ℤ) * padicValNat s y ≡
      (padicValNat r x : ℤ) * ((j : ℤ) * padicValNat s x) [ZMOD l] :=
    Int.ModEq.rfl.mul hjs
  have hmul2 : (padicValNat s x : ℤ) * padicValNat r y ≡
      (padicValNat s x : ℤ) * ((j : ℤ) * padicValNat r x) [ZMOD l] :=
    Int.ModEq.rfl.mul hjr
  have hD0 : D ≡ 0 [ZMOD l] := by
    dsimp [D]
    convert hmul1.sub hmul2 using 1
    all_goals ring
  have hldiv : (l : ℤ) ∣ D := by
    have := Int.modEq_iff_dvd.mp hD0
    simpa using this
  have hDltNat : D.natAbs < l := by omega
  have hDlt : |D| < (l : ℤ) := by
    rw [← Int.natCast_natAbs]
    exact_mod_cast hDltNat
  exact Int.eq_zero_of_abs_lt_dvd hldiv hDlt

/-- The prime-power cyclotomic value of an integer greater than one has a prime
divisor different from the indexing prime. -/
private theorem exists_other_prime_dvd_prime_power_geom_sum
    {g q k : ℕ} (hg : 1 < g) (hq : q.Prime) (hk : 2 ≤ k) :
    ∃ p : ℕ, p.Prime ∧ p ≠ q ∧
      p ∣ ∑ i ∈ Finset.range q, (g ^ (q ^ (k - 1))) ^ i := by
  let u := g ^ (q ^ (k - 1))
  let C := ∑ i ∈ Finset.range q, u ^ i
  have hu : 1 < u := by
    exact one_lt_pow₀ hg (pow_ne_zero _ hq.ne_zero)
  have hCgt : q < C := by
    calc
      q = ∑ _i ∈ Finset.range q, 1 := by simp
      _ < ∑ i ∈ Finset.range q, u ^ i := by
        apply Finset.sum_lt_sum
        · intro i _
          exact one_le_pow₀ hu.le
        · exact ⟨1, Finset.mem_range.mpr hq.one_lt, by simpa using hu⟩
      _ = C := rfl
  have hCne : C ≠ 0 := by omega
  have hgeom : C * (u - 1) = u ^ q - 1 := by
    have hadd : C * (u - 1) + 1 = u ^ q := by
      simpa [C, Nat.sub_add_cancel hu.le] using geom_sum_mul_add (u - 1) q
    omega
  by_cases hqC : q ∣ C
  · let : Fact q.Prime := ⟨hq⟩
    have hCzero : (C : ZMod q) = 0 := (ZMod.natCast_eq_zero_iff C q).2 hqC
    have hgeomZ := congrArg (Nat.castRingHom (ZMod q)) hgeom
    have huZ : (u : ZMod q) = 1 := by
      simp only [map_mul] at hgeomZ
      change (C : ZMod q) * ((u - 1 : ℕ) : ZMod q) =
        ((u ^ q - 1 : ℕ) : ZMod q) at hgeomZ
      rw [Nat.cast_sub hu.le, Nat.cast_sub (one_le_pow₀ hu.le)] at hgeomZ
      have hupow : ((u ^ q : ℕ) : ZMod q) = (u : ZMod q) ^ q :=
        map_pow (Nat.castRingHom (ZMod q)) u q
      rw [hCzero, zero_mul, hupow, ZMod.pow_card] at hgeomZ
      norm_num at hgeomZ
      exact sub_eq_zero.mp hgeomZ.symm
    have hqusub : q ∣ u - 1 := by
      apply (ZMod.natCast_eq_zero_iff (u - 1) q).mp
      rw [Nat.cast_sub hu.le, huZ]
      norm_num
    have hqnu : ¬q ∣ u := by
      intro hqu
      have huzero : (u : ZMod q) = 0 := (ZMod.natCast_eq_zero_iff u q).2 hqu
      rw [huzero] at huZ
      exact zero_ne_one huZ
    have hqSqC : ¬q ^ 2 ∣ C := by
      by_cases hq2 : q = 2
      · subst q
        have hCeq : C = u + 1 := by simp [C]
        obtain ⟨v, huv⟩ : ∃ v : ℕ, u = v ^ 2 := by
          refine ⟨g ^ (2 ^ (k - 2)), ?_⟩
          dsimp [u]
          have hk1 : k - 1 = (k - 2) + 1 := by omega
          rw [hk1, pow_succ, pow_mul]
        intro h4
        have hCfour : (C : ZMod 4) = 0 :=
          (ZMod.natCast_eq_zero_iff C 4).2 h4
        rw [hCeq, huv] at hCfour
        push_cast at hCfour
        have hnosq : ∀ a : ZMod 4, a ^ 2 + 1 ≠ 0 := by decide
        exact hnosq (v : ZMod 4) hCfour
      · have hodd : Odd q := hq.odd_of_ne_two hq2
        have hprodval : padicValNat q C + padicValNat q (u - 1) =
            padicValNat q (u ^ q - 1) := by
          rw [← padicValNat.mul hCne (by omega : u - 1 ≠ 0), hgeom]
        have hlte : padicValNat q (u ^ q - 1) =
            padicValNat q (u - 1) + padicValNat q q :=
          by simpa using
            (padicValNat.pow_sub_pow hodd hu hqusub hqnu hq.ne_zero)
        have hvalC : padicValNat q C = 1 := by
          rw [padicValNat_self] at hlte
          omega
        intro hqpowC
        have htwo : 2 ≤ padicValNat q C :=
          (padicValNat_dvd_iff_le hCne).mp hqpowC
        omega
    have hdivgt : 1 < C / q := by
      rw [Nat.lt_div_iff_mul_lt' hqC]
      simpa using hCgt
    obtain ⟨p, hp, hpdiv⟩ := Nat.exists_prime_and_dvd (by omega : C / q ≠ 1)
    have hpC : p ∣ C := hpdiv.trans (Nat.div_dvd_of_dvd hqC)
    have hpq : p ≠ q := by
      intro hpq
      subst p
      apply hqSqC
      rw [pow_two, ← Nat.dvd_div_iff_mul_dvd hqC]
      exact hpdiv
    exact ⟨p, hp, hpq, by simpa [C, u] using hpC⟩
  · have hCone : C ≠ 1 :=
      ne_of_gt (lt_trans Nat.one_lt_two (hq.two_le.trans_lt hCgt))
    obtain ⟨p, hp, hpC⟩ := Nat.exists_prime_and_dvd hCone
    have hpq : p ≠ q := by
      intro hpq
      exact hqC (hpq ▸ hpC)
    exact ⟨p, hp, hpq, by simpa [C, u] using hpC⟩

/-- For every prime power `q^k`, with `k ≥ 2`, reduction of `g > 1` has exact
multiplicative order `q^k` modulo some rational prime. -/
private theorem exists_prime_orderOf_eq_prime_power
    {g q k : ℕ} (hg : 1 < g) (hq : q.Prime) (hk : 2 ≤ k) :
    ∃ p : ℕ, p.Prime ∧ p ≠ q ∧ ¬p ∣ g ∧
      orderOf (g : ZMod p) = q ^ k := by
  obtain ⟨p, hp, hpq, hpC⟩ :=
    exists_other_prime_dvd_prime_power_geom_sum hg hq hk
  let : Fact p.Prime := ⟨hp⟩
  have hpqpow : ¬p ∣ q ^ k := by
    exact (hp.coprime_iff_not_dvd.mp
      (Nat.Coprime.pow_right k ((Nat.coprime_primes hp hq).2 hpq)))
  let : NeZero ((q ^ k : ℕ) : ZMod p) := NeZero.of_not_dvd (ZMod p) hpqpow
  have hzero :
      (↑(∑ i ∈ Finset.range q, (g ^ (q ^ (k - 1))) ^ i) : ZMod p) = 0 :=
    (ZMod.natCast_eq_zero_iff _ _).2 hpC
  have hroot : (cyclotomic (q ^ k) (ZMod p)).IsRoot (g : ZMod p) := by
    rw [show k = (k - 1) + 1 by omega,
      cyclotomic_prime_pow_eq_geom_sum hq]
    rw [IsRoot.def, eval_finsetSum]
    simp only [eval_pow, eval_X]
    push_cast at hzero
    exact hzero
  have hprim : IsPrimitiveRoot (g : ZMod p) (q ^ k) :=
    isRoot_cyclotomic_iff.mp hroot
  have hcop : g.Coprime p :=
    coprime_of_root_cyclotomic (pow_pos hq.pos k) hroot
  have hpnotg : ¬p ∣ g := hp.coprime_iff_not_dvd.mp hcop.symm
  exact ⟨p, hp, hpq, hpnotg, hprim.eq_orderOf.symm⟩

/-- When both integers exceed one, the vanishing valuation minors give a
positive integral power relation. -/
private theorem exists_positive_power_relation
    {x y : ℕ} (hx : 1 < x) (hy : 1 < y)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1)) :
    ∃ A B : ℕ, 0 < A ∧ 0 < B ∧ x ^ B = y ^ A := by
  obtain ⟨r, hr, hrx⟩ := Nat.ne_one_iff_exists_prime_dvd.mp hx.ne'
  obtain ⟨s, hs, hsy⟩ := Nat.ne_one_iff_exists_prime_dvd.mp hy.ne'
  let A := padicValNat r x
  let B := padicValNat r y
  let : Fact r.Prime := ⟨hr⟩
  have hA : 0 < A := one_le_padicValNat_of_dvd (by omega : x ≠ 0) hrx
  have hsyval : 0 < padicValNat s y := by
    let : Fact s.Prime := ⟨hs⟩
    exact one_le_padicValNat_of_dvd (by omega : y ≠ 0) hsy
  have hminorRS := valuation_minor_eq_zero hx.le hy.le hsupport r s hr hs
  have hminorNat : padicValNat r x * padicValNat s y =
      padicValNat s x * padicValNat r y := by
    exact_mod_cast sub_eq_zero.mp hminorRS
  have hB : 0 < B := by
    by_contra hB0
    have hBzero : padicValNat r y = 0 := by omega
    rw [hBzero, mul_zero] at hminorNat
    have hprodpos : 0 < padicValNat r x * padicValNat s y :=
      Nat.mul_pos (by simpa [A] using hA) hsyval
    omega
  refine ⟨A, B, hA, hB, Nat.eq_of_factorization_eq
    (pow_ne_zero _ (by omega : x ≠ 0))
    (pow_ne_zero _ (by omega : y ≠ 0)) ?_⟩
  intro p
  by_cases hp : p.Prime
  · have hminor := valuation_minor_eq_zero hx.le hy.le hsupport r p hr hp
    have hminorP : padicValNat r x * padicValNat p y =
        padicValNat p x * padicValNat r y := by
      exact_mod_cast sub_eq_zero.mp hminor
    simp only [Nat.factorization_pow, Finsupp.smul_apply, nsmul_eq_mul,
      Nat.factorization_def _ hp]
    simpa [A, B, mul_comm, mul_left_comm, mul_assoc] using hminorP.symm
  · simp [Nat.factorization_pow, Nat.factorization_eq_zero_of_not_prime, hp]

/-- Equality of supports for all positive exponents makes the two nonzero
residue classes have the same multiplicative order. -/
private theorem orderOf_zmod_eq_of_support
    {x y p : ℕ} (hx : 1 ≤ x) (hy : 1 ≤ y)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1))
    (hp : p.Prime) (hpx : ¬p ∣ x) (hpy : ¬p ∣ y) :
    orderOf (x : ZMod p) = orderOf (y : ZMod p) := by
  let : Fact p.Prime := ⟨hp⟩
  have hx0 : (x : ZMod p) ≠ 0 := by
    simpa [ZMod.natCast_eq_zero_iff] using hpx
  have hy0 : (y : ZMod p) ≠ 0 := by
    simpa [ZMod.natCast_eq_zero_iff] using hpy
  have hxfin : IsOfFinOrder (x : ZMod p) :=
    isOfFinOrder_iff_pow_eq_one.mpr
      ⟨p - 1, Nat.sub_pos_of_lt hp.one_lt, ZMod.pow_card_sub_one_eq_one hx0⟩
  have hyfin : IsOfFinOrder (y : ZMod p) :=
    isOfFinOrder_iff_pow_eq_one.mpr
      ⟨p - 1, Nat.sub_pos_of_lt hp.one_lt, ZMod.pow_card_sub_one_eq_one hy0⟩
  have transfer (n : ℕ) (hn : 1 ≤ n)
      (hxn : (x : ZMod p) ^ n = 1) : (y : ZMod p) ^ n = 1 := by
    have hpxn : p ∣ x ^ n - 1 := by
      apply (ZMod.natCast_eq_zero_iff (x ^ n - 1) p).mp
      rw [Nat.cast_sub (one_le_pow₀ hx)]
      push_cast
      rw [hxn, sub_self]
    have hpyn := (hsupport n hn p hp).mp hpxn
    have hzero : ((y ^ n - 1 : ℕ) : ZMod p) = 0 :=
      (ZMod.natCast_eq_zero_iff _ _).2 hpyn
    rw [Nat.cast_sub (one_le_pow₀ hy)] at hzero
    push_cast at hzero
    exact sub_eq_zero.mp hzero
  have transfer' (n : ℕ) (hn : 1 ≤ n)
      (hyn : (y : ZMod p) ^ n = 1) : (x : ZMod p) ^ n = 1 := by
    have hpyn : p ∣ y ^ n - 1 := by
      apply (ZMod.natCast_eq_zero_iff (y ^ n - 1) p).mp
      rw [Nat.cast_sub (one_le_pow₀ hy)]
      push_cast
      rw [hyn, sub_self]
    have hpxn := (hsupport n hn p hp).mpr hpyn
    have hzero : ((x ^ n - 1 : ℕ) : ZMod p) = 0 :=
      (ZMod.natCast_eq_zero_iff _ _).2 hpxn
    rw [Nat.cast_sub (one_le_pow₀ hx)] at hzero
    push_cast at hzero
    exact sub_eq_zero.mp hzero
  apply Nat.dvd_antisymm
  · exact orderOf_dvd_of_pow_eq_one
      (transfer' (orderOf (y : ZMod p)) hyfin.orderOf_pos
        (pow_orderOf_eq_one (y : ZMod p)))
  · exact orderOf_dvd_of_pow_eq_one
      (transfer (orderOf (x : ZMod p)) hxfin.orderOf_pos
        (pow_orderOf_eq_one (x : ZMod p)))

/-- If positive powers of `x` and `y` agree, equality of the prime supports forces the
two exponents to agree.  At each prime `q`, choose an auxiliary prime modulo which `x`
has order a sufficiently large power of `q`; the common-support hypothesis makes the
order of `y` the same.  Taking orders in `x ^ B = y ^ A` then reads off the truncated
`q`-adic valuations of `A` and `B`. -/
private theorem exponents_eq_of_power_relation
    {x y A B : ℕ} (hx : 1 < x) (hy : 1 < y) (hA : 0 < A) (hB : 0 < B)
    (hpower : x ^ B = y ^ A)
    (hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
      p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1)) :
    A = B := by
  apply Nat.eq_of_factorization_eq hA.ne' hB.ne'
  intro q
  by_cases hq : q.Prime
  · let k := max (A.factorization q) (B.factorization q) + 2
    have hk : 2 ≤ k := by simp [k]
    obtain ⟨p, hp, hpq, hpx, hordx⟩ :=
      exists_prime_orderOf_eq_prime_power hx hq hk
    have hpy : ¬p ∣ y := by
      intro hpdy
      apply hpx
      apply hp.dvd_of_dvd_pow
      rw [hpower]
      exact dvd_pow hpdy hA.ne'
    have hordxy := orderOf_zmod_eq_of_support hx.le hy.le hsupport hp hpx hpy
    have hpowZ : (x : ZMod p) ^ B = (y : ZMod p) ^ A := by
      simpa only [Nat.cast_pow] using congrArg (fun n : ℕ => (n : ZMod p)) hpower
    have hquot : q ^ k / (q ^ k).gcd B = q ^ k / (q ^ k).gcd A := by
      have horders := congrArg orderOf hpowZ
      rw [orderOf_pow' _ hB.ne', orderOf_pow' _ hA.ne', ← hordxy, hordx] at horders
      exact horders
    have hqpow : 0 < q ^ k := pow_pos hq.pos k
    have hgcdB : 0 < (q ^ k).gcd B := Nat.gcd_pos_of_pos_left B hqpow
    have hquotpos : 0 < q ^ k / (q ^ k).gcd B :=
      Nat.div_pos (Nat.gcd_le_left B hqpow) hgcdB
    have hgcd : (q ^ k).gcd B = (q ^ k).gcd A := by
      apply Nat.mul_left_cancel hquotpos
      calc
        (q ^ k / (q ^ k).gcd B) * (q ^ k).gcd B = q ^ k :=
          Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
        _ = (q ^ k / (q ^ k).gcd A) * (q ^ k).gcd A :=
          (Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)).symm
        _ = (q ^ k / (q ^ k).gcd B) * (q ^ k).gcd A := by rw [hquot]
    have hfac := congrArg (fun n : ℕ => n.factorization q) hgcd
    have htrunc : min k (B.factorization q) = min k (A.factorization q) := by
      simpa only [Nat.factorization_gcd (pow_ne_zero _ hq.ne_zero) hB.ne',
        Nat.factorization_gcd (pow_ne_zero _ hq.ne_zero) hA.ne',
        Finsupp.inf_apply, Nat.factorization_pow_self hq] using hfac
    have hBk : B.factorization q ≤ k := by
      have := le_max_right (A.factorization q) (B.factorization q)
      dsimp [k]
      omega
    have hAk : A.factorization q ≤ k := by
      have := le_max_left (A.factorization q) (B.factorization q)
      dsimp [k]
      omega
    simpa [Nat.min_eq_right hBk, Nat.min_eq_right hAk] using htrunc.symm
  · simp [Nat.factorization_eq_zero_of_not_prime, hq]

/-- Erdős Problem 1214.  If the prime supports of `x ^ n - 1` and `y ^ n - 1`
coincide for every positive `n`, then `x = y`. -/
theorem erdos_1214 :
    ∀ x y : ℕ, x ≥ 1 → y ≥ 1 →
      (∀ n : ℕ, n ≥ 1 →
        {p : ℕ | p.Prime ∧ p ∣ x ^ n - 1} =
          {p : ℕ | p.Prime ∧ p ∣ y ^ n - 1}) →
      x = y := by
  refine Iff.mp ?_ trivial
  constructor
  · intro _ x y hx hy hsets
    have hsupport : ∀ m : ℕ, 1 ≤ m → ∀ p : ℕ,
        p.Prime → (p ∣ x ^ m - 1 ↔ p ∣ y ^ m - 1) := by
      intro m hm p hp
      have hmem := Set.ext_iff.mp (hsets m hm) p
      simpa only [Set.mem_ofPred_eq, hp, true_and] using hmem
    by_cases hxone : x = 1
    · subst x
      have hyone : y = 1 := by
        by_contra hyne
        have hylt : 1 < y := by omega
        obtain ⟨p, hpy, hp⟩ := Nat.exists_infinite_primes (y + 1)
        have hpdiv : p ∣ y - 1 := by
          simpa using (hsupport 1 (by omega) p hp).mp (by simp)
        have hple : p ≤ y - 1 := Nat.le_of_dvd (by omega) hpdiv
        omega
      exact hyone.symm
    by_cases hyone : y = 1
    · subst y
      have hxone' : x = 1 := by
        by_contra hxne
        have hxlt : 1 < x := by omega
        obtain ⟨p, hpx, hp⟩ := Nat.exists_infinite_primes (x + 1)
        have hpdiv : p ∣ x - 1 := by
          simpa using (hsupport 1 (by omega) p hp).mpr (by simp)
        have hple : p ≤ x - 1 := Nat.le_of_dvd (by omega) hpdiv
        omega
      exact hxone'
    have hxlt : 1 < x := by omega
    have hylt : 1 < y := by omega
    obtain ⟨A, B, hA, hB, hpower⟩ :=
      exists_positive_power_relation hxlt hylt hsupport
    have hAB := exponents_eq_of_power_relation hxlt hylt hA hB hpower hsupport
    rw [hAB] at hpower
    exact Nat.pow_left_injective hB.ne' hpower
  · intro _
    trivial

#print axioms erdos_1214

end

end Erdos1214
