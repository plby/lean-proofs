import ErdosProblems.Erdos182.ExactOrder
import Mathlib.Combinatorics.SimpleGraph.Bipartite
import Mathlib.Combinatorics.SimpleGraph.DegreeSum
import Mathlib.Combinatorics.SimpleGraph.Maps
import Mathlib.Data.Fintype.EquivFin

/-!
# The deterministic layered graph used in the lower bound for Erdős 182

There is one distinguished base layer and `L` later layers.  Every base
vertex chooses one vertex in every later layer.  Thus the edges are naturally
indexed by `Fin (b none) × Fin L`.  Keeping this indexing explicit makes the
exact edge count independent of all analytic choices of the layer sizes.
-/

open Finset Fintype

namespace Erdos182

open scoped Classical

/-- Vertices in a family consisting of a base layer (`none`) and `L` later
layers (`some j`). -/
abbrev LayerVertex {L : ℕ} (b : Option (Fin L) → ℕ) :=
  Σ i : Option (Fin L), Fin (b i)

/-- The base-layer vertex with label `v`. -/
def baseVertex {L : ℕ} {b : Option (Fin L) → ℕ} (v : Fin (b none)) :
    LayerVertex b :=
  ⟨none, v⟩

/-- A vertex in later layer `j`. -/
def laterVertex {L : ℕ} {b : Option (Fin L) → ℕ} (j : Fin L)
    (v : Fin (b (some j))) : LayerVertex b :=
  ⟨some j, v⟩

/-- The unordered edge selected by base vertex `v` in later layer `j`. -/
def layerEdge {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (p : Fin (b none) × Fin L) : Sym2 (LayerVertex b) :=
  s(baseVertex p.1, laterVertex p.2 (choice p.1 p.2))

lemma layerEdge_injective {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j))) :
    Function.Injective (layerEdge choice) := by
  rintro ⟨v, j⟩ ⟨v', j'⟩ h
  rw [layerEdge, layerEdge, Sym2.eq_iff] at h
  rcases h with h | h
  · have hv : v = v' := by
      apply Fin.ext
      exact congrArg (fun x : LayerVertex b ↦ x.2.val) h.1
    have hj : j = j' := by
      have := congrArg Sigma.fst h.2
      simpa [laterVertex] using this
    exact Prod.ext hv hj
  · have hbad := congrArg Sigma.fst h.1
    simp [baseVertex, laterVertex] at hbad

lemma layerEdge_not_isDiag {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (p : Fin (b none) × Fin L) : ¬(layerEdge choice p).IsDiag := by
  rw [layerEdge, Sym2.mk_isDiag_iff]
  intro h
  have hbad := congrArg Sigma.fst h
  simp [baseVertex, laterVertex] at hbad

/-- The layered graph generated by `choice`. -/
noncomputable def layeredGraph {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j))) :
    SimpleGraph (LayerVertex b) :=
  SimpleGraph.fromEdgeSet (Set.range (layerEdge choice))

lemma edgeSet_layeredGraph {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j))) :
    (layeredGraph choice).edgeSet = Set.range (layerEdge choice) := by
  rw [layeredGraph, SimpleGraph.edgeSet_fromEdgeSet]
  ext e
  constructor
  · exact fun he ↦ he.1
  · intro he
    refine ⟨he, ?_⟩
    obtain ⟨p, rfl⟩ := he
    exact layerEdge_not_isDiag choice p

/-- There is exactly one edge for each pair consisting of a base vertex and a
later layer. -/
lemma card_edgeFinset_layeredGraph {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j))) :
    (layeredGraph choice).edgeFinset.card = b none * L := by
  classical
  have hedges : (layeredGraph choice).edgeFinset =
      Finset.univ.image (layerEdge choice) := by
    ext e
    simp [SimpleGraph.mem_edgeFinset, edgeSet_layeredGraph]
  rw [hedges, Finset.card_image_of_injective _ (layerEdge_injective choice),
    Finset.card_univ, Fintype.card_prod]
  simp

/-- A base vertex has exactly its chosen neighbor in each fixed later
layer. -/
lemma layeredGraph_adj_base_later_iff {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (v : Fin (b none)) (j : Fin L) (w : Fin (b (some j))) :
    (layeredGraph choice).Adj (baseVertex v) (laterVertex j w) ↔
      choice v j = w := by
  rw [layeredGraph, SimpleGraph.fromEdgeSet_adj]
  constructor
  · rintro ⟨⟨⟨x, k⟩, hxk⟩, _hne⟩
    rw [layerEdge, Sym2.eq_iff] at hxk
    rcases hxk with hxk | hxk
    · have hxv : x = v := by
        apply Fin.ext
        exact congrArg (fun z : LayerVertex b ↦ z.2.val) hxk.1
      have hkj : k = j := by
        exact Option.some.inj (congrArg Sigma.fst hxk.2)
      subst x
      subst k
      apply Fin.ext
      exact congrArg (fun z : LayerVertex b ↦ z.2.val) hxk.2
    · have hbad := congrArg Sigma.fst hxk.1
      simp [baseVertex, laterVertex] at hbad
  · intro hvw
    subst w
    refine ⟨⟨(v, j), rfl⟩, ?_⟩
    intro hbad
    have := congrArg Sigma.fst hbad
    simp [baseVertex, laterVertex] at this

/-- A labelled copy on `Fin n`, with unused labels serving as isolated padding
vertices. -/
noncomputable def paddedLayeredGraph {L n : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hcard : Fintype.card (LayerVertex b) ≤ n) : SimpleGraph (Fin n) :=
  (layeredGraph choice).map
    ((Fintype.equivFin (LayerVertex b)).toEmbedding.trans (Fin.castLEEmb hcard))

lemma card_edgeFinset_paddedLayeredGraph {L n : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hcard : Fintype.card (LayerVertex b) ≤ n) :
    (paddedLayeredGraph choice hcard).edgeFinset.card = b none * L := by
  classical
  rw [← Set.ncard_coe_finset, SimpleGraph.coe_edgeFinset,
    paddedLayeredGraph, SimpleGraph.edgeSet_map,
    Set.ncard_image_of_injective _
      ((Fintype.equivFin (LayerVertex b)).toEmbedding.trans
        (Fin.castLEEmb hcard)).sym2Map.injective,
    Set.ncard_eq_toFinset_card', ← SimpleGraph.edgeFinset,
    card_edgeFinset_layeredGraph]

/-- The explicit bipartition of the layered construction. -/
lemma layeredGraph_isBipartiteWith {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j))) :
    (layeredGraph choice).IsBipartiteWith
      {v | v.1 = none} {v | ∃ j : Fin L, v.1 = some j} := by
  constructor
  · rw [Set.disjoint_left]
    intro v hvbase hvlater
    obtain ⟨j, hj⟩ := hvlater
    cases hvbase.symm.trans hj
  · intro u v huv
    rw [layeredGraph, SimpleGraph.fromEdgeSet_adj] at huv
    obtain ⟨⟨x, j⟩, hxj⟩ := huv.1
    rw [layerEdge, Sym2.eq_iff] at hxj
    rcases hxj with hxj | hxj
    · refine Or.inl ⟨?_, ?_⟩
      · exact congrArg Sigma.fst hxj.1.symm
      · exact ⟨j, congrArg Sigma.fst hxj.2.symm⟩
    · refine Or.inr ⟨?_, ?_⟩
      · exact ⟨j, congrArg Sigma.fst hxj.2.symm⟩
      · exact congrArg Sigma.fst hxj.1.symm

/-- The layered construction is bipartite between its base layer and all
later layers. -/
lemma layeredGraph_isBipartite {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j))) :
    (layeredGraph choice).IsBipartite :=
  (layeredGraph_isBipartiteWith choice).isBipartite

/-- Adding isolated labels preserves bipartiteness. -/
lemma paddedLayeredGraph_isBipartite {L n : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hcard : Fintype.card (LayerVertex b) ≤ n) :
    (paddedLayeredGraph choice hcard).IsBipartite := by
  simpa only [paddedLayeredGraph] using
    (layeredGraph_isBipartite choice).map
      ((Fintype.equivFin (LayerVertex b)).toEmbedding.trans (Fin.castLEEmb hcard))

/-- A positive-degree regular subgraph in the padded graph pulls back through
the labelling embedding to the unpadded layered graph. -/
lemma containsRegularSubgraph_of_contains_paddedLayeredGraph
    {L n k : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hcard : Fintype.card (LayerVertex b) ≤ n) (hk : 0 < k)
    (hcontains : ContainsRegularSubgraph (paddedLayeredGraph choice hcard) k) :
    ContainsRegularSubgraph (layeredGraph choice) k := by
  apply containsRegularSubgraph_of_contains_map (layeredGraph choice)
    ((Fintype.equivFin (LayerVertex b)).toEmbedding.trans (Fin.castLEEmb hcard)) k hk
  simpa only [paddedLayeredGraph] using hcontains

/-- A nonempty vertex set spans at least `11/10` edges per vertex. -/
def DenseVertexSetBad {V : Type*} [Fintype V] (G : SimpleGraph V) : Prop :=
  ∃ S : Set V, S.Nonempty ∧
    11 * S.ncard ≤ 10 * (G.induce S).edgeSet.ncard

/-- The vertices in the base layer and in later layers strictly before `i`. -/
noncomputable def layerPrefix {L : ℕ} (b : Option (Fin L) → ℕ) (i : Fin L) :
    Finset (LayerVertex b) :=
  Finset.univ.filter fun v ↦
    v.1 = none ∨ ∃ j : Fin L, v.1 = some j ∧ j < i

@[simp]
lemma mem_layerPrefix {L : ℕ} {b : Option (Fin L) → ℕ} {i : Fin L}
    {v : LayerVertex b} :
    v ∈ layerPrefix b i ↔
      v.1 = none ∨ ∃ j : Fin L, v.1 = some j ∧ j < i := by
  simp [layerPrefix]

/-- The layers at or after the cutoff `i`. -/
noncomputable def layerTail {L : ℕ} (b : Option (Fin L) → ℕ) (i : Fin L) :
    Finset (LayerVertex b) :=
  Finset.univ \ layerPrefix b i

@[simp]
lemma mem_layerTail {L : ℕ} {b : Option (Fin L) → ℕ} {i : Fin L}
    {v : LayerVertex b} : v ∈ layerTail b i ↔ v ∉ layerPrefix b i := by
  simp [layerTail]

/-- The base layer as a finset. -/
noncomputable def baseLayer {L : ℕ} (b : Option (Fin L) → ℕ) :
    Finset (LayerVertex b) :=
  Finset.univ.filter fun v ↦ v.1 = none

/-- The single later layer at index `i`. -/
noncomputable def layerAt {L : ℕ} (b : Option (Fin L) → ℕ) (i : Fin L) :
    Finset (LayerVertex b) :=
  Finset.univ.filter fun v ↦ v.1 = some i

/-- The union of the layers strictly after `i`. -/
noncomputable def layerStrictTail {L : ℕ} (b : Option (Fin L) → ℕ) (i : Fin L) :
    Finset (LayerVertex b) :=
  Finset.univ.filter fun v ↦ ∃ j : Fin L, v.1 = some j ∧ i < j

/-- The bad event at scale `i`: a small set contained in the part of the
layered graph exposed before layer `i` spans at least `11/10` edges per
vertex.  The cutoff `1000 * b (some i)` is the one used in the lower-bound
construction. -/
def SparseEarlierSetBadAt {L : ℕ} (b : Option (Fin L) → ℕ)
    (G : SimpleGraph (LayerVertex b)) (i : Fin L) : Prop :=
  ∃ S : Finset (LayerVertex b), S.Nonempty ∧
    S ⊆ layerPrefix b i ∧ S.card ≤ 1000 * b (some i) ∧
      11 * S.card ≤ 10 * (G.induce (S : Set (LayerVertex b))).edgeFinset.card

/-- One of the prefix bad events occurs. -/
def SparseEarlierSetBad {L : ℕ} (b : Option (Fin L) → ℕ)
    (G : SimpleGraph (LayerVertex b)) : Prop :=
  ∃ i : Fin L, SparseEarlierSetBadAt b G i

/-- Removing at most a `4/15` fraction (measured against the retained set)
from a `3`-regular graph leaves a set spanning at least `11/10` edges per
retained vertex. -/
lemma dense_induce_of_three_regular
    {V : Type*} [Fintype V] [DecidableEq V]
    (H : SimpleGraph V) [DecidableRel H.Adj]
    (hreg : ∀ v, H.degree v = 3) (S : Finset V)
    (hlarge : 15 * (Fintype.card V - S.card) ≤ 4 * S.card) :
    11 * S.card ≤ 10 * (H.induce (S : Set V)).edgeFinset.card := by
  classical
  let T : Finset V := Sᶜ
  let I : Finset (Sym2 V) :=
    H.edgeFinset.filter fun e ↦ e.toFinset ⊆ S
  let O : Finset (Sym2 V) :=
    T.biUnion fun v ↦ H.incidenceFinset v
  have hcover : H.edgeFinset ⊆ I ∪ O := by
    intro e he
    by_cases hi : e.toFinset ⊆ S
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨he, hi⟩)
    · have hex : ∃ v ∈ e.toFinset, v ∉ S := by
        simpa [Finset.not_subset] using hi
      obtain ⟨v, hve, hvS⟩ := hex
      apply Finset.mem_union_right
      apply Finset.mem_biUnion.mpr
      refine ⟨v, ?_, ?_⟩
      · simp [T, hvS]
      · rw [H.incidenceFinset_eq_filter]
        simp only [Finset.mem_filter, he, true_and]
        simpa using hve
  have hcard : H.edgeFinset.card ≤ I.card + O.card := by
    calc
      H.edgeFinset.card ≤ (I ∪ O).card := Finset.card_le_card hcover
      _ ≤ I.card + O.card := Finset.card_union_le I O
  have hI : I.card = (H.induce (S : Set V)).edgeFinset.card := by
    simpa [I] using H.card_filter_edgeFinset_toFinset_subset S
  have hO : O.card ≤ 3 * T.card := by
    calc
      O.card ≤ ∑ v ∈ T, (H.incidenceFinset v).card := by
        simpa [O] using
          (Finset.card_biUnion_le (s := T) (t := fun v ↦ H.incidenceFinset v))
      _ = ∑ v ∈ T, H.degree v := by simp
      _ = 3 * T.card := by simp_rw [hreg]; simp [mul_comm]
  have hedge : H.edgeFinset.card ≤
      (H.induce (S : Set V)).edgeFinset.card + 3 * T.card := by
    omega
  have hhandshake : 3 * Fintype.card V = 2 * H.edgeFinset.card := by
    rw [← H.sum_degrees_eq_twice_card_edges]
    simp_rw [hreg]
    simp [mul_comm]
  have hT : T.card = Fintype.card V - S.card := by
    simpa only [T] using Finset.card_compl S
  have hS : S.card ≤ Fintype.card V := by
    simpa using Finset.card_le_univ S
  omega

/-- Structural data needed by the exact two-case prefix-localization
argument.  For a `3`-regular subgraph `H`, `S` is its part in the strict
prefix, `Y` its part in the cutoff layer, `T` its part in the strict tail,
and `A` its part in the base layer.  The last inequality records that tail
vertices cost at most three edges each and cutoff-layer edges cost at most
`min (3|Y|) |A|`. -/
def HasLayerLocalizationData {L : ℕ} {b : Option (Fin L) → ℕ}
    (G : SimpleGraph (LayerVertex b)) : Prop :=
  ∀ H : G.Subgraph, H.verts.Nonempty →
    (∀ v : H.verts, (H.coe.neighborSet v).ncard = 3) →
    ∃ i : Fin L,
      let X := H.verts.toFinset
      let S := X ∩ layerPrefix b i
      let Y := X ∩ layerAt b i
      let T := X ∩ layerStrictTail b i
      let A := X ∩ baseLayer b
      X.card ≤ 1000 * b (some i) ∧
      500 * T.card < X.card ∧
      2 * A.card = X.card ∧
      A.card ≤ S.card ∧
      S.card + Y.card + T.card = X.card ∧
      H.coe.edgeFinset.card ≤
        (G.induce (S : Set (LayerVertex b))).edgeFinset.card +
          3 * T.card + min (3 * Y.card) A.card

/-- A `3`-regular subgraph of a layered graph has twice as many vertices as
it has vertices on the later side of the bipartition.  Consequently a bound
on the total number of available later-layer vertices gives a bound on the
order of every such subgraph. -/
lemma regularSubgraph_card_le_two_mul_later
    {L M : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hLaterCard : (Finset.univ \ baseLayer b).card ≤ M)
    (H : (layeredGraph choice).Subgraph)
    (hreg : ∀ v : H.verts, (H.coe.neighborSet v).ncard = 3) :
    H.verts.ncard ≤ 2 * M := by
  classical
  let AH : Finset H.verts := Finset.univ.filter fun v ↦
    (v.1 : LayerVertex b).1 = none
  let BH : Finset H.verts := Finset.univ.filter fun v ↦
    ∃ j : Fin L, (v.1 : LayerVertex b).1 = some j
  have hdeg (v : H.verts) : H.coe.degree v = 3 := by
    rw [← H.coe.card_neighborSet_eq_degree, Set.fintypeCard_eq_ncard]
    exact hreg v
  have hparts : AH.card + BH.card = Fintype.card H.verts := by
    have hdis : Disjoint AH BH := by
      rw [Finset.disjoint_left]
      intro v hvA hvB
      simp only [AH, Finset.mem_filter, Finset.mem_univ, true_and] at hvA
      simp only [BH, Finset.mem_filter, Finset.mem_univ, true_and] at hvB
      obtain ⟨j, hj⟩ := hvB
      simp [hvA] at hj
    have hunion : AH ∪ BH = Finset.univ := by
      ext v
      simp only [Finset.mem_union, Finset.mem_univ, iff_true]
      rcases hidx : (v.1 : LayerVertex b).1 with _ | j
      · exact Or.inl (by simp [AH, hidx])
      · exact Or.inr (by simp [BH, hidx])
    rw [← Finset.card_union_of_disjoint hdis, hunion, Finset.card_univ]
  have hbip : H.coe.IsBipartiteWith (AH : Set H.verts) (BH : Set H.verts) := by
    simpa [AH, BH] using (layeredGraph_isBipartiteWith choice).subgraph H
  have hABeq : AH.card = BH.card := by
    have hsum := H.coe.isBipartiteWith_sum_degrees_eq hbip
    simp_rw [hdeg] at hsum
    have : AH.card * 3 = BH.card * 3 := by simpa using hsum
    omega
  let f : H.verts → LayerVertex b := fun v ↦ v.1
  have hBimage : (BH.image f).card = BH.card :=
    Finset.card_image_of_injective _ Subtype.val_injective
  have hBsub : BH.image f ⊆ Finset.univ \ baseLayer b := by
    intro v hv
    obtain ⟨w, hwB, rfl⟩ := Finset.mem_image.mp hv
    simp only [Finset.mem_sdiff, Finset.mem_univ, true_and]
    simp only [BH, Finset.mem_filter, Finset.mem_univ, true_and] at hwB
    obtain ⟨j, hj⟩ := hwB
    simp only [baseLayer, Finset.mem_filter, Finset.mem_univ, true_and]
    intro hnone
    change (w.1 : LayerVertex b).1 = none at hnone
    rw [hj] at hnone
    contradiction
  have hBcard : BH.card ≤ M := by
    rw [← hBimage]
    exact (Finset.card_le_card hBsub).trans hLaterCard
  rw [Set.fintypeCard_eq_ncard H.verts, Set.ncard_eq_toFinset_card'] at hparts
  rw [Set.ncard_eq_toFinset_card']
  omega

/-- The structural localization data for the layered graph.  The scale
selector is only required up to `B`; `hsize` supplies that bound for every
nonempty `3`-regular subgraph. -/
lemma layeredGraph_hasLayerLocalizationData
    {L B : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hsize : ∀ (H : (layeredGraph choice).Subgraph), H.verts.Nonempty →
      (∀ v : H.verts, (H.coe.neighborSet v).ncard = 3) → H.verts.ncard ≤ B)
    (hscale : ∀ s : ℕ, 0 < s → s ≤ B → ∃ i : Fin L,
      s ≤ 1000 * b (some i) ∧ 500 * (layerStrictTail b i).card < s) :
    HasLayerLocalizationData (layeredGraph choice) := by
  classical
  intro H hHne hHreg
  let X := H.verts.toFinset
  have hXpos : 0 < X.card := by
    obtain ⟨v, hv⟩ := hHne
    exact Finset.card_pos.mpr ⟨v, by simpa [X] using hv⟩
  have hXbound : X.card ≤ B := by
    rw [← Set.ncard_eq_toFinset_card']
    exact hsize H hHne hHreg
  obtain ⟨i, hsmall, htailFull⟩ := hscale X.card hXpos hXbound
  let S := X ∩ layerPrefix b i
  let Y := X ∩ layerAt b i
  let T := X ∩ layerStrictTail b i
  let A := X ∩ baseLayer b
  let SH : Finset H.verts := Finset.univ.filter fun v ↦ (v.1 : LayerVertex b) ∈ S
  let YH : Finset H.verts := Finset.univ.filter fun v ↦ (v.1 : LayerVertex b) ∈ Y
  let TH : Finset H.verts := Finset.univ.filter fun v ↦ (v.1 : LayerVertex b) ∈ T
  let AH : Finset H.verts := Finset.univ.filter fun v ↦ (v.1 : LayerVertex b) ∈ A
  let BH : Finset H.verts := Finset.univ.filter fun v ↦
    ∃ j : Fin L, (v.1 : LayerVertex b).1 = some j
  have hdeg (v : H.verts) : H.coe.degree v = 3 := by
    rw [← H.coe.card_neighborSet_eq_degree]
    rw [Set.fintypeCard_eq_ncard]
    exact hHreg v
  have hcardLift (U : Finset (LayerVertex b)) (hUX : U ⊆ X) :
      (Finset.univ.filter fun v : H.verts ↦ (v.1 : LayerVertex b) ∈ U).card = U.card := by
    let f : H.verts → LayerVertex b := fun v ↦ v.1
    have himage : (Finset.univ.filter fun v : H.verts ↦
        (v.1 : LayerVertex b) ∈ U).image f = U := by
      ext v
      simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
      constructor
      · rintro ⟨w, hw, rfl⟩
        exact hw
      · intro hv
        refine ⟨⟨v, ?_⟩, hv, rfl⟩
        simpa [X] using hUX hv
    calc
      (Finset.univ.filter fun v : H.verts ↦
          (v.1 : LayerVertex b) ∈ U).card =
          ((Finset.univ.filter fun v : H.verts ↦
            (v.1 : LayerVertex b) ∈ U).image f).card := by
        symm
        exact Finset.card_image_of_injective _ Subtype.val_injective
      _ = U.card := congrArg Finset.card himage
  have hAcard : AH.card = A.card := by
    change (Finset.univ.filter fun v : H.verts ↦
      (v.1 : LayerVertex b) ∈ A).card = A.card
    exact hcardLift A Finset.inter_subset_left
  have hXcard : X.card = Fintype.card H.verts := by
    simpa [X, Set.ncard_eq_toFinset_card'] using
      (Set.ncard_eq_toFinset_card' H.verts).symm
  have hpartsAB : AH.card + BH.card = Fintype.card H.verts := by
    have hdis : Disjoint AH BH := by
      rw [Finset.disjoint_left]
      intro v hvA hvB
      simp only [AH, Finset.mem_filter, Finset.mem_univ, true_and] at hvA
      simp only [BH, Finset.mem_filter, Finset.mem_univ, true_and] at hvB
      rcases hvB with ⟨j, hj⟩
      have hnone : (v.1 : LayerVertex b).1 = none := by
        change (v.1 : LayerVertex b) ∈ A at hvA
        simpa [A, baseLayer] using (Finset.mem_inter.mp hvA).2
      simp [hnone] at hj
    have hunion : AH ∪ BH = Finset.univ := by
      ext v
      simp only [Finset.mem_union, Finset.mem_univ, iff_true]
      rcases hidx : (v.1 : LayerVertex b).1 with _ | j
      · left
        simp [AH, A, X, baseLayer, hidx]
      · right
        exact by simp [BH, hidx]
    rw [← Finset.card_union_of_disjoint hdis, hunion, Finset.card_univ]
  have hbip : H.coe.IsBipartiteWith
      {v : H.verts | (v.1 : LayerVertex b).1 = none}
      {v : H.verts | ∃ j : Fin L, (v.1 : LayerVertex b).1 = some j} :=
    (layeredGraph_isBipartiteWith choice).subgraph H
  have hABeq : AH.card = BH.card := by
    have hbipFin : H.coe.IsBipartiteWith (AH : Set H.verts) (BH : Set H.verts) := by
      simpa [AH, BH, A, X, baseLayer] using hbip
    have hsum := H.coe.isBipartiteWith_sum_degrees_eq hbipFin
    simp_rw [hdeg] at hsum
    have hsum' : AH.card * 3 = BH.card * 3 := by simpa using hsum
    omega
  have hbase : 2 * A.card = X.card := by
    rw [← hAcard, hXcard]
    omega
  have hAbase : A.card ≤ S.card := by
    apply Finset.card_le_card
    intro v hv
    change v ∈ A at hv
    rcases Finset.mem_inter.mp hv with ⟨hvX, hvA⟩
    change v ∈ S
    apply Finset.mem_inter.mpr
    refine ⟨hvX, ?_⟩
    apply mem_layerPrefix.mpr
    exact Or.inl (by simpa [baseLayer] using hvA)
  have htail : 500 * T.card < X.card := by
    have hsub : T ⊆ layerStrictTail b i := Finset.inter_subset_right
    have hc := Finset.card_le_card hsub
    omega
  have hSY : Disjoint S Y := by
    rw [Finset.disjoint_left]
    intro v hvS hvY
    have hp := (Finset.mem_inter.mp hvS).2
    have hy := (Finset.mem_inter.mp hvY).2
    simp only [layerAt, Finset.mem_filter, Finset.mem_univ, true_and] at hy
    rcases (mem_layerPrefix.mp hp) with hb | ⟨j, hj, hji⟩
    · simp [hb] at hy
    · simp [hy] at hj
      subst j
      exact (lt_irrefl i hji).elim
  have hST : Disjoint S T := by
    rw [Finset.disjoint_left]
    intro v hvS hvT
    have hp := (Finset.mem_inter.mp hvS).2
    have ht := (Finset.mem_inter.mp hvT).2
    simp only [layerStrictTail, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    rcases ht with ⟨j, hj, hij⟩
    rcases (mem_layerPrefix.mp hp) with hb | ⟨j', hj', hj'i⟩
    · simp [hb] at hj
    · have : j' = j := Option.some.inj (hj'.symm.trans hj)
      subst j'
      omega
  have hYT : Disjoint Y T := by
    rw [Finset.disjoint_left]
    intro v hvY hvT
    have hy := (Finset.mem_inter.mp hvY).2
    have ht := (Finset.mem_inter.mp hvT).2
    simp only [layerAt, Finset.mem_filter, Finset.mem_univ, true_and] at hy
    simp only [layerStrictTail, Finset.mem_filter, Finset.mem_univ, true_and] at ht
    rcases ht with ⟨j, hj, hij⟩
    have : j = i := by simpa [hy] using hj.symm
    subst j
    exact (lt_irrefl i hij).elim
  have hunionSYT : S ∪ Y ∪ T = X := by
    ext v
    simp only [S, Y, T, Finset.mem_union, Finset.mem_inter]
    constructor
    · rintro ((⟨hvX, -⟩ | ⟨hvX, -⟩) | ⟨hvX, -⟩) <;> exact hvX
    · intro hvX
      rcases hidx : v.1 with _ | j
      · left; left
        exact ⟨hvX, mem_layerPrefix.mpr (Or.inl hidx)⟩
      · rcases lt_trichotomy j i with hji | hji | hij
        · left; left
          refine ⟨hvX, mem_layerPrefix.mpr (Or.inr ⟨j, hidx, hji⟩)⟩
        · left; right
          refine ⟨hvX, ?_⟩
          simp [layerAt, hidx, hji]
        · right
          refine ⟨hvX, ?_⟩
          simp [layerStrictTail, hidx, hij]
  have hpartition : S.card + Y.card + T.card = X.card := by
    have hSYT : Disjoint (S ∪ Y) T :=
      Finset.disjoint_union_left.mpr ⟨hST, hYT⟩
    calc
      S.card + Y.card + T.card = (S ∪ Y).card + T.card := by
        rw [Finset.card_union_of_disjoint hSY]
      _ = (S ∪ Y ∪ T).card := (Finset.card_union_of_disjoint hSYT).symm
      _ = X.card := congrArg Finset.card hunionSYT

  let I : Finset (Sym2 H.verts) :=
    H.coe.edgeFinset.filter fun e ↦ e.toFinset ⊆ SH
  let OT : Finset (Sym2 H.verts) :=
    TH.biUnion fun v ↦ H.coe.incidenceFinset v
  let C : Finset (Sym2 H.verts) :=
    AH.biUnion fun a ↦ (H.coe.incidenceFinset a).filter fun e ↦
      ∃ y ∈ YH, y ∈ e
  have hcover : H.coe.edgeFinset ⊆ I ∪ OT ∪ C := by
    intro e he
    induction e using Sym2.inductionOn with
    | _ u v =>
      have huv : H.coe.Adj u v := by
        simpa [SimpleGraph.mem_edgeFinset] using he
      rcases hbip.mem_of_adj huv with hside | hside
      · rcases hside with ⟨huBase, hvLater⟩
        rcases hvLater with ⟨j, hvj⟩
        have huS : (u.1 : LayerVertex b) ∈ S := by
          change (u.1 : LayerVertex b).1 = none at huBase
          simp [S, X, layerPrefix, huBase]
        rcases lt_trichotomy j i with hji | hji | hij
        · have hvS : (v.1 : LayerVertex b) ∈ S := by
            simp [S, X, layerPrefix, hvj, hji]
          apply Finset.mem_union_left
          apply Finset.mem_union_left
          rw [Finset.mem_filter]
          refine ⟨he, ?_⟩
          intro z hz
          rw [Sym2.toFinset_mk_eq] at hz
          simp only [Finset.mem_insert, Finset.mem_singleton] at hz
          rcases hz with rfl | rfl <;> simpa [SH]
        · have hvY : v ∈ YH := by
            simp [YH, Y, X, layerAt, hvj, hji]
          have huA : u ∈ AH := by
            change (u.1 : LayerVertex b).1 = none at huBase
            simp [AH, A, X, baseLayer, huBase]
          apply Finset.mem_union_right
          apply Finset.mem_biUnion.mpr
          refine ⟨u, huA, Finset.mem_filter.mpr ⟨?_, ⟨v, hvY, ?_⟩⟩⟩
          · rw [H.coe.incidenceFinset_eq_filter]
            exact Finset.mem_filter.mpr ⟨he, by simp⟩
          · simp
        · have hvT : v ∈ TH := by
            simp [TH, T, X, layerStrictTail, hvj, hij]
          apply Finset.mem_union_left
          apply Finset.mem_union_right
          apply Finset.mem_biUnion.mpr
          refine ⟨v, hvT, ?_⟩
          rw [H.coe.incidenceFinset_eq_filter]
          exact Finset.mem_filter.mpr ⟨he, by simp⟩
      · rcases hside with ⟨huLater, hvBase⟩
        rcases huLater with ⟨j, huj⟩
        have hvS : (v.1 : LayerVertex b) ∈ S := by
          change (v.1 : LayerVertex b).1 = none at hvBase
          simp [S, X, layerPrefix, hvBase]
        rcases lt_trichotomy j i with hji | hji | hij
        · have huS : (u.1 : LayerVertex b) ∈ S := by
            simp [S, X, layerPrefix, huj, hji]
          apply Finset.mem_union_left
          apply Finset.mem_union_left
          rw [Finset.mem_filter]
          refine ⟨he, ?_⟩
          intro z hz
          rw [Sym2.toFinset_mk_eq] at hz
          simp only [Finset.mem_insert, Finset.mem_singleton] at hz
          rcases hz with rfl | rfl <;> simpa [SH]
        · have huY : u ∈ YH := by
            simp [YH, Y, X, layerAt, huj, hji]
          have hvA : v ∈ AH := by
            change (v.1 : LayerVertex b).1 = none at hvBase
            simp [AH, A, X, baseLayer, hvBase]
          apply Finset.mem_union_right
          apply Finset.mem_biUnion.mpr
          refine ⟨v, hvA, Finset.mem_filter.mpr ⟨?_, ⟨u, huY, ?_⟩⟩⟩
          · rw [H.coe.incidenceFinset_eq_filter]
            exact Finset.mem_filter.mpr ⟨he, by simp⟩
          · simp
        · have huT : u ∈ TH := by
            simp [TH, T, X, layerStrictTail, huj, hij]
          apply Finset.mem_union_left
          apply Finset.mem_union_right
          apply Finset.mem_biUnion.mpr
          refine ⟨u, huT, ?_⟩
          rw [H.coe.incidenceFinset_eq_filter]
          exact Finset.mem_filter.mpr ⟨he, by simp⟩
  have hIeq : I.card = (H.coe.induce (SH : Set H.verts)).edgeFinset.card := by
    simpa [I] using H.coe.card_filter_edgeFinset_toFinset_subset SH
  let f : {v : H.verts // v ∈ (SH : Set H.verts)} ↪
      {v : LayerVertex b // v ∈ (S : Set (LayerVertex b))} :=
    ⟨fun v ↦ ⟨v.1.1, by simpa [SH] using v.2⟩, by
      intro x y hxy
      have hxy' : (x.1.1 : LayerVertex b) = (y.1.1 : LayerVertex b) :=
        congrArg (fun z : {v : LayerVertex b // v ∈ (S : Set (LayerVertex b))} ↦ z.1) hxy
      exact Subtype.ext (Subtype.ext hxy')⟩
  have hmaple : (H.coe.induce (SH : Set H.verts)).map f ≤
      (layeredGraph choice).induce (S : Set (LayerVertex b)) := by
    intro u v huv
    rw [SimpleGraph.map_adj] at huv
    obtain ⟨u', v', huv', rfl, rfl⟩ := huv
    exact H.adj_sub huv'
  have hI : I.card ≤
      ((layeredGraph choice).induce (S : Set (LayerVertex b))).edgeFinset.card := by
    rw [hIeq]
    calc
      (H.coe.induce (SH : Set H.verts)).edgeFinset.card =
          ((H.coe.induce (SH : Set H.verts)).map f).edgeFinset.card := by
            symm
            exact SimpleGraph.card_edgeFinset_map f _
      _ ≤ ((layeredGraph choice).induce
          (S : Set (LayerVertex b))).edgeFinset.card :=
        Finset.card_le_card (SimpleGraph.edgeFinset_mono hmaple)
  have hTHcard : TH.card = T.card := by
    change (Finset.univ.filter fun v : H.verts ↦
      (v.1 : LayerVertex b) ∈ T).card = T.card
    exact hcardLift T Finset.inter_subset_left
  have hOT : OT.card ≤ 3 * T.card := by
    calc
      OT.card ≤ ∑ v ∈ TH, (H.coe.incidenceFinset v).card := by
        simpa [OT] using
          (Finset.card_biUnion_le (s := TH) (t := fun v ↦ H.coe.incidenceFinset v))
      _ = ∑ v ∈ TH, H.coe.degree v := by simp
      _ = 3 * TH.card := by simp_rw [hdeg]; simp [mul_comm]
      _ = 3 * T.card := by rw [hTHcard]
  have hYHcard : YH.card = Y.card := by
    change (Finset.univ.filter fun v : H.verts ↦
      (v.1 : LayerVertex b) ∈ Y).card = Y.card
    exact hcardLift Y Finset.inter_subset_left
  let OY : Finset (Sym2 H.verts) :=
    YH.biUnion fun v ↦ H.coe.incidenceFinset v
  have hCsubOY : C ⊆ OY := by
    intro e he
    obtain ⟨a, ha, he⟩ := Finset.mem_biUnion.mp he
    obtain ⟨heinc, y, hyY, hye⟩ := Finset.mem_filter.mp he
    apply Finset.mem_biUnion.mpr
    refine ⟨y, hyY, ?_⟩
    rw [H.coe.incidenceFinset_eq_filter] at heinc ⊢
    have heinc' := Finset.mem_filter.mp heinc
    exact Finset.mem_filter.mpr ⟨heinc'.1, hye⟩
  have hOY : OY.card ≤ 3 * Y.card := by
    calc
      OY.card ≤ ∑ v ∈ YH, (H.coe.incidenceFinset v).card := by
        simpa [OY] using
          (Finset.card_biUnion_le (s := YH) (t := fun v ↦ H.coe.incidenceFinset v))
      _ = ∑ v ∈ YH, H.coe.degree v := by simp
      _ = 3 * YH.card := by simp_rw [hdeg]; simp [mul_comm]
      _ = 3 * Y.card := by rw [hYHcard]
  have hC3Y : C.card ≤ 3 * Y.card :=
    (Finset.card_le_card hCsubOY).trans hOY
  have hfiber (a : H.verts) (ha : a ∈ AH) :
      ((H.coe.incidenceFinset a).filter fun e ↦ ∃ y ∈ YH, y ∈ e).card ≤ 1 := by
    rw [Finset.card_le_one]
    intro e he e' he'
    obtain ⟨heinc, y, hyY, hye⟩ := Finset.mem_filter.mp he
    obtain ⟨heinc', y', hyY', hye'⟩ := Finset.mem_filter.mp he'
    rw [H.coe.incidenceFinset_eq_filter] at heinc heinc'
    obtain ⟨heedge, hae⟩ := Finset.mem_filter.mp heinc
    obtain ⟨heedge', hae'⟩ := Finset.mem_filter.mp heinc'
    have hay : a ≠ y := by
      intro hay
      have haNone : (a.1 : LayerVertex b).1 = none := by
        have haA : (a.1 : LayerVertex b) ∈ A := by simpa [AH] using ha
        simpa [A, baseLayer] using (Finset.mem_inter.mp haA).2
      have hySome : (y.1 : LayerVertex b).1 = some i := by
        have hyY' : (y.1 : LayerVertex b) ∈ Y := by simpa [YH] using hyY
        simpa [Y, layerAt] using (Finset.mem_inter.mp hyY').2
      rw [hay] at haNone
      simp [hySome] at haNone
    have hay' : a ≠ y' := by
      intro hay'
      have haNone : (a.1 : LayerVertex b).1 = none := by
        have haA : (a.1 : LayerVertex b) ∈ A := by simpa [AH] using ha
        simpa [A, baseLayer] using (Finset.mem_inter.mp haA).2
      have hySome : (y'.1 : LayerVertex b).1 = some i := by
        have hyY'' : (y'.1 : LayerVertex b) ∈ Y := by simpa [YH] using hyY'
        simpa [Y, layerAt] using (Finset.mem_inter.mp hyY'').2
      rw [hay'] at haNone
      simp [hySome] at haNone
    have heq : e = s(a, y) := (Sym2.mem_and_mem_iff hay).mp ⟨hae, hye⟩
    have heq' : e' = s(a, y') := (Sym2.mem_and_mem_iff hay').mp ⟨hae', hye'⟩
    have hadj : H.coe.Adj a y := by
      simpa [heq, SimpleGraph.mem_edgeFinset] using heedge
    have hadj' : H.coe.Adj a y' := by
      simpa [heq', SimpleGraph.mem_edgeFinset] using heedge'
    have haNone : (a.1 : LayerVertex b).1 = none := by
      have haA : (a.1 : LayerVertex b) ∈ A := by simpa [AH] using ha
      simpa [A, baseLayer] using (Finset.mem_inter.mp haA).2
    obtain ⟨av, hav⟩ : ∃ av : Fin (b none),
        (a.1 : LayerVertex b) = baseVertex av := by
      rcases ha0 : (a.1 : LayerVertex b) with ⟨_ | j, av⟩
      · exact ⟨av, rfl⟩
      · simp [ha0] at haNone
    have hySome : (y.1 : LayerVertex b).1 = some i := by
      have hyY' : (y.1 : LayerVertex b) ∈ Y := by simpa [YH] using hyY
      simpa [Y, layerAt] using (Finset.mem_inter.mp hyY').2
    obtain ⟨yv, hyv⟩ : ∃ yv : Fin (b (some i)),
        (y.1 : LayerVertex b) = laterVertex i yv := by
      rcases hy0 : (y.1 : LayerVertex b) with ⟨_ | j, yv⟩
      · simp [hy0] at hySome
      · have hji : j = i := Option.some.inj (by simpa [hy0] using hySome)
        subst j
        exact ⟨yv, rfl⟩
    have hySome' : (y'.1 : LayerVertex b).1 = some i := by
      have hyY'' : (y'.1 : LayerVertex b) ∈ Y := by simpa [YH] using hyY'
      simpa [Y, layerAt] using (Finset.mem_inter.mp hyY'').2
    obtain ⟨yv', hyv'⟩ : ∃ yv' : Fin (b (some i)),
        (y'.1 : LayerVertex b) = laterVertex i yv' := by
      rcases hy0 : (y'.1 : LayerVertex b) with ⟨_ | j, yv'⟩
      · simp [hy0] at hySome'
      · have hji : j = i := Option.some.inj (by simpa [hy0] using hySome')
        subst j
        exact ⟨yv', rfl⟩
    have hchoice : choice av i = yv := by
      apply (layeredGraph_adj_base_later_iff choice av i yv).mp
      simpa [hav, hyv] using H.adj_sub hadj
    have hchoice' : choice av i = yv' := by
      apply (layeredGraph_adj_base_later_iff choice av i yv').mp
      simpa [hav, hyv'] using H.adj_sub hadj'
    have hyy : y = y' := by
      apply Subtype.ext
      rw [hyv, hyv', hchoice.symm.trans hchoice']
    rw [heq, heq', hyy]
  have hCA : C.card ≤ A.card := by
    calc
      C.card ≤ ∑ a ∈ AH,
          ((H.coe.incidenceFinset a).filter fun e ↦ ∃ y ∈ YH, y ∈ e).card := by
        simpa [C] using (Finset.card_biUnion_le (s := AH)
          (t := fun a ↦ (H.coe.incidenceFinset a).filter fun e ↦
            ∃ y ∈ YH, y ∈ e))
      _ ≤ ∑ _a ∈ AH, 1 := by
        exact Finset.sum_le_sum fun a ha ↦ hfiber a ha
      _ = AH.card := by simp
      _ = A.card := hAcard
  have hC : C.card ≤ min (3 * Y.card) A.card :=
    (Nat.le_min.mpr ⟨hC3Y, hCA⟩)
  have hedge0 : H.coe.edgeFinset.card ≤ I.card + OT.card + C.card := by
    calc
      H.coe.edgeFinset.card ≤ (I ∪ OT ∪ C).card := Finset.card_le_card hcover
      _ ≤ I.card + OT.card + C.card := by
        exact (Finset.card_union_le (I ∪ OT) C).trans
          (Nat.add_le_add_right (Finset.card_union_le I OT) C.card)
  have hedge : H.coe.edgeFinset.card ≤
      ((layeredGraph choice).induce (S : Set (LayerVertex b))).edgeFinset.card +
        3 * T.card + min (3 * Y.card) A.card := by
    omega
  exact ⟨i, hsmall, htail, hbase, hAbase, hpartition, hedge⟩

/-- A source-facing form of `layeredGraph_hasLayerLocalizationData`: a
cardinality bound for the union of the later layers automatically supplies
the required bound on every `3`-regular subgraph. -/
lemma layeredGraph_hasLayerLocalizationData_of_later_card
    {L M : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hLaterCard : (Finset.univ \ baseLayer b).card ≤ M)
    (hscale : ∀ s : ℕ, 0 < s → s ≤ 2 * M → ∃ i : Fin L,
      s ≤ 1000 * b (some i) ∧ 500 * (layerStrictTail b i).card < s) :
    HasLayerLocalizationData (layeredGraph choice) := by
  apply layeredGraph_hasLayerLocalizationData choice
  · intro H _hHne hHreg
    exact regularSubgraph_card_le_two_mul_later choice hLaterCard H hHreg
  · exact hscale

/-- The exact `0.9s` two-case argument: the structural layer facts force one
of the prefix bad events whenever a `3`-regular subgraph exists. -/
lemma sparseEarlierSetBad_of_containsThreeRegular_layered
    {L : ℕ} {b : Option (Fin L) → ℕ}
    (choice : (v : Fin (b none)) → (j : Fin L) → Fin (b (some j)))
    (hdata : HasLayerLocalizationData (layeredGraph choice))
    (hcontains : ContainsRegularSubgraph (layeredGraph choice) 3) :
    SparseEarlierSetBad b (layeredGraph choice) := by
  classical
  obtain ⟨H, hHne, hHreg⟩ := hcontains
  obtain ⟨i, hsmall, htail, hbase, hAbase, hpartition, hedge⟩ :=
    hdata H hHne hHreg
  let X := H.verts.toFinset
  let S := X ∩ layerPrefix b i
  let Y := X ∩ layerAt b i
  let T := X ∩ layerStrictTail b i
  let A := X ∩ baseLayer b
  change X.card ≤ 1000 * b (some i) at hsmall
  change 500 * T.card < X.card at htail
  change 2 * A.card = X.card at hbase
  change A.card ≤ S.card at hAbase
  change S.card + Y.card + T.card = X.card at hpartition
  change H.coe.edgeFinset.card ≤
    ((layeredGraph choice).induce (S : Set (LayerVertex b))).edgeFinset.card +
      3 * T.card + min (3 * Y.card) A.card at hedge
  have hXpos : 0 < X.card := by
    obtain ⟨v, hv⟩ := hHne
    exact Finset.card_pos.mpr ⟨v, by simpa [X] using hv⟩
  have hhandshake : 3 * X.card = 2 * H.coe.edgeFinset.card := by
    have hsum : ∑ v : H.verts, (H.coe.neighborSet v).ncard =
        2 * H.coe.edgeFinset.card := by
      simpa only [← SimpleGraph.card_neighborSet_eq_degree,
        Set.fintypeCard_eq_ncard] using H.coe.sum_degrees_eq_twice_card_edges
    have hcard : Fintype.card H.verts = X.card := by
      rw [Set.fintypeCard_eq_ncard H.verts, Set.ncard_eq_toFinset_card']
    have hsum' : 3 * Fintype.card H.verts = 2 * H.coe.edgeFinset.card := by
      calc
        3 * Fintype.card H.verts = ∑ _v : H.verts, 3 := by
          simp [Nat.mul_comm]
        _ = ∑ v : H.verts, (H.coe.neighborSet v).ncard := by
          apply Finset.sum_congr rfl
          intro v _hv
          exact (hHreg v).symm
        _ = 2 * H.coe.edgeFinset.card := hsum
    rw [← hcard]
    exact hsum'
  have hcrossA : min (3 * Y.card) A.card ≤ A.card := Nat.min_le_right _ _
  have hcrossY : min (3 * Y.card) A.card ≤ 3 * Y.card := Nat.min_le_left _ _
  have hdense : 11 * S.card ≤
      10 * ((layeredGraph choice).induce
        (S : Set (LayerVertex b))).edgeFinset.card := by
    by_cases hcase : 10 * S.card ≤ 9 * X.card
    · omega
    · have hcase' : 9 * X.card < 10 * S.card := Nat.lt_of_not_ge hcase
      omega
  have hSne : S.Nonempty := by
    apply Finset.card_pos.mp
    omega
  have hSprefix : S ⊆ layerPrefix b i := Finset.inter_subset_right
  have hSsmall : S.card ≤ 1000 * b (some i) :=
    (Finset.card_le_card Finset.inter_subset_left).trans hsmall
  exact ⟨i, S, hSne, hSprefix, hSsmall, hdense⟩

lemma denseVertexSetBad_of_sparseEarlierSetBad {L : ℕ}
    {b : Option (Fin L) → ℕ} {G : SimpleGraph (LayerVertex b)}
    (h : SparseEarlierSetBad b G) : DenseVertexSetBad G := by
  rcases h with ⟨i, S, hSne, _hprefix, _hsmall, hdense⟩
  refine ⟨S, ?_, ?_⟩
  · simpa using hSne
  · calc
      11 * (S : Set (LayerVertex b)).ncard = 11 * S.card := by
        rw [Set.ncard_coe_finset]
      _ ≤ 10 * (G.induce (S : Set (LayerVertex b))).edgeFinset.card := hdense
      _ = 10 * (G.induce (S : Set (LayerVertex b))).edgeSet.ncard := by
        rw [← Set.ncard_coe_finset, SimpleGraph.coe_edgeFinset]

/-- A `3`-regular subgraph itself supplies a bad vertex set: its `3|S|/2`
edges all occur in the ambient graph induced by its vertices. -/
lemma sparseEarlierSetBad_of_containsThreeRegular {V : Type*} [Fintype V]
    (G : SimpleGraph V) (hG : ContainsRegularSubgraph G 3) :
    DenseVertexSetBad G := by
  classical
  obtain ⟨H, hHne, hHreg⟩ := hG
  refine ⟨H.verts, hHne, ?_⟩
  have hhandshake : 3 * H.verts.ncard = 2 * H.coe.edgeSet.ncard := by
    have hsum : ∑ v : H.verts, (H.coe.neighborSet v).ncard =
        2 * H.coe.edgeFinset.card := by
      simpa only [← SimpleGraph.card_neighborSet_eq_degree,
        Set.fintypeCard_eq_ncard] using H.coe.sum_degrees_eq_twice_card_edges
    have hcard : Fintype.card H.verts = H.verts.ncard :=
      Set.fintypeCard_eq_ncard H.verts
    calc
      3 * H.verts.ncard = Fintype.card H.verts * 3 := by
        rw [hcard, Nat.mul_comm]
      _ = ∑ _v : H.verts, 3 := by simp
      _ = ∑ v : H.verts, (H.coe.neighborSet v).ncard := by
        apply Finset.sum_congr rfl
        intro v _hv
        exact (hHreg v).symm
      _ = 2 * H.coe.edgeFinset.card := hsum
      _ = 2 * H.coe.edgeSet.ncard := by
        rw [← Set.ncard_coe_finset, SimpleGraph.coe_edgeFinset]
  have hsub : H.coe.edgeSet.ncard ≤ (G.induce H.verts).edgeSet.ncard := by
    have hle : H.coe ≤ G.induce H.verts := by
      intro u v huv
      exact H.coe_adj_sub u v huv
    exact Set.ncard_le_ncard (SimpleGraph.edgeSet_mono hle)
  omega

/-- Excluding the sparse-set bad event excludes every nonempty `3`-regular
subgraph. -/
lemma isRegularSubgraphFree_three_of_not_sparseEarlierSetBad
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (hbad : ¬DenseVertexSetBad G) : IsRegularSubgraphFree G 3 := by
  intro hG
  exact hbad (sparseEarlierSetBad_of_containsThreeRegular G hG)

end Erdos182
