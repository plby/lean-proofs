import ErdosProblems.Erdos360.NormalizedFiberSelector
import ErdosProblems.Erdos360.AlmostPeriod

/-!
# An elementary normalized-fibre selector

Once a phase is expressed in the cyclic group generated by its remaining
shifts, the elementary Kneser bound for almost periods is already enough to
force a large increment.  Indeed, maximality puts every remaining shift in
the almost-period set.  Since those shifts generate the whole normalized
ambient group, that almost-period set cannot lie in a proper subgroup; its
cardinality is therefore at most `8 * e`.

This connector is independent of the local Deshouillers--Freiman inverse
theorem and of the progression sieve.  It is useful precisely in phases in
which the normalized fibre occupies less than half of its generated
subgroup and more than `8 * e` shifts remain.
-/

namespace Erdos360

open scoped Pointwise

attribute [local instance] Classical.propDecidable

/-- In a generated cyclic ambient group, a maximal translation cannot be an
`e`-almost period when both the fibre and the remaining shifts are larger
than `8e` and the fibre has density strictly below one half. -/
theorem subgroupCoordinates_maxPick_not_almostPeriods_elementary
    {b : ℕ} [NeZero b] {H : AddSubgroup (ZMod b)}
    [NeZero (Nat.card H)]
    (U X : Finset H) (hX : X.Nonempty) {e : ℕ}
    (hU : (subgroupCoordinates U).Nonempty)
    (he : 0 < e)
    (hUlarge : 8 * e < (subgroupCoordinates U).card)
    (hUsparse : 4 * (subgroupCoordinates U).card <
      2 * Fintype.card (ZMod (Nat.card H)))
    (hXlarge : 8 * e < (subgroupCoordinates X).card)
    (hgen : AddSubgroup.closure
      ((subgroupCoordinates X : Finset (ZMod (Nat.card H))) :
        Set (ZMod (Nat.card H))) = ⊤) :
    (subgroupZModEquiv H).symm (subgroupFiberMaxPick U X hX) ∉
      almostPeriods (subgroupCoordinates U) e := by
  intro hpick
  have hsubset : subgroupCoordinates X ⊆
      almostPeriods (subgroupCoordinates U) e :=
    subset_almostPeriods_of_translationNewMaximal
      (subgroupCoordinates_maxPick_maximal U X hX) hpick
  have hproper : ¬ ∃ K : AddSubgroup (ZMod (Nat.card H)), K ≠ ⊤ ∧
      ((almostPeriods (subgroupCoordinates U) e :
        Finset (ZMod (Nat.card H))) : Set (ZMod (Nat.card H))) ⊆
        (K : Set (ZMod (Nat.card H))) :=
    not_subset_proper_subgroup_of_closure_eq_top hgen hsubset
  have hcard := card_almostPeriods_le_eight_mul_of_not_proper
    hU he hUlarge hUsparse hproper
  have hXcard : (subgroupCoordinates X).card ≤
      (almostPeriods (subgroupCoordinates U) e).card :=
    Finset.card_le_card hsubset
  omega

/-- The elementary normalized selector gives an increment of the original
ambient subset-sum set.  The strict `8 * (D - 1)` hypotheses are the exact
integer form needed to recover an increment of at least `D`. -/
theorem normalizedFiberMaxPick_global_increment_elementary
    {b : ℕ} [NeZero b] (R S : Finset (ZMod b)) (u : ZMod b)
    (hR : R.Nonempty) {D : ℕ} (hD : 1 < D)
    (hUlarge : 8 * (D - 1) <
      (subgroupCoordinates (normalizedCosetFiber
        (AddSubgroup.closure ((R : Finset (ZMod b)) : Set (ZMod b))) S u)).card)
    (hUsparse : 4 *
        (subgroupCoordinates (normalizedCosetFiber
          (AddSubgroup.closure ((R : Finset (ZMod b)) : Set (ZMod b))) S u)).card <
      2 * Fintype.card (ZMod (Nat.card
        (AddSubgroup.closure ((R : Finset (ZMod b)) : Set (ZMod b))))))
    (hRlarge : 8 * (D - 1) < R.card) :
    let H := AddSubgroup.closure ((R : Finset (ZMod b)) : Set (ZMod b))
    let U := normalizedCosetFiber H S u
    let X := liftFinsetToClosure R
    let hX : X.Nonempty := liftFinsetToClosure_nonempty_of_nonempty hR
    let pick : H := subgroupFiberMaxPick U X hX
    D + S.card ≤ (S ∪ Erdos587.addTranslate pick.1 S).card := by
  classical
  dsimp only
  let H := AddSubgroup.closure ((R : Finset (ZMod b)) : Set (ZMod b))
  let U := normalizedCosetFiber H S u
  let X := liftFinsetToClosure R
  have hX : X.Nonempty := liftFinsetToClosure_nonempty_of_nonempty hR
  letI : NeZero (Nat.card H) := ⟨Nat.ne_of_gt Nat.card_pos⟩
  let pick : H := subgroupFiberMaxPick U X hX
  have hU : (subgroupCoordinates U).Nonempty := by
    exact Finset.card_pos.mp
      ((Nat.zero_le (8 * (D - 1))).trans_lt hUlarge)
  have hXlarge : 8 * (D - 1) < (subgroupCoordinates X).card := by
    simpa [X, card_liftFinsetToClosure] using hRlarge
  have hnot := subgroupCoordinates_maxPick_not_almostPeriods_elementary
    U X hX hU (by omega) hUlarge hUsparse hXlarge
    (by simpa [H, X] using subgroupCoordinates_lift_generates R)
  have hcoord : D ≤
      (translationNew (subgroupCoordinates U)
        ((subgroupZModEquiv H).symm pick)).card := by
    dsimp [pick] at hnot ⊢
    rw [mem_almostPeriods_iff_card_translationNew_le] at hnot
    have hDrecover : D - 1 + 1 = D := Nat.sub_add_cancel (by omega)
    rw [← hDrecover]
    exact Nat.succ_le_iff.mpr (Nat.lt_of_not_ge hnot)
  have hfiber : D ≤ (translationNew U pick).card := by
    rw [translationNew_subgroupCoordinates_card U pick] at hcoord
    exact hcoord
  have hglobal : D ≤ (translationNew S pick.1).card :=
    hfiber.trans (card_translationNew_normalizedCosetFiber_le H S u pick)
  rw [card_union_addTranslate_eq]
  change D + S.card ≤ S.card + (translationNew S pick.1).card
  omega

end Erdos360

#print axioms Erdos360.subgroupCoordinates_maxPick_not_almostPeriods_elementary
#print axioms Erdos360.normalizedFiberMaxPick_global_increment_elementary
