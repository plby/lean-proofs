  calc
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤
        finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) / (1 / 2) := hcondition
    _ = 2 * finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) := by ring
    _ ≤ 2 * finsetProbability (Finset.univ : Finset (IidSample s t)) Q :=
      mul_le_mul_of_nonneg_left hlift (by norm_num)
    _ ≤ 2 * Real.exp (θ^2 * ((t : ℝ) * a) * b - θ * u) :=
      mul_le_mul_of_nonneg_left htail (by norm_num)

