/-!
# Erdős Problem 747 (Shamir's problem)

For the uniform `M`-edge 3-uniform hypergraph on `3 * n` labelled vertices,
the perfect-matching threshold is asymptotic to `n * log n`.

The mathematical reconstruction, including the normalization from Kahn's
`N`-vertex statement and a lemma-by-lemma formalization plan, is in
`tex/747.tex`.
-/

open Filter Real
open scoped BigOperators Topology

namespace Erdos747

noncomputable section

attribute [local instance] Classical.propDecidable

/-! ## The exact finite fixed-edge model -/

/-- The labelled vertex set in the formulation of Problem 747. -/
abbrev Vertex (n : ℕ) := Fin (3 * n)

/-- A potential hyperedge.  Membership in `allEdges` below enforces that it
has exactly three vertices. -/
abbrev Edge (n : ℕ) := Finset (Vertex n)

/-- The complete 3-uniform hypergraph on `3 * n` vertices. -/
def allEdges (n : ℕ) : Finset (Edge n) :=
  (Finset.univ : Finset (Vertex n)).powersetCard 3

lemma card_allEdges (n : ℕ) :
    (allEdges n).card = (3 * n).choose 3 := by
  simp [allEdges]

/-- Pairwise vertex-disjointness of a finite family of edges. -/
def IsMatching {n : ℕ} (F : Finset (Edge n)) : Prop :=
  ∀ ⦃A⦄, A ∈ F → ∀ ⦃B⦄, B ∈ F → A ≠ B → Disjoint A B

/-- A hypergraph on `3 * n` vertices contains `n` vertex-disjoint edges.
For 3-uniform edges this is equivalently a perfect matching. -/
def HasPerfectMatching (n : ℕ) (H : Finset (Edge n)) : Prop :=
  ∃ F : Finset (Edge n), F ⊆ H ∧ F.card = n ∧ IsMatching F

/-- The finite sample space of all `M`-edge 3-graphs, sampled uniformly. -/
def sample (n M : ℕ) : Finset (Finset (Edge n)) :=
  (allEdges n).powersetCard M

/-- The members of the fixed-edge sample space which contain a perfect
matching. -/
def goodSample (n M : ℕ) : Finset (Finset (Edge n)) :=
  (sample n M).filter (HasPerfectMatching n)

/-- The exact probability that the uniform `M`-edge 3-graph contains a
perfect matching.  It is expressed as a quotient of finite cardinalities;
when the sample is empty, the totalized field convention gives zero. -/
def pmProbability (n M : ℕ) : ℝ :=
  (goodSample n M).card / (sample n M).card

@[simp] lemma mem_allEdges {n : ℕ} {A : Edge n} :
    A ∈ allEdges n ↔ A.card = 3 := by
  simp [allEdges]

@[simp] lemma mem_sample {n M : ℕ} {H : Finset (Edge n)} :
    H ∈ sample n M ↔ H ⊆ allEdges n ∧ H.card = M := by
  simp [sample]

@[simp] lemma mem_goodSample {n M : ℕ} {H : Finset (Edge n)} :
    H ∈ goodSample n M ↔
      H ⊆ allEdges n ∧ H.card = M ∧ HasPerfectMatching n H := by
  simp [goodSample, and_assoc]

lemma hasPerfectMatching_mono {n : ℕ} {H H' : Finset (Edge n)}
    (hHH' : H ⊆ H') (hH : HasPerfectMatching n H) :
    HasPerfectMatching n H' := by
  obtain ⟨F, hFH, hcard, hmatching⟩ := hH
  exact ⟨F, hFH.trans hHH', hcard, hmatching⟩

lemma goodSample_subset_sample (n M : ℕ) :
    goodSample n M ⊆ sample n M := by
  intro H hH
  exact (Finset.mem_filter.mp hH).1

lemma pmProbability_nonneg (n M : ℕ) : 0 ≤ pmProbability n M := by
  exact div_nonneg (by positivity) (by positivity)

lemma pmProbability_le_one (n M : ℕ) : pmProbability n M ≤ 1 := by
  rw [pmProbability]
  by_cases hs : (sample n M).card = 0
  · simp [hs]
  · have hspos : (0 : ℝ) < (sample n M).card := by
      exact_mod_cast Nat.pos_of_ne_zero hs
    exact (div_le_one hspos).2 (by
      exact_mod_cast Finset.card_le_card (goodSample_subset_sample n M))

/-! ### A concrete perfect matching in the complete hypergraph -/

/-- Vertex `j` in the `i`th consecutive block of three vertices. -/
def blockVertex (n : ℕ) (i : Fin n) (j : Fin 3) : Vertex n :=
  ⟨3 * i.1 + j.1, by
    have hi := i.2
    have hj := j.2
    omega⟩

lemma blockVertex_eq_iff {n : ℕ} {i i' : Fin n} {j j' : Fin 3} :
    blockVertex n i j = blockVertex n i' j' ↔ i = i' ∧ j = j' := by
  constructor
  · intro h
    have hv : 3 * i.1 + j.1 = 3 * i'.1 + j'.1 := congrArg Fin.val h
    have hj := j.2
    have hj' := j'.2
    constructor <;> apply Fin.ext <;> omega
  · rintro ⟨rfl, rfl⟩
    rfl

/-- The `i`th consecutive block of three vertices. -/
def canonicalEdge (n : ℕ) (i : Fin n) : Edge n :=
  (Finset.univ : Finset (Fin 3)).image (blockVertex n i)

@[simp] lemma blockVertex_mem_canonicalEdge (n : ℕ) (i : Fin n) (j : Fin 3) :
    blockVertex n i j ∈ canonicalEdge n i := by
  simp [canonicalEdge]

@[simp] lemma canonicalEdge_card (n : ℕ) (i : Fin n) :
    (canonicalEdge n i).card = 3 := by
  rw [canonicalEdge, Finset.card_image_of_injective]
  · simp
  · intro j j' hjj'
    exact (blockVertex_eq_iff.mp hjj').2

lemma canonicalEdge_injective (n : ℕ) : Function.Injective (canonicalEdge n) := by
  intro i i' hii'
  have hmem : blockVertex n i (0 : Fin 3) ∈ canonicalEdge n i' := by
    rw [← hii']
    exact blockVertex_mem_canonicalEdge n i 0
  rcases Finset.mem_image.mp hmem with ⟨j, -, hj⟩
  exact (blockVertex_eq_iff.mp hj.symm).1

/-- The consecutive-block perfect matching in the complete 3-graph. -/
def canonicalMatching (n : ℕ) : Finset (Edge n) :=
  (Finset.univ : Finset (Fin n)).image (canonicalEdge n)

@[simp] lemma canonicalMatching_card (n : ℕ) :
    (canonicalMatching n).card = n := by
  rw [canonicalMatching, Finset.card_image_of_injective _ (canonicalEdge_injective n)]
  simp

lemma canonicalMatching_subset_allEdges (n : ℕ) :
    canonicalMatching n ⊆ allEdges n := by
  intro A hA
  rcases Finset.mem_image.mp hA with ⟨i, -, rfl⟩
  exact mem_allEdges.mpr (canonicalEdge_card n i)

lemma canonicalMatching_isMatching (n : ℕ) :
    IsMatching (canonicalMatching n) := by
  intro A hA B hB hAB
  rcases Finset.mem_image.mp hA with ⟨i, -, rfl⟩
  rcases Finset.mem_image.mp hB with ⟨i', -, rfl⟩
  rw [Finset.disjoint_left]
  intro x hxi hxi'
  rcases Finset.mem_image.mp hxi with ⟨j, -, rfl⟩
  rcases Finset.mem_image.mp hxi' with ⟨j', -, hjj'⟩
  have hii' : i = i' := (blockVertex_eq_iff.mp hjj'.symm).1
  subst i'
  exact hAB rfl

lemma allEdges_hasPerfectMatching (n : ℕ) :
    HasPerfectMatching n (allEdges n) :=
  ⟨canonicalMatching n, canonicalMatching_subset_allEdges n,
    canonicalMatching_card n, canonicalMatching_isMatching n⟩

@[simp] lemma sample_top (n : ℕ) :
    sample n (allEdges n).card = {allEdges n} := by
  exact Finset.powersetCard_self (allEdges n)

@[simp] lemma goodSample_top (n : ℕ) :
    goodSample n (allEdges n).card = {allEdges n} := by
  rw [goodSample, sample_top]
  simp [allEdges_hasPerfectMatching]

@[simp] lemma pmProbability_top (n : ℕ) :
    pmProbability n (allEdges n).card = 1 := by
  simp [pmProbability]

/-- The least edge count at which the fixed-edge perfect-matching
probability is at least one half. -/
def critical (n : ℕ) : ℕ :=
  Nat.find (show ∃ M : ℕ, (1 : ℝ) / 2 ≤ pmProbability n M from
    ⟨(allEdges n).card, by rw [pmProbability_top]; norm_num⟩)

lemma critical_spec (n : ℕ) :
    (1 : ℝ) / 2 ≤ pmProbability n (critical n) := by
  exact Nat.find_spec (show ∃ M : ℕ, (1 : ℝ) / 2 ≤ pmProbability n M from
    ⟨(allEdges n).card, by rw [pmProbability_top]; norm_num⟩)

lemma critical_min {n M : ℕ} (hM : (1 : ℝ) / 2 ≤ pmProbability n M) :
    critical n ≤ M := by
  exact Nat.find_min' (show ∃ m : ℕ, (1 : ℝ) / 2 ≤ pmProbability n m from
    ⟨M, hM⟩) hM

/-! ### Monotonicity in the number of sampled edges -/

/-- Incidences between a good `M`-edge hypergraph and an unused edge. -/
private def extensionPairs (n M : ℕ) :
    Finset ((_H : Finset (Edge n)) × Edge n) :=
  (goodSample n M).sigma fun H ↦ allEdges n \ H

/-- Incidences between a good `(M+1)`-edge hypergraph and one of its edges. -/
private def markedGoodPairs (n M : ℕ) :
    Finset ((_H : Finset (Edge n)) × Edge n) :=
  (goodSample n (M + 1)).sigma fun H ↦ H

private def extendPair {n : ℕ} :
    ((_H : Finset (Edge n)) × Edge n) →
      ((_H : Finset (Edge n)) × Edge n)
  | ⟨H, A⟩ => ⟨insert A H, A⟩

private lemma card_extensionPairs (n M : ℕ) :
    (extensionPairs n M).card =
      (goodSample n M).card * ((allEdges n).card - M) := by
  rw [extensionPairs, Finset.card_sigma]
  apply Finset.sum_const_nat
  intro H hH
  rcases mem_goodSample.mp hH with ⟨hsub, hcard, -⟩
  rw [Finset.card_sdiff, Finset.inter_eq_left.mpr hsub, hcard]

private lemma card_markedGoodPairs (n M : ℕ) :
    (markedGoodPairs n M).card =
      (goodSample n (M + 1)).card * (M + 1) := by
  rw [markedGoodPairs, Finset.card_sigma]
  apply Finset.sum_const_nat
  intro H hH
  exact (mem_goodSample.mp hH).2.1

private lemma extendPair_mapsTo (n M : ℕ) :
    Set.MapsTo extendPair
      (↑(extensionPairs n M) : Set ((_H : Finset (Edge n)) × Edge n))
      (↑(markedGoodPairs n M) : Set ((_H : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, A⟩ hHA
  change (⟨H, A⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈ extensionPairs n M at hHA
  rw [extensionPairs, Finset.mem_sigma] at hHA
  rcases hHA with ⟨hgood, hA⟩
  rcases mem_goodSample.mp hgood with ⟨hsub, hcard, hpm⟩
  rcases Finset.mem_sdiff.mp hA with ⟨hAall, hAnot⟩
  change (⟨insert A H, A⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈ markedGoodPairs n M
  rw [markedGoodPairs, Finset.mem_sigma]
  constructor
  · apply mem_goodSample.mpr
    exact ⟨Finset.insert_subset hAall hsub,
      by simp [Finset.card_insert_of_notMem hAnot, hcard],
      hasPerfectMatching_mono (Finset.subset_insert A H) hpm⟩
  · exact Finset.mem_insert_self A H

private lemma extendPair_injective (n M : ℕ) :
    Set.InjOn extendPair
      (↑(extensionPairs n M) : Set ((_H : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, A⟩ hHA ⟨H', A'⟩ hH'A' heq
  have hAnot : A ∉ H := by
    exact (Finset.mem_sdiff.mp (Finset.mem_sigma.mp hHA).2).2
  have hA'not : A' ∉ H' := by
    exact (Finset.mem_sdiff.mp (Finset.mem_sigma.mp hH'A').2).2
  have hins : insert A H = insert A' H' := congrArg Sigma.fst heq
  have hAA' : A = A' := eq_of_heq (Sigma.mk.inj_iff.mp heq).2
  subst A'
  have hHH' : H = H' := by
    simpa only [Finset.erase_insert hAnot, Finset.erase_insert hA'not] using
      congrArg (fun S : Finset (Edge n) ↦ S.erase A) hins
  subst H'
  rfl

lemma goodSample_extension_count {n M : ℕ} :
    (goodSample n M).card * ((allEdges n).card - M) ≤
      (goodSample n (M + 1)).card * (M + 1) := by
  rw [← card_extensionPairs, ← card_markedGoodPairs]
  exact Finset.card_le_card_of_injOn extendPair
    (extendPair_mapsTo n M) (extendPair_injective n M)

@[simp] lemma card_sample (n M : ℕ) :
    (sample n M).card = (allEdges n).card.choose M := by
  simp [sample]

lemma pmProbability_mono_succ {n M : ℕ} (hM : M < (allEdges n).card) :
    pmProbability n M ≤ pmProbability n (M + 1) := by
  let N := (allEdges n).card
  let a := (goodSample n M).card
  let b := (goodSample n (M + 1)).card
  have hcount : a * (N - M) ≤ b * (M + 1) := by
    simpa [a, b, N] using goodSample_extension_count (n := n) (M := M)
  have hchoose : N.choose (M + 1) * (M + 1) = N.choose M * (N - M) :=
    Nat.choose_succ_right_eq N M
  have hCM : 0 < N.choose M := Nat.choose_pos hM.le
  have hCM1 : 0 < N.choose (M + 1) := Nat.choose_pos hM
  rw [pmProbability, pmProbability, card_sample, card_sample]
  apply (div_le_div_iff₀ (by exact_mod_cast hCM) (by exact_mod_cast hCM1)).2
  have hcountR : (a : ℝ) * ((N - M : ℕ) : ℝ) ≤
      (b : ℝ) * ((M + 1 : ℕ) : ℝ) := by
    exact_mod_cast hcount
  have hchooseR : (N.choose (M + 1) : ℝ) * ((M + 1 : ℕ) : ℝ) =
      (N.choose M : ℝ) * ((N - M : ℕ) : ℝ) := by
    exact_mod_cast hchoose
  have hM1R : (0 : ℝ) < ((M + 1 : ℕ) : ℝ) := by positivity
  nlinarith [show (0 : ℝ) < N.choose M by exact_mod_cast hCM]

lemma pmProbability_mono_of_le {n M M' : ℕ} (hMM' : M ≤ M')
    (hM'top : M' ≤ (allEdges n).card) :
    pmProbability n M ≤ pmProbability n M' := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hMM'
  clear hMM'
  revert hM'top
  induction d with
  | zero => intro; simp
  | succ d ih =>
      intro htop
      have hprev : M + d < (allEdges n).card := by omega
      exact le_trans (ih (by omega)) (pmProbability_mono_succ hprev)

lemma critical_le_top (n : ℕ) : critical n ≤ (allEdges n).card := by
  apply critical_min
  rw [pmProbability_top]
  norm_num

lemma probability_lt_half_of_lt_critical {n M : ℕ} (hM : M < critical n) :
    pmProbability n M < (1 : ℝ) / 2 := by
  by_contra h
  have hhalf : (1 : ℝ) / 2 ≤ pmProbability n M := le_of_not_gt h
  exact (not_le_of_gt hM) (critical_min hhalf)

lemma half_le_probability_of_critical_le {n M : ℕ} (hM : critical n ≤ M)
    (hTop : M ≤ (allEdges n).card) :
    (1 : ℝ) / 2 ≤ pmProbability n M := by
  exact (critical_spec n).trans (pmProbability_mono_of_le hM hTop)

lemma half_le_probability_iff {n M : ℕ} (hTop : M ≤ (allEdges n).card) :
    (1 : ℝ) / 2 ≤ pmProbability n M ↔ critical n ≤ M := by
  constructor
  · exact critical_min
  · intro hM
    exact half_le_probability_of_critical_le hM hTop

/-! ## Isolated vertices: exact finite counts -/

/-- Three-edges avoiding every vertex in `S`. -/
def edgesAvoiding (n : ℕ) (S : Finset (Vertex n)) : Finset (Edge n) :=
  ((Finset.univ : Finset (Vertex n)) \ S).powersetCard 3

@[simp] lemma mem_edgesAvoiding {n : ℕ} {S : Finset (Vertex n)} {A : Edge n} :
    A ∈ edgesAvoiding n S ↔ A.card = 3 ∧ Disjoint A S := by
  rw [edgesAvoiding, Finset.mem_powersetCard]
  constructor
  · rintro ⟨hsub, hcard⟩
    refine ⟨hcard, Finset.disjoint_left.mpr ?_⟩
    intro x hxA hxS
    exact (Finset.mem_sdiff.mp (hsub hxA)).2 hxS
  · rintro ⟨hcard, hdisj⟩
    refine ⟨?_, hcard⟩
    intro x hxA
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ x,
      fun hxS ↦ Finset.disjoint_left.mp hdisj hxA hxS⟩

lemma edgesAvoiding_subset_allEdges (n : ℕ) (S : Finset (Vertex n)) :
    edgesAvoiding n S ⊆ allEdges n := by
  intro A hA
  exact mem_allEdges.mpr (mem_edgesAvoiding.mp hA).1

@[simp] lemma card_edgesAvoiding (n : ℕ) (S : Finset (Vertex n)) :
    (edgesAvoiding n S).card = (3 * n - S.card).choose 3 := by
  rw [edgesAvoiding, Finset.card_powersetCard, Finset.card_sdiff]
  simp

/-- Every edge of `H` avoids `S`. -/
def Avoids {n : ℕ} (H : Finset (Edge n)) (S : Finset (Vertex n)) : Prop :=
  ∀ A ∈ H, Disjoint A S

lemma avoids_iff_subset_edgesAvoiding {n : ℕ} {H : Finset (Edge n)}
    {S : Finset (Vertex n)} (hH : H ⊆ allEdges n) :
    Avoids H S ↔ H ⊆ edgesAvoiding n S := by
  constructor
  · intro hav A hA
    exact mem_edgesAvoiding.mpr ⟨mem_allEdges.mp (hH hA), hav A hA⟩
  · intro hsub A hA
    exact (mem_edgesAvoiding.mp (hsub hA)).2

/-- A vertex is isolated when no sampled edge contains it. -/
def Isolated {n : ℕ} (H : Finset (Edge n)) (v : Vertex n) : Prop :=
  Avoids H {v}

lemma isolated_iff {n : ℕ} {H : Finset (Edge n)} {v : Vertex n} :
    Isolated H v ↔ ∀ A ∈ H, v ∉ A := by
  simp [Isolated, Avoids, Finset.disjoint_singleton_right]

lemma filter_sample_avoids_eq (n M : ℕ) (S : Finset (Vertex n)) :
    (sample n M).filter (fun H ↦ Avoids H S) =
      (edgesAvoiding n S).powersetCard M := by
  ext H
  constructor
  · intro hH
    rcases Finset.mem_filter.mp hH with ⟨hsample, hav⟩
    rcases mem_sample.mp hsample with ⟨hsub, hcard⟩
    exact Finset.mem_powersetCard.mpr
      ⟨(avoids_iff_subset_edgesAvoiding hsub).mp hav, hcard⟩
  · intro hH
    rcases Finset.mem_powersetCard.mp hH with ⟨hsub, hcard⟩
    have hsample : H ∈ sample n M := mem_sample.mpr
      ⟨hsub.trans (edgesAvoiding_subset_allEdges n S), hcard⟩
    exact Finset.mem_filter.mpr
      ⟨hsample, (avoids_iff_subset_edgesAvoiding
        (mem_sample.mp hsample).1).mpr hsub⟩

lemma card_sample_avoids (n M : ℕ) (S : Finset (Vertex n)) :
    ((sample n M).filter (fun H ↦ Avoids H S)).card =
      ((3 * n - S.card).choose 3).choose M := by
  rw [filter_sample_avoids_eq, Finset.card_powersetCard, card_edgesAvoiding]

lemma card_sample_isolated (n M : ℕ) (v : Vertex n) :
    ((sample n M).filter (fun H ↦ Isolated H v)).card =
      ((3 * n - 1).choose 3).choose M := by
  change ((sample n M).filter (fun H ↦ Avoids H {v})).card = _
  simpa only [Finset.card_singleton] using
    card_sample_avoids n M ({v} : Finset (Vertex n))

lemma card_sample_pair_isolated (n M : ℕ) {v w : Vertex n} (hvw : v ≠ w) :
    ((sample n M).filter (fun H ↦ Isolated H v ∧ Isolated H w)).card =
      ((3 * n - 2).choose 3).choose M := by
  have hAvoid : ∀ H : Finset (Edge n),
      (Isolated H v ∧ Isolated H w) ↔ Avoids H {v, w} := by
    intro H
    constructor
    · rintro ⟨hv, hw⟩ A hA
      rw [Finset.disjoint_insert_right, Finset.disjoint_singleton_right]
      exact ⟨(isolated_iff.mp hv) A hA, (isolated_iff.mp hw) A hA⟩
    · intro hav
      constructor <;> apply isolated_iff.mpr <;> intro A hA
      · exact (Finset.disjoint_insert_right.mp (hav A hA)).1
      · exact (Finset.disjoint_singleton_right.mp
          (Finset.disjoint_insert_right.mp (hav A hA)).2)
  have hfilter :
      (sample n M).filter (fun H ↦ Isolated H v ∧ Isolated H w) =
        (sample n M).filter (fun H ↦ Avoids H {v, w}) := by
    exact Finset.filter_congr (fun H _ ↦ hAvoid H)
  rw [hfilter]
  simpa [Finset.card_pair hvw] using
    card_sample_avoids n M ({v, w} : Finset (Vertex n))

/-- Exact one-vertex isolation probability in the uniform fixed-edge model. -/
def isolatedProbability (n M : ℕ) (v : Vertex n) : ℝ :=
  ((sample n M).filter (fun H ↦ Isolated H v)).card / (sample n M).card

lemma isolatedProbability_eq (n M : ℕ) (v : Vertex n) :
    isolatedProbability n M v =
      (((3 * n - 1).choose 3).choose M : ℝ) /
        ((3 * n).choose 3).choose M := by
  rw [isolatedProbability, card_sample_isolated, card_sample, allEdges]
  simp

/-! ### An isolated vertex obstructs a perfect matching -/

/-- The set of vertices covered by the edges of `F`. -/
def coveredVertices {n : ℕ} (F : Finset (Edge n)) : Finset (Vertex n) :=
  F.biUnion id

lemma card_coveredVertices_of_matching {n : ℕ} {F : Finset (Edge n)}
    (hF : F ⊆ allEdges n) (hmatching : IsMatching F) :
    (coveredVertices F).card = 3 * F.card := by
  have hpairwise : (F : Set (Edge n)).PairwiseDisjoint id := by
    intro A hA B hB hAB
    exact hmatching hA hB hAB
  rw [coveredVertices, Finset.card_biUnion hpairwise]
  have hsum : ∑ A ∈ F, A.card = F.card * 3 := by
    exact Finset.sum_const_nat (fun A hA ↦ mem_allEdges.mp (hF hA))
  simpa [Nat.mul_comm] using hsum

lemma not_hasPerfectMatching_of_isolated {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) {v : Vertex n} (hv : Isolated H v) :
    ¬HasPerfectMatching n H := by
  rintro ⟨F, hFH, hcard, hmatching⟩
  have hFall : F ⊆ allEdges n := hFH.trans hH
  have hcoveredCard : (coveredVertices F).card = Fintype.card (Vertex n) := by
    rw [card_coveredVertices_of_matching hFall hmatching, hcard]
    simp
  have hcovered : coveredVertices F = Finset.univ :=
    Finset.eq_univ_of_card (coveredVertices F) hcoveredCard
  have hvcovered : v ∈ coveredVertices F := by
    rw [hcovered]
    simp
  rcases Finset.mem_biUnion.mp hvcovered with ⟨A, hAF, hvA⟩
  exact (isolated_iff.mp hv A (hFH hAF)) hvA

lemma goodSample_has_no_isolated (n M : ℕ) :
    goodSample n M ⊆
      (sample n M).filter (fun H ↦ ∀ v : Vertex n, ¬Isolated H v) := by
  intro H hgood
  rcases mem_goodSample.mp hgood with ⟨hH, hcard, hpm⟩
  exact Finset.mem_filter.mpr ⟨mem_sample.mpr ⟨hH, hcard⟩, fun v hv ↦
    not_hasPerfectMatching_of_isolated hH hv hpm⟩

/-! ### The isolated-vertex random variable -/

/-- The isolated vertices of `H`. -/
def isolatedVertices {n : ℕ} (H : Finset (Edge n)) : Finset (Vertex n) :=
  Finset.univ.filter (Isolated H)

/-- The number of isolated vertices of `H`. -/
def isolatedCount {n : ℕ} (H : Finset (Edge n)) : ℕ :=
  (isolatedVertices H).card

@[simp] lemma mem_isolatedVertices {n : ℕ} {H : Finset (Edge n)}
    {v : Vertex n} : v ∈ isolatedVertices H ↔ Isolated H v := by
  simp [isolatedVertices]

lemma isolatedCount_eq_sum_indicator {n : ℕ} (H : Finset (Edge n)) :
    isolatedCount H = ∑ v : Vertex n, if Isolated H v then 1 else 0 := by
  exact (Finset.sum_boole (R := ℕ) (Isolated H) Finset.univ).symm

lemma sum_isolatedCount (n M : ℕ) :
    ∑ H ∈ sample n M, isolatedCount H =
      (3 * n) * ((3 * n - 1).choose 3).choose M := by
  calc
    ∑ H ∈ sample n M, isolatedCount H =
        ∑ H ∈ sample n M, ∑ v : Vertex n,
          if Isolated H v then 1 else 0 := by
      simp_rw [isolatedCount_eq_sum_indicator]
    _ = ∑ v : Vertex n, ∑ H ∈ sample n M,
          if Isolated H v then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ v : Vertex n,
          ((sample n M).filter (fun H ↦ Isolated H v)).card := by
      apply Finset.sum_congr rfl
      intro v _
      exact Finset.sum_boole (R := ℕ) (fun H ↦ Isolated H v) (sample n M)
    _ = (3 * n) * ((3 * n - 1).choose 3).choose M := by
      simp [card_sample_isolated]

/-- The second factorial moment statistic `X (X - 1)`, written in a
subtraction form that is exactly the cardinality of `offDiag`. -/
def secondFactorialCount {n : ℕ} (H : Finset (Edge n)) : ℕ :=
  isolatedCount H * isolatedCount H - isolatedCount H

lemma secondFactorialCount_eq_sum_indicator {n : ℕ}
    (H : Finset (Edge n)) :
    secondFactorialCount H =
      ∑ p ∈ (Finset.univ : Finset (Vertex n)).offDiag,
        if Isolated H p.1 ∧ Isolated H p.2 then 1 else 0 := by
  rw [Finset.sum_boole]
  have hfilter :
      ((Finset.univ : Finset (Vertex n)).offDiag.filter
          (fun p ↦ Isolated H p.1 ∧ Isolated H p.2)) =
        (isolatedVertices H).offDiag := by
    ext p
    simp [isolatedVertices, and_assoc, and_comm]
  rw [hfilter]
  simp [secondFactorialCount, isolatedCount]

lemma sum_secondFactorialCount (n M : ℕ) :
    ∑ H ∈ sample n M, secondFactorialCount H =
      ((3 * n) * (3 * n) - 3 * n) *
        ((3 * n - 2).choose 3).choose M := by
  calc
    ∑ H ∈ sample n M, secondFactorialCount H =
        ∑ H ∈ sample n M,
          ∑ p ∈ (Finset.univ : Finset (Vertex n)).offDiag,
            if Isolated H p.1 ∧ Isolated H p.2 then 1 else 0 := by
      simp_rw [secondFactorialCount_eq_sum_indicator]
    _ = ∑ p ∈ (Finset.univ : Finset (Vertex n)).offDiag,
          ∑ H ∈ sample n M,
            if Isolated H p.1 ∧ Isolated H p.2 then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ p ∈ (Finset.univ : Finset (Vertex n)).offDiag,
          ((sample n M).filter
            (fun H ↦ Isolated H p.1 ∧ Isolated H p.2)).card := by
      apply Finset.sum_congr rfl
      intro p _
      exact Finset.sum_boole (R := ℕ)
        (fun H ↦ Isolated H p.1 ∧ Isolated H p.2) (sample n M)
    _ = ((3 * n) * (3 * n) - 3 * n) *
          ((3 * n - 2).choose 3).choose M := by
      rw [Finset.sum_const_nat (fun p hp ↦
        card_sample_pair_isolated n M (Finset.mem_offDiag.mp hp).2.2)]
      simp

/-- The square of the isolated-vertex count. -/
def secondMomentCount {n : ℕ} (H : Finset (Edge n)) : ℕ :=
  isolatedCount H ^ 2

lemma secondMomentCount_eq (n : ℕ) (H : Finset (Edge n)) :
    secondMomentCount H = secondFactorialCount H + isolatedCount H := by
  have hle : isolatedCount H ≤ isolatedCount H * isolatedCount H :=
    Nat.le_mul_self (isolatedCount H)
  simp only [secondMomentCount, secondFactorialCount, pow_two]
  omega

lemma sum_secondMomentCount (n M : ℕ) :
    ∑ H ∈ sample n M, secondMomentCount H =
      ((3 * n) * (3 * n) - 3 * n) *
          ((3 * n - 2).choose 3).choose M +
        (3 * n) * ((3 * n - 1).choose 3).choose M := by
  simp_rw [secondMomentCount_eq n]
  rw [Finset.sum_add_distrib, sum_secondFactorialCount, sum_isolatedCount]

/-- Sample points at which at least one vertex is isolated. -/
def positiveIsolatedSample (n M : ℕ) : Finset (Finset (Edge n)) :=
  (sample n M).filter (fun H ↦ 0 < isolatedCount H)

/-- Sample points at which no vertex is isolated. -/
def noIsolatedSample (n M : ℕ) : Finset (Finset (Edge n)) :=
  (sample n M).filter (fun H ↦ isolatedCount H = 0)

/-- The probability that the fixed-edge random hypergraph has no isolated
vertex. -/
def noIsolatedProbability (n M : ℕ) : ℝ :=
  (noIsolatedSample n M).card / (sample n M).card

lemma isolatedCount_eq_zero_iff {n : ℕ} {H : Finset (Edge n)} :
    isolatedCount H = 0 ↔ ∀ v : Vertex n, ¬Isolated H v := by
  simp [isolatedCount, isolatedVertices]

lemma goodSample_subset_noIsolatedSample (n M : ℕ) :
    goodSample n M ⊆ noIsolatedSample n M := by
  intro H hgood
  rcases Finset.mem_filter.mp (goodSample_has_no_isolated n M hgood) with
    ⟨hsample, hnone⟩
  exact Finset.mem_filter.mpr
    ⟨hsample, isolatedCount_eq_zero_iff.mpr hnone⟩

lemma pmProbability_le_noIsolatedProbability (n M : ℕ) :
    pmProbability n M ≤ noIsolatedProbability n M := by
  rw [pmProbability, noIsolatedProbability]
  exact div_le_div_of_nonneg_right
    (by
      exact_mod_cast (Finset.card_le_card
        (goodSample_subset_noIsolatedSample n M))) (by positivity)

lemma positiveIsolatedSample_eq_sdiff (n M : ℕ) :
    positiveIsolatedSample n M = sample n M \ noIsolatedSample n M := by
  ext H
  by_cases hs : H ∈ sample n M
  · simp [positiveIsolatedSample, noIsolatedSample, hs]
    omega
  · simp [positiveIsolatedSample, noIsolatedSample, hs]

lemma card_noIsolated_add_card_positive (n M : ℕ) :
    (noIsolatedSample n M).card + (positiveIsolatedSample n M).card =
      (sample n M).card := by
  rw [positiveIsolatedSample_eq_sdiff, Finset.card_sdiff]
  have hsub : noIsolatedSample n M ⊆ sample n M :=
    Finset.filter_subset _ _
  rw [Finset.inter_eq_left.mpr hsub]
  have hcard := Finset.card_le_card hsub
  omega

lemma sum_positive_isolatedCount (n M : ℕ) :
    ∑ H ∈ positiveIsolatedSample n M, isolatedCount H =
      ∑ H ∈ sample n M, isolatedCount H := by
  rw [positiveIsolatedSample, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro H _
  by_cases hH : 0 < isolatedCount H
  · simp [hH]
  · have : isolatedCount H = 0 := by omega
    simp [this]

lemma sum_positive_secondMomentCount (n M : ℕ) :
    ∑ H ∈ positiveIsolatedSample n M, secondMomentCount H =
      ∑ H ∈ sample n M, secondMomentCount H := by
  rw [positiveIsolatedSample, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro H _
  by_cases hH : 0 < isolatedCount H
  · simp [hH]
  · have : isolatedCount H = 0 := by omega
    simp [this, secondMomentCount]

/-- The finite Cauchy--Schwarz (second-moment) bound for the event that an
isolated vertex exists. -/
lemma isolated_second_moment_inequality (n M : ℕ) :
    (∑ H ∈ sample n M, isolatedCount H) ^ 2 ≤
      (positiveIsolatedSample n M).card *
        ∑ H ∈ sample n M, secondMomentCount H := by
  have hcs := sq_sum_le_card_mul_sum_sq
    (s := positiveIsolatedSample n M) (f := fun H ↦ isolatedCount H)
  rw [sum_positive_isolatedCount] at hcs
  change (∑ H ∈ sample n M, isolatedCount H) ^ 2 ≤
    (positiveIsolatedSample n M).card *
      ∑ H ∈ positiveIsolatedSample n M, secondMomentCount H at hcs
  rw [sum_positive_secondMomentCount] at hcs
  exact hcs

lemma positive_probability_second_moment_lower (n M : ℕ)
    (hsample : (sample n M).card ≠ 0)
    (hsecond : (∑ H ∈ sample n M, secondMomentCount H) ≠ 0) :
    ((∑ H ∈ sample n M, isolatedCount H : ℕ) : ℝ) ^ 2 /
        (((sample n M).card : ℝ) *
          ((∑ H ∈ sample n M, secondMomentCount H : ℕ) : ℝ)) ≤
      ((positiveIsolatedSample n M).card : ℝ) /
        (sample n M).card := by
  have hD : (0 : ℝ) < (sample n M).card := by
    exact_mod_cast Nat.pos_of_ne_zero hsample
  have hB : (0 : ℝ) < (∑ H ∈ sample n M, secondMomentCount H : ℕ) := by
    exact_mod_cast Nat.pos_of_ne_zero hsecond
  apply (div_le_div_iff₀ (mul_pos hD hB) hD).2
  have hcsR :
      (((∑ H ∈ sample n M, isolatedCount H : ℕ) : ℝ) ^ 2) ≤
        ((positiveIsolatedSample n M).card : ℝ) *
          ((∑ H ∈ sample n M, secondMomentCount H : ℕ) : ℝ) := by
    exact_mod_cast isolated_second_moment_inequality n M
  simpa only [mul_assoc, mul_left_comm, mul_comm] using
    mul_le_mul_of_nonneg_right hcsR hD.le

/-! ## Binomial ratios as finite products -/

/-- An exact product formula for the ratio of two binomial coefficients.
The totalized division convention makes the identity valid without side
conditions. -/
lemma choose_ratio_eq_prod (A B M : ℕ) :
    (A.choose M : ℝ) / (B.choose M : ℝ) =
      ∏ i ∈ Finset.range M,
        ((A - i : ℕ) : ℝ) / ((B - i : ℕ) : ℝ) := by
  have hfac : (M.factorial : ℝ) ≠ 0 := by positivity
  have hdescA : (A.descFactorial M : ℝ) =
      (M.factorial : ℝ) * (A.choose M : ℝ) := by
    exact_mod_cast Nat.descFactorial_eq_factorial_mul_choose A M
  have hdescB : (B.descFactorial M : ℝ) =
      (M.factorial : ℝ) * (B.choose M : ℝ) := by
    exact_mod_cast Nat.descFactorial_eq_factorial_mul_choose B M
  have hprodA : (A.descFactorial M : ℝ) =
      ∏ i ∈ Finset.range M, ((A - i : ℕ) : ℝ) := by
    rw [Nat.descFactorial_eq_prod_range, Nat.cast_prod]
  have hprodB : (B.descFactorial M : ℝ) =
      ∏ i ∈ Finset.range M, ((B - i : ℕ) : ℝ) := by
    rw [Nat.descFactorial_eq_prod_range, Nat.cast_prod]
  calc
    (A.choose M : ℝ) / (B.choose M : ℝ) =
        ((M.factorial : ℝ) * (A.choose M : ℝ)) /
          ((M.factorial : ℝ) * (B.choose M : ℝ)) := by
      symm
      exact mul_div_mul_left _ _ hfac
    _ = (A.descFactorial M : ℝ) / (B.descFactorial M : ℝ) := by
      rw [hdescA, hdescB]
    _ = (∏ i ∈ Finset.range M, ((A - i : ℕ) : ℝ)) /
          (∏ i ∈ Finset.range M, ((B - i : ℕ) : ℝ)) := by
      rw [hprodA, hprodB]
    _ = ∏ i ∈ Finset.range M,
          ((A - i : ℕ) : ℝ) / ((B - i : ℕ) : ℝ) := by
      exact (Finset.prod_div_distrib
        (fun i ↦ ((A - i : ℕ) : ℝ))
        (fun i ↦ ((B - i : ℕ) : ℝ))).symm

lemma choose_ratio_le_pow (A B M : ℕ) (hMA : M ≤ A) (hAB : A ≤ B) :
    (A.choose M : ℝ) / (B.choose M : ℝ) ≤
      ((A : ℝ) / (B : ℝ)) ^ M := by
  rw [choose_ratio_eq_prod]
  calc
    ∏ i ∈ Finset.range M,
        ((A - i : ℕ) : ℝ) / ((B - i : ℕ) : ℝ) ≤
        ∏ _i ∈ Finset.range M, (A : ℝ) / (B : ℝ) := by
      apply Finset.prod_le_prod
      · intro i hi
        positivity
      · intro i hi
        have hiM : i < M := Finset.mem_range.mp hi
        have hiA : i < A := lt_of_lt_of_le hiM hMA
        have hiB : i < B := lt_of_lt_of_le hiA hAB
        have hB : 0 < B := lt_of_le_of_lt (Nat.zero_le i) hiB
        have hiBR : (i : ℝ) < (B : ℝ) := by exact_mod_cast hiB
        have hBR : (0 : ℝ) < (B : ℝ) := by exact_mod_cast hB
        rw [Nat.cast_sub hiA.le, Nat.cast_sub hiB.le]
        apply (div_le_div_iff₀ (sub_pos.mpr hiBR) hBR).2
        have hABR : (A : ℝ) ≤ (B : ℝ) := by exact_mod_cast hAB
        have hiR : (0 : ℝ) ≤ i := by positivity
        nlinarith [mul_nonneg (sub_nonneg.mpr hABR) hiR]
    _ = ((A : ℝ) / (B : ℝ)) ^ M := by
      simp only [Finset.prod_const, Finset.card_range]

lemma pow_le_choose_ratio (A B M : ℕ) (hMA : M ≤ A) (hAB : A ≤ B) :
    (((A - M + 1 : ℕ) : ℝ) / ((B - M + 1 : ℕ) : ℝ)) ^ M ≤
      (A.choose M : ℝ) / (B.choose M : ℝ) := by
  rw [choose_ratio_eq_prod]
  calc
    (((A - M + 1 : ℕ) : ℝ) / ((B - M + 1 : ℕ) : ℝ)) ^ M =
        ∏ _i ∈ Finset.range M,
          ((A - M + 1 : ℕ) : ℝ) / ((B - M + 1 : ℕ) : ℝ) := by
      simp only [Finset.prod_const, Finset.card_range]
    _ ≤ ∏ i ∈ Finset.range M,
          ((A - i : ℕ) : ℝ) / ((B - i : ℕ) : ℝ) := by
      apply Finset.prod_le_prod
      · intro i hi
        positivity
      · intro i hi
        have hiM : i < M := Finset.mem_range.mp hi
        have hiA : i < A := lt_of_lt_of_le hiM hMA
        have hiB : i < B := lt_of_lt_of_le hiA hAB
        have hMB : M ≤ B := hMA.trans hAB
        have hBr : (M : ℝ) ≤ (B : ℝ) := by exact_mod_cast hMB
        have hir : (i : ℝ) < (M : ℝ) := by exact_mod_cast hiM
        have hiBr : (i : ℝ) < (B : ℝ) := by exact_mod_cast hiB
        have hABr : (A : ℝ) ≤ (B : ℝ) := by exact_mod_cast hAB
        rw [Nat.cast_add, Nat.cast_sub hMA, Nat.cast_add,
          Nat.cast_sub hMB, Nat.cast_sub hiA.le, Nat.cast_sub hiB.le]
        norm_num only [Nat.cast_one]
        apply (div_le_div_iff₀ (by linarith) (sub_pos.mpr hiBr)).2
        have hgap' : (i : ℝ) + 1 ≤ (M : ℝ) := by
          exact_mod_cast (show i + 1 ≤ M by omega)
        have hgap : (0 : ℝ) ≤ (M : ℝ) - 1 - i := by
          linarith
        nlinarith [mul_nonneg (sub_nonneg.mpr hABr) hgap]

lemma choose_pred_three_div_choose_three (V : ℕ) (hV : 3 ≤ V) :
    ((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ) =
      ((V - 3 : ℕ) : ℝ) / (V : ℝ) := by
  have hsucc : V - 1 + 1 = V := by omega
  have hsub : V - 1 + 1 - 3 = V - 3 := by omega
  have hnat : (V - 1).choose 3 * V = V.choose 3 * (V - 3) := by
    simpa [hsucc, hsub] using Nat.choose_mul_succ_eq (V - 1) 3
  have hchoose : (V.choose 3 : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos hV).ne'
  have hV0 : (V : ℝ) ≠ 0 := by positivity
  apply (div_eq_div_iff hchoose hV0).2
  have hnat' : (V - 1).choose 3 * V = (V - 3) * V.choose 3 := by
    simpa [Nat.mul_comm] using hnat
  exact_mod_cast hnat'

lemma choose_pred_two_three_div_choose_pred_three (V : ℕ) (hV : 4 ≤ V) :
    ((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ) =
      ((V - 4 : ℕ) : ℝ) / ((V - 1 : ℕ) : ℝ) := by
  have h := choose_pred_three_div_choose_three (V - 1) (by omega)
  convert h using 1 <;> congr 2 <;> omega

/-- For one edge chosen uniformly from the complete 3-graph, avoiding two
specified vertices is no more likely than the product of the two individual
avoidance probabilities. -/
lemma two_avoid_base_le_one_avoid_base_sq (V : ℕ) (hV : 4 ≤ V) :
    ((V - 2).choose 3 : ℝ) / (V.choose 3 : ℝ) ≤
      (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) ^ 2 := by
  have hK : (V.choose 3 : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos (by omega : 3 ≤ V)).ne'
  have hA : ((V - 1).choose 3 : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos (by omega : 3 ≤ V - 1)).ne'
  have hratio :
      ((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ) ≤
        ((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ) := by
    rw [choose_pred_two_three_div_choose_pred_three V hV,
      choose_pred_three_div_choose_three V (by omega)]
    apply (div_le_div_iff₀
      (by exact_mod_cast (show 0 < V - 1 by omega))
      (by exact_mod_cast (show 0 < V by omega))).2
    norm_num only [Nat.cast_sub (by omega : 4 ≤ V),
      Nat.cast_sub (by omega : 3 ≤ V), Nat.cast_sub (by omega : 1 ≤ V),
      Nat.cast_ofNat]
    nlinarith
  calc
    ((V - 2).choose 3 : ℝ) / (V.choose 3 : ℝ) =
        (((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ)) *
          (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) := by
      field_simp
    _ ≤ (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) *
          (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) := by
      exact mul_le_mul_of_nonneg_right hratio (div_nonneg (by positivity) (by positivity))
    _ = (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) ^ 2 := by ring

lemma choose_three_le_two_pred_choose_three (V : ℕ) (hV : 6 ≤ V) :
    V.choose 3 ≤ 2 * (V - 1).choose 3 := by
  have hratio := choose_pred_three_div_choose_three V (by omega : 3 ≤ V)
  have hKpos : (0 : ℝ) < (V.choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ V)
  have hcross := (div_eq_div_iff
    (by positivity : (V.choose 3 : ℝ) ≠ 0)
    (by positivity : (V : ℝ) ≠ 0)).mp hratio
  rw [Nat.cast_sub (by omega : 3 ≤ V), Nat.cast_ofNat] at hcross
  have hVr : (6 : ℝ) ≤ V := by exact_mod_cast hV
  exact_mod_cast (show (V.choose 3 : ℝ) ≤ 2 * ((V - 1).choose 3 : ℝ) by
    nlinarith [mul_pos hKpos (by positivity : (0 : ℝ) < V)])

lemma choose_three_le_four_pred_two_choose_three (V : ℕ) (hV : 7 ≤ V) :
    V.choose 3 ≤ 4 * (V - 2).choose 3 := by
  calc
    V.choose 3 ≤ 2 * (V - 1).choose 3 :=
      choose_three_le_two_pred_choose_three V (by omega)
    _ ≤ 2 * (2 * (V - 2).choose 3) := by
      gcongr
      simpa only [Nat.sub_sub] using
        choose_three_le_two_pred_choose_three (V - 1) (by omega)
    _ = 4 * (V - 2).choose 3 := by ring

/-- Removing at most half of the edges changes the one-vertex avoidance
density by only the stated first-order correction. -/
lemma one_avoid_base_div_depleted_base_le (V M : ℕ) (hV : 6 ≤ V)
    (hM : 1 ≤ M) (hMA : 2 * M ≤ (V - 1).choose 3) :
    (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) /
        ((((V - 1).choose 3 - M + 1 : ℕ) : ℝ) /
          ((V.choose 3 - M + 1 : ℕ) : ℝ)) ≤
      1 + 12 * (M : ℝ) / ((V : ℝ) * (V.choose 3 : ℝ)) := by
  have hMleA : M ≤ (V - 1).choose 3 := by omega
  have hAleK : (V - 1).choose 3 ≤ V.choose 3 := by
    exact Nat.choose_le_choose 3 (by omega)
  have hMleK : M ≤ V.choose 3 := hMleA.trans hAleK
  have hApos : (0 : ℝ) < ((V - 1).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ V - 1)
  have hKpos : (0 : ℝ) < (V.choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ V)
  have hVpos : (0 : ℝ) < V := by positivity
  have hDpos : (0 : ℝ) < ((V - 1).choose 3 : ℝ) - M + 1 := by
    have : (M : ℝ) ≤ ((V - 1).choose 3 : ℕ) := by exact_mod_cast hMleA
    linarith
  have hratio := choose_pred_three_div_choose_three V (by omega : 3 ≤ V)
  have hcross := (div_eq_div_iff hKpos.ne' hVpos.ne').mp hratio
  rw [Nat.cast_sub (by omega : 3 ≤ V), Nat.cast_ofNat] at hcross
  have hdiff :
      (V : ℝ) * ((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) =
        3 * (V.choose 3 : ℝ) := by
    nlinarith
  have hKle2A : (V.choose 3 : ℝ) ≤ 2 * ((V - 1).choose 3 : ℝ) := by
    exact_mod_cast choose_three_le_two_pred_choose_three V hV
  have hhalf :
      ((V - 1).choose 3 : ℝ) / 2 ≤
        ((V - 1).choose 3 : ℝ) - M + 1 := by
    have hMAr : 2 * (M : ℝ) ≤ ((V - 1).choose 3 : ℕ) := by exact_mod_cast hMA
    nlinarith
  have hKle4D :
      (V.choose 3 : ℝ) ≤
        4 * (((V - 1).choose 3 : ℝ) - M + 1) := by
    calc
      (V.choose 3 : ℝ) ≤ 2 * ((V - 1).choose 3 : ℝ) := hKle2A
      _ ≤ 4 * (((V - 1).choose 3 : ℝ) - M + 1) := by nlinarith
  have hm1nonneg : (0 : ℝ) ≤ (M : ℝ) - 1 := by
    have hmR : (1 : ℝ) ≤ M := by exact_mod_cast hM
    linarith
  have hmnonneg : (0 : ℝ) ≤ M := by positivity
  have hsmall :
      3 * ((M : ℝ) - 1) * (V.choose 3 : ℝ) ≤
        12 * (M : ℝ) * (((V - 1).choose 3 : ℝ) - M + 1) := by
    calc
      3 * ((M : ℝ) - 1) * (V.choose 3 : ℝ) ≤
          3 * (M : ℝ) * (V.choose 3 : ℝ) := by gcongr <;> linarith
      _ ≤ 3 * (M : ℝ) *
          (4 * (((V - 1).choose 3 : ℝ) - M + 1)) := by gcongr
      _ = 12 * (M : ℝ) *
          (((V - 1).choose 3 : ℝ) - M + 1) := by ring
  rw [Nat.cast_add, Nat.cast_sub hMleA, Nat.cast_add,
    Nat.cast_sub hMleK]
  norm_num only [Nat.cast_one]
  have hid :
      (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) /
          ((((V - 1).choose 3 : ℝ) - M + 1) /
            ((V.choose 3 : ℝ) - M + 1)) =
        1 +
          (((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) *
              ((M : ℝ) - 1)) /
            ((V.choose 3 : ℝ) *
              (((V - 1).choose 3 : ℝ) - M + 1)) := by
    field_simp
    ring
  rw [hid]
  have hcorr :
      (((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) *
          ((M : ℝ) - 1)) /
          ((V.choose 3 : ℝ) *
            (((V - 1).choose 3 : ℝ) - M + 1)) ≤
        (12 * (M : ℝ)) / ((V : ℝ) * (V.choose 3 : ℝ)) := by
    apply (div_le_div_iff₀ (mul_pos hKpos hDpos) (mul_pos hVpos hKpos)).2
    have hmul := mul_le_mul_of_nonneg_right hsmall hKpos.le
    calc
      (((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) *
            ((M : ℝ) - 1)) * ((V : ℝ) * (V.choose 3 : ℝ)) =
          (3 * (V.choose 3 : ℝ) * ((M : ℝ) - 1)) *
            (V.choose 3 : ℝ) := by
        calc
          (((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) *
                ((M : ℝ) - 1)) * ((V : ℝ) * (V.choose 3 : ℝ)) =
              ((V : ℝ) *
                  ((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ))) *
                ((M : ℝ) - 1) * (V.choose 3 : ℝ) := by ring
          _ = (3 * (V.choose 3 : ℝ)) * ((M : ℝ) - 1) *
                (V.choose 3 : ℝ) := by rw [hdiff]
          _ = (3 * (V.choose 3 : ℝ) * ((M : ℝ) - 1)) *
                (V.choose 3 : ℝ) := by ring
      _ ≤ (12 * (M : ℝ) *
            (((V - 1).choose 3 : ℝ) - M + 1)) *
          (V.choose 3 : ℝ) := by
        simpa only [mul_assoc, mul_left_comm, mul_comm] using hmul
      _ = (12 * (M : ℝ)) *
          ((V.choose 3 : ℝ) *
            (((V - 1).choose 3 : ℝ) - M + 1)) := by ring
  linarith

/-- Exact probability ratio for one prescribed vertex to be avoided by all
`M` sampled edges in the complete 3-graph on `V` vertices. -/
def oneAvoidRatio (V M : ℕ) : ℝ :=
  (((V - 1).choose 3).choose M : ℝ) / ((V.choose 3).choose M : ℝ)

/-- Exact probability ratio for two prescribed vertices to be avoided by all
`M` sampled edges in the complete 3-graph on `V` vertices. -/
def twoAvoidRatio (V M : ℕ) : ℝ :=
  (((V - 2).choose 3).choose M : ℝ) / ((V.choose 3).choose M : ℝ)

/-- The pair-isolation probability is asymptotically no larger than the square
of the one-vertex probability, up to an explicit exponential correction. -/
lemma pair_avoid_ratio_le_exp (V M : ℕ) (hV : 6 ≤ V) (hM : 1 ≤ M)
    (hMB : 2 * M ≤ (V - 2).choose 3) :
    twoAvoidRatio V M / (oneAvoidRatio V M)^2 ≤
      Real.exp (24 * (M : ℝ)^2 / ((V : ℝ) * (V.choose 3 : ℝ))) := by
  have hMleB : M ≤ (V - 2).choose 3 := by omega
  have hBA : (V - 2).choose 3 ≤ (V - 1).choose 3 := by
    exact Nat.choose_le_choose 3 (by omega)
  have hAK : (V - 1).choose 3 ≤ V.choose 3 := by
    exact Nat.choose_le_choose 3 (by omega)
  have hMleA : M ≤ (V - 1).choose 3 := hMleB.trans hBA
  have hMleK : M ≤ V.choose 3 := hMleA.trans hAK
  have hBchoose : (0 : ℝ) < (((V - 2).choose 3).choose M : ℕ) := by
    exact_mod_cast Nat.choose_pos hMleB
  have hAchoose : (0 : ℝ) < (((V - 1).choose 3).choose M : ℕ) := by
    exact_mod_cast Nat.choose_pos hMleA
  have hKchoose : (0 : ℝ) < ((V.choose 3).choose M : ℕ) := by
    exact_mod_cast Nat.choose_pos hMleK
  have hApos : (0 : ℝ) < ((V - 1).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ V - 1)
  have hKpos : (0 : ℝ) < (V.choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ V)
  have hDApos :
      (0 : ℝ) < ((V - 1).choose 3 : ℝ) - M + 1 := by
    have : (M : ℝ) ≤ ((V - 1).choose 3 : ℕ) := by exact_mod_cast hMleA
    linarith
  have hDKpos : (0 : ℝ) < (V.choose 3 : ℝ) - M + 1 := by
    have : (M : ℝ) ≤ (V.choose 3 : ℕ) := by exact_mod_cast hMleK
    linarith
  have hfactor :
      twoAvoidRatio V M / (oneAvoidRatio V M)^2 =
        ((((V - 2).choose 3).choose M : ℝ) /
            (((V - 1).choose 3).choose M : ℝ)) *
          (((V.choose 3).choose M : ℝ) /
            (((V - 1).choose 3).choose M : ℝ)) := by
    unfold oneAvoidRatio twoAvoidRatio
    field_simp
  have hfirst :
      ((((V - 2).choose 3).choose M : ℝ) /
          (((V - 1).choose 3).choose M : ℝ)) ≤
        (((V - 2).choose 3 : ℝ) /
          ((V - 1).choose 3 : ℝ)) ^ M :=
    choose_ratio_le_pow _ _ _ hMleB hBA
  have hlower :
      ((((V - 1).choose 3 : ℝ) - M + 1) /
          ((V.choose 3 : ℝ) - M + 1)) ^ M ≤
        (((V - 1).choose 3).choose M : ℝ) /
          ((V.choose 3).choose M : ℝ) := by
    simpa only [Nat.cast_add, Nat.cast_sub hMleA,
      Nat.cast_sub hMleK, Nat.cast_one] using
      (pow_le_choose_ratio ((V - 1).choose 3) (V.choose 3) M hMleA hAK)
  have hsecond :
      (((V.choose 3).choose M : ℝ) /
          (((V - 1).choose 3).choose M : ℝ)) ≤
        (((V.choose 3 : ℝ) - M + 1) /
          (((V - 1).choose 3 : ℝ) - M + 1)) ^ M := by
    have hinv := (inv_le_inv₀
      (div_pos hAchoose hKchoose)
      (pow_pos (div_pos hDApos hDKpos) M)).mpr hlower
    rw [← inv_pow] at hinv
    have hrecip :
        ((((V - 1).choose 3 : ℝ) - M + 1) /
            ((V.choose 3 : ℝ) - M + 1))⁻¹ =
          ((V.choose 3 : ℝ) - M + 1) /
            (((V - 1).choose 3 : ℝ) - M + 1) := by
      field_simp
    rw [hrecip] at hinv
    have hrecipChoose :
        ((((V - 1).choose 3).choose M : ℝ) /
            ((V.choose 3).choose M : ℝ))⁻¹ =
          ((V.choose 3).choose M : ℝ) /
            (((V - 1).choose 3).choose M : ℝ) := by
      field_simp
    rw [hrecipChoose] at hinv
    exact hinv
  have hprod :
      twoAvoidRatio V M / (oneAvoidRatio V M)^2 ≤
        ((((V - 2).choose 3 : ℝ) /
              ((V - 1).choose 3 : ℝ)) *
            (((V.choose 3 : ℝ) - M + 1) /
              (((V - 1).choose 3 : ℝ) - M + 1))) ^ M := by
    rw [hfactor, mul_pow]
    exact mul_le_mul hfirst hsecond (by positivity) (by positivity)
  have hbase0 :
      ((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ) ≤
        ((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ) := by
    have htwo := two_avoid_base_le_one_avoid_base_sq V (by omega)
    calc
      ((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ) =
          (((V - 2).choose 3 : ℝ) / (V.choose 3 : ℝ)) /
            (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) := by
        field_simp
      _ ≤ ((((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) ^ 2) /
            (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) := by
        exact div_le_div_of_nonneg_right htwo (by positivity)
      _ = ((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ) := by
        field_simp
  have hbase :
      (((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ)) *
          (((V.choose 3 : ℝ) - M + 1) /
            (((V - 1).choose 3 : ℝ) - M + 1)) ≤
        1 + 12 * (M : ℝ) / ((V : ℝ) * (V.choose 3 : ℝ)) := by
    calc
      ((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ) *
            (((V.choose 3 : ℝ) - M + 1) /
              (((V - 1).choose 3 : ℝ) - M + 1)) ≤
          ((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ) *
            (((V.choose 3 : ℝ) - M + 1) /
              (((V - 1).choose 3 : ℝ) - M + 1)) := by
        exact mul_le_mul_of_nonneg_right hbase0 (div_nonneg hDKpos.le hDApos.le)
      _ = (((V - 1).choose 3 : ℝ) / (V.choose 3 : ℝ)) /
          ((((V - 1).choose 3 : ℝ) - M + 1) /
            ((V.choose 3 : ℝ) - M + 1)) := by
        field_simp
      _ ≤ 1 + 12 * (M : ℝ) / ((V : ℝ) * (V.choose 3 : ℝ)) := by
        simpa only [Nat.cast_add, Nat.cast_sub hMleA,
          Nat.cast_sub hMleK, Nat.cast_one] using
          one_avoid_base_div_depleted_base_le V M hV hM
            (hMB.trans (Nat.choose_le_choose 3 (by omega)))
  have hxnonneg :
      0 ≤ 12 * (M : ℝ) / ((V : ℝ) * (V.choose 3 : ℝ)) := by positivity
  calc
    twoAvoidRatio V M / (oneAvoidRatio V M)^2 ≤
        ((((V - 2).choose 3 : ℝ) / ((V - 1).choose 3 : ℝ)) *
            (((V.choose 3 : ℝ) - M + 1) /
              (((V - 1).choose 3 : ℝ) - M + 1))) ^ M := hprod
    _ ≤ (1 + 12 * (M : ℝ) /
          ((V : ℝ) * (V.choose 3 : ℝ))) ^ M := by gcongr
    _ ≤ (Real.exp (12 * (M : ℝ) /
          ((V : ℝ) * (V.choose 3 : ℝ)))) ^ M := by
      gcongr
      simpa only [add_comm] using
        Real.add_one_le_exp (12 * (M : ℝ) /
          ((V : ℝ) * (V.choose 3 : ℝ)))
    _ = Real.exp ((M : ℝ) *
          (12 * (M : ℝ) / ((V : ℝ) * (V.choose 3 : ℝ)))) := by
      rw [← Real.exp_nat_mul]
    _ ≤ Real.exp (24 * (M : ℝ)^2 /
          ((V : ℝ) * (V.choose 3 : ℝ))) := by
      apply Real.exp_le_exp.mpr
      have hden : 0 < (V : ℝ) * (V.choose 3 : ℝ) := by positivity
      field_simp [hden.ne']
      nlinarith [sq_nonneg (M : ℝ)]

/-- The finite second-moment lower bound, normalized into the one- and
two-vertex avoidance ratios used by the asymptotic argument. -/
lemma positive_isolated_probability_exp_lower (n M : ℕ) (hn : 2 ≤ n)
    (hM : 1 ≤ M) (hMB : 2 * M ≤ (3 * n - 2).choose 3) :
    1 / (Real.exp (24 * (M : ℝ)^2 /
          (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
        1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M)) ≤
      ((positiveIsolatedSample n M).card : ℝ) / (sample n M).card := by
  have hMleB : M ≤ (3 * n - 2).choose 3 := by omega
  have hBA : (3 * n - 2).choose 3 ≤ (3 * n - 1).choose 3 := by
    exact Nat.choose_le_choose 3 (by omega)
  have hAK : (3 * n - 1).choose 3 ≤ (3 * n).choose 3 := by
    exact Nat.choose_le_choose 3 (by omega)
  have hMleA : M ≤ (3 * n - 1).choose 3 := hMleB.trans hBA
  have hMleK : M ≤ (3 * n).choose 3 := hMleA.trans hAK
  have hSpos : (0 : ℝ) < (((3 * n).choose 3).choose M : ℕ) := by
    exact_mod_cast Nat.choose_pos hMleK
  have hApos : (0 : ℝ) < (((3 * n - 1).choose 3).choose M : ℕ) := by
    exact_mod_cast Nat.choose_pos hMleA
  have hBpos : (0 : ℝ) < (((3 * n - 2).choose 3).choose M : ℕ) := by
    exact_mod_cast Nat.choose_pos hMleB
  have hVpos : (0 : ℝ) < (3 * n : ℕ) := by
    exact_mod_cast (show 0 < 3 * n by omega)
  have hsample : (sample n M).card ≠ 0 := by
    rw [card_sample]
    simpa [allEdges] using (Nat.choose_pos hMleK).ne'
  have hE2nat :
      0 < ((3 * n) * (3 * n) - 3 * n) *
            ((3 * n - 2).choose 3).choose M +
          (3 * n) * ((3 * n - 1).choose 3).choose M := by
    have hlast :
        0 < (3 * n) * ((3 * n - 1).choose 3).choose M :=
      Nat.mul_pos (by omega) (Nat.choose_pos hMleA)
    omega
  have hsecond :
      (∑ H ∈ sample n M, secondMomentCount H) ≠ 0 := by
    rw [sum_secondMomentCount]
    exact hE2nat.ne'
  have hcs := positive_probability_second_moment_lower n M hsample hsecond
  rw [sum_isolatedCount, sum_secondMomentCount, card_sample] at hcs
  simp [allEdges] at hcs
  have hVV : 3 * n ≤ (3 * n) * (3 * n) := Nat.le_mul_self (3 * n)
  have hnorm :
      ((((3 * n).choose 3).choose M : ℝ) *
          ((((3 * n) * (3 * n) - 3 * n) *
              ((3 * n - 2).choose 3).choose M +
            (3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)) /
          ((((3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)^2) =
        ((((3 * n - 1 : ℕ) : ℝ) / ((3 * n : ℕ) : ℝ)) *
            (twoAvoidRatio (3 * n) M /
              (oneAvoidRatio (3 * n) M)^2)) +
          1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M) := by
    unfold oneAvoidRatio twoAvoidRatio
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_mul, Nat.cast_sub hVV]
    norm_num only [Nat.cast_mul, Nat.cast_sub (by omega : 1 ≤ 3 * n),
      Nat.cast_ofNat]
    field_simp
  have hfactor :
      (((3 * n - 1 : ℕ) : ℝ) / ((3 * n : ℕ) : ℝ)) ≤ 1 := by
    apply (div_le_one hVpos).2
    exact_mod_cast (show 3 * n - 1 ≤ 3 * n by omega)
  have hpairnonneg :
      0 ≤ twoAvoidRatio (3 * n) M /
        (oneAvoidRatio (3 * n) M)^2 := by
    unfold oneAvoidRatio twoAvoidRatio
    positivity
  have hDle :
      ((((3 * n).choose 3).choose M : ℝ) *
          ((((3 * n) * (3 * n) - 3 * n) *
              ((3 * n - 2).choose 3).choose M +
            (3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)) /
          ((((3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)^2) ≤
        Real.exp (24 * (M : ℝ)^2 /
          (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
          1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M) := by
    rw [hnorm]
    calc
      (((3 * n - 1 : ℕ) : ℝ) / ((3 * n : ℕ) : ℝ)) *
            (twoAvoidRatio (3 * n) M / (oneAvoidRatio (3 * n) M)^2) +
          1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M) ≤
        twoAvoidRatio (3 * n) M / (oneAvoidRatio (3 * n) M)^2 +
          1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M) := by
        exact add_le_add_left (by
          simpa only [one_mul] using
            mul_le_mul_of_nonneg_right hfactor hpairnonneg) _
      _ ≤ Real.exp (24 * (M : ℝ)^2 /
            (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
          1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M) := by
        gcongr
        exact pair_avoid_ratio_le_exp (3 * n) M (by omega) hM hMB
  have hDpos :
      (0 : ℝ) <
        ((((3 * n).choose 3).choose M : ℝ) *
          ((((3 * n) * (3 * n) - 3 * n) *
              ((3 * n - 2).choose 3).choose M +
            (3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)) /
          ((((3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)^2) := by
    have hE2pos :
        (0 : ℝ) <
          ((((3 * n) * (3 * n) - 3 * n) *
              ((3 * n - 2).choose 3).choose M +
            (3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ) := by
      exact_mod_cast hE2nat
    have hE1pos :
        (0 : ℝ) <
          (((3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ) := by
      exact_mod_cast Nat.mul_pos (by omega : 0 < 3 * n) (Nat.choose_pos hMleA)
    exact div_pos (mul_pos hSpos hE2pos) (sq_pos_of_pos hE1pos)
  have hUpos :
      (0 : ℝ) < Real.exp (24 * (M : ℝ)^2 /
          (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
        1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M) := by
    have hqpos : 0 < oneAvoidRatio (3 * n) M := by
      unfold oneAvoidRatio
      positivity
    positivity
  calc
    1 / (Real.exp (24 * (M : ℝ)^2 /
          (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
        1 / (((3 * n : ℕ) : ℝ) * oneAvoidRatio (3 * n) M)) ≤
        1 / (((((3 * n).choose 3).choose M : ℝ) *
          ((((3 * n) * (3 * n) - 3 * n) *
              ((3 * n - 2).choose 3).choose M +
            (3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)) /
          ((((3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)^2)) := by
      exact (div_le_div_iff₀ hUpos hDpos).2 (by simpa using hDle)
    _ = ((((3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)^2) /
        ((((3 * n).choose 3).choose M : ℝ) *
          ((((3 * n) * (3 * n) - 3 * n) *
              ((3 * n - 2).choose 3).choose M +
            (3 * n) * ((3 * n - 1).choose 3).choose M : ℕ) : ℝ)) := by
      field_simp
    _ ≤ ((positiveIsolatedSample n M).card : ℝ) / (sample n M).card := by
      simpa [card_sample, allEdges, Nat.cast_add, Nat.cast_mul,
        Nat.cast_sub hVV] using hcs

/-- A convenient polynomial lower bound for the number of triples on `3n`
vertices. -/
lemma cube_le_choose_three_mul (n : ℕ) (hn : 2 ≤ n) :
    (n : ℝ)^3 ≤ ((3 * n).choose 3 : ℝ) := by
  have hchoose := Nat.pow_le_choose (α := ℝ) 3 (3 * n)
  norm_num at hchoose
  have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hsub : 3 * n + 1 - 3 = 3 * n - 2 := by omega
  rw [hsub, Nat.cast_sub (by omega : 2 ≤ 3 * n), Nat.cast_mul] at hchoose
  norm_num only [Nat.cast_ofNat] at hchoose
  have hlinear : (2 : ℝ) * n ≤ 3 * n - 2 := by nlinarith
  have hcub : ((2 : ℝ) * n)^3 ≤ (3 * n - 2)^3 := by gcongr
  have hfirst : (n : ℝ)^3 ≤ (3 * n - 2)^3 / 6 := by
    nlinarith [sq_nonneg (n : ℝ),
      mul_nonneg (sq_nonneg (n : ℝ)) (by linarith [hnR] : (0 : ℝ) ≤ n)]
  exact hfirst.trans hchoose

/-- The logarithmic factor is negligible compared with the square of the
vertex parameter. -/
lemma tendsto_log_three_mul_div_sq :
    Tendsto (fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ)^2)
      atTop (𝓝 0) := by
  have hthree : Tendsto (fun n : ℕ ↦ (3 : ℝ) * (n : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num)
  have hlogdiv : Tendsto
      (fun n : ℕ ↦ Real.log ((3 : ℝ) * (n : ℝ)) /
        ((3 : ℝ) * (n : ℝ))) atTop (𝓝 0) := by
    simpa [Function.comp_def] using
      (Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero).comp hthree
  have hthreeDiv : Tendsto (fun n : ℕ ↦ (3 : ℝ) / (n : ℝ)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
  have hprod : Tendsto
      (fun n : ℕ ↦
        (Real.log ((3 : ℝ) * (n : ℝ)) / ((3 : ℝ) * (n : ℝ))) *
          ((3 : ℝ) / (n : ℝ))) atTop (𝓝 0) := by
    simpa using hlogdiv.mul hthreeDiv
  refine hprod.congr' ?_
  filter_upwards [eventually_ge_atTop 1] with n hn
  norm_num only [Nat.cast_mul, Nat.cast_ofNat]
  field_simp <;> ring

/-- The logarithm of the vertex count is negligible compared with `n`. -/
lemma tendsto_log_three_mul_div :
    Tendsto (fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ))
      atTop (𝓝 0) := by
  have hthree : Tendsto (fun n : ℕ ↦ (3 : ℝ) * (n : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num)
  have hlogdiv : Tendsto
      (fun n : ℕ ↦ Real.log ((3 : ℝ) * (n : ℝ)) /
        ((3 : ℝ) * (n : ℝ))) atTop (𝓝 0) := by
    simpa [Function.comp_def] using
      (Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero).comp hthree
  have hmul := (tendsto_const_nhds.mul hlogdiv :
    Tendsto
      (fun n : ℕ ↦ (3 : ℝ) *
        (Real.log ((3 : ℝ) * (n : ℝ)) / ((3 : ℝ) * (n : ℝ))))
      atTop (𝓝 (3 * 0)))
  norm_num only [mul_zero] at hmul
  refine hmul.congr' ?_
  filter_upwards [eventually_ge_atTop 1] with n hn
  norm_num only [Nat.cast_mul, Nat.cast_ofNat]
  field_simp

/-- The square of the logarithmic factor is negligible compared with
`n`; this is the collision-control scale for supercritical samples. -/
lemma tendsto_sq_log_three_mul_div :
    Tendsto
      (fun n : ℕ ↦
        (Real.log ((3 * n : ℕ) : ℝ))^2 / (n : ℝ))
      atTop (𝓝 0) := by
  have hthree : Tendsto (fun n : ℕ ↦ (3 : ℝ) * (n : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num)
  have hbase : Tendsto
      (fun n : ℕ ↦
        (Real.log ((3 : ℝ) * (n : ℝ)))^2 /
          ((3 : ℝ) * (n : ℝ))) atTop (𝓝 0) := by
    simpa [Function.comp_def] using
      (Real.tendsto_pow_log_div_mul_add_atTop 1 0 2 one_ne_zero).comp hthree
  have hmul := (tendsto_const_nhds.mul hbase :
    Tendsto
      (fun n : ℕ ↦ (3 : ℝ) *
        ((Real.log ((3 : ℝ) * (n : ℝ)))^2 /
          ((3 : ℝ) * (n : ℝ)))) atTop (𝓝 (3 * 0)))
  norm_num only [mul_zero] at hmul
  refine hmul.congr' ?_
  filter_upwards [eventually_ge_atTop 1] with n hn
  norm_num only [Nat.cast_mul, Nat.cast_ofNat]
  field_simp

/-! ## Asymptotic formulation of the resolution -/

/-- Kahn's natural scale after substituting `N = 3 * n` and `r = 3`. -/
def shamirScale (n : ℕ) : ℝ :=
  (n : ℝ) * Real.log (3 * n)

/-- The integer number of edges just below a fixed relative distance from
the threshold. -/
def lowerEdgeCount (ε : ℝ) (n : ℕ) : ℕ :=
  ⌊(1 - ε) * shamirScale n⌋₊

/-- The integer number of edges just above a fixed relative distance from
the threshold. -/
def upperEdgeCount (ε : ℝ) (n : ℕ) : ℕ :=
  ⌈(1 + ε) * shamirScale n⌉₊

lemma shamirScale_nonneg (n : ℕ) : 0 ≤ shamirScale n := by
  cases n with
  | zero => simp [shamirScale]
  | succ n =>
      unfold shamirScale
      exact mul_nonneg (by positivity) (Real.log_nonneg (by
        exact_mod_cast (show 1 ≤ 3 * (n + 1) by omega)))

lemma upperEdgeCount_cast_lt (ε : ℝ) (hε : -1 ≤ ε) (n : ℕ) :
    (upperEdgeCount ε n : ℝ) <
      (1 + ε) * shamirScale n + 1 := by
  exact Nat.ceil_lt_add_one
    (mul_nonneg (by linarith) (shamirScale_nonneg n))

lemma upperEdgeCount_cast_le_two_mul (ε : ℝ) (hε0 : 0 ≤ ε)
    (hε1 : ε ≤ 1) (n : ℕ) :
    (upperEdgeCount ε n : ℝ) ≤ 2 * shamirScale n + 1 := by
  calc
    (upperEdgeCount ε n : ℝ) ≤
        (1 + ε) * shamirScale n + 1 :=
      (upperEdgeCount_cast_lt ε (by linarith) n).le
    _ ≤ 2 * shamirScale n + 1 := by
      have hs := shamirScale_nonneg n
      nlinarith

lemma shamirScale_le_upperEdgeCount (ε : ℝ) (hε : 0 ≤ ε) (n : ℕ) :
    shamirScale n ≤ upperEdgeCount ε n := by
  calc
    shamirScale n ≤ (1 + ε) * shamirScale n := by
      have hs := shamirScale_nonneg n
      nlinarith
    _ ≤ upperEdgeCount ε n := Nat.le_ceil _

/-- The ceiling defining the supercritical edge count is above the exact
real-valued supercritical scale, before discarding the factor `1 + ε`. -/
lemma upperScale_le_upperEdgeCount (ε : ℝ) (hε : -1 ≤ ε) (n : ℕ) :
    (1 + ε) * shamirScale n ≤ upperEdgeCount ε n := by
  simpa only [upperEdgeCount] using
    (Nat.le_ceil ((1 + ε) * shamirScale n))

lemma upperEdgeCount_div_le_two_log_add_inv (ε : ℝ)
    (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) {n : ℕ} (hn : 0 < n) :
    (upperEdgeCount ε n : ℝ) / (n : ℝ) ≤
      2 * Real.log ((3 * n : ℕ) : ℝ) + 1 / (n : ℝ) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  apply (div_le_iff₀ hnR).2
  calc
    (upperEdgeCount ε n : ℝ) ≤ 2 * shamirScale n + 1 :=
      upperEdgeCount_cast_le_two_mul ε hε0 hε1 n
    _ = (2 * Real.log ((3 * n : ℕ) : ℝ) + 1 / (n : ℝ)) * n := by
      unfold shamirScale
      norm_num only [Nat.cast_mul, Nat.cast_ofNat]
      field_simp [hnR.ne']

/-- At any fixed supercritical constant factor at most two, the iid
collision correction for an ordered sample vanishes. -/
lemma upper_collision_ratio_tendsto_zero (ε : ℝ)
    (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) :
    Tendsto
      (fun n : ℕ ↦
        2 * (upperEdgeCount ε n : ℝ)^2 /
          ((3 * n).choose 3 : ℝ)) atTop (𝓝 0) := by
  have hinv : Tendsto (fun n : ℕ ↦ (1 : ℝ) / (n : ℝ))
      atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
  have htwolog := (tendsto_const_nhds.mul tendsto_log_three_mul_div :
    Tendsto
      (fun n : ℕ ↦ (2 : ℝ) *
        (Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ)))
      atTop (𝓝 (2 * 0)))
  norm_num only [mul_zero] at htwolog
  have hsum : Tendsto
      (fun n : ℕ ↦
        (Real.log ((3 * n : ℕ) : ℝ))^2 / (n : ℝ) +
          2 * (Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ)) +
          1 / (n : ℝ)) atTop (𝓝 0) := by
    simpa only [add_zero] using
      (tendsto_sq_log_three_mul_div.add htwolog).add hinv
  have hupper : Tendsto
      (fun n : ℕ ↦ 18 *
        ((Real.log ((3 * n : ℕ) : ℝ) + 1)^2 / (n : ℝ)))
      atTop (𝓝 0) := by
    have hmul := (tendsto_const_nhds.mul hsum :
      Tendsto
        (fun n : ℕ ↦ (18 : ℝ) *
          ((Real.log ((3 * n : ℕ) : ℝ))^2 / (n : ℝ) +
            2 * (Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ)) +
            1 / (n : ℝ))) atTop (𝓝 (18 * 0)))
    norm_num only [mul_zero] at hmul
    refine hmul.congr' (Eventually.of_forall fun n ↦ ?_)
    ring
  apply squeeze_zero'
    (Eventually.of_forall fun n ↦ by positivity) _ hupper
  filter_upwards [eventually_ge_atTop 2] with n hn
  let L := Real.log ((3 * n : ℕ) : ℝ)
  have hnR : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hL0 : 0 ≤ L := by
    dsimp [L]
    apply Real.log_nonneg
    exact_mod_cast (show 1 ≤ 3 * n by omega)
  have hMle : (upperEdgeCount ε n : ℝ) ≤
      2 * ((n : ℝ) * L) + 1 := by
    simpa [shamirScale, L] using
      upperEdgeCount_cast_le_two_mul ε hε0 hε1 n
  have hone : (1 : ℝ) ≤ (n : ℝ) * (L + 1) := by
    have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast (show 1 ≤ n by omega)
    nlinarith [mul_nonneg hnR.le hL0]
  have hMbound : (upperEdgeCount ε n : ℝ) ≤
      3 * (n : ℝ) * (L + 1) := by
    nlinarith [mul_nonneg hnR.le hL0]
  have hMsq : (upperEdgeCount ε n : ℝ)^2 ≤
      (3 * (n : ℝ) * (L + 1))^2 := by
    gcongr
  have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
  have hKlower : (n : ℝ)^3 ≤ ((3 * n).choose 3 : ℝ) :=
    cube_le_choose_three_mul n hn
  have hu0 : 0 ≤ 18 * (L + 1)^2 / (n : ℝ) := by positivity
  apply (div_le_iff₀ hKpos).2
  calc
    2 * (upperEdgeCount ε n : ℝ)^2 ≤
        2 * (3 * (n : ℝ) * (L + 1))^2 := by gcongr
    _ = 18 * (n : ℝ)^2 * (L + 1)^2 := by ring
    _ = (18 * (L + 1)^2 / (n : ℝ)) * (n : ℝ)^3 := by
      field_simp [hnR.ne']
    _ ≤ (18 * (L + 1)^2 / (n : ℝ)) *
        ((3 * n).choose 3 : ℝ) := by
      exact mul_le_mul_of_nonneg_left hKlower hu0
    _ = 18 *
        ((Real.log ((3 * n : ℕ) : ℝ) + 1)^2 / (n : ℝ)) *
          ((3 * n).choose 3 : ℝ) := by
      dsimp [L]
      ring

/-- Consequently the iid-to-without-replacement coupling hypothesis holds
eventually for the supercritical edge count. -/
lemma eventually_upperEdgeCount_collision_condition (ε : ℝ)
    (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) :
    ∀ᶠ n : ℕ in atTop,
      2 * upperEdgeCount ε n * upperEdgeCount ε n ≤
        (allEdges n).card := by
  have hratio := upper_collision_ratio_tendsto_zero ε hε0 hε1
  have hsmall : ∀ᶠ n : ℕ in atTop,
      2 * (upperEdgeCount ε n : ℝ)^2 /
          ((3 * n).choose 3 : ℝ) < 1 :=
    (tendsto_order.1 hratio).2 _ (by norm_num)
  filter_upwards [hsmall, eventually_ge_atTop 2] with n hsmall hn
  have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
  have hreal : (2 : ℝ) * (upperEdgeCount ε n : ℝ)^2 <
      ((3 * n).choose 3 : ℝ) :=
    (div_lt_one hKpos).mp hsmall
  rw [card_allEdges]
  have hreal' :
      ((2 * upperEdgeCount ε n * upperEdgeCount ε n : ℕ) : ℝ) <
        ((3 * n).choose 3 : ℝ) := by
    norm_num only [Nat.cast_mul, Nat.cast_ofNat]
    simpa [pow_two, mul_assoc] using hreal
  have hnat : 2 * upperEdgeCount ε n * upperEdgeCount ε n <
      (3 * n).choose 3 := by exact_mod_cast hreal'
  exact hnat.le

lemma lowerEdgeCount_cast_le (ε : ℝ) (hε : ε ≤ 1) (n : ℕ) :
    (lowerEdgeCount ε n : ℝ) ≤ (1 - ε) * shamirScale n := by
  exact Nat.floor_le (mul_nonneg (sub_nonneg.mpr hε) (shamirScale_nonneg n))

/-- In the subcritical window the number of sampled edges is negligible
compared with the total number of triples. -/
lemma lowerEdgeCount_div_choose_tendsto_zero (ε : ℝ) (hε0 : 0 ≤ ε)
    (hε1 : ε ≤ 1) :
    Tendsto
      (fun n : ℕ ↦ (lowerEdgeCount ε n : ℝ) /
        ((3 * n).choose 3 : ℝ)) atTop (𝓝 0) := by
  apply squeeze_zero'
    (g := fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ)^2)
    (Eventually.of_forall fun n => by positivity)
  · filter_upwards [eventually_ge_atTop 2] with n hn
    have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
      exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
    have hnpos : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
    have hlog : 0 ≤ Real.log ((3 * n : ℕ) : ℝ) := by
      apply Real.log_nonneg
      exact_mod_cast (show 1 ≤ 3 * n by omega)
    have hMle :
        (lowerEdgeCount ε n : ℝ) ≤
          (n : ℝ) * Real.log ((3 * n : ℕ) : ℝ) := by
      calc
        (lowerEdgeCount ε n : ℝ) ≤ (1 - ε) * shamirScale n :=
          lowerEdgeCount_cast_le ε hε1 n
        _ ≤ shamirScale n := by
          have hsnonneg := shamirScale_nonneg n
          nlinarith
        _ = (n : ℝ) * Real.log ((3 * n : ℕ) : ℝ) := by
          simp [shamirScale]
    have hKlower : (n : ℝ)^3 ≤ ((3 * n).choose 3 : ℝ) :=
      cube_le_choose_three_mul n hn
    apply (div_le_div_iff₀ hKpos (sq_pos_of_pos hnpos)).2
    calc
      (lowerEdgeCount ε n : ℝ) * (n : ℝ)^2 ≤
          ((n : ℝ) * Real.log ((3 * n : ℕ) : ℝ)) * (n : ℝ)^2 := by
        exact mul_le_mul_of_nonneg_right hMle (sq_nonneg _)
      _ = Real.log ((3 * n : ℕ) : ℝ) * (n : ℝ)^3 := by ring
      _ ≤ Real.log ((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ) := by
        exact mul_le_mul_of_nonneg_left hKlower hlog
  · exact tendsto_log_three_mul_div_sq

/-- The exponential correction in the pair-isolation estimate vanishes in
the subcritical window. -/
lemma lower_correlation_error_tendsto_zero (ε : ℝ) (hε0 : 0 ≤ ε)
    (hε1 : ε ≤ 1) :
    Tendsto
      (fun n : ℕ ↦ 24 * (lowerEdgeCount ε n : ℝ)^2 /
        (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ)))
      atTop (𝓝 0) := by
  have hupper :
      Tendsto
        (fun n : ℕ ↦ 8 *
          (Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ))^2)
        atTop (𝓝 0) := by
    have hsq := tendsto_log_three_mul_div.pow 2
    have hmul := (tendsto_const_nhds.mul hsq :
      Tendsto
        (fun n : ℕ ↦ (8 : ℝ) *
          (Real.log ((3 * n : ℕ) : ℝ) / (n : ℝ))^2)
        atTop (𝓝 (8 * 0^2)))
    norm_num at hmul ⊢
    exact hmul
  apply squeeze_zero' (Eventually.of_forall fun n => by positivity) _ hupper
  filter_upwards [eventually_ge_atTop 2] with n hn
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
  have hlog : 0 ≤ Real.log ((3 * n : ℕ) : ℝ) := by
    apply Real.log_nonneg
    exact_mod_cast (show 1 ≤ 3 * n by omega)
  have hMle :
      (lowerEdgeCount ε n : ℝ) ≤
        (n : ℝ) * Real.log ((3 * n : ℕ) : ℝ) := by
    calc
      (lowerEdgeCount ε n : ℝ) ≤ (1 - ε) * shamirScale n :=
        lowerEdgeCount_cast_le ε hε1 n
      _ ≤ shamirScale n := by
        have hs := shamirScale_nonneg n
        nlinarith
      _ = (n : ℝ) * Real.log ((3 * n : ℕ) : ℝ) := by
        simp [shamirScale]
  have hMnonneg : (0 : ℝ) ≤ lowerEdgeCount ε n := by positivity
  have huppernonneg :
      (0 : ℝ) ≤ (n : ℝ) * Real.log ((3 * n : ℕ) : ℝ) :=
    mul_nonneg hnpos.le hlog
  have hsqM :
      (lowerEdgeCount ε n : ℝ)^2 ≤
        ((n : ℝ) * Real.log ((3 * n : ℕ) : ℝ))^2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hMle)
      (add_nonneg huppernonneg hMnonneg)]
  have hKlower : (n : ℝ)^3 ≤ ((3 * n).choose 3 : ℝ) :=
    cube_le_choose_three_mul n hn
  have hleft := mul_le_mul_of_nonneg_right hsqM hnpos.le
  have hright := mul_le_mul_of_nonneg_left hKlower
    (sq_nonneg (Real.log ((3 * n : ℕ) : ℝ)))
  have hleft' :
      (lowerEdgeCount ε n : ℝ)^2 * (n : ℝ) ≤
        Real.log ((3 * n : ℕ) : ℝ)^2 * (n : ℝ)^3 := by
    calc
      (lowerEdgeCount ε n : ℝ)^2 * (n : ℝ) ≤
          (((n : ℝ) * Real.log ((3 * n : ℕ) : ℝ))^2) * (n : ℝ) := hleft
      _ = Real.log ((3 * n : ℕ) : ℝ)^2 * (n : ℝ)^3 := by ring
  have hcore :
      (lowerEdgeCount ε n : ℝ)^2 * (n : ℝ) ≤
        Real.log ((3 * n : ℕ) : ℝ)^2 * ((3 * n).choose 3 : ℝ) :=
    hleft'.trans hright
  have hcoreN := mul_le_mul_of_nonneg_right hcore hnpos.le
  norm_num only [Nat.cast_mul, Nat.cast_ofNat] at hcoreN
  norm_num only [Nat.cast_mul, Nat.cast_ofNat]
  rw [div_pow, ← mul_div_assoc]
  apply (div_le_div_iff₀
    (mul_pos (mul_pos (by norm_num) hnpos) hKpos) (pow_pos hnpos 2)).2
  nlinarith [hcoreN]

lemma log_one_sub_le_neg {x : ℝ} (hx : x < 1) :
    Real.log (1 - x) ≤ -x := by
  have h := Real.log_le_sub_one_of_pos (sub_pos.mpr hx)
  linarith

lemma neg_div_one_sub_le_log_one_sub {x : ℝ} (hx : x < 1) :
    -x / (1 - x) ≤ Real.log (1 - x) := by
  have hpos : 0 < 1 - x := sub_pos.mpr hx
  have h := Real.log_le_sub_one_of_pos (inv_pos.mpr hpos)
  rw [Real.log_inv] at h
  have heq : (1 - x)⁻¹ - 1 = x / (1 - x) := by
    field_simp
    ring
  rw [heq] at h
  rw [show -x / (1 - x) = -(x / (1 - x)) by ring]
  linarith

/-- A finite lower bound for the expected number of isolated vertices.  The
last hypothesis is the explicit logarithmic budget; later asymptotic lemmas
verify it for the subcritical edge count. -/
lemma exp_le_expected_isolated (V M : ℕ) (δ : ℝ) (hV : 6 ≤ V)
    (hMA : M ≤ (V - 1).choose 3)
    (hbudget :
      (M : ℝ) *
          ((((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) /
              ((V.choose 3 : ℝ) - M + 1)) /
            (1 - (((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) /
              ((V.choose 3 : ℝ) - M + 1)))) ≤
        (1 - δ) * Real.log (V : ℝ)) :
    Real.exp (δ * Real.log (V : ℝ)) ≤
      (V : ℝ) * oneAvoidRatio V M := by
  have hAK : (V - 1).choose 3 ≤ V.choose 3 := by
    exact Nat.choose_le_choose 3 (by omega)
  have hMK : M ≤ V.choose 3 := hMA.trans hAK
  have hVpos : (0 : ℝ) < V := by positivity
  have hKpos : (0 : ℝ) < (V.choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ V)
  have hDpos : (0 : ℝ) < (V.choose 3 : ℝ) - M + 1 := by
    have : (M : ℝ) ≤ (V.choose 3 : ℕ) := by exact_mod_cast hMK
    linarith
  let u : ℝ :=
    ((V.choose 3 : ℝ) - ((V - 1).choose 3 : ℝ)) /
      ((V.choose 3 : ℝ) - M + 1)
  have hu0 : 0 ≤ u := by
    dsimp [u]
    exact div_nonneg (sub_nonneg.mpr (by exact_mod_cast hAK)) hDpos.le
  have hu1 : u < 1 := by
    dsimp [u]
    apply (div_lt_one hDpos).2
    have hMAr : (M : ℝ) ≤ ((V - 1).choose 3 : ℕ) := by exact_mod_cast hMA
    linarith
  have hd :
      1 - u =
        (((V - 1).choose 3 : ℝ) - M + 1) /
          ((V.choose 3 : ℝ) - M + 1) := by
    dsimp [u]
    field_simp
    ring
  have hlogd : -u / (1 - u) ≤ Real.log (1 - u) :=
    neg_div_one_sub_le_log_one_sub hu1
  have hmnonneg : (0 : ℝ) ≤ M := by positivity
  have hmLog := mul_le_mul_of_nonneg_left hlogd hmnonneg
  have hmLog' :
      -((M : ℝ) * (u / (1 - u))) ≤
        (M : ℝ) * Real.log (1 - u) := by
    calc
      -((M : ℝ) * (u / (1 - u))) =
          (M : ℝ) * (-u / (1 - u)) := by ring
      _ ≤ (M : ℝ) * Real.log (1 - u) := hmLog
  have hexp :
      Real.exp (-((M : ℝ) * (u / (1 - u)))) ≤ (1 - u) ^ M := by
    calc
      Real.exp (-((M : ℝ) * (u / (1 - u)))) ≤
          Real.exp ((M : ℝ) * Real.log (1 - u)) :=
        Real.exp_le_exp.mpr hmLog'
      _ = (1 - u) ^ M := by
        rw [Real.exp_nat_mul, Real.exp_log (sub_pos.mpr hu1)]
  have hqLower : (1 - u)^M ≤ oneAvoidRatio V M := by
    rw [hd]
    unfold oneAvoidRatio
    simpa only [Nat.cast_add, Nat.cast_sub hMA, Nat.cast_sub hMK,
      Nat.cast_one] using
      (pow_le_choose_ratio ((V - 1).choose 3) (V.choose 3) M hMA hAK)
  have hbudget' :
      (M : ℝ) * (u / (1 - u)) ≤
        (1 - δ) * Real.log (V : ℝ) := by
    simpa only [u] using hbudget
  calc
    Real.exp (δ * Real.log (V : ℝ)) =
        Real.exp (Real.log (V : ℝ) +
          (-((1 - δ) * Real.log (V : ℝ)))) := by
      congr 1
      ring
    _ ≤ Real.exp (Real.log (V : ℝ) +
          (-((M : ℝ) * (u / (1 - u))))) := by
      apply Real.exp_le_exp.mpr
      linarith
    _ = Real.exp (Real.log (V : ℝ)) *
          Real.exp (-((M : ℝ) * (u / (1 - u)))) :=
      Real.exp_add _ _
    _ = (V : ℝ) * Real.exp (-((M : ℝ) * (u / (1 - u)))) := by
      rw [Real.exp_log hVpos]
    _ ≤ (V : ℝ) * (1 - u)^M :=
      mul_le_mul_of_nonneg_left hexp hVpos.le
    _ ≤ (V : ℝ) * oneAvoidRatio V M :=
      mul_le_mul_of_nonneg_left hqLower hVpos.le

/-- Once both the sampling density and `1/n` are small, the logarithmic
cost of making a vertex isolated is at most `(1 + ε/4)/n`. -/
lemma isolation_correction_three_mul_le (ε : ℝ) (n M : ℕ)
    (hε0 : 0 < ε) (hε1 : ε < 1) (hn : 2 ≤ n)
    (hMsmall :
      (M : ℝ) / ((3 * n).choose 3 : ℝ) ≤ ε / 16)
    (hnsmall : (1 : ℝ) / (n : ℝ) ≤ ε / 16) :
    ((((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) /
          (((3 * n).choose 3 : ℝ) - M + 1)) /
        (1 - ((((3 * n).choose 3 : ℝ) -
          ((3 * n - 1).choose 3 : ℝ)) /
            (((3 * n).choose 3 : ℝ) - M + 1))) ≤
      (1 + ε / 4) / (n : ℝ) := by
  have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hKle2A :
      ((3 * n).choose 3 : ℝ) ≤ 2 * ((3 * n - 1).choose 3 : ℝ) := by
    exact_mod_cast choose_three_le_two_pred_choose_three (3 * n) (by omega)
  have hMcross :
      (M : ℝ) ≤ ε / 16 * ((3 * n).choose 3 : ℝ) :=
    (div_le_iff₀ hKpos).mp hMsmall
  have hMltK : (M : ℝ) < ((3 * n).choose 3 : ℕ) / 8 := by
    have hεle : ε ≤ 1 := hε1.le
    nlinarith [mul_pos hKpos (by linarith : (0 : ℝ) < 1 - ε)]
  have hMA : M ≤ (3 * n - 1).choose 3 := by
    have hMleHalfK : (2 : ℝ) * M ≤ ((3 * n).choose 3 : ℕ) := by
      nlinarith
    have hMleAreal : (M : ℝ) ≤ ((3 * n - 1).choose 3 : ℕ) := by
      nlinarith
    exact_mod_cast hMleAreal
  have hDpos :
      (0 : ℝ) < ((3 * n - 1).choose 3 : ℝ) - M + 1 := by
    have : (M : ℝ) ≤ ((3 * n - 1).choose 3 : ℕ) := by exact_mod_cast hMA
    linarith
  have hratio := choose_pred_three_div_choose_three (3 * n) (by omega)
  have hVpos : (0 : ℝ) < (3 * n : ℕ) := by
    exact_mod_cast (show 0 < 3 * n by omega)
  have hcross := (div_eq_div_iff hKpos.ne'
    hVpos.ne').mp hratio
  rw [Nat.cast_sub (by omega : 3 ≤ 3 * n), Nat.cast_ofNat] at hcross
  norm_num only [Nat.cast_mul, Nat.cast_ofNat] at hcross
  have hdiff :
      (n : ℝ) *
          (((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) =
        ((3 * n).choose 3 : ℝ) := by
    nlinarith
  have hKdiv :
      ((3 * n).choose 3 : ℝ) / (n : ℝ) =
        ((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ) := by
    apply (div_eq_iff hnpos.ne').2
    nlinarith [hdiff]
  have hXsmall :
      ((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ) ≤
        ε / 16 * ((3 * n).choose 3 : ℝ) := by
    have hmul := mul_le_mul_of_nonneg_right hnsmall hKpos.le
    rw [one_div, inv_mul_eq_div, hKdiv] at hmul
    exact hmul
  have hDlower :
      (1 - ε / 8) * ((3 * n).choose 3 : ℝ) ≤
        ((3 * n - 1).choose 3 : ℝ) - M + 1 := by
    nlinarith
  have hcoef :
      (1 : ℝ) ≤ (1 + ε / 4) * (1 - ε / 8) := by
    nlinarith [mul_pos hε0 (by linarith : (0 : ℝ) < 4 - ε)]
  have hKD :
      ((3 * n).choose 3 : ℝ) ≤
        (1 + ε / 4) * (((3 * n - 1).choose 3 : ℝ) - M + 1) := by
    calc
      ((3 * n).choose 3 : ℝ) ≤
          ((1 + ε / 4) * (1 - ε / 8)) *
            ((3 * n).choose 3 : ℝ) := by
        simpa only [one_mul] using
          mul_le_mul_of_nonneg_right hcoef hKpos.le
      _ ≤ (1 + ε / 4) *
          (((3 * n - 1).choose 3 : ℝ) - M + 1) := by
        simpa only [mul_assoc] using
          mul_le_mul_of_nonneg_left hDlower (by linarith : 0 ≤ 1 + ε / 4)
  have hMK : M ≤ (3 * n).choose 3 :=
    hMA.trans (Nat.choose_le_choose 3 (by omega))
  have hDKpos :
      (0 : ℝ) < ((3 * n).choose 3 : ℝ) - M + 1 := by
    have : (M : ℝ) ≤ ((3 * n).choose 3 : ℕ) := by exact_mod_cast hMK
    linarith
  have hdenid :
      1 - ((((3 * n).choose 3 : ℝ) -
          ((3 * n - 1).choose 3 : ℝ)) /
            (((3 * n).choose 3 : ℝ) - M + 1)) =
        (((3 * n - 1).choose 3 : ℝ) - M + 1) /
          (((3 * n).choose 3 : ℝ) - M + 1) := by
    field_simp [hDKpos.ne']
    ring
  have hcorr :
      ((((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) /
            (((3 * n).choose 3 : ℝ) - M + 1)) /
          (1 - ((((3 * n).choose 3 : ℝ) -
            ((3 * n - 1).choose 3 : ℝ)) /
              (((3 * n).choose 3 : ℝ) - M + 1))) =
        (((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) /
          (((3 * n - 1).choose 3 : ℝ) - M + 1) := by
    rw [hdenid]
    field_simp
  rw [hcorr]
  apply (div_le_div_iff₀ hDpos hnpos).2
  calc
    (((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) *
        (n : ℝ) = ((3 * n).choose 3 : ℝ) := by nlinarith [hdiff]
    _ ≤ (1 + ε / 4) *
        (((3 * n - 1).choose 3 : ℝ) - M + 1) := hKD

/-- The finite logarithmic budget needed for the isolated-vertex lower bound
holds eventually at the subcritical edge count. -/
lemma eventually_lowerEdgeCount_isolation_budget (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1) :
    ∀ᶠ n : ℕ in atTop,
      lowerEdgeCount ε n ≤ (3 * n - 1).choose 3 ∧
      (lowerEdgeCount ε n : ℝ) *
          (((((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) /
              (((3 * n).choose 3 : ℝ) - lowerEdgeCount ε n + 1)) /
            (1 - ((((3 * n).choose 3 : ℝ) -
              ((3 * n - 1).choose 3 : ℝ)) /
                (((3 * n).choose 3 : ℝ) - lowerEdgeCount ε n + 1)))) ≤
        (1 - ε / 2) * Real.log ((3 * n : ℕ) : ℝ) := by
  have hMzero := lowerEdgeCount_div_choose_tendsto_zero ε hε0.le hε1.le
  have hnzero : Tendsto (fun n : ℕ ↦ (1 : ℝ) / (n : ℝ)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
  have hMev :
      ∀ᶠ n : ℕ in atTop,
        (lowerEdgeCount ε n : ℝ) / ((3 * n).choose 3 : ℝ) < ε / 16 :=
    (tendsto_order.1 hMzero).2 _ (by linarith)
  have hnev : ∀ᶠ n : ℕ in atTop, (1 : ℝ) / (n : ℝ) < ε / 16 :=
    (tendsto_order.1 hnzero).2 _ (by linarith)
  filter_upwards [hMev, hnev, eventually_ge_atTop 2] with n hMsmall hnsmall hn
  have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
  have hMcross :
      (lowerEdgeCount ε n : ℝ) ≤
        ε / 16 * ((3 * n).choose 3 : ℝ) :=
    ((div_lt_iff₀ hKpos).mp hMsmall).le
  have hKle2A :
      ((3 * n).choose 3 : ℝ) ≤ 2 * ((3 * n - 1).choose 3 : ℝ) := by
    exact_mod_cast choose_three_le_two_pred_choose_three (3 * n) (by omega)
  have hMAreal :
      (lowerEdgeCount ε n : ℝ) ≤ ((3 * n - 1).choose 3 : ℕ) := by
    nlinarith [mul_pos hKpos (by linarith : (0 : ℝ) < 1 - ε)]
  have hMA : lowerEdgeCount ε n ≤ (3 * n - 1).choose 3 := by
    exact_mod_cast hMAreal
  refine ⟨hMA, ?_⟩
  have hcorr := isolation_correction_three_mul_le ε n (lowerEdgeCount ε n)
    hε0 hε1 hn hMsmall.le hnsmall.le
  have hMle :
      (lowerEdgeCount ε n : ℝ) ≤
        (1 - ε) * ((n : ℝ) * Real.log ((3 * n : ℕ) : ℝ)) := by
    simpa [shamirScale] using lowerEdgeCount_cast_le ε hε1.le n
  have hlog : 0 ≤ Real.log ((3 * n : ℕ) : ℝ) := by
    apply Real.log_nonneg
    exact_mod_cast (show 1 ≤ 3 * n by omega)
  have hcoef :
      (1 - ε) * (1 + ε / 4) ≤ 1 - ε / 2 := by
    nlinarith [mul_pos hε0 (by linarith : (0 : ℝ) < 1 + ε)]
  calc
    (lowerEdgeCount ε n : ℝ) *
          (((((3 * n).choose 3 : ℝ) - ((3 * n - 1).choose 3 : ℝ)) /
              (((3 * n).choose 3 : ℝ) - lowerEdgeCount ε n + 1)) /
            (1 - ((((3 * n).choose 3 : ℝ) -
              ((3 * n - 1).choose 3 : ℝ)) /
                (((3 * n).choose 3 : ℝ) - lowerEdgeCount ε n + 1)))) ≤
        (lowerEdgeCount ε n : ℝ) * ((1 + ε / 4) / (n : ℝ)) := by
      exact mul_le_mul_of_nonneg_left hcorr (by positivity)
    _ ≤ ((1 - ε) * ((n : ℝ) * Real.log ((3 * n : ℕ) : ℝ))) *
          ((1 + ε / 4) / (n : ℝ)) := by
      exact mul_le_mul_of_nonneg_right hMle (by positivity)
    _ = ((1 - ε) * (1 + ε / 4)) *
          Real.log ((3 * n : ℕ) : ℝ) := by
      have hn0 : (n : ℝ) ≠ 0 := by positivity
      field_simp
    _ ≤ (1 - ε / 2) * Real.log ((3 * n : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_right hcoef hlog

/-- Below the threshold, the expected number of isolated vertices diverges. -/
lemma lower_expected_isolated_tendsto_atTop (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1) :
    Tendsto
      (fun n : ℕ ↦ ((3 * n : ℕ) : ℝ) *
        oneAvoidRatio (3 * n) (lowerEdgeCount ε n)) atTop atTop := by
  have hthree : Tendsto (fun n : ℕ ↦ ((3 * n : ℕ) : ℝ)) atTop atTop := by
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using
      tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num : (0 : ℝ) < 3)
  have hlog :
      Tendsto (fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp hthree
  have hscaled :
      Tendsto (fun n : ℕ ↦ (ε / 2) * Real.log ((3 * n : ℕ) : ℝ))
        atTop atTop :=
    hlog.const_mul_atTop (by linarith : 0 < ε / 2)
  have hexp :
      Tendsto
        (fun n : ℕ ↦ Real.exp ((ε / 2) *
          Real.log ((3 * n : ℕ) : ℝ))) atTop atTop :=
    Real.tendsto_exp_atTop.comp hscaled
  apply tendsto_atTop_mono' atTop _ hexp
  filter_upwards [eventually_lowerEdgeCount_isolation_budget ε hε0 hε1,
    eventually_ge_atTop 2] with n hbudget hn
  exact exp_le_expected_isolated (3 * n) (lowerEdgeCount ε n) (ε / 2)
    (by omega) hbudget.1 hbudget.2

/-- The subcritical edge count itself tends to infinity. -/
lemma lowerEdgeCount_tendsto_atTop (ε : ℝ) (hε1 : ε < 1) :
    Tendsto (lowerEdgeCount ε) atTop atTop := by
  have hthree : Tendsto (fun n : ℕ ↦ ((3 * n : ℕ) : ℝ)) atTop atTop := by
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using
      tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num : (0 : ℝ) < 3)
  have hlog :
      Tendsto (fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp hthree
  have hprod :
      Tendsto
        (fun n : ℕ ↦ (n : ℝ) * Real.log ((3 * n : ℕ) : ℝ))
        atTop atTop :=
    tendsto_natCast_atTop_atTop.atTop_mul_atTop₀ hlog
  have hscale :
      Tendsto
        (fun n : ℕ ↦ (1 - ε) *
          ((n : ℝ) * Real.log ((3 * n : ℕ) : ℝ))) atTop atTop :=
    hprod.const_mul_atTop (sub_pos.mpr hε1)
  have hfloor := tendsto_nat_floor_atTop.comp hscale
  refine hfloor.congr' (Eventually.of_forall fun n => ?_)
  simp [lowerEdgeCount, shamirScale, Function.comp_def]

/-- Eventually the hypotheses of the finite pair-isolation estimate hold for
the subcritical edge count. -/
lemma eventually_lowerEdgeCount_pair_conditions (ε : ℝ) (hε0 : 0 ≤ ε)
    (hε1 : ε < 1) :
    ∀ᶠ n : ℕ in atTop,
      1 ≤ lowerEdgeCount ε n ∧
        2 * lowerEdgeCount ε n ≤ (3 * n - 2).choose 3 := by
  have hMone : ∀ᶠ n : ℕ in atTop, 1 ≤ lowerEdgeCount ε n :=
    (tendsto_atTop.1 (lowerEdgeCount_tendsto_atTop ε hε1) 1)
  have hMzero := lowerEdgeCount_div_choose_tendsto_zero ε hε0 hε1.le
  have hsmall :
      ∀ᶠ n : ℕ in atTop,
        (lowerEdgeCount ε n : ℝ) / ((3 * n).choose 3 : ℝ) < 1 / 8 :=
    (tendsto_order.1 hMzero).2 _ (by norm_num)
  filter_upwards [hMone, hsmall, eventually_ge_atTop 3] with n hMone hsmall hn
  have hKpos : (0 : ℝ) < ((3 * n).choose 3 : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega : 3 ≤ 3 * n)
  have hcross :
      (lowerEdgeCount ε n : ℝ) < ((3 * n).choose 3 : ℝ) / 8 := by
    have := (div_lt_iff₀ hKpos).mp hsmall
    nlinarith
  have h8M : 8 * lowerEdgeCount ε n ≤ (3 * n).choose 3 := by
    exact_mod_cast (show (8 : ℝ) * lowerEdgeCount ε n ≤
      ((3 * n).choose 3 : ℝ) by nlinarith)
  have hKle4B := choose_three_le_four_pred_two_choose_three (3 * n) (by omega)
  exact ⟨hMone, by omega⟩

/-- The probability that at least one vertex is isolated tends to one below
the threshold. -/
lemma positive_isolated_probability_tendsto_one (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1) :
    Tendsto
      (fun n : ℕ ↦
        ((positiveIsolatedSample n (lowerEdgeCount ε n)).card : ℝ) /
          (sample n (lowerEdgeCount ε n)).card) atTop (𝓝 1) := by
  have herror := lower_correlation_error_tendsto_zero ε hε0.le hε1.le
  have hexp :
      Tendsto
        (fun n : ℕ ↦ Real.exp (24 * (lowerEdgeCount ε n : ℝ)^2 /
          (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))))
        atTop (𝓝 1) :=
    Real.tendsto_exp_nhds_zero_nhds_one.comp herror
  have hmean := lower_expected_isolated_tendsto_atTop ε hε0 hε1
  have hinvMean :
      Tendsto
        (fun n : ℕ ↦ 1 /
          (((3 * n : ℕ) : ℝ) *
            oneAvoidRatio (3 * n) (lowerEdgeCount ε n)))
        atTop (𝓝 0) := by
    refine hmean.inv_tendsto_atTop.congr'
      (Eventually.of_forall fun n => ?_)
    simp only [Pi.inv_apply, one_div]
  have hU :
      Tendsto
        (fun n : ℕ ↦ Real.exp (24 * (lowerEdgeCount ε n : ℝ)^2 /
            (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
          1 / (((3 * n : ℕ) : ℝ) *
            oneAvoidRatio (3 * n) (lowerEdgeCount ε n)))
        atTop (𝓝 1) := by
    convert hexp.add hinvMean using 1 <;> norm_num
  have hL :
      Tendsto
        (fun n : ℕ ↦ 1 /
          (Real.exp (24 * (lowerEdgeCount ε n : ℝ)^2 /
              (((3 * n : ℕ) : ℝ) * ((3 * n).choose 3 : ℝ))) +
            1 / (((3 * n : ℕ) : ℝ) *
              oneAvoidRatio (3 * n) (lowerEdgeCount ε n))))
        atTop (𝓝 1) := by
    simpa only [one_div, inv_one] using hU.inv₀ one_ne_zero
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hL tendsto_const_nhds
  · filter_upwards [eventually_lowerEdgeCount_pair_conditions ε hε0.le hε1,
      eventually_ge_atTop 2] with n hpair hn
    exact positive_isolated_probability_exp_lower n (lowerEdgeCount ε n)
      hn hpair.1 hpair.2
  · filter_upwards [eventually_lowerEdgeCount_pair_conditions ε hε0.le hε1]
      with n hpair
    have hMleK : lowerEdgeCount ε n ≤ (3 * n).choose 3 := by
      calc
        lowerEdgeCount ε n ≤ 2 * lowerEdgeCount ε n := by omega
        _ ≤ (3 * n - 2).choose 3 := hpair.2
        _ ≤ (3 * n).choose 3 := Nat.choose_le_choose 3 (by omega)
    have hsamplePos : 0 < (sample n (lowerEdgeCount ε n)).card := by
      rw [card_sample]
      simpa [allEdges] using Nat.choose_pos hMleK
    apply (div_le_one (by exact_mod_cast hsamplePos :
      (0 : ℝ) < (sample n (lowerEdgeCount ε n)).card)).2
    have hsub :
        positiveIsolatedSample n (lowerEdgeCount ε n) ⊆
          sample n (lowerEdgeCount ε n) := by
      intro H hH
      exact (Finset.mem_filter.mp hH).1
    exact_mod_cast Finset.card_le_card hsub

/-- Consequently the probability of having no isolated vertex tends to zero. -/
lemma lower_noIsolatedProbability_tendsto_zero (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1) :
    Tendsto (fun n : ℕ ↦ noIsolatedProbability n (lowerEdgeCount ε n))
      atTop (𝓝 0) := by
  have hpositive := positive_isolated_probability_tendsto_one ε hε0 hε1
  have hcomplement :
      Tendsto
        (fun n : ℕ ↦ 1 -
          ((positiveIsolatedSample n (lowerEdgeCount ε n)).card : ℝ) /
            (sample n (lowerEdgeCount ε n)).card) atTop (𝓝 0) := by
    convert tendsto_const_nhds.sub hpositive using 1 <;> norm_num
  refine hcomplement.congr' ?_
  filter_upwards [eventually_lowerEdgeCount_pair_conditions ε hε0.le hε1]
    with n hpair
  have hMleK : lowerEdgeCount ε n ≤ (3 * n).choose 3 := by
    calc
      lowerEdgeCount ε n ≤ 2 * lowerEdgeCount ε n := by omega
      _ ≤ (3 * n - 2).choose 3 := hpair.2
      _ ≤ (3 * n).choose 3 := Nat.choose_le_choose 3 (by omega)
  have hsamplePos : (0 : ℝ) < (sample n (lowerEdgeCount ε n)).card := by
    rw [card_sample]
    exact_mod_cast (by simpa [allEdges] using Nat.choose_pos hMleK)
  have hcardR :
      ((noIsolatedSample n (lowerEdgeCount ε n)).card : ℝ) +
          ((positiveIsolatedSample n (lowerEdgeCount ε n)).card : ℝ) =
        ((sample n (lowerEdgeCount ε n)).card : ℝ) := by
    exact_mod_cast card_noIsolated_add_card_positive n (lowerEdgeCount ε n)
  unfold noIsolatedProbability
  field_simp [hsamplePos.ne']
  linarith

/-- The elementary half of Shamir's threshold: below `(1-ε)n log(3n)`, a
perfect matching has probability tending to zero. -/
theorem lower_pmProbability_tendsto_zero (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1) :
    Tendsto (fun n : ℕ ↦ pmProbability n (lowerEdgeCount ε n))
      atTop (𝓝 0) := by
  apply squeeze_zero'
    (Eventually.of_forall fun n => by unfold pmProbability; positivity)
    (Eventually.of_forall fun n =>
      pmProbability_le_noIsolatedProbability n (lowerEdgeCount ε n))
  exact lower_noIsolatedProbability_tendsto_zero ε hε0 hε1

/-! ## Kahn's upper-tail machinery: finite matching weights and deletion -/

/-- Degree of a vertex in a finite hypergraph. -/
def vertexDegree {n : ℕ} (H : Finset (Edge n)) (v : Vertex n) : ℕ :=
  (H.filter fun A ↦ v ∈ A).card

lemma vertexDegree_insert_le_add_one {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (v : Vertex n) :
    vertexDegree (insert Z H) v ≤ vertexDegree H v + 1 := by
  unfold vertexDegree
  rw [Finset.filter_insert]
  split_ifs
  · exact Finset.card_insert_le _ _
  · omega

lemma vertexDegree_mono {n : ℕ} {H G : Finset (Edge n)}
    (hHG : H ⊆ G) (v : Vertex n) :
    vertexDegree H v ≤ vertexDegree G v := by
  unfold vertexDegree
  apply Finset.card_le_card
  intro A hA
  rcases Finset.mem_filter.mp hA with ⟨hAH, hvA⟩
  exact Finset.mem_filter.mpr ⟨hHG hAH, hvA⟩

/-- Codegree of two vertices: the number of present triples containing
both. -/
def vertexCodegree {n : ℕ} (H : Finset (Edge n))
    (u v : Vertex n) : ℕ :=
  (H.filter fun A ↦ u ∈ A ∧ v ∈ A).card

/-- All potential triples incident to a fixed vertex. -/
def incidentEdges (n : ℕ) (v : Vertex n) : Finset (Edge n) :=
  (allEdges n).filter fun A ↦ v ∈ A

/-- All potential triples containing a prescribed pair of vertices. -/
def pairIncidentEdges (n : ℕ) (u v : Vertex n) : Finset (Edge n) :=
  (allEdges n).filter fun A ↦ u ∈ A ∧ v ∈ A

lemma incidentEdges_subset (n : ℕ) (v : Vertex n) :
    incidentEdges n v ⊆ allEdges n :=
  Finset.filter_subset _ _

lemma pairIncidentEdges_subset (n : ℕ) (u v : Vertex n) :
    pairIncidentEdges n u v ⊆ allEdges n :=
  Finset.filter_subset _ _

/-- Exact number of potential triples incident to a vertex. -/
lemma card_incidentEdges (n : ℕ) (v : Vertex n) :
    (incidentEdges n v).card = (3 * n - 1).choose 2 := by
  have h := Finset.card_filter_powersetCard_subset
    ({v} : Finset (Vertex n)) (Finset.univ : Finset (Vertex n)) 3
    (by simp) (by simp)
  simpa only [incidentEdges, allEdges, Finset.singleton_subset_iff,
    Finset.card_univ, Fintype.card_fin, Finset.card_singleton,
    Nat.reduceSubDiff] using h

/-- A distinct vertex pair extends to exactly `3n-2` potential triples. -/
lemma card_pairIncidentEdges (n : ℕ) {u v : Vertex n} (huv : u ≠ v) :
    (pairIncidentEdges n u v).card = 3 * n - 2 := by
  have h := Finset.card_filter_powersetCard_subset
    ({u, v} : Finset (Vertex n)) (Finset.univ : Finset (Vertex n)) 3
    (by simp) (by simp [huv])
  have heq : pairIncidentEdges n u v =
      (allEdges n).filter (fun A ↦ ({u, v} : Finset (Vertex n)) ⊆ A) := by
    ext A
    simp only [pairIncidentEdges, Finset.mem_filter]
    constructor
    · rintro ⟨hA, huA, hvA⟩
      refine ⟨hA, ?_⟩
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact huA
      · exact hvA
    · rintro ⟨hA, hsub⟩
      exact ⟨hA, hsub (Finset.mem_insert_self u {v}),
        hsub (Finset.mem_insert_of_mem (Finset.mem_singleton_self v))⟩
  rw [heq]
  simpa [allEdges, huv] using h

/-- A uniformly chosen potential triple contains a fixed vertex with exact
probability `1/n`. -/
lemma incidentEdges_density (n : ℕ) (v : Vertex n) (hn : 0 < n) :
    ((incidentEdges n v).card : ℝ) / (allEdges n).card = 1 / (n : ℝ) := by
  let V := 3 * n
  have hV : 3 ≤ V := by dsimp [V]; omega
  have hnat : (V - 1).choose 2 * V = V.choose 3 * 3 := by
    have h := Nat.choose_mul_succ_eq (V - 1) (V - 3)
    rw [show V - 1 + 1 = V by omega] at h
    rw [← Nat.choose_symm (show V - 3 ≤ V - 1 by omega)] at h
    rw [← Nat.choose_symm (show V - 3 ≤ V by omega)] at h
    have h1 : V - 1 - (V - 3) = 2 := by omega
    have h2 : V - (V - 3) = 3 := by omega
    simpa [h1, h2] using h
  have hnat' : (V - 1).choose 2 * n = V.choose 3 := by
    apply Nat.mul_left_cancel (by norm_num : 0 < (3 : ℕ))
    dsimp [V] at hnat ⊢
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hnat
  have hchoose : (V.choose 3 : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.choose_pos hV).ne'
  have hV0 : (V : ℝ) ≠ 0 := by positivity
  have hn0 : (n : ℝ) ≠ 0 := by positivity
  rw [card_incidentEdges, card_allEdges]
  change (((V - 1).choose 2 : ℝ) / (V.choose 3 : ℝ)) = _
  apply (div_eq_iff hchoose).2
  field_simp [hn0]
  norm_num only [Nat.cast_ofNat, Nat.cast_mul]
  exact_mod_cast hnat'

/-- Exact density of triples containing a fixed distinct pair. -/
lemma pairIncidentEdges_density (n : ℕ) {u v : Vertex n}
    (huv : u ≠ v) (hn : 0 < n) :
    ((pairIncidentEdges n u v).card : ℝ) / (allEdges n).card =
      2 / ((n : ℝ) * (3 * n - 1)) := by
  let V := 3 * n
  have hV : 3 ≤ V := by dsimp [V]; omega
  have h3 := Nat.choose_succ_right_eq V 2
  have h2 := Nat.choose_succ_right_eq V 1
  have hprod : V.choose 3 * 6 = V * (V - 1) * (V - 2) := by
    calc
      V.choose 3 * 6 = (V.choose 3 * 3) * 2 := by ring
      _ = (V.choose 2 * (V - 2)) * 2 := by rw [h3]
      _ = (V.choose 2 * 2) * (V - 2) := by ring
      _ = (V.choose 1 * (V - 1)) * (V - 2) := by rw [h2]
      _ = V * (V - 1) * (V - 2) := by simp
  have hcrossNat : V.choose 3 * 2 =
      (V - 2) * (n * (V - 1)) := by
    apply Nat.mul_left_cancel (show 0 < (3 : ℕ) by norm_num)
    calc
      3 * (V.choose 3 * 2) = V.choose 3 * 6 := by ring
      _ = V * (V - 1) * (V - 2) := hprod
      _ = 3 * ((V - 2) * (n * (V - 1))) := by
        dsimp [V]
        ring
  have hchoose : (0 : ℝ) < V.choose 3 := by
    exact_mod_cast Nat.choose_pos hV
  have hVm1 : 0 < V - 1 := by omega
  have hden : (0 : ℝ) < (n : ℝ) * ((V - 1 : ℕ) : ℝ) := by
    exact mul_pos (by exact_mod_cast hn) (by exact_mod_cast hVm1)
  rw [card_pairIncidentEdges n huv, card_allEdges]
  have hcast : (3 : ℝ) * n - 1 = ((V - 1 : ℕ) : ℝ) := by
    rw [Nat.cast_sub (by dsimp [V]; omega)]
    simp [V]
  rw [hcast]
  change (((V - 2 : ℕ) : ℝ) / (V.choose 3 : ℝ)) =
    2 / ((n : ℝ) * ((V - 1 : ℕ) : ℝ))
  apply (div_eq_div_iff hchoose.ne' hden.ne').2
  exact_mod_cast (show (V - 2) * (n * (V - 1)) =
      2 * V.choose 3 by
    calc
      (V - 2) * (n * (V - 1)) = V.choose 3 * 2 := hcrossNat.symm
      _ = 2 * V.choose 3 := by ring)

/-- The pair-hit density, after multiplication by `n-1`, is at most
`1/n`. -/
lemma pairDensity_mul_pred_le_inv (n : ℕ) (hn : 0 < n) :
    (2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1) ≤
      1 / (n : ℝ) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hden : (0 : ℝ) < (n : ℝ) * (3 * n - 1) := by
    have : (0 : ℝ) < 3 * n - 1 := by
      have : (1 : ℝ) ≤ n := by exact_mod_cast hn
      nlinarith
    positivity
  rw [div_mul_eq_mul_div]
  apply (div_le_div_iff₀ hden hnR).2
  nlinarith

lemma vertexDegree_eq_sum_indicator {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) :
    vertexDegree H v = ∑ A ∈ H, if v ∈ A then 1 else 0 := by
  exact (Finset.sum_boole (R := ℕ) (fun A ↦ v ∈ A) H).symm

/-- Hypergraph handshake identity for a 3-uniform edge family. -/
lemma sum_vertexDegree {n : ℕ} (H : Finset (Edge n))
    (hH : H ⊆ allEdges n) :
    ∑ v : Vertex n, vertexDegree H v = 3 * H.card := by
  calc
    ∑ v : Vertex n, vertexDegree H v =
        ∑ v : Vertex n, ∑ A ∈ H, if v ∈ A then 1 else 0 := by
      simp_rw [vertexDegree_eq_sum_indicator]
    _ = ∑ A ∈ H, ∑ v : Vertex n, if v ∈ A then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ _A ∈ H, 3 := by
      apply Finset.sum_congr rfl
      intro A hA
      rw [Finset.sum_boole]
      have hfilter :
          (Finset.univ : Finset (Vertex n)).filter (fun v ↦ v ∈ A) = A := by
        ext v
        simp
      rw [hfilter, mem_allEdges.mp (hH hA)]
      norm_num
    _ = 3 * H.card := by simp [mul_comm]

/-- Weighted form of the 3-uniform handshake identity. -/
lemma sum_incident_real {n : ℕ} (H : Finset (Edge n))
    (hH : H ⊆ allEdges n) (f : Edge n → ℝ) :
    ∑ v : Vertex n, ∑ A ∈ H.filter (fun A ↦ v ∈ A), f A =
      3 * ∑ A ∈ H, f A := by
  calc
    ∑ v : Vertex n, ∑ A ∈ H.filter (fun A ↦ v ∈ A), f A =
        ∑ v : Vertex n, ∑ A ∈ H, if v ∈ A then f A else 0 := by
      apply Finset.sum_congr rfl
      intro v _
      rw [Finset.sum_filter]
    _ = ∑ A ∈ H, ∑ v : Vertex n, if v ∈ A then f A else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ A ∈ H, 3 * f A := by
      apply Finset.sum_congr rfl
      intro A hA
      rw [← Finset.sum_filter]
      have hfilter :
          (Finset.univ : Finset (Vertex n)).filter (fun v ↦ v ∈ A) = A := by
        ext v
        simp
      rw [hfilter, Finset.sum_const, mem_allEdges.mp (hH hA)]
      simp
    _ = 3 * ∑ A ∈ H, f A := by rw [Finset.mul_sum]

/-- The finite set of perfect matchings contained in a hypergraph. -/
def perfectMatchings (n : ℕ) (H : Finset (Edge n)) :
    Finset (Finset (Edge n)) :=
  (H.powersetCard n).filter IsMatching

@[simp] lemma mem_perfectMatchings {n : ℕ} {H F : Finset (Edge n)} :
    F ∈ perfectMatchings n H ↔ F ⊆ H ∧ F.card = n ∧ IsMatching F := by
  simp [perfectMatchings, and_assoc]

/-- A perfect matching in a 3-uniform hypergraph on `3 * n` vertices
covers every vertex. -/
lemma coveredVertices_eq_univ_of_mem_perfectMatchings {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) :
    coveredVertices F = Finset.univ := by
  apply Finset.eq_univ_of_card
  rw [card_coveredVertices_of_matching
    ((mem_perfectMatchings.mp hF).1.trans hH)
    (mem_perfectMatchings.mp hF).2.2,
    (mem_perfectMatchings.mp hF).2.1]
  simp

/-- Every vertex is contained in exactly one edge of a perfect matching. -/
lemma existsUnique_edge_mem_of_mem_perfectMatchings {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n) :
    ∃! A : Edge n, A ∈ F ∧ v ∈ A := by
  have hv : v ∈ coveredVertices F := by
    rw [coveredVertices_eq_univ_of_mem_perfectMatchings hH hF]
    simp
  rcases Finset.mem_biUnion.mp hv with ⟨A, hAF, hvA⟩
  refine ⟨A, ⟨hAF, hvA⟩, ?_⟩
  intro B hB
  by_contra hAB
  exact Finset.disjoint_left.mp
    ((mem_perfectMatchings.mp hF).2.2 hAF hB.1 (fun h ↦ hAB h.symm)) hvA hB.2

lemma hasPerfectMatching_iff_perfectMatchings_nonempty {n : ℕ}
    {H : Finset (Edge n)} :
    HasPerfectMatching n H ↔ (perfectMatchings n H).Nonempty := by
  simp only [HasPerfectMatching, Finset.nonempty_iff_ne_empty]
  constructor
  · rintro ⟨F, hFH, hcard, hmatch⟩
    intro hempty
    have : F ∈ perfectMatchings n H :=
      mem_perfectMatchings.mpr ⟨hFH, hcard, hmatch⟩
    rw [hempty] at this
    simp at this
  · intro hne
    obtain ⟨F, hF⟩ := Finset.nonempty_iff_ne_empty.mpr hne
    exact ⟨F, (mem_perfectMatchings.mp hF).1,
      (mem_perfectMatchings.mp hF).2.1,
      (mem_perfectMatchings.mp hF).2.2⟩

/-- The number of perfect matchings of `H` that use the edge `A`.  For
`A ∈ H`, this is Kahn's matching weight `w_H(A)`. -/
def matchingWeight {n : ℕ} (H : Finset (Edge n)) (A : Edge n) : ℕ :=
  ((perfectMatchings n H).filter (fun F ↦ A ∈ F)).card

/-- Kahn's weight for an arbitrary triple, including a nonedge: the number
of perfect matchings created by adjoining `Z` that use `Z`.  Equivalently,
this counts near-perfect matchings of `H` whose uncovered vertex set is `Z`. -/
def completionWeight {n : ℕ} (H : Finset (Edge n)) (Z : Edge n) : ℕ :=
  matchingWeight (insert Z H) Z

/-- Near-perfect matchings of `H` whose edges avoid `Z`; adjoining `Z`
turns precisely these families into perfect matchings through `Z`. -/
def completionMatchings (n : ℕ) (H : Finset (Edge n)) (Z : Edge n) :
    Finset (Finset (Edge n)) :=
  (H.powersetCard (n - 1)).filter fun F ↦
    IsMatching F ∧ ∀ A ∈ F, Disjoint A Z

@[simp] lemma mem_completionMatchings {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {F : Finset (Edge n)} :
    F ∈ completionMatchings n H Z ↔
      F ⊆ H ∧ F.card = n - 1 ∧ IsMatching F ∧
        ∀ A ∈ F, Disjoint A Z := by
  simp [completionMatchings, and_assoc]

private lemma isMatching_insert_of_avoids {n : ℕ}
    {F : Finset (Edge n)} {Z : Edge n}
    (hF : IsMatching F) (havoid : ∀ A ∈ F, Disjoint A Z) :
    IsMatching (insert Z F) := by
  intro A hA B hB hAB
  rcases Finset.mem_insert.mp hA with rfl | hAF
  · rcases Finset.mem_insert.mp hB with rfl | hBF
    · exact False.elim (hAB rfl)
    · exact (havoid B hBF).symm
  · rcases Finset.mem_insert.mp hB with rfl | hBF
    · exact havoid A hAF
    · exact hF hAF hBF hAB

/-- The arbitrary-triple completion weight really is the cardinality of the
near-perfect matching family avoiding that triple. -/
lemma completionWeight_eq_card_completionMatchings {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (hn : 0 < n)
    (hZ : Z ∈ allEdges n) :
    completionWeight H Z = (completionMatchings n H Z).card := by
  symm
  unfold completionWeight matchingWeight
  refine Finset.card_bij
    (s := completionMatchings n H Z)
    (t := (perfectMatchings n (insert Z H)).filter (fun F ↦ Z ∈ F))
    (fun F _ ↦ insert Z F) ?_ ?_ ?_
  · intro F hF
    rcases mem_completionMatchings.mp hF with
      ⟨hFH, hcard, hmatch, havoid⟩
    have hZnonempty : Z.Nonempty := Finset.card_pos.mp (by
      rw [mem_allEdges.mp hZ]
      norm_num)
    have hZnot : Z ∉ F := by
      intro hZF
      obtain ⟨v, hv⟩ := hZnonempty
      exact Finset.disjoint_left.mp (havoid Z hZF) hv hv
    apply Finset.mem_filter.mpr
    refine ⟨mem_perfectMatchings.mpr ⟨?_, ?_,
      isMatching_insert_of_avoids hmatch havoid⟩,
      Finset.mem_insert_self Z F⟩
    · exact Finset.insert_subset (Finset.mem_insert_self Z H)
        (hFH.trans (Finset.subset_insert Z H))
    · rw [Finset.card_insert_of_notMem hZnot, hcard]
      omega
  · intro F hF G hG hFG
    have hFnear := mem_completionMatchings.mp hF
    have hGnear := mem_completionMatchings.mp hG
    have hZnonempty : Z.Nonempty := Finset.card_pos.mp (by
      rw [mem_allEdges.mp hZ]
      norm_num)
    have hZnotF : Z ∉ F := by
      intro hZF
      obtain ⟨v, hv⟩ := hZnonempty
      exact Finset.disjoint_left.mp (hFnear.2.2.2 Z hZF) hv hv
    have hZnotG : Z ∉ G := by
      intro hZG
      obtain ⟨v, hv⟩ := hZnonempty
      exact Finset.disjoint_left.mp (hGnear.2.2.2 Z hZG) hv hv
    simpa only [Finset.erase_insert hZnotF, Finset.erase_insert hZnotG]
      using congrArg (fun S : Finset (Edge n) ↦ S.erase Z) hFG
  · intro G hG
    rcases Finset.mem_filter.mp hG with ⟨hGpm, hZG⟩
    have hGdata := mem_perfectMatchings.mp hGpm
    refine ⟨G.erase Z, ?_, Finset.insert_erase hZG⟩
    apply mem_completionMatchings.mpr
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro A hA
      rcases Finset.mem_erase.mp hA with ⟨hAZ, hAG⟩
      rcases Finset.mem_insert.mp (hGdata.1 hAG) with h | h
      · exact False.elim (hAZ h)
      · exact h
    · rw [Finset.card_erase_of_mem hZG, hGdata.2.1]
    · intro A hA B hB hAB
      exact hGdata.2.2 (Finset.mem_erase.mp hA).2
        (Finset.mem_erase.mp hB).2 hAB
    · intro A hA
      have hAZ : A ≠ Z := (Finset.mem_erase.mp hA).1
      exact hGdata.2.2 (Finset.mem_erase.mp hA).2 hZG hAZ

/-- Number of completion matchings through `Z` that also use the edge `A`.
This is the deletion influence for the arbitrary-triple weight. -/
def completionEdgeWeight {n : ℕ} (H : Finset (Edge n))
    (Z A : Edge n) : ℕ :=
  ((completionMatchings n H Z).filter fun F ↦ A ∈ F).card

/-- Completion matchings surviving deletion of `A` are precisely those that
did not use `A`. -/
lemma completionMatchings_erase (n : ℕ) (H : Finset (Edge n))
    (Z A : Edge n) :
    completionMatchings n (H.erase A) Z =
      (completionMatchings n H Z).filter (fun F ↦ A ∉ F) := by
  ext F
  simp only [mem_completionMatchings, Finset.mem_filter]
  constructor
  · rintro ⟨hFsub, hcard, hmatch, havoid⟩
    refine ⟨⟨hFsub.trans (Finset.erase_subset A H), hcard, hmatch,
      havoid⟩, ?_⟩
    intro hAF
    exact (Finset.mem_erase.mp (hFsub hAF)).1 rfl
  · rintro ⟨⟨hFsub, hcard, hmatch, havoid⟩, hAF⟩
    refine ⟨?_, hcard, hmatch, havoid⟩
    intro B hBF
    exact Finset.mem_erase.mpr ⟨by
      intro hBA
      subst B
      exact hAF hBF, hFsub hBF⟩

/-- Exact one-step deletion count for arbitrary-triple completion
matchings. -/
lemma card_completionMatchings_erase_add_edgeWeight (n : ℕ)
    (H : Finset (Edge n)) (Z A : Edge n) :
    (completionMatchings n (H.erase A) Z).card +
        completionEdgeWeight H Z A =
      (completionMatchings n H Z).card := by
  rw [completionMatchings_erase, completionEdgeWeight]
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := completionMatchings n H Z) (p := fun F ↦ A ∉ F)
  simpa only [not_not] using hsplit

/-- Fraction of completion matchings through `Z` destroyed by deleting
`A`. -/
def completionDeletionFraction {n : ℕ} (H : Finset (Edge n))
    (Z A : Edge n) : ℝ :=
  completionEdgeWeight H Z A / (completionMatchings n H Z).card

lemma completionDeletionFraction_nonneg {n : ℕ}
    (H : Finset (Edge n)) (Z A : Edge n) :
    0 ≤ completionDeletionFraction H Z A := by
  unfold completionDeletionFraction
  positivity

lemma completionDeletionFraction_le_one {n : ℕ}
    (H : Finset (Edge n)) (Z A : Edge n) :
    completionDeletionFraction H Z A ≤ 1 := by
  unfold completionDeletionFraction completionEdgeWeight
  by_cases hC : (completionMatchings n H Z).card = 0
  · simp [hC]
  · apply (div_le_one (by exact_mod_cast Nat.pos_of_ne_zero hC)).2
    exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)

/-- Sum of deletion influences: every completion matching contains exactly
`n-1` edges. -/
lemma sum_completionEdgeWeight (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) :
    ∑ A ∈ H, (completionEdgeWeight H Z A : ℝ) =
      ((completionMatchings n H Z).card : ℝ) * ((n - 1 : ℕ) : ℝ) := by
  unfold completionEdgeWeight
  calc
    ∑ A ∈ H,
        (((completionMatchings n H Z).filter fun F ↦ A ∈ F).card : ℝ) =
        ∑ A ∈ H, ∑ F ∈ completionMatchings n H Z,
          if A ∈ F then (1 : ℝ) else 0 := by
      apply Finset.sum_congr rfl
      intro A _
      rw [Finset.sum_boole (R := ℝ)]
    _ = ∑ F ∈ completionMatchings n H Z,
          ∑ A ∈ H, if A ∈ F then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ _F ∈ completionMatchings n H Z,
          ((n - 1 : ℕ) : ℝ) := by
      apply Finset.sum_congr rfl
      intro F hF
      rw [Finset.sum_boole (R := ℝ)]
      have hsub := (mem_completionMatchings.mp hF).1
      have hfilter : H.filter (fun A ↦ A ∈ F) = F := by
        ext A
        simp only [Finset.mem_filter]
        exact and_iff_right_of_imp (fun h ↦ hsub h)
      rw [hfilter, (mem_completionMatchings.mp hF).2.1]
    _ = ((completionMatchings n H Z).card : ℝ) *
          ((n - 1 : ℕ) : ℝ) := by simp

/-- Consequently the mean completion-deletion fraction is `(n-1)/|H|`. -/
lemma sum_completionDeletionFraction (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) (hC : (completionMatchings n H Z).card ≠ 0) :
    ∑ A ∈ H, completionDeletionFraction H Z A =
      ((n - 1 : ℕ) : ℝ) := by
  unfold completionDeletionFraction
  rw [← Finset.sum_div]
  have hsumR :
      ∑ A ∈ H, (completionEdgeWeight H Z A : ℝ) =
        ((completionMatchings n H Z).card : ℝ) *
          ((n - 1 : ℕ) : ℝ) := by
    exact sum_completionEdgeWeight n H Z
  rw [hsumR]
  have hCR : ((completionMatchings n H Z).card : ℝ) ≠ 0 := by
    exact_mod_cast hC
  field_simp [hCR]

/-- One-step multiplicative evolution of an arbitrary-triple completion
weight under edge deletion. -/
lemma card_completionMatchings_erase_mul (n : ℕ)
    (H : Finset (Edge n)) (Z A : Edge n) :
    ((completionMatchings n (H.erase A) Z).card : ℝ) =
      ((completionMatchings n H Z).card : ℝ) *
        (1 - completionDeletionFraction H Z A) := by
  by_cases hC : (completionMatchings n H Z).card = 0
  · have hcount := card_completionMatchings_erase_add_edgeWeight n H Z A
    have herase : (completionMatchings n (H.erase A) Z).card = 0 := by
      omega
    simp [completionDeletionFraction, hC, herase]
  · have hcount := card_completionMatchings_erase_add_edgeWeight n H Z A
    have hcountR :
        ((completionMatchings n (H.erase A) Z).card : ℝ) +
            completionEdgeWeight H Z A =
          (completionMatchings n H Z).card := by
      exact_mod_cast hcount
    have hCR : ((completionMatchings n H Z).card : ℝ) ≠ 0 := by
      exact_mod_cast hC
    unfold completionDeletionFraction
    field_simp [hCR]
    linarith

lemma completionWeight_eq_matchingWeight_of_mem {n : ℕ}
    (H : Finset (Edge n)) {Z : Edge n} (hZ : Z ∈ H) :
    completionWeight H Z = matchingWeight H Z := by
  simp [completionWeight, hZ]

/-- The real-valued target weight `Φ(H) / D_H`, where the average vertex
degree is `D_H = |H| / n`. -/
def matchingWeightTarget (n : ℕ) (H : Finset (Edge n)) : ℝ :=
  ((perfectMatchings n H).card : ℝ) * n / H.card

/-- A quantitative finite version of Kahn's phrase “weight is within a
relative `δ` of `Φ(H)/D_H`”. -/
def CompletionWeightClose {n : ℕ} (H : Finset (Edge n))
    (δ : ℝ) (Z : Edge n) : Prop :=
  |(completionWeight H Z : ℝ) - matchingWeightTarget n H| ≤
    δ * matchingWeightTarget n H

lemma matchingWeight_eq_sum_indicator {n : ℕ} (H : Finset (Edge n))
    (A : Edge n) :
    matchingWeight H A =
      ∑ F ∈ perfectMatchings n H, if A ∈ F then 1 else 0 := by
  exact (Finset.sum_boole (R := ℕ) (fun F ↦ A ∈ F)
    (perfectMatchings n H)).symm

/-- The matching weights incident to a fixed vertex sum to the total number
of perfect matchings.  This is the local double count used by the entropy
argument. -/
lemma sum_incident_matchingWeight (n : ℕ) (H : Finset (Edge n))
    (hH : H ⊆ allEdges n) (v : Vertex n) :
    ∑ A ∈ H.filter (fun A ↦ v ∈ A), matchingWeight H A =
      (perfectMatchings n H).card := by
  calc
    ∑ A ∈ H.filter (fun A ↦ v ∈ A), matchingWeight H A =
        ∑ A ∈ H.filter (fun A ↦ v ∈ A),
          ∑ F ∈ perfectMatchings n H, if A ∈ F then 1 else 0 := by
      simp_rw [matchingWeight_eq_sum_indicator]
    _ = ∑ F ∈ perfectMatchings n H,
          ∑ A ∈ H.filter (fun A ↦ v ∈ A), if A ∈ F then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ _F ∈ perfectMatchings n H, 1 := by
      apply Finset.sum_congr rfl
      intro F hF
      obtain ⟨A, hA, hAunique⟩ :=
        existsUnique_edge_mem_of_mem_perfectMatchings hH hF v
      rw [Finset.sum_boole (R := ℕ)]
      have hfilter :
          (H.filter (fun A ↦ v ∈ A)).filter (fun B ↦ B ∈ F) = {A} := by
        ext B
        simp only [Finset.mem_filter, Finset.mem_singleton]
        constructor
        · intro hB
          exact hAunique B ⟨hB.2, hB.1.2⟩
        · rintro rfl
          exact ⟨⟨(mem_perfectMatchings.mp hF).1 hA.1, hA.2⟩, hA.1⟩
      rw [hfilter]
      simp
    _ = (perfectMatchings n H).card := by simp

/-- The exact matching-weight average identity
`∑_{A∈H} w_H(A) = n Φ(H)`. -/
lemma sum_matchingWeight (n : ℕ) (H : Finset (Edge n)) :
    ∑ A ∈ H, matchingWeight H A =
      (perfectMatchings n H).card * n := by
  calc
    ∑ A ∈ H, matchingWeight H A =
        ∑ A ∈ H, ∑ F ∈ perfectMatchings n H,
          if A ∈ F then 1 else 0 := by
      simp_rw [matchingWeight_eq_sum_indicator]
    _ = ∑ F ∈ perfectMatchings n H, ∑ A ∈ H,
          if A ∈ F then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ _F ∈ perfectMatchings n H, n := by
      apply Finset.sum_congr rfl
      intro F hF
      rw [Finset.sum_boole (R := ℕ)]
      have hsub := (mem_perfectMatchings.mp hF).1
      have hfilter : H.filter (fun A ↦ A ∈ F) = F := by
        ext A
        simp only [Finset.mem_filter]
        constructor
        · exact fun h ↦ h.2
        · exact fun h ↦ ⟨hsub h, h⟩
      rw [hfilter, (mem_perfectMatchings.mp hF).2.1]
      norm_num
    _ = (perfectMatchings n H).card * n := by simp

/-- The average present-edge weight is exactly `Φ(H)/D_H`. -/
lemma average_matchingWeight_eq_target (n : ℕ) (H : Finset (Edge n)) :
    (∑ A ∈ H, (matchingWeight H A : ℝ)) / H.card =
      matchingWeightTarget n H := by
  have hsumR :
      ∑ A ∈ H, (matchingWeight H A : ℝ) =
        ((perfectMatchings n H).card : ℝ) * n := by
    exact_mod_cast sum_matchingWeight n H
  rw [hsumR]
  rfl

/-- Quantitative present-edge spreading (`𝔈` in Kahn's proof): at most an
`η` fraction of the edges have relative weight error exceeding `δ`. -/
def PresentWeightSpread {n : ℕ} (H : Finset (Edge n))
    (δ η : ℝ) : Prop :=
  (((H.filter fun A ↦ ¬CompletionWeightClose H δ A).card : ℕ) : ℝ) ≤
    η * H.card

/-- Quantitative global spreading (`𝔉`): the same assertion over every
potential triple, not only over the edges already present. -/
def GlobalWeightSpread (n : ℕ) (H : Finset (Edge n))
    (δ η : ℝ) : Prop :=
  ((((allEdges n).filter fun Z ↦
      ¬CompletionWeightClose H δ Z).card : ℕ) : ℝ) ≤
    η * (allEdges n).card

/-- One-sided weight control for an arbitrary triple.  The upper-bound
argument only needs this half of `CompletionWeightClose`. -/
def CompletionWeightUpperBound {n : ℕ} (H : Finset (Edge n))
    (L : ℝ) (Z : Edge n) : Prop :=
  (completionWeight H Z : ℝ) ≤ L * matchingWeightTarget n H

/-- All but an `eta` fraction of arbitrary triples satisfy a common
one-sided completion-weight bound. -/
def GlobalUpperWeightSpread (n : ℕ) (H : Finset (Edge n))
    (L eta : ℝ) : Prop :=
  ((((allEdges n).filter fun Z ↦
      ¬CompletionWeightUpperBound H L Z).card : ℕ) : ℝ) ≤
    eta * (allEdges n).card

/-- Quantitative form of Kahn's property `𝔇`: every triple's completion
weight is inherited, up to factor `c`, by at least a `q` fraction of all
triples. -/
def GloballyDominatedWeights (n : ℕ) (H : Finset (Edge n))
    (q c : ℝ) : Prop :=
  ∀ Z ∈ allEdges n,
    q * (allEdges n).card ≤
      (((allEdges n).filter fun U ↦
        c * (completionWeight H Z : ℝ) ≤ completionWeight H U).card : ℝ)

/-- The weaker domination statement actually needed for the deletion
martingale: one maximum-weight triple has a positive-density family of
constant-factor descendants.  Kahn's coordinate-transfer argument is only
applied to such a maximum. -/
def MaximumWeightDominated (n : ℕ) (H : Finset (Edge n))
    (q c : ℝ) : Prop :=
  ∃ Z₀ ∈ allEdges n,
    (∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀) ∧
    q * (allEdges n).card ≤
      (((allEdges n).filter fun U ↦
        c * (completionWeight H Z₀ : ℝ) ≤
          completionWeight H U).card : ℝ)

/-- A maximum completion-weight triple exists whenever `n` is positive. -/
lemma exists_max_completionWeight {n : ℕ} (H : Finset (Edge n))
    (hn : 0 < n) :
    ∃ Z₀ ∈ allEdges n, ∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀ := by
  have hK : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i, mem_allEdges.mpr (canonicalEdge_card n i)⟩
  exact Finset.exists_max_image (allEdges n) (completionWeight H) hK

/-! Three fixed color blocks used to count coordinate-replacement
descendants injectively.  The block index records which coordinate supplied
the replacement, so the final unordered triple remembers all three choices. -/

def colorVertex (n : ℕ) (j : Fin 3) (i : Fin n) : Vertex n :=
  ⟨j * n + i, by
    calc
      j * n + i < j * n + n := Nat.add_lt_add_left i.isLt _
      _ = (j + 1) * n := by simp [Nat.add_mul]
      _ ≤ 3 * n := Nat.mul_le_mul_right n (by omega)⟩

def colorBlock (n : ℕ) (j : Fin 3) : Finset (Vertex n) :=
  Finset.univ.image (colorVertex n j)

lemma colorVertex_injective (n : ℕ) (j : Fin 3) :
    Function.Injective (colorVertex n j) := by
  intro i k hik
  apply Fin.ext
  have hval := congrArg Fin.val hik
  exact Nat.add_left_cancel hval

@[simp] lemma card_colorBlock (n : ℕ) (j : Fin 3) :
    (colorBlock n j).card = n := by
  rw [colorBlock, Finset.card_image_of_injective _
    (colorVertex_injective n j)]
  simp

@[simp] lemma colorVertex_mem_colorBlock (n : ℕ) (j : Fin 3)
    (i : Fin n) : colorVertex n j i ∈ colorBlock n j := by
  simp [colorBlock]

lemma colorVertex_val_div (n : ℕ) (hn : 0 < n) (j : Fin 3)
    (i : Fin n) : (colorVertex n j i).val / n = j.val := by
  change (j.val * n + i.val) / n = j.val
  rw [Nat.mul_comm j.val n]
  simpa [Nat.div_eq_of_lt i.isLt] using
    (Nat.mul_add_div hn j.val i.val)

lemma colorBlock_disjoint {n : ℕ} (hn : 0 < n) {j k : Fin 3}
    (hjk : j ≠ k) : Disjoint (colorBlock n j) (colorBlock n k) := by
  rw [Finset.disjoint_left]
  intro v hvj hvk
  rcases Finset.mem_image.mp hvj with ⟨i, _, rfl⟩
  rcases Finset.mem_image.mp hvk with ⟨u, _, hu⟩
  apply hjk
  apply Fin.ext
  have hdiv := congrArg (fun v : Vertex n ↦ v.val / n) hu
  simpa [colorVertex_val_div n hn] using hdiv.symm

/-- Replace one coordinate of a triple. -/
def replaceVertex {n : ℕ} (Z : Edge n) (x y : Vertex n) : Edge n :=
  insert y (Z.erase x)

lemma replaceVertex_mem_allEdges {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {x y : Vertex n}
    (hx : x ∈ Z) (hy : y ∉ Z) :
    replaceVertex Z x y ∈ allEdges n := by
  apply mem_allEdges.mpr
  unfold replaceVertex
  rw [Finset.card_insert_of_notMem (fun hyErase ↦
      hy (Finset.mem_of_mem_erase hyErase)),
    Finset.card_erase_of_mem hx, mem_allEdges.mp hZ]

/-- Vertices whose one-coordinate replacement fails to inherit a factor
`c` of the current completion weight. -/
def coordinateBadVertices {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (x : Vertex n) (c : ℝ) : Finset (Vertex n) :=
  (Finset.univ.filter fun y ↦ y ∉ Z ∧
    ¬c * (completionWeight H Z : ℝ) ≤
      completionWeight H (replaceVertex Z x y))

/-- Quantitative one-coordinate transfer above the weight floor `s`. -/
def CoordinateTransferAbove (n : ℕ) (H : Finset (Edge n))
    (s c : ℝ) (b : ℕ) : Prop :=
  ∀ Z ∈ allEdges n,
    s ≤ (completionWeight H Z : ℝ) →
      ∀ x ∈ Z, (coordinateBadVertices H Z x c).card ≤ b

/-- Good replacements selected from one fixed color block.  Removing both
the original maximum triple and the current triple makes the definition
safe at every stage of the three-coordinate iteration. -/
def coordinateGoodInBlock {n : ℕ} (H : Finset (Edge n))
    (Z₀ Z : Edge n) (x : Vertex n) (j : Fin 3) (c : ℝ) :
    Finset (Vertex n) :=
  ((colorBlock n j) \ (Z₀ ∪ Z)).filter fun y ↦
    c * (completionWeight H Z : ℝ) ≤
      completionWeight H (replaceVertex Z x y)

/-- If at most `b` vertices are bad, every color block supplies at least
`n/2` safe replacements (the constant loss accounts for the two triples). -/
lemma half_le_card_coordinateGoodInBlock {n b : ℕ}
    {H : Finset (Edge n)} {Z₀ Z : Edge n} {x : Vertex n}
    {j : Fin 3} {c : ℝ}
    (hZ₀ : Z₀ ∈ allEdges n) (hZ : Z ∈ allEdges n)
    (hbad : (coordinateBadVertices H Z x c).card ≤ b)
    (hbudget : 2 * b + 12 ≤ n) :
    n / 2 ≤ (coordinateGoodInBlock H Z₀ Z x j c).card := by
  let base := colorBlock n j \ (Z₀ ∪ Z)
  let good : Vertex n → Prop := fun y ↦
    c * (completionWeight H Z : ℝ) ≤
      completionWeight H (replaceVertex Z x y)
  have hunion : (Z₀ ∪ Z).card ≤ 6 := by
    calc
      (Z₀ ∪ Z).card ≤ Z₀.card + Z.card := Finset.card_union_le _ _
      _ = 6 := by rw [mem_allEdges.mp hZ₀, mem_allEdges.mp hZ]
  have hinter : ((Z₀ ∪ Z) ∩ colorBlock n j).card ≤ 6 :=
    (Finset.card_le_card (Finset.inter_subset_left)).trans hunion
  have hbase : n - 6 ≤ base.card := by
    dsimp [base]
    rw [Finset.card_sdiff, card_colorBlock]
    omega
  have hbadSub : base.filter (fun y ↦ ¬good y) ⊆
      coordinateBadVertices H Z x c := by
    intro y hy
    rcases Finset.mem_filter.mp hy with ⟨hybase, hyfail⟩
    have hyZ : y ∉ Z := by
      intro hyin
      exact (Finset.mem_sdiff.mp hybase).2
        (Finset.mem_union_right Z₀ hyin)
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ y, hyZ, hyfail⟩
  have hbadBase : (base.filter fun y ↦ ¬good y).card ≤ b :=
    (Finset.card_le_card hbadSub).trans hbad
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := base) (p := good)
  have hgood : n / 2 ≤ (base.filter good).card := by omega
  simpa [coordinateGoodInBlock, base, good] using hgood

/-- The three nested color-block choices used to replace all coordinates of
`Z₀` in a fixed order. -/
def coordinateDescendantSequences {n : ℕ} (H : Finset (Edge n))
    (Z₀ : Edge n) (x₀ x₁ x₂ : Vertex n) (c : ℝ) :
    Finset (Sigma fun _y₀ : Vertex n ↦
      Sigma fun _y₁ : Vertex n ↦ Vertex n) :=
  (coordinateGoodInBlock H Z₀ Z₀ x₀ (0 : Fin 3) c).sigma fun y₀ ↦
    let Z₁ := replaceVertex Z₀ x₀ y₀
    (coordinateGoodInBlock H Z₀ Z₁ x₁ (1 : Fin 3) c).sigma fun y₁ ↦
      let Z₂ := replaceVertex Z₁ x₁ y₁
      coordinateGoodInBlock H Z₀ Z₂ x₂ (2 : Fin 3) c

/-- Forget the order of a color-recorded replacement sequence. -/
def coordinateSequenceTriple {n : ℕ}
    (s : Sigma fun _y₀ : Vertex n ↦
      Sigma fun _y₁ : Vertex n ↦ Vertex n) : Edge n :=
  {s.1, s.2.1, s.2.2}

lemma mem_coordinateGoodInBlock_colorBlock {n : ℕ}
    {H : Finset (Edge n)} {Z₀ Z : Edge n} {x y : Vertex n}
    {j : Fin 3} {c : ℝ}
    (hy : y ∈ coordinateGoodInBlock H Z₀ Z x j c) :
    y ∈ colorBlock n j := by
  exact (Finset.mem_sdiff.mp (Finset.mem_filter.mp hy).1).1

lemma mem_coordinateGoodInBlock_not_current {n : ℕ}
    {H : Finset (Edge n)} {Z₀ Z : Edge n} {x y : Vertex n}
    {j : Fin 3} {c : ℝ}
    (hy : y ∈ coordinateGoodInBlock H Z₀ Z x j c) :
    y ∉ Z := by
  intro hyZ
  exact (Finset.mem_sdiff.mp (Finset.mem_filter.mp hy).1).2
    (Finset.mem_union_right Z₀ hyZ)

lemma mem_coordinateGoodInBlock_not_original {n : ℕ}
    {H : Finset (Edge n)} {Z₀ Z : Edge n} {x y : Vertex n}
    {j : Fin 3} {c : ℝ}
    (hy : y ∈ coordinateGoodInBlock H Z₀ Z x j c) :
    y ∉ Z₀ := by
  intro hyZ₀
  exact (Finset.mem_sdiff.mp (Finset.mem_filter.mp hy).1).2
    (Finset.mem_union_left Z hyZ₀)

lemma coordinateGoodInBlock_weight {n : ℕ}
    {H : Finset (Edge n)} {Z₀ Z : Edge n} {x y : Vertex n}
    {j : Fin 3} {c : ℝ}
    (hy : y ∈ coordinateGoodInBlock H Z₀ Z x j c) :
    c * (completionWeight H Z : ℝ) ≤
      completionWeight H (replaceVertex Z x y) :=
  (Finset.mem_filter.mp hy).2

lemma ne_of_mem_colorBlocks {n : ℕ} (hn : 0 < n)
    {j k : Fin 3} (hjk : j ≠ k) {x y : Vertex n}
    (hx : x ∈ colorBlock n j) (hy : y ∈ colorBlock n k) : x ≠ y := by
  intro hxy
  subst y
  exact Finset.disjoint_left.mp (colorBlock_disjoint hn hjk) hx hy

/-- The finite set of endpoint triples carrying the inherited three-step
weight lower bound. -/
def coordinateHeavyDescendants {n : ℕ} (H : Finset (Edge n))
    (Z₀ : Edge n) (c : ℝ) : Finset (Edge n) :=
  (allEdges n).filter fun U ↦
    c^3 * (completionWeight H Z₀ : ℝ) ≤ completionWeight H U

/-- Three successive coordinate-transfer steps have at least `(n/2)^3`
color-recorded realizations. -/
lemma cube_half_le_card_coordinateDescendantSequences {n b : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    {x₀ x₁ x₂ : Vertex n} {c : ℝ}
    (hZ₀ : Z₀ ∈ allEdges n)
    (hZeq : Z₀ = {x₀, x₁, x₂})
    (hx₀₁ : x₀ ≠ x₁) (hx₀₂ : x₀ ≠ x₂) (hx₁₂ : x₁ ≠ x₂)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (htransfer : CoordinateTransferAbove n H
      (c^2 * (completionWeight H Z₀ : ℝ)) c b)
    (hbudget : 2 * b + 12 ≤ n) :
    (n / 2)^3 ≤
      (coordinateDescendantSequences H Z₀ x₀ x₁ x₂ c).card := by
  let h := n / 2
  let S₀ := coordinateGoodInBlock H Z₀ Z₀ x₀ (0 : Fin 3) c
  have hw0 : 0 ≤ (completionWeight H Z₀ : ℝ) := by positivity
  have hc2 : c^2 ≤ 1 := by
    have hprod : 0 ≤ (1 - c) * (1 + c) :=
      mul_nonneg (sub_nonneg.mpr hc1) (by linarith)
    nlinarith
  have hfloor0 : c^2 * (completionWeight H Z₀ : ℝ) ≤
      completionWeight H Z₀ := by
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hc2 hw0
  have hbad0 := htransfer Z₀ hZ₀ hfloor0 x₀ (by simp [hZeq])
  have hS₀ : h ≤ S₀.card := by
    exact half_le_card_coordinateGoodInBlock hZ₀ hZ₀ hbad0 hbudget
  have hfiber : ∀ y₀ ∈ S₀,
      h^2 ≤
        ((coordinateGoodInBlock H Z₀
            (replaceVertex Z₀ x₀ y₀) x₁ (1 : Fin 3) c).sigma
          fun y₁ ↦ coordinateGoodInBlock H Z₀
            (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁)
              x₂ (2 : Fin 3) c).card := by
    intro y₀ hy₀
    have hy₀' : y₀ ∈ coordinateGoodInBlock H Z₀ Z₀ x₀
        (0 : Fin 3) c := hy₀
    have hy₀not := mem_coordinateGoodInBlock_not_current hy₀'
    have hZ₁ := replaceVertex_mem_allEdges (x := x₀) (y := y₀)
      hZ₀ (by simp [hZeq]) hy₀not
    have hx₁Z₁ : x₁ ∈ replaceVertex Z₀ x₀ y₀ := by
      unfold replaceVertex
      apply Finset.mem_insert.mpr
      right
      exact Finset.mem_erase.mpr ⟨hx₀₁.symm, by simp [hZeq]⟩
    have hw1 := coordinateGoodInBlock_weight hy₀'
    have hcsqlec : c^2 ≤ c := by
      have hprod : 0 ≤ c * (1 - c) :=
        mul_nonneg hc0 (sub_nonneg.mpr hc1)
      nlinarith
    have hfloor1 : c^2 * (completionWeight H Z₀ : ℝ) ≤
        completionWeight H (replaceVertex Z₀ x₀ y₀) :=
      (mul_le_mul_of_nonneg_right hcsqlec hw0).trans hw1
    have hbad1 := htransfer (replaceVertex Z₀ x₀ y₀) hZ₁ hfloor1
      x₁ hx₁Z₁
    let S₁ := coordinateGoodInBlock H Z₀
      (replaceVertex Z₀ x₀ y₀) x₁ (1 : Fin 3) c
    have hS₁ : h ≤ S₁.card := by
      exact half_le_card_coordinateGoodInBlock hZ₀ hZ₁ hbad1 hbudget
    rw [Finset.card_sigma]
    calc
      h^2 = h * h := by ring
      _ ≤ S₁.card * h := Nat.mul_le_mul_right h hS₁
      _ = ∑ _y₁ ∈ S₁, h := by simp
      _ ≤ ∑ y₁ ∈ S₁,
          (coordinateGoodInBlock H Z₀
            (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁)
              x₂ (2 : Fin 3) c).card := by
        apply Finset.sum_le_sum
        intro y₁ hy₁
        have hy₁' : y₁ ∈ coordinateGoodInBlock H Z₀
            (replaceVertex Z₀ x₀ y₀) x₁ (1 : Fin 3) c := hy₁
        have hy₁not := mem_coordinateGoodInBlock_not_current hy₁'
        have hZ₂ := replaceVertex_mem_allEdges (x := x₁) (y := y₁)
          hZ₁ hx₁Z₁ hy₁not
        have hx₂Z₁ : x₂ ∈ replaceVertex Z₀ x₀ y₀ := by
          unfold replaceVertex
          apply Finset.mem_insert.mpr
          right
          exact Finset.mem_erase.mpr ⟨hx₀₂.symm, by simp [hZeq]⟩
        have hx₂Z₂ : x₂ ∈
            replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁ := by
          unfold replaceVertex
          apply Finset.mem_insert.mpr
          right
          exact Finset.mem_erase.mpr ⟨hx₁₂.symm, hx₂Z₁⟩
        have hw2step := coordinateGoodInBlock_weight hy₁'
        have hmul := mul_le_mul_of_nonneg_left hw1 hc0
        have hfloor2 : c^2 * (completionWeight H Z₀ : ℝ) ≤
            completionWeight H
              (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁) := by
          calc
            c^2 * (completionWeight H Z₀ : ℝ) =
                c * (c * (completionWeight H Z₀ : ℝ)) := by ring
            _ ≤ c * (completionWeight H (replaceVertex Z₀ x₀ y₀) : ℝ) := hmul
            _ ≤ completionWeight H
                (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁) := hw2step
        have hbad2 := htransfer
          (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁)
          hZ₂ hfloor2 x₂ hx₂Z₂
        exact half_le_card_coordinateGoodInBlock hZ₀ hZ₂ hbad2 hbudget
  rw [coordinateDescendantSequences, Finset.card_sigma]
  change h^3 ≤ ∑ y₀ ∈ S₀,
    ((coordinateGoodInBlock H Z₀
        (replaceVertex Z₀ x₀ y₀) x₁ (1 : Fin 3) c).sigma
      fun y₁ ↦ coordinateGoodInBlock H Z₀
        (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁)
          x₂ (2 : Fin 3) c).card
  calc
    h^3 = h * h^2 := by ring
    _ ≤ S₀.card * h^2 := Nat.mul_le_mul_right (h^2) hS₀
    _ = ∑ _y₀ ∈ S₀, h^2 := by simp
    _ ≤ ∑ y₀ ∈ S₀,
        ((coordinateGoodInBlock H Z₀
            (replaceVertex Z₀ x₀ y₀) x₁ (1 : Fin 3) c).sigma
          fun y₁ ↦ coordinateGoodInBlock H Z₀
            (replaceVertex (replaceVertex Z₀ x₀ y₀) x₁ y₁)
              x₂ (2 : Fin 3) c).card :=
      Finset.sum_le_sum hfiber

/-- A recorded three-coordinate replacement lands in the heavy-descendant
set. -/
lemma coordinateSequenceTriple_mapsTo_heavyDescendants {n : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    {x₀ x₁ x₂ : Vertex n} {c : ℝ}
    (hn : 0 < n) (hZ₀ : Z₀ ∈ allEdges n)
    (hZeq : Z₀ = {x₀, x₁, x₂})
    (hx₀₁ : x₀ ≠ x₁) (hx₀₂ : x₀ ≠ x₂) (hx₁₂ : x₁ ≠ x₂)
    (hc0 : 0 ≤ c) :
    Set.MapsTo coordinateSequenceTriple
      (↑(coordinateDescendantSequences H Z₀ x₀ x₁ x₂ c) :
        Set (Sigma fun _y₀ : Vertex n ↦
          Sigma fun _y₁ : Vertex n ↦ Vertex n))
      (↑(coordinateHeavyDescendants H Z₀ c) : Set (Edge n)) := by
  rintro ⟨y₀, ⟨y₁, y₂⟩⟩ hs
  change (⟨y₀, ⟨y₁, y₂⟩⟩ :
      Sigma fun _y₀ : Vertex n ↦
        Sigma fun _y₁ : Vertex n ↦ Vertex n) ∈
    coordinateDescendantSequences H Z₀ x₀ x₁ x₂ c at hs
  rw [coordinateDescendantSequences, Finset.mem_sigma] at hs
  rcases hs with ⟨hy₀, hyrest⟩
  rw [Finset.mem_sigma] at hyrest
  rcases hyrest with ⟨hy₁, hy₂⟩
  let Z₁ := replaceVertex Z₀ x₀ y₀
  let Z₂ := replaceVertex Z₁ x₁ y₁
  let Z₃ := replaceVertex Z₂ x₂ y₂
  have hy₀not : y₀ ∉ Z₀ := mem_coordinateGoodInBlock_not_current hy₀
  have hZ₁ : Z₁ ∈ allEdges n :=
    replaceVertex_mem_allEdges (x := x₀) (y := y₀)
      hZ₀ (by simp [hZeq]) hy₀not
  have hx₁Z₁ : x₁ ∈ Z₁ := by
    dsimp [Z₁]
    unfold replaceVertex
    apply Finset.mem_insert.mpr
    right
    exact Finset.mem_erase.mpr ⟨hx₀₁.symm, by simp [hZeq]⟩
  have hy₁not : y₁ ∉ Z₁ := mem_coordinateGoodInBlock_not_current hy₁
  have hZ₂ : Z₂ ∈ allEdges n :=
    replaceVertex_mem_allEdges (x := x₁) (y := y₁)
      hZ₁ hx₁Z₁ hy₁not
  have hx₂Z₁ : x₂ ∈ Z₁ := by
    dsimp [Z₁]
    unfold replaceVertex
    apply Finset.mem_insert.mpr
    right
    exact Finset.mem_erase.mpr ⟨hx₀₂.symm, by simp [hZeq]⟩
  have hx₂Z₂ : x₂ ∈ Z₂ := by
    dsimp [Z₂]
    unfold replaceVertex
    apply Finset.mem_insert.mpr
    right
    exact Finset.mem_erase.mpr ⟨hx₁₂.symm, hx₂Z₁⟩
  have hy₂not : y₂ ∉ Z₂ := mem_coordinateGoodInBlock_not_current hy₂
  have hZ₃ : Z₃ ∈ allEdges n :=
    replaceVertex_mem_allEdges (x := x₂) (y := y₂)
      hZ₂ hx₂Z₂ hy₂not
  have hy₀block := mem_coordinateGoodInBlock_colorBlock hy₀
  have hy₁block := mem_coordinateGoodInBlock_colorBlock hy₁
  have hy₂block := mem_coordinateGoodInBlock_colorBlock hy₂
  have hy₀₁ : y₀ ≠ y₁ := ne_of_mem_colorBlocks hn (by decide)
    hy₀block hy₁block
  have hy₀₂ : y₀ ≠ y₂ := ne_of_mem_colorBlocks hn (by decide)
    hy₀block hy₂block
  have hy₁₂ : y₁ ≠ y₂ := ne_of_mem_colorBlocks hn (by decide)
    hy₁block hy₂block
  have hy₀orig := mem_coordinateGoodInBlock_not_original hy₀
  have hy₁orig := mem_coordinateGoodInBlock_not_original hy₁
  have hy₂orig := mem_coordinateGoodInBlock_not_original hy₂
  have hZ₃eq : Z₃ = {y₀, y₁, y₂} := by
    ext v
    simp only [Z₃, Z₂, Z₁, replaceVertex, Finset.mem_insert,
      Finset.mem_erase]
    constructor
    · rintro (rfl | ⟨hvx₂, rfl | ⟨hvx₁, rfl | ⟨hvx₀, hvZ₀⟩⟩⟩)
      · simp
      · simp
      · simp
      · rw [hZeq] at hvZ₀
        simp only [Finset.mem_insert, Finset.mem_singleton] at hvZ₀
        rcases hvZ₀ with rfl | rfl | rfl
        · exact False.elim (hvx₀ rfl)
        · exact False.elim (hvx₁ rfl)
        · exact False.elim (hvx₂ rfl)
    · intro hv
      simp only [Finset.mem_insert, Finset.mem_singleton] at hv
      rcases hv with rfl | rfl | rfl
      · exact Or.inr ⟨by
          intro h
          subst x₂
          exact hy₀orig (by simp [hZeq]), Or.inr ⟨by
            intro h
            subst x₁
            exact hy₀orig (by simp [hZeq]), Or.inl rfl⟩⟩
      · exact Or.inr ⟨by
          intro h
          subst x₂
          exact hy₁orig (by simp [hZeq]), Or.inl rfl⟩
      · exact Or.inl rfl
  have hw1 := coordinateGoodInBlock_weight hy₀
  have hw2 := coordinateGoodInBlock_weight hy₁
  have hw3 := coordinateGoodInBlock_weight hy₂
  have hmul1 := mul_le_mul_of_nonneg_left hw1 hc0
  have hmul2 := mul_le_mul_of_nonneg_left hw2 hc0
  have hweight : c^3 * (completionWeight H Z₀ : ℝ) ≤
      completionWeight H Z₃ := by
    calc
      c^3 * (completionWeight H Z₀ : ℝ) =
          c * (c * (c * (completionWeight H Z₀ : ℝ))) := by ring
      _ ≤ c * (c * (completionWeight H Z₁ : ℝ)) := by
        exact mul_le_mul_of_nonneg_left hmul1 hc0
      _ ≤ c * (completionWeight H Z₂ : ℝ) := hmul2
      _ ≤ completionWeight H Z₃ := hw3
  change coordinateSequenceTriple (⟨y₀, ⟨y₁, y₂⟩⟩ :
      Sigma fun _y₀ : Vertex n ↦
        Sigma fun _y₁ : Vertex n ↦ Vertex n) ∈
    coordinateHeavyDescendants H Z₀ c
  apply Finset.mem_filter.mpr
  refine ⟨?_, ?_⟩
  · simpa [coordinateSequenceTriple, hZ₃eq] using hZ₃
  · simpa [coordinateSequenceTriple, hZ₃eq] using hweight

lemma coordinateDescendantSequence_color_mem {n : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    {x₀ x₁ x₂ : Vertex n} {c : ℝ}
    {s : Sigma fun _y₀ : Vertex n ↦
      Sigma fun _y₁ : Vertex n ↦ Vertex n}
    (hs : s ∈ coordinateDescendantSequences H Z₀ x₀ x₁ x₂ c) :
    s.1 ∈ colorBlock n (0 : Fin 3) ∧
      s.2.1 ∈ colorBlock n (1 : Fin 3) ∧
      s.2.2 ∈ colorBlock n (2 : Fin 3) := by
  rcases s with ⟨y₀, ⟨y₁, y₂⟩⟩
  rw [coordinateDescendantSequences, Finset.mem_sigma] at hs
  rcases hs with ⟨hy₀, hyrest⟩
  rw [Finset.mem_sigma] at hyrest
  rcases hyrest with ⟨hy₁, hy₂⟩
  exact ⟨mem_coordinateGoodInBlock_colorBlock hy₀,
    mem_coordinateGoodInBlock_colorBlock hy₁,
    mem_coordinateGoodInBlock_colorBlock hy₂⟩

/-- The fixed color blocks make the endpoint map injective even though an
edge is represented as an unordered finset. -/
lemma coordinateSequenceTriple_injective_on {n : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    {x₀ x₁ x₂ : Vertex n} {c : ℝ} (hn : 0 < n) :
    Set.InjOn coordinateSequenceTriple
      (↑(coordinateDescendantSequences H Z₀ x₀ x₁ x₂ c) :
        Set (Sigma fun _y₀ : Vertex n ↦
          Sigma fun _y₁ : Vertex n ↦ Vertex n)) := by
  rintro ⟨y₀, ⟨y₁, y₂⟩⟩ hy ⟨z₀, ⟨z₁, z₂⟩⟩ hz heq
  have hyc := coordinateDescendantSequence_color_mem hy
  have hzc := coordinateDescendantSequence_color_mem hz
  have hy₀mem : y₀ ∈ coordinateSequenceTriple
      (⟨z₀, ⟨z₁, z₂⟩⟩ :
        Sigma fun _y₀ : Vertex n ↦
          Sigma fun _y₁ : Vertex n ↦ Vertex n) := by
    rw [← heq]
    simp [coordinateSequenceTriple]
  have hy₀cases : y₀ = z₀ ∨ y₀ = z₁ ∨ y₀ = z₂ := by
    simpa [coordinateSequenceTriple] using hy₀mem
  have hy₀z₀ : y₀ = z₀ := by
    rcases hy₀cases with h | h | h
    · exact h
    · exact False.elim ((ne_of_mem_colorBlocks hn (by decide)
        hyc.1 hzc.2.1) h)
    · exact False.elim ((ne_of_mem_colorBlocks hn (by decide)
        hyc.1 hzc.2.2) h)
  subst z₀
  have hy₁mem : y₁ ∈ coordinateSequenceTriple
      (⟨y₀, ⟨z₁, z₂⟩⟩ :
        Sigma fun _y₀ : Vertex n ↦
          Sigma fun _y₁ : Vertex n ↦ Vertex n) := by
    rw [← heq]
    simp [coordinateSequenceTriple]
  have hy₁cases : y₁ = y₀ ∨ y₁ = z₁ ∨ y₁ = z₂ := by
    simpa [coordinateSequenceTriple] using hy₁mem
  have hy₁z₁ : y₁ = z₁ := by
    rcases hy₁cases with h | h | h
    · exact False.elim ((ne_of_mem_colorBlocks hn (by decide)
        hyc.2.1 hzc.1) h)
    · exact h
    · exact False.elim ((ne_of_mem_colorBlocks hn (by decide)
        hyc.2.1 hzc.2.2) h)
  subst z₁
  have hy₂mem : y₂ ∈ coordinateSequenceTriple
      (⟨y₀, ⟨y₁, z₂⟩⟩ :
        Sigma fun _y₀ : Vertex n ↦
          Sigma fun _y₁ : Vertex n ↦ Vertex n) := by
    rw [← heq]
    simp [coordinateSequenceTriple]
  have hy₂cases : y₂ = y₀ ∨ y₂ = y₁ ∨ y₂ = z₂ := by
    simpa [coordinateSequenceTriple] using hy₂mem
  have hy₂z₂ : y₂ = z₂ := by
    rcases hy₂cases with h | h | h
    · exact False.elim ((ne_of_mem_colorBlocks hn (by decide)
        hyc.2.2 hzc.1) h)
    · exact False.elim ((ne_of_mem_colorBlocks hn (by decide)
        hyc.2.2 hzc.2.1) h)
    · exact h
  subst z₂
  rfl

lemma cube_half_le_card_coordinateHeavyDescendants {n b : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    {x₀ x₁ x₂ : Vertex n} {c : ℝ}
    (hn : 0 < n) (hZ₀ : Z₀ ∈ allEdges n)
    (hZeq : Z₀ = {x₀, x₁, x₂})
    (hx₀₁ : x₀ ≠ x₁) (hx₀₂ : x₀ ≠ x₂) (hx₁₂ : x₁ ≠ x₂)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (htransfer : CoordinateTransferAbove n H
      (c^2 * (completionWeight H Z₀ : ℝ)) c b)
    (hbudget : 2 * b + 12 ≤ n) :
    (n / 2)^3 ≤ (coordinateHeavyDescendants H Z₀ c).card := by
  have hseq := cube_half_le_card_coordinateDescendantSequences
    hZ₀ hZeq hx₀₁ hx₀₂ hx₁₂ hc0 hc1 htransfer hbudget
  have hmap := coordinateSequenceTriple_mapsTo_heavyDescendants
    (H := H) hn hZ₀ hZeq hx₀₁ hx₀₂ hx₁₂ hc0
  have hinj := coordinateSequenceTriple_injective_on
    (H := H) (Z₀ := Z₀) (x₀ := x₀) (x₁ := x₁) (x₂ := x₂)
    (c := c) hn
  exact hseq.trans (Finset.card_le_card_of_injOn
    coordinateSequenceTriple hmap hinj)

/-- Quantitative coordinate transfer for one maximum-weight triple yields
the maximum-only domination package with an explicit positive density. -/
lemma maximumWeightDominated_of_max_transfer {n b : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n} {c : ℝ}
    (hn : 0 < n) (hZ₀ : Z₀ ∈ allEdges n)
    (hmax : ∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀)
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (htransfer : CoordinateTransferAbove n H
      (c^2 * (completionWeight H Z₀ : ℝ)) c b)
    (hbudget : 2 * b + 12 ≤ n) :
    MaximumWeightDominated n H
      (((n / 2 : ℕ) : ℝ)^3 / (allEdges n).card) (c^3) := by
  rcases Finset.card_eq_three.mp (mem_allEdges.mp hZ₀) with
    ⟨x₀, x₁, x₂, hx₀₁, hx₀₂, hx₁₂, hZeq⟩
  have hdescNat := cube_half_le_card_coordinateHeavyDescendants
    hn hZ₀ hZeq hx₀₁ hx₀₂ hx₁₂ hc0 hc1 htransfer hbudget
  have hdesc : (((n / 2 : ℕ) : ℝ)^3) ≤
      ((coordinateHeavyDescendants H Z₀ c).card : ℝ) := by
    exact_mod_cast hdescNat
  have hKnonempty : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i, mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hKpos : (0 : ℝ) < (allEdges n).card := by
    exact_mod_cast Finset.card_pos.mpr hKnonempty
  refine ⟨Z₀, hZ₀, hmax, ?_⟩
  change (((n / 2 : ℕ) : ℝ)^3 / (allEdges n).card) *
      ((allEdges n).card : ℝ) ≤
    (((allEdges n).filter fun U ↦
      c^3 * (completionWeight H Z₀ : ℝ) ≤
        completionWeight H U).card : ℝ)
  rw [div_mul_cancel₀ _ hKpos.ne']
  simpa [coordinateHeavyDescendants] using hdesc

/-! ### Residual matching sums for one-coordinate transfer -/

/-- Matchings of size `n-2` avoiding a prescribed triple.  These are the
residual objects after exposing the unique edge through the replaced
coordinate of a near-perfect matching. -/
def residualMatchings (n : ℕ) (H : Finset (Edge n)) (U : Edge n) :
    Finset (Finset (Edge n)) :=
  (H.powersetCard (n - 2)).filter fun F ↦
    IsMatching F ∧ ∀ A ∈ F, Disjoint A U

@[simp] lemma mem_residualMatchings {n : ℕ}
    {H : Finset (Edge n)} {U : Edge n} {F : Finset (Edge n)} :
    F ∈ residualMatchings n H U ↔
      F ⊆ H ∧ F.card = n - 2 ∧ IsMatching F ∧
        ∀ A ∈ F, Disjoint A U := by
  simp [residualMatchings, and_assoc]

def residualWeight (n : ℕ) (H : Finset (Edge n)) (U : Edge n) : ℕ :=
  (residualMatchings n H U).card

/-- The part of `H` induced away from the vertices of `Z`. -/
def inducedAway {n : ℕ} (H : Finset (Edge n)) (Z : Edge n) :
    Finset (Edge n) :=
  H.filter fun A ↦ Disjoint A Z

@[simp] lemma mem_inducedAway {n : ℕ} {H : Finset (Edge n)}
    {Z A : Edge n} :
    A ∈ inducedAway H Z ↔ A ∈ H ∧ Disjoint A Z := by
  simp [inducedAway]

/-- Pairs `S` for which `S ∪ {x}` is an edge of `H`, restricted to be
disjoint from both the old triple `Z` and the incoming vertex `y`. -/
def coordinateLinkPairs {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (x y : Vertex n) : Finset (Edge n) :=
  ((Finset.univ : Finset (Vertex n)).powersetCard 2).filter fun S ↦
    Disjoint S (insert y Z) ∧ insert x S ∈ H

@[simp] lemma mem_coordinateLinkPairs {n : ℕ}
    {H : Finset (Edge n)} {Z S : Edge n} {x y : Vertex n} :
    S ∈ coordinateLinkPairs H Z x y ↔
      S.card = 2 ∧ Disjoint S (insert y Z) ∧ insert x S ∈ H := by
  simp [coordinateLinkPairs, and_assoc]

/-- Present edges through `x` whose other two vertices avoid both the old
triple (apart from `x`) and the incoming vertex.  Erasing `x` sends these
edges injectively to `coordinateLinkPairs`. -/
def coordinateEligibleEdges {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (x y : Vertex n) : Finset (Edge n) :=
  (H.filter fun A ↦ x ∈ A).filter fun A ↦
    Disjoint A (insert y (Z.erase x))

@[simp] lemma mem_coordinateEligibleEdges {n : ℕ}
    {H : Finset (Edge n)} {Z A : Edge n} {x y : Vertex n} :
    A ∈ coordinateEligibleEdges H Z x y ↔
      A ∈ H ∧ x ∈ A ∧ Disjoint A (insert y (Z.erase x)) := by
  simp [coordinateEligibleEdges, and_assoc]

/-- The complementary set of present edges through `x`, namely those lost
from the exposed link because they meet `y` or another vertex of `Z`. -/
def coordinateIneligibleEdges {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (x y : Vertex n) : Finset (Edge n) :=
  (H.filter fun A ↦ x ∈ A).filter fun A ↦
    ¬Disjoint A (insert y (Z.erase x))

@[simp] lemma mem_coordinateIneligibleEdges {n : ℕ}
    {H : Finset (Edge n)} {Z A : Edge n} {x y : Vertex n} :
    A ∈ coordinateIneligibleEdges H Z x y ↔
      A ∈ H ∧ x ∈ A ∧ ¬Disjoint A (insert y (Z.erase x)) := by
  simp [coordinateIneligibleEdges, and_assoc]

lemma card_coordinateEligible_add_ineligible {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (x y : Vertex n) :
    (coordinateEligibleEdges H Z x y).card +
        (coordinateIneligibleEdges H Z x y).card =
      vertexDegree H x := by
  simpa [coordinateEligibleEdges, coordinateIneligibleEdges,
    vertexDegree] using
    (Finset.card_filter_add_card_filter_not
      (s := H.filter fun A ↦ x ∈ A)
      (p := fun A ↦ Disjoint A (insert y (Z.erase x))))

lemma coordinateEligibleEdges_mapsTo_linkPairs {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hH : H ⊆ allEdges n) :
    Set.MapsTo (fun A : Edge n ↦ A.erase x)
      (↑(coordinateEligibleEdges H Z x y) : Set (Edge n))
      (↑(coordinateLinkPairs H Z x y) : Set (Edge n)) := by
  intro A hA
  rcases mem_coordinateEligibleEdges.mp hA with ⟨hAH, hxA, hdisj⟩
  have hAcard : A.card = 3 := mem_allEdges.mp (hH hAH)
  apply mem_coordinateLinkPairs.mpr
  refine ⟨?_, ?_, ?_⟩
  · rw [Finset.card_erase_of_mem hxA, hAcard]
  · rw [Finset.disjoint_left]
    intro v hvErase hvTarget
    have hvA : v ∈ A := Finset.mem_of_mem_erase hvErase
    rcases Finset.mem_insert.mp hvTarget with rfl | hvZ
    · exact Finset.disjoint_left.mp hdisj hvA
        (Finset.mem_insert_self _ (Z.erase x))
    · have hvx : v ≠ x := (Finset.mem_erase.mp hvErase).1
      exact Finset.disjoint_left.mp hdisj hvA
        (Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨hvx, hvZ⟩))
  · rwa [Finset.insert_erase hxA]

lemma coordinateEligibleEdges_erase_injectiveOn {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n} :
    Set.InjOn (fun A : Edge n ↦ A.erase x)
      (↑(coordinateEligibleEdges H Z x y) : Set (Edge n)) := by
  intro A hA B hB hEq
  have hxA := (mem_coordinateEligibleEdges.mp hA).2.1
  have hxB := (mem_coordinateEligibleEdges.mp hB).2.1
  have hInsert := congrArg (fun S : Edge n ↦ insert x S) hEq
  simpa only [Finset.insert_erase hxA, Finset.insert_erase hxB] using hInsert

lemma card_coordinateEligibleEdges_le_linkPairs {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hH : H ⊆ allEdges n) :
    (coordinateEligibleEdges H Z x y).card ≤
      (coordinateLinkPairs H Z x y).card :=
  Finset.card_le_card_of_injOn (fun A : Edge n ↦ A.erase x)
    (coordinateEligibleEdges_mapsTo_linkPairs hH)
    coordinateEligibleEdges_erase_injectiveOn

lemma card_insert_erase_eq_three {n : ℕ} {Z : Edge n}
    {x y : Vertex n} (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hy : y ∉ Z) :
    (insert y (Z.erase x)).card = 3 := by
  rw [Finset.card_insert_of_notMem]
  · rw [Finset.card_erase_of_mem hx, mem_allEdges.mp hZ]
  · exact fun hyErase ↦ hy (Finset.mem_of_mem_erase hyErase)

lemma coordinateIneligibleEdges_subset_pairUnion {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (x y : Vertex n) :
    coordinateIneligibleEdges H Z x y ⊆
      (insert y (Z.erase x)).biUnion fun v ↦
        H.filter fun A ↦ x ∈ A ∧ v ∈ A := by
  intro A hA
  rcases mem_coordinateIneligibleEdges.mp hA with
    ⟨hAH, hxA, hnotDisj⟩
  rcases Finset.not_disjoint_iff.mp hnotDisj with ⟨v, hvA, hvForbidden⟩
  rw [Finset.mem_biUnion]
  exact ⟨v, hvForbidden, Finset.mem_filter.mpr ⟨hAH, hxA, hvA⟩⟩

lemma card_coordinateIneligibleEdges_le {n codegCap : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z) (hy : y ∉ Z)
    (hcodeg : ∀ v ∈ insert y (Z.erase x),
      vertexCodegree H x v ≤ codegCap) :
    (coordinateIneligibleEdges H Z x y).card ≤ 3 * codegCap := by
  calc
    (coordinateIneligibleEdges H Z x y).card ≤
        ((insert y (Z.erase x)).biUnion fun v ↦
          H.filter fun A ↦ x ∈ A ∧ v ∈ A).card :=
      Finset.card_le_card (coordinateIneligibleEdges_subset_pairUnion H Z x y)
    _ ≤ ∑ v ∈ insert y (Z.erase x),
        (H.filter fun A ↦ x ∈ A ∧ v ∈ A).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ _v ∈ insert y (Z.erase x), codegCap := by
      apply Finset.sum_le_sum
      intro v hv
      exact hcodeg v hv
    _ = 3 * codegCap := by
      simp [card_insert_erase_eq_three hZ hx hy, Nat.mul_comm]

/-- Degree/codegree regularity gives the deterministic lower bound on every
exposed coordinate link used in Kahn's transfer argument. -/
lemma vertexDegree_sub_three_mul_codegree_le_linkPairs {n codegCap : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hH : H ⊆ allEdges n) (hZ : Z ∈ allEdges n)
    (hx : x ∈ Z) (hy : y ∉ Z)
    (hcodeg : ∀ v ∈ insert y (Z.erase x),
      vertexCodegree H x v ≤ codegCap) :
    vertexDegree H x - 3 * codegCap ≤
      (coordinateLinkPairs H Z x y).card := by
  have hsplit := card_coordinateEligible_add_ineligible H Z x y
  have helig := card_coordinateEligibleEdges_le_linkPairs
    (H := H) (Z := Z) (x := x) (y := y) hH
  have hbad := card_coordinateIneligibleEdges_le hZ hx hy hcodeg
  omega

/-- All link-pair/residual-matching pairs appearing in the transfer sum. -/
def coordinateResidualPairs (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) (x y : Vertex n) :
    Finset (Sigma fun _S : Edge n ↦ Finset (Edge n)) :=
  (coordinateLinkPairs H Z x y).sigma fun S ↦
    residualMatchings n (inducedAway H Z) (insert y S)

/-- Assemble a link edge and a residual matching. -/
def assembleCoordinateResidual {n : ℕ}
    (x : Vertex n)
    (p : Sigma fun _S : Edge n ↦ Finset (Edge n)) :
    Finset (Edge n) :=
  insert (insert x p.1) p.2

lemma assembleCoordinateResidual_mapsTo {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hn : 2 ≤ n) (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hy : y ∉ Z) :
    Set.MapsTo (assembleCoordinateResidual x)
      (↑(coordinateResidualPairs n H Z x y) :
        Set (Sigma fun _S : Edge n ↦ Finset (Edge n)))
      (↑(completionMatchings n H (insert y (Z.erase x))) :
        Set (Finset (Edge n))) := by
  rintro ⟨S, R⟩ hSR
  change (⟨S, R⟩ : Sigma fun _S : Edge n ↦ Finset (Edge n)) ∈
    coordinateResidualPairs n H Z x y at hSR
  rw [coordinateResidualPairs, Finset.mem_sigma] at hSR
  rcases hSR with ⟨hSlink, hRres⟩
  rcases mem_coordinateLinkPairs.mp hSlink with ⟨hScard, hSdisj, hESH⟩
  rcases mem_residualMatchings.mp hRres with
    ⟨hRsub, hRcard, hRmatch, hRavoid⟩
  have hxS : x ∉ S := by
    intro hxS
    exact Finset.disjoint_left.mp hSdisj hxS
      (Finset.mem_insert_of_mem hx)
  have hER : insert x S ∉ R := by
    intro hEinR
    have hEinduced := mem_inducedAway.mp (hRsub hEinR)
    exact Finset.disjoint_left.mp hEinduced.2
      (Finset.mem_insert_self x S) hx
  have hEavoid : Disjoint (insert x S) (insert y (Z.erase x)) := by
    rw [Finset.disjoint_left]
    intro v hvE hvT
    rcases Finset.mem_insert.mp hvE with rfl | hvS
    · rcases Finset.mem_insert.mp hvT with hxy | hvErase
      · exact hy (hxy ▸ hx)
      · exact (Finset.mem_erase.mp hvErase).1 rfl
    · rcases Finset.mem_insert.mp hvT with rfl | hvErase
      · exact Finset.disjoint_left.mp hSdisj hvS
          (Finset.mem_insert_self _ Z)
      · exact Finset.disjoint_left.mp hSdisj hvS
          (Finset.mem_insert_of_mem (Finset.mem_erase.mp hvErase).2)
  have hRE : ∀ A ∈ R, Disjoint A (insert x S) := by
    intro A hAR
    have hAinduced := mem_inducedAway.mp (hRsub hAR)
    have hAavoid := hRavoid A hAR
    rw [Finset.disjoint_left]
    intro v hvA hvE
    rcases Finset.mem_insert.mp hvE with rfl | hvS
    · exact Finset.disjoint_left.mp hAinduced.2 hvA hx
    · exact Finset.disjoint_left.mp hAavoid hvA
        (Finset.mem_insert_of_mem hvS)
  change assembleCoordinateResidual x (⟨S, R⟩ :
      Sigma fun _S : Edge n ↦ Finset (Edge n)) ∈
    completionMatchings n H (insert y (Z.erase x))
  apply mem_completionMatchings.mpr
  refine ⟨?_, ?_, isMatching_insert_of_avoids hRmatch hRE, ?_⟩
  · apply Finset.insert_subset hESH
    intro A hAR
    exact (mem_inducedAway.mp (hRsub hAR)).1
  · rw [assembleCoordinateResidual, Finset.card_insert_of_notMem hER,
      hRcard]
    omega
  · intro A hA
    rcases Finset.mem_insert.mp hA with rfl | hAR
    · exact hEavoid
    · have hAZ := (mem_inducedAway.mp (hRsub hAR)).2
      have hAyS := hRavoid A hAR
      rw [Finset.disjoint_left]
      intro v hvA hvT
      rcases Finset.mem_insert.mp hvT with rfl | hvErase
      · exact Finset.disjoint_left.mp hAyS hvA
          (Finset.mem_insert_self _ S)
      · exact Finset.disjoint_left.mp hAZ hvA
          (Finset.mem_erase.mp hvErase).2

lemma assembleCoordinateResidual_injective_on {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hx : x ∈ Z) :
    Set.InjOn (assembleCoordinateResidual x)
      (↑(coordinateResidualPairs n H Z x y) :
        Set (Sigma fun _S : Edge n ↦ Finset (Edge n))) := by
  rintro ⟨S, R⟩ hSR ⟨T, Q⟩ hTQ heq
  change (⟨S, R⟩ : Sigma fun _S : Edge n ↦ Finset (Edge n)) ∈
    coordinateResidualPairs n H Z x y at hSR
  change (⟨T, Q⟩ : Sigma fun _S : Edge n ↦ Finset (Edge n)) ∈
    coordinateResidualPairs n H Z x y at hTQ
  rw [coordinateResidualPairs, Finset.mem_sigma] at hSR hTQ
  rcases hSR with ⟨hSlink, hRres⟩
  rcases hTQ with ⟨hTlink, hQres⟩
  change insert (insert x S) R = insert (insert x T) Q at heq
  have hxS : x ∉ S := by
    have hd := (mem_coordinateLinkPairs.mp hSlink).2.1
    intro hxS
    exact Finset.disjoint_left.mp hd hxS
      (Finset.mem_insert_of_mem hx)
  have hxT : x ∉ T := by
    have hd := (mem_coordinateLinkPairs.mp hTlink).2.1
    intro hxT
    exact Finset.disjoint_left.mp hd hxT
      (Finset.mem_insert_of_mem hx)
  have hER : insert x S ∉ R := by
    intro hER
    have hdisj := (mem_inducedAway.mp
      ((mem_residualMatchings.mp hRres).1 hER)).2
    exact Finset.disjoint_left.mp hdisj
      (Finset.mem_insert_self x S) hx
  have hEQ : insert x T ∉ Q := by
    intro hEQ
    have hdisj := (mem_inducedAway.mp
      ((mem_residualMatchings.mp hQres).1 hEQ)).2
    exact Finset.disjoint_left.mp hdisj
      (Finset.mem_insert_self x T) hx
  have hEE : insert x S = insert x T := by
    have hmem : insert x S ∈ insert (insert x T) Q := by
      rw [← heq]
      exact Finset.mem_insert_self _ _
    rcases Finset.mem_insert.mp hmem with h | h
    · exact h
    · have hdisj := (mem_inducedAway.mp
        ((mem_residualMatchings.mp hQres).1 h)).2
      exact False.elim (Finset.disjoint_left.mp hdisj
        (Finset.mem_insert_self x S) hx)
  have hST : S = T := by
    simpa only [Finset.erase_insert hxS, Finset.erase_insert hxT] using
      congrArg (fun E : Edge n ↦ E.erase x) hEE
  subst T
  have hRQ : R = Q := by
    simpa only [Finset.erase_insert hER, Finset.erase_insert hEQ] using
      congrArg (fun F : Finset (Edge n) ↦ F.erase (insert x S)) heq
  subst Q
  rfl

lemma card_coordinateResidualPairs (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) (x y : Vertex n) :
    (coordinateResidualPairs n H Z x y).card =
      ∑ S ∈ coordinateLinkPairs H Z x y,
        residualWeight n (inducedAway H Z) (insert y S) := by
  rw [coordinateResidualPairs, Finset.card_sigma]
  rfl

/-- Exact combinatorial lower bound behind Kahn's one-coordinate identity:
each link-pair/residual matching assembles injectively into a near-perfect
matching through the replaced triple. -/
lemma sum_residualWeight_coordinateLink_le_completionWeight {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hn : 2 ≤ n) (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hy : y ∉ Z) :
    (∑ S ∈ coordinateLinkPairs H Z x y,
        residualWeight n (inducedAway H Z) (insert y S)) ≤
      completionWeight H (replaceVertex Z x y) := by
  have hmap := assembleCoordinateResidual_mapsTo (H := H) hn hZ hx hy
  have hinj := assembleCoordinateResidual_injective_on
    (H := H) (y := y) hx
  have hcard : (coordinateResidualPairs n H Z x y).card ≤
      (completionMatchings n H (insert y (Z.erase x))).card :=
    Finset.card_le_card_of_injOn (assembleCoordinateResidual x) hmap hinj
  rw [card_coordinateResidualPairs] at hcard
  have hreplace : replaceVertex Z x y = insert y (Z.erase x) := rfl
  rw [hreplace, completionWeight_eq_card_completionMatchings
    H (insert y (Z.erase x)) (by omega)
      (by simpa [replaceVertex] using
        (replaceVertex_mem_allEdges (x := x) (y := y) hZ hx hy))]
  exact hcard

def coordinateBadLinkPairs (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) (x y : Vertex n) (a : ℝ) : Finset (Edge n) :=
  (coordinateLinkPairs H Z x y).filter fun S ↦
    ¬a ≤ (residualWeight n (inducedAway H Z) (insert y S) : ℝ)

/-- The full ambient pair layer available to an incoming vertex before the
random link through `x` is exposed. -/
def coordinateAmbientPairs (n : ℕ) (Z : Edge n) (y : Vertex n) :
    Finset (Edge n) :=
  ((Finset.univ : Finset (Vertex n)).powersetCard 2).filter fun S ↦
    Disjoint S (insert y Z)

@[simp] lemma mem_coordinateAmbientPairs {n : ℕ}
    {Z S : Edge n} {y : Vertex n} :
    S ∈ coordinateAmbientPairs n Z y ↔
      S.card = 2 ∧ Disjoint S (insert y Z) := by
  simp [coordinateAmbientPairs]

/-- The edge layer through `x` corresponding bijectively to the ambient
pair population.  This is the only part of the random hypergraph exposed
in the conditional link-sampling argument. -/
def coordinateLinkLayer (n : ℕ) (Z : Edge n) (x y : Vertex n) :
    Finset (Edge n) :=
  (coordinateAmbientPairs n Z y).image fun S ↦ insert x S

@[simp] lemma mem_coordinateLinkLayer {n : ℕ}
    {Z A : Edge n} {x y : Vertex n} :
    A ∈ coordinateLinkLayer n Z x y ↔
      ∃ S ∈ coordinateAmbientPairs n Z y, insert x S = A := by
  simp [coordinateLinkLayer]

lemma insert_x_injectiveOn_coordinateAmbientPairs {n : ℕ}
    {Z : Edge n} {x y : Vertex n} (hx : x ∈ Z) :
    Set.InjOn (fun S : Edge n ↦ insert x S)
      (↑(coordinateAmbientPairs n Z y) : Set (Edge n)) := by
  intro S hS T hT hEq
  have hxS : x ∉ S := by
    intro hxS
    exact Finset.disjoint_left.mp
      (mem_coordinateAmbientPairs.mp hS).2 hxS
      (Finset.mem_insert_of_mem hx)
  have hxT : x ∉ T := by
    intro hxT
    exact Finset.disjoint_left.mp
      (mem_coordinateAmbientPairs.mp hT).2 hxT
      (Finset.mem_insert_of_mem hx)
  simpa only [Finset.erase_insert hxS, Finset.erase_insert hxT] using
    congrArg (fun U : Edge n ↦ U.erase x) hEq

lemma coordinateLinkLayer_subset_allEdges {n : ℕ}
    {Z : Edge n} {x y : Vertex n}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z) :
    coordinateLinkLayer n Z x y ⊆ allEdges n := by
  intro A hA
  rcases mem_coordinateLinkLayer.mp hA with ⟨S, hS, rfl⟩
  rcases mem_coordinateAmbientPairs.mp hS with ⟨hScard, hSdisj⟩
  have hxS : x ∉ S := by
    intro hxS
    exact Finset.disjoint_left.mp hSdisj hxS
      (Finset.mem_insert_of_mem hx)
  apply mem_allEdges.mpr
  rw [Finset.card_insert_of_notMem hxS, hScard]

lemma card_coordinateLinkLayer {n : ℕ}
    {Z : Edge n} {x y : Vertex n} (hx : x ∈ Z) :
    (coordinateLinkLayer n Z x y).card =
      (coordinateAmbientPairs n Z y).card := by
  unfold coordinateLinkLayer
  exact Finset.card_image_iff.mpr
    (insert_x_injectiveOn_coordinateAmbientPairs hx)

lemma coordinateLinkPairs_eq_filter_ambient {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (x y : Vertex n) :
    coordinateLinkPairs H Z x y =
      (coordinateAmbientPairs n Z y).filter fun S ↦ insert x S ∈ H := by
  ext S
  simp [mem_coordinateLinkPairs, mem_coordinateAmbientPairs, and_assoc]

lemma image_coordinateLinkPairs_eq_inter_linkLayer {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hx : x ∈ Z) :
    (coordinateLinkPairs H Z x y).image (fun S ↦ insert x S) =
      H ∩ coordinateLinkLayer n Z x y := by
  ext A
  constructor
  · intro hA
    rcases Finset.mem_image.mp hA with ⟨S, hS, rfl⟩
    have hS' := mem_coordinateLinkPairs.mp hS
    apply Finset.mem_inter.mpr
    refine ⟨hS'.2.2, ?_⟩
    exact mem_coordinateLinkLayer.mpr
      ⟨S, mem_coordinateAmbientPairs.mpr ⟨hS'.1, hS'.2.1⟩, rfl⟩
  · intro hA
    rcases Finset.mem_inter.mp hA with ⟨hAH, hAlayer⟩
    rcases mem_coordinateLinkLayer.mp hAlayer with ⟨S, hS, hSA⟩
    apply Finset.mem_image.mpr
    refine ⟨S, ?_, hSA⟩
    rw [coordinateLinkPairs_eq_filter_ambient]
    exact Finset.mem_filter.mpr ⟨hS, hSA ▸ hAH⟩

lemma card_coordinateLinkPairs_eq_inter_linkLayer {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hx : x ∈ Z) :
    (coordinateLinkPairs H Z x y).card =
      (H ∩ coordinateLinkLayer n Z x y).card := by
  rw [← image_coordinateLinkPairs_eq_inter_linkLayer hx]
  exact (Finset.card_image_iff.mpr
    (fun S hS T hT hEq ↦
      insert_x_injectiveOn_coordinateAmbientPairs hx
        (mem_coordinateAmbientPairs.mpr
          ⟨(mem_coordinateLinkPairs.mp hS).1,
            (mem_coordinateLinkPairs.mp hS).2.1⟩)
        (mem_coordinateAmbientPairs.mpr
          ⟨(mem_coordinateLinkPairs.mp hT).1,
            (mem_coordinateLinkPairs.mp hT).2.1⟩) hEq)).symm

/-- Edges outside the conditionally exposed coordinate-link layer. -/
def coordinateOutsideLayer (n : ℕ) (Z : Edge n) (x y : Vertex n) :
    Finset (Edge n) :=
  allEdges n \ coordinateLinkLayer n Z x y

lemma inducedAway_inter_linkLayer_eq_empty {n : ℕ}
    {Z : Edge n} {x y : Vertex n} (hx : x ∈ Z) :
    (coordinateLinkLayer n Z x y).filter (fun A ↦ Disjoint A Z) = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro A hA
  rcases Finset.mem_filter.mp hA with ⟨hAlayer, hdisj⟩
  rcases mem_coordinateLinkLayer.mp hAlayer with ⟨S, hS, rfl⟩
  exact Finset.disjoint_left.mp hdisj (Finset.mem_insert_self x S) hx

lemma inducedAway_union_linkImage {n : ℕ}
    {R L : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hx : x ∈ Z) (hL : L ⊆ coordinateAmbientPairs n Z y) :
    inducedAway (R ∪ L.image (fun S ↦ insert x S)) Z =
      inducedAway R Z := by
  ext A
  simp only [mem_inducedAway, Finset.mem_union, Finset.mem_image]
  constructor
  · rintro ⟨hAR | ⟨S, hSL, hSA⟩, hdisj⟩
    · exact ⟨hAR, hdisj⟩
    · subst A
      exact False.elim
        (Finset.disjoint_left.mp hdisj (Finset.mem_insert_self x S) hx)
  · rintro ⟨hAR, hdisj⟩
    exact ⟨Or.inl hAR, hdisj⟩

/-- Conditional-coordinate decompositions of an `M`-edge graph: first an
arbitrary remainder outside the link layer, then exactly the number of
ambient pairs needed to reach size `M`. -/
def coordinateLayerDecompositions (n M : ℕ) (Z : Edge n)
    (x y : Vertex n) :
    Finset (Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)) :=
  ((coordinateOutsideLayer n Z x y).powerset.filter fun R ↦
      R.card ≤ M).sigma fun R ↦
    (coordinateAmbientPairs n Z y).powersetCard (M - R.card)

@[simp] lemma mem_coordinateLayerDecompositions {n M : ℕ}
    {Z : Edge n} {x y : Vertex n}
    {p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)} :
    p ∈ coordinateLayerDecompositions n M Z x y ↔
      p.1 ⊆ coordinateOutsideLayer n Z x y ∧ p.1.card ≤ M ∧
        p.2 ⊆ coordinateAmbientPairs n Z y ∧
        p.2.card = M - p.1.card := by
  rcases p with ⟨R, L⟩
  simp [coordinateLayerDecompositions, and_assoc]

/-- Reassemble a coordinate-layer decomposition. -/
def assembleCoordinateLayer {n : ℕ}
    (x : Vertex n)
    (p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)) :
    Finset (Edge n) :=
  p.1 ∪ p.2.image fun S ↦ insert x S

lemma image_linkPairs_subset_linkLayer {n : ℕ}
    {L : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hL : L ⊆ coordinateAmbientPairs n Z y) :
    L.image (fun S ↦ insert x S) ⊆
      coordinateLinkLayer n Z x y := by
  intro A hA
  rcases Finset.mem_image.mp hA with ⟨S, hSL, rfl⟩
  exact mem_coordinateLinkLayer.mpr ⟨S, hL hSL, rfl⟩

lemma outsideLayer_disjoint_linkImage {n : ℕ}
    {R L : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hR : R ⊆ coordinateOutsideLayer n Z x y)
    (hL : L ⊆ coordinateAmbientPairs n Z y) :
    Disjoint R (L.image fun S ↦ insert x S) := by
  rw [Finset.disjoint_left]
  intro A hAR hAI
  have hRout := hR hAR
  have hIlayer := image_linkPairs_subset_linkLayer hL hAI
  exact (Finset.mem_sdiff.mp hRout).2 hIlayer

lemma card_image_insert_linkPairs {n : ℕ}
    {L : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hx : x ∈ Z) (hL : L ⊆ coordinateAmbientPairs n Z y) :
    (L.image fun S ↦ insert x S).card = L.card := by
  apply Finset.card_image_iff.mpr
  intro S hSL T hTL hEq
  exact insert_x_injectiveOn_coordinateAmbientPairs hx
    (hL hSL) (hL hTL) hEq

lemma assembleCoordinateLayer_mapsTo_sample {n M : ℕ}
    {Z : Edge n} {x y : Vertex n}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z) :
    Set.MapsTo (assembleCoordinateLayer x)
      (↑(coordinateLayerDecompositions n M Z x y) :
        Set (Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)))
      (↑(sample n M) : Set (Finset (Edge n))) := by
  rintro ⟨R, L⟩ hRL
  change (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
    Finset (Edge n)) ∈ coordinateLayerDecompositions n M Z x y at hRL
  rcases mem_coordinateLayerDecompositions.mp hRL with
    ⟨hR, hRM, hL, hLcard⟩
  apply mem_sample.mpr
  constructor
  · apply Finset.union_subset
    · exact fun A hAR ↦ (Finset.mem_sdiff.mp (hR hAR)).1
    · exact (image_linkPairs_subset_linkLayer hL).trans
        (coordinateLinkLayer_subset_allEdges hZ hx)
  · unfold assembleCoordinateLayer
    rw [Finset.card_union_of_disjoint
        (outsideLayer_disjoint_linkImage hR hL),
      card_image_insert_linkPairs hx hL, hLcard]
    omega

lemma assembleCoordinateLayer_injectiveOn {n M : ℕ}
    {Z : Edge n} {x y : Vertex n} (hx : x ∈ Z) :
    Set.InjOn (assembleCoordinateLayer x)
      (↑(coordinateLayerDecompositions n M Z x y) :
        Set (Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n))) := by
  rintro ⟨R, L⟩ hRL ⟨Q, T⟩ hQT heq
  change (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
    Finset (Edge n)) ∈ coordinateLayerDecompositions n M Z x y at hRL
  change (⟨Q, T⟩ : Sigma fun _R : Finset (Edge n) ↦
    Finset (Edge n)) ∈ coordinateLayerDecompositions n M Z x y at hQT
  rcases mem_coordinateLayerDecompositions.mp hRL with
    ⟨hR, hRM, hL, hLcard⟩
  rcases mem_coordinateLayerDecompositions.mp hQT with
    ⟨hQ, hQM, hT, hTcard⟩
  change R ∪ L.image (fun S ↦ insert x S) =
    Q ∪ T.image (fun S ↦ insert x S) at heq
  have hRQ : R = Q := by
    apply Finset.Subset.antisymm
    · intro A hAR
      have hmem : A ∈ Q ∪ T.image (fun S ↦ insert x S) := by
        rw [← heq]
        exact Finset.mem_union_left _ hAR
      rcases Finset.mem_union.mp hmem with hAQ | hATI
      · exact hAQ
      · exact False.elim ((Finset.mem_sdiff.mp (hR hAR)).2
          (image_linkPairs_subset_linkLayer hT hATI))
    · intro A hAQ
      have hmem : A ∈ R ∪ L.image (fun S ↦ insert x S) := by
        rw [heq]
        exact Finset.mem_union_left _ hAQ
      rcases Finset.mem_union.mp hmem with hAR | hALI
      · exact hAR
      · exact False.elim ((Finset.mem_sdiff.mp (hQ hAQ)).2
          (image_linkPairs_subset_linkLayer hL hALI))
  subst Q
  have himage : L.image (fun S ↦ insert x S) =
      T.image (fun S ↦ insert x S) := by
    apply Finset.Subset.antisymm
    · intro A hALI
      have hmem : A ∈ R ∪ T.image (fun S ↦ insert x S) := by
        rw [← heq]
        exact Finset.mem_union_right _ hALI
      rcases Finset.mem_union.mp hmem with hAR | hATI
      · exact False.elim ((Finset.mem_sdiff.mp (hR hAR)).2
          (image_linkPairs_subset_linkLayer hL hALI))
      · exact hATI
    · intro A hATI
      have hmem : A ∈ R ∪ L.image (fun S ↦ insert x S) := by
        rw [heq]
        exact Finset.mem_union_right _ hATI
      rcases Finset.mem_union.mp hmem with hAR | hALI
      · exact False.elim ((Finset.mem_sdiff.mp (hR hAR)).2
          (image_linkPairs_subset_linkLayer hT hATI))
      · exact hALI
  have hLT : L = T := by
    apply Finset.Subset.antisymm
    · intro S hSL
      have hSI : insert x S ∈ T.image (fun U ↦ insert x U) := by
        rw [← himage]
        exact Finset.mem_image.mpr ⟨S, hSL, rfl⟩
      rcases Finset.mem_image.mp hSI with ⟨U, hUT, hUS⟩
      have hSU := insert_x_injectiveOn_coordinateAmbientPairs hx
        (hL hSL) (hT hUT) hUS.symm
      simpa [hSU] using hUT
    · intro S hST
      have hSI : insert x S ∈ L.image (fun U ↦ insert x U) := by
        rw [himage]
        exact Finset.mem_image.mpr ⟨S, hST, rfl⟩
      rcases Finset.mem_image.mp hSI with ⟨U, hUL, hUS⟩
      have hSU := insert_x_injectiveOn_coordinateAmbientPairs hx
        (hT hST) (hL hUL) hUS.symm
      simpa [hSU] using hUL
  subst T
  rfl

lemma assembleCoordinateLayer_surjective_sample {n M : ℕ}
    {Z : Edge n} {x y : Vertex n} (hx : x ∈ Z) :
    ∀ H ∈ sample n M, ∃ p ∈ coordinateLayerDecompositions n M Z x y,
      assembleCoordinateLayer x p = H := by
  intro H hH
  let K := coordinateLinkLayer n Z x y
  let R := H \ K
  let L := coordinateLinkPairs H Z x y
  have hHall := (mem_sample.mp hH).1
  have hHcard := (mem_sample.mp hH).2
  have hRout : R ⊆ coordinateOutsideLayer n Z x y := by
    intro A hAR
    rcases Finset.mem_sdiff.mp hAR with ⟨hAH, hAK⟩
    exact Finset.mem_sdiff.mpr ⟨hHall hAH, hAK⟩
  have hRH : R ⊆ H := Finset.sdiff_subset
  have hRM : R.card ≤ M := by
    rw [← hHcard]
    exact Finset.card_le_card hRH
  have hLambient : L ⊆ coordinateAmbientPairs n Z y := by
    intro S hSL
    rcases mem_coordinateLinkPairs.mp hSL with ⟨hScard, hSdisj, hSE⟩
    exact mem_coordinateAmbientPairs.mpr ⟨hScard, hSdisj⟩
  have hLcard : L.card = M - R.card := by
    have hpartition := Finset.sdiff_union_inter H K
    have hdisj : Disjoint (H \ K) (H ∩ K) := by
      rw [Finset.disjoint_left]
      intro A hAdiff hAinter
      exact (Finset.mem_sdiff.mp hAdiff).2 (Finset.mem_inter.mp hAinter).2
    have hcardPartition : (H \ K).card + (H ∩ K).card = H.card := by
      rw [← Finset.card_union_of_disjoint hdisj, hpartition]
    have hlinkInter : L.card = (H ∩ K).card := by
      exact card_coordinateLinkPairs_eq_inter_linkLayer hx
    dsimp [R, L, K]
    dsimp [R, L, K] at hcardPartition hlinkInter
    omega
  let p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n) := ⟨R, L⟩
  refine ⟨p, ?_, ?_⟩
  · exact mem_coordinateLayerDecompositions.mpr
      ⟨hRout, hRM, hLambient, hLcard⟩
  · change R ∪ L.image (fun S ↦ insert x S) = H
    rw [image_coordinateLinkPairs_eq_inter_linkLayer hx]
    exact Finset.sdiff_union_inter H K

lemma card_coordinateLayerDecompositions_eq_sample {n M : ℕ}
    {Z : Edge n} {x y : Vertex n}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z) :
    (coordinateLayerDecompositions n M Z x y).card =
      (sample n M).card := by
  apply Finset.card_bij (fun p _ ↦ assembleCoordinateLayer x p)
  · exact fun p hp ↦ assembleCoordinateLayer_mapsTo_sample hZ hx hp
  · exact fun p hp q hq heq ↦ assembleCoordinateLayer_injectiveOn hx hp hq heq
  · intro H hH
    rcases assembleCoordinateLayer_surjective_sample hx H hH with
      ⟨p, hp, rfl⟩
    exact ⟨p, hp, rfl⟩

lemma coordinateLinkPairs_assembleCoordinateLayer {n : ℕ}
    {R L : Finset (Edge n)} {Z : Edge n} {x y : Vertex n}
    (hx : x ∈ Z) (hR : R ⊆ coordinateOutsideLayer n Z x y)
    (hL : L ⊆ coordinateAmbientPairs n Z y) :
    coordinateLinkPairs
        (assembleCoordinateLayer x
          (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)))
        Z x y = L := by
  ext S
  constructor
  · intro hS
    rcases mem_coordinateLinkPairs.mp hS with
      ⟨hScard, hSdisj, hSedge⟩
    have hSambient : S ∈ coordinateAmbientPairs n Z y :=
      mem_coordinateAmbientPairs.mpr ⟨hScard, hSdisj⟩
    change insert x S ∈ R ∪ L.image (fun T ↦ insert x T) at hSedge
    rcases Finset.mem_union.mp hSedge with hSR | hSI
    · have hSlayer : insert x S ∈ coordinateLinkLayer n Z x y :=
        mem_coordinateLinkLayer.mpr ⟨S, hSambient, rfl⟩
      exact False.elim ((Finset.mem_sdiff.mp (hR hSR)).2 hSlayer)
    · rcases Finset.mem_image.mp hSI with ⟨T, hTL, hTS⟩
      have hST := insert_x_injectiveOn_coordinateAmbientPairs hx
        hSambient (hL hTL) hTS.symm
      simpa [hST] using hTL
  · intro hSL
    have hSambient := hL hSL
    rcases mem_coordinateAmbientPairs.mp hSambient with
      ⟨hScard, hSdisj⟩
    apply mem_coordinateLinkPairs.mpr
    refine ⟨hScard, hSdisj, ?_⟩
    exact Finset.mem_union_right R
      (Finset.mem_image.mpr ⟨S, hSL, rfl⟩)

/-- Globally low residual-weight triples. -/
def residualBadTriples (n : ℕ) (G : Finset (Edge n)) (a : ℝ) :
    Finset (Edge n) :=
  (allEdges n).filter fun U ↦
    ¬a ≤ (residualWeight n G U : ℝ)

/-- Low residual-weight pairs in the ambient layer indexed by `y`. -/
def coordinateResidualBadPairs (n : ℕ) (G : Finset (Edge n))
    (Z : Edge n) (y : Vertex n) (a : ℝ) : Finset (Edge n) :=
  (coordinateAmbientPairs n Z y).filter fun S ↦
    ¬a ≤ (residualWeight n G (insert y S) : ℝ)

@[simp] lemma mem_coordinateResidualBadPairs {n : ℕ}
    {G : Finset (Edge n)} {Z S : Edge n} {y : Vertex n} {a : ℝ} :
    S ∈ coordinateResidualBadPairs n G Z y a ↔
      S.card = 2 ∧ Disjoint S (insert y Z) ∧
        ¬a ≤ (residualWeight n G (insert y S) : ℝ) := by
  simp [coordinateResidualBadPairs, and_assoc]

lemma coordinateBadLinkPairs_assembleCoordinateLayer {n : ℕ}
    {R L : Finset (Edge n)} {Z : Edge n} {x y : Vertex n} {a : ℝ}
    (hx : x ∈ Z) (hR : R ⊆ coordinateOutsideLayer n Z x y)
    (hL : L ⊆ coordinateAmbientPairs n Z y) :
    coordinateBadLinkPairs n
        (assembleCoordinateLayer x
          (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)))
        Z x y a =
      L ∩ coordinateResidualBadPairs n (inducedAway R Z) Z y a := by
  have hlink := coordinateLinkPairs_assembleCoordinateLayer hx hR hL
  have hinduced :
      inducedAway
          (assembleCoordinateLayer x
            (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n))) Z =
        inducedAway R Z := by
    exact inducedAway_union_linkImage (R := R) hx hL
  ext S
  rw [coordinateBadLinkPairs, hlink, hinduced]
  simp only [Finset.mem_filter, Finset.mem_inter]
  constructor
  · rintro ⟨hSL, hbad⟩
    refine ⟨hSL, mem_coordinateResidualBadPairs.mpr ?_⟩
    rcases mem_coordinateAmbientPairs.mp (hL hSL) with
      ⟨hScard, hSdisj⟩
    exact ⟨hScard, hSdisj, hbad⟩
  · rintro ⟨hSL, hSbad⟩
    exact ⟨hSL, (mem_coordinateResidualBadPairs.mp hSbad).2.2⟩

/-- Fiberwise form of a bad conditional link sample. -/
def CoordinateFiberLinkTail {n : ℕ} (Z : Edge n) (y : Vertex n)
    (a : ℝ) (d D Q b : ℕ)
    (p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)) : Prop :=
  d ≤ p.2.card ∧ p.2.card ≤ D ∧
    (coordinateResidualBadPairs n (inducedAway p.1 Z) Z y a).card ≤ Q ∧
    b ≤ (p.2 ∩
      coordinateResidualBadPairs n (inducedAway p.1 Z) Z y a).card

/-- The corresponding event stated intrinsically for the assembled
hypergraph. -/
def CoordinateSampleLinkTail {n : ℕ} (Z : Edge n)
    (x y : Vertex n) (a : ℝ) (d D Q b : ℕ)
    (H : Finset (Edge n)) : Prop :=
  d ≤ (coordinateLinkPairs H Z x y).card ∧
    (coordinateLinkPairs H Z x y).card ≤ D ∧
    (coordinateResidualBadPairs n (inducedAway H Z) Z y a).card ≤ Q ∧
    b ≤ (coordinateBadLinkPairs n H Z x y a).card

lemma coordinateSampleLinkTail_assemble_iff {n M : ℕ}
    {Z : Edge n} {x y : Vertex n} {a : ℝ} {d D Q b : ℕ}
    (hx : x ∈ Z)
    {p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)}
    (hp : p ∈ coordinateLayerDecompositions n M Z x y) :
    CoordinateSampleLinkTail Z x y a d D Q b
        (assembleCoordinateLayer x p) ↔
      CoordinateFiberLinkTail Z y a d D Q b p := by
  rcases p with ⟨R, L⟩
  rcases mem_coordinateLayerDecompositions.mp hp with
    ⟨hR, hRM, hL, hLcard⟩
  have hlink := coordinateLinkPairs_assembleCoordinateLayer hx hR hL
  have hbad := coordinateBadLinkPairs_assembleCoordinateLayer
    (a := a) hx hR hL
  have hinduced :
      inducedAway
          (assembleCoordinateLayer x
            (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n))) Z =
        inducedAway R Z := by
    exact inducedAway_union_linkImage (R := R) hx hL
  simp only [CoordinateSampleLinkTail, CoordinateFiberLinkTail,
    hlink, hbad, hinduced]

/-- All bad pair incidences `(y,S)` used in the averaging argument. -/
def coordinateResidualBadPairIncidences (n : ℕ)
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    Finset (Sigma fun _y : Vertex n ↦ Edge n) :=
  (Finset.univ : Finset (Vertex n)).sigma fun y ↦
    coordinateResidualBadPairs n G Z y a

/-- A bad pair incidence remembers its completed triple and distinguished
incoming vertex. -/
def completeResidualBadPair {n : ℕ}
    (p : Sigma fun _y : Vertex n ↦ Edge n) :
    Sigma fun _U : Edge n ↦ Vertex n :=
  ⟨insert p.1 p.2, p.1⟩

lemma completeResidualBadPair_mapsTo {n : ℕ}
    {G : Finset (Edge n)} {Z : Edge n} {a : ℝ} :
    Set.MapsTo completeResidualBadPair
      (↑(coordinateResidualBadPairIncidences n G Z a) :
        Set (Sigma fun _y : Vertex n ↦ Edge n))
      (↑((residualBadTriples n G a).sigma fun U ↦ U) :
        Set (Sigma fun _U : Edge n ↦ Vertex n)) := by
  rintro ⟨y, S⟩ hys
  change (⟨y, S⟩ : Sigma fun _y : Vertex n ↦ Edge n) ∈
    coordinateResidualBadPairIncidences n G Z a at hys
  rw [coordinateResidualBadPairIncidences, Finset.mem_sigma] at hys
  rcases hys with ⟨_hy, hSbad⟩
  rcases mem_coordinateResidualBadPairs.mp hSbad with
    ⟨hScard, hSdisj, hweight⟩
  have hyS : y ∉ S := by
    intro hyS
    exact Finset.disjoint_left.mp hSdisj hyS
      (Finset.mem_insert_self y Z)
  change (⟨insert y S, y⟩ : Sigma fun _U : Edge n ↦ Vertex n) ∈
    (residualBadTriples n G a).sigma fun U ↦ U
  rw [Finset.mem_sigma]
  refine ⟨?_, Finset.mem_insert_self y S⟩
  apply Finset.mem_filter.mpr
  refine ⟨mem_allEdges.mpr ?_, hweight⟩
  rw [Finset.card_insert_of_notMem hyS, hScard]

lemma completeResidualBadPair_injectiveOn {n : ℕ}
    {G : Finset (Edge n)} {Z : Edge n} {a : ℝ} :
    Set.InjOn completeResidualBadPair
      (↑(coordinateResidualBadPairIncidences n G Z a) :
        Set (Sigma fun _y : Vertex n ↦ Edge n)) := by
  rintro ⟨y, S⟩ hys ⟨z, T⟩ hzt heq
  have hfirst : insert y S = insert z T :=
    congrArg Sigma.fst heq
  have hyz : y = z := congrArg Sigma.snd heq
  subst z
  have hSbad : S ∈ coordinateResidualBadPairs n G Z y a := by
    change (⟨y, S⟩ : Sigma fun _y : Vertex n ↦ Edge n) ∈
      coordinateResidualBadPairIncidences n G Z a at hys
    rw [coordinateResidualBadPairIncidences, Finset.mem_sigma] at hys
    exact hys.2
  have hTbad : T ∈ coordinateResidualBadPairs n G Z y a := by
    change (⟨y, T⟩ : Sigma fun _y : Vertex n ↦ Edge n) ∈
      coordinateResidualBadPairIncidences n G Z a at hzt
    rw [coordinateResidualBadPairIncidences, Finset.mem_sigma] at hzt
    exact hzt.2
  have hyS : y ∉ S := by
    intro hyS
    exact Finset.disjoint_left.mp
      (mem_coordinateResidualBadPairs.mp hSbad).2.1 hyS
      (Finset.mem_insert_self y Z)
  have hyT : y ∉ T := by
    intro hyT
    exact Finset.disjoint_left.mp
      (mem_coordinateResidualBadPairs.mp hTbad).2.1 hyT
      (Finset.mem_insert_self y Z)
  have hST : S = T := by
    simpa only [Finset.erase_insert hyS, Finset.erase_insert hyT] using
      congrArg (fun U : Edge n ↦ U.erase y) hfirst
  subst T
  rfl

lemma card_coordinateResidualBadPairIncidences (n : ℕ)
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    (coordinateResidualBadPairIncidences n G Z a).card =
      ∑ y : Vertex n, (coordinateResidualBadPairs n G Z y a).card := by
  rw [coordinateResidualBadPairIncidences, Finset.card_sigma]

lemma card_badTripleVertexPairs (n : ℕ) (G : Finset (Edge n))
    (a : ℝ) :
    ((residualBadTriples n G a).sigma fun U ↦ U).card =
      3 * (residualBadTriples n G a).card := by
  rw [Finset.card_sigma]
  calc
    ∑ U ∈ residualBadTriples n G a, U.card =
        ∑ _U ∈ residualBadTriples n G a, 3 := by
      apply Finset.sum_congr rfl
      intro U hU
      exact mem_allEdges.mp (Finset.mem_filter.mp hU).1
    _ = 3 * (residualBadTriples n G a).card := by simp [Nat.mul_comm]

/-- Each bad residual triple contributes at most its three choices of
distinguished incoming vertex. -/
lemma sum_card_coordinateResidualBadPairs_le (n : ℕ)
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    (∑ y : Vertex n,
        (coordinateResidualBadPairs n G Z y a).card) ≤
      3 * (residualBadTriples n G a).card := by
  rw [← card_coordinateResidualBadPairIncidences,
    ← card_badTripleVertexPairs]
  exact Finset.card_le_card_of_injOn completeResidualBadPair
    completeResidualBadPair_mapsTo completeResidualBadPair_injectiveOn

/-- Markov averaging over the incoming vertex: if at most `B` triples are
globally bad, fewer than `3B/b` vertices can have at least `b` bad pairs.
The division-free form is more convenient for later integer budgets. -/
lemma card_vertices_with_many_residualBadPairs_mul_le {n B b : ℕ}
    {G : Finset (Edge n)} {Z : Edge n} {a : ℝ}
    (hB : (residualBadTriples n G a).card ≤ B) :
    ((Finset.univ.filter fun y : Vertex n ↦
        b ≤ (coordinateResidualBadPairs n G Z y a).card).card) * b ≤
      3 * B := by
  let Y := Finset.univ.filter fun y : Vertex n ↦
    b ≤ (coordinateResidualBadPairs n G Z y a).card
  have hpoint : ∀ y ∈ Y, b ≤
      (coordinateResidualBadPairs n G Z y a).card := by
    intro y hy
    exact (Finset.mem_filter.mp hy).2
  have hsub : Y ⊆ (Finset.univ : Finset (Vertex n)) :=
    Finset.filter_subset _ _
  calc
    Y.card * b = ∑ _y ∈ Y, b := by simp
    _ ≤ ∑ y ∈ Y, (coordinateResidualBadPairs n G Z y a).card :=
      Finset.sum_le_sum hpoint
    _ ≤ ∑ y : Vertex n,
        (coordinateResidualBadPairs n G Z y a).card := by
      exact Finset.sum_le_sum_of_subset_of_nonneg hsub
        (fun _ _ _ ↦ Nat.zero_le _)
    _ ≤ 3 * (residualBadTriples n G a).card :=
      sum_card_coordinateResidualBadPairs_le n G Z a
    _ ≤ 3 * B := Nat.mul_le_mul_left 3 hB

/-- If the exposed link contains at least `d` pairs and at most `b` of
them have residual weight below `a`, the coordinate replacement inherits
at least `(d-b)a` completion weight. -/
lemma coordinateCompletionWeight_lower {n d b : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x y : Vertex n} {a : ℝ}
    (hn : 2 ≤ n) (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hy : y ∉ Z) (ha : 0 ≤ a)
    (hlink : d ≤ (coordinateLinkPairs H Z x y).card)
    (hbad : (coordinateBadLinkPairs n H Z x y a).card ≤ b) :
    (((d - b : ℕ) : ℝ) * a) ≤
      completionWeight H (replaceVertex Z x y) := by
  let L := coordinateLinkPairs H Z x y
  let good := L.filter fun S ↦
    a ≤ (residualWeight n (inducedAway H Z) (insert y S) : ℝ)
  let bad := L.filter fun S ↦
    ¬a ≤ (residualWeight n (inducedAway H Z) (insert y S) : ℝ)
  have hsplit : good.card + bad.card = L.card := by
    exact Finset.card_filter_add_card_filter_not
      (s := L) (p := fun S ↦
        a ≤ (residualWeight n (inducedAway H Z) (insert y S) : ℝ))
  have hbad' : bad.card ≤ b := by
    simpa [bad, L, coordinateBadLinkPairs] using hbad
  have hlink' : d ≤ L.card := by simpa [L] using hlink
  have hgood : d - b ≤ good.card := by omega
  have hsumNonneg : ∀ S ∈ L,
      0 ≤ (residualWeight n (inducedAway H Z) (insert y S) : ℝ) := by
    intro S hS
    positivity
  have hsumNat := sum_residualWeight_coordinateLink_le_completionWeight
    (H := H) hn hZ hx hy
  have hsum :
      ∑ S ∈ L,
          (residualWeight n (inducedAway H Z) (insert y S) : ℝ) ≤
        (completionWeight H (replaceVertex Z x y) : ℝ) := by
    exact_mod_cast hsumNat
  calc
    (((d - b : ℕ) : ℝ) * a) ≤ (good.card : ℝ) * a := by
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast hgood) ha
    _ = ∑ _S ∈ good, a := by simp
    _ ≤ ∑ S ∈ good,
        (residualWeight n (inducedAway H Z) (insert y S) : ℝ) := by
      apply Finset.sum_le_sum
      intro S hS
      exact (Finset.mem_filter.mp hS).2
    _ ≤ ∑ S ∈ L,
        (residualWeight n (inducedAway H Z) (insert y S) : ℝ) := by
      exact Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.filter_subset _ _) (fun S hSL _ ↦ hsumNonneg S hSL)
    _ ≤ (completionWeight H (replaceVertex Z x y) : ℝ) := hsum

/-- Incoming vertices for which either the exposed link is too small or too
many of its residual weights fall below `a`. -/
def coordinateLinkFailureVertices (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) (x : Vertex n) (d b : ℕ) (a : ℝ) :
    Finset (Vertex n) :=
  (Finset.univ.filter fun y ↦ y ∉ Z ∧
    ((coordinateLinkPairs H Z x y).card < d ∨
      b < (coordinateBadLinkPairs n H Z x y a).card))

/-- Once the deterministic link-sum budget reaches `c w(Z)`, every bad
coordinate replacement must be a link-sampling failure. -/
lemma coordinateBadVertices_subset_linkFailure {n d b : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x : Vertex n}
    {a c : ℝ} (hn : 2 ≤ n) (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (ha : 0 ≤ a)
    (hbudget : c * (completionWeight H Z : ℝ) ≤
      (((d - b : ℕ) : ℝ) * a)) :
    coordinateBadVertices H Z x c ⊆
      coordinateLinkFailureVertices n H Z x d b a := by
  intro y hybad
  rcases Finset.mem_filter.mp hybad with ⟨_hyuniv, hyZ, hyweight⟩
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ y, hyZ, ?_⟩
  by_contra hfail
  push_neg at hfail
  have hlower := coordinateCompletionWeight_lower hn hZ hx hyZ ha
    hfail.1 hfail.2
  exact hyweight (hbudget.trans hlower)

lemma coordinateBadVertices_card_le_linkFailure {n d b e : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x : Vertex n}
    {a c : ℝ} (hn : 2 ≤ n) (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (ha : 0 ≤ a)
    (hbudget : c * (completionWeight H Z : ℝ) ≤
      (((d - b : ℕ) : ℝ) * a))
    (hfailure :
      (coordinateLinkFailureVertices n H Z x d b a).card ≤ e) :
    (coordinateBadVertices H Z x c).card ≤ e :=
  (Finset.card_le_card
    (coordinateBadVertices_subset_linkFailure hn hZ hx ha hbudget)).trans
      hfailure

/-- A uniform link-sampling estimate above a weight floor implies the
coordinate-transfer property consumed by the three-step domination lemma. -/
lemma coordinateTransferAbove_of_linkFailures {n d b e : ℕ}
    {H : Finset (Edge n)} {s a c : ℝ} (hn : 2 ≤ n) (ha : 0 ≤ a)
    (hfailure : ∀ Z ∈ allEdges n,
      s ≤ (completionWeight H Z : ℝ) →
        ∀ x ∈ Z,
          (coordinateLinkFailureVertices n H Z x d b a).card ≤ e)
    (hbudget : ∀ Z ∈ allEdges n,
      s ≤ (completionWeight H Z : ℝ) →
        c * (completionWeight H Z : ℝ) ≤
          (((d - b : ℕ) : ℝ) * a)) :
    CoordinateTransferAbove n H s c e := by
  intro Z hZ hs x hx
  exact coordinateBadVertices_card_le_linkFailure hn hZ hx ha
    (hbudget Z hZ hs) (hfailure Z hZ hs x hx)

/-- Global spreading and global domination force every individual triple
weight to be bounded by a constant multiple of the target weight.  This is
the finite intersection argument at the end of Kahn's structural proof. -/
lemma completionWeight_bound_of_global_spread {n : ℕ}
    (H : Finset (Edge n)) (δ η q c : ℝ) (hn : 0 < n)
    (hqη : η < q) (hspread : GlobalWeightSpread n H δ η)
    (hdom : GloballyDominatedWeights n H q c) {Z : Edge n}
    (hZ : Z ∈ allEdges n) :
    c * (completionWeight H Z : ℝ) ≤
      (1 + δ) * matchingWeightTarget n H := by
  let K := allEdges n
  let D := K.filter fun U ↦
    c * (completionWeight H Z : ℝ) ≤ completionWeight H U
  let B := K.filter fun U ↦ ¬CompletionWeightClose H δ U
  have hKnonempty : K.Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i, mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hKpos : (0 : ℝ) < K.card := by
    exact_mod_cast Finset.card_pos.mpr hKnonempty
  have hDcard : q * (K.card : ℝ) ≤ (D.card : ℝ) := by
    simpa [K, D] using hdom Z hZ
  have hBcard : (B.card : ℝ) ≤ η * (K.card : ℝ) := by
    unfold GlobalWeightSpread at hspread
    simpa [K, B] using hspread
  have hinter : ∃ U, U ∈ K ∧
      c * (completionWeight H Z : ℝ) ≤ completionWeight H U ∧
      CompletionWeightClose H δ U := by
    by_contra hnone
    have hsub : D ⊆ B := by
      intro U hUD
      rcases Finset.mem_filter.mp hUD with ⟨hUK, hweight⟩
      apply Finset.mem_filter.mpr
      refine ⟨hUK, ?_⟩
      intro hclose
      exact hnone ⟨U, hUK, hweight, hclose⟩
    have hcardNat : D.card ≤ B.card := Finset.card_le_card hsub
    have hcard : (D.card : ℝ) ≤ B.card := by exact_mod_cast hcardNat
    have hηq : η * (K.card : ℝ) < q * K.card :=
      mul_lt_mul_of_pos_right hqη hKpos
    linarith
  obtain ⟨U, hUK, hZU, hUclose⟩ := hinter
  have htarget : 0 ≤ matchingWeightTarget n H := by
    unfold matchingWeightTarget
    positivity
  have hUupper : (completionWeight H U : ℝ) ≤
      (1 + δ) * matchingWeightTarget n H := by
    have habs := (le_abs_self
      ((completionWeight H U : ℝ) - matchingWeightTarget n H))
    have hclose := hUclose
    unfold CompletionWeightClose at hclose
    nlinarith
  exact hZU.trans hUupper

/-- The one-sided version of the finite intersection argument: a positive
density of triples dominating `Z` must meet the large set of triples whose
completion weight is at most `L` times the target. -/
lemma completionWeight_bound_of_global_upper_spread {n : ℕ}
    (H : Finset (Edge n)) (L eta q c : ℝ) (hn : 0 < n)
    (hqeta : eta < q) (hspread : GlobalUpperWeightSpread n H L eta)
    (hdom : GloballyDominatedWeights n H q c) {Z : Edge n}
    (hZ : Z ∈ allEdges n) :
    c * (completionWeight H Z : ℝ) ≤ L * matchingWeightTarget n H := by
  let K := allEdges n
  let D := K.filter fun U ↦
    c * (completionWeight H Z : ℝ) ≤ completionWeight H U
  let B := K.filter fun U ↦ ¬CompletionWeightUpperBound H L U
  have hKnonempty : K.Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i, mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hKpos : (0 : ℝ) < K.card := by
    exact_mod_cast Finset.card_pos.mpr hKnonempty
  have hDcard : q * (K.card : ℝ) ≤ (D.card : ℝ) := by
    simpa [K, D] using hdom Z hZ
  have hBcard : (B.card : ℝ) ≤ eta * (K.card : ℝ) := by
    unfold GlobalUpperWeightSpread at hspread
    simpa [K, B] using hspread
  by_contra hbound
  have hsub : D ⊆ B := by
    intro U hUD
    rcases Finset.mem_filter.mp hUD with ⟨hUK, hweight⟩
    apply Finset.mem_filter.mpr
    refine ⟨hUK, ?_⟩
    intro hupper
    exact hbound (hweight.trans hupper)
  have hcardNat : D.card ≤ B.card := Finset.card_le_card hsub
  have hcard : (D.card : ℝ) ≤ B.card := by exact_mod_cast hcardNat
  have hstrict : eta * (K.card : ℝ) < q * K.card :=
    mul_lt_mul_of_pos_right hqeta hKpos
  linarith

/-- One-sided global spreading need only intersect the descendants of a
single maximum-weight triple. -/
lemma completionWeight_bound_of_global_upper_spread_max {n : ℕ}
    (H : Finset (Edge n)) (L eta q c : ℝ) (hn : 0 < n)
    (hc0 : 0 ≤ c) (hqeta : eta < q)
    (hspread : GlobalUpperWeightSpread n H L eta)
    (hdom : MaximumWeightDominated n H q c) {Z : Edge n}
    (hZ : Z ∈ allEdges n) :
    c * (completionWeight H Z : ℝ) ≤
      L * matchingWeightTarget n H := by
  obtain ⟨Z₀, hZ₀, hmax, hdesc⟩ := hdom
  let K := allEdges n
  let D := K.filter fun U ↦
    c * (completionWeight H Z₀ : ℝ) ≤ completionWeight H U
  let B := K.filter fun U ↦ ¬CompletionWeightUpperBound H L U
  have hKnonempty : K.Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i, mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hKpos : (0 : ℝ) < K.card := by
    exact_mod_cast Finset.card_pos.mpr hKnonempty
  have hDcard : q * (K.card : ℝ) ≤ (D.card : ℝ) := by
    simpa [K, D] using hdesc
  have hBcard : (B.card : ℝ) ≤ eta * (K.card : ℝ) := by
    unfold GlobalUpperWeightSpread at hspread
    simpa [K, B] using hspread
  have hinter : ∃ U, U ∈ K ∧
      c * (completionWeight H Z₀ : ℝ) ≤ completionWeight H U ∧
      CompletionWeightUpperBound H L U := by
    by_contra hnone
    have hsub : D ⊆ B := by
      intro U hUD
      rcases Finset.mem_filter.mp hUD with ⟨hUK, hweight⟩
      apply Finset.mem_filter.mpr
      refine ⟨hUK, ?_⟩
      intro hupper
      exact hnone ⟨U, hUK, hweight, hupper⟩
    have hcardNat : D.card ≤ B.card := Finset.card_le_card hsub
    have hcard : (D.card : ℝ) ≤ B.card := by exact_mod_cast hcardNat
    have hstrict : eta * (K.card : ℝ) < q * K.card :=
      mul_lt_mul_of_pos_right hqeta hKpos
    linarith
  obtain ⟨U, _hUK, hZ₀U, hUupper⟩ := hinter
  have hZZ₀Nat := hmax Z hZ
  have hZZ₀ : (completionWeight H Z : ℝ) ≤ completionWeight H Z₀ := by
    exact_mod_cast hZZ₀Nat
  exact (mul_le_mul_of_nonneg_left hZZ₀ hc0).trans
    (hZ₀U.trans hUupper)

lemma completionWeightClose_present_iff {n : ℕ}
    (H : Finset (Edge n)) {A : Edge n} (hA : A ∈ H) (δ : ℝ) :
    CompletionWeightClose H δ A ↔
      |(matchingWeight H A : ℝ) - matchingWeightTarget n H| ≤
        δ * matchingWeightTarget n H := by
  simp [CompletionWeightClose,
    completionWeight_eq_matchingWeight_of_mem H hA]

lemma perfectMatchings_erase (n : ℕ) (H : Finset (Edge n)) (A : Edge n) :
    perfectMatchings n (H.erase A) =
      (perfectMatchings n H).filter (fun F ↦ A ∉ F) := by
  ext F
  simp only [mem_perfectMatchings, Finset.mem_filter]
  constructor
  · rintro ⟨hFsub, hcard, hmatch⟩
    refine ⟨⟨?_, hcard, hmatch⟩, ?_⟩
    · exact hFsub.trans (Finset.erase_subset A H)
    · intro hAF
      exact (Finset.mem_erase.mp (hFsub hAF)).1 rfl
  · rintro ⟨⟨hFsub, hcard, hmatch⟩, hAF⟩
    exact ⟨fun B hBF ↦ Finset.mem_erase.mpr ⟨by
      intro hBA
      subst B
      exact hAF hBF, hFsub hBF⟩, hcard, hmatch⟩

/-- Deleting one edge removes exactly the perfect matchings counted by its
matching weight. -/
lemma card_perfectMatchings_erase_add_weight (n : ℕ)
    (H : Finset (Edge n)) (A : Edge n) :
    (perfectMatchings n (H.erase A)).card + matchingWeight H A =
      (perfectMatchings n H).card := by
  rw [perfectMatchings_erase, matchingWeight]
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := perfectMatchings n H) (p := fun F ↦ A ∉ F)
  simpa only [not_not] using hsplit

/-- The fraction `ξ` of perfect matchings destroyed when an edge is deleted. -/
def matchingFraction {n : ℕ} (H : Finset (Edge n)) (A : Edge n) : ℝ :=
  matchingWeight H A / (perfectMatchings n H).card

lemma card_perfectMatchings_erase_ratio (n : ℕ) (H : Finset (Edge n))
    (A : Edge n) (hΦ : (perfectMatchings n H).card ≠ 0) :
    ((perfectMatchings n (H.erase A)).card : ℝ) /
        (perfectMatchings n H).card =
      1 - matchingFraction H A := by
  have hcount := card_perfectMatchings_erase_add_weight n H A
  unfold matchingFraction
  have hΦR : ((perfectMatchings n H).card : ℝ) ≠ 0 := by exact_mod_cast hΦ
  have hcountR :
      ((perfectMatchings n (H.erase A)).card : ℝ) + matchingWeight H A =
        (perfectMatchings n H).card := by
    exact_mod_cast hcount
  field_simp [hΦR]
  linarith

lemma matchingWeight_le_card_perfectMatchings {n : ℕ}
    (H : Finset (Edge n)) (A : Edge n) :
    matchingWeight H A ≤ (perfectMatchings n H).card := by
  unfold matchingWeight
  exact Finset.card_le_card (Finset.filter_subset _ _)

lemma matchingFraction_nonneg {n : ℕ} (H : Finset (Edge n)) (A : Edge n) :
    0 ≤ matchingFraction H A := by
  unfold matchingFraction
  positivity

lemma matchingFraction_le_one {n : ℕ} (H : Finset (Edge n)) (A : Edge n) :
    matchingFraction H A ≤ 1 := by
  unfold matchingFraction
  by_cases hΦ : (perfectMatchings n H).card = 0
  · simp [hΦ]
  · apply (div_le_one (by exact_mod_cast Nat.pos_of_ne_zero hΦ)).2
    exact_mod_cast matchingWeight_le_card_perfectMatchings H A

/-- Matching fractions incident to a vertex form a probability vector
whenever the hypergraph has a perfect matching. -/
lemma sum_incident_matchingFraction (n : ℕ) (H : Finset (Edge n))
    (hH : H ⊆ allEdges n) (v : Vertex n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    ∑ A ∈ H.filter (fun A ↦ v ∈ A), matchingFraction H A = 1 := by
  unfold matchingFraction
  rw [← Finset.sum_div]
  have hsumR :
      ∑ A ∈ H.filter (fun A ↦ v ∈ A), (matchingWeight H A : ℝ) =
        ((perfectMatchings n H).card : ℝ) := by
    exact_mod_cast sum_incident_matchingWeight n H hH v
  rw [hsumR]
  exact div_self (by exact_mod_cast hΦ)

/-- Natural-log entropy of a finite mass function.  Since `Real.log 0 = 0`,
zero-mass terms vanish under Mathlib's totalized logarithm. -/
def finiteEntropy {α : Type*} (s : Finset α) (p : α → ℝ) : ℝ :=
  ∑ x ∈ s, -(p x) * Real.log (p x)

/-- Entropy of the edge containing a fixed vertex in a uniformly random
perfect matching. -/
def localMatchingEntropy {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) : ℝ :=
  finiteEntropy (H.filter fun A ↦ v ∈ A) (matchingFraction H)

/-- A probability vector supported on a nonempty finite set has entropy at
most the logarithm of the support size. -/
lemma finiteEntropy_le_log_card {α : Type*} (s : Finset α) (p : α → ℝ)
    (hs : s.Nonempty) (hp : ∀ x ∈ s, 0 ≤ p x)
    (hsum : ∑ x ∈ s, p x = 1) :
    finiteEntropy s p ≤ Real.log (s.card : ℝ) := by
  let k : ℝ := s.card
  have hk : 0 < k := by
    dsimp [k]
    exact_mod_cast Finset.card_pos.mpr hs
  have hpoint : ∀ x ∈ s,
      -(p x) * Real.log (p x) - p x * Real.log k ≤ 1 / k - p x := by
    intro x hx
    by_cases hpx : p x = 0
    · simp [hpx, hk.le]
    · have hpxpos : 0 < p x := lt_of_le_of_ne (hp x hx) (Ne.symm hpx)
      have hkpx : 0 < k * p x := mul_pos hk hpxpos
      have hlog0 := Real.log_le_sub_one_of_pos (one_div_pos.mpr hkpx)
      have hlog :
          -(Real.log k + Real.log (p x)) ≤ (k * p x)⁻¹ - 1 := by
        rw [one_div, Real.log_inv, Real.log_mul hk.ne' hpx] at hlog0
        exact hlog0
      calc
        -(p x) * Real.log (p x) - p x * Real.log k =
            p x * (-(Real.log k + Real.log (p x))) := by ring
        _ ≤ p x * ((k * p x)⁻¹ - 1) :=
          mul_le_mul_of_nonneg_left hlog hpxpos.le
        _ = 1 / k - p x := by
          field_simp [hk.ne', hpx]
  have hsumineq :
      (∑ x ∈ s,
        (-(p x) * Real.log (p x) - p x * Real.log k)) ≤
        ∑ x ∈ s, (1 / k - p x) :=
    Finset.sum_le_sum hpoint
  have hleft :
      (∑ x ∈ s,
        (-(p x) * Real.log (p x) - p x * Real.log k)) =
        finiteEntropy s p - Real.log k := by
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hsum]
    simp [finiteEntropy]
  have hright : (∑ x ∈ s, (1 / k - p x)) = 0 := by
    rw [Finset.sum_sub_distrib, Finset.sum_const, hsum]
    simp only [nsmul_eq_mul]
    dsimp [k]
    field_simp [hk.ne']
    norm_num
  rw [hleft, hright] at hsumineq
  linarith

/-- Entropy deficit relative to the uniform distribution on `s`. -/
def finiteEntropyDefect {α : Type*} (s : Finset α) (p : α → ℝ) : ℝ :=
  Real.log (s.card : ℝ) - finiteEntropy s p

/-- The entropy deficit is the finite relative-entropy sum
`∑ p(x) log (|s| p(x))`. -/
lemma finiteEntropyDefect_eq_sum {α : Type*} (s : Finset α)
    (p : α → ℝ) (hs : s.Nonempty) (hp : ∀ x ∈ s, 0 ≤ p x)
    (hsum : ∑ x ∈ s, p x = 1) :
    finiteEntropyDefect s p =
      ∑ x ∈ s, p x * Real.log ((s.card : ℝ) * p x) := by
  let k : ℝ := s.card
  have hk : k ≠ 0 := by
    dsimp [k]
    exact_mod_cast (Finset.card_ne_zero.mpr hs)
  have hpoint : ∀ x ∈ s,
      p x * Real.log (k * p x) =
        p x * Real.log k + p x * Real.log (p x) := by
    intro x hx
    by_cases hpx : p x = 0
    · simp [hpx]
    · rw [Real.log_mul hk hpx]
      ring
  change Real.log k - (∑ x ∈ s, -(p x) * Real.log (p x)) =
    ∑ x ∈ s, p x * Real.log (k * p x)
  rw [Finset.sum_congr rfl hpoint]
  rw [Finset.sum_add_distrib, ← Finset.sum_mul, hsum]
  simpa only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add, one_mul]

lemma finiteEntropyDefect_nonneg {α : Type*} (s : Finset α)
    (p : α → ℝ) (hs : s.Nonempty) (hp : ∀ x ∈ s, 0 ≤ p x)
    (hsum : ∑ x ∈ s, p x = 1) :
    0 ≤ finiteEntropyDefect s p := by
  unfold finiteEntropyDefect
  exact sub_nonneg.mpr (finiteEntropy_le_log_card s p hs hp hsum)

/-- Scalar inequality underlying the finite Pinsker estimate. -/
lemma sq_div_le_mul_log_sub_add_one {x : ℝ} (hx : 0 ≤ x) :
    (x - 1)^2 / (2 * (x + 1)) ≤ x * Real.log x - x + 1 := by
  by_cases hxzero : x = 0
  · simp [hxzero]
    norm_num
  · have hxpos : 0 < x := lt_of_le_of_ne hx (Ne.symm hxzero)
    let s := Real.sqrt x
    have hspos : 0 < s := Real.sqrt_pos.2 hxpos
    have hs2 : s^2 = x := by
      dsimp [s]
      exact Real.sq_sqrt hx
    have hlogInv := Real.log_le_sub_one_of_pos (inv_pos.mpr hspos)
    rw [Real.log_inv, Real.log_sqrt hx] at hlogInv
    have hlogLower : 2 * (1 - s⁻¹) ≤ Real.log x := by
      linarith
    have hmul := mul_le_mul_of_nonneg_left hlogLower hx
    have hxs : x * s⁻¹ = s := by
      rw [← hs2]
      field_simp [hspos.ne']
    have hroot : (s - 1)^2 ≤ x * Real.log x - x + 1 := by
      have hleft : x * (2 * (1 - s⁻¹)) = 2 * x - 2 * s := by
        calc
          x * (2 * (1 - s⁻¹)) = 2 * x - 2 * (x * s⁻¹) := by ring
          _ = 2 * x - 2 * s := by rw [hxs]
      rw [hleft] at hmul
      nlinarith
    have hden : 0 < 2 * (x + 1) := by positivity
    have hcompare :
        (x - 1)^2 / (2 * (x + 1)) ≤ (s - 1)^2 := by
      apply (div_le_iff₀ hden).2
      nlinarith [sq_nonneg (s - 1)]
    exact hcompare.trans hroot

/-- `L¹` distance of a finite mass function from the uniform law. -/
def finiteUniformL1 {α : Type*} (s : Finset α) (p : α → ℝ) : ℝ :=
  ∑ x ∈ s, |p x - 1 / (s.card : ℝ)|

/-- Scaled finite Pinsker inequality, before specializing `x_i = |s|p_i`. -/
lemma scaledEntropy_pinsker {α : Type*} (s : Finset α)
    (x : α → ℝ) (hx : ∀ i ∈ s, 0 ≤ x i)
    (hsum : ∑ i ∈ s, x i = (s.card : ℝ)) :
    (∑ i ∈ s, |x i - 1|)^2 ≤
      4 * (s.card : ℝ) *
        ∑ i ∈ s, (x i * Real.log (x i) - x i + 1) := by
  let d : α → ℝ := fun i ↦ (x i - 1)^2 / (x i + 1)
  let g : α → ℝ := fun i ↦ x i + 1
  let r : α → ℝ := fun i ↦ |x i - 1|
  have hd0 : ∀ i ∈ s, 0 ≤ d i := by
    intro i hi
    change 0 ≤ (x i - 1)^2 / (x i + 1)
    exact div_nonneg (sq_nonneg _) (by linarith [hx i hi])
  have hg0 : ∀ i ∈ s, 0 ≤ g i := by
    intro i hi
    change 0 ≤ x i + 1
    linarith [hx i hi]
  have hpoint : ∀ i ∈ s, (r i)^2 ≤ d i * g i := by
    intro i hi
    dsimp [r, d, g]
    rw [sq_abs]
    have hden : 0 < x i + 1 := by linarith [hx i hi]
    field_simp [hden.ne']
    exact le_rfl
  have hcs := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul s hd0 hg0 hpoint
  have hsumg : ∑ i ∈ s, g i = 2 * (s.card : ℝ) := by
    dsimp [g]
    rw [Finset.sum_add_distrib, hsum]
    simp
    ring
  have hscalar : ∑ i ∈ s, d i / 2 ≤
      ∑ i ∈ s, (x i * Real.log (x i) - x i + 1) := by
    apply Finset.sum_le_sum
    intro i hi
    have h := sq_div_le_mul_log_sub_add_one (hx i hi)
    dsimp [d]
    have hden : x i + 1 ≠ 0 := by linarith [hx i hi]
    calc
      (x i - 1)^2 / (x i + 1) / 2 =
          (x i - 1)^2 / (2 * (x i + 1)) := by
        field_simp [hden]
      _ ≤ x i * Real.log (x i) - x i + 1 := h
  have hsumd : ∑ i ∈ s, d i ≤
      2 * ∑ i ∈ s, (x i * Real.log (x i) - x i + 1) := by
    have hscalar' : (∑ i ∈ s, d i) / 2 ≤
        ∑ i ∈ s, (x i * Real.log (x i) - x i + 1) := by
      simpa only [Finset.sum_div] using hscalar
    linarith
  rw [hsumg] at hcs
  change (∑ i ∈ s, |x i - 1|)^2 ≤ _ at hcs
  calc
    (∑ i ∈ s, |x i - 1|)^2 ≤
        (∑ i ∈ s, d i) * (2 * (s.card : ℝ)) := hcs
    _ = (2 * (s.card : ℝ)) * (∑ i ∈ s, d i) := by ring
    _ ≤ (2 * (s.card : ℝ)) *
          (2 * ∑ i ∈ s, (x i * Real.log (x i) - x i + 1)) := by
      exact mul_le_mul_of_nonneg_left hsumd (by positivity)
    _ = 4 * (s.card : ℝ) *
          ∑ i ∈ s, (x i * Real.log (x i) - x i + 1) := by ring

/-- Quantitative finite Pinsker inequality for entropy deficit from the
uniform distribution. -/
lemma finiteUniformL1_sq_le_four_entropyDefect {α : Type*}
    (s : Finset α) (p : α → ℝ) (hs : s.Nonempty)
    (hp : ∀ x ∈ s, 0 ≤ p x) (hsum : ∑ x ∈ s, p x = 1) :
    (finiteUniformL1 s p)^2 ≤ 4 * finiteEntropyDefect s p := by
  let k : ℝ := s.card
  let X : α → ℝ := fun i ↦ k * p i
  have hk : 0 < k := by
    dsimp [k]
    exact_mod_cast Finset.card_pos.mpr hs
  have hX0 : ∀ i ∈ s, 0 ≤ X i := by
    intro i hi
    exact mul_nonneg hk.le (hp i hi)
  have hXsum : ∑ i ∈ s, X i = k := by
    dsimp [X]
    rw [← Finset.mul_sum, hsum, mul_one]
  have hscaled := scaledEntropy_pinsker s X hX0 (by
    simpa [k] using hXsum)
  have hdef := finiteEntropyDefect_eq_sum s p hs hp hsum
  have hGsum :
      ∑ i ∈ s, (X i * Real.log (X i) - X i + 1) =
        k * finiteEntropyDefect s p := by
    have hpoint : ∀ i ∈ s,
        X i * Real.log (X i) - X i + 1 =
          k * (p i * Real.log (k * p i)) - k * p i + 1 := by
      intro i hi
      dsimp [X]
      ring
    rw [Finset.sum_congr rfl hpoint, Finset.sum_add_distrib,
      Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum, hsum]
    have hones : ∑ _i ∈ s, (1 : ℝ) = k := by
      simp [k]
    rw [hones, hdef]
    ring
  have hL1 : finiteUniformL1 s p =
      (∑ i ∈ s, |X i - 1|) / k := by
    unfold finiteUniformL1
    apply Eq.trans (Finset.sum_congr rfl fun i hi ↦ ?_)
    · rw [← Finset.sum_div]
    dsimp [X]
    have hpoint : p i - 1 / k = (k * p i - 1) / k := by
      field_simp [hk.ne']
    rw [hpoint, abs_div, abs_of_pos hk]
  rw [hGsum] at hscaled
  rw [hL1, div_pow]
  apply (div_le_iff₀ (sq_pos_of_pos hk)).2
  calc
    (∑ i ∈ s, |X i - 1|)^2 ≤
        4 * (s.card : ℝ) * (k * finiteEntropyDefect s p) := hscaled
    _ = (4 * finiteEntropyDefect s p) * k^2 := by
      dsimp [k]
      ring

lemma matchingFraction_incident_nonneg {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) :
    ∀ A ∈ H.filter (fun A ↦ v ∈ A), 0 ≤ matchingFraction H A := by
  intro A _
  exact matchingFraction_nonneg H A

lemma matchingFraction_incident_le_one {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) :
    ∀ A ∈ H.filter (fun A ↦ v ∈ A), matchingFraction H A ≤ 1 := by
  intro A _
  exact matchingFraction_le_one H A

/-- The local matching entropy is bounded by the logarithm of the vertex
degree, with equality only in the uniform case (the inequality is the part
needed below). -/
lemma localMatchingEntropy_le_log_degree (n : ℕ)
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n) (v : Vertex n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    localMatchingEntropy H v ≤ Real.log (vertexDegree H v : ℝ) := by
  have hpm : (perfectMatchings n H).Nonempty := Finset.card_ne_zero.mp hΦ
  obtain ⟨F, hF⟩ := hpm
  obtain ⟨A, hA, -⟩ :=
    existsUnique_edge_mem_of_mem_perfectMatchings hH hF v
  have hs : (H.filter (fun A ↦ v ∈ A)).Nonempty := by
    exact ⟨A, Finset.mem_filter.mpr ⟨(mem_perfectMatchings.mp hF).1 hA.1,
      hA.2⟩⟩
  unfold localMatchingEntropy
  simpa only [vertexDegree] using
    finiteEntropy_le_log_card (H.filter fun A ↦ v ∈ A)
      (matchingFraction H) hs
      (matchingFraction_incident_nonneg H v)
      (sum_incident_matchingFraction n H hH v hΦ)

/-- Entropy is nonnegative for a finite mass function taking values in
`[0,1]`. -/
lemma finiteEntropy_nonneg {alpha : Type*} (s : Finset alpha) (p : alpha → ℝ)
    (hp0 : ∀ x ∈ s, 0 ≤ p x) (hp1 : ∀ x ∈ s, p x ≤ 1) :
    0 ≤ finiteEntropy s p := by
  unfold finiteEntropy
  apply Finset.sum_nonneg
  intro x hx
  have hlog : Real.log (p x) ≤ 0 :=
    Real.log_nonpos (hp0 x hx) (hp1 x hx)
  have hp := hp0 x hx
  nlinarith [mul_nonneg hp (neg_nonneg.mpr hlog)]

/-- Every local matching entropy is nonnegative. -/
lemma localMatchingEntropy_nonneg {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) :
    0 ≤ localMatchingEntropy H v := by
  unfold localMatchingEntropy
  exact finiteEntropy_nonneg _ _
    (matchingFraction_incident_nonneg H v)
    (matchingFraction_incident_le_one H v)

/-- A perfect matching forces every vertex degree to be positive. -/
lemma vertexDegree_pos_of_perfectMatching {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    0 < vertexDegree H v := by
  obtain ⟨F, hF⟩ := Finset.card_ne_zero.mp hΦ
  obtain ⟨A, hA, -⟩ :=
    existsUnique_edge_mem_of_mem_perfectMatchings hH hF v
  unfold vertexDegree
  apply Finset.card_pos.mpr
  exact ⟨A, Finset.mem_filter.mpr
    ⟨(mem_perfectMatchings.mp hF).1 hA.1, hA.2⟩⟩

/-- `L¹` deviation of the matching-fraction distribution incident to a
vertex from the uniform distribution on the incident edges. -/
def localMatchingL1 {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) : ℝ :=
  finiteUniformL1 (H.filter fun A ↦ v ∈ A) (matchingFraction H)

/-- The entropy deficit at one vertex quantitatively controls the local
matching-weight deviation.  This is the finite form of consequence (E2)
in Kahn's proof. -/
lemma localMatchingL1_sq_le_entropyDefect (n : ℕ)
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n) (v : Vertex n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    (localMatchingL1 H v)^2 ≤
      4 * (Real.log (vertexDegree H v : ℝ) -
        localMatchingEntropy H v) := by
  have hpm : (perfectMatchings n H).Nonempty := Finset.card_ne_zero.mp hΦ
  obtain ⟨F, hF⟩ := hpm
  obtain ⟨A, hA, -⟩ :=
    existsUnique_edge_mem_of_mem_perfectMatchings hH hF v
  have hs : (H.filter (fun A ↦ v ∈ A)).Nonempty := by
    exact ⟨A, Finset.mem_filter.mpr
      ⟨(mem_perfectMatchings.mp hF).1 hA.1, hA.2⟩⟩
  simpa only [localMatchingL1, finiteEntropyDefect, vertexDegree,
    localMatchingEntropy] using
      finiteUniformL1_sq_le_four_entropyDefect
        (H.filter fun A ↦ v ∈ A) (matchingFraction H) hs
        (matchingFraction_incident_nonneg H v)
        (sum_incident_matchingFraction n H hH v hΦ)

/-- Sum of the vertexwise entropy deficits. -/
def totalLocalEntropyDefect {n : ℕ} (H : Finset (Edge n)) : ℝ :=
  ∑ v : Vertex n,
    (Real.log (vertexDegree H v : ℝ) - localMatchingEntropy H v)

/-- Aggregated finite Pinsker bound over all vertices. -/
lemma sum_localMatchingL1_sq_le_totalEntropyDefect (n : ℕ)
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    ∑ v : Vertex n, (localMatchingL1 H v)^2 ≤
      4 * totalLocalEntropyDefect H := by
  unfold totalLocalEntropyDefect
  calc
    ∑ v : Vertex n, (localMatchingL1 H v)^2 ≤
        ∑ v : Vertex n,
          4 * (Real.log (vertexDegree H v : ℝ) -
            localMatchingEntropy H v) := by
      exact Finset.sum_le_sum fun v _ ↦
        localMatchingL1_sq_le_entropyDefect n H hH v hΦ
    _ = 4 * ∑ v : Vertex n,
          (Real.log (vertexDegree H v : ℝ) -
            localMatchingEntropy H v) := by
      rw [Finset.mul_sum]

/-- Cauchy--Schwarz converts the sum of local entropy deficits into a
global `L¹` incidence bound. -/
lemma sum_localMatchingL1_sq_le_card_mul_totalEntropyDefect (n : ℕ)
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    (∑ v : Vertex n, localMatchingL1 H v)^2 ≤
      (3 * n : ℝ) * (4 * totalLocalEntropyDefect H) := by
  have hcs := sq_sum_le_card_mul_sum_sq
    (s := (Finset.univ : Finset (Vertex n)))
    (f := fun v ↦ localMatchingL1 H v)
  have hsum := sum_localMatchingL1_sq_le_totalEntropyDefect n H hH hΦ
  have hcard : ((Finset.univ : Finset (Vertex n)).card : ℝ) = 3 * n := by
    simp
  rw [hcard] at hcs
  exact hcs.trans (mul_le_mul_of_nonneg_left hsum (by positivity))

/-- The fair deletion fraction, namely the average matching fraction of a
present edge. -/
def matchingFractionMean (n : ℕ) (H : Finset (Edge n)) : ℝ :=
  (n : ℝ) / H.card

/-- Quantitative regularity stated in the reciprocal-degree form directly
used by entropy spreading. -/
def InverseDegreeRegular {n : ℕ} (H : Finset (Edge n))
    (rho : ℝ) : Prop :=
  ∀ v : Vertex n,
    |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| ≤
      rho * matchingFractionMean n H

/-- A uniform maximum-degree bound gives a crude but fully quantitative
upper bound on the aggregate local entropy deficit.  Unlike Kahn's refined
entropy inequality, this estimate needs no asymptotic error term; its weaker
`log D` loss is still small enough for the matching-existence argument. -/
lemma totalLocalEntropyDefect_le_log_max {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (L : ℝ) (hL : ∀ v : Vertex n, (vertexDegree H v : ℝ) ≤ L) :
    totalLocalEntropyDefect H ≤ (3 * n : ℝ) * Real.log L := by
  unfold totalLocalEntropyDefect
  calc
    ∑ v : Vertex n,
        (Real.log (vertexDegree H v : ℝ) - localMatchingEntropy H v) ≤
      ∑ _v : Vertex n, Real.log L := by
        apply Finset.sum_le_sum
        intro v _
        have hdpos : (0 : ℝ) < vertexDegree H v := by
          exact_mod_cast vertexDegree_pos_of_perfectMatching H hH hΦ v
        have hLpos : 0 < L := hdpos.trans_le (hL v)
        have hlog : Real.log (vertexDegree H v : ℝ) ≤ Real.log L :=
          Real.strictMonoOn_log.monotoneOn hdpos hLpos (hL v)
        linarith [localMatchingEntropy_nonneg H v]
    _ = (3 * n : ℝ) * Real.log L := by simp

/-- A positive lower bound on every degree implies reciprocal-degree
regularity.  The deliberately generous relative error `1/a` is sufficient
for the coarse entropy-spreading argument. -/
lemma inverseDegreeRegular_of_lower_bound {n : ℕ}
    (H : Finset (Edge n)) (a : ℝ) (hn : 0 < n) (hHcard : 0 < H.card)
    (ha0 : 0 < a) (ha1 : a ≤ 1)
    (hmin : ∀ v : Vertex n,
      a * ((H.card : ℝ) / n) ≤ vertexDegree H v) :
    InverseDegreeRegular H (1 / a) := by
  intro v
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hcardR : (0 : ℝ) < H.card := by exact_mod_cast hHcard
  have hD : 0 < a * ((H.card : ℝ) / n) := by positivity
  have hrecip : 1 / (vertexDegree H v : ℝ) ≤
      1 / (a * ((H.card : ℝ) / n)) :=
    one_div_le_one_div_of_le hD (hmin v)
  have hrewrite : 1 / (a * ((H.card : ℝ) / n)) =
      (1 / a) * matchingFractionMean n H := by
    unfold matchingFractionMean
    field_simp [ha0.ne', hnR.ne', hcardR.ne']
  rw [hrewrite] at hrecip
  have hmean0 : 0 ≤ matchingFractionMean n H := by
    unfold matchingFractionMean
    positivity
  have hrho : 1 ≤ 1 / a := by
    apply (le_div_iff₀ ha0).2
    simpa using ha1
  rw [abs_sub_le_iff]
  constructor
  · nlinarith
  · have hrhoMean := mul_le_mul_of_nonneg_right hrho hmean0
    nlinarith [show 0 ≤ 1 / (vertexDegree H v : ℝ) by positivity]

/-- A present edge whose matching fraction is not within relative error
`delta` of its fair value. -/
def matchingFractionBadEdges {n : ℕ} (H : Finset (Edge n))
    (delta : ℝ) : Finset (Edge n) :=
  H.filter fun A ↦
    ¬|matchingFraction H A - matchingFractionMean n H| ≤
      delta * matchingFractionMean n H

/-- On a present edge, relative closeness of completion weight to the fair
weight is exactly relative closeness of the matching fraction to its fair
deletion mean. -/
lemma completionWeightClose_iff_matchingFractionClose {n : ℕ}
    (H : Finset (Edge n)) {A : Edge n} (hA : A ∈ H)
    (hΦ : (perfectMatchings n H).card ≠ 0) (delta : ℝ) :
    CompletionWeightClose H delta A ↔
      |matchingFraction H A - matchingFractionMean n H| ≤
        delta * matchingFractionMean n H := by
  rw [completionWeightClose_present_iff H hA delta]
  let q : ℝ := (perfectMatchings n H).card
  have hq : 0 < q := by
    dsimp [q]
    exact_mod_cast Nat.pos_of_ne_zero hΦ
  have hdiff :
      matchingFraction H A - matchingFractionMean n H =
        ((matchingWeight H A : ℝ) - matchingWeightTarget n H) / q := by
    unfold matchingFractionMean matchingFraction matchingWeightTarget
    dsimp [q]
    field_simp [hq.ne']
  rw [hdiff, abs_div, abs_of_pos hq]
  rw [div_le_iff₀ hq]
  unfold matchingFractionMean matchingWeightTarget
  dsimp [q]
  ring

/-- Adding a previously absent triple creates exactly the perfect matchings
counted by its completion weight. -/
lemma card_perfectMatchings_insert_eq_add_completionWeight {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (hZ : Z ∉ H) :
    (perfectMatchings n (insert Z H)).card =
      (perfectMatchings n H).card + completionWeight H Z := by
  have hcount := card_perfectMatchings_erase_add_weight
    n (insert Z H) Z
  rw [Finset.erase_insert hZ] at hcount
  unfold completionWeight
  omega

/-- Solving `w / (Phi + w) ≤ u` for the newly-created weight `w`. -/
lemma completionWeight_le_of_insert_fraction {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (u : ℝ)
    (hZ : Z ∉ H) (hΦ : (perfectMatchings n H).card ≠ 0)
    (hu : matchingFraction (insert Z H) Z ≤ u) (hu1 : u < 1) :
    (completionWeight H Z : ℝ) ≤
      (u / (1 - u)) * (perfectMatchings n H).card := by
  have hcount := card_perfectMatchings_insert_eq_add_completionWeight H Z hZ
  have hcountR : ((perfectMatchings n (insert Z H)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) + completionWeight H Z := by
    exact_mod_cast hcount
  have hden : (0 : ℝ) < (perfectMatchings n (insert Z H)).card := by
    rw [hcountR]
    have : (0 : ℝ) < (perfectMatchings n H).card := by
      exact_mod_cast Nat.pos_of_ne_zero hΦ
    positivity
  have hmul : (matchingWeight (insert Z H) Z : ℝ) ≤
      u * (perfectMatchings n (insert Z H)).card := by
    unfold matchingFraction at hu
    exact (div_le_iff₀ hden).mp hu
  have hweight : matchingWeight (insert Z H) Z = completionWeight H Z := rfl
  rw [hweight, hcountR] at hmul
  rw [show (u / (1 - u)) * (perfectMatchings n H).card =
      (u * (perfectMatchings n H).card) / (1 - u) by ring]
  apply (le_div_iff₀ (sub_pos.mpr hu1)).2
  nlinarith

/-- If the inserted edge has a typical deletion fraction and that fraction
is at most one half, then its original completion weight is bounded by a
small multiple of the original fair weight. -/
lemma completionWeightUpperBound_of_insert_close {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (delta : ℝ)
    (hZ : Z ∉ H) (hΦ : (perfectMatchings n H).card ≠ 0)
    (hHcard : 0 < H.card) (hdelta : 0 ≤ delta)
    (hu : (1 + delta) * ((n : ℝ) / (H.card + 1)) ≤ 1 / 2)
    (hclose : CompletionWeightClose (insert Z H) delta Z) :
    CompletionWeightUpperBound H (2 * (1 + delta)) Z := by
  have hZmem : Z ∈ insert Z H := Finset.mem_insert_self _ _
  have hΦinsert : (perfectMatchings n (insert Z H)).card ≠ 0 := by
    rw [card_perfectMatchings_insert_eq_add_completionWeight H Z hZ]
    omega
  have hfracClose :=
    (completionWeightClose_iff_matchingFractionClose
      (insert Z H) hZmem hΦinsert delta).mp hclose
  have hcardInsert : (insert Z H).card = H.card + 1 :=
    Finset.card_insert_of_notMem hZ
  have hfrac : matchingFraction (insert Z H) Z ≤
      (1 + delta) * ((n : ℝ) / (H.card + 1)) := by
    unfold matchingFractionMean at hfracClose
    rw [hcardInsert] at hfracClose
    norm_num only [Nat.cast_add, Nat.cast_one] at hfracClose ⊢
    have habs := le_abs_self
      (matchingFraction (insert Z H) Z -
        (n : ℝ) / ((H.card : ℝ) + 1))
    nlinarith
  let u : ℝ := (1 + delta) * ((n : ℝ) / (H.card + 1))
  have hu1 : u < 1 := (show u ≤ 1 / 2 by simpa [u] using hu).trans_lt
    (by norm_num)
  have hw := completionWeight_le_of_insert_fraction
    H Z u hZ hΦ (by simpa [u] using hfrac) hu1
  have hcardR : (0 : ℝ) < H.card := by exact_mod_cast hHcard
  have hn0 : (0 : ℝ) ≤ n := by positivity
  have hratio : u / (1 - u) ≤
      2 * (1 + delta) * ((n : ℝ) / H.card) := by
    have hdenhalf : (1 / 2 : ℝ) ≤ 1 - u := by
      have := (show u ≤ 1 / 2 by simpa [u] using hu)
      linarith
    have hdenpos : 0 < 1 - u := sub_pos.mpr hu1
    have hfirst : u / (1 - u) ≤ 2 * u := by
      apply (div_le_iff₀ hdenpos).2
      have hu0 : 0 ≤ u := by
        dsimp [u]
        positivity
      nlinarith
    have hcardmono : ((n : ℝ) / (H.card + 1)) ≤
        (n : ℝ) / H.card := by
      apply div_le_div_of_nonneg_left hn0 hcardR
      norm_num
    calc
      u / (1 - u) ≤ 2 * u := hfirst
      _ = 2 * (1 + delta) * ((n : ℝ) / (H.card + 1)) := by
        dsimp [u]
        ring
      _ ≤ 2 * (1 + delta) * ((n : ℝ) / H.card) := by
        exact mul_le_mul_of_nonneg_left hcardmono (by positivity)
  unfold CompletionWeightUpperBound matchingWeightTarget
  calc
    (completionWeight H Z : ℝ) ≤
        (u / (1 - u)) * (perfectMatchings n H).card := hw
    _ ≤ (2 * (1 + delta) * ((n : ℝ) / H.card)) *
          (perfectMatchings n H).card := by
      gcongr
    _ = 2 * (1 + delta) *
          (((perfectMatchings n H).card : ℝ) * n / H.card) := by ring

/-- The two definitions of the bad present-edge set agree. -/
lemma matchingFractionBadEdges_eq {n : ℕ} (H : Finset (Edge n))
    (hΦ : (perfectMatchings n H).card ≠ 0) (delta : ℝ) :
    matchingFractionBadEdges H delta =
      H.filter (fun A ↦ ¬CompletionWeightClose H delta A) := by
  ext A
  simp only [matchingFractionBadEdges, Finset.mem_filter]
  by_cases hA : A ∈ H
  · simp only [hA, true_and]
    rw [completionWeightClose_iff_matchingFractionClose H hA hΦ delta]
  · simp [hA]

lemma localMatchingL1_eq_sum {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) :
    localMatchingL1 H v =
      ∑ A ∈ H.filter (fun A ↦ v ∈ A),
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
  rfl

/-- Exchange the two incidence sums in the total local `L¹` deviation. -/
lemma sum_localMatchingL1_eq_sum_edges {n : ℕ}
    (H : Finset (Edge n)) :
    ∑ v : Vertex n, localMatchingL1 H v =
      ∑ A ∈ H, ∑ v ∈ A,
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
  simp_rw [localMatchingL1_eq_sum, Finset.sum_filter]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro A _
  rw [← Finset.sum_filter]
  have hfilter :
      (Finset.univ : Finset (Vertex n)).filter (fun v ↦ v ∈ A) = A := by
    ext v
    simp
  rw [hfilter]

/-- A bad edge is separated from the uniform local mass at every one of
its vertices, provided reciprocal degrees are regular. -/
lemma badEdge_incidenceDeviation_lt {n : ℕ} {H : Finset (Edge n)}
    {rho delta : ℝ} (hreg : InverseDegreeRegular H rho)
    {A : Edge n} (hA : A ∈ matchingFractionBadEdges H delta)
    (v : Vertex n) :
    (delta - rho) * matchingFractionMean n H <
      |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
  have hbad : delta * matchingFractionMean n H <
      |matchingFraction H A - matchingFractionMean n H| := by
    exact lt_of_not_ge (Finset.mem_filter.mp hA).2
  have htriangle :
      |matchingFraction H A - matchingFractionMean n H| ≤
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| := by
    calc
      |matchingFraction H A - matchingFractionMean n H| =
          |(matchingFraction H A - 1 / (vertexDegree H v : ℝ)) +
            (1 / (vertexDegree H v : ℝ) -
              matchingFractionMean n H)| := by ring_nf
      _ ≤ |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| :=
        abs_add_le _ _
  have hv := hreg v
  linarith

/-- Counting bad present edges by the total local `L¹` deviation. -/
lemma card_badEdges_mul_gap_le_sum_localMatchingL1 {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (rho delta : ℝ) (hn : 0 < n)
    (hrhodelta : rho ≤ delta) (hreg : InverseDegreeRegular H rho) :
    ((matchingFractionBadEdges H delta).card : ℝ) *
        ((delta - rho) * matchingFractionMean n H) ≤
      ∑ v : Vertex n, localMatchingL1 H v := by
  let B := matchingFractionBadEdges H delta
  let c := (delta - rho) * matchingFractionMean n H
  have hpm : (perfectMatchings n H).Nonempty := Finset.card_ne_zero.mp hΦ
  obtain ⟨F, hF⟩ := hpm
  have hnH : n ≤ H.card := by
    calc
      n = F.card := (mem_perfectMatchings.mp hF).2.1.symm
      _ ≤ H.card := Finset.card_le_card (mem_perfectMatchings.mp hF).1
  have hHcard : 0 < H.card := lt_of_lt_of_le hn hnH
  have hmean : 0 < matchingFractionMean n H := by
    unfold matchingFractionMean
    positivity
  have hc0 : 0 ≤ c := by
    dsimp [c]
    exact mul_nonneg (sub_nonneg.mpr hrhodelta) hmean.le
  have hBH : B ⊆ H := by
    intro A hA
    exact (Finset.mem_filter.mp hA).1
  have hinner0 : ∀ A ∈ H,
      0 ≤ ∑ v ∈ A,
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
    intro A hA
    positivity
  have hedge : ∀ A ∈ B, c ≤
      ∑ v ∈ A,
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
    intro A hAB
    have hAH : A ∈ H := hBH hAB
    have hAcard : A.card = 3 := mem_allEdges.mp (hH hAH)
    have hAne : A.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hAempty
      rw [hAempty] at hAcard
      simp at hAcard
    obtain ⟨v, hv⟩ := hAne
    have hsingle :
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| ≤
          ∑ w ∈ A,
            |matchingFraction H A - 1 / (vertexDegree H w : ℝ)| := by
      apply Finset.single_le_sum (s := A)
          (f := fun w ↦
            |matchingFraction H A - 1 / (vertexDegree H w : ℝ)|)
      · intro w hw
        exact abs_nonneg _
      · exact hv
    exact (badEdge_incidenceDeviation_lt hreg hAB v).le.trans hsingle
  calc
    (B.card : ℝ) * c = ∑ _A ∈ B, c := by simp
    _ ≤ ∑ A ∈ B, ∑ v ∈ A,
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
      exact Finset.sum_le_sum hedge
    _ ≤ ∑ A ∈ H, ∑ v ∈ A,
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| := by
      exact Finset.sum_le_sum_of_subset_of_nonneg hBH
        (fun A hAH _ ↦ hinner0 A hAH)
    _ = ∑ v : Vertex n, localMatchingL1 H v :=
      (sum_localMatchingL1_eq_sum_edges H).symm

/-- Finite deterministic entropy spreading.  If reciprocal degrees are
`rho`-regular and the total local entropy deficit fits the displayed
quadratic budget, then all but an `eta` fraction of present edges have
matching weight within relative error `delta` of the fair weight. -/
lemma presentWeightSpread_of_entropyDefect {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (rho delta eta E : ℝ) (hn : 0 < n) (heta : 0 ≤ eta)
    (hrhodelta : rho < delta) (hreg : InverseDegreeRegular H rho)
    (hdef : totalLocalEntropyDefect H ≤ E)
    (hbudget :
      (3 * n : ℝ) * (4 * E) ≤
        (eta * (delta - rho) * (n : ℝ))^2) :
    PresentWeightSpread H delta eta := by
  unfold PresentWeightSpread
  rw [← matchingFractionBadEdges_eq H hΦ delta]
  by_contra hspread
  have hbadcard : eta * (H.card : ℝ) <
      ((matchingFractionBadEdges H delta).card : ℝ) :=
    lt_of_not_ge hspread
  have hpm : (perfectMatchings n H).Nonempty := Finset.card_ne_zero.mp hΦ
  obtain ⟨F, hF⟩ := hpm
  have hnH : n ≤ H.card := by
    calc
      n = F.card := (mem_perfectMatchings.mp hF).2.1.symm
      _ ≤ H.card := Finset.card_le_card (mem_perfectMatchings.mp hF).1
  have hHcard : 0 < H.card := lt_of_lt_of_le hn hnH
  have hmean : 0 < matchingFractionMean n H := by
    unfold matchingFractionMean
    positivity
  have hgap : 0 < (delta - rho) * matchingFractionMean n H :=
    mul_pos (sub_pos.mpr hrhodelta) hmean
  have hcount := card_badEdges_mul_gap_le_sum_localMatchingL1
    H hH hΦ rho delta hn (le_of_lt hrhodelta) hreg
  have hlowerRaw :
      (eta * (H.card : ℝ)) *
          ((delta - rho) * matchingFractionMean n H) <
        ∑ v : Vertex n, localMatchingL1 H v := by
    exact (mul_lt_mul_of_pos_right hbadcard hgap).trans_le hcount
  have hnormalize :
      (eta * (H.card : ℝ)) *
          ((delta - rho) * matchingFractionMean n H) =
        eta * (delta - rho) * (n : ℝ) := by
    unfold matchingFractionMean
    field_simp [show (H.card : ℝ) ≠ 0 by exact_mod_cast hHcard.ne']
  rw [hnormalize] at hlowerRaw
  have hsum0 : 0 ≤ ∑ v : Vertex n, localMatchingL1 H v := by
    apply Finset.sum_nonneg
    intro v _
    unfold localMatchingL1 finiteUniformL1
    positivity
  have hlowerSq :
      (eta * (delta - rho) * (n : ℝ))^2 <
        (∑ v : Vertex n, localMatchingL1 H v)^2 := by
    have hleft0 : 0 ≤ eta * (delta - rho) * (n : ℝ) := by positivity
    nlinarith
  have haggregate :=
    sum_localMatchingL1_sq_le_card_mul_totalEntropyDefect n H hH hΦ
  have hdefBound :
      (3 * n : ℝ) * (4 * totalLocalEntropyDefect H) ≤
        (3 * n : ℝ) * (4 * E) := by
    exact mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left hdef (by norm_num)) (by positivity)
  have hupper :
      (∑ v : Vertex n, localMatchingL1 H v)^2 ≤
        (eta * (delta - rho) * (n : ℝ))^2 :=
    haggregate.trans (hdefBound.trans hbudget)
  exact (not_lt_of_ge hupper) hlowerSq

/-- Coarse deterministic present-edge spreading from only minimum and
maximum degree bounds.  The entropy budget here is explicit; later the
parameters are chosen so its `log L` loss is harmless. -/
lemma presentWeightSpread_of_degree_bounds {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (a L delta eta : ℝ) (hn : 0 < n) (hHcard : 0 < H.card)
    (ha0 : 0 < a) (ha1 : a ≤ 1) (heta : 0 ≤ eta)
    (hmin : ∀ v : Vertex n,
      a * ((H.card : ℝ) / n) ≤ vertexDegree H v)
    (hmax : ∀ v : Vertex n, (vertexDegree H v : ℝ) ≤ L)
    (hgap : 1 / a < delta)
    (hbudget :
      (3 * n : ℝ) * (4 * ((3 * n : ℝ) * Real.log L)) ≤
        (eta * (delta - 1 / a) * (n : ℝ))^2) :
    PresentWeightSpread H delta eta := by
  apply presentWeightSpread_of_entropyDefect H hH hΦ
    (1 / a) delta eta ((3 * n : ℝ) * Real.log L)
    hn heta hgap
  · exact inverseDegreeRegular_of_lower_bound
      H a hn hHcard ha0 ha1 hmin
  · exact totalLocalEntropyDefect_le_log_max H hH hΦ L hmax
  · exact hbudget

/-- The finite coarse regularity package used in the one-edge insertion
double count. -/
def CoarseRegularPerfect (n M : ℕ) (a B : ℝ)
    (H : Finset (Edge n)) : Prop :=
  H ∈ sample n M ∧ HasPerfectMatching n H ∧
    ∀ v : Vertex n,
      a * ((M : ℝ) / n) ≤ vertexDegree H v ∧
      (vertexDegree H v : ℝ) ≤ B * ((M : ℝ) / n)

/-- Coarse regularity is robust under adjoining one missing edge. -/
lemma coarseRegularPerfect_insert {n M : ℕ} {a B : ℝ}
    {H : Finset (Edge n)} {Z : Edge n}
    (hn : 0 < n) (hM : 0 < M) (hnM : n ≤ M)
    (ha0 : 0 < a) (hB0 : 0 ≤ B)
    (hreg : CoarseRegularPerfect n M a B H)
    (hZ : Z ∈ allEdges n \ H) :
    CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1))
      (insert Z H) := by
  rcases hreg with ⟨hHsample, hpm, hdeg⟩
  rcases mem_sample.mp hHsample with ⟨hHall, hHcard⟩
  rcases Finset.mem_sdiff.mp hZ with ⟨hZall, hZnot⟩
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hMone : (M + 1 : ℝ) ≤ 2 * M := by
    norm_num only [Nat.cast_add, Nat.cast_one, Nat.cast_ofNat]
    exact_mod_cast (show M + 1 ≤ 2 * M by omega)
  have hDge : (1 : ℝ) ≤ (M : ℝ) / n := by
    apply (le_div_iff₀ hnR).2
    norm_num only [one_mul]
    exact_mod_cast hnM
  refine ⟨mem_sample.mpr ⟨Finset.insert_subset hZall hHall, ?_⟩,
    hasPerfectMatching_mono (Finset.subset_insert Z H) hpm, ?_⟩
  · rw [Finset.card_insert_of_notMem hZnot, hHcard]
  · intro v
    rcases hdeg v with ⟨hmin, hmax⟩
    have hmono : (vertexDegree H v : ℝ) ≤
        vertexDegree (insert Z H) v := by
      exact_mod_cast vertexDegree_mono (Finset.subset_insert Z H) v
    have hadd : (vertexDegree (insert Z H) v : ℝ) ≤
        vertexDegree H v + 1 := by
      exact_mod_cast vertexDegree_insert_le_add_one H Z v
    constructor
    · have hscale : (a / 2) * (((M + 1 : ℕ) : ℝ) / n) ≤
          a * ((M : ℝ) / n) := by
        calc
          (a / 2) * (((M + 1 : ℕ) : ℝ) / n) =
              ((a / 2) * ((M + 1 : ℕ) : ℝ)) / n := by ring
          _ ≤ (a * (M : ℝ)) / n := by
            apply (div_le_div_iff_of_pos_right hnR).2
            norm_num only [Nat.cast_add, Nat.cast_one]
            nlinarith [mul_le_mul_of_nonneg_left hMone ha0.le]
          _ = a * ((M : ℝ) / n) := by ring
      exact hscale.trans (hmin.trans hmono)
    · have hrough : (vertexDegree (insert Z H) v : ℝ) ≤
          B * ((M : ℝ) / n) + 1 := hadd.trans (by linarith)
      have htarget : B * ((M : ℝ) / n) + 1 ≤
          2 * (B + 1) * (((M + 1 : ℕ) : ℝ) / n) := by
        have hM0 : (0 : ℝ) ≤ (M : ℝ) / n := by positivity
        have hnext : (M : ℝ) / n ≤ ((M + 1 : ℕ) : ℝ) / n := by
          apply div_le_div_of_nonneg_right _ hnR.le
          norm_num
        nlinarith
      exact hrough.trans htarget

/-- Every coarsely regular graph with a perfect matching satisfies the
explicit present-edge spreading estimate furnished by the entropy bound. -/
lemma coarseRegularPerfect_presentWeightSpread {n M : ℕ}
    {a B delta eta : ℝ} {H : Finset (Edge n)}
    (hn : 0 < n) (hM : 0 < M) (ha0 : 0 < a) (ha1 : a ≤ 1)
    (heta : 0 ≤ eta) (hgap : 1 / a < delta)
    (hreg : CoarseRegularPerfect n M a B H)
    (hbudget :
      (3 * n : ℝ) *
          (4 * ((3 * n : ℝ) *
            Real.log (B * ((M : ℝ) / n)))) ≤
        (eta * (delta - 1 / a) * (n : ℝ))^2) :
    PresentWeightSpread H delta eta := by
  rcases hreg with ⟨hHsample, hpm, hdeg⟩
  rcases mem_sample.mp hHsample with ⟨hHall, hHcard⟩
  have hΦ : (perfectMatchings n H).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      ((hasPerfectMatching_iff_perfectMatchings_nonempty.mp hpm))
  apply presentWeightSpread_of_degree_bounds H hHall hΦ a
    (B * ((M : ℝ) / n)) delta eta hn
  · simpa [hHcard] using hM
  · exact ha0
  · exact ha1
  · exact heta
  · intro v
    simpa [hHcard] using (hdeg v).1
  · intro v
    simpa [hHcard] using (hdeg v).2
  · exact hgap
  · exact hbudget

/-- Missing triples whose completion weight exceeds the one-sided target. -/
def coarseUpperBadNonedges (n : ℕ) (H : Finset (Edge n))
    (L : ℝ) : Finset (Edge n) :=
  (allEdges n \ H).filter fun Z ↦
    ¬CompletionWeightUpperBound H L Z

/-- Coarsely regular marked extensions carrying an upper-bad new edge. -/
def coarseUpperBadExtensionPairs (n M : ℕ) (a B delta : ℝ) :
    Finset ((_H : Finset (Edge n)) × Edge n) :=
  (sample n M).sigma fun H ↦
    (coarseUpperBadNonedges n H (2 * (1 + delta))).filter fun _Z ↦
      CoarseRegularPerfect n M a B H

/-- Marked present edges that fail two-sided spreading in the augmented
coarsely regular graph. -/
def coarseCloseBadMarkedPairs (n M : ℕ) (a B delta : ℝ) :
    Finset ((_G : Finset (Edge n)) × Edge n) :=
  (sample n (M + 1)).sigma fun G ↦
    G.filter fun Z ↦
      CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1)) G ∧
        ¬CompletionWeightClose G delta Z

lemma extendPair_maps_coarseUpperBad {n M : ℕ} {a B delta : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hnM : n ≤ M)
    (ha0 : 0 < a) (hB0 : 0 ≤ B) (hdelta : 0 ≤ delta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2) :
    Set.MapsTo extendPair
      (↑(coarseUpperBadExtensionPairs n M a B delta) :
        Set ((_H : Finset (Edge n)) × Edge n))
      (↑(coarseCloseBadMarkedPairs n M a B delta) :
        Set ((_G : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, Z⟩ hHZ
  change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
    coarseUpperBadExtensionPairs n M a B delta at hHZ
  rw [coarseUpperBadExtensionPairs, Finset.mem_sigma] at hHZ
  rcases hHZ with ⟨hHsample, hZfiber⟩
  rcases Finset.mem_filter.mp hZfiber with ⟨hZbad, hreg⟩
  rcases Finset.mem_filter.mp hZbad with ⟨hZdiff, hnotUpper⟩
  have hZsdiff : Z ∈ allEdges n \ H := hZdiff
  have hregInsert := coarseRegularPerfect_insert
    hn hM hnM ha0 hB0 hreg hZsdiff
  have hZnot : Z ∉ H := (Finset.mem_sdiff.mp hZsdiff).2
  have hpm := hreg.2.1
  have hΦ : (perfectMatchings n H).card ≠ 0 :=
    Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp hpm)
  change (⟨insert Z H, Z⟩ :
    ((_G : Finset (Edge n)) × Edge n)) ∈
      coarseCloseBadMarkedPairs n M a B delta
  rw [coarseCloseBadMarkedPairs, Finset.mem_sigma]
  refine ⟨hregInsert.1, Finset.mem_filter.mpr
    ⟨Finset.mem_insert_self Z H, hregInsert, ?_⟩⟩
  intro hclose
  apply hnotUpper
  apply completionWeightUpperBound_of_insert_close
    H Z delta hZnot hΦ
  · simpa [(mem_sample.mp hHsample).2] using hM
  · exact hdelta
  · simpa [(mem_sample.mp hHsample).2] using hu
  · exact hclose

lemma extendPair_injective_on_coarseUpperBad {n M : ℕ} {a B delta : ℝ} :
    Set.InjOn extendPair
      (↑(coarseUpperBadExtensionPairs n M a B delta) :
        Set ((_H : Finset (Edge n)) × Edge n)) := by
  intro x hx y hy hxy
  apply extendPair_injective n M
  · rcases x with ⟨H, Z⟩
    change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      coarseUpperBadExtensionPairs n M a B delta at hx
    rw [coarseUpperBadExtensionPairs, Finset.mem_sigma] at hx
    change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      extensionPairs n M
    rw [extensionPairs, Finset.mem_sigma]
    rcases Finset.mem_filter.mp hx.2 with ⟨hZbad, hreg⟩
    refine ⟨?_, ?_⟩
    · exact mem_goodSample.mpr
        ⟨(mem_sample.mp hx.1).1, (mem_sample.mp hx.1).2, hreg.2.1⟩
    · exact (Finset.mem_filter.mp hZbad).1
  · rcases y with ⟨H, Z⟩
    change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      coarseUpperBadExtensionPairs n M a B delta at hy
    rw [coarseUpperBadExtensionPairs, Finset.mem_sigma] at hy
    change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      extensionPairs n M
    rw [extensionPairs, Finset.mem_sigma]
    rcases Finset.mem_filter.mp hy.2 with ⟨hZbad, hreg⟩
    refine ⟨?_, ?_⟩
    · exact mem_goodSample.mpr
        ⟨(mem_sample.mp hy.1).1, (mem_sample.mp hy.1).2, hreg.2.1⟩
    · exact (Finset.mem_filter.mp hZbad).1
  · exact hxy

/-- The bad-extension double count: every upper-bad new edge maps
injectively to a bad present edge in an augmented graph. -/
lemma card_coarseUpperBadExtensionPairs_le_marked {n M : ℕ}
    {a B delta : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hnM : n ≤ M)
    (ha0 : 0 < a) (hB0 : 0 ≤ B) (hdelta : 0 ≤ delta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2) :
    (coarseUpperBadExtensionPairs n M a B delta).card ≤
      (coarseCloseBadMarkedPairs n M a B delta).card := by
  exact Finset.card_le_card_of_injOn extendPair
    (extendPair_maps_coarseUpperBad hn hM hnM ha0 hB0 hdelta hu)
    extendPair_injective_on_coarseUpperBad

/-- Summing present-edge spreading over all augmented graphs bounds the
entire marked bad-pair set. -/
lemma card_coarseCloseBadMarkedPairs_le {n M : ℕ}
    {a B delta eta : ℝ} (heta : 0 ≤ eta)
    (hspread : ∀ G : Finset (Edge n),
      CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1)) G →
        PresentWeightSpread G delta eta) :
    ((coarseCloseBadMarkedPairs n M a B delta).card : ℝ) ≤
      ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := by
  rw [coarseCloseBadMarkedPairs, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  calc
    ∑ G ∈ sample n (M + 1),
        (((G.filter fun Z ↦
          CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1)) G ∧
            ¬CompletionWeightClose G delta Z).card : ℕ) : ℝ) ≤
      ∑ _G ∈ sample n (M + 1),
        eta * ((M + 1 : ℕ) : ℝ) := by
      apply Finset.sum_le_sum
      intro G hG
      by_cases hreg :
          CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1)) G
      · have hsub :
            G.filter (fun Z ↦
                CoarseRegularPerfect n (M + 1) (a / 2)
                    (2 * (B + 1)) G ∧
                  ¬CompletionWeightClose G delta Z) ⊆
              G.filter (fun Z ↦ ¬CompletionWeightClose G delta Z) := by
          intro Z hZ
          rcases Finset.mem_filter.mp hZ with ⟨hZG, _, hbad⟩
          exact Finset.mem_filter.mpr ⟨hZG, hbad⟩
        have hcardNat := Finset.card_le_card hsub
        have hcard :
            ((G.filter (fun Z ↦
                CoarseRegularPerfect n (M + 1) (a / 2)
                    (2 * (B + 1)) G ∧
                  ¬CompletionWeightClose G delta Z)).card : ℝ) ≤
              ((G.filter (fun Z ↦
                ¬CompletionWeightClose G delta Z)).card : ℝ) := by
          exact_mod_cast hcardNat
        have hpresent := hspread G hreg
        unfold PresentWeightSpread at hpresent
        have hGcard := (mem_sample.mp hG).2
        exact hcard.trans (by simpa [hGcard] using hpresent)
      · have hzero :
            (G.filter fun Z ↦
              CoarseRegularPerfect n (M + 1) (a / 2)
                  (2 * (B + 1)) G ∧
                ¬CompletionWeightClose G delta Z).card = 0 := by
          simp [hreg]
        rw [hzero]
        norm_num only [Nat.cast_zero]
        exact mul_nonneg heta (Nat.cast_nonneg (M + 1))
    _ = ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := by simp

/-- The number of upper-heavy missing triples, with non-regular or
matching-free graphs assigned weight zero.  This is the fibre cardinality
in `coarseUpperBadExtensionPairs`, promoted to the reals. -/
def coarseUpperBadCount (n M : ℕ) (a B delta : ℝ)
    (H : Finset (Edge n)) : ℝ :=
  ((coarseUpperBadNonedges n H (2 * (1 + delta))).filter fun _Z ↦
    CoarseRegularPerfect n M a B H).card

lemma coarseUpperBadCount_nonneg (n M : ℕ) (a B delta : ℝ)
    (H : Finset (Edge n)) :
    0 ≤ coarseUpperBadCount n M a B delta H := by
  unfold coarseUpperBadCount
  positivity

/-- The sum of the bad-extension counts is exactly the cardinality of the
corresponding sigma-type finset. -/
lemma sum_coarseUpperBadCount (n M : ℕ) (a B delta : ℝ) :
    ∑ H ∈ sample n M, coarseUpperBadCount n M a B delta H =
      ((coarseUpperBadExtensionPairs n M a B delta).card : ℝ) := by
  rw [coarseUpperBadExtensionPairs, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  rfl

lemma coarseUpperBadCount_eq_of_regular {n M : ℕ}
    {a B delta : ℝ} {H : Finset (Edge n)}
    (hreg : CoarseRegularPerfect n M a B H) :
    coarseUpperBadCount n M a B delta H =
      ((coarseUpperBadNonedges n H (2 * (1 + delta))).card : ℝ) := by
  unfold coarseUpperBadCount
  simp [hreg]

/-- Every globally upper-heavy triple is either an upper-heavy missing
triple or is already an edge of the hypergraph. -/
lemma globalUpperBad_card_le_nonedge_add_card {n : ℕ}
    (H : Finset (Edge n)) (L : ℝ) :
    ((allEdges n).filter fun Z ↦
        ¬CompletionWeightUpperBound H L Z).card ≤
      (coarseUpperBadNonedges n H L).card + H.card := by
  have hsub :
      (allEdges n).filter (fun Z ↦
          ¬CompletionWeightUpperBound H L Z) ⊆
        coarseUpperBadNonedges n H L ∪ H := by
    intro Z hZ
    rcases Finset.mem_filter.mp hZ with ⟨hZall, hbad⟩
    by_cases hZH : Z ∈ H
    · exact Finset.mem_union_right _ hZH
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_sdiff.mpr ⟨hZall, hZH⟩, hbad⟩
  exact (Finset.card_le_card hsub).trans
    (Finset.card_union_le (coarseUpperBadNonedges n H L) H)

/-- A coarsely regular graph whose missing-triple bad count is below `r`
has one-sided global spreading whenever `r` plus the present-edge budget
fits inside the requested global exceptional set. -/
lemma globalUpperWeightSpread_of_coarseUpperBadCount_lt {n M : ℕ}
    {a B delta r eta : ℝ} {H : Finset (Edge n)}
    (hreg : CoarseRegularPerfect n M a B H)
    (hcount : coarseUpperBadCount n M a B delta H < r)
    (hbudget : r + (M : ℝ) ≤ eta * (allEdges n).card) :
    GlobalUpperWeightSpread n H (2 * (1 + delta)) eta := by
  have hHcard : H.card = M := (mem_sample.mp hreg.1).2
  have hcountEq := coarseUpperBadCount_eq_of_regular
    (delta := delta) hreg
  have hcardNat := globalUpperBad_card_le_nonedge_add_card
    H (2 * (1 + delta))
  have hcard :
      (((allEdges n).filter fun Z ↦
          ¬CompletionWeightUpperBound H (2 * (1 + delta)) Z).card : ℕ) ≤
        (coarseUpperBadNonedges n H (2 * (1 + delta))).card + H.card :=
    hcardNat
  have hcardR :
      ((((allEdges n).filter fun Z ↦
          ¬CompletionWeightUpperBound H (2 * (1 + delta)) Z).card : ℕ) : ℝ) ≤
        ((coarseUpperBadNonedges n H
          (2 * (1 + delta))).card : ℝ) + H.card := by
    exact_mod_cast hcard
  unfold GlobalUpperWeightSpread
  calc
    ((((allEdges n).filter fun Z ↦
        ¬CompletionWeightUpperBound H (2 * (1 + delta)) Z).card : ℕ) : ℝ) ≤
      ((coarseUpperBadNonedges n H
        (2 * (1 + delta))).card : ℝ) + H.card := hcardR
    _ = coarseUpperBadCount n M a B delta H + (M : ℝ) := by
      rw [hcountEq, hHcard]
    _ ≤ r + (M : ℝ) := add_le_add hcount.le le_rfl
    _ ≤ eta * (allEdges n).card := hbudget

/-- On coarsely regular matching-bearing graphs, failure of the global
upper-spreading conclusion is contained in the Markov bad-count event. -/
lemma coarseUpperBadCount_large_of_not_globalUpperWeightSpread {n M : ℕ}
    {a B delta r eta : ℝ} {H : Finset (Edge n)}
    (hreg : CoarseRegularPerfect n M a B H)
    (hbudget : r + (M : ℝ) ≤ eta * (allEdges n).card)
    (hfail : ¬GlobalUpperWeightSpread n H (2 * (1 + delta)) eta) :
    r ≤ coarseUpperBadCount n M a B delta H := by
  by_contra hnot
  exact hfail (globalUpperWeightSpread_of_coarseUpperBadCount_lt
    hreg (lt_of_not_ge hnot) hbudget)

/-- Conditional on a uniformly selected edge of `H`, the exact mean fraction
of perfect matchings destroyed is `n / |H|`. -/
lemma sum_matchingFraction (n : ℕ) (H : Finset (Edge n))
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    ∑ A ∈ H, matchingFraction H A = n := by
  unfold matchingFraction
  rw [← Finset.sum_div]
  have hsumR :
      ∑ A ∈ H, (matchingWeight H A : ℝ) =
        ((perfectMatchings n H).card : ℝ) * (n : ℝ) := by
    exact_mod_cast sum_matchingWeight n H
  rw [hsumR]
  have hΦR : ((perfectMatchings n H).card : ℝ) ≠ 0 := by exact_mod_cast hΦ
  field_simp [hΦR]

lemma average_matchingFraction (n : ℕ) (H : Finset (Edge n))
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    (∑ A ∈ H, matchingFraction H A) / H.card =
      (n : ℝ) / H.card := by
  rw [sum_matchingFraction n H hΦ]

lemma card_perfectMatchings_erase_mul (n : ℕ) (H : Finset (Edge n))
    (A : Edge n) :
    ((perfectMatchings n (H.erase A)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) * (1 - matchingFraction H A) := by
  by_cases hΦ : (perfectMatchings n H).card = 0
  · have hcount := card_perfectMatchings_erase_add_weight n H A
    have herase : (perfectMatchings n (H.erase A)).card = 0 := by omega
    simp [matchingFraction, hΦ, herase]
  · have hratio := card_perfectMatchings_erase_ratio n H A hΦ
    have hΦR : ((perfectMatchings n H).card : ℝ) ≠ 0 := by exact_mod_cast hΦ
    have hmul := (div_eq_iff hΦR).mp hratio
    simpa only [mul_comm] using hmul

/-- Delete a finite ordered list of edges. -/
def deleteEdges {n : ℕ} : Finset (Edge n) → List (Edge n) → Finset (Edge n)
  | H, [] => H
  | H, A :: L => deleteEdges (H.erase A) L

/-- The product of the surviving perfect-matching fractions along an ordered
edge-deletion list. -/
def deletionProduct {n : ℕ} : Finset (Edge n) → List (Edge n) → ℝ
  | _, [] => 1
  | H, A :: L =>
      (1 - matchingFraction H A) * deletionProduct (H.erase A) L

/-- Kahn's exact telescoping deletion product. -/
lemma card_deleteEdges_eq_mul_deletionProduct {n : ℕ}
    (H : Finset (Edge n)) (L : List (Edge n)) :
    ((perfectMatchings n (deleteEdges H L)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) * deletionProduct H L := by
  induction L generalizing H with
  | nil => simp [deleteEdges, deletionProduct]
  | cons A L ih =>
      rw [deleteEdges, deletionProduct, ih (H := H.erase A),
        card_perfectMatchings_erase_mul]
      ring

/-! ### Ordered deletion histories -/

/-- An ordered history of `t` distinct deletions from `H`.  Encoding a
history as an embedding makes distinctness part of the type and avoids any
quotienting of lists. -/
abbrev DeletionHistory {n : ℕ} (H : Finset (Edge n)) (t : ℕ) :=
  Fin t ↪ ↥H

/-- The (unordered) set of edges appearing in an ordered deletion history. -/
def historyEdges {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) : Finset (Edge n) :=
  Finset.univ.image (fun i ↦ (e i).1)

@[simp] lemma card_historyEdges {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) :
    (historyEdges e).card = t := by
  rw [historyEdges, Finset.card_image_of_injective]
  · simp
  · intro i j hij
    exact e.injective (Subtype.ext hij)

lemma historyEdges_subset {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) :
    historyEdges e ⊆ H := by
  intro A hA
  rcases Finset.mem_image.mp hA with ⟨i, -, rfl⟩
  exact (e i).2

/-- The hypergraph left after an ordered deletion history. -/
def remainingAfterHistory {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) : Finset (Edge n) :=
  H \ historyEdges e

@[simp] lemma card_remainingAfterHistory {n : ℕ}
    {H : Finset (Edge n)} {t : ℕ} (e : DeletionHistory H t) :
    (remainingAfterHistory e).card = H.card - t := by
  rw [remainingAfterHistory, Finset.card_sdiff,
    Finset.inter_eq_left.mpr (historyEdges_subset e), card_historyEdges]

lemma remainingAfterHistory_subset {n : ℕ}
    {H : Finset (Edge n)} {t : ℕ} (e : DeletionHistory H t) :
    remainingAfterHistory e ⊆ H :=
  Finset.sdiff_subset

/-- The first `k` edges in a deletion history. -/
def historyPrefixEdges {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) (k : ℕ) (hk : k ≤ t) :
    Finset (Edge n) :=
  Finset.univ.image (fun i : Fin k ↦ (e (Fin.castLE hk i)).1)

@[simp] lemma card_historyPrefixEdges {n : ℕ} {H : Finset (Edge n)}
    {t k : ℕ} (e : DeletionHistory H t) (hk : k ≤ t) :
    (historyPrefixEdges e k hk).card = k := by
  rw [historyPrefixEdges, Finset.card_image_of_injective]
  · simp
  · intro i j hij
    apply Fin.castLE_injective hk
    exact e.injective (Subtype.ext hij)

lemma historyPrefixEdges_subset {n : ℕ} {H : Finset (Edge n)}
    {t k : ℕ} (e : DeletionHistory H t) (hk : k ≤ t) :
    historyPrefixEdges e k hk ⊆ H := by
  intro A hA
  rcases Finset.mem_image.mp hA with ⟨i, -, rfl⟩
  exact (e (Fin.castLE hk i)).2

/-- The state of the hypergraph after the first `k` deletions. -/
def historyState {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) (k : ℕ) (hk : k ≤ t) :
    Finset (Edge n) :=
  H \ historyPrefixEdges e k hk

@[simp] lemma card_historyState {n : ℕ} {H : Finset (Edge n)}
    {t k : ℕ} (e : DeletionHistory H t) (hk : k ≤ t) :
    (historyState e k hk).card = H.card - k := by
  rw [historyState, Finset.card_sdiff,
    Finset.inter_eq_left.mpr (historyPrefixEdges_subset e hk),
    card_historyPrefixEdges]

@[simp] lemma historyState_zero {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) :
    historyState e 0 (Nat.zero_le t) = H := by
  ext A
  simp [historyState, historyPrefixEdges]

lemma historyPrefixEdges_succ {n : ℕ} {H : Finset (Edge n)}
    {t k : ℕ} (e : DeletionHistory H t) (hk : k < t) :
    historyPrefixEdges e (k + 1) hk =
      insert (e ⟨k, hk⟩).1 (historyPrefixEdges e k hk.le) := by
  ext A
  simp only [historyPrefixEdges, Finset.mem_image, Finset.mem_univ,
    true_and, Finset.mem_insert]
  constructor
  · rintro ⟨i, hiA⟩
    by_cases hik : i.1 < k
    · right
      refine ⟨⟨i.1, hik⟩, ?_⟩
      have hfin : Fin.castLE hk.le ⟨i.1, hik⟩ =
          Fin.castLE hk i := by
        apply Fin.ext
        rfl
      simpa [hfin] using hiA
    · left
      have hik' : i.1 = k := by omega
      have hfin : (⟨k, hk⟩ : Fin t) = Fin.castLE hk i := by
        apply Fin.ext
        exact hik'.symm
      simpa [hfin] using hiA.symm
  · rintro (hA | ⟨i, hiA⟩)
    · refine ⟨⟨k, by omega⟩, ?_⟩
      have hfin : Fin.castLE hk (⟨k, by omega⟩ : Fin (k + 1)) =
          (⟨k, hk⟩ : Fin t) := by
        apply Fin.ext
        rfl
      simpa [hfin] using hA.symm
    · refine ⟨i.castSucc, ?_⟩
      have hfin : Fin.castLE hk i.castSucc = Fin.castLE hk.le i := by
        apply Fin.ext
        rfl
      simpa [hfin] using hiA

/-- One more history step is exactly erasure of the next edge. -/
lemma historyState_succ {n : ℕ} {H : Finset (Edge n)}
    {t k : ℕ} (e : DeletionHistory H t) (hk : k < t) :
    historyState e (k + 1) hk =
      (historyState e k hk.le).erase (e ⟨k, hk⟩).1 := by
  ext A
  simp only [historyState, historyPrefixEdges_succ e hk,
    Finset.mem_sdiff, Finset.mem_erase, Finset.mem_insert, not_or]
  constructor
  · rintro ⟨hAH, hAcur, hAprefix⟩
    exact ⟨hAcur, hAH, hAprefix⟩
  · rintro ⟨hAcur, hAH, hAprefix⟩
    exact ⟨hAH, hAcur, hAprefix⟩

/-- The surviving matching fraction at deletion time `i`; outside the
history it is defined to be one so that products need no proof arguments. -/
def historyDeletionFactor {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) (i : ℕ) : ℝ :=
  if hi : i < t then
    1 - matchingFraction (historyState e i hi.le) (e ⟨i, hi⟩).1
  else 1

/-- Product of the first `k` surviving matching fractions. -/
def historyDeletionProduct {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) (k : ℕ) : ℝ :=
  ∏ i ∈ Finset.range k, historyDeletionFactor e i

/-- Process-level form of the exact deletion telescoping identity. -/
lemma card_historyState_eq_mul_historyDeletionProduct {n : ℕ}
    {H : Finset (Edge n)} {t : ℕ} (e : DeletionHistory H t)
    (k : ℕ) (hk : k ≤ t) :
    ((perfectMatchings n (historyState e k hk)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) * historyDeletionProduct e k := by
  induction k with
  | zero => simp [historyDeletionProduct, historyState_zero]
  | succ k ih =>
      have hkt : k < t := Nat.lt_of_succ_le hk
      rw [historyState_succ e hkt, card_perfectMatchings_erase_mul,
        ih hkt.le]
      unfold historyDeletionProduct
      rw [Finset.prod_range_succ]
      simp [historyDeletionFactor, hkt]
      ring

/-- Surviving-factor process for completion matchings through an arbitrary
triple `Z`. -/
def completionHistoryDeletionFactor {n : ℕ} {H : Finset (Edge n)}
    {t : ℕ} (Z : Edge n) (e : DeletionHistory H t) (i : ℕ) : ℝ :=
  if hi : i < t then
    1 - completionDeletionFraction (historyState e i hi.le) Z
      (e ⟨i, hi⟩).1
  else 1

/-- Product of completion-matching survival factors along a deletion
history. -/
def completionHistoryDeletionProduct {n : ℕ} {H : Finset (Edge n)}
    {t : ℕ} (Z : Edge n) (e : DeletionHistory H t) (k : ℕ) : ℝ :=
  ∏ i ∈ Finset.range k, completionHistoryDeletionFactor Z e i

/-- Exact telescoping identity for the completion weight family. -/
lemma card_completionHistoryState_eq_mul_product {n : ℕ}
    {H : Finset (Edge n)} {t : ℕ} (Z : Edge n)
    (e : DeletionHistory H t) (k : ℕ) (hk : k ≤ t) :
    ((completionMatchings n (historyState e k hk) Z).card : ℝ) =
      ((completionMatchings n H Z).card : ℝ) *
        completionHistoryDeletionProduct Z e k := by
  induction k with
  | zero => simp [completionHistoryDeletionProduct, historyState_zero]
  | succ k ih =>
      have hkt : k < t := Nat.lt_of_succ_le hk
      rw [historyState_succ e hkt,
        card_completionMatchings_erase_mul, ih hkt.le]
      unfold completionHistoryDeletionProduct
      rw [Finset.prod_range_succ]
      simp [completionHistoryDeletionFactor, hkt]
      ring

/-- The same telescope stated directly for arbitrary-triple completion
weights. -/
lemma completionWeight_historyState_eq_mul_product {n : ℕ}
    {H : Finset (Edge n)} {t : ℕ} (Z : Edge n)
    (e : DeletionHistory H t) (k : ℕ) (hk : k ≤ t)
    (hn : 0 < n) (hZ : Z ∈ allEdges n) :
    (completionWeight (historyState e k hk) Z : ℝ) =
      (completionWeight H Z : ℝ) *
        completionHistoryDeletionProduct Z e k := by
  rw [completionWeight_eq_card_completionMatchings _ _ hn hZ,
    completionWeight_eq_card_completionMatchings _ _ hn hZ]
  exact card_completionHistoryState_eq_mul_product Z e k hk

lemma historyPrefixEdges_top {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) :
    historyPrefixEdges e t le_rfl = historyEdges e := by
  ext A
  simp [historyPrefixEdges, historyEdges]

@[simp] lemma historyState_top {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) :
    historyState e t le_rfl = remainingAfterHistory e := by
  rw [historyState, remainingAfterHistory, historyPrefixEdges_top]

noncomputable def historyRangeIndex {n : ℕ} {H : Finset (Edge n)}
    {t : ℕ} (e : DeletionHistory H t) (A : ↥(historyEdges e)) : Fin t :=
  Classical.choose (Finset.mem_image.mp A.2)

lemma historyRangeIndex_spec {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) (A : ↥(historyEdges e)) :
    (e (historyRangeIndex e A)).1 = A.1 := by
  exact (Classical.choose_spec (Finset.mem_image.mp A.2)).2

/-- A history is a bijection from its time indices onto its range. -/
noncomputable def historyRangeEquiv {n : ℕ} {H : Finset (Edge n)}
    {t : ℕ} (e : DeletionHistory H t) : Fin t ≃ ↥(historyEdges e) where
  toFun i := ⟨(e i).1, Finset.mem_image.mpr
    ⟨i, Finset.mem_univ i, rfl⟩⟩
  invFun := historyRangeIndex e
  left_inv i := by
    apply e.injective
    apply Subtype.ext
    exact historyRangeIndex_spec e _
  right_inv A := by
    apply Subtype.ext
    exact historyRangeIndex_spec e A

@[simp] lemma historyRangeEquiv_apply {n : ℕ} {H : Finset (Edge n)}
    {t : ℕ} (e : DeletionHistory H t) (i : Fin t) :
    (historyRangeEquiv e i).1 = (e i).1 := by
  rfl

/-- The elements of `H` outside the range of a history are precisely the
edges in its final state. -/
def availableEdgeEquiv {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (e : DeletionHistory H t) :
    {A : ↥H // A ∉ Set.range e} ≃ ↥(historyState e t le_rfl) where
  toFun A := by
    refine ⟨A.1.1, Finset.mem_sdiff.mpr ⟨A.1.2, ?_⟩⟩
    intro hmem
    rcases Finset.mem_image.mp hmem with ⟨i, -, hi⟩
    exact A.2 ⟨i, Subtype.ext hi⟩
  invFun A := by
    refine ⟨⟨A.1, (Finset.mem_sdiff.mp A.2).1⟩, ?_⟩
    rintro ⟨i, hi⟩
    apply (Finset.mem_sdiff.mp A.2).2
    exact Finset.mem_image.mpr
      ⟨i, Finset.mem_univ _, congrArg (fun z : ↥H ↦ z.1) hi⟩
  left_inv A := by rfl
  right_inv A := by rfl

/-- Decompose an ordered history into its prefix and its last, uniformly
available, edge. -/
def historySuccEquiv {n : ℕ} (H : Finset (Edge n)) (t : ℕ) :
    DeletionHistory H (t + 1) ≃
      (e : DeletionHistory H t) × ↥(historyState e t le_rfl) :=
  (Equiv.embeddingFinSucc t ↥H).trans
    (Equiv.sigmaCongrRight fun e ↦ availableEdgeEquiv e)

@[simp] lemma historySuccEquiv_symm_zero {n : ℕ}
    (H : Finset (Edge n)) (t : ℕ) (e : DeletionHistory H t)
    (A : ↥(historyState e t le_rfl)) :
    (((historySuccEquiv H t).symm ⟨e, A⟩)
      ⟨0, Nat.succ_pos t⟩).1 = A.1 := by
  rfl

@[simp] lemma historySuccEquiv_symm_succ {n : ℕ}
    (H : Finset (Edge n)) (t : ℕ) (e : DeletionHistory H t)
    (A : ↥(historyState e t le_rfl)) (i : Fin t) :
    (((historySuccEquiv H t).symm ⟨e, A⟩) i.succ).1 = (e i).1 := by
  rfl

/-- Adding the extracted edge to a prefix history erases exactly that edge
from the prefix's final state. -/
lemma historyState_historySuccEquiv_symm {n : ℕ}
    (H : Finset (Edge n)) (t : ℕ) (e : DeletionHistory H t)
    (A : ↥(historyState e t le_rfl)) :
    historyState ((historySuccEquiv H t).symm ⟨e, A⟩)
        (t + 1) le_rfl = (historyState e t le_rfl).erase A.1 := by
  ext B
  simp only [historyState, historyPrefixEdges, Finset.mem_sdiff,
    Finset.mem_image, Finset.mem_univ, true_and, Finset.mem_erase,
    Fin.castLE_rfl, id_eq]
  constructor
  · rintro ⟨hBH, hnone⟩
    refine ⟨?_, hBH, ?_⟩
    · intro hBA
      apply hnone
      refine ⟨⟨0, Nat.succ_pos t⟩, ?_⟩
      calc
        (((historySuccEquiv H t).symm ⟨e, A⟩)
            ⟨0, Nat.succ_pos t⟩).1 = A.1 :=
          historySuccEquiv_symm_zero H t e A
        _ = B := hBA.symm
    · rintro ⟨i, hi⟩
      apply hnone
      refine ⟨i.succ, ?_⟩
      calc
        (((historySuccEquiv H t).symm ⟨e, A⟩) i.succ).1 =
            (e i).1 := historySuccEquiv_symm_succ H t e A i
        _ = B := hi
  · rintro ⟨hBA, hBH, hnone⟩
    refine ⟨hBH, ?_⟩
    rintro ⟨i, hi⟩
    revert hi
    refine Fin.cases ?_ (fun j hi ↦ ?_) i
    · intro hi
      apply hBA
      calc
        B = (((historySuccEquiv H t).symm ⟨e, A⟩)
            ⟨0, Nat.succ_pos t⟩).1 := hi.symm
        _ = A.1 := historySuccEquiv_symm_zero H t e A
    · apply hnone
      refine ⟨j, ?_⟩
      calc
        (e j).1 = (((historySuccEquiv H t).symm ⟨e, A⟩) j.succ).1 :=
          (historySuccEquiv_symm_succ H t e A j).symm
        _ = B := hi

/-- Uniform average over a nonempty finite set, used for the conditional
laws in the deletion process. -/
def finsetAverage {α : Type*} (s : Finset α) (f : α → ℝ) : ℝ :=
  (∑ x ∈ s, f x) / s.card

/-- An ordered sample of `t` independent uniform draws from a finite set.
This with-replacement model is coupled to deletion samples in Kahn's
global-spreading argument. -/
abbrev IidSample {α : Type*} (s : Finset α) (t : ℕ) :=
  Fin t → ↥s

/-- The iid samples with no repeated draw. -/
def injectiveIidSamples {α : Type*} (s : Finset α) (t : ℕ) :
    Finset (IidSample s t) :=
  (Finset.univ : Finset (IidSample s t)).filter Function.Injective

/-- Conditioning an iid ordered sample to have distinct coordinates gives
exactly an embedding, i.e. uniform ordered sampling without replacement. -/
def injectiveIidEquiv {α : Type*} (s : Finset α) (t : ℕ) :
    ↥(injectiveIidSamples s t) ≃ (Fin t ↪ ↥s) where
  toFun ω := ⟨ω.1, (Finset.mem_filter.mp ω.2).2⟩
  invFun e := ⟨e, Finset.mem_filter.mpr ⟨Finset.mem_univ _, e.injective⟩⟩
  left_inv ω := by
    apply Subtype.ext
    rfl
  right_inv e := by
    apply Function.Embedding.ext
    intro i
    rfl

/-- Sum of a statistic over an iid ordered sample. -/
def iidSum {α : Type*} {s : Finset α} (W : α → ℝ) (t : ℕ)
    (ω : IidSample s t) : ℝ :=
  ∑ i : Fin t, W (ω i).1

/-- Number of coordinates of an ordered without-replacement sample that
land in `Y`. -/
def embeddingHitCount {α : Type*} {s : Finset α} {t : ℕ}
    (Y : Finset α) (e : Fin t ↪ ↥s) : ℕ :=
  ((Finset.univ : Finset (Fin t)).filter fun i ↦ (e i).1 ∈ Y).card

/-- In an ordered edge sample, the degree of a vertex in the sampled range
is exactly the hit count of the corresponding incident-edge block. -/
lemma vertexDegree_historyEdges_eq_hitCount {n t : ℕ}
    (e : DeletionHistory (allEdges n) t) (v : Vertex n) :
    vertexDegree (historyEdges e) v =
      embeddingHitCount (incidentEdges n v) e := by
  unfold vertexDegree
  let I : Finset (Fin t) :=
    (Finset.univ : Finset (Fin t)).filter
      (fun i ↦ (e i).1 ∈ incidentEdges n v)
  have hIcard : embeddingHitCount (incidentEdges n v) e = I.card := by
    unfold embeddingHitCount
    apply congrArg Finset.card
    dsimp [I]
    apply Finset.ext
    intro i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have heq :
      (historyEdges e).filter (fun A ↦ v ∈ A) =
        I.image (fun i ↦ (e i).1) := by
    dsimp [I]
    ext A
    simp only [historyEdges, Finset.mem_filter, Finset.mem_image,
      Finset.mem_univ, true_and]
    constructor
    · rintro ⟨⟨i, hi⟩, hvA⟩
      refine ⟨i, ?_, hi⟩
      exact Finset.mem_filter.mpr ⟨(e i).2, hi ▸ hvA⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, rfl⟩, (Finset.mem_filter.mp hi).2⟩
  have himage : (I.image (fun i ↦ (e i).1)).card = I.card := by
    apply Finset.card_image_of_injective I
    intro i j hij
    exact e.injective (Subtype.ext hij)
  exact (congrArg Finset.card heq).trans
    (himage.trans hIcard.symm)

/-- In an ordered edge sample, the codegree of two vertices is the hit
count of their common incident-edge block. -/
lemma vertexCodegree_historyEdges_eq_hitCount {n t : ℕ}
    (e : DeletionHistory (allEdges n) t) (u v : Vertex n) :
    vertexCodegree (historyEdges e) u v =
      embeddingHitCount (pairIncidentEdges n u v) e := by
  unfold vertexCodegree
  let I : Finset (Fin t) :=
    (Finset.univ : Finset (Fin t)).filter
      (fun i ↦ (e i).1 ∈ pairIncidentEdges n u v)
  have hIcard : embeddingHitCount (pairIncidentEdges n u v) e = I.card := by
    unfold embeddingHitCount
    apply congrArg Finset.card
    dsimp [I]
    apply Finset.ext
    intro i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have heq :
      (historyEdges e).filter (fun A ↦ u ∈ A ∧ v ∈ A) =
        I.image (fun i ↦ (e i).1) := by
    dsimp [I]
    ext A
    simp only [historyEdges, Finset.mem_filter, Finset.mem_image,
      Finset.mem_univ, true_and]
    constructor
    · rintro ⟨⟨i, hi⟩, huA, hvA⟩
      refine ⟨i, ?_, hi⟩
      exact Finset.mem_filter.mpr
        ⟨(e i).2, hi ▸ ⟨huA, hvA⟩⟩
    · rintro ⟨i, hi, rfl⟩
      have hp := (Finset.mem_filter.mp hi).2
      exact ⟨⟨i, rfl⟩, hp.1, hp.2⟩
  have himage : (I.image (fun i ↦ (e i).1)).card = I.card := by
    apply Finset.card_image_of_injective I
    intro i j hij
    exact e.injective (Subtype.ext hij)
  exact (congrArg Finset.card heq).trans
    (himage.trans hIcard.symm)

/-- The exponential moment of an iid sum factors exactly into the power of
the one-coordinate exponential moment. -/
lemma finsetAverage_exp_iidCenteredSum {α : Type*} (s : Finset α)
    (W : α → ℝ) (μ θ : ℝ) (t : ℕ) :
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (fun ω ↦ Real.exp (θ * (iidSum W t ω - t * μ))) =
      (finsetAverage s (fun x ↦ Real.exp (θ * (W x - μ)))) ^ t := by
  have hcenter : ∀ ω : IidSample s t,
      iidSum W t ω - t * μ = ∑ i : Fin t, (W (ω i).1 - μ) := by
    intro ω
    rw [iidSum, Finset.sum_sub_distrib]
    simp
  have hnum :
      ∑ ω : IidSample s t,
          Real.exp (θ * (iidSum W t ω - t * μ)) =
        (∑ x : ↥s, Real.exp (θ * (W x.1 - μ))) ^ t := by
    calc
      ∑ ω : IidSample s t,
          Real.exp (θ * (iidSum W t ω - t * μ)) =
          ∑ ω : IidSample s t,
            ∏ i : Fin t, Real.exp (θ * (W (ω i).1 - μ)) := by
        apply Finset.sum_congr rfl
        intro ω _
        rw [hcenter]
        simp_rw [Finset.mul_sum, Real.exp_sum]
      _ = ∏ _i : Fin t,
          ∑ x : ↥s, Real.exp (θ * (W x.1 - μ)) := by
        rw [Fintype.prod_sum]
      _ = (∑ x : ↥s, Real.exp (θ * (W x.1 - μ))) ^ t := by simp
  unfold finsetAverage
  rw [show ∑ ω ∈ (Finset.univ : Finset (IidSample s t)),
      Real.exp (θ * (iidSum W t ω - ↑t * μ)) =
        ∑ ω : IidSample s t,
          Real.exp (θ * (iidSum W t ω - ↑t * μ)) by simp,
    hnum]
  have hcard : (Finset.univ : Finset (IidSample s t)).card = s.card ^ t := by
    simp [Fintype.card_fun]
  rw [hcard]
  rw [div_pow]
  congr 1
  · rw [Finset.univ_eq_attach s,
      Finset.sum_attach s (fun x ↦ Real.exp (θ * (W x - μ)))]
  · norm_cast

lemma finsetAverage_attach {α : Type*} (s : Finset α) (f : α → ℝ) :
    finsetAverage (Finset.univ : Finset ↥s) (fun x ↦ f x.1) =
      finsetAverage s f := by
  unfold finsetAverage
  rw [Finset.univ_eq_attach s, Finset.sum_attach, Finset.card_attach]

lemma finsetAverage_mono {α : Type*} (s : Finset α) (f g : α → ℝ)
    (hfg : ∀ x ∈ s, f x ≤ g x) :
    finsetAverage s f ≤ finsetAverage s g := by
  unfold finsetAverage
  exact div_le_div_of_nonneg_right (Finset.sum_le_sum hfg) (by positivity)

lemma finsetAverage_mul_const {α : Type*} (s : Finset α)
    (f : α → ℝ) (c : ℝ) :
    finsetAverage s (fun x ↦ f x * c) = finsetAverage s f * c := by
  unfold finsetAverage
  rw [← Finset.sum_mul]
  ring

lemma sum_deletionHistory_succ {n : ℕ} (H : Finset (Edge n))
    (t : ℕ) (f : DeletionHistory H (t + 1) → ℝ) :
    ∑ e, f e =
      ∑ e : DeletionHistory H t,
        ∑ A : ↥(historyState e t le_rfl),
          f ((historySuccEquiv H t).symm ⟨e, A⟩) := by
  calc
    ∑ e, f e =
        ∑ z, f ((historySuccEquiv H t).symm z) := by
      symm
      exact Equiv.sum_comp (historySuccEquiv H t).symm f
    _ = ∑ e : DeletionHistory H t,
          ∑ A : ↥(historyState e t le_rfl),
            f ((historySuccEquiv H t).symm ⟨e, A⟩) := by
      rw [Fintype.sum_sigma]

lemma card_deletionHistory_succ {n : ℕ} (H : Finset (Edge n))
    (t : ℕ) :
    Fintype.card (DeletionHistory H (t + 1)) =
      Fintype.card (DeletionHistory H t) * (H.card - t) := by
  rw [Fintype.card_congr (historySuccEquiv H t), Fintype.card_sigma]
  simp only [Fintype.card_coe, card_historyState]
  simp

lemma deletionHistory_nonempty_of_card_le {n : ℕ}
    (H : Finset (Edge n)) (t : ℕ) (ht : t ≤ H.card) :
    Nonempty (DeletionHistory H t) := by
  let q := Fintype.equivFin ↥H
  have ht' : t ≤ Fintype.card ↥H := by simpa using ht
  let e : DeletionHistory H t :=
    { toFun := fun i ↦ q.symm (Fin.castLE ht' i)
      inj' := by
        intro i j hij
        exact Fin.castLE_injective ht' (q.symm.injective hij) }
  exact ⟨e⟩

/-- Uniform averaging over successor histories is iterated uniform averaging:
first over the prefix, then over the currently available edge. -/
lemma finsetAverage_deletionHistory_succ {n : ℕ}
    (H : Finset (Edge n)) (t : ℕ) (ht : t < H.card)
    (f : DeletionHistory H (t + 1) → ℝ) :
    finsetAverage (Finset.univ : Finset (DeletionHistory H (t + 1))) f =
      finsetAverage (Finset.univ : Finset (DeletionHistory H t))
        (fun e ↦ finsetAverage
          (Finset.univ : Finset ↥(historyState e t le_rfl))
          (fun A ↦ f ((historySuccEquiv H t).symm ⟨e, A⟩))) := by
  have hdNat : 0 < H.card - t := Nat.sub_pos_of_lt ht
  have hprevNat : 0 < Fintype.card (DeletionHistory H t) :=
    Fintype.card_pos_iff.mpr (deletionHistory_nonempty_of_card_le H t ht.le)
  have hd : (0 : ℝ) < ((H.card - t : ℕ) : ℝ) := by
    exact_mod_cast hdNat
  have hprev : (0 : ℝ) < Fintype.card (DeletionHistory H t) := by
    exact_mod_cast hprevNat
  unfold finsetAverage
  simp only [Finset.card_univ, Fintype.card_coe, card_historyState]
  rw [sum_deletionHistory_succ, card_deletionHistory_succ]
  rw [← Finset.sum_div]
  field_simp [hd.ne', hprev.ne']
  norm_num only [Nat.cast_mul]
  ring

/-- A choice of the `M` edges which remain, packaged as a finite type. -/
abbrev RemainingChoice {n : ℕ} (H : Finset (Edge n)) (M : ℕ) :=
  ↥(H.powersetCard M)

/-- The finite probability space used for the deletion argument: first
choose the remaining `M`-edge graph and then a uniform ordering tag for its
complement.  The second factor has the same cardinality for every choice,
so forgetting it is exactly uniform on `H.powersetCard M`. -/
abbrev OrderedDeletionSample {n : ℕ} (H : Finset (Edge n)) (M : ℕ) :=
  RemainingChoice H M × Equiv.Perm (Fin (H.card - M))

def orderedRemaining {n : ℕ} {H : Finset (Edge n)} {M : ℕ}
    (ω : OrderedDeletionSample H M) : Finset (Edge n) :=
  ω.1.1

lemma orderedRemaining_subset {n : ℕ} {H : Finset (Edge n)} {M : ℕ}
    (ω : OrderedDeletionSample H M) :
    orderedRemaining ω ⊆ H := by
  exact (Finset.mem_powersetCard.mp ω.1.2).1

@[simp] lemma card_orderedRemaining {n : ℕ} {H : Finset (Edge n)} {M : ℕ}
    (ω : OrderedDeletionSample H M) :
    (orderedRemaining ω).card = M := by
  exact (Finset.mem_powersetCard.mp ω.1.2).2

@[simp] lemma card_orderedDeletionComplement {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (ω : OrderedDeletionSample H M) :
    (H \ orderedRemaining ω).card = H.card - M := by
  rw [Finset.card_sdiff,
    Finset.inter_eq_left.mpr (orderedRemaining_subset ω),
    card_orderedRemaining]

/-- A canonical identification of the deletion times with the complement
of the chosen remaining graph. -/
noncomputable def orderedComplementEquiv {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (ω : OrderedDeletionSample H M) :
    Fin (H.card - M) ≃ ↥(H \ orderedRemaining ω) :=
  Fintype.equivOfCardEq (by
    rw [Fintype.card_fin, Fintype.card_coe,
      card_orderedDeletionComplement])

lemma orderedComplementEquiv_order_irrel {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (G : RemainingChoice H M)
    (p q : Equiv.Perm (Fin (H.card - M))) :
    orderedComplementEquiv (G, p) = orderedComplementEquiv (G, q) := by
  rfl

/-- The actual ordered history represented by an ordered deletion sample. -/
noncomputable def orderedDeletionHistory {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (ω : OrderedDeletionSample H M) :
    DeletionHistory H (H.card - M) where
  toFun i :=
    ⟨((orderedComplementEquiv ω) (ω.2 i)).1,
      (Finset.mem_sdiff.mp ((orderedComplementEquiv ω) (ω.2 i)).2).1⟩
  inj' := by
    intro i j hij
    apply ω.2.injective
    apply (orderedComplementEquiv ω).injective
    have hedge :
        ((orderedComplementEquiv ω) (ω.2 i)).1 =
          ((orderedComplementEquiv ω) (ω.2 j)).1 :=
      congrArg (fun z : ↥H ↦ z.1) hij
    exact Subtype.ext hedge

lemma historyEdges_orderedDeletionHistory {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (ω : OrderedDeletionSample H M) :
    historyEdges (orderedDeletionHistory ω) = H \ orderedRemaining ω := by
  apply Finset.eq_of_subset_of_card_le
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, -, rfl⟩
    exact ((orderedComplementEquiv ω) (ω.2 i)).2
  · rw [card_historyEdges, card_orderedDeletionComplement]

@[simp] lemma remainingAfter_orderedDeletionHistory {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (ω : OrderedDeletionSample H M) :
    remainingAfterHistory (orderedDeletionHistory ω) = orderedRemaining ω := by
  rw [remainingAfterHistory, historyEdges_orderedDeletionHistory]
  exact Finset.sdiff_sdiff_eq_self (orderedRemaining_subset ω)

/-- The remaining graph recovered from a deletion history. -/
def historyRemainingChoice {n : ℕ} {H : Finset (Edge n)} {M : ℕ}
    (hM : M ≤ H.card) (e : DeletionHistory H (H.card - M)) :
    RemainingChoice H M :=
  ⟨remainingAfterHistory e, by
    rw [Finset.mem_powersetCard]
    exact ⟨remainingAfterHistory_subset e, by
      rw [card_remainingAfterHistory]
      omega⟩⟩

noncomputable def historyBaseSample {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (hM : M ≤ H.card)
    (e : DeletionHistory H (H.card - M)) : OrderedDeletionSample H M :=
  ⟨historyRemainingChoice hM e, Equiv.refl (Fin (H.card - M))⟩

def historyRangeComplementEquiv {n : ℕ} {H : Finset (Edge n)}
    {M : ℕ} (e : DeletionHistory H (H.card - M)) :
    ↥(historyEdges e) ≃ ↥(H \ remainingAfterHistory e) where
  toFun A := ⟨A.1, by
    rw [remainingAfterHistory,
      Finset.sdiff_sdiff_eq_self (historyEdges_subset e)]
    exact A.2⟩
  invFun A := ⟨A.1, by
    rw [← Finset.sdiff_sdiff_eq_self (historyEdges_subset e)]
    exact A.2⟩
  left_inv A := by rfl
  right_inv A := by rfl

/-- The unique permutation tag which makes the canonical complement order
agree with the given history. -/
noncomputable def historyOrderPermutation {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (hM : M ≤ H.card)
    (e : DeletionHistory H (H.card - M)) :
    Equiv.Perm (Fin (H.card - M)) :=
  (historyRangeEquiv e).trans
    ((historyRangeComplementEquiv e).trans
      (orderedComplementEquiv (historyBaseSample hM e)).symm)

lemma orderedComplementEquiv_historyOrderPermutation_val {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (hM : M ≤ H.card)
    (e : DeletionHistory H (H.card - M)) (i : Fin (H.card - M)) :
    ((orderedComplementEquiv (historyBaseSample hM e))
      (historyOrderPermutation hM e i)).1 = (e i).1 := by
  let q : Fin (H.card - M) ≃ ↥(H \ remainingAfterHistory e) :=
    orderedComplementEquiv (historyBaseSample hM e)
  change (q (q.symm
    (historyRangeComplementEquiv e (historyRangeEquiv e i)))).1 = (e i).1
  rw [Equiv.apply_symm_apply]
  rfl

/-- Recover the remaining graph and ordering tag from a deletion history. -/
noncomputable def orderedSampleOfHistory {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (hM : M ≤ H.card)
    (e : DeletionHistory H (H.card - M)) : OrderedDeletionSample H M :=
  ⟨historyRemainingChoice hM e, historyOrderPermutation hM e⟩

@[simp] lemma orderedDeletionHistory_orderedSampleOfHistory {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (hM : M ≤ H.card)
    (e : DeletionHistory H (H.card - M)) :
    orderedDeletionHistory (orderedSampleOfHistory hM e) = e := by
  apply Function.Embedding.ext
  intro i
  apply Subtype.ext
  change ((orderedComplementEquiv
      (historyRemainingChoice hM e, historyOrderPermutation hM e))
    (historyOrderPermutation hM e i)).1 = (e i).1
  rw [orderedComplementEquiv_order_irrel (historyRemainingChoice hM e)
    (historyOrderPermutation hM e)
    (Equiv.refl (Fin (H.card - M)))]
  exact orderedComplementEquiv_historyOrderPermutation_val hM e i

lemma card_orderedDeletionSample_eq_history {n : ℕ}
    (H : Finset (Edge n)) (M : ℕ) (hM : M ≤ H.card) :
    Fintype.card (OrderedDeletionSample H M) =
      Fintype.card (DeletionHistory H (H.card - M)) := by
  rw [Fintype.card_prod, Fintype.card_coe, Finset.card_powersetCard,
    Fintype.card_perm, Fintype.card_embedding_eq,
    Nat.descFactorial_eq_factorial_mul_choose]
  simp only [Fintype.card_fin, Fintype.card_coe]
  rw [Nat.choose_symm hM]
  ac_rfl

/-- The two exact finite models of a uniform ordered deletion process are
equivalent. -/
noncomputable def orderedDeletionEquiv {n : ℕ}
    (H : Finset (Edge n)) (M : ℕ) (hM : M ≤ H.card) :
    OrderedDeletionSample H M ≃ DeletionHistory H (H.card - M) :=
  Equiv.ofBijective orderedDeletionHistory
    ((Fintype.bijective_iff_surjective_and_card orderedDeletionHistory).2
      ⟨fun e ↦ ⟨orderedSampleOfHistory hM e,
          orderedDeletionHistory_orderedSampleOfHistory hM e⟩,
        card_orderedDeletionSample_eq_history H M hM⟩)

@[simp] lemma orderedDeletionEquiv_apply {n : ℕ}
    (H : Finset (Edge n)) (M : ℕ) (hM : M ≤ H.card)
    (ω : OrderedDeletionSample H M) :
    orderedDeletionEquiv H M hM ω = orderedDeletionHistory ω := by
  rw [orderedDeletionEquiv, Equiv.ofBijective_apply]

/-- The proportion of a finite uniform sample satisfying a predicate. -/
def finsetProbability {α : Type*} (s : Finset α) (P : α → Prop)
    [DecidablePred P] : ℝ :=
  (s.filter P).card / s.card

lemma finsetProbability_mono_event {α : Type*} (s : Finset α)
    (P Q : α → Prop) [DecidablePred P] [DecidablePred Q]
    (hPQ : ∀ x ∈ s, P x → Q x) :
    finsetProbability s P ≤ finsetProbability s Q := by
  unfold finsetProbability
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact_mod_cast Finset.card_le_card (fun x hx ↦
    Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hx).1,
      hPQ x (Finset.mem_filter.mp hx).1 (Finset.mem_filter.mp hx).2⟩)

/-- Finite uniform probabilities depend only on the event, not on its
particular decidability implementation. -/
lemma finsetProbability_congr_event {α : Type*} (s : Finset α)
    (P Q : α → Prop) [DecidablePred P] [DecidablePred Q]
    (hPQ : ∀ x ∈ s, P x ↔ Q x) :
    finsetProbability s P = finsetProbability s Q := by
  unfold finsetProbability
  rw [Finset.filter_congr hPQ]

lemma finsetProbability_univ_equiv {α β : Type*} [Fintype α] [Fintype β]
    (e : α ≃ β) (P : β → Prop) [DecidablePred P] :
    finsetProbability (Finset.univ : Finset α) (fun x ↦ P (e x)) =
      finsetProbability (Finset.univ : Finset β) P := by
  have hgood :
      ((Finset.univ : Finset α).filter (fun x ↦ P (e x))).card =
        ((Finset.univ : Finset β).filter P).card := by
    refine Finset.card_bij
      (s := (Finset.univ : Finset α).filter (fun x ↦ P (e x)))
      (t := (Finset.univ : Finset β).filter P)
      (fun x _ ↦ e x) ?_ ?_ ?_
    · intro x hx
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_univ _, (Finset.mem_filter.mp hx).2⟩
    · intro x₁ _ x₂ _ hx
      exact e.injective hx
    · intro y hy
      refine ⟨e.symm y, Finset.mem_filter.mpr
        ⟨Finset.mem_univ _, by simpa using (Finset.mem_filter.mp hy).2⟩, ?_⟩
      simp
  have htotal : (Finset.univ : Finset α).card =
      (Finset.univ : Finset β).card := by
    simpa only [Finset.card_univ] using Fintype.card_congr e
  unfold finsetProbability
  rw [hgood, htotal]

/-- An event on without-replacement samples, viewed as an event on iid
samples by requiring the iid sample to be injective. -/
def iidLiftedEvent {α : Type*} {s : Finset α} {t : ℕ}
    (P : (Fin t ↪ ↥s) → Prop) (ω : IidSample s t) : Prop :=
  ∃ hω : Function.Injective ω, P ⟨ω, hω⟩

private lemma card_iidLiftedEvent {α : Type*} (s : Finset α) (t : ℕ)
    (P : (Fin t ↪ ↥s) → Prop) [DecidablePred P] :
    ((Finset.univ : Finset (IidSample s t)).filter (iidLiftedEvent P)).card =
      ((Finset.univ : Finset (Fin t ↪ ↥s)).filter P).card := by
  symm
  refine Finset.card_bij
    (s := (Finset.univ : Finset (Fin t ↪ ↥s)).filter P)
    (t := (Finset.univ : Finset (IidSample s t)).filter (iidLiftedEvent P))
    (fun e _ ↦ e.1) ?_ ?_ ?_
  · intro e he
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
      ⟨e.injective, (Finset.mem_filter.mp he).2⟩⟩
  · intro e₁ _ e₂ _ he
    exact Function.Embedding.ext (congrFun he)
  · intro ω hω
    obtain ⟨hinj, hP⟩ := (Finset.mem_filter.mp hω).2
    let e : Fin t ↪ ↥s := ⟨ω, hinj⟩
    exact ⟨e, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hP⟩, rfl⟩

lemma card_injectiveIidSamples_eq_embedding {α : Type*}
    (s : Finset α) (t : ℕ) :
    (injectiveIidSamples s t).card =
      (Finset.univ : Finset (Fin t ↪ ↥s)).card := by
  simpa only [Finset.card_univ, Fintype.card_coe] using
    Fintype.card_congr (injectiveIidEquiv s t)

/-- Exact conditioning identity: without-replacement probability times the
probability that an iid sample is collision-free equals the iid probability
of the lifted event. -/
lemma probability_embedding_mul_injective_eq_iid {α : Type*}
    (s : Finset α) (t : ℕ) (P : (Fin t ↪ ↥s) → Prop)
    [DecidablePred P] :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P *
        finsetProbability (Finset.univ : Finset (IidSample s t))
          Function.Injective =
      finsetProbability (Finset.univ : Finset (IidSample s t))
        (iidLiftedEvent P) := by
  unfold finsetProbability
  rw [show (Finset.univ : Finset (IidSample s t)).filter
        Function.Injective = injectiveIidSamples s t by rfl,
    card_injectiveIidSamples_eq_embedding s t,
    card_iidLiftedEvent s t P]
  by_cases hE :
      (((Finset.univ : Finset (Fin t ↪ ↥s)).card : ℝ)) = 0
  · have hEnat : (Finset.univ : Finset (Fin t ↪ ↥s)).card = 0 := by
      exact_mod_cast hE
    have hEempty : (Finset.univ : Finset (Fin t ↪ ↥s)) = ∅ :=
      Finset.card_eq_zero.mp hEnat
    simp [hEempty]
  · field_simp [hE]

lemma probability_embedding_le_iid_div {α : Type*}
    (s : Finset α) (t : ℕ) (P : (Fin t ↪ ↥s) → Prop)
    [DecidablePred P] (c : ℝ) (hc : 0 < c)
    (hinj : c ≤ finsetProbability
      (Finset.univ : Finset (IidSample s t)) Function.Injective) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤
      finsetProbability (Finset.univ : Finset (IidSample s t))
        (iidLiftedEvent P) / c := by
  let p := finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P
  let q := finsetProbability (Finset.univ : Finset (IidSample s t))
    Function.Injective
  let r := finsetProbability (Finset.univ : Finset (IidSample s t))
    (iidLiftedEvent P)
  have hp : 0 ≤ p := by
    unfold p finsetProbability
    positivity
  have heq : p * q = r := by
    simpa [p, q, r] using probability_embedding_mul_injective_eq_iid s t P
  apply (le_div_iff₀ hc).2
  calc
    p * c ≤ p * q := mul_le_mul_of_nonneg_left hinj hp
    _ = r := heq

/-- Elementary birthday-product lower bound. -/
lemma one_sub_sq_div_le_descFactorial_ratio (k t : ℕ)
    (htk : t * t ≤ k) :
    1 - (t : ℝ)^2 / k ≤
      (k.descFactorial t : ℝ) / (k : ℝ)^t := by
  by_cases hk0 : k = 0
  · have htt : t * t = 0 := by
      apply Nat.eq_zero_of_le_zero
      simpa [hk0] using htk
    have ht0 : t = 0 := by
      rcases Nat.mul_eq_zero.mp htt with h | h <;> exact h
    simp [hk0, ht0]
  have hkR : (0 : ℝ) < k := by exact_mod_cast Nat.pos_of_ne_zero hk0
  induction t with
  | zero => simp
  | succ t ih =>
      have htprev : t * t ≤ k := by
        exact (Nat.mul_le_mul (Nat.le_succ t) (Nat.le_succ t)).trans htk
      have htK : t ≤ k := by
        by_cases ht0 : t = 0
        · simp [ht0]
        · calc
            t = t * 1 := by simp
            _ ≤ t * t := Nat.mul_le_mul_left t
              (Nat.one_le_iff_ne_zero.mpr ht0)
            _ ≤ k := htprev
      have ih' := ih htprev
      have hfactor : 0 ≤ 1 - (t : ℝ) / k := by
        have : (t : ℝ) ≤ k := by exact_mod_cast htK
        exact sub_nonneg.mpr ((div_le_one hkR).2 this)
      have hmul := mul_le_mul_of_nonneg_left ih' hfactor
      have hleft :
          1 - ((t + 1 : ℕ) : ℝ)^2 / k ≤
            (1 - (t : ℝ) / k) * (1 - (t : ℝ)^2 / k) := by
        apply sub_nonneg.mp
        calc
          0 ≤ (t : ℝ)^3 / (k : ℝ)^2 + ((t : ℝ) + 1) / k := by
            positivity
          _ = (1 - (t : ℝ) / k) * (1 - (t : ℝ)^2 / k) -
                (1 - ((t + 1 : ℕ) : ℝ)^2 / k) := by
            norm_num only [Nat.cast_add, Nat.cast_one]
            field_simp [hkR.ne']
            ring
      have hright :
          (1 - (t : ℝ) / k) *
              ((k.descFactorial t : ℝ) / (k : ℝ)^t) =
            (k.descFactorial (t + 1) : ℝ) / (k : ℝ)^(t + 1) := by
        rw [Nat.descFactorial_succ, Nat.cast_mul, Nat.cast_sub htK,
          pow_succ]
        field_simp [hkR.ne']
      exact hleft.trans (hmul.trans_eq hright)

/-- Exact collision-free probability for `t` iid draws from `s`. -/
lemma iid_injective_probability_eq_descFactorial {α : Type*}
    (s : Finset α) (t : ℕ) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        Function.Injective =
      (s.card.descFactorial t : ℝ) / (s.card : ℝ) ^ t := by
  unfold finsetProbability
  rw [show (Finset.univ : Finset (IidSample s t)).filter
        Function.Injective = injectiveIidSamples s t by rfl,
    card_injectiveIidSamples_eq_embedding s t]
  rw [show (Finset.univ : Finset (Fin t ↪ ↥s)).card =
      s.card.descFactorial t by
        simpa only [Finset.card_univ, Fintype.card_fin, Fintype.card_coe]
          using (Fintype.card_embedding_eq (α := Fin t) (β := ↥s))]
  congr 1
  norm_cast
  simp

lemma half_le_iid_injective_probability {α : Type*}
    (s : Finset α) (t : ℕ) (ht : 2 * t * t ≤ s.card) :
    (1 : ℝ) / 2 ≤ finsetProbability
      (Finset.univ : Finset (IidSample s t)) Function.Injective := by
  rw [iid_injective_probability_eq_descFactorial]
  by_cases hs0 : s.card = 0
  · have htt : t * t = 0 := by
      apply Nat.eq_zero_of_le_zero
      have := ht
      simpa [hs0] using this
    have ht0 : t = 0 := by
      rcases Nat.mul_eq_zero.mp htt with h | h <;> exact h
    simp [hs0, ht0]
    norm_num
  have hsq : t * t ≤ s.card := by
    have hnonneg : 0 ≤ t * t := Nat.zero_le _
    nlinarith
  have hratio := one_sub_sq_div_le_descFactorial_ratio s.card t hsq
  have hcardpos : (0 : ℝ) < s.card := by
    exact_mod_cast Nat.pos_of_ne_zero hs0
  have htR : (2 : ℝ) * (t : ℝ)^2 ≤ s.card := by
    calc
      (2 : ℝ) * (t : ℝ)^2 = ((2 * t * t : ℕ) : ℝ) := by
        norm_num only [Nat.cast_mul, Nat.cast_ofNat]
        ring
      _ ≤ (s.card : ℝ) := by exact_mod_cast ht
  have hhalf : (t : ℝ)^2 / s.card ≤ 1 / 2 := by
    apply (div_le_iff₀ hcardpos).2
    nlinarith
  linarith

lemma orderedDeletion_probability_eq_history {n : ℕ}
    (H : Finset (Edge n)) (M : ℕ) (hM : M ≤ H.card)
    (P : DeletionHistory H (H.card - M) → Prop) [DecidablePred P] :
    finsetProbability (Finset.univ : Finset (OrderedDeletionSample H M))
        (fun ω ↦ P (orderedDeletionHistory ω)) =
      finsetProbability
        (Finset.univ : Finset (DeletionHistory H (H.card - M))) P := by
  simpa using finsetProbability_univ_equiv
    (orderedDeletionEquiv H M hM) P

lemma card_goodRemainingChoices (n M : ℕ) :
    ((Finset.univ : Finset (RemainingChoice (allEdges n) M)).filter
        (fun G ↦ HasPerfectMatching n G.1)).card =
      (goodSample n M).card := by
  refine Finset.card_bij
    (s := (Finset.univ : Finset (RemainingChoice (allEdges n) M)).filter
      (fun G ↦ HasPerfectMatching n G.1))
    (t := goodSample n M) (fun G _ ↦ G.1) ?_ ?_ ?_
  · intro G hG
    rw [Finset.mem_filter] at hG
    exact Finset.mem_filter.mpr ⟨by simpa [sample] using G.2, hG.2⟩
  · intro G₁ _ G₂ _ h
    exact Subtype.ext h
  · intro H hH
    have hsample : H ∈ sample n M := (Finset.mem_filter.mp hH).1
    refine ⟨⟨H, by simpa [sample] using hsample⟩, ?_, rfl⟩
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_univ _, (Finset.mem_filter.mp hH).2⟩

/-- Forgetting the deletion ordering gives exactly the original fixed-edge
probability space. -/
lemma orderedDeletionSample_pmProbability (n M : ℕ) :
    finsetProbability
        (Finset.univ : Finset (OrderedDeletionSample (allEdges n) M))
        (fun ω ↦ HasPerfectMatching n (orderedRemaining ω)) =
      pmProbability n M := by
  let A := RemainingChoice (allEdges n) M
  let B := Equiv.Perm (Fin ((allEdges n).card - M))
  have hfilter :
      (Finset.univ : Finset (A × B)).filter
          (fun ω ↦ HasPerfectMatching n ω.1.1) =
        ((Finset.univ : Finset A).filter
          (fun G ↦ HasPerfectMatching n G.1)).product
          (Finset.univ : Finset B) := by
    ext ω
    simp
  have hBpos : 0 < Fintype.card B :=
    Fintype.card_pos_iff.mpr ⟨Equiv.refl _⟩
  have hBne : ((Fintype.card B : ℕ) : ℝ) ≠ 0 := by
    exact_mod_cast hBpos.ne'
  have hAcard : Fintype.card A = (sample n M).card := by
    dsimp [A, RemainingChoice]
    rw [Fintype.card_coe]
    rfl
  have hprodcard :
      (((Finset.univ : Finset A).filter
          (fun G ↦ HasPerfectMatching n G.1)).product
        (Finset.univ : Finset B)).card =
      ((Finset.univ : Finset A).filter
          (fun G ↦ HasPerfectMatching n G.1)).card *
        (Finset.univ : Finset B).card :=
    Finset.card_product _ _
  unfold finsetProbability pmProbability
  change
    (((Finset.univ : Finset (A × B)).filter
        (fun ω ↦ HasPerfectMatching n ω.1.1)).card : ℝ) /
        ((Finset.univ : Finset (A × B)).card : ℝ) = _
  rw [hfilter, hprodcard, Finset.card_univ,
    Finset.card_univ, Fintype.card_prod, Nat.cast_mul, Nat.cast_mul,
    mul_div_mul_right _ _ hBne]
  rw [show
      ((Finset.univ : Finset A).filter
          (fun G ↦ HasPerfectMatching n G.1)).card =
        (goodSample n M).card by
      simpa [A] using card_goodRemainingChoices n M]
  rw [hAcard]

lemma pmProbability_eq_history_probability (n M : ℕ)
    (hM : M ≤ (allEdges n).card) :
    pmProbability n M =
      finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) ((allEdges n).card - M)))
        (fun e ↦ HasPerfectMatching n (remainingAfterHistory e)) := by
  calc
    pmProbability n M =
        finsetProbability
          (Finset.univ : Finset
            (OrderedDeletionSample (allEdges n) M))
          (fun ω ↦ HasPerfectMatching n (orderedRemaining ω)) :=
      (orderedDeletionSample_pmProbability n M).symm
    _ = finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) ((allEdges n).card - M)))
          (fun e ↦ HasPerfectMatching n (remainingAfterHistory e)) := by
      simpa using orderedDeletion_probability_eq_history
        (allEdges n) M hM
        (fun e ↦ HasPerfectMatching n (remainingAfterHistory e))

/-- The perfect-matching count of the sampled remaining graph is exactly
the initial count times all of the process survival factors. -/
lemma card_orderedRemaining_eq_mul_historyDeletionProduct {n : ℕ}
    {H : Finset (Edge n)} {M : ℕ} (ω : OrderedDeletionSample H M) :
    ((perfectMatchings n (orderedRemaining ω)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) *
        historyDeletionProduct (orderedDeletionHistory ω) (H.card - M) := by
  have htel := card_historyState_eq_mul_historyDeletionProduct
    (orderedDeletionHistory ω) (H.card - M) le_rfl
  simpa using htel

/-- The deterministic condition on matching weights used to stop Kahn's
deletion martingale. -/
def WeightControlled {n : ℕ} (H : Finset (Edge n)) (C : ℝ) : Prop :=
  ∀ A ∈ H,
    matchingFraction H A ≤ C * ((n : ℝ) / H.card)

/-- Controlled deletion influences for the completion-matching family
through `Z`. -/
def CompletionDeletionControlled {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (C : ℝ) : Prop :=
  ∀ A ∈ H,
    completionDeletionFraction H Z A ≤
      C * (((n - 1 : ℕ) : ℝ) / H.card)

/-- Fair one-step deletion fraction for completion matchings. -/
def completionDeletionMean (n : ℕ) (H : Finset (Edge n)) : ℝ :=
  ((n - 1 : ℕ) : ℝ) / H.card

/-- Deterministic completion-deletion mean at time `i`. -/
def completionDeletionGamma (n : ℕ) (H : Finset (Edge n))
    (i : ℕ) : ℝ :=
  ((n - 1 : ℕ) : ℝ) / ((H.card - i : ℕ) : ℝ)

@[simp] lemma completionDeletionMean_historyState {n : ℕ}
    {H : Finset (Edge n)} {t k : ℕ} (e : DeletionHistory H t)
    (hk : k ≤ t) :
    completionDeletionMean n (historyState e k hk) =
      completionDeletionGamma n H k := by
  simp [completionDeletionMean, completionDeletionGamma]

lemma average_completionDeletionFraction_eq_mean (n : ℕ)
    (H : Finset (Edge n)) (Z : Edge n)
    (hC : (completionMatchings n H Z).card ≠ 0) :
    finsetAverage H (completionDeletionFraction H Z) =
      completionDeletionMean n H := by
  simp only [finsetAverage, completionDeletionMean]
  rw [sum_completionDeletionFraction n H Z hC]

/-- Kahn's deterministic implication `𝔇 ∧ 𝔉 ⇒ 𝔅`, in the quantitative
finite form consumed by the stopped deletion martingale. -/
lemma weightControlled_of_global_spread {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (δ η q c : ℝ) (hn : 0 < n) (hc : 0 < c) (hqη : η < q)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (hspread : GlobalWeightSpread n H δ η)
    (hdom : GloballyDominatedWeights n H q c) :
    WeightControlled H ((1 + δ) / c) := by
  intro A hAH
  have hbound := completionWeight_bound_of_global_spread H δ η q c hn hqη
    hspread hdom (hH hAH)
  rw [completionWeight_eq_matchingWeight_of_mem H hAH] at hbound
  have hΦpos : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast Nat.pos_of_ne_zero hΦ
  have hw : (matchingWeight H A : ℝ) ≤
      ((1 + δ) * matchingWeightTarget n H) / c := by
    apply (le_div_iff₀ hc).2
    simpa [mul_comm] using hbound
  unfold matchingFraction
  apply (div_le_iff₀ hΦpos).2
  calc
    (matchingWeight H A : ℝ) ≤
        ((1 + δ) * matchingWeightTarget n H) / c := hw
    _ = ((1 + δ) / c * ((n : ℝ) / H.card)) *
          (perfectMatchings n H).card := by
      unfold matchingWeightTarget
      ring

/-- One-sided global spreading is already sufficient for the stopped
matching-deletion martingale. -/
lemma weightControlled_of_global_upper_spread {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (L eta q c : ℝ) (hn : 0 < n) (hc : 0 < c) (hqeta : eta < q)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (hspread : GlobalUpperWeightSpread n H L eta)
    (hdom : GloballyDominatedWeights n H q c) :
    WeightControlled H (L / c) := by
  intro A hAH
  have hbound := completionWeight_bound_of_global_upper_spread
    H L eta q c hn hqeta hspread hdom (hH hAH)
  rw [completionWeight_eq_matchingWeight_of_mem H hAH] at hbound
  have hΦpos : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast Nat.pos_of_ne_zero hΦ
  have hw : (matchingWeight H A : ℝ) ≤
      (L * matchingWeightTarget n H) / c := by
    apply (le_div_iff₀ hc).2
    simpa [mul_comm] using hbound
  unfold matchingFraction
  apply (div_le_iff₀ hΦpos).2
  calc
    (matchingWeight H A : ℝ) ≤
        (L * matchingWeightTarget n H) / c := hw
    _ = (L / c * ((n : ℝ) / H.card)) *
          (perfectMatchings n H).card := by
      unfold matchingWeightTarget
      ring

/-- The maximum-only domination package is sufficient for uniform control
of every present matching fraction. -/
lemma weightControlled_of_global_upper_spread_max {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (L eta q c : ℝ) (hn : 0 < n) (hc : 0 < c) (hqeta : eta < q)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (hspread : GlobalUpperWeightSpread n H L eta)
    (hdom : MaximumWeightDominated n H q c) :
    WeightControlled H (L / c) := by
  intro A hAH
  have hbound := completionWeight_bound_of_global_upper_spread_max
    H L eta q c hn hc.le hqeta hspread hdom (hH hAH)
  rw [completionWeight_eq_matchingWeight_of_mem H hAH] at hbound
  have hΦpos : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast Nat.pos_of_ne_zero hΦ
  have hw : (matchingWeight H A : ℝ) ≤
      (L * matchingWeightTarget n H) / c := by
    apply (le_div_iff₀ hc).2
    simpa [mul_comm] using hbound
  unfold matchingFraction
  apply (div_le_iff₀ hΦpos).2
  calc
    (matchingWeight H A : ℝ) ≤
        (L * matchingWeightTarget n H) / c := hw
    _ = (L / c * ((n : ℝ) / H.card)) *
          (perfectMatchings n H).card := by
      unfold matchingWeightTarget
      ring

/-- The fair fraction of perfect matchings destroyed by a uniform edge of
`H`. -/
def deletionMean (n : ℕ) (H : Finset (Edge n)) : ℝ :=
  (n : ℝ) / H.card

/-- The deterministic conditional mean at deletion time `i`, since every
history state then has `H.card - i` available edges. -/
def deletionGamma (n : ℕ) (H : Finset (Edge n)) (i : ℕ) : ℝ :=
  (n : ℝ) / ((H.card - i : ℕ) : ℝ)

@[simp] lemma deletionMean_historyState {n : ℕ} {H : Finset (Edge n)}
    {t k : ℕ} (e : DeletionHistory H t) (hk : k ≤ t) :
    deletionMean n (historyState e k hk) = deletionGamma n H k := by
  simp [deletionMean, deletionGamma]

/-- Sum of the one-step quadratic MGF budgets through time `t`. -/
def deletionVarianceBudget (n : ℕ) (H : Finset (Edge n))
    (C : ℝ) (t : ℕ) : ℝ :=
  ∑ i ∈ Finset.range t, C * (deletionGamma n H i)^2

/-- The current state satisfies the two hypotheses needed for the exact
matching-fraction mean and the controlled-increment bound. -/
def DeletionStepGood {n : ℕ} {H : Finset (Edge n)} {t : ℕ}
    (C : ℝ) (e : DeletionHistory H t) : Prop :=
  (perfectMatchings n (historyState e t le_rfl)).card ≠ 0 ∧
    WeightControlled (historyState e t le_rfl) C

/-- Every state used by the first `t` increments is good. -/
def DeletionHistoryGood {n : ℕ} {H : Finset (Edge n)} (C : ℝ) :
    (t : ℕ) → DeletionHistory H t → Prop
  | 0, _ => True
  | t + 1, e =>
      let z := historySuccEquiv H t e
      DeletionHistoryGood C t z.1 ∧ DeletionStepGood C z.1

/-- Kahn's stopped sum of centered matching fractions.  Once a prefix fails
the weight/count conditions, all subsequent increments are zero. -/
def stoppedCenteredSum {n : ℕ} {H : Finset (Edge n)} (C : ℝ) :
    (t : ℕ) → DeletionHistory H t → ℝ
  | 0, _ => 0
  | t + 1, e =>
      let z := historySuccEquiv H t e
      stoppedCenteredSum C t z.1 +
        if DeletionHistoryGood C t z.1 ∧ DeletionStepGood C z.1 then
          matchingFraction (historyState z.1 t le_rfl) z.2.1 -
            deletionMean n (historyState z.1 t le_rfl)
        else 0

/-- Quadratic MGF budget for the completion-weight deletion process. -/
def completionDeletionVarianceBudget (n : ℕ) (H : Finset (Edge n))
    (C : ℝ) (t : ℕ) : ℝ :=
  ∑ i ∈ Finset.range t, C * (completionDeletionGamma n H i)^2

/-- Good state for the completion-matching process through `Z`. -/
def CompletionDeletionStepGood {n : ℕ} {H : Finset (Edge n)}
    {t : ℕ} (Z : Edge n) (C : ℝ) (e : DeletionHistory H t) : Prop :=
  (completionMatchings n (historyState e t le_rfl) Z).card ≠ 0 ∧
    CompletionDeletionControlled (historyState e t le_rfl) Z C

/-- Every prefix used by the completion-weight martingale is good. -/
def CompletionDeletionHistoryGood {n : ℕ} {H : Finset (Edge n)}
    (Z : Edge n) (C : ℝ) :
    (t : ℕ) → DeletionHistory H t → Prop
  | 0, _ => True
  | t + 1, e =>
      let z := historySuccEquiv H t e
      CompletionDeletionHistoryGood Z C t z.1 ∧
        CompletionDeletionStepGood Z C z.1

/-- Stopped centered sum of completion-deletion fractions. -/
def completionStoppedCenteredSum {n : ℕ} {H : Finset (Edge n)}
    (Z : Edge n) (C : ℝ) :
    (t : ℕ) → DeletionHistory H t → ℝ
  | 0, _ => 0
  | t + 1, e =>
      let z := historySuccEquiv H t e
      completionStoppedCenteredSum Z C t z.1 +
        if CompletionDeletionHistoryGood Z C t z.1 ∧
            CompletionDeletionStepGood Z C z.1 then
          completionDeletionFraction (historyState z.1 t le_rfl) Z z.2.1 -
            completionDeletionMean n (historyState z.1 t le_rfl)
        else 0

/-- Unstopped centered completion-deletion sum. -/
def completionRawCenteredSum {n : ℕ} {H : Finset (Edge n)}
    (Z : Edge n) :
    (t : ℕ) → DeletionHistory H t → ℝ
  | 0, _ => 0
  | t + 1, e =>
      let z := historySuccEquiv H t e
      completionRawCenteredSum Z t z.1 +
        completionDeletionFraction (historyState z.1 t le_rfl) Z z.2.1 -
          completionDeletionMean n (historyState z.1 t le_rfl)

/-- Completion-deletion fractions exposed by the recursive history
decomposition. -/
def completionDeletionFractionList {n : ℕ} {H : Finset (Edge n)}
    (Z : Edge n) :
    (t : ℕ) → DeletionHistory H t → List ℝ
  | 0, _ => []
  | t + 1, e =>
      let z := historySuccEquiv H t e
      completionDeletionFractionList Z t z.1 ++
        [completionDeletionFraction (historyState z.1 t le_rfl) Z z.2.1]

/-- Product of the recursively exposed survival factors. -/
def completionRecursiveDeletionProduct {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (t : ℕ)
    (e : DeletionHistory H t) : ℝ :=
  ((completionDeletionFractionList Z t e).map fun x ↦ 1 - x).prod

/-- Deterministic sum of the fair completion-deletion means. -/
def completionDeletionMeanSum (n : ℕ) (H : Finset (Edge n)) :
    ℕ → ℝ
  | 0 => 0
  | t + 1 => completionDeletionMeanSum n H t +
      completionDeletionGamma n H t

/-- The raw martingale sum is the sum of the exposed influences minus its
deterministic mean. -/
lemma completionRawCenteredSum_eq_list_sum {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (t : ℕ)
    (e : DeletionHistory H t) :
    completionRawCenteredSum Z t e =
      (completionDeletionFractionList Z t e).sum -
        completionDeletionMeanSum n H t := by
  induction t with
  | zero =>
      simp [completionRawCenteredSum, completionDeletionFractionList,
        completionDeletionMeanSum]
  | succ t ih =>
      let z := historySuccEquiv H t e
      change completionRawCenteredSum Z t z.1 +
          completionDeletionFraction (historyState z.1 t le_rfl) Z z.2.1 -
            completionDeletionMean n (historyState z.1 t le_rfl) =
        (completionDeletionFractionList Z t z.1 ++
          [completionDeletionFraction (historyState z.1 t le_rfl) Z
            z.2.1]).sum -
          (completionDeletionMeanSum n H t +
            completionDeletionGamma n H t)
      rw [ih z.1]
      simp only [List.sum_append, List.sum_singleton]
      have hmean : completionDeletionMean n
          (historyState z.1 t le_rfl) =
          completionDeletionGamma n H t :=
        completionDeletionMean_historyState z.1 le_rfl
      rw [hmean]
      ring

lemma completionRecursiveDeletionProduct_succ {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (t : ℕ)
    (e : DeletionHistory H (t + 1)) :
    completionRecursiveDeletionProduct Z (t + 1) e =
      let z := historySuccEquiv H t e
      completionRecursiveDeletionProduct Z t z.1 *
        (1 - completionDeletionFraction
          (historyState z.1 t le_rfl) Z z.2.1) := by
  let z := historySuccEquiv H t e
  change ((completionDeletionFractionList Z t z.1 ++
      [completionDeletionFraction (historyState z.1 t le_rfl) Z z.2.1]).map
        fun x ↦ 1 - x).prod =
    completionRecursiveDeletionProduct Z t z.1 *
      (1 - completionDeletionFraction
        (historyState z.1 t le_rfl) Z z.2.1)
  simp [completionRecursiveDeletionProduct]

/-- The recursive survival product is exactly the ratio of the actual
completion-matching counts. -/
lemma card_completionHistoryState_eq_mul_recursiveProduct {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (t : ℕ)
    (e : DeletionHistory H t) :
    ((completionMatchings n (historyState e t le_rfl) Z).card : ℝ) =
      ((completionMatchings n H Z).card : ℝ) *
        completionRecursiveDeletionProduct Z t e := by
  induction t with
  | zero =>
      rw [historyState_zero]
      simp [completionRecursiveDeletionProduct,
        completionDeletionFractionList]
  | succ t ih =>
      let z := historySuccEquiv H t e
      have he : (historySuccEquiv H t).symm z = e := by
        exact (historySuccEquiv H t).symm_apply_apply e
      have hstate := historyState_historySuccEquiv_symm H t z.1 z.2
      rw [he] at hstate
      rw [hstate, card_completionMatchings_erase_mul, ih z.1,
        completionRecursiveDeletionProduct_succ]
      ring

/-- Every recursively exposed completion-deletion fraction is nonnegative. -/
lemma completionDeletionFractionList_nonneg {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (t : ℕ)
    (e : DeletionHistory H t) :
    ∀ x ∈ completionDeletionFractionList Z t e, 0 ≤ x := by
  induction t with
  | zero => simp [completionDeletionFractionList]
  | succ t ih =>
      let z := historySuccEquiv H t e
      unfold completionDeletionFractionList
      intro x hx
      rcases List.mem_append.mp hx with hx | hx
      · exact ih z.1 x hx
      · simp only [List.mem_singleton] at hx
        subst x
        exact completionDeletionFraction_nonneg _ _ _

/-- Under the stopped process's good-history hypotheses, a uniform bound on
`C γ_i` bounds every recursively exposed influence. -/
lemma completionDeletionFractionList_le {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C b : ℝ) (t : ℕ)
    (e : DeletionHistory H t)
    (hgood : CompletionDeletionHistoryGood Z C t e)
    (hCb : ∀ i < t, C * completionDeletionGamma n H i ≤ b) :
    ∀ x ∈ completionDeletionFractionList Z t e, x ≤ b := by
  induction t with
  | zero => simp [completionDeletionFractionList]
  | succ t ih =>
      let z := historySuccEquiv H t e
      change CompletionDeletionHistoryGood Z C t z.1 ∧
        CompletionDeletionStepGood Z C z.1 at hgood
      unfold completionDeletionFractionList
      intro x hx
      rcases List.mem_append.mp hx with hx | hx
      · exact ih z.1 hgood.1
          (fun i hi ↦ hCb i (hi.trans (Nat.lt_succ_self t))) x hx
      · simp only [List.mem_singleton] at hx
        subst x
        have hcontrol := hgood.2.2 z.2.1 z.2.2
        have hmean : (((n - 1 : ℕ) : ℝ) /
            (historyState z.1 t le_rfl).card) =
            completionDeletionGamma n H t := by
          exact completionDeletionMean_historyState z.1 le_rfl
        rw [hmean] at hcontrol
        exact hcontrol.trans (hCb t (Nat.lt_succ_self t))

/-- On a fully good history the stopped process equals the genuine centered
sum. -/
lemma completionStopped_eq_raw_of_good {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C : ℝ)
    (t : ℕ) (e : DeletionHistory H t)
    (hgood : CompletionDeletionHistoryGood Z C t e) :
    completionStoppedCenteredSum Z C t e =
      completionRawCenteredSum Z t e := by
  induction t with
  | zero => rfl
  | succ t ih =>
      let z := historySuccEquiv H t e
      change CompletionDeletionHistoryGood Z C t z.1 ∧
        CompletionDeletionStepGood Z C z.1 at hgood
      have hgood' :
          CompletionDeletionHistoryGood Z C t
              ((historySuccEquiv H t) e).1 ∧
            CompletionDeletionStepGood Z C
              ((historySuccEquiv H t) e).1 := by
        simpa [z] using hgood
      unfold completionStoppedCenteredSum
      unfold completionRawCenteredSum
      simp only [if_pos hgood']
      rw [ih _ hgood'.1]
      ring

@[simp] lemma completionDeletionVarianceBudget_zero (n : ℕ)
    (H : Finset (Edge n)) (C : ℝ) :
    completionDeletionVarianceBudget n H C 0 = 0 := by
  simp [completionDeletionVarianceBudget]

lemma completionDeletionVarianceBudget_succ (n : ℕ)
    (H : Finset (Edge n)) (C : ℝ) (t : ℕ) :
    completionDeletionVarianceBudget n H C (t + 1) =
      completionDeletionVarianceBudget n H C t +
        C * (completionDeletionGamma n H t)^2 := by
  unfold completionDeletionVarianceBudget
  rw [Finset.sum_range_succ]

@[simp] lemma completionStoppedCenteredSum_zero {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C : ℝ)
    (e : DeletionHistory H 0) :
    completionStoppedCenteredSum Z C 0 e = 0 := by
  rfl

lemma completionStoppedCenteredSum_succ {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C : ℝ) (t : ℕ)
    (e : DeletionHistory H (t + 1)) :
    completionStoppedCenteredSum Z C (t + 1) e =
      let z := historySuccEquiv H t e
      completionStoppedCenteredSum Z C t z.1 +
        if CompletionDeletionHistoryGood Z C t z.1 ∧
            CompletionDeletionStepGood Z C z.1 then
          completionDeletionFraction (historyState z.1 t le_rfl) Z z.2.1 -
            completionDeletionMean n (historyState z.1 t le_rfl)
        else 0 := by
  rfl

@[simp] lemma deletionVarianceBudget_zero (n : ℕ) (H : Finset (Edge n))
    (C : ℝ) : deletionVarianceBudget n H C 0 = 0 := by
  simp [deletionVarianceBudget]

lemma deletionVarianceBudget_succ (n : ℕ) (H : Finset (Edge n))
    (C : ℝ) (t : ℕ) :
    deletionVarianceBudget n H C (t + 1) =
      deletionVarianceBudget n H C t + C * (deletionGamma n H t)^2 := by
  unfold deletionVarianceBudget
  rw [Finset.sum_range_succ]

lemma reciprocal_sq_le_reciprocal_pred_sub (m : ℕ) (hm : 2 ≤ m) :
    (1 / (m : ℝ))^2 ≤ 1 / ((m - 1 : ℕ) : ℝ) - 1 / (m : ℝ) := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hm1 : (1 : ℝ) < m := by exact_mod_cast (by omega : 1 < m)
  have hsub : (0 : ℝ) < (m : ℝ) - 1 := by linarith
  rw [Nat.cast_sub (by omega : 1 ≤ m), Nat.cast_one]
  have hsquare : (1 / (m : ℝ))^2 = 1 / (m : ℝ)^2 := by
    field_simp [hm0.ne']
  have hdiff :
      1 / ((m : ℝ) - 1) - 1 / (m : ℝ) =
        1 / ((m : ℝ) * ((m : ℝ) - 1)) := by
    field_simp [hm0.ne', hsub.ne']
    ring
  rw [hsquare, hdiff]
  apply one_div_le_one_div_of_le (mul_pos hm0 hsub)
  nlinarith

lemma sum_descending_reciprocal_sq_le (K M : ℕ)
    (hM : 0 < M) (hMK : M ≤ K) :
    ∑ i ∈ Finset.range (K - M),
        (1 / (((K - i : ℕ) : ℝ)))^2 ≤ 1 / (M : ℝ) := by
  have haux : ∀ T : ℕ, T ≤ K - M →
      ∑ i ∈ Finset.range T, (1 / (((K - i : ℕ) : ℝ)))^2 ≤
        1 / (((K - T : ℕ) : ℝ)) - 1 / (K : ℝ) := by
    intro T hT
    induction T with
    | zero => simp
    | succ t ih =>
        have ht : t ≤ K - M := by omega
        have htwo : 2 ≤ K - t := by omega
        have hpred : K - (t + 1) = (K - t) - 1 := by omega
        rw [Finset.sum_range_succ]
        calc
          (∑ i ∈ Finset.range t,
              (1 / (((K - i : ℕ) : ℝ)))^2) +
                (1 / (((K - t : ℕ) : ℝ)))^2 ≤
              (1 / (((K - t : ℕ) : ℝ)) - 1 / (K : ℝ)) +
                (1 / (((K - t : ℕ) : ℝ)))^2 := by
            gcongr
            exact ih ht
          _ ≤ 1 / (((K - (t + 1) : ℕ) : ℝ)) - 1 / (K : ℝ) := by
            rw [hpred]
            linarith [reciprocal_sq_le_reciprocal_pred_sub (K - t) htwo]
  have hmain := haux (K - M) le_rfl
  have hcancel : K - (K - M) = M := by omega
  rw [hcancel] at hmain
  have hKnonneg : 0 ≤ 1 / (K : ℝ) := by positivity
  linarith

lemma deletionVarianceBudget_le (n : ℕ) (H : Finset (Edge n))
    (C : ℝ) (M : ℕ) (hC : 0 ≤ C) (hM : 0 < M) (hMH : M ≤ H.card) :
    deletionVarianceBudget n H C (H.card - M) ≤
      C * (n : ℝ)^2 / (M : ℝ) := by
  have hsum := sum_descending_reciprocal_sq_le H.card M hM hMH
  unfold deletionVarianceBudget deletionGamma
  calc
    ∑ i ∈ Finset.range (H.card - M),
        C * ((n : ℝ) / ((H.card - i : ℕ) : ℝ)) ^ 2 =
      (C * (n : ℝ)^2) *
        ∑ i ∈ Finset.range (H.card - M),
          (1 / ((H.card - i : ℕ) : ℝ))^2 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ ≤ (C * (n : ℝ)^2) * (1 / (M : ℝ)) := by
      exact mul_le_mul_of_nonneg_left hsum (mul_nonneg hC (sq_nonneg _))
    _ = C * (n : ℝ)^2 / (M : ℝ) := by ring

lemma completionDeletionVarianceBudget_le (n : ℕ)
    (H : Finset (Edge n)) (C : ℝ) (M : ℕ) (hC : 0 ≤ C)
    (hM : 0 < M) (hMH : M ≤ H.card) :
    completionDeletionVarianceBudget n H C (H.card - M) ≤
      C * (((n - 1 : ℕ) : ℝ))^2 / (M : ℝ) := by
  have hsum := sum_descending_reciprocal_sq_le H.card M hM hMH
  unfold completionDeletionVarianceBudget completionDeletionGamma
  calc
    ∑ i ∈ Finset.range (H.card - M),
        C * (((n - 1 : ℕ) : ℝ) /
          ((H.card - i : ℕ) : ℝ)) ^ 2 =
      (C * (((n - 1 : ℕ) : ℝ))^2) *
        ∑ i ∈ Finset.range (H.card - M),
          (1 / ((H.card - i : ℕ) : ℝ))^2 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ ≤ (C * (((n - 1 : ℕ) : ℝ))^2) * (1 / (M : ℝ)) := by
      exact mul_le_mul_of_nonneg_left hsum
        (mul_nonneg hC (sq_nonneg _))
    _ = C * (((n - 1 : ℕ) : ℝ))^2 / (M : ℝ) := by ring

@[simp] lemma stoppedCenteredSum_zero {n : ℕ} {H : Finset (Edge n)}
    (C : ℝ) (e : DeletionHistory H 0) :
    stoppedCenteredSum C 0 e = 0 := by
  rfl

lemma stoppedCenteredSum_succ {n : ℕ} {H : Finset (Edge n)}
    (C : ℝ) (t : ℕ) (e : DeletionHistory H (t + 1)) :
    stoppedCenteredSum C (t + 1) e =
      let z := historySuccEquiv H t e
      stoppedCenteredSum C t z.1 +
        if DeletionHistoryGood C t z.1 ∧ DeletionStepGood C z.1 then
          matchingFraction (historyState z.1 t le_rfl) z.2.1 -
            deletionMean n (historyState z.1 t le_rfl)
        else 0 := by
  rfl

/-! ### The bounded-increment exponential estimate -/

/-- Uniform quadratic lower bound for a logarithmic survival factor when
`0 ≤ x ≤ b < 1`. -/
lemma neg_add_sq_div_le_log_one_sub {x b : ℝ}
    (hx0 : 0 ≤ x) (hxb : x ≤ b) (hb : b < 1) :
    -(x + x^2 / (1 - b)) ≤ Real.log (1 - x) := by
  have hx1 : x < 1 := hxb.trans_lt hb
  have hdenx : 0 < 1 - x := sub_pos.mpr hx1
  have hdenb : 0 < 1 - b := sub_pos.mpr hb
  have hlog := Real.log_le_sub_one_of_pos (one_div_pos.mpr hdenx)
  rw [one_div, Real.log_inv] at hlog
  have hinv : (1 - x)⁻¹ - 1 = x / (1 - x) := by
    field_simp [hdenx.ne']
    ring
  rw [hinv] at hlog
  have hsquare : 0 ≤ x^2 := sq_nonneg x
  have hdiv : x^2 / (1 - x) ≤ x^2 / (1 - b) := by
    apply div_le_div_of_nonneg_left hsquare hdenb
    linarith
  have hsplit : x / (1 - x) = x + x^2 / (1 - x) := by
    field_simp [hdenx.ne']
    ring
  rw [hsplit] at hlog
  linarith

/-- Summed logarithmic control of a finite product of survival factors. -/
lemma log_prod_one_sub_bounds {α : Type*} (s : Finset α)
    (w : α → ℝ) (b : ℝ)
    (hw0 : ∀ x ∈ s, 0 ≤ w x)
    (hwb : ∀ x ∈ s, w x ≤ b) (hb : b < 1) :
    -(∑ x ∈ s, w x) - (∑ x ∈ s, (w x)^2) / (1 - b) ≤
        Real.log (∏ x ∈ s, (1 - w x)) ∧
      Real.log (∏ x ∈ s, (1 - w x)) ≤ -(∑ x ∈ s, w x) := by
  have hne : ∀ x ∈ s, 1 - w x ≠ 0 := by
    intro x hx
    have : w x < 1 := (hwb x hx).trans_lt hb
    linarith
  rw [Real.log_prod hne]
  constructor
  · have hpoint : ∀ x ∈ s,
        -(w x + (w x)^2 / (1 - b)) ≤ Real.log (1 - w x) := by
      intro x hx
      exact neg_add_sq_div_le_log_one_sub (hw0 x hx) (hwb x hx) hb
    have hsum := Finset.sum_le_sum hpoint
    calc
      -(∑ x ∈ s, w x) - (∑ x ∈ s, (w x)^2) / (1 - b) =
          ∑ x ∈ s, -(w x + (w x)^2 / (1 - b)) := by
        rw [Finset.sum_neg_distrib, Finset.sum_add_distrib,
          Finset.sum_div]
        ring
      _ ≤ ∑ x ∈ s, Real.log (1 - w x) := hsum
  · have hpoint : ∀ x ∈ s, Real.log (1 - w x) ≤ -w x := by
      intro x hx
      exact log_one_sub_le_neg ((hwb x hx).trans_lt hb)
    have hsum := Finset.sum_le_sum hpoint
    simpa only [Finset.sum_neg_distrib] using hsum

/-- List form of `log_prod_one_sub_bounds`, convenient for a recursively
decomposed deletion history. -/
lemma log_list_prod_one_sub_bounds (L : List ℝ) (b : ℝ)
    (hL0 : ∀ x ∈ L, 0 ≤ x) (hLb : ∀ x ∈ L, x ≤ b) (hb : b < 1) :
    -L.sum - (L.map fun x ↦ x^2).sum / (1 - b) ≤
        Real.log (L.map fun x ↦ 1 - x).prod ∧
      Real.log (L.map fun x ↦ 1 - x).prod ≤ -L.sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
      have hx0 : 0 ≤ x := hL0 x (by simp)
      have hxb : x ≤ b := hLb x (by simp)
      have htail0 : ∀ y ∈ L, 0 ≤ y := by
        intro y hy
        exact hL0 y (by simp [hy])
      have htailb : ∀ y ∈ L, y ≤ b := by
        intro y hy
        exact hLb y (by simp [hy])
      have htail := ih htail0 htailb
      have hx1 : x < 1 := hxb.trans_lt hb
      have htailprod : 0 < (L.map fun y ↦ 1 - y).prod := by
        apply List.prod_pos
        intro z hz
        rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
        exact sub_pos.mpr ((htailb y hy).trans_lt hb)
      have hlog : Real.log
          ((List.map (fun y ↦ 1 - y) (x :: L)).prod) =
          Real.log (1 - x) +
            Real.log ((L.map fun y ↦ 1 - y).prod) := by
        simp only [List.map_cons, List.prod_cons]
        rw [Real.log_mul (by linarith) htailprod.ne']
      rw [hlog]
      constructor
      · have hxlog := neg_add_sq_div_le_log_one_sub hx0 hxb hb
        simp only [List.sum_cons, List.map_cons]
        have hsplit :
            (x^2 + (L.map fun y ↦ y^2).sum) / (1 - b) =
              x^2 / (1 - b) +
                (L.map fun y ↦ y^2).sum / (1 - b) := by
          ring
        rw [hsplit]
        linarith
      · have hxlog := log_one_sub_le_neg hx1
        simp only [List.sum_cons]
        linarith

/-- Deterministic conversion of the stopped additive martingale into a
logarithmic bound on the actual surviving completion-matching ratio. -/
lemma completionHistory_log_ratio_bounds {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C b : ℝ) (t : ℕ)
    (e : DeletionHistory H t)
    (hcomp : (completionMatchings n H Z).card ≠ 0)
    (hgood : CompletionDeletionHistoryGood Z C t e)
    (hCb : ∀ i < t, C * completionDeletionGamma n H i ≤ b)
    (hb : b < 1) :
    let Q := ((completionDeletionFractionList Z t e).map fun x ↦ x^2).sum;
    -(completionStoppedCenteredSum Z C t e +
          completionDeletionMeanSum n H t) - Q / (1 - b) ≤
        Real.log
          (((completionMatchings n (historyState e t le_rfl) Z).card : ℝ) /
            (completionMatchings n H Z).card) ∧
      Real.log
          (((completionMatchings n (historyState e t le_rfl) Z).card : ℝ) /
            (completionMatchings n H Z).card) ≤
        -(completionStoppedCenteredSum Z C t e +
          completionDeletionMeanSum n H t) := by
  let L := completionDeletionFractionList Z t e
  let P := completionRecursiveDeletionProduct Z t e
  have hL0 : ∀ x ∈ L, 0 ≤ x := by
    exact completionDeletionFractionList_nonneg Z t e
  have hLb : ∀ x ∈ L, x ≤ b := by
    exact completionDeletionFractionList_le Z C b t e hgood hCb
  have hlog := log_list_prod_one_sub_bounds L b hL0 hLb hb
  have hraw := completionRawCenteredSum_eq_list_sum Z t e
  have hstop := completionStopped_eq_raw_of_good Z C t e hgood
  have hLsum : L.sum = completionStoppedCenteredSum Z C t e +
      completionDeletionMeanSum n H t := by
    dsimp [L]
    linarith
  have hcount := card_completionHistoryState_eq_mul_recursiveProduct Z t e
  have hinit : ((completionMatchings n H Z).card : ℝ) ≠ 0 := by
    exact_mod_cast hcomp
  have hratio :
      ((completionMatchings n (historyState e t le_rfl) Z).card : ℝ) /
          (completionMatchings n H Z).card = P := by
    dsimp [P]
    rw [hcount]
    field_simp [hinit]
  dsimp only
  rw [hratio]
  change -(_ + _) - ((L.map fun x ↦ x^2).sum) / (1 - b) ≤
      Real.log P ∧ Real.log P ≤ -(_ + _)
  dsimp [P]
  rw [← hLsum]
  exact hlog

lemma exp_mul_le_endpoint_chord {w b θ : ℝ} (hb : 0 < b)
    (hw0 : 0 ≤ w) (hwb : w ≤ b) :
    Real.exp (θ * w) ≤
      1 + (w / b) * (Real.exp (θ * b) - 1) := by
  have ht0 : 0 ≤ w / b := div_nonneg hw0 hb.le
  have ht1 : w / b ≤ 1 := (div_le_one hb).2 hwb
  have hconv := convexOn_exp.2 (Set.mem_univ (0 : ℝ))
    (Set.mem_univ (θ * b)) (sub_nonneg.mpr ht1) ht0 (by ring)
  calc
    Real.exp (θ * w) =
        Real.exp ((1 - w / b) * 0 + (w / b) * (θ * b)) := by
      congr 1
      field_simp [hb.ne']
      ring
    _ ≤ (1 - w / b) * Real.exp 0 + (w / b) * Real.exp (θ * b) := hconv
    _ = 1 + (w / b) * (Real.exp (θ * b) - 1) := by
      rw [Real.exp_zero]
      ring

lemma centered_two_point_mgf_le {μ b θ : ℝ} (hb : 0 < b)
    (hμ0 : 0 ≤ μ) (hμb : μ ≤ b) (hθ : |θ * b| ≤ 1 / 2) :
    Real.exp (-θ * μ) *
        (1 + (μ / b) * (Real.exp (θ * b) - 1)) ≤
      Real.exp (θ^2 * μ * b) := by
  let x : ℝ := θ * b
  have hxnorm : ‖x‖ ≤ 1 := by
    rw [Real.norm_eq_abs]
    exact hθ.trans (by norm_num)
  have hrem := Real.norm_exp_sub_one_sub_id_le hxnorm
  have hrem' : Real.exp x - 1 - x ≤ x^2 := by
    calc
      Real.exp x - 1 - x ≤ |Real.exp x - 1 - x| := le_abs_self _
      _ = ‖Real.exp x - 1 - x‖ := by rw [Real.norm_eq_abs]
      _ ≤ ‖x‖^2 := hrem
      _ = x^2 := by rw [Real.norm_eq_abs, sq_abs]
  have hexpLinear : Real.exp x - 1 ≤ x + x^2 := by linarith
  have hp0 : 0 ≤ μ / b := div_nonneg hμ0 hb.le
  have hinside :
      1 + (μ / b) * (Real.exp x - 1) ≤
        1 + (μ / b) * (x + x^2) := by gcongr
  have hone :
      1 + (μ / b) * (x + x^2) ≤
        Real.exp ((μ / b) * (x + x^2)) := by
    simpa only [add_comm] using
      Real.add_one_le_exp ((μ / b) * (x + x^2))
  calc
    Real.exp (-θ * μ) *
          (1 + (μ / b) * (Real.exp (θ * b) - 1)) =
        Real.exp (-θ * μ) *
          (1 + (μ / b) * (Real.exp x - 1)) := by rfl
    _ ≤ Real.exp (-θ * μ) *
          (1 + (μ / b) * (x + x^2)) := by gcongr
    _ ≤ Real.exp (-θ * μ) *
          Real.exp ((μ / b) * (x + x^2)) := by gcongr
    _ = Real.exp (-θ * μ + (μ / b) * (x + x^2)) := by
      rw [Real.exp_add]
    _ = Real.exp (θ^2 * μ * b) := by
      congr 1
      dsimp [x]
      field_simp [hb.ne']
      ring

/-- Kahn's bounded nonnegative increment MGF estimate for a finite uniform
law. -/
lemma finsetAverage_exp_centered_le {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b θ : ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (hW0 : ∀ x ∈ s, 0 ≤ W x) (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (hθ : |θ * b| ≤ 1 / 2) :
    finsetAverage s
        (fun x ↦ Real.exp (θ * (W x - finsetAverage s W))) ≤
      Real.exp (θ^2 * a * b) := by
  let μ : ℝ := finsetAverage s W
  have hcardNat : 0 < s.card := Finset.card_pos.mpr hs
  have hcard : (0 : ℝ) < s.card := by exact_mod_cast hcardNat
  have hsum0 : 0 ≤ ∑ x ∈ s, W x := by
    exact Finset.sum_nonneg fun x hx ↦ hW0 x hx
  have hμ0 : 0 ≤ μ := by
    dsimp [μ, finsetAverage]
    exact div_nonneg hsum0 hcard.le
  have hsumB : ∑ x ∈ s, W x ≤ ∑ _x ∈ s, b := by
    exact Finset.sum_le_sum fun x hx ↦ hWb x hx
  have hμb : μ ≤ b := by
    dsimp [μ, finsetAverage]
    apply (div_le_iff₀ hcard).2
    calc
      ∑ x ∈ s, W x ≤ ∑ _x ∈ s, b := hsumB
      _ = (s.card : ℝ) * b := by simp
      _ = b * (s.card : ℝ) := by ring
  have hpoint : ∀ x ∈ s,
      Real.exp (θ * W x) ≤
        1 + (W x / b) * (Real.exp (θ * b) - 1) := by
    intro x hx
    exact exp_mul_le_endpoint_chord hb (hW0 x hx) (hWb x hx)
  have hsumExp :
      ∑ x ∈ s, Real.exp (θ * W x) ≤
        ∑ x ∈ s, (1 + (W x / b) * (Real.exp (θ * b) - 1)) :=
    Finset.sum_le_sum hpoint
  have havgExp :
      finsetAverage s (fun x ↦ Real.exp (θ * W x)) ≤
        1 + (μ / b) * (Real.exp (θ * b) - 1) := by
    have hsumTerm :
        ∑ x ∈ s, (W x / b) * (Real.exp (θ * b) - 1) =
          ((∑ x ∈ s, W x) / b) * (Real.exp (θ * b) - 1) := by
      rw [← Finset.sum_mul, ← Finset.sum_div]
    unfold finsetAverage
    apply (div_le_iff₀ hcard).2
    calc
      ∑ x ∈ s, Real.exp (θ * W x) ≤
          ∑ x ∈ s, (1 + (W x / b) * (Real.exp (θ * b) - 1)) := hsumExp
      _ = (1 + (μ / b) * (Real.exp (θ * b) - 1)) * s.card := by
        dsimp [μ, finsetAverage]
        rw [Finset.sum_add_distrib]
        simp only [Finset.sum_const, nsmul_eq_mul]
        rw [hsumTerm]
        field_simp [hb.ne', hcard.ne']
  have hcenter :
      finsetAverage s (fun x ↦ Real.exp (θ * (W x - μ))) =
        Real.exp (-θ * μ) *
          finsetAverage s (fun x ↦ Real.exp (θ * W x)) := by
    unfold finsetAverage
    simp_rw [show ∀ x, θ * (W x - μ) = -θ * μ + θ * W x by
      intro x; ring, Real.exp_add]
    rw [← Finset.mul_sum]
    ring
  rw [show finsetAverage s W = μ by rfl, hcenter]
  calc
    Real.exp (-θ * μ) *
          finsetAverage s (fun x ↦ Real.exp (θ * W x)) ≤
        Real.exp (-θ * μ) *
          (1 + (μ / b) * (Real.exp (θ * b) - 1)) := by
      exact mul_le_mul_of_nonneg_left havgExp (Real.exp_pos _).le
    _ ≤ Real.exp (θ^2 * μ * b) :=
      centered_two_point_mgf_le hb hμ0 hμb hθ
    _ ≤ Real.exp (θ^2 * a * b) := by
      apply Real.exp_le_exp.mpr
      have hμa : μ ≤ a := by simpa [μ] using hmean
      calc
        θ^2 * μ * b = (θ^2 * b) * μ := by ring
        _ ≤ (θ^2 * b) * a :=
          mul_le_mul_of_nonneg_left hμa (mul_nonneg (sq_nonneg θ) hb.le)
        _ = θ^2 * a * b := by ring

/-- Tensorization of the bounded exponential-moment estimate over `t`
independent uniform draws. -/
lemma finsetAverage_exp_iidCenteredSum_le {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b θ : ℝ) (t : ℕ) (hs : s.Nonempty) (hb : 0 < b)
    (hW0 : ∀ x ∈ s, 0 ≤ W x) (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (hθ : |θ * b| ≤ 1 / 2) :
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (fun ω ↦ Real.exp
          (θ * (iidSum W t ω - t * finsetAverage s W))) ≤
      Real.exp (θ^2 * ((t : ℝ) * a) * b) := by
  rw [finsetAverage_exp_iidCenteredSum]
  have hstep := finsetAverage_exp_centered_le s W a b θ hs hb
    hW0 hWb hmean hθ
  have havg0 : 0 ≤ finsetAverage s
      (fun x ↦ Real.exp (θ * (W x - finsetAverage s W))) := by
    unfold finsetAverage
    positivity
  have hpowLe := pow_le_pow_left₀ havg0 hstep t
  have hpowAll : ∀ m : ℕ, (Real.exp (θ^2 * a * b)) ^ m =
      Real.exp ((m : ℝ) * (θ^2 * a * b)) := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
        rw [pow_succ, ih, Nat.cast_succ, add_mul, one_mul, Real.exp_add]
  have hpow := hpowAll t
  calc
    (finsetAverage s
        (fun x ↦ Real.exp (θ * (W x - finsetAverage s W)))) ^ t ≤
        (Real.exp (θ^2 * a * b)) ^ t := hpowLe
    _ = Real.exp ((t : ℝ) * (θ^2 * a * b)) := hpow
    _ = Real.exp (θ^2 * ((t : ℝ) * a) * b) := by
      congr 1
      ring

lemma average_matchingFraction_eq_deletionMean (n : ℕ)
    (H : Finset (Edge n)) (hΦ : (perfectMatchings n H).card ≠ 0) :
    finsetAverage H (matchingFraction H) = deletionMean n H := by
  simpa [finsetAverage, deletionMean] using average_matchingFraction n H hΦ

/-- Conditional exponential-moment estimate for one controlled step of
the matching-deletion process. -/
lemma matchingFraction_mgf_le (n : ℕ) (H : Finset (Edge n))
    (C θ : ℝ) (hn : 0 < n) (hH : H.Nonempty)
    (hΦ : (perfectMatchings n H).card ≠ 0) (hC : 0 < C)
    (hcontrolled : WeightControlled H C)
    (hθ : |θ * (C * deletionMean n H)| ≤ 1 / 2) :
    finsetAverage H
        (fun A ↦ Real.exp
          (θ * (matchingFraction H A - deletionMean n H))) ≤
      Real.exp (θ^2 * deletionMean n H *
        (C * deletionMean n H)) := by
  have hcard : (0 : ℝ) < H.card := by
    exact_mod_cast Finset.card_pos.mpr hH
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hmeanPos : 0 < deletionMean n H := by
    exact div_pos hnR hcard
  have hmeanEq := average_matchingFraction_eq_deletionMean n H hΦ
  have hmgf := finsetAverage_exp_centered_le H (matchingFraction H)
    (deletionMean n H) (C * deletionMean n H) θ hH
    (mul_pos hC hmeanPos)
    (fun A _ ↦ matchingFraction_nonneg H A)
    hcontrolled (le_of_eq hmeanEq) hθ
  simpa only [hmeanEq] using hmgf

lemma matchingFraction_mgf_attach_le (n : ℕ) (H : Finset (Edge n))
    (C θ : ℝ) (hn : 0 < n) (hH : H.Nonempty)
    (hΦ : (perfectMatchings n H).card ≠ 0) (hC : 0 < C)
    (hcontrolled : WeightControlled H C)
    (hθ : |θ * (C * deletionMean n H)| ≤ 1 / 2) :
    finsetAverage (Finset.univ : Finset ↥H)
        (fun A ↦ Real.exp
          (θ * (matchingFraction H A.1 - deletionMean n H))) ≤
      Real.exp (θ^2 * deletionMean n H *
        (C * deletionMean n H)) := by
  calc
    finsetAverage (Finset.univ : Finset ↥H)
          (fun A ↦ Real.exp
            (θ * (matchingFraction H A.1 - deletionMean n H))) =
        finsetAverage H
          (fun A ↦ Real.exp
            (θ * (matchingFraction H A - deletionMean n H))) :=
      finsetAverage_attach H
        (fun A ↦ Real.exp
          (θ * (matchingFraction H A - deletionMean n H)))
    _ ≤ Real.exp (θ^2 * deletionMean n H *
          (C * deletionMean n H)) :=
      matchingFraction_mgf_le n H C θ hn hH hΦ hC hcontrolled hθ

/-- One-step exponential-moment estimate for deletion of completion
matchings through an arbitrary triple. -/
lemma completionDeletionFraction_mgf_le (n : ℕ)
    (H : Finset (Edge n)) (Z : Edge n) (C θ : ℝ)
    (hn : 2 ≤ n) (hH : H.Nonempty)
    (hcomp : (completionMatchings n H Z).card ≠ 0) (hC : 0 < C)
    (hcontrolled : CompletionDeletionControlled H Z C)
    (hθ : |θ * (C * completionDeletionMean n H)| ≤ 1 / 2) :
    finsetAverage H
        (fun A ↦ Real.exp (θ *
          (completionDeletionFraction H Z A -
            completionDeletionMean n H))) ≤
      Real.exp (θ^2 * completionDeletionMean n H *
        (C * completionDeletionMean n H)) := by
  have hcard : (0 : ℝ) < H.card := by
    exact_mod_cast Finset.card_pos.mpr hH
  have hnR : (0 : ℝ) < ((n - 1 : ℕ) : ℝ) := by
    exact_mod_cast (by omega : 0 < n - 1)
  have hmeanPos : 0 < completionDeletionMean n H := by
    exact div_pos hnR hcard
  have hmeanEq :=
    average_completionDeletionFraction_eq_mean n H Z hcomp
  have hmgf := finsetAverage_exp_centered_le H
    (completionDeletionFraction H Z) (completionDeletionMean n H)
    (C * completionDeletionMean n H) θ hH (mul_pos hC hmeanPos)
    (fun A _ ↦ completionDeletionFraction_nonneg H Z A)
    hcontrolled (le_of_eq hmeanEq) hθ
  simpa only [hmeanEq] using hmgf

lemma completionDeletionFraction_mgf_attach_le (n : ℕ)
    (H : Finset (Edge n)) (Z : Edge n) (C θ : ℝ)
    (hn : 2 ≤ n) (hH : H.Nonempty)
    (hcomp : (completionMatchings n H Z).card ≠ 0) (hC : 0 < C)
    (hcontrolled : CompletionDeletionControlled H Z C)
    (hθ : |θ * (C * completionDeletionMean n H)| ≤ 1 / 2) :
    finsetAverage (Finset.univ : Finset ↥H)
        (fun A ↦ Real.exp (θ *
          (completionDeletionFraction H Z A.1 -
            completionDeletionMean n H))) ≤
      Real.exp (θ^2 * completionDeletionMean n H *
        (C * completionDeletionMean n H)) := by
  calc
    finsetAverage (Finset.univ : Finset ↥H)
          (fun A ↦ Real.exp (θ *
            (completionDeletionFraction H Z A.1 -
              completionDeletionMean n H))) =
        finsetAverage H
          (fun A ↦ Real.exp (θ *
            (completionDeletionFraction H Z A -
              completionDeletionMean n H))) :=
      finsetAverage_attach H
        (fun A ↦ Real.exp (θ *
          (completionDeletionFraction H Z A -
            completionDeletionMean n H)))
    _ ≤ Real.exp (θ^2 * completionDeletionMean n H *
          (C * completionDeletionMean n H)) :=
      completionDeletionFraction_mgf_le n H Z C θ hn hH hcomp hC
        hcontrolled hθ

/-- Conditional MGF bound for one stopped completion-weight deletion step. -/
lemma completionStoppedCenteredSum_step_mgf_le {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C θ : ℝ) (hn : 2 ≤ n)
    (hC : 0 < C) (t : ℕ) (ht : t < H.card)
    (e : DeletionHistory H t)
    (hθ : |θ * (C * completionDeletionGamma n H t)| ≤ 1 / 2) :
    finsetAverage
        (Finset.univ : Finset ↥(historyState e t le_rfl))
        (fun A ↦ Real.exp (θ * completionStoppedCenteredSum Z C (t + 1)
          ((historySuccEquiv H t).symm ⟨e, A⟩))) ≤
      Real.exp (θ * completionStoppedCenteredSum Z C t e) *
        Real.exp (θ^2 * C * (completionDeletionGamma n H t)^2) := by
  let G := historyState e t le_rfl
  let S := completionStoppedCenteredSum Z C t e
  have hGcardNat : 0 < G.card := by
    dsimp [G]
    rw [card_historyState]
    exact Nat.sub_pos_of_lt ht
  have hG : G.Nonempty := Finset.card_pos.mp hGcardNat
  have hsum : ∀ A : ↥G,
      completionStoppedCenteredSum Z C (t + 1)
          ((historySuccEquiv H t).symm ⟨e, A⟩) =
        S + if CompletionDeletionHistoryGood Z C t e ∧
            CompletionDeletionStepGood Z C e then
          completionDeletionFraction G Z A.1 -
            completionDeletionMean n G
        else 0 := by
    intro A
    rw [completionStoppedCenteredSum_succ]
    simp only [Equiv.apply_symm_apply]
    rfl
  simp_rw [hsum]
  by_cases hgood : CompletionDeletionHistoryGood Z C t e ∧
      CompletionDeletionStepGood Z C e
  · simp_rw [if_pos hgood]
    have hfactor :
        finsetAverage (Finset.univ : Finset ↥G)
            (fun A ↦ Real.exp (θ *
              (S + (completionDeletionFraction G Z A.1 -
                completionDeletionMean n G)))) =
          Real.exp (θ * S) *
            finsetAverage (Finset.univ : Finset ↥G)
              (fun A ↦ Real.exp (θ *
                (completionDeletionFraction G Z A.1 -
                  completionDeletionMean n G))) := by
      unfold finsetAverage
      simp_rw [show ∀ A : ↥G,
          θ * (S + (completionDeletionFraction G Z A.1 -
              completionDeletionMean n G)) =
            θ * S + θ * (completionDeletionFraction G Z A.1 -
              completionDeletionMean n G) by
        intro A
        ring, Real.exp_add]
      rw [← Finset.mul_sum]
      ring
    rw [hfactor]
    have hmeanEq : completionDeletionMean n G =
        completionDeletionGamma n H t := by
      dsimp [G]
      exact completionDeletionMean_historyState e le_rfl
    have hθG : |θ * (C * completionDeletionMean n G)| ≤ 1 / 2 := by
      simpa only [hmeanEq] using hθ
    have hmgf := completionDeletionFraction_mgf_attach_le
      n G Z C θ hn hG hgood.2.1 hC hgood.2.2 hθG
    apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
    calc
      finsetAverage (Finset.univ : Finset ↥G)
            (fun A ↦ Real.exp (θ *
              (completionDeletionFraction G Z A.1 -
                completionDeletionMean n G))) ≤
          Real.exp (θ^2 * completionDeletionMean n G *
            (C * completionDeletionMean n G)) := hmgf
      _ = Real.exp (θ^2 * C *
            (completionDeletionGamma n H t)^2) := by
        congr 1
        rw [hmeanEq]
        ring
  · simp_rw [if_neg hgood]
    have havg :
        finsetAverage (Finset.univ : Finset ↥G)
            (fun _ ↦ Real.exp (θ * (S + 0))) = Real.exp (θ * S) := by
      unfold finsetAverage
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_coe,
        nsmul_eq_mul, add_zero]
      have hcard : ((G.card : ℕ) : ℝ) ≠ 0 := by
        exact_mod_cast hGcardNat.ne'
      field_simp [hcard]
    rw [havg]
    have hq0 : 0 ≤ θ^2 * C *
        (completionDeletionGamma n H t)^2 := by positivity
    calc
      Real.exp (θ * S) = Real.exp (θ * S) * 1 := by ring
      _ ≤ Real.exp (θ * S) *
          Real.exp (θ^2 * C *
            (completionDeletionGamma n H t)^2) := by
        exact mul_le_mul_of_nonneg_left (Real.one_le_exp hq0)
          (Real.exp_pos _).le

/-- Conditional MGF bound for the last stopped increment, uniformly over
the available next edge after a fixed prefix. -/
lemma stoppedCenteredSum_step_mgf_le {n : ℕ} {H : Finset (Edge n)}
    (C θ : ℝ) (hn : 0 < n) (hC : 0 < C) (t : ℕ) (ht : t < H.card)
    (e : DeletionHistory H t)
    (hθ : |θ * (C * deletionGamma n H t)| ≤ 1 / 2) :
    finsetAverage
        (Finset.univ : Finset ↥(historyState e t le_rfl))
        (fun A ↦ Real.exp (θ * stoppedCenteredSum C (t + 1)
          ((historySuccEquiv H t).symm ⟨e, A⟩))) ≤
      Real.exp (θ * stoppedCenteredSum C t e) *
        Real.exp (θ^2 * C * (deletionGamma n H t)^2) := by
  let G := historyState e t le_rfl
  let S := stoppedCenteredSum C t e
  have hGcardNat : 0 < G.card := by
    dsimp [G]
    rw [card_historyState]
    exact Nat.sub_pos_of_lt ht
  have hG : G.Nonempty := Finset.card_pos.mp hGcardNat
  have hsum : ∀ A : ↥G,
      stoppedCenteredSum C (t + 1)
          ((historySuccEquiv H t).symm ⟨e, A⟩) =
        S + if DeletionHistoryGood C t e ∧ DeletionStepGood C e then
          matchingFraction G A.1 - deletionMean n G
        else 0 := by
    intro A
    rw [stoppedCenteredSum_succ]
    simp only [Equiv.apply_symm_apply]
    rfl
  simp_rw [hsum]
  by_cases hgood : DeletionHistoryGood C t e ∧ DeletionStepGood C e
  · simp_rw [if_pos hgood]
    have hfactor :
        finsetAverage (Finset.univ : Finset ↥G)
            (fun A ↦ Real.exp (θ *
              (S + (matchingFraction G A.1 - deletionMean n G)))) =
          Real.exp (θ * S) *
            finsetAverage (Finset.univ : Finset ↥G)
              (fun A ↦ Real.exp
                (θ * (matchingFraction G A.1 - deletionMean n G))) := by
      unfold finsetAverage
      simp_rw [show ∀ A : ↥G,
          θ * (S + (matchingFraction G A.1 - deletionMean n G)) =
            θ * S + θ * (matchingFraction G A.1 - deletionMean n G) by
        intro A
        ring, Real.exp_add]
      rw [← Finset.mul_sum]
      ring
    rw [hfactor]
    have hmeanEq : deletionMean n G = deletionGamma n H t := by
      dsimp [G]
      exact deletionMean_historyState e le_rfl
    have hθG : |θ * (C * deletionMean n G)| ≤ 1 / 2 := by
      simpa only [hmeanEq] using hθ
    have hmgf := matchingFraction_mgf_attach_le n G C θ hn hG
      hgood.2.1 hC hgood.2.2 hθG
    apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
    calc
      finsetAverage (Finset.univ : Finset ↥G)
            (fun A ↦ Real.exp
              (θ * (matchingFraction G A.1 - deletionMean n G))) ≤
          Real.exp (θ^2 * deletionMean n G *
            (C * deletionMean n G)) := hmgf
      _ = Real.exp (θ^2 * C * (deletionGamma n H t)^2) := by
        congr 1
        rw [hmeanEq]
        ring
  · simp_rw [if_neg hgood]
    have havg :
        finsetAverage (Finset.univ : Finset ↥G)
            (fun _ ↦ Real.exp (θ * (S + 0))) = Real.exp (θ * S) := by
      unfold finsetAverage
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_coe,
        nsmul_eq_mul, add_zero]
      have hcard : ((G.card : ℕ) : ℝ) ≠ 0 := by
        exact_mod_cast hGcardNat.ne'
      field_simp [hcard]
    rw [havg]
    have hq0 : 0 ≤ θ^2 * C * (deletionGamma n H t)^2 := by positivity
    calc
      Real.exp (θ * S) = Real.exp (θ * S) * 1 := by ring
      _ ≤ Real.exp (θ * S) *
          Real.exp (θ^2 * C * (deletionGamma n H t)^2) := by
        exact mul_le_mul_of_nonneg_left (Real.one_le_exp hq0)
          (Real.exp_pos _).le

/-- Product exponential bound for Kahn's stopped deletion martingale, proved
entirely by finite iterated averaging. -/
lemma stoppedCenteredSum_mgf_le {n : ℕ} {H : Finset (Edge n)}
    (C θ : ℝ) (hn : 0 < n) (hC : 0 < C) (T : ℕ) (hT : T ≤ H.card)
    (hθ : ∀ i < T, |θ * (C * deletionGamma n H i)| ≤ 1 / 2) :
    finsetAverage (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ Real.exp (θ * stoppedCenteredSum C T e)) ≤
      Real.exp (θ^2 * deletionVarianceBudget n H C T) := by
  induction T with
  | zero =>
      simp [finsetAverage, deletionVarianceBudget]
  | succ t ih =>
      have ht : t < H.card := Nat.lt_of_succ_le hT
      rw [finsetAverage_deletionHistory_succ H t ht]
      let q : ℝ := θ^2 * C * (deletionGamma n H t)^2
      have hstep : ∀ e : DeletionHistory H t,
          finsetAverage
              (Finset.univ : Finset ↥(historyState e t le_rfl))
              (fun A ↦ Real.exp (θ * stoppedCenteredSum C (t + 1)
                ((historySuccEquiv H t).symm ⟨e, A⟩))) ≤
            Real.exp (θ * stoppedCenteredSum C t e) * Real.exp q := by
        intro e
        exact stoppedCenteredSum_step_mgf_le C θ hn hC t ht e
          (hθ t (Nat.lt_succ_self t))
      calc
        finsetAverage (Finset.univ : Finset (DeletionHistory H t))
              (fun e ↦ finsetAverage
                (Finset.univ : Finset ↥(historyState e t le_rfl))
                (fun A ↦ Real.exp (θ * stoppedCenteredSum C (t + 1)
                  ((historySuccEquiv H t).symm ⟨e, A⟩)))) ≤
            finsetAverage (Finset.univ : Finset (DeletionHistory H t))
              (fun e ↦ Real.exp (θ * stoppedCenteredSum C t e) *
                Real.exp q) := by
          apply finsetAverage_mono
          intro e _
          exact hstep e
        _ = finsetAverage (Finset.univ : Finset (DeletionHistory H t))
              (fun e ↦ Real.exp (θ * stoppedCenteredSum C t e)) *
                Real.exp q :=
          finsetAverage_mul_const _ _ _
        _ ≤ Real.exp (θ^2 * deletionVarianceBudget n H C t) *
              Real.exp q := by
          apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
          exact ih ht.le fun i hi ↦ hθ i (hi.trans (Nat.lt_succ_self t))
        _ = Real.exp (θ^2 * deletionVarianceBudget n H C (t + 1)) := by
          rw [← Real.exp_add, deletionVarianceBudget_succ]
          dsimp [q]
          congr 1
          ring

/-- Product exponential bound for the stopped completion-weight deletion
martingale. -/
lemma completionStoppedCenteredSum_mgf_le {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C θ : ℝ) (hn : 2 ≤ n)
    (hC : 0 < C) (T : ℕ) (hT : T ≤ H.card)
    (hθ : ∀ i < T,
      |θ * (C * completionDeletionGamma n H i)| ≤ 1 / 2) :
    finsetAverage (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ Real.exp
          (θ * completionStoppedCenteredSum Z C T e)) ≤
      Real.exp
        (θ^2 * completionDeletionVarianceBudget n H C T) := by
  induction T with
  | zero =>
      simp [finsetAverage, completionDeletionVarianceBudget]
  | succ t ih =>
      have ht : t < H.card := Nat.lt_of_succ_le hT
      rw [finsetAverage_deletionHistory_succ H t ht]
      let q : ℝ := θ^2 * C * (completionDeletionGamma n H t)^2
      have hstep : ∀ e : DeletionHistory H t,
          finsetAverage
              (Finset.univ : Finset ↥(historyState e t le_rfl))
              (fun A ↦ Real.exp
                (θ * completionStoppedCenteredSum Z C (t + 1)
                  ((historySuccEquiv H t).symm ⟨e, A⟩))) ≤
            Real.exp (θ * completionStoppedCenteredSum Z C t e) *
              Real.exp q := by
        intro e
        exact completionStoppedCenteredSum_step_mgf_le
          Z C θ hn hC t ht e (hθ t (Nat.lt_succ_self t))
      calc
        finsetAverage (Finset.univ : Finset (DeletionHistory H t))
              (fun e ↦ finsetAverage
                (Finset.univ : Finset ↥(historyState e t le_rfl))
                (fun A ↦ Real.exp
                  (θ * completionStoppedCenteredSum Z C (t + 1)
                    ((historySuccEquiv H t).symm ⟨e, A⟩)))) ≤
            finsetAverage (Finset.univ : Finset (DeletionHistory H t))
              (fun e ↦ Real.exp
                (θ * completionStoppedCenteredSum Z C t e) *
                  Real.exp q) := by
          apply finsetAverage_mono
          intro e _
          exact hstep e
        _ = finsetAverage (Finset.univ : Finset (DeletionHistory H t))
              (fun e ↦ Real.exp
                (θ * completionStoppedCenteredSum Z C t e)) *
                Real.exp q :=
          finsetAverage_mul_const _ _ _
        _ ≤ Real.exp
              (θ^2 * completionDeletionVarianceBudget n H C t) *
                Real.exp q := by
          apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
          exact ih ht.le fun i hi ↦
            hθ i (hi.trans (Nat.lt_succ_self t))
        _ = Real.exp
              (θ^2 * completionDeletionVarianceBudget n H C (t + 1)) := by
          rw [← Real.exp_add, completionDeletionVarianceBudget_succ]
          dsimp [q]
          congr 1
          ring

lemma finsetProbability_nonneg {α : Type*} (s : Finset α) (P : α → Prop)
    [DecidablePred P] :
    0 ≤ finsetProbability s P := by
  unfold finsetProbability
  positivity

lemma finsetProbability_or_le_add {α : Type*} (s : Finset α)
    (P Q : α → Prop) [DecidablePred P] [DecidablePred Q] :
    finsetProbability s (fun x ↦ P x ∨ Q x) ≤
      finsetProbability s P + finsetProbability s Q := by
  unfold finsetProbability
  rw [Finset.filter_or]
  have hcard : (s.filter P ∪ s.filter Q).card ≤
      (s.filter P).card + (s.filter Q).card :=
    Finset.card_union_le _ _
  calc
    ((s.filter P ∪ s.filter Q).card : ℝ) / s.card ≤
        (((s.filter P).card : ℝ) + (s.filter Q).card) / s.card := by
      exact div_le_div_of_nonneg_right (by exact_mod_cast hcard) (by positivity)
    _ = ((s.filter P).card : ℝ) / s.card +
          ((s.filter Q).card : ℝ) / s.card := by ring

/-- Finite union bound for a family of events indexed by a finset. -/
lemma finsetProbability_bexists_le_sum {α ι : Type*} (s : Finset α)
    (I : Finset ι) (P : ι → α → Prop) :
    finsetProbability s (fun x ↦ ∃ i ∈ I, P i x) ≤
      ∑ i ∈ I, finsetProbability s (P i) := by
  classical
  induction I using Finset.induction_on with
  | empty => simp [finsetProbability]
  | @insert a I ha ih =>
      have hmono :
          finsetProbability s (fun x ↦ ∃ i ∈ insert a I, P i x) ≤
            finsetProbability s
              (fun x ↦ P a x ∨ ∃ i ∈ I, P i x) := by
        apply finsetProbability_mono_event
        intro x hx
        rintro ⟨i, hi, hPi⟩
        rcases Finset.mem_insert.mp hi with rfl | hi
        · exact Or.inl hPi
        · exact Or.inr ⟨i, hi, hPi⟩
      calc
        finsetProbability s (fun x ↦ ∃ i ∈ insert a I, P i x) ≤
            finsetProbability s
              (fun x ↦ P a x ∨ ∃ i ∈ I, P i x) := hmono
        _ ≤ finsetProbability s (P a) +
            finsetProbability s (fun x ↦ ∃ i ∈ I, P i x) :=
          finsetProbability_or_le_add s (P a)
            (fun x ↦ ∃ i ∈ I, P i x)
        _ ≤ finsetProbability s (P a) +
            ∑ i ∈ I, finsetProbability s (P i) :=
          add_le_add_right ih _
        _ = ∑ i ∈ insert a I, finsetProbability s (P i) := by
          simp [ha]

/-- Union bound over a finite type. -/
lemma finsetProbability_exists_le_sum {α ι : Type*} [Fintype ι]
    (s : Finset α) (P : ι → α → Prop) :
    finsetProbability s (fun x ↦ ∃ i, P i x) ≤
      ∑ i : ι, finsetProbability s (P i) := by
  classical
  simpa only [Finset.mem_univ, true_and] using
    finsetProbability_bexists_le_sum s (Finset.univ : Finset ι) P

/-- Exact union bound for drawing at least `b` marked points in a uniform
`t`-subset.  The right side counts a choice of `b` witnessed marked points
and then completes it to a `t`-subset. -/
lemma card_powersetCard_many_hits_le {α : Type*} (s Y : Finset α)
    (hYs : Y ⊆ s) (t b : ℕ) (hbt : b ≤ t) :
    ((s.powersetCard t).filter fun L ↦ b ≤ (L ∩ Y).card).card ≤
      Y.card.choose b * (s.card - b).choose (t - b) := by
  let bad := (s.powersetCard t).filter fun L ↦ b ≤ (L ∩ Y).card
  let cover := (Y.powersetCard b).biUnion fun B ↦
    (s.powersetCard t).filter fun L ↦ B ⊆ L
  have hbadCover : bad ⊆ cover := by
    intro L hL
    rcases Finset.mem_filter.mp hL with ⟨hLt, hhit⟩
    rcases Finset.mem_powersetCard.mp hLt with ⟨hLs, hLcard⟩
    obtain ⟨B, hBinter, hBcard⟩ := Finset.exists_subset_card_eq hhit
    have hBY : B ⊆ Y := fun x hx ↦
      (Finset.mem_inter.mp (hBinter hx)).2
    have hBL : B ⊆ L := fun x hx ↦
      (Finset.mem_inter.mp (hBinter hx)).1
    apply Finset.mem_biUnion.mpr
    refine ⟨B, Finset.mem_powersetCard.mpr ⟨hBY, hBcard⟩, ?_⟩
    exact Finset.mem_filter.mpr ⟨hLt, hBL⟩
  have hfiber : ∀ B ∈ Y.powersetCard b,
      ((s.powersetCard t).filter fun L ↦ B ⊆ L).card =
        (s.card - b).choose (t - b) := by
    intro B hB
    rcases Finset.mem_powersetCard.mp hB with ⟨hBY, hBcard⟩
    have hBs : B ⊆ s := hBY.trans hYs
    simpa [hBcard] using
      Finset.card_filter_powersetCard_subset B s t hBs
        (by simpa [hBcard] using hbt)
  calc
    bad.card ≤ cover.card := Finset.card_le_card hbadCover
    _ ≤ ∑ B ∈ Y.powersetCard b,
        ((s.powersetCard t).filter fun L ↦ B ⊆ L).card :=
      Finset.card_biUnion_le
    _ = ∑ _B ∈ Y.powersetCard b,
        (s.card - b).choose (t - b) := by
      apply Finset.sum_congr rfl
      exact hfiber
    _ = Y.card.choose b * (s.card - b).choose (t - b) := by
      simp [Finset.card_powersetCard]

/-- Probability form of `card_powersetCard_many_hits_le`. -/
lemma powersetCard_many_hits_probability_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t b : ℕ) (hbt : b ≤ t) :
    finsetProbability (s.powersetCard t)
        (fun L ↦ b ≤ (L ∩ Y).card) ≤
      ((Y.card.choose b : ℕ) : ℝ) *
          (((s.card - b).choose (t - b) : ℕ) : ℝ) /
        ((s.card.choose t : ℕ) : ℝ) := by
  unfold finsetProbability
  rw [Finset.card_powersetCard]
  have hcard := card_powersetCard_many_hits_le s Y hYs t b hbt
  have hcardR :
      ((((s.powersetCard t).filter fun L ↦
          b ≤ (L ∩ Y).card).card : ℕ) : ℝ) ≤
        ((Y.card.choose b *
          (s.card - b).choose (t - b) : ℕ) : ℝ) := by
    exact_mod_cast hcard
  calc
    ((((s.powersetCard t).filter fun L ↦
        b ≤ (L ∩ Y).card).card : ℕ) : ℝ) /
          ((s.card.choose t : ℕ) : ℝ) ≤
      ((Y.card.choose b *
        (s.card - b).choose (t - b) : ℕ) : ℝ) /
          ((s.card.choose t : ℕ) : ℝ) :=
      div_le_div_of_nonneg_right hcardR (by positivity)
    _ = ((Y.card.choose b : ℕ) : ℝ) *
          (((s.card - b).choose (t - b) : ℕ) : ℝ) /
        ((s.card.choose t : ℕ) : ℝ) := by
      norm_num only [Nat.cast_mul]

/-- Fiberwise conditional-link count.  The analytic input is isolated in
`hratio`: it is exactly the binomial-ratio bound, uniform over every link
size between `d` and `D`. -/
lemma coordinateFiberLinkTail_card_le {n M d D Q b : ℕ}
    {Z : Edge n} {x y : Vertex n} {a p : ℝ} (hp : 0 ≤ p)
    (hratio : ∀ t : ℕ, d ≤ t → t ≤ D →
      ((((Q.choose b) *
          ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
        p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    (((coordinateLayerDecompositions n M Z x y).filter fun q ↦
        CoordinateFiberLinkTail Z y a d D Q b q).card : ℕ) ≤
      p * ((coordinateLayerDecompositions n M Z x y).card : ℝ) := by
  let P := coordinateAmbientPairs n Z y
  let O := (coordinateOutsideLayer n Z x y).powerset.filter fun R ↦
    R.card ≤ M
  rw [coordinateLayerDecompositions, Finset.filter_sigma,
    Finset.card_sigma, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro R hRO
  let t := M - R.card
  let Y := coordinateResidualBadPairs n (inducedAway R Z) Z y a
  let F := P.powersetCard t
  by_cases hpre : d ≤ t ∧ t ≤ D ∧ Y.card ≤ Q
  · by_cases hbt : b ≤ t
    · let hit : Finset (Edge n) → ℕ := fun L ↦
        (@Inter.inter (Finset (Edge n))
          (@Finset.instInter (Edge n)
            (fun u v ↦ Classical.propDecidable (u = v))) L Y).card
      have htailSub :
          F.filter (fun L ↦
              CoordinateFiberLinkTail Z y a d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n))) ⊆
            F.filter (fun L ↦ b ≤ hit L) := by
        intro L hL
        rcases Finset.mem_filter.mp hL with ⟨hLF, htail⟩
        apply Finset.mem_filter.mpr
        refine ⟨hLF, ?_⟩
        have heq :
            @Inter.inter (Finset (Edge n))
                (@Finset.instInter (Edge n)
                  (fun u v ↦ Classical.propDecidable (u = v))) L Y =
              L ∩ Y := by
          ext U
          simp
        simpa only [hit, heq] using htail.2.2.2
      have htail := card_powersetCard_many_hits_le P Y
        (Finset.filter_subset _ _) t b hbt
      have hchoose : Y.card.choose b ≤ Q.choose b :=
        Nat.choose_le_choose b hpre.2.2
      have hnat :
          (F.filter (fun L ↦
              CoordinateFiberLinkTail Z y a d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n)))).card ≤
            Q.choose b * (P.card - b).choose (t - b) := by
        calc
          (F.filter (fun L ↦
              CoordinateFiberLinkTail Z y a d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n)))).card ≤
              (F.filter fun L ↦ b ≤ hit L).card :=
            Finset.card_le_card htailSub
          _ ≤ Y.card.choose b * (P.card - b).choose (t - b) := by
            simpa only [F, hit] using htail
          _ ≤ Q.choose b * (P.card - b).choose (t - b) := by
            exact Nat.mul_le_mul_right _ hchoose
      have hnatR :
          (((F.filter (fun L ↦
              CoordinateFiberLinkTail Z y a d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n)))).card : ℕ) : ℝ) ≤
            (((Q.choose b) * (P.card - b).choose (t - b) : ℕ) : ℝ) := by
        exact_mod_cast hnat
      calc
        (((F.filter (fun L ↦
            CoordinateFiberLinkTail Z y a d D Q b
              (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                Finset (Edge n)))).card : ℕ) : ℝ) ≤
            (((Q.choose b) * (P.card - b).choose (t - b) : ℕ) : ℝ) := hnatR
        _ ≤ p * ((P.card.choose t : ℕ) : ℝ) :=
          hratio t hpre.1 hpre.2.1
        _ = p * ((F.card : ℕ) : ℝ) := by
          rw [Finset.card_powersetCard]
    · have hempty :
          F.filter (fun L ↦
            CoordinateFiberLinkTail Z y a d D Q b
              (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                Finset (Edge n))) = ∅ := by
        apply Finset.eq_empty_iff_forall_notMem.mpr
        intro L hL
        rcases Finset.mem_filter.mp hL with ⟨hLF, htail⟩
        have hLcard := (Finset.mem_powersetCard.mp hLF).2
        have hinter : (L ∩ Y).card ≤ L.card :=
          Finset.card_le_card Finset.inter_subset_left
        have hbL : b ≤ L.card := htail.2.2.2.trans hinter
        exact hbt (by simpa only [hLcard] using hbL)
      rw [hempty]
      norm_num only [Finset.card_empty, Nat.cast_zero]
      exact mul_nonneg hp (Nat.cast_nonneg _)
  · have hempty :
        F.filter (fun L ↦
          CoordinateFiberLinkTail Z y a d D Q b
            (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
              Finset (Edge n))) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro L hL
      rcases Finset.mem_filter.mp hL with ⟨hLF, htail⟩
      have hLcard := (Finset.mem_powersetCard.mp hLF).2
      apply hpre
      simpa only [hLcard] using
        (show d ≤ L.card ∧ L.card ≤ D ∧ Y.card ≤ Q from
          ⟨htail.1, htail.2.1, htail.2.2.1⟩)
    rw [hempty]
    norm_num only [Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg hp (Nat.cast_nonneg _)

/-- Exact fixed-edge probability version of conditional uniform sampling
from a coordinate link layer. -/
lemma coordinateSampleLinkTail_probability_le {n M d D Q b : ℕ}
    {Z : Edge n} {x y : Vertex n} {a p : ℝ}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p)
    (hratio : ∀ t : ℕ, d ≤ t → t ≤ D →
      ((((Q.choose b) *
          ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
        p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (CoordinateSampleLinkTail Z x y a d D Q b) ≤ p := by
  let Dcmp := coordinateLayerDecompositions n M Z x y
  let E := CoordinateSampleLinkTail Z x y a d D Q b
  let EF := CoordinateFiberLinkTail Z y a d D Q b
  have hgoodCard :
      (Dcmp.filter EF).card = ((sample n M).filter E).card := by
    apply Finset.card_bij (fun q _ ↦ assembleCoordinateLayer x q)
    · intro q hq
      rcases Finset.mem_filter.mp hq with ⟨hqD, hqE⟩
      exact Finset.mem_filter.mpr
        ⟨assembleCoordinateLayer_mapsTo_sample hZ hx hqD,
          (coordinateSampleLinkTail_assemble_iff hx hqD).2 hqE⟩
    · intro q hq r hr heq
      exact assembleCoordinateLayer_injectiveOn hx
        (Finset.mem_filter.mp hq).1 (Finset.mem_filter.mp hr).1 heq
    · intro H hH
      rcases Finset.mem_filter.mp hH with ⟨hHs, hHE⟩
      rcases assembleCoordinateLayer_surjective_sample hx H hHs with
        ⟨q, hqD, hqH⟩
      refine ⟨q, Finset.mem_filter.mpr ⟨hqD, ?_⟩, hqH⟩
      exact (coordinateSampleLinkTail_assemble_iff hx hqD).1 (hqH ▸ hHE)
  have hcount := coordinateFiberLinkTail_card_le
    (n := n) (M := M) (d := d) (D := D) (Q := Q) (b := b)
    (Z := Z) (x := x) (y := y) (a := a) hp hratio
  have hdecompCard := card_coordinateLayerDecompositions_eq_sample
    (M := M) (y := y) hZ hx
  have hsampleNat : 0 < (sample n M).card := by
    rw [card_sample]
    exact Nat.choose_pos hM
  have hsample : (0 : ℝ) < (sample n M).card := by
    exact_mod_cast hsampleNat
  unfold finsetProbability
  apply (div_le_iff₀ hsample).2
  rw [← hgoodCard, ← hdecompCard]
  exact hcount

/-- Exchange the two finite incidence sums underlying a first-moment bound
for the number of simultaneously occurring events. -/
lemma sum_card_filter_swap {α ι : Type*} (s : Finset α) (I : Finset ι)
    (P : ι → α → Prop) :
    ∑ x ∈ s, (I.filter fun i ↦ P i x).card =
      ∑ i ∈ I, (s.filter fun x ↦ P i x).card := by
  calc
    ∑ x ∈ s, (I.filter fun i ↦ P i x).card =
        ∑ x ∈ s, ∑ i ∈ I, if P i x then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro x hx
      exact (Finset.sum_boole (R := ℕ) (fun i ↦ P i x) I).symm
    _ = ∑ i ∈ I, ∑ x ∈ s, if P i x then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ i ∈ I, (s.filter fun x ↦ P i x).card := by
      apply Finset.sum_congr rfl
      intro i hi
      exact Finset.sum_boole (R := ℕ) (P i) s

lemma finsetAverage_card_filter_eq_sum_probability {α ι : Type*}
    (s : Finset α) (I : Finset ι) (P : ι → α → Prop) :
    finsetAverage s (fun x ↦ ((I.filter fun i ↦ P i x).card : ℝ)) =
      ∑ i ∈ I, finsetProbability s (P i) := by
  unfold finsetAverage finsetProbability
  rw [← Finset.sum_div]
  congr 1
  norm_num only [Nat.cast_sum]
  exact_mod_cast sum_card_filter_swap s I P

/-- Incoming vertices witnessing the conditional link-tail event. -/
def coordinateLinkTailVertices {n : ℕ} (Z : Edge n) (x : Vertex n)
    (a : ℝ) (d D Q b : ℕ) (H : Finset (Edge n)) :
    Finset (Vertex n) :=
  Finset.univ.filter fun y ↦ y ∉ Z ∧
    CoordinateSampleLinkTail Z x y a d D Q b H

/-- Finite-uniform first-moment (Markov) inequality. -/
lemma finsetProbability_mul_le_average_of_nonneg {α : Type*}
    (s : Finset α) (W : α → ℝ) (u : ℝ)
    (hW : ∀ x ∈ s, 0 ≤ W x) :
    finsetProbability s (fun x ↦ u ≤ W x) * u ≤
      finsetAverage s W := by
  let t := s.filter (fun x ↦ u ≤ W x)
  have hconst : (t.card : ℝ) * u ≤ ∑ x ∈ t, W x := by
    simpa only [Finset.sum_const, nsmul_eq_mul] using
      (Finset.sum_le_sum fun (x : α) (hx : x ∈ t) ↦
        (show u ≤ W x from (Finset.mem_filter.mp hx).2))
  have hsub : t ⊆ s := Finset.filter_subset _ _
  have hsum : ∑ x ∈ t, W x ≤ ∑ x ∈ s, W x := by
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub fun x hxs _ ↦ hW x hxs
  unfold finsetProbability finsetAverage
  dsimp [t] at hconst hsum ⊢
  rw [div_mul_eq_mul_div]
  exact div_le_div_of_nonneg_right (hconst.trans hsum) (by positivity)

/-- First moment bound for the number of events that occur at once. -/
lemma finsetProbability_many_finite_events_le {α ι : Type*}
    (s : Finset α) (I : Finset ι) (P : ι → α → Prop)
    (k : ℕ) (p : ℝ) (hk : 0 < k)
    (hP : ∀ i ∈ I, finsetProbability s (P i) ≤ p) :
    finsetProbability s
        (fun x ↦ (k : ℝ) ≤ (I.filter fun i ↦ P i x).card) ≤
      ((I.card : ℝ) * p) / k := by
  let W : α → ℝ := fun x ↦ ((I.filter fun i ↦ P i x).card : ℝ)
  have hmarkov := finsetProbability_mul_le_average_of_nonneg
    s W (k : ℝ) (fun x hx ↦ by dsimp [W]; positivity)
  have havg : finsetAverage s W ≤ (I.card : ℝ) * p := by
    rw [show finsetAverage s W =
        ∑ i ∈ I, finsetProbability s (P i) by
      simpa [W] using finsetAverage_card_filter_eq_sum_probability s I P]
    calc
      ∑ i ∈ I, finsetProbability s (P i) ≤ ∑ _i ∈ I, p :=
        Finset.sum_le_sum hP
      _ = (I.card : ℝ) * p := by simp
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  apply (le_div_iff₀ hkR).2
  exact hmarkov.trans havg

/-- Union/first-moment lift of the exact one-vertex conditional sampling
bound. -/
lemma coordinateLinkTailVertices_probability_le {n M d D Q b k : ℕ}
    {Z : Edge n} {x : Vertex n} {a p : ℝ}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p) (hk : 0 < k)
    (hratio : ∀ y : Vertex n, y ∉ Z → ∀ t : ℕ,
      d ≤ t → t ≤ D →
        ((((Q.choose b) *
            ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
          p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (fun H ↦ (k : ℝ) ≤
          (coordinateLinkTailVertices Z x a d D Q b H).card) ≤
      (((3 * n : ℕ) : ℝ) * p) / k := by
  let I := (Finset.univ : Finset (Vertex n))
  let P : Vertex n → Finset (Edge n) → Prop := fun y H ↦
    y ∉ Z ∧ CoordinateSampleLinkTail Z x y a d D Q b H
  letI : ∀ y, DecidablePred (P y) := fun _ ↦ Classical.decPred _
  have hpoint : ∀ y ∈ I,
      finsetProbability (sample n M) (P y) ≤ p := by
    intro y hyI
    by_cases hyZ : y ∈ Z
    · have hzero : finsetProbability (sample n M) (P y) = 0 := by
        unfold finsetProbability
        have hempty : (sample n M).filter (P y) = ∅ := by
          apply Finset.eq_empty_iff_forall_notMem.mpr
          intro H hH
          exact (Finset.mem_filter.mp hH).2.1 hyZ
        rw [hempty]
        simp
      rw [hzero]
      exact hp
    · have htail := coordinateSampleLinkTail_probability_le
        (M := M) (d := d) (D := D) (Q := Q) (b := b)
        (Z := Z) (x := x) (y := y) (a := a) hZ hx hM hp
        (hratio y hyZ)
      have hmono : finsetProbability (sample n M) (P y) ≤
          finsetProbability (sample n M)
            (CoordinateSampleLinkTail Z x y a d D Q b) := by
        apply finsetProbability_mono_event
        intro H hHs hPy
        exact hPy.2
      exact hmono.trans htail
  have hmany := finsetProbability_many_finite_events_le
    (sample n M) I P k p hk hpoint
  have hmany' :
      finsetProbability (sample n M)
          (fun H ↦ (k : ℝ) ≤ (I.filter fun y ↦ P y H).card) ≤
        ((I.card : ℝ) * p) / k := by
    refine (finsetProbability_congr_event (sample n M) _ _ ?_).le.trans hmany
    intro H hHs
    exact Iff.rfl
  calc
    finsetProbability (sample n M)
          (fun H ↦ (k : ℝ) ≤
            (coordinateLinkTailVertices Z x a d D Q b H).card) =
        finsetProbability (sample n M)
          (fun H ↦ (k : ℝ) ≤ (I.filter fun y ↦ P y H).card) := by
      apply finsetProbability_congr_event
      intro H hHs
      have hcard :
          (coordinateLinkTailVertices Z x a d D Q b H).card =
            (I.filter fun y ↦ P y H).card := by
        apply congrArg Finset.card
        unfold coordinateLinkTailVertices
        dsimp only [I, P]
        exact Finset.filter_congr_decidable _ _ _
      rw [hcard]
    _ ≤ (((3 * n : ℕ) : ℝ) * p) / k := by
      simpa only [I, Finset.card_univ, Fintype.card_fin, Nat.cast_mul,
        Nat.cast_ofNat] using hmany'

/-- An exposed coordinate link is no larger than the degree of its fixed
vertex. -/
lemma card_coordinateLinkPairs_le_vertexDegree {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) {x y : Vertex n} (hx : x ∈ Z) :
    (coordinateLinkPairs H Z x y).card ≤ vertexDegree H x := by
  rw [card_coordinateLinkPairs_eq_inter_linkLayer hx]
  unfold vertexDegree
  apply Finset.card_le_card
  intro A hA
  rcases Finset.mem_inter.mp hA with ⟨hAH, hAlayer⟩
  apply Finset.mem_filter.mpr
  refine ⟨hAH, ?_⟩
  rcases mem_coordinateLinkLayer.mp hAlayer with ⟨S, hS, rfl⟩
  exact Finset.mem_insert_self x S

/-- Uniform lower and upper size bounds for every incoming coordinate
link at a fixed marked edge and coordinate. -/
def CoordinateLinksInRange {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (x : Vertex n) (d D : ℕ) : Prop :=
  ∀ y : Vertex n, y ∉ Z →
    d ≤ (coordinateLinkPairs H Z x y).card ∧
      (coordinateLinkPairs H Z x y).card ≤ D

/-- Degree and codegree regularity imply uniform coordinate-link size
bounds. -/
lemma coordinateLinksInRange_of_degree_codegree {n d D codegCap : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {x : Vertex n}
    (hH : H ⊆ allEdges n) (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hdegreeLower : d ≤ vertexDegree H x - 3 * codegCap)
    (hdegreeUpper : vertexDegree H x ≤ D)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap) :
    CoordinateLinksInRange H Z x d D := by
  intro y hyZ
  refine ⟨hdegreeLower.trans ?_, ?_⟩
  · exact vertexDegree_sub_three_mul_codegree_le_linkPairs hH hZ hx hyZ
      (fun v hv ↦ hcodeg x v (by
        rcases Finset.mem_insert.mp hv with rfl | hv
        · exact fun hxv ↦ hyZ (hxv ▸ hx)
        · exact (Finset.mem_erase.mp hv).1.symm))
  · exact (card_coordinateLinkPairs_le_vertexDegree H Z hx).trans hdegreeUpper

/-- Incoming vertices whose ambient residual pair population exceeds the
cutoff used in the conditional hypergeometric tail. -/
def coordinateResidualExceptionalVertices {n : ℕ}
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) (Q : ℕ) :
    Finset (Vertex n) :=
  Finset.univ.filter fun y ↦
    Q + 1 ≤ (coordinateResidualBadPairs n G Z y a).card

lemma coordinateResidualExceptionalVertices_card_mul_le {n B Q : ℕ}
    {G : Finset (Edge n)} {Z : Edge n} {a : ℝ}
    (hB : (residualBadTriples n G a).card ≤ B) :
    (coordinateResidualExceptionalVertices G Z a Q).card * (Q + 1) ≤
      3 * B := by
  simpa only [coordinateResidualExceptionalVertices] using
    (card_vertices_with_many_residualBadPairs_mul_le
      (G := G) (Z := Z) (a := a) (b := Q + 1) hB)

/-- Every genuine coordinate-link failure is either caused by an
exceptionally large ambient bad-pair population or is one of the
conditional link-tail vertices counted above. -/
lemma coordinateLinkFailureVertices_subset_exceptional_union_tail
    {n d D Q b : ℕ} {H : Finset (Edge n)} {Z : Edge n}
    {x : Vertex n} {a : ℝ}
    (hrange : CoordinateLinksInRange H Z x d D) :
    coordinateLinkFailureVertices n H Z x d b a ⊆
      coordinateResidualExceptionalVertices (inducedAway H Z) Z a Q ∪
        coordinateLinkTailVertices Z x a d D Q (b + 1) H := by
  intro y hy
  rcases Finset.mem_filter.mp hy with ⟨_hyuniv, hyZ, hfail⟩
  rcases hrange y hyZ with ⟨hlower, hupper⟩
  rcases hfail with hsmall | hbad
  · omega
  · by_cases hex :
        Q + 1 ≤
          (coordinateResidualBadPairs n (inducedAway H Z) Z y a).card
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ y, hex⟩
    · apply Finset.mem_union_right
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_univ y, hyZ, ?_⟩
      exact ⟨hlower, hupper, Nat.le_of_lt_succ (Nat.lt_of_not_ge hex),
        Nat.succ_le_iff.mpr hbad⟩

/-- Deterministic global-to-local budget conversion.  The first budget
controls vertices with a large ambient bad-pair population; the second
controls the genuinely hypergeometric tail. -/
lemma coordinateLinkFailureVertices_card_le_of_global
    {n d D Q b B e₀ e₁ : ℕ} {H : Finset (Edge n)} {Z : Edge n}
    {x : Vertex n} {a : ℝ}
    (hrange : CoordinateLinksInRange H Z x d D)
    (hglobal : (residualBadTriples n (inducedAway H Z) a).card ≤ B)
    (hbudget : 3 * B ≤ e₀ * (Q + 1))
    (htail : (coordinateLinkTailVertices Z x a d D Q (b + 1) H).card ≤ e₁) :
    (coordinateLinkFailureVertices n H Z x d b a).card ≤ e₀ + e₁ := by
  let E := coordinateResidualExceptionalVertices (inducedAway H Z) Z a Q
  let T := coordinateLinkTailVertices Z x a d D Q (b + 1) H
  have hEmul : E.card * (Q + 1) ≤ 3 * B := by
    simpa only [E] using
      (coordinateResidualExceptionalVertices_card_mul_le
        (G := inducedAway H Z) (Z := Z) (a := a) (Q := Q) hglobal)
  have hE : E.card ≤ e₀ := by
    apply Nat.le_of_mul_le_mul_left (c := Q + 1)
    · simpa only [Nat.mul_comm] using hEmul.trans hbudget
    · omega
  calc
    (coordinateLinkFailureVertices n H Z x d b a).card ≤
        (E ∪ T).card := by
      apply Finset.card_le_card
      simpa only [E, T] using
        (coordinateLinkFailureVertices_subset_exceptional_union_tail
          (Q := Q) (b := b) hrange)
    _ ≤ E.card + T.card := Finset.card_union_le E T
    _ ≤ e₀ + e₁ := Nat.add_le_add hE (by simpa only [T] using htail)

/-- Fixed-edge probability form of the global-to-local reduction: once
the deterministic ambient and link-size hypotheses hold throughout the
sample space, a large coordinate-failure set forces many conditional
link-tail vertices. -/
lemma coordinateLinkFailureVertices_probability_le_of_global
    {n M d D Q b B e₀ e₁ : ℕ} {Z : Edge n} {x : Vertex n}
    {a p : ℝ}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p)
    (hrange : ∀ H ∈ sample n M, CoordinateLinksInRange H Z x d D)
    (hglobal : ∀ H ∈ sample n M,
      (residualBadTriples n (inducedAway H Z) a).card ≤ B)
    (hbudget : 3 * B ≤ e₀ * (Q + 1))
    (hratio : ∀ y : Vertex n, y ∉ Z → ∀ t : ℕ,
      d ≤ t → t ≤ D →
        ((((Q.choose (b + 1)) *
            ((coordinateAmbientPairs n Z y).card - (b + 1)).choose
              (t - (b + 1)) : ℕ) : ℝ) ≤
          p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (fun H ↦ ((e₀ + e₁ + 1 : ℕ) : ℝ) ≤
          (coordinateLinkFailureVertices n H Z x d b a).card) ≤
      (((3 * n : ℕ) : ℝ) * p) / (e₁ + 1) := by
  have hmono :
      finsetProbability (sample n M)
          (fun H ↦ ((e₀ + e₁ + 1 : ℕ) : ℝ) ≤
            (coordinateLinkFailureVertices n H Z x d b a).card) ≤
        finsetProbability (sample n M)
          (fun H ↦ ((e₁ + 1 : ℕ) : ℝ) ≤
            (coordinateLinkTailVertices Z x a d D Q (b + 1) H).card) := by
    apply finsetProbability_mono_event
    intro H hHs hfailure
    have hfailureNat : e₀ + e₁ + 1 ≤
        (coordinateLinkFailureVertices n H Z x d b a).card := by
      exact_mod_cast hfailure
    have htailNat : e₁ + 1 ≤
        (coordinateLinkTailVertices Z x a d D Q (b + 1) H).card := by
      by_contra hnot
      have htailUpper :
          (coordinateLinkTailVertices Z x a d D Q (b + 1) H).card ≤ e₁ := by
        omega
      have hfailureUpper := coordinateLinkFailureVertices_card_le_of_global
        (b := b) (B := B) (e₀ := e₀) (e₁ := e₁)
        (hrange H hHs) (hglobal H hHs) hbudget htailUpper
      omega
    exact_mod_cast htailNat
  have htail := coordinateLinkTailVertices_probability_le
    (M := M) (d := d) (D := D) (Q := Q) (b := b + 1)
    (k := e₁ + 1) (a := a) hZ hx hM hp (by omega) hratio
  exact hmono.trans (by
    simpa only [Nat.cast_add, Nat.cast_one] using htail)

/-- The elementary union-bound ratio for a hypergeometric upper tail.
It is the exact binomial identity followed by
`choose Q b ≤ Q^b` and the product bound
`choose t b / choose S b ≤ (t/S)^b`. -/
lemma choose_mul_choose_sub_le_pow_mul_choose
    (S Q t b : ℕ) (hbt : b ≤ t) (htS : t ≤ S) :
    (((Q.choose b) * ((S - b).choose (t - b)) : ℕ) : ℝ) ≤
      (((Q : ℝ) * (t : ℝ) / (S : ℝ)) ^ b) *
        ((S.choose t : ℕ) : ℝ) := by
  have hbS : b ≤ S := hbt.trans htS
  have hSbNat : 0 < S.choose b := Nat.choose_pos hbS
  have hSb : (0 : ℝ) < S.choose b := by exact_mod_cast hSbNat
  have hchooseRatio := choose_ratio_le_pow t S b hbt htS
  have htb : ((t.choose b : ℕ) : ℝ) ≤
      (((t : ℝ) / (S : ℝ)) ^ b) * ((S.choose b : ℕ) : ℝ) := by
    exact (div_le_iff₀ hSb).mp hchooseRatio
  have hQNat : Q.choose b ≤ Q ^ b := Nat.choose_le_pow Q b
  have hQ : ((Q.choose b : ℕ) : ℝ) ≤ (Q : ℝ) ^ b := by
    exact_mod_cast hQNat
  have hidentityNat := Nat.choose_mul (n := S) (k := t) (s := b) hbt
  have hidentity :
      ((S.choose t : ℕ) : ℝ) * ((t.choose b : ℕ) : ℝ) =
        ((S.choose b : ℕ) : ℝ) *
          (((S - b).choose (t - b) : ℕ) : ℝ) := by
    exact_mod_cast hidentityNat
  apply (le_of_mul_le_mul_right _ hSb)
  calc
    (((Q.choose b) * ((S - b).choose (t - b)) : ℕ) : ℝ) *
          ((S.choose b : ℕ) : ℝ) =
        ((Q.choose b : ℕ) : ℝ) *
          (((S.choose t : ℕ) : ℝ) * ((t.choose b : ℕ) : ℝ)) := by
      norm_num only [Nat.cast_mul]
      rw [hidentity]
      ring
    _ ≤ (Q : ℝ) ^ b *
          (((S.choose t : ℕ) : ℝ) *
            ((((t : ℝ) / (S : ℝ)) ^ b) *
              ((S.choose b : ℕ) : ℝ))) := by
      gcongr
    _ = ((((Q : ℝ) * (t : ℝ) / (S : ℝ)) ^ b) *
          ((S.choose t : ℕ) : ℝ)) *
        ((S.choose b : ℕ) : ℝ) := by
      rw [show (Q : ℝ) * (t : ℝ) / (S : ℝ) =
          (Q : ℝ) * ((t : ℝ) / (S : ℝ)) by ring, mul_pow]
      ring

/-- The ambient coordinate layer is simply the family of pairs in the
complement of the four forbidden vertices. -/
lemma coordinateAmbientPairs_eq_powersetCard {n : ℕ}
    (Z : Edge n) (y : Vertex n) :
    coordinateAmbientPairs n Z y =
      ((Finset.univ : Finset (Vertex n)) \ insert y Z).powersetCard 2 := by
  ext S
  rw [mem_coordinateAmbientPairs, Finset.mem_powersetCard]
  constructor
  · rintro ⟨hcard, hdisj⟩
    refine ⟨?_, hcard⟩
    intro v hvS
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ v,
      fun hv ↦ Finset.disjoint_left.mp hdisj hvS hv⟩
  · rintro ⟨hsub, hcard⟩
    refine ⟨hcard, Finset.disjoint_left.mpr ?_⟩
    intro v hvS hvForbidden
    exact (Finset.mem_sdiff.mp (hsub hvS)).2 hvForbidden

lemma card_coordinateAmbientPairs {n : ℕ} {Z : Edge n} {y : Vertex n}
    (hZ : Z ∈ allEdges n) (hy : y ∉ Z) :
    (coordinateAmbientPairs n Z y).card = (3 * n - 4).choose 2 := by
  rw [coordinateAmbientPairs_eq_powersetCard, Finset.card_powersetCard,
    Finset.card_sdiff]
  simp only [Finset.inter_univ, Finset.card_univ, Fintype.card_fin]
  rw [Finset.card_insert_of_notMem hy, mem_allEdges.mp hZ]

/-- A uniform specialization of the preceding binomial estimate: if the
link size is at most `D`, its bad-hit union bound is controlled by
`(QD/S)^b`, where `S` is the ambient pair-population size. -/
lemma coordinate_hypergeometric_ratio_le {n Q D t b : ℕ}
    {Z : Edge n} {y : Vertex n}
    (hZ : Z ∈ allEdges n) (hy : y ∉ Z)
    (hb : b ≤ t) (htD : t ≤ D)
    (hDS : D ≤ (3 * n - 4).choose 2)
    (hS : 0 < (3 * n - 4).choose 2) :
    ((((Q.choose b) *
        ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
      ((((Q : ℝ) * (D : ℝ) /
          (((3 * n - 4).choose 2 : ℕ) : ℝ)) ^ b) *
        (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) := by
  let S := (3 * n - 4).choose 2
  have htS : t ≤ S := htD.trans hDS
  have hbase := choose_mul_choose_sub_le_pow_mul_choose S Q t b hb htS
  rw [card_coordinateAmbientPairs hZ hy]
  change (((Q.choose b) * ((S - b).choose (t - b)) : ℕ) : ℝ) ≤ _
  calc
    (((Q.choose b) * ((S - b).choose (t - b)) : ℕ) : ℝ) ≤
        (((Q : ℝ) * (t : ℝ) / (S : ℝ)) ^ b) *
          ((S.choose t : ℕ) : ℝ) := hbase
    _ ≤ (((Q : ℝ) * (D : ℝ) / (S : ℝ)) ^ b) *
          ((S.choose t : ℕ) : ℝ) := by
      have hSreal : (0 : ℝ) < S := by exact_mod_cast hS
      have htDreal : (t : ℝ) ≤ D := by exact_mod_cast htD
      have hbaseMono :
          (Q : ℝ) * (t : ℝ) / (S : ℝ) ≤
            (Q : ℝ) * (D : ℝ) / (S : ℝ) := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left htDreal (by positivity)) hSreal.le
      gcongr

/-! ### Generic matching incidences for the refined entropy correction -/

/-- Edges of a perfect matching other than the edge through `v` that meet
the two partner vertices of `A`.  For a valid matching, excluding edges
containing `v` is exactly Kahn's exclusion of the edge at `v`. -/
def matchingOtherMeetingEdges {n : ℕ} (F : Finset (Edge n))
    (v : Vertex n) (A : Edge n) : Finset (Edge n) :=
  F.filter fun B ↦ v ∉ B ∧ ¬Disjoint B (A.erase v)

/-- If each matching edge meets `A` in at most one vertex, the two partner
vertices of `A` lie in two distinct matching edges, both counted by
`matchingOtherMeetingEdges`. -/
lemma two_le_card_matchingOtherMeetingEdges_of_inter_le_one {n : ℕ}
    {H F : Finset (Edge n)} {A : Edge n} {v : Vertex n}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    (hAH : A ∈ H) (hvA : v ∈ A)
    (hinter : ∀ B ∈ F, (A ∩ B).card ≤ 1) :
    2 ≤ (matchingOtherMeetingEdges F v A).card := by
  have hAcard : A.card = 3 := mem_allEdges.mp (hH hAH)
  have hEraseCard : (A.erase v).card = 2 := by
    rw [Finset.card_erase_of_mem hvA, hAcard]
  obtain ⟨y, z, hyz, hErase⟩ := Finset.card_eq_two.mp hEraseCard
  have hyErase : y ∈ A.erase v := by rw [hErase]; simp
  have hzErase : z ∈ A.erase v := by rw [hErase]; simp
  have hyA : y ∈ A := Finset.mem_of_mem_erase hyErase
  have hzA : z ∈ A := Finset.mem_of_mem_erase hzErase
  have hyv : y ≠ v := (Finset.mem_erase.mp hyErase).1
  have hzv : z ≠ v := (Finset.mem_erase.mp hzErase).1
  obtain ⟨By, hBy, _hByUnique⟩ :=
    existsUnique_edge_mem_of_mem_perfectMatchings hH hF y
  obtain ⟨Bz, hBz, _hBzUnique⟩ :=
    existsUnique_edge_mem_of_mem_perfectMatchings hH hF z
  have hvBy : v ∉ By := by
    intro hv
    have hpair : ({v, y} : Finset (Vertex n)) ⊆ A ∩ By := by
      intro u hu
      simp only [Finset.mem_insert, Finset.mem_singleton] at hu
      rcases hu with rfl | rfl
      · exact Finset.mem_inter.mpr ⟨hvA, hv⟩
      · exact Finset.mem_inter.mpr ⟨hyA, hBy.2⟩
    have htwo : 2 ≤ (A ∩ By).card := by
      rw [← Finset.card_pair (Ne.symm hyv)]
      exact Finset.card_le_card hpair
    have hone := hinter By hBy.1
    omega
  have hvBz : v ∉ Bz := by
    intro hv
    have hpair : ({v, z} : Finset (Vertex n)) ⊆ A ∩ Bz := by
      intro u hu
      simp only [Finset.mem_insert, Finset.mem_singleton] at hu
      rcases hu with rfl | rfl
      · exact Finset.mem_inter.mpr ⟨hvA, hv⟩
      · exact Finset.mem_inter.mpr ⟨hzA, hBz.2⟩
    have htwo : 2 ≤ (A ∩ Bz).card := by
      rw [← Finset.card_pair (Ne.symm hzv)]
      exact Finset.card_le_card hpair
    have hone := hinter Bz hBz.1
    omega
  have hByBz : By ≠ Bz := by
    intro heq
    subst Bz
    have hpair : ({y, z} : Finset (Vertex n)) ⊆ A ∩ By := by
      intro u hu
      simp only [Finset.mem_insert, Finset.mem_singleton] at hu
      rcases hu with rfl | rfl
      · exact Finset.mem_inter.mpr ⟨hyA, hBy.2⟩
      · exact Finset.mem_inter.mpr ⟨hzA, hBz.2⟩
    have htwo : 2 ≤ (A ∩ By).card := by
      rw [← Finset.card_pair hyz]
      exact Finset.card_le_card hpair
    have hone := hinter By hBy.1
    omega
  have hByMeeting : By ∈ matchingOtherMeetingEdges F v A := by
    apply Finset.mem_filter.mpr
    refine ⟨hBy.1, hvBy, ?_⟩
    exact Finset.not_disjoint_iff.mpr ⟨y, hBy.2, hyErase⟩
  have hBzMeeting : Bz ∈ matchingOtherMeetingEdges F v A := by
    apply Finset.mem_filter.mpr
    refine ⟨hBz.1, hvBz, ?_⟩
    exact Finset.not_disjoint_iff.mpr ⟨z, hBz.2, hzErase⟩
  rw [← Finset.card_pair hByBz]
  exact Finset.card_le_card (by
    intro B hB
    simp only [Finset.mem_insert, Finset.mem_singleton] at hB
    rcases hB with rfl | rfl
    · exact hByMeeting
    · exact hBzMeeting)

/-- Kahn's non-genericity condition implies that `A` meets some matching
edge in at least two vertices. -/
lemma exists_matchingEdge_two_le_inter_of_genericFailure {n : ℕ}
    {H F : Finset (Edge n)} {A : Edge n} {v : Vertex n}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    (hAH : A ∈ H) (hvA : v ∈ A)
    (hfail : (matchingOtherMeetingEdges F v A).card < 2) :
    ∃ B ∈ F, 2 ≤ (A ∩ B).card := by
  by_contra hnone
  push_neg at hnone
  have htwo := two_le_card_matchingOtherMeetingEdges_of_inter_le_one
    hH hF hAH hvA (fun B hBF ↦ by
      have hnot := hnone B hBF
      omega)
  omega

/-- Probability, under a uniform perfect matching, that `(v,A)` is
non-generic in the sense used by Kahn's entropy--Brégman inequality. -/
def matchingGenericFailureFraction {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) (A : Edge n) : ℝ :=
  finsetProbability (perfectMatchings n H)
    (fun F ↦ (matchingOtherMeetingEdges F v A).card < 2)

lemma matchingGenericFailureFraction_nonneg {n : ℕ}
    (H : Finset (Edge n)) (v : Vertex n) (A : Edge n) :
    0 ≤ matchingGenericFailureFraction H v A := by
  exact finsetProbability_nonneg _ _

lemma matchingGenericFailureFraction_le_one {n : ℕ}
    (H : Finset (Edge n)) (v : Vertex n) (A : Edge n) :
    matchingGenericFailureFraction H v A ≤ 1 := by
  unfold matchingGenericFailureFraction finsetProbability
  by_cases hzero : (perfectMatchings n H).card = 0
  · rw [hzero]
    norm_num
  · apply (div_le_one (by
      exact_mod_cast Nat.pos_of_ne_zero hzero)).2
    exact_mod_cast Finset.card_filter_le _ _

/-- The finite set of non-generic incidences `(v,A)` for one perfect
matching. -/
def matchingGenericFailureIncidences {n : ℕ}
    (H F : Finset (Edge n)) :
    Finset (Sigma fun _v : Vertex n ↦ Edge n) :=
  (Finset.univ : Finset (Vertex n)).sigma fun v ↦
    H.filter fun A ↦ v ∈ A ∧
      (matchingOtherMeetingEdges F v A).card < 2

/-- A canonical raw witness `(B,u,w)` to an edge `B ∈ F` sharing two
distinct vertices with `A`; outside the witnessing case its value is an
irrelevant default. -/
noncomputable def genericIntersectionWitness {n : ℕ}
    (F : Finset (Edge n)) (A : Edge n) (v : Vertex n) :
    Edge n × Vertex n × Vertex n := by
  classical
  by_cases h : ∃ B ∈ F, ∃ u ∈ A ∩ B, ∃ w ∈ A ∩ B, u ≠ w
  · exact ⟨h.choose, h.choose_spec.2.choose,
      h.choose_spec.2.choose_spec.2.choose⟩
  · exact ⟨A, v, v⟩

lemma genericIntersectionWitness_spec {n : ℕ}
    {F : Finset (Edge n)} {A : Edge n} {v : Vertex n}
    (h : ∃ B ∈ F, ∃ u ∈ A ∩ B, ∃ w ∈ A ∩ B, u ≠ w) :
    let q := genericIntersectionWitness F A v
    q.1 ∈ F ∧ q.2.1 ∈ A ∩ q.1 ∧
      q.2.2 ∈ A ∩ q.1 ∧ q.2.1 ≠ q.2.2 := by
  classical
  simp only [genericIntersectionWitness, dif_pos h]
  exact ⟨h.choose_spec.1, h.choose_spec.2.choose_spec.1,
    h.choose_spec.2.choose_spec.2.choose_spec.1,
    h.choose_spec.2.choose_spec.2.choose_spec.2⟩

/-- The bounded target space for non-generic incidences: choose a matching
edge, an ordered pair of its distinct vertices, an ambient edge through
that pair, and finally a distinguished vertex of the ambient edge. -/
def matchingGenericFailureTargets {n : ℕ}
    (H F : Finset (Edge n)) :
    Finset (Sigma fun _B : Edge n ↦
      Sigma fun _u : Vertex n ↦
        Sigma fun _w : Vertex n ↦
          Sigma fun _A : Edge n ↦ Vertex n) :=
  F.sigma fun B ↦
    B.sigma fun u ↦
      (B.erase u).sigma fun w ↦
        (H.filter fun A ↦ u ∈ A ∧ w ∈ A).sigma fun A ↦ A

/-- Encode a non-generic incidence into the bounded witness space.  The
last two coordinates retain `(A,v)`, making the encoding injective. -/
noncomputable def encodeMatchingGenericFailure {n : ℕ}
    (F : Finset (Edge n))
    (p : Sigma fun _v : Vertex n ↦ Edge n) :
    Sigma fun _B : Edge n ↦
      Sigma fun _u : Vertex n ↦
        Sigma fun _w : Vertex n ↦
          Sigma fun _A : Edge n ↦ Vertex n :=
  let q := genericIntersectionWitness F p.2 p.1
  ⟨q.1, q.2.1, q.2.2, p.2, p.1⟩

lemma encodeMatchingGenericFailure_mapsTo {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) :
    Set.MapsTo (encodeMatchingGenericFailure F)
      (↑(matchingGenericFailureIncidences H F) :
        Set (Sigma fun _v : Vertex n ↦ Edge n))
      (↑(matchingGenericFailureTargets H F) :
        Set (Sigma fun _B : Edge n ↦
          Sigma fun _u : Vertex n ↦
            Sigma fun _w : Vertex n ↦
              Sigma fun _A : Edge n ↦ Vertex n)) := by
  rintro ⟨v, A⟩ hp
  change (⟨v, A⟩ : Sigma fun _v : Vertex n ↦ Edge n) ∈
    matchingGenericFailureIncidences H F at hp
  rw [matchingGenericFailureIncidences, Finset.mem_sigma] at hp
  rcases hp with ⟨_hv, hp⟩
  rcases Finset.mem_filter.mp hp with ⟨hAH, hvA, hfail⟩
  obtain ⟨B, hBF, htwo⟩ :=
    exists_matchingEdge_two_le_inter_of_genericFailure
      hH hF hAH hvA hfail
  have hinterNontrivial :
      ∃ B ∈ F, ∃ u ∈ A ∩ B, ∃ w ∈ A ∩ B, u ≠ w := by
    have htwo' : 2 ≤ (A ∩ B).card := by simpa using htwo
    have hone : 1 < (A ∩ B).card := by omega
    obtain ⟨u, hu, w, hw, huw⟩ := Finset.one_lt_card.mp hone
    exact ⟨B, hBF, u, hu, w, hw, huw⟩
  have hq := genericIntersectionWitness_spec
    (F := F) (A := A) (v := v) hinterNontrivial
  let q := genericIntersectionWitness F A v
  change (⟨q.1, q.2.1, q.2.2, A, v⟩ :
    Sigma fun _B : Edge n ↦
      Sigma fun _u : Vertex n ↦
        Sigma fun _w : Vertex n ↦
          Sigma fun _A : Edge n ↦ Vertex n) ∈
    matchingGenericFailureTargets H F
  simp only [matchingGenericFailureTargets, Finset.mem_sigma]
  refine ⟨hq.1, ?_⟩
  refine ⟨(Finset.mem_inter.mp hq.2.1).2, ?_⟩
  refine ⟨Finset.mem_erase.mpr
    ⟨Ne.symm hq.2.2.2, (Finset.mem_inter.mp hq.2.2.1).2⟩, ?_⟩
  refine ⟨Finset.mem_filter.mpr
    ⟨hAH, (Finset.mem_inter.mp hq.2.1).1,
      (Finset.mem_inter.mp hq.2.2.1).1⟩, hvA⟩

lemma encodeMatchingGenericFailure_injectiveOn {n : ℕ}
    {H F : Finset (Edge n)} :
    Set.InjOn (encodeMatchingGenericFailure F)
      (↑(matchingGenericFailureIncidences H F) :
        Set (Sigma fun _v : Vertex n ↦ Edge n)) := by
  rintro ⟨v, A⟩ hvA ⟨w, C⟩ hwC heq
  have hA : A = C := congrArg (fun q ↦ q.2.2.2.1) heq
  have hvw : v = w := congrArg (fun q ↦ q.2.2.2.2) heq
  subst C
  subst w
  rfl

lemma card_matchingGenericFailureIncidences_le_targets {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) :
    (matchingGenericFailureIncidences H F).card ≤
      (matchingGenericFailureTargets H F).card :=
  Finset.card_le_card_of_injOn (encodeMatchingGenericFailure F)
    (encodeMatchingGenericFailure_mapsTo hH hF)
    encodeMatchingGenericFailure_injectiveOn

/-- The witness space has size at most `18 n κ`: `n` matching edges,
three choices for the first vertex, two for the second, at most `κ`
ambient edges through the ordered pair, and three distinguished vertices.
The harmless factor two from ordering the pair keeps the encoding simple. -/
lemma card_matchingGenericFailureTargets_le {n codegCap : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap) :
    (matchingGenericFailureTargets H F).card ≤ 18 * n * codegCap := by
  have hFH : F ⊆ H := (mem_perfectMatchings.mp hF).1
  have hFcard : F.card = n := (mem_perfectMatchings.mp hF).2.1
  rw [matchingGenericFailureTargets, Finset.card_sigma]
  calc
    (∑ B ∈ F,
        (B.sigma fun u ↦
          (B.erase u).sigma fun w ↦
            (H.filter fun A ↦ u ∈ A ∧ w ∈ A).sigma fun A ↦ A).card) ≤
        ∑ _B ∈ F, 18 * codegCap := by
      apply Finset.sum_le_sum
      intro B hBF
      have hBcard : B.card = 3 := mem_allEdges.mp (hH (hFH hBF))
      rw [Finset.card_sigma]
      calc
        (∑ u ∈ B,
            ((B.erase u).sigma fun w ↦
              (H.filter fun A ↦ u ∈ A ∧ w ∈ A).sigma fun A ↦ A).card) ≤
            ∑ _u ∈ B, 6 * codegCap := by
          apply Finset.sum_le_sum
          intro u huB
          rw [Finset.card_sigma]
          calc
            (∑ w ∈ B.erase u,
                ((H.filter fun A ↦ u ∈ A ∧ w ∈ A).sigma fun A ↦ A).card) ≤
                ∑ _w ∈ B.erase u, 3 * codegCap := by
              apply Finset.sum_le_sum
              intro w hw
              rw [Finset.card_sigma]
              calc
                (∑ A ∈ H.filter (fun A ↦ u ∈ A ∧ w ∈ A), A.card) =
                    ∑ _A ∈ H.filter (fun A ↦ u ∈ A ∧ w ∈ A), 3 := by
                  apply Finset.sum_congr rfl
                  intro A hA
                  exact mem_allEdges.mp (hH (Finset.mem_filter.mp hA).1)
                _ = 3 * (H.filter fun A ↦ u ∈ A ∧ w ∈ A).card := by
                  simp [Nat.mul_comm]
                _ ≤ 3 * codegCap := by
                  apply Nat.mul_le_mul_left
                  exact hcodeg u w (Ne.symm (Finset.mem_erase.mp hw).1)
            _ = 6 * codegCap := by
              simp [Finset.card_erase_of_mem huB, hBcard]
              ring
        _ = 18 * codegCap := by
          simp [hBcard]
          ring
    _ = 18 * n * codegCap := by
      simp [hFcard]
      ring

lemma card_matchingGenericFailureIncidences_le {n codegCap : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap) :
    (matchingGenericFailureIncidences H F).card ≤
      18 * n * codegCap :=
  (card_matchingGenericFailureIncidences_le_targets hH hF).trans
    (card_matchingGenericFailureTargets_le hH hF hcodeg)

/-- All vertex/incident-edge indices carrying the local matching
distributions. -/
def matchingIncidentPairs {n : ℕ} (H : Finset (Edge n)) :
    Finset (Sigma fun _v : Vertex n ↦ Edge n) :=
  (Finset.univ : Finset (Vertex n)).sigma fun v ↦
    H.filter fun A ↦ v ∈ A

lemma matchingIncidentPairs_filter_genericFailure {n : ℕ}
    (H F : Finset (Edge n)) :
    (matchingIncidentPairs H).filter (fun p ↦
        (matchingOtherMeetingEdges F p.1 p.2).card < 2) =
      matchingGenericFailureIncidences H F := by
  ext p
  rcases p with ⟨v, A⟩
  simp [matchingIncidentPairs, matchingGenericFailureIncidences,
    and_assoc]

/-- Exchange the uniform-perfect-matching average with the sum over local
incidences. -/
lemma sum_matchingGenericFailureFraction_eq_average {n : ℕ}
    (H : Finset (Edge n)) :
    (∑ p ∈ matchingIncidentPairs H,
        matchingGenericFailureFraction H p.1 p.2) =
      finsetAverage (perfectMatchings n H) (fun F ↦
        ((matchingGenericFailureIncidences H F).card : ℝ)) := by
  let I := matchingIncidentPairs H
  let P : (Sigma fun _v : Vertex n ↦ Edge n) →
      Finset (Edge n) → Prop := fun p F ↦
    (matchingOtherMeetingEdges F p.1 p.2).card < 2
  have hswap := finsetAverage_card_filter_eq_sum_probability
    (perfectMatchings n H) I P
  calc
    (∑ p ∈ matchingIncidentPairs H,
        matchingGenericFailureFraction H p.1 p.2) =
        ∑ p ∈ I,
          @finsetProbability (Finset (Edge n)) (perfectMatchings n H)
            (P p) (Classical.decPred _) := by
      apply Finset.sum_congr (by simp only [I])
      intro p hp
      unfold matchingGenericFailureFraction
      unfold finsetProbability
      apply congrArg (fun k : ℕ ↦ (k : ℝ) /
        ((perfectMatchings n H).card : ℝ))
      apply congrArg Finset.card
      exact @Finset.filter_congr_decidable _ (perfectMatchings n H)
        (fun F ↦ (matchingOtherMeetingEdges F p.1 p.2).card < 2)
        (fun F ↦ (matchingOtherMeetingEdges F p.1 p.2).card.decLt 2)
        (Classical.decPred _)
    _ = finsetAverage (perfectMatchings n H) (fun F ↦
          ((@Finset.filter _ (fun p ↦ P p F) (Classical.decPred _) I).card :
            ℝ)) := hswap.symm
    _ = finsetAverage (perfectMatchings n H) (fun F ↦
          ((matchingGenericFailureIncidences H F).card : ℝ)) := by
      unfold finsetAverage
      congr 1
      apply Finset.sum_congr rfl
      intro F hF
      change (((@Finset.filter _ (fun p ↦ P p F) (Classical.decPred _) I).card :
        ℕ) : ℝ) = ((matchingGenericFailureIncidences H F).card : ℝ)
      exact_mod_cast congrArg Finset.card (show
        @Finset.filter _ (fun p ↦ P p F) (Classical.decPred _) I =
          matchingGenericFailureIncidences H F from
        (Finset.filter_congr_decidable I _ _).trans (by
          simpa only [I, P] using
            matchingIncidentPairs_filter_genericFailure H F))

/-- The sum of Kahn's genericity probabilities is controlled by the
maximum codegree.  This is the finite `r=3` form of the estimate used to
make the entropy error negligible. -/
lemma sum_matchingGenericFailureFraction_le {n codegCap : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap) :
    (∑ p ∈ matchingIncidentPairs H,
        matchingGenericFailureFraction H p.1 p.2) ≤
      18 * n * codegCap := by
  rw [sum_matchingGenericFailureFraction_eq_average]
  unfold finsetAverage
  have hcardNat : 0 < (perfectMatchings n H).card := Nat.pos_of_ne_zero hΦ
  have hcard : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast hcardNat
  apply (div_le_iff₀ hcard).2
  calc
    (∑ F ∈ perfectMatchings n H,
        ((matchingGenericFailureIncidences H F).card : ℝ)) ≤
        ∑ _F ∈ perfectMatchings n H, ((18 * n * codegCap : ℕ) : ℝ) := by
      apply Finset.sum_le_sum
      intro F hF
      exact_mod_cast card_matchingGenericFailureIncidences_le hH hF hcodeg
    _ = (18 : ℝ) * (n : ℝ) * (codegCap : ℝ) *
        ((perfectMatchings n H).card : ℝ) := by
      simp
      ring

lemma card_matchingIncidentPairs {n : ℕ} (H : Finset (Edge n))
    (hH : H ⊆ allEdges n) :
    (matchingIncidentPairs H).card = 3 * H.card := by
  rw [matchingIncidentPairs, Finset.card_sigma]
  calc
    (∑ v : Vertex n, (H.filter fun A ↦ v ∈ A).card) =
        ∑ v : Vertex n, vertexDegree H v := by rfl
    _ = 3 * H.card := sum_vertexDegree H hH

/-- The local matching fractions, indexed by all vertex/edge incidences,
have total mass equal to the number `3n` of vertices. -/
lemma sum_matchingFraction_matchingIncidentPairs {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    (∑ p ∈ matchingIncidentPairs H, matchingFraction H p.2) =
      (3 * n : ℝ) := by
  rw [matchingIncidentPairs, Finset.sum_sigma]
  calc
    (∑ v : Vertex n,
        ∑ A ∈ H.filter (fun A ↦ v ∈ A), matchingFraction H A) =
        ∑ _v : Vertex n, (1 : ℝ) := by
      apply Finset.sum_congr rfl
      intro v hv
      exact sum_incident_matchingFraction n H hH v hΦ
    _ = (3 * n : ℝ) := by simp

/-- The entropy of the incidence-indexed mass vector is exactly the sum of
the local matching entropies. -/
lemma sum_matchingEntropy_matchingIncidentPairs {n : ℕ}
    (H : Finset (Edge n)) :
    (∑ p ∈ matchingIncidentPairs H,
        -(matchingFraction H p.2) * Real.log (matchingFraction H p.2)) =
      ∑ v : Vertex n, localMatchingEntropy H v := by
  rw [matchingIncidentPairs, Finset.sum_sigma]
  rfl

/-- The error term in the `r=3` entropy--Brégman inequality. -/
def matchingEntropyGenericityError {n : ℕ}
    (H : Finset (Edge n)) : ℝ :=
  ∑ p ∈ matchingIncidentPairs H,
    matchingFraction H p.2 *
      Real.sqrt (matchingGenericFailureFraction H p.1 p.2)

lemma matchingEntropyGenericityError_nonneg {n : ℕ}
    (H : Finset (Edge n)) :
    0 ≤ matchingEntropyGenericityError H := by
  unfold matchingEntropyGenericityError
  apply Finset.sum_nonneg
  intro p hp
  exact mul_nonneg (matchingFraction_nonneg H p.2) (Real.sqrt_nonneg _)

/-- The fourth-root variant used by the elementary scalar estimate below.
Any positive power tending to zero is sufficient in Kahn's `E1` step. -/
def matchingEntropyGenericityFourthError {n : ℕ}
    (H : Finset (Edge n)) : ℝ :=
  ∑ p ∈ matchingIncidentPairs H,
    matchingFraction H p.2 *
      Real.sqrt (Real.sqrt (matchingGenericFailureFraction H p.1 p.2))

lemma matchingEntropyGenericityFourthError_nonneg {n : ℕ}
    (H : Finset (Edge n)) :
    0 ≤ matchingEntropyGenericityFourthError H := by
  unfold matchingEntropyGenericityFourthError
  apply Finset.sum_nonneg
  intro p hp
  exact mul_nonneg (matchingFraction_nonneg H p.2) (Real.sqrt_nonneg _)

/-- Entropy upper bound for a nonnegative finite mass vector of total
mass `a`.  This scaled form of the probability-vector bound is the
log-sum inequality used in Kahn's genericity lemma. -/
lemma finiteEntropy_le_mass_mul_log_card_div {α : Type*}
    (s : Finset α) (p : α → ℝ) (a : ℝ)
    (ha : 0 < a) (hp : ∀ x ∈ s, 0 ≤ p x)
    (hsum : ∑ x ∈ s, p x = a) :
    finiteEntropy s p ≤ a * Real.log ((s.card : ℝ) / a) := by
  let q : α → ℝ := fun x ↦ p x / a
  have hs : s.Nonempty := by
    by_contra hempty
    rw [Finset.not_nonempty_iff_eq_empty.mp hempty] at hsum
    simp at hsum
    linarith
  have hq0 : ∀ x ∈ s, 0 ≤ q x := by
    intro x hx
    exact div_nonneg (hp x hx) ha.le
  have hqsum : ∑ x ∈ s, q x = 1 := by
    dsimp [q]
    rw [← Finset.sum_div, hsum, div_self ha.ne']
  have hqEntropy := finiteEntropy_le_log_card s q hs hq0 hqsum
  have hscale : finiteEntropy s p =
      a * finiteEntropy s q - a * Real.log a := by
    unfold finiteEntropy
    have hpoint : ∀ x ∈ s,
        -(p x) * Real.log (p x) =
          a * (-(q x) * Real.log (q x)) - p x * Real.log a := by
      intro x hx
      by_cases hpx : p x = 0
      · simp [hpx, q]
      · have hpxpos : 0 < p x := lt_of_le_of_ne (hp x hx) (Ne.symm hpx)
        rw [show q x = p x / a by rfl,
          Real.log_div hpx ha.ne']
        field_simp [ha.ne']
        ring
    rw [Finset.sum_congr rfl hpoint, Finset.sum_sub_distrib,
      ← Finset.mul_sum, ← Finset.sum_mul, hsum]
  rw [hscale]
  have hcard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  rw [Real.log_div hcard.ne' ha.ne']
  nlinarith [mul_le_mul_of_nonneg_left hqEntropy ha.le]

lemma finiteEntropy_filter_add_filter_not {α : Type*}
    (s : Finset α) (p : α → ℝ) (R : α → Prop) :
    finiteEntropy (s.filter R) p + finiteEntropy (s.filter fun x ↦ ¬R x) p =
      finiteEntropy s p := by
  unfold finiteEntropy
  exact Finset.sum_filter_add_sum_filter_not s R
    (fun x ↦ -(p x) * Real.log (p x))

/-- Finite weighted log-sum inequality.  The support hypothesis is the
only positivity condition needed with Mathlib's totalized logarithm: every
positive `a`-mass must also have positive `b`-mass.  This is the exact
finite Jensen step used in Kahn's equation (33). -/
lemma weightedLogSum_le {α : Type*} (s : Finset α)
    (a b : α → ℝ) (A B : ℝ)
    (hA : 0 < A) (hB : 0 < B)
    (ha : ∀ x ∈ s, 0 ≤ a x)
    (hb : ∀ x ∈ s, 0 ≤ b x)
    (hsupport : ∀ x ∈ s, 0 < a x → 0 < b x)
    (hsumA : ∑ x ∈ s, a x = A)
    (hsumB : ∑ x ∈ s, b x = B) :
    (∑ x ∈ s, a x * Real.log (b x / a x)) ≤
      A * Real.log (B / A) := by
  have hBA : 0 < B / A := div_pos hB hA
  have hpoint : ∀ x ∈ s,
      a x * Real.log (b x / a x) ≤
        a x * (((b x * A) / (a x * B)) - 1) +
          a x * Real.log (B / A) := by
    intro x hx
    by_cases hax : a x = 0
    · simp [hax]
    · have hapos : 0 < a x := lt_of_le_of_ne (ha x hx) (Ne.symm hax)
      have hbpos : 0 < b x := hsupport x hx hapos
      have hratio : 0 < (b x * A) / (a x * B) := by positivity
      have hlog := Real.log_le_sub_one_of_pos hratio
      have hid : b x / a x =
          ((b x * A) / (a x * B)) * (B / A) := by
        field_simp [hapos.ne', hbpos.ne', hA.ne', hB.ne']
      rw [hid, Real.log_mul hratio.ne' hBA.ne']
      calc
        a x * (Real.log ((b x * A) / (a x * B)) + Real.log (B / A)) =
            a x * Real.log ((b x * A) / (a x * B)) +
              a x * Real.log (B / A) := by ring
        _ ≤ a x * (((b x * A) / (a x * B)) - 1) +
              a x * Real.log (B / A) :=
          by
            have hm := mul_le_mul_of_nonneg_left hlog hapos.le
            linarith
  calc
    (∑ x ∈ s, a x * Real.log (b x / a x)) ≤
        ∑ x ∈ s,
          (a x * (((b x * A) / (a x * B)) - 1) +
            a x * Real.log (B / A)) :=
      Finset.sum_le_sum hpoint
    _ ≤ A * Real.log (B / A) := by
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, hsumA]
      have hfirst :
          ∑ x ∈ s, a x * (((b x * A) / (a x * B)) - 1) ≤ 0 := by
        let t := s.filter fun x ↦ 0 < a x
        have hterm : ∀ x ∈ t,
            a x * (((b x * A) / (a x * B)) - 1) =
              (A / B) * b x - a x := by
          intro x hx
          have hapos : 0 < a x := (Finset.mem_filter.mp hx).2
          field_simp [hapos.ne', hB.ne']
        -- Split off zero `a` coordinates: their first-sum contribution is
        -- zero, while allowing extra `b` mass can only improve the desired
        -- inequality.  We use a filtered support to keep the algebra exact.
        have htA : ∑ x ∈ t, a x = A := by
          rw [← hsumA]
          apply Finset.sum_subset (Finset.filter_subset _ _)
          intro x hxs hxt
          have hnot : ¬0 < a x := by
            simpa only [t, Finset.mem_filter, hxs, true_and] using hxt
          exact le_antisymm (le_of_not_gt hnot) (ha x hxs)
        have htB : ∑ x ∈ t, b x ≤ B := by
          rw [← hsumB]
          exact Finset.sum_le_sum_of_subset_of_nonneg
            (Finset.filter_subset _ _) (fun x hxS hxT ↦ hb x hxS)
        have hrewrite :
            ∑ x ∈ s, a x * (((b x * A) / (a x * B)) - 1) =
              (A / B) * (∑ x ∈ t, b x) - A := by
          calc
            (∑ x ∈ s, a x * (((b x * A) / (a x * B)) - 1)) =
                ∑ x ∈ t, a x * (((b x * A) / (a x * B)) - 1) := by
              symm
              apply Finset.sum_subset (Finset.filter_subset _ _)
              intro x hxs hxt
              have hnot : ¬0 < a x := by
                simpa only [t, Finset.mem_filter, hxs, true_and] using hxt
              have hzero : a x = 0 :=
                le_antisymm (le_of_not_gt hnot) (ha x hxs)
              simp [hzero]
            _ = ∑ x ∈ t, ((A / B) * b x - a x) := by
              apply Finset.sum_congr rfl
              intro x hxt
              exact hterm x hxt
            _ = (A / B) * (∑ x ∈ t, b x) - A := by
              rw [Finset.sum_sub_distrib, ← Finset.mul_sum, htA]
        rw [hrewrite]
        have hAB : 0 ≤ A / B := (div_pos hA hB).le
        have := mul_le_mul_of_nonneg_left htB hAB
        calc
          (A / B) * (∑ x ∈ t, b x) - A ≤ (A / B) * B - A := by
            linarith
          _ = 0 := by rw [div_mul_cancel₀ _ hB.ne', sub_self]
      linarith

lemma finiteEntropy_eq_zero_of_sum_eq_zero {α : Type*}
    (s : Finset α) (p : α → ℝ)
    (hp : ∀ x ∈ s, 0 ≤ p x) (hsum : ∑ x ∈ s, p x = 0) :
    finiteEntropy s p = 0 := by
  have hpzero : ∀ x ∈ s, p x = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg hp).mp hsum
  unfold finiteEntropy
  apply Finset.sum_eq_zero
  intro x hx
  rw [hpzero x hx]
  simp

/-- A mass supported on a filtered subfamily can be bounded using the
cardinality of the ambient family. -/
lemma finiteEntropy_filter_le_mass_mul_log_card_div {α : Type*}
    (s : Finset α) (p : α → ℝ) (R : α → Prop) (a : ℝ)
    (ha : 0 < a) (hp : ∀ x ∈ s, 0 ≤ p x)
    (hsum : ∑ x ∈ s.filter R, p x = a) :
    finiteEntropy (s.filter R) p ≤
      a * Real.log ((s.card : ℝ) / a) := by
  let t := s.filter R
  have ht := finiteEntropy_le_mass_mul_log_card_div t p a ha
    (fun x hx ↦ hp x (Finset.mem_filter.mp hx).1) hsum
  have htNonempty : t.Nonempty := by
    by_contra hempty
    have hsum' : ∑ x ∈ t, p x = a := by simpa only [t] using hsum
    rw [Finset.not_nonempty_iff_eq_empty.mp hempty] at hsum'
    simp at hsum'
    linarith
  have hsNonempty : s.Nonempty := htNonempty.mono (Finset.filter_subset _ _)
  have htcard : (0 : ℝ) < t.card := by
    exact_mod_cast Finset.card_pos.mpr htNonempty
  have hscard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hsNonempty
  have hcardle : (t.card : ℝ) ≤ s.card := by
    exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)
  have hdiv : (t.card : ℝ) / a ≤ (s.card : ℝ) / a := by
    exact div_le_div_of_nonneg_right hcardle ha.le
  have hlog : Real.log ((t.card : ℝ) / a) ≤
      Real.log ((s.card : ℝ) / a) := by
    exact Real.strictMonoOn_log.monotoneOn
      (div_pos htcard ha) (div_pos hscard ha) hdiv
  exact ht.trans (mul_le_mul_of_nonneg_left hlog ha.le)

/-- The entropy of a two-part mass split is at most `N log 2`. -/
lemma binary_mass_entropy_le (N a : ℝ) (hN : 0 < N)
    (ha0 : 0 ≤ a) (haN : a ≤ N) :
    -(a) * Real.log (a / N) -
        (N - a) * Real.log ((N - a) / N) ≤
      N * Real.log 2 := by
  let q : Bool → ℝ := fun b ↦ if b then a / N else (N - a) / N
  have hq0 : ∀ b ∈ (Finset.univ : Finset Bool), 0 ≤ q b := by
    intro b hb
    cases b <;> simp [q] <;> positivity
  have hqsum : ∑ b ∈ (Finset.univ : Finset Bool), q b = 1 := by
    simp [q]
    field_simp [hN.ne']
    ring
  have hent := finiteEntropy_le_log_card
    (Finset.univ : Finset Bool) q (by simp) hq0 hqsum
  have hscale : N * finiteEntropy (Finset.univ : Finset Bool) q =
      -(a) * Real.log (a / N) -
        (N - a) * Real.log ((N - a) / N) := by
    simp [finiteEntropy, q]
    field_simp [hN.ne']
    ring
  rw [← hscale]
  simpa using mul_le_mul_of_nonneg_left hent hN.le

/-- Quantitative two-block log-sum bound.  If a subfamily of cardinality
`T` carries mass `a` out of total mass `N` on `l` indices, the entropy
loses `a log(l/T)`, up to the binary split cost `N log 2`. -/
lemma finiteEntropy_le_total_log_card_sub_mass_log_ratio {α : Type*}
    (s : Finset α) (p : α → ℝ) (R : α → Prop) (N a : ℝ)
    (hN : 0 < N) (ha : 0 < a)
    (hp : ∀ x ∈ s, 0 ≤ p x)
    (htotal : ∑ x ∈ s, p x = N)
    (hmass : ∑ x ∈ s.filter R, p x = a) :
    finiteEntropy s p ≤
      N * Real.log ((s.card : ℝ) / N) + N * Real.log 2 -
        a * Real.log ((s.card : ℝ) / ((s.filter R).card : ℝ)) := by
  let t := s.filter R
  let u := s.filter fun x ↦ ¬R x
  let b := N - a
  have hsumSplit :
      (∑ x ∈ t, p x) + ∑ x ∈ u, p x = ∑ x ∈ s, p x := by
    simpa only [t, u] using
      (Finset.sum_filter_add_sum_filter_not s R p)
  have hmassT : ∑ x ∈ t, p x = a := by simpa only [t] using hmass
  have hmassU : ∑ x ∈ u, p x = b := by
    dsimp [b]
    rw [hmassT, htotal] at hsumSplit
    linarith
  have hb0 : 0 ≤ b := by
    have hu0 : 0 ≤ ∑ x ∈ u, p x := by
      apply Finset.sum_nonneg
      intro x hx
      exact hp x ((Finset.mem_filter.mp hx).1)
    rw [hmassU] at hu0
    exact hu0
  have haN : a ≤ N := by dsimp [b] at hb0; linarith
  have htNonempty : t.Nonempty := by
    by_contra hempty
    rw [Finset.not_nonempty_iff_eq_empty.mp hempty] at hmassT
    simp at hmassT
    linarith
  have hsNonempty : s.Nonempty := htNonempty.mono (Finset.filter_subset _ _)
  have hT : (0 : ℝ) < t.card := by
    exact_mod_cast Finset.card_pos.mpr htNonempty
  have hl : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hsNonempty
  have hhigh := finiteEntropy_le_mass_mul_log_card_div
    t p a ha (fun x hx ↦ hp x (Finset.mem_filter.mp hx).1) hmassT
  have hEntropySplit := finiteEntropy_filter_add_filter_not s p R
  change finiteEntropy t p + finiteEntropy u p = finiteEntropy s p at hEntropySplit
  have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  by_cases hb : b = 0
  · have hlowZero : finiteEntropy u p = 0 :=
      finiteEntropy_eq_zero_of_sum_eq_zero u p
        (fun x hx ↦ hp x (Finset.mem_filter.mp hx).1) (by simpa [hb] using hmassU)
    have haeq : a = N := by dsimp [b] at hb; linarith
    have hid :
        a * Real.log ((t.card : ℝ) / a) =
          N * Real.log ((s.card : ℝ) / N) -
            a * Real.log ((s.card : ℝ) / (t.card : ℝ)) := by
      rw [Real.log_div hT.ne' ha.ne', Real.log_div hl.ne' hN.ne',
        Real.log_div hl.ne' hT.ne']
      rw [haeq]
      ring
    rw [← hEntropySplit, hlowZero, add_zero]
    calc
      finiteEntropy t p ≤ a * Real.log ((t.card : ℝ) / a) := hhigh
      _ = N * Real.log ((s.card : ℝ) / N) -
          a * Real.log ((s.card : ℝ) / (t.card : ℝ)) := hid
      _ ≤ N * Real.log ((s.card : ℝ) / N) + N * Real.log 2 -
          a * Real.log ((s.card : ℝ) /
            ((s.filter R).card : ℝ)) := by
        dsimp only [t]
        nlinarith [mul_nonneg hN.le hlog2]
  · have hbpos : 0 < b := lt_of_le_of_ne hb0 (Ne.symm hb)
    have hlowRaw := finiteEntropy_le_mass_mul_log_card_div
      u p b hbpos (fun x hx ↦ hp x (Finset.mem_filter.mp hx).1) hmassU
    have huNonempty : u.Nonempty := by
      by_contra hempty
      rw [Finset.not_nonempty_iff_eq_empty.mp hempty] at hmassU
      simp at hmassU
      linarith
    have huCard : (0 : ℝ) < u.card := by
      exact_mod_cast Finset.card_pos.mpr huNonempty
    have huCardLe : (u.card : ℝ) ≤ s.card := by
      exact_mod_cast Finset.card_le_card (by
        dsimp only [u]
        exact Finset.filter_subset _ _)
    have hlow : finiteEntropy u p ≤ b * Real.log ((s.card : ℝ) / b) := by
      apply hlowRaw.trans
      apply mul_le_mul_of_nonneg_left _ hbpos.le
      apply Real.strictMonoOn_log.monotoneOn
      · exact div_pos huCard hbpos
      · exact div_pos hl hbpos
      · exact div_le_div_of_nonneg_right huCardLe hbpos.le
    have hbinary := binary_mass_entropy_le N a hN ha.le haN
    have hid :
        a * Real.log ((t.card : ℝ) / a) +
            b * Real.log ((s.card : ℝ) / b) =
          N * Real.log ((s.card : ℝ) / N) +
            (-(a) * Real.log (a / N) -
              b * Real.log (b / N)) -
            a * Real.log ((s.card : ℝ) / (t.card : ℝ)) := by
      rw [Real.log_div hT.ne' ha.ne', Real.log_div hl.ne' hbpos.ne',
        Real.log_div hl.ne' hN.ne', Real.log_div ha.ne' hN.ne',
        Real.log_div hbpos.ne' hN.ne', Real.log_div hl.ne' hT.ne']
      dsimp [b]
      ring
    rw [← hEntropySplit]
    calc
      finiteEntropy t p + finiteEntropy u p ≤
          a * Real.log ((t.card : ℝ) / a) +
            b * Real.log ((s.card : ℝ) / b) := add_le_add hhigh hlow
      _ = N * Real.log ((s.card : ℝ) / N) +
            (-(a) * Real.log (a / N) - b * Real.log (b / N)) -
            a * Real.log ((s.card : ℝ) / (t.card : ℝ)) := hid
      _ ≤ N * Real.log ((s.card : ℝ) / N) + N * Real.log 2 -
            a * Real.log ((s.card : ℝ) / (t.card : ℝ)) := by
        have hbinary' :
            -(a) * Real.log (a / N) - b * Real.log (b / N) ≤
              N * Real.log 2 := by
          simpa only [b] using hbinary
        linarith

/-! ### A finite entropy chain-rule primitive -/

/-- The fiber of a finite map above `b`. -/
def finiteMapFiber {α β : Type*} (s : Finset α) (f : α → β)
    (b : β) : Finset α :=
  s.filter fun x ↦ f x = b

/-- Fiber cardinalities over any finite target containing the image sum to
the cardinality of the domain. -/
lemma sum_card_finiteMapFiber_eq_card {α β : Type*}
    (s : Finset α) (t : Finset β) (f : α → β)
    (hmap : ∀ x ∈ s, f x ∈ t) :
    ∑ b ∈ t, (finiteMapFiber s f b).card = s.card := by
  classical
  calc
    (∑ b ∈ t, (finiteMapFiber s f b).card) =
        ∑ b ∈ t, ∑ x ∈ s, if f x = b then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro b hb
      simp [finiteMapFiber, eq_comm, Finset.sum_boole]
    _ = ∑ x ∈ s, ∑ b ∈ t, if f x = b then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ _x ∈ s, 1 := by
      apply Finset.sum_congr rfl
      intro x hx
      simp [hmap x hx]
    _ = s.card := by simp

lemma sum_card_finiteMapFiber_image {α β : Type*}
    (s : Finset α) (f : α → β) :
    ∑ b ∈ s.image f, (finiteMapFiber s f b).card = s.card := by
  exact sum_card_finiteMapFiber_eq_card s (s.image f) f
    (fun x hx ↦ Finset.mem_image.mpr ⟨x, hx, rfl⟩)

lemma sum_castCard_finiteMapFiber_eq_card {α β : Type*}
    (s : Finset α) (t : Finset β) (f : α → β)
    (hmap : ∀ x ∈ s, f x ∈ t) :
    ∑ b ∈ t, ((finiteMapFiber s f b).card : ℝ) = (s.card : ℝ) := by
  exact_mod_cast sum_card_finiteMapFiber_eq_card s t f hmap

/-- Regroup a sum by the fibers of a finite map. -/
lemma sum_eq_sum_card_fiber_mul {α β : Type*}
    (s : Finset α) (f : α → β) (G : β → ℝ) :
    (∑ x ∈ s, G (f x)) =
      ∑ b ∈ s.image f,
        ((finiteMapFiber s f b).card : ℝ) * G b := by
  classical
  symm
  simpa [finiteMapFiber, nsmul_eq_mul, mul_comm] using
    (Finset.sum_image'
      (s := s) (g := f)
      (f := fun b ↦ ((finiteMapFiber s f b).card : ℝ) * G b)
      (h := fun x ↦ G (f x))
      (fun x hx ↦ by
        have hconst :
            (∑ y ∈ s.filter (fun y ↦ f y = f x), G (f y)) =
              ∑ _y ∈ s.filter (fun y ↦ f y = f x), G (f x) := by
          apply Finset.sum_congr rfl
          intro y hy
          rw [(Finset.mem_filter.mp hy).2]
        rw [hconst]
        simp [finiteMapFiber, nsmul_eq_mul, mul_comm]))

lemma finiteMapFiber_pair_eq_nested {α β γ : Type*}
    (s : Finset α) (X : α → β) (Z : α → γ) (x : β) (z : γ) :
    finiteMapFiber s (fun ω ↦ (X ω, Z ω)) (x, z) =
      finiteMapFiber (finiteMapFiber s X x) Z z := by
  ext ω
  simp [finiteMapFiber, and_assoc]

/-- Two-dimensional fiber regrouping over the product of the two occupied
marginal images.  Empty joint fibers contribute zero. -/
lemma sum_pairFiber_mul_eq_sum {α β γ : Type*}
    (s : Finset α) (X : α → β) (Z : α → γ) (G : β → γ → ℝ) :
    (∑ x ∈ s.image X, ∑ z ∈ s.image Z,
        ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) (x, z)).card : ℝ) *
          G x z) =
      ∑ ω ∈ s, G (X ω) (Z ω) := by
  classical
  let J : α → β × γ := fun ω ↦ (X ω, Z ω)
  let P : Finset (β × γ) := (s.image X).product (s.image Z)
  have hsub : s.image J ⊆ P := by
    intro q hq
    rcases Finset.mem_image.mp hq with ⟨ω, hω, rfl⟩
    exact Finset.mem_product.mpr
      ⟨Finset.mem_image.mpr ⟨ω, hω, rfl⟩,
        Finset.mem_image.mpr ⟨ω, hω, rfl⟩⟩
  have hzero : ∀ q ∈ P, q ∉ s.image J →
      ((finiteMapFiber s J q).card : ℝ) * G q.1 q.2 = 0 := by
    intro q hq hnot
    have hempty : finiteMapFiber s J q = ∅ := by
      ext ω
      simp only [Finset.notMem_empty, iff_false]
      intro hω
      apply hnot
      have hdata : ω ∈ s ∧ J ω = q := by
        simpa only [finiteMapFiber, Finset.mem_filter] using hω
      exact Finset.mem_image.mpr ⟨ω, hdata.1, hdata.2⟩
    simp [hempty]
  calc
    (∑ x ∈ s.image X, ∑ z ∈ s.image Z,
        ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) (x, z)).card : ℝ) *
          G x z) =
        ∑ q ∈ P, ((finiteMapFiber s J q).card : ℝ) * G q.1 q.2 := by
      calc
        (∑ x ∈ s.image X, ∑ z ∈ s.image Z,
            ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) (x, z)).card : ℝ) *
              G x z) =
            ∑ q ∈ (s.image X).product (s.image Z),
              ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) q).card : ℝ) *
                G q.1 q.2 := by
          exact (Finset.sum_product (s.image X) (s.image Z)
            (fun q ↦
              ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) q).card : ℝ) *
                G q.1 q.2)).symm
        _ = ∑ q ∈ P,
              ((finiteMapFiber s J q).card : ℝ) * G q.1 q.2 := by
          apply Finset.sum_congr
          · rfl
          · rintro ⟨x, z⟩ hq
            simp only [J]
    _ = ∑ q ∈ s.image J,
          ((finiteMapFiber s J q).card : ℝ) * G q.1 q.2 := by
      symm
      exact Finset.sum_subset hsub hzero
    _ = ∑ ω ∈ s, G (X ω) (Z ω) := by
      let I : Finset (β × γ) :=
        @Finset.image α (β × γ) (Classical.decEq _) J s
      have hregroup :=
        (sum_eq_sum_card_fiber_mul s J (fun q ↦ G q.1 q.2)).symm
      calc
        (∑ q ∈ s.image J,
            ((finiteMapFiber s J q).card : ℝ) * G q.1 q.2) =
            ∑ q ∈ I,
              ((finiteMapFiber s J q).card : ℝ) * G q.1 q.2 := by
          apply Finset.sum_congr
          · ext q
            simp only [I, Finset.mem_image]
          · intro q hq
            rfl
        _ = ∑ ω ∈ s, G (X ω) (Z ω) := by
          simpa only [I, J] using hregroup

lemma sum_pairFiber_over_image_eq_fiber {α β γ : Type*}
    (s : Finset α) (X : α → β) (Z : α → γ) (x : β) :
    ∑ z ∈ s.image Z,
        (finiteMapFiber s (fun ω ↦ (X ω, Z ω)) (x, z)).card =
      (finiteMapFiber s X x).card := by
  classical
  let sx := finiteMapFiber s X x
  have hmap : ∀ ω ∈ sx, Z ω ∈ s.image Z := by
    intro ω hω
    exact Finset.mem_image.mpr
      ⟨ω, (Finset.mem_filter.mp hω).1, rfl⟩
  have hsum := sum_card_finiteMapFiber_eq_card sx (s.image Z) Z hmap
  calc
    (∑ z ∈ s.image Z,
        (finiteMapFiber s (fun ω ↦ (X ω, Z ω)) (x, z)).card) =
        ∑ z ∈ s.image Z, (finiteMapFiber sx Z z).card := by
      apply Finset.sum_congr rfl
      intro z hz
      exact congrArg Finset.card (finiteMapFiber_pair_eq_nested s X Z x z)
    _ = (finiteMapFiber s X x).card := hsum

/-- The entropy of the pushforward of the uniform distribution on `s` is
the logarithm of `|s|` minus the average logarithm of the occupied fiber
size.  This is the finite identity underlying the chain rule used in the
entropy--Brégman argument. -/
lemma finiteEntropy_image_cardRatio_eq {α β : Type*}
    (s : Finset α) (f : α → β) (hs : s.Nonempty) :
    let q : β → ℝ := fun b ↦
      ((finiteMapFiber s f b).card : ℝ) / s.card
    finiteEntropy (s.image f) q =
      Real.log (s.card : ℝ) -
        finsetAverage s
          (fun x ↦ Real.log ((finiteMapFiber s f (f x)).card : ℝ)) := by
  classical
  dsimp only
  let q : β → ℝ := fun b ↦
    ((finiteMapFiber s f b).card : ℝ) / s.card
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  have hmassNat :
      ∑ b ∈ s.image f, (finiteMapFiber s f b).card = s.card := by
    simpa [finiteMapFiber] using
      (Finset.sum_image'
        (s := s) (g := f)
        (f := fun b ↦ (finiteMapFiber s f b).card)
        (h := fun _x ↦ 1)
        (fun x hx ↦ by simp [finiteMapFiber]))
  have hmass :
      ∑ b ∈ s.image f, ((finiteMapFiber s f b).card : ℝ) =
        (s.card : ℝ) := by
    exact_mod_cast hmassNat
  have hlogFiber :
      ∑ b ∈ s.image f,
          ((finiteMapFiber s f b).card : ℝ) *
            Real.log ((finiteMapFiber s f b).card : ℝ) =
        ∑ x ∈ s,
          Real.log ((finiteMapFiber s f (f x)).card : ℝ) := by
    simpa [finiteMapFiber, nsmul_eq_mul, mul_comm] using
      (Finset.sum_image'
        (s := s) (g := f)
        (f := fun b ↦
          ((finiteMapFiber s f b).card : ℝ) *
            Real.log ((finiteMapFiber s f b).card : ℝ))
        (h := fun x ↦
          Real.log ((finiteMapFiber s f (f x)).card : ℝ))
        (fun x hx ↦ by
          have hconst :
              (∑ j ∈ s.filter (fun j ↦ f j = f x),
                  Real.log ((finiteMapFiber s f (f j)).card : ℝ)) =
                ∑ _j ∈ s.filter (fun j ↦ f j = f x),
                  Real.log ((finiteMapFiber s f (f x)).card : ℝ) := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [(Finset.mem_filter.mp hj).2]
          rw [hconst]
          simp [finiteMapFiber, mul_comm]))
  have hpoint : ∀ b ∈ s.image f,
      -(q b) * Real.log (q b) =
        (((finiteMapFiber s f b).card : ℝ) / s.card) *
            Real.log (s.card : ℝ) -
          (1 / (s.card : ℝ)) *
            (((finiteMapFiber s f b).card : ℝ) *
              Real.log ((finiteMapFiber s f b).card : ℝ)) := by
    intro b hb
    rcases Finset.mem_image.mp hb with ⟨x, hx, rfl⟩
    have hfiber : (finiteMapFiber s f (f x)).Nonempty := by
      exact ⟨x, Finset.mem_filter.mpr ⟨hx, rfl⟩⟩
    have hfiberCard :
        (0 : ℝ) < (finiteMapFiber s f (f x)).card := by
      exact_mod_cast Finset.card_pos.mpr hfiber
    dsimp only [q]
    rw [Real.log_div hfiberCard.ne' hsCard.ne']
    field_simp [hsCard.ne']
    ring
  unfold finiteEntropy finsetAverage
  rw [Finset.sum_congr rfl hpoint, Finset.sum_sub_distrib,
    ← Finset.sum_mul, ← Finset.mul_sum, hlogFiber]
  have hsumDiv :
      ∑ b ∈ s.image f,
          ((finiteMapFiber s f b).card : ℝ) / s.card = 1 := by
    rw [← Finset.sum_div, hmass, div_self hsCard.ne']
  rw [hsumDiv]
  field_simp [hsCard.ne']

/-- Entropy of the pushforward of the uniform law on a finite set.  The
probability of an occupied value is its fiber cardinality divided by the
cardinality of the sample space. -/
def finiteUniformImageEntropy {α β : Type*}
    (s : Finset α) (X : α → β) : ℝ :=
  finiteEntropy (s.image X) fun x ↦
    ((finiteMapFiber s X x).card : ℝ) / s.card

/-- Conditional entropy for two finite random variables on a uniform
finite sample space, written directly as the expected logarithm of the
ratio between a conditioning fiber and a joint fiber. -/
def finiteConditionalEntropy {α β γ : Type*}
    (s : Finset α) (X : α → β) (Z : α → γ) : ℝ :=
  finsetAverage s fun ω ↦
    Real.log ((finiteMapFiber s Z (Z ω)).card : ℝ) -
      Real.log
        ((finiteMapFiber s (fun u ↦ (X u, Z u)) (X ω, Z ω)).card : ℝ)

lemma finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber
    {α β : Type*} (s : Finset α) (X : α → β) (hs : s.Nonempty) :
    finiteUniformImageEntropy s X =
      Real.log (s.card : ℝ) -
        finsetAverage s
          (fun ω ↦ Real.log ((finiteMapFiber s X (X ω)).card : ℝ)) := by
  simpa only [finiteUniformImageEntropy] using
    finiteEntropy_image_cardRatio_eq s X hs

/-- Exact finite chain rule in the orientation needed for the matching
exposure: `H(X,Z) = H(Z) + H(X | Z)`. -/
lemma finiteUniformImageEntropy_pair_eq_add_conditional
    {α β γ : Type*} (s : Finset α) (X : α → β) (Z : α → γ)
    (hs : s.Nonempty) :
    finiteUniformImageEntropy s (fun ω ↦ (X ω, Z ω)) =
      finiteUniformImageEntropy s Z +
        finiteConditionalEntropy s X Z := by
  rw [finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber
        s (fun ω ↦ (X ω, Z ω)) hs,
    finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber s Z hs]
  unfold finiteConditionalEntropy finsetAverage
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  rw [Finset.sum_sub_distrib]
  field_simp [hsCard.ne']
  ring

/-- Equivalent subtraction form of the finite chain rule. -/
lemma finiteConditionalEntropy_eq_sub {α β γ : Type*}
    (s : Finset α) (X : α → β) (Z : α → γ) (hs : s.Nonempty) :
    finiteConditionalEntropy s X Z =
      finiteUniformImageEntropy s (fun ω ↦ (X ω, Z ω)) -
        finiteUniformImageEntropy s Z := by
  linarith [finiteUniformImageEntropy_pair_eq_add_conditional s X Z hs]

/-- Occupied-joint-fiber expansion of finite conditional entropy. -/
lemma finiteConditionalEntropy_eq_sum_jointFiber_log_ratio
    {α β γ : Type*} (s : Finset α) (X : α → β) (Z : α → γ)
    (hs : s.Nonempty) :
    finiteConditionalEntropy s X Z =
      (∑ q ∈ s.image (fun ω ↦ (X ω, Z ω)),
          ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) q).card : ℝ) *
            Real.log
              (((finiteMapFiber s Z q.2).card : ℝ) /
                ((finiteMapFiber s (fun ω ↦ (X ω, Z ω)) q).card : ℝ))) /
        (s.card : ℝ) := by
  let J : α → β × γ := fun ω ↦ (X ω, Z ω)
  let G : β × γ → ℝ := fun q ↦
    Real.log (((finiteMapFiber s Z q.2).card : ℝ) /
      ((finiteMapFiber s J q).card : ℝ))
  have hpoint : ∀ ω ∈ s,
      Real.log ((finiteMapFiber s Z (Z ω)).card : ℝ) -
          Real.log ((finiteMapFiber s J (J ω)).card : ℝ) = G (J ω) := by
    intro ω hω
    have hZ : (finiteMapFiber s Z (Z ω)).Nonempty :=
      ⟨ω, Finset.mem_filter.mpr ⟨hω, rfl⟩⟩
    have hJ : (finiteMapFiber s J (J ω)).Nonempty := by
      refine ⟨ω, ?_⟩
      unfold finiteMapFiber
      simp only [Finset.mem_filter, hω, true_and]
    have hZpos : (0 : ℝ) < (finiteMapFiber s Z (Z ω)).card := by
      exact_mod_cast Finset.card_pos.mpr hZ
    have hJpos : (0 : ℝ) < (finiteMapFiber s J (J ω)).card := by
      exact_mod_cast Finset.card_pos.mpr hJ
    dsimp only [G, J]
    rw [Real.log_div hZpos.ne' hJpos.ne']
  unfold finiteConditionalEntropy finsetAverage
  rw [Finset.sum_congr rfl hpoint]
  rw [sum_eq_sum_card_fiber_mul s J G]
  apply congrArg (fun y : ℝ ↦ y / (s.card : ℝ))
  apply Finset.sum_congr
  · ext q
    simp only [Finset.mem_image, J]
  · intro q hq
    simp only [G, J]

/-- Fiber expansion of the entropy of a finite random variable. -/
lemma finiteUniformImageEntropy_eq_sum_fiber_log_ratio
    {α β : Type*} (s : Finset α) (X : α → β) (hs : s.Nonempty) :
    finiteUniformImageEntropy s X =
      (∑ x ∈ s.image X,
          ((finiteMapFiber s X x).card : ℝ) *
            Real.log ((s.card : ℝ) /
              ((finiteMapFiber s X x).card : ℝ))) /
        (s.card : ℝ) := by
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  rw [finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber s X hs]
  unfold finsetAverage
  rw [sum_eq_sum_card_fiber_mul s X
    (fun x ↦ Real.log ((finiteMapFiber s X x).card : ℝ))]
  have hmass := sum_castCard_finiteMapFiber_eq_card
    s (s.image X) X (fun x hx ↦ Finset.mem_image.mpr ⟨x, hx, rfl⟩)
  have hpoint : ∀ x ∈ s.image X,
      Real.log ((s.card : ℝ) / ((finiteMapFiber s X x).card : ℝ)) =
        Real.log (s.card : ℝ) -
          Real.log ((finiteMapFiber s X x).card : ℝ) := by
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨ω, hω, rfl⟩
    have hfiber : (finiteMapFiber s X (X ω)).Nonempty :=
      ⟨ω, Finset.mem_filter.mpr ⟨hω, rfl⟩⟩
    have hfiberPos : (0 : ℝ) < (finiteMapFiber s X (X ω)).card := by
      exact_mod_cast Finset.card_pos.mpr hfiber
    rw [Real.log_div hsCard.ne' hfiberPos.ne']
  rw [Finset.sum_congr rfl fun x hx ↦ congrArg
    (fun y ↦ ((finiteMapFiber s X x).card : ℝ) * y) (hpoint x hx)]
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hmass]
  field_simp [hsCard.ne']

/-- Conditioning reduces entropy for random variables on a nonempty finite
uniform sample space.  The proof is the weighted log-sum inequality applied
separately to each occupied value of `X`. -/
lemma finiteConditionalEntropy_le_uniformImageEntropy
    {α β γ : Type*} (s : Finset α) (X : α → β) (Z : α → γ)
    (hs : s.Nonempty) :
    finiteConditionalEntropy s X Z ≤ finiteUniformImageEntropy s X := by
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  let J : α → β × γ := fun ω ↦ (X ω, Z ω)
  let a : β → γ → ℝ := fun x z ↦
    ((finiteMapFiber s J (x, z)).card : ℝ)
  let b : γ → ℝ := fun z ↦ ((finiteMapFiber s Z z).card : ℝ)
  let A : β → ℝ := fun x ↦ ((finiteMapFiber s X x).card : ℝ)
  let B : ℝ := (s.card : ℝ)
  let G : β → γ → ℝ := fun x z ↦ Real.log (b z / a x z)
  have hB : 0 < B := by simpa only [B] using hsCard
  have hsumB : ∑ z ∈ s.image Z, b z = B := by
    dsimp only [b, B]
    exact sum_castCard_finiteMapFiber_eq_card s (s.image Z) Z
      (fun ω hω ↦ Finset.mem_image.mpr ⟨ω, hω, rfl⟩)
  have hper : ∀ x ∈ s.image X,
      (∑ z ∈ s.image Z, a x z * G x z) ≤
        A x * Real.log (B / A x) := by
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨ωx, hωx, rfl⟩
    have hxFiber : (finiteMapFiber s X (X ωx)).Nonempty :=
      ⟨ωx, Finset.mem_filter.mpr ⟨hωx, rfl⟩⟩
    have hA : 0 < A (X ωx) := by
      dsimp only [A]
      exact_mod_cast Finset.card_pos.mpr hxFiber
    have ha0 : ∀ z ∈ s.image Z, 0 ≤ a (X ωx) z := by
      intro z hz
      dsimp only [a]
      positivity
    have hb0 : ∀ z ∈ s.image Z, 0 ≤ b z := by
      intro z hz
      dsimp only [b]
      positivity
    have hsupport : ∀ z ∈ s.image Z,
        0 < a (X ωx) z → 0 < b z := by
      intro z hz hapos
      have hcard : 0 < (finiteMapFiber s J (X ωx, z)).card := by
        have hapos' : (0 : ℝ) <
            ((finiteMapFiber s J (X ωx, z)).card : ℝ) := by
          simpa only [a] using hapos
        exact_mod_cast hapos'
      obtain ⟨ω, hω⟩ := Finset.card_pos.mp hcard
      have hdata : ω ∈ s ∧ J ω = (X ωx, z) := by
        simpa only [finiteMapFiber, Finset.mem_filter] using hω
      have hzEq : Z ω = z := congrArg Prod.snd hdata.2
      have hzFiber : (finiteMapFiber s Z z).Nonempty := by
        refine ⟨ω, Finset.mem_filter.mpr ⟨hdata.1, ?_⟩⟩
        exact hzEq
      dsimp only [b]
      exact_mod_cast Finset.card_pos.mpr hzFiber
    have hsumA : ∑ z ∈ s.image Z, a (X ωx) z = A (X ωx) := by
      dsimp only [a, A, J]
      exact_mod_cast sum_pairFiber_over_image_eq_fiber s X Z (X ωx)
    simpa only [G] using
      weightedLogSum_le (s.image Z) (a (X ωx)) b
        (A (X ωx)) B hA hB ha0 hb0 hsupport hsumA hsumB
  have hsum :
      (∑ x ∈ s.image X, ∑ z ∈ s.image Z, a x z * G x z) ≤
        ∑ x ∈ s.image X, A x * Real.log (B / A x) :=
    Finset.sum_le_sum hper
  have hdouble :
      (∑ x ∈ s.image X, ∑ z ∈ s.image Z, a x z * G x z) =
        ∑ ω ∈ s, G (X ω) (Z ω) := by
    simpa only [a, G, J] using sum_pairFiber_mul_eq_sum s X Z
      (fun x z ↦ Real.log
        (((finiteMapFiber s Z z).card : ℝ) /
          ((finiteMapFiber s (fun u ↦ (X u, Z u)) (x, z)).card : ℝ)))
  have hcond : finiteConditionalEntropy s X Z =
      (∑ x ∈ s.image X, ∑ z ∈ s.image Z, a x z * G x z) / B := by
    unfold finiteConditionalEntropy finsetAverage
    have hpoint : ∀ ω ∈ s,
        Real.log ((finiteMapFiber s Z (Z ω)).card : ℝ) -
            Real.log ((finiteMapFiber s J (J ω)).card : ℝ) =
          G (X ω) (Z ω) := by
      intro ω hω
      have hzFiber : (finiteMapFiber s Z (Z ω)).Nonempty :=
        ⟨ω, Finset.mem_filter.mpr ⟨hω, rfl⟩⟩
      have hjFiber : (finiteMapFiber s J (J ω)).Nonempty := by
        refine ⟨ω, ?_⟩
        unfold finiteMapFiber
        simp only [Finset.mem_filter, hω, true_and]
      have hzpos : (0 : ℝ) < (finiteMapFiber s Z (Z ω)).card := by
        exact_mod_cast Finset.card_pos.mpr hzFiber
      have hjpos : (0 : ℝ) < (finiteMapFiber s J (J ω)).card := by
        exact_mod_cast Finset.card_pos.mpr hjFiber
      dsimp only [G, a, b, J]
      rw [Real.log_div hzpos.ne' hjpos.ne']
    rw [Finset.sum_congr rfl hpoint, ← hdouble]
  rw [hcond, finiteUniformImageEntropy_eq_sum_fiber_log_ratio s X hs]
  dsimp only [A, B] at hsum ⊢
  exact div_le_div_of_nonneg_right hsum hsCard.le

/-- Early form of the finite tower property, used by the conditional
entropy decomposition below. -/
lemma finsetAverage_fiber_average_aux {α β : Type*}
    (s : Finset α) (f : α → β) (G : β → α → ℝ) :
    finsetAverage s (fun x ↦
        finsetAverage (finiteMapFiber s f (f x)) (G (f x))) =
      finsetAverage s (fun x ↦ G (f x) x) := by
  classical
  unfold finsetAverage
  congr 1
  calc
    (∑ x ∈ s,
        (∑ y ∈ finiteMapFiber s f (f x), G (f x) y) /
          ((finiteMapFiber s f (f x)).card : ℝ)) =
        ∑ b ∈ s.image f,
          ((finiteMapFiber s f b).card : ℝ) *
            ((∑ y ∈ finiteMapFiber s f b, G b y) /
              ((finiteMapFiber s f b).card : ℝ)) := by
      symm
      simpa [finiteMapFiber, nsmul_eq_mul, mul_comm] using
        (Finset.sum_image'
          (s := s) (g := f)
          (f := fun b ↦
            ((finiteMapFiber s f b).card : ℝ) *
              ((∑ y ∈ finiteMapFiber s f b, G b y) /
                ((finiteMapFiber s f b).card : ℝ)))
          (h := fun x ↦
            (∑ y ∈ finiteMapFiber s f (f x), G (f x) y) /
              ((finiteMapFiber s f (f x)).card : ℝ))
          (fun x hx ↦ by
            have hconst :
                (∑ j ∈ s.filter (fun j ↦ f j = f x),
                    (∑ y ∈ finiteMapFiber s f (f j), G (f j) y) /
                      ((finiteMapFiber s f (f j)).card : ℝ)) =
                  ∑ _j ∈ s.filter (fun j ↦ f j = f x),
                    (∑ y ∈ finiteMapFiber s f (f x), G (f x) y) /
                      ((finiteMapFiber s f (f x)).card : ℝ) := by
              apply Finset.sum_congr rfl
              intro j hj
              rw [(Finset.mem_filter.mp hj).2]
            rw [hconst]
            simp [finiteMapFiber, nsmul_eq_mul]))
    _ = ∑ b ∈ s.image f,
          ∑ y ∈ finiteMapFiber s f b, G b y := by
      apply Finset.sum_congr rfl
      intro b hb
      rcases Finset.mem_image.mp hb with ⟨x, hx, rfl⟩
      have hfiber : (finiteMapFiber s f (f x)).Nonempty :=
        ⟨x, Finset.mem_filter.mpr ⟨hx, rfl⟩⟩
      have hcard :
          ((finiteMapFiber s f (f x)).card : ℝ) ≠ 0 := by
        exact_mod_cast (Finset.card_pos.mpr hfiber).ne'
      field_simp [hcard]
    _ = ∑ x ∈ s, G (f x) x := by
      simpa [finiteMapFiber] using
        (Finset.sum_image'
          (s := s) (g := f)
          (f := fun b ↦ ∑ y ∈ finiteMapFiber s f b, G b y)
          (h := fun x ↦ G (f x) x)
          (fun x hx ↦ by
            unfold finiteMapFiber
            apply Finset.sum_congr rfl
            intro j hj
            rw [(Finset.mem_filter.mp hj).2]))

/-- Conditional entropy is the average, over conditioning fibers, of the
ordinary entropy inside the fiber. -/
lemma finiteConditionalEntropy_eq_average_fiber_uniformImageEntropy
    {α β γ : Type*} (s : Finset α) (X : α → β) (Z : α → γ)
    (hs : s.Nonempty) :
    finiteConditionalEntropy s X Z =
      finsetAverage s (fun ω ↦
        finiteUniformImageEntropy (finiteMapFiber s Z (Z ω)) X) := by
  let L : α → ℝ := fun y ↦
    Real.log
      ((finiteMapFiber s (fun u ↦ (X u, Z u)) (X y, Z y)).card : ℝ)
  have hlocal : ∀ ω ∈ s,
      finiteUniformImageEntropy (finiteMapFiber s Z (Z ω)) X =
        Real.log ((finiteMapFiber s Z (Z ω)).card : ℝ) -
          finsetAverage (finiteMapFiber s Z (Z ω)) L := by
    intro ω hω
    let t := finiteMapFiber s Z (Z ω)
    have ht : t.Nonempty :=
      ⟨ω, Finset.mem_filter.mpr ⟨hω, rfl⟩⟩
    rw [finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber t X ht]
    congr 1
    unfold finsetAverage
    apply congrArg (fun y : ℝ ↦ y / (t.card : ℝ))
    apply Finset.sum_congr rfl
    intro y hy
    have hzy : Z y = Z ω := (Finset.mem_filter.mp hy).2
    have hfiber : finiteMapFiber t X (X y) =
        finiteMapFiber s (fun u ↦ (X u, Z u)) (X y, Z y) := by
      ext u
      simp only [t, finiteMapFiber, Finset.mem_filter, Prod.mk.injEq]
      constructor
      · rintro ⟨⟨huS, huZ⟩, huX⟩
        exact ⟨huS, huX, huZ.trans hzy.symm⟩
      · rintro ⟨huS, huX, huZ⟩
        exact ⟨⟨huS, huZ.trans hzy⟩, huX⟩
    dsimp only [L]
    rw [hfiber]
  have houter :
      finsetAverage s (fun ω ↦
          finiteUniformImageEntropy (finiteMapFiber s Z (Z ω)) X) =
        finsetAverage s (fun ω ↦
          Real.log ((finiteMapFiber s Z (Z ω)).card : ℝ) -
            finsetAverage (finiteMapFiber s Z (Z ω)) L) := by
    unfold finsetAverage
    apply congrArg (fun y : ℝ ↦ y / (s.card : ℝ))
    exact Finset.sum_congr rfl hlocal
  have htower :
      finsetAverage s (fun ω ↦
          finsetAverage (finiteMapFiber s Z (Z ω)) L) =
        finsetAverage s L := by
    simpa using finsetAverage_fiber_average_aux s Z (fun _z y ↦ L y)
  rw [houter]
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  unfold finiteConditionalEntropy
  unfold finsetAverage at htower ⊢
  have htowerSum :
      (∑ ω ∈ s,
          (∑ x ∈ finiteMapFiber s Z (Z ω), L x) /
            ((finiteMapFiber s Z (Z ω)).card : ℝ)) =
        ∑ x ∈ s, L x := by
    field_simp [hsCard.ne'] at htower
    exact htower
  apply congrArg (fun y : ℝ ↦ y / (s.card : ℝ))
  change
    (∑ x ∈ s,
        (Real.log ((finiteMapFiber s Z (Z x)).card : ℝ) - L x)) =
      ∑ x ∈ s,
        (Real.log ((finiteMapFiber s Z (Z x)).card : ℝ) -
          (∑ y ∈ finiteMapFiber s Z (Z x), L y) /
            ((finiteMapFiber s Z (Z x)).card : ℝ))
  rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, htowerSum]

/-- If `Z` is determined by `W`, then conditioning first on `Z` and then
on `W` gives the same global conditional entropy as conditioning on `W`
alone.  This is the finite tower identity needed for data processing. -/
lemma finiteConditionalEntropy_eq_average_fiber_conditional_of_comp
    {α β γ δ : Type*} (s : Finset α)
    (X : α → β) (W : α → γ) (Z : α → δ) (g : γ → δ)
    (hcomp : ∀ ω ∈ s, Z ω = g (W ω)) :
    finiteConditionalEntropy s X W =
      finsetAverage s (fun ω ↦
        finiteConditionalEntropy (finiteMapFiber s Z (Z ω)) X W) := by
  let L : α → ℝ := fun y ↦
    Real.log ((finiteMapFiber s W (W y)).card : ℝ) -
      Real.log
        ((finiteMapFiber s (fun u ↦ (X u, W u)) (X y, W y)).card : ℝ)
  have hlocal : ∀ ω ∈ s,
      finiteConditionalEntropy (finiteMapFiber s Z (Z ω)) X W =
        finsetAverage (finiteMapFiber s Z (Z ω)) L := by
    intro ω hω
    let t := finiteMapFiber s Z (Z ω)
    unfold finiteConditionalEntropy finsetAverage
    apply congrArg (fun q : ℝ ↦ q / (t.card : ℝ))
    apply Finset.sum_congr rfl
    intro y hy
    have hyS : y ∈ s := (Finset.mem_filter.mp hy).1
    have hyZ : Z y = Z ω := (Finset.mem_filter.mp hy).2
    have hWfiber : finiteMapFiber t W (W y) =
        finiteMapFiber s W (W y) := by
      ext u
      simp only [t, finiteMapFiber, Finset.mem_filter]
      constructor
      · rintro ⟨⟨huS, huZ⟩, huW⟩
        exact ⟨huS, huW⟩
      · rintro ⟨huS, huW⟩
        have hZu : Z u = Z y := by
          rw [hcomp u huS, hcomp y hyS, huW]
        exact ⟨⟨huS, hZu.trans hyZ⟩, huW⟩
    have hXWfiber :
        finiteMapFiber t (fun u ↦ (X u, W u)) (X y, W y) =
          finiteMapFiber s (fun u ↦ (X u, W u)) (X y, W y) := by
      ext u
      simp only [t, finiteMapFiber, Finset.mem_filter, Prod.mk.injEq]
      constructor
      · rintro ⟨⟨huS, huZ⟩, huX, huW⟩
        exact ⟨huS, huX, huW⟩
      · rintro ⟨huS, huX, huW⟩
        have hZu : Z u = Z y := by
          rw [hcomp u huS, hcomp y hyS, huW]
        exact ⟨⟨huS, hZu.trans hyZ⟩, huX, huW⟩
    dsimp only [L]
    rw [hWfiber, hXWfiber]
  rw [show finiteConditionalEntropy s X W = finsetAverage s L by rfl]
  have htower := finsetAverage_fiber_average_aux s Z (fun _z y ↦ L y)
  rw [← htower]
  unfold finsetAverage
  apply congrArg (fun y : ℝ ↦ y / (s.card : ℝ))
  exact Finset.sum_congr rfl (fun ω hω ↦ (hlocal ω hω).symm)

/-- Data processing for finite conditional entropy: replacing a
conditioning variable by a function of it can only increase entropy. -/
lemma finiteConditionalEntropy_mono_of_comp
    {α β γ δ : Type*} (s : Finset α)
    (X : α → β) (W : α → γ) (Z : α → δ) (g : γ → δ)
    (hs : s.Nonempty) (hcomp : ∀ ω ∈ s, Z ω = g (W ω)) :
    finiteConditionalEntropy s X W ≤
      finiteConditionalEntropy s X Z := by
  rw [finiteConditionalEntropy_eq_average_fiber_conditional_of_comp
    s X W Z g hcomp,
    finiteConditionalEntropy_eq_average_fiber_uniformImageEntropy
      s X Z hs]
  apply finsetAverage_mono
  intro ω hω
  have ht : (finiteMapFiber s Z (Z ω)).Nonempty :=
    ⟨ω, Finset.mem_filter.mpr ⟨hω, rfl⟩⟩
  exact finiteConditionalEntropy_le_uniformImageEntropy
    (finiteMapFiber s Z (Z ω)) X W ht

/-- Conditional entropy over a product sample, when the first coordinate
is retained in the conditioning variable, is the average of the
conditional entropies on the second-coordinate fibers. -/
lemma finiteConditionalEntropy_product_eq_average
    {α β γ δ : Type*} (p : Finset α) (s : Finset β)
    (X : β → γ) (Z : α → β → δ)
    (hp : p.Nonempty) (hs : s.Nonempty) :
    finiteConditionalEntropy (p ×ˢ s)
        (fun q ↦ X q.2) (fun q ↦ (q.1, Z q.1 q.2)) =
      finsetAverage p (fun a ↦ finiteConditionalEntropy s X (Z a)) := by
  classical
  let W : α × β → α × δ := fun q ↦ (q.1, Z q.1 q.2)
  let J : α × β → γ × (α × δ) :=
    fun q ↦ (X q.2, W q)
  have hWfiber : ∀ a ∈ p, ∀ b ∈ s,
      finiteMapFiber (p ×ˢ s) W (W (a, b)) =
        ({a} : Finset α).product
          (finiteMapFiber s (Z a) (Z a b)) := by
    intro a ha b hb
    ext q
    rcases q with ⟨a', b'⟩
    simp only [finiteMapFiber, Finset.mem_filter, Finset.mem_product,
      Finset.mem_singleton, W, Prod.mk.injEq]
    aesop
  have hJfiber : ∀ a ∈ p, ∀ b ∈ s,
      finiteMapFiber (p ×ˢ s) J (J (a, b)) =
        ({a} : Finset α).product
          (finiteMapFiber s (fun u ↦ (X u, Z a u)) (X b, Z a b)) := by
    intro a ha b hb
    ext q
    rcases q with ⟨a', b'⟩
    simp only [finiteMapFiber, Finset.mem_filter, Finset.mem_product,
      Finset.mem_singleton, J, W, Prod.mk.injEq]
    aesop
  have hpoint : ∀ q ∈ p ×ˢ s,
      Real.log ((finiteMapFiber (p ×ˢ s) W (W q)).card : ℝ) -
          Real.log ((finiteMapFiber (p ×ˢ s) J (J q)).card : ℝ) =
        Real.log ((finiteMapFiber s (Z q.1) (Z q.1 q.2)).card : ℝ) -
          Real.log ((finiteMapFiber s
            (fun u ↦ (X u, Z q.1 u)) (X q.2, Z q.1 q.2)).card : ℝ) := by
    rintro ⟨a, b⟩ hq
    have ha := (Finset.mem_product.mp hq).1
    have hb := (Finset.mem_product.mp hq).2
    rw [hWfiber a ha b hb, hJfiber a ha b hb]
    simp
  have hpCard : (0 : ℝ) < p.card := by
    exact_mod_cast Finset.card_pos.mpr hp
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  unfold finiteConditionalEntropy finsetAverage
  change
    (∑ q ∈ p ×ˢ s,
        (Real.log ((finiteMapFiber (p ×ˢ s) W (W q)).card : ℝ) -
          Real.log ((finiteMapFiber (p ×ˢ s) J (J q)).card : ℝ))) /
        ((p ×ˢ s).card : ℝ) = _
  rw [Finset.sum_congr rfl hpoint]
  have hprod := Finset.sum_product p s (fun q ↦
    Real.log ((finiteMapFiber s (Z q.1) (Z q.1 q.2)).card : ℝ) -
      Real.log ((finiteMapFiber s
        (fun u ↦ (X u, Z q.1 u)) (X q.2, Z q.1 q.2)).card : ℝ))
  rw [hprod]
  simp only [Finset.card_product, Nat.cast_mul]
  field_simp [hpCard.ne', hsCard.ne']
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a ha
  field_simp [hsCard.ne']

/-- Values of the coordinates listed in `prior`, in exposure order. -/
def finitePrefixCode {α ι β : Type*}
    (X : α → ι → β) (prior : List ι) (x : α) : List β :=
  prior.map (X x)

/-- The entropy of a uniform finite random variable depends only on its
occupied fiber cardinalities. -/
lemma finiteUniformImageEntropy_eq_of_fiberCard_eq
    {α β γ : Type*} (s : Finset α) (X : α → β) (Y : α → γ)
    (hs : s.Nonempty)
    (hcard : ∀ x ∈ s,
      (finiteMapFiber s X (X x)).card =
        (finiteMapFiber s Y (Y x)).card) :
    finiteUniformImageEntropy s X = finiteUniformImageEntropy s Y := by
  rw [finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber s X hs,
    finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber s Y hs]
  congr 1
  unfold finsetAverage
  apply congrArg (fun z : ℝ ↦ z / (s.card : ℝ))
  apply Finset.sum_congr rfl
  intro x hx
  change Real.log ((finiteMapFiber s X (X x)).card : ℝ) =
    Real.log ((finiteMapFiber s Y (Y x)).card : ℝ)
  rw [hcard x hx]

lemma finitePrefixCode_append_singleton {α ι β : Type*}
    (X : α → ι → β) (prior : List ι) (i : ι) (x : α) :
    finitePrefixCode X (prior ++ [i]) x =
      finitePrefixCode X prior x ++ [X x i] := by
  simp [finitePrefixCode]

lemma finitePrefixCode_eq_iff {α ι β : Type*}
    (X : α → ι → β) (prior : List ι) (x y : α) :
    finitePrefixCode X prior x = finitePrefixCode X prior y ↔
      ∀ i ∈ prior, X x i = X y i := by
  induction prior with
  | nil => simp [finitePrefixCode]
  | cons i prior ih =>
      change
        (X x i :: finitePrefixCode X prior x =
            X y i :: finitePrefixCode X prior y) ↔
          ∀ j ∈ i :: prior, X x j = X y j
      simp only [List.cons.injEq, List.mem_cons, forall_eq_or_imp, ih]

/-- Adding one coordinate to a prefix has the same fibers as pairing that
coordinate with the old prefix. -/
lemma finiteMapFiber_prefix_append_eq_pair {α ι β : Type*}
    (s : Finset α) (X : α → ι → β) (prior : List ι)
    (i : ι) (x : α) :
    finiteMapFiber s (finitePrefixCode X (prior ++ [i]))
        (finitePrefixCode X (prior ++ [i]) x) =
      finiteMapFiber s
        (fun y ↦ (X y i, finitePrefixCode X prior y))
        (X x i, finitePrefixCode X prior x) := by
  ext y
  simp only [finiteMapFiber, Finset.mem_filter, Prod.mk.injEq]
  constructor
  · rintro ⟨hy, hlist⟩
    have hprefix : finitePrefixCode X prior y =
        finitePrefixCode X prior x := by
      apply (finitePrefixCode_eq_iff X prior y x).2
      intro j hj
      exact (finitePrefixCode_eq_iff X (prior ++ [i]) y x).1 hlist
        j (List.mem_append_left _ hj)
    have hcoord : X y i = X x i := by
      exact (finitePrefixCode_eq_iff X (prior ++ [i]) y x).1 hlist
        i (by simp)
    exact ⟨hy, hcoord, hprefix⟩
  · rintro ⟨hy, hcoord, hprefix⟩
    refine ⟨hy, (finitePrefixCode_eq_iff X (prior ++ [i]) y x).2 ?_⟩
    intro j hj
    rcases List.mem_append.mp hj with hj | hj
    · exact (finitePrefixCode_eq_iff X prior y x).1 hprefix j hj
    · have hji : j = i := by simpa using hj
      subst j
      exact hcoord

/-- One-coordinate chain rule for list-valued prefix codes. -/
lemma finiteUniformImageEntropy_prefix_append_eq_add_conditional
    {α ι β : Type*} (s : Finset α) (X : α → ι → β)
    (prior : List ι) (i : ι) (hs : s.Nonempty) :
    finiteUniformImageEntropy s (finitePrefixCode X (prior ++ [i])) =
      finiteUniformImageEntropy s (finitePrefixCode X prior) +
        finiteConditionalEntropy s (fun x ↦ X x i)
          (finitePrefixCode X prior) := by
  have hpair := finiteUniformImageEntropy_pair_eq_add_conditional
    s (fun x ↦ X x i) (finitePrefixCode X prior) hs
  have hsame :
      finiteUniformImageEntropy s (finitePrefixCode X (prior ++ [i])) =
        finiteUniformImageEntropy s
          (fun x ↦ (X x i, finitePrefixCode X prior x)) := by
    apply finiteUniformImageEntropy_eq_of_fiberCard_eq s _ _ hs
    intro x hx
    exact congrArg Finset.card
      (finiteMapFiber_prefix_append_eq_pair s X prior i x)
  exact hsame.trans hpair

/-- Sum of successive conditional entropies after an already revealed
prefix. -/
def finiteConditionalChainCost {α ι β : Type*}
    (s : Finset α) (X : α → ι → β) : List ι → List ι → ℝ
  | _prior, [] => 0
  | prior, i :: rest =>
      finiteConditionalEntropy s (fun x ↦ X x i)
          (finitePrefixCode X prior) +
        finiteConditionalChainCost s X (prior ++ [i]) rest

lemma finiteUniformImageEntropy_prefix_append_eq_add_chainCost
    {α ι β : Type*} (s : Finset α) (X : α → ι → β)
    (prior rest : List ι) (hs : s.Nonempty) :
    finiteUniformImageEntropy s (finitePrefixCode X (prior ++ rest)) =
      finiteUniformImageEntropy s (finitePrefixCode X prior) +
        finiteConditionalChainCost s X prior rest := by
  induction rest generalizing prior with
  | nil => simp [finiteConditionalChainCost]
  | cons i rest ih =>
      rw [show prior ++ i :: rest = (prior ++ [i]) ++ rest by simp]
      rw [ih (prior ++ [i])]
      rw [finiteUniformImageEntropy_prefix_append_eq_add_conditional
        s X prior i hs]
      simp only [finiteConditionalChainCost]
      ring

/-- An injective random variable on a finite uniform sample space has
entropy `log |s|`. -/
lemma finiteUniformImageEntropy_eq_log_card_of_injectiveOn
    {α β : Type*} (s : Finset α) (X : α → β) (hs : s.Nonempty)
    (hinj : Set.InjOn X (↑s : Set α)) :
    finiteUniformImageEntropy s X = Real.log (s.card : ℝ) := by
  rw [finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber s X hs]
  have hfiber : ∀ x ∈ s, finiteMapFiber s X (X x) = {x} := by
    intro x hx
    ext y
    simp only [finiteMapFiber, Finset.mem_filter, Finset.mem_singleton]
    constructor
    · rintro ⟨hy, hYX⟩
      exact hinj hy hx hYX
    · rintro rfl
      exact ⟨hx, rfl⟩
  have havgZero : finsetAverage s
      (fun x ↦ Real.log ((finiteMapFiber s X (X x)).card : ℝ)) = 0 := by
    unfold finsetAverage
    have hsumZero :
        ∑ x ∈ s,
            Real.log ((finiteMapFiber s X (X x)).card : ℝ) = 0 := by
      apply Finset.sum_eq_zero
      intro x hx
      rw [hfiber x hx]
      simp
    rw [hsumZero, zero_div]
  rw [havgZero, sub_zero]

lemma finiteUniformImageEntropy_emptyPrefix {α ι β : Type*}
    (s : Finset α) (X : α → ι → β) :
    finiteUniformImageEntropy s (finitePrefixCode X []) = 0 := by
  by_cases hs : s.Nonempty
  · rw [finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber
      s (finitePrefixCode X []) hs]
    have hcard : (0 : ℝ) < s.card := by
      exact_mod_cast Finset.card_pos.mpr hs
    have hfiber : ∀ x ∈ s,
        finiteMapFiber s (finitePrefixCode X [])
            (finitePrefixCode X [] x) = s := by
      intro x hx
      ext y
      simp [finiteMapFiber, finitePrefixCode]
    unfold finsetAverage
    rw [Finset.sum_congr rfl fun x hx ↦ congrArg
      (fun k : Finset α ↦ Real.log (k.card : ℝ)) (hfiber x hx)]
    simp only [Finset.sum_const, nsmul_eq_mul]
    field_simp [hcard.ne']
    ring
  · have hempty : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    subst s
    simp [finiteUniformImageEntropy, finiteEntropy, finitePrefixCode,
      finiteMapFiber]

/-- Exact chain rule as a sum of conditional entropies of successive
coordinates. -/
lemma log_card_eq_finiteConditionalChainCost {α ι β : Type*}
    (s : Finset α) (X : α → ι → β) (order : List ι)
    (hs : s.Nonempty)
    (hinj : Set.InjOn (finitePrefixCode X order) (↑s : Set α)) :
    Real.log (s.card : ℝ) = finiteConditionalChainCost s X [] order := by
  have hfull := finiteUniformImageEntropy_eq_log_card_of_injectiveOn
    s (finitePrefixCode X order) hs hinj
  have hchain := finiteUniformImageEntropy_prefix_append_eq_add_chainCost
    s X [] order hs
  simp only [List.nil_append, finiteUniformImageEntropy_emptyPrefix,
    zero_add] at hchain
  linarith

/-- One step of the finite entropy chain rule: the logarithm of the
number of inputs is bounded by the logarithm of the number of first
outcomes plus the average logarithm of the corresponding fiber size. -/
lemma log_card_le_log_image_card_add_average_log_fiber {α β : Type*}
    (s : Finset α) (f : α → β) (hs : s.Nonempty) :
    Real.log (s.card : ℝ) ≤
      Real.log ((s.image f).card : ℝ) +
        finsetAverage s
          (fun x ↦ Real.log ((finiteMapFiber s f (f x)).card : ℝ)) := by
  classical
  let q : β → ℝ := fun b ↦
    ((finiteMapFiber s f b).card : ℝ) / s.card
  have himage : (s.image f).Nonempty := hs.image f
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  have hq0 : ∀ b ∈ s.image f, 0 ≤ q b := by
    intro b hb
    dsimp only [q]
    positivity
  have hmassNat :
      ∑ b ∈ s.image f, (finiteMapFiber s f b).card = s.card := by
    simpa [finiteMapFiber] using
      (Finset.sum_image'
        (s := s) (g := f)
        (f := fun b ↦ (finiteMapFiber s f b).card)
        (h := fun _x ↦ 1)
        (fun x hx ↦ by simp [finiteMapFiber]))
  have hqsum : ∑ b ∈ s.image f, q b = 1 := by
    dsimp only [q]
    rw [← Finset.sum_div]
    have hmass :
        ∑ b ∈ s.image f, ((finiteMapFiber s f b).card : ℝ) =
          (s.card : ℝ) := by
      exact_mod_cast hmassNat
    rw [hmass, div_self hsCard.ne']
  have hmax := finiteEntropy_le_log_card (s.image f) q
    himage hq0 hqsum
  have hid := finiteEntropy_image_cardRatio_eq s f hs
  dsimp only at hid
  dsimp only [q] at hmax
  rw [hid] at hmax
  linarith

/-- Averaging a fiberwise average over every point of the base set simply
recovers the original average.  This is the finite tower property. -/
lemma finsetAverage_fiber_average {α β : Type*}
    (s : Finset α) (f : α → β) (G : β → α → ℝ) :
    finsetAverage s (fun x ↦
        finsetAverage (finiteMapFiber s f (f x)) (G (f x))) =
      finsetAverage s (fun x ↦ G (f x) x) := by
  classical
  unfold finsetAverage
  congr 1
  calc
    (∑ x ∈ s,
        (∑ y ∈ finiteMapFiber s f (f x), G (f x) y) /
          ((finiteMapFiber s f (f x)).card : ℝ)) =
        ∑ b ∈ s.image f,
          ((finiteMapFiber s f b).card : ℝ) *
            ((∑ y ∈ finiteMapFiber s f b, G b y) /
              ((finiteMapFiber s f b).card : ℝ)) := by
      symm
      simpa [finiteMapFiber, nsmul_eq_mul, mul_comm] using
        (Finset.sum_image'
          (s := s) (g := f)
          (f := fun b ↦
            ((finiteMapFiber s f b).card : ℝ) *
              ((∑ y ∈ finiteMapFiber s f b, G b y) /
                ((finiteMapFiber s f b).card : ℝ)))
          (h := fun x ↦
            (∑ y ∈ finiteMapFiber s f (f x), G (f x) y) /
              ((finiteMapFiber s f (f x)).card : ℝ))
          (fun x hx ↦ by
            have hconst :
                (∑ j ∈ s.filter (fun j ↦ f j = f x),
                    (∑ y ∈ finiteMapFiber s f (f j), G (f j) y) /
                      ((finiteMapFiber s f (f j)).card : ℝ)) =
                  ∑ _j ∈ s.filter (fun j ↦ f j = f x),
                    (∑ y ∈ finiteMapFiber s f (f x), G (f x) y) /
                      ((finiteMapFiber s f (f x)).card : ℝ) := by
              apply Finset.sum_congr rfl
              intro j hj
              rw [(Finset.mem_filter.mp hj).2]
            rw [hconst]
            simp [finiteMapFiber, nsmul_eq_mul]))
    _ = ∑ b ∈ s.image f,
          ∑ y ∈ finiteMapFiber s f b, G b y := by
      apply Finset.sum_congr rfl
      intro b hb
      rcases Finset.mem_image.mp hb with ⟨x, hx, rfl⟩
      have hfiber : (finiteMapFiber s f (f x)).Nonempty :=
        ⟨x, Finset.mem_filter.mpr ⟨hx, rfl⟩⟩
      have hcard :
          ((finiteMapFiber s f (f x)).card : ℝ) ≠ 0 := by
        exact_mod_cast (Finset.card_pos.mpr hfiber).ne'
      field_simp [hcard]
    _ = ∑ x ∈ s, G (f x) x := by
      simpa [finiteMapFiber] using
        (Finset.sum_image'
          (s := s) (g := f)
          (f := fun b ↦ ∑ y ∈ finiteMapFiber s f b, G b y)
          (h := fun x ↦ G (f x) x)
          (fun x hx ↦ by
            unfold finiteMapFiber
            apply Finset.sum_congr rfl
            intro j hj
            rw [(Finset.mem_filter.mp hj).2]))

/-- Branching cost of revealing the coordinates in `order`.  At each
stage the current finite fiber is partitioned by the next coordinate. -/
def finiteDecisionCost {α ι β : Type*} (s : Finset α)
    (X : α → ι → β) : List ι → α → ℝ
  | [], _x => 0
  | i :: is, x =>
      Real.log ((s.image fun y ↦ X y i).card : ℝ) +
        finiteDecisionCost
          (finiteMapFiber s (fun y ↦ X y i) (X x i)) X is x

/-- Exact entropy cost of revealing coordinates in a specified order.
Unlike `finiteDecisionCost`, the cost of the next coordinate is its actual
entropy in the current fiber, not merely the logarithm of its support. -/
def finiteEntropyDecisionCost {α ι β : Type*} (s : Finset α)
    (X : α → ι → β) : List ι → α → ℝ
  | [], _x => 0
  | i :: is, x =>
      finiteUniformImageEntropy s (fun y ↦ X y i) +
        finiteEntropyDecisionCost
          (finiteMapFiber s (fun y ↦ X y i) (X x i)) X is x

/-- Exact finite coordinate chain rule.  When the listed coordinates
separate the points of `s`, their successive conditional entropies sum to
the entropy `log |s|` of the uniform input. -/
lemma log_card_eq_finsetAverage_finiteEntropyDecisionCost
    {α ι β : Type*} (s : Finset α) (X : α → ι → β)
    (order : List ι) (hs : s.Nonempty)
    (hinj : ∀ x ∈ s, ∀ y ∈ s,
      (∀ i ∈ order, X x i = X y i) → x = y) :
    Real.log (s.card : ℝ) =
      finsetAverage s (finiteEntropyDecisionCost s X order) := by
  classical
  induction order generalizing s with
  | nil =>
      obtain ⟨x, hx⟩ := hs
      have hsingleton : s = {x} := by
        ext y
        constructor
        · intro hy
          have hyx : y = x := hinj y hy x hx (by simp)
          simp [hyx]
        · intro hy
          rw [Finset.mem_singleton.mp hy]
          exact hx
      subst s
      simp [finiteEntropyDecisionCost, finsetAverage]
  | cons i is ih =>
      let f : α → β := fun x ↦ X x i
      have hfirst :=
        finiteUniformImageEntropy_eq_log_card_sub_average_log_fiber s f hs
      have htail : ∀ x ∈ s,
          Real.log ((finiteMapFiber s f (f x)).card : ℝ) =
            finsetAverage (finiteMapFiber s f (f x))
              (finiteEntropyDecisionCost (finiteMapFiber s f (f x)) X is) := by
        intro x hx
        have hfiber : (finiteMapFiber s f (f x)).Nonempty :=
          ⟨x, Finset.mem_filter.mpr ⟨hx, rfl⟩⟩
        apply ih (finiteMapFiber s f (f x)) hfiber
        intro y hy z hz hcoords
        apply hinj y (Finset.mem_filter.mp hy).1 z
          (Finset.mem_filter.mp hz).1
        intro j hj
        simp only [List.mem_cons] at hj
        rcases hj with rfl | hj
        · exact (Finset.mem_filter.mp hy).2.trans
            (Finset.mem_filter.mp hz).2.symm
        · exact hcoords j hj
      have htailAverage :
          finsetAverage s
              (fun x ↦ Real.log ((finiteMapFiber s f (f x)).card : ℝ)) =
            finsetAverage s (fun x ↦
              finsetAverage (finiteMapFiber s f (f x))
                (finiteEntropyDecisionCost
                  (finiteMapFiber s f (f x)) X is)) := by
        unfold finsetAverage
        apply congrArg (fun y : ℝ ↦ y / (s.card : ℝ))
        exact Finset.sum_congr rfl htail
      have htower :
          finsetAverage s (fun x ↦
              finsetAverage (finiteMapFiber s f (f x))
                (finiteEntropyDecisionCost
                  (finiteMapFiber s f (f x)) X is)) =
            finsetAverage s (fun x ↦
              finiteEntropyDecisionCost
                (finiteMapFiber s f (f x)) X is x) := by
        simpa only [f] using
          (finsetAverage_fiber_average s f
            (fun b x ↦ finiteEntropyDecisionCost
              (finiteMapFiber s f b) X is x))
      have hsCard : (0 : ℝ) < s.card := by
        exact_mod_cast Finset.card_pos.mpr hs
      have hcost :
          finsetAverage s (finiteEntropyDecisionCost s X (i :: is)) =
            finiteUniformImageEntropy s f +
              finsetAverage s (fun x ↦
                finiteEntropyDecisionCost
                  (finiteMapFiber s f (f x)) X is x) := by
        unfold finsetAverage
        simp only [finiteEntropyDecisionCost, f, Finset.sum_add_distrib,
          Finset.sum_const, nsmul_eq_mul]
        field_simp [hsCard.ne']
      rw [hcost, ← htower, ← htailAverage]
      linarith

/-- Finite decision-tree entropy bound.  If the listed coordinates
separate the elements of `s`, the logarithm of the number of elements is
at most the average accumulated logarithmic branching cost. -/
lemma log_card_le_finsetAverage_finiteDecisionCost {α ι β : Type*}
    (s : Finset α) (X : α → ι → β) (order : List ι)
    (hs : s.Nonempty)
    (hinj : ∀ x ∈ s, ∀ y ∈ s,
      (∀ i ∈ order, X x i = X y i) → x = y) :
    Real.log (s.card : ℝ) ≤
      finsetAverage s (finiteDecisionCost s X order) := by
  classical
  induction order generalizing s with
  | nil =>
      obtain ⟨x, hx⟩ := hs
      have hsingleton : s = {x} := by
        ext y
        constructor
        · intro hy
          have hyx : y = x := hinj y hy x hx (by simp)
          simp [hyx]
        · intro hy
          rw [Finset.mem_singleton.mp hy]
          exact hx
      subst s
      simp [finiteDecisionCost, finsetAverage]
  | cons i is ih =>
      let f : α → β := fun x ↦ X x i
      have hstep := log_card_le_log_image_card_add_average_log_fiber s f hs
      have htail : ∀ x ∈ s,
          Real.log ((finiteMapFiber s f (f x)).card : ℝ) ≤
            finsetAverage (finiteMapFiber s f (f x))
              (finiteDecisionCost (finiteMapFiber s f (f x)) X is) := by
        intro x hx
        have hfiber : (finiteMapFiber s f (f x)).Nonempty :=
          ⟨x, Finset.mem_filter.mpr ⟨hx, rfl⟩⟩
        apply ih (finiteMapFiber s f (f x)) hfiber
        intro y hy z hz hcoords
        apply hinj y (Finset.mem_filter.mp hy).1 z (Finset.mem_filter.mp hz).1
        intro j hj
        simp only [List.mem_cons] at hj
        rcases hj with rfl | hj
        · exact (Finset.mem_filter.mp hy).2.trans
            (Finset.mem_filter.mp hz).2.symm
        · exact hcoords j hj
      have htailAverage :
          finsetAverage s (fun x ↦
              Real.log ((finiteMapFiber s f (f x)).card : ℝ)) ≤
            finsetAverage s (fun x ↦
              finsetAverage (finiteMapFiber s f (f x))
                (finiteDecisionCost (finiteMapFiber s f (f x)) X is)) :=
        finsetAverage_mono s _ _ htail
      have htower :
          finsetAverage s (fun x ↦
              finsetAverage (finiteMapFiber s f (f x))
                (finiteDecisionCost (finiteMapFiber s f (f x)) X is)) =
            finsetAverage s (fun x ↦
              finiteDecisionCost (finiteMapFiber s f (f x)) X is x) := by
        simpa only [f] using
          (finsetAverage_fiber_average s f
            (fun b x ↦ finiteDecisionCost (finiteMapFiber s f b) X is x))
      have hsCard : (0 : ℝ) < s.card := by
        exact_mod_cast Finset.card_pos.mpr hs
      have hcost :
          finsetAverage s (finiteDecisionCost s X (i :: is)) =
            Real.log ((s.image f).card : ℝ) +
              finsetAverage s (fun x ↦
                finiteDecisionCost (finiteMapFiber s f (f x)) X is x) := by
        unfold finsetAverage
        simp only [finiteDecisionCost, f, Finset.sum_add_distrib,
          Finset.sum_const, nsmul_eq_mul]
        field_simp [hsCard.ne']
      rw [hcost]
      have htailFinal := htailAverage.trans_eq htower
      linarith

/-! ### Perfect-matching exposure coordinates -/

/-- The unique edge of a perfect matching containing `v`.  Outside the
perfect-matching set the value is an irrelevant default; all later uses
are on members of `perfectMatchings`. -/
noncomputable def matchingEdgeAt {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n)) (v : Vertex n) : Edge n := by
  classical
  by_cases hF : F ∈ perfectMatchings n H
  · exact (existsUnique_edge_mem_of_mem_perfectMatchings hH hF v).choose
  · exact ∅

lemma matchingEdgeAt_spec {n : ℕ} {H F : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    (v : Vertex n) :
    matchingEdgeAt hH F v ∈ F ∧ v ∈ matchingEdgeAt hH F v := by
  classical
  rw [matchingEdgeAt, dif_pos hF]
  exact (existsUnique_edge_mem_of_mem_perfectMatchings hH hF v).choose_spec.1

lemma matchingEdgeAt_eq_of_mem {n : ℕ} {H F : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    {A : Edge n} {v : Vertex n} (hAF : A ∈ F) (hvA : v ∈ A) :
    matchingEdgeAt hH F v = A := by
  classical
  rw [matchingEdgeAt, dif_pos hF]
  exact ((existsUnique_edge_mem_of_mem_perfectMatchings hH hF v).choose_spec.2
    A ⟨hAF, hvA⟩).symm

/-- The edge-through-each-vertex coordinates determine a perfect
matching. -/
lemma matchingEdgeAt_injectiveOn {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) :
    Set.InjOn (fun F : Finset (Edge n) ↦ matchingEdgeAt hH F)
      (↑(perfectMatchings n H) : Set (Finset (Edge n))) := by
  intro F hF G hG heq
  apply Finset.Subset.antisymm
  · intro A hAF
    have hAall : A ∈ allEdges n := hH ((mem_perfectMatchings.mp hF).1 hAF)
    have hAne : A.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hzero
      rw [hzero] at hAall
      simp at hAall
    obtain ⟨v, hvA⟩ := hAne
    have hAt := matchingEdgeAt_eq_of_mem hH hF hAF hvA
    have hcoord : matchingEdgeAt hH F v = matchingEdgeAt hH G v :=
      congrFun heq v
    rw [hAt] at hcoord
    rw [hcoord]
    exact (matchingEdgeAt_spec hH hG v).1
  · intro A hAG
    have hAall : A ∈ allEdges n := hH ((mem_perfectMatchings.mp hG).1 hAG)
    have hAne : A.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hzero
      rw [hzero] at hAall
      simp at hAall
    obtain ⟨v, hvA⟩ := hAne
    have hAt := matchingEdgeAt_eq_of_mem hH hG hAG hvA
    have hcoord : matchingEdgeAt hH F v = matchingEdgeAt hH G v :=
      congrFun heq v
    have hcoordA : matchingEdgeAt hH F v = A := hcoord.trans hAt
    rw [← hcoordA]
    exact (matchingEdgeAt_spec hH hF v).1

/-- Vertex order associated with a permutation of the labelled vertex
set. -/
def vertexExposureOrder {n : ℕ} (perm : Equiv.Perm (Vertex n)) :
    List (Vertex n) :=
  List.ofFn perm

lemma mem_vertexExposureOrder {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) : v ∈ vertexExposureOrder perm := by
  rw [vertexExposureOrder, List.mem_ofFn]
  exact ⟨perm.symm v, perm.apply_symm_apply v⟩

lemma nodup_vertexExposureOrder {n : ℕ} (perm : Equiv.Perm (Vertex n)) :
    (vertexExposureOrder perm).Nodup := by
  rw [vertexExposureOrder, List.nodup_ofFn]
  exact perm.injective

/-- Position of a vertex in the order represented by `perm`. -/
def permutationPosition {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) : ℕ :=
  (perm.symm v).val

/-- Vertices strictly preceding `v` in a permutation order. -/
def permutationPrior {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) : List (Vertex n) :=
  (vertexExposureOrder perm).take (permutationPosition perm v)

/-- Relabel the values of a permutation by a transposition. -/
def swapPermutationLabels {α : Type*} (a b : α) :
    Equiv.Perm α ≃ Equiv.Perm α where
  toFun perm := perm.trans (Equiv.swap a b)
  invFun perm := perm.trans (Equiv.swap a b)
  left_inv perm := by
    ext x
    simp
  right_inv perm := by
    ext x
    simp

lemma permutationPosition_swapPermutationLabels {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (a b x : Vertex n) :
    permutationPosition (swapPermutationLabels a b perm) x =
      permutationPosition perm
        ((@Equiv.swap (Vertex n) (Classical.decEq _) a b) x) := by
  simp [permutationPosition, swapPermutationLabels]

/-- A labelled vertex is first among three specified distinct vertices. -/
def permutationTripleFirst {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (a b c : Vertex n) : Prop :=
  permutationPosition perm a < permutationPosition perm b ∧
    permutationPosition perm a < permutationPosition perm c

lemma permutationTripleFirst_swap {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (a b c : Vertex n)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    permutationTripleFirst (swapPermutationLabels a b perm) b a c ↔
      permutationTripleFirst perm a b c := by
  have hright :
      (@Equiv.swap (Vertex n) (Classical.decEq _) a b) b = a :=
    @Equiv.swap_apply_right (Vertex n) (Classical.decEq _) a b
  have hleft :
      (@Equiv.swap (Vertex n) (Classical.decEq _) a b) a = b :=
    @Equiv.swap_apply_left (Vertex n) (Classical.decEq _) a b
  have hfix :
      (@Equiv.swap (Vertex n) (Classical.decEq _) a b) c = c :=
    @Equiv.swap_apply_of_ne_of_ne (Vertex n) (Classical.decEq _)
      a b c hac.symm hbc.symm
  rw [permutationTripleFirst, permutationTripleFirst,
    permutationPosition_swapPermutationLabels,
    permutationPosition_swapPermutationLabels,
    permutationPosition_swapPermutationLabels,
    hright, hleft, hfix]

lemma permutationTripleFirst_partner_comm {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (a b c : Vertex n) :
    permutationTripleFirst perm a b c ↔
      permutationTripleFirst perm a c b := by
  unfold permutationTripleFirst
  tauto

/-- The three possible first vertices partition the permutation space,
and symmetry makes their cardinalities equal. -/
lemma three_mul_card_permutationTripleFirst {n : ℕ}
    (a b c : Vertex n) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ permutationTripleFirst perm a b c)).card =
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
  classical
  let U := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let Ea := U.filter (fun perm ↦ permutationTripleFirst perm a b c)
  let Eb := U.filter (fun perm ↦ permutationTripleFirst perm b a c)
  let Ec := U.filter (fun perm ↦ permutationTripleFirst perm c a b)
  have hposne : ∀ perm : Equiv.Perm (Vertex n),
      permutationPosition perm a ≠ permutationPosition perm b ∧
      permutationPosition perm a ≠ permutationPosition perm c ∧
      permutationPosition perm b ≠ permutationPosition perm c := by
    intro perm
    constructor
    · intro h
      apply hab
      apply perm.symm.injective
      exact Fin.ext h
    constructor
    · intro h
      apply hac
      apply perm.symm.injective
      exact Fin.ext h
    · intro h
      apply hbc
      apply perm.symm.injective
      exact Fin.ext h
  have hEaEb : Ea.card = Eb.card := by
    apply Finset.card_bij (fun perm hperm ↦ swapPermutationLabels a b perm)
    · intro perm hperm
      simp only [Ea, Finset.mem_filter] at hperm
      simp only [Eb, Finset.mem_filter]
      exact ⟨Finset.mem_univ _,
        (permutationTripleFirst_swap perm a b c hab hac hbc).2 hperm.2⟩
    · intro p hp q hq heq
      exact (swapPermutationLabels a b).injective heq
    · intro perm hperm
      refine ⟨swapPermutationLabels a b perm, ?_, ?_⟩
      · simp only [Eb, Finset.mem_filter] at hperm
        simp only [Ea, Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_⟩
        apply (permutationTripleFirst_swap
          (swapPermutationLabels a b perm) a b c hab hac hbc).1
        have hinvol : swapPermutationLabels a b
            (swapPermutationLabels a b perm) = perm := by
          ext x
          simp [swapPermutationLabels]
        simpa only [hinvol] using hperm.2
      · ext x
        simp [swapPermutationLabels]
  have hEaEc : Ea.card = Ec.card := by
    apply Finset.card_bij (fun perm hperm ↦ swapPermutationLabels a c perm)
    · intro perm hperm
      simp only [Ea, Finset.mem_filter] at hperm
      simp only [Ec, Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_⟩
      have hswap := permutationTripleFirst_swap perm a c b hac hab hbc.symm
      exact hswap.2 ((permutationTripleFirst_partner_comm perm a b c).1 hperm.2)
    · intro p hp q hq heq
      exact (swapPermutationLabels a c).injective heq
    · intro perm hperm
      refine ⟨swapPermutationLabels a c perm, ?_, ?_⟩
      · simp only [Ec, Finset.mem_filter] at hperm
        simp only [Ea, Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_⟩
        apply (permutationTripleFirst_partner_comm
          (swapPermutationLabels a c perm) a c b).1
        apply (permutationTripleFirst_swap
          (swapPermutationLabels a c perm) a c b hac hab hbc.symm).1
        have hinvol : swapPermutationLabels a c
            (swapPermutationLabels a c perm) = perm := by
          ext x
          simp [swapPermutationLabels]
        simpa only [hinvol] using hperm.2
      · ext x
        simp [swapPermutationLabels]
  have hcover : Ea ∪ Eb ∪ Ec = U := by
    ext perm
    simp only [Ea, Eb, Ec, U, Finset.mem_union, Finset.mem_filter,
      Finset.mem_univ, true_and]
    unfold permutationTripleFirst
    have hne := hposne perm
    constructor
    · intro h
      trivial
    · intro h
      rcases lt_or_gt_of_ne hne.1 with habpos | hbapos
      · by_cases hacpos :
            permutationPosition perm a < permutationPosition perm c
        · exact Or.inl (Or.inl ⟨habpos, hacpos⟩)
        · exact Or.inr ⟨by omega, by omega⟩
      · by_cases hbcpos :
            permutationPosition perm b < permutationPosition perm c
        · exact Or.inl (Or.inr ⟨hbapos, hbcpos⟩)
        · exact Or.inr ⟨by omega, by omega⟩
  have habDisj : Disjoint Ea Eb := by
    rw [Finset.disjoint_left]
    intro perm hpa hpb
    simp only [Ea, Finset.mem_filter] at hpa
    simp only [Eb, Finset.mem_filter] at hpb
    unfold permutationTripleFirst at hpa hpb
    omega
  have hacDisj : Disjoint (Ea ∪ Eb) Ec := by
    rw [Finset.disjoint_left]
    intro perm hp hpc
    rw [Finset.mem_union] at hp
    simp only [Ec, Finset.mem_filter] at hpc
    rcases hp with hpa | hpb
    · simp only [Ea, Finset.mem_filter] at hpa
      unfold permutationTripleFirst at hpa hpc
      omega
    · simp only [Eb, Finset.mem_filter] at hpb
      unfold permutationTripleFirst at hpb hpc
      omega
  have hcard := congrArg Finset.card hcover
  rw [Finset.card_union_of_disjoint hacDisj,
    Finset.card_union_of_disjoint habDisj] at hcard
  change 3 * Ea.card = U.card
  omega

@[simp] lemma length_vertexExposureOrder {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) :
    (vertexExposureOrder perm).length = 3 * n := by
  simp [vertexExposureOrder]

lemma getElem_vertexExposureOrder {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (i : ℕ) (hi : i < 3 * n) :
    (vertexExposureOrder perm)[i]'(by
      simpa [length_vertexExposureOrder] using hi) = perm ⟨i, hi⟩ := by
  simp [vertexExposureOrder]

lemma mem_permutationPrior_iff {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (u v : Vertex n) :
    u ∈ permutationPrior perm v ↔
      permutationPosition perm u < permutationPosition perm v := by
  rw [permutationPrior, List.mem_take_iff_getElem]
  constructor
  · rintro ⟨j, hj, hju⟩
    have hvpos : permutationPosition perm v < 3 * n :=
      (perm.symm v).isLt
    have hj' : j < permutationPosition perm v := by
      simpa [length_vertexExposureOrder, Nat.min_eq_left hvpos.le]
        using hj
    have hjV : j < 3 * n := hj'.trans hvpos
    rw [getElem_vertexExposureOrder perm j hjV] at hju
    have hpre : (⟨j, hjV⟩ : Vertex n) = perm.symm u := by
      apply perm.injective
      simpa using hju
    have hval : j = permutationPosition perm u :=
      congrArg Fin.val hpre
    simpa [hval] using hj'
  · intro huv
    have hupos : permutationPosition perm u < 3 * n :=
      (perm.symm u).isLt
    have hvpos : permutationPosition perm v < 3 * n :=
      (perm.symm v).isLt
    refine ⟨permutationPosition perm u, ?_, ?_⟩
    · simpa [length_vertexExposureOrder, Nat.min_eq_left hvpos.le]
        using huv
    · rw [getElem_vertexExposureOrder perm (permutationPosition perm u) hupos]
      exact perm.apply_symm_apply u

/-- For every fixed vertex order, the perfect-matching count is bounded
by the average decision-tree exposure cost. -/
lemma log_card_perfectMatchings_le_exposureCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (perm : Equiv.Perm (Vertex n)) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      finsetAverage (perfectMatchings n H)
        (finiteDecisionCost (perfectMatchings n H)
          (fun F v ↦ matchingEdgeAt hH F v) (vertexExposureOrder perm)) := by
  apply log_card_le_finsetAverage_finiteDecisionCost
  · exact Finset.card_ne_zero.mp hΦ
  · intro F hF G hG hcoords
    apply matchingEdgeAt_injectiveOn hH hF hG
    funext v
    exact hcoords v (mem_vertexExposureOrder perm v)

/-- Exact chain-rule version of the matching exposure identity for a fixed
vertex permutation. -/
lemma log_card_perfectMatchings_eq_average_entropyExposureCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (perm : Equiv.Perm (Vertex n)) :
    Real.log ((perfectMatchings n H).card : ℝ) =
      finsetAverage (perfectMatchings n H)
        (finiteEntropyDecisionCost (perfectMatchings n H)
          (fun F v ↦ matchingEdgeAt hH F v) (vertexExposureOrder perm)) := by
  apply log_card_eq_finsetAverage_finiteEntropyDecisionCost
  · exact Finset.card_ne_zero.mp hΦ
  · intro F hF G hG hcoords
    apply matchingEdgeAt_injectiveOn hH hF hG
    funext v
    exact hcoords v (mem_vertexExposureOrder perm v)

/-- Kahn's equation (29) at the finite counting level, averaged over all
vertex permutations. -/
lemma log_card_perfectMatchings_eq_average_permutation_entropyExposureCost
    {n : ℕ} {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    Real.log ((perfectMatchings n H).card : ℝ) =
      finsetAverage (Finset.univ : Finset (Equiv.Perm (Vertex n)))
        (fun perm ↦ finsetAverage (perfectMatchings n H)
          (finiteEntropyDecisionCost (perfectMatchings n H)
            (fun F v ↦ matchingEdgeAt hH F v)
            (vertexExposureOrder perm))) := by
  let Q : Equiv.Perm (Vertex n) → ℝ := fun perm ↦
    finsetAverage (perfectMatchings n H)
      (finiteEntropyDecisionCost (perfectMatchings n H)
        (fun F v ↦ matchingEdgeAt hH F v)
        (vertexExposureOrder perm))
  have hpermNonempty :
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).Nonempty := by
    exact ⟨Equiv.refl _, Finset.mem_univ _⟩
  have hpoint : ∀ perm ∈
      (Finset.univ : Finset (Equiv.Perm (Vertex n))),
      Q perm = Real.log ((perfectMatchings n H).card : ℝ) := by
    intro perm hperm
    dsimp only [Q]
    exact (log_card_perfectMatchings_eq_average_entropyExposureCost
      hH hΦ perm).symm
  change Real.log ((perfectMatchings n H).card : ℝ) =
    (∑ perm ∈ (Finset.univ : Finset (Equiv.Perm (Vertex n))), Q perm) /
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).card : ℝ)
  rw [Finset.sum_congr rfl hpoint]
  have hcard : (0 : ℝ) <
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
    exact_mod_cast Finset.card_pos.mpr hpermNonempty
  simp only [Finset.sum_const, nsmul_eq_mul]
  field_simp [hcard.ne']

/-! ### Kahn's coarser availability variable -/

/-- The exposed matching-edge values, as a list, for an arbitrary prefix
of vertices. -/
def matchingPrefixCode {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (prior : List (Vertex n))
    (F : Finset (Edge n)) : List (Edge n) :=
  finitePrefixCode (fun G v ↦ matchingEdgeAt hH G v) prior F

/-- A vertex has already been exposed exactly when it belongs to one of
the edge values in the prefix code. -/
def matchingKahnPreviouslyExposed {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (prior : List (Vertex n)) (v : Vertex n) : Prop :=
  ∃ A ∈ matchingPrefixCode hH prior F, v ∈ A

/-- Vertices still available after the matching edges in the prefix code
have been exposed, with `v` itself removed. -/
def matchingKahnAvailableVertices {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (prior : List (Vertex n)) (v : Vertex n) : Finset (Vertex n) :=
  ((Finset.univ : Finset (Vertex n)).erase v) \
    (matchingPrefixCode hH prior F).toFinset.biUnion id

/-- The distinguished vertex is first among the three vertices of its
matching edge in the permutation order. -/
def matchingVertexFirst {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (perm : Equiv.Perm (Vertex n)) (v : Vertex n) : Prop :=
  ∀ u ∈ (matchingEdgeAt hH F v).erase v,
    permutationPosition perm v < permutationPosition perm u

lemma not_matchingKahnPreviouslyExposed_iff_vertexFirst {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H)
    (perm : Equiv.Perm (Vertex n)) (v : Vertex n) :
    ¬matchingKahnPreviouslyExposed hH F (permutationPrior perm v) v ↔
      matchingVertexFirst hH F perm v := by
  constructor
  · intro hnot u hu
    have huv : u ≠ v := (Finset.mem_erase.mp hu).1
    have huEdge : u ∈ matchingEdgeAt hH F v :=
      (Finset.mem_erase.mp hu).2
    have hposne : permutationPosition perm u ≠
        permutationPosition perm v := by
      intro hpos
      have hfin : perm.symm u = perm.symm v := by
        apply Fin.ext
        exact hpos
      exact huv (perm.symm.injective hfin)
    by_contra hfirst
    have huprev : permutationPosition perm u <
        permutationPosition perm v := by omega
    have huprior : u ∈ permutationPrior perm v :=
      (mem_permutationPrior_iff perm u v).2 huprev
    have hAuF : matchingEdgeAt hH F v ∈ F :=
      (matchingEdgeAt_spec hH hF v).1
    have hEq : matchingEdgeAt hH F u = matchingEdgeAt hH F v :=
      matchingEdgeAt_eq_of_mem hH hF hAuF huEdge
    apply hnot
    refine ⟨matchingEdgeAt hH F v, ?_,
      (matchingEdgeAt_spec hH hF v).2⟩
    unfold matchingPrefixCode finitePrefixCode
    exact List.mem_map.mpr ⟨u, huprior, hEq⟩
  · intro hfirst hprev
    rcases hprev with ⟨A, hAcode, hvA⟩
    unfold matchingPrefixCode finitePrefixCode at hAcode
    rcases List.mem_map.mp hAcode with ⟨u, huprior, hAu⟩
    change matchingEdgeAt hH F u = A at hAu
    have huA : u ∈ A := by
      rw [← hAu]
      exact (matchingEdgeAt_spec hH hF u).2
    have huv : u ≠ v := by
      intro huv
      subst u
      have hlt := (mem_permutationPrior_iff perm v v).1 huprior
      exact (Nat.lt_irrefl _ hlt)
    have huPartner : u ∈ (matchingEdgeAt hH F v).erase v := by
      apply Finset.mem_erase.mpr
      refine ⟨huv, ?_⟩
      have hAF : A ∈ F := by
        rw [← hAu]
        exact (matchingEdgeAt_spec hH hF u).1
      have hAv : matchingEdgeAt hH F v = A :=
        matchingEdgeAt_eq_of_mem hH hF hAF hvA
      rw [hAv]
      exact huA
    have hvu := hfirst u huPartner
    have huvpos := (mem_permutationPrior_iff perm u v).1 huprior
    omega

/-- For a fixed perfect matching and vertex, exactly one third of all
vertex permutations expose that vertex first in its matching edge. -/
lemma three_mul_card_matchingVertexFirst {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n) :
    3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v)).card =
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
  have hAcard : (matchingEdgeAt hH F v).card = 3 := by
    exact mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1
      (matchingEdgeAt_spec hH hF v).1))
  have hvA := (matchingEdgeAt_spec hH hF v).2
  have hEraseCard : ((matchingEdgeAt hH F v).erase v).card = 2 := by
    rw [Finset.card_erase_of_mem hvA, hAcard]
  obtain ⟨y, z, hyz, hErase⟩ := Finset.card_eq_two.mp hEraseCard
  have hyv : y ≠ v := by
    have hy : y ∈ (matchingEdgeAt hH F v).erase v := by rw [hErase]; simp
    exact (Finset.mem_erase.mp hy).1
  have hzv : z ≠ v := by
    have hz : z ∈ (matchingEdgeAt hH F v).erase v := by rw [hErase]; simp
    exact (Finset.mem_erase.mp hz).1
  have hevent :
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
          (fun perm ↦ matchingVertexFirst hH F perm v) =
        (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
          (fun perm ↦ permutationTripleFirst perm v y z) := by
    ext perm
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [matchingVertexFirst, hErase]
    simp [permutationTripleFirst, and_comm]
  rw [hevent]
  exact three_mul_card_permutationTripleFirst v y z hyv.symm hzv.symm hyz

/-- Swap two disjoint finite sets pointwise through an arbitrary bijection. -/
noncomputable def swapFinsetBlocks {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B) :
    Equiv.Perm α := by
  classical
  let e : ↥A ≃ ↥B := A.equivOfCardEq hcard
  let f : α → α := fun x ↦
    if hxA : x ∈ A then e ⟨x, hxA⟩
    else if hxB : x ∈ B then e.symm ⟨x, hxB⟩
    else x
  refine
    { toFun := f
      invFun := f
      left_inv := ?_
      right_inv := ?_ }
  · intro x
    by_cases hxA : x ∈ A
    · have heB : (e ⟨x, hxA⟩ : α) ∈ B := (e ⟨x, hxA⟩).2
      have heA : (e ⟨x, hxA⟩ : α) ∉ A := by
        exact fun h ↦ Finset.disjoint_left.mp hdisj h heB
      simp only [f, dif_pos hxA, dif_neg heA, dif_pos heB]
      exact congrArg Subtype.val (e.symm_apply_apply ⟨x, hxA⟩)
    · by_cases hxB : x ∈ B
      · have heA : (e.symm ⟨x, hxB⟩ : α) ∈ A := (e.symm ⟨x, hxB⟩).2
        have heB : (e.symm ⟨x, hxB⟩ : α) ∉ B := by
          exact fun h ↦ Finset.disjoint_left.mp hdisj heA h
        simp only [f, dif_neg hxA, dif_pos hxB, dif_pos heA]
        exact congrArg Subtype.val (e.apply_symm_apply ⟨x, hxB⟩)
      · simp [f, hxA, hxB]
  · intro x
    by_cases hxA : x ∈ A
    · have heB : (e ⟨x, hxA⟩ : α) ∈ B := (e ⟨x, hxA⟩).2
      have heA : (e ⟨x, hxA⟩ : α) ∉ A := by
        exact fun h ↦ Finset.disjoint_left.mp hdisj h heB
      simp only [f, dif_pos hxA, dif_neg heA, dif_pos heB]
      exact congrArg Subtype.val (e.symm_apply_apply ⟨x, hxA⟩)
    · by_cases hxB : x ∈ B
      · have heA : (e.symm ⟨x, hxB⟩ : α) ∈ A := (e.symm ⟨x, hxB⟩).2
        have heB : (e.symm ⟨x, hxB⟩ : α) ∉ B := by
          exact fun h ↦ Finset.disjoint_left.mp hdisj heA h
        simp only [f, dif_neg hxA, dif_pos hxB, dif_pos heA]
        exact congrArg Subtype.val (e.apply_symm_apply ⟨x, hxB⟩)
      · simp [f, hxA, hxB]

lemma swapFinsetBlocks_apply_mem_left {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B)
    {x : α} (hx : x ∈ A) :
    swapFinsetBlocks A B hcard hdisj x ∈ B := by
  classical
  change (if hxA : x ∈ A then
      (A.equivOfCardEq hcard ⟨x, hxA⟩ : α)
    else if hxB : x ∈ B then
      ((A.equivOfCardEq hcard).symm ⟨x, hxB⟩ : α)
    else x) ∈ B
  rw [dif_pos hx]
  exact (A.equivOfCardEq hcard ⟨x, hx⟩).2

lemma swapFinsetBlocks_apply_mem_right {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B)
    {x : α} (hx : x ∈ B) :
    swapFinsetBlocks A B hcard hdisj x ∈ A := by
  classical
  have hxA : x ∉ A := fun h ↦ Finset.disjoint_left.mp hdisj h hx
  change (if hxA : x ∈ A then
      (A.equivOfCardEq hcard ⟨x, hxA⟩ : α)
    else if hxB : x ∈ B then
      ((A.equivOfCardEq hcard).symm ⟨x, hxB⟩ : α)
    else x) ∈ A
  rw [dif_neg hxA, dif_pos hx]
  exact ((A.equivOfCardEq hcard).symm ⟨x, hx⟩).2

lemma swapFinsetBlocks_apply_not_mem {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B)
    {x : α} (hxA : x ∉ A) (hxB : x ∉ B) :
    swapFinsetBlocks A B hcard hdisj x = x := by
  classical
  simp [swapFinsetBlocks, hxA, hxB]

/-- Positions occupied by a finite vertex set in a permutation. -/
def permutationPositions {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (A : Edge n) : Finset (Vertex n) :=
  A.map perm.symm.toEmbedding

lemma mem_permutationPositions_iff {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (A : Edge n) (i : Vertex n) :
    i ∈ permutationPositions perm A ↔ perm i ∈ A := by
  simp [permutationPositions]

/-- First position occupied by an edge, totalized at zero for the empty edge. -/
noncomputable def edgeFirstPosition {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) (A : Edge n) : ℕ := by
  classical
  by_cases hA : A.Nonempty
  · exact ((permutationPositions perm A).min' hA.map).val
  · exact 0

lemma exists_mem_edgeFirstPosition {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) {A : Edge n} (hA : A.Nonempty) :
    ∃ x ∈ A, permutationPosition perm x = edgeFirstPosition perm A := by
  classical
  let i := (permutationPositions perm A).min' hA.map
  have hi : i ∈ permutationPositions perm A := Finset.min'_mem _ _
  refine ⟨perm i, (mem_permutationPositions_iff perm A i).1 hi, ?_⟩
  rw [edgeFirstPosition, dif_pos hA]
  simp [permutationPosition, i]

lemma edgeFirstPosition_le_of_mem {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) {A : Edge n} (hA : A.Nonempty)
    {x : Vertex n} (hx : x ∈ A) :
    edgeFirstPosition perm A ≤ (perm.symm x).val := by
  classical
  rw [edgeFirstPosition, dif_pos hA]
  exact_mod_cast (Finset.min'_le _ _
    (show perm.symm x ∈ permutationPositions perm A from
      Finset.mem_map.mpr ⟨x, hx, rfl⟩))

lemma edgeFirstPosition_ne_of_disjoint {n : ℕ}
    (perm : Equiv.Perm (Vertex n)) {A B : Edge n}
    (hA : A.Nonempty) (hB : B.Nonempty) (hAB : Disjoint A B) :
    edgeFirstPosition perm A ≠ edgeFirstPosition perm B := by
  obtain ⟨x, hxA, hx⟩ := exists_mem_edgeFirstPosition perm hA
  obtain ⟨y, hyB, hy⟩ := exists_mem_edgeFirstPosition perm hB
  intro heq
  have hpos : permutationPosition perm x = permutationPosition perm y := by
    rw [hx, hy, heq]
  have hpre : perm.symm x = perm.symm y := by
    apply Fin.ext
    exact hpos
  have hxy : x = y := perm.symm.injective hpre
  exact Finset.disjoint_left.mp hAB hxA (hxy ▸ hyB)

/-- Number of elements of `s` whose key is strictly below the key at `x`. -/
def finiteRank {α β : Type*} [DecidableEq α] [LinearOrder β]
    (s : Finset α) (f : α → β) (x : α) : ℕ :=
  (s.filter fun y ↦ f y < f x).card

lemma card_filter_lt_orderEmbOfFin {α : Type*} [LinearOrder α]
    (s : Finset α) {m : ℕ} (hcard : s.card = m) (i : Fin m) :
    (s.filter fun x ↦ x < s.orderEmbOfFin hcard i).card = i.val := by
  rw [← Fin.card_Iio i]
  apply Finset.card_bij (fun x hx ↦
    (s.orderIsoOfFin hcard).symm
      ⟨x, (Finset.mem_filter.mp hx).1⟩)
  · intro x hx
    have hlt := (Finset.mem_filter.mp hx).2
    have hrepr := (s.orderIsoOfFin hcard).apply_symm_apply
      ⟨x, (Finset.mem_filter.mp hx).1⟩
    simp only [Finset.mem_Iio]
    rw [← (s.orderIsoOfFin hcard).lt_iff_lt]
    rw [hrepr]
    exact hlt
  · intro x hx y hy heq
    have hsub : (⟨x, (Finset.mem_filter.mp hx).1⟩ : s) =
        ⟨y, (Finset.mem_filter.mp hy).1⟩ :=
      (s.orderIsoOfFin hcard).symm.injective heq
    exact congrArg Subtype.val hsub
  · intro j hj
    let x : α := s.orderIsoOfFin hcard j
    have hxS : x ∈ s := (s.orderIsoOfFin hcard j).2
    have hxlt : x < s.orderEmbOfFin hcard i := by
      exact (s.orderIsoOfFin hcard).lt_iff_lt.mpr
        (Finset.mem_Iio.mp hj)
    refine ⟨x, Finset.mem_filter.mpr ⟨hxS, hxlt⟩, ?_⟩
    exact (s.orderIsoOfFin hcard).symm_apply_apply j

lemma existsUnique_finiteRank_eq {α β : Type*}
    [DecidableEq α] [LinearOrder β]
    (s : Finset α) (f : α → β)
    (hinj : Set.InjOn f (↑s : Set α)) {j : ℕ} (hj : j < s.card) :
    ∃! x, x ∈ s ∧ finiteRank s f x = j := by
  let T := s.image f
  have hTcard : T.card = s.card := Finset.card_image_iff.mpr hinj
  let y : β := T.orderEmbOfFin hTcard ⟨j, hj⟩
  have hyT : y ∈ T := T.orderEmbOfFin_mem hTcard ⟨j, hj⟩
  rcases Finset.mem_image.mp hyT with ⟨x, hxS, hfx⟩
  have hxrank : finiteRank s f x = j := by
    let U := s.filter fun z ↦ f z < f x
    have hfilter : U.image f =
        T.filter fun z ↦ z < y := by
      ext z
      simp only [U, Finset.mem_image, Finset.mem_filter]
      constructor
      · rintro ⟨w, ⟨hwS, hwlt⟩, rfl⟩
        exact ⟨Finset.mem_image.mpr ⟨w, hwS, rfl⟩, by simpa [hfx] using hwlt⟩
      · rintro ⟨hzT, hzlt⟩
        rcases Finset.mem_image.mp hzT with ⟨w, hwS, rfl⟩
        refine ⟨w, ⟨hwS, ?_⟩, rfl⟩
        simpa [hfx] using hzlt
    have himageCard : (U.image f).card = U.card := by
      rw [Finset.card_image_iff]
      intro a ha b hb hab
      exact hinj (Finset.mem_filter.mp ha).1 (Finset.mem_filter.mp hb).1 hab
    change U.card = j
    calc
      U.card = (U.image f).card := himageCard.symm
      _ = (T.filter fun z ↦ z < y).card := congrArg Finset.card hfilter
      _ = j := card_filter_lt_orderEmbOfFin T hTcard ⟨j, hj⟩
  refine ⟨x, ⟨hxS, hxrank⟩, ?_⟩
  · intro z hz
    rcases hz with ⟨hzS, hzrank⟩
    symm
    apply hinj hxS hzS
    by_contra hfne
    rcases lt_or_gt_of_ne hfne with hlt | hgt
    · have hsub : (s.filter fun w ↦ f w < f x) ∪ {x} ⊆
          s.filter fun w ↦ f w < f z := by
        intro w hw
        simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_singleton] at hw ⊢
        rcases hw with hw | rfl
        · exact ⟨hw.1, hw.2.trans hlt⟩
        · exact ⟨hxS, hlt⟩
      have hxnot : x ∉ s.filter fun w ↦ f w < f x := by simp
      have hcardle := Finset.card_le_card hsub
      rw [Finset.card_union_of_disjoint] at hcardle
      · have hr : finiteRank s f x + 1 ≤ finiteRank s f z := by
          simpa only [finiteRank, Finset.card_singleton, Nat.add_comm]
            using hcardle
        omega
      · exact Finset.disjoint_singleton_right.mpr hxnot
    · have hsub : (s.filter fun w ↦ f w < f z) ∪ {z} ⊆
          s.filter fun w ↦ f w < f x := by
        intro w hw
        simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_singleton] at hw ⊢
        rcases hw with hw | rfl
        · exact ⟨hw.1, hw.2.trans hgt⟩
        · exact ⟨hzS, hgt⟩
      have hznot : z ∉ s.filter fun w ↦ f w < f z := by simp
      have hcardle := Finset.card_le_card hsub
      rw [Finset.card_union_of_disjoint] at hcardle
      · have hr : finiteRank s f z + 1 ≤ finiteRank s f x := by
          simpa only [finiteRank, Finset.card_singleton, Nat.add_comm]
            using hcardle
        omega
      · exact Finset.disjoint_singleton_right.mpr hznot

/-- Rank of a matching edge by the first vertex at which it is exposed. -/
def matchingEdgeRank {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (F : Finset (Edge n)) (A : Edge n) : ℕ :=
  finiteRank F (edgeFirstPosition perm) A

lemma matchingEdgeFirstPosition_injectiveOn {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n)) :
    Set.InjOn (edgeFirstPosition perm) (↑F : Set (Edge n)) := by
  intro A hAF B hBF heq
  by_contra hAB
  have hAcard : A.card = 3 :=
    mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1 hAF))
  have hBcard : B.card = 3 :=
    mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1 hBF))
  have hAne : A.Nonempty := Finset.card_pos.mp (by omega)
  have hBne : B.Nonempty := Finset.card_pos.mp (by omega)
  exact edgeFirstPosition_ne_of_disjoint perm hAne hBne
    ((mem_perfectMatchings.mp hF).2.2 hAF hBF hAB) heq

/-- Every rank from zero through `n-1` is occupied by exactly one edge of
a fixed perfect matching. -/
lemma existsUnique_matchingEdgeRank_eq {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    {j : ℕ} (hj : j < n) :
    ∃! A, A ∈ F ∧ matchingEdgeRank perm F A = j := by
  unfold matchingEdgeRank
  apply existsUnique_finiteRank_eq F (edgeFirstPosition perm)
    (matchingEdgeFirstPosition_injectiveOn hH hF perm)
  simpa [(mem_perfectMatchings.mp hF).2.1] using hj

/-- Matching edges exposed strictly after `A`. -/
def matchingEdgesAfter {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (F : Finset (Edge n)) (A : Edge n) : Finset (Edge n) :=
  F.filter fun B ↦ edgeFirstPosition perm A < edgeFirstPosition perm B

lemma card_matchingEdgesAfter {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    {A : Edge n} (hAF : A ∈ F) :
    (matchingEdgesAfter perm F A).card =
      n - matchingEdgeRank perm F A - 1 := by
  let before := F.filter fun B ↦
    edgeFirstPosition perm B < edgeFirstPosition perm A
  let after := matchingEdgesAfter perm F A
  have hinj := matchingEdgeFirstPosition_injectiveOn hH hF perm
  have hpartition : F = before ∪ {A} ∪ after := by
    ext B
    simp only [before, after, matchingEdgesAfter, Finset.mem_union,
      Finset.mem_filter, Finset.mem_singleton]
    constructor
    · intro hBF
      by_cases hBA : B = A
      · exact Or.inl (Or.inr hBA)
      · have hne : edgeFirstPosition perm B ≠ edgeFirstPosition perm A :=
          fun heq ↦ hBA (hinj hBF hAF heq)
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · exact Or.inl (Or.inl ⟨hBF, hlt⟩)
        · exact Or.inr ⟨hBF, hgt⟩
    · rintro ((h | h) | h)
      · exact h.1
      · subst B
        exact hAF
      · exact h.1
  have hdisjBeforeA : Disjoint before {A} := by
    rw [Finset.disjoint_singleton_right]
    simp [before]
  have hdisjBeforeAfter : Disjoint before after := by
    rw [Finset.disjoint_left]
    intro B hBbefore hBafter
    have hlt := (Finset.mem_filter.mp hBbefore).2
    have hgt := (Finset.mem_filter.mp hBafter).2
    omega
  have hdisjAAfter : Disjoint ({A} : Finset (Edge n)) after := by
    rw [Finset.disjoint_singleton_left]
    simp [after, matchingEdgesAfter]
  have hcardEq : F.card = before.card + 1 + after.card := by
    calc
      F.card = (before ∪ {A} ∪ after).card := congrArg Finset.card hpartition
      _ = (before ∪ {A}).card + after.card := by
        rw [Finset.card_union_of_disjoint]
        rw [Finset.disjoint_union_left]
        exact ⟨hdisjBeforeAfter, hdisjAAfter⟩
      _ = before.card + 1 + after.card := by
        rw [Finset.card_union_of_disjoint hdisjBeforeA]
        simp
  have hFcard : F.card = n := (mem_perfectMatchings.mp hF).2.1
  have hbefore : before.card = matchingEdgeRank perm F A := by
    unfold matchingEdgeRank finiteRank
    exact congrArg Finset.card
      (@Finset.filter_congr_decidable _ F
        (fun B ↦ edgeFirstPosition perm B < edgeFirstPosition perm A)
        (fun B ↦ (edgeFirstPosition perm B).decLt
          (edgeFirstPosition perm A))
        (Classical.decPred _))
  have hafter : after.card = (matchingEdgesAfter perm F A).card := by
    rfl
  rw [hFcard, hbefore, hafter] at hcardEq
  omega

/-- Right composition relabels the values of a vertex permutation. -/
def relabelPermutation {α : Type*} (g : Equiv.Perm α) :
    Equiv.Perm α ≃ Equiv.Perm α where
  toFun perm := perm.trans g
  invFun perm := perm.trans g.symm
  left_inv perm := by ext; simp
  right_inv perm := by ext; simp

lemma permutationPositions_trans {n : ℕ}
    (perm g : Equiv.Perm (Vertex n)) (A : Edge n) :
    permutationPositions (perm.trans g) A =
      permutationPositions perm (g.symm.finsetCongr A) := by
  ext i
  simp [mem_permutationPositions_iff, Equiv.finsetCongr_apply]

lemma edgeFirstPosition_trans {n : ℕ}
    (perm g : Equiv.Perm (Vertex n)) {A : Edge n} (hA : A.Nonempty) :
    edgeFirstPosition (perm.trans g) A =
      edgeFirstPosition perm (g.symm.finsetCongr A) := by
  let S := permutationPositions (perm.trans g) A
  let T := permutationPositions perm (g.symm.finsetCongr A)
  have hS : S.Nonempty := by
    dsimp only [S, permutationPositions]
    exact hA.map
  have hT : T.Nonempty := by
    dsimp only [T, permutationPositions, Equiv.finsetCongr_apply]
    exact hA.map.map
  have hST : S = T := permutationPositions_trans perm g A
  rw [edgeFirstPosition, dif_pos hA, edgeFirstPosition,
    dif_pos (show (g.symm.finsetCongr A).Nonempty by
      rw [Equiv.finsetCongr_apply]
      exact hA.map)]
  change (S.min' hS).val = (T.min' hT).val
  apply Nat.le_antisymm
  · exact_mod_cast Finset.min'_le S (T.min' hT) (by
      rw [hST]
      exact Finset.min'_mem T hT)
  · exact_mod_cast Finset.min'_le T (S.min' hS) (by
      rw [← hST]
      exact Finset.min'_mem S hS)

lemma finiteRank_comp_equiv_of_map_eq {α β : Type*}
    [DecidableEq α] [LinearOrder β]
    (s : Finset α) (f : α → β) (e : Equiv.Perm α)
    (hmap : s.map e.toEmbedding = s) (x : α) :
    finiteRank s (fun y ↦ f (e y)) x = finiteRank s f (e x) := by
  let L := s.filter fun y ↦ f (e y) < f (e x)
  let R := s.filter fun z ↦ f z < f (e x)
  have hLR : L.map e.toEmbedding = R := by
    ext z
    simp only [L, R, Finset.mem_map, Finset.mem_filter]
    constructor
    · rintro ⟨y, ⟨hyS, hylt⟩, rfl⟩
      exact ⟨by
        have : e y ∈ s.map e.toEmbedding := Finset.mem_map.mpr ⟨y, hyS, rfl⟩
        rwa [hmap] at this, hylt⟩
    · rintro ⟨hzS, hzlt⟩
      have hzMap : z ∈ s.map e.toEmbedding := by rwa [hmap]
      rcases Finset.mem_map.mp hzMap with ⟨y, hyS, rfl⟩
      exact ⟨y, ⟨hyS, hzlt⟩, rfl⟩
  have hcard : L.card = R.card := by
    rw [← Finset.card_map e.toEmbedding, hLR]
  unfold finiteRank
  simpa only [L, R] using hcard

lemma matchingEdgeRank_trans_of_map_eq {n : ℕ}
    (perm g : Equiv.Perm (Vertex n)) (F : Finset (Edge n))
    (hFnonempty : ∀ A ∈ F, A.Nonempty)
    (hmap : F.map g.symm.finsetCongr.toEmbedding = F)
    {A : Edge n} (hAF : A ∈ F) :
    matchingEdgeRank (perm.trans g) F A =
      matchingEdgeRank perm F (g.symm.finsetCongr A) := by
  unfold matchingEdgeRank
  have hpoint : ∀ B ∈ F,
      edgeFirstPosition (perm.trans g) B =
        edgeFirstPosition perm (g.symm.finsetCongr B) := by
    intro B hBF
    exact edgeFirstPosition_trans perm g (hFnonempty B hBF)
  have htarget : edgeFirstPosition (perm.trans g) A =
      edgeFirstPosition perm (g.symm.finsetCongr A) := by
    exact edgeFirstPosition_trans perm g (hFnonempty A hAF)
  calc
    finiteRank F (edgeFirstPosition (perm.trans g)) A =
        finiteRank F
          (fun B ↦ edgeFirstPosition perm (g.symm.finsetCongr B)) A := by
      unfold finiteRank
      apply congrArg Finset.card
      ext B
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨hBF, hlt⟩
        exact ⟨hBF, by simpa only [hpoint B hBF, htarget] using hlt⟩
      · rintro ⟨hBF, hlt⟩
        exact ⟨hBF, by simpa only [hpoint B hBF, htarget] using hlt⟩
    _ = finiteRank F (edgeFirstPosition perm) (g.symm.finsetCongr A) :=
      finiteRank_comp_equiv_of_map_eq F (edgeFirstPosition perm)
        g.symm.finsetCongr hmap A

@[simp] lemma swapFinsetBlocks_symm {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B) :
    (swapFinsetBlocks A B hcard hdisj).symm =
      swapFinsetBlocks A B hcard hdisj := by
  rfl

lemma swapFinsetBlocks_map_left {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B) :
    (swapFinsetBlocks A B hcard hdisj).finsetCongr A = B := by
  rw [Equiv.finsetCongr_apply]
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    rcases Finset.mem_map.mp hx with ⟨y, hyA, rfl⟩
    exact swapFinsetBlocks_apply_mem_left A B hcard hdisj hyA
  · simp [hcard]

lemma swapFinsetBlocks_map_right {α : Type*} [DecidableEq α]
    (A B : Finset α) (hcard : A.card = B.card) (hdisj : Disjoint A B) :
    (swapFinsetBlocks A B hcard hdisj).finsetCongr B = A := by
  rw [Equiv.finsetCongr_apply]
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    rcases Finset.mem_map.mp hx with ⟨y, hyB, rfl⟩
    exact swapFinsetBlocks_apply_mem_right A B hcard hdisj hyB
  · simp [hcard]

lemma swapFinsetBlocks_map_of_disjoint {α : Type*} [DecidableEq α]
    (A B C : Finset α) (hcard : A.card = B.card) (hAB : Disjoint A B)
    (hCA : Disjoint C A) (hCB : Disjoint C B) :
    (swapFinsetBlocks A B hcard hAB).finsetCongr C = C := by
  rw [Equiv.finsetCongr_apply]
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    rcases Finset.mem_map.mp hx with ⟨y, hyC, rfl⟩
    have hyA : y ∉ A := fun hy ↦ Finset.disjoint_left.mp hCA hyC hy
    have hyB : y ∉ B := fun hy ↦ Finset.disjoint_left.mp hCB hyC hy
    change swapFinsetBlocks A B hcard hAB y ∈ C
    rw [swapFinsetBlocks_apply_not_mem A B hcard hAB hyA hyB]
    exact hyC
  · simp

lemma swapMatchingEdges_map_matching {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hAB : A ≠ B)
    (hcard : A.card = B.card) (hdisj : Disjoint A B) :
    F.map (swapFinsetBlocks A B hcard hdisj).finsetCongr.toEmbedding = F := by
  apply Finset.eq_of_subset_of_card_le
  · intro C hCmap
    rcases Finset.mem_map.mp hCmap with ⟨D, hDF, rfl⟩
    by_cases hDA : D = A
    · subst D
      change (swapFinsetBlocks A B hcard hdisj).finsetCongr A ∈ F
      rw [swapFinsetBlocks_map_left A B hcard hdisj]
      exact hBF
    · by_cases hDB : D = B
      · subst D
        change (swapFinsetBlocks A B hcard hdisj).finsetCongr B ∈ F
        rw [swapFinsetBlocks_map_right A B hcard hdisj]
        exact hAF
      · have hDA' : Disjoint D A :=
          (mem_perfectMatchings.mp hF).2.2 hDF hAF hDA
        have hDB' : Disjoint D B :=
          (mem_perfectMatchings.mp hF).2.2 hDF hBF hDB
        change (swapFinsetBlocks A B hcard hdisj).finsetCongr D ∈ F
        rw [swapFinsetBlocks_map_of_disjoint
          A B D hcard hdisj hDA' hDB']
        exact hDF
  · simp

lemma matchingEdgeRank_swapMatchingEdges {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hAB : A ≠ B)
    (hcard : A.card = B.card) (hdisj : Disjoint A B)
    (perm : Equiv.Perm (Vertex n)) :
    matchingEdgeRank
      (perm.trans (swapFinsetBlocks A B hcard hdisj)) F B =
      matchingEdgeRank perm F A := by
  let g := swapFinsetBlocks A B hcard hdisj
  have hnonempty : ∀ C ∈ F, C.Nonempty := by
    intro C hCF
    have hCcard := mem_allEdges.mp
      (hH ((mem_perfectMatchings.mp hF).1 hCF))
    exact Finset.card_pos.mp (by omega)
  have hmap : F.map g.symm.finsetCongr.toEmbedding = F := by
    rw [show g.symm = g from swapFinsetBlocks_symm A B hcard hdisj]
    exact swapMatchingEdges_map_matching hH hF hAF hBF hAB hcard hdisj
  rw [matchingEdgeRank_trans_of_map_eq perm g F hnonempty hmap hBF]
  rw [show g.symm = g from swapFinsetBlocks_symm A B hcard hdisj]
  exact congrArg (matchingEdgeRank perm F)
    (swapFinsetBlocks_map_right A B hcard hdisj)

/-- For a fixed rank, any two edges of a perfect matching have equally
many realizing vertex permutations. -/
lemma card_matchingEdgeRank_eq_edge_independent {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (j : ℕ) :
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j)).card =
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F B = j)).card := by
  by_cases hAB : A = B
  · subst B
    rfl
  · let hcard : A.card = B.card := by
      have hFA := (mem_perfectMatchings.mp hF).1 hAF
      have hFB := (mem_perfectMatchings.mp hF).1 hBF
      rw [mem_allEdges.mp (hH hFA), mem_allEdges.mp (hH hFB)]
    let hdisj : Disjoint A B :=
      (mem_perfectMatchings.mp hF).2.2 hAF hBF hAB
    let g := swapFinsetBlocks A B hcard hdisj
    apply Finset.card_bij
        (fun perm hperm ↦ relabelPermutation g perm)
    · intro perm hperm
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hperm ⊢
      exact (matchingEdgeRank_swapMatchingEdges hH hF hAF hBF hAB
        hcard hdisj perm).trans hperm
    · intro p hp q hq heq
      exact (relabelPermutation g).injective heq
    · intro perm hperm
      refine ⟨relabelPermutation g perm, ?_, ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hperm ⊢
        have hrank := matchingEdgeRank_swapMatchingEdges
          hH hF hAF hBF hAB hcard hdisj (relabelPermutation g perm)
        have hg : g.symm = g :=
          swapFinsetBlocks_symm A B hcard hdisj
        have hdouble : (relabelPermutation g perm).trans g = perm := by
          change (perm.trans g).trans g = perm
          apply Equiv.ext
          intro x
          change g (g (perm x)) = perm x
          have hinv := g.symm_apply_apply (perm x)
          rwa [hg] at hinv
        rw [hdouble] at hrank
        exact hrank.symm.trans hperm
      · have hg : g.symm = g :=
          swapFinsetBlocks_symm A B hcard hdisj
        change (perm.trans g).trans g = perm
        apply Equiv.ext
        intro x
        change g (g (perm x)) = perm x
        have hinv := g.symm_apply_apply (perm x)
        rwa [hg] at hinv

/-- A fixed edge has each possible exposure rank in exactly `1/n` of all
vertex permutations. -/
lemma n_mul_card_matchingEdgeRank_eq {n : ℕ}
    {H F : Finset (Edge n)} (hn : 0 < n) (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A : Edge n} (hAF : A ∈ F)
    {j : ℕ} (hj : j < n) :
    n * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j)).card =
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
  let U := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let P : Edge n → Equiv.Perm (Vertex n) → Prop :=
    fun B perm ↦ matchingEdgeRank perm F B = j
  have hone : ∀ perm ∈ U, (F.filter fun B ↦ P B perm).card = 1 := by
    intro perm hperm
    obtain ⟨B, hB, huniq⟩ :=
      existsUnique_matchingEdgeRank_eq hH hF perm hj
    apply Finset.card_eq_one.mpr
    refine ⟨B, ?_⟩
    ext C
    simp only [Finset.mem_filter, Finset.mem_singleton]
    constructor
    · intro hC
      exact huniq C hC
    · intro hCB
      subst C
      exact hB
  have hleft : ∑ perm ∈ U, (F.filter fun B ↦ P B perm).card = U.card := by
    rw [Finset.sum_congr rfl hone]
    simp
  have hswap := sum_card_filter_swap U F P
  have hswap' :
      (∑ perm ∈ U, (F.filter fun B ↦ P B perm).card) =
        ∑ B ∈ F, (U.filter fun perm ↦ P B perm).card := by
    convert hswap using 1
    · apply Finset.sum_congr rfl
      intro perm hperm
      exact congrArg Finset.card
        (@Finset.filter_congr_decidable _ F
          (fun B ↦ matchingEdgeRank perm F B = j)
          (fun B ↦ instDecidableEqNat (matchingEdgeRank perm F B) j)
          (Classical.decPred _))
    · apply Finset.sum_congr rfl
      intro B hBF
      exact congrArg Finset.card
        (@Finset.filter_congr_decidable _ U
          (fun perm ↦ matchingEdgeRank perm F B = j)
          (fun perm ↦ instDecidableEqNat (matchingEdgeRank perm F B) j)
          (Classical.decPred _))
  have hright : ∑ B ∈ F, (U.filter fun perm ↦ P B perm).card =
      n * (U.filter fun perm ↦ P A perm).card := by
    calc
      (∑ B ∈ F, (U.filter fun perm ↦ P B perm).card) =
          ∑ _B ∈ F, (U.filter fun perm ↦ P A perm).card := by
        apply Finset.sum_congr rfl
        intro B hBF
        exact card_matchingEdgeRank_eq_edge_independent
          hH hF hBF hAF j
      _ = F.card * (U.filter fun perm ↦ P A perm).card := by simp
      _ = n * (U.filter fun perm ↦ P A perm).card := by
        rw [(mem_perfectMatchings.mp hF).2.1]
  have htotal : n * (U.filter fun perm ↦ P A perm).card = U.card := by
    calc
      n * (U.filter fun perm ↦ P A perm).card =
          ∑ B ∈ F, (U.filter fun perm ↦ P B perm).card := hright.symm
      _ = ∑ perm ∈ U, (F.filter fun B ↦ P B perm).card := hswap'.symm
      _ = U.card := hleft
  simpa only [U, P] using htotal

lemma swap_mem_finset {α : Type*} [DecidableEq α]
    (A : Finset α) {a b x : α} (ha : a ∈ A) (hb : b ∈ A) (hx : x ∈ A) :
    Equiv.swap a b x ∈ A := by
  by_cases hxa : x = a
  · subst x
    simp [hb]
  · by_cases hxb : x = b
    · subst x
      simp [ha]
    · rw [Equiv.swap_apply_of_ne_of_ne hxa hxb]
      exact hx

lemma swap_finsetCongr_eq_self_of_mem {α : Type*} [DecidableEq α]
    (A : Finset α) {a b : α} (ha : a ∈ A) (hb : b ∈ A) :
    (Equiv.swap a b).finsetCongr A = A := by
  rw [Equiv.finsetCongr_apply]
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    rcases Finset.mem_map.mp hx with ⟨y, hyA, rfl⟩
    exact swap_mem_finset A ha hb hyA
  · simp

lemma swap_finsetCongr_eq_self_of_disjoint {α : Type*} [DecidableEq α]
    (A C : Finset α) {a b : α} (ha : a ∈ A) (hb : b ∈ A)
    (hCA : Disjoint C A) :
    (Equiv.swap a b).finsetCongr C = C := by
  rw [Equiv.finsetCongr_apply]
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    rcases Finset.mem_map.mp hx with ⟨y, hyC, rfl⟩
    have hya : y ≠ a := fun h ↦
      Finset.disjoint_left.mp hCA hyC (h ▸ ha)
    have hyb : y ≠ b := fun h ↦
      Finset.disjoint_left.mp hCA hyC (h ▸ hb)
    change Equiv.swap a b y ∈ C
    rw [Equiv.swap_apply_of_ne_of_ne hya hyb]
    exact hyC
  · simp

lemma swapWithinMatchingEdge_map_matching {n : ℕ}
    {H F : Finset (Edge n)} (hF : F ∈ perfectMatchings n H)
    {A : Edge n} (hAF : A ∈ F) {a b : Vertex n}
    (ha : a ∈ A) (hb : b ∈ A) :
    F.map (Equiv.swap a b).finsetCongr.toEmbedding = F := by
  apply Finset.eq_of_subset_of_card_le
  · intro C hCmap
    rcases Finset.mem_map.mp hCmap with ⟨D, hDF, rfl⟩
    by_cases hDA : D = A
    · subst D
      change (Equiv.swap a b).finsetCongr A ∈ F
      rw [swap_finsetCongr_eq_self_of_mem A ha hb]
      exact hAF
    · have hDA' : Disjoint D A :=
        (mem_perfectMatchings.mp hF).2.2 hDF hAF hDA
      change (Equiv.swap a b).finsetCongr D ∈ F
      rw [swap_finsetCongr_eq_self_of_disjoint A D ha hb hDA']
      exact hDF
  · simp

lemma matchingEdgeRank_swapPermutationLabels_of_mem {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A : Edge n} (hAF : A ∈ F)
    {a b : Vertex n} (ha : a ∈ A) (hb : b ∈ A)
    (perm : Equiv.Perm (Vertex n)) :
    matchingEdgeRank (swapPermutationLabels a b perm) F A =
      matchingEdgeRank perm F A := by
  let g := @Equiv.swap (Vertex n) (Classical.decEq _) a b
  have hg : g = Equiv.swap a b := by
    have hdec : (Classical.decEq (Vertex n)) =
        (inferInstance : DecidableEq (Vertex n)) := by
      funext x y
      exact Subsingleton.elim _ _
    dsimp only [g]
    rw [hdec]
  have hnonempty : ∀ C ∈ F, C.Nonempty := by
    intro C hCF
    have hCcard := mem_allEdges.mp
      (hH ((mem_perfectMatchings.mp hF).1 hCF))
    exact Finset.card_pos.mp (by omega)
  have hmap : F.map g.symm.finsetCongr.toEmbedding = F := by
    rw [hg]
    simpa using swapWithinMatchingEdge_map_matching hF hAF ha hb
  rw [show swapPermutationLabels a b perm = perm.trans g by rfl]
  rw [matchingEdgeRank_trans_of_map_eq perm g
      F hnonempty hmap hAF]
  have hAmap : g.symm.finsetCongr A = A := by
    rw [hg]
    simpa using swap_finsetCongr_eq_self_of_mem A ha hb
  rw [hAmap]

lemma matchingEdgesAfter_swapPermutationLabels_of_mem {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A : Edge n} (hAF : A ∈ F)
    {a b : Vertex n} (ha : a ∈ A) (hb : b ∈ A)
    (perm : Equiv.Perm (Vertex n)) :
    matchingEdgesAfter (swapPermutationLabels a b perm) F A =
      matchingEdgesAfter perm F A := by
  let g := @Equiv.swap (Vertex n) (Classical.decEq _) a b
  have hg : g = Equiv.swap a b := by
    have hdec : (Classical.decEq (Vertex n)) =
        (inferInstance : DecidableEq (Vertex n)) := by
      funext x y
      exact Subsingleton.elim _ _
    dsimp only [g]
    rw [hdec]
  have hnonempty : ∀ C ∈ F, C.Nonempty := by
    intro C hCF
    have hCcard := mem_allEdges.mp
      (hH ((mem_perfectMatchings.mp hF).1 hCF))
    exact Finset.card_pos.mp (by omega)
  have hAmap : g.symm.finsetCongr A = A := by
    rw [hg]
    simpa using swap_finsetCongr_eq_self_of_mem A ha hb
  ext C
  simp only [matchingEdgesAfter, Finset.mem_filter]
  constructor
  · rintro ⟨hCF, hlt⟩
    have hCA : C = A ∨ C ≠ A := eq_or_ne C A
    rcases hCA with rfl | hCA
    · exact (Nat.lt_asymm hlt hlt).elim
    · have hCA' : Disjoint C A :=
        (mem_perfectMatchings.mp hF).2.2 hCF hAF hCA
      have hCmap : g.symm.finsetCongr C = C := by
        rw [hg]
        simpa using swap_finsetCongr_eq_self_of_disjoint A C ha hb hCA'
      have hApos := edgeFirstPosition_trans perm g (hnonempty A hAF)
      have hCpos := edgeFirstPosition_trans perm g (hnonempty C hCF)
      rw [hAmap] at hApos
      rw [hCmap] at hCpos
      exact ⟨hCF, hApos ▸ hCpos ▸ hlt⟩
  · rintro ⟨hCF, hlt⟩
    have hCA : C ≠ A := by
      intro hCA
      subst C
      exact Nat.lt_irrefl _ hlt
    have hCA' : Disjoint C A :=
      (mem_perfectMatchings.mp hF).2.2 hCF hAF hCA
    have hCmap : g.symm.finsetCongr C = C := by
      rw [hg]
      simpa using swap_finsetCongr_eq_self_of_disjoint A C ha hb hCA'
    have hApos := edgeFirstPosition_trans perm g (hnonempty A hAF)
    have hCpos := edgeFirstPosition_trans perm g (hnonempty C hCF)
    rw [hAmap] at hApos
    rw [hCmap] at hCpos
    exact ⟨hCF, hApos.symm ▸ hCpos.symm ▸ hlt⟩

/-- The first of three labels remains uniform after restricting to an
event invariant under the two transpositions from the first label. -/
lemma three_mul_card_permutationTripleFirst_and {n : ℕ}
    (a b c : Vertex n) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (R : Equiv.Perm (Vertex n) → Prop)
    (hRab : ∀ perm, R (swapPermutationLabels a b perm) ↔ R perm)
    (hRac : ∀ perm, R (swapPermutationLabels a c perm) ↔ R perm) :
    3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ permutationTripleFirst perm a b c ∧ R perm)).card =
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter R).card := by
  classical
  let U := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let S := U.filter R
  let Ea := U.filter (fun perm ↦ permutationTripleFirst perm a b c ∧ R perm)
  let Eb := U.filter (fun perm ↦ permutationTripleFirst perm b a c ∧ R perm)
  let Ec := U.filter (fun perm ↦ permutationTripleFirst perm c a b ∧ R perm)
  have hposne : ∀ perm : Equiv.Perm (Vertex n),
      permutationPosition perm a ≠ permutationPosition perm b ∧
      permutationPosition perm a ≠ permutationPosition perm c ∧
      permutationPosition perm b ≠ permutationPosition perm c := by
    intro perm
    constructor
    · intro h
      apply hab
      apply perm.symm.injective
      exact Fin.ext h
    constructor
    · intro h
      apply hac
      apply perm.symm.injective
      exact Fin.ext h
    · intro h
      apply hbc
      apply perm.symm.injective
      exact Fin.ext h
  have hEaEb : Ea.card = Eb.card := by
    apply Finset.card_bij (fun perm hperm ↦ swapPermutationLabels a b perm)
    · intro perm hperm
      simp only [Ea, Finset.mem_filter] at hperm
      simp only [Eb, Finset.mem_filter]
      exact ⟨Finset.mem_univ _,
        (permutationTripleFirst_swap perm a b c hab hac hbc).2 hperm.2.1,
        (hRab perm).2 hperm.2.2⟩
    · intro p hp q hq heq
      exact (swapPermutationLabels a b).injective heq
    · intro perm hperm
      refine ⟨swapPermutationLabels a b perm, ?_, ?_⟩
      · simp only [Eb, Finset.mem_filter] at hperm
        simp only [Ea, Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_, (hRab perm).2 hperm.2.2⟩
        apply (permutationTripleFirst_swap
          (swapPermutationLabels a b perm) a b c hab hac hbc).1
        have hinvol : swapPermutationLabels a b
            (swapPermutationLabels a b perm) = perm := by
          ext x
          simp [swapPermutationLabels]
        simpa only [hinvol] using hperm.2.1
      · ext x
        simp [swapPermutationLabels]
  have hEaEc : Ea.card = Ec.card := by
    apply Finset.card_bij (fun perm hperm ↦ swapPermutationLabels a c perm)
    · intro perm hperm
      simp only [Ea, Finset.mem_filter] at hperm
      simp only [Ec, Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_, (hRac perm).2 hperm.2.2⟩
      have hswap := permutationTripleFirst_swap perm a c b hac hab hbc.symm
      exact hswap.2
        ((permutationTripleFirst_partner_comm perm a b c).1 hperm.2.1)
    · intro p hp q hq heq
      exact (swapPermutationLabels a c).injective heq
    · intro perm hperm
      refine ⟨swapPermutationLabels a c perm, ?_, ?_⟩
      · simp only [Ec, Finset.mem_filter] at hperm
        simp only [Ea, Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_, (hRac perm).2 hperm.2.2⟩
        apply (permutationTripleFirst_partner_comm
          (swapPermutationLabels a c perm) a c b).1
        apply (permutationTripleFirst_swap
          (swapPermutationLabels a c perm) a c b hac hab hbc.symm).1
        have hinvol : swapPermutationLabels a c
            (swapPermutationLabels a c perm) = perm := by
          ext x
          simp [swapPermutationLabels]
        simpa only [hinvol] using hperm.2.1
      · ext x
        simp [swapPermutationLabels]
  have hcover : Ea ∪ Eb ∪ Ec = S := by
    ext perm
    simp only [Ea, Eb, Ec, S, U, Finset.mem_union, Finset.mem_filter,
      Finset.mem_univ, true_and]
    unfold permutationTripleFirst
    have hne := hposne perm
    constructor
    · rintro ((⟨_, hR⟩ | ⟨_, hR⟩) | ⟨_, hR⟩) <;> exact hR
    · intro hR
      rcases lt_or_gt_of_ne hne.1 with habpos | hbapos
      · by_cases hacpos :
            permutationPosition perm a < permutationPosition perm c
        · exact Or.inl (Or.inl ⟨⟨habpos, hacpos⟩, hR⟩)
        · exact Or.inr ⟨⟨by omega, by omega⟩, hR⟩
      · by_cases hbcpos :
            permutationPosition perm b < permutationPosition perm c
        · exact Or.inl (Or.inr ⟨⟨hbapos, hbcpos⟩, hR⟩)
        · exact Or.inr ⟨⟨by omega, by omega⟩, hR⟩
  have habDisj : Disjoint Ea Eb := by
    rw [Finset.disjoint_left]
    intro perm hpa hpb
    simp only [Ea, Finset.mem_filter] at hpa
    simp only [Eb, Finset.mem_filter] at hpb
    unfold permutationTripleFirst at hpa hpb
    omega
  have hacDisj : Disjoint (Ea ∪ Eb) Ec := by
    rw [Finset.disjoint_left]
    intro perm hp hpc
    rw [Finset.mem_union] at hp
    simp only [Ec, Finset.mem_filter] at hpc
    rcases hp with hpa | hpb
    · simp only [Ea, Finset.mem_filter] at hpa
      unfold permutationTripleFirst at hpa hpc
      omega
    · simp only [Eb, Finset.mem_filter] at hpb
      unfold permutationTripleFirst at hpb hpc
      omega
  have hcard := congrArg Finset.card hcover
  rw [Finset.card_union_of_disjoint hacDisj,
    Finset.card_union_of_disjoint habDisj] at hcard
  change 3 * Ea.card = S.card
  omega

lemma three_mul_card_matchingVertexFirst_and_invariant {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n)
    (R : Equiv.Perm (Vertex n) → Prop)
    (hR : ∀ u ∈ (matchingEdgeAt hH F v).erase v,
      ∀ perm, R (swapPermutationLabels v u perm) ↔ R perm) :
    3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧ R perm)).card =
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter R).card := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hvA : v ∈ A := (matchingEdgeAt_spec hH hF v).2
  have hAcard : A.card = 3 := by
    exact mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1 hAF))
  have hEraseCard : (A.erase v).card = 2 := by
    rw [Finset.card_erase_of_mem hvA, hAcard]
  obtain ⟨y, z, hyz, hErase⟩ := Finset.card_eq_two.mp hEraseCard
  have hyErase : y ∈ A.erase v := by rw [hErase]; simp
  have hzErase : z ∈ A.erase v := by rw [hErase]; simp
  have hyv : y ≠ v := (Finset.mem_erase.mp hyErase).1
  have hzv : z ≠ v := (Finset.mem_erase.mp hzErase).1
  have htriple := three_mul_card_permutationTripleFirst_and
    v y z hyv.symm hzv.symm hyz R
      (hR y (by simpa only [A] using hyErase))
      (hR z (by simpa only [A] using hzErase))
  have hevent :
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
          (fun perm ↦ matchingVertexFirst hH F perm v ∧ R perm) =
        (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
          (fun perm ↦ permutationTripleFirst perm v y z ∧ R perm) := by
    ext perm
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [matchingVertexFirst, show matchingEdgeAt hH F v = A by rfl,
      hErase]
    simp [permutationTripleFirst]
  rw [hevent]
  exact htriple

lemma three_mul_card_matchingVertexFirst_and_rank {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n) (j : ℕ) :
    3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j)).card =
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingEdgeRank perm F
          (matchingEdgeAt hH F v) = j)).card := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hvA : v ∈ A := (matchingEdgeAt_spec hH hF v).2
  have hAcard : A.card = 3 := by
    exact mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1 hAF))
  have hEraseCard : (A.erase v).card = 2 := by
    rw [Finset.card_erase_of_mem hvA, hAcard]
  obtain ⟨y, z, hyz, hErase⟩ := Finset.card_eq_two.mp hEraseCard
  have hyErase : y ∈ A.erase v := by rw [hErase]; simp
  have hzErase : z ∈ A.erase v := by rw [hErase]; simp
  have hyA : y ∈ A := Finset.mem_of_mem_erase hyErase
  have hzA : z ∈ A := Finset.mem_of_mem_erase hzErase
  have hyv : y ≠ v := (Finset.mem_erase.mp hyErase).1
  have hzv : z ≠ v := (Finset.mem_erase.mp hzErase).1
  let R : Equiv.Perm (Vertex n) → Prop := fun perm ↦
    matchingEdgeRank perm F A = j
  have hRab : ∀ perm, R (swapPermutationLabels v y perm) ↔ R perm := by
    intro perm
    change (matchingEdgeRank (swapPermutationLabels v y perm) F A = j ↔
      matchingEdgeRank perm F A = j)
    rw [matchingEdgeRank_swapPermutationLabels_of_mem
      hH hF hAF hvA hyA perm]
  have hRac : ∀ perm, R (swapPermutationLabels v z perm) ↔ R perm := by
    intro perm
    change (matchingEdgeRank (swapPermutationLabels v z perm) F A = j ↔
      matchingEdgeRank perm F A = j)
    rw [matchingEdgeRank_swapPermutationLabels_of_mem
      hH hF hAF hvA hzA perm]
  have htriple := three_mul_card_permutationTripleFirst_and
    v y z hyv.symm hzv.symm hyz R hRab hRac
  have hevent :
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
          (fun perm ↦ matchingVertexFirst hH F perm v ∧
            matchingEdgeRank perm F A = j) =
        (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
          (fun perm ↦ permutationTripleFirst perm v y z ∧ R perm) := by
    ext perm
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [matchingVertexFirst, show matchingEdgeAt hH F v = A by rfl,
      hErase]
    simp [permutationTripleFirst, R, and_assoc, and_left_comm, and_comm]
  rw [show matchingEdgeAt hH F v = A by rfl, hevent]
  simpa only [R] using htriple

/-- Jointly, `v` is first in its edge and that edge has any prescribed
rank with probability exactly `1/(3n)`. -/
lemma three_n_mul_card_matchingVertexFirst_and_rank {n : ℕ}
    {H F : Finset (Edge n)} (hn : 0 < n) (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n)
    {j : ℕ} (hj : j < n) :
    (3 * n) * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j)).card =
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
  have hAF := (matchingEdgeAt_spec hH hF v).1
  have hthree := three_mul_card_matchingVertexFirst_and_rank hH hF v j
  have hnrank := n_mul_card_matchingEdgeRank_eq hn hH hF hAF hj
  calc
    (3 * n) * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j)).card =
      n * (3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j)).card) := by
        ring
    _ = n * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingEdgeRank perm F
          (matchingEdgeAt hH F v) = j)).card := by rw [hthree]
    _ = (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := hnrank

/-- Swapping two matching edges other than `A` fixes the rank and first
position of `A`, and exchanges the first positions of the two swapped
edges. -/
lemma swapOtherMatchingEdges_rank_and_positions {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B C : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hCF : C ∈ F)
    (hBC : B ≠ C) (hAB : A ≠ B) (hAC : A ≠ C)
    (hcard : B.card = C.card) (hdisj : Disjoint B C)
    (perm : Equiv.Perm (Vertex n)) :
    let g := swapFinsetBlocks B C hcard hdisj
    matchingEdgeRank (perm.trans g) F A = matchingEdgeRank perm F A ∧
      edgeFirstPosition (perm.trans g) A = edgeFirstPosition perm A ∧
      edgeFirstPosition (perm.trans g) C = edgeFirstPosition perm B ∧
      edgeFirstPosition (perm.trans g) B = edgeFirstPosition perm C := by
  dsimp only
  let g := swapFinsetBlocks B C hcard hdisj
  have hnonempty : ∀ D ∈ F, D.Nonempty := by
    intro D hDF
    have hDcard := mem_allEdges.mp
      (hH ((mem_perfectMatchings.mp hF).1 hDF))
    exact Finset.card_pos.mp (by omega)
  have hmap : F.map g.symm.finsetCongr.toEmbedding = F := by
    rw [show g.symm = g from swapFinsetBlocks_symm B C hcard hdisj]
    exact swapMatchingEdges_map_matching hH hF hBF hCF hBC hcard hdisj
  have hABdisj : Disjoint A B :=
    (mem_perfectMatchings.mp hF).2.2 hAF hBF hAB
  have hACdisj : Disjoint A C :=
    (mem_perfectMatchings.mp hF).2.2 hAF hCF hAC
  have hAmap : g.symm.finsetCongr A = A := by
    rw [show g.symm = g from swapFinsetBlocks_symm B C hcard hdisj]
    exact swapFinsetBlocks_map_of_disjoint
      B C A hcard hdisj hABdisj hACdisj
  have hCmap : g.symm.finsetCongr C = B := by
    rw [show g.symm = g from swapFinsetBlocks_symm B C hcard hdisj]
    exact swapFinsetBlocks_map_right B C hcard hdisj
  have hBmap : g.symm.finsetCongr B = C := by
    rw [show g.symm = g from swapFinsetBlocks_symm B C hcard hdisj]
    exact swapFinsetBlocks_map_left B C hcard hdisj
  constructor
  · rw [matchingEdgeRank_trans_of_map_eq perm g F hnonempty hmap hAF,
      hAmap]
  constructor
  · rw [edgeFirstPosition_trans perm g (hnonempty A hAF), hAmap]
  constructor
  · rw [edgeFirstPosition_trans perm g (hnonempty C hCF), hCmap]
  · rw [edgeFirstPosition_trans perm g (hnonempty B hBF), hBmap]

lemma card_rank_and_after_edge_independent {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B C : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hCF : C ∈ F)
    (hBC : B ≠ C) (hAB : A ≠ B) (hAC : A ≠ C) (j : ℕ) :
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A)).card =
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j ∧
        C ∈ matchingEdgesAfter perm F A)).card := by
  let hcard : B.card = C.card := by
    have hFB := (mem_perfectMatchings.mp hF).1 hBF
    have hFC := (mem_perfectMatchings.mp hF).1 hCF
    rw [mem_allEdges.mp (hH hFB), mem_allEdges.mp (hH hFC)]
  let hdisj : Disjoint B C :=
    (mem_perfectMatchings.mp hF).2.2 hBF hCF hBC
  let g := swapFinsetBlocks B C hcard hdisj
  have hg : g.symm = g := swapFinsetBlocks_symm B C hcard hdisj
  have hdouble : ∀ perm : Equiv.Perm (Vertex n),
      (perm.trans g).trans g = perm := by
    intro perm
    apply Equiv.ext
    intro x
    change g (g (perm x)) = perm x
    have hinv := g.symm_apply_apply (perm x)
    rwa [hg] at hinv
  apply Finset.card_bij (fun perm hperm ↦ perm.trans g)
  · intro perm hperm
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hperm ⊢
    rcases hperm with ⟨hrank, hafter⟩
    have hdata := swapOtherMatchingEdges_rank_and_positions
      hH hF hAF hBF hCF hBC hAB hAC hcard hdisj perm
    rw [matchingEdgesAfter, Finset.mem_filter] at hafter ⊢
    exact ⟨hdata.1.trans hrank, hCF,
      hdata.2.1.symm ▸ hdata.2.2.1.symm ▸ hafter.2⟩
  · intro p hp q hq heq
    exact (relabelPermutation g).injective heq
  · intro perm hperm
    refine ⟨perm.trans g, ?_, hdouble perm⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hperm ⊢
    rcases hperm with ⟨hrank, hafter⟩
    have hdata := swapOtherMatchingEdges_rank_and_positions
      hH hF hAF hBF hCF hBC hAB hAC hcard hdisj perm
    rw [matchingEdgesAfter, Finset.mem_filter] at hafter ⊢
    exact ⟨hdata.1.trans hrank, hBF,
      hdata.2.1.symm ▸ hdata.2.2.2.symm ▸ hafter.2⟩

lemma card_rank_and_two_after_second_independent {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B C D : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hCF : C ∈ F) (hDF : D ∈ F)
    (hAB : A ≠ B) (hAC : A ≠ C) (hAD : A ≠ D)
    (hBC : B ≠ C) (hBD : B ≠ D) (hCD : C ≠ D) (j : ℕ) :
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A ∧
        C ∈ matchingEdgesAfter perm F A)).card =
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A ∧
        D ∈ matchingEdgesAfter perm F A)).card := by
  let hcard : C.card = D.card := by
    have hFC := (mem_perfectMatchings.mp hF).1 hCF
    have hFD := (mem_perfectMatchings.mp hF).1 hDF
    rw [mem_allEdges.mp (hH hFC), mem_allEdges.mp (hH hFD)]
  let hdisj : Disjoint C D :=
    (mem_perfectMatchings.mp hF).2.2 hCF hDF hCD
  let g := swapFinsetBlocks C D hcard hdisj
  have hg : g.symm = g := swapFinsetBlocks_symm C D hcard hdisj
  have hdouble : ∀ perm : Equiv.Perm (Vertex n),
      (perm.trans g).trans g = perm := by
    intro perm
    apply Equiv.ext
    intro x
    change g (g (perm x)) = perm x
    have hinv := g.symm_apply_apply (perm x)
    rwa [hg] at hinv
  apply Finset.card_bij (fun perm hperm ↦ perm.trans g)
  · intro perm hperm
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hperm ⊢
    rcases hperm with ⟨hrank, hBafter, hCafter⟩
    have hdataA := swapOtherMatchingEdges_rank_and_positions
      hH hF hAF hCF hDF hCD hAC hAD hcard hdisj perm
    have hdataB := swapOtherMatchingEdges_rank_and_positions
      hH hF hBF hCF hDF hCD hBC hBD hcard hdisj perm
    simp only [matchingEdgesAfter, Finset.mem_filter] at hBafter hCafter ⊢
    refine ⟨hdataA.1.trans hrank, ⟨hBF, ?_⟩, ⟨hDF, ?_⟩⟩
    · exact hdataA.2.1.symm ▸ hdataB.2.1.symm ▸ hBafter.2
    · exact hdataA.2.1.symm ▸ hdataA.2.2.1.symm ▸ hCafter.2
  · intro p hp q hq heq
    exact (relabelPermutation g).injective heq
  · intro perm hperm
    refine ⟨perm.trans g, ?_, hdouble perm⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hperm ⊢
    rcases hperm with ⟨hrank, hBafter, hDafter⟩
    have hdataA := swapOtherMatchingEdges_rank_and_positions
      hH hF hAF hCF hDF hCD hAC hAD hcard hdisj perm
    have hdataB := swapOtherMatchingEdges_rank_and_positions
      hH hF hBF hCF hDF hCD hBC hBD hcard hdisj perm
    simp only [matchingEdgesAfter, Finset.mem_filter] at hBafter hDafter ⊢
    refine ⟨hdataA.1.trans hrank, ⟨hBF, ?_⟩, ⟨hCF, ?_⟩⟩
    · exact hdataA.2.1.symm ▸ hdataB.2.1.symm ▸ hBafter.2
    · exact hdataA.2.1.symm ▸ hdataA.2.2.2.symm ▸ hDafter.2

/-- First-moment double count for one specified later edge. -/
lemma pred_n_mul_card_rank_and_after_eq {n : ℕ}
    {H F : Finset (Edge n)} (hn : 0 < n) (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hAB : A ≠ B)
    {j : ℕ} (hj : j < n) :
    (n - 1) * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A)).card =
    (n - j - 1) *
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingEdgeRank perm F A = j)).card := by
  let U := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let I := F.erase A
  let P : Edge n → Equiv.Perm (Vertex n) → Prop := fun C perm ↦
    matchingEdgeRank perm F A = j ∧ C ∈ matchingEdgesAfter perm F A
  have hfiber : ∀ perm ∈ U,
      (I.filter fun C ↦ P C perm).card =
        if matchingEdgeRank perm F A = j then n - j - 1 else 0 := by
    intro perm hperm
    by_cases hrank : matchingEdgeRank perm F A = j
    · have hset : (I.filter fun C ↦ P C perm) =
          matchingEdgesAfter perm F A := by
        ext C
        simp only [I, P, Finset.mem_filter, Finset.mem_erase]
        constructor
        · rintro ⟨⟨hCA, hCF⟩, _hrank, hafter⟩
          exact hafter
        · intro hafter
          have hCF := (Finset.mem_filter.mp hafter).1
          have hCA : C ≠ A := by
            intro hCA
            subst C
            exact (Nat.lt_irrefl _ (Finset.mem_filter.mp hafter).2)
          exact ⟨⟨hCA, hCF⟩, hrank, hafter⟩
      rw [if_pos hrank, hset, card_matchingEdgesAfter hH hF perm hAF,
        hrank]
    · rw [if_neg hrank]
      rw [Finset.card_eq_zero]
      apply Finset.filter_eq_empty_iff.mpr
      intro C hCI hP
      exact hrank hP.1
  have hleft :
      (∑ perm ∈ U, (I.filter fun C ↦ P C perm).card) =
        (n - j - 1) *
          (U.filter fun perm ↦ matchingEdgeRank perm F A = j).card := by
    rw [Finset.sum_congr rfl hfiber]
    calc
      (∑ perm ∈ U,
          if matchingEdgeRank perm F A = j then n - j - 1 else 0) =
          (n - j - 1) *
            ∑ perm ∈ U,
              if matchingEdgeRank perm F A = j then 1 else 0 := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro perm hperm
        by_cases hr : matchingEdgeRank perm F A = j <;> simp [hr]
      _ = (n - j - 1) *
          (U.filter fun perm ↦ matchingEdgeRank perm F A = j).card := by
        have hbool := Finset.sum_boole (R := ℕ)
          (fun perm : Equiv.Perm (Vertex n) ↦
            matchingEdgeRank perm F A = j) U
        rw [hbool]
        congr 1
  have hright :
      (∑ C ∈ I, (U.filter fun perm ↦ P C perm).card) =
        (n - 1) * (U.filter fun perm ↦ P B perm).card := by
    calc
      (∑ C ∈ I, (U.filter fun perm ↦ P C perm).card) =
          ∑ _C ∈ I, (U.filter fun perm ↦ P B perm).card := by
        apply Finset.sum_congr rfl
        intro C hCI
        have hCF := (Finset.mem_erase.mp hCI).2
        have hAC : A ≠ C := Ne.symm (Finset.mem_erase.mp hCI).1
        by_cases hBC : B = C
        · subst C
          rfl
        · simpa only [U, P] using
            (card_rank_and_after_edge_independent
              hH hF hAF hBF hCF hBC hAB hAC j).symm
      _ = I.card * (U.filter fun perm ↦ P B perm).card := by simp
      _ = (n - 1) * (U.filter fun perm ↦ P B perm).card := by
        dsimp only [I]
        rw [Finset.card_erase_of_mem hAF,
          (mem_perfectMatchings.mp hF).2.1]
  have hswap := sum_card_filter_swap U I P
  have hswap' :
      (∑ perm ∈ U, (I.filter fun C ↦ P C perm).card) =
        ∑ C ∈ I, (U.filter fun perm ↦ P C perm).card := by
    convert hswap using 1
    · apply Finset.sum_congr rfl
      intro perm hperm
      exact congrArg Finset.card
        (@Finset.filter_congr_decidable _ I (fun C ↦ P C perm)
          (fun _C ↦ instDecidableAnd) (Classical.decPred _))
    · apply Finset.sum_congr rfl
      intro C hCI
      exact congrArg Finset.card
        (@Finset.filter_congr_decidable _ U (fun perm ↦ P C perm)
          (fun _perm ↦ instDecidableAnd) (Classical.decPred _))
  have htotal :
      (n - 1) * (U.filter fun perm ↦ P B perm).card =
        (n - j - 1) *
          (U.filter fun perm ↦ matchingEdgeRank perm F A = j).card := by
    rw [← hright, ← hswap', hleft]
  simpa only [U, P] using htotal

/-- Second-moment double count for two specified distinct later edges. -/
lemma pred_pred_n_mul_card_rank_and_two_after_eq {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {A B C : Edge n}
    (hAF : A ∈ F) (hBF : B ∈ F) (hCF : C ∈ F)
    (hAB : A ≠ B) (hAC : A ≠ C) (hBC : B ≠ C)
    {j : ℕ} (hj : j < n) :
    (n - 2) * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A ∧
        C ∈ matchingEdgesAfter perm F A)).card =
    (n - j - 2) *
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingEdgeRank perm F A = j ∧
          B ∈ matchingEdgesAfter perm F A)).card := by
  let U := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let I := (F.erase A).erase B
  let P : Edge n → Equiv.Perm (Vertex n) → Prop := fun D perm ↦
    matchingEdgeRank perm F A = j ∧
      B ∈ matchingEdgesAfter perm F A ∧
      D ∈ matchingEdgesAfter perm F A
  have hfiber : ∀ perm ∈ U,
      (I.filter fun D ↦ P D perm).card =
        if matchingEdgeRank perm F A = j ∧
            B ∈ matchingEdgesAfter perm F A then n - j - 2 else 0 := by
    intro perm hperm
    by_cases hbase : matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A
    · have hset : (I.filter fun D ↦ P D perm) =
          (matchingEdgesAfter perm F A).erase B := by
        ext D
        simp only [I, P, Finset.mem_filter, Finset.mem_erase]
        constructor
        · rintro ⟨⟨hDB, hDA, hDF⟩, _hrank, _hBafter, hDafter⟩
          exact ⟨hDB, hDafter⟩
        · rintro ⟨hDB, hDafter⟩
          have hDF := (Finset.mem_filter.mp hDafter).1
          have hDA : D ≠ A := by
            intro hDA
            subst D
            exact (Nat.lt_irrefl _ (Finset.mem_filter.mp hDafter).2)
          exact ⟨⟨hDB, hDA, hDF⟩, hbase.1, hbase.2, hDafter⟩
      rw [if_pos hbase, hset,
        Finset.card_erase_of_mem hbase.2,
        card_matchingEdgesAfter hH hF perm hAF, hbase.1]
      omega
    · rw [if_neg hbase, Finset.card_eq_zero]
      apply Finset.filter_eq_empty_iff.mpr
      intro D hDI hP
      exact hbase ⟨hP.1, hP.2.1⟩
  have hleft :
      (∑ perm ∈ U, (I.filter fun D ↦ P D perm).card) =
        (n - j - 2) *
          (U.filter fun perm ↦ matchingEdgeRank perm F A = j ∧
            B ∈ matchingEdgesAfter perm F A).card := by
    rw [Finset.sum_congr rfl hfiber]
    calc
      (∑ perm ∈ U,
          if matchingEdgeRank perm F A = j ∧
              B ∈ matchingEdgesAfter perm F A then n - j - 2 else 0) =
          (n - j - 2) *
            ∑ perm ∈ U,
              if matchingEdgeRank perm F A = j ∧
                  B ∈ matchingEdgesAfter perm F A then 1 else 0 := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro perm hperm
        by_cases hb : matchingEdgeRank perm F A = j ∧
            B ∈ matchingEdgesAfter perm F A <;> simp [hb]
      _ = (n - j - 2) *
          (U.filter fun perm ↦ matchingEdgeRank perm F A = j ∧
            B ∈ matchingEdgesAfter perm F A).card := by
        have hbool := Finset.sum_boole (R := ℕ)
          (fun perm : Equiv.Perm (Vertex n) ↦
            matchingEdgeRank perm F A = j ∧
              B ∈ matchingEdgesAfter perm F A) U
        rw [hbool]
        congr 1
  have hright :
      (∑ D ∈ I, (U.filter fun perm ↦ P D perm).card) =
        (n - 2) * (U.filter fun perm ↦ P C perm).card := by
    have hCI : C ∈ I := by
      exact Finset.mem_erase.mpr ⟨hBC.symm,
        Finset.mem_erase.mpr ⟨hAC.symm, hCF⟩⟩
    calc
      (∑ D ∈ I, (U.filter fun perm ↦ P D perm).card) =
          ∑ _D ∈ I, (U.filter fun perm ↦ P C perm).card := by
        apply Finset.sum_congr rfl
        intro D hDI
        have hDB : D ≠ B := (Finset.mem_erase.mp hDI).1
        have hDrest := Finset.mem_erase.mp (Finset.mem_erase.mp hDI).2
        have hDA : D ≠ A := hDrest.1
        have hDF : D ∈ F := hDrest.2
        by_cases hCD : C = D
        · subst D
          rfl
        · simpa only [U, P] using
            (card_rank_and_two_after_second_independent
              hH hF hAF hBF hCF hDF hAB hAC
              (Ne.symm hDA) hBC (Ne.symm hDB) hCD j).symm
      _ = I.card * (U.filter fun perm ↦ P C perm).card := by simp
      _ = (n - 2) * (U.filter fun perm ↦ P C perm).card := by
        dsimp only [I]
        rw [Finset.card_erase_of_mem
          (Finset.mem_erase.mpr ⟨hAB.symm, hBF⟩),
          Finset.card_erase_of_mem hAF,
          (mem_perfectMatchings.mp hF).2.1]
        congr 1 <;> omega
  have hswap := sum_card_filter_swap U I P
  have hswap' :
      (∑ perm ∈ U, (I.filter fun D ↦ P D perm).card) =
        ∑ D ∈ I, (U.filter fun perm ↦ P D perm).card := by
    convert hswap using 1
    · apply Finset.sum_congr rfl
      intro perm hperm
      exact congrArg Finset.card
        (@Finset.filter_congr_decidable _ I (fun D ↦ P D perm)
          (fun _D ↦ instDecidableAnd) (Classical.decPred _))
    · apply Finset.sum_congr rfl
      intro D hDI
      exact congrArg Finset.card
        (@Finset.filter_congr_decidable _ U (fun perm ↦ P D perm)
          (fun _perm ↦ instDecidableAnd) (Classical.decPred _))
  have htotal :
      (n - 2) * (U.filter fun perm ↦ P C perm).card =
        (n - j - 2) *
          (U.filter fun perm ↦ matchingEdgeRank perm F A = j ∧
            B ∈ matchingEdgesAfter perm F A).card := by
    rw [← hright, ← hswap', hleft]
  simpa only [U, P] using htotal

lemma three_mul_card_vertexFirst_rank_two_after {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n)
    {B C : Edge n} (j : ℕ) :
    3 * ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦ matchingVertexFirst hH F perm v ∧
        matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
        B ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v) ∧
        C ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v))).card =
    ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
      (fun perm ↦
        matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
        B ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v) ∧
        C ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v))).card := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  let R : Equiv.Perm (Vertex n) → Prop := fun perm ↦
    matchingEdgeRank perm F A = j ∧
      B ∈ matchingEdgesAfter perm F A ∧
      C ∈ matchingEdgesAfter perm F A
  have hR : ∀ u ∈ (matchingEdgeAt hH F v).erase v,
      ∀ perm, R (swapPermutationLabels v u perm) ↔ R perm := by
    intro u hu perm
    have hvA := (matchingEdgeAt_spec hH hF v).2
    have huA : u ∈ A := by
      exact Finset.mem_of_mem_erase (by simpa only [A] using hu)
    change (matchingEdgeRank (swapPermutationLabels v u perm) F A = j ∧
        B ∈ matchingEdgesAfter (swapPermutationLabels v u perm) F A ∧
        C ∈ matchingEdgesAfter (swapPermutationLabels v u perm) F A ↔
      matchingEdgeRank perm F A = j ∧
        B ∈ matchingEdgesAfter perm F A ∧
        C ∈ matchingEdgesAfter perm F A)
    rw [matchingEdgeRank_swapPermutationLabels_of_mem
        hH hF hAF hvA huA perm,
      matchingEdgesAfter_swapPermutationLabels_of_mem
        hH hF hAF hvA huA perm]
  have hmain := three_mul_card_matchingVertexFirst_and_invariant
    hH hF v R hR
  simpa only [A, R] using hmain

/-- Exact generic survival fiber: after fixing the rank of the current
edge, two distinct other matching edges both survive with the falling
factorial ratio `(n-j-1)₂/(n-1)₂`, independently of the first label in
the current triple. -/
lemma generic_two_after_exact_count {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (v : Vertex n)
    {B C : Edge n} (hBF : B ∈ F) (hCF : C ∈ F)
    (hBC : B ≠ C)
    (hAB : matchingEdgeAt hH F v ≠ B)
    (hAC : matchingEdgeAt hH F v ≠ C)
    {j : ℕ} (hj : j < n) :
    (3 * n * (n - 1) * (n - 2)) *
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
          B ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v) ∧
          C ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v))).card =
    ((n - j - 1) * (n - j - 2)) *
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hn : 0 < n := by
    have hv := v.isLt
    omega
  let Q := ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
    (fun perm ↦ matchingVertexFirst hH F perm v ∧
      matchingEdgeRank perm F A = j ∧
      B ∈ matchingEdgesAfter perm F A ∧
      C ∈ matchingEdgesAfter perm F A)).card
  let P := ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
    (fun perm ↦ matchingEdgeRank perm F A = j ∧
      B ∈ matchingEdgesAfter perm F A ∧
      C ∈ matchingEdgesAfter perm F A)).card
  let S := ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
    (fun perm ↦ matchingEdgeRank perm F A = j ∧
      B ∈ matchingEdgesAfter perm F A)).card
  let R := ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
    (fun perm ↦ matchingEdgeRank perm F A = j)).card
  let U := (Finset.univ : Finset (Equiv.Perm (Vertex n))).card
  have hactive : 3 * Q = P := by
    simpa only [A, Q, P] using
      three_mul_card_vertexFirst_rank_two_after hH hF v (B := B) (C := C) j
  have hpair : (n - 2) * P = (n - j - 2) * S := by
    simpa only [A, P, S] using
      pred_pred_n_mul_card_rank_and_two_after_eq
        hH hF hAF hBF hCF hAB hAC hBC hj
  have hsingle : (n - 1) * S = (n - j - 1) * R := by
    simpa only [A, S, R] using
      pred_n_mul_card_rank_and_after_eq hn hH hF hAF hBF hAB hj
  have hrank : n * R = U := by
    simpa only [A, R, U] using
      n_mul_card_matchingEdgeRank_eq hn hH hF hAF hj
  change (3 * n * (n - 1) * (n - 2)) * Q =
    ((n - j - 1) * (n - j - 2)) * U
  calc
    (3 * n * (n - 1) * (n - 2)) * Q =
        n * (n - 1) * (n - 2) * (3 * Q) := by ring
    _ = n * (n - 1) * (n - 2) * P := by rw [hactive]
    _ = n * (n - 1) * ((n - 2) * P) := by ring
    _ = n * (n - 1) * ((n - j - 2) * S) := by rw [hpair]
    _ = n * (n - j - 2) * ((n - 1) * S) := by ring
    _ = n * (n - j - 2) * ((n - j - 1) * R) := by rw [hsingle]
    _ = ((n - j - 1) * (n - j - 2)) * (n * R) := by ring
    _ = ((n - j - 1) * (n - j - 2)) * U := by rw [hrank]

/-! ### Exact interpretation of the Kahn availability set -/

/-- Matching edges exposed strictly before `A`. -/
def matchingEdgesBefore {n : ℕ} (perm : Equiv.Perm (Vertex n))
    (F : Finset (Edge n)) (A : Edge n) : Finset (Edge n) :=
  F.filter fun B ↦ edgeFirstPosition perm B < edgeFirstPosition perm A

lemma edgeFirstPosition_eq_of_matchingVertexFirst {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v) :
    edgeFirstPosition perm (matchingEdgeAt hH F v) =
      permutationPosition perm v := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hvA : v ∈ A := (matchingEdgeAt_spec hH hF v).2
  have hAcard : A.card = 3 :=
    mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1 hAF))
  have hAne : A.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨x, hxA, hxpos⟩ := exists_mem_edgeFirstPosition perm hAne
  have hvle : permutationPosition perm v ≤ permutationPosition perm x := by
    by_cases hxv : x = v
    · subst x
      exact le_rfl
    · exact (hfirst x (Finset.mem_erase.mpr ⟨hxv, hxA⟩)).le
  have hminle := edgeFirstPosition_le_of_mem perm hAne hvA
  change edgeFirstPosition perm A = permutationPosition perm v
  exact Nat.le_antisymm hminle (by simpa only [hxpos] using hvle)

lemma matchingPrefixCode_toFinset_eq_edgesBefore {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v) :
    (matchingPrefixCode hH (permutationPrior perm v) F).toFinset =
      matchingEdgesBefore perm F (matchingEdgeAt hH F v) := by
  let A := matchingEdgeAt hH F v
  have hApos := edgeFirstPosition_eq_of_matchingVertexFirst
    hH hF perm v hfirst
  ext B
  simp only [matchingPrefixCode, finitePrefixCode, List.mem_toFinset,
    List.mem_map, matchingEdgesBefore, Finset.mem_filter]
  constructor
  · rintro ⟨u, huprior, rfl⟩
    have huF := (matchingEdgeAt_spec hH hF u).1
    refine ⟨huF, ?_⟩
    have hUne : (matchingEdgeAt hH F u).Nonempty := by
      have hcard := mem_allEdges.mp
        (hH ((mem_perfectMatchings.mp hF).1 huF))
      exact Finset.card_pos.mp (by omega)
    calc
      edgeFirstPosition perm (matchingEdgeAt hH F u) ≤
          permutationPosition perm u :=
        edgeFirstPosition_le_of_mem perm hUne
          (matchingEdgeAt_spec hH hF u).2
      _ < permutationPosition perm v :=
        (mem_permutationPrior_iff perm u v).1 huprior
      _ = edgeFirstPosition perm A := hApos.symm
  · rintro ⟨hBF, hBlt⟩
    have hBcard := mem_allEdges.mp
      (hH ((mem_perfectMatchings.mp hF).1 hBF))
    have hBne : B.Nonempty := Finset.card_pos.mp (by omega)
    obtain ⟨u, huB, hupos⟩ := exists_mem_edgeFirstPosition perm hBne
    have huprior : u ∈ permutationPrior perm v := by
      apply (mem_permutationPrior_iff perm u v).2
      rw [hupos, ← hApos]
      exact hBlt
    refine ⟨u, huprior, ?_⟩
    exact matchingEdgeAt_eq_of_mem hH hF hBF huB

lemma coveredVertices_perfectMatching_eq_univ {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) :
    coveredVertices F = (Finset.univ : Finset (Vertex n)) := by
  apply Finset.eq_of_subset_of_card_le
  · exact Finset.subset_univ _
  · rw [card_coveredVertices_of_matching
      ((mem_perfectMatchings.mp hF).1.trans hH)
      (mem_perfectMatchings.mp hF).2.2,
      (mem_perfectMatchings.mp hF).2.1]
    simp

lemma matchingKahnAvailableVertices_eq_current_union_after {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v) :
    matchingKahnAvailableVertices hH F (permutationPrior perm v) v =
      (matchingEdgeAt hH F v).erase v ∪
        (matchingEdgesAfter perm F (matchingEdgeAt hH F v)).biUnion id := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hvA : v ∈ A := (matchingEdgeAt_spec hH hF v).2
  have hinj := matchingEdgeFirstPosition_injectiveOn hH hF perm
  rw [matchingKahnAvailableVertices,
    matchingPrefixCode_toFinset_eq_edgesBefore hH hF perm v hfirst]
  ext x
  simp only [Finset.mem_sdiff, Finset.mem_erase, Finset.mem_univ, and_true,
    Finset.mem_biUnion, Finset.mem_union, matchingEdgesBefore,
    matchingEdgesAfter, Finset.mem_filter]
  constructor
  · rintro ⟨hxv, hxnotBefore⟩
    have hcover : x ∈ coveredVertices F := by
      rw [coveredVertices_perfectMatching_eq_univ hH hF]
      exact Finset.mem_univ x
    rcases Finset.mem_biUnion.mp hcover with ⟨D, hDF, hxD⟩
    by_cases hDA : D = A
    · subst D
      exact Or.inl ⟨hxv, hxD⟩
    · have hposne : edgeFirstPosition perm D ≠ edgeFirstPosition perm A :=
        fun heq ↦ hDA (hinj hDF hAF heq)
      rcases lt_or_gt_of_ne hposne with hbefore | hafter
      · exact (hxnotBefore ⟨D, ⟨hDF, hbefore⟩, hxD⟩).elim
      · exact Or.inr ⟨D, ⟨hDF, hafter⟩, hxD⟩
  · rintro (hxcur | hxafter)
    · refine ⟨hxcur.1, ?_⟩
      rintro ⟨D, hDbefore, hxD⟩
      have hDF := hDbefore.1
      have hDA : D ≠ A := by
        intro hDA
        subst D
        exact Nat.lt_irrefl _ hDbefore.2
      exact Finset.disjoint_left.mp
        ((mem_perfectMatchings.mp hF).2.2 hDF hAF hDA) hxD hxcur.2
    · rcases hxafter with ⟨D, hDafter, hxD⟩
      refine ⟨?_, ?_⟩
      · intro hxv
        have hDA : D ≠ A := by
          intro hDA
          subst D
          exact Nat.lt_irrefl _ hDafter.2
        exact Finset.disjoint_left.mp
          ((mem_perfectMatchings.mp hF).2.2 hDafter.1 hAF hDA)
          hxD (hxv ▸ hvA)
      · rintro ⟨E, hEbefore, hxE⟩
        have hDE : D ≠ E := by
          intro hDE
          subst E
          omega
        exact Finset.disjoint_left.mp
          ((mem_perfectMatchings.mp hF).2.2
            hDafter.1 hEbefore.1 hDE) hxD hxE

/-- When `v` is the first exposed vertex in its matching edge, Kahn's
availability set consists of its two partners and three vertices for
each later matching edge. -/
lemma card_matchingKahnAvailableVertices_of_first {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v) :
    (matchingKahnAvailableVertices hH F (permutationPrior perm v) v).card =
      2 + 3 * (n - matchingEdgeRank perm F (matchingEdgeAt hH F v) - 1) := by
  let A := matchingEdgeAt hH F v
  let after := matchingEdgesAfter perm F A
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hvA : v ∈ A := (matchingEdgeAt_spec hH hF v).2
  have hAcard : A.card = 3 :=
    mem_allEdges.mp (hH ((mem_perfectMatchings.mp hF).1 hAF))
  have hafterSub : after ⊆ F := fun B hB ↦
    (Finset.mem_filter.mp hB).1
  have hafterAll : after ⊆ allEdges n := hafterSub.trans
    ((mem_perfectMatchings.mp hF).1.trans hH)
  have hafterMatching : IsMatching after := by
    intro B hBF C hCF hBC
    exact (mem_perfectMatchings.mp hF).2.2
      (hafterSub hBF) (hafterSub hCF) hBC
  have hcurrentDisjoint : Disjoint (A.erase v) (after.biUnion id) := by
    rw [Finset.disjoint_biUnion_right]
    intro B hB
    have hBF := hafterSub hB
    have hBA : B ≠ A := by
      intro hBA
      subst B
      exact Nat.lt_irrefl _ (Finset.mem_filter.mp hB).2
    apply Finset.disjoint_left.mpr
    intro x hxA hxB
    exact Finset.disjoint_left.mp
      ((mem_perfectMatchings.mp hF).2.2 hAF hBF hBA.symm)
      (Finset.mem_of_mem_erase hxA) hxB
  rw [matchingKahnAvailableVertices_eq_current_union_after
      hH hF perm v hfirst,
    Finset.card_union_of_disjoint hcurrentDisjoint,
    Finset.card_erase_of_mem hvA, hAcard]
  change 3 - 1 + (coveredVertices after).card = _
  rw [card_coveredVertices_of_matching hafterAll hafterMatching,
    card_matchingEdgesAfter hH hF perm hAF]

/-- Rank `j` gives the exact Kahn denominator `3(n-j)-1`. -/
lemma card_matchingKahnAvailableVertices_of_first_rank {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v)
    {j : ℕ} (hj : j < n)
    (hrank : matchingEdgeRank perm F (matchingEdgeAt hH F v) = j) :
    (matchingKahnAvailableVertices hH F (permutationPrior perm v) v).card =
      3 * (n - j) - 1 := by
  rw [card_matchingKahnAvailableVertices_of_first hH hF perm v hfirst,
    hrank]
  omega

/-- A generic candidate edge determines two distinct other edges of the
perfect matching, one through each of its partner vertices. -/
lemma exists_generic_matching_edge_pair {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {T : Edge n} {v : Vertex n}
    (hTH : T ∈ H) (hvT : v ∈ T)
    (hgen : 2 ≤ (matchingOtherMeetingEdges F v T).card) :
    ∃ B C : Edge n,
      B ∈ F ∧ C ∈ F ∧ B ≠ C ∧
      matchingEdgeAt hH F v ≠ B ∧
      matchingEdgeAt hH F v ≠ C ∧
      ¬Disjoint B (T.erase v) ∧
      ¬Disjoint C (T.erase v) ∧
      T.erase v ⊆ B ∪ C := by
  have hone : 1 < (matchingOtherMeetingEdges F v T).card := by omega
  obtain ⟨B, hBmeet, C, hCmeet, hBC⟩ :=
    Finset.one_lt_card.mp hone
  rcases Finset.mem_filter.mp hBmeet with ⟨hBF, hvB, hBinter⟩
  rcases Finset.mem_filter.mp hCmeet with ⟨hCF, hvC, hCinter⟩
  obtain ⟨y, hyB, hyT⟩ := Finset.not_disjoint_iff.mp hBinter
  obtain ⟨z, hzC, hzT⟩ := Finset.not_disjoint_iff.mp hCinter
  have hyz : y ≠ z := by
    intro hyz
    subst z
    exact Finset.disjoint_left.mp
      ((mem_perfectMatchings.mp hF).2.2 hBF hCF hBC) hyB hzC
  have hTcard : T.card = 3 := mem_allEdges.mp (hH hTH)
  have hEraseCard : (T.erase v).card = 2 := by
    rw [Finset.card_erase_of_mem hvT, hTcard]
  have hErase : T.erase v = {y, z} := by
    apply Finset.eq_of_subset_of_card_le
    · intro x hx
      have hpairSub : {y, z} ⊆ T.erase v := by
        intro w hw
        simp only [Finset.mem_insert, Finset.mem_singleton] at hw
        rcases hw with rfl | rfl
        · exact hyT
        · exact hzT
      have hcardPair : ({y, z} : Finset (Vertex n)).card = 2 :=
        Finset.card_pair hyz
      have := Finset.card_le_card hpairSub
      rw [hEraseCard, hcardPair] at this
      by_contra hxpair
      have hstrict := Finset.card_lt_card
        (Finset.ssubset_iff_subset_ne.mpr ⟨hpairSub, Ne.symm (by
          intro heq
          exact hxpair (heq ▸ hx))⟩)
      omega
    · rw [hEraseCard, Finset.card_pair hyz]
  have hcurrentB : matchingEdgeAt hH F v ≠ B := by
    intro heq
    apply hvB
    rw [← heq]
    exact (matchingEdgeAt_spec hH hF v).2
  have hcurrentC : matchingEdgeAt hH F v ≠ C := by
    intro heq
    apply hvC
    rw [← heq]
    exact (matchingEdgeAt_spec hH hF v).2
  refine ⟨B, C, hBF, hCF, hBC, hcurrentB, hcurrentC,
    hBinter, hCinter, ?_⟩
  rw [hErase]
  intro x hx
  simp only [Finset.mem_insert, Finset.mem_singleton] at hx
  rcases hx with rfl | rfl
  · exact Finset.mem_union_left _ hyB
  · exact Finset.mem_union_right _ hzC

/-- For a generic candidate, both partner vertices remain available
exactly when their two matching edges have later exposure rank. -/
lemma candidatePartners_subset_available_iff_generic_pair_after {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v)
    {T B C : Edge n} (hBF : B ∈ F) (hCF : C ∈ F)
    (hBC : B ≠ C)
    (hcurrentB : matchingEdgeAt hH F v ≠ B)
    (hcurrentC : matchingEdgeAt hH F v ≠ C)
    (hTsub : T.erase v ⊆ B ∪ C)
    (hBmeet : ¬Disjoint B (T.erase v))
    (hCmeet : ¬Disjoint C (T.erase v)) :
    T.erase v ⊆
        matchingKahnAvailableVertices hH F (permutationPrior perm v) v ↔
      B ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v) ∧
        C ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v) := by
  let A := matchingEdgeAt hH F v
  have hAF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  rw [matchingKahnAvailableVertices_eq_current_union_after
      hH hF perm v hfirst]
  constructor
  · intro hsub
    constructor
    · obtain ⟨y, hyB, hyT⟩ := Finset.not_disjoint_iff.mp hBmeet
      have hyAvail := hsub hyT
      rcases Finset.mem_union.mp hyAvail with hyA | hyAfter
      · exact False.elim (Finset.disjoint_left.mp
          ((mem_perfectMatchings.mp hF).2.2 hBF hAF hcurrentB.symm)
          hyB (Finset.mem_of_mem_erase hyA))
      · rcases Finset.mem_biUnion.mp hyAfter with ⟨D, hDafter, hyD⟩
        have hDB : D = B := by
          by_contra hDB
          exact Finset.disjoint_left.mp
            ((mem_perfectMatchings.mp hF).2.2
              (Finset.mem_filter.mp hDafter).1 hBF hDB)
            hyD hyB
        simpa only [hDB] using hDafter
    · obtain ⟨z, hzC, hzT⟩ := Finset.not_disjoint_iff.mp hCmeet
      have hzAvail := hsub hzT
      rcases Finset.mem_union.mp hzAvail with hzA | hzAfter
      · exact False.elim (Finset.disjoint_left.mp
          ((mem_perfectMatchings.mp hF).2.2 hCF hAF hcurrentC.symm)
          hzC (Finset.mem_of_mem_erase hzA))
      · rcases Finset.mem_biUnion.mp hzAfter with ⟨D, hDafter, hzD⟩
        have hDC : D = C := by
          by_contra hDC
          exact Finset.disjoint_left.mp
            ((mem_perfectMatchings.mp hF).2.2
              (Finset.mem_filter.mp hDafter).1 hCF hDC)
            hzD hzC
        simpa only [hDC] using hDafter
  · rintro ⟨hBafter, hCafter⟩ x hxT
    have hxBC := hTsub hxT
    rcases Finset.mem_union.mp hxBC with hxB | hxC
    · exact Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨B, hBafter, hxB⟩)
    · exact Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨C, hCafter, hxC⟩)

/-- Exact generic survival fiber, now stated directly for Kahn's
available-vertex set. -/
lemma generic_candidate_survival_exact_count {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {T : Edge n} {v : Vertex n}
    (hTH : T ∈ H) (hvT : v ∈ T)
    (hgen : 2 ≤ (matchingOtherMeetingEdges F v T).card)
    {j : ℕ} (hj : j < n) :
    (3 * n * (n - 1) * (n - 2)) *
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
          T.erase v ⊆ matchingKahnAvailableVertices hH F
            (permutationPrior perm v) v)).card =
    ((n - j - 1) * (n - j - 2)) *
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card := by
  obtain ⟨B, C, hBF, hCF, hBC, hcurrentB, hcurrentC,
    hBmeet, hCmeet, hTsub⟩ :=
    exists_generic_matching_edge_pair hH hF hTH hvT hgen
  have hcount := generic_two_after_exact_count hH hF v hBF hCF
    hBC hcurrentB hcurrentC hj
  have hfilter :
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
          T.erase v ⊆ matchingKahnAvailableVertices hH F
            (permutationPrior perm v) v)) =
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).filter
        (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
          B ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v) ∧
          C ∈ matchingEdgesAfter perm F (matchingEdgeAt hH F v))) := by
    ext perm
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨hfirst, hrank, hsub⟩
      exact ⟨hfirst, hrank,
        (candidatePartners_subset_available_iff_generic_pair_after
          hH hF perm v hfirst hBF hCF hBC hcurrentB hcurrentC
          hTsub hBmeet hCmeet).mp hsub⟩
    · rintro ⟨hfirst, hrank, hBafter, hCafter⟩
      exact ⟨hfirst, hrank,
        (candidatePartners_subset_available_iff_generic_pair_after
          hH hF perm v hfirst hBF hCF hBC hcurrentB hcurrentC
          hTsub hBmeet hCmeet).mpr ⟨hBafter, hCafter⟩⟩
  rw [hfilter]
  exact hcount


/-- Kahn's `Z_v`: if the edge at `v` was already revealed, retain that
edge; otherwise retain the set of vertices still available for its
partners. -/
def matchingKahnZ {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (prior : List (Vertex n)) (v : Vertex n) :
    Sum (Edge n) (Finset (Vertex n)) :=
  if matchingKahnPreviouslyExposed hH F prior v then
    Sum.inl (matchingEdgeAt hH F v)
  else
    Sum.inr (matchingKahnAvailableVertices hH F prior v)

/-- The same availability variable computed from a bare prefix code. -/
noncomputable def matchingKahnZFromCode {n : ℕ}
    (v : Vertex n) (code : List (Edge n)) :
    Sum (Edge n) (Finset (Vertex n)) := by
  classical
  by_cases h : ∃ A ∈ code, v ∈ A
  · exact Sum.inl h.choose
  · exact Sum.inr
      (((Finset.univ : Finset (Vertex n)).erase v) \
        code.toFinset.biUnion id)

lemma matchingKahnZ_eq_fromCode {n : ℕ} {H F : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    (prior : List (Vertex n)) (v : Vertex n) :
    matchingKahnZ hH F prior v =
      matchingKahnZFromCode v (matchingPrefixCode hH prior F) := by
  classical
  let code := matchingPrefixCode hH prior F
  by_cases h : ∃ A ∈ code, v ∈ A
  · have hprev : matchingKahnPreviouslyExposed hH F prior v := by
      simpa only [matchingKahnPreviouslyExposed, code]
        using h
    rw [matchingKahnZ, if_pos hprev]
    change Sum.inl (matchingEdgeAt hH F v) =
      matchingKahnZFromCode v code
    rw [matchingKahnZFromCode, dif_pos h]
    have hAcode := h.choose_spec.1
    rcases List.mem_map.mp hAcode with ⟨u, huprior, hAu⟩
    change matchingEdgeAt hH F u = h.choose at hAu
    have hAuF : matchingEdgeAt hH F u ∈ F :=
      (matchingEdgeAt_spec hH hF u).1
    have hvAu : v ∈ matchingEdgeAt hH F u := by
      rw [hAu]
      exact h.choose_spec.2
    have heq : matchingEdgeAt hH F v = matchingEdgeAt hH F u :=
      matchingEdgeAt_eq_of_mem hH hF hAuF hvAu
    apply congrArg Sum.inl
    exact heq.trans hAu
  · have hprev : ¬matchingKahnPreviouslyExposed hH F prior v := by
      simpa only [matchingKahnPreviouslyExposed, code]
        using h
    rw [matchingKahnZ, if_neg hprev]
    change Sum.inr (matchingKahnAvailableVertices hH F prior v) =
      matchingKahnZFromCode v code
    rw [matchingKahnZFromCode, dif_neg h]
    simp only [matchingKahnAvailableVertices, code]

/-- The Kahn availability variable is a function of the finer prefix
code on the perfect-matching sample space. -/
lemma matchingKahnZ_isFunctionOf_prefixCode {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (prior : List (Vertex n)) (v : Vertex n) :
    ∀ F ∈ perfectMatchings n H,
      matchingKahnZ hH F prior v =
        matchingKahnZFromCode v (matchingPrefixCode hH prior F) := by
  intro F hF
  exact matchingKahnZ_eq_fromCode hH hF prior v

/-- Sum of the conditional entropies after replacing every exact prefix
by Kahn's coarser availability variable. -/
def matchingKahnConditionalSum {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) :
    List (Vertex n) → List (Vertex n) → ℝ
  | _prior, [] => 0
  | prior, v :: rest =>
      finiteConditionalEntropy (perfectMatchings n H)
          (fun F ↦ matchingEdgeAt hH F v)
          (fun F ↦ matchingKahnZ hH F prior v) +
        matchingKahnConditionalSum hH (prior ++ [v]) rest

/-- The contribution at position `i` in a fixed vertex order.  The
out-of-range branch is used only to make this a total function on naturals. -/
noncomputable def matchingKahnPositionCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (order : List (Vertex n)) (i : ℕ) : ℝ := by
  classical
  by_cases hi : i < order.length
  · exact finiteConditionalEntropy (perfectMatchings n H)
      (fun F ↦ matchingEdgeAt hH F order[i])
      (fun F ↦ matchingKahnZ hH F (order.take i) order[i])
  · exact 0

lemma matchingKahnConditionalSum_take_drop {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (order : List (Vertex n)) (k : ℕ) (hk : k ≤ order.length) :
    matchingKahnConditionalSum hH [] order =
      (∑ i ∈ Finset.range k, matchingKahnPositionCost hH order i) +
        matchingKahnConditionalSum hH (order.take k) (order.drop k) := by
  induction k with
  | zero => simp [matchingKahnConditionalSum]
  | succ k ih =>
      have hklt : k < order.length := by omega
      have ih' := ih (Nat.le_of_lt hklt)
      rw [ih']
      have hdrop := List.drop_eq_getElem_cons hklt
      rw [hdrop, matchingKahnConditionalSum, Finset.sum_range_succ]
      have htake := List.take_concat_get' order k hklt
      rw [htake]
      simp only [matchingKahnPositionCost, dif_pos hklt]
      ring

lemma matchingKahnConditionalSum_eq_sum_positionCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (order : List (Vertex n)) :
    matchingKahnConditionalSum hH [] order =
      ∑ i ∈ Finset.range order.length,
        matchingKahnPositionCost hH order i := by
  have h := matchingKahnConditionalSum_take_drop hH order order.length le_rfl
  simpa [matchingKahnConditionalSum] using h

/-- The fixed-permutation contribution indexed by the labelled vertex
rather than by its position in the order. -/
def matchingKahnVertexCost {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) : ℝ :=
  finiteConditionalEntropy (perfectMatchings n H)
    (fun F ↦ matchingEdgeAt hH F v)
    (fun F ↦ matchingKahnZ hH F (permutationPrior perm v) v)

lemma matchingKahnPositionCost_vertexExposureOrder {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (perm : Equiv.Perm (Vertex n)) (i : ℕ) (hi : i < 3 * n) :
    matchingKahnPositionCost hH (vertexExposureOrder perm) i =
      matchingKahnVertexCost hH perm (perm ⟨i, hi⟩) := by
  have hilength : i < (vertexExposureOrder perm).length := by simpa using hi
  have hget := getElem_vertexExposureOrder perm i hi
  have hpos : permutationPosition perm (perm ⟨i, hi⟩) = i := by
    simp [permutationPosition]
  have hprior : (vertexExposureOrder perm).take i =
      permutationPrior perm (perm ⟨i, hi⟩) := by
    rw [permutationPrior, hpos]
  unfold matchingKahnPositionCost matchingKahnVertexCost
  rw [dif_pos hilength]
  simp only [hget, hprior]

/-- A fixed-order Kahn cost is equivalently the sum of the labelled
vertex contributions. -/
lemma matchingKahnConditionalSum_vertexExposureOrder_eq_sum {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (perm : Equiv.Perm (Vertex n)) :
    matchingKahnConditionalSum hH [] (vertexExposureOrder perm) =
      ∑ v : Vertex n, matchingKahnVertexCost hH perm v := by
  rw [matchingKahnConditionalSum_eq_sum_positionCost,
    length_vertexExposureOrder]
  apply Finset.sum_bij
      (fun i hi ↦ perm ⟨i, Finset.mem_range.mp hi⟩)
  · intro i hi
    exact Finset.mem_univ _
  · intro i hi j hj hij
    have hfin : (⟨i, Finset.mem_range.mp hi⟩ : Vertex n) =
        ⟨j, Finset.mem_range.mp hj⟩ := perm.injective hij
    exact congrArg Fin.val hfin
  · intro v hv
    refine ⟨permutationPosition perm v, ?_, ?_⟩
    · exact Finset.mem_range.mpr (perm.symm v).isLt
    · simp [permutationPosition]
  · intro i hi
    exact matchingKahnPositionCost_vertexExposureOrder
      hH perm i (Finset.mem_range.mp hi)

lemma finiteConditionalChainCost_matching_le_kahn {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (prior rest : List (Vertex n)) :
    finiteConditionalChainCost (perfectMatchings n H)
        (fun F v ↦ matchingEdgeAt hH F v) prior rest ≤
      matchingKahnConditionalSum hH prior rest := by
  induction rest generalizing prior with
  | nil => simp [finiteConditionalChainCost, matchingKahnConditionalSum]
  | cons v rest ih =>
      simp only [finiteConditionalChainCost, matchingKahnConditionalSum]
      apply add_le_add
      · exact finiteConditionalEntropy_mono_of_comp
          (perfectMatchings n H)
          (fun F ↦ matchingEdgeAt hH F v)
          (matchingPrefixCode hH prior)
          (fun F ↦ matchingKahnZ hH F prior v)
          (matchingKahnZFromCode v)
          (Finset.card_ne_zero.mp hΦ)
          (matchingKahnZ_isFunctionOf_prefixCode hH prior v)
      · exact ih (prior ++ [v])

/-- Finite form of Kahn's inequalities (29)--(30) for one fixed vertex
order. -/
lemma log_card_perfectMatchings_le_kahnConditionalSum {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (order : List (Vertex n))
    (horder : ∀ v : Vertex n, v ∈ order) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      matchingKahnConditionalSum hH [] order := by
  have hinj : Set.InjOn
      (finitePrefixCode (fun F v ↦ matchingEdgeAt hH F v) order)
      (↑(perfectMatchings n H) : Set (Finset (Edge n))) := by
    intro F hF G hG hcode
    apply matchingEdgeAt_injectiveOn hH hF hG
    funext v
    exact (finitePrefixCode_eq_iff
      (fun F v ↦ matchingEdgeAt hH F v) order F G).1 hcode v (horder v)
  have hchain := log_card_eq_finiteConditionalChainCost
    (perfectMatchings n H) (fun F v ↦ matchingEdgeAt hH F v)
    order (Finset.card_ne_zero.mp hΦ) hinj
  rw [hchain]
  exact finiteConditionalChainCost_matching_le_kahn hH hΦ [] order

/-- The joint sample of an independent uniform vertex permutation and a
uniform perfect matching. -/
def matchingPermutationSample (n : ℕ) (H : Finset (Edge n)) :
    Finset (Equiv.Perm (Vertex n) × Finset (Edge n)) :=
  (Finset.univ : Finset (Equiv.Perm (Vertex n))) ×ˢ perfectMatchings n H

def matchingJointKahnZ {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n)) :
    Sum (Edge n) (Finset (Vertex n)) :=
  matchingKahnZ hH q.2 (permutationPrior q.1 v) v

/-- Averaging (29)--(30) over the independent random permutation and
then forgetting the permutation from the conditioning variable gives
Kahn's joint finite inequality (30). -/
lemma log_card_perfectMatchings_le_sum_jointKahnConditionalEntropy
    {n : ℕ} {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      ∑ v : Vertex n,
        finiteConditionalEntropy (matchingPermutationSample n H)
          (fun q ↦ matchingEdgeAt hH q.2 v)
          (matchingJointKahnZ hH v) := by
  let P := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let S := perfectMatchings n H
  have hP : P.Nonempty := ⟨Equiv.refl _, Finset.mem_univ _⟩
  have hS : S.Nonempty := Finset.card_ne_zero.mp hΦ
  have hPS : (P ×ˢ S).Nonempty := by
    obtain ⟨perm, hperm⟩ := hP
    obtain ⟨F, hF⟩ := hS
    exact ⟨(perm, F), Finset.mem_product.mpr ⟨hperm, hF⟩⟩
  have hfixed : ∀ perm ∈ P,
      Real.log ((perfectMatchings n H).card : ℝ) ≤
        ∑ v : Vertex n, matchingKahnVertexCost hH perm v := by
    intro perm hperm
    rw [← matchingKahnConditionalSum_vertexExposureOrder_eq_sum hH perm]
    exact log_card_perfectMatchings_le_kahnConditionalSum hH hΦ
      (vertexExposureOrder perm) (mem_vertexExposureOrder perm)
  have havgFixed :
      Real.log ((perfectMatchings n H).card : ℝ) ≤
        finsetAverage P (fun perm ↦
          ∑ v : Vertex n, matchingKahnVertexCost hH perm v) := by
    have h := finsetAverage_mono P
      (fun _perm ↦ Real.log ((perfectMatchings n H).card : ℝ))
      (fun perm ↦ ∑ v : Vertex n, matchingKahnVertexCost hH perm v)
      hfixed
    simpa [finsetAverage, P, hP] using h
  have hswap :
      finsetAverage P (fun perm ↦
          ∑ v : Vertex n, matchingKahnVertexCost hH perm v) =
        ∑ v : Vertex n,
          finsetAverage P (fun perm ↦ matchingKahnVertexCost hH perm v) := by
    unfold finsetAverage
    rw [Finset.sum_comm, Finset.sum_div]
  calc
    Real.log ((perfectMatchings n H).card : ℝ) ≤
        finsetAverage P (fun perm ↦
          ∑ v : Vertex n, matchingKahnVertexCost hH perm v) := havgFixed
    _ = ∑ v : Vertex n,
          finsetAverage P (fun perm ↦ matchingKahnVertexCost hH perm v) :=
      hswap
    _ ≤ ∑ v : Vertex n,
          finiteConditionalEntropy (matchingPermutationSample n H)
            (fun q ↦ matchingEdgeAt hH q.2 v)
            (matchingJointKahnZ hH v) := by
      apply Finset.sum_le_sum
      intro v hv
      let Z : Equiv.Perm (Vertex n) → Finset (Edge n) →
          Sum (Edge n) (Finset (Vertex n)) := fun perm F ↦
        matchingKahnZ hH F (permutationPrior perm v) v
      have heq := finiteConditionalEntropy_product_eq_average
        P S (fun F ↦ matchingEdgeAt hH F v) Z hP hS
      have hdata := finiteConditionalEntropy_mono_of_comp
        (P ×ˢ S) (fun q ↦ matchingEdgeAt hH q.2 v)
        (fun q ↦ (q.1, Z q.1 q.2)) (fun q ↦ Z q.1 q.2)
        Prod.snd hPS (by intro q hq; rfl)
      rw [heq] at hdata
      unfold matchingKahnVertexCost matchingPermutationSample
        matchingJointKahnZ
      simpa only [P, S, Z] using hdata

/-! ### The scalar estimate in Kahn's permutation average -/

/-- The reciprocal-square-root sum occurring in the fourth-root error
estimate. -/
def reciprocalSqrtSum (m : ℕ) : ℝ :=
  ∑ i ∈ Finset.range m, 1 / Real.sqrt (i + 1 : ℕ)

lemma one_div_sqrt_le_two_mul_sqrt_sub (t : ℕ) (ht : 0 < t) :
    (1 : ℝ) / Real.sqrt t ≤
      2 * (Real.sqrt t - Real.sqrt ((t - 1 : ℕ) : ℝ)) := by
  have htR : (0 : ℝ) < t := by exact_mod_cast ht
  have htmR : (0 : ℝ) ≤ ((t - 1 : ℕ) : ℝ) := by positivity
  have hsqrtPos : 0 < Real.sqrt t := Real.sqrt_pos.2 htR
  have hsqrtMono : Real.sqrt (t - 1 : ℕ) ≤ Real.sqrt t := by
    apply Real.sqrt_le_sqrt
    exact_mod_cast Nat.sub_le t 1
  have htSq : (Real.sqrt t)^2 = (t : ℝ) := Real.sq_sqrt htR.le
  have htmSq : (Real.sqrt (t - 1 : ℕ))^2 = ((t - 1 : ℕ) : ℝ) :=
    Real.sq_sqrt htmR
  have hcast : ((t - 1 : ℕ) : ℝ) = (t : ℝ) - 1 := by
    rw [Nat.cast_sub (Nat.one_le_iff_ne_zero.2 ht.ne')]
    norm_num
  apply (div_le_iff₀ hsqrtPos).2
  rw [hcast] at htmSq hsqrtMono
  rw [hcast]
  nlinarith [sq_nonneg (Real.sqrt t - Real.sqrt ((t - 1 : ℕ) : ℝ))]

lemma reciprocalSqrtSum_le (m : ℕ) :
    reciprocalSqrtSum m ≤ 2 * Real.sqrt m := by
  unfold reciprocalSqrtSum
  calc
    (∑ i ∈ Finset.range m, 1 / Real.sqrt (i + 1 : ℕ)) ≤
        ∑ i ∈ Finset.range m,
          2 * (Real.sqrt (i + 1 : ℕ) - Real.sqrt i) := by
      apply Finset.sum_le_sum
      intro i hi
      simpa only [Nat.add_sub_cancel] using
        one_div_sqrt_le_two_mul_sqrt_sub (i + 1) (by omega)
    _ = 2 * Real.sqrt m := by
      rw [← Finset.mul_sum]
      congr 1
      simpa only [Nat.cast_add, Nat.cast_one, Nat.cast_zero,
        Real.sqrt_zero, sub_zero]
        using (Finset.sum_range_sub (fun i : ℕ ↦ Real.sqrt (i : ℝ)) m)

/-- The logarithmic sum whose main term is `-m`. -/
def normalizedLogSum (m : ℕ) : ℝ :=
  ∑ i ∈ Finset.range m, Real.log (((i + 1 : ℕ) : ℝ) / m)

def harmonicSum (m : ℕ) : ℝ :=
  ∑ i ∈ Finset.range m, (1 : ℝ) / (i + 1 : ℕ)

lemma normalizedLogSum_succ (m : ℕ) (hm : 0 < m) :
    normalizedLogSum (m + 1) = normalizedLogSum m +
      (m : ℝ) * Real.log ((m : ℝ) / (m + 1 : ℝ)) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hsuccR : (0 : ℝ) < m + 1 := by positivity
  rw [normalizedLogSum, Finset.sum_range_succ, normalizedLogSum]
  simp only [Nat.cast_add, Nat.cast_one]
  have hterm : ∀ i ∈ Finset.range m,
      Real.log (((i : ℝ) + 1) / ((m : ℝ) + 1)) =
        Real.log (((i : ℝ) + 1) / (m : ℝ)) +
          Real.log ((m : ℝ) / ((m : ℝ) + 1)) := by
    intro i hi
    have hiR : (0 : ℝ) < (i + 1 : ℕ) := by positivity
    rw [← Real.log_mul (by positivity :
      (((i : ℝ) + 1) / (m : ℝ)) ≠ 0) (by positivity :
        ((m : ℝ) / ((m : ℝ) + 1)) ≠ 0)]
    congr 1
    field_simp
  rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib,
    Finset.sum_const, nsmul_eq_mul]
  norm_num only [Finset.card_range, Nat.cast_ofNat, Nat.cast_add,
    Nat.cast_one, div_self hsuccR.ne', Real.log_one, add_zero]

lemma harmonicSum_succ (m : ℕ) :
    harmonicSum (m + 1) = harmonicSum m + 1 / (m + 1 : ℕ) := by
  rw [harmonicSum, Finset.sum_range_succ, harmonicSum]

/-- An elementary finite upper bound for the main logarithmic sum. -/
lemma normalizedLogSum_le_neg_add_harmonic (m : ℕ) :
    normalizedLogSum m ≤ -(m : ℝ) + harmonicSum m := by
  obtain rfl | m := m
  · simp [normalizedLogSum, harmonicSum]
  induction m with
  | zero => simp [normalizedLogSum, harmonicSum]
  | succ m ih =>
      have hm : 0 < m + 1 := by omega
      rw [normalizedLogSum_succ (m + 1) hm, harmonicSum_succ]
      norm_num only [Nat.cast_add, Nat.cast_one] at ih ⊢
      have hlog : Real.log (((m + 1 : ℕ) : ℝ) /
          ((m + 1 : ℕ) + 1 : ℕ)) ≤
          -(1 : ℝ) / (((m + 1 : ℕ) : ℝ) + 1) := by
        have hx : (0 : ℝ) <
            ((m + 1 : ℕ) : ℝ) / (((m + 1 : ℕ) : ℝ) + 1) := by
          positivity
        have h := Real.log_le_sub_one_of_pos hx
        calc
          Real.log (((m + 1 : ℕ) : ℝ) /
              ((m + 1 : ℕ) + 1 : ℕ)) ≤
              ((m + 1 : ℕ) : ℝ) /
                (((m + 1 : ℕ) : ℝ) + 1) - 1 := by
            simpa only [Nat.cast_add, Nat.cast_one] using h
          _ = -(1 : ℝ) / (((m + 1 : ℕ) : ℝ) + 1) := by
            field_simp
            ring
      have hmul0 := mul_le_mul_of_nonneg_left hlog (by positivity :
        (0 : ℝ) ≤ (m + 1 : ℕ))
      have hmul : (((m + 1 : ℕ) : ℝ) *
          Real.log (((m + 1 : ℕ) : ℝ) /
            ((m + 1 : ℕ) + 1 : ℕ))) ≤
          -(((m + 1 : ℕ) : ℝ)) /
            (((m + 1 : ℕ) : ℝ) + 1) := by
        calc
          (((m + 1 : ℕ) : ℝ) * Real.log (((m + 1 : ℕ) : ℝ) /
              ((m + 1 : ℕ) + 1 : ℕ))) ≤
              ((m + 1 : ℕ) : ℝ) *
                (-(1 : ℝ) / (((m + 1 : ℕ) : ℝ) + 1)) := hmul0
          _ = -(((m + 1 : ℕ) : ℝ)) /
                (((m + 1 : ℕ) : ℝ) + 1) := by ring
      have hfrac : -(((m + 1 : ℕ) : ℝ)) /
            (((m + 1 : ℕ) : ℝ) + 1) =
          -1 + 1 / (((m + 1 : ℕ) : ℝ) + 1) := by
        field_simp
        ring
      norm_num only [Nat.cast_add, Nat.cast_one] at hmul hfrac
      calc
        normalizedLogSum (m + 1) +
            (((m : ℝ) + 1) * Real.log (((m : ℝ) + 1) /
              ((m : ℝ) + 1 + 1))) ≤
            (-((m : ℝ) + 1) + harmonicSum (m + 1)) +
              (-((m : ℝ) + 1) / ((m : ℝ) + 1 + 1)) :=
            add_le_add ih hmul
        _ = -((m : ℝ) + 1 + 1) +
              (harmonicSum (m + 1) + 1 / ((m : ℝ) + 1 + 1)) := by
            rw [hfrac]
            ring

lemma harmonicSum_le_reciprocalSqrtSum (m : ℕ) :
    harmonicSum m ≤ reciprocalSqrtSum m := by
  unfold harmonicSum reciprocalSqrtSum
  apply Finset.sum_le_sum
  intro i hi
  have hiPos : (0 : ℝ) < (i + 1 : ℕ) := by positivity
  have hsqrtPos : (0 : ℝ) < Real.sqrt (i + 1 : ℕ) := by positivity
  apply (div_le_div_iff₀ hiPos hsqrtPos).2
  have hsqrtLe : Real.sqrt (i + 1 : ℕ) ≤ ((i + 1 : ℕ) : ℝ) := by
    have hone : (1 : ℝ) ≤ (i + 1 : ℕ) := by
      exact_mod_cast Nat.le_add_left 1 i
    nlinarith [Real.sq_sqrt hiPos.le]
  nlinarith

lemma normalizedLogSum_le (m : ℕ) :
    normalizedLogSum m ≤ -(m : ℝ) + 2 * Real.sqrt m := by
  calc
    normalizedLogSum m ≤ -(m : ℝ) + harmonicSum m :=
      normalizedLogSum_le_neg_add_harmonic m
    _ ≤ -(m : ℝ) + reciprocalSqrtSum m := by
      gcongr
      exact harmonicSum_le_reciprocalSqrtSum m
    _ ≤ -(m : ℝ) + 2 * Real.sqrt m := by
      gcongr
      exact reciprocalSqrtSum_le m

/-- A global elementary bound for the logarithmic perturbation. -/
lemma log_one_add_sq_le_five_sqrt (x : ℝ) (hx : 0 ≤ x) :
    Real.log (1 + x^2) ≤ 5 * Real.sqrt x := by
  by_cases hx1 : x ≤ 1
  · have hpos : 0 < 1 + x^2 := by positivity
    have hlog := Real.log_le_sub_one_of_pos hpos
    have hsqrt0 : 0 ≤ Real.sqrt x := Real.sqrt_nonneg _
    have hsqrtSq : (Real.sqrt x)^2 = x := Real.sq_sqrt hx
    have hsqrt1 : Real.sqrt x ≤ 1 := Real.sqrt_le_one.mpr hx1
    nlinarith [sq_nonneg x, mul_self_le_mul_self hx hx1,
      mul_self_le_mul_self hsqrt0 hsqrt1]
  · have hxgt : 1 < x := lt_of_not_ge hx1
    have hxpos : 0 < x := lt_trans (by norm_num) hxgt
    have harg : 1 + x^2 ≤ 2 * x^2 := by
      nlinarith [mul_self_le_mul_self (show (0 : ℝ) ≤ 1 by norm_num) hxgt.le]
    have hlogMono : Real.log (1 + x^2) ≤ Real.log (2 * x^2) := by
      exact Real.strictMonoOn_log.monotoneOn
        (show (0 : ℝ) < 1 + x^2 by positivity)
        (show (0 : ℝ) < 2 * x^2 by positivity) harg
    have hlogExpand : Real.log (2 * x^2) =
        Real.log 2 + 2 * Real.log x := by
      rw [Real.log_mul (by norm_num) (pow_ne_zero 2 hxpos.ne'),
        Real.log_pow]
      norm_num
    have hlog2 : Real.log 2 ≤ 1 := by
      have h := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)
      norm_num at h ⊢
      exact h
    have hsqrtPos : 0 < Real.sqrt x := Real.sqrt_pos.2 hxpos
    have hsqrt1 : 1 ≤ Real.sqrt x := Real.one_le_sqrt.mpr hxgt.le
    have hlogSqrt : Real.log (Real.sqrt x) ≤ Real.sqrt x - 1 :=
      Real.log_le_sub_one_of_pos hsqrtPos
    have hlogx : Real.log x = 2 * Real.log (Real.sqrt x) := by
      calc
        Real.log x = Real.log ((Real.sqrt x)^2) := by
          rw [Real.sq_sqrt hx]
        _ = 2 * Real.log (Real.sqrt x) := by
          simpa using Real.log_pow (Real.sqrt x) 2
    rw [hlogExpand] at hlogMono
    nlinarith

def logarithmicSquareErrorSum (m : ℕ) (gamma : ℝ) : ℝ :=
  ∑ i ∈ Finset.range m,
    Real.log (1 + gamma * (((m : ℝ) / (i + 1 : ℕ))^2))

/-- The total perturbation is bounded by a fourth root of `gamma`; this
weaker power is enough for Kahn's `E1` estimate and avoids a logarithmic
loss. -/
lemma logarithmicSquareErrorSum_le (m : ℕ) (gamma : ℝ)
    (hgamma : 0 ≤ gamma) :
    logarithmicSquareErrorSum m gamma ≤
      10 * (m : ℝ) * Real.sqrt (Real.sqrt gamma) := by
  have hgammaSq : (Real.sqrt gamma)^2 = gamma := Real.sq_sqrt hgamma
  have hpoint : ∀ i ∈ Finset.range m,
      Real.log (1 + gamma * (((m : ℝ) / (i + 1 : ℕ))^2)) ≤
        5 * (Real.sqrt m * Real.sqrt (Real.sqrt gamma) /
          Real.sqrt (i + 1 : ℕ)) := by
    intro i hi
    let x : ℝ := (m : ℝ) * Real.sqrt gamma / (i + 1 : ℕ)
    have hx : 0 ≤ x := by
      dsimp only [x]
      positivity
    have hlog := log_one_add_sq_le_five_sqrt x hx
    have hinside : gamma * (((m : ℝ) / (i + 1 : ℕ))^2) = x^2 := by
      dsimp only [x]
      field_simp
      nlinarith
    rw [hinside]
    calc
      Real.log (1 + x^2) ≤ 5 * Real.sqrt x := hlog
      _ = 5 * (Real.sqrt m * Real.sqrt (Real.sqrt gamma) /
          Real.sqrt (i + 1 : ℕ)) := by
        dsimp only [x]
        rw [Real.sqrt_div (mul_nonneg (by positivity) (Real.sqrt_nonneg _)),
          Real.sqrt_mul (by positivity)]
  unfold logarithmicSquareErrorSum
  calc
    (∑ i ∈ Finset.range m,
        Real.log (1 + gamma * (((m : ℝ) / (i + 1 : ℕ))^2))) ≤
        ∑ i ∈ Finset.range m,
          5 * (Real.sqrt m * Real.sqrt (Real.sqrt gamma) /
            Real.sqrt (i + 1 : ℕ)) :=
      Finset.sum_le_sum hpoint
    _ = (5 * Real.sqrt m * Real.sqrt (Real.sqrt gamma)) *
          reciprocalSqrtSum m := by
      unfold reciprocalSqrtSum
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ ≤ (5 * Real.sqrt m * Real.sqrt (Real.sqrt gamma)) *
          (2 * Real.sqrt m) := by
      exact mul_le_mul_of_nonneg_left (reciprocalSqrtSum_le m) (by positivity)
    _ = 10 * (m : ℝ) * Real.sqrt (Real.sqrt gamma) := by
      rw [show (5 * Real.sqrt m * Real.sqrt (Real.sqrt gamma)) *
          (2 * Real.sqrt m) =
          10 * (Real.sqrt m)^2 * Real.sqrt (Real.sqrt gamma) by ring,
        Real.sq_sqrt (show (0 : ℝ) ≤ m by positivity)]

/-- The scalar logarithmic average appearing after Kahn's exact
permutation count. -/
def kahnScalarSum (m : ℕ) (gamma : ℝ) : ℝ :=
  ∑ i ∈ Finset.range m,
    Real.log (gamma + (1 - gamma) *
      ((((i + 1 : ℕ) : ℝ) / m)^2))

/-- For 3-uniform hypergraphs, Kahn's scalar sum has main term `-2m` and
a uniform error tending to zero after division by `3m`. -/
lemma kahnScalarSum_le (m : ℕ) (gamma : ℝ) (hm : 0 < m)
    (hgamma0 : 0 ≤ gamma) (hgamma1 : gamma ≤ 1) :
    kahnScalarSum m gamma ≤
      -2 * (m : ℝ) + 4 * Real.sqrt m +
        10 * (m : ℝ) * Real.sqrt (Real.sqrt gamma) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hpoint : ∀ i ∈ Finset.range m,
      Real.log (gamma + (1 - gamma) *
          ((((i + 1 : ℕ) : ℝ) / m)^2)) ≤
        2 * Real.log (((i + 1 : ℕ) : ℝ) / m) +
          Real.log (1 + gamma * (((m : ℝ) / (i + 1 : ℕ))^2)) := by
    intro i hi
    have hiR : (0 : ℝ) < (i + 1 : ℕ) := by positivity
    let a : ℝ := ((i + 1 : ℕ) : ℝ) / m
    let b : ℝ := (m : ℝ) / (i + 1 : ℕ)
    have ha : 0 < a := by dsimp only [a]; positivity
    have hb : 0 < b := by dsimp only [b]; positivity
    have hab : a * b = 1 := by
      dsimp only [a, b]
      field_simp
    have hleft : 0 < gamma + (1 - gamma) * a^2 := by
      have haSq : 0 < a^2 := sq_pos_of_pos ha
      by_cases hg : gamma = 1
      · simp [hg]
      · have hglt : gamma < 1 := lt_of_le_of_ne hgamma1 hg
        have hone : 0 < 1 - gamma := sub_pos.mpr hglt
        positivity
    have hright : 0 < a^2 * (1 + gamma * b^2) := by positivity
    have harg : gamma + (1 - gamma) * a^2 ≤
        a^2 * (1 + gamma * b^2) := by
      have habSq : a^2 * b^2 = 1 := by
        nlinarith [sq_nonneg (a * b - 1)]
      nlinarith [sq_nonneg a]
    have hlogMono := Real.strictMonoOn_log.monotoneOn hleft hright harg
    calc
      Real.log (gamma + (1 - gamma) *
          ((((i + 1 : ℕ) : ℝ) / m)^2)) =
          Real.log (gamma + (1 - gamma) * a^2) := by rfl
      _ ≤ Real.log (a^2 * (1 + gamma * b^2)) := hlogMono
      _ = 2 * Real.log a + Real.log (1 + gamma * b^2) := by
        rw [Real.log_mul (pow_ne_zero 2 ha.ne') (by positivity), Real.log_pow]
        norm_num
      _ = 2 * Real.log (((i + 1 : ℕ) : ℝ) / m) +
          Real.log (1 + gamma * (((m : ℝ) / (i + 1 : ℕ))^2)) := by
        rfl
  unfold kahnScalarSum
  calc
    (∑ i ∈ Finset.range m,
        Real.log (gamma + (1 - gamma) *
          ((((i + 1 : ℕ) : ℝ) / m)^2))) ≤
        ∑ i ∈ Finset.range m,
          (2 * Real.log (((i + 1 : ℕ) : ℝ) / m) +
            Real.log (1 + gamma * (((m : ℝ) / (i + 1 : ℕ))^2))) :=
      Finset.sum_le_sum hpoint
    _ = 2 * normalizedLogSum m + logarithmicSquareErrorSum m gamma := by
      unfold normalizedLogSum logarithmicSquareErrorSum
      rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    _ ≤ 2 * (-(m : ℝ) + 2 * Real.sqrt m) +
          (10 * (m : ℝ) * Real.sqrt (Real.sqrt gamma)) := by
      exact add_le_add
        (mul_le_mul_of_nonneg_left (normalizedLogSum_le m) (by norm_num))
        (logarithmicSquareErrorSum_le m gamma hgamma0)
    _ = -2 * (m : ℝ) + 4 * Real.sqrt m +
          10 * (m : ℝ) * Real.sqrt (Real.sqrt gamma) := by ring

/-- Perfect matchings agreeing with `F` on all coordinates already
exposed in `prior`. -/
def matchingPrefixFiber {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (prior : List (Vertex n)) : Finset (Finset (Edge n)) :=
  (perfectMatchings n H).filter fun G ↦
    ∀ u ∈ prior, matchingEdgeAt hH G u = matchingEdgeAt hH F u

lemma mem_matchingPrefixFiber {n : ℕ} {H : Finset (Edge n)}
    {hH : H ⊆ allEdges n} {F G : Finset (Edge n)}
    {prior : List (Vertex n)} :
    G ∈ matchingPrefixFiber hH F prior ↔
      G ∈ perfectMatchings n H ∧
        ∀ u ∈ prior, matchingEdgeAt hH G u = matchingEdgeAt hH F u := by
  simp [matchingPrefixFiber]

lemma self_mem_matchingPrefixFiber {n : ℕ} {H F : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    (prior : List (Vertex n)) :
    F ∈ matchingPrefixFiber hH F prior := by
  exact mem_matchingPrefixFiber.mpr ⟨hF, fun u hu ↦ rfl⟩

lemma finiteMapFiber_matchingPrefixFiber {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (prior : List (Vertex n)) (v : Vertex n) :
    finiteMapFiber (matchingPrefixFiber hH F prior)
        (fun G ↦ matchingEdgeAt hH G v) (matchingEdgeAt hH F v) =
      matchingPrefixFiber hH F (prior ++ [v]) := by
  ext G
  simp only [finiteMapFiber, Finset.mem_filter, mem_matchingPrefixFiber,
    List.mem_append, List.mem_singleton]
  constructor
  · rintro ⟨⟨hG, hprior⟩, hv⟩
    refine ⟨hG, fun u hu ↦ ?_⟩
    rcases hu with hu | rfl
    · exact hprior u hu
    · exact hv
  · rintro ⟨hG, hall⟩
    refine ⟨⟨hG, fun u hu ↦ hall u (Or.inl hu)⟩, ?_⟩
    exact hall v (Or.inr rfl)

/-- Candidate edges through `v` that avoid every matching edge exposed by
an earlier vertex. -/
def matchingAvailableEdges {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (prior : List (Vertex n)) (v : Vertex n) : Finset (Edge n) :=
  H.filter fun B ↦ v ∈ B ∧
    ∀ u ∈ prior, Disjoint B (matchingEdgeAt hH F u)

/-- Whether the edge through `v` has already been revealed by an earlier
vertex coordinate. -/
def matchingPreviouslyExposed {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n))
    (prior : List (Vertex n)) (v : Vertex n) : Prop :=
  ∃ u ∈ prior, v ∈ matchingEdgeAt hH F u

/-- If the edge at `v` was already exposed then the next coordinate has
only one possible value. -/
lemma image_matchingEdgeAt_eq_singleton_of_previouslyExposed {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (prior : List (Vertex n))
    (v : Vertex n) (hexposed : matchingPreviouslyExposed hH F prior v) :
    (matchingPrefixFiber hH F prior).image
        (fun G ↦ matchingEdgeAt hH G v) =
      {matchingEdgeAt hH F v} := by
  obtain ⟨u, huprior, hvu⟩ := hexposed
  ext B
  constructor
  · intro hB
    rcases Finset.mem_image.mp hB with ⟨G, hGprefix, rfl⟩
    rcases mem_matchingPrefixFiber.mp hGprefix with ⟨hG, hagree⟩
    have hGu : matchingEdgeAt hH G u = matchingEdgeAt hH F u :=
      hagree u huprior
    have hAuG : matchingEdgeAt hH F u ∈ G := by
      rw [← hGu]
      exact (matchingEdgeAt_spec hH hG u).1
    have hAvG : v ∈ matchingEdgeAt hH F u := hvu
    have hGv : matchingEdgeAt hH G v = matchingEdgeAt hH F u :=
      matchingEdgeAt_eq_of_mem hH hG hAuG hAvG
    have hFv : matchingEdgeAt hH F v = matchingEdgeAt hH F u :=
      matchingEdgeAt_eq_of_mem hH hF
        (matchingEdgeAt_spec hH hF u).1 hvu
    simp [hGv, hFv]
  · intro hB
    have hBF : B = matchingEdgeAt hH F v := Finset.mem_singleton.mp hB
    subst B
    exact Finset.mem_image.mpr
      ⟨F, self_mem_matchingPrefixFiber hH hF prior, rfl⟩

/-- Before `v` is exposed, every coordinate value compatible with the
prefix is an edge through `v` disjoint from all earlier exposed matching
edges. -/
lemma image_matchingEdgeAt_subset_available_of_not_previouslyExposed
    {n : ℕ} {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (prior : List (Vertex n))
    (v : Vertex n) (hnot : ¬matchingPreviouslyExposed hH F prior v) :
    (matchingPrefixFiber hH F prior).image
        (fun G ↦ matchingEdgeAt hH G v) ⊆
      matchingAvailableEdges hH F prior v := by
  intro B hB
  rcases Finset.mem_image.mp hB with ⟨G, hGprefix, rfl⟩
  rcases mem_matchingPrefixFiber.mp hGprefix with ⟨hG, hagree⟩
  apply Finset.mem_filter.mpr
  refine ⟨(mem_perfectMatchings.mp hG).1
      (matchingEdgeAt_spec hH hG v).1,
    (matchingEdgeAt_spec hH hG v).2, ?_⟩
  intro u huprior
  have hGu : matchingEdgeAt hH G u = matchingEdgeAt hH F u :=
    hagree u huprior
  have hAuG : matchingEdgeAt hH F u ∈ G := by
    rw [← hGu]
    exact (matchingEdgeAt_spec hH hG u).1
  have hAvG : matchingEdgeAt hH G v ∈ G :=
    (matchingEdgeAt_spec hH hG v).1
  have hne : matchingEdgeAt hH G v ≠ matchingEdgeAt hH F u := by
    intro heq
    apply hnot
    exact ⟨u, huprior, by
      rw [← heq]
      exact (matchingEdgeAt_spec hH hG v).2⟩
  exact (mem_perfectMatchings.mp hG).2.2 hAvG hAuG hne

/-- The actual edge at an as-yet unexposed vertex is available, so the
candidate set is nonempty. -/
lemma matchingAvailableEdges_nonempty_of_not_previouslyExposed {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (prior : List (Vertex n))
    (v : Vertex n) (hnot : ¬matchingPreviouslyExposed hH F prior v) :
    (matchingAvailableEdges hH F prior v).Nonempty := by
  let A := matchingEdgeAt hH F v
  refine ⟨A, Finset.mem_filter.mpr ⟨
    (mem_perfectMatchings.mp hF).1 (matchingEdgeAt_spec hH hF v).1,
    (matchingEdgeAt_spec hH hF v).2, ?_⟩⟩
  intro u huprior
  have hAuF : matchingEdgeAt hH F u ∈ F :=
    (matchingEdgeAt_spec hH hF u).1
  have hAvF : A ∈ F := (matchingEdgeAt_spec hH hF v).1
  have hne : A ≠ matchingEdgeAt hH F u := by
    intro heq
    apply hnot
    exact ⟨u, huprior, by
      rw [← heq]
      exact (matchingEdgeAt_spec hH hF v).2⟩
  exact (mem_perfectMatchings.mp hF).2.2 hAvF hAuF hne

/-- Explicit upper cost for a fixed matching and vertex order: a vertex
whose edge was already exposed contributes zero; otherwise it contributes
the logarithm of the number of edges still compatible with the exposed
matching edges. -/
def matchingAvailableExposureCost {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n)) :
    List (Vertex n) → List (Vertex n) → ℝ
  | _prior, [] => 0
  | prior, v :: rest =>
      (if matchingPreviouslyExposed hH F prior v then 0
       else Real.log ((matchingAvailableEdges hH F prior v).card : ℝ)) +
        matchingAvailableExposureCost hH F (prior ++ [v]) rest

/-- The abstract decision-tree branching cost is pointwise bounded by the
explicit available-edge exposure cost. -/
lemma finiteDecisionCost_matchingPrefixFiber_le_availableCost {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (prior rest : List (Vertex n)) :
    finiteDecisionCost (matchingPrefixFiber hH F prior)
        (fun G v ↦ matchingEdgeAt hH G v) rest F ≤
      matchingAvailableExposureCost hH F prior rest := by
  induction rest generalizing prior with
  | nil => simp [finiteDecisionCost, matchingAvailableExposureCost]
  | cons v rest ih =>
      have hrecursive := ih (prior ++ [v])
      rw [finiteDecisionCost, matchingAvailableExposureCost,
        finiteMapFiber_matchingPrefixFiber]
      let I : Finset (Edge n) :=
        @Finset.image (Finset (Edge n)) (Edge n) (Classical.decEq _)
          (fun G ↦ matchingEdgeAt hH G v) (matchingPrefixFiber hH F prior)
      change Real.log (I.card : ℝ) +
          finiteDecisionCost (matchingPrefixFiber hH F (prior ++ [v]))
            (fun G v ↦ matchingEdgeAt hH G v) rest F ≤ _
      by_cases hexposed : matchingPreviouslyExposed hH F prior v
      · rw [if_pos hexposed]
        have hI : I = {matchingEdgeAt hH F v} := by
          have hstd :=
            image_matchingEdgeAt_eq_singleton_of_previouslyExposed
              hH hF prior v hexposed
          ext B
          have hm := Finset.ext_iff.mp hstd B
          simpa only [I, Finset.mem_image, Finset.mem_singleton] using hm
        rw [hI]
        simp only [Finset.card_singleton, Nat.cast_one, Real.log_one,
          zero_add]
        exact hrecursive
      · rw [if_neg hexposed]
        have hsubStd :=
          image_matchingEdgeAt_subset_available_of_not_previouslyExposed
            hH hF prior v hexposed
        have hsub : I ⊆ matchingAvailableEdges hH F prior v := by
          intro B hBI
          apply hsubStd
          simpa only [I, Finset.mem_image] using hBI
        have himageNonempty : I.Nonempty := by
          refine ⟨matchingEdgeAt hH F v, ?_⟩
          simp only [I, Finset.mem_image]
          exact ⟨F, self_mem_matchingPrefixFiber hH hF prior, rfl⟩
        have havailableNonempty :=
          matchingAvailableEdges_nonempty_of_not_previouslyExposed
            hH hF prior v hexposed
        have hleftPos : (0 : ℝ) < I.card := by
          exact_mod_cast Finset.card_pos.mpr himageNonempty
        have hrightPos : (0 : ℝ) <
            (matchingAvailableEdges hH F prior v).card := by
          exact_mod_cast Finset.card_pos.mpr havailableNonempty
        have hcard :
            (I.card : ℝ) ≤
              (matchingAvailableEdges hH F prior v).card := by
          exact_mod_cast Finset.card_le_card hsub
        have hlog :
            Real.log (I.card : ℝ) ≤
              Real.log ((matchingAvailableEdges hH F prior v).card : ℝ) :=
          Real.strictMonoOn_log.monotoneOn hleftPos hrightPos hcard
        exact add_le_add hlog hrecursive

lemma matchingPrefixFiber_nil {n : ℕ} {H F : Finset (Edge n)}
    (hH : H ⊆ allEdges n) :
    matchingPrefixFiber hH F [] = perfectMatchings n H := by
  ext G
  simp [matchingPrefixFiber]

/-- Pointwise available-edge upper bound for the exposure cost starting
from the unconditioned perfect-matching family. -/
lemma finiteDecisionCost_perfectMatchings_le_availableCost {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (order : List (Vertex n)) :
    finiteDecisionCost (perfectMatchings n H)
        (fun G v ↦ matchingEdgeAt hH G v) order F ≤
      matchingAvailableExposureCost hH F [] order := by
  rw [← matchingPrefixFiber_nil (F := F) hH]
  exact finiteDecisionCost_matchingPrefixFiber_le_availableCost
    hH hF [] order

/-- Fixed-order entropy bound expressed entirely by compatible available
edges along the exposure. -/
lemma log_card_perfectMatchings_le_average_availableCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (perm : Equiv.Perm (Vertex n)) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      finsetAverage (perfectMatchings n H)
        (fun F ↦ matchingAvailableExposureCost hH F []
          (vertexExposureOrder perm)) := by
  have hbase := log_card_perfectMatchings_le_exposureCost hH hΦ perm
  exact hbase.trans (finsetAverage_mono _ _ _ fun F hF ↦
    finiteDecisionCost_perfectMatchings_le_availableCost
      hH hF (vertexExposureOrder perm))

/-- Averaged form of the available-edge exposure bound over all vertex
permutations. -/
lemma log_card_perfectMatchings_le_average_permutation_availableCost
    {n : ℕ} {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      finsetAverage (Finset.univ : Finset (Equiv.Perm (Vertex n)))
        (fun perm ↦ finsetAverage (perfectMatchings n H)
          (fun F ↦ matchingAvailableExposureCost hH F []
            (vertexExposureOrder perm))) := by
  have havg := finsetAverage_mono
    (Finset.univ : Finset (Equiv.Perm (Vertex n)))
    (fun _perm ↦ Real.log ((perfectMatchings n H).card : ℝ))
    (fun perm ↦ finsetAverage (perfectMatchings n H)
      (fun F ↦ matchingAvailableExposureCost hH F []
        (vertexExposureOrder perm)))
    (fun perm _ ↦
      log_card_perfectMatchings_le_average_availableCost hH hΦ perm)
  simpa [finsetAverage] using havg

/-- Kahn's finite `E1` estimate.  A nonnegative mass vector whose entropy is
within `C N` of the uniform maximum cannot put much mass on indices for
which a second nonnegative statistic `gamma` is large.  Splitting at
`gamma = sigma`, Markov bounds the number of exceptional indices, while the
two-block log-sum estimate bounds the mass carried by them. -/
lemma finiteWeightedSqrtError_le_of_entropy_near_max {α : Type*}
    (s : Finset α) (p gamma : α → ℝ) (N C G sigma : ℝ)
    (hN : 0 < N) (hC : 0 ≤ C) (hG : 0 < G) (hsigma : 0 < sigma)
    (hp : ∀ x ∈ s, 0 ≤ p x)
    (htotal : ∑ x ∈ s, p x = N)
    (hgamma0 : ∀ x ∈ s, 0 ≤ gamma x)
    (hgamma1 : ∀ x ∈ s, gamma x ≤ 1)
    (hgammaSum : ∑ x ∈ s, gamma x ≤ G)
    (hEntropy :
      N * Real.log ((s.card : ℝ) / N) - C * N ≤ finiteEntropy s p)
    (hratio : 1 < (s.card : ℝ) * sigma / G) :
    (∑ x ∈ s, p x * Real.sqrt (gamma x)) ≤
      N * Real.sqrt sigma +
        N * (C + Real.log 2) /
          Real.log ((s.card : ℝ) * sigma / G) := by
  classical
  let R : α → Prop := fun x ↦ sigma < gamma x
  let a : ℝ := ∑ x ∈ s.filter R, p x
  have hsNonempty : s.Nonempty := by
    by_contra hempty
    rw [Finset.not_nonempty_iff_eq_empty.mp hempty] at htotal
    simp at htotal
    linarith
  have hl : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hsNonempty
  have ha0 : 0 ≤ a := by
    dsimp only [a]
    apply Finset.sum_nonneg
    intro x hx
    exact hp x (Finset.mem_filter.mp hx).1
  have hpoint : ∀ x ∈ s,
      p x * Real.sqrt (gamma x) ≤
        p x * Real.sqrt sigma + if R x then p x else 0 := by
    intro x hx
    have hpx := hp x hx
    by_cases hxR : R x
    · rw [if_pos hxR]
      have hsqrt1 : Real.sqrt (gamma x) ≤ 1 :=
        Real.sqrt_le_one.mpr (hgamma1 x hx)
      have hsqrtSigma : 0 ≤ Real.sqrt sigma := Real.sqrt_nonneg _
      nlinarith [mul_le_mul_of_nonneg_left hsqrt1 hpx]
    · rw [if_neg hxR]
      have hgammaSigma : gamma x ≤ sigma := by
        dsimp only [R] at hxR
        exact le_of_not_gt hxR
      simpa using mul_le_mul_of_nonneg_left
        (Real.sqrt_le_sqrt hgammaSigma) hpx
  have hsplit :
      (∑ x ∈ s, p x * Real.sqrt (gamma x)) ≤
        N * Real.sqrt sigma + a := by
    calc
      (∑ x ∈ s, p x * Real.sqrt (gamma x)) ≤
          ∑ x ∈ s, (p x * Real.sqrt sigma + if R x then p x else 0) :=
        Finset.sum_le_sum fun x hx ↦ hpoint x hx
      _ = (∑ x ∈ s, p x) * Real.sqrt sigma +
            ∑ x ∈ s, if R x then p x else 0 := by
        rw [Finset.sum_add_distrib, Finset.sum_mul]
      _ = N * Real.sqrt sigma + a := by
        rw [htotal]
        congr 1
        exact (Finset.sum_filter R p).symm
  by_cases ha : a = 0
  · have hlog0 : 0 < Real.log ((s.card : ℝ) * sigma / G) :=
      Real.log_pos hratio
    have hnum0 : 0 ≤ N * (C + Real.log 2) := by
      positivity
    have hfrac0 : 0 ≤
        N * (C + Real.log 2) /
          Real.log ((s.card : ℝ) * sigma / G) :=
      div_nonneg hnum0 hlog0.le
    rw [ha, add_zero] at hsplit
    exact hsplit.trans (le_add_of_nonneg_right hfrac0)
  · have hapos : 0 < a := lt_of_le_of_ne ha0 (Ne.symm ha)
    have htNonempty : (s.filter R).Nonempty := by
      by_contra hempty
      have hemp : s.filter R = ∅ :=
        Finset.not_nonempty_iff_eq_empty.mp hempty
      dsimp only [a] at ha
      rw [hemp] at ha
      simp at ha
    have hT : (0 : ℝ) < (s.filter R).card := by
      exact_mod_cast Finset.card_pos.mpr htNonempty
    have hcardSigma : ((s.filter R).card : ℝ) * sigma ≤ G := by
      have hterm : ∀ x ∈ s.filter R, sigma ≤ gamma x := by
        intro x hx
        exact (Finset.mem_filter.mp hx).2.le
      have hsumFilter :
          ((s.filter R).card : ℝ) * sigma ≤
            ∑ x ∈ s.filter R, gamma x := by
        calc
          ((s.filter R).card : ℝ) * sigma =
              ∑ _x ∈ s.filter R, sigma := by simp
          _ ≤ ∑ x ∈ s.filter R, gamma x :=
            Finset.sum_le_sum hterm
      have hfilterLe :
          (∑ x ∈ s.filter R, gamma x) ≤ ∑ x ∈ s, gamma x := by
        exact Finset.sum_le_sum_of_subset_of_nonneg
          (Finset.filter_subset R s)
          (fun x hxS hxNot ↦ hgamma0 x hxS)
      exact hsumFilter.trans (hfilterLe.trans hgammaSum)
    have hcardRatio :
        (s.card : ℝ) * sigma / G ≤
          (s.card : ℝ) / ((s.filter R).card : ℝ) := by
      have hTG : ((s.filter R).card : ℝ) * sigma / G ≤ 1 := by
        exact (div_le_one hG).2 hcardSigma
      have hTpos : (0 : ℝ) < ((s.filter R).card : ℝ) := hT
      have hGpos : (0 : ℝ) < G := hG
      apply (div_le_div_iff₀ hGpos hTpos).2
      nlinarith
    have hlogRatio :
        Real.log ((s.card : ℝ) * sigma / G) ≤
          Real.log ((s.card : ℝ) / ((s.filter R).card : ℝ)) := by
      apply Real.strictMonoOn_log.monotoneOn
      · exact div_pos (mul_pos hl hsigma) hG
      · exact div_pos hl hT
      · exact hcardRatio
    have htwo := finiteEntropy_le_total_log_card_sub_mass_log_ratio
      s p R N a hN hapos hp htotal (by simpa only [a])
    have haLog :
        a * Real.log ((s.card : ℝ) /
            ((s.filter R).card : ℝ)) ≤
          N * (C + Real.log 2) := by
      nlinarith
    have haRatio :
        a * Real.log ((s.card : ℝ) * sigma / G) ≤
          N * (C + Real.log 2) :=
      (mul_le_mul_of_nonneg_left hlogRatio hapos.le).trans haLog
    have hlog0 : 0 < Real.log ((s.card : ℝ) * sigma / G) :=
      Real.log_pos hratio
    have haBound :
        a ≤ N * (C + Real.log 2) /
          Real.log ((s.card : ℝ) * sigma / G) :=
      (le_div_iff₀ hlog0).2 haRatio
    nlinarith

/-- Fourth-root form of `E1`.  Cauchy--Schwarz first bounds the total
square-root genericity mass, after which the preceding square-root lemma
applies to `sqrt ∘ gamma`. -/
lemma finiteWeightedFourthRootError_le_of_entropy_near_max {α : Type*}
    (s : Finset α) (p gamma : α → ℝ) (N C G sigma : ℝ)
    (hN : 0 < N) (hC : 0 ≤ C) (hG : 0 < G) (hsigma : 0 < sigma)
    (hp : ∀ x ∈ s, 0 ≤ p x)
    (htotal : ∑ x ∈ s, p x = N)
    (hgamma0 : ∀ x ∈ s, 0 ≤ gamma x)
    (hgamma1 : ∀ x ∈ s, gamma x ≤ 1)
    (hgammaSum : ∑ x ∈ s, gamma x ≤ G)
    (hEntropy :
      N * Real.log ((s.card : ℝ) / N) - C * N ≤ finiteEntropy s p)
    (hratio :
      1 < (s.card : ℝ) * sigma /
        (Real.sqrt G * Real.sqrt (s.card : ℝ))) :
    (∑ x ∈ s, p x * Real.sqrt (Real.sqrt (gamma x))) ≤
      N * Real.sqrt sigma +
        N * (C + Real.log 2) /
          Real.log ((s.card : ℝ) * sigma /
            (Real.sqrt G * Real.sqrt (s.card : ℝ))) := by
  have hsNonempty : s.Nonempty := by
    by_contra hempty
    rw [Finset.not_nonempty_iff_eq_empty.mp hempty] at htotal
    simp at htotal
    linarith
  have hsCard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hsNonempty
  have hsumGamma0 : 0 ≤ ∑ x ∈ s, gamma x :=
    Finset.sum_nonneg hgamma0
  have hsumSqrt :
      (∑ x ∈ s, Real.sqrt (gamma x)) ≤
        Real.sqrt G * Real.sqrt (s.card : ℝ) := by
    have hc := Real.sum_mul_le_sqrt_mul_sqrt s
      (fun x ↦ Real.sqrt (gamma x)) (fun _x ↦ (1 : ℝ))
    have hsq :
        (∑ x ∈ s, (Real.sqrt (gamma x))^2) =
          ∑ x ∈ s, gamma x := by
      apply Finset.sum_congr rfl
      intro x hx
      exact Real.sq_sqrt (hgamma0 x hx)
    have hone : (∑ _x ∈ s, (1 : ℝ)^2) = (s.card : ℝ) := by simp
    rw [hsq, hone] at hc
    have hsqrtMono : Real.sqrt (∑ x ∈ s, gamma x) ≤ Real.sqrt G :=
      Real.sqrt_le_sqrt hgammaSum
    calc
      (∑ x ∈ s, Real.sqrt (gamma x)) =
          ∑ x ∈ s, Real.sqrt (gamma x) * 1 := by simp
      _ ≤ Real.sqrt (∑ x ∈ s, gamma x) *
          Real.sqrt (s.card : ℝ) := hc
      _ ≤ Real.sqrt G * Real.sqrt (s.card : ℝ) := by
        exact mul_le_mul_of_nonneg_right hsqrtMono (Real.sqrt_nonneg _)
  exact finiteWeightedSqrtError_le_of_entropy_near_max
    s p (fun x ↦ Real.sqrt (gamma x)) N C
      (Real.sqrt G * Real.sqrt (s.card : ℝ)) sigma
    hN hC (mul_pos (Real.sqrt_pos.2 hG) (Real.sqrt_pos.2 hsCard)) hsigma
    hp htotal
    (fun x hx ↦ Real.sqrt_nonneg _)
    (fun x hx ↦ Real.sqrt_le_one.mpr (hgamma1 x hx))
    hsumSqrt hEntropy hratio

/-- Specialization of `finiteWeightedSqrtError_le_of_entropy_near_max` to
the incidence distribution of a uniformly random perfect matching.  The
combinatorial genericity double count supplies `G = 18 n codegCap`. -/
lemma matchingEntropyGenericityError_le_of_entropy_near_max
    {n codegCap : ℕ} {H : Finset (Edge n)}
    (hn : 0 < n) (hcap : 0 < codegCap)
    (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap)
    (C sigma : ℝ) (hC : 0 ≤ C) (hsigma : 0 < sigma)
    (hEntropy :
      (3 * n : ℝ) *
          Real.log (((matchingIncidentPairs H).card : ℝ) / (3 * n : ℝ)) -
        C * (3 * n : ℝ) ≤
          ∑ v : Vertex n, localMatchingEntropy H v)
    (hratio :
      1 < ((matchingIncidentPairs H).card : ℝ) * sigma /
        ((18 * n * codegCap : ℕ) : ℝ)) :
    matchingEntropyGenericityError H ≤
      (3 * n : ℝ) * Real.sqrt sigma +
        (3 * n : ℝ) * (C + Real.log 2) /
          Real.log (((matchingIncidentPairs H).card : ℝ) * sigma /
            ((18 * n * codegCap : ℕ) : ℝ)) := by
  have hN : (0 : ℝ) < 3 * (n : ℝ) := by positivity
  have hG : (0 : ℝ) < (18 * n * codegCap : ℕ) := by
    exact_mod_cast (by positivity)
  have hp : ∀ p ∈ matchingIncidentPairs H,
      0 ≤ matchingFraction H p.2 := by
    intro p hp
    exact matchingFraction_nonneg H p.2
  have htotal := sum_matchingFraction_matchingIncidentPairs H hH hΦ
  have hgammaSum := sum_matchingGenericFailureFraction_le hH hΦ hcodeg
  have hgammaSum' :
      (∑ p ∈ matchingIncidentPairs H,
          matchingGenericFailureFraction H p.1 p.2) ≤
        ((18 * n * codegCap : ℕ) : ℝ) := by
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using hgammaSum
  have hEntropy' :
      (3 * n : ℝ) *
          Real.log (((matchingIncidentPairs H).card : ℝ) / (3 * n : ℝ)) -
        C * (3 * n : ℝ) ≤
          finiteEntropy (matchingIncidentPairs H)
            (fun p ↦ matchingFraction H p.2) := by
    rw [finiteEntropy, sum_matchingEntropy_matchingIncidentPairs]
    exact hEntropy
  exact finiteWeightedSqrtError_le_of_entropy_near_max
    (matchingIncidentPairs H) (fun p ↦ matchingFraction H p.2)
    (fun p ↦ matchingGenericFailureFraction H p.1 p.2)
    (3 * n : ℝ) C ((18 * n * codegCap : ℕ) : ℝ) sigma
    hN hC hG hsigma hp htotal
    (fun p hp ↦ matchingGenericFailureFraction_nonneg H p.1 p.2)
    (fun p hp ↦ matchingGenericFailureFraction_le_one H p.1 p.2)
    hgammaSum' hEntropy' hratio

/-- Fourth-root specialization of `E1` for the incidence distribution of
a uniform perfect matching. -/
lemma matchingEntropyGenericityFourthError_le_of_entropy_near_max
    {n codegCap : ℕ} {H : Finset (Edge n)}
    (hn : 0 < n) (hcap : 0 < codegCap)
    (hH : H ⊆ allEdges n)
    (hΦ : (perfectMatchings n H).card ≠ 0)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap)
    (C sigma : ℝ) (hC : 0 ≤ C) (hsigma : 0 < sigma)
    (hEntropy :
      (3 * n : ℝ) *
          Real.log (((matchingIncidentPairs H).card : ℝ) / (3 * n : ℝ)) -
        C * (3 * n : ℝ) ≤
          ∑ v : Vertex n, localMatchingEntropy H v)
    (hratio :
      1 < ((matchingIncidentPairs H).card : ℝ) * sigma /
        (Real.sqrt ((18 * n * codegCap : ℕ) : ℝ) *
          Real.sqrt ((matchingIncidentPairs H).card : ℝ))) :
    matchingEntropyGenericityFourthError H ≤
      (3 * n : ℝ) * Real.sqrt sigma +
        (3 * n : ℝ) * (C + Real.log 2) /
          Real.log (((matchingIncidentPairs H).card : ℝ) * sigma /
            (Real.sqrt ((18 * n * codegCap : ℕ) : ℝ) *
              Real.sqrt ((matchingIncidentPairs H).card : ℝ))) := by
  have hN : (0 : ℝ) < 3 * (n : ℝ) := by positivity
  have hG : (0 : ℝ) < (18 * n * codegCap : ℕ) := by
    exact_mod_cast (by positivity)
  have hp : ∀ p ∈ matchingIncidentPairs H,
      0 ≤ matchingFraction H p.2 := by
    intro p hp
    exact matchingFraction_nonneg H p.2
  have htotal := sum_matchingFraction_matchingIncidentPairs H hH hΦ
  have hgammaSum := sum_matchingGenericFailureFraction_le hH hΦ hcodeg
  have hgammaSum' :
      (∑ p ∈ matchingIncidentPairs H,
          matchingGenericFailureFraction H p.1 p.2) ≤
        ((18 * n * codegCap : ℕ) : ℝ) := by
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using hgammaSum
  have hEntropy' :
      (3 * n : ℝ) *
          Real.log (((matchingIncidentPairs H).card : ℝ) / (3 * n : ℝ)) -
        C * (3 * n : ℝ) ≤
          finiteEntropy (matchingIncidentPairs H)
            (fun p ↦ matchingFraction H p.2) := by
    rw [finiteEntropy, sum_matchingEntropy_matchingIncidentPairs]
    exact hEntropy
  exact finiteWeightedFourthRootError_le_of_entropy_near_max
    (matchingIncidentPairs H) (fun p ↦ matchingFraction H p.2)
    (fun p ↦ matchingGenericFailureFraction H p.1 p.2)
    (3 * n : ℝ) C ((18 * n * codegCap : ℕ) : ℝ) sigma
    hN hC hG hsigma hp htotal
    (fun p hp ↦ matchingGenericFailureFraction_nonneg H p.1 p.2)
    (fun p hp ↦ matchingGenericFailureFraction_le_one H p.1 p.2)
    hgammaSum' hEntropy' hratio

/-- Averaging the insertion double count and using the exact adjacent-level
binomial identity bounds the mean number of upper-heavy missing triples. -/
lemma average_coarseUpperBadCount_le {n M : ℕ}
    {a B delta eta : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hnM : n ≤ M)
    (hMtop : M < (allEdges n).card)
    (ha0 : 0 < a) (hB0 : 0 ≤ B) (hdelta : 0 ≤ delta)
    (heta : 0 ≤ eta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hspread : ∀ G : Finset (Edge n),
      CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1)) G →
        PresentWeightSpread G delta eta) :
    finsetAverage (sample n M)
        (coarseUpperBadCount n M a B delta) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) := by
  have hpairNat := card_coarseUpperBadExtensionPairs_le_marked
    hn hM hnM ha0 hB0 hdelta hu
  have hpair :
      ((coarseUpperBadExtensionPairs n M a B delta).card : ℝ) ≤
        (coarseCloseBadMarkedPairs n M a B delta).card := by
    exact_mod_cast hpairNat
  have hmarked := card_coarseCloseBadMarkedPairs_le heta hspread
  have hchooseNat :
      (sample n (M + 1)).card * (M + 1) =
        (sample n M).card * ((allEdges n).card - M) := by
    rw [card_sample, card_sample]
    exact Nat.choose_succ_right_eq (allEdges n).card M
  have hchoose :
      ((sample n (M + 1)).card : ℝ) * ((M + 1 : ℕ) : ℝ) =
        ((sample n M).card : ℝ) *
          (((allEdges n).card - M : ℕ) : ℝ) := by
    exact_mod_cast hchooseNat
  have hsampleNat : 0 < (sample n M).card := by
    rw [card_sample]
    exact Nat.choose_pos hMtop.le
  have hsample : (0 : ℝ) < (sample n M).card := by
    exact_mod_cast hsampleNat
  unfold finsetAverage
  rw [sum_coarseUpperBadCount]
  apply (div_le_iff₀ hsample).2
  calc
    ((coarseUpperBadExtensionPairs n M a B delta).card : ℝ) ≤
        (coarseCloseBadMarkedPairs n M a B delta).card := hpair
    _ ≤ ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := hmarked
    _ = eta * (((sample n (M + 1)).card : ℝ) *
        ((M + 1 : ℕ) : ℝ)) := by ring
    _ = eta * (((sample n M).card : ℝ) *
        (((allEdges n).card - M : ℕ) : ℝ)) := by rw [hchoose]
    _ = eta * (((allEdges n).card - M : ℕ) : ℝ) *
        ((sample n M).card : ℝ) := by ring

/-- Markov's inequality converts the averaged insertion count into a
finite-uniform probability bound. -/
lemma coarseUpperBadCount_probability_le {n M : ℕ}
    {a B delta eta r : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hnM : n ≤ M)
    (hMtop : M < (allEdges n).card)
    (ha0 : 0 < a) (hB0 : 0 ≤ B) (hdelta : 0 ≤ delta)
    (heta : 0 ≤ eta) (hr : 0 < r)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hspread : ∀ G : Finset (Edge n),
      CoarseRegularPerfect n (M + 1) (a / 2) (2 * (B + 1)) G →
        PresentWeightSpread G delta eta) :
    finsetProbability (sample n M)
        (fun H ↦ r ≤ coarseUpperBadCount n M a B delta H) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  have hmarkov := finsetProbability_mul_le_average_of_nonneg
    (sample n M) (coarseUpperBadCount n M a B delta) r
    (fun H _ ↦ coarseUpperBadCount_nonneg n M a B delta H)
  have havg := average_coarseUpperBadCount_le hn hM hnM hMtop
    ha0 hB0 hdelta heta hu hspread
  apply le_of_mul_le_mul_right _ hr
  calc
    finsetProbability (sample n M)
          (fun H ↦ r ≤ coarseUpperBadCount n M a B delta H) * r ≤
        finsetAverage (sample n M)
          (coarseUpperBadCount n M a B delta) := hmarkov
    _ ≤ eta * (((allEdges n).card - M : ℕ) : ℝ) := havg
    _ = (eta * (((allEdges n).card - M : ℕ) : ℝ) / r) * r := by
      field_simp [hr.ne']

/-- Finite-uniform exponential Markov inequality, written without an
ambient probability space. -/
lemma finsetProbability_mul_exp_le_average_exp {α : Type*}
    (s : Finset α) (W : α → ℝ) (μ θ u : ℝ) (hs : s.Nonempty)
    (hθ : 0 ≤ θ) :
    finsetProbability s (fun x ↦ u ≤ W x - μ) * Real.exp (θ * u) ≤
      finsetAverage s (fun x ↦ Real.exp (θ * (W x - μ))) := by
  let t := s.filter (fun x ↦ u ≤ W x - μ)
  have hcardNat : 0 < s.card := Finset.card_pos.mpr hs
  have hcard : (0 : ℝ) < s.card := by exact_mod_cast hcardNat
  have hpoint : ∀ x ∈ t,
      Real.exp (θ * u) ≤ Real.exp (θ * (W x - μ)) := by
    intro x hx
    apply Real.exp_le_exp.mpr
    exact mul_le_mul_of_nonneg_left (Finset.mem_filter.mp hx).2 hθ
  have hconst : (t.card : ℝ) * Real.exp (θ * u) ≤
      ∑ x ∈ t, Real.exp (θ * (W x - μ)) := by
    simpa only [Finset.sum_const, nsmul_eq_mul] using
      (Finset.sum_le_sum hpoint)
  have hsub : t ⊆ s := Finset.filter_subset _ _
  have hsum : ∑ x ∈ t, Real.exp (θ * (W x - μ)) ≤
      ∑ x ∈ s, Real.exp (θ * (W x - μ)) := by
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ ↦
      (Real.exp_pos _).le
  unfold finsetProbability finsetAverage
  dsimp [t] at hconst hsum ⊢
  rw [div_mul_eq_mul_div]
  exact (div_le_div_iff_of_pos_right hcard).2 (hconst.trans hsum)

/-- Exact one-coordinate exponential moment of a finite-set indicator. -/
lemma finsetAverage_exp_indicator_eq {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (theta : ℝ) (hs : s.Nonempty) :
    finsetAverage s
        (fun x ↦ Real.exp
          (theta * (if x ∈ Y then (1 : ℝ) else 0))) =
      1 + ((Y.card : ℝ) / s.card) * (Real.exp theta - 1) := by
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  have hfilter : s.filter (fun x ↦ x ∈ Y) = Y := by
    ext x
    simp only [Finset.mem_filter]
    constructor
    · exact fun hx ↦ hx.2
    · exact fun hx ↦ ⟨hYs hx, hx⟩
  have hpoint : ∀ x,
      Real.exp (theta * W x) =
        1 + (Real.exp theta - 1) * W x := by
    intro x
    by_cases hx : x ∈ Y
    · simp [W, hx]
    · simp [W, hx]
  have hcard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  unfold finsetAverage
  simp_rw [show (fun x ↦ Real.exp
      (theta * (if x ∈ Y then (1 : ℝ) else 0))) =
      (fun x ↦ Real.exp (theta * W x)) by rfl, hpoint]
  rw [Finset.sum_add_distrib, Finset.sum_const]
  simp only [nsmul_eq_mul, ← Finset.mul_sum]
  change ((s.card : ℝ) * 1 + (Real.exp theta - 1) *
      (∑ x ∈ s, W x)) / s.card = _
  have hsumW : ∑ x ∈ s, W x = (Y.card : ℝ) := by
    dsimp [W]
    rw [Finset.sum_boole, hfilter]
  rw [hsumW]
  field_simp [hcard.ne']

/-- Tensorized arbitrary-parameter exponential moment for an iid indicator
sum. -/
lemma finsetAverage_exp_iidIndicator_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (theta : ℝ) (hs : s.Nonempty) :
    let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ Real.exp (theta * iidSum W t omega)) ≤
      Real.exp
        ((t : ℝ) * ((Y.card : ℝ) / s.card) *
          (Real.exp theta - 1)) := by
  dsimp only
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  have hfactor := finsetAverage_exp_iidCenteredSum s W 0 theta t
  have hfactor' :
      finsetAverage (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ Real.exp (theta * iidSum W t omega)) =
        (finsetAverage s
          (fun y ↦ Real.exp (theta * W y))) ^ t := by
    simpa using hfactor
  have havg := finsetAverage_exp_indicator_eq s Y hYs theta hs
  have havgW : finsetAverage s
      (fun y ↦ Real.exp (theta * W y)) =
        1 + ((Y.card : ℝ) / s.card) * (Real.exp theta - 1) := by
    simpa [W] using havg
  let q : ℝ := ((Y.card : ℝ) / s.card) * (Real.exp theta - 1)
  have hstep : finsetAverage s
      (fun y ↦ Real.exp (theta * W y)) ≤ Real.exp q := by
    rw [havgW]
    simpa only [q, add_comm] using Real.add_one_le_exp q
  have havg0 : 0 ≤ finsetAverage s
      (fun y ↦ Real.exp (theta * W y)) := by
    unfold finsetAverage
    positivity
  have hpow := pow_le_pow_left₀ havg0 hstep t
  rw [hfactor']
  calc
    (finsetAverage s
        (fun y ↦ Real.exp (theta * W y))) ^ t ≤
        (Real.exp q)^t := hpow
    _ = Real.exp ((t : ℝ) * q) := by
      rw [← Real.exp_nat_mul]
    _ = Real.exp
        ((t : ℝ) * ((Y.card : ℝ) / s.card) *
          (Real.exp theta - 1)) := by
      congr 1
      dsimp [q]
      ring

/-- Arbitrary-parameter Chernoff bound for iid hits in a specified finite
block.  Unlike the bounded-parameter estimate, this has the strong sparse
upper-tail exponent needed for codegrees. -/
lemma iidHitCount_upper_tail_exp_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (theta k : ℝ) (hs : s.Nonempty) (htheta : 0 ≤ theta) :
    let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ k ≤ iidSum W t omega) ≤
      Real.exp
        ((t : ℝ) * ((Y.card : ℝ) / s.card) *
          (Real.exp theta - 1) - theta * k) := by
  dsimp only
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  have hs0 := hs
  obtain ⟨x, hx⟩ := hs
  let x0 : ↥s := ⟨x, hx⟩
  let omega0 : IidSample s t := fun _ ↦ x0
  have hsample :
      (Finset.univ : Finset (IidSample s t)).Nonempty :=
    ⟨omega0, Finset.mem_univ omega0⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (IidSample s t)) (iidSum W t)
    0 theta k hsample htheta
  simp only [sub_zero] at hmarkov
  have hfactor := finsetAverage_exp_iidCenteredSum s W 0 theta t
  have hfactor' :
      finsetAverage (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ Real.exp (theta * iidSum W t omega)) =
        (finsetAverage s
          (fun y ↦ Real.exp (theta * W y))) ^ t := by
    simpa using hfactor
  have havg := finsetAverage_exp_indicator_eq s Y hYs theta hs0
  have havgW : finsetAverage s
      (fun y ↦ Real.exp (theta * W y)) =
        1 + ((Y.card : ℝ) / s.card) * (Real.exp theta - 1) := by
    simpa [W] using havg
  let q : ℝ := ((Y.card : ℝ) / s.card) * (Real.exp theta - 1)
  have hstep : finsetAverage s
      (fun y ↦ Real.exp (theta * W y)) ≤ Real.exp q := by
    rw [havgW]
    simpa only [q, add_comm] using Real.add_one_le_exp q
  have havg0 : 0 ≤ finsetAverage s
      (fun y ↦ Real.exp (theta * W y)) := by
    unfold finsetAverage
    positivity
  have hpow := pow_le_pow_left₀ havg0 hstep t
  have hmgf :
      finsetAverage (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ Real.exp (theta * iidSum W t omega)) ≤
        Real.exp ((t : ℝ) * q) := by
    rw [hfactor']
    calc
      (finsetAverage s
          (fun y ↦ Real.exp (theta * W y))) ^ t ≤
          (Real.exp q)^t := hpow
      _ = Real.exp ((t : ℝ) * q) := by
        rw [← Real.exp_nat_mul]
  have hexppos : 0 < Real.exp (theta * k) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans (by
    simpa only [q, mul_assoc] using hmgf)

/-- The arbitrary-parameter iid indicator bound transferred to ordered
sampling without replacement. -/
lemma embeddingHitCount_upper_tail_exp_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (theta k : ℝ) (hs : s.Nonempty) (htheta : 0 ≤ theta)
    (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ k ≤ embeddingHitCount Y e) ≤
      2 * Real.exp
        ((t : ℝ) * ((Y.card : ℝ) / s.card) *
          (Real.exp theta - 1) - theta * k) := by
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  let P : (Fin t ↪ ↥s) → Prop := fun e ↦ k ≤ embeddingHitCount Y e
  let Q : IidSample s t → Prop := fun omega ↦ k ≤ iidSum W t omega
  have hinj := half_le_iid_injective_probability s t ht
  have hcondition := probability_embedding_le_iid_div s t P (1 / 2)
    (by norm_num) hinj
  have hsum : ∀ e : Fin t ↪ ↥s,
      iidSum W t e = (embeddingHitCount Y e : ℝ) := by
    intro e
    unfold iidSum embeddingHitCount W
    rw [Finset.sum_boole]
  have hlift :
      finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) ≤
        finsetProbability (Finset.univ : Finset (IidSample s t)) Q := by
    apply finsetProbability_mono_event
    intro omega _ homega
    rcases homega with ⟨hinjomega, hP⟩
    dsimp [P] at hP
    dsimp [Q]
    have hsum' : iidSum W t omega =
        (embeddingHitCount Y ⟨omega, hinjomega⟩ : ℝ) := by
      simpa using hsum ⟨omega, hinjomega⟩
    rw [hsum']
    exact hP
  have htail := iidHitCount_upper_tail_exp_le
    s Y hYs t theta k hs htheta
  change finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤ _
  calc
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤
        finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) / (1 / 2) := hcondition
    _ = 2 * finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) := by ring
    _ ≤ 2 * finsetProbability (Finset.univ : Finset (IidSample s t)) Q :=
      mul_le_mul_of_nonneg_left hlift (by norm_num)
    _ ≤ 2 * Real.exp
        ((t : ℝ) * ((Y.card : ℝ) / s.card) *
          (Real.exp theta - 1) - theta * k) :=
      mul_le_mul_of_nonneg_left (by simpa [Q, W] using htail) (by norm_num)

/-- Arbitrary-parameter lower-tail bound for an iid finite-set hit count. -/
lemma iidHitCount_lower_tail_exp_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (theta k : ℝ) (hs : s.Nonempty) (htheta : 0 ≤ theta) :
    let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ iidSum W t omega ≤ k) ≤
      Real.exp
        ((t : ℝ) * ((Y.card : ℝ) / s.card) *
          (Real.exp (-theta) - 1) + theta * k) := by
  dsimp only
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  obtain ⟨x, hx⟩ := hs
  let x0 : ↥s := ⟨x, hx⟩
  let omega0 : IidSample s t := fun _ ↦ x0
  have hsample :
      (Finset.univ : Finset (IidSample s t)).Nonempty :=
    ⟨omega0, Finset.mem_univ omega0⟩
  let Neg : IidSample s t → ℝ := fun omega ↦ -iidSum W t omega
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (IidSample s t)) Neg 0 theta (-k)
    hsample htheta
  simp only [sub_zero] at hmarkov
  have hmgf := finsetAverage_exp_iidIndicator_le
    s Y hYs t (-theta) ⟨x, hx⟩
  have hmgf' :
      finsetAverage (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ Real.exp (theta * Neg omega)) ≤
        Real.exp
          ((t : ℝ) * ((Y.card : ℝ) / s.card) *
            (Real.exp (-theta) - 1)) := by
    simpa [Neg, neg_mul] using hmgf
  have hevent :
      (Finset.univ : Finset (IidSample s t)).filter
          (fun omega ↦ iidSum W t omega ≤ k) =
        (Finset.univ : Finset (IidSample s t)).filter
          (fun omega ↦ -k ≤ Neg omega) := by
    apply Finset.filter_congr
    intro omega _
    dsimp [Neg]
    constructor <;> intro h <;> linarith
  have hprob :
      finsetProbability (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ iidSum W t omega ≤ k) =
        finsetProbability (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ -k ≤ Neg omega) := by
    unfold finsetProbability
    rw [hevent]
  rw [hprob]
  rw [show (t : ℝ) * ((Y.card : ℝ) / s.card) *
      (Real.exp (-theta) - 1) + theta * k =
    (t : ℝ) * ((Y.card : ℝ) / s.card) *
      (Real.exp (-theta) - 1) - theta * (-k) by ring,
    Real.exp_sub]
  apply (le_div_iff₀ (Real.exp_pos _)).2
  exact hmarkov.trans hmgf'

