/-- Mean-sensitive lower tail transferred to ordered sampling without
replacement. -/
lemma embeddingSum_lower_tail_le_mean {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b theta u : ℝ) (t : ℕ) (hs : s.Nonempty)
    (hb : 0 < b) (hW0 : ∀ x ∈ s, 0 ≤ W x)
    (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (htheta0 : 0 ≤ theta)
    (hthetab : |theta * b| ≤ 1 / 2)
    (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ u ≤ t * finsetAverage s W - iidSum W t e) ≤
      2 * Real.exp
        (theta^2 * ((t : ℝ) * a) * b - theta * u) := by
  let P : (Fin t ↪ ↥s) → Prop :=
    fun e ↦ u ≤ t * finsetAverage s W - iidSum W t e
  let Q : IidSample s t → Prop :=
    fun omega ↦ u ≤ t * finsetAverage s W - iidSum W t omega
  have hinj := half_le_iid_injective_probability s t ht
  have hcondition := probability_embedding_le_iid_div s t P (1 / 2)
    (by norm_num) hinj
  have hlift :
      finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) ≤
        finsetProbability (Finset.univ : Finset (IidSample s t)) Q := by
    apply finsetProbability_mono_event
    intro omega _ homega
    exact homega.2
  have htail := iidSum_lower_tail_le_mean
    s W a b theta u t hs hb hW0 hWb hmean htheta0 hthetab
  change finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤ _
  calc
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤
        finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) / (1 / 2) := hcondition
    _ = 2 * finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) := by ring
    _ ≤ 2 * finsetProbability (Finset.univ : Finset (IidSample s t)) Q :=
      mul_le_mul_of_nonneg_left hlift (by norm_num)
    _ ≤ 2 * Real.exp
          (theta^2 * ((t : ℝ) * a) * b - theta * u) :=
      mul_le_mul_of_nonneg_left htail (by norm_num)

/-- Hypergeometric lower tail for the number of sampled elements in a
specified subset.  This is the form used for Kahn's bottom/top weight
blocks. -/
lemma embeddingHitCount_lower_tail_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (θ u : ℝ) (hs : s.Nonempty) (hθ0 : 0 ≤ θ)
    (hθ : |θ| ≤ 1 / 2) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ u ≤
          (t : ℝ) * ((Y.card : ℝ) / s.card) - embeddingHitCount Y e) ≤
      2 * Real.exp
        (θ^2 * ((t : ℝ) * (1 - (Y.card : ℝ) / s.card)) - θ * u) := by
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  have hfilter : s.filter (fun x ↦ x ∈ Y) = Y := by
    ext x
    simp only [Finset.mem_filter]
    constructor
    · exact fun hx ↦ hx.2
    · exact fun hx ↦ ⟨hYs hx, hx⟩
  have havg : finsetAverage s W = (Y.card : ℝ) / s.card := by
    unfold finsetAverage W
    rw [Finset.sum_boole, hfilter]
  have hsum : ∀ e : Fin t ↪ ↥s,
      iidSum W t e = (embeddingHitCount Y e : ℝ) := by
    intro e
    unfold iidSum embeddingHitCount W
    rw [Finset.sum_boole]
  have htail := embeddingSum_lower_tail_le s W
    ((Y.card : ℝ) / s.card) 1 θ u t hs (by norm_num)
    (fun x hx ↦ by dsimp [W]; split_ifs <;> norm_num)
    (fun x hx ↦ by dsimp [W]; split_ifs <;> norm_num)
    (le_of_eq havg.symm) hθ0 (by simpa using hθ) ht
  simpa only [havg, hsum, mul_one] using htail

/-- Sparse-mean version of the hypergeometric lower tail.  Its exponent is
proportional to the expected number of hits. -/
lemma embeddingHitCount_lower_tail_le_mean {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (theta u : ℝ) (hs : s.Nonempty) (htheta0 : 0 ≤ theta)
    (htheta : |theta| ≤ 1 / 2) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ u ≤
          (t : ℝ) * ((Y.card : ℝ) / s.card) - embeddingHitCount Y e) ≤
      2 * Real.exp
        (theta^2 * ((t : ℝ) * ((Y.card : ℝ) / s.card)) - theta * u) := by
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  have hfilter : s.filter (fun x ↦ x ∈ Y) = Y := by
    ext x
    simp only [Finset.mem_filter]
    constructor
    · exact fun hx ↦ hx.2
    · exact fun hx ↦ ⟨hYs hx, hx⟩
  have havg : finsetAverage s W = (Y.card : ℝ) / s.card := by
    unfold finsetAverage W
    rw [Finset.sum_boole, hfilter]
  have hsum : ∀ e : Fin t ↪ ↥s,
      iidSum W t e = (embeddingHitCount Y e : ℝ) := by
    intro e
    unfold iidSum embeddingHitCount W
    rw [Finset.sum_boole]
  have htail := embeddingSum_lower_tail_le_mean s W
    ((Y.card : ℝ) / s.card) 1 theta u t hs (by norm_num)
    (fun x hx ↦ by dsimp [W]; split_ifs <;> norm_num)
    (fun x hx ↦ by dsimp [W]; split_ifs <;> norm_num)
    (le_of_eq havg) htheta0 (by simpa using htheta) ht
  simpa only [havg, hsum, mul_one] using htail

/-- Sparse-mean upper tail for a hypergeometric hit count. -/
lemma embeddingHitCount_upper_tail_le_mean {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (theta u : ℝ) (hs : s.Nonempty) (htheta0 : 0 ≤ theta)
    (htheta : |theta| ≤ 1 / 2) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ u ≤
          embeddingHitCount Y e -
            (t : ℝ) * ((Y.card : ℝ) / s.card)) ≤
      2 * Real.exp
        (theta^2 * ((t : ℝ) * ((Y.card : ℝ) / s.card)) - theta * u) := by
  let W : α → ℝ := fun x ↦ if x ∈ Y then 1 else 0
  have hfilter : s.filter (fun x ↦ x ∈ Y) = Y := by
    ext x
    simp only [Finset.mem_filter]
    constructor
    · exact fun hx ↦ hx.2
    · exact fun hx ↦ ⟨hYs hx, hx⟩
  have havg : finsetAverage s W = (Y.card : ℝ) / s.card := by
    unfold finsetAverage W
    rw [Finset.sum_boole, hfilter]
  have hsum : ∀ e : Fin t ↪ ↥s,
      iidSum W t e = (embeddingHitCount Y e : ℝ) := by
    intro e
    unfold iidSum embeddingHitCount W
    rw [Finset.sum_boole]
  have htail := embeddingSum_upper_tail_le s W
    ((Y.card : ℝ) / s.card) 1 theta u t hs (by norm_num)
    (fun x hx ↦ by dsimp [W]; split_ifs <;> norm_num)
    (fun x hx ↦ by dsimp [W]; split_ifs <;> norm_num)
    (le_of_eq havg) htheta0 (by simpa using htheta) ht
  simpa only [havg, hsum, mul_one] using htail

/-- A sampled block on which all weights are at least `a` contributes at
least `a` times the number of hits.  This is the deterministic half of the
bottom/top-block sampling argument. -/
lemma mul_embeddingHitCount_le_iidSum {α : Type*} {s : Finset α}
    (W : α → ℝ) (Y : Finset α) (t : ℕ) (e : Fin t ↪ ↥s)
    (a : ℝ) (ha : 0 ≤ a)
    (hW0 : ∀ x ∈ s, 0 ≤ W x)
    (hWY : ∀ x ∈ Y, a ≤ W x) :
    a * embeddingHitCount Y e ≤ iidSum W t e := by
  have hcount : (embeddingHitCount Y e : ℝ) =
      ∑ i : Fin t, if (e i).1 ∈ Y then 1 else 0 := by
    unfold embeddingHitCount
    rw [Finset.sum_boole]
  rw [hcount, Finset.mul_sum]
  unfold iidSum
  apply Finset.sum_le_sum
  intro i _
  by_cases hi : (e i).1 ∈ Y
  · simp only [hi, if_true, mul_one]
    exact hWY _ hi
  · simp only [hi, if_false, mul_zero]
    exact hW0 _ (e i).2

/-- If weights are bounded by `b` everywhere and by `a` on a distinguished
block, every hit in that block saves at least `b-a` from the crude bound
`b t`. -/
lemma iidSum_le_mul_sub_mul_embeddingHitCount {α : Type*}
    {s : Finset α} (W : α → ℝ) (Y : Finset α) (t : ℕ)
    (e : Fin t ↪ ↥s) (a b : ℝ) (hab : a ≤ b)
    (hWb : ∀ x ∈ s, W x ≤ b)
    (hWYa : ∀ x ∈ Y, W x ≤ a) :
    iidSum W t e ≤
      b * (t : ℝ) - (b - a) * embeddingHitCount Y e := by
  have hcount : (embeddingHitCount Y e : ℝ) =
      ∑ i : Fin t, if (e i).1 ∈ Y then 1 else 0 := by
    unfold embeddingHitCount
    rw [Finset.sum_boole]
  have hpoint : ∀ i : Fin t,
      W (e i).1 ≤ b - (b - a) * (if (e i).1 ∈ Y then 1 else 0) := by
    intro i
    by_cases hi : (e i).1 ∈ Y
    · simp only [hi, if_true, mul_one]
      linarith [hWYa _ hi]
    · simp only [hi, if_false, mul_zero, sub_zero]
      exact hWb _ (e i).2
  unfold iidSum
  calc
    (∑ i : Fin t, W (e i).1) ≤
        ∑ i : Fin t,
          (b - (b - a) * (if (e i).1 ∈ Y then 1 else 0)) :=
      Finset.sum_le_sum fun i _ ↦ hpoint i
    _ = b * (t : ℝ) - (b - a) * embeddingHitCount Y e := by
      rw [Finset.sum_sub_distrib, ← Finset.mul_sum, ← hcount]
      simp [mul_comm]

/-- A parameter-free constant-fraction hypergeometric lower tail. -/
lemma embeddingHitCount_three_quarters_le {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (hs : s.Nonempty) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ (embeddingHitCount Y e : ℝ) ≤
          (3 / 4 : ℝ) * (t : ℝ) * ((Y.card : ℝ) / s.card)) ≤
      2 * Real.exp
        (-(((Y.card : ℝ) / s.card)^2 * (t : ℝ)) / 64) := by
  let ρ : ℝ := (Y.card : ℝ) / s.card
  have hcard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  have hρ0 : 0 ≤ ρ := by
    dsimp [ρ]
    positivity
  have hρ1 : ρ ≤ 1 := by
    dsimp [ρ]
    apply (div_le_one hcard).2
    exact_mod_cast Finset.card_le_card hYs
  have hraw := embeddingHitCount_lower_tail_le s Y hYs t
    (ρ / 8) (ρ * t / 4) hs (by positivity)
    (by rw [abs_of_nonneg (by positivity)]; nlinarith) ht
  have hfilter :
      (Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ (embeddingHitCount Y e : ℝ) ≤
            (3 / 4 : ℝ) * (t : ℝ) * ρ) =
        (Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ ρ * t / 4 ≤
            (t : ℝ) * ((Y.card : ℝ) / s.card) -
              embeddingHitCount Y e) := by
    apply Finset.filter_congr
    intro e _
    change ((embeddingHitCount Y e : ℝ) ≤
      (3 / 4 : ℝ) * (t : ℝ) * ρ) ↔
        ρ * (t : ℝ) / 4 ≤ (t : ℝ) * ρ - embeddingHitCount Y e
    constructor <;> intro h <;> linarith
  have harg :
      (ρ / 8)^2 * ((t : ℝ) * (1 - ρ)) -
          (ρ / 8) * (ρ * t / 4) ≤
        -(ρ^2 * (t : ℝ)) / 64 := by
    have hnonneg : 0 ≤ ρ^3 * (t : ℝ) := by positivity
    nlinarith
  unfold finsetProbability at hraw ⊢
  rw [show ((Y.card : ℝ) / s.card) = ρ by rfl]
  rw [hfilter]
  calc
    ((Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ ρ * ↑t / 4 ≤ ↑t * ρ - ↑(embeddingHitCount Y e))).card /
        (Finset.univ : Finset (Fin t ↪ ↥s)).card ≤
        2 * Real.exp
          ((ρ / 8)^2 * ((t : ℝ) * (1 - ρ)) -
            (ρ / 8) * (ρ * t / 4)) := by
      simpa [ρ] using hraw
    _ ≤ 2 * Real.exp (-(ρ^2 * (t : ℝ)) / 64) := by
      exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr harg) (by norm_num)

/-- Constant-fraction hypergeometric lower tail with the sharp sparse scale
`exp(-Omega(t * |Y|/|s|))`. -/
lemma embeddingHitCount_three_quarters_le_mean {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (hs : s.Nonempty) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ (embeddingHitCount Y e : ℝ) ≤
          (3 / 4 : ℝ) * (t : ℝ) * ((Y.card : ℝ) / s.card)) ≤
      2 * Real.exp
        (-((t : ℝ) * ((Y.card : ℝ) / s.card)) / 64) := by
  let rho : ℝ := (Y.card : ℝ) / s.card
  have hrho0 : 0 ≤ rho := by
    dsimp [rho]
    positivity
  have hraw := embeddingHitCount_lower_tail_le_mean s Y hYs t
    (1 / 8) (rho * t / 4) hs (by norm_num) (by norm_num) ht
  have hfilter :
      (Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ (embeddingHitCount Y e : ℝ) ≤
            (3 / 4 : ℝ) * (t : ℝ) * rho) =
        (Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ rho * t / 4 ≤
            (t : ℝ) * ((Y.card : ℝ) / s.card) -
              embeddingHitCount Y e) := by
    apply Finset.filter_congr
    intro e _
    change ((embeddingHitCount Y e : ℝ) ≤
      (3 / 4 : ℝ) * (t : ℝ) * rho) ↔
        rho * (t : ℝ) / 4 ≤ (t : ℝ) * rho - embeddingHitCount Y e
    constructor <;> intro h <;> linarith
  have harg :
      (1 / 8 : ℝ)^2 * ((t : ℝ) * rho) -
          (1 / 8 : ℝ) * (rho * t / 4) =
        -((t : ℝ) * rho) / 64 := by ring
  unfold finsetProbability at hraw ⊢
  rw [show ((Y.card : ℝ) / s.card) = rho by rfl] at hraw ⊢
  rw [hfilter]
  rw [harg] at hraw
  exact hraw

/-- Matching constant-fraction upper tail at the expected-hit scale. -/
lemma embeddingHitCount_five_quarters_le_mean {α : Type*}
    (s Y : Finset α) (hYs : Y ⊆ s) (t : ℕ)
    (hs : s.Nonempty) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ (5 / 4 : ℝ) * (t : ℝ) *
            ((Y.card : ℝ) / s.card) ≤ embeddingHitCount Y e) ≤
      2 * Real.exp
        (-((t : ℝ) * ((Y.card : ℝ) / s.card)) / 64) := by
  let rho : ℝ := (Y.card : ℝ) / s.card
  have hraw := embeddingHitCount_upper_tail_le_mean s Y hYs t
    (1 / 8) (rho * t / 4) hs (by norm_num) (by norm_num) ht
  have hfilter :
      (Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ (5 / 4 : ℝ) * (t : ℝ) * rho ≤
            embeddingHitCount Y e) =
        (Finset.univ : Finset (Fin t ↪ ↥s)).filter
          (fun e ↦ rho * t / 4 ≤
            embeddingHitCount Y e -
              (t : ℝ) * ((Y.card : ℝ) / s.card)) := by
    apply Finset.filter_congr
    intro e _
    change ((5 / 4 : ℝ) * (t : ℝ) * rho ≤
      (embeddingHitCount Y e : ℝ)) ↔
        rho * (t : ℝ) / 4 ≤
          embeddingHitCount Y e - (t : ℝ) * rho
    constructor <;> intro h <;> linarith
  have harg :
      (1 / 8 : ℝ)^2 * ((t : ℝ) * rho) -
          (1 / 8 : ℝ) * (rho * t / 4) =
        -((t : ℝ) * rho) / 64 := by ring
  unfold finsetProbability at hraw ⊢
  rw [show ((Y.card : ℝ) / s.card) = rho by rfl] at hraw ⊢
  rw [hfilter]
  rw [harg] at hraw
  exact hraw

/-- Correct-scale lower tail for the degree of one fixed vertex in an
ordered uniform `M`-edge 3-graph sample. -/
lemma sampledVertexDegree_three_quarters_le (n M : ℕ) (v : Vertex n)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
          (3 / 4 : ℝ) * (M : ℝ) / n) ≤
      2 * Real.exp (-((M : ℝ) / n) / 64) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have htail := embeddingHitCount_three_quarters_le_mean
    (allEdges n) (incidentEdges n v) (incidentEdges_subset n v) M
    hall hM
  rw [incidentEdges_density n v hn] at htail
  simpa only [vertexDegree_historyEdges_eq_hitCount, div_eq_mul_inv,
    one_mul, mul_assoc] using htail

/-- Correct-scale upper tail for the degree of one fixed vertex. -/
lemma sampledVertexDegree_five_quarters_le (n M : ℕ) (v : Vertex n)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ (5 / 4 : ℝ) * (M : ℝ) / n ≤
          vertexDegree (historyEdges e) v) ≤
      2 * Real.exp (-((M : ℝ) / n) / 64) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have htail := embeddingHitCount_five_quarters_le_mean
    (allEdges n) (incidentEdges n v) (incidentEdges_subset n v) M
    hall hM
  rw [incidentEdges_density n v hn] at htail
  simpa only [vertexDegree_historyEdges_eq_hitCount, div_eq_mul_inv,
    one_mul, mul_assoc] using htail

/-- Arbitrary-factor upper tail for the degree of one fixed vertex.  This
version retains the full Bernoulli Chernoff exponent and is used to control
the maximum degree after a union bound over all vertices. -/
lemma sampledVertexDegree_upper_factor_le (n M : ℕ) (v : Vertex n)
    (b : ℝ) (hn : 0 < n) (hb : 1 ≤ b)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ b * ((M : ℝ) / n) ≤
          vertexDegree (historyEdges e) v) ≤
      2 * Real.exp
        (((M : ℝ) / n) * (b - 1 - b * Real.log b)) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hbpos : 0 < b := lt_of_lt_of_le zero_lt_one hb
  have hlog : 0 ≤ Real.log b := Real.log_nonneg hb
  have htail := embeddingHitCount_upper_tail_exp_le
    (allEdges n) (incidentEdges n v) (incidentEdges_subset n v) M
    (Real.log b) (b * ((M : ℝ) / n)) hall hlog hM
  rw [incidentEdges_density n v hn, Real.exp_log hbpos] at htail
  simpa only [vertexDegree_historyEdges_eq_hitCount] using
    htail.trans_eq (by congr 2 <;> ring)

/-- Arbitrary-factor lower tail for the degree of one fixed vertex. -/
lemma sampledVertexDegree_lower_factor_le (n M : ℕ) (v : Vertex n)
    (a : ℝ) (hn : 0 < n) (ha0 : 0 < a) (ha1 : a ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
          a * ((M : ℝ) / n)) ≤
      2 * Real.exp
        (((M : ℝ) / n) * (a - 1 - a * Real.log a)) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hlog : Real.log a ≤ 0 := Real.log_nonpos ha0.le ha1
  have htail := embeddingHitCount_lower_tail_exp_le
    (allEdges n) (incidentEdges n v) (incidentEdges_subset n v) M
    (-Real.log a) (a * ((M : ℝ) / n)) hall (by linarith) hM
  rw [incidentEdges_density n v hn, neg_neg, Real.exp_log ha0] at htail
  simpa only [vertexDegree_historyEdges_eq_hitCount] using
    htail.trans_eq (by congr 2 <;> ring)

/-- Union bound for a degree exceeding an arbitrary fixed multiple of its
mean. -/
lemma sampled_exists_degree_upper_factor_le (n M : ℕ) (b : ℝ)
    (hn : 0 < n) (hb : 1 ≤ b)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ∃ v : Vertex n,
          b * ((M : ℝ) / n) ≤ vertexDegree (historyEdges e) v) ≤
      (3 * n : ℝ) *
        (2 * Real.exp
          (((M : ℝ) / n) * (b - 1 - b * Real.log b))) := by
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ∃ v : Vertex n,
          b * ((M : ℝ) / n) ≤ vertexDegree (historyEdges e) v) ≤
      ∑ v : Vertex n,
        finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun e ↦ b * ((M : ℝ) / n) ≤
            vertexDegree (historyEdges e) v) :=
      by
        convert finsetProbability_exists_le_sum
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun v e ↦ b * ((M : ℝ) / n) ≤
            vertexDegree (historyEdges e) v) using 1
        unfold finsetProbability
        apply congrArg (fun k : ℕ ↦ (k : ℝ) /
          (Finset.univ : Finset (DeletionHistory (allEdges n) M)).card)
        apply congrArg Finset.card
        apply Finset.ext
        intro e
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    _ ≤ ∑ _v : Vertex n,
        2 * Real.exp
          (((M : ℝ) / n) * (b - 1 - b * Real.log b)) :=
      Finset.sum_le_sum fun v _ ↦
        sampledVertexDegree_upper_factor_le n M v b hn hb hM
    _ = (3 * n : ℝ) *
        (2 * Real.exp
          (((M : ℝ) / n) * (b - 1 - b * Real.log b))) := by simp

/-- Union bound for a degree falling below an arbitrary fixed positive
multiple of its mean. -/
lemma sampled_exists_degree_lower_factor_le (n M : ℕ) (a : ℝ)
    (hn : 0 < n) (ha0 : 0 < a) (ha1 : a ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ∃ v : Vertex n,
          (vertexDegree (historyEdges e) v : ℝ) ≤
            a * ((M : ℝ) / n)) ≤
      (3 * n : ℝ) *
        (2 * Real.exp
          (((M : ℝ) / n) * (a - 1 - a * Real.log a))) := by
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ∃ v : Vertex n,
          (vertexDegree (historyEdges e) v : ℝ) ≤
            a * ((M : ℝ) / n)) ≤
      ∑ v : Vertex n,
        finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
            a * ((M : ℝ) / n)) :=
      by
        convert finsetProbability_exists_le_sum
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun v e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
            a * ((M : ℝ) / n)) using 1
        unfold finsetProbability
        apply congrArg (fun k : ℕ ↦ (k : ℝ) /
          (Finset.univ : Finset (DeletionHistory (allEdges n) M)).card)
        apply congrArg Finset.card
        apply Finset.ext
        intro e
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    _ ≤ ∑ _v : Vertex n,
        2 * Real.exp
          (((M : ℝ) / n) * (a - 1 - a * Real.log a)) :=
      Finset.sum_le_sum fun v _ ↦
        sampledVertexDegree_lower_factor_le n M v a hn ha0 ha1 hM
    _ = (3 * n : ℝ) *
        (2 * Real.exp
          (((M : ℝ) / n) * (a - 1 - a * Real.log a))) := by simp

/-- Sparse-mean upper tail for the codegree of one fixed distinct vertex
pair in an ordered uniform `M`-edge sample. -/
lemma sampledVertexCodegree_upper_tail_le (n M : ℕ)
    {u v : Vertex n} (huv : u ≠ v) (theta z : ℝ)
    (hn : 0 < n) (htheta0 : 0 ≤ theta)
    (htheta : |theta| ≤ 1 / 2)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ z ≤
          vertexCodegree (historyEdges e) u v -
            (M : ℝ) * (((3 * n - 2 : ℕ) : ℝ) /
              ((3 * n).choose 3 : ℝ))) ≤
      2 * Real.exp
        (theta^2 * ((M : ℝ) * (((3 * n - 2 : ℕ) : ℝ) /
          ((3 * n).choose 3 : ℝ))) - theta * z) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have htail := embeddingHitCount_upper_tail_le_mean
    (allEdges n) (pairIncidentEdges n u v)
    (pairIncidentEdges_subset n u v) M theta z hall htheta0 htheta hM
  rw [card_pairIncidentEdges n huv, card_allEdges] at htail
  simpa only [vertexCodegree_historyEdges_eq_hitCount] using htail

/-- Taking the exponential parameter `log n` gives a polynomially tiny
tail for codegree at least six. -/
lemma sampledVertexCodegree_six_le (n M : ℕ)
    {u v : Vertex n} (huv : u ≠ v)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ (6 : ℝ) ≤ vertexCodegree (historyEdges e) u v) ≤
      2 * Real.exp
        ((M : ℝ) * (2 / ((n : ℝ) * (3 * n - 1))) *
            ((n : ℝ) - 1) -
          Real.log (n : ℝ) * 6) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hlog : 0 ≤ Real.log (n : ℝ) :=
    Real.log_nonneg (by exact_mod_cast hn)
  have htail := embeddingHitCount_upper_tail_exp_le
    (allEdges n) (pairIncidentEdges n u v)
    (pairIncidentEdges_subset n u v) M (Real.log (n : ℝ)) 6
    hall hlog hM
  rw [pairIncidentEdges_density n huv hn,
    Real.exp_log (by positivity : (0 : ℝ) < n)] at htail
  simpa only [vertexCodegree_historyEdges_eq_hitCount] using htail

/-- A fixed vertex has a bad sampled degree if it lies outside the open
constant-factor window around its expected degree. -/
def SampledVertexDegreeBad (n M : ℕ) (v : Vertex n)
    (e : DeletionHistory (allEdges n) M) : Prop :=
  (vertexDegree (historyEdges e) v : ℝ) ≤
      (3 / 4 : ℝ) * (M : ℝ) / n ∨
    (5 / 4 : ℝ) * (M : ℝ) / n ≤
      vertexDegree (historyEdges e) v

/-- The finite union of all one-vertex bad-degree events.  Materializing
the event as a finset avoids any computational dependence on a large
bounded existential while retaining exactly the same event. -/
noncomputable def sampledDegreeFailureSet (n M : ℕ) :
    Finset (DeletionHistory (allEdges n) M) :=
  (Finset.univ : Finset (Vertex n)).biUnion fun v ↦
    (Finset.univ : Finset (DeletionHistory (allEdges n) M)).filter
      (SampledVertexDegreeBad n M v)

lemma mem_sampledDegreeFailureSet_iff (n M : ℕ)
    (e : DeletionHistory (allEdges n) M) :
    e ∈ sampledDegreeFailureSet n M ↔
      ∃ v : Vertex n, SampledVertexDegreeBad n M v e := by
  classical
  simp [sampledDegreeFailureSet]

/-- The constant-factor degree regularity event used in the random
regularity input to Kahn's deletion argument. -/
def SampledDegreeRegular (n M : ℕ)
    (e : DeletionHistory (allEdges n) M) : Prop :=
  e ∉ sampledDegreeFailureSet n M

/-- Failure of sampled degree regularity is precisely a union of the two
one-vertex tail events. -/
lemma not_sampledDegreeRegular_iff (n M : ℕ)
    (e : DeletionHistory (allEdges n) M) :
    ¬ SampledDegreeRegular n M e ↔
      ∃ v : Vertex n, SampledVertexDegreeBad n M v e := by
  rw [SampledDegreeRegular, not_not,
    mem_sampledDegreeFailureSet_iff]

/-- The two Chernoff tails for one vertex combine into one bad-degree
estimate. -/
lemma sampledVertexDegreeBad_le (n M : ℕ) (v : Vertex n)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (SampledVertexDegreeBad n M v) ≤
      4 * Real.exp (-((M : ℝ) / n) / 64) := by
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (SampledVertexDegreeBad n M v) ≤
      finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦
          (vertexDegree (historyEdges e) v : ℝ) ≤
              (3 / 4 : ℝ) * (M : ℝ) / n ∨
            (5 / 4 : ℝ) * (M : ℝ) / n ≤
              vertexDegree (historyEdges e) v) := by
      apply finsetProbability_mono_event
      intro e _ he
      exact he
    _ ≤
      finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
            (3 / 4 : ℝ) * (M : ℝ) / n) +
        finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun e ↦ (5 / 4 : ℝ) * (M : ℝ) / n ≤
            vertexDegree (historyEdges e) v) :=
      finsetProbability_or_le_add _ _ _
    _ ≤ 2 * Real.exp (-((M : ℝ) / n) / 64) +
        2 * Real.exp (-((M : ℝ) / n) / 64) :=
      add_le_add
        (sampledVertexDegree_three_quarters_le n M v hn hM)
        (sampledVertexDegree_five_quarters_le n M v hn hM)
    _ = 4 * Real.exp (-((M : ℝ) / n) / 64) := by ring

/-- The materialized union of all bad-vertex events has probability at
most the sum of the one-vertex probabilities. -/
lemma sampledDegreeFailureSet_le (n M : ℕ)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ e ∈ sampledDegreeFailureSet n M) ≤
      (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) := by
  classical
  let s : Finset (DeletionHistory (allEdges n) M) := Finset.univ
  let F : Vertex n → Finset (DeletionHistory (allEdges n) M) :=
    fun v ↦ s.filter (SampledVertexDegreeBad n M v)
  have hfailure : sampledDegreeFailureSet n M =
      (Finset.univ : Finset (Vertex n)).biUnion F := by
    simp [sampledDegreeFailureSet, F, s]
  have hsub : sampledDegreeFailureSet n M ⊆ s := by
    intro e he
    rw [hfailure, Finset.mem_biUnion] at he
    rcases he with ⟨v, _, hev⟩
    exact (Finset.mem_filter.mp hev).1
  have hfilter : s.filter (fun e ↦ e ∈ sampledDegreeFailureSet n M) =
      sampledDegreeFailureSet n M := by
    ext e
    simp only [Finset.mem_filter]
    constructor
    · exact fun he ↦ he.2
    · exact fun he ↦ ⟨hsub he, he⟩
  have hcard : (sampledDegreeFailureSet n M).card ≤
      ∑ v : Vertex n, (F v).card := by
    rw [hfailure]
    simpa using (Finset.card_biUnion_le
      (s := (Finset.univ : Finset (Vertex n))) (t := F))
  have hcast : ((sampledDegreeFailureSet n M).card : ℝ) ≤
      ∑ v : Vertex n, ((F v).card : ℝ) := by
    exact_mod_cast hcard
  calc
    finsetProbability s
        (fun e ↦ e ∈ sampledDegreeFailureSet n M) =
        ((sampledDegreeFailureSet n M).card : ℝ) / s.card := by
      unfold finsetProbability
      rw [hfilter]
    _ ≤ (∑ v : Vertex n, ((F v).card : ℝ)) / s.card :=
      div_le_div_of_nonneg_right hcast (by positivity)
    _ = ∑ v : Vertex n,
        finsetProbability s (SampledVertexDegreeBad n M v) := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro v _
      unfold finsetProbability
      simp only [F]
    _ ≤ ∑ _v : Vertex n,
          4 * Real.exp (-((M : ℝ) / n) / 64) :=
      Finset.sum_le_sum fun v _ ↦ sampledVertexDegreeBad_le n M v hn hM
    _ = (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) := by
      simp

/-- Simultaneous degree regularity for a uniform ordered sample: a union
bound over all `3n` vertices retains an exponentially small error at the
expected-degree scale `M/n`. -/
lemma sampledDegreeRegular_compl_le (n M : ℕ)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ¬ SampledDegreeRegular n M e) ≤
      (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) := by
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ¬ SampledDegreeRegular n M e) ≤
      finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ e ∈ sampledDegreeFailureSet n M) := by
      apply finsetProbability_mono_event
      intro e _ he
      exact (not_not.mp he)
    _ ≤ (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) :=
      sampledDegreeFailureSet_le n M hn hM

/-- Vertices whose sampled degrees lie outside the fixed central window. -/
def sampledBadVertices (n M : ℕ)
    (e : DeletionHistory (allEdges n) M) : Finset (Vertex n) :=
  (Finset.univ : Finset (Vertex n)).filter fun v ↦
    SampledVertexDegreeBad n M v e

/-- Double counting identifies the expected number of bad vertices with
the sum of the one-vertex bad probabilities. -/
lemma average_sampledBadVertices_eq_sum_probability (n M : ℕ) :
    finsetAverage
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ((sampledBadVertices n M e).card : ℝ)) =
      ∑ v : Vertex n,
        finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (SampledVertexDegreeBad n M v) := by
  let s := (Finset.univ :
    Finset (DeletionHistory (allEdges n) M))
  have hcount : ∀ e : DeletionHistory (allEdges n) M,
      ((sampledBadVertices n M e).card : ℝ) =
        ∑ v : Vertex n,
          if SampledVertexDegreeBad n M v e then 1 else 0 := by
    intro e
    unfold sampledBadVertices
    rw [Finset.sum_boole]
  unfold finsetAverage finsetProbability
  change (∑ e ∈ s, ((sampledBadVertices n M e).card : ℝ)) / s.card = _
  simp_rw [hcount]
  rw [Finset.sum_comm]
  rw [Finset.sum_div]
  dsimp [s]
  apply Finset.sum_congr rfl
  intro v _
  rw [Finset.sum_boole]

/-- The expected bad-vertex count is bounded by `3n` times the fixed-vertex
Chernoff error. -/
lemma average_sampledBadVertices_le (n M : ℕ)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetAverage
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ((sampledBadVertices n M e).card : ℝ)) ≤
      (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) := by
  rw [average_sampledBadVertices_eq_sum_probability]
  calc
    (∑ v : Vertex n,
        finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (SampledVertexDegreeBad n M v)) ≤
      ∑ _v : Vertex n,
        4 * Real.exp (-((M : ℝ) / n) / 64) :=
      Finset.sum_le_sum fun v _ ↦ sampledVertexDegreeBad_le n M v hn hM
    _ = (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) := by simp

/-- A first-moment bound for the probability that a positive proportion
of vertices have atypical degree. -/
lemma sampledBadVertices_proportion_le (n M : ℕ) (eta : ℝ)
    (hn : 0 < n) (heta : 0 < eta)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ eta * (3 * n : ℝ) ≤
          (sampledBadVertices n M e).card) ≤
      (4 / eta) * Real.exp (-((M : ℝ) / n) / 64) := by
  let s := (Finset.univ :
    Finset (DeletionHistory (allEdges n) M))
  let W : DeletionHistory (allEdges n) M → ℝ :=
    fun e ↦ ((sampledBadVertices n M e).card : ℝ)
  have hthreshold : 0 < eta * (3 * n : ℝ) := by positivity
  have hmarkov := finsetProbability_mul_le_average_of_nonneg
    s W (eta * (3 * n : ℝ)) (fun _ _ ↦ by positivity)
  have havg : finsetAverage s W ≤ (3 * n : ℝ) *
      (4 * Real.exp (-((M : ℝ) / n) / 64)) := by
    simpa [s, W] using average_sampledBadVertices_le n M hn hM
  change finsetProbability s
      (fun e ↦ eta * (3 * n : ℝ) ≤ W e) ≤ _
  apply le_of_mul_le_mul_right _ hthreshold
  calc
    finsetProbability s (fun e ↦ eta * (3 * n : ℝ) ≤ W e) *
        (eta * (3 * n : ℝ)) ≤ finsetAverage s W := hmarkov
    _ ≤ (3 * n : ℝ) *
        (4 * Real.exp (-((M : ℝ) / n) / 64)) := havg
    _ = ((4 / eta) * Real.exp (-((M : ℝ) / n) / 64)) *
        (eta * (3 * n : ℝ)) := by
      field_simp [heta.ne']

/-- Ordered distinct vertex pairs used to index the codegree union. -/
abbrev DistinctVertexPair (n : ℕ) :=
  {p : Vertex n × Vertex n // p.1 ≠ p.2}

/-- The finite union of all events that a distinct pair has codegree at
least six. -/
noncomputable def sampledCodegreeFailureSet (n M : ℕ) :
    Finset (DeletionHistory (allEdges n) M) :=
  (Finset.univ : Finset (DistinctVertexPair n)).biUnion fun p ↦
    (Finset.univ : Finset (DeletionHistory (allEdges n) M)).filter
      (fun e ↦ (6 : ℝ) ≤
        vertexCodegree (historyEdges e) p.1.1 p.1.2)

lemma mem_sampledCodegreeFailureSet_iff (n M : ℕ)
    (e : DeletionHistory (allEdges n) M) :
    e ∈ sampledCodegreeFailureSet n M ↔
      ∃ p : DistinctVertexPair n,
        (6 : ℝ) ≤ vertexCodegree (historyEdges e) p.1.1 p.1.2 := by
  classical
  simp [sampledCodegreeFailureSet]

/-- A union bound over all ordered distinct pairs. -/
lemma sampledCodegreeFailureSet_le (n M : ℕ)
    (hn : 0 < n) (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ e ∈ sampledCodegreeFailureSet n M) ≤
      ((3 * n : ℝ)^2) *
        (2 * Real.exp
          ((M : ℝ) * (2 / ((n : ℝ) * (3 * n - 1))) *
              ((n : ℝ) - 1) -
            Real.log (n : ℝ) * 6)) := by
  classical
  let s : Finset (DeletionHistory (allEdges n) M) := Finset.univ
  let F : DistinctVertexPair n →
      Finset (DeletionHistory (allEdges n) M) := fun p ↦
    s.filter (fun e ↦ (6 : ℝ) ≤
      vertexCodegree (historyEdges e) p.1.1 p.1.2)
  let q : ℝ := 2 * Real.exp
    ((M : ℝ) * (2 / ((n : ℝ) * (3 * n - 1))) *
        ((n : ℝ) - 1) -
      Real.log (n : ℝ) * 6)
  have hfailure : sampledCodegreeFailureSet n M =
      (Finset.univ : Finset (DistinctVertexPair n)).biUnion F := by
    simp [sampledCodegreeFailureSet, F, s]
  have hsub : sampledCodegreeFailureSet n M ⊆ s := by
    intro e he
    rw [hfailure, Finset.mem_biUnion] at he
    rcases he with ⟨p, _, hep⟩
    exact (Finset.mem_filter.mp hep).1
  have hfilter : s.filter (fun e ↦ e ∈ sampledCodegreeFailureSet n M) =
      sampledCodegreeFailureSet n M := by
    ext e
    simp only [Finset.mem_filter]
    constructor
    · exact fun he ↦ he.2
    · exact fun he ↦ ⟨hsub he, he⟩
  have hcard : (sampledCodegreeFailureSet n M).card ≤
      ∑ p : DistinctVertexPair n, (F p).card := by
    rw [hfailure]
    simpa using (Finset.card_biUnion_le
      (s := (Finset.univ : Finset (DistinctVertexPair n))) (t := F))
  have hcast : ((sampledCodegreeFailureSet n M).card : ℝ) ≤
      ∑ p : DistinctVertexPair n, ((F p).card : ℝ) := by
    exact_mod_cast hcard
  have hpairNat : Fintype.card (DistinctVertexPair n) ≤ (3 * n)^2 := by
    calc
      Fintype.card (DistinctVertexPair n) ≤
          Fintype.card (Vertex n × Vertex n) :=
        Fintype.card_subtype_le _
      _ = (3 * n)^2 := by simp [pow_two]
  have hpair : (Fintype.card (DistinctVertexPair n) : ℝ) ≤
      (3 * n : ℝ)^2 := by
    exact_mod_cast hpairNat
  have hq0 : 0 ≤ q := by
    dsimp [q]
    positivity
  calc
    finsetProbability s
        (fun e ↦ e ∈ sampledCodegreeFailureSet n M) =
        ((sampledCodegreeFailureSet n M).card : ℝ) / s.card := by
      unfold finsetProbability
      rw [hfilter]
    _ ≤ (∑ p : DistinctVertexPair n, ((F p).card : ℝ)) / s.card :=
      div_le_div_of_nonneg_right hcast (by positivity)
    _ = ∑ p : DistinctVertexPair n,
        finsetProbability s
          (fun e ↦ (6 : ℝ) ≤
            vertexCodegree (historyEdges e) p.1.1 p.1.2) := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro p _
      unfold finsetProbability
      simp only [F]
    _ ≤ ∑ _p : DistinctVertexPair n, q :=
      Finset.sum_le_sum fun p _ ↦ by
        dsimp [q]
        exact sampledVertexCodegree_six_le n M p.2 hn hM
    _ = (Fintype.card (DistinctVertexPair n) : ℝ) * q := by simp
    _ ≤ ((3 * n : ℝ)^2) * q :=
      mul_le_mul_of_nonneg_right hpair hq0
    _ = ((3 * n : ℝ)^2) *
        (2 * Real.exp
          ((M : ℝ) * (2 / ((n : ℝ) * (3 * n - 1))) *
              ((n : ℝ) - 1) -
            Real.log (n : ℝ) * 6)) := rfl

/-- At the supercritical scale (with relative excess at most one), the
probability that any pair has codegree at least six tends to zero. -/
lemma upper_codegree_failure_bound_tendsto_zero (ε : ℝ)
    (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) :
    Tendsto
      (fun n : ℕ ↦ ((3 * n : ℝ)^2) *
        (2 * Real.exp
          ((upperEdgeCount ε n : ℝ) *
              (2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1) -
            Real.log (n : ℝ) * 6))) atTop (𝓝 0) := by
  let C : ℝ := 18 * Real.exp (2 * Real.log 3 + 1)
  have hnatSq : Tendsto (fun n : ℕ ↦ (n : ℝ)^2) atTop atTop := by
    simpa [pow_two] using
      tendsto_natCast_atTop_atTop.atTop_mul_atTop₀
        tendsto_natCast_atTop_atTop
  have hupper : Tendsto (fun n : ℕ ↦ C / (n : ℝ)^2)
      atTop (𝓝 0) := tendsto_const_nhds.div_atTop hnatSq
  apply squeeze_zero'
    (Eventually.of_forall fun n ↦ by positivity) _ hupper
  filter_upwards [eventually_ge_atTop 2] with n hn
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have hpair := pairDensity_mul_pred_le_inv n hnpos
  have hM0 : (0 : ℝ) ≤ upperEdgeCount ε n := by positivity
  have hscaled :
      (upperEdgeCount ε n : ℝ) *
          (2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1) ≤
        (upperEdgeCount ε n : ℝ) / (n : ℝ) := by
    calc
      (upperEdgeCount ε n : ℝ) *
          (2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1) =
          (upperEdgeCount ε n : ℝ) *
            ((2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1)) := by
        ring
      _ ≤ (upperEdgeCount ε n : ℝ) * (1 / (n : ℝ)) :=
        mul_le_mul_of_nonneg_left hpair hM0
      _ = (upperEdgeCount ε n : ℝ) / (n : ℝ) := by ring
  have hMdiv := upperEdgeCount_div_le_two_log_add_inv
    ε hε0 hε1 hnpos
  have hlogmul : Real.log ((3 * n : ℕ) : ℝ) =
      Real.log 3 + Real.log (n : ℝ) := by
    norm_num only [Nat.cast_mul, Nat.cast_ofNat]
    rw [Real.log_mul (by norm_num) hnR.ne']
  have hinv : (1 : ℝ) / n ≤ 1 := by
    exact (div_le_one hnR).2 (by exact_mod_cast hnpos)
  have harg :
      (upperEdgeCount ε n : ℝ) *
          (2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1) -
          Real.log (n : ℝ) * 6 ≤
        2 * Real.log 3 - 4 * Real.log (n : ℝ) + 1 := by
    rw [hlogmul] at hMdiv
    nlinarith
  have hexp := Real.exp_le_exp.mpr harg
  calc
    ((3 * n : ℝ)^2) *
        (2 * Real.exp
          ((upperEdgeCount ε n : ℝ) *
              (2 / ((n : ℝ) * (3 * n - 1))) * ((n : ℝ) - 1) -
            Real.log (n : ℝ) * 6)) ≤
      ((3 * n : ℝ)^2) *
        (2 * Real.exp
          (2 * Real.log 3 - 4 * Real.log (n : ℝ) + 1)) := by
      gcongr
    _ = C / (n : ℝ)^2 := by
      dsimp [C]
      rw [show 2 * Real.log 3 - 4 * Real.log (n : ℝ) + 1 =
          (2 * Real.log 3 + 1) + (-4 * Real.log (n : ℝ)) by ring,
        Real.exp_add]
      rw [show -4 * Real.log (n : ℝ) =
          -(4 * Real.log (n : ℝ)) by ring, Real.exp_neg]
      have hexp4 : Real.exp (4 * Real.log (n : ℝ)) = (n : ℝ)^4 := by
        rw [show 4 * Real.log (n : ℝ) =
            (4 : ℕ) * Real.log (n : ℝ) by norm_num,
          Real.exp_nat_mul, Real.exp_log hnR]
      rw [hexp4]
      field_simp [hnR.ne']
      ring

/-- The materialized all-pairs codegree-failure event itself has vanishing
finite-uniform probability. -/
lemma upper_codegree_failure_probability_tendsto_zero (ε : ℝ)
    (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) :
    Tendsto
      (fun n : ℕ ↦
        finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
          (fun e ↦ e ∈ sampledCodegreeFailureSet n
            (upperEdgeCount ε n))) atTop (𝓝 0) := by
  apply squeeze_zero'
    (Eventually.of_forall fun n ↦ finsetProbability_nonneg _ _) _
    (upper_codegree_failure_bound_tendsto_zero ε hε0 hε1)
  filter_upwards [eventually_upperEdgeCount_collision_condition ε hε0 hε1,
    eventually_ge_atTop 1] with n hcollision hn
  exact sampledCodegreeFailureSet_le n (upperEdgeCount ε n)
    (by omega) hcollision

/-- The expected degree `upperEdgeCount ε n / n` tends to infinity. -/
lemma upperEdgeCount_div_tendsto_atTop (ε : ℝ) (hε : 0 ≤ ε) :
    Tendsto (fun n : ℕ ↦
      (upperEdgeCount ε n : ℝ) / (n : ℝ)) atTop atTop := by
  have hthree : Tendsto (fun n : ℕ ↦ ((3 * n : ℕ) : ℝ)) atTop atTop := by
    simpa only [Nat.cast_mul, Nat.cast_ofNat] using
      tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num : (0 : ℝ) < 3)
  have hlog : Tendsto
      (fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp hthree
  apply tendsto_atTop_mono' atTop _ hlog
  filter_upwards [eventually_ge_atTop 1] with n hn
  have hnR : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  apply (le_div_iff₀ hnR).2
  simpa [shamirScale, mul_comm] using
    shamirScale_le_upperEdgeCount ε hε n

/-- The fixed-vertex degree-tail factor tends to zero at the supercritical
scale. -/
lemma upper_degree_tail_factor_tendsto_zero (ε : ℝ) (hε : 0 ≤ ε) :
    Tendsto
      (fun n : ℕ ↦
        Real.exp (-((upperEdgeCount ε n : ℝ) / n) / 64))
      atTop (𝓝 0) := by
  have hscaled : Tendsto
      (fun n : ℕ ↦ (1 / 64 : ℝ) *
        ((upperEdgeCount ε n : ℝ) / (n : ℝ))) atTop atTop :=
    (upperEdgeCount_div_tendsto_atTop ε hε).const_mul_atTop
      (by norm_num)
  have hexp := Real.tendsto_exp_neg_atTop_nhds_zero.comp hscaled
  refine hexp.congr' (Eventually.of_forall fun n ↦ ?_)
  apply congrArg Real.exp
  ring

/-- For every fixed positive `eta`, the probability that at least an
`eta` fraction of vertices have atypical degree tends to zero. -/
lemma upper_badVertex_proportion_probability_tendsto_zero
    (ε eta : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) (heta : 0 < eta) :
    Tendsto
      (fun n : ℕ ↦
        finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
          (fun e ↦ eta * (3 * n : ℝ) ≤
            (sampledBadVertices n (upperEdgeCount ε n) e).card))
      atTop (𝓝 0) := by
  have hupper : Tendsto
      (fun n : ℕ ↦ (4 / eta) *
        Real.exp (-((upperEdgeCount ε n : ℝ) / n) / 64))
      atTop (𝓝 0) := by
    have hmul := (tendsto_const_nhds.mul
      (upper_degree_tail_factor_tendsto_zero ε hε0) :
      Tendsto
        (fun n : ℕ ↦ (4 / eta) *
          Real.exp (-((upperEdgeCount ε n : ℝ) / n) / 64))
        atTop (𝓝 ((4 / eta) * 0)))
    simpa using hmul
  apply squeeze_zero'
    (Eventually.of_forall fun n ↦ finsetProbability_nonneg _ _) _ hupper
  filter_upwards [eventually_upperEdgeCount_collision_condition ε hε0 hε1,
    eventually_ge_atTop 1] with n hcollision hn
  exact sampledBadVertices_proportion_le n (upperEdgeCount ε n) eta
    (by omega) heta hcollision

/-- A polynomial union over the `3n` vertices is still negligible when
each one-vertex error has exponent `-κ log(3n)` with `κ > 1`. -/
lemma vertexUnion_exp_log_tendsto_zero (κ : ℝ) (hκ : 1 < κ) :
    Tendsto
      (fun n : ℕ ↦ (3 * n : ℝ) *
        (2 * Real.exp
          (-κ * Real.log ((3 * n : ℕ) : ℝ))))
      atTop (nhds 0) := by
  have hthree : Tendsto
      (fun n : ℕ ↦ ((3 * n : ℕ) : ℝ)) atTop atTop := by
    norm_num only [Nat.cast_mul, Nat.cast_ofNat]
    exact tendsto_natCast_atTop_atTop.const_mul_atTop (by norm_num)
  have hlog : Tendsto
      (fun n : ℕ ↦ Real.log ((3 * n : ℕ) : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp hthree
  have hscaled : Tendsto
      (fun n : ℕ ↦ (κ - 1) *
        Real.log ((3 * n : ℕ) : ℝ)) atTop atTop :=
    hlog.const_mul_atTop (sub_pos.mpr hκ)
  have hdecay : Tendsto
      (fun n : ℕ ↦ Real.exp
        (-((κ - 1) * Real.log ((3 * n : ℕ) : ℝ))))
      atTop (nhds 0) :=
    Real.tendsto_exp_neg_atTop_nhds_zero.comp hscaled
  have htwice : Tendsto
      (fun n : ℕ ↦ 2 * Real.exp
        (-((κ - 1) * Real.log ((3 * n : ℕ) : ℝ))))
      atTop (nhds 0) := by
    simpa using (tendsto_const_nhds.mul hdecay)
  refine htwice.congr' ?_
  filter_upwards [eventually_ge_atTop 1] with n hn
  have hx : (0 : ℝ) < ((3 * n : ℕ) : ℝ) := by positivity
  rw [show -((κ - 1) * Real.log ((3 * n : ℕ) : ℝ)) =
      Real.log ((3 * n : ℕ) : ℝ) +
        (-κ * Real.log ((3 * n : ℕ) : ℝ)) by ring,
    Real.exp_add, Real.exp_log hx]
  norm_num only [Nat.cast_mul, Nat.cast_ofNat]
  ring

/-- The numerical Chernoff exponent for the factor-eight upper degree
tail is at most `-2`. -/
lemma eight_degree_chernoff_coefficient_le :
    (8 : ℝ) - 1 - 8 * Real.log 8 ≤ -2 := by
  have h := sq_div_le_mul_log_sub_add_one (x := (8 : ℝ)) (by norm_num)
  norm_num at h ⊢
  nlinarith

/-- At the supercritical scale, with relative excess at most one, every
vertex has degree below eight times the mean with high probability. -/
lemma upper_maxDegree_failure_probability_tendsto_zero
    (ε : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1) :
    Tendsto
      (fun n : ℕ ↦
        finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
          (fun e ↦ ∃ v : Vertex n,
            (8 : ℝ) * ((upperEdgeCount ε n : ℝ) / n) ≤
              vertexDegree (historyEdges e) v))
      atTop (nhds 0) := by
  have hupper := vertexUnion_exp_log_tendsto_zero 2 (by norm_num)
  apply squeeze_zero'
    (Eventually.of_forall fun n ↦ finsetProbability_nonneg _ _) _ hupper
  filter_upwards [eventually_upperEdgeCount_collision_condition ε hε0 hε1,
    eventually_ge_atTop 1] with n hcollision hn
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have hscale := upperScale_le_upperEdgeCount ε (by linarith) n
  have hmean : (1 + ε) * Real.log ((3 * n : ℕ) : ℝ) ≤
      (upperEdgeCount ε n : ℝ) / n := by
    apply (le_div_iff₀ hnR).2
    calc
      ((1 + ε) * Real.log ((3 * n : ℕ) : ℝ)) * (n : ℝ) =
          (1 + ε) * shamirScale n := by
        unfold shamirScale
        norm_num only [Nat.cast_mul, Nat.cast_ofNat]
        ring
      _ ≤ upperEdgeCount ε n := hscale
  have hlog0 : 0 ≤ Real.log ((3 * n : ℕ) : ℝ) :=
    Real.log_nonneg (by exact_mod_cast (show 1 ≤ 3 * n by omega))
  have hone : 1 ≤ 1 + ε := by linarith
  have hmean' : Real.log ((3 * n : ℕ) : ℝ) ≤
      (upperEdgeCount ε n : ℝ) / n :=
    (le_mul_of_one_le_left hlog0 hone).trans hmean
  have harg :
      ((upperEdgeCount ε n : ℝ) / n) *
          ((8 : ℝ) - 1 - 8 * Real.log 8) ≤
        -2 * Real.log ((3 * n : ℕ) : ℝ) := by
    have hmu0 : 0 ≤ (upperEdgeCount ε n : ℝ) / n := by positivity
    have hfirst := mul_le_mul_of_nonneg_left
      eight_degree_chernoff_coefficient_le hmu0
    nlinarith
  calc
    finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
        (fun e ↦ ∃ v : Vertex n,
          (8 : ℝ) * ((upperEdgeCount ε n : ℝ) / n) ≤
            vertexDegree (historyEdges e) v) ≤
      (3 * n : ℝ) * (2 * Real.exp
        (((upperEdgeCount ε n : ℝ) / n) *
          ((8 : ℝ) - 1 - 8 * Real.log 8))) :=
      sampled_exists_degree_upper_factor_le n (upperEdgeCount ε n)
        8 hnpos (by norm_num) hcollision
    _ ≤ (3 * n : ℝ) *
        (2 * Real.exp
          (-2 * Real.log ((3 * n : ℕ) : ℝ))) := by
      gcongr

/-- For every positive supercritical excess, one can choose a fixed
positive lower degree factor whose Chernoff exponent survives the union
bound over all vertices. -/
lemma exists_lower_degree_factor (ε : ℝ) (hε : 0 < ε) :
    ∃ a : ℝ, 0 < a ∧ a ≤ 1 ∧
      1 < (1 + ε) * (1 - a + a * Real.log a) := by
  let f : ℝ → ℝ := fun a ↦ 1 - a + a * Real.log a
  have hden : 0 < 1 + ε := by linarith
  have hq : 1 / (1 + ε) < 1 := by
    rw [div_lt_one hden]
    linarith
  have hfcont : Continuous f := by
    dsimp [f]
    exact (continuous_const.sub continuous_id).add Real.continuous_mul_log
  have hevent : ∀ᶠ a in nhds (0 : ℝ), 1 / (1 + ε) < f a := by
    exact hfcont.continuousAt.eventually (by
      simpa [f] using eventually_gt_nhds hq)
  obtain ⟨d, hd0, hd⟩ := Metric.mem_nhds_iff.mp hevent
  let a : ℝ := min (d / 2) (1 / 2)
  have ha0 : 0 < a := by
    dsimp [a]
    exact lt_min (by linarith) (by norm_num)
  have ha1 : a ≤ 1 := by
    dsimp [a]
    linarith [min_le_right (d / 2) (1 / 2 : ℝ)]
  have haball : a ∈ Metric.ball (0 : ℝ) d := by
    rw [Metric.mem_ball, Real.dist_eq]
    have hale : a ≤ d / 2 := min_le_left _ _
    rw [sub_zero, abs_of_nonneg ha0.le]
    linarith
  have hfa : 1 / (1 + ε) < f a := hd haball
  refine ⟨a, ha0, ha1, ?_⟩
  apply (div_lt_iff₀ hden).mp at hfa
  dsimp [f] at hfa
  nlinarith

/-- Once a lower-degree factor has supercritical exponent greater than
one, the probability that any vertex violates it tends to zero. -/
lemma upper_minDegree_failure_probability_tendsto_zero
    (ε a : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1)
    (ha0 : 0 < a) (ha1 : a ≤ 1)
    (hexp : 1 < (1 + ε) * (1 - a + a * Real.log a)) :
    Tendsto
      (fun n : ℕ ↦
        finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
          (fun e ↦ ∃ v : Vertex n,
            (vertexDegree (historyEdges e) v : ℝ) ≤
              a * ((upperEdgeCount ε n : ℝ) / n)))
      atTop (nhds 0) := by
  let κ : ℝ := (1 + ε) * (1 - a + a * Real.log a)
  have hupper := vertexUnion_exp_log_tendsto_zero κ (by simpa [κ] using hexp)
  apply squeeze_zero'
    (Eventually.of_forall fun n ↦ finsetProbability_nonneg _ _) _ hupper
  filter_upwards [eventually_upperEdgeCount_collision_condition ε hε0 hε1,
    eventually_ge_atTop 1] with n hcollision hn
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have hscale := upperScale_le_upperEdgeCount ε (by linarith) n
  have hmean : (1 + ε) * Real.log ((3 * n : ℕ) : ℝ) ≤
      (upperEdgeCount ε n : ℝ) / n := by
    apply (le_div_iff₀ hnR).2
    calc
      ((1 + ε) * Real.log ((3 * n : ℕ) : ℝ)) * (n : ℝ) =
          (1 + ε) * shamirScale n := by
        unfold shamirScale
        norm_num only [Nat.cast_mul, Nat.cast_ofNat]
        ring
      _ ≤ upperEdgeCount ε n := hscale
  have hgap : 0 < 1 - a + a * Real.log a := by
    have hone : 0 < 1 + ε := by linarith
    nlinarith [hexp]
  have harg :
      ((upperEdgeCount ε n : ℝ) / n) *
          (a - 1 - a * Real.log a) ≤
        -κ * Real.log ((3 * n : ℕ) : ℝ) := by
    dsimp [κ]
    nlinarith
  calc
    finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
        (fun e ↦ ∃ v : Vertex n,
          (vertexDegree (historyEdges e) v : ℝ) ≤
            a * ((upperEdgeCount ε n : ℝ) / n)) ≤
      (3 * n : ℝ) * (2 * Real.exp
        (((upperEdgeCount ε n : ℝ) / n) *
          (a - 1 - a * Real.log a))) :=
      sampled_exists_degree_lower_factor_le n (upperEdgeCount ε n)
        a hnpos ha0 ha1 hcollision
    _ ≤ (3 * n : ℝ) *
        (2 * Real.exp
          (-κ * Real.log ((3 * n : ℕ) : ℝ))) := by
      gcongr

/-- The minimum-degree clause of random regularity, with the existential
constant made explicit in the theorem's conclusion. -/
lemma exists_upper_minDegree_factor_tendsto_zero
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε ≤ 1) :
    ∃ a : ℝ, 0 < a ∧ a ≤ 1 ∧
      Tendsto
        (fun n : ℕ ↦
          finsetProbability
            (Finset.univ : Finset
              (DeletionHistory (allEdges n) (upperEdgeCount ε n)))
            (fun e ↦ ∃ v : Vertex n,
              (vertexDegree (historyEdges e) v : ℝ) ≤
                a * ((upperEdgeCount ε n : ℝ) / n)))
        atTop (nhds 0) := by
  obtain ⟨a, ha0, ha1, haexp⟩ := exists_lower_degree_factor ε hε0
  exact ⟨a, ha0, ha1,
    upper_minDegree_failure_probability_tendsto_zero
      ε a hε0.le hε1 ha0 ha1 haexp⟩

/-- If `Y` is a positive-density block of uniformly large weights, an
ordered sample has abnormally small total weight only when it undersamples
`Y`. -/
lemma topBlock_sample_underweight_le {α : Type*} (s Y : Finset α)
    (hYs : Y ⊆ s) (W : α → ℝ) (t : ℕ) (a : ℝ)
    (hs : s.Nonempty) (ha : 0 < a)
    (hW0 : ∀ x ∈ s, 0 ≤ W x)
    (hWYa : ∀ x ∈ Y, a ≤ W x)
    (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ iidSum W t e <
          a * ((3 / 4 : ℝ) * (t : ℝ) *
            ((Y.card : ℝ) / s.card))) ≤
      2 * Real.exp
        (-(((Y.card : ℝ) / s.card)^2 * (t : ℝ)) / 64) := by
  have hmono :
      finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
          (fun e ↦ iidSum W t e <
            a * ((3 / 4 : ℝ) * (t : ℝ) *
              ((Y.card : ℝ) / s.card))) ≤
        finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
          (fun e ↦ (embeddingHitCount Y e : ℝ) ≤
            (3 / 4 : ℝ) * (t : ℝ) *
              ((Y.card : ℝ) / s.card)) := by
    apply finsetProbability_mono_event
    intro e _ he
    have hdet := mul_embeddingHitCount_le_iidSum W Y t e a ha.le hW0 hWYa
    have hlt : (embeddingHitCount Y e : ℝ) <
        (3 / 4 : ℝ) * (t : ℝ) * ((Y.card : ℝ) / s.card) := by
      nlinarith
    exact hlt.le
  exact hmono.trans (embeddingHitCount_three_quarters_le s Y hYs t hs ht)

/-- Dually, if `Y` is a positive-density block of uniformly small weights,
an ordered sample can exceed the saving forced by its typical number of
hits only when it undersamples `Y`. -/
lemma bottomBlock_sample_overweight_le {α : Type*} (s Y : Finset α)
    (hYs : Y ⊆ s) (W : α → ℝ) (t : ℕ) (a b : ℝ)
    (hs : s.Nonempty) (hab : a < b)
    (hWb : ∀ x ∈ s, W x ≤ b)
    (hWYa : ∀ x ∈ Y, W x ≤ a)
    (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦
          b * (t : ℝ) - (b - a) *
              ((3 / 4 : ℝ) * (t : ℝ) *
                ((Y.card : ℝ) / s.card)) < iidSum W t e) ≤
      2 * Real.exp
        (-(((Y.card : ℝ) / s.card)^2 * (t : ℝ)) / 64) := by
  have hmono :
      finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
          (fun e ↦
            b * (t : ℝ) - (b - a) *
                ((3 / 4 : ℝ) * (t : ℝ) *
                  ((Y.card : ℝ) / s.card)) < iidSum W t e) ≤
        finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
          (fun e ↦ (embeddingHitCount Y e : ℝ) ≤
            (3 / 4 : ℝ) * (t : ℝ) *
              ((Y.card : ℝ) / s.card)) := by
    apply finsetProbability_mono_event
    intro e _ he
    have hdet := iidSum_le_mul_sub_mul_embeddingHitCount
      W Y t e a b hab.le hWb hWYa
    have hlt : (embeddingHitCount Y e : ℝ) <
        (3 / 4 : ℝ) * (t : ℝ) * ((Y.card : ℝ) / s.card) := by
      nlinarith
    exact hlt.le
  exact hmono.trans (embeddingHitCount_three_quarters_le s Y hYs t hs ht)

/-- Chernoff upper tail obtained from the stopped deletion-martingale MGF. -/
lemma stoppedCenteredSum_upper_tail_le {n : ℕ} {H : Finset (Edge n)}
    (C θ u : ℝ) (hn : 0 < n) (hC : 0 < C) (T : ℕ)
    (hT : T ≤ H.card) (hθ0 : 0 ≤ θ)
    (hθ : ∀ i < T, |θ * (C * deletionGamma n H i)| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ u ≤ stoppedCenteredSum C T e) ≤
      Real.exp (θ^2 * deletionVarianceBudget n H C T - θ * u) := by
  have hnonempty : Nonempty (DeletionHistory H T) :=
    deletionHistory_nonempty_of_card_le H T hT
  have hs : (Finset.univ : Finset (DeletionHistory H T)).Nonempty := by
    obtain ⟨e⟩ := hnonempty
    exact ⟨e, Finset.mem_univ e⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (DeletionHistory H T))
    (stoppedCenteredSum C T) 0 θ u hs hθ0
  simp only [sub_zero] at hmarkov
  have hmgf := stoppedCenteredSum_mgf_le C θ hn hC T hT hθ
  have hexppos : 0 < Real.exp (θ * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf

/-- Chernoff upper tail for the stopped arbitrary-triple completion-weight
deletion martingale. -/
lemma completionStoppedCenteredSum_upper_tail_le {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C θ u : ℝ)
    (hn : 2 ≤ n) (hC : 0 < C) (T : ℕ) (hT : T ≤ H.card)
    (hθ0 : 0 ≤ θ)
    (hθ : ∀ i < T,
      |θ * (C * completionDeletionGamma n H i)| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ u ≤ completionStoppedCenteredSum Z C T e) ≤
      Real.exp
        (θ^2 * completionDeletionVarianceBudget n H C T - θ * u) := by
  have hnonempty : Nonempty (DeletionHistory H T) :=
    deletionHistory_nonempty_of_card_le H T hT
  have hs : (Finset.univ : Finset (DeletionHistory H T)).Nonempty := by
    obtain ⟨e⟩ := hnonempty
    exact ⟨e, Finset.mem_univ e⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (DeletionHistory H T))
    (completionStoppedCenteredSum Z C T) 0 θ u hs hθ0
  simp only [sub_zero] at hmarkov
  have hmgf := completionStoppedCenteredSum_mgf_le
    Z C θ hn hC T hT hθ
  have hexppos : 0 < Real.exp (θ * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf

/-- The symmetric lower tail for the stopped arbitrary-triple
completion-weight deletion martingale. -/
lemma completionStoppedCenteredSum_lower_tail_le {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C θ u : ℝ)
    (hn : 2 ≤ n) (hC : 0 < C) (T : ℕ) (hT : T ≤ H.card)
    (hθ0 : 0 ≤ θ)
    (hθ : ∀ i < T,
      |θ * (C * completionDeletionGamma n H i)| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ u ≤ -completionStoppedCenteredSum Z C T e) ≤
      Real.exp
        (θ^2 * completionDeletionVarianceBudget n H C T - θ * u) := by
  have hnonempty : Nonempty (DeletionHistory H T) :=
    deletionHistory_nonempty_of_card_le H T hT
  have hs : (Finset.univ : Finset (DeletionHistory H T)).Nonempty := by
    obtain ⟨e⟩ := hnonempty
    exact ⟨e, Finset.mem_univ e⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (DeletionHistory H T))
    (fun e ↦ -completionStoppedCenteredSum Z C T e) 0 θ u hs hθ0
  simp only [sub_zero] at hmarkov
  have hθneg : ∀ i < T,
      |(-θ) * (C * completionDeletionGamma n H i)| ≤ 1 / 2 := by
    intro i hi
    simpa only [neg_mul, abs_neg] using hθ i hi
  have hmgf := completionStoppedCenteredSum_mgf_le
    Z C (-θ) hn hC T hT hθneg
  have hmgf' :
      finsetAverage (Finset.univ : Finset (DeletionHistory H T))
          (fun e ↦ Real.exp
            (θ * -completionStoppedCenteredSum Z C T e)) ≤
        Real.exp
          (θ^2 * completionDeletionVarianceBudget n H C T) := by
    simpa only [neg_mul, mul_neg, neg_sq] using hmgf
  have hexppos : 0 < Real.exp (θ * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf'

/-- Two-sided completion-martingale concentration in absolute-value form. -/
lemma completionStoppedCenteredSum_abs_tail_le {n : ℕ}
    {H : Finset (Edge n)} (Z : Edge n) (C θ u : ℝ)
    (hn : 2 ≤ n) (hC : 0 < C) (T : ℕ) (hT : T ≤ H.card)
    (hθ0 : 0 ≤ θ)
    (hθ : ∀ i < T,
      |θ * (C * completionDeletionGamma n H i)| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ u ≤ |completionStoppedCenteredSum Z C T e|) ≤
      2 * Real.exp
        (θ^2 * completionDeletionVarianceBudget n H C T - θ * u) := by
  let S : DeletionHistory H T → ℝ :=
    completionStoppedCenteredSum Z C T
  have hevent :
      (Finset.univ : Finset (DeletionHistory H T)).filter
          (fun e ↦ u ≤ |S e|) =
        (Finset.univ : Finset (DeletionHistory H T)).filter
          (fun e ↦ u ≤ S e ∨ u ≤ -S e) := by
    apply Finset.filter_congr
    intro e _
    by_cases he : 0 ≤ S e
    · rw [abs_of_nonneg he]
      constructor
      · exact fun h ↦ Or.inl h
      · rintro (h | h)
        · exact h
        · linarith
    · have he' : S e < 0 := lt_of_not_ge he
      rw [abs_of_neg he']
      constructor
      · exact fun h ↦ Or.inr h
      · rintro (h | h)
        · linarith
        · exact h
  have hor := finsetProbability_or_le_add
    (Finset.univ : Finset (DeletionHistory H T))
    (fun e ↦ u ≤ S e) (fun e ↦ u ≤ -S e)
  have hu := completionStoppedCenteredSum_upper_tail_le
    Z C θ u hn hC T hT hθ0 hθ
  have hl := completionStoppedCenteredSum_lower_tail_le
    Z C θ u hn hC T hT hθ0 hθ
  have hprobEvent :
      finsetProbability (Finset.univ : Finset (DeletionHistory H T))
          (fun e ↦ u ≤ |S e|) =
        finsetProbability (Finset.univ : Finset (DeletionHistory H T))
          (fun e ↦ u ≤ S e ∨ u ≤ -S e) := by
    unfold finsetProbability
    rw [hevent]
  rw [hprobEvent]
  dsimp [S] at hor
  calc
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (fun e ↦ u ≤ completionStoppedCenteredSum Z C T e ∨
          u ≤ -completionStoppedCenteredSum Z C T e) ≤
      finsetProbability (Finset.univ : Finset (DeletionHistory H T))
          (fun e ↦ u ≤ completionStoppedCenteredSum Z C T e) +
        finsetProbability (Finset.univ : Finset (DeletionHistory H T))
          (fun e ↦ u ≤ -completionStoppedCenteredSum Z C T e) := hor
    _ ≤ Real.exp
          (θ^2 * completionDeletionVarianceBudget n H C T - θ * u) +
        Real.exp
          (θ^2 * completionDeletionVarianceBudget n H C T - θ * u) :=
      add_le_add hu hl
    _ = 2 * Real.exp
          (θ^2 * completionDeletionVarianceBudget n H C T - θ * u) := by
      ring

lemma finiteUniformImageEntropy_le_average_log_weightRatio
    {alpha beta : Type*} (s : Finset alpha) (X : alpha → beta)
    (w : beta → ℝ) (hs : s.Nonempty)
    (hw : ∀ x ∈ s.image X, 0 < w x) :
    finiteUniformImageEntropy s X ≤
      finsetAverage s (fun omega ↦
        Real.log ((∑ x ∈ s.image X, w x) / w (X omega))) := by
  let a : beta → ℝ := fun x ↦ ((finiteMapFiber s X x).card : ℝ)
  let A : ℝ := s.card
  let B : ℝ := ∑ x ∈ s.image X, w x
  have hA : 0 < A := by
    dsimp only [A]
    exact_mod_cast Finset.card_pos.mpr hs
  have ha : ∀ x ∈ s.image X, 0 ≤ a x := by
    intro x hx
    dsimp only [a]
    positivity
  have haPos : ∀ x ∈ s.image X, 0 < a x := by
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨omega, homega, rfl⟩
    dsimp only [a]
    have hnon : (finiteMapFiber s X (X omega)).Nonempty :=
      ⟨omega, Finset.mem_filter.mpr ⟨homega, rfl⟩⟩
    exact_mod_cast Finset.card_pos.mpr hnon
  have hw0 : ∀ x ∈ s.image X, 0 ≤ w x :=
    fun x hx ↦ (hw x hx).le
  have hB : 0 < B := by
    obtain ⟨omega, homega⟩ := hs
    have hx : X omega ∈ s.image X :=
      Finset.mem_image.mpr ⟨omega, homega, rfl⟩
    exact lt_of_lt_of_le (hw (X omega) hx)
      (Finset.single_le_sum (fun x hx ↦ hw0 x hx) hx)
  have hsumA : ∑ x ∈ s.image X, a x = A := by
    dsimp only [a, A]
    exact sum_castCard_finiteMapFiber_eq_card s (s.image X) X
      (fun omega homega ↦ Finset.mem_image.mpr ⟨omega, homega, rfl⟩)
  have hweighted := weightedLogSum_le (s.image X) a w A B
    hA hB ha hw0 (fun x hx hax ↦ hw x hx) hsumA rfl
  have hleft :
      ∑ x ∈ s.image X, a x * Real.log (A / a x) =
        A * Real.log A -
          ∑ x ∈ s.image X, a x * Real.log (a x) := by
    rw [Finset.sum_congr rfl (fun x hx ↦ by
      rw [Real.log_div hA.ne' (haPos x hx).ne', mul_sub])]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hsumA]
  have hright :
      ∑ x ∈ s.image X, a x * Real.log (B / w x) =
        A * Real.log B -
          ∑ x ∈ s.image X, a x * Real.log (w x) := by
    rw [Finset.sum_congr rfl (fun x hx ↦ by
      rw [Real.log_div hB.ne' (hw x hx).ne', mul_sub])]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hsumA]
  have hnum :
      ∑ x ∈ s.image X, a x * Real.log (A / a x) ≤
        ∑ x ∈ s.image X, a x * Real.log (B / w x) := by
    rw [hleft, hright]
    have hweighted' :
        (∑ x ∈ s.image X, a x * Real.log (w x)) -
            (∑ x ∈ s.image X, a x * Real.log (a x)) ≤
          A * Real.log B - A * Real.log A := by
      calc
        (∑ x ∈ s.image X, a x * Real.log (w x)) -
            (∑ x ∈ s.image X, a x * Real.log (a x)) =
            ∑ x ∈ s.image X, a x * Real.log (w x / a x) := by
              symm
              calc
                (∑ x ∈ s.image X, a x * Real.log (w x / a x)) =
                    ∑ x ∈ s.image X,
                      (a x * Real.log (w x) - a x * Real.log (a x)) := by
                        apply Finset.sum_congr rfl
                        intro x hx
                        rw [Real.log_div (hw x hx).ne' (haPos x hx).ne']
                        ring
                _ = (∑ x ∈ s.image X, a x * Real.log (w x)) -
                      (∑ x ∈ s.image X, a x * Real.log (a x)) := by
                        rw [Finset.sum_sub_distrib]
        _ ≤ A * Real.log (B / A) := hweighted
        _ = A * Real.log B - A * Real.log A := by
          rw [Real.log_div hB.ne' hA.ne']
          ring
    linarith
  rw [finiteUniformImageEntropy_eq_sum_fiber_log_ratio s X hs]
  unfold finsetAverage
  rw [sum_eq_sum_card_fiber_mul s X
    (fun x ↦ Real.log (B / w x))]
  dsimp only [a, A] at hnum ⊢
  exact div_le_div_of_nonneg_right hnum hA.le

/-- Matching-fraction mass of candidate edges whose partners lie in `S`. -/
def matchingCandidateMass {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) (S : Finset (Vertex n)) : ℝ :=
  ∑ T ∈ H.filter (fun T ↦ v ∈ T ∧ T.erase v ⊆ S), matchingFraction H T

lemma matchingEdgeAt_erase_subset_available_of_first {n : ℕ}
    {H F : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) (perm : Equiv.Perm (Vertex n))
    (v : Vertex n) (hfirst : matchingVertexFirst hH F perm v) :
    (matchingEdgeAt hH F v).erase v ⊆
      matchingKahnAvailableVertices hH F (permutationPrior perm v) v := by
  rw [matchingKahnAvailableVertices_eq_current_union_after
    hH hF perm v hfirst]
  exact Finset.subset_union_left

lemma matchingJointKahnZ_inl_fiber_edge_eq {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n) (v : Vertex n)
    {q q' : Equiv.Perm (Vertex n) × Finset (Edge n)}
    (hq' : q' ∈ matchingPermutationSample n H) {A : Edge n}
    (hqZ : matchingJointKahnZ hH v q = Sum.inl A)
    (heq : matchingJointKahnZ hH v q' = matchingJointKahnZ hH v q) :
    matchingEdgeAt hH q'.2 v = A := by
  have hF' : q'.2 ∈ perfectMatchings n H :=
    (Finset.mem_product.mp hq').2
  have hz' : matchingJointKahnZ hH v q' = Sum.inl A := heq.trans hqZ
  unfold matchingJointKahnZ matchingKahnZ at hz'
  by_cases hprev : matchingKahnPreviouslyExposed hH q'.2
      (permutationPrior q'.1 v) v
  · rw [if_pos hprev] at hz'
    exact Sum.inl.inj hz'
  · rw [if_neg hprev] at hz'
    exact (Sum.inr_ne_inl hz').elim

lemma matchingJointKahnZ_inr_fiber_candidate {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n) (v : Vertex n)
    {q q' : Equiv.Perm (Vertex n) × Finset (Edge n)}
    (hq' : q' ∈ matchingPermutationSample n H) {S : Finset (Vertex n)}
    (hqZ : matchingJointKahnZ hH v q = Sum.inr S)
    (heq : matchingJointKahnZ hH v q' = matchingJointKahnZ hH v q) :
    matchingEdgeAt hH q'.2 v ∈
      H.filter (fun T ↦ v ∈ T ∧ T.erase v ⊆ S) := by
  have hF' : q'.2 ∈ perfectMatchings n H :=
    (Finset.mem_product.mp hq').2
  have hz' : matchingJointKahnZ hH v q' = Sum.inr S := heq.trans hqZ
  have hnot : ¬matchingKahnPreviouslyExposed hH q'.2
      (permutationPrior q'.1 v) v := by
    intro hprev
    unfold matchingJointKahnZ matchingKahnZ at hz'
    rw [if_pos hprev] at hz'
    exact Sum.inl_ne_inr hz'
  have hfirst := (not_matchingKahnPreviouslyExposed_iff_vertexFirst
    hH hF' q'.1 v).mp hnot
  have havail : matchingKahnAvailableVertices hH q'.2
      (permutationPrior q'.1 v) v = S := by
    unfold matchingJointKahnZ matchingKahnZ at hz'
    rw [if_neg hnot] at hz'
    exact Sum.inr.inj hz'
  apply Finset.mem_filter.mpr
  refine ⟨(mem_perfectMatchings.mp hF').1
      (matchingEdgeAt_spec hH hF' v).1,
    (matchingEdgeAt_spec hH hF' v).2, ?_⟩
  rw [← havail]
  exact matchingEdgeAt_erase_subset_available_of_first
    hH hF' q'.1 v hfirst

lemma matchingFraction_pos_of_mem_perfectMatching {n : ℕ}
    {H F : Finset (Edge n)} {A : Edge n}
    (hF : F ∈ perfectMatchings n H) (hAF : A ∈ F) :
    0 < matchingFraction H A := by
  have hweight : 0 < matchingWeight H A := by
    unfold matchingWeight
    exact Finset.card_pos.mpr ⟨F, Finset.mem_filter.mpr ⟨hF, hAF⟩⟩
  have hcard : 0 < (perfectMatchings n H).card :=
    Finset.card_pos.mpr ⟨F, hF⟩
  unfold matchingFraction
  exact div_pos (by exact_mod_cast hweight) (by exact_mod_cast hcard)

def matchingKahnPointCost {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n)) : ℝ :=
  match matchingJointKahnZ hH v q with
  | Sum.inl _ => 0
  | Sum.inr S => Real.log
      (matchingCandidateMass H v S /
        matchingFraction H (matchingEdgeAt hH q.2 v))

lemma matchingCandidateMass_nonneg {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) (S : Finset (Vertex n)) :
    0 ≤ matchingCandidateMass H v S := by
  unfold matchingCandidateMass
  exact Finset.sum_nonneg fun T hT ↦ matchingFraction_nonneg H T

lemma finiteConditionalEntropy_matchingJointKahnZ_le_pointCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    finiteConditionalEntropy (matchingPermutationSample n H)
        (fun q ↦ matchingEdgeAt hH q.2 v)
        (matchingJointKahnZ hH v) ≤
      finsetAverage (matchingPermutationSample n H)
        (matchingKahnPointCost hH v) := by
  letI : DecidableEq (Edge n) := Classical.decEq _
  letI : DecidableEq (Sum (Edge n) (Finset (Vertex n))) := Classical.decEq _
  let Omega := matchingPermutationSample n H
  let X : Equiv.Perm (Vertex n) × Finset (Edge n) → Edge n :=
    fun q ↦ matchingEdgeAt hH q.2 v
  let Z := matchingJointKahnZ hH v
  have hOmega : Omega.Nonempty := by
    obtain ⟨F, hF⟩ := Finset.card_ne_zero.mp hPhi
    exact ⟨(Equiv.refl _, F), Finset.mem_product.mpr
      ⟨Finset.mem_univ _, hF⟩⟩
  rw [finiteConditionalEntropy_eq_average_fiber_uniformImageEntropy
    Omega X Z hOmega]
  have hlocal : ∀ q ∈ Omega,
      finiteUniformImageEntropy (finiteMapFiber Omega Z (Z q)) X ≤
        finsetAverage (finiteMapFiber Omega Z (Z q))
          (matchingKahnPointCost hH v) := by
    intro q hq
    let t := finiteMapFiber Omega Z (Z q)
    have ht : t.Nonempty := ⟨q, by
      simpa only [t, finiteMapFiber, Finset.mem_filter] using
        (show q ∈ Omega ∧ True from ⟨hq, trivial⟩)⟩
    have hw : ∀ A ∈ t.image X, 0 < matchingFraction H A := by
      intro A hA
      rcases Finset.mem_image.mp hA with ⟨q', hq't, hX⟩
      have hq'data : q' ∈ Omega ∧ Z q' = Z q := by
        simpa only [t, finiteMapFiber, Finset.mem_filter] using hq't
      have hq'Omega := hq'data.1
      have hF' : q'.2 ∈ perfectMatchings n H :=
        (Finset.mem_product.mp hq'Omega).2
      rw [← hX]
      exact matchingFraction_pos_of_mem_perfectMatching hF'
        (matchingEdgeAt_spec hH hF' v).1
    have hbase := finiteUniformImageEntropy_le_average_log_weightRatio
      t X (matchingFraction H) ht hw
    apply hbase.trans
    unfold finsetAverage
    have htCard : (0 : ℝ) < t.card := by
      exact_mod_cast Finset.card_pos.mpr ht
    apply div_le_div_of_nonneg_right _ htCard.le
    apply Finset.sum_le_sum
    intro q' hq't
    have hq'data : q' ∈ Omega ∧ Z q' = Z q := by
      simpa only [t, finiteMapFiber, Finset.mem_filter] using hq't
    have hq'Omega := hq'data.1
    have hZeq : Z q' = Z q := hq'data.2
    cases hZq : Z q with
  | inl A =>
      have hXq' : X q' = A := by
        exact matchingJointKahnZ_inl_fiber_edge_eq hH v hq'Omega
          (by simpa only [Z] using hZq) (by simpa only [Z] using hZeq)
      have himage : t.image X = {A} := by
        ext B
        constructor
        · intro hB
          rcases Finset.mem_image.mp hB with ⟨r, hr, rfl⟩
          have hrdata : r ∈ Omega ∧ Z r = Z q := by
            simpa only [t, finiteMapFiber, Finset.mem_filter] using hr
          have hrOmega := hrdata.1
          have hrZ : Z r = Z q := hrdata.2
          exact Finset.mem_singleton.mpr
            (matchingJointKahnZ_inl_fiber_edge_eq hH v hrOmega
              (by simpa only [Z] using hZq)
              (by simpa only [Z] using hrZ))
        · intro hB
          have hBA := Finset.mem_singleton.mp hB
          subst B
          refine Finset.mem_image.mpr ⟨q', hq't, ?_⟩
          exact hXq'
      rw [himage]
      simp only [Finset.sum_singleton, hXq']
      rw [div_self (hw A (by
        rw [himage]
        exact Finset.mem_singleton_self A)).ne', Real.log_one]
      unfold matchingKahnPointCost
      rw [show matchingJointKahnZ hH v q' = Sum.inl A by
        simpa only [Z] using hZeq.trans hZq]
  | inr S =>
      have hsub : t.image X ⊆
          H.filter (fun T ↦ v ∈ T ∧ T.erase v ⊆ S) := by
        intro T hT
        rcases Finset.mem_image.mp hT with ⟨r, hr, rfl⟩
        have hrdata : r ∈ Omega ∧ Z r = Z q := by
          simpa only [t, finiteMapFiber, Finset.mem_filter] using hr
        have hrOmega := hrdata.1
        have hrZ : Z r = Z q := hrdata.2
        exact matchingJointKahnZ_inr_fiber_candidate hH v hrOmega
          (by simpa only [Z] using hZq) (by simpa only [Z] using hrZ)
      have hmassLe :
          (∑ T ∈ t.image X, matchingFraction H T) ≤
            matchingCandidateMass H v S := by
        unfold matchingCandidateMass
        exact Finset.sum_le_sum_of_subset_of_nonneg hsub
          (fun T hT hnot ↦ matchingFraction_nonneg H T)
      have hXpos : 0 < matchingFraction H (X q') :=
        hw (X q') (Finset.mem_image.mpr ⟨q', hq't, rfl⟩)
      have hsumPos : 0 < ∑ T ∈ t.image X, matchingFraction H T := by
        exact lt_of_lt_of_le hXpos
          (Finset.single_le_sum
            (fun T hT ↦ (matchingFraction_nonneg H T))
            (Finset.mem_image.mpr ⟨q', hq't, rfl⟩))
      have hcandPos : 0 < matchingCandidateMass H v S :=
        hsumPos.trans_le hmassLe
      have hratio :
          (∑ T ∈ t.image X, matchingFraction H T) /
              matchingFraction H (X q') ≤
            matchingCandidateMass H v S /
              matchingFraction H (X q') :=
        div_le_div_of_nonneg_right hmassLe hXpos.le
      have hlog := Real.strictMonoOn_log.monotoneOn
        (div_pos hsumPos hXpos) (div_pos hcandPos hXpos) hratio
      apply hlog.trans_eq
      unfold matchingKahnPointCost
      have hz' : Z q' = Sum.inr S := hZeq.trans hZq
      rw [show matchingJointKahnZ hH v q' = Sum.inr S by
        simpa only [Z] using hz']
  have havg := finsetAverage_mono Omega
    (fun q ↦ finiteUniformImageEntropy (finiteMapFiber Omega Z (Z q)) X)
    (fun q ↦ finsetAverage (finiteMapFiber Omega Z (Z q))
      (matchingKahnPointCost hH v)) hlocal
  have htower := finsetAverage_fiber_average_aux Omega Z
    (fun _z q ↦ matchingKahnPointCost hH v q)
  exact havg.trans_eq (by simpa only [Omega] using htower)

def matchingActiveCandidateLogCost {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n)) : ℝ :=
  if matchingVertexFirst hH q.2 q.1 v then
    Real.log (matchingCandidateMass H v
      (matchingKahnAvailableVertices hH q.2 (permutationPrior q.1 v) v))
  else 0

def matchingActiveNegLogFractionCost {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n)) : ℝ :=
  if matchingVertexFirst hH q.2 q.1 v then
    -Real.log (matchingFraction H (matchingEdgeAt hH q.2 v))
  else 0

lemma matchingKahnPointCost_eq_active_add {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (v : Vertex n)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n))
    (hq : q ∈ matchingPermutationSample n H) :
    matchingKahnPointCost hH v q =
      matchingActiveCandidateLogCost hH v q +
        matchingActiveNegLogFractionCost hH v q := by
  have hF : q.2 ∈ perfectMatchings n H :=
    (Finset.mem_product.mp hq).2
  by_cases hfirst : matchingVertexFirst hH q.2 q.1 v
  · have hnot := (not_matchingKahnPreviouslyExposed_iff_vertexFirst
      hH hF q.1 v).mpr hfirst
    unfold matchingKahnPointCost matchingJointKahnZ matchingKahnZ
      matchingActiveCandidateLogCost matchingActiveNegLogFractionCost
    simp [hfirst, hnot]
    have hp : 0 < matchingFraction H (matchingEdgeAt hH q.2 v) :=
      matchingFraction_pos_of_mem_perfectMatching hF
        (matchingEdgeAt_spec hH hF v).1
    have hm : 0 < matchingCandidateMass H v
        (matchingKahnAvailableVertices hH q.2 (permutationPrior q.1 v) v) := by
      unfold matchingCandidateMass
      have hmem : matchingEdgeAt hH q.2 v ∈
          H.filter (fun T ↦ v ∈ T ∧ T.erase v ⊆
            matchingKahnAvailableVertices hH q.2
              (permutationPrior q.1 v) v) := by
        exact Finset.mem_filter.mpr ⟨
          (mem_perfectMatchings.mp hF).1 (matchingEdgeAt_spec hH hF v).1,
          (matchingEdgeAt_spec hH hF v).2,
          matchingEdgeAt_erase_subset_available_of_first
            hH hF q.1 v hfirst⟩
      exact lt_of_lt_of_le hp (Finset.single_le_sum
        (fun T hT ↦ matchingFraction_nonneg H T) hmem)
    rw [Real.log_div hm.ne' hp.ne']
    ring
  · have hprev : matchingKahnPreviouslyExposed hH q.2
        (permutationPrior q.1 v) v := by
      by_contra hnot
      exact hfirst ((not_matchingKahnPreviouslyExposed_iff_vertexFirst
        hH hF q.1 v).mp hnot)
    unfold matchingKahnPointCost matchingJointKahnZ matchingKahnZ
      matchingActiveCandidateLogCost matchingActiveNegLogFractionCost
    simp [hfirst, hprev]

lemma finiteMapFiber_matchingEdgeAt_eq_weight {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (v : Vertex n) {A : Edge n} (hAH : A ∈ H) (hvA : v ∈ A) :
    (finiteMapFiber (perfectMatchings n H)
      (fun F ↦ matchingEdgeAt hH F v) A).card = matchingWeight H A := by
  apply congrArg Finset.card
  ext F
  simp only [finiteMapFiber, matchingWeight, Finset.mem_filter]
  constructor
  · rintro ⟨hF, heq⟩
    refine ⟨hF, ?_⟩
    rw [← heq]
    exact (matchingEdgeAt_spec hH hF v).1
  · rintro ⟨hF, hAF⟩
    exact ⟨hF, matchingEdgeAt_eq_of_mem hH hF hAF hvA⟩

lemma average_negLog_matchingFraction_edgeAt_eq_localEntropy {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    finsetAverage (perfectMatchings n H) (fun F ↦
        -Real.log (matchingFraction H (matchingEdgeAt hH F v))) =
      localMatchingEntropy H v := by
  let S := perfectMatchings n H
  let X : Finset (Edge n) → Edge n := fun F ↦ matchingEdgeAt hH F v
  let I := H.filter fun A ↦ v ∈ A
  let J : Finset (Edge n) :=
    @Finset.image (Finset (Edge n)) (Edge n)
      (fun a b ↦ Classical.propDecidable (a = b)) X S
  have hSpos : (0 : ℝ) < S.card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhi
  have hsub : J ⊆ I := by
    intro A hA
    have hA' : A ∈ S.image X := by
      simpa only [J, Finset.mem_image] using hA
    rcases Finset.mem_image.mp hA' with ⟨F, hFS, rfl⟩
    exact Finset.mem_filter.mpr ⟨
      (mem_perfectMatchings.mp hFS).1 (matchingEdgeAt_spec hH hFS v).1,
      (matchingEdgeAt_spec hH hFS v).2⟩
  have hfiber : ∀ A ∈ I,
      (finiteMapFiber S X A).card = matchingWeight H A := by
    intro A hAI
    rcases Finset.mem_filter.mp hAI with ⟨hAH, hvA⟩
    exact finiteMapFiber_matchingEdgeAt_eq_weight hH v hAH hvA
  have hzero : ∀ A ∈ I, A ∉ J →
      -(matchingFraction H A) * Real.log (matchingFraction H A) = 0 := by
    intro A hAI hnot
    have hw0 : matchingWeight H A = 0 := by
      by_contra hw
      obtain ⟨F, hF⟩ := Finset.card_ne_zero.mp hw
      have hAF := (Finset.mem_filter.mp hF).2
      have hFp := (Finset.mem_filter.mp hF).1
      apply hnot
      have hmem : matchingEdgeAt hH F v ∈ S.image X :=
        Finset.mem_image.mpr ⟨F, hFp, rfl⟩
      have heq := matchingEdgeAt_eq_of_mem hH hFp hAF
        (Finset.mem_filter.mp hAI).2
      rw [heq] at hmem
      simpa only [J, Finset.mem_image] using hmem
    simp [matchingFraction, hw0]
  unfold finsetAverage localMatchingEntropy finiteEntropy
  rw [sum_eq_sum_card_fiber_mul S X
    (fun A ↦ -Real.log (matchingFraction H A))]
  have hsumExtend :
      (∑ A ∈ J,
          ((finiteMapFiber S X A).card : ℝ) *
            -Real.log (matchingFraction H A)) =
        (S.card : ℝ) *
          (∑ A ∈ I,
            -(matchingFraction H A) * Real.log (matchingFraction H A)) := by
    rw [Finset.mul_sum]
    calc
      (∑ A ∈ J,
          ((finiteMapFiber S X A).card : ℝ) *
            -Real.log (matchingFraction H A)) =
          ∑ A ∈ J,
            (S.card : ℝ) *
              (-(matchingFraction H A) *
                Real.log (matchingFraction H A)) := by
        apply Finset.sum_congr rfl
        intro A hAI
        rw [hfiber A (hsub hAI)]
        unfold matchingFraction
        field_simp [hSpos.ne']
        ring
      _ = ∑ A ∈ I,
            (S.card : ℝ) *
              (-(matchingFraction H A) *
                Real.log (matchingFraction H A)) := by
        apply Finset.sum_subset hsub
        intro A hAI hnot
        rw [hzero A hAI hnot]
        ring
  change
    (∑ A ∈ J,
        ((finiteMapFiber S X A).card : ℝ) *
          -Real.log (matchingFraction H A)) / (S.card : ℝ) =
      ∑ A ∈ I,
        -(matchingFraction H A) * Real.log (matchingFraction H A)
  rw [hsumExtend]
  field_simp [hSpos.ne']

lemma average_matchingActiveNegLogFractionCost {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    finsetAverage (matchingPermutationSample n H)
        (matchingActiveNegLogFractionCost hH v) =
      (1 / 3 : ℝ) * localMatchingEntropy H v := by
  let P := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let S := perfectMatchings n H
  have hPpos : (0 : ℝ) < P.card := by
    exact_mod_cast Finset.card_pos.mpr ⟨Equiv.refl _, Finset.mem_univ _⟩
  have hSpos : (0 : ℝ) < S.card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhi
  have hinner : ∀ F ∈ S,
      ∑ perm ∈ P, matchingActiveNegLogFractionCost hH v (perm, F) =
        (P.card : ℝ) / 3 *
          -Real.log (matchingFraction H (matchingEdgeAt hH F v)) := by
    intro F hF
    let Q := P.filter fun perm ↦ matchingVertexFirst hH F perm v
    have hthree := three_mul_card_matchingVertexFirst hH hF v
    have hcard : (Q.card : ℝ) = (P.card : ℝ) / 3 := by
      have hthreeR : (3 : ℝ) * (Q.card : ℝ) = (P.card : ℝ) := by
        exact_mod_cast hthree
      nlinarith
    unfold matchingActiveNegLogFractionCost
    rw [show (∑ perm ∈ P,
          if matchingVertexFirst hH F perm v then
            -Real.log (matchingFraction H (matchingEdgeAt hH F v))
          else 0) =
        ∑ _perm ∈ Q,
          -Real.log (matchingFraction H (matchingEdgeAt hH F v)) by
      simp only [Q]
      rw [Finset.sum_filter]]
    simp only [Finset.sum_const, nsmul_eq_mul]
    rw [hcard]
  unfold finsetAverage matchingPermutationSample
  rw [Finset.sum_product]
  change (∑ perm ∈ P, ∑ F ∈ S,
      matchingActiveNegLogFractionCost hH v (perm, F)) /
        ((P ×ˢ S).card : ℝ) = _
  rw [Finset.sum_comm]
  rw [Finset.sum_congr rfl hinner]
  rw [← Finset.mul_sum]
  have havgNeg :=
    average_negLog_matchingFraction_edgeAt_eq_localEntropy hH hPhi v
  unfold finsetAverage at havgNeg
  have hsumNeg :
      (∑ F ∈ S,
        -Real.log (matchingFraction H (matchingEdgeAt hH F v))) =
        localMatchingEntropy H v * (S.card : ℝ) := by
    apply (div_eq_iff hSpos.ne').mp
    simpa only [S] using havgNeg
  rw [hsumNeg]
  simp only [Finset.card_product, Nat.cast_mul]
  field_simp [hPpos.ne', hSpos.ne']

def matchingCandidateSurvivalPermutations {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (F : Finset (Edge n)) (v : Vertex n)
    (T : Edge n) (j : ℕ) : Finset (Equiv.Perm (Vertex n)) :=
  (Finset.univ : Finset (Equiv.Perm (Vertex n))).filter fun perm ↦
    matchingVertexFirst hH F perm v ∧
      matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
      T.erase v ⊆ matchingKahnAvailableVertices hH F
        (permutationPrior perm v) v

lemma fixedMatching_candidate_survival_count_le {n : ℕ}
    {H F : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hF : F ∈ perfectMatchings n H) {T : Edge n} {v : Vertex n}
    (hTH : T ∈ H) (hvT : v ∈ T) {j : ℕ} (hj : j < n) :
    ((matchingCandidateSurvivalPermutations hH F v T j).card : ℝ) ≤
      ((Finset.univ : Finset (Equiv.Perm (Vertex n))).card : ℝ) /
        (3 * n : ℕ) *
          (if (matchingOtherMeetingEdges F v T).card < 2 then 1 else
            (((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
              (((n - 1) * (n - 2) : ℕ) : ℝ)) := by
  let P := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let Q := matchingCandidateSurvivalPermutations hH F v T j
  have hn0 : 0 < n := by omega
  have h3n : (0 : ℝ) < (3 * n : ℕ) := by positivity
  have hden : (0 : ℝ) < ((n - 1) * (n - 2) : ℕ) := by
    exact_mod_cast (Nat.mul_pos (by omega) (by omega))
  by_cases hbad : (matchingOtherMeetingEdges F v T).card < 2
  · rw [if_pos hbad]
    have hsub : Q ⊆ P.filter (fun perm ↦
        matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j) := by
      intro perm hperm
      rcases Finset.mem_filter.mp hperm with ⟨hp, hfirst, hrank, hsurv⟩
      exact Finset.mem_filter.mpr ⟨hp, hfirst, hrank⟩
    have hcard := Finset.card_le_card hsub
    have hexact := three_n_mul_card_matchingVertexFirst_and_rank
      hn0 hH hF v hj
    have hcardR : (Q.card : ℝ) ≤
        ((P.filter (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j)).card : ℝ) := by
      exact_mod_cast hcard
    have hexactR : ((3 * n : ℕ) : ℝ) *
        ((P.filter (fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j)).card : ℝ) =
          (P.card : ℝ) := by
      exact_mod_cast hexact
    norm_num only [mul_one]
    apply (le_div_iff₀ h3n).2
    nlinarith
  · rw [if_neg hbad]
    have hgen : 2 ≤ (matchingOtherMeetingEdges F v T).card := by omega
    have hexact := generic_candidate_survival_exact_count
      hH hF hTH hvT hgen hj
    have hexactR :
        (((3 * n * (n - 1) * (n - 2) : ℕ) : ℝ) * (Q.card : ℝ)) =
          (((n - j - 1) * (n - j - 2) : ℕ) : ℝ) *
            (P.card : ℝ) := by
      exact_mod_cast hexact
    rw [show ((3 * n * (n - 1) * (n - 2) : ℕ) : ℝ) =
        ((3 * n : ℕ) : ℝ) *
          (((n - 1) * (n - 2) : ℕ) : ℝ) by
            norm_num only [Nat.cast_mul]
            ring]
      at hexactR
    field_simp [h3n.ne', hden.ne']
    nlinarith

def matchingCandidateSurvivalPairs {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n) (T : Edge n) (j : ℕ) :
    Finset (Equiv.Perm (Vertex n) × Finset (Edge n)) :=
  (matchingPermutationSample n H).filter fun q ↦
    matchingVertexFirst hH q.2 q.1 v ∧
      matchingEdgeRank q.1 q.2 (matchingEdgeAt hH q.2 v) = j ∧
      T.erase v ⊆ matchingKahnAvailableVertices hH q.2
        (permutationPrior q.1 v) v

lemma card_matchingCandidateSurvivalPairs_eq_sum {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (v : Vertex n) (T : Edge n) (j : ℕ) :
    (matchingCandidateSurvivalPairs hH v T j).card =
      ∑ F ∈ perfectMatchings n H,
        (matchingCandidateSurvivalPermutations hH F v T j).card := by
  let P := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let S := perfectMatchings n H
  let R : Equiv.Perm (Vertex n) → Finset (Edge n) → Prop :=
    fun perm F ↦ matchingVertexFirst hH F perm v ∧
      matchingEdgeRank perm F (matchingEdgeAt hH F v) = j ∧
      T.erase v ⊆ matchingKahnAvailableVertices hH F
        (permutationPrior perm v) v
  calc
    (matchingCandidateSurvivalPairs hH v T j).card =
        ∑ q ∈ P ×ˢ S, if R q.1 q.2 then 1 else 0 := by
      rw [Finset.sum_boole (R := ℕ)]
      apply congrArg Finset.card
      ext q
      simp only [matchingCandidateSurvivalPairs, matchingPermutationSample,
        Finset.mem_filter, Finset.mem_product, P, S, R]
    _ = ∑ perm ∈ P, ∑ F ∈ S, if R perm F then 1 else 0 := by
      rw [Finset.sum_product]
    _ = ∑ F ∈ S, ∑ perm ∈ P, if R perm F then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ F ∈ S,
          (matchingCandidateSurvivalPermutations hH F v T j).card := by
      apply Finset.sum_congr rfl
      intro F hF
      rw [Finset.sum_boole (R := ℕ)]
      apply congrArg Finset.card
      ext perm
      simp only [matchingCandidateSurvivalPermutations, Finset.mem_filter,
        P, R, Finset.mem_univ, true_and]

lemma matchingCandidateSurvivalPairs_count_le {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    {T : Edge n} {v : Vertex n} (hTH : T ∈ H) (hvT : v ∈ T)
    {j : ℕ} (hj : j < n) :
    ((matchingCandidateSurvivalPairs hH v T j).card : ℝ) ≤
      (((Finset.univ : Finset (Equiv.Perm (Vertex n))).card : ℝ) *
          ((perfectMatchings n H).card : ℝ)) /
        (3 * n : ℕ) *
        (matchingGenericFailureFraction H v T +
          (1 - matchingGenericFailureFraction H v T) *
            ((((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
              (((n - 1) * (n - 2) : ℕ) : ℝ))) := by
  let P := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let S := perfectMatchings n H
  let Bad := S.filter fun F ↦ (matchingOtherMeetingEdges F v T).card < 2
  let rho : ℝ := (((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
    (((n - 1) * (n - 2) : ℕ) : ℝ)
  have h3n : (0 : ℝ) < (3 * n : ℕ) := by positivity
  have hSpos : (0 : ℝ) < S.card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhi
  rw [card_matchingCandidateSurvivalPairs_eq_sum]
  norm_num only [Nat.cast_sum]
  calc
    (∑ F ∈ S,
        ((matchingCandidateSurvivalPermutations hH F v T j).card : ℝ)) ≤
        ∑ F ∈ S, (P.card : ℝ) / (3 * n : ℕ) *
          (if (matchingOtherMeetingEdges F v T).card < 2 then 1 else rho) := by
      apply Finset.sum_le_sum
      intro F hF
      simpa only [P, rho, S] using
        fixedMatching_candidate_survival_count_le hn hH hF hTH hvT hj
    _ = (P.card : ℝ) / (3 * n : ℕ) *
          ((Bad.card : ℝ) + ((S.card - Bad.card : ℕ) : ℝ) * rho) := by
      rw [← Finset.mul_sum]
      have hsplit :
          (∑ F ∈ S,
              if (matchingOtherMeetingEdges F v T).card < 2 then
                (1 : ℝ) else rho) =
            (Bad.card : ℝ) + ((S.card - Bad.card : ℕ) : ℝ) * rho := by
        let bad : Finset (Edge n) → Prop := fun F ↦
          (matchingOtherMeetingEdges F v T).card < 2
        have hdecomp := Finset.card_filter_add_card_filter_not (s := S) bad
        have hbadEq : S.filter bad = Bad := by
          ext F
          simp only [Finset.mem_filter, bad, Bad]
        have hnotCard : (S.filter fun F ↦ ¬bad F).card =
            S.card - Bad.card := by
          rw [hbadEq] at hdecomp
          omega
        rw [Finset.sum_ite]
        simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
        change ((S.filter bad).card : ℝ) +
            ((S.filter fun F ↦ ¬bad F).card : ℝ) * rho = _
        rw [hbadEq, hnotCard]
      rw [hsplit]
    _ = ((P.card : ℝ) * (S.card : ℝ)) / (3 * n : ℕ) *
        (matchingGenericFailureFraction H v T +
          (1 - matchingGenericFailureFraction H v T) * rho) := by
      have hBadSub : Bad.card ≤ S.card := Finset.card_le_card
        (Finset.filter_subset _ _)
      have hgamma : matchingGenericFailureFraction H v T =
          (Bad.card : ℝ) / (S.card : ℝ) := by
        unfold matchingGenericFailureFraction finsetProbability
        rfl
      rw [hgamma]
      norm_num only [Nat.cast_sub hBadSub]
      field_simp [h3n.ne', hSpos.ne']

def matchingActiveRankPairs {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n) (j : ℕ) :
    Finset (Equiv.Perm (Vertex n) × Finset (Edge n)) :=
  (matchingPermutationSample n H).filter fun q ↦
    matchingVertexFirst hH q.2 q.1 v ∧
      matchingEdgeRank q.1 q.2 (matchingEdgeAt hH q.2 v) = j

lemma three_n_mul_card_matchingActiveRankPairs {n : ℕ}
    {H : Finset (Edge n)} (hn : 0 < n) (hH : H ⊆ allEdges n)
    (v : Vertex n) {j : ℕ} (hj : j < n) :
    (3 * n) * (matchingActiveRankPairs hH v j).card =
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card *
        (perfectMatchings n H).card := by
  let P := (Finset.univ : Finset (Equiv.Perm (Vertex n)))
  let S := perfectMatchings n H
  have hcard : (matchingActiveRankPairs hH v j).card =
      ∑ F ∈ S, (P.filter fun perm ↦
        matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j).card := by
    calc
      (matchingActiveRankPairs hH v j).card =
          ∑ q ∈ P ×ˢ S,
            if matchingVertexFirst hH q.2 q.1 v ∧
              matchingEdgeRank q.1 q.2
                (matchingEdgeAt hH q.2 v) = j then 1 else 0 := by
        rw [Finset.sum_boole (R := ℕ)]
        apply congrArg Finset.card
        ext q
        simp only [matchingActiveRankPairs, matchingPermutationSample,
          Finset.mem_filter, Finset.mem_product, P, S]
      _ = ∑ perm ∈ P, ∑ F ∈ S,
            if matchingVertexFirst hH F perm v ∧
              matchingEdgeRank perm F (matchingEdgeAt hH F v) = j
            then 1 else 0 := by
        rw [Finset.sum_product]
      _ = ∑ F ∈ S, ∑ perm ∈ P,
            if matchingVertexFirst hH F perm v ∧
              matchingEdgeRank perm F (matchingEdgeAt hH F v) = j
            then 1 else 0 := by rw [Finset.sum_comm]
      _ = _ := by
        apply Finset.sum_congr rfl
        intro F hF
        exact Finset.sum_boole (R := ℕ)
          (fun perm ↦ matchingVertexFirst hH F perm v ∧
            matchingEdgeRank perm F (matchingEdgeAt hH F v) = j) P
  rw [hcard, Finset.mul_sum]
  calc
    ∑ F ∈ S, (3 * n) *
        (P.filter fun perm ↦ matchingVertexFirst hH F perm v ∧
          matchingEdgeRank perm F (matchingEdgeAt hH F v) = j).card =
      ∑ _F ∈ S, P.card := by
        apply Finset.sum_congr rfl
        intro F hF
        exact three_n_mul_card_matchingVertexFirst_and_rank
          hn hH hF v hj
    _ = P.card * S.card := by simp [Nat.mul_comm]

def matchingVertexGenericityMass {n : ℕ} (H : Finset (Edge n))
    (v : Vertex n) : ℝ :=
  ∑ T ∈ H.filter (fun T ↦ v ∈ T),
    matchingFraction H T * matchingGenericFailureFraction H v T

lemma matchingVertexGenericityMass_nonneg {n : ℕ}
    (H : Finset (Edge n)) (v : Vertex n) :
    0 ≤ matchingVertexGenericityMass H v := by
  unfold matchingVertexGenericityMass
  exact Finset.sum_nonneg fun T hT ↦
    mul_nonneg (matchingFraction_nonneg H T)
      (matchingGenericFailureFraction_nonneg H v T)

lemma matchingVertexGenericityMass_le_one {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    matchingVertexGenericityMass H v ≤ 1 := by
  unfold matchingVertexGenericityMass
  calc
    (∑ T ∈ H.filter (fun T ↦ v ∈ T),
        matchingFraction H T * matchingGenericFailureFraction H v T) ≤
      ∑ T ∈ H.filter (fun T ↦ v ∈ T), matchingFraction H T := by
        apply Finset.sum_le_sum
        intro T hT
        exact mul_le_of_le_one_right (matchingFraction_nonneg H T)
          (matchingGenericFailureFraction_le_one H v T)
    _ = 1 := sum_incident_matchingFraction n H hH v hPhi

lemma sum_candidateMass_activeRank_eq {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (v : Vertex n) (j : ℕ) :
    (∑ q ∈ matchingActiveRankPairs hH v j,
        matchingCandidateMass H v
          (matchingKahnAvailableVertices hH q.2
            (permutationPrior q.1 v) v)) =
      ∑ T ∈ H.filter (fun T ↦ v ∈ T),
        matchingFraction H T *
          ((matchingCandidateSurvivalPairs hH v T j).card : ℝ) := by
  let E := matchingActiveRankPairs hH v j
  let I := H.filter fun T ↦ v ∈ T
  have hpoint : ∀ q ∈ E,
      matchingCandidateMass H v
          (matchingKahnAvailableVertices hH q.2
            (permutationPrior q.1 v) v) =
        ∑ T ∈ I,
          if T.erase v ⊆ matchingKahnAvailableVertices hH q.2
              (permutationPrior q.1 v) v
          then matchingFraction H T else 0 := by
    intro q hq
    unfold matchingCandidateMass
    simp only [I]
    rw [Finset.sum_filter, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro T hTH
    by_cases hvT : v ∈ T
    by_cases hsub : T.erase v ⊆ matchingKahnAvailableVertices hH q.2
        (permutationPrior q.1 v) v
    · simp [hvT, hsub]
    · simp [hvT, hsub]
    · simp [hvT]
  rw [Finset.sum_congr rfl hpoint]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro T hTI
  calc
    (∑ q ∈ E,
        if T.erase v ⊆ matchingKahnAvailableVertices hH q.2
            (permutationPrior q.1 v) v
        then matchingFraction H T else 0) =
      matchingFraction H T *
        (∑ q ∈ E,
          if T.erase v ⊆ matchingKahnAvailableVertices hH q.2
              (permutationPrior q.1 v) v
          then (1 : ℝ) else 0) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro q hq
        split <;> simp_all
    _ = matchingFraction H T *
        ((matchingCandidateSurvivalPairs hH v T j).card : ℝ) := by
      apply congrArg (fun x : ℝ ↦ matchingFraction H T * x)
      rw [Finset.sum_boole]
      norm_cast
      apply congrArg Finset.card
      ext q
      simp only [E, I, matchingActiveRankPairs,
        matchingCandidateSurvivalPairs, Finset.mem_filter]
      tauto

lemma sum_candidateMass_activeRank_le {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (v : Vertex n) {j : ℕ} (hj : j < n) :
    (∑ q ∈ matchingActiveRankPairs hH v j,
        matchingCandidateMass H v
          (matchingKahnAvailableVertices hH q.2
            (permutationPrior q.1 v) v)) ≤
      (((Finset.univ : Finset (Equiv.Perm (Vertex n))).card : ℝ) *
          ((perfectMatchings n H).card : ℝ)) /
        (3 * n : ℕ) *
        (matchingVertexGenericityMass H v +
          (1 - matchingVertexGenericityMass H v) *
            ((((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
              (((n - 1) * (n - 2) : ℕ) : ℝ))) := by
  let I := H.filter fun T ↦ v ∈ T
  let base : ℝ :=
    (((Finset.univ : Finset (Equiv.Perm (Vertex n))).card : ℝ) *
      ((perfectMatchings n H).card : ℝ)) / (3 * n : ℕ)
  let rho : ℝ :=
    (((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
      (((n - 1) * (n - 2) : ℕ) : ℝ)
  rw [sum_candidateMass_activeRank_eq hH v j]
  calc
    (∑ T ∈ I, matchingFraction H T *
        ((matchingCandidateSurvivalPairs hH v T j).card : ℝ)) ≤
      ∑ T ∈ I, matchingFraction H T *
        (base * (matchingGenericFailureFraction H v T +
          (1 - matchingGenericFailureFraction H v T) * rho)) := by
        apply Finset.sum_le_sum
        intro T hTI
        apply mul_le_mul_of_nonneg_left _ (matchingFraction_nonneg H T)
        rcases Finset.mem_filter.mp hTI with ⟨hTH, hvT⟩
        simpa only [base, rho] using
          matchingCandidateSurvivalPairs_count_le hn hH hPhi hTH hvT hj
    _ = base * (matchingVertexGenericityMass H v +
          (1 - matchingVertexGenericityMass H v) * rho) := by
      have hmass := sum_incident_matchingFraction n H hH v hPhi
      unfold matchingVertexGenericityMass
      dsimp only [I]
      calc
        (∑ T ∈ H.filter (fun T ↦ v ∈ T),
            matchingFraction H T *
              (base * (matchingGenericFailureFraction H v T +
                (1 - matchingGenericFailureFraction H v T) * rho))) =
          base * ∑ T ∈ H.filter (fun T ↦ v ∈ T),
            matchingFraction H T *
              (matchingGenericFailureFraction H v T +
                (1 - matchingGenericFailureFraction H v T) * rho) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro T hT
            ring
        _ = _ := by
          apply congrArg (fun x : ℝ ↦ base * x)
          calc
            (∑ T ∈ H.filter (fun T ↦ v ∈ T),
                matchingFraction H T *
                  (matchingGenericFailureFraction H v T +
                    (1 - matchingGenericFailureFraction H v T) * rho)) =
              ∑ T ∈ H.filter (fun T ↦ v ∈ T),
                (matchingFraction H T *
                    matchingGenericFailureFraction H v T +
                  (matchingFraction H T - matchingFraction H T *
                    matchingGenericFailureFraction H v T) * rho) := by
                apply Finset.sum_congr rfl
                intro T hT
                ring
            _ = (∑ T ∈ H.filter (fun T ↦ v ∈ T),
                  matchingFraction H T *
                    matchingGenericFailureFraction H v T) +
                ((∑ T ∈ H.filter (fun T ↦ v ∈ T),
                    matchingFraction H T) -
                  ∑ T ∈ H.filter (fun T ↦ v ∈ T),
                    matchingFraction H T *
                      matchingGenericFailureFraction H v T) * rho := by
                rw [Finset.sum_add_distrib, ← Finset.sum_mul,
                  Finset.sum_sub_distrib]
            _ = (∑ T ∈ H.filter (fun T ↦ v ∈ T),
                  matchingFraction H T *
                    matchingGenericFailureFraction H v T) +
                (1 - ∑ T ∈ H.filter (fun T ↦ v ∈ T),
                    matchingFraction H T *
                      matchingGenericFailureFraction H v T) * rho := by
                rw [hmass]

def matchingActiveRankCandidateLogCost {n : ℕ} {H : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (v : Vertex n) (j : ℕ)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n)) : ℝ :=
  if matchingVertexFirst hH q.2 q.1 v ∧
      matchingEdgeRank q.1 q.2 (matchingEdgeAt hH q.2 v) = j then
    Real.log (matchingCandidateMass H v
      (matchingKahnAvailableVertices hH q.2 (permutationPrior q.1 v) v))
  else 0

lemma average_matchingActiveRankCandidateLogCost_le {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (v : Vertex n) {j : ℕ} (hj : j < n) :
    finsetAverage (matchingPermutationSample n H)
        (matchingActiveRankCandidateLogCost hH v j) ≤
      (1 / ((3 * n : ℕ) : ℝ)) *
        Real.log (matchingVertexGenericityMass H v +
          (1 - matchingVertexGenericityMass H v) *
            ((((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
              (((n - 1) * (n - 2) : ℕ) : ℝ))) := by
  let Omega := matchingPermutationSample n H
  let E := matchingActiveRankPairs hH v j
  let mass : Equiv.Perm (Vertex n) × Finset (Edge n) → ℝ := fun q ↦
    matchingCandidateMass H v
      (matchingKahnAvailableVertices hH q.2 (permutationPrior q.1 v) v)
  let gamma := matchingVertexGenericityMass H v
  let rho : ℝ :=
    (((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
      (((n - 1) * (n - 2) : ℕ) : ℝ)
  let u : ℝ := gamma + (1 - gamma) * rho
  have hn0 : 0 < n := by omega
  have h3n : (0 : ℝ) < (3 * n : ℕ) := by positivity
  have hPpos : 0 < (Finset.univ : Finset (Equiv.Perm (Vertex n))).card :=
    Finset.card_pos.mpr ⟨Equiv.refl _, Finset.mem_univ _⟩
  have hSpos : 0 < (perfectMatchings n H).card := Nat.pos_of_ne_zero hPhi
  have hOmegaCard : Omega.card =
      (Finset.univ : Finset (Equiv.Perm (Vertex n))).card *
        (perfectMatchings n H).card := by
    simp [Omega, matchingPermutationSample]
  have hOmegaPos : (0 : ℝ) < Omega.card := by
    exact_mod_cast (by rw [hOmegaCard]; positivity : 0 < Omega.card)
  have hEexact := three_n_mul_card_matchingActiveRankPairs hn0 hH v hj
  have hEposNat : 0 < E.card := by
    have hprod : 0 <
        (Finset.univ : Finset (Equiv.Perm (Vertex n))).card *
          (perfectMatchings n H).card := Nat.mul_pos hPpos hSpos
    dsimp only [E]
    nlinarith
  have hEpos : (0 : ℝ) < E.card := by exact_mod_cast hEposNat
  have hEratio : (E.card : ℝ) = (Omega.card : ℝ) / (3 * n : ℕ) := by
    have hEexactR : (E.card : ℝ) * ((3 * n : ℕ) : ℝ) =
        (Omega.card : ℝ) := by
      rw [hOmegaCard]
      rw [mul_comm]
      exact_mod_cast hEexact
    exact (eq_div_iff h3n.ne').2 hEexactR
  have hmassPos : ∀ q ∈ E, 0 < mass q := by
    intro q hq
    have hdata := Finset.mem_filter.mp hq
    have hqOmega : q ∈ Omega := hdata.1
    have hfirst := hdata.2.1
    have hF : q.2 ∈ perfectMatchings n H :=
      (Finset.mem_product.mp hqOmega).2
    have hp := matchingFraction_pos_of_mem_perfectMatching hF
      (matchingEdgeAt_spec hH hF v).1
    unfold mass matchingCandidateMass
    have hmem : matchingEdgeAt hH q.2 v ∈
        H.filter (fun T ↦ v ∈ T ∧ T.erase v ⊆
          matchingKahnAvailableVertices hH q.2
            (permutationPrior q.1 v) v) :=
      Finset.mem_filter.mpr ⟨
        (mem_perfectMatchings.mp hF).1 (matchingEdgeAt_spec hH hF v).1,
        (matchingEdgeAt_spec hH hF v).2,
        matchingEdgeAt_erase_subset_available_of_first
          hH hF q.1 v hfirst⟩
    exact hp.trans_le (Finset.single_le_sum
      (fun T hT ↦ matchingFraction_nonneg H T) hmem)
  let B : ℝ := ∑ q ∈ E, mass q
  have hBpos : 0 < B := by
    obtain ⟨q, hq⟩ := Finset.card_pos.mp hEposNat
    exact (hmassPos q hq).trans_le
      (Finset.single_le_sum (fun x hx ↦ (hmassPos x hx).le) hq)
  have hmassBound : B ≤ (Omega.card : ℝ) / (3 * n : ℕ) * u := by
    dsimp only [B, mass, u, gamma, rho, E, Omega]
    simpa only [matchingPermutationSample, Finset.card_product, Nat.cast_mul] using
      sum_candidateMass_activeRank_le hn hH hPhi v hj
  have huPos : 0 < u := by
    have hbasePos : 0 < (Omega.card : ℝ) / (3 * n : ℕ) :=
      div_pos hOmegaPos h3n
    by_contra hu
    have hule : u ≤ 0 := le_of_not_gt hu
    have : (Omega.card : ℝ) / (3 * n : ℕ) * u ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hbasePos.le hule
    linarith
  have hratio : B / (E.card : ℝ) ≤ u := by
    apply (div_le_iff₀ hEpos).2
    rw [hEratio]
    simpa only [mul_comm] using hmassBound
  have hlogRatio : Real.log (B / (E.card : ℝ)) ≤ Real.log u :=
    Real.strictMonoOn_log.monotoneOn (div_pos hBpos hEpos) huPos hratio
  have hjensen : (∑ q ∈ E, Real.log (mass q)) ≤
      (E.card : ℝ) * Real.log (B / (E.card : ℝ)) := by
    have h := weightedLogSum_le E (fun _q ↦ (1 : ℝ)) mass
      (E.card : ℝ) B hEpos hBpos
      (fun q hq ↦ by norm_num) (fun q hq ↦ (hmassPos q hq).le)
      (fun q hq ha ↦ hmassPos q hq)
      (by simp) rfl
    simpa only [one_mul, div_one, Finset.sum_const, nsmul_eq_mul] using h
  have hsumCost :
      ∑ q ∈ Omega, matchingActiveRankCandidateLogCost hH v j q =
        ∑ q ∈ E, Real.log (mass q) := by
    have hE : E = Omega.filter (fun q ↦
        matchingVertexFirst hH q.2 q.1 v ∧
          matchingEdgeRank q.1 q.2 (matchingEdgeAt hH q.2 v) = j) := by
      ext q
      simp only [E, Omega, matchingActiveRankPairs, Finset.mem_filter]
    rw [hE]
    unfold matchingActiveRankCandidateLogCost
    rw [Finset.sum_filter]
  unfold finsetAverage
  rw [hsumCost]
  calc
    (∑ q ∈ E, Real.log (mass q)) / (Omega.card : ℝ) ≤
        ((E.card : ℝ) * Real.log (B / (E.card : ℝ))) /
          (Omega.card : ℝ) :=
      div_le_div_of_nonneg_right hjensen hOmegaPos.le
    _ ≤ ((E.card : ℝ) * Real.log u) / (Omega.card : ℝ) := by
      gcongr
    _ = (1 / ((3 * n : ℕ) : ℝ)) * Real.log u := by
      rw [hEratio]
      field_simp [hOmegaPos.ne', h3n.ne']

lemma matchingEdgeRank_lt_n {n : ℕ} {H F : Finset (Edge n)}
    (hH : H ⊆ allEdges n) (hF : F ∈ perfectMatchings n H)
    (perm : Equiv.Perm (Vertex n)) {A : Edge n} (hAF : A ∈ F) :
    matchingEdgeRank perm F A < n := by
  let p : Edge n → Prop := fun B ↦
    edgeFirstPosition perm B < edgeFirstPosition perm A
  let S := @Finset.filter _ p (Classical.decPred p) F
  unfold matchingEdgeRank finiteRank
  change S.card < n
  have hle : S.card ≤ F.card :=
    @Finset.card_filter_le _ F p (Classical.decPred p)
  have hne :
      S.card ≠ F.card := by
    intro heq
    have hall : ∀ B ∈ F, p B := by
      exact (@Finset.card_filter_eq_iff _ F p
        (Classical.decPred p)).mp heq
    exact (lt_irrefl _ (hall A hAF))
  rw [(mem_perfectMatchings.mp hF).2.1] at hle hne
  omega

lemma sum_matchingActiveRankCandidateLogCost_eq {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n) (v : Vertex n)
    (q : Equiv.Perm (Vertex n) × Finset (Edge n))
    (hq : q ∈ matchingPermutationSample n H) :
    (∑ j ∈ Finset.range n,
        matchingActiveRankCandidateLogCost hH v j q) =
      matchingActiveCandidateLogCost hH v q := by
  have hF : q.2 ∈ perfectMatchings n H :=
    (Finset.mem_product.mp hq).2
  let k := matchingEdgeRank q.1 q.2 (matchingEdgeAt hH q.2 v)
  have hk : k < n := matchingEdgeRank_lt_n hH hF q.1
    (matchingEdgeAt_spec hH hF v).1
  by_cases hfirst : matchingVertexFirst hH q.2 q.1 v
  · unfold matchingActiveRankCandidateLogCost matchingActiveCandidateLogCost
    simp only [hfirst, true_and, if_true]
    rw [Finset.sum_eq_single k]
    · simp only [k, if_pos rfl, if_true]
    · intro j hj hjne
      rw [if_neg]
      simpa only [k] using Ne.symm hjne
    · intro hknot
      exact (hknot (Finset.mem_range.mpr hk)).elim
  · simp only [matchingActiveRankCandidateLogCost,
      matchingActiveCandidateLogCost, hfirst, false_and, if_false,
      Finset.sum_const_zero]

lemma fallingRatio_le_square {n j : ℕ} (hn : 3 ≤ n) (hj : j < n) :
    ((((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
        (((n - 1) * (n - 2) : ℕ) : ℝ)) ≤
      ((((n - j : ℕ) : ℝ) / n)^2) := by
  by_cases ha : 3 ≤ n - j
  · have hden : (0 : ℝ) < (((n - 1) * (n - 2) : ℕ) : ℝ) := by
      exact_mod_cast Nat.mul_pos (by omega) (by omega)
    have hnR : (0 : ℝ) < n := by positivity
    have h1 : ((n - j - 1 : ℕ) : ℝ) + 1 = (n - j : ℕ) := by
      norm_num
      exact_mod_cast (show n - j - 1 + 1 = n - j by omega)
    have h2 : ((n - j - 2 : ℕ) : ℝ) + 2 = (n - j : ℕ) := by
      norm_num
      exact_mod_cast (show n - j - 2 + 2 = n - j by omega)
    have hn1 : ((n - 1 : ℕ) : ℝ) + 1 = n := by
      norm_num
      exact_mod_cast (show n - 1 + 1 = n by omega)
    have hn2 : ((n - 2 : ℕ) : ℝ) + 2 = n := by
      norm_num
      exact_mod_cast (show n - 2 + 2 = n by omega)
    have hale : ((n - j : ℕ) : ℝ) ≤ n := by
      exact_mod_cast Nat.sub_le n j
    have haR : (3 : ℝ) ≤ (n - j : ℕ) := by exact_mod_cast ha
    have hnR3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
    have hprod1 : 0 ≤ (((n - j : ℕ) : ℝ) - 1) * ((n : ℝ) - 1) :=
      mul_nonneg (by linarith) (by linarith)
    have hprod2 : 0 ≤ (((n - j : ℕ) : ℝ) - 3) * (n : ℝ) :=
      mul_nonneg (by linarith) hnR.le
    have hfactor : 0 ≤
        3 * ((n - j : ℕ) : ℝ) * (n : ℝ) -
          2 * ((n - j : ℕ) : ℝ) - 2 * (n : ℝ) := by
      nlinarith
    have hdiff : 0 ≤
        ((n : ℝ) - ((n - j : ℕ) : ℝ)) *
          (3 * ((n - j : ℕ) : ℝ) * (n : ℝ) -
            2 * ((n - j : ℕ) : ℝ) - 2 * (n : ℝ)) :=
      mul_nonneg (sub_nonneg.mpr hale) hfactor
    have h1' : ((n - j - 1 : ℕ) : ℝ) = (n - j : ℕ) - 1 := by
      linarith
    have h2' : ((n - j - 2 : ℕ) : ℝ) = (n - j : ℕ) - 2 := by
      linarith
    have hn1' : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by linarith
    have hn2' : ((n - 2 : ℕ) : ℝ) = (n : ℝ) - 2 := by linarith
    rw [div_pow]
    apply (div_le_iff₀ hden).2
    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ (sq_pos_of_pos hnR)).2
    norm_num only [Nat.cast_mul, Nat.cast_pow]
    rw [h1', h2', hn1', hn2']
    nlinarith [hdiff]
  · have hz : n - j - 1 = 0 ∨ n - j - 2 = 0 := by omega
    rcases hz with hz | hz
    · simp only [hz, zero_mul, Nat.cast_zero, zero_div]
      positivity
    · simp only [hz, mul_zero, Nat.cast_zero, zero_div]
      positivity

lemma matchingVertexGenericityMass_pos {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    0 < matchingVertexGenericityMass H v := by
  obtain ⟨F, hF⟩ := Finset.card_pos.mp (Nat.pos_of_ne_zero hPhi)
  let T := matchingEdgeAt hH F v
  have hTF : T ∈ F := matchingEdgeAt_spec hH hF v |>.1
  have hvT : v ∈ T := matchingEdgeAt_spec hH hF v |>.2
  have hTH : T ∈ H := (mem_perfectMatchings.mp hF).1 hTF
  have hempty : matchingOtherMeetingEdges F v T = ∅ := by
    ext B
    simp only [Finset.notMem_empty, iff_false]
    intro hB
    have hdata := Finset.mem_filter.mp hB
    rcases hdata with ⟨hBF, hvB, hmeet⟩
    by_cases hBT : B = T
    · subst B
      exact hvB hvT
    · have hdisj : Disjoint B T :=
        (mem_perfectMatchings.mp hF).2.2 hBF hTF hBT
      apply hmeet
      rw [Finset.disjoint_left]
      intro x hxB hxErase
      exact Finset.disjoint_left.mp hdisj hxB
        (Finset.mem_of_mem_erase hxErase)
  have hfail : (matchingOtherMeetingEdges F v T).card < 2 := by
    rw [hempty]
    simp
  have hfailurePos : 0 < matchingGenericFailureFraction H v T := by
    unfold matchingGenericFailureFraction finsetProbability
    apply div_pos
    · exact_mod_cast Finset.card_pos.mpr
        ⟨F, Finset.mem_filter.mpr ⟨hF, hfail⟩⟩
    · exact_mod_cast Nat.pos_of_ne_zero hPhi
  have hfractionPos : 0 < matchingFraction H T :=
    matchingFraction_pos_of_mem_perfectMatching hF hTF
  unfold matchingVertexGenericityMass
  have hmem : T ∈ H.filter (fun A ↦ v ∈ A) :=
    Finset.mem_filter.mpr ⟨hTH, hvT⟩
  exact (mul_pos hfractionPos hfailurePos).trans_le
    (Finset.single_le_sum (fun A hA ↦
      mul_nonneg (matchingFraction_nonneg H A)
        (matchingGenericFailureFraction_nonneg H v A)) hmem)

lemma average_matchingActiveRankCandidateLogCost_le_square {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (v : Vertex n) {j : ℕ} (hj : j < n) :
    finsetAverage (matchingPermutationSample n H)
        (matchingActiveRankCandidateLogCost hH v j) ≤
      (1 / ((3 * n : ℕ) : ℝ)) *
        Real.log (matchingVertexGenericityMass H v +
          (1 - matchingVertexGenericityMass H v) *
            ((((n - j : ℕ) : ℝ) / n)^2)) := by
  let gamma := matchingVertexGenericityMass H v
  let rho : ℝ :=
    (((n - j - 1) * (n - j - 2) : ℕ) : ℝ) /
      (((n - 1) * (n - 2) : ℕ) : ℝ)
  let square : ℝ := ((((n - j : ℕ) : ℝ) / n)^2)
  have hgamma0 : 0 < gamma := matchingVertexGenericityMass_pos hH hPhi v
  have hgamma1 : gamma ≤ 1 := matchingVertexGenericityMass_le_one hH hPhi v
  have hrho : rho ≤ square := by
    exact fallingRatio_le_square hn hj
  have hmix : gamma + (1 - gamma) * rho ≤
      gamma + (1 - gamma) * square := by
    gcongr
  have hleftPos : 0 < gamma + (1 - gamma) * rho := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hgamma1)
      (show 0 ≤ rho by dsimp only [rho]; positivity)]
  have hrightPos : 0 < gamma + (1 - gamma) * square := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hgamma1)
      (show 0 ≤ square by dsimp only [square]; positivity)]
  have hlog : Real.log (gamma + (1 - gamma) * rho) ≤
      Real.log (gamma + (1 - gamma) * square) :=
    Real.strictMonoOn_log.monotoneOn hleftPos hrightPos hmix
  calc
    finsetAverage (matchingPermutationSample n H)
        (matchingActiveRankCandidateLogCost hH v j) ≤
      (1 / ((3 * n : ℕ) : ℝ)) *
        Real.log (gamma + (1 - gamma) * rho) := by
          simpa only [gamma, rho] using
            average_matchingActiveRankCandidateLogCost_le hn hH hPhi v hj
    _ ≤ (1 / ((3 * n : ℕ) : ℝ)) *
        Real.log (gamma + (1 - gamma) * square) := by
          exact mul_le_mul_of_nonneg_left hlog (by positivity)
    _ = _ := by rfl

lemma average_matchingActiveCandidateLogCost_le_scalar {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    finsetAverage (matchingPermutationSample n H)
        (matchingActiveCandidateLogCost hH v) ≤
      (1 / ((3 * n : ℕ) : ℝ)) *
        kahnScalarSum n (matchingVertexGenericityMass H v) := by
  let Omega := matchingPermutationSample n H
  let gamma := matchingVertexGenericityMass H v
  have hpoint : ∀ q ∈ Omega,
      matchingActiveCandidateLogCost hH v q =
        ∑ j ∈ Finset.range n,
          matchingActiveRankCandidateLogCost hH v j q := by
    intro q hq
    exact (sum_matchingActiveRankCandidateLogCost_eq hH v q hq).symm
  have havgEq :
      finsetAverage Omega (matchingActiveCandidateLogCost hH v) =
        ∑ j ∈ Finset.range n,
          finsetAverage Omega
            (matchingActiveRankCandidateLogCost hH v j) := by
    unfold finsetAverage
    calc
      (∑ q ∈ Omega, matchingActiveCandidateLogCost hH v q) /
          (Omega.card : ℝ) =
        (∑ q ∈ Omega, ∑ j ∈ Finset.range n,
          matchingActiveRankCandidateLogCost hH v j q) /
            (Omega.card : ℝ) := by
              congr 1
              apply Finset.sum_congr rfl
              exact hpoint
      _ = (∑ j ∈ Finset.range n, ∑ q ∈ Omega,
          matchingActiveRankCandidateLogCost hH v j q) /
            (Omega.card : ℝ) := by rw [Finset.sum_comm]
      _ = ∑ j ∈ Finset.range n,
          (∑ q ∈ Omega, matchingActiveRankCandidateLogCost hH v j q) /
            (Omega.card : ℝ) := by rw [Finset.sum_div]
  have hsumLe :
      (∑ j ∈ Finset.range n,
          finsetAverage Omega
            (matchingActiveRankCandidateLogCost hH v j)) ≤
        ∑ j ∈ Finset.range n,
          (1 / ((3 * n : ℕ) : ℝ)) *
            Real.log (gamma + (1 - gamma) *
              ((((n - j : ℕ) : ℝ) / n)^2)) := by
    apply Finset.sum_le_sum
    intro j hj
    exact average_matchingActiveRankCandidateLogCost_le_square
      hn hH hPhi v (Finset.mem_range.mp hj)
  have hreflect :
      (∑ j ∈ Finset.range n,
          Real.log (gamma + (1 - gamma) *
            ((((n - j : ℕ) : ℝ) / n)^2))) =
        kahnScalarSum n gamma := by
    let f : ℕ → ℝ := fun i ↦
      Real.log (gamma + (1 - gamma) *
        ((((i + 1 : ℕ) : ℝ) / n)^2))
    have h := Finset.sum_range_reflect f n
    unfold kahnScalarSum
    calc
      (∑ j ∈ Finset.range n,
          Real.log (gamma + (1 - gamma) *
            ((((n - j : ℕ) : ℝ) / n)^2))) =
        ∑ j ∈ Finset.range n, f (n - 1 - j) := by
          apply Finset.sum_congr rfl
          intro j hj
          dsimp only [f]
          have hnat : n - 1 - j + 1 = n - j := by
            have := Finset.mem_range.mp hj
            omega
          rw [hnat]
      _ = ∑ i ∈ Finset.range n, f i := h
      _ = ∑ i ∈ Finset.range n,
          Real.log (gamma + (1 - gamma) *
            ((((i + 1 : ℕ) : ℝ) / n)^2)) := by rfl
  calc
    finsetAverage (matchingPermutationSample n H)
        (matchingActiveCandidateLogCost hH v) =
      ∑ j ∈ Finset.range n,
        finsetAverage Omega
          (matchingActiveRankCandidateLogCost hH v j) := by
            exact havgEq
    _ ≤ ∑ j ∈ Finset.range n,
        (1 / ((3 * n : ℕ) : ℝ)) *
          Real.log (gamma + (1 - gamma) *
            ((((n - j : ℕ) : ℝ) / n)^2)) := hsumLe
    _ = (1 / ((3 * n : ℕ) : ℝ)) *
        ∑ j ∈ Finset.range n,
          Real.log (gamma + (1 - gamma) *
            ((((n - j : ℕ) : ℝ) / n)^2)) := by
              rw [Finset.mul_sum]
    _ = (1 / ((3 * n : ℕ) : ℝ)) * kahnScalarSum n gamma := by
      rw [hreflect]
    _ = _ := by rfl

lemma finiteConditionalEntropy_matchingJointKahnZ_le_local_add_scalar
    {n : ℕ} {H : Finset (Edge n)} (hn : 3 ≤ n)
    (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    finiteConditionalEntropy (matchingPermutationSample n H)
        (fun q ↦ matchingEdgeAt hH q.2 v)
        (matchingJointKahnZ hH v) ≤
      (1 / 3 : ℝ) * localMatchingEntropy H v +
        (1 / ((3 * n : ℕ) : ℝ)) *
          kahnScalarSum n (matchingVertexGenericityMass H v) := by
  let Omega := matchingPermutationSample n H
  have havgSplit :
      finsetAverage Omega (matchingKahnPointCost hH v) =
        finsetAverage Omega (matchingActiveCandidateLogCost hH v) +
          finsetAverage Omega (matchingActiveNegLogFractionCost hH v) := by
    unfold finsetAverage
    have hsum :
        (∑ q ∈ Omega, matchingKahnPointCost hH v q) =
          ∑ q ∈ Omega,
            (matchingActiveCandidateLogCost hH v q +
              matchingActiveNegLogFractionCost hH v q) := by
      apply Finset.sum_congr rfl
      intro q hq
      exact matchingKahnPointCost_eq_active_add hH v q hq
    rw [hsum, Finset.sum_add_distrib]
    ring
  calc
    finiteConditionalEntropy (matchingPermutationSample n H)
        (fun q ↦ matchingEdgeAt hH q.2 v)
        (matchingJointKahnZ hH v) ≤
      finsetAverage Omega (matchingKahnPointCost hH v) := by
        exact finiteConditionalEntropy_matchingJointKahnZ_le_pointCost
          hH hPhi v
    _ = finsetAverage Omega (matchingActiveCandidateLogCost hH v) +
          finsetAverage Omega (matchingActiveNegLogFractionCost hH v) :=
      havgSplit
    _ ≤ (1 / ((3 * n : ℕ) : ℝ)) *
          kahnScalarSum n (matchingVertexGenericityMass H v) +
        finsetAverage Omega (matchingActiveNegLogFractionCost hH v) := by
      gcongr
      exact average_matchingActiveCandidateLogCost_le_scalar hn hH hPhi v
    _ = (1 / ((3 * n : ℕ) : ℝ)) *
          kahnScalarSum n (matchingVertexGenericityMass H v) +
        (1 / 3 : ℝ) * localMatchingEntropy H v := by
      rw [average_matchingActiveNegLogFractionCost hH hPhi v]
    _ = _ := by ring

lemma finiteConditionalEntropy_matchingJointKahnZ_le_local_fourthRoot
    {n : ℕ} {H : Finset (Edge n)} (hn : 3 ≤ n)
    (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (v : Vertex n) :
    finiteConditionalEntropy (matchingPermutationSample n H)
        (fun q ↦ matchingEdgeAt hH q.2 v)
        (matchingJointKahnZ hH v) ≤
      (1 / 3 : ℝ) * localMatchingEntropy H v +
        (1 / ((3 * n : ℕ) : ℝ)) *
          (-2 * (n : ℝ) + 4 * Real.sqrt n +
            10 * (n : ℝ) * Real.sqrt
              (Real.sqrt (matchingVertexGenericityMass H v))) := by
  apply (finiteConditionalEntropy_matchingJointKahnZ_le_local_add_scalar
    hn hH hPhi v).trans
  gcongr
  exact kahnScalarSum_le n (matchingVertexGenericityMass H v)
    (by omega) (matchingVertexGenericityMass_nonneg H v)
    (matchingVertexGenericityMass_le_one hH hPhi v)

def matchingVertexGenericityFourthSum {n : ℕ}
    (H : Finset (Edge n)) : ℝ :=
  ∑ v : Vertex n,
    Real.sqrt (Real.sqrt (matchingVertexGenericityMass H v))

lemma sum_matchingVertexGenericityMass_le_error {n : ℕ}
    (H : Finset (Edge n)) :
    (∑ v : Vertex n, matchingVertexGenericityMass H v) ≤
      matchingEntropyGenericityError H := by
  unfold matchingVertexGenericityMass matchingEntropyGenericityError
  rw [matchingIncidentPairs, Finset.sum_sigma]
  apply Finset.sum_le_sum
  intro v hv
  apply Finset.sum_le_sum
  intro A hA
  have hgamma0 := matchingGenericFailureFraction_nonneg H v A
  have hgamma1 := matchingGenericFailureFraction_le_one H v A
  have hs0 := Real.sqrt_nonneg (matchingGenericFailureFraction H v A)
  have hsq := Real.sq_sqrt hgamma0
  have hs1 := Real.sqrt_le_one.mpr hgamma1
  apply mul_le_mul_of_nonneg_left _ (matchingFraction_nonneg H A)
  nlinarith

lemma matchingVertexGenericityFourthSum_le_error {n : ℕ}
    (H : Finset (Edge n)) :
    matchingVertexGenericityFourthSum H ≤
      Real.sqrt
          (Real.sqrt (matchingEntropyGenericityError H) *
            Real.sqrt (3 * n : ℝ)) *
        Real.sqrt (3 * n : ℝ) := by
  let V := (Finset.univ : Finset (Vertex n))
  let gamma : Vertex n → ℝ := matchingVertexGenericityMass H
  let E := matchingEntropyGenericityError H
  have hgamma0 : ∀ v ∈ V, 0 ≤ gamma v := fun v hv ↦
    matchingVertexGenericityMass_nonneg H v
  have hsumGamma0 : 0 ≤ ∑ v ∈ V, gamma v :=
    Finset.sum_nonneg hgamma0
  have hE0 : 0 ≤ E := matchingEntropyGenericityError_nonneg H
  have hsumGamma : (∑ v ∈ V, gamma v) ≤ E := by
    simpa only [V, gamma, E] using
      sum_matchingVertexGenericityMass_le_error H
  have hcard : (V.card : ℝ) = 3 * n := by simp [V]
  have hsumSqrt :
      (∑ v ∈ V, Real.sqrt (gamma v)) ≤
        Real.sqrt E * Real.sqrt (3 * n : ℝ) := by
    have hcs := Real.sum_mul_le_sqrt_mul_sqrt V
      (fun v ↦ Real.sqrt (gamma v)) (fun _v ↦ (1 : ℝ))
    have hsq :
        (∑ v ∈ V, (Real.sqrt (gamma v))^2) =
          ∑ v ∈ V, gamma v := by
      apply Finset.sum_congr rfl
      intro v hv
      exact Real.sq_sqrt (hgamma0 v hv)
    have hone : (∑ _v ∈ V, (1 : ℝ)^2) = (V.card : ℝ) := by simp
    rw [hsq, hone, hcard] at hcs
    calc
      (∑ v ∈ V, Real.sqrt (gamma v)) =
          ∑ v ∈ V, Real.sqrt (gamma v) * 1 := by simp
      _ ≤ Real.sqrt (∑ v ∈ V, gamma v) *
          Real.sqrt (3 * n : ℝ) := hcs
      _ ≤ Real.sqrt E * Real.sqrt (3 * n : ℝ) := by
        exact mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hsumGamma)
          (Real.sqrt_nonneg _)
  have hsumSqrt0 : 0 ≤ ∑ v ∈ V, Real.sqrt (gamma v) :=
    Finset.sum_nonneg fun v hv ↦ Real.sqrt_nonneg _
  have hbound0 : 0 ≤ Real.sqrt E * Real.sqrt (3 * n : ℝ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt V
    (fun v ↦ Real.sqrt (Real.sqrt (gamma v))) (fun _v ↦ (1 : ℝ))
  have hsqFourth :
      (∑ v ∈ V, (Real.sqrt (Real.sqrt (gamma v)))^2) =
        ∑ v ∈ V, Real.sqrt (gamma v) := by
    apply Finset.sum_congr rfl
    intro v hv
    exact Real.sq_sqrt (Real.sqrt_nonneg _)
  have hone : (∑ _v ∈ V, (1 : ℝ)^2) = (V.card : ℝ) := by simp
  rw [hsqFourth, hone, hcard] at hcs
  unfold matchingVertexGenericityFourthSum
  change (∑ v ∈ V, Real.sqrt (Real.sqrt (gamma v))) ≤ _
  calc
    (∑ v ∈ V, Real.sqrt (Real.sqrt (gamma v))) =
        ∑ v ∈ V, Real.sqrt (Real.sqrt (gamma v)) * 1 := by simp
    _ ≤ Real.sqrt (∑ v ∈ V, Real.sqrt (gamma v)) *
        Real.sqrt (3 * n : ℝ) := hcs
    _ ≤ Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
        Real.sqrt (3 * n : ℝ) := by
      exact mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hsumSqrt)
        (Real.sqrt_nonneg _)
    _ = _ := by rfl

lemma log_card_perfectMatchings_le_entropy_minus_two_with_fourthSum
    {n : ℕ} {H : Finset (Edge n)} (hn : 3 ≤ n)
    (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      (1 / 3 : ℝ) * (∑ v : Vertex n, localMatchingEntropy H v) -
        2 * (n : ℝ) + 4 * Real.sqrt n +
        (10 / 3 : ℝ) * matchingVertexGenericityFourthSum H := by
  calc
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      ∑ v : Vertex n,
        finiteConditionalEntropy (matchingPermutationSample n H)
          (fun q ↦ matchingEdgeAt hH q.2 v)
          (matchingJointKahnZ hH v) :=
      log_card_perfectMatchings_le_sum_jointKahnConditionalEntropy hH hPhi
    _ ≤ ∑ v : Vertex n,
        ((1 / 3 : ℝ) * localMatchingEntropy H v +
          (1 / ((3 * n : ℕ) : ℝ)) *
            (-2 * (n : ℝ) + 4 * Real.sqrt n +
              10 * (n : ℝ) * Real.sqrt
                (Real.sqrt (matchingVertexGenericityMass H v)))) := by
      apply Finset.sum_le_sum
      intro v hv
      exact finiteConditionalEntropy_matchingJointKahnZ_le_local_fourthRoot
        hn hH hPhi v
    _ = (1 / 3 : ℝ) * (∑ v : Vertex n, localMatchingEntropy H v) -
        2 * (n : ℝ) + 4 * Real.sqrt n +
        (10 / 3 : ℝ) * matchingVertexGenericityFourthSum H := by
      have hnR : (0 : ℝ) < n := by positivity
      unfold matchingVertexGenericityFourthSum
      rw [Finset.sum_add_distrib, ← Finset.mul_sum]
      simp_rw [mul_add]
      rw [Finset.sum_add_distrib, ← Finset.mul_sum,
        ← Finset.mul_sum]
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul, Nat.cast_mul, Nat.cast_ofNat]
      field_simp [hnR.ne']
      ring

lemma log_card_perfectMatchings_le_entropy_minus_two_with_genericityError
    {n : ℕ} {H : Finset (Edge n)} (hn : 3 ≤ n)
    (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) :
    Real.log ((perfectMatchings n H).card : ℝ) ≤
      (1 / 3 : ℝ) * (∑ v : Vertex n, localMatchingEntropy H v) -
        2 * (n : ℝ) + 4 * Real.sqrt n +
        (10 / 3 : ℝ) *
          (Real.sqrt
              (Real.sqrt (matchingEntropyGenericityError H) *
                Real.sqrt (3 * n : ℝ)) *
            Real.sqrt (3 * n : ℝ)) := by
  exact (log_card_perfectMatchings_le_entropy_minus_two_with_fourthSum
    hn hH hPhi).trans (by
      gcongr
      exact matchingVertexGenericityFourthSum_le_error H)

def KahnCountLower {n : ℕ} (H : Finset (Edge n)) (C : ℝ) : Prop :=
  (n : ℝ) * Real.log ((H.card : ℝ) / n) - 2 * (n : ℝ) - C * (n : ℝ) ≤
    Real.log ((perfectMatchings n H).card : ℝ)

lemma matchingVertexGenericityFourthSum_le_card {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) :
    matchingVertexGenericityFourthSum H ≤ 3 * n := by
  unfold matchingVertexGenericityFourthSum
  calc
    (∑ v : Vertex n,
        Real.sqrt (Real.sqrt (matchingVertexGenericityMass H v))) ≤
      ∑ _v : Vertex n, (1 : ℝ) := by
        apply Finset.sum_le_sum
        intro v hv
        apply Real.sqrt_le_one.mpr
        exact Real.sqrt_le_one.mpr
          (matchingVertexGenericityMass_le_one hH hPhi v)
    _ = 3 * n := by simp

lemma matchingEntropy_near_max_of_countLower {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (C : ℝ)
    (hcount : KahnCountLower H C) :
    (3 * n : ℝ) *
          Real.log (((matchingIncidentPairs H).card : ℝ) / (3 * n : ℝ)) -
        (C + 14) * (3 * n : ℝ) ≤
      ∑ v : Vertex n, localMatchingEntropy H v := by
  have hentropy :=
    log_card_perfectMatchings_le_entropy_minus_two_with_fourthSum
      hn hH hPhi
  have hfourth := matchingVertexGenericityFourthSum_le_card hH hPhi
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast (show 1 ≤ n by omega)
  have hs0 := Real.sqrt_nonneg (n : ℝ)
  have hsq := Real.sq_sqrt (show (0 : ℝ) ≤ n by positivity)
  have hsle : Real.sqrt (n : ℝ) ≤ n := by nlinarith
  have hcard := card_matchingIncidentPairs H hH
  have hratio :
      (((matchingIncidentPairs H).card : ℝ) / (3 * n : ℝ)) =
        (H.card : ℝ) / n := by
    rw [hcard]
    norm_num only [Nat.cast_mul, Nat.cast_ofNat]
    field_simp [show (n : ℝ) ≠ 0 by positivity]
  unfold KahnCountLower at hcount
  rw [hratio]
  nlinarith

lemma sum_log_vertexDegree_le_average {n : ℕ}
    {H : Finset (Edge n)} (hn : 0 < n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) :
    (∑ v : Vertex n, Real.log (vertexDegree H v : ℝ)) ≤
      (3 * n : ℝ) * Real.log ((H.card : ℝ) / n) := by
  let V := (Finset.univ : Finset (Vertex n))
  let d : Vertex n → ℝ := fun v ↦ vertexDegree H v
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hHcardNat : 0 < H.card := by
    obtain ⟨F, hF⟩ := Finset.card_ne_zero.mp hPhi
    have hnH : n ≤ H.card := by
      calc
        n = F.card := (mem_perfectMatchings.mp hF).2.1.symm
        _ ≤ H.card := Finset.card_le_card (mem_perfectMatchings.mp hF).1
    omega
  have hHcard : (0 : ℝ) < H.card := by exact_mod_cast hHcardNat
  have hA : (0 : ℝ) < (3 * n : ℝ) := by positivity
  have hB : (0 : ℝ) < (3 * H.card : ℝ) := by positivity
  have h := weightedLogSum_le V (fun _v ↦ (1 : ℝ)) d
    (3 * n : ℝ) (3 * H.card : ℝ) hA hB
    (fun v hv ↦ by norm_num)
    (fun v hv ↦ by dsimp only [d]; positivity)
    (fun v hv ha ↦ by
      dsimp only [d]
      exact_mod_cast vertexDegree_pos_of_perfectMatching H hH hPhi v)
    (by simp [V]) (by
      dsimp only [V, d]
      exact_mod_cast sum_vertexDegree H hH)
  have hratio : (3 * (H.card : ℝ)) / (3 * (n : ℝ)) =
      (H.card : ℝ) / n := by field_simp
  simpa only [V, d, one_mul, div_one, Nat.cast_mul, Nat.cast_ofNat,
    hratio] using h

lemma totalLocalEntropyDefect_le_of_countLower {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (C : ℝ)
    (hcount : KahnCountLower H C) :
    totalLocalEntropyDefect H ≤
      3 * C * (n : ℝ) + 12 * Real.sqrt n +
        10 * matchingVertexGenericityFourthSum H := by
  have hlog := sum_log_vertexDegree_le_average (by omega) hH hPhi
  have hentropy :=
    log_card_perfectMatchings_le_entropy_minus_two_with_fourthSum
      hn hH hPhi
  unfold KahnCountLower at hcount
  unfold totalLocalEntropyDefect
  rw [Finset.sum_sub_distrib]
  nlinarith

lemma matchingEntropyGenericityError_le_of_countLower
    {n codegCap : ℕ} {H : Finset (Edge n)}
    (hn : 3 ≤ n) (hcap : 0 < codegCap)
    (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap)
    (C sigma : ℝ) (hC : 0 ≤ C) (hsigma : 0 < sigma)
    (hcount : KahnCountLower H C)
    (hratio :
      1 < ((matchingIncidentPairs H).card : ℝ) * sigma /
        ((18 * n * codegCap : ℕ) : ℝ)) :
    matchingEntropyGenericityError H ≤
      (3 * n : ℝ) * Real.sqrt sigma +
        (3 * n : ℝ) * (C + 14 + Real.log 2) /
          Real.log (((matchingIncidentPairs H).card : ℝ) * sigma /
            ((18 * n * codegCap : ℕ) : ℝ)) := by
  exact matchingEntropyGenericityError_le_of_entropy_near_max
    (by omega) hcap hH hPhi hcodeg (C + 14) sigma (by positivity)
    hsigma (matchingEntropy_near_max_of_countLower hn hH hPhi C hcount)
    hratio

lemma matchingVertexGenericityFourthSum_le_of_errorBound {n : ℕ}
    {H : Finset (Edge n)} {E : ℝ}
    (hE : matchingEntropyGenericityError H ≤ E) :
    matchingVertexGenericityFourthSum H ≤
      Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
        Real.sqrt (3 * n : ℝ) := by
  have hactual0 := matchingEntropyGenericityError_nonneg H
  have hE0 : 0 ≤ E := hactual0.trans hE
  apply (matchingVertexGenericityFourthSum_le_error H).trans
  gcongr

lemma presentWeightSpread_of_countLower_and_errorBound {n : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (C E rho delta eta : ℝ)
    (hcount : KahnCountLower H C)
    (herror : matchingEntropyGenericityError H ≤ E)
    (heta : 0 ≤ eta) (hrhodelta : rho < delta)
    (hreg : InverseDegreeRegular H rho)
    (hbudget :
      (3 * n : ℝ) *
          (4 * (3 * C * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤
        (eta * (delta - rho) * (n : ℝ))^2) :
    PresentWeightSpread H delta eta := by
  let D : ℝ :=
    3 * C * (n : ℝ) + 12 * Real.sqrt n +
      10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
        Real.sqrt (3 * n : ℝ))
  have hfourth := matchingVertexGenericityFourthSum_le_of_errorBound
    (n := n) herror
  have hdef : totalLocalEntropyDefect H ≤ D := by
    apply (totalLocalEntropyDefect_le_of_countLower
      hn hH hPhi C hcount).trans
    dsimp only [D]
    gcongr
  exact presentWeightSpread_of_entropyDefect H hH hPhi rho delta eta D
    (by omega) heta hrhodelta hreg hdef (by simpa only [D] using hbudget)

/-! ## Matching-count deletion telescope and complete-model initialization -/

/-- Drop the last `k` recursively exposed deletion choices, leaving the
process history at time `t`.  The recursive decomposition used throughout
the martingale section puts the newest choice at coordinate zero. -/
def deletionHistoryAncestor {n : ℕ} (H : Finset (Edge n)) (t : ℕ) :
    (k : ℕ) → DeletionHistory H (t + k) → DeletionHistory H t
  | 0, e => e
  | k + 1, e =>
      deletionHistoryAncestor H t k
        ((historySuccEquiv H (t + k)) e).1

@[simp] lemma deletionHistoryAncestor_zero {n : ℕ}
    (H : Finset (Edge n)) (t : ℕ) (e : DeletionHistory H t) :
    deletionHistoryAncestor H t 0 e = e := by
  rfl

lemma deletionHistoryAncestor_succ {n : ℕ}
    (H : Finset (Edge n)) (t k : ℕ)
    (e : DeletionHistory H (t + (k + 1))) :
    deletionHistoryAncestor H t (k + 1) e =
      deletionHistoryAncestor H t k
        ((historySuccEquiv H (t + k)) e).1 := by
  rfl

lemma finsetAverage_const_of_nonempty {α : Type*} (s : Finset α)
    (c : ℝ) (hs : s.Nonempty) :
    finsetAverage s (fun _ ↦ c) = c := by
  unfold finsetAverage
  have hcard : (s.card : ℝ) ≠ 0 := by
    exact_mod_cast (Finset.card_ne_zero.mpr hs)
  simp [hcard]

/-- Every recursive process prefix of a uniform deletion history is itself
uniform. -/
lemma finsetAverage_deletionHistoryAncestor {n : ℕ}
    (H : Finset (Edge n)) (t k : ℕ) (htk : t + k ≤ H.card)
    (f : DeletionHistory H t → ℝ) :
    finsetAverage (Finset.univ : Finset (DeletionHistory H (t + k)))
        (fun e ↦ f (deletionHistoryAncestor H t k e)) =
      finsetAverage (Finset.univ : Finset (DeletionHistory H t)) f := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hlt : t + k < H.card := by omega
      rw [finsetAverage_deletionHistory_succ H (t + k) hlt]
      have havail : ∀ e : DeletionHistory H (t + k),
          (Finset.univ : Finset ↥(historyState e (t + k) le_rfl)).Nonempty := by
        intro e
        rw [Finset.univ_nonempty_iff]
        exact Fintype.card_pos_iff.mp (by
          simp only [Fintype.card_coe, card_historyState]
          omega)
      have hinner : ∀ e : DeletionHistory H (t + k),
          finsetAverage
              (Finset.univ : Finset ↥(historyState e (t + k) le_rfl))
              (fun A ↦ f (deletionHistoryAncestor H t (k + 1)
                ((historySuccEquiv H (t + k)).symm ⟨e, A⟩))) =
            f (deletionHistoryAncestor H t k e) := by
        intro e
        have hpred : ∀ A : ↥(historyState e (t + k) le_rfl),
            ((historySuccEquiv H (t + k))
              ((historySuccEquiv H (t + k)).symm ⟨e, A⟩)).1 = e := by
          intro A
          simp
        have hfun :
            (fun A : ↥(historyState e (t + k) le_rfl) ↦
              f (deletionHistoryAncestor H t (k + 1)
                ((historySuccEquiv H (t + k)).symm ⟨e, A⟩))) =
              (fun _ ↦ f (deletionHistoryAncestor H t k e)) := by
          funext A
          simp only [deletionHistoryAncestor_succ]
          rw [hpred A]
        rw [hfun]
        exact finsetAverage_const_of_nonempty _ _ (havail e)
      simp_rw [hinner]
      exact ih (by omega)

lemma finsetProbability_eq_average_indicator {α : Type*}
    (s : Finset α) (P : α → Prop) [DecidablePred P] :
    finsetProbability s P =
      finsetAverage s (fun x ↦ if P x then (1 : ℝ) else 0) := by
  unfold finsetProbability finsetAverage
  rw [Finset.sum_boole]

/-- Probability form of the uniform recursive-prefix law. -/
lemma finsetProbability_deletionHistoryAncestor {n : ℕ}
    (H : Finset (Edge n)) (t k : ℕ) (htk : t + k ≤ H.card)
    (P : DeletionHistory H t → Prop) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory H (t + k)))
        (fun e ↦ P (deletionHistoryAncestor H t k e)) =
      finsetProbability (Finset.univ : Finset (DeletionHistory H t)) P := by
  rw [finsetProbability_eq_average_indicator,
    finsetProbability_eq_average_indicator]
  exact finsetAverage_deletionHistoryAncestor H t k htk
    (fun e ↦ if P e then (1 : ℝ) else 0)

/-- The event that a predicate holds at at least one recursively exposed
process prefix, including time zero and the current time. -/
def SomeDeletionPrefix {n : ℕ} {H : Finset (Edge n)}
    (P : (t : ℕ) → DeletionHistory H t → Prop) :
    (T : ℕ) → DeletionHistory H T → Prop
  | 0, e => P 0 e
  | t + 1, e =>
      SomeDeletionPrefix P t ((historySuccEquiv H t e).1) ∨ P (t + 1) e

@[simp] lemma someDeletionPrefix_zero {n : ℕ} {H : Finset (Edge n)}
    (P : (t : ℕ) → DeletionHistory H t → Prop)
    (e : DeletionHistory H 0) :
    SomeDeletionPrefix P 0 e ↔ P 0 e := by
  rfl

lemma someDeletionPrefix_succ {n : ℕ} {H : Finset (Edge n)}
    (P : (t : ℕ) → DeletionHistory H t → Prop) (t : ℕ)
    (e : DeletionHistory H (t + 1)) :
    SomeDeletionPrefix P (t + 1) e ↔
      SomeDeletionPrefix P t ((historySuccEquiv H t e).1) ∨
        P (t + 1) e := by
  rfl

/-- A union bound simultaneously over every process prefix of one uniform
deletion history. -/
lemma finsetProbability_someDeletionPrefix_le_sum {n : ℕ}
    (H : Finset (Edge n))
    (P : (t : ℕ) → DeletionHistory H t → Prop)
    (T : ℕ) (hT : T ≤ H.card) :
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (SomeDeletionPrefix P T) ≤
      ∑ t ∈ Finset.range (T + 1),
        finsetProbability (Finset.univ : Finset (DeletionHistory H t))
          (P t) := by
  induction T with
  | zero =>
      have heq : finsetProbability
          (Finset.univ : Finset (DeletionHistory H 0))
            (SomeDeletionPrefix P 0) =
          finsetProbability (Finset.univ : Finset (DeletionHistory H 0))
            (P 0) := by
        apply finsetProbability_congr_event
        intro e _
        rfl
      simpa only [Finset.sum_range_succ, Finset.sum_range_zero,
        Finset.sum_empty, zero_add] using le_of_eq heq
  | succ T ih =>
      have hlt : T < H.card := by omega
      let A : DeletionHistory H (T + 1) → Prop :=
        fun e ↦ SomeDeletionPrefix P T ((historySuccEquiv H T e).1)
      let B : DeletionHistory H (T + 1) → Prop := fun e ↦ P (T + 1) e
      have hor := finsetProbability_or_le_add
        (Finset.univ : Finset (DeletionHistory H (T + 1))) A B
      have hA : finsetProbability
          (Finset.univ : Finset (DeletionHistory H (T + 1))) A =
          finsetProbability (Finset.univ : Finset (DeletionHistory H T))
            (SomeDeletionPrefix P T) := by
        change finsetProbability
            (Finset.univ : Finset (DeletionHistory H (T + 1)))
              (fun e ↦ SomeDeletionPrefix P T
                (deletionHistoryAncestor H T 1 e)) = _
        exact finsetProbability_deletionHistoryAncestor H T 1
          (by omega) (SomeDeletionPrefix P T)
      have hB : finsetProbability
          (Finset.univ : Finset (DeletionHistory H (T + 1))) B =
          finsetProbability
            (Finset.univ : Finset (DeletionHistory H (T + 1)))
              (P (T + 1)) := by
        rfl
      rw [hA, hB] at hor
      change finsetProbability
          (Finset.univ : Finset (DeletionHistory H (T + 1)))
            (fun e ↦ A e ∨ B e) ≤ _ at hor
      have hevent : finsetProbability
          (Finset.univ : Finset (DeletionHistory H (T + 1)))
            (SomeDeletionPrefix P (T + 1)) =
          finsetProbability
            (Finset.univ : Finset (DeletionHistory H (T + 1)))
              (fun e ↦ A e ∨ B e) := by
        apply finsetProbability_congr_event
        intro e _
        rfl
      calc
        finsetProbability
              (Finset.univ : Finset (DeletionHistory H (T + 1)))
              (SomeDeletionPrefix P (T + 1)) =
            finsetProbability
              (Finset.univ : Finset (DeletionHistory H (T + 1)))
              (fun e ↦ A e ∨ B e) := hevent
        _ ≤
            finsetProbability
                (Finset.univ : Finset (DeletionHistory H T))
                (SomeDeletionPrefix P T) +
              finsetProbability
                (Finset.univ : Finset (DeletionHistory H (T + 1)))
                (P (T + 1)) := hor
        _ ≤ (∑ t ∈ Finset.range (T + 1),
              finsetProbability
                (Finset.univ : Finset (DeletionHistory H t)) (P t)) +
            finsetProbability
              (Finset.univ : Finset (DeletionHistory H (T + 1)))
              (P (T + 1)) := by
          have hi := ih (by omega)
          exact add_le_add hi (le_refl _)
        _ = ∑ t ∈ Finset.range (T + 1 + 1),
              finsetProbability
                (Finset.univ : Finset (DeletionHistory H t)) (P t) := by
          let q : ℕ → ℝ := fun t ↦
            finsetProbability
              (Finset.univ : Finset (DeletionHistory H t)) (P t)
          change (∑ t ∈ Finset.range (T + 1), q t) + q (T + 1) =
            ∑ t ∈ Finset.range (T + 1 + 1), q t
          exact (Finset.sum_range_succ q (T + 1)).symm

/-- The two ways in which the deterministic first-failure induction can
fail at a process prefix. -/
def DeletionBootstrapBad {n : ℕ} {H : Finset (Edge n)}
    (C u : ℝ) (R : (t : ℕ) → DeletionHistory H t → Prop)
    (t : ℕ) (e : DeletionHistory H t) : Prop :=
  u < stoppedCenteredSum C t e ∨ ¬ R t e

/-- Abstract first-failure induction.  Any structural predicate which,
together with a count-good prefix and the stopped-sum barrier, promotes the
current state to `DeletionStepGood`, propagates the stopped process through
the whole history whenever no prefix is bad. -/
lemma deletionHistoryGood_and_step_of_no_bootstrapBad {n : ℕ}
    {H : Finset (Edge n)} (C u : ℝ)
    (R : (t : ℕ) → DeletionHistory H t → Prop)
    (hpromote : ∀ t (e : DeletionHistory H t),
      DeletionHistoryGood C t e → stoppedCenteredSum C t e ≤ u →
        R t e → DeletionStepGood C e)
    (T : ℕ) (e : DeletionHistory H T)
    (hno : ¬ SomeDeletionPrefix (DeletionBootstrapBad C u R) T e) :
    DeletionHistoryGood C T e ∧ DeletionStepGood C e := by
  induction T with
  | zero =>
      have hsafe : ¬ DeletionBootstrapBad C u R 0 e := by
        simpa only [SomeDeletionPrefix] using hno
      have htail : stoppedCenteredSum C 0 e ≤ u := by
        by_contra h
        apply hsafe
        left
        exact lt_of_not_ge h
      have hR : R 0 e := by
        by_contra h
        exact hsafe (Or.inr h)
      exact ⟨by trivial, hpromote 0 e (by trivial) htail hR⟩
  | succ T ih =>
      let z := historySuccEquiv H T e
      have hsplit :
          ¬ (SomeDeletionPrefix (DeletionBootstrapBad C u R) T z.1 ∨
            DeletionBootstrapBad C u R (T + 1) e) := by
        simpa only [SomeDeletionPrefix, z] using hno
      have hprev := ih z.1 (fun h ↦ hsplit (Or.inl h))
      have hgood : DeletionHistoryGood C (T + 1) e := by
        change DeletionHistoryGood C T z.1 ∧ DeletionStepGood C z.1
        exact hprev
      have hsafe : ¬ DeletionBootstrapBad C u R (T + 1) e :=
        fun h ↦ hsplit (Or.inr h)
      have htail : stoppedCenteredSum C (T + 1) e ≤ u := by
        by_contra h
        apply hsafe
        left
        exact lt_of_not_ge h
      have hR : R (T + 1) e := by
        by_contra h
        exact hsafe (Or.inr h)
      exact ⟨hgood, hpromote (T + 1) e hgood htail hR⟩

lemma deletionHistoryGood_of_no_bootstrapBad {n : ℕ}
    {H : Finset (Edge n)} (C u : ℝ)
    (R : (t : ℕ) → DeletionHistory H t → Prop)
    (hpromote : ∀ t (e : DeletionHistory H t),
      DeletionHistoryGood C t e → stoppedCenteredSum C t e ≤ u →
        R t e → DeletionStepGood C e)
    (T : ℕ) (e : DeletionHistory H T)
    (hno : ¬ SomeDeletionPrefix (DeletionBootstrapBad C u R) T e) :
    DeletionHistoryGood C T e :=
  (deletionHistoryGood_and_step_of_no_bootstrapBad
    C u R hpromote T e hno).1

/-- Probability of some bootstrap failure is bounded by the sum of the
levelwise stopped-tail and structural-failure probabilities. -/
lemma finsetProbability_some_bootstrapBad_le_sum {n : ℕ}
    (H : Finset (Edge n)) (C u : ℝ)
    (R : (t : ℕ) → DeletionHistory H t → Prop)
    (T : ℕ) (hT : T ≤ H.card) :
    finsetProbability (Finset.univ : Finset (DeletionHistory H T))
        (SomeDeletionPrefix (DeletionBootstrapBad C u R) T) ≤
      ∑ t ∈ Finset.range (T + 1),
        (finsetProbability (Finset.univ : Finset (DeletionHistory H t))
            (fun e ↦ u < stoppedCenteredSum C t e) +
          finsetProbability (Finset.univ : Finset (DeletionHistory H t))
            (fun e ↦ ¬ R t e)) := by
  refine (finsetProbability_someDeletionPrefix_le_sum H
    (DeletionBootstrapBad C u R) T hT).trans ?_
  apply Finset.sum_le_sum
  intro t ht
  calc
    finsetProbability (Finset.univ : Finset (DeletionHistory H t))
          (DeletionBootstrapBad C u R t) =
        finsetProbability (Finset.univ : Finset (DeletionHistory H t))
          (fun e ↦ u < stoppedCenteredSum C t e ∨ ¬ R t e) := by
      apply finsetProbability_congr_event
      intro e _
      rfl
    _ ≤ finsetProbability (Finset.univ : Finset (DeletionHistory H t))
          (fun e ↦ u < stoppedCenteredSum C t e) +
        finsetProbability (Finset.univ : Finset (DeletionHistory H t))
          (fun e ↦ ¬ R t e) :=
      finsetProbability_or_le_add
        (Finset.univ : Finset (DeletionHistory H t))
        (fun e ↦ u < stoppedCenteredSum C t e) (fun e ↦ ¬ R t e)

def deletionRawCenteredSum {n : ℕ} {H : Finset (Edge n)} :
    (t : ℕ) → DeletionHistory H t → ℝ
  | 0, _ => 0
  | t + 1, e =>
      let z := historySuccEquiv H t e
      deletionRawCenteredSum t z.1 +
        matchingFraction (historyState z.1 t le_rfl) z.2.1 -
          deletionMean n (historyState z.1 t le_rfl)

def deletionFractionList {n : ℕ} {H : Finset (Edge n)} :
    (t : ℕ) → DeletionHistory H t → List ℝ
  | 0, _ => []
  | t + 1, e =>
      let z := historySuccEquiv H t e
      deletionFractionList t z.1 ++
        [matchingFraction (historyState z.1 t le_rfl) z.2.1]

def recursiveDeletionProduct {n : ℕ} {H : Finset (Edge n)}
    (t : ℕ) (e : DeletionHistory H t) : ℝ :=
  ((deletionFractionList t e).map fun x ↦ 1 - x).prod

def deletionMeanSum (n : ℕ) (H : Finset (Edge n)) : ℕ → ℝ
  | 0 => 0
  | t + 1 => deletionMeanSum n H t + deletionGamma n H t

lemma deletionRawCenteredSum_eq_list_sum {n : ℕ}
    {H : Finset (Edge n)} (t : ℕ) (e : DeletionHistory H t) :
    deletionRawCenteredSum t e =
      (deletionFractionList t e).sum - deletionMeanSum n H t := by
  induction t with
  | zero =>
      simp [deletionRawCenteredSum, deletionFractionList, deletionMeanSum]
  | succ t ih =>
      let z := historySuccEquiv H t e
      change deletionRawCenteredSum t z.1 +
          matchingFraction (historyState z.1 t le_rfl) z.2.1 -
            deletionMean n (historyState z.1 t le_rfl) =
        (deletionFractionList t z.1 ++
          [matchingFraction (historyState z.1 t le_rfl) z.2.1]).sum -
          (deletionMeanSum n H t + deletionGamma n H t)
      rw [ih z.1]
      simp only [List.sum_append, List.sum_singleton]
      rw [deletionMean_historyState z.1 le_rfl]
      ring

lemma recursiveDeletionProduct_succ {n : ℕ}
    {H : Finset (Edge n)} (t : ℕ) (e : DeletionHistory H (t + 1)) :
    recursiveDeletionProduct (t + 1) e =
      let z := historySuccEquiv H t e
      recursiveDeletionProduct t z.1 *
        (1 - matchingFraction (historyState z.1 t le_rfl) z.2.1) := by
  let z := historySuccEquiv H t e
  change ((deletionFractionList t z.1 ++
      [matchingFraction (historyState z.1 t le_rfl) z.2.1]).map
        fun x ↦ 1 - x).prod =
    recursiveDeletionProduct t z.1 *
      (1 - matchingFraction (historyState z.1 t le_rfl) z.2.1)
  simp [recursiveDeletionProduct]

lemma card_historyState_eq_mul_recursiveDeletionProduct {n : ℕ}
    {H : Finset (Edge n)} (t : ℕ) (e : DeletionHistory H t) :
    ((perfectMatchings n (historyState e t le_rfl)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) * recursiveDeletionProduct t e := by
  induction t with
  | zero =>
      rw [historyState_zero]
      simp [recursiveDeletionProduct, deletionFractionList]
  | succ t ih =>
      let z := historySuccEquiv H t e
      have he : (historySuccEquiv H t).symm z = e := by
        exact (historySuccEquiv H t).symm_apply_apply e
      have hstate := historyState_historySuccEquiv_symm H t z.1 z.2
      rw [he] at hstate
      rw [hstate, card_perfectMatchings_erase_mul, ih z.1,
        recursiveDeletionProduct_succ]
      ring

lemma deletionFractionList_nonneg {n : ℕ}
    {H : Finset (Edge n)} (t : ℕ) (e : DeletionHistory H t) :
    ∀ x ∈ deletionFractionList t e, 0 ≤ x := by
  induction t with
  | zero => simp [deletionFractionList]
  | succ t ih =>
      let z := historySuccEquiv H t e
      unfold deletionFractionList
      intro x hx
      rcases List.mem_append.mp hx with hx | hx
      · exact ih z.1 x hx
      · simp only [List.mem_singleton] at hx
        subst x
        exact matchingFraction_nonneg _ _

lemma deletionFractionList_le {n : ℕ}
    {H : Finset (Edge n)} (C b : ℝ) (t : ℕ)
    (e : DeletionHistory H t)
    (hgood : DeletionHistoryGood C t e)
    (hCb : ∀ i < t, C * deletionGamma n H i ≤ b) :
    ∀ x ∈ deletionFractionList t e, x ≤ b := by
  induction t with
  | zero => simp [deletionFractionList]
  | succ t ih =>
      let z := historySuccEquiv H t e
      change DeletionHistoryGood C t z.1 ∧ DeletionStepGood C z.1 at hgood
      unfold deletionFractionList
      intro x hx
      rcases List.mem_append.mp hx with hx | hx
      · exact ih z.1 hgood.1
          (fun i hi ↦ hCb i (hi.trans (Nat.lt_succ_self t))) x hx
      · simp only [List.mem_singleton] at hx
        subst x
        have hcontrol := hgood.2.2 z.2.1 z.2.2
        change matchingFraction (historyState z.1 t le_rfl) z.2.1 ≤
          C * deletionMean n (historyState z.1 t le_rfl) at hcontrol
        rw [deletionMean_historyState z.1 le_rfl] at hcontrol
        exact hcontrol.trans (hCb t (Nat.lt_succ_self t))

lemma stoppedCenteredSum_eq_raw_of_good {n : ℕ}
    {H : Finset (Edge n)} (C : ℝ) (t : ℕ)
    (e : DeletionHistory H t) (hgood : DeletionHistoryGood C t e) :
    stoppedCenteredSum C t e = deletionRawCenteredSum t e := by
  induction t with
  | zero => rfl
  | succ t ih =>
      let z := historySuccEquiv H t e
      change DeletionHistoryGood C t z.1 ∧ DeletionStepGood C z.1 at hgood
      have hgood' :
          DeletionHistoryGood C t ((historySuccEquiv H t) e).1 ∧
            DeletionStepGood C ((historySuccEquiv H t) e).1 := by
        simpa [z] using hgood
      unfold stoppedCenteredSum deletionRawCenteredSum
      simp only [if_pos hgood']
      rw [ih _ hgood'.1]
      ring

lemma deletionHistory_log_ratio_bounds {n : ℕ}
    {H : Finset (Edge n)} (C b : ℝ) (t : ℕ)
    (e : DeletionHistory H t)
    (hinit : (perfectMatchings n H).card ≠ 0)
    (hgood : DeletionHistoryGood C t e)
    (hCb : ∀ i < t, C * deletionGamma n H i ≤ b)
    (hb : b < 1) :
    let Q := ((deletionFractionList t e).map fun x ↦ x^2).sum;
    -(stoppedCenteredSum C t e + deletionMeanSum n H t) - Q / (1 - b) ≤
        Real.log
          (((perfectMatchings n (historyState e t le_rfl)).card : ℝ) /
            (perfectMatchings n H).card) ∧
      Real.log
          (((perfectMatchings n (historyState e t le_rfl)).card : ℝ) /
            (perfectMatchings n H).card) ≤
        -(stoppedCenteredSum C t e + deletionMeanSum n H t) := by
  let L := deletionFractionList t e
  let P := recursiveDeletionProduct t e
  have hL0 : ∀ x ∈ L, 0 ≤ x := deletionFractionList_nonneg t e
  have hLb : ∀ x ∈ L, x ≤ b :=
    deletionFractionList_le C b t e hgood hCb
  have hlog := log_list_prod_one_sub_bounds L b hL0 hLb hb
  have hraw := deletionRawCenteredSum_eq_list_sum t e
  have hstop := stoppedCenteredSum_eq_raw_of_good C t e hgood
  have hLsum : L.sum = stoppedCenteredSum C t e + deletionMeanSum n H t := by
    dsimp only [L]
    linarith
  have hcount := card_historyState_eq_mul_recursiveDeletionProduct t e
  have hinitR : ((perfectMatchings n H).card : ℝ) ≠ 0 := by
    exact_mod_cast hinit
  have hratio :
      ((perfectMatchings n (historyState e t le_rfl)).card : ℝ) /
          (perfectMatchings n H).card = P := by
    dsimp only [P]
    rw [hcount]
    field_simp [hinitR]
  dsimp only
  rw [hratio]
  change -(_ + _) - ((L.map fun x ↦ x^2).sum) / (1 - b) ≤
      Real.log P ∧ Real.log P ≤ -(_ + _)
  dsimp only [P]
  rw [← hLsum]
  exact hlog

lemma colorVertex_eq_iff {n : ℕ} (hn : 0 < n)
    {j k : Fin 3} {i u : Fin n} :
    colorVertex n j i = colorVertex n k u ↔ j = k ∧ i = u := by
  constructor
  · intro h
    have hdiv := congrArg (fun v : Vertex n ↦ v.val / n) h
    have hjk : j = k := by
      apply Fin.ext
      simpa [colorVertex_val_div n hn] using hdiv
    subst k
    exact ⟨rfl, colorVertex_injective n j h⟩
  · rintro ⟨rfl, rfl⟩
    rfl

lemma colorVertex_ne_of_color_ne {n : ℕ} (hn : 0 < n)
    {j k : Fin 3} (hjk : j ≠ k) (i u : Fin n) :
    colorVertex n j i ≠ colorVertex n k u := by
  intro h
  exact hjk ((colorVertex_eq_iff hn).mp h).1

def coloredEdge {n : ℕ} (sigma tau : Equiv.Perm (Fin n))
    (i : Fin n) : Edge n :=
  {colorVertex n (0 : Fin 3) i,
    colorVertex n (1 : Fin 3) (sigma i),
    colorVertex n (2 : Fin 3) (tau i)}

def coloredMatching {n : ℕ} (sigma tau : Equiv.Perm (Fin n)) :
    Finset (Edge n) :=
  Finset.univ.image (coloredEdge sigma tau)

lemma coloredEdge_injective {n : ℕ} (hn : 0 < n)
    (sigma tau : Equiv.Perm (Fin n)) :
    Function.Injective (coloredEdge sigma tau) := by
  intro i j hij
  have hmem : colorVertex n (0 : Fin 3) i ∈ coloredEdge sigma tau j := by
    rw [← hij]
    simp [coloredEdge]
  simp only [coloredEdge, Finset.mem_insert, Finset.mem_singleton] at hmem
  rcases hmem with h | h | h
  · exact (colorVertex_injective n (0 : Fin 3)) h
  · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
  · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)

lemma coloredEdge_card {n : ℕ} (hn : 0 < n)
    (sigma tau : Equiv.Perm (Fin n)) (i : Fin n) :
    (coloredEdge sigma tau i).card = 3 := by
  unfold coloredEdge
  have h01 : colorVertex n (0 : Fin 3) i ≠
      colorVertex n (1 : Fin 3) (sigma i) := by
    exact colorVertex_ne_of_color_ne hn (by decide) _ _
  have h02 : colorVertex n (0 : Fin 3) i ≠
      colorVertex n (2 : Fin 3) (tau i) := by
    exact colorVertex_ne_of_color_ne hn (by decide) _ _
  have h12 : colorVertex n (1 : Fin 3) (sigma i) ≠
      colorVertex n (2 : Fin 3) (tau i) := by
    exact colorVertex_ne_of_color_ne hn (by decide) _ _
  rw [Finset.card_insert_of_notMem, Finset.card_insert_of_notMem]
  · simp
  · simpa using h12
  · simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
    exact ⟨h01, h02⟩

lemma coloredMatching_mem_perfectMatchings {n : ℕ} (hn : 0 < n)
    (sigma tau : Equiv.Perm (Fin n)) :
    coloredMatching sigma tau ∈ perfectMatchings n (allEdges n) := by
  apply mem_perfectMatchings.mpr
  refine ⟨?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    exact mem_allEdges.mpr (coloredEdge_card hn sigma tau i)
  · unfold coloredMatching
    rw [Finset.card_image_of_injective _ (coloredEdge_injective hn sigma tau)]
    simp
  · intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB rfl
    rw [Finset.disjoint_left]
    intro v hvA hvB
    simp only [coloredEdge, Finset.mem_insert, Finset.mem_singleton] at hvA hvB
    rcases hvA with rfl | rfl | rfl <;>
      rcases hvB with h | h | h
    · exact hij ((colorVertex_injective n (0 : Fin 3)) h)
    · exact colorVertex_ne_of_color_ne hn (by decide) _ _ h
    · exact colorVertex_ne_of_color_ne hn (by decide) _ _ h
    · exact colorVertex_ne_of_color_ne hn (by decide) _ _ h
    · exact hij (sigma.injective ((colorVertex_injective n (1 : Fin 3)) h))
    · exact colorVertex_ne_of_color_ne hn (by decide) _ _ h
    · exact colorVertex_ne_of_color_ne hn (by decide) _ _ h
    · exact colorVertex_ne_of_color_ne hn (by decide) _ _ h
    · exact hij (tau.injective ((colorVertex_injective n (2 : Fin 3)) h))

lemma coloredMatching_injective {n : ℕ} (hn : 0 < n) :
    Function.Injective
      (fun p : Equiv.Perm (Fin n) × Equiv.Perm (Fin n) ↦
        coloredMatching p.1 p.2) := by
  rintro ⟨sigma, tau⟩ ⟨sigma', tau'⟩ hmatch
  change coloredMatching sigma tau = coloredMatching sigma' tau' at hmatch
  have hsigma : sigma = sigma' := by
    apply Equiv.ext
    intro i
    have hedge : coloredEdge sigma tau i ∈
        coloredMatching sigma' tau' := by
      rw [← hmatch]
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
    rcases Finset.mem_image.mp hedge with ⟨j, hj, hedgeEq⟩
    have hzero : colorVertex n (0 : Fin 3) i ∈
        coloredEdge sigma' tau' j := by
      rw [hedgeEq]
      simp [coloredEdge]
    simp only [coloredEdge, Finset.mem_insert, Finset.mem_singleton] at hzero
    have hij : i = j := by
      rcases hzero with h | h | h
      · exact (colorVertex_injective n (0 : Fin 3)) h
      · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
      · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
    subst j
    have hone : colorVertex n (1 : Fin 3) (sigma i) ∈
        coloredEdge sigma' tau' i := by
      rw [hedgeEq]
      simp [coloredEdge]
    simp only [coloredEdge, Finset.mem_insert, Finset.mem_singleton] at hone
    rcases hone with h | h | h
    · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
    · exact (colorVertex_injective n (1 : Fin 3)) h
    · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
  have htau : tau = tau' := by
    apply Equiv.ext
    intro i
    have hedge : coloredEdge sigma tau i ∈
        coloredMatching sigma' tau' := by
      rw [← hmatch]
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
    rcases Finset.mem_image.mp hedge with ⟨j, hj, hedgeEq⟩
    have hzero : colorVertex n (0 : Fin 3) i ∈
        coloredEdge sigma' tau' j := by
      rw [hedgeEq]
      simp [coloredEdge]
    simp only [coloredEdge, Finset.mem_insert, Finset.mem_singleton] at hzero
    have hij : i = j := by
      rcases hzero with h | h | h
      · exact (colorVertex_injective n (0 : Fin 3)) h
      · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
      · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
    subst j
    have htwo : colorVertex n (2 : Fin 3) (tau i) ∈
        coloredEdge sigma' tau' i := by
      rw [hedgeEq]
      simp [coloredEdge]
    simp only [coloredEdge, Finset.mem_insert, Finset.mem_singleton] at htwo
    rcases htwo with h | h | h
    · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
    · exact False.elim (colorVertex_ne_of_color_ne hn (by decide) _ _ h)
    · exact (colorVertex_injective n (2 : Fin 3)) h
  subst sigma'
  subst tau'
  rfl

lemma factorial_sq_le_card_perfectMatchings_allEdges {n : ℕ}
    (hn : 0 < n) :
    n.factorial ^ 2 ≤ (perfectMatchings n (allEdges n)).card := by
  let P := (Finset.univ :
    Finset (Equiv.Perm (Fin n) × Equiv.Perm (Fin n)))
  have hmap : Set.MapsTo
      (fun p : Equiv.Perm (Fin n) × Equiv.Perm (Fin n) ↦
        coloredMatching p.1 p.2) (↑P : Set _) (↑(perfectMatchings n (allEdges n))) := by
    intro p hp
    exact coloredMatching_mem_perfectMatchings hn p.1 p.2
  have hcard := Finset.card_le_card_of_injOn
    (fun p : Equiv.Perm (Fin n) × Equiv.Perm (Fin n) ↦
      coloredMatching p.1 p.2) hmap
    (Set.injOn_of_injective (coloredMatching_injective hn))
  simpa [P, Fintype.card_perm, pow_two] using hcard

lemma pow_le_succ_ascFactorial (a k : ℕ) :
    a ^ k ≤ (a + 1).ascFactorial k := by
  induction k with
  | zero => simp
  | succ k ih =>
      calc
        a ^ (k + 1) = a ^ k * a := by rw [pow_succ]
        _ ≤ (a + 1).ascFactorial k * a := Nat.mul_le_mul_right a ih
        _ ≤ (a + 1).ascFactorial k * (a + 1 + k) := by
          exact Nat.mul_le_mul_left _ (by omega)
        _ = (a + 1).ascFactorial (k + 1) := by
          rw [Nat.ascFactorial_succ]
          ring

lemma half_pow_le_factorial_sq {n : ℕ} (hn : 2 ≤ n) :
    (n / 2) ^ n ≤ n.factorial ^ 2 := by
  let a := n / 2
  let k := n - a
  have ha : 1 ≤ a := by dsimp only [a]; omega
  have hak : a + k = n := by dsimp only [a, k]; omega
  have hpowAsc : a ^ k ≤ (a + 1).ascFactorial k :=
    pow_le_succ_ascFactorial a k
  have hfac1 : 1 ≤ a.factorial := Nat.one_le_iff_ne_zero.mpr
    (Nat.ne_of_gt (Nat.factorial_pos a))
  have hpowFac : a ^ k ≤ n.factorial := by
    rw [← hak, ← Nat.factorial_mul_ascFactorial]
    exact hpowAsc.trans (Nat.le_mul_of_pos_left _ hfac1)
  have hnk : n ≤ 2 * k := by dsimp only [k, a]; omega
  calc
    (n / 2) ^ n = a ^ n := by rfl
    _ ≤ a ^ (2 * k) := Nat.pow_le_pow_right ha hnk
    _ = (a ^ k)^2 := by ring
    _ ≤ n.factorial ^ 2 := Nat.pow_le_pow_left hpowFac 2

lemma log_card_perfectMatchings_allEdges_lower {n : ℕ} (hn : 2 ≤ n) :
    (n : ℝ) * Real.log ((n / 2 : ℕ) : ℝ) ≤
      Real.log ((perfectMatchings n (allEdges n)).card : ℝ) := by
  have hhalfNat : 0 < n / 2 := by omega
  have hhalf : (0 : ℝ) < (n / 2 : ℕ) := by exact_mod_cast hhalfNat
  have hpowNat := half_pow_le_factorial_sq hn
  have hcardNat := factorial_sq_le_card_perfectMatchings_allEdges
    (show 0 < n by omega)
  have hleNat : (n / 2) ^ n ≤
      (perfectMatchings n (allEdges n)).card := hpowNat.trans hcardNat
  have hle : (((n / 2) ^ n : ℕ) : ℝ) ≤
      (perfectMatchings n (allEdges n)).card := by exact_mod_cast hleNat
  have hleftPos : (0 : ℝ) < (((n / 2) ^ n : ℕ) : ℝ) := by positivity
  have hrightPos : (0 : ℝ) <
      (perfectMatchings n (allEdges n)).card := hleftPos.trans_le hle
  have hlog := Real.strictMonoOn_log.monotoneOn hleftPos hrightPos hle
  rw [Nat.cast_pow, Real.log_pow] at hlog
  simpa [mul_comm] using hlog

lemma log_card_perfectMatchings_allEdges_stirling {n : ℕ} (hn : 1 ≤ n) :
    2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) ≤
      Real.log ((perfectMatchings n (allEdges n)).card : ℝ) := by
  have hcardNat := factorial_sq_le_card_perfectMatchings_allEdges
    (show 0 < n by omega)
  have hfacNat : 0 < n.factorial ^ 2 := by positivity
  have hfac : (0 : ℝ) < (n.factorial ^ 2 : ℕ) := by exact_mod_cast hfacNat
  have hcard : (0 : ℝ) < (perfectMatchings n (allEdges n)).card := by
    exact_mod_cast (hfacNat.trans_le hcardNat)
  have hlogCard := Real.strictMonoOn_log.monotoneOn hfac hcard
    (by exact_mod_cast hcardNat)
  rw [Nat.cast_pow, Real.log_pow] at hlogCard
  have hst := Stirling.le_log_factorial_stirling
    (show n ≠ 0 by omega)
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hlogn : 0 ≤ Real.log (n : ℝ) := Real.log_nonneg hnR
  have hlogpi : 0 ≤ Real.log (2 * Real.pi) := by
    apply Real.log_nonneg
    nlinarith [Real.two_le_pi]
  have hfacLower :
      (n : ℝ) * Real.log n - n ≤ Real.log (n.factorial : ℝ) := by
    nlinarith
  calc
    2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) =
        2 * ((n : ℝ) * Real.log n - n) := by ring
    _ ≤ 2 * Real.log (n.factorial : ℝ) := by linarith
    _ ≤ Real.log ((perfectMatchings n (allEdges n)).card : ℝ) := hlogCard

lemma reciprocal_le_log_ratio_nat (m : ℕ) (hm : 2 ≤ m) :
    (1 : ℝ) / m ≤ Real.log ((m : ℝ) / (m - 1 : ℕ)) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have hpredNat : 0 < m - 1 := by omega
  have hpredR : (0 : ℝ) < (m - 1 : ℕ) := by exact_mod_cast hpredNat
  have hsmall : (0 : ℝ) < ((m - 1 : ℕ) : ℝ) / m := by positivity
  have hlog := Real.log_le_sub_one_of_pos hsmall
  rw [Real.log_div hpredR.ne' hmR.ne'] at hlog
  have hcast : (((m - 1 : ℕ) : ℝ)) = (m : ℝ) - 1 := by
    rw [Nat.cast_sub (show 1 ≤ m by omega)]
    norm_num
  have hfrac : (((m - 1 : ℕ) : ℝ) / m) - 1 = -(1 / (m : ℝ)) := by
    rw [hcast]
    field_simp [hmR.ne']
    ring
  rw [hfrac] at hlog
  rw [Real.log_div hmR.ne' hpredR.ne']
  linarith

lemma sum_descending_reciprocal_le_log_ratio (K T : ℕ)
    (hT : T ≤ K - 1) :
    (∑ i ∈ Finset.range T, (1 : ℝ) / ((K - i : ℕ) : ℝ)) ≤
      Real.log (K : ℝ) - Real.log ((K - T : ℕ) : ℝ) := by
  induction T with
  | zero => simp
  | succ T ih =>
      have hTK : T + 2 ≤ K := by omega
      have hTprev : T ≤ K - 1 := by omega
      have hm : 2 ≤ K - T := by omega
      have hstep := reciprocal_le_log_ratio_nat (K - T) hm
      have hsub : K - (T + 1) = (K - T) - 1 := by omega
      have hpos : (0 : ℝ) < (K - T : ℕ) := by positivity
      have hpredPos : (0 : ℝ) < ((K - T) - 1 : ℕ) := by
        exact_mod_cast (show 0 < (K - T) - 1 by omega)
      rw [Finset.sum_range_succ]
      calc
        (∑ i ∈ Finset.range T, (1 : ℝ) / ((K - i : ℕ) : ℝ)) +
              1 / ((K - T : ℕ) : ℝ) ≤
            (Real.log (K : ℝ) - Real.log ((K - T : ℕ) : ℝ)) +
              Real.log (((K - T : ℕ) : ℝ) /
                (((K - T) - 1 : ℕ) : ℝ)) :=
          add_le_add (ih hTprev) hstep
        _ = Real.log (K : ℝ) -
              Real.log ((((K - T) - 1 : ℕ) : ℝ)) := by
          rw [Real.log_div hpos.ne' hpredPos.ne']
          ring
        _ = Real.log (K : ℝ) -
              Real.log ((K - (T + 1) : ℕ) : ℝ) := by rw [hsub]

lemma deletionMeanSum_eq_mul_sum (n : ℕ) (H : Finset (Edge n))
    (T : ℕ) :
    deletionMeanSum n H T =
      (n : ℝ) *
        (∑ i ∈ Finset.range T,
          (1 : ℝ) / ((H.card - i : ℕ) : ℝ)) := by
  induction T with
  | zero => simp [deletionMeanSum]
  | succ T ih =>
      rw [deletionMeanSum, ih, Finset.sum_range_succ]
      unfold deletionGamma
      ring

lemma deletionMeanSum_le_log_ratio (n : ℕ) (H : Finset (Edge n))
    (M : ℕ) (hM : 0 < M) (hMK : M ≤ H.card) :
    deletionMeanSum n H (H.card - M) ≤
      (n : ℝ) * Real.log ((H.card : ℝ) / M) := by
  have hT : H.card - M ≤ H.card - 1 := by omega
  have hsum := sum_descending_reciprocal_le_log_ratio
    H.card (H.card - M) hT
  have hsub : H.card - (H.card - M) = M := by omega
  rw [hsub] at hsum
  rw [deletionMeanSum_eq_mul_sum]
  have hn0 : (0 : ℝ) ≤ n := by positivity
  calc
    (n : ℝ) *
          (∑ i ∈ Finset.range (H.card - M),
            (1 : ℝ) / ((H.card - i : ℕ) : ℝ)) ≤
        (n : ℝ) *
          (Real.log (H.card : ℝ) - Real.log (M : ℝ)) :=
      mul_le_mul_of_nonneg_left hsum hn0
    _ = (n : ℝ) * Real.log ((H.card : ℝ) / M) := by
      rw [Real.log_div
        (by exact_mod_cast (show H.card ≠ 0 by omega))
        (by exact_mod_cast hM.ne')]

lemma list_sum_sq_le_mul_sum (L : List ℝ) (b : ℝ)
    (hL0 : ∀ x ∈ L, 0 ≤ x) (hLb : ∀ x ∈ L, x ≤ b) :
    (L.map fun x ↦ x^2).sum ≤ b * L.sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
      have hx0 : 0 ≤ x := hL0 x (by simp)
      have hxb : x ≤ b := hLb x (by simp)
      have htail0 : ∀ y ∈ L, 0 ≤ y := by
        intro y hy
        exact hL0 y (by simp [hy])
      have htailb : ∀ y ∈ L, y ≤ b := by
        intro y hy
        exact hLb y (by simp [hy])
      have hpoint : x^2 ≤ b * x := by nlinarith
      simpa [mul_add] using add_le_add hpoint (ih htail0 htailb)

lemma deletionHistory_log_count_lower {n M : ℕ}
    (hn : 1 ≤ n) (hM : 0 < M) (hMtop : M ≤ (allEdges n).card)
    (C b u : ℝ)
    (e : DeletionHistory (allEdges n) ((allEdges n).card - M))
    (hgood : DeletionHistoryGood C ((allEdges n).card - M) e)
    (hCb : ∀ i < (allEdges n).card - M,
      C * deletionGamma n (allEdges n) i ≤ b)
    (hb0 : 0 ≤ b) (hb1 : b < 1)
    (hstop : stoppedCenteredSum C ((allEdges n).card - M) e ≤ u) :
    2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
        (u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) ≤
      Real.log
        ((perfectMatchings n
          (historyState e ((allEdges n).card - M) le_rfl)).card : ℝ) := by
  let T := (allEdges n).card - M
  let L := deletionFractionList T e
  let S := stoppedCenteredSum C T e + deletionMeanSum n (allEdges n) T
  let Q := (L.map fun x ↦ x^2).sum
  have hinit : (perfectMatchings n (allEdges n)).card ≠ 0 := by
    have hfac := factorial_sq_le_card_perfectMatchings_allEdges
      (show 0 < n by omega)
    have : 0 < n.factorial ^ 2 := by positivity
    omega
  have hbounds := deletionHistory_log_ratio_bounds
    C b T e hinit hgood hCb hb1
  dsimp only at hbounds
  have hraw := deletionRawCenteredSum_eq_list_sum T e
  have hstopRaw := stoppedCenteredSum_eq_raw_of_good C T e hgood
  have hLsum : L.sum = S := by
    dsimp only [L, S]
    linarith
  have hL0 : ∀ x ∈ L, 0 ≤ x := deletionFractionList_nonneg T e
  have hLb : ∀ x ∈ L, x ≤ b :=
    deletionFractionList_le C b T e hgood hCb
  have hQ : Q ≤ b * S := by
    dsimp only [Q]
    rw [← hLsum]
    exact list_sum_sq_le_mul_sum L b hL0 hLb
  have hmean := deletionMeanSum_le_log_ratio n (allEdges n) M hM hMtop
  have hSupper : S ≤
      u + (n : ℝ) * Real.log (((allEdges n).card : ℝ) / M) := by
    dsimp only [S, T]
    exact add_le_add hstop hmean
  have hden : 0 < 1 - b := sub_pos.mpr hb1
  have hQdiv : Q / (1 - b) ≤ b * S / (1 - b) :=
    div_le_div_of_nonneg_right hQ hden.le
  have hratioLower :
      -(u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) ≤
        Real.log
          (((perfectMatchings n (historyState e T le_rfl)).card : ℝ) /
            (perfectMatchings n (allEdges n)).card) := by
    have hSdiv : S / (1 - b) ≤
        (u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) :=
      div_le_div_of_nonneg_right hSupper hden.le
    calc
      -(u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) ≤
          -S / (1 - b) := by
        simpa only [neg_div] using neg_le_neg hSdiv
      _ = -S - (b * S) / (1 - b) := by
        field_simp [hden.ne']
        ring
      _ ≤ -S - Q / (1 - b) := by linarith
      _ ≤ Real.log
          (((perfectMatchings n (historyState e T le_rfl)).card : ℝ) /
            (perfectMatchings n (allEdges n)).card) := by
        simpa only [S, Q, L] using hbounds.1
  have hPpos : 0 < recursiveDeletionProduct T e := by
    unfold recursiveDeletionProduct
    apply List.prod_pos
    intro y hy
    rcases List.mem_map.mp hy with ⟨x, hx, rfl⟩
    have := hLb x hx
    linarith
  have hcount := card_historyState_eq_mul_recursiveDeletionProduct T e
  have hfinalPos : (0 : ℝ) <
      (perfectMatchings n (historyState e T le_rfl)).card := by
    rw [hcount]
    have hinitPos : (0 : ℝ) <
        (perfectMatchings n (allEdges n)).card := by
      exact_mod_cast Nat.pos_of_ne_zero hinit
    exact mul_pos hinitPos hPpos
  have hinitPos : (0 : ℝ) <
      (perfectMatchings n (allEdges n)).card := by
    exact_mod_cast Nat.pos_of_ne_zero hinit
  rw [Real.log_div hfinalPos.ne' hinitPos.ne'] at hratioLower
  have hcomplete := log_card_perfectMatchings_allEdges_stirling hn
  dsimp only [T] at hratioLower hfinalPos ⊢
  calc
    2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) ≤
        Real.log ((perfectMatchings n (allEdges n)).card : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) :=
      sub_le_sub_right hcomplete _
    _ ≤ Real.log
        ((perfectMatchings n
          (historyState e ((allEdges n).card - M) le_rfl)).card : ℝ) := by
      calc
        Real.log ((perfectMatchings n (allEdges n)).card : ℝ) -
              (u + (n : ℝ) *
                Real.log (((allEdges n).card : ℝ) / M)) / (1 - b) =
            Real.log ((perfectMatchings n (allEdges n)).card : ℝ) +
              (-(u + (n : ℝ) *
                Real.log (((allEdges n).card : ℝ) / M)) / (1 - b)) := by
          ring
        _ ≤ Real.log ((perfectMatchings n (allEdges n)).card : ℝ) +
              (Real.log
                ((perfectMatchings n
                  (historyState e ((allEdges n).card - M) le_rfl)).card : ℝ) -
                Real.log ((perfectMatchings n (allEdges n)).card : ℝ)) :=
          by
            simpa only [add_comm] using
              add_le_add_left hratioLower
                (Real.log ((perfectMatchings n (allEdges n)).card : ℝ))
        _ = Real.log
            ((perfectMatchings n
              (historyState e ((allEdges n).card - M) le_rfl)).card : ℝ) := by
          ring

/-- A good history whose one-step deletion fractions are uniformly below
one cannot destroy the last perfect matching at its endpoint. -/
lemma card_historyState_ne_zero_of_good {n t : ℕ}
    {H : Finset (Edge n)} (C b : ℝ) (e : DeletionHistory H t)
    (hinit : (perfectMatchings n H).card ≠ 0)
    (hgood : DeletionHistoryGood C t e)
    (hCb : ∀ i < t, C * deletionGamma n H i ≤ b)
    (hb1 : b < 1) :
    (perfectMatchings n (historyState e t le_rfl)).card ≠ 0 := by
  let L := deletionFractionList t e
  have hLb : ∀ x ∈ L, x ≤ b :=
    deletionFractionList_le C b t e hgood hCb
  have hprod : 0 < recursiveDeletionProduct t e := by
    unfold recursiveDeletionProduct
    apply List.prod_pos
    intro y hy
    rcases List.mem_map.mp hy with ⟨x, hx, rfl⟩
    exact sub_pos.mpr ((hLb x hx).trans_lt hb1)
  have hcount := card_historyState_eq_mul_recursiveDeletionProduct t e
  have hinitPos : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast Nat.pos_of_ne_zero hinit
  have hfinalPos : (0 : ℝ) <
      (perfectMatchings n (historyState e t le_rfl)).card := by
    rw [hcount]
    exact mul_pos hinitPos hprod
  exact_mod_cast hfinalPos.ne'

/-- The deletion telescope supplies exactly the near-maximal matching-count
hypothesis consumed by the entropy bootstrap once its explicit analytic
budget is verified. -/
lemma kahnCountLower_historyState {n M : ℕ}
    (hn : 1 ≤ n) (hM : 0 < M) (hMtop : M ≤ (allEdges n).card)
    (C b u C₀ : ℝ)
    (e : DeletionHistory (allEdges n) ((allEdges n).card - M))
    (hgood : DeletionHistoryGood C ((allEdges n).card - M) e)
    (hCb : ∀ i < (allEdges n).card - M,
      C * deletionGamma n (allEdges n) i ≤ b)
    (hb0 : 0 ≤ b) (hb1 : b < 1)
    (hstop : stoppedCenteredSum C ((allEdges n).card - M) e ≤ u)
    (hbudget :
      (n : ℝ) * Real.log ((M : ℝ) / n) - 2 * (n : ℝ) -
          C₀ * (n : ℝ) ≤
        2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) / M)) / (1 - b)) :
    KahnCountLower
      (historyState e ((allEdges n).card - M) le_rfl) C₀ := by
  unfold KahnCountLower
  have hcard :
      (historyState e ((allEdges n).card - M) le_rfl).card = M := by
    simp only [card_historyState]
    omega
  rw [hcard]
  exact hbudget.trans (deletionHistory_log_count_lower hn hM hMtop
    C b u e hgood hCb hb0 hb1 hstop)

/-- The squared genuine deletion fractions are controlled by the same
quadratic budget that appears in the stopped-martingale MGF. -/
lemma deletionFractionSquareSum_le_varianceBudget {n t : ℕ}
    {H : Finset (Edge n)} (C : ℝ) (e : DeletionHistory H t)
    (hC : 0 ≤ C) (hgood : DeletionHistoryGood C t e) :
    ((deletionFractionList t e).map fun x ↦ x^2).sum ≤
      C * deletionVarianceBudget n H C t := by
  induction t with
  | zero => simp [deletionFractionList, deletionVarianceBudget]
  | succ t ih =>
      let z := historySuccEquiv H t e
      change DeletionHistoryGood C t z.1 ∧ DeletionStepGood C z.1 at hgood
      let x := matchingFraction (historyState z.1 t le_rfl) z.2.1
      have hx0 : 0 ≤ x := matchingFraction_nonneg _ _
      have hxcap : x ≤ C * deletionGamma n H t := by
        have hc := hgood.2.2 z.2.1 z.2.2
        change x ≤ C * deletionMean n (historyState z.1 t le_rfl) at hc
        rw [deletionMean_historyState] at hc
        exact hc
      have hcap0 : 0 ≤ C * deletionGamma n H t := hx0.trans hxcap
      have hxsq : x^2 ≤ C * (C * (deletionGamma n H t)^2) := by
        nlinarith
      unfold deletionFractionList
      simp only [List.map_append, List.map_singleton, List.sum_append,
        List.sum_singleton]
      rw [deletionVarianceBudget_succ]
      have hprev := ih z.1 hgood.1
      dsimp only [x] at hxsq ⊢
      nlinarith

/-- Sharp finite deletion-count lower bound.  Unlike the coarse uniform-cap
version, only the quadratic correction is divided by `1-b`; the main
harmonic term is not. -/
lemma deletionHistory_log_count_lower_sharp {n M : ℕ}
    (hn : 1 ≤ n) (hM : 0 < M) (hMtop : M ≤ (allEdges n).card)
    (C b u : ℝ) (hC : 0 ≤ C)
    (e : DeletionHistory (allEdges n) ((allEdges n).card - M))
    (hgood : DeletionHistoryGood C ((allEdges n).card - M) e)
    (hCb : ∀ i < (allEdges n).card - M,
      C * deletionGamma n (allEdges n) i ≤ b)
    (hb1 : b < 1)
    (hstop : stoppedCenteredSum C ((allEdges n).card - M) e ≤ u) :
    2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
        (u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) -
        (C * deletionVarianceBudget n (allEdges n) C
          ((allEdges n).card - M)) / (1 - b) ≤
      Real.log
        ((perfectMatchings n
          (historyState e ((allEdges n).card - M) le_rfl)).card : ℝ) := by
  let T := (allEdges n).card - M
  let L := deletionFractionList T e
  let S := stoppedCenteredSum C T e + deletionMeanSum n (allEdges n) T
  let Q := (L.map fun x ↦ x^2).sum
  let V := deletionVarianceBudget n (allEdges n) C T
  have hinit : (perfectMatchings n (allEdges n)).card ≠ 0 := by
    have hfac := factorial_sq_le_card_perfectMatchings_allEdges
      (show 0 < n by omega)
    have : 0 < n.factorial ^ 2 := by positivity
    omega
  have hbounds := deletionHistory_log_ratio_bounds
    C b T e hinit hgood hCb hb1
  dsimp only at hbounds
  have hmean := deletionMeanSum_le_log_ratio n (allEdges n) M hM hMtop
  have hSupper : S ≤
      u + (n : ℝ) * Real.log (((allEdges n).card : ℝ) / M) := by
    dsimp only [S, T]
    exact add_le_add hstop hmean
  have hQ : Q ≤ C * V := by
    simpa only [Q, L, V, T] using
      deletionFractionSquareSum_le_varianceBudget C e hC hgood
  have hden : 0 < 1 - b := sub_pos.mpr hb1
  have hQdiv : Q / (1 - b) ≤ (C * V) / (1 - b) :=
    div_le_div_of_nonneg_right hQ hden.le
  have hratioLower :
      -(u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) -
          (C * V) / (1 - b) ≤
        Real.log
          (((perfectMatchings n (historyState e T le_rfl)).card : ℝ) /
            (perfectMatchings n (allEdges n)).card) := by
    calc
      -(u + (n : ℝ) *
          Real.log (((allEdges n).card : ℝ) / M)) -
            (C * V) / (1 - b) ≤ -S - (C * V) / (1 - b) := by
        linarith
      _ ≤ -S - Q / (1 - b) := by linarith
      _ ≤ Real.log
          (((perfectMatchings n (historyState e T le_rfl)).card : ℝ) /
            (perfectMatchings n (allEdges n)).card) := by
        simpa only [S, Q, L] using hbounds.1
  have hPhi := card_historyState_ne_zero_of_good
    C b e hinit hgood hCb hb1
  have hfinalPos : (0 : ℝ) <
      (perfectMatchings n (historyState e T le_rfl)).card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhi
  have hinitPos : (0 : ℝ) <
      (perfectMatchings n (allEdges n)).card := by
    exact_mod_cast Nat.pos_of_ne_zero hinit
  rw [Real.log_div hfinalPos.ne' hinitPos.ne'] at hratioLower
  have hcomplete := log_card_perfectMatchings_allEdges_stirling hn
  dsimp only [T, V] at hratioLower hfinalPos ⊢
  calc
    2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) / M)) -
          (C * deletionVarianceBudget n (allEdges n) C
            ((allEdges n).card - M)) / (1 - b) ≤
        Real.log ((perfectMatchings n (allEdges n)).card : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) / M)) -
          (C * deletionVarianceBudget n (allEdges n) C
            ((allEdges n).card - M)) / (1 - b) := by
      linarith
    _ ≤ Real.log
        ((perfectMatchings n
          (historyState e ((allEdges n).card - M) le_rfl)).card : ℝ) := by
      linarith

/-- Transport an ordered deletion history along an equality of its time
indices. -/
def castDeletionHistory {n : ℕ} (H : Finset (Edge n)) {t u : ℕ}
    (h : t = u) (e : DeletionHistory H t) : DeletionHistory H u :=
  h ▸ e

lemma deletionHistoryGood_cast {n : ℕ} {H : Finset (Edge n)}
    {t u : ℕ} (h : t = u) (C : ℝ) (e : DeletionHistory H t) :
    DeletionHistoryGood C u (castDeletionHistory H h e) ↔
      DeletionHistoryGood C t e := by
  subst u
  rfl

lemma stoppedCenteredSum_cast {n : ℕ} {H : Finset (Edge n)}
    {t u : ℕ} (h : t = u) (C : ℝ) (e : DeletionHistory H t) :
    stoppedCenteredSum C u (castDeletionHistory H h e) =
      stoppedCenteredSum C t e := by
  subst u
  rfl

lemma historyState_castDeletionHistory {n : ℕ} {H : Finset (Edge n)}
    {t u : ℕ} (h : t = u) (e : DeletionHistory H t) :
    historyState (castDeletionHistory H h e) u le_rfl =
      historyState e t le_rfl := by
  subst u
  rfl

/-- Time-indexed form of `kahnCountLower_historyState`; it avoids exposing
the endpoint edge-count parameter in the first-failure induction. -/
lemma kahnCountLower_historyState_at_time {n t : ℕ}
    (hn : 1 ≤ n) (ht : t < (allEdges n).card)
    (C b u C₀ : ℝ) (e : DeletionHistory (allEdges n) t)
    (hgood : DeletionHistoryGood C t e)
    (hCb : ∀ i < t, C * deletionGamma n (allEdges n) i ≤ b)
    (hb0 : 0 ≤ b) (hb1 : b < 1)
    (hstop : stoppedCenteredSum C t e ≤ u)
    (hbudget :
      (n : ℝ) *
            Real.log ((((allEdges n).card - t : ℕ) : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ) ≤
        2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) /
              ((allEdges n).card - t : ℕ))) / (1 - b)) :
    KahnCountLower (historyState e t le_rfl) C₀ := by
  let M := (allEdges n).card - t
  have hM : 0 < M := by dsimp only [M]; omega
  have hMtop : M ≤ (allEdges n).card := Nat.sub_le _ _
  have heq : (allEdges n).card - M = t := by
    dsimp only [M]
    omega
  let e' := castDeletionHistory (allEdges n) heq.symm e
  have hgood' : DeletionHistoryGood C ((allEdges n).card - M) e' := by
    exact (deletionHistoryGood_cast heq.symm C e).2 hgood
  have hCb' : ∀ i < (allEdges n).card - M,
      C * deletionGamma n (allEdges n) i ≤ b := by
    intro i hi
    exact hCb i (by omega)
  have hstop' : stoppedCenteredSum C ((allEdges n).card - M) e' ≤ u := by
    rw [stoppedCenteredSum_cast heq.symm C e]
    exact hstop
  have hc := kahnCountLower_historyState hn hM hMtop C b u C₀ e'
    hgood' hCb' hb0 hb1 hstop' (by simpa only [M] using hbudget)
  rw [historyState_castDeletionHistory heq.symm e] at hc
  exact hc

/-- The structural conclusion needed at one deletion level.  It is phrased
conditionally on `KahnCountLower`, so graphs outside the first-failure
count regime do not contribute to the exceptional event. -/
def KahnBootstrapStructure {n t : ℕ}
    (e : DeletionHistory (allEdges n) t)
    (C₀ L eta q c : ℝ) : Prop :=
  KahnCountLower (historyState e t le_rfl) C₀ →
    GlobalUpperWeightSpread n (historyState e t le_rfl) L eta ∧
      MaximumWeightDominated n (historyState e t le_rfl) q c

/-- The count telescope and a structural certificate promote a prefix to
the exact stopped-martingale step condition. -/
lemma deletionStepGood_of_kahnBootstrapStructure {n t : ℕ}
    (hn : 1 ≤ n) (ht : t < (allEdges n).card)
    (C₀ L eta q c b u : ℝ)
    (hc : 0 < c) (hqeta : eta < q)
    (e : DeletionHistory (allEdges n) t)
    (hgood : DeletionHistoryGood (L / c) t e)
    (hCb : ∀ i < t,
      (L / c) * deletionGamma n (allEdges n) i ≤ b)
    (hb0 : 0 ≤ b) (hb1 : b < 1)
    (hstop : stoppedCenteredSum (L / c) t e ≤ u)
    (hbudget :
      (n : ℝ) *
            Real.log ((((allEdges n).card - t : ℕ) : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ) ≤
        2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) /
              ((allEdges n).card - t : ℕ))) / (1 - b))
    (hstructure : KahnBootstrapStructure e C₀ L eta q c) :
    DeletionStepGood (L / c) e := by
  have hinit : (perfectMatchings n (allEdges n)).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp
        (allEdges_hasPerfectMatching n))
  have hPhi := card_historyState_ne_zero_of_good
    (L / c) b e hinit hgood hCb hb1
  have hcount := kahnCountLower_historyState_at_time
    hn ht (L / c) b u C₀ e hgood hCb hb0 hb1 hstop hbudget
  rcases hstructure hcount with ⟨hspread, hdom⟩
  have hsubset : historyState e t le_rfl ⊆ allEdges n := by
    intro A hA
    exact (Finset.mem_sdiff.mp hA).1
  refine ⟨hPhi, ?_⟩
  exact weightControlled_of_global_upper_spread_max
    (historyState e t le_rfl) hsubset L eta q c (by omega) hc hqeta
    hPhi hspread hdom

lemma kahnCountLower_historyState_sharp {n M : ℕ}
    (hn : 1 ≤ n) (hM : 0 < M) (hMtop : M ≤ (allEdges n).card)
    (C b u C₀ : ℝ) (hC : 0 ≤ C)
    (e : DeletionHistory (allEdges n) ((allEdges n).card - M))
    (hgood : DeletionHistoryGood C ((allEdges n).card - M) e)
    (hCb : ∀ i < (allEdges n).card - M,
      C * deletionGamma n (allEdges n) i ≤ b)
    (hb1 : b < 1)
    (hstop : stoppedCenteredSum C ((allEdges n).card - M) e ≤ u)
    (hbudget :
      (n : ℝ) * Real.log ((M : ℝ) / n) - 2 * (n : ℝ) -
          C₀ * (n : ℝ) ≤
        2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) / M)) -
          (C * deletionVarianceBudget n (allEdges n) C
            ((allEdges n).card - M)) / (1 - b)) :
    KahnCountLower
      (historyState e ((allEdges n).card - M) le_rfl) C₀ := by
  unfold KahnCountLower
  have hcard :
      (historyState e ((allEdges n).card - M) le_rfl).card = M := by
    simp only [card_historyState]
    omega
  rw [hcard]
  exact hbudget.trans (deletionHistory_log_count_lower_sharp
    hn hM hMtop C b u hC e hgood hCb hb1 hstop)

lemma kahnCountLower_historyState_at_time_sharp {n t : ℕ}
    (hn : 1 ≤ n) (ht : t < (allEdges n).card)
    (C b u C₀ : ℝ) (hC : 0 ≤ C)
    (e : DeletionHistory (allEdges n) t)
    (hgood : DeletionHistoryGood C t e)
    (hCb : ∀ i < t, C * deletionGamma n (allEdges n) i ≤ b)
    (hb1 : b < 1)
    (hstop : stoppedCenteredSum C t e ≤ u)
    (hbudget :
      (n : ℝ) *
            Real.log ((((allEdges n).card - t : ℕ) : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ) ≤
        2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) /
              ((allEdges n).card - t : ℕ))) -
          (C * deletionVarianceBudget n (allEdges n) C t) / (1 - b)) :
    KahnCountLower (historyState e t le_rfl) C₀ := by
  let M := (allEdges n).card - t
  have hM : 0 < M := by dsimp only [M]; omega
  have hMtop : M ≤ (allEdges n).card := Nat.sub_le _ _
  have heq : (allEdges n).card - M = t := by
    dsimp only [M]
    omega
  let e' := castDeletionHistory (allEdges n) heq.symm e
  have hgood' : DeletionHistoryGood C ((allEdges n).card - M) e' := by
    exact (deletionHistoryGood_cast heq.symm C e).2 hgood
  have hCb' : ∀ i < (allEdges n).card - M,
      C * deletionGamma n (allEdges n) i ≤ b := by
    intro i hi
    exact hCb i (by omega)
  have hstop' : stoppedCenteredSum C ((allEdges n).card - M) e' ≤ u := by
    rw [stoppedCenteredSum_cast heq.symm C e]
    exact hstop
  have hc := kahnCountLower_historyState_sharp
    hn hM hMtop C b u C₀ hC e' hgood' hCb' hb1 hstop'
    (by simpa only [M, heq] using hbudget)
  rw [historyState_castDeletionHistory heq.symm e] at hc
  exact hc

lemma deletionStepGood_of_kahnBootstrapStructure_sharp {n t : ℕ}
    (hn : 1 ≤ n) (ht : t < (allEdges n).card)
    (C₀ L eta q c b u : ℝ)
    (hL : 0 ≤ L) (hc : 0 < c) (hqeta : eta < q)
    (e : DeletionHistory (allEdges n) t)
    (hgood : DeletionHistoryGood (L / c) t e)
    (hCb : ∀ i < t,
      (L / c) * deletionGamma n (allEdges n) i ≤ b)
    (hb1 : b < 1)
    (hstop : stoppedCenteredSum (L / c) t e ≤ u)
    (hbudget :
      (n : ℝ) *
            Real.log ((((allEdges n).card - t : ℕ) : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ) ≤
        2 * (n : ℝ) * Real.log (n : ℝ) - 2 * (n : ℝ) -
          (u + (n : ℝ) *
            Real.log (((allEdges n).card : ℝ) /
              ((allEdges n).card - t : ℕ))) -
          ((L / c) * deletionVarianceBudget n (allEdges n) (L / c) t) /
            (1 - b))
    (hstructure : KahnBootstrapStructure e C₀ L eta q c) :
    DeletionStepGood (L / c) e := by
  have hC : 0 ≤ L / c := div_nonneg hL hc.le
  have hinit : (perfectMatchings n (allEdges n)).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp
        (allEdges_hasPerfectMatching n))
  have hPhi := card_historyState_ne_zero_of_good
    (L / c) b e hinit hgood hCb hb1
  have hcount := kahnCountLower_historyState_at_time_sharp
    hn ht (L / c) b u C₀ hC e hgood hCb hb1 hstop hbudget
  rcases hstructure hcount with ⟨hspread, hdom⟩
  have hsubset : historyState e t le_rfl ⊆ allEdges n := by
    intro A hA
    exact (Finset.mem_sdiff.mp hA).1
  refine ⟨hPhi, ?_⟩
  exact weightControlled_of_global_upper_spread_max
    (historyState e t le_rfl) hsubset L eta q c (by omega) hc hqeta
    hPhi hspread hdom

lemma finsetProbability_not_eq_one_sub {α : Type*}
    (s : Finset α) (P : α → Prop) [DecidablePred P]
    (hs : s.Nonempty) :
    finsetProbability s (fun x ↦ ¬ P x) = 1 - finsetProbability s P := by
  have hcard : s.card ≠ 0 := Finset.card_ne_zero.mpr hs
  have hsplit := Finset.card_filter_add_card_filter_not (s := s) (p := P)
  unfold finsetProbability
  have hsplitR :
      ((s.filter P).card : ℝ) + ((s.filter fun x ↦ ¬ P x).card : ℝ) =
        (s.card : ℝ) := by
    exact_mod_cast hsplit
  have hcardR : (s.card : ℝ) ≠ 0 := by exact_mod_cast hcard
  field_simp [hcardR]
  linarith

/-- A finite first-failure certificate bounds the probability of having no
perfect matching by the probability that some process prefix is bad. -/
lemma one_sub_pmProbability_le_some_bootstrapBad {n M : ℕ}
    (hM : M ≤ (allEdges n).card)
    (C u : ℝ)
    (R : (t : ℕ) → DeletionHistory (allEdges n) t → Prop)
    (hpromote : ∀ t (e : DeletionHistory (allEdges n) t),
      DeletionHistoryGood C t e → stoppedCenteredSum C t e ≤ u →
        R t e → DeletionStepGood C e) :
    1 - pmProbability n M ≤
      finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) ((allEdges n).card - M)))
        (SomeDeletionPrefix (DeletionBootstrapBad C u R)
          ((allEdges n).card - M)) := by
  let T := (allEdges n).card - M
  let S := (Finset.univ : Finset (DeletionHistory (allEdges n) T))
  let P : DeletionHistory (allEdges n) T → Prop := fun e ↦
    HasPerfectMatching n (remainingAfterHistory e)
  let B : DeletionHistory (allEdges n) T → Prop :=
    SomeDeletionPrefix (DeletionBootstrapBad C u R) T
  have hS : S.Nonempty := by
    dsimp only [S, T]
    rw [Finset.univ_nonempty_iff]
    exact deletionHistory_nonempty_of_card_le _ _ (Nat.sub_le _ _)
  have hcomp : finsetProbability S (fun e ↦ ¬ P e) =
      1 - finsetProbability S P :=
    finsetProbability_not_eq_one_sub S P hS
  have hsub : finsetProbability S (fun e ↦ ¬ P e) ≤
      finsetProbability S B := by
    apply finsetProbability_mono_event
    intro e he hnotP
    by_contra hnotB
    have hgs := deletionHistoryGood_and_step_of_no_bootstrapBad
      C u R hpromote T e hnotB
    have hPhi :
        (perfectMatchings n (remainingAfterHistory e)).card ≠ 0 := by
      simpa only [historyState_top] using hgs.2.1
    exact hnotP
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mpr
        (Finset.card_ne_zero.mp hPhi))
  have hpm := pmProbability_eq_history_probability n M hM
  change 1 - pmProbability n M ≤ finsetProbability S B
  rw [hpm]
  change 1 - finsetProbability S P ≤ finsetProbability S B
  rw [← hcomp]
  exact hsub

lemma pmProbability_tendsto_one_of_failure_bound
    (M : ℕ → ℕ) (B : ℕ → ℝ)
    (hbound : ∀ n, 1 - pmProbability n (M n) ≤ B n)
    (hB : Tendsto B atTop (𝓝 0)) :
    Tendsto (fun n ↦ pmProbability n (M n)) atTop (𝓝 1) := by
  have hfail : Tendsto (fun n ↦ 1 - pmProbability n (M n))
      atTop (𝓝 0) := by
    apply squeeze_zero'
    · exact Eventually.of_forall fun n ↦ sub_nonneg.mpr
        (pmProbability_le_one n (M n))
    · exact Eventually.of_forall hbound
    · exact hB
  have hone : Tendsto (fun _ : ℕ ↦ (1 : ℝ)) atTop (𝓝 1) :=
    tendsto_const_nhds
  have hsub := hone.sub hfail
  simpa only [sub_sub_cancel, sub_zero] using hsub

/-- Asymptotic closure interface for the deletion proof.  Once the
probability of some prefix violating the first-failure certificate tends to
zero, the perfect-matching probability tends to one. -/
lemma pmProbability_tendsto_one_of_bootstrapBad
    (M : ℕ → ℕ) (C u : ℕ → ℝ)
    (R : (n t : ℕ) → DeletionHistory (allEdges n) t → Prop)
    (hM : ∀ n, M n ≤ (allEdges n).card)
    (hpromote : ∀ n t (e : DeletionHistory (allEdges n) t),
      DeletionHistoryGood (C n) t e →
        stoppedCenteredSum (C n) t e ≤ u n →
          R n t e → DeletionStepGood (C n) e)
    (hbad : Tendsto
      (fun n ↦ finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) ((allEdges n).card - M n)))
        (SomeDeletionPrefix (DeletionBootstrapBad (C n) (u n) (R n))
          ((allEdges n).card - M n))) atTop (𝓝 0)) :
    Tendsto (fun n ↦ pmProbability n (M n)) atTop (𝓝 1) := by
  apply pmProbability_tendsto_one_of_failure_bound M
    (fun n ↦ finsetProbability
      (Finset.univ : Finset
        (DeletionHistory (allEdges n) ((allEdges n).card - M n)))
      (SomeDeletionPrefix (DeletionBootstrapBad (C n) (u n) (R n))
        ((allEdges n).card - M n)))
  · intro n
    exact one_sub_pmProbability_le_some_bootstrapBad
      (hM n) (C n) (u n) (R n) (hpromote n)
  · exact hbad

/-- Forgetting the uniform deletion-order tag leaves the uniform fixed-size
remaining set for every predicate, not only the perfect-matching event. -/
lemma orderedDeletionSample_remaining_probability {n : ℕ}
    (H : Finset (Edge n)) (M : ℕ)
    (P : Finset (Edge n) → Prop) :
    finsetProbability
        (Finset.univ : Finset (OrderedDeletionSample H M))
        (fun ω ↦ P (orderedRemaining ω)) =
      finsetProbability (H.powersetCard M) P := by
  let A := RemainingChoice H M
  let B := Equiv.Perm (Fin (H.card - M))
  have hfilter :
      (Finset.univ : Finset (A × B)).filter (fun ω ↦ P ω.1.1) =
        ((Finset.univ : Finset A).filter (fun G ↦ P G.1)).product
          (Finset.univ : Finset B) := by
    ext ω
    simp
  have hbaseFilter :
      ((Finset.univ : Finset A).filter (fun G ↦ P G.1)).card =
        ((H.powersetCard M).filter P).card := by
    apply Finset.card_bij
      (s := (Finset.univ : Finset A).filter (fun G ↦ P G.1))
      (t := (H.powersetCard M).filter P)
      (fun G _ ↦ G.1)
    · intro G hG
      exact Finset.mem_filter.mpr
        ⟨G.2, (Finset.mem_filter.mp hG).2⟩
    · intro G₁ _ G₂ _ h
      exact Subtype.ext h
    · intro G hG
      refine ⟨⟨G, (Finset.mem_filter.mp hG).1⟩,
        Finset.mem_filter.mpr ⟨Finset.mem_univ _,
          (Finset.mem_filter.mp hG).2⟩, rfl⟩
  have hBpos : 0 < Fintype.card B :=
    Fintype.card_pos_iff.mpr ⟨Equiv.refl _⟩
  have hBne : ((Fintype.card B : ℕ) : ℝ) ≠ 0 := by
    exact_mod_cast hBpos.ne'
  have hprodcard :
      (((Finset.univ : Finset A).filter
          (fun G ↦ P G.1)).product
        (Finset.univ : Finset B)).card =
      ((Finset.univ : Finset A).filter
          (fun G ↦ P G.1)).card *
        (Finset.univ : Finset B).card :=
    Finset.card_product _ _
  have hAcard : Fintype.card A = (H.powersetCard M).card := by
    dsimp only [A, RemainingChoice]
    rw [Fintype.card_coe]
  unfold finsetProbability
  change
    (((Finset.univ : Finset (A × B)).filter
        (fun ω ↦ P ω.1.1)).card : ℝ) /
        ((Finset.univ : Finset (A × B)).card : ℝ) = _
  rw [hfilter, hprodcard, Finset.card_univ,
    Finset.card_univ, Fintype.card_prod, Nat.cast_mul, Nat.cast_mul,
    mul_div_mul_right _ _ hBne, hbaseFilter, hAcard]

/-- A state-dependent event has the same probability under a uniform
ordered deletion history and under the corresponding fixed-edge sample. -/
lemma historyState_probability_eq_sample {n M : ℕ}
    (hM : M ≤ (allEdges n).card)
    (P : Finset (Edge n) → Prop) :
    finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) ((allEdges n).card - M)))
        (fun e ↦ P (historyState e ((allEdges n).card - M) le_rfl)) =
      finsetProbability (sample n M) P := by
  rw [← orderedDeletion_probability_eq_history (allEdges n) M hM]
  calc
    finsetProbability
          (Finset.univ : Finset (OrderedDeletionSample (allEdges n) M))
          (fun ω ↦ P
            (historyState (orderedDeletionHistory ω)
              ((allEdges n).card - M) le_rfl)) =
        finsetProbability
          (Finset.univ : Finset (OrderedDeletionSample (allEdges n) M))
          (fun ω ↦ P (orderedRemaining ω)) := by
      apply finsetProbability_congr_event
      intro ω _
      simp only [historyState_top, remainingAfter_orderedDeletionHistory]
    _ = finsetProbability (sample n M) P := by
      simpa only [sample] using
        orderedDeletionSample_remaining_probability (allEdges n) M P

def KahnStructuralFailure (n : ℕ) (C₀ L eta q c : ℝ)
    (H : Finset (Edge n)) : Prop :=
  KahnCountLower H C₀ ∧
    (¬ GlobalUpperWeightSpread n H L eta ∨
      ¬ MaximumWeightDominated n H q c)

lemma not_kahnBootstrapStructure_iff_failure {n t : ℕ}
    (e : DeletionHistory (allEdges n) t) (C₀ L eta q c : ℝ) :
    ¬ KahnBootstrapStructure e C₀ L eta q c ↔
      KahnStructuralFailure n C₀ L eta q c
        (historyState e t le_rfl) := by
  unfold KahnBootstrapStructure KahnStructuralFailure
  tauto

/-- The exceptional structural event at a deletion level is exactly the
corresponding event in the ordinary fixed-edge sample. -/
lemma kahnBootstrapStructure_failure_probability_eq_sample {n M : ℕ}
    (hM : M ≤ (allEdges n).card) (C₀ L eta q c : ℝ) :
    finsetProbability
        (Finset.univ : Finset
          (DeletionHistory (allEdges n) ((allEdges n).card - M)))
        (fun e ↦ ¬ KahnBootstrapStructure e C₀ L eta q c) =
      finsetProbability (sample n M)
        (KahnStructuralFailure n C₀ L eta q c) := by
  calc
    finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) ((allEdges n).card - M)))
          (fun e ↦ ¬ KahnBootstrapStructure e C₀ L eta q c) =
        finsetProbability
          (Finset.univ : Finset
            (DeletionHistory (allEdges n) ((allEdges n).card - M)))
          (fun e ↦ KahnStructuralFailure n C₀ L eta q c
            (historyState e ((allEdges n).card - M) le_rfl)) := by
      apply finsetProbability_congr_event
      intro e _
      exact not_kahnBootstrapStructure_iff_failure e C₀ L eta q c
    _ = finsetProbability (sample n M)
          (KahnStructuralFailure n C₀ L eta q c) :=
      historyState_probability_eq_sample hM _

/-- Split the structural failure into its global-spreading and maximum-
domination components. -/
lemma kahnStructuralFailure_probability_le {n M : ℕ}
    (C₀ L eta q c : ℝ) :
    finsetProbability (sample n M)
        (KahnStructuralFailure n C₀ L eta q c) ≤
      finsetProbability (sample n M)
        (fun H ↦ KahnCountLower H C₀ ∧
          ¬ GlobalUpperWeightSpread n H L eta) +
      finsetProbability (sample n M)
        (fun H ↦ KahnCountLower H C₀ ∧
          ¬ MaximumWeightDominated n H q c) := by
  calc
    finsetProbability (sample n M)
          (KahnStructuralFailure n C₀ L eta q c) =
        finsetProbability (sample n M)
          (fun H ↦
            (KahnCountLower H C₀ ∧
              ¬ GlobalUpperWeightSpread n H L eta) ∨
            (KahnCountLower H C₀ ∧
              ¬ MaximumWeightDominated n H q c)) := by
      apply finsetProbability_congr_event
      intro H _
      unfold KahnStructuralFailure
      tauto
    _ ≤ _ := finsetProbability_or_le_add _ _ _

lemma log_succ_div_sub_log_div_le_one (n M : ℕ)
    (hn : 0 < n) (hM : 0 < M) :
    Real.log (((M + 1 : ℕ) : ℝ) / n) -
        Real.log ((M : ℝ) / n) ≤ 1 := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hMR : (0 : ℝ) < M := by exact_mod_cast hM
  have hM1R : (0 : ℝ) < (M + 1 : ℕ) := by positivity
  have hratio : (0 : ℝ) < (((M + 1 : ℕ) : ℝ) / M) := by positivity
  have hlog := Real.log_le_sub_one_of_pos hratio
  have hratioEq : (((M + 1 : ℕ) : ℝ) / M) - 1 = 1 / (M : ℝ) := by
    norm_num only [Nat.cast_add, Nat.cast_one]
    field_simp [hMR.ne']
    ring
  rw [hratioEq] at hlog
  have hinv : (1 : ℝ) / M ≤ 1 := by
    exact (div_le_one hMR).2 (by exact_mod_cast hM)
  rw [Real.log_div hM1R.ne' hnR.ne', Real.log_div hMR.ne' hnR.ne']
  have hdiff : Real.log ((M + 1 : ℕ) : ℝ) - Real.log (M : ℝ) =
      Real.log (((M + 1 : ℕ) : ℝ) / M) := by
    rw [Real.log_div hM1R.ne' hMR.ne']
  rw [show (Real.log ((M + 1 : ℕ) : ℝ) - Real.log (n : ℝ)) -
      (Real.log (M : ℝ) - Real.log (n : ℝ)) =
      Real.log ((M + 1 : ℕ) : ℝ) - Real.log (M : ℝ) by ring,
    hdiff]
  exact hlog.trans hinv

/-- Adding one missing edge preserves the near-maximal count condition at
the cost of increasing its constant by one. -/
lemma kahnCountLower_insert {n M : ℕ} {H : Finset (Edge n)}
    {Z : Edge n} {C₀ : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hHcard : H.card = M)
    (hZ : Z ∉ H) (hPhi : (perfectMatchings n H).card ≠ 0)
    (hcount : KahnCountLower H C₀) :
    KahnCountLower (insert Z H) (C₀ + 1) := by
  have hcard : (insert Z H).card = M + 1 := by
    rw [Finset.card_insert_of_notMem hZ, hHcard]
  have hcountNat := card_perfectMatchings_insert_eq_add_completionWeight H Z hZ
  have hmonoNat : (perfectMatchings n H).card ≤
      (perfectMatchings n (insert Z H)).card := by omega
  have hHpos : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhi
  have hGpos : (0 : ℝ) < (perfectMatchings n (insert Z H)).card := by
    exact_mod_cast (Nat.pos_of_ne_zero hPhi).trans_le hmonoNat
  have hmono : ((perfectMatchings n H).card : ℝ) ≤
      ((perfectMatchings n (insert Z H)).card : ℝ) := by
    exact_mod_cast hmonoNat
  have hlogMono :
      Real.log ((perfectMatchings n H).card : ℝ) ≤
        Real.log ((perfectMatchings n (insert Z H)).card : ℝ) :=
    Real.strictMonoOn_log.monotoneOn hHpos hGpos hmono
  have hlogDiff := log_succ_div_sub_log_div_le_one n M hn hM
  unfold KahnCountLower at hcount ⊢
  rw [hHcard] at hcount
  rw [hcard]
  have hnR : (0 : ℝ) ≤ n := by positivity
  have hscaled :
      (n : ℝ) * Real.log (((M + 1 : ℕ) : ℝ) / n) ≤
        (n : ℝ) * Real.log ((M : ℝ) / n) + (n : ℝ) := by
    nlinarith [mul_le_mul_of_nonneg_left hlogDiff hnR]
  have htarget :
      (n : ℝ) * Real.log (((M + 1 : ℕ) : ℝ) / n) -
          2 * (n : ℝ) - (C₀ + 1) * (n : ℝ) ≤
        Real.log ((perfectMatchings n H).card : ℝ) := by
    nlinarith [hcount, hscaled]
  exact htarget.trans hlogMono

/-! ### Predicate-filtered insertion double count -/

def predicateUpperBadCount {n : ℕ} (M : ℕ)
    (Good : Finset (Edge n) → Prop) (delta : ℝ)
    (H : Finset (Edge n)) : ℝ :=
  (((coarseUpperBadNonedges n H (2 * (1 + delta))).filter
    fun _ ↦ Good H).card : ℕ)

def predicateUpperBadExtensionPairs {n : ℕ} (M : ℕ)
    (Good : Finset (Edge n) → Prop) (delta : ℝ) :
    Finset ((_H : Finset (Edge n)) × Edge n) :=
  (sample n M).sigma fun H ↦
    (coarseUpperBadNonedges n H (2 * (1 + delta))).filter
      fun _ ↦ Good H

def predicateCloseBadMarkedPairs {n : ℕ} (M : ℕ)
    (Good : Finset (Edge n) → Prop) (delta : ℝ) :
    Finset ((_G : Finset (Edge n)) × Edge n) :=
  (sample n (M + 1)).sigma fun G ↦
    G.filter fun Z ↦ Good (G.erase Z) ∧ ¬ CompletionWeightClose G delta Z

def predicateExtendPair {n : ℕ} :
    ((_H : Finset (Edge n)) × Edge n) →
      ((_G : Finset (Edge n)) × Edge n)
  | ⟨H, Z⟩ => ⟨insert Z H, Z⟩

lemma predicateExtendPair_mapsTo {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hdelta : 0 ≤ delta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H) :
    Set.MapsTo predicateExtendPair
      (↑(predicateUpperBadExtensionPairs M Good delta) :
        Set ((_H : Finset (Edge n)) × Edge n))
      (↑(predicateCloseBadMarkedPairs M Good delta) :
        Set ((_G : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, Z⟩ hHZ
  change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
    predicateUpperBadExtensionPairs M Good delta at hHZ
  rw [predicateUpperBadExtensionPairs, Finset.mem_sigma] at hHZ
  rcases hHZ with ⟨hHs, hZfiber⟩
  rcases Finset.mem_filter.mp hZfiber with ⟨hZbad, hGood⟩
  rcases Finset.mem_filter.mp hZbad with ⟨hZdiff, hnotUpper⟩
  rcases Finset.mem_sdiff.mp hZdiff with ⟨hZall, hZnot⟩
  rcases mem_sample.mp hHs with ⟨hHall, hHcard⟩
  have hPhi : (perfectMatchings n H).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp (hgoodPM H hGood))
  change (⟨insert Z H, Z⟩ : ((_G : Finset (Edge n)) × Edge n)) ∈
    predicateCloseBadMarkedPairs M Good delta
  rw [predicateCloseBadMarkedPairs, Finset.mem_sigma]
  refine ⟨mem_sample.mpr ⟨Finset.insert_subset hZall hHall, ?_⟩,
    Finset.mem_filter.mpr ⟨Finset.mem_insert_self Z H, ?_, ?_⟩⟩
  · rw [Finset.card_insert_of_notMem hZnot, hHcard]
  · simpa [Finset.erase_insert hZnot] using hGood
  · intro hclose
    apply hnotUpper
    apply completionWeightUpperBound_of_insert_close H Z delta
      hZnot hPhi
    · simpa [hHcard] using hM
    · exact hdelta
    · simpa [hHcard] using hu
    · exact hclose

lemma predicateExtendPair_injectiveOn {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ} :
    Set.InjOn predicateExtendPair
      (↑(predicateUpperBadExtensionPairs M Good delta) :
        Set ((_H : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, Z⟩ hHZ ⟨H', Z'⟩ hH'Z' heq
  have hZnot : Z ∉ H := by
    change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      predicateUpperBadExtensionPairs M Good delta at hHZ
    rw [predicateUpperBadExtensionPairs, Finset.mem_sigma] at hHZ
    exact (Finset.mem_sdiff.mp
      (Finset.mem_filter.mp (Finset.mem_filter.mp hHZ.2).1).1).2
  have hZ'not : Z' ∉ H' := by
    change (⟨H', Z'⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      predicateUpperBadExtensionPairs M Good delta at hH'Z'
    rw [predicateUpperBadExtensionPairs, Finset.mem_sigma] at hH'Z'
    exact (Finset.mem_sdiff.mp
      (Finset.mem_filter.mp (Finset.mem_filter.mp hH'Z'.2).1).1).2
  have hins : insert Z H = insert Z' H' := congrArg Sigma.fst heq
  have hZZ' : Z = Z' := eq_of_heq (Sigma.mk.inj_iff.mp heq).2
  subst Z'
  have hHH' : H = H' := by
    simpa only [Finset.erase_insert hZnot, Finset.erase_insert hZ'not] using
      congrArg (fun S : Finset (Edge n) ↦ S.erase Z) hins
  subst H'
  rfl

lemma card_predicateUpperBadExtensionPairs_le_marked {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hdelta : 0 ≤ delta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H) :
    (predicateUpperBadExtensionPairs M Good delta).card ≤
      (predicateCloseBadMarkedPairs M Good delta).card := by
  exact Finset.card_le_card_of_injOn predicateExtendPair
    (predicateExtendPair_mapsTo hn hM hdelta hu hgoodPM)
    predicateExtendPair_injectiveOn

lemma card_predicateCloseBadMarkedPairs_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta eta : ℝ}
    (heta : 0 ≤ eta)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    ((predicateCloseBadMarkedPairs M Good delta).card : ℝ) ≤
      ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := by
  rw [predicateCloseBadMarkedPairs, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  calc
    ∑ G ∈ sample n (M + 1),
        (((G.filter fun Z ↦ Good (G.erase Z) ∧
          ¬ CompletionWeightClose G delta Z).card : ℕ) : ℝ) ≤
      ∑ _G ∈ sample n (M + 1), eta * ((M + 1 : ℕ) : ℝ) := by
        apply Finset.sum_le_sum
        intro G hGs
        by_cases hex : ∃ Z ∈ G, Good (G.erase Z)
        · rcases hex with ⟨Z, hZG, hGood⟩
          rcases mem_sample.mp hGs with ⟨hGall, hGcard⟩
          have hHs : G.erase Z ∈ sample n M := by
            apply mem_sample.mpr
            refine ⟨(Finset.erase_subset Z G).trans hGall, ?_⟩
            rw [Finset.card_erase_of_mem hZG, hGcard]
            omega
          have hZdiff : Z ∈ allEdges n \ G.erase Z := by
            exact Finset.mem_sdiff.mpr ⟨hGall hZG, Finset.notMem_erase _ _⟩
          have hspr := hspread (G.erase Z) hHs hGood Z hZdiff
          have hsub :
              G.filter (fun U ↦ Good (G.erase U) ∧
                ¬ CompletionWeightClose G delta U) ⊆
              G.filter (fun U ↦ ¬ CompletionWeightClose G delta U) := by
            intro U hU
            exact Finset.mem_filter.mpr
              ⟨(Finset.mem_filter.mp hU).1, (Finset.mem_filter.mp hU).2.2⟩
          have hcard := Finset.card_le_card hsub
          have hcardR :
              ((G.filter (fun U ↦ Good (G.erase U) ∧
                ¬ CompletionWeightClose G delta U)).card : ℝ) ≤
              ((G.filter (fun U ↦
                ¬ CompletionWeightClose G delta U)).card : ℝ) := by
            exact_mod_cast hcard
          unfold PresentWeightSpread at hspr
          rw [Finset.insert_erase hZG] at hspr
          exact hcardR.trans (by simpa only [hGcard] using hspr)
        · have hempty :
              G.filter (fun Z ↦ Good (G.erase Z) ∧
                ¬ CompletionWeightClose G delta Z) = ∅ := by
            apply Finset.eq_empty_iff_forall_notMem.mpr
            intro Z hZ
            exact hex ⟨Z, (Finset.mem_filter.mp hZ).1,
              (Finset.mem_filter.mp hZ).2.1⟩
          rw [hempty]
          simp only [Finset.card_empty, Nat.cast_zero]
          exact mul_nonneg heta (by positivity)
    _ = ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := by simp

lemma sum_predicateUpperBadCount {n M : ℕ}
    (Good : Finset (Edge n) → Prop) (delta : ℝ) :
    ∑ H ∈ sample n M, predicateUpperBadCount M Good delta H =
      ((predicateUpperBadExtensionPairs M Good delta).card : ℝ) := by
  rw [predicateUpperBadExtensionPairs, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  rfl

lemma average_predicateUpperBadCount_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta eta : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hMtop : M < (allEdges n).card)
    (hdelta : 0 ≤ delta) (heta : 0 ≤ eta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    finsetAverage (sample n M) (predicateUpperBadCount M Good delta) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) := by
  have hpairNat := card_predicateUpperBadExtensionPairs_le_marked
    hn hM hdelta hu hgoodPM
  have hpair : ((predicateUpperBadExtensionPairs M Good delta).card : ℝ) ≤
      (predicateCloseBadMarkedPairs M Good delta).card := by
    exact_mod_cast hpairNat
  have hmarked := card_predicateCloseBadMarkedPairs_le heta hspread
  have hchooseNat :
      (sample n (M + 1)).card * (M + 1) =
        (sample n M).card * ((allEdges n).card - M) := by
    rw [card_sample, card_sample]
    exact Nat.choose_succ_right_eq (allEdges n).card M
  have hchoose :
      ((sample n (M + 1)).card : ℝ) * ((M + 1 : ℕ) : ℝ) =
        ((sample n M).card : ℝ) *
          (((allEdges n).card - M : ℕ) : ℝ) := by
    exact_mod_cast hchooseNat
  have hsampleNat : 0 < (sample n M).card := by
    rw [card_sample]
    exact Nat.choose_pos hMtop.le
  have hsample : (0 : ℝ) < (sample n M).card := by
    exact_mod_cast hsampleNat
  unfold finsetAverage
  rw [sum_predicateUpperBadCount]
  apply (div_le_iff₀ hsample).2
  calc
    ((predicateUpperBadExtensionPairs M Good delta).card : ℝ) ≤
        (predicateCloseBadMarkedPairs M Good delta).card := hpair
    _ ≤ ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := hmarked
    _ = eta * (((sample n (M + 1)).card : ℝ) *
        ((M + 1 : ℕ) : ℝ)) := by ring
    _ = eta * (((sample n M).card : ℝ) *
        (((allEdges n).card - M : ℕ) : ℝ)) := by rw [hchoose]
    _ = eta * (((allEdges n).card - M : ℕ) : ℝ) *
        ((sample n M).card : ℝ) := by ring

lemma predicateUpperBadCount_probability_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta eta r : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hMtop : M < (allEdges n).card)
    (hdelta : 0 ≤ delta) (heta : 0 ≤ eta) (hr : 0 < r)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    finsetProbability (sample n M)
        (fun H ↦ r ≤ predicateUpperBadCount M Good delta H) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  have hmarkov := finsetProbability_mul_le_average_of_nonneg
    (sample n M) (predicateUpperBadCount M Good delta) r
    (fun H _ ↦ by unfold predicateUpperBadCount; positivity)
  have havg := average_predicateUpperBadCount_le
    hn hM hMtop hdelta heta hu hgoodPM hspread
  apply le_of_mul_le_mul_right _ hr
  calc
    finsetProbability (sample n M)
          (fun H ↦ r ≤ predicateUpperBadCount M Good delta H) * r ≤
        finsetAverage (sample n M)
          (predicateUpperBadCount M Good delta) := hmarkov
    _ ≤ eta * (((allEdges n).card - M : ℕ) : ℝ) := havg
    _ = (eta * (((allEdges n).card - M : ℕ) : ℝ) / r) * r := by
      field_simp [hr.ne']

lemma predicateUpperBadCount_eq_of_good {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ}
    {H : Finset (Edge n)} (hGood : Good H) :
    predicateUpperBadCount M Good delta H =
      ((coarseUpperBadNonedges n H (2 * (1 + delta))).card : ℝ) := by
  unfold predicateUpperBadCount
  simp [hGood]

lemma good_not_globalUpper_implies_predicateBadCount_large {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta etaGlobal r : ℝ}
    {H : Finset (Edge n)} (hHs : H ∈ sample n M) (hGood : Good H)
    (hbudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card)
    (hfail : ¬ GlobalUpperWeightSpread n H (2 * (1 + delta)) etaGlobal) :
    r ≤ predicateUpperBadCount M Good delta H := by
  by_contra hnot
  apply hfail
  unfold GlobalUpperWeightSpread
  have hcard := globalUpperBad_card_le_nonedge_add_card
    H (2 * (1 + delta))
  have hcardR :
      ((((allEdges n).filter fun Z ↦
        ¬ CompletionWeightUpperBound H (2 * (1 + delta)) Z).card : ℕ) : ℝ) ≤
        ((coarseUpperBadNonedges n H
          (2 * (1 + delta))).card : ℝ) + H.card := by
    exact_mod_cast hcard
  have heq := predicateUpperBadCount_eq_of_good
    (M := M) (delta := delta) hGood
  have hHcard := (mem_sample.mp hHs).2
  calc
    ((((allEdges n).filter fun Z ↦
        ¬ CompletionWeightUpperBound H (2 * (1 + delta)) Z).card : ℕ) : ℝ) ≤
        ((coarseUpperBadNonedges n H
          (2 * (1 + delta))).card : ℝ) + H.card := hcardR
    _ = predicateUpperBadCount M Good delta H + (M : ℝ) := by
      rw [heq, hHcard]
    _ ≤ r + (M : ℝ) := add_le_add (le_of_not_ge hnot) le_rfl
    _ ≤ etaGlobal * (allEdges n).card := hbudget

lemma good_globalUpper_failure_probability_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop}
    {delta eta etaGlobal r : ℝ}
    (hn : 0 < n) (hM : 0 < M) (hMtop : M < (allEdges n).card)
    (hdelta : 0 ≤ delta) (heta : 0 ≤ eta) (hr : 0 < r)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hbudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    finsetProbability (sample n M)
        (fun H ↦ Good H ∧
          ¬ GlobalUpperWeightSpread n H (2 * (1 + delta)) etaGlobal) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  have hmono : finsetProbability (sample n M)
      (fun H ↦ Good H ∧
        ¬ GlobalUpperWeightSpread n H (2 * (1 + delta)) etaGlobal) ≤
      finsetProbability (sample n M)
        (fun H ↦ r ≤ predicateUpperBadCount M Good delta H) := by
    apply finsetProbability_mono_event
    intro H hHs h
    exact good_not_globalUpper_implies_predicateBadCount_large
      hHs h.1 hbudget h.2
  exact hmono.trans (predicateUpperBadCount_probability_le
    hn hM hMtop hdelta heta hr hu hgoodPM hspread)

lemma vertexCodegree_insert_le_add_one {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (u v : Vertex n) :
    vertexCodegree (insert Z H) u v ≤ vertexCodegree H u v + 1 := by
  unfold vertexCodegree
  rw [Finset.filter_insert]
  split_ifs
  · exact Finset.card_insert_le _ _
  · omega

/-- The exact predecessor property used by the refined insertion argument. -/
def RefinedInsertionGood (n M : ℕ) (a B : ℝ) (codegCap : ℕ)
    (C₀ : ℝ) (H : Finset (Edge n)) : Prop :=
  CoarseRegularPerfect n M a B H ∧
    KahnCountLower H C₀ ∧
    ∀ u v : Vertex n, u ≠ v → vertexCodegree H u v ≤ codegCap

lemma refinedInsertionGood_hasPerfectMatching {n M : ℕ}
    {a B C₀ : ℝ} {codegCap : ℕ} {H : Finset (Edge n)}
    (h : RefinedInsertionGood n M a B codegCap C₀ H) :
    HasPerfectMatching n H := h.1.2.1

/-- A refined-good predecessor forces the inserted graph to satisfy the
sharp present-edge spreading estimate. -/
lemma refinedInsertionGood_presentWeightSpread {n M codegCap : ℕ}
    {a B C₀ sigma E delta eta : ℝ}
    (hn : 3 ≤ n) (hM : 0 < M) (hnM : n ≤ M)
    (ha0 : 0 < a) (ha2 : a ≤ 2) (hB0 : 0 ≤ B)
    (hC0 : 0 ≤ C₀ + 1) (hsigma : 0 < sigma)
    (hratio :
      1 < ((3 * (M + 1) : ℕ) : ℝ) * sigma /
        ((18 * n * (codegCap + 1) : ℕ) : ℝ))
    (hE :
      (3 * n : ℝ) * Real.sqrt sigma +
          (3 * n : ℝ) * (C₀ + 1 + 14 + Real.log 2) /
            Real.log (((3 * (M + 1) : ℕ) : ℝ) * sigma /
              ((18 * n * (codegCap + 1) : ℕ) : ℝ)) ≤ E)
    (heta : 0 ≤ eta) (hgap : 2 / a < delta)
    (hbudget :
      (3 * n : ℝ) *
          (4 * (3 * (C₀ + 1) * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤
        (eta * (delta - 2 / a) * (n : ℝ))^2)
    {H : Finset (Edge n)}
    (hGood : RefinedInsertionGood n M a B codegCap C₀ H)
    {Z : Edge n} (hZ : Z ∈ allEdges n \ H) :
    PresentWeightSpread (insert Z H) delta eta := by
  rcases hGood with ⟨hcoarse, hcount, hcodeg⟩
  rcases Finset.mem_sdiff.mp hZ with ⟨hZall, hZnot⟩
  have hcoarseInsert := coarseRegularPerfect_insert
    (show 0 < n by omega) hM hnM ha0 hB0 hcoarse hZ
  have hGsample := hcoarseInsert.1
  rcases mem_sample.mp hGsample with ⟨hGall, hGcard⟩
  have hPhi : (perfectMatchings n (insert Z H)).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp
        hcoarseInsert.2.1)
  have hcountInsert : KahnCountLower (insert Z H) (C₀ + 1) := by
    apply kahnCountLower_insert (show 0 < n by omega) hM
      (mem_sample.mp hcoarse.1).2 hZnot
    · exact Finset.card_ne_zero.mpr
        (hasPerfectMatching_iff_perfectMatchings_nonempty.mp hcoarse.2.1)
    · exact hcount
  have hcodegInsert : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree (insert Z H) u v ≤ codegCap + 1 := by
    intro u v huv
    exact (vertexCodegree_insert_le_add_one H Z u v).trans
      (Nat.add_le_add_right (hcodeg u v huv) 1)
  have hincident : (matchingIncidentPairs (insert Z H)).card =
      3 * (M + 1) := by
    rw [card_matchingIncidentPairs (insert Z H) hGall, hGcard]
  have herrorRaw := matchingEntropyGenericityError_le_of_countLower
    hn (show 0 < codegCap + 1 by omega) hGall hPhi hcodegInsert
    (C₀ + 1) sigma hC0 hsigma hcountInsert
    (by simpa only [hincident] using hratio)
  have herror : matchingEntropyGenericityError (insert Z H) ≤ E := by
    exact herrorRaw.trans (by simpa only [hincident] using hE)
  have hHcardPos : 0 < (insert Z H).card := by omega
  have hreg : InverseDegreeRegular (insert Z H) (2 / a) := by
    have haHalf0 : 0 < a / 2 := by positivity
    have haHalf1 : a / 2 ≤ 1 := by linarith
    have hbase := inverseDegreeRegular_of_lower_bound
      (insert Z H) (a / 2) (show 0 < n by omega) hHcardPos
      haHalf0 haHalf1 (fun v ↦ by
        rw [hGcard]
        exact (hcoarseInsert.2.2 v).1)
    convert hbase using 1 <;> field_simp
  exact presentWeightSpread_of_countLower_and_errorBound
    hn hGall hPhi (C₀ + 1) E (2 / a) delta eta hcountInsert herror
    heta hgap hreg hbudget

/-- Finite probability bound for failure of global upper spreading inside
the refined count-and-regularity regime. -/
lemma refinedInsertion_globalUpper_failure_probability_le
    {n M codegCap : ℕ} {a B C₀ sigma E delta eta etaGlobal r : ℝ}
    (hn : 3 ≤ n) (hM : 0 < M) (hnM : n ≤ M)
    (hMtop : M < (allEdges n).card)
    (ha0 : 0 < a) (ha2 : a ≤ 2) (hB0 : 0 ≤ B)
    (hC0 : 0 ≤ C₀ + 1) (hsigma : 0 < sigma)
    (hratio :
      1 < ((3 * (M + 1) : ℕ) : ℝ) * sigma /
        ((18 * n * (codegCap + 1) : ℕ) : ℝ))
    (hE :
      (3 * n : ℝ) * Real.sqrt sigma +
          (3 * n : ℝ) * (C₀ + 1 + 14 + Real.log 2) /
            Real.log (((3 * (M + 1) : ℕ) : ℝ) * sigma /
              ((18 * n * (codegCap + 1) : ℕ) : ℝ)) ≤ E)
    (heta : 0 ≤ eta) (hgap : 2 / a < delta)
    (hentropyBudget :
      (3 * n : ℝ) *
          (4 * (3 * (C₀ + 1) * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤
        (eta * (delta - 2 / a) * (n : ℝ))^2)
    (hdelta0 : 0 ≤ delta)
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hr : 0 < r)
    (hglobalBudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card) :
    finsetProbability (sample n M)
        (fun H ↦ RefinedInsertionGood n M a B codegCap C₀ H ∧
          ¬ GlobalUpperWeightSpread n H (2 * (1 + delta)) etaGlobal) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  apply good_globalUpper_failure_probability_le
    (show 0 < n by omega) hM hMtop hdelta0 heta hr hu hglobalBudget
  · intro H hGood
    exact refinedInsertionGood_hasPerfectMatching hGood
  · intro H hHs hGood Z hZ
    exact refinedInsertionGood_presentWeightSpread hn hM hnM ha0 ha2 hB0
      hC0 hsigma hratio hE heta hgap hentropyBudget hGood hZ


/-- A conditional coordinate-link tail whose residual-weight cutoff may
depend on the already exposed outside layer. -/
def AdaptiveCoordinateFiberLinkTail {n : ℕ} (Z : Edge n)
    (y : Vertex n) (cutoff : Finset (Edge n) → ℝ)
    (d D Q b : ℕ)
    (p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)) : Prop :=
  d ≤ p.2.card ∧ p.2.card ≤ D ∧
    (coordinateResidualBadPairs n (inducedAway p.1 Z) Z y
      (cutoff (inducedAway p.1 Z))).card ≤ Q ∧
    b ≤ (p.2 ∩ coordinateResidualBadPairs n (inducedAway p.1 Z) Z y
      (cutoff (inducedAway p.1 Z))).card

/-- The intrinsic sample event corresponding to
`AdaptiveCoordinateFiberLinkTail`. -/
def AdaptiveCoordinateSampleLinkTail {n : ℕ} (Z : Edge n)
    (x y : Vertex n) (cutoff : Finset (Edge n) → ℝ)
    (d D Q b : ℕ) (H : Finset (Edge n)) : Prop :=
  d ≤ (coordinateLinkPairs H Z x y).card ∧
    (coordinateLinkPairs H Z x y).card ≤ D ∧
    (coordinateResidualBadPairs n (inducedAway H Z) Z y
      (cutoff (inducedAway H Z))).card ≤ Q ∧
    b ≤ (coordinateBadLinkPairs n H Z x y
      (cutoff (inducedAway H Z))).card

lemma adaptiveCoordinateSampleLinkTail_assemble_iff {n M : ℕ}
    {Z : Edge n} {x y : Vertex n}
    {cutoff : Finset (Edge n) → ℝ} {d D Q b : ℕ}
    (hx : x ∈ Z)
    {p : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n)}
    (hp : p ∈ coordinateLayerDecompositions n M Z x y) :
    AdaptiveCoordinateSampleLinkTail Z x y cutoff d D Q b
        (assembleCoordinateLayer x p) ↔
    AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b p := by
  rcases p with ⟨R, L⟩
  rcases mem_coordinateLayerDecompositions.mp hp with
    ⟨hR, hRM, hL, hLcard⟩
  have hlink := coordinateLinkPairs_assembleCoordinateLayer hx hR hL
  have hinduced :
      inducedAway
          (assembleCoordinateLayer x
            (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦ Finset (Edge n))) Z =
        inducedAway R Z := by
    exact inducedAway_union_linkImage (R := R) hx hL
  have hbad := coordinateBadLinkPairs_assembleCoordinateLayer
    (a := cutoff (inducedAway R Z)) hx hR hL
  simp only [AdaptiveCoordinateSampleLinkTail,
    AdaptiveCoordinateFiberLinkTail, hlink, hinduced, hbad]

/-- Fiberwise hypergeometric counting remains valid for a cutoff chosen
from the exposed outside layer, because that cutoff is fixed throughout
each conditional link fiber. -/
lemma adaptiveCoordinateFiberLinkTail_card_le {n M d D Q b : ℕ}
    {Z : Edge n} {x y : Vertex n}
    {cutoff : Finset (Edge n) → ℝ} {p : ℝ} (hp : 0 ≤ p)
    (hratio : ∀ t : ℕ, d ≤ t → t ≤ D →
      ((((Q.choose b) *
          ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
        p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    (((coordinateLayerDecompositions n M Z x y).filter fun q ↦
        AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b q).card : ℕ) ≤
      p * ((coordinateLayerDecompositions n M Z x y).card : ℝ) := by
  let P := coordinateAmbientPairs n Z y
  let O := (coordinateOutsideLayer n Z x y).powerset.filter fun R ↦
    R.card ≤ M
  rw [coordinateLayerDecompositions, Finset.filter_sigma,
    Finset.card_sigma, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro R hRO
  let t := M - R.card
  let Y := coordinateResidualBadPairs n (inducedAway R Z) Z y
    (cutoff (inducedAway R Z))
  let F := P.powersetCard t
  by_cases hpre : d ≤ t ∧ t ≤ D ∧ Y.card ≤ Q
  · by_cases hbt : b ≤ t
    · let hit : Finset (Edge n) → ℕ := fun L ↦
        (@Inter.inter (Finset (Edge n))
          (@Finset.instInter (Edge n)
            (fun u v ↦ Classical.propDecidable (u = v))) L Y).card
      have htailSub :
          F.filter (fun L ↦
              AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n))) ⊆
            F.filter (fun L ↦ b ≤ hit L) := by
        intro L hL
        rcases Finset.mem_filter.mp hL with ⟨hLF, htail⟩
        apply Finset.mem_filter.mpr
        refine ⟨hLF, ?_⟩
        have heq :
            @Inter.inter (Finset (Edge n))
                (@Finset.instInter (Edge n)
                  (fun u v ↦ Classical.propDecidable (u = v))) L Y =
              L ∩ Y := by
          ext U
          simp
        simpa only [hit, heq, Y] using htail.2.2.2
      have htail := card_powersetCard_many_hits_le P Y
        (Finset.filter_subset _ _) t b hbt
      have hchoose : Y.card.choose b ≤ Q.choose b :=
        Nat.choose_le_choose b hpre.2.2
      have hnat :
          (F.filter (fun L ↦
              AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n)))).card ≤
            Q.choose b * (P.card - b).choose (t - b) := by
        calc
          (F.filter (fun L ↦
              AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n)))).card ≤
              (F.filter fun L ↦ b ≤ hit L).card :=
            Finset.card_le_card htailSub
          _ ≤ Y.card.choose b * (P.card - b).choose (t - b) := by
            simpa only [F, hit] using htail
          _ ≤ Q.choose b * (P.card - b).choose (t - b) := by
            exact Nat.mul_le_mul_right _ hchoose
      have hnatR :
          (((F.filter (fun L ↦
              AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
                (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                  Finset (Edge n)))).card : ℕ) : ℝ) ≤
            (((Q.choose b) * (P.card - b).choose (t - b) : ℕ) : ℝ) := by
        exact_mod_cast hnat
      calc
        (((F.filter (fun L ↦
            AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
              (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                Finset (Edge n)))).card : ℕ) : ℝ) ≤
            (((Q.choose b) * (P.card - b).choose (t - b) : ℕ) : ℝ) := hnatR
        _ ≤ p * ((P.card.choose t : ℕ) : ℝ) :=
          hratio t hpre.1 hpre.2.1
        _ = p * ((F.card : ℕ) : ℝ) := by
          rw [Finset.card_powersetCard]
    · have hempty :
          F.filter (fun L ↦
            AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
              (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
                Finset (Edge n))) = ∅ := by
        apply Finset.eq_empty_iff_forall_notMem.mpr
        intro L hL
        rcases Finset.mem_filter.mp hL with ⟨hLF, htail⟩
        have hLcard := (Finset.mem_powersetCard.mp hLF).2
        have hinter : (L ∩ Y).card ≤ L.card :=
          Finset.card_le_card Finset.inter_subset_left
        have hbinter : b ≤ (L ∩ Y).card := by
          simpa only [Y] using htail.2.2.2
        have hbL : b ≤ L.card := by
          exact hbinter.trans hinter
        exact hbt (by simpa only [hLcard] using hbL)
      rw [hempty]
      norm_num only [Finset.card_empty, Nat.cast_zero]
      exact mul_nonneg hp (Nat.cast_nonneg _)
  · have hempty :
        F.filter (fun L ↦
          AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
            (⟨R, L⟩ : Sigma fun _R : Finset (Edge n) ↦
              Finset (Edge n))) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro L hL
      rcases Finset.mem_filter.mp hL with ⟨hLF, htail⟩
      have hLcard := (Finset.mem_powersetCard.mp hLF).2
      apply hpre
      simpa only [hLcard, Y] using
        (show d ≤ L.card ∧ L.card ≤ D ∧ Y.card ≤ Q from
          ⟨htail.1, htail.2.1, by simpa only [Y] using htail.2.2.1⟩)
    rw [hempty]
    norm_num only [Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg hp (Nat.cast_nonneg _)

/-- Exact fixed-edge probability bound for an outside-layer-dependent
residual cutoff. -/
lemma adaptiveCoordinateSampleLinkTail_probability_le
    {n M d D Q b : ℕ} {Z : Edge n} {x y : Vertex n}
    {cutoff : Finset (Edge n) → ℝ} {p : ℝ}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p)
    (hratio : ∀ t : ℕ, d ≤ t → t ≤ D →
      ((((Q.choose b) *
          ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
        p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (AdaptiveCoordinateSampleLinkTail Z x y cutoff d D Q b) ≤ p := by
  let Dcmp := coordinateLayerDecompositions n M Z x y
  let E := AdaptiveCoordinateSampleLinkTail Z x y cutoff d D Q b
  let EF := AdaptiveCoordinateFiberLinkTail Z y cutoff d D Q b
  have hgoodCard :
      (Dcmp.filter EF).card = ((sample n M).filter E).card := by
    apply Finset.card_bij (fun q _ ↦ assembleCoordinateLayer x q)
    · intro q hq
      rcases Finset.mem_filter.mp hq with ⟨hqD, hqE⟩
      exact Finset.mem_filter.mpr
        ⟨assembleCoordinateLayer_mapsTo_sample hZ hx hqD,
          (adaptiveCoordinateSampleLinkTail_assemble_iff hx hqD).2 hqE⟩
    · intro q hq r hr heq
      exact assembleCoordinateLayer_injectiveOn hx
        (Finset.mem_filter.mp hq).1 (Finset.mem_filter.mp hr).1 heq
    · intro H hH
      rcases Finset.mem_filter.mp hH with ⟨hHs, hHE⟩
      rcases assembleCoordinateLayer_surjective_sample hx H hHs with
        ⟨q, hqD, hqH⟩
      refine ⟨q, Finset.mem_filter.mpr ⟨hqD, ?_⟩, hqH⟩
      exact (adaptiveCoordinateSampleLinkTail_assemble_iff hx hqD).1
        (hqH ▸ hHE)
  have hcount := adaptiveCoordinateFiberLinkTail_card_le
    (n := n) (M := M) (d := d) (D := D) (Q := Q) (b := b)
    (Z := Z) (x := x) (y := y) (cutoff := cutoff) hp hratio
  have hdecompCard := card_coordinateLayerDecompositions_eq_sample
    (M := M) (y := y) hZ hx
  have hsampleNat : 0 < (sample n M).card := by
    rw [card_sample]
    exact Nat.choose_pos hM
  have hsample : (0 : ℝ) < (sample n M).card := by
    exact_mod_cast hsampleNat
  unfold finsetProbability
  apply (div_le_iff₀ hsample).2
  rw [← hgoodCard, ← hdecompCard]
  exact hcount

/-- Vertices witnessing the adaptive conditional link-tail event. -/
def adaptiveCoordinateLinkTailVertices {n : ℕ} (Z : Edge n)
    (x : Vertex n) (cutoff : Finset (Edge n) → ℝ)
    (d D Q b : ℕ) (H : Finset (Edge n)) : Finset (Vertex n) :=
  Finset.univ.filter fun y ↦ y ∉ Z ∧
    AdaptiveCoordinateSampleLinkTail Z x y cutoff d D Q b H

/-- First-moment lift of the adaptive fixed-vertex tail. -/
lemma adaptiveCoordinateLinkTailVertices_probability_le
    {n M d D Q b k : ℕ} {Z : Edge n} {x : Vertex n}
    {cutoff : Finset (Edge n) → ℝ} {p : ℝ}
    (hZ : Z ∈ allEdges n) (hx : x ∈ Z)
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p) (hk : 0 < k)
    (hratio : ∀ y : Vertex n, y ∉ Z → ∀ t : ℕ,
      d ≤ t → t ≤ D →
        ((((Q.choose b) *
            ((coordinateAmbientPairs n Z y).card - b).choose (t - b) : ℕ) : ℝ) ≤
          p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (fun H ↦ (k : ℝ) ≤
          (adaptiveCoordinateLinkTailVertices Z x cutoff d D Q b H).card) ≤
      (((3 * n : ℕ) : ℝ) * p) / k := by
  let I := (Finset.univ : Finset (Vertex n))
  let P : Vertex n → Finset (Edge n) → Prop := fun y H ↦
    y ∉ Z ∧ AdaptiveCoordinateSampleLinkTail Z x y cutoff d D Q b H
  letI : ∀ y, DecidablePred (P y) := fun _ ↦ Classical.decPred _
  have hpoint : ∀ y ∈ I,
      finsetProbability (sample n M) (P y) ≤ p := by
    intro y hyI
    by_cases hyZ : y ∈ Z
    · have hzero : finsetProbability (sample n M) (P y) = 0 := by
        unfold finsetProbability
        have hempty : (sample n M).filter (P y) = ∅ := by
          apply Finset.eq_empty_iff_forall_notMem.mpr
          intro H hH
          exact (Finset.mem_filter.mp hH).2.1 hyZ
        rw [hempty]
        simp
      rw [hzero]
      exact hp
    · have htail := adaptiveCoordinateSampleLinkTail_probability_le
        (M := M) (d := d) (D := D) (Q := Q) (b := b)
        (Z := Z) (x := x) (y := y) (cutoff := cutoff) hZ hx hM hp
        (hratio y hyZ)
      have hmono : finsetProbability (sample n M) (P y) ≤
          finsetProbability (sample n M)
            (AdaptiveCoordinateSampleLinkTail Z x y cutoff d D Q b) := by
        apply finsetProbability_mono_event
        intro H hHs hPy
        exact hPy.2
      exact hmono.trans htail
  have hmany := finsetProbability_many_finite_events_le
    (sample n M) I P k p hk hpoint
  have hmany' :
      finsetProbability (sample n M)
          (fun H ↦ (k : ℝ) ≤ (I.filter fun y ↦ P y H).card) ≤
        ((I.card : ℝ) * p) / k := by
    refine (finsetProbability_congr_event (sample n M) _ _ ?_).le.trans hmany
    intro H hHs
    exact Iff.rfl
  calc
    finsetProbability (sample n M)
          (fun H ↦ (k : ℝ) ≤
            (adaptiveCoordinateLinkTailVertices Z x cutoff d D Q b H).card) =
        finsetProbability (sample n M)
          (fun H ↦ (k : ℝ) ≤ (I.filter fun y ↦ P y H).card) := by
      apply finsetProbability_congr_event
      intro H hHs
      have hcard :
          (adaptiveCoordinateLinkTailVertices Z x cutoff d D Q b H).card =
            (I.filter fun y ↦ P y H).card := by
        apply congrArg Finset.card
        unfold adaptiveCoordinateLinkTailVertices
        dsimp only [I, P]
        exact Finset.filter_congr_decidable _ _ _
      rw [hcard]
    _ ≤ (((3 * n : ℕ) : ℝ) * p) / k := by
      simpa only [I, Finset.card_univ, Fintype.card_fin, Nat.cast_mul,
        Nat.cast_ofNat] using hmany'

/-- Restricting the ambient graph away from `Z` does not change its
near-perfect matching family avoiding `Z`. -/
lemma completionMatchings_inducedAway (n : ℕ) (H : Finset (Edge n))
    (Z : Edge n) :
    completionMatchings n (inducedAway H Z) Z =
      completionMatchings n H Z := by
  ext F
  simp only [mem_completionMatchings]
  constructor
  · rintro ⟨hF, hcard, hmatch, hdisj⟩
    refine ⟨?_, hcard, hmatch, hdisj⟩
    intro A hAF
    exact (mem_inducedAway.mp (hF hAF)).1
  · rintro ⟨hF, hcard, hmatch, hdisj⟩
    refine ⟨?_, hcard, hmatch, hdisj⟩
    intro A hAF
    exact mem_inducedAway.mpr ⟨hF hAF, hdisj A hAF⟩

lemma completionWeight_inducedAway {n : ℕ}
    (H : Finset (Edge n)) {Z : Edge n} (hn : 0 < n)
    (hZ : Z ∈ allEdges n) :
    completionWeight (inducedAway H Z) Z = completionWeight H Z := by
  rw [completionWeight_eq_card_completionMatchings _ Z hn hZ,
    completionWeight_eq_card_completionMatchings _ Z hn hZ,
    completionMatchings_inducedAway]

/-- The residual cutoff used in the coordinate-transfer proof.  It is a
fixed function of the outside graph in every conditional link fiber. -/
def residualTransferCutoff {n : ℕ} (Z : Edge n) (c : ℝ)
    (d b : ℕ) (G : Finset (Edge n)) : ℝ :=
  c * (completionWeight G Z : ℝ) / ((d - b : ℕ) : ℝ)

lemma residualTransferCutoff_inducedAway {n d b : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {c : ℝ}
    (hn : 0 < n) (hZ : Z ∈ allEdges n) :
    residualTransferCutoff Z c d b (inducedAway H Z) =
      c * (completionWeight H Z : ℝ) / ((d - b : ℕ) : ℝ) := by
  unfold residualTransferCutoff
  rw [completionWeight_inducedAway H hn hZ]

/-- Coordinate transfer with a residual cutoff chosen separately for each
current triple. -/
lemma coordinateTransferAbove_of_variable_linkFailures {n d b e : ℕ}
    {H : Finset (Edge n)} {s c : ℝ} (a : Edge n → ℝ)
    (hn : 2 ≤ n) (ha : ∀ Z ∈ allEdges n, 0 ≤ a Z)
    (hfailure : ∀ Z ∈ allEdges n,
      s ≤ (completionWeight H Z : ℝ) →
        ∀ x ∈ Z,
          (coordinateLinkFailureVertices n H Z x d b (a Z)).card ≤ e)
    (hbudget : ∀ Z ∈ allEdges n,
      s ≤ (completionWeight H Z : ℝ) →
        c * (completionWeight H Z : ℝ) ≤
          (((d - b : ℕ) : ℝ) * a Z)) :
    CoordinateTransferAbove n H s c e := by
  intro Z hZ hs x hx
  exact coordinateBadVertices_card_le_linkFailure hn hZ hx (ha Z hZ)
    (hbudget Z hZ hs) (hfailure Z hZ hs x hx)

/-- Simultaneous deterministic inputs for Kahn's coordinate-transfer
argument at one fixed-edge level. -/
def CoordinateTransferRegular (n : ℕ) (H : Finset (Edge n))
    (c : ℝ) (d D codegCap Q b B e₁ : ℕ) : Prop :=
  H ⊆ allEdges n ∧
  (∀ v : Vertex n, d ≤ vertexDegree H v - 3 * codegCap) ∧
  (∀ v : Vertex n, vertexDegree H v ≤ D) ∧
  (∀ u v : Vertex n, u ≠ v → vertexCodegree H u v ≤ codegCap) ∧
  (∀ Z ∈ allEdges n,
    (residualBadTriples n (inducedAway H Z)
      (residualTransferCutoff Z c d b (inducedAway H Z))).card ≤ B) ∧
  (∀ Z ∈ allEdges n, ∀ x ∈ Z,
    (coordinateLinkTailVertices Z x
      (residualTransferCutoff Z c d b (inducedAway H Z))
      d D Q (b + 1) H).card ≤ e₁)

/-- The simultaneous regularity, residual-spreading, and adaptive tail
inputs imply maximum-weight domination. -/
lemma maximumWeightDominated_of_coordinateTransferRegular
    {n d D codegCap Q b B e₀ e₁ : ℕ}
    {H : Finset (Edge n)} {c : ℝ}
    (hn : 2 ≤ n) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hdb : b < d) (hB : 3 * B ≤ e₀ * (Q + 1))
    (he : 2 * (e₀ + e₁) + 12 ≤ n)
    (hreg : CoordinateTransferRegular n H c d D codegCap Q b B e₁) :
    MaximumWeightDominated n H
      (((n / 2 : ℕ) : ℝ)^3 / (allEdges n).card) (c^3) := by
  rcases hreg with ⟨hHall, hdegLower, hdegUpper, hcodeg,
    hresidual, htail⟩
  have hn0 : 0 < n := by omega
  obtain ⟨Z₀, hZ₀, hmax⟩ := exists_max_completionWeight H hn0
  let a : Edge n → ℝ := fun Z ↦
    residualTransferCutoff Z c d b (inducedAway H Z)
  have ha : ∀ Z ∈ allEdges n, 0 ≤ a Z := by
    intro Z hZ
    dsimp only [a, residualTransferCutoff]
    positivity
  have hfailure : ∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤
          (completionWeight H Z : ℝ) →
        ∀ x ∈ Z,
          (coordinateLinkFailureVertices n H Z x d b (a Z)).card ≤
            e₀ + e₁ := by
    intro Z hZ hs x hx
    have hrange : CoordinateLinksInRange H Z x d D :=
      coordinateLinksInRange_of_degree_codegree hHall hZ hx
        (hdegLower x) (hdegUpper x) hcodeg
    have htail' :
        (coordinateLinkTailVertices Z x (a Z) d D Q (b + 1) H).card ≤ e₁ := by
      exact htail Z hZ x hx
    exact coordinateLinkFailureVertices_card_le_of_global hrange
      (hresidual Z hZ) hB htail'
  have hbudget : ∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤
          (completionWeight H Z : ℝ) →
        c * (completionWeight H Z : ℝ) ≤
          (((d - b : ℕ) : ℝ) * a Z) := by
    intro Z hZ hs
    dsimp only [a]
    rw [residualTransferCutoff_inducedAway (H := H) (Z := Z) hn0 hZ]
    have hdb0 : (0 : ℝ) < (d - b : ℕ) := by exact_mod_cast Nat.sub_pos_of_lt hdb
    field_simp [hdb0.ne']
    exact le_rfl
  have htransfer : CoordinateTransferAbove n H
      (c^2 * (completionWeight H Z₀ : ℝ)) c (e₀ + e₁) :=
    coordinateTransferAbove_of_variable_linkFailures a hn ha hfailure hbudget
  exact maximumWeightDominated_of_max_transfer hn0 hZ₀ hmax hc0 hc1
    htransfer he

lemma adaptiveCoordinateLinkTailVertices_eq {n d D Q b : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (x : Vertex n)
    (cutoff : Finset (Edge n) → ℝ) :
    adaptiveCoordinateLinkTailVertices Z x cutoff d D Q b H =
      coordinateLinkTailVertices Z x (cutoff (inducedAway H Z))
        d D Q b H := by
  ext y
  simp only [adaptiveCoordinateLinkTailVertices,
    coordinateLinkTailVertices, Finset.mem_filter, Finset.mem_univ,
    true_and]
  unfold AdaptiveCoordinateSampleLinkTail CoordinateSampleLinkTail
  rfl

/-- Failure of the adaptive conditional-tail input at some marked
triple-coordinate pair. -/
def SomeAdaptiveCoordinateTailFailure (n : ℕ) (c : ℝ)
    (d D Q b e₁ : ℕ) (H : Finset (Edge n)) : Prop :=
  ∃ p ∈ matchingIncidentPairs (allEdges n),
    ((e₁ + 1 : ℕ) : ℝ) ≤
      (adaptiveCoordinateLinkTailVertices p.2 p.1
        (residualTransferCutoff p.2 c d b) d D Q (b + 1) H).card

/-- Union bound over all `3 * |allEdges n|` marked coordinates. -/
lemma someAdaptiveCoordinateTailFailure_probability_le
    {n M d D Q b e₁ : ℕ} {c p : ℝ}
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p)
    (hratio : ∀ Z ∈ allEdges n, ∀ x ∈ Z,
      ∀ y : Vertex n, y ∉ Z → ∀ t : ℕ,
        d ≤ t → t ≤ D →
          ((((Q.choose (b + 1)) *
              ((coordinateAmbientPairs n Z y).card - (b + 1)).choose
                (t - (b + 1)) : ℕ) : ℝ) ≤
            p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (SomeAdaptiveCoordinateTailFailure n c d D Q b e₁) ≤
      ((3 * (allEdges n).card : ℕ) : ℝ) *
        ((((3 * n : ℕ) : ℝ) * p) / (e₁ + 1)) := by
  let I := matchingIncidentPairs (allEdges n)
  let P : (Sigma fun _x : Vertex n ↦ Edge n) →
      Finset (Edge n) → Prop := fun q H ↦
    ((e₁ + 1 : ℕ) : ℝ) ≤
      (adaptiveCoordinateLinkTailVertices q.2 q.1
        (residualTransferCutoff q.2 c d b) d D Q (b + 1) H).card
  have hpoint : ∀ q ∈ I,
      finsetProbability (sample n M) (P q) ≤
        (((3 * n : ℕ) : ℝ) * p) / (e₁ + 1) := by
    intro q hq
    rcases q with ⟨x, Z⟩
    change (⟨x, Z⟩ : Sigma fun _x : Vertex n ↦ Edge n) ∈
      matchingIncidentPairs (allEdges n) at hq
    rw [matchingIncidentPairs, Finset.mem_sigma] at hq
    rcases hq with ⟨hxuniv, hZ⟩
    rcases Finset.mem_filter.mp hZ with ⟨hZall, hxZ⟩
    have h := adaptiveCoordinateLinkTailVertices_probability_le
      (M := M) (d := d) (D := D) (Q := Q) (b := b + 1)
      (k := e₁ + 1) (Z := Z) (x := x)
      (cutoff := residualTransferCutoff Z c d b) (p := p)
      hZall hxZ hM hp (Nat.succ_pos e₁)
      (hratio Z hZall x hxZ)
    simpa only [P, Nat.cast_add, Nat.cast_one] using h
  have hunion := finsetProbability_bexists_le_sum
    (sample n M) I P
  calc
    finsetProbability (sample n M)
          (SomeAdaptiveCoordinateTailFailure n c d D Q b e₁) =
        finsetProbability (sample n M)
          (fun H ↦ ∃ q ∈ I, P q H) := by
      apply finsetProbability_congr_event
      intro H hHs
      rfl
    _ ≤ ∑ q ∈ I, finsetProbability (sample n M) (P q) := hunion
    _ ≤ ∑ _q ∈ I,
        (((3 * n : ℕ) : ℝ) * p) / (e₁ + 1) :=
      Finset.sum_le_sum hpoint
    _ = ((3 * (allEdges n).card : ℕ) : ℝ) *
        ((((3 * n : ℕ) : ℝ) * p) / (e₁ + 1)) := by
      rw [Finset.sum_const, nsmul_eq_mul,
        card_matchingIncidentPairs _ (fun A hA ↦ hA)]

/-- Failure of the tail clause of `CoordinateTransferRegular` is
contained in the marked adaptive-tail union event. -/
lemma coordinateTransferRegular_tail_failure_probability_le
    {n M d D codegCap Q b B e₁ : ℕ} {c p : ℝ}
    (hM : M ≤ (allEdges n).card) (hp : 0 ≤ p)
    (hratio : ∀ Z ∈ allEdges n, ∀ x ∈ Z,
      ∀ y : Vertex n, y ∉ Z → ∀ t : ℕ,
        d ≤ t → t ≤ D →
          ((((Q.choose (b + 1)) *
              ((coordinateAmbientPairs n Z y).card - (b + 1)).choose
                (t - (b + 1)) : ℕ) : ℝ) ≤
            p * (((coordinateAmbientPairs n Z y).card.choose t : ℕ) : ℝ))) :
    finsetProbability (sample n M)
        (fun H ↦ ¬ ∀ Z ∈ allEdges n, ∀ x ∈ Z,
          (coordinateLinkTailVertices Z x
            (residualTransferCutoff Z c d b (inducedAway H Z))
            d D Q (b + 1) H).card ≤ e₁) ≤
      ((3 * (allEdges n).card : ℕ) : ℝ) *
        ((((3 * n : ℕ) : ℝ) * p) / (e₁ + 1)) := by
  have hmono : finsetProbability (sample n M)
      (fun H ↦ ¬ ∀ Z ∈ allEdges n, ∀ x ∈ Z,
        (coordinateLinkTailVertices Z x
          (residualTransferCutoff Z c d b (inducedAway H Z))
          d D Q (b + 1) H).card ≤ e₁) ≤
    finsetProbability (sample n M)
      (SomeAdaptiveCoordinateTailFailure n c d D Q b e₁) := by
    apply finsetProbability_mono_event
    intro H hHs hfail
    push Not at hfail
    rcases hfail with ⟨Z, hZall, x, hxZ, hlarge⟩
    unfold SomeAdaptiveCoordinateTailFailure
    refine ⟨⟨x, Z⟩, ?_, ?_⟩
    · rw [matchingIncidentPairs, Finset.mem_sigma]
      exact ⟨Finset.mem_univ x,
        Finset.mem_filter.mpr ⟨hZall, hxZ⟩⟩
    · rw [adaptiveCoordinateLinkTailVertices_eq]
      exact_mod_cast Nat.succ_le_iff.mpr hlarge
  exact hmono.trans
    (someAdaptiveCoordinateTailFailure_probability_le hM hp hratio)

/-- One-sided lower control for a completion weight. -/
def CompletionWeightLowerBound {n : ℕ} (H : Finset (Edge n))
    (L : ℝ) (Z : Edge n) : Prop :=
  L * matchingWeightTarget n H ≤ (completionWeight H Z : ℝ)

/-- All but an `eta` fraction of arbitrary triples satisfy a common
one-sided completion-weight lower bound. -/
def GlobalLowerWeightSpread (n : ℕ) (H : Finset (Edge n))
    (L eta : ℝ) : Prop :=
  ((((allEdges n).filter fun Z ↦
      ¬ CompletionWeightLowerBound H L Z).card : ℕ) : ℝ) ≤
    eta * (allEdges n).card

/-- A close newly inserted edge was already lower-typical in its
predecessor, with the exact normalization-change factor `M/(M+1)`. -/
lemma completionWeightLowerBound_of_insert_close {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (delta : ℝ)
    (hZ : Z ∉ H) (hPhi : (perfectMatchings n H).card ≠ 0)
    (hHcard : 0 < H.card) (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (hclose : CompletionWeightClose (insert Z H) delta Z) :
    CompletionWeightLowerBound H
      ((1 - delta) * (H.card : ℝ) / (H.card + 1)) Z := by
  have hZmem : Z ∈ insert Z H := Finset.mem_insert_self _ _
  have hPhiInsert : (perfectMatchings n (insert Z H)).card ≠ 0 := by
    rw [card_perfectMatchings_insert_eq_add_completionWeight H Z hZ]
    omega
  have hfracClose :=
    (completionWeightClose_iff_matchingFractionClose
      (insert Z H) hZmem hPhiInsert delta).mp hclose
  have hcardInsert : (insert Z H).card = H.card + 1 :=
    Finset.card_insert_of_notMem hZ
  have hfracLower :
      (1 - delta) * ((n : ℝ) / (H.card + 1)) ≤
        matchingFraction (insert Z H) Z := by
    unfold matchingFractionMean at hfracClose
    rw [hcardInsert] at hfracClose
    norm_num only [Nat.cast_add, Nat.cast_one] at hfracClose ⊢
    have habs := neg_abs_le
      (matchingFraction (insert Z H) Z -
        (n : ℝ) / ((H.card : ℝ) + 1))
    nlinarith
  have hcount := card_perfectMatchings_insert_eq_add_completionWeight H Z hZ
  have hcountR : ((perfectMatchings n (insert Z H)).card : ℝ) =
      ((perfectMatchings n H).card : ℝ) + completionWeight H Z := by
    exact_mod_cast hcount
  have hden : (0 : ℝ) < (perfectMatchings n (insert Z H)).card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhiInsert
  have hmul := (le_div_iff₀ hden).mp hfracLower
  unfold matchingFraction at hmul
  rw [show matchingWeight (insert Z H) Z = completionWeight H Z by rfl,
    hcountR] at hmul
  have hu0 : 0 ≤ (1 - delta) * ((n : ℝ) / (H.card + 1)) := by
    positivity
  have huPhi :
      ((1 - delta) * ((n : ℝ) / (H.card + 1))) *
          ((perfectMatchings n H).card : ℝ) ≤
        completionWeight H Z := by
    have hw0 : (0 : ℝ) ≤ completionWeight H Z := by positivity
    nlinarith
  unfold CompletionWeightLowerBound matchingWeightTarget
  have hcardR : (0 : ℝ) < H.card := by exact_mod_cast hHcard
  calc
    ((1 - delta) * (H.card : ℝ) / (H.card + 1)) *
          (((perfectMatchings n H).card : ℝ) * n / H.card) =
        ((1 - delta) * ((n : ℝ) / (H.card + 1))) *
          ((perfectMatchings n H).card : ℝ) := by
      field_simp [hcardR.ne']
    _ ≤ completionWeight H Z := huPhi

/-- Lower-bad missing triples. -/
def predicateLowerBadNonedges {n : ℕ} (H : Finset (Edge n))
    (L : ℝ) : Finset (Edge n) :=
  (allEdges n \ H).filter fun Z ↦
    ¬ CompletionWeightLowerBound H L Z

def predicateLowerBadCount {n : ℕ} (M : ℕ)
    (Good : Finset (Edge n) → Prop) (delta : ℝ)
    (H : Finset (Edge n)) : ℝ :=
  (((predicateLowerBadNonedges H
      ((1 - delta) * (M : ℝ) / (M + 1))).filter
    fun _ ↦ Good H).card : ℕ)

def predicateLowerBadExtensionPairs {n : ℕ} (M : ℕ)
    (Good : Finset (Edge n) → Prop) (delta : ℝ) :
    Finset ((_H : Finset (Edge n)) × Edge n) :=
  (sample n M).sigma fun H ↦
    (predicateLowerBadNonedges H
      ((1 - delta) * (M : ℝ) / (M + 1))).filter
      fun _ ↦ Good H

lemma predicateExtendPair_mapsTo_lowerBad {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ}
    (hM : 0 < M) (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H) :
    Set.MapsTo predicateExtendPair
      (↑(predicateLowerBadExtensionPairs M Good delta) :
        Set ((_H : Finset (Edge n)) × Edge n))
      (↑(predicateCloseBadMarkedPairs M Good delta) :
        Set ((_G : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, Z⟩ hHZ
  change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
    predicateLowerBadExtensionPairs M Good delta at hHZ
  rw [predicateLowerBadExtensionPairs, Finset.mem_sigma] at hHZ
  rcases hHZ with ⟨hHs, hZfiber⟩
  rcases Finset.mem_filter.mp hZfiber with ⟨hZbad, hGood⟩
  rcases Finset.mem_filter.mp hZbad with ⟨hZdiff, hnotLower⟩
  rcases Finset.mem_sdiff.mp hZdiff with ⟨hZall, hZnot⟩
  rcases mem_sample.mp hHs with ⟨hHall, hHcard⟩
  have hPhi : (perfectMatchings n H).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp (hgoodPM H hGood))
  change (⟨insert Z H, Z⟩ : ((_G : Finset (Edge n)) × Edge n)) ∈
    predicateCloseBadMarkedPairs M Good delta
  rw [predicateCloseBadMarkedPairs, Finset.mem_sigma]
  refine ⟨mem_sample.mpr ⟨Finset.insert_subset hZall hHall, ?_⟩,
    Finset.mem_filter.mpr ⟨Finset.mem_insert_self Z H, ?_, ?_⟩⟩
  · rw [Finset.card_insert_of_notMem hZnot, hHcard]
  · simpa [Finset.erase_insert hZnot] using hGood
  · intro hclose
    apply hnotLower
    simpa [hHcard] using completionWeightLowerBound_of_insert_close
      H Z delta hZnot hPhi (by simpa [hHcard] using hM) hdelta0 hdelta1 hclose

lemma predicateExtendPair_injectiveOn_lowerBad {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ} :
    Set.InjOn predicateExtendPair
      (↑(predicateLowerBadExtensionPairs M Good delta) :
        Set ((_H : Finset (Edge n)) × Edge n)) := by
  rintro ⟨H, Z⟩ hHZ ⟨H', Z'⟩ hH'Z' heq
  have hZnot : Z ∉ H := by
    change (⟨H, Z⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      predicateLowerBadExtensionPairs M Good delta at hHZ
    rw [predicateLowerBadExtensionPairs, Finset.mem_sigma] at hHZ
    exact (Finset.mem_sdiff.mp
      (Finset.mem_filter.mp (Finset.mem_filter.mp hHZ.2).1).1).2
  have hZ'not : Z' ∉ H' := by
    change (⟨H', Z'⟩ : ((_H : Finset (Edge n)) × Edge n)) ∈
      predicateLowerBadExtensionPairs M Good delta at hH'Z'
    rw [predicateLowerBadExtensionPairs, Finset.mem_sigma] at hH'Z'
    exact (Finset.mem_sdiff.mp
      (Finset.mem_filter.mp (Finset.mem_filter.mp hH'Z'.2).1).1).2
  have hins : insert Z H = insert Z' H' := congrArg Sigma.fst heq
  have hZZ' : Z = Z' := eq_of_heq (Sigma.mk.inj_iff.mp heq).2
  subst Z'
  have hHH' : H = H' := by
    simpa only [Finset.erase_insert hZnot, Finset.erase_insert hZ'not] using
      congrArg (fun S : Finset (Edge n) ↦ S.erase Z) hins
  subst H'
  rfl

lemma card_predicateLowerBadExtensionPairs_le_marked {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ}
    (hM : 0 < M) (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H) :
    (predicateLowerBadExtensionPairs M Good delta).card ≤
      (predicateCloseBadMarkedPairs M Good delta).card := by
  exact Finset.card_le_card_of_injOn predicateExtendPair
    (predicateExtendPair_mapsTo_lowerBad hM hdelta0 hdelta1 hgoodPM)
    predicateExtendPair_injectiveOn_lowerBad

lemma sum_predicateLowerBadCount {n M : ℕ}
    (Good : Finset (Edge n) → Prop) (delta : ℝ) :
    ∑ H ∈ sample n M, predicateLowerBadCount M Good delta H =
      ((predicateLowerBadExtensionPairs M Good delta).card : ℝ) := by
  rw [predicateLowerBadExtensionPairs, Finset.card_sigma]
  norm_num only [Nat.cast_sum]
  rfl

lemma average_predicateLowerBadCount_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta eta : ℝ}
    (hM : 0 < M) (hMtop : M < (allEdges n).card)
    (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1) (heta : 0 ≤ eta)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    finsetAverage (sample n M) (predicateLowerBadCount M Good delta) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) := by
  have hpairNat := card_predicateLowerBadExtensionPairs_le_marked
    hM hdelta0 hdelta1 hgoodPM
  have hpair : ((predicateLowerBadExtensionPairs M Good delta).card : ℝ) ≤
      (predicateCloseBadMarkedPairs M Good delta).card := by
    exact_mod_cast hpairNat
  have hmarked := card_predicateCloseBadMarkedPairs_le heta hspread
  have hchooseNat :
      (sample n (M + 1)).card * (M + 1) =
        (sample n M).card * ((allEdges n).card - M) := by
    rw [card_sample, card_sample]
    exact Nat.choose_succ_right_eq (allEdges n).card M
  have hchoose :
      ((sample n (M + 1)).card : ℝ) * ((M + 1 : ℕ) : ℝ) =
        ((sample n M).card : ℝ) *
          (((allEdges n).card - M : ℕ) : ℝ) := by
    exact_mod_cast hchooseNat
  have hsampleNat : 0 < (sample n M).card := by
    rw [card_sample]
    exact Nat.choose_pos hMtop.le
  have hsample : (0 : ℝ) < (sample n M).card := by
    exact_mod_cast hsampleNat
  unfold finsetAverage
  rw [sum_predicateLowerBadCount]
  apply (div_le_iff₀ hsample).2
  calc
    ((predicateLowerBadExtensionPairs M Good delta).card : ℝ) ≤
        (predicateCloseBadMarkedPairs M Good delta).card := hpair
    _ ≤ ((sample n (M + 1)).card : ℝ) *
        (eta * ((M + 1 : ℕ) : ℝ)) := hmarked
    _ = eta * (((sample n (M + 1)).card : ℝ) *
        ((M + 1 : ℕ) : ℝ)) := by ring
    _ = eta * (((sample n M).card : ℝ) *
        (((allEdges n).card - M : ℕ) : ℝ)) := by rw [hchoose]
    _ = eta * (((allEdges n).card - M : ℕ) : ℝ) *
        ((sample n M).card : ℝ) := by ring

lemma predicateLowerBadCount_probability_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta eta r : ℝ}
    (hM : 0 < M) (hMtop : M < (allEdges n).card)
    (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (heta : 0 ≤ eta) (hr : 0 < r)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    finsetProbability (sample n M)
        (fun H ↦ r ≤ predicateLowerBadCount M Good delta H) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  have hmarkov := finsetProbability_mul_le_average_of_nonneg
    (sample n M) (predicateLowerBadCount M Good delta) r
    (fun H _ ↦ by unfold predicateLowerBadCount; positivity)
  have havg := average_predicateLowerBadCount_le
    hM hMtop hdelta0 hdelta1 heta hgoodPM hspread
  apply le_of_mul_le_mul_right _ hr
  calc
    finsetProbability (sample n M)
          (fun H ↦ r ≤ predicateLowerBadCount M Good delta H) * r ≤
        finsetAverage (sample n M)
          (predicateLowerBadCount M Good delta) := hmarkov
    _ ≤ eta * (((allEdges n).card - M : ℕ) : ℝ) := havg
    _ = (eta * (((allEdges n).card - M : ℕ) : ℝ) / r) * r := by
      field_simp [hr.ne']

lemma predicateLowerBadCount_eq_of_good {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta : ℝ}
    {H : Finset (Edge n)} (hGood : Good H) :
    predicateLowerBadCount M Good delta H =
      ((predicateLowerBadNonedges H
        ((1 - delta) * (M : ℝ) / (M + 1))).card : ℝ) := by
  unfold predicateLowerBadCount
  simp [hGood]

lemma globalLowerBad_card_le_nonedge_add_card {n : ℕ}
    (H : Finset (Edge n)) (L : ℝ) :
    ((allEdges n).filter fun Z ↦
        ¬ CompletionWeightLowerBound H L Z).card ≤
      (predicateLowerBadNonedges H L).card + H.card := by
  have hsub :
      (allEdges n).filter (fun Z ↦
          ¬ CompletionWeightLowerBound H L Z) ⊆
        predicateLowerBadNonedges H L ∪ H := by
    intro Z hZ
    rcases Finset.mem_filter.mp hZ with ⟨hZall, hbad⟩
    by_cases hZH : Z ∈ H
    · exact Finset.mem_union_right _ hZH
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_sdiff.mpr ⟨hZall, hZH⟩, hbad⟩
  exact (Finset.card_le_card hsub).trans
    (Finset.card_union_le (predicateLowerBadNonedges H L) H)

lemma good_not_globalLower_implies_predicateBadCount_large {n M : ℕ}
    {Good : Finset (Edge n) → Prop} {delta etaGlobal r : ℝ}
    {H : Finset (Edge n)} (hHs : H ∈ sample n M) (hGood : Good H)
    (hbudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card)
    (hfail : ¬ GlobalLowerWeightSpread n H
      ((1 - delta) * (M : ℝ) / (M + 1)) etaGlobal) :
    r ≤ predicateLowerBadCount M Good delta H := by
  by_contra hnot
  apply hfail
  unfold GlobalLowerWeightSpread
  have hcard := globalLowerBad_card_le_nonedge_add_card H
    ((1 - delta) * (M : ℝ) / (M + 1))
  have hcardR :
      ((((allEdges n).filter fun Z ↦
        ¬ CompletionWeightLowerBound H
          ((1 - delta) * (M : ℝ) / (M + 1)) Z).card : ℕ) : ℝ) ≤
        ((predicateLowerBadNonedges H
          ((1 - delta) * (M : ℝ) / (M + 1))).card : ℝ) + H.card := by
    exact_mod_cast hcard
  have heq := predicateLowerBadCount_eq_of_good
    (M := M) (delta := delta) hGood
  have hHcard := (mem_sample.mp hHs).2
  calc
    ((((allEdges n).filter fun Z ↦
        ¬ CompletionWeightLowerBound H
          ((1 - delta) * (M : ℝ) / (M + 1)) Z).card : ℕ) : ℝ) ≤
        ((predicateLowerBadNonedges H
          ((1 - delta) * (M : ℝ) / (M + 1))).card : ℝ) + H.card := hcardR
    _ = predicateLowerBadCount M Good delta H + (M : ℝ) := by
      rw [heq, hHcard]
    _ ≤ r + (M : ℝ) := add_le_add (le_of_not_ge hnot) le_rfl
    _ ≤ etaGlobal * (allEdges n).card := hbudget

lemma good_globalLower_failure_probability_le {n M : ℕ}
    {Good : Finset (Edge n) → Prop}
    {delta eta etaGlobal r : ℝ}
    (hM : 0 < M) (hMtop : M < (allEdges n).card)
    (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (heta : 0 ≤ eta) (hr : 0 < r)
    (hbudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card)
    (hgoodPM : ∀ H, Good H → HasPerfectMatching n H)
    (hspread : ∀ H ∈ sample n M, Good H →
      ∀ Z ∈ allEdges n \ H, PresentWeightSpread (insert Z H) delta eta) :
    finsetProbability (sample n M)
        (fun H ↦ Good H ∧
          ¬ GlobalLowerWeightSpread n H
            ((1 - delta) * (M : ℝ) / (M + 1)) etaGlobal) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  have hmono : finsetProbability (sample n M)
      (fun H ↦ Good H ∧
        ¬ GlobalLowerWeightSpread n H
          ((1 - delta) * (M : ℝ) / (M + 1)) etaGlobal) ≤
      finsetProbability (sample n M)
        (fun H ↦ r ≤ predicateLowerBadCount M Good delta H) := by
    apply finsetProbability_mono_event
    intro H hHs h
    exact good_not_globalLower_implies_predicateBadCount_large
      hHs h.1 hbudget h.2
  exact hmono.trans (predicateLowerBadCount_probability_le
    hM hMtop hdelta0 hdelta1 heta hr hgoodPM hspread)

/-- Residual-weight failures restricted to triples disjoint from the
removed triple `Z`. -/
def residualBadTriplesAway (n : ℕ) (G : Finset (Edge n))
    (Z : Edge n) (a : ℝ) : Finset (Edge n) :=
  (allEdges n).filter fun U ↦
    Disjoint U Z ∧ ¬ a ≤ (residualWeight n G U : ℝ)

/-- Bad residual-pair incidences with the incoming vertex also outside
`Z`; their completed triples are therefore disjoint from `Z`. -/
def coordinateResidualBadPairIncidencesAway (n : ℕ)
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    Finset (Sigma fun _y : Vertex n ↦ Edge n) :=
  ((Finset.univ : Finset (Vertex n)).filter fun y ↦ y ∉ Z).sigma fun y ↦
    coordinateResidualBadPairs n G Z y a

lemma completeResidualBadPair_mapsTo_away {n : ℕ}
    {G : Finset (Edge n)} {Z : Edge n} {a : ℝ} :
    Set.MapsTo completeResidualBadPair
      (↑(coordinateResidualBadPairIncidencesAway n G Z a) :
        Set (Sigma fun _y : Vertex n ↦ Edge n))
      (↑((residualBadTriplesAway n G Z a).sigma fun U ↦ U) :
        Set (Sigma fun _U : Edge n ↦ Vertex n)) := by
  rintro ⟨y, S⟩ hys
  change (⟨y, S⟩ : Sigma fun _y : Vertex n ↦ Edge n) ∈
    coordinateResidualBadPairIncidencesAway n G Z a at hys
  rw [coordinateResidualBadPairIncidencesAway, Finset.mem_sigma] at hys
  rcases hys with ⟨hy, hSbad⟩
  have hyZ : y ∉ Z := (Finset.mem_filter.mp hy).2
  rcases mem_coordinateResidualBadPairs.mp hSbad with
    ⟨hScard, hSdisj, hweight⟩
  have hyS : y ∉ S := by
    intro hyS
    exact Finset.disjoint_left.mp hSdisj hyS
      (Finset.mem_insert_self y Z)
  have hUZ : Disjoint (insert y S) Z := by
    rw [Finset.disjoint_left]
    intro v hvU hvZ
    rcases Finset.mem_insert.mp hvU with rfl | hvS
    · exact hyZ hvZ
    · exact Finset.disjoint_left.mp hSdisj hvS
        (Finset.mem_insert_of_mem hvZ)
  change (⟨insert y S, y⟩ : Sigma fun _U : Edge n ↦ Vertex n) ∈
    (residualBadTriplesAway n G Z a).sigma fun U ↦ U
  rw [Finset.mem_sigma]
  refine ⟨?_, Finset.mem_insert_self y S⟩
  apply Finset.mem_filter.mpr
  refine ⟨mem_allEdges.mpr ?_, hUZ, hweight⟩
  rw [Finset.card_insert_of_notMem hyS, hScard]

lemma completeResidualBadPair_injectiveOn_away {n : ℕ}
    {G : Finset (Edge n)} {Z : Edge n} {a : ℝ} :
    Set.InjOn completeResidualBadPair
      (↑(coordinateResidualBadPairIncidencesAway n G Z a) :
        Set (Sigma fun _y : Vertex n ↦ Edge n)) := by
  intro p hp q hq hpq
  have hp' : p ∈ coordinateResidualBadPairIncidences n G Z a := by
    rcases p with ⟨y, S⟩
    change (⟨y, S⟩ : Sigma fun _y : Vertex n ↦ Edge n) ∈
      coordinateResidualBadPairIncidencesAway n G Z a at hp
    rw [coordinateResidualBadPairIncidencesAway, Finset.mem_sigma] at hp
    rw [coordinateResidualBadPairIncidences, Finset.mem_sigma]
    exact ⟨Finset.mem_univ y, hp.2⟩
  have hq' : q ∈ coordinateResidualBadPairIncidences n G Z a := by
    rcases q with ⟨y, S⟩
    change (⟨y, S⟩ : Sigma fun _y : Vertex n ↦ Edge n) ∈
      coordinateResidualBadPairIncidencesAway n G Z a at hq
    rw [coordinateResidualBadPairIncidencesAway, Finset.mem_sigma] at hq
    rw [coordinateResidualBadPairIncidences, Finset.mem_sigma]
    exact ⟨Finset.mem_univ y, hq.2⟩
  exact completeResidualBadPair_injectiveOn hp' hq' hpq

lemma card_coordinateResidualBadPairIncidencesAway (n : ℕ)
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    (coordinateResidualBadPairIncidencesAway n G Z a).card =
      ∑ y ∈ (Finset.univ : Finset (Vertex n)).filter (fun y ↦ y ∉ Z),
        (coordinateResidualBadPairs n G Z y a).card := by
  rw [coordinateResidualBadPairIncidencesAway, Finset.card_sigma]

lemma card_badTripleVertexPairs_away {n : ℕ}
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    ((residualBadTriplesAway n G Z a).sigma fun U ↦ U).card =
      3 * (residualBadTriplesAway n G Z a).card := by
  rw [Finset.card_sigma]
  calc
    ∑ U ∈ residualBadTriplesAway n G Z a, U.card =
        ∑ _U ∈ residualBadTriplesAway n G Z a, 3 := by
      apply Finset.sum_congr rfl
      intro U hU
      exact mem_allEdges.mp (Finset.mem_filter.mp hU).1
    _ = 3 * (residualBadTriplesAway n G Z a).card := by
      simp [Nat.mul_comm]

lemma sum_card_coordinateResidualBadPairs_away_le {n : ℕ}
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) :
    (∑ y ∈ (Finset.univ : Finset (Vertex n)).filter (fun y ↦ y ∉ Z),
        (coordinateResidualBadPairs n G Z y a).card) ≤
      3 * (residualBadTriplesAway n G Z a).card := by
  rw [← card_coordinateResidualBadPairIncidencesAway,
    ← card_badTripleVertexPairs_away]
  exact Finset.card_le_card_of_injOn completeResidualBadPair
    completeResidualBadPair_mapsTo_away
    completeResidualBadPair_injectiveOn_away

/-- Exceptional incoming vertices, restricted to those outside `Z`. -/
def coordinateResidualExceptionalVerticesAway {n : ℕ}
    (G : Finset (Edge n)) (Z : Edge n) (a : ℝ) (Q : ℕ) :
    Finset (Vertex n) :=
  Finset.univ.filter fun y ↦
    y ∉ Z ∧ Q + 1 ≤ (coordinateResidualBadPairs n G Z y a).card

lemma coordinateResidualExceptionalVerticesAway_card_mul_le
    {n B Q : ℕ} {G : Finset (Edge n)} {Z : Edge n} {a : ℝ}
    (hB : (residualBadTriplesAway n G Z a).card ≤ B) :
    (coordinateResidualExceptionalVerticesAway G Z a Q).card * (Q + 1) ≤
      3 * B := by
  let Y := (Finset.univ : Finset (Vertex n)).filter fun y ↦ y ∉ Z
  let E := Y.filter fun y ↦
    Q + 1 ≤ (coordinateResidualBadPairs n G Z y a).card
  have hpoint : ∀ y ∈ E,
      Q + 1 ≤ (coordinateResidualBadPairs n G Z y a).card := by
    intro y hy
    exact (Finset.mem_filter.mp hy).2
  have hsum := sum_card_coordinateResidualBadPairs_away_le G Z a
  have hEY : E ⊆ Y := Finset.filter_subset _ _
  have hbound : E.card * (Q + 1) ≤
      ∑ y ∈ Y, (coordinateResidualBadPairs n G Z y a).card := by
    calc
      E.card * (Q + 1) = ∑ _y ∈ E, (Q + 1) := by simp
      _ ≤ ∑ y ∈ E,
          (coordinateResidualBadPairs n G Z y a).card :=
        Finset.sum_le_sum hpoint
      _ ≤ ∑ y ∈ Y,
          (coordinateResidualBadPairs n G Z y a).card :=
        Finset.sum_le_sum_of_subset_of_nonneg hEY
          (fun _ _ _ ↦ Nat.zero_le _)
  have hEeq : coordinateResidualExceptionalVerticesAway G Z a Q = E := by
    ext y
    simp [coordinateResidualExceptionalVerticesAway, E, Y, and_assoc]
  rw [hEeq]
  exact hbound.trans (hsum.trans (Nat.mul_le_mul_left 3 hB))

lemma coordinateLinkFailureVertices_subset_exceptionalAway_union_tail
    {n d D Q b : ℕ} {H : Finset (Edge n)} {Z : Edge n}
    {x : Vertex n} {a : ℝ}
    (hrange : CoordinateLinksInRange H Z x d D) :
    coordinateLinkFailureVertices n H Z x d b a ⊆
      coordinateResidualExceptionalVerticesAway (inducedAway H Z) Z a Q ∪
        coordinateLinkTailVertices Z x a d D Q (b + 1) H := by
  intro y hy
  rcases Finset.mem_filter.mp hy with ⟨_hyuniv, hyZ, hfail⟩
  rcases hrange y hyZ with ⟨hlower, hupper⟩
  rcases hfail with hsmall | hbad
  · omega
  · by_cases hex :
        Q + 1 ≤
          (coordinateResidualBadPairs n (inducedAway H Z) Z y a).card
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ y, hyZ, hex⟩
    · apply Finset.mem_union_right
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_univ y, hyZ, ?_⟩
      exact ⟨hlower, hupper, Nat.le_of_lt_succ (Nat.lt_of_not_ge hex),
        Nat.succ_le_iff.mpr hbad⟩

lemma coordinateLinkFailureVertices_card_le_of_away
    {n d D Q b B e₀ e₁ : ℕ} {H : Finset (Edge n)} {Z : Edge n}
    {x : Vertex n} {a : ℝ}
    (hrange : CoordinateLinksInRange H Z x d D)
    (hglobal :
      (residualBadTriplesAway n (inducedAway H Z) Z a).card ≤ B)
    (hbudget : 3 * B ≤ e₀ * (Q + 1))
    (htail :
      (coordinateLinkTailVertices Z x a d D Q (b + 1) H).card ≤ e₁) :
    (coordinateLinkFailureVertices n H Z x d b a).card ≤ e₀ + e₁ := by
  let E := coordinateResidualExceptionalVerticesAway
    (inducedAway H Z) Z a Q
  let T := coordinateLinkTailVertices Z x a d D Q (b + 1) H
  have hEmul : E.card * (Q + 1) ≤ 3 * B := by
    simpa only [E] using
      (coordinateResidualExceptionalVerticesAway_card_mul_le
        (G := inducedAway H Z) (Z := Z) (a := a) (Q := Q) hglobal)
  have hE : E.card ≤ e₀ := by
    apply Nat.le_of_mul_le_mul_left (c := Q + 1)
    · simpa only [Nat.mul_comm] using hEmul.trans hbudget
    · omega
  calc
    (coordinateLinkFailureVertices n H Z x d b a).card ≤
        (E ∪ T).card := by
      apply Finset.card_le_card
      simpa only [E, T] using
        (coordinateLinkFailureVertices_subset_exceptionalAway_union_tail
          (Q := Q) (b := b) hrange)
    _ ≤ E.card + T.card := Finset.card_union_le E T
    _ ≤ e₀ + e₁ := Nat.add_le_add hE (by simpa only [T] using htail)

/-- Coordinate-transfer regularity using only residual triples disjoint
from the removed triple. -/
def CoordinateTransferRegularAway (n : ℕ) (H : Finset (Edge n))
    (c : ℝ) (d D codegCap Q b B e₁ : ℕ) : Prop :=
  H ⊆ allEdges n ∧
  (∀ v : Vertex n, d ≤ vertexDegree H v - 3 * codegCap) ∧
  (∀ v : Vertex n, vertexDegree H v ≤ D) ∧
  (∀ u v : Vertex n, u ≠ v → vertexCodegree H u v ≤ codegCap) ∧
  (∀ Z ∈ allEdges n,
    (residualBadTriplesAway n (inducedAway H Z) Z
      (residualTransferCutoff Z c d b (inducedAway H Z))).card ≤ B) ∧
  (∀ Z ∈ allEdges n, ∀ x ∈ Z,
    (coordinateLinkTailVertices Z x
      (residualTransferCutoff Z c d b (inducedAway H Z))
      d D Q (b + 1) H).card ≤ e₁)

lemma maximumWeightDominated_of_coordinateTransferRegularAway
    {n d D codegCap Q b B e₀ e₁ : ℕ}
    {H : Finset (Edge n)} {c : ℝ}
    (hn : 2 ≤ n) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hdb : b < d) (hB : 3 * B ≤ e₀ * (Q + 1))
    (he : 2 * (e₀ + e₁) + 12 ≤ n)
    (hreg : CoordinateTransferRegularAway n H c d D codegCap Q b B e₁) :
    MaximumWeightDominated n H
      (((n / 2 : ℕ) : ℝ)^3 / (allEdges n).card) (c^3) := by
  rcases hreg with ⟨hHall, hdegLower, hdegUpper, hcodeg,
    hresidual, htail⟩
  have hn0 : 0 < n := by omega
  obtain ⟨Z₀, hZ₀, hmax⟩ := exists_max_completionWeight H hn0
  let a : Edge n → ℝ := fun Z ↦
    residualTransferCutoff Z c d b (inducedAway H Z)
  have ha : ∀ Z ∈ allEdges n, 0 ≤ a Z := by
    intro Z hZ
    dsimp only [a, residualTransferCutoff]
    positivity
  have hfailure : ∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤
          (completionWeight H Z : ℝ) →
        ∀ x ∈ Z,
          (coordinateLinkFailureVertices n H Z x d b (a Z)).card ≤
            e₀ + e₁ := by
    intro Z hZ hs x hx
    have hrange : CoordinateLinksInRange H Z x d D :=
      coordinateLinksInRange_of_degree_codegree hHall hZ hx
        (hdegLower x) (hdegUpper x) hcodeg
    have htail' :
        (coordinateLinkTailVertices Z x (a Z) d D Q (b + 1) H).card ≤ e₁ := by
      exact htail Z hZ x hx
    exact coordinateLinkFailureVertices_card_le_of_away hrange
      (hresidual Z hZ) hB htail'
  have hbudget : ∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤
          (completionWeight H Z : ℝ) →
        c * (completionWeight H Z : ℝ) ≤
          (((d - b : ℕ) : ℝ) * a Z) := by
    intro Z hZ hs
    dsimp only [a]
    rw [residualTransferCutoff_inducedAway (H := H) (Z := Z) hn0 hZ]
    have hdb0 : (0 : ℝ) < (d - b : ℕ) := by
      exact_mod_cast Nat.sub_pos_of_lt hdb
    field_simp [hdb0.ne']
    exact le_rfl
  have htransfer : CoordinateTransferAbove n H
      (c^2 * (completionWeight H Z₀ : ℝ)) c (e₀ + e₁) :=
    coordinateTransferAbove_of_variable_linkFailures a hn ha hfailure hbudget
  exact maximumWeightDominated_of_max_transfer hn0 hZ₀ hmax hc0 hc1
    htransfer he

abbrev OutsideVertex {n : ℕ} (Z : Edge n) := {v : Vertex n // v ∉ Z}

instance {n : ℕ} (Z : Edge n) : Fintype (OutsideVertex Z) :=
  Fintype.ofInjective Subtype.val Subtype.val_injective

lemma card_outsideVertex {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) :
    Fintype.card (OutsideVertex Z) = 3 * (n - 1) := by
  rw [Fintype.card_subtype_compl (fun v : Vertex n ↦ v ∈ Z)]
  have hsubcard : Fintype.card {v : Vertex n // v ∈ Z} = Z.card := by
    exact Fintype.card_coe Z
  rw [hsubcard]
  simp only [Fintype.card_fin, mem_allEdges.mp hZ]
  omega

def outsideVertexEquiv {n : ℕ} (Z : Edge n) (hZ : Z ∈ allEdges n) :
    OutsideVertex Z ≃ Vertex (n - 1) :=
  Fintype.equivOfCardEq (by simp [card_outsideVertex hZ])

def reindexEdgeAway {n : ℕ} (Z : Edge n) (hZ : Z ∈ allEdges n)
    (U : Edge n) : Edge (n - 1) :=
  (Finset.subtype (fun v : Vertex n ↦ v ∉ Z) U).map
    (outsideVertexEquiv Z hZ).toEmbedding

def unreindexEdgeAway {n : ℕ} (Z : Edge n) (hZ : Z ∈ allEdges n)
    (W : Edge (n - 1)) : Edge n :=
  W.map ⟨fun w ↦ ((outsideVertexEquiv Z hZ).symm w).1,
    fun _ _ h ↦ (outsideVertexEquiv Z hZ).symm.injective (Subtype.ext h)⟩

lemma mem_reindexEdgeAway {n : ℕ} {Z U : Edge n}
    (hZ : Z ∈ allEdges n) (w : Vertex (n - 1)) :
    w ∈ reindexEdgeAway Z hZ U ↔
      ((outsideVertexEquiv Z hZ).symm w).1 ∈ U := by
  simp [reindexEdgeAway]

lemma mem_unreindexEdgeAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {W : Edge (n - 1)} (v : Vertex n) :
    v ∈ unreindexEdgeAway Z hZ W ↔
      ∃ hv : v ∉ Z, outsideVertexEquiv Z hZ ⟨v, hv⟩ ∈ W := by
  constructor
  · intro hv
    rcases Finset.mem_map.mp hv with ⟨w, hw, hwv⟩
    change ((outsideVertexEquiv Z hZ).symm w).1 = v at hwv
    have hvZ : v ∉ Z := by
      intro hvZ
      exact ((outsideVertexEquiv Z hZ).symm w).2 (hwv ▸ hvZ)
    refine ⟨hvZ, ?_⟩
    have heq : (⟨v, hvZ⟩ : OutsideVertex Z) =
        (outsideVertexEquiv Z hZ).symm w := by
      apply Subtype.ext
      exact hwv.symm
    rw [heq, Equiv.apply_symm_apply]
    exact hw
  · rintro ⟨hvZ, hvW⟩
    apply Finset.mem_map.mpr
    refine ⟨outsideVertexEquiv Z hZ ⟨v, hvZ⟩, hvW, ?_⟩
    exact congrArg Subtype.val
      ((outsideVertexEquiv Z hZ).symm_apply_apply ⟨v, hvZ⟩)

lemma unreindex_reindexEdgeAway {n : ℕ} {Z U : Edge n}
    (hZ : Z ∈ allEdges n) (hUZ : Disjoint U Z) :
    unreindexEdgeAway Z hZ (reindexEdgeAway Z hZ U) = U := by
  ext v
  rw [mem_unreindexEdgeAway]
  constructor
  · rintro ⟨hvZ, hv⟩
    simpa [mem_reindexEdgeAway] using hv
  · intro hvU
    have hvZ : v ∉ Z := fun hv ↦ Finset.disjoint_left.mp hUZ hvU hv
    refine ⟨hvZ, ?_⟩
    rw [mem_reindexEdgeAway]
    simpa using hvU

lemma reindex_unreindexEdgeAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) (W : Edge (n - 1)) :
    reindexEdgeAway Z hZ (unreindexEdgeAway Z hZ W) = W := by
  ext w
  rw [mem_reindexEdgeAway]
  constructor
  · intro hw
    rcases (mem_unreindexEdgeAway hZ
      (((outsideVertexEquiv Z hZ).symm w).1)).mp hw with ⟨hvZ, hvW⟩
    simpa using hvW
  · intro hw
    apply (mem_unreindexEdgeAway hZ
      (((outsideVertexEquiv Z hZ).symm w).1)).mpr
    refine ⟨((outsideVertexEquiv Z hZ).symm w).2, ?_⟩
    simpa using hw

lemma unreindexEdgeAway_disjoint {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) (W : Edge (n - 1)) :
    Disjoint (unreindexEdgeAway Z hZ W) Z := by
  rw [Finset.disjoint_left]
  intro v hvW hvZ
  rcases (mem_unreindexEdgeAway hZ v).mp hvW with ⟨hvnot, _⟩
  exact hvnot hvZ

abbrev AwayEdge {n : ℕ} (Z : Edge n) :=
  {U : Edge n // Disjoint U Z}

def edgeAwayEquiv {n : ℕ} (Z : Edge n) (hZ : Z ∈ allEdges n) :
    AwayEdge Z ≃ Edge (n - 1) where
  toFun U := reindexEdgeAway Z hZ U.1
  invFun W := ⟨unreindexEdgeAway Z hZ W,
    unreindexEdgeAway_disjoint hZ W⟩
  left_inv U := Subtype.ext (unreindex_reindexEdgeAway hZ U.2)
  right_inv W := reindex_unreindexEdgeAway hZ W

def reindexGraphAway {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (hZ : Z ∈ allEdges n) : Finset (Edge (n - 1)) :=
  (Finset.subtype (fun U : Edge n ↦ Disjoint U Z) H).map
    (edgeAwayEquiv Z hZ).toEmbedding

lemma mem_reindexGraphAway {n : ℕ} {H : Finset (Edge n)}
    {Z : Edge n} (hZ : Z ∈ allEdges n) (W : Edge (n - 1)) :
    W ∈ reindexGraphAway H Z hZ ↔
      unreindexEdgeAway Z hZ W ∈ H := by
  simp [reindexGraphAway, edgeAwayEquiv]

lemma reindexEdgeAway_mem_reindexGraphAway {n : ℕ}
    {H : Finset (Edge n)} {Z U : Edge n} (hZ : Z ∈ allEdges n)
    (hUZ : Disjoint U Z) :
    reindexEdgeAway Z hZ U ∈ reindexGraphAway H Z hZ ↔ U ∈ H := by
  rw [mem_reindexGraphAway]
  rw [unreindex_reindexEdgeAway hZ hUZ]

lemma card_unreindexEdgeAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) (W : Edge (n - 1)) :
    (unreindexEdgeAway Z hZ W).card = W.card := by
  unfold unreindexEdgeAway
  rw [Finset.card_map]

lemma card_reindexEdgeAway {n : ℕ} {Z U : Edge n}
    (hZ : Z ∈ allEdges n) (hUZ : Disjoint U Z) :
    (reindexEdgeAway Z hZ U).card = U.card := by
  have h := congrArg Finset.card (unreindex_reindexEdgeAway hZ hUZ)
  rw [card_unreindexEdgeAway] at h
  exact h

lemma reindexEdgeAway_mem_allEdges {n : ℕ} {Z U : Edge n}
    (hZ : Z ∈ allEdges n) (hUZ : Disjoint U Z)
    (hU : U ∈ allEdges n) :
    reindexEdgeAway Z hZ U ∈ allEdges (n - 1) := by
  rw [mem_allEdges, card_reindexEdgeAway hZ hUZ]
  exact mem_allEdges.mp hU

lemma unreindexEdgeAway_mem_allEdges {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {W : Edge (n - 1)}
    (hW : W ∈ allEdges (n - 1)) :
    unreindexEdgeAway Z hZ W ∈ allEdges n := by
  rw [mem_allEdges, card_unreindexEdgeAway hZ]
  exact mem_allEdges.mp hW

lemma disjoint_reindexEdgeAway_iff {n : ℕ} {Z U V : Edge n}
    (hZ : Z ∈ allEdges n) (hUZ : Disjoint U Z) (hVZ : Disjoint V Z) :
    Disjoint (reindexEdgeAway Z hZ U) (reindexEdgeAway Z hZ V) ↔
      Disjoint U V := by
  rw [Finset.disjoint_left, Finset.disjoint_left]
  constructor
  · intro h w hwU hwV
    have hwUZ : w ∉ Z := fun hwZ ↦ Finset.disjoint_left.mp hUZ hwU hwZ
    let z := outsideVertexEquiv Z hZ ⟨w, hwUZ⟩
    have hzU : z ∈ reindexEdgeAway Z hZ U := by
      rw [mem_reindexEdgeAway]
      simpa [z] using hwU
    have hzV : z ∈ reindexEdgeAway Z hZ V := by
      rw [mem_reindexEdgeAway]
      simpa [z] using hwV
    exact h hzU hzV
  · intro h w hwU hwV
    rw [mem_reindexEdgeAway] at hwU hwV
    exact h hwU hwV

lemma card_reindexGraphAway {n : ℕ} (H : Finset (Edge n))
    {Z : Edge n} (hZ : Z ∈ allEdges n) :
    (reindexGraphAway H Z hZ).card = (inducedAway H Z).card := by
  rw [reindexGraphAway, Finset.card_map]
  rw [Finset.card_subtype]
  rfl

def reindexFamilyAway {n : ℕ} (Z : Edge n)
    (hZ : Z ∈ allEdges n) (F : Finset (Edge n)) :
    Finset (Edge (n - 1)) :=
  (Finset.subtype (fun U : Edge n ↦ Disjoint U Z) F).map
    (edgeAwayEquiv Z hZ).toEmbedding

def unreindexFamilyAway {n : ℕ} (Z : Edge n)
    (hZ : Z ∈ allEdges n) (K : Finset (Edge (n - 1))) :
    Finset (Edge n) :=
  K.map ⟨unreindexEdgeAway Z hZ,
    fun _ _ h ↦ by
      have := congrArg (reindexEdgeAway Z hZ) h
      simpa [reindex_unreindexEdgeAway] using this⟩

lemma mem_reindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {F : Finset (Edge n)}
    (W : Edge (n - 1)) :
    W ∈ reindexFamilyAway Z hZ F ↔
      unreindexEdgeAway Z hZ W ∈ F := by
  simp [reindexFamilyAway, edgeAwayEquiv]

lemma reindexEdgeAway_mem_reindexFamilyAway {n : ℕ}
    {Z U : Edge n} (hZ : Z ∈ allEdges n) (hUZ : Disjoint U Z)
    {F : Finset (Edge n)} :
    reindexEdgeAway Z hZ U ∈ reindexFamilyAway Z hZ F ↔ U ∈ F := by
  rw [mem_reindexFamilyAway, unreindex_reindexEdgeAway hZ hUZ]

lemma mem_unreindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {K : Finset (Edge (n - 1))} (U : Edge n) :
    U ∈ unreindexFamilyAway Z hZ K ↔
      ∃ W ∈ K, unreindexEdgeAway Z hZ W = U := by
  constructor
  · intro hU
    rcases Finset.mem_map.mp hU with ⟨W, hWK, hWU⟩
    exact ⟨W, hWK, hWU⟩
  · rintro ⟨W, hWK, hWU⟩
    exact Finset.mem_map.mpr ⟨W, hWK, hWU⟩

lemma reindex_unreindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) (K : Finset (Edge (n - 1))) :
    reindexFamilyAway Z hZ (unreindexFamilyAway Z hZ K) = K := by
  ext W
  rw [mem_reindexFamilyAway]
  rw [mem_unreindexFamilyAway]
  constructor
  · rintro ⟨X, hXK, hXW⟩
    have := congrArg (reindexEdgeAway Z hZ) hXW
    have hXW' : X = W := by
      simpa [reindex_unreindexEdgeAway] using this
    simpa [hXW'] using hXK
  · intro hWK
    exact ⟨W, hWK, rfl⟩

lemma unreindex_reindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {F : Finset (Edge n)}
    (haway : ∀ U ∈ F, Disjoint U Z) :
    unreindexFamilyAway Z hZ (reindexFamilyAway Z hZ F) = F := by
  ext U
  constructor
  · intro hU
    rcases (mem_unreindexFamilyAway hZ U).mp hU with ⟨W, hW, hWU⟩
    have hWF := (mem_reindexFamilyAway hZ W).mp hW
    simpa [hWU] using hWF
  · intro hU
    apply (mem_unreindexFamilyAway hZ U).mpr
    refine ⟨reindexEdgeAway Z hZ U,
      (reindexEdgeAway_mem_reindexFamilyAway hZ (haway U hU)).mpr hU, ?_⟩
    exact unreindex_reindexEdgeAway hZ (haway U hU)

lemma card_reindexFamilyAway_of_away {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {F : Finset (Edge n)}
    (haway : ∀ U ∈ F, Disjoint U Z) :
    (reindexFamilyAway Z hZ F).card = F.card := by
  have h := congrArg Finset.card
    (unreindex_reindexFamilyAway hZ haway)
  rw [unreindexFamilyAway, Finset.card_map] at h
  exact h

lemma card_unreindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) (K : Finset (Edge (n - 1))) :
    (unreindexFamilyAway Z hZ K).card = K.card := by
  rw [unreindexFamilyAway, Finset.card_map]

lemma isMatching_reindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {F : Finset (Edge n)}
    (haway : ∀ U ∈ F, Disjoint U Z) (hmatch : IsMatching F) :
    IsMatching (reindexFamilyAway Z hZ F) := by
  intro W hW V hV hWV
  have hWF := (mem_reindexFamilyAway hZ W).mp hW
  have hVF := (mem_reindexFamilyAway hZ V).mp hV
  have hUV : unreindexEdgeAway Z hZ W ≠ unreindexEdgeAway Z hZ V := by
    intro h
    apply hWV
    have := congrArg (reindexEdgeAway Z hZ) h
    simpa [reindex_unreindexEdgeAway] using this
  have hdis := hmatch hWF hVF hUV
  have hre := (disjoint_reindexEdgeAway_iff hZ
    (unreindexEdgeAway_disjoint hZ W)
    (unreindexEdgeAway_disjoint hZ V)).mpr hdis
  simpa [reindex_unreindexEdgeAway] using hre

lemma isMatching_unreindexFamilyAway {n : ℕ} {Z : Edge n}
    (hZ : Z ∈ allEdges n) {K : Finset (Edge (n - 1))}
    (hmatch : IsMatching K) :
    IsMatching (unreindexFamilyAway Z hZ K) := by
  intro U hU V hV hUV
  rcases (mem_unreindexFamilyAway hZ U).mp hU with ⟨W, hWK, rfl⟩
  rcases (mem_unreindexFamilyAway hZ V).mp hV with ⟨X, hXK, rfl⟩
  have hWX : W ≠ X := by
    intro h
    apply hUV
    simpa [h]
  have hdis := hmatch hWK hXK hWX
  apply (disjoint_reindexEdgeAway_iff hZ
    (unreindexEdgeAway_disjoint hZ W)
    (unreindexEdgeAway_disjoint hZ X)).mp
  simpa [reindex_unreindexEdgeAway] using hdis

def completionPerfectMatchingEquiv {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (hZ : Z ∈ allEdges n) :
    {F // F ∈ completionMatchings n H Z} ≃
      {K // K ∈ perfectMatchings (n - 1) (reindexGraphAway H Z hZ)} where
  toFun F := ⟨reindexFamilyAway Z hZ F.1, by
    rcases mem_completionMatchings.mp F.2 with
      ⟨hFH, hcard, hmatch, haway⟩
    apply mem_perfectMatchings.mpr
    refine ⟨?_, card_reindexFamilyAway_of_away hZ haway ▸ hcard,
      isMatching_reindexFamilyAway hZ haway hmatch⟩
    intro W hW
    rw [mem_reindexGraphAway]
    exact hFH ((mem_reindexFamilyAway hZ W).mp hW)⟩
  invFun K := ⟨unreindexFamilyAway Z hZ K.1, by
    rcases mem_perfectMatchings.mp K.2 with ⟨hKJ, hcard, hmatch⟩
    apply mem_completionMatchings.mpr
    refine ⟨?_, card_unreindexFamilyAway hZ K.1 ▸ hcard,
      isMatching_unreindexFamilyAway hZ hmatch, ?_⟩
    · intro U hU
      rcases (mem_unreindexFamilyAway hZ U).mp hU with ⟨W, hWK, rfl⟩
      exact (mem_reindexGraphAway hZ W).mp (hKJ hWK)
    · intro U hU
      rcases (mem_unreindexFamilyAway hZ U).mp hU with ⟨W, _hWK, rfl⟩
      exact unreindexEdgeAway_disjoint hZ W⟩
  left_inv F := by
    apply Subtype.ext
    exact unreindex_reindexFamilyAway hZ
      (mem_completionMatchings.mp F.2).2.2.2
  right_inv K := by
    apply Subtype.ext
    exact reindex_unreindexFamilyAway hZ K.1

lemma card_completionMatchings_eq_card_perfectMatchings_reindexAway
    {n : ℕ} (H : Finset (Edge n)) (Z : Edge n)
    (hZ : Z ∈ allEdges n) :
    (completionMatchings n H Z).card =
      (perfectMatchings (n - 1) (reindexGraphAway H Z hZ)).card := by
  have h := Fintype.card_congr (completionPerfectMatchingEquiv H Z hZ)
  rw [Fintype.card_coe, Fintype.card_coe] at h
  exact h

def residualCompletionEquiv {n : ℕ} (hn : 2 ≤ n)
    (H : Finset (Edge n)) (Z U : Edge n)
    (hZ : Z ∈ allEdges n) (hUZ : Disjoint U Z) :
    {F // F ∈ residualMatchings n (inducedAway H Z) U} ≃
      {K // K ∈ completionMatchings (n - 1)
        (reindexGraphAway H Z hZ) (reindexEdgeAway Z hZ U)} where
  toFun F := ⟨reindexFamilyAway Z hZ F.1, by
    rcases mem_residualMatchings.mp F.2 with
      ⟨hFG, hcard, hmatch, havoidU⟩
    have hawayZ : ∀ A ∈ F.1, Disjoint A Z := by
      intro A hAF
      exact (mem_inducedAway.mp (hFG hAF)).2
    apply mem_completionMatchings.mpr
    refine ⟨?_, ?_, isMatching_reindexFamilyAway hZ hawayZ hmatch, ?_⟩
    · intro W hWF
      rw [mem_reindexGraphAway]
      exact (mem_inducedAway.mp
        (hFG ((mem_reindexFamilyAway hZ W).mp hWF))).1
    · rw [card_reindexFamilyAway_of_away hZ hawayZ, hcard]
      omega
    · intro W hWF
      have hWF' := (mem_reindexFamilyAway hZ W).mp hWF
      have hdis := havoidU _ hWF'
      have hre := (disjoint_reindexEdgeAway_iff hZ
        (hawayZ _ hWF') hUZ).mpr hdis
      simpa [reindex_unreindexEdgeAway] using hre⟩
  invFun K := ⟨unreindexFamilyAway Z hZ K.1, by
    rcases mem_completionMatchings.mp K.2 with
      ⟨hKJ, hcard, hmatch, havoidW⟩
    apply mem_residualMatchings.mpr
    refine ⟨?_, ?_, isMatching_unreindexFamilyAway hZ hmatch, ?_⟩
    · intro A hAF
      rcases (mem_unreindexFamilyAway hZ A).mp hAF with ⟨W, hWK, rfl⟩
      exact mem_inducedAway.mpr
        ⟨(mem_reindexGraphAway hZ W).mp (hKJ hWK),
          unreindexEdgeAway_disjoint hZ W⟩
    · rw [card_unreindexFamilyAway hZ, hcard]
      omega
    · intro A hAF
      rcases (mem_unreindexFamilyAway hZ A).mp hAF with ⟨W, hWK, rfl⟩
      apply (disjoint_reindexEdgeAway_iff hZ
        (unreindexEdgeAway_disjoint hZ W) hUZ).mp
      simpa [reindex_unreindexEdgeAway] using havoidW W hWK⟩
  left_inv F := by
    apply Subtype.ext
    exact unreindex_reindexFamilyAway hZ
      (fun A hAF ↦ (mem_inducedAway.mp
        ((mem_residualMatchings.mp F.2).1 hAF)).2)
  right_inv K := by
    apply Subtype.ext
    exact reindex_unreindexFamilyAway hZ K.1

lemma residualWeight_inducedAway_eq_completionWeight_reindexAway
    {n : ℕ} (hn : 2 ≤ n) (H : Finset (Edge n)) {Z U : Edge n}
    (hZ : Z ∈ allEdges n) (hU : U ∈ allEdges n)
    (hUZ : Disjoint U Z) :
    residualWeight n (inducedAway H Z) U =
      completionWeight (reindexGraphAway H Z hZ)
        (reindexEdgeAway Z hZ U) := by
  unfold residualWeight
  rw [completionWeight_eq_card_completionMatchings _ _ (by omega)
    (reindexEdgeAway_mem_allEdges hZ hUZ hU)]
  have h := Fintype.card_congr
    (residualCompletionEquiv hn H Z U hZ hUZ)
  rw [Fintype.card_coe, Fintype.card_coe] at h
  exact h

lemma residualBadTriplesAway_card_le_globalLowerBad_reindexAway
    {n : ℕ} (hn : 2 ≤ n) (H : Finset (Edge n)) {Z : Edge n}
    (hZ : Z ∈ allEdges n) (a L : ℝ)
    (hcutoff : a ≤ L * matchingWeightTarget (n - 1)
      (reindexGraphAway H Z hZ)) :
    (residualBadTriplesAway n (inducedAway H Z) Z a).card ≤
      ((allEdges (n - 1)).filter fun W ↦
        ¬ CompletionWeightLowerBound
          (reindexGraphAway H Z hZ) L W).card := by
  apply Finset.card_le_card_of_injOn (reindexEdgeAway Z hZ)
  · intro U hU
    rcases Finset.mem_filter.mp hU with ⟨hUall, hUZ, hbad⟩
    apply Finset.mem_filter.mpr
    refine ⟨reindexEdgeAway_mem_allEdges hZ hUZ hUall, ?_⟩
    intro hlower
    apply hbad
    calc
      a ≤ L * matchingWeightTarget (n - 1)
          (reindexGraphAway H Z hZ) := hcutoff
      _ ≤ (completionWeight (reindexGraphAway H Z hZ)
          (reindexEdgeAway Z hZ U) : ℝ) := hlower
      _ = (residualWeight n (inducedAway H Z) U : ℝ) := by
        exact_mod_cast
          (residualWeight_inducedAway_eq_completionWeight_reindexAway
            hn H hZ hUall hUZ).symm
  · intro U hU V hV hUV
    have hUZ := (Finset.mem_filter.mp hU).2.1
    have hVZ := (Finset.mem_filter.mp hV).2.1
    have h := congrArg (unreindexEdgeAway Z hZ) hUV
    simpa [unreindex_reindexEdgeAway hZ hUZ,
      unreindex_reindexEdgeAway hZ hVZ] using h

lemma residualBadTriplesAway_card_le_of_globalLowerWeightSpread_reindexAway
    {n B : ℕ} (hn : 2 ≤ n) (H : Finset (Edge n)) {Z : Edge n}
    (hZ : Z ∈ allEdges n) (a L eta : ℝ)
    (hcutoff : a ≤ L * matchingWeightTarget (n - 1)
      (reindexGraphAway H Z hZ))
    (hspread : GlobalLowerWeightSpread (n - 1)
      (reindexGraphAway H Z hZ) L eta)
    (hbudget : eta * (allEdges (n - 1)).card ≤ B) :
    (residualBadTriplesAway n (inducedAway H Z) Z a).card ≤ B := by
  have hcard := residualBadTriplesAway_card_le_globalLowerBad_reindexAway
    hn H hZ a L hcutoff
  have hbadR :
      ((((allEdges (n - 1)).filter fun W ↦
        ¬ CompletionWeightLowerBound
          (reindexGraphAway H Z hZ) L W).card : ℕ) : ℝ) ≤ B :=
    hspread.trans hbudget
  have hcardR' :
      ((residualBadTriplesAway n (inducedAway H Z) Z a).card : ℝ) ≤
        (((allEdges (n - 1)).filter fun W ↦
          ¬ CompletionWeightLowerBound
            (reindexGraphAway H Z hZ) L W).card : ℝ) := by
    exact_mod_cast hcard
  have hcardR :
      ((residualBadTriplesAway n (inducedAway H Z) Z a).card : ℝ) ≤ B :=
    hcardR'.trans hbadR
  exact_mod_cast hcardR

def meetingEdges {n : ℕ} (Z : Edge n) : Finset (Edge n) :=
  (allEdges n).filter fun U ↦ ¬ Disjoint U Z

def meetingPart {n : ℕ} (H : Finset (Edge n)) (Z : Edge n) :
    Finset (Edge n) :=
  H.filter fun U ↦ ¬ Disjoint U Z

@[simp] lemma mem_meetingEdges {n : ℕ} {Z U : Edge n} :
    U ∈ meetingEdges Z ↔ U ∈ allEdges n ∧ ¬ Disjoint U Z := by
  simp [meetingEdges]

@[simp] lemma mem_meetingPart {n : ℕ} {H : Finset (Edge n)}
    {Z U : Edge n} :
    U ∈ meetingPart H Z ↔ U ∈ H ∧ ¬ Disjoint U Z := by
  simp [meetingPart]

lemma inducedAway_union_meetingPart {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) :
    inducedAway H Z ∪ meetingPart H Z = H := by
  ext U
  simp only [Finset.mem_union, mem_inducedAway, mem_meetingPart]
  constructor
  · rintro (h | h) <;> exact h.1
  · intro hUH
    by_cases hUZ : Disjoint U Z
    · exact Or.inl ⟨hUH, hUZ⟩
    · exact Or.inr ⟨hUH, hUZ⟩

lemma disjoint_inducedAway_meetingPart {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) :
    Disjoint (inducedAway H Z) (meetingPart H Z) := by
  rw [Finset.disjoint_left]
  intro U hUA hUB
  exact (mem_meetingPart.mp hUB).2 (mem_inducedAway.mp hUA).2

lemma card_inducedAway_add_card_meetingPart {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) :
    (inducedAway H Z).card + (meetingPart H Z).card = H.card := by
  rw [← Finset.card_union_of_disjoint (disjoint_inducedAway_meetingPart H Z),
    inducedAway_union_meetingPart]

lemma unreindexFamilyAway_reindexGraphAway {n : ℕ}
    (H : Finset (Edge n)) {Z : Edge n} (hZ : Z ∈ allEdges n) :
    unreindexFamilyAway Z hZ (reindexGraphAway H Z hZ) =
      inducedAway H Z := by
  ext U
  constructor
  · intro hU
    rcases (mem_unreindexFamilyAway hZ U).mp hU with ⟨W, hW, rfl⟩
    exact mem_inducedAway.mpr
      ⟨(mem_reindexGraphAway hZ W).mp hW,
        unreindexEdgeAway_disjoint hZ W⟩
  · intro hU
    rcases mem_inducedAway.mp hU with ⟨hUH, hUZ⟩
    apply (mem_unreindexFamilyAway hZ U).mpr
    refine ⟨reindexEdgeAway Z hZ U, ?_, unreindex_reindexEdgeAway hZ hUZ⟩
    exact (reindexEdgeAway_mem_reindexGraphAway hZ hUZ).mpr hUH

lemma meetingPart_subset_meetingEdges {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} (hH : H ⊆ allEdges n) :
    meetingPart H Z ⊆ meetingEdges Z := by
  intro U hU
  exact mem_meetingEdges.mpr ⟨hH (mem_meetingPart.mp hU).1,
    (mem_meetingPart.mp hU).2⟩

lemma meetingEdges_subset_allEdges {n : ℕ} (Z : Edge n) :
    meetingEdges Z ⊆ allEdges n := by
  intro U hU
  exact (mem_meetingEdges.mp hU).1

lemma unreindexFamilyAway_subset_allEdges {n : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    {J : Finset (Edge (n - 1))} (hJ : J ⊆ allEdges (n - 1)) :
    unreindexFamilyAway Z hZ J ⊆ allEdges n := by
  intro U hU
  rcases (mem_unreindexFamilyAway hZ U).mp hU with ⟨W, hW, rfl⟩
  exact unreindexEdgeAway_mem_allEdges hZ (hJ hW)

lemma disjoint_unreindexFamilyAway_meeting {n : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (J : Finset (Edge (n - 1)))
    {B : Finset (Edge n)} (hB : B ⊆ meetingEdges Z) :
    Disjoint (unreindexFamilyAway Z hZ J) B := by
  rw [Finset.disjoint_left]
  intro U hUJ hUB
  rcases (mem_unreindexFamilyAway hZ U).mp hUJ with ⟨W, _hW, rfl⟩
  exact (mem_meetingEdges.mp (hB hUB)).2
    (unreindexEdgeAway_disjoint hZ W)

lemma reindexGraphAway_union_unreindex_meeting {n : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (J : Finset (Edge (n - 1)))
    {B : Finset (Edge n)} (hB : B ⊆ meetingEdges Z) :
    reindexGraphAway (unreindexFamilyAway Z hZ J ∪ B) Z hZ = J := by
  ext W
  rw [mem_reindexGraphAway]
  constructor
  · intro hW
    rcases Finset.mem_union.mp hW with hWJ | hWB
    · rcases (mem_unreindexFamilyAway hZ _).mp hWJ with
        ⟨X, hXJ, hXW⟩
      have := congrArg (reindexEdgeAway Z hZ) hXW
      have hXeq : X = W := by
        simpa [reindex_unreindexEdgeAway] using this
      simpa [hXeq] using hXJ
    · exact False.elim ((mem_meetingEdges.mp (hB hWB)).2
        (unreindexEdgeAway_disjoint hZ W))
  · intro hWJ
    exact Finset.mem_union_left _
      ((mem_unreindexFamilyAway hZ _).mpr ⟨W, hWJ, rfl⟩)

lemma meetingPart_union_unreindex_meeting {n : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (J : Finset (Edge (n - 1)))
    {B : Finset (Edge n)} (hB : B ⊆ meetingEdges Z) :
    meetingPart (unreindexFamilyAway Z hZ J ∪ B) Z = B := by
  ext U
  constructor
  · intro hU
    rcases mem_meetingPart.mp hU with ⟨hUnion, hmeet⟩
    rcases Finset.mem_union.mp hUnion with hUJ | hUB
    · rcases (mem_unreindexFamilyAway hZ U).mp hUJ with ⟨W, _hW, rfl⟩
      exact False.elim (hmeet (unreindexEdgeAway_disjoint hZ W))
    · exact hUB
  · intro hUB
    exact mem_meetingPart.mpr
      ⟨Finset.mem_union_right _ hUB, (mem_meetingEdges.mp (hB hUB)).2⟩

lemma reindexGraphAway_subset_allEdges {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} (hZ : Z ∈ allEdges n)
    (hH : H ⊆ allEdges n) :
    reindexGraphAway H Z hZ ⊆ allEdges (n - 1) := by
  intro W hW
  have hUn : unreindexEdgeAway Z hZ W ∈ allEdges n :=
    hH ((mem_reindexGraphAway hZ W).mp hW)
  rw [mem_allEdges, ← card_unreindexEdgeAway hZ]
  exact mem_allEdges.mp hUn

abbrev AwaySampleDecomposition (n M : ℕ) (Z : Edge n) :=
  {p : Finset (Edge (n - 1)) × Finset (Edge n) //
    p.1 ⊆ allEdges (n - 1) ∧ p.2 ⊆ meetingEdges Z ∧
      p.1.card + p.2.card = M}

def fixedSampleAwayDecompositionEquiv {n M : ℕ}
    (Z : Edge n) (hZ : Z ∈ allEdges n) :
    {H // H ∈ sample n M} ≃ AwaySampleDecomposition n M Z where
  toFun H := ⟨(reindexGraphAway H.1 Z hZ, meetingPart H.1 Z), by
    rcases mem_sample.mp H.2 with ⟨hHall, hHcard⟩
    refine ⟨reindexGraphAway_subset_allEdges hZ hHall,
      meetingPart_subset_meetingEdges hHall, ?_⟩
    rw [card_reindexGraphAway,
      card_inducedAway_add_card_meetingPart, hHcard]⟩
  invFun p := ⟨unreindexFamilyAway Z hZ p.1.1 ∪ p.1.2, by
    rcases p.2 with ⟨hJall, hBmeet, hcard⟩
    apply mem_sample.mpr
    refine ⟨Finset.union_subset
      (unreindexFamilyAway_subset_allEdges hZ hJall)
      (hBmeet.trans (meetingEdges_subset_allEdges Z)), ?_⟩
    rw [Finset.card_union_of_disjoint
      (disjoint_unreindexFamilyAway_meeting hZ p.1.1 hBmeet),
      card_unreindexFamilyAway hZ, hcard]⟩
  left_inv H := by
    apply Subtype.ext
    dsimp only
    rw [unreindexFamilyAway_reindexGraphAway,
      inducedAway_union_meetingPart]
  right_inv p := by
    apply Subtype.ext
    dsimp only
    apply Prod.ext
    · exact reindexGraphAway_union_unreindex_meeting hZ p.1.1 p.2.2.1
    · exact meetingPart_union_unreindex_meeting hZ p.1.1 p.2.2.1

def awayLayeredDecompositions (n M : ℕ) (Z : Edge n) :
    Finset (Sigma fun _k : ℕ ↦
      Finset (Edge (n - 1)) × Finset (Edge n)) :=
  (Finset.range (M + 1)).sigma fun k ↦
    (sample (n - 1) k).product
      ((meetingEdges Z).powersetCard (M - k))

def awayDecompositionToLayer {n M : ℕ} (Z : Edge n)
    (p : AwaySampleDecomposition n M Z) :
    {q // q ∈ awayLayeredDecompositions n M Z} := by
    rcases p with ⟨⟨J, B⟩, hJall, hBmeet, hcard⟩
    change J.card + B.card = M at hcard
    have hle : J.card ≤ M := by omega
    refine ⟨⟨J.card, (J, B)⟩, ?_⟩
    unfold awayLayeredDecompositions
    rw [Finset.mem_sigma]
    change J.card ∈ Finset.range (M + 1) ∧
      (J, B) ∈ (sample (n - 1) J.card).product
        ((meetingEdges Z).powersetCard (M - J.card))
    refine ⟨Finset.mem_range.mpr (by omega),
      Finset.mem_product.mpr ⟨mem_sample.mpr ⟨hJall, rfl⟩, ?_⟩⟩
    have hBcard : B.card = M - J.card := by omega
    exact Finset.mem_powersetCard.mpr ⟨hBmeet, hBcard⟩

@[simp] lemma awayDecompositionToLayer_snd {n M : ℕ} (Z : Edge n)
    (p : AwaySampleDecomposition n M Z) :
    (awayDecompositionToLayer Z p).1.2 = p.1 := by
  rcases p with ⟨⟨J, B⟩, hJall, hBmeet, hcard⟩
  rfl

@[simp] lemma awayDecompositionToLayer_fst {n M : ℕ} (Z : Edge n)
    (p : AwaySampleDecomposition n M Z) :
    (awayDecompositionToLayer Z p).1.1 = p.1.1.card := by
  rcases p with ⟨⟨J, B⟩, hJall, hBmeet, hcard⟩
  rfl

lemma awayDecompositionToLayer_injective {n M : ℕ} (Z : Edge n) :
    Function.Injective (awayDecompositionToLayer (n := n) (M := M) Z) := by
  intro p q hpq
  apply Subtype.ext
  have hsigma := congrArg (fun x ↦ x.1.2) hpq
  simpa only [awayDecompositionToLayer_snd] using hsigma

lemma awayDecompositionToLayer_surjective {n M : ℕ} (Z : Edge n) :
    Function.Surjective (awayDecompositionToLayer (n := n) (M := M) Z) := by
  intro q
  rcases q with ⟨⟨k, ⟨J, B⟩⟩, hq⟩
  have hq' := hq
  unfold awayLayeredDecompositions at hq'
  rw [Finset.mem_sigma] at hq'
  rcases hq' with ⟨hk, hpair⟩
  change k ∈ Finset.range (M + 1) at hk
  rcases Finset.mem_product.mp hpair with ⟨hJ, hB⟩
  rcases mem_sample.mp hJ with ⟨hJall, hJcard⟩
  rcases Finset.mem_powersetCard.mp hB with ⟨hBmeet, hBcard⟩
  change J.card = k at hJcard
  change B.card = M - k at hBcard
  have hklt : k < M + 1 := Finset.mem_range.mp hk
  let p : AwaySampleDecomposition n M Z := ⟨(J, B), by
    change J ⊆ allEdges (n - 1) ∧ B ⊆ meetingEdges Z ∧
      J.card + B.card = M
    refine ⟨hJall, hBmeet, ?_⟩
    rw [hJcard, hBcard]
    omega⟩
  refine ⟨p, ?_⟩
  apply Subtype.ext
  apply Sigma.ext (by
    rw [awayDecompositionToLayer_fst]
    exact hJcard)
  change (J, B) ≍ (J, B)
  exact HEq.rfl

def awayDecompositionLayerEquiv {n M : ℕ} (Z : Edge n) :
    AwaySampleDecomposition n M Z ≃
      {q // q ∈ awayLayeredDecompositions n M Z} :=
  Equiv.ofBijective (awayDecompositionToLayer Z)
    ⟨awayDecompositionToLayer_injective Z,
      awayDecompositionToLayer_surjective Z⟩

def fixedSampleAwayLayerEquiv {n M : ℕ}
    (Z : Edge n) (hZ : Z ∈ allEdges n) :
    {H // H ∈ sample n M} ≃
      {q // q ∈ awayLayeredDecompositions n M Z} :=
  (fixedSampleAwayDecompositionEquiv Z hZ).trans
    (awayDecompositionLayerEquiv Z)

@[simp] lemma fixedSampleAwayLayerEquiv_graph {n M : ℕ}
    (Z : Edge n) (hZ : Z ∈ allEdges n) (H : {H // H ∈ sample n M}) :
    ((fixedSampleAwayLayerEquiv Z hZ) H).1.2.1 =
      reindexGraphAway H.1 Z hZ := by
  change (awayDecompositionToLayer Z
    ((fixedSampleAwayDecompositionEquiv Z hZ) H)).1.2.1 = _
  rw [awayDecompositionToLayer_snd]
  rfl

lemma finsetProbability_equiv_subtype {α β : Type*}
    (s : Finset α) (t : Finset β) (e : ↥s ≃ ↥t)
    (P : α → Prop) (Q : β → Prop)
    (hrel : ∀ x (hx : x ∈ s), P x ↔ Q (e ⟨x, hx⟩).1) :
    finsetProbability s P = finsetProbability t Q := by
  have hden := Fintype.card_congr e
  rw [Fintype.card_coe, Fintype.card_coe] at hden
  have hnum : (s.filter P).card = (t.filter Q).card := by
    apply Finset.card_bij
      (fun x hx ↦ (e ⟨x, (Finset.mem_filter.mp hx).1⟩).1)
    · intro x hx
      apply Finset.mem_filter.mpr
      refine ⟨(e ⟨x, (Finset.mem_filter.mp hx).1⟩).2, ?_⟩
      exact (hrel x (Finset.mem_filter.mp hx).1).mp
        (Finset.mem_filter.mp hx).2
    · intro x hx y hy hxy
      exact congrArg Subtype.val (e.injective (Subtype.ext hxy))
    · intro y hy
      let z : ↥t := ⟨y, (Finset.mem_filter.mp hy).1⟩
      let x : ↥s := e.symm z
      refine ⟨x.1, ?_, ?_⟩
      · apply Finset.mem_filter.mpr
        refine ⟨x.2, ?_⟩
        apply (hrel x.1 x.2).mpr
        have heq : e x = z := e.apply_symm_apply z
        simpa only [z] using congrArg (fun w : ↥t ↦ Q w.1) heq ▸
          (Finset.mem_filter.mp hy).2
      · exact congrArg Subtype.val (e.apply_symm_apply z)
  unfold finsetProbability
  rw [hnum, hden]

lemma reindexGraphAway_probability_eq_layered {n M : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (P : Finset (Edge (n - 1)) → Prop) :
    finsetProbability (sample n M)
        (fun H ↦ P (reindexGraphAway H Z hZ)) =
      finsetProbability (awayLayeredDecompositions n M Z)
        (fun q ↦ P q.2.1) := by
  apply finsetProbability_equiv_subtype _ _
    (fixedSampleAwayLayerEquiv Z hZ)
  intro H hH
  rw [fixedSampleAwayLayerEquiv_graph]

lemma card_filter_le_mul_card_of_finsetProbability_le
    {α : Type*} (s : Finset α) (P : α → Prop) (delta : ℝ)
    (hprob : finsetProbability s P ≤ delta) :
    ((s.filter P).card : ℝ) ≤ delta * s.card := by
  by_cases hs : s.card = 0
  · have hsempty : s = ∅ := Finset.card_eq_zero.mp hs
    subst s
    simp
  · have hsR : (0 : ℝ) < s.card := by exact_mod_cast Nat.pos_of_ne_zero hs
    unfold finsetProbability at hprob
    exact (div_le_iff₀ hsR).mp hprob

lemma filter_awayLayeredDecompositions (n M : ℕ) (Z : Edge n)
    (P : Finset (Edge (n - 1)) → Prop) :
    (awayLayeredDecompositions n M Z).filter (fun q ↦ P q.2.1) =
      (Finset.range (M + 1)).sigma fun k ↦
        ((sample (n - 1) k).filter P).product
          ((meetingEdges Z).powersetCard (M - k)) := by
  ext q
  rw [Finset.mem_filter]
  unfold awayLayeredDecompositions
  rw [Finset.mem_sigma, Finset.mem_sigma]
  constructor
  · rintro ⟨⟨hk, hpair⟩, hP⟩
    rcases Finset.mem_product.mp hpair with ⟨hJ, hB⟩
    exact ⟨hk, Finset.mem_product.mpr
      ⟨Finset.mem_filter.mpr ⟨hJ, hP⟩, hB⟩⟩
  · rintro ⟨hk, hpair⟩
    rcases Finset.mem_product.mp hpair with ⟨hJ, hB⟩
    exact ⟨⟨hk, Finset.mem_product.mpr
      ⟨(Finset.mem_filter.mp hJ).1, hB⟩⟩,
      (Finset.mem_filter.mp hJ).2⟩

lemma card_filter_awayLayeredDecompositions (n M : ℕ) (Z : Edge n)
    (P : Finset (Edge (n - 1)) → Prop) :
    ((awayLayeredDecompositions n M Z).filter
        (fun q ↦ P q.2.1)).card =
      ∑ k ∈ Finset.range (M + 1),
        ((sample (n - 1) k).filter P).card *
          ((meetingEdges Z).powersetCard (M - k)).card := by
  rw [filter_awayLayeredDecompositions]
  rw [Finset.card_sigma]
  apply Finset.sum_congr rfl
  intro k hk
  exact Finset.card_product _ _

lemma card_awayLayeredDecompositions (n M : ℕ) (Z : Edge n) :
    (awayLayeredDecompositions n M Z).card =
      ∑ k ∈ Finset.range (M + 1),
        (sample (n - 1) k).card *
          ((meetingEdges Z).powersetCard (M - k)).card := by
  unfold awayLayeredDecompositions
  rw [Finset.card_sigma]
  apply Finset.sum_congr rfl
  intro k hk
  exact Finset.card_product _ _

lemma awayLayered_probability_le_of_layer_le {n M : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (P : Finset (Edge (n - 1)) → Prop) (delta : ℝ)
    (hM : M ≤ (allEdges n).card)
    (hlayer : ∀ k ≤ M,
      finsetProbability (sample (n - 1) k) P ≤ delta) :
    finsetProbability (awayLayeredDecompositions n M Z)
        (fun q ↦ P q.2.1) ≤ delta := by
  have hsample : (sample n M).Nonempty := by
    apply Finset.card_pos.mp
    rw [card_sample]
    exact Nat.choose_pos hM
  obtain ⟨H, hH⟩ := hsample
  let q := fixedSampleAwayLayerEquiv Z hZ ⟨H, hH⟩
  have hlayered : (awayLayeredDecompositions n M Z).Nonempty :=
    ⟨q.1, q.2⟩
  have hden : (0 : ℝ) < (awayLayeredDecompositions n M Z).card := by
    exact_mod_cast Finset.card_pos.mpr hlayered
  have hterm : ∀ k ∈ Finset.range (M + 1),
      (((sample (n - 1) k).filter P).card : ℝ) *
          ((meetingEdges Z).powersetCard (M - k)).card ≤
        (delta * (sample (n - 1) k).card) *
          ((meetingEdges Z).powersetCard (M - k)).card := by
    intro k hk
    have hklt : k < M + 1 := Finset.mem_range.mp hk
    have hkM : k ≤ M := by omega
    exact mul_le_mul_of_nonneg_right
      (card_filter_le_mul_card_of_finsetProbability_le
        (sample (n - 1) k) P delta (hlayer k hkM)) (by positivity)
  unfold finsetProbability
  rw [card_filter_awayLayeredDecompositions,
    card_awayLayeredDecompositions]
  have hden' : (0 : ℝ) <
      (∑ k ∈ Finset.range (M + 1),
        (sample (n - 1) k).card *
          ((meetingEdges Z).powersetCard (M - k)).card) := by
    exact_mod_cast (show 0 <
      (∑ k ∈ Finset.range (M + 1),
        (sample (n - 1) k).card *
          ((meetingEdges Z).powersetCard (M - k)).card) by
      rw [← card_awayLayeredDecompositions]
      exact Finset.card_pos.mpr hlayered)
  apply (div_le_iff₀ hden').2
  norm_num only [Nat.cast_sum, Nat.cast_mul]
  calc
    (∑ k ∈ Finset.range (M + 1),
        (((sample (n - 1) k).filter P).card : ℝ) *
          ((meetingEdges Z).powersetCard (M - k)).card) ≤
      ∑ k ∈ Finset.range (M + 1),
        (delta * (sample (n - 1) k).card) *
          ((meetingEdges Z).powersetCard (M - k)).card :=
        Finset.sum_le_sum hterm
    _ = delta *
        (∑ k ∈ Finset.range (M + 1),
          ((sample (n - 1) k).card : ℝ) *
            ((meetingEdges Z).powersetCard (M - k)).card) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      ring

lemma reindexGraphAway_probability_le_of_layer_le {n M : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (P : Finset (Edge (n - 1)) → Prop) (delta : ℝ)
    (hM : M ≤ (allEdges n).card)
    (hlayer : ∀ k ≤ M,
      finsetProbability (sample (n - 1) k) P ≤ delta) :
    finsetProbability (sample n M)
        (fun H ↦ P (reindexGraphAway H Z hZ)) ≤ delta := by
  rw [reindexGraphAway_probability_eq_layered hZ P]
  exact awayLayered_probability_le_of_layer_le hZ P delta hM hlayer

lemma some_reindexGraphAway_failure_probability_le {n M : ℕ}
    (P : Finset (Edge (n - 1)) → Prop) (delta : ℝ)
    (hM : M ≤ (allEdges n).card)
    (hlayer : ∀ k ≤ M,
      finsetProbability (sample (n - 1) k) P ≤ delta) :
    finsetProbability (sample n M)
        (fun H ↦ ∃ Z : ↥(allEdges n),
          P (reindexGraphAway H Z.1 Z.2)) ≤
      (allEdges n).card * delta := by
  calc
    finsetProbability (sample n M)
        (fun H ↦ ∃ Z : ↥(allEdges n),
          P (reindexGraphAway H Z.1 Z.2)) ≤
      ∑ Z : ↥(allEdges n),
        finsetProbability (sample n M)
          (fun H ↦ P (reindexGraphAway H Z.1 Z.2)) := by
        exact finsetProbability_exists_le_sum _ _
    _ ≤ ∑ _Z : ↥(allEdges n), delta :=
      Finset.sum_le_sum fun Z _ ↦
        reindexGraphAway_probability_le_of_layer_le Z.2 P delta hM hlayer
    _ = (allEdges n).card * delta := by simp

lemma inverseOutsideVertex_mem_unreindexEdgeAway {n : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n) (w : Vertex (n - 1))
    (W : Edge (n - 1)) :
    ((outsideVertexEquiv Z hZ).symm w).1 ∈
        unreindexEdgeAway Z hZ W ↔ w ∈ W := by
  rw [mem_unreindexEdgeAway]
  constructor
  · rintro ⟨hv, hw⟩
    simpa using hw
  · intro hw
    refine ⟨((outsideVertexEquiv Z hZ).symm w).2, ?_⟩
    simpa using hw

lemma vertexDegree_reindexGraphAway {n : ℕ} (H : Finset (Edge n))
    {Z : Edge n} (hZ : Z ∈ allEdges n) (w : Vertex (n - 1)) :
    vertexDegree (reindexGraphAway H Z hZ) w =
      vertexDegree (inducedAway H Z)
        ((outsideVertexEquiv Z hZ).symm w).1 := by
  unfold vertexDegree
  apply Finset.card_bij
    (fun W _ ↦ unreindexEdgeAway Z hZ W)
  · intro W hW
    rcases Finset.mem_filter.mp hW with ⟨hWJ, hwW⟩
    apply Finset.mem_filter.mpr
    exact ⟨mem_inducedAway.mpr
      ⟨(mem_reindexGraphAway hZ W).mp hWJ,
        unreindexEdgeAway_disjoint hZ W⟩,
      (inverseOutsideVertex_mem_unreindexEdgeAway hZ w W).mpr hwW⟩
  · intro W hW X hX hWX
    have := congrArg (reindexEdgeAway Z hZ) hWX
    simpa [reindex_unreindexEdgeAway] using this
  · intro U hU
    rcases Finset.mem_filter.mp hU with ⟨hUG, hwU⟩
    rcases mem_inducedAway.mp hUG with ⟨hUH, hUZ⟩
    refine ⟨reindexEdgeAway Z hZ U, ?_,
      unreindex_reindexEdgeAway hZ hUZ⟩
    apply Finset.mem_filter.mpr
    refine ⟨(reindexEdgeAway_mem_reindexGraphAway hZ hUZ).mpr hUH, ?_⟩
    rw [mem_reindexEdgeAway]
    exact hwU

lemma vertexCodegree_reindexGraphAway {n : ℕ} (H : Finset (Edge n))
    {Z : Edge n} (hZ : Z ∈ allEdges n) (u v : Vertex (n - 1)) :
    vertexCodegree (reindexGraphAway H Z hZ) u v =
      vertexCodegree (inducedAway H Z)
        ((outsideVertexEquiv Z hZ).symm u).1
        ((outsideVertexEquiv Z hZ).symm v).1 := by
  unfold vertexCodegree
  apply Finset.card_bij
    (fun W _ ↦ unreindexEdgeAway Z hZ W)
  · intro W hW
    rcases Finset.mem_filter.mp hW with ⟨hWJ, huW, hvW⟩
    apply Finset.mem_filter.mpr
    exact ⟨mem_inducedAway.mpr
      ⟨(mem_reindexGraphAway hZ W).mp hWJ,
        unreindexEdgeAway_disjoint hZ W⟩,
      (inverseOutsideVertex_mem_unreindexEdgeAway hZ u W).mpr huW,
      (inverseOutsideVertex_mem_unreindexEdgeAway hZ v W).mpr hvW⟩
  · intro W hW X hX hWX
    have := congrArg (reindexEdgeAway Z hZ) hWX
    simpa [reindex_unreindexEdgeAway] using this
  · intro U hU
    rcases Finset.mem_filter.mp hU with ⟨hUG, huU, hvU⟩
    rcases mem_inducedAway.mp hUG with ⟨hUH, hUZ⟩
    refine ⟨reindexEdgeAway Z hZ U, ?_,
      unreindex_reindexEdgeAway hZ hUZ⟩
    apply Finset.mem_filter.mpr
    refine ⟨(reindexEdgeAway_mem_reindexGraphAway hZ hUZ).mpr hUH, ?_, ?_⟩
    · rw [mem_reindexEdgeAway]
      exact huU
    · rw [mem_reindexEdgeAway]
      exact hvU

lemma vertexDegree_inducedAway_add_codegrees_ge {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (v : Vertex n) :
    vertexDegree H v ≤ vertexDegree (inducedAway H Z) v +
      ∑ z ∈ Z, vertexCodegree H v z := by
  let I := (inducedAway H Z).filter fun A ↦ v ∈ A
  let C : Vertex n → Finset (Edge n) := fun z ↦
    H.filter fun A ↦ v ∈ A ∧ z ∈ A
  have hsub : (H.filter fun A ↦ v ∈ A) ⊆ I ∪ Z.biUnion C := by
    intro A hA
    rcases Finset.mem_filter.mp hA with ⟨hAH, hvA⟩
    by_cases hAZ : Disjoint A Z
    · exact Finset.mem_union_left _
        (Finset.mem_filter.mpr ⟨mem_inducedAway.mpr ⟨hAH, hAZ⟩, hvA⟩)
    · obtain ⟨z, hzA, hzZ⟩ := Finset.not_disjoint_iff.mp hAZ
      apply Finset.mem_union_right
      apply Finset.mem_biUnion.mpr
      exact ⟨z, hzZ, Finset.mem_filter.mpr ⟨hAH, hvA, hzA⟩⟩
  calc
    vertexDegree H v = (H.filter fun A ↦ v ∈ A).card := rfl
    _ ≤ (I ∪ Z.biUnion C).card := Finset.card_le_card hsub
    _ ≤ I.card + (Z.biUnion C).card := Finset.card_union_le _ _
    _ ≤ I.card + ∑ z ∈ Z, (C z).card :=
      Nat.add_le_add_left (Finset.card_biUnion_le (s := Z) (t := C)) _
    _ = vertexDegree (inducedAway H Z) v +
        ∑ z ∈ Z, vertexCodegree H v z := by rfl

lemma vertexDegree_inducedAway_lower {n d codegCap : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {v : Vertex n}
    (hZ : Z ∈ allEdges n)
    (hdegree : d ≤ vertexDegree H v - 3 * codegCap)
    (hcodeg : ∀ z ∈ Z, vertexCodegree H v z ≤ codegCap) :
    d ≤ vertexDegree (inducedAway H Z) v := by
  have hsum : ∑ z ∈ Z, vertexCodegree H v z ≤ 3 * codegCap := by
    calc
      ∑ z ∈ Z, vertexCodegree H v z ≤ ∑ _z ∈ Z, codegCap :=
        Finset.sum_le_sum hcodeg
      _ = 3 * codegCap := by simp [mem_allEdges.mp hZ]
  have htotal := vertexDegree_inducedAway_add_codegrees_ge H Z v
  omega

lemma vertexDegree_inducedAway_le {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (v : Vertex n) :
    vertexDegree (inducedAway H Z) v ≤ vertexDegree H v := by
  exact vertexDegree_mono (Finset.filter_subset _ _) v

lemma vertexCodegree_inducedAway_le {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (u v : Vertex n) :
    vertexCodegree (inducedAway H Z) u v ≤ vertexCodegree H u v := by
  unfold vertexCodegree
  apply Finset.card_le_card
  intro A hA
  rcases Finset.mem_filter.mp hA with ⟨hAG, huA, hvA⟩
  exact Finset.mem_filter.mpr ⟨(mem_inducedAway.mp hAG).1, huA, hvA⟩

lemma card_meetingPart_le_sum_degrees {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) :
    (meetingPart H Z).card ≤ ∑ z ∈ Z, vertexDegree H z := by
  let C : Vertex n → Finset (Edge n) := fun z ↦
    H.filter fun A ↦ z ∈ A
  have hsub : meetingPart H Z ⊆ Z.biUnion C := by
    intro A hA
    rcases mem_meetingPart.mp hA with ⟨hAH, hnot⟩
    obtain ⟨z, hzA, hzZ⟩ := Finset.not_disjoint_iff.mp hnot
    exact Finset.mem_biUnion.mpr
      ⟨z, hzZ, Finset.mem_filter.mpr ⟨hAH, hzA⟩⟩
  calc
    (meetingPart H Z).card ≤ (Z.biUnion C).card := Finset.card_le_card hsub
    _ ≤ ∑ z ∈ Z, (C z).card := Finset.card_biUnion_le
    _ = ∑ z ∈ Z, vertexDegree H z := by rfl

lemma card_reindexGraphAway_lower {n M D : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} (hZ : Z ∈ allEdges n)
    (hHcard : H.card = M) (hdegree : ∀ z ∈ Z, vertexDegree H z ≤ D) :
    M - 3 * D ≤ (reindexGraphAway H Z hZ).card := by
  have hmeet := card_meetingPart_le_sum_degrees H Z
  have hsum : ∑ z ∈ Z, vertexDegree H z ≤ 3 * D := by
    calc
      ∑ z ∈ Z, vertexDegree H z ≤ ∑ _z ∈ Z, D :=
        Finset.sum_le_sum hdegree
      _ = 3 * D := by simp [mem_allEdges.mp hZ]
  rw [card_reindexGraphAway]
  have hpartition := card_inducedAway_add_card_meetingPart H Z
  omega

lemma reindexGraphAway_refined_degree_codegree_package
    {n M d D codegCap : ℕ} {a B : ℝ}
    {H : Finset (Edge n)} {Z : Edge n}
    (hn : 2 ≤ n) (hH : H ∈ sample n M) (hZ : Z ∈ allEdges n)
    (ha0 : 0 ≤ a) (hB0 : 0 ≤ B)
    (hdegreeLower : ∀ v : Vertex n,
      d ≤ vertexDegree H v - 3 * codegCap)
    (hdegreeUpper : ∀ v : Vertex n, vertexDegree H v ≤ D)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap)
    (ha : a * ((M : ℝ) / ((n - 1 : ℕ) : ℝ)) ≤ d)
    (hB : (D : ℝ) ≤ B *
      (((M - 3 * D : ℕ) : ℝ) / ((n - 1 : ℕ) : ℝ)))
    (hpm : HasPerfectMatching (n - 1) (reindexGraphAway H Z hZ)) :
    CoarseRegularPerfect (n - 1) (reindexGraphAway H Z hZ).card a B
      (reindexGraphAway H Z hZ) ∧
      ∀ u v : Vertex (n - 1), u ≠ v →
        vertexCodegree (reindexGraphAway H Z hZ) u v ≤ codegCap := by
  rcases mem_sample.mp hH with ⟨hHall, hHcard⟩
  let J := reindexGraphAway H Z hZ
  have hJall : J ⊆ allEdges (n - 1) :=
    reindexGraphAway_subset_allEdges hZ hHall
  have hJcardUpper : J.card ≤ M := by
    rw [card_reindexGraphAway, ← hHcard]
    exact Finset.card_filter_le _ _
  have hJcardLower : M - 3 * D ≤ J.card :=
    card_reindexGraphAway_lower hZ hHcard
      (fun z hz ↦ hdegreeUpper z)
  have hnR : (0 : ℝ) < (n - 1 : ℕ) := by exact_mod_cast (by omega)
  refine ⟨⟨mem_sample.mpr ⟨hJall, rfl⟩, hpm, ?_⟩, ?_⟩
  · intro w
    let v : Vertex n := ((outsideVertexEquiv Z hZ).symm w).1
    have hvZ : v ∉ Z := ((outsideVertexEquiv Z hZ).symm w).2
    have hvLower : d ≤ vertexDegree (inducedAway H Z) v :=
      vertexDegree_inducedAway_lower hZ (hdegreeLower v)
        (fun z hz ↦ hcodeg v z (fun hvz ↦ hvZ (hvz ▸ hz)))
    have hvUpper : vertexDegree (inducedAway H Z) v ≤ D :=
      (vertexDegree_inducedAway_le H Z v).trans (hdegreeUpper v)
    rw [vertexDegree_reindexGraphAway]
    constructor
    · have hscale : a * ((J.card : ℝ) / ((n - 1 : ℕ) : ℝ)) ≤
          a * ((M : ℝ) / ((n - 1 : ℕ) : ℝ)) := by
        have hcast : (J.card : ℝ) ≤ M := by exact_mod_cast hJcardUpper
        have hdiv := div_le_div_of_nonneg_right hcast hnR.le
        exact mul_le_mul_of_nonneg_left hdiv ha0
      have hvLowerR : (d : ℝ) ≤ vertexDegree (inducedAway H Z) v := by
        exact_mod_cast hvLower
      simpa only [J] using hscale.trans (ha.trans hvLowerR)
    · have hscale : B *
          (((M - 3 * D : ℕ) : ℝ) / ((n - 1 : ℕ) : ℝ)) ≤
          B * ((J.card : ℝ) / ((n - 1 : ℕ) : ℝ)) := by
        have hcast : ((M - 3 * D : ℕ) : ℝ) ≤ J.card := by
          exact_mod_cast hJcardLower
        have hdiv := div_le_div_of_nonneg_right hcast hnR.le
        exact mul_le_mul_of_nonneg_left hdiv hB0
      have hvUpperR : (vertexDegree (inducedAway H Z) v : ℝ) ≤ D := by
        exact_mod_cast hvUpper
      simpa only [J] using hvUpperR.trans (hB.trans hscale)
  · intro u v huv
    rw [vertexCodegree_reindexGraphAway]
    exact (vertexCodegree_inducedAway_le H Z _ _).trans
      (hcodeg _ _ (fun huv' ↦ huv
        ((outsideVertexEquiv Z hZ).symm.injective (Subtype.ext huv'))))


lemma matchingWeightTarget_le_max_completionWeight {n : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    (hH : H ⊆ allEdges n) (hHcard : 0 < H.card)
    (hmax : ∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀) :
    matchingWeightTarget n H ≤ completionWeight H Z₀ := by
  have hpoint : ∀ A ∈ H,
      (matchingWeight H A : ℝ) ≤ completionWeight H Z₀ := by
    intro A hAH
    rw [← completionWeight_eq_matchingWeight_of_mem H hAH]
    exact_mod_cast hmax A (hH hAH)
  have hsum := Finset.sum_le_sum hpoint
  have hcardR : (0 : ℝ) < H.card := by exact_mod_cast hHcard
  rw [show ∑ _A ∈ H, (completionWeight H Z₀ : ℝ) =
      H.card * completionWeight H Z₀ by simp] at hsum
  rw [← average_matchingWeight_eq_target n H]
  apply (div_le_iff₀ hcardR).2
  simpa [mul_comm] using hsum

lemma matchingWeightTarget_le_max_completionWeight_of_sample {n M : ℕ}
    {H : Finset (Edge n)} {Z₀ : Edge n}
    (hM : 0 < M) (hH : H ∈ sample n M)
    (hmax : ∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀) :
    matchingWeightTarget n H ≤ completionWeight H Z₀ := by
  rcases mem_sample.mp hH with ⟨hHall, hHcard⟩
  exact matchingWeightTarget_le_max_completionWeight hHall
    (by omega) hmax

lemma card_perfectMatchings_reindexGraphAway {n : ℕ}
    (hn : 0 < n) (H : Finset (Edge n)) {Z : Edge n}
    (hZ : Z ∈ allEdges n) :
    (perfectMatchings (n - 1) (reindexGraphAway H Z hZ)).card =
      completionWeight H Z := by
  rw [← card_completionMatchings_eq_card_perfectMatchings_reindexAway]
  exact (completionWeight_eq_card_completionMatchings H Z hn hZ).symm

lemma kahnCountLower_reindexGraphAway_of_weightLower
    {n M : ℕ} {H : Finset (Edge n)} {Z : Edge n}
    {c C₀ C₁ : ℝ}
    (hn : 2 ≤ n) (hM : 0 < M) (hH : H ∈ sample n M)
    (hZ : Z ∈ allEdges n)
    (hc : 0 < c) (hPhi : (perfectMatchings n H).card ≠ 0)
    (hcount : KahnCountLower H C₀)
    (hweight : c^2 * matchingWeightTarget n H ≤
      (completionWeight H Z : ℝ))
    (hbudget :
      ((n - 1 : ℕ) : ℝ) *
            Real.log (((reindexGraphAway H Z hZ).card : ℝ) / (n - 1 : ℕ)) -
          2 * ((n - 1 : ℕ) : ℝ) - C₁ * ((n - 1 : ℕ) : ℝ) ≤
        ((n : ℝ) * Real.log ((M : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ)) +
          Real.log (c^2 * (n : ℝ) / M)) :
    KahnCountLower (reindexGraphAway H Z hZ) C₁ := by
  rcases mem_sample.mp hH with ⟨hHall, hHcard⟩
  have hnR : (0 : ℝ) < n := by positivity
  have hMR : (0 : ℝ) < M := by exact_mod_cast hM
  have hc2 : 0 < c^2 := sq_pos_of_pos hc
  have hPhiR : (0 : ℝ) < (perfectMatchings n H).card := by
    exact_mod_cast Nat.pos_of_ne_zero hPhi
  let f : ℝ := c^2 * (n : ℝ) / M
  have hf : 0 < f := by dsimp [f]; positivity
  have hweight' : f * ((perfectMatchings n H).card : ℝ) ≤
      (completionWeight H Z : ℝ) := by
    unfold matchingWeightTarget at hweight
    rw [hHcard] at hweight
    dsimp only [f]
    convert hweight using 1 <;> ring
  have hwpos : (0 : ℝ) < completionWeight H Z :=
    lt_of_lt_of_le (mul_pos hf hPhiR) hweight'
  have hlogWeight :
      Real.log f + Real.log ((perfectMatchings n H).card : ℝ) ≤
        Real.log (completionWeight H Z : ℝ) := by
    rw [← Real.log_mul hf.ne' hPhiR.ne']
    exact Real.strictMonoOn_log.monotoneOn (mul_pos hf hPhiR) hwpos hweight'
  have hcount' :
      (n : ℝ) * Real.log ((M : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ) ≤
        Real.log ((perfectMatchings n H).card : ℝ) := by
    unfold KahnCountLower at hcount
    rw [hHcard] at hcount
    exact hcount
  have hlower :
      ((n : ℝ) * Real.log ((M : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ)) + Real.log f ≤
        Real.log (completionWeight H Z : ℝ) := by
    calc
      ((n : ℝ) * Real.log ((M : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ)) + Real.log f ≤
        Real.log ((perfectMatchings n H).card : ℝ) + Real.log f :=
          add_le_add hcount' le_rfl
      _ = Real.log f + Real.log ((perfectMatchings n H).card : ℝ) :=
        add_comm _ _
      _ ≤ Real.log (completionWeight H Z : ℝ) := hlogWeight
  unfold KahnCountLower
  rw [card_perfectMatchings_reindexGraphAway (by omega) H hZ]
  exact hbudget.trans (by simpa only [f, add_comm] using hlower)

lemma refinedInsertion_globalLower_failure_probability_le
    {n M codegCap : ℕ} {a B C₀ sigma E delta eta etaGlobal r : ℝ}
    (hn : 3 ≤ n) (hM : 0 < M) (hnM : n ≤ M)
    (hMtop : M < (allEdges n).card)
    (ha0 : 0 < a) (ha2 : a ≤ 2) (hB0 : 0 ≤ B)
    (hC0 : 0 ≤ C₀ + 1) (hsigma : 0 < sigma)
    (hratio :
      1 < ((3 * (M + 1) : ℕ) : ℝ) * sigma /
        ((18 * n * (codegCap + 1) : ℕ) : ℝ))
    (hE :
      (3 * n : ℝ) * Real.sqrt sigma +
          (3 * n : ℝ) * (C₀ + 1 + 14 + Real.log 2) /
            Real.log (((3 * (M + 1) : ℕ) : ℝ) * sigma /
              ((18 * n * (codegCap + 1) : ℕ) : ℝ)) ≤ E)
    (heta : 0 ≤ eta) (hgap : 2 / a < delta)
    (hentropyBudget :
      (3 * n : ℝ) *
          (4 * (3 * (C₀ + 1) * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤
        (eta * (delta - 2 / a) * (n : ℝ))^2)
    (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (hr : 0 < r)
    (hglobalBudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card) :
    finsetProbability (sample n M)
        (fun H ↦ RefinedInsertionGood n M a B codegCap C₀ H ∧
          ¬ GlobalLowerWeightSpread n H
            ((1 - delta) * (M : ℝ) / (M + 1)) etaGlobal) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  apply good_globalLower_failure_probability_le
    hM hMtop hdelta0 hdelta1 heta hr hglobalBudget
  · intro H hGood
    exact refinedInsertionGood_hasPerfectMatching hGood
  · intro H hHs hGood Z hZ
    exact refinedInsertionGood_presentWeightSpread hn hM hnM ha0 ha2 hB0
      hC0 hsigma hratio hE heta hgap hentropyBudget hGood hZ

lemma completionWeight_pos_of_matchingWeightTarget_lower
    {n : ℕ} {H : Finset (Edge n)} {Z : Edge n} {c : ℝ}
    (hn : 0 < n) (hHcard : 0 < H.card)
    (hPhi : (perfectMatchings n H).card ≠ 0) (hc : 0 < c)
    (hweight : c^2 * matchingWeightTarget n H ≤
      (completionWeight H Z : ℝ)) :
    0 < completionWeight H Z := by
  have htarget : 0 < matchingWeightTarget n H := by
    unfold matchingWeightTarget
    positivity
  have hleft : 0 < c^2 * matchingWeightTarget n H :=
    mul_pos (sq_pos_of_pos hc) htarget
  have hreal : (0 : ℝ) < completionWeight H Z := hleft.trans_le hweight
  exact_mod_cast hreal

lemma hasPerfectMatching_reindexGraphAway_of_weightLower
    {n : ℕ} {H : Finset (Edge n)} {Z : Edge n} {c : ℝ}
    (hn : 2 ≤ n) (hHcard : 0 < H.card)
    (hZ : Z ∈ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (hc : 0 < c)
    (hweight : c^2 * matchingWeightTarget n H ≤
      (completionWeight H Z : ℝ)) :
    HasPerfectMatching (n - 1) (reindexGraphAway H Z hZ) := by
  apply hasPerfectMatching_iff_perfectMatchings_nonempty.mpr
  apply Finset.card_pos.mp
  rw [card_perfectMatchings_reindexGraphAway (by omega) H hZ]
  exact completionWeight_pos_of_matchingWeightTarget_lower
    (by omega) hHcard hPhi hc hweight

lemma reindexGraphAway_refinedInsertionGood_of_weightLower
    {n M d D codegCap : ℕ} {a B c C₀ C₁ : ℝ}
    {H : Finset (Edge n)} {Z : Edge n}
    (hn : 2 ≤ n) (hM : 0 < M) (hH : H ∈ sample n M)
    (hZ : Z ∈ allEdges n)
    (ha0 : 0 ≤ a) (hB0 : 0 ≤ B) (hc : 0 < c)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (hcount : KahnCountLower H C₀)
    (hweight : c^2 * matchingWeightTarget n H ≤
      (completionWeight H Z : ℝ))
    (hdegreeLower : ∀ v : Vertex n,
      d ≤ vertexDegree H v - 3 * codegCap)
    (hdegreeUpper : ∀ v : Vertex n, vertexDegree H v ≤ D)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap)
    (ha : a * ((M : ℝ) / ((n - 1 : ℕ) : ℝ)) ≤ d)
    (hB : (D : ℝ) ≤ B *
      (((M - 3 * D : ℕ) : ℝ) / ((n - 1 : ℕ) : ℝ)))
    (hcountBudget :
      ((n - 1 : ℕ) : ℝ) *
            Real.log (((reindexGraphAway H Z hZ).card : ℝ) / (n - 1 : ℕ)) -
          2 * ((n - 1 : ℕ) : ℝ) - C₁ * ((n - 1 : ℕ) : ℝ) ≤
        ((n : ℝ) * Real.log ((M : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ)) +
          Real.log (c^2 * (n : ℝ) / M)) :
    RefinedInsertionGood (n - 1) (reindexGraphAway H Z hZ).card
      a B codegCap C₁ (reindexGraphAway H Z hZ) := by
  have hHcard : H.card = M := (mem_sample.mp hH).2
  have hpm : HasPerfectMatching (n - 1) (reindexGraphAway H Z hZ) :=
    hasPerfectMatching_reindexGraphAway_of_weightLower hn (by omega)
      hZ hPhi hc hweight
  have hpackage := reindexGraphAway_refined_degree_codegree_package
    hn hH hZ ha0 hB0 hdegreeLower hdegreeUpper hcodeg ha hB hpm
  refine ⟨hpackage.1, ?_, ?_⟩
  · exact kahnCountLower_reindexGraphAway_of_weightLower
      hn hM hH hZ hc hPhi hcount hweight hcountBudget
  · intro u v huv
    exact hpackage.2 u v huv

lemma high_from_max_completionWeight {n M : ℕ}
    {H : Finset (Edge n)} {Z₀ Z : Edge n} {c : ℝ}
    (hM : 0 < M) (hH : H ∈ sample n M)
    (hmax : ∀ U ∈ allEdges n,
      completionWeight H U ≤ completionWeight H Z₀)
    (hc : 0 ≤ c)
    (hhigh : c^2 * (completionWeight H Z₀ : ℝ) ≤
      completionWeight H Z) :
    c^2 * matchingWeightTarget n H ≤ completionWeight H Z := by
  have htarget := matchingWeightTarget_le_max_completionWeight_of_sample
    hM hH hmax
  exact (mul_le_mul_of_nonneg_left htarget (sq_nonneg c)).trans hhigh

/-- Coordinate-transfer regularity only for triples above the threshold
generated by a fixed maximum-weight triple. -/
def CoordinateTransferRegularAwayAboveMax (n : ℕ)
    (H : Finset (Edge n)) (c : ℝ)
    (d D codegCap Q b B e₁ : ℕ) : Prop :=
  H ⊆ allEdges n ∧
  (∀ v : Vertex n, d ≤ vertexDegree H v - 3 * codegCap) ∧
  (∀ v : Vertex n, vertexDegree H v ≤ D) ∧
  (∀ u v : Vertex n, u ≠ v → vertexCodegree H u v ≤ codegCap) ∧
  ∃ Z₀ ∈ allEdges n,
    (∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀) ∧
    (∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤ completionWeight H Z →
        (residualBadTriplesAway n (inducedAway H Z) Z
          (residualTransferCutoff Z c d b
            (inducedAway H Z))).card ≤ B) ∧
    (∀ Z ∈ allEdges n, ∀ x ∈ Z,
      (coordinateLinkTailVertices Z x
        (residualTransferCutoff Z c d b (inducedAway H Z))
        d D Q (b + 1) H).card ≤ e₁)

lemma maximumWeightDominated_of_coordinateTransferRegularAwayAboveMax
    {n d D codegCap Q b B e₀ e₁ : ℕ}
    {H : Finset (Edge n)} {c : ℝ}
    (hn : 2 ≤ n) (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (hdb : b < d) (hB : 3 * B ≤ e₀ * (Q + 1))
    (he : 2 * (e₀ + e₁) + 12 ≤ n)
    (hreg : CoordinateTransferRegularAwayAboveMax
      n H c d D codegCap Q b B e₁) :
    MaximumWeightDominated n H
      (((n / 2 : ℕ) : ℝ)^3 / (allEdges n).card) (c^3) := by
  rcases hreg with ⟨hHall, hdegLower, hdegUpper, hcodeg,
    Z₀, hZ₀, hmax, hresidual, htail⟩
  have hn0 : 0 < n := by omega
  let a : Edge n → ℝ := fun Z ↦
    residualTransferCutoff Z c d b (inducedAway H Z)
  have ha : ∀ Z ∈ allEdges n, 0 ≤ a Z := by
    intro Z hZ
    dsimp only [a, residualTransferCutoff]
    positivity
  have hfailure : ∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤
          (completionWeight H Z : ℝ) →
        ∀ x ∈ Z,
          (coordinateLinkFailureVertices n H Z x d b (a Z)).card ≤
            e₀ + e₁ := by
    intro Z hZ hs x hx
    have hrange : CoordinateLinksInRange H Z x d D :=
      coordinateLinksInRange_of_degree_codegree hHall hZ hx
        (hdegLower x) (hdegUpper x) hcodeg
    have htail' :
        (coordinateLinkTailVertices Z x (a Z) d D Q (b + 1) H).card ≤ e₁ := by
      exact htail Z hZ x hx
    exact coordinateLinkFailureVertices_card_le_of_away hrange
      (hresidual Z hZ hs) hB htail'
  have hbudget : ∀ Z ∈ allEdges n,
      c^2 * (completionWeight H Z₀ : ℝ) ≤
          (completionWeight H Z : ℝ) →
        c * (completionWeight H Z : ℝ) ≤
          (((d - b : ℕ) : ℝ) * a Z) := by
    intro Z hZ hs
    dsimp only [a]
    rw [residualTransferCutoff_inducedAway (H := H) (Z := Z) hn0 hZ]
    have hdb0 : (0 : ℝ) < (d - b : ℕ) := by
      exact_mod_cast Nat.sub_pos_of_lt hdb
    field_simp [hdb0.ne']
    exact le_rfl
  have htransfer : CoordinateTransferAbove n H
      (c^2 * (completionWeight H Z₀ : ℝ)) c (e₀ + e₁) :=
    coordinateTransferAbove_of_variable_linkFailures a hn ha hfailure hbudget
  exact maximumWeightDominated_of_max_transfer hn0 hZ₀ hmax hc0 hc1
    htransfer he

def GlobalLowerWeightSpreadFailure (n : ℕ) (L eta : ℝ)
    (H : Finset (Edge n)) : Prop :=
  ¬ GlobalLowerWeightSpread n H L eta

def HighResidualLowerSpread (n : ℕ) (H : Finset (Edge n))
    (c L eta : ℝ) : Prop :=
  ∃ Z₀ ∈ allEdges n,
    (∀ Z ∈ allEdges n,
      completionWeight H Z ≤ completionWeight H Z₀) ∧
    ∀ (Z : Edge n) (hZ : Z ∈ allEdges n),
      c^2 * (completionWeight H Z₀ : ℝ) ≤ completionWeight H Z →
        GlobalLowerWeightSpread (n - 1)
          (reindexGraphAway H Z hZ) L eta

lemma coordinateTransferRegularAwayAboveMax_of_residualSpread
    {n M d D codegCap Q b B e₁ : ℕ}
    {H : Finset (Edge n)} {c L eta : ℝ}
    (hn : 2 ≤ n) (hH : H ∈ sample n M)
    (hdegreeLower : ∀ v : Vertex n,
      d ≤ vertexDegree H v - 3 * codegCap)
    (hdegreeUpper : ∀ v : Vertex n, vertexDegree H v ≤ D)
    (hcodeg : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree H u v ≤ codegCap)
    (hdb : b < d)
    (hJpos : ∀ (Z : Edge n) (hZ : Z ∈ allEdges n),
      0 < (reindexGraphAway H Z hZ).card)
    (hspread : HighResidualLowerSpread n H c L eta)
    (hcutoff : ∀ (Z : Edge n) (hZ : Z ∈ allEdges n),
      c * ((reindexGraphAway H Z hZ).card : ℝ) ≤
        L * ((d - b : ℕ) : ℝ) * ((n - 1 : ℕ) : ℝ))
    (hbadBudget : eta * (allEdges (n - 1)).card ≤ B)
    (htail : ∀ Z ∈ allEdges n, ∀ x ∈ Z,
      (coordinateLinkTailVertices Z x
        (residualTransferCutoff Z c d b (inducedAway H Z))
        d D Q (b + 1) H).card ≤ e₁) :
    CoordinateTransferRegularAwayAboveMax
      n H c d D codegCap Q b B e₁ := by
  rcases mem_sample.mp hH with ⟨hHall, hHcard⟩
  rcases hspread with ⟨Z₀, hZ₀, hmax, hspread⟩
  refine ⟨hHall, hdegreeLower, hdegreeUpper, hcodeg,
    Z₀, hZ₀, hmax, ?_, htail⟩
  intro Z hZ hhigh
  apply residualBadTriplesAway_card_le_of_globalLowerWeightSpread_reindexAway
    hn H hZ
      (residualTransferCutoff Z c d b (inducedAway H Z)) L eta
  · rw [residualTransferCutoff_inducedAway
      (H := H) (Z := Z) (by omega) hZ]
    unfold matchingWeightTarget
    rw [card_perfectMatchings_reindexGraphAway (by omega) H hZ]
    have hdbR : (0 : ℝ) < (d - b : ℕ) := by
      exact_mod_cast Nat.sub_pos_of_lt hdb
    have hJ : (0 : ℝ) < (reindexGraphAway H Z hZ).card := by
      exact_mod_cast hJpos Z hZ
    apply (div_le_iff₀ hdbR).2
    rw [show L *
          ((completionWeight H Z : ℝ) * ((n - 1 : ℕ) : ℝ) /
            (reindexGraphAway H Z hZ).card) * ((d - b : ℕ) : ℝ) =
        (L * (completionWeight H Z : ℝ) * ((n - 1 : ℕ) : ℝ) *
          ((d - b : ℕ) : ℝ)) /
            (reindexGraphAway H Z hZ).card by ring]
    apply (le_div_iff₀ hJ).2
    have hc := hcutoff Z hZ
    have hw0 : (0 : ℝ) ≤ completionWeight H Z := by positivity
    nlinarith [mul_le_mul_of_nonneg_right hc hw0]
  · exact hspread Z hZ hhigh
  · exact hbadBudget

lemma exists_bad_reindex_of_not_highResidualLowerSpread
    {n : ℕ} {H : Finset (Edge n)} {c L eta : ℝ}
    (hn : 0 < n) (hfail : ¬ HighResidualLowerSpread n H c L eta) :
    ∃ Z : ↥(allEdges n),
      GlobalLowerWeightSpreadFailure (n - 1) L eta
        (reindexGraphAway H Z.1 Z.2) := by
  obtain ⟨Z₀, hZ₀, hmax⟩ := exists_max_completionWeight H hn
  by_contra hnone
  apply hfail
  refine ⟨Z₀, hZ₀, hmax, ?_⟩
  intro Z hZ hhigh
  by_contra hbad
  apply hnone
  exact ⟨⟨Z, hZ⟩, hbad⟩

lemma highResidualLowerSpread_failure_probability_le
    {n M : ℕ} {c L eta delta : ℝ}
    (hn : 0 < n) (hM : M ≤ (allEdges n).card)
    (hlayer : ∀ k ≤ M,
      finsetProbability (sample (n - 1) k)
        (fun J ↦ ¬ GlobalLowerWeightSpread (n - 1) J L eta) ≤ delta) :
    finsetProbability (sample n M)
        (fun H ↦ ¬ HighResidualLowerSpread n H c L eta) ≤
      (allEdges n).card * delta := by
  let P : Finset (Edge (n - 1)) → Prop :=
    GlobalLowerWeightSpreadFailure (n - 1) L eta
  have hP : ∀ k ≤ M,
      finsetProbability (sample (n - 1) k) P ≤ delta := by
    intro k hk
    calc
      finsetProbability (sample (n - 1) k) P =
          finsetProbability (sample (n - 1) k)
            (fun J ↦ ¬ GlobalLowerWeightSpread (n - 1) J L eta) := by
              apply finsetProbability_congr_event
              intro J hJ
              rfl
      _ ≤ delta := hlayer k hk
  calc
    finsetProbability (sample n M)
        (fun H ↦ ¬ HighResidualLowerSpread n H c L eta) ≤
      finsetProbability (sample n M)
        (fun H ↦ ∃ Z : ↥(allEdges n),
          P (reindexGraphAway H Z.1 Z.2)) := by
        apply finsetProbability_mono_event
        intro H hHs hfail
        exact exists_bad_reindex_of_not_highResidualLowerSpread hn hfail
    _ ≤ (allEdges n).card * delta := by
      exact some_reindexGraphAway_failure_probability_le
        (n := n) (M := M) P delta hM hP

/-- The exact two-sided, fixed-edge probability formulation of the resolved
problem. -/
def ShamirThresholdResolution : Prop :=
  (∀ ε : ℝ, 0 < ε → ε < 1 →
      Tendsto (fun n ↦ pmProbability n (lowerEdgeCount ε n)) atTop (𝓝 0)) ∧
  (∀ ε : ℝ, 0 < ε →
      Tendsto (fun n ↦ pmProbability n (upperEdgeCount ε n)) atTop (𝓝 1))

attribute [local instance] Classical.propDecidable

def iidCons {α : Type*} {s : Finset α} {t : ℕ}
    (x : ↥s) (ω : IidSample s t) : IidSample s (t + 1) :=
  Fin.cons x ω

def iidFiber {α : Type*} {s : Finset α} {t : ℕ}
    (X : IidSample s (t + 1) → ℝ) (x : ↥s) : IidSample s t → ℝ :=
  fun ω ↦ X (iidCons x ω)

def iidProduct {α : Type*} {s : Finset α} (W : α → ℝ) (t : ℕ)
    (omega : IidSample s t) : ℝ :=
  ∏ i : Fin t, W (omega i).1

lemma finsetAverage_iidProduct {α : Type*} (s : Finset α)
    (W : α → ℝ) (t : ℕ) :
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (iidProduct W t) =
      (finsetAverage s W)^t := by
  have hnum :
      ∑ omega : IidSample s t, iidProduct W t omega =
        (∑ x : ↥s, W x.1)^t := by
    calc
      ∑ omega : IidSample s t, iidProduct W t omega =
          ∏ _i : Fin t, ∑ x : ↥s, W x.1 := by
        unfold iidProduct
        rw [Fintype.prod_sum]
      _ = (∑ x : ↥s, W x.1)^t := by simp
  unfold finsetAverage
  rw [show ∑ omega ∈ (Finset.univ : Finset (IidSample s t)),
      iidProduct W t omega =
        ∑ omega : IidSample s t, iidProduct W t omega by simp,
    hnum]
  have hcard : (Finset.univ : Finset (IidSample s t)).card =
      s.card^t := by simp [Fintype.card_fun]
  rw [hcard, div_pow]
  congr 1
  · rw [Finset.univ_eq_attach s, Finset.sum_attach]
  · norm_cast

lemma finsetAverage_iid_succ {α : Type*} (s : Finset α) (t : ℕ)
    (X : IidSample s (t + 1) → ℝ) :
    finsetAverage (Finset.univ : Finset (IidSample s (t + 1))) X =
      finsetAverage (Finset.univ : Finset ↥s) (fun x ↦
        finsetAverage (Finset.univ : Finset (IidSample s t))
          (iidFiber X x)) := by
  unfold finsetAverage
  have hsum :
      ∑ ω : IidSample s (t + 1), X ω =
        ∑ x : ↥s, ∑ ω : IidSample s t, X (iidCons x ω) := by
    calc
      ∑ ω : IidSample s (t + 1), X ω =
          ∑ p : ↥s × IidSample s t,
            X ((Fin.consEquiv (fun _ : Fin (t + 1) ↦ ↥s)) p) := by
        exact (Equiv.sum_comp
          (Fin.consEquiv (fun _ : Fin (t + 1) ↦ ↥s)) X).symm
      _ = ∑ x : ↥s, ∑ ω : IidSample s t, X (iidCons x ω) := by
        rw [Fintype.sum_prod_type]
        rfl
  rw [show ∑ ω ∈ (Finset.univ : Finset (IidSample s (t + 1))), X ω =
      ∑ ω : IidSample s (t + 1), X ω by simp, hsum]
  rw [show ∑ x ∈ (Finset.univ : Finset ↥s),
      ((∑ ω ∈ (Finset.univ : Finset (IidSample s t)),
          iidFiber X x ω) /
        ((Finset.univ : Finset (IidSample s t)).card : ℝ)) =
      ∑ x : ↥s,
        ((∑ ω : IidSample s t, X (iidCons x ω)) /
          ((Finset.univ : Finset (IidSample s t)).card : ℝ)) by
    simp
    rfl]
  rw [← Finset.sum_div]
  rw [show (Finset.univ : Finset ↥s).card = s.card by simp]
  have hcardSucc :
      (Finset.univ : Finset (IidSample s (t + 1))).card =
        s.card * (Finset.univ : Finset (IidSample s t)).card := by
    simp [Fintype.card_fun, pow_succ, mul_comm]
  rw [hcardSucc, Nat.cast_mul]
  ring

def IidDoobControlled {α : Type*} (s : Finset α) (a b : ℝ) :
    (t : ℕ) → (IidSample s t → ℝ) → Prop
  | 0, _ => True
  | t + 1, X =>
      ∃ c : ℝ, ∃ W : ↥s → ℝ,
        (∀ x, 0 ≤ W x) ∧
        (∀ x, W x ≤ b) ∧
        finsetAverage (Finset.univ : Finset ↥s) W ≤ a ∧
        (∀ x,
          finsetAverage (Finset.univ : Finset (IidSample s t))
              (iidFiber X x) = c - W x) ∧
        (∀ x, IidDoobControlled s a b t (iidFiber X x))

lemma finsetAverage_const_sub {α : Type*} (s : Finset α)
    (f : α → ℝ) (c : ℝ) (hs : s.Nonempty) :
    finsetAverage s (fun x ↦ c - f x) = c - finsetAverage s f := by
  have hcard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  unfold finsetAverage
  rw [Finset.sum_sub_distrib, Finset.sum_const]
  simp only [nsmul_eq_mul]
  field_simp [hcard.ne']

lemma finsetAverage_exp_iidDoobCentered_le {α : Type*}
    (s : Finset α) (a b theta : ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (htheta : |theta * b| ≤ 1 / 2) :
    ∀ t (X : IidSample s t → ℝ),
      IidDoobControlled s a b t X →
      finsetAverage (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ Real.exp
            (theta * (X omega -
              finsetAverage (Finset.univ : Finset (IidSample s t)) X))) ≤
        Real.exp (theta^2 * ((t : ℝ) * a) * b) := by
  intro t
  induction t with
  | zero =>
      intro X hcontrolled
      simp [finsetAverage]
  | succ t ih =>
      intro X hcontrolled
      rcases hcontrolled with
        ⟨c, W, hW0, hWb, hWmean, hfiberMean, hfiberControlled⟩
      let U := (Finset.univ : Finset ↥s)
      let Q := (Finset.univ : Finset (IidSample s t))
      let mu : ℝ := finsetAverage U W
      let m : ↥s → ℝ := fun x ↦ finsetAverage Q (iidFiber X x)
      let EX : ℝ := finsetAverage
        (Finset.univ : Finset (IidSample s (t + 1))) X
      have hU : U.Nonempty := by
        dsimp only [U]
        rw [Finset.univ_nonempty_iff]
        exact Set.nonempty_coe_sort.mpr hs
      have hEX : EX = finsetAverage U m := by
        dsimp only [EX, U, m, Q]
        exact finsetAverage_iid_succ s t X
      have hm : ∀ x, m x = c - W x := by
        intro x
        exact hfiberMean x
      have hEXcmu : EX = c - mu := by
        rw [hEX]
        have havg := finsetAverage_const_sub U W c hU
        rw [show m = (fun x ↦ c - W x) by
          funext x
          exact hm x]
        simpa only [mu] using havg
      have hstep :
          finsetAverage U
              (fun x ↦ Real.exp (theta * (m x - EX))) ≤
            Real.exp (theta^2 * a * b) := by
        have hnegtheta : |(-theta) * b| ≤ 1 / 2 := by
          simpa only [neg_mul, abs_neg] using htheta
        have hmgf := finsetAverage_exp_centered_le
          U W a b (-theta) hU hb
          (fun x _ ↦ hW0 x) (fun x _ ↦ hWb x)
          hWmean hnegtheta
        convert hmgf using 1
        · unfold finsetAverage
          congr 1
          apply Finset.sum_congr rfl
          intro x hx
          change Real.exp (theta * (m x - EX)) =
            Real.exp (-theta * (W x - mu))
          rw [hm x, hEXcmu]
          congr 1
          ring
        · ring
      have hfiber : ∀ x,
          finsetAverage Q
              (fun omega ↦ Real.exp
                (theta * (iidFiber X x omega - m x))) ≤
            Real.exp (theta^2 * ((t : ℝ) * a) * b) := by
        intro x
        exact ih (iidFiber X x) (hfiberControlled x)
      have hfactor : ∀ x,
          finsetAverage Q
              (fun omega ↦ Real.exp
                (theta * (iidFiber X x omega - EX))) =
            Real.exp (theta * (m x - EX)) *
              finsetAverage Q
                (fun omega ↦ Real.exp
                  (theta * (iidFiber X x omega - m x))) := by
        intro x
        unfold finsetAverage
        simp_rw [show ∀ omega,
            theta * (iidFiber X x omega - EX) =
              theta * (m x - EX) +
                theta * (iidFiber X x omega - m x) by
          intro omega
          ring, Real.exp_add]
        rw [← Finset.mul_sum]
        ring
      have houter :
          finsetAverage U
              (fun x ↦ finsetAverage Q
                (fun omega ↦ Real.exp
                  (theta * (iidFiber X x omega - EX)))) ≤
            finsetAverage U
              (fun x ↦ Real.exp (theta * (m x - EX)) *
                Real.exp (theta^2 * ((t : ℝ) * a) * b)) := by
        apply finsetAverage_mono
        intro x hx
        rw [hfactor x]
        exact mul_le_mul_of_nonneg_left (hfiber x)
          (Real.exp_pos _).le
      have hdecomp :
          finsetAverage
              (Finset.univ : Finset (IidSample s (t + 1)))
              (fun omega ↦ Real.exp (theta * (X omega - EX))) =
            finsetAverage U
              (fun x ↦ finsetAverage Q
                (fun omega ↦ Real.exp
                  (theta * (iidFiber X x omega - EX)))) := by
        convert finsetAverage_iid_succ s t
            (fun omega ↦ Real.exp (theta * (X omega - EX))) using 1 <;>
          rfl
      rw [show finsetAverage
          (Finset.univ : Finset (IidSample s (t + 1))) X = EX by rfl,
        hdecomp]
      calc
        finsetAverage U
              (fun x ↦ finsetAverage Q
                (fun omega ↦ Real.exp
                  (theta * (iidFiber X x omega - EX)))) ≤
            finsetAverage U
              (fun x ↦ Real.exp (theta * (m x - EX)) *
                Real.exp (theta^2 * ((t : ℝ) * a) * b)) := houter
        _ = finsetAverage U
              (fun x ↦ Real.exp (theta * (m x - EX))) *
                Real.exp (theta^2 * ((t : ℝ) * a) * b) := by
          exact finsetAverage_mul_const U _ _
        _ ≤ Real.exp (theta^2 * a * b) *
                Real.exp (theta^2 * ((t : ℝ) * a) * b) :=
          mul_le_mul_of_nonneg_right hstep (Real.exp_pos _).le
        _ = Real.exp (theta^2 * (((t + 1 : ℕ) : ℝ) * a) * b) := by
          rw [← Real.exp_add]
          congr 1
          push_cast
          ring

lemma iidDoob_upper_tail_le {α : Type*}
    (s : Finset α) (a b theta u : ℝ) (t : ℕ)
    (X : IidSample s t → ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (htheta0 : 0 ≤ theta) (htheta : |theta * b| ≤ 1 / 2)
    (hcontrolled : IidDoobControlled s a b t X) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤ X omega -
          finsetAverage (Finset.univ : Finset (IidSample s t)) X) ≤
      Real.exp (theta^2 * ((t : ℝ) * a) * b - theta * u) := by
  have hs0 := hs
  obtain ⟨x, hx⟩ := hs
  let omega0 : IidSample s t := fun _ ↦ ⟨x, hx⟩
  have hsample :
      (Finset.univ : Finset (IidSample s t)).Nonempty :=
    ⟨omega0, Finset.mem_univ omega0⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (IidSample s t)) X
    (finsetAverage (Finset.univ : Finset (IidSample s t)) X)
    theta u hsample htheta0
  have hmgf := finsetAverage_exp_iidDoobCentered_le
    s a b theta hs0 hb htheta t X hcontrolled
  have hexppos : 0 < Real.exp (theta * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf

lemma iidDoob_lower_tail_le {α : Type*}
    (s : Finset α) (a b theta u : ℝ) (t : ℕ)
    (X : IidSample s t → ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (htheta0 : 0 ≤ theta) (htheta : |theta * b| ≤ 1 / 2)
    (hcontrolled : IidDoobControlled s a b t X) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤
          finsetAverage (Finset.univ : Finset (IidSample s t)) X -
            X omega) ≤
      Real.exp (theta^2 * ((t : ℝ) * a) * b - theta * u) := by
  have hs0 := hs
  obtain ⟨x, hx⟩ := hs
  let omega0 : IidSample s t := fun _ ↦ ⟨x, hx⟩
  have hsample :
      (Finset.univ : Finset (IidSample s t)).Nonempty :=
    ⟨omega0, Finset.mem_univ omega0⟩
  let mu := finsetAverage (Finset.univ : Finset (IidSample s t)) X
  let Y : IidSample s t → ℝ := fun omega ↦ mu - X omega
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (IidSample s t)) Y 0 theta u
    hsample htheta0
  have hnegtheta : |(-theta) * b| ≤ 1 / 2 := by
    simpa only [neg_mul, abs_neg] using htheta
  have hmgf := finsetAverage_exp_iidDoobCentered_le
    s a b (-theta) hs0 hb hnegtheta t X hcontrolled
  have hY : ∀ omega,
      theta * (Y omega - 0) =
        -theta * (X omega - mu) := by
    intro omega
    dsimp only [Y]
    ring
  simp_rw [hY] at hmarkov
  rw [show (-theta)^2 = theta^2 by ring] at hmgf
  have hexppos : 0 < Real.exp (theta * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  have hevent : finsetProbability
      (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤ mu - X omega) =
      finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤ Y omega - 0) := by
    apply finsetProbability_congr_event
    intro omega homega
    dsimp only [Y, mu]
    simp only [sub_zero]
  rw [hevent]
  exact hmarkov.trans hmgf

def iidFamilySurvivors {α : Type*} (F : Finset (Finset α))
    {s : Finset α} (t : ℕ) (omega : IidSample s t) :
    Finset (Finset α) :=
  F.filter fun A ↦ ∀ i : Fin t, (omega i).1 ∉ A

def iidFamilySurvivalCount {α : Type*} (F : Finset (Finset α))
    {s : Finset α} (t : ℕ) (omega : IidSample s t) : ℝ :=
  (iidFamilySurvivors F t omega).card

def familyElementWeight {α : Type*} (F : Finset (Finset α))
    (x : α) : ℝ :=
  ((F.filter fun A ↦ x ∈ A).card : ℕ)

def familyAvoiding {α : Type*} (F : Finset (Finset α))
    (x : α) : Finset (Finset α) :=
  F.filter fun A ↦ x ∉ A

def iidFamilyLoss {α : Type*} (F : Finset (Finset α))
    {s : Finset α} (x : α) (t : ℕ) (omega : IidSample s t) : ℝ :=
  ((iidFamilySurvivors F t omega).filter fun A ↦ x ∈ A).card

def familyAvoidanceFraction {α : Type*} (s : Finset α)
    (A : Finset α) : ℝ :=
  ((s.filter fun x ↦ x ∉ A).card : ℝ) / s.card

lemma iidProduct_avoidanceIndicator {α : Type*} {s : Finset α}
    (A : Finset α) (t : ℕ) (omega : IidSample s t) :
    iidProduct (fun x ↦ if x ∉ A then (1 : ℝ) else 0) t omega =
      if (∀ i : Fin t, (omega i).1 ∉ A) then 1 else 0 := by
  by_cases hall : ∀ i : Fin t, (omega i).1 ∉ A
  · rw [if_pos hall]
    unfold iidProduct
    apply Finset.prod_eq_one
    intro i hi
    simp [hall i]
  · rw [if_neg hall]
    push Not at hall
    rcases hall with ⟨i, hi⟩
    unfold iidProduct
    apply Finset.prod_eq_zero (Finset.mem_univ i)
    simp [hi]

lemma finsetAverage_avoidanceIndicator {α : Type*} (s : Finset α)
    (A : Finset α) :
    finsetAverage s (fun x ↦ if x ∉ A then (1 : ℝ) else 0) =
      familyAvoidanceFraction s A := by
  unfold finsetAverage familyAvoidanceFraction
  rw [Finset.sum_boole]

lemma average_iidFamilySurvivalCount {α : Type*}
    (F : Finset (Finset α)) (s : Finset α) (t : ℕ) :
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (iidFamilySurvivalCount F t) =
      ∑ A ∈ F, (familyAvoidanceFraction s A)^t := by
  let Q := (Finset.univ : Finset (IidSample s t))
  have hpoint : ∀ omega : IidSample s t,
      iidFamilySurvivalCount F t omega =
        ∑ A ∈ F,
          if (∀ i : Fin t, (omega i).1 ∉ A) then 1 else 0 := by
    intro omega
    unfold iidFamilySurvivalCount iidFamilySurvivors
    rw [Finset.sum_boole]
  have hswap :
      ∑ omega ∈ Q, ∑ A ∈ F,
          (if (∀ i : Fin t, (omega i).1 ∉ A) then (1 : ℝ) else 0) =
        ∑ A ∈ F, ∑ omega ∈ Q,
          (if (∀ i : Fin t, (omega i).1 ∉ A) then (1 : ℝ) else 0) := by
    rw [Finset.sum_comm]
  unfold finsetAverage
  simp_rw [hpoint]
  rw [hswap, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro A hAF
  have hprod := finsetAverage_iidProduct s
    (fun x ↦ if x ∉ A then (1 : ℝ) else 0) t
  rw [finsetAverage_avoidanceIndicator] at hprod
  unfold finsetAverage at hprod
  rw [show ∑ omega ∈ Q,
      (if (∀ i : Fin t, (omega i).1 ∉ A) then (1 : ℝ) else 0) =
      ∑ omega ∈ Q,
        iidProduct (fun x ↦ if x ∉ A then (1 : ℝ) else 0) t omega by
    apply Finset.sum_congr rfl
    intro omega homega
    rw [iidProduct_avoidanceIndicator]]
  exact hprod

lemma iidFamilySurvivors_cons {α : Type*} (F : Finset (Finset α))
    {s : Finset α} (x : ↥s) (t : ℕ) (omega : IidSample s t) :
    iidFamilySurvivors F (t + 1) (iidCons x omega) =
      iidFamilySurvivors (familyAvoiding F x.1) t omega := by
  ext A
  simp only [iidFamilySurvivors, familyAvoiding, Finset.mem_filter]
  constructor
  · rintro ⟨hAF, hall⟩
    refine ⟨⟨hAF, ?_⟩, ?_⟩
    · exact hall 0
    · intro i
      exact hall i.succ
  · rintro ⟨⟨hAF, hxA⟩, hall⟩
    refine ⟨hAF, ?_⟩
    intro i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · exact hxA
    · exact hall _

lemma iidFamilySurvivalCount_cons {α : Type*}
    (F : Finset (Finset α)) {s : Finset α} (x : ↥s)
    (t : ℕ) (omega : IidSample s t) :
    iidFamilySurvivalCount F (t + 1) (iidCons x omega) =
      iidFamilySurvivalCount (familyAvoiding F x.1) t omega := by
  unfold iidFamilySurvivalCount
  rw [iidFamilySurvivors_cons]

lemma iidFamilySurvivalCount_eq_avoiding_add_loss {α : Type*}
    (F : Finset (Finset α)) {s : Finset α} (x : α)
    (t : ℕ) (omega : IidSample s t) :
    iidFamilySurvivalCount F t omega =
      iidFamilySurvivalCount (familyAvoiding F x) t omega +
        iidFamilyLoss F x t omega := by
  unfold iidFamilySurvivalCount iidFamilyLoss familyAvoiding
  let S := iidFamilySurvivors F t omega
  have havoid : iidFamilySurvivors (F.filter fun A ↦ x ∉ A) t omega =
      S.filter fun A ↦ x ∉ A := by
    ext A
    simp only [iidFamilySurvivors, S, Finset.mem_filter]
    tauto
  rw [havoid]
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := S) (p := fun A ↦ x ∉ A)
  have hnot : (S.filter fun A ↦ ¬ x ∉ A) =
      S.filter fun A ↦ x ∈ A := by
    ext A
    simp
  rw [hnot] at hsplit
  have hsplitR :
      ((S.filter fun A ↦ x ∉ A).card : ℝ) +
          ((S.filter fun A ↦ x ∈ A).card : ℝ) = S.card := by
    exact_mod_cast hsplit
  dsimp only [S] at hsplitR
  change ((iidFamilySurvivors F t omega).card : ℝ) =
    ((S.filter fun A ↦ x ∉ A).card : ℝ) +
      ((S.filter fun A ↦ x ∈ A).card : ℝ)
  exact hsplitR.symm

lemma familyAvoiding_subset {α : Type*} (F : Finset (Finset α))
    (x : α) : familyAvoiding F x ⊆ F :=
  Finset.filter_subset _ _

lemma iidFamilyLoss_le_familyElementWeight {α : Type*}
    {F₀ G : Finset (Finset α)} (hG : G ⊆ F₀)
    {s : Finset α} (x : α) (t : ℕ) (omega : IidSample s t) :
    iidFamilyLoss G x t omega ≤ familyElementWeight F₀ x := by
  unfold iidFamilyLoss familyElementWeight
  exact_mod_cast Finset.card_le_card (by
    intro A hA
    rcases Finset.mem_filter.mp hA with ⟨hAS, hxA⟩
    exact Finset.mem_filter.mpr
      ⟨hG ((Finset.mem_filter.mp hAS).1), hxA⟩)

lemma finsetAverage_nonneg {α : Type*} (s : Finset α)
    (f : α → ℝ) (hf : ∀ x ∈ s, 0 ≤ f x) :
    0 ≤ finsetAverage s f := by
  unfold finsetAverage
  exact div_nonneg (Finset.sum_nonneg hf) (by positivity)

lemma finsetAverage_le_const {α : Type*} (s : Finset α)
    (f : α → ℝ) (c : ℝ) (hs : s.Nonempty)
    (hf : ∀ x ∈ s, f x ≤ c) :
    finsetAverage s f ≤ c := by
  have hcard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  unfold finsetAverage
  apply (div_le_iff₀ hcard).2
  calc
    ∑ x ∈ s, f x ≤ ∑ _x ∈ s, c := Finset.sum_le_sum hf
    _ = c * (s.card : ℝ) := by simp; ring

lemma finsetAverage_congr_fun {α : Type*} (s : Finset α)
    (f g : α → ℝ) (h : ∀ x ∈ s, f x = g x) :
    finsetAverage s f = finsetAverage s g := by
  unfold finsetAverage
  congr 1
  exact Finset.sum_congr rfl h

lemma iidFamilySurvival_doobControlled {α : Type*}
    (F₀ : Finset (Finset α)) (s : Finset α) (a b : ℝ)
    (hs : s.Nonempty)
    (hmean : finsetAverage (Finset.univ : Finset ↥s)
        (fun x ↦ familyElementWeight F₀ x.1) ≤ a)
    (hcap : ∀ x : ↥s, familyElementWeight F₀ x.1 ≤ b) :
    ∀ t (G : Finset (Finset α)), G ⊆ F₀ →
      IidDoobControlled s a b t (iidFamilySurvivalCount G t) := by
  intro t
  induction t with
  | zero =>
      intro G hG
      trivial
  | succ t ih =>
      intro G hG
      let U := (Finset.univ : Finset ↥s)
      let Q := (Finset.univ : Finset (IidSample s t))
      have hU : U.Nonempty := by
        dsimp only [U]
        rw [Finset.univ_nonempty_iff]
        exact Set.nonempty_coe_sort.mpr hs
      obtain ⟨x₀, hx₀⟩ := hs
      let omega₀ : IidSample s t := fun _ ↦ ⟨x₀, hx₀⟩
      have hQ : Q.Nonempty := by
        exact ⟨omega₀, Finset.mem_univ omega₀⟩
      let c : ℝ := finsetAverage Q (iidFamilySurvivalCount G t)
      let W : ↥s → ℝ := fun x ↦
        finsetAverage Q (iidFamilyLoss G x.1 t)
      refine ⟨c, W, ?_, ?_, ?_, ?_, ?_⟩
      · intro x
        apply finsetAverage_nonneg
        intro omega homega
        unfold iidFamilyLoss
        positivity
      · intro x
        calc
          finsetAverage Q (iidFamilyLoss G x.1 t) ≤
              familyElementWeight F₀ x.1 := by
            apply finsetAverage_le_const Q _ _ hQ
            intro omega homega
            exact iidFamilyLoss_le_familyElementWeight hG x.1 t omega
          _ ≤ b := hcap x
      · calc
          finsetAverage U W ≤
              finsetAverage U
                (fun x ↦ familyElementWeight F₀ x.1) := by
            apply finsetAverage_mono
            intro x hx
            exact finsetAverage_le_const Q _ _ hQ
              (fun omega homega ↦
                iidFamilyLoss_le_familyElementWeight hG x.1 t omega)
          _ ≤ a := hmean
      · intro x
        have hcons :
            iidFiber (iidFamilySurvivalCount G (t + 1)) x =
              iidFamilySurvivalCount (familyAvoiding G x.1) t := by
          funext omega
          exact iidFamilySurvivalCount_cons G x t omega
        rw [hcons]
        have hpoint : ∀ omega ∈ Q,
            iidFamilySurvivalCount G t omega =
              iidFamilySurvivalCount (familyAvoiding G x.1) t omega +
                iidFamilyLoss G x.1 t omega := by
          intro omega homega
          exact iidFamilySurvivalCount_eq_avoiding_add_loss
            G x.1 t omega
        have havg := finsetAverage_congr_fun Q
          (iidFamilySurvivalCount G t)
          (fun omega ↦
            iidFamilySurvivalCount (familyAvoiding G x.1) t omega +
              iidFamilyLoss G x.1 t omega) hpoint
        have hadd : finsetAverage Q
            (fun omega ↦
              iidFamilySurvivalCount (familyAvoiding G x.1) t omega +
                iidFamilyLoss G x.1 t omega) =
            finsetAverage Q
                (iidFamilySurvivalCount (familyAvoiding G x.1) t) +
              finsetAverage Q (iidFamilyLoss G x.1 t) := by
          unfold finsetAverage
          rw [Finset.sum_add_distrib]
          ring
        dsimp only [c, W]
        rw [hadd] at havg
        linarith
      · intro x
        have hcons :
            iidFiber (iidFamilySurvivalCount G (t + 1)) x =
              iidFamilySurvivalCount (familyAvoiding G x.1) t := by
          funext omega
          exact iidFamilySurvivalCount_cons G x t omega
        rw [hcons]
        apply ih (familyAvoiding G x.1)
        exact (familyAvoiding_subset G x.1).trans hG

@[simp] lemma familyElementWeight_completionMatchings {n : ℕ}
    (H : Finset (Edge n)) (Z A : Edge n) :
    familyElementWeight (completionMatchings n H Z) A =
      completionEdgeWeight H Z A := by
  unfold familyElementWeight completionEdgeWeight
  norm_cast
  apply congrArg Finset.card
  apply Finset.ext
  intro F
  simp only [Finset.mem_filter]

lemma iidCompletionSurvival_doobControlled {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (s : Finset (Edge n))
    (a b : ℝ) (hs : s.Nonempty)
    (hmean : finsetAverage (Finset.univ : Finset ↥s)
        (fun A ↦ (completionEdgeWeight H Z A.1 : ℝ)) ≤ a)
    (hcap : ∀ A : ↥s, (completionEdgeWeight H Z A.1 : ℝ) ≤ b) :
    IidDoobControlled s a b t
      (iidFamilySurvivalCount (completionMatchings n H Z) t) := by
  apply iidFamilySurvival_doobControlled
    (completionMatchings n H Z) s a b hs
  · simpa only [familyElementWeight_completionMatchings] using hmean
  · intro A
    simpa only [familyElementWeight_completionMatchings] using hcap A
  · exact Finset.Subset.rfl

lemma iidCompletionSurvival_upper_tail_le {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (s : Finset (Edge n))
    (a b theta u : ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (htheta0 : 0 ≤ theta) (htheta : |theta * b| ≤ 1 / 2)
    (hmean : finsetAverage (Finset.univ : Finset ↥s)
        (fun A ↦ (completionEdgeWeight H Z A.1 : ℝ)) ≤ a)
    (hcap : ∀ A : ↥s, (completionEdgeWeight H Z A.1 : ℝ) ≤ b) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤
          iidFamilySurvivalCount (completionMatchings n H Z) t omega -
            finsetAverage (Finset.univ : Finset (IidSample s t))
              (iidFamilySurvivalCount (completionMatchings n H Z) t)) ≤
      Real.exp (theta^2 * ((t : ℝ) * a) * b - theta * u) := by
  apply iidDoob_upper_tail_le s a b theta u t _ hs hb htheta0 htheta
  exact iidCompletionSurvival_doobControlled H Z s a b hs hmean hcap

lemma iidCompletionSurvival_lower_tail_le {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (s : Finset (Edge n))
    (a b theta u : ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (htheta0 : 0 ≤ theta) (htheta : |theta * b| ≤ 1 / 2)
    (hmean : finsetAverage (Finset.univ : Finset ↥s)
        (fun A ↦ (completionEdgeWeight H Z A.1 : ℝ)) ≤ a)
    (hcap : ∀ A : ↥s, (completionEdgeWeight H Z A.1 : ℝ) ≤ b) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤
          finsetAverage (Finset.univ : Finset (IidSample s t))
              (iidFamilySurvivalCount (completionMatchings n H Z) t) -
            iidFamilySurvivalCount (completionMatchings n H Z) t omega) ≤
      Real.exp (theta^2 * ((t : ℝ) * a) * b - theta * u) := by
  apply iidDoob_lower_tail_le s a b theta u t _ hs hb htheta0 htheta
  exact iidCompletionSurvival_doobControlled H Z s a b hs hmean hcap

lemma thinning_survival_term_bounds {q m x : ℝ} (t : ℕ)
    (hq : 0 < q) (hm : q < m) (hx0 : 0 ≤ x) (hxq : x ≤ q) :
    (1 - q / m)^t ≤ (1 - (q - x) / m)^t ∧
      (1 - (q - x) / m)^t ≤
        Real.exp (-((t : ℝ) * q / m)) + x / q := by
  have hm0 : 0 < m := hq.trans hm
  have hqm1 : q / m ≤ 1 := (div_le_one hm0).2 hm.le
  have hbase0 : 0 ≤ 1 - q / m := sub_nonneg.mpr hqm1
  have hqxle : q - x ≤ q := by linarith
  have hfracmono : (q - x) / m ≤ q / m :=
    div_le_div_of_nonneg_right hqxle hm0.le
  have hbases : 1 - q / m ≤ 1 - (q - x) / m := by linarith
  have hlower := pow_le_pow_left₀ hbase0 hbases t
  refine ⟨hlower, ?_⟩
  have hlinear : 1 - (q - x) / m ≤
      Real.exp (-((q - x) / m)) := by
    have h := Real.add_one_le_exp (-((q - x) / m))
    linarith
  have hbaseX0 : 0 ≤ 1 - (q - x) / m := hbase0.trans hbases
  have hpow := pow_le_pow_left₀ hbaseX0 hlinear t
  have hexppow : (Real.exp (-((q - x) / m)))^t =
      Real.exp (-((t : ℝ) * q / m)) *
        Real.exp ((t : ℝ) * x / m) := by
    rw [← Real.exp_nat_mul, ← Real.exp_add]
    congr 1
    push_cast
    field_simp [hm0.ne']
    ring
  rw [hexppow] at hpow
  have hchord := exp_mul_le_endpoint_chord
    (w := x) (b := q) (θ := (t : ℝ) / m) hq hx0 hxq
  have hE0 : 0 ≤ Real.exp (-((t : ℝ) * q / m)) :=
    (Real.exp_pos _).le
  have hmul := mul_le_mul_of_nonneg_left hchord hE0
  calc
    (1 - (q - x) / m)^t ≤
        Real.exp (-((t : ℝ) * q / m)) *
          Real.exp ((t : ℝ) * x / m) := hpow
    _ ≤ Real.exp (-((t : ℝ) * q / m)) *
          (1 + (x / q) *
            (Real.exp (((t : ℝ) / m) * q) - 1)) := by
      rw [show (t : ℝ) * x / m = ((t : ℝ) / m) * x by ring]
      exact hmul
    _ = Real.exp (-((t : ℝ) * q / m)) +
          (x / q) *
            (1 - Real.exp (-((t : ℝ) * q / m))) := by
      have hcancel : Real.exp (-((t : ℝ) * q / m)) *
          Real.exp (((t : ℝ) / m) * q) = 1 := by
        rw [← Real.exp_add]
        convert Real.exp_zero using 1
        field_simp [hm0.ne']
        ring
      calc
        Real.exp (-((t : ℝ) * q / m)) *
              (1 + (x / q) *
                (Real.exp (((t : ℝ) / m) * q) - 1)) =
            Real.exp (-((t : ℝ) * q / m)) +
              (x / q) *
                (Real.exp (-((t : ℝ) * q / m)) *
                    Real.exp (((t : ℝ) / m) * q) -
                  Real.exp (-((t : ℝ) * q / m))) := by ring
        _ = Real.exp (-((t : ℝ) * q / m)) +
              (x / q) *
                (1 - Real.exp (-((t : ℝ) * q / m))) := by rw [hcancel]
    _ ≤ Real.exp (-((t : ℝ) * q / m)) + x / q := by
      have hexp0 : 0 ≤ Real.exp (-((t : ℝ) * q / m)) :=
        (Real.exp_pos _).le
      have hxq0 : 0 ≤ x / q := div_nonneg hx0 hq.le
      nlinarith

lemma average_iidFamilySurvivalCount_bounds {α : Type*}
    (F : Finset (Finset α)) (s : Finset α) (t : ℕ)
    {q m E : ℝ} (hq : 0 < q) (hm : q < m)
    (x : Finset α → ℝ)
    (hx0 : ∀ A ∈ F, 0 ≤ x A)
    (hxq : ∀ A ∈ F, x A ≤ q)
    (hfrac : ∀ A ∈ F,
      familyAvoidanceFraction s A = 1 - (q - x A) / m)
    (hsum : ∑ A ∈ F, x A ≤ E) :
    ((F.card : ℝ) * (1 - q / m)^t) ≤
      finsetAverage (Finset.univ : Finset (IidSample s t))
        (iidFamilySurvivalCount F t) ∧
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (iidFamilySurvivalCount F t) ≤
      ((F.card : ℝ) * Real.exp (-((t : ℝ) * q / m))) + E / q := by
  rw [average_iidFamilySurvivalCount]
  constructor
  · calc
      (F.card : ℝ) * (1 - q / m)^t =
          ∑ _A ∈ F, (1 - q / m)^t := by simp
      _ ≤ ∑ A ∈ F, (familyAvoidanceFraction s A)^t := by
        apply Finset.sum_le_sum
        intro A hAF
        rw [hfrac A hAF]
        exact (thinning_survival_term_bounds t hq hm
          (hx0 A hAF) (hxq A hAF)).1
  · calc
      ∑ A ∈ F, (familyAvoidanceFraction s A)^t ≤
          ∑ A ∈ F,
            (Real.exp (-((t : ℝ) * q / m)) + x A / q) := by
        apply Finset.sum_le_sum
        intro A hAF
        rw [hfrac A hAF]
        exact (thinning_survival_term_bounds t hq hm
          (hx0 A hAF) (hxq A hAF)).2
      _ = (F.card : ℝ) * Real.exp (-((t : ℝ) * q / m)) +
          (∑ A ∈ F, x A) / q := by
        rw [Finset.sum_add_distrib, Finset.sum_div]
        simp
      _ ≤ (F.card : ℝ) * Real.exp (-((t : ℝ) * q / m)) +
          E / q := by
        gcongr

lemma card_sdiff_filter_mem_add_filter_mem {α : Type*}
    (H B F : Finset α) (hFH : F ⊆ H) :
    ((H \ B).filter fun x ↦ x ∈ F).card +
        (B.filter fun x ↦ x ∈ F).card = F.card := by
  have hnot :
      (H \ B).filter (fun x ↦ x ∈ F) =
        F.filter (fun x ↦ x ∉ B) := by
    ext x
    simp only [Finset.mem_filter, Finset.mem_sdiff]
    constructor
    · rintro ⟨⟨_hxH, hxB⟩, hxF⟩
      exact ⟨hxF, hxB⟩
    · rintro ⟨hxF, hxB⟩
      exact ⟨⟨hFH hxF, hxB⟩, hxF⟩
  have hin :
      B.filter (fun x ↦ x ∈ F) =
        F.filter (fun x ↦ x ∈ B) := by
    ext x
    simp only [Finset.mem_filter]
    tauto
  rw [hnot, hin]
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := F) (p := fun x ↦ x ∈ B)
  simpa only [not_not, Nat.add_comm] using hsplit

lemma familyAvoidanceFraction_eq_one_sub_hits {α : Type*}
    (s A : Finset α) (hs : s.Nonempty) :
    familyAvoidanceFraction s A =
      1 - (((s.filter fun x ↦ x ∈ A).card : ℕ) : ℝ) / s.card := by
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := s) (p := fun x ↦ x ∉ A)
  simp only [not_not] at hsplit
  have hsplitR :
      ((((s.filter fun x ↦ x ∉ A).card : ℕ) : ℝ)) +
          (((s.filter fun x ↦ x ∈ A).card : ℕ) : ℝ) =
        ((s.card : ℕ) : ℝ) := by
    exact_mod_cast hsplit
  have hs0 : (((s.card : ℕ) : ℝ)) ≠ 0 := by
    exact_mod_cast (Finset.card_ne_zero.mpr hs)
  unfold familyAvoidanceFraction
  field_simp [hs0]
  linarith

lemma completion_familyAvoidanceFraction {n : ℕ}
    (H B : Finset (Edge n)) (Z : Edge n)
    (hs : (H \ B).Nonempty) {F : Finset (Edge n)}
    (hF : F ∈ completionMatchings n H Z) :
    familyAvoidanceFraction (H \ B) F =
      1 - (((n - 1 : ℕ) : ℝ) -
        ((B.filter fun A ↦ A ∈ F).card : ℝ)) / (H \ B).card := by
  rw [familyAvoidanceFraction_eq_one_sub_hits (H \ B) F hs]
  congr 2
  apply eq_sub_of_add_eq
  norm_cast
  rw [← (mem_completionMatchings.mp hF).2.1]
  rw [← Finset.card_union_of_disjoint]
  · congr 1
    ext A
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_sdiff]
    constructor
    · rintro (h | h)
      · exact h.2
      · exact h.2
    · intro hAF
      by_cases hAB : A ∈ B
      · exact Or.inr ⟨hAB, hAF⟩
      · exact Or.inl ⟨⟨(mem_completionMatchings.mp hF).1 hAF,
          hAB⟩, hAF⟩
  · rw [Finset.disjoint_left]
    intro A hAl hAr
    simp only [Finset.mem_filter, Finset.mem_sdiff] at hAl hAr
    exact hAl.1.2 hAr.1

lemma sum_completionMatching_heavyIntersection {n : ℕ}
    (H B : Finset (Edge n)) (Z : Edge n) :
    ∑ F ∈ completionMatchings n H Z,
        (((B.filter fun A ↦ A ∈ F).card : ℕ) : ℝ) =
      ∑ A ∈ B, (completionEdgeWeight H Z A : ℝ) := by
  unfold completionEdgeWeight
  calc
    ∑ F ∈ completionMatchings n H Z,
          (((B.filter fun A ↦ A ∈ F).card : ℕ) : ℝ) =
        ∑ F ∈ completionMatchings n H Z,
          ∑ A ∈ B, if A ∈ F then (1 : ℝ) else 0 := by
      apply Finset.sum_congr rfl
      intro F _hF
      rw [Finset.sum_boole (R := ℝ)]
    _ = ∑ A ∈ B, ∑ F ∈ completionMatchings n H Z,
          if A ∈ F then (1 : ℝ) else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ A ∈ B,
          ((((completionMatchings n H Z).filter fun F ↦ A ∈ F).card :
            ℕ) : ℝ) := by
      apply Finset.sum_congr rfl
      intro A _hA
      rw [Finset.sum_boole (R := ℝ)]

lemma average_completionEdgeWeight_pool_le {n : ℕ}
    (H B : Finset (Edge n)) (Z : Edge n)
    (hs : (H \ B).Nonempty) :
    finsetAverage (Finset.univ : Finset ↥(H \ B))
        (fun A ↦ (completionEdgeWeight H Z A.1 : ℝ)) ≤
      ((completionMatchings n H Z).card : ℝ) *
          ((n - 1 : ℕ) : ℝ) / (H \ B).card := by
  rw [show finsetAverage (Finset.univ : Finset ↥(H \ B))
          (fun A ↦ (completionEdgeWeight H Z A.1 : ℝ)) =
        finsetAverage (H \ B)
          (fun A ↦ (completionEdgeWeight H Z A : ℝ)) from
      finsetAverage_attach (H \ B)
        (fun A ↦ (completionEdgeWeight H Z A : ℝ))]
  unfold finsetAverage
  have hsumle :
      ∑ A ∈ H \ B, (completionEdgeWeight H Z A : ℝ) ≤
        ∑ A ∈ H, (completionEdgeWeight H Z A : ℝ) := by
    apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.sdiff_subset)
    intro A _hAH _hAs
    positivity
  have hden0 : (0 : ℝ) ≤ ((H \ B).card : ℕ) := by positivity
  calc
    (∑ A ∈ H \ B, (completionEdgeWeight H Z A : ℝ)) /
          (((H \ B).card : ℕ) : ℝ) ≤
        (∑ A ∈ H, (completionEdgeWeight H Z A : ℝ)) /
          (((H \ B).card : ℕ) : ℝ) :=
      div_le_div_of_nonneg_right hsumle hden0
    _ = ((completionMatchings n H Z).card : ℝ) *
          ((n - 1 : ℕ) : ℝ) / (H \ B).card := by
      rw [sum_completionEdgeWeight]

def completionHeavyEdges {n : ℕ} (H : Finset (Edge n))
    (Z : Edge n) (b : ℝ) : Finset (Edge n) :=
  H.filter fun A ↦ b < (completionEdgeWeight H Z A : ℝ)

@[simp] lemma mem_completionHeavyEdges {n : ℕ}
    {H : Finset (Edge n)} {Z : Edge n} {b : ℝ} {A : Edge n} :
    A ∈ completionHeavyEdges H Z b ↔
      A ∈ H ∧ b < (completionEdgeWeight H Z A : ℝ) := by
  simp [completionHeavyEdges]

lemma completionEdgeWeight_le_of_mem_nonheavy {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (b : ℝ)
    {A : Edge n} (hA : A ∈ H \ completionHeavyEdges H Z b) :
    (completionEdgeWeight H Z A : ℝ) ≤ b := by
  rcases Finset.mem_sdiff.mp hA with ⟨hAH, hAnot⟩
  by_contra h
  exact hAnot (mem_completionHeavyEdges.mpr ⟨hAH, lt_of_not_ge h⟩)

lemma iidCompletionThinning_mean_bounds {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (b E : ℝ)
    (hs : (H \ completionHeavyEdges H Z b).Nonempty)
    (hn : 2 ≤ n)
    (hheavy : ∑ A ∈ completionHeavyEdges H Z b,
        (completionEdgeWeight H Z A : ℝ) ≤ E)
    (hm : ((n - 1 : ℕ) : ℝ) <
      ((H \ completionHeavyEdges H Z b).card : ℝ)) :
    ((completionMatchings n H Z).card : ℝ) *
        (1 - ((n - 1 : ℕ) : ℝ) /
          (H \ completionHeavyEdges H Z b).card)^t ≤
      finsetAverage
        (Finset.univ : Finset
          (IidSample (H \ completionHeavyEdges H Z b) t))
        (iidFamilySurvivalCount (completionMatchings n H Z) t) ∧
    finsetAverage
        (Finset.univ : Finset
          (IidSample (H \ completionHeavyEdges H Z b) t))
        (iidFamilySurvivalCount (completionMatchings n H Z) t) ≤
      ((completionMatchings n H Z).card : ℝ) *
          Real.exp (-((t : ℝ) * ((n - 1 : ℕ) : ℝ) /
            (H \ completionHeavyEdges H Z b).card)) +
        E / ((n - 1 : ℕ) : ℝ) := by
  let B := completionHeavyEdges H Z b
  let q : ℝ := ((n - 1 : ℕ) : ℝ)
  let m : ℝ := ((H \ B).card : ℝ)
  let x : Finset (Edge n) → ℝ := fun F ↦
    (((B.filter fun A ↦ A ∈ F).card : ℕ) : ℝ)
  have hq : 0 < q := by
    dsimp [q]
    exact_mod_cast (by omega : 0 < n - 1)
  have hxm : ∀ F ∈ completionMatchings n H Z, 0 ≤ x F := by
    intro F hF
    dsimp [x]
    positivity
  have hxq : ∀ F ∈ completionMatchings n H Z, x F ≤ q := by
    intro F hF
    dsimp [x, q]
    have hsub : B.filter (fun A ↦ A ∈ F) ⊆ F := by
      intro A hA
      exact (Finset.mem_filter.mp hA).2
    have hc := Finset.card_le_card hsub
    rw [(mem_completionMatchings.mp hF).2.1] at hc
    exact_mod_cast hc
  have hfrac : ∀ F ∈ completionMatchings n H Z,
      familyAvoidanceFraction (H \ B) F = 1 - (q - x F) / m := by
    intro F hF
    simpa only [B, q, m, x] using
      completion_familyAvoidanceFraction H B Z hs hF
  have hsum : ∑ F ∈ completionMatchings n H Z, x F ≤ E := by
    dsimp [x]
    rw [sum_completionMatching_heavyIntersection H B Z]
    exact hheavy
  simpa only [B, q, m] using
    average_iidFamilySurvivalCount_bounds
      (completionMatchings n H Z) (H \ B) t hq hm x
      hxm hxq hfrac hsum

lemma iidCompletionThinning_lower_tail_le {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (b theta u : ℝ)
    (hs : (H \ completionHeavyEdges H Z b).Nonempty)
    (hb : 0 < b) (htheta0 : 0 ≤ theta)
    (htheta : |theta * b| ≤ 1 / 2) :
    finsetProbability
        (Finset.univ : Finset
          (IidSample (H \ completionHeavyEdges H Z b) t))
        (fun omega ↦ u ≤
          finsetAverage
            (Finset.univ : Finset
              (IidSample (H \ completionHeavyEdges H Z b) t))
            (iidFamilySurvivalCount (completionMatchings n H Z) t) -
          iidFamilySurvivalCount (completionMatchings n H Z) t omega) ≤
      Real.exp
        (theta^2 * ((t : ℝ) *
          (((completionMatchings n H Z).card : ℝ) *
            ((n - 1 : ℕ) : ℝ) /
              (H \ completionHeavyEdges H Z b).card)) * b - theta * u) := by
  let s := H \ completionHeavyEdges H Z b
  let a := ((completionMatchings n H Z).card : ℝ) *
    ((n - 1 : ℕ) : ℝ) / s.card
  have hmean : finsetAverage (Finset.univ : Finset ↥s)
      (fun A ↦ (completionEdgeWeight H Z A.1 : ℝ)) ≤ a := by
    exact average_completionEdgeWeight_pool_le H
      (completionHeavyEdges H Z b) Z hs
  have hcap : ∀ A : ↥s,
      (completionEdgeWeight H Z A.1 : ℝ) ≤ b := by
    intro A
    exact completionEdgeWeight_le_of_mem_nonheavy H Z b A.2
  simpa only [s, a] using iidCompletionSurvival_lower_tail_le
    H Z s a b theta u hs hb htheta0 htheta hmean hcap

def embeddingFamilySurvivalCount {α : Type*}
    (F : Finset (Finset α)) {s : Finset α} {t : ℕ}
    (e : Fin t ↪ ↥s) : ℝ :=
  (F.filter fun A ↦ ∀ i : Fin t, (e i).1 ∉ A).card

@[simp] lemma embeddingFamilySurvivalCount_eq_iid {α : Type*}
    (F : Finset (Finset α)) {s : Finset α} {t : ℕ}
    (e : Fin t ↪ ↥s) :
    embeddingFamilySurvivalCount F e =
      iidFamilySurvivalCount F t e.1 := by
  rfl

lemma embeddingCompletionThinning_lower_tail_le {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (b theta u : ℝ)
    (hs : (H \ completionHeavyEdges H Z b).Nonempty)
    (hb : 0 < b) (htheta0 : 0 ≤ theta)
    (htheta : |theta * b| ≤ 1 / 2)
    (ht : 2 * t * t ≤
      (H \ completionHeavyEdges H Z b).card) :
    finsetProbability
        (Finset.univ : Finset
          (Fin t ↪ ↥(H \ completionHeavyEdges H Z b)))
        (fun e ↦ u ≤
          finsetAverage
            (Finset.univ : Finset
              (IidSample (H \ completionHeavyEdges H Z b) t))
            (iidFamilySurvivalCount (completionMatchings n H Z) t) -
          embeddingFamilySurvivalCount (completionMatchings n H Z) e) ≤
      2 * Real.exp
        (theta^2 * ((t : ℝ) *
          (((completionMatchings n H Z).card : ℝ) *
            ((n - 1 : ℕ) : ℝ) /
              (H \ completionHeavyEdges H Z b).card)) * b - theta * u) := by
  let s := H \ completionHeavyEdges H Z b
  let P : (Fin t ↪ ↥s) → Prop := fun e ↦ u ≤
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (iidFamilySurvivalCount (completionMatchings n H Z) t) -
      embeddingFamilySurvivalCount (completionMatchings n H Z) e
  let Q : IidSample s t → Prop := fun omega ↦ u ≤
    finsetAverage (Finset.univ : Finset (IidSample s t))
        (iidFamilySurvivalCount (completionMatchings n H Z) t) -
      iidFamilySurvivalCount (completionMatchings n H Z) t omega
  have hinj := half_le_iid_injective_probability s t ht
  have hcondition := probability_embedding_le_iid_div s t P (1 / 2)
    (by norm_num) hinj
  have hlift :
      finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) ≤
        finsetProbability (Finset.univ : Finset (IidSample s t)) Q := by
    apply finsetProbability_mono_event
    intro omega homega hP
    rcases hP with ⟨hinjOmega, hP⟩
    exact hP
  have htail := iidCompletionThinning_lower_tail_le
    (t := t) H Z b theta u hs hb htheta0 htheta
  change finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤ _
  calc
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s)) P ≤
        finsetProbability (Finset.univ : Finset (IidSample s t))
          (iidLiftedEvent P) / (1 / 2) := hcondition
    _ ≤ finsetProbability (Finset.univ : Finset (IidSample s t)) Q /
          (1 / 2) := by gcongr
    _ ≤ Real.exp
          (theta^2 * ((t : ℝ) *
            (((completionMatchings n H Z).card : ℝ) *
              ((n - 1 : ℕ) : ℝ) / s.card)) * b - theta * u) /
          (1 / 2) := by
      exact div_le_div_of_nonneg_right htail (by norm_num)
    _ = 2 * Real.exp
          (theta^2 * ((t : ℝ) *
            (((completionMatchings n H Z).card : ℝ) *
              ((n - 1 : ℕ) : ℝ) / s.card)) * b - theta * u) := by ring

lemma embeddingFamilySurvivalCount_completion_eq {n t : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (s : Finset (Edge n))
    (hsH : s ⊆ H) (e : Fin t ↪ ↥s) :
    embeddingFamilySurvivalCount (completionMatchings n H Z) e =
      ((completionMatchings n (H \ historyEdges e) Z).card : ℝ) := by
  unfold embeddingFamilySurvivalCount
  norm_cast
  apply congrArg Finset.card
  apply Finset.ext
  intro F
  simp only [Finset.mem_filter, mem_completionMatchings]
  constructor
  · rintro ⟨⟨hFH, hcard, hmatch, havoid⟩, hsample⟩
    refine ⟨?_, hcard, hmatch, havoid⟩
    intro A hAF
    apply Finset.mem_sdiff.mpr
    refine ⟨hFH hAF, ?_⟩
    intro hAhist
    rcases Finset.mem_image.mp hAhist with ⟨i, _hi, hAi⟩
    exact hsample i (hAi ▸ hAF)
  · rintro ⟨hFsub, hcard, hmatch, havoid⟩
    refine ⟨⟨fun A hAF ↦
      (Finset.mem_sdiff.mp (hFsub hAF)).1,
      hcard, hmatch, havoid⟩, ?_⟩
    intro i hiF
    have hie : (e i).1 ∈ historyEdges e := by
      apply Finset.mem_image.mpr
      exact ⟨i, Finset.mem_univ _, rfl⟩
    exact (Finset.mem_sdiff.mp (hFsub hiF)).2 hie



def LayerCardAtLeastFailure {m : ℕ} (K : ℕ)
    (P : Finset (Edge m) → Prop) (J : Finset (Edge m)) : Prop :=
  K ≤ J.card ∧ P J

def ReindexLayerCardAtLeastFailure {n : ℕ} (K : ℕ)
    (Z : Edge n) (hZ : Z ∈ allEdges n)
    (P : Finset (Edge (n - 1)) → Prop) (H : Finset (Edge n)) : Prop :=
  LayerCardAtLeastFailure K P (reindexGraphAway H Z hZ)

def SomeReindexLayerCardAtLeastFailure {n : ℕ} (K : ℕ)
    (P : Finset (Edge (n - 1)) → Prop) (H : Finset (Edge n)) : Prop :=
  ∃ Z : ↥(allEdges n),
    ReindexLayerCardAtLeastFailure K Z.1 Z.2 P H

lemma reindexGraphAway_probability_le_of_layer_range {n M K : ℕ}
    {Z : Edge n} (hZ : Z ∈ allEdges n)
    (P : Finset (Edge (n - 1)) → Prop) (delta : ℝ)
    (hdelta : 0 ≤ delta) (hM : M ≤ (allEdges n).card)
    (hlayer : ∀ k, K ≤ k → k ≤ M →
      finsetProbability (sample (n - 1) k) P ≤ delta) :
    finsetProbability (sample n M)
        (ReindexLayerCardAtLeastFailure K Z hZ P) ≤ delta := by
  let Q : Finset (Edge (n - 1)) → Prop :=
    LayerCardAtLeastFailure K P
  have hlayerQ : ∀ k ≤ M,
      finsetProbability (sample (n - 1) k) Q ≤ delta := by
    intro k hk
    by_cases hKk : K ≤ k
    · calc
        finsetProbability (sample (n - 1) k) Q =
            finsetProbability (sample (n - 1) k) P := by
          apply finsetProbability_congr_event
          intro J hJs
          have hJcard := (mem_sample.mp hJs).2
          dsimp only [Q, LayerCardAtLeastFailure]
          rw [hJcard]
          simp only [hKk, true_and]
        _ ≤ delta := hlayer k hKk hk
    · have hzero : finsetProbability (sample (n - 1) k) Q = 0 := by
        apply le_antisymm
        · calc
            finsetProbability (sample (n - 1) k) Q ≤
                finsetProbability (sample (n - 1) k) (fun _J ↦ False) := by
              apply finsetProbability_mono_event
              intro J hJs hQ
              have hJcard := (mem_sample.mp hJs).2
              exact hKk (hJcard ▸ hQ.1)
            _ = 0 := by simp [finsetProbability]
        · exact finsetProbability_nonneg _ _
      rw [hzero]
      exact hdelta
  change finsetProbability (sample n M)
      (fun H ↦ Q (reindexGraphAway H Z hZ)) ≤ delta
  exact reindexGraphAway_probability_le_of_layer_le hZ Q delta hM hlayerQ

lemma some_reindexGraphAway_failure_probability_le_of_layer_range
    {n M K : ℕ}
    (P : Finset (Edge (n - 1)) → Prop) (delta : ℝ)
    (hdelta : 0 ≤ delta) (hM : M ≤ (allEdges n).card)
    (hlayer : ∀ k, K ≤ k → k ≤ M →
      finsetProbability (sample (n - 1) k) P ≤ delta) :
    finsetProbability (sample n M)
        (SomeReindexLayerCardAtLeastFailure K P) ≤
      (allEdges n).card * delta := by
  calc
    finsetProbability (sample n M)
        (SomeReindexLayerCardAtLeastFailure K P) ≤
      ∑ Z : ↥(allEdges n),
        finsetProbability (sample n M)
          (ReindexLayerCardAtLeastFailure K Z.1 Z.2 P) := by
      unfold SomeReindexLayerCardAtLeastFailure
      have hu := finsetProbability_exists_le_sum
        (α := Finset (Edge n)) (ι := ↥(allEdges n))
        (sample n M)
        (fun Z H ↦ ReindexLayerCardAtLeastFailure K Z.1 Z.2 P H)
      convert hu using 1
      unfold finsetProbability
      congr 1
      norm_cast
      apply congrArg Finset.card
      ext H
      simp only [Finset.mem_filter]
    _ ≤ ∑ _Z : ↥(allEdges n), delta :=
      Finset.sum_le_sum fun Z _ ↦
        reindexGraphAway_probability_le_of_layer_range Z.2 P delta
          hdelta hM hlayer
    _ = (allEdges n).card * delta := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_coe,
        nsmul_eq_mul]





lemma completionWeightLowerBound_mono {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) {L₁ L₂ : ℝ}
    (hL : L₁ ≤ L₂)
    (h : CompletionWeightLowerBound H L₂ Z) :
    CompletionWeightLowerBound H L₁ Z := by
  unfold CompletionWeightLowerBound at h ⊢
  exact (mul_le_mul_of_nonneg_right hL (by
    unfold matchingWeightTarget
    positivity)).trans h

lemma globalLowerWeightSpread_mono {n : ℕ}
    (H : Finset (Edge n)) {L₁ L₂ eta : ℝ}
    (hL : L₁ ≤ L₂)
    (h : GlobalLowerWeightSpread n H L₂ eta) :
    GlobalLowerWeightSpread n H L₁ eta := by
  unfold GlobalLowerWeightSpread at h ⊢
  have hsub :
      (allEdges n).filter (fun Z ↦
        ¬ CompletionWeightLowerBound H L₁ Z) ⊆
      (allEdges n).filter (fun Z ↦
        ¬ CompletionWeightLowerBound H L₂ Z) := by
    intro Z hZ
    rcases Finset.mem_filter.mp hZ with ⟨hZall, hbad⟩
    apply Finset.mem_filter.mpr
    refine ⟨hZall, ?_⟩
    intro hstrong
    exact hbad (completionWeightLowerBound_mono H Z hL hstrong)
  have hcard := Finset.card_le_card hsub
  have hcardR :
      ((((allEdges n).filter fun Z ↦
          ¬ CompletionWeightLowerBound H L₁ Z).card : ℕ) : ℝ) ≤
        (((allEdges n).filter fun Z ↦
          ¬ CompletionWeightLowerBound H L₂ Z).card : ℕ) := by
    exact_mod_cast hcard
  exact hcardR.trans h

def RefinedInsertionLowerFailure (n : ℕ)
    (a B : ℝ) (codegCap : ℕ) (C₀ L eta : ℝ)
    (H : Finset (Edge n)) : Prop :=
  RefinedInsertionGood n H.card a B codegCap C₀ H ∧
    ¬ GlobalLowerWeightSpread n H L eta

lemma refinedInsertion_globalLower_fixed_failure_probability_le
    {n M codegCap : ℕ}
    {a B C₀ sigma E delta eta etaGlobal r L : ℝ}
    (hn : 3 ≤ n) (hM : 0 < M) (hnM : n ≤ M)
    (hMtop : M < (allEdges n).card)
    (ha0 : 0 < a) (ha2 : a ≤ 2) (hB0 : 0 ≤ B)
    (hC0 : 0 ≤ C₀ + 1) (hsigma : 0 < sigma)
    (hratio :
      1 < ((3 * (M + 1) : ℕ) : ℝ) * sigma /
        ((18 * n * (codegCap + 1) : ℕ) : ℝ))
    (hE :
      (3 * n : ℝ) * Real.sqrt sigma +
          (3 * n : ℝ) * (C₀ + 1 + 14 + Real.log 2) /
            Real.log (((3 * (M + 1) : ℕ) : ℝ) * sigma /
              ((18 * n * (codegCap + 1) : ℕ) : ℝ)) ≤ E)
    (heta : 0 ≤ eta) (hgap : 2 / a < delta)
    (hentropyBudget :
      (3 * n : ℝ) *
          (4 * (3 * (C₀ + 1) * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤
        (eta * (delta - 2 / a) * (n : ℝ))^2)
    (hdelta0 : 0 ≤ delta) (hdelta1 : delta ≤ 1)
    (hr : 0 < r)
    (hglobalBudget : r + (M : ℝ) ≤ etaGlobal * (allEdges n).card)
    (hL : L ≤ (1 - delta) * (M : ℝ) / (M + 1)) :
    finsetProbability (sample n M)
        (RefinedInsertionLowerFailure n a B codegCap C₀ L etaGlobal) ≤
      eta * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  have hbase := refinedInsertion_globalLower_failure_probability_le
    hn hM hnM hMtop ha0 ha2 hB0 hC0 hsigma hratio hE heta hgap
      hentropyBudget hdelta0 hdelta1 hr hglobalBudget
  calc
    finsetProbability (sample n M)
        (RefinedInsertionLowerFailure n a B codegCap C₀ L etaGlobal) ≤
      finsetProbability (sample n M)
        (fun H ↦ RefinedInsertionGood n M a B codegCap C₀ H ∧
          ¬ GlobalLowerWeightSpread n H
            ((1 - delta) * (M : ℝ) / (M + 1)) etaGlobal) := by
      apply finsetProbability_mono_event
      intro H hHs hfail
      have hcard := (mem_sample.mp hHs).2
      refine ⟨?_, ?_⟩
      · simpa only [RefinedInsertionLowerFailure, hcard] using hfail.1
      · intro hstrong
        exact hfail.2 (globalLowerWeightSpread_mono H hL hstrong)
    _ ≤ eta * (((allEdges n).card - M : ℕ) : ℝ) / r := hbase

def ResidualRefinedInheritanceGood
    (n M d D codegCap : ℕ) (a B c C₀ C₁ : ℝ)
    (H : Finset (Edge n)) : Prop :=
  (perfectMatchings n H).card ≠ 0 ∧
  KahnCountLower H C₀ ∧
  (∀ v : Vertex n, d ≤ vertexDegree H v - 3 * codegCap) ∧
  (∀ v : Vertex n, vertexDegree H v ≤ D) ∧
  (∀ u v : Vertex n, u ≠ v → vertexCodegree H u v ≤ codegCap) ∧
  ∀ (Z : Edge n) (hZ : Z ∈ allEdges n),
    c^2 * matchingWeightTarget n H ≤ completionWeight H Z →
      ((n - 1 : ℕ) : ℝ) *
            Real.log (((reindexGraphAway H Z hZ).card : ℝ) /
              (n - 1 : ℕ)) -
          2 * ((n - 1 : ℕ) : ℝ) - C₁ * ((n - 1 : ℕ) : ℝ) ≤
        ((n : ℝ) * Real.log ((M : ℝ) / n) -
          2 * (n : ℝ) - C₀ * (n : ℝ)) +
          Real.log (c^2 * (n : ℝ) / M)

lemma refinedInheritance_not_highResidual_implies_someReindexFailure
    {n M d D codegCap : ℕ} {a B c C₀ C₁ L eta : ℝ}
    {H : Finset (Edge n)}
    (hn : 2 ≤ n) (hM : 0 < M) (hH : H ∈ sample n M)
    (ha0 : 0 ≤ a) (hB0 : 0 ≤ B) (hc : 0 < c)
    (ha : a * ((M : ℝ) / ((n - 1 : ℕ) : ℝ)) ≤ d)
    (hB : (D : ℝ) ≤ B *
      (((M - 3 * D : ℕ) : ℝ) / ((n - 1 : ℕ) : ℝ)))
    (hgood : ResidualRefinedInheritanceGood
      n M d D codegCap a B c C₀ C₁ H)
    (hfail : ¬ HighResidualLowerSpread n H c L eta) :
    SomeReindexLayerCardAtLeastFailure (M - 3 * D)
      (RefinedInsertionLowerFailure (n - 1) a B codegCap C₁ L eta) H := by
  rcases hgood with
    ⟨hPhi, hcount, hdegreeLower, hdegreeUpper, hcodeg, hcountBudget⟩
  obtain ⟨Z₀, hZ₀, hmax⟩ := exists_max_completionWeight H (by omega)
  have hnotall : ¬ ∀ (Z : Edge n) (hZ : Z ∈ allEdges n),
      c^2 * (completionWeight H Z₀ : ℝ) ≤ completionWeight H Z →
        GlobalLowerWeightSpread (n - 1)
          (reindexGraphAway H Z hZ) L eta := by
    intro hall
    exact hfail ⟨Z₀, hZ₀, hmax, hall⟩
  push Not at hnotall
  rcases hnotall with ⟨Z, hZ, hhigh, hbad⟩
  have hweight : c^2 * matchingWeightTarget n H ≤
      completionWeight H Z :=
    high_from_max_completionWeight hM hH hmax hc.le hhigh
  have hrefined : RefinedInsertionGood (n - 1)
      (reindexGraphAway H Z hZ).card a B codegCap C₁
      (reindexGraphAway H Z hZ) := by
    exact reindexGraphAway_refinedInsertionGood_of_weightLower
      hn hM hH hZ ha0 hB0 hc hPhi hcount hweight
      hdegreeLower hdegreeUpper hcodeg ha hB (hcountBudget Z hZ hweight)
  unfold SomeReindexLayerCardAtLeastFailure
  refine ⟨⟨Z, hZ⟩, ?_⟩
  unfold ReindexLayerCardAtLeastFailure LayerCardAtLeastFailure
  refine ⟨?_, ?_⟩
  · exact card_reindexGraphAway_lower hZ (mem_sample.mp hH).2
      (fun z hz ↦ hdegreeUpper z)
  · exact ⟨hrefined, hbad⟩

lemma refinedInheritance_highResidual_failure_probability_le
    {n M d D codegCap : ℕ} {a B c C₀ C₁ L eta delta : ℝ}
    (hn : 2 ≤ n) (hM0 : 0 < M) (hM : M ≤ (allEdges n).card)
    (ha0 : 0 ≤ a) (hB0 : 0 ≤ B) (hc : 0 < c)
    (ha : a * ((M : ℝ) / ((n - 1 : ℕ) : ℝ)) ≤ d)
    (hB : (D : ℝ) ≤ B *
      (((M - 3 * D : ℕ) : ℝ) / ((n - 1 : ℕ) : ℝ)))
    (hdelta : 0 ≤ delta)
    (hlayer : ∀ k, M - 3 * D ≤ k → k ≤ M →
      finsetProbability (sample (n - 1) k)
        (RefinedInsertionLowerFailure
          (n - 1) a B codegCap C₁ L eta) ≤ delta) :
    finsetProbability (sample n M)
        (fun H ↦ ResidualRefinedInheritanceGood
            n M d D codegCap a B c C₀ C₁ H ∧
          ¬ HighResidualLowerSpread n H c L eta) ≤
      (allEdges n).card * delta := by
  calc
    finsetProbability (sample n M)
        (fun H ↦ ResidualRefinedInheritanceGood
            n M d D codegCap a B c C₀ C₁ H ∧
          ¬ HighResidualLowerSpread n H c L eta) ≤
      finsetProbability (sample n M)
        (SomeReindexLayerCardAtLeastFailure (M - 3 * D)
          (RefinedInsertionLowerFailure
            (n - 1) a B codegCap C₁ L eta)) := by
      apply finsetProbability_mono_event
      intro H hHs hfail
      exact refinedInheritance_not_highResidual_implies_someReindexFailure
        hn hM0 hHs ha0 hB0 hc ha hB hfail.1 hfail.2
    _ ≤ (allEdges n).card * delta :=
      some_reindexGraphAway_failure_probability_le_of_layer_range
        (RefinedInsertionLowerFailure
          (n - 1) a B codegCap C₁ L eta)
        delta hdelta hM hlayer


def degreeReciprocalL1 {n : ℕ} (H : Finset (Edge n)) : ℝ :=
  ∑ v : Vertex n, (vertexDegree H v : ℝ) *
    |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|

lemma sum_edge_reciprocalDegreeDeviation {n : ℕ}
    (H : Finset (Edge n)) :
    ∑ A ∈ H, ∑ v ∈ A,
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| =
      degreeReciprocalL1 H := by
  unfold degreeReciprocalL1
  let f : Vertex n → ℝ := fun v ↦
    |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|
  change ∑ A ∈ H, ∑ v ∈ A, f v =
    ∑ v : Vertex n, (vertexDegree H v : ℝ) * f v
  calc
    ∑ A ∈ H, ∑ v ∈ A, f v =
        ∑ A ∈ H, ∑ v : Vertex n, if v ∈ A then f v else 0 := by
      apply Finset.sum_congr rfl
      intro A _
      rw [← Finset.sum_filter]
      have hfilter :
          (Finset.univ : Finset (Vertex n)).filter (fun v ↦ v ∈ A) = A := by
        ext v
        simp
      rw [hfilter]
    _ = ∑ v : Vertex n, ∑ A ∈ H, if v ∈ A then f v else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ v : Vertex n, (vertexDegree H v : ℝ) * f v := by
      apply Finset.sum_congr rfl
      intro v _
      rw [← Finset.sum_filter]
      simp [vertexDegree]

lemma badEdge_incidenceDeviation_with_degree {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    {delta : ℝ} {A : Edge n}
    (hA : A ∈ matchingFractionBadEdges H delta) :
    3 * (delta * matchingFractionMean n H) ≤
      ∑ v ∈ A,
        (|matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|) := by
  have hAH : A ∈ H := (Finset.mem_filter.mp hA).1
  have hAcard : A.card = 3 := mem_allEdges.mp (hH hAH)
  have hbad : delta * matchingFractionMean n H <
      |matchingFraction H A - matchingFractionMean n H| :=
    lt_of_not_ge (Finset.mem_filter.mp hA).2
  have hpoint : ∀ v ∈ A,
      delta * matchingFractionMean n H ≤
        |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| := by
    intro v hv
    exact hbad.le.trans (by
      calc
        |matchingFraction H A - matchingFractionMean n H| =
            |(matchingFraction H A - 1 / (vertexDegree H v : ℝ)) +
              (1 / (vertexDegree H v : ℝ) -
                matchingFractionMean n H)| := by ring_nf
        _ ≤ |matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
              |1 / (vertexDegree H v : ℝ) -
                matchingFractionMean n H| := abs_add_le _ _)
  calc
    3 * (delta * matchingFractionMean n H) =
        ∑ _v ∈ A, delta * matchingFractionMean n H := by
      simp [hAcard]
    _ ≤ ∑ v ∈ A,
        (|matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|) :=
      Finset.sum_le_sum hpoint

lemma card_badEdges_mul_delta_le_local_add_degreeL1 {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (delta : ℝ) :
    ((matchingFractionBadEdges H delta).card : ℝ) *
        (3 * (delta * matchingFractionMean n H)) ≤
      (∑ v : Vertex n, localMatchingL1 H v) + degreeReciprocalL1 H := by
  let Bad := matchingFractionBadEdges H delta
  let W : Edge n → ℝ := fun A ↦
    ∑ v ∈ A,
      (|matchingFraction H A - 1 / (vertexDegree H v : ℝ)| +
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|)
  have hBadH : Bad ⊆ H := by
    intro A hA
    exact (Finset.mem_filter.mp hA).1
  have hW0 : ∀ A ∈ H, 0 ≤ W A := by
    intro A hAH
    dsimp only [W]
    positivity
  calc
    (Bad.card : ℝ) * (3 * (delta * matchingFractionMean n H)) =
        ∑ _A ∈ Bad, 3 * (delta * matchingFractionMean n H) := by simp
    _ ≤ ∑ A ∈ Bad, W A := by
      apply Finset.sum_le_sum
      intro A hA
      exact badEdge_incidenceDeviation_with_degree hH hA
    _ ≤ ∑ A ∈ H, W A :=
      Finset.sum_le_sum_of_subset_of_nonneg hBadH
        (fun A hAH hAnot ↦ hW0 A hAH)
    _ = (∑ A ∈ H, ∑ v ∈ A,
          |matchingFraction H A - 1 / (vertexDegree H v : ℝ)|) +
        (∑ A ∈ H, ∑ v ∈ A,
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|) := by
      dsimp only [W]
      simp_rw [Finset.sum_add_distrib]
    _ = (∑ v : Vertex n, localMatchingL1 H v) +
        degreeReciprocalL1 H := by
      rw [← sum_localMatchingL1_eq_sum_edges,
        sum_edge_reciprocalDegreeDeviation]

lemma presentWeightSpread_of_local_add_degreeL1 {n : ℕ}
    (H : Finset (Edge n)) (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (delta eta S R : ℝ) (hn : 0 < n)
    (hdelta : 0 < delta) (heta : 0 ≤ eta)
    (hlocal : ∑ v : Vertex n, localMatchingL1 H v ≤ S)
    (hdegree : degreeReciprocalL1 H ≤ R)
    (hbudget : S + R ≤ 3 * eta * delta * (n : ℝ)) :
    PresentWeightSpread H delta eta := by
  unfold PresentWeightSpread
  rw [← matchingFractionBadEdges_eq H hPhi delta]
  by_contra hspread
  have hbadcard : eta * (H.card : ℝ) <
      ((matchingFractionBadEdges H delta).card : ℝ) :=
    lt_of_not_ge hspread
  have hpm : (perfectMatchings n H).Nonempty :=
    Finset.card_ne_zero.mp hPhi
  obtain ⟨F, hF⟩ := hpm
  have hnH : n ≤ H.card := by
    calc
      n = F.card := (mem_perfectMatchings.mp hF).2.1.symm
      _ ≤ H.card := Finset.card_le_card (mem_perfectMatchings.mp hF).1
  have hHcard : 0 < H.card := lt_of_lt_of_le hn hnH
  have hmean : 0 < matchingFractionMean n H := by
    unfold matchingFractionMean
    positivity
  have hfactor : 0 < 3 * (delta * matchingFractionMean n H) := by
    positivity
  have hcount := card_badEdges_mul_delta_le_local_add_degreeL1
    H hH delta
  have hlower :
      (eta * (H.card : ℝ)) *
          (3 * (delta * matchingFractionMean n H)) <
        (∑ v : Vertex n, localMatchingL1 H v) + degreeReciprocalL1 H :=
    (mul_lt_mul_of_pos_right hbadcard hfactor).trans_le hcount
  have hnormalize :
      (eta * (H.card : ℝ)) *
          (3 * (delta * matchingFractionMean n H)) =
        3 * eta * delta * (n : ℝ) := by
    unfold matchingFractionMean
    field_simp [show (H.card : ℝ) ≠ 0 by exact_mod_cast hHcard.ne']
  rw [hnormalize] at hlower
  have hupper :
      (∑ v : Vertex n, localMatchingL1 H v) + degreeReciprocalL1 H ≤
        S + R := add_le_add hlocal hdegree
  linarith


lemma powersetCard_complement_probability {n M : ℕ}
    (H : Finset (Edge n)) (hM : M ≤ H.card)
    (P : Finset (Edge n) → Prop) :
    finsetProbability (H.powersetCard (H.card - M))
        (fun G ↦ P (H \ G)) =
      finsetProbability (H.powersetCard M) P := by
  have hfilter :
      ((H.powersetCard (H.card - M)).filter
        (fun G ↦ P (H \ G))).card =
      ((H.powersetCard M).filter P).card := by
    apply Finset.card_bij (fun G _ ↦ H \ G)
    · intro G hG
      rcases Finset.mem_filter.mp hG with ⟨hGp, hPG⟩
      rcases Finset.mem_powersetCard.mp hGp with ⟨hGH, hGcard⟩
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_powersetCard.mpr ⟨Finset.sdiff_subset, ?_⟩, hPG⟩
      rw [Finset.card_sdiff, Finset.inter_eq_left.mpr hGH, hGcard]
      omega
    · intro G hG K hK heq
      rcases Finset.mem_filter.mp hG with ⟨hGp, _⟩
      rcases Finset.mem_filter.mp hK with ⟨hKp, _⟩
      have hGH := (Finset.mem_powersetCard.mp hGp).1
      have hKH := (Finset.mem_powersetCard.mp hKp).1
      rw [← Finset.sdiff_sdiff_eq_self hGH,
        ← Finset.sdiff_sdiff_eq_self hKH, heq]
    · intro L hL
      rcases Finset.mem_filter.mp hL with ⟨hLp, hPL⟩
      rcases Finset.mem_powersetCard.mp hLp with ⟨hLH, hLcard⟩
      let G := H \ L
      have hGcard : G.card = H.card - M := by
        dsimp only [G]
        rw [Finset.card_sdiff, Finset.inter_eq_left.mpr hLH, hLcard]
      have hGp : G ∈ H.powersetCard (H.card - M) :=
        Finset.mem_powersetCard.mpr ⟨Finset.sdiff_subset, hGcard⟩
      refine ⟨G, Finset.mem_filter.mpr ⟨hGp, ?_⟩, ?_⟩
      · simpa only [G, Finset.sdiff_sdiff_eq_self hLH] using hPL
      · exact Finset.sdiff_sdiff_eq_self hLH
  unfold finsetProbability
  rw [hfilter, Finset.card_powersetCard, Finset.card_powersetCard,
    Nat.choose_symm hM]

lemma historyEdges_probability_eq_sample {n M : ℕ}
    (H : Finset (Edge n)) (hM : M ≤ H.card)
    (P : Finset (Edge n) → Prop) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory H M))
        (fun e ↦ P (historyEdges e)) =
      finsetProbability (H.powersetCard M) P := by
  let K := H.card - M
  have hK : K ≤ H.card := by dsimp [K]; omega
  have heq : H.card - K = M := by dsimp [K]; omega
  have hordered := orderedDeletion_probability_eq_history H K hK
    (fun e ↦ P (historyEdges e))
  have hremain := orderedDeletionSample_remaining_probability H K
    (fun G ↦ P (H \ G))
  have hleft :
      finsetProbability
          (Finset.univ : Finset (OrderedDeletionSample H K))
          (fun omega ↦ P (historyEdges (orderedDeletionHistory omega))) =
        finsetProbability (H.powersetCard K) (fun G ↦ P (H \ G)) := by
    calc
      finsetProbability
          (Finset.univ : Finset (OrderedDeletionSample H K))
          (fun omega ↦ P (historyEdges (orderedDeletionHistory omega))) =
        finsetProbability
          (Finset.univ : Finset (OrderedDeletionSample H K))
          (fun omega ↦ P (H \ orderedRemaining omega)) := by
            apply finsetProbability_congr_event
            intro omega _
            rw [historyEdges_orderedDeletionHistory]
      _ = finsetProbability (H.powersetCard K) (fun G ↦ P (H \ G)) := hremain
  rw [hleft] at hordered
  rw [powersetCard_complement_probability H hM P] at hordered
  dsimp only [K] at hordered
  rw [show H.card - (H.card - M) = M by omega] at hordered
  exact hordered.symm


def SampledVertexDegreeRelativeBad (n M : ℕ) (q : ℝ)
    (v : Vertex n) (e : DeletionHistory (allEdges n) M) : Prop :=
  (vertexDegree (historyEdges e) v : ℝ) ≤
      (1 - q) * ((M : ℝ) / n) ∨
    (1 + q) * ((M : ℝ) / n) ≤
      vertexDegree (historyEdges e) v

lemma sampledVertexDegree_relative_lower_le (n M : ℕ)
    (q : ℝ) (v : Vertex n) (hn : 0 < n)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
          (1 - q) * ((M : ℝ) / n)) ≤
      2 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hraw := embeddingHitCount_lower_tail_le_mean
    (allEdges n) (incidentEdges n v) (incidentEdges_subset n v) M
    (q / 2) (q * ((M : ℝ) / n)) hall (by positivity)
    (by rw [abs_of_nonneg (by positivity)]; linarith) hM
  rw [incidentEdges_density n v hn] at hraw
  have hfilter :
      (Finset.univ : Finset (DeletionHistory (allEdges n) M)).filter
          (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
            (1 - q) * ((M : ℝ) / n)) =
        (Finset.univ : Finset (DeletionHistory (allEdges n) M)).filter
          (fun e ↦ q * ((M : ℝ) / n) ≤
            (M : ℝ) * (1 / (n : ℝ)) -
              embeddingHitCount (incidentEdges n v) e) := by
    apply Finset.filter_congr
    intro e _
    rw [vertexDegree_historyEdges_eq_hitCount]
    rw [show (M : ℝ) * (1 / (n : ℝ)) = (M : ℝ) / n by ring]
    constructor <;> intro h <;> nlinarith
  have harg :
      (q / 2)^2 * ((M : ℝ) * (1 / (n : ℝ))) -
          (q / 2) * (q * ((M : ℝ) / n)) =
        -(q^2 * ((M : ℝ) / n)) / 4 := by ring
  unfold finsetProbability at hraw ⊢
  rw [hfilter]
  rw [harg] at hraw
  exact hraw

lemma sampledVertexDegree_relative_upper_le (n M : ℕ)
    (q : ℝ) (v : Vertex n) (hn : 0 < n)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ (1 + q) * ((M : ℝ) / n) ≤
          vertexDegree (historyEdges e) v) ≤
      2 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) := by
  have hall : (allEdges n).Nonempty := by
    let i : Fin n := ⟨0, hn⟩
    exact ⟨canonicalEdge n i,
      mem_allEdges.mpr (canonicalEdge_card n i)⟩
  have hraw := embeddingHitCount_upper_tail_le_mean
    (allEdges n) (incidentEdges n v) (incidentEdges_subset n v) M
    (q / 2) (q * ((M : ℝ) / n)) hall (by positivity)
    (by rw [abs_of_nonneg (by positivity)]; linarith) hM
  rw [incidentEdges_density n v hn] at hraw
  have hfilter :
      (Finset.univ : Finset (DeletionHistory (allEdges n) M)).filter
          (fun e ↦ (1 + q) * ((M : ℝ) / n) ≤
            vertexDegree (historyEdges e) v) =
        (Finset.univ : Finset (DeletionHistory (allEdges n) M)).filter
          (fun e ↦ q * ((M : ℝ) / n) ≤
            embeddingHitCount (incidentEdges n v) e -
              (M : ℝ) * (1 / (n : ℝ))) := by
    apply Finset.filter_congr
    intro e _
    rw [vertexDegree_historyEdges_eq_hitCount]
    rw [show (M : ℝ) * (1 / (n : ℝ)) = (M : ℝ) / n by ring]
    constructor <;> intro h <;> nlinarith
  have harg :
      (q / 2)^2 * ((M : ℝ) * (1 / (n : ℝ))) -
          (q / 2) * (q * ((M : ℝ) / n)) =
        -(q^2 * ((M : ℝ) / n)) / 4 := by ring
  unfold finsetProbability at hraw ⊢
  rw [hfilter]
  rw [harg] at hraw
  exact hraw

lemma sampledVertexDegreeRelativeBad_le (n M : ℕ)
    (q : ℝ) (v : Vertex n) (hn : 0 < n)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (SampledVertexDegreeRelativeBad n M q v) ≤
      4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) := by
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (SampledVertexDegreeRelativeBad n M q v) =
      finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦
          (vertexDegree (historyEdges e) v : ℝ) ≤
              (1 - q) * ((M : ℝ) / n) ∨
            (1 + q) * ((M : ℝ) / n) ≤
              vertexDegree (historyEdges e) v) := by
        apply finsetProbability_congr_event
        intro e _
        rfl
    _ ≤
      finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun e ↦ (vertexDegree (historyEdges e) v : ℝ) ≤
            (1 - q) * ((M : ℝ) / n)) +
        finsetProbability
          (Finset.univ : Finset (DeletionHistory (allEdges n) M))
          (fun e ↦ (1 + q) * ((M : ℝ) / n) ≤
            vertexDegree (historyEdges e) v) :=
      finsetProbability_or_le_add _ _ _
    _ ≤ 2 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) +
        2 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) :=
      add_le_add
        (sampledVertexDegree_relative_lower_le n M q v hn hq0 hq1 hM)
        (sampledVertexDegree_relative_upper_le n M q v hn hq0 hq1 hM)
    _ = 4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) := by ring

def DegreeRelativeBad (n M : ℕ) (q : ℝ)
    (v : Vertex n) (H : Finset (Edge n)) : Prop :=
  (vertexDegree H v : ℝ) ≤ (1 - q) * ((M : ℝ) / n) ∨
    (1 + q) * ((M : ℝ) / n) ≤ vertexDegree H v

def degreeRelativeBadVertices (n M : ℕ) (q : ℝ)
    (H : Finset (Edge n)) : Finset (Vertex n) :=
  Finset.univ.filter fun v ↦ DegreeRelativeBad n M q v H

lemma degreeRelativeBad_sample_probability_le (n M : ℕ)
    (q : ℝ) (v : Vertex n) (hn : 0 < n)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability (sample n M) (DegreeRelativeBad n M q v) ≤
      4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) := by
  have hMcard : M ≤ (allEdges n).card := by
    have hself : M ≤ 2 * M * M := by
      by_cases hM0 : M = 0
      · simp [hM0]
      · have hMpos : 0 < M := Nat.pos_of_ne_zero hM0
        calc
          M ≤ M * M := Nat.le_mul_of_pos_right M hMpos
          _ ≤ 2 * (M * M) := Nat.le_mul_of_pos_left _ (by omega)
          _ = 2 * M * M := by ac_rfl
    exact hself.trans hM
  rw [sample, ← historyEdges_probability_eq_sample
    (allEdges n) hMcard (DegreeRelativeBad n M q v)]
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ DegreeRelativeBad n M q v (historyEdges e)) =
      finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (SampledVertexDegreeRelativeBad n M q v) := by
          apply finsetProbability_congr_event
          intro e _
          rfl
    _ ≤ _ := sampledVertexDegreeRelativeBad_le n M q v hn hq0 hq1 hM

lemma average_degreeRelativeBadVertices_le (n M : ℕ)
    (q : ℝ) (hn : 0 < n) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetAverage (sample n M)
        (fun H ↦ ((degreeRelativeBadVertices n M q H).card : ℝ)) ≤
      (3 * n : ℝ) *
        (4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4)) := by
  change finsetAverage (sample n M)
      (fun H ↦ (((Finset.univ : Finset (Vertex n)).filter
        fun v ↦ DegreeRelativeBad n M q v H).card : ℝ)) ≤ _
  rw [finsetAverage_card_filter_eq_sum_probability]
  calc
    (∑ v : Vertex n,
        finsetProbability (sample n M) (DegreeRelativeBad n M q v)) ≤
      ∑ _v : Vertex n,
        4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) :=
      Finset.sum_le_sum fun v _ ↦
        degreeRelativeBad_sample_probability_le n M q v hn hq0 hq1 hM
    _ = (3 * n : ℝ) *
        (4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4)) := by simp

lemma degreeRelativeBadVertices_proportion_le (n M : ℕ)
    (q eta : ℝ) (hn : 0 < n) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (heta : 0 < eta)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability (sample n M)
        (fun H ↦ eta * (3 * n : ℝ) ≤
          (degreeRelativeBadVertices n M q H).card) ≤
      (4 / eta) * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) := by
  let W : Finset (Edge n) → ℝ := fun H ↦
    ((degreeRelativeBadVertices n M q H).card : ℝ)
  have hthreshold : 0 < eta * (3 * n : ℝ) := by positivity
  have hmarkov := finsetProbability_mul_le_average_of_nonneg
    (sample n M) W (eta * (3 * n : ℝ)) (fun _ _ ↦ by positivity)
  have havg : finsetAverage (sample n M) W ≤
      (3 * n : ℝ) *
        (4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4)) := by
    simpa only [W] using
      average_degreeRelativeBadVertices_le n M q hn hq0 hq1 hM
  change finsetProbability (sample n M)
      (fun H ↦ eta * (3 * n : ℝ) ≤ W H) ≤ _
  apply le_of_mul_le_mul_right _ hthreshold
  calc
    finsetProbability (sample n M)
          (fun H ↦ eta * (3 * n : ℝ) ≤ W H) *
        (eta * (3 * n : ℝ)) ≤ finsetAverage (sample n M) W := hmarkov
    _ ≤ (3 * n : ℝ) *
        (4 * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4)) := havg
    _ = ((4 / eta) *
          Real.exp (-(q^2 * ((M : ℝ) / n)) / 4)) *
        (eta * (3 * n : ℝ)) := by
      field_simp [heta.ne']


lemma degreeReciprocalTerm_le_abs_normalized {n M : ℕ}
    (H : Finset (Edge n)) (v : Vertex n)
    (hn : 0 < n) (hM : 0 < M) (hcard : H.card = M) :
    (vertexDegree H v : ℝ) *
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| ≤
      |1 - (vertexDegree H v : ℝ) /
        ((M : ℝ) / n)| := by
  rw [show matchingFractionMean n H = (n : ℝ) / M by
    unfold matchingFractionMean
    rw [hcard]]
  by_cases hd : vertexDegree H v = 0
  · simp [hd]
  · have hdR : (vertexDegree H v : ℝ) ≠ 0 := by exact_mod_cast hd
    have hd0 : (0 : ℝ) ≤ vertexDegree H v := by positivity
    have hnR : (0 : ℝ) < n := by exact_mod_cast hn
    have hMR : (0 : ℝ) < M := by exact_mod_cast hM
    apply le_of_eq
    calc
      (vertexDegree H v : ℝ) *
          |1 / (vertexDegree H v : ℝ) - (n : ℝ) / M| =
        |(vertexDegree H v : ℝ)| *
          |1 / (vertexDegree H v : ℝ) - (n : ℝ) / M| := by
            rw [abs_of_nonneg hd0]
      _ = |(vertexDegree H v : ℝ) *
          (1 / (vertexDegree H v : ℝ) - (n : ℝ) / M)| := by
            rw [abs_mul]
      _ = |1 - (vertexDegree H v : ℝ) / ((M : ℝ) / n)| := by
        congr 1
        field_simp [hdR, hnR.ne', hMR.ne']

lemma degreeReciprocalTerm_le_of_not_relativeBad {n M : ℕ}
    (H : Finset (Edge n)) (v : Vertex n) (q : ℝ)
    (hn : 0 < n) (hM : 0 < M) (hcard : H.card = M)
    (hq0 : 0 ≤ q) (hgood : ¬ DegreeRelativeBad n M q v H) :
    (vertexDegree H v : ℝ) *
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| ≤ q := by
  have hbase := degreeReciprocalTerm_le_abs_normalized H v hn hM hcard
  have hmu : (0 : ℝ) < (M : ℝ) / n := by positivity
  have hlower : (1 - q) * ((M : ℝ) / n) <
      (vertexDegree H v : ℝ) := by
    exact lt_of_not_ge (not_or.mp hgood).1
  have hupper : (vertexDegree H v : ℝ) <
      (1 + q) * ((M : ℝ) / n) := by
    exact lt_of_not_ge (not_or.mp hgood).2
  have hxLower : 1 - q ≤
      (vertexDegree H v : ℝ) / ((M : ℝ) / n) := by
    exact ((le_div_iff₀ hmu).2 hlower.le)
  have hxUpper : (vertexDegree H v : ℝ) /
      ((M : ℝ) / n) ≤ 1 + q := by
    exact ((div_le_iff₀ hmu).2 hupper.le)
  exact hbase.trans ((abs_le).2 ⟨by linarith, by linarith⟩)

lemma degreeReciprocalTerm_le_of_degreeUpper {n M : ℕ}
    (H : Finset (Edge n)) (v : Vertex n) (B : ℝ)
    (hn : 0 < n) (hM : 0 < M) (hcard : H.card = M)
    (hB0 : 0 ≤ B)
    (hupper : (vertexDegree H v : ℝ) ≤
      B * ((M : ℝ) / n)) :
    (vertexDegree H v : ℝ) *
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| ≤
      1 + B := by
  have hbase := degreeReciprocalTerm_le_abs_normalized H v hn hM hcard
  have hmu : (0 : ℝ) < (M : ℝ) / n := by positivity
  have hx0 : 0 ≤ (vertexDegree H v : ℝ) /
      ((M : ℝ) / n) := by positivity
  have hxB : (vertexDegree H v : ℝ) /
      ((M : ℝ) / n) ≤ B := (div_le_iff₀ hmu).2 hupper
  calc
    (vertexDegree H v : ℝ) *
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| ≤
      |1 - (vertexDegree H v : ℝ) / ((M : ℝ) / n)| := hbase
    _ ≤ |1| + |(vertexDegree H v : ℝ) / ((M : ℝ) / n)| :=
      abs_sub _ _
    _ = 1 + (vertexDegree H v : ℝ) / ((M : ℝ) / n) := by
      rw [abs_of_nonneg hx0]
      norm_num
    _ ≤ 1 + B := by linarith

def DegreeAggregateRegular (n M : ℕ) (q eta B : ℝ)
    (H : Finset (Edge n)) : Prop :=
  ((degreeRelativeBadVertices n M q H).card : ℝ) ≤
      eta * (3 * n : ℝ) ∧
    ∀ v : Vertex n,
      (vertexDegree H v : ℝ) ≤ B * ((M : ℝ) / n)

lemma degreeReciprocalL1_le_of_aggregateRegular {n M : ℕ}
    (H : Finset (Edge n)) (q eta B : ℝ)
    (hn : 0 < n) (hM : 0 < M) (hcard : H.card = M)
    (hq0 : 0 ≤ q) (hB0 : 0 ≤ B)
    (hreg : DegreeAggregateRegular n M q eta B H) :
    degreeReciprocalL1 H ≤
      (3 * n : ℝ) * (q + eta * (1 + B)) := by
  let Bad := degreeRelativeBadVertices n M q H
  have hpoint : ∀ v : Vertex n,
      (vertexDegree H v : ℝ) *
          |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H| ≤
        q + if v ∈ Bad then 1 + B else 0 := by
    intro v
    by_cases hv : v ∈ Bad
    · rw [if_pos hv]
      have hterm := degreeReciprocalTerm_le_of_degreeUpper
        H v B hn hM hcard hB0 (hreg.2 v)
      linarith
    · rw [if_neg hv, add_zero]
      apply degreeReciprocalTerm_le_of_not_relativeBad
        H v q hn hM hcard hq0
      intro hbad
      exact hv (Finset.mem_filter.mpr ⟨Finset.mem_univ v, hbad⟩)
  unfold degreeReciprocalL1
  calc
    (∑ v : Vertex n, (vertexDegree H v : ℝ) *
        |1 / (vertexDegree H v : ℝ) - matchingFractionMean n H|) ≤
      ∑ v : Vertex n, (q + if v ∈ Bad then 1 + B else 0) :=
        Finset.sum_le_sum fun v _ ↦ hpoint v
    _ = (3 * n : ℝ) * q + (Bad.card : ℝ) * (1 + B) := by
      rw [Finset.sum_add_distrib]
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul]
      have hfilter :
          (Finset.univ : Finset (Vertex n)).filter (fun v ↦ v ∈ Bad) = Bad := by
        ext v
        simp
      have hsumIf :
          (∑ v : Vertex n, if v ∈ Bad then 1 + B else 0) =
            (Bad.card : ℝ) * (1 + B) := by
        calc
          (∑ v : Vertex n, if v ∈ Bad then 1 + B else 0) =
              ∑ v ∈ (Finset.univ : Finset (Vertex n)).filter
                  (fun v ↦ v ∈ Bad), (1 + B) := by
                rw [Finset.sum_filter]
          _ = ∑ _v ∈ Bad, (1 + B) := by rw [hfilter]
          _ = (Bad.card : ℝ) * (1 + B) := by simp <;> ring
      rw [hsumIf]
      norm_num only [Nat.cast_mul, Nat.cast_ofNat] <;> ring
    _ ≤ (3 * n : ℝ) * q +
        (eta * (3 * n : ℝ)) * (1 + B) := by
      apply add_le_add (le_refl _)
      exact mul_le_mul_of_nonneg_right hreg.1 (by linarith)
    _ = (3 * n : ℝ) * (q + eta * (1 + B)) := by ring

def DegreeUpperFailure (n M : ℕ) (B : ℝ)
    (H : Finset (Edge n)) : Prop :=
  ∃ v : Vertex n, B * ((M : ℝ) / n) ≤ vertexDegree H v

lemma sampled_exists_degree_upper_factor_sample_le
    (n M : ℕ) (B : ℝ) (hn : 0 < n) (hB : 1 ≤ B)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability (sample n M) (DegreeUpperFailure n M B) ≤
      (3 * n : ℝ) *
        (2 * Real.exp (((M : ℝ) / n) *
          (B - 1 - B * Real.log B))) := by
  have hMcard : M ≤ (allEdges n).card := by
    have hself : M ≤ 2 * M * M := by
      by_cases hM0 : M = 0
      · simp [hM0]
      · have hMpos : 0 < M := Nat.pos_of_ne_zero hM0
        calc
          M ≤ M * M := Nat.le_mul_of_pos_right M hMpos
          _ ≤ 2 * (M * M) := Nat.le_mul_of_pos_left _ (by omega)
          _ = 2 * M * M := by ac_rfl
    exact hself.trans hM
  rw [sample, ← historyEdges_probability_eq_sample
    (allEdges n) hMcard (DegreeUpperFailure n M B)]
  calc
    finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ DegreeUpperFailure n M B (historyEdges e)) =
      finsetProbability
        (Finset.univ : Finset (DeletionHistory (allEdges n) M))
        (fun e ↦ ∃ v : Vertex n,
          B * ((M : ℝ) / n) ≤ vertexDegree (historyEdges e) v) := by
      apply finsetProbability_congr_event
      intro e _
      rfl
    _ ≤ _ := sampled_exists_degree_upper_factor_le n M B hn hB hM

lemma degreeAggregateRegular_compl_le
    (n M : ℕ) (q eta B : ℝ)
    (hn : 0 < n) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (heta : 0 < eta) (hB : 1 ≤ B)
    (hM : 2 * M * M ≤ (allEdges n).card) :
    finsetProbability (sample n M)
        (fun H ↦ ¬ DegreeAggregateRegular n M q eta B H) ≤
      (4 / eta) * Real.exp (-(q^2 * ((M : ℝ) / n)) / 4) +
        (3 * n : ℝ) *
          (2 * Real.exp (((M : ℝ) / n) *
            (B - 1 - B * Real.log B))) := by
  calc
    finsetProbability (sample n M)
        (fun H ↦ ¬ DegreeAggregateRegular n M q eta B H) =
      finsetProbability (sample n M)
        (fun H ↦
          eta * (3 * n : ℝ) <
              (degreeRelativeBadVertices n M q H).card ∨
            ∃ v : Vertex n,
              B * ((M : ℝ) / n) < vertexDegree H v) := by
        apply finsetProbability_congr_event
        intro H _
        unfold DegreeAggregateRegular
        push Not
        constructor
        · intro h
          by_cases hbad :
              ((degreeRelativeBadVertices n M q H).card : ℝ) ≤
                eta * (3 * n : ℝ)
          · exact Or.inr (h hbad)
          · exact Or.inl (lt_of_not_ge hbad)
        · intro h hbad
          rcases h with hlarge | hmax
          · exact False.elim ((not_lt_of_ge hbad) hlarge)
          · exact hmax
    _ ≤
      finsetProbability (sample n M)
          (fun H ↦ eta * (3 * n : ℝ) ≤
            (degreeRelativeBadVertices n M q H).card) +
        finsetProbability (sample n M)
          (DegreeUpperFailure n M B) := by
      calc
        _ ≤ finsetProbability (sample n M)
            (fun H ↦
              eta * (3 * n : ℝ) ≤
                  (degreeRelativeBadVertices n M q H).card ∨
                DegreeUpperFailure n M B H) := by
              apply finsetProbability_mono_event
              intro H _ h
              apply h.imp le_of_lt
              intro hmax
              exact ⟨hmax.choose, hmax.choose_spec.le⟩
        _ ≤ _ := finsetProbability_or_le_add _ _ _
    _ ≤ _ := add_le_add
      (degreeRelativeBadVertices_proportion_le n M q eta
        hn hq0 hq1 heta hM)
      (sampled_exists_degree_upper_factor_sample_le n M B hn hB hM)


lemma vertexDegree_insert_eq_of_not_mem {n : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (v : Vertex n)
    (hv : v ∉ Z) :
    vertexDegree (insert Z H) v = vertexDegree H v := by
  unfold vertexDegree
  rw [Finset.filter_insert]
  simp [hv]

lemma degreeRelativeBadVertices_insert_subset {n M : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (q : ℝ)
    (hn : 0 < n) (hM : 0 < M) (hq0 : 0 ≤ q) :
    degreeRelativeBadVertices n (M + 1)
        (q + 2 * (n : ℝ) / M) (insert Z H) ⊆
      degreeRelativeBadVertices n M q H ∪ Z := by
  intro v hvbad
  by_contra hvunion
  have hvold : v ∉ degreeRelativeBadVertices n M q H := by
    intro hv
    exact hvunion (Finset.mem_union_left _ hv)
  have hvZ : v ∉ Z := by
    intro hv
    exact hvunion (Finset.mem_union_right _ hv)
  have hgoodOld : ¬ DegreeRelativeBad n M q v H := by
    intro hbad
    exact hvold (Finset.mem_filter.mpr ⟨Finset.mem_univ v, hbad⟩)
  have hlowerOld : (1 - q) * ((M : ℝ) / n) <
      (vertexDegree H v : ℝ) :=
    lt_of_not_ge (not_or.mp hgoodOld).1
  have hupperOld : (vertexDegree H v : ℝ) <
      (1 + q) * ((M : ℝ) / n) :=
    lt_of_not_ge (not_or.mp hgoodOld).2
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hMR : (0 : ℝ) < M := by exact_mod_cast hM
  have hscaleLower :
      (1 - (q + 2 * (n : ℝ) / M)) *
          (((M + 1 : ℕ) : ℝ) / n) ≤
        (1 - q) * ((M : ℝ) / n) := by
    norm_num only [Nat.cast_add, Nat.cast_one]
    have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
    have hfirst : (1 - q) / (n : ℝ) ≤ 1 := by
      apply (div_le_one hnR).2
      linarith
    have hsecond : 2 ≤ 2 * ((M : ℝ) + 1) / M := by
      apply (le_div_iff₀ hMR).2
      nlinarith
    calc
      (1 - (q + 2 * (n : ℝ) / M)) *
            (((M : ℝ) + 1) / n) =
          (1 - q) * ((M : ℝ) / n) +
            ((1 - q) / n - 2 * ((M : ℝ) + 1) / M) := by
        field_simp [hnR.ne', hMR.ne']
        ring
      _ ≤ (1 - q) * ((M : ℝ) / n) := by linarith
  have hscaleUpper :
      (1 + q) * ((M : ℝ) / n) ≤
        (1 + (q + 2 * (n : ℝ) / M)) *
          (((M + 1 : ℕ) : ℝ) / n) := by
    norm_num only [Nat.cast_add, Nat.cast_one]
    field_simp [hnR.ne', hMR.ne']
    nlinarith
  have hdegreeEq : vertexDegree (insert Z H) v = vertexDegree H v :=
    vertexDegree_insert_eq_of_not_mem H Z v hvZ
  have hgoodNew : ¬ DegreeRelativeBad n (M + 1)
      (q + 2 * (n : ℝ) / M) v (insert Z H) := by
    unfold DegreeRelativeBad
    rw [hdegreeEq]
    push Not
    constructor
    · exact hscaleLower.trans_lt hlowerOld
    · exact hupperOld.trans_le hscaleUpper
  exact hgoodNew (Finset.mem_filter.mp hvbad).2

lemma degreeAggregateRegular_insert {n M : ℕ}
    (H : Finset (Edge n)) (Z : Edge n) (q eta B : ℝ)
    (hn : 0 < n) (hM : 0 < M) (hq0 : 0 ≤ q) (hB0 : 0 ≤ B)
    (hZall : Z ∈ allEdges n) (hZnot : Z ∉ H)
    (hreg : DegreeAggregateRegular n M q eta B H) :
    DegreeAggregateRegular n (M + 1)
      (q + 2 * (n : ℝ) / M) (eta + 1 / (n : ℝ))
      (B + (n : ℝ) / M) (insert Z H) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hMR : (0 : ℝ) < M := by exact_mod_cast hM
  constructor
  · have hsub := degreeRelativeBadVertices_insert_subset H Z q hn hM hq0
    have hcard := Finset.card_le_card hsub
    have hunion := Finset.card_union_le (degreeRelativeBadVertices n M q H) Z
    have hbadNat :
        (degreeRelativeBadVertices n (M + 1)
          (q + 2 * (n : ℝ) / M) (insert Z H)).card ≤
        (degreeRelativeBadVertices n M q H).card + Z.card :=
      hcard.trans hunion
    have hbadR :
        ((degreeRelativeBadVertices n (M + 1)
          (q + 2 * (n : ℝ) / M) (insert Z H)).card : ℝ) ≤
        ((degreeRelativeBadVertices n M q H).card : ℝ) + Z.card := by
      exact_mod_cast hbadNat
    have hZcard : (Z.card : ℝ) = 3 := by
      exact_mod_cast mem_allEdges.mp hZall
    calc
      ((degreeRelativeBadVertices n (M + 1)
          (q + 2 * (n : ℝ) / M) (insert Z H)).card : ℝ) ≤
        ((degreeRelativeBadVertices n M q H).card : ℝ) + Z.card := hbadR
      _ ≤ eta * (3 * n : ℝ) + 3 := by
        rw [hZcard]
        linarith [hreg.1]
      _ = (eta + 1 / (n : ℝ)) * (3 * n : ℝ) := by
        field_simp [hnR.ne']
  · intro v
    have hstep : (vertexDegree (insert Z H) v : ℝ) ≤
        (vertexDegree H v : ℝ) + 1 := by
      exact_mod_cast vertexDegree_insert_le_add_one H Z v
    have hold := hreg.2 v
    have hscale :
        B * ((M : ℝ) / n) + 1 ≤
          (B + (n : ℝ) / M) *
            (((M + 1 : ℕ) : ℝ) / n) := by
      norm_num only [Nat.cast_add, Nat.cast_one]
      field_simp [hnR.ne', hMR.ne']
      nlinarith
    have hmiddle : (vertexDegree H v : ℝ) + 1 ≤
        B * ((M : ℝ) / n) + 1 := by linarith
    exact (hstep.trans hmiddle).trans hscale

lemma sum_localMatchingL1_le_of_totalEntropyDefect {n : ℕ}
    {H : Finset (Edge n)} (hH : H ⊆ allEdges n)
    (hPhi : (perfectMatchings n H).card ≠ 0) (D S : ℝ)
    (hdef : totalLocalEntropyDefect H ≤ D) (hS0 : 0 ≤ S)
    (hbudget : (3 * n : ℝ) * (4 * D) ≤ S ^ 2) :
    ∑ v : Vertex n, localMatchingL1 H v ≤ S := by
  have hsquare := sum_localMatchingL1_sq_le_card_mul_totalEntropyDefect
    n H hH hPhi
  have hright :
      (3 * n : ℝ) * (4 * totalLocalEntropyDefect H) ≤ S ^ 2 := by
    exact (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hdef
      (by norm_num)) (by positivity)).trans hbudget
  have hsum0 : 0 ≤ ∑ v : Vertex n, localMatchingL1 H v := by
    apply Finset.sum_nonneg
    intro v hv
    unfold localMatchingL1
    apply Finset.sum_nonneg
    intro A hA
    exact abs_nonneg _
  nlinarith [hsquare.trans hright]

lemma presentWeightSpread_of_countLower_error_aggregate {n M : ℕ}
    {H : Finset (Edge n)} (hn : 3 ≤ n) (hM : 0 < M)
    (hH : H ⊆ allEdges n) (hcard : H.card = M)
    (hPhi : (perfectMatchings n H).card ≠ 0)
    (C E q etaDeg B S delta etaSpread : ℝ)
    (hcount : KahnCountLower H C)
    (herror : matchingEntropyGenericityError H ≤ E)
    (hq0 : 0 ≤ q) (hB0 : 0 ≤ B)
    (haggregate : DegreeAggregateRegular n M q etaDeg B H)
    (hS0 : 0 ≤ S) (hdelta : 0 < delta)
    (hetaSpread : 0 ≤ etaSpread)
    (hlocalBudget :
      (3 * n : ℝ) *
          (4 * (3 * C * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤ S ^ 2)
    (hspreadBudget :
      S + (3 * n : ℝ) * (q + etaDeg * (1 + B)) ≤
        3 * etaSpread * delta * (n : ℝ)) :
    PresentWeightSpread H delta etaSpread := by
  let D : ℝ :=
    3 * C * (n : ℝ) + 12 * Real.sqrt n +
      10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
        Real.sqrt (3 * n : ℝ))
  have hfourth := matchingVertexGenericityFourthSum_le_of_errorBound
    (n := n) herror
  have hdef : totalLocalEntropyDefect H ≤ D := by
    apply (totalLocalEntropyDefect_le_of_countLower
      hn hH hPhi C hcount).trans
    dsimp only [D]
    gcongr
  have hlocal : ∑ v : Vertex n, localMatchingL1 H v ≤ S := by
    apply sum_localMatchingL1_le_of_totalEntropyDefect hH hPhi D S hdef hS0
    simpa only [D] using hlocalBudget
  have hdegree := degreeReciprocalL1_le_of_aggregateRegular
    H q etaDeg B (show 0 < n by omega) hM hcard hq0 hB0 haggregate
  exact presentWeightSpread_of_local_add_degreeL1 H hH hPhi delta etaSpread
    S ((3 * n : ℝ) * (q + etaDeg * (1 + B))) (show 0 < n by omega)
    hdelta hetaSpread hlocal hdegree hspreadBudget

/-- The predecessor predicate combining Kahn's refined deletion hypotheses
with the aggregate degree regularity stable under one insertion. -/
def RefinedAggregateInsertionGood (n M : ℕ) (a B : ℝ)
    (codegCap : ℕ) (C₀ q etaDeg Bdeg : ℝ)
    (H : Finset (Edge n)) : Prop :=
  RefinedInsertionGood n M a B codegCap C₀ H ∧
    DegreeAggregateRegular n M q etaDeg Bdeg H

lemma refinedAggregateInsertionGood_hasPerfectMatching {n M : ℕ}
    {a B C₀ q etaDeg Bdeg : ℝ} {codegCap : ℕ}
    {H : Finset (Edge n)}
    (h : RefinedAggregateInsertionGood n M a B codegCap C₀
      q etaDeg Bdeg H) :
    HasPerfectMatching n H :=
  refinedInsertionGood_hasPerfectMatching h.1

lemma refinedInsertionGood_presentWeightSpread_aggregate
    {n M codegCap : ℕ}
    {a B C₀ sigma E delta etaSpread q etaDeg Bdeg S : ℝ}
    (hn : 3 ≤ n) (hM : 0 < M)
    (hC0 : 0 ≤ C₀ + 1) (hsigma : 0 < sigma)
    (hratio :
      1 < ((3 * (M + 1) : ℕ) : ℝ) * sigma /
        ((18 * n * (codegCap + 1) : ℕ) : ℝ))
    (hE :
      (3 * n : ℝ) * Real.sqrt sigma +
          (3 * n : ℝ) * (C₀ + 1 + 14 + Real.log 2) /
            Real.log (((3 * (M + 1) : ℕ) : ℝ) * sigma /
              ((18 * n * (codegCap + 1) : ℕ) : ℝ)) ≤ E)
    (hq0 : 0 ≤ q) (hBdeg0 : 0 ≤ Bdeg) (hS0 : 0 ≤ S)
    (hdelta : 0 < delta) (hetaSpread : 0 ≤ etaSpread)
    (hlocalBudget :
      (3 * n : ℝ) *
          (4 * (3 * (C₀ + 1) * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤ S ^ 2)
    (hspreadBudget :
      S + (3 * n : ℝ) *
          ((q + 2 * (n : ℝ) / M) +
            (etaDeg + 1 / (n : ℝ)) *
              (1 + (Bdeg + (n : ℝ) / M))) ≤
        3 * etaSpread * delta * (n : ℝ))
    {H : Finset (Edge n)}
    (hGood : RefinedAggregateInsertionGood n M a B codegCap C₀
      q etaDeg Bdeg H)
    {Z : Edge n} (hZ : Z ∈ allEdges n \ H) :
    PresentWeightSpread (insert Z H) delta etaSpread := by
  rcases hGood with ⟨⟨hcoarse, hcount, hcodeg⟩, hAggregate⟩
  rcases Finset.mem_sdiff.mp hZ with ⟨hZall, hZnot⟩
  rcases mem_sample.mp hcoarse.1 with ⟨hHall, hHcard⟩
  have hGall : insert Z H ⊆ allEdges n := by
    intro A hA
    rcases Finset.mem_insert.mp hA with rfl | hAH
    · exact hZall
    · exact hHall hAH
  have hGcard : (insert Z H).card = M + 1 := by
    rw [Finset.card_insert_of_notMem hZnot, hHcard]
  have hGpm : HasPerfectMatching n (insert Z H) :=
    hasPerfectMatching_mono (Finset.subset_insert Z H) hcoarse.2.1
  have hPhi : (perfectMatchings n (insert Z H)).card ≠ 0 := by
    exact Finset.card_ne_zero.mpr
      (hasPerfectMatching_iff_perfectMatchings_nonempty.mp hGpm)
  have hcountInsert : KahnCountLower (insert Z H) (C₀ + 1) := by
    apply kahnCountLower_insert (show 0 < n by omega) hM hHcard hZnot
    · exact Finset.card_ne_zero.mpr
        (hasPerfectMatching_iff_perfectMatchings_nonempty.mp hcoarse.2.1)
    · exact hcount
  have hcodegInsert : ∀ u v : Vertex n, u ≠ v →
      vertexCodegree (insert Z H) u v ≤ codegCap + 1 := by
    intro u v huv
    exact (vertexCodegree_insert_le_add_one H Z u v).trans
      (Nat.add_le_add_right (hcodeg u v huv) 1)
  have hincident : (matchingIncidentPairs (insert Z H)).card =
      3 * (M + 1) := by
    rw [card_matchingIncidentPairs (insert Z H) hGall, hGcard]
  have herrorRaw := matchingEntropyGenericityError_le_of_countLower
    hn (show 0 < codegCap + 1 by omega) hGall hPhi hcodegInsert
    (C₀ + 1) sigma hC0 hsigma hcountInsert
    (by simpa only [hincident] using hratio)
  have herror : matchingEntropyGenericityError (insert Z H) ≤ E := by
    exact herrorRaw.trans (by simpa only [hincident] using hE)
  have haggregateInsert := degreeAggregateRegular_insert H Z
    q etaDeg Bdeg (show 0 < n by omega) hM hq0 hBdeg0 hZall hZnot
    hAggregate
  exact presentWeightSpread_of_countLower_error_aggregate
    hn (show 0 < M + 1 by omega) hGall hGcard hPhi
    (C₀ + 1) E (q + 2 * (n : ℝ) / M)
    (etaDeg + 1 / (n : ℝ)) (Bdeg + (n : ℝ) / M)
    S delta etaSpread hcountInsert herror
    (by positivity) (by positivity) haggregateInsert hS0 hdelta hetaSpread
    hlocalBudget hspreadBudget

lemma refinedAggregateInsertion_globalUpper_failure_probability_le
    {n M codegCap : ℕ}
    {a B C₀ sigma E delta etaSpread etaGlobal r q etaDeg Bdeg S : ℝ}
    (hn : 3 ≤ n) (hM : 0 < M)
    (hMtop : M < (allEdges n).card)
    (hC0 : 0 ≤ C₀ + 1) (hsigma : 0 < sigma)
    (hratio :
      1 < ((3 * (M + 1) : ℕ) : ℝ) * sigma /
        ((18 * n * (codegCap + 1) : ℕ) : ℝ))
    (hE :
      (3 * n : ℝ) * Real.sqrt sigma +
          (3 * n : ℝ) * (C₀ + 1 + 14 + Real.log 2) /
            Real.log (((3 * (M + 1) : ℕ) : ℝ) * sigma /
              ((18 * n * (codegCap + 1) : ℕ) : ℝ)) ≤ E)
    (hq0 : 0 ≤ q) (hBdeg0 : 0 ≤ Bdeg) (hS0 : 0 ≤ S)
    (hdelta : 0 < delta) (hetaSpread : 0 ≤ etaSpread)
    (hlocalBudget :
      (3 * n : ℝ) *
          (4 * (3 * (C₀ + 1) * (n : ℝ) + 12 * Real.sqrt n +
            10 * (Real.sqrt (Real.sqrt E * Real.sqrt (3 * n : ℝ)) *
              Real.sqrt (3 * n : ℝ)))) ≤ S ^ 2)
    (hspreadBudget :
      S + (3 * n : ℝ) *
          ((q + 2 * (n : ℝ) / M) +
            (etaDeg + 1 / (n : ℝ)) *
              (1 + (Bdeg + (n : ℝ) / M))) ≤
        3 * etaSpread * delta * (n : ℝ))
    (hu : (1 + delta) * ((n : ℝ) / (M + 1)) ≤ 1 / 2)
    (hr : 0 < r)
    (hglobalBudget : r + (M : ℝ) ≤
      etaGlobal * (allEdges n).card) :
    finsetProbability (sample n M)
        (fun H ↦ RefinedAggregateInsertionGood n M a B codegCap C₀
            q etaDeg Bdeg H ∧
          ¬ GlobalUpperWeightSpread n H (2 * (1 + delta)) etaGlobal) ≤
      etaSpread * (((allEdges n).card - M : ℕ) : ℝ) / r := by
  apply good_globalUpper_failure_probability_le
    (show 0 < n by omega) hM hMtop hdelta.le hetaSpread hr hu hglobalBudget
  · intro H hGood
    exact refinedAggregateInsertionGood_hasPerfectMatching hGood
  · intro H hHs hGood Z hZ
    exact refinedInsertionGood_presentWeightSpread_aggregate
      hn hM hC0 hsigma hratio hE hq0 hBdeg0 hS0 hdelta hetaSpread
      hlocalBudget hspreadBudget hGood hZ


end

