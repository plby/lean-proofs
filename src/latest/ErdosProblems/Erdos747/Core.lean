/-- A one-sided Chernoff bound for a bounded nonnegative function on a
finite uniform sample. -/
lemma finsetProbability_upper_tail_le {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b θ u : ℝ) (hs : s.Nonempty) (hb : 0 < b)
    (hW0 : ∀ x ∈ s, 0 ≤ W x) (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (hθ0 : 0 ≤ θ)
    (hθb : |θ * b| ≤ 1 / 2) :
    finsetProbability s
        (fun x ↦ u ≤ W x - finsetAverage s W) ≤
      Real.exp (θ^2 * a * b - θ * u) := by
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    s W (finsetAverage s W) θ u hs hθ0
  have hmgf := finsetAverage_exp_centered_le
    s W a b θ hs hb hW0 hWb hmean hθb
  have hexppos : 0 < Real.exp (θ * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf

/-- Chernoff upper tail for a sum of `t` independent draws from a finite
uniform population. -/
lemma iidSum_upper_tail_le {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b θ u : ℝ) (t : ℕ) (hs : s.Nonempty) (hb : 0 < b)
    (hW0 : ∀ x ∈ s, 0 ≤ W x) (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (hθ0 : 0 ≤ θ)
    (hθb : |θ * b| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun ω ↦ u ≤ iidSum W t ω - t * finsetAverage s W) ≤
      Real.exp (θ^2 * ((t : ℝ) * a) * b - θ * u) := by
  have hs0 := hs
  obtain ⟨x, hx⟩ := hs
  let x₀ : ↥s := ⟨x, hx⟩
  let ω₀ : IidSample s t := fun _ ↦ x₀
  have hsample :
      (Finset.univ : Finset (IidSample s t)).Nonempty :=
    ⟨ω₀, Finset.mem_univ ω₀⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (IidSample s t)) (iidSum W t)
    (t * finsetAverage s W) θ u hsample hθ0
  have hmgf := finsetAverage_exp_iidCenteredSum_le s W a b θ t hs0 hb
    hW0 hWb hmean hθb
  have hexppos : 0 < Real.exp (θ * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf

/-- Chernoff lower tail, obtained by applying the iid upper-tail bound to
the complementary statistic `b - W`. -/
lemma iidSum_lower_tail_le {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b θ u : ℝ) (t : ℕ) (hs : s.Nonempty) (hb : 0 < b)
    (hW0 : ∀ x ∈ s, 0 ≤ W x) (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : a ≤ finsetAverage s W) (hθ0 : 0 ≤ θ)
    (hθb : |θ * b| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun ω ↦ u ≤ t * finsetAverage s W - iidSum W t ω) ≤
      Real.exp (θ^2 * ((t : ℝ) * (b - a)) * b - θ * u) := by
  let Wc : α → ℝ := fun x ↦ b - W x
  have hcard : (0 : ℝ) < s.card := by
    exact_mod_cast Finset.card_pos.mpr hs
  have havgcomp : finsetAverage s Wc = b - finsetAverage s W := by
    unfold finsetAverage Wc
    rw [Finset.sum_sub_distrib, Finset.sum_const]
    simp only [nsmul_eq_mul]
    field_simp [hcard.ne']
  have hiidcomp : ∀ ω : IidSample s t,
      iidSum Wc t ω = t * b - iidSum W t ω := by
    intro ω
    unfold iidSum Wc
    rw [Finset.sum_sub_distrib, Finset.sum_const]
    simp only [nsmul_eq_mul, Finset.card_univ, Fintype.card_fin]
  have htail := iidSum_upper_tail_le s Wc (b - a) b θ u t hs hb
    (fun x hx ↦ sub_nonneg.mpr (hWb x hx))
    (fun x hx ↦ by dsimp [Wc]; linarith [hW0 x hx])
    (by rw [havgcomp]; linarith) hθ0 hθb
  have hfilter :
      (Finset.univ : Finset (IidSample s t)).filter
          (fun ω ↦ u ≤ t * finsetAverage s W - iidSum W t ω) =
        (Finset.univ : Finset (IidSample s t)).filter
          (fun ω ↦ u ≤ iidSum Wc t ω - t * finsetAverage s Wc) := by
    apply Finset.filter_congr
    intro ω _
    rw [hiidcomp ω, havgcomp]
    constructor <;> intro h <;> linarith
  unfold finsetProbability at htail ⊢
  rw [hfilter]
  exact htail

/-- Lower-tail Chernoff bound using the mean-sensitive MGF of `W` itself.
Unlike the complementary-statistic form above, its exponent scales with a
small upper bound on the mean; this is the form needed for sparse vertex and
codegree counts. -/
lemma iidSum_lower_tail_le_mean {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b theta u : ℝ) (t : ℕ) (hs : s.Nonempty)
    (hb : 0 < b) (hW0 : ∀ x ∈ s, 0 ≤ W x)
    (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (htheta0 : 0 ≤ theta)
    (hthetab : |theta * b| ≤ 1 / 2) :
    finsetProbability (Finset.univ : Finset (IidSample s t))
        (fun omega ↦ u ≤ t * finsetAverage s W - iidSum W t omega) ≤
      Real.exp (theta^2 * ((t : ℝ) * a) * b - theta * u) := by
  obtain ⟨x, hx⟩ := hs
  let x0 : ↥s := ⟨x, hx⟩
  let omega0 : IidSample s t := fun _ ↦ x0
  have hsample :
      (Finset.univ : Finset (IidSample s t)).Nonempty :=
    ⟨omega0, Finset.mem_univ omega0⟩
  have hmarkov := finsetProbability_mul_exp_le_average_exp
    (Finset.univ : Finset (IidSample s t))
    (fun omega ↦ t * finsetAverage s W - iidSum W t omega) 0
    theta u hsample htheta0
  simp only [sub_zero] at hmarkov
  have hthetaneg : |(-theta) * b| ≤ 1 / 2 := by
    simpa only [neg_mul, abs_neg] using hthetab
  have hmgf := finsetAverage_exp_iidCenteredSum_le
    s W a b (-theta) t ⟨x, hx⟩ hb hW0 hWb hmean hthetaneg
  have hexponent : ∀ omega : IidSample s t,
      -(theta * (iidSum W t omega - t * finsetAverage s W)) =
        theta * (t * finsetAverage s W - iidSum W t omega) := by
    intro omega
    ring
  rw [show (-theta)^2 = theta^2 by ring] at hmgf
  simp_rw [neg_mul, hexponent] at hmgf
  have hmgf' :
      finsetAverage (Finset.univ : Finset (IidSample s t))
          (fun omega ↦ Real.exp
            (theta * (t * finsetAverage s W - iidSum W t omega))) ≤
        Real.exp (theta^2 * ((t : ℝ) * a) * b) := by
    exact hmgf
  have hexppos : 0 < Real.exp (theta * u) := Real.exp_pos _
  rw [Real.exp_sub]
  apply (le_div_iff₀ hexppos).2
  exact hmarkov.trans hmgf'

/-- The iid Chernoff upper tail transferred to uniform ordered sampling
without replacement. -/
lemma embeddingSum_upper_tail_le {α : Type*} (s : Finset α)
    (W : α → ℝ) (a b θ u : ℝ) (t : ℕ) (hs : s.Nonempty) (hb : 0 < b)
    (hW0 : ∀ x ∈ s, 0 ≤ W x) (hWb : ∀ x ∈ s, W x ≤ b)
    (hmean : finsetAverage s W ≤ a) (hθ0 : 0 ≤ θ)
    (hθb : |θ * b| ≤ 1 / 2) (ht : 2 * t * t ≤ s.card) :
    finsetProbability (Finset.univ : Finset (Fin t ↪ ↥s))
        (fun e ↦ u ≤ iidSum W t e - t * finsetAverage s W) ≤
      2 * Real.exp (θ^2 * ((t : ℝ) * a) * b - θ * u) := by
  let P : (Fin t ↪ ↥s) → Prop :=
    fun e ↦ u ≤ iidSum W t e - t * finsetAverage s W
