theorem check0 : checkRowSparse parents children 0 row0 = true := by
  decide

def rows : List Blob := [row0]

theorem rowsValid : Packed.SparseRowsValidFrom parents children 0 rows := by
  exact Packed.SparseRowsValidFrom.cons check0
