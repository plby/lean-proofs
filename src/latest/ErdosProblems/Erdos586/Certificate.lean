import ErdosProblems.Erdos586.PrimeStages
import ErdosProblems.Erdos586.Sieve

namespace Erdos586.Certificate

def scale : ℕ := 10_000

/-- The positive integer denominator in one fixed-`1/5` certificate update,
before checking that the subtraction is legal. -/
def stepDenominator (u p : ℕ) : ℕ :=
  16 * scale * (p - 1) ^ 2 - 25 * u

/-- The numerator of the scaled fixed-`1/5` recurrence update. -/
def stepNumerator (u p : ℕ) : ℕ :=
  4 * scale * u * (4 * (p - 1) ^ 2 + 15 * p - 5)

/-- Ceiling division used to round an exact real recurrence value upwards. -/
def roundedNext (u p : ℕ) : ℕ :=
  (stepNumerator u p + stepDenominator u p - 1) / stepDenominator u p

def roundedStep? (state : Option ℕ) (p : ℕ) : Option ℕ := do
  let u ← state
  let q := p - 1
  let d0 := 16 * scale * q ^ 2
  let d1 := 25 * u
  if d1 < d0 then
    some (roundedNext u p)
  else none

def primeChunk (spec : ℕ × ℕ) : List ℕ :=
  (List.range' spec.1 spec.2).filter Nat.Prime

def runChunk (spec : ℕ × ℕ) (state : Option ℕ) : Option ℕ :=
  let ps := primeChunk spec
  let ps := if spec.1 = 0 then ps.drop 3 else ps
  ps.foldl roundedStep? state

def runChunks : List (ℕ × ℕ) → Option ℕ → Option ℕ
  | [], state => state
  | spec :: specs, state => runChunks specs (runChunk spec state)

