/-! ## Kernel-checked transport from the integer run to the real recurrence -/

lemma scale_pos : 0 < scale := by norm_num [scale]

/-- The recurrence used by the certificate is the BBMST recurrence with the
constant distortion parameter `1/5`. -/
noncomputable def fixedRecurrence (p x : ℝ) : ℝ := recurrenceMap p (1 / 5) x

lemma fixedRecurrence_nonneg {p x : ℝ} (hp : 1 < p) (hx : 0 ≤ x)
    (hvalid : lossRatio p (1 / 5) x < 1) :
    0 ≤ fixedRecurrence p x := by
  have hfac : 0 ≤ sieveFactor p (1 / 5) :=
    (sieveFactor_pos hp (by norm_num)).le
  have hden : 0 < 1 - lossRatio p (1 / 5) x := by linarith
  exact div_nonneg (mul_nonneg hx hfac) hden.le

/-- Positivity of the integer guard is exactly positivity of the denominator
used by the real recurrence at the rounded incoming state. -/
lemma guard_gives_valid {u p : ℕ} (hp : 2 ≤ p)
    (hguard : 25 * u < 16 * scale * (p - 1) ^ 2) :
    lossRatio (p : ℝ) (1 / 5) ((u : ℝ) / scale) < 1 := by
  have hqNat : 1 ≤ p := by omega
  have hq : (0 : ℝ) < (p : ℝ) - 1 := by
    have hp' : (2 : ℝ) ≤ p := Nat.cast_le.2 hp
    linarith
  have hscale : (0 : ℝ) < scale := by exact_mod_cast scale_pos
  have hguard' : (25 : ℝ) * u < 16 * scale * ((p : ℝ) - 1) ^ 2 := by
    have hc : ((25 * u : ℕ) : ℝ) <
        ((16 * scale * (p - 1) ^ 2 : ℕ) : ℝ) := Nat.cast_lt.2 hguard
    push_cast [Nat.cast_sub hqNat] at hc
    exact hc
  have hformula :
      lossRatio (p : ℝ) (1 / 5) ((u : ℝ) / scale) =
        25 * (u : ℝ) /
          (16 * (scale : ℝ) * ((p : ℝ) - 1) ^ 2) := by
    unfold lossRatio stageB
    norm_num
    field_simp [hq.ne', hscale.ne']
    ring
  rw [hformula, div_lt_iff₀ (by positivity)]
  nlinarith

/-- The natural-number ceiling stored by `roundedNext` really lies above the
corresponding exact quotient. -/
lemma stepQuotient_le_roundedNext {u p : ℕ}
    (hguard : 25 * u < 16 * scale * (p - 1) ^ 2) :
    (stepNumerator u p : ℝ) / stepDenominator u p ≤ roundedNext u p := by
  have hd : 0 < stepDenominator u p := by
    simpa [stepDenominator] using Nat.sub_pos_of_lt hguard
  have hmul : stepNumerator u p ≤ stepDenominator u p * roundedNext u p := by
    have hceil := (ceilDiv_le_iff_le_mul
      (a := stepDenominator u p) (b := stepNumerator u p)
      (c := stepNumerator u p ⌈/⌉ stepDenominator u p) hd).1 le_rfl
    simpa [roundedNext, Nat.ceilDiv_eq_add_pred_div] using hceil
  rw [div_le_iff₀ (by exact_mod_cast hd)]
  exact_mod_cast (by simpa [mul_comm] using hmul)

/-- Algebraic identification between the exact real recurrence at `u/scale`
and the integer quotient rounded by `roundedNext`. -/
lemma fixedRecurrence_scaled_eq {u p : ℕ} (hp : 2 ≤ p)
    (hguard : 25 * u < 16 * scale * (p - 1) ^ 2) :
    fixedRecurrence p ((u : ℝ) / scale) =
      ((stepNumerator u p : ℝ) / stepDenominator u p) / scale := by
  have hqNat : 1 ≤ p := by omega
  have hq : (0 : ℝ) < (p : ℝ) - 1 := by
    have hp' : (2 : ℝ) ≤ p := Nat.cast_le.2 hp
    linarith
  have hscale : (0 : ℝ) < scale := by exact_mod_cast scale_pos
  have hdNat : 0 < stepDenominator u p := by
    simpa [stepDenominator] using Nat.sub_pos_of_lt hguard
  have hd : (0 : ℝ) < stepDenominator u p := by exact_mod_cast hdNat
  have hqcast : ((p - 1 : ℕ) : ℝ) = (p : ℝ) - 1 := by
    rw [Nat.cast_sub hqNat]
    norm_num
  have hinner : 5 ≤ 4 * (p - 1) ^ 2 + 15 * p := by omega
  have hnumcast : (stepNumerator u p : ℝ) =
      4 * scale * u * (4 * ((p : ℝ) - 1) ^ 2 + 15 * p - 5) := by
    unfold stepNumerator
    push_cast [Nat.cast_sub hinner, Nat.cast_sub hqNat]
    rfl
  have hdcast : (stepDenominator u p : ℝ) =
      16 * scale * ((p : ℝ) - 1) ^ 2 - 25 * u := by
    unfold stepDenominator
    push_cast [Nat.cast_sub (Nat.le_of_lt hguard), Nat.cast_sub hqNat]
    rfl
  have hdreal : (0 : ℝ) <
      16 * scale * ((p : ℝ) - 1) ^ 2 - 25 * u := by
    rw [← hdcast]
    exact hd
  unfold fixedRecurrence recurrenceMap sieveFactor stageA lossRatio stageB
  rw [hnumcast, hdcast]
  norm_num
  field_simp [hq.ne', hscale.ne', hdreal.ne']
  ring

/-- One successful computed update certifies one exact real recurrence
update.  This is the bridge from the kernel computation to the analytic
inequalities. -/
theorem roundedStep_sound {u v p : ℕ} (hp : 2 ≤ p)
    (hstep : roundedStep? (some u) p = some v) :
    lossRatio (p : ℝ) (1 / 5) ((u : ℝ) / scale) < 1 ∧
      fixedRecurrence p ((u : ℝ) / scale) ≤ (v : ℝ) / scale := by
  have hguard : 25 * u < 16 * scale * (p - 1) ^ 2 := by
    by_contra h
    have hn : ¬ 25 * u < 16 * scale * (p - 1) ^ 2 := h
    simp [roundedStep?, hn] at hstep
  have hv : v = roundedNext u p := by
    simpa [roundedStep?, hguard] using hstep.symm
  constructor
  · exact guard_gives_valid hp hguard
  · rw [hv, fixedRecurrence_scaled_eq hp hguard]
    exact div_le_div_of_nonneg_right (stepQuotient_le_roundedNext hguard)
      (by positivity)

/-- Monotonicity transports both denominator validity and a rounded update
from its stored upper endpoint to every smaller nonnegative incoming value. -/
theorem roundedStep_transport_valid {u v p : ℕ} {x : ℝ} (hp : 2 ≤ p)
    (hx : 0 ≤ x) (hxu : x ≤ (u : ℝ) / scale)
    (hstep : roundedStep? (some u) p = some v) :
    lossRatio (p : ℝ) (1 / 5) x < 1 ∧
      fixedRecurrence p x ≤ (v : ℝ) / scale := by
  obtain ⟨hvalid, hbound⟩ := roundedStep_sound hp hstep
  have hpReal : (1 : ℝ) < p := by
    have hp' : (2 : ℝ) ≤ p := Nat.cast_le.2 hp
    linarith
  have hloss : lossRatio (p : ℝ) (1 / 5) x ≤
      lossRatio (p : ℝ) (1 / 5) ((u : ℝ) / scale) := by
    unfold lossRatio
    exact div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left hxu (stageB_pos hpReal).le) (by norm_num)
  constructor
  · exact hloss.trans_lt hvalid
  · exact (recurrenceMap_mono hpReal
      (by norm_num) (by norm_num) hx hxu hvalid).trans hbound

theorem roundedStep_transport {u v p : ℕ} {x : ℝ} (hp : 2 ≤ p)
    (hx : 0 ≤ x) (hxu : x ≤ (u : ℝ) / scale)
    (hstep : roundedStep? (some u) p = some v) :
    fixedRecurrence p x ≤ (v : ℝ) / scale :=
  (roundedStep_transport_valid hp hx hxu hstep).2

/-! ### Transport through an arbitrary finite list of certified primes -/

/-- The actual prime list processed by one generated interval.  The first
three primes are omitted because the finite run starts after stages `2,3,5`. -/
def chunkPrimes (spec : ℕ × ℕ) : List ℕ :=
  let ps := primeChunk spec
  if spec.1 = 0 then ps.drop 3 else ps

/-- Prime list represented by one generated group. -/
def groupPrimes (group : List (ℕ × ℕ)) : List ℕ :=
  group.flatMap chunkPrimes

/-- The 9,997 primes from `7` through the 10,000th prime used by the
certificate. -/
def certificatePrimes : List ℕ :=
  allGroups.flatMap groupPrimes

lemma runChunk_eq_fold (spec : ℕ × ℕ) (state : Option ℕ) :
    runChunk spec state = (chunkPrimes spec).foldl roundedStep? state := by
  rfl

lemma runChunks_eq_fold (specs : List (ℕ × ℕ)) (state : Option ℕ) :
    runChunks specs state = (groupPrimes specs).foldl roundedStep? state := by
  induction specs generalizing state with
  | nil => rfl
  | cons spec specs ih =>
      simp only [runChunks, groupPrimes, List.flatMap_cons, List.foldl_append,
        runChunk_eq_fold]
      exact ih _

lemma runGroups_eq_fold (groups : List (List (ℕ × ℕ))) (state : Option ℕ) :
    runGroups groups state =
      (groups.flatMap groupPrimes).foldl roundedStep? state := by
  induction groups generalizing state with
  | nil => rfl
  | cons group groups ih =>
      simp only [runGroups, List.flatMap_cons, List.foldl_append,
        runChunks_eq_fold]
      exact ih _

lemma prime_of_mem_primeChunk {p : ℕ} {spec : ℕ × ℕ}
    (hp : p ∈ primeChunk spec) : Nat.Prime p := by
  exact of_decide_eq_true (List.mem_filter.mp hp).2

lemma prime_of_mem_chunkPrimes {p : ℕ} {spec : ℕ × ℕ}
    (hp : p ∈ chunkPrimes spec) : Nat.Prime p := by
  unfold chunkPrimes at hp
  split at hp
  · exact prime_of_mem_primeChunk ((List.drop_sublist 3 _).mem hp)
  · exact prime_of_mem_primeChunk hp

lemma prime_of_mem_groupPrimes {p : ℕ} {group : List (ℕ × ℕ)}
    (hp : p ∈ groupPrimes group) : Nat.Prime p := by
  rw [groupPrimes, List.mem_flatMap] at hp
  obtain ⟨spec, _, hp⟩ := hp
  exact prime_of_mem_chunkPrimes hp

lemma prime_of_mem_certificatePrimes {p : ℕ}
    (hp : p ∈ certificatePrimes) : Nat.Prime p := by
  rw [certificatePrimes, List.mem_flatMap] at hp
  obtain ⟨group, _, hp⟩ := hp
  exact prime_of_mem_groupPrimes hp

lemma roundedFold_none (ps : List ℕ) :
    ps.foldl roundedStep? none = none := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
      simpa [roundedStep?] using ih

/-- A sequence of real values which follows the one-step recurrence
inequalities along a specified list of primes.  Nonnegativity is recorded at
each intermediate value because it is precisely the domain used by the sieve
monotonicity lemma. -/
inductive RecurrenceChain : List ℕ → ℝ → ℝ → Prop
  | nil (x : ℝ) : RecurrenceChain [] x x
  | cons {p : ℕ} {ps : List ℕ} {x y z : ℝ}
      (hy0 : 0 ≤ y) (hy : y ≤ fixedRecurrence p x)
      (tail : RecurrenceChain ps y z) : RecurrenceChain (p :: ps) x z

/-- Generic rounded-certificate transport.  Every successful kernel-computed
integer fold bounds every nonnegative real recurrence chain along the same
prime list. -/
theorem recurrenceChain_le_of_fold
    {ps : List ℕ} {u v : ℕ} {x z : ℝ}
    (hprime : ∀ p ∈ ps, 2 ≤ p)
    (hrun : ps.foldl roundedStep? (some u) = some v)
    (hx0 : 0 ≤ x) (hxu : x ≤ (u : ℝ) / scale)
    (hchain : RecurrenceChain ps x z) :
    z ≤ (v : ℝ) / scale := by
  induction hchain generalizing u v with
  | nil x =>
      simp only [List.foldl_nil, Option.some.injEq] at hrun
      subst v
      exact hxu
  | @cons p ps x y z hy0 hy htail ih =>
      have hp : 2 ≤ p := hprime p (by simp)
      have hprimeTail : ∀ q ∈ ps, 2 ≤ q := by
        intro q hq
        exact hprime q (by simp [hq])
      cases hfirst : roundedStep? (some u) p with
      | none =>
          have hnone : ps.foldl roundedStep? none = none := roundedFold_none ps
          simp only [List.foldl_cons, hfirst, hnone] at hrun
          cases hrun
      | some w =>
          have hrec : fixedRecurrence p x ≤ (w : ℝ) / scale :=
            roundedStep_transport hp hx0 hxu hfirst
          have hyw : y ≤ (w : ℝ) / scale := hy.trans hrec
          have htailRun : ps.foldl roundedStep? (some w) = some v := by
            simpa only [List.foldl_cons, hfirst] using hrun
          exact ih hprimeTail htailRun hy0 hyw

theorem certificatePrimes_run :
    certificatePrimes.foldl roundedStep? (some 25_500) =
      some 126_023_262 := by
  unfold certificatePrimes
  rw [← runGroups_eq_fold]
  simpa [roundedCertificate] using roundedCertificate_eq

/-- Packaged finite certificate in the form used by the sieve: any
nonnegative recurrence chain whose stage-three value is at most `51/20` and
which follows the checked prime list ends below 13,000. -/
theorem recurrenceChain_certificate_lt_of_le {x z : ℝ}
    (hx0 : 0 ≤ x) (hx : x ≤ 51 / 20)
    (hchain : RecurrenceChain certificatePrimes x z) :
    z < 13_000 := by
  have hle : z ≤ (126_023_262 : ℝ) / scale := by
    apply recurrenceChain_le_of_fold
      (ps := certificatePrimes) (u := 25_500) (v := 126_023_262)
    · intro p hp
      exact (prime_of_mem_certificatePrimes hp).two_le
    · exact certificatePrimes_run
    · exact hx0
    · norm_num [scale] at hx ⊢
      exact hx
    · exact hchain
  norm_num [scale] at hle ⊢
  linarith

theorem recurrenceChain_certificate_lt {z : ℝ}
    (hchain : RecurrenceChain certificatePrimes (51 / 20) z) :
    z < 13_000 := by
  exact recurrenceChain_certificate_lt_of_le (by norm_num) le_rfl hchain

/-- Underlying unfiltered interval represented by one generated chunk. -/
def rawChunk (spec : ℕ × ℕ) : List ℕ := List.range' spec.1 spec.2

/-- Concatenation of the underlying intervals represented by a group. -/
def rawGroup (group : List (ℕ × ℕ)) : List ℕ := group.flatMap rawChunk

lemma chunkPrimes_eq_filter_rawChunk {spec : ℕ × ℕ} (hstart : spec.1 ≠ 0) :
    chunkPrimes spec = (rawChunk spec).filter Nat.Prime := by
  simp [chunkPrimes, primeChunk, rawChunk, hstart]

lemma groupPrimes_eq_filter_rawGroup {group : List (ℕ × ℕ)}
    (hstart : ∀ spec ∈ group, spec.1 ≠ 0) :
    groupPrimes group = (rawGroup group).filter Nat.Prime := by
  induction group with
  | nil => rfl
  | cons spec group ih =>
      have hs : spec.1 ≠ 0 := hstart spec (by simp)
      have ht : ∀ q ∈ group, q.1 ≠ 0 := by
        intro q hq
        exact hstart q (by simp [hq])
      simp only [groupPrimes, rawGroup, List.flatMap_cons]
      change (chunkPrimes spec ++ groupPrimes group) =
        (rawChunk spec ++ rawGroup group).filter Nat.Prime
      rw [chunkPrimes_eq_filter_rawChunk hs, ih ht, List.filter_append]

