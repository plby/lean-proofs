    groupPrimes group_000 = ((List.range' 0 1024).filter Nat.Prime).drop 3 := by
  have htail : ∀ spec ∈ group_000.tail, spec.1 ≠ 0 := by decide
  have hlen : 3 ≤ (primeChunk (0, 32)).length := by
    rw [primes_0000]
    norm_num
  rw [show groupPrimes group_000 =
      (primeChunk (0, 32)).drop 3 ++ groupPrimes group_000.tail by rfl]
  rw [groupPrimes_eq_filter_rawGroup htail]
  rw [← List.drop_append_of_le_length hlen]
  change (((rawChunk (0, 32)).filter Nat.Prime ++
    (rawGroup group_000.tail).filter Nat.Prime).drop 3) = _
  rw [← List.filter_append]
  change ((rawGroup group_000).filter Nat.Prime).drop 3 = _
  rw [raw_group_000]

