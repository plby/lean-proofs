lemma filter_prime_range_eq_map_nth (n : ℕ) :
    (List.range n).filter Nat.Prime =
      (List.range (Nat.count Nat.Prime n)).map (Nat.nth Nat.Prime) := by
  induction n with
  | zero => simp
  | succ n ih =>
      by_cases hn : Nat.Prime n
      · simp [List.range_succ, ih, Nat.count_succ, hn, Nat.nth_count hn]
      · simp [List.range_succ, ih, Nat.count_succ, hn]

lemma prime_count_104730 : Nat.count Nat.Prime 104730 = 10000 := by
  have hrange : List.Sublist (List.range' 0 1024) (List.range' 0 104730) :=
    List.range'_sublist_right.2 (by norm_num)
  have hfiltered := (hrange.filter Nat.Prime).length_le
  have hsmall : 3 ≤ ((List.range' 0 1024).filter Nat.Prime).length := by
    have hprefix : List.Sublist (List.range' 0 32) (List.range' 0 1024) :=
      List.range'_sublist_right.2 (by norm_num)
    have hprefixFiltered := (hprefix.filter Nat.Prime).length_le
    have hprefixLength : ((List.range' 0 32).filter Nat.Prime).length = 11 := by
      simpa [primeChunk] using congrArg List.length primes_0000
    rw [hprefixLength] at hprefixFiltered
    omega
  have hlarge : 3 ≤ ((List.range' 0 104730).filter Nat.Prime).length :=
    hsmall.trans hfiltered
  have hdrop :
      (((List.range' 0 104730).filter Nat.Prime).drop 3).length = 9997 := by
    rw [← certificatePrimes_eq_filtered_range, certificatePrimes_length]
  have hfull : ((List.range' 0 104730).filter Nat.Prime).length = 10000 := by
    simp only [List.length_drop] at hdrop
    omega
  have hcount := filter_prime_range_eq_map_nth 104730
  have hlens := congrArg List.length hcount
  simp only [List.length_map, List.length_range] at hlens
  rw [← List.range_eq_range'] at hfull
  omega

/-- The generated and kernel-checked prime list is exactly the ordered list
of stage primes 4 through 10,000.  This is the completeness bridge needed to
turn the abstract stage recurrence into `RecurrenceChain`. -/
theorem certificatePrimes_eq_stagePrimes :
    certificatePrimes =
      (List.range 9997).map (fun j ↦ stagePrime (j + 4)) := by
  rw [certificatePrimes_eq_filtered_range]
  rw [← List.range_eq_range']
  rw [filter_prime_range_eq_map_nth, prime_count_104730]
  rw [← List.map_drop, List.range_eq_range', List.drop_range']
  norm_num only
  apply List.ext_getElem
  · simp
  · intro i hleft hright
    simp [stagePrime, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]

theorem certificatePrimes_eq_stageRange :
    certificatePrimes = (List.range' 4 9997).map stagePrime := by
  rw [certificatePrimes_eq_stagePrimes]
  apply List.ext_getElem
  · simp
  · intro i hleft hright
    simp [Nat.add_comm]

/-- A successful rounded fold supplies the denominator hypothesis needed to
invoke each conditional one-step estimate, then propagates the resulting
bound to the next step.  This avoids any circular assumption of denominator
validity in the concrete sieve. -/
theorem conditionalRecurrenceChain_of_fold
    {ps : List ℕ} {u v : ℕ} (f : ℕ → ℝ)
    (hprime : ∀ p ∈ ps, 2 ≤ p)
    (hrun : ps.foldl roundedStep? (some u) = some v)
    (hf0 : 0 ≤ f 0) (hfu : f 0 ≤ (u : ℝ) / scale)
    (hstep : ∀ i : Fin ps.length,
      0 ≤ f i → lossRatio (ps.get i : ℝ) (1 / 5) (f i) < 1 →
        0 ≤ f (i + 1) ∧
          f (i + 1) ≤ fixedRecurrence (ps.get i) (f i)) :
    (∀ i : Fin ps.length,
      lossRatio (ps.get i : ℝ) (1 / 5) (f i) < 1) ∧
      RecurrenceChain ps (f 0) (f ps.length) ∧
        0 ≤ f ps.length ∧ f ps.length ≤ (v : ℝ) / scale := by
  induction ps generalizing f u v with
  | nil =>
      simp only [List.foldl_nil, Option.some.injEq] at hrun
      subst v
      exact ⟨fun i ↦ Fin.elim0 i, RecurrenceChain.nil _, hf0, hfu⟩
  | cons p ps ih =>
      have hp : 2 ≤ p := hprime p (by simp)
      have hprimeTail : ∀ q ∈ ps, 2 ≤ q := by
        intro q hq
        exact hprime q (by simp [hq])
      cases hfirst : roundedStep? (some u) p with
      | none =>
          have hnone : ps.foldl roundedStep? none = none := roundedFold_none ps
          simp only [List.foldl_cons, hfirst, hnone] at hrun
          cases hrun
      | some w =>
          obtain ⟨hvalid, hrec⟩ := roundedStep_transport_valid hp hf0 hfu hfirst
          have hhead := hstep ⟨0, by simp⟩
          have hhead' : 0 ≤ f 1 ∧
              f 1 ≤ fixedRecurrence p (f 0) := by
            simpa using hhead hf0 hvalid
          have htailRun : ps.foldl roundedStep? (some w) = some v := by
            simpa only [List.foldl_cons, hfirst] using hrun
          have hstepTail : ∀ i : Fin ps.length,
              0 ≤ f (i + 1) →
                lossRatio (ps.get i : ℝ) (1 / 5) (f (i + 1)) < 1 →
                0 ≤ f (i + 2) ∧
                  f (i + 2) ≤ fixedRecurrence (ps.get i) (f (i + 1)) := by
            intro i hnonneg hi
            simpa [Nat.add_assoc] using hstep (Fin.succ i) hnonneg hi
          obtain ⟨hvalidTail, htail, hend0, hbound⟩ := ih
            (f := fun j ↦ f (j + 1))
            hprimeTail htailRun hhead'.1 (hhead'.2.trans hrec) hstepTail
          refine ⟨?_, ?_, ?_, ?_⟩
          · intro i
            refine Fin.cases hvalid (fun j ↦ ?_) i
            simpa using hvalidTail j
          · simpa [Nat.add_assoc] using
              (RecurrenceChain.cons hhead'.1 hhead'.2 htail)
          · simpa [Nat.add_assoc] using hend0
          · simpa [Nat.add_assoc] using hbound

/-- The conditional form consumed by the concrete sieve: starting below the
stage-three bound, it proves every needed denominator valid as it traverses
the checked list and yields the finite bound at its end. -/
theorem conditional_certificate_valid_chain_and_lt
    (f : ℕ → ℝ) (hf0 : 0 ≤ f 0) (hbase : f 0 ≤ 51 / 20)
    (hstep : ∀ i : Fin certificatePrimes.length,
      0 ≤ f i →
        lossRatio (certificatePrimes.get i : ℝ) (1 / 5) (f i) < 1 →
        0 ≤ f (i + 1) ∧
          f (i + 1) ≤
            fixedRecurrence (certificatePrimes.get i) (f i)) :
    (∀ i : Fin certificatePrimes.length,
      lossRatio (certificatePrimes.get i : ℝ) (1 / 5) (f i) < 1) ∧
      RecurrenceChain certificatePrimes (f 0) (f certificatePrimes.length) ∧
        0 ≤ f certificatePrimes.length ∧
          f certificatePrimes.length < 13_000 := by
  obtain ⟨hvalid, hchain, hend0, hbound⟩ := conditionalRecurrenceChain_of_fold f
    (fun p hp ↦ (prime_of_mem_certificatePrimes hp).two_le)
    certificatePrimes_run hf0 (by
      norm_num [scale] at hbase ⊢
      exact hbase) hstep
  refine ⟨hvalid, hchain, hend0, ?_⟩
  norm_num [scale] at hbound ⊢
  linarith

theorem conditional_certificate_valid_and_lt
    (f : ℕ → ℝ) (hf0 : 0 ≤ f 0) (hbase : f 0 ≤ 51 / 20)
    (hstep : ∀ i : Fin certificatePrimes.length,
      0 ≤ f i →
        lossRatio (certificatePrimes.get i : ℝ) (1 / 5) (f i) < 1 →
        0 ≤ f (i + 1) ∧
          f (i + 1) ≤
            fixedRecurrence (certificatePrimes.get i) (f i)) :
    (∀ i : Fin certificatePrimes.length,
      lossRatio (certificatePrimes.get i : ℝ) (1 / 5) (f i) < 1) ∧
      f certificatePrimes.length < 13_000 := by
  obtain ⟨hvalid, _, _, hlt⟩ :=
    conditional_certificate_valid_chain_and_lt f hf0 hbase hstep
  exact ⟨hvalid, hlt⟩

theorem conditional_certificate_lt
    (f : ℕ → ℝ) (hf0 : 0 ≤ f 0) (hbase : f 0 ≤ 51 / 20)
    (hstep : ∀ i : Fin certificatePrimes.length,
      0 ≤ f i →
        lossRatio (certificatePrimes.get i : ℝ) (1 / 5) (f i) < 1 →
        0 ≤ f (i + 1) ∧
          f (i + 1) ≤
            fixedRecurrence (certificatePrimes.get i) (f i)) :
    f certificatePrimes.length < 13_000 :=
  (conditional_certificate_valid_and_lt f hf0 hbase hstep).2



