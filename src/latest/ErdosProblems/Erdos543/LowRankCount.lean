import Mathlib

/-!
# Counting matrices with restricted columns

This file isolates the finite counting part of the low-rank incidence-matrix
argument for Erdős Problem 543.  The linear-algebraic input (a bound for the
intersection of a subspace with the Boolean cube) is deliberately exposed as
a hypothesis.  Everything after that input is an exact finite-cardinality
argument.
-/

open scoped BigOperators
open Finset

namespace Erdos543

attribute [local instance] Classical.propDecidable

section Columns

variable {r k : ℕ} {α : Type*}

/-- A matrix is equivalently the family of its columns. -/
def matrixColumnsEquiv :
    Matrix (Fin r) (Fin k) α ≃ (Fin k → Fin r → α) where
  toFun M j i := M i j
  invFun C i j := C j i
  left_inv _ := rfl
  right_inv _ := rfl

/-- All `r × k` matrices whose columns belong to the finite set `Γ`. -/
noncomputable def matricesWithColumns (Γ : Finset (Fin r → α)) :
    Finset (Matrix (Fin r) (Fin k) α) := by
  classical
  exact (Fintype.piFinset (fun _ : Fin k ↦ Γ)).map
    matrixColumnsEquiv.symm.toEmbedding

@[simp] lemma mem_matricesWithColumns [DecidableEq α]
    {Γ : Finset (Fin r → α)} {M : Matrix (Fin r) (Fin k) α} :
    M ∈ matricesWithColumns Γ ↔ ∀ j, (fun i ↦ M i j) ∈ Γ := by
  classical
  simp [matricesWithColumns, matrixColumnsEquiv]
  change (∀ j, (fun i ↦ M i j) ∈ Γ) ↔ ∀ j, (fun i ↦ M i j) ∈ Γ
  rfl

/-- There are exactly `|Γ| ^ k` matrices with all columns in `Γ`. -/
@[simp] lemma card_matricesWithColumns (Γ : Finset (Fin r → α)) :
    (matricesWithColumns (k := k) Γ).card = Γ.card ^ k := by
  classical
  simp [matricesWithColumns]

end Columns

section Spans

variable {K : Type*} [Field K]
variable {V : Type*} [AddCommGroup V] [Module K V]

/-- Subspaces generated by ordered `d`-tuples drawn from `Γ`.

Repetitions are allowed, as is appropriate for an upper bound. -/
noncomputable def generatedSpans (Γ : Finset V) (d : ℕ) :
    Finset (Submodule K V) := by
  classical
  exact (Fintype.piFinset (fun _ : Fin d ↦ Γ)).image
    (fun b ↦ Submodule.span K (Set.range b))

lemma card_generatedSpans_le (Γ : Finset V) (d : ℕ) :
    (generatedSpans (K := K) Γ d).card ≤ Γ.card ^ d := by
  classical
  refine (Finset.card_image_le.trans_eq ?_)
  simp

@[simp] lemma mem_generatedSpans_iff {W : Submodule K V}
    {Γ : Finset V} {d : ℕ} :
    W ∈ generatedSpans (K := K) Γ d ↔
      ∃ b : Fin d → V, (∀ i, b i ∈ Γ) ∧
        Submodule.span K (Set.range b) = W := by
  classical
  simp [generatedSpans]

/-- Families of `k` vectors, all belonging to `Γ` and to one subspace
generated by `d` members of `Γ`. -/
noncomputable def familiesInGeneratedSpan (Γ : Finset V) (d k : ℕ) :
    Finset (Fin k → V) := by
  classical
  exact (generatedSpans (K := K) Γ d).biUnion fun W ↦
    Fintype.piFinset (fun _ : Fin k ↦ Γ.filter (fun v ↦ v ∈ W))

@[simp] lemma mem_familiesInGeneratedSpan {c : Fin k → V}
    {Γ : Finset V} {d : ℕ} :
    c ∈ familiesInGeneratedSpan (K := K) Γ d k ↔
      ∃ W ∈ generatedSpans (K := K) Γ d,
        ∀ j, c j ∈ Γ ∧ c j ∈ W := by
  classical
  simp [familiesInGeneratedSpan]

/-- The abstract low-rank counting step.  If each candidate subspace
contains at most `B` members of `Γ`, then the number of ordered `k`-tuples
lying in one such subspace is at most `|Γ|^d B^k`. -/
lemma card_familiesInGeneratedSpan_le
    (Γ : Finset V) (d k B : ℕ)
    (hinter : ∀ W ∈ generatedSpans (K := K) Γ d,
      (Γ.filter (fun v ↦ v ∈ W)).card ≤ B) :
    (familiesInGeneratedSpan (K := K) Γ d k).card ≤
      Γ.card ^ d * B ^ k := by
  classical
  refine (Finset.card_biUnion_le_card_mul
    (generatedSpans (K := K) Γ d)
    (fun W ↦ Fintype.piFinset
      (fun _ : Fin k ↦ Γ.filter (fun v ↦ v ∈ W))) (B ^ k) ?_).trans ?_
  · intro W hW
    simpa using Nat.pow_le_pow_left (hinter W hW) k
  · exact Nat.mul_le_mul_right (B ^ k) (card_generatedSpans_le (K := K) Γ d)

/-- Without an intersection estimate one still gets the coarse bound obtained
by forgetting the subspace condition. -/
lemma card_familiesInGeneratedSpan_le_coarse (Γ : Finset V) (d k : ℕ) :
    (familiesInGeneratedSpan (K := K) Γ d k).card ≤
      Γ.card ^ d * Γ.card ^ k := by
  apply card_familiesInGeneratedSpan_le (K := K) Γ d k Γ.card
  intro W hW
  exact Finset.card_filter_le _ _

end Spans

section Boolean

/-- The Boolean cube, embedded in the rational vector space `ℚ^r`. -/
noncomputable def booleanVectors (r : ℕ) : Finset (Fin r → ℚ) := by
  classical
  exact Fintype.piFinset (fun _ : Fin r ↦ ({0, 1} : Finset ℚ))

@[simp] lemma mem_booleanVectors {r : ℕ} {v : Fin r → ℚ} :
    v ∈ booleanVectors r ↔ ∀ i, v i = 0 ∨ v i = 1 := by
  classical
  simp [booleanVectors]

@[simp] lemma card_booleanVectors (r : ℕ) :
    (booleanVectors r).card = 2 ^ r := by
  classical
  simp [booleanVectors]

/-- At most `2^(r d)` rational subspaces can be generated by `d` Boolean
vectors in `ℚ^r`. -/
lemma card_booleanGeneratedSpans_le (r d : ℕ) :
    (generatedSpans (K := ℚ) (booleanVectors r) d).card ≤ 2 ^ (r * d) := by
  simpa [pow_mul] using
    (card_generatedSpans_le (K := ℚ) (booleanVectors r) d)

/-- Boolean matrices whose columns lie in one subspace generated by `d`
Boolean vectors. -/
noncomputable def booleanMatricesInGeneratedSpan (r d k : ℕ) :
    Finset (Matrix (Fin r) (Fin k) ℚ) := by
  classical
  exact (familiesInGeneratedSpan (K := ℚ) (booleanVectors r) d k).map
    matrixColumnsEquiv.symm.toEmbedding

/-- Rational span of the columns of a matrix. -/
def rationalColumnSpan {r k : ℕ} (M : Matrix (Fin r) (Fin k) ℚ) :
    Submodule ℚ (Fin r → ℚ) :=
  Submodule.span ℚ (Set.range (fun j i ↦ M i j))

/-- Column rank over `ℚ`. -/
noncomputable def rationalColumnRank {r k : ℕ}
    (M : Matrix (Fin r) (Fin k) ℚ) : ℕ :=
  Module.finrank ℚ (rationalColumnSpan M)

/-- Boolean matrices of rational column rank exactly `d`. -/
noncomputable def booleanMatricesOfRank (r d k : ℕ) :
    Finset (Matrix (Fin r) (Fin k) ℚ) := by
  classical
  exact (matricesWithColumns (k := k) (booleanVectors r)).filter
    (fun M ↦ rationalColumnRank M = d)

@[simp] lemma mem_booleanMatricesOfRank {r d k : ℕ}
    {M : Matrix (Fin r) (Fin k) ℚ} :
    M ∈ booleanMatricesOfRank r d k ↔
      (∀ j, (fun i ↦ M i j) ∈ booleanVectors r) ∧
        rationalColumnRank M = d := by
  classical
  simp [booleanMatricesOfRank]

/-- A Boolean matrix of rank `d` lies in a subspace generated by `d` of its
Boolean columns.  This is the bridge between actual matrix rank and the
finite union used for counting. -/
lemma booleanMatricesOfRank_subset_generatedSpan (r d k : ℕ) :
    booleanMatricesOfRank r d k ⊆ booleanMatricesInGeneratedSpan r d k := by
  classical
  intro M hM
  rw [mem_booleanMatricesOfRank] at hM
  let c : Fin k → Fin r → ℚ := fun j i ↦ M i j
  have hex := Submodule.exists_fun_fin_finrank_span_eq ℚ (Set.range c)
  change (∀ j, (fun i ↦ M i j) ∈ booleanVectors r) ∧
    Module.finrank ℚ (Submodule.span ℚ (Set.range (fun j i ↦ M i j))) = d at hM
  have hrank : Module.finrank ℚ (Submodule.span ℚ (Set.range c)) = d := by
    simpa only [c] using hM.2
  rw [hrank] at hex
  obtain ⟨b, hb, hspan, _hlin⟩ := hex
  rw [booleanMatricesInGeneratedSpan]
  apply Finset.mem_map.mpr
  refine ⟨c, ?_, ?_⟩
  · rw [mem_familiesInGeneratedSpan]
    refine ⟨Submodule.span ℚ (Set.range c), ?_, ?_⟩
    · rw [mem_generatedSpans_iff]
      refine ⟨b, ?_, hspan⟩
      intro i
      obtain ⟨j, hj⟩ := hb i
      rw [← hj]
      exact hM.1 j
    · intro j
      exact ⟨hM.1 j, Submodule.subset_span (Set.mem_range_self j)⟩
  · rfl

@[simp] lemma card_booleanMatricesInGeneratedSpan (r d k : ℕ) :
    (booleanMatricesInGeneratedSpan r d k).card =
      (familiesInGeneratedSpan (K := ℚ) (booleanVectors r) d k).card := by
  classical
  simp [booleanMatricesInGeneratedSpan]

/-- The matrix form of the abstract low-rank counting step. -/
lemma card_booleanMatricesInGeneratedSpan_le
    (r d k B : ℕ)
    (hinter : ∀ W ∈ generatedSpans (K := ℚ) (booleanVectors r) d,
      ((booleanVectors r).filter (fun v ↦ v ∈ W)).card ≤ B) :
    (booleanMatricesInGeneratedSpan r d k).card ≤
      2 ^ (r * d) * B ^ k := by
  rw [card_booleanMatricesInGeneratedSpan]
  simpa [pow_mul] using
    (card_familiesInGeneratedSpan_le (K := ℚ)
      (booleanVectors r) d k B hinter)

/-- The same count, now stated for actual Boolean matrices of rank `d`. -/
lemma card_booleanMatricesOfRank_le
    (r d k B : ℕ)
    (hinter : ∀ W ∈ generatedSpans (K := ℚ) (booleanVectors r) d,
      ((booleanVectors r).filter (fun v ↦ v ∈ W)).card ≤ B) :
    (booleanMatricesOfRank r d k).card ≤ 2 ^ (r * d) * B ^ k := by
  exact (Finset.card_le_card (booleanMatricesOfRank_subset_generatedSpan r d k)).trans
    (card_booleanMatricesInGeneratedSpan_le r d k B hinter)

/-- A completely unconditional coarse rank count, obtained by bounding every
cube intersection by the whole Boolean cube. -/
lemma card_booleanMatricesOfRank_le_coarse (r d k : ℕ) :
    (booleanMatricesOfRank r d k).card ≤
      2 ^ (r * d) * 2 ^ (r * k) := by
  have hinter : ∀ W ∈ generatedSpans (K := ℚ) (booleanVectors r) d,
      ((booleanVectors r).filter (fun v ↦ v ∈ W)).card ≤ 2 ^ r := by
    intro W hW
    simpa using (Finset.card_filter_le (booleanVectors r) (fun v ↦ v ∈ W))
  simpa [pow_mul] using
    (card_booleanMatricesOfRank_le r d k (2 ^ r) hinter)

/-- Every row is nonzero and the ordered rows are pairwise distinct. -/
def RowsDistinctNonzero {r k : ℕ} (M : Matrix (Fin r) (Fin k) ℚ) : Prop :=
  (∀ i, ∃ j, M i j ≠ 0) ∧ Function.Injective (fun i j ↦ M i j)

/-- The ordered distinct, nonzero-row subfamily relevant to factorial
moments. -/
noncomputable def orderedDistinctRowLowRankMatrices (r d k : ℕ) :
    Finset (Matrix (Fin r) (Fin k) ℚ) := by
  classical
  exact (booleanMatricesOfRank r d k).filter RowsDistinctNonzero

/-- Filtering for ordered distinct nonzero rows can only decrease the count.
This is the trivial low-rank ordered-row bound once a cube-intersection bound
is supplied. -/
lemma card_orderedDistinctRowLowRankMatrices_le
    (r d k B : ℕ)
    (hinter : ∀ W ∈ generatedSpans (K := ℚ) (booleanVectors r) d,
      ((booleanVectors r).filter (fun v ↦ v ∈ W)).card ≤ B) :
    (orderedDistinctRowLowRankMatrices r d k).card ≤
      2 ^ (r * d) * B ^ k := by
  exact (Finset.card_filter_le _ _).trans
    (card_booleanMatricesOfRank_le r d k B hinter)

/-- Unconditional coarse count for the ordered distinct/nonzero-row
subfamily. -/
lemma card_orderedDistinctRowLowRankMatrices_le_coarse (r d k : ℕ) :
    (orderedDistinctRowLowRankMatrices r d k).card ≤
      2 ^ (r * d) * 2 ^ (r * k) := by
  exact (Finset.card_filter_le _ _).trans
    (card_booleanMatricesOfRank_le_coarse r d k)

/-- The form used for the trivial estimate in the paper: when every relevant
rank-`d` subspace contains at most `2^d` Boolean points, and `d ≤ r`, the
ordered-row count is at most `2^(r²) (2^d)^k`. -/
lemma card_orderedDistinctRowLowRankMatrices_le_trivial
    (r d k : ℕ) (hdr : d ≤ r)
    (hinter : ∀ W ∈ generatedSpans (K := ℚ) (booleanVectors r) d,
      ((booleanVectors r).filter (fun v ↦ v ∈ W)).card ≤ 2 ^ d) :
    (orderedDistinctRowLowRankMatrices r d k).card ≤
      2 ^ (r * r) * (2 ^ d) ^ k := by
  refine (card_orderedDistinctRowLowRankMatrices_le r d k (2 ^ d) hinter).trans ?_
  exact Nat.mul_le_mul_right ((2 ^ d) ^ k)
    (Nat.pow_le_pow_right (by decide : 0 < 2) (Nat.mul_le_mul_left r hdr))

end Boolean

end Erdos543
