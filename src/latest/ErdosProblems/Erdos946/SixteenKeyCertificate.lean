def keyPairFactorTable16b (i : Fin 120) : ℕ :=
  keyPairFactorData16[i.1]!


def keyPairRank16 (i j : Fin 16) (hij : i.1 < j.1) : Fin 120 :=
  ⟨i.1 * 15 - (i.1 * (i.1 - 1)) / 2 + (j.1 - i.1 - 1), by
    have h : ∀ i j : Fin 16, i.1 < j.1 →
        i.1 * 15 - (i.1 * (i.1 - 1)) / 2 + (j.1 - i.1 - 1) < 120 := by
      decide +kernel
    exact h i j hij⟩

/-- The quotient of an unordered difference by its distinguished-prime
part.  The diagonal value is irrelevant and is set to one. -/
def keyPairFactor16 (i j : Fin 16) : ℕ :=
  if hij : i.1 < j.1 then keyPairFactorTable16b (keyPairRank16 i j hij)
  else if hji : j.1 < i.1 then keyPairFactorTable16b (keyPairRank16 j i hji)
  else 1

/-- The genuine unordered pairs of indices. -/
abbrev KeyPair16 := {ij : Fin 16 × Fin 16 // ij.1.1 < ij.2.1}

def keyAuxPrime16 : Fin 16 → ℕ := ![
  103, 107, 127, 137, 149, 151, 181, 191,
  197, 227, 229, 241, 251, 257, 269, 271]

def keyAuxProduct16 : ℕ := ∏ i : Fin 16, keyAuxPrime16 i


def modularProduct16 (m : ℕ) : List ℕ → ℕ
  | [] => 1 % m
  | x :: xs => (x * modularProduct16 m xs) % m

lemma modularProduct16_eq_prod_mod (m : ℕ) : ∀ xs : List ℕ,
    modularProduct16 m xs = xs.prod % m
  | [] => rfl
  | x :: xs => by
      simp [modularProduct16, modularProduct16_eq_prod_mod m xs,
        Nat.mul_mod]

def keyPairFactorOthersList16 (i : Fin 120) : List ℕ :=
  List.ofFn (fun j : Fin 120 ↦
    if j = i then 1 else keyPairFactorTable16b j)

private lemma keyPairFactor_coprime_modularOthers16_all :
    ∀ i : Fin 120,
      (keyPairFactorTable16b i).Coprime
        (modularProduct16 (keyPairFactorTable16b i)
          (keyPairFactorOthersList16 i)) := by
  decide +kernel

lemma keyPairFactor_coprime_othersProduct16 (i : Fin 120) :
    (keyPairFactorTable16b i).Coprime
      (keyPairFactorOthersList16 i).prod := by
  have h := keyPairFactor_coprime_modularOthers16_all i
  rw [modularProduct16_eq_prod_mod] at h
  exact (ZMod.coprime_mod_iff_coprime _ _).mp h.symm |>.symm

lemma keyPairFactorTable16_pairwise :
    ((Finset.univ : Finset (Fin 120)) : Set (Fin 120)).Pairwise
      (fun i j ↦ (keyPairFactorTable16b i).Coprime
        (keyPairFactorTable16b j)) := by
  intro i _hi j _hj hij
  have hjmem :
      keyPairFactorTable16b j ∈ keyPairFactorOthersList16 i := by
    rw [keyPairFactorOthersList16, List.mem_ofFn']
    exact ⟨j, by simp [hij.symm]⟩
  exact (keyPairFactor_coprime_othersProduct16 i).of_dvd_right
    (List.dvd_prod hjmem)

abbrev KeyCRTIndex16 := Fin 2 ⊕ KeyPair16

def keyCRTModulusAt16 : KeyCRTIndex16 → ℕ
  | Sum.inl i => if i = 0 then keySmallModulus16 else keyAuxProduct16
  | Sum.inr ij => keyPairFactor16 ij.1.1 ij.1.2 ^ 2

def keyPairMultiplier16 (i j : Fin 16) : ℕ :=
  if (i.1 = 1 ∧ j.1 = 3) ∨ (i.1 = 3 ∧ j.1 = 1) then 2 else 1

def keyCRTResidueAt16 : KeyCRTIndex16 → ℕ
  | Sum.inl i => if i = 0 then keySmallPart16 0 else 1
  | Sum.inr ij =>
      let f := keyPairFactor16 ij.1.1 ij.1.2
      f * keyPairMultiplier16 ij.1.1 ij.1.2 + f ^ 2 -
        keyDelta16 ij.1.1 % (f ^ 2)

def keyQuotientExponent16 (i j k : Fin 16) : ℕ :=
  keyExponent16 i k - Nat.min (keyExponent16 i k) (keyExponent16 j k)

private abbrev KeyFiniteCore16 : Prop :=
  Function.Injective (fun ij : KeyPair16 ↦
      keyPairRank16 ij.1.1 ij.1.2 ij.2) ∧
  (∀ i j : Fin 16, i ≠ j → 0 < keyPairFactor16 i j) ∧
  keySmallModulus16.Coprime keyAuxProduct16 ∧
  (∀ ij : KeyPair16,
    keySmallModulus16.Coprime (keyPairFactor16 ij.1.1 ij.1.2)) ∧
  (∀ ij : KeyPair16,
    keyAuxProduct16.Coprime (keyPairFactor16 ij.1.1 ij.1.2)) ∧
  (∀ i : Fin 16, (keyPrime16 i).Prime) ∧
  (∀ i : Fin 16, (keyAuxPrime16 i).Prime) ∧
  (∀ i : Fin 16, 0 < keySmallPart16 i) ∧
  (∀ i : Fin 16, 1 < keySmallPart16 i) ∧
  0 < keySmallModulus16 ∧
  0 < keyAuxProduct16 ∧
  Function.Injective keyDelta16 ∧
  (∀ i : Fin 16,
    keySmallPart16 0 + keyDelta16 i ≡ keySmallPart16 i
      [MOD keySmallModulus16]) ∧
  (∀ ij : KeyPair16,
    keyCRTResidueAt16 (Sum.inr ij) + keyDelta16 ij.1.1 ≡
      keyPairFactor16 ij.1.1 ij.1.2 *
        keyPairMultiplier16 ij.1.1 ij.1.2
        [MOD keyPairFactor16 ij.1.1 ij.1.2 ^ 2]) ∧
  (∀ i k : Fin 16,
    keyPrime16 k ^ (keyExponent16 i k + 1) ∣ keySmallModulus16) ∧
  (∀ i k : Fin 16,
    ¬keyPrime16 k ^ (keyExponent16 i k + 1) ∣ keySmallPart16 i) ∧
  (∀ i j : Fin 16,
    (keyPairFactor16 i j).Coprime (keySmallPart16 i)) ∧
  (∀ i j : Fin 16, i ≠ j →
    keyDistance16 i j = keySmallGcd16 i j * keyPairFactor16 i j) ∧
  (∀ i j : Fin 16, ¬keyAuxPrime16 i ∣ 1 + keyDelta16 j) ∧
  (∀ i : Fin 16, keySmallPart16 i ∣ keySmallModulus16) ∧
  StrictMono keyDelta16 ∧
  Function.Injective keyPrime16 ∧
  (∀ i j : Fin 16,
    keySmallPart16 i / keySmallGcd16 i j =
      ∏ k : Fin 16, keyPrime16 k ^ keyQuotientExponent16 i j k) ∧
  (∀ i j : Fin 16,
    (∏ k : Fin 16, (keyExponent16 i k + 1)) *
        (∏ k : Fin 16, (keyQuotientExponent16 j i k + 1)) =
      (∏ k : Fin 16, (keyExponent16 j k + 1)) *
        (∏ k : Fin 16, (keyQuotientExponent16 i j k + 1))) ∧
  (∀ i j : Fin 16, i ≠ j →
    (keyPairFactor16 i j).Coprime (keyPairMultiplier16 i j) ∧
      (keyPairFactor16 i j).Coprime
        (keyPairMultiplier16 i j + keySmallGcd16 i j))

