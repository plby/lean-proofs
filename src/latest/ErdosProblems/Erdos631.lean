private lemma gutnerBlock_adj_to_plane (i : Fin 12) {x y : ℕ}
    (h : DiskExpr.EdgeAdj (gutnerBlock i).edges x y) :
    DiskExpr.EdgeAdj gutnerPlane.edges x y := by
  rcases h with h | h
  · exact Or.inl (gutnerBlock_edges_subset i h)
  · exact Or.inr (gutnerBlock_edges_subset i h)

def gutnerGraph : SimpleGraph (Fin 86) where
  Adj x y := x ≠ y ∧
    ((x.1 = 0 ∧ y.1 = 1) ∨ (x.1 = 1 ∧ y.1 = 0) ∨
      ∃ i : Fin 12, DiskExpr.EdgeAdj (gutnerBlock i).edges x.1 y.1)
  symm.symm x y h := by
    refine ⟨h.1.symm, ?_⟩
    rcases h.2 with h | h | ⟨i, hi⟩
    · exact Or.inr (Or.inl ⟨h.2, h.1⟩)
    · exact Or.inl ⟨h.2, h.1⟩
    · exact Or.inr (Or.inr ⟨i, DiskExpr.edgeAdj_comm.mp hi⟩)
  loopless.irrefl x h := h.1 rfl

lemma gutnerGraph_planar : IsPlanar gutnerGraph := by
  refine ⟨{
    plane := gutnerPlane
    valid := gutnerPlane_valid
    embed := ⟨fun v => v.1, Fin.val_injective⟩
    vertex_mem := ?_
    adj_sub := ?_ }⟩
  · intro v
    rw [gutnerPlane_vertices]
    exact Finset.mem_range.mpr v.2
  · intro v w hvw
    rcases hvw.2 with huv | hvu | ⟨i, hi⟩
    · have hlocal : DiskExpr.EdgeAdj (gutnerBlock 0).edges v.1 w.1 := by
        have h01 : DiskExpr.EdgeAdj (gutnerBlock 0).edges 0 1 := by decide
        simpa [huv.1, huv.2] using h01
      exact gutnerBlock_adj_to_plane 0 hlocal
    · have hlocal : DiskExpr.EdgeAdj (gutnerBlock 0).edges v.1 w.1 := by
        have h10 : DiskExpr.EdgeAdj (gutnerBlock 0).edges 1 0 := by decide
        simpa [hvu.1, hvu.2] using h10
      exact gutnerBlock_adj_to_plane 0 hlocal
    · exact gutnerBlock_adj_to_plane i hi

def gutnerA (i : ℕ) : ℕ := 7 + i / 3

def gutnerB (i : ℕ) : ℕ :=
  let r := i % 3
  let a := i / 3
  7 + if r < a then r else r + 1

def gutnerLists (v : Fin 86) : Finset ℕ :=
  if v.1 < 2 then {7, 8, 9, 10}
  else
    let i := (v.1 - 2) / 7
    let r := (v.1 - 2) % 7
    match r with
    | 0 => {gutnerA i, gutnerB i, 1, 2}
    | 1 => {gutnerA i, 1, 3, 4}
    | 2 => {gutnerA i, gutnerB i, 3, 4}
    | 3 => {gutnerB i, 1, 3, 4}
    | 4 => {gutnerA i, 2, 5, 6}
    | 5 => {gutnerA i, gutnerB i, 5, 6}
    | _ => {gutnerB i, 2, 5, 6}

lemma gutnerLists_card (v : Fin 86) : (gutnerLists v).card = 4 := by
  fin_cases v <;> decide

def gutnerU : Fin 86 := 0
def gutnerV : Fin 86 := 1

def gutnerVertex (i : Fin 12) (r : Fin 7) : Fin 86 :=
  ⟨blockBase i + r, by
    unfold blockBase
    omega⟩

private lemma exists_gutner_pair {a b : ℕ} (ha : a ∈ ({7, 8, 9, 10} : Finset ℕ))
    (hb : b ∈ ({7, 8, 9, 10} : Finset ℕ)) (hab : a ≠ b) :
    ∃ i : Fin 12, gutnerA i = a ∧ gutnerB i = b := by
  simp only [mem_insert, mem_singleton] at ha hb
  rcases ha with rfl | rfl | rfl | rfl <;>
    rcases hb with rfl | rfl | rfl | rfl <;>
    first
    | contradiction
    | exact ⟨0, by decide, by decide⟩
    | exact ⟨1, by decide, by decide⟩
    | exact ⟨2, by decide, by decide⟩
    | exact ⟨3, by decide, by decide⟩
    | exact ⟨4, by decide, by decide⟩
    | exact ⟨5, by decide, by decide⟩
    | exact ⟨6, by decide, by decide⟩
    | exact ⟨7, by decide, by decide⟩
    | exact ⟨8, by decide, by decide⟩
    | exact ⟨9, by decide, by decide⟩
    | exact ⟨10, by decide, by decide⟩
    | exact ⟨11, by decide, by decide⟩

