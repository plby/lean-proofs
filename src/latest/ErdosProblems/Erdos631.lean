private lemma gutner_x_triangle_impossible (i : Fin 12) (c : gutnerGraph.Coloring ℕ)
    (hmem : ∀ v, c v ∈ gutnerLists v) (hu : c gutnerU = gutnerA i)
    (hv : c gutnerV = gutnerB i) (hw : c (gutnerVertex i 0) = 1) : False := by
  have hux1 := c.valid (gutner_adj_ux1 i)
  have hwx1 := c.valid (gutner_adj_wx1 i)
  have hux2 := c.valid (gutner_adj_ux2 i)
  have hvx2 := c.valid (gutner_adj_vx2 i)
  have hvx3 := c.valid (gutner_adj_vx3 i)
  have hwx3 := c.valid (gutner_adj_wx3 i)
  have hx12 := c.valid (gutner_adj_x12 i)
  have hx23 := c.valid (gutner_adj_x23 i)
  have hx31 := c.valid (gutner_adj_x31 i)
  have hx1 := hmem (gutnerVertex i 1)
  have hx2 := hmem (gutnerVertex i 2)
  have hx3 := hmem (gutnerVertex i 3)
  rw [gutnerLists_x1] at hx1
  rw [gutnerLists_x2] at hx2
  rw [gutnerLists_x3] at hx3
  simp only [mem_insert, mem_singleton] at hx1 hx2 hx3
  omega

private lemma gutner_y_triangle_impossible (i : Fin 12) (c : gutnerGraph.Coloring ℕ)
    (hmem : ∀ v, c v ∈ gutnerLists v) (hu : c gutnerU = gutnerA i)
    (hv : c gutnerV = gutnerB i) (hw : c (gutnerVertex i 0) = 2) : False := by
  have huy1 := c.valid (gutner_adj_uy1 i)
  have hwy1 := c.valid (gutner_adj_wy1 i)
  have huy2 := c.valid (gutner_adj_uy2 i)
  have hvy2 := c.valid (gutner_adj_vy2 i)
  have hvy3 := c.valid (gutner_adj_vy3 i)
  have hwy3 := c.valid (gutner_adj_wy3 i)
  have hy12 := c.valid (gutner_adj_y12 i)
  have hy23 := c.valid (gutner_adj_y23 i)
  have hy31 := c.valid (gutner_adj_y31 i)
  have hy1 := hmem (gutnerVertex i 4)
  have hy2 := hmem (gutnerVertex i 5)
  have hy3 := hmem (gutnerVertex i 6)
  rw [gutnerLists_y1] at hy1
  rw [gutnerLists_y2] at hy2
  rw [gutnerLists_y3] at hy3
  simp only [mem_insert, mem_singleton] at hy1 hy2 hy3
  omega

private lemma gutner_block_forbidden (i : Fin 12) (c : gutnerGraph.Coloring ℕ)
    (hmem : ∀ v, c v ∈ gutnerLists v)
    (hu : c gutnerU = gutnerA i) (hv : c gutnerV = gutnerB i) : False := by
  have huw := c.valid (gutner_adj_uw i)
  have hvw := c.valid (gutner_adj_vw i)
  have hw := hmem (gutnerVertex i 0)
  rw [gutnerLists_w] at hw
  simp only [mem_insert, mem_singleton] at hw
  rcases hw with hw | hw | hw | hw
  · exact huw (hu.trans hw.symm)
  · exact hvw (hv.trans hw.symm)
  · exact gutner_x_triangle_impossible i c hmem hu hv hw
  · exact gutner_y_triangle_impossible i c hmem hu hv hw

theorem gutner_not_four_choosable :
    ¬ Erdos753.IsKChoosable gutnerGraph 4 := by
  intro hfour
  obtain ⟨c, hmem⟩ := hfour gutnerLists gutnerLists_card
  have huMem := hmem gutnerU
  have hvMem := hmem gutnerV
  have huv := c.valid (show gutnerGraph.Adj gutnerU gutnerV from
    ⟨by decide, Or.inl ⟨rfl, rfl⟩⟩)
  have huEndpoint : c gutnerU ∈ ({7, 8, 9, 10} : Finset ℕ) := by
    simpa [gutnerLists, gutnerU] using huMem
  have hvEndpoint : c gutnerV ∈ ({7, 8, 9, 10} : Finset ℕ) := by
    simpa [gutnerLists, gutnerV] using hvMem
  obtain ⟨i, hiu, hiv⟩ := exists_gutner_pair huEndpoint hvEndpoint huv
  exact gutner_block_forbidden i c hmem hiu.symm hiv.symm

theorem gutner_listChromaticNumber_eq_five :
    Erdos753.listChromaticNumber gutnerGraph = 5 := by
  have hle : Erdos753.listChromaticNumber gutnerGraph ≤ 5 :=
    planar_listChromaticNumber_le_five gutnerGraph gutnerGraph_planar
  have hmin : Erdos753.IsKChoosable gutnerGraph
      (Erdos753.listChromaticNumber gutnerGraph) := by
    simpa only [Erdos753.listChromaticNumber, Set.mem_ofPred_eq] using
      (Nat.sInf_mem (Erdos753.choosable_set_nonempty gutnerGraph))
  have hge : 5 ≤ Erdos753.listChromaticNumber gutnerGraph := by
    by_contra h
    have hle4 : Erdos753.listChromaticNumber gutnerGraph ≤ 4 := by omega
    exact gutner_not_four_choosable (hmin.mono hle4)
  omega

/-- **Resolution of Erdős Problem 631.** Every finite planar graph has list
chromatic number at most five, and Gutner's finite planar graph shows that the
constant five is best possible. -/
theorem erdos_631 :
    (∀ {V : Type*} [Fintype V] (G : SimpleGraph V), IsPlanar G →
      Erdos753.listChromaticNumber G ≤ 5) ∧
    (∃ G : SimpleGraph (Fin 86), IsPlanar G ∧
      Erdos753.listChromaticNumber G = 5) := by
  constructor
  · intro V _ G hG
    exact planar_listChromaticNumber_le_five G hG
  · exact ⟨gutnerGraph, gutnerGraph_planar, gutner_listChromaticNumber_eq_five⟩

#print axioms erdos_631

end Erdos631

alias _root_.Erdos631.erdos631 := _root_.Erdos631.erdos_631
