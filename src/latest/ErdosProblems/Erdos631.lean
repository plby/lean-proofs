        (PlaneExpr.edges_left_subset gutnerPlane03 gutnerPlane411))
  · exact (PlaneExpr.edges_left_subset _ _).trans
      ((PlaneExpr.edges_left_subset gutnerPlane45 gutnerPlane67).trans
