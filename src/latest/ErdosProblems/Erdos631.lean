  fin_cases i <;> (
    unfold gutnerBlock blockBase
    apply DiskExpr.Valid.fan
    · apply DiskExpr.Valid.fan
      · apply DiskExpr.Valid.glue
        · apply DiskExpr.Valid.fan
          · apply DiskExpr.Valid.fan
            · apply DiskExpr.Valid.glue
              · apply DiskExpr.Valid.triangle <;> decide
              · apply DiskExpr.Valid.triangle <;> decide
              · decide
              · decide
              · decide
              · decide
              · decide
              · decide
              · decide
            · decide
            · decide
            · decide
            · decide
            · decide
            · decide
            · decide
          · decide
          · decide
          · decide
          · decide
          · decide
          · decide
          · decide
        · apply DiskExpr.Valid.triangle <;> decide
        · decide
        · decide
        · decide
        · decide
        · decide
        · decide
        · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
    · decide
    · decide
    · decide
    · decide
    · decide
    · decide
    · decide)

