import Mathlib.Data.Nat.Log
import Mathlib.GroupTheory.Coset.Card
import Mathlib.SetTheory.Cardinal.NatCard

/-!
# Short irredundant generating chains in finite additive groups

This file records an elementary finite-group lemma used in the residue
alignment argument for Erdős Problem 874.  A finite set of generators has an
inclusion-irredundant generating subset.  If those generators are inserted
one at a time (starting at the right-hand end of the list), the generated
additive subgroups grow strictly.  Lagrange's theorem then shows that every
step at least doubles the subgroup order.
-/

namespace Erdos874

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddGroup G]

/-- A list is a strict additive generator chain when deleting its head
strictly decreases the generated subgroup, recursively.  Thus the chain is
read from right to left: start with the empty list, then insert the last
element, the penultimate element, and so on. -/
def IsStrictAddGeneratorChain : List G → Prop
  | [] => True
  | x :: xs =>
      AddSubgroup.closure (xs.toFinset : Set G) <
          AddSubgroup.closure ((x :: xs).toFinset : Set G) ∧
        IsStrictAddGeneratorChain xs

/-- A finite generating set is irredundant if none of its elements belongs
to the subgroup generated by all the other elements. -/
def IsIrredundantAddGeneratingSet (T : Finset G) : Prop :=
  ∀ x ∈ T, x ∉ AddSubgroup.closure ((T.erase x : Finset G) : Set G)

/-- Every finite set has an inclusion-irredundant subset with the same
additive closure. -/
theorem exists_irredundant_addGenerating_subset (S : Finset G) :
    ∃ T : Finset G,
      T ⊆ S ∧
        AddSubgroup.closure (T : Set G) = AddSubgroup.closure (S : Set G) ∧
        IsIrredundantAddGeneratingSet T := by
  classical
  induction S using Finset.strongInductionOn with
  | _ S ih =>
      by_cases hredundant : ∃ x ∈ S,
          AddSubgroup.closure ((S.erase x : Finset G) : Set G) =
            AddSubgroup.closure (S : Set G)
      · obtain ⟨x, hxS, hx⟩ := hredundant
        have herase : S.erase x ⊂ S := Finset.erase_ssubset hxS
        obtain ⟨T, hTS, hTclosure, hTirr⟩ := ih (S.erase x) herase
        exact ⟨T, hTS.trans (Finset.erase_subset x S), hTclosure.trans hx, hTirr⟩
      · refine ⟨S, Finset.Subset.rfl, rfl, ?_⟩
        intro x hxS hxmem
        apply hredundant
        refine ⟨x, hxS, le_antisymm (AddSubgroup.closure_mono ?_) ?_⟩
        · exact_mod_cast Finset.erase_subset (s := S) x
        · rw [AddSubgroup.closure_le]
          intro y hyS
          by_cases hyx : y = x
          · simpa [hyx] using hxmem
          · exact AddSubgroup.subset_closure (by
              exact_mod_cast Finset.mem_erase.mpr ⟨hyx, hyS⟩)

private theorem strictChain_of_irredundant_list
    (l : List G) (hnodup : l.Nodup)
    (hirr : ∀ x ∈ l,
      x ∉ AddSubgroup.closure (((l.toFinset.erase x : Finset G)) : Set G)) :
    IsStrictAddGeneratorChain l := by
  induction l with
  | nil => simp [IsStrictAddGeneratorChain]
  | cons x xs ih =>
      have hxnot : x ∉
          AddSubgroup.closure (xs.toFinset : Set G) := by
        simpa [List.nodup_cons.mp hnodup |>.1] using
          hirr x (by simp)
      have hmono :
          AddSubgroup.closure (xs.toFinset : Set G) ≤
            AddSubgroup.closure ((x :: xs).toFinset : Set G) := by
        apply AddSubgroup.closure_mono
        simp
      have hstrict :
          AddSubgroup.closure (xs.toFinset : Set G) <
            AddSubgroup.closure ((x :: xs).toFinset : Set G) := by
        refine lt_of_le_of_ne hmono ?_
        intro heq
        apply hxnot
        rw [heq]
        exact AddSubgroup.subset_closure (by simp)
      refine ⟨hstrict, ih (List.nodup_cons.mp hnodup |>.2) ?_⟩
      intro y hyxs hymem
      apply hirr y (by simp [hyxs])
      have hsub :
          ((xs.toFinset.erase y : Finset G) : Set G) ⊆
            ((((x :: xs).toFinset.erase y : Finset G)) : Set G) := by
        rw [List.toFinset_cons]
        exact_mod_cast
          Finset.erase_subset_erase y (Finset.subset_insert x xs.toFinset)
      exact (AddSubgroup.closure_mono hsub) hymem

variable [Finite G]

private theorem two_mul_natCard_le_of_addSubgroup_lt
    {K L : AddSubgroup G} (hKL : K < L) :
    2 * Nat.card K ≤ Nat.card L := by
  have hcardlt : Nat.card K < Nat.card L := by
    apply Set.Finite.card_lt_card (Set.toFinite (L : Set G))
    exact hKL
  have hdvd : Nat.card K ∣ Nat.card L :=
    AddSubgroup.card_dvd_of_le hKL.le
  obtain ⟨c, hc⟩ := hdvd
  have hKpos : 0 < Nat.card K := Nat.card_pos
  have hLpos : 0 < Nat.card L := Nat.card_pos
  have hcpos : 0 < c := by
    by_contra hc0
    have : c = 0 := Nat.eq_zero_of_not_pos hc0
    subst c
    have hLzero : Nat.card L = 0 := by simpa using hc
    exact (Nat.ne_of_gt hLpos) hLzero
  have hcne_one : c ≠ 1 := by
    intro hc1
    subst c
    simp at hc
    omega
  have hctwo : 2 ≤ c := by omega
  calc
    2 * Nat.card K ≤ c * Nat.card K := Nat.mul_le_mul_right _ hctwo
    _ = Nat.card L := by simpa [Nat.mul_comm] using hc.symm

/-- The length of a strict generator chain is at most the base-two logarithm
of the order of the subgroup it generates, in the integral form needed by
the application. -/
theorem IsStrictAddGeneratorChain.two_pow_length_le_natCard_closure
    {l : List G} (hl : IsStrictAddGeneratorChain l) :
    2 ^ l.length ≤ Nat.card (AddSubgroup.closure (l.toFinset : Set G)) := by
  induction l with
  | nil => simp
  | cons x xs ih =>
      have htail := ih hl.2
      have hdouble := two_mul_natCard_le_of_addSubgroup_lt hl.1
      calc
        2 ^ (x :: xs).length = 2 * 2 ^ xs.length := by
          simp [pow_succ, Nat.mul_comm]
        _ ≤ 2 * Nat.card (AddSubgroup.closure (xs.toFinset : Set G)) :=
          Nat.mul_le_mul_left 2 htail
        _ ≤ Nat.card (AddSubgroup.closure ((x :: xs).toFinset : Set G)) :=
          hdouble

/-- Logarithmic form of
`IsStrictAddGeneratorChain.two_pow_length_le_natCard_closure`. -/
theorem IsStrictAddGeneratorChain.length_le_log_natCard_closure
    {l : List G} (hl : IsStrictAddGeneratorChain l) :
    l.length ≤ Nat.log 2 (Nat.card (AddSubgroup.closure (l.toFinset : Set G))) :=
  Nat.le_log_of_pow_le Nat.one_lt_two hl.two_pow_length_le_natCard_closure

/-- A finite source set admits a duplicate-free list of source elements whose
successive generated subgroups grow strictly, whose final closure is the
closure of the source, and whose length satisfies the sharp elementary
power-of-two bound. -/
theorem exists_strict_addGeneratorChain (S : Finset G) :
    ∃ l : List G,
      l.Nodup ∧
        (∀ x ∈ l, x ∈ S) ∧
        IsStrictAddGeneratorChain l ∧
        AddSubgroup.closure (l.toFinset : Set G) =
          AddSubgroup.closure (S : Set G) ∧
        2 ^ l.length ≤ Nat.card (AddSubgroup.closure (S : Set G)) := by
  classical
  obtain ⟨T, hTS, hTclosure, hTirr⟩ :=
    exists_irredundant_addGenerating_subset S
  let l := T.toList
  have hnodup : l.Nodup := Finset.nodup_toList T
  have hmem : ∀ x ∈ l, x ∈ S := by
    intro x hx
    apply hTS
    simpa [l] using hx
  have hirr : ∀ x ∈ l,
      x ∉ AddSubgroup.closure (((l.toFinset.erase x : Finset G)) : Set G) := by
    intro x hx
    simpa [l] using hTirr x (by simpa [l] using hx)
  have hchain : IsStrictAddGeneratorChain l :=
    strictChain_of_irredundant_list l hnodup hirr
  have hclosure : AddSubgroup.closure (l.toFinset : Set G) =
      AddSubgroup.closure (S : Set G) := by
    simpa [l] using hTclosure
  refine ⟨l, hnodup, hmem, hchain, hclosure, ?_⟩
  have hpow := hchain.two_pow_length_le_natCard_closure
  rw [hclosure] at hpow
  exact hpow

end

end Erdos874
