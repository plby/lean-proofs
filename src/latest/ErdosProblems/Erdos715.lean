/-!
# Erdős Problem 715

The theorem of Tashkinov that every finite simple quartic graph contains a
nonempty cubic subgraph.  The subgraph is neither required to be induced nor
spanning.

The first part of the development records the matching certificate used in
Tashkinov's proof.  If `G - N[u]` has a perfect matching, deleting `u` and the
matching edges leaves a cubic subgraph.
-/

open Finset Fintype
open scoped Classical

namespace Erdos715

open Erdos182

variable {V : Type*} [Fintype V]

/-! ## Finite pseudographs

Tashkinov's induction is carried out in a slightly larger class than simple
graphs: loops and parallel edges occur when a small edge cut is closed up.
The following multiplicity-matrix model keeps those intermediate objects
honest.  A loop contributes twice to the degree, as usual.
-/

/-- A finite undirected pseudograph, represented by its edge multiplicities.
The ambient vertex type is finite; vertices of degree zero are allowed. -/
structure Pseudograph (V : Type*) where
  mult : V → V → ℕ
  mult_comm : ∀ u v, mult u v = mult v u

namespace Pseudograph

variable {W : Type*} [Fintype W]

noncomputable section

@[ext]
lemma ext {G H : Pseudograph W} (h : ∀ u v, G.mult u v = H.mult u v) :
    G = H := by
  cases G with
  | mk gm gc =>
      cases H with
      | mk hm hc =>
          have hmh : gm = hm := by
            funext u v
            exact h u v
          subst hm
          rfl

/-- If two pointwise ordered finite families have total sums differing by
one, then any strict coordinate accounts for the unique unit of deficit. -/
lemma functions_eq_sub_indicator_of_sum_eq_add_one
    {A : Type*} [Fintype A] (f g : A → ℕ)
    (hle : ∀ x, f x ≤ g x)
    (hsum : (∑ x, g x) = (∑ x, f x) + 1)
    {v : A} (hlt : f v < g v) :
    ∀ x, f x = g x - if v = x then 1 else 0 := by
  classical
  let d : A → ℕ := fun x ↦ g x - f x
  have hsumd : (∑ x, d x) = 1 := by
    simp only [d]
    calc
      (∑ x, (g x - f x)) = (∑ x, g x) - ∑ x, f x := by
        exact Finset.sum_tsub_distrib Finset.univ (fun x _ ↦ hle x)
      _ = 1 := by omega
  have hdvpos : 0 < d v := by
    simp only [d]
    omega
  have hdvle : d v ≤ ∑ x, d x :=
    Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ v)
  have hdv : d v = 1 := by omega
  intro x
  by_cases hvx : v = x
  · subst x
    rw [if_pos rfl]
    simp only [d] at hdv
    omega
  · rw [if_neg hvx]
    have hpair : d v + d x ≤ ∑ y, d y := by
      rw [← Finset.sum_pair hvx]
      exact Finset.sum_le_sum_of_subset (by simp)
    have hdx : d x = 0 := by omega
    simp only [d] at hdx
    have hlex := hle x
    omega

/-- The degree in a pseudograph.  A loop has two incidences. -/
def degree (G : Pseudograph W) (v : W) : ℕ :=
  2 * G.mult v v + ∑ w ∈ Finset.univ.erase v, G.mult v w

/-- A loop contributes its second incidence separately; after that, degree
is the unrestricted row sum of the multiplicity matrix. -/
lemma degree_eq_mult_self_add_sum (G : Pseudograph W) (v : W) :
    G.degree v = G.mult v v + ∑ w, G.mult v w := by
  classical
  have hsum := Finset.sum_erase_add (s := Finset.univ)
    (f := fun w ↦ G.mult v w) (Finset.mem_univ v)
  simp only [degree]
  omega

/-- `H` is a part of `G` when it uses no edge with multiplicity exceeding
that in `G`.  Isolated ambient vertices are immaterial. -/
def IsPart (H G : Pseudograph W) : Prop :=
  ∀ u v, H.mult u v ≤ G.mult u v

lemma IsPart.refl (G : Pseudograph W) : G.IsPart G := by
  intro u v
  exact le_rfl

lemma IsPart.trans {F H G : Pseudograph W} (hFH : F.IsPart H)
    (hHG : H.IsPart G) : F.IsPart G := by
  intro u v
  exact (hFH u v).trans (hHG u v)

lemma degree_mono {H G : Pseudograph W} (hHG : H.IsPart G) (v : W) :
    H.degree v ≤ G.degree v := by
  classical
  unfold degree
  apply Nat.add_le_add
  · exact Nat.mul_le_mul_left 2 (hHG v v)
  · exact Finset.sum_le_sum fun w _ ↦ hHG v w

/-- Pointwise sum of pseudographs. -/
def add (G H : Pseudograph W) : Pseudograph W where
  mult u v := G.mult u v + H.mult u v
  mult_comm u v := by rw [G.mult_comm, H.mult_comm]

instance : Add (Pseudograph W) := ⟨add⟩

@[simp]
lemma add_mult (G H : Pseudograph W) (u v : W) :
    (G + H).mult u v = G.mult u v + H.mult u v :=
  rfl

/-- Degrees add under pointwise addition. -/
lemma degree_add (G H : Pseudograph W) (v : W) :
    (G + H).degree v = G.degree v + H.degree v := by
  classical
  simp only [degree, add_mult, Nat.mul_add, Finset.sum_add_distrib]
  omega

/-- Pointwise multiplicity difference. -/
def sdiff (G H : Pseudograph W) : Pseudograph W where
  mult u v := G.mult u v - H.mult u v
  mult_comm u v := by rw [G.mult_comm, H.mult_comm]

@[simp]
lemma sdiff_mult (G H : Pseudograph W) (u v : W) :
    (G.sdiff H).mult u v = G.mult u v - H.mult u v :=
  rfl

lemma sdiff_isPart_left (G H : Pseudograph W) : (G.sdiff H).IsPart G := by
  intro u v
  exact Nat.sub_le _ _

/-- If `H` is a part of `G`, subtraction loses exactly the degree of `H`. -/
lemma degree_sdiff_add (G H : Pseudograph W) (hHG : H.IsPart G) (v : W) :
    (G.sdiff H).degree v + H.degree v = G.degree v := by
  classical
  unfold degree
  simp only [sdiff_mult]
  have hloop := hHG v v
  have hsum :
      (∑ w ∈ Finset.univ.erase v, (G.mult v w - H.mult v w)) +
          ∑ w ∈ Finset.univ.erase v, H.mult v w =
        ∑ w ∈ Finset.univ.erase v, G.mult v w := by
    calc
      _ = ((∑ w ∈ Finset.univ.erase v, G.mult v w) -
            ∑ w ∈ Finset.univ.erase v, H.mult v w) +
          ∑ w ∈ Finset.univ.erase v, H.mult v w := by
            congr 1
            exact Finset.sum_tsub_distrib (Finset.univ.erase v)
              (fun w _ ↦ hHG v w)
      _ = _ := Nat.sub_add_cancel
        (Finset.sum_le_sum fun w _ ↦ hHG v w)
  have hloopEq :
      2 * (G.mult v v - H.mult v v) + 2 * H.mult v v =
        2 * G.mult v v := by
    rw [← Nat.mul_add, Nat.sub_add_cancel hloop]
  omega

/-- Delete every edge incident with one vertex, leaving that ambient vertex
isolated. -/
def deleteIncidence (G : Pseudograph W) (u : W) : Pseudograph W where
  mult x y := if x = u ∨ y = u then 0 else G.mult x y
  mult_comm x y := by
    by_cases h : x = u ∨ y = u
    · rw [if_pos h, if_pos (h.elim Or.inr Or.inl)]
    · have h' : ¬ (y = u ∨ x = u) := by tauto
      rw [if_neg h, if_neg h', G.mult_comm]

@[simp]
lemma deleteIncidence_mult (G : Pseudograph W) (u x y : W) :
    (G.deleteIncidence u).mult x y =
      if x = u ∨ y = u then 0 else G.mult x y :=
  rfl

lemma deleteIncidence_isPart (G : Pseudograph W) (u : W) :
    (G.deleteIncidence u).IsPart G := by
  intro x y
  simp only [deleteIncidence_mult]
  split <;> omega

@[simp]
lemma degree_deleteIncidence_self (G : Pseudograph W) (u : W) :
    (G.deleteIncidence u).degree u = 0 := by
  classical
  simp [degree, deleteIncidence]

/-- Away from the deleted vertex, incidence deletion removes exactly the
multiplicity of the edge to that vertex. -/
lemma degree_deleteIncidence_add_mult_of_ne
    (G : Pseudograph W) {u v : W} (hvu : v ≠ u) :
    (G.deleteIncidence u).degree v + G.mult v u = G.degree v := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  simp only [deleteIncidence_mult, hvu, false_or, if_false]
  have hsum := Finset.sum_erase_add (Finset.univ : Finset W)
    (fun w ↦ G.mult v w) (Finset.mem_univ u)
  have hdeleted :
      (∑ w : W, if w = u then 0 else G.mult v w) =
        ∑ w ∈ Finset.univ.erase u, G.mult v w := by
    rw [← Finset.filter_ne' Finset.univ u, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro w _
    by_cases hwu : w = u <;> simp [hwu]
  rw [hdeleted]
  omega

/-- Restriction of a pseudograph to a finite vertex shore. -/
def induce (G : Pseudograph W) (S : Finset W) : Pseudograph S where
  mult u v := G.mult u v
  mult_comm u v := G.mult_comm u v

@[simp]
lemma induce_mult (G : Pseudograph W) (S : Finset W) (u v : S) :
    (G.induce S).mult u v = G.mult u v :=
  rfl

/-- One undirected edge, allowing its two endpoints to coincide.  When they
coincide this is one loop and therefore contributes two to the degree. -/
def singleEdge (a b : W) : Pseudograph W where
  mult u v := if (u = a ∧ v = b) ∨ (u = b ∧ v = a) then 1 else 0
  mult_comm u v := by
    by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
    · simp only [if_pos h]
      rw [if_pos]
      tauto
    · simp only [if_neg h]
      rw [if_neg]
      tauto

@[simp]
lemma singleEdge_mult (a b u v : W) :
    (singleEdge a b).mult u v =
      if (u = a ∧ v = b) ∨ (u = b ∧ v = a) then 1 else 0 :=
  rfl

lemma singleEdge_comm (a b : W) : singleEdge a b = singleEdge b a := by
  ext u v
  simp only [singleEdge_mult]
  by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
  · rw [if_pos h, if_pos (by tauto)]
  · rw [if_neg h, if_neg (by tauto)]

/-- `k` parallel copies of one (possibly loop) edge. -/
def edgeCopies (k : ℕ) (a b : W) : Pseudograph W where
  mult u v := if (u = a ∧ v = b) ∨ (u = b ∧ v = a) then k else 0
  mult_comm u v := by
    by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
    · simp only [if_pos h]
      rw [if_pos]
      tauto
    · simp only [if_neg h]
      rw [if_neg]
      tauto

@[simp]
lemma edgeCopies_mult (k : ℕ) (a b u v : W) :
    (edgeCopies k a b).mult u v =
      if (u = a ∧ v = b) ∨ (u = b ∧ v = a) then k else 0 :=
  rfl

lemma edgeCopies_isPart {G : Pseudograph W} {k : ℕ} {a b : W}
    (h : k ≤ G.mult a b) : (edgeCopies k a b).IsPart G := by
  intro u v
  rw [edgeCopies_mult]
  split_ifs with huv
  · rcases huv with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact h
    · simpa only [G.mult_comm] using h
  · exact Nat.zero_le _

/-- The four edges of a `K₂,₂` on four distinct vertices form a part as
soon as each of those four edges is present. -/
lemma fourCrossEdges_isPart
    {G : Pseudograph W} {a b c d : W}
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (hAC : 0 < G.mult a c) (hAD : 0 < G.mult a d)
    (hBC : 0 < G.mult b c) (hBD : 0 < G.mult b d) :
    (((singleEdge a c + singleEdge a d) + singleEdge b c) +
      singleEdge b d).IsPart G := by
  intro x y
  simp only [add_mult, singleEdge_mult]
  let P (s t : W) : Prop :=
    (x = s ∧ y = t) ∨ (x = t ∧ y = s)
  by_cases h₁ : P a c
  · have h₂ : ¬ P a d := by
      intro h
      rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
        simp_all [P]
    have h₃ : ¬ P b c := by
      intro h
      rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
        simp_all [P]
    have h₄ : ¬ P b d := by
      intro h
      rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
        simp_all [P]
    rw [if_pos h₁, if_neg h₂, if_neg h₃, if_neg h₄]
    rcases h₁ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · omega
    · rw [G.mult_comm]
      omega
  · by_cases h₂ : P a d
    · have h₃ : ¬ P b c := by
        intro h
        rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
          simp_all [P]
      have h₄ : ¬ P b d := by
        intro h
        rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
          simp_all [P]
      rw [if_neg h₁, if_pos h₂, if_neg h₃, if_neg h₄]
      rcases h₂ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · omega
      · rw [G.mult_comm]
        omega
    · by_cases h₃ : P b c
      · have h₄ : ¬ P b d := by
          intro h
          rcases h₃ with h₃ | h₃ <;> rcases h with h | h <;>
            simp_all [P]
        rw [if_neg h₁, if_neg h₂, if_pos h₃, if_neg h₄]
        rcases h₃ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · omega
        · rw [G.mult_comm]
          omega
      · by_cases h₄ : P b d
        · rw [if_neg h₁, if_neg h₂, if_neg h₃, if_pos h₄]
          rcases h₄ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
          · omega
          · rw [G.mult_comm]
            omega
        · simp only [P] at h₁ h₂ h₃ h₄
          simp [h₁, h₂, h₃, h₄]

/-- The degree contribution of one edge is one incidence at each endpoint,
and hence two incidences when the edge is a loop. -/
lemma degree_singleEdge (a b v : W) :
    (singleEdge a b).degree v =
      (if v = a then 1 else 0) + (if v = b then 1 else 0) := by
  classical
  by_cases hab : a = b
  · subst b
    by_cases hva : v = a
    · subst v
      simp [degree, singleEdge]
    · simp [degree, singleEdge, hva]
  · have hba : b ≠ a := fun h ↦ hab h.symm
    by_cases hva : v = a
    · subst v
      simp [degree, singleEdge, hab, hba]
    · by_cases hvb : v = b
      · subst v
        simp [degree, singleEdge, hab, hba]
      · simp [degree, singleEdge, hva, hvb, hab, hba]

lemma degree_edgeCopies_of_ne (k : ℕ) {a b : W} (hab : a ≠ b) (v : W) :
    (edgeCopies k a b).degree v = if v = a ∨ v = b then k else 0 := by
  classical
  have hba : b ≠ a := fun h ↦ hab h.symm
  by_cases hva : v = a
  · subst v
    simp [degree, edgeCopies, hab, hba]
  · by_cases hvb : v = b
    · subst v
      simp [degree, edgeCopies, hab, hba]
    · simp [degree, edgeCopies, hva, hvb, hab, hba]

/-- A nonempty `k`-regular part.  Vertices outside the part have degree zero. -/
def ContainsRegularPart (G : Pseudograph W) (k : ℕ) : Prop :=
  ∃ H : Pseudograph W, H.IsPart G ∧ (∃ v, H.degree v = k) ∧
    ∀ v, H.degree v = 0 ∨ H.degree v = k

/-- A pseudograph is `r`-regular on the whole ambient vertex type. -/
def IsRegularOfDegree (G : Pseudograph W) (r : ℕ) : Prop :=
  ∀ v, G.degree v = r

/-- Four distinct positive nonloop incidences exhaust the degree of a
quartic vertex.  This elementary saturation lemma is repeatedly used in
the three-outside-vertex branch of Proposition 2.3. -/
lemma four_neighbors_saturate
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    {x a b c d : W}
    (hxa : x ≠ a) (hxb : x ≠ b) (hxc : x ≠ c) (hxd : x ≠ d)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (hA : 0 < G.mult x a) (hB : 0 < G.mult x b)
    (hC : 0 < G.mult x c) (hD : 0 < G.mult x d) :
    G.mult x x = 0 ∧ G.mult x a = 1 ∧ G.mult x b = 1 ∧
      G.mult x c = 1 ∧ G.mult x d = 1 ∧
      ∀ y, y ≠ x → y ≠ a → y ≠ b → y ≠ c → y ≠ d →
        G.mult x y = 0 := by
  classical
  have hfourSum :
      (∑ y ∈ ({a, b, c, d} : Finset W), G.mult x y) ≤
        ∑ y : W, G.mult x y :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hdeg := hreg x
  rw [degree_eq_mult_self_add_sum] at hdeg
  have hloop : G.mult x x = 0 := by
    simp [hab, hac, had, hbc, hbd, hcd] at hfourSum
    omega
  have hAe : G.mult x a = 1 := by
    simp [hab, hac, had, hbc, hbd, hcd] at hfourSum
    omega
  have hBe : G.mult x b = 1 := by
    simp [hab, hac, had, hbc, hbd, hcd] at hfourSum
    omega
  have hCe : G.mult x c = 1 := by
    simp [hab, hac, had, hbc, hbd, hcd] at hfourSum
    omega
  have hDe : G.mult x d = 1 := by
    simp [hab, hac, had, hbc, hbd, hcd] at hfourSum
    omega
  refine ⟨hloop, hAe, hBe, hCe, hDe, ?_⟩
  intro y hyx hya hyb hyc hyd
  have hfiveSum :
      (∑ z ∈ ({a, b, c, d, y} : Finset W), G.mult x z) ≤
        ∑ z : W, G.mult x z :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  simp [hab, hac, had, hbc, hbd, hcd, hya, hyb, hyc, hyd,
    hya.symm, hyb.symm, hyc.symm, hyd.symm] at hfiveSum
  omega

/-- Two disjoint double edges joined by two disjoint links form a cubic
part. -/
lemma containsRegularPart_of_two_doubleEdges_and_links
    (G : Pseudograph W) {u v a b : W}
    (huv : u ≠ v) (hua : u ≠ a) (hub : u ≠ b)
    (hva : v ≠ a) (hvb : v ≠ b) (hab : a ≠ b)
    (hUV : 2 ≤ G.mult u v) (hAB : 2 ≤ G.mult a b)
    (hUA : 0 < G.mult u a) (hVB : 0 < G.mult v b) :
    G.ContainsRegularPart 3 := by
  classical
  let H : Pseudograph W :=
    ((edgeCopies 2 u v + edgeCopies 2 a b) + singleEdge u a) +
      singleEdge v b
  have hpart : H.IsPart G := by
    intro x y
    simp only [H, add_mult, edgeCopies_mult, singleEdge_mult]
    let P (s t : W) : Prop :=
      (x = s ∧ y = t) ∨ (x = t ∧ y = s)
    by_cases h₁ : P u v
    · have h₂ : ¬ P a b := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      have h₃ : ¬ P u a := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      have h₄ : ¬ P v b := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      rw [if_pos h₁, if_neg h₂, if_neg h₃, if_neg h₄]
      rcases h₁ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · omega
      · rw [G.mult_comm]
        omega
    · by_cases h₂ : P a b
      · have h₃ : ¬ P u a := by
          intro h
          rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
            simp_all [P]
        have h₄ : ¬ P v b := by
          intro h
          rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
            simp_all [P]
        rw [if_neg h₁, if_pos h₂, if_neg h₃, if_neg h₄]
        rcases h₂ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · omega
        · rw [G.mult_comm]
          omega
      · by_cases h₃ : P u a
        · have h₄ : ¬ P v b := by
            intro h
            rcases h₃ with h₃ | h₃ <;> rcases h with h | h <;>
              simp_all [P]
          rw [if_neg h₁, if_neg h₂, if_pos h₃, if_neg h₄]
          rcases h₃ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
          · omega
          · rw [G.mult_comm]
            omega
        · by_cases h₄ : P v b
          · rw [if_neg h₁, if_neg h₂, if_neg h₃, if_pos h₄]
            rcases h₄ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            · omega
            · rw [G.mult_comm]
              omega
          · simp only [P] at h₁ h₂ h₃ h₄
            simp [h₁, h₂, h₃, h₄]
  refine ⟨H, hpart, ⟨u, ?_⟩, ?_⟩
  · simp [H, degree_add, degree_edgeCopies_of_ne, degree_singleEdge,
      huv, hua, hub, hva, hvb, hab]
  · intro x
    simp only [H, degree_add, degree_singleEdge]
    rw [degree_edgeCopies_of_ne 2 huv,
      degree_edgeCopies_of_ne 2 hab]
    by_cases hxu : x = u <;> by_cases hxv : x = v <;>
      by_cases hxa : x = a <;> by_cases hxb : x = b <;>
      simp_all

/-- A double edge, a loop at each of two further vertices, and two disjoint
links form a cubic part. -/
lemma containsRegularPart_of_doubleEdge_twoLoops_and_links
    (G : Pseudograph W) {u v a b : W}
    (huv : u ≠ v) (hua : u ≠ a) (hub : u ≠ b)
    (hva : v ≠ a) (hvb : v ≠ b) (hab : a ≠ b)
    (hUV : 2 ≤ G.mult u v)
    (hAA : 0 < G.mult a a) (hBB : 0 < G.mult b b)
    (hUA : 0 < G.mult u a) (hVB : 0 < G.mult v b) :
    G.ContainsRegularPart 3 := by
  classical
  let H : Pseudograph W :=
    (((edgeCopies 2 u v + singleEdge a a) + singleEdge b b) +
      singleEdge u a) + singleEdge v b
  have hpart : H.IsPart G := by
    intro x y
    simp only [H, add_mult, edgeCopies_mult, singleEdge_mult]
    let P (s t : W) : Prop :=
      (x = s ∧ y = t) ∨ (x = t ∧ y = s)
    by_cases h₁ : P u v
    · have h₂ : ¬ P a a := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      have h₃ : ¬ P b b := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      have h₄ : ¬ P u a := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      have h₅ : ¬ P v b := by
        intro h
        rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
          simp_all [P]
      rw [if_pos h₁, if_neg h₂, if_neg h₃, if_neg h₄, if_neg h₅]
      rcases h₁ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · omega
      · rw [G.mult_comm]
        omega
    · by_cases h₂ : P a a
      · have h₃ : ¬ P b b := by
          intro h
          rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
            simp_all [P]
        have h₄ : ¬ P u a := by
          intro h
          rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
            simp_all [P]
        have h₅ : ¬ P v b := by
          intro h
          rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
            simp_all [P]
        rw [if_neg h₁, if_pos h₂, if_neg h₃, if_neg h₄,
          if_neg h₅]
        rcases h₂ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> omega
      · by_cases h₃ : P b b
        · have h₄ : ¬ P u a := by
            intro h
            rcases h₃ with h₃ | h₃ <;> rcases h with h | h <;>
              simp_all [P]
          have h₅ : ¬ P v b := by
            intro h
            rcases h₃ with h₃ | h₃ <;> rcases h with h | h <;>
              simp_all [P]
          rw [if_neg h₁, if_neg h₂, if_pos h₃, if_neg h₄,
            if_neg h₅]
          rcases h₃ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> omega
        · by_cases h₄ : P u a
          · have h₅ : ¬ P v b := by
              intro h
              rcases h₄ with h₄ | h₄ <;> rcases h with h | h <;>
                simp_all [P]
            rw [if_neg h₁, if_neg h₂, if_neg h₃, if_pos h₄,
              if_neg h₅]
            rcases h₄ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            · omega
            · rw [G.mult_comm]
              omega
          · by_cases h₅ : P v b
            · rw [if_neg h₁, if_neg h₂, if_neg h₃, if_neg h₄,
                if_pos h₅]
              rcases h₅ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
              · omega
              · rw [G.mult_comm]
                omega
            · simp only [P] at h₁ h₂ h₃ h₄ h₅
              have h₂' : ¬(x = a ∧ y = a) := fun h ↦ h₂ (.inl h)
              have h₃' : ¬(x = b ∧ y = b) := fun h ↦ h₃ (.inl h)
              simp [h₁, h₂', h₃', h₄, h₅]
  refine ⟨H, hpart, ⟨u, ?_⟩, ?_⟩
  · simp [H, degree_add, degree_edgeCopies_of_ne,
      degree_singleEdge, huv, hua, hub, hva, hvb, hab]
  · intro x
    simp only [H, degree_add, degree_singleEdge]
    rw [degree_edgeCopies_of_ne 2 huv]
    by_cases hxu : x = u <;> by_cases hxv : x = v <;>
      by_cases hxa : x = a <;> by_cases hxb : x = b <;>
      simp_all

/-- A loopless double edge together with two further distinct positive
neighbors exhausts a quartic vertex. -/
lemma double_and_two_neighbors_saturate
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    {x y a b : W}
    (hxy : x ≠ y) (hxa : x ≠ a) (hxb : x ≠ b)
    (hya : y ≠ a) (hyb : y ≠ b) (hab : a ≠ b)
    (hloop : G.mult x x = 0) (hdouble : G.mult x y = 2)
    (hA : 0 < G.mult x a) (hB : 0 < G.mult x b) :
    G.mult x a = 1 ∧ G.mult x b = 1 ∧
      ∀ z, z ≠ x → z ≠ y → z ≠ a → z ≠ b → G.mult x z = 0 := by
  classical
  have hthreeSum :
      (∑ z ∈ ({y, a, b} : Finset W), G.mult x z) ≤
        ∑ z : W, G.mult x z :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hdeg := hreg x
  rw [degree_eq_mult_self_add_sum, hloop] at hdeg
  have hAe : G.mult x a = 1 := by
    simp [hya, hyb, hab] at hthreeSum
    omega
  have hBe : G.mult x b = 1 := by
    simp [hya, hyb, hab] at hthreeSum
    omega
  refine ⟨hAe, hBe, ?_⟩
  intro z hzx hzy hza hzb
  have hfourSum :
      (∑ w ∈ ({y, a, b, z} : Finset W), G.mult x w) ≤
        ∑ w : W, G.mult x w :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  simp [hya, hyb, hab, hzy, hza, hzb, hzy.symm, hza.symm,
    hzb.symm] at hfourSum
  omega

/-- Three distinct positive nonloop neighbors already rule out a loop at a
quartic vertex. -/
lemma loopless_of_three_neighbors
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    {x a b c : W}
    (hxa : x ≠ a) (hxb : x ≠ b) (hxc : x ≠ c)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (hA : 0 < G.mult x a) (hB : 0 < G.mult x b)
    (hC : 0 < G.mult x c) : G.mult x x = 0 := by
  classical
  have hthreeSum :
      (∑ y ∈ ({a, b, c} : Finset W), G.mult x y) ≤
        ∑ y : W, G.mult x y :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hfourSum :
      (∑ y ∈ ({x, a, b, c} : Finset W), G.mult x y) ≤
        ∑ y : W, G.mult x y :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hdeg := hreg x
  rw [degree_eq_mult_self_add_sum] at hdeg
  simp [hab, hac, hbc] at hthreeSum
  simp [hxa, hxb, hxc, hab, hac, hbc] at hfourSum
  omega

/-- Three disjoint matching edges indexed by the six elements of `Fin 6`. -/
def threeMatchingEdges (f : Fin 6 → W) : Pseudograph W :=
  (singleEdge (f 0) (f 1) + singleEdge (f 2) (f 3)) +
    singleEdge (f 4) (f 5)

lemma threeMatchingEdges_isPart
    (G : Pseudograph W) (f : Fin 6 → W) (hf : Function.Injective f)
    (h01 : 0 < G.mult (f 0) (f 1))
    (h23 : 0 < G.mult (f 2) (f 3))
    (h45 : 0 < G.mult (f 4) (f 5)) :
    (threeMatchingEdges f).IsPart G := by
  intro x y
  simp only [threeMatchingEdges, add_mult, singleEdge_mult]
  let P (s t : W) : Prop :=
    (x = s ∧ y = t) ∨ (x = t ∧ y = s)
  by_cases h₁ : P (f 0) (f 1)
  · have h₂ : ¬ P (f 2) (f 3) := by
      intro h
      rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
        simp_all [P, hf.eq_iff]
    have h₃ : ¬ P (f 4) (f 5) := by
      intro h
      rcases h₁ with h₁ | h₁ <;> rcases h with h | h <;>
        simp_all [P, hf.eq_iff]
    rw [if_pos h₁, if_neg h₂, if_neg h₃]
    rcases h₁ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · omega
    · rw [G.mult_comm]
      omega
  · by_cases h₂ : P (f 2) (f 3)
    · have h₃ : ¬ P (f 4) (f 5) := by
        intro h
        rcases h₂ with h₂ | h₂ <;> rcases h with h | h <;>
          simp_all [P, hf.eq_iff]
      rw [if_neg h₁, if_pos h₂, if_neg h₃]
      rcases h₂ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · omega
      · rw [G.mult_comm]
        omega
    · by_cases h₃ : P (f 4) (f 5)
      · rw [if_neg h₁, if_neg h₂, if_pos h₃]
        rcases h₃ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · omega
        · rw [G.mult_comm]
          omega
      · simp only [P] at h₁ h₂ h₃
        simp [h₁, h₂, h₃]

lemma degree_threeMatchingEdges_eq_one
    (f : Fin 6 → W) (hf : Function.Injective f)
    (hcover : ∀ x : W, ∃ i : Fin 6, x = f i) (x : W) :
    (threeMatchingEdges f).degree x = 1 := by
  obtain ⟨i, rfl⟩ := hcover x
  fin_cases i <;>
    simp [threeMatchingEdges, degree_add, degree_singleEdge, hf.eq_iff]

/-- In a six-vertex matching whose first edge joins `none` to `some a`,
the row at `none` is precisely the indicator of `a`. -/
lemma threeMatchingEdges_none_row
    {X : Type*} [Fintype X] (a b c d e v : X) :
    (threeMatchingEdges
      (![none, some a, some b, some c, some d, some e] :
        Fin 6 → Option X)).mult none (some v) =
      if v = a then 1 else 0 := by
  simp [threeMatchingEdges, singleEdge_mult]

/-- Subtracting a spanning degree-one part from a quartic pseudograph gives
a spanning cubic part. -/
lemma containsRegularPart_of_degreeOnePart [Nonempty W]
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (F : Pseudograph W) (hpart : F.IsPart G)
    (hdeg : ∀ v, F.degree v = 1) :
    G.ContainsRegularPart 3 := by
  let H := G.sdiff F
  have hHdeg (v : W) : H.degree v = 3 := by
    have hdiff := G.degree_sdiff_add F hpart v
    change H.degree v + F.degree v = G.degree v at hdiff
    rw [hdeg v, hreg v] at hdiff
    omega
  let v : W := Classical.choice inferInstance
  exact ⟨H, G.sdiff_isPart_left F, ⟨v, hHdeg v⟩,
    fun x ↦ .inr (hHdeg x)⟩

/-- At a quartic vertex, one positive loop and two further distinct positive
neighbors consume all four incidences. -/
lemma loop_and_two_neighbors_saturate
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    {x a b : W} (hxa : x ≠ a) (hxb : x ≠ b) (hab : a ≠ b)
    (hloop : 0 < G.mult x x) (hA : 0 < G.mult x a)
    (hB : 0 < G.mult x b) :
    G.mult x x = 1 ∧ G.mult x a = 1 ∧ G.mult x b = 1 ∧
      ∀ y, y ≠ x → y ≠ a → y ≠ b → G.mult x y = 0 := by
  classical
  have hthreeSum :
      (∑ y ∈ ({x, a, b} : Finset W), G.mult x y) ≤
        ∑ y : W, G.mult x y :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hdegree := hreg x
  rw [degree_eq_mult_self_add_sum] at hdegree
  have hthree : G.mult x x + G.mult x a + G.mult x b ≤
      ∑ y : W, G.mult x y := by
    simpa [hxa, hxb, hab, Nat.add_assoc] using hthreeSum
  have hxx : G.mult x x = 1 := by omega
  have hxA : G.mult x a = 1 := by omega
  have hxB : G.mult x b = 1 := by omega
  refine ⟨hxx, hxA, hxB, ?_⟩
  intro y hyx hya hyb
  have hfourSum :
      (∑ z ∈ ({x, a, b, y} : Finset W), G.mult x z) ≤
        ∑ z : W, G.mult x z :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hfour : G.mult x x + G.mult x a + G.mult x b + G.mult x y ≤
      ∑ z : W, G.mult x z := by
    simpa [hxa, hxb, hab, hyx, hya, hyb,
      hyx.symm, hya.symm, hyb.symm, Nat.add_assoc] using hfourSum
  omega

lemma eq_or_eq_of_fintype_card_two {X : Type*} [Fintype X]
    {a b : X} (hab : a ≠ b) (hcard : Fintype.card X = 2) (x : X) :
    x = a ∨ x = b := by
  classical
  by_contra hx
  push_neg at hx
  have hthree : ({a, b, x} : Finset X).card = 3 := by
    simp [hab, hx.1, hx.2, hx.1.symm, hx.2.symm]
  have hle : ({a, b, x} : Finset X).card ≤ Fintype.card X := by
    simpa only [Fintype.card] using
      Finset.card_le_card (Finset.subset_univ ({a, b, x} : Finset X))
  omega

lemma fintype_sum_eq_add_of_card_two {X : Type*} [Fintype X]
    {a b : X} (hab : a ≠ b) (hcard : Fintype.card X = 2)
    (f : X → ℕ) : (∑ x, f x) = f a + f b := by
  classical
  have huniv : (Finset.univ : Finset X) = {a, b} := by
    ext x
    simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton,
      true_iff]
    exact eq_or_eq_of_fintype_card_two hab hcard x
  change (Finset.univ : Finset X).sum f = f a + f b
  rw [huniv]
  simp [hab]

lemma degree_singleEdge_eq_one_of_fintype_card_two
    {X : Type*} [Fintype X] {a b : X} (hab : a ≠ b)
    (hcard : Fintype.card X = 2) (x : X) :
    (singleEdge a b).degree x = 1 := by
  rw [degree_singleEdge]
  rcases eq_or_eq_of_fintype_card_two hab hcard x with rfl | rfl
  · simp [hab]
  · simp [hab, hab.symm]

lemma degree_edgeCopies_eq_of_fintype_card_two
    {X : Type*} [Fintype X] (k : ℕ) {a b : X} (hab : a ≠ b)
    (hcard : Fintype.card X = 2) (x : X) :
    (edgeCopies k a b).degree x = k := by
  rw [degree_edgeCopies_of_ne k hab]
  rcases eq_or_eq_of_fintype_card_two hab hcard x with rfl | rfl <;> simp

/-- Number of incidences from `v` to the complementary shore. -/
def outsideDegree (G : Pseudograph W) (S : Finset W) (v : W) : ℕ :=
  ∑ w ∈ Sᶜ, G.mult v w

/-- Restriction loses exactly the incidences going outside the shore. -/
lemma degree_induce_add_outsideDegree (G : Pseudograph W)
    (S : Finset W) (v : W) (hv : v ∈ S) :
    (G.induce S).degree ⟨v, hv⟩ + G.outsideDegree S v = G.degree v := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  simp only [induce_mult, Finset.univ_eq_attach, Finset.sum_attach,
    outsideDegree]
  have hsum := Finset.sum_add_sum_compl S (fun w ↦ G.mult v w)
  omega

/-- An individually labelled edge crossing from `S` to its complement.
The `Fin` coordinate distinguishes parallel edges. -/
structure CrossingEdge (G : Pseudograph W) (S : Finset W) where
  inside : W
  outside : W
  inside_mem : inside ∈ S
  outside_notMem : outside ∉ S
  index : Fin (G.mult inside outside)

@[ext]
lemma CrossingEdge.ext {G : Pseudograph W} {S : Finset W}
    {e f : CrossingEdge G S} (hinside : e.inside = f.inside)
    (houtside : e.outside = f.outside)
    (hindex : e.index.val = f.index.val) : e = f := by
  cases e
  cases f
  simp only at hinside houtside hindex ⊢
  subst hinside
  subst houtside
  congr
  exact Fin.ext hindex

lemma two_le_mult_of_distinct_crossingEdges_same_endpoints
    {G : Pseudograph W} {S : Finset W}
    {e f : CrossingEdge G S} (hef : e ≠ f)
    (hin : e.inside = f.inside) (hout : e.outside = f.outside) :
    2 ≤ G.mult e.inside e.outside := by
  have hindex : e.index.val ≠ f.index.val := by
    intro h
    exact hef (CrossingEdge.ext hin hout h)
  have he := e.index.isLt
  have hf : f.index.val < G.mult e.inside e.outside := by
    calc
      f.index.val < G.mult f.inside f.outside := f.index.isLt
      _ = G.mult e.inside e.outside := by rw [hin, hout]
  omega

/-- Coordinate description used to obtain finiteness of labelled crossing
edges without quotienting undirected edges. -/
noncomputable def crossingEdgeEquivSigma (G : Pseudograph W) (S : Finset W) :
    CrossingEdge G S ≃
      Σ x : {x : W // x ∈ S}, Σ y : {y : W // y ∈ Sᶜ}, Fin (G.mult x y) where
  toFun e := ⟨⟨e.inside, e.inside_mem⟩,
    ⟨⟨e.outside, Finset.mem_compl.mpr e.outside_notMem⟩, e.index⟩⟩
  invFun e := {
    inside := e.1.1
    outside := e.2.1.1
    inside_mem := e.1.2
    outside_notMem := Finset.mem_compl.mp e.2.1.2
    index := e.2.2 }
  left_inv e := by cases e; rfl
  right_inv e := by
    rcases e with ⟨x, y, z⟩
    rfl

noncomputable instance crossingEdgeFintype (G : Pseudograph W) (S : Finset W) :
    Fintype (CrossingEdge G S) :=
  Fintype.ofEquiv _ (crossingEdgeEquivSigma G S).symm

/-- Crossing edges whose endpoint on the shore is a prescribed vertex. -/
def CrossingAt (G : Pseudograph W) (S : Finset W) (v : W) :=
  {e : CrossingEdge G S // e.inside = v}

noncomputable instance crossingAtFintype (G : Pseudograph W)
    (S : Finset W) (v : W) : Fintype (CrossingAt G S v) :=
  by
    classical
    exact Fintype.subtype
      (Finset.univ.filter fun e : CrossingEdge G S ↦ e.inside = v) (by simp)

/-- The labelled crossing edges at `v` are the disjoint union, over outside
vertices, of the parallel copies joining that outside vertex to `v`. -/
noncomputable def crossingAtEquivSigma (G : Pseudograph W)
    (S : Finset W) (v : W) (hv : v ∈ S) :
    CrossingAt G S v ≃ Σ w : {w : W // w ∈ Sᶜ}, Fin (G.mult v w) where
  toFun e := ⟨⟨e.1.outside, by simpa using e.1.outside_notMem⟩,
    Fin.cast (by rw [e.2]) e.1.index⟩
  invFun e := ⟨{
    inside := v
    outside := e.1.1
    inside_mem := hv
    outside_notMem := Finset.mem_compl.mp e.1.2
    index := e.2 }, rfl⟩
  left_inv e := by
    apply Subtype.ext
    cases e with
    | mk e he =>
      cases e
      simp only at he ⊢
      subst he
      rfl
  right_inv e := by
    apply Sigma.ext
    · rfl
    · simp

lemma card_crossingAt (G : Pseudograph W) (S : Finset W)
    (v : W) (hv : v ∈ S) :
    Fintype.card (CrossingAt G S v) = G.outsideDegree S v := by
  classical
  rw [Fintype.card_congr (crossingAtEquivSigma G S v hv), Fintype.card_sigma]
  simp only [Fintype.card_fin, outsideDegree, Finset.univ_eq_attach,
    Finset.sum_attach]

noncomputable def crossingEdgeEquivSigmaAt (G : Pseudograph W)
    (S : Finset W) :
    CrossingEdge G S ≃ Σ v : S, CrossingAt G S v where
  toFun e := ⟨⟨e.inside, e.inside_mem⟩, ⟨e, rfl⟩⟩
  invFun e := e.2.1
  left_inv e := rfl
  right_inv e := by
    rcases e with ⟨v, e, he⟩
    cases e
    simp only at he ⊢
    subst he
    rfl

/-- Three parallel copies of a non-loop edge are already a cubic part. -/
lemma containsRegularPart_of_three_le_mult (G : Pseudograph W)
    {u v : W} (huv : u ≠ v) (hthree : 3 ≤ G.mult u v) :
    G.ContainsRegularPart 3 := by
  refine ⟨edgeCopies 3 u v, edgeCopies_isPart hthree, ⟨u, ?_⟩, ?_⟩
  · rw [degree_edgeCopies_of_ne 3 huv]
    simp
  · intro w
    rw [degree_edgeCopies_of_ne 3 huv]
    split_ifs
    · exact .inr rfl
    · exact .inl rfl

/-- The number of vertices carrying at least one loop. -/
def loopVertexCount (G : Pseudograph W) : ℕ :=
  (Finset.univ.filter fun v ↦ 0 < G.mult v v).card

/-- The number of loop *copies*.  This is Tashkinov's parameter `φ(G)`;
unlike `loopVertexCount`, it distinguishes one loop from two loops at the
same vertex. -/
def loopCount (G : Pseudograph W) : ℕ :=
  ∑ v, G.mult v v

lemma loopCount_add (G H : Pseudograph W) :
    (G + H).loopCount = G.loopCount + H.loopCount := by
  classical
  simp [loopCount, add_mult, Finset.sum_add_distrib]

lemma loopCount_singleEdge (a b : W) :
    (singleEdge a b).loopCount = if a = b then 1 else 0 := by
  classical
  by_cases hab : a = b
  · subst b
    simp [loopCount, singleEdge_mult]
  · have hzero (v : W) : (singleEdge a b).mult v v = 0 := by
      rw [singleEdge_mult, if_neg]
      intro h
      rcases h with ⟨hva, hvb⟩ | ⟨hvb, hva⟩
      · exact hab (hva.symm.trans hvb)
      · exact hab (hva.symm.trans hvb)
    rw [if_neg hab]
    unfold loopCount
    exact Finset.sum_eq_zero fun v _ ↦ hzero v

/-- The number of unordered distinct vertex pairs carrying parallel edges.
The division by two removes the two orientations of each off-diagonal pair. -/
def parallelPairCount (G : Pseudograph W) : ℕ :=
  ((Finset.univ.filter fun p : W × W ↦ p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2).card) / 2

/-- The ordered-pair filter used to define `parallelPairCount` has exactly
two orientations for every unordered parallel pair. -/
lemma parallelPairFilter_card_eq_two_mul (G : Pseudograph W) :
    (Finset.univ.filter fun p : W × W ↦
      p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2).card =
      2 * G.parallelPairCount := by
  classical
  let oldDecidableEq : DecidableEq W := Classical.decEq W
  letI : LinearOrder W :=
    LinearOrder.lift' (Fintype.equivFin W) (Fintype.equivFin W).injective
  letI : DecidableEq W := oldDecidableEq
  let P : W × W → Prop := fun p ↦
    p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2
  let D := Finset.univ.filter P
  let K := Finset.univ.filter fun p : W × W ↦ P p ∧ p.1 < p.2
  let sw : W × W ↪ W × W :=
    ⟨Prod.swap, by
      intro p q h
      exact Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h)⟩
  have hDK : D = K ∪ K.image sw := by
    ext p
    simp only [D, K, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_union, Finset.mem_image]
    constructor
    · intro hp
      rcases lt_or_gt_of_ne hp.1 with hlt | hgt
      · exact .inl ⟨hp, hlt⟩
      · apply Or.inr
        refine ⟨(p.2, p.1), ?_, ?_⟩
        · exact ⟨⟨hp.1.symm, by simpa only [G.mult_comm] using hp.2⟩, hgt⟩
        · rfl
    · rintro (hp | ⟨q, hq, hqp⟩)
      · exact hp.1
      · have hfst : p.1 = q.2 := by
          change (q.2, q.1) = p at hqp
          exact congrArg Prod.fst hqp.symm
        have hsnd : p.2 = q.1 := by
          exact congrArg Prod.snd hqp.symm
        refine ⟨?_, ?_⟩
        · intro h
          apply hq.1.1
          exact hsnd.symm.trans (h.symm.trans hfst)
        · rw [hfst, hsnd, G.mult_comm]
          exact hq.1.2
  have hdis : Disjoint K (K.image sw) := by
    rw [Finset.disjoint_left]
    intro p hp hp'
    have hpLt : p.1 < p.2 := (Finset.mem_filter.mp hp).2.2
    obtain ⟨q, hq, hqp⟩ := Finset.mem_image.mp hp'
    have hqLt : q.1 < q.2 := (Finset.mem_filter.mp hq).2.2
    change (q.2, q.1) = p at hqp
    have hfst : p.1 = q.2 := by
      exact congrArg Prod.fst hqp.symm
    have hsnd : p.2 = q.1 := by
      exact congrArg Prod.snd hqp.symm
    rw [hfst, hsnd] at hpLt
    exact lt_asymm hpLt hqLt
  have hcard : D.card = 2 * K.card := by
    rw [hDK, Finset.card_union_of_disjoint hdis,
      Finset.card_image_of_injective K sw.injective]
    omega
  have hcard' :
      (Finset.univ.filter fun p : W × W ↦
        p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2).card = 2 * K.card := by
    simpa only [D] using hcard
  unfold parallelPairCount
  rw [hcard']
  omega

/-- The pseudograph associated to a simple graph. -/
def ofSimple (G : SimpleGraph W) : Pseudograph W where
  mult u v := if G.Adj u v then 1 else 0
  mult_comm u v := by rw [G.adj_comm]

@[simp]
lemma ofSimple_mult (G : SimpleGraph W) (u v : W) :
    (ofSimple G).mult u v = if G.Adj u v then 1 else 0 :=
  rfl

@[simp]
lemma ofSimple_mult_self (G : SimpleGraph W) (v : W) :
    (ofSimple G).mult v v = 0 := by
  simp

/-- A simple graph and its multiplicity pseudograph have the same degrees. -/
lemma degree_ofSimple (G : SimpleGraph W) (v : W) :
    (ofSimple G).degree v = G.degree v := by
  classical
  rw [degree, ofSimple_mult_self, Nat.mul_zero, Nat.zero_add,
    ← SimpleGraph.card_neighborFinset_eq_degree]
  have hneighbors : G.neighborFinset v =
      (Finset.univ.erase v).filter (G.Adj v) := by
    ext w
    simp only [SimpleGraph.mem_neighborFinset, Finset.mem_filter,
      Finset.mem_erase, Finset.mem_univ, and_true]
    exact ⟨fun h ↦ ⟨h.ne', h⟩, And.right⟩
  rw [hneighbors]
  simp [ofSimple_mult]

lemma isRegularOfDegree_ofSimple_iff (G : SimpleGraph W) (r : ℕ) :
    (ofSimple G).IsRegularOfDegree r ↔ G.IsRegularOfDegree r := by
  simp only [IsRegularOfDegree, SimpleGraph.IsRegularOfDegree, degree_ofSimple]

/-- Forget loops and multiplicities, retaining the underlying simple graph. -/
def toSimple (G : Pseudograph W) : SimpleGraph W where
  Adj u v := u ≠ v ∧ 0 < G.mult u v
  symm := ⟨by
    intro u v huv
    exact ⟨huv.1.symm, by simpa only [G.mult_comm] using huv.2⟩⟩
  loopless := ⟨by simp⟩

@[simp]
lemma toSimple_adj (G : Pseudograph W) (u v : W) :
    G.toSimple.Adj u v ↔ u ≠ v ∧ 0 < G.mult u v :=
  Iff.rfl

/-- Forgetting multiplicities preserves degree when the pseudograph is
loopless and every edge multiplicity is at most one. -/
lemma degree_toSimple (G : Pseudograph W)
    (hloop : ∀ v, G.mult v v = 0)
    (hsimple : ∀ u v, G.mult u v ≤ 1) (v : W) :
    G.toSimple.degree v = G.degree v := by
  classical
  rw [degree, hloop, Nat.mul_zero, Nat.zero_add,
    ← SimpleGraph.card_neighborFinset_eq_degree]
  have hneighbors : G.toSimple.neighborFinset v =
      (Finset.univ.erase v).filter (fun w ↦ 0 < G.mult v w) := by
    ext w
    simp only [SimpleGraph.mem_neighborFinset, toSimple_adj, Finset.mem_filter,
      Finset.mem_erase, Finset.mem_univ, and_true]
    tauto
  rw [hneighbors]
  symm
  calc
    ∑ w ∈ Finset.univ.erase v, G.mult v w =
        ∑ w ∈ Finset.univ.erase v, if 0 < G.mult v w then 1 else 0 := by
          apply Finset.sum_congr rfl
          intro w _
          have hle := hsimple v w
          split_ifs with hw
          · omega
          · omega
    _ = ((Finset.univ.erase v).filter fun w ↦ 0 < G.mult v w).card := by
      simp

lemma loopless_of_isPart_ofSimple {G : SimpleGraph W} {H : Pseudograph W}
    (hHG : H.IsPart (ofSimple G)) (v : W) : H.mult v v = 0 := by
  have := hHG v v
  simp only [ofSimple_mult_self] at this
  omega

lemma mult_le_one_of_isPart_ofSimple {G : SimpleGraph W} {H : Pseudograph W}
    (hHG : H.IsPart (ofSimple G)) (u v : W) : H.mult u v ≤ 1 := by
  exact (hHG u v).trans (by simp only [ofSimple_mult]; split_ifs <;> omega)

/-- An off-diagonal edge multiplicity is bounded by the degree at either
endpoint. -/
lemma mult_le_degree_of_ne (G : Pseudograph W) {u v : W} (huv : u ≠ v) :
    G.mult u v ≤ G.degree u := by
  classical
  unfold degree
  have hsum : G.mult u v ≤ ∑ w ∈ Finset.univ.erase u, G.mult u w :=
    Finset.single_le_sum (f := fun w ↦ G.mult u w)
      (fun _ _ ↦ Nat.zero_le _) (by simp [huv.symm])
  exact hsum.trans (Nat.le_add_left _ _)

/-- A regular multiplicity part of a simple graph is an honest regular
`SimpleGraph.Subgraph`.  This is the bridge from Tashkinov's pseudograph
induction to the repository's literal problem statement. -/
theorem containsRegularSubgraph_of_containsRegularPart_ofSimple
    (G : SimpleGraph W) {k : ℕ} (hk : 0 < k)
    (hpart : (ofSimple G).ContainsRegularPart k) :
    ContainsRegularSubgraph G k := by
  classical
  obtain ⟨H, hHG, ⟨v₀, hv₀⟩, hdegree⟩ := hpart
  let K : SimpleGraph W := H.toSimple
  let S : Set W := {v | H.degree v = k}
  have hloop : ∀ v, H.mult v v = 0 :=
    loopless_of_isPart_ofSimple hHG
  have hsimple : ∀ u v, H.mult u v ≤ 1 :=
    mult_le_one_of_isPart_ofSimple hHG
  have hKG : K ≤ G := by
    intro u v huv
    have hpos : 0 < H.mult u v := (toSimple_adj H u v).mp huv |>.2
    have hle := hHG u v
    by_contra hnot
    simp [ofSimple_mult, hnot] at hle
    omega
  have hedge_support {u v : W} (huv : K.Adj u v) : u ∈ S ∧ v ∈ S := by
    have huv' := (toSimple_adj H u v).mp huv
    have hupos : 0 < H.degree u :=
      lt_of_lt_of_le huv'.2 (mult_le_degree_of_ne H huv'.1)
    have hvpos : 0 < H.degree v := by
      have hmult : 0 < H.mult v u := by simpa only [H.mult_comm] using huv'.2
      exact lt_of_lt_of_le hmult (mult_le_degree_of_ne H huv'.1.symm)
    constructor
    · change H.degree u = k
      exact (hdegree u).resolve_left (by omega)
    · change H.degree v = k
      exact (hdegree v).resolve_left (by omega)
  let L : G.Subgraph :=
    { verts := S
      Adj := K.Adj
      adj_sub := fun h ↦ hKG h
      edge_vert := fun h ↦ (hedge_support h).1
      symm := K.symm }
  refine ⟨L, ?_, ?_⟩
  · exact ⟨v₀, by change H.degree v₀ = k; exact hv₀⟩
  · intro v
    rw [← Set.fintypeCard_eq_ncard, SimpleGraph.card_neighborSet_eq_degree]
    change (K.induce S).degree v = k
    rw [K.degree_induce_of_neighborSet_subset]
    · rw [degree_toSimple H hloop hsimple]
      exact v.2
    · intro w hw
      exact (hedge_support hw).2

/-- Conversely, an honest regular subgraph gives a multiplicity-one regular
part.  This direction is used when the simple-graph barrier contradiction is
fed back into the pseudograph minimal-counterexample induction. -/
theorem containsRegularPart_of_containsRegularSubgraph
    (G : SimpleGraph W) {k : ℕ}
    (hpart : ContainsRegularSubgraph G k) :
    (ofSimple G).ContainsRegularPart k := by
  classical
  obtain ⟨H, hHne, hHdeg⟩ := hpart
  let P : Pseudograph W := ofSimple H.spanningCoe
  have hPG : P.IsPart (ofSimple G) := by
    intro u v
    simp only [P, ofSimple_mult]
    by_cases huv : H.spanningCoe.Adj u v
    · rw [if_pos huv, if_pos (H.spanningCoe_le huv)]
    · rw [if_neg huv]
      omega
  refine ⟨P, hPG, ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hHne
    refine ⟨v, ?_⟩
    change (ofSimple H.spanningCoe).degree v = k
    rw [degree_ofSimple, SimpleGraph.Subgraph.degree_spanningCoe]
    change H.degree v = k
    have hcoe : H.coe.degree ⟨v, hv⟩ = k := by
      rw [← SimpleGraph.card_neighborSet_eq_degree,
        Set.fintypeCard_eq_ncard]
      exact hHdeg ⟨v, hv⟩
    simpa using hcoe
  · intro v
    by_cases hv : v ∈ H.verts
    · right
      change (ofSimple H.spanningCoe).degree v = k
      rw [degree_ofSimple, SimpleGraph.Subgraph.degree_spanningCoe]
      change H.degree v = k
      have hcoe : H.coe.degree ⟨v, hv⟩ = k := by
        rw [← SimpleGraph.card_neighborSet_eq_degree,
          Set.fintypeCard_eq_ncard]
        exact hHdeg ⟨v, hv⟩
      simpa using hcoe
    · left
      change (ofSimple H.spanningCoe).degree v = 0
      rw [degree_ofSimple, SimpleGraph.Subgraph.degree_spanningCoe,
        H.degree_of_notMem_verts hv]

/-- The multiplicity-one pseudograph carried by a spanning simple
subgraph of the underlying graph of a pseudograph. -/
def ofUnderlyingSubgraph (G : Pseudograph W) (M : G.toSimple.Subgraph) :
    Pseudograph W :=
  ofSimple M.spanningCoe

lemma ofUnderlyingSubgraph_isPart (G : Pseudograph W)
    (M : G.toSimple.Subgraph) : (ofUnderlyingSubgraph G M).IsPart G := by
  intro u v
  simp only [ofUnderlyingSubgraph, ofSimple_mult]
  by_cases huv : M.spanningCoe.Adj u v
  · simp only [if_pos huv]
    have hbase : G.toSimple.Adj u v := M.spanningCoe_le huv
    exact Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hbase.2)
  · have hnot : ¬ M.Adj u v := by simpa using huv
    simp [hnot]

lemma degree_ofUnderlyingSubgraph_of_isPerfectMatching
    (G : Pseudograph W) (M : G.toSimple.Subgraph)
    (hM : M.IsPerfectMatching) (v : W) :
    (ofUnderlyingSubgraph G M).degree v = 1 := by
  rw [ofUnderlyingSubgraph, degree_ofSimple,
    SimpleGraph.Subgraph.degree_spanningCoe]
  exact (SimpleGraph.Subgraph.isPerfectMatching_iff_forall_degree.mp hM) v

/-- Removing a perfect matching of the underlying graph from a quartic
pseudograph removes one incident edge at every vertex, even in the presence
of parallel edges elsewhere. -/
theorem containsRegularPart_of_isPerfectMatching [Nonempty W]
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (M : G.toSimple.Subgraph) (hM : M.IsPerfectMatching) :
    G.ContainsRegularPart 3 := by
  let F := ofUnderlyingSubgraph G M
  have hFG : F.IsPart G := ofUnderlyingSubgraph_isPart G M
  let H := G.sdiff F
  refine ⟨H, G.sdiff_isPart_left F, ?_, ?_⟩
  · let v : W := Classical.choice inferInstance
    refine ⟨v, ?_⟩
    have hdeg := G.degree_sdiff_add F hFG v
    have hFdeg : F.degree v = 1 :=
      degree_ofUnderlyingSubgraph_of_isPerfectMatching G M hM v
    change H.degree v = 3
    change H.degree v + F.degree v = G.degree v at hdeg
    have hGdeg := hreg v
    omega
  · intro v
    right
    have hdeg := G.degree_sdiff_add F hFG v
    have hFdeg : F.degree v = 1 :=
      degree_ofUnderlyingSubgraph_of_isPerfectMatching G M hM v
    change H.degree v = 3
    change H.degree v + F.degree v = G.degree v at hdeg
    have hGdeg := hreg v
    omega

/-! ### Edge-incidence accounting -/

/-- Multiplicity as a function of an unordered endpoint pair. -/
def edgeMultiplicity (G : Pseudograph W) : Sym2 W → ℕ :=
  Sym2.lift ⟨G.mult, G.mult_comm⟩

@[simp]
lemma edgeMultiplicity_mk (G : Pseudograph W) (u v : W) :
    G.edgeMultiplicity s(u, v) = G.mult u v :=
  rfl

/-- The number (zero, one, or two) of ends of an edge lying in `S`. -/
def incidencesIn (S : Finset W) : Sym2 W → ℕ :=
  Sym2.lift ⟨fun u v ↦ (if u ∈ S then 1 else 0) + (if v ∈ S then 1 else 0), by
    intro u v
    exact Nat.add_comm _ _⟩

/-- Indicator that both ends of an edge lie in `S`. -/
def internalIndicator (S : Finset W) : Sym2 W → ℕ :=
  Sym2.lift ⟨fun u v ↦ if u ∈ S ∧ v ∈ S then 1 else 0, by
    intro u v
    by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;> simp [hu, hv]⟩

/-- Indicator that exactly one end of an edge lies in `S`. -/
def crossingIndicator (S : Finset W) : Sym2 W → ℕ :=
  Sym2.lift ⟨fun u v ↦
    if (u ∈ S ∧ v ∉ S) ∨ (u ∉ S ∧ v ∈ S) then 1 else 0, by
      intro u v
      by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;> simp [hu, hv]⟩

/-- Indicator that an unordered edge has one end in `S` and the other in
`T`.  It is used for the nine-block barrier-intersection ledgers. -/
def betweenIndicator (S T : Finset W) : Sym2 W → ℕ :=
  Sym2.lift ⟨fun u v ↦
    if (u ∈ S ∧ v ∈ T) ∨ (u ∈ T ∧ v ∈ S) then 1 else 0, by
      intro u v
      by_cases huS : u ∈ S <;> by_cases hvS : v ∈ S <;>
        by_cases huT : u ∈ T <;> by_cases hvT : v ∈ T <;>
        simp [huS, hvS, huT, hvT]⟩

@[simp]
lemma incidencesIn_mk (S : Finset W) (u v : W) :
    incidencesIn S s(u, v) =
      (if u ∈ S then 1 else 0) + (if v ∈ S then 1 else 0) :=
  rfl

@[simp]
lemma internalIndicator_mk (S : Finset W) (u v : W) :
    internalIndicator S s(u, v) = if u ∈ S ∧ v ∈ S then 1 else 0 :=
  rfl

@[simp]
lemma crossingIndicator_mk (S : Finset W) (u v : W) :
    crossingIndicator S s(u, v) =
      if (u ∈ S ∧ v ∉ S) ∨ (u ∉ S ∧ v ∈ S) then 1 else 0 :=
  rfl

@[simp]
lemma betweenIndicator_mk (S T : Finset W) (u v : W) :
    betweenIndicator S T s(u, v) =
      if (u ∈ S ∧ v ∈ T) ∨ (u ∈ T ∧ v ∈ S) then 1 else 0 :=
  rfl

lemma betweenIndicator_comm (S T : Finset W) :
    betweenIndicator S T = betweenIndicator T S := by
  funext e
  induction e using Sym2.inductionOn with
  | _ u v =>
      by_cases huS : u ∈ S <;> by_cases hvS : v ∈ S <;>
        by_cases huT : u ∈ T <;> by_cases hvT : v ∈ T <;>
        simp [huS, hvS, huT, hvT]

@[simp]
lemma betweenIndicator_empty_left (T : Finset W) :
    betweenIndicator (∅ : Finset W) T = 0 := by
  funext e
  induction e using Sym2.inductionOn with
  | _ u v => simp

@[simp]
lemma betweenIndicator_empty_right (S : Finset W) :
    betweenIndicator S (∅ : Finset W) = 0 := by
  rw [betweenIndicator_comm, betweenIndicator_empty_left]

@[simp]
lemma crossingIndicator_empty :
    crossingIndicator (∅ : Finset W) = 0 := by
  funext e
  induction e using Sym2.inductionOn with
  | _ u v => simp

/-- Each internal edge contributes two incidences and each cut edge one. -/
lemma incidencesIn_eq_two_internal_add_crossing (S : Finset W) (e : Sym2 W) :
    incidencesIn S e = 2 * internalIndicator S e + crossingIndicator S e := by
  induction e using Sym2.inductionOn with
  | _ u v =>
      by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;> simp [hu, hv]

/-- Edge multiplicity internal to a shore.  A loop is counted once. -/
def internalMultiplicity (G : Pseudograph W) (S : Finset W) : ℕ :=
  ∑ e : Sym2 W, G.edgeMultiplicity e * internalIndicator S e

/-- Edge multiplicity across a shore. -/
def boundaryMultiplicity (G : Pseudograph W) (S : Finset W) : ℕ :=
  ∑ e : Sym2 W, G.edgeMultiplicity e * crossingIndicator S e

/-- Edge multiplicity between two vertex blocks. -/
def betweenMultiplicity (G : Pseudograph W) (S T : Finset W) : ℕ :=
  ∑ e : Sym2 W, G.edgeMultiplicity e * betweenIndicator S T e

@[simp]
lemma boundaryMultiplicity_empty (G : Pseudograph W) :
    G.boundaryMultiplicity ∅ = 0 := by
  simp [boundaryMultiplicity]

lemma betweenMultiplicity_comm (G : Pseudograph W) (S T : Finset W) :
    G.betweenMultiplicity S T = G.betweenMultiplicity T S := by
  unfold betweenMultiplicity
  rw [betweenIndicator_comm]

@[simp]
lemma betweenMultiplicity_empty_left (G : Pseudograph W) (T : Finset W) :
    G.betweenMultiplicity ∅ T = 0 := by
  simp [betweenMultiplicity]

@[simp]
lemma betweenMultiplicity_empty_right (G : Pseudograph W) (S : Finset W) :
    G.betweenMultiplicity S ∅ = 0 := by
  rw [G.betweenMultiplicity_comm, G.betweenMultiplicity_empty_left]

/-- Between-block multiplicity is additive in a disjoint union, provided
the opposite block is disjoint from both summands.  The disjointness
hypotheses ensure that an edge cannot be counted in both summands. -/
lemma betweenMultiplicity_union_left (G : Pseudograph W)
    (A B C : Finset W) (hAB : Disjoint A B) (hABC : Disjoint (A ∪ B) C) :
    G.betweenMultiplicity (A ∪ B) C =
      G.betweenMultiplicity A C + G.betweenMultiplicity B C := by
  classical
  unfold betweenMultiplicity
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  induction e using Sym2.inductionOn with
  | _ u v =>
      have hAB' : ∀ x, x ∈ A → x ∈ B → False :=
        Finset.disjoint_left.mp hAB
      have hAC' : ∀ x, x ∈ A → x ∈ C → False := by
        intro x hxA hxC
        exact (Finset.disjoint_left.mp hABC) (Finset.mem_union_left _ hxA) hxC
      have hBC' : ∀ x, x ∈ B → x ∈ C → False := by
        intro x hxB hxC
        exact (Finset.disjoint_left.mp hABC) (Finset.mem_union_right _ hxB) hxC
      simp only [edgeMultiplicity_mk, betweenIndicator_mk]
      by_cases huA : u ∈ A <;> by_cases hvA : v ∈ A <;>
        by_cases huB : u ∈ B <;> by_cases hvB : v ∈ B <;>
        by_cases huC : u ∈ C <;> by_cases hvC : v ∈ C
      all_goals simp [huA, hvA, huB, hvB, huC, hvC]
      all_goals exfalso
      all_goals first
        | exact hAB' u huA huB
        | exact hAB' v hvA hvB
        | exact hAC' u huA huC
        | exact hAC' v hvA hvC
        | exact hBC' u huB huC
        | exact hBC' v hvB hvC

/-- Additivity in the right block, obtained by symmetry. -/
lemma betweenMultiplicity_union_right (G : Pseudograph W)
    (A B C : Finset W) (hBC : Disjoint B C) (hABC : Disjoint A (B ∪ C)) :
    G.betweenMultiplicity A (B ∪ C) =
      G.betweenMultiplicity A B + G.betweenMultiplicity A C := by
  rw [betweenMultiplicity_comm G A (B ∪ C),
    betweenMultiplicity_union_left G B C A hBC hABC.symm,
    betweenMultiplicity_comm G B A, betweenMultiplicity_comm G C A]

/-- Decompose a between-block count as the sum of its contributions from
the individual vertices of the left block. -/
lemma betweenMultiplicity_eq_sum_singleton_left (G : Pseudograph W)
    (S T : Finset W) (hST : Disjoint S T) :
    G.betweenMultiplicity S T =
      ∑ x ∈ S, G.betweenMultiplicity {x} T := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | @insert x S hx ih =>
      have hxT : x ∉ T := by
        intro hxt
        exact (Finset.disjoint_left.mp hST) (by simp) hxt
      have hST' : Disjoint S T := by
        exact Disjoint.mono (by simp) (by rfl) hST
      have hsingleS : Disjoint ({x} : Finset W) S := by simp [hx]
      have hunionT : Disjoint (({x} : Finset W) ∪ S) T := by
        exact Finset.disjoint_union_left.mpr ⟨by simp [hxT], hST'⟩
      have hsplit := G.betweenMultiplicity_union_left
        ({x} : Finset W) S T hsingleS hunionT
      calc
        G.betweenMultiplicity (insert x S) T =
            G.betweenMultiplicity (({x} : Finset W) ∪ S) T := by simp
        _ = G.betweenMultiplicity {x} T + G.betweenMultiplicity S T := hsplit
        _ = G.betweenMultiplicity {x} T +
            ∑ y ∈ S, G.betweenMultiplicity {y} T := by rw [ih hST']
        _ = ∑ y ∈ insert x S, G.betweenMultiplicity {y} T := by
          simp [hx]

/-- Expanding an edge count across two three-block partitions. -/
lemma betweenMultiplicity_three_by_three (G : Pseudograph W)
    (A₁ A₂ A₃ B₁ B₂ B₃ : Finset W)
    (hA₁₂ : Disjoint A₁ A₂) (hA₁₂₃ : Disjoint (A₁ ∪ A₂) A₃)
    (hB₁₂ : Disjoint B₁ B₂) (hB₁₂₃ : Disjoint (B₁ ∪ B₂) B₃)
    (hAB : Disjoint ((A₁ ∪ A₂) ∪ A₃) ((B₁ ∪ B₂) ∪ B₃)) :
    G.betweenMultiplicity ((A₁ ∪ A₂) ∪ A₃) ((B₁ ∪ B₂) ∪ B₃) =
      G.betweenMultiplicity A₁ B₁ + G.betweenMultiplicity A₁ B₂ +
      G.betweenMultiplicity A₁ B₃ + G.betweenMultiplicity A₂ B₁ +
      G.betweenMultiplicity A₂ B₂ + G.betweenMultiplicity A₂ B₃ +
      G.betweenMultiplicity A₃ B₁ + G.betweenMultiplicity A₃ B₂ +
      G.betweenMultiplicity A₃ B₃ := by
  classical
  let A := (A₁ ∪ A₂) ∪ A₃
  let B := (B₁ ∪ B₂) ∪ B₃
  have hA₁₂_le : A₁ ∪ A₂ ⊆ A := by
    exact Finset.subset_union_left
  have hA₁_le : A₁ ⊆ A :=
    Finset.Subset.trans Finset.subset_union_left hA₁₂_le
  have hA₂_le : A₂ ⊆ A :=
    Finset.Subset.trans Finset.subset_union_right hA₁₂_le
  have hA₃_le : A₃ ⊆ A := Finset.subset_union_right
  have hB₁₂_le : B₁ ∪ B₂ ⊆ B := Finset.subset_union_left
  have hB₁_le : B₁ ⊆ B :=
    Finset.Subset.trans Finset.subset_union_left hB₁₂_le
  have hB₂_le : B₂ ⊆ B :=
    Finset.Subset.trans Finset.subset_union_right hB₁₂_le
  have hB₃_le : B₃ ⊆ B := Finset.subset_union_right
  have hA₁₂B : Disjoint (A₁ ∪ A₂) B :=
    Disjoint.mono hA₁₂_le (by rfl) (by simpa [A, B] using hAB)
  have hA₁B : Disjoint A₁ B :=
    Disjoint.mono hA₁_le (by rfl) (by simpa [A, B] using hAB)
  have hA₂B : Disjoint A₂ B :=
    Disjoint.mono hA₂_le (by rfl) (by simpa [A, B] using hAB)
  have hA₃B : Disjoint A₃ B :=
    Disjoint.mono hA₃_le (by rfl) (by simpa [A, B] using hAB)
  have hA₁B₁₂ : Disjoint A₁ (B₁ ∪ B₂) :=
    Disjoint.mono (by rfl) hB₁₂_le hA₁B
  have hA₂B₁₂ : Disjoint A₂ (B₁ ∪ B₂) :=
    Disjoint.mono (by rfl) hB₁₂_le hA₂B
  have hA₃B₁₂ : Disjoint A₃ (B₁ ∪ B₂) :=
    Disjoint.mono (by rfl) hB₁₂_le hA₃B
  change G.betweenMultiplicity A B = _
  rw [betweenMultiplicity_union_left G (A₁ ∪ A₂) A₃ B hA₁₂₃ hAB,
    betweenMultiplicity_union_left G A₁ A₂ B hA₁₂ hA₁₂B,
    betweenMultiplicity_union_right G A₁ (B₁ ∪ B₂) B₃ hB₁₂₃ hA₁B,
    betweenMultiplicity_union_right G A₁ B₁ B₂ hB₁₂ hA₁B₁₂,
    betweenMultiplicity_union_right G A₂ (B₁ ∪ B₂) B₃ hB₁₂₃ hA₂B,
    betweenMultiplicity_union_right G A₂ B₁ B₂ hB₁₂ hA₂B₁₂,
    betweenMultiplicity_union_right G A₃ (B₁ ∪ B₂) B₃ hB₁₂₃ hA₃B,
    betweenMultiplicity_union_right G A₃ B₁ B₂ hB₁₂ hA₃B₁₂]
  omega

/-- Total number of incidences whose vertex end lies in `S`. -/
def incidenceSum (G : Pseudograph W) (S : Finset W) : ℕ :=
  ∑ e : Sym2 W, G.edgeMultiplicity e * incidencesIn S e

/-- The basic shore identity, before specializing the incidence sum using
regularity: `incidences = 2 * internal edges + boundary edges`. -/
lemma incidenceSum_eq (G : Pseudograph W) (S : Finset W) :
    G.incidenceSum S = 2 * G.internalMultiplicity S + G.boundaryMultiplicity S := by
  classical
  unfold incidenceSum internalMultiplicity boundaryMultiplicity
  simp_rw [incidencesIn_eq_two_internal_add_crossing]
  calc
    ∑ x : Sym2 W,
        G.edgeMultiplicity x *
          (2 * internalIndicator S x + crossingIndicator S x) =
        ∑ x : Sym2 W,
          (2 * (G.edgeMultiplicity x * internalIndicator S x) +
            G.edgeMultiplicity x * crossingIndicator S x) := by
      apply Finset.sum_congr rfl
      intro e _
      ring
    _ = 2 * ∑ e : Sym2 W, G.edgeMultiplicity e * internalIndicator S e +
        ∑ e : Sym2 W, G.edgeMultiplicity e * crossingIndicator S e := by
      rw [Finset.sum_add_distrib, Finset.mul_sum]

/-- Unordered pairs incident with `v` are parametrized by their other end.
The other end is allowed to equal `v`, which represents a loop. -/
def incidentEdgeEquiv (v : W) : W ≃ {e : Sym2 W // v ∈ e} where
  toFun w := ⟨s(v, w), Sym2.mem_mk_left _ _⟩
  invFun e := Sym2.Mem.other e.2
  left_inv w := by
    apply Sym2.congr_right.mp
    exact Sym2.other_spec (Sym2.mem_mk_left v w)
  right_inv e := by
    apply Subtype.ext
    exact Sym2.other_spec e.2

/-- Between-block multiplicity from a singleton is the sum of the edge
multiplicities to the other block. -/
lemma betweenMultiplicity_singleton (G : Pseudograph W) (v : W)
    (T : Finset W) (hvT : v ∉ T) :
    G.betweenMultiplicity {v} T = ∑ w ∈ T, G.mult v w := by
  classical
  let incident : Finset (Sym2 W) :=
    Finset.univ.filter fun e ↦ v ∈ e
  calc
    G.betweenMultiplicity {v} T =
        ∑ e ∈ incident,
          G.edgeMultiplicity e * betweenIndicator {v} T e := by
      unfold betweenMultiplicity
      symm
      apply Finset.sum_subset (by simp [incident])
      intro e _ he
      have hnot : v ∉ e := by simpa [incident] using he
      have hi : betweenIndicator {v} T e = 0 := by
        induction e using Sym2.inductionOn with
        | _ u w => simp_all [Sym2.mem_iff, betweenIndicator, eq_comm]
      simp [hi]
    _ = ∑ w : W, G.mult v w * (if w ∈ T then 1 else 0) := by
      have hfilter :
          (∑ e ∈ incident,
              G.edgeMultiplicity e * betweenIndicator {v} T e) =
            ∑ e : {e : Sym2 W // v ∈ e},
              G.edgeMultiplicity e.1 * betweenIndicator {v} T e.1 := by
        change (∑ e ∈ (Finset.univ.filter fun e : Sym2 W ↦ v ∈ e),
            G.edgeMultiplicity e * betweenIndicator {v} T e) = _
        rw [← Finset.sum_subtype_eq_sum_filter]
        simp
      rw [hfilter]
      exact (Fintype.sum_equiv (incidentEdgeEquiv v)
        (fun w ↦ G.mult v w * (if w ∈ T then 1 else 0))
        (fun e ↦ G.edgeMultiplicity e.1 * betweenIndicator {v} T e.1)
        (fun w ↦ by
          by_cases hwv : w = v <;> by_cases hwT : w ∈ T <;>
            simp [incidentEdgeEquiv, hwv, hwT, hvT, eq_comm])).symm
    _ = ∑ w : W, if w ∈ T then G.mult v w else 0 := by
      apply Finset.sum_congr rfl
      intro w _
      by_cases hw : w ∈ T <;> simp [hw]
    _ = ∑ w ∈ T, G.mult v w := by simp

/-- For a simple graph, the preceding singleton count is literally the
number of neighbours lying in the target block. -/
lemma betweenMultiplicity_singleton_ofSimple (G : SimpleGraph W) (v : W)
    (T : Finset W) (hvT : v ∉ T) :
    (ofSimple G).betweenMultiplicity {v} T =
      (T.filter (G.Adj v)).card := by
  rw [(ofSimple G).betweenMultiplicity_singleton v T hvT]
  simp [ofSimple_mult]

/-- The incidence definition agrees with the original multiplicity-matrix
degree at a singleton shore. -/
lemma incidenceSum_singleton (G : Pseudograph W) (v : W) :
    G.incidenceSum {v} = G.degree v := by
  classical
  unfold incidenceSum degree
  let incident : Finset (Sym2 W) :=
    Finset.univ.filter fun e ↦ v ∈ e
  calc
    ∑ e : Sym2 W, G.edgeMultiplicity e * incidencesIn {v} e =
        ∑ e ∈ incident, G.edgeMultiplicity e * incidencesIn {v} e := by
          symm
          apply Finset.sum_subset (by simp [incident])
          intro e _ he
          have hnot : v ∉ e := by simpa [incident] using he
          have hi : incidencesIn {v} e = 0 := by
            induction e using Sym2.inductionOn with
            | _ u w => simp_all [Sym2.mem_iff, incidencesIn, eq_comm]
          simp [hi]
    _ = ∑ w : W, G.mult v w * (if w = v then 2 else 1) := by
          have hfilter :
              (∑ e ∈ incident, G.edgeMultiplicity e * incidencesIn {v} e) =
                ∑ e : {e : Sym2 W // v ∈ e},
                  G.edgeMultiplicity e.1 * incidencesIn {v} e.1 := by
            change (∑ e ∈ (Finset.univ.filter fun e : Sym2 W ↦ v ∈ e),
                G.edgeMultiplicity e * incidencesIn {v} e) = _
            rw [← Finset.sum_subtype_eq_sum_filter]
            simp
          rw [hfilter]
          exact (Fintype.sum_equiv (incidentEdgeEquiv v)
            (fun w ↦ G.mult v w * (if w = v then 2 else 1))
            (fun e ↦ G.edgeMultiplicity e.1 * incidencesIn {v} e.1)
            (fun w ↦ by
              by_cases hwv : w = v <;> simp [incidentEdgeEquiv, hwv, eq_comm])).symm
    _ = 2 * G.mult v v + ∑ w ∈ Finset.univ.erase v, G.mult v w := by
          have herase :
              (∑ w ∈ Finset.univ.erase v,
                G.mult v w * (if w = v then 2 else 1)) =
                ∑ w ∈ Finset.univ.erase v, G.mult v w := by
            apply Finset.sum_congr rfl
            intro w hw
            have hwv : w ≠ v := (Finset.mem_erase.mp hw).1
            simp [hwv]
          rw [← Finset.sum_erase_add _ _ (Finset.mem_univ v), herase]
          simp
          omega

/-- Sum of vertex degrees over a shore equals its incidence sum. -/
lemma sum_degree_eq_incidenceSum (G : Pseudograph W) (S : Finset W) :
    ∑ v ∈ S, G.degree v = G.incidenceSum S := by
  classical
  rw [show (∑ v ∈ S, G.degree v) = ∑ v ∈ S, G.incidenceSum {v} by
    apply Finset.sum_congr rfl
    intro v _
    exact (incidenceSum_singleton G v).symm]
  unfold incidenceSum
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e _
  rw [← Finset.mul_sum]
  congr 1
  induction e using Sym2.inductionOn with
  | _ u v =>
      by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;>
        simp only [incidencesIn_mk, Finset.mem_singleton,
          Finset.sum_add_distrib, Finset.sum_ite_eq]
      all_goals simp [hu, hv]

/-- The pseudograph degree-sum/cut identity used throughout the proof. -/
lemma sum_degree_eq_two_internal_add_boundary (G : Pseudograph W) (S : Finset W) :
    ∑ v ∈ S, G.degree v =
      2 * G.internalMultiplicity S + G.boundaryMultiplicity S := by
  rw [sum_degree_eq_incidenceSum, incidenceSum_eq]

/-- Degree-sum/cut identity specialized to an `r`-regular pseudograph. -/
lemma regular_card_eq_two_internal_add_boundary (G : Pseudograph W)
    {r : ℕ} (hreg : G.IsRegularOfDegree r) (S : Finset W) :
    r * S.card = 2 * G.internalMultiplicity S + G.boundaryMultiplicity S := by
  rw [← sum_degree_eq_two_internal_add_boundary]
  symm
  calc
    ∑ v ∈ S, G.degree v = ∑ _v ∈ S, r := by
      apply Finset.sum_congr rfl
      intro v _
      exact hreg v
    _ = r * S.card := by simp [Nat.mul_comm]

/-- Every cut of an even-regular pseudograph has even total multiplicity
(Tashkinov's Proposition 2.2). -/
lemma boundaryMultiplicity_even_of_even_regular (G : Pseudograph W)
    {r : ℕ} (hreg : G.IsRegularOfDegree (2 * r)) (S : Finset W) :
    Even (G.boundaryMultiplicity S) := by
  have h := regular_card_eq_two_internal_add_boundary G hreg S
  rw [Nat.even_iff]
  have hmod := congrArg (fun n : ℕ ↦ n % 2) h
  symm
  simpa [Nat.add_mod, Nat.mul_mod] using hmod

/-- Replacing a shore by its complement does not change its edge boundary. -/
lemma boundaryMultiplicity_compl (G : Pseudograph W) (S : Finset W) :
    G.boundaryMultiplicity Sᶜ = G.boundaryMultiplicity S := by
  classical
  unfold boundaryMultiplicity
  apply Finset.sum_congr rfl
  intro e _
  congr 1
  induction e using Sym2.inductionOn with
  | _ u v =>
      by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;>
        simp [crossingIndicator, hu, hv]

/-- Splitting the complementary shore into two disjoint blocks splits the
boundary multiplicity into the two corresponding between-block counts. -/
lemma boundaryMultiplicity_eq_between_add_between
    (G : Pseudograph W) (S T R : Finset W)
    (hdisj : Disjoint T R) (hcover : T ∪ R = Sᶜ) :
    G.boundaryMultiplicity S =
      G.betweenMultiplicity S T + G.betweenMultiplicity S R := by
  classical
  unfold boundaryMultiplicity betweenMultiplicity
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  congr 1
  induction e using Sym2.inductionOn with
  | _ a b =>
      have ha : a ∉ S ↔ a ∈ T ∨ a ∈ R := by
        have := Finset.ext_iff.mp hcover a
        simpa using this.symm
      have hb : b ∉ S ↔ b ∈ T ∨ b ∈ R := by
        have := Finset.ext_iff.mp hcover b
        simpa using this.symm
      have hTRa : ¬ (a ∈ T ∧ a ∈ R) := by
        exact fun h ↦ (Finset.disjoint_left.mp hdisj) h.1 h.2
      have hTRb : ¬ (b ∈ T ∧ b ∈ R) := by
        exact fun h ↦ (Finset.disjoint_left.mp hdisj) h.1 h.2
      by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T <;>
        by_cases haR : a ∈ R <;> by_cases hbR : b ∈ R <;>
        simp [crossingIndicator_mk, betweenIndicator_mk, haS, hbS,
          haT, hbT, haR, hbR] at *

/-- The labelled crossing incidences of a shore are counted by its boundary
multiplicity.  The label remembers which copy of a parallel edge is used. -/
lemma card_crossingEdge (G : Pseudograph W) (S : Finset W) :
    Fintype.card (CrossingEdge G S) = G.boundaryMultiplicity S := by
  classical
  rw [Fintype.card_congr (crossingEdgeEquivSigmaAt G S), Fintype.card_sigma]
  have hcards :
      (∑ v : S, Fintype.card (CrossingAt G S v)) =
        ∑ v : S, G.outsideDegree S v := by
    apply Finset.sum_congr rfl
    intro v _
    exact card_crossingAt G S v v.2
  rw [hcards]
  simp only [Finset.univ_eq_attach, Finset.sum_attach]
  have hboundary := G.boundaryMultiplicity_eq_between_add_between
    S Sᶜ ∅ (by simp) (by simp)
  simp only [G.betweenMultiplicity_empty_right, Nat.add_zero] at hboundary
  have hdisj : Disjoint S Sᶜ := by
    rw [Finset.disjoint_left]
    intro v hvS hvC
    exact (Finset.mem_compl.mp hvC) hvS
  rw [hboundary, G.betweenMultiplicity_eq_sum_singleton_left S Sᶜ hdisj]
  apply Finset.sum_congr rfl
  intro v hv
  rw [G.betweenMultiplicity_singleton v Sᶜ (by simpa using hv)]
  rfl

/-- Canonical labelled enumeration of a cut with prescribed multiplicity. -/
noncomputable def cutEquiv (G : Pseudograph W) (S : Finset W) {n : ℕ}
    (hcut : G.boundaryMultiplicity S = n) :
    CrossingEdge G S ≃ Fin n :=
  Fintype.equivFinOfCardEq ((card_crossingEdge G S).trans hcut)

/-- The `i`-th labelled crossing edge of an `n`-cut. -/
noncomputable def cutEdge (G : Pseudograph W) (S : Finset W) {n : ℕ}
    (hcut : G.boundaryMultiplicity S = n) (i : Fin n) : CrossingEdge G S :=
  (cutEquiv G S hcut).symm i

noncomputable def crossingAtEquivCutFiber (G : Pseudograph W)
    (S : Finset W) {n : ℕ} (hcut : G.boundaryMultiplicity S = n) (v : W) :
    CrossingAt G S v ≃ {i : Fin n // (cutEdge G S hcut i).inside = v} :=
  Equiv.subtypeEquiv (cutEquiv G S hcut) (by
    intro e
    simp only [cutEdge, Equiv.symm_apply_apply])

/-- General labelled endpoint count for a finite cut. -/
lemma outsideDegree_eq_cutEndpointSum (G : Pseudograph W)
    (S : Finset W) {n : ℕ} (hcut : G.boundaryMultiplicity S = n)
    (v : W) (hv : v ∈ S) :
    G.outsideDegree S v =
      ∑ i : Fin n, if (cutEdge G S hcut i).inside = v then 1 else 0 := by
  classical
  rw [← card_crossingAt G S v hv,
    Fintype.card_congr (crossingAtEquivCutFiber G S hcut v),
    Fintype.card_subtype, Finset.card_filter]

/-- Reverse the orientation of a labelled crossing edge. -/
def reverseCrossingEdge (G : Pseudograph W) (S : Finset W)
    (e : CrossingEdge G S) : CrossingEdge G Sᶜ where
  inside := e.outside
  outside := e.inside
  inside_mem := Finset.mem_compl.mpr e.outside_notMem
  outside_notMem := by simpa using e.inside_mem
  index := Fin.cast (G.mult_comm e.inside e.outside) e.index

/-- Reverse an edge already oriented out of the complementary shore.  This is
stated separately so that its result has exactly shore `S`, rather than a
definitionally awkward double complement. -/
def reverseCrossingEdgeBack (G : Pseudograph W) (S : Finset W)
    (e : CrossingEdge G Sᶜ) : CrossingEdge G S where
  inside := e.outside
  outside := e.inside
  inside_mem := by simpa using e.outside_notMem
  outside_notMem := Finset.mem_compl.mp e.inside_mem
  index := Fin.cast (G.mult_comm e.inside e.outside) e.index

lemma reverseCrossingEdge_leftInverse (G : Pseudograph W) (S : Finset W)
    (e : CrossingEdge G S) :
    reverseCrossingEdgeBack G S (reverseCrossingEdge G S e) = e := by
  apply CrossingEdge.ext <;> simp [reverseCrossingEdgeBack, reverseCrossingEdge]

lemma reverseCrossingEdge_rightInverse (G : Pseudograph W) (S : Finset W)
    (e : CrossingEdge G Sᶜ) :
    reverseCrossingEdge G S (reverseCrossingEdgeBack G S e) = e := by
  apply CrossingEdge.ext <;> simp [reverseCrossingEdgeBack, reverseCrossingEdge]

/-- Reversing gives the canonical bijection between the two orientations of
the same cut, retaining the parallel-copy label. -/
def reverseCrossingEdgeEquiv (G : Pseudograph W) (S : Finset W) :
  CrossingEdge G S ≃ CrossingEdge G Sᶜ where
  toFun := reverseCrossingEdge G S
  invFun := reverseCrossingEdgeBack G S
  left_inv := reverseCrossingEdge_leftInverse G S
  right_inv := reverseCrossingEdge_rightInverse G S

/-- Number of entries of a labelled cut listing whose shore endpoint is
`v`. -/
def listingEndpointCount {n : ℕ} (G : Pseudograph W) (S : Finset W)
    (E : Fin n ≃ CrossingEdge G S) (v : W) : ℕ :=
  ∑ i : Fin n, if (E i).inside = v then 1 else 0

noncomputable def crossingAtEquivListingFiber {n : ℕ}
    (G : Pseudograph W) (S : Finset W)
    (E : Fin n ≃ CrossingEdge G S) (v : W) :
    CrossingAt G S v ≃ {i : Fin n // (E i).inside = v} :=
  Equiv.subtypeEquiv E.symm (by
    intro e
    simp)

/-- Any bijective listing counts the outside incidences at a shore vertex. -/
lemma outsideDegree_eq_listingEndpointCount {n : ℕ}
    (G : Pseudograph W) (S : Finset W)
    (E : Fin n ≃ CrossingEdge G S) (v : W) (hv : v ∈ S) :
    G.outsideDegree S v = G.listingEndpointCount S E v := by
  classical
  rw [← card_crossingAt G S v hv,
    Fintype.card_congr (crossingAtEquivListingFiber G S E v),
    Fintype.card_subtype, Finset.card_filter]
  rfl

/-- Summing endpoint multiplicities over the shore counts every entry of the
listing once. -/
lemma sum_listingEndpointCount {n : ℕ} (G : Pseudograph W)
    (S : Finset W) (E : Fin n ≃ CrossingEdge G S) :
    (∑ v : S, G.listingEndpointCount S E v) = n := by
  classical
  simp only [listingEndpointCount]
  rw [Finset.sum_comm]
  have hone (i : Fin n) :
      (∑ x : S, if (E i).inside = (x : W) then 1 else 0) = 1 := by
    let y : S := ⟨(E i).inside, (E i).inside_mem⟩
    calc
      (∑ x : S, if (E i).inside = (x : W) then 1 else 0) =
          ∑ x : S, if y = x then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro x _
            by_cases hxy : y = x
            · have heq : (E i).inside = (x : W) := by
                simpa [y] using congrArg Subtype.val hxy
              rw [if_pos heq, if_pos hxy]
            · have hne : (E i).inside ≠ (x : W) := by
                intro heq
                apply hxy
                apply Subtype.ext
                simpa [y] using heq
              rw [if_neg hne, if_neg hxy]
      _ = 1 := by simp
  simp only [hone, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, mul_one]
  exact Fintype.card_fin n

/-- Close a four-edge shore by a new central vertex incident with all four
listed cut edges.  Repeated endpoints become parallel star edges. -/
def closeFourCutStarWith (G : Pseudograph W) (S : Finset W)
    (E : Fin 4 ≃ CrossingEdge G S) : Pseudograph (Option S) where
  mult u v := match u, v with
    | none, none => 0
    | some x, some y => G.mult x y
    | none, some y => G.listingEndpointCount S E y
    | some x, none => G.listingEndpointCount S E x
  mult_comm u v := by
    cases u <;> cases v <;> simp only
    exact G.mult_comm _ _

@[simp]
lemma closeFourCutStarWith_mult_none_none (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) :
    (G.closeFourCutStarWith S E).mult none none = 0 :=
  rfl

@[simp]
lemma closeFourCutStarWith_mult_some_some (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) (u v : S) :
    (G.closeFourCutStarWith S E).mult (some u) (some v) = G.mult u v :=
  rfl

@[simp]
lemma closeFourCutStarWith_mult_none_some (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) (v : S) :
    (G.closeFourCutStarWith S E).mult none (some v) =
      G.listingEndpointCount S E v :=
  rfl

@[simp]
lemma closeFourCutStarWith_mult_some_none (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) (v : S) :
    (G.closeFourCutStarWith S E).mult (some v) none =
      G.listingEndpointCount S E v :=
  rfl

/-- The new star center has degree four. -/
lemma degree_closeFourCutStarWith_none (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) :
    (G.closeFourCutStarWith S E).degree none = 4 := by
  classical
  rw [degree_eq_mult_self_add_sum]
  simp only [closeFourCutStarWith_mult_none_none, Nat.zero_add,
    Fintype.sum_option, listingEndpointCount,
    closeFourCutStarWith_mult_none_some]
  have hone (i : Fin 4) :
      (∑ x : S, if (E i).inside = (x : W) then 1 else 0) = 1 := by
    let y : S := ⟨(E i).inside, (E i).inside_mem⟩
    calc
      (∑ x : S, if (E i).inside = (x : W) then 1 else 0) =
          ∑ x : S, if y = x then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro x _
            by_cases h : y = x
            · have h' : (E i).inside = (x : W) := by
                simpa [y] using congrArg Subtype.val h
              rw [if_pos h', if_pos h]
            · have h' : (E i).inside ≠ (x : W) := by
                intro h'
                apply h
                apply Subtype.ext
                simpa [y] using h'
              rw [if_neg h', if_neg h]
      _ = 1 := by simp
  rw [Finset.sum_comm]
  simp only [hone, Fin.sum_univ_four]

/-- At an old shore vertex, the star closure restores exactly the incidences
lost by restriction. -/
lemma degree_closeFourCutStarWith_some (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S)
    (v : S) :
    (G.closeFourCutStarWith S E).degree (some v) =
      (G.induce S).degree v + G.outsideDegree S v := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  simp only [closeFourCutStarWith_mult_some_some,
    Fintype.sum_option, closeFourCutStarWith_mult_some_none]
  rw [G.outsideDegree_eq_listingEndpointCount S E v v.2]
  simp only [Finset.univ_eq_attach, Finset.sum_attach, induce_mult]
  omega

/-- A star closure of a four-cut in a regular pseudograph is again quartic. -/
lemma closeFourCutStarWith_isRegularOfDegree (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S)
    (hreg : G.IsRegularOfDegree 4) :
    (G.closeFourCutStarWith S E).IsRegularOfDegree 4 := by
  intro v
  cases v with
  | none => exact degree_closeFourCutStarWith_none G S E
  | some v =>
      rw [degree_closeFourCutStarWith_some]
      exact G.degree_induce_add_outsideDegree S v v.2 |>.trans (hreg v)

/-- Delete the artificial center of a star-closure part. -/
def dropStarCenter {S : Finset W} (H : Pseudograph (Option S)) :
    Pseudograph S where
  mult u v := H.mult (some u) (some v)
  mult_comm u v := H.mult_comm _ _

@[simp]
lemma dropStarCenter_mult {S : Finset W} (H : Pseudograph (Option S))
    (u v : S) :
    H.dropStarCenter.mult u v = H.mult (some u) (some v) :=
  rfl

/-- The degree lost when the star center is deleted is precisely the number
of selected artificial star edges at that vertex. -/
lemma degree_dropStarCenter_add {S : Finset W}
    (H : Pseudograph (Option S)) (v : S) :
    H.dropStarCenter.degree v + H.mult (some v) none = H.degree (some v) := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  simp only [dropStarCenter_mult, Fintype.sum_option]
  omega

lemma dropStarCenter_isPart {G : Pseudograph W} {S : Finset W}
    {E : Fin 4 ≃ CrossingEdge G S} {H : Pseudograph (Option S)}
    (hH : H.IsPart (G.closeFourCutStarWith S E)) :
    H.dropStarCenter.IsPart (G.induce S) := by
  intro u v
  exact hH (some u) (some v)

lemma starEdgeMultiplicity_le {G : Pseudograph W} {S : Finset W}
    {E : Fin 4 ≃ CrossingEdge G S} {H : Pseudograph (Option S)}
    (hH : H.IsPart (G.closeFourCutStarWith S E)) (v : S) :
    H.mult none (some v) ≤ G.listingEndpointCount S E v := by
  exact hH none (some v)

lemma starCenter_loop_eq_zero {G : Pseudograph W} {S : Finset W}
    {E : Fin 4 ≃ CrossingEdge G S} {H : Pseudograph (Option S)}
    (hH : H.IsPart (G.closeFourCutStarWith S E)) :
    H.mult none none = 0 := by
  have h := hH none none
  simpa using h

/-- Exact matrix form of saying that the cubic star part omits the labelled
cut edge `i` and uses all other three labelled cut edges. -/
def StarOmitsExactly {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (H : Pseudograph (Option S))
    (i : Fin 4) : Prop :=
  ∀ v : S, H.mult none (some v) =
    G.listingEndpointCount S E v -
      if (E i).inside = (v : W) then 1 else 0

/-- A cubic part which contains the star center uses three of the four
labelled star edges and therefore omits exactly one cut-edge label. -/
lemma exists_starOmitsExactly_of_center_degree_three
    {G : Pseudograph W} {S : Finset W}
    {E : Fin 4 ≃ CrossingEdge G S} {H : Pseudograph (Option S)}
    (hH : H.IsPart (G.closeFourCutStarWith S E))
    (hcenter : H.degree none = 3) :
    ∃ i : Fin 4, StarOmitsExactly E H i := by
  classical
  have hloop : H.mult none none = 0 := starCenter_loop_eq_zero hH
  have hsumH : (∑ v : S, H.mult none (some v)) = 3 := by
    simpa [degree_eq_mult_self_add_sum, Fintype.sum_option, hloop]
      using hcenter
  have hsumC : (∑ v : S, G.listingEndpointCount S E v) = 4 :=
    sum_listingEndpointCount G S E
  have hle (v : S) :
      H.mult none (some v) ≤ G.listingEndpointCount S E v :=
    starEdgeMultiplicity_le hH v
  obtain ⟨v, hvlt⟩ : ∃ v : S,
      H.mult none (some v) < G.listingEndpointCount S E v := by
    by_contra h
    push_neg at h
    have heq : ∀ v : S,
        H.mult none (some v) = G.listingEndpointCount S E v := by
      intro v
      exact Nat.le_antisymm (hle v) (h v)
    have hsumeq : (∑ v : S, H.mult none (some v)) =
        ∑ v : S, G.listingEndpointCount S E v := by
      apply Finset.sum_congr rfl
      intro v _
      exact heq v
    omega
  have hcountpos : 0 < G.listingEndpointCount S E v :=
    lt_of_le_of_lt (Nat.zero_le _) hvlt
  have hsumpos : 0 <
      ∑ i : Fin 4, if (E i).inside = (v : W) then 1 else 0 := by
    simpa only [listingEndpointCount] using hcountpos
  obtain ⟨i, _hiuniv, hi⟩ := Finset.sum_pos_iff.mp hsumpos
  have hieq : (E i).inside = (v : W) := by
    by_contra hne
    rw [if_neg hne] at hi
    omega
  have hsumOne : (∑ x : S, G.listingEndpointCount S E x) =
      (∑ x : S, H.mult none (some x)) + 1 := by omega
  have hshape := functions_eq_sub_indicator_of_sum_eq_add_one
    (fun x : S ↦ H.mult none (some x))
    (fun x : S ↦ G.listingEndpointCount S E x)
    hle hsumOne hvlt
  refine ⟨i, fun x ↦ ?_⟩
  have hx := hshape x
  by_cases hvx : v = x
  · have hix : (E i).inside = (x : W) := by
      simpa [hvx] using hieq
    rw [if_pos hix]
    simpa [hvx] using hx
  · have hix : (E i).inside ≠ (x : W) := by
      intro hix
      apply hvx
      apply Subtype.ext
      exact hieq.symm.trans hix
    rw [if_neg hix]
    simpa [hvx] using hx

/-- Canonical star closure of a four-cut. -/
noncomputable def closeFourCutStar (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 4) : Pseudograph (Option S) :=
  G.closeFourCutStarWith S (G.cutEquiv S hcut).symm

/-- The aligned listing on the opposite shore reverses exactly the same four
labelled original edges. -/
noncomputable def reversedFourCutListing (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 4) :
    Fin 4 ≃ CrossingEdge G Sᶜ :=
  (G.cutEquiv S hcut).symm.trans (G.reverseCrossingEdgeEquiv S)

/-- The three pairings of four labelled cut edges. -/
inductive FourPairing
  | p01_23
  | p02_13
  | p03_12
  deriving DecidableEq

namespace FourPairing

def a : FourPairing → Fin 4
  | .p01_23 | .p02_13 | .p03_12 => 0

def b : FourPairing → Fin 4
  | .p01_23 => 1
  | .p02_13 => 2
  | .p03_12 => 3

def c : FourPairing → Fin 4
  | .p01_23 => 2
  | .p02_13 | .p03_12 => 1

def d : FourPairing → Fin 4
  | .p01_23 | .p02_13 => 3
  | .p03_12 => 2

/-- Given one pairing, this chooses one of the other two whose blocks join
the first endpoint of the first block to the second endpoint of the second
block, and the two remaining endpoints to each other. -/
def oppositeCross : FourPairing → FourPairing
  | .p01_23 => .p03_12
  | .p02_13 => .p03_12
  | .p03_12 => .p02_13

def otherCross : FourPairing → FourPairing
  | .p01_23 => .p02_13
  | .p02_13 | .p03_12 => .p01_23

/-- Relabel the four positions so that a pairing's two blocks become
positions `0,1` and `2,3`. -/
def labelEquiv : FourPairing → Fin 4 ≃ Fin 4
  | .p01_23 => Equiv.refl _
  | .p02_13 => Equiv.swap 1 2
  | .p03_12 => (Equiv.swap 1 3).trans (Equiv.swap 1 2)

@[simp] lemma labelEquiv_zero (p : FourPairing) : labelEquiv p 0 = p.a := by
  cases p <;> decide

@[simp] lemma labelEquiv_one (p : FourPairing) : labelEquiv p 1 = p.b := by
  cases p <;> decide

@[simp] lemma labelEquiv_two (p : FourPairing) : labelEquiv p 2 = p.c := by
  cases p <;> decide

@[simp] lemma labelEquiv_three (p : FourPairing) : labelEquiv p 3 = p.d := by
  cases p <;> decide

lemma oppositeCross_mem_of_two_complements
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q) :
    oppositeCross r = p ∨ oppositeCross r = q := by
  cases p <;> cases q <;> cases r <;>
    simp [oppositeCross] at hpq hrp hrq ⊢

lemma otherCross_mem_of_two_complements
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q) :
    otherCross r = p ∨ otherCross r = q := by
  cases p <;> cases q <;> cases r <;>
    simp [otherCross] at hpq hrp hrq ⊢

lemma label_eq_one_of (p : FourPairing) (i : Fin 4) :
    i = p.a ∨ i = p.b ∨ i = p.c ∨ i = p.d := by
  cases p <;> fin_cases i <;> simp [a, b, c, d]

lemma indicator_sum (p : FourPairing) (P : Fin 4 → Prop)
    [DecidablePred P] :
    (if P p.a then 1 else 0) + (if P p.b then 1 else 0) +
      (if P p.c then 1 else 0) + (if P p.d then 1 else 0) =
    ∑ i : Fin 4, if P i then 1 else 0 := by
  rw [Fin.sum_univ_four]
  cases p <;>
    by_cases h0 : P 0 <;> by_cases h1 : P 1 <;>
    by_cases h2 : P 2 <;> by_cases h3 : P 3 <;>
    simp [a, b, c, d, h0, h1, h2, h3]

/-- A two--two colouring of four labels has exactly two cross-pairings; we
only need the existence of two distinct ones. -/
lemma exists_two_cross_pairings (f : Fin 4 → Bool)
    (hcount : (∑ i : Fin 4, if f i then 1 else 0) = 2) :
    ∃ p q : FourPairing, p ≠ q ∧
      f p.a ≠ f p.b ∧ f p.c ≠ f p.d ∧
      f q.a ≠ f q.b ∧ f q.c ≠ f q.d := by
  rw [Fin.sum_univ_four] at hcount
  cases h0 : f 0 <;> cases h1 : f 1 <;>
    cases h2 : f 2 <;> cases h3 : f 3
  all_goals simp [h0, h1, h2, h3] at hcount
  all_goals try omega
  next =>
    refine ⟨.p02_13, .p03_12, by decide, ?_⟩
    simp [a, b, c, d, h0, h1, h2, h3]
  next =>
    refine ⟨.p01_23, .p03_12, by decide, ?_⟩
    simp [a, b, c, d, h0, h1, h2, h3]
  next =>
    refine ⟨.p01_23, .p02_13, by decide, ?_⟩
    simp [a, b, c, d, h0, h1, h2, h3]
  next =>
    refine ⟨.p01_23, .p02_13, by decide, ?_⟩
    simp [a, b, c, d, h0, h1, h2, h3]
  next =>
    refine ⟨.p01_23, .p03_12, by decide, ?_⟩
    simp [a, b, c, d, h0, h1, h2, h3]
  next =>
    refine ⟨.p02_13, .p03_12, by decide, ?_⟩
    simp [a, b, c, d, h0, h1, h2, h3]

/-- In a pairing whose two blocks are bichromatic, two distinct labels of
the same colour lie in different blocks.  If both block endpoint pairs have
equal values and the two selected values agree, then all four values agree. -/
lemma all_values_eq_of_block_values_eq_of_same_color
    {α β : Type*} (p : FourPairing) (color : Fin 4 → α)
    (value : Fin 4 → β)
    (hcross₁ : color p.a ≠ color p.b)
    (hcross₂ : color p.c ≠ color p.d)
    {i j : Fin 4} (hij : i ≠ j) (hcolor : color i = color j)
    (hvalue : value i = value j)
    (hblock₁ : value p.a = value p.b)
    (hblock₂ : value p.c = value p.d) :
    ∀ k, value k = value i := by
  intro k
  cases p <;> fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp [a, b, c, d] at hij hcolor hvalue hcross₁ hcross₂ hblock₁ hblock₂ ⊢ <;>
    aesop

lemma exists_two_labels_of_right_color
    {α : Type*} (p : FourPairing) (color : Fin 4 → α)
    {u v : α} (huv : u ≠ v)
    (hvalues : ∀ i, color i = u ∨ color i = v)
    (hcross₁ : color p.a ≠ color p.b)
    (hcross₂ : color p.c ≠ color p.d) :
    ∃ i j : Fin 4, i ≠ j ∧ color i = v ∧ color j = v := by
  let i := if color p.a = v then p.a else p.b
  let j := if color p.c = v then p.c else p.d
  have hi : color i = v := by
    dsimp only [i]
    split_ifs with ha
    · exact ha
    · have hau : color p.a = u := (hvalues p.a).resolve_right ha
      have hbnu : color p.b ≠ u := by
        intro hbu
        exact hcross₁ (hau.trans hbu.symm)
      exact (hvalues p.b).resolve_left hbnu
  have hj : color j = v := by
    dsimp only [j]
    split_ifs with hc
    · exact hc
    · have hcu : color p.c = u := (hvalues p.c).resolve_right hc
      have hdnu : color p.d ≠ u := by
        intro hdu
        exact hcross₂ (hcu.trans hdu.symm)
      exact (hvalues p.d).resolve_left hdnu
  have hij : i ≠ j := by
    dsimp only [i, j]
    cases p <;> split_ifs <;> decide
  exact ⟨i, j, hij, hi, hj⟩

lemma exists_remaining_monochromatic_pairing
    {α : Type*} (color : Fin 4 → α) {u v : α} (huv : u ≠ v)
    (hvalues : ∀ i, color i = u ∨ color i = v)
    (p q : FourPairing) (hpq : p ≠ q)
    (hp₁ : color p.a ≠ color p.b)
    (hp₂ : color p.c ≠ color p.d)
    (hq₁ : color q.a ≠ color q.b)
    (hq₂ : color q.c ≠ color q.d) :
    ∃ r : FourPairing, r ≠ p ∧ r ≠ q ∧
      color r.a = color r.b ∧ color r.c = color r.d := by
  have same {x y z : α} (hx : x = u ∨ x = v)
      (hy : y = u ∨ y = v) (hz : z = u ∨ z = v)
      (hxy : x ≠ y) (hzy : z ≠ y) : x = z := by
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;>
      rcases hz with rfl | rfl <;> simp_all
  cases p <;> cases q
  · exact (hpq rfl).elim
  · refine ⟨.p03_12, by decide, by decide, ?_, ?_⟩
    · change color 0 = color 3
      exact same (hvalues 0) (hvalues 1) (hvalues 3)
        (by simpa only [a, b] using hp₁)
        (by simpa only [c, d] using hq₂.symm)
    · change color 1 = color 2
      exact same (hvalues 1) (hvalues 0) (hvalues 2)
        (by simpa only [a, b] using hp₁.symm)
        (by simpa only [a, b] using hq₁.symm)
  · refine ⟨.p02_13, by decide, by decide, ?_, ?_⟩
    · change color 0 = color 2
      exact same (hvalues 0) (hvalues 1) (hvalues 2)
        (by simpa only [a, b] using hp₁)
        (by simpa only [c, d] using hq₂.symm)
    · change color 1 = color 3
      exact same (hvalues 1) (hvalues 0) (hvalues 3)
        (by simpa only [a, b] using hp₁.symm)
        (by simpa only [a, b] using hq₁.symm)
  · refine ⟨.p03_12, by decide, by decide, ?_, ?_⟩
    · change color 0 = color 3
      exact same (hvalues 0) (hvalues 2) (hvalues 3)
        (by simpa only [a, b] using hp₁)
        (by simpa only [c, d] using hq₂.symm)
    · change color 1 = color 2
      exact same (hvalues 1) (hvalues 3) (hvalues 2)
        (by simpa only [c, d] using hp₂)
        (by simpa only [c, d] using hq₂)
  · exact (hpq rfl).elim
  · refine ⟨.p01_23, by decide, by decide, ?_, ?_⟩
    · change color 0 = color 1
      exact same (hvalues 0) (hvalues 2) (hvalues 1)
        (by simpa only [a, b] using hp₁)
        (by simpa only [c, d] using hq₂)
    · change color 2 = color 3
      exact same (hvalues 2) (hvalues 0) (hvalues 3)
        (by simpa only [a, b] using hp₁.symm)
        (by simpa only [a, b] using hq₁.symm)
  · refine ⟨.p02_13, by decide, by decide, ?_, ?_⟩
    · change color 0 = color 2
      exact same (hvalues 0) (hvalues 1) (hvalues 2)
        (by simpa only [a, b] using hq₁)
        (by simpa only [c, d] using hp₂.symm)
    · change color 1 = color 3
      exact same (hvalues 1) (hvalues 0) (hvalues 3)
        (by simpa only [a, b] using hq₁.symm)
        (by simpa only [a, b] using hp₁.symm)
  · refine ⟨.p01_23, by decide, by decide, ?_, ?_⟩
    · change color 0 = color 1
      exact same (hvalues 0) (hvalues 2) (hvalues 1)
        (by simpa only [a, b] using hq₁)
        (by simpa only [c, d] using hp₂)
    · change color 2 = color 3
      exact same (hvalues 2) (hvalues 0) (hvalues 3)
        (by simpa only [a, b] using hq₁.symm)
        (by simpa only [a, b] using hp₁.symm)
  · exact (hpq rfl).elim

lemma monochromatic_blocks_have_distinct_colors_of_cross_pairing
    {α : Type*} (color : Fin 4 → α) (p r : FourPairing)
    (hp₁ : color p.a ≠ color p.b)
    (hr₁ : color r.a = color r.b)
    (hr₂ : color r.c = color r.d) :
    color r.a ≠ color r.c := by
  intro h
  cases p <;> cases r <;> simp [a, b, c, d] at hp₁ hr₁ hr₂ h ⊢ <;>
    aesop

/-- If the two blocks of the remaining pairing each use the same two
distinct values, one of the other two pairings consists of two copies of
the same nonloop unordered pair. -/
lemma exists_duplicate_pairing_of_two_values
    {α : Type*} (value : Fin 4 → α)
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q)
    (hrab : value r.a ≠ value r.b)
    (hrcd : value r.c ≠ value r.d)
    (htwo : (value r.a = value r.c ∧ value r.b = value r.d) ∨
      (value r.a = value r.d ∧ value r.b = value r.c)) :
    ∃ s : FourPairing, (s = p ∨ s = q) ∧
      value s.a ≠ value s.b ∧ value s.c ≠ value s.d ∧
      ((value s.a, value s.b) = (value s.c, value s.d) ∨
        (value s.a, value s.b) = (value s.d, value s.c)) := by
  cases p <;> cases q <;> cases r <;>
    simp [a, b, c, d] at hpq hrp hrq hrab hrcd htwo ⊢ <;>
    aesop

/-- If two distinct values each occur at least twice among four labels,
then every label has one of those two values. -/
lemma values_covered_of_two_counts
    {α : Type*} [DecidableEq α] (value : Fin 4 → α) {x y : α}
    (hxy : x ≠ y)
    (hx : 2 ≤ ∑ i : Fin 4, if value i = x then 1 else 0)
    (hy : 2 ≤ ∑ i : Fin 4, if value i = y then 1 else 0) :
    ∀ i, value i = x ∨ value i = y := by
  let A : Finset (Fin 4) := Finset.univ.filter fun i ↦ value i = x
  let B : Finset (Fin 4) := Finset.univ.filter fun i ↦ value i = y
  have hA : 2 ≤ A.card := by simpa [A] using hx
  have hB : 2 ≤ B.card := by simpa [B] using hy
  have hdisj : Disjoint A B := by
    rw [Finset.disjoint_left]
    intro i hiA hiB
    have hix : value i = x := by simpa [A] using hiA
    have hiy : value i = y := by simpa [B] using hiB
    exact hxy (hix.symm.trans hiy)
  have hcard : 4 ≤ (A ∪ B).card := by
    rw [Finset.card_union_of_disjoint hdisj]
    omega
  have huniv : A ∪ B = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    simpa using hcard
  intro i
  have hi : i ∈ A ∪ B := by rw [huniv]; simp
  simpa [A, B] using hi

/-- Under a two--two distribution, if one block of a pairing is
monochromatic then so is the other block. -/
lemma other_block_eq_of_block_eq_of_count_two
    {α : Type*} [DecidableEq α] (value : Fin 4 → α)
    {x y : α} (hxy : x ≠ y)
    (hvalues : ∀ i, value i = x ∨ value i = y)
    (hx : (∑ i : Fin 4, if value i = x then 1 else 0) = 2)
    (p : FourPairing)
    (hab : value p.a = value p.b) : value p.c = value p.d := by
  have htotal := indicator_sum p (fun i ↦ value i = x)
  rw [hx] at htotal
  have habx : (value p.a = x) ↔ (value p.b = x) := by rw [hab]
  rcases hvalues p.c with hc | hc <;> rcases hvalues p.d with hd | hd
  · exact hc.trans hd.symm
  · by_cases ha : value p.a = x
    · have hb := habx.mp ha
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
    · have hb : value p.b ≠ x := fun h ↦ ha (habx.mpr h)
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
  · by_cases ha : value p.a = x
    · have hb := habx.mp ha
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
    · have hb : value p.b ≠ x := fun h ↦ ha (habx.mpr h)
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
  · exact hc.trans hd.symm

lemma first_block_eq_of_second_block_eq_of_count_two
    {α : Type*} [DecidableEq α] (value : Fin 4 → α)
    {x y : α} (hxy : x ≠ y)
    (hvalues : ∀ i, value i = x ∨ value i = y)
    (hx : (∑ i : Fin 4, if value i = x then 1 else 0) = 2)
    (p : FourPairing)
    (hcd : value p.c = value p.d) : value p.a = value p.b := by
  have htotal := indicator_sum p (fun i ↦ value i = x)
  rw [hx] at htotal
  have hcdx : (value p.c = x) ↔ (value p.d = x) := by rw [hcd]
  rcases hvalues p.a with ha | ha <;> rcases hvalues p.b with hb | hb
  · exact ha.trans hb.symm
  · by_cases hc : value p.c = x
    · have hd := hcdx.mp hc
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
    · have hd : value p.d ≠ x := fun h ↦ hc (hcdx.mpr h)
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
  · by_cases hc : value p.c = x
    · have hd := hcdx.mp hc
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
    · have hd : value p.d ≠ x := fun h ↦ hc (hcdx.mpr h)
      simp [ha, hb, hc, hd, hxy, hxy.symm] at htotal
  · exact ha.trans hb.symm

/-- Two bichromatic blocks whose values all lie in a two-element set are
the same unordered pair. -/
lemma cross_blocks_same_unordered_pair
    {α : Type*} (value : Fin 4 → α) {x y : α}
    (hvalues : ∀ i, value i = x ∨ value i = y)
    (p : FourPairing)
    (hab : value p.a ≠ value p.b) (hcd : value p.c ≠ value p.d) :
    (value p.a, value p.b) = (value p.c, value p.d) ∨
      (value p.a, value p.b) = (value p.d, value p.c) := by
  cases p <;>
    rcases hvalues 0 with h0 | h0 <;>
    rcases hvalues 1 with h1 | h1 <;>
    rcases hvalues 2 with h2 | h2 <;>
    rcases hvalues 3 with h3 | h3 <;>
    simp_all [a, b, c, d]

end FourPairing

/-- Close a four-cut shore by one of the three pairings of its four labelled
ends. -/
def closeFourCutPairWith (G : Pseudograph W) (S : Finset W)
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing) : Pseudograph S :=
  let endpoint (i : Fin 4) : S := ⟨(E i).inside, (E i).inside_mem⟩
  G.induce S + singleEdge (endpoint p.a) (endpoint p.b) +
    singleEdge (endpoint p.c) (endpoint p.d)

/-- The paired closure on the opposite shore, packaged so its complement's
`DecidableEq` choice is not exposed in downstream theorem signatures. -/
noncomputable def oppositePairClosure (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 4) (p : FourPairing) :
    Pseudograph ↑(Sᶜ) :=
  G.closeFourCutPairWith Sᶜ (G.reversedFourCutListing S hcut) p

/-- Pair closure also restores exactly the lost cut incidences. -/
lemma closeFourCutPairWith_isRegularOfDegree (G : Pseudograph W)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S)
    (p : FourPairing) (hreg : G.IsRegularOfDegree 4) :
    (G.closeFourCutPairWith S E p).IsRegularOfDegree 4 := by
  classical
  intro v
  let endpoint (i : Fin 4) : S := ⟨(E i).inside, (E i).inside_mem⟩
  have hout := G.outsideDegree_eq_listingEndpointCount S E v v.2
  have hout' : G.outsideDegree S v =
      (if v = endpoint p.a then 1 else 0) +
      (if v = endpoint p.b then 1 else 0) +
      (if v = endpoint p.c then 1 else 0) +
      (if v = endpoint p.d then 1 else 0) := by
    rw [hout, listingEndpointCount]
    calc
      (∑ i : Fin 4, if (E i).inside = (v : W) then 1 else 0) =
          ∑ i : Fin 4, if v = endpoint i then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro i _
            by_cases hi : v = endpoint i
            · have hi' : (E i).inside = (v : W) := by
                simpa [endpoint] using congrArg Subtype.val hi.symm
              rw [if_pos hi, if_pos hi']
            · have hi' : (E i).inside ≠ (v : W) := by
                intro hi'
                apply hi
                apply Subtype.ext
                simpa [endpoint] using hi'.symm
              rw [if_neg hi, if_neg hi']
      _ = _ := (FourPairing.indicator_sum p (fun i ↦ v = endpoint i)).symm
  have hdegree := G.degree_induce_add_outsideDegree S v v.2
  rw [hreg v] at hdegree
  have houtW : G.outsideDegree S v =
      (if (v : W) = (E p.a).inside then 1 else 0) +
      (if (v : W) = (E p.b).inside then 1 else 0) +
      (if (v : W) = (E p.c).inside then 1 else 0) +
      (if (v : W) = (E p.d).inside then 1 else 0) := by
    simpa only [endpoint, Subtype.ext_iff] using hout'
  rw [houtW] at hdegree
  simp only [closeFourCutPairWith, degree_add, degree_singleEdge,
    Subtype.ext_iff]
  split_ifs at hdegree ⊢ <;> omega

/-- A canonical enumeration of the two labelled edges in a `2`-cut. -/
noncomputable def twoCutEquiv (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) :
    CrossingEdge G S ≃ Fin 2 :=
  Fintype.equivFinOfCardEq ((card_crossingEdge G S).trans hcut)

/-- The `i`-th labelled edge of a `2`-cut, oriented out of the chosen shore. -/
noncomputable def twoCutEdge (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) (i : Fin 2) : CrossingEdge G S :=
  (twoCutEquiv G S hcut).symm i

/-- Restricting the two-cut enumeration to the edges whose shore endpoint is
`v` identifies that fibre with `CrossingAt`. -/
noncomputable def crossingAtEquivTwoCutFiber (G : Pseudograph W)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 2) (v : W) :
    CrossingAt G S v ≃
      {i : Fin 2 // (twoCutEdge G S hcut i).inside = v} :=
  Equiv.subtypeEquiv (twoCutEquiv G S hcut) (by
    intro e
    simp only [twoCutEdge, Equiv.symm_apply_apply])

/-- At each vertex, the lost degree across a two-cut is exactly the number
of occurrences of that vertex among the two enumerated shore endpoints. -/
lemma outsideDegree_eq_twoCutEndpointCount (G : Pseudograph W)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 2)
    (v : W) (hv : v ∈ S) :
    G.outsideDegree S v =
      (if (twoCutEdge G S hcut 0).inside = v then 1 else 0) +
      (if (twoCutEdge G S hcut 1).inside = v then 1 else 0) := by
  classical
  rw [← card_crossingAt G S v hv,
    Fintype.card_congr (crossingAtEquivTwoCutFiber G S hcut v),
    Fintype.card_subtype, Finset.card_filter]
  simp only [Fin.sum_univ_two]

/-- Close a shore of a two-edge cut by joining its two shore endpoints.  If
the endpoints coincide, the closing edge is a loop, with two incidences. -/
noncomputable def closeTwoCut (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) : Pseudograph S :=
  G.induce S + singleEdge
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩

/-- Closing either shore of a two-cut in a regular pseudograph preserves
every vertex degree. -/
lemma closeTwoCut_isRegularOfDegree (G : Pseudograph W)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 2) {r : ℕ}
    (hreg : G.IsRegularOfDegree r) :
    (G.closeTwoCut S hcut).IsRegularOfDegree r := by
  classical
  intro v
  rw [closeTwoCut, degree_add, degree_singleEdge]
  have hdegree := G.degree_induce_add_outsideDegree S v v.2
  have hout := G.outsideDegree_eq_twoCutEndpointCount S hcut v v.2
  have hout' : G.outsideDegree S v =
      (if (v : W) = (twoCutEdge G S hcut 0).inside then 1 else 0) +
      (if (v : W) = (twoCutEdge G S hcut 1).inside then 1 else 0) := by
    simpa only [eq_comm] using hout
  clear hout
  rw [hreg v] at hdegree
  simp only [Subtype.ext_iff]
  rw [← hout']
  exact hdegree

/-- Extend a pseudograph on a shore to the ambient vertex type by making all
vertices outside the shore isolated. -/
noncomputable def extendFrom (S : Finset W) (H : Pseudograph S) :
    Pseudograph W where
  mult u v := if hu : u ∈ S then
      if hv : v ∈ S then H.mult ⟨u, hu⟩ ⟨v, hv⟩ else 0
    else 0
  mult_comm u v := by
    classical
    by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
    · simp only [hu, hv, dite_true]
      exact H.mult_comm _ _
    · simp [hu, hv]
    · simp [hu, hv]
    · simp [hu, hv]

@[simp]
lemma extendFrom_mult_of_mem (S : Finset W) (H : Pseudograph S)
    {u v : W} (hu : u ∈ S) (hv : v ∈ S) :
    (extendFrom S H).mult u v = H.mult ⟨u, hu⟩ ⟨v, hv⟩ := by
  simp [extendFrom, hu, hv]

@[simp]
lemma extendFrom_mult_of_notMem_left (S : Finset W) (H : Pseudograph S)
    {u v : W} (hu : u ∉ S) :
    (extendFrom S H).mult u v = 0 := by
  simp [extendFrom, hu]

@[simp]
lemma extendFrom_mult_of_notMem_right (S : Finset W) (H : Pseudograph S)
    {u v : W} (hv : v ∉ S) :
    (extendFrom S H).mult u v = 0 := by
  rw [(extendFrom S H).mult_comm]
  exact extendFrom_mult_of_notMem_left S H hv

/-- Extending by isolated vertices preserves the degree on the shore. -/
lemma degree_extendFrom_of_mem (S : Finset W) (H : Pseudograph S)
    (v : W) (hv : v ∈ S) :
    (extendFrom S H).degree v = H.degree ⟨v, hv⟩ := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  rw [extendFrom_mult_of_mem S H hv hv]
  apply congrArg (H.mult ⟨v, hv⟩ ⟨v, hv⟩ + ·)
  let f : W → ℕ := fun w ↦
    if hw : w ∈ S then H.mult ⟨v, hv⟩ ⟨w, hw⟩ else 0
  have hext : ∀ w, (extendFrom S H).mult v w = f w := by
    intro w
    simp only [f, extendFrom, hv, dite_true]
  simp_rw [hext]
  calc
    ∑ w : W, f w = ∑ w ∈ S, f w := by
      have hfilter : Finset.univ.filter (fun w ↦ w ∈ S) = S := by
        ext w
        simp
      rw [← hfilter]
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro w _
      by_cases hw : w ∈ S <;> simp [f, hw]
    _ = ∑ w : S, f w :=
      Finset.sum_subtype S (fun _ ↦ Iff.rfl) f
    _ = ∑ w : S, H.mult ⟨v, hv⟩ w := by
      apply Finset.sum_congr rfl
      intro w _
      simp [f, w.2]

/-- Vertices outside an extended shore are isolated. -/
lemma degree_extendFrom_of_notMem (S : Finset W) (H : Pseudograph S)
    (v : W) (hv : v ∉ S) :
    (extendFrom S H).degree v = 0 := by
  classical
  simp [degree, extendFrom, hv]

/-- Remove one copy of the (possibly loop) edge `ab`. -/
def removeSingleEdge (H : Pseudograph W) (a b : W) : Pseudograph W where
  mult u v := if (u = a ∧ v = b) ∨ (u = b ∧ v = a) then
      H.mult u v - 1 else H.mult u v
  mult_comm u v := by
    by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
    · simp only [if_pos h]
      rw [if_pos]
      · exact congrArg (· - 1) (H.mult_comm u v)
      · tauto
    · simp only [if_neg h]
      rw [if_neg]
      · exact H.mult_comm u v
      · tauto

@[simp]
lemma removeSingleEdge_mult (H : Pseudograph W) (a b u v : W) :
    (H.removeSingleEdge a b).mult u v =
      if (u = a ∧ v = b) ∨ (u = b ∧ v = a) then
        H.mult u v - 1 else H.mult u v :=
  rfl

/-- If the indicated edge is present, deleting then re-adding one copy
recovers the original pseudograph. -/
lemma removeSingleEdge_add (H : Pseudograph W) (a b : W)
    (hpos : 0 < H.mult a b) :
    H.removeSingleEdge a b + singleEdge a b = H := by
  apply ext
  intro u v
  simp only [add_mult, removeSingleEdge_mult, singleEdge_mult]
  by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
  · rw [if_pos h, if_pos h]
    have huvpos : 0 < H.mult u v := by
      rcases h with h | h
      · simpa [h.1, h.2] using hpos
      · simpa [h.1, h.2, H.mult_comm] using hpos
    omega
  · simp [h]

/-- Degree bookkeeping for deleting one present edge. -/
lemma degree_removeSingleEdge_add (H : Pseudograph W) (a b v : W)
    (hpos : 0 < H.mult a b) :
    (H.removeSingleEdge a b).degree v +
      (if v = a then 1 else 0) + (if v = b then 1 else 0) = H.degree v := by
  have hdeg := congrArg (fun K : Pseudograph W ↦ K.degree v)
    (H.removeSingleEdge_add a b hpos)
  rw [degree_add, degree_singleEdge] at hdeg
  omega

/-- The spanning part consisting of exactly the edges crossing `S`. -/
def crossingPart (G : Pseudograph W) (S : Finset W) : Pseudograph W where
  mult u v := if (u ∈ S ∧ v ∉ S) ∨ (v ∈ S ∧ u ∉ S) then
      G.mult u v else 0
  mult_comm u v := by
    by_cases h : (u ∈ S ∧ v ∉ S) ∨ (v ∈ S ∧ u ∉ S)
    · simp only [if_pos h]
      rw [if_pos]
      · exact G.mult_comm u v
      · tauto
    · simp only [if_neg h]
      rw [if_neg]
      tauto

@[simp]
lemma crossingPart_mult (G : Pseudograph W) (S : Finset W) (u v : W) :
    (G.crossingPart S).mult u v =
      if (u ∈ S ∧ v ∉ S) ∨ (v ∈ S ∧ u ∉ S) then
        G.mult u v else 0 :=
  rfl

lemma crossingPart_isPart (G : Pseudograph W) (S : Finset W) :
    (G.crossingPart S).IsPart G := by
  intro u v
  simp only [crossingPart_mult]
  split <;> omega

/-- On the chosen shore, the degree in the crossing part is the outside
degree. -/
lemma degree_crossingPart_of_mem (G : Pseudograph W) (S : Finset W)
    (v : W) (hv : v ∈ S) :
    (G.crossingPart S).degree v = G.outsideDegree S v := by
  classical
  rw [degree_eq_mult_self_add_sum]
  simp only [crossingPart_mult, outsideDegree]
  have hself : ¬ ((v ∈ S ∧ v ∉ S) ∨ (v ∈ S ∧ v ∉ S)) := by
    tauto
  rw [if_neg hself, Nat.zero_add]
  calc
    ∑ w : W, (if (v ∈ S ∧ w ∉ S) ∨ (w ∈ S ∧ v ∉ S) then
        G.mult v w else 0) =
        ∑ w : W, if w ∉ S then G.mult v w else 0 := by
          apply Finset.sum_congr rfl
          intro w _
          simp [hv]
    _ = ∑ w ∈ Sᶜ, G.mult v w := by
      rw [← Finset.sum_filter]
      apply Finset.sum_congr
      · ext w
        simp
      · intro w _
        rfl

/-- On the complementary shore, the same crossing part has the complementary
outside degree. -/
lemma degree_crossingPart_of_notMem (G : Pseudograph W) (S : Finset W)
    (v : W) (hv : v ∉ S) :
    (G.crossingPart S).degree v = G.outsideDegree Sᶜ v := by
  classical
  rw [degree_eq_mult_self_add_sum]
  simp only [crossingPart_mult, outsideDegree]
  have hself : ¬ ((v ∈ S ∧ v ∉ S) ∨ (v ∈ S ∧ v ∉ S)) := by
    tauto
  rw [if_neg hself, Nat.zero_add]
  calc
    ∑ w : W, (if (v ∈ S ∧ w ∉ S) ∨ (w ∈ S ∧ v ∉ S) then
        G.mult v w else 0) =
        ∑ w : W, if w ∈ S then G.mult v w else 0 := by
          apply Finset.sum_congr rfl
          intro w _
          simp [hv]
    _ = ∑ w ∈ S, G.mult v w := by
      rw [← Finset.sum_filter]
      apply Finset.sum_congr
      · ext w
        simp
      · intro w _
        rfl
    _ = ∑ w ∈ (Sᶜ)ᶜ, G.mult v w := by simp

/-- An internal part on a shore remains a part after extension to the
ambient vertices. -/
lemma extendFrom_isPart {G : Pseudograph W} {S : Finset W}
    {H : Pseudograph S} (hH : H.IsPart (G.induce S)) :
    (extendFrom S H).IsPart G := by
  intro u v
  by_cases hu : u ∈ S
  · by_cases hv : v ∈ S
    · rw [extendFrom_mult_of_mem S H hu hv]
      exact hH ⟨u, hu⟩ ⟨v, hv⟩
    · rw [extendFrom_mult_of_notMem_right S H hv]
      omega
  · rw [extendFrom_mult_of_notMem_left S H hu]
    omega

/-- Removing the possible extra copy from a part of `H + ab` leaves a part
of `H`. -/
lemma removeSingleEdge_isPart_left {K H : Pseudograph W} {a b : W}
    (hK : K.IsPart (H + singleEdge a b)) :
    (K.removeSingleEdge a b).IsPart H := by
  intro u v
  have huv := hK u v
  simp only [add_mult, singleEdge_mult] at huv
  simp only [removeSingleEdge_mult]
  by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
  · rw [if_pos h] at huv ⊢
    omega
  · rw [if_neg h] at huv ⊢
    omega

/-- If a part of `H + ab` does not exceed `H` on the exceptional pair, the
part did not need the closing edge anywhere. -/
lemma isPart_left_of_isPart_add_of_mult_le {K H : Pseudograph W} {a b : W}
    (hK : K.IsPart (H + singleEdge a b)) (hab : K.mult a b ≤ H.mult a b) :
    K.IsPart H := by
  intro u v
  have huv := hK u v
  simp only [add_mult, singleEdge_mult] at huv
  by_cases h : (u = a ∧ v = b) ∨ (u = b ∧ v = a)
  · rcases h with h | h
    · simpa [h.1, h.2] using hab
    · simpa [h.1, h.2, K.mult_comm, H.mult_comm] using hab
  · rw [if_neg h] at huv
    omega

lemma starEdge_eq_zero_of_center_degree_zero
    {S : Finset W} {H : Pseudograph (Option S)}
    (hcenter : H.degree none = 0) (v : S) :
    H.mult none (some v) = 0 := by
  have hle := mult_le_degree_of_ne H (show (none : Option S) ≠ some v by simp)
  rw [hcenter] at hle
  omega

/-- If a cubic part of a star closure leaves the new center isolated, it was
already a cubic part of the original pseudograph. -/
lemma containsRegularPart_of_star_center_zero
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 4 ≃ CrossingEdge G S) {H : Pseudograph (Option S)}
    (hpart : H.IsPart (G.closeFourCutStarWith S E))
    (hne : ∃ v, H.degree v = 3)
    (hdegrees : ∀ v, H.degree v = 0 ∨ H.degree v = 3)
    (hcenter : H.degree none = 0) :
    G.ContainsRegularPart 3 := by
  classical
  have hdrop : H.dropStarCenter.IsPart (G.induce S) :=
    dropStarCenter_isPart hpart
  refine ⟨extendFrom S H.dropStarCenter, extendFrom_isPart hdrop, ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hne
    cases v with
    | none => omega
    | some v =>
        refine ⟨v, ?_⟩
        rw [degree_extendFrom_of_mem S H.dropStarCenter v v.2]
        have hdeg := degree_dropStarCenter_add H v
        have hz : H.mult (some v) none = 0 := by
          rw [H.mult_comm]
          exact starEdge_eq_zero_of_center_degree_zero hcenter v
        rw [hz, Nat.add_zero] at hdeg
        exact hdeg.trans hv
  · intro v
    by_cases hv : v ∈ S
    · rw [degree_extendFrom_of_mem S H.dropStarCenter v hv]
      have hdeg := degree_dropStarCenter_add H ⟨v, hv⟩
      have hz : H.mult (some ⟨v, hv⟩) none = 0 := by
        rw [H.mult_comm]
        exact starEdge_eq_zero_of_center_degree_zero hcenter ⟨v, hv⟩
      rw [hz, Nat.add_zero] at hdeg
      simpa [hdeg] using hdegrees (some ⟨v, hv⟩)
    · exact Or.inl (degree_extendFrom_of_notMem S H.dropStarCenter v hv)

/-- Delete one specified original crossing-edge copy. -/
def crossingPartExcept {G : Pseudograph W} {S : Finset W} {n : ℕ}
    (E : Fin n ≃ CrossingEdge G S) (i : Fin n) : Pseudograph W :=
  (G.crossingPart S).removeSingleEdge (E i).inside (E i).outside

lemma crossingPartExcept_isPart {G : Pseudograph W} {S : Finset W} {n : ℕ}
    (E : Fin n ≃ CrossingEdge G S) (i : Fin n) :
    (crossingPartExcept E i).IsPart G := by
  intro u v
  have hcross := G.crossingPart_isPart S u v
  simp only [crossingPartExcept, removeSingleEdge_mult]
  split <;> omega

lemma degree_crossingPartExcept_add_of_mem
    {G : Pseudograph W} {S : Finset W} {n : ℕ}
    (E : Fin n ≃ CrossingEdge G S) (i : Fin n)
    (v : W) (hv : v ∈ S) :
    (crossingPartExcept E i).degree v +
      (if (E i).inside = v then 1 else 0) = G.outsideDegree S v := by
  classical
  have hposG : 0 < G.mult (E i).inside (E i).outside :=
    Nat.zero_lt_of_lt (E i).index.isLt
  have hcrossmult :
      (G.crossingPart S).mult (E i).inside (E i).outside =
        G.mult (E i).inside (E i).outside := by
    simp [crossingPart, (E i).inside_mem, (E i).outside_notMem]
  have hpos : 0 < (G.crossingPart S).mult (E i).inside (E i).outside := by
    rw [hcrossmult]
    exact hposG
  have hrem := degree_removeSingleEdge_add (G.crossingPart S)
    (E i).inside (E i).outside v hpos
  have hvout : v ≠ (E i).outside := by
    intro h
    exact (E i).outside_notMem (h ▸ hv)
  rw [degree_crossingPart_of_mem G S v hv, if_neg hvout] at hrem
  simpa [crossingPartExcept, eq_comm, Nat.add_zero, Nat.add_assoc] using hrem

lemma degree_crossingPartExcept_add_of_notMem
    {G : Pseudograph W} {S : Finset W} {n : ℕ}
    (E : Fin n ≃ CrossingEdge G S) (i : Fin n)
    (v : W) (hv : v ∉ S) :
    (crossingPartExcept E i).degree v +
      (if (E i).outside = v then 1 else 0) = G.outsideDegree Sᶜ v := by
  classical
  have hposG : 0 < G.mult (E i).inside (E i).outside :=
    Nat.zero_lt_of_lt (E i).index.isLt
  have hcrossmult :
      (G.crossingPart S).mult (E i).inside (E i).outside =
        G.mult (E i).inside (E i).outside := by
    simp [crossingPart, (E i).inside_mem, (E i).outside_notMem]
  have hpos : 0 < (G.crossingPart S).mult (E i).inside (E i).outside := by
    rw [hcrossmult]
    exact hposG
  have hrem := degree_removeSingleEdge_add (G.crossingPart S)
    (E i).inside (E i).outside v hpos
  have hvin : v ≠ (E i).inside := by
    intro h
    exact hv (h ▸ (E i).inside_mem)
  rw [degree_crossingPart_of_notMem G S v hv, if_neg hvin] at hrem
  simpa [crossingPartExcept, eq_comm, Nat.zero_add, Nat.add_assoc] using hrem

/-- Splice two star-closure parts which omit the same labelled cut edge.
The internal portions are retained on their respective shores and the other
three original crossing-edge copies are restored. -/
def spliceFourCutStars {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S)
    (H : Pseudograph (Option S)) (K : Pseudograph (Option ↑(Sᶜ)))
    (i : Fin 4) : Pseudograph W :=
  extendFrom S H.dropStarCenter + extendFrom Sᶜ K.dropStarCenter +
    crossingPartExcept E i

/-- The star splice has exactly the first witness's degree on the chosen
shore. -/
lemma degree_spliceFourCutStars_of_mem
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 4 ≃ CrossingEdge G S)
    (H : Pseudograph (Option S)) (K : Pseudograph (Option ↑(Sᶜ)))
    (i : Fin 4) (homit : StarOmitsExactly E H i)
    (v : W) (hv : v ∈ S) :
    (spliceFourCutStars E H K i).degree v = H.degree (some ⟨v, hv⟩) := by
  classical
  have hvC : v ∉ Sᶜ := by simp [hv]
  have hout := G.outsideDegree_eq_listingEndpointCount S E v hv
  have hcross := degree_crossingPartExcept_add_of_mem E i v hv
  have homitv := homit ⟨v, hv⟩
  have hedge : H.mult (some ⟨v, hv⟩) none =
      G.listingEndpointCount S E v -
        (if (E i).inside = v then 1 else 0) := by
    rw [H.mult_comm]
    simpa using homitv
  have hdrop := degree_dropStarCenter_add H ⟨v, hv⟩
  rw [spliceFourCutStars, degree_add, degree_add,
    degree_extendFrom_of_mem S H.dropStarCenter v hv,
    degree_extendFrom_of_notMem Sᶜ K.dropStarCenter v hvC,
    Nat.add_zero]
  omega

/-- The star splice has exactly the second witness's degree on the opposite
shore. -/
lemma degree_spliceFourCutStars_of_notMem
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 4 ≃ CrossingEdge G S)
    (EC : Fin 4 ≃ CrossingEdge G Sᶜ)
    (halign : ∀ j : Fin 4, (EC j).inside = (E j).outside)
    (H : Pseudograph (Option S)) (K : Pseudograph (Option ↑(Sᶜ)))
    (i : Fin 4) (homit : StarOmitsExactly EC K i)
    (v : W) (hv : v ∉ S) :
    (spliceFourCutStars E H K i).degree v =
      K.degree (some ⟨v, Finset.mem_compl.mpr hv⟩) := by
  classical
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  have hout := G.outsideDegree_eq_listingEndpointCount Sᶜ EC v hvC
  have hcross := degree_crossingPartExcept_add_of_notMem E i v hv
  have homitv := homit ⟨v, hvC⟩
  have hedge : K.mult (some ⟨v, hvC⟩) none =
      G.listingEndpointCount Sᶜ EC v -
        (if (E i).outside = v then 1 else 0) := by
    rw [K.mult_comm]
    rw [homitv]
    rw [halign i]
  have hdrop := degree_dropStarCenter_add K ⟨v, hvC⟩
  rw [spliceFourCutStars, degree_add, degree_add,
    degree_extendFrom_of_notMem S H.dropStarCenter v hv,
    degree_extendFrom_of_mem Sᶜ K.dropStarCenter v hvC,
    Nat.zero_add]
  omega

/-- The star splice uses no edge outside the original pseudograph. -/
lemma spliceFourCutStars_isPart
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 4 ≃ CrossingEdge G S)
    (EC : Fin 4 ≃ CrossingEdge G Sᶜ)
    (H : Pseudograph (Option S)) (K : Pseudograph (Option ↑(Sᶜ)))
    (hH : H.IsPart (G.closeFourCutStarWith S E))
    (hK : K.IsPart (G.closeFourCutStarWith Sᶜ EC))
    (i : Fin 4) :
    (spliceFourCutStars E H K i).IsPart G := by
  classical
  have hHS : H.dropStarCenter.IsPart (G.induce S) :=
    dropStarCenter_isPart hH
  have hKC : K.dropStarCenter.IsPart (G.induce Sᶜ) :=
    dropStarCenter_isPart hK
  intro u v
  by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
  · have hcross0 : (crossingPartExcept E i).mult u v = 0 := by
      simp [crossingPartExcept, crossingPart, hu, hv]
    simp [spliceFourCutStars, extendFrom, hu, hv, hcross0]
    simpa using hHS ⟨u, hu⟩ ⟨v, hv⟩
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    simp [spliceFourCutStars, extendFrom, hu, hv, huC, hvC]
    exact crossingPartExcept_isPart E i u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∉ Sᶜ := by simp [hv]
    simp [spliceFourCutStars, extendFrom, hu, hv, huC, hvC]
    exact crossingPartExcept_isPart E i u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    have hcross0 : (crossingPartExcept E i).mult u v = 0 := by
      simp [crossingPartExcept, crossingPart, hu, hv]
    simp [spliceFourCutStars, extendFrom, hu, hv, huC, hvC, hcross0]
    simpa using hKC ⟨u, huC⟩ ⟨v, hvC⟩

lemma reversedFourCutListing_inside
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 4) (i : Fin 4) :
    ((G.reversedFourCutListing S hcut) i).inside =
      ((G.cutEquiv S hcut).symm i).outside := by
  rfl

/-- **Four-edge star gluing (Tashkinov, Proposition 2.4).**  If the first
shore supplies a cubic star-closure part omitting each prescribed label,
then any cubic part on the opposite star closure splices to a cubic part of
the original graph. -/
theorem containsRegularPart_of_fourCutStarClosures
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 4)
    (hS : ∀ i : Fin 4, ∃ H : Pseudograph (Option S),
      H.IsPart (G.closeFourCutStar S hcut) ∧
      (∃ v, H.degree v = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      StarOmitsExactly (G.cutEquiv S hcut).symm H i)
    (hC : (G.closeFourCutStarWith Sᶜ
      (G.reversedFourCutListing S hcut)).ContainsRegularPart 3) :
    G.ContainsRegularPart 3 := by
  classical
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    G.reversedFourCutListing S hcut
  obtain ⟨K, hKpart, hKne, hKdeg⟩ := hC
  rcases hKdeg none with hKzero | hKthree
  · exact containsRegularPart_of_star_center_zero
      G Sᶜ EC hKpart hKne hKdeg hKzero
  · obtain ⟨i, hKomit⟩ :=
      exists_starOmitsExactly_of_center_degree_three hKpart hKthree
    obtain ⟨H, hHpart, hHne, hHdeg, hHomit⟩ := hS i
    have hHpart' : H.IsPart (G.closeFourCutStarWith S E) := by
      simpa [E, closeFourCutStar] using hHpart
    refine ⟨spliceFourCutStars E H K i,
      spliceFourCutStars_isPart G S E EC H K hHpart' hKpart i, ?_, ?_⟩
    · obtain ⟨v, hv⟩ := hHne
      cases v with
      | none =>
          have hcenter := hHdeg none
          rcases hcenter with hzero | hthree
          · omega
          · have hsum : (∑ x : S, H.mult none (some x)) = 3 := by
              have hloop : H.mult none none = 0 :=
                starCenter_loop_eq_zero hHpart'
              simpa [degree_eq_mult_self_add_sum, Fintype.sum_option, hloop]
                using hthree
            obtain ⟨x, hx⟩ : ∃ x : S, H.degree (some x) = 3 := by
              by_contra hn
              push_neg at hn
              have hzeroAll : ∀ x : S, H.degree (some x) = 0 := by
                intro x
                rcases hHdeg (some x) with hx0 | hx3
                · exact hx0
                · exact (hn x hx3).elim
              have hedgeZero : ∀ x : S, H.mult none (some x) = 0 := by
                intro x
                have hle := mult_le_degree_of_ne H
                  (show (none : Option S) ≠ some x by simp)
                rw [hthree] at hle
                have hle' := mult_le_degree_of_ne H
                  (show some x ≠ (none : Option S) by simp)
                rw [hzeroAll x] at hle'
                rw [H.mult_comm]
                omega
              have : (∑ x : S, H.mult none (some x)) = 0 := by
                simp [hedgeZero]
              omega
            exact ⟨x, (degree_spliceFourCutStars_of_mem
              G S E H K i hHomit x x.2).trans hx⟩
      | some v =>
          exact ⟨v, (degree_spliceFourCutStars_of_mem
            G S E H K i hHomit v v.2).trans hv⟩
    · intro v
      by_cases hv : v ∈ S
      · rw [degree_spliceFourCutStars_of_mem G S E H K i hHomit v hv]
        exact hHdeg (some ⟨v, hv⟩)
      · rw [degree_spliceFourCutStars_of_notMem G S E EC
          (fun j ↦ reversedFourCutListing_inside G S hcut j)
          H K i hKomit v hv]
        exact hKdeg (some ⟨v, Finset.mem_compl.mpr hv⟩)

/-- A part of a two-cut closure uses the artificial closing edge precisely
when its multiplicity on the exceptional pair exceeds the original internal
multiplicity. -/
def UsesTwoCutClosingEdge (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) (H : Pseudograph S) : Prop :=
  (G.induce S).mult
      ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
      ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩ <
    H.mult
      ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
      ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩

/-- If a cubic part of a two-cut closure omits the artificial edge, it lifts
unchanged to a cubic part of the original graph. -/
lemma containsRegularPart_of_closeTwoCut_of_not_uses
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) {k : ℕ}
    {H : Pseudograph S}
    (hpart : H.IsPart (G.closeTwoCut S hcut))
    (hne : ∃ v, H.degree v = k)
    (hdegrees : ∀ v, H.degree v = 0 ∨ H.degree v = k)
    (homit : ¬ G.UsesTwoCutClosingEdge S hcut H) :
    G.ContainsRegularPart k := by
  classical
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  have hab : H.mult a b ≤ (G.induce S).mult a b := by
    exact Nat.le_of_not_gt homit
  have hpart' : H.IsPart (G.induce S) := by
    apply isPart_left_of_isPart_add_of_mult_le
    · simpa [closeTwoCut, a, b] using hpart
    · exact hab
  refine ⟨extendFrom S H, extendFrom_isPart hpart', ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hne
    exact ⟨v, (degree_extendFrom_of_mem S H v v.2).trans hv⟩
  · intro v
    by_cases hv : v ∈ S
    · simpa [degree_extendFrom_of_mem S H v hv] using hdegrees ⟨v, hv⟩
    · exact Or.inl (degree_extendFrom_of_notMem S H v hv)

/-- Both closure witnesses use their artificial edge exactly in the case
where they must be spliced. -/
noncomputable def spliceTwoCut (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2)
    (hcutC : G.boundaryMultiplicity Sᶜ = 2)
    (H : Pseudograph S) (K : Pseudograph ↥(Sᶜ)) : Pseudograph W :=
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  let c : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 0).inside,
      (twoCutEdge G Sᶜ hcutC 0).inside_mem⟩
  let d : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 1).inside,
      (twoCutEdge G Sᶜ hcutC 1).inside_mem⟩
  extendFrom S (H.removeSingleEdge a b) +
    extendFrom Sᶜ (K.removeSingleEdge c d) + G.crossingPart S

/-- On the first shore, splicing restores exactly the degree of the first
closure witness. -/
lemma degree_spliceTwoCut_of_mem (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2)
    (hcutC : G.boundaryMultiplicity Sᶜ = 2)
    (H : Pseudograph S) (K : Pseudograph ↥(Sᶜ))
    (huses : G.UsesTwoCutClosingEdge S hcut H)
    (v : W) (hv : v ∈ S) :
    (G.spliceTwoCut S hcut hcutC H K).degree v = H.degree ⟨v, hv⟩ := by
  classical
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  let c : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 0).inside,
      (twoCutEdge G Sᶜ hcutC 0).inside_mem⟩
  let d : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 1).inside,
      (twoCutEdge G Sᶜ hcutC 1).inside_mem⟩
  have hpos : 0 < H.mult a b := by
    unfold UsesTwoCutClosingEdge at huses
    have h := lt_of_le_of_lt (Nat.zero_le _) huses
    simpa [a, b] using h
  have hrem := degree_removeSingleEdge_add H a b ⟨v, hv⟩ hpos
  have hout := G.outsideDegree_eq_twoCutEndpointCount S hcut v hv
  have hout' : G.outsideDegree S v =
      (if ⟨v, hv⟩ = a then 1 else 0) +
      (if ⟨v, hv⟩ = b then 1 else 0) := by
    simpa only [a, b, Subtype.ext_iff, eq_comm] using hout
  have hvC : v ∉ Sᶜ := by simp [hv]
  rw [spliceTwoCut, degree_add, degree_add,
    degree_extendFrom_of_mem S (H.removeSingleEdge a b) v hv,
    degree_extendFrom_of_notMem Sᶜ (K.removeSingleEdge c d) v hvC,
    degree_crossingPart_of_mem G S v hv, Nat.add_zero]
  rw [hout']
  split_ifs at hrem ⊢ <;> omega

/-- On the complementary shore, splicing restores exactly the degree of the
second closure witness. -/
lemma degree_spliceTwoCut_of_notMem (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2)
    (hcutC : G.boundaryMultiplicity Sᶜ = 2)
    (H : Pseudograph S) (K : Pseudograph ↥(Sᶜ))
    (huses : G.UsesTwoCutClosingEdge Sᶜ hcutC K)
    (v : W) (hv : v ∉ S) :
    (G.spliceTwoCut S hcut hcutC H K).degree v =
      K.degree ⟨v, Finset.mem_compl.mpr hv⟩ := by
  classical
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  let c : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 0).inside,
      (twoCutEdge G Sᶜ hcutC 0).inside_mem⟩
  let d : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 1).inside,
      (twoCutEdge G Sᶜ hcutC 1).inside_mem⟩
  have hpos : 0 < K.mult c d := by
    unfold UsesTwoCutClosingEdge at huses
    have h := lt_of_le_of_lt (Nat.zero_le _) huses
    simpa [c, d] using h
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  have hrem := degree_removeSingleEdge_add K c d ⟨v, hvC⟩ hpos
  have hout := G.outsideDegree_eq_twoCutEndpointCount Sᶜ hcutC v hvC
  have hout' : G.outsideDegree Sᶜ v =
      (if ⟨v, hvC⟩ = c then 1 else 0) +
      (if ⟨v, hvC⟩ = d then 1 else 0) := by
    simpa only [c, d, Subtype.ext_iff, eq_comm] using hout
  rw [spliceTwoCut, degree_add, degree_add,
    degree_extendFrom_of_notMem S (H.removeSingleEdge a b) v hv,
    degree_extendFrom_of_mem Sᶜ (K.removeSingleEdge c d) v hvC,
    degree_crossingPart_of_notMem G S v hv, Nat.zero_add]
  rw [hout']
  split_ifs at hrem ⊢ <;> omega

/-- The spliced witness uses no edge outside the original pseudograph. -/
lemma spliceTwoCut_isPart (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2)
    (hcutC : G.boundaryMultiplicity Sᶜ = 2)
    (H : Pseudograph S) (K : Pseudograph ↥(Sᶜ))
    (hH : H.IsPart (G.closeTwoCut S hcut))
    (hK : K.IsPart (G.closeTwoCut Sᶜ hcutC)) :
    (G.spliceTwoCut S hcut hcutC H K).IsPart G := by
  classical
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  let c : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 0).inside,
      (twoCutEdge G Sᶜ hcutC 0).inside_mem⟩
  let d : ↥(Sᶜ) :=
    ⟨(twoCutEdge G Sᶜ hcutC 1).inside,
      (twoCutEdge G Sᶜ hcutC 1).inside_mem⟩
  have hHA : (H.removeSingleEdge a b).IsPart (G.induce S) := by
    apply removeSingleEdge_isPart_left
    simpa [closeTwoCut, a, b] using hH
  have hKC : (K.removeSingleEdge c d).IsPart (G.induce Sᶜ) := by
    apply removeSingleEdge_isPart_left
    simpa [closeTwoCut, c, d] using hK
  intro u v
  by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
  · simp [spliceTwoCut, crossingPart, hu, hv, a, b, c, d]
    simpa [a, b] using hHA ⟨u, hu⟩ ⟨v, hv⟩
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    simp [spliceTwoCut, crossingPart, hu, hv, huC, hvC, a, b, c, d]
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∉ Sᶜ := by simp [hv]
    simp [spliceTwoCut, crossingPart, hu, hv, huC, hvC, a, b, c, d]
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    simp [spliceTwoCut, crossingPart, hu, hv, huC, hvC, a, b, c, d]
    simpa [c, d] using hKC ⟨u, huC⟩ ⟨v, hvC⟩

/-- **Two-edge gluing.** Cubic parts in both shore closures always produce a
cubic part of the original pseudograph. -/
theorem containsRegularPart_of_twoCutClosures
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) {k : ℕ}
    (hS : (G.closeTwoCut S hcut).ContainsRegularPart k)
    (hC : (G.closeTwoCut Sᶜ
      ((G.boundaryMultiplicity_compl S).trans hcut)).ContainsRegularPart k) :
    G.ContainsRegularPart k := by
  classical
  let hcutC : G.boundaryMultiplicity Sᶜ = 2 :=
    (G.boundaryMultiplicity_compl S).trans hcut
  obtain ⟨H, hHpart, hHne, hHdeg⟩ := hS
  obtain ⟨K, hKpart, hKne, hKdeg⟩ := hC
  by_cases hHuses : G.UsesTwoCutClosingEdge S hcut H
  · by_cases hKuses : G.UsesTwoCutClosingEdge Sᶜ hcutC K
    · refine ⟨G.spliceTwoCut S hcut hcutC H K,
        G.spliceTwoCut_isPart S hcut hcutC H K hHpart hKpart, ?_, ?_⟩
      · obtain ⟨v, hv⟩ := hHne
        exact ⟨v, G.degree_spliceTwoCut_of_mem S hcut hcutC H K hHuses v v.2 |>.trans hv⟩
      · intro v
        by_cases hv : v ∈ S
        · simpa [G.degree_spliceTwoCut_of_mem S hcut hcutC H K hHuses v hv]
            using hHdeg ⟨v, hv⟩
        · simpa [G.degree_spliceTwoCut_of_notMem S hcut hcutC H K hKuses v hv]
            using hKdeg ⟨v, Finset.mem_compl.mpr hv⟩
    · exact containsRegularPart_of_closeTwoCut_of_not_uses
        G Sᶜ hcutC hKpart hKne hKdeg hKuses
  · exact containsRegularPart_of_closeTwoCut_of_not_uses
      G S hcut hHpart hHne hHdeg hHuses

/-- Internal edges of a disjoint union are the internal edges of its two
blocks plus the edges between them. -/
lemma internalMultiplicity_union
    (G : Pseudograph W) (S T : Finset W) (hdisj : Disjoint S T) :
    G.internalMultiplicity (S ∪ T) =
      G.internalMultiplicity S + G.internalMultiplicity T +
        G.betweenMultiplicity S T := by
  classical
  unfold internalMultiplicity betweenMultiplicity
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  induction e using Sym2.inductionOn with
  | _ a b =>
      have hSTa : ¬ (a ∈ S ∧ a ∈ T) := by
        exact fun h ↦ (Finset.disjoint_left.mp hdisj) h.1 h.2
      have hSTb : ¬ (b ∈ S ∧ b ∈ T) := by
        exact fun h ↦ (Finset.disjoint_left.mp hdisj) h.1 h.2
      by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T
      all_goals simp [internalIndicator_mk, betweenIndicator_mk,
        haS, hbS, haT, hbT] at *
      all_goals ring

/-- In a regular pseudograph, toggling two disjoint shores gives the usual
cut-union identity: the two original cuts count the between-shore edges
twice. -/
lemma boundaryMultiplicity_union_add_two_between
    (G : Pseudograph W) {r : ℕ} (hreg : G.IsRegularOfDegree r)
    (S T : Finset W) (hdisj : Disjoint S T) :
    G.boundaryMultiplicity (S ∪ T) + 2 * G.betweenMultiplicity S T =
      G.boundaryMultiplicity S + G.boundaryMultiplicity T := by
  have hS := G.regular_card_eq_two_internal_add_boundary hreg S
  have hT := G.regular_card_eq_two_internal_add_boundary hreg T
  have hU := G.regular_card_eq_two_internal_add_boundary hreg (S ∪ T)
  have hcard := Finset.card_union_of_disjoint hdisj
  have hint := G.internalMultiplicity_union S T hdisj
  rw [hcard, hint] at hU
  simp only [Nat.mul_add] at hU
  omega

/-- Edges between two disjoint shores form a submultiset of the boundary of
either shore. -/
lemma betweenMultiplicity_le_boundaryMultiplicity
    (G : Pseudograph W) (S T : Finset W) (hdisj : Disjoint S T) :
    G.betweenMultiplicity S T ≤ G.boundaryMultiplicity S := by
  classical
  unfold betweenMultiplicity boundaryMultiplicity
  apply Finset.sum_le_sum
  intro e _
  apply Nat.mul_le_mul_left
  induction e using Sym2.inductionOn with
  | _ a b =>
      have hSTa : ¬ (a ∈ S ∧ a ∈ T) := fun h ↦
        (Finset.disjoint_left.mp hdisj) h.1 h.2
      have hSTb : ¬ (b ∈ S ∧ b ∈ T) := fun h ↦
        (Finset.disjoint_left.mp hdisj) h.1 h.2
      by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T <;>
        simp [betweenIndicator_mk, crossingIndicator_mk, haS, hbS, haT, hbT] at *

/-- Enlarging the second shore can only increase the between-edge count,
provided the enlarged shore remains disjoint from the first. -/
lemma betweenMultiplicity_mono_right
    (G : Pseudograph W) (S T U : Finset W) (hTU : T ⊆ U)
    (hdisj : Disjoint S U) :
    G.betweenMultiplicity S T ≤ G.betweenMultiplicity S U := by
  classical
  unfold betweenMultiplicity
  apply Finset.sum_le_sum
  intro e _
  apply Nat.mul_le_mul_left
  induction e using Sym2.inductionOn with
  | _ a b =>
      have haTU : a ∈ T → a ∈ U := fun h ↦ hTU h
      have hbTU : b ∈ T → b ∈ U := fun h ↦ hTU h
      have hSUa : ¬ (a ∈ S ∧ a ∈ U) := fun h ↦
        (Finset.disjoint_left.mp hdisj) h.1 h.2
      have hSUb : ¬ (b ∈ S ∧ b ∈ U) := fun h ↦
        (Finset.disjoint_left.mp hdisj) h.1 h.2
      by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T <;>
        by_cases haU : a ∈ U <;> by_cases hbU : b ∈ U <;>
        simp [betweenIndicator_mk, haS, hbS, haT, hbT, haU, hbU] at *

/-- Cut double-counting for a disjoint family of shores.  Each shore is
disjoint from `U`, different shores are disjoint, and every edge leaving a
shore ends in `U`.  Consequently their cut multiplicities sum to at most the
cut multiplicity of `U`. -/
lemma sum_boundaryMultiplicity_le_boundaryMultiplicity
    {ι : Type*} [Fintype ι] (G : Pseudograph W) (U : Finset W)
    (I : Finset ι) (S : ι → Finset W)
    (hdisjU : ∀ i ∈ I, Disjoint (S i) U)
    (hdisj : ∀ i ∈ I, ∀ j ∈ I, i ≠ j → Disjoint (S i) (S j))
    (hclosed : ∀ i ∈ I, ∀ a ∈ S i, ∀ b,
      G.mult a b ≠ 0 → b ∈ S i ∨ b ∈ U) :
    ∑ i ∈ I, G.boundaryMultiplicity (S i) ≤ G.boundaryMultiplicity U := by
  classical
  unfold boundaryMultiplicity
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum]
  apply Finset.sum_le_sum
  intro e _
  by_cases hmult : G.edgeMultiplicity e = 0
  · simp [hmult]
  apply Nat.mul_le_mul_left
  induction e using Sym2.inductionOn with
  | _ a b =>
      have hab : G.mult a b ≠ 0 := by simpa using hmult
      have hba : G.mult b a ≠ 0 := by simpa only [G.mult_comm] using hab
      have crossing_of_nonzero {i : ι}
          (hi : i ∈ I) (hc : crossingIndicator (S i) s(a, b) ≠ 0) :
          crossingIndicator U s(a, b) = 1 := by
        have hc' :
            (a ∈ S i ∧ b ∉ S i) ∨ (a ∉ S i ∧ b ∈ S i) := by
          by_contra hcross
          simp [crossingIndicator_mk, hcross] at hc
        rcases hc' with ⟨hai, hbni⟩ | ⟨hani, hbi⟩
        · have hbU : b ∈ U := (hclosed i hi a hai b hab).resolve_left hbni
          have haU : a ∉ U := fun ha ↦
            (Finset.disjoint_left.mp (hdisjU i hi)) hai ha
          simp [crossingIndicator_mk, haU, hbU]
        · have haU : a ∈ U := (hclosed i hi b hbi a hba).resolve_left hani
          have hbU : b ∉ U := fun hb ↦
            (Finset.disjoint_left.mp (hdisjU i hi)) hbi hb
          simp [crossingIndicator_mk, haU, hbU]
      by_cases hex : ∃ i ∈ I, crossingIndicator (S i) s(a, b) ≠ 0
      · obtain ⟨i₀, hi₀, hc₀⟩ := hex
        rw [crossing_of_nonzero hi₀ hc₀]
        rw [Finset.sum_le_one_iff]
        intro i j hi hj hci hcj
        have hci' :
            (a ∈ S i ∧ b ∉ S i) ∨ (a ∉ S i ∧ b ∈ S i) := by
          by_contra hcross
          simp [crossingIndicator_mk, hcross] at hci
        have hcj' :
            (a ∈ S j ∧ b ∉ S j) ∨ (a ∉ S j ∧ b ∈ S j) := by
          by_contra hcross
          simp [crossingIndicator_mk, hcross] at hcj
        have hij : i = j := by
          by_contra hij
          have hd := Finset.disjoint_left.mp (hdisj i hi j hj hij)
          rcases hci' with ⟨hai, hbni⟩ | ⟨hani, hbi⟩ <;>
            rcases hcj' with ⟨haj, hbnj⟩ | ⟨hanj, hbj⟩
          · exact (hd hai haj).elim
          · have hbU : b ∈ U := (hclosed i hi a hai b hab).resolve_left hbni
            exact (Finset.disjoint_left.mp (hdisjU j hj) hbj hbU).elim
          · have haU : a ∈ U := (hclosed i hi b hbi a hba).resolve_left hani
            exact (Finset.disjoint_left.mp (hdisjU j hj) haj haU).elim
          · exact (hd hbi hbj).elim
        subst j
        refine ⟨rfl, ?_⟩
        rcases hci' with h | h <;> simp [crossingIndicator_mk, h]
      · simp only [not_exists, not_and] at hex
        rw [Finset.sum_eq_zero fun i hi ↦ not_ne_iff.mp (hex i hi)]
        exact Nat.zero_le _

/-- Exact cut double-counting when the disjoint shores cover the complement
of `U`.  This is the componentwise form of the master deficiency identity. -/
lemma sum_boundaryMultiplicity_eq_boundaryMultiplicity
    {ι : Type*} [Fintype ι] (G : Pseudograph W) (U : Finset W)
    (I : Finset ι) (S : ι → Finset W)
    (hdisjU : ∀ i ∈ I, Disjoint (S i) U)
    (hdisj : ∀ i ∈ I, ∀ j ∈ I, i ≠ j → Disjoint (S i) (S j))
    (hclosed : ∀ i ∈ I, ∀ a ∈ S i, ∀ b,
      G.mult a b ≠ 0 → b ∈ S i ∨ b ∈ U)
    (hcover : ∀ a, a ∉ U → ∃ i ∈ I, a ∈ S i) :
    ∑ i ∈ I, G.boundaryMultiplicity (S i) = G.boundaryMultiplicity U := by
  classical
  apply Nat.le_antisymm
  · exact sum_boundaryMultiplicity_le_boundaryMultiplicity
      G U I S hdisjU hdisj hclosed
  · unfold boundaryMultiplicity
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum]
    apply Finset.sum_le_sum
    intro e _
    apply Nat.mul_le_mul_left
    induction e using Sym2.inductionOn with
    | _ a b =>
        by_cases haU : a ∈ U <;> by_cases hbU : b ∈ U
        · simp [crossingIndicator_mk, haU, hbU]
        · obtain ⟨i, hi, hbi⟩ := hcover b hbU
          have hai : a ∉ S i := fun hai ↦
            (Finset.disjoint_left.mp (hdisjU i hi)) hai haU
          have hone : crossingIndicator (S i) s(a, b) = 1 := by
            simp [crossingIndicator_mk, hai, hbi]
          rw [show crossingIndicator U s(a, b) = 1 by
            simp [crossingIndicator_mk, haU, hbU], ← hone]
          exact Finset.single_le_sum
            (f := fun j ↦ crossingIndicator (S j) s(a, b))
            (fun _ _ ↦ Nat.zero_le _) hi
        · obtain ⟨i, hi, hai⟩ := hcover a haU
          have hbi : b ∉ S i := fun hbi ↦
            (Finset.disjoint_left.mp (hdisjU i hi)) hbi hbU
          have hone : crossingIndicator (S i) s(a, b) = 1 := by
            simp [crossingIndicator_mk, hai, hbi]
          rw [show crossingIndicator U s(a, b) = 1 by
            simp [crossingIndicator_mk, haU, hbU], ← hone]
          exact Finset.single_le_sum
            (f := fun j ↦ crossingIndicator (S j) s(a, b))
            (fun _ _ ↦ Nat.zero_le _) hi
        · simp [crossingIndicator_mk, haU, hbU]

/-- The numerical core of the Tutte argument.  In a quartic pseudograph, a
family of disjoint shores separated by `U`, each with boundary at least four,
has strictly fewer members than `U` whenever `U` contains an internal edge. -/
lemma card_lt_of_four_le_boundaryMultiplicity
    {ι : Type*} [Fintype ι] (G : Pseudograph W)
    (hreg : G.IsRegularOfDegree 4) (U : Finset W)
    (I : Finset ι) (S : ι → Finset W)
    (hdisjU : ∀ i ∈ I, Disjoint (S i) U)
    (hdisj : ∀ i ∈ I, ∀ j ∈ I, i ≠ j → Disjoint (S i) (S j))
    (hclosed : ∀ i ∈ I, ∀ a ∈ S i, ∀ b,
      G.mult a b ≠ 0 → b ∈ S i ∨ b ∈ U)
    (hfour : ∀ i ∈ I, 4 ≤ G.boundaryMultiplicity (S i))
    (hinternal : 0 < G.internalMultiplicity U) :
    I.card < U.card := by
  have hlower : 4 * I.card ≤
      ∑ i ∈ I, G.boundaryMultiplicity (S i) := by
    calc
      4 * I.card = ∑ _i ∈ I, 4 := by simp [Nat.mul_comm]
      _ ≤ ∑ i ∈ I, G.boundaryMultiplicity (S i) := by
        exact Finset.sum_le_sum fun i hi ↦ hfour i hi
  have hupper := sum_boundaryMultiplicity_le_boundaryMultiplicity
    G U I S hdisjU hdisj hclosed
  have hdegree := regular_card_eq_two_internal_add_boundary G hreg U
  omega

/-- Tashkinov's controlled induction class `B`: quartic pseudographs with at
most one loop and with the loop count plus the number of parallel pairs at
most two. -/
def InTashkinovClass (G : Pseudograph W) : Prop :=
  G.IsRegularOfDegree 4 ∧ G.loopCount ≤ 1 ∧
    G.loopCount + G.parallelPairCount ≤ 2

lemma mult_self_le_loopCount (G : Pseudograph W) (v : W) :
    G.mult v v ≤ G.loopCount := by
  classical
  unfold loopCount
  exact Finset.single_le_sum (s := Finset.univ)
    (f := fun w ↦ G.mult w w) (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ v)

lemma mult_self_add_mult_self_le_loopCount (G : Pseudograph W)
    {u v : W} (huv : u ≠ v) :
    G.mult u u + G.mult v v ≤ G.loopCount := by
  classical
  unfold loopCount
  calc
    G.mult u u + G.mult v v =
        ∑ w ∈ ({u, v} : Finset W), G.mult w w := by simp [huv]
    _ ≤ ∑ w ∈ (Finset.univ : Finset W), G.mult w w :=
      Finset.sum_le_sum_of_subset (Finset.subset_univ _)

lemma one_le_parallelPairCount_of_two_le_mult
    (G : Pseudograph W) {u v : W} (huv : u ≠ v)
    (hparallel : 2 ≤ G.mult u v) : 1 ≤ G.parallelPairCount := by
  classical
  let F := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2
  have huvF : (u, v) ∈ F := by
    simp [F, huv, hparallel]
  have hvuF : (v, u) ∈ F := by
    simp [F, huv.symm, G.mult_comm, hparallel]
  have hpairs : ({(u, v), (v, u)} : Finset (W × W)).card = 2 := by
    simp [huv]
  have hsub : ({(u, v), (v, u)} : Finset (W × W)) ⊆ F := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl
    · exact huvF
    · exact hvuF
  have hcard : 2 ≤ F.card := by
    rw [← hpairs]
    exact Finset.card_le_card hsub
  unfold parallelPairCount
  change 1 ≤ F.card / 2
  omega

lemma two_le_parallelPairCount_of_two_distinct_pairs
    (G : Pseudograph W) {a b c d : W}
    (hab : a ≠ b) (hcd : c ≠ d)
    (habp : 2 ≤ G.mult a b) (hcdp : 2 ≤ G.mult c d)
    (hne₁ : (a, b) ≠ (c, d)) (hne₂ : (a, b) ≠ (d, c)) :
    2 ≤ G.parallelPairCount := by
  classical
  let F := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2
  let T : Finset (W × W) := {(a, b), (b, a), (c, d), (d, c)}
  have hmem (p : W × W) (hp : p = (a, b) ∨ p = (b, a) ∨
      p = (c, d) ∨ p = (d, c)) : p ∈ F := by
    rcases hp with rfl | rfl | rfl | rfl
    · simp [F, hab, habp]
    · simp [F, hab.symm, G.mult_comm, habp]
    · simp [F, hcd, hcdp]
    · simp [F, hcd.symm, G.mult_comm, hcdp]
  have hsub : T ⊆ F := by
    intro p hp
    apply hmem p
    simpa [T] using hp
  have hrev₁ : (b, a) ≠ (c, d) := by
    intro h
    exact hne₂ (Prod.ext (congrArg Prod.snd h)
      (congrArg Prod.fst h))
  have hrev₂ : (b, a) ≠ (d, c) := by
    intro h
    exact hne₁ (Prod.ext (congrArg Prod.snd h)
      (congrArg Prod.fst h))
  have hTcard : T.card = 4 := by
    simp [T, hab, hcd, hne₁, hne₂, hrev₁, hrev₂]
  have hcard : 4 ≤ F.card := by
    rw [← hTcard]
    exact Finset.card_le_card hsub
  unfold parallelPairCount
  change 2 ≤ F.card / 2
  omega

lemma mult_self_eq_zero_of_loopCount_eq_zero (G : Pseudograph W)
    (hzero : G.loopCount = 0) (v : W) : G.mult v v = 0 := by
  have hle := G.mult_self_le_loopCount v
  omega

lemma mult_le_one_of_parallelPairCount_eq_zero (G : Pseudograph W)
    (hzero : G.parallelPairCount = 0) {u v : W} (huv : u ≠ v) :
    G.mult u v ≤ 1 := by
  by_contra hnot
  have htwo : 2 ≤ G.mult u v := by omega
  have hone := G.one_le_parallelPairCount_of_two_le_mult huv htwo
  omega

lemma loopCount_induce_le (G : Pseudograph W) (S : Finset W) :
    (G.induce S).loopCount ≤ G.loopCount := by
  classical
  unfold loopCount
  change Finset.sum (Finset.univ : Finset S) (fun v ↦ G.mult v v) ≤
    Finset.sum (Finset.univ : Finset W) (fun v ↦ G.mult v v)
  rw [← S.attach_eq_univ,
    Finset.sum_attach S (fun v : W ↦ G.mult v v)]
  exact Finset.sum_le_sum_of_subset (Finset.subset_univ S)

lemma loopVertexCount_induce_le (G : Pseudograph W) (S : Finset W) :
    (G.induce S).loopVertexCount ≤ G.loopVertexCount := by
  classical
  unfold loopVertexCount
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  apply Fintype.card_le_of_injective
    (f := fun x : {v : S // 0 < (G.induce S).mult v v} ↦
      (⟨(x.1 : W), by simpa using x.2⟩ : {v : W // 0 < G.mult v v}))
  intro a b h
  apply Subtype.val_injective
  apply Subtype.val_injective
  exact congrArg (fun z : {v : W // 0 < G.mult v v} ↦ z.1) h

lemma parallelPairCount_induce_le (G : Pseudograph W) (S : Finset W) :
    (G.induce S).parallelPairCount ≤ G.parallelPairCount := by
  classical
  unfold parallelPairCount
  apply Nat.div_le_div_right
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  let f :
      {p : S × S // p.1 ≠ p.2 ∧ 2 ≤ (G.induce S).mult p.1 p.2} →
      {p : W × W // p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2} :=
    fun p ↦ ⟨((p.1.1 : W), (p.1.2 : W)), by
      constructor
      · intro h
        apply p.2.1
        apply Subtype.ext
        exact h
      · exact p.2.2⟩
  exact Fintype.card_le_of_injective f (by
    intro a b h
    apply Subtype.ext
    apply Prod.ext <;> apply Subtype.ext
    · exact congrArg Prod.fst (congrArg Subtype.val h)
    · exact congrArg Prod.snd (congrArg Subtype.val h))

/-- A parallel pair wholly outside an induced shore accounts for one more
parallel-pair defect than the defects already visible inside the shore. -/
lemma parallelPairCount_induce_add_one_le_of_parallel_outside
    (G : Pseudograph W) (S : Finset W) {u v : W}
    (hu : u ∉ S) (hv : v ∉ S) (huv : u ≠ v)
    (hparallel : 2 ≤ G.mult u v) :
    (G.induce S).parallelPairCount + 1 ≤ G.parallelPairCount := by
  classical
  let A := {p : S × S // p.1 ≠ p.2 ∧
    2 ≤ (G.induce S).mult p.1 p.2}
  let B := {p : W × W // p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2}
  let f : A → B := fun p ↦
    ⟨((p.1.1 : W), (p.1.2 : W)), by
      constructor
      · intro h
        apply p.2.1
        apply Subtype.ext
        exact h
      · exact p.2.2⟩
  have hf : Function.Injective f := by
    intro a b h
    apply Subtype.ext
    apply Prod.ext <;> apply Subtype.ext
    · exact congrArg Prod.fst (congrArg Subtype.val h)
    · exact congrArg Prod.snd (congrArg Subtype.val h)
  let g : Fin 2 → B := fun i ↦ if i = 0 then
    ⟨(u, v), huv, hparallel⟩
  else
    ⟨(v, u), huv.symm, by simpa only [G.mult_comm] using hparallel⟩
  have hg : Function.Injective g := by
    intro i j h
    fin_cases i <;> fin_cases j
    · rfl
    · exfalso
      exact huv (congrArg (fun z : B ↦ z.1.1) h)
    · exfalso
      exact huv (congrArg (fun z : B ↦ z.1.1) h).symm
    · rfl
  have hfg : ∀ a i, f a ≠ g i := by
    intro a i h
    fin_cases i
    · have hfirst : (a.1.1 : W) = u :=
        congrArg (fun z : B ↦ z.1.1) h
      exact hu (hfirst ▸ a.1.1.2)
    · have hfirst : (a.1.1 : W) = v := by
        simpa [g] using congrArg (fun z : B ↦ z.1.1) h
      exact hv (hfirst ▸ a.1.1.2)
  have hinj : Function.Injective (Sum.elim f g) :=
    hf.sumElim hg hfg
  have hcard := Fintype.card_le_of_injective (Sum.elim f g) hinj
  have hcard' : Fintype.card A + 2 ≤ Fintype.card B := by
    simpa only [Fintype.card_sum, Fintype.card_fin] using hcard
  unfold parallelPairCount
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  change Fintype.card A / 2 + 1 ≤ Fintype.card B / 2
  omega

/-- Two distinct parallel pairs incident with one vertex outside an induced
shore contribute two defects in addition to all defects inside the shore. -/
lemma parallelPairCount_induce_add_two_le_of_parallel_star_outside
    (G : Pseudograph W) (S : Finset W) {u v z : W}
    (hu : u ∉ S) (huv : u ≠ v) (huz : u ≠ z) (hvz : v ≠ z)
    (huvParallel : 2 ≤ G.mult u v)
    (huzParallel : 2 ≤ G.mult u z) :
    (G.induce S).parallelPairCount + 2 ≤ G.parallelPairCount := by
  classical
  let A := {p : S × S // p.1 ≠ p.2 ∧
    2 ≤ (G.induce S).mult p.1 p.2}
  let B := {p : W × W // p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2}
  let f : A → B := fun p ↦
    ⟨((p.1.1 : W), (p.1.2 : W)), by
      constructor
      · intro h
        apply p.2.1
        apply Subtype.ext
        exact h
      · exact p.2.2⟩
  have hf : Function.Injective f := by
    intro a b h
    apply Subtype.ext
    apply Prod.ext <;> apply Subtype.ext
    · exact congrArg Prod.fst (congrArg Subtype.val h)
    · exact congrArg Prod.snd (congrArg Subtype.val h)
  let g : Fin 4 → B := fun i ↦
    if i = 0 then ⟨(u, v), huv, huvParallel⟩
    else if i = 1 then
      ⟨(v, u), huv.symm, by simpa only [G.mult_comm] using huvParallel⟩
    else if i = 2 then ⟨(u, z), huz, huzParallel⟩
    else ⟨(z, u), huz.symm,
      by simpa only [G.mult_comm] using huzParallel⟩
  have hg : Function.Injective g := by
    intro i j h
    fin_cases i <;> fin_cases j
    all_goals try rfl
    all_goals exfalso
    all_goals first
      | exact huv (congrArg (fun q : B ↦ q.1.1) h)
      | exact huv (congrArg (fun q : B ↦ q.1.1) h).symm
      | exact huz (congrArg (fun q : B ↦ q.1.1) h)
      | exact huz (congrArg (fun q : B ↦ q.1.1) h).symm
      | exact hvz (congrArg (fun q : B ↦ q.1.2) h)
      | exact hvz (congrArg (fun q : B ↦ q.1.2) h).symm
      | exact hvz (congrArg (fun q : B ↦ q.1.1) h)
      | exact hvz (congrArg (fun q : B ↦ q.1.1) h).symm
  have hfg : ∀ a i, f a ≠ g i := by
    intro a i h
    fin_cases i
    · have hfirst : (a.1.1 : W) = u := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.1) h
      exact hu (hfirst ▸ a.1.1.2)
    · have hsecond : (a.1.2 : W) = u := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.2) h
      exact hu (hsecond ▸ a.1.2.2)
    · have hfirst : (a.1.1 : W) = u := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.1) h
      exact hu (hfirst ▸ a.1.1.2)
    · have hsecond : (a.1.2 : W) = u := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.2) h
      exact hu (hsecond ▸ a.1.2.2)
  have hinj : Function.Injective (Sum.elim f g) := hf.sumElim hg hfg
  have hcard := Fintype.card_le_of_injective (Sum.elim f g) hinj
  have hcard' : Fintype.card A + 4 ≤ Fintype.card B := by
    simpa only [Fintype.card_sum, Fintype.card_fin] using hcard
  unfold parallelPairCount
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  change Fintype.card A / 2 + 2 ≤ Fintype.card B / 2
  omega

/-- Two distinct parallel pairs that are not internal to an induced shore
contribute two defects in addition to every parallel-pair defect visible in
the shore.  The first pair has both endpoints outside; `c` is an outside
endpoint of the second pair. -/
lemma parallelPairCount_induce_add_two_le_of_two_parallel_pairs_outside
    (G : Pseudograph W) (S : Finset W) {a b c d : W}
    (ha : a ∉ S) (hb : b ∉ S) (hc : c ∉ S)
    (hab : a ≠ b) (hcd : c ≠ d)
    (habParallel : 2 ≤ G.mult a b) (hcdParallel : 2 ≤ G.mult c d)
    (hne₁ : (a, b) ≠ (c, d)) (hne₂ : (a, b) ≠ (d, c)) :
    (G.induce S).parallelPairCount + 2 ≤ G.parallelPairCount := by
  classical
  let A := {p : S × S // p.1 ≠ p.2 ∧
    2 ≤ (G.induce S).mult p.1 p.2}
  let B := {p : W × W // p.1 ≠ p.2 ∧ 2 ≤ G.mult p.1 p.2}
  let f : A → B := fun p ↦
    ⟨((p.1.1 : W), (p.1.2 : W)), by
      constructor
      · intro h
        apply p.2.1
        exact Subtype.ext h
      · exact p.2.2⟩
  have hf : Function.Injective f := by
    intro p q h
    apply Subtype.ext
    apply Prod.ext <;> apply Subtype.ext
    · exact congrArg Prod.fst (congrArg Subtype.val h)
    · exact congrArg Prod.snd (congrArg Subtype.val h)
  let g : Fin 4 → B := fun i ↦
    if i = 0 then ⟨(a, b), hab, habParallel⟩
    else if i = 1 then
      ⟨(b, a), hab.symm, by simpa only [G.mult_comm] using habParallel⟩
    else if i = 2 then ⟨(c, d), hcd, hcdParallel⟩
    else ⟨(d, c), hcd.symm,
      by simpa only [G.mult_comm] using hcdParallel⟩
  have hrev₁ : (b, a) ≠ (c, d) := by
    intro h
    exact hne₂ (Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h))
  have hrev₂ : (b, a) ≠ (d, c) := by
    intro h
    exact hne₁ (Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h))
  have hg : Function.Injective g := by
    intro i j h
    fin_cases i <;> fin_cases j
    all_goals try rfl
    all_goals exfalso
    all_goals first
      | exact hab (congrArg (fun q : B ↦ q.1.1) h)
      | exact hab (congrArg (fun q : B ↦ q.1.1) h).symm
      | exact hcd (congrArg (fun q : B ↦ q.1.1) h)
      | exact hcd (congrArg (fun q : B ↦ q.1.1) h).symm
      | exact hne₁ (congrArg Subtype.val h)
      | exact hne₁ (congrArg Subtype.val h).symm
      | exact hne₂ (congrArg Subtype.val h)
      | exact hne₂ (congrArg Subtype.val h).symm
      | exact hrev₁ (congrArg Subtype.val h)
      | exact hrev₁ (congrArg Subtype.val h).symm
      | exact hrev₂ (congrArg Subtype.val h)
      | exact hrev₂ (congrArg Subtype.val h).symm
  have hfg : ∀ p i, f p ≠ g i := by
    intro p i h
    fin_cases i
    · have hfirst : (p.1.1 : W) = a := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.1) h
      exact ha (hfirst ▸ p.1.1.2)
    · have hfirst : (p.1.1 : W) = b := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.1) h
      exact hb (hfirst ▸ p.1.1.2)
    · have hfirst : (p.1.1 : W) = c := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.1) h
      exact hc (hfirst ▸ p.1.1.2)
    · have hfirst : (p.1.2 : W) = c := by
        simpa [f, g] using congrArg (fun q : B ↦ q.1.2) h
      exact hc (hfirst ▸ p.1.2.2)
  have hinj : Function.Injective (Sum.elim f g) := hf.sumElim hg hfg
  have hcard := Fintype.card_le_of_injective (Sum.elim f g) hinj
  have hcard' : Fintype.card A + 4 ≤ Fintype.card B := by
    simpa only [Fintype.card_sum, Fintype.card_fin] using hcard
  unfold parallelPairCount
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  change Fintype.card A / 2 + 2 ≤ Fintype.card B / 2
  omega

lemma induce_compl_defect_le_one_of_parallel_pair
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (hparallel : 2 ≤ G.mult u v) :
    (G.induce ({u, v} : Finset W)ᶜ).loopCount +
      (G.induce ({u, v} : Finset W)ᶜ).parallelPairCount ≤ 1 := by
  let S : Finset W := ({u, v} : Finset W)ᶜ
  have hu : u ∉ S := by simp [S]
  have hv : v ∉ S := by simp [S]
  have hl := G.loopCount_induce_le S
  have hp := G.parallelPairCount_induce_add_one_le_of_parallel_outside
    S hu hv huv hparallel
  have hc := hclass.2.2
  change (G.induce S).loopCount + (G.induce S).parallelPairCount ≤ 1
  omega

lemma induce_defect_le_one_of_parallel_pair_outside
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    (S : Finset W) {u v : W} (hu : u ∉ S) (hv : v ∉ S)
    (huv : u ≠ v) (hparallel : 2 ≤ G.mult u v) :
    (G.induce S).loopCount + (G.induce S).parallelPairCount ≤ 1 := by
  have hl := G.loopCount_induce_le S
  have hp := G.parallelPairCount_induce_add_one_le_of_parallel_outside
    S hu hv huv hparallel
  have hc := hclass.2.2
  omega

lemma induce_inTashkinovClass
    (G : Pseudograph W) (S : Finset W)
    (hclass : G.InTashkinovClass)
    (hreg : (G.induce S).IsRegularOfDegree 4) :
    (G.induce S).InTashkinovClass := by
  refine ⟨hreg, (G.loopCount_induce_le S).trans hclass.2.1, ?_⟩
  have hl := G.loopCount_induce_le S
  have hp := G.parallelPairCount_induce_le S
  exact (Nat.add_le_add hl hp).trans hclass.2.2

/-- A regular part found after restricting to a shore lifts by isolating all
vertices outside that shore. -/
lemma containsRegularPart_of_induce (G : Pseudograph W) (S : Finset W)
    {k : ℕ} (h : (G.induce S).ContainsRegularPart k) :
    G.ContainsRegularPart k := by
  classical
  obtain ⟨H, hpart, ⟨v, hv⟩, hdeg⟩ := h
  refine ⟨extendFrom S H, extendFrom_isPart hpart, ⟨v, ?_⟩, ?_⟩
  · rw [degree_extendFrom_of_mem S H v v.2]
    exact hv
  · intro w
    by_cases hw : w ∈ S
    · rw [degree_extendFrom_of_mem S H w hw]
      exact hdeg ⟨w, hw⟩
    · exact .inl (degree_extendFrom_of_notMem S H w hw)

/-- An induced shore whose vertices have no boundary retains the ambient
regular degree. -/
lemma induce_isRegularOfDegree_of_outsideDegree_eq_zero
    (G : Pseudograph W) (S : Finset W) {r : ℕ}
    (hreg : G.IsRegularOfDegree r)
    (hzero : ∀ v, v ∈ S → G.outsideDegree S v = 0) :
    (G.induce S).IsRegularOfDegree r := by
  intro v
  have h := G.degree_induce_add_outsideDegree S v v.2
  rw [hzero v v.2, Nat.add_zero, hreg v] at h
  exact h

/-- A displayed perfect matching on six vertices of an induced quartic
shore has a cubic complement, which then lifts to the ambient graph. -/
lemma containsRegularPart_of_induce_of_threeMatchingEdges
    (G : Pseudograph W) (S : Finset W)
    (hreg : (G.induce S).IsRegularOfDegree 4)
    (f : Fin 6 → S) (hf : Function.Injective f)
    (hcover : ∀ x : S, ∃ i : Fin 6, x = f i)
    (h01 : 0 < (G.induce S).mult (f 0) (f 1))
    (h23 : 0 < (G.induce S).mult (f 2) (f 3))
    (h45 : 0 < (G.induce S).mult (f 4) (f 5)) :
    G.ContainsRegularPart 3 := by
  letI : Nonempty S := ⟨f 0⟩
  let F := threeMatchingEdges f
  have hpart : F.IsPart (G.induce S) :=
    threeMatchingEdges_isPart (G.induce S) f hf h01 h23 h45
  have hdeg : ∀ x, F.degree x = 1 :=
    degree_threeMatchingEdges_eq_one f hf hcover
  exact containsRegularPart_of_induce G S
    ((G.induce S).containsRegularPart_of_degreeOnePart hreg F hpart hdeg)

@[simp]
lemma loopVertexCount_ofSimple (G : SimpleGraph W) :
    (ofSimple G).loopVertexCount = 0 := by
  classical
  simp [loopVertexCount]

@[simp]
lemma loopCount_ofSimple (G : SimpleGraph W) :
    (ofSimple G).loopCount = 0 := by
  classical
  simp [loopCount]

@[simp]
lemma parallelPairCount_ofSimple (G : SimpleGraph W) :
    (ofSimple G).parallelPairCount = 0 := by
  classical
  have hfilter :
      Finset.univ.filter (fun p : W × W ↦
        p.1 ≠ p.2 ∧ 2 ≤ (ofSimple G).mult p.1 p.2) = ∅ := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.notMem_empty, iff_false, not_and]
    intro _
    simp only [ofSimple_mult]
    split <;> omega
  unfold parallelPairCount
  rw [hfilter]
  simp

/-- Every quartic simple graph belongs to Tashkinov's induction class. -/
lemma inTashkinovClass_ofSimple (G : SimpleGraph W)
    (hreg : G.IsRegularOfDegree 4) :
    (ofSimple G).InTashkinovClass := by
  exact ⟨isRegularOfDegree_ofSimple_iff G 4 |>.2 hreg, by simp, by simp⟩

section Relabel

variable {Z : Type*} [Fintype Z]

/-- Transport a pseudograph along a vertex equivalence. -/
def relabel (e : W ≃ Z) (G : Pseudograph W) : Pseudograph Z where
  mult u v := G.mult (e.symm u) (e.symm v)
  mult_comm u v := G.mult_comm _ _

@[simp]
lemma relabel_mult (e : W ≃ Z) (G : Pseudograph W) (u v : Z) :
    (G.relabel e).mult u v = G.mult (e.symm u) (e.symm v) :=
  rfl

lemma relabel_symm_relabel (e : W ≃ Z) (G : Pseudograph W) :
    (G.relabel e).relabel e.symm = G := by
  ext u v
  simp [relabel]

lemma degree_relabel (e : W ≃ Z) (G : Pseudograph W) (v : W) :
    (G.relabel e).degree (e v) = G.degree v := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  simp only [relabel_mult, Equiv.symm_apply_apply]
  congr 1
  exact (Fintype.sum_equiv e
    (fun w : W ↦ G.mult v w)
    (fun z : Z ↦ G.mult v (e.symm z)) (fun w ↦ by simp)).symm

lemma isRegularOfDegree_relabel_iff (e : W ≃ Z)
    (G : Pseudograph W) (r : ℕ) :
    (G.relabel e).IsRegularOfDegree r ↔ G.IsRegularOfDegree r := by
  constructor
  · intro h v
    rw [← G.degree_relabel e v]
    exact h (e v)
  · intro h z
    obtain ⟨v, rfl⟩ := e.surjective z
    rw [G.degree_relabel e v, h v]

lemma loopVertexCount_relabel (e : W ≃ Z) (G : Pseudograph W) :
    (G.relabel e).loopVertexCount = G.loopVertexCount := by
  classical
  unfold loopVertexCount
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  apply Fintype.card_congr
  exact Equiv.subtypeEquiv e.symm (by intro z; rfl)

lemma loopCount_relabel (e : W ≃ Z) (G : Pseudograph W) :
    (G.relabel e).loopCount = G.loopCount := by
  classical
  unfold loopCount
  exact Fintype.sum_equiv e.symm
    (fun z : Z ↦ (G.relabel e).mult z z)
    (fun w : W ↦ G.mult w w) (fun z ↦ by simp)

lemma parallelPairCount_relabel (e : W ≃ Z) (G : Pseudograph W) :
    (G.relabel e).parallelPairCount = G.parallelPairCount := by
  classical
  unfold parallelPairCount
  congr 1
  rw [← Fintype.card_subtype, ← Fintype.card_subtype]
  apply Fintype.card_congr
  let ep : Z × Z ≃ W × W := e.symm.prodCongr e.symm
  exact Equiv.subtypeEquiv ep (by
    intro p
    change (p.1 ≠ p.2 ∧ 2 ≤ G.mult (e.symm p.1) (e.symm p.2)) ↔ _
    simp [ep])

lemma inTashkinovClass_relabel_iff (e : W ≃ Z) (G : Pseudograph W) :
    (G.relabel e).InTashkinovClass ↔ G.InTashkinovClass := by
  rw [InTashkinovClass, InTashkinovClass,
    isRegularOfDegree_relabel_iff, loopCount_relabel,
    parallelPairCount_relabel]

lemma isPart_relabel {H G : Pseudograph W} (e : W ≃ Z)
    (hHG : H.IsPart G) : (H.relabel e).IsPart (G.relabel e) := by
  intro u v
  exact hHG (e.symm u) (e.symm v)

lemma containsRegularPart_relabel_iff (e : W ≃ Z)
    (G : Pseudograph W) (k : ℕ) :
    (G.relabel e).ContainsRegularPart k ↔ G.ContainsRegularPart k := by
  constructor
  · rintro ⟨H, hpart, ⟨z, hz⟩, hdeg⟩
    let K := H.relabel e.symm
    have hKG : K.IsPart G := by
      have h := isPart_relabel e.symm hpart
      simpa [K, relabel_symm_relabel] using h
    refine ⟨K, hKG, ⟨e.symm z, ?_⟩, ?_⟩
    · simpa [K] using (H.degree_relabel e.symm z).trans hz
    · intro v
      have hv := hdeg (e v)
      have hrel := H.degree_relabel e.symm (e v)
      have hrel' : K.degree v = H.degree (e v) := by
        simpa [K] using hrel
      rw [hrel']
      exact hv
  · rintro ⟨H, hpart, ⟨v, hv⟩, hdeg⟩
    refine ⟨H.relabel e, isPart_relabel e hpart, ⟨e v, ?_⟩, ?_⟩
    · simpa [H.degree_relabel e v] using hv
    · intro z
      obtain ⟨v, rfl⟩ := e.surjective z
      simpa [H.degree_relabel e v] using hdeg v

end Relabel

end

end Pseudograph
/-! ### A genuine finite minimal counterexample

All vertex types are transported to `Fin n` before minimizing.  Requiring
`0 < n` records the customary nonempty convention for regular graphs and
prevents the empty ambient type from becoming a vacuous quartic
counterexample. -/

def IsBadTashkinovOrder (n : ℕ) : Prop :=
  0 < n ∧ ∃ G : Pseudograph (Fin n),
    G.InTashkinovClass ∧ ¬ G.ContainsRegularPart 3

structure IsVertexMinimalCounterexample {n : ℕ}
    (G : Pseudograph (Fin n)) : Prop where
  positive_order : 0 < n
  in_class : G.InTashkinovClass
  no_cubic_part : ¬ G.ContainsRegularPart 3
  smaller : ∀ m, 0 < m → m < n → ∀ H : Pseudograph (Fin m),
    H.InTashkinovClass → H.ContainsRegularPart 3

theorem exists_vertexMinimalCounterexample
    {W : Type*} [Fintype W] [Nonempty W] (G : Pseudograph W)
    (hclass : G.InTashkinovClass)
    (hbad : ¬ G.ContainsRegularPart 3) :
    ∃ n, ∃ G₀ : Pseudograph (Fin n), IsVertexMinimalCounterexample G₀ := by
  classical
  have hex : ∃ n, IsBadTashkinovOrder n := by
    let e : W ≃ Fin (Fintype.card W) := Fintype.equivFin W
    refine ⟨Fintype.card W, Fintype.card_pos_iff.mpr inferInstance,
      G.relabel e, ?_, ?_⟩
    · exact (Pseudograph.inTashkinovClass_relabel_iff e G).mpr hclass
    · intro h
      exact hbad ((Pseudograph.containsRegularPart_relabel_iff e G 3).mp h)
  let n := Nat.find hex
  obtain ⟨hnpos, G₀, hG₀class, hG₀bad⟩ := Nat.find_spec hex
  refine ⟨n, G₀, hnpos, hG₀class, hG₀bad, ?_⟩
  intro m hmpos hmn H hHclass
  by_contra hHbad
  have hbadm : IsBadTashkinovOrder m :=
    ⟨hmpos, H, hHclass, hHbad⟩
  have hnm : n ≤ m := Nat.find_min' hex hbadm
  omega

lemma IsVertexMinimalCounterexample.contains_of_card_lt
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    {W : Type*} [Fintype W] [Nonempty W] (H : Pseudograph W)
    (hclass : H.InTashkinovClass) (hcard : Fintype.card W < n) :
    H.ContainsRegularPart 3 := by
  classical
  let m := Fintype.card W
  let e : W ≃ Fin m := Fintype.equivFin W
  have hmpos : 0 < m := Fintype.card_pos_iff.mpr inferInstance
  have hrelclass : (H.relabel e).InTashkinovClass :=
    (Pseudograph.inTashkinovClass_relabel_iff e H).mpr hclass
  have hrel := hmin.smaller m hmpos (by simpa [m] using hcard)
    (H.relabel e) hrelclass
  exact (Pseudograph.containsRegularPart_relabel_iff e H 3).mp hrel

lemma induce_underlyingComponent_isRegularOfDegree
    {W : Type*} [Fintype W] (G : Pseudograph W)
    (hreg : G.IsRegularOfDegree 4) (c : G.toSimple.ConnectedComponent)
    (S : Finset W) (hS : ∀ v, v ∈ S ↔ v ∈ c.supp) :
    (G.induce S).IsRegularOfDegree 4 := by
  classical
  intro v
  have hvSupp : (v : W) ∈ c.supp := (hS v).mp v.2
  have hout : G.outsideDegree S v = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro w hw
    have hwNot : w ∉ S := Finset.mem_compl.mp hw
    by_contra hmult
    have hvw : (v : W) ≠ w := by
      intro h
      subst w
      exact hwNot ((hS v).mpr hvSupp)
    have hadj : G.toSimple.Adj (v : W) w :=
      ⟨hvw, Nat.pos_of_ne_zero hmult⟩
    have hwSupp : w ∈ c.supp :=
      c.mem_supp_of_adj_mem_supp hvSupp hadj
    exact hwNot ((hS w).mpr hwSupp)
  have hdegree := G.degree_induce_add_outsideDegree
    S v v.2
  rw [hout, Nat.add_zero, hreg v] at hdegree
  exact hdegree

/-- Proposition 2.1: the underlying graph of a vertex-minimal bad member of
Tashkinov's class is connected. -/
theorem IsVertexMinimalCounterexample.underlying_connected
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G) : G.toSimple.Connected := by
  classical
  haveI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  by_contra hnot
  rw [SimpleGraph.connected_iff_exists_forall_reachable] at hnot
  push_neg at hnot
  let v : Fin n := Classical.choice inferInstance
  obtain ⟨w, hw⟩ := hnot v
  let c : G.toSimple.ConnectedComponent := G.toSimple.connectedComponentMk v
  let S : Finset (Fin n) := c.supp.toFinset
  have hvS : v ∈ S := by
    simpa [S, c] using
      (SimpleGraph.ConnectedComponent.connectedComponentMk_mem
        (G := G.toSimple) (v := v))
  have hwNotS : w ∉ S := by
    intro hwS
    have hwSupp : w ∈ c.supp := by simpa [S] using hwS
    have hcomp : G.toSimple.connectedComponentMk w = c :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff c w).mp hwSupp
    have hreach : G.toSimple.Reachable v w := by
      rw [← SimpleGraph.ConnectedComponent.eq]
      simpa [c] using hcomp.symm
    exact hw hreach
  have hSproper : S ≠ Finset.univ := by
    intro h
    exact hwNotS (by rw [h]; simp)
  have hcard : Fintype.card S < n := by
    rw [Fintype.card_coe]
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ S, hSproper⟩)
    simpa using hlt
  let H := G.induce S
  have hHreg : H.IsRegularOfDegree 4 := by
    exact induce_underlyingComponent_isRegularOfDegree G
      hmin.in_class.1 c S (fun x ↦ by simp [S])
  have hHclass : H.InTashkinovClass :=
    G.induce_inTashkinovClass S hmin.in_class hHreg
  letI : Nonempty S := ⟨⟨v, hvS⟩⟩
  have hHpart : H.ContainsRegularPart 3 :=
    hmin.contains_of_card_lt H hHclass hcard
  exact hmin.no_cubic_part
    (Pseudograph.containsRegularPart_of_induce G S hHpart)

namespace Pseudograph

variable {W : Type*} [Fintype W]

/-- Matrix-level simplicity, convenient before identifying a pseudograph
definitionally with its underlying `SimpleGraph`. -/
def HasSimpleMultiplicities (G : Pseudograph W) : Prop :=
  (∀ v, G.mult v v = 0) ∧ ∀ u v, G.mult u v ≤ 1

lemma eq_ofSimple_toSimple_of_hasSimpleMultiplicities
    (G : Pseudograph W) (h : G.HasSimpleMultiplicities) :
    ofSimple G.toSimple = G := by
  apply Pseudograph.ext
  intro u v
  by_cases huv : u = v
  · subst v
    simp [h.1 u]
  · simp only [ofSimple_mult, toSimple_adj]
    by_cases hpos : 0 < G.mult u v
    · rw [if_pos ⟨huv, hpos⟩]
      have hle := h.2 u v
      omega
    · rw [if_neg]
      · omega
      · intro hbad
        exact hpos hbad.2

lemma induce_hasSimpleMultiplicities (G : Pseudograph W)
    (h : G.HasSimpleMultiplicities) (S : Finset W) :
    (G.induce S).HasSimpleMultiplicities := by
  exact ⟨fun v ↦ h.1 v, fun u v ↦ h.2 u v⟩

/-- If one loop and one parallel pair already consume the whole defect
budget of a class-`B` graph, the complement of their endpoints is simple. -/
lemma induce_compl_hasSimpleMultiplicities_of_loop_and_parallel
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (hloop : 0 < G.mult u u)
    (hparallel : 2 ≤ G.mult u v) :
    (G.induce ({u, v} : Finset W)ᶜ).HasSimpleMultiplicities := by
  classical
  let S : Finset W := ({u, v} : Finset W)ᶜ
  have hcLoop := hclass.2.1
  have hcDefect := hclass.2.2
  have hloopCount : G.loopCount = 1 := by
    have hu := G.mult_self_le_loopCount u
    omega
  have hpairCount : G.parallelPairCount = 1 := by
    have hp := G.one_le_parallelPairCount_of_two_le_mult huv hparallel
    omega
  have hdiag (x : S) : (G.induce S).mult x x = 0 := by
    by_contra hx
    have hxpos : 0 < G.mult x x := Nat.pos_of_ne_zero hx
    have hxu : (x : W) ≠ u := by
      intro h
      have hxnot : (x : W) ∉ ({u, v} : Finset W) :=
        Finset.mem_compl.mp x.2
      exact hxnot (by simp [h])
    have hsum := G.mult_self_add_mult_self_le_loopCount hxu.symm
    rw [hloopCount] at hsum
    omega
  refine ⟨hdiag, ?_⟩
  intro x y
  by_cases hxy : x = y
  · subst y
    rw [hdiag]
    omega
  change G.mult x y ≤ 1
  by_contra hnot
  have hxyTwo : 2 ≤ G.mult x y := by omega
  have hxu : (x : W) ≠ u := by
    intro h
    exact (Finset.mem_compl.mp x.2) (by simp [h])
  have hxv : (x : W) ≠ v := by
    intro h
    exact (Finset.mem_compl.mp x.2) (by simp [h])
  have hne₁ : (u, v) ≠ ((x : W), (y : W)) := by
    intro h
    exact hxu (congrArg Prod.fst h).symm
  have hne₂ : (u, v) ≠ ((y : W), (x : W)) := by
    intro h
    exact hxv (congrArg Prod.snd h).symm
  have htwo := G.two_le_parallelPairCount_of_two_distinct_pairs
    huv (by exact_mod_cast hxy) hparallel hxyTwo hne₁ hne₂
  rw [hpairCount] at htwo
  omega

/-- Two distinct parallel pairs through a vertex outside a shore exhaust
the class-`B` defect budget, so the induced shore is simple. -/
lemma induce_hasSimpleMultiplicities_of_two_parallel_star_outside
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    (S : Finset W) {u v z : W} (hu : u ∉ S)
    (huv : u ≠ v) (huz : u ≠ z) (hvz : v ≠ z)
    (huvParallel : 2 ≤ G.mult u v)
    (huzParallel : 2 ≤ G.mult u z) :
    (G.induce S).HasSimpleMultiplicities := by
  have hne₁ : (u, v) ≠ (u, z) := by
    intro h
    exact hvz (congrArg Prod.snd h)
  have hne₂ : (u, v) ≠ (z, u) := by
    intro h
    exact huz (congrArg Prod.fst h)
  have htwo := G.two_le_parallelPairCount_of_two_distinct_pairs
    huv huz huvParallel huzParallel hne₁ hne₂
  have hpEq : G.parallelPairCount = 2 := by
    have hc := hclass.2.2
    omega
  have hlEq : G.loopCount = 0 := by
    have hc := hclass.2.2
    omega
  have hpInd :=
    G.parallelPairCount_induce_add_two_le_of_parallel_star_outside
      S hu huv huz hvz huvParallel huzParallel
  have hpIndEq : (G.induce S).parallelPairCount = 0 := by omega
  refine ⟨?_, ?_⟩
  · intro x
    exact G.mult_self_eq_zero_of_loopCount_eq_zero hlEq x
  · intro x y
    by_cases hxy : x = y
    · subst y
      change G.mult x x ≤ 1
      rw [G.mult_self_eq_zero_of_loopCount_eq_zero hlEq]
      omega
    · exact (G.induce S).mult_le_one_of_parallelPairCount_eq_zero
        hpIndEq hxy

/-- A loop and a distinct parallel pair outside a shore exhaust the class
`B` defect budget, so the induced shore is simple. -/
lemma induce_hasSimpleMultiplicities_of_loop_and_parallel_outside
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    (S : Finset W) {a u v : W}
    (ha : a ∉ S) (hu : u ∉ S) (hv : v ∉ S)
    (huv : u ≠ v) (hloop : 0 < G.mult a a)
    (hparallel : 2 ≤ G.mult u v) :
    (G.induce S).HasSimpleMultiplicities := by
  have hloopLower := G.mult_self_le_loopCount a
  have hpairLower := G.one_le_parallelPairCount_of_two_le_mult huv hparallel
  have hdefect := hclass.2.2
  have hloopEq : G.loopCount = 1 := by omega
  have hpairEq : G.parallelPairCount = 1 := by omega
  have hpInd := G.parallelPairCount_induce_add_one_le_of_parallel_outside
    S hu hv huv hparallel
  have hpIndEq : (G.induce S).parallelPairCount = 0 := by omega
  refine ⟨?_, ?_⟩
  · intro x
    by_contra hx
    have hxpos : 0 < G.mult x x := Nat.pos_of_ne_zero hx
    have hxa : (x : W) ≠ a := by
      intro h
      exact ha (h ▸ x.2)
    have hsum := G.mult_self_add_mult_self_le_loopCount hxa
    rw [hloopEq] at hsum
    omega
  · intro x y
    by_cases hxy : x = y
    · subst y
      change G.mult x x ≤ 1
      have hx := G.mult_self_le_loopCount x
      rw [hloopEq] at hx
      exact hx
    · exact (G.induce S).mult_le_one_of_parallelPairCount_eq_zero
        hpIndEq hxy

/-- Two distinct parallel pairs wholly outside a shore exhaust the class
`B` defect budget, so the induced shore is simple. -/
lemma induce_hasSimpleMultiplicities_of_two_parallel_pairs_outside
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    (S : Finset W) {a b c d : W}
    (ha : a ∉ S) (hb : b ∉ S) (hc : c ∉ S)
    (hab : a ≠ b) (hcd : c ≠ d)
    (habParallel : 2 ≤ G.mult a b) (hcdParallel : 2 ≤ G.mult c d)
    (hne₁ : (a, b) ≠ (c, d)) (hne₂ : (a, b) ≠ (d, c)) :
    (G.induce S).HasSimpleMultiplicities := by
  have hp := G.parallelPairCount_induce_add_two_le_of_two_parallel_pairs_outside
    S ha hb hc hab hcd habParallel hcdParallel hne₁ hne₂
  have hcDefect := hclass.2.2
  have hlEq : G.loopCount = 0 := by omega
  have hpIndEq : (G.induce S).parallelPairCount = 0 := by omega
  refine ⟨?_, ?_⟩
  · intro x
    change G.mult x x = 0
    exact G.mult_self_eq_zero_of_loopCount_eq_zero hlEq x
  · intro x y
    by_cases hxy : x = y
    · subst y
      change G.mult x x ≤ 1
      rw [G.mult_self_eq_zero_of_loopCount_eq_zero hlEq]
      omega
    · exact (G.induce S).mult_le_one_of_parallelPairCount_eq_zero
        hpIndEq hxy

lemma loopVertexCount_add_singleEdge_le_one
    (H : Pseudograph W) (hloop : ∀ v, H.mult v v = 0)
    (a b : W) : (H + singleEdge a b).loopVertexCount ≤ 1 := by
  classical
  unfold loopVertexCount
  apply Finset.card_le_one.mpr
  intro x hx y hy
  have hx' : 0 < (H + singleEdge a b).mult x x :=
    (Finset.mem_filter.mp hx).2
  have hy' : 0 < (H + singleEdge a b).mult y y :=
    (Finset.mem_filter.mp hy).2
  have hxa : x = a := by
    rw [add_mult, hloop x, Nat.zero_add, singleEdge_mult] at hx'
    have hcond : (x = a ∧ x = b) ∨ (x = b ∧ x = a) := by
      by_contra h
      rw [if_neg h] at hx'
      omega
    exact hcond.elim And.left And.right
  have hya : y = a := by
    rw [add_mult, hloop y, Nat.zero_add, singleEdge_mult] at hy'
    have hcond : (y = a ∧ y = b) ∨ (y = b ∧ y = a) := by
      by_contra h
      rw [if_neg h] at hy'
      omega
    exact hcond.elim And.left And.right
  exact hxa.trans hya.symm

lemma loopCount_add_singleEdge_le_one
    (H : Pseudograph W) (hloop : ∀ v, H.mult v v = 0)
    (a b : W) : (H + singleEdge a b).loopCount ≤ 1 := by
  classical
  unfold loopCount
  by_cases hab : a = b
  · subst b
    simp [add_mult, hloop, singleEdge_mult]
  · have hedge (v : W) : (singleEdge a b).mult v v = 0 := by
      rw [singleEdge_mult, if_neg]
      intro h
      rcases h with ⟨hva, hvb⟩ | ⟨hvb, hva⟩
      · exact hab (hva.symm.trans hvb)
      · exact hab (hva.symm.trans hvb)
    simp only [add_mult, hloop, hedge, Nat.zero_add, Finset.sum_const_zero]
    omega

lemma parallelPairCount_add_singleEdge_le_one
    (H : Pseudograph W) (hsimple : ∀ u v, H.mult u v ≤ 1)
    (a b : W) : (H + singleEdge a b).parallelPairCount ≤ 1 := by
  classical
  let F := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ (H + singleEdge a b).mult p.1 p.2
  have hsub : F ⊆ ({(a, b), (b, a)} : Finset (W × W)) := by
    intro p hp
    have hp' : p.1 ≠ p.2 ∧
        2 ≤ (H + singleEdge a b).mult p.1 p.2 := by
      simpa only [F, Finset.mem_filter, Finset.mem_univ, true_and] using hp
    have hbase := hsimple p.1 p.2
    have hedge :
        (p.1 = a ∧ p.2 = b) ∨ (p.1 = b ∧ p.2 = a) := by
      by_contra h
      have hedge0 : (singleEdge a b).mult p.1 p.2 = 0 := by
        simp [singleEdge_mult, h]
      have hlarge := hp'.2
      rw [add_mult, hedge0, Nat.add_zero] at hlarge
      omega
    simp only [Finset.mem_insert, Finset.mem_singleton]
    rcases hedge with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · left
      exact Prod.ext h1 h2
    · right
      exact Prod.ext h1 h2
  have hcard : F.card ≤ 2 := by
    calc
      F.card ≤ ({(a, b), (b, a)} : Finset (W × W)).card :=
        Finset.card_le_card hsub
      _ ≤ 2 := Finset.card_le_two
  unfold parallelPairCount
  change F.card / 2 ≤ 1
  omega

lemma parallelPairCount_eq_zero_of_hasSimpleMultiplicities
    (H : Pseudograph W) (hsimple : H.HasSimpleMultiplicities) :
    H.parallelPairCount = 0 := by
  classical
  have hfilter :
      Finset.univ.filter (fun p : W × W ↦
        p.1 ≠ p.2 ∧ 2 ≤ H.mult p.1 p.2) = ∅ := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.notMem_empty, iff_false, not_and]
    intro _
    have := hsimple.2 p.1 p.2
    omega
  unfold parallelPairCount
  rw [hfilter]
  simp

/-- The off-diagonal half of simple multiplicities is already enough to
make the parallel-pair defect vanish; loops play no role in this count. -/
lemma parallelPairCount_eq_zero_of_mult_le_one
    (H : Pseudograph W) (hparallel : ∀ u v, u ≠ v → H.mult u v ≤ 1) :
    H.parallelPairCount = 0 := by
  classical
  have hfilter :
      Finset.univ.filter (fun p : W × W ↦
        p.1 ≠ p.2 ∧ 2 ≤ H.mult p.1 p.2) = ∅ := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.notMem_empty, iff_false, not_and]
    intro hp
    have := hparallel p.1 p.2 hp
    omega
  unfold parallelPairCount
  rw [hfilter]
  simp

lemma parallelPairCount_add_loop (H : Pseudograph W) (a : W) :
    (H + singleEdge a a).parallelPairCount = H.parallelPairCount := by
  classical
  have hfilter :
      Finset.univ.filter (fun p : W × W ↦ p.1 ≠ p.2 ∧
        2 ≤ (H + singleEdge a a).mult p.1 p.2) =
      Finset.univ.filter (fun p : W × W ↦ p.1 ≠ p.2 ∧
        2 ≤ H.mult p.1 p.2) := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    by_cases hp : p.1 = p.2
    · simp [hp]
    · have hedge : (singleEdge a a).mult p.1 p.2 = 0 := by
        rw [singleEdge_mult, if_neg]
        intro h
        rcases h with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
        · exact hp (h₁.trans h₂.symm)
        · exact hp (h₁.trans h₂.symm)
      rw [add_mult, hedge, Nat.add_zero]
  unfold parallelPairCount
  rw [hfilter]

lemma parallelPairCount_add_singleEdge_eq_of_mult_eq_zero
    (H : Pseudograph W) {a b : W} (hab : a ≠ b)
    (hzero : H.mult a b = 0) :
    (H + singleEdge a b).parallelPairCount = H.parallelPairCount := by
  classical
  have hfilter :
      Finset.univ.filter (fun p : W × W ↦ p.1 ≠ p.2 ∧
        2 ≤ (H + singleEdge a b).mult p.1 p.2) =
      Finset.univ.filter (fun p : W × W ↦ p.1 ≠ p.2 ∧
        2 ≤ H.mult p.1 p.2) := by
    ext p
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    by_cases hshape : (p.1 = a ∧ p.2 = b) ∨
        (p.1 = b ∧ p.2 = a)
    · rcases hshape with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
      · rw [h₁, h₂]
        simp [add_mult, hzero, hab]
      · have hzero' : H.mult b a = 0 := by
          simpa only [H.mult_comm] using hzero
        rw [h₁, h₂]
        simp [add_mult, hzero', hab]
    · rw [add_mult, singleEdge_mult, if_neg hshape, Nat.add_zero]
  unfold parallelPairCount
  rw [hfilter]

/-- If a pseudograph has defect at most one, adding two fresh, distinct
nonloop edges produces another member of Tashkinov's class. -/
lemma add_two_fresh_nonloop_edges_inTashkinovClass
    (H : Pseudograph W)
    (hdefect : H.loopCount + H.parallelPairCount ≤ 1)
    {a b c d : W} (hab : a ≠ b) (hcd : c ≠ d)
    (habZero : H.mult a b = 0) (hcdZero : H.mult c d = 0)
    (hne₁ : (a, b) ≠ (c, d)) (hne₂ : (a, b) ≠ (d, c))
    (hreg : ((H + singleEdge a b) + singleEdge c d).IsRegularOfDegree 4) :
    ((H + singleEdge a b) + singleEdge c d).InTashkinovClass := by
  have hshape : ¬((c = a ∧ d = b) ∨ (c = b ∧ d = a)) := by
    intro h
    rcases h with ⟨hca, hdb⟩ | ⟨hcb, hda⟩
    · exact hne₁ (Prod.ext hca.symm hdb.symm)
    · exact hne₂ (Prod.ext hda.symm hcb.symm)
  have hcdZero' : (H + singleEdge a b).mult c d = 0 := by
    rw [add_mult, hcdZero, singleEdge_mult, if_neg hshape]
  have hp₁ := parallelPairCount_add_singleEdge_eq_of_mult_eq_zero
    H hab habZero
  have hp₂ := parallelPairCount_add_singleEdge_eq_of_mult_eq_zero
    (H + singleEdge a b) hcd hcdZero'
  have hp : ((H + singleEdge a b) + singleEdge c d).parallelPairCount =
      H.parallelPairCount := hp₂.trans hp₁
  have hl : ((H + singleEdge a b) + singleEdge c d).loopCount =
      H.loopCount := by
    rw [loopCount_add, loopCount_add, loopCount_singleEdge,
      loopCount_singleEdge, if_neg hab, if_neg hcd]
    omega
  refine ⟨hreg, ?_, ?_⟩
  · rw [hl]
    omega
  · rw [hl, hp]
    omega

/-- A bad two-edge closure over a defect-at-most-one base has a local
reason: a loop, an existing base edge, or coincidence of the two unordered
closing pairs. -/
lemma local_obstruction_of_add_two_edges_not_inTashkinovClass
    (H : Pseudograph W)
    (hdefect : H.loopCount + H.parallelPairCount ≤ 1)
    {a b c d : W}
    (hreg : ((H + singleEdge a b) + singleEdge c d).IsRegularOfDegree 4)
    (hbad : ¬((H + singleEdge a b) + singleEdge c d).InTashkinovClass) :
    a = b ∨ c = d ∨ 0 < H.mult a b ∨ 0 < H.mult c d ∨
      (a, b) = (c, d) ∨ (a, b) = (d, c) := by
  by_contra h
  push Not at h
  have habZero : H.mult a b = 0 := by omega
  have hcdZero : H.mult c d = 0 := by omega
  exact hbad (add_two_fresh_nonloop_edges_inTashkinovClass H hdefect
    h.1 h.2.1 habZero hcdZero h.2.2.2.2.1 h.2.2.2.2.2 hreg)

lemma parallelPairCount_add_singleEdge_le_add_one
    (H : Pseudograph W) (a b : W) :
    (H + singleEdge a b).parallelPairCount ≤ H.parallelPairCount + 1 := by
  classical
  let R := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ (H + singleEdge a b).mult p.1 p.2
  let B := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ H.mult p.1 p.2
  let T : Finset (W × W) := {(a, b), (b, a)}
  have hsub : R ⊆ B ∪ T := by
    intro p hp
    have hpR : p.1 ≠ p.2 ∧
        2 ≤ (H + singleEdge a b).mult p.1 p.2 := by
      simpa only [R, Finset.mem_filter, Finset.mem_univ, true_and] using hp
    by_cases hpB : p ∈ B
    · exact Finset.mem_union_left _ hpB
    · apply Finset.mem_union_right
      have hbase : H.mult p.1 p.2 ≤ 1 := by
        simp only [B, Finset.mem_filter, Finset.mem_univ, true_and,
          not_and] at hpB
        have := hpB hpR.1
        omega
      have hedgePos : 0 < (singleEdge a b).mult p.1 p.2 := by
        rw [add_mult] at hpR
        omega
      have hshape : (p.1 = a ∧ p.2 = b) ∨
          (p.1 = b ∧ p.2 = a) := by
        by_contra h
        rw [singleEdge_mult, if_neg h] at hedgePos
        omega
      rcases hshape with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
      · simp only [T, Finset.mem_insert, Finset.mem_singleton]
        exact .inl (Prod.ext h₁ h₂)
      · simp only [T, Finset.mem_insert, Finset.mem_singleton]
        exact .inr (Prod.ext h₁ h₂)
  have hcard : R.card ≤ B.card + 2 := by
    calc
      R.card ≤ (B ∪ T).card := Finset.card_le_card hsub
      _ ≤ B.card + T.card := Finset.card_union_le B T
      _ ≤ B.card + 2 := Nat.add_le_add_left Finset.card_le_two B.card
  unfold parallelPairCount
  change R.card / 2 ≤ B.card / 2 + 1
  omega

lemma parallelPairCount_add_two_singleEdges_le_add_two
    (H : Pseudograph W) (a b c d : W) :
    ((H + singleEdge a b) + singleEdge c d).parallelPairCount ≤
      H.parallelPairCount + 2 := by
  have h₁ := parallelPairCount_add_singleEdge_le_add_one H a b
  have h₂ := parallelPairCount_add_singleEdge_le_add_one
    (H + singleEdge a b) c d
  omega

lemma parallelPairCount_add_two_sameEdge_le_add_one
    (H : Pseudograph W) (a b : W) :
    ((H + singleEdge a b) + singleEdge a b).parallelPairCount ≤
      H.parallelPairCount + 1 := by
  classical
  let R := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ ((H + singleEdge a b) + singleEdge a b).mult p.1 p.2
  let B := Finset.univ.filter fun p : W × W ↦
    p.1 ≠ p.2 ∧ 2 ≤ H.mult p.1 p.2
  let T : Finset (W × W) := {(a, b), (b, a)}
  have hsub : R ⊆ B ∪ T := by
    intro p hp
    have hpR : p.1 ≠ p.2 ∧
        2 ≤ ((H + singleEdge a b) + singleEdge a b).mult p.1 p.2 := by
      simpa only [R, Finset.mem_filter, Finset.mem_univ, true_and] using hp
    by_cases hpB : p ∈ B
    · exact Finset.mem_union_left _ hpB
    · apply Finset.mem_union_right
      have hshape : (p.1 = a ∧ p.2 = b) ∨
          (p.1 = b ∧ p.2 = a) := by
        by_contra h
        have hedge : (singleEdge a b).mult p.1 p.2 = 0 := by
          rw [singleEdge_mult, if_neg h]
        simp only [add_mult, hedge, Nat.add_zero] at hpR
        have hpNot : ¬(p.1 ≠ p.2 ∧ 2 ≤ H.mult p.1 p.2) := by
          simpa only [B, Finset.mem_filter, Finset.mem_univ, true_and] using hpB
        exact hpNot hpR
      rcases hshape with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
      · have hpEq : p = (a, b) := Prod.ext h₁ h₂
        simp [T, hpEq]
      · have hpEq : p = (b, a) := Prod.ext h₁ h₂
        simp [T, hpEq]
  have hcard : R.card ≤ B.card + 2 := by
    calc
      R.card ≤ (B ∪ T).card := Finset.card_le_card hsub
      _ ≤ B.card + T.card := Finset.card_union_le B T
      _ ≤ B.card + 2 := Nat.add_le_add_left Finset.card_le_two B.card
  unfold parallelPairCount
  change R.card / 2 ≤ B.card / 2 + 1
  omega

lemma add_two_same_nonloop_edges_inTashkinovClass
    (H : Pseudograph W)
    (hdefect : H.loopCount + H.parallelPairCount ≤ 1)
    {a b : W} (hab : a ≠ b)
    (hreg : ((H + singleEdge a b) + singleEdge a b).IsRegularOfDegree 4) :
    ((H + singleEdge a b) + singleEdge a b).InTashkinovClass := by
  have hp := parallelPairCount_add_two_sameEdge_le_add_one H a b
  have hl : ((H + singleEdge a b) + singleEdge a b).loopCount = H.loopCount := by
    rw [loopCount_add, loopCount_add, loopCount_singleEdge, if_neg hab]
    omega
  refine ⟨hreg, ?_, ?_⟩
  · rw [hl]
    omega
  · rw [hl]
    omega

lemma add_two_distinct_nonloop_edges_inTashkinovClass_of_one_fresh
    (H : Pseudograph W)
    (hdefect : H.loopCount + H.parallelPairCount ≤ 1)
    {a b c d : W} (hab : a ≠ b) (hcd : c ≠ d)
    (hne₁ : (a, b) ≠ (c, d)) (hne₂ : (a, b) ≠ (d, c))
    (hfresh : H.mult a b = 0 ∨ H.mult c d = 0)
    (hreg : ((H + singleEdge a b) + singleEdge c d).IsRegularOfDegree 4) :
    ((H + singleEdge a b) + singleEdge c d).InTashkinovClass := by
  have hshape : ¬((c = a ∧ d = b) ∨ (c = b ∧ d = a)) := by
    intro h
    rcases h with ⟨hca, hdb⟩ | ⟨hcb, hda⟩
    · exact hne₁ (Prod.ext hca.symm hdb.symm)
    · exact hne₂ (Prod.ext hda.symm hcb.symm)
  have hp : ((H + singleEdge a b) + singleEdge c d).parallelPairCount ≤
      H.parallelPairCount + 1 := by
    rcases hfresh with habZero | hcdZero
    · have hp₁ := parallelPairCount_add_singleEdge_eq_of_mult_eq_zero
        H hab habZero
      have hp₂ := parallelPairCount_add_singleEdge_le_add_one
        (H + singleEdge a b) c d
      rw [hp₁] at hp₂
      exact hp₂
    · have hcdZero' : (H + singleEdge a b).mult c d = 0 := by
        rw [add_mult, hcdZero, singleEdge_mult, if_neg hshape]
      have hp₁ := parallelPairCount_add_singleEdge_le_add_one H a b
      have hp₂ := parallelPairCount_add_singleEdge_eq_of_mult_eq_zero
        (H + singleEdge a b) hcd hcdZero'
      rw [hp₂]
      exact hp₁
  have hl : ((H + singleEdge a b) + singleEdge c d).loopCount = H.loopCount := by
    rw [loopCount_add, loopCount_add, loopCount_singleEdge,
      loopCount_singleEdge, if_neg hab, if_neg hcd]
    omega
  refine ⟨hreg, ?_, ?_⟩
  · rw [hl]
    omega
  · rw [hl]
    omega

/-- Adding two closing edges to a simple multiplicity matrix stays in class
`B` unless both added edges are loops. -/
lemma add_two_singleEdges_inTashkinovClass_of_hasSimpleMultiplicities
    (H : Pseudograph W) (hsimple : H.HasSimpleMultiplicities)
    (a b c d : W)
    (hreg : ((H + singleEdge a b) + singleEdge c d).IsRegularOfDegree 4)
    (hnotTwoLoops : ¬(a = b ∧ c = d)) :
    ((H + singleEdge a b) + singleEdge c d).InTashkinovClass := by
  have hloopH : H.loopCount = 0 := by
    unfold loopCount
    simp [hsimple.1]
  have hparallelH : H.parallelPairCount = 0 :=
    parallelPairCount_eq_zero_of_hasSimpleMultiplicities H hsimple
  have hloop : ((H + singleEdge a b) + singleEdge c d).loopCount ≤ 1 := by
    rw [loopCount_add, loopCount_add, loopCount_singleEdge,
      loopCount_singleEdge, hloopH]
    by_cases hab : a = b <;> by_cases hcd : c = d <;>
      simp [hab, hcd] at hnotTwoLoops ⊢
  have hparallel :
      ((H + singleEdge a b) + singleEdge c d).parallelPairCount ≤
        if a = b ∨ c = d then 1 else 2 := by
    by_cases hab : a = b
    · subst b
      have h := parallelPairCount_add_singleEdge_le_add_one
        (H + singleEdge a a) c d
      rw [parallelPairCount_add_loop H a] at h
      simpa [hparallelH] using h
    · by_cases hcd : c = d
      · subst d
        rw [parallelPairCount_add_loop (H + singleEdge a b) c]
        have h := parallelPairCount_add_singleEdge_le_add_one H a b
        simpa [hab, hparallelH] using h
      · simp [hab, hcd]
        simpa [hparallelH] using
          parallelPairCount_add_two_singleEdges_le_add_two H a b c d
  refine ⟨hreg, hloop, ?_⟩
  by_cases haddedLoop : a = b ∨ c = d
  · have hp : ((H + singleEdge a b) + singleEdge c d).parallelPairCount ≤ 1 := by
      simpa [haddedLoop] using hparallel
    omega
  · have hlzero : ((H + singleEdge a b) + singleEdge c d).loopCount = 0 := by
      rw [loopCount_add, loopCount_add, loopCount_singleEdge,
        loopCount_singleEdge, hloopH]
      simp only [Nat.zero_add]
      push_neg at haddedLoop
      simp [haddedLoop]
    have hp : ((H + singleEdge a b) + singleEdge c d).parallelPairCount ≤ 2 := by
      simpa [haddedLoop] using hparallel
    omega

lemma closeTwoCut_inTashkinovClass_of_hasSimpleMultiplicities
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 2) :
    (G.closeTwoCut S hcut).InTashkinovClass := by
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  have hbase := G.induce_hasSimpleMultiplicities hsimple S
  refine ⟨G.closeTwoCut_isRegularOfDegree S hcut hreg, ?_, ?_⟩
  · simpa [closeTwoCut, a, b] using
      loopCount_add_singleEdge_le_one (G.induce S) hbase.1 a b
  · have hl : (G.closeTwoCut S hcut).loopCount ≤ 1 := by
      simpa [closeTwoCut, a, b] using
        loopCount_add_singleEdge_le_one (G.induce S) hbase.1 a b
    have hp : (G.closeTwoCut S hcut).parallelPairCount ≤ 1 := by
      simpa [closeTwoCut, a, b] using
        parallelPairCount_add_singleEdge_le_one (G.induce S) hbase.2 a b
    omega

lemma closeTwoCut_inTashkinovClass_of_induce_hasSimpleMultiplicities
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 2)
    (hbase : (G.induce S).HasSimpleMultiplicities) :
    (G.closeTwoCut S hcut).InTashkinovClass := by
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  refine ⟨G.closeTwoCut_isRegularOfDegree S hcut hreg, ?_, ?_⟩
  · simpa [closeTwoCut, a, b] using
      loopCount_add_singleEdge_le_one (G.induce S) hbase.1 a b
  · have hl : (G.closeTwoCut S hcut).loopCount ≤ 1 := by
      simpa [closeTwoCut, a, b] using
        loopCount_add_singleEdge_le_one (G.induce S) hbase.1 a b
    have hp : (G.closeTwoCut S hcut).parallelPairCount ≤ 1 := by
      simpa [closeTwoCut, a, b] using
        parallelPairCount_add_singleEdge_le_one (G.induce S) hbase.2 a b
    omega

/-- A nonloop closing edge preserves class `B` whenever the induced shore
has at most one total loop/parallel defect. -/
lemma closeTwoCut_inTashkinovClass_of_defect_le_one_of_endpoints_ne
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 2)
    (hdefect : (G.induce S).loopCount +
      (G.induce S).parallelPairCount ≤ 1)
    (hne : (twoCutEdge G S hcut 0).inside ≠
      (twoCutEdge G S hcut 1).inside) :
    (G.closeTwoCut S hcut).InTashkinovClass := by
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside, (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside, (twoCutEdge G S hcut 1).inside_mem⟩
  have hab : a ≠ b := by
    intro h
    exact hne (congrArg Subtype.val h)
  have hp := parallelPairCount_add_singleEdge_le_add_one
    (G.induce S) a b
  have hl : (G.closeTwoCut S hcut).loopCount =
      (G.induce S).loopCount := by
    simp [closeTwoCut, a, b, loopCount_add, loopCount_singleEdge, hab]
  refine ⟨G.closeTwoCut_isRegularOfDegree S hcut hreg, ?_, ?_⟩
  · rw [hl]
    omega
  · have hp' : (G.closeTwoCut S hcut).parallelPairCount ≤
        (G.induce S).parallelPairCount + 1 := by
      simpa [closeTwoCut, a, b] using (show
      (G.induce S + singleEdge a b).parallelPairCount ≤
        (G.induce S).parallelPairCount + 1 from hp)
    rw [hl]
    omega

/-- If the two boundary incidences of a two-cut occur once at each of two
distinct shore vertices, the artificial closing edge joins exactly those
vertices. -/
lemma closeTwoCut_endpoints_and_mult_of_two_unit_outsideDegrees
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 2) {a b : W}
    (haS : a ∈ S) (hbS : b ∈ S) (hab : a ≠ b)
    (houtA : G.outsideDegree S a = 1)
    (houtB : G.outsideDegree S b = 1) :
    (twoCutEdge G S hcut 0).inside ≠
        (twoCutEdge G S hcut 1).inside ∧
      (G.closeTwoCut S hcut).mult ⟨a, haS⟩ ⟨b, hbS⟩ =
        G.mult a b + 1 := by
  classical
  let e0 := (twoCutEdge G S hcut 0).inside
  let e1 := (twoCutEdge G S hcut 1).inside
  have ha := G.outsideDegree_eq_twoCutEndpointCount S hcut a haS
  have hb := G.outsideDegree_eq_twoCutEndpointCount S hcut b hbS
  rw [houtA] at ha
  rw [houtB] at hb
  have hends : (e0 = a ∧ e1 = b) ∨ (e0 = b ∧ e1 = a) := by
    by_cases h0a : e0 = a <;> by_cases h1a : e1 = a <;>
      by_cases h0b : e0 = b <;> by_cases h1b : e1 = b <;>
      simp [e0, e1, h0a, h1a, h0b, h1b] at ha hb ⊢ <;>
      aesop
  constructor
  · intro heq
    rcases hends with ⟨h0a, h1b⟩ | ⟨h0b, h1a⟩
    · exact hab (h0a.symm.trans (heq.trans h1b))
    · exact hab (h1a.symm.trans (heq.symm.trans h0b))
  · rcases hends with ⟨h0a, h1b⟩ | ⟨h0b, h1a⟩
    · simp [closeTwoCut, singleEdge_mult, e0, e1, h0a, h1b,
        Subtype.ext_iff]
    · simp [closeTwoCut, singleEdge_mult, e0, e1, h0b, h1a,
        Subtype.ext_iff, G.mult_comm, hab]

/-- The two-vertex shore formed by a looped endpoint and a parallel pair
has a two-cut closure with an explicit cubic part: retain one loop at each
endpoint and one copy of the joining edge. -/
lemma exists_loop_double_twoCut_cubicClosure
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    {u v : W} (huv : u ≠ v) (huLoop : 0 < G.mult u u)
    (hvLoop : G.mult v v = 0) (huvTwo : 2 ≤ G.mult u v) :
    ∃ hcut : G.boundaryMultiplicity ({u, v} : Finset W) = 2,
      (G.closeTwoCut {u, v} hcut).ContainsRegularPart 3 := by
  classical
  let S : Finset W := {u, v}
  let us : S := ⟨u, by simp [S]⟩
  let vs : S := ⟨v, by simp [S]⟩
  have huvs : us ≠ vs := by
    intro h
    exact huv (congrArg Subtype.val h)
  have hcard : Fintype.card S = 2 := by
    rw [Fintype.card_coe]
    simp [S, huv]
  have hterm : G.mult u u + G.mult u v ≤ ∑ w, G.mult u w := by
    calc
      G.mult u u + G.mult u v =
          ∑ w ∈ ({u, v} : Finset W), G.mult u w := by simp [huv]
      _ ≤ ∑ w ∈ (Finset.univ : Finset W), G.mult u w :=
        Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hdu := hreg u
  rw [degree_eq_mult_self_add_sum] at hdu
  have huLoopEq : G.mult u u = 1 := by omega
  have huvEq : G.mult u v = 2 := by omega
  have hIndU : (G.induce S).degree us = 4 := by
    rw [degree_eq_mult_self_add_sum,
      fintype_sum_eq_add_of_card_two huvs hcard]
    simp [us, vs, huLoopEq, huvEq]
  have hIndV : (G.induce S).degree vs = 2 := by
    rw [degree_eq_mult_self_add_sum,
      fintype_sum_eq_add_of_card_two huvs hcard]
    simp [us, vs, hvLoop, huvEq, G.mult_comm]
  have houtU : G.outsideDegree S u = 0 := by
    have h := G.degree_induce_add_outsideDegree S u (by simp [S])
    change (G.induce S).degree us + G.outsideDegree S u = G.degree u at h
    rw [hIndU, hreg u] at h
    omega
  have houtV : G.outsideDegree S v = 2 := by
    have h := G.degree_induce_add_outsideDegree S v (by simp [S])
    change (G.induce S).degree vs + G.outsideDegree S v = G.degree v at h
    rw [hIndV, hreg v] at h
    omega
  have hcut : G.boundaryMultiplicity S = 2 := by
    have hboundarySum : G.boundaryMultiplicity S =
        ∑ x ∈ S, G.outsideDegree S x := by
      have hbetween : G.boundaryMultiplicity S =
          G.betweenMultiplicity S Sᶜ := by
        unfold boundaryMultiplicity betweenMultiplicity
        apply Finset.sum_congr rfl
        intro e _
        congr 1
        induction e using Sym2.inductionOn with
        | _ x y =>
            by_cases hx : x ∈ S <;> by_cases hy : y ∈ S <;>
              simp [crossingIndicator_mk, betweenIndicator_mk, hx, hy]
      rw [hbetween,
        G.betweenMultiplicity_eq_sum_singleton_left S Sᶜ
          disjoint_compl_right]
      apply Finset.sum_congr rfl
      intro x hx
      rw [G.betweenMultiplicity_singleton x Sᶜ (by simp [hx])]
      rfl
    rw [hboundarySum]
    change ∑ x ∈ ({u, v} : Finset W), G.outsideDegree S x = 2
    simp [huv, houtU, houtV]
  have hcount := G.outsideDegree_eq_twoCutEndpointCount S hcut u
    (by simp [S])
  rw [houtU] at hcount
  have hendpoint (i : Fin 2) :
      (twoCutEdge G S hcut i).inside = v := by
    have hne : (twoCutEdge G S hcut i).inside ≠ u := by
      intro hi
      fin_cases i
      · have hi0 : (twoCutEdge G S hcut 0).inside = u := by simpa using hi
        rw [if_pos hi0] at hcount
        omega
      · have hi1 : (twoCutEdge G S hcut 1).inside = u := by simpa using hi
        rw [if_pos hi1] at hcount
        omega
    have hmem := (twoCutEdge G S hcut i).inside_mem
    simp only [S, Finset.mem_insert, Finset.mem_singleton] at hmem
    exact hmem.resolve_left hne
  let a : S :=
    ⟨(twoCutEdge G S hcut 0).inside,
      (twoCutEdge G S hcut 0).inside_mem⟩
  let b : S :=
    ⟨(twoCutEdge G S hcut 1).inside,
      (twoCutEdge G S hcut 1).inside_mem⟩
  have ha : a = vs := by
    apply Subtype.ext
    exact hendpoint 0
  have hb : b = vs := by
    apply Subtype.ext
    exact hendpoint 1
  let H : Pseudograph S :=
    (singleEdge us us + edgeCopies 1 us vs) + singleEdge a b
  have hHpart : H.IsPart (G.closeTwoCut S hcut) := by
    intro x y
    rcases eq_or_eq_of_fintype_card_two huvs hcard x with rfl | rfl <;>
      rcases eq_or_eq_of_fintype_card_two huvs hcard y with rfl | rfl <;>
      simp [H, closeTwoCut, a, b, us, vs, ha, hb, singleEdge_mult,
        edgeCopies_mult, huLoopEq, huvEq, hvLoop, G.mult_comm,
        huv, huv.symm, huvs, huvs.symm] <;> omega
  have hHdeg (x : S) : H.degree x = 3 := by
    rcases eq_or_eq_of_fintype_card_two huvs hcard x with rfl | rfl <;>
      simp [H, degree_add, degree_singleEdge, degree_edgeCopies_of_ne,
        huvs, huvs.symm, ha, hb]
  refine ⟨hcut, H, hHpart, ⟨us, hHdeg us⟩, fun x ↦ .inr (hHdeg x)⟩

lemma closeFourCutStarWith_inTashkinovClass_of_hasSimpleMultiplicities
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) :
    (G.closeFourCutStarWith S E).InTashkinovClass := by
  classical
  let C : S → ℕ := fun v ↦ G.listingEndpointCount S E v
  let heavy : Finset S := Finset.univ.filter fun v ↦ 2 ≤ C v
  have hheavy : 2 * heavy.card ≤ 4 := by
    have hlower : 2 * heavy.card ≤ ∑ v ∈ heavy, C v := by
      calc
        2 * heavy.card = ∑ _v ∈ heavy, 2 := by simp [Nat.mul_comm]
        _ ≤ ∑ v ∈ heavy, C v := by
          exact Finset.sum_le_sum fun v hv ↦ by
            simpa [heavy] using (Finset.mem_filter.mp hv).2
    have hupper : (∑ v ∈ heavy, C v) ≤ ∑ v : S, C v := by
      exact Finset.sum_le_sum_of_subset (by simp [heavy])
    have hsum : (∑ v : S, C v) = 4 := by
      simpa [C] using G.sum_listingEndpointCount S E
    omega
  have hloop : (G.closeFourCutStarWith S E).loopCount = 0 := by
    unfold loopCount
    apply Finset.sum_eq_zero
    intro v _
    cases v with
    | none => simp
    | some v => simp [hsimple.1 v]
  have hparallel :
      (G.closeFourCutStarWith S E).parallelPairCount ≤ 2 := by
    let R := Finset.univ.filter fun p : Option S × Option S ↦
      p.1 ≠ p.2 ∧
        2 ≤ (G.closeFourCutStarWith S E).mult p.1 p.2
    let A : Finset (Option S × Option S) :=
      heavy.image fun v ↦ (none, some v)
    let B : Finset (Option S × Option S) :=
      heavy.image fun v ↦ (some v, none)
    have hsub : R ⊆ A ∪ B := by
      intro p hp
      have hp' : p.1 ≠ p.2 ∧
          2 ≤ (G.closeFourCutStarWith S E).mult p.1 p.2 := by
        simpa only [R, Finset.mem_filter, Finset.mem_univ, true_and] using hp
      rcases p with ⟨u, v⟩
      cases u with
      | none =>
          cases v with
          | none => simp at hp'
          | some v =>
              have hvheavy : v ∈ heavy := by
                simp only [heavy, Finset.mem_filter, Finset.mem_univ, true_and]
                simpa [C] using hp'.2
              apply Finset.mem_union_left
              exact Finset.mem_image.mpr ⟨v, hvheavy, rfl⟩
      | some u =>
          cases v with
          | none =>
              have huheavy : u ∈ heavy := by
                simp only [heavy, Finset.mem_filter, Finset.mem_univ, true_and]
                simpa [C] using hp'.2
              apply Finset.mem_union_right
              exact Finset.mem_image.mpr ⟨u, huheavy, rfl⟩
          | some v =>
              have hle := hsimple.2 u v
              simp only [closeFourCutStarWith_mult_some_some] at hp'
              omega
    have hRcard : R.card ≤ 4 := by
      have hAU : (A ∪ B).card ≤ A.card + B.card := Finset.card_union_le A B
      have hA : A.card ≤ heavy.card := Finset.card_image_le
      have hB : B.card ≤ heavy.card := Finset.card_image_le
      have hR := Finset.card_le_card hsub
      omega
    have hRcard' :
        (Finset.univ.filter fun p : Option S × Option S ↦
          p.1 ≠ p.2 ∧
            2 ≤ (G.closeFourCutStarWith S E).mult p.1 p.2).card ≤ 4 := by
      exact hRcard
    unfold parallelPairCount
    simpa using Nat.div_le_div_right hRcard'
  exact ⟨G.closeFourCutStarWith_isRegularOfDegree S E hreg,
    by omega, by omega⟩

/-- A star closure remains in class `B` when the old shore has at most one
defect and at most one shore vertex receives two or more of the four star
edges. -/
lemma closeFourCutStarWith_inTashkinovClass_of_defect_and_one_heavy
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S)
    (hdefect : (G.induce S).loopCount +
      (G.induce S).parallelPairCount ≤ 1)
    (hheavy : (Finset.univ.filter fun v : S ↦
      2 ≤ G.listingEndpointCount S E v).card ≤ 1) :
    (G.closeFourCutStarWith S E).InTashkinovClass := by
  classical
  letI : DecidableEq S := Classical.decEq S
  letI : DecidableEq (Option S) := Classical.decEq (Option S)
  let C : S → ℕ := fun v ↦ G.listingEndpointCount S E v
  let heavy : Finset S := Finset.univ.filter fun v ↦ 2 ≤ C v
  have hheavy' : heavy.card ≤ 1 := by simpa [heavy, C] using hheavy
  have hloop : (G.closeFourCutStarWith S E).loopCount =
      (G.induce S).loopCount := by
    unfold loopCount
    rw [Fintype.sum_option]
    simp only [closeFourCutStarWith_mult_none_none,
      closeFourCutStarWith_mult_some_some, Nat.zero_add]
    change (∑ i : S, G.mult i i) = ∑ i : S, G.mult i i
    rfl
  have hparallel : (G.closeFourCutStarWith S E).parallelPairCount ≤
      (G.induce S).parallelPairCount + heavy.card := by
    let R := Finset.univ.filter fun p : Option S × Option S ↦
      p.1 ≠ p.2 ∧ 2 ≤ (G.closeFourCutStarWith S E).mult p.1 p.2
    let D := Finset.univ.filter fun p : S × S ↦
      p.1 ≠ p.2 ∧ 2 ≤ (G.induce S).mult p.1 p.2
    let L : Finset (Option S × Option S) :=
      D.image fun p ↦ (some p.1, some p.2)
    let A : Finset (Option S × Option S) :=
      heavy.image fun v ↦ (none, some v)
    let B : Finset (Option S × Option S) :=
      heavy.image fun v ↦ (some v, none)
    have hsub : R ⊆ L ∪ A ∪ B := by
      intro p hp
      have hp' : p.1 ≠ p.2 ∧
          2 ≤ (G.closeFourCutStarWith S E).mult p.1 p.2 := by
        simpa only [R, Finset.mem_filter, Finset.mem_univ, true_and] using hp
      rcases p with ⟨u, v⟩
      cases u with
      | none =>
          cases v with
          | none => simp at hp'
          | some v =>
              apply Finset.mem_union_left
              apply Finset.mem_union_right
              apply Finset.mem_image.mpr
              refine ⟨v, ?_, rfl⟩
              simpa [heavy, C] using hp'.2
      | some u =>
          cases v with
          | none =>
              apply Finset.mem_union_right
              apply Finset.mem_image.mpr
              refine ⟨u, ?_, rfl⟩
              simpa [heavy, C] using hp'.2
          | some v =>
              apply Finset.mem_union_left
              apply Finset.mem_union_left
              apply Finset.mem_image.mpr
              refine ⟨(u, v), ?_, rfl⟩
              simp only [D, Finset.mem_filter, Finset.mem_univ, true_and]
              constructor
              · intro huv
                exact hp'.1 (congrArg some huv)
              · change 2 ≤ G.mult (u : W) (v : W)
                exact hp'.2
    have hL : L.card ≤ D.card := Finset.card_image_le
    have hA : A.card ≤ heavy.card := Finset.card_image_le
    have hB : B.card ≤ heavy.card := Finset.card_image_le
    have hR : R.card ≤ D.card + 2 * heavy.card := by
      have h₁ := Finset.card_le_card hsub
      have h₂ := Finset.card_union_le (L ∪ A) B
      have h₃ := Finset.card_union_le L A
      omega
    have hR' :
        (Finset.univ.filter fun p : Option S × Option S ↦
          p.1 ≠ p.2 ∧
            2 ≤ (G.closeFourCutStarWith S E).mult p.1 p.2).card ≤
        (Finset.univ.filter fun p : S × S ↦
          p.1 ≠ p.2 ∧ 2 ≤ (G.induce S).mult p.1 p.2).card +
          2 * heavy.card := by
      simpa only [R, D] using hR
    have hDpar :
        (Finset.univ.filter fun p : S × S ↦
          p.1 ≠ p.2 ∧ 2 ≤ (G.induce S).mult p.1 p.2).card =
          2 * (G.induce S).parallelPairCount :=
      (G.induce S).parallelPairFilter_card_eq_two_mul
    unfold parallelPairCount at hDpar
    unfold parallelPairCount
    omega
  refine ⟨G.closeFourCutStarWith_isRegularOfDegree S E hreg, ?_, ?_⟩
  · rw [hloop]
    omega
  · rw [hloop]
    omega

end Pseudograph

/-- Proposition 3.1 at the matrix level: once the minimal counterexample has
simple multiplicities, it has no proper nonempty two-edge cut. -/
theorem IsVertexMinimalCounterexample.no_two_cut_of_hasSimpleMultiplicities
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities) :
    ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      G.boundaryMultiplicity S ≠ 2 := by
  letI : DecidableEq (Fin n) := Classical.decEq _
  intro S hS hproper hcut
  haveI : Nonempty S := Finset.nonempty_coe_sort.mpr hS
  have hSC : Sᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro h
    exact hproper ((Finset.compl_eq_empty_iff S).mp h)
  letI : Nonempty (↑(Sᶜ)) := Finset.nonempty_coe_sort.mpr hSC
  have hcardS : Fintype.card S < n := by
    rw [Fintype.card_coe]
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ S, hproper⟩)
    simpa using hlt
  have hproperC : Sᶜ ≠ Finset.univ := by
    intro h
    exact hS.ne_empty ((Finset.compl_eq_univ_iff S).mp h)
  have hcardC : Fintype.card (↑(Sᶜ)) < n := by
    rw [Fintype.card_coe]
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ Sᶜ, hproperC⟩)
    simpa using hlt
  let hcutC : G.boundaryMultiplicity Sᶜ = 2 :=
    (G.boundaryMultiplicity_compl S).trans hcut
  have hclassS : (G.closeTwoCut S hcut).InTashkinovClass :=
    G.closeTwoCut_inTashkinovClass_of_hasSimpleMultiplicities
      hmin.in_class.1 hsimple S hcut
  have hclassC : (G.closeTwoCut Sᶜ hcutC).InTashkinovClass :=
    G.closeTwoCut_inTashkinovClass_of_hasSimpleMultiplicities
      hmin.in_class.1 hsimple Sᶜ hcutC
  have hpartS := hmin.contains_of_card_lt
    (G.closeTwoCut S hcut) hclassS hcardS
  have hpartC := hmin.contains_of_card_lt
    (G.closeTwoCut Sᶜ hcutC) hclassC hcardC
  exact hmin.no_cubic_part
    (G.containsRegularPart_of_twoCutClosures S hcut hpartS (by
      simpa [hcutC] using hpartC))

namespace Pseudograph

variable {W : Type*} [Fintype W]

/-- Complementing a perfect matching which contains a specified star edge
gives the exact omitted-label witness used in Proposition 3.3. -/
lemma exists_cubicStarPart_omitting_of_isPerfectMatching
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) (i : Fin 4)
    (M : (G.closeFourCutStarWith S E).toSimple.Subgraph)
    (hM : M.IsPerfectMatching)
    (hMi : M.Adj none
      (some ⟨(E i).inside, (E i).inside_mem⟩)) :
    ∃ H : Pseudograph (Option S),
      H.IsPart (G.closeFourCutStarWith S E) ∧
      (∃ v, H.degree v = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      StarOmitsExactly E H i := by
  classical
  let Q := G.closeFourCutStarWith S E
  let F := Q.ofUnderlyingSubgraph M
  let H := Q.sdiff F
  have hFQ : F.IsPart Q := Q.ofUnderlyingSubgraph_isPart M
  have hQreg : Q.IsRegularOfDegree 4 :=
    G.closeFourCutStarWith_isRegularOfDegree S E hreg
  have hHdeg : ∀ v, H.degree v = 3 := by
    intro v
    have hdiff := Q.degree_sdiff_add F hFQ v
    have hFdeg : F.degree v = 1 :=
      Q.degree_ofUnderlyingSubgraph_of_isPerfectMatching M hM v
    change H.degree v + F.degree v = Q.degree v at hdiff
    have hQdeg := hQreg v
    omega
  refine ⟨H, Q.sdiff_isPart_left F, ⟨none, hHdeg none⟩,
    fun v ↦ .inr (hHdeg v), ?_⟩
  intro v
  by_cases heq : (E i).inside = (v : W)
  · have ht :
        (⟨(E i).inside, (E i).inside_mem⟩ : S) = v := by
      apply Subtype.ext
      exact heq
    have hAdj : M.spanningCoe.Adj none (some v) := by
      simpa [ht] using hMi
    have hAdjM : M.Adj none (some v) := by simpa using hAdj
    simp [H, F, Q, Pseudograph.sdiff_mult, ofUnderlyingSubgraph,
      heq, hAdj, hAdjM]
  · have hnotAdj : ¬ M.spanningCoe.Adj none (some v) := by
      intro hAdj
      have hAdj' : M.Adj none (some v) := by simpa using hAdj
      have ht := hM.1.eq_of_adj_left hMi hAdj'
      apply heq
      exact congrArg (fun z : Option S ↦
        match z with | none => (E i).inside | some x => (x : W)) ht
    have hnotAdjM : ¬ M.Adj none (some v) := by simpa using hnotAdj
    simp [H, F, Q, Pseudograph.sdiff_mult, ofUnderlyingSubgraph,
      heq, hnotAdj, hnotAdjM]

/-- A finset is equivalent to its image under an embedding. -/
noncomputable def finsetMapEquiv {A B : Type*}
    (s : Finset A) (f : A ↪ B) :
    s ≃ ↑(s.map f) where
  toFun x := ⟨f x, Finset.mem_map.mpr ⟨x, x.2, rfl⟩⟩
  invFun y :=
    ⟨Classical.choose (Finset.mem_map.mp y.2),
      (Classical.choose_spec (Finset.mem_map.mp y.2)).1⟩
  left_inv x := by
    apply Subtype.ext
    apply f.injective
    exact (Classical.choose_spec (Finset.mem_map.mp
      (show f x ∈ s.map f from Finset.mem_map.mpr ⟨x, x.2, rfl⟩))).2
  right_inv y := by
    apply Subtype.ext
    exact (Classical.choose_spec (Finset.mem_map.mp y.2)).2

@[simp]
lemma finsetMapEquiv_apply {A B : Type*}
    (s : Finset A) (f : A ↪ B) (x : s) :
    ((finsetMapEquiv s f x : ↑(s.map f)) : B) = f x := by
  rfl

/-- A cut is the between-block multiplicity of the shore and its
complement. -/
lemma boundaryMultiplicity_eq_between_compl
    (G : Pseudograph W) (S : Finset W) :
    G.boundaryMultiplicity S = G.betweenMultiplicity S Sᶜ := by
  classical
  unfold boundaryMultiplicity betweenMultiplicity
  apply Finset.sum_congr rfl
  intro e _
  congr 1
  induction e using Sym2.inductionOn with
  | _ u v =>
      by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;>
        simp [crossingIndicator_mk, betweenIndicator_mk, hu, hv]

/-- The boundary is the sum, over vertices of the shore, of incidences
leaving the shore. -/
lemma boundaryMultiplicity_eq_sum_outsideDegree
    (G : Pseudograph W) (S : Finset W) :
    G.boundaryMultiplicity S = ∑ v ∈ S, G.outsideDegree S v := by
  classical
  rw [G.boundaryMultiplicity_eq_between_compl S,
    G.betweenMultiplicity_eq_sum_singleton_left S Sᶜ
      disjoint_compl_right]
  apply Finset.sum_congr rfl
  intro v hv
  rw [G.betweenMultiplicity_singleton v Sᶜ (by simp [hv])]
  rfl

/-- The two vertices of a loopless double edge form a four-edge shore in a
quartic pseudograph.  Moreover the four labelled cut ends support the two
cross-pairings used in Proposition 2.5. -/
lemma exists_two_cross_pairings_of_double_edge
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    {u v : W} (huv : u ≠ v) (huu : G.mult u u = 0)
    (hvv : G.mult v v = 0) (huvTwo : G.mult u v = 2) :
    let S : Finset W := {u, v}
    ∃ hcut : G.boundaryMultiplicity S = 4,
      ∃ p q : FourPairing, p ≠ q ∧
        let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
        (E p.a).inside ≠ (E p.b).inside ∧
        (E p.c).inside ≠ (E p.d).inside ∧
        (E q.a).inside ≠ (E q.b).inside ∧
        (E q.c).inside ≠ (E q.d).inside := by
  classical
  dsimp only
  let S : Finset W := {u, v}
  let us : S := ⟨u, by simp [S]⟩
  let vs : S := ⟨v, by simp [S]⟩
  have huvs : us ≠ vs := by
    intro h
    exact huv (congrArg Subtype.val h)
  have hcard : Fintype.card S = 2 := by
    rw [Fintype.card_coe]
    simp [S, huv]
  have hdu : (G.induce S).degree us = 2 := by
    rw [degree_eq_mult_self_add_sum,
      fintype_sum_eq_add_of_card_two huvs hcard]
    simp [us, vs, huu, huvTwo]
  have hdv : (G.induce S).degree vs = 2 := by
    rw [degree_eq_mult_self_add_sum,
      fintype_sum_eq_add_of_card_two huvs hcard]
    simp [us, vs, hvv, huvTwo, G.mult_comm]
  have houtU : G.outsideDegree S u = 2 := by
    have h := G.degree_induce_add_outsideDegree S u (by simp [S])
    change (G.induce S).degree us + G.outsideDegree S u = G.degree u at h
    rw [hdu, hreg u] at h
    omega

  have houtV : G.outsideDegree S v = 2 := by
    have h := G.degree_induce_add_outsideDegree S v (by simp [S])
    change (G.induce S).degree vs + G.outsideDegree S v = G.degree v at h
    rw [hdv, hreg v] at h
    omega
  have hcut : G.boundaryMultiplicity S = 4 := by
    rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
    change ∑ x ∈ ({u, v} : Finset W), G.outsideDegree S x = 4
    simp [huv, houtU, houtV]
  refine ⟨hcut, ?_⟩
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let f : Fin 4 → Bool := fun i ↦ decide ((E i).inside = u)
  have hcount : (∑ i : Fin 4, if f i then 1 else 0) = 2 := by
    have hlisting := G.outsideDegree_eq_listingEndpointCount S E u (by simp [S])
    rw [houtU] at hlisting
    simpa [f, listingEndpointCount] using hlisting.symm
  obtain ⟨p, q, hpq, hpab, hpcd, hqab, hqcd⟩ :=
    FourPairing.exists_two_cross_pairings f hcount
  refine ⟨p, q, hpq, ?_, ?_, ?_, ?_⟩
  · intro h
    change (E p.a).inside = (E p.b).inside at h
    apply hpab
    simp only [f]
    rw [h]
  · intro h
    change (E p.c).inside = (E p.d).inside at h
    apply hpcd
    simp only [f]
    rw [h]
  · intro h
    change (E q.a).inside = (E q.b).inside at h
    apply hqab
    simp only [f]
    rw [h]
  · intro h
    change (E q.c).inside = (E q.d).inside at h
    apply hqcd
    simp only [f]
    rw [h]

/-- Subtracting any spanning degree-one part of a quartic star closure
gives a cubic part.  The stated star-edge row identifies the omitted cut
label. -/
lemma exists_cubicStarPart_omitting_of_degreeOnePart
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S) (i : Fin 4)
    (F : Pseudograph (Option S))
    (hFpart : F.IsPart (G.closeFourCutStarWith S E))
    (hFdeg : ∀ v, F.degree v = 1)
    (hFstar : ∀ v : S, F.mult none (some v) =
      if (E i).inside = (v : W) then 1 else 0) :
    ∃ H : Pseudograph (Option S),
      H.IsPart (G.closeFourCutStarWith S E) ∧
      (∃ v, H.degree v = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      StarOmitsExactly E H i := by
  let Q := G.closeFourCutStarWith S E
  let H := Q.sdiff F
  have hQreg : Q.IsRegularOfDegree 4 :=
    G.closeFourCutStarWith_isRegularOfDegree S E hreg
  have hHdeg (v : Option S) : H.degree v = 3 := by
    have hdiff := Q.degree_sdiff_add F hFpart v
    change H.degree v + F.degree v = Q.degree v at hdiff
    rw [hFdeg v, hQreg v] at hdiff
    omega
  refine ⟨H, Q.sdiff_isPart_left F, ⟨none, hHdeg none⟩,
    fun v ↦ .inr (hHdeg v), ?_⟩
  intro v
  change Q.mult none (some v) - F.mult none (some v) = _
  simp only [Q, closeFourCutStarWith_mult_none_some]
  rw [hFstar v]

/-- Replacing the original edges leaving `S` by a star center preserves the
boundary of every smaller shore consisting only of old vertices. -/
lemma boundaryMultiplicity_closeFourCutStarWith_image
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S)
    (U : Finset S) :
    (G.closeFourCutStarWith S E).boundaryMultiplicity
        (U.map Function.Embedding.some) =
      G.boundaryMultiplicity (U.map (Function.Embedding.subtype _)) := by
  classical
  let Q := G.closeFourCutStarWith S E
  let eT : U ≃ ↑(U.map Function.Embedding.some) :=
    finsetMapEquiv U Function.Embedding.some
  let eA : U ≃ ↑(U.map (Function.Embedding.subtype _)) :=
    finsetMapEquiv U (Function.Embedding.subtype _)
  have hgraphs :
      ((Q.induce (U.map Function.Embedding.some)).relabel eT.symm) =
        ((G.induce (U.map (Function.Embedding.subtype _))).relabel eA.symm) := by
    apply Pseudograph.ext
    intro x y
    simp [Q, eT, eA, relabel]
  have hinducedDegree (x : U) :
      (Q.induce (U.map Function.Embedding.some)).degree (eT x) =
        (G.induce (U.map (Function.Embedding.subtype _))).degree (eA x) := by
    calc
      (Q.induce (U.map Function.Embedding.some)).degree (eT x) =
          ((Q.induce (U.map Function.Embedding.some)).relabel eT.symm).degree x :=
        ((Q.induce (U.map Function.Embedding.some)).degree_relabel
          eT.symm (eT x)).symm.trans
          (by simp)
      _ = ((G.induce (U.map (Function.Embedding.subtype _))).relabel
          eA.symm).degree x := by rw [hgraphs]
      _ = (G.induce (U.map (Function.Embedding.subtype _))).degree (eA x) := by
        simpa using
          (G.induce (U.map (Function.Embedding.subtype _))).degree_relabel
            eA.symm (eA x)
  have houtside (x : U) :
      Q.outsideDegree (U.map Function.Embedding.some) (some (x : S)) =
        G.outsideDegree (U.map (Function.Embedding.subtype _)) (x : W) := by
    have hQT := Q.degree_induce_add_outsideDegree
      (U.map Function.Embedding.some) (eT x) (eT x).2
    have hGA := G.degree_induce_add_outsideDegree
      (U.map (Function.Embedding.subtype _)) (eA x) (eA x).2
    have hQreg : Q.IsRegularOfDegree 4 :=
      G.closeFourCutStarWith_isRegularOfDegree S E hreg
    have hdeg := hinducedDegree x
    have heT : ((eT x : ↑(U.map Function.Embedding.some)) : Option S) =
        some (x : S) := by
      exact finsetMapEquiv_apply U Function.Embedding.some x
    have heA :
        ((eA x : ↑(U.map (Function.Embedding.subtype _))) : W) = (x : W) := by
      exact finsetMapEquiv_apply U (Function.Embedding.subtype _) x
    rw [hQreg (eT x)] at hQT
    rw [hreg (eA x)] at hGA
    rw [hdeg] at hQT
    have hGA' :
        (G.induce (U.map (Function.Embedding.subtype _))).degree (eA x) +
          G.outsideDegree (U.map (Function.Embedding.subtype _)) (eA x) = 4 := by
      simpa using hGA
    have hout : Q.outsideDegree (U.map Function.Embedding.some) (eT x) =
        G.outsideDegree (U.map (Function.Embedding.subtype _)) (eA x) := by
      omega
    simpa only [heT, heA] using hout
  rw [boundaryMultiplicity_eq_sum_outsideDegree,
    boundaryMultiplicity_eq_sum_outsideDegree]
  change (∑ v ∈ U.map Function.Embedding.some,
      Q.outsideDegree (U.map Function.Embedding.some) v) =
    ∑ v ∈ U.map (Function.Embedding.subtype _),
      G.outsideDegree (U.map (Function.Embedding.subtype _)) v
  calc
    (∑ v ∈ U.map Function.Embedding.some,
        Q.outsideDegree (U.map Function.Embedding.some) v) =
        ∑ x ∈ U,
          Q.outsideDegree (U.map Function.Embedding.some) (some x) := by
      exact Finset.sum_map U Function.Embedding.some _
    _ = ∑ x ∈ U,
        G.outsideDegree (U.map (Function.Embedding.subtype _)) x := by
      apply Finset.sum_congr rfl
      intro x hx
      exact houtside ⟨x, hx⟩
    _ = ∑ v ∈ U.map (Function.Embedding.subtype _),
        G.outsideDegree (U.map (Function.Embedding.subtype _)) v := by
      symm
      exact Finset.sum_map U (Function.Embedding.subtype _) _

/-- If every proper nonempty shore of the original pseudograph has boundary
at least four, the same is true after closing a four-cut by a star.  For a
shore of the closure, complement it if necessary so that it omits the new
center, then pull it back to the old shore. -/
lemma four_le_boundaryMultiplicity_closeFourCutStarWith
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hfour : ∀ A : Finset W, A.Nonempty → A ≠ Finset.univ →
      4 ≤ G.boundaryMultiplicity A)
    (S : Finset W) (E : Fin 4 ≃ CrossingEdge G S)
    (T : Finset (Option S)) (hT : T.Nonempty) (hproper : T ≠ Finset.univ) :
    4 ≤ (G.closeFourCutStarWith S E).boundaryMultiplicity T := by
  classical
  letI : DecidableEq (Option S) := Classical.decEq _
  let Q := G.closeFourCutStarWith S E
  have haway (R : Finset (Option S)) (hR : R.Nonempty)
      (hnone : none ∉ R) : 4 ≤ Q.boundaryMultiplicity R := by
    let U : Finset S :=
      R.preimage some (Option.some_injective S).injOn
    have hmap : U.map Function.Embedding.some = R := by
      ext z
      cases z with
      | none => simp [hnone]
      | some v => simp [U]
    let A : Finset W := U.map (Function.Embedding.subtype _)
    have hA : A.Nonempty := by
      obtain ⟨z, hz⟩ := hR
      cases z with
      | none => exact False.elim (hnone hz)
      | some v =>
          have hvU : v ∈ U := by
            have : some v ∈ U.map Function.Embedding.some := by
              simpa [hmap] using hz
            simpa using this
          exact ⟨(v : W), Finset.mem_map.mpr ⟨v, hvU, rfl⟩⟩
    have hAproper : A ≠ Finset.univ := by
      intro hAu
      have hzA : (E 0).outside ∈ A := by rw [hAu]; simp
      obtain ⟨v, _hv, hvz⟩ := Finset.mem_map.mp hzA
      apply (E 0).outside_notMem
      rw [← hvz]
      exact v.2
    have htransfer :=
      G.boundaryMultiplicity_closeFourCutStarWith_image hreg S E U
    rw [← hmap, htransfer]
    exact hfour A hA hAproper
  by_cases hn : none ∈ T
  · have hTC : Tᶜ.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hempty
      exact hproper ((Finset.compl_eq_empty_iff T).mp hempty)
    have hnoneC : none ∉ Tᶜ := by simp [hn]
    have hbound := haway Tᶜ hTC hnoneC
    have hcomp := Q.boundaryMultiplicity_compl T
    rw [hcomp] at hbound
    exact hbound
  · exact haway T hT hn

/-! ### Labelled pieces of a paired four-cut

The pair-closure argument must remember individual copies when two cut
edges have the same endpoints.  The next small pseudographs retain one or
two labelled copies and are used by the paired-closure splice below. -/

/-- The single original edge copy represented by a labelled crossing edge. -/
noncomputable def crossingLabelPart {G : Pseudograph W} {S : Finset W}
    (e : CrossingEdge G S) : Pseudograph W :=
  singleEdge e.inside e.outside

lemma crossingLabelPart_isPart_crossingPart
    {G : Pseudograph W} {S : Finset W} (e : CrossingEdge G S) :
    (crossingLabelPart e).IsPart (G.crossingPart S) := by
  intro x y
  simp only [crossingLabelPart, singleEdge_mult, crossingPart_mult]
  by_cases hxy : (x = e.inside ∧ y = e.outside) ∨
      (x = e.outside ∧ y = e.inside)
  · rw [if_pos hxy]
    rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · rw [if_pos (by simp [e.inside_mem, e.outside_notMem])]
      have := e.index.isLt
      omega
    · rw [if_pos (by simp [e.inside_mem, e.outside_notMem])]
      have := e.index.isLt
      rw [G.mult_comm]
      omega
  · rw [if_neg hxy]
    exact Nat.zero_le _

/-- Two distinct labelled cut-edge copies. -/
noncomputable def twoCrossingLabelPart {G : Pseudograph W} {S : Finset W}
    (e f : CrossingEdge G S) : Pseudograph W :=
  crossingLabelPart e + crossingLabelPart f

lemma twoCrossingLabelPart_isPart_crossingPart
    {G : Pseudograph W} {S : Finset W}
    (e f : CrossingEdge G S) (hef : e ≠ f) :
    (twoCrossingLabelPart e f).IsPart (G.crossingPart S) := by
  classical
  intro x y
  simp only [twoCrossingLabelPart, add_mult, crossingLabelPart,
    singleEdge_mult, crossingPart_mult]
  let Pe : Prop := (x = e.inside ∧ y = e.outside) ∨
    (x = e.outside ∧ y = e.inside)
  let Pf : Prop := (x = f.inside ∧ y = f.outside) ∨
    (x = f.outside ∧ y = f.inside)
  by_cases he : Pe <;> by_cases hf : Pf
  · rw [if_pos he, if_pos hf]
    have hcross : (x ∈ S ∧ y ∉ S) ∨ (y ∈ S ∧ x ∉ S) := by
      rcases he with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact .inl ⟨e.inside_mem, e.outside_notMem⟩
      · exact .inr ⟨e.inside_mem, e.outside_notMem⟩
    rw [if_pos hcross]
    have hend : e.inside = f.inside ∧ e.outside = f.outside := by
      rcases he with ⟨hxi, hyo⟩ | ⟨hxo, hyi⟩ <;>
        rcases hf with ⟨hxi', hyo'⟩ | ⟨hxo', hyi'⟩
      · exact ⟨hxi.symm.trans hxi', hyo.symm.trans hyo'⟩
      · exfalso
        have : e.inside ∈ S := e.inside_mem
        rw [hxi.symm, hxo'] at this
        exact f.outside_notMem this
      · exfalso
        have : f.inside ∈ S := f.inside_mem
        rw [hxi'.symm, hxo] at this
        exact e.outside_notMem this
      · exact ⟨hyi.symm.trans hyi', hxo.symm.trans hxo'⟩
    have hidx : e.index.val ≠ f.index.val := by
      intro hval
      apply hef
      cases e with
      | mk ei eo hei heo eidx =>
          cases f with
          | mk fi fo hfi hfo fidx =>
              simp only at hend hval
              rcases hend with ⟨rfl, rfl⟩
              have hfin : eidx = fidx := Fin.ext hval
              subst fidx
              rfl
    have htwo : 2 ≤ G.mult e.inside e.outside := by
      have heLt := e.index.isLt
      have hfLt := f.index.isLt
      have hfLt' : f.index.val < G.mult e.inside e.outside := by
        simpa only [hend.1, hend.2] using hfLt
      omega
    rcases he with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact htwo
    · simpa only [G.mult_comm] using htwo
  · rw [if_pos he, if_neg hf]
    have hp := crossingLabelPart_isPart_crossingPart e x y
    simpa [crossingLabelPart, Pe, he] using hp
  · rw [if_neg he, if_pos hf]
    have hp := crossingLabelPart_isPart_crossingPart f x y
    simpa [crossingLabelPart, Pf, hf] using hp
  · rw [if_neg he, if_neg hf]
    exact Nat.zero_le _

lemma degree_twoCrossingLabelPart
    {G : Pseudograph W} {S : Finset W}
    (e f : CrossingEdge G S) (v : W) :
    (twoCrossingLabelPart e f).degree v =
      (if v = e.inside then 1 else 0) +
      (if v = e.outside then 1 else 0) +
      (if v = f.inside then 1 else 0) +
      (if v = f.outside then 1 else 0) := by
  simp only [twoCrossingLabelPart, crossingLabelPart, degree_add,
    degree_singleEdge]
  omega

def pairEndpoint {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (i : Fin 4) : S :=
  ⟨(E i).inside, (E i).inside_mem⟩

noncomputable def pairIncidenceInside {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : W) : ℕ :=
  (if use₁ then
      (if v = (E p.a).inside then 1 else 0) +
      (if v = (E p.b).inside then 1 else 0)
    else 0) +
  (if use₂ then
      (if v = (E p.c).inside then 1 else 0) +
      (if v = (E p.d).inside then 1 else 0)
    else 0)

noncomputable def pairIncidenceOutside {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : W) : ℕ :=
  (if use₁ then
      (if v = (E p.a).outside then 1 else 0) +
      (if v = (E p.b).outside then 1 else 0)
    else 0) +
  (if use₂ then
      (if v = (E p.c).outside then 1 else 0) +
      (if v = (E p.d).outside then 1 else 0)
    else 0)

lemma pairIncidenceInside_coe {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : S) :
    pairIncidenceInside E p use₁ use₂ (v : W) =
      (if use₁ then
          (if v = pairEndpoint E p.a then 1 else 0) +
          (if v = pairEndpoint E p.b then 1 else 0)
        else 0) +
      (if use₂ then
          (if v = pairEndpoint E p.c then 1 else 0) +
          (if v = pairEndpoint E p.d then 1 else 0)
        else 0) := by
  have h (i : Fin 4) :
      ((v : W) = (E i).inside) ↔ v = pairEndpoint E i := by
    constructor
    · intro hi
      apply Subtype.ext
      exact hi
    · intro hi
      exact congrArg Subtype.val hi
  simp only [pairIncidenceInside, h]

noncomputable def pairClosingDegree {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : S) : ℕ :=
  (if use₁ then
      (singleEdge (pairEndpoint E p.a) (pairEndpoint E p.b)).degree v
    else 0) +
  (if use₂ then
      (singleEdge (pairEndpoint E p.c) (pairEndpoint E p.d)).degree v
    else 0)

lemma pairClosingDegree_eq_incidence
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : S) :
    pairClosingDegree E p use₁ use₂ v =
      pairIncidenceInside E p use₁ use₂ (v : W) := by
  rw [pairIncidenceInside_coe]
  cases use₁ <;> cases use₂ <;>
    simp [pairClosingDegree, degree_singleEdge] <;>
    split_ifs <;> rfl

/-- The chosen two paired blocks of the original four cut edges.  Defining
this by subtraction from the full crossing part avoids assigning identities
to parallel copies in the resulting multiplicity matrix. -/
noncomputable def crossingPairSelection
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) : Pseudograph W :=
  match use₁, use₂ with
  | true, true => G.crossingPart S
  | true, false =>
      (G.crossingPart S).sdiff
        (twoCrossingLabelPart (E p.c) (E p.d))
  | false, true =>
      (G.crossingPart S).sdiff
        (twoCrossingLabelPart (E p.a) (E p.b))
  | false, false => (G.crossingPart S).sdiff (G.crossingPart S)

lemma fourPairing_ab_ne (p : FourPairing) : p.a ≠ p.b := by
  cases p <;> decide

lemma fourPairing_cd_ne (p : FourPairing) : p.c ≠ p.d := by
  cases p <;> decide

lemma crossingPairSelection_isPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) :
    (crossingPairSelection E p use₁ use₂).IsPart G := by
  cases use₁ <;> cases use₂
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact G.crossingPart_isPart S

lemma degree_crossingPairSelection_of_mem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : W) (hv : v ∈ S) :
    (crossingPairSelection E p use₁ use₂).degree v =
      pairIncidenceInside E p use₁ use₂ v := by
  classical
  have hout := G.outsideDegree_eq_listingEndpointCount S E v hv
  have hall : G.outsideDegree S v =
      (if v = (E p.a).inside then 1 else 0) +
      (if v = (E p.b).inside then 1 else 0) +
      (if v = (E p.c).inside then 1 else 0) +
      (if v = (E p.d).inside then 1 else 0) := by
    rw [hout, listingEndpointCount]
    simpa only [eq_comm] using
      (FourPairing.indicator_sum p
        (fun i ↦ (E i).inside = v)).symm
  have hnotOut (i : Fin 4) : v ≠ (E i).outside := by
    intro h
    exact (E i).outside_notMem (h ▸ hv)
  cases use₁ <;> cases use₂
  · have hdiff := (G.crossingPart S).degree_sdiff_add
        (G.crossingPart S) (Pseudograph.IsPart.refl _) v
    simp [crossingPairSelection, pairIncidenceInside]
    rw [degree_crossingPart_of_mem G S v hv] at hdiff
    omega
  · have hremove := twoCrossingLabelPart_isPart_crossingPart
        (E p.a) (E p.b) (fun h ↦ fourPairing_ab_ne p (E.injective h))
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E p.a) (E p.b)) hremove v
    rw [degree_crossingPart_of_mem G S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [crossingPairSelection, pairIncidenceInside,
      hnotOut p.a, hnotOut p.b] at hdiff ⊢
    omega
  · have hremove := twoCrossingLabelPart_isPart_crossingPart
        (E p.c) (E p.d) (fun h ↦ fourPairing_cd_ne p (E.injective h))
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E p.c) (E p.d)) hremove v
    rw [degree_crossingPart_of_mem G S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [crossingPairSelection, pairIncidenceInside,
      hnotOut p.c, hnotOut p.d] at hdiff ⊢
    omega
  · simp [crossingPairSelection, pairIncidenceInside]
    rw [G.degree_crossingPart_of_mem S v hv, hall]
    omega

lemma degree_crossingPairSelection_of_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : W) (hv : v ∉ S) :
    (crossingPairSelection E p use₁ use₂).degree v =
      pairIncidenceOutside E p use₁ use₂ v := by
  classical
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    E.trans (G.reverseCrossingEdgeEquiv S)
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  have hout := G.outsideDegree_eq_listingEndpointCount Sᶜ EC v hvC
  have hall : G.outsideDegree Sᶜ v =
      (if v = (E p.a).outside then 1 else 0) +
      (if v = (E p.b).outside then 1 else 0) +
      (if v = (E p.c).outside then 1 else 0) +
      (if v = (E p.d).outside then 1 else 0) := by
    rw [hout, listingEndpointCount]
    calc
      (∑ i : Fin 4, if (EC i).inside = v then 1 else 0) =
          ∑ i : Fin 4, if (E i).outside = v then 1 else 0 := by
        apply Finset.sum_congr rfl
        intro i _
        rfl
      _ = _ := by
        simpa only [eq_comm] using
          (FourPairing.indicator_sum p
            (fun i ↦ (E i).outside = v)).symm
  have hnotIn (i : Fin 4) : v ≠ (E i).inside := by
    intro h
    exact hv (h ▸ (E i).inside_mem)
  cases use₁ <;> cases use₂
  · have hdiff := (G.crossingPart S).degree_sdiff_add
        (G.crossingPart S) (Pseudograph.IsPart.refl _) v
    simp [crossingPairSelection, pairIncidenceOutside]
    rw [degree_crossingPart_of_notMem G S v hv] at hdiff
    omega
  · have hremove := twoCrossingLabelPart_isPart_crossingPart
        (E p.a) (E p.b) (fun h ↦ fourPairing_ab_ne p (E.injective h))
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E p.a) (E p.b)) hremove v
    rw [degree_crossingPart_of_notMem G S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [crossingPairSelection, pairIncidenceOutside,
      hnotIn p.a, hnotIn p.b] at hdiff ⊢
    omega
  · have hremove := twoCrossingLabelPart_isPart_crossingPart
        (E p.c) (E p.d) (fun h ↦ fourPairing_cd_ne p (E.injective h))
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E p.c) (E p.d)) hremove v
    rw [degree_crossingPart_of_notMem G S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [crossingPairSelection, pairIncidenceOutside,
      hnotIn p.c, hnotIn p.d] at hdiff ⊢
    omega
  · simp [crossingPairSelection, pairIncidenceOutside]
    rw [G.degree_crossingPart_of_notMem S v hv, hall]
    omega

/-- A labelled decomposition of a part of a pair closure.  `F` is the
genuine internal part and the two booleans record which artificial closing
edge copies account for the remaining incidences. -/
def PairClosureDecomposition
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (H : Pseudograph S) (use₁ use₂ : Bool) (F : Pseudograph S) : Prop :=
  F.IsPart (G.induce S) ∧
    ∀ v : S, F.degree v + pairClosingDegree E p use₁ use₂ v =
      H.degree v

/-- On a two-vertex shore with two original parallel edges, any pairing
whose two artificial edges join the two different vertices realizes all
three nonzero artificial-edge use patterns by an explicit cubic part. -/
lemma pairClosure_twoVertex_localWitnesses
    (G : Pseudograph W) {u v : W} (huv : u ≠ v)
    (S : Finset W) (hS : S = {u, v})
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (hp₁ : (E p.a).inside ≠ (E p.b).inside)
    (hp₂ : (E p.c).inside ≠ (E p.d).inside)
    (hmult : 2 ≤ G.mult u v) :
    ∀ use₁ use₂ : Bool, use₁ = true ∨ use₂ = true →
      ∃ H F : Pseudograph S,
        H.IsPart (G.closeFourCutPairWith S E p) ∧
        (∃ w, H.degree w = 3) ∧
        (∀ w, H.degree w = 0 ∨ H.degree w = 3) ∧
        PairClosureDecomposition E p H use₁ use₂ F := by
  classical
  let us : S := ⟨u, by simp [hS]⟩
  let vs : S := ⟨v, by simp [hS]⟩
  have huvs : us ≠ vs := by
    intro h
    exact huv (congrArg Subtype.val h)
  have hcard : Fintype.card S = 2 := by
    rw [Fintype.card_coe, hS]
    simp [huv]
  let a := pairEndpoint E p.a
  let b := pairEndpoint E p.b
  let c := pairEndpoint E p.c
  let d := pairEndpoint E p.d
  have hab : a ≠ b := by
    intro h
    exact hp₁ (congrArg Subtype.val h)
  have hcd : c ≠ d := by
    intro h
    exact hp₂ (congrArg Subtype.val h)
  have hedge₁ (w : S) : (singleEdge a b).degree w = 1 :=
    degree_singleEdge_eq_one_of_fintype_card_two hab hcard w
  have hedge₂ (w : S) : (singleEdge c d).degree w = 1 :=
    degree_singleEdge_eq_one_of_fintype_card_two hcd hcard w
  have hbase : 2 ≤ (G.induce S).mult us vs := by
    simpa [us, vs] using hmult
  intro use₁ use₂ huse
  cases use₁ <;> cases use₂
  · simp at huse
  · let F : Pseudograph S := edgeCopies 2 us vs
    let H : Pseudograph S := F + singleEdge c d
    have hFpart : F.IsPart (G.induce S) := edgeCopies_isPart hbase
    have hHpart : H.IsPart (G.closeFourCutPairWith S E p) := by
      intro x y
      have hFxy := hFpart x y
      change F.mult x y + (singleEdge c d).mult x y ≤
        ((G.induce S).mult x y + (singleEdge a b).mult x y) +
          (singleEdge c d).mult x y
      omega
    have hHdeg (w : S) : H.degree w = 3 := by
      change (F + singleEdge c d).degree w = 3
      rw [degree_add,
        degree_edgeCopies_eq_of_fintype_card_two 2 huvs hcard, hedge₂]
    refine ⟨H, F, hHpart, ⟨us, hHdeg us⟩,
      fun w ↦ .inr (hHdeg w), hFpart, ?_⟩
    intro w
    simp [pairClosingDegree, H, degree_add, a, b, c, d]
  · let F : Pseudograph S := edgeCopies 2 us vs
    let H : Pseudograph S := F + singleEdge a b
    have hFpart : F.IsPart (G.induce S) := edgeCopies_isPart hbase
    have hHpart : H.IsPart (G.closeFourCutPairWith S E p) := by
      intro x y
      have hFxy := hFpart x y
      change F.mult x y + (singleEdge a b).mult x y ≤
        ((G.induce S).mult x y + (singleEdge a b).mult x y) +
          (singleEdge c d).mult x y
      omega
    have hHdeg (w : S) : H.degree w = 3 := by
      change (F + singleEdge a b).degree w = 3
      rw [degree_add,
        degree_edgeCopies_eq_of_fintype_card_two 2 huvs hcard, hedge₁]
    refine ⟨H, F, hHpart, ⟨us, hHdeg us⟩,
      fun w ↦ .inr (hHdeg w), hFpart, ?_⟩
    intro w
    simp [pairClosingDegree, H, degree_add, a, b, c, d]
  · let F : Pseudograph S := edgeCopies 1 us vs
    let H : Pseudograph S := (F + singleEdge a b) + singleEdge c d
    have hFpart : F.IsPart (G.induce S) :=
      edgeCopies_isPart (show 1 ≤ (G.induce S).mult us vs by omega)
    have hHpart : H.IsPart (G.closeFourCutPairWith S E p) := by
      intro x y
      have hFxy := hFpart x y
      change (F.mult x y + (singleEdge a b).mult x y) +
          (singleEdge c d).mult x y ≤
        ((G.induce S).mult x y + (singleEdge a b).mult x y) +
          (singleEdge c d).mult x y
      omega
    have hHdeg (w : S) : H.degree w = 3 := by
      change ((F + singleEdge a b) + singleEdge c d).degree w = 3
      rw [degree_add, degree_add,
        degree_edgeCopies_eq_of_fintype_card_two 1 huvs hcard,
        hedge₁, hedge₂]
    refine ⟨H, F, hHpart, ⟨us, hHdeg us⟩,
      fun w ↦ .inr (hHdeg w), hFpart, ?_⟩
    intro w
    simp [pairClosingDegree, H, degree_add, a, b, c, d]
    omega

/-- Every part of a paired closure admits a labelled decomposition.  The
greedy order allocates a coincident artificial copy to the first pair unless
both copies are used; this makes the statement valid even for parallel
closing edges. -/
lemma exists_pairClosureDecomposition
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (H : Pseudograph S) (hH : H.IsPart (G.closeFourCutPairWith S E p)) :
    ∃ use₁ use₂ : Bool, ∃ F : Pseudograph S,
      PairClosureDecomposition E p H use₁ use₂ F := by
  classical
  let B := G.induce S
  let a := pairEndpoint E p.a
  let b := pairEndpoint E p.b
  let c := pairEndpoint E p.c
  let d := pairEndpoint E p.d
  have hH' : H.IsPart ((B + singleEdge a b) + singleEdge c d) := by
    simpa [B, a, b, c, d, closeFourCutPairWith, pairEndpoint] using hH
  by_cases huse₂ : (B + singleEdge a b).mult c d < H.mult c d
  · let H₂ := H.removeSingleEdge c d
    have hpos₂ : 0 < H.mult c d := lt_of_le_of_lt (Nat.zero_le _) huse₂
    have hH₂ : H₂.IsPart (B + singleEdge a b) := by
      exact removeSingleEdge_isPart_left hH'
    have hdeg₂ (v : S) : H₂.degree v + (singleEdge c d).degree v =
        H.degree v := by
      have h := degree_removeSingleEdge_add H c d v hpos₂
      rw [degree_singleEdge]
      split_ifs at h ⊢ <;> omega
    by_cases huse₁ : B.mult a b < H₂.mult a b
    · let F := H₂.removeSingleEdge a b
      have hpos₁ : 0 < H₂.mult a b :=
        lt_of_le_of_lt (Nat.zero_le _) huse₁
      have hF : F.IsPart B := removeSingleEdge_isPart_left hH₂
      have hdeg₁ (v : S) : F.degree v + (singleEdge a b).degree v =
          H₂.degree v := by
        have h := degree_removeSingleEdge_add H₂ a b v hpos₁
        rw [degree_singleEdge]
        split_ifs at h ⊢ <;> omega
      refine ⟨true, true, F, hF, ?_⟩
      intro v
      have h1 := hdeg₁ v
      have h2 := hdeg₂ v
      simp [pairClosingDegree]
      change F.degree v +
        ((singleEdge a b).degree v + (singleEdge c d).degree v) =
        H.degree v
      omega
    · have hH₂B : H₂.IsPart B :=
        isPart_left_of_isPart_add_of_mult_le hH₂ (Nat.le_of_not_gt huse₁)
      refine ⟨false, true, H₂, hH₂B, ?_⟩
      intro v
      have h2 := hdeg₂ v
      simp [pairClosingDegree]
      change H₂.degree v + (singleEdge c d).degree v = H.degree v
      exact h2
  · have hHB₁ : H.IsPart (B + singleEdge a b) :=
      isPart_left_of_isPart_add_of_mult_le hH' (Nat.le_of_not_gt huse₂)
    by_cases huse₁ : B.mult a b < H.mult a b
    · let F := H.removeSingleEdge a b
      have hpos₁ : 0 < H.mult a b :=
        lt_of_le_of_lt (Nat.zero_le _) huse₁
      have hF : F.IsPart B := removeSingleEdge_isPart_left hHB₁
      have hdeg₁ (v : S) : F.degree v + (singleEdge a b).degree v =
          H.degree v := by
        have h := degree_removeSingleEdge_add H a b v hpos₁
        rw [degree_singleEdge]
        split_ifs at h ⊢ <;> omega
      refine ⟨true, false, F, hF, ?_⟩
      intro v
      have h1 := hdeg₁ v
      simp [pairClosingDegree]
      change F.degree v + (singleEdge a b).degree v = H.degree v
      exact h1
    · have hHB : H.IsPart B :=
        isPart_left_of_isPart_add_of_mult_le hHB₁ (Nat.le_of_not_gt huse₁)
      refine ⟨false, false, H, hHB, ?_⟩
      intro v
      simp [pairClosingDegree]

noncomputable def reverseFourCutListing
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) : Fin 4 ≃ CrossingEdge G Sᶜ :=
  E.trans (G.reverseCrossingEdgeEquiv S)

@[simp]
lemma reverseFourCutListing_inside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (i : Fin 4) :
    (reverseFourCutListing E i).inside = (E i).outside :=
  rfl

lemma pairClosingDegree_reverse_eq_outside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (v : W) (hv : v ∉ S) :
    pairClosingDegree (reverseFourCutListing E) p use₁ use₂
        ⟨v, Finset.mem_compl.mpr hv⟩ =
      pairIncidenceOutside E p use₁ use₂ v := by
  rw [pairClosingDegree_eq_incidence]
  by_cases ha : v = (E p.a).outside <;>
    by_cases hb : v = (E p.b).outside <;>
    by_cases hc : v = (E p.c).outside <;>
    by_cases hd : v = (E p.d).outside <;>
    cases use₁ <;> cases use₂ <;>
    simp [pairIncidenceInside, pairIncidenceOutside,
      reverseFourCutListing, reverseCrossingEdgeEquiv, reverseCrossingEdge,
      ha, hb, hc, hd]

/-- Splice two decomposed paired-closure parts using exactly the two labelled
blocks selected by their common use pattern. -/
noncomputable def spliceFourCutPairs
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (F : Pseudograph S)
    (L : Pseudograph ↑(Sᶜ)) : Pseudograph W :=
  extendFrom S F + extendFrom Sᶜ L +
    crossingPairSelection E p use₁ use₂

lemma degree_spliceFourCutPairs_of_mem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (H : Pseudograph S) (use₁ use₂ : Bool) (F : Pseudograph S)
    (hdec : PairClosureDecomposition E p H use₁ use₂ F)
    (L : Pseudograph ↑(Sᶜ)) (v : W) (hv : v ∈ S) :
    (spliceFourCutPairs E p use₁ use₂ F L).degree v =
      H.degree ⟨v, hv⟩ := by
  have hvC : v ∉ Sᶜ := by simp [hv]
  rw [spliceFourCutPairs, degree_add, degree_add,
    degree_extendFrom_of_mem S F v hv,
    degree_extendFrom_of_notMem Sᶜ L v hvC,
    degree_crossingPairSelection_of_mem E p use₁ use₂ v hv,
    Nat.add_zero]
  have hclose := pairClosingDegree_eq_incidence E p use₁ use₂ ⟨v, hv⟩
  rw [← hclose]
  exact hdec.2 ⟨v, hv⟩

lemma degree_spliceFourCutPairs_of_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (K : Pseudograph ↑(Sᶜ)) (use₁ use₂ : Bool)
    (L : Pseudograph ↑(Sᶜ))
    (hdec : PairClosureDecomposition (reverseFourCutListing E) p K
      use₁ use₂ L)
    (F : Pseudograph S) (v : W) (hv : v ∉ S) :
    (spliceFourCutPairs E p use₁ use₂ F L).degree v =
      K.degree ⟨v, Finset.mem_compl.mpr hv⟩ := by
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  rw [spliceFourCutPairs, degree_add, degree_add,
    degree_extendFrom_of_notMem S F v hv,
    degree_extendFrom_of_mem Sᶜ L v hvC,
    degree_crossingPairSelection_of_notMem E p use₁ use₂ v hv,
    Nat.zero_add]
  have hclose := pairClosingDegree_reverse_eq_outside
    E p use₁ use₂ v hv
  rw [← hclose]
  exact hdec.2 ⟨v, hvC⟩

lemma spliceFourCutPairs_isPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 4 ≃ CrossingEdge G S) (p : FourPairing)
    (use₁ use₂ : Bool) (F : Pseudograph S)
    (L : Pseudograph ↑(Sᶜ))
    (hF : F.IsPart (G.induce S))
    (hL : L.IsPart (G.induce Sᶜ)) :
    (spliceFourCutPairs E p use₁ use₂ F L).IsPart G := by
  classical
  have hcross := crossingPairSelection_isPart E p use₁ use₂
  intro u v
  by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∉ Sᶜ := by simp [hv]
    have hsel : (crossingPairSelection E p use₁ use₂).mult u v = 0 := by
      cases use₁ <;> cases use₂ <;>
        simp [crossingPairSelection, crossingPart, hu, hv]
    simp [spliceFourCutPairs, extendFrom, hu, hv, huC, hvC, hsel]
    exact hF ⟨u, hu⟩ ⟨v, hv⟩
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    simp [spliceFourCutPairs, extendFrom, hu, hv, huC, hvC]
    exact hcross u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∉ Sᶜ := by simp [hv]
    simp [spliceFourCutPairs, extendFrom, hu, hv, huC, hvC]
    exact hcross u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    have hsel : (crossingPairSelection E p use₁ use₂).mult u v = 0 := by
      cases use₁ <;> cases use₂ <;>
        simp [crossingPairSelection, crossingPart, hu, hv]
    simp [spliceFourCutPairs, extendFrom, hu, hv, huC, hvC, hsel]
    exact hL ⟨u, huC⟩ ⟨v, hvC⟩

/-- **Paired four-cut gluing (Tashkinov, Proposition 2.5).**  Three local
witnesses realizing the nonzero use patterns of the two artificial closing
edges splice against every cubic part of the oppositely oriented closure. -/
theorem containsRegularPart_of_fourCutPairClosures
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 4) (p : FourPairing)
    (hS : ∀ use₁ use₂ : Bool, use₁ = true ∨ use₂ = true →
      ∃ H F : Pseudograph S,
        H.IsPart (G.closeFourCutPairWith S (G.cutEquiv S hcut).symm p) ∧
        (∃ v, H.degree v = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        PairClosureDecomposition (G.cutEquiv S hcut).symm p
          H use₁ use₂ F)
    (hC : (G.oppositePairClosure S hcut p).ContainsRegularPart 3) :
    G.ContainsRegularPart 3 := by
  classical
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ := G.reversedFourCutListing S hcut
  obtain ⟨K, hKpart, hKne, hKdeg⟩ := hC
  obtain ⟨use₁, use₂, L, hKdec⟩ :=
    exists_pairClosureDecomposition EC p K
      (by simpa [EC, oppositePairClosure] using hKpart)
  have hEC : EC = reverseFourCutListing E := by rfl
  have hKdec' : PairClosureDecomposition (reverseFourCutListing E) p K
      use₁ use₂ L := by simpa [hEC] using hKdec
  have hliftZero (h₁ : use₁ = false) (h₂ : use₂ = false) :
      G.ContainsRegularPart 3 := by
    have hLdeg (v : ↑(Sᶜ)) : L.degree v = K.degree v := by
      have h := hKdec'.2 v
      simp [pairClosingDegree, h₁, h₂] at h
      exact h
    refine ⟨extendFrom Sᶜ L, extendFrom_isPart hKdec'.1, ?_, ?_⟩
    · obtain ⟨v, hv⟩ := hKne
      exact ⟨v, (degree_extendFrom_of_mem Sᶜ L v v.2).trans
        ((hLdeg v).trans hv)⟩
    · intro v
      by_cases hv : v ∈ Sᶜ
      · rw [degree_extendFrom_of_mem Sᶜ L v hv, hLdeg]
        exact hKdeg ⟨v, hv⟩
      · exact .inl (degree_extendFrom_of_notMem Sᶜ L v hv)
  have hsplice (huse : use₁ = true ∨ use₂ = true) :
      G.ContainsRegularPart 3 := by
    obtain ⟨H, F, hHpart, hHne, hHdeg, hHdec⟩ := hS use₁ use₂ huse
    have hHdec' : PairClosureDecomposition E p H use₁ use₂ F := by
      simpa [E] using hHdec
    let J := spliceFourCutPairs E p use₁ use₂ F L
    refine ⟨J,
      spliceFourCutPairs_isPart E p use₁ use₂ F L hHdec'.1 hKdec'.1,
      ?_, ?_⟩
    · obtain ⟨v, hv⟩ := hHne
      exact ⟨v, (degree_spliceFourCutPairs_of_mem E p H use₁ use₂ F
        hHdec' L v v.2).trans hv⟩
    · intro v
      by_cases hv : v ∈ S
      · rw [degree_spliceFourCutPairs_of_mem E p H use₁ use₂ F
          hHdec' L v hv]
        exact hHdeg ⟨v, hv⟩
      · rw [degree_spliceFourCutPairs_of_notMem E p K use₁ use₂ L
          hKdec' F v hv]
        exact hKdeg ⟨v, Finset.mem_compl.mpr hv⟩
  cases use₁ <;> cases use₂
  · exact hliftZero rfl rfl
  · exact hsplice (.inr rfl)
  · exact hsplice (.inl rfl)
  · exact hsplice (.inl rfl)

/-- In either bad cross-pair closure of a loopless double edge, two distinct
cut labels at the same double-edge endpoint must have distinct outside
endpoints.  Equality would create a second parallel pair, exhaust the defect
budget, and force the bad closure back into class `B`. -/
lemma outside_ne_of_same_inside_of_bad_oppositePairClosure
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4) (p : FourPairing)
    (hp₁ : ((G.cutEquiv S hcut).symm p.a).inside ≠
      ((G.cutEquiv S hcut).symm p.b).inside)
    (hp₂ : ((G.cutEquiv S hcut).symm p.c).inside ≠
      ((G.cutEquiv S hcut).symm p.d).inside)
    (hbad : ¬(G.oppositePairClosure S hcut p).InTashkinovClass)
    {i j : Fin 4} (hij : i ≠ j)
    (hsame : ((G.cutEquiv S hcut).symm i).inside =
      ((G.cutEquiv S hcut).symm j).inside) :
    ((G.cutEquiv S hcut).symm i).outside ≠
      ((G.cutEquiv S hcut).symm j).outside := by
  classical
  subst S
  let E : Fin 4 ≃ CrossingEdge G ({u, v} : Finset W) :=
    (G.cutEquiv {u, v} hcut).symm
  let EC : Fin 4 ≃ CrossingEdge G ({u, v} : Finset W)ᶜ :=
    G.reversedFourCutListing {u, v} hcut
  let t := (E i).inside
  let z := (E i).outside
  have hvalues (k : Fin 4) : (E k).inside = u ∨ (E k).inside = v := by
    simpa [E] using (E k).inside_mem
  have hzu : z ≠ u := by
    intro h
    exact (E i).outside_notMem (by simp [z, h])
  have hzv : z ≠ v := by
    intro h
    exact (E i).outside_notMem (by simp [z, h])
  intro hout
  have hparallelTZ : 2 ≤ G.mult t z := by
    have hEiEj : E i ≠ E j := fun h ↦ hij (E.injective h)
    have h := two_le_mult_of_distinct_crossingEdges_same_endpoints
      hEiEj (by simpa [t, E] using hsame) (by simpa [z, E] using hout)
    simpa [t, z] using h
  have ht : t = u ∨ t = v := by
    simpa [t] using hvalues i
  have hsimpleD :
      (G.induce ({u, v} : Finset W)ᶜ).HasSimpleMultiplicities := by
    rcases ht with htu | htv
    · apply G.induce_hasSimpleMultiplicities_of_two_parallel_star_outside
        hclass ({u, v} : Finset W)ᶜ (by simp) huv hzu.symm hzv.symm
        huvTwo
      simpa [htu] using hparallelTZ
    · apply G.induce_hasSimpleMultiplicities_of_two_parallel_star_outside
        hclass ({u, v} : Finset W)ᶜ (by simp) huv.symm hzv.symm hzu.symm
        (by simpa only [G.mult_comm] using huvTwo)
      simpa [htv] using hparallelTZ
  let a := pairEndpoint EC p.a
  let b := pairEndpoint EC p.b
  let c := pairEndpoint EC p.c
  let d := pairEndpoint EC p.d
  have hnotTwoLoops : ¬(a = b ∧ c = d) := by
    rintro ⟨hab, hcd⟩
    have hblock₁ : (E p.a).outside = (E p.b).outside := by
      have h := congrArg Subtype.val hab
      simpa [a, b, EC, E, pairEndpoint, reversedFourCutListing,
        reverseCrossingEdgeEquiv, reverseCrossingEdge] using h
    have hblock₂ : (E p.c).outside = (E p.d).outside := by
      have h := congrArg Subtype.val hcd
      simpa [c, d, EC, E, pairEndpoint, reversedFourCutListing,
        reverseCrossingEdgeEquiv, reverseCrossingEdge] using h
    have hall : ∀ k, (E k).outside = z := by
      intro k
      have h := FourPairing.all_values_eq_of_block_values_eq_of_same_color
        p (fun r ↦ (E r).inside) (fun r ↦ (E r).outside)
        (by simpa [E] using hp₁) (by simpa [E] using hp₂)
        hij (by simpa [E] using hsame) (by simpa [z, E] using hout)
        hblock₁ hblock₂ k
      simpa [z] using h
    rcases ht with htu | htv
    · obtain ⟨k, l, hkl, hk, hl⟩ :=
        FourPairing.exists_two_labels_of_right_color p
          (fun r ↦ (E r).inside) huv hvalues
          (by simpa [E] using hp₁) (by simpa [E] using hp₂)
      have hparallelVZ : 2 ≤ G.mult v z := by
        have h := two_le_mult_of_distinct_crossingEdges_same_endpoints
          (fun h ↦ hkl (E.injective h)) (hk.trans hl.symm)
          ((hall k).trans (hall l).symm)
        simpa [hk, hall k] using h
      have hsimpleVZ :=
        G.induce_hasSimpleMultiplicities_of_two_parallel_star_outside
          hclass ({v, z} : Finset W) (by simp [huv, hzu.symm])
          huv hzu.symm hzv.symm huvTwo (by simpa [htu] using hparallelTZ)
      let vs : ({v, z} : Finset W) := ⟨v, by simp⟩
      let zs : ({v, z} : Finset W) := ⟨z, by simp⟩
      have hle := hsimpleVZ.2 vs zs
      change G.mult v z ≤ 1 at hle
      omega
    · have hvalues' (k : Fin 4) : (E k).inside = v ∨ (E k).inside = u :=
        (hvalues k).symm
      obtain ⟨k, l, hkl, hk, hl⟩ :=
        FourPairing.exists_two_labels_of_right_color p
          (fun r ↦ (E r).inside) huv.symm hvalues'
          (by simpa [E] using hp₁) (by simpa [E] using hp₂)
      have hparallelUZ : 2 ≤ G.mult u z := by
        have h := two_le_mult_of_distinct_crossingEdges_same_endpoints
          (fun h ↦ hkl (E.injective h)) (hk.trans hl.symm)
          ((hall k).trans (hall l).symm)
        simpa [hk, hall k] using h
      have hsimpleUZ :=
        G.induce_hasSimpleMultiplicities_of_two_parallel_star_outside
          hclass ({u, z} : Finset W) (by simp [huv.symm, hzv.symm])
          huv.symm hzv.symm hzu.symm
          (by simpa only [G.mult_comm] using huvTwo)
          (by simpa [htv] using hparallelTZ)
      let us : ({u, z} : Finset W) := ⟨u, by simp⟩
      let zs : ({u, z} : Finset W) := ⟨z, by simp⟩
      have hle := hsimpleUZ.2 us zs
      change G.mult u z ≤ 1 at hle
      omega
  have hreg : (((G.induce ({u, v} : Finset W)ᶜ + singleEdge a b) +
      singleEdge c d)).IsRegularOfDegree 4 := by
    simpa [EC, a, b, c, d, closeFourCutPairWith, pairEndpoint] using
      G.closeFourCutPairWith_isRegularOfDegree
        ({u, v} : Finset W)ᶜ EC p hclass.1
  have hclosure := add_two_singleEdges_inTashkinovClass_of_hasSimpleMultiplicities
    (G.induce ({u, v} : Finset W)ᶜ) hsimpleD a b c d hreg hnotTwoLoops
  apply hbad
  simpa [oppositePairClosure, EC, a, b, c, d,
    closeFourCutPairWith, pairEndpoint] using hclosure

/-- Failure of an opposite paired closure to remain in class `B` is witnessed
on its four labelled outside endpoints by a loop, a pre-existing edge, or
coincidence of the two unordered closing pairs. -/
lemma oppositePairClosure_local_obstruction_of_parallelPair
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4) (p : FourPairing)
    (hbad : ¬(G.oppositePairClosure S hcut p).InTashkinovClass) :
    let EC : Fin 4 ≃ CrossingEdge G Sᶜ := G.reversedFourCutListing S hcut
    let a := pairEndpoint EC p.a
    let b := pairEndpoint EC p.b
    let c := pairEndpoint EC p.c
    let d := pairEndpoint EC p.d
    a = b ∨ c = d ∨ 0 < (G.induce Sᶜ).mult a b ∨
      0 < (G.induce Sᶜ).mult c d ∨
      (a, b) = (c, d) ∨ (a, b) = (d, c) := by
  classical
  dsimp only
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    G.reversedFourCutListing S hcut
  let a := pairEndpoint EC p.a
  let b := pairEndpoint EC p.b
  let c := pairEndpoint EC p.c
  let d := pairEndpoint EC p.d
  have hdefect : (G.induce Sᶜ).loopCount +
      (G.induce Sᶜ).parallelPairCount ≤ 1 := by
    rw [hS]
    exact G.induce_compl_defect_le_one_of_parallel_pair
      hclass huv huvTwo
  have hreg : (((G.induce Sᶜ + singleEdge a b) + singleEdge c d)).IsRegularOfDegree 4 := by
    simpa [EC, a, b, c, d, closeFourCutPairWith, pairEndpoint] using
      G.closeFourCutPairWith_isRegularOfDegree Sᶜ EC p hclass.1
  have hbad' : ¬((G.induce Sᶜ + singleEdge a b) +
      singleEdge c d).InTashkinovClass := by
    simpa [oppositePairClosure, EC, a, b, c, d,
      closeFourCutPairWith, pairEndpoint] using hbad
  exact local_obstruction_of_add_two_edges_not_inTashkinovClass
    (G.induce Sᶜ) hdefect hreg hbad'

/-- If both closing edges of a bad opposite-shore closure are nonloops,
they cannot be two copies of the same unordered edge.  Two such copies use
only one parallel-pair unit and therefore remain inside class `B`. -/
lemma bad_oppositePairClosure_closingPairs_ne
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4) (p : FourPairing)
    (hbad : ¬(G.oppositePairClosure S hcut p).InTashkinovClass) :
    let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
      G.reversedFourCutListing S hcut
    let a := pairEndpoint EC p.a
    let b := pairEndpoint EC p.b
    let c := pairEndpoint EC p.c
    let d := pairEndpoint EC p.d
    a ≠ b → c ≠ d → (a, b) ≠ (c, d) ∧ (a, b) ≠ (d, c) := by
  classical
  dsimp only
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    G.reversedFourCutListing S hcut
  let a := pairEndpoint EC p.a
  let b := pairEndpoint EC p.b
  let c := pairEndpoint EC p.c
  let d := pairEndpoint EC p.d
  intro hab hcd
  have hdefect : (G.induce Sᶜ).loopCount +
      (G.induce Sᶜ).parallelPairCount ≤ 1 := by
    rw [hS]
    exact G.induce_compl_defect_le_one_of_parallel_pair
      hclass huv huvTwo
  have hreg : (((G.induce Sᶜ + singleEdge a b) +
      singleEdge c d)).IsRegularOfDegree 4 := by
    simpa [EC, a, b, c, d, closeFourCutPairWith, pairEndpoint] using
      G.closeFourCutPairWith_isRegularOfDegree Sᶜ EC p hclass.1
  have hbad' : ¬((G.induce Sᶜ + singleEdge a b) +
      singleEdge c d).InTashkinovClass := by
    simpa [oppositePairClosure, EC, a, b, c, d,
      closeFourCutPairWith, pairEndpoint] using hbad
  constructor
  · intro hpairs
    have hac : a = c := congrArg Prod.fst hpairs
    have hbd : b = d := congrArg Prod.snd hpairs
    rw [← hac, ← hbd] at hreg hbad'
    exact hbad' (add_two_same_nonloop_edges_inTashkinovClass
      (G.induce Sᶜ) hdefect hab hreg)
  · intro hpairs
    have had : a = d := congrArg Prod.fst hpairs
    have hbc : b = c := congrArg Prod.snd hpairs
    rw [← had, ← hbc] at hreg hbad'
    have hreg' : (((G.induce Sᶜ + singleEdge a b) +
        singleEdge a b)).IsRegularOfDegree 4 := by
      simpa only [singleEdge_comm b a] using hreg
    have hin := add_two_same_nonloop_edges_inTashkinovClass
      (G.induce Sᶜ) hdefect hab hreg'
    apply hbad'
    simpa only [singleEdge_comm b a] using hin

/-- Once the two nonloop closing pairs of a bad closure are genuinely
different, each closing edge was already present on the unclosed shore.
Otherwise adding the absent one and the other edge consumes at most one new
parallel-pair unit and stays in class `B`. -/
lemma bad_oppositePairClosure_forces_existing_closingEdges
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4) (p : FourPairing)
    (hbad : ¬(G.oppositePairClosure S hcut p).InTashkinovClass) :
    let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
      G.reversedFourCutListing S hcut
    let a := pairEndpoint EC p.a
    let b := pairEndpoint EC p.b
    let c := pairEndpoint EC p.c
    let d := pairEndpoint EC p.d
    a ≠ b → c ≠ d → (a, b) ≠ (c, d) → (a, b) ≠ (d, c) →
      0 < (G.induce Sᶜ).mult a b ∧
        0 < (G.induce Sᶜ).mult c d := by
  classical
  dsimp only
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    G.reversedFourCutListing S hcut
  let a := pairEndpoint EC p.a
  let b := pairEndpoint EC p.b
  let c := pairEndpoint EC p.c
  let d := pairEndpoint EC p.d
  intro hab hcd hne₁ hne₂
  have hdefect : (G.induce Sᶜ).loopCount +
      (G.induce Sᶜ).parallelPairCount ≤ 1 := by
    rw [hS]
    exact G.induce_compl_defect_le_one_of_parallel_pair
      hclass huv huvTwo
  have hreg : (((G.induce Sᶜ + singleEdge a b) +
      singleEdge c d)).IsRegularOfDegree 4 := by
    simpa [EC, a, b, c, d, closeFourCutPairWith, pairEndpoint] using
      G.closeFourCutPairWith_isRegularOfDegree Sᶜ EC p hclass.1
  have hbad' : ¬((G.induce Sᶜ + singleEdge a b) +
      singleEdge c d).InTashkinovClass := by
    simpa [oppositePairClosure, EC, a, b, c, d,
      closeFourCutPairWith, pairEndpoint] using hbad
  constructor
  · by_contra hz
    have hz' : (G.induce Sᶜ).mult a b = 0 := Nat.eq_zero_of_not_pos hz
    exact hbad' (add_two_distinct_nonloop_edges_inTashkinovClass_of_one_fresh
      (G.induce Sᶜ) hdefect hab hcd hne₁ hne₂ (.inl hz') hreg)
  · by_contra hz
    have hz' : (G.induce Sᶜ).mult c d = 0 := Nat.eq_zero_of_not_pos hz
    exact hbad' (add_two_distinct_nonloop_edges_inTashkinovClass_of_one_fresh
      (G.induce Sᶜ) hdefect hab hcd hne₁ hne₂ (.inr hz') hreg)

/-- The explicit cubic part in the four-distinct-endpoint branch of
Tashkinov's parallel-edge argument.  It consists of one copy of `uv`, all
four cut edges, and the `K₂,₂` between their four outside endpoints. -/
lemma containsRegularPart_of_doubleEdge_fourOutside_complete
    (G : Pseudograph W) {u v : W} (huv : u ≠ v)
    (huvPos : 0 < G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (houtU : G.outsideDegree S u = 2)
    (houtV : G.outsideDegree S v = 2)
    (E : Fin 4 ≃ CrossingEdge G S) :
    let a := (E 0).outside
    let b := (E 1).outside
    let c := (E 2).outside
    let d := (E 3).outside
    a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d →
    0 < G.mult a c → 0 < G.mult a d →
    0 < G.mult b c → 0 < G.mult b d →
    G.ContainsRegularPart 3 := by
  classical
  dsimp only
  let a := (E 0).outside
  let b := (E 1).outside
  let c := (E 2).outside
  let d := (E 3).outside
  intro hab hac had hbc hbd hcd hAC hAD hBC hBD
  change a ≠ b at hab
  change a ≠ c at hac
  change a ≠ d at had
  change b ≠ c at hbc
  change b ≠ d at hbd
  change c ≠ d at hcd
  change 0 < G.mult a c at hAC
  change 0 < G.mult a d at hAD
  change 0 < G.mult b c at hBC
  change 0 < G.mult b d at hBD
  let K : Pseudograph W :=
    ((singleEdge a c + singleEdge a d) + singleEdge b c) +
      singleEdge b d
  let H : Pseudograph W :=
    (edgeCopies 1 u v + G.crossingPart S) + K
  have haS : a ∉ S := (E 0).outside_notMem
  have hbS : b ∉ S := (E 1).outside_notMem
  have hcS : c ∉ S := (E 2).outside_notMem
  have hdS : d ∉ S := (E 3).outside_notMem
  have hKpart : K.IsPart G := by
    simpa [K] using fourCrossEdges_isPart hab hac had hbc hbd hcd
      hAC hAD hBC hBD
  have hEpart : (edgeCopies 1 u v).IsPart G :=
    edgeCopies_isPart huvPos
  have hHpart : H.IsPart G := by
    intro x y
    by_cases hx : x ∈ S <;> by_cases hy : y ∈ S
    · have hxa : x ≠ a := fun h ↦ haS (h ▸ hx)
      have hxb : x ≠ b := fun h ↦ hbS (h ▸ hx)
      have hxc : x ≠ c := fun h ↦ hcS (h ▸ hx)
      have hxd : x ≠ d := fun h ↦ hdS (h ▸ hx)
      have hya : y ≠ a := fun h ↦ haS (h ▸ hy)
      have hyb : y ≠ b := fun h ↦ hbS (h ▸ hy)
      have hyc : y ≠ c := fun h ↦ hcS (h ▸ hy)
      have hyd : y ≠ d := fun h ↦ hdS (h ▸ hy)
      have he := hEpart x y
      simpa [H, K, add_mult, crossingPart_mult, hx, hy,
        singleEdge_mult, hxa, hxb, hxc, hxd, hya, hyb, hyc, hyd] using he
    · have hyu : y ≠ u := by
        intro h
        subst y
        exact hy (by simpa [hS])
      have hyv : y ≠ v := by
        intro h
        subst y
        exact hy (by simpa [hS])
      have hxa : x ≠ a := fun h ↦ haS (h ▸ hx)
      have hxb : x ≠ b := fun h ↦ hbS (h ▸ hx)
      have hxc : x ≠ c := fun h ↦ hcS (h ▸ hx)
      have hxd : x ≠ d := fun h ↦ hdS (h ▸ hx)
      simp [H, K, add_mult, crossingPart_mult, hx, hy,
        edgeCopies_mult, hyu, hyv, hxa, hxb, hxc, hxd]
    · have hxu : x ≠ u := by
        intro h
        subst x
        exact hx (by simpa [hS])
      have hxv : x ≠ v := by
        intro h
        subst x
        exact hx (by simpa [hS])
      have hya : y ≠ a := fun h ↦ haS (h ▸ hy)
      have hyb : y ≠ b := fun h ↦ hbS (h ▸ hy)
      have hyc : y ≠ c := fun h ↦ hcS (h ▸ hy)
      have hyd : y ≠ d := fun h ↦ hdS (h ▸ hy)
      simp [H, K, add_mult, crossingPart_mult, hx, hy,
        edgeCopies_mult, hxu, hxv, hya, hyb, hyc, hyd]
    · have hxu : x ≠ u := by
        intro h
        subst x
        exact hx (by simpa [hS])
      have hxv : x ≠ v := by
        intro h
        subst x
        exact hx (by simpa [hS])
      have hyu : y ≠ u := by
        intro h
        subst y
        exact hy (by simpa [hS])
      have hyv : y ≠ v := by
        intro h
        subst y
        exact hy (by simpa [hS])
      have hk := hKpart x y
      simpa [H, add_mult, crossingPart_mult, hx, hy,
        edgeCopies_mult, hxu, hxv, hyu, hyv] using hk
  have hcrossOutside (x : W) (hx : x ∉ S) :
      (G.crossingPart S).degree x =
        (if x = a then 1 else 0) + (if x = b then 1 else 0) +
          (if x = c then 1 else 0) + (if x = d then 1 else 0) := by
    let EC : Fin 4 ≃ CrossingEdge G Sᶜ := reverseFourCutListing E
    rw [G.degree_crossingPart_of_notMem S x hx,
      G.outsideDegree_eq_listingEndpointCount Sᶜ EC x
        (Finset.mem_compl.mpr hx)]
    unfold listingEndpointCount
    rw [Fin.sum_univ_four]
    change ((if (E 0).outside = x then 1 else 0) +
          (if (E 1).outside = x then 1 else 0) +
          (if (E 2).outside = x then 1 else 0) +
          (if (E 3).outside = x then 1 else 0)) =
      (if x = a then 1 else 0) + (if x = b then 1 else 0) +
        (if x = c then 1 else 0) + (if x = d then 1 else 0)
    have hab' : b ≠ a := hab.symm
    have hac' : c ≠ a := hac.symm
    have had' : d ≠ a := had.symm
    have hbc' : c ≠ b := hbc.symm
    have hbd' : d ≠ b := hbd.symm
    have hcd' : d ≠ c := hcd.symm
    by_cases hxa : x = a <;> by_cases hxb : x = b <;>
      by_cases hxc : x = c <;> by_cases hxd : x = d <;>
      simp_all only [a, b, c, d, eq_comm, if_pos, if_neg, ne_eq,
        not_true_eq_false,
        not_false_eq_true, true_or, or_true, false_or, or_false,
        true_and, and_true, false_and, and_false, add_zero, zero_add]
  have hdegree (x : W) : H.degree x = 0 ∨ H.degree x = 3 := by
    by_cases hx : x ∈ S
    · have hxuv : x = u ∨ x = v := by
        simpa [hS] using hx
      have hxa : x ≠ a := fun h ↦ haS (h ▸ hx)
      have hxb : x ≠ b := fun h ↦ hbS (h ▸ hx)
      have hxc : x ≠ c := fun h ↦ hcS (h ▸ hx)
      have hxd : x ≠ d := fun h ↦ hdS (h ▸ hx)
      have hcross : (G.crossingPart S).degree x = 2 := by
        rw [G.degree_crossingPart_of_mem S x hx]
        rcases hxuv with rfl | rfl
        · exact houtU
        · exact houtV
      right
      simp [H, K, degree_add, degree_edgeCopies_of_ne 1 huv,
        degree_singleEdge, hcross, hxuv, hxa, hxb, hxc, hxd]
    · have hxu : x ≠ u := by
        intro h
        subst x
        exact hx (by simpa [hS])
      have hxv : x ≠ v := by
        intro h
        subst x
        exact hx (by simpa [hS])
      simp only [H]
      rw [degree_add, degree_add,
        degree_edgeCopies_of_ne 1 huv, hcrossOutside x hx]
      simp only [K, degree_add, degree_singleEdge]
      by_cases hxa : x = a <;> by_cases hxb : x = b <;>
        by_cases hxc : x = c <;> by_cases hxd : x = d <;>
        simp_all
  refine ⟨H, hHpart, ⟨u, ?_⟩, hdegree⟩
  apply (hdegree u).resolve_left
  intro hz
  have hpartDegree : (edgeCopies 1 u v).degree u ≤ H.degree u := by
    simp only [H]
    rw [degree_add, degree_add]
    omega
  rw [degree_edgeCopies_of_ne 1 huv, hz] at hpartDegree
  simp at hpartDegree

/-- The two cross-pairings complementary to a monochromatic pairing supply
all four edges of the `K₂,₂` between the two monochromatic blocks, provided
the four outside endpoints are distinct. -/
lemma bad_crossPairings_force_completeOutside
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4)
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q)
    (hbadp : ¬(G.oppositePairClosure S hcut p).InTashkinovClass)
    (hbadq : ¬(G.oppositePairClosure S hcut q).InTashkinovClass)
    (hdistinct : ∀ i j : Fin 4, i ≠ j →
      ((G.cutEquiv S hcut).symm i).outside ≠
        ((G.cutEquiv S hcut).symm j).outside) :
    let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
    0 < G.mult (E r.a).outside (E r.c).outside ∧
      0 < G.mult (E r.a).outside (E r.d).outside ∧
      0 < G.mult (E r.b).outside (E r.c).outside ∧
      0 < G.mult (E r.b).outside (E r.d).outside := by
  classical
  dsimp only
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    G.reversedFourCutListing S hcut
  have hforce (s : FourPairing)
      (hbad : ¬(G.oppositePairClosure S hcut s).InTashkinovClass) :
      0 < G.mult (E s.a).outside (E s.b).outside ∧
        0 < G.mult (E s.c).outside (E s.d).outside := by
    let a := pairEndpoint EC s.a
    let b := pairEndpoint EC s.b
    let c := pairEndpoint EC s.c
    let d := pairEndpoint EC s.d
    have habW : (E s.a).outside ≠ (E s.b).outside :=
      hdistinct s.a s.b (fourPairing_ab_ne s)
    have hcdW : (E s.c).outside ≠ (E s.d).outside :=
      hdistinct s.c s.d (fourPairing_cd_ne s)
    have hab : a ≠ b := by
      intro h
      exact habW (congrArg Subtype.val h)
    have hcd : c ≠ d := by
      intro h
      exact hcdW (congrArg Subtype.val h)
    have hpairs := G.bad_oppositePairClosure_closingPairs_ne
      hclass huv huvTwo S hS hcut s hbad hab hcd
    have hexisting := G.bad_oppositePairClosure_forces_existing_closingEdges
      hclass huv huvTwo S hS hcut s hbad hab hcd hpairs.1 hpairs.2
    simpa [E, EC, a, b, c, d, pairEndpoint,
      reversedFourCutListing, reverseCrossingEdgeEquiv,
      reverseCrossingEdge] using hexisting
  have hp := hforce p hbadp
  have hq := hforce q hbadq
  have hp' :
      0 < G.mult (E p.b).outside (E p.a).outside ∧
        0 < G.mult (E p.d).outside (E p.c).outside := by
    simpa only [G.mult_comm] using hp
  have hq' :
      0 < G.mult (E q.b).outside (E q.a).outside ∧
        0 < G.mult (E q.d).outside (E q.c).outside := by
    simpa only [G.mult_comm] using hq
  cases p <;> cases q <;> cases r <;>
    simp [FourPairing.a, FourPairing.b, FourPairing.c,
      FourPairing.d] at hpq hrp hrq hp hq hp' hq' ⊢ <;>
    aesop

/-- In the three-outside-endpoint branch, suppose the first endpoints of
the two monochromatic blocks coincide.  The complementary cross-pairing
which avoids that coincidence is one of the two bad closures, so both of
its nonloop closing edges must already occur in the original graph.  These
are exactly the two links from the common endpoint to the other two.
-/
lemma bad_crossPairings_force_threeOutside_links
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4)
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q)
    (hbadp : ¬(G.oppositePairClosure S hcut p).InTashkinovClass)
    (hbadq : ¬(G.oppositePairClosure S hcut q).InTashkinovClass) :
    let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
    let A := (E r.a).outside
    let B := (E r.b).outside
    let C := (E r.c).outside
    let D := (E r.d).outside
    A ≠ B → C ≠ D → A ≠ D → B ≠ C →
      0 < G.mult A D ∧ 0 < G.mult B C := by
  classical
  dsimp only
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let t := FourPairing.oppositeCross r
  have ht : t = p ∨ t = q :=
    FourPairing.oppositeCross_mem_of_two_complements p q r hpq hrp hrq
  have hbadt : ¬(G.oppositePairClosure S hcut t).InTashkinovClass := by
    rcases ht with rfl | rfl
    · exact hbadp
    · exact hbadq
  intro hAB hCD hAD hBC
  have htAB : (E t.a).outside ≠ (E t.b).outside := by
    cases r <;> simpa [E, t, FourPairing.oppositeCross, FourPairing.a,
      FourPairing.b, FourPairing.c, FourPairing.d] using hAD
  have htCD : (E t.c).outside ≠ (E t.d).outside := by
    cases r
    · simpa [E, t, FourPairing.oppositeCross, FourPairing.a,
        FourPairing.b, FourPairing.c, FourPairing.d] using hBC
    · simpa [E, t, FourPairing.oppositeCross, FourPairing.a,
        FourPairing.b, FourPairing.c, FourPairing.d] using hBC.symm
    · simpa [E, t, FourPairing.oppositeCross, FourPairing.a,
        FourPairing.b, FourPairing.c, FourPairing.d] using hBC.symm
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ := G.reversedFourCutListing S hcut
  let a₁ := pairEndpoint EC t.a
  let b₁ := pairEndpoint EC t.b
  let c₁ := pairEndpoint EC t.c
  let d₁ := pairEndpoint EC t.d
  have ha₁b₁ : a₁ ≠ b₁ := by
    intro h
    exact htAB (congrArg Subtype.val h)
  have hc₁d₁ : c₁ ≠ d₁ := by
    intro h
    exact htCD (congrArg Subtype.val h)
  have hpairs := G.bad_oppositePairClosure_closingPairs_ne
    hclass huv huvTwo S hS hcut t hbadt ha₁b₁ hc₁d₁
  have hexisting := G.bad_oppositePairClosure_forces_existing_closingEdges
    hclass huv huvTwo S hS hcut t hbadt ha₁b₁ hc₁d₁
      hpairs.1 hpairs.2
  have hexisting' :
      0 < G.mult (E t.a).outside (E t.b).outside ∧
        0 < G.mult (E t.c).outside (E t.d).outside := by
    simpa [EC, E, a₁, b₁, c₁, d₁, pairEndpoint,
      reversedFourCutListing, reverseCrossingEdgeEquiv,
      reverseCrossingEdge] using hexisting
  cases r <;>
    simpa [t, FourPairing.oppositeCross, FourPairing.a,
      FourPairing.b, FourPairing.c, FourPairing.d, G.mult_comm] using hexisting'

/-- The other complementary cross-pairing gives the analogous links when
the coincidence is between the first block's first endpoint and the second
block's second endpoint. -/
lemma bad_crossPairings_force_threeOutside_otherLinks
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4)
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q)
    (hbadp : ¬(G.oppositePairClosure S hcut p).InTashkinovClass)
    (hbadq : ¬(G.oppositePairClosure S hcut q).InTashkinovClass) :
    let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
    let A := (E r.a).outside
    let B := (E r.b).outside
    let C := (E r.c).outside
    let D := (E r.d).outside
    A ≠ C → B ≠ D →
      0 < G.mult A C ∧ 0 < G.mult B D := by
  classical
  dsimp only
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let t := FourPairing.otherCross r
  have ht : t = p ∨ t = q :=
    FourPairing.otherCross_mem_of_two_complements p q r hpq hrp hrq
  have hbadt : ¬(G.oppositePairClosure S hcut t).InTashkinovClass := by
    rcases ht with rfl | rfl
    · exact hbadp
    · exact hbadq
  intro hAC hBD
  have htAB : (E t.a).outside ≠ (E t.b).outside := by
    cases r <;> simpa [E, t, FourPairing.otherCross, FourPairing.a,
      FourPairing.b, FourPairing.c, FourPairing.d] using hAC
  have htCD : (E t.c).outside ≠ (E t.d).outside := by
    cases r
    · simpa [E, t, FourPairing.otherCross, FourPairing.a,
        FourPairing.b, FourPairing.c, FourPairing.d] using hBD
    · simpa [E, t, FourPairing.otherCross, FourPairing.a,
        FourPairing.b, FourPairing.c, FourPairing.d] using hBD
    · simpa [E, t, FourPairing.otherCross, FourPairing.a,
        FourPairing.b, FourPairing.c, FourPairing.d] using hBD.symm
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ := G.reversedFourCutListing S hcut
  let a₁ := pairEndpoint EC t.a
  let b₁ := pairEndpoint EC t.b
  let c₁ := pairEndpoint EC t.c
  let d₁ := pairEndpoint EC t.d
  have ha₁b₁ : a₁ ≠ b₁ := by
    intro h
    exact htAB (congrArg Subtype.val h)
  have hc₁d₁ : c₁ ≠ d₁ := by
    intro h
    exact htCD (congrArg Subtype.val h)
  have hpairs := G.bad_oppositePairClosure_closingPairs_ne
    hclass huv huvTwo S hS hcut t hbadt ha₁b₁ hc₁d₁
  have hexisting := G.bad_oppositePairClosure_forces_existing_closingEdges
    hclass huv huvTwo S hS hcut t hbadt ha₁b₁ hc₁d₁
      hpairs.1 hpairs.2
  have hexisting' :
      0 < G.mult (E t.a).outside (E t.b).outside ∧
        0 < G.mult (E t.c).outside (E t.d).outside := by
    simpa [EC, E, a₁, b₁, c₁, d₁, pairEndpoint,
      reversedFourCutListing, reverseCrossingEdgeEquiv,
      reverseCrossingEdge] using hexisting
  cases r <;>
    simpa [t, FourPairing.otherCross, FourPairing.a,
      FourPairing.b, FourPairing.c, FourPairing.d, G.mult_comm] using hexisting'

/-- The four cut ends of a loopless double edge cannot collapse to only two
outside vertices.  Of the two cross-pairings, one would then add two copies
of the same nonloop edge, contradicting the bad-closure defect bound. -/
lemma bad_crossPairings_forbid_twoOutside
    (G : Pseudograph W) (hclass : G.InTashkinovClass)
    {u v : W} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v)
    (S : Finset W) (hS : S = {u, v})
    (hcut : G.boundaryMultiplicity S = 4)
    (p q r : FourPairing) (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q)
    (hbadp : ¬(G.oppositePairClosure S hcut p).InTashkinovClass)
    (hbadq : ¬(G.oppositePairClosure S hcut q).InTashkinovClass)
    (hrab : ((G.cutEquiv S hcut).symm r.a).outside ≠
      ((G.cutEquiv S hcut).symm r.b).outside)
    (hrcd : ((G.cutEquiv S hcut).symm r.c).outside ≠
      ((G.cutEquiv S hcut).symm r.d).outside)
    (htwo :
      (((G.cutEquiv S hcut).symm r.a).outside =
          ((G.cutEquiv S hcut).symm r.c).outside ∧
        ((G.cutEquiv S hcut).symm r.b).outside =
          ((G.cutEquiv S hcut).symm r.d).outside) ∨
      (((G.cutEquiv S hcut).symm r.a).outside =
          ((G.cutEquiv S hcut).symm r.d).outside ∧
        ((G.cutEquiv S hcut).symm r.b).outside =
          ((G.cutEquiv S hcut).symm r.c).outside)) : False := by
  classical
  let E : Fin 4 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let EC : Fin 4 ≃ CrossingEdge G Sᶜ :=
    G.reversedFourCutListing S hcut
  have hrule (s : FourPairing)
      (hbad : ¬(G.oppositePairClosure S hcut s).InTashkinovClass)
      (hab : (E s.a).outside ≠ (E s.b).outside)
      (hcd : (E s.c).outside ≠ (E s.d).outside) :
      ((E s.a).outside, (E s.b).outside) ≠
          ((E s.c).outside, (E s.d).outside) ∧
        ((E s.a).outside, (E s.b).outside) ≠
          ((E s.d).outside, (E s.c).outside) := by
    let a := pairEndpoint EC s.a
    let b := pairEndpoint EC s.b
    let c := pairEndpoint EC s.c
    let d := pairEndpoint EC s.d
    have hab' : a ≠ b := by
      intro h
      exact hab (congrArg Subtype.val h)
    have hcd' : c ≠ d := by
      intro h
      exact hcd (congrArg Subtype.val h)
    have hpairs := G.bad_oppositePairClosure_closingPairs_ne
      hclass huv huvTwo S hS hcut s hbad hab' hcd'
    simpa [E, EC, a, b, c, d, pairEndpoint,
      reversedFourCutListing, reverseCrossingEdgeEquiv,
      reverseCrossingEdge] using hpairs
  obtain ⟨s, hs, hsab, hscd, hdup⟩ :=
    FourPairing.exists_duplicate_pairing_of_two_values
      (fun i ↦ (E i).outside) p q r hpq hrp hrq
      (by simpa [E] using hrab) (by simpa [E] using hrcd)
      (by simpa [E] using htwo)
  have hbad : ¬(G.oppositePairClosure S hcut s).InTashkinovClass := by
    rcases hs with rfl | rfl
    · exact hbadp
    · exact hbadq
  have hne := hrule s hbad hsab hscd
  exact hdup.elim hne.1 hne.2

end Pseudograph

/-- A parallel pair in the minimal counterexample cannot have a loop at
either endpoint.  Otherwise the two endpoints form a two-cut with an
explicit cubic closure, while the opposite closure is a smaller class-`B`
graph. -/
theorem IsVertexMinimalCounterexample.double_edge_endpoints_loopless
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    {u v : Fin n} (huv : u ≠ v) (huvTwo : 2 ≤ G.mult u v) :
    G.mult u u = 0 ∧ G.mult v v = 0 := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  have hnone (a b : Fin n) (hab : a ≠ b)
      (habTwo : 2 ≤ G.mult a b) : G.mult a a = 0 := by
    by_contra haa
    have haaPos : 0 < G.mult a a := Nat.pos_of_ne_zero haa
    have hbb : G.mult b b = 0 := by
      by_contra hbb
      have hsum := G.mult_self_add_mult_self_le_loopCount hab
      have hclassLoop := hmin.in_class.2.1
      omega
    obtain ⟨hcut, hpartS⟩ :=
      G.exists_loop_double_twoCut_cubicClosure hmin.in_class.1
        hab haaPos hbb habTwo
    let S : Finset (Fin n) := {a, b}
    have hSeq : S = ({a, b} : Finset (Fin n)) := rfl
    have hproper : S ≠ Finset.univ := by
      intro hSuniv
      have hzero : G.boundaryMultiplicity S = 0 := by
        rw [G.boundaryMultiplicity_eq_sum_outsideDegree, hSuniv]
        simp [Pseudograph.outsideDegree]
      have : (2 : ℕ) = 0 := by
        rw [← hcut]
        simpa [S] using hzero
      omega
    have hSC : Sᶜ.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hempty
      exact hproper ((Finset.compl_eq_empty_iff S).mp hempty)
    letI : Nonempty ↑(Sᶜ) := Finset.nonempty_coe_sort.mpr hSC
    have hproperC : Sᶜ ≠ Finset.univ := by
      intro hC
      have haS : a ∈ S := by simp [S]
      have haC : a ∈ Sᶜ := by rw [hC]; simp
      exact (Finset.mem_compl.mp haC) haS
    have hcardC : Fintype.card ↑(Sᶜ) < n := by
      rw [Fintype.card_coe]
      have hlt := Finset.card_lt_card
        (Finset.ssubset_iff_subset_ne.mpr
          ⟨Finset.subset_univ Sᶜ, hproperC⟩)
      simpa using hlt
    let hcutC : G.boundaryMultiplicity Sᶜ = 2 :=
      (G.boundaryMultiplicity_compl S).trans (by simpa [S] using hcut)
    have hbaseC : (G.induce Sᶜ).HasSimpleMultiplicities := by
      simpa [S] using
        G.induce_compl_hasSimpleMultiplicities_of_loop_and_parallel
          hmin.in_class hab haaPos habTwo
    have hclassC : (G.closeTwoCut Sᶜ hcutC).InTashkinovClass :=
      G.closeTwoCut_inTashkinovClass_of_induce_hasSimpleMultiplicities
        hmin.in_class.1 Sᶜ hcutC hbaseC
    have hpartC : (G.closeTwoCut Sᶜ hcutC).ContainsRegularPart 3 :=
      hmin.contains_of_card_lt (G.closeTwoCut Sᶜ hcutC) hclassC hcardC
    have hpartS' : (G.closeTwoCut S (by simpa [S] using hcut)).ContainsRegularPart 3 := by
      simpa [S] using hpartS
    exact hmin.no_cubic_part
      (G.containsRegularPart_of_twoCutClosures S
        (by simpa [S] using hcut) hpartS' (by simpa [hcutC] using hpartC))
  refine ⟨hnone u v huv huvTwo, hnone v u huv.symm ?_⟩
  simpa only [G.mult_comm] using huvTwo

/-- In a minimal bad member, both opposite-shore closures associated with
the two cross-pairings of a loopless double edge lie outside Tashkinov's
class.  Otherwise minimality and the explicit two-vertex local witnesses
splice to a cubic part of the original graph. -/
theorem IsVertexMinimalCounterexample.exists_two_bad_pairClosures_of_double_edge
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    {u v : Fin n} (huv : u ≠ v)
    (huu : G.mult u u = 0) (hvv : G.mult v v = 0)
    (huvTwo : G.mult u v = 2) :
    ∃ S : Finset (Fin n), S = {u, v} ∧
      ∃ hcut : G.boundaryMultiplicity S = 4,
      ∃ p q : Pseudograph.FourPairing, p ≠ q ∧
        let E : Fin 4 ≃ Pseudograph.CrossingEdge G S :=
          (G.cutEquiv S hcut).symm
        (E p.a).inside ≠ (E p.b).inside ∧
        (E p.c).inside ≠ (E p.d).inside ∧
        (E q.a).inside ≠ (E q.b).inside ∧
        (E q.c).inside ≠ (E q.d).inside ∧
        ¬(G.oppositePairClosure S hcut p).InTashkinovClass ∧
        ¬(G.oppositePairClosure S hcut q).InTashkinovClass := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  let S : Finset (Fin n) := {u, v}
  have hSeq : S = ({u, v} : Finset (Fin n)) := by
    ext x
    simp [S]
  obtain ⟨hcut, p, q, hpq, hpab, hpcd, hqab, hqcd⟩ :=
    G.exists_two_cross_pairings_of_double_edge hmin.in_class.1
      huv huu hvv huvTwo
  have hSproper : S ≠ Finset.univ := by
    intro hSuniv
    have hz : G.boundaryMultiplicity S = 0 := by
      rw [G.boundaryMultiplicity_eq_sum_outsideDegree, hSuniv]
      simp [Pseudograph.outsideDegree]
    have hfourZero : (4 : ℕ) = 0 := hcut.symm.trans hz
    omega
  have hSC : Sᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hC
    exact hSproper ((Finset.compl_eq_empty_iff S).mp hC)
  letI : Nonempty ↑(Sᶜ) := Finset.nonempty_coe_sort.mpr hSC
  have hcardC : Fintype.card ↑(Sᶜ) < n := by
    rw [Fintype.card_coe]
    have hproperC : Sᶜ ≠ Finset.univ := by
      intro h
      have hSempty : S = ∅ := (Finset.compl_eq_univ_iff S).mp h
      have huS : u ∈ S := by simp [S]
      simpa [hSempty] using huS
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ Sᶜ, hproperC⟩)
    simpa using hlt
  have hnot (r : Pseudograph.FourPairing)
      (hr₁ : ((G.cutEquiv S hcut).symm r.a).inside ≠
        ((G.cutEquiv S hcut).symm r.b).inside)
      (hr₂ : ((G.cutEquiv S hcut).symm r.c).inside ≠
        ((G.cutEquiv S hcut).symm r.d).inside) :
      ¬(G.oppositePairClosure S hcut r).InTashkinovClass := by
    intro hclass
    have hpart := hmin.contains_of_card_lt
      (G.oppositePairClosure S hcut r) hclass hcardC
    have hlocal := G.pairClosure_twoVertex_localWitnesses
      huv S hSeq (G.cutEquiv S hcut).symm r
      hr₁ hr₂ (by omega)
    exact hmin.no_cubic_part
      (G.containsRegularPart_of_fourCutPairClosures S hcut r hlocal hpart)
  refine ⟨S, ?_, hcut, p, q, hpq, hpab, hpcd, hqab, hqcd,
    hnot p hpab hpcd, hnot q hqab hqcd⟩
  ext x
  simp [S]

namespace Pseudograph

variable {X : Type*} [Fintype X]

/-- If a two-cut has one incidence at each of `a,b` on one shore and both
opposite incidences meet the same vertex `w`, then the edges `aw,bw` are
present. -/
lemma twoCut_common_opposite_endpoint_edges
    (G : Pseudograph X) (S : Finset X)
    (hcut : G.boundaryMultiplicity S = 2) {a b : X}
    (haS : a ∈ S) (hbS : b ∈ S) (hab : a ≠ b)
    (houtA : G.outsideDegree S a = 1)
    (houtB : G.outsideDegree S b = 1)
    (honly : ∀ x, x ∈ S → x ≠ a → x ≠ b →
      G.outsideDegree S x = 0)
    (heq :
      (twoCutEdge G Sᶜ ((G.boundaryMultiplicity_compl S).trans hcut) 0).inside =
      (twoCutEdge G Sᶜ ((G.boundaryMultiplicity_compl S).trans hcut) 1).inside) :
    let w :=
      (twoCutEdge G Sᶜ ((G.boundaryMultiplicity_compl S).trans hcut) 0).inside
    w ∉ S ∧ 0 < G.mult a w ∧ 0 < G.mult b w := by
  classical
  dsimp only
  let hcutC : G.boundaryMultiplicity Sᶜ = 2 :=
    (G.boundaryMultiplicity_compl S).trans hcut
  let e0 := twoCutEdge G Sᶜ hcutC 0
  let e1 := twoCutEdge G Sᶜ hcutC 1
  let w := e0.inside
  have hwS : w ∉ S := Finset.mem_compl.mp e0.inside_mem
  have he1w : e1.inside = w := by simpa [w, e0, e1, hcutC] using heq.symm
  have houtMem (e : CrossingEdge G Sᶜ) : e.outside ∈ S := by
    simpa using e.outside_notMem
  have hpos (e : CrossingEdge G Sᶜ) : 0 < G.mult e.outside e.inside := by
    rw [G.mult_comm]
    exact Nat.zero_lt_of_lt e.index.isLt
  have houtsidePos (e : CrossingEdge G Sᶜ) :
      0 < G.outsideDegree S e.outside := by
    unfold outsideDegree
    have hle : G.mult e.outside e.inside ≤
        ∑ y ∈ Sᶜ, G.mult e.outside y :=
      Finset.single_le_sum (s := Sᶜ) (f := fun y ↦ G.mult e.outside y)
        (fun _ _ ↦ Nat.zero_le _) e.inside_mem
    exact Nat.lt_of_lt_of_le (hpos e) hle
  have hendpoint (e : CrossingEdge G Sᶜ) :
      e.outside = a ∨ e.outside = b := by
    by_contra h
    push_neg at h
    have hz := honly e.outside (houtMem e) h.1 h.2
    have hp := houtsidePos e
    omega
  have heNe : e0 ≠ e1 := by
    intro h
    have hidx := (twoCutEquiv G Sᶜ hcutC).injective
      (show (twoCutEquiv G Sᶜ hcutC) e0 =
        (twoCutEquiv G Sᶜ hcutC) e1 by rw [h])
    have : (0 : Fin 2) = 1 := by
      simpa [e0, e1, twoCutEdge] using congrArg
        (twoCutEquiv G Sᶜ hcutC) hidx
    exact Fin.zero_ne_one this
  have houtNe : e0.outside ≠ e1.outside := by
    intro hout
    have htwo : 2 ≤ G.mult e0.inside e0.outside :=
      two_le_mult_of_distinct_crossingEdges_same_endpoints heNe
        (by simpa [w] using he1w.symm) hout
    have hle : G.mult e0.outside e0.inside ≤
        G.outsideDegree S e0.outside := by
      unfold outsideDegree
      exact Finset.single_le_sum (s := Sᶜ)
        (f := fun y ↦ G.mult e0.outside y)
        (fun _ _ ↦ Nat.zero_le _) e0.inside_mem
    have hone : G.outsideDegree S e0.outside = 1 := by
      rcases hendpoint e0 with h | h
      · simpa [h] using houtA
      · simpa [h] using houtB
    rw [G.mult_comm] at htwo
    omega
  rcases hendpoint e0 with h0a | h0b
  · have h1b : e1.outside = b :=
      (hendpoint e1).resolve_left (fun h ↦ houtNe (h0a.trans h.symm))
    refine ⟨hwS, ?_, ?_⟩
    · simpa [w, h0a] using hpos e0
    · simpa [w, e0, e1, he1w, h1b] using hpos e1
  · have h1a : e1.outside = a :=
      (hendpoint e1).resolve_right (fun h ↦ houtNe (h0b.trans h.symm))
    refine ⟨hwS, ?_, ?_⟩
    · simpa [w, e0, e1, he1w, h1a] using hpos e1
    · simpa [w, h0b] using hpos e0

/-- If all incidences of a two-cut on one shore occur at a single vertex
`w` and the two opposite incidences also meet one vertex `x`, then `wx` is
a parallel pair. -/
lemma twoCut_common_opposite_endpoint_parallel
    (G : Pseudograph X) (S : Finset X)
    (hcut : G.boundaryMultiplicity S = 2) {w : X}
    (hwS : w ∈ S)
    (honly : ∀ y, y ∈ S → y ≠ w → G.outsideDegree S y = 0)
    (heq :
      (twoCutEdge G Sᶜ ((G.boundaryMultiplicity_compl S).trans hcut) 0).inside =
      (twoCutEdge G Sᶜ ((G.boundaryMultiplicity_compl S).trans hcut) 1).inside) :
    let x :=
      (twoCutEdge G Sᶜ ((G.boundaryMultiplicity_compl S).trans hcut) 0).inside
    x ∉ S ∧ 2 ≤ G.mult w x := by
  classical
  dsimp only
  let hcutC : G.boundaryMultiplicity Sᶜ = 2 :=
    (G.boundaryMultiplicity_compl S).trans hcut
  let e0 := twoCutEdge G Sᶜ hcutC 0
  let e1 := twoCutEdge G Sᶜ hcutC 1
  let x := e0.inside
  have hxS : x ∉ S := Finset.mem_compl.mp e0.inside_mem
  have he1x : e1.inside = x := by
    simpa [x, e0, e1, hcutC] using heq.symm
  have houtMem (e : CrossingEdge G Sᶜ) : e.outside ∈ S := by
    simpa using e.outside_notMem
  have hpos (e : CrossingEdge G Sᶜ) :
      0 < G.mult e.outside e.inside := by
    rw [G.mult_comm]
    exact Nat.zero_lt_of_lt e.index.isLt
  have houtsidePos (e : CrossingEdge G Sᶜ) :
      0 < G.outsideDegree S e.outside := by
    unfold outsideDegree
    have hle : G.mult e.outside e.inside ≤
        ∑ y ∈ Sᶜ, G.mult e.outside y :=
      Finset.single_le_sum (s := Sᶜ)
        (f := fun y ↦ G.mult e.outside y)
        (fun _ _ ↦ Nat.zero_le _) e.inside_mem
    exact Nat.lt_of_lt_of_le (hpos e) hle
  have houtW (e : CrossingEdge G Sᶜ) : e.outside = w := by
    by_contra hne
    have hz := honly e.outside (houtMem e) hne
    exact (Nat.ne_of_gt (houtsidePos e)) hz
  have heNe : e0 ≠ e1 := by
    intro h
    have hidx := (twoCutEquiv G Sᶜ hcutC).injective
      (show (twoCutEquiv G Sᶜ hcutC) e0 =
        (twoCutEquiv G Sᶜ hcutC) e1 by rw [h])
    have : (0 : Fin 2) = 1 := by
      simpa [e0, e1, twoCutEdge] using congrArg
        (twoCutEquiv G Sᶜ hcutC) hidx
    exact Fin.zero_ne_one this
  have hparallel : 2 ≤ G.mult e0.inside e0.outside :=
    two_le_mult_of_distinct_crossingEdges_same_endpoints heNe
      (by simpa [x] using he1x.symm)
      ((houtW e0).trans (houtW e1).symm)
  refine ⟨hxS, ?_⟩
  rw [G.mult_comm]
  simpa [x, houtW e0] using hparallel

end Pseudograph

section ThreeOutsideDoubleCore

/-- Keep all complements of finsets of `Fin n` definitionally on the
classical decidable equality used by the generic cut definitions.  The cut
enumerations are dependent on the actual finset value. -/
noncomputable local instance classicalFinDecidableEq (n : ℕ) :
    DecidableEq (Fin n) :=
  Classical.decEq (Fin n)

/-- The normalized geometry left after the two- and four-outside-endpoint
branches of the parallel-edge argument have been excluded. -/
structure ThreeOutsideDoubleCore {n : ℕ}
    (G : Pseudograph (Fin n)) where
  u : Fin n
  v : Fin n
  a : Fin n
  z : Fin n
  b : Fin n
  uv_ne : u ≠ v
  ua_ne : u ≠ a
  uz_ne : u ≠ z
  ub_ne : u ≠ b
  va_ne : v ≠ a
  vz_ne : v ≠ z
  vb_ne : v ≠ b
  az_ne : a ≠ z
  ab_ne : a ≠ b
  zb_ne : z ≠ b
  uv_two : G.mult u v = 2
  loop_u : G.mult u u = 0
  loop_v : G.mult v v = 0
  ua_pos : 0 < G.mult u a
  uz_pos : 0 < G.mult u z
  vz_pos : 0 < G.mult v z
  vb_pos : 0 < G.mult v b
  az_pos : 0 < G.mult a z
  zb_pos : 0 < G.mult z b

/-- Reflection of the normalized core across its central vertex. -/
def ThreeOutsideDoubleCore.swap
    {n : ℕ} {G : Pseudograph (Fin n)}
    (C : ThreeOutsideDoubleCore G) : ThreeOutsideDoubleCore G where
  u := C.v
  v := C.u
  a := C.b
  z := C.z
  b := C.a
  uv_ne := C.uv_ne.symm
  ua_ne := C.vb_ne
  uz_ne := C.vz_ne
  ub_ne := C.va_ne
  va_ne := C.ub_ne
  vz_ne := C.uz_ne
  vb_ne := C.ua_ne
  az_ne := C.zb_ne.symm
  ab_ne := C.ab_ne.symm
  zb_ne := C.az_ne.symm
  uv_two := by simpa only [G.mult_comm] using C.uv_two
  loop_u := C.loop_v
  loop_v := C.loop_u
  ua_pos := C.vb_pos
  uz_pos := C.vz_pos
  vz_pos := C.uz_pos
  vb_pos := C.ua_pos
  az_pos := by simpa only [G.mult_comm] using C.zb_pos
  zb_pos := by simpa only [G.mult_comm] using C.az_pos

/-- The two outer vertices in a three-outside-endpoint core have at most
one joining edge; two copies would already give the explicit cubic part on
`u,v,a,b`. -/
lemma IsVertexMinimalCounterexample.threeOutside_outer_mult_le_one
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) : G.mult C.a C.b ≤ 1 := by
  by_contra h
  have htwo : 2 ≤ G.mult C.a C.b := by omega
  apply hmin.no_cubic_part
  exact G.containsRegularPart_of_two_doubleEdges_and_links
    C.uv_ne C.ua_ne C.ub_ne C.va_ne C.vb_ne C.ab_ne
    (by rw [C.uv_two]) htwo C.ua_pos C.vb_pos

lemma ThreeOutsideDoubleCore.saturate_u
    {n : ℕ} {G : Pseudograph (Fin n)} (C : ThreeOutsideDoubleCore G)
    (hreg : G.IsRegularOfDegree 4) :
    G.mult C.u C.a = 1 ∧ G.mult C.u C.z = 1 ∧
      ∀ x, x ≠ C.u → x ≠ C.v → x ≠ C.a → x ≠ C.z →
        G.mult C.u x = 0 := by
  exact G.double_and_two_neighbors_saturate hreg
    C.uv_ne C.ua_ne C.uz_ne C.va_ne C.vz_ne C.az_ne
    C.loop_u C.uv_two C.ua_pos C.uz_pos

lemma ThreeOutsideDoubleCore.saturate_v
    {n : ℕ} {G : Pseudograph (Fin n)} (C : ThreeOutsideDoubleCore G)
    (hreg : G.IsRegularOfDegree 4) :
    G.mult C.v C.z = 1 ∧ G.mult C.v C.b = 1 ∧
      ∀ x, x ≠ C.v → x ≠ C.u → x ≠ C.z → x ≠ C.b →
        G.mult C.v x = 0 := by
  apply G.double_and_two_neighbors_saturate hreg
    C.uv_ne.symm C.vz_ne C.vb_ne C.uz_ne C.ub_ne C.zb_ne
    C.loop_v
  · simpa only [G.mult_comm] using C.uv_two
  · simpa only [G.mult_comm] using C.vz_pos
  · exact C.vb_pos

lemma ThreeOutsideDoubleCore.saturate_z
    {n : ℕ} {G : Pseudograph (Fin n)} (C : ThreeOutsideDoubleCore G)
    (hreg : G.IsRegularOfDegree 4) :
    G.mult C.z C.z = 0 ∧ G.mult C.z C.u = 1 ∧
      G.mult C.z C.v = 1 ∧ G.mult C.z C.a = 1 ∧
      G.mult C.z C.b = 1 ∧
      ∀ x, x ≠ C.z → x ≠ C.u → x ≠ C.v → x ≠ C.a → x ≠ C.b →
        G.mult C.z x = 0 := by
  apply G.four_neighbors_saturate hreg
    C.uz_ne.symm C.vz_ne.symm C.az_ne.symm C.zb_ne
    C.uv_ne C.ua_ne C.ub_ne C.va_ne C.vb_ne C.ab_ne
  · simpa only [G.mult_comm] using C.uz_pos
  · simpa only [G.mult_comm] using C.vz_pos
  · simpa only [G.mult_comm] using C.az_pos
  · exact C.zb_pos

/-- In the single outer-edge subcase, the five core vertices have a
two-edge boundary, one incidence at each outer vertex. -/
lemma ThreeOutsideDoubleCore.single_outer_twoCut
    {n : ℕ} {G : Pseudograph (Fin n)} (C : ThreeOutsideDoubleCore G)
    (hreg : G.IsRegularOfDegree 4) (hab : G.mult C.a C.b = 1) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    G.boundaryMultiplicity U = 2 ∧
      G.outsideDegree U C.a = 1 ∧ G.outsideDegree U C.b = 1 ∧
      G.outsideDegree U C.u = 0 ∧ G.outsideDegree U C.v = 0 ∧
      G.outsideDegree U C.z = 0 := by
  dsimp only
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hua, huz, huOther⟩ := C.saturate_u hreg
  obtain ⟨hvz, hvb, hvOther⟩ := C.saturate_v hreg
  obtain ⟨hzz, hzu, hzv, hza, hzb, hzOther⟩ := C.saturate_z hreg
  have hau : G.mult C.a C.u = 1 := by simpa only [G.mult_comm] using hua
  have haz : G.mult C.a C.z = 1 := by simpa only [G.mult_comm] using hza
  have hbv : G.mult C.b C.v = 1 := by simpa only [G.mult_comm] using hvb
  have hbz : G.mult C.b C.z = 1 := by simpa only [G.mult_comm] using hzb
  have hav : G.mult C.a C.v = 0 := by
    rw [G.mult_comm]
    exact hvOther C.a C.va_ne.symm C.ua_ne.symm C.az_ne C.ab_ne
  have hbu : G.mult C.b C.u = 0 := by
    rw [G.mult_comm]
    exact huOther C.b C.ub_ne.symm C.vb_ne.symm C.ab_ne.symm C.zb_ne.symm
  have haa : G.mult C.a C.a = 0 := by
    apply G.loopless_of_three_neighbors hreg C.ua_ne.symm C.az_ne
      C.ab_ne C.uz_ne C.ub_ne C.zb_ne
    · omega
    · exact C.az_pos
    · omega
  have hbb : G.mult C.b C.b = 0 := by
    apply G.loopless_of_three_neighbors hreg C.vb_ne.symm C.zb_ne.symm
      C.ab_ne.symm C.vz_ne C.va_ne C.az_ne.symm
    · omega
    · simpa only [G.mult_comm] using C.zb_pos
    · rw [G.mult_comm]
      omega
  have houtU : G.outsideDegree U C.u = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by
      simpa only [Finset.mem_compl] using hx
    apply huOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtV : G.outsideDegree U C.v = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by
      simpa only [Finset.mem_compl] using hx
    apply hvOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtZ : G.outsideDegree U C.z = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by
      simpa only [Finset.mem_compl] using hx
    apply hzOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  let as : U := ⟨C.a, by simp [U]⟩
  let bs : U := ⟨C.b, by simp [U]⟩
  have hub : G.mult C.u C.b = 0 := by
    simpa only [G.mult_comm] using hbu
  have hba : G.mult C.b C.a = 1 := by
    simpa only [G.mult_comm] using hab
  have hdegA : (G.induce U).degree as = 3 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum, Finset.univ_eq_attach U]
    change G.mult C.a C.a + ∑ x ∈ U.attach, G.mult C.a (x : Fin n) = 3
    rw [Finset.sum_attach]
    change G.mult C.a C.a + ∑ x ∈ U, G.mult C.a x = 3
    simp [U, haa, hau, hav, haz, hab, C.uv_ne, C.ua_ne, C.uz_ne,
      C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
  have hdegB : (G.induce U).degree bs = 3 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum, Finset.univ_eq_attach U]
    change G.mult C.b C.b + ∑ x ∈ U.attach, G.mult C.b (x : Fin n) = 3
    rw [Finset.sum_attach]
    change G.mult C.b C.b + ∑ x ∈ U, G.mult C.b x = 3
    simp [U, hbb, hbu, hbv, hbz, hba, C.uv_ne, C.ua_ne,
      C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne,
      C.ab_ne, C.zb_ne]
  have houtA : G.outsideDegree U C.a = 1 := by
    have h := G.degree_induce_add_outsideDegree U C.a (by simp [U])
    change (G.induce U).degree as + G.outsideDegree U C.a = G.degree C.a at h
    rw [hdegA, hreg C.a] at h
    omega
  have houtB : G.outsideDegree U C.b = 1 := by
    have h := G.degree_induce_add_outsideDegree U C.b (by simp [U])
    change (G.induce U).degree bs + G.outsideDegree U C.b = G.degree C.b at h
    rw [hdegB, hreg C.b] at h
    omega
  have hcut : G.boundaryMultiplicity U = 2 := by
    rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
    simp [U, houtA, houtB, houtU, houtV, houtZ, C.uv_ne, C.ua_ne,
      C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne,
      C.ab_ne, C.zb_ne]
  exact ⟨hcut, houtA, houtB, houtU, houtV, houtZ⟩

/-- The closure of the five-vertex shore in the single-outer-edge case has
the explicit cubic part formed by the two double edges `uv`, `ab` and the
links `ua`, `vb`. -/
lemma ThreeOutsideDoubleCore.single_outer_localClosure_contains
    {n : ℕ} {G : Pseudograph (Fin n)} (C : ThreeOutsideDoubleCore G)
    (hreg : G.IsRegularOfDegree 4) (hab : G.mult C.a C.b = 1) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    let hcut : G.boundaryMultiplicity U = 2 :=
      (C.single_outer_twoCut hreg hab).1
    (G.closeTwoCut U hcut).ContainsRegularPart 3 := by
  dsimp only
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hcut, houtA, houtB, _houtU, _houtV, _houtZ⟩ :=
    C.single_outer_twoCut hreg hab
  let us : U := ⟨C.u, by simp [U]⟩
  let vs : U := ⟨C.v, by simp [U]⟩
  let as : U := ⟨C.a, by simp [U]⟩
  let bs : U := ⟨C.b, by simp [U]⟩
  have hends := G.closeTwoCut_endpoints_and_mult_of_two_unit_outsideDegrees
    U hcut (a := C.a) (b := C.b) (by simp [U]) (by simp [U]) C.ab_ne
    houtA houtB
  have hUV : 2 ≤ (G.closeTwoCut U hcut).mult us vs := by
    change 2 ≤ G.mult C.u C.v + _
    rw [C.uv_two]
    omega
  have hAB : 2 ≤ (G.closeTwoCut U hcut).mult as bs := by
    change 2 ≤ (G.closeTwoCut U hcut).mult
      ⟨C.a, by simp [U]⟩ ⟨C.b, by simp [U]⟩
    rw [hends.2, hab]
  have hUA : 0 < (G.closeTwoCut U hcut).mult us as := by
    change 0 < G.mult C.u C.a + _
    have := C.ua_pos
    omega
  have hVB : 0 < (G.closeTwoCut U hcut).mult vs bs := by
    change 0 < G.mult C.v C.b + _
    have := C.vb_pos
    omega
  exact (G.closeTwoCut U hcut).containsRegularPart_of_two_doubleEdges_and_links
    (fun h ↦ C.uv_ne (congrArg Subtype.val h))
    (fun h ↦ C.ua_ne (congrArg Subtype.val h))
    (fun h ↦ C.ub_ne (congrArg Subtype.val h))
    (fun h ↦ C.va_ne (congrArg Subtype.val h))
    (fun h ↦ C.vb_ne (congrArg Subtype.val h))
    (fun h ↦ C.ab_ne (congrArg Subtype.val h))
    hUV hAB hUA hVB

/-- In the single-outer-edge case, the two residual cut edges must meet a
common opposite vertex.  Distinct endpoints would make the opposite
closure a smaller class-`B` graph, contradicting two-cut gluing. -/
lemma IsVertexMinimalCounterexample.single_outer_opposite_endpoints_eq
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 1) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    let hcut : G.boundaryMultiplicity U = 2 :=
      (C.single_outer_twoCut hmin.in_class.1 hab).1
    let hcutC : G.boundaryMultiplicity Uᶜ = 2 :=
      (G.boundaryMultiplicity_compl U).trans hcut
    (Pseudograph.twoCutEdge G Uᶜ hcutC 0).inside =
      (Pseudograph.twoCutEdge G Uᶜ hcutC 1).inside := by
  dsimp only
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  have hcut : G.boundaryMultiplicity U = 2 := by
    simpa [U] using (C.single_outer_twoCut hmin.in_class.1 hab).1
  let hcutC : G.boundaryMultiplicity Uᶜ = 2 :=
    (G.boundaryMultiplicity_compl U).trans hcut
  by_contra hne
  have huU : C.u ∈ U := by simp [U]
  have hvU : C.v ∈ U := by simp [U]
  have huC : C.u ∉ Uᶜ := by simp [huU]
  have hvC : C.v ∉ Uᶜ := by simp [hvU]
  have hdefect : (G.induce Uᶜ).loopCount +
      (G.induce Uᶜ).parallelPairCount ≤ 1 :=
    G.induce_defect_le_one_of_parallel_pair_outside hmin.in_class
      Uᶜ huC hvC C.uv_ne (by rw [C.uv_two])
  have hclassC : (G.closeTwoCut Uᶜ hcutC).InTashkinovClass :=
    G.closeTwoCut_inTashkinovClass_of_defect_le_one_of_endpoints_ne
      hmin.in_class.1 Uᶜ hcutC hdefect hne
  have hUC : Uᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hempty
    have hUuniv : U = Finset.univ :=
      (Finset.compl_eq_empty_iff U).mp hempty
    have hzero : G.boundaryMultiplicity U = 0 := by
      rw [G.boundaryMultiplicity_eq_sum_outsideDegree, hUuniv]
      simp [Pseudograph.outsideDegree]
    omega
  letI : Nonempty ↑(Uᶜ) := Finset.nonempty_coe_sort.mpr hUC
  have hproperC : Uᶜ ≠ Finset.univ := by
    intro hC
    have huComp : C.u ∈ Uᶜ := by rw [hC]; simp
    exact huC huComp
  have hcardC : Fintype.card ↑(Uᶜ) < n := by
    rw [Fintype.card_coe]
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ Uᶜ, hproperC⟩)
    simpa using hlt
  have hpartC : (G.closeTwoCut Uᶜ hcutC).ContainsRegularPart 3 :=
    hmin.contains_of_card_lt (G.closeTwoCut Uᶜ hcutC) hclassC hcardC
  have hlocal : (G.closeTwoCut U hcut).ContainsRegularPart 3 := by
    simpa [U, hcut] using
      C.single_outer_localClosure_contains hmin.in_class.1 hab
  exact hmin.no_cubic_part
    (G.containsRegularPart_of_twoCutClosures U hcut hlocal (by
      simpa [hcutC] using hpartC))

lemma IsVertexMinimalCounterexample.single_outer_common_vertex
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 1) :
    ∃ w : Fin n,
      w ∉ ({C.u, C.v, C.a, C.z, C.b} : Finset (Fin n)) ∧
      0 < G.mult C.a w ∧ 0 < G.mult C.b w := by
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hcut, houtA, houtB, houtU, houtV, houtZ⟩ :=
    C.single_outer_twoCut hmin.in_class.1 hab
  have honly : ∀ x, x ∈ U → x ≠ C.a → x ≠ C.b →
      G.outsideDegree U x = 0 := by
    intro x hx hxa hxb
    simp only [U, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | h | rfl | rfl
    · exact houtU
    · exact houtV
    · exact False.elim (hxa h)
    · exact houtZ
    · exact False.elim (hxb rfl)
  have heq := hmin.single_outer_opposite_endpoints_eq C hab
  have hdata := G.twoCut_common_opposite_endpoint_edges U hcut
    (a := C.a) (b := C.b) (by simp [U]) (by simp [U]) C.ab_ne
    houtA houtB honly (by simpa [U, hcut] using heq)
  let w := (Pseudograph.twoCutEdge G Uᶜ
    ((G.boundaryMultiplicity_compl U).trans hcut) 0).inside
  exact ⟨w, by simpa [U, w] using hdata.1,
    by simpa [w] using hdata.2.1, by simpa [w] using hdata.2.2⟩

/-- The common residual endpoint in the single-outer-edge case is
loopless.  If it carried a loop, the six saturated vertices would induce a
quartic graph with the displayed matching `ua, vz, bw`; deleting that
matching gives a cubic part. -/
lemma IsVertexMinimalCounterexample.single_outer_common_vertex_loopless
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 1)
    {w : Fin n}
    (hw : w ∉ ({C.u, C.v, C.a, C.z, C.b} : Finset (Fin n)))
    (haw : 0 < G.mult C.a w) (hbw : 0 < G.mult C.b w) :
    G.mult w w = 0 := by
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  let T : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b, w}
  have hwu : w ≠ C.u := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwv : w ≠ C.v := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwa : w ≠ C.a := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwz : w ≠ C.z := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwb : w ≠ C.b := by
    intro h
    subst w
    exact hw (by simp [U])
  obtain ⟨_haa, _hau, _haz, _hab, hawOne, haOther⟩ :=
    G.four_neighbors_saturate hmin.in_class.1
      C.ua_ne.symm C.az_ne C.ab_ne hwa.symm
      C.uz_ne C.ub_ne hwu.symm C.zb_ne hwz.symm hwb.symm
      (by simpa only [G.mult_comm] using C.ua_pos) C.az_pos (by omega) haw
  obtain ⟨_hbb, _hbv, _hbz, _hba, hbwOne, hbOther⟩ :=
    G.four_neighbors_saturate hmin.in_class.1
      C.vb_ne.symm C.zb_ne.symm C.ab_ne.symm hwb.symm
      C.vz_ne C.va_ne hwv.symm C.az_ne.symm hwz.symm hwa.symm
      (by simpa only [G.mult_comm] using C.vb_pos)
      (by simpa only [G.mult_comm] using C.zb_pos)
      (by rw [G.mult_comm, hab]; omega) hbw
  by_contra hloop
  have hloopPos : 0 < G.mult w w := Nat.pos_of_ne_zero hloop
  obtain ⟨_hww, _hwa, _hwb, hwOther⟩ :=
    G.loop_and_two_neighbors_saturate hmin.in_class.1
      hwa hwb C.ab_ne hloopPos
      (by simpa only [G.mult_comm] using haw)
      (by simpa only [G.mult_comm] using hbw)
  obtain ⟨_hua, _huz, huOther⟩ := C.saturate_u hmin.in_class.1
  obtain ⟨_hvz, _hvb, hvOther⟩ := C.saturate_v hmin.in_class.1
  obtain ⟨_hzz, _hzu, _hzv, _hza, _hzb, hzOther⟩ :=
    C.saturate_z hmin.in_class.1
  have hout : ∀ x, x ∈ T → G.outsideDegree T x = 0 := by
    intro x hx
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro y hy
    have hyT : y ∉ T := by
      simpa only [Finset.mem_compl] using hy
    simp only [T, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
    · apply huOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hvOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply haOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hzOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hbOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hwOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
  have hTreg : (G.induce T).IsRegularOfDegree 4 :=
    G.induce_isRegularOfDegree_of_outsideDegree_eq_zero T
      hmin.in_class.1 hout
  let f : Fin 6 → T := ![
    ⟨C.u, by simp [T]⟩, ⟨C.a, by simp [T]⟩,
    ⟨C.v, by simp [T]⟩, ⟨C.z, by simp [T]⟩,
    ⟨C.b, by simp [T]⟩, ⟨w, by simp [T]⟩]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;>
      simp [f, Subtype.ext_iff, C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne,
        C.va_ne, C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne,
        C.uv_ne.symm, C.ua_ne.symm, C.uz_ne.symm, C.ub_ne.symm,
        C.va_ne.symm, C.vz_ne.symm, C.vb_ne.symm, C.az_ne.symm,
        C.ab_ne.symm, C.zb_ne.symm,
        hwu, hwv, hwa, hwz, hwb, hwu.symm, hwv.symm, hwa.symm,
        hwz.symm, hwb.symm] at hij ⊢
  have hcover : ∀ x : T, ∃ i : Fin 6, x = f i := by
    intro x
    have hx := x.2
    simp only [T, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with h | h | h | h | h | h
    · exact ⟨0, Subtype.ext h⟩
    · exact ⟨2, Subtype.ext h⟩
    · exact ⟨1, Subtype.ext h⟩
    · exact ⟨3, Subtype.ext h⟩
    · exact ⟨4, Subtype.ext h⟩
    · exact ⟨5, Subtype.ext h⟩
  apply hmin.no_cubic_part
  apply G.containsRegularPart_of_induce_of_threeMatchingEdges T hTreg f hf hcover
  · change 0 < G.mult C.u C.a
    exact C.ua_pos
  · change 0 < G.mult C.v C.z
    exact C.vz_pos
  · change 0 < G.mult C.b w
    exact hbw

/-- The single outer edge itself is impossible.  After the residual edges
are forced to a common loopless vertex `w`, the six core vertices form a
two-cut.  Their closure has the matching-complement cubic part; the
opposite closure remains in class `B`, using either its nonloop closing
edge or the two parallel pairs left outside that shore. -/
lemma IsVertexMinimalCounterexample.single_outer_edge_impossible
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 1) : False := by
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨w, hw, haw, hbw⟩ := hmin.single_outer_common_vertex C hab
  have hww : G.mult w w = 0 :=
    hmin.single_outer_common_vertex_loopless C hab hw haw hbw
  let T : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b, w}
  have hwu : w ≠ C.u := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwv : w ≠ C.v := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwa : w ≠ C.a := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwz : w ≠ C.z := by
    intro h
    subst w
    exact hw (by simp [U])
  have hwb : w ≠ C.b := by
    intro h
    subst w
    exact hw (by simp [U])
  obtain ⟨_haa, _hau, _haz, _hab, hawOne, haOther⟩ :=
    G.four_neighbors_saturate hmin.in_class.1
      C.ua_ne.symm C.az_ne C.ab_ne hwa.symm
      C.uz_ne C.ub_ne hwu.symm C.zb_ne hwz.symm hwb.symm
      (by simpa only [G.mult_comm] using C.ua_pos) C.az_pos (by omega) haw
  obtain ⟨_hbb, _hbv, _hbz, _hba, hbwOne, hbOther⟩ :=
    G.four_neighbors_saturate hmin.in_class.1
      C.vb_ne.symm C.zb_ne.symm C.ab_ne.symm hwb.symm
      C.vz_ne C.va_ne hwv.symm C.az_ne.symm hwz.symm hwa.symm
      (by simpa only [G.mult_comm] using C.vb_pos)
      (by simpa only [G.mult_comm] using C.zb_pos)
      (by rw [G.mult_comm, hab]; omega) hbw
  obtain ⟨_hua, _huz, huOther⟩ := C.saturate_u hmin.in_class.1
  obtain ⟨_hvz, _hvb, hvOther⟩ := C.saturate_v hmin.in_class.1
  obtain ⟨_hzz, _hzu, _hzv, _hza, _hzb, hzOther⟩ :=
    C.saturate_z hmin.in_class.1
  have hwu0 : G.mult w C.u = 0 := by
    rw [G.mult_comm]
    exact huOther w hwu hwv hwa hwz
  have hwv0 : G.mult w C.v = 0 := by
    rw [G.mult_comm]
    exact hvOther w hwv hwu hwz hwb
  have hwz0 : G.mult w C.z = 0 := by
    rw [G.mult_comm]
    exact hzOther w hwz hwu hwv hwa hwb
  have hwaOne : G.mult w C.a = 1 := by
    simpa only [G.mult_comm] using hawOne
  have hwbOne : G.mult w C.b = 1 := by
    simpa only [G.mult_comm] using hbwOne
  have houtCore : ∀ x, x ∈ U → G.outsideDegree T x = 0 := by
    intro x hx
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro y hy
    have hyT : y ∉ T := by
      simpa only [Finset.mem_compl] using hy
    simp only [U, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl
    · apply huOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hvOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply haOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hzOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
    · apply hbOther y
      all_goals intro h <;> subst y <;> simp [T] at hyT
  let ws : T := ⟨w, by simp [T]⟩
  have hdegW : (G.induce T).degree ws = 2 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum, Finset.univ_eq_attach T]
    change G.mult w w + ∑ x ∈ T.attach, G.mult w (x : Fin n) = 2
    rw [Finset.sum_attach]
    change G.mult w w + ∑ x ∈ T, G.mult w x = 2
    simp [T, hww, hwu0, hwv0, hwz0, hwaOne, hwbOne, hwu, hwv,
      hwa, hwz, hwb, hwu.symm, hwv.symm, hwa.symm, hwz.symm,
      hwb.symm, C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne,
      C.va_ne, C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
  have houtW : G.outsideDegree T w = 2 := by
    have h := G.degree_induce_add_outsideDegree T w (by simp [T])
    change (G.induce T).degree ws + G.outsideDegree T w = G.degree w at h
    rw [hdegW, hmin.in_class.1 w] at h
    omega
  have hcut : G.boundaryMultiplicity T = 2 := by
    rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
    have hu := houtCore C.u (by simp [U])
    have hv := houtCore C.v (by simp [U])
    have ha := houtCore C.a (by simp [U])
    have hz := houtCore C.z (by simp [U])
    have hb := houtCore C.b (by simp [U])
    simp [T, hu, hv, ha, hz, hb, houtW, C.uv_ne, C.ua_ne,
      C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne,
      C.ab_ne, C.zb_ne, hwu, hwv, hwa, hwz, hwb]
  have hlocal : (G.closeTwoCut T hcut).ContainsRegularPart 3 := by
    let Q := G.closeTwoCut T hcut
    have hQreg : Q.IsRegularOfDegree 4 :=
      G.closeTwoCut_isRegularOfDegree T hcut hmin.in_class.1
    let f : Fin 6 → T := ![
      ⟨C.u, by simp [T]⟩, ⟨C.a, by simp [T]⟩,
      ⟨C.v, by simp [T]⟩, ⟨C.z, by simp [T]⟩,
      ⟨C.b, by simp [T]⟩, ⟨w, by simp [T]⟩]
    have hf : Function.Injective f := by
      intro i j hij
      fin_cases i <;> fin_cases j <;>
        simp [f, Subtype.ext_iff, C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne,
          C.va_ne, C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne,
          C.uv_ne.symm, C.ua_ne.symm, C.uz_ne.symm, C.ub_ne.symm,
          C.va_ne.symm, C.vz_ne.symm, C.vb_ne.symm, C.az_ne.symm,
          C.ab_ne.symm, C.zb_ne.symm, hwu, hwv, hwa, hwz, hwb,
          hwu.symm, hwv.symm, hwa.symm, hwz.symm, hwb.symm] at hij ⊢
    have hcover : ∀ x : T, ∃ i : Fin 6, x = f i := by
      intro x
      have hx := x.2
      simp only [T, Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with h | h | h | h | h | h
      · exact ⟨0, Subtype.ext h⟩
      · exact ⟨2, Subtype.ext h⟩
      · exact ⟨1, Subtype.ext h⟩
      · exact ⟨3, Subtype.ext h⟩
      · exact ⟨4, Subtype.ext h⟩
      · exact ⟨5, Subtype.ext h⟩
    let F := Pseudograph.threeMatchingEdges f
    have hFpart : F.IsPart Q :=
      Pseudograph.threeMatchingEdges_isPart Q f hf
        (by change 0 < G.mult C.u C.a + _; omega)
        (by change 0 < G.mult C.v C.z + _; omega)
        (by change 0 < G.mult C.b w + _; omega)
    have hFdeg : ∀ x, F.degree x = 1 :=
      Pseudograph.degree_threeMatchingEdges_eq_one f hf hcover
    letI : Nonempty T := ⟨f 0⟩
    exact Q.containsRegularPart_of_degreeOnePart hQreg F hFpart hFdeg
  let hcutC : G.boundaryMultiplicity Tᶜ = 2 :=
    (G.boundaryMultiplicity_compl T).trans hcut
  have hTC : Tᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hempty
    have hTuniv : T = Finset.univ :=
      (Finset.compl_eq_empty_iff T).mp hempty
    have hzero : G.boundaryMultiplicity T = 0 := by
      rw [G.boundaryMultiplicity_eq_sum_outsideDegree, hTuniv]
      simp [Pseudograph.outsideDegree]
    omega
  letI : Nonempty ↑(Tᶜ) := Finset.nonempty_coe_sort.mpr hTC
  have hproperC : Tᶜ ≠ Finset.univ := by
    intro hC
    have huT : C.u ∈ T := by simp [T]
    have huC : C.u ∈ Tᶜ := by rw [hC]; simp
    exact (Finset.mem_compl.mp huC) huT
  have hcardC : Fintype.card ↑(Tᶜ) < n := by
    rw [Fintype.card_coe]
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ Tᶜ, hproperC⟩)
    simpa using hlt
  have hclassC : (G.closeTwoCut Tᶜ hcutC).InTashkinovClass := by
    by_cases hne :
        (Pseudograph.twoCutEdge G Tᶜ hcutC 0).inside ≠
          (Pseudograph.twoCutEdge G Tᶜ hcutC 1).inside
    · have huC : C.u ∉ Tᶜ := by simp [T]
      have hvC : C.v ∉ Tᶜ := by simp [T]
      have hdefect : (G.induce Tᶜ).loopCount +
          (G.induce Tᶜ).parallelPairCount ≤ 1 :=
        G.induce_defect_le_one_of_parallel_pair_outside hmin.in_class
          Tᶜ huC hvC C.uv_ne (by rw [C.uv_two])
      exact G.closeTwoCut_inTashkinovClass_of_defect_le_one_of_endpoints_ne
        hmin.in_class.1 Tᶜ hcutC hdefect hne
    · push_neg at hne
      have honly : ∀ y, y ∈ T → y ≠ w →
          G.outsideDegree T y = 0 := by
        intro y hy hyw
        have hyU : y ∈ U := by
          simp only [T, U, Finset.mem_insert, Finset.mem_singleton] at hy ⊢
          rcases hy with h | h | h | h | h | h
          · exact .inl h
          · exact .inr (.inl h)
          · exact .inr (.inr (.inl h))
          · exact .inr (.inr (.inr (.inl h)))
          · exact .inr (.inr (.inr (.inr h)))
          · exact False.elim (hyw h)
        exact houtCore y hyU
      have hpdata := G.twoCut_common_opposite_endpoint_parallel T hcut
        (w := w) (by simp [T]) honly (by simpa [hcutC] using hne)
      let x := (Pseudograph.twoCutEdge G Tᶜ hcutC 0).inside
      have hxT : x ∉ T := by simpa [x, hcutC] using hpdata.1
      have hwx : w ≠ x := by
        intro h
        have hwT : w ∈ T := by simp [T]
        exact hxT (h ▸ hwT)
      have hux : C.u ≠ x := by
        intro h
        have huT : C.u ∈ T := by simp [T]
        exact hxT (h ▸ huT)
      have hbase : (G.induce Tᶜ).HasSimpleMultiplicities :=
        G.induce_hasSimpleMultiplicities_of_two_parallel_pairs_outside
          hmin.in_class Tᶜ
          (by simp [T]) (by simp [T]) (by simp [T])
          C.uv_ne hwx (by rw [C.uv_two])
          (by simpa [x, hcutC] using hpdata.2)
          (by intro h; exact hwu (congrArg Prod.fst h).symm)
          (by intro h; exact hux (congrArg Prod.fst h))
      exact G.closeTwoCut_inTashkinovClass_of_induce_hasSimpleMultiplicities
        hmin.in_class.1 Tᶜ hcutC hbase
  have hpartC : (G.closeTwoCut Tᶜ hcutC).ContainsRegularPart 3 :=
    hmin.contains_of_card_lt (G.closeTwoCut Tᶜ hcutC) hclassC hcardC
  exact hmin.no_cubic_part
    (G.containsRegularPart_of_twoCutClosures T hcut hlocal (by
      simpa [hcutC] using hpartC))

/-- If the two outer vertices are nonadjacent, the first outer vertex is
loopless.  A loop there leaves a two-cut at the other outer vertex; closing
it creates the second loop in an explicit four-vertex cubic part. -/
lemma IsVertexMinimalCounterexample.first_outer_loopless_of_no_outer_edge
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) :
    G.mult C.a C.a = 0 := by
  by_contra haa
  have haaPos : 0 < G.mult C.a C.a := Nat.pos_of_ne_zero haa
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hua, _huz, huOther⟩ := C.saturate_u hmin.in_class.1
  obtain ⟨_hvz, hvb, hvOther⟩ := C.saturate_v hmin.in_class.1
  obtain ⟨_hzz, _hzu, _hzv, hza, hzb, hzOther⟩ :=
    C.saturate_z hmin.in_class.1
  obtain ⟨_haaOne, hau, haz, haOther⟩ :=
    G.loop_and_two_neighbors_saturate hmin.in_class.1
      C.ua_ne.symm C.az_ne C.uz_ne haaPos
      (by simpa only [G.mult_comm] using C.ua_pos) C.az_pos
  have hbb : G.mult C.b C.b = 0 := by
    have hsum := G.mult_self_add_mult_self_le_loopCount C.ab_ne
    have hloopBound := hmin.in_class.2.1
    omega
  have hbu : G.mult C.b C.u = 0 := by
    rw [G.mult_comm]
    exact huOther C.b C.ub_ne.symm C.vb_ne.symm C.ab_ne.symm C.zb_ne.symm
  have hbv : G.mult C.b C.v = 1 := by
    simpa only [G.mult_comm] using hvb
  have hbz : G.mult C.b C.z = 1 := by
    simpa only [G.mult_comm] using hzb
  have hba : G.mult C.b C.a = 0 := by
    simpa only [G.mult_comm] using hab
  have hbOutside : G.outsideDegree U C.b = 2 := by
    let bs : U := ⟨C.b, by simp [U]⟩
    have hdegB : (G.induce U).degree bs = 2 := by
      rw [Pseudograph.degree_eq_mult_self_add_sum, Finset.univ_eq_attach U]
      change G.mult C.b C.b + ∑ x ∈ U.attach, G.mult C.b (x : Fin n) = 2
      rw [Finset.sum_attach]
      change G.mult C.b C.b + ∑ x ∈ U, G.mult C.b x = 2
      simp [U, hbb, hbu, hbv, hbz, hba, C.uv_ne, C.ua_ne,
        C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne,
        C.ab_ne, C.zb_ne]
    have h := G.degree_induce_add_outsideDegree U C.b (by simp [U])
    change (G.induce U).degree bs + G.outsideDegree U C.b = G.degree C.b at h
    rw [hdegB, hmin.in_class.1 C.b] at h
    omega
  have houtU : G.outsideDegree U C.u = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply huOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtV : G.outsideDegree U C.v = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply hvOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtA : G.outsideDegree U C.a = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply haOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtZ : G.outsideDegree U C.z = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply hzOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have hcut : G.boundaryMultiplicity U = 2 := by
    rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
    simp [U, houtU, houtV, houtA, houtZ, hbOutside, C.uv_ne,
      C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne,
      C.az_ne, C.ab_ne, C.zb_ne]
  have hcount := G.outsideDegree_eq_twoCutEndpointCount U hcut C.b
    (by simp [U])
  rw [hbOutside] at hcount
  have hend0 : (Pseudograph.twoCutEdge G U hcut 0).inside = C.b := by
    by_contra h
    rw [if_neg h] at hcount
    split at hcount <;> omega
  have hend1 : (Pseudograph.twoCutEdge G U hcut 1).inside = C.b := by
    by_contra h
    rw [if_neg h] at hcount
    split at hcount <;> omega
  have hlocal : (G.closeTwoCut U hcut).ContainsRegularPart 3 := by
    let us : U := ⟨C.u, by simp [U]⟩
    let vs : U := ⟨C.v, by simp [U]⟩
    let as : U := ⟨C.a, by simp [U]⟩
    let bs : U := ⟨C.b, by simp [U]⟩
    have hUV : 2 ≤ (G.closeTwoCut U hcut).mult us vs := by
      change 2 ≤ G.mult C.u C.v + _
      rw [C.uv_two]
      omega
    have hAA : 0 < (G.closeTwoCut U hcut).mult as as := by
      change 0 < G.mult C.a C.a + _
      omega
    have hBB : 0 < (G.closeTwoCut U hcut).mult bs bs := by
      simp [Pseudograph.closeTwoCut, bs, hend0, hend1, hbb]
    have hUA : 0 < (G.closeTwoCut U hcut).mult us as := by
      change 0 < G.mult C.u C.a + _
      omega
    have hVB : 0 < (G.closeTwoCut U hcut).mult vs bs := by
      change 0 < G.mult C.v C.b + _
      omega
    exact (G.closeTwoCut U hcut).containsRegularPart_of_doubleEdge_twoLoops_and_links
        (fun h ↦ C.uv_ne (congrArg Subtype.val h))
        (fun h ↦ C.ua_ne (congrArg Subtype.val h))
        (fun h ↦ C.ub_ne (congrArg Subtype.val h))
        (fun h ↦ C.va_ne (congrArg Subtype.val h))
        (fun h ↦ C.vb_ne (congrArg Subtype.val h))
        (fun h ↦ C.ab_ne (congrArg Subtype.val h))
        hUV hAA hBB hUA hVB
  let hcutC : G.boundaryMultiplicity Uᶜ = 2 :=
    (G.boundaryMultiplicity_compl U).trans hcut
  have hUC : Uᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hempty
    have hUuniv : U = Finset.univ :=
      (Finset.compl_eq_empty_iff U).mp hempty
    have hzero : G.boundaryMultiplicity U = 0 := by
      rw [G.boundaryMultiplicity_eq_sum_outsideDegree, hUuniv]
      simp [Pseudograph.outsideDegree]
    omega
  letI : Nonempty ↑(Uᶜ) := Finset.nonempty_coe_sort.mpr hUC
  have hproperC : Uᶜ ≠ Finset.univ := by
    intro hC
    have huC : C.u ∈ Uᶜ := by rw [hC]; simp
    exact (Finset.mem_compl.mp huC) (by simp [U])
  have hcardC : Fintype.card ↑(Uᶜ) < n := by
    rw [Fintype.card_coe]
    have hlt := Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ Uᶜ, hproperC⟩)
    simpa using hlt
  have hbase : (G.induce Uᶜ).HasSimpleMultiplicities :=
    G.induce_hasSimpleMultiplicities_of_loop_and_parallel_outside
      hmin.in_class Uᶜ (by simp [U]) (by simp [U]) (by simp [U])
      C.uv_ne haaPos (by rw [C.uv_two])
  have hclassC : (G.closeTwoCut Uᶜ hcutC).InTashkinovClass :=
    G.closeTwoCut_inTashkinovClass_of_induce_hasSimpleMultiplicities
      hmin.in_class.1 Uᶜ hcutC hbase
  have hpartC : (G.closeTwoCut Uᶜ hcutC).ContainsRegularPart 3 :=
    hmin.contains_of_card_lt (G.closeTwoCut Uᶜ hcutC) hclassC hcardC
  exact hmin.no_cubic_part
    (G.containsRegularPart_of_twoCutClosures U hcut hlocal (by
      simpa [hcutC] using hpartC))

/-- In the no-outer-edge case both outer vertices are loopless, by
reflection of the preceding argument. -/
lemma IsVertexMinimalCounterexample.outer_loopless_of_no_outer_edge
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) :
    G.mult C.a C.a = 0 ∧ G.mult C.b C.b = 0 := by
  refine ⟨hmin.first_outer_loopless_of_no_outer_edge C hab, ?_⟩
  have hswap : G.mult C.swap.a C.swap.b = 0 := by
    simpa only [ThreeOutsideDoubleCore.swap, G.mult_comm] using hab
  simpa only [ThreeOutsideDoubleCore.swap] using
    hmin.first_outer_loopless_of_no_outer_edge C.swap hswap

/-- With no outer edge, the five core vertices form a four-cut, with two
incidences at each outer vertex and none at the other three vertices. -/
lemma IsVertexMinimalCounterexample.no_outer_fourCut
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    G.boundaryMultiplicity U = 4 ∧
      G.outsideDegree U C.a = 2 ∧ G.outsideDegree U C.b = 2 ∧
      G.outsideDegree U C.u = 0 ∧ G.outsideDegree U C.v = 0 ∧
      G.outsideDegree U C.z = 0 := by
  dsimp only
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hua, _huz, huOther⟩ := C.saturate_u hmin.in_class.1
  obtain ⟨_hvz, hvb, hvOther⟩ := C.saturate_v hmin.in_class.1
  obtain ⟨_hzz, _hzu, _hzv, hza, hzb, hzOther⟩ :=
    C.saturate_z hmin.in_class.1
  obtain ⟨haa, hbb⟩ := hmin.outer_loopless_of_no_outer_edge C hab
  have hbu : G.mult C.b C.u = 0 := by
    rw [G.mult_comm]
    exact huOther C.b C.ub_ne.symm C.vb_ne.symm C.ab_ne.symm C.zb_ne.symm
  have hav : G.mult C.a C.v = 0 := by
    rw [G.mult_comm]
    exact hvOther C.a C.va_ne.symm C.ua_ne.symm C.az_ne C.ab_ne
  have hau : G.mult C.a C.u = 1 := by
    simpa only [G.mult_comm] using hua
  have haz : G.mult C.a C.z = 1 := by
    simpa only [G.mult_comm] using hza
  have hbv : G.mult C.b C.v = 1 := by
    simpa only [G.mult_comm] using hvb
  have hbz : G.mult C.b C.z = 1 := by
    simpa only [G.mult_comm] using hzb
  have hba : G.mult C.b C.a = 0 := by
    simpa only [G.mult_comm] using hab
  have hdegA : (G.induce U).degree ⟨C.a, by simp [U]⟩ = 2 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum, Finset.univ_eq_attach U]
    change G.mult C.a C.a + ∑ x ∈ U.attach, G.mult C.a (x : Fin n) = 2
    rw [Finset.sum_attach]
    change G.mult C.a C.a + ∑ x ∈ U, G.mult C.a x = 2
    simp [U, haa, hau, hav, haz, hab, C.uv_ne, C.ua_ne, C.uz_ne,
      C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
  have hdegB : (G.induce U).degree ⟨C.b, by simp [U]⟩ = 2 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum, Finset.univ_eq_attach U]
    change G.mult C.b C.b + ∑ x ∈ U.attach, G.mult C.b (x : Fin n) = 2
    rw [Finset.sum_attach]
    change G.mult C.b C.b + ∑ x ∈ U, G.mult C.b x = 2
    simp [U, hbb, hbu, hbv, hbz, hba, C.uv_ne, C.ua_ne, C.uz_ne,
      C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
  have houtA : G.outsideDegree U C.a = 2 := by
    have h := G.degree_induce_add_outsideDegree U C.a (by simp [U])
    change (G.induce U).degree ⟨C.a, by simp [U]⟩ +
      G.outsideDegree U C.a = G.degree C.a at h
    rw [hdegA, hmin.in_class.1 C.a] at h
    omega
  have houtB : G.outsideDegree U C.b = 2 := by
    have h := G.degree_induce_add_outsideDegree U C.b (by simp [U])
    change (G.induce U).degree ⟨C.b, by simp [U]⟩ +
      G.outsideDegree U C.b = G.degree C.b at h
    rw [hdegB, hmin.in_class.1 C.b] at h
    omega
  have houtU : G.outsideDegree U C.u = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply huOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtV : G.outsideDegree U C.v = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply hvOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have houtZ : G.outsideDegree U C.z = 0 := by
    unfold Pseudograph.outsideDegree
    apply Finset.sum_eq_zero
    intro x hx
    have hxU : x ∉ U := by simpa only [Finset.mem_compl] using hx
    apply hzOther x
    all_goals intro h <;> subst x <;> simp [U] at hxU
  have hcut : G.boundaryMultiplicity U = 4 := by
    rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
    simp [U, houtA, houtB, houtU, houtV, houtZ, C.uv_ne, C.ua_ne,
      C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne,
      C.ab_ne, C.zb_ne]
  exact ⟨hcut, houtA, houtB, houtU, houtV, houtZ⟩

/-- Every labelled edge of the no-outer-edge four-cut leaves from one of
the two outer vertices. -/
lemma IsVertexMinimalCounterexample.no_outer_cutEndpoint
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    let hcut : G.boundaryMultiplicity U = 4 :=
      (hmin.no_outer_fourCut C hab).1
    ∀ i : Fin 4, ((G.cutEquiv U hcut).symm i).inside = C.a ∨
      ((G.cutEquiv U hcut).symm i).inside = C.b := by
  dsimp only
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hcut, houtA, houtB, houtU, houtV, houtZ⟩ :=
    hmin.no_outer_fourCut C hab
  intro i
  let e : Pseudograph.CrossingEdge G U := (G.cutEquiv U hcut).symm i
  have hpos : 0 < G.outsideDegree U e.inside := by
    unfold Pseudograph.outsideDegree
    have hle : G.mult e.inside e.outside ≤
        ∑ y ∈ Uᶜ, G.mult e.inside y :=
      Finset.single_le_sum (s := Uᶜ)
        (f := fun y ↦ G.mult e.inside y)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_compl.mpr e.outside_notMem)
    exact Nat.lt_of_lt_of_le (Nat.zero_lt_of_lt e.index.isLt) hle
  have hmem := e.inside_mem
  simp only [U, Finset.mem_insert, Finset.mem_singleton] at hmem
  rcases hmem with hu | hv | ha | hz | hb
  · rw [hu, houtU] at hpos
    omega
  · rw [hv, houtV] at hpos
    omega
  · exact .inl ha
  · rw [hz, houtZ] at hpos
    omega
  · exact .inr hb

/-- Every label of the no-outer-edge four-cut has a local cubic star
closure witness omitting that label.  The complementary degree-one parts
are the two explicit matchings
`center-a, u-z, v-b` and `center-b, u-a, v-z`. -/
lemma IsVertexMinimalCounterexample.no_outer_star_localWitnesses
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    let hcut : G.boundaryMultiplicity U = 4 :=
      (hmin.no_outer_fourCut C hab).1
    ∀ i : Fin 4, ∃ H : Pseudograph (Option U),
      H.IsPart (G.closeFourCutStar U hcut) ∧
      (∃ v, H.degree v = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      Pseudograph.StarOmitsExactly (G.cutEquiv U hcut).symm H i := by
  dsimp only
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hcut, _houtA, _houtB, _houtU, _houtV, _houtZ⟩ :=
    hmin.no_outer_fourCut C hab
  let E : Fin 4 ≃ Pseudograph.CrossingEdge G U := (G.cutEquiv U hcut).symm
  intro i
  have hi := hmin.no_outer_cutEndpoint C hab i
  change (E i).inside = C.a ∨ (E i).inside = C.b at hi
  rcases hi with hia | hib
  · let us : U := ⟨C.u, by simp [U]⟩
    let vs : U := ⟨C.v, by simp [U]⟩
    let as : U := ⟨C.a, by simp [U]⟩
    let zs : U := ⟨C.z, by simp [U]⟩
    let bs : U := ⟨C.b, by simp [U]⟩
    let f : Fin 6 → Option U := ![none, some as, some us, some zs, some vs, some bs]
    have hsurj : Function.Surjective f := by
      intro x
      cases x with
      | none => exact ⟨0, rfl⟩
      | some x =>
          have hx := x.2
          simp only [U, Finset.mem_insert, Finset.mem_singleton] at hx
          rcases hx with h | h | h | h | h
          · exact ⟨2, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨4, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨1, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨3, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨5, congrArg some (Subtype.ext h.symm)⟩
    have hcard : Fintype.card (Fin 6) = Fintype.card (Option U) := by
      rw [Fintype.card_fin, Fintype.card_option, Fintype.card_coe]
      simp [U, C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
        C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
    have hf : Function.Injective f :=
      ((Fintype.bijective_iff_surjective_and_card f).2
        ⟨hsurj, hcard⟩).1
    have hcover : ∀ x : Option U, ∃ j : Fin 6, x = f j := by
      intro x
      obtain ⟨j, hj⟩ := hsurj x
      exact ⟨j, hj.symm⟩
    let F := Pseudograph.threeMatchingEdges f
    have hstar : 0 < (G.closeFourCutStarWith U E).mult (f 0) (f 1) := by
      change 0 < G.listingEndpointCount U E C.a
      unfold Pseudograph.listingEndpointCount
      have hle : (if (E i).inside = C.a then 1 else 0) ≤
          ∑ j : Fin 4, if (E j).inside = C.a then 1 else 0 := by
        exact Finset.single_le_sum (s := Finset.univ)
          (f := fun j : Fin 4 ↦ if (E j).inside = C.a then 1 else 0)
          (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ i)
      rw [if_pos hia] at hle
      omega
    have hFpart : F.IsPart (G.closeFourCutStarWith U E) :=
      Pseudograph.threeMatchingEdges_isPart _ f hf hstar
        (by change 0 < G.mult C.u C.z; exact C.uz_pos)
        (by change 0 < G.mult C.v C.b; exact C.vb_pos)
    have hFdeg : ∀ x, F.degree x = 1 :=
      Pseudograph.degree_threeMatchingEdges_eq_one f hf hcover
    have hFstar : ∀ v : U, F.mult none (some v) =
        if (E i).inside = (v : Fin n) then 1 else 0 := by
      intro v
      change (Pseudograph.threeMatchingEdges
        (![none, some as, some us, some zs, some vs, some bs] :
          Fin 6 → Option U)).mult none (some v) = _
      rw [Pseudograph.threeMatchingEdges_none_row, hia]
      by_cases hv : v = as
      · subst v
        simp [as]
      · rw [if_neg hv, if_neg]
        intro hval
        apply hv
        apply Subtype.ext
        exact hval.symm
    simpa [Pseudograph.closeFourCutStar, E] using
      G.exists_cubicStarPart_omitting_of_degreeOnePart
        hmin.in_class.1 U E i F hFpart hFdeg hFstar
  · let us : U := ⟨C.u, by simp [U]⟩
    let vs : U := ⟨C.v, by simp [U]⟩
    let as : U := ⟨C.a, by simp [U]⟩
    let zs : U := ⟨C.z, by simp [U]⟩
    let bs : U := ⟨C.b, by simp [U]⟩
    let f : Fin 6 → Option U := ![none, some bs, some us, some as, some vs, some zs]
    have hsurj : Function.Surjective f := by
      intro x
      cases x with
      | none => exact ⟨0, rfl⟩
      | some x =>
          have hx := x.2
          simp only [U, Finset.mem_insert, Finset.mem_singleton] at hx
          rcases hx with h | h | h | h | h
          · exact ⟨2, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨4, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨3, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨5, congrArg some (Subtype.ext h.symm)⟩
          · exact ⟨1, congrArg some (Subtype.ext h.symm)⟩
    have hcard : Fintype.card (Fin 6) = Fintype.card (Option U) := by
      rw [Fintype.card_fin, Fintype.card_option, Fintype.card_coe]
      simp [U, C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
        C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
    have hf : Function.Injective f :=
      ((Fintype.bijective_iff_surjective_and_card f).2
        ⟨hsurj, hcard⟩).1
    have hcover : ∀ x : Option U, ∃ j : Fin 6, x = f j := by
      intro x
      obtain ⟨j, hj⟩ := hsurj x
      exact ⟨j, hj.symm⟩
    let F := Pseudograph.threeMatchingEdges f
    have hstar : 0 < (G.closeFourCutStarWith U E).mult (f 0) (f 1) := by
      change 0 < G.listingEndpointCount U E C.b
      unfold Pseudograph.listingEndpointCount
      have hle : (if (E i).inside = C.b then 1 else 0) ≤
          ∑ j : Fin 4, if (E j).inside = C.b then 1 else 0 := by
        exact Finset.single_le_sum (s := Finset.univ)
          (f := fun j : Fin 4 ↦ if (E j).inside = C.b then 1 else 0)
          (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ i)
      rw [if_pos hib] at hle
      omega
    have hFpart : F.IsPart (G.closeFourCutStarWith U E) :=
      Pseudograph.threeMatchingEdges_isPart _ f hf hstar
        (by change 0 < G.mult C.u C.a; exact C.ua_pos)
        (by change 0 < G.mult C.v C.z; exact C.vz_pos)
    have hFdeg : ∀ x, F.degree x = 1 :=
      Pseudograph.degree_threeMatchingEdges_eq_one f hf hcover
    have hFstar : ∀ v : U, F.mult none (some v) =
        if (E i).inside = (v : Fin n) then 1 else 0 := by
      intro v
      change (Pseudograph.threeMatchingEdges
        (![none, some bs, some us, some as, some vs, some zs] :
          Fin 6 → Option U)).mult none (some v) = _
      rw [Pseudograph.threeMatchingEdges_none_row, hib]
      by_cases hv : v = bs
      · subst v
        simp [bs]
      · rw [if_neg hv, if_neg]
        intro hval
        apply hv
        apply Subtype.ext
        exact hval.symm
    simpa [Pseudograph.closeFourCutStar, E] using
      G.exists_cubicStarPart_omitting_of_degreeOnePart
        hmin.in_class.1 U E i F hFpart hFdeg hFstar

/-- For the no-outer-edge five-vertex shore, a pairing which joins the two
ends at `a` and the two ends at `b` has all three local witnesses required
by paired four-cut gluing.  With one artificial loop selected, use the
double edge `uv`, the path `u-z-v`, and the edge from `z` to the selected
outer vertex.  With both loops selected, use the double edge and `u-a,v-b`.
-/
lemma IsVertexMinimalCounterexample.no_outer_pair_localWitnesses
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) :
    let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
    let hcut : G.boundaryMultiplicity U = 4 :=
      (hmin.no_outer_fourCut C hab).1
    let E : Fin 4 ≃ Pseudograph.CrossingEdge G U :=
      (G.cutEquiv U hcut).symm
    ∀ p : Pseudograph.FourPairing,
      (E p.a).inside = (E p.b).inside →
      (E p.c).inside = (E p.d).inside →
      (E p.a).inside ≠ (E p.c).inside →
      ∀ use₁ use₂ : Bool, use₁ = true ∨ use₂ = true →
        ∃ H F : Pseudograph U,
          H.IsPart (G.closeFourCutPairWith U E p) ∧
          (∃ w, H.degree w = 3) ∧
          (∀ w, H.degree w = 0 ∨ H.degree w = 3) ∧
          Pseudograph.PairClosureDecomposition E p H use₁ use₂ F := by
  dsimp only
  classical
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  let hcut : G.boundaryMultiplicity U = 4 :=
    (hmin.no_outer_fourCut C hab).1
  let E : Fin 4 ≃ Pseudograph.CrossingEdge G U :=
    (G.cutEquiv U hcut).symm
  let us : U := ⟨C.u, by simp [U]⟩
  let vs : U := ⟨C.v, by simp [U]⟩
  let as : U := ⟨C.a, by simp [U]⟩
  let zs : U := ⟨C.z, by simp [U]⟩
  let bs : U := ⟨C.b, by simp [U]⟩
  obtain ⟨hua, huz, _⟩ := C.saturate_u hmin.in_class.1
  obtain ⟨hvz, hvb, _⟩ := C.saturate_v hmin.in_class.1
  obtain ⟨_hzz, hzu, hzv, hza, hzb, _⟩ :=
    C.saturate_z hmin.in_class.1
  have haz : G.mult C.a C.z = 1 := by
    simpa only [G.mult_comm] using hza
  have hbz : G.mult C.b C.z = 1 := by
    simpa only [G.mult_comm] using hzb
  have huvs : us ≠ vs := by
    intro h
    exact C.uv_ne (congrArg Subtype.val h)
  have hcover (x : U) : x = us ∨ x = vs ∨ x = as ∨ x = zs ∨ x = bs := by
    have hx := x.2
    simp only [U, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with h | h | h | h | h
    · exact .inl (Subtype.ext h)
    · exact .inr (.inl (Subtype.ext h))
    · exact .inr (.inr (.inl (Subtype.ext h)))
    · exact .inr (.inr (.inr (.inl (Subtype.ext h))))
    · exact .inr (.inr (.inr (.inr (Subtype.ext h))))
  intro p hp₁ hp₂ hpdiff use₁ use₂ huse
  let x₁ := Pseudograph.pairEndpoint E p.a
  let y₁ := Pseudograph.pairEndpoint E p.b
  let x₂ := Pseudograph.pairEndpoint E p.c
  let y₂ := Pseudograph.pairEndpoint E p.d
  have hx₁y₁ : x₁ = y₁ := by
    apply Subtype.ext
    exact hp₁
  have hx₂y₂ : x₂ = y₂ := by
    apply Subtype.ext
    exact hp₂
  have hx₁x₂ : x₁ ≠ x₂ := by
    intro h
    exact hpdiff (congrArg Subtype.val h)
  have hx₁ : x₁ = as ∨ x₁ = bs := by
    have h := hmin.no_outer_cutEndpoint C hab p.a
    change (E p.a).inside = C.a ∨ (E p.a).inside = C.b at h
    rcases h with h | h
    · exact .inl (Subtype.ext h)
    · exact .inr (Subtype.ext h)
  have hx₂ : x₂ = as ∨ x₂ = bs := by
    have h := hmin.no_outer_cutEndpoint C hab p.c
    change (E p.c).inside = C.a ∨ (E p.c).inside = C.b at h
    rcases h with h | h
    · exact .inl (Subtype.ext h)
    · exact .inr (Subtype.ext h)
  have hcolors : (x₁ = as ∧ x₂ = bs) ∨ (x₁ = bs ∧ x₂ = as) := by
    rcases hx₁ with h₁ | h₁ <;> rcases hx₂ with h₂ | h₂
    · exact (hx₁x₂ (h₁.trans h₂.symm)).elim
    · exact .inl ⟨h₁, h₂⟩
    · exact .inr ⟨h₁, h₂⟩
    · exact (hx₁x₂ (h₁.trans h₂.symm)).elim
  have hsingle (x : U) (hx : x = as ∨ x = bs) :
      ∃ F : Pseudograph U,
        F.IsPart (G.induce U) ∧
        (∀ w, (F + Pseudograph.singleEdge x x).degree w = 0 ∨
          (F + Pseudograph.singleEdge x x).degree w = 3) ∧
        (F + Pseudograph.singleEdge x x).degree us = 3 := by
    let F : Pseudograph U :=
      ((Pseudograph.edgeCopies 2 us vs +
        Pseudograph.singleEdge us zs) +
        Pseudograph.singleEdge vs zs) + Pseudograph.singleEdge zs x
    have hFpart : F.IsPart (G.induce U) := by
      intro r s
      rcases hcover r with rfl | rfl | rfl | rfl | rfl <;>
        rcases hcover s with rfl | rfl | rfl | rfl | rfl <;>
        rcases hx with hsel | hsel <;>
        simp [F, Pseudograph.edgeCopies_mult,
          Pseudograph.singleEdge_mult, us, vs, as, zs, bs,
          hsel, C.uv_two, hua, huz, hvz, hvb, hzu, hzv, hza, hzb,
          haz, hbz,
          C.uv_ne, C.ua_ne, C.uz_ne,
          C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne, C.az_ne,
          C.ab_ne, C.zb_ne, C.uv_ne.symm, C.ua_ne.symm,
          C.uz_ne.symm, C.ub_ne.symm, C.va_ne.symm,
          C.vz_ne.symm, C.vb_ne.symm, C.az_ne.symm,
          C.ab_ne.symm, C.zb_ne.symm, G.mult_comm]
    have hdeg (w : U) :
        (F + Pseudograph.singleEdge x x).degree w = 0 ∨
          (F + Pseudograph.singleEdge x x).degree w = 3 := by
      rcases hcover w with rfl | rfl | rfl | rfl | rfl <;>
        rcases hx with hsel | hsel <;>
        simp [F, Pseudograph.degree_add,
          Pseudograph.degree_edgeCopies_of_ne,
          Pseudograph.degree_singleEdge, us, vs, as, zs, bs, hsel,
          C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
          C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne,
          C.uv_ne.symm, C.ua_ne.symm, C.uz_ne.symm,
          C.ub_ne.symm, C.va_ne.symm, C.vz_ne.symm,
          C.vb_ne.symm, C.az_ne.symm, C.ab_ne.symm, C.zb_ne.symm]
    have hpos : (F + Pseudograph.singleEdge x x).degree us = 3 := by
      rcases hx with hsel | hsel <;>
        simp [F, Pseudograph.degree_add,
          Pseudograph.degree_edgeCopies_of_ne,
          Pseudograph.degree_singleEdge, us, vs, as, zs, bs, hsel,
          C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
          C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne,
          C.uv_ne.symm, C.ua_ne.symm, C.uz_ne.symm,
          C.ub_ne.symm, C.va_ne.symm, C.vz_ne.symm,
          C.vb_ne.symm, C.az_ne.symm, C.ab_ne.symm, C.zb_ne.symm]
    exact ⟨F, hFpart, hdeg, hpos⟩
  cases use₁ <;> cases use₂
  · simp at huse
  · obtain ⟨F, hFpart, hHdeg, hHpos⟩ := hsingle x₂ hx₂
    let H := F + Pseudograph.singleEdge x₂ y₂
    have hHpart : H.IsPart (G.closeFourCutPairWith U E p) := by
      intro r s
      have hle := hFpart r s
      change F.mult r s + (Pseudograph.singleEdge x₂ y₂).mult r s ≤
        ((G.induce U).mult r s +
          (Pseudograph.singleEdge x₁ y₁).mult r s) +
          (Pseudograph.singleEdge x₂ y₂).mult r s
      omega
    have hdec : Pseudograph.PairClosureDecomposition E p H false true F := by
      refine ⟨hFpart, ?_⟩
      intro w
      simp [Pseudograph.pairClosingDegree, H, x₁, y₁, x₂, y₂,
        Pseudograph.degree_add] <;> omega
    refine ⟨H, F, hHpart, ⟨us, ?_⟩, ?_, ?_⟩
    · simpa [H, hx₂y₂] using hHpos
    · intro w
      simpa [H, hx₂y₂] using hHdeg w
    · simpa [E, U, hcut] using hdec
  · obtain ⟨F, hFpart, hHdeg, hHpos⟩ := hsingle x₁ hx₁
    let H := F + Pseudograph.singleEdge x₁ y₁
    have hHpart : H.IsPart (G.closeFourCutPairWith U E p) := by
      intro r s
      have hle := hFpart r s
      change F.mult r s + (Pseudograph.singleEdge x₁ y₁).mult r s ≤
        ((G.induce U).mult r s +
          (Pseudograph.singleEdge x₁ y₁).mult r s) +
          (Pseudograph.singleEdge x₂ y₂).mult r s
      omega
    have hdec : Pseudograph.PairClosureDecomposition E p H true false F := by
      refine ⟨hFpart, ?_⟩
      intro w
      simp [Pseudograph.pairClosingDegree, H, x₁, y₁, x₂, y₂,
        Pseudograph.degree_add]
    refine ⟨H, F, hHpart, ⟨us, ?_⟩, ?_, ?_⟩
    · simpa [H, hx₁y₁] using hHpos
    · intro w
      simpa [H, hx₁y₁] using hHdeg w
    · simpa [E, U, hcut] using hdec
  · let F : Pseudograph U :=
      (Pseudograph.edgeCopies 2 us vs + Pseudograph.singleEdge us as) +
        Pseudograph.singleEdge vs bs
    let H : Pseudograph U :=
      (F + Pseudograph.singleEdge x₁ y₁) +
        Pseudograph.singleEdge x₂ y₂
    have hFpart : F.IsPart (G.induce U) := by
      intro r s
      rcases hcover r with rfl | rfl | rfl | rfl | rfl <;>
        rcases hcover s with rfl | rfl | rfl | rfl | rfl <;>
        simp [F, Pseudograph.edgeCopies_mult,
          Pseudograph.singleEdge_mult, us, vs, as, zs, bs,
          C.uv_two, hua, hvb, C.uv_ne, C.ua_ne,
          C.uz_ne, C.ub_ne, C.va_ne, C.vz_ne, C.vb_ne,
          C.az_ne, C.ab_ne, C.zb_ne, C.uv_ne.symm,
          C.ua_ne.symm, C.uz_ne.symm, C.ub_ne.symm,
          C.va_ne.symm, C.vz_ne.symm, C.vb_ne.symm,
          C.az_ne.symm, C.ab_ne.symm, C.zb_ne.symm, G.mult_comm]
    have hHpart : H.IsPart (G.closeFourCutPairWith U E p) := by
      intro r s
      have hle := hFpart r s
      change (F.mult r s + (Pseudograph.singleEdge x₁ y₁).mult r s) +
          (Pseudograph.singleEdge x₂ y₂).mult r s ≤
        ((G.induce U).mult r s +
          (Pseudograph.singleEdge x₁ y₁).mult r s) +
          (Pseudograph.singleEdge x₂ y₂).mult r s
      omega
    have hdec : Pseudograph.PairClosureDecomposition E p H true true F := by
      refine ⟨hFpart, ?_⟩
      intro w
      change F.degree w +
          ((Pseudograph.singleEdge x₁ y₁).degree w +
            (Pseudograph.singleEdge x₂ y₂).degree w) =
        ((F + Pseudograph.singleEdge x₁ y₁) +
          Pseudograph.singleEdge x₂ y₂).degree w
      simp only [Pseudograph.degree_add]
      omega
    have hHdeg (w : U) : H.degree w = 0 ∨ H.degree w = 3 := by
      rcases hcolors with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
      · have hy₁ : y₁ = as := hx₁y₁.symm.trans h₁
        have hy₂ : y₂ = bs := hx₂y₂.symm.trans h₂
        rcases hcover w with rfl | rfl | rfl | rfl | rfl <;>
          simp [H, F, h₁, h₂, hy₁, hy₂,
            Pseudograph.degree_add, Pseudograph.degree_edgeCopies_of_ne,
            Pseudograph.degree_singleEdge, us, vs, as, zs, bs,
            C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
            C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne,
            C.uv_ne.symm, C.ua_ne.symm, C.uz_ne.symm,
            C.ub_ne.symm, C.va_ne.symm, C.vz_ne.symm,
            C.vb_ne.symm, C.az_ne.symm, C.ab_ne.symm, C.zb_ne.symm]
      · have hy₁ : y₁ = bs := hx₁y₁.symm.trans h₁
        have hy₂ : y₂ = as := hx₂y₂.symm.trans h₂
        rcases hcover w with rfl | rfl | rfl | rfl | rfl <;>
          simp [H, F, h₁, h₂, hy₁, hy₂,
            Pseudograph.degree_add, Pseudograph.degree_edgeCopies_of_ne,
            Pseudograph.degree_singleEdge, us, vs, as, zs, bs,
            C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
            C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne,
            C.uv_ne.symm, C.ua_ne.symm, C.uz_ne.symm,
            C.ub_ne.symm, C.va_ne.symm, C.vz_ne.symm,
            C.vb_ne.symm, C.az_ne.symm, C.ab_ne.symm, C.zb_ne.symm]
    refine ⟨H, F, hHpart, ⟨us, ?_⟩, hHdeg, ?_⟩
    · exact (hHdeg us).resolve_left (by
        intro hzero
        have htwo : 2 ≤ H.degree us := by
          change 2 ≤ (((F + Pseudograph.singleEdge x₁ y₁) +
            Pseudograph.singleEdge x₂ y₂).degree us)
          rw [Pseudograph.degree_add, Pseudograph.degree_add]
          change 2 ≤ F.degree us + _ + _
          simp [F, Pseudograph.degree_add,
            Pseudograph.degree_edgeCopies_of_ne, huvs]
          omega
        omega)
    · simpa [E, U, hcut] using hdec

/-- The no-outer-edge alternative of the normalized three-outside-endpoint
configuration is impossible.  If the opposite four-cut has at most one
heavy endpoint, use the star closure.  If it has two, pair the two ends at
each local outer vertex; the opposite closure then adds two copies of the
same nonloop edge and the preceding three local witnesses splice it back.
-/
lemma IsVertexMinimalCounterexample.no_outer_edge_impossible
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) (hab : G.mult C.a C.b = 0) : False := by
  classical
  let U : Finset (Fin n) := {C.u, C.v, C.a, C.z, C.b}
  obtain ⟨hcut, houtA, _houtB, _houtU, _houtV, _houtZ⟩ :=
    hmin.no_outer_fourCut C hab
  let E : Fin 4 ≃ Pseudograph.CrossingEdge G U :=
    (G.cutEquiv U hcut).symm
  let EC : Fin 4 ≃ Pseudograph.CrossingEdge G Uᶜ :=
    G.reversedFourCutListing U hcut
  let count : ↑(Uᶜ) → ℕ := fun v ↦ G.listingEndpointCount Uᶜ EC v
  let heavy : Finset ↑(Uᶜ) := Finset.univ.filter fun v ↦ 2 ≤ count v
  have hsum : (∑ v : ↑(Uᶜ), count v) = 4 := by
    simpa [count] using G.sum_listingEndpointCount Uᶜ EC
  have hheavy : 2 * heavy.card ≤ 4 := by
    have hlower : 2 * heavy.card ≤ ∑ v ∈ heavy, count v := by
      calc
        2 * heavy.card = ∑ _v ∈ heavy, 2 := by simp [Nat.mul_comm]
        _ ≤ ∑ v ∈ heavy, count v := by
          exact Finset.sum_le_sum fun v hv ↦ by
            simpa [heavy] using (Finset.mem_filter.mp hv).2
    have hupper : (∑ v ∈ heavy, count v) ≤ ∑ v : ↑(Uᶜ), count v :=
      Finset.sum_le_sum_of_subset (by simp [heavy])
    omega
  have hUcard : U.card = 5 := by
    simp [U, C.uv_ne, C.ua_ne, C.uz_ne, C.ub_ne, C.va_ne,
      C.vz_ne, C.vb_ne, C.az_ne, C.ab_ne, C.zb_ne]
  have hcardsum : U.card + Uᶜ.card = n := by
    simpa using Finset.card_add_card_compl U
  have hUC : Uᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hC
    have hUuniv : U = Finset.univ := (Finset.compl_eq_empty_iff U).mp hC
    have hzero : G.boundaryMultiplicity U = 0 := by
      rw [G.boundaryMultiplicity_eq_sum_outsideDegree, hUuniv]
      simp [Pseudograph.outsideDegree]
    have hfour : G.boundaryMultiplicity U = 4 := by simpa [U] using hcut
    omega
  letI : Nonempty ↑(Uᶜ) := Finset.nonempty_coe_sort.mpr hUC
  by_cases hsmall : heavy.card ≤ 1
  · have hdefect : (G.induce Uᶜ).loopCount +
        (G.induce Uᶜ).parallelPairCount ≤ 1 :=
      G.induce_defect_le_one_of_parallel_pair_outside hmin.in_class Uᶜ
        (by simp [U]) (by simp [U]) C.uv_ne (by rw [C.uv_two])
    have hclassC : (G.closeFourCutStarWith Uᶜ EC).InTashkinovClass :=
      G.closeFourCutStarWith_inTashkinovClass_of_defect_and_one_heavy
        hmin.in_class.1 Uᶜ EC hdefect (by simpa [heavy, count] using hsmall)
    have hcardC : Fintype.card (Option ↑(Uᶜ)) < n := by
      rw [Fintype.card_option, Fintype.card_coe]
      omega
    have hpartC :
        (G.closeFourCutStarWith Uᶜ EC).ContainsRegularPart 3 :=
      hmin.contains_of_card_lt _ hclassC hcardC
    have hlocal := hmin.no_outer_star_localWitnesses C hab
    exact hmin.no_cubic_part
      (G.containsRegularPart_of_fourCutStarClosures U hcut hlocal (by
        simpa [EC, Pseudograph.reversedFourCutListing] using hpartC))
  · have hheavyCard : heavy.card = 2 := by omega
    obtain ⟨x, y, hxy, hheavyEq⟩ := Finset.card_eq_two.mp hheavyCard
    have hxmem : x ∈ heavy := by simp [hheavyEq]
    have hymem : y ∈ heavy := by simp [hheavyEq]
    have hxcount : 2 ≤ count x := by
      simpa [heavy] using (Finset.mem_filter.mp hxmem).2
    have hycount : 2 ≤ count y := by
      simpa [heavy] using (Finset.mem_filter.mp hymem).2
    let value : Fin 4 → ↑(Uᶜ) := fun i ↦ Pseudograph.pairEndpoint EC i
    have hcountValue (w : ↑(Uᶜ)) : count w =
        ∑ i : Fin 4, if value i = w then 1 else 0 := by
      unfold count Pseudograph.listingEndpointCount
      apply Finset.sum_congr rfl
      intro i _
      by_cases h : (EC i).inside = (w : Fin n)
      · rw [if_pos h, if_pos]
        apply Subtype.ext
        exact h
      · rw [if_neg h, if_neg]
        intro heq
        exact h (congrArg Subtype.val heq)
    have hvalues : ∀ i, value i = x ∨ value i = y := by
      apply Pseudograph.FourPairing.values_covered_of_two_counts value hxy
      · simpa [hcountValue] using hxcount
      · simpa [hcountValue] using hycount
    have hxcountEq : (∑ i : Fin 4, if value i = x then 1 else 0) = 2 := by
      have hxySum : count x + count y ≤ ∑ v : ↑(Uᶜ), count v := by
        calc
          count x + count y = ∑ v ∈ ({x, y} : Finset ↑(Uᶜ)), count v := by
            simp [hxy]
          _ ≤ ∑ v : ↑(Uᶜ), count v :=
            Finset.sum_le_sum_of_subset (Finset.subset_univ _)
      have : count x = 2 := by omega
      simpa [hcountValue] using this
    let localColor : Fin 4 → Bool := fun i ↦ decide ((E i).inside = C.a)
    have hlocalCount :
        (∑ i : Fin 4, if localColor i then 1 else 0) = 2 := by
      have hlisting := G.outsideDegree_eq_listingEndpointCount U E C.a (by simp [U])
      rw [houtA] at hlisting
      simpa [localColor, Pseudograph.listingEndpointCount] using hlisting.symm
    obtain ⟨p, q, hpq, hp₁, hp₂, hq₁, hq₂⟩ :=
      Pseudograph.FourPairing.exists_two_cross_pairings localColor hlocalCount
    have hlocalValues (i : Fin 4) :
        (E i).inside = C.a ∨ (E i).inside = C.b := by
      simpa [E] using hmin.no_outer_cutEndpoint C hab i
    have hp₁' : (E p.a).inside ≠ (E p.b).inside := by
      intro h
      exact hp₁ (by simp [localColor, h])
    have hp₂' : (E p.c).inside ≠ (E p.d).inside := by
      intro h
      exact hp₂ (by simp [localColor, h])
    have hq₁' : (E q.a).inside ≠ (E q.b).inside := by
      intro h
      exact hq₁ (by simp [localColor, h])
    have hq₂' : (E q.c).inside ≠ (E q.d).inside := by
      intro h
      exact hq₂ (by simp [localColor, h])
    obtain ⟨r, _hrp, _hrq, hr₁, hr₂⟩ :=
      Pseudograph.FourPairing.exists_remaining_monochromatic_pairing
        (fun i ↦ (E i).inside) C.ab_ne hlocalValues p q hpq
        hp₁' hp₂' hq₁' hq₂'
    have hrdiff : (E r.a).inside ≠ (E r.c).inside :=
      Pseudograph.FourPairing.monochromatic_blocks_have_distinct_colors_of_cross_pairing
        (fun i ↦ (E i).inside) p r hp₁' hr₁ hr₂
    have hblockNe₁ : value r.a ≠ value r.b := by
      intro heq
      have hblockEq₂ : value r.c = value r.d :=
        Pseudograph.FourPairing.other_block_eq_of_block_eq_of_count_two
          value hxy hvalues hxcountEq r heq
      have hparallel₁ : 2 ≤ G.mult (E r.a).inside (E r.a).outside := by
        exact Pseudograph.two_le_mult_of_distinct_crossingEdges_same_endpoints
          (fun h ↦ Pseudograph.fourPairing_ab_ne r (E.injective h))
          hr₁ (by
            have h := congrArg Subtype.val heq
            simpa [value, EC, E, Pseudograph.pairEndpoint,
              Pseudograph.reversedFourCutListing,
              Pseudograph.reverseFourCutListing,
              Pseudograph.reverseCrossingEdgeEquiv,
              Pseudograph.reverseCrossingEdge] using h)
      have hparallel₂ : 2 ≤ G.mult (E r.c).inside (E r.c).outside := by
        exact Pseudograph.two_le_mult_of_distinct_crossingEdges_same_endpoints
          (fun h ↦ Pseudograph.fourPairing_cd_ne r (E.injective h))
          hr₂ (by
            have h := congrArg Subtype.val hblockEq₂
            simpa [value, EC, E, Pseudograph.pairEndpoint,
              Pseudograph.reversedFourCutListing,
              Pseudograph.reverseFourCutListing,
              Pseudograph.reverseCrossingEdgeEquiv,
              Pseudograph.reverseCrossingEdge] using h)
      let S₀ : Finset (Fin n) := {C.u, C.v}
      have hins₁ : (E r.a).inside ∉ S₀ := by
        rcases hlocalValues r.a with h | h <;> simp [S₀, h, C.ua_ne,
          C.ub_ne, C.va_ne, C.vb_ne, C.ua_ne.symm, C.ub_ne.symm,
          C.va_ne.symm, C.vb_ne.symm]
      have hout₁ : (E r.a).outside ∉ S₀ := by
        intro h
        have hsub : S₀ ⊆ U := by simp [S₀, U]
        have hU : (E r.a).outside ∈ U := hsub h
        exact (E r.a).outside_notMem hU
      have hins₂ : (E r.c).inside ∉ S₀ := by
        rcases hlocalValues r.c with h | h <;> simp [S₀, h, C.ua_ne,
          C.ub_ne, C.va_ne, C.vb_ne, C.ua_ne.symm, C.ub_ne.symm,
          C.va_ne.symm, C.vb_ne.symm]
      have hpairAdd :=
        G.parallelPairCount_induce_add_two_le_of_two_parallel_pairs_outside
          S₀ hins₁ hout₁ hins₂
          (by intro h
              exact (E r.a).outside_notMem (h ▸ (E r.a).inside_mem))
          (by intro h
              exact (E r.c).outside_notMem (h ▸ (E r.c).inside_mem))
          hparallel₁ hparallel₂
          (by intro h; exact hrdiff (congrArg Prod.fst h))
          (by intro h
              have hfirst : (E r.a).inside = (E r.c).outside :=
                congrArg Prod.fst h
              exact (E r.c).outside_notMem (hfirst ▸ (E r.a).inside_mem))
      let us₀ : S₀ := ⟨C.u, by simp [S₀]⟩
      let vs₀ : S₀ := ⟨C.v, by simp [S₀]⟩
      have huvS : us₀ ≠ vs₀ := by
        intro h
        exact C.uv_ne (congrArg Subtype.val h)
      have hpairOne : 1 ≤ (G.induce S₀).parallelPairCount :=
        (G.induce S₀).one_le_parallelPairCount_of_two_le_mult huvS (by
          change 2 ≤ G.mult C.u C.v
          rw [C.uv_two])
      have hdef := hmin.in_class.2.2
      omega
    have hblockNe₂ : value r.c ≠ value r.d := by
      intro heq
      have hblockEq₁ : value r.a = value r.b :=
        Pseudograph.FourPairing.first_block_eq_of_second_block_eq_of_count_two
          value hxy hvalues hxcountEq r heq
      exact hblockNe₁ hblockEq₁
    have hdup :=
      Pseudograph.FourPairing.cross_blocks_same_unordered_pair
        value hvalues r hblockNe₁ hblockNe₂
    let a₁ := Pseudograph.pairEndpoint EC r.a
    let b₁ := Pseudograph.pairEndpoint EC r.b
    let c₁ := Pseudograph.pairEndpoint EC r.c
    let d₁ := Pseudograph.pairEndpoint EC r.d
    have ha₁b₁ : a₁ ≠ b₁ := by simpa [a₁, b₁, value] using hblockNe₁
    have hdefect : (G.induce Uᶜ).loopCount +
        (G.induce Uᶜ).parallelPairCount ≤ 1 :=
      G.induce_defect_le_one_of_parallel_pair_outside hmin.in_class Uᶜ
        (by simp [U]) (by simp [U]) C.uv_ne (by rw [C.uv_two])
    have hregPair :
        ((G.induce Uᶜ + Pseudograph.singleEdge a₁ b₁) +
          Pseudograph.singleEdge c₁ d₁).IsRegularOfDegree 4 := by
      simpa [a₁, b₁, c₁, d₁, EC,
        Pseudograph.closeFourCutPairWith, Pseudograph.pairEndpoint] using
        G.closeFourCutPairWith_isRegularOfDegree Uᶜ EC r hmin.in_class.1
    have hclassPair : (G.oppositePairClosure U hcut r).InTashkinovClass := by
      change ((G.induce Uᶜ + Pseudograph.singleEdge a₁ b₁) +
        Pseudograph.singleEdge c₁ d₁).InTashkinovClass
      have hdup' : (a₁, b₁) = (c₁, d₁) ∨
          (a₁, b₁) = (d₁, c₁) := by
        simpa [a₁, b₁, c₁, d₁, value] using hdup
      rcases hdup' with hsame | hreverse
      · have hac : a₁ = c₁ := congrArg Prod.fst hsame
        have hbd : b₁ = d₁ := congrArg Prod.snd hsame
        rw [← hac, ← hbd] at hregPair ⊢
        exact Pseudograph.add_two_same_nonloop_edges_inTashkinovClass
          (G.induce Uᶜ) hdefect ha₁b₁ hregPair
      · have had : a₁ = d₁ := congrArg Prod.fst hreverse
        have hbc : b₁ = c₁ := congrArg Prod.snd hreverse
        rw [← had, ← hbc] at hregPair ⊢
        simpa only [Pseudograph.singleEdge_comm b₁ a₁] using
          Pseudograph.add_two_same_nonloop_edges_inTashkinovClass
            (G.induce Uᶜ) hdefect ha₁b₁ (by
              simpa only [Pseudograph.singleEdge_comm b₁ a₁] using hregPair)
    have hcardC : Fintype.card ↑(Uᶜ) < n := by
      rw [Fintype.card_coe]
      omega
    have hpartC : (G.oppositePairClosure U hcut r).ContainsRegularPart 3 :=
      hmin.contains_of_card_lt _ hclassPair hcardC
    have hlocal := hmin.no_outer_pair_localWitnesses C hab r hr₁ hr₂ hrdiff
    exact hmin.no_cubic_part
      (G.containsRegularPart_of_fourCutPairClosures U hcut r hlocal hpartC)

/-- Both possible multiplicities of the edge between the two outer
vertices have now been eliminated, so the normalized three-outside
double-edge core cannot occur in a minimal counterexample. -/
lemma IsVertexMinimalCounterexample.threeOutsideDoubleCore_impossible
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (C : ThreeOutsideDoubleCore G) : False := by
  have hle := hmin.threeOutside_outer_mult_le_one C
  by_cases hz : G.mult C.a C.b = 0
  · exact hmin.no_outer_edge_impossible C hz
  · have hone : G.mult C.a C.b = 1 := by omega
    exact hmin.single_outer_edge_impossible C hone

end ThreeOutsideDoubleCore

/-- Tashkinov's Proposition 2.6: a vertex-minimal bad member of class `B`
has no parallel nonloop edges.  The four cut ends of a double edge have
either four, two, or three outside endpoints.  The first case gives the
explicit `K₂,₂` cubic part, the second contradicts the two bad
cross-closures, and the third is the normalized core eliminated above. -/
theorem IsVertexMinimalCounterexample.no_parallel_edges
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G) :
    ∀ u v : Fin n, u ≠ v → G.mult u v ≤ 1 := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  intro u v huv
  by_contra hnot
  have huvTwo : 2 ≤ G.mult u v := by omega
  by_cases hthree : 3 ≤ G.mult u v
  · exact hmin.no_cubic_part
      (G.containsRegularPart_of_three_le_mult huv hthree)
  have huvEq : G.mult u v = 2 := by omega
  obtain ⟨huu, hvv⟩ := hmin.double_edge_endpoints_loopless huv huvTwo
  obtain ⟨S, hS, hcut, p, q, hpq, hp₁, hp₂, hq₁, hq₂,
      hbadp, hbadq⟩ :=
    hmin.exists_two_bad_pairClosures_of_double_edge huv huu hvv huvEq
  have hS' : S = ({u, v} : Finset (Fin n)) := by
    ext x
    rw [hS]
    simp
  let E : Fin 4 ≃ Pseudograph.CrossingEdge G S :=
    (G.cutEquiv S hcut).symm
  have hlocalValues (i : Fin 4) : (E i).inside = u ∨ (E i).inside = v := by
    have hi := (E i).inside_mem
    simpa [hS] using hi
  obtain ⟨r, hrp, hrq, hr₁, hr₂⟩ :=
    Pseudograph.FourPairing.exists_remaining_monochromatic_pairing
      (fun i ↦ (E i).inside) huv hlocalValues p q hpq
      (by simpa [E] using hp₁) (by simpa [E] using hp₂)
      (by simpa [E] using hq₁) (by simpa [E] using hq₂)
  have hrdiff : (E r.a).inside ≠ (E r.c).inside :=
    Pseudograph.FourPairing.monochromatic_blocks_have_distinct_colors_of_cross_pairing
      (fun i ↦ (E i).inside) p r (by simpa [E] using hp₁) hr₁ hr₂
  have hrAB : (E r.a).outside ≠ (E r.b).outside :=
    G.outside_ne_of_same_inside_of_bad_oppositePairClosure
      hmin.in_class huv (by omega) S hS' hcut p hp₁ hp₂ hbadp
      (Pseudograph.fourPairing_ab_ne r) hr₁
  have hrCD : (E r.c).outside ≠ (E r.d).outside :=
    G.outside_ne_of_same_inside_of_bad_oppositePairClosure
      hmin.in_class huv (by omega) S hS' hcut p hp₁ hp₂ hbadp
      (Pseudograph.fourPairing_cd_ne r) hr₂
  let us : S := ⟨u, by rw [hS]; simp⟩
  let vs : S := ⟨v, by rw [hS]; simp⟩
  have huvs : us ≠ vs := by
    intro h
    exact huv (congrArg Subtype.val h)
  have hScard : Fintype.card S = 2 := by
    rw [Fintype.card_coe, hS]
    simp [huv]
  have hdu : (G.induce S).degree us = 2 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum,
      Pseudograph.fintype_sum_eq_add_of_card_two huvs hScard]
    simp [us, vs, huu, huvEq]
  have hdv : (G.induce S).degree vs = 2 := by
    rw [Pseudograph.degree_eq_mult_self_add_sum,
      Pseudograph.fintype_sum_eq_add_of_card_two huvs hScard]
    simp [us, vs, hvv, huvEq, G.mult_comm]
  have houtU : G.outsideDegree S u = 2 := by
    have h := G.degree_induce_add_outsideDegree S u (by rw [hS]; simp)
    change (G.induce S).degree us + G.outsideDegree S u = G.degree u at h
    rw [hdu, hmin.in_class.1 u] at h
    omega
  have houtV : G.outsideDegree S v = 2 := by
    have h := G.degree_induce_add_outsideDegree S v (by rw [hS]; simp)
    change (G.induce S).degree vs + G.outsideDegree S v = G.degree v at h
    rw [hdv, hmin.in_class.1 v] at h
    omega
  by_cases hall : ∀ i j : Fin 4, i ≠ j → (E i).outside ≠ (E j).outside
  · have hforced := G.bad_crossPairings_force_completeOutside
      hmin.in_class huv (by omega) S hS' hcut p q r hpq hrp hrq
      hbadp hbadq (by simpa [E] using hall)
    let eσ : Fin 4 ≃ Fin 4 := Pseudograph.FourPairing.labelEquiv r
    let E' : Fin 4 ≃ Pseudograph.CrossingEdge G S := eσ.trans E
    have hdist (i j : Fin 4) (hij : i ≠ j) :
        (E' i).outside ≠ (E' j).outside := by
      apply hall
      intro h
      apply hij
      exact eσ.injective h
    have hforced' :
        0 < G.mult (E' 0).outside (E' 2).outside ∧
          0 < G.mult (E' 0).outside (E' 3).outside ∧
          0 < G.mult (E' 1).outside (E' 2).outside ∧
          0 < G.mult (E' 1).outside (E' 3).outside := by
      simpa [E', eσ] using hforced
    have hpart := G.containsRegularPart_of_doubleEdge_fourOutside_complete
      huv (by omega) S hS' houtU houtV E'
      (hdist 0 1 (by decide)) (hdist 0 2 (by decide))
      (hdist 0 3 (by decide)) (hdist 1 2 (by decide))
      (hdist 1 3 (by decide)) (hdist 2 3 (by decide))
      hforced'.1 hforced'.2.1 hforced'.2.2.1 hforced'.2.2.2
    exact hmin.no_cubic_part hpart
  · let A := (E r.a).outside
    let B := (E r.b).outside
    let C₀ := (E r.c).outside
    let D := (E r.d).outside
    have hAB : A ≠ B := by simpa [A, B] using hrAB
    have hCD : C₀ ≠ D := by simpa [C₀, D] using hrCD
    have hcrossEq : A = C₀ ∨ A = D ∨ B = C₀ ∨ B = D := by
      push_neg at hall
      obtain ⟨i, j, hij, heq⟩ := hall
      rcases Pseudograph.FourPairing.label_eq_one_of r i with
        rfl | rfl | rfl | rfl <;>
        rcases Pseudograph.FourPairing.label_eq_one_of r j with
          rfl | rfl | rfl | rfl <;>
        simp_all [A, B, C₀, D]
    by_cases htwoOutside : (A = C₀ ∧ B = D) ∨ (A = D ∧ B = C₀)
    · exact G.bad_crossPairings_forbid_twoOutside hmin.in_class huv
        (by omega) S hS' hcut p q r hpq hrp hrq hbadp hbadq
        (by simpa [E, A, B] using hAB) (by simpa [E, C₀, D] using hCD)
        (by simpa [E, A, B, C₀, D] using htwoOutside)
    have hcore (iA iB iC iD : Fin 4)
        (hinAB : (E iA).inside = (E iB).inside)
        (hinCD : (E iC).inside = (E iD).inside)
        (hinDiff : (E iA).inside ≠ (E iC).inside)
        (houtAB : (E iA).outside ≠ (E iB).outside)
        (houtCD : (E iC).outside ≠ (E iD).outside)
        (houtBD : (E iB).outside ≠ (E iD).outside)
        (houtEq : (E iA).outside = (E iC).outside)
        (hlink₁ : 0 < G.mult (E iA).outside (E iD).outside)
        (hlink₂ : 0 < G.mult (E iB).outside (E iC).outside) : False := by
      let u₀ := (E iA).inside
      let v₀ := (E iC).inside
      let a₀ := (E iB).outside
      let z₀ := (E iA).outside
      let b₀ := (E iD).outside
      have hinsideOutside (i j : Fin 4) : (E i).inside ≠ (E j).outside := by
        intro h
        exact (E j).outside_notMem (h ▸ (E i).inside_mem)
      have huv₀ : u₀ ≠ v₀ := hinDiff
      have hua₀ : u₀ ≠ a₀ := hinsideOutside iA iB
      have huz₀ : u₀ ≠ z₀ := hinsideOutside iA iA
      have hub₀ : u₀ ≠ b₀ := hinsideOutside iA iD
      have hva₀ : v₀ ≠ a₀ := hinsideOutside iC iB
      have hvz₀ : v₀ ≠ z₀ := hinsideOutside iC iA
      have hvb₀ : v₀ ≠ b₀ := hinsideOutside iC iD
      have haz₀ : a₀ ≠ z₀ := by simpa [a₀, z₀] using houtAB.symm
      have hab₀ : a₀ ≠ b₀ := by simpa [a₀, b₀] using houtBD
      have hzb₀ : z₀ ≠ b₀ := by
        intro h
        exact houtCD (houtEq.symm.trans h)
      have hdouble : G.mult u₀ v₀ = 2 := by
        rcases hlocalValues iA with hu | hv <;>
          rcases hlocalValues iC with hu' | hv'
        · exact (hinDiff (hu.trans hu'.symm)).elim
        · simpa [u₀, v₀, hu, hv', huvEq]
        · simpa [u₀, v₀, hv, hu', huvEq, G.mult_comm]
        · exact (hinDiff (hv.trans hv'.symm)).elim
      have hloopU : G.mult u₀ u₀ = 0 := by
        rcases hlocalValues iA with hu | hv
        · simpa [u₀, hu] using huu
        · simpa [u₀, hv] using hvv
      have hloopV : G.mult v₀ v₀ = 0 := by
        rcases hlocalValues iC with hu | hv
        · simpa [v₀, hu] using huu
        · simpa [v₀, hv] using hvv
      let K : ThreeOutsideDoubleCore G :=
        { u := u₀
          v := v₀
          a := a₀
          z := z₀
          b := b₀
          uv_ne := huv₀
          ua_ne := hua₀
          uz_ne := huz₀
          ub_ne := hub₀
          va_ne := hva₀
          vz_ne := hvz₀
          vb_ne := hvb₀
          az_ne := haz₀
          ab_ne := hab₀
          zb_ne := hzb₀
          uv_two := hdouble
          loop_u := hloopU
          loop_v := hloopV
          ua_pos := by
            simpa [u₀, a₀, hinAB] using Nat.zero_lt_of_lt (E iB).index.isLt
          uz_pos := by
            exact Nat.zero_lt_of_lt (E iA).index.isLt
          vz_pos := by
            simpa [v₀, z₀, houtEq] using Nat.zero_lt_of_lt (E iC).index.isLt
          vb_pos := by
            change 0 < G.mult (E iC).inside (E iD).outside
            rw [hinCD]
            exact Nat.zero_lt_of_lt (E iD).index.isLt
          az_pos := by
            simpa [a₀, z₀, houtEq, G.mult_comm] using hlink₂
          zb_pos := by
            simpa [z₀, b₀] using hlink₁ }
      exact hmin.threeOutsideDoubleCore_impossible K
    rcases hcrossEq with hAC | hAD | hBC | hBD
    · have hAD' : A ≠ D := by
        intro h
        exact hCD (hAC.symm.trans h)
      have hBC' : B ≠ C₀ := by
        intro h
        exact hAB (hAC.trans h.symm)
      have hBD' : B ≠ D := by
        intro h
        exact htwoOutside (.inl ⟨hAC, h⟩)
      have hlinks := G.bad_crossPairings_force_threeOutside_links
        hmin.in_class huv (by omega) S hS' hcut p q r hpq hrp hrq
        hbadp hbadq (by simpa [E, A, B] using hAB)
        (by simpa [E, C₀, D] using hCD)
        (by simpa [E, A, D] using hAD')
        (by simpa [E, B, C₀] using hBC')
      exact hcore r.a r.b r.c r.d hr₁ hr₂ hrdiff hrAB hrCD
        (by simpa [E, B, D] using hBD')
        (by simpa [E, A, C₀] using hAC) hlinks.1 hlinks.2
    · have hAC' : A ≠ C₀ := by
        intro h
        exact hCD (h.symm.trans hAD)
      have hBD' : B ≠ D := by
        intro h
        exact hAB (hAD.trans h.symm)
      have hBC' : B ≠ C₀ := by
        intro h
        exact htwoOutside (.inr ⟨hAD, h⟩)
      have hlinks := G.bad_crossPairings_force_threeOutside_otherLinks
        hmin.in_class huv (by omega) S hS' hcut p q r hpq hrp hrq
        hbadp hbadq (by simpa [E, A, C₀] using hAC')
        (by simpa [E, B, D] using hBD')
      have hdiff' : (E r.a).inside ≠ (E r.d).inside := by
        intro h
        exact hrdiff (h.trans hr₂.symm)
      exact hcore r.a r.b r.d r.c hr₁ hr₂.symm hdiff' hrAB hrCD.symm
        (by simpa [E, B, C₀] using hBC')
        (by simpa [E, A, D] using hAD) hlinks.1 hlinks.2
    · have hAC' : A ≠ C₀ := by
        intro h
        exact hAB (h.trans hBC.symm)
      have hBD' : B ≠ D := by
        intro h
        exact hCD (hBC.symm.trans h)
      have hAD' : A ≠ D := by
        intro h
        exact htwoOutside (.inr ⟨h, hBC⟩)
      have hlinks := G.bad_crossPairings_force_threeOutside_otherLinks
        hmin.in_class huv (by omega) S hS' hcut p q r hpq hrp hrq
        hbadp hbadq (by simpa [E, A, C₀] using hAC')
        (by simpa [E, B, D] using hBD')
      have hdiff' : (E r.b).inside ≠ (E r.c).inside := by
        intro h
        exact hrdiff (hr₁.trans h)
      exact hcore r.b r.a r.c r.d hr₁.symm hr₂ hdiff' hrAB.symm hrCD
        (by simpa [E, A, D] using hAD')
        (by simpa [E, B, C₀] using hBC) hlinks.2 hlinks.1
    · have hAD' : A ≠ D := by
        intro h
        exact hAB (h.trans hBD.symm)
      have hBC' : B ≠ C₀ := by
        intro h
        exact hCD (h.symm.trans hBD)
      have hAC' : A ≠ C₀ := by
        intro h
        exact htwoOutside (.inl ⟨h, hBD⟩)
      have hlinks := G.bad_crossPairings_force_threeOutside_links
        hmin.in_class huv (by omega) S hS' hcut p q r hpq hrp hrq
        hbadp hbadq (by simpa [E, A, B] using hAB)
        (by simpa [E, C₀, D] using hCD)
        (by simpa [E, A, D] using hAD')
        (by simpa [E, B, C₀] using hBC')
      have hdiff' : (E r.b).inside ≠ (E r.d).inside := by
        intro h
        exact hrdiff (hr₁.trans (h.trans hr₂.symm))
      exact hcore r.b r.a r.d r.c hr₁.symm hr₂.symm hdiff'
        hrAB.symm hrCD.symm (by simpa [E, A, C₀] using hAC')
        (by simpa [E, B, D] using hBD) hlinks.2 hlinks.1

/-- Proposition 2.7 in the form used below: after parallel edges have been
excluded, a two-edge cut of the minimal counterexample cannot have at least
two vertices on both shores.  If closing one shore would create a second
loop, its common boundary vertex is moved to the other shore; the new two
cut has distinct endpoints because there are no parallel edges. -/
theorem IsVertexMinimalCounterexample.no_nontrivial_two_cut_of_no_parallel_edges
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hparallel : ∀ u v, u ≠ v → G.mult u v ≤ 1) :
    ∀ S : Finset (Fin n), 2 ≤ S.card → 2 ≤ Sᶜ.card →
      G.boundaryMultiplicity S ≠ 2 := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  have hreg := hmin.in_class.1
  have hconn := hmin.underlying_connected
  have hparallelZero : G.parallelPairCount = 0 :=
    G.parallelPairCount_eq_zero_of_mult_le_one hparallel
  have hfinish (T : Finset (Fin n))
      (hcutT : G.boundaryMultiplicity T = 2)
      (hT : T.Nonempty) (hTC : Tᶜ.Nonempty)
      (hclassT : (G.closeTwoCut T hcutT).InTashkinovClass)
      (hclassTC : (G.closeTwoCut Tᶜ
        ((G.boundaryMultiplicity_compl T).trans hcutT)).InTashkinovClass) :
      False := by
    letI : Nonempty T := Finset.nonempty_coe_sort.mpr hT
    letI : Nonempty ↑(Tᶜ) := Finset.nonempty_coe_sort.mpr hTC
    have hTproper : T ≠ Finset.univ := by
      intro h
      have : Tᶜ = ∅ := (Finset.compl_eq_empty_iff T).mpr h
      exact hTC.ne_empty this
    have hTCproper : Tᶜ ≠ Finset.univ := by
      intro h
      have : T = ∅ := (Finset.compl_eq_univ_iff T).mp h
      exact hT.ne_empty this
    have hcardT : Fintype.card T < n := by
      rw [Fintype.card_coe]
      have hlt := Finset.card_lt_card
        (Finset.ssubset_iff_subset_ne.mpr
          ⟨Finset.subset_univ T, hTproper⟩)
      simpa using hlt
    have hcardTC : Fintype.card ↑(Tᶜ) < n := by
      rw [Fintype.card_coe]
      have hlt := Finset.card_lt_card
        (Finset.ssubset_iff_subset_ne.mpr
          ⟨Finset.subset_univ Tᶜ, hTCproper⟩)
      simpa using hlt
    have hpartT := hmin.contains_of_card_lt
      (G.closeTwoCut T hcutT) hclassT hcardT
    have hpartTC := hmin.contains_of_card_lt
      (G.closeTwoCut Tᶜ ((G.boundaryMultiplicity_compl T).trans hcutT))
      hclassTC hcardTC
    exact hmin.no_cubic_part
      (G.containsRegularPart_of_twoCutClosures T hcutT hpartT hpartTC)
  have hcore (A : Finset (Fin n))
      (hcutA : G.boundaryMultiplicity A = 2)
      (hAtwo : 2 ≤ A.card) (hACtwo : 2 ≤ Aᶜ.card)
      (hACloopless : (G.induce Aᶜ).loopCount = 0) : False := by
    have hA : A.Nonempty := Finset.card_pos.mp (by omega)
    have hAC : Aᶜ.Nonempty := Finset.card_pos.mp (by omega)
    let hcutAC : G.boundaryMultiplicity Aᶜ = 2 :=
      (G.boundaryMultiplicity_compl A).trans hcutA
    have hbaseAC : (G.induce Aᶜ).HasSimpleMultiplicities := by
      constructor
      · intro x
        exact (G.induce Aᶜ).mult_self_eq_zero_of_loopCount_eq_zero
          hACloopless x
      · intro x y
        by_cases hxy : x = y
        · subst y
          have hz := (G.induce Aᶜ).mult_self_eq_zero_of_loopCount_eq_zero
            hACloopless x
          omega
        · exact hparallel x y (fun h ↦ hxy (Subtype.ext h))
    have hclassAC : (G.closeTwoCut Aᶜ hcutAC).InTashkinovClass :=
      G.closeTwoCut_inTashkinovClass_of_induce_hasSimpleMultiplicities
        hreg Aᶜ hcutAC hbaseAC
    let e₀ := (Pseudograph.twoCutEdge G A hcutA 0).inside
    let e₁ := (Pseudograph.twoCutEdge G A hcutA 1).inside
    by_cases hends : e₀ ≠ e₁
    · have hdefectA : (G.induce A).loopCount +
          (G.induce A).parallelPairCount ≤ 1 := by
        have hl := G.loopCount_induce_le A
        have hp := G.parallelPairCount_induce_le A
        have hc := hmin.in_class.2.1
        rw [hparallelZero] at hp
        omega
      have hclassA : (G.closeTwoCut A hcutA).InTashkinovClass :=
        G.closeTwoCut_inTashkinovClass_of_defect_le_one_of_endpoints_ne
          hreg A hcutA hdefectA (by simpa [e₀, e₁] using hends)
      exact hfinish A hcutA hA hAC hclassA (by simpa [hcutAC] using hclassAC)
    · push_neg at hends
      let v : Fin n := e₀
      have hvA : v ∈ A := by
        exact (Pseudograph.twoCutEdge G A hcutA 0).inside_mem
      have he₀ : e₀ = v := rfl
      have he₁ : e₁ = v := hends.symm.trans he₀
      have houtV : G.outsideDegree A v = 2 := by
        have h := G.outsideDegree_eq_twoCutEndpointCount A hcutA v hvA
        simpa [e₀, e₁, he₀, he₁] using h
      let T : Finset (Fin n) := A.erase v
      have hTnonempty : T.Nonempty := by
        rw [Finset.nonempty_iff_ne_empty]
        intro hTempty
        have hAcard : A.card = 1 := by
          have herase := Finset.card_erase_add_one hvA
          change T.card + 1 = A.card at herase
          rw [hTempty] at herase
          simpa using herase.symm
        omega
      have hsumOutside :
          ∑ x ∈ A, G.outsideDegree A x = 2 := by
        simpa [G.boundaryMultiplicity_eq_sum_outsideDegree] using hcutA
      have hrestOutside :
          ∑ x ∈ T, G.outsideDegree A x = 0 := by
        have hsplit := Finset.sum_erase_add A
          (fun x ↦ G.outsideDegree A x) hvA
        change (∑ x ∈ T, G.outsideDegree A x) +
            G.outsideDegree A v = ∑ x ∈ A, G.outsideDegree A x at hsplit
        rw [houtV, hsumOutside] at hsplit
        omega
      have houtOther (x : Fin n) (hxT : x ∈ T) :
          G.outsideDegree A x = 0 := by
        have hle : G.outsideDegree A x ≤
            ∑ y ∈ T, G.outsideDegree A y :=
          Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) hxT
        rw [hrestOutside] at hle
        omega
      have hindDegree : (G.induce A).degree ⟨v, hvA⟩ = 2 := by
        have h := G.degree_induce_add_outsideDegree A v hvA
        rw [houtV, hreg v] at h
        omega
      have hsumT :
          G.mult v v + (∑ x ∈ T, G.mult v x) + G.mult v v = 2 := by
        rw [Pseudograph.degree_eq_mult_self_add_sum] at hindDegree
        change G.mult v v + ∑ x : A, G.mult v x = 2 at hindDegree
        have hsumSubtype : (∑ x : A, G.mult v x) =
            ∑ x ∈ A, G.mult v x := by
          symm
          exact Finset.sum_subtype A (fun _ ↦ Iff.rfl) (fun x ↦ G.mult v x)
        rw [hsumSubtype] at hindDegree
        have hsplit := Finset.sum_erase_add A (fun x ↦ G.mult v x) hvA
        change (∑ x ∈ T, G.mult v x) + G.mult v v =
            ∑ x ∈ A, G.mult v x at hsplit
        omega
      by_cases hvLoop : G.mult v v = 0
      · have hbetween : G.betweenMultiplicity {v} T = 2 := by
          rw [G.betweenMultiplicity_singleton v T (by simp [T])]
          omega
        have hsingle : G.boundaryMultiplicity {v} = 4 := by
          rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
          simp only [Finset.sum_singleton]
          unfold Pseudograph.outsideDegree Pseudograph.degree at *
          rw [Finset.compl_singleton]
          have hd := hreg v
          unfold Pseudograph.degree at hd
          rw [hvLoop, Nat.mul_zero, Nat.zero_add] at hd
          exact hd
        have hdis : Disjoint T ({v} : Finset (Fin n)) := by simp [T]
        have hunion : T ∪ {v} = A := by
          ext x
          by_cases hx : x = v <;> simp [T, hx, hvA]
        have htoggle := G.boundaryMultiplicity_union_add_two_between
          hreg T ({v} : Finset (Fin n)) hdis
        rw [hunion, hcutA, hsingle, G.betweenMultiplicity_comm,
          hbetween] at htoggle
        have hcutT : G.boundaryMultiplicity T = 2 := by omega
        have houtT (x : Fin n) (hxT : x ∈ T) :
            G.outsideDegree T x = G.mult x v := by
          have hvNotAC : v ∉ Aᶜ := by simp [hvA]
          unfold Pseudograph.outsideDegree
          rw [show Tᶜ = insert v Aᶜ by simp [T],
            Finset.sum_insert hvNotAC]
          have hxout := houtOther x hxT
          unfold Pseudograph.outsideDegree at hxout
          rw [hxout, Nat.add_zero]
        let f₀ := (Pseudograph.twoCutEdge G T hcutT 0).inside
        let f₁ := (Pseudograph.twoCutEdge G T hcutT 1).inside
        have hfends : f₀ ≠ f₁ := by
          intro hsame
          have hfT : f₀ ∈ T :=
            (Pseudograph.twoCutEdge G T hcutT 0).inside_mem
          have houtF := G.outsideDegree_eq_twoCutEndpointCount
            T hcutT f₀ hfT
          have houtF' : G.outsideDegree T f₀ = 2 := by
            simpa [f₀, f₁, hsame] using houtF
          rw [houtT f₀ hfT] at houtF'
          have hfv : f₀ ≠ v := by
            exact (Finset.mem_erase.mp hfT).1
          have hle := hparallel f₀ v hfv
          omega
        have hdefectT : (G.induce T).loopCount +
            (G.induce T).parallelPairCount ≤ 1 := by
          have hl := G.loopCount_induce_le T
          have hp := G.parallelPairCount_induce_le T
          have hc := hmin.in_class.2.1
          rw [hparallelZero] at hp
          omega
        have hclassT : (G.closeTwoCut T hcutT).InTashkinovClass :=
          G.closeTwoCut_inTashkinovClass_of_defect_le_one_of_endpoints_ne
            hreg T hcutT hdefectT (by simpa [f₀, f₁] using hfends)
        have hbaseTC : (G.induce Tᶜ).HasSimpleMultiplicities := by
          constructor
          · intro x
            have hx : (x : Fin n) = v ∨ (x : Fin n) ∈ Aᶜ := by
              simpa [T] using x.2
            rcases hx with hx | hx
            · simpa [hx] using hvLoop
            · let y : ↑(Aᶜ) := ⟨x, hx⟩
              exact (G.induce Aᶜ).mult_self_eq_zero_of_loopCount_eq_zero
                hACloopless y
          · intro x y
            by_cases hxy : x = y
            · subst y
              have := (show (G.induce Tᶜ).mult x x = 0 from
                (by
                  have hx : (x : Fin n) = v ∨ (x : Fin n) ∈ Aᶜ := by
                    simpa [T] using x.2
                  rcases hx with hx | hx
                  · simpa [hx] using hvLoop
                  · exact (G.induce Aᶜ).mult_self_eq_zero_of_loopCount_eq_zero
                      hACloopless ⟨x, hx⟩))
              omega
            · exact hparallel x y (fun h ↦ hxy (Subtype.ext h))
        let hcutTC : G.boundaryMultiplicity Tᶜ = 2 :=
          (G.boundaryMultiplicity_compl T).trans hcutT
        have hclassTC : (G.closeTwoCut Tᶜ hcutTC).InTashkinovClass :=
          G.closeTwoCut_inTashkinovClass_of_induce_hasSimpleMultiplicities
            hreg Tᶜ hcutTC hbaseTC
        have hTC : Tᶜ.Nonempty := ⟨v, by simp [T]⟩
        exact hfinish T hcutT hTnonempty hTC hclassT
          (by simpa [hcutTC] using hclassTC)
      · have hvLoopPos : 0 < G.mult v v := Nat.pos_of_ne_zero hvLoop
        have hloopEq : G.mult v v = 1 := by
          have hle := G.mult_self_le_loopCount v
          have hc := hmin.in_class.2.1
          omega
        have hbetween : G.betweenMultiplicity {v} T = 0 := by
          rw [G.betweenMultiplicity_singleton v T (by simp [T])]
          omega
        have hsingle : G.boundaryMultiplicity {v} = 2 := by
          rw [G.boundaryMultiplicity_eq_sum_outsideDegree]
          simp only [Finset.sum_singleton]
          unfold Pseudograph.outsideDegree
          rw [Finset.compl_singleton]
          have hd := hreg v
          unfold Pseudograph.degree at hd
          rw [hloopEq] at hd
          omega
        have hdis : Disjoint T ({v} : Finset (Fin n)) := by simp [T]
        have hunion : T ∪ {v} = A := by
          ext x
          by_cases hx : x = v <;> simp [T, hx, hvA]
        have htoggle := G.boundaryMultiplicity_union_add_two_between
          hreg T ({v} : Finset (Fin n)) hdis
        rw [hunion, hcutA, hsingle, G.betweenMultiplicity_comm,
          hbetween] at htoggle
        have hzero : G.boundaryMultiplicity T = 0 := by omega
        have hproperT : T ≠ Finset.univ := by
          intro h
          have hvT : v ∈ T := by rw [h]; simp
          simpa [T] using hvT
        obtain ⟨x, hxT⟩ := hTnonempty
        have hexists : ∃ y : Fin n, y ∉ T := by
          by_contra h
          push_neg at h
          apply hproperT
          ext y
          simp [h y]
        obtain ⟨y, hyT⟩ := hexists
        obtain ⟨p⟩ := hconn x y
        obtain ⟨⟨d, hadj⟩, _hd, hdx, hdy⟩ :=
          p.exists_boundary_dart (T : Set (Fin n))
            (by simpa using hxT) (by simpa using hyT)
        have hdx' : d.fst ∈ T := by simpa using hdx
        have hdy' : d.snd ∉ T := by simpa using hdy
        have hterm : G.edgeMultiplicity s(d.fst, d.snd) *
            Pseudograph.crossingIndicator T s(d.fst, d.snd) =
              G.mult d.fst d.snd := by
          simp [Pseudograph.edgeMultiplicity_mk,
            Pseudograph.crossingIndicator_mk, hdx', hdy']
        have hpos : 0 < G.boundaryMultiplicity T := by
          calc
            0 < G.edgeMultiplicity s(d.fst, d.snd) *
                Pseudograph.crossingIndicator T s(d.fst, d.snd) := by
              rw [hterm]
              exact hadj.2
            _ ≤ G.boundaryMultiplicity T := by
              unfold Pseudograph.boundaryMultiplicity
              exact Finset.single_le_sum (s := Finset.univ)
                (f := fun e : Sym2 (Fin n) ↦
                  G.edgeMultiplicity e * Pseudograph.crossingIndicator T e)
                (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s(d.fst, d.snd))
        omega
  intro S hStwo hSCtwo hcut
  have hSCtwo' : 2 ≤ Sᶜ.card := by
    have hnsub : 2 ≤ Fintype.card (Fin n) - S.card := by
      simpa only [Finset.card_compl] using hSCtwo
    simpa only [Finset.card_compl] using hnsub
  by_cases hSCloopless : (G.induce Sᶜ).loopCount = 0
  · exact hcore S hcut hStwo hSCtwo' hSCloopless
  · have hSCpos : 0 < (G.induce Sᶜ).loopCount :=
      Nat.pos_of_ne_zero hSCloopless
    obtain ⟨x, _hx, hxloop⟩ := Finset.sum_pos_iff.mp hSCpos
    have hSloopless : (G.induce S).loopCount = 0 := by
      unfold Pseudograph.loopCount
      apply Finset.sum_eq_zero
      intro y _hy
      have hxy : (x : Fin n) ≠ (y : Fin n) := by
        intro h
        have hxC : (x : Fin n) ∈ Sᶜ := x.2
        have hyS : (y : Fin n) ∈ S := y.2
        exact (Finset.mem_compl.mp hxC) (h ▸ hyS)
      have hsum := G.mult_self_add_mult_self_le_loopCount hxy
      have hc := hmin.in_class.2.1
      change 0 < G.mult (x : Fin n) (x : Fin n) at hxloop
      change G.mult (y : Fin n) (y : Fin n) = 0
      omega
    have hcutC : G.boundaryMultiplicity Sᶜ = 2 :=
      (G.boundaryMultiplicity_compl S).trans hcut
    have hdoubleCard : 2 ≤ (Sᶜ)ᶜ.card := by simpa using hStwo
    have hdoubleLoopless : (G.induce (Sᶜ)ᶜ).loopCount = 0 := by
      rw [compl_compl]
      exact hSloopless
    exact hcore Sᶜ hcutC hSCtwo' hdoubleCard hdoubleLoopless

/-! ## Components after an induced deletion

Tutte's theorem produces connected components on a subtype of a subtype:
first one induces on `A`, then deletes `X ⊆ A`.  The next definitions lift
those components back to finsets of ambient vertices so that the pseudograph
cut identities above apply directly.
-/

noncomputable def deleteInducedSubgraph (G : SimpleGraph V) (A : Set V)
    (X : Set A) : (G.induce A).Subgraph :=
  (⊤ : (G.induce A).Subgraph).deleteVerts X

/-- The ambient vertices in one component of `G[A] - X`. -/
noncomputable def deletedComponentShore (G : SimpleGraph V) (A : Set V)
    (X : Set A)
    (c : (deleteInducedSubgraph G A X).coe.ConnectedComponent) : Finset V :=
  c.supp.toFinset.image fun w ↦ (w.1.1 : V)

/-- The ambient deletion set: vertices outside `A`, together with the lift of
`X` from the induced vertex subtype. -/
noncomputable def ambientDeletionSet (A : Set V) (X : Set A) : Finset V :=
  Aᶜ.toFinset ∪ X.toFinset.image fun a : A ↦ a.1

@[simp]
lemma mem_deletedComponentShore {G : SimpleGraph V} {A : Set V} {X : Set A}
    {c : (deleteInducedSubgraph G A X).coe.ConnectedComponent} {v : V} :
    v ∈ deletedComponentShore G A X c ↔
      ∃ w : (deleteInducedSubgraph G A X).verts,
        w ∈ c.supp ∧ (w.1.1 : V) = v := by
  classical
  simp [deletedComponentShore]

@[simp]
lemma mem_ambientDeletionSet {A : Set V} {X : Set A} {v : V} :
    v ∈ ambientDeletionSet A X ↔
      v ∉ A ∨ ∃ a : A, a ∈ X ∧ (a : V) = v := by
  classical
  simp [ambientDeletionSet]

lemma deletedComponentShore_nonempty (G : SimpleGraph V) (A : Set V)
    (X : Set A) (c : (deleteInducedSubgraph G A X).coe.ConnectedComponent) :
    (deletedComponentShore G A X c).Nonempty := by
  classical
  obtain ⟨w, hw⟩ := c.nonempty_supp
  exact ⟨w.1.1, mem_deletedComponentShore.mpr ⟨w, hw, rfl⟩⟩

/-- Lifting a component support through the two subtype inclusions does not
change its finite cardinality. -/
lemma card_deletedComponentShore (G : SimpleGraph V) (A : Set V)
    (X : Set A) (c : (deleteInducedSubgraph G A X).coe.ConnectedComponent) :
    (deletedComponentShore G A X c).card = c.supp.ncard := by
  classical
  unfold deletedComponentShore
  rw [Finset.card_image_of_injective]
  · exact (Set.ncard_eq_toFinset_card' c.supp).symm
  · intro a b hab
    apply Subtype.ext
    apply Subtype.ext
    exact hab

lemma deletedComponentShore_disjoint_ambientDeletionSet
    (G : SimpleGraph V) (A : Set V) (X : Set A)
    (c : (deleteInducedSubgraph G A X).coe.ConnectedComponent) :
    Disjoint (deletedComponentShore G A X c) (ambientDeletionSet A X) := by
  classical
  rw [Finset.disjoint_left]
  intro v hvshore hvdelete
  obtain ⟨w, hwc, hwv⟩ := mem_deletedComponentShore.mp hvshore
  rcases mem_ambientDeletionSet.mp hvdelete with hvA | ⟨a, haX, hav⟩
  · exact hvA (hwv ▸ w.1.2)
  · have haw : a = w.1 := by
      apply Subtype.ext
      exact hav.trans hwv.symm
    subst a
    have hwX : w.1 ∉ X := by
      simpa [deleteInducedSubgraph] using w.2
    exact hwX haX

lemma deletedComponentShore_disjoint
    (G : SimpleGraph V) (A : Set V) (X : Set A)
    {c d : (deleteInducedSubgraph G A X).coe.ConnectedComponent} (hcd : c ≠ d) :
    Disjoint (deletedComponentShore G A X c)
      (deletedComponentShore G A X d) := by
  classical
  rw [Finset.disjoint_left]
  intro v hvc hvd
  obtain ⟨w, hwc, hwv⟩ := mem_deletedComponentShore.mp hvc
  obtain ⟨z, hzd, hzv⟩ := mem_deletedComponentShore.mp hvd
  have hwz : w = z := by
    apply Subtype.ext
    apply Subtype.ext
    exact hwv.trans hzv.symm
  have hcomponent : c = d :=
    SimpleGraph.ConnectedComponent.eq_of_common_vertex hwc (hwz ▸ hzd)
  exact hcd hcomponent

/-- Every ambient edge leaving a lifted component of `G[A] - X` ends in the
ambient deletion set `Aᶜ ∪ X`. -/
lemma deletedComponentShore_closed
    (G : SimpleGraph V) (A : Set V) (X : Set A)
    (c : (deleteInducedSubgraph G A X).coe.ConnectedComponent)
    {a : V} (ha : a ∈ deletedComponentShore G A X c) (b : V)
    (hab : (Pseudograph.ofSimple G).mult a b ≠ 0) :
    b ∈ deletedComponentShore G A X c ∨ b ∈ ambientDeletionSet A X := by
  classical
  have habG : G.Adj a b := by
    by_contra hn
    simp [Pseudograph.ofSimple_mult, hn] at hab
  obtain ⟨w, hwc, hwv⟩ := mem_deletedComponentShore.mp ha
  by_cases hbA : b ∈ A
  · let bA : A := ⟨b, hbA⟩
    by_cases hbX : bA ∈ X
    · right
      exact mem_ambientDeletionSet.mpr (.inr ⟨bA, hbX, rfl⟩)
    · let bD : (deleteInducedSubgraph G A X).verts :=
        ⟨bA, by simpa [deleteInducedSubgraph] using hbX⟩
      have hwX : w.1 ∉ X := by
        simpa [deleteInducedSubgraph] using w.2
      have hind : (G.induce A).Adj w.1 bA := by
        simpa [SimpleGraph.induce_adj, hwv] using habG
      have hsub : (deleteInducedSubgraph G A X).Adj w.1 bA := by
        change ((⊤ : (G.induce A).Subgraph).deleteVerts X).Adj w.1 bA
        exact SimpleGraph.Subgraph.deleteVerts_adj.mpr
          ⟨by simp, hwX, by simp, hbX, by simpa using hind⟩
      have hcoe : (deleteInducedSubgraph G A X).coe.Adj w bD := by
        exact hsub
      have hbcomp : bD ∈ c.supp :=
        c.mem_supp_of_adj_mem_supp hwc hcoe
      left
      exact mem_deletedComponentShore.mpr ⟨bD, hbcomp, rfl⟩
  · right
    exact mem_ambientDeletionSet.mpr (.inl hbA)

/-- The lifted component shores cover exactly the ambient vertices which
were not deleted. -/
lemma exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet
    (G : SimpleGraph V) (A : Set V) (X : Set A) {v : V}
    (hv : v ∉ ambientDeletionSet A X) :
    ∃ c : (deleteInducedSubgraph G A X).coe.ConnectedComponent,
      v ∈ deletedComponentShore G A X c := by
  classical
  have hvA : v ∈ A := by
    by_contra hvA
    exact hv (mem_ambientDeletionSet.mpr (.inl hvA))
  let a : A := ⟨v, hvA⟩
  have haX : a ∉ X := by
    intro haX
    exact hv (mem_ambientDeletionSet.mpr (.inr ⟨a, haX, rfl⟩))
  let w : (deleteInducedSubgraph G A X).verts :=
    ⟨a, by simpa [deleteInducedSubgraph] using haX⟩
  let c := (deleteInducedSubgraph G A X).coe.connectedComponentMk w
  refine ⟨c, mem_deletedComponentShore.mpr ⟨w, ?_, rfl⟩⟩
  exact SimpleGraph.ConnectedComponent.connectedComponentMk_mem

/-- The cuts of all components of an induced deletion partition the cut of
the ambient deletion set. -/
lemma sum_boundaryMultiplicity_deletedComponentShore
    (G : SimpleGraph V) (A : Set V) (X : Set A) :
    (∑ c : (deleteInducedSubgraph G A X).coe.ConnectedComponent,
      (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G A X c)) =
      (Pseudograph.ofSimple G).boundaryMultiplicity
        (ambientDeletionSet A X) := by
  classical
  simpa using Pseudograph.sum_boundaryMultiplicity_eq_boundaryMultiplicity
    (Pseudograph.ofSimple G) (ambientDeletionSet A X)
    (Finset.univ : Finset
      (deleteInducedSubgraph G A X).coe.ConnectedComponent)
    (fun c ↦ deletedComponentShore G A X c)
    (fun c _ ↦ deletedComponentShore_disjoint_ambientDeletionSet G A X c)
    (fun c _ d _ hcd ↦ deletedComponentShore_disjoint G A X hcd)
    (fun c _ a ha b hab ↦ deletedComponentShore_closed G A X c ha b hab)
    (fun v hv ↦ by
      obtain ⟨c, hc⟩ :=
        exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet G A X hv
      exact ⟨c, Finset.mem_univ c, hc⟩)

/-- Tashkinov's master incidence count before rearranging it as a deficiency
identity: the four incidences at each deleted vertex split into twice the
internal edges and the cuts of all remaining components. -/
lemma quartic_deletion_master_count
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (A : Set V) (X : Set A) :
    4 * (ambientDeletionSet A X).card =
      2 * (Pseudograph.ofSimple G).internalMultiplicity
        (ambientDeletionSet A X) +
      ∑ c : (deleteInducedSubgraph G A X).coe.ConnectedComponent,
        (Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G A X c) := by
  rw [sum_boundaryMultiplicity_deletedComponentShore]
  exact Pseudograph.regular_card_eq_two_internal_add_boundary
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
    (ambientDeletionSet A X)

/-- Applying the quartic cut ledger to all odd components of `G[A] - X`.
If every one of their ambient shores has cut at least four and the ambient
deletion set contains an internal edge, then there are fewer odd components
than deleted ambient vertices. -/
lemma ncard_oddComponents_lt_ambientDeletionSet_card
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (A : Set V) (X : Set A)
    (hfour : ∀ c : (deleteInducedSubgraph G A X).coe.oddComponents,
      4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G A X c.1))
    (hinternal : 0 < (Pseudograph.ofSimple G).internalMultiplicity
      (ambientDeletionSet A X)) :
    (deleteInducedSubgraph G A X).coe.oddComponents.ncard <
      (ambientDeletionSet A X).card := by
  classical
  let O := (deleteInducedSubgraph G A X).coe.oddComponents
  let I : Finset O := Finset.univ
  let S : O → Finset V := fun c ↦ deletedComponentShore G A X c.1
  have hI := Pseudograph.card_lt_of_four_le_boundaryMultiplicity
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
    (ambientDeletionSet A X) I S
    (fun c _ ↦ deletedComponentShore_disjoint_ambientDeletionSet G A X c.1)
    (fun c _ d _ hcd ↦ by
      apply deletedComponentShore_disjoint G A X
      intro h
      apply hcd
      exact Subtype.ext h)
    (fun c _ a ha b hab ↦ deletedComponentShore_closed G A X c.1 ha b hab)
    (fun c _ ↦ hfour c) hinternal
  change Fintype.card O < (ambientDeletionSet A X).card at hI
  rw [Set.fintypeCard_eq_ncard] at hI
  simpa [O] using hI

/-! ## Extending a matching across two omitted vertices -/

/-- A subgraph of an induced graph, regarded as a subgraph of the ambient
graph. -/
def liftInducedSubgraph (G : SimpleGraph V) (A : Set V)
    (M : (G.induce A).Subgraph) : G.Subgraph :=
  M.map (SimpleGraph.Embedding.induce A).toHom

lemma liftInducedSubgraph_verts {G : SimpleGraph V} {A : Set V}
    {M : (G.induce A).Subgraph} (hM : M.IsSpanning) :
    (liftInducedSubgraph G A M).verts = A := by
  classical
  ext v
  simp [liftInducedSubgraph, hM.verts_eq_univ]

lemma liftInducedSubgraph_isMatching {G : SimpleGraph V} {A : Set V}
    {M : (G.induce A).Subgraph} (hM : M.IsMatching) :
    (liftInducedSubgraph G A M).IsMatching := by
  exact hM.map _ (SimpleGraph.Embedding.induce (G := G) A).injective

lemma ambientDeletionSet_card (A : Set V) (X : Set A) :
    (ambientDeletionSet A X).card = Aᶜ.ncard + X.ncard := by
  classical
  let T : Finset V := X.toFinset.image fun a : A ↦ (a : V)
  have hdisj : Disjoint Aᶜ.toFinset T := by
    rw [Finset.disjoint_left]
    intro v hvcompl hvT
    dsimp [T] at hvT
    obtain ⟨a, haX, hav⟩ := Finset.mem_image.mp hvT
    have hvnotA : v ∉ A := by simpa using hvcompl
    exact hvnotA (hav ▸ a.2)
  have hTcard : T.card = X.ncard := by
    dsimp [T]
    rw [Finset.card_image_of_injective _ Subtype.val_injective]
    exact (Set.ncard_eq_toFinset_card' X).symm
  change (Aᶜ.toFinset ∪ T).card = Aᶜ.ncard + X.ncard
  rw [Finset.card_union_of_disjoint hdisj, hTcard]
  congr
  exact (Set.ncard_eq_toFinset_card' Aᶜ).symm

lemma ambientDeletionSet_compl_pair_card {x y : V} (hxy : x ≠ y)
    (X : Set ↑(({x, y} : Set V)ᶜ)) :
    (ambientDeletionSet (({x, y} : Set V)ᶜ) X).card = X.ncard + 2 := by
  rw [ambientDeletionSet_card]
  simp [hxy, Nat.add_comm]

/-- Deleting `X` from an even-order graph leaves a number of odd components
with the same parity as `|X|`.  This is the parity half of every Tutte
deficiency argument below. -/
lemma odd_ncard_oddComponents_delete_iff
    (G : SimpleGraph V) (heven : Even (Nat.card V)) (X : Set V) :
    Odd ((⊤ : G.Subgraph).deleteVerts X).coe.oddComponents.ncard ↔
      Odd X.ncard := by
  rw [SimpleGraph.odd_ncard_oddComponents]
  change Odd (((⊤ : G.Subgraph).deleteVerts X).verts.ncard) ↔ Odd X.ncard
  rw [SimpleGraph.Subgraph.deleteVerts_verts]
  have huniv : (Set.univ \ X : Set V) = Xᶜ := by
    ext v
    simp
  have htop : (⊤ : G.Subgraph).verts = Set.univ := rfl
  rw [htop, huniv]
  exact Set.odd_ncard_compl_iff heven X

/-- When the ambient graph has even order and two distinct vertices have
been removed before a further deletion `X`, the number of odd components of
what remains has the same parity as `|X|`. -/
lemma odd_ncard_oddComponents_delete_compl_pair_iff
    (heven : Even (Nat.card V)) {x y : V} (hxy : x ≠ y)
    (X : Set ↑(({x, y} : Set V)ᶜ)) :
    Odd (deleteInducedSubgraph G (({x, y} : Set V)ᶜ) X).coe.oddComponents.ncard ↔
      Odd X.ncard := by
  let A : Set V := ({x, y} : Set V)ᶜ
  have hAeven : Even (Nat.card A) := by
    rw [Nat.card_coe_set_eq]
    exact (Set.even_ncard_compl_iff heven ({x, y} : Set V)).mpr (by
      simp [hxy])
  rw [SimpleGraph.odd_ncard_oddComponents]
  rw [Nat.card_coe_set_eq]
  change Odd (((⊤ : (G.induce A).Subgraph).deleteVerts X).verts.ncard) ↔
    Odd X.ncard
  rw [SimpleGraph.Subgraph.deleteVerts_verts]
  have huniv : (Set.univ \ X : Set A) = Xᶜ := by
    ext a
    simp
  have htop : (⊤ : (G.induce A).Subgraph).verts = Set.univ := rfl
  rw [htop, huniv]
  exact Set.odd_ncard_compl_iff hAeven X

/-- An ambient edge whose endpoints lie in a shore contributes a positive
amount to the shore's internal multiplicity. -/
lemma internalMultiplicity_pos_of_adj_mem (G : SimpleGraph V) (S : Finset V)
    {x y : V} (hxy : G.Adj x y) (hx : x ∈ S) (hy : y ∈ S) :
    0 < (Pseudograph.ofSimple G).internalMultiplicity S := by
  classical
  have hterm :
      (Pseudograph.ofSimple G).edgeMultiplicity s(x, y) *
          Pseudograph.internalIndicator S s(x, y) = 1 := by
    simp [Pseudograph.edgeMultiplicity_mk, Pseudograph.ofSimple_mult, hxy, hx, hy]
  calc
    0 < (Pseudograph.ofSimple G).edgeMultiplicity s(x, y) *
        Pseudograph.internalIndicator S s(x, y) := by omega
    _ ≤ (Pseudograph.ofSimple G).internalMultiplicity S := by
      unfold Pseudograph.internalMultiplicity
      exact Finset.single_le_sum (s := Finset.univ)
        (f := fun e : Sym2 V ↦
          (Pseudograph.ofSimple G).edgeMultiplicity e *
            Pseudograph.internalIndicator S e)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s(x, y))

/-- An ambient edge with one endpoint in each of two shores contributes a
positive amount to their between-block multiplicity. -/
lemma betweenMultiplicity_pos_of_adj_mem (G : SimpleGraph V)
    (S T : Finset V) (hdisj : Disjoint S T) {x y : V} (hxy : G.Adj x y)
    (hx : x ∈ S) (hy : y ∈ T) :
    0 < (Pseudograph.ofSimple G).betweenMultiplicity S T := by
  classical
  have hxT : x ∉ T := fun h ↦ (Finset.disjoint_left.mp hdisj) hx h
  have hyS : y ∉ S := fun h ↦ (Finset.disjoint_left.mp hdisj) h hy
  have hterm :
      (Pseudograph.ofSimple G).edgeMultiplicity s(x, y) *
          Pseudograph.betweenIndicator S T s(x, y) = 1 := by
    simp [Pseudograph.edgeMultiplicity_mk, Pseudograph.ofSimple_mult,
      hxy, hx, hy, hxT, hyS]
  calc
    0 < (Pseudograph.ofSimple G).edgeMultiplicity s(x, y) *
        Pseudograph.betweenIndicator S T s(x, y) := by omega
    _ ≤ (Pseudograph.ofSimple G).betweenMultiplicity S T := by
      unfold Pseudograph.betweenMultiplicity
      exact Finset.single_le_sum (s := Finset.univ)
        (f := fun e : Sym2 V ↦
          (Pseudograph.ofSimple G).edgeMultiplicity e *
            Pseudograph.betweenIndicator S T e)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s(x, y))

/-- A singleton shore in a simple graph contains no internal edge. -/
lemma internalMultiplicity_singleton_ofSimple (G : SimpleGraph V) (v : V) :
    (Pseudograph.ofSimple G).internalMultiplicity {v} = 0 := by
  classical
  unfold Pseudograph.internalMultiplicity
  apply Finset.sum_eq_zero
  intro e _
  induction e using Sym2.inductionOn with
  | _ a b =>
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.internalIndicator_mk, Finset.mem_singleton]
      by_cases ha : a = v <;> by_cases hb : b = v <;>
        simp [Pseudograph.ofSimple_mult, ha, hb]

/-- A singleton shore of a pseudograph contains exactly the loops at its
unique vertex. -/
lemma Pseudograph.internalMultiplicity_singleton
    (P : Pseudograph V) (v : V) :
    P.internalMultiplicity {v} = P.mult v v := by
  classical
  unfold Pseudograph.internalMultiplicity
  rw [Finset.sum_eq_single s(v, v)]
  · simp [Pseudograph.edgeMultiplicity_mk,
      Pseudograph.internalIndicator_mk]
  · intro e _he hne
    induction e using Sym2.inductionOn with
    | _ a b =>
        simp only [Pseudograph.edgeMultiplicity_mk,
          Pseudograph.internalIndicator_mk, Finset.mem_singleton]
        by_cases ha : a = v <;> by_cases hb : b = v
        · subst a
          subst b
          exact (hne rfl).elim
        all_goals simp [ha, hb]
  · simp

/-- An independent shore contains no internal edge. -/
lemma internalMultiplicity_eq_zero_of_isIndepSet
    (G : SimpleGraph V) (S : Finset V)
    (hS : G.IsIndepSet (S : Set V)) :
    (Pseudograph.ofSimple G).internalMultiplicity S = 0 := by
  classical
  unfold Pseudograph.internalMultiplicity
  apply Finset.sum_eq_zero
  intro e _
  induction e using Sym2.inductionOn with
  | _ a b =>
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.internalIndicator_mk]
      by_cases ha : a ∈ S <;> by_cases hb : b ∈ S
      · have hnAdj : ¬ G.Adj a b := by
          by_cases hab : a = b
          · subst b
            simp
          · exact hS (by simpa using ha) (by simpa using hb) hab
        simp [Pseudograph.ofSimple_mult, ha, hb, hnAdj]
      · simp [ha, hb]
      · simp [ha, hb]
      · simp [ha, hb]

/-- If no graph edge joins two blocks, their between-block multiplicity is
zero. -/
lemma betweenMultiplicity_eq_zero_of_no_adj
    (G : SimpleGraph V) (S T : Finset V)
    (hno : ∀ a ∈ S, ∀ b ∈ T, ¬ G.Adj a b) :
    (Pseudograph.ofSimple G).betweenMultiplicity S T = 0 := by
  classical
  unfold Pseudograph.betweenMultiplicity
  apply Finset.sum_eq_zero
  intro e _
  induction e using Sym2.inductionOn with
  | _ a b =>
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.betweenIndicator_mk]
      by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T
      all_goals simp [Pseudograph.ofSimple_mult, haS, hbS, haT, hbT]
      all_goals first
        | exact hno a haS b hbT
        | exact fun hab ↦ hno b hbS a haT hab.symm

/-- The corresponding vanishing lemma for an arbitrary pseudograph, stated
through its underlying simple adjacency.  Disjointness rules out a loop as
the only reason a positive matrix entry might fail to be an adjacency. -/
lemma Pseudograph.betweenMultiplicity_eq_zero_of_no_toSimple_adj
    (P : Pseudograph V) (S T : Finset V) (hST : Disjoint S T)
    (hno : ∀ a ∈ S, ∀ b ∈ T, ¬ P.toSimple.Adj a b) :
    P.betweenMultiplicity S T = 0 := by
  classical
  unfold Pseudograph.betweenMultiplicity
  apply Finset.sum_eq_zero
  intro e _
  induction e using Sym2.inductionOn with
  | _ a b =>
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.betweenIndicator_mk]
      by_cases hcross : (a ∈ S ∧ b ∈ T) ∨ (a ∈ T ∧ b ∈ S)
      · rw [if_pos hcross, Nat.mul_one]
        rcases hcross with hcross | hcross
        · apply Nat.eq_zero_of_not_pos
          intro hp
          apply hno a hcross.1 b hcross.2
          exact ⟨fun hab ↦ (Finset.disjoint_left.mp hST)
            hcross.1 (hab ▸ hcross.2), hp⟩
        · apply Nat.eq_zero_of_not_pos
          intro hp
          apply hno b hcross.2 a hcross.1
          exact ⟨fun hba ↦ (Finset.disjoint_left.mp hST)
            hcross.2 (hba ▸ hcross.1), by simpa [P.mult_comm] using hp⟩
      · rw [if_neg hcross, Nat.mul_zero]

/-- If every neighbour of a vertex in `S` lies in the disjoint block `T`,
then the whole boundary of `S` is precisely its between-block edge count
with `T`. -/
lemma boundaryMultiplicity_eq_between_of_neighbors_subset
    (G : SimpleGraph V) (S T : Finset V) (hST : Disjoint S T)
    (hneighbors : ∀ a ∈ S, ∀ b, G.Adj a b → b ∈ T) :
    (Pseudograph.ofSimple G).boundaryMultiplicity S =
      (Pseudograph.ofSimple G).betweenMultiplicity S T := by
  classical
  unfold Pseudograph.boundaryMultiplicity Pseudograph.betweenMultiplicity
  apply Finset.sum_congr rfl
  intro e _
  induction e using Sym2.inductionOn with
  | _ u v =>
      have hST' : ∀ x, x ∈ S → x ∈ T → False :=
        Finset.disjoint_left.mp hST
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.crossingIndicator_mk, Pseudograph.betweenIndicator_mk]
      by_cases huS : u ∈ S <;> by_cases hvS : v ∈ S <;>
        by_cases huT : u ∈ T <;> by_cases hvT : v ∈ T <;>
        by_cases huv : G.Adj u v
      all_goals simp [Pseudograph.ofSimple_mult, huS, hvS, huT, hvT, huv]
      all_goals exfalso
      all_goals first
        | exact hST' u huS huT
        | exact hST' v hvS hvT
        | exact hvT (hneighbors u huS v huv)
        | exact huT (hneighbors v hvS u huv.symm)

/-- A boundary version allowing internal neighbours of `S`: only neighbours
across the cut are required to land in `T`. -/
lemma boundaryMultiplicity_eq_between_of_crossing_neighbors_subset
    (G : SimpleGraph V) (S T : Finset V) (hST : Disjoint S T)
    (hneighbors : ∀ a ∈ S, ∀ b, G.Adj a b → b ∉ S → b ∈ T) :
    (Pseudograph.ofSimple G).boundaryMultiplicity S =
      (Pseudograph.ofSimple G).betweenMultiplicity S T := by
  classical
  unfold Pseudograph.boundaryMultiplicity Pseudograph.betweenMultiplicity
  apply Finset.sum_congr rfl
  intro e _
  induction e using Sym2.inductionOn with
  | _ u v =>
      have hST' : ∀ x, x ∈ S → x ∈ T → False :=
        Finset.disjoint_left.mp hST
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.crossingIndicator_mk, Pseudograph.betweenIndicator_mk]
      by_cases huS : u ∈ S <;> by_cases hvS : v ∈ S <;>
        by_cases huT : u ∈ T <;> by_cases hvT : v ∈ T <;>
        by_cases huv : G.Adj u v
      all_goals simp [Pseudograph.ofSimple_mult, huS, hvS, huT, hvT, huv]
      all_goals exfalso
      all_goals first
        | exact hST' u huS huT
        | exact hST' v hvS hvT
        | exact hvT (hneighbors u huS v huv hvS)
        | exact huT (hneighbors v hvS u huv.symm huS)

/-- Degree summation over an independent block whose entire neighbourhood
lies in a second block. -/
lemma betweenMultiplicity_eq_regular_mul_card_of_independent
    (G : SimpleGraph V) {r : ℕ} (hreg : G.IsRegularOfDegree r)
    (S T : Finset V) (hST : Disjoint S T)
    (hS : G.IsIndepSet (S : Set V))
    (hneighbors : ∀ a ∈ S, ∀ b, G.Adj a b → b ∈ T) :
    (Pseudograph.ofSimple G).betweenMultiplicity S T = r * S.card := by
  have hint : (Pseudograph.ofSimple G).internalMultiplicity S = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G S hS
  have hboundary := boundaryMultiplicity_eq_between_of_neighbors_subset
    G S T hST hneighbors
  have hdegree := Pseudograph.regular_card_eq_two_internal_add_boundary
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G r).mpr hreg) S
  rw [hint, Nat.mul_zero, Nat.zero_add, hboundary] at hdegree
  exact hdegree.symm

/-- The easy parity part of Tashkinov's independent-complement lemma: in an
odd-order quartic graph, the complement of an independent set contains at
least two internal edges.  The hard remaining equality case is exactly what
the bipartite-six-component argument excludes. -/
lemma two_le_internalMultiplicity_compl_of_independent_of_odd
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (U : Finset V)
    (hU : G.IsIndepSet (U : Set V)) :
    2 ≤ (Pseudograph.ofSimple G).internalMultiplicity Uᶜ := by
  classical
  let m := (Pseudograph.ofSimple G).internalMultiplicity Uᶜ
  have hUint : (Pseudograph.ofSimple G).internalMultiplicity U = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G U hU
  have hUcount := Pseudograph.regular_card_eq_two_internal_add_boundary
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) U
  have hXcount := Pseudograph.regular_card_eq_two_internal_add_boundary
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) Uᶜ
  have hboundary := Pseudograph.boundaryMultiplicity_compl
    (Pseudograph.ofSimple G) U
  have hcards : U.card + Uᶜ.card = Nat.card V := by
    rw [Finset.card_add_card_compl, Nat.card_eq_fintype_card]
  by_contra hm
  have hmle : m ≤ 1 := by omega
  rcases hodd with ⟨k, hk⟩
  dsimp only [m] at hmle
  by_cases hmzero :
      (Pseudograph.ofSimple G).internalMultiplicity Uᶜ = 0
  · omega
  · have hmone :
        (Pseudograph.ofSimple G).internalMultiplicity Uᶜ = 1 := by omega
    omega

/-- Every singleton shore of a simple quartic graph has boundary exactly
four. -/
lemma boundaryMultiplicity_singleton_of_quartic
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4) (v : V) :
    (Pseudograph.ofSimple G).boundaryMultiplicity {v} = 4 := by
  have h := Pseudograph.regular_card_eq_two_internal_add_boundary
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) {v}
  rw [internalMultiplicity_singleton_ofSimple G v] at h
  simp at h ⊢
  omega

/-- Tashkinov's actual conclusion about six-edge cuts: a six-cut may
remain only when one of its shores is the trivial two-vertex shore. -/
def HasOnlyTrivialSixCuts (G : SimpleGraph V) : Prop :=
  ∀ S : Finset V,
    (Pseudograph.ofSimple G).boundaryMultiplicity S = 6 →
      S.card = 2 ∨ Sᶜ.card = 2

/-- Hence a shore of boundary six or eight in a simple quartic graph is
nontrivial on both sides. -/
lemma card_ne_one_of_boundaryMultiplicity_ne_four
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4) (S : Finset V)
    (hcut : (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 4) :
    S.card ≠ 1 ∧ Sᶜ.card ≠ 1 := by
  constructor
  · intro hcard
    obtain ⟨v, rfl⟩ := Finset.card_eq_one.mp hcard
    exact hcut (boundaryMultiplicity_singleton_of_quartic G hreg v)
  · intro hcard
    obtain ⟨v, hv⟩ := Finset.card_eq_one.mp hcard
    have hboundary := Pseudograph.boundaryMultiplicity_compl
      (Pseudograph.ofSimple G) S
    rw [hv, boundaryMultiplicity_singleton_of_quartic G hreg v] at hboundary
    exact hcut hboundary.symm

/-- An edge crossing a shore contributes one to its boundary multiplicity. -/
lemma boundaryMultiplicity_pos_of_adj_crossing (G : SimpleGraph V) (S : Finset V)
    {x y : V} (hxy : G.Adj x y) (hx : x ∈ S) (hy : y ∉ S) :
    0 < (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  classical
  have hterm :
      (Pseudograph.ofSimple G).edgeMultiplicity s(x, y) *
          Pseudograph.crossingIndicator S s(x, y) = 1 := by
    simp [Pseudograph.edgeMultiplicity_mk, Pseudograph.ofSimple_mult, hxy, hx, hy]
  calc
    0 < (Pseudograph.ofSimple G).edgeMultiplicity s(x, y) *
        Pseudograph.crossingIndicator S s(x, y) := by omega
    _ ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
      unfold Pseudograph.boundaryMultiplicity
      exact Finset.single_le_sum (s := Finset.univ)
        (f := fun e : Sym2 V ↦
          (Pseudograph.ofSimple G).edgeMultiplicity e *
            Pseudograph.crossingIndicator S e)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s(x, y))

/-- Every proper nonempty shore of a connected graph has an edge in its
boundary.  This is kept at the multiplicity level used by the cut ledger. -/
lemma boundaryMultiplicity_pos_of_connected (G : SimpleGraph V)
    (hconn : G.Connected) (S : Finset V) (hS : S.Nonempty)
    (hproper : S ≠ Finset.univ) :
    0 < (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  classical
  obtain ⟨x, hx⟩ := hS
  have hexists : ∃ y : V, y ∉ S := by
    by_contra h
    push_neg at h
    apply hproper
    ext y
    simp [h y]
  obtain ⟨y, hy⟩ := hexists
  obtain ⟨p⟩ := hconn x y
  obtain ⟨⟨d, hadj⟩, _hd, hdx, hdy⟩ :=
    p.exists_boundary_dart (S : Set V) (by simpa using hx) (by simpa using hy)
  exact boundaryMultiplicity_pos_of_adj_crossing G S hadj
    (by simpa using hdx) (by simpa using hdy)

lemma boundaryMultiplicity_pos_of_mult_crossing
    (P : Pseudograph V) (S : Finset V) {x y : V}
    (hxy : 0 < P.mult x y) (hx : x ∈ S) (hy : y ∉ S) :
    0 < P.boundaryMultiplicity S := by
  classical
  have hterm : P.edgeMultiplicity s(x, y) *
      Pseudograph.crossingIndicator S s(x, y) = P.mult x y := by
    simp [Pseudograph.edgeMultiplicity_mk,
      Pseudograph.crossingIndicator_mk, hx, hy]
  calc
    0 < P.edgeMultiplicity s(x, y) *
        Pseudograph.crossingIndicator S s(x, y) := by
      rw [hterm]
      exact hxy
    _ ≤ P.boundaryMultiplicity S := by
      unfold Pseudograph.boundaryMultiplicity
      exact Finset.single_le_sum (s := Finset.univ)
        (f := fun e : Sym2 V ↦
          P.edgeMultiplicity e * Pseudograph.crossingIndicator S e)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s(x, y))

lemma boundaryMultiplicity_pos_of_underlying_connected
    (P : Pseudograph V) (hconn : P.toSimple.Connected)
    (S : Finset V) (hS : S.Nonempty) (hproper : S ≠ Finset.univ) :
    0 < P.boundaryMultiplicity S := by
  classical
  obtain ⟨x, hx⟩ := hS
  have hexists : ∃ y : V, y ∉ S := by
    by_contra h
    push_neg at h
    apply hproper
    ext y
    simp [h y]
  obtain ⟨y, hy⟩ := hexists
  obtain ⟨p⟩ := hconn x y
  obtain ⟨⟨d, hadj⟩, _hd, hdx, hdy⟩ :=
    p.exists_boundary_dart (S : Set V) (by simpa using hx) (by simpa using hy)
  exact boundaryMultiplicity_pos_of_mult_crossing P S hadj.2
    (by simpa using hdx) (by simpa using hdy)

lemma four_le_boundaryMultiplicity_of_underlying_connected_of_ne_two
    (P : Pseudograph V) (hreg : P.IsRegularOfDegree 4)
    (hconn : P.toSimple.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      P.boundaryMultiplicity S ≠ 2)
    (S : Finset V) (hS : S.Nonempty) (hproper : S ≠ Finset.univ) :
    4 ≤ P.boundaryMultiplicity S := by
  have hpos := boundaryMultiplicity_pos_of_underlying_connected
    P hconn S hS hproper
  have heven := P.boundaryMultiplicity_even_of_even_regular
    (r := 2) (by simpa using hreg) S
  have hne := hno2 S hS hproper
  rcases heven with ⟨k, hk⟩
  omega

lemma eq_empty_of_boundaryMultiplicity_eq_zero_of_connected
    (G : SimpleGraph V) (hconn : G.Connected) (S : Finset V)
    (hproper : S ≠ Finset.univ)
    (hzero : (Pseudograph.ofSimple G).boundaryMultiplicity S = 0) :
    S = ∅ := by
  by_contra hne
  have hS : S.Nonempty := Finset.nonempty_iff_ne_empty.mpr hne
  have hpos := boundaryMultiplicity_pos_of_connected G hconn S hS hproper
  omega

/-- In a connected quartic graph, excluding a two-edge cut is exactly enough
to obtain the lower bound four used by the prescribed-edge Tutte argument. -/
lemma four_le_boundaryMultiplicity_of_connected_of_ne_two
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (S : Finset V) (hS : S.Nonempty) (hproper : S ≠ Finset.univ) :
    4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  have hpos := boundaryMultiplicity_pos_of_connected G hconn S hS hproper
  have heven := Pseudograph.boundaryMultiplicity_even_of_even_regular
    (Pseudograph.ofSimple G) (r := 2)
    (by simpa using
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
  have hne := hno2 S hS hproper
  rcases heven with ⟨k, hk⟩
  omega

/-- Under the structural cut conclusions of the minimal counterexample,
every nontrivial proper shore has boundary at least eight. -/
lemma eight_le_boundaryMultiplicity_of_nontrivial
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (S : Finset V) (hS : S.Nonempty) (hproper : S ≠ Finset.univ)
    (hScard : S.card ≠ 1) (hcompcard : Sᶜ.card ≠ 1)
    (hcut6 : (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 6) :
    8 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  have hpos := boundaryMultiplicity_pos_of_connected G hconn S hS hproper
  have heven : Even ((Pseudograph.ofSimple G).boundaryMultiplicity S) :=
    Pseudograph.boundaryMultiplicity_even_of_even_regular
      (Pseudograph.ofSimple G) (r := 2)
      (by simpa using
        ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
  by_contra hnot
  have hle : (Pseudograph.ofSimple G).boundaryMultiplicity S ≤ 7 := by omega
  rcases heven with ⟨k, hk⟩
  have hcases : (Pseudograph.ofSimple G).boundaryMultiplicity S = 2 ∨
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 ∨
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 6 := by omega
  rcases hcases with h2 | h4 | h6
  · exact hno2 S hS hproper h2
  · rcases hno4 S hS hproper h4 with h1 | h1
    · exact hScard h1
    · exact hcompcard h1
  · exact hcut6 h6

/-- Two disjoint eight-shores joined by six edges have a four-edge union.
If both sides of that union contain at least two vertices, this contradicts
the minimal-counterexample four-cut property. -/
lemma false_of_two_eight_shores_between_six
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (S T R : Finset V) (hST : Disjoint S T)
    (hSR : Disjoint (S ∪ T) R)
    (hS8 : (Pseudograph.ofSimple G).boundaryMultiplicity S = 8)
    (hT8 : (Pseudograph.ofSimple G).boundaryMultiplicity T = 8)
    (hbetween : (Pseudograph.ofSimple G).betweenMultiplicity S T = 6)
    (hRcard : 2 ≤ R.card) : False := by
  let P := Pseudograph.ofSimple G
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    hregular S T hST
  have hcut : P.boundaryMultiplicity (S ∪ T) = 4 := by
    change P.boundaryMultiplicity S = 8 at hS8
    change P.boundaryMultiplicity T = 8 at hT8
    change P.betweenMultiplicity S T = 6 at hbetween
    omega
  have hSnonempty : S.Nonempty := by
    by_contra h
    have hEmpty := Finset.not_nonempty_iff_eq_empty.mp h
    rw [hEmpty, P.betweenMultiplicity_empty_left] at hbetween
    omega
  have hTnonempty : T.Nonempty := by
    by_contra h
    have hEmpty := Finset.not_nonempty_iff_eq_empty.mp h
    rw [hEmpty, P.betweenMultiplicity_empty_right] at hbetween
    omega
  have hUcard : 2 ≤ (S ∪ T).card := by
    have hcard := Finset.card_union_of_disjoint hST
    have hSpos := Finset.card_pos.mpr hSnonempty
    have hTpos := Finset.card_pos.mpr hTnonempty
    omega
  have hRsub : R ⊆ (S ∪ T)ᶜ := by
    intro x hxR
    simp only [Finset.mem_compl]
    exact fun hxU ↦ (Finset.disjoint_left.mp hSR) hxU hxR
  have hcompcard : 2 ≤ (S ∪ T)ᶜ.card :=
    hRcard.trans (Finset.card_le_card hRsub)
  have hproper : S ∪ T ≠ Finset.univ := by
    intro hEq
    have : (S ∪ T)ᶜ.card = 0 := by simp [hEq]
    omega
  rcases hno4 (S ∪ T) (Finset.union_nonempty.mpr (.inl hSnonempty))
      hproper hcut with hcard | hcard <;> omega

/-- A perfect matching on all vertices except the endpoints of an edge
extends, using that edge, to a perfect matching of the ambient graph. -/
lemma exists_isPerfectMatching_of_compl_pair
    (G : SimpleGraph V) {x y : V} (hxy : G.Adj x y)
    (M : (G.induce (({x, y} : Set V)ᶜ)).Subgraph)
    (hM : M.IsPerfectMatching) :
    ∃ N : G.Subgraph, N.IsPerfectMatching ∧ N.Adj x y := by
  classical
  let A : Set V := ({x, y} : Set V)ᶜ
  let P : G.Subgraph := liftInducedSubgraph G A M
  let E : G.Subgraph := G.subgraphOfAdj hxy
  have hPmatch : P.IsMatching := liftInducedSubgraph_isMatching hM.1
  have hPverts : P.verts = A := liftInducedSubgraph_verts hM.2
  have hEmatch : E.IsMatching := SimpleGraph.Subgraph.IsMatching.subgraphOfAdj hxy
  have hdisj : Disjoint P.support E.support := by
    rw [hPmatch.support_eq_verts, hPverts, SimpleGraph.support_subgraphOfAdj]
    exact disjoint_compl_left
  refine ⟨P ⊔ E, ⟨hPmatch.sup hEmatch hdisj, ?_⟩,
    SimpleGraph.Subgraph.sup_adj.mpr (.inr
      (SimpleGraph.subgraphOfAdj_adj_self hxy))⟩
  rw [SimpleGraph.Subgraph.isSpanning_iff, SimpleGraph.Subgraph.verts_sup,
    hPverts, SimpleGraph.subgraphOfAdj_verts]
  simpa [A] using Set.compl_union_self ({x, y} : Set V)

/-! ## The first Tutte argument -/

/-- Tashkinov's Proposition 3.2 in the simple-graph setting.  In an
even-order quartic graph with no nontrivial cut of size below four, every
prescribed edge belongs to a perfect matching. -/
theorem exists_isPerfectMatching_containing_edge_of_four_le_boundary
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (heven : Even (Nat.card V))
    (hcut : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S)
    {x y : V} (hxy : G.Adj x y) :
    ∃ M : G.Subgraph, M.IsPerfectMatching ∧ M.Adj x y := by
  classical
  let A : Set V := ({x, y} : Set V)ᶜ
  have hinduced :
      ∃ M : (G.induce A).Subgraph, M.IsPerfectMatching := by
    rw [SimpleGraph.tutte]
    intro X hX
    change X.ncard <
      (deleteInducedSubgraph G A X).coe.oddComponents.ncard at hX
    let q := (deleteInducedSubgraph G A X).coe.oddComponents.ncard
    let U := ambientDeletionSet A X
    have hparity : Odd q ↔ Odd X.ncard := by
      simpa [q, A] using
        (odd_ncard_oddComponents_delete_compl_pair_iff
          (G := G) heven hxy.ne X)
    have hgap : X.ncard + 2 ≤ q := by
      by_cases hoddX : Odd X.ncard
      · have hoddq : Odd q := hparity.mpr hoddX
        rcases hoddX with ⟨a, ha⟩
        rcases hoddq with ⟨b, hb⟩
        omega
      · have hevenX : Even X.ncard := Nat.not_odd_iff_even.mp hoddX
        have hevenq : Even q := Nat.not_odd_iff_even.mp (fun hoddq ↦
          hoddX (hparity.mp hoddq))
        rcases hevenX with ⟨a, ha⟩
        rcases hevenq with ⟨b, hb⟩
        omega
    have hxU : x ∈ U := by
      apply mem_ambientDeletionSet.mpr
      left
      simp [A]
    have hyU : y ∈ U := by
      apply mem_ambientDeletionSet.mpr
      left
      simp [A]
    have hinternal :
        0 < (Pseudograph.ofSimple G).internalMultiplicity U :=
      internalMultiplicity_pos_of_adj_mem G U hxy hxU hyU
    have hfour : ∀ c : (deleteInducedSubgraph G A X).coe.oddComponents,
        4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G A X c.1) := by
      intro c
      apply hcut
      · exact deletedComponentShore_nonempty G A X c.1
      · intro hshore
        have hxshore : x ∈ deletedComponentShore G A X c.1 := by
          rw [hshore]
          simp
        exact (Finset.disjoint_left.mp
          (deletedComponentShore_disjoint_ambientDeletionSet G A X c.1))
          hxshore hxU
    have hledger := ncard_oddComponents_lt_ambientDeletionSet_card
      G hreg A X hfour hinternal
    have hUcard : U.card = X.ncard + 2 := by
      simpa [U, A] using ambientDeletionSet_compl_pair_card hxy.ne X
    change q < U.card at hledger
    omega
  obtain ⟨M, hM⟩ := hinduced
  simpa [A] using exists_isPerfectMatching_of_compl_pair G hxy M hM

/-- A positive nonloop multiplicity internal to a shore contributes a
positive internal-edge count. -/
lemma pseudograph_internalMultiplicity_pos_of_mult_pos
    (P : Pseudograph V) (S : Finset V) {x y : V}
    (hxy : 0 < P.mult x y) (hx : x ∈ S) (hy : y ∈ S) :
    0 < P.internalMultiplicity S := by
  classical
  have hterm :
      P.edgeMultiplicity s(x, y) * Pseudograph.internalIndicator S s(x, y) =
        P.mult x y := by
    simp [Pseudograph.edgeMultiplicity_mk,
      Pseudograph.internalIndicator_mk, hx, hy]
  calc
    0 < P.edgeMultiplicity s(x, y) *
        Pseudograph.internalIndicator S s(x, y) := by
      rw [hterm]
      exact hxy
    _ ≤ P.internalMultiplicity S := by
      unfold Pseudograph.internalMultiplicity
      exact Finset.single_le_sum (s := Finset.univ)
        (f := fun e : Sym2 V ↦
          P.edgeMultiplicity e * Pseudograph.internalIndicator S e)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ s(x, y))

/-- A component of a deletion in the underlying simple graph is closed for
the full pseudograph multiplicities as well; a loop stays on its own shore. -/
lemma deletedComponentShore_closed_pseudograph
    (P : Pseudograph V) (A : Set V) (X : Set A)
    (c : (deleteInducedSubgraph P.toSimple A X).coe.ConnectedComponent)
    {a : V} (ha : a ∈ deletedComponentShore P.toSimple A X c) (b : V)
    (hab : P.mult a b ≠ 0) :
    b ∈ deletedComponentShore P.toSimple A X c ∨
      b ∈ ambientDeletionSet A X := by
  by_cases hba : b = a
  · exact .inl (hba ▸ ha)
  · apply deletedComponentShore_closed P.toSimple A X c ha b
    simp only [Pseudograph.ofSimple_mult]
    have hadj : P.toSimple.Adj a b :=
      ⟨fun h ↦ hba h.symm, Nat.pos_of_ne_zero hab⟩
    rw [if_pos hadj]
    omega

/-- Proposition 2.7 and Tutte's theorem force the vertex-minimal
counterexample to have odd order even before its possible last loop has
been excluded.  Among the odd components of a Tutte deletion, at most two
can have a two-edge boundary: one because its own shore is a singleton and
one because its complementary shore is a singleton.  Both exceptional
possibilities consume the unique loop allowed in class `B`. -/
theorem IsVertexMinimalCounterexample.odd_order_of_no_parallel_edges
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hparallel : ∀ u v, u ≠ v → G.mult u v ≤ 1) : Odd n := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  haveI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  by_contra hnotOdd
  have heven : Even n := Nat.not_odd_iff_even.mp hnotOdd
  let A : Set (Fin n) := Set.univ
  let J : SimpleGraph A := G.toSimple.induce A
  have hevenJ : Even (Nat.card A) := by
    rw [Nat.card_coe_set_eq]
    simpa [A, Nat.card_eq_fintype_card] using heven
  have hnoMatching : ∀ M : J.Subgraph, ¬ M.IsPerfectMatching := by
    intro M hM
    let Q : G.toSimple.Subgraph := liftInducedSubgraph G.toSimple A M
    have hQmatch : Q.IsMatching := liftInducedSubgraph_isMatching hM.1
    have hQspan : Q.IsSpanning := by
      rw [SimpleGraph.Subgraph.isSpanning_iff,
        liftInducedSubgraph_verts hM.2]
    exact hmin.no_cubic_part
      (Pseudograph.containsRegularPart_of_isPerfectMatching
        G hmin.in_class.1 Q ⟨hQmatch, hQspan⟩)
  obtain ⟨X, hX⟩ := SimpleGraph.exists_isTutteViolator hnoMatching hevenJ
  let K := (deleteInducedSubgraph G.toSimple A X).coe
  let C := K.ConnectedComponent
  let O : Finset C := K.oddComponents.toFinset
  let D := ambientDeletionSet A X
  let shore : C → Finset (Fin n) := fun c ↦
    deletedComponentShore G.toSimple A X c
  let cut : C → ℕ := fun c ↦ G.boundaryMultiplicity (shore c)
  have hOcard : O.card = K.oddComponents.ncard := by
    exact (Set.ncard_eq_toFinset_card' K.oddComponents).symm
  have hgap : X.ncard + 2 ≤ O.card := by
    have hstrict : X.ncard < K.oddComponents.ncard := by
      simpa [SimpleGraph.IsTutteViolator, K, deleteInducedSubgraph, J]
        using hX
    have hparity : Odd O.card ↔ Odd X.ncard := by
      rw [hOcard]
      simpa [K, J, deleteInducedSubgraph] using
        (odd_ncard_oddComponents_delete_iff J hevenJ X)
    by_cases hoddX : Odd X.ncard
    · have hoddO := hparity.mpr hoddX
      rcases hoddX with ⟨a, ha⟩
      rcases hoddO with ⟨b, hb⟩
      rw [hOcard]
      omega
    · have hevenX : Even X.ncard := Nat.not_odd_iff_even.mp hoddX
      have hevenO : Even O.card := Nat.not_odd_iff_even.mp
        (fun h ↦ hoddX (hparity.mp h))
      rcases hevenX with ⟨a, ha⟩
      rcases hevenO with ⟨b, hb⟩
      rw [hOcard]
      omega
  have hOtwo : 1 < O.card := by omega
  have hDcard : D.card = X.ncard := by
    simpa [D, A] using ambientDeletionSet_card A X
  have hmaster :
      4 * D.card = 2 * G.internalMultiplicity D + ∑ c : C, cut c := by
    have hsum : (∑ c : C, cut c) = G.boundaryMultiplicity D := by
      simpa [C, K, D, shore, cut] using
        Pseudograph.sum_boundaryMultiplicity_eq_boundaryMultiplicity
          G D (Finset.univ : Finset C) shore
          (fun c _ ↦ deletedComponentShore_disjoint_ambientDeletionSet
            G.toSimple A X c)
          (fun c _ d _ hcd ↦
            deletedComponentShore_disjoint G.toSimple A X hcd)
          (fun c _ a ha b hab ↦
            deletedComponentShore_closed_pseudograph G A X c ha b hab)
          (fun v hv ↦ by
            obtain ⟨c, hc⟩ :=
              exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet
                G.toSimple A X hv
            exact ⟨c, Finset.mem_univ c, hc⟩)
    rw [hsum]
    exact G.regular_card_eq_two_internal_add_boundary hmin.in_class.1 D
  have hproper (c : C) (hcO : c ∈ O) : shore c ≠ Finset.univ := by
    obtain ⟨a, ha, b, hb, hab⟩ := Finset.one_lt_card.mp hOtwo
    obtain ⟨d, hdO, hdc⟩ : ∃ d : C, d ∈ O ∧ d ≠ c := by
      by_cases hca : c = a
      · exact ⟨b, hb, fun h ↦ hab (hca.symm.trans h.symm)⟩
      · exact ⟨a, ha, fun h ↦ hca h.symm⟩
    intro hshore
    obtain ⟨v, hvd⟩ := deletedComponentShore_nonempty G.toSimple A X d
    have hvc : v ∈ shore c := by rw [hshore]; simp
    exact (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint G.toSimple A X hdc.symm)) hvc hvd
  have hcutTwo (c : C) (hcO : c ∈ O) : 2 ≤ cut c := by
    have hnonempty : (shore c).Nonempty :=
      deletedComponentShore_nonempty G.toSimple A X c
    have hpos := boundaryMultiplicity_pos_of_underlying_connected
      G hmin.underlying_connected (shore c) hnonempty (hproper c hcO)
    have hevenCut := G.boundaryMultiplicity_even_of_even_regular
      (r := 2) (by simpa using hmin.in_class.1) (shore c)
    change 2 ≤ G.boundaryMultiplicity (shore c)
    rcases hevenCut with ⟨k, hk⟩
    omega
  have htwoCutTrivial (c : C) (hcO : c ∈ O) (hc : cut c = 2) :
      (shore c).card = 1 ∨
        Fintype.card (Fin n) - (shore c).card = 1 := by
    by_contra hcards
    push_neg at hcards
    have hSnonempty : (shore c).Nonempty := by
      simpa [shore] using deletedComponentShore_nonempty G.toSimple A X c
    have hSpos : 0 < (shore c).card := Finset.card_pos.mpr hSnonempty
    have hStwo : 2 ≤ (shore c).card := by omega
    have hcardLt : (shore c).card < Fintype.card (Fin n) := by
      exact Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr
        ⟨Finset.subset_univ _, hproper c hcO⟩)
    have hnCtwo : 2 ≤ Fintype.card (Fin n) - (shore c).card := by
      omega
    have hno := hmin.no_nontrivial_two_cut_of_no_parallel_edges hparallel
    apply hno (shore c) hStwo
    · simpa only [Finset.card_compl] using hnCtwo
    · exact hc
  have hloopOfSingletonCutTwo (v : Fin n)
      (hcutv : G.boundaryMultiplicity {v} = 2) : G.mult v v = 1 := by
    have hd := G.regular_card_eq_two_internal_add_boundary
      hmin.in_class.1 ({v} : Finset (Fin n))
    rw [G.internalMultiplicity_singleton v, hcutv] at hd
    simp only [Finset.card_singleton, Nat.mul_one] at hd
    omega
  let L : Finset C := O.filter fun c ↦ cut c = 2
  let L₁ : Finset C := L.filter fun c ↦ (shore c).card = 1
  let L₂ : Finset C := L.filter fun c ↦
    Fintype.card (Fin n) - (shore c).card = 1
  have hL₁ : L₁.card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro c hc d hd
    have hc' : (c ∈ O ∧ cut c = 2) ∧ (shore c).card = 1 := by
      simpa [L₁, L] using hc
    have hd' : (d ∈ O ∧ cut d = 2) ∧ (shore d).card = 1 := by
      simpa [L₁, L] using hd
    obtain ⟨x, hx⟩ := Finset.card_eq_one.mp hc'.2
    obtain ⟨y, hy⟩ := Finset.card_eq_one.mp hd'.2
    have hxloop : G.mult x x = 1 := hloopOfSingletonCutTwo x (by
      simpa [cut, shore, hx] using hc'.1.2)
    have hyloop : G.mult y y = 1 := hloopOfSingletonCutTwo y (by
      simpa [cut, shore, hy] using hd'.1.2)
    have hxy : x = y := by
      by_contra hxy
      have hsum := G.mult_self_add_mult_self_le_loopCount hxy
      have hcLoop := hmin.in_class.2.1
      omega
    subst y
    by_contra hcd
    have hdis := deletedComponentShore_disjoint G.toSimple A X hcd
    have hxc : x ∈ shore c := by rw [hx]; simp
    have hxd : x ∈ shore d := by rw [hy]; simp
    exact (Finset.disjoint_left.mp hdis) hxc hxd
  have hL₂ : L₂.card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro c hc d hd
    have hc' : (c ∈ O ∧ cut c = 2) ∧
        Fintype.card (Fin n) - (shore c).card = 1 := by
      simpa [L₂, L] using hc
    have hd' : (d ∈ O ∧ cut d = 2) ∧
        Fintype.card (Fin n) - (shore d).card = 1 := by
      simpa [L₂, L] using hd
    have hcComp : (shore c)ᶜ.card = 1 := by
      rw [Finset.card_compl]
      exact hc'.2
    have hdComp : (shore d)ᶜ.card = 1 := by
      rw [Finset.card_compl]
      exact hd'.2
    obtain ⟨x, hx⟩ := Finset.card_eq_one.mp hcComp
    obtain ⟨y, hy⟩ := Finset.card_eq_one.mp hdComp
    have hxrev : ({x} : Finset (Fin n))ᶜ = shore c := by
      calc
        ({x} : Finset (Fin n))ᶜ = ((shore c)ᶜ)ᶜ := by rw [hx]
        _ = shore c := by simp
    have hyrev : ({y} : Finset (Fin n))ᶜ = shore d := by
      calc
        ({y} : Finset (Fin n))ᶜ = ((shore d)ᶜ)ᶜ := by rw [hy]
        _ = shore d := by simp
    have hcutx : G.boundaryMultiplicity {x} = 2 := by
      have hb := G.boundaryMultiplicity_compl ({x} : Finset (Fin n))
      calc
        G.boundaryMultiplicity {x} = G.boundaryMultiplicity ({x} : Finset (Fin n))ᶜ :=
          hb.symm
        _ = G.boundaryMultiplicity (shore c) := by rw [hxrev]
        _ = 2 := by simpa [cut] using hc'.1.2
    have hcuty : G.boundaryMultiplicity {y} = 2 := by
      have hb := G.boundaryMultiplicity_compl ({y} : Finset (Fin n))
      calc
        G.boundaryMultiplicity {y} = G.boundaryMultiplicity ({y} : Finset (Fin n))ᶜ :=
          hb.symm
        _ = G.boundaryMultiplicity (shore d) := by rw [hyrev]
        _ = 2 := by simpa [cut] using hd'.1.2
    have hxloop := hloopOfSingletonCutTwo x hcutx
    have hyloop := hloopOfSingletonCutTwo y hcuty
    have hxy : x = y := by
      by_contra hxy
      have hsum := G.mult_self_add_mult_self_le_loopCount hxy
      have hcLoop := hmin.in_class.2.1
      omega
    subst y
    have hshoreEq : shore c = shore d := by
      apply compl_injective
      rw [hx, hy]
    by_contra hcd
    obtain ⟨z, hzc⟩ := deletedComponentShore_nonempty G.toSimple A X c
    have hzd : z ∈ shore d := hshoreEq ▸ hzc
    exact (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint G.toSimple A X hcd)) hzc hzd
  have hLsub : L ⊆ L₁ ∪ L₂ := by
    intro c hc
    have hc' : c ∈ O ∧ cut c = 2 := by simpa [L] using hc
    rcases htwoCutTrivial c hc'.1 hc'.2 with h₁ | h₂
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr ⟨hc, h₁⟩
    · apply Finset.mem_union_right
      exact Finset.mem_filter.mpr ⟨hc, h₂⟩
  have hLcard : L.card ≤ 2 := by
    have hsubcard := Finset.card_le_card hLsub
    have hunioncard := Finset.card_union_le L₁ L₂
    omega
  let R : Finset C := O.filter fun c ↦ ¬ cut c = 2
  have hLsum : 2 * L.card ≤ ∑ c ∈ L, cut c := by
    calc
      2 * L.card = ∑ _c ∈ L, 2 := by simp [Nat.mul_comm]
      _ ≤ ∑ c ∈ L, cut c := by
        apply Finset.sum_le_sum
        intro c hc
        have hc' : c ∈ O ∧ cut c = 2 := by simpa [L] using hc
        exact hcutTwo c hc'.1
  have hRsum : 4 * R.card ≤ ∑ c ∈ R, cut c := by
    calc
      4 * R.card = ∑ _c ∈ R, 4 := by simp [Nat.mul_comm]
      _ ≤ ∑ c ∈ R, cut c := by
        apply Finset.sum_le_sum
        intro c hc
        have hc' : c ∈ O ∧ ¬ cut c = 2 := by simpa [R] using hc
        have htwo := hcutTwo c hc'.1
        have hevenCut := G.boundaryMultiplicity_even_of_even_regular
          (r := 2) (by simpa using hmin.in_class.1) (shore c)
        change Even (cut c) at hevenCut
        rcases hevenCut with ⟨k, hk⟩
        omega
  have hcardSplit : L.card + R.card = O.card := by
    simpa [L, R] using
      (Finset.card_filter_add_card_filter_not (s := O)
        (p := fun c ↦ cut c = 2))
  have hsumSplit :
      (∑ c ∈ L, cut c) + (∑ c ∈ R, cut c) = ∑ c ∈ O, cut c := by
    simpa [L, R] using
      (Finset.sum_filter_add_sum_filter_not
        (s := O) (p := fun c ↦ cut c = 2) cut)
  have hlow : 2 * L.card + 4 * R.card ≤ ∑ c ∈ O, cut c := by
    rw [← hsumSplit]
    exact Nat.add_le_add hLsum hRsum
  have hOsumAll : (∑ c ∈ O, cut c) ≤ ∑ c : C, cut c :=
    Finset.sum_le_sum_of_subset (Finset.subset_univ O)
  have hupper : (∑ c : C, cut c) ≤ 4 * D.card := by omega
  omega

/-- The last possible loop in a vertex-minimal counterexample is excluded
by Tashkinov's second Tutte count.  Deleting the loop vertex and its two
neighbors would leave a cubic part whenever the remaining even graph had a
perfect matching.  A Tutte violator otherwise has at least two excess odd
components; counting their four-edge boundaries together with the
two-edge boundary of the loop vertex exceeds the incidence budget. -/
theorem IsVertexMinimalCounterexample.no_loop_edges_of_no_parallel_edges
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hparallel : ∀ u v, u ≠ v → G.mult u v ≤ 1) :
    ∀ u, G.mult u u = 0 := by
  classical
  haveI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  have hodd := hmin.odd_order_of_no_parallel_edges hparallel
  intro u
  by_contra huLoop
  have huLoopPos : 0 < G.mult u u := Nat.pos_of_ne_zero huLoop
  have huLoopEq : G.mult u u = 1 := by
    have hle := G.mult_self_le_loopCount u
    have hc := hmin.in_class.2.1
    omega
  have hrow : ∑ v ∈ (Finset.univ.erase u), G.mult u v = 2 := by
    have hd := hmin.in_class.1 u
    rw [Pseudograph.degree_eq_mult_self_add_sum] at hd
    have hsum := Finset.sum_erase_add (s := Finset.univ)
      (f := fun v ↦ G.mult u v) (Finset.mem_univ u)
    rw [huLoopEq] at hd
    rw [huLoopEq] at hsum
    omega
  let N : Finset (Fin n) :=
    (Finset.univ.erase u).filter fun v ↦ 0 < G.mult u v
  have hNcard : N.card = 2 := by
    calc
      N.card = ∑ v ∈ Finset.univ.erase u,
          if 0 < G.mult u v then 1 else 0 := by simp [N]
      _ = ∑ v ∈ Finset.univ.erase u, G.mult u v := by
        apply Finset.sum_congr rfl
        intro v hv
        have huv : u ≠ v := by
          exact fun h ↦ (Finset.mem_erase.mp hv).1 h.symm
        have hle := hparallel u v huv
        by_cases hpos : 0 < G.mult u v <;> simp [hpos] <;> omega
      _ = 2 := hrow
  obtain ⟨v₁, v₂, hv₁v₂, hN⟩ := Finset.card_eq_two.mp hNcard
  have hv₁N : v₁ ∈ N := by rw [hN]; simp
  have hv₂N : v₂ ∈ N := by rw [hN]; simp
  have huv₁ : u ≠ v₁ := by
    exact fun h ↦ (Finset.mem_erase.mp (Finset.mem_filter.mp hv₁N).1).1 h.symm
  have huv₂ : u ≠ v₂ := by
    exact fun h ↦ (Finset.mem_erase.mp (Finset.mem_filter.mp hv₂N).1).1 h.symm
  have huv₁Pos : 0 < G.mult u v₁ := (Finset.mem_filter.mp hv₁N).2
  have huv₂Pos : 0 < G.mult u v₂ := (Finset.mem_filter.mp hv₂N).2
  obtain ⟨_huLoopEq, huv₁Eq, huv₂Eq, huOther⟩ :=
    G.loop_and_two_neighbors_saturate hmin.in_class.1 huv₁ huv₂
      hv₁v₂ huLoopPos huv₁Pos huv₂Pos
  let T : Finset (Fin n) := {u, v₁, v₂}
  let S : Finset (Fin n) := Tᶜ
  have hTcard : T.card = 3 := by simp [T, huv₁, huv₂, hv₁v₂]
  have hcards : S.card + T.card = n := by
    simpa [S, Nat.card_eq_fintype_card] using Finset.card_add_card_compl T
  have hevenS : Even S.card := by
    rcases hodd with ⟨k, hk⟩
    refine ⟨k - 1, ?_⟩
    omega
  let A : Set (Fin n) := (S : Set (Fin n))
  let J : SimpleGraph A := G.toSimple.induce A
  have hevenA : Even (Nat.card A) := by
    rw [Nat.card_coe_set_eq]
    simpa [A] using hevenS
  have hcontainsOfMatching (M : J.Subgraph) (hM : M.IsPerfectMatching) :
      G.ContainsRegularPart 3 := by
    let Q : G.toSimple.Subgraph := liftInducedSubgraph G.toSimple A M
    have hQmatch : Q.IsMatching := liftInducedSubgraph_isMatching hM.1
    have hQverts : Q.verts = A := liftInducedSubgraph_verts hM.2
    let F : Pseudograph (Fin n) := G.ofUnderlyingSubgraph Q
    have hFG : F.IsPart G := G.ofUnderlyingSubgraph_isPart Q
    have hFdegree (v : Fin n) : F.degree v = if v ∈ A then 1 else 0 := by
      rw [show F = Pseudograph.ofSimple Q.spanningCoe by rfl,
        Pseudograph.degree_ofSimple,
        SimpleGraph.Subgraph.degree_spanningCoe]
      by_cases hvA : v ∈ A
      · rw [if_pos hvA]
        exact (SimpleGraph.Subgraph.isMatching_iff_forall_degree.mp hQmatch)
          v (by rw [hQverts]; exact hvA)
      · rw [if_neg hvA]
        exact Q.degree_of_notMem_verts (by rw [hQverts]; exact hvA)
    let B : Pseudograph (Fin n) := G.sdiff F
    have hBpart : B.IsPart G := G.sdiff_isPart_left F
    have hBdegree (v : Fin n) : B.degree v + F.degree v = 4 := by
      have h := G.degree_sdiff_add F hFG v
      change B.degree v + F.degree v = G.degree v at h
      rw [hmin.in_class.1 v] at h
      exact h
    have huNotA : u ∉ A := by simp [A, S, T]
    have hFdegreeU : F.degree u = 0 := by rw [hFdegree, if_neg huNotA]
    have hFvu (v : Fin n) (hvu : v ≠ u) : F.mult v u = 0 := by
      have hle : F.mult u v ≤ F.degree u :=
        Pseudograph.mult_le_degree_of_ne F hvu.symm
      rw [hFdegreeU] at hle
      rw [F.mult_comm]
      omega
    let H : Pseudograph (Fin n) := B.deleteIncidence u
    have hHG : H.IsPart G := (B.deleteIncidence_isPart u).trans hBpart
    have hHdegree (v : Fin n) : H.degree v = 0 ∨ H.degree v = 3 := by
      by_cases hvu : v = u
      · subst v
        exact .inl (B.degree_deleteIncidence_self u)
      · right
        have hdel := B.degree_deleteIncidence_add_mult_of_ne hvu
        change H.degree v + B.mult v u = B.degree v at hdel
        have hBmult : B.mult v u = G.mult v u := by
          change G.mult v u - F.mult v u = G.mult v u
          rw [hFvu v hvu, Nat.sub_zero]
        rw [hBmult] at hdel
        by_cases hvA : v ∈ A
        · have hvS : v ∈ S := hvA
          have hvv₁ : v ≠ v₁ := by
            intro h
            subst v
            simpa [A, S, T] using hvA
          have hvv₂ : v ≠ v₂ := by
            intro h
            subst v
            simpa [A, S, T] using hvA
          have huvzero : G.mult u v = 0 := huOther v hvu hvv₁ hvv₂
          have hvuzero : G.mult v u = 0 := by simpa only [G.mult_comm] using huvzero
          have hFone : F.degree v = 1 := by rw [hFdegree, if_pos hvA]
          have hB := hBdegree v
          rw [hFone] at hB
          rw [hvuzero] at hdel
          omega
        · have hvT : v ∈ T := by simpa [A, S] using hvA
          have hcases : v = v₁ ∨ v = v₂ := by
            simpa [T, hvu] using hvT
          have hvuone : G.mult v u = 1 := by
            rcases hcases with rfl | rfl
            · simpa only [G.mult_comm] using huv₁Eq
            · simpa only [G.mult_comm] using huv₂Eq
          have hFzero : F.degree v = 0 := by rw [hFdegree, if_neg hvA]
          have hB := hBdegree v
          rw [hFzero] at hB
          rw [hvuone] at hdel
          omega
    refine ⟨H, hHG, ⟨v₁, ?_⟩, hHdegree⟩
    exact (hHdegree v₁).resolve_left (by
      intro hz
      have hdel := B.degree_deleteIncidence_add_mult_of_ne huv₁.symm
      change H.degree v₁ + B.mult v₁ u = B.degree v₁ at hdel
      have hBmult : B.mult v₁ u = G.mult v₁ u := by
        change G.mult v₁ u - F.mult v₁ u = G.mult v₁ u
        rw [hFvu v₁ huv₁.symm, Nat.sub_zero]
      rw [hBmult, show G.mult v₁ u = 1 by simpa only [G.mult_comm] using huv₁Eq,
        hz] at hdel
      have hv₁NotA : v₁ ∉ A := by simp [A, S, T]
      have hFzero : F.degree v₁ = 0 := by
        rw [hFdegree, if_neg hv₁NotA]
      have hB := hBdegree v₁
      rw [hFzero] at hB
      omega)
  have hnoMatching : ∀ M : J.Subgraph, ¬ M.IsPerfectMatching := by
    intro M hM
    exact hmin.no_cubic_part (hcontainsOfMatching M hM)
  obtain ⟨X, hX⟩ := SimpleGraph.exists_isTutteViolator hnoMatching hevenA
  let K := (deleteInducedSubgraph G.toSimple A X).coe
  let C := K.ConnectedComponent
  let O : Finset C := K.oddComponents.toFinset
  let XF : Finset (Fin n) := X.toFinset.image fun x : A ↦ (x : Fin n)
  let U : Finset (Fin n) := {v₁, v₂} ∪ XF
  let shore : C → Finset (Fin n) := fun c ↦
    deletedComponentShore G.toSimple A X c
  let cut : C → ℕ := fun c ↦ G.boundaryMultiplicity (shore c)
  have hOcard : O.card = K.oddComponents.ncard :=
    (Set.ncard_eq_toFinset_card' K.oddComponents).symm
  have hgap : X.ncard + 2 ≤ O.card := by
    have hstrict : X.ncard < K.oddComponents.ncard := by
      simpa [SimpleGraph.IsTutteViolator, K, deleteInducedSubgraph, J]
        using hX
    have hparity : Odd O.card ↔ Odd X.ncard := by
      rw [hOcard]
      simpa [K, J, deleteInducedSubgraph] using
        (odd_ncard_oddComponents_delete_iff J hevenA X)
    by_cases hoddX : Odd X.ncard
    · have hoddO := hparity.mpr hoddX
      rcases hoddX with ⟨a, ha⟩
      rcases hoddO with ⟨b, hb⟩
      rw [hOcard]
      omega
    · have hevenX : Even X.ncard := Nat.not_odd_iff_even.mp hoddX
      have hevenO : Even O.card := Nat.not_odd_iff_even.mp
        (fun h ↦ hoddX (hparity.mp h))
      rcases hevenX with ⟨a, ha⟩
      rcases hevenO with ⟨b, hb⟩
      rw [hOcard]
      omega
  have hv₁NotS : v₁ ∉ S := by simp [S, T]
  have hv₂NotS : v₂ ∉ S := by simp [S, T]
  have hXFcard : XF.card = X.ncard := by
    rw [Finset.card_image_of_injective _ Subtype.val_injective]
    exact (Set.ncard_eq_toFinset_card' X).symm
  have hpairDisjoint : Disjoint ({v₁, v₂} : Finset (Fin n)) XF := by
    rw [Finset.disjoint_left]
    intro v hvpair hvXF
    obtain ⟨x, hxX, hxv⟩ := Finset.mem_image.mp hvXF
    have hxS : (x : Fin n) ∈ S := x.2
    simp only [Finset.mem_insert, Finset.mem_singleton] at hvpair
    rcases hvpair with rfl | rfl
    · exact hv₁NotS (hxv ▸ hxS)
    · exact hv₂NotS (hxv ▸ hxS)
  have hUcard : U.card = X.ncard + 2 := by
    rw [show U = ({v₁, v₂} : Finset (Fin n)) ∪ XF by rfl,
      Finset.card_union_of_disjoint hpairDisjoint, hXFcard]
    simp [hv₁v₂, Nat.add_comm]
  have huNotU : u ∉ U := by
    intro huU
    simp only [U, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton] at huU
    rcases huU with hu | huXF
    · exact hu.elim huv₁ huv₂
    · obtain ⟨x, _hxX, hxu⟩ := Finset.mem_image.mp huXF
      have hxS : (x : Fin n) ∈ S := x.2
      have huS : u ∈ S := hxu ▸ hxS
      simpa [S, T] using huS
  have hv₁U : v₁ ∈ U := by simp [U]
  have hv₂U : v₂ ∈ U := by simp [U]
  have hcutU : G.boundaryMultiplicity {u} = 2 := by
    have hd := G.regular_card_eq_two_internal_add_boundary
      hmin.in_class.1 ({u} : Finset (Fin n))
    rw [G.internalMultiplicity_singleton u, huLoopEq] at hd
    simp only [Finset.card_singleton, Nat.mul_one] at hd
    omega
  have hfour (c : C) (hcO : c ∈ O) : 4 ≤ cut c := by
    have hnonempty : (shore c).Nonempty :=
      deletedComponentShore_nonempty G.toSimple A X c
    have hproper : shore c ≠ Finset.univ := by
      intro hshore
      have hv : v₁ ∈ shore c := by rw [hshore]; simp
      have hvD : v₁ ∈ ambientDeletionSet A X := by
        exact mem_ambientDeletionSet.mpr (.inl (by simpa [A] using hv₁NotS))
      exact (Finset.disjoint_left.mp
        (deletedComponentShore_disjoint_ambientDeletionSet G.toSimple A X c))
        hv hvD
    have hpos := boundaryMultiplicity_pos_of_underlying_connected
      G hmin.underlying_connected (shore c) hnonempty hproper
    have hevenCut := G.boundaryMultiplicity_even_of_even_regular
      (r := 2) (by simpa using hmin.in_class.1) (shore c)
    by_contra hnotFour
    have hcutTwo : cut c = 2 := by
      have hlt : cut c < 4 := by omega
      change Even (cut c) at hevenCut
      change 0 < cut c at hpos
      rcases hevenCut with ⟨k, hk⟩
      omega
    have hcompTwo : 2 ≤ (shore c)ᶜ.card := by
      have hsub : ({v₁, v₂} : Finset (Fin n)) ⊆ (shore c)ᶜ := by
        intro v hv
        simp only [Finset.mem_compl]
        intro hvshore
        have hvD : v ∈ ambientDeletionSet A X := by
          simp only [Finset.mem_insert, Finset.mem_singleton] at hv
          rcases hv with rfl | rfl
          · exact mem_ambientDeletionSet.mpr (.inl (by simpa [A] using hv₁NotS))
          · exact mem_ambientDeletionSet.mpr (.inl (by simpa [A] using hv₂NotS))
        exact (Finset.disjoint_left.mp
          (deletedComponentShore_disjoint_ambientDeletionSet G.toSimple A X c))
          hvshore hvD
      have hcard := Finset.card_le_card hsub
      simpa [hv₁v₂] using hcard
    by_cases hcardOne : (shore c).card = 1
    · obtain ⟨w, hw⟩ := Finset.card_eq_one.mp hcardOne
      have hwloop : G.mult w w = 1 := by
        have hd := G.regular_card_eq_two_internal_add_boundary
          hmin.in_class.1 ({w} : Finset (Fin n))
        rw [G.internalMultiplicity_singleton w] at hd
        have hcutw : G.boundaryMultiplicity {w} = 2 := by
          simpa [cut, shore, hw] using hcutTwo
        rw [hcutw] at hd
        simp only [Finset.card_singleton, Nat.mul_one] at hd
        omega
      have hwS : w ∈ S := by
        have hwshore : w ∈ shore c := by rw [hw]; simp
        obtain ⟨z, _hzc, hzw⟩ := mem_deletedComponentShore.mp hwshore
        simpa [A] using (hzw ▸ z.1.2)
      have hwu : w ≠ u := by
        intro h
        subst w
        simpa [S, T] using hwS
      have hsum := G.mult_self_add_mult_self_le_loopCount hwu
      have hcLoop := hmin.in_class.2.1
      omega
    · have hshoreTwo : 2 ≤ (shore c).card := by
        have hp := Finset.card_pos.mpr hnonempty
        omega
      exact (hmin.no_nontrivial_two_cut_of_no_parallel_edges hparallel
        (shore c) hshoreTwo hcompTwo) hcutTwo
  let I := Option {c // c ∈ O}
  let shores : I → Finset (Fin n)
    | none => {u}
    | some c => shore c.1
  have hdisjU : ∀ i : I, Disjoint (shores i) U := by
    intro i
    cases i with
    | none => simp [shores, huNotU]
    | some c =>
        rw [Finset.disjoint_left]
        intro v hvshore hvU
        have hvD : v ∈ ambientDeletionSet A X := by
          simp only [U, Finset.mem_union, Finset.mem_insert,
            Finset.mem_singleton] at hvU
          rcases hvU with (hv₁ | hv₂) | hvXF
          · subst v
            exact mem_ambientDeletionSet.mpr (.inl (by simpa [A] using hv₁NotS))
          · subst v
            exact mem_ambientDeletionSet.mpr (.inl (by simpa [A] using hv₂NotS))
          · obtain ⟨x, hxX, hxv⟩ := Finset.mem_image.mp hvXF
            exact mem_ambientDeletionSet.mpr (.inr ⟨x, by simpa using hxX, hxv⟩)
        exact (Finset.disjoint_left.mp
          (deletedComponentShore_disjoint_ambientDeletionSet
            G.toSimple A X c.1)) hvshore hvD
  have hdisj : ∀ i : I, ∀ j : I, i ≠ j →
      Disjoint (shores i) (shores j) := by
    intro i j hij
    cases i with
    | none =>
        cases j with
        | none => exact (hij rfl).elim
        | some c =>
            rw [Finset.disjoint_left]
            intro v hvu hvshore
            simp only [shores, Finset.mem_singleton] at hvu
            subst v
            have huD : u ∈ ambientDeletionSet A X :=
              mem_ambientDeletionSet.mpr (.inl (by simp [A, S, T]))
            exact (Finset.disjoint_left.mp
              (deletedComponentShore_disjoint_ambientDeletionSet
                G.toSimple A X c.1)) hvshore huD
    | some c =>
        cases j with
        | none =>
            rw [Finset.disjoint_left]
            intro v hvshore hvu
            simp only [shores, Finset.mem_singleton] at hvu
            subst v
            have huD : u ∈ ambientDeletionSet A X :=
              mem_ambientDeletionSet.mpr (.inl (by simp [A, S, T]))
            exact (Finset.disjoint_left.mp
              (deletedComponentShore_disjoint_ambientDeletionSet
                G.toSimple A X c.1)) hvshore huD
        | some d =>
            exact deletedComponentShore_disjoint G.toSimple A X (by
              intro h
              apply hij
              exact congrArg some (Subtype.ext h))
  have hclosed : ∀ i : I, ∀ a ∈ shores i, ∀ b,
      G.mult a b ≠ 0 → b ∈ shores i ∨ b ∈ U := by
    intro i
    cases i with
    | none =>
        intro a ha b hab
        simp only [shores, Finset.mem_singleton] at ha ⊢
        subst a
        by_cases hbu : b = u
        · exact .inl hbu
        by_cases hb₁ : b = v₁
        · exact .inr (hb₁ ▸ hv₁U)
        by_cases hb₂ : b = v₂
        · exact .inr (hb₂ ▸ hv₂U)
        exact (hab (huOther b hbu hb₁ hb₂)).elim
    | some c =>
        intro a ha b hab
        rcases deletedComponentShore_closed_pseudograph G A X c.1 ha b hab with
          hbshore | hbD
        · exact .inl hbshore
        · right
          have hbu : b ≠ u := by
            intro hbu
            subst b
            have haS : a ∈ S := by
              obtain ⟨z, _hzc, hza⟩ := mem_deletedComponentShore.mp ha
              simpa [A] using (hza ▸ z.1.2)
            have hau : a ≠ u := by
              intro h
              subst a
              simpa [S, T] using haS
            have hav₁ : a ≠ v₁ := by
              intro h
              subst a
              simpa [S, T] using haS
            have hav₂ : a ≠ v₂ := by
              intro h
              subst a
              simpa [S, T] using haS
            have hzero := huOther a hau hav₁ hav₂
            rw [G.mult_comm] at hzero
            exact hab hzero
          rcases mem_ambientDeletionSet.mp hbD with hbA | ⟨x, hxX, hxb⟩
          · have hbT : b = u ∨ b = v₁ ∨ b = v₂ := by
              have hbNotS : b ∉ S := by simpa [A] using hbA
              have hbMemT : b ∈ T := by simpa [S] using hbNotS
              simpa [T] using hbMemT
            rcases hbT with rfl | rfl | rfl
            · exact (hbu rfl).elim
            · exact hv₁U
            · exact hv₂U
          · apply Finset.mem_union_right
            exact Finset.mem_image.mpr ⟨x, by simpa using hxX, hxb⟩
  have hsumUpper := G.sum_boundaryMultiplicity_le_boundaryMultiplicity
    U (Finset.univ : Finset I) shores
    (fun i _ ↦ hdisjU i)
    (fun i _ j _ hij ↦ hdisj i j hij)
    (fun i _ a ha b hab ↦ hclosed i a ha b hab)
  have hsumLower : 2 + 4 * O.card ≤
      ∑ i : I, G.boundaryMultiplicity (shores i) := by
    rw [Fintype.sum_option]
    change 2 + 4 * O.card ≤
      G.boundaryMultiplicity {u} +
        ∑ c : {c // c ∈ O}, G.boundaryMultiplicity (shore c.1)
    rw [hcutU]
    apply Nat.add_le_add_left
    calc
      4 * O.card = ∑ _c ∈ O, 4 := by simp [Nat.mul_comm]
      _ ≤ ∑ c ∈ O, cut c := by
        apply Finset.sum_le_sum
        intro c hc
        exact hfour c hc
      _ = ∑ c : {c // c ∈ O},
          G.boundaryMultiplicity (shore c.1) := by
        rw [← Finset.sum_subtype O (fun _ ↦ Iff.rfl) cut]
  have hboundaryUpper : G.boundaryMultiplicity U ≤ 4 * U.card := by
    have hd := G.regular_card_eq_two_internal_add_boundary hmin.in_class.1 U
    omega
  change (∑ i : I, G.boundaryMultiplicity (shores i)) ≤
    G.boundaryMultiplicity U at hsumUpper
  omega

/-- The preliminary part of Tashkinov's reduction is now complete: the
vertex-minimal bad pseudograph is in fact the edge-multiplicity model of an
ordinary simple graph. -/
theorem IsVertexMinimalCounterexample.hasSimpleMultiplicities
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G) :
    G.HasSimpleMultiplicities := by
  have hparallel := hmin.no_parallel_edges
  refine ⟨hmin.no_loop_edges_of_no_parallel_edges hparallel, ?_⟩
  intro u v
  by_cases huv : u = v
  · subst v
    rw [hmin.no_loop_edges_of_no_parallel_edges hparallel u]
    omega
  · exact hparallel u v huv

/-- Pseudograph version of the prescribed-edge matching theorem.  Parallel
copies are interchangeable for matching purposes, while all cut estimates
retain their true multiplicities. -/
theorem exists_isPerfectMatching_underlying_containing_pair_of_four_le_boundary
    (P : Pseudograph V) (hreg : P.IsRegularOfDegree 4)
    (heven : Even (Nat.card V))
    (hcut : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      4 ≤ P.boundaryMultiplicity S)
    {x y : V} (hxy : x ≠ y) (hpos : 0 < P.mult x y) :
    ∃ M : P.toSimple.Subgraph, M.IsPerfectMatching ∧ M.Adj x y := by
  classical
  let A : Set V := ({x, y} : Set V)ᶜ
  have hxyAdj : P.toSimple.Adj x y := ⟨hxy, hpos⟩
  have hinduced :
      ∃ M : (P.toSimple.induce A).Subgraph, M.IsPerfectMatching := by
    rw [SimpleGraph.tutte]
    intro X hX
    change X.ncard <
      (deleteInducedSubgraph P.toSimple A X).coe.oddComponents.ncard at hX
    let q := (deleteInducedSubgraph P.toSimple A X).coe.oddComponents.ncard
    let U := ambientDeletionSet A X
    have hparity : Odd q ↔ Odd X.ncard := by
      simpa [q, A] using
        (odd_ncard_oddComponents_delete_compl_pair_iff
          (G := P.toSimple) heven hxy X)
    have hgap : X.ncard + 2 ≤ q := by
      by_cases hoddX : Odd X.ncard
      · have hoddq : Odd q := hparity.mpr hoddX
        rcases hoddX with ⟨a, ha⟩
        rcases hoddq with ⟨b, hb⟩
        omega
      · have hevenX : Even X.ncard := Nat.not_odd_iff_even.mp hoddX
        have hevenq : Even q := Nat.not_odd_iff_even.mp (fun hoddq ↦
          hoddX (hparity.mp hoddq))
        rcases hevenX with ⟨a, ha⟩
        rcases hevenq with ⟨b, hb⟩
        omega
    have hxU : x ∈ U := by
      apply mem_ambientDeletionSet.mpr
      left
      simp [A]
    have hyU : y ∈ U := by
      apply mem_ambientDeletionSet.mpr
      left
      simp [A]
    have hinternal : 0 < P.internalMultiplicity U :=
      pseudograph_internalMultiplicity_pos_of_mult_pos P U hpos hxU hyU
    have hfour : ∀ c : (deleteInducedSubgraph P.toSimple A X).coe.oddComponents,
        4 ≤ P.boundaryMultiplicity
          (deletedComponentShore P.toSimple A X c.1) := by
      intro c
      apply hcut
      · exact deletedComponentShore_nonempty P.toSimple A X c.1
      · intro hshore
        have hxshore : x ∈ deletedComponentShore P.toSimple A X c.1 := by
          rw [hshore]
          simp
        exact (Finset.disjoint_left.mp
          (deletedComponentShore_disjoint_ambientDeletionSet
            P.toSimple A X c.1)) hxshore hxU
    let O := (deleteInducedSubgraph P.toSimple A X).coe.oddComponents
    let I : Finset O := Finset.univ
    let shore : O → Finset V := fun c ↦
      deletedComponentShore P.toSimple A X c.1
    have hledger := P.card_lt_of_four_le_boundaryMultiplicity hreg U I shore
      (fun c _ ↦ deletedComponentShore_disjoint_ambientDeletionSet
        P.toSimple A X c.1)
      (fun c _ d _ hcd ↦ by
        apply deletedComponentShore_disjoint P.toSimple A X
        intro h
        apply hcd
        exact Subtype.ext h)
      (fun c _ a ha b hab ↦
        deletedComponentShore_closed_pseudograph P A X c.1 ha b hab)
      (fun c _ ↦ hfour c) hinternal
    have hUcard : U.card = X.ncard + 2 := by
      simpa [U, A] using ambientDeletionSet_compl_pair_card hxy X
    change Fintype.card O < U.card at hledger
    rw [Set.fintypeCard_eq_ncard] at hledger
    change q < U.card at hledger
    omega
  obtain ⟨M, hM⟩ := hinduced
  simpa [A] using
    exists_isPerfectMatching_of_compl_pair P.toSimple hxyAdj M hM

/-- Even-order quartic pseudographs with no cut below four have a cubic
part. -/
theorem containsRegularPart_of_even_of_four_le_boundary
    [Nonempty V] (P : Pseudograph V) (hreg : P.IsRegularOfDegree 4)
    (hloopless : ∀ v, P.mult v v = 0)
    (heven : Even (Nat.card V))
    (hcut : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      4 ≤ P.boundaryMultiplicity S) :
    P.ContainsRegularPart 3 := by
  let u : V := Classical.choice inferInstance
  have hdegree : 0 < P.degree u := by rw [hreg u]; omega
  have hexists : ∃ v : V, u ≠ v ∧ 0 < P.mult u v := by
    classical
    rw [Pseudograph.degree_eq_mult_self_add_sum] at hdegree
    rw [hloopless u, Nat.zero_add] at hdegree
    obtain ⟨v, _hv, hvpos⟩ := Finset.sum_pos_iff.mp hdegree
    have huv : u ≠ v := by
      intro huv
      subst v
      rw [hloopless u] at hvpos
      omega
    exact ⟨v, huv, Nat.zero_lt_of_lt hvpos⟩
  obtain ⟨v, huv, huvpos⟩ := hexists
  obtain ⟨M, hM, _⟩ :=
    exists_isPerfectMatching_underlying_containing_pair_of_four_le_boundary
      P hreg heven hcut huv huvpos
  exact Pseudograph.containsRegularPart_of_isPerfectMatching P hreg M hM

theorem IsVertexMinimalCounterexample.odd_order_of_hasSimpleMultiplicities
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities) : Odd n := by
  haveI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  have hconn := hmin.underlying_connected
  have hno2 := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple
  by_contra hnot
  have heven : Even n := Nat.not_odd_iff_even.mp hnot
  have hfour : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      4 ≤ G.boundaryMultiplicity S := by
    exact fun S hS hproper ↦
      four_le_boundaryMultiplicity_of_underlying_connected_of_ne_two
        G hmin.in_class.1 hconn hno2 S hS hproper
  exact hmin.no_cubic_part
    (containsRegularPart_of_even_of_four_le_boundary
      G hmin.in_class.1 hsimple.1 (by simpa using heven) hfour)

/-- Proposition 3.3 of Tashkinov for a minimal counterexample with simple
multiplicities: every four-edge cut has a singleton shore.  The odd shore is
closed by a four-star, prescribed-edge perfect matchings give all four
possible omitted-edge cubic parts, and a smaller closure of the even shore
supplies the part to splice against them. -/
theorem IsVertexMinimalCounterexample.only_trivial_four_cuts_of_hasSimpleMultiplicities
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities) :
    ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      G.boundaryMultiplicity S = 4 → S.card = 1 ∨ Sᶜ.card = 1 := by
  letI : DecidableEq (Fin n) := Classical.decEq _
  have hreg := hmin.in_class.1
  have hconn := hmin.underlying_connected
  have hno2 := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple
  have hfour : ∀ A : Finset (Fin n), A.Nonempty → A ≠ Finset.univ →
      4 ≤ G.boundaryMultiplicity A :=
    fun A hA hAproper ↦
      four_le_boundaryMultiplicity_of_underlying_connected_of_ne_two
        G hreg hconn hno2 A hA hAproper
  have hoddn : Odd n := hmin.odd_order_of_hasSimpleMultiplicities hsimple
  intro S hS hSproper hcut
  by_cases hScard : S.card = 1
  · exact .inl hScard
  by_cases hCcard : Sᶜ.card = 1
  · right
    rw [← hCcard]
    apply congrArg Finset.card
    ext v
    simp
  exfalso
  have hC : Sᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hCempty
    exact hSproper ((Finset.compl_eq_empty_iff S).mp hCempty)
  have hStwo : 2 ≤ S.card := by
    have hpos := Finset.card_pos.mpr hS
    omega
  have hCtwo : 2 ≤ Sᶜ.card := by
    have hpos := Finset.card_pos.mpr hC
    omega
  have hcontr (R : Finset (Fin n))
      (hcutR : G.boundaryMultiplicity R = 4)
      (hRodd : Odd R.card) (hRtwo : 2 ≤ R.card)
      (hRCtwo : 2 ≤ Rᶜ.card) : False := by
    let E : Fin 4 ≃ G.CrossingEdge R := (G.cutEquiv R hcutR).symm
    let Q : Pseudograph (Option R) := G.closeFourCutStarWith R E
    have hQreg : Q.IsRegularOfDegree 4 :=
      G.closeFourCutStarWith_isRegularOfDegree R E hreg
    have hQeven : Even (Nat.card (Option R)) := by
      rw [Nat.card_eq_fintype_card, Fintype.card_option, Fintype.card_coe]
      exact hRodd.add_one
    have hQfour : ∀ T : Finset (Option R), T.Nonempty →
        T ≠ Finset.univ → 4 ≤ Q.boundaryMultiplicity T := by
      intro T hT hTproper
      exact G.four_le_boundaryMultiplicity_closeFourCutStarWith
        hreg hfour R E T hT hTproper
    have hparts : ∀ i : Fin 4, ∃ H : Pseudograph (Option R),
        H.IsPart (G.closeFourCutStar R hcutR) ∧
        (∃ v, H.degree v = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        Pseudograph.StarOmitsExactly (G.cutEquiv R hcutR).symm H i := by
      intro i
      have hlist : 0 < G.listingEndpointCount R E (E i).inside := by
        unfold Pseudograph.listingEndpointCount
        apply Finset.sum_pos_iff.mpr
        refine ⟨i, Finset.mem_univ _, ?_⟩
        simp
      have hpos : 0 < Q.mult none
          (some ⟨(E i).inside, (E i).inside_mem⟩) := by
        simpa [Q] using hlist
      obtain ⟨M, hM, hMi⟩ :=
        exists_isPerfectMatching_underlying_containing_pair_of_four_le_boundary
          Q hQreg hQeven hQfour (by simp) hpos
      obtain ⟨H, hHpart, hHne, hHdeg, hHomit⟩ :=
        G.exists_cubicStarPart_omitting_of_isPerfectMatching
          hreg R E i M hM hMi
      refine ⟨H, ?_, hHne, hHdeg, ?_⟩
      · simpa [Q, E, Pseudograph.closeFourCutStar] using hHpart
      · simpa [E] using hHomit
    let EC : Fin 4 ≃ G.CrossingEdge Rᶜ :=
      G.reversedFourCutListing R hcutR
    let QC : Pseudograph (Option ↑(Rᶜ)) :=
      G.closeFourCutStarWith Rᶜ EC
    have hQCclass : QC.InTashkinovClass := by
      exact G.closeFourCutStarWith_inTashkinovClass_of_hasSimpleMultiplicities
        hreg hsimple Rᶜ EC
    have hcardsum : R.card + Rᶜ.card = n := by
      simpa using Finset.card_add_card_compl R
    have hQCcard : Fintype.card (Option ↑(Rᶜ)) < n := by
      rw [Fintype.card_option, Fintype.card_coe]
      omega
    have hQCpart : QC.ContainsRegularPart 3 :=
      hmin.contains_of_card_lt QC hQCclass hQCcard
    have hspliced : G.ContainsRegularPart 3 :=
      G.containsRegularPart_of_fourCutStarClosures R hcutR hparts (by
        simpa [QC, EC] using hQCpart)
    exact hmin.no_cubic_part hspliced
  by_cases hSodd : Odd S.card
  · exact hcontr S hcut hSodd hStwo hCtwo
  · have hcardsum : S.card + Sᶜ.card = n := by
      simpa using Finset.card_add_card_compl S
    have hsumodd : Odd (S.card + Sᶜ.card) := by
      simpa [hcardsum] using hoddn
    have hCevenNot : ¬ Even Sᶜ.card := by
      intro hCeven
      have hSeven : Even S.card := Nat.not_odd_iff_even.mp hSodd
      exact (Nat.not_odd_iff_even.mpr (hSeven.add hCeven)) hsumodd
    have hCodd : Odd Sᶜ.card := Nat.not_even_iff_odd.mp hCevenNot
    let hcutC : G.boundaryMultiplicity Sᶜ = 4 :=
      (G.boundaryMultiplicity_compl S).trans hcut
    apply hcontr Sᶜ hcutC hCodd hCtwo
    simpa using hStwo

/-- Deleting a perfect matching from a quartic graph gives a spanning cubic
subgraph. -/
theorem containsThreeRegular_of_isPerfectMatching [Nonempty V]
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (M : G.Subgraph) (hM : M.IsPerfectMatching) :
    ContainsRegularSubgraph G 3 := by
  classical
  let K : SimpleGraph V := G \ M.spanningCoe
  have hKG : K ≤ G := sdiff_le
  let H : G.Subgraph := G.toSubgraph K hKG
  refine ⟨H, ⟨Classical.choice inferInstance, by simp [H]⟩, ?_⟩
  intro v
  rw [← Set.fintypeCard_eq_ncard, SimpleGraph.card_neighborSet_eq_degree]
  rw [SimpleGraph.Subgraph.coe_degree]
  change (G.toSubgraph K hKG).degree (v : V) = 3
  rw [SimpleGraph.degree_toSubgraph]
  rw [SimpleGraph.degree, SimpleGraph.neighborFinset_sdiff,
    Finset.card_sdiff_of_subset]
  · change G.degree v - M.spanningCoe.degree v = 3
    rw [hreg v, SimpleGraph.Subgraph.degree_spanningCoe]
    have hMdegree :=
      (SimpleGraph.Subgraph.isPerfectMatching_iff_forall_degree.mp hM) v
    omega
  · intro w hw
    simpa only [SimpleGraph.mem_neighborFinset] using M.spanningCoe_le
      (by simpa only [SimpleGraph.mem_neighborFinset] using hw)

/-- The even-order, no-small-cut case of the main theorem. -/
theorem containsThreeRegular_of_even_of_four_le_boundary [Nonempty V]
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (heven : Even (Nat.card V))
    (hcut : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S) :
    ContainsRegularSubgraph G 3 := by
  let u : V := Classical.choice inferInstance
  obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
  obtain ⟨M, hM, _⟩ :=
    exists_isPerfectMatching_containing_edge_of_four_le_boundary
      G hreg heven hcut huv
  exact containsThreeRegular_of_isPerfectMatching G hreg M hM

/-- The even-order connected case in the customary edge-connectivity form:
there is no proper shore whose boundary consists of exactly two edges. -/
theorem containsThreeRegular_of_even_of_connected_of_no_two_cut
    [Nonempty V] (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (heven : Even (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2) :
    ContainsRegularSubgraph G 3 := by
  apply containsThreeRegular_of_even_of_four_le_boundary G hreg heven
  exact fun S hS hproper ↦
    four_le_boundaryMultiplicity_of_connected_of_ne_two
      G hreg hconn hno2 S hS hproper

/-- A literal regular subgraph of an induced graph lifts to the ambient
graph. -/
lemma containsRegularSubgraph_of_induce (G : SimpleGraph V) (A : Set V)
    {k : ℕ} (h : ContainsRegularSubgraph (G.induce A) k) :
    ContainsRegularSubgraph G k := by
  classical
  obtain ⟨H, hHne, hHreg⟩ := h
  let f : SimpleGraph.Copy (G.induce A) G :=
    ⟨(SimpleGraph.Embedding.induce A).toHom,
      (SimpleGraph.Embedding.induce (G := G) A).injective⟩
  let L : G.Subgraph := H.map f.toHom
  let e : H.coe ≃g L.coe := f.isoSubgraphMap H
  refine ⟨L, ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hHne
    exact ⟨f v, Set.mem_image_of_mem f hv⟩
  · intro v
    obtain ⟨x, hx, hxv⟩ := v.2
    let xH : H.verts := ⟨x, hx⟩
    have hev : e xH = v := by
      apply Subtype.ext
      exact hxv
    rw [← hev, ← Set.ncard_congr' (e.mapNeighborSet xH)]
    exact hHreg xH

/-- It is enough to prove the theorem for one connected component: regularity
is inherited by components, and an arbitrary regular subgraph of that
component lifts to the original graph. -/
lemma containsThreeRegular_of_connected_component
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (c : G.ConnectedComponent)
    (hcomponent : ContainsRegularSubgraph c.toSimpleGraph 3) :
    ContainsRegularSubgraph G 3 := by
  simpa [SimpleGraph.ConnectedComponent.toSimpleGraph] using
    containsRegularSubgraph_of_induce G c.supp hcomponent

lemma connectedComponent_isRegularOfDegree
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (c : G.ConnectedComponent) :
    c.toSimpleGraph.IsRegularOfDegree 4 := by
  intro v
  let e : c.toSimpleGraph.neighborSet v ≃ G.neighborSet (v : V) := {
    toFun w := ⟨((w.1 : c) : V), by
      exact (SimpleGraph.ConnectedComponent.toSimpleGraph_adj c v.2 w.1.2).mp w.2⟩
    invFun w := ⟨⟨w.1, c.mem_supp_of_adj_mem_supp v.2 w.2⟩, by
      exact (SimpleGraph.ConnectedComponent.toSimpleGraph_adj c
        v.2 (c.mem_supp_of_adj_mem_supp v.2 w.2)).mpr w.2⟩
    left_inv w := by
      apply Subtype.ext
      apply Subtype.ext
      rfl
    right_inv w := by
      apply Subtype.ext
      rfl }
  calc
    c.toSimpleGraph.degree v = Fintype.card (c.toSimpleGraph.neighborSet v) :=
      (SimpleGraph.card_neighborSet_eq_degree _ _).symm
    _ = Fintype.card (G.neighborSet (v : V)) := Fintype.card_congr e
    _ = G.degree (v : V) := SimpleGraph.card_neighborSet_eq_degree _ _
    _ = 4 := hreg v

/-- The vertices outside the closed neighborhood of `u`. -/
def antiNeighborhood (G : SimpleGraph V) (u : V) : Set V :=
  {v | v ≠ u ∧ ¬ G.Adj u v}

@[simp]
lemma mem_antiNeighborhood {G : SimpleGraph V} {u v : V} :
    v ∈ antiNeighborhood G u ↔ v ≠ u ∧ ¬ G.Adj u v :=
  Iff.rfl

lemma antiNeighborhood_eq_compl_insert_neighborSet (G : SimpleGraph V) (u : V) :
    antiNeighborhood G u = (insert u (G.neighborSet u))ᶜ := by
  ext v
  simp [antiNeighborhood]

/-- A quartic vertex has a five-element closed neighborhood. -/
lemma ncard_insert_neighborSet_of_quartic (G : SimpleGraph V)
    (hreg : G.IsRegularOfDegree 4) (u : V) :
    (insert u (G.neighborSet u)).ncard = 5 := by
  rw [Set.ncard_insert_of_notMem G.notMem_neighborSet_self]
  rw [← Set.fintypeCard_eq_ncard, SimpleGraph.card_neighborSet_eq_degree, hreg u]

/-- In an odd-order quartic graph, deleting a closed neighborhood leaves an
even number of vertices. -/
lemma even_natCard_antiNeighborhood_of_odd_quartic
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (u : V) :
    Even (Nat.card (antiNeighborhood G u)) := by
  have hclosed := ncard_insert_neighborSet_of_quartic G hreg u
  have hsum := Set.ncard_add_ncard_compl
    (insert u (G.neighborSet u) : Set V)
  rw [← antiNeighborhood_eq_compl_insert_neighborSet G u] at hsum
  rw [Nat.card_coe_set_eq]
  rcases hodd with ⟨k, hk⟩
  rw [hclosed] at hsum
  use k - 2
  omega

lemma ambientDeletionSet_antiNeighborhood_card
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4) (u : V)
    (X : Set (antiNeighborhood G u)) :
    (ambientDeletionSet (antiNeighborhood G u) X).card = X.ncard + 5 := by
  rw [ambientDeletionSet_card]
  have hclosed := ncard_insert_neighborSet_of_quartic G hreg u
  have hcomp : (antiNeighborhood G u)ᶜ = insert u (G.neighborSet u) := by
    rw [antiNeighborhood_eq_compl_insert_neighborSet]
    simp
  rw [hcomp, hclosed]
  omega

/-- An odd component left after deleting `N[u] ∪ X` cannot be either
shore of a trivial six-cut: its own order is odd, while its complement
contains the whole deletion set, which has at least five vertices. -/
lemma false_of_six_cut_deleted_odd_component
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno6 : HasOnlyTrivialSixCuts G) (u : V)
    (X : Set (antiNeighborhood G u))
    (c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent)
    (hcodd : c ∈
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents)
    (hcut : (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c) = 6) : False := by
  classical
  let S := deletedComponentShore G (antiNeighborhood G u) X c
  let D := ambientDeletionSet (antiNeighborhood G u) X
  have hSodd : Odd S.card := by
    change Odd c.supp.ncard at hcodd
    simpa [S, card_deletedComponentShore G (antiNeighborhood G u) X c] using hcodd
  have hS_ne_two : S.card ≠ 2 := by
    rintro htwo
    rcases hSodd with ⟨k, hk⟩
    omega
  have hDsub : D ⊆ Sᶜ := by
    intro x hxD
    simp only [Finset.mem_compl]
    intro hxS
    exact (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet
        G (antiNeighborhood G u) X c)) hxS hxD
  have hDcard : 5 ≤ D.card := by
    have hcard := ambientDeletionSet_antiNeighborhood_card G hreg u X
    change D.card = X.ncard + 5 at hcard
    omega
  have hcomp_ne_two : Sᶜ.card ≠ 2 := by
    have hle := Finset.card_le_card hDsub
    omega
  rcases hno6 S hcut with htwo | htwo
  · exact hS_ne_two htwo
  · exact hcomp_ne_two htwo

/-- The middle part of the barrier arising from a Tutte set outside `N[u]`:
the four neighbours of `u`, together with the lifted Tutte set. -/
noncomputable def barrierMiddle (G : SimpleGraph V) (u : V)
    (X : Set (antiNeighborhood G u)) : Finset V :=
  G.neighborFinset u ∪ X.toFinset.image
    (fun x : antiNeighborhood G u ↦ (x : V))

@[simp]
lemma mem_barrierMiddle {G : SimpleGraph V} {u v : V}
    {X : Set (antiNeighborhood G u)} :
    v ∈ barrierMiddle G u X ↔
      G.Adj u v ∨ ∃ x : antiNeighborhood G u, x ∈ X ∧ (x : V) = v := by
  classical
  simp [barrierMiddle]

lemma notMem_barrierMiddle_self (G : SimpleGraph V) (u : V)
    (X : Set (antiNeighborhood G u)) :
    u ∉ barrierMiddle G u X := by
  simp only [mem_barrierMiddle]
  rintro (huu | ⟨x, _hx, hx⟩)
  · exact huu.ne rfl
  · exact x.2.1 hx

/-- The ambient deletion set used in the ledger is the disjoint union of
`u` and the barrier middle. -/
lemma ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle
    (G : SimpleGraph V) (u : V) (X : Set (antiNeighborhood G u)) :
    ambientDeletionSet (antiNeighborhood G u) X =
      insert u (barrierMiddle G u X) := by
  classical
  ext v
  simp only [mem_ambientDeletionSet, Finset.mem_insert, mem_barrierMiddle]
  constructor
  · rintro (hvA | ⟨x, hxX, hxv⟩)
    · by_cases hvu : v = u
      · exact .inl hvu
      · exact .inr (.inl (Classical.byContradiction fun hn ↦
          hvA ⟨hvu, hn⟩))
    · exact .inr (.inr ⟨x, hxX, hxv⟩)
  · rintro (rfl | huv | ⟨x, hxX, hxv⟩)
    · exact .inl (by simp [antiNeighborhood])
    · exact .inl (fun huA ↦ huA.2 huv)
    · exact .inr ⟨x, hxX, hxv⟩

/-- Adding a vertex to a shore which already contains all of its neighbours
adds exactly its degree to the internal-edge count.  The graph is simple, so
there is no loop correction. -/
lemma internalMultiplicity_insert_of_neighborFinset_subset
    (G : SimpleGraph V) (u : V) (S : Finset V) (hu : u ∉ S)
    (hneighbors : G.neighborFinset u ⊆ S) :
    (Pseudograph.ofSimple G).internalMultiplicity (insert u S) =
      G.degree u + (Pseudograph.ofSimple G).internalMultiplicity S := by
  classical
  rw [← Pseudograph.degree_ofSimple G u,
    ← Pseudograph.incidenceSum_singleton (Pseudograph.ofSimple G) u]
  unfold Pseudograph.internalMultiplicity Pseudograph.incidenceSum
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  induction e using Sym2.inductionOn with
  | _ a b =>
      have hleft (hab : G.Adj u b) : b ∈ S :=
        hneighbors (by simpa only [SimpleGraph.mem_neighborFinset] using hab)
      have hright (hab : G.Adj a u) : a ∈ S :=
        hneighbors (by
          simpa only [SimpleGraph.mem_neighborFinset, G.adj_comm] using hab)
      simp only [Pseudograph.edgeMultiplicity_mk,
        Pseudograph.internalIndicator_mk, Pseudograph.incidencesIn_mk,
        Finset.mem_insert, Finset.mem_singleton]
      by_cases hau : a = u <;> by_cases hbu : b = u <;>
        by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases hab : G.Adj a b
      all_goals simp [Pseudograph.ofSimple_mult, hau, hbu, haS, hbS, hab,
        hu] at *
      all_goals assumption

/-- In the anti-neighbourhood ledger, the internal edges in the ambient
deletion set are exactly the four edges at `u` plus the edges internal to the
barrier middle. -/
lemma internalMultiplicity_ambientDeletionSet_antiNeighborhood
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4) (u : V)
    (X : Set (antiNeighborhood G u)) :
    (Pseudograph.ofSimple G).internalMultiplicity
        (ambientDeletionSet (antiNeighborhood G u) X) =
      4 + (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) := by
  rw [ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle]
  rw [internalMultiplicity_insert_of_neighborFinset_subset G u
    (barrierMiddle G u X) (notMem_barrierMiddle_self G u X)]
  · rw [hreg u]
  · exact fun v hv ↦ by
      apply mem_barrierMiddle.mpr
      exact .inl (by simpa only [SimpleGraph.mem_neighborFinset] using hv)

/-- The four edges at `u` are all internal to the ambient deletion set
`N[u] ∪ X`.  Thus its internal-edge multiplicity is at least four. -/
lemma four_le_internalMultiplicity_ambientDeletionSet_antiNeighborhood
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4) (u : V)
    (X : Set (antiNeighborhood G u)) :
    4 ≤ (Pseudograph.ofSimple G).internalMultiplicity
      (ambientDeletionSet (antiNeighborhood G u) X) := by
  classical
  let D := ambientDeletionSet (antiNeighborhood G u) X
  let f : G.neighborFinset u ↪ Sym2 V :=
    { toFun := fun w ↦ s(u, (w : V))
      inj' := by
        intro a b hab
        apply Subtype.ext
        exact Sym2.congr_right.mp hab }
  let E : Finset (Sym2 V) := Finset.univ.map f
  have huD : u ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    simp [antiNeighborhood]
  have hwD (w : G.neighborFinset u) : (w : V) ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    exact fun hw ↦ hw.2 (by
      simpa only [SimpleGraph.mem_neighborFinset] using w.2)
  have hterm (w : G.neighborFinset u) :
      (Pseudograph.ofSimple G).edgeMultiplicity s(u, (w : V)) *
          Pseudograph.internalIndicator D s(u, (w : V)) = 1 := by
    have huw : G.Adj u (w : V) := by
      simpa only [SimpleGraph.mem_neighborFinset] using w.2
    simp [Pseudograph.edgeMultiplicity_mk, Pseudograph.ofSimple_mult,
      huw, huD, hwD w]
  have hsum :
      (∑ e ∈ E,
        (Pseudograph.ofSimple G).edgeMultiplicity e *
          Pseudograph.internalIndicator D e) = 4 := by
    calc
      (∑ e ∈ E,
          (Pseudograph.ofSimple G).edgeMultiplicity e *
            Pseudograph.internalIndicator D e) =
          ∑ w : G.neighborFinset u,
            (Pseudograph.ofSimple G).edgeMultiplicity (f w) *
              Pseudograph.internalIndicator D (f w) := by
                simp [E]
      _ = ∑ _w : G.neighborFinset u, 1 := by
        apply Finset.sum_congr rfl
        intro w _
        change
          (Pseudograph.ofSimple G).edgeMultiplicity s(u, (w : V)) *
              Pseudograph.internalIndicator D s(u, (w : V)) = 1
        exact hterm w
      _ = 4 := by
        simp [SimpleGraph.card_neighborFinset_eq_degree, hreg u]
  rw [← hsum]
  unfold Pseudograph.internalMultiplicity
  exact Finset.sum_le_sum_of_subset_of_nonneg (by simp [E])
    (fun _ _ _ ↦ Nat.zero_le _)

/-- Under the small-cut conclusions used in Tashkinov's minimal
counterexample, an even component left by a deletion has boundary at least
six.  A boundary of four would have a singleton shore; the component shore
cannot be a singleton by parity, while its complement contains `u` and one
of the four neighbours of `u`. -/
lemma six_le_boundaryMultiplicity_deletedComponentShore_of_even
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V) (X : Set (antiNeighborhood G u))
    (c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent)
    (hcEven : c ∉
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents) :
    6 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c) := by
  classical
  let A := antiNeighborhood G u
  let S := deletedComponentShore G A X c
  let D := ambientDeletionSet A X
  have hSnonempty : S.Nonempty := by
    simpa [A, S] using deletedComponentShore_nonempty G A X c
  have huD : u ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    simp [A, antiNeighborhood]
  have huSnot : u ∉ S := fun huS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) huS huD
  have hSproper : S ≠ Finset.univ := by
    intro hS
    exact huSnot (by rw [hS]; simp)
  have hfourLower : 4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S :=
    four_le_boundaryMultiplicity_of_connected_of_ne_two
      G hreg hconn hno2 S hSnonempty hSproper
  have hSeven : Even S.card := by
    have hcNotOdd : ¬ Odd c.supp.ncard := by
      change ¬ Odd c.supp.ncard at hcEven
      exact hcEven
    have hcEven' : Even c.supp.ncard := Nat.not_odd_iff_even.mp hcNotOdd
    simpa [S, card_deletedComponentShore G A X c] using hcEven'
  have hScard_ne_one : S.card ≠ 1 := by
    intro hcard
    rcases hSeven with ⟨k, hk⟩
    omega
  obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
  have hvD : v ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    exact fun hvA ↦ hvA.2 huv
  have hvSnot : v ∉ S := fun hvS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) hvS hvD
  have hucompl : u ∈ Sᶜ := by simp [huSnot]
  have hvcompl : v ∈ Sᶜ := by simp [hvSnot]
  have hcompcard_ne_one : Sᶜ.card ≠ 1 := by
    intro hcard
    have huvne : u ≠ v := huv.ne
    have hsubset : ({u, v} : Finset V) ⊆ Sᶜ := by
      intro w hw
      simp only [Finset.mem_insert, Finset.mem_singleton] at hw
      rcases hw with rfl | rfl
      · exact hucompl
      · exact hvcompl
    have htwo : 2 ≤ Sᶜ.card := by
      have := Finset.card_le_card hsubset
      simpa [huvne] using this
    omega
  by_contra hsix
  have hsix' : ¬ 6 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
    simpa [A, S] using hsix
  have hcutEven : Even ((Pseudograph.ofSimple G).boundaryMultiplicity S) :=
    Pseudograph.boundaryMultiplicity_even_of_even_regular
      (Pseudograph.ofSimple G) (r := 2)
      (by simpa using
        ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
  have heq : (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 := by
    rcases hcutEven with ⟨k, hk⟩
    dsimp only [S, A] at hfourLower hsix' hk ⊢
    omega
  rcases hno4 S hSnonempty hSproper heq with hcard | hcard
  · exact hScard_ne_one hcard
  · exact hcompcard_ne_one hcard

/-- If the graph outside `N[u]` has no perfect matching, Tutte supplies a
violator with a parity-strengthened gap of at least two. -/
lemma exists_antiNeighborhood_tutte_gap_of_no_perfectMatching
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    ∃ X : Set (antiNeighborhood G u),
      X.ncard + 2 ≤
        (((⊤ : (G.induce (antiNeighborhood G u)).Subgraph).deleteVerts X).coe.oddComponents.ncard) := by
  classical
  let J := G.induce (antiNeighborhood G u)
  have hno' : ∀ M : J.Subgraph, ¬ M.IsPerfectMatching := by
    intro M hM
    exact hno ⟨M, hM⟩
  have hAeven : Even (Nat.card (antiNeighborhood G u)) :=
    even_natCard_antiNeighborhood_of_odd_quartic G hreg hodd u
  obtain ⟨X, hX⟩ := SimpleGraph.exists_isTutteViolator hno' hAeven
  refine ⟨X, ?_⟩
  let q := ((⊤ : J.Subgraph).deleteVerts X).coe.oddComponents.ncard
  have hlt : X.ncard < q := by
    simpa [SimpleGraph.IsTutteViolator, J, q] using hX
  have hparity : Odd q ↔ Odd X.ncard := by
    simpa [J, q] using odd_ncard_oddComponents_delete_iff J hAeven X
  by_cases hoddX : Odd X.ncard
  · have hoddq := hparity.mpr hoddX
    rcases hoddX with ⟨a, ha⟩
    rcases hoddq with ⟨b, hb⟩
    omega
  · have hevenX : Even X.ncard := Nat.not_odd_iff_even.mp hoddX
    have hevenq : Even q := Nat.not_odd_iff_even.mp (fun hq ↦ hoddX (hparity.mp hq))
    rcases hevenX with ⟨a, ha⟩
    rcases hevenq with ⟨b, hb⟩
    omega

/-- The numerical heart of the barrier trichotomy.  If odd components of
`G - (N[u] ∪ X)` have cut at least four and even components have cut at
least six, a parity-sharp Tutte witness has exactly `|X|+2` odd components,
no even components, and between four and six internal edges in `N[u] ∪ X`.

The four forced internal edges are the star at `u`; the remaining zero, one,
or two edges are precisely the three deficiency cases used later. -/
lemma antiNeighborhood_tutte_numeric_ledger
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (u : V)
    (X : Set (antiNeighborhood G u))
    (hgap : X.ncard + 2 ≤
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents.ncard)
    (hoddCut : ∀ c :
        (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents →
      4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c))
    (hevenCut : ∀ c :
        (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∉ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents →
      6 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c)) :
    (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents.ncard =
        X.ncard + 2 ∧
      (∀ c :
          (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
        c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents) ∧
      4 ≤ (Pseudograph.ofSimple G).internalMultiplicity
        (ambientDeletionSet (antiNeighborhood G u) X) ∧
      (Pseudograph.ofSimple G).internalMultiplicity
        (ambientDeletionSet (antiNeighborhood G u) X) ≤ 6 := by
  classical
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let C := J.ConnectedComponent
  let O : Finset C := J.oddComponents.toFinset
  let E : Finset C := Finset.univ.filter fun c ↦ c ∉ J.oddComponents
  let D := ambientDeletionSet A X
  let m := (Pseudograph.ofSimple G).internalMultiplicity D
  let cut : C → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  have hOcard : O.card = J.oddComponents.ncard := by
    exact (Set.ncard_eq_toFinset_card' J.oddComponents).symm
  have hparity : Odd O.card ↔ Odd X.ncard := by
    rw [hOcard]
    simpa [A, J, deleteInducedSubgraph] using
      (odd_ncard_oddComponents_delete_iff (G.induce A)
        (even_natCard_antiNeighborhood_of_odd_quartic G hreg hodd u) X)
  have hDcard : D.card = X.ncard + 5 := by
    simpa [A, D] using ambientDeletionSet_antiNeighborhood_card G hreg u X
  have hmLower : 4 ≤ m := by
    simpa [A, D, m] using
      four_le_internalMultiplicity_ambientDeletionSet_antiNeighborhood G hreg u X
  have hmaster : 4 * D.card = 2 * m + ∑ c : C, cut c := by
    simpa [A, J, C, D, m, cut] using
      quartic_deletion_master_count G hreg A X
  have hOddSum : 4 * O.card ≤ ∑ c ∈ O, cut c := by
    calc
      4 * O.card = ∑ _c ∈ O, 4 := by simp [Nat.mul_comm]
      _ ≤ ∑ c ∈ O, cut c := by
        apply Finset.sum_le_sum
        intro c hc
        apply hoddCut
        simpa [A, J, C, O] using hc
  have hEvenSum : 6 * E.card ≤ ∑ c ∈ E, cut c := by
    calc
      6 * E.card = ∑ _c ∈ E, 6 := by simp [Nat.mul_comm]
      _ ≤ ∑ c ∈ E, cut c := by
        apply Finset.sum_le_sum
        intro c hc
        apply hevenCut
        simpa [A, J, C, E] using hc
  have hsplit : (∑ c ∈ O, cut c) + (∑ c ∈ E, cut c) = ∑ c : C, cut c := by
    have hOfilter : O =
        (Finset.univ : Finset C).filter (fun c ↦ c ∈ J.oddComponents) := by
      ext c
      simp [O]
    have hEfilter : E =
        (Finset.univ : Finset C).filter (fun c ↦ c ∉ J.oddComponents) := by
      rfl
    rw [hOfilter, hEfilter]
    exact Finset.sum_filter_add_sum_filter_not
      (s := (Finset.univ : Finset C))
      (p := fun c ↦ c ∈ J.oddComponents) cut
  have hlower : 4 * O.card + 6 * E.card ≤ ∑ c : C, cut c := by
    rw [← hsplit]
    exact Nat.add_le_add hOddSum hEvenSum
  have hgap' : X.ncard + 2 ≤ O.card := by
    rw [hOcard]
    simpa [A, J] using hgap
  have hOexact : O.card = X.ncard + 2 := by
    by_cases hxodd : Odd X.ncard
    · have hOodd := hparity.mpr hxodd
      rcases hxodd with ⟨a, ha⟩
      rcases hOodd with ⟨b, hb⟩
      omega
    · have hxeven : Even X.ncard := Nat.not_odd_iff_even.mp hxodd
      have hOeven : Even O.card := Nat.not_odd_iff_even.mp
        (fun h ↦ hxodd (hparity.mp h))
      rcases hxeven with ⟨a, ha⟩
      rcases hOeven with ⟨b, hb⟩
      omega
  have hEzero : E.card = 0 := by
    omega
  have hmUpper : m ≤ 6 := by
    omega
  refine ⟨?_, ?_, hmLower, hmUpper⟩
  · simpa [A, J, hOcard] using hOexact
  · intro c
    by_contra hc
    have hcJ : c ∉ J.oddComponents := by simpa [A, J] using hc
    have hcE : c ∈ E := by simp [E, hcJ]
    have : 0 < E.card := Finset.card_pos.mpr ⟨c, hcE⟩
    omega

/-- The sharpened form of `antiNeighborhood_tutte_numeric_ledger`: after
subtracting the compulsory four edges from every residual component cut,
the total cut excess plus twice the number of internal edges in
`N[u] ∪ X` is exactly twelve.  Since the star at `u` already contributes
four internal edges, only the excess patterns `4`, `2`, and `0` can occur.
These are the numerical seeds of Tashkinov's barrier types B/C, A, and the
degenerate case, respectively. -/
lemma antiNeighborhood_tutte_excess_ledger
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (u : V)
    (X : Set (antiNeighborhood G u))
    (hgap : X.ncard + 2 ≤
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents.ncard)
    (hoddCut : ∀ c :
        (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents →
      4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c))
    (hevenCut : ∀ c :
        (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∉ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents →
      6 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c)) :
    let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
    let D := ambientDeletionSet (antiNeighborhood G u) X
    let m := (Pseudograph.ofSimple G).internalMultiplicity D
    2 * m + ∑ c : J.ConnectedComponent,
        ((Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G (antiNeighborhood G u) X c) - 4) = 12 := by
  classical
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let D := ambientDeletionSet A X
  let m := (Pseudograph.ofSimple G).internalMultiplicity D
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  have hnumeric := antiNeighborhood_tutte_numeric_ledger
    G hreg hodd u X hgap hoddCut hevenCut
  have hq : Fintype.card J.ConnectedComponent = X.ncard + 2 := by
    rw [← Nat.card_eq_fintype_card, ← Set.ncard_univ]
    have hall : (Set.univ : Set J.ConnectedComponent) = J.oddComponents := by
      ext c
      constructor
      · intro _
        simpa [A, J] using hnumeric.2.1 c
      · intro _
        exact Set.mem_univ c
    rw [hall]
    exact hnumeric.1
  have hcutLower (c : J.ConnectedComponent) : 4 ≤ cut c := by
    apply hoddCut
    simpa [A, J] using hnumeric.2.1 c
  have hsplit :
      (∑ c : J.ConnectedComponent, cut c) =
        4 * Fintype.card J.ConnectedComponent +
          ∑ c : J.ConnectedComponent, (cut c - 4) := by
    calc
      (∑ c : J.ConnectedComponent, cut c) =
          ∑ c : J.ConnectedComponent, (4 + (cut c - 4)) := by
            apply Finset.sum_congr rfl
            intro c _
            have := hcutLower c
            omega
      _ = ∑ _c : J.ConnectedComponent, 4 +
          ∑ c : J.ConnectedComponent, (cut c - 4) :=
            Finset.sum_add_distrib
      _ = 4 * Fintype.card J.ConnectedComponent +
          ∑ c : J.ConnectedComponent, (cut c - 4) := by
            simp [Nat.mul_comm]
  have hDcard : D.card = X.ncard + 5 := by
    simpa [A, D] using ambientDeletionSet_antiNeighborhood_card G hreg u X
  have hmaster : 4 * D.card = 2 * m + ∑ c : J.ConnectedComponent, cut c := by
    simpa [A, J, D, m, cut] using
      quartic_deletion_master_count G hreg A X
  change 2 * m + ∑ c : J.ConnectedComponent, (cut c - 4) = 12
  omega

/-- Pure finite arithmetic behind the three barrier cases.  An even cut at
least four whose total excess over four is at most four can only have size
four, six, or eight.  The exact excess identity then leaves precisely the
three displayed multiplicity patterns. -/
lemma classify_small_even_cut_excess
    {C : Type*} [Fintype C] (cut : C → ℕ) (m : ℕ)
    (hlower : ∀ c, 4 ≤ cut c) (heven : ∀ c, Even (cut c))
    (hm : 4 ≤ m)
    (hsum : 2 * m + ∑ c : C, (cut c - 4) = 12) :
    let C6 := (Finset.univ : Finset C).filter fun c ↦ cut c = 6
    let C8 := (Finset.univ : Finset C).filter fun c ↦ cut c = 8
    (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
      ((m = 4 ∧
          ((C6.card = 2 ∧ C8.card = 0) ∨
            (C6.card = 0 ∧ C8.card = 1))) ∨
        (m = 5 ∧ C6.card = 1 ∧ C8.card = 0) ∨
        (m = 6 ∧ C6.card = 0 ∧ C8.card = 0)) := by
  classical
  let excess : C → ℕ := fun c ↦ cut c - 4
  let C6 := (Finset.univ : Finset C).filter fun c ↦ cut c = 6
  let C8 := (Finset.univ : Finset C).filter fun c ↦ cut c = 8
  have htotal : (∑ c : C, excess c) ≤ 4 := by
    simpa [excess] using (show (∑ c : C, (cut c - 4)) ≤ 4 by omega)
  have hvalues (c : C) : cut c = 4 ∨ cut c = 6 ∨ cut c = 8 := by
    have hterm : excess c ≤ ∑ d : C, excess d := by
      exact Finset.single_le_sum (s := Finset.univ) (f := excess)
        (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ c)
    obtain ⟨k, hk⟩ := heven c
    have hcLower := hlower c
    dsimp only [excess] at hterm
    omega
  have hpoint (c : C) :
      excess c = if cut c = 6 then 2 else if cut c = 8 then 4 else 0 := by
    rcases hvalues c with h4 | h6 | h8
    · simp [excess, h4]
    · simp [excess, h6]
    · simp [excess, h8]
  have hcount :
      (∑ c : C, excess c) = 2 * C6.card + 4 * C8.card := by
    have hsum6 : (∑ c : C, if cut c = 6 then 2 else 0) = 2 * C6.card := by
      calc
        (∑ c : C, if cut c = 6 then 2 else 0) =
            ∑ c : C, 2 * (if cut c = 6 then 1 else 0) := by
              apply Finset.sum_congr rfl
              intro c _
              by_cases h : cut c = 6 <;> simp [h]
        _ = 2 * ∑ c : C, (if cut c = 6 then 1 else 0) := by
          rw [Finset.mul_sum]
        _ = 2 * C6.card := by
          change 2 * (∑ c ∈ (Finset.univ : Finset C),
            if cut c = 6 then 1 else 0) = _
          rw [Finset.sum_boole]
          rfl
    have hsum8 : (∑ c : C, if cut c = 8 then 4 else 0) = 4 * C8.card := by
      calc
        (∑ c : C, if cut c = 8 then 4 else 0) =
            ∑ c : C, 4 * (if cut c = 8 then 1 else 0) := by
              apply Finset.sum_congr rfl
              intro c _
              by_cases h : cut c = 8 <;> simp [h]
        _ = 4 * ∑ c : C, (if cut c = 8 then 1 else 0) := by
          rw [Finset.mul_sum]
        _ = 4 * C8.card := by
          change 4 * (∑ c ∈ (Finset.univ : Finset C),
            if cut c = 8 then 1 else 0) = _
          rw [Finset.sum_boole]
          rfl
    calc
      (∑ c : C, excess c) =
          ∑ c : C, (if cut c = 6 then 2 else if cut c = 8 then 4 else 0) := by
            apply Finset.sum_congr rfl
            intro c _
            exact hpoint c
      _ = ∑ c : C, ((if cut c = 6 then 2 else 0) +
          (if cut c = 8 then 4 else 0)) := by
            apply Finset.sum_congr rfl
            intro c _
            by_cases h6 : cut c = 6 <;> by_cases h8 : cut c = 8 <;>
              simp [h6, h8] at *
      _ = (∑ c : C, if cut c = 6 then 2 else 0) +
          ∑ c : C, if cut c = 8 then 4 else 0 := Finset.sum_add_distrib
      _ = 2 * C6.card + 4 * C8.card := by
        rw [hsum6, hsum8]
  refine ⟨hvalues, ?_⟩
  change
    (m = 4 ∧ ((C6.card = 2 ∧ C8.card = 0) ∨
        (C6.card = 0 ∧ C8.card = 1))) ∨
      (m = 5 ∧ C6.card = 1 ∧ C8.card = 0) ∨
      (m = 6 ∧ C6.card = 0 ∧ C8.card = 0)
  change 2 * m + ∑ c : C, excess c = 12 at hsum
  rw [hcount] at hsum
  have hmCases : m = 4 ∨ m = 5 ∨ m = 6 := by omega
  rcases hmCases with hm4 | hm5 | hm6
  · left
    refine ⟨hm4, ?_⟩
    by_cases h8 : C8.card = 0
    · left
      omega
    · right
      omega
  · right
    left
    omega
  · right
    right
    omega

/-- Tashkinov's barrier trichotomy at the level of its exact cut data.  In
an odd connected quartic graph with no two-cut and only trivial four-cuts,
failure of the anti-neighbourhood matching certificate produces a Tutte set
whose residual component cuts have one of exactly three patterns:

* four internal edges and either two six-cuts or one eight-cut;
* five internal edges and one six-cut;
* six internal edges and no six- or eight-cut.

The last pattern is the degenerate case excluded later by Tashkinov's
independent-set-complement lemma. -/
theorem exists_antiNeighborhood_tutte_cut_pattern_of_noPerfectMatching
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    ∃ X : Set (antiNeighborhood G u),
      let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
      let D := ambientDeletionSet (antiNeighborhood G u) X
      let cut : J.ConnectedComponent → ℕ := fun c ↦
        (Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G (antiNeighborhood G u) X c)
      let m := (Pseudograph.ofSimple G).internalMultiplicity D
      let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
        fun c ↦ cut c = 6
      let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
        fun c ↦ cut c = 8
      J.oddComponents.ncard = X.ncard + 2 ∧
        (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
        (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
        ((m = 4 ∧
            ((C6.card = 2 ∧ C8.card = 0) ∨
              (C6.card = 0 ∧ C8.card = 1))) ∨
          (m = 5 ∧ C6.card = 1 ∧ C8.card = 0) ∨
          (m = 6 ∧ C6.card = 0 ∧ C8.card = 0)) := by
  classical
  obtain ⟨X, hgap⟩ :=
    exists_antiNeighborhood_tutte_gap_of_no_perfectMatching G hreg hodd u hno
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let D := ambientDeletionSet A X
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  let m := (Pseudograph.ofSimple G).internalMultiplicity D
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 6
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 8
  have hoddCut : ∀ c : J.ConnectedComponent, c ∈ J.oddComponents →
      4 ≤ cut c := by
    intro c _hc
    let S := deletedComponentShore G A X c
    have hSnonempty : S.Nonempty := by
      simpa [S] using deletedComponentShore_nonempty G A X c
    have huD : u ∈ D := by
      apply mem_ambientDeletionSet.mpr
      left
      simp [A, antiNeighborhood]
    have huSnot : u ∉ S := fun huS ↦
      (Finset.disjoint_left.mp
        (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) huS huD
    have hSproper : S ≠ Finset.univ := by
      intro hS
      exact huSnot (by rw [hS]; simp)
    exact four_le_boundaryMultiplicity_of_connected_of_ne_two
      G hreg hconn hno2 S hSnonempty hSproper
  have hevenCut : ∀ c : J.ConnectedComponent, c ∉ J.oddComponents →
      6 ≤ cut c := by
    intro c hc
    simpa [A, J, cut] using
      six_le_boundaryMultiplicity_deletedComponentShore_of_even
        G hreg hconn hno2 hno4 u X c (by simpa [A, J] using hc)
  have hnumeric := antiNeighborhood_tutte_numeric_ledger
    G hreg hodd u X hgap
      (by simpa [A, J, cut] using hoddCut)
      (by simpa [A, J, cut] using hevenCut)
  have hexcess := antiNeighborhood_tutte_excess_ledger
    G hreg hodd u X hgap
      (by simpa [A, J, cut] using hoddCut)
      (by simpa [A, J, cut] using hevenCut)
  have hcutLower (c : J.ConnectedComponent) : 4 ≤ cut c :=
    hoddCut c (by simpa [A, J] using hnumeric.2.1 c)
  have hcutEven (c : J.ConnectedComponent) : Even (cut c) := by
    apply Pseudograph.boundaryMultiplicity_even_of_even_regular
      (Pseudograph.ofSimple G) (r := 2)
      (by simpa using
        ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg))
  have hclass := classify_small_even_cut_excess cut m hcutLower hcutEven
    (by simpa [A, D, m] using hnumeric.2.2.1)
    (by simpa [A, J, D, cut, m] using hexcess)
  refine ⟨X, ?_⟩
  change J.oddComponents.ncard = X.ncard + 2 ∧
    (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
    (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
    ((m = 4 ∧ ((C6.card = 2 ∧ C8.card = 0) ∨
        (C6.card = 0 ∧ C8.card = 1))) ∨
      (m = 5 ∧ C6.card = 1 ∧ C8.card = 0) ∨
      (m = 6 ∧ C6.card = 0 ∧ C8.card = 0))
  exact ⟨by simpa [A, J] using hnumeric.1,
    by simpa [A, J] using hnumeric.2.1,
    hclass.1,
    by simpa [C6, C8] using hclass.2⟩

/-- Names for the three genuine barrier types and the sole numerical
degeneracy which remains before the independent-complement argument. -/
inductive BarrierKind
  | A | B | C | degenerate
  deriving DecidableEq

/-- The literal internal-edge and component-cut data attached to a barrier
kind. -/
def IsAntiNeighborhoodBarrierPattern (G : SimpleGraph V) (u : V)
    (X : Set (antiNeighborhood G u)) (kind : BarrierKind) : Prop :=
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c)
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 6
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 8
  let middleEdges := (Pseudograph.ofSimple G).internalMultiplicity
    (barrierMiddle G u X)
  match kind with
  | .A => middleEdges = 1 ∧ C6.card = 1 ∧ C8.card = 0
  | .B => middleEdges = 0 ∧ C6.card = 2 ∧ C8.card = 0
  | .C => middleEdges = 0 ∧ C6.card = 0 ∧ C8.card = 1
  | .degenerate => middleEdges = 2 ∧ C6.card = 0 ∧ C8.card = 0

/-- The structural cut-pattern theorem restated in the published A/B/C
language, with the unique pre-barrier degeneracy made explicit. -/
theorem exists_antiNeighborhood_barrier_pattern_of_noPerfectMatching
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    ∃ X : Set (antiNeighborhood G u),
      let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
      let cut : J.ConnectedComponent → ℕ := fun c ↦
        (Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G (antiNeighborhood G u) X c)
      J.oddComponents.ncard = X.ncard + 2 ∧
        (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
        (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
        ∃ kind : BarrierKind,
          IsAntiNeighborhoodBarrierPattern G u X kind := by
  classical
  obtain ⟨X, hpattern⟩ :=
    exists_antiNeighborhood_tutte_cut_pattern_of_noPerfectMatching
      G hreg hodd hconn hno2 hno4 u hno
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let D := ambientDeletionSet A X
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  let m := (Pseudograph.ofSimple G).internalMultiplicity D
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 6
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 8
  change J.oddComponents.ncard = X.ncard + 2 ∧
    (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
    (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
    ((m = 4 ∧ ((C6.card = 2 ∧ C8.card = 0) ∨
        (C6.card = 0 ∧ C8.card = 1))) ∨
      (m = 5 ∧ C6.card = 1 ∧ C8.card = 0) ∨
      (m = 6 ∧ C6.card = 0 ∧ C8.card = 0)) at hpattern
  rcases hpattern with ⟨hq, hall, hvalues, hcases⟩
  have hmMiddle : m = 4 +
      (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) := by
    simpa [A, D, m] using
      internalMultiplicity_ambientDeletionSet_antiNeighborhood G hreg u X
  refine ⟨X, hq, hall, hvalues, ?_⟩
  rcases hcases with ⟨hm4, hB | hC⟩ | ⟨hm5, hA⟩ | ⟨hm6, hdeg⟩
  · refine ⟨.B, ?_⟩
    change (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) = 0 ∧ C6.card = 2 ∧ C8.card = 0
    omega
  · refine ⟨.C, ?_⟩
    change (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) = 0 ∧ C6.card = 0 ∧ C8.card = 1
    omega
  · refine ⟨.A, ?_⟩
    change (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) = 1 ∧ C6.card = 1 ∧ C8.card = 0
    omega
  · refine ⟨.degenerate, ?_⟩
    change (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) = 2 ∧ C6.card = 0 ∧ C8.card = 0
    omega

/-- Tashkinov's independent-complement lemma eliminates the only
degenerate numerical barrier pattern.  This formulation isolates exactly
the property used by the trichotomy: the complement of any independent set
has more than two internal edges. -/
lemma not_degenerate_antiNeighborhood_barrierPattern
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (u : V) (X : Set (antiNeighborhood G u))
    (hvalues : let J :=
        (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
      let cut : J.ConnectedComponent → ℕ := fun c ↦
        (Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G (antiNeighborhood G u) X c)
      ∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) :
    ¬ IsAntiNeighborhoodBarrierPattern G u X .degenerate := by
  classical
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let D := ambientDeletionSet A X
  let M := barrierMiddle G u X
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 6
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 8
  change ∀ c : J.ConnectedComponent,
    cut c = 4 ∨ cut c = 6 ∨ cut c = 8 at hvalues
  intro hdegenerate
  change (Pseudograph.ofSimple G).internalMultiplicity M = 2 ∧
    C6.card = 0 ∧ C8.card = 0 at hdegenerate
  rcases hdegenerate with ⟨hMedges, hC6card, hC8card⟩
  have hC6empty : C6 = ∅ := Finset.card_eq_zero.mp hC6card
  have hC8empty : C8 = ∅ := Finset.card_eq_zero.mp hC8card
  have hcutFour (c : J.ConnectedComponent) : cut c = 4 := by
    rcases hvalues c with h4 | h6 | h8
    · exact h4
    · have hc : c ∈ C6 := by simp [C6, h6]
      rw [hC6empty] at hc
      simp at hc
    · have hc : c ∈ C8 := by simp [C8, h8]
      rw [hC8empty] at hc
      simp at hc
  have hD : D = insert u M := by
    simpa [A, D, M] using
      ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle G u X
  obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
  have huD : u ∈ D := by rw [hD]; simp
  have hvM : v ∈ M := by
    apply mem_barrierMiddle.mpr
    exact .inl huv
  have hvD : v ∈ D := by rw [hD]; simp [hvM]
  have hshoreSingleton (c : J.ConnectedComponent) :
      (deletedComponentShore G A X c).card = 1 := by
    let S := deletedComponentShore G A X c
    have hSnonempty : S.Nonempty := by
      simpa [S] using deletedComponentShore_nonempty G A X c
    have huSnot : u ∉ S := fun huS ↦
      (Finset.disjoint_left.mp
        (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) huS huD
    have hvSnot : v ∉ S := fun hvS ↦
      (Finset.disjoint_left.mp
        (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) hvS hvD
    have hSproper : S ≠ Finset.univ := by
      intro hS
      exact huSnot (by rw [hS]; simp)
    have hcompcard_ne_one : Sᶜ.card ≠ 1 := by
      have hucompl : u ∈ Sᶜ := by simp [huSnot]
      have hvcompl : v ∈ Sᶜ := by simp [hvSnot]
      intro hcard
      have hsubset : ({u, v} : Finset V) ⊆ Sᶜ := by
        intro w hw
        simp only [Finset.mem_insert, Finset.mem_singleton] at hw
        rcases hw with rfl | rfl
        · exact hucompl
        · exact hvcompl
      have htwo : 2 ≤ Sᶜ.card := by
        have := Finset.card_le_card hsubset
        simpa [huv.ne] using this
      omega
    rcases hno4 S hSnonempty hSproper (by simpa [S, cut] using hcutFour c) with
      hcard | hcard
    · exact hcard
    · exact (hcompcard_ne_one hcard).elim
  have hMindependent : G.IsIndepSet (Mᶜ : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    intro habG
    have haM : a ∉ M := by simpa using ha
    have hbM : b ∉ M := by simpa using hb
    by_cases hau : a = u
    · subst a
      exact hbM (mem_barrierMiddle.mpr (.inl habG))
    have haD : a ∉ D := by
      rw [hD]
      simp [hau, haM]
    obtain ⟨c, hac⟩ :=
      exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet G A X haD
    have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
      simp [Pseudograph.ofSimple_mult, habG]
    rcases deletedComponentShore_closed G A X c hac b habmult with
      hbc | hbD
    · have hcard := hshoreSingleton c
      obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hcard
      have haz : a = z := by simpa [hz] using hac
      have hbz : b = z := by simpa [hz] using hbc
      exact hab (haz.trans hbz.symm)
    · have hbu : b = u := by
        change b ∈ D at hbD
        rw [hD] at hbD
        simpa [hbM] using hbD
      subst b
      exact haM (mem_barrierMiddle.mpr (.inl habG.symm))
  have hMindependent' : G.IsIndepSet (((Mᶜ : Finset V) : Set V)) := by
    simpa using hMindependent
  have hlarge := hindependentComplement Mᶜ hMindependent'
  have hlarge' : 2 < (Pseudograph.ofSimple G).internalMultiplicity M := by
    simpa using hlarge
  omega

/-- Tashkinov's A/B/C trichotomy, conditional only on the four structural
properties which his minimal-counterexample reduction establishes. -/
theorem exists_genuine_antiNeighborhood_barrier_pattern
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    ∃ X : Set (antiNeighborhood G u), ∃ kind : BarrierKind,
      (∀ c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
        c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents) ∧
        (kind = .A ∨ kind = .B ∨ kind = .C) ∧
        IsAntiNeighborhoodBarrierPattern G u X kind := by
  classical
  obtain ⟨X, hq, hall, hvalues, kind, hkind⟩ :=
    exists_antiNeighborhood_barrier_pattern_of_noPerfectMatching
      G hreg hodd hconn hno2 hno4 u hno
  refine ⟨X, kind, hall, ?_, hkind⟩
  rcases kind with _ | _ | _ | _
  · exact .inl rfl
  · exact .inr (.inl rfl)
  · exact .inr (.inr rfl)
  · exfalso
    exact (not_degenerate_antiNeighborhood_barrierPattern
      G hreg hno4 hindependentComplement u X hvalues) hkind

/-- If six-cuts have already been eliminated, a genuine barrier can only be
of type C. -/
lemma barrierKind_eq_C_of_no_six_cut
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno6 : HasOnlyTrivialSixCuts G)
    (u : V) (X : Set (antiNeighborhood G u)) (kind : BarrierKind)
    (hall : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents)
    (hgenuine : kind = .A ∨ kind = .B ∨ kind = .C)
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X kind) :
    kind = .C := by
  classical
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 6
  rcases kind with _ | _ | _ | _
  · change _ ∧ C6.card = 1 ∧ _ at hpattern
    obtain ⟨c, hc⟩ := Finset.card_pos.mp (by omega : 0 < C6.card)
    have hc6 : cut c = 6 := by simpa [C6] using hc
    exact False.elim (false_of_six_cut_deleted_odd_component
      G hreg hno6 u X c (hall c) (by simpa [A, cut] using hc6))
  · change _ ∧ C6.card = 2 ∧ _ at hpattern
    obtain ⟨c, hc⟩ := Finset.card_pos.mp (by omega : 0 < C6.card)
    have hc6 : cut c = 6 := by simpa [C6] using hc
    exact False.elim (false_of_six_cut_deleted_odd_component
      G hreg hno6 u X c (hall c) (by simpa [A, cut] using hc6))
  · rfl
  · simp at hgenuine

/-- After the no-six-cut proposition, every vertex whose
anti-neighbourhood lacks a perfect matching has a type-C barrier pattern. -/
theorem exists_typeC_antiNeighborhood_barrier_pattern
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hno6 : HasOnlyTrivialSixCuts G)
    (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    ∃ X : Set (antiNeighborhood G u),
      IsAntiNeighborhoodBarrierPattern G u X .C := by
  obtain ⟨X, kind, hall, hkind, hpattern⟩ :=
    exists_genuine_antiNeighborhood_barrier_pattern
      G hreg hodd hconn hno2 hno4 hindependentComplement u hno
  have hkC := barrierKind_eq_C_of_no_six_cut G hreg hno6 u X kind hall hkind hpattern
  subst kind
  exact ⟨X, hpattern⟩

/-- A type-C pattern has a unique residual component with boundary eight. -/
lemma existsUnique_eightComponent_of_typeC_pattern
    (G : SimpleGraph V) (u : V) (X : Set (antiNeighborhood G u))
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .C) :
    ∃! c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c) = 8 := by
  classical
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 8
  change _ ∧ _ ∧ C8.card = 1 at hpattern
  obtain ⟨c, hc⟩ := Finset.card_eq_one.mp hpattern.2.2
  refine ⟨c, ?_, ?_⟩
  · have : c ∈ C8 := by simp [hc]
    simpa [A, J, cut, C8] using this
  · intro d hd
    have hdmem : d ∈ C8 := by simpa [A, J, cut, C8] using hd
    simpa [hc] using hdmem

/-- The middle of a type-C barrier is independent. -/
lemma barrierMiddle_isIndepSet_of_typeC_pattern
    (G : SimpleGraph V) (u : V) (X : Set (antiNeighborhood G u))
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .C) :
    G.IsIndepSet (barrierMiddle G u X : Set V) := by
  rw [SimpleGraph.isIndepSet_iff]
  intro a ha b hb hab
  intro habG
  have hpos := internalMultiplicity_pos_of_adj_mem G (barrierMiddle G u X)
    habG (by simpa using ha) (by simpa using hb)
  change (Pseudograph.ofSimple G).internalMultiplicity
      (barrierMiddle G u X) = 0 ∧ _ at hpattern
  omega

/-- A full type-C barrier witness, retaining the Tutte parity data and the
unique residual eight-component needed by the intersection arguments. -/
structure TutteTypeCBarrier (G : SimpleGraph V) (u : V) where
  X : Set (antiNeighborhood G u)
  oddComponents_exact :
    (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents.ncard =
      X.ncard + 2
  all_components_odd : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
    c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents
  cut_value : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
    let cut := (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c)
    cut = 4 ∨ cut = 6 ∨ cut = 8
  pattern : IsAntiNeighborhoodBarrierPattern G u X .C
  component :
    (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent
  component_cut : (Pseudograph.ofSimple G).boundaryMultiplicity
    (deletedComponentShore G (antiNeighborhood G u) X component) = 8
  component_unique : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
    (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c) = 8 →
      c = component

namespace TutteTypeCBarrier

noncomputable def middle {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Finset V :=
  barrierMiddle G u B.X

noncomputable def right {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Finset V :=
  deletedComponentShore G (antiNeighborhood G u) B.X B.component

noncomputable def left {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Finset V :=
  (B.middle ∪ B.right)ᶜ

lemma right_cut {G : SimpleGraph V} {u : V} (B : TutteTypeCBarrier G u) :
    (Pseudograph.ofSimple G).boundaryMultiplicity B.right = 8 := by
  simpa [right] using B.component_cut

lemma middle_isIndepSet {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : G.IsIndepSet (B.middle : Set V) := by
  simpa [middle] using
    barrierMiddle_isIndepSet_of_typeC_pattern G u B.X B.pattern

lemma odd_right_card {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Odd B.right.card := by
  have hc := B.all_components_odd B.component
  change Odd B.component.supp.ncard at hc
  simpa [right, card_deletedComponentShore G
    (antiNeighborhood G u) B.X B.component] using hc

lemma other_component_singleton {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (c : (deleteInducedSubgraph G (antiNeighborhood G u) B.X).coe.ConnectedComponent)
    (hc : c ≠ B.component) :
    (deletedComponentShore G (antiNeighborhood G u) B.X c).card = 1 := by
  classical
  let A := antiNeighborhood G u
  let D := ambientDeletionSet A B.X
  let S := deletedComponentShore G A B.X c
  have hcut4 : (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 := by
    rcases B.cut_value c with h4 | h6 | h8
    · simpa [A, S] using h4
    · exfalso
      exact false_of_six_cut_deleted_odd_component
        G hreg hno6 u B.X c (B.all_components_odd c)
          (by simpa [A, S] using h6)
    · exfalso
      exact hc (B.component_unique c (by simpa [A, S] using h8))
  have hSnonempty : S.Nonempty := by
    simpa [S] using deletedComponentShore_nonempty G A B.X c
  have huD : u ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    simp [A, antiNeighborhood]
  obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
  have hvD : v ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    exact fun hvA ↦ hvA.2 huv
  have huSnot : u ∉ S := fun huS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A B.X c)) huS huD
  have hvSnot : v ∉ S := fun hvS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A B.X c)) hvS hvD
  have hSproper : S ≠ Finset.univ := by
    intro hS
    exact huSnot (by rw [hS]; simp)
  have hcompcard_ne_one : Sᶜ.card ≠ 1 := by
    intro hcard
    have hsubset : ({u, v} : Finset V) ⊆ Sᶜ := by
      intro w hw
      simp only [Finset.mem_insert, Finset.mem_singleton] at hw
      rcases hw with rfl | rfl
      · simp [huSnot]
      · simp [hvSnot]
    have htwo := Finset.card_le_card hsubset
    have : 2 ≤ Sᶜ.card := by simpa [huv.ne] using htwo
    omega
  rcases hno4 S hSnonempty hSproper hcut4 with hcard | hcard
  · simpa [A, S] using hcard
  · exact (hcompcard_ne_one hcard).elim

/-- The distinguished vertex lies in the left side of its type-C barrier. -/
lemma mem_left_distinguished {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : u ∈ B.left := by
  classical
  simp only [left, Finset.mem_compl, Finset.mem_union, not_or]
  constructor
  · exact notMem_barrierMiddle_self G u B.X
  · intro huRight
    have huD : u ∈ ambientDeletionSet (antiNeighborhood G u) B.X := by
      apply mem_ambientDeletionSet.mpr
      left
      simp [antiNeighborhood]
    exact (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet
        G (antiNeighborhood G u) B.X B.component)) huRight huD

/-- The left side of a full type-C barrier is independent. -/
lemma left_isIndepSet {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    G.IsIndepSet (B.left : Set V) := by
  classical
  rw [SimpleGraph.isIndepSet_iff]
  intro a ha b hb hab
  intro habG
  have haM : a ∉ B.middle := by
    intro haM
    apply (show a ∉ B.middle ∪ B.right by simpa [left] using ha)
    exact Finset.mem_union_left _ haM
  have hbM : b ∉ B.middle := by
    intro hbM
    apply (show b ∉ B.middle ∪ B.right by simpa [left] using hb)
    exact Finset.mem_union_left _ hbM
  have haR : a ∉ B.right := by
    intro haR
    apply (show a ∉ B.middle ∪ B.right by simpa [left] using ha)
    exact Finset.mem_union_right _ haR
  let A := antiNeighborhood G u
  let D := ambientDeletionSet A B.X
  have hD : D = insert u B.middle := by
    simpa [A, D, middle] using
      ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle G u B.X
  by_cases hau : a = u
  · subst a
    exact hbM (by
      apply mem_barrierMiddle.mpr
      exact .inl habG)
  have haD : a ∉ D := by rw [hD]; simp [hau, haM]
  obtain ⟨c, hac⟩ :=
    exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet G A B.X haD
  have hcne : c ≠ B.component := by
    intro hc
    subst c
    exact haR (by simpa [right, A] using hac)
  have hsingleton := B.other_component_singleton hreg hno4 hno6 c hcne
  have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
    simp [Pseudograph.ofSimple_mult, habG]
  rcases deletedComponentShore_closed G A B.X c hac b habmult with hbc | hbD
  · obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hsingleton
    rw [hz] at hac hbc
    have haz : a = z := by simpa using hac
    have hbz : b = z := by simpa using hbc
    exact hab (haz.trans hbz.symm)
  · have hbu : b = u := by
      change b ∈ D at hbD
      rw [hD] at hbD
      simpa [hbM] using hbD
    subst b
    exact haM (mem_barrierMiddle.mpr (.inl habG.symm))

/-- There are no edges from the left side of a type-C barrier to its right
eight-component. -/
lemma not_adj_left_right {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    {a b : V} (ha : a ∈ B.left) (hb : b ∈ B.right) :
    ¬ G.Adj a b := by
  intro hab
  have haM : a ∉ B.middle := by
    intro haM
    apply (show a ∉ B.middle ∪ B.right by simpa [left] using ha)
    exact Finset.mem_union_left _ haM
  let A := antiNeighborhood G u
  let D := ambientDeletionSet A B.X
  have hD : D = insert u B.middle := by
    simpa [A, D, middle] using
      ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle G u B.X
  by_cases hau : a = u
  · subst a
    have hbM : b ∈ B.middle := by
      apply mem_barrierMiddle.mpr
      exact .inl hab
    have hdisj : Disjoint B.right
        (ambientDeletionSet (antiNeighborhood G u) B.X) :=
      deletedComponentShore_disjoint_ambientDeletionSet
        G (antiNeighborhood G u) B.X B.component
    have hbD : b ∈ ambientDeletionSet (antiNeighborhood G u) B.X := by
      rw [ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle]
      exact Finset.mem_insert_of_mem hbM
    exact (Finset.disjoint_left.mp hdisj) hb hbD
  have haD : a ∉ D := by rw [hD]; simp [hau, haM]
  obtain ⟨c, hac⟩ :=
    exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet G A B.X haD
  have hcne : c ≠ B.component := by
    intro hc
    subst c
    have haR : a ∉ B.right := by
      intro haR
      apply (show a ∉ B.middle ∪ B.right by simpa [left] using ha)
      exact Finset.mem_union_right _ haR
    exact haR (by simpa [right, A] using hac)
  have hsingleton := B.other_component_singleton hreg hno4 hno6 c hcne
  have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
    simp [Pseudograph.ofSimple_mult, hab]
  rcases deletedComponentShore_closed G A B.X c hac b habmult with hbc | hbD
  · obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hsingleton
    rw [hz] at hac hbc
    have habEq : a = b := by
      have haz : a = z := by simpa using hac
      have hbz : b = z := by simpa using hbc
      exact haz.trans hbz.symm
    exact hab.ne habEq
  · have hdisj := deletedComponentShore_disjoint_ambientDeletionSet
      G A B.X B.component
    have hbD' : b ∈ D := by simpa [D] using hbD
    exact (Finset.disjoint_left.mp hdisj) (by simpa [right, A] using hb) hbD'

lemma disjoint_middle_right {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Disjoint B.middle B.right := by
  classical
  rw [Finset.disjoint_left]
  intro v hvM hvR
  have hvD : v ∈ ambientDeletionSet (antiNeighborhood G u) B.X := by
    rw [ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle]
    exact Finset.mem_insert_of_mem hvM
  exact (Finset.disjoint_left.mp
    (deletedComponentShore_disjoint_ambientDeletionSet
      G (antiNeighborhood G u) B.X B.component)) hvR hvD

lemma disjoint_left_middle {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Disjoint B.left B.middle := by
  classical
  rw [Finset.disjoint_left]
  intro v hvL hvM
  have hvnot : v ∉ B.middle ∪ B.right := by simpa [left] using hvL
  exact hvnot (Finset.mem_union_left _ hvM)

lemma disjoint_left_right {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : Disjoint B.left B.right := by
  classical
  rw [Finset.disjoint_left]
  intro v hvL hvR
  have hvnot : v ∉ B.middle ∪ B.right := by simpa [left] using hvL
  exact hvnot (Finset.mem_union_right _ hvR)

lemma middle_union_right_eq_left_compl {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : B.middle ∪ B.right = B.leftᶜ := by
  classical
  simp [left]

lemma left_union_right_eq_middle_compl {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : B.left ∪ B.right = B.middleᶜ := by
  classical
  have hMR := Finset.disjoint_left.mp B.disjoint_middle_right
  ext v
  by_cases hvM : v ∈ B.middle <;> by_cases hvR : v ∈ B.right
  · exact False.elim (hMR hvM hvR)
  · simp [left, hvM, hvR]
  · simp [left, hvM, hvR]
  · simp [left, hvM, hvR]

lemma middle_union_left_eq_right_compl {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) : B.middle ∪ B.left = B.rightᶜ := by
  classical
  have hMR := Finset.disjoint_left.mp B.disjoint_middle_right
  ext v
  by_cases hvM : v ∈ B.middle <;> by_cases hvR : v ∈ B.right
  · exact False.elim (hMR hvM hvR)
  · simp [left, hvM, hvR]
  · simp [left, hvM, hvR]
  · simp [left, hvM, hvR]

/-- The basic degree ledger of a type-C barrier: all eight edges leaving
the right component enter the middle, all four incidences at each left
vertex enter the middle, and consequently the middle has exactly two more
vertices than the left. -/
lemma typeC_degree_ledger {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity B.left B.right = 0 ∧
      (Pseudograph.ofSimple G).betweenMultiplicity B.right B.middle = 8 ∧
      (Pseudograph.ofSimple G).betweenMultiplicity B.left B.middle =
        4 * B.left.card ∧
      B.middle.card = B.left.card + 2 := by
  classical
  let P := Pseudograph.ofSimple G
  have hLRzero : P.betweenMultiplicity B.left B.right = 0 :=
    betweenMultiplicity_eq_zero_of_no_adj G B.left B.right
      (fun a ha b hb ↦ B.not_adj_left_right hreg hno4 hno6 ha hb)
  have hRLzero : P.betweenMultiplicity B.right B.left = 0 := by
    rw [Pseudograph.betweenMultiplicity_comm]
    exact hLRzero
  have hRboundary := Pseudograph.boundaryMultiplicity_eq_between_add_between
    P B.right B.middle B.left B.disjoint_left_middle.symm
    B.middle_union_left_eq_right_compl
  have hRM : P.betweenMultiplicity B.right B.middle = 8 := by
    rw [B.right_cut, hRLzero] at hRboundary
    omega
  have hLint : P.internalMultiplicity B.left = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G B.left
      (B.left_isIndepSet hreg hno4 hno6)
  have hLboundary := Pseudograph.boundaryMultiplicity_eq_between_add_between
    P B.left B.middle B.right B.disjoint_middle_right
    B.middle_union_right_eq_left_compl
  have hLdegree := Pseudograph.regular_card_eq_two_internal_add_boundary
    P ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) B.left
  have hLM : P.betweenMultiplicity B.left B.middle = 4 * B.left.card := by
    rw [hLint, Nat.mul_zero, Nat.zero_add, hLboundary, hLRzero] at hLdegree
    omega
  have hMint : P.internalMultiplicity B.middle = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G B.middle B.middle_isIndepSet
  have hMboundary := Pseudograph.boundaryMultiplicity_eq_between_add_between
    P B.middle B.left B.right B.disjoint_left_right
    B.left_union_right_eq_middle_compl
  have hMdegree := Pseudograph.regular_card_eq_two_internal_add_boundary
    P ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) B.middle
  have hML : P.betweenMultiplicity B.middle B.left = 4 * B.left.card := by
    simpa [Pseudograph.betweenMultiplicity_comm] using hLM
  have hMR : P.betweenMultiplicity B.middle B.right = 8 := by
    simpa [Pseudograph.betweenMultiplicity_comm] using hRM
  rw [hMint, Nat.mul_zero, Nat.zero_add, hMboundary, hML, hMR] at hMdegree
  refine ⟨hLRzero, hRM, hLM, ?_⟩
  omega

/-- The eight-component of a type-C barrier has at least three vertices. -/
lemma three_le_right_card {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4) :
    3 ≤ B.right.card := by
  have hnonempty := deletedComponentShore_nonempty
    G (antiNeighborhood G u) B.X B.component
  have hpos : 0 < B.right.card := by
    rw [Finset.card_pos]
    simpa [right] using hnonempty
  have hneone : B.right.card ≠ 1 :=
    (card_ne_one_of_boundaryMultiplicity_ne_four G hreg B.right (by
      rw [B.right_cut]
      omega)).1
  obtain ⟨k, hk⟩ := B.odd_right_card
  omega

/-- Proposition 4.1 rules out a three-vertex eight-shore: applying it to
the independent middle leaves exactly the internal edges of the right
shore in the complement. -/
lemma five_le_right_card {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ) :
    5 ≤ B.right.card := by
  let P := Pseudograph.ofSimple G
  have hlarge := hindependentComplement B.middle B.middle_isIndepSet
  have hunion := P.internalMultiplicity_union B.left B.right B.disjoint_left_right
  have hLint : P.internalMultiplicity B.left = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G B.left
      (B.left_isIndepSet hreg hno4 hno6)
  have hLR := (B.typeC_degree_ledger hreg hno4 hno6).1
  rw [← B.left_union_right_eq_middle_compl, hunion, hLint, hLR,
    Nat.zero_add, Nat.add_zero] at hlarge
  have hdegree := P.regular_card_eq_two_internal_add_boundary
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) B.right
  rw [B.right_cut] at hdegree
  obtain ⟨k, hk⟩ := B.odd_right_card
  omega

/-- The complement of the right component has at least four vertices. -/
lemma three_le_right_compl_card {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    4 ≤ B.rightᶜ.card := by
  have hbalance := (B.typeC_degree_ledger hreg hno4 hno6).2.2.2
  have hLpos : 0 < B.left.card :=
    Finset.card_pos.mpr ⟨u, B.mem_left_distinguished⟩
  have hdis : Disjoint B.middle B.left := B.disjoint_left_middle.symm
  have hcard := Finset.card_union_of_disjoint hdis
  rw [B.middle_union_left_eq_right_compl] at hcard
  omega

lemma right_union_singleton_nontrivial
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∉ B.right) :
    (B.right ∪ {v}).card ≠ 1 ∧ (B.right ∪ {v})ᶜ.card ≠ 1 ∧
      B.right ∪ {v} ≠ Finset.univ := by
  classical
  have hRcard := B.three_le_right_card hreg
  have hScard : (B.right ∪ {v}).card ≠ 1 := by
    have hle : B.right.card ≤ (B.right ∪ {v}).card :=
      Finset.card_le_card Finset.subset_union_left
    omega
  have hvcomp : v ∈ B.rightᶜ := by simp [hv]
  have hcompbase := B.three_le_right_compl_card hreg hno4 hno6
  have herase := Finset.card_erase_add_one hvcomp
  have hcompEq : (B.right ∪ {v})ᶜ = B.rightᶜ.erase v := by
    ext x
    simp [and_comm]
  have hcomptwo : 2 ≤ (B.right ∪ {v})ᶜ.card := by
    rw [hcompEq]
    omega
  have hcompcard : (B.right ∪ {v})ᶜ.card ≠ 1 := by omega
  have hproper : B.right ∪ {v} ≠ Finset.univ := by
    intro hEq
    have : (B.right ∪ {v})ᶜ.card = 0 := by simp [hEq]
    omega
  exact ⟨hScard, hcompcard, hproper⟩

lemma right_erase_nontrivial
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∈ B.right) :
    (B.right.erase v).card ≠ 1 ∧ (B.right.erase v)ᶜ.card ≠ 1 ∧
      B.right.erase v ≠ Finset.univ := by
  classical
  let R := B.right.erase v
  have hthree := B.three_le_right_card hreg
  have herase := Finset.card_erase_add_one hv
  have hRcard : R.card ≠ 1 := by
    change R.card + 1 = B.right.card at herase
    omega
  have hcompbase := B.three_le_right_compl_card hreg hno4 hno6
  have hsub : B.rightᶜ ⊆ Rᶜ := by
    intro x hx
    simp only [Finset.mem_compl] at hx ⊢
    exact fun hxR ↦ hx (Finset.mem_of_mem_erase hxR)
  have hcompthree : 3 ≤ Rᶜ.card := by
    have hle := Finset.card_le_card hsub
    omega
  have hcompcard : Rᶜ.card ≠ 1 := by omega
  have hproper : R ≠ Finset.univ := by
    intro hEq
    have : Rᶜ.card = 0 := by simp [hEq]
    omega
  exact ⟨hRcard, hcompcard, hproper⟩

lemma right_union_singleton_cut_equation
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (v : V) (hv : v ∉ B.right) :
    (Pseudograph.ofSimple G).boundaryMultiplicity (B.right ∪ {v}) +
        2 * (Pseudograph.ofSimple G).betweenMultiplicity B.right {v} = 12 := by
  classical
  let P := Pseudograph.ofSimple G
  have hdis : Disjoint B.right {v} := by
    simp [Finset.disjoint_left, hv]
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    hregular B.right {v} hdis
  have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg v
  rw [B.right_cut, hsingle] at htoggle
  omega

lemma between_singleton_right_ne_three
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∉ B.right) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} B.right ≠ 3 := by
  have heq := B.right_union_singleton_cut_equation hreg v hv
  rw [Pseudograph.betweenMultiplicity_comm] at heq
  intro hthree
  have hcut : (Pseudograph.ofSimple G).boundaryMultiplicity
      (B.right ∪ {v}) = 6 := by omega
  have hSfour : 4 ≤ (B.right ∪ {v}).card := by
    have hR := B.three_le_right_card hreg
    have hvnot := hv
    rw [Finset.card_union_of_disjoint (by simp [Finset.disjoint_left, hv]),
      Finset.card_singleton]
    omega
  have hcompthree : 3 ≤ (B.right ∪ {v})ᶜ.card := by
    have hbase := B.three_le_right_compl_card hreg hno4 hno6
    have hvcomp : v ∈ B.rightᶜ := by simp [hv]
    have herase := Finset.card_erase_add_one hvcomp
    have heq : (B.right ∪ {v})ᶜ = B.rightᶜ.erase v := by
      ext x
      simp [and_comm]
    rw [heq]
    omega
  rcases hno6 (B.right ∪ {v}) hcut with htwo | htwo <;> omega

lemma between_singleton_right_ne_four
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∉ B.right) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} B.right ≠ 4 := by
  have heq := B.right_union_singleton_cut_equation hreg v hv
  rw [Pseudograph.betweenMultiplicity_comm] at heq
  intro hfour
  have hcut : (Pseudograph.ofSimple G).boundaryMultiplicity
      (B.right ∪ {v}) = 4 := by omega
  obtain ⟨hScard, hcompcard, hproper⟩ :=
    B.right_union_singleton_nontrivial hreg hno4 hno6 v hv
  have hnonempty : (B.right ∪ {v}).Nonempty := ⟨v, by simp⟩
  rcases hno4 (B.right ∪ {v}) hnonempty hproper hcut with h | h
  · exact hScard h
  · exact hcompcard h

/-- For a vertex outside an eight-component, at most two incident edges
enter the component.  Three would create a six-cut after adjoining the
vertex; four would create a nontrivial four-cut. -/
lemma between_singleton_right_le_two
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∉ B.right) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} B.right ≤ 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let q := P.betweenMultiplicity {v} B.right
  have hdis : Disjoint B.right {v} := by
    simp [Finset.disjoint_left, hv]
  have hdis' : Disjoint {v} B.right := hdis.symm
  have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg v
  have hqle : q ≤ 4 := by
    exact (P.betweenMultiplicity_le_boundaryMultiplicity {v} B.right hdis').trans_eq
      hsingle
  change q ≤ 4 at hqle
  have hne3 := B.between_singleton_right_ne_three hreg hno4 hno6 v hv
  have hne4 := B.between_singleton_right_ne_four hreg hno4 hno6 v hv
  change q ≠ 3 at hne3
  change q ≠ 4 at hne4
  change q ≤ 2
  omega

lemma right_erase_cut_equation
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (v : V) (hv : v ∈ B.right) :
    8 + 2 * (Pseudograph.ofSimple G).betweenMultiplicity
        (B.right.erase v) {v} =
      (Pseudograph.ofSimple G).boundaryMultiplicity (B.right.erase v) + 4 := by
  classical
  let P := Pseudograph.ofSimple G
  let R := B.right.erase v
  have hdis : Disjoint R {v} := by
    rw [Finset.disjoint_left]
    intro a haR ha
    simp only [Finset.mem_singleton] at ha
    subst a
    simpa [R] using haR
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    hregular R {v} hdis
  have hunion : R ∪ {v} = B.right := by
    ext x
    by_cases hx : x = v
    · subst x
      simp [R, hv]
    · simp [R, hx]
  have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg v
  rw [hunion, B.right_cut, hsingle] at htoggle
  exact htoggle

lemma between_singleton_right_erase_ne_zero
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∈ B.right) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} (B.right.erase v) ≠ 0 := by
  let R := B.right.erase v
  have heq := B.right_erase_cut_equation hreg v hv
  rw [Pseudograph.betweenMultiplicity_comm] at heq
  intro hzero
  change (Pseudograph.ofSimple G).betweenMultiplicity {v} R = 0 at hzero
  change 8 + 2 * (Pseudograph.ofSimple G).betweenMultiplicity {v} R =
      (Pseudograph.ofSimple G).boundaryMultiplicity R + 4 at heq
  have hcut : (Pseudograph.ofSimple G).boundaryMultiplicity R = 4 := by omega
  obtain ⟨hRcard, hcompcard, hproper⟩ :=
    B.right_erase_nontrivial hreg hno4 hno6 v hv
  have hnonempty : R.Nonempty := Finset.card_pos.mp (by
    have hthree := B.three_le_right_card hreg
    have herase := Finset.card_erase_add_one hv
    change R.card + 1 = B.right.card at herase
    omega)
  rcases hno4 R hnonempty hproper hcut with h | h
  · exact hRcard h
  · exact hcompcard h

lemma between_singleton_right_erase_ne_one
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (v : V) (hv : v ∈ B.right) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} (B.right.erase v) ≠ 1 := by
  have heq := B.right_erase_cut_equation hreg v hv
  rw [Pseudograph.betweenMultiplicity_comm] at heq
  intro hone
  change 8 + 2 * (Pseudograph.ofSimple G).betweenMultiplicity
      {v} (B.right.erase v) =
    (Pseudograph.ofSimple G).boundaryMultiplicity (B.right.erase v) + 4 at heq
  have hcut : (Pseudograph.ofSimple G).boundaryMultiplicity
      (B.right.erase v) = 6 := by omega
  have hRfour : 4 ≤ (B.right.erase v).card := by
    have hfive := B.five_le_right_card hreg hno4 hno6 hindependentComplement
    have herase := Finset.card_erase_add_one hv
    omega
  have hcompfour : 4 ≤ (B.right.erase v)ᶜ.card := by
    have hbase := B.three_le_right_compl_card hreg hno4 hno6
    have hsub : B.rightᶜ ⊆ (B.right.erase v)ᶜ := by
      intro x hx
      simp only [Finset.mem_compl] at hx ⊢
      exact fun hxerase ↦ hx (Finset.mem_of_mem_erase hxerase)
    exact hbase.trans (Finset.card_le_card hsub)
  rcases hno6 (B.right.erase v) hcut with htwo | htwo <;> omega

/-- Dually, every vertex in an eight-component has at least two neighbours
inside it.  Otherwise deleting the vertex creates a forbidden four- or
six-cut. -/
lemma two_le_between_singleton_right_erase
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (v : V) (hv : v ∈ B.right) :
    2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {v} (B.right.erase v) := by
  classical
  let P := Pseudograph.ofSimple G
  let R := B.right.erase v
  let q := P.betweenMultiplicity {v} R
  change 2 ≤ q
  have hne0 := B.between_singleton_right_erase_ne_zero hreg hno4 hno6 v hv
  have hne1 := B.between_singleton_right_erase_ne_one
    hreg hno4 hno6 hindependentComplement v hv
  change q ≠ 0 at hne0
  change q ≠ 1 at hne1
  omega

/-- Some vertex of the eight-component has two distinct neighbours inside
that component.  This is the elementary connected-graph fact used when the
second distinguished vertex is selected in Section 5. -/
lemma exists_vertex_with_two_right_neighbors
    {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u) (hreg : G.IsRegularOfDegree 4) :
    ∃ w ∈ B.right, ∃ x ∈ B.right, ∃ y ∈ B.right,
      x ≠ y ∧ G.Adj w x ∧ G.Adj w y := by
  classical
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) B.X).coe
  let H := B.component.toSimpleGraph
  have hcard : Nat.card B.component = B.right.card := by
    calc
      Nat.card B.component = Fintype.card B.component := by
        rw [Nat.card_eq_fintype_card]
      _ = Fintype.card B.component.supp := by
        exact Fintype.card_congr (Equiv.setCongr rfl)
      _ = B.component.supp.ncard := by
        rw [Set.ncard_eq_toFinset_card']
        simpa using Fintype.card_coe B.component.supp.toFinset
      _ = B.right.card := by
        simpa [right] using
          (card_deletedComponentShore G (antiNeighborhood G u) B.X B.component).symm
  have hthree : 3 ≤ Nat.card B.component := by
    rw [hcard]
    exact B.three_le_right_card hreg
  have hdegree : ∃ w : B.component, 2 ≤ H.degree w := by
    by_contra h
    push_neg at h
    have hsum_le : ∑ w : B.component, H.degree w ≤
        ∑ _w : B.component, 1 := by
      exact Finset.sum_le_sum fun w _ ↦ Nat.le_of_lt_succ (h w)
    have hedges := B.component.connected_toSimpleGraph.card_vert_le_card_edgeSet_add_one
    have hhandshake := H.sum_degrees_eq_twice_card_edges
    have hedges' : Nat.card B.component ≤ H.edgeFinset.card + 1 := by
      simpa only [H, Nat.card_eq_fintype_card, SimpleGraph.edgeFinset_card] using hedges
    rw [Finset.sum_const, Finset.card_univ, smul_eq_mul,
      Nat.mul_one] at hsum_le
    have hcard' : Fintype.card B.component = Nat.card B.component := by
      rw [Nat.card_eq_fintype_card]
    omega
  obtain ⟨w, hw⟩ := hdegree
  rw [← SimpleGraph.card_neighborFinset_eq_degree] at hw
  obtain ⟨x, hx, y, hy, hxy⟩ := Finset.one_lt_card.mp hw
  have hwR : (w.1.1 : V) ∈ B.right := by
    exact mem_deletedComponentShore.mpr ⟨w.1, w.2, rfl⟩
  have hxR : (x.1.1 : V) ∈ B.right := by
    exact mem_deletedComponentShore.mpr ⟨x.1, x.2, rfl⟩
  have hyR : (y.1.1 : V) ∈ B.right := by
    exact mem_deletedComponentShore.mpr ⟨y.1, y.2, rfl⟩
  have hwxJ : J.Adj w.1 x.1 :=
    (B.component.toSimpleGraph_adj w.2 x.2).mp
      (by simpa only [SimpleGraph.mem_neighborFinset] using hx)
  have hwyJ : J.Adj w.1 y.1 :=
    (B.component.toSimpleGraph_adj w.2 y.2).mp
      (by simpa only [SimpleGraph.mem_neighborFinset] using hy)
  have hwx : G.Adj (w.1.1 : V) (x.1.1 : V) :=
    (deleteInducedSubgraph G (antiNeighborhood G u) B.X).adj_sub hwxJ
  have hwy : G.Adj (w.1.1 : V) (y.1.1 : V) :=
    (deleteInducedSubgraph G (antiNeighborhood G u) B.X).adj_sub hwyJ
  exact ⟨(w.1.1 : V), hwR, (x.1.1 : V), hxR, (y.1.1 : V), hyR,
    fun h ↦ hxy (Subtype.ext (Subtype.ext (Subtype.ext h))), hwx, hwy⟩

end TutteTypeCBarrier

/-! ### Abstract type-C partitions

The last section of Tashkinov's proof constructs new barriers by recombining
the shores of two Tutte barriers.  From this point onward only the checked
partition properties are used, so we package exactly those properties. -/

structure TypeCBarrier (G : SimpleGraph V) (u : V) where
  left : Finset V
  middle : Finset V
  right : Finset V
  distinguished_mem_left : u ∈ left
  left_middle_disjoint : Disjoint left middle
  left_right_disjoint : Disjoint left right
  middle_right_disjoint : Disjoint middle right
  cover : left ∪ middle ∪ right = Finset.univ
  left_independent : G.IsIndepSet (left : Set V)
  middle_independent : G.IsIndepSet (middle : Set V)
  left_right_nonadjacent : ∀ {x y : V}, x ∈ left → y ∈ right → ¬ G.Adj x y
  right_boundary :
    (Pseudograph.ofSimple G).boundaryMultiplicity right = 8
  right_odd : Odd right.card
  right_two_neighbors : ∀ v ∈ right,
    2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {v} (right.erase v)

namespace TypeCBarrier

/-- Forget the Tutte witness while retaining every shore property used by
the overlay/minimality argument. -/
noncomputable def ofTutte {G : SimpleGraph V} {u : V}
    (B : TutteTypeCBarrier G u)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ) :
    TypeCBarrier G u where
  left := B.left
  middle := B.middle
  right := B.right
  distinguished_mem_left := B.mem_left_distinguished
  left_middle_disjoint := B.disjoint_left_middle
  left_right_disjoint := B.disjoint_left_right
  middle_right_disjoint := B.disjoint_middle_right
  cover := by
    classical
    ext x
    simp only [Finset.mem_union, Finset.mem_univ, iff_true]
    by_cases hxM : x ∈ B.middle
    · exact .inl (.inr hxM)
    by_cases hxR : x ∈ B.right
    · exact .inr hxR
    · exact .inl (.inl (by simp [TutteTypeCBarrier.left, hxM, hxR]))
  left_independent := B.left_isIndepSet hreg hno4 hno6
  middle_independent := B.middle_isIndepSet
  left_right_nonadjacent := fun hx hy ↦
    B.not_adj_left_right hreg hno4 hno6 hx hy
  right_boundary := B.right_cut
  right_odd := B.odd_right_card
  right_two_neighbors := fun v hv ↦
    B.two_le_between_singleton_right_erase
      hreg hno4 hno6 hindependentComplement v hv

lemma mem_left_distinguished {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : u ∈ B.left := B.distinguished_mem_left

lemma disjoint_left_middle {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Disjoint B.left B.middle :=
  B.left_middle_disjoint

lemma disjoint_left_right {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Disjoint B.left B.right :=
  B.left_right_disjoint

lemma disjoint_middle_right {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Disjoint B.middle B.right :=
  B.middle_right_disjoint

lemma left_isIndepSet {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (_hreg : G.IsRegularOfDegree 4)
    (_hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (_hno6 : HasOnlyTrivialSixCuts G) :
    G.IsIndepSet (B.left : Set V) := B.left_independent

lemma middle_isIndepSet {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : G.IsIndepSet (B.middle : Set V) :=
  B.middle_independent

lemma not_adj_left_right {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (_hreg : G.IsRegularOfDegree 4)
    (_hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (_hno6 : HasOnlyTrivialSixCuts G)
    {x y : V} (hx : x ∈ B.left) (hy : y ∈ B.right) :
    ¬ G.Adj x y := B.left_right_nonadjacent hx hy

lemma right_cut {G : SimpleGraph V} {u : V} (B : TypeCBarrier G u) :
    (Pseudograph.ofSimple G).boundaryMultiplicity B.right = 8 :=
  B.right_boundary

lemma odd_right_card {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Odd B.right.card := B.right_odd

lemma middle_union_right_eq_left_compl {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : B.middle ∪ B.right = B.leftᶜ := by
  classical
  ext x
  have hcover := Finset.ext_iff.mp B.cover x
  have hLM := Finset.disjoint_left.mp B.disjoint_left_middle
  have hLR := Finset.disjoint_left.mp B.disjoint_left_right
  simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hcover
  simp only [Finset.mem_union, Finset.mem_compl]
  tauto

lemma left_union_right_eq_middle_compl {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : B.left ∪ B.right = B.middleᶜ := by
  classical
  ext x
  have hcover := Finset.ext_iff.mp B.cover x
  have hLM := Finset.disjoint_left.mp B.disjoint_left_middle
  have hMR := Finset.disjoint_left.mp B.disjoint_middle_right
  simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hcover
  simp only [Finset.mem_union, Finset.mem_compl]
  tauto

lemma middle_union_left_eq_right_compl {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : B.middle ∪ B.left = B.rightᶜ := by
  classical
  ext x
  have hcover := Finset.ext_iff.mp B.cover x
  have hMR := Finset.disjoint_left.mp B.disjoint_middle_right
  have hLR := Finset.disjoint_left.mp B.disjoint_left_right
  simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hcover
  simp only [Finset.mem_union, Finset.mem_compl]
  tauto

/-- The standard degree ledger follows from the abstract partition axioms. -/
lemma typeC_degree_ledger {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (_hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (_hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity B.left B.right = 0 ∧
      (Pseudograph.ofSimple G).betweenMultiplicity B.right B.middle = 8 ∧
      (Pseudograph.ofSimple G).betweenMultiplicity B.left B.middle =
        4 * B.left.card ∧
      B.middle.card = B.left.card + 2 := by
  let P := Pseudograph.ofSimple G
  have hLR : P.betweenMultiplicity B.left B.right = 0 :=
    betweenMultiplicity_eq_zero_of_no_adj G B.left B.right
      (fun _ hx _ hy ↦ B.left_right_nonadjacent hx hy)
  have hRL : P.betweenMultiplicity B.right B.left = 0 := by
    rw [P.betweenMultiplicity_comm]
    exact hLR
  have hRsplit := P.boundaryMultiplicity_eq_between_add_between
    B.right B.middle B.left B.disjoint_left_middle.symm
    B.middle_union_left_eq_right_compl
  have hRM : P.betweenMultiplicity B.right B.middle = 8 := by
    rw [B.right_cut, hRL] at hRsplit
    omega
  have hLint : P.internalMultiplicity B.left = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G B.left B.left_independent
  have hLsplit := P.boundaryMultiplicity_eq_between_add_between
    B.left B.middle B.right B.disjoint_middle_right
    B.middle_union_right_eq_left_compl
  have hLdegree := P.regular_card_eq_two_internal_add_boundary
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) B.left
  have hLM : P.betweenMultiplicity B.left B.middle = 4 * B.left.card := by
    rw [hLint, Nat.mul_zero, Nat.zero_add, hLsplit, hLR] at hLdegree
    omega
  have hMint : P.internalMultiplicity B.middle = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G B.middle B.middle_independent
  have hMsplit := P.boundaryMultiplicity_eq_between_add_between
    B.middle B.left B.right B.disjoint_left_right
    B.left_union_right_eq_middle_compl
  have hMdegree := P.regular_card_eq_two_internal_add_boundary
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) B.middle
  rw [hMint, Nat.mul_zero, Nat.zero_add, hMsplit,
    P.betweenMultiplicity_comm B.middle B.left,
    P.betweenMultiplicity_comm B.middle B.right, hLM, hRM] at hMdegree
  refine ⟨hLR, hRM, hLM, ?_⟩
  omega

lemma three_le_right_card {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4) :
    3 ≤ B.right.card := by
  have hnonempty : B.right.Nonempty := by
    by_contra h
    have hEmpty := Finset.not_nonempty_iff_eq_empty.mp h
    have hcut := B.right_cut
    rw [hEmpty, Pseudograph.boundaryMultiplicity_empty] at hcut
    omega
  have hpos := Finset.card_pos.mpr hnonempty
  have hneone := (card_ne_one_of_boundaryMultiplicity_ne_four
    G hreg B.right (by rw [B.right_cut]; omega)).1
  obtain ⟨k, hk⟩ := B.odd_right_card
  omega

lemma three_le_right_compl_card {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    4 ≤ B.rightᶜ.card := by
  have hbalance := (B.typeC_degree_ledger hreg hno4 hno6).2.2.2
  have hLpos : 0 < B.left.card :=
    Finset.card_pos.mpr ⟨u, B.mem_left_distinguished⟩
  have hcard := Finset.card_union_of_disjoint B.disjoint_left_middle.symm
  rw [B.middle_union_left_eq_right_compl] at hcard
  omega

lemma right_union_singleton_cut_equation
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (v : V) (hv : v ∉ B.right) :
    (Pseudograph.ofSimple G).boundaryMultiplicity (B.right ∪ {v}) +
        2 * (Pseudograph.ofSimple G).betweenMultiplicity B.right {v} = 12 := by
  let P := Pseudograph.ofSimple G
  have hdis : Disjoint B.right {v} := by simp [Finset.disjoint_left, hv]
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
    B.right {v} hdis
  rw [B.right_cut, boundaryMultiplicity_singleton_of_quartic G hreg v] at htoggle
  omega

lemma between_singleton_right_le_two
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∉ B.right) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} B.right ≤ 2 := by
  let P := Pseudograph.ofSimple G
  let q := P.betweenMultiplicity {v} B.right
  have hqle : q ≤ 4 := by
    exact (P.betweenMultiplicity_le_boundaryMultiplicity {v} B.right
      (by simp [Finset.disjoint_left, hv])).trans_eq
        (boundaryMultiplicity_singleton_of_quartic G hreg v)
  have heq := B.right_union_singleton_cut_equation hreg v hv
  rw [P.betweenMultiplicity_comm] at heq
  change P.boundaryMultiplicity (B.right ∪ {v}) + 2 * q = 12 at heq
  have hRthree := B.three_le_right_card hreg
  have hSthree : 3 ≤ (B.right ∪ {v}).card :=
    hRthree.trans (Finset.card_le_card Finset.subset_union_left)
  have hcompthree := B.three_le_right_compl_card hreg hno4 hno6
  have hvcomp : v ∈ B.rightᶜ := by simp [hv]
  have herase := Finset.card_erase_add_one hvcomp
  have hcompEq : (B.right ∪ {v})ᶜ = B.rightᶜ.erase v := by
    ext x
    simp [and_comm]
  have hcomptwo : 3 ≤ (B.right ∪ {v})ᶜ.card := by
    rw [hcompEq]
    omega
  have hproper : B.right ∪ {v} ≠ Finset.univ := by
    intro hEq
    have : (B.right ∪ {v})ᶜ.card = 0 := by simp [hEq]
    omega
  change q ≤ 2
  by_contra hnot
  have hcases : q = 3 ∨ q = 4 := by omega
  rcases hcases with hthree | hfour
  · have hq : P.betweenMultiplicity {v} B.right = 3 := by exact hthree
    have heq' := B.right_union_singleton_cut_equation hreg v hv
    rw [P.betweenMultiplicity_comm, hq] at heq'
    have hcut6 : P.boundaryMultiplicity (B.right ∪ {v}) = 6 := by omega
    rcases hno6 (B.right ∪ {v}) hcut6 with htwo | htwo <;> omega
  · have hq : P.betweenMultiplicity {v} B.right = 4 := by exact hfour
    have heq' := B.right_union_singleton_cut_equation hreg v hv
    rw [P.betweenMultiplicity_comm, hq] at heq'
    have hcut4 : P.boundaryMultiplicity (B.right ∪ {v}) = 4 := by omega
    have hnonempty : (B.right ∪ {v}).Nonempty := ⟨v, by simp⟩
    rcases hno4 (B.right ∪ {v}) hnonempty hproper hcut4 with h | h <;> omega

lemma right_erase_cut_equation
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (v : V) (hv : v ∈ B.right) :
    8 + 2 * (Pseudograph.ofSimple G).betweenMultiplicity
        (B.right.erase v) {v} =
      (Pseudograph.ofSimple G).boundaryMultiplicity (B.right.erase v) + 4 := by
  let P := Pseudograph.ofSimple G
  have hdis : Disjoint (B.right.erase v) {v} := by
    rw [Finset.disjoint_left]
    intro x hx hxv
    simp only [Finset.mem_singleton] at hxv
    subst x
    simpa using hx
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
    (B.right.erase v) {v} hdis
  have hunion : B.right.erase v ∪ {v} = B.right := by
    ext x
    by_cases hx : x = v <;> simp [hx, hv]
  rw [hunion, B.right_cut, boundaryMultiplicity_singleton_of_quartic G hreg v]
    at htoggle
  exact htoggle

lemma two_le_between_singleton_right_erase
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (v : V) (hv : v ∈ B.right) :
    2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {v} (B.right.erase v) := by
  exact B.right_two_neighbors v hv

lemma exists_vertex_with_two_right_neighbors
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4) :
    ∃ w ∈ B.right, ∃ x ∈ B.right, ∃ y ∈ B.right,
      x ≠ y ∧ G.Adj w x ∧ G.Adj w y := by
  classical
  obtain ⟨w, hw⟩ : B.right.Nonempty := by
    have hthree := B.three_le_right_card hreg
    exact Finset.card_pos.mp (by omega)
  have htwo := B.right_two_neighbors w hw
  have hwErase : w ∉ B.right.erase w := by simp
  rw [Pseudograph.betweenMultiplicity_singleton_ofSimple G w
    (B.right.erase w) hwErase] at htwo
  obtain ⟨x, hx, y, hy, hxy⟩ := Finset.one_lt_card.mp htwo
  have hx' := Finset.mem_filter.mp hx
  have hy' := Finset.mem_filter.mp hy
  exact ⟨w, hw, x, Finset.mem_of_mem_erase hx'.1,
    y, Finset.mem_of_mem_erase hy'.1, hxy, hx'.2, hy'.2⟩

/-! ### Intersections of two type-C partitions

Tashkinov's last argument overlays two ordered partitions.  The following
small API names the three sides uniformly and packages the resulting nine
blocks.  It is deliberately independent of the numerical argument, so all
later cut expansions use the same, checked partition facts. -/

/-- The left, middle, and right coordinates of a type-C partition. -/
inductive Side
  | L | M | R
  deriving DecidableEq

/-- Select one side of a type-C barrier. -/
noncomputable def side {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Side → Finset V
  | .L => B.left
  | .M => B.middle
  | .R => B.right

@[simp] lemma side_L {G : SimpleGraph V} {u : V} (B : TypeCBarrier G u) :
    B.side .L = B.left := rfl

@[simp] lemma side_M {G : SimpleGraph V} {u : V} (B : TypeCBarrier G u) :
    B.side .M = B.middle := rfl

@[simp] lemma side_R {G : SimpleGraph V} {u : V} (B : TypeCBarrier G u) :
    B.side .R = B.right := rfl

/-- Distinct coordinates of one type-C partition are disjoint. -/
lemma disjoint_side {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) {s t : Side} (hst : s ≠ t) :
    Disjoint (B.side s) (B.side t) := by
  cases s with
  | L =>
      cases t with
      | L => exact (hst rfl).elim
      | M => exact B.disjoint_left_middle
      | R => exact B.disjoint_left_right
  | M =>
      cases t with
      | L => exact B.disjoint_left_middle.symm
      | M => exact (hst rfl).elim
      | R => exact B.disjoint_middle_right
  | R =>
      cases t with
      | L => exact B.disjoint_left_right.symm
      | M => exact B.disjoint_middle_right.symm
      | R => exact (hst rfl).elim

/-- The three coordinates cover the ambient vertex set. -/
lemma union_sides {G : SimpleGraph V} {u : V} (B : TypeCBarrier G u) :
    B.side .L ∪ B.side .M ∪ B.side .R = Finset.univ := by
  exact B.cover

/-- A vertex belongs to a unique coordinate of a type-C partition. -/
lemma existsUnique_mem_side {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (v : V) : ∃! s : Side, v ∈ B.side s := by
  classical
  by_cases hvL : v ∈ B.side .L
  · refine ⟨.L, hvL, ?_⟩
    intro t hvt
    by_contra hne
    exact (Finset.disjoint_left.mp (B.disjoint_side hne)) hvt hvL
  by_cases hvM : v ∈ B.side .M
  · refine ⟨.M, hvM, ?_⟩
    intro t hvt
    by_contra hne
    exact (Finset.disjoint_left.mp (B.disjoint_side hne)) hvt hvM
  have hvR : v ∈ B.side .R := by
    by_contra hvR
    have hv : v ∈ B.side .L ∪ B.side .M ∪ B.side .R := by
      rw [B.union_sides]
      simp
    simp only [Finset.mem_union] at hv
    tauto
  refine ⟨.R, hvR, ?_⟩
  intro t hvt
  by_contra hne
  exact (Finset.disjoint_left.mp (B.disjoint_side hne)) hvt hvR

/-- One of the nine blocks obtained by overlaying two type-C partitions. -/
noncomputable def block {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) (s t : Side) : Finset V :=
  B.side s ∩ C.side t

/-- The four auxiliary shores `H1,...,H4` in Tashkinov's overlay. -/
noncomputable def overlayH1 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  block B C .L .L ∪ block B C .M .M

noncomputable def overlayH2 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  block B C .L .M ∪ block B C .M .L

noncomputable def overlayH3 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  block B C .L .R ∪ block B C .M .R

noncomputable def overlayH4 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  block B C .R .L ∪ block B C .R .M

/-- Edge multiplicity between two named blocks of an overlay. -/
noncomputable def overlayEdge {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (s t s' t' : Side) : ℕ :=
  (Pseudograph.ofSimple G).betweenMultiplicity
    (block B C s t) (block B C s' t')

lemma overlayEdge_comm {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (s t s' t' : Side) :
    overlayEdge B C s t s' t' = overlayEdge B C s' t' s t := by
  exact Pseudograph.betweenMultiplicity_comm _ _ _

@[simp] lemma mem_block {G : SimpleGraph V} {u v x : V}
    {B : TypeCBarrier G u} {C : TypeCBarrier G v} {s t : Side} :
    x ∈ block B C s t ↔ x ∈ B.side s ∧ x ∈ C.side t := by
  simp [block]

/-- Swapping the two barriers transposes the block matrix. -/
lemma block_swap {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) (s t : Side) :
    block C B s t = block B C t s := by
  classical
  simp [block, Finset.inter_comm]

/-- Distinct coordinates give disjoint blocks. -/
lemma disjoint_block {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    {s t s' t' : Side} (hne : s ≠ s' ∨ t ≠ t') :
    Disjoint (block B C s t) (block B C s' t') := by
  classical
  rw [Finset.disjoint_left]
  intro x hx hx'
  have hx := mem_block.mp hx
  have hx' := mem_block.mp hx'
  rcases hne with hs | ht
  · exact (Finset.disjoint_left.mp (B.disjoint_side hs)) hx.1 hx'.1
  · exact (Finset.disjoint_left.mp (C.disjoint_side ht)) hx.2 hx'.2

/-- The three blocks in one row recover the corresponding first-barrier
side. -/
lemma block_row_union {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) (s : Side) :
    block B C s .L ∪ block B C s .M ∪ block B C s .R = B.side s := by
  classical
  ext x
  constructor
  · intro hx
    simp only [Finset.mem_union] at hx
    rcases hx with (hx | hx) | hx
    · exact (mem_block.mp hx).1
    · exact (mem_block.mp hx).1
    · exact (mem_block.mp hx).1
  · intro hx
    obtain ⟨t, hxt, _⟩ := C.existsUnique_mem_side x
    cases t with
    | L =>
        exact Finset.mem_union_left _
          (Finset.mem_union_left _ (mem_block.mpr ⟨hx, hxt⟩))
    | M =>
        exact Finset.mem_union_left _
          (Finset.mem_union_right _ (mem_block.mpr ⟨hx, hxt⟩))
    | R =>
        exact Finset.mem_union_right _ (mem_block.mpr ⟨hx, hxt⟩)

/-- The three blocks in one column recover the corresponding second-barrier
side. -/
lemma block_column_union {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) (t : Side) :
    block B C .L t ∪ block B C .M t ∪ block B C .R t = C.side t := by
  classical
  ext x
  constructor
  · intro hx
    simp only [Finset.mem_union] at hx
    rcases hx with (hx | hx) | hx
    · exact (mem_block.mp hx).2
    · exact (mem_block.mp hx).2
    · exact (mem_block.mp hx).2
  · intro hx
    obtain ⟨s, hxs, _⟩ := B.existsUnique_mem_side x
    cases s with
    | L =>
        exact Finset.mem_union_left _
          (Finset.mem_union_left _ (mem_block.mpr ⟨hxs, hx⟩))
    | M =>
        exact Finset.mem_union_left _
          (Finset.mem_union_right _ (mem_block.mpr ⟨hxs, hx⟩))
    | R =>
        exact Finset.mem_union_right _ (mem_block.mpr ⟨hxs, hx⟩)

/-- The nine blocks cover all vertices. -/
lemma union_blocks {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    ((block B C .L .L ∪ block B C .L .M ∪ block B C .L .R) ∪
      (block B C .M .L ∪ block B C .M .M ∪ block B C .M .R)) ∪
      (block B C .R .L ∪ block B C .R .M ∪ block B C .R .R) =
        Finset.univ := by
  classical
  rw [B.block_row_union C .L, B.block_row_union C .M,
    B.block_row_union C .R]
  exact B.union_sides

lemma block_row_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) (s : Side) :
    (block B C s .L).card + (block B C s .M).card +
      (block B C s .R).card = (B.side s).card := by
  have hLM : Disjoint (block B C s .L) (block B C s .M) :=
    B.disjoint_block C (.inr (by decide))
  have hLR : Disjoint (block B C s .L) (block B C s .R) :=
    B.disjoint_block C (.inr (by decide))
  have hMR : Disjoint (block B C s .M) (block B C s .R) :=
    B.disjoint_block C (.inr (by decide))
  have hLMR : Disjoint (block B C s .L ∪ block B C s .M)
      (block B C s .R) :=
    Finset.disjoint_union_left.mpr ⟨hLR, hMR⟩
  have hrow := congrArg Finset.card (B.block_row_union C s)
  rw [Finset.card_union_of_disjoint hLMR,
    Finset.card_union_of_disjoint hLM] at hrow
  omega

lemma sides_card {G : SimpleGraph V} {u : V} (B : TypeCBarrier G u) :
    B.left.card + B.middle.card + B.right.card = Nat.card V := by
  have hLMR : Disjoint (B.left ∪ B.middle) B.right :=
    Finset.disjoint_union_left.mpr
      ⟨B.disjoint_left_right, B.disjoint_middle_right⟩
  have hcard := congrArg Finset.card B.union_sides
  simp only [side_L, side_M, side_R] at hcard
  rw [Finset.card_union_of_disjoint hLMR,
    Finset.card_union_of_disjoint B.disjoint_left_middle] at hcard
  simpa [Nat.card_eq_fintype_card] using hcard

lemma overlayH1_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (overlayH1 B C).card = (block B C .L .L).card +
      (block B C .M .M).card := by
  exact Finset.card_union_of_disjoint
    (B.disjoint_block C (.inl (by decide)))

lemma overlayH2_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (overlayH2 B C).card = (block B C .L .M).card +
      (block B C .M .L).card := by
  exact Finset.card_union_of_disjoint
    (B.disjoint_block C (.inl (by decide)))

lemma overlayH3_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (overlayH3 B C).card = (block B C .L .R).card +
      (block B C .M .R).card := by
  exact Finset.card_union_of_disjoint
    (B.disjoint_block C (.inl (by decide)))

lemma overlayH4_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (overlayH4 B C).card = (block B C .R .L).card +
      (block B C .R .M).card := by
  exact Finset.card_union_of_disjoint
    (B.disjoint_block C (.inr (by decide)))

/-- The four auxiliary shores together with `X33` partition the vertices,
recorded as the cardinal identity used for parity in Section 5. -/
lemma overlay_groups_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (overlayH1 B C).card + (overlayH2 B C).card +
      (overlayH3 B C).card + (overlayH4 B C).card +
      (block B C .R .R).card = Nat.card V := by
  have hL := B.block_row_card C .L
  have hM := B.block_row_card C .M
  have hR := B.block_row_card C .R
  have hsides := B.sides_card
  have h1 := B.overlayH1_card C
  have h2 := B.overlayH2_card C
  have h3 := B.overlayH3_card C
  have h4 := B.overlayH4_card C
  simp only [side_L] at hL
  simp only [side_M] at hM
  simp only [side_R] at hR
  omega

lemma first_right_overlay_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    B.right.card = (overlayH4 B C).card + (block B C .R .R).card := by
  have hrow := B.block_row_card C .R
  have h4 := B.overlayH4_card C
  simp only [side_R] at hrow
  omega

lemma second_right_overlay_card {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    C.right.card = (overlayH3 B C).card + (block B C .R .R).card := by
  have hcol := C.block_row_card B .R
  have h3 := B.overlayH3_card C
  simp only [side_R, block_swap] at hcol
  omega

lemma disjoint_H1_H3 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (overlayH1 B C) (overlayH3 B C) := by
  exact Finset.disjoint_union_left.mpr
    ⟨Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inr (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inr (by decide))⟩⟩

lemma disjoint_H1_H2 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (overlayH1 B C) (overlayH2 B C) := by
  exact Finset.disjoint_union_left.mpr
    ⟨Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inr (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inr (by decide))⟩⟩

lemma disjoint_H1_H4 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (overlayH1 B C) (overlayH4 B C) := by
  exact Finset.disjoint_union_left.mpr
    ⟨Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩⟩

lemma disjoint_H2_H3 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (overlayH2 B C) (overlayH3 B C) := by
  exact Finset.disjoint_union_left.mpr
    ⟨Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inr (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inr (by decide))⟩⟩

lemma disjoint_H2_H4 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (overlayH2 B C) (overlayH4 B C) := by
  exact Finset.disjoint_union_left.mpr
    ⟨Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩⟩

lemma disjoint_H3_H4 {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (overlayH3 B C) (overlayH4 B C) := by
  exact Finset.disjoint_union_left.mpr
    ⟨Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩⟩

/-- The forbidden coordinate pairs in one type-C partition: the left and
middle sides are independent, and no edge joins left to right. -/
def ForbiddenSidePair : Side → Side → Prop
  | .L, .L => True
  | .M, .M => True
  | .L, .R => True
  | .R, .L => True
  | _, _ => False

/-- A forbidden pair of sides carries no ambient edge. -/
lemma not_adj_of_forbiddenSidePair {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    {s t : Side} (hst : ForbiddenSidePair s t)
    {x y : V} (hx : x ∈ B.side s) (hy : y ∈ B.side t) :
    ¬ G.Adj x y := by
  cases s with
  | L =>
      cases t with
      | L =>
          intro hxy
          exact B.left_isIndepSet hreg hno4 hno6 hx hy hxy.ne hxy
      | M => simp [ForbiddenSidePair] at hst
      | R => exact B.not_adj_left_right hreg hno4 hno6 hx hy
  | M =>
      cases t with
      | L => simp [ForbiddenSidePair] at hst
      | M =>
          intro hxy
          exact B.middle_isIndepSet hx hy hxy.ne hxy
      | R => simp [ForbiddenSidePair] at hst
  | R =>
      cases t with
      | L =>
          intro hxy
          exact B.not_adj_left_right hreg hno4 hno6 hy hx hxy.symm
      | M => simp [ForbiddenSidePair] at hst
      | R => simp [ForbiddenSidePair] at hst

/-- Every neighbour of a left-side vertex lies in the middle side. -/
lemma mem_middle_of_adj_left {G : SimpleGraph V} {u x y : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hx : x ∈ B.left) (hxy : G.Adj x y) : y ∈ B.middle := by
  obtain ⟨s, hys, _⟩ := B.existsUnique_mem_side y
  cases s with
  | L =>
      exfalso
      exact B.left_isIndepSet hreg hno4 hno6 hx hys hxy.ne hxy
  | M => exact hys
  | R => exact False.elim (B.not_adj_left_right hreg hno4 hno6 hx hys hxy)

/-- A neighbour of a middle-side vertex lies on its left or right; the
middle itself is independent. -/
lemma mem_left_or_right_of_adj_middle {G : SimpleGraph V} {u x y : V}
    (B : TypeCBarrier G u) (hx : x ∈ B.middle) (hxy : G.Adj x y) :
    y ∈ B.left ∨ y ∈ B.right := by
  obtain ⟨s, hys, _⟩ := B.existsUnique_mem_side y
  cases s with
  | L => exact .inl hys
  | M =>
      exfalso
      exact B.middle_isIndepSet hx hys hxy.ne hxy
  | R => exact .inr hys

/-- Any vertex of the right component has at least two neighbours remaining
in that component; when it is used as the distinguished vertex of a second
barrier, those neighbours lie in the overlay block `X32`. -/
lemma two_le_right_middle_block_of_mem_right
    {G : SimpleGraph V} {u w : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G w)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hwR : w ∈ B.right) :
    2 ≤ (block B C .R .M).card := by
  classical
  let N := (B.right.erase w).filter (G.Adj w)
  have hwErase : w ∉ B.right.erase w := by simp
  have hcount := B.two_le_between_singleton_right_erase hreg hno4 hno6 w hwR
  rw [Pseudograph.betweenMultiplicity_singleton_ofSimple G w
    (B.right.erase w) hwErase] at hcount
  have hsub : N ⊆ block B C .R .M := by
    intro x hx
    have hx' := Finset.mem_filter.mp hx
    have hxR : x ∈ B.right := Finset.mem_of_mem_erase hx'.1
    have hxM : x ∈ C.middle :=
      C.mem_middle_of_adj_left hreg hno4 hno6 C.mem_left_distinguished hx'.2
    exact mem_block.mpr ⟨hxR, hxM⟩
  exact hcount.trans (Finset.card_le_card hsub)

/-- Dually, if a prospective distinguished vertex lies in the first middle
set and has two neighbours in the first right component, those neighbours
again form two vertices of `X32`. -/
lemma two_le_right_middle_block_of_mem_middle
    {G : SimpleGraph V} {u w : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G w)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hwM : w ∈ B.middle)
    (htwo : (Pseudograph.ofSimple G).betweenMultiplicity {w} B.right = 2) :
    2 ≤ (block B C .R .M).card := by
  classical
  let N := B.right.filter (G.Adj w)
  have hwR : w ∉ B.right := fun hw ↦
    (Finset.disjoint_left.mp B.disjoint_middle_right) hwM hw
  have hNcard : N.card = 2 := by
    have heq :=
      Pseudograph.betweenMultiplicity_singleton_ofSimple G w B.right hwR
    change (Pseudograph.ofSimple G).betweenMultiplicity {w} B.right = N.card at heq
    omega
  have hsub : N ⊆ block B C .R .M := by
    intro x hx
    have hx' := Finset.mem_filter.mp hx
    have hxM : x ∈ C.middle :=
      C.mem_middle_of_adj_left hreg hno4 hno6 C.mem_left_distinguished hx'.2
    exact mem_block.mpr ⟨hx'.1, hxM⟩
  have := Finset.card_le_card hsub
  omega

/-- The data retained from Tashkinov's three-branch choice of the second
distinguished vertex.  A right-side choice has a middle neighbour.  A
middle-side choice is made only after excluding vertices with exactly one
right neighbour, so every first-middle vertex has zero or two such
neighbours.  The cut bound (5.1) supplies the upper bound two. -/
structure TashkinovSelection {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) where
  vertex : V
  mem_right_or_middle : vertex ∈ B.right ∨ vertex ∈ B.middle
  two_le_block₃₂ : ∀ C : TypeCBarrier G vertex,
    2 ≤ (block B C .R .M).card
  right_has_middle_neighbor : vertex ∈ B.right →
    ∃ x ∈ B.middle, G.Adj vertex x
  right_choice_certificate : vertex ∈ B.right →
    2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {vertex} B.middle ∨
      ∃ x ∈ B.middle,
        (Pseudograph.ofSimple G).betweenMultiplicity {x} B.right = 1 ∧
          G.Adj vertex x
  middle_has_right_neighbor : vertex ∈ B.middle →
    ∃ x ∈ B.right, G.Adj vertex x
  middle_right_count : vertex ∈ B.middle → ∀ x ∈ B.middle,
    (Pseudograph.ofSimple G).betweenMultiplicity {x} B.right = 0 ∨
      (Pseudograph.ofSimple G).betweenMultiplicity {x} B.right = 2
  right_middle_count_le_one : vertex ∈ B.middle → ∀ w ∈ B.right,
    (Pseudograph.ofSimple G).betweenMultiplicity {w} B.middle ≤ 1

/-- Tashkinov's selection rule can always be carried out.  The proof uses
exactly its three branches: a right vertex with at least two cut edges; if
none, the unique right neighbour of a middle vertex with one cut edge; and,
if neither exists, any middle endpoint of the nonempty eight-cut. -/
lemma exists_tashkinovSelection
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    Nonempty (TashkinovSelection B) := by
  classical
  let P := Pseudograph.ofSimple G
  by_cases hlarge : ∃ w ∈ B.right,
      2 ≤ P.betweenMultiplicity {w} B.middle
  · obtain ⟨w, hwR, hwlarge⟩ := hlarge
    have hwM : w ∉ B.middle := fun hw ↦
      (Finset.disjoint_left.mp B.disjoint_middle_right) hw hwR
    have hfilter :=
      Pseudograph.betweenMultiplicity_singleton_ofSimple G w B.middle hwM
    have hcard : 2 ≤ (B.middle.filter (G.Adj w)).card := by
      change P.betweenMultiplicity {w} B.middle = _ at hfilter
      omega
    obtain ⟨x, hx⟩ := Finset.card_pos.mp (by omega :
      0 < (B.middle.filter (G.Adj w)).card)
    have hx' := Finset.mem_filter.mp hx
    refine ⟨{
      vertex := w
      mem_right_or_middle := .inl hwR
      two_le_block₃₂ := fun C ↦
        B.two_le_right_middle_block_of_mem_right C hreg hno4 hno6 hwR
      right_has_middle_neighbor := fun _ ↦ ⟨x, hx'.1, hx'.2⟩
      right_choice_certificate := fun _ ↦ .inl hwlarge
      middle_has_right_neighbor := ?_
      middle_right_count := ?_
      right_middle_count_le_one := ?_ }⟩
    intro hwMiddle
    exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
      hwMiddle hwR)
    intro hwMiddle
    exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
      hwMiddle hwR)
    intro hwMiddle
    exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
      hwMiddle hwR)
  · by_cases hone : ∃ x ∈ B.middle,
        P.betweenMultiplicity {x} B.right = 1
    · obtain ⟨x, hxM, hxone⟩ := hone
      have hxR : x ∉ B.right := fun hx ↦
        (Finset.disjoint_left.mp B.disjoint_middle_right) hxM hx
      have hfilter :=
        Pseudograph.betweenMultiplicity_singleton_ofSimple G x B.right hxR
      have hcard : (B.right.filter (G.Adj x)).card = 1 := by
        change P.betweenMultiplicity {x} B.right = _ at hfilter
        omega
      obtain ⟨w, hwEq⟩ := Finset.card_eq_one.mp hcard
      have hw : w ∈ B.right.filter (G.Adj x) := by simp [hwEq]
      have hw' := Finset.mem_filter.mp hw
      refine ⟨{
        vertex := w
        mem_right_or_middle := .inl hw'.1
        two_le_block₃₂ := fun C ↦
          B.two_le_right_middle_block_of_mem_right C hreg hno4 hno6 hw'.1
        right_has_middle_neighbor := fun _ ↦ ⟨x, hxM, hw'.2.symm⟩
        right_choice_certificate := fun _ ↦
          .inr ⟨x, hxM, hxone, hw'.2.symm⟩
        middle_has_right_neighbor := ?_
        middle_right_count := ?_
        right_middle_count_le_one := ?_ }⟩
      intro hwMiddle
      exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
        hwMiddle hw'.1)
      intro hwMiddle
      exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
        hwMiddle hw'.1)
      intro hwMiddle
      exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
        hwMiddle hw'.1)
    · have hadj : ∃ x ∈ B.middle, ∃ w ∈ B.right, G.Adj x w := by
        by_contra hn
        push_neg at hn
        have hz := betweenMultiplicity_eq_zero_of_no_adj
          G B.middle B.right (fun x hx w hw ↦ hn x hx w hw)
        have hRM := (B.typeC_degree_ledger hreg hno4 hno6).2.1
        rw [Pseudograph.betweenMultiplicity_comm] at hRM
        change P.betweenMultiplicity B.middle B.right = 8 at hRM
        change P.betweenMultiplicity B.middle B.right = 0 at hz
        omega
      obtain ⟨x, hxM, w, hwR, hxw⟩ := hadj
      have hxR : x ∉ B.right := fun hx ↦
        (Finset.disjoint_left.mp B.disjoint_middle_right) hxM hx
      have hcountPos : 0 < P.betweenMultiplicity {x} B.right := by
        have hfilter :=
          Pseudograph.betweenMultiplicity_singleton_ofSimple G x B.right hxR
        change P.betweenMultiplicity {x} B.right = _ at hfilter
        have hw : w ∈ B.right.filter (G.Adj x) := by simp [hwR, hxw]
        have hpos := Finset.card_pos.mpr ⟨w, hw⟩
        omega
      have hcountLe := B.between_singleton_right_le_two hreg hno4 hno6 x hxR
      change P.betweenMultiplicity {x} B.right ≤ 2 at hcountLe
      have hcountNeOne : P.betweenMultiplicity {x} B.right ≠ 1 := by
        intro heq
        exact hone ⟨x, hxM, heq⟩
      have hcountTwo : P.betweenMultiplicity {x} B.right = 2 := by omega
      refine ⟨{
        vertex := x
        mem_right_or_middle := .inr hxM
        two_le_block₃₂ := fun C ↦
          B.two_le_right_middle_block_of_mem_middle C hreg hno4 hno6 hxM hcountTwo
        right_has_middle_neighbor := ?_
        right_choice_certificate := ?_
        middle_has_right_neighbor := fun _ ↦ ⟨w, hwR, hxw⟩
        middle_right_count := ?_
        right_middle_count_le_one := ?_ }⟩
      · intro hxRight
        exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
          hxM hxRight)
      · intro hxRight
        exact False.elim ((Finset.disjoint_left.mp B.disjoint_middle_right)
          hxM hxRight)
      · intro _ y hyM
        have hyR : y ∉ B.right := fun hy ↦
          (Finset.disjoint_left.mp B.disjoint_middle_right) hyM hy
        have hle := B.between_singleton_right_le_two hreg hno4 hno6 y hyR
        change P.betweenMultiplicity {y} B.right ≤ 2 at hle
        by_cases hzero : P.betweenMultiplicity {y} B.right = 0
        · exact .inl hzero
        · right
          change P.betweenMultiplicity {y} B.right = 2
          have hneone : P.betweenMultiplicity {y} B.right ≠ 1 := by
            intro heq
            exact hone ⟨y, hyM, heq⟩
          omega
      · intro _ z hzR
        have hnot : ¬ 2 ≤ P.betweenMultiplicity {z} B.middle := by
          intro htwo
          exact hlarge ⟨z, hzR, htwo⟩
        change P.betweenMultiplicity {z} B.middle ≤ 1
        omega

/-- Select the second distinguished vertex inside the first right
component.  Two of its neighbours remain in that component; since every
neighbour of a barrier's distinguished left vertex lies in its middle, the
overlay block `X₃₂` has at least two vertices. -/
lemma exists_distinguished_with_two_le_right_middle_block
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    ∃ w ∈ B.right, ∀ C : TypeCBarrier G w,
      2 ≤ (block B C .R .M).card := by
  classical
  obtain ⟨w, hwR, x, hxR, y, hyR, hxy, hwx, hwy⟩ :=
    B.exists_vertex_with_two_right_neighbors hreg
  refine ⟨w, hwR, ?_⟩
  intro C
  have hwL : w ∈ C.left := C.mem_left_distinguished
  have hxM : x ∈ C.middle :=
    C.mem_middle_of_adj_left hreg hno4 hno6 hwL hwx
  have hyM : y ∈ C.middle :=
    C.mem_middle_of_adj_left hreg hno4 hno6 hwL hwy
  exact Finset.one_lt_card.mpr
    ⟨x, mem_block.mpr ⟨hxR, hxM⟩,
      y, mem_block.mpr ⟨hyR, hyM⟩, hxy⟩

/-- If the first right component is globally minimal and `X32` is nonempty,
the part of the second right component lying outside the first one is
nonempty.  Otherwise the second right component is a strict subset of the
first: an `X32` vertex witnesses strictness. -/
lemma upper_right_column_nonempty_of_rightMinimal
    {G : SimpleGraph V} {u w : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G w)
    (hminimal : ∀ (v : V) (D : TypeCBarrier G v),
      B.right.card ≤ D.right.card)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card) :
    (block B C .L .R ∪ block B C .M .R).Nonempty := by
  classical
  let S := block B C .L .R ∪ block B C .M .R
  by_contra hS
  have hSempty : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
  have hsub : C.right ⊆ B.right := by
    intro x hxC
    obtain ⟨s, hxs, _⟩ := B.existsUnique_mem_side x
    cases s with
    | L =>
        exfalso
        have hxS : x ∈ S :=
          Finset.mem_union_left _ (mem_block.mpr ⟨hxs, hxC⟩)
        simpa [hSempty] using hxS
    | M =>
        exfalso
        have hxS : x ∈ S :=
          Finset.mem_union_right _ (mem_block.mpr ⟨hxs, hxC⟩)
        simpa [hSempty] using hxS
    | R => exact hxs
  obtain ⟨x, hx⟩ := Finset.card_pos.mp (by omega :
    0 < (block B C .R .M).card)
  have hx' := mem_block.mp hx
  have hxnotC : x ∉ C.right := fun hxC ↦
    (Finset.disjoint_left.mp C.disjoint_middle_right) hx'.2 hxC
  have hne : C.right ≠ B.right := by
    intro hEq
    exact hxnotC (by simpa [hEq] using hx'.1)
  have hlt : C.right.card < B.right.card :=
    Finset.card_lt_card
      (Finset.ssubset_iff_subset_ne.mpr ⟨hsub, hne⟩)
  exact (Nat.not_lt_of_ge (hminimal w C)) hlt

/-- The opposite shore cannot be a singleton either: the selected block
`X₃₂` contributes at least two vertices to the first right component,
whereas a singleton opposite shore would contribute only one to the second.
The common `X₃₃` block then contradicts global minimality. -/
lemma upper_right_column_card_ne_one_of_rightMinimal
    {G : SimpleGraph V} {u w : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G w)
    (hminimal : ∀ (v : V) (D : TypeCBarrier G v),
      B.right.card ≤ D.right.card)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card) :
    (block B C .L .R ∪ block B C .M .R).card ≠ 1 := by
  classical
  let A := block B C .R .L ∪ block B C .R .M
  let D := block B C .L .R ∪ block B C .M .R
  let X := block B C .R .R
  have hAcard : 2 ≤ A.card :=
    hcard₃₂.trans (Finset.card_le_card Finset.subset_union_right)
  have hAX : Disjoint A X := by
    exact Finset.disjoint_union_left.mpr
      ⟨B.disjoint_block C (.inr (by decide)),
        B.disjoint_block C (.inr (by decide))⟩
  have hDX : Disjoint D X := by
    exact Finset.disjoint_union_left.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  have hBcard : B.right.card = A.card + X.card := by
    calc
      B.right.card = (A ∪ X).card := by
        simpa only [A, X, side_R] using
          congrArg Finset.card (B.block_row_union C .R).symm
      _ = A.card + X.card := Finset.card_union_of_disjoint hAX
  have hCcard : C.right.card = D.card + X.card := by
    calc
      C.right.card = (D ∪ X).card := by
        simpa only [D, X, side_R] using
          congrArg Finset.card (B.block_column_union C .R).symm
      _ = D.card + X.card := Finset.card_union_of_disjoint hDX
  intro hDone
  change D.card = 1 at hDone
  have hmin := hminimal w C
  omega

/-- If a pair of row coordinates is forbidden by the first barrier, every
edge count between the corresponding overlay blocks is zero. -/
lemma between_block_eq_zero_of_forbidden_row
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    {s s' t t' : Side} (hss : ForbiddenSidePair s s') :
    (Pseudograph.ofSimple G).betweenMultiplicity
      (block B C s t) (block B C s' t') = 0 := by
  apply betweenMultiplicity_eq_zero_of_no_adj
  intro x hx y hy
  exact B.not_adj_of_forbiddenSidePair hreg hno4 hno6 hss
    (mem_block.mp hx).1 (mem_block.mp hy).1

/-- The analogous zero rule for column coordinates and the second barrier. -/
lemma between_block_eq_zero_of_forbidden_column
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    {s s' t t' : Side} (htt : ForbiddenSidePair t t') :
    (Pseudograph.ofSimple G).betweenMultiplicity
      (block B C s t) (block B C s' t') = 0 := by
  apply betweenMultiplicity_eq_zero_of_no_adj
  intro x hx y hy
  exact C.not_adj_of_forbiddenSidePair hreg hno4 hno6 htt
    (mem_block.mp hx).2 (mem_block.mp hy).2

/-- The first exact five-term equation in Tashkinov's final overlay ledger:
expand the eight edges from the first barrier's right side to its middle,
then remove the four terms forbidden by the second partition. -/
lemma first_right_middle_overlay_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    let P := Pseudograph.ofSimple G
    P.betweenMultiplicity (block B C .R .L) (block B C .M .M) +
      P.betweenMultiplicity (block B C .R .M) (block B C .M .L) +
      P.betweenMultiplicity (block B C .R .M) (block B C .M .R) +
      P.betweenMultiplicity (block B C .R .R) (block B C .M .M) +
      P.betweenMultiplicity (block B C .R .R) (block B C .M .R) = 8 := by
  classical
  let P := Pseudograph.ofSimple G
  let A₁ := block B C .R .L
  let A₂ := block B C .R .M
  let A₃ := block B C .R .R
  let D₁ := block B C .M .L
  let D₂ := block B C .M .M
  let D₃ := block B C .M .R
  have hA₁₂ : Disjoint A₁ A₂ :=
    B.disjoint_block C (.inr (by decide))
  have hA₁₃ : Disjoint A₁ A₃ :=
    B.disjoint_block C (.inr (by decide))
  have hA₂₃ : Disjoint A₂ A₃ :=
    B.disjoint_block C (.inr (by decide))
  have hA₁₂₃ : Disjoint (A₁ ∪ A₂) A₃ :=
    Finset.disjoint_union_left.mpr ⟨hA₁₃, hA₂₃⟩
  have hD₁₂ : Disjoint D₁ D₂ :=
    B.disjoint_block C (.inr (by decide))
  have hD₁₃ : Disjoint D₁ D₃ :=
    B.disjoint_block C (.inr (by decide))
  have hD₂₃ : Disjoint D₂ D₃ :=
    B.disjoint_block C (.inr (by decide))
  have hD₁₂₃ : Disjoint (D₁ ∪ D₂) D₃ :=
    Finset.disjoint_union_left.mpr ⟨hD₁₃, hD₂₃⟩
  have hAD : Disjoint ((A₁ ∪ A₂) ∪ A₃) ((D₁ ∪ D₂) ∪ D₃) := by
    simpa [A₁, A₂, A₃, D₁, D₂, D₃,
      B.block_row_union C .R, B.block_row_union C .M] using
        B.disjoint_middle_right.symm
  have hexpand := P.betweenMultiplicity_three_by_three
    A₁ A₂ A₃ D₁ D₂ D₃ hA₁₂ hA₁₂₃ hD₁₂ hD₁₂₃ hAD
  have hB8 : P.betweenMultiplicity B.right B.middle = 8 := by
    simpa [P] using (B.typeC_degree_ledger hreg hno4 hno6).2.1
  have hzero₁ : P.betweenMultiplicity A₁ D₁ = 0 := by
    simpa [P, A₁, D₁] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .L) (t' := .L) (by trivial))
  have hzero₂ : P.betweenMultiplicity A₁ D₃ = 0 := by
    simpa [P, A₁, D₃] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .L) (t' := .R) (by trivial))
  have hzero₃ : P.betweenMultiplicity A₂ D₂ = 0 := by
    simpa [P, A₂, D₂] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .M) (t' := .M) (by trivial))
  have hzero₄ : P.betweenMultiplicity A₃ D₁ = 0 := by
    simpa [P, A₃, D₁] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .R) (t' := .L) (by trivial))
  rw [B.block_row_union C .R, B.block_row_union C .M] at hexpand
  change P.betweenMultiplicity B.right B.middle = _ at hexpand
  rw [hB8, hzero₁, hzero₂, hzero₃, hzero₄] at hexpand
  change P.betweenMultiplicity A₁ D₂ + P.betweenMultiplicity A₂ D₁ +
    P.betweenMultiplicity A₂ D₃ + P.betweenMultiplicity A₃ D₂ +
    P.betweenMultiplicity A₃ D₃ = 8
  omega

/-- The transposed five-term equation, obtained from the eight edges between
the second barrier's right and middle sides. -/
lemma second_right_middle_overlay_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    let P := Pseudograph.ofSimple G
    P.betweenMultiplicity (block B C .L .R) (block B C .M .M) +
      P.betweenMultiplicity (block B C .M .R) (block B C .L .M) +
      P.betweenMultiplicity (block B C .M .R) (block B C .R .M) +
      P.betweenMultiplicity (block B C .R .R) (block B C .M .M) +
      P.betweenMultiplicity (block B C .R .R) (block B C .R .M) = 8 := by
  simpa only [block_swap] using
    C.first_right_middle_overlay_ledger B hreg hno4 hno6

/-- Every edge incident with the left-left overlay block enters the
middle-middle block.  Summing the quartic degrees gives the first diagonal
degree equation used in (5.5). -/
lemma left_left_middle_middle_degree_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
      (block B C .L .L) (block B C .M .M) =
        4 * (block B C .L .L).card := by
  classical
  let S := block B C .L .L
  let T := block B C .M .M
  have hST : Disjoint S T :=
    B.disjoint_block C (.inl (by decide))
  have hS : G.IsIndepSet (S : Set V) := by
    intro x hx y hy hxy
    exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx).1 (mem_block.mp hy).1 hxy
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∈ T := by
    intro x hx y hxy
    have hx' := mem_block.mp hx
    exact mem_block.mpr
      ⟨B.mem_middle_of_adj_left hreg hno4 hno6 hx'.1 hxy,
        C.mem_middle_of_adj_left hreg hno4 hno6 hx'.2 hxy⟩
  exact betweenMultiplicity_eq_regular_mul_card_of_independent
    G hreg S T hST hS hneighbors

/-- Expanding the degrees of the middle-middle block: its neighbours lie in
the four corner blocks. -/
lemma middle_middle_corner_degree_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    let P := Pseudograph.ofSimple G
    P.betweenMultiplicity (block B C .M .M) (block B C .L .L) +
      P.betweenMultiplicity (block B C .M .M) (block B C .L .R) +
      P.betweenMultiplicity (block B C .M .M) (block B C .R .L) +
      P.betweenMultiplicity (block B C .M .M) (block B C .R .R) =
        4 * (block B C .M .M).card := by
  classical
  let P := Pseudograph.ofSimple G
  let S := block B C .M .M
  let T₁ := block B C .L .L
  let T₂ := block B C .L .R
  let T₃ := block B C .R .L
  let T₄ := block B C .R .R
  let T := ((T₁ ∪ T₂) ∪ T₃) ∪ T₄
  have hT₁₂ : Disjoint T₁ T₂ :=
    B.disjoint_block C (.inr (by decide))
  have hT₁₃ : Disjoint T₁ T₃ :=
    B.disjoint_block C (.inl (by decide))
  have hT₂₃ : Disjoint T₂ T₃ :=
    B.disjoint_block C (.inl (by decide))
  have hT₁₂₃ : Disjoint (T₁ ∪ T₂) T₃ :=
    Finset.disjoint_union_left.mpr ⟨hT₁₃, hT₂₃⟩
  have hT₁₄ : Disjoint T₁ T₄ :=
    B.disjoint_block C (.inl (by decide))
  have hT₂₄ : Disjoint T₂ T₄ :=
    B.disjoint_block C (.inl (by decide))
  have hT₃₄ : Disjoint T₃ T₄ :=
    B.disjoint_block C (.inr (by decide))
  have hT₁₂₃₄ : Disjoint ((T₁ ∪ T₂) ∪ T₃) T₄ :=
    Finset.disjoint_union_left.mpr
      ⟨Finset.disjoint_union_left.mpr ⟨hT₁₄, hT₂₄⟩, hT₃₄⟩
  have hST : Disjoint S T := by
    rw [Finset.disjoint_left]
    intro x hxS hxT
    have hxS' := mem_block.mp hxS
    simp only [T, Finset.mem_union] at hxT
    rcases hxT with ((hxT | hxT) | hxT) | hxT
    · exact (Finset.disjoint_left.mp B.disjoint_left_middle)
        (mem_block.mp hxT).1 hxS'.1
    · exact (Finset.disjoint_left.mp B.disjoint_left_middle)
        (mem_block.mp hxT).1 hxS'.1
    · exact (Finset.disjoint_left.mp C.disjoint_left_middle)
        (mem_block.mp hxT).2 hxS'.2
    · exact (Finset.disjoint_left.mp B.disjoint_middle_right)
        hxS'.1 (mem_block.mp hxT).1
  have hS : G.IsIndepSet (S : Set V) := by
    intro x hx y hy hxy
    exact B.middle_isIndepSet (mem_block.mp hx).1 (mem_block.mp hy).1 hxy
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∈ T := by
    intro x hx y hxy
    have hx' := mem_block.mp hx
    have hyB := B.mem_left_or_right_of_adj_middle hx'.1 hxy
    have hyC := C.mem_left_or_right_of_adj_middle hx'.2 hxy
    rcases hyB with hyBL | hyBR <;> rcases hyC with hyCL | hyCR
    · exact Finset.mem_union_left _
        (Finset.mem_union_left _
          (Finset.mem_union_left _ (mem_block.mpr ⟨hyBL, hyCL⟩)))
    · exact Finset.mem_union_left _
        (Finset.mem_union_left _
          (Finset.mem_union_right _ (mem_block.mpr ⟨hyBL, hyCR⟩)))
    · exact Finset.mem_union_left _
        (Finset.mem_union_right _ (mem_block.mpr ⟨hyBR, hyCL⟩))
    · exact Finset.mem_union_right _ (mem_block.mpr ⟨hyBR, hyCR⟩)
  have hdegree : P.betweenMultiplicity S T = 4 * S.card := by
    simpa [P] using betweenMultiplicity_eq_regular_mul_card_of_independent
      G hreg S T hST hS hneighbors
  have hST₁₂₃ : Disjoint S ((T₁ ∪ T₂) ∪ T₃) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hST
  have hST₁₂ : Disjoint S (T₁ ∪ T₂) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hST₁₂₃
  rw [show T = ((T₁ ∪ T₂) ∪ T₃) ∪ T₄ by rfl,
    P.betweenMultiplicity_union_right S ((T₁ ∪ T₂) ∪ T₃) T₄
      hT₁₂₃₄ hST,
    P.betweenMultiplicity_union_right S (T₁ ∪ T₂) T₃
      hT₁₂₃ hST₁₂₃,
    P.betweenMultiplicity_union_right S T₁ T₂ hT₁₂ hST₁₂] at hdegree
  simpa [P, S, T₁, T₂, T₃, T₄] using hdegree

/-- The pre-parity form of equation (5.5).  It is the difference between
the middle-middle and left-left degree sums; the third term is later forced
to zero by the two eight-cut inequalities. -/
lemma diagonal_card_difference_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    let P := Pseudograph.ofSimple G
    4 * (block B C .L .L).card +
      P.betweenMultiplicity (block B C .L .R) (block B C .M .M) +
      P.betweenMultiplicity (block B C .R .L) (block B C .M .M) +
      P.betweenMultiplicity (block B C .R .R) (block B C .M .M) =
        4 * (block B C .M .M).card := by
  have hLL := B.left_left_middle_middle_degree_ledger C hreg hno4 hno6
  have hMM := B.middle_middle_corner_degree_ledger C hreg hno4 hno6
  dsimp only at hMM
  rw [Pseudograph.betweenMultiplicity_comm _ (block B C .M .M)
    (block B C .L .L), hLL,
    Pseudograph.betweenMultiplicity_comm _ (block B C .M .M)
      (block B C .L .R),
    Pseudograph.betweenMultiplicity_comm _ (block B C .M .M)
      (block B C .R .L),
    Pseudograph.betweenMultiplicity_comm _ (block B C .M .M)
      (block B C .R .R)] at hMM
  exact hMM

/-- Pure arithmetic behind (5.4): the two exact eight-edge equations and
the two crossed lower bounds force the shared diagonal count to vanish, the
two tail counts to agree, and the remaining two-term sums to agree. -/
lemma overlay_first_stage_arithmetic
    {a₁ b₁ a₂ b₂ c d l₁ l₂ : ℕ}
    (heq₁ : a₁ + b₁ + c + d + l₁ = 8)
    (heq₂ : a₂ + b₂ + c + d + l₂ = 8)
    (hlower₁ : 8 ≤ a₁ + b₁ + c + l₂)
    (hlower₂ : 8 ≤ a₂ + b₂ + c + l₁) :
    d = 0 ∧ l₁ = l₂ ∧ a₁ + b₁ = a₂ + b₂ := by
  omega

/-- The degree-sum form of the boundary identity for `H1`. -/
lemma diagonal_boundary_card_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).boundaryMultiplicity
        (block B C .L .L ∪ block B C .M .M) +
      4 * (block B C .L .L).card =
        4 * (block B C .M .M).card := by
  classical
  let P := Pseudograph.ofSimple G
  let A := block B C .L .L
  let D := block B C .M .M
  let S := A ∪ D
  have hAD : Disjoint A D := B.disjoint_block C (.inl (by decide))
  have hcard := Finset.card_union_of_disjoint hAD
  have hAint : P.internalMultiplicity A = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G A (by
      intro x hx y hy hxy
      exact B.left_isIndepSet hreg hno4 hno6
        (mem_block.mp hx).1 (mem_block.mp hy).1 hxy)
  have hDint : P.internalMultiplicity D = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G D (by
      intro x hx y hy hxy
      exact B.middle_isIndepSet (mem_block.mp hx).1 (mem_block.mp hy).1 hxy)
  have hADedges := B.left_left_middle_middle_degree_ledger C hreg hno4 hno6
  change P.betweenMultiplicity A D = 4 * A.card at hADedges
  have hint := P.internalMultiplicity_union A D hAD
  change P.internalMultiplicity S = _ at hint
  rw [hAint, hDint, Nat.zero_add, hADedges] at hint
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hdegree := P.regular_card_eq_two_internal_add_boundary hregular S
  change P.boundaryMultiplicity S + 4 * A.card = 4 * D.card
  change S.card = A.card + D.card at hcard
  omega

/-- The boundary of `H1 = X11 ∪ X22` is `nu1 + nu + nu2`.
This is the cut identity used in both numerical cases of Section 5. -/
lemma diagonal_boundary_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).boundaryMultiplicity
        (block B C .L .L ∪ block B C .M .M) =
      overlayEdge B C .R .L .M .M +
        overlayEdge B C .R .R .M .M +
        overlayEdge B C .L .R .M .M := by
  have hcard := B.diagonal_boundary_card_ledger C hreg hno4 hno6
  have hdiag := B.diagonal_card_difference_ledger C hreg hno4 hno6
  dsimp only at hdiag
  change 4 * (block B C .L .L).card +
      overlayEdge B C .L .R .M .M +
      overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .R .M .M =
        4 * (block B C .M .M).card at hdiag
  omega

/-- After the shared diagonal count has vanished, the diagonal degree
ledger is the exact natural-number form of `4t = ν₁+ν₂`. -/
lemma diagonal_card_difference_of_overlay_first_stage
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hzero : (Pseudograph.ofSimple G).betweenMultiplicity
      (block B C .R .R) (block B C .M .M) = 0) :
    4 * (block B C .L .L).card +
      (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .L .R) (block B C .M .M) +
      (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .R .L) (block B C .M .M) =
        4 * (block B C .M .M).card := by
  have h := B.diagonal_card_difference_ledger C hreg hno4 hno6
  dsimp only at h
  rw [hzero, Nat.add_zero] at h
  exact h

/-- The boundary of `X₃₁ ∪ X₃₂` is exactly the four-term expression in the
first inequality of (5.3). -/
lemma lower_right_row_boundary_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    let P := Pseudograph.ofSimple G
    let S := block B C .R .L ∪ block B C .R .M
    P.boundaryMultiplicity S =
      P.betweenMultiplicity (block B C .R .L) (block B C .M .M) +
      P.betweenMultiplicity (block B C .R .M) (block B C .M .L) +
      P.betweenMultiplicity (block B C .R .M) (block B C .M .R) +
      P.betweenMultiplicity (block B C .R .M) (block B C .R .R) := by
  classical
  let P := Pseudograph.ofSimple G
  let S₁ := block B C .R .L
  let S₂ := block B C .R .M
  let S := S₁ ∪ S₂
  let T₁ := block B C .M .M
  let T₂ := block B C .M .L
  let T₃ := block B C .M .R
  let T₄ := block B C .R .R
  let T := ((T₁ ∪ T₂) ∪ T₃) ∪ T₄
  have hS₁S₂ : Disjoint S₁ S₂ :=
    B.disjoint_block C (.inr (by decide))
  have hT₁T₂ : Disjoint T₁ T₂ :=
    B.disjoint_block C (.inr (by decide))
  have hT₁T₃ : Disjoint T₁ T₃ :=
    B.disjoint_block C (.inr (by decide))
  have hT₂T₃ : Disjoint T₂ T₃ :=
    B.disjoint_block C (.inr (by decide))
  have hT₁₂T₃ : Disjoint (T₁ ∪ T₂) T₃ :=
    Finset.disjoint_union_left.mpr ⟨hT₁T₃, hT₂T₃⟩
  have hT₁T₄ : Disjoint T₁ T₄ :=
    B.disjoint_block C (.inl (by decide))
  have hT₂T₄ : Disjoint T₂ T₄ :=
    B.disjoint_block C (.inl (by decide))
  have hT₃T₄ : Disjoint T₃ T₄ :=
    B.disjoint_block C (.inl (by decide))
  have hT₁₂₃T₄ : Disjoint ((T₁ ∪ T₂) ∪ T₃) T₄ :=
    Finset.disjoint_union_left.mpr
      ⟨Finset.disjoint_union_left.mpr ⟨hT₁T₄, hT₂T₄⟩, hT₃T₄⟩
  have hS₁T₁ : Disjoint S₁ T₁ :=
    B.disjoint_block C (.inl (by decide))
  have hS₁T₂ : Disjoint S₁ T₂ :=
    B.disjoint_block C (.inl (by decide))
  have hS₁T₃ : Disjoint S₁ T₃ :=
    B.disjoint_block C (.inl (by decide))
  have hS₁T₄ : Disjoint S₁ T₄ :=
    B.disjoint_block C (.inr (by decide))
  have hS₂T₁ : Disjoint S₂ T₁ :=
    B.disjoint_block C (.inl (by decide))
  have hS₂T₂ : Disjoint S₂ T₂ :=
    B.disjoint_block C (.inl (by decide))
  have hS₂T₃ : Disjoint S₂ T₃ :=
    B.disjoint_block C (.inl (by decide))
  have hS₂T₄ : Disjoint S₂ T₄ :=
    B.disjoint_block C (.inr (by decide))
  have hS₁T : Disjoint S₁ T := by
    exact Finset.disjoint_union_right.mpr
      ⟨Finset.disjoint_union_right.mpr
        ⟨Finset.disjoint_union_right.mpr ⟨hS₁T₁, hS₁T₂⟩, hS₁T₃⟩,
        hS₁T₄⟩
  have hS₂T : Disjoint S₂ T := by
    exact Finset.disjoint_union_right.mpr
      ⟨Finset.disjoint_union_right.mpr
        ⟨Finset.disjoint_union_right.mpr ⟨hS₂T₁, hS₂T₂⟩, hS₂T₃⟩,
        hS₂T₄⟩
  have hST : Disjoint S T :=
    Finset.disjoint_union_left.mpr ⟨hS₁T, hS₂T⟩
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∉ S → y ∈ T := by
    intro x hx y hxy hyS
    simp only [S, Finset.mem_union] at hx
    rcases hx with hx₁ | hx₂
    · have hx₁' := mem_block.mp hx₁
      have hyCM := C.mem_middle_of_adj_left hreg hno4 hno6 hx₁'.2 hxy
      obtain ⟨s, hys, _⟩ := B.existsUnique_mem_side y
      cases s with
      | L =>
          exfalso
          exact B.not_adj_left_right hreg hno4 hno6 hys hx₁'.1 hxy.symm
      | M =>
          exact Finset.mem_union_left _
            (Finset.mem_union_left _
              (Finset.mem_union_left _ (mem_block.mpr ⟨hys, hyCM⟩)))
      | R =>
          exfalso
          exact hyS (Finset.mem_union_right _ (mem_block.mpr ⟨hys, hyCM⟩))
    · have hx₂' := mem_block.mp hx₂
      have hyC := C.mem_left_or_right_of_adj_middle hx₂'.2 hxy
      obtain ⟨s, hys, _⟩ := B.existsUnique_mem_side y
      cases s with
      | L =>
          exfalso
          exact B.not_adj_left_right hreg hno4 hno6 hys hx₂'.1 hxy.symm
      | M =>
          rcases hyC with hyCL | hyCR
          · exact Finset.mem_union_left _
              (Finset.mem_union_left _
                (Finset.mem_union_right _ (mem_block.mpr ⟨hys, hyCL⟩)))
          · exact Finset.mem_union_left _
              (Finset.mem_union_right _ (mem_block.mpr ⟨hys, hyCR⟩))
      | R =>
          rcases hyC with hyCL | hyCR
          · exfalso
            exact hyS (Finset.mem_union_left _ (mem_block.mpr ⟨hys, hyCL⟩))
          · exact Finset.mem_union_right _ (mem_block.mpr ⟨hys, hyCR⟩)
  have hboundary := boundaryMultiplicity_eq_between_of_crossing_neighbors_subset
    G S T hST hneighbors
  have hS₁T₁₂₃ : Disjoint S₁ ((T₁ ∪ T₂) ∪ T₃) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hS₁T
  have hS₂T₁₂₃ : Disjoint S₂ ((T₁ ∪ T₂) ∪ T₃) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hS₂T
  have hS₁T₁₂ : Disjoint S₁ (T₁ ∪ T₂) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hS₁T₁₂₃
  have hS₂T₁₂ : Disjoint S₂ (T₁ ∪ T₂) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hS₂T₁₂₃
  rw [P.betweenMultiplicity_union_left S₁ S₂ T hS₁S₂ hST,
    P.betweenMultiplicity_union_right S₁ ((T₁ ∪ T₂) ∪ T₃) T₄
      hT₁₂₃T₄ hS₁T,
    P.betweenMultiplicity_union_right S₁ (T₁ ∪ T₂) T₃
      hT₁₂T₃ hS₁T₁₂₃,
    P.betweenMultiplicity_union_right S₁ T₁ T₂ hT₁T₂ hS₁T₁₂,
    P.betweenMultiplicity_union_right S₂ ((T₁ ∪ T₂) ∪ T₃) T₄
      hT₁₂₃T₄ hS₂T,
    P.betweenMultiplicity_union_right S₂ (T₁ ∪ T₂) T₃
      hT₁₂T₃ hS₂T₁₂₃,
    P.betweenMultiplicity_union_right S₂ T₁ T₂ hT₁T₂ hS₂T₁₂] at hboundary
  have hz₁₂ : P.betweenMultiplicity S₁ T₂ = 0 := by
    simpa [P, S₁, T₂] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .L) (t' := .L) (by trivial))
  have hz₁₃ : P.betweenMultiplicity S₁ T₃ = 0 := by
    simpa [P, S₁, T₃] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .L) (t' := .R) (by trivial))
  have hz₁₄ : P.betweenMultiplicity S₁ T₄ = 0 := by
    simpa [P, S₁, T₄] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .R) (t := .L) (t' := .R) (by trivial))
  have hz₂₁ : P.betweenMultiplicity S₂ T₁ = 0 := by
    simpa [P, S₂, T₁] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .R) (s' := .M) (t := .M) (t' := .M) (by trivial))
  rw [hz₁₂, hz₁₃, hz₁₄, hz₂₁] at hboundary
  change P.boundaryMultiplicity S = P.betweenMultiplicity S₁ T₁ +
    P.betweenMultiplicity S₂ T₂ + P.betweenMultiplicity S₂ T₃ +
    P.betweenMultiplicity S₂ T₄
  simpa [Nat.add_assoc] using hboundary

/-- The transposed boundary identity for `X₁₃ ∪ X₂₃`. -/
lemma upper_right_column_boundary_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    let P := Pseudograph.ofSimple G
    let S := block B C .L .R ∪ block B C .M .R
    P.boundaryMultiplicity S =
      P.betweenMultiplicity (block B C .L .R) (block B C .M .M) +
      P.betweenMultiplicity (block B C .M .R) (block B C .L .M) +
      P.betweenMultiplicity (block B C .M .R) (block B C .R .M) +
      P.betweenMultiplicity (block B C .M .R) (block B C .R .R) := by
  simpa only [block_swap] using
    C.lower_right_row_boundary_ledger B hreg hno4 hno6

/-- The boundary of the common right-right block `X33` has exactly the
three contributions `nu,lambda1,lambda2`. -/
lemma right_right_boundary_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).boundaryMultiplicity (block B C .R .R) =
      overlayEdge B C .R .R .M .M +
        overlayEdge B C .R .R .M .R +
        overlayEdge B C .R .R .R .M := by
  classical
  let P := Pseudograph.ofSimple G
  let S := block B C .R .R
  let T₁ := block B C .M .M
  let T₂ := block B C .M .R
  let T₃ := block B C .R .M
  let T := (T₁ ∪ T₂) ∪ T₃
  have hT₁₂ : Disjoint T₁ T₂ := B.disjoint_block C (.inr (by decide))
  have hT₁₃ : Disjoint T₁ T₃ := B.disjoint_block C (.inl (by decide))
  have hT₂₃ : Disjoint T₂ T₃ := B.disjoint_block C (.inl (by decide))
  have hTdis : Disjoint (T₁ ∪ T₂) T₃ :=
    Finset.disjoint_union_left.mpr ⟨hT₁₃, hT₂₃⟩
  have hST : Disjoint S T := by
    exact Finset.disjoint_union_right.mpr
      ⟨Finset.disjoint_union_right.mpr
          ⟨B.disjoint_block C (.inl (by decide)),
            B.disjoint_block C (.inl (by decide))⟩,
        B.disjoint_block C (.inr (by decide))⟩
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∉ S → y ∈ T := by
    intro x hx y hxy hyS
    have hx' := mem_block.mp hx
    obtain ⟨s, hys, _⟩ := B.existsUnique_mem_side y
    cases s with
    | L =>
        exfalso
        exact B.not_adj_left_right hreg hno4 hno6 hys hx'.1 hxy.symm
    | M =>
        obtain ⟨t, hyt, _⟩ := C.existsUnique_mem_side y
        cases t with
        | L =>
            exfalso
            exact C.not_adj_left_right hreg hno4 hno6 hyt hx'.2 hxy.symm
        | M =>
            exact Finset.mem_union_left _
              (Finset.mem_union_left _ (mem_block.mpr ⟨hys, hyt⟩))
        | R =>
            exact Finset.mem_union_left _
              (Finset.mem_union_right _ (mem_block.mpr ⟨hys, hyt⟩))
    | R =>
        obtain ⟨t, hyt, _⟩ := C.existsUnique_mem_side y
        cases t with
        | L =>
            exfalso
            exact C.not_adj_left_right hreg hno4 hno6 hyt hx'.2 hxy.symm
        | M =>
            exact Finset.mem_union_right _ (mem_block.mpr ⟨hys, hyt⟩)
        | R =>
            exact False.elim (hyS (mem_block.mpr ⟨hys, hyt⟩))
  have hboundary := boundaryMultiplicity_eq_between_of_crossing_neighbors_subset
    G S T hST hneighbors
  have hST₁₂ : Disjoint S (T₁ ∪ T₂) :=
    Disjoint.mono (by rfl) Finset.subset_union_left hST
  have hST₁ : Disjoint S T₁ :=
    Disjoint.mono (by rfl) Finset.subset_union_left hST₁₂
  rw [P.betweenMultiplicity_union_right S (T₁ ∪ T₂) T₃ hTdis hST,
    P.betweenMultiplicity_union_right S T₁ T₂ hT₁₂ hST₁₂] at hboundary
  simpa [P, S, T₁, T₂, T₃, overlayEdge] using hboundary

lemma right_right_eq_empty_of_boundary_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hconn : G.Connected)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hzero : (Pseudograph.ofSimple G).boundaryMultiplicity
      (block B C .R .R) = 0) :
    block B C .R .R = ∅ := by
  obtain ⟨x, hx⟩ := Finset.card_pos.mp (by omega :
    0 < (block B C .R .M).card)
  have hx' := mem_block.mp hx
  have hxnot : x ∉ block B C .R .R := by
    intro hx33
    exact (Finset.disjoint_left.mp C.disjoint_middle_right)
      hx'.2 (mem_block.mp hx33).2
  have hproper : block B C .R .R ≠ Finset.univ := by
    intro hEq
    exact hxnot (by rw [hEq]; simp)
  exact eq_empty_of_boundaryMultiplicity_eq_zero_of_connected
    G hconn (block B C .R .R) hproper hzero

lemma diagonal_eq_empty_of_boundary_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hconn : G.Connected)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hzero : (Pseudograph.ofSimple G).boundaryMultiplicity
      (overlayH1 B C) = 0) :
    overlayH1 B C = ∅ := by
  obtain ⟨x, hx⟩ := Finset.card_pos.mp (by omega :
    0 < (block B C .R .M).card)
  have hx' := mem_block.mp hx
  have hxnot : x ∉ overlayH1 B C := by
    simp only [overlayH1, Finset.mem_union]
    intro h
    rcases h with h11 | h22
    · exact (Finset.disjoint_left.mp B.disjoint_left_right)
        (mem_block.mp h11).1 hx'.1
    · exact (Finset.disjoint_left.mp B.disjoint_middle_right)
        (mem_block.mp h22).1 hx'.1
  have hproper : overlayH1 B C ≠ Finset.univ := by
    intro hEq
    exact hxnot (by rw [hEq]; simp)
  exact eq_empty_of_boundaryMultiplicity_eq_zero_of_connected
    G hconn (overlayH1 B C) hproper hzero

/-- Only the `X22--X13` block pair joins `H1` to `H3`. -/
lemma between_H1_H3
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (overlayH1 B C) (overlayH3 B C) =
      (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .L .R) (block B C .M .M) := by
  classical
  let P := Pseudograph.ofSimple G
  let A₁ := block B C .L .L
  let A₂ := block B C .M .M
  let T₁ := block B C .L .R
  let T₂ := block B C .M .R
  have hA : Disjoint A₁ A₂ := B.disjoint_block C (.inl (by decide))
  have hT : Disjoint T₁ T₂ := B.disjoint_block C (.inl (by decide))
  have hAT : Disjoint (A₁ ∪ A₂) (T₁ ∪ T₂) := by
    exact Finset.disjoint_union_left.mpr
      ⟨Finset.disjoint_union_right.mpr
          ⟨B.disjoint_block C (.inr (by decide)),
            B.disjoint_block C (.inl (by decide))⟩,
        Finset.disjoint_union_right.mpr
          ⟨B.disjoint_block C (.inl (by decide)),
            B.disjoint_block C (.inr (by decide))⟩⟩
  have hz11_13 : P.betweenMultiplicity A₁ T₁ = 0 := by
    simpa [P, A₁, T₁] using
      (B.between_block_eq_zero_of_forbidden_row C hreg hno4 hno6
        (s := .L) (s' := .L) (t := .L) (t' := .R) (by trivial))
  have hz11_23 : P.betweenMultiplicity A₁ T₂ = 0 := by
    simpa [P, A₁, T₂] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .L) (s' := .M) (t := .L) (t' := .R) (by trivial))
  have hz22_23 : P.betweenMultiplicity A₂ T₂ = 0 := by
    simpa [P, A₂, T₂] using
      (B.between_block_eq_zero_of_forbidden_row C hreg hno4 hno6
        (s := .M) (s' := .M) (t := .M) (t' := .R) (by trivial))
  change P.betweenMultiplicity (A₁ ∪ A₂) (T₁ ∪ T₂) =
    P.betweenMultiplicity T₁ A₂
  rw [P.betweenMultiplicity_union_left A₁ A₂ (T₁ ∪ T₂) hA hAT,
    P.betweenMultiplicity_union_right A₁ T₁ T₂ hT
      (Disjoint.mono Finset.subset_union_left (by rfl) hAT),
    P.betweenMultiplicity_union_right A₂ T₁ T₂ hT
      (Disjoint.mono Finset.subset_union_right (by rfl) hAT),
    hz11_13, hz11_23, hz22_23, Nat.zero_add, Nat.add_zero,
    P.betweenMultiplicity_comm]

/-- Only the `X22--X31` block pair joins `H1` to `H4`. -/
lemma between_H1_H4
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (overlayH1 B C) (overlayH4 B C) =
      (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .R .L) (block B C .M .M) := by
  simpa only [block_swap, overlayH1, overlayH3, overlayH4,
    Pseudograph.betweenMultiplicity_comm] using C.between_H1_H3 B hreg hno4 hno6

/-- If `X₃₂` has at least two vertices, the first shore in (5.3) is
automatically nontrivial.  The general cut lower bound therefore turns its
exact boundary expansion into the required inequality. -/
lemma lower_right_row_eight_of_two_le_block
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hcard : 2 ≤ (block B C .R .M).card) :
    8 ≤ (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .L) (block B C .M .M) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .M) (block B C .M .L) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .M) (block B C .M .R) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .M) (block B C .R .R) := by
  classical
  let S₁ := block B C .R .L
  let S₂ := block B C .R .M
  let S := S₁ ∪ S₂
  have hS₂sub : S₂ ⊆ S := Finset.subset_union_right
  have hSsub : S ⊆ B.right := by
    intro x hx
    simp only [S, Finset.mem_union] at hx
    rcases hx with hx | hx
    · exact (mem_block.mp hx).1
    · exact (mem_block.mp hx).1
  have hScard : 2 ≤ S.card :=
    hcard.trans (Finset.card_le_card hS₂sub)
  have hSnonempty : S.Nonempty := Finset.card_pos.mp (by omega)
  have hScard_ne : S.card ≠ 1 := by omega
  have hMcard : 3 ≤ B.middle.card := by
    have hdegree := (B.typeC_degree_ledger hreg hno4 hno6).2.2.2
    have hLpos : 0 < B.left.card :=
      Finset.card_pos.mpr ⟨u, B.mem_left_distinguished⟩
    omega
  have hMnonempty : B.middle.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨m, hmM⟩ := hMnonempty
  have hmS : m ∉ S := by
    intro hmS
    exact (Finset.disjoint_left.mp B.disjoint_middle_right) hmM (hSsub hmS)
  have hproper : S ≠ Finset.univ := by
    intro hSuniv
    exact hmS (by rw [hSuniv]; simp)
  have hMsubcomp : B.middle ⊆ Sᶜ := by
    intro x hxM
    simp only [Finset.mem_compl]
    intro hxS
    exact (Finset.disjoint_left.mp B.disjoint_middle_right) hxM (hSsub hxS)
  have hcompcard : Sᶜ.card ≠ 1 := by
    have hle := Finset.card_le_card hMsubcomp
    omega
  have hcut6 : (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 6 := by
    intro hsix
    rcases hno6 S hsix with hStwo | hcomptwo
    · have hS₂card : S₂.card = 2 := by
        have hle := Finset.card_le_card hS₂sub
        have hlower : 2 ≤ S₂.card := by simpa [S₂] using hcard
        omega
      have hS₂eq : S₂ = S :=
        Finset.eq_of_subset_of_card_le hS₂sub (by omega)
      have hSind : G.IsIndepSet (S : Set V) := by
        rw [← hS₂eq]
        intro x hx y hy hxy
        exact C.middle_isIndepSet (mem_block.mp hx).2 (mem_block.mp hy).2 hxy
      have hint : (Pseudograph.ofSimple G).internalMultiplicity S = 0 :=
        internalMultiplicity_eq_zero_of_isIndepSet G S hSind
      have hdegree := Pseudograph.regular_card_eq_two_internal_add_boundary
        (Pseudograph.ofSimple G)
        ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
      rw [hint, hsix, hStwo] at hdegree
      omega
    · have hle := Finset.card_le_card hMsubcomp
      omega
  have hcut := eight_le_boundaryMultiplicity_of_nontrivial
    G hreg hconn hno2 hno4 hno6 S hSnonempty hproper hScard_ne hcompcard hcut6
  have hledger := B.lower_right_row_boundary_ledger C hreg hno4 hno6
  dsimp only at hledger
  change (Pseudograph.ofSimple G).boundaryMultiplicity S = _ at hledger
  rw [hledger] at hcut
  exact hcut

/-- A version of the first lower bound which exposes precisely the two
nontrivial-shore obligations used in Tashkinov's minimal-choice argument.
Keeping those obligations separate avoids duplicating the rather large
boundary expansion. -/
lemma lower_right_row_eight_of_card_ne_one
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hnonempty : (block B C .R .L ∪ block B C .R .M).Nonempty)
    (hproper : block B C .R .L ∪ block B C .R .M ≠ Finset.univ)
    (hcard : (block B C .R .L ∪ block B C .R .M).card ≠ 1)
    (hcompcard : (block B C .R .L ∪ block B C .R .M)ᶜ.card ≠ 1)
    (hcut6 : (Pseudograph.ofSimple G).boundaryMultiplicity
      (block B C .R .L ∪ block B C .R .M) ≠ 6) :
    8 ≤ (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .L) (block B C .M .M) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .M) (block B C .M .L) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .M) (block B C .M .R) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .R .M) (block B C .R .R) := by
  classical
  let S := block B C .R .L ∪ block B C .R .M
  have hcut := eight_le_boundaryMultiplicity_of_nontrivial
    G hreg hconn hno2 hno4 hno6 S hnonempty hproper hcard hcompcard hcut6
  have hledger := B.lower_right_row_boundary_ledger C hreg hno4 hno6
  dsimp only at hledger
  change (Pseudograph.ofSimple G).boundaryMultiplicity S = _ at hledger
  rw [hledger] at hcut
  exact hcut

/-- The transposed nontrivial-shore lower bound for `X₁₃ ∪ X₂₃`. -/
lemma upper_right_column_eight_of_card_ne_one
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hnonempty : (block B C .L .R ∪ block B C .M .R).Nonempty)
    (hcard : (block B C .L .R ∪ block B C .M .R).card ≠ 1) :
    8 ≤ (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .L .R) (block B C .M .M) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .M .R) (block B C .L .M) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .M .R) (block B C .R .M) +
        (Pseudograph.ofSimple G).betweenMultiplicity
          (block B C .M .R) (block B C .R .R) := by
  classical
  let S := block B C .L .R ∪ block B C .M .R
  have hSsub : S ⊆ C.right := by
    intro x hx
    simp only [S, Finset.mem_union] at hx
    rcases hx with hx | hx
    · exact (mem_block.mp hx).2
    · exact (mem_block.mp hx).2
  have hMcard : 3 ≤ C.middle.card := by
    have hdegree := (C.typeC_degree_ledger hreg hno4 hno6).2.2.2
    have hLpos : 0 < C.left.card :=
      Finset.card_pos.mpr ⟨v, C.mem_left_distinguished⟩
    omega
  have hMnonempty : C.middle.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨m, hmM⟩ := hMnonempty
  have hmS : m ∉ S := by
    intro hmS
    exact (Finset.disjoint_left.mp C.disjoint_middle_right) hmM (hSsub hmS)
  have hproper : S ≠ Finset.univ := by
    intro hSuniv
    exact hmS (by rw [hSuniv]; simp)
  have hMsubcomp : C.middle ⊆ Sᶜ := by
    intro x hxM
    simp only [Finset.mem_compl]
    intro hxS
    exact (Finset.disjoint_left.mp C.disjoint_middle_right) hxM (hSsub hxS)
  have hcompcard : Sᶜ.card ≠ 1 := by
    have hle := Finset.card_le_card hMsubcomp
    omega
  have hcut6 : (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 6 := by
    intro hsix
    rcases hno6 S hsix with hStwo | hcomptwo
    · let A := block B C .L .R
      let D := block B C .M .R
      have hAD : Disjoint A D := B.disjoint_block C (.inl (by decide))
      have hcards := Finset.card_union_of_disjoint hAD
      change S.card = A.card + D.card at hcards
      have hsum : A.card + D.card = 2 := by omega
      have hnotIndependent (hSind : G.IsIndepSet (S : Set V)) : False := by
        have hint : (Pseudograph.ofSimple G).internalMultiplicity S = 0 :=
          internalMultiplicity_eq_zero_of_isIndepSet G S hSind
        have hdegree := Pseudograph.regular_card_eq_two_internal_add_boundary
          (Pseudograph.ofSimple G)
          ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
        rw [hint, hsix, hStwo] at hdegree
        omega
      by_cases hAempty : A = ∅
      · apply hnotIndependent
        intro x hx y hy hxy
        have hxD : x ∈ D := by simpa [S, A, D, hAempty] using hx
        have hyD : y ∈ D := by simpa [S, A, D, hAempty] using hy
        exact B.middle_isIndepSet (mem_block.mp hxD).1 (mem_block.mp hyD).1 hxy
      by_cases hDempty : D = ∅
      · apply hnotIndependent
        intro x hx y hy hxy
        have hxA : x ∈ A := by simpa [S, A, D, hDempty] using hx
        have hyA : y ∈ A := by simpa [S, A, D, hDempty] using hy
        exact B.left_isIndepSet hreg hno4 hno6
          (mem_block.mp hxA).1 (mem_block.mp hyA).1 hxy
      have hAcard : A.card = 1 := by
        have hpos := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hAempty)
        have hDpos := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hDempty)
        omega
      have hDcard : D.card = 1 := by omega
      obtain ⟨a, hAeq⟩ := Finset.card_eq_one.mp hAcard
      obtain ⟨b, hDeq⟩ := Finset.card_eq_one.mp hDcard
      have haA : a ∈ A := by simp [hAeq]
      have hbD : b ∈ D := by simp [hDeq]
      have haR : a ∈ C.right := (mem_block.mp haA).2
      have htwo := C.right_two_neighbors a haR
      have haErase : a ∉ C.right.erase a := by simp
      rw [Pseudograph.betweenMultiplicity_singleton_ofSimple
        G a (C.right.erase a) haErase] at htwo
      have hfilterSub : (C.right.erase a).filter (G.Adj a) ⊆ {b} := by
        intro x hx
        have hx' := Finset.mem_filter.mp hx
        have hxC : x ∈ C.right := Finset.mem_of_mem_erase hx'.1
        have hxB : x ∈ B.left ∨ x ∈ B.middle ∨ x ∈ B.right := by
          have hc := Finset.ext_iff.mp B.cover x
          simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hc
          tauto
        have hxM : x ∈ B.middle := by
          rcases hxB with hxL | hxM | hxR
          · exfalso
            exact B.left_isIndepSet hreg hno4 hno6
              (mem_block.mp haA).1 hxL hx'.2.ne hx'.2
          · exact hxM
          · exfalso
            exact B.not_adj_left_right hreg hno4 hno6
              (mem_block.mp haA).1 hxR hx'.2
        have hxD : x ∈ D := mem_block.mpr ⟨hxM, hxC⟩
        simpa [hDeq] using hxD
      have hle := Finset.card_le_card hfilterSub
      simp only [Finset.card_singleton] at hle
      omega
    · have hle := Finset.card_le_card hMsubcomp
      omega
  have hcut := eight_le_boundaryMultiplicity_of_nontrivial
    G hreg hconn hno2 hno4 hno6 S hnonempty hproper hcard hcompcard hcut6
  have hledger := B.upper_right_column_boundary_ledger C hreg hno4 hno6
  dsimp only at hledger
  change (Pseudograph.ofSimple G).boundaryMultiplicity S = _ at hledger
  rw [hledger] at hcut
  exact hcut

/-- Every edge leaving the off-diagonal union X12 union X21 enters
X23 union X32. -/
lemma offDiagonal_boundary_eq_between
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).boundaryMultiplicity
        (block B C .L .M ∪ block B C .M .L) =
      (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .L .M ∪ block B C .M .L)
        (block B C .M .R ∪ block B C .R .M) := by
  classical
  let P := Pseudograph.ofSimple G
  let S1 := block B C .L .M
  let S2 := block B C .M .L
  let S := S1 ∪ S2
  let T1 := block B C .M .R
  let T2 := block B C .R .M
  let T := T1 ∪ T2
  have hS1S2 : Disjoint S1 S2 := B.disjoint_block C (.inl (by decide))
  have hT1T2 : Disjoint T1 T2 := B.disjoint_block C (.inl (by decide))
  have hS1T1 : Disjoint S1 T1 := B.disjoint_block C (.inl (by decide))
  have hS1T2 : Disjoint S1 T2 := B.disjoint_block C (.inl (by decide))
  have hS2T1 : Disjoint S2 T1 := B.disjoint_block C (.inr (by decide))
  have hS2T2 : Disjoint S2 T2 := B.disjoint_block C (.inl (by decide))
  have hS1T : Disjoint S1 T :=
    Finset.disjoint_union_right.mpr ⟨hS1T1, hS1T2⟩
  have hS2T : Disjoint S2 T :=
    Finset.disjoint_union_right.mpr ⟨hS2T1, hS2T2⟩
  have hST : Disjoint S T :=
    Finset.disjoint_union_left.mpr ⟨hS1T, hS2T⟩
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∉ S → y ∈ T := by
    intro x hx y hxy hyS
    simp only [S, Finset.mem_union] at hx
    rcases hx with hx1 | hx2
    · have hx' := mem_block.mp hx1
      have hyM := B.mem_middle_of_adj_left hreg hno4 hno6 hx'.1 hxy
      rcases C.mem_left_or_right_of_adj_middle hx'.2 hxy with hyL | hyR
      · exfalso
        exact hyS (Finset.mem_union_right _ (mem_block.mpr ⟨hyM, hyL⟩))
      · exact Finset.mem_union_left _ (mem_block.mpr ⟨hyM, hyR⟩)
    · have hx' := mem_block.mp hx2
      have hyM := C.mem_middle_of_adj_left hreg hno4 hno6 hx'.2 hxy
      rcases B.mem_left_or_right_of_adj_middle hx'.1 hxy with hyL | hyR
      · exfalso
        exact hyS (Finset.mem_union_left _ (mem_block.mpr ⟨hyL, hyM⟩))
      · exact Finset.mem_union_right _ (mem_block.mpr ⟨hyR, hyM⟩)
  have hboundary := boundaryMultiplicity_eq_between_of_crossing_neighbors_subset
    G S T hST hneighbors
  simpa [P, S, S1, S2, T, T1, T2] using hboundary

/-- Expanding that between-set count leaves precisely the two counts denoted
mu1 and mu2 in Section 5. -/
lemma offDiagonal_between_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .L .M ∪ block B C .M .L)
        (block B C .M .R ∪ block B C .R .M) =
      overlayEdge B C .R .M .M .L + overlayEdge B C .M .R .L .M := by
  classical
  let P := Pseudograph.ofSimple G
  let S1 := block B C .L .M
  let S2 := block B C .M .L
  let S := S1 ∪ S2
  let T1 := block B C .M .R
  let T2 := block B C .R .M
  let T := T1 ∪ T2
  have hS1S2 : Disjoint S1 S2 := B.disjoint_block C (.inl (by decide))
  have hT1T2 : Disjoint T1 T2 := B.disjoint_block C (.inl (by decide))
  have hS1T1 : Disjoint S1 T1 := B.disjoint_block C (.inl (by decide))
  have hS1T2 : Disjoint S1 T2 := B.disjoint_block C (.inl (by decide))
  have hS2T1 : Disjoint S2 T1 := B.disjoint_block C (.inr (by decide))
  have hS2T2 : Disjoint S2 T2 := B.disjoint_block C (.inl (by decide))
  have hS1T : Disjoint S1 T :=
    Finset.disjoint_union_right.mpr ⟨hS1T1, hS1T2⟩
  have hS2T : Disjoint S2 T :=
    Finset.disjoint_union_right.mpr ⟨hS2T1, hS2T2⟩
  have hST : Disjoint S T :=
    Finset.disjoint_union_left.mpr ⟨hS1T, hS2T⟩
  have hz1 : P.betweenMultiplicity S1 T2 = 0 := by
    simpa [P, S1, T2] using
      (B.between_block_eq_zero_of_forbidden_row C hreg hno4 hno6
        (s := .L) (s' := .R) (t := .M) (t' := .M) (by trivial))
  have hz2 : P.betweenMultiplicity S2 T1 = 0 := by
    simpa [P, S2, T1] using
      (B.between_block_eq_zero_of_forbidden_column C hreg hno4 hno6
        (s := .M) (s' := .M) (t := .L) (t' := .R) (by trivial))
  change P.betweenMultiplicity S T =
      overlayEdge B C .R .M .M .L + overlayEdge B C .M .R .L .M
  rw [P.betweenMultiplicity_union_left S1 S2 T hS1S2 hST,
    P.betweenMultiplicity_union_right S1 T1 T2 hT1T2 hS1T,
    P.betweenMultiplicity_union_right S2 T1 T2 hT1T2 hS2T,
    hz1, hz2, Nat.add_zero, Nat.zero_add]
  change P.betweenMultiplicity S1 T1 + P.betweenMultiplicity S2 T2 =
      P.betweenMultiplicity T2 S2 + P.betweenMultiplicity T1 S1
  rw [P.betweenMultiplicity_comm T2 S2, P.betweenMultiplicity_comm T1 S1,
    Nat.add_comm]

/-- The boundary of the off-diagonal union consists of exactly mu1+mu2. -/
lemma offDiagonal_boundary_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).boundaryMultiplicity
        (block B C .L .M ∪ block B C .M .L) =
      overlayEdge B C .R .M .M .L + overlayEdge B C .M .R .L .M :=
  (B.offDiagonal_boundary_eq_between C hreg hno4 hno6).trans
    (B.offDiagonal_between_ledger C hreg hno4 hno6)

/-- All four incidences at `X12` enter `X21 ∪ X23`. -/
lemma x12_union_degree_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .L .M)
        (block B C .M .L ∪ block B C .M .R) =
      4 * (block B C .L .M).card := by
  classical
  let P := Pseudograph.ofSimple G
  let S := block B C .L .M
  let T₁ := block B C .M .L
  let T₂ := block B C .M .R
  let T := T₁ ∪ T₂
  have hST : Disjoint S T := by
    exact Finset.disjoint_union_right.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  have hS : G.IsIndepSet (S : Set V) := by
    intro x hx y hy hxy
    exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx).1 (mem_block.mp hy).1 hxy
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∈ T := by
    intro x hx y hxy
    have hx' := mem_block.mp hx
    have hyB := B.mem_middle_of_adj_left hreg hno4 hno6 hx'.1 hxy
    rcases C.mem_left_or_right_of_adj_middle hx'.2 hxy with hyL | hyR
    · exact Finset.mem_union_left _ (mem_block.mpr ⟨hyB, hyL⟩)
    · exact Finset.mem_union_right _ (mem_block.mpr ⟨hyB, hyR⟩)
  have hdegree := betweenMultiplicity_eq_regular_mul_card_of_independent
    G hreg S T hST hS hneighbors
  exact hdegree

/-- Degree ledger for `X12`: expand the preceding two-block target. -/
lemma x12_degree_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .L .M) (block B C .M .L) +
      overlayEdge B C .M .R .L .M =
        4 * (block B C .L .M).card := by
  let P := Pseudograph.ofSimple G
  let S := block B C .L .M
  let T₁ := block B C .M .L
  let T₂ := block B C .M .R
  have h := B.x12_union_degree_ledger C hreg hno4 hno6
  have hTdis : Disjoint T₁ T₂ := B.disjoint_block C (.inr (by decide))
  have hST : Disjoint S (T₁ ∪ T₂) := by
    exact Finset.disjoint_union_right.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  change P.betweenMultiplicity S (T₁ ∪ T₂) = 4 * S.card at h
  rw [P.betweenMultiplicity_union_right S T₁ T₂ hTdis hST] at h
  change P.betweenMultiplicity S T₁ + P.betweenMultiplicity T₂ S = 4 * S.card
  rw [P.betweenMultiplicity_comm T₂ S]
  exact h

/-- All four incidences at `X21` enter `X12 ∪ X32`. -/
lemma x21_union_degree_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .M .L)
        (block B C .L .M ∪ block B C .R .M) =
      4 * (block B C .M .L).card := by
  classical
  let S := block B C .M .L
  let T₁ := block B C .L .M
  let T₂ := block B C .R .M
  let T := T₁ ∪ T₂
  have hST : Disjoint S T := by
    exact Finset.disjoint_union_right.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  have hS : G.IsIndepSet (S : Set V) := by
    intro x hx y hy hxy
    exact C.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx).2 (mem_block.mp hy).2 hxy
  have hneighbors : ∀ x ∈ S, ∀ y, G.Adj x y → y ∈ T := by
    intro x hx y hxy
    have hx' := mem_block.mp hx
    have hyC := C.mem_middle_of_adj_left hreg hno4 hno6 hx'.2 hxy
    rcases B.mem_left_or_right_of_adj_middle hx'.1 hxy with hyL | hyR
    · exact Finset.mem_union_left _ (mem_block.mpr ⟨hyL, hyC⟩)
    · exact Finset.mem_union_right _ (mem_block.mpr ⟨hyR, hyC⟩)
  exact betweenMultiplicity_eq_regular_mul_card_of_independent
    G hreg S T hST hS hneighbors

/-- The transposed degree ledger for `X21`. -/
lemma x21_degree_ledger
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .M .L) (block B C .L .M) +
      (Pseudograph.ofSimple G).betweenMultiplicity
        (block B C .M .L) (block B C .R .M) =
        4 * (block B C .M .L).card := by
  let P := Pseudograph.ofSimple G
  let S := block B C .M .L
  let T₁ := block B C .L .M
  let T₂ := block B C .R .M
  have h := B.x21_union_degree_ledger C hreg hno4 hno6
  have hTdis : Disjoint T₁ T₂ := B.disjoint_block C (.inl (by decide))
  have hST : Disjoint S (T₁ ∪ T₂) := by
    exact Finset.disjoint_union_right.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  change P.betweenMultiplicity S (T₁ ∪ T₂) = 4 * S.card at h
  rw [P.betweenMultiplicity_union_right S T₁ T₂ hTdis hST] at h
  exact h

/-- The off-diagonal shore cannot be a singleton.  If only X21 is present,
all four incident edges enter the first right component, contradicting the
two-edge per-vertex bound; the X12 case is symmetric. -/
lemma offDiagonal_card_ne_one
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (block B C .L .M ∪ block B C .M .L).card ≠ 1 := by
  classical
  let P := Pseudograph.ofSimple G
  let S1 := block B C .L .M
  let S2 := block B C .M .L
  let S := S1 ∪ S2
  let T1 := block B C .M .R
  let T2 := block B C .R .M
  let b1 := overlayEdge B C .R .M .M .L
  let b2 := overlayEdge B C .M .R .L .M
  have hdis : Disjoint S1 S2 := B.disjoint_block C (.inl (by decide))
  have hcardunion := Finset.card_union_of_disjoint hdis
  have hledger := B.offDiagonal_boundary_ledger C hreg hno4 hno6
  change P.boundaryMultiplicity S = b1 + b2 at hledger
  intro hcard
  change S.card = 1 at hcard
  have hcardsum : S1.card + S2.card = 1 := by
    change S.card = S1.card + S2.card at hcardunion
    omega
  rcases (show S1.card = 0 ∨ S2.card = 0 by omega) with hS1 | hS2
  · have hS1empty : S1 = ∅ := Finset.card_eq_zero.mp hS1
    have hS2card : S2.card = 1 := by omega
    obtain ⟨x, hS2eq⟩ := Finset.card_eq_one.mp hS2card
    have hSeq : S = {x} := by simp [S, hS1empty, hS2eq]
    have hcut := boundaryMultiplicity_singleton_of_quartic G hreg x
    rw [hSeq, hcut] at hledger
    have hb2 : b2 = 0 := by
      simp [b2, overlayEdge, S1, hS1empty, Pseudograph.betweenMultiplicity]
    have hb1 : b1 = 4 := by omega
    have hT2sub : T2 ⊆ B.right := fun _ h ↦ (mem_block.mp h).1
    have hS2R : Disjoint S2 B.right := by
      rw [Finset.disjoint_left]
      intro y hyS hyR
      exact (Finset.disjoint_left.mp B.disjoint_middle_right)
        (mem_block.mp hyS).1 hyR
    have hmono := P.betweenMultiplicity_mono_right S2 T2 B.right hT2sub hS2R
    have hb1' : P.betweenMultiplicity S2 T2 = 4 := by
      rw [P.betweenMultiplicity_comm]
      exact hb1
    have hxnot : x ∉ B.right := by
      intro hxR
      exact (Finset.disjoint_left.mp hS2R) (by simp [hS2eq]) hxR
    have hle := B.between_singleton_right_le_two hreg hno4 hno6 x hxnot
    rw [hS2eq] at hmono hb1'
    change P.betweenMultiplicity {x} B.right ≤ 2 at hle
    omega
  · have hS2empty : S2 = ∅ := Finset.card_eq_zero.mp hS2
    have hS1card : S1.card = 1 := by omega
    obtain ⟨x, hS1eq⟩ := Finset.card_eq_one.mp hS1card
    have hSeq : S = {x} := by simp [S, hS2empty, hS1eq]
    have hcut := boundaryMultiplicity_singleton_of_quartic G hreg x
    rw [hSeq, hcut] at hledger
    have hb1 : b1 = 0 := by
      simp [b1, overlayEdge, S2, hS2empty, Pseudograph.betweenMultiplicity]
    have hb2 : b2 = 4 := by omega
    have hT1sub : T1 ⊆ C.right := fun _ h ↦ (mem_block.mp h).2
    have hS1R : Disjoint S1 C.right := by
      rw [Finset.disjoint_left]
      intro y hyS hyR
      exact (Finset.disjoint_left.mp C.disjoint_middle_right)
        (mem_block.mp hyS).2 hyR
    have hmono := P.betweenMultiplicity_mono_right S1 T1 C.right hT1sub hS1R
    have hb2' : P.betweenMultiplicity S1 T1 = 4 := by
      rw [P.betweenMultiplicity_comm]
      exact hb2
    have hxnot : x ∉ C.right := by
      intro hxR
      exact (Finset.disjoint_left.mp hS1R) (by simp [hS1eq]) hxR
    have hle := C.between_singleton_right_le_two hreg hno4 hno6 x hxnot
    rw [hS1eq] at hmono hb2'
    change P.betweenMultiplicity {x} C.right ≤ 2 at hle
    omega

/-- If at least one of `mu1,mu2` is positive, their sum is at least eight.
This is (5.8): their sum is the cut of `X12 ∪ X21`, that shore is not a
singleton by the toggle-cut argument, and its complement contains the
selected block `X32` of cardinality at least two. -/
lemma offDiagonal_eight_of_pos
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M) :
    8 ≤ overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M := by
  classical
  let P := Pseudograph.ofSimple G
  let S := block B C .L .M ∪ block B C .M .L
  let X₃₂ := block B C .R .M
  have hledger := B.offDiagonal_boundary_ledger C hreg hno4 hno6
  change P.boundaryMultiplicity S = _ at hledger
  have hSnonempty : S.Nonempty := by
    by_contra h
    have hSempty : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp h
    rw [hSempty, P.boundaryMultiplicity_empty] at hledger
    omega
  have hSX : Disjoint S X₃₂ := by
    exact Finset.disjoint_union_left.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  have hXsubcomp : X₃₂ ⊆ Sᶜ := by
    intro x hxX
    simp only [Finset.mem_compl]
    intro hxS
    exact (Finset.disjoint_left.mp hSX) hxS hxX
  have hcompcardtwo : 2 ≤ Sᶜ.card := by
    exact hcard₃₂.trans (Finset.card_le_card hXsubcomp)
  have hproper : S ≠ Finset.univ := by
    intro hS
    have : Sᶜ.card = 0 := by simp [hS]
    omega
  have hScard : S.card ≠ 1 := by
    change (block B C .L .M ∪ block B C .M .L).card ≠ 1
    exact B.offDiagonal_card_ne_one C hreg hno4 hno6
  have hcompcard : Sᶜ.card ≠ 1 := by omega
  have hcut6 : P.boundaryMultiplicity S ≠ 6 := by
    intro hsix
    rcases hno6 S hsix with hStwo | hcomptwo
    · let A := block B C .L .M
      let D := block B C .M .L
      have hAD : Disjoint A D := B.disjoint_block C (.inl (by decide))
      have hcards := Finset.card_union_of_disjoint hAD
      change S.card = A.card + D.card at hcards
      have hsum : A.card + D.card = 2 := by omega
      have hnotIndependent (hSind : G.IsIndepSet (S : Set V)) : False := by
        have hint : P.internalMultiplicity S = 0 :=
          internalMultiplicity_eq_zero_of_isIndepSet G S hSind
        have hdegree := P.regular_card_eq_two_internal_add_boundary
          ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
        rw [hint, hsix, hStwo] at hdegree
        omega
      by_cases hAempty : A = ∅
      · apply hnotIndependent
        intro x hx y hy hxy
        have hxD : x ∈ D := by simpa [S, A, D, hAempty] using hx
        have hyD : y ∈ D := by simpa [S, A, D, hAempty] using hy
        exact B.middle_isIndepSet (mem_block.mp hxD).1
          (mem_block.mp hyD).1 hxy
      by_cases hDempty : D = ∅
      · apply hnotIndependent
        intro x hx y hy hxy
        have hxA : x ∈ A := by simpa [S, A, D, hDempty] using hx
        have hyA : y ∈ A := by simpa [S, A, D, hDempty] using hy
        exact B.left_isIndepSet hreg hno4 hno6
          (mem_block.mp hxA).1 (mem_block.mp hyA).1 hxy
      have hAcard : A.card = 1 := by
        have hApos := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hAempty)
        have hDpos := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hDempty)
        omega
      have hDcard : D.card = 1 := by omega
      obtain ⟨a, hAeq⟩ := Finset.card_eq_one.mp hAcard
      obtain ⟨b, hDeq⟩ := Finset.card_eq_one.mp hDcard
      have haA : a ∈ A := by simp [hAeq]
      have hbD : b ∈ D := by simp [hDeq]
      let T := (C.right.filter (G.Adj a))
      have hNsub : G.neighborFinset a ⊆ insert b T := by
        intro x hxN
        have hax : G.Adj a x := by simpa using hxN
        have hxC : x ∈ C.left ∨ x ∈ C.middle ∨ x ∈ C.right := by
          have hc := Finset.ext_iff.mp C.cover x
          simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hc
          tauto
        rcases hxC with hxL | hxM | hxR
        · have hxB : x ∈ B.left ∨ x ∈ B.middle ∨ x ∈ B.right := by
            have hc := Finset.ext_iff.mp B.cover x
            simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hc
            tauto
          rcases hxB with hxBL | hxBM | hxBR
          · exfalso
            exact B.left_isIndepSet hreg hno4 hno6
              (mem_block.mp haA).1 hxBL hax.ne hax
          · have hxD : x ∈ D := mem_block.mpr ⟨hxBM, hxL⟩
            have : x = b := by simpa [hDeq] using hxD
            simp [this]
          · exfalso
            exact B.not_adj_left_right hreg hno4 hno6
              (mem_block.mp haA).1 hxBR hax
        · exfalso
          exact C.middle_isIndepSet (mem_block.mp haA).2 hxM hax.ne hax
        · exact Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨hxR, hax⟩)
      have hbnotT : b ∉ T := by
        intro hbT
        have hbR := (Finset.mem_filter.mp hbT).1
        exact (Finset.disjoint_left.mp C.disjoint_left_right)
          (mem_block.mp hbD).2 hbR
      have hNcard : (G.neighborFinset a).card = 4 := by
        rw [SimpleGraph.card_neighborFinset_eq_degree, hreg a]
      have hTcardLower : 3 ≤ T.card := by
        have hle := Finset.card_le_card hNsub
        rw [Finset.card_insert_of_notMem hbnotT] at hle
        omega
      have haNotR : a ∉ C.right := fun haR ↦
        (Finset.disjoint_left.mp C.disjoint_middle_right) (mem_block.mp haA).2 haR
      have hle := C.between_singleton_right_le_two hreg hno4 hno6 a haNotR
      have hfilter := Pseudograph.betweenMultiplicity_singleton_ofSimple
        G a C.right haNotR
      change P.betweenMultiplicity {a} C.right = T.card at hfilter
      have hle' : P.betweenMultiplicity {a} C.right ≤ 2 := by
        simpa [P] using hle
      rw [hfilter] at hle'
      omega
    · have hXeq : X₃₂ = Sᶜ :=
        Finset.eq_of_subset_of_card_le hXsubcomp (by
          have hlower : 2 ≤ X₃₂.card := by simpa [X₃₂] using hcard₃₂
          omega)
      have hcompIndependent : G.IsIndepSet (((Sᶜ : Finset V) : Set V)) := by
        rw [← hXeq]
        intro x hx y hy hxy
        exact C.middle_isIndepSet (mem_block.mp hx).2 (mem_block.mp hy).2 hxy
      have hint : P.internalMultiplicity Sᶜ = 0 :=
        internalMultiplicity_eq_zero_of_isIndepSet G Sᶜ hcompIndependent
      have hcompcut := P.boundaryMultiplicity_compl S
      have hdegree := P.regular_card_eq_two_internal_add_boundary
        ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) Sᶜ
      rw [hint, hcompcut, hsix, hcomptwo] at hdegree
      omega
  have hcut := eight_le_boundaryMultiplicity_of_nontrivial
    G hreg hconn hno2 hno4 hno6 S hSnonempty hproper hScard hcompcard hcut6
  rw [hledger] at hcut
  exact hcut

/-- The two crossed lower bounds in (5.3), packaged to keep later theorem
types small enough for predictable elaboration. -/
structure CrossedLowerBounds {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Prop where
  first : 8 ≤ overlayEdge B C .R .L .M .M +
    overlayEdge B C .R .M .M .L + overlayEdge B C .R .M .M .R +
    overlayEdge B C .R .M .R .R
  second : 8 ≤ overlayEdge B C .L .R .M .M +
    overlayEdge B C .M .R .L .M + overlayEdge B C .M .R .R .M +
    overlayEdge B C .M .R .R .R

/-- The two crossed lower bounds follow from the selected `X₃₂` block,
global minimality of the first right component, and the sole remaining
minimal-choice obligation that the opposite shore is not a singleton. -/
lemma crossedLowerBounds_of_rightMinimal
    {G : SimpleGraph V} {u w : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G w)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hminimal : ∀ (v : V) (D : TypeCBarrier G v),
      B.right.card ≤ D.right.card)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card) :
    CrossedLowerBounds B C := by
  refine ⟨?_, ?_⟩
  · exact B.lower_right_row_eight_of_two_le_block C hreg hconn hno2 hno4 hno6
      hcard₃₂
  · exact B.upper_right_column_eight_of_card_ne_one C hreg hconn hno2 hno4 hno6
      (B.upper_right_column_nonempty_of_rightMinimal C hminimal hcard₃₂)
      (B.upper_right_column_card_ne_one_of_rightMinimal C hminimal hcard₃₂)

/-- The three conclusions in (5.4), similarly packaged. -/
structure FirstStageConclusion {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Prop where
  sharedDiagonal_zero : overlayEdge B C .R .R .M .M = 0
  tails_eq : overlayEdge B C .R .R .M .R =
    overlayEdge B C .R .R .R .M
  heads_eq : overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L =
    overlayEdge B C .L .R .M .M + overlayEdge B C .M .R .L .M

/-- The shared diagonal count in (5.4) vanishes.  This projection is kept
separate from the other two conclusions so its theorem type stays small. -/
lemma sharedDiagonal_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C) :
    overlayEdge B C .R .R .M .M = 0 := by
  have heq₁ := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  have heq₂ := B.second_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at heq₁
  change overlayEdge B C .L .R .M .M +
      overlayEdge B C .M .R .L .M +
      overlayEdge B C .M .R .R .M +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .R .M = 8 at heq₂
  rw [overlayEdge_comm B C .M .R .R .M] at heq₂
  have hlower₁ := hlower.first
  have hlower₂ := hlower.second
  rw [overlayEdge_comm B C .R .M .R .R] at hlower₁
  rw [overlayEdge_comm B C .M .R .R .M,
    overlayEdge_comm B C .M .R .R .R] at hlower₂
  omega

/-- The two tail counts in (5.4) are equal. -/
lemma overlay_tails_eq
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C) :
    overlayEdge B C .R .R .M .R = overlayEdge B C .R .R .R .M := by
  have heq₁ := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  have heq₂ := B.second_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at heq₁
  change overlayEdge B C .L .R .M .M +
      overlayEdge B C .M .R .L .M +
      overlayEdge B C .M .R .R .M +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .R .M = 8 at heq₂
  rw [overlayEdge_comm B C .M .R .R .M] at heq₂
  have hlower₁ := hlower.first
  have hlower₂ := hlower.second
  rw [overlayEdge_comm B C .R .M .R .R] at hlower₁
  rw [overlayEdge_comm B C .M .R .R .M,
    overlayEdge_comm B C .M .R .R .R] at hlower₂
  have hzero := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  omega

/-- The two head sums in (5.4) are equal. -/
lemma overlay_heads_eq
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C) :
    overlayEdge B C .R .L .M .M + overlayEdge B C .R .M .M .L =
      overlayEdge B C .L .R .M .M + overlayEdge B C .M .R .L .M := by
  have heq₁ := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  have heq₂ := B.second_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at heq₁
  change overlayEdge B C .L .R .M .M +
      overlayEdge B C .M .R .L .M +
      overlayEdge B C .M .R .R .M +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .R .M = 8 at heq₂
  rw [overlayEdge_comm B C .M .R .R .M] at heq₂
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  omega

/-- Equation (5.5) before introducing the nonnegative cardinal difference
`t`: the two head counts are exactly four times the difference between the
middle-middle and left-left block sizes. -/
lemma overlay_diagonal_degree
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C) :
    4 * (block B C .L .L).card + overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 4 * (block B C .M .M).card := by
  have hzero := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have h := B.diagonal_card_difference_of_overlay_first_stage
    C hreg hno4 hno6 hzero
  change 4 * (block B C .L .L).card + overlayEdge B C .L .R .M .M +
      overlayEdge B C .R .L .M .M = 4 * (block B C .M .M).card at h
  omega

/-- The natural-number form of (5.5): there is a nonnegative difference
`t` with `|X₂₂|=|X₁₁|+t` and `ν₁+ν₂=4t`. -/
lemma exists_overlay_card_difference
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C) :
    ∃ t : ℕ,
      (block B C .M .M).card = (block B C .L .L).card + t ∧
      overlayEdge B C .R .L .M .M + overlayEdge B C .L .R .M .M = 4 * t := by
  have hdegree := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
  have hle : (block B C .L .L).card ≤ (block B C .M .M).card := by
    omega
  obtain ⟨t, ht⟩ := Nat.exists_eq_add_of_le hle
  refine ⟨t, ht, ?_⟩
  omega

/-- The parity clause of (5.5): the difference `t` has the parity of the
diagonal union `X₁₁ ∪ X₂₂`. -/
lemma overlay_card_difference_parity
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) (t : ℕ)
    (ht : (block B C .M .M).card = (block B C .L .L).card + t) :
    t % 2 = (block B C .L .L ∪ block B C .M .M).card % 2 := by
  have hdis : Disjoint (block B C .L .L) (block B C .M .M) :=
    B.disjoint_block C (.inl (by decide))
  rw [Finset.card_union_of_disjoint hdis, ht]
  omega

/-- In the positive-`mu` case, equations (5.2)--(5.5) and (5.8) leave
only the three possibilities `nu1+nu2 = 0,4,8`.  This lemma deliberately
contains only the Presburger part of the argument; the next structural
lemmas exclude the last two values. -/
lemma positive_offDiagonal_nu_sum_cases
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M) :
    overlayEdge B C .R .L .M .M + overlayEdge B C .L .R .M .M = 0 ∨
    overlayEdge B C .R .L .M .M + overlayEdge B C .L .R .M .M = 4 ∨
    overlayEdge B C .R .L .M .M + overlayEdge B C .L .R .M .M = 8 := by
  have hfirst := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  have hsecond := B.second_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at hfirst
  change overlayEdge B C .L .R .M .M +
      overlayEdge B C .M .R .L .M +
      overlayEdge B C .M .R .R .M +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .R .M = 8 at hsecond
  rw [overlayEdge_comm B C .M .R .R .M] at hsecond
  have hzero := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  obtain ⟨t, _, hnu⟩ := B.exists_overlay_card_difference
    C hreg hno4 hno6 hlower
  have hmu := B.offDiagonal_eight_of_pos C hreg hconn hno2 hno4 hno6
    hcard₃₂ hpos
  omega

/-- If the positive-`mu` case reaches `nu1+nu2=8`, all the inequalities
used above are equalities: the off-diagonal cut is eight and both the
crossing term `mu` and the common tail `lambda` vanish. -/
lemma positive_case_equalities_of_nu_sum_eq_eight
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 8) :
    overlayEdge B C .R .M .M .L +
        overlayEdge B C .M .R .L .M = 8 ∧
      overlayEdge B C .R .M .M .R = 0 ∧
      overlayEdge B C .R .R .M .R = 0 := by
  have hfirst := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  have hsecond := B.second_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at hfirst
  change overlayEdge B C .L .R .M .M +
      overlayEdge B C .M .R .L .M +
      overlayEdge B C .M .R .R .M +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .R .M = 8 at hsecond
  rw [overlayEdge_comm B C .M .R .R .M] at hsecond
  have hzero := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hmu := B.offDiagonal_eight_of_pos C hreg hconn hno2 hno4 hno6
    hcard₃₂ hpos
  omega

/-- The last Presburger calculation in the `nu1+nu2=8` branch.  The two
off-diagonal block degree equations say that the difference of the two
cross counts is four times an odd integer; with sum eight, the counts are
therefore two and six in one order. -/
lemma cross_values_two_six_of_odd_card_sum
    {q a₁ a₂ n₁ n₂ : ℕ}
    (hsum : a₁ + a₂ = 8)
    (hfirst : q + a₁ = 4 * n₁)
    (hsecond : q + a₂ = 4 * n₂)
    (hodd : Odd (n₁ + n₂)) :
    (a₁ = 2 ∧ a₂ = 6) ∨ (a₁ = 6 ∧ a₂ = 2) := by
  obtain ⟨k, hk⟩ := hodd
  omega

lemma right_right_empty_of_positive_nu_sum_eight
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 8) :
    block B C .R .R = ∅ := by
  have heq := B.positive_case_equalities_of_nu_sum_eq_eight
    C hreg hconn hno2 hno4 hno6 hlower hcard₃₂ hpos hnu
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hboundary := B.right_right_boundary_ledger C hreg hno4 hno6
  have hzero : (Pseudograph.ofSimple G).boundaryMultiplicity
      (block B C .R .R) = 0 := by
    omega
  exact B.right_right_eq_empty_of_boundary_zero C hconn hcard₃₂ hzero

lemma overlayH2_odd_of_positive_nu_sum_eight
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 8)
    (h33 : block B C .R .R = ∅) :
    Odd (overlayH2 B C).card := by
  obtain ⟨t, htcard, htcount⟩ :=
    B.exists_overlay_card_difference C hreg hno4 hno6 hlower
  have ht : t = 2 := by omega
  have hparity := B.overlay_card_difference_parity C t htcard
  have hH1mod : (overlayH1 B C).card % 2 = 0 := by
    change t % 2 = (overlayH1 B C).card % 2 at hparity
    omega
  have hH1even : Even (overlayH1 B C).card :=
    Nat.even_iff.mpr hH1mod
  have hBcard := B.first_right_overlay_card C
  have hCcard := B.second_right_overlay_card C
  rw [h33] at hBcard hCcard
  simp only [Finset.card_empty, Nat.add_zero] at hBcard hCcard
  have hH4odd : Odd (overlayH4 B C).card := by
    simpa [hBcard] using B.odd_right_card
  have hH3odd : Odd (overlayH3 B C).card := by
    simpa [hCcard] using C.odd_right_card
  have hgroups := B.overlay_groups_card C
  rw [h33] at hgroups
  simp only [Finset.card_empty, Nat.add_zero] at hgroups
  obtain ⟨k, hk⟩ := hodd
  obtain ⟨k1, hk1⟩ := hH1even
  obtain ⟨k3, hk3⟩ := hH3odd
  obtain ⟨k4, hk4⟩ := hH4odd
  exact ⟨k - k1 - k3 - k4 - 1, by omega⟩

lemma cross_values_of_positive_nu_sum_eight
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 8)
    (hH2odd : Odd (overlayH2 B C).card) :
    (overlayEdge B C .R .L .M .M = 2 ∧
        overlayEdge B C .L .R .M .M = 6) ∨
      (overlayEdge B C .R .L .M .M = 6 ∧
        overlayEdge B C .L .R .M .M = 2) := by
  let P := Pseudograph.ofSimple G
  let q := P.betweenMultiplicity (block B C .L .M) (block B C .M .L)
  have heq := B.positive_case_equalities_of_nu_sum_eq_eight
    C hreg hconn hno2 hno4 hno6 hlower hcard₃₂ hpos hnu
  have hheads := B.overlay_heads_eq C hreg hno4 hno6 hlower
  have hrelations :
      overlayEdge B C .R .M .M .L = overlayEdge B C .L .R .M .M ∧
      overlayEdge B C .M .R .L .M = overlayEdge B C .R .L .M .M := by
    omega
  have h12 := B.x12_degree_ledger C hreg hno4 hno6
  change q + overlayEdge B C .M .R .L .M =
    4 * (block B C .L .M).card at h12
  have h21 := B.x21_degree_ledger C hreg hno4 hno6
  rw [P.betweenMultiplicity_comm (block B C .M .L) (block B C .L .M),
    P.betweenMultiplicity_comm (block B C .M .L) (block B C .R .M)] at h21
  change q + overlayEdge B C .R .M .M .L =
    4 * (block B C .M .L).card at h21
  have hH2card := B.overlayH2_card C
  have hoddSum : Odd ((block B C .L .M).card +
      (block B C .M .L).card) := by
    rw [hH2card] at hH2odd
    exact hH2odd
  apply cross_values_two_six_of_odd_card_sum hnu
    (by omega : q + overlayEdge B C .R .L .M .M =
      4 * (block B C .L .M).card)
    (by omega : q + overlayEdge B C .L .R .M .M =
      4 * (block B C .M .L).card)
    hoddSum

structure NuEightCutData {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Prop where
  h1 : (Pseudograph.ofSimple G).boundaryMultiplicity (overlayH1 B C) = 8
  h3 : (Pseudograph.ofSimple G).boundaryMultiplicity (overlayH3 B C) = 8
  h4 : (Pseudograph.ofSimple G).boundaryMultiplicity (overlayH4 B C) = 8
  between13 : (Pseudograph.ofSimple G).betweenMultiplicity
      (overlayH1 B C) (overlayH3 B C) = overlayEdge B C .L .R .M .M
  between14 : (Pseudograph.ofSimple G).betweenMultiplicity
      (overlayH1 B C) (overlayH4 B C) = overlayEdge B C .R .L .M .M

lemma nuEightCutData
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 8) :
    NuEightCutData B C := by
  have heq := B.positive_case_equalities_of_nu_sum_eq_eight
    C hreg hconn hno2 hno4 hno6 hlower hcard₃₂ hpos hnu
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hheads := B.overlay_heads_eq C hreg hno4 hno6 hlower
  have hH1 := B.diagonal_boundary_ledger C hreg hno4 hno6
  change (Pseudograph.ofSimple G).boundaryMultiplicity (overlayH1 B C) = _ at hH1
  have hH3 := B.upper_right_column_boundary_ledger C hreg hno4 hno6
  dsimp only at hH3
  change (Pseudograph.ofSimple G).boundaryMultiplicity (overlayH3 B C) =
      overlayEdge B C .L .R .M .M +
      overlayEdge B C .M .R .L .M +
      overlayEdge B C .M .R .R .M +
      overlayEdge B C .M .R .R .R at hH3
  rw [overlayEdge_comm B C .M .R .R .M,
    overlayEdge_comm B C .M .R .R .R] at hH3
  have hH4 := B.lower_right_row_boundary_ledger C hreg hno4 hno6
  dsimp only at hH4
  change (Pseudograph.ofSimple G).boundaryMultiplicity (overlayH4 B C) =
      overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .M .R .R at hH4
  rw [overlayEdge_comm B C .R .M .R .R] at hH4
  have h13 := B.between_H1_H3 C hreg hno4 hno6
  have h14 := B.between_H1_H4 C hreg hno4 hno6
  change _ = overlayEdge B C .L .R .M .M at h13
  change _ = overlayEdge B C .R .L .M .M at h14
  refine ⟨?_, ?_, ?_, h13, h14⟩ <;> omega

/-- The value `nu1+nu2=8` in the positive-`mu` case creates a nontrivial
four-cut, exactly as in Tashkinov's Case 2. -/
lemma positive_nu_sum_ne_eight
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M) :
    overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M ≠ 8 := by
  intro hnu
  have h33 := B.right_right_empty_of_positive_nu_sum_eight
    C hreg hconn hno2 hno4 hno6 hlower hcard₃₂ hpos hnu
  have hH2odd := B.overlayH2_odd_of_positive_nu_sum_eight
    C hodd hreg hno4 hno6 hlower hnu h33
  have hcross := B.cross_values_of_positive_nu_sum_eight
    C hreg hconn hno2 hno4 hno6 hlower hcard₃₂ hpos hnu hH2odd
  have hcuts := B.nuEightCutData C hreg hconn hno2 hno4 hno6
    hlower hcard₃₂ hpos hnu
  rcases hcross with hsmall | hsmall
  · have hbetween : (Pseudograph.ofSimple G).betweenMultiplicity
        (overlayH1 B C) (overlayH3 B C) = 6 := by
      rw [hcuts.between13, hsmall.2]
    have hSR : Disjoint (overlayH1 B C ∪ overlayH3 B C)
        (overlayH4 B C) :=
      Finset.disjoint_union_left.mpr
        ⟨B.disjoint_H1_H4 C, B.disjoint_H3_H4 C⟩
    have hRcard : 2 ≤ (overlayH4 B C).card :=
      hcard₃₂.trans (Finset.card_le_card Finset.subset_union_right)
    exact false_of_two_eight_shores_between_six G hreg hno4
      (overlayH1 B C) (overlayH3 B C) (overlayH4 B C)
      (B.disjoint_H1_H3 C) hSR hcuts.h1 hcuts.h3 hbetween hRcard
  · have hbetween : (Pseudograph.ofSimple G).betweenMultiplicity
        (overlayH1 B C) (overlayH4 B C) = 6 := by
      rw [hcuts.between14, hsmall.1]
    have hH3card : 2 ≤ (overlayH3 B C).card := by
      have hbetween13 := hcuts.between13
      rw [hsmall.2] at hbetween13
      by_contra hnot
      have hle : (overlayH3 B C).card ≤ 1 := by omega
      have hnonempty : (overlayH3 B C).Nonempty := by
        by_contra h
        have hempty := Finset.not_nonempty_iff_eq_empty.mp h
        rw [hempty, Pseudograph.betweenMultiplicity_empty_right] at hbetween13
        omega
      have hcardone : (overlayH3 B C).card = 1 := by
        have := Finset.card_pos.mpr hnonempty
        omega
      obtain ⟨x, hx⟩ := Finset.card_eq_one.mp hcardone
      have hcut := hcuts.h3
      have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg x
      rw [hx, hsingle] at hcut
      omega
    have hSR : Disjoint (overlayH1 B C ∪ overlayH4 B C)
        (overlayH2 B C ∪ overlayH3 B C) := by
      exact Finset.disjoint_union_left.mpr
        ⟨Finset.disjoint_union_right.mpr
            ⟨B.disjoint_H1_H2 C, B.disjoint_H1_H3 C⟩,
          Finset.disjoint_union_right.mpr
            ⟨(B.disjoint_H2_H4 C).symm, (B.disjoint_H3_H4 C).symm⟩⟩
    have hRcard' : 2 ≤ (overlayH2 B C ∪ overlayH3 B C).card :=
      hH3card.trans (Finset.card_le_card Finset.subset_union_right)
    exact false_of_two_eight_shores_between_six G hreg hno4
      (overlayH1 B C) (overlayH4 B C) (overlayH2 B C ∪ overlayH3 B C)
      (B.disjoint_H1_H4 C) hSR hcuts.h1 hcuts.h4 hbetween hRcard'

structure NuFourData {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Prop where
  h1_card : (overlayH1 B C).card = 1
  x11_empty : block B C .L .L = ∅
  x22_card : (block B C .M .M).card = 1
  nu1 : overlayEdge B C .R .L .M .M = 2
  nu2 : overlayEdge B C .L .R .M .M = 2

/-- In the value-four branch, `H1` is the trivial four-component.  The
per-vertex cut bound (5.1) then splits its four cut edges as two and two. -/
lemma nuFourData
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 4) :
    NuFourData B C := by
  classical
  let P := Pseudograph.ofSimple G
  let H₁ := overlayH1 B C
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have hcut := B.diagonal_boundary_ledger C hreg hno4 hno6
  change P.boundaryMultiplicity H₁ = _ at hcut
  have hcut4 : P.boundaryMultiplicity H₁ = 4 := by omega
  have hnonempty : H₁.Nonempty := by
    by_contra h
    have hempty := Finset.not_nonempty_iff_eq_empty.mp h
    rw [hempty, P.boundaryMultiplicity_empty] at hcut4
    omega
  have hHX : Disjoint H₁ (block B C .R .M) := by
    exact Finset.disjoint_union_left.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  have hXsub : block B C .R .M ⊆ H₁ᶜ := by
    intro x hx
    simp only [Finset.mem_compl]
    exact fun hH ↦ (Finset.disjoint_left.mp hHX) hH hx
  have hcompcard : 2 ≤ H₁ᶜ.card :=
    hcard₃₂.trans (Finset.card_le_card hXsub)
  have hproper : H₁ ≠ Finset.univ := by
    intro hEq
    have : H₁ᶜ.card = 0 := by simp [hEq]
    omega
  have hHcard : H₁.card = 1 := by
    rcases hno4 H₁ hnonempty hproper hcut4 with h | h
    · exact h
    · omega
  obtain ⟨t, htcard, htcount⟩ :=
    B.exists_overlay_card_difference C hreg hno4 hno6 hlower
  have ht : t = 1 := by omega
  have hHcard' := B.overlayH1_card C
  have h11card : (block B C .L .L).card = 0 := by
    change H₁.card = _ at hHcard'
    omega
  have h11empty : block B C .L .L = ∅ := Finset.card_eq_zero.mp h11card
  have h22card : (block B C .M .M).card = 1 := by omega
  obtain ⟨x, hx22⟩ := Finset.card_eq_one.mp h22card
  have hx22mem : x ∈ block B C .M .M := by simp [hx22]
  have hxBmiddle := (mem_block.mp hx22mem).1
  have hxCmiddle := (mem_block.mp hx22mem).2
  have hxBnot : x ∉ B.right := fun hx ↦
    (Finset.disjoint_left.mp B.disjoint_middle_right) hxBmiddle hx
  have hxCnot : x ∉ C.right := fun hx ↦
    (Finset.disjoint_left.mp C.disjoint_middle_right) hxCmiddle hx
  have h31sub : block B C .R .L ⊆ B.right := fun _ h ↦ (mem_block.mp h).1
  have h13sub : block B C .L .R ⊆ C.right := fun _ h ↦ (mem_block.mp h).2
  have hdisB : Disjoint ({x} : Finset V) B.right := by simp [hxBnot]
  have hdisC : Disjoint ({x} : Finset V) C.right := by simp [hxCnot]
  have hmono1 := P.betweenMultiplicity_mono_right {x}
    (block B C .R .L) B.right h31sub hdisB
  have hmono2 := P.betweenMultiplicity_mono_right {x}
    (block B C .L .R) C.right h13sub hdisC
  have hle1 := B.between_singleton_right_le_two hreg hno4 hno6 x hxBnot
  have hle2 := C.between_singleton_right_le_two hreg hno4 hno6 x hxCnot
  change P.betweenMultiplicity {x} B.right ≤ 2 at hle1
  change P.betweenMultiplicity {x} C.right ≤ 2 at hle2
  have ha1 : overlayEdge B C .R .L .M .M =
      P.betweenMultiplicity {x} (block B C .R .L) := by
    unfold overlayEdge
    rw [hx22, P.betweenMultiplicity_comm]
  have ha2 : overlayEdge B C .L .R .M .M =
      P.betweenMultiplicity {x} (block B C .L .R) := by
    unfold overlayEdge
    rw [hx22, P.betweenMultiplicity_comm]
  refine ⟨hHcard, h11empty, h22card, ?_, ?_⟩ <;> omega

lemma right_right_even_of_nu_sum_four
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hdata : NuFourData B C) :
    Even (block B C .R .R).card := by
  let P := Pseudograph.ofSimple G
  let q := P.betweenMultiplicity (block B C .L .M) (block B C .M .L)
  have hheads := B.overlay_heads_eq C hreg hno4 hno6 hlower
  have hnu1 := hdata.nu1
  have hnu2 := hdata.nu2
  have hb : overlayEdge B C .R .M .M .L =
      overlayEdge B C .M .R .L .M := by omega
  have h12 := B.x12_degree_ledger C hreg hno4 hno6
  change q + overlayEdge B C .M .R .L .M =
    4 * (block B C .L .M).card at h12
  have h21 := B.x21_degree_ledger C hreg hno4 hno6
  rw [P.betweenMultiplicity_comm (block B C .M .L) (block B C .L .M),
    P.betweenMultiplicity_comm (block B C .M .L) (block B C .R .M)] at h21
  change q + overlayEdge B C .R .M .M .L =
    4 * (block B C .M .L).card at h21
  have hcardsEq : (block B C .L .M).card =
      (block B C .M .L).card := by omega
  have hH2card := B.overlayH2_card C
  have hH2even : Even (overlayH2 B C).card := by
    refine ⟨(block B C .L .M).card, ?_⟩
    omega
  have hBcard := B.first_right_overlay_card C
  have hCcard := B.second_right_overlay_card C
  have hgroups := B.overlay_groups_card C
  have hH1card := hdata.h1_card
  obtain ⟨k, hk⟩ := hodd
  obtain ⟨k2, hk2⟩ := hH2even
  obtain ⟨kB, hkB⟩ := B.odd_right_card
  obtain ⟨kC, hkC⟩ := C.odd_right_card
  rw [Nat.even_iff]
  omega

lemma tail_le_two_of_positive_nu_sum_four
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hdata : NuFourData B C) :
    overlayEdge B C .R .R .M .R ≤ 2 := by
  have hfirst := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at hfirst
  have hzero := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have hheads := B.overlay_heads_eq C hreg hno4 hno6 hlower
  have hmu := B.offDiagonal_eight_of_pos C hreg hconn hno2 hno4 hno6
    hcard₃₂ hpos
  have hnu1 := hdata.nu1
  have hnu2 := hdata.nu2
  omega

lemma right_right_empty_of_positive_nu_sum_four
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (heven : Even (block B C .R .R).card)
    (htail : overlayEdge B C .R .R .M .R ≤ 2) :
    block B C .R .R = ∅ ∧ overlayEdge B C .R .R .M .R = 0 := by
  classical
  let P := Pseudograph.ofSimple G
  let S := block B C .R .R
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hboundary := B.right_right_boundary_ledger C hreg hno4 hno6
  change P.boundaryMultiplicity S = _ at hboundary
  have hcutle : P.boundaryMultiplicity S ≤ 4 := by omega
  have hSX : Disjoint S (block B C .R .M) :=
    B.disjoint_block C (.inr (by decide))
  have hXsub : block B C .R .M ⊆ Sᶜ := by
    intro x hx
    simp only [Finset.mem_compl]
    exact fun hS ↦ (Finset.disjoint_left.mp hSX) hS hx
  have hcompcard : 2 ≤ Sᶜ.card :=
    hcard₃₂.trans (Finset.card_le_card hXsub)
  have hproper : S ≠ Finset.univ := by
    intro hEq
    have : Sᶜ.card = 0 := by simp [hEq]
    omega
  have hsempty : S = ∅ := by
    by_contra hne
    have hSnonempty : S.Nonempty := Finset.nonempty_iff_ne_empty.mpr hne
    have hpos := boundaryMultiplicity_pos_of_connected G hconn S hSnonempty hproper
    change 0 < P.boundaryMultiplicity S at hpos
    have hcutEven := P.boundaryMultiplicity_even_of_even_regular (r := 2)
      (by simpa using
        ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
    have hcases : P.boundaryMultiplicity S = 2 ∨
        P.boundaryMultiplicity S = 4 := by
      obtain ⟨k, hk⟩ := hcutEven
      omega
    rcases hcases with h2 | h4
    · exact hno2 S hSnonempty hproper h2
    · have hScard : S.card ≠ 1 := by
        intro hcard
        change Even S.card at heven
        obtain ⟨k, hk⟩ := heven
        omega
      rcases hno4 S hSnonempty hproper h4 with h | h
      · exact hScard h
      · omega
  have hcutzero : P.boundaryMultiplicity S = 0 := by simp [hsempty]
  refine ⟨hsempty, ?_⟩
  omega

/-- In the value-four branch, the independent set used by Tashkinov is
`C.left ∪ X23`. -/
lemma left_union_x23_isIndepSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    G.IsIndepSet
      ((C.left ∪ block B C .M .R : Finset V) : Set V) := by
  intro x hx y hy hxy
  simp only [Finset.coe_union, Set.mem_union] at hx hy
  rcases hx with hxL | hx23 <;> rcases hy with hyL | hy23
  · exact C.left_isIndepSet hreg hno4 hno6 hxL hyL hxy
  · exact C.not_adj_left_right hreg hno4 hno6 hxL
      (mem_block.mp hy23).2
  · exact fun hAdj ↦ C.not_adj_left_right hreg hno4 hno6 hyL
      (mem_block.mp hx23).2 hAdj.symm
  · exact B.middle_isIndepSet (mem_block.mp hx23).1
      (mem_block.mp hy23).1 hxy

/-- If `X33` is empty, the complement of `C.left ∪ X23` is exactly
`C.middle ∪ X13`. -/
lemma compl_left_union_x23
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (h33 : block B C .R .R = ∅) :
    (C.left ∪ block B C .M .R)ᶜ =
      C.middle ∪ block B C .L .R := by
  classical
  ext x
  simp only [Finset.mem_compl, Finset.mem_union]
  constructor
  · intro hx
    obtain ⟨t, hxt, _⟩ := C.existsUnique_mem_side x
    cases t with
    | L => exact False.elim (hx (.inl hxt))
    | M => exact .inl hxt
    | R =>
        obtain ⟨s, hxs, _⟩ := B.existsUnique_mem_side x
        cases s with
        | L => exact .inr (mem_block.mpr ⟨hxs, hxt⟩)
        | M => exact False.elim (hx (.inr (mem_block.mpr ⟨hxs, hxt⟩)))
        | R =>
            have hx33 : x ∈ block B C .R .R := mem_block.mpr ⟨hxs, hxt⟩
            rw [h33] at hx33
            simp at hx33
  · intro hx hU
    rcases hx with hxM | hx13 <;> rcases hU with hxL | hx23
    · exact (Finset.disjoint_left.mp C.disjoint_left_middle) hxL hxM
    · exact (Finset.disjoint_left.mp C.disjoint_middle_right)
        hxM (mem_block.mp hx23).2
    · exact (Finset.disjoint_left.mp C.disjoint_left_right)
        hxL (mem_block.mp hx13).2
    · exact (Finset.disjoint_left.mp B.disjoint_left_middle)
        (mem_block.mp hx13).1 (mem_block.mp hx23).1

/-- The only edges from the whole middle side of `C` to `X13` are the
`X22--X13` edges. -/
lemma between_second_middle_x13
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    (Pseudograph.ofSimple G).betweenMultiplicity C.middle
        (block B C .L .R) =
      overlayEdge B C .L .R .M .M := by
  classical
  let P := Pseudograph.ofSimple G
  let A₁ := block B C .L .M
  let A₂ := block B C .M .M
  let A₃ := block B C .R .M
  let T := block B C .L .R
  have hA₁₂ : Disjoint A₁ A₂ :=
    B.disjoint_block C (.inl (by decide))
  have hA₁₃ : Disjoint A₁ A₃ :=
    B.disjoint_block C (.inl (by decide))
  have hA₂₃ : Disjoint A₂ A₃ :=
    B.disjoint_block C (.inl (by decide))
  have hA₁₂_A₃ : Disjoint (A₁ ∪ A₂) A₃ :=
    Finset.disjoint_union_left.mpr ⟨hA₁₃, hA₂₃⟩
  have hA₁T : Disjoint A₁ T := B.disjoint_block C (.inr (by decide))
  have hA₂T : Disjoint A₂ T := B.disjoint_block C (.inl (by decide))
  have hA₃T : Disjoint A₃ T := B.disjoint_block C (.inl (by decide))
  have hA₁₂T : Disjoint (A₁ ∪ A₂) T :=
    Finset.disjoint_union_left.mpr ⟨hA₁T, hA₂T⟩
  have hAllT : Disjoint ((A₁ ∪ A₂) ∪ A₃) T :=
    Finset.disjoint_union_left.mpr ⟨hA₁₂T, hA₃T⟩
  have hz₁ : P.betweenMultiplicity A₁ T = 0 := by
    simpa [P, A₁, T] using
      (B.between_block_eq_zero_of_forbidden_row C hreg hno4 hno6
        (s := .L) (s' := .L) (t := .M) (t' := .R) (by trivial))
  have hz₃ : P.betweenMultiplicity A₃ T = 0 := by
    simpa [P, A₃, T] using
      (B.between_block_eq_zero_of_forbidden_row C hreg hno4 hno6
        (s := .R) (s' := .L) (t := .M) (t' := .R) (by trivial))
  have hcolumn := B.block_column_union C .M
  change A₁ ∪ A₂ ∪ A₃ = C.middle at hcolumn
  rw [← hcolumn,
    P.betweenMultiplicity_union_left (A₁ ∪ A₂) A₃ T
      hA₁₂_A₃ hAllT,
    P.betweenMultiplicity_union_left A₁ A₂ T hA₁₂ hA₁₂T,
    hz₁, hz₃, Nat.zero_add, Nat.add_zero]
  exact P.betweenMultiplicity_comm A₂ T

lemma disjoint_second_middle_x13
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint C.middle (block B C .L .R) := by
  exact Disjoint.mono (by rfl) (fun _ hx ↦ (mem_block.mp hx).2)
    C.disjoint_middle_right

/-- All of the cut and parity arithmetic in the value-four branch, isolated
from the final independent-complement contradiction. -/
lemma right_right_empty_of_nu_sum_four
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hnu : overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M = 4) :
    NuFourData B C ∧ block B C .R .R = ∅ := by
  have hdata := B.nuFourData C hreg hno4 hno6 hlower hcard₃₂ hnu
  have heven := B.right_right_even_of_nu_sum_four C hodd hreg hno4 hno6
    hlower hdata
  have htail := B.tail_le_two_of_positive_nu_sum_four C hreg hconn hno2
    hno4 hno6 hlower hcard₃₂ hpos hdata
  have h33 := B.right_right_empty_of_positive_nu_sum_four C hreg hconn hno2
    hno4 hno6 hlower hcard₃₂ heven htail
  exact ⟨hdata, h33.1⟩

/-- The independent-complement contradiction at the end of the
value-four branch. -/
lemma false_of_nuFourData_of_right_right_empty
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hdata : NuFourData B C)
    (h33 : block B C .R .R = ∅) : False := by
  let P := Pseudograph.ofSimple G
  let U := C.left ∪ block B C .M .R
  let T := C.middle ∪ block B C .L .R
  have hUind : G.IsIndepSet (U : Set V) := by
    simpa [U] using B.left_union_x23_isIndepSet C hreg hno4 hno6
  have hcomp : Uᶜ = T := by
    simpa [U, T] using B.compl_left_union_x23 C h33
  have hdis := B.disjoint_second_middle_x13 C
  have hMint : P.internalMultiplicity C.middle = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G C.middle C.middle_isIndepSet
  have h13ind : G.IsIndepSet ((block B C .L .R : Finset V) : Set V) := by
    intro x hx y hy hxy
    exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx).1 (mem_block.mp hy).1 hxy
  have h13int : P.internalMultiplicity (block B C .L .R) = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G (block B C .L .R) h13ind
  have hbetween := B.between_second_middle_x13 C hreg hno4 hno6
  have hnu2 := hdata.nu2
  have hint := P.internalMultiplicity_union C.middle (block B C .L .R) hdis
  change P.internalMultiplicity T = _ at hint
  change P.betweenMultiplicity C.middle (block B C .L .R) =
    overlayEdge B C .L .R .M .M at hbetween
  have hTint : P.internalMultiplicity T = 2 := by
    rw [hMint, h13int, hbetween] at hint
    omega
  have hlarge := hindependentComplement U hUind
  rw [hcomp, hTint] at hlarge
  omega

/-- The value-four branch is impossible: the source's independent set has
a complement containing exactly two edges, contrary to Proposition 4.1. -/
lemma positive_nu_sum_ne_four
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M) :
    overlayEdge B C .R .L .M .M +
      overlayEdge B C .L .R .M .M ≠ 4 := by
  intro hnu
  obtain ⟨hdata, h33⟩ := B.right_right_empty_of_nu_sum_four C hodd hreg
    hconn hno2 hno4 hno6 hlower hcard₃₂ hpos hnu
  exact B.false_of_nuFourData_of_right_right_empty C hreg hno4 hno6
    hindependentComplement hdata h33

/-- Thus the two `nu` terms vanish in Tashkinov's positive-`mu` case. -/
lemma positive_nu_values_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M) :
    overlayEdge B C .R .L .M .M = 0 ∧
      overlayEdge B C .L .R .M .M = 0 := by
  have hcases := B.positive_offDiagonal_nu_sum_cases C hreg hconn hno2
    hno4 hno6 hlower hcard₃₂ hpos
  have hne4 := B.positive_nu_sum_ne_four C hodd hreg hconn hno2 hno4 hno6
    hindependentComplement hlower hcard₃₂ hpos
  have hne8 := B.positive_nu_sum_ne_eight C hodd hreg hconn hno2 hno4 hno6
    hlower hcard₃₂ hpos
  rcases hcases with hzero | hfour | height
  · omega
  · exact False.elim (hne4 hfour)
  · exact False.elim (hne8 height)

/-- Once `nu1=0`, the faithful selection cannot have chosen a vertex in
the first right component: its retained middle neighbour would itself be a
positive `X31--X22` edge. -/
lemma selection_vertex_mem_middle_of_nu1_zero
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hnu1 : overlayEdge B C .R .L .M .M = 0) :
    selection.vertex ∈ B.middle := by
  rcases selection.mem_right_or_middle with hwR | hwM
  · obtain ⟨x, hxM, hwx⟩ := selection.right_has_middle_neighbor hwR
    have hwCL : selection.vertex ∈ C.left := C.mem_left_distinguished
    have hxCM := C.mem_middle_of_adj_left hreg hno4 hno6 hwCL hwx
    have hw31 : selection.vertex ∈ block B C .R .L :=
      mem_block.mpr ⟨hwR, hwCL⟩
    have hx22 : x ∈ block B C .M .M := mem_block.mpr ⟨hxM, hxCM⟩
    have hdis : Disjoint (block B C .R .L) (block B C .M .M) :=
      B.disjoint_block C (.inl (by decide))
    have hpos := betweenMultiplicity_pos_of_adj_mem G
      (block B C .R .L) (block B C .M .M) hdis hwx hw31 hx22
    change 0 < overlayEdge B C .R .L .M .M at hpos
    omega
  · exact hwM

lemma mu_values_equal_of_nu_values_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hnu1 : overlayEdge B C .R .L .M .M = 0)
    (hnu2 : overlayEdge B C .L .R .M .M = 0) :
    overlayEdge B C .R .M .M .L =
      overlayEdge B C .M .R .L .M := by
  have hheads := B.overlay_heads_eq C hreg hno4 hno6 hlower
  omega

lemma diagonal_empty_of_nu_values_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hnu1 : overlayEdge B C .R .L .M .M = 0)
    (hnu2 : overlayEdge B C .L .R .M .M = 0) :
    overlayH1 B C = ∅ := by
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have hcut := B.diagonal_boundary_ledger C hreg hno4 hno6
  have hzero : (Pseudograph.ofSimple G).boundaryMultiplicity
      (overlayH1 B C) = 0 := by
    change (Pseudograph.ofSimple G).boundaryMultiplicity
      (overlayH1 B C) = _ at hcut
    omega
  exact B.diagonal_eq_empty_of_boundary_zero C hconn hcard₃₂ hzero

lemma offDiagonal_even_of_mu_values_equal
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hmu : overlayEdge B C .R .M .M .L =
      overlayEdge B C .M .R .L .M) :
    Even (overlayH2 B C).card := by
  let P := Pseudograph.ofSimple G
  let q := P.betweenMultiplicity (block B C .L .M) (block B C .M .L)
  have h12 := B.x12_degree_ledger C hreg hno4 hno6
  change q + overlayEdge B C .M .R .L .M =
    4 * (block B C .L .M).card at h12
  have h21 := B.x21_degree_ledger C hreg hno4 hno6
  rw [P.betweenMultiplicity_comm (block B C .M .L) (block B C .L .M),
    P.betweenMultiplicity_comm (block B C .M .L) (block B C .R .M)] at h21
  change q + overlayEdge B C .R .M .M .L =
    4 * (block B C .M .L).card at h21
  have hcards : (block B C .L .M).card =
      (block B C .M .L).card := by omega
  have hH2 := B.overlayH2_card C
  refine ⟨(block B C .L .M).card, ?_⟩
  omega

lemma right_right_odd_of_diagonal_empty_of_offDiagonal_even
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hH1 : overlayH1 B C = ∅)
    (hH2 : Even (overlayH2 B C).card) :
    Odd (block B C .R .R).card := by
  have hgroups := B.overlay_groups_card C
  have hBcard := B.first_right_overlay_card C
  have hCcard := B.second_right_overlay_card C
  obtain ⟨k, hk⟩ := hodd
  obtain ⟨k2, hk2⟩ := hH2
  obtain ⟨kB, hkB⟩ := B.odd_right_card
  obtain ⟨kC, hkC⟩ := C.odd_right_card
  rw [hH1] at hgroups
  simp only [Finset.card_empty, Nat.zero_add] at hgroups
  rw [Nat.odd_iff]
  omega

lemma x12_card_eq_x21_of_mu_values_equal
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hmu : overlayEdge B C .R .M .M .L =
      overlayEdge B C .M .R .L .M) :
    (block B C .L .M).card = (block B C .M .L).card := by
  let P := Pseudograph.ofSimple G
  let q := P.betweenMultiplicity (block B C .L .M) (block B C .M .L)
  have h12 := B.x12_degree_ledger C hreg hno4 hno6
  change q + overlayEdge B C .M .R .L .M =
    4 * (block B C .L .M).card at h12
  have h21 := B.x21_degree_ledger C hreg hno4 hno6
  rw [P.betweenMultiplicity_comm (block B C .M .L) (block B C .L .M),
    P.betweenMultiplicity_comm (block B C .M .L) (block B C .R .M)] at h21
  change q + overlayEdge B C .R .M .M .L =
    4 * (block B C .M .L).card at h21
  omega

/-- With the diagonal blocks empty, `B.left ∪ C.middle` is independent.
This is the set used to exclude `lambda=2`. -/
lemma first_left_union_second_middle_isIndepSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hH1 : overlayH1 B C = ∅) :
    G.IsIndepSet ((B.left ∪ C.middle : Finset V) : Set V) := by
  intro x hx y hy hxy
  simp only [Finset.coe_union, Set.mem_union] at hx hy
  rcases hx with hxL | hxM <;> rcases hy with hyL | hyM
  · exact B.left_isIndepSet hreg hno4 hno6 hxL hyL hxy
  · intro hAdj
    have hyBM := B.mem_middle_of_adj_left hreg hno4 hno6 hxL hAdj
    have hy22 : y ∈ block B C .M .M := mem_block.mpr ⟨hyBM, hyM⟩
    have : y ∈ overlayH1 B C := Finset.mem_union_right _ hy22
    rw [hH1] at this
    simp at this
  · intro hAdj
    have hxBM := B.mem_middle_of_adj_left hreg hno4 hno6 hyL hAdj.symm
    have hx22 : x ∈ block B C .M .M := mem_block.mpr ⟨hxBM, hxM⟩
    have : x ∈ overlayH1 B C := Finset.mem_union_right _ hx22
    rw [hH1] at this
    simp at this
  · exact C.middle_isIndepSet hxM hyM hxy

/-- If `X11=X22=∅`, `|X12|=|X21|`, and `X33` is a singleton, the
complement of `B.left ∪ C.middle` has exactly one more vertex. -/
lemma compl_first_left_union_second_middle_card
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hH1 : overlayH1 B C = ∅)
    (h12_21 : (block B C .L .M).card = (block B C .M .L).card)
    (h33 : (block B C .R .R).card = 1) :
    (B.left ∪ C.middle)ᶜ.card = (B.left ∪ C.middle).card + 1 := by
  let U := B.left ∪ C.middle
  have hH1card := B.overlayH1_card C
  rw [hH1] at hH1card
  simp only [Finset.card_empty] at hH1card
  have hrowL := B.block_row_card C .L
  have hrowM := B.block_row_card C .M
  have hrowR := B.block_row_card C .R
  have hcolL := C.block_row_card B .L
  have hcolM := C.block_row_card B .M
  simp only [side_L, side_M, side_R, block_swap] at hrowL hrowM hrowR hcolL hcolM
  have hBledger := (B.typeC_degree_ledger hreg hno4 hno6).2.2.2
  have hCledger := (C.typeC_degree_ledger hreg hno4 hno6).2.2.2
  have hUcard := Finset.card_union_add_card_inter B.left C.middle
  change U.card + (block B C .L .M).card =
    B.left.card + C.middle.card at hUcard
  have hcompl := Finset.card_add_card_compl U
  have htotal := B.sides_card
  have hcompl' : U.card + Uᶜ.card = Nat.card V := by
    simpa [Nat.card_eq_fintype_card] using hcompl
  change Uᶜ.card = U.card + 1
  omega

/-- The quartic degree identity turns the preceding one-vertex imbalance
into exactly two internal edges in the complement. -/
lemma internal_compl_first_left_union_second_middle_eq_two
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hUind : G.IsIndepSet
      ((B.left ∪ C.middle : Finset V) : Set V))
    (hcard : (B.left ∪ C.middle)ᶜ.card =
      (B.left ∪ C.middle).card + 1) :
    (Pseudograph.ofSimple G).internalMultiplicity
      (B.left ∪ C.middle)ᶜ = 2 := by
  let P := Pseudograph.ofSimple G
  let U := B.left ∪ C.middle
  have hUint : P.internalMultiplicity U = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G U hUind
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hUdegree := P.regular_card_eq_two_internal_add_boundary hregular U
  have hCdegree := P.regular_card_eq_two_internal_add_boundary hregular Uᶜ
  have hboundary := P.boundaryMultiplicity_compl U
  change Uᶜ.card = U.card + 1 at hcard
  rw [hUint, Nat.mul_zero, Nat.zero_add] at hUdegree
  rw [hboundary] at hCdegree
  change P.internalMultiplicity Uᶜ = 2
  omega

lemma right_right_boundary_eq_twice_tail
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C) :
    (Pseudograph.ofSimple G).boundaryMultiplicity (block B C .R .R) =
      2 * overlayEdge B C .R .R .M .R := by
  have hboundary := B.right_right_boundary_ledger C hreg hno4 hno6
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  omega

/-- Equations (5.9) force the common tail value `lambda` to be at least
four.  Values zero, one, and three give forbidden cuts; value two is the
independent-complement equality case. -/
lemma four_le_tail_of_positive_core
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hH1 : overlayH1 B C = ∅)
    (hmu : overlayEdge B C .R .M .M .L =
      overlayEdge B C .M .R .L .M)
    (h33odd : Odd (block B C .R .R).card) :
    4 ≤ overlayEdge B C .R .R .M .R := by
  classical
  let P := Pseudograph.ofSimple G
  let S := block B C .R .R
  let l := overlayEdge B C .R .R .M .R
  have hcut := B.right_right_boundary_eq_twice_tail C hreg hno4 hno6 hlower
  change P.boundaryMultiplicity S = 2 * l at hcut
  have hSnonempty : S.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hEmpty
    change Odd S.card at h33odd
    rw [hEmpty] at h33odd
    simpa using h33odd
  have hSX : Disjoint S (block B C .R .M) :=
    B.disjoint_block C (.inr (by decide))
  have hXsub : block B C .R .M ⊆ Sᶜ := by
    intro x hx
    simp only [Finset.mem_compl]
    exact fun hS ↦ (Finset.disjoint_left.mp hSX) hS hx
  have hcompcard : 2 ≤ Sᶜ.card :=
    hcard₃₂.trans (Finset.card_le_card hXsub)
  have hproper : S ≠ Finset.univ := by
    intro hEq
    have : Sᶜ.card = 0 := by simp [hEq]
    omega
  by_contra hnot
  have hle : l ≤ 3 := by omega
  have hcases : l = 0 ∨ l = 1 ∨ l = 2 ∨ l = 3 := by omega
  rcases hcases with hzero | hone | htwo | hthree
  · rw [hzero] at hcut
    have hpos := boundaryMultiplicity_pos_of_connected
      G hconn S hSnonempty hproper
    change 0 < P.boundaryMultiplicity S at hpos
    omega
  · rw [hone] at hcut
    exact hno2 S hSnonempty hproper (by omega)
  · rw [htwo] at hcut
    have hcut4 : P.boundaryMultiplicity S = 4 := by omega
    have hScard : S.card = 1 := by
      rcases hno4 S hSnonempty hproper hcut4 with h | h
      · exact h
      · omega
    have h12eq := B.x12_card_eq_x21_of_mu_values_equal C hreg hno4 hno6 hmu
    have hUind := B.first_left_union_second_middle_isIndepSet
      C hreg hno4 hno6 hH1
    have hUcard := B.compl_first_left_union_second_middle_card
      C hreg hno4 hno6 hH1 h12eq hScard
    have hUint := B.internal_compl_first_left_union_second_middle_eq_two
      C hreg hUind hUcard
    have hlarge := hindependentComplement (B.left ∪ C.middle) hUind
    rw [hUint] at hlarge
    omega
  · rw [hthree] at hcut
    have hcut6 : P.boundaryMultiplicity S = 6 := by omega
    have huNotS : u ∉ S := fun huS ↦
      (Finset.disjoint_left.mp B.disjoint_left_right)
        B.mem_left_distinguished (mem_block.mp huS).1
    have huNotX : u ∉ block B C .R .M := fun huX ↦
      (Finset.disjoint_left.mp B.disjoint_left_right)
        B.mem_left_distinguished (mem_block.mp huX).1
    have hUXsub : block B C .R .M ∪ {u} ⊆ Sᶜ := by
      intro x hx
      simp only [Finset.mem_union, Finset.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hXsub hx
      · simp [huNotS]
    have hdis : Disjoint (block B C .R .M) {u} := by
      rw [Finset.disjoint_right]
      intro x hxu hxblock
      simp only [Finset.mem_singleton] at hxu
      subst x
      exact huNotX hxblock
    have hcompthree : 3 ≤ Sᶜ.card := by
      have hcardUnion := Finset.card_union_of_disjoint hdis
      have hle := Finset.card_le_card hUXsub
      simp only [Finset.card_singleton] at hcardUnion
      omega
    rcases hno6 S hcut6 with hStwo | hcomptwo
    · change Odd S.card at h33odd
      rcases h33odd with ⟨k, hk⟩
      change S.card = 2 at hStwo
      omega
    · omega

structure PositiveEdgeCounts {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Prop where
  cross_zero : overlayEdge B C .R .M .M .R = 0
  mu1_four : overlayEdge B C .R .M .M .L = 4
  mu2_four : overlayEdge B C .M .R .L .M = 4
  tail23_four : overlayEdge B C .R .R .M .R = 4
  tail32_four : overlayEdge B C .R .R .R .M = 4

/-- The inequalities now meet the two eight-edge ledgers sharply:
`mu=0` and `lambda=mu1=mu2=4`. -/
lemma positive_core_edge_counts
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard₃₂ : 2 ≤ (block B C .R .M).card)
    (hpos : 0 < overlayEdge B C .R .M .M .L +
      overlayEdge B C .M .R .L .M)
    (hnu1 : overlayEdge B C .R .L .M .M = 0)
    (hmu : overlayEdge B C .R .M .M .L =
      overlayEdge B C .M .R .L .M)
    (htailLower : 4 ≤ overlayEdge B C .R .R .M .R) :
    PositiveEdgeCounts B C := by
  have hfirst := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
      overlayEdge B C .R .M .M .L +
      overlayEdge B C .R .M .M .R +
      overlayEdge B C .R .R .M .M +
      overlayEdge B C .R .R .M .R = 8 at hfirst
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hoff := B.offDiagonal_eight_of_pos C hreg hconn hno2 hno4 hno6
    hcard₃₂ hpos
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> omega

/-- In the selected-middle branch, each `X23` vertex sends either zero or
two edges to `X33`.  The vanished `X23--X32` count and the forbidden
`C.left--C.right` pair remove all other possible first-right neighbours. -/
lemma singleton_x23_to_x33_zero_or_two
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (hcross : overlayEdge B C .R .M .M .R = 0)
    (x : V) (hx23 : x ∈ block B C .M .R) :
    (Pseudograph.ofSimple G).betweenMultiplicity {x}
        (block B C .R .R) = 0 ∨
      (Pseudograph.ofSimple G).betweenMultiplicity {x}
        (block B C .R .R) = 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let T₁ := block B C .R .L
  let T₂ := block B C .R .M
  let T₃ := block B C .R .R
  have hxM := (mem_block.mp hx23).1
  have hcount := selection.middle_right_count hselectionMiddle x hxM
  have hxR : x ∉ B.right := fun hx ↦
    (Finset.disjoint_left.mp B.disjoint_middle_right) hxM hx
  have hxT₁ : x ∉ T₁ := fun hx ↦ hxR (mem_block.mp hx).1
  have hxT₂ : x ∉ T₂ := fun hx ↦ hxR (mem_block.mp hx).1
  have hxT₃ : x ∉ T₃ := fun hx ↦ hxR (mem_block.mp hx).1
  have hT₁₂ : Disjoint T₁ T₂ := B.disjoint_block C (.inr (by decide))
  have hT₁₃ : Disjoint T₁ T₃ := B.disjoint_block C (.inr (by decide))
  have hT₂₃ : Disjoint T₂ T₃ := B.disjoint_block C (.inr (by decide))
  have hT₁₂_T₃ : Disjoint (T₁ ∪ T₂) T₃ :=
    Finset.disjoint_union_left.mpr ⟨hT₁₃, hT₂₃⟩
  have hxT₁₂ : Disjoint ({x} : Finset V) (T₁ ∪ T₂) := by
    simp [hxT₁, hxT₂]
  have hxAll : Disjoint ({x} : Finset V) ((T₁ ∪ T₂) ∪ T₃) := by
    simp [hxT₁, hxT₂, hxT₃]
  have hz₁ : P.betweenMultiplicity {x} T₁ = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro a ha b hb
    have haEq : a = x := by simpa using ha
    subst a
    exact fun hAdj ↦ C.not_adj_left_right hreg hno4 hno6
      (mem_block.mp hb).2 (mem_block.mp hx23).2 hAdj.symm
  have hz₂ : P.betweenMultiplicity {x} T₂ = 0 := by
    have hmono := P.betweenMultiplicity_mono_right T₂ {x}
      (block B C .M .R) (by simp [hx23])
      (B.disjoint_block C (.inl (by decide)))
    rw [show P.betweenMultiplicity T₂ (block B C .M .R) =
        overlayEdge B C .R .M .M .R by rfl,
      hcross] at hmono
    rw [P.betweenMultiplicity_comm]
    omega
  have hrow := B.block_row_union C .R
  change (T₁ ∪ T₂) ∪ T₃ = B.right at hrow
  have hsplit := P.betweenMultiplicity_union_right
    {x} (T₁ ∪ T₂) T₃ hT₁₂_T₃ hxAll
  have hsplit₁₂ := P.betweenMultiplicity_union_right
    {x} T₁ T₂ hT₁₂ hxT₁₂
  rw [hrow] at hsplit
  rw [hsplit₁₂, hz₁, hz₂] at hsplit
  simp only [Nat.zero_add] at hsplit
  change P.betweenMultiplicity {x} B.right = 0 ∨
    P.betweenMultiplicity {x} B.right = 2 at hcount
  change P.betweenMultiplicity {x} T₃ = 0 ∨
    P.betweenMultiplicity {x} T₃ = 2
  rw [hsplit] at hcount
  exact hcount

noncomputable def activeX23 {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex) : Finset V :=
  (block B C .M .R).filter fun x ↦
    (Pseudograph.ofSimple G).betweenMultiplicity {x}
      (block B C .R .R) = 2

lemma sum_if_two_eq_two_mul_filter_card
    {W : Type*} [DecidableEq W] (S : Finset W) (p : W → Prop)
    [DecidablePred p] :
    (∑ x ∈ S, if p x then 2 else 0) = 2 * (S.filter p).card := by
  induction S using Finset.induction_on with
  | empty => simp
  | @insert x S hx ih =>
      rw [Finset.sum_insert hx, Finset.filter_insert]
      by_cases hpx : p x
      · simp [hpx, ih]
        have hxfilter : x ∉ S.filter p := fun h ↦ hx (Finset.mem_filter.mp h).1
        rw [Finset.card_insert_of_notMem hxfilter]
        omega
      · simp [hx, hpx, ih]

/-- The four `X23--X33` edges are carried by exactly two vertices of
`X23`, two edges at each vertex. -/
lemma activeX23_card_eq_two
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (hcross : overlayEdge B C .R .M .M .R = 0)
    (htail : overlayEdge B C .R .R .M .R = 4) :
    (activeX23 B selection C).card = 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let X := block B C .M .R
  let R := block B C .R .R
  let A := activeX23 B selection C
  have hXR : Disjoint X R := B.disjoint_block C (.inl (by decide))
  have hsum := P.betweenMultiplicity_eq_sum_singleton_left X R hXR
  have htail' : P.betweenMultiplicity X R = 4 := by
    rw [P.betweenMultiplicity_comm]
    exact htail
  rw [htail'] at hsum
  have hsum' : ∑ x ∈ X, P.betweenMultiplicity {x} R = 2 * A.card := by
    calc
      ∑ x ∈ X, P.betweenMultiplicity {x} R =
          ∑ x ∈ X, if P.betweenMultiplicity {x} R = 2 then 2 else 0 := by
        apply Finset.sum_congr rfl
        intro x hx
        rcases B.singleton_x23_to_x33_zero_or_two selection C hreg hno4 hno6
          hselectionMiddle hcross x hx with hzero | htwo
        · change P.betweenMultiplicity {x} R = 0 at hzero
          split <;> omega
        · change P.betweenMultiplicity {x} R = 2 at htwo
          split <;> omega
      _ = 2 * A.card := by
        simpa [A, activeX23, X, R] using
          sum_if_two_eq_two_mul_filter_card X
            (fun x ↦ P.betweenMultiplicity {x} R = 2)
  change A.card = 2
  omega

lemma exists_two_activeX23_vertices
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hcard : (activeX23 B selection C).card = 2) :
    ∃ x y : V, x ≠ y ∧ activeX23 B selection C = {x, y} := by
  obtain ⟨x, y, hxy, hEq⟩ := Finset.card_eq_two.mp hcard
  exact ⟨x, y, hxy, hEq⟩

/-- A general eight-shore with odd size and at least two vertices on the
other side has two internal neighbours at each of its vertices. -/
lemma two_le_singleton_erase_of_odd_eight_shore
    {G : SimpleGraph V} (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (S : Finset V)
    (hcut : (Pseudograph.ofSimple G).boundaryMultiplicity S = 8)
    (hodd : Odd S.card) (hfive : 5 ≤ S.card) (hcomp : 2 ≤ Sᶜ.card)
    (v : V) (hv : v ∈ S) :
    2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {v} (S.erase v) := by
  classical
  let P := Pseudograph.ofSimple G
  let R := S.erase v
  let q := P.betweenMultiplicity {v} R
  have hRcard : R.card ≠ 1 := by
    have herase := Finset.card_erase_add_one hv
    change R.card + 1 = S.card at herase
    omega
  have hRnonempty : R.Nonempty := Finset.card_pos.mp (by
    have herase := Finset.card_erase_add_one hv
    change R.card + 1 = S.card at herase
    omega)
  have hsub : Sᶜ ⊆ Rᶜ := by
    intro x hx
    simp only [Finset.mem_compl] at hx ⊢
    exact fun hxR ↦ hx (Finset.mem_of_mem_erase hxR)
  have hvRcomp : v ∈ Rᶜ := by simp [R]
  have hScompDisj : Disjoint Sᶜ {v} := by
    rw [Finset.disjoint_right]
    intro x hxv hxcomp
    simp only [Finset.mem_singleton] at hxv
    subst x
    exact (Finset.mem_compl.mp hxcomp) hv
  have hUnionSub : Sᶜ ∪ {v} ⊆ Rᶜ :=
    Finset.union_subset hsub (Finset.singleton_subset_iff.mpr hvRcomp)
  have hRcompTwo : 3 ≤ Rᶜ.card := by
    have hcardUnion := Finset.card_union_of_disjoint hScompDisj
    have hle := Finset.card_le_card hUnionSub
    simp only [Finset.card_singleton] at hcardUnion
    omega
  have hRcomp : Rᶜ.card ≠ 1 := by omega
  have hproper : R ≠ Finset.univ := by
    intro hEq
    have : Rᶜ.card = 0 := by simp [hEq]
    omega
  have hdis : Disjoint R {v} := by
    rw [Finset.disjoint_left]
    intro x hx hxv
    simp only [Finset.mem_singleton] at hxv
    subst x
    simpa [R] using hx
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    hregular R {v} hdis
  have hunion : R ∪ {v} = S := by
    ext x
    by_cases hx : x = v <;> simp [R, hx, hv]
  rw [hunion, hcut, boundaryMultiplicity_singleton_of_quartic G hreg v,
    P.betweenMultiplicity_comm] at htoggle
  change 2 ≤ q
  by_contra hnot
  have hcases : q = 0 ∨ q = 1 := by omega
  rcases hcases with hzero | hone
  · have hcut4 : P.boundaryMultiplicity R = 4 := by omega
    rcases hno4 R hRnonempty hproper hcut4 with h | h
    · exact hRcard h
    · exact hRcomp h
  · change P.betweenMultiplicity {v} R = 1 at hone
    rw [hone] at htoggle
    have hcut6 : P.boundaryMultiplicity R = 6 := by omega
    have hRfour : 4 ≤ R.card := by
      have herase := Finset.card_erase_add_one hv
      change R.card + 1 = S.card at herase
      omega
    rcases hno6 R hcut6 with htwo | htwo <;> omega

/-- Constructor for the abstract barriers used by the final shore
recombination. -/
noncomputable def ofPartition
    {G : SimpleGraph V} {u : V}
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (L M R : Finset V) (hu : u ∈ L)
    (hLM : Disjoint L M) (hLR : Disjoint L R) (hMR : Disjoint M R)
    (hcover : L ∪ M ∪ R = Finset.univ)
    (hLind : G.IsIndepSet (L : Set V))
    (hMind : G.IsIndepSet (M : Set V))
    (hLRadj : ∀ {x y : V}, x ∈ L → y ∈ R → ¬ G.Adj x y)
    (hcut : (Pseudograph.ofSimple G).boundaryMultiplicity R = 8)
    (hodd : Odd R.card) (hcomp : 2 ≤ Rᶜ.card)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ) :
    TypeCBarrier G u where
  left := L
  middle := M
  right := R
  distinguished_mem_left := hu
  left_middle_disjoint := hLM
  left_right_disjoint := hLR
  middle_right_disjoint := hMR
  cover := hcover
  left_independent := hLind
  middle_independent := hMind
  left_right_nonadjacent := hLRadj
  right_boundary := hcut
  right_odd := hodd
  right_two_neighbors := fun v hv ↦ by
    let P := Pseudograph.ofSimple G
    have hlarge := hindependentComplement M hMind
    have hunion := P.internalMultiplicity_union L R hLR
    have hLint : P.internalMultiplicity L = 0 :=
      internalMultiplicity_eq_zero_of_isIndepSet G L hLind
    have hLRzero : P.betweenMultiplicity L R = 0 :=
      betweenMultiplicity_eq_zero_of_no_adj G L R
        (fun _ hx _ hy ↦ hLRadj hx hy)
    have hMcomp : Mᶜ = L ∪ R := by
      ext x
      have hc := Finset.ext_iff.mp hcover x
      have hLM' := Finset.disjoint_left.mp hLM
      have hMR' := Finset.disjoint_left.mp hMR
      simp only [Finset.mem_compl, Finset.mem_union, Finset.mem_univ,
        iff_true] at hc ⊢
      tauto
    rw [hMcomp, hunion, hLint, hLRzero, Nat.zero_add, Nat.add_zero] at hlarge
    have hdegree := P.regular_card_eq_two_internal_add_boundary
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) R
    rw [hcut] at hdegree
    obtain ⟨k, hk⟩ := hodd
    have hfive : 5 ≤ R.card := by omega
    exact two_le_singleton_erase_of_odd_eight_shore hreg hno4 hno6
      R hcut ⟨k, hk⟩ hfive hcomp v hv

/-- The left shore in Tashkinov's recombined barrier.  The inactive
vertices of `X23` move to the second left shore. -/
noncomputable def recombinedSecondLeft
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex) : Finset V :=
  C.left ∪ (block B C .M .R \ activeX23 B selection C)

/-- The right shore in Tashkinov's recombined barrier: `X33` together
with the two active vertices of `X23`. -/
noncomputable def recombinedSecondRight
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex) : Finset V :=
  block B C .R .R ∪ activeX23 B selection C

/-- The remaining vertices form the middle shore of the recombined
barrier. -/
noncomputable def recombinedSecondMiddle
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex) : Finset V :=
  (recombinedSecondLeft B selection C ∪
    recombinedSecondRight B selection C)ᶜ

lemma activeX23_subset
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex) :
    activeX23 B selection C ⊆ block B C .M .R := by
  intro x hx
  exact (Finset.mem_filter.mp hx).1

lemma inactiveX23_not_adj_x33
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (hcross : overlayEdge B C .R .M .M .R = 0)
    {x y : V}
    (hx : x ∈ block B C .M .R \ activeX23 B selection C)
    (hy : y ∈ block B C .R .R) : ¬ G.Adj x y := by
  classical
  have hx23 := (Finset.mem_sdiff.mp hx).1
  have hxnot := (Finset.mem_sdiff.mp hx).2
  have hzero : (Pseudograph.ofSimple G).betweenMultiplicity {x}
      (block B C .R .R) = 0 := by
    rcases B.singleton_x23_to_x33_zero_or_two selection C hreg hno4 hno6
      hselectionMiddle hcross x hx23 with hzero | htwo
    · exact hzero
    · exfalso
      exact hxnot (Finset.mem_filter.mpr ⟨hx23, htwo⟩)
  intro hxy
  have hdis : Disjoint ({x} : Finset V) (block B C .R .R) := by
    rw [Finset.disjoint_left]
    intro z hz hz33
    have hzx : z = x := by simpa using hz
    subst z
    exact (Finset.disjoint_left.mp
      (B.disjoint_block C (s := .M) (t := .R) (s' := .R) (t' := .R)
        (.inl (by decide)))) hx23 hz33
  have hpos := betweenMultiplicity_pos_of_adj_mem G {x}
    (block B C .R .R) hdis hxy (by simp) hy
  rw [hzero] at hpos
  omega

lemma mem_recombinedSecondMiddle_cases
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hH1 : overlayH1 B C = ∅) {x : V}
    (hx : x ∈ recombinedSecondMiddle B selection C) :
    x ∈ block B C .L .M ∨ x ∈ block B C .L .R ∨
      x ∈ block B C .R .M := by
  classical
  have hxnot : x ∉ recombinedSecondLeft B selection C ∪
      recombinedSecondRight B selection C := by
    simpa [recombinedSecondMiddle] using hx
  obtain ⟨s, hxs, _⟩ := B.existsUnique_mem_side x
  obtain ⟨t, hxt, _⟩ := C.existsUnique_mem_side x
  cases s with
  | L =>
      cases t with
      | L =>
          exact False.elim (hxnot (Finset.mem_union_left _
            (Finset.mem_union_left _ hxt)))
      | M => exact Or.inl (mem_block.mpr ⟨hxs, hxt⟩)
      | R => exact Or.inr (Or.inl (mem_block.mpr ⟨hxs, hxt⟩))
  | M =>
      cases t with
      | L =>
          exact False.elim (hxnot (Finset.mem_union_left _
            (Finset.mem_union_left _ hxt)))
      | M =>
          have hx22 : x ∈ block B C .M .M := mem_block.mpr ⟨hxs, hxt⟩
          have hxH1 : x ∈ overlayH1 B C := Finset.mem_union_right _ hx22
          rw [hH1] at hxH1
          simp at hxH1
      | R =>
          have hx23 : x ∈ block B C .M .R := mem_block.mpr ⟨hxs, hxt⟩
          by_cases hxA : x ∈ activeX23 B selection C
          · exact False.elim (hxnot (Finset.mem_union_right _
              (Finset.mem_union_right _ hxA)))
          · have hxI : x ∈ block B C .M .R \ activeX23 B selection C :=
              Finset.mem_sdiff.mpr ⟨hx23, hxA⟩
            exact False.elim (hxnot (Finset.mem_union_left _
              (Finset.mem_union_right _ hxI)))
  | R =>
      cases t with
      | L =>
          exact False.elim (hxnot (Finset.mem_union_left _
            (Finset.mem_union_left _ hxt)))
      | M => exact Or.inr (Or.inr (mem_block.mpr ⟨hxs, hxt⟩))
      | R =>
          have hx33 : x ∈ block B C .R .R := mem_block.mpr ⟨hxs, hxt⟩
          exact False.elim (hxnot (Finset.mem_union_right _
            (Finset.mem_union_left _ hx33)))

lemma recombinedSecondMiddle_isIndepSet
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hH1 : overlayH1 B C = ∅) :
    G.IsIndepSet
      ((recombinedSecondMiddle B selection C : Finset V) : Set V) := by
  intro x hx y hy hxy hAdj
  have hx' := B.mem_recombinedSecondMiddle_cases selection C hH1 hx
  have hy' := B.mem_recombinedSecondMiddle_cases selection C hH1 hy
  rcases hx' with hx12 | hx13 | hx32 <;>
    rcases hy' with hy12 | hy13 | hy32
  · exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx12).1 (mem_block.mp hy12).1 hxy hAdj
  · exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx12).1 (mem_block.mp hy13).1 hxy hAdj
  · exact C.middle_isIndepSet (mem_block.mp hx12).2
      (mem_block.mp hy32).2 hxy hAdj
  · exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx13).1 (mem_block.mp hy12).1 hxy hAdj
  · exact B.left_isIndepSet hreg hno4 hno6
      (mem_block.mp hx13).1 (mem_block.mp hy13).1 hxy hAdj
  · exact B.not_adj_left_right hreg hno4 hno6
      (mem_block.mp hx13).1 (mem_block.mp hy32).1 hAdj
  · exact C.middle_isIndepSet (mem_block.mp hx32).2
      (mem_block.mp hy12).2 hxy hAdj
  · exact B.not_adj_left_right hreg hno4 hno6
      (mem_block.mp hy13).1 (mem_block.mp hx32).1 hAdj.symm
  · exact C.middle_isIndepSet (mem_block.mp hx32).2
      (mem_block.mp hy32).2 hxy hAdj

lemma recombinedSecondLeft_isIndepSet
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G) :
    G.IsIndepSet
      ((recombinedSecondLeft B selection C : Finset V) : Set V) := by
  intro x hx y hy hxy hAdj
  change x ∈ recombinedSecondLeft B selection C at hx
  change y ∈ recombinedSecondLeft B selection C at hy
  simp only [recombinedSecondLeft, Finset.mem_union] at hx hy
  rcases hx with hxL | hxI <;> rcases hy with hyL | hyI
  · exact C.left_isIndepSet hreg hno4 hno6 hxL hyL hxy hAdj
  · exact C.not_adj_left_right hreg hno4 hno6 hxL
      (mem_block.mp (Finset.mem_sdiff.mp hyI).1).2 hAdj
  · exact C.not_adj_left_right hreg hno4 hno6 hyL
      (mem_block.mp (Finset.mem_sdiff.mp hxI).1).2 hAdj.symm
  · exact B.middle_isIndepSet
      (mem_block.mp (Finset.mem_sdiff.mp hxI).1).1
      (mem_block.mp (Finset.mem_sdiff.mp hyI).1).1 hxy hAdj

lemma recombinedSecond_no_left_right_adj
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (hcross : overlayEdge B C .R .M .M .R = 0)
    {x y : V} (hx : x ∈ recombinedSecondLeft B selection C)
    (hy : y ∈ recombinedSecondRight B selection C) : ¬ G.Adj x y := by
  classical
  simp only [recombinedSecondLeft, Finset.mem_union] at hx
  simp only [recombinedSecondRight, Finset.mem_union] at hy
  rcases hx with hxL | hxI <;> rcases hy with hy33 | hyA
  · exact C.not_adj_left_right hreg hno4 hno6 hxL (mem_block.mp hy33).2
  · exact C.not_adj_left_right hreg hno4 hno6 hxL
      (mem_block.mp (B.activeX23_subset selection C hyA)).2
  · exact B.inactiveX23_not_adj_x33 selection C hreg hno4 hno6
      hselectionMiddle hcross hxI hy33
  · intro hAdj
    have hx23 := (Finset.mem_sdiff.mp hxI).1
    have hy23 := B.activeX23_subset selection C hyA
    have hxy : x ≠ y := by
      intro hEq
      subst y
      exact (Finset.mem_sdiff.mp hxI).2 hyA
    exact B.middle_isIndepSet (mem_block.mp hx23).1
      (mem_block.mp hy23).1 hxy hAdj

lemma activeX23_to_x33_eq_four
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hcard : (activeX23 B selection C).card = 2) :
    (Pseudograph.ofSimple G).betweenMultiplicity
      (activeX23 B selection C) (block B C .R .R) = 4 := by
  classical
  let P := Pseudograph.ofSimple G
  let A := activeX23 B selection C
  let X := block B C .R .R
  have hdis : Disjoint A X := by
    rw [Finset.disjoint_left]
    intro x hxA hxX
    have hx23 := B.activeX23_subset selection C hxA
    exact (Finset.disjoint_left.mp
      (B.disjoint_block C (s := .M) (t := .R) (s' := .R) (t' := .R)
        (.inl (by decide)))) hx23 hxX
  have hsum := P.betweenMultiplicity_eq_sum_singleton_left A X hdis
  have heach : ∑ x ∈ A, P.betweenMultiplicity {x} X = 2 * A.card := by
    calc
      ∑ x ∈ A, P.betweenMultiplicity {x} X = ∑ x ∈ A, 2 := by
        apply Finset.sum_congr rfl
        intro x hxA
        exact (Finset.mem_filter.mp hxA).2
      _ = 2 * A.card := by simp [Nat.mul_comm]
  change P.betweenMultiplicity A X = 4
  change A.card = 2 at hcard
  omega

lemma activeX23_boundary_eq_eight
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hcard : (activeX23 B selection C).card = 2) :
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (activeX23 B selection C) = 8 := by
  let P := Pseudograph.ofSimple G
  let A := activeX23 B selection C
  have hAind : G.IsIndepSet (A : Set V) := by
    intro x hx y hy hxy hAdj
    exact B.middle_isIndepSet
      (mem_block.mp (B.activeX23_subset selection C hx)).1
      (mem_block.mp (B.activeX23_subset selection C hy)).1 hxy hAdj
  have hint : P.internalMultiplicity A = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G A hAind
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hdegree := P.regular_card_eq_two_internal_add_boundary hregular A
  change A.card = 2 at hcard
  change P.boundaryMultiplicity A = 8
  rw [hint] at hdegree
  omega

lemma recombinedSecondRight_boundary_eq_eight
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard : (activeX23 B selection C).card = 2)
    (htail : overlayEdge B C .R .R .M .R = 4) :
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (recombinedSecondRight B selection C) = 8 := by
  classical
  let P := Pseudograph.ofSimple G
  let X := block B C .R .R
  let A := activeX23 B selection C
  have hdis : Disjoint X A := by
    rw [Finset.disjoint_left]
    intro x hxX hxA
    have hx23 := B.activeX23_subset selection C hxA
    exact (Finset.disjoint_left.mp
      (B.disjoint_block C (s := .R) (t := .R) (s' := .M) (t' := .R)
        (.inl (by decide)))) hxX hx23
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    hregular X A hdis
  have hXcut := B.right_right_boundary_eq_twice_tail C hreg hno4 hno6 hlower
  rw [htail] at hXcut
  change P.boundaryMultiplicity X = 8 at hXcut
  have hAcut := B.activeX23_boundary_eq_eight selection C hreg hcard
  change P.boundaryMultiplicity A = 8 at hAcut
  have hbetween := B.activeX23_to_x33_eq_four selection C hcard
  rw [P.betweenMultiplicity_comm] at hbetween
  change P.betweenMultiplicity X A = 4 at hbetween
  change P.boundaryMultiplicity (X ∪ A) = 8
  omega

lemma recombinedSecondRight_odd
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (h33odd : Odd (block B C .R .R).card)
    (hcard : (activeX23 B selection C).card = 2) :
    Odd (recombinedSecondRight B selection C).card := by
  classical
  have hdis : Disjoint (block B C .R .R) (activeX23 B selection C) := by
    rw [Finset.disjoint_left]
    intro x hx33 hxA
    have hx23 := B.activeX23_subset selection C hxA
    exact (Finset.disjoint_left.mp
      (B.disjoint_block C (s := .R) (t := .R) (s' := .M) (t' := .R)
        (.inl (by decide)))) hx33 hx23
  have hcardUnion := Finset.card_union_of_disjoint hdis
  change (block B C .R .R ∪ activeX23 B selection C).card = _ at hcardUnion
  obtain ⟨k, hk⟩ := h33odd
  refine ⟨k + 1, ?_⟩
  change (recombinedSecondRight B selection C).card = 2 * (k + 1) + 1
  rw [recombinedSecondRight, hcardUnion, hcard]
  omega

lemma two_le_recombinedSecondRight_compl
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hcard32 : 2 ≤ (block B C .R .M).card) :
    2 ≤ (recombinedSecondRight B selection C)ᶜ.card := by
  classical
  have hsub : block B C .R .M ⊆
      (recombinedSecondRight B selection C)ᶜ := by
    intro x hx32
    simp only [Finset.mem_compl, recombinedSecondRight, Finset.mem_union]
    intro hx
    rcases hx with hx33 | hxA
    · exact (Finset.disjoint_left.mp
        (B.disjoint_block C (s := .R) (t := .M) (s' := .R) (t' := .R)
          (.inr (by decide)))) hx32 hx33
    · have hx23 := B.activeX23_subset selection C hxA
      exact (Finset.disjoint_left.mp
        (B.disjoint_block C (s := .R) (t := .M) (s' := .M) (t' := .R)
          (.inl (by decide)))) hx32 hx23
  exact hcard32.trans (Finset.card_le_card hsub)

lemma disjoint_recombinedSecondLeft_right
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex) :
    Disjoint (recombinedSecondLeft B selection C)
      (recombinedSecondRight B selection C) := by
  classical
  rw [Finset.disjoint_left]
  intro x hx hy
  simp only [recombinedSecondLeft, Finset.mem_union] at hx
  simp only [recombinedSecondRight, Finset.mem_union] at hy
  rcases hx with hxL | hxI <;> rcases hy with hy33 | hyA
  · exact (Finset.disjoint_left.mp C.disjoint_left_right) hxL
      (mem_block.mp hy33).2
  · exact (Finset.disjoint_left.mp C.disjoint_left_right) hxL
      (mem_block.mp (B.activeX23_subset selection C hyA)).2
  · exact (Finset.disjoint_left.mp B.disjoint_middle_right)
      (mem_block.mp (Finset.mem_sdiff.mp hxI).1).1 (mem_block.mp hy33).1
  · exact (Finset.mem_sdiff.mp hxI).2 hyA

/-- The recombination at the two active `X23` vertices is again a
type-C barrier with the same distinguished vertex as the second one. -/
noncomputable def recombinedSecondBarrier
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (hcross : overlayEdge B C .R .M .M .R = 0)
    (hH1 : overlayH1 B C = ∅)
    (h33odd : Odd (block B C .R .R).card)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hactive : (activeX23 B selection C).card = 2)
    (htail : overlayEdge B C .R .R .M .R = 4) :
    TypeCBarrier G selection.vertex := by
  classical
  let L := recombinedSecondLeft B selection C
  let M := recombinedSecondMiddle B selection C
  let R := recombinedSecondRight B selection C
  have hLR : Disjoint L R := B.disjoint_recombinedSecondLeft_right selection C
  have hLM : Disjoint L M := by
    rw [Finset.disjoint_left]
    intro x hxL hxM
    have hxnot : x ∉ L ∪ R := by
      simpa [M, recombinedSecondMiddle, L, R] using hxM
    exact hxnot (Finset.mem_union_left _ hxL)
  have hMR : Disjoint M R := by
    rw [Finset.disjoint_left]
    intro x hxM hxR
    have hxnot : x ∉ L ∪ R := by
      simpa [M, recombinedSecondMiddle, L, R] using hxM
    exact hxnot (Finset.mem_union_right _ hxR)
  have hcover : L ∪ M ∪ R = Finset.univ := by
    ext x
    simp only [Finset.mem_union, Finset.mem_univ, iff_true]
    by_cases hxL : x ∈ L
    · exact Or.inl (Or.inl hxL)
    by_cases hxR : x ∈ R
    · exact Or.inr hxR
    · exact Or.inl (Or.inr (by
        simp [M, recombinedSecondMiddle, L, R, hxL, hxR]))
  apply ofPartition hreg hno4 hno6 L M R
  · exact Finset.mem_union_left _ C.mem_left_distinguished
  · exact hLM
  · exact hLR
  · exact hMR
  · exact hcover
  · exact B.recombinedSecondLeft_isIndepSet selection C hreg hno4 hno6
  · exact B.recombinedSecondMiddle_isIndepSet selection C
      hreg hno4 hno6 hH1
  · intro x y hx hy
    exact B.recombinedSecond_no_left_right_adj selection C hreg hno4 hno6
      hselectionMiddle hcross hx hy
  · exact B.recombinedSecondRight_boundary_eq_eight selection C
      hreg hno4 hno6 hlower hactive htail
  · exact B.recombinedSecondRight_odd selection C h33odd hactive
  · exact B.two_le_recombinedSecondRight_compl selection C hcard32
  · exact hindependentComplement

lemma second_minimal_forces_x13_x23
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hCminimal : ∀ D : TypeCBarrier G selection.vertex,
      C.right.card ≤ D.right.card)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (hcross : overlayEdge B C .R .M .M .R = 0)
    (hH1 : overlayH1 B C = ∅)
    (h33odd : Odd (block B C .R .R).card)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hactive : (activeX23 B selection C).card = 2)
    (htail : overlayEdge B C .R .R .M .R = 4) :
    (block B C .L .R).card = 0 ∧ (block B C .M .R).card = 2 := by
  classical
  let D := B.recombinedSecondBarrier selection C hreg hno4 hno6
    hindependentComplement hlower
    hselectionMiddle hcross hH1 h33odd hcard32 hactive htail
  have hminimal := hCminimal D
  have hCcard := C.block_row_card B .R
  simp only [side_R, block_swap] at hCcard
  have hdis : Disjoint (block B C .R .R) (activeX23 B selection C) := by
    rw [Finset.disjoint_left]
    intro x hx33 hxA
    have hx23 := B.activeX23_subset selection C hxA
    exact (Finset.disjoint_left.mp
      (B.disjoint_block C (s := .R) (t := .R) (s' := .M) (t' := .R)
        (.inl (by decide)))) hx33 hx23
  have hDcard := Finset.card_union_of_disjoint hdis
  change D.right.card = (block B C .R .R).card +
    (activeX23 B selection C).card at hDcard
  have hactiveSub := Finset.card_le_card (B.activeX23_subset selection C)
  constructor <;> omega

lemma first_minimal_forces_x31_x32
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hBminimal : ∀ (v : V) (D : TypeCBarrier G v),
      B.right.card ≤ D.right.card)
    (h13 : (block B C .L .R).card = 0)
    (h23 : (block B C .M .R).card = 2)
    (hcard32 : 2 ≤ (block B C .R .M).card) :
    (block B C .R .L).card = 0 ∧ (block B C .R .M).card = 2 := by
  have hminimal := hBminimal selection.vertex C
  have hBcard := B.block_row_card C .R
  have hCcard := C.block_row_card B .R
  simp only [side_R, block_swap] at hBcard hCcard
  constructor <;> omega

lemma selected_middle_contradiction_of_x32_two_mu1_four
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hselectionMiddle : selection.vertex ∈ B.middle)
    (h32 : (block B C .R .M).card = 2)
    (hmu1 : overlayEdge B C .R .M .M .L = 4) : False := by
  classical
  let P := Pseudograph.ofSimple G
  let X := block B C .R .M
  let Y := block B C .M .L
  have hdis : Disjoint X Y := B.disjoint_block C (.inl (by decide))
  have hsum := P.betweenMultiplicity_eq_sum_singleton_left X Y hdis
  have hsumLe : ∑ x ∈ X, P.betweenMultiplicity {x} Y ≤ X.card := by
    calc
      ∑ x ∈ X, P.betweenMultiplicity {x} Y ≤ ∑ x ∈ X, 1 := by
        apply Finset.sum_le_sum
        intro x hx
        have hxR : x ∈ B.right := (mem_block.mp hx).1
        have hYsub : Y ⊆ B.middle := fun _ hy ↦ (mem_block.mp hy).1
        have hsingleDis : Disjoint ({x} : Finset V) B.middle := by
          rw [Finset.disjoint_left]
          intro z hz hzM
          have hzx : z = x := by simpa using hz
          subst z
          exact (Finset.disjoint_left.mp B.disjoint_middle_right) hzM hxR
        have hmono := P.betweenMultiplicity_mono_right {x} Y B.middle
          hYsub hsingleDis
        exact hmono.trans (selection.right_middle_count_le_one
          hselectionMiddle x hxR)
      _ = X.card := by simp
  change P.betweenMultiplicity X Y = 4 at hmu1
  rw [hmu1] at hsum
  change X.card = 2 at h32
  omega

lemma selection_vertex_mem_right_of_mu1_zero
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hmu1 : overlayEdge B C .R .M .M .L = 0) :
    selection.vertex ∈ B.right := by
  rcases selection.mem_right_or_middle with hwR | hwM
  · exact hwR
  · obtain ⟨x, hxR, hwx⟩ := selection.middle_has_right_neighbor hwM
    have hwCL : selection.vertex ∈ C.left := C.mem_left_distinguished
    have hxCM := C.mem_middle_of_adj_left hreg hno4 hno6 hwCL hwx
    have hw21 : selection.vertex ∈ block B C .M .L :=
      mem_block.mpr ⟨hwM, hwCL⟩
    have hx32 : x ∈ block B C .R .M := mem_block.mpr ⟨hxR, hxCM⟩
    have hdis : Disjoint (block B C .R .M) (block B C .M .L) :=
      B.disjoint_block C (.inl (by decide))
    have hpos := betweenMultiplicity_pos_of_adj_mem G
      (block B C .R .M) (block B C .M .L) hdis hwx.symm hx32 hw21
    change 0 < overlayEdge B C .R .M .M .L at hpos
    omega

lemma nu1_pos_of_selection_mem_right
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hwR : selection.vertex ∈ B.right) :
    0 < overlayEdge B C .R .L .M .M := by
  obtain ⟨x, hxM, hwx⟩ := selection.right_has_middle_neighbor hwR
  have hwCL : selection.vertex ∈ C.left := C.mem_left_distinguished
  have hxCM := C.mem_middle_of_adj_left hreg hno4 hno6 hwCL hwx
  have hw31 : selection.vertex ∈ block B C .R .L :=
    mem_block.mpr ⟨hwR, hwCL⟩
  have hx22 : x ∈ block B C .M .M := mem_block.mpr ⟨hxM, hxCM⟩
  exact betweenMultiplicity_pos_of_adj_mem G
    (block B C .R .L) (block B C .M .M)
    (B.disjoint_block C (.inl (by decide))) hwx hw31 hx22

lemma nu_values_equal_of_mu_values_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hmu1 : overlayEdge B C .R .M .M .L = 0)
    (hmu2 : overlayEdge B C .M .R .L .M = 0) :
    overlayEdge B C .R .L .M .M =
      overlayEdge B C .L .R .M .M := by
  have hheads := B.overlay_heads_eq C hreg hno4 hno6 hlower
  omega

lemma nu1_ne_two_of_selected_right
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hwR : selection.vertex ∈ B.right)
    (hmu1 : overlayEdge B C .R .M .M .L = 0)
    (hmu2 : overlayEdge B C .M .R .L .M = 0) :
    overlayEdge B C .R .L .M .M ≠ 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let H := overlayH1 B C
  let X22 := block B C .M .M
  intro hnu1
  have hnu2 := B.nu_values_equal_of_mu_values_zero C hreg hno4 hno6
    hlower hmu1 hmu2
  have hdiagZero := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have hcut := B.diagonal_boundary_ledger C hreg hno4 hno6
  have hcut4 : P.boundaryMultiplicity H = 4 := by
    change P.boundaryMultiplicity H = _ at hcut
    omega
  have hdiagDegree := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
  have hHcard := B.overlayH1_card C
  have hHnonempty : H.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hEmpty
    rw [hEmpty, P.boundaryMultiplicity_empty] at hcut4
    omega
  have hHX : Disjoint H (block B C .R .M) := B.disjoint_H1_H4 C |>.mono_right
    (fun _ hx ↦ Finset.mem_union_right _ hx)
  have hXsub : block B C .R .M ⊆ Hᶜ := by
    intro x hx
    simp only [Finset.mem_compl]
    exact fun hH ↦ (Finset.disjoint_left.mp hHX) hH hx
  have hcompTwo : 2 ≤ Hᶜ.card :=
    hcard32.trans (Finset.card_le_card hXsub)
  have hproper : H ≠ Finset.univ := by
    intro hEq
    have : Hᶜ.card = 0 := by simp [hEq]
    omega
  have hHone : H.card = 1 := by
    rcases hno4 H hHnonempty hproper hcut4 with h | h
    · exact h
    · omega
  have h11zero : (block B C .L .L).card = 0 := by
    change H.card = _ at hHcard
    omega
  have h22one : X22.card = 1 := by
    change H.card = _ at hHcard
    rw [← hnu2, hnu1] at hdiagDegree
    change (block B C .M .M).card = 1
    omega
  obtain ⟨x, hx22eq⟩ := Finset.card_eq_one.mp h22one
  have hwCL : selection.vertex ∈ C.left := C.mem_left_distinguished
  rcases selection.right_choice_certificate hwR with hlarge | hsingle
  · have hwNotM : selection.vertex ∉ B.middle := fun hwM ↦
      (Finset.disjoint_left.mp B.disjoint_middle_right) hwM hwR
    have hfilter := Pseudograph.betweenMultiplicity_singleton_ofSimple
      G selection.vertex B.middle hwNotM
    have hsub : B.middle.filter (G.Adj selection.vertex) ⊆ X22 := by
      intro y hy
      have hy' := Finset.mem_filter.mp hy
      exact mem_block.mpr ⟨hy'.1,
        C.mem_middle_of_adj_left hreg hno4 hno6 hwCL hy'.2⟩
    have hle := Finset.card_le_card hsub
    change P.betweenMultiplicity {selection.vertex} B.middle = _ at hfilter
    change 2 ≤ P.betweenMultiplicity {selection.vertex} B.middle at hlarge
    omega
  · obtain ⟨y, hyM, hycount, hwy⟩ := hsingle
    have hyCM := C.mem_middle_of_adj_left hreg hno4 hno6 hwCL hwy
    have hy22 : y ∈ X22 := mem_block.mpr ⟨hyM, hyCM⟩
    have hX22eq : X22 = {y} := by
      rw [hx22eq] at hy22
      have hyx : y = x := by simpa using hy22
      subst y
      exact hx22eq
    have hyNot31 : y ∉ block B C .R .L := fun hy31 ↦
      (Finset.disjoint_left.mp (B.disjoint_block C
        (s := .M) (t := .M) (s' := .R) (t' := .L) (.inl (by decide))))
        (mem_block.mpr ⟨hyM, hyCM⟩) hy31
    have hfilter31 := Pseudograph.betweenMultiplicity_singleton_ofSimple
      G y (block B C .R .L) hyNot31
    have hnuFilter : ((block B C .R .L).filter (G.Adj y)).card = 2 := by
      change P.betweenMultiplicity {y} (block B C .R .L) = _ at hfilter31
      rw [← hfilter31, ← P.betweenMultiplicity_comm, ← hX22eq]
      exact hnu1
    have hsub : (block B C .R .L).filter (G.Adj y) ⊆
        B.right.filter (G.Adj y) := by
      intro z hz
      have hz' := Finset.mem_filter.mp hz
      exact Finset.mem_filter.mpr ⟨(mem_block.mp hz'.1).1, hz'.2⟩
    have hle := Finset.card_le_card hsub
    have hyNotR : y ∉ B.right := fun hyR ↦
      (Finset.disjoint_left.mp B.disjoint_middle_right) hyM hyR
    have hfilterR := Pseudograph.betweenMultiplicity_singleton_ofSimple
      G y B.right hyNotR
    change P.betweenMultiplicity {y} B.right = _ at hfilterR
    rw [hycount] at hfilterR
    omega

lemma offDiagonal_empty_of_mu_values_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hmu1 : overlayEdge B C .R .M .M .L = 0)
    (hmu2 : overlayEdge B C .M .R .L .M = 0) :
    overlayH2 B C = ∅ := by
  let P := Pseudograph.ofSimple G
  let H := overlayH2 B C
  have hledger := B.offDiagonal_boundary_ledger C hreg hno4 hno6
  have hzero : P.boundaryMultiplicity H = 0 := by
    change P.boundaryMultiplicity H = _ at hledger
    omega
  have hdis : Disjoint H (block B C .R .M) := by
    exact Finset.disjoint_union_left.mpr
      ⟨B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
  have hproper : H ≠ Finset.univ := by
    obtain ⟨x, hx⟩ := Finset.card_pos.mp (by omega :
      0 < (block B C .R .M).card)
    intro hEq
    have hxH : x ∈ H := by rw [hEq]; simp
    exact (Finset.disjoint_left.mp hdis) hxH hx
  exact eq_empty_of_boundaryMultiplicity_eq_zero_of_connected
    G hconn H hproper hzero

/-- In Case 1, the independent set used with Proposition 4.1 is the
union of both left shores and the (at most singleton) common right block. -/
noncomputable def zeroCaseIndependentSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  (B.left ∪ C.left) ∪ block B C .R .R

lemma zeroCaseIndependentSet_isIndepSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hH2 : overlayH2 B C = ∅)
    (h33card : (block B C .R .R).card ≤ 1) :
    G.IsIndepSet ((zeroCaseIndependentSet B C : Finset V) : Set V) := by
  intro x hx y hy hxy hAdj
  change x ∈ zeroCaseIndependentSet B C at hx
  change y ∈ zeroCaseIndependentSet B C at hy
  simp only [zeroCaseIndependentSet, Finset.mem_union] at hx hy
  rcases hx with (hxBL | hxCL) | hx33 <;>
    rcases hy with (hyBL | hyCL) | hy33
  · exact B.left_isIndepSet hreg hno4 hno6 hxBL hyBL hxy hAdj
  · have hxCM := C.mem_middle_of_adj_left hreg hno4 hno6 hyCL hAdj.symm
    have hyBM := B.mem_middle_of_adj_left hreg hno4 hno6 hxBL hAdj
    have hx12 : x ∈ block B C .L .M := mem_block.mpr ⟨hxBL, hxCM⟩
    have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_left _ hx12
    rw [hH2] at hxH2
    simp at hxH2
  · exact B.not_adj_left_right hreg hno4 hno6 hxBL
      (mem_block.mp hy33).1 hAdj
  · have hxBM := B.mem_middle_of_adj_left hreg hno4 hno6 hyBL hAdj.symm
    have hyCM := C.mem_middle_of_adj_left hreg hno4 hno6 hxCL hAdj
    have hx21 : x ∈ block B C .M .L := mem_block.mpr ⟨hxBM, hxCL⟩
    have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_right _ hx21
    rw [hH2] at hxH2
    simp at hxH2
  · exact C.left_isIndepSet hreg hno4 hno6 hxCL hyCL hxy hAdj
  · exact C.not_adj_left_right hreg hno4 hno6 hxCL
      (mem_block.mp hy33).2 hAdj
  · exact B.not_adj_left_right hreg hno4 hno6 hyBL
      (mem_block.mp hx33).1 hAdj.symm
  · exact C.not_adj_left_right hreg hno4 hno6 hyCL
      (mem_block.mp hx33).2 hAdj.symm
  · exact hxy ((Finset.card_le_one.mp h33card) x hx33 y hy33)

lemma compl_zeroCaseIndependentSet_eq
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (zeroCaseIndependentSet B C)ᶜ =
      (block B C .M .M ∪ block B C .M .R) ∪ block B C .R .M := by
  classical
  ext x
  constructor
  · intro hx
    simp only [Finset.mem_compl, zeroCaseIndependentSet,
      Finset.mem_union] at hx
    obtain ⟨s, hxs, _⟩ := B.existsUnique_mem_side x
    obtain ⟨t, hxt, _⟩ := C.existsUnique_mem_side x
    cases s with
    | L => exact False.elim (hx (Or.inl (Or.inl hxs)))
    | M =>
        cases t with
        | L => exact False.elim (hx (Or.inl (Or.inr hxt)))
        | M =>
            exact Finset.mem_union_left _
              (Finset.mem_union_left _ (mem_block.mpr ⟨hxs, hxt⟩))
        | R =>
            exact Finset.mem_union_left _
              (Finset.mem_union_right _ (mem_block.mpr ⟨hxs, hxt⟩))
    | R =>
        cases t with
        | L => exact False.elim (hx (Or.inl (Or.inr hxt)))
        | M => exact Finset.mem_union_right _ (mem_block.mpr ⟨hxs, hxt⟩)
        | R => exact False.elim (hx (Or.inr (mem_block.mpr ⟨hxs, hxt⟩)))
  · intro hx
    simp only [Finset.mem_union] at hx
    simp only [Finset.mem_compl, zeroCaseIndependentSet, Finset.mem_union]
    intro hU
    rcases hx with (hx22 | hx23) | hx32 <;>
      rcases hU with (hBL | hCL) | h33
    · exact (Finset.disjoint_left.mp B.disjoint_left_middle) hBL
        (mem_block.mp hx22).1
    · exact (Finset.disjoint_left.mp C.disjoint_left_middle) hCL
        (mem_block.mp hx22).2
    · exact (Finset.disjoint_left.mp (B.disjoint_block C
        (s := .M) (t := .M) (s' := .R) (t' := .R) (.inl (by decide))))
        hx22 h33
    · exact (Finset.disjoint_left.mp B.disjoint_left_middle) hBL
        (mem_block.mp hx23).1
    · exact (Finset.disjoint_left.mp C.disjoint_left_right) hCL
        (mem_block.mp hx23).2
    · exact (Finset.disjoint_left.mp (B.disjoint_block C
        (s := .M) (t := .R) (s' := .R) (t' := .R) (.inl (by decide))))
        hx23 h33
    · exact (Finset.disjoint_left.mp B.disjoint_left_right) hBL
        (mem_block.mp hx32).1
    · exact (Finset.disjoint_left.mp C.disjoint_left_middle) hCL
        (mem_block.mp hx32).2
    · exact (Finset.disjoint_left.mp (B.disjoint_block C
        (s := .R) (t := .M) (s' := .R) (t' := .R) (.inr (by decide))))
        hx32 h33

lemma internal_compl_zeroCaseIndependentSet_eq_cross
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    (Pseudograph.ofSimple G).internalMultiplicity
      (zeroCaseIndependentSet B C)ᶜ =
        overlayEdge B C .R .M .M .R := by
  classical
  let P := Pseudograph.ofSimple G
  let A := block B C .M .M ∪ block B C .M .R
  let D := block B C .R .M
  have hAind : G.IsIndepSet (A : Set V) := by
    intro x hx y hy hxy hAdj
    simp only [A, Finset.coe_union, Set.mem_union] at hx hy
    exact B.middle_isIndepSet
      (hx.elim (fun h ↦ (mem_block.mp h).1) (fun h ↦ (mem_block.mp h).1))
      (hy.elim (fun h ↦ (mem_block.mp h).1) (fun h ↦ (mem_block.mp h).1))
      hxy hAdj
  have hDind : G.IsIndepSet (D : Set V) := by
    intro x hx y hy hxy hAdj
    exact C.middle_isIndepSet (mem_block.mp hx).2 (mem_block.mp hy).2 hxy hAdj
  have hAint : P.internalMultiplicity A = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G A hAind
  have hDint : P.internalMultiplicity D = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G D hDind
  have hAD : Disjoint A D := Finset.disjoint_union_left.mpr
    ⟨B.disjoint_block C (.inl (by decide)),
      B.disjoint_block C (.inl (by decide))⟩
  have h22Dzero : P.betweenMultiplicity (block B C .M .M) D = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy
    exact C.middle_isIndepSet (mem_block.mp hx).2 (mem_block.mp hy).2
      (fun hEq ↦ by subst y; exact (Finset.disjoint_left.mp
        (B.disjoint_block C (.inl (by decide)))) hx hy)
  have hsplit := P.betweenMultiplicity_union_left
    (block B C .M .M) (block B C .M .R) D
    (B.disjoint_block C (.inr (by decide))) hAD
  have hint := P.internalMultiplicity_union A D hAD
  have hcomp := B.compl_zeroCaseIndependentSet_eq C
  rw [hcomp]
  change P.internalMultiplicity (A ∪ D) = overlayEdge B C .R .M .M .R
  rw [hint, hAint, hDint, hsplit, h22Dzero]
  simp only [Nat.zero_add]
  exact P.betweenMultiplicity_comm _ _

lemma right_right_card_le_one_of_tail_le_two
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (htail : overlayEdge B C .R .R .M .R ≤ 2) :
    (block B C .R .R).card ≤ 1 := by
  classical
  let P := Pseudograph.ofSimple G
  let X := block B C .R .R
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hcut := B.right_right_boundary_ledger C hreg hno4 hno6
  change P.boundaryMultiplicity X = _ at hcut
  have hdis : Disjoint X (block B C .R .M) :=
    B.disjoint_block C (.inr (by decide))
  have hsub : block B C .R .M ⊆ Xᶜ := by
    intro x hx
    simp only [Finset.mem_compl]
    exact fun hX ↦ (Finset.disjoint_left.mp hdis) hX hx
  have hcompTwo : 2 ≤ Xᶜ.card :=
    hcard32.trans (Finset.card_le_card hsub)
  have hproper : X ≠ Finset.univ := by
    intro hEq
    have : Xᶜ.card = 0 := by simp [hEq]
    omega
  have hcases : overlayEdge B C .R .R .M .R = 0 ∨
      overlayEdge B C .R .R .M .R = 1 ∨
      overlayEdge B C .R .R .M .R = 2 := by omega
  rcases hcases with hzero | hone | htwo
  · have hcutZero : P.boundaryMultiplicity X = 0 := by omega
    have hXempty := B.right_right_eq_empty_of_boundary_zero C hconn hcard32 hcutZero
    rw [hXempty]
    simp
  · have hcutTwo : P.boundaryMultiplicity X = 2 := by omega
    have hXnonempty : X.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hEmpty
      rw [hEmpty, P.boundaryMultiplicity_empty] at hcutTwo
      omega
    exact False.elim (hno2 X hXnonempty hproper hcutTwo)
  · have hcutFour : P.boundaryMultiplicity X = 4 := by omega
    have hXnonempty : X.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hEmpty
      rw [hEmpty, P.boundaryMultiplicity_empty] at hcutFour
      omega
    rcases hno4 X hXnonempty hproper hcutFour with h | h
    · change X.card ≤ 1
      omega
    · exact False.elim (by omega)

lemma even_cross_of_zeroCaseIndependentSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hUind : G.IsIndepSet ((zeroCaseIndependentSet B C : Finset V) : Set V)) :
    Even (overlayEdge B C .R .M .M .R) := by
  let P := Pseudograph.ofSimple G
  let U := zeroCaseIndependentSet B C
  have hregular : P.IsRegularOfDegree 4 :=
    (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hUint : P.internalMultiplicity U = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G U hUind
  have hTint := B.internal_compl_zeroCaseIndependentSet_eq_cross C
  have hUdegree := P.regular_card_eq_two_internal_add_boundary hregular U
  have hTdegree := P.regular_card_eq_two_internal_add_boundary hregular Uᶜ
  have hboundary := P.boundaryMultiplicity_compl U
  change P.internalMultiplicity Uᶜ = overlayEdge B C .R .M .M .R at hTint
  rw [hUint, Nat.mul_zero, Nat.zero_add] at hUdegree
  rw [hTint, hboundary] at hTdegree
  refine ⟨Uᶜ.card - U.card, ?_⟩
  omega

lemma four_le_nu1_of_mu_values_zero
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hnuPos : 0 < overlayEdge B C .R .L .M .M)
    (hnuEq : overlayEdge B C .R .L .M .M =
      overlayEdge B C .L .R .M .M)
    (hnuNeTwo : overlayEdge B C .R .L .M .M ≠ 2) :
    4 ≤ overlayEdge B C .R .L .M .M := by
  have hdegree := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
  omega

lemma false_of_H2_empty_nu_four_x33_empty
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hnu1 : overlayEdge B C .R .L .M .M = 4)
    (hnuEq : overlayEdge B C .R .L .M .M =
      overlayEdge B C .L .R .M .M)
    (hH2 : overlayH2 B C = ∅)
    (h33 : block B C .R .R = ∅) : False := by
  have hdegree := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
  have hH1card := B.overlayH1_card C
  have hgroups := B.overlay_groups_card C
  have hBcard := B.first_right_overlay_card C
  have hCcard := B.second_right_overlay_card C
  obtain ⟨k, hk⟩ := hodd
  obtain ⟨kB, hkB⟩ := B.odd_right_card
  obtain ⟨kC, hkC⟩ := C.odd_right_card
  rw [hH2, h33] at hgroups
  rw [h33] at hBcard hCcard
  simp only [Finset.card_empty, Nat.zero_add, Nat.add_zero] at hgroups hBcard hCcard
  omega

lemma four_le_tail_of_zero_core
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hmu1 : overlayEdge B C .R .M .M .L = 0)
    (hmu2 : overlayEdge B C .M .R .L .M = 0)
    (hnuPos : 0 < overlayEdge B C .R .L .M .M)
    (hnuEq : overlayEdge B C .R .L .M .M =
      overlayEdge B C .L .R .M .M)
    (hnuLower : 4 ≤ overlayEdge B C .R .L .M .M)
    (hH2 : overlayH2 B C = ∅) :
    4 ≤ overlayEdge B C .R .R .M .R := by
  classical
  let P := Pseudograph.ofSimple G
  let X := block B C .R .R
  let l := overlayEdge B C .R .R .M .R
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hfirst := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
    overlayEdge B C .R .M .M .L +
    overlayEdge B C .R .M .M .R +
    overlayEdge B C .R .R .M .M + l = 8 at hfirst
  by_contra hnot
  have hle : l ≤ 3 := by omega
  by_cases hsmall : l ≤ 2
  · have h33card := B.right_right_card_le_one_of_tail_le_two C hreg hconn
      hno2 hno4 hno6 hlower hcard32 hsmall
    have hUind := B.zeroCaseIndependentSet_isIndepSet C hreg hno4 hno6
      hH2 h33card
    have hlarge := hindependentComplement (zeroCaseIndependentSet B C) hUind
    have hint := B.internal_compl_zeroCaseIndependentSet_eq_cross C
    have heven := B.even_cross_of_zeroCaseIndependentSet C hreg hUind
    obtain ⟨k, hk⟩ := heven
    have hcrossLarge : 4 ≤ overlayEdge B C .R .M .M .R := by
      rw [hint] at hlarge
      omega
    have hnuFour : overlayEdge B C .R .L .M .M = 4 := by omega
    have hcrossFour : overlayEdge B C .R .M .M .R = 4 := by omega
    have hlzero : l = 0 := by omega
    have hcut := B.right_right_boundary_ledger C hreg hno4 hno6
    have hcutZero : P.boundaryMultiplicity X = 0 := by
      change P.boundaryMultiplicity X = _ at hcut
      omega
    have hXempty := B.right_right_eq_empty_of_boundary_zero C hconn hcard32 hcutZero
    exact B.false_of_H2_empty_nu_four_x33_empty C hodd hreg hno4 hno6
      hlower hnuFour hnuEq hH2 hXempty
  · have hlthree : l = 3 := by omega
    have hcut := B.right_right_boundary_ledger C hreg hno4 hno6
    have hcutSix : P.boundaryMultiplicity X = 6 := by
      change P.boundaryMultiplicity X = _ at hcut
      omega
    have hdegree := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
    have hnuFour : overlayEdge B C .R .L .M .M = 4 := by omega
    have hXodd0 : Odd (block B C .R .R).card := by
      have hdegreeParity := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
      have hH1card := B.overlayH1_card C
      have hgroups := B.overlay_groups_card C
      have hBcard := B.first_right_overlay_card C
      have hCcard := B.second_right_overlay_card C
      obtain ⟨k, hk⟩ := hodd
      obtain ⟨kB, hkB⟩ := B.odd_right_card
      obtain ⟨kC, hkC⟩ := C.odd_right_card
      rw [hH2] at hgroups
      simp only [Finset.card_empty, Nat.zero_add] at hgroups
      rw [Nat.odd_iff]
      omega
    have hXodd : Odd X.card := by simpa [X] using hXodd0
    have hwR := B.selection_vertex_mem_right_of_mu1_zero
      selection C hreg hno4 hno6 hmu1
    have hw31 : selection.vertex ∈ block B C .R .L :=
      mem_block.mpr ⟨hwR, C.mem_left_distinguished⟩
    have hwNotX : selection.vertex ∉ X := fun hwX ↦
      (Finset.disjoint_left.mp C.disjoint_left_right)
        C.mem_left_distinguished (mem_block.mp hwX).2
    have hwNot32 : selection.vertex ∉ block B C .R .M := fun hw32 ↦
      (Finset.disjoint_left.mp C.disjoint_left_middle)
        C.mem_left_distinguished (mem_block.mp hw32).2
    have h32sub : block B C .R .M ∪ {selection.vertex} ⊆ Xᶜ := by
      intro x hx
      simp only [Finset.mem_union, Finset.mem_singleton] at hx
      rcases hx with hx32 | rfl
      · simp only [Finset.mem_compl]
        exact fun hxX ↦ (Finset.disjoint_left.mp
          (B.disjoint_block C (.inr (by decide)))) hx32 hxX
      · simp [hwNotX]
    have hdis : Disjoint (block B C .R .M) {selection.vertex} := by
      rw [Finset.disjoint_right]
      intro x hxsel hx32
      simp only [Finset.mem_singleton] at hxsel
      subst x
      exact hwNot32 hx32
    have hcompthree : 3 ≤ Xᶜ.card := by
      have hcardUnion := Finset.card_union_of_disjoint hdis
      have hle := Finset.card_le_card h32sub
      simp only [Finset.card_singleton] at hcardUnion
      omega
    rcases hno6 X hcutSix with hXtwo | hcomptwo
    · change Odd X.card at hXodd
      rcases hXodd with ⟨k, hk⟩
      omega
    · omega

structure ZeroEdgeCounts {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Prop where
  nu1_four : overlayEdge B C .R .L .M .M = 4
  nu2_four : overlayEdge B C .L .R .M .M = 4
  cross_zero : overlayEdge B C .R .M .M .R = 0
  tail23_four : overlayEdge B C .R .R .M .R = 4
  tail32_four : overlayEdge B C .R .R .R .M = 4

lemma zero_core_edge_counts
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hmu1 : overlayEdge B C .R .M .M .L = 0)
    (hnuEq : overlayEdge B C .R .L .M .M =
      overlayEdge B C .L .R .M .M)
    (hnuLower : 4 ≤ overlayEdge B C .R .L .M .M)
    (htailLower : 4 ≤ overlayEdge B C .R .R .M .R) :
    ZeroEdgeCounts B C := by
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have htails := B.overlay_tails_eq C hreg hno4 hno6 hlower
  have hfirst := B.first_right_middle_overlay_ledger C hreg hno4 hno6
  change overlayEdge B C .R .L .M .M +
    overlayEdge B C .R .M .M .L +
    overlayEdge B C .R .M .M .R +
    overlayEdge B C .R .R .M .M +
    overlayEdge B C .R .R .M .R = 8 at hfirst
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> omega

lemma right_right_odd_of_H2_empty_nu_four
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hlower : CrossedLowerBounds B C)
    (hnu1 : overlayEdge B C .R .L .M .M = 4)
    (hnuEq : overlayEdge B C .R .L .M .M =
      overlayEdge B C .L .R .M .M)
    (hH2 : overlayH2 B C = ∅) :
    Odd (block B C .R .R).card := by
  have hdegree := B.overlay_diagonal_degree C hreg hno4 hno6 hlower
  have hH1card := B.overlayH1_card C
  have hgroups := B.overlay_groups_card C
  have hBcard := B.first_right_overlay_card C
  have hCcard := B.second_right_overlay_card C
  obtain ⟨k, hk⟩ := hodd
  obtain ⟨kB, hkB⟩ := B.odd_right_card
  obtain ⟨kC, hkC⟩ := C.odd_right_card
  rw [hH2] at hgroups
  simp only [Finset.card_empty, Nat.zero_add] at hgroups
  rw [Nat.odd_iff]
  omega

noncomputable def mergedZeroLeft
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  B.left ∪ C.left

noncomputable def mergedZeroMiddle
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  B.middle ∪ C.middle

noncomputable def mergedZeroRight
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) : Finset V :=
  block B C .R .R

lemma mergedZeroLeft_isIndepSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hH2 : overlayH2 B C = ∅) :
    G.IsIndepSet ((mergedZeroLeft B C : Finset V) : Set V) := by
  intro x hx y hy hxy hAdj
  change x ∈ B.left ∪ C.left at hx
  change y ∈ B.left ∪ C.left at hy
  simp only [Finset.mem_union] at hx hy
  rcases hx with hxB | hxC <;> rcases hy with hyB | hyC
  · exact B.left_isIndepSet hreg hno4 hno6 hxB hyB hxy hAdj
  · have hxCM := C.mem_middle_of_adj_left hreg hno4 hno6 hyC hAdj.symm
    have hx12 : x ∈ block B C .L .M := mem_block.mpr ⟨hxB, hxCM⟩
    have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_left _ hx12
    rw [hH2] at hxH2
    simp at hxH2
  · have hxBM := B.mem_middle_of_adj_left hreg hno4 hno6 hyB hAdj.symm
    have hx21 : x ∈ block B C .M .L := mem_block.mpr ⟨hxBM, hxC⟩
    have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_right _ hx21
    rw [hH2] at hxH2
    simp at hxH2
  · exact C.left_isIndepSet hreg hno4 hno6 hxC hyC hxy hAdj

lemma mergedZeroMiddle_isIndepSet
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hH2 : overlayH2 B C = ∅)
    (hcross : overlayEdge B C .R .M .M .R = 0) :
    G.IsIndepSet ((mergedZeroMiddle B C : Finset V) : Set V) := by
  have hBC : ∀ {x y : V}, x ∈ B.middle → y ∈ C.middle →
      x ≠ y → ¬ G.Adj x y := by
    intro x y hxB hyC hxy hAdj
    by_cases hxCM : x ∈ C.middle
    · exact C.middle_isIndepSet hxCM hyC hxy hAdj
    obtain ⟨s, hxs, _⟩ := C.existsUnique_mem_side x
    cases s with
    | L =>
        have hx21 : x ∈ block B C .M .L := mem_block.mpr ⟨hxB, hxs⟩
        have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_right _ hx21
        rw [hH2] at hxH2
        simp at hxH2
    | M => exact False.elim (hxCM hxs)
    | R =>
        by_cases hyBM : y ∈ B.middle
        · exact B.middle_isIndepSet hxB hyBM hxy hAdj
        obtain ⟨t, hyt, _⟩ := B.existsUnique_mem_side y
        cases t with
        | L =>
            have hy12 : y ∈ block B C .L .M := mem_block.mpr ⟨hyt, hyC⟩
            have hyH2 : y ∈ overlayH2 B C := Finset.mem_union_left _ hy12
            rw [hH2] at hyH2
            simp at hyH2
        | M => exact False.elim (hyBM hyt)
        | R =>
            have hx23 : x ∈ block B C .M .R := mem_block.mpr ⟨hxB, hxs⟩
            have hy32 : y ∈ block B C .R .M := mem_block.mpr ⟨hyt, hyC⟩
            have hpos := betweenMultiplicity_pos_of_adj_mem G
              (block B C .R .M) (block B C .M .R)
              (B.disjoint_block C (.inl (by decide))) hAdj.symm hy32 hx23
            change 0 < overlayEdge B C .R .M .M .R at hpos
            omega
  intro x hx y hy hxy hAdj
  change x ∈ B.middle ∪ C.middle at hx
  change y ∈ B.middle ∪ C.middle at hy
  simp only [Finset.mem_union] at hx hy
  rcases hx with hxB | hxC <;> rcases hy with hyB | hyC
  · exact B.middle_isIndepSet hxB hyB hxy hAdj
  · exact hBC hxB hyC hxy hAdj
  · exact hBC hyB hxC hxy.symm hAdj.symm
  · exact C.middle_isIndepSet hxC hyC hxy hAdj

lemma disjoint_mergedZeroLeft_middle
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v)
    (hH2 : overlayH2 B C = ∅) :
    Disjoint (mergedZeroLeft B C) (mergedZeroMiddle B C) := by
  classical
  rw [Finset.disjoint_left]
  intro x hx hy
  simp only [mergedZeroLeft, Finset.mem_union] at hx
  simp only [mergedZeroMiddle, Finset.mem_union] at hy
  rcases hx with hxBL | hxCL <;> rcases hy with hyBM | hyCM
  · exact (Finset.disjoint_left.mp B.disjoint_left_middle) hxBL hyBM
  · have hx12 : x ∈ block B C .L .M := mem_block.mpr ⟨hxBL, hyCM⟩
    have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_left _ hx12
    rw [hH2] at hxH2
    simp at hxH2
  · have hx21 : x ∈ block B C .M .L := mem_block.mpr ⟨hyBM, hxCL⟩
    have hxH2 : x ∈ overlayH2 B C := Finset.mem_union_right _ hx21
    rw [hH2] at hxH2
    simp at hxH2
  · exact (Finset.disjoint_left.mp C.disjoint_left_middle) hxCL hyCM

lemma disjoint_mergedZeroLeft_right
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (mergedZeroLeft B C) (mergedZeroRight B C) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  simp only [mergedZeroLeft, Finset.mem_union] at hx
  rcases hx with hxB | hxC
  · exact (Finset.disjoint_left.mp B.disjoint_left_right) hxB
      (mem_block.mp hy).1
  · exact (Finset.disjoint_left.mp C.disjoint_left_right) hxC
      (mem_block.mp hy).2

lemma disjoint_mergedZeroMiddle_right
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    Disjoint (mergedZeroMiddle B C) (mergedZeroRight B C) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  simp only [mergedZeroMiddle, Finset.mem_union] at hx
  rcases hx with hxB | hxC
  · exact (Finset.disjoint_left.mp B.disjoint_middle_right) hxB
      (mem_block.mp hy).1
  · exact (Finset.disjoint_left.mp C.disjoint_middle_right) hxC
      (mem_block.mp hy).2

lemma mergedZero_cover
    {G : SimpleGraph V} {u v : V}
    (B : TypeCBarrier G u) (C : TypeCBarrier G v) :
    mergedZeroLeft B C ∪ mergedZeroMiddle B C ∪ mergedZeroRight B C =
      Finset.univ := by
  classical
  ext x
  simp only [Finset.mem_union, Finset.mem_univ, iff_true]
  obtain ⟨s, hxs, _⟩ := B.existsUnique_mem_side x
  cases s with
  | L => exact Or.inl (Or.inl (Finset.mem_union_left _ hxs))
  | M => exact Or.inl (Or.inr (Finset.mem_union_left _ hxs))
  | R =>
      obtain ⟨t, hxt, _⟩ := C.existsUnique_mem_side x
      cases t with
      | L => exact Or.inl (Or.inl (Finset.mem_union_right _ hxt))
      | M => exact Or.inl (Or.inr (Finset.mem_union_right _ hxt))
      | R => exact Or.inr (mem_block.mpr ⟨hxs, hxt⟩)

/-- The final Case-1 recombination is a type-C barrier whose right shore
is just the common block `X33`. -/
noncomputable def mergedZeroBarrier
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hH2 : overlayH2 B C = ∅)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hcounts : ZeroEdgeCounts B C) :
    TypeCBarrier G selection.vertex := by
  classical
  let L := mergedZeroLeft B C
  let M := mergedZeroMiddle B C
  let R := mergedZeroRight B C
  have hcutLedger := B.right_right_boundary_ledger C hreg hno4 hno6
  have hdiag := B.sharedDiagonal_zero C hreg hno4 hno6 hlower
  have hcut : (Pseudograph.ofSimple G).boundaryMultiplicity R = 8 := by
    change (Pseudograph.ofSimple G).boundaryMultiplicity R = _ at hcutLedger
    rw [hdiag, hcounts.tail23_four, hcounts.tail32_four] at hcutLedger
    omega
  have hRodd : Odd R.card := by
    exact B.right_right_odd_of_H2_empty_nu_four C hodd hreg hno4 hno6
      hlower hcounts.nu1_four
        (hcounts.nu1_four.trans hcounts.nu2_four.symm) hH2
  have hcomp : 2 ≤ Rᶜ.card := by
    have hsub : block B C .R .M ⊆ Rᶜ := by
      intro x hx
      simp only [Finset.mem_compl]
      exact fun hR ↦ (Finset.disjoint_left.mp
        (B.disjoint_block C (.inr (by decide)))) hx hR
    exact hcard32.trans (Finset.card_le_card hsub)
  apply ofPartition hreg hno4 hno6 L M R
  · exact Finset.mem_union_right _ C.mem_left_distinguished
  · exact B.disjoint_mergedZeroLeft_middle C hH2
  · exact B.disjoint_mergedZeroLeft_right C
  · exact B.disjoint_mergedZeroMiddle_right C
  · exact B.mergedZero_cover C
  · exact B.mergedZeroLeft_isIndepSet C hreg hno4 hno6 hH2
  · exact B.mergedZeroMiddle_isIndepSet C hreg hno4 hno6 hH2
      hcounts.cross_zero
  · intro x y hx hy
    change x ∈ B.left ∪ C.left at hx
    rcases Finset.mem_union.mp hx with hxB | hxC
    · exact B.not_adj_left_right hreg hno4 hno6 hxB (mem_block.mp hy).1
    · exact C.not_adj_left_right hreg hno4 hno6 hxC (mem_block.mp hy).2
  · exact hcut
  · exact hRodd
  · exact hcomp
  · exact hindependentComplement

lemma false_of_mergedZeroBarrier_minimal
    {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) (selection : TashkinovSelection B)
    (C : TypeCBarrier G selection.vertex)
    (hBminimal : ∀ (v : V) (D : TypeCBarrier G v),
      B.right.card ≤ D.right.card)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hlower : CrossedLowerBounds B C)
    (hH2 : overlayH2 B C = ∅)
    (hcard32 : 2 ≤ (block B C .R .M).card)
    (hcounts : ZeroEdgeCounts B C) : False := by
  let D := B.mergedZeroBarrier selection C hodd hreg hno4 hno6
    hindependentComplement hlower
    hH2 hcard32 hcounts
  have hminimal := hBminimal selection.vertex D
  have hrow := B.block_row_card C .R
  simp only [side_R] at hrow
  have hDright : D.right.card = (block B C .R .R).card := rfl
  omega

/-- Minimality of the right component among barriers with the same
distinguished vertex. -/
def IsRightMinimalAt {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Prop :=
  ∀ C : TypeCBarrier G u, B.right.card ≤ C.right.card

/-- Global minimality of the right component among all type-C barriers. -/
def IsRightMinimal {G : SimpleGraph V} {u : V}
    (B : TypeCBarrier G u) : Prop :=
  ∀ (v : V) (C : TypeCBarrier G v), B.right.card ≤ C.right.card

/-- Natural-number minimization selects a smallest type-C right component
for any fixed distinguished vertex. -/
lemma exists_rightMinimalAt {G : SimpleGraph V} {u : V}
    (hexists : Nonempty (TypeCBarrier G u)) :
    ∃ B : TypeCBarrier G u, IsRightMinimalAt B := by
  let p : ℕ → Prop := fun n ↦ ∃ B : TypeCBarrier G u, B.right.card = n
  have hp : ∃ n, p n := by
    obtain ⟨B⟩ := hexists
    exact ⟨B.right.card, B, rfl⟩
  obtain ⟨B, hB⟩ := Nat.find_spec hp
  refine ⟨B, ?_⟩
  intro C
  rw [hB]
  exact Nat.find_min' hp ⟨C, rfl⟩

/-- Natural-number minimization also selects a globally smallest right
component when every vertex has a type-C barrier. -/
lemma exists_rightMinimal [Nonempty V] {G : SimpleGraph V}
    (hexists : ∀ u : V, Nonempty (TypeCBarrier G u)) :
    ∃ (u : V) (B : TypeCBarrier G u), IsRightMinimal B := by
  let p : ℕ → Prop := fun n ↦
    ∃ (u : V) (B : TypeCBarrier G u), B.right.card = n
  have hp : ∃ n, p n := by
    let u : V := Classical.choice inferInstance
    obtain ⟨B⟩ := hexists u
    exact ⟨B.right.card, u, B, rfl⟩
  obtain ⟨u, B, hB⟩ := Nat.find_spec hp
  refine ⟨u, B, ?_⟩
  intro v C
  rw [hB]
  exact Nat.find_min' hp ⟨v, C, rfl⟩

/-- A globally minimal first barrier together with the selected second
barrier and all of the checked hypotheses of equations (5.2)--(5.4). -/
structure SelectedPair (G : SimpleGraph V) where
  firstVertex : V
  first : TypeCBarrier G firstVertex
  first_minimal : IsRightMinimal first
  selection : TashkinovSelection first
  second : TypeCBarrier G selection.vertex
  second_minimal : IsRightMinimalAt second
  two_le_block₃₂ : 2 ≤ (block first second .R .M).card
  crossedLowerBounds : CrossedLowerBounds first second

lemma exists_selectedPair [Nonempty V] {G : SimpleGraph V}
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hexists : ∀ u : V, Nonempty (TypeCBarrier G u)) :
    Nonempty (SelectedPair G) := by
  classical
  obtain ⟨u, B, hminimal⟩ := exists_rightMinimal hexists
  obtain ⟨selection⟩ := B.exists_tashkinovSelection hreg hno4 hno6
  obtain ⟨C, hCminimal⟩ := exists_rightMinimalAt (hexists selection.vertex)
  have hcard := selection.two_le_block₃₂ C
  have hlower := B.crossedLowerBounds_of_rightMinimal C hreg hconn hno2 hno4 hno6
    hminimal hcard
  exact ⟨⟨u, B, hminimal, selection, C, hCminimal, hcard, hlower⟩⟩

/-- Tashkinov's positive-`mu` branch ends with four `X32--X21` edges
distributed over two `X32` vertices, although the selection rule permits
at most one such edge at each vertex. -/
lemma false_of_selectedPair_positive
    {G : SimpleGraph V} (pair : SelectedPair G)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hpos : 0 < overlayEdge pair.first pair.second .R .M .M .L +
      overlayEdge pair.first pair.second .M .R .L .M) : False := by
  rcases pair with ⟨u, B, hBminimal, selection, C, hCminimal,
    hcard32, hlower⟩
  have hnu := B.positive_nu_values_zero C hodd hreg hconn hno2 hno4 hno6
    hindependentComplement hlower hcard32 hpos
  have hselectionMiddle := B.selection_vertex_mem_middle_of_nu1_zero
    selection C hreg hno4 hno6 hnu.1
  have hmu := B.mu_values_equal_of_nu_values_zero C hreg hno4 hno6
    hlower hnu.1 hnu.2
  have hH1 := B.diagonal_empty_of_nu_values_zero C hreg hconn hno4 hno6
    hlower hcard32 hnu.1 hnu.2
  have hH2even := B.offDiagonal_even_of_mu_values_equal C hreg hno4 hno6 hmu
  have h33odd := B.right_right_odd_of_diagonal_empty_of_offDiagonal_even
    C hodd hH1 hH2even
  have htailLower := B.four_le_tail_of_positive_core C hreg hconn hno2
    hno4 hno6 hindependentComplement hlower hcard32 hH1 hmu h33odd
  have hcounts := B.positive_core_edge_counts C hreg hconn hno2 hno4 hno6
    hlower hcard32 hpos hnu.1 hmu htailLower
  have hactive := B.activeX23_card_eq_two selection C hreg hno4 hno6
    hselectionMiddle hcounts.cross_zero hcounts.tail23_four
  have h1323 := B.second_minimal_forces_x13_x23 selection C hCminimal
    hreg hno4 hno6 hindependentComplement hlower
    hselectionMiddle hcounts.cross_zero hH1 h33odd
    hcard32 hactive hcounts.tail23_four
  have h3132 := B.first_minimal_forces_x31_x32 selection C hBminimal
    h1323.1 h1323.2 hcard32
  exact B.selected_middle_contradiction_of_x32_two_mu1_four selection C
    hselectionMiddle h3132.2 hcounts.mu1_four

/-- Tashkinov's zero-`mu` branch ends by merging the two barriers and
obtaining a strictly smaller right shore. -/
lemma false_of_selectedPair_zero
    {G : SimpleGraph V} (pair : SelectedPair G)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hzero : overlayEdge pair.first pair.second .R .M .M .L +
      overlayEdge pair.first pair.second .M .R .L .M = 0) : False := by
  rcases pair with ⟨u, B, hBminimal, selection, C, hCminimal,
    hcard32, hlower⟩
  change overlayEdge B C .R .M .M .L +
    overlayEdge B C .M .R .L .M = 0 at hzero
  have hmu1 : overlayEdge B C .R .M .M .L = 0 := by omega
  have hmu2 : overlayEdge B C .M .R .L .M = 0 := by omega
  have hwR := B.selection_vertex_mem_right_of_mu1_zero selection C
    hreg hno4 hno6 hmu1
  have hnuPos := B.nu1_pos_of_selection_mem_right selection C
    hreg hno4 hno6 hwR
  have hnuEq := B.nu_values_equal_of_mu_values_zero C hreg hno4 hno6
    hlower hmu1 hmu2
  have hnuNeTwo := B.nu1_ne_two_of_selected_right selection C hreg hconn
    hno4 hno6 hlower hcard32 hwR hmu1 hmu2
  have hnuLower := B.four_le_nu1_of_mu_values_zero C hreg hno4 hno6
    hlower hnuPos hnuEq hnuNeTwo
  have hH2 := B.offDiagonal_empty_of_mu_values_zero C hreg hconn hno4 hno6
    hcard32 hmu1 hmu2
  have htailLower := B.four_le_tail_of_zero_core selection C hodd hreg hconn
    hno2 hno4 hno6 hindependentComplement hlower hcard32 hmu1 hmu2
    hnuPos hnuEq hnuLower hH2
  have hcounts := B.zero_core_edge_counts C hreg hno4 hno6 hlower
    hmu1 hnuEq hnuLower htailLower
  exact B.false_of_mergedZeroBarrier_minimal selection C hBminimal hodd hreg
    hno4 hno6 hindependentComplement hlower hH2 hcard32 hcounts

lemma false_of_selectedPair
    {G : SimpleGraph V} (pair : SelectedPair G)
    (hodd : Odd (Nat.card V))
    (hreg : G.IsRegularOfDegree 4) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hno6 : HasOnlyTrivialSixCuts G)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ) : False := by
  let q := overlayEdge pair.first pair.second .R .M .M .L +
    overlayEdge pair.first pair.second .M .R .L .M
  by_cases hpos : 0 < q
  · exact false_of_selectedPair_positive pair hodd hreg hconn hno2 hno4 hno6
      hindependentComplement hpos
  · have hzero : q = 0 := by omega
    exact false_of_selectedPair_zero pair hodd hreg hconn hno2 hno4 hno6
      hindependentComplement hzero

end TypeCBarrier

/-- The full type-C witness exists after the no-six-cut stage. -/
theorem exists_typeCBarrier
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hno6 : HasOnlyTrivialSixCuts G)
    (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    Nonempty (TypeCBarrier G u) := by
  classical
  obtain ⟨X, hfull⟩ :=
    exists_antiNeighborhood_barrier_pattern_of_noPerfectMatching
      G hreg hodd hconn hno2 hno4 u hno
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c)
  change J.oddComponents.ncard = X.ncard + 2 ∧
    (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
    (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
    ∃ kind : BarrierKind,
      IsAntiNeighborhoodBarrierPattern G u X kind at hfull
  rcases hfull with ⟨hq, hall, hvalues, kind, hpattern⟩
  have hgenuine : kind = .A ∨ kind = .B ∨ kind = .C := by
    rcases kind with _ | _ | _ | _
    · exact .inl rfl
    · exact .inr (.inl rfl)
    · exact .inr (.inr rfl)
    · exfalso
      exact (not_degenerate_antiNeighborhood_barrierPattern
        G hreg hno4 hindependentComplement u X hvalues) hpattern
  have hkC := barrierKind_eq_C_of_no_six_cut
    G hreg hno6 u X kind hall hgenuine hpattern
  subst kind
  obtain ⟨c, hc8, hcUnique⟩ :=
    existsUnique_eightComponent_of_typeC_pattern G u X hpattern
  let R : TutteTypeCBarrier G u := {
    X := X
    oddComponents_exact := hq
    all_components_odd := hall
    cut_value := hvalues
    pattern := hpattern
    component := c
    component_cut := hc8
    component_unique := fun d hd ↦ hcUnique d hd }
  exact ⟨TypeCBarrier.ofTutte R hreg hno4 hno6 hindependentComplement⟩

/-- A matching of the graph induced outside `N[u]`, regarded as a subgraph
of the original graph. -/
def liftAntiNeighborhoodMatching (G : SimpleGraph V) (u : V)
    (M : (G.induce (antiNeighborhood G u)).Subgraph) : G.Subgraph :=
  M.map (SimpleGraph.Embedding.induce (antiNeighborhood G u)).toHom

lemma liftAntiNeighborhoodMatching_verts {G : SimpleGraph V} {u : V}
    {M : (G.induce (antiNeighborhood G u)).Subgraph}
    (hM : M.IsSpanning) :
    (liftAntiNeighborhoodMatching G u M).verts = antiNeighborhood G u := by
  classical
  ext v
  simp [liftAntiNeighborhoodMatching, hM.verts_eq_univ]

lemma liftAntiNeighborhoodMatching_isMatching {G : SimpleGraph V} {u : V}
    {M : (G.induce (antiNeighborhood G u)).Subgraph}
    (hM : M.IsMatching) :
    (liftAntiNeighborhoodMatching G u M).IsMatching := by
  exact hM.map _
    (SimpleGraph.Embedding.induce (G := G) (antiNeighborhood G u)).injective

/-- The elementary matching certificate at the heart of Tashkinov's proof:
if deleting the closed neighborhood of one vertex leaves a perfect matching,
then deleting that vertex and those matching edges leaves a cubic subgraph. -/
theorem containsThreeRegular_of_isPerfectMatching_antiNeighborhood
    (G : SimpleGraph V) (u : V) (hreg : G.IsRegularOfDegree 4)
    (M : (G.induce (antiNeighborhood G u)).Subgraph)
    (hM : M.IsPerfectMatching) :
    ContainsRegularSubgraph G 3 := by
  classical
  let P : G.Subgraph := liftAntiNeighborhoodMatching G u M
  let B : SimpleGraph V := G.deleteIncidenceSet u
  let K : SimpleGraph V := B \ P.spanningCoe
  have hPverts : P.verts = antiNeighborhood G u :=
    liftAntiNeighborhoodMatching_verts hM.2
  have hPmatch : P.IsMatching :=
    liftAntiNeighborhoodMatching_isMatching hM.1
  have hPdegree (v : V) :
      P.degree v = if v ∈ antiNeighborhood G u then 1 else 0 := by
    split_ifs with hv
    · exact (SimpleGraph.Subgraph.isMatching_iff_forall_degree.mp hPmatch v
        (hPverts.symm ▸ hv))
    · exact P.degree_of_notMem_verts (by simpa [hPverts] using hv)
  have hPB : P.spanningCoe ≤ B := by
    intro v w hvw
    have hvP : v ∈ P.verts := P.edge_vert hvw
    have hwP : w ∈ P.verts := P.edge_vert hvw.symm
    have hvA : v ∈ antiNeighborhood G u := hPverts ▸ hvP
    have hwA : w ∈ antiNeighborhood G u := hPverts ▸ hwP
    exact SimpleGraph.deleteIncidenceSet_adj.mpr
      ⟨P.adj_sub hvw, hvA.1, hwA.1⟩
  have hKG : K ≤ G := by
    exact (sdiff_le.trans (G.deleteIncidenceSet_le u))
  have hBdegree (v : V) (hvu : v ≠ u) :
      B.degree v = if G.Adj u v then 3 else 4 := by
    have hneighbors : B.neighborFinset v =
        if G.Adj u v then G.neighborFinset v \ {u} else G.neighborFinset v := by
      ext w
      by_cases huv : G.Adj u v
      · simp [B, SimpleGraph.deleteIncidenceSet_adj, huv, G.adj_comm, hvu]
      · simp only [if_neg huv, SimpleGraph.mem_neighborFinset, B,
          SimpleGraph.deleteIncidenceSet_adj]
        constructor
        · exact And.left
        · intro hvw
          refine ⟨hvw, hvu, ?_⟩
          intro hwu
          subst w
          exact huv hvw.symm
    rw [← SimpleGraph.card_neighborFinset_eq_degree, hneighbors]
    split_ifs with huv
    · have hu_mem : u ∈ G.neighborFinset v := by simpa [G.adj_comm] using huv
      rw [Finset.sdiff_singleton_eq_erase, Finset.card_erase_of_mem hu_mem,
        SimpleGraph.card_neighborFinset_eq_degree, hreg v]
    · rw [SimpleGraph.card_neighborFinset_eq_degree, hreg v]
  have hKdegree (v : V) (hvu : v ≠ u) : K.degree v = 3 := by
    have hneighbors : K.neighborFinset v =
        B.neighborFinset v \ P.spanningCoe.neighborFinset v := by
      simpa only [K] using
        (SimpleGraph.neighborFinset_sdiff (v := v)
          (G₁ := B) (G₂ := P.spanningCoe))
    have hsubset : P.spanningCoe.neighborFinset v ⊆ B.neighborFinset v := by
      intro w hw
      simpa only [SimpleGraph.mem_neighborFinset] using
        hPB (by simpa only [SimpleGraph.mem_neighborFinset] using hw)
    rw [← SimpleGraph.card_neighborFinset_eq_degree, hneighbors,
      Finset.card_sdiff_of_subset hsubset,
      SimpleGraph.card_neighborFinset_eq_degree,
      SimpleGraph.card_neighborFinset_eq_degree,
      SimpleGraph.Subgraph.degree_spanningCoe, hPdegree,
      hBdegree v hvu]
    by_cases huv : G.Adj u v
    · have hvA : v ∉ antiNeighborhood G u := by simp [antiNeighborhood, huv]
      simp [huv, hvA]
    · have hvA : v ∈ antiNeighborhood G u := by
        exact ⟨hvu, huv⟩
      simp [huv, hvA]
  have hKB : K ≤ B := sdiff_le
  let H : G.Subgraph :=
    { verts := ({u}ᶜ : Set V)
      Adj := K.Adj
      adj_sub := fun h ↦ hKG h
      edge_vert := by
        intro v w hvw
        have hvwB : B.Adj v w := hKB hvw
        exact (SimpleGraph.deleteIncidenceSet_adj.mp hvwB).2.1
      symm := K.symm }
  refine ⟨H, ?_, ?_⟩
  · obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
    exact ⟨v, by simpa [H] using huv.ne'⟩
  · intro v
    have hvu : (v : V) ≠ u := by
      have hv : (v : V) ∈ ({u}ᶜ : Set V) := by
        change (v : V) ∈ H.verts
        exact v.2
      simpa only [Set.mem_compl_iff, Set.mem_singleton_iff] using hv
    rw [← Set.fintypeCard_eq_ncard, SimpleGraph.card_neighborSet_eq_degree]
    change (K.induce ({u}ᶜ : Set V)).degree ⟨v, by simpa using hvu⟩ = 3
    rw [K.degree_induce_of_neighborSet_subset]
    · exact hKdegree v hvu
    · intro w hvw
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      intro hwu
      subst w
      have hvwK : K.Adj (v : V) u := by
        simpa only [SimpleGraph.mem_neighborSet] using hvw
      have hvwB : B.Adj (v : V) u := hKB hvwK
      exact (SimpleGraph.deleteIncidenceSet_adj.mp hvwB).2.2 rfl

/-- The complete barrier contradiction, packaged under the structural
properties established for Tashkinov's minimal counterexample. -/
theorem containsThreeRegular_of_odd_of_structural_properties
    [Nonempty V] (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hno6 : HasOnlyTrivialSixCuts G) :
    ContainsRegularSubgraph G 3 := by
  by_contra hcounter
  have hnoMatching : ∀ u : V,
      ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
        M.IsPerfectMatching := by
    intro u hmatching
    obtain ⟨M, hM⟩ := hmatching
    exact hcounter
      (containsThreeRegular_of_isPerfectMatching_antiNeighborhood G u hreg M hM)
  have hexists : ∀ u : V, Nonempty (TypeCBarrier G u) := by
    intro u
    exact exists_typeCBarrier G hreg hodd hconn hno2 hno4
      hindependentComplement hno6 u (hnoMatching u)
  obtain ⟨pair⟩ := TypeCBarrier.exists_selectedPair hreg hconn hno2 hno4 hno6
    hexists
  exact TypeCBarrier.false_of_selectedPair pair hodd hreg hconn hno2 hno4
    hno6 hindependentComplement

/-- Once the structural part of Tashkinov's argument rules out all genuine
A/B/C barrier patterns, the matching certificate immediately supplies the
required cubic subgraph. -/
theorem containsThreeRegular_of_odd_of_no_barrier_pattern
    [Nonempty V] (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (hnoBarrier : ∀ (u : V) (X : Set (antiNeighborhood G u))
      (kind : BarrierKind),
      (kind = .A ∨ kind = .B ∨ kind = .C) →
      ¬ IsAntiNeighborhoodBarrierPattern G u X kind) :
    ContainsRegularSubgraph G 3 := by
  let u : V := Classical.choice inferInstance
  by_cases hmatching : ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching
  · obtain ⟨M, hM⟩ := hmatching
    exact containsThreeRegular_of_isPerfectMatching_antiNeighborhood G u hreg M hM
  · obtain ⟨X, kind, _hall, hkind, hpattern⟩ :=
      exists_genuine_antiNeighborhood_barrier_pattern
        G hreg hodd hconn hno2 hno4 hindependentComplement u hmatching
    exact False.elim ((hnoBarrier u X kind hkind) hpattern)

/-! ### Six-cut matching closures

Tashkinov's Proposition 3.6 closes a six-edge shore by pairing its six
labelled dangling incidences.  The next definitions are the three-edge
analogue of the paired four-cut API above.  They retain copy labels, so the
construction is valid even when a closing edge becomes parallel to an
existing edge. -/

namespace Pseudograph

variable {W : Type*} [Fintype W]

def sixPairEndpoint {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 6) : S :=
  ⟨(E i).inside, (E i).inside_mem⟩

/-- Pair the labelled cut edges `(0,1)`, `(2,3)`, and `(4,5)` on one
shore. -/
noncomputable def closeSixCutMatchingWith (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) : Pseudograph S :=
  ((G.induce S + singleEdge (sixPairEndpoint E 0) (sixPairEndpoint E 1)) +
      singleEdge (sixPairEndpoint E 2) (sixPairEndpoint E 3)) +
    singleEdge (sixPairEndpoint E 4) (sixPairEndpoint E 5)

/-- The degree contributed by any chosen subfamily of the three artificial
closing edges. -/
noncomputable def sixClosingDegree {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : S) : ℕ :=
  (if use₀₁ then
      (singleEdge (sixPairEndpoint E 0) (sixPairEndpoint E 1)).degree v
    else 0) +
  (if use₂₃ then
      (singleEdge (sixPairEndpoint E 2) (sixPairEndpoint E 3)).degree v
    else 0) +
  (if use₄₅ then
      (singleEdge (sixPairEndpoint E 4) (sixPairEndpoint E 5)).degree v
    else 0)

/-- A three-edge matching closure restores precisely the six cut
incidences, including the factor two when a paired endpoint coincides and
the artificial edge is a loop. -/
lemma closeSixCutMatchingWith_isRegularOfDegree
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (hreg : G.IsRegularOfDegree 4) :
    (G.closeSixCutMatchingWith S E).IsRegularOfDegree 4 := by
  classical
  intro v
  have hout := G.outsideDegree_eq_listingEndpointCount S E v v.2
  have hcount : G.outsideDegree S v =
      (if v = sixPairEndpoint E 0 then 1 else 0) +
      (if v = sixPairEndpoint E 1 then 1 else 0) +
      (if v = sixPairEndpoint E 2 then 1 else 0) +
      (if v = sixPairEndpoint E 3 then 1 else 0) +
      (if v = sixPairEndpoint E 4 then 1 else 0) +
      (if v = sixPairEndpoint E 5 then 1 else 0) := by
    rw [hout, listingEndpointCount, Fin.sum_univ_six]
    simp only [sixPairEndpoint, Subtype.ext_iff, eq_comm]
  have hdegree := G.degree_induce_add_outsideDegree S v v.2
  rw [hreg v, hcount] at hdegree
  simp only [closeSixCutMatchingWith, degree_add, degree_singleEdge]
  split_ifs at hdegree ⊢ <;> omega

/-- Peel at most one copy of one artificial edge from a part of `B+ab`.
The Boolean records whether that copy was genuinely used. -/
lemma exists_singleEdgeDecomposition
    (B H : Pseudograph W) (a b : W)
    (hH : H.IsPart (B + singleEdge a b)) :
    ∃ use : Bool, ∃ F : Pseudograph W,
      F.IsPart B ∧
        ∀ v, F.degree v +
          (if use then (singleEdge a b).degree v else 0) = H.degree v := by
  classical
  by_cases huse : B.mult a b < H.mult a b
  · let F := H.removeSingleEdge a b
    have hpos : 0 < H.mult a b := lt_of_le_of_lt (Nat.zero_le _) huse
    have hF : F.IsPart B := removeSingleEdge_isPart_left hH
    refine ⟨true, F, hF, ?_⟩
    intro v
    simpa only [F, degree_singleEdge, Bool.true_eq, if_true, Nat.add_assoc] using
      (degree_removeSingleEdge_add H a b v hpos)
  · have hHB : H.IsPart B :=
      isPart_left_of_isPart_add_of_mult_le hH (Nat.le_of_not_gt huse)
    refine ⟨false, H, hHB, ?_⟩
    intro v
    simp

/-- A labelled decomposition of a part of a six-cut matching closure. -/
def SixClosureDecomposition
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (H : Pseudograph S)
    (use₀₁ use₂₃ use₄₅ : Bool) (F : Pseudograph S) : Prop :=
  F.IsPart (G.induce S) ∧
    ∀ v, F.degree v + sixClosingDegree E use₀₁ use₂₃ use₄₅ v =
      H.degree v

/-- Every part of a six-cut matching closure admits a decomposition into
its genuine shore part and three artificial-edge use bits. -/
lemma exists_sixClosureDecomposition
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (H : Pseudograph S)
    (hH : H.IsPart (G.closeSixCutMatchingWith S E)) :
    ∃ use₀₁ use₂₃ use₄₅ : Bool, ∃ F : Pseudograph S,
      SixClosureDecomposition E H use₀₁ use₂₃ use₄₅ F := by
  classical
  let B : Pseudograph S := G.induce S
  let e₀₁ : Pseudograph S :=
    singleEdge (sixPairEndpoint E 0) (sixPairEndpoint E 1)
  let e₂₃ : Pseudograph S :=
    singleEdge (sixPairEndpoint E 2) (sixPairEndpoint E 3)
  let e₄₅ : Pseudograph S :=
    singleEdge (sixPairEndpoint E 4) (sixPairEndpoint E 5)
  have hH' : H.IsPart (((B + e₀₁) + e₂₃) + e₄₅) := by
    simpa [B, e₀₁, e₂₃, e₄₅, closeSixCutMatchingWith] using hH
  obtain ⟨use₄₅, H₂₃, hH₂₃, hdeg₄₅⟩ :=
    exists_singleEdgeDecomposition ((B + e₀₁) + e₂₃) H
      (sixPairEndpoint E 4) (sixPairEndpoint E 5) (by
        simpa [e₄₅] using hH')
  obtain ⟨use₂₃, H₀₁, hH₀₁, hdeg₂₃⟩ :=
    exists_singleEdgeDecomposition (B + e₀₁) H₂₃
      (sixPairEndpoint E 2) (sixPairEndpoint E 3) (by
        simpa [e₂₃] using hH₂₃)
  obtain ⟨use₀₁, F, hF, hdeg₀₁⟩ :=
    exists_singleEdgeDecomposition B H₀₁
      (sixPairEndpoint E 0) (sixPairEndpoint E 1) (by
        simpa [e₀₁] using hH₀₁)
  refine ⟨use₀₁, use₂₃, use₄₅, F, hF, ?_⟩
  intro v
  have h₀₁ := hdeg₀₁ v
  have h₂₃ := hdeg₂₃ v
  have h₄₅ := hdeg₄₅ v
  simp only [sixClosingDegree]
  omega

noncomputable def reverseSixCutListing
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) : Fin 6 ≃ CrossingEdge G Sᶜ :=
  E.trans (G.reverseCrossingEdgeEquiv S)

@[simp]
lemma reverseSixCutListing_inside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 6) :
    (reverseSixCutListing E i).inside = (E i).outside :=
  rfl

noncomputable def sixIncidenceInside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : W) : ℕ :=
  (if use₀₁ then
      (if v = (E 0).inside then 1 else 0) +
      (if v = (E 1).inside then 1 else 0)
    else 0) +
  (if use₂₃ then
      (if v = (E 2).inside then 1 else 0) +
      (if v = (E 3).inside then 1 else 0)
    else 0) +
  (if use₄₅ then
      (if v = (E 4).inside then 1 else 0) +
      (if v = (E 5).inside then 1 else 0)
    else 0)

noncomputable def sixIncidenceOutside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : W) : ℕ :=
  (if use₀₁ then
      (if v = (E 0).outside then 1 else 0) +
      (if v = (E 1).outside then 1 else 0)
    else 0) +
  (if use₂₃ then
      (if v = (E 2).outside then 1 else 0) +
      (if v = (E 3).outside then 1 else 0)
    else 0) +
  (if use₄₅ then
      (if v = (E 4).outside then 1 else 0) +
      (if v = (E 5).outside then 1 else 0)
    else 0)

lemma sixClosingDegree_eq_incidence
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : S) :
    sixClosingDegree E use₀₁ use₂₃ use₄₅ v =
      sixIncidenceInside E use₀₁ use₂₃ use₄₅ (v : W) := by
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅ <;>
    simp [sixClosingDegree, sixIncidenceInside, degree_singleEdge,
      sixPairEndpoint, Subtype.ext_iff]

/-- The original labelled cut-edge copies selected by the same three use
bits.  The four-edge cases are expressed as the full crossing part minus
the one omitted labelled pair. -/
noncomputable def sixCrossingSelection
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool) :
    Pseudograph W :=
  match use₀₁, use₂₃, use₄₅ with
  | false, false, false => (G.crossingPart S).sdiff (G.crossingPart S)
  | true, false, false => twoCrossingLabelPart (E 0) (E 1)
  | false, true, false => twoCrossingLabelPart (E 2) (E 3)
  | false, false, true => twoCrossingLabelPart (E 4) (E 5)
  | false, true, true =>
      (G.crossingPart S).sdiff (twoCrossingLabelPart (E 0) (E 1))
  | true, false, true =>
      (G.crossingPart S).sdiff (twoCrossingLabelPart (E 2) (E 3))
  | true, true, false =>
      (G.crossingPart S).sdiff (twoCrossingLabelPart (E 4) (E 5))
  | true, true, true => G.crossingPart S

lemma sixCrossingSelection_isPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool) :
    (sixCrossingSelection E use₀₁ use₂₃ use₄₅).IsPart G := by
  have h01 : E 0 ≠ E 1 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h23 : E 2 ≠ E 3 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h45 : E 4 ≠ E 5 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact (twoCrossingLabelPart_isPart_crossingPart (E 4) (E 5) h45).trans
      (G.crossingPart_isPart S)
  · exact (twoCrossingLabelPart_isPart_crossingPart (E 2) (E 3) h23).trans
      (G.crossingPart_isPart S)
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact (twoCrossingLabelPart_isPart_crossingPart (E 0) (E 1) h01).trans
      (G.crossingPart_isPart S)
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact ((G.crossingPart S).sdiff_isPart_left _).trans
      (G.crossingPart_isPart S)
  · exact G.crossingPart_isPart S

lemma sixCrossingSelection_isPart_crossingPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool) :
    (sixCrossingSelection E use₀₁ use₂₃ use₄₅).IsPart
      (G.crossingPart S) := by
  have h01 : E 0 ≠ E 1 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h23 : E 2 ≠ E 3 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h45 : E 4 ≠ E 5 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅
  · exact (G.crossingPart S).sdiff_isPart_left _
  · exact twoCrossingLabelPart_isPart_crossingPart (E 4) (E 5) h45
  · exact twoCrossingLabelPart_isPart_crossingPart (E 2) (E 3) h23
  · exact (G.crossingPart S).sdiff_isPart_left _
  · exact twoCrossingLabelPart_isPart_crossingPart (E 0) (E 1) h01
  · exact (G.crossingPart S).sdiff_isPart_left _
  · exact (G.crossingPart S).sdiff_isPart_left _
  · exact IsPart.refl _

lemma degree_sixCrossingSelection_of_mem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : W) (hv : v ∈ S) :
    (sixCrossingSelection E use₀₁ use₂₃ use₄₅).degree v =
      sixIncidenceInside E use₀₁ use₂₃ use₄₅ v := by
  classical
  have h01 : E 0 ≠ E 1 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h23 : E 2 ≠ E 3 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h45 : E 4 ≠ E 5 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have hout (i : Fin 6) : v ≠ (E i).outside := by
    intro h
    exact (E i).outside_notMem (h ▸ hv)
  have htotal : G.outsideDegree S v =
      (if v = (E 0).inside then 1 else 0) +
      (if v = (E 1).inside then 1 else 0) +
      (if v = (E 2).inside then 1 else 0) +
      (if v = (E 3).inside then 1 else 0) +
      (if v = (E 4).inside then 1 else 0) +
      (if v = (E 5).inside then 1 else 0) := by
    rw [G.outsideDegree_eq_listingEndpointCount S E v hv,
      listingEndpointCount, Fin.sum_univ_six]
    simp only [eq_comm]
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅
  · have hdiff := (G.crossingPart S).degree_sdiff_add
        (G.crossingPart S) (IsPart.refl _) v
    rw [G.degree_crossingPart_of_mem S v hv] at hdiff
    simp [sixCrossingSelection, sixIncidenceInside] at hdiff ⊢
    omega
  · simp only [sixCrossingSelection]
    rw [degree_twoCrossingLabelPart, sixIncidenceInside]
    simp [sixCrossingSelection, hout]
  · simp only [sixCrossingSelection]
    rw [degree_twoCrossingLabelPart, sixIncidenceInside]
    simp [sixCrossingSelection, hout]
  · have hrem := twoCrossingLabelPart_isPart_crossingPart (E 0) (E 1) h01
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E 0) (E 1)) hrem v
    rw [G.degree_crossingPart_of_mem S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [sixCrossingSelection, sixIncidenceInside, hout] at hdiff ⊢
    omega
  · simp only [sixCrossingSelection]
    rw [degree_twoCrossingLabelPart, sixIncidenceInside]
    simp [sixCrossingSelection, hout]
  · have hrem := twoCrossingLabelPart_isPart_crossingPart (E 2) (E 3) h23
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E 2) (E 3)) hrem v
    rw [G.degree_crossingPart_of_mem S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [sixCrossingSelection, sixIncidenceInside, hout] at hdiff ⊢
    omega
  · have hrem := twoCrossingLabelPart_isPart_crossingPart (E 4) (E 5) h45
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E 4) (E 5)) hrem v
    rw [G.degree_crossingPart_of_mem S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [sixCrossingSelection, sixIncidenceInside, hout] at hdiff ⊢
    omega
  · simp only [sixCrossingSelection]
    rw [G.degree_crossingPart_of_mem S v hv, htotal]
    simp only [sixIncidenceInside, Bool.true_eq, if_true]
    omega

lemma degree_sixCrossingSelection_of_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : W) (hv : v ∉ S) :
    (sixCrossingSelection E use₀₁ use₂₃ use₄₅).degree v =
      sixIncidenceOutside E use₀₁ use₂₃ use₄₅ v := by
  classical
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  have h01 : E 0 ≠ E 1 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h23 : E 2 ≠ E 3 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have h45 : E 4 ≠ E 5 := fun h ↦ by
    have hval := congrArg Fin.val (E.injective h)
    omega
  have hin (i : Fin 6) : v ≠ (E i).inside := by
    intro h
    exact hv (h ▸ (E i).inside_mem)
  have htotal : G.outsideDegree Sᶜ v =
      (if v = (E 0).outside then 1 else 0) +
      (if v = (E 1).outside then 1 else 0) +
      (if v = (E 2).outside then 1 else 0) +
      (if v = (E 3).outside then 1 else 0) +
      (if v = (E 4).outside then 1 else 0) +
      (if v = (E 5).outside then 1 else 0) := by
    rw [G.outsideDegree_eq_listingEndpointCount Sᶜ EC v hvC,
      listingEndpointCount, Fin.sum_univ_six]
    simp only [EC, reverseSixCutListing_inside, eq_comm]
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅
  · have hdiff := (G.crossingPart S).degree_sdiff_add
        (G.crossingPart S) (IsPart.refl _) v
    rw [G.degree_crossingPart_of_notMem S v hv] at hdiff
    simp [sixCrossingSelection, sixIncidenceOutside] at hdiff ⊢
    omega
  · simp only [sixCrossingSelection]
    rw [degree_twoCrossingLabelPart, sixIncidenceOutside]
    simp [sixCrossingSelection, hin]
  · simp only [sixCrossingSelection]
    rw [degree_twoCrossingLabelPart, sixIncidenceOutside]
    simp [sixCrossingSelection, hin]
  · have hrem := twoCrossingLabelPart_isPart_crossingPart (E 0) (E 1) h01
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E 0) (E 1)) hrem v
    rw [G.degree_crossingPart_of_notMem S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [sixCrossingSelection, sixIncidenceOutside, hin] at hdiff ⊢
    omega
  · simp only [sixCrossingSelection]
    rw [degree_twoCrossingLabelPart, sixIncidenceOutside]
    simp [sixCrossingSelection, hin]
  · have hrem := twoCrossingLabelPart_isPart_crossingPart (E 2) (E 3) h23
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E 2) (E 3)) hrem v
    rw [G.degree_crossingPart_of_notMem S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [sixCrossingSelection, sixIncidenceOutside, hin] at hdiff ⊢
    omega
  · have hrem := twoCrossingLabelPart_isPart_crossingPart (E 4) (E 5) h45
    have hdiff := (G.crossingPart S).degree_sdiff_add
      (twoCrossingLabelPart (E 4) (E 5)) hrem v
    rw [G.degree_crossingPart_of_notMem S v hv,
      degree_twoCrossingLabelPart] at hdiff
    simp [sixCrossingSelection, sixIncidenceOutside, hin] at hdiff ⊢
    omega
  · simp only [sixCrossingSelection]
    rw [G.degree_crossingPart_of_notMem S v hv, htotal]
    simp only [sixIncidenceOutside, Bool.true_eq, if_true]
    omega

lemma sixClosingDegree_reverse_eq_outside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : W) (hv : v ∉ S) :
    sixClosingDegree (reverseSixCutListing E) use₀₁ use₂₃ use₄₅
        ⟨v, Finset.mem_compl.mpr hv⟩ =
      sixIncidenceOutside E use₀₁ use₂₃ use₄₅ v := by
  rw [sixClosingDegree_eq_incidence]
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅ <;>
    simp [sixIncidenceInside, sixIncidenceOutside, reverseSixCutListing,
      reverseCrossingEdgeEquiv, reverseCrossingEdge]
  all_goals rfl

/-- Splice the genuine parts of two aligned six-cut matching closures and
restore exactly the original labelled cut-edge pairs selected by their
common use bits. -/
noncomputable def spliceSixCutMatchings
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (F : Pseudograph S) (L : Pseudograph ↑(Sᶜ)) : Pseudograph W :=
  extendFrom S F + extendFrom Sᶜ L +
    sixCrossingSelection E use₀₁ use₂₃ use₄₅

lemma degree_spliceSixCutMatchings_of_mem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (H : Pseudograph S) (use₀₁ use₂₃ use₄₅ : Bool)
    (F : Pseudograph S)
    (hdec : SixClosureDecomposition E H use₀₁ use₂₃ use₄₅ F)
    (L : Pseudograph ↑(Sᶜ)) (v : W) (hv : v ∈ S) :
    (spliceSixCutMatchings E use₀₁ use₂₃ use₄₅ F L).degree v =
      H.degree ⟨v, hv⟩ := by
  have hvC : v ∉ Sᶜ := by simp [hv]
  rw [spliceSixCutMatchings, degree_add, degree_add,
    degree_extendFrom_of_mem S F v hv,
    degree_extendFrom_of_notMem Sᶜ L v hvC,
    degree_sixCrossingSelection_of_mem E use₀₁ use₂₃ use₄₅ v hv,
    Nat.add_zero]
  have hinc : sixClosingDegree E use₀₁ use₂₃ use₄₅ ⟨v, hv⟩ =
      sixIncidenceInside E use₀₁ use₂₃ use₄₅ v := by
    exact sixClosingDegree_eq_incidence E use₀₁ use₂₃ use₄₅ ⟨v, hv⟩
  rw [← hinc]
  exact hdec.2 ⟨v, hv⟩

lemma degree_spliceSixCutMatchings_of_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (K : Pseudograph ↑(Sᶜ)) (use₀₁ use₂₃ use₄₅ : Bool)
    (L : Pseudograph ↑(Sᶜ))
    (hdec : SixClosureDecomposition (reverseSixCutListing E) K
      use₀₁ use₂₃ use₄₅ L)
    (F : Pseudograph S) (v : W) (hv : v ∉ S) :
    (spliceSixCutMatchings E use₀₁ use₂₃ use₄₅ F L).degree v =
      K.degree ⟨v, Finset.mem_compl.mpr hv⟩ := by
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  rw [spliceSixCutMatchings, degree_add, degree_add,
    degree_extendFrom_of_notMem S F v hv,
    degree_extendFrom_of_mem Sᶜ L v hvC,
    degree_sixCrossingSelection_of_notMem E use₀₁ use₂₃ use₄₅ v hv,
    Nat.zero_add]
  rw [← sixClosingDegree_reverse_eq_outside
    E use₀₁ use₂₃ use₄₅ v hv]
  exact hdec.2 ⟨v, hvC⟩

lemma spliceSixCutMatchings_isPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (F : Pseudograph S) (L : Pseudograph ↑(Sᶜ))
    (hF : F.IsPart (G.induce S)) (hL : L.IsPart (G.induce Sᶜ)) :
    (spliceSixCutMatchings E use₀₁ use₂₃ use₄₅ F L).IsPart G := by
  classical
  have hcross := sixCrossingSelection_isPart E use₀₁ use₂₃ use₄₅
  have hcrossing :=
    sixCrossingSelection_isPart_crossingPart E use₀₁ use₂₃ use₄₅
  intro u v
  by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∉ Sᶜ := by simp [hv]
    have hsel : (sixCrossingSelection E use₀₁ use₂₃ use₄₅).mult u v = 0 := by
      have hle := hcrossing u v
      have hcrossZero : (G.crossingPart S).mult u v = 0 := by
        simp [crossingPart, hu, hv]
      omega
    simpa [spliceSixCutMatchings, extendFrom, hu, hv, huC, hvC, hsel] using
      hF ⟨u, hu⟩ ⟨v, hv⟩
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    simpa [spliceSixCutMatchings, extendFrom, hu, hv, huC, hvC] using
      hcross u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∉ Sᶜ := by simp [hv]
    simpa [spliceSixCutMatchings, extendFrom, hu, hv, huC, hvC] using
      hcross u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    have hsel : (sixCrossingSelection E use₀₁ use₂₃ use₄₅).mult u v = 0 := by
      have hle := hcrossing u v
      have hcrossZero : (G.crossingPart S).mult u v = 0 := by
        simp [crossingPart, hu, hv]
      omega
    simpa [spliceSixCutMatchings, extendFrom, hu, hv, huC, hvC, hsel] using
      hL ⟨u, huC⟩ ⟨v, hvC⟩

/-- The canonical matching closure on the complementary shore, with the
same six original cut-edge labels reversed. -/
noncomputable def oppositeSixCutMatchingClosure
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 6) : Pseudograph ↑(Sᶜ) :=
  G.closeSixCutMatchingWith Sᶜ
    (reverseSixCutListing (G.cutEquiv S hcut).symm)

/-- Six-cut matching gluing: local witnesses for every nonzero artificial
use pattern splice against an arbitrary cubic part on the oppositely
oriented matching closure. -/
theorem containsRegularPart_of_sixCutMatchingClosures
    (G : Pseudograph W) (S : Finset W)
    (hcut : G.boundaryMultiplicity S = 6)
    (hS : ∀ use₀₁ use₂₃ use₄₅ : Bool,
      use₀₁ = true ∨ use₂₃ = true ∨ use₄₅ = true →
      ∃ H F : Pseudograph S,
        H.IsPart (G.closeSixCutMatchingWith S (G.cutEquiv S hcut).symm) ∧
        (∃ v, H.degree v = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        SixClosureDecomposition (G.cutEquiv S hcut).symm H
          use₀₁ use₂₃ use₄₅ F)
    (hC : (G.oppositeSixCutMatchingClosure S hcut).ContainsRegularPart 3) :
    G.ContainsRegularPart 3 := by
  classical
  let E : Fin 6 ≃ CrossingEdge G S := (G.cutEquiv S hcut).symm
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  obtain ⟨K, hKpart, hKne, hKdeg⟩ := hC
  obtain ⟨use₀₁, use₂₃, use₄₅, L, hKdec⟩ :=
    exists_sixClosureDecomposition EC K (by
      simpa [EC, E, oppositeSixCutMatchingClosure] using hKpart)
  by_cases hzero : use₀₁ = false ∧ use₂₃ = false ∧ use₄₅ = false
  · have hLdeg (v : ↑(Sᶜ)) : L.degree v = K.degree v := by
      have h := hKdec.2 v
      simp [sixClosingDegree, hzero.1, hzero.2.1, hzero.2.2] at h
      exact h
    refine ⟨extendFrom Sᶜ L, extendFrom_isPart hKdec.1, ?_, ?_⟩
    · obtain ⟨v, hv⟩ := hKne
      refine ⟨v, ?_⟩
      rw [degree_extendFrom_of_mem Sᶜ L v v.2, hLdeg]
      exact hv
    · intro v
      by_cases hv : v ∈ Sᶜ
      · rw [degree_extendFrom_of_mem Sᶜ L v hv, hLdeg]
        exact hKdeg ⟨v, hv⟩
      · exact .inl (degree_extendFrom_of_notMem Sᶜ L v hv)
  · have hnonzero : use₀₁ = true ∨ use₂₃ = true ∨ use₄₅ = true := by
      cases use₀₁ <;> cases use₂₃ <;> cases use₄₅ <;> simp_all
    obtain ⟨H, F, hHpart, hHne, hHdeg, hHdec⟩ :=
      hS use₀₁ use₂₃ use₄₅ hnonzero
    let Q := spliceSixCutMatchings E use₀₁ use₂₃ use₄₅ F L
    have hQpart : Q.IsPart G :=
      spliceSixCutMatchings_isPart E use₀₁ use₂₃ use₄₅ F L
        hHdec.1 hKdec.1
    have hQdeg (v : W) : Q.degree v = 0 ∨ Q.degree v = 3 := by
      by_cases hv : v ∈ S
      · rw [show Q.degree v = H.degree ⟨v, hv⟩ by
          exact degree_spliceSixCutMatchings_of_mem
            E H use₀₁ use₂₃ use₄₅ F hHdec L v hv]
        exact hHdeg ⟨v, hv⟩
      · rw [show Q.degree v = K.degree ⟨v, Finset.mem_compl.mpr hv⟩ by
          exact degree_spliceSixCutMatchings_of_notMem
            E K use₀₁ use₂₃ use₄₅ L hKdec F v hv]
        exact hKdeg ⟨v, Finset.mem_compl.mpr hv⟩
    obtain ⟨v, hv⟩ := hHne
    refine ⟨Q, hQpart, ⟨v, ?_⟩, hQdeg⟩
    rw [show Q.degree v = H.degree v by
      exact degree_spliceSixCutMatchings_of_mem
        E H use₀₁ use₂₃ use₄₅ F hHdec L v v.2]
    exact hv

/-- Labelled form of six-cut matching gluing.  Unlike the canonical wrapper
above, this theorem accepts any listing of the six cut-edge copies; this is
needed when the three pairs are chosen to control loops and parallel edges
on the opposite shore. -/
theorem containsRegularPart_of_sixCutMatchingClosuresWith
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (hS : ∀ use₀₁ use₂₃ use₄₅ : Bool,
      use₀₁ = true ∨ use₂₃ = true ∨ use₄₅ = true →
      ∃ H F : Pseudograph S,
        H.IsPart (G.closeSixCutMatchingWith S E) ∧
        (∃ v, H.degree v = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        SixClosureDecomposition E H use₀₁ use₂₃ use₄₅ F)
    (hC : (G.closeSixCutMatchingWith Sᶜ
      (reverseSixCutListing E)).ContainsRegularPart 3) :
    G.ContainsRegularPart 3 := by
  classical
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  obtain ⟨K, hKpart, hKne, hKdeg⟩ := hC
  obtain ⟨use₀₁, use₂₃, use₄₅, L, hKdec⟩ :=
    exists_sixClosureDecomposition EC K (by simpa [EC] using hKpart)
  by_cases hzero : use₀₁ = false ∧ use₂₃ = false ∧ use₄₅ = false
  · have hLdeg (v : ↑(Sᶜ)) : L.degree v = K.degree v := by
      have h := hKdec.2 v
      simp [sixClosingDegree, hzero.1, hzero.2.1, hzero.2.2] at h
      exact h
    refine ⟨extendFrom Sᶜ L, extendFrom_isPart hKdec.1, ?_, ?_⟩
    · obtain ⟨v, hv⟩ := hKne
      refine ⟨v, ?_⟩
      rw [degree_extendFrom_of_mem Sᶜ L v v.2, hLdeg]
      exact hv
    · intro v
      by_cases hv : v ∈ Sᶜ
      · rw [degree_extendFrom_of_mem Sᶜ L v hv, hLdeg]
        exact hKdeg ⟨v, hv⟩
      · exact .inl (degree_extendFrom_of_notMem Sᶜ L v hv)
  · have hnonzero : use₀₁ = true ∨ use₂₃ = true ∨ use₄₅ = true := by
      cases use₀₁ <;> cases use₂₃ <;> cases use₄₅ <;> simp_all
    obtain ⟨H, F, hHpart, hHne, hHdeg, hHdec⟩ :=
      hS use₀₁ use₂₃ use₄₅ hnonzero
    let Q := spliceSixCutMatchings E use₀₁ use₂₃ use₄₅ F L
    have hQpart : Q.IsPart G :=
      spliceSixCutMatchings_isPart E use₀₁ use₂₃ use₄₅ F L
        hHdec.1 hKdec.1
    have hQdeg (v : W) : Q.degree v = 0 ∨ Q.degree v = 3 := by
      by_cases hv : v ∈ S
      · rw [show Q.degree v = H.degree ⟨v, hv⟩ by
          exact degree_spliceSixCutMatchings_of_mem
            E H use₀₁ use₂₃ use₄₅ F hHdec L v hv]
        exact hHdeg ⟨v, hv⟩
      · rw [show Q.degree v = K.degree ⟨v, Finset.mem_compl.mpr hv⟩ by
          exact degree_spliceSixCutMatchings_of_notMem
            E K use₀₁ use₂₃ use₄₅ L hKdec F v hv]
        exact hKdeg ⟨v, Finset.mem_compl.mpr hv⟩
    obtain ⟨v, hv⟩ := hHne
    refine ⟨Q, hQpart, ⟨v, ?_⟩, hQdeg⟩
    rw [show Q.degree v = H.degree v by
      exact degree_spliceSixCutMatchings_of_mem
        E H use₀₁ use₂₃ use₄₅ F hHdec L v v.2]
    exact hv

/-! ### Edge-labelled bipartite pseudographs

The line-colouring step in Proposition 3.6 must distinguish an artificial
closing edge from an original edge parallel to it.  The following oriented
copy type exposes precisely that label information. -/

/-- A genuine bipartition of every vertex of a pseudograph.  The last field
is stated for positive multiplicity, so it also covers parallel copies. -/
structure IsBipartiteWith (P : Pseudograph W) (A B : Finset W) : Prop where
  disjoint : Disjoint A B
  cover : A ∪ B = Finset.univ
  crosses : ∀ {u v}, 0 < P.mult u v →
    (u ∈ A ∧ v ∈ B) ∨ (u ∈ B ∧ v ∈ A)

/-- Labelled copies of edges, oriented from the first side of a fixed
bipartition to the second. -/
abbrev BipartiteEdge (P : Pseudograph W) (A B : Finset W) :=
  Σ a : A, Σ b : B, Fin (P.mult a b)

lemma bipartiteEdge_eq_of_endpoints_of_mult_eq_one
    {P : Pseudograph W} {A B : Finset W}
    (e f : BipartiteEdge P A B)
    (hleft : (e.1 : W) = (f.1 : W))
    (hright : (e.2.1 : W) = (f.2.1 : W))
    (hmult : P.mult e.1 e.2.1 = 1) : e = f := by
  rcases e with ⟨a, b, i⟩
  rcases f with ⟨a', b', j⟩
  have haa : a = a' := Subtype.ext hleft
  subst a'
  have hbb : b = b' := Subtype.ext hright
  subst b'
  change P.mult (a : W) (b : W) = 1 at hmult
  have hij : i = j := by
    apply Fin.ext
    have hi := i.isLt
    have hj := j.isLt
    omega
  subst j
  rfl

noncomputable def bipartiteMultigraph (P : Pseudograph W)
    (A B : Finset W) :
    Erdos182.BipartiteMultigraph A B (BipartiteEdge P A B) where
  left e := e.1
  right e := e.2.1

lemma IsBipartiteWith.mem_right_of_not_mem_left
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) {v : W} (hv : v ∉ A) : v ∈ B := by
  have hvU : v ∈ A ∪ B := by rw [h.cover]; simp
  simpa [hv] using hvU

lemma IsBipartiteWith.mem_left_of_not_mem_right
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) {v : W} (hv : v ∉ B) : v ∈ A := by
  have hvU : v ∈ A ∪ B := by rw [h.cover]; simp
  simpa [hv] using hvU

lemma IsBipartiteWith.mult_eq_zero_of_mem_left
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) {u v : W}
    (hu : u ∈ A) (hv : v ∈ A) : P.mult u v = 0 := by
  by_contra hne
  rcases h.crosses (Nat.pos_of_ne_zero hne) with huv | huv
  · exact (Finset.disjoint_left.mp h.disjoint) hv huv.2
  · exact (Finset.disjoint_left.mp h.disjoint) hu huv.1

lemma IsBipartiteWith.mult_eq_zero_of_mem_right
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) {u v : W}
    (hu : u ∈ B) (hv : v ∈ B) : P.mult u v = 0 := by
  by_contra hne
  rcases h.crosses (Nat.pos_of_ne_zero hne) with huv | huv
  · exact (Finset.disjoint_left.mp h.disjoint) huv.1 hu
  · exact (Finset.disjoint_left.mp h.disjoint) huv.2 hv

lemma IsBipartiteWith.loopless
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) (v : W) : P.mult v v = 0 := by
  by_cases hv : v ∈ A
  · exact h.mult_eq_zero_of_mem_left hv hv
  · have hvB := h.mem_right_of_not_mem_left hv
    exact h.mult_eq_zero_of_mem_right hvB hvB

lemma IsBipartiteWith.degree_eq_sum_right
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) (a : A) :
    P.degree a = ∑ b : B, P.mult a b := by
  classical
  rw [degree_eq_mult_self_add_sum, h.loopless, Nat.zero_add]
  calc
    ∑ w : W, P.mult a w = ∑ w ∈ B, P.mult a w := by
      symm
      apply Finset.sum_subset (Finset.subset_univ B)
      intro v _ hvB
      have hvA := h.mem_left_of_not_mem_right hvB
      exact h.mult_eq_zero_of_mem_left a.2 hvA
    _ = ∑ b : B, P.mult a b :=
      Finset.sum_subtype B (fun _ ↦ Iff.rfl) (fun w ↦ P.mult a w)

lemma IsBipartiteWith.degree_eq_sum_left
    {P : Pseudograph W} {A B : Finset W}
    (h : P.IsBipartiteWith A B) (b : B) :
    P.degree b = ∑ a : A, P.mult a b := by
  classical
  rw [degree_eq_mult_self_add_sum, h.loopless, Nat.zero_add]
  calc
    ∑ w : W, P.mult b w = ∑ w ∈ A, P.mult b w := by
      symm
      apply Finset.sum_subset (Finset.subset_univ A)
      intro v _ hvA
      have hvB := h.mem_right_of_not_mem_left hvA
      exact h.mult_eq_zero_of_mem_right b.2 hvB
    _ = ∑ a : A, P.mult a b := by
      rw [Finset.sum_subtype A (fun _ ↦ Iff.rfl) (fun w ↦ P.mult b w)]
      apply Finset.sum_congr rfl
      intro a _
      exact P.mult_comm _ _

private noncomputable def bipartiteLeftFiberEquiv
    (P : Pseudograph W) (A B : Finset W) (a : A) :
    {e : BipartiteEdge P A B //
      (P.bipartiteMultigraph A B).left e = a} ≃
      Σ b : B, Fin (P.mult a b) where
  toFun e := by
    rcases e with ⟨⟨a', b, i⟩, ha⟩
    change a' = a at ha
    subst a'
    exact ⟨b, i⟩
  invFun e := ⟨⟨a, e.1, e.2⟩, rfl⟩
  left_inv e := by
    apply Subtype.ext
    cases e with
    | mk e he =>
      cases e with
      | mk a' e =>
        cases e with
        | mk b i =>
          cases he
          rfl
  right_inv e := by rfl

private noncomputable def bipartiteRightFiberEquiv
    (P : Pseudograph W) (A B : Finset W) (b : B) :
    {e : BipartiteEdge P A B //
      (P.bipartiteMultigraph A B).right e = b} ≃
      Σ a : A, Fin (P.mult a b) where
  toFun e := by
    rcases e with ⟨⟨a, b', i⟩, hb⟩
    change b' = b at hb
    subst b'
    exact ⟨a, i⟩
  invFun e := ⟨⟨e.1, b, e.2⟩, rfl⟩
  left_inv e := by
    apply Subtype.ext
    cases e with
    | mk e he =>
      cases e with
      | mk a e =>
        cases e with
        | mk b' i =>
          cases he
          rfl
  right_inv e := by rfl

lemma bipartiteMultigraph_isRegular
    {P : Pseudograph W} {A B : Finset W}
    (hreg : P.IsRegularOfDegree 4) (hbip : P.IsBipartiteWith A B) :
    (P.bipartiteMultigraph A B).IsRegular 4 := by
  classical
  constructor
  · intro a
    letI : DecidablePred (fun e : BipartiteEdge P A B ↦
        (P.bipartiteMultigraph A B).left e = a) :=
      fun _ ↦ Classical.propDecidable _
    rw [← Nat.card_eq_fintype_card]
    calc
      Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).left e = a} =
          Nat.card (Σ b : B, Fin (P.mult a b)) :=
        Nat.card_congr (bipartiteLeftFiberEquiv P A B a)
      _ = Fintype.card (Σ b : B, Fin (P.mult a b)) :=
        Nat.card_eq_fintype_card
      _ = ∑ b : B, P.mult a b := by
        rw [Fintype.card_sigma]
        simp
      _ = P.degree a := (hbip.degree_eq_sum_right a).symm
      _ = 4 := hreg a
  · intro b
    letI : DecidablePred (fun e : BipartiteEdge P A B ↦
        (P.bipartiteMultigraph A B).right e = b) :=
      fun _ ↦ Classical.propDecidable _
    rw [← Nat.card_eq_fintype_card]
    calc
      Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).right e = b} =
          Nat.card (Σ a : A, Fin (P.mult a b)) :=
        Nat.card_congr (bipartiteRightFiberEquiv P A B b)
      _ = Fintype.card (Σ a : A, Fin (P.mult a b)) :=
        Nat.card_eq_fintype_card
      _ = ∑ a : A, P.mult a b := by
        rw [Fintype.card_sigma]
        simp
      _ = P.degree b := (hbip.degree_eq_sum_left b).symm
      _ = 4 := hreg b

/-- The spanning simple matching consisting of the copies carrying one
fixed colour.  Although the result forgets parallel-copy labels, the
definition below still lets us ask whether a particular labelled copy has
the selected colour. -/
noncomputable def colorClassSubgraph
    {P : Pseudograph W} {A B : Finset W}
    (hbip : P.IsBipartiteWith A B)
    (C : (P.bipartiteMultigraph A B).ProperColoring 4) (c : Fin 4) :
    P.toSimple.Subgraph where
  verts := Set.univ
  Adj u v := ∃ e : BipartiteEdge P A B, C.color e = c ∧
    (((e.1 : W) = u ∧ (e.2.1 : W) = v) ∨
      ((e.1 : W) = v ∧ (e.2.1 : W) = u))
  adj_sub := by
    rintro u v ⟨e, _hec, huv | huv⟩
    · rcases huv with ⟨rfl, rfl⟩
      exact ⟨fun h ↦ (Finset.disjoint_left.mp hbip.disjoint)
          e.1.2 (h ▸ e.2.1.2),
        Nat.zero_lt_of_lt e.2.2.isLt⟩
    · rcases huv with ⟨rfl, rfl⟩
      exact ⟨fun h ↦ (Finset.disjoint_left.mp hbip.disjoint)
          e.1.2 (h.symm ▸ e.2.1.2),
        by simpa only [P.mult_comm] using Nat.zero_lt_of_lt e.2.2.isLt⟩
  edge_vert := by simp
  symm := ⟨by
    rintro u v ⟨e, hec, huv⟩
    exact ⟨e, hec, huv.symm⟩⟩

lemma colorClassSubgraph_adj_iff
    {P : Pseudograph W} {A B : Finset W}
    (hbip : P.IsBipartiteWith A B)
    (C : (P.bipartiteMultigraph A B).ProperColoring 4) (c : Fin 4)
    (u v : W) :
    (colorClassSubgraph hbip C c).Adj u v ↔
      ∃ e : BipartiteEdge P A B, C.color e = c ∧
        (((e.1 : W) = u ∧ (e.2.1 : W) = v) ∨
          ((e.1 : W) = v ∧ (e.2.1 : W) = u)) :=
  Iff.rfl

private lemma exists_left_color_of_properColoring
    {P : Pseudograph W} {A B : Finset W}
    (hreg : (P.bipartiteMultigraph A B).IsRegular 4)
    (C : (P.bipartiteMultigraph A B).ProperColoring 4)
    (a : A) (c : Fin 4) :
    ∃ e : BipartiteEdge P A B,
      (P.bipartiteMultigraph A B).left e = a ∧ C.color e = c := by
  classical
  letI : DecidablePred (fun e : BipartiteEdge P A B ↦
      (P.bipartiteMultigraph A B).left e = a) :=
    fun _ ↦ Classical.propDecidable _
  let T := {e : BipartiteEdge P A B //
    (P.bipartiteMultigraph A B).left e = a}
  let f : T → Fin 4 := fun e ↦ C.color e.1
  have hf : Function.Injective f := C.left_injective a
  have hcard : Fintype.card T = Fintype.card (Fin 4) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    calc
      Nat.card T = Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).left e = a} := by rfl
      _ = 4 := by
        rw [Nat.card_eq_fintype_card]
        exact hreg.1 a
      _ = Nat.card (Fin 4) := by simp
  have hsurj : Function.Surjective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hf, hcard⟩ |>.2
  obtain ⟨e, he⟩ := hsurj c
  exact ⟨e.1, e.2, he⟩

private lemma exists_right_color_of_properColoring
    {P : Pseudograph W} {A B : Finset W}
    (hreg : (P.bipartiteMultigraph A B).IsRegular 4)
    (C : (P.bipartiteMultigraph A B).ProperColoring 4)
    (b : B) (c : Fin 4) :
    ∃ e : BipartiteEdge P A B,
      (P.bipartiteMultigraph A B).right e = b ∧ C.color e = c := by
  classical
  letI : DecidablePred (fun e : BipartiteEdge P A B ↦
      (P.bipartiteMultigraph A B).right e = b) :=
    fun _ ↦ Classical.propDecidable _
  let T := {e : BipartiteEdge P A B //
    (P.bipartiteMultigraph A B).right e = b}
  let f : T → Fin 4 := fun e ↦ C.color e.1
  have hf : Function.Injective f := C.right_injective b
  have hcard : Fintype.card T = Fintype.card (Fin 4) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    calc
      Nat.card T = Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).right e = b} := by rfl
      _ = 4 := by
        rw [Nat.card_eq_fintype_card]
        exact hreg.2 b
      _ = Nat.card (Fin 4) := by simp
  have hsurj : Function.Surjective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hf, hcard⟩ |>.2
  obtain ⟨e, he⟩ := hsurj c
  exact ⟨e.1, e.2, he⟩

lemma colorClassSubgraph_isPerfectMatching
    {P : Pseudograph W} {A B : Finset W}
    (hreg : P.IsRegularOfDegree 4) (hbip : P.IsBipartiteWith A B)
    (C : (P.bipartiteMultigraph A B).ProperColoring 4) (c : Fin 4) :
    (colorClassSubgraph hbip C c).IsPerfectMatching := by
  classical
  rw [SimpleGraph.Subgraph.isPerfectMatching_iff]
  let Q := P.bipartiteMultigraph A B
  have hQreg : Q.IsRegular 4 := bipartiteMultigraph_isRegular hreg hbip
  intro v
  by_cases hvA : v ∈ A
  · let a : A := ⟨v, hvA⟩
    obtain ⟨e, hea, hec⟩ :=
      exists_left_color_of_properColoring hQreg C a c
    let w : W := e.2.1
    refine ⟨w, ?_, ?_⟩
    · apply (colorClassSubgraph_adj_iff hbip C c v w).2
      refine ⟨e, hec, .inl ⟨?_, rfl⟩⟩
      exact congrArg Subtype.val hea
    · intro w' hw'
      obtain ⟨e', he'c, hdir | hdir⟩ :=
        (colorClassSubgraph_adj_iff hbip C c v w').1 hw'
      · have he'a : Q.left e' = a := by
          apply Subtype.ext
          exact hdir.1
        have hsub : (⟨e', he'a⟩ : {x // Q.left x = a}) = ⟨e, hea⟩ :=
          C.left_injective a
            (a₁ := ⟨e', he'a⟩) (a₂ := ⟨e, hea⟩)
            (he'c.trans hec.symm)
        have heq : e' = e := congrArg Subtype.val hsub
        subst e'
        exact hdir.2.symm
      · have hevB : v ∈ B := by
          rw [← hdir.2]
          exact e'.2.1.2
        exact False.elim ((Finset.disjoint_left.mp hbip.disjoint) hvA hevB)
  · have hvB : v ∈ B := hbip.mem_right_of_not_mem_left hvA
    let b : B := ⟨v, hvB⟩
    obtain ⟨e, heb, hec⟩ :=
      exists_right_color_of_properColoring hQreg C b c
    let w : W := e.1
    refine ⟨w, ?_, ?_⟩
    · apply (colorClassSubgraph_adj_iff hbip C c v w).2
      refine ⟨e, hec, .inr ⟨rfl, ?_⟩⟩
      exact congrArg Subtype.val heb
    · intro w' hw'
      obtain ⟨e', he'c, hdir | hdir⟩ :=
        (colorClassSubgraph_adj_iff hbip C c v w').1 hw'
      · have hevA : v ∈ A := by
          rw [← hdir.1]
          exact e'.1.2
        exact False.elim ((Finset.disjoint_left.mp hbip.disjoint) hevA hvB)
      · have he'b : Q.right e' = b := by
          apply Subtype.ext
          exact hdir.2
        have hsub : (⟨e', he'b⟩ : {x // Q.right x = b}) = ⟨e, heb⟩ :=
          C.right_injective b
            (a₁ := ⟨e', he'b⟩) (a₂ := ⟨e, heb⟩)
            (he'c.trans hec.symm)
        have heq : e' = e := congrArg Subtype.val hsub
        subst e'
        exact hdir.1.symm

/-- Kőnig's line-colouring theorem, returned in the pseudograph language:
every nonempty quartic bipartite pseudograph has a spanning cubic part. -/
theorem containsRegularPart_of_isBipartiteWith [Nonempty W]
    (P : Pseudograph W) (hreg : P.IsRegularOfDegree 4)
    (A B : Finset W) (hbip : P.IsBipartiteWith A B) :
    P.ContainsRegularPart 3 := by
  let Q := P.bipartiteMultigraph A B
  have hQreg : Q.IsRegular 4 := bipartiteMultigraph_isRegular hreg hbip
  obtain ⟨C⟩ := Erdos182.BipartiteMultigraph.exists_properColoring Q hQreg
  let M := colorClassSubgraph hbip C (0 : Fin 4)
  have hM : M.IsPerfectMatching :=
    colorClassSubgraph_isPerfectMatching hreg hbip C 0
  exact containsRegularPart_of_isPerfectMatching P hreg M hM

/-- A hereditary ambient-colouring formulation of bipartiteness on a
finite shore.  It is definitionally convenient when deleting a boundary
vertex in the minimal-shore argument. -/
def IsBipartiteOn (G : SimpleGraph W) (S : Finset W) : Prop :=
  ∃ c : W → Fin 2, ∀ {u v}, u ∈ S → v ∈ S → G.Adj u v → c u ≠ c v

lemma IsBipartiteOn.mono {G : SimpleGraph W} {S T : Finset W}
    (h : IsBipartiteOn G S) (hTS : T ⊆ S) : IsBipartiteOn G T := by
  obtain ⟨c, hc⟩ := h
  exact ⟨c, fun hu hv huv ↦ hc (hTS hu) (hTS hv) huv⟩

lemma isBipartiteOn_iff_induce_isBipartite
    (G : SimpleGraph W) (S : Finset W) :
    IsBipartiteOn G S ↔ (G.induce (S : Set W)).IsBipartite := by
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨fun v ↦ c v, ?_⟩
    intro u v huv
    exact hc u.2 v.2 huv
  · rintro ⟨c, hc⟩
    classical
    let d : W → Fin 2 := fun v ↦ if hv : v ∈ S then c ⟨v, hv⟩ else 0
    refine ⟨d, ?_⟩
    intro u v hu hv huv
    simpa [d, hu, hv] using hc (show (G.induce (S : Set W)).Adj
      ⟨u, by simpa using hu⟩ ⟨v, by simpa using hv⟩ from huv)

/-- The four incidences at a vertex of a quartic shore split into its
internal neighbours and its cut incidences. -/
lemma between_erase_add_outsideDegree_eq_four
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (v : W) (hv : v ∈ S) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} (S.erase v) +
      (Pseudograph.ofSimple G).outsideDegree S v = 4 := by
  classical
  let P := Pseudograph.ofSimple G
  have hsplit := P.boundaryMultiplicity_eq_between_add_between
    {v} (S.erase v) Sᶜ (by
      rw [Finset.disjoint_left]
      intro x hx hxc
      exact (Finset.mem_compl.mp hxc) (Finset.mem_of_mem_erase hx)) (by
        ext x
        by_cases hxv : x = v
        · subst x
          simp [hv]
        · by_cases hxS : x ∈ S <;> simp [hxv, hxS])
  have hout : P.betweenMultiplicity {v} Sᶜ = P.outsideDegree S v := by
    rw [P.betweenMultiplicity_singleton v Sᶜ (by simpa using hv)]
    rfl
  have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg v
  rw [hsingle, hout] at hsplit
  exact hsplit.symm

/-- Removing one vertex from a shore gives the exact cut-toggle equation
used in the endpoint-distinctness part of Proposition 3.6. -/
lemma erase_vertex_cut_equation
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (v : W) (hv : v ∈ S) :
    (Pseudograph.ofSimple G).boundaryMultiplicity S +
        2 * (Pseudograph.ofSimple G).betweenMultiplicity (S.erase v) {v} =
      (Pseudograph.ofSimple G).boundaryMultiplicity (S.erase v) + 4 := by
  classical
  let P := Pseudograph.ofSimple G
  have hdis : Disjoint (S.erase v) {v} := by simp
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
    (S.erase v) {v} hdis
  have hunion : S.erase v ∪ {v} = S := by
    ext x
    by_cases hx : x = v <;> simp [hx, hv]
  have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg v
  rw [hunion, hsingle] at htoggle
  exact htoggle

lemma exists_isBipartiteWith_of_toSimple_isBipartite
    (P : Pseudograph W) (hloop : ∀ v, P.mult v v = 0)
    (hbip : P.toSimple.IsBipartite) :
    ∃ A B : Finset W, P.IsBipartiteWith A B := by
  classical
  obtain ⟨c, hc⟩ := hbip
  have fin2_cases (i : Fin 2) : i = 0 ∨ i = 1 := by
    refine Fin.cases (.inl rfl) ?_ i
    intro j
    refine Fin.cases (.inr rfl) ?_ j
    exact fun k ↦ Fin.elim0 k
  let A : Finset W := Finset.univ.filter fun v ↦ c v = 0
  let B : Finset W := Finset.univ.filter fun v ↦ c v = 1
  refine ⟨A, B, ?_, ?_, ?_⟩
  · rw [Finset.disjoint_left]
    intro v hvA hvB
    simp only [A, B, Finset.mem_filter, Finset.mem_univ, true_and] at hvA hvB
    omega
  · ext v
    simp only [A, B, Finset.mem_union, Finset.mem_filter,
      Finset.mem_univ, true_and]
    rcases fin2_cases (c v) with h | h <;> simp [h]
  · intro u v huv
    have huvne : u ≠ v := by
      intro h
      subst v
      rw [hloop u] at huv
      omega
    have hadj : P.toSimple.Adj u v := ⟨huvne, huv⟩
    have hcolor : c u ≠ c v := hc hadj
    simp only [A, B, Finset.mem_filter, Finset.mem_univ, true_and]
    rcases fin2_cases (c u) with hu | hu <;>
      rcases fin2_cases (c v) with hv | hv <;> simp_all

lemma IsBipartiteWith.add_singleEdge
    {P : Pseudograph W} {A B : Finset W}
    (hbip : P.IsBipartiteWith A B) {a b : W}
    (hab : (a ∈ A ∧ b ∈ B) ∨ (a ∈ B ∧ b ∈ A)) :
    (P + singleEdge a b).IsBipartiteWith A B := by
  refine ⟨hbip.disjoint, hbip.cover, ?_⟩
  intro u v huv
  simp only [add_mult] at huv
  by_cases hP : 0 < P.mult u v
  · exact hbip.crosses hP
  · have hedge : 0 < (singleEdge a b).mult u v := by omega
    simp only [singleEdge_mult] at hedge
    split at hedge <;> rename_i h
    · rcases h with h | h
      · rcases h with ⟨rfl, rfl⟩
        exact hab
      · rcases h with ⟨rfl, rfl⟩
        rcases hab with hab | hab
        · exact .inr ⟨hab.2, hab.1⟩
        · exact .inl ⟨hab.2, hab.1⟩
    · omega

lemma closeSixCutMatchingWith_isBipartiteWith
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (h01 : (sixPairEndpoint E 0 ∈ A ∧ sixPairEndpoint E 1 ∈ B) ∨
      (sixPairEndpoint E 0 ∈ B ∧ sixPairEndpoint E 1 ∈ A))
    (h23 : (sixPairEndpoint E 2 ∈ A ∧ sixPairEndpoint E 3 ∈ B) ∨
      (sixPairEndpoint E 2 ∈ B ∧ sixPairEndpoint E 3 ∈ A))
    (h45 : (sixPairEndpoint E 4 ∈ A ∧ sixPairEndpoint E 5 ∈ B) ∨
      (sixPairEndpoint E 4 ∈ B ∧ sixPairEndpoint E 5 ∈ A)) :
    (G.closeSixCutMatchingWith S E).IsBipartiteWith A B := by
  exact ((hbip.add_singleEdge h01).add_singleEdge h23).add_singleEdge h45

lemma closeSixCutMatchingWith_mult_pair01
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    (G.closeSixCutMatchingWith S E).mult
        (sixPairEndpoint E 0) (sixPairEndpoint E 1) =
      (G.induce S).mult (sixPairEndpoint E 0) (sixPairEndpoint E 1) + 1 := by
  have hne (i j : Fin 6) (hij : i ≠ j) :
      sixPairEndpoint E i ≠ sixPairEndpoint E j := fun h ↦ hij (hinj h)
  simp [closeSixCutMatchingWith, singleEdge_mult,
    hne 0 1 (by decide), hne 0 2 (by decide), hne 0 3 (by decide),
    hne 0 4 (by decide), hne 0 5 (by decide), hne 1 2 (by decide),
    hne 1 3 (by decide), hne 1 4 (by decide), hne 1 5 (by decide)]

lemma closeSixCutMatchingWith_mult_pair23
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    (G.closeSixCutMatchingWith S E).mult
        (sixPairEndpoint E 2) (sixPairEndpoint E 3) =
      (G.induce S).mult (sixPairEndpoint E 2) (sixPairEndpoint E 3) + 1 := by
  have hne (i j : Fin 6) (hij : i ≠ j) :
      sixPairEndpoint E i ≠ sixPairEndpoint E j := fun h ↦ hij (hinj h)
  simp [closeSixCutMatchingWith, singleEdge_mult,
    hne 2 0 (by decide), hne 2 1 (by decide), hne 2 3 (by decide),
    hne 2 4 (by decide), hne 2 5 (by decide), hne 3 0 (by decide),
    hne 3 1 (by decide), hne 3 4 (by decide), hne 3 5 (by decide)]

lemma closeSixCutMatchingWith_mult_pair45
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    (G.closeSixCutMatchingWith S E).mult
        (sixPairEndpoint E 4) (sixPairEndpoint E 5) =
      (G.induce S).mult (sixPairEndpoint E 4) (sixPairEndpoint E 5) + 1 := by
  have hne (i j : Fin 6) (hij : i ≠ j) :
      sixPairEndpoint E i ≠ sixPairEndpoint E j := fun h ↦ hij (hinj h)
  simp [closeSixCutMatchingWith, singleEdge_mult,
    hne 4 0 (by decide), hne 4 1 (by decide), hne 4 2 (by decide),
    hne 4 3 (by decide), hne 4 5 (by decide), hne 5 0 (by decide),
    hne 5 1 (by decide), hne 5 2 (by decide), hne 5 3 (by decide)]

noncomputable def sixArtificialEdge01
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (h0 : sixPairEndpoint E 0 ∈ A) (h1 : sixPairEndpoint E 1 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    BipartiteEdge (G.closeSixCutMatchingWith S E) A B :=
  ⟨⟨sixPairEndpoint E 0, h0⟩, ⟨sixPairEndpoint E 1, h1⟩,
    ⟨(G.induce S).mult (sixPairEndpoint E 0) (sixPairEndpoint E 1), by
      rw [closeSixCutMatchingWith_mult_pair01 E hinj]
      omega⟩⟩

noncomputable def sixArtificialEdge23
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (h2 : sixPairEndpoint E 2 ∈ A) (h3 : sixPairEndpoint E 3 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    BipartiteEdge (G.closeSixCutMatchingWith S E) A B :=
  ⟨⟨sixPairEndpoint E 2, h2⟩, ⟨sixPairEndpoint E 3, h3⟩,
    ⟨(G.induce S).mult (sixPairEndpoint E 2) (sixPairEndpoint E 3), by
      rw [closeSixCutMatchingWith_mult_pair23 E hinj]
      omega⟩⟩

noncomputable def sixArtificialEdge45
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (h4 : sixPairEndpoint E 4 ∈ A) (h5 : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    BipartiteEdge (G.closeSixCutMatchingWith S E) A B :=
  ⟨⟨sixPairEndpoint E 4, h4⟩, ⟨sixPairEndpoint E 5, h5⟩,
    ⟨(G.induce S).mult (sixPairEndpoint E 4) (sixPairEndpoint E 5), by
      rw [closeSixCutMatchingWith_mult_pair45 E hinj]
      omega⟩⟩

noncomputable def peelSixClosingEdges
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (H : Pseudograph S)
    (use₀₁ use₂₃ use₄₅ : Bool) : Pseudograph S :=
  let H₀₁ := if use₀₁ then H.removeSingleEdge
    (sixPairEndpoint E 0) (sixPairEndpoint E 1) else H
  let H₂₃ := if use₂₃ then H₀₁.removeSingleEdge
    (sixPairEndpoint E 2) (sixPairEndpoint E 3) else H₀₁
  if use₄₅ then H₂₃.removeSingleEdge
    (sixPairEndpoint E 4) (sixPairEndpoint E 5) else H₂₃

/-- An exact Hall-defect certificate.  When two finite shores have equal
cardinality but have no transversal, the neighbourhood of some left set can
be enlarged to a right set whose cardinality is exactly one smaller.  The
exact deficit-one form is what the cut-counting arguments in Tashkinov's
proof require. -/
lemma exists_exact_hallDefect
    {L R : Type*} [Fintype L] [Fintype R]
    (rel : L → R → Prop) [DecidableRel rel]
    (hcard : Fintype.card L = Fintype.card R)
    (hno : ¬ ∃ f : L → R, Function.Injective f ∧ ∀ x, rel x (f x)) :
    ∃ A : Finset L, ∃ B : Finset R,
      A.card = B.card + 1 ∧
        ∀ a ∈ A, ∀ b, rel a b → b ∈ B := by
  classical
  have hfail :
      ¬ ∀ A : Finset L, A.card ≤
        ({b : R | ∃ a ∈ A, rel a b} : Finset R).card := by
    intro hhall
    exact hno ((Fintype.all_card_le_filter_rel_iff_exists_injective rel).mp hhall)
  push Not at hfail
  obtain ⟨A, hA⟩ := hfail
  let N : Finset R := {b : R | ∃ a ∈ A, rel a b}
  have hNlt : N.card < A.card := by exact hA
  have hAle : A.card ≤ Fintype.card R := by
    calc
      A.card ≤ Fintype.card L := Finset.card_le_univ A
      _ = Fintype.card R := hcard
  let C : Finset R := Finset.univ \ N
  have hCcard : C.card = Fintype.card R - N.card := by
    simpa [C] using Finset.card_sdiff_of_subset (Finset.subset_univ N)
  have hk : A.card - 1 - N.card ≤ C.card := by
    rw [hCcard]
    omega
  obtain ⟨D, hDC, hDcard⟩ := Finset.exists_subset_card_eq hk
  let B : Finset R := N ∪ D
  have hND : Disjoint N D := Finset.disjoint_sdiff.mono_right hDC
  refine ⟨A, B, ?_, ?_⟩
  · change A.card = (N ∪ D).card + 1
    rw [Finset.card_union_of_disjoint hND, hDcard]
    omega
  · intro a ha b hab
    change b ∈ N ∪ D
    apply Finset.mem_union_left
    simp only [N, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨a, ha, hab⟩

/-- The actual (unlabelled) edges of a simple graph lying entirely in a
finite shore.  The multiplicity definition above is retained for all cut
ledgers; this finset is the extraction interface for the equality case
where there are exactly two internal edges. -/
noncomputable def internalEdgeFinset (G : SimpleGraph W) (S : Finset W) :
    Finset (Sym2 W) :=
  Finset.univ.filter fun e ↦
    (ofSimple G).edgeMultiplicity e * internalIndicator S e = 1

lemma ofSimple_internalTerm_le_one (G : SimpleGraph W) (S : Finset W)
    (e : Sym2 W) :
    (ofSimple G).edgeMultiplicity e * internalIndicator S e ≤ 1 := by
  induction e using Sym2.inductionOn with
  | _ a b =>
      simp only [edgeMultiplicity_mk, internalIndicator_mk]
      by_cases hab : G.Adj a b <;>
        by_cases ha : a ∈ S <;> by_cases hb : b ∈ S <;>
          simp [ofSimple_mult, hab, ha, hb]

lemma card_internalEdgeFinset (G : SimpleGraph W) (S : Finset W) :
    (internalEdgeFinset G S).card = (ofSimple G).internalMultiplicity S := by
  classical
  unfold internalEdgeFinset internalMultiplicity
  rw [Finset.card_filter]
  apply Finset.sum_congr rfl
  intro e _he
  have hle := ofSimple_internalTerm_le_one G S e
  by_cases hterm :
      (ofSimple G).edgeMultiplicity e * internalIndicator S e = 1
  · simp [hterm]
  · have hzero :
        (ofSimple G).edgeMultiplicity e * internalIndicator S e = 0 := by
      omega
    simp [hterm, hzero]

lemma mem_internalEdgeFinset_mk_iff (G : SimpleGraph W) (S : Finset W)
    (a b : W) :
    s(a, b) ∈ internalEdgeFinset G S ↔
      G.Adj a b ∧ a ∈ S ∧ b ∈ S := by
  classical
  simp [internalEdgeFinset, edgeMultiplicity_mk, internalIndicator_mk,
    ofSimple_mult]

noncomputable def betweenEdgeFinset (G : SimpleGraph W)
    (S T : Finset W) : Finset (Sym2 W) :=
  Finset.univ.filter fun e ↦
    (ofSimple G).edgeMultiplicity e * betweenIndicator S T e = 1

lemma ofSimple_betweenTerm_le_one (G : SimpleGraph W)
    (S T : Finset W) (e : Sym2 W) :
    (ofSimple G).edgeMultiplicity e * betweenIndicator S T e ≤ 1 := by
  induction e using Sym2.inductionOn with
  | _ a b =>
      simp only [edgeMultiplicity_mk, betweenIndicator_mk]
      by_cases hab : G.Adj a b <;>
        by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
        by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T <;>
          simp [ofSimple_mult, hab, haS, hbS, haT, hbT]

lemma card_betweenEdgeFinset (G : SimpleGraph W) (S T : Finset W) :
    (betweenEdgeFinset G S T).card = (ofSimple G).betweenMultiplicity S T := by
  classical
  unfold betweenEdgeFinset betweenMultiplicity
  rw [Finset.card_filter]
  apply Finset.sum_congr rfl
  intro e _he
  have hle := ofSimple_betweenTerm_le_one G S T e
  by_cases hterm :
      (ofSimple G).edgeMultiplicity e * betweenIndicator S T e = 1
  · simp [hterm]
  · have hzero :
        (ofSimple G).edgeMultiplicity e * betweenIndicator S T e = 0 := by
      omega
    simp [hzero]

lemma mem_betweenEdgeFinset_mk_iff (G : SimpleGraph W)
    (S T : Finset W) (a b : W) :
    s(a, b) ∈ betweenEdgeFinset G S T ↔
      G.Adj a b ∧ ((a ∈ S ∧ b ∈ T) ∨ (a ∈ T ∧ b ∈ S)) := by
  classical
  simp only [betweenEdgeFinset, Finset.mem_filter, Finset.mem_univ, true_and,
    edgeMultiplicity_mk, betweenIndicator_mk]
  by_cases hab : G.Adj a b <;>
    by_cases haS : a ∈ S <;> by_cases hbS : b ∈ S <;>
    by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T <;>
      simp [ofSimple_mult, hab, haS, hbS, haT, hbT]

/-- Endpoint-level extraction of the two-edge equality case. -/
lemma exists_two_internal_edges_of_internalMultiplicity_eq_two
    (G : SimpleGraph W) (S : Finset W)
    (hcount : (ofSimple G).internalMultiplicity S = 2) :
    ∃ a b c d : W,
      G.Adj a b ∧ a ∈ S ∧ b ∈ S ∧
      G.Adj c d ∧ c ∈ S ∧ d ∈ S ∧
      s(a, b) ≠ s(c, d) ∧
      ∀ {x y : W}, G.Adj x y → x ∈ S → y ∈ S →
        s(x, y) = s(a, b) ∨ s(x, y) = s(c, d) := by
  classical
  have hcard : (internalEdgeFinset G S).card = 2 := by
    rw [card_internalEdgeFinset, hcount]
  obtain ⟨e₁, e₂, hne, hfinset⟩ := Finset.card_eq_two.mp hcard
  induction e₁ using Sym2.inductionOn with
  | _ a b =>
      induction e₂ using Sym2.inductionOn with
      | _ c d =>
          have he₁ : s(a, b) ∈ internalEdgeFinset G S := by
            rw [hfinset]
            simp
          have he₂ : s(c, d) ∈ internalEdgeFinset G S := by
            rw [hfinset]
            simp
          have hab := (mem_internalEdgeFinset_mk_iff G S a b).mp he₁
          have hcd := (mem_internalEdgeFinset_mk_iff G S c d).mp he₂
          refine ⟨a, b, c, d, hab.1, hab.2.1, hab.2.2,
            hcd.1, hcd.2.1, hcd.2.2, hne, ?_⟩
          intro x y hxy hx hy
          have hmem : s(x, y) ∈ internalEdgeFinset G S :=
            (mem_internalEdgeFinset_mk_iff G S x y).mpr ⟨hxy, hx, hy⟩
          rw [hfinset] at hmem
          simpa only [Finset.mem_insert, Finset.mem_singleton] using hmem

/-- Two adjacent vertices in a simple quartic graph form a six-edge shore. -/
lemma boundaryMultiplicity_pair_of_adj_quartic
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    {a b : W} (hab : G.Adj a b) :
    (ofSimple G).boundaryMultiplicity {a, b} = 6 := by
  classical
  have habne : a ≠ b := hab.ne
  have hfinset : internalEdgeFinset G {a, b} = {s(a, b)} := by
    ext e
    induction e using Sym2.inductionOn with
    | _ x y =>
        simp only [mem_internalEdgeFinset_mk_iff, Finset.mem_insert,
          Finset.mem_singleton]
        constructor
        · rintro ⟨hxy, (rfl | rfl), (rfl | rfl)⟩
          · exact (G.loopless.irrefl _ hxy).elim
          · rfl
          · exact Sym2.eq_swap
          · exact (G.loopless.irrefl _ hxy).elim
        · intro hsym
          rw [Sym2.eq_iff] at hsym
          rcases hsym with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
          · exact ⟨hab, .inl rfl, .inr rfl⟩
          · exact ⟨hab.symm, .inr rfl, .inl rfl⟩
  have hint : (ofSimple G).internalMultiplicity {a, b} = 1 := by
    rw [← card_internalEdgeFinset, hfinset]
    simp
  have hledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) {a, b}
  rw [hint] at hledger
  simp [habne] at hledger
  omega

/-- Proposition 3.6 in its shore-oriented form: a bipartite side of a
six-edge cut is the trivial two-vertex side. -/
def HasNoNontrivialBipartiteSixShore (G : SimpleGraph W) : Prop :=
  ∀ S : Finset W,
    (ofSimple G).boundaryMultiplicity S = 6 →
      IsBipartiteOn G S → S.card = 2

/-- If the only two edges inside the complement of an independent set have
a common endpoint, deleting the endpoints of either edge leaves a
nontrivial bipartite six-shore.  This is the first case of Proposition 4.1. -/
lemma false_of_two_internal_edges_with_common_endpoint
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card W))
    (hnoBip6 : HasNoNontrivialBipartiteSixShore G)
    (U : Finset W) (hU : G.IsIndepSet (U : Set W))
    {a b c : W}
    (hab : G.Adj a b) (hac : G.Adj a c)
    (haX : a ∈ Uᶜ) (hbX : b ∈ Uᶜ) (hcX : c ∈ Uᶜ)
    (hclass : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
      s(x, y) = s(a, b) ∨ s(x, y) = s(a, c)) : False := by
  classical
  let T : Finset W := {a, b}
  let S : Finset W := Tᶜ
  have hcutT : (ofSimple G).boundaryMultiplicity T = 6 := by
    simpa [T] using boundaryMultiplicity_pair_of_adj_quartic G hreg hab
  have hcutS : (ofSimple G).boundaryMultiplicity S = 6 := by
    simpa [S, T] using (ofSimple G).boundaryMultiplicity_compl T |>.trans hcutT
  have hbip : IsBipartiteOn G S := by
    let color : W → Fin 2 := fun v ↦ if v ∈ U then 0 else 1
    refine ⟨color, ?_⟩
    intro x y hxS hyS hxy
    by_cases hxU : x ∈ U
    · have hyU : y ∉ U := by
        intro hyU
        exact hU (by simpa using hxU) (by simpa using hyU) hxy.ne hxy
      simp [color, hxU, hyU]
    · by_cases hyU : y ∈ U
      · simp [color, hxU, hyU]
      · exfalso
        have hxX : x ∈ Uᶜ := Finset.mem_compl.mpr hxU
        have hyX : y ∈ Uᶜ := Finset.mem_compl.mpr hyU
        rcases hclass hxy hxX hyX with he | he
        · rw [Sym2.eq_iff] at he
          rcases he with ⟨hxa, hyb⟩ | ⟨hxb, hya⟩
          · subst x
            exact (Finset.mem_compl.mp hxS) (by simp [T])
          · subst y
            exact (Finset.mem_compl.mp hyS) (by simp [T])
        · rw [Sym2.eq_iff] at he
          rcases he with ⟨hxa, _hyc⟩ | ⟨_hxc, hya⟩
          · subst x
            exact (Finset.mem_compl.mp hxS) (by simp [T])
          · subst y
            exact (Finset.mem_compl.mp hyS) (by simp [T])
  have hScard : S.card = 2 := hnoBip6 S hcutS hbip
  have hcards : T.card + S.card = Nat.card W := by
    simpa [S, Nat.card_eq_fintype_card] using Finset.card_add_card_compl T
  have hTcard : T.card = 2 := by simp [T, hab.ne]
  rcases hodd with ⟨k, hk⟩
  omega

/-- Consequently, in the remaining equality case of Proposition 4.1 the
two internal edges have four distinct endpoints. -/
lemma exists_two_vertex_disjoint_internal_edges
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card W))
    (hnoBip6 : HasNoNontrivialBipartiteSixShore G)
    (U : Finset W) (hU : G.IsIndepSet (U : Set W))
    (hcount : (ofSimple G).internalMultiplicity Uᶜ = 2) :
    ∃ a b c d : W,
      G.Adj a b ∧ G.Adj c d ∧
      a ∈ Uᶜ ∧ b ∈ Uᶜ ∧ c ∈ Uᶜ ∧ d ∈ Uᶜ ∧
      a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧
      (∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
        s(x, y) = s(a, b) ∨ s(x, y) = s(c, d)) := by
  obtain ⟨a, b, c, d, hab, haX, hbX, hcd, hcX, hdX, hedgeNe, hclass⟩ :=
    exists_two_internal_edges_of_internalMultiplicity_eq_two G Uᶜ hcount
  have habne : a ≠ b := hab.ne
  have hcdne : c ≠ d := hcd.ne
  have hac : a ≠ c := by
    intro hac
    subst c
    exact false_of_two_internal_edges_with_common_endpoint G hreg hodd hnoBip6
      U hU hab hcd haX hbX hdX hclass
  have had : a ≠ d := by
    intro had
    subst d
    have hclass' : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
        s(x, y) = s(a, b) ∨ s(x, y) = s(a, c) := by
      intro x y hxy hx hy
      rcases hclass hxy hx hy with h | h
      · exact .inl h
      · exact .inr (h.trans Sym2.eq_swap)
    exact false_of_two_internal_edges_with_common_endpoint G hreg hodd hnoBip6
      U hU hab hcd.symm haX hbX hcX hclass'
  have hbc : b ≠ c := by
    intro hbc
    subst c
    have hclass' : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
        s(x, y) = s(b, a) ∨ s(x, y) = s(b, d) := by
      intro x y hxy hx hy
      rcases hclass hxy hx hy with h | h
      · exact .inl (h.trans Sym2.eq_swap)
      · exact .inr h
    exact false_of_two_internal_edges_with_common_endpoint G hreg hodd hnoBip6
      U hU hab.symm hcd hbX haX hdX hclass'
  have hbd : b ≠ d := by
    intro hbd
    subst d
    have hclass' : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
        s(x, y) = s(b, a) ∨ s(x, y) = s(b, c) := by
      intro x y hxy hx hy
      rcases hclass hxy hx hy with h | h
      · exact .inl (h.trans Sym2.eq_swap)
      · exact .inr (h.trans Sym2.eq_swap)
    exact false_of_two_internal_edges_with_common_endpoint G hreg hodd hnoBip6
      U hU hab.symm hcd.symm hbX haX hcX hclass'
  exact ⟨a, b, c, d, hab, hcd, haX, hbX, hcX, hdX,
    habne, hac, had, hbc, hbd, hcdne, hclass⟩

lemma other_neighbors_subset_independent
    (G : SimpleGraph W) (U : Finset W)
    {a b c d : W}
    (haX : a ∈ Uᶜ)
    (hac : a ≠ c) (had : a ≠ d) (habne : a ≠ b)
    (hclass : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
      s(x, y) = s(a, b) ∨ s(x, y) = s(c, d)) :
    G.neighborFinset a \ {b} ⊆ U := by
  classical
  intro x hx
  have hax : G.Adj a x := by
    simpa only [SimpleGraph.mem_neighborFinset] using (Finset.mem_sdiff.mp hx).1
  have hxb : x ≠ b := by simpa using (Finset.mem_sdiff.mp hx).2
  by_contra hxU
  have hxX : x ∈ Uᶜ := Finset.mem_compl.mpr hxU
  rcases hclass hax haX hxX with he | he
  · rw [Sym2.eq_iff] at he
    rcases he with ⟨_haa, hxb'⟩ | ⟨hab', _hxa⟩
    · exact hxb hxb'
    · exact habne hab'
  · rw [Sym2.eq_iff] at he
    rcases he with ⟨hac', _hxd⟩ | ⟨had', _hxc⟩
    · exact hac hac'
    · exact had had'

lemma other_neighbors_card_eq_three
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    {a b : W} (hab : G.Adj a b) :
    (G.neighborFinset a \ {b}).card = 3 := by
  classical
  have hbmem : b ∈ G.neighborFinset a := by simpa using hab
  rw [Finset.sdiff_singleton_eq_erase, Finset.card_erase_of_mem hbmem,
    SimpleGraph.card_neighborFinset_eq_degree, hreg a]

/-- A Hall transversal between two displayed equal shores is a perfect
matching.  This endpoint-level constructor avoids passing through a
separate bipartite-graph object. -/
lemma exists_isPerfectMatching_of_transversal
    (K : SimpleGraph W) (L R : Finset W)
    (hdisj : Disjoint L R) (hcover : L ∪ R = Finset.univ)
    (hcard : L.card = R.card)
    (f : L → R) (hinj : Function.Injective f)
    (hadj : ∀ l : L, K.Adj l (f l)) :
    ∃ M : K.Subgraph, M.IsPerfectMatching := by
  classical
  let M : K.Subgraph := {
    verts := Set.univ
    Adj := fun u v ↦ ∃ l : L,
      (((l : W) = u ∧ (f l : W) = v) ∨
        ((l : W) = v ∧ (f l : W) = u))
    adj_sub := by
      rintro u v ⟨l, huv | huv⟩
      · rcases huv with ⟨rfl, rfl⟩
        exact hadj l
      · rcases huv with ⟨rfl, rfl⟩
        exact (hadj l).symm
    edge_vert := by simp
    symm := ⟨by
      rintro u v ⟨l, huv⟩
      exact ⟨l, huv.symm⟩⟩ }
  have htypeCard : Fintype.card L = Fintype.card R := by
    simpa using hcard
  have hsurj : Function.Surjective f :=
    ((Fintype.bijective_iff_injective_and_card f).mpr ⟨hinj, htypeCard⟩).2
  refine ⟨M, ?_, ?_⟩
  · intro v _hv
    have hvLR : v ∈ L ∨ v ∈ R := by
      have hv : v ∈ L ∪ R := by rw [hcover]; simp
      simpa only [Finset.mem_union] using hv
    rcases hvLR with hvL | hvR
    · let l : L := ⟨v, hvL⟩
      refine ⟨(f l : W), ?_, ?_⟩
      · exact ⟨l, .inl ⟨rfl, rfl⟩⟩
      · intro z hz
        rcases hz with ⟨l', hz | hz⟩
        · rcases hz with ⟨hl'v, hfz⟩
          have hl'eq : l' = l := by
            apply Subtype.ext
            exact hl'v
          subst l'
          exact hfz.symm
        · rcases hz with ⟨hl'z, hfv⟩
          exfalso
          exact (Finset.disjoint_left.mp hdisj) hvL (by
            rw [← hfv]
            exact (f l').2)
    · let r : R := ⟨v, hvR⟩
      obtain ⟨l, hfl⟩ := hsurj r
      refine ⟨(l : W), ?_, ?_⟩
      · exact ⟨l, .inr ⟨rfl, congrArg Subtype.val hfl⟩⟩
      · intro z hz
        rcases hz with ⟨l', hz | hz⟩
        · rcases hz with ⟨hl'v, _hfz⟩
          exfalso
          exact (Finset.disjoint_left.mp hdisj) (by
            rw [← hl'v]
            exact l'.2) hvR
        · rcases hz with ⟨hl'z, hfl'v⟩
          have hff : f l' = f l := by
            apply Subtype.ext
            exact hfl'v.trans (congrArg Subtype.val hfl).symm
          have hll : l' = l := hinj hff
          subst l'
          exact hl'z.symm
  · rw [SimpleGraph.Subgraph.isSpanning_iff]

/-- A transversal on all but two vertices, together with an edge joining
the two omitted vertices, is a perfect matching. -/
lemma exists_isPerfectMatching_of_transversal_and_edge
    (K : SimpleGraph W) (L R : Finset W) {c d : W}
    (hdisj : Disjoint L R) (hcard : L.card = R.card)
    (hc : c ∉ L ∪ R) (hd : d ∉ L ∪ R) (hcdne : c ≠ d)
    (hcover : (L ∪ R) ∪ {c, d} = Finset.univ)
    (hcd : K.Adj c d)
    (f : L → R) (hinj : Function.Injective f)
    (hadj : ∀ l : L, K.Adj l (f l)) :
    ∃ M : K.Subgraph, M.IsPerfectMatching := by
  classical
  let P : K.Subgraph := {
    verts := (L ∪ R : Finset W)
    Adj := fun u v ↦ ∃ l : L,
      (((l : W) = u ∧ (f l : W) = v) ∨
        ((l : W) = v ∧ (f l : W) = u))
    adj_sub := by
      rintro u v ⟨l, huv | huv⟩
      · rcases huv with ⟨rfl, rfl⟩
        exact hadj l
      · rcases huv with ⟨rfl, rfl⟩
        exact (hadj l).symm
    edge_vert := by
      rintro u v ⟨l, huv | huv⟩
      · rcases huv with ⟨rfl, rfl⟩
        change (l : W) ∈ L ∪ R
        exact Finset.mem_union_left R l.2
      · rcases huv with ⟨rfl, rfl⟩
        change (f l : W) ∈ L ∪ R
        exact Finset.mem_union_right L (f l).2
    symm := ⟨by
      rintro u v ⟨l, huv⟩
      exact ⟨l, huv.symm⟩⟩ }
  have htypeCard : Fintype.card L = Fintype.card R := by simpa using hcard
  have hsurj : Function.Surjective f :=
    ((Fintype.bijective_iff_injective_and_card f).mpr ⟨hinj, htypeCard⟩).2
  have hPmatch : P.IsMatching := by
    intro v hv
    change v ∈ L ∪ R at hv
    rcases Finset.mem_union.mp hv with hvL | hvR
    · let l : L := ⟨v, hvL⟩
      refine ⟨(f l : W), ?_, ?_⟩
      · exact ⟨l, .inl ⟨rfl, rfl⟩⟩
      · intro z hz
        rcases hz with ⟨l', hz | hz⟩
        · rcases hz with ⟨hl'v, hfz⟩
          have hl'eq : l' = l := by
            apply Subtype.ext
            exact hl'v
          subst l'
          exact hfz.symm
        · rcases hz with ⟨_hl'z, hfv⟩
          exfalso
          exact (Finset.disjoint_left.mp hdisj) hvL (by
            rw [← hfv]
            exact (f l').2)
    · let r : R := ⟨v, hvR⟩
      obtain ⟨l, hfl⟩ := hsurj r
      refine ⟨(l : W), ?_, ?_⟩
      · exact ⟨l, .inr ⟨rfl, congrArg Subtype.val hfl⟩⟩
      · intro z hz
        rcases hz with ⟨l', hz | hz⟩
        · rcases hz with ⟨hl'v, _hfz⟩
          exfalso
          exact (Finset.disjoint_left.mp hdisj) (by
            rw [← hl'v]
            exact l'.2) hvR
        · rcases hz with ⟨hl'z, hfl'v⟩
          have hff : f l' = f l := by
            apply Subtype.ext
            exact hfl'v.trans (congrArg Subtype.val hfl).symm
          have hll : l' = l := hinj hff
          subst l'
          exact hl'z.symm
  let E : K.Subgraph := K.subgraphOfAdj hcd
  have hEmatch : E.IsMatching :=
    SimpleGraph.Subgraph.IsMatching.subgraphOfAdj hcd
  have hsupp : Disjoint P.support E.support := by
    rw [hPmatch.support_eq_verts, SimpleGraph.support_subgraphOfAdj]
    apply Set.disjoint_left.mpr
    intro v hvP hvcd
    change v ∈ L ∪ R at hvP
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hvcd
    rcases hvcd with rfl | rfl
    · exact hc hvP
    · exact hd hvP
  refine ⟨P ⊔ E, hPmatch.sup hEmatch hsupp, ?_⟩
  rw [SimpleGraph.Subgraph.isSpanning_iff, SimpleGraph.Subgraph.verts_sup,
    SimpleGraph.subgraphOfAdj_verts]
  ext v
  change (v ∈ L ∪ R ∨ v = c ∨ v = d) ↔ True
  have hv : v ∈ (L ∪ R) ∪ {c, d} := by rw [hcover]; simp
  simp only [Finset.mem_union, Finset.mem_insert, Finset.mem_singleton] at hv
  aesop

/-- A matching whose ambient vertex set is exactly `A` becomes a perfect
matching of the graph induced on `A`. -/
noncomputable def matchingOnInduce
    (K : SimpleGraph W) (A : Set W) (M : K.Subgraph) :
    (K.induce A).Subgraph where
  verts := {v | (v : W) ∈ M.verts}
  Adj u v := M.Adj u v
  adj_sub h := M.adj_sub h
  edge_vert h := M.edge_vert h
  symm := ⟨fun u v h ↦ M.symm.symm u v h⟩

lemma matchingOnInduce_isPerfectMatching
    (K : SimpleGraph W) (A : Set W) (M : K.Subgraph)
    (hverts : M.verts = A) (hmatch : M.IsMatching) :
    (matchingOnInduce K A M).IsPerfectMatching := by
  classical
  constructor
  · intro v hv
    change (v : W) ∈ M.verts at hv
    obtain ⟨w, hvw, hunique⟩ := hmatch hv
    have hwM : w ∈ M.verts := M.edge_vert hvw.symm
    have hwA : w ∈ A := by simpa [hverts] using hwM
    let w' : A := ⟨w, hwA⟩
    refine ⟨w', hvw, ?_⟩
    intro z hvz
    apply Subtype.ext
    exact hunique z hvz
  · rw [SimpleGraph.Subgraph.isSpanning_iff]
    ext v
    simp [matchingOnInduce, hverts]

noncomputable def transversalSubgraph
    (K : SimpleGraph W) (L R : Finset W)
    (f : L → R) (hadj : ∀ l : L, K.Adj l (f l)) : K.Subgraph where
  verts := (L ∪ R : Finset W)
  Adj u v := ∃ l : L,
    (((l : W) = u ∧ (f l : W) = v) ∨
      ((l : W) = v ∧ (f l : W) = u))
  adj_sub := by
    rintro u v ⟨l, huv | huv⟩
    · rcases huv with ⟨rfl, rfl⟩
      exact hadj l
    · rcases huv with ⟨rfl, rfl⟩
      exact (hadj l).symm
  edge_vert := by
    rintro u v ⟨l, huv | huv⟩
    · rcases huv with ⟨rfl, rfl⟩
      change (l : W) ∈ L ∪ R
      exact Finset.mem_union_left R l.2
    · rcases huv with ⟨rfl, rfl⟩
      change (f l : W) ∈ L ∪ R
      exact Finset.mem_union_right L (f l).2
  symm := ⟨by
    rintro u v ⟨l, huv⟩
    exact ⟨l, huv.symm⟩⟩

lemma transversalSubgraph_isMatching
    (K : SimpleGraph W) (L R : Finset W)
    (hdisj : Disjoint L R) (hcard : L.card = R.card)
    (f : L → R) (hinj : Function.Injective f)
    (hadj : ∀ l : L, K.Adj l (f l)) :
    (transversalSubgraph K L R f hadj).IsMatching := by
  classical
  have htypeCard : Fintype.card L = Fintype.card R := by simpa using hcard
  have hsurj : Function.Surjective f :=
    ((Fintype.bijective_iff_injective_and_card f).mpr ⟨hinj, htypeCard⟩).2
  intro v hv
  change v ∈ L ∪ R at hv
  rcases Finset.mem_union.mp hv with hvL | hvR
  · let l : L := ⟨v, hvL⟩
    refine ⟨(f l : W), ?_, ?_⟩
    · exact ⟨l, .inl ⟨rfl, rfl⟩⟩
    · intro z hz
      rcases hz with ⟨l', hz | hz⟩
      · rcases hz with ⟨hl'v, hfz⟩
        have hl'eq : l' = l := by
          apply Subtype.ext
          exact hl'v
        subst l'
        exact hfz.symm
      · rcases hz with ⟨_hl'z, hfv⟩
        exfalso
        exact (Finset.disjoint_left.mp hdisj) hvL (by
          rw [← hfv]
          exact (f l').2)
  · let r : R := ⟨v, hvR⟩
    obtain ⟨l, hfl⟩ := hsurj r
    refine ⟨(l : W), ?_, ?_⟩
    · exact ⟨l, .inr ⟨rfl, congrArg Subtype.val hfl⟩⟩
    · intro z hz
      rcases hz with ⟨l', hz | hz⟩
      · rcases hz with ⟨hl'v, _hfz⟩
        exfalso
        exact (Finset.disjoint_left.mp hdisj) (by
          rw [← hl'v]
          exact l'.2) hvR
      · rcases hz with ⟨hl'z, hfl'v⟩
        have hff : f l' = f l := by
          apply Subtype.ext
          exact hfl'v.trans (congrArg Subtype.val hfl).symm
        have hll : l' = l := hinj hff
        subst l'
        exact hl'z.symm

/-- Partial version of the preceding constructor, retaining its precise
ambient vertex set for subsequent restriction to an induced graph. -/
lemma exists_matching_of_transversal_and_edge
    (K : SimpleGraph W) (L R : Finset W) {c d : W}
    (hdisj : Disjoint L R) (hcard : L.card = R.card)
    (hc : c ∉ L ∪ R) (hd : d ∉ L ∪ R)
    (hcd : K.Adj c d)
    (f : L → R) (hinj : Function.Injective f)
    (hadj : ∀ l : L, K.Adj l (f l)) :
    ∃ M : K.Subgraph, M.IsMatching ∧
      M.verts = ((L ∪ R) ∪ {c, d} : Finset W) := by
  classical
  let P := transversalSubgraph K L R f hadj
  let E : K.Subgraph := K.subgraphOfAdj hcd
  have hPmatch : P.IsMatching :=
    transversalSubgraph_isMatching K L R hdisj hcard f hinj hadj
  have hEmatch : E.IsMatching :=
    SimpleGraph.Subgraph.IsMatching.subgraphOfAdj hcd
  have hsupp : Disjoint P.support E.support := by
    rw [hPmatch.support_eq_verts, SimpleGraph.support_subgraphOfAdj]
    apply Set.disjoint_left.mpr
    intro v hvP hvcd
    change v ∈ L ∪ R at hvP
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hvcd
    rcases hvcd with rfl | rfl
    · exact hc hvP
    · exact hd hvP
  refine ⟨P ⊔ E, hPmatch.sup hEmatch hsupp, ?_⟩
  rw [SimpleGraph.Subgraph.verts_sup, SimpleGraph.subgraphOfAdj_verts]
  ext v
  simp [P, transversalSubgraph]

/-- The disjoint-edge equality case of Proposition 4.1, stopped exactly at
the Hall dichotomy.  A transversal supplies the anti-neighbourhood matching;
otherwise `A,B` are the deficit-one sets used to expose a six-cut. -/
lemma containsThreeRegular_or_exactHallDefect_of_disjoint_internal_edges
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (U : Finset W) (hU : G.IsIndepSet (U : Set W))
    {a b c d : W}
    (hab : G.Adj a b) (hcd : G.Adj c d)
    (haX : a ∈ Uᶜ) (hbX : b ∈ Uᶜ) (hcX : c ∈ Uᶜ) (hdX : d ∈ Uᶜ)
    (habne : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcdne : c ≠ d)
    (hcount : (ofSimple G).internalMultiplicity Uᶜ = 2)
    (hclass : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
      s(x, y) = s(a, b) ∨ s(x, y) = s(c, d)) :
    ContainsRegularSubgraph G 3 ∨
      ∃ A B : Finset W,
        A ⊆ U \ (G.neighborFinset a \ {b}) ∧
        B ⊆ Uᶜ \ {a, b, c, d} ∧
        A.card = B.card + 1 ∧
        ∀ x ∈ A, ∀ y ∈ (Uᶜ \ {a, b, c, d}) \ B, ¬ G.Adj x y := by
  classical
  let N : Finset W := G.neighborFinset a \ {b}
  let D : Finset W := {a, b, c, d}
  let L : Finset W := U \ N
  let R : Finset W := Uᶜ \ D
  have hOnlyB {x : W} (hax : G.Adj a x) (hxX : x ∈ Uᶜ) : x = b := by
    rcases hclass hax haX hxX with he | he
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨_haa, hxb⟩ | ⟨hab', _hxa⟩
      · exact hxb
      · exact (habne hab').elim
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨hac', _hxd⟩ | ⟨had', _hxc⟩
      · exact (hac hac').elim
      · exact (had had').elim
  have hNsub : N ⊆ U := by
    simpa [N] using other_neighbors_subset_independent
      G U haX hac had habne hclass
  have hNcard : N.card = 3 := by
    simpa [N] using other_neighbors_card_eq_three G hreg hab
  have hDsub : D ⊆ Uᶜ := by
    intro x hx
    simp only [D, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact haX
    · exact hbX
    · exact hcX
    · exact hdX
  have hDcard : D.card = 4 := by
    simp [D, habne, hac, had, hbc, hbd, hcdne]
  have hUint : (ofSimple G).internalMultiplicity U = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G U hU
  have hUledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) U
  have hXledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) Uᶜ
  have hboundary := (ofSimple G).boundaryMultiplicity_compl U
  rw [hUint] at hUledger
  rw [hcount, hboundary] at hXledger
  have hXcard : Uᶜ.card = U.card + 1 := by omega
  have hLcard : L.card = U.card - 3 := by
    simpa [L, hNcard] using Finset.card_sdiff_of_subset hNsub
  have hRcard : R.card = Uᶜ.card - 4 := by
    simpa [R, hDcard] using Finset.card_sdiff_of_subset hDsub
  have hLRcard : L.card = R.card := by omega
  have hLRdisj : Disjoint L R := by
    rw [Finset.disjoint_left]
    intro x hxL hxR
    have hxU : x ∈ U := (Finset.mem_sdiff.mp hxL).1
    have hxX : x ∈ Uᶜ := (Finset.mem_sdiff.mp hxR).1
    exact (Finset.mem_compl.mp hxX) hxU
  have hcLR : c ∉ L ∪ R := by
    intro hcLR'
    rcases Finset.mem_union.mp hcLR' with hcL | hcR
    · exact (Finset.mem_compl.mp hcX) (Finset.mem_sdiff.mp hcL).1
    · exact (Finset.mem_sdiff.mp hcR).2 (by simp [D])
  have hdLR : d ∉ L ∪ R := by
    intro hdLR'
    rcases Finset.mem_union.mp hdLR' with hdL | hdR
    · exact (Finset.mem_compl.mp hdX) (Finset.mem_sdiff.mp hdL).1
    · exact (Finset.mem_sdiff.mp hdR).2 (by simp [D])
  let Q : Finset W := (L ∪ R) ∪ {c, d}
  have hQmem (x : W) :
      x ∈ Q ↔ x ∈ antiNeighborhood G a := by
    constructor
    · intro hxQ
      simp only [Q, Finset.mem_union, Finset.mem_insert,
        Finset.mem_singleton] at hxQ
      rcases hxQ with (hxL | hxR) | hxc | hxd
      · have hxU : x ∈ U := (Finset.mem_sdiff.mp hxL).1
        have hxa : x ≠ a := by
          intro hxa
          subst x
          exact (Finset.mem_compl.mp haX) hxU
        have hnax : ¬ G.Adj a x := by
          intro hax
          have hxb : x ≠ b := by
            intro hxb
            subst x
            exact (Finset.mem_compl.mp hbX) hxU
          have hxN : x ∈ N := by
            apply Finset.mem_sdiff.mpr
            exact ⟨by simpa only [SimpleGraph.mem_neighborFinset] using hax,
              by simpa using hxb⟩
          exact (Finset.mem_sdiff.mp hxL).2 hxN
        exact ⟨hxa, hnax⟩
      · have hxX : x ∈ Uᶜ := (Finset.mem_sdiff.mp hxR).1
        have hxD : x ∉ D := (Finset.mem_sdiff.mp hxR).2
        have hxa : x ≠ a := fun hxa ↦ hxD (by simp [D, hxa])
        have hnax : ¬ G.Adj a x := by
          intro hax
          have hxb' := hOnlyB hax hxX
          subst x
          exact hxD (by simp [D])
        exact ⟨hxa, hnax⟩
      · subst x
        refine ⟨hac.symm, ?_⟩
        intro hacAdj
        exact hbc (hOnlyB hacAdj hcX).symm
      · subst x
        refine ⟨had.symm, ?_⟩
        intro hadAdj
        exact hbd (hOnlyB hadAdj hdX).symm
    · intro hxA
      rcases hxA with ⟨hxa, hnax⟩
      by_cases hxU : x ∈ U
      · have hxN : x ∉ N := by
          intro hxN
          have hax : G.Adj a x := by
            simpa only [SimpleGraph.mem_neighborFinset] using
              (Finset.mem_sdiff.mp hxN).1
          exact hnax hax
        have hxL : x ∈ L := Finset.mem_sdiff.mpr ⟨hxU, hxN⟩
        simp [Q, hxL]
      · have hxX : x ∈ Uᶜ := Finset.mem_compl.mpr hxU
        have hxb : x ≠ b := by
          intro hxb
          subst x
          exact hnax hab
        by_cases hxc : x = c
        · simp [Q, hxc]
        by_cases hxd : x = d
        · simp [Q, hxd]
        have hxD : x ∉ D := by simp [D, hxa, hxb, hxc, hxd]
        have hxR : x ∈ R := Finset.mem_sdiff.mpr ⟨hxX, hxD⟩
        simp [Q, hxR]
  have hQset : (Q : Set W) = antiNeighborhood G a := by
    ext x
    simpa using hQmem x
  let rel : L → R → Prop := fun x y ↦ G.Adj x y
  by_cases htrans : ∃ f : L → R, Function.Injective f ∧ ∀ x, rel x (f x)
  · left
    obtain ⟨f, hinj, hadj⟩ := htrans
    obtain ⟨M, hMmatch, hMverts⟩ :=
      exists_matching_of_transversal_and_edge G L R hLRdisj hLRcard
        hcLR hdLR hcd f hinj hadj
    have hMvertsA : M.verts = antiNeighborhood G a := by
      rw [hMverts]
      exact hQset
    let M' := matchingOnInduce G (antiNeighborhood G a) M
    have hMperfect : M'.IsPerfectMatching :=
      matchingOnInduce_isPerfectMatching G (antiNeighborhood G a) M
        hMvertsA hMmatch
    exact containsThreeRegular_of_isPerfectMatching_antiNeighborhood
      G a hreg M' hMperfect
  · right
    have hLRtypeCard : Fintype.card L = Fintype.card R := by
      simpa using hLRcard
    obtain ⟨A', B', hcardAB, hneighbor⟩ :=
      exists_exact_hallDefect rel hLRtypeCard htrans
    let A : Finset W := A'.image Subtype.val
    let B : Finset W := B'.image Subtype.val
    refine ⟨A, B, ?_, ?_, ?_, ?_⟩
    · intro x hx
      obtain ⟨x', _hxA, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    · intro y hy
      obtain ⟨y', _hyB, rfl⟩ := Finset.mem_image.mp hy
      exact y'.2
    · simp only [A, B, Finset.card_image_of_injective _ Subtype.val_injective]
      exact hcardAB
    · intro x hxA y hyRB hxy
      obtain ⟨x', hx'A, hxval⟩ := Finset.mem_image.mp hxA
      have hyR : y ∈ R := (Finset.mem_sdiff.mp hyRB).1
      let y' : R := ⟨y, hyR⟩
      have hyB : y ∉ B := (Finset.mem_sdiff.mp hyRB).2
      have hyB' : y' ∉ B' := by
        intro hyB'
        apply hyB
        exact Finset.mem_image.mpr ⟨y', hyB', rfl⟩
      have hmem := hneighbor x' hx'A y' (by
        change G.Adj (x' : W) (y' : W)
        simpa [hxval] using hxy)
      exact hyB' hmem

/-- The exact Hall defect in the preceding lemma cuts out a bipartite
six-shore containing the three other neighbours of `a`. -/
lemma exists_nontrivial_bipartiteSixShore_of_exactHallDefect
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (U : Finset W) (hU : G.IsIndepSet (U : Set W))
    {a b c d : W}
    (hab : G.Adj a b) (hcd : G.Adj c d)
    (haX : a ∈ Uᶜ) (hbX : b ∈ Uᶜ) (hcX : c ∈ Uᶜ) (hdX : d ∈ Uᶜ)
    (habne : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcdne : c ≠ d)
    (hcount : (ofSimple G).internalMultiplicity Uᶜ = 2)
    (hclass : ∀ {x y : W}, G.Adj x y → x ∈ Uᶜ → y ∈ Uᶜ →
      s(x, y) = s(a, b) ∨ s(x, y) = s(c, d))
    (A B : Finset W)
    (hAsub : A ⊆ U \ (G.neighborFinset a \ {b}))
    (hBsub : B ⊆ Uᶜ \ {a, b, c, d})
    (hABcard : A.card = B.card + 1)
    (hno : ∀ x ∈ A, ∀ y ∈ (Uᶜ \ {a, b, c, d}) \ B,
      ¬ G.Adj x y) :
    ∃ S : Finset W,
      (ofSimple G).boundaryMultiplicity S = 6 ∧
      IsBipartiteOn G S ∧ S.card ≠ 2 := by
  classical
  let N : Finset W := G.neighborFinset a \ {b}
  let D : Finset W := {a, b, c, d}
  let T : Finset W := {b, c, d}
  let P : Finset W := U \ A
  let Q : Finset W := Uᶜ \ (B ∪ T)
  let S : Finset W := P ∪ Q
  have hOnlyB {x : W} (hax : G.Adj a x) (hxX : x ∈ Uᶜ) : x = b := by
    rcases hclass hax haX hxX with he | he
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨_haa, hxb⟩ | ⟨hab', _hxa⟩
      · exact hxb
      · exact (habne hab').elim
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨hac', _hxd⟩ | ⟨had', _hxc⟩
      · exact (hac hac').elim
      · exact (had had').elim
  have hNsub : N ⊆ U := by
    simpa [N] using other_neighbors_subset_independent
      G U haX hac had habne hclass
  have hNcard : N.card = 3 := by
    simpa [N] using other_neighbors_card_eq_three G hreg hab
  have hAsubU : A ⊆ U := fun _ hx ↦ (Finset.mem_sdiff.mp (hAsub hx)).1
  have hAdisjN : Disjoint A N := by
    rw [Finset.disjoint_left]
    intro x hxA hxN
    exact (Finset.mem_sdiff.mp (hAsub hxA)).2 hxN
  have hNsubP : N ⊆ P := by
    intro x hxN
    apply Finset.mem_sdiff.mpr
    refine ⟨hNsub hxN, ?_⟩
    intro hxA
    exact (Finset.disjoint_left.mp hAdisjN) hxA hxN
  have hDsubX : D ⊆ Uᶜ := by
    intro x hx
    simp only [D, Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact haX
    · exact hbX
    · exact hcX
    · exact hdX
  have hBsubX : B ⊆ Uᶜ := fun _ hx ↦ (Finset.mem_sdiff.mp (hBsub hx)).1
  have hBTdisj : Disjoint B T := by
    rw [Finset.disjoint_left]
    intro x hxB hxT
    have hxD : x ∈ D := by
      simp only [T, D, Finset.mem_insert, Finset.mem_singleton] at hxT ⊢
      aesop
    exact (Finset.mem_sdiff.mp (hBsub hxB)).2 hxD
  have hTcard : T.card = 3 := by simp [T, hbc, hbd, hcdne]
  have hBTcard : (B ∪ T).card = B.card + 3 := by
    rw [Finset.card_union_of_disjoint hBTdisj, hTcard]
  have hBTsubX : B ∪ T ⊆ Uᶜ := by
    intro x hx
    rcases Finset.mem_union.mp hx with hxB | hxT
    · exact hBsubX hxB
    · simp only [T, Finset.mem_insert, Finset.mem_singleton] at hxT
      rcases hxT with rfl | rfl | rfl
      · exact hbX
      · exact hcX
      · exact hdX
  have hUint : (ofSimple G).internalMultiplicity U = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G U hU
  have hUledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) U
  have hXledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) Uᶜ
  have hboundary := (ofSimple G).boundaryMultiplicity_compl U
  rw [hUint] at hUledger
  rw [hcount, hboundary] at hXledger
  have hXcard : Uᶜ.card = U.card + 1 := by omega
  have hPcard : P.card = U.card - A.card := by
    simpa [P] using Finset.card_sdiff_of_subset hAsubU
  have hQcard : Q.card = Uᶜ.card - (B.card + 3) := by
    simpa [Q, hBTcard] using Finset.card_sdiff_of_subset hBTsubX
  have hUPcard : P.card + A.card = U.card := by
    simpa [P] using Finset.card_sdiff_add_card_eq_card hAsubU
  have hXQcard : Q.card + (B.card + 3) = Uᶜ.card := by
    have h := Finset.card_sdiff_add_card_eq_card hBTsubX
    simpa [Q, hBTcard] using h
  have hPQcard : P.card = Q.card + 1 := by omega
  have hPQdisj : Disjoint P Q := by
    rw [Finset.disjoint_left]
    intro x hxP hxQ
    exact (Finset.mem_compl.mp (Finset.mem_sdiff.mp hxQ).1)
      (Finset.mem_sdiff.mp hxP).1
  have hQind : G.IsIndepSet (Q : Set W) := by
    intro x hx y hy _hxyne hxy
    have hxQ : x ∈ Q := by simpa using hx
    have hyQ : y ∈ Q := by simpa using hy
    have hxX := (Finset.mem_sdiff.mp hxQ).1
    have hyX := (Finset.mem_sdiff.mp hyQ).1
    have hxBT := (Finset.mem_sdiff.mp hxQ).2
    have hyBT := (Finset.mem_sdiff.mp hyQ).2
    rcases hclass hxy hxX hyX with he | he
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨hxa, hyb⟩ | ⟨hxb, hya⟩
      · subst y
        exact hyBT (by simp [T])
      · subst x
        exact hxBT (by simp [T])
    · rw [Sym2.eq_iff] at he
      rcases he with ⟨hxc, hyd⟩ | ⟨hxd, hyc⟩
      · subst x
        exact hxBT (by simp [T])
      · subst x
        exact hxBT (by simp [T])
  have hPind : G.IsIndepSet (P : Set W) := by
    intro x hx y hy hxyne hxy
    have hxP : x ∈ P := by simpa using hx
    have hyP : y ∈ P := by simpa using hy
    have hxU : x ∈ U := (Finset.mem_sdiff.mp hxP).1
    have hyU : y ∈ U := (Finset.mem_sdiff.mp hyP).1
    exact hU (by simpa using hxU) (by simpa using hyU) hxyne hxy
  have hbip : IsBipartiteOn G S := by
    let color : W → Fin 2 := fun v ↦ if v ∈ P then 0 else 1
    refine ⟨color, ?_⟩
    intro x y hxS hyS hxy
    rcases Finset.mem_union.mp hxS with hxP | hxQ
    · have hyQ : y ∈ Q := by
        rcases Finset.mem_union.mp hyS with hyP | hyQ
        · exact False.elim (hPind (by simpa using hxP) (by simpa using hyP)
            hxy.ne hxy)
        · exact hyQ
      have hyP : y ∉ P := fun hyP ↦
        (Finset.disjoint_left.mp hPQdisj) hyP hyQ
      simp [color, hxP, hyP]
    · have hxP : x ∉ P := fun hxP ↦
        (Finset.disjoint_left.mp hPQdisj) hxP hxQ
      rcases Finset.mem_union.mp hyS with hyP | hyQ
      · simp [color, hxP, hyP]
      · exact False.elim (hQind (by simpa using hxQ) (by simpa using hyQ)
          hxy.ne hxy)
  have haQ : a ∈ Q := by
    apply Finset.mem_sdiff.mpr
    refine ⟨haX, ?_⟩
    intro haBT
    rcases Finset.mem_union.mp haBT with haB | haT
    · have haD : a ∉ D := (Finset.mem_sdiff.mp (hBsub haB)).2
      exact haD (by simp [D])
    · simp [T, habne, hac, had] at haT
  have hbSc : b ∈ Sᶜ := by
    apply Finset.mem_compl.mpr
    intro hbS
    rcases Finset.mem_union.mp hbS with hbP | hbQ
    · exact (Finset.mem_compl.mp hbX) (Finset.mem_sdiff.mp hbP).1
    · exact (Finset.mem_sdiff.mp hbQ).2 (by simp [T])
  have edgeFromQOutside {q z : W}
      (hqQ : q ∈ Q) (hzSc : z ∈ Sᶜ) (hqz : G.Adj q z) :
      s(q, z) = s(a, b) := by
    have hqX := (Finset.mem_sdiff.mp hqQ).1
    have hqBT := (Finset.mem_sdiff.mp hqQ).2
    by_cases hzU : z ∈ U
    · have hzA : z ∈ A := by
        by_contra hzA
        have hzP : z ∈ P := Finset.mem_sdiff.mpr ⟨hzU, hzA⟩
        exact (Finset.mem_compl.mp hzSc) (Finset.mem_union_left Q hzP)
      by_cases hqa : q = a
      · subst q
        have hzL := hAsub hzA
        have hzN : z ∈ N := by
          apply Finset.mem_sdiff.mpr
          refine ⟨by simpa only [SimpleGraph.mem_neighborFinset] using hqz, ?_⟩
          intro hzb
          have hzb' : z = b := by simpa using hzb
          subst z
          exact (Finset.mem_compl.mp hbX) hzU
        exact False.elim ((Finset.mem_sdiff.mp hzL).2 hzN)
      · have hqD : q ∉ D := by
          simp only [D, Finset.mem_insert, Finset.mem_singleton]
          intro h
          rcases h with h | h | h | h
          · exact hqa h
          · subst q; exact hqBT (by simp [T])
          · subst q; exact hqBT (by simp [T])
          · subst q; exact hqBT (by simp [T])
        have hqR : q ∈ Uᶜ \ D := Finset.mem_sdiff.mpr ⟨hqX, hqD⟩
        have hqB : q ∉ B := fun hqB ↦ hqBT (Finset.mem_union_left T hqB)
        exact False.elim (hno z hzA q (Finset.mem_sdiff.mpr ⟨hqR, hqB⟩)
          hqz.symm)
    · have hzX : z ∈ Uᶜ := Finset.mem_compl.mpr hzU
      rcases hclass hqz hqX hzX with he | he
      · exact he
      · rw [Sym2.eq_iff] at he
        rcases he with ⟨hqc, _hzd⟩ | ⟨hqd, _hzc⟩
        · subst q
          exact False.elim (hqBT (by simp [T]))
        · subst q
          exact False.elim (hqBT (by simp [T]))
  have hbetweenFinset : betweenEdgeFinset G Q Sᶜ = {s(a, b)} := by
    ext e
    induction e using Sym2.inductionOn with
    | _ x y =>
        constructor
        · intro he
          obtain ⟨hxy, hcross⟩ :=
            (mem_betweenEdgeFinset_mk_iff G Q Sᶜ x y).mp he
          rcases hcross with hcross | hcross
          · exact Finset.mem_singleton.mpr
              (edgeFromQOutside hcross.1 hcross.2 hxy)
          · apply Finset.mem_singleton.mpr
            rw [Sym2.eq_swap]
            exact edgeFromQOutside hcross.2 hcross.1 hxy.symm
        · intro he
          have heq := Finset.mem_singleton.mp he
          rw [heq]
          exact (mem_betweenEdgeFinset_mk_iff G Q Sᶜ a b).mpr
            ⟨hab, .inl ⟨haQ, hbSc⟩⟩
  have hbetweenQSc : (ofSimple G).betweenMultiplicity Q Sᶜ = 1 := by
    rw [← card_betweenEdgeFinset, hbetweenFinset]
    simp
  have hQint : (ofSimple G).internalMultiplicity Q = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G Q hQind
  have hPint : (ofSimple G).internalMultiplicity P = 0 :=
    internalMultiplicity_eq_zero_of_isIndepSet G P hPind
  have hQledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) Q
  rw [hQint] at hQledger
  have hPScdisj : Disjoint P Sᶜ := by
    rw [Finset.disjoint_left]
    intro x hxP hxSc
    exact (Finset.mem_compl.mp hxSc) (Finset.mem_union_left Q hxP)
  have hcoverQ : P ∪ Sᶜ = Qᶜ := by
    ext x
    constructor
    · intro hx
      rcases Finset.mem_union.mp hx with hxP | hxSc
      · apply Finset.mem_compl.mpr
        intro hxQ
        exact (Finset.disjoint_left.mp hPQdisj) hxP hxQ
      · apply Finset.mem_compl.mpr
        intro hxQ
        exact (Finset.mem_compl.mp hxSc) (Finset.mem_union_right P hxQ)
    · intro hxQc
      by_cases hxP : x ∈ P
      · exact Finset.mem_union_left Sᶜ hxP
      · apply Finset.mem_union_right P
        apply Finset.mem_compl.mpr
        intro hxS
        rcases Finset.mem_union.mp hxS with hxP' | hxQ
        · exact hxP hxP'
        · exact (Finset.mem_compl.mp hxQc) hxQ
  have hQsplit := (ofSimple G).boundaryMultiplicity_eq_between_add_between
    Q P Sᶜ hPScdisj hcoverQ
  rw [hQsplit, hbetweenQSc] at hQledger
  have hbetweenPQ : (ofSimple G).betweenMultiplicity P Q = 4 * Q.card - 1 := by
    rw [(ofSimple G).betweenMultiplicity_comm P Q]
    omega
  have hSint := (ofSimple G).internalMultiplicity_union P Q hPQdisj
  rw [hPint, hQint, hbetweenPQ] at hSint
  have hScard : S.card = P.card + Q.card := by
    simpa [S] using Finset.card_union_of_disjoint hPQdisj
  have hSledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
  rw [hScard, hSint] at hSledger
  have hScut : (ofSimple G).boundaryMultiplicity S = 6 := by omega
  have hSthree : 3 ≤ S.card := by
    calc
      3 = N.card := hNcard.symm
      _ ≤ P.card := Finset.card_le_card hNsubP
      _ ≤ S.card := Finset.card_le_card Finset.subset_union_left
  exact ⟨S, hScut, hbip, by omega⟩

/-- Tashkinov's Proposition 4.1.  In a cubic-subgraph-free odd quartic
graph with Proposition 3.6 available, the complement of every independent
set contains strictly more than two edges. -/
theorem two_lt_internalMultiplicity_compl_of_independent
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card W))
    (hnoCubic : ¬ ContainsRegularSubgraph G 3)
    (hnoBip6 : HasNoNontrivialBipartiteSixShore G)
    (U : Finset W) (hU : G.IsIndepSet (U : Set W)) :
    2 < (ofSimple G).internalMultiplicity Uᶜ := by
  have hlower := two_le_internalMultiplicity_compl_of_independent_of_odd
    G hreg hodd U hU
  by_contra hnot
  have hcount : (ofSimple G).internalMultiplicity Uᶜ = 2 := by omega
  obtain ⟨a, b, c, d, hab, hcd, haX, hbX, hcX, hdX,
      habne, hac, had, hbc, hbd, hcdne, hclass⟩ :=
    exists_two_vertex_disjoint_internal_edges G hreg hodd hnoBip6 U hU hcount
  rcases containsThreeRegular_or_exactHallDefect_of_disjoint_internal_edges
      G hreg U hU hab hcd haX hbX hcX hdX habne hac had hbc hbd hcdne
        hcount hclass with hcubic | hdefect
  · exact hnoCubic hcubic
  · obtain ⟨A, B, hAsub, hBsub, hABcard, hno⟩ := hdefect
    obtain ⟨S, hcut, hbip, hcard⟩ :=
      exists_nontrivial_bipartiteSixShore_of_exactHallDefect
        G hreg U hU hab hcd haX hbX hcX hdX habne hac had hbc hbd hcdne
          hcount hclass A B hAsub hBsub hABcard hno
    exact hcard (hnoBip6 S hcut hbip)

/-- A bipartite shore of a six-cut in a simple quartic graph cannot have
three vertices: the degree ledger would force all three possible edges,
forming a triangle. -/
lemma card_ne_three_of_bipartite_six_shore
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (hcut : (ofSimple G).boundaryMultiplicity S = 6)
    (hbip : IsBipartiteOn G S) : S.card ≠ 3 := by
  classical
  intro hcard
  obtain ⟨x, y, z, hxy, hxz, hyz, hS⟩ := Finset.card_eq_three.mp hcard
  have hledger := regular_card_eq_two_internal_add_boundary
    (ofSimple G) ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
  rw [hcard, hcut] at hledger
  have hint : (ofSimple G).internalMultiplicity S = 3 := by omega
  let Eall : Finset (Sym2 W) := {s(x, y), s(x, z), s(y, z)}
  have hsub : internalEdgeFinset G S ⊆ Eall := by
    intro e he
    induction e using Sym2.inductionOn with
    | _ a b =>
        have hm := (mem_internalEdgeFinset_mk_iff G S a b).mp he
        have ha : a = x ∨ a = y ∨ a = z := by
          simpa [hS] using hm.2.1
        have hb : b = x ∨ b = y ∨ b = z := by
          simpa [hS] using hm.2.2
        rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl
        all_goals simp [Eall, Sym2.eq_swap]
        all_goals exact (G.loopless.irrefl _ hm.1).elim
  have hEcard : (internalEdgeFinset G S).card = 3 := by
    rw [card_internalEdgeFinset, hint]
  have hAllcard : Eall.card = 3 := by
    simp [Eall, Sym2.eq_iff, hxy, hxz, hyz, ne_comm]
  have hEq : internalEdgeFinset G S = Eall :=
    Finset.eq_of_subset_of_card_le hsub (by omega)
  have hxyAdj : G.Adj x y := by
    have hm : s(x, y) ∈ internalEdgeFinset G S := by
      rw [hEq]
      simp [Eall]
    exact ((mem_internalEdgeFinset_mk_iff G S x y).mp hm).1
  have hxzAdj : G.Adj x z := by
    have hm : s(x, z) ∈ internalEdgeFinset G S := by
      rw [hEq]
      simp [Eall]
    exact ((mem_internalEdgeFinset_mk_iff G S x z).mp hm).1
  have hyzAdj : G.Adj y z := by
    have hm : s(y, z) ∈ internalEdgeFinset G S := by
      rw [hEq]
      simp [Eall]
    exact ((mem_internalEdgeFinset_mk_iff G S y z).mp hm).1
  obtain ⟨color, hcolor⟩ := hbip
  have hxyColor := hcolor (by simp [hS]) (by simp [hS]) hxyAdj
  have hxzColor := hcolor (by simp [hS]) (by simp [hS]) hxzAdj
  have hyzColor := hcolor (by simp [hS]) (by simp [hS]) hyzAdj
  have fin2_cases (i : Fin 2) : i = 0 ∨ i = 1 := by
    refine Fin.cases (.inl rfl) ?_ i
    intro j
    refine Fin.cases (.inr rfl) ?_ j
    exact fun k ↦ Fin.elim0 k
  rcases fin2_cases (color x) with hx | hx <;>
    rcases fin2_cases (color y) with hy | hy <;>
    rcases fin2_cases (color z) with hz | hz <;> simp_all

structure MinimalBipartiteSixShore (G : SimpleGraph W) where
  shore : Finset W
  cut : (ofSimple G).boundaryMultiplicity shore = 6
  bipartite : IsBipartiteOn G shore
  nontrivial : shore.card ≠ 2
  minimal : ∀ T : Finset W,
    (ofSimple G).boundaryMultiplicity T = 6 →
      IsBipartiteOn G T → T.card ≠ 2 → shore.card ≤ T.card

lemma exists_minimalBipartiteSixShore
    (G : SimpleGraph W) (hexists : ¬ HasNoNontrivialBipartiteSixShore G) :
    Nonempty (MinimalBipartiteSixShore G) := by
  classical
  unfold HasNoNontrivialBipartiteSixShore at hexists
  push Not at hexists
  obtain ⟨S, hcutS, hbipS, hnontrivialS⟩ := hexists
  let p : ℕ → Prop := fun k ↦ ∃ T : Finset W,
    (ofSimple G).boundaryMultiplicity T = 6 ∧
      IsBipartiteOn G T ∧ T.card ≠ 2 ∧ T.card = k
  have hp : ∃ k, p k := ⟨S.card, S, hcutS, hbipS, hnontrivialS, rfl⟩
  obtain ⟨T, hcut, hbip, hnontrivial, hcard⟩ := Nat.find_spec hp
  refine ⟨⟨T, hcut, hbip, hnontrivial, ?_⟩⟩
  intro R hRcut hRbip hRnontrivial
  rw [hcard]
  exact Nat.find_min' hp ⟨R, hRcut, hRbip, hRnontrivial, rfl⟩

lemma MinimalBipartiteSixShore.four_le_card
    {G : SimpleGraph W} (M : MinimalBipartiteSixShore G)
    (hreg : G.IsRegularOfDegree 4) : 4 ≤ M.shore.card := by
  have hne0 : M.shore.card ≠ 0 := by
    intro h
    have hS : M.shore = ∅ := Finset.card_eq_zero.mp h
    have hcut := M.cut
    rw [hS] at hcut
    simp [boundaryMultiplicity] at hcut
  have hne1 : M.shore.card ≠ 1 := by
    intro h
    obtain ⟨v, hv⟩ := Finset.card_eq_one.mp h
    have hfour := boundaryMultiplicity_singleton_of_quartic G hreg v
    have hcut := M.cut
    rw [hv, hfour] at hcut
    omega
  have hne3 := card_ne_three_of_bipartite_six_shore
    G hreg M.shore M.cut M.bipartite
  have hne2 := M.nontrivial
  omega

lemma MinimalBipartiteSixShore.shore_ne_univ
    {G : SimpleGraph W} (M : MinimalBipartiteSixShore G) :
    M.shore ≠ Finset.univ := by
  intro h
  have hcut := M.cut
  rw [h] at hcut
  have huniv : (ofSimple G).boundaryMultiplicity Finset.univ = 0 := by
    calc
      (ofSimple G).boundaryMultiplicity Finset.univ =
          (ofSimple G).boundaryMultiplicity (∅ : Finset W) := by
            simpa using (ofSimple G).boundaryMultiplicity_compl (∅ : Finset W)
      _ = 0 := (ofSimple G).boundaryMultiplicity_empty
  rw [huniv] at hcut
  omega

/-- Minimality and the already excluded two- and nontrivial four-cuts force
each vertex of a minimal bipartite six-shore to carry at most one cut
incidence. -/
lemma MinimalBipartiteSixShore.outsideDegree_le_one
    {G : SimpleGraph W} (M : MinimalBipartiteSixShore G)
    (hreg : G.IsRegularOfDegree 4)
    (hno2 : ∀ S : Finset W, S.Nonempty → S ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset W, S.Nonempty → S ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (v : W) (hv : v ∈ M.shore) :
    (ofSimple G).outsideDegree M.shore v ≤ 1 := by
  classical
  let T := M.shore.erase v
  have hcardS := M.four_le_card hreg
  have hcardT : T.card + 1 = M.shore.card := by
    simpa [T] using Finset.card_erase_add_one hv
  have hTnonempty : T.Nonempty := Finset.card_pos.mp (by omega)
  have hTproper : T ≠ Finset.univ := by
    intro h
    have hvT : v ∈ T := by rw [h]; simp
    exact (Finset.notMem_erase v M.shore) hvT
  have hbetween := between_erase_add_outsideDegree_eq_four
    G hreg M.shore v hv
  have htoggle := Pseudograph.erase_vertex_cut_equation G hreg M.shore v hv
  have hcut := M.cut
  rw [hcut] at htoggle
  have hbetweenT : (ofSimple G).betweenMultiplicity T {v} +
      (ofSimple G).outsideDegree M.shore v = 4 := by
    rw [(ofSimple G).betweenMultiplicity_comm T {v}]
    exact hbetween
  change 6 + 2 * (ofSimple G).betweenMultiplicity T {v} =
      (ofSimple G).boundaryMultiplicity T + 4 at htoggle
  by_contra hnot
  have houtLower : 2 ≤ (ofSimple G).outsideDegree M.shore v := by omega
  have houtUpper : (ofSimple G).outsideDegree M.shore v ≤ 4 := by omega
  have hcases : (ofSimple G).outsideDegree M.shore v = 2 ∨
      (ofSimple G).outsideDegree M.shore v = 3 ∨
      (ofSimple G).outsideDegree M.shore v = 4 := by omega
  rcases hcases with hout | hout | hout
  · have hcutT : (ofSimple G).boundaryMultiplicity T = 6 := by omega
    have hbipT : IsBipartiteOn G T :=
      M.bipartite.mono (Finset.erase_subset v M.shore)
    have hTnontrivial : T.card ≠ 2 := by omega
    have hminimal := M.minimal T hcutT hbipT hTnontrivial
    omega
  · have hcutT : (ofSimple G).boundaryMultiplicity T = 4 := by omega
    rcases hno4 T hTnonempty hTproper hcutT with hTone | hTcomp
    · omega
    · have hvTc : v ∈ Tᶜ := Finset.mem_compl.mpr (Finset.notMem_erase v _)
      obtain ⟨w, hw⟩ := Finset.card_eq_one.mp hTcomp
      have hvw : v = w := by
        have : v ∈ ({w} : Finset W) := by simpa [hw] using hvTc
        simpa using this
      subst w
      have hTuniv : M.shore = Finset.univ := by
        ext x
        constructor
        · intro _
          simp
        · intro _
          by_cases hxv : x = v
          · simpa [hxv] using hv
          · have hxTc : x ∉ Tᶜ := by
              rw [hw]
              simpa [hxv]
            have hxT : x ∈ T := by simpa using hxTc
            exact Finset.mem_of_mem_erase hxT
      exact M.shore_ne_univ hTuniv
  · have hcutT : (ofSimple G).boundaryMultiplicity T = 2 := by omega
    exact hno2 T hTnonempty hTproper hcutT

lemma MinimalBipartiteSixShore.cutEndpoints_injective
    {G : SimpleGraph W} (M : MinimalBipartiteSixShore G)
    (hreg : G.IsRegularOfDegree 4)
    (hno2 : ∀ S : Finset W, S.Nonempty → S ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset W, S.Nonempty → S ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (E : Fin 6 ≃ CrossingEdge (ofSimple G) M.shore) :
    Function.Injective (sixPairEndpoint E) := by
  classical
  intro i j hij
  by_contra hne
  have hval : (E i).inside = (E j).inside := congrArg Subtype.val hij
  let v : W := (E i).inside
  have hvS : v ∈ M.shore := (E i).inside_mem
  have hcount := (ofSimple G).outsideDegree_eq_listingEndpointCount
    M.shore E v hvS
  have htwo : 2 ≤ listingEndpointCount (ofSimple G) M.shore E v := by
    unfold listingEndpointCount
    calc
      2 = ∑ k ∈ ({i, j} : Finset (Fin 6)),
          if (E k).inside = v then 1 else 0 := by
            rw [Finset.sum_insert (by simpa using hne), Finset.sum_singleton]
            simp [v, hval]
      _ ≤ ∑ k ∈ (Finset.univ : Finset (Fin 6)),
          if (E k).inside = v then 1 else 0 := by
            apply Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hone := M.outsideDegree_le_one hreg hno2 hno4 v hvS
  rw [hcount] at hone
  omega

noncomputable def sixLabelCount
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A : Finset S) : ℕ :=
  ((Finset.univ : Finset (Fin 6)).filter fun i ↦ sixPairEndpoint E i ∈ A).card

lemma sum_outsideDegree_eq_sixLabelCount
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) (A : Finset S) :
    (∑ a : A, G.outsideDegree S (a : W)) = sixLabelCount E A := by
  classical
  have hout (a : A) := G.outsideDegree_eq_listingEndpointCount
    S E (a : W) a.1.2
  simp_rw [hout, listingEndpointCount]
  rw [Finset.sum_comm]
  unfold sixLabelCount
  rw [Finset.card_filter]
  apply Finset.sum_congr rfl
  intro i _hi
  by_cases hi : sixPairEndpoint E i ∈ A
  · let a : A := ⟨sixPairEndpoint E i, hi⟩
    rw [show (∑ x : A, if (E i).inside = (x : W) then 1 else 0) = 1 by
      rw [Finset.sum_eq_single a]
      · simp [a, sixPairEndpoint]
      · intro b _hb hba
        have hne : (E i).inside ≠ (b : W) := by
          intro h
          apply hba
          apply Subtype.ext
          apply Subtype.ext
          exact h.symm
        simp [a, sixPairEndpoint, hne]
      · simp]
    simp [hi]
  · have hnone (x : A) : (E i).inside ≠ (x : W) := by
      intro h
      apply hi
      have hs : sixPairEndpoint E i = (x : S) := by
        apply Subtype.ext
        exact h
      rw [hs]
      exact x.2
    simp [hi, hnone]

lemma sixLabelCount_add_of_cover
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (hdisj : Disjoint A B) (hcover : ∀ v : S, v ∈ A ∨ v ∈ B) :
    sixLabelCount E A + sixLabelCount E B = 6 := by
  classical
  let IA := (Finset.univ : Finset (Fin 6)).filter fun i ↦
    sixPairEndpoint E i ∈ A
  let IB := (Finset.univ : Finset (Fin 6)).filter fun i ↦
    sixPairEndpoint E i ∈ B
  have hIAdisj : Disjoint IA IB := by
    rw [Finset.disjoint_left]
    intro i hiA hiB
    have hiA' := (Finset.mem_filter.mp hiA).2
    have hiB' := (Finset.mem_filter.mp hiB).2
    exact (Finset.disjoint_left.mp hdisj) hiA' hiB'
  have hIAcover : IA ∪ IB = Finset.univ := by
    ext i
    have hi := hcover (sixPairEndpoint E i)
    simp only [IA, IB, Finset.mem_union, Finset.mem_filter,
      Finset.mem_univ, true_and]
    constructor
    · intro _
      simp
    · intro _
      exact hi
  change IA.card + IB.card = 6
  rw [← Finset.card_union_of_disjoint hIAdisj, hIAcover]
  decide

/-- The two sides of a bipartite six-shore are either balanced with three
cut ends on each side, or differ by one with cut-end distribution `1,5`. -/
lemma bipartiteSixShore_card_and_labelCount_cases
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (hcut : G.boundaryMultiplicity S = 6)
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B) :
    (A.card = B.card ∧ sixLabelCount E A = 3 ∧ sixLabelCount E B = 3) ∨
    (A.card + 1 = B.card ∧ sixLabelCount E A = 1 ∧ sixLabelCount E B = 5) ∨
    (B.card + 1 = A.card ∧ sixLabelCount E A = 5 ∧
      sixLabelCount E B = 1) := by
  classical
  have hsumA := sum_outsideDegree_eq_sixLabelCount G S E A
  have hsumB := sum_outsideDegree_eq_sixLabelCount G S E B
  have hdegA : (∑ a : A, (G.induce S).degree a) + sixLabelCount E A =
      4 * A.card := by
    rw [← hsumA, ← Finset.sum_add_distrib]
    calc
      (∑ (a : A), ((G.induce S).degree a +
          G.outsideDegree S (a : W))) =
          ∑ _a : A, 4 := by
            apply Finset.sum_congr rfl
            intro a _ha
            exact (G.degree_induce_add_outsideDegree S a a.1.2).trans (hreg a)
      _ = 4 * A.card := by simp [Nat.mul_comm]
  have hdegB : (∑ b : B, (G.induce S).degree b) + sixLabelCount E B =
      4 * B.card := by
    rw [← hsumB, ← Finset.sum_add_distrib]
    calc
      (∑ (b : B), ((G.induce S).degree b +
          G.outsideDegree S (b : W))) =
          ∑ _b : B, 4 := by
            apply Finset.sum_congr rfl
            intro b _hb
            exact (G.degree_induce_add_outsideDegree S b b.1.2).trans (hreg b)
      _ = 4 * B.card := by simp [Nat.mul_comm]
  have hdegreeSums : (∑ a : A, (G.induce S).degree a) =
      ∑ b : B, (G.induce S).degree b := by
    simp_rw [hbip.degree_eq_sum_right, hbip.degree_eq_sum_left]
    exact Finset.sum_comm
  have hcover : ∀ v : S, v ∈ A ∨ v ∈ B := by
    intro v
    by_cases hvA : v ∈ A
    · exact .inl hvA
    · exact .inr (hbip.mem_right_of_not_mem_left hvA)
  have hlabels := sixLabelCount_add_of_cover E A B hbip.disjoint hcover
  omega

lemma exists_isBipartiteWith_induce_of_isBipartiteOn
    (G : SimpleGraph W) (S : Finset W) (hbip : IsBipartiteOn G S) :
    ∃ A B : Finset S, ((ofSimple G).induce S).IsBipartiteWith A B := by
  classical
  obtain ⟨color, hcolor⟩ := hbip
  let A : Finset S := Finset.univ.filter fun v ↦ color v = 0
  let B : Finset S := Finset.univ.filter fun v ↦ color v = 1
  have fin2_cases (i : Fin 2) : i = 0 ∨ i = 1 := by
    refine Fin.cases (.inl rfl) ?_ i
    intro j
    refine Fin.cases (.inr rfl) ?_ j
    exact fun k ↦ Fin.elim0 k
  refine ⟨A, B, ?_, ?_, ?_⟩
  · rw [Finset.disjoint_left]
    intro v hvA hvB
    simp only [A, B, Finset.mem_filter, Finset.mem_univ, true_and] at hvA hvB
    omega
  · ext v
    simp only [A, B, Finset.mem_union, Finset.mem_filter,
      Finset.mem_univ, true_and]
    rcases fin2_cases (color v) with h | h <;> simp [h]
  · intro u v huv
    have hadj : G.Adj u v := by
      rw [induce_mult] at huv
      by_contra hnot
      simp [ofSimple_mult, hnot] at huv
    have hdiff := hcolor u.2 v.2 hadj
    simp only [A, B, Finset.mem_filter, Finset.mem_univ, true_and]
    rcases fin2_cases (color u) with hu | hu <;>
      rcases fin2_cases (color v) with hv | hv <;> simp_all

/-- Interleave two triples as `L₀,R₀,L₁,R₁,L₂,R₂`. -/
noncomputable def finSixAlternatingEquiv : Fin 6 ≃ (Fin 3 ⊕ Fin 3) :=
  Equiv.ofBijective
    (fun i : Fin 6 ↦ ![Sum.inl 0, Sum.inr 0, Sum.inl 1,
      Sum.inr 1, Sum.inl 2, Sum.inr 2] i)
    (by decide)

@[simp] lemma finSixAlternatingEquiv_zero :
    finSixAlternatingEquiv 0 = Sum.inl 0 := rfl
@[simp] lemma finSixAlternatingEquiv_one :
    finSixAlternatingEquiv 1 = Sum.inr 0 := rfl
@[simp] lemma finSixAlternatingEquiv_two :
    finSixAlternatingEquiv 2 = Sum.inl 1 := rfl
@[simp] lemma finSixAlternatingEquiv_three :
    finSixAlternatingEquiv 3 = Sum.inr 1 := rfl
@[simp] lemma finSixAlternatingEquiv_four :
    finSixAlternatingEquiv 4 = Sum.inl 2 := rfl
@[simp] lemma finSixAlternatingEquiv_five :
    finSixAlternatingEquiv 5 = Sum.inr 2 := rfl

/-- The label in an alternating six-listing belonging to the `i`th vertex
of the left bipartition. -/
noncomputable def alternatingLeftLabel (i : Fin 3) : Fin 6 :=
  finSixAlternatingEquiv.symm (Sum.inl i)

/-- The label in an alternating six-listing belonging to the `i`th vertex
of the right bipartition. -/
noncomputable def alternatingRightLabel (i : Fin 3) : Fin 6 :=
  finSixAlternatingEquiv.symm (Sum.inr i)

@[simp] lemma alternatingLeftLabel_zero : alternatingLeftLabel 0 = 0 := by
  apply finSixAlternatingEquiv.injective
  simp [alternatingLeftLabel]

@[simp] lemma alternatingLeftLabel_one : alternatingLeftLabel 1 = 2 := by
  apply finSixAlternatingEquiv.injective
  simp [alternatingLeftLabel]

@[simp] lemma alternatingLeftLabel_two : alternatingLeftLabel 2 = 4 := by
  apply finSixAlternatingEquiv.injective
  simp [alternatingLeftLabel]

@[simp] lemma alternatingRightLabel_zero : alternatingRightLabel 0 = 1 := by
  apply finSixAlternatingEquiv.injective
  simp [alternatingRightLabel]

@[simp] lemma alternatingRightLabel_one : alternatingRightLabel 1 = 3 := by
  apply finSixAlternatingEquiv.injective
  simp [alternatingRightLabel]

@[simp] lemma alternatingRightLabel_two : alternatingRightLabel 2 = 5 := by
  apply finSixAlternatingEquiv.injective
  simp [alternatingRightLabel]

/-- Independently permute the left and right triples of an alternating
six-cut listing.  Consecutive labels then encode the matching between the
two permuted triples. -/
noncomputable def finSixAlternatingReindex
    (eA eB : Fin 3 ≃ Fin 3) : Fin 6 ≃ Fin 6 :=
  finSixAlternatingEquiv.trans
    ((Equiv.sumCongr eA eB).trans finSixAlternatingEquiv.symm)

@[simp] lemma finSixAlternatingReindex_left
    (eA eB : Fin 3 ≃ Fin 3) (i : Fin 3) :
    finSixAlternatingReindex eA eB (alternatingLeftLabel i) =
      alternatingLeftLabel (eA i) := by
  simp [finSixAlternatingReindex, alternatingLeftLabel]

@[simp] lemma finSixAlternatingReindex_right
    (eA eB : Fin 3 ≃ Fin 3) (i : Fin 3) :
    finSixAlternatingReindex eA eB (alternatingRightLabel i) =
      alternatingRightLabel (eB i) := by
  simp [finSixAlternatingReindex, alternatingRightLabel]

lemma finSixAlternatingReindex_preserves_left
    (eA eB : Fin 3 ≃ Fin 3) (i : Fin 6) :
    (∃ j, i = alternatingLeftLabel j) ↔
      ∃ j, finSixAlternatingReindex eA eB i = alternatingLeftLabel j := by
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨eA j, by simp⟩
  · rintro ⟨j, hj⟩
    let k := eA.symm j
    refine ⟨k, ?_⟩
    apply (finSixAlternatingReindex eA eB).injective
    simpa [k] using hj

lemma finSixAlternatingReindex_preserves_right
    (eA eB : Fin 3 ≃ Fin 3) (i : Fin 6) :
    (∃ j, i = alternatingRightLabel j) ↔
      ∃ j, finSixAlternatingReindex eA eB i = alternatingRightLabel j := by
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨eB j, by simp⟩
  · rintro ⟨j, hj⟩
    let k := eB.symm j
    refine ⟨k, ?_⟩
    apply (finSixAlternatingReindex eA eB).injective
    simpa [k] using hj

lemma alternatingLeftLabel_injective : Function.Injective alternatingLeftLabel := by
  intro i j hij
  have hsum : (Sum.inl i : Fin 3 ⊕ Fin 3) = Sum.inl j := by
    have := congrArg finSixAlternatingEquiv hij
    simpa [alternatingLeftLabel] using this
  exact Sum.inl_injective hsum

lemma alternatingRightLabel_injective : Function.Injective alternatingRightLabel := by
  intro i j hij
  have hsum : (Sum.inr i : Fin 3 ⊕ Fin 3) = Sum.inr j := by
    have := congrArg finSixAlternatingEquiv hij
    simpa [alternatingRightLabel] using this
  exact Sum.inr_injective hsum

lemma alternatingLeftLabel_ne_rightLabel (i j : Fin 3) :
    alternatingLeftLabel i ≠ alternatingRightLabel j := by
  intro hij
  have := congrArg finSixAlternatingEquiv hij
  simp [alternatingLeftLabel, alternatingRightLabel] at this

noncomputable def finsetPartitionEquiv
    {X : Type*} [Fintype X] (A B : Finset X)
    (hdisj : Disjoint A B) (hcover : ∀ x : X, x ∈ A ∨ x ∈ B) :
    (A ⊕ B) ≃ X :=
  Equiv.ofBijective (Sum.elim Subtype.val Subtype.val) ⟨by
    intro x y hxy
    rcases x with x | x <;> rcases y with y | y
    · exact congrArg Sum.inl (Subtype.ext hxy)
    · have hxB : (x : X) ∈ B := by
        have hval : (x : X) = (y : X) := by simpa using hxy
        rw [hval]
        exact y.2
      exact False.elim ((Finset.disjoint_left.mp hdisj) x.2 hxB)
    · have hyB : (y : X) ∈ B := by
        have hval : (x : X) = (y : X) := by simpa using hxy
        rw [← hval]
        exact x.2
      exact False.elim ((Finset.disjoint_left.mp hdisj) y.2 hyB)
    · exact congrArg Sum.inr (Subtype.ext hxy), by
      intro x
      rcases hcover x with hx | hx
      · exact ⟨Sum.inl ⟨x, hx⟩, rfl⟩
      · exact ⟨Sum.inr ⟨x, hx⟩, rfl⟩⟩

/-- Reindex a balanced bipartite six-cut so each of the three artificial
closing edges crosses the displayed bipartition. -/
lemma exists_alternatingSixCutListing
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (hdisj : Disjoint A B) (hcover : ∀ v : S, v ∈ A ∨ v ∈ B)
    (hAcount : sixLabelCount E A = 3)
    (hBcount : sixLabelCount E B = 3) :
    ∃ E' : Fin 6 ≃ CrossingEdge G S,
      sixPairEndpoint E' 0 ∈ A ∧ sixPairEndpoint E' 1 ∈ B ∧
      sixPairEndpoint E' 2 ∈ A ∧ sixPairEndpoint E' 3 ∈ B ∧
      sixPairEndpoint E' 4 ∈ A ∧ sixPairEndpoint E' 5 ∈ B := by
  classical
  let IA := (Finset.univ : Finset (Fin 6)).filter fun i ↦
    sixPairEndpoint E i ∈ A
  let IB := (Finset.univ : Finset (Fin 6)).filter fun i ↦
    sixPairEndpoint E i ∈ B
  have hIAcard : Fintype.card IA = 3 := by
    simpa only [Fintype.card_coe] using
      (show IA.card = 3 by simpa [IA, sixLabelCount] using hAcount)
  have hIBcard : Fintype.card IB = 3 := by
    simpa only [Fintype.card_coe] using
      (show IB.card = 3 by simpa [IB, sixLabelCount] using hBcount)
  let eA : IA ≃ Fin 3 := Fintype.equivFinOfCardEq hIAcard
  let eB : IB ≃ Fin 3 := Fintype.equivFinOfCardEq hIBcard
  have hIAdisj : Disjoint IA IB := by
    rw [Finset.disjoint_left]
    intro i hiA hiB
    exact (Finset.disjoint_left.mp hdisj)
      (Finset.mem_filter.mp hiA).2 (Finset.mem_filter.mp hiB).2
  have hIcover : ∀ i : Fin 6, i ∈ IA ∨ i ∈ IB := by
    intro i
    rcases hcover (sixPairEndpoint E i) with hi | hi
    · exact .inl (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩)
    · exact .inr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩)
  let p : (IA ⊕ IB) ≃ Fin 6 :=
    finsetPartitionEquiv IA IB hIAdisj hIcover
  let E' : Fin 6 ≃ CrossingEdge G S :=
    finSixAlternatingEquiv |>.trans
      ((Equiv.sumCongr eA.symm eB.symm).trans (p.trans E))
  refine ⟨E', ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change sixPairEndpoint E (eA.symm 0) ∈ A
    exact (Finset.mem_filter.mp (eA.symm 0).2).2
  · change sixPairEndpoint E (eB.symm 0) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 0).2).2
  · change sixPairEndpoint E (eA.symm 1) ∈ A
    exact (Finset.mem_filter.mp (eA.symm 1).2).2
  · change sixPairEndpoint E (eB.symm 1) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 1).2).2
  · change sixPairEndpoint E (eA.symm 2) ∈ A
    exact (Finset.mem_filter.mp (eA.symm 2).2).2
  · change sixPairEndpoint E (eB.symm 2) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 2).2).2

/-- A six-cut matching closure preserves the boundary of a smaller shore
provided none of its three artificial edges lies completely inside that
shore.  The proof compares the induced graphs and then uses quartic
regularity to recover the number of outgoing incidences. -/
lemma boundaryMultiplicity_closeSixCutMatchingWith_image_of_no_internal
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (U : Finset S)
    (h01 : ¬(sixPairEndpoint E 0 ∈ U ∧ sixPairEndpoint E 1 ∈ U))
    (h23 : ¬(sixPairEndpoint E 2 ∈ U ∧ sixPairEndpoint E 3 ∈ U))
    (h45 : ¬(sixPairEndpoint E 4 ∈ U ∧ sixPairEndpoint E 5 ∈ U)) :
    (G.closeSixCutMatchingWith S E).boundaryMultiplicity U =
      G.boundaryMultiplicity
      (U.map (Function.Embedding.subtype _)) := by
  classical
  let Q := G.closeSixCutMatchingWith S E
  let A : Finset W := U.map (Function.Embedding.subtype _)
  let eA : U ≃ A :=
    finsetMapEquiv U (Function.Embedding.subtype _)
  have hedgeZero (i j : Fin 6)
      (hij : ¬(sixPairEndpoint E i ∈ U ∧
        sixPairEndpoint E j ∈ U)) (x y : U) :
      (singleEdge (sixPairEndpoint E i) (sixPairEndpoint E j)).mult
          (x : S) (y : S) = 0 := by
    rw [singleEdge_mult, if_neg]
    intro hshape
    rcases hshape with hshape | hshape
    · rcases hshape with ⟨hx, hy⟩
      apply hij
      constructor
      · rw [← hx]
        exact x.2
      · rw [← hy]
        exact y.2
    · rcases hshape with ⟨hx, hy⟩
      apply hij
      constructor
      · rw [← hy]
        exact y.2
      · rw [← hx]
        exact x.2
  have hgraphs :
      Q.induce U = (G.induce A).relabel eA.symm := by
    apply Pseudograph.ext
    intro x y
    simp only [induce_mult, relabel_mult, Equiv.symm_symm,
      Equiv.apply_symm_apply]
    change Q.mult (x : S) (y : S) = G.mult (x : W) (y : W)
    rw [show Q.mult (x : S) (y : S) =
        (((G.induce S + singleEdge (sixPairEndpoint E 0)
          (sixPairEndpoint E 1)) + singleEdge (sixPairEndpoint E 2)
          (sixPairEndpoint E 3)) + singleEdge (sixPairEndpoint E 4)
          (sixPairEndpoint E 5)).mult (x : S) (y : S) by rfl]
    simp only [add_mult, induce_mult,
      hedgeZero 0 1 h01 x y, hedgeZero 2 3 h23 x y,
      hedgeZero 4 5 h45 x y, Nat.add_zero]
  have hinducedDegree (x : U) :
      (Q.induce U).degree x = (G.induce A).degree (eA x) := by
    calc
      (Q.induce U).degree x =
          ((G.induce A).relabel eA.symm).degree x := by rw [hgraphs]
      _ = (G.induce A).degree (eA x) := by
        simpa using (G.induce A).degree_relabel eA.symm (eA x)
  have houtside (x : U) :
      Q.outsideDegree U (x : S) =
        G.outsideDegree A (x : W) := by
    have hQ := Q.degree_induce_add_outsideDegree U (x : S) x.2
    have hG := G.degree_induce_add_outsideDegree A (eA x) (eA x).2
    have hQreg : Q.IsRegularOfDegree 4 :=
      G.closeSixCutMatchingWith_isRegularOfDegree S E hreg
    rw [hQreg (x : S)] at hQ
    rw [hreg (eA x)] at hG
    have heA : ((eA x : A) : W) = (x : W) :=
      finsetMapEquiv_apply U (Function.Embedding.subtype _) x
    have hdeg := hinducedDegree x
    have hG' : (G.induce A).degree (eA x) +
        G.outsideDegree A (eA x) = 4 := by simpa using hG
    have hQ' : (G.induce A).degree (eA x) +
        Q.outsideDegree U (x : S) = 4 := by
      rw [← hdeg]
      exact hQ
    have hout : Q.outsideDegree U (x : S) =
        G.outsideDegree A (eA x) := by omega
    simpa only [heA] using hout
  rw [boundaryMultiplicity_eq_sum_outsideDegree,
    boundaryMultiplicity_eq_sum_outsideDegree]
  change (∑ v ∈ U, Q.outsideDegree U v) =
    ∑ v ∈ A, G.outsideDegree A v
  calc
    (∑ v ∈ U, Q.outsideDegree U v) =
        ∑ v ∈ U, G.outsideDegree A v := by
      apply Finset.sum_congr rfl
      intro v hv
      exact houtside ⟨v, hv⟩
    _ = ∑ v ∈ A, G.outsideDegree A v := by
      symm
      exact Finset.sum_map U (Function.Embedding.subtype _) _

lemma IsBipartiteWith.internalMultiplicity_eq_zero_of_subset_left
    {P : Pseudograph W} {A B T : Finset W}
    (hbip : P.IsBipartiteWith A B) (hTA : T ⊆ A) :
    P.internalMultiplicity T = 0 := by
  classical
  unfold internalMultiplicity
  apply Finset.sum_eq_zero
  intro e _he
  induction e using Sym2.inductionOn with
  | _ u v =>
      by_cases hu : u ∈ T <;> by_cases hv : v ∈ T
      · have huA := hTA hu
        have hvA := hTA hv
        by_cases hpos : 0 < P.mult u v
        · rcases hbip.crosses hpos with hcross | hcross
          · exact False.elim
              ((Finset.disjoint_left.mp hbip.disjoint) hvA hcross.2)
          · exact False.elim
              ((Finset.disjoint_left.mp hbip.disjoint) huA hcross.1)
        · have hzero : P.mult u v = 0 := by omega
          simp [hzero]
      all_goals simp [internalIndicator_mk, hu, hv]

lemma IsBipartiteWith.swap
    {P : Pseudograph W} {A B : Finset W}
    (hbip : P.IsBipartiteWith A B) : P.IsBipartiteWith B A := by
  refine ⟨hbip.disjoint.symm, ?_, ?_⟩
  · simpa [Finset.union_comm] using hbip.cover
  · intro u v huv
    rcases hbip.crosses huv with h | h
    · exact .inr h
    · exact .inl h

lemma IsBipartiteWith.sdiff_right
    {P H : Pseudograph W} {A B : Finset W}
    (hbip : P.IsBipartiteWith A B) :
    (P.sdiff H).IsBipartiteWith A B := by
  refine ⟨hbip.disjoint, hbip.cover, ?_⟩
  intro u v huv
  apply hbip.crosses
  change 0 < P.mult u v - H.mult u v at huv
  omega

/-- Regard a subgraph of the underlying simple graph of a part as a
subgraph of the underlying graph of the ambient pseudograph. -/
def liftUnderlyingSubgraphOfPart
    {P Q : Pseudograph W} (hPQ : P.IsPart Q)
    (M : P.toSimple.Subgraph) : Q.toSimple.Subgraph where
  verts := M.verts
  Adj := M.Adj
  adj_sub := by
    intro u v huv
    have hP := M.adj_sub huv
    exact ⟨hP.1, lt_of_lt_of_le hP.2 (hPQ u v)⟩
  edge_vert := M.edge_vert
  symm := M.symm

lemma liftUnderlyingSubgraphOfPart_isPerfectMatching
    {P Q : Pseudograph W} (hPQ : P.IsPart Q)
    (M : P.toSimple.Subgraph) (hM : M.IsPerfectMatching) :
    (liftUnderlyingSubgraphOfPart hPQ M).IsPerfectMatching := by
  exact hM

lemma ofUnderlyingSubgraph_liftUnderlyingSubgraphOfPart_isPart
    {P Q : Pseudograph W} (hPQ : P.IsPart Q)
    (M : P.toSimple.Subgraph) :
    (Q.ofUnderlyingSubgraph (liftUnderlyingSubgraphOfPart hPQ M)).IsPart P := by
  intro u v
  simpa [ofUnderlyingSubgraph, ofSimple_mult,
    liftUnderlyingSubgraphOfPart] using P.ofUnderlyingSubgraph_isPart M u v

@[simp]
lemma liftUnderlyingSubgraphOfPart_adj
    {P Q : Pseudograph W} (hPQ : P.IsPart Q)
    (M : P.toSimple.Subgraph) (u v : W) :
    (liftUnderlyingSubgraphOfPart hPQ M).Adj u v ↔ M.Adj u v :=
  Iff.rfl

lemma IsBipartiteWith.internalMultiplicity_eq_zero_of_subset_right
    {P : Pseudograph W} {A B T : Finset W}
    (hbip : P.IsBipartiteWith A B) (hTB : T ⊆ B) :
    P.internalMultiplicity T = 0 := by
  exact (hbip.swap.internalMultiplicity_eq_zero_of_subset_left hTB)

/-- A closed Hall-defect pair in opposite shores of a quartic bipartite
pseudograph cuts off exactly four edges when the right block has one more
vertex than the left block. -/
lemma boundaryMultiplicity_union_eq_four_of_bipartite_neighbor_closed
    [DecidableEq W]
    (P : Pseudograph W) (hreg : P.IsRegularOfDegree 4)
    (A B U T : Finset W) (hbip : P.IsBipartiteWith A B)
    (hUA : U ⊆ A) (hTB : T ⊆ B)
    (hcard : T.card = U.card + 1)
    (hclosed : ∀ u ∈ U, ∀ w, 0 < P.mult u w → w ∈ T) :
    P.boundaryMultiplicity (U ∪ T) = 4 := by
  classical
  have hUT : Disjoint U T :=
    Disjoint.mono hUA hTB hbip.disjoint
  have hintU : P.internalMultiplicity U = 0 :=
    hbip.internalMultiplicity_eq_zero_of_subset_left hUA
  have hintT : P.internalMultiplicity T = 0 :=
    hbip.internalMultiplicity_eq_zero_of_subset_right hTB
  have hbetween : P.betweenMultiplicity U T = 4 * U.card := by
    rw [P.betweenMultiplicity_eq_sum_singleton_left U T hUT]
    calc
      (∑ u ∈ U, P.betweenMultiplicity {u} T) =
          ∑ _u ∈ U, 4 := by
        apply Finset.sum_congr rfl
        intro u hu
        have huA := hUA hu
        have huT : u ∉ T := by
          intro huT
          exact (Finset.disjoint_left.mp hUT) hu huT
        rw [P.betweenMultiplicity_singleton u T huT]
        have hloop : P.mult u u = 0 := by
          by_contra hne
          have hpos : 0 < P.mult u u := Nat.pos_of_ne_zero hne
          rcases hbip.crosses hpos with h | h
          · exact (Finset.disjoint_left.mp hbip.disjoint) h.1 h.2
          · exact (Finset.disjoint_left.mp hbip.disjoint) h.2 h.1
        rw [← hreg u, degree_eq_mult_self_add_sum, hloop,
          Nat.zero_add]
        apply Finset.sum_subset
        · intro w hw
          have hwT := hTB hw
          have hwu : w ≠ u := by
            intro hwu
            subst w
            exact (Finset.disjoint_left.mp hbip.disjoint) huA hwT
          simp [hwu]
        · intro w hwAll hwT
          have hzero : P.mult u w = 0 := by
            by_contra hne
            exact hwT (hclosed u hu w (Nat.pos_of_ne_zero hne))
          exact hzero
      _ = 4 * U.card := by simp [Nat.mul_comm]
  have hint : P.internalMultiplicity (U ∪ T) =
      P.internalMultiplicity U + P.internalMultiplicity T +
        P.betweenMultiplicity U T := by
    unfold internalMultiplicity betweenMultiplicity
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro e _
    induction e using Sym2.inductionOn with
    | _ a b =>
        have hUTa : ¬ (a ∈ U ∧ a ∈ T) := by
          exact fun h ↦ (Finset.disjoint_left.mp hUT) h.1 h.2
        have hUTb : ¬ (b ∈ U ∧ b ∈ T) := by
          exact fun h ↦ (Finset.disjoint_left.mp hUT) h.1 h.2
        by_cases haU : a ∈ U <;> by_cases hbU : b ∈ U <;>
          by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T
        all_goals simp [internalIndicator_mk, betweenIndicator_mk,
          haU, hbU, haT, hbT] at *
        all_goals ring
  rw [hintU, hintT, hbetween] at hint
  have hYcard : (U ∪ T).card = U.card + T.card :=
    Finset.card_union_of_disjoint hUT
  have hledger := P.regular_card_eq_two_internal_add_boundary
    hreg (U ∪ T)
  rw [hint] at hledger
  rw [hYcard, hcard] at hledger
  omega

/-- A Hall transversal on the remaining two shores, together with two
vertex-disjoint prescribed edges, is a perfect matching containing both
prescribed edges. -/
lemma exists_isPerfectMatching_of_transversal_and_two_edges
    [DecidableEq W]
    (K : SimpleGraph W) (L R : Finset W) {a b c d : W}
    (hLR : Disjoint L R) (hcard : L.card = R.card)
    (ha : a ∉ L ∧ a ∉ R) (hb : b ∉ L ∧ b ∉ R)
    (hc : c ∉ L ∧ c ∉ R) (hd : d ∉ L ∧ d ∉ R)
    (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d)
    (hcover : ∀ v : W,
      v ∈ L ∨ v ∈ R ∨ v = a ∨ v = b ∨ v = c ∨ v = d)
    (hab : K.Adj a b) (hcd : K.Adj c d)
    (f : L → R) (hinj : Function.Injective f)
    (hadj : ∀ l : L, K.Adj l (f l)) :
    ∃ M : K.Subgraph,
      M.IsPerfectMatching ∧ M.Adj a b ∧ M.Adj c d := by
  classical
  let P := transversalSubgraph K L R f hadj
  let E₁ : K.Subgraph := K.subgraphOfAdj hab
  let E₂ : K.Subgraph := K.subgraphOfAdj hcd
  have hP : P.IsMatching :=
    transversalSubgraph_isMatching K L R hLR hcard f hinj hadj
  have hPverts : P.verts = (L : Set W) ∪ (R : Set W) := by
    ext v
    simp [P, transversalSubgraph]
  have hE₁ : E₁.IsMatching :=
    SimpleGraph.Subgraph.IsMatching.subgraphOfAdj hab
  have hE₂ : E₂.IsMatching :=
    SimpleGraph.Subgraph.IsMatching.subgraphOfAdj hcd
  have hPE₁ : Disjoint P.support E₁.support := by
    rw [hP.support_eq_verts, SimpleGraph.support_subgraphOfAdj]
    apply Set.disjoint_left.mpr
    intro v hvP hvab
    have hvP' : v ∈ L ∨ v ∈ R := by
      simpa only [P, transversalSubgraph, Finset.coe_union,
        Set.mem_union, Finset.mem_coe] using hvP
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hvab
    rcases hvab with rfl | rfl
    · exact hvP'.elim ha.1 ha.2
    · exact hvP'.elim hb.1 hb.2
  have hPE₂ : Disjoint P.support E₂.support := by
    rw [hP.support_eq_verts, SimpleGraph.support_subgraphOfAdj]
    apply Set.disjoint_left.mpr
    intro v hvP hvcd
    have hvP' : v ∈ L ∨ v ∈ R := by
      simpa only [P, transversalSubgraph, Finset.coe_union,
        Set.mem_union, Finset.mem_coe] using hvP
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hvcd
    rcases hvcd with rfl | rfl
    · exact hvP'.elim hc.1 hc.2
    · exact hvP'.elim hd.1 hd.2
  have hE₁E₂ : Disjoint E₁.support E₂.support := by
    rw [SimpleGraph.support_subgraphOfAdj,
      SimpleGraph.support_subgraphOfAdj]
    apply Set.disjoint_left.mpr
    intro x hx₁ hx₂
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx₁ hx₂
    rcases hx₁ with rfl | rfl <;> rcases hx₂ with rfl | rfl
    · exact hac rfl
    · exact had rfl
    · exact hbc rfl
    · exact hbd rfl
  let M := (P ⊔ E₁) ⊔ E₂
  have hPE₁match : (P ⊔ E₁).IsMatching := hP.sup hE₁ hPE₁
  have hPE₁E₂ : Disjoint (P ⊔ E₁).support E₂.support := by
    rw [hPE₁match.support_eq_verts, SimpleGraph.Subgraph.verts_sup,
      ← hP.support_eq_verts, ← hE₁.support_eq_verts]
    exact Set.disjoint_union_left.mpr ⟨hPE₂, hE₁E₂⟩
  have hMmatch : M.IsMatching := hPE₁match.sup hE₂ hPE₁E₂
  have hMspan : M.IsSpanning := by
    rw [SimpleGraph.Subgraph.isSpanning_iff]
    change ((P ⊔ E₁) ⊔ E₂).verts = Set.univ
    rw [SimpleGraph.Subgraph.verts_sup, SimpleGraph.Subgraph.verts_sup,
      SimpleGraph.subgraphOfAdj_verts, SimpleGraph.subgraphOfAdj_verts]
    rw [hPverts]
    ext v
    simp only [Set.mem_union, Finset.mem_coe,
      Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true,
      Finset.mem_union]
    have hv := hcover v
    tauto
  refine ⟨M, ⟨hMmatch, hMspan⟩, ?_, ?_⟩
  · change ((P ⊔ E₁) ⊔ E₂).Adj a b
    exact .inl (.inr (K.subgraphOfAdj_adj_self hab))
  · change ((P ⊔ E₁) ⊔ E₂).Adj c d
    exact .inr (K.subgraphOfAdj_adj_self hcd)

/-- In the balanced case of Proposition 3.6, the first two artificial
edges of the bipartite matching closure extend to a perfect matching.  A
Hall defect would cut the closure into complementary nontrivial four-edge
shores; one of those shores contains no artificial edge internally, so it
pulls back to a forbidden nontrivial four-cut of the original graph. -/
lemma exists_perfectMatching_closeSix_containing_first_two
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      G.boundaryMultiplicity T = 4 → T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card = B.card)
    (h0 : sixPairEndpoint E 0 ∈ A)
    (h1 : sixPairEndpoint E 1 ∈ B)
    (h2 : sixPairEndpoint E 2 ∈ A)
    (h3 : sixPairEndpoint E 3 ∈ B)
    (h4 : sixPairEndpoint E 4 ∈ A)
    (h5 : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    ∃ M : (G.closeSixCutMatchingWith S E).toSimple.Subgraph,
      M.IsPerfectMatching ∧
      M.Adj (sixPairEndpoint E 0) (sixPairEndpoint E 1) ∧
      M.Adj (sixPairEndpoint E 2) (sixPairEndpoint E 3) := by
  classical
  let Q := G.closeSixCutMatchingWith S E
  let a₀ := sixPairEndpoint E 0
  let b₁ := sixPairEndpoint E 1
  let a₂ := sixPairEndpoint E 2
  let b₃ := sixPairEndpoint E 3
  let a₄ := sixPairEndpoint E 4
  let b₅ := sixPairEndpoint E 5
  have hne (i j : Fin 6) (hij : i ≠ j) :
      sixPairEndpoint E i ≠ sixPairEndpoint E j := fun h ↦ hij (hinj h)
  have ha₀A : a₀ ∈ A := h0
  have hb₁B : b₁ ∈ B := h1
  have ha₂A : a₂ ∈ A := h2
  have hb₃B : b₃ ∈ B := h3
  have ha₄A : a₄ ∈ A := h4
  have hb₅B : b₅ ∈ B := h5
  have ha₀a₂ : a₀ ≠ a₂ := hne 0 2 (by decide)
  have hb₁b₃ : b₁ ≠ b₃ := hne 1 3 (by decide)
  have hQbip : Q.IsBipartiteWith A B :=
    closeSixCutMatchingWith_isBipartiteWith E A B hbip
      (.inl ⟨h0, h1⟩) (.inl ⟨h2, h3⟩) (.inl ⟨h4, h5⟩)
  have hQreg : Q.IsRegularOfDegree 4 :=
    G.closeSixCutMatchingWith_isRegularOfDegree S E hreg
  let L : Finset S := A \ {a₀, a₂}
  let R : Finset S := B \ {b₁, b₃}
  have hpairAsub : ({a₀, a₂} : Finset S) ⊆ A := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with hx | hx
    · exact hx ▸ ha₀A
    · exact hx ▸ ha₂A
  have hpairBsub : ({b₁, b₃} : Finset S) ⊆ B := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with hx | hx
    · exact hx ▸ hb₁B
    · exact hx ▸ hb₃B
  have hLcard : L.card + 2 = A.card := by
    have h := Finset.card_sdiff_add_card_eq_card hpairAsub
    simpa [L, ha₀a₂] using h
  have hRcard : R.card + 2 = B.card := by
    have h := Finset.card_sdiff_add_card_eq_card hpairBsub
    simpa [R, hb₁b₃] using h
  have hLRcard : L.card = R.card := by omega
  have hLsubA : L ⊆ A := fun _ hx ↦ (Finset.mem_sdiff.mp hx).1
  have hRsubB : R ⊆ B := fun _ hx ↦ (Finset.mem_sdiff.mp hx).1
  have hLRdisj : Disjoint L R := by
    exact Disjoint.mono hLsubA hRsubB hbip.disjoint
  have ha₀LR : a₀ ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
    · exact (Finset.disjoint_left.mp hbip.disjoint) ha₀A
        (Finset.mem_sdiff.mp hmem).1
  have hb₁LR : b₁ ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.disjoint_left.mp hbip.disjoint)
        (Finset.mem_sdiff.mp hmem).1 hb₁B
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
  have ha₂LR : a₂ ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
    · exact (Finset.disjoint_left.mp hbip.disjoint) ha₂A
        (Finset.mem_sdiff.mp hmem).1
  have hb₃LR : b₃ ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.disjoint_left.mp hbip.disjoint)
        (Finset.mem_sdiff.mp hmem).1 hb₃B
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
  have hcover (v : S) :
      v ∈ L ∨ v ∈ R ∨ v = a₀ ∨ v = b₁ ∨ v = a₂ ∨ v = b₃ := by
    have hvAB : v ∈ A ∨ v ∈ B := by
      have hv : v ∈ Finset.univ := Finset.mem_univ v
      rw [← hbip.cover] at hv
      simpa only [Finset.mem_union] using hv
    rcases hvAB with hvA | hvB
    · by_cases hva₀ : v = a₀
      · exact .inr (.inr (.inl hva₀))
      · by_cases hva₂ : v = a₂
        · exact .inr (.inr (.inr (.inr (.inl hva₂))))
        · have hvL : v ∈ L := Finset.mem_sdiff.mpr
            ⟨hvA, by simp [hva₀, hva₂]⟩
          exact .inl hvL
    · by_cases hvb₁ : v = b₁
      · exact .inr (.inr (.inr (.inl hvb₁)))
      · by_cases hvb₃ : v = b₃
        · exact .inr (.inr (.inr (.inr (.inr hvb₃))))
        · have hvR : v ∈ R := Finset.mem_sdiff.mpr
            ⟨hvB, by simp [hvb₁, hvb₃]⟩
          exact .inr (.inl hvR)
  have hQ01 : Q.toSimple.Adj a₀ b₁ := by
    refine ⟨hne 0 1 (by decide), ?_⟩
    change 0 < (G.closeSixCutMatchingWith S E).mult
      (sixPairEndpoint E 0) (sixPairEndpoint E 1)
    rw [closeSixCutMatchingWith_mult_pair01 E hinj]
    omega
  have hQ23 : Q.toSimple.Adj a₂ b₃ := by
    refine ⟨hne 2 3 (by decide), ?_⟩
    change 0 < (G.closeSixCutMatchingWith S E).mult
      (sixPairEndpoint E 2) (sixPairEndpoint E 3)
    rw [closeSixCutMatchingWith_mult_pair23 E hinj]
    omega
  let rel : L → R → Prop := fun x y ↦ Q.toSimple.Adj x y
  by_cases htrans : ∃ f : L → R, Function.Injective f ∧
      ∀ x, rel x (f x)
  · obtain ⟨f, hf, hadj⟩ := htrans
    obtain ⟨M, hM, hM01, hM23⟩ :=
      exists_isPerfectMatching_of_transversal_and_two_edges
      Q.toSimple L R hLRdisj hLRcard
        ⟨fun h ↦ ha₀LR (Finset.mem_union_left R h),
          fun h ↦ ha₀LR (Finset.mem_union_right L h)⟩
        ⟨fun h ↦ hb₁LR (Finset.mem_union_left R h),
          fun h ↦ hb₁LR (Finset.mem_union_right L h)⟩
        ⟨fun h ↦ ha₂LR (Finset.mem_union_left R h),
          fun h ↦ ha₂LR (Finset.mem_union_right L h)⟩
        ⟨fun h ↦ hb₃LR (Finset.mem_union_left R h),
          fun h ↦ hb₃LR (Finset.mem_union_right L h)⟩
        (hne 0 2 (by decide)) (hne 0 3 (by decide))
        (hne 1 2 (by decide)) (hne 1 3 (by decide))
        hcover hQ01 hQ23 f hf hadj
    exact ⟨M, hM, by simpa [a₀, b₁] using hM01,
      by simpa [a₂, b₃] using hM23⟩
  · have htypeCard : Fintype.card L = Fintype.card R := by
      simpa using hLRcard
    obtain ⟨U', T', hUTcard, hneighbor⟩ :=
      exists_exact_hallDefect rel htypeCard htrans
    let U : Finset S := U'.image Subtype.val
    let T₀ : Finset S := T'.image Subtype.val
    let T : Finset S := T₀ ∪ {b₁, b₃}
    let Y : Finset S := U ∪ T
    let Z : Finset S := Yᶜ
    have hUsubL : U ⊆ L := by
      intro x hx
      obtain ⟨x', _hxU, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    have hT₀subR : T₀ ⊆ R := by
      intro x hx
      obtain ⟨x', _hxT, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    have hb₁T₀ : b₁ ∉ T₀ := by
      intro hmem
      exact (Finset.mem_sdiff.mp (hT₀subR hmem)).2 (by simp)
    have hb₃T₀ : b₃ ∉ T₀ := by
      intro hmem
      exact (Finset.mem_sdiff.mp (hT₀subR hmem)).2 (by simp)
    have hTcard : T.card = U.card + 1 := by
      have hUcard : U.card = U'.card := by
        simp [U, Finset.card_image_of_injective _ Subtype.val_injective]
      have hT₀card : T₀.card = T'.card := by
        simp [T₀, Finset.card_image_of_injective _ Subtype.val_injective]
      have hdis : Disjoint T₀ ({b₁, b₃} : Finset S) := by
        rw [Finset.disjoint_left]
        intro x hx hxpair
        simp only [Finset.mem_insert, Finset.mem_singleton] at hxpair
        rcases hxpair with hxpair | hxpair
        · exact hb₁T₀ (hxpair ▸ hx)
        · exact hb₃T₀ (hxpair ▸ hx)
      change (T₀ ∪ {b₁, b₃}).card = U.card + 1
      rw [Finset.card_union_of_disjoint hdis]
      simp [hb₁b₃, hUcard, hT₀card]
      omega
    have hUsubA : U ⊆ A :=
      hUsubL.trans hLsubA
    have hTsubB : T ⊆ B := by
      intro x hx
      rcases Finset.mem_union.mp hx with hx | hx
      · exact hRsubB (hT₀subR hx)
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with hx | hx
        · exact hx ▸ hb₁B
        · exact hx ▸ hb₃B
    have hclosed : ∀ u ∈ U, ∀ w, 0 < Q.mult u w → w ∈ T := by
      intro u hu w huw
      have huA := hUsubA hu
      have hwB : w ∈ B := by
        rcases hQbip.crosses huw with h | h
        · exact h.2
        · exact False.elim
            ((Finset.disjoint_left.mp hQbip.disjoint) huA h.1)
      by_cases hwb₁ : w = b₁
      · simp [T, hwb₁]
      by_cases hwb₃ : w = b₃
      · simp [T, hwb₃]
      have hwR : w ∈ R := Finset.mem_sdiff.mpr
        ⟨hwB, by simp [hwb₁, hwb₃]⟩
      obtain ⟨u', hu'U, hu'eq⟩ := Finset.mem_image.mp hu
      let w' : R := ⟨w, hwR⟩
      have hrel : rel u' w' := by
        change Q.toSimple.Adj (u' : S) (w' : S)
        refine ⟨?_, ?_⟩
        · intro heq
          have huwEq : u = w := hu'eq.symm.trans heq
          exact (Finset.disjoint_left.mp hQbip.disjoint) huA
            (huwEq ▸ hwB)
        · simpa [hu'eq] using huw
      have hwT' := hneighbor u' hu'U w' hrel
      apply Finset.mem_union_left
      exact Finset.mem_image.mpr ⟨w', hwT', rfl⟩
    have hQcutY : Q.boundaryMultiplicity Y = 4 := by
      change Q.boundaryMultiplicity (U ∪ T) = 4
      exact boundaryMultiplicity_union_eq_four_of_bipartite_neighbor_closed
        Q hQreg A B U T hQbip hUsubA hTsubB hTcard hclosed
    have hQcutZ : Q.boundaryMultiplicity Z = 4 := by
      have hcomp : Q.boundaryMultiplicity Z =
          Q.boundaryMultiplicity Y := by
        unfold boundaryMultiplicity
        apply Finset.sum_congr rfl
        intro e _he
        congr 1
        induction e using Sym2.inductionOn with
        | _ u v =>
            by_cases hu : u ∈ Y <;> by_cases hv : v ∈ Y <;>
              simp [Z, crossingIndicator, hu, hv]
      exact hcomp.trans hQcutY
    have ha₀notY : a₀ ∉ Y := by
      intro haY
      rcases Finset.mem_union.mp haY with haU | haT
      · exact (Finset.mem_sdiff.mp (hUsubL haU)).2 (by simp)
      · exact (Finset.disjoint_left.mp hbip.disjoint) ha₀A (hTsubB haT)
    have ha₂notY : a₂ ∉ Y := by
      intro haY
      rcases Finset.mem_union.mp haY with haU | haT
      · exact (Finset.mem_sdiff.mp (hUsubL haU)).2 (by simp)
      · exact (Finset.disjoint_left.mp hbip.disjoint) ha₂A (hTsubB haT)
    have hb₁Y : b₁ ∈ Y := by simp [Y, T]
    have hb₃Y : b₃ ∈ Y := by simp [Y, T]
    have h01Y : ¬(sixPairEndpoint E 0 ∈ Y ∧
        sixPairEndpoint E 1 ∈ Y) := by
      intro h
      exact ha₀notY (by simpa [a₀] using h.1)
    have h23Y : ¬(sixPairEndpoint E 2 ∈ Y ∧
        sixPairEndpoint E 3 ∈ Y) := by
      intro h
      exact ha₂notY (by simpa [a₂] using h.1)
    have h01Z : ¬(sixPairEndpoint E 0 ∈ Z ∧
        sixPairEndpoint E 1 ∈ Z) := by
      intro h
      exact (Finset.mem_compl.mp h.2) (by simpa [b₁] using hb₁Y)
    have h23Z : ¬(sixPairEndpoint E 2 ∈ Z ∧
        sixPairEndpoint E 3 ∈ Z) := by
      intro h
      exact (Finset.mem_compl.mp h.2) (by simpa [b₃] using hb₃Y)
    have contradictFour (R₀ : Finset S)
        (hcutR : Q.boundaryMultiplicity R₀ = 4)
        (hno01 : ¬(sixPairEndpoint E 0 ∈ R₀ ∧
          sixPairEndpoint E 1 ∈ R₀))
        (hno23 : ¬(sixPairEndpoint E 2 ∈ R₀ ∧
          sixPairEndpoint E 3 ∈ R₀))
        (hno45 : ¬(sixPairEndpoint E 4 ∈ R₀ ∧
          sixPairEndpoint E 5 ∈ R₀))
        (hx hy : S) (hxR : hx ∈ R₀) (hyR : hy ∈ R₀) (hxy : hx ≠ hy)
        (p q : S) (hpR : p ∉ R₀) (hqR : q ∉ R₀) (hpq : p ≠ q) : False := by
      let Rw : Finset W := R₀.map (Function.Embedding.subtype _)
      have hcutRw : G.boundaryMultiplicity Rw = 4 := by
        rw [← boundaryMultiplicity_closeSixCutMatchingWith_image_of_no_internal
          G hreg S E R₀ hno01 hno23 hno45]
        exact hcutR
      have hRwNonempty : Rw.Nonempty := by
        exact ⟨(hx : W), Finset.mem_map.mpr ⟨hx, hxR, rfl⟩⟩
      have hRwProper : Rw ≠ Finset.univ := by
        intro huniv
        have hpmap : (p : W) ∈ Rw := by rw [huniv]; simp
        obtain ⟨p', hp', heq⟩ := Finset.mem_map.mp hpmap
        apply hpR
        have hp'eq : p' = p := by
          apply Subtype.ext
          exact heq
        simpa [hp'eq] using hp'
      have hRwTwo : 2 ≤ Rw.card := by
        have hpair : ({(hx : W), (hy : W)} : Finset W) ⊆ Rw := by
          intro z hz
          simp only [Finset.mem_insert, Finset.mem_singleton] at hz
          rcases hz with rfl | rfl
          · exact Finset.mem_map.mpr ⟨hx, hxR, rfl⟩
          · exact Finset.mem_map.mpr ⟨hy, hyR, rfl⟩
        have hcardPair : ({(hx : W), (hy : W)} : Finset W).card = 2 := by
          simp [Subtype.coe_injective.ne hxy]
        exact hcardPair ▸ Finset.card_le_card hpair
      have hcompTwo : 2 ≤ Rwᶜ.card := by
        have hpair : ({(p : W), (q : W)} : Finset W) ⊆ Rwᶜ := by
          intro z hz
          simp only [Finset.mem_insert, Finset.mem_singleton] at hz
          apply Finset.mem_compl.mpr
          intro hzRw
          obtain ⟨z', hz', heq⟩ := Finset.mem_map.mp hzRw
          rcases hz with rfl | rfl
          · apply hpR
            have hz'eq : z' = p := by apply Subtype.ext; exact heq
            simpa [hz'eq] using hz'
          · apply hqR
            have hz'eq : z' = q := by apply Subtype.ext; exact heq
            simpa [hz'eq] using hz'
        have hcardPair : ({(p : W), (q : W)} : Finset W).card = 2 := by
          simp [Subtype.coe_injective.ne hpq]
        exact hcardPair ▸ Finset.card_le_card hpair
      rcases hno4 Rw hRwNonempty hRwProper hcutRw with h | h <;> omega
    by_cases h45Y : sixPairEndpoint E 4 ∈ Y ∧ sixPairEndpoint E 5 ∈ Y
    · have h45Z : ¬(sixPairEndpoint E 4 ∈ Z ∧
          sixPairEndpoint E 5 ∈ Z) := by
        intro h
        exact (Finset.mem_compl.mp h.1) h45Y.1
      exact False.elim (contradictFour Z hQcutZ h01Z h23Z h45Z
        a₀ a₂ (by simpa [Z] using ha₀notY) (by simpa [Z] using ha₂notY)
        ha₀a₂ b₁ b₃ (by simpa [Z] using hb₁Y) (by simpa [Z] using hb₃Y)
        hb₁b₃)
    · exact False.elim (contradictFour Y hQcutY h01Y h23Y h45Y
        b₁ b₃ hb₁Y hb₃Y hb₁b₃ a₀ a₂ ha₀notY ha₂notY ha₀a₂)

/-- If a perfect matching of a six-cut matching closure uses all three
artificial endpoint pairs, its cubic complement uses no artificial copy
and is therefore already a cubic part of the original pseudograph. -/
lemma containsRegularPart_of_perfectMatching_closeSix_containing_all
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (M : (G.closeSixCutMatchingWith S E).toSimple.Subgraph)
    (hM : M.IsPerfectMatching)
    (h01 : M.Adj (sixPairEndpoint E 0) (sixPairEndpoint E 1))
    (h23 : M.Adj (sixPairEndpoint E 2) (sixPairEndpoint E 3))
    (h45 : M.Adj (sixPairEndpoint E 4) (sixPairEndpoint E 5)) :
    G.ContainsRegularPart 3 := by
  classical
  let Q := G.closeSixCutMatchingWith S E
  let F := Q.ofUnderlyingSubgraph M
  let H := Q.sdiff F
  let C : Pseudograph S :=
    (singleEdge (sixPairEndpoint E 0) (sixPairEndpoint E 1) +
      singleEdge (sixPairEndpoint E 2) (sixPairEndpoint E 3)) +
      singleEdge (sixPairEndpoint E 4) (sixPairEndpoint E 5)
  have hFQ : F.IsPart Q := Q.ofUnderlyingSubgraph_isPart M
  have hQreg : Q.IsRegularOfDegree 4 :=
    G.closeSixCutMatchingWith_isRegularOfDegree S E hreg
  have hHdeg (v : S) : H.degree v = 3 := by
    have hdiff := Q.degree_sdiff_add F hFQ v
    have hFdeg : F.degree v = 1 :=
      Q.degree_ofUnderlyingSubgraph_of_isPerfectMatching M hM v
    change H.degree v + F.degree v = Q.degree v at hdiff
    rw [hFdeg, hQreg v] at hdiff
    omega
  have hne (i j : Fin 6) (hij : i ≠ j) :
      sixPairEndpoint E i ≠ sixPairEndpoint E j := fun h ↦ hij (hinj h)
  have hshapeDisjoint (i j k l : Fin 6)
      (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l)
      (x y : S) :
      ¬(((x = sixPairEndpoint E i ∧ y = sixPairEndpoint E j) ∨
          (x = sixPairEndpoint E j ∧ y = sixPairEndpoint E i)) ∧
        ((x = sixPairEndpoint E k ∧ y = sixPairEndpoint E l) ∨
          (x = sixPairEndpoint E l ∧ y = sixPairEndpoint E k))) := by
    rintro ⟨h, h'⟩
    rcases h with h | h <;> rcases h' with h' | h'
    · exact (hne i k hik) (h.1.symm.trans h'.1)
    · exact (hne i l hil) (h.1.symm.trans h'.1)
    · exact (hne j k hjk) (h.1.symm.trans h'.1)
    · exact (hne j l hjl) (h.1.symm.trans h'.1)
  have hFone_of_shape (i j : Fin 6)
      (hij : M.Adj (sixPairEndpoint E i) (sixPairEndpoint E j))
      (x y : S)
      (hshape : (x = sixPairEndpoint E i ∧ y = sixPairEndpoint E j) ∨
        (x = sixPairEndpoint E j ∧ y = sixPairEndpoint E i)) :
      F.mult x y = 1 := by
    rcases hshape with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · simp [F, ofUnderlyingSubgraph, hij]
    · simp [F, ofUnderlyingSubgraph, hij.symm]
  have hC_le_F (x y : S) : C.mult x y ≤ F.mult x y := by
    let shape01 : Prop :=
      (x = sixPairEndpoint E 0 ∧ y = sixPairEndpoint E 1) ∨
        (x = sixPairEndpoint E 1 ∧ y = sixPairEndpoint E 0)
    let shape23 : Prop :=
      (x = sixPairEndpoint E 2 ∧ y = sixPairEndpoint E 3) ∨
        (x = sixPairEndpoint E 3 ∧ y = sixPairEndpoint E 2)
    let shape45 : Prop :=
      (x = sixPairEndpoint E 4 ∧ y = sixPairEndpoint E 5) ∨
        (x = sixPairEndpoint E 5 ∧ y = sixPairEndpoint E 4)
    by_cases hs01 : shape01
    · have hs23 : ¬shape23 := by
        intro hs23
        exact hshapeDisjoint 0 1 2 3 (by decide) (by decide)
          (by decide) (by decide) x y ⟨hs01, hs23⟩
      have hs45 : ¬shape45 := by
        intro hs45
        exact hshapeDisjoint 0 1 4 5 (by decide) (by decide)
          (by decide) (by decide) x y ⟨hs01, hs45⟩
      have hFone := hFone_of_shape 0 1 h01 x y hs01
      simp [C, singleEdge_mult, shape01, shape23, shape45,
        hs01, hs23, hs45, hFone]
    · by_cases hs23 : shape23
      · have hs45 : ¬shape45 := by
          intro hs45
          exact hshapeDisjoint 2 3 4 5 (by decide) (by decide)
            (by decide) (by decide) x y ⟨hs23, hs45⟩
        have hFone := hFone_of_shape 2 3 h23 x y hs23
        simp [C, singleEdge_mult, shape01, shape23, shape45,
          hs01, hs23, hs45, hFone]
      · by_cases hs45 : shape45
        · have hFone := hFone_of_shape 4 5 h45 x y hs45
          simp [C, singleEdge_mult, shape01, shape23, shape45,
            hs01, hs23, hs45, hFone]
        · simp [C, singleEdge_mult, shape01, shape23, shape45,
            hs01, hs23, hs45]
  have hHbase : H.IsPart (G.induce S) := by
    intro x y
    change Q.mult x y - F.mult x y ≤ (G.induce S).mult x y
    have hQeq : Q.mult x y = (G.induce S).mult x y + C.mult x y := by
      simp [Q, C, closeSixCutMatchingWith, add_mult, Nat.add_assoc]
    rw [hQeq]
    have hCF := hC_le_F x y
    omega
  let K := extendFrom S H
  refine ⟨K, extendFrom_isPart hHbase, ?_, ?_⟩
  · refine ⟨(sixPairEndpoint E 0 : W), ?_⟩
    rw [degree_extendFrom_of_mem S H (sixPairEndpoint E 0)
      (sixPairEndpoint E 0).2]
    exact hHdeg (sixPairEndpoint E 0)
  · intro v
    by_cases hv : v ∈ S
    · right
      rw [degree_extendFrom_of_mem S H v hv]
      exact hHdeg ⟨v, hv⟩
    · left
      exact degree_extendFrom_of_notMem S H v hv

/-- Degree-generic form of the edge-labelled bipartite regularity bridge. -/
lemma bipartiteMultigraph_isRegular_of_degree
    {P : Pseudograph W} {A B : Finset W} {D : ℕ}
    (hreg : P.IsRegularOfDegree D) (hbip : P.IsBipartiteWith A B) :
    (P.bipartiteMultigraph A B).IsRegular D := by
  classical
  constructor
  · intro a
    letI : DecidablePred (fun e : BipartiteEdge P A B ↦
        (P.bipartiteMultigraph A B).left e = a) :=
      fun _ ↦ Classical.propDecidable _
    rw [← Nat.card_eq_fintype_card]
    calc
      Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).left e = a} =
          Nat.card (Σ b : B, Fin (P.mult a b)) :=
        Nat.card_congr (bipartiteLeftFiberEquiv P A B a)
      _ = Fintype.card (Σ b : B, Fin (P.mult a b)) :=
        Nat.card_eq_fintype_card
      _ = ∑ b : B, P.mult a b := by
        rw [Fintype.card_sigma]
        simp
      _ = P.degree a := (hbip.degree_eq_sum_right a).symm
      _ = D := hreg a
  · intro b
    letI : DecidablePred (fun e : BipartiteEdge P A B ↦
        (P.bipartiteMultigraph A B).right e = b) :=
      fun _ ↦ Classical.propDecidable _
    rw [← Nat.card_eq_fintype_card]
    calc
      Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).right e = b} =
          Nat.card (Σ a : A, Fin (P.mult a b)) :=
        Nat.card_congr (bipartiteRightFiberEquiv P A B b)
      _ = Fintype.card (Σ a : A, Fin (P.mult a b)) :=
        Nat.card_eq_fintype_card
      _ = ∑ a : A, P.mult a b := by
        rw [Fintype.card_sigma]
        simp
      _ = P.degree b := (hbip.degree_eq_sum_left b).symm
      _ = D := hreg b

noncomputable def colorClassSubgraphD
    {P : Pseudograph W} {A B : Finset W} {D : ℕ}
    (hbip : P.IsBipartiteWith A B)
    (C : (P.bipartiteMultigraph A B).ProperColoring D) (c : Fin D) :
    P.toSimple.Subgraph where
  verts := Set.univ
  Adj u v := ∃ e : BipartiteEdge P A B, C.color e = c ∧
    (((e.1 : W) = u ∧ (e.2.1 : W) = v) ∨
      ((e.1 : W) = v ∧ (e.2.1 : W) = u))
  adj_sub := by
    rintro u v ⟨e, _hec, huv | huv⟩
    · rcases huv with ⟨rfl, rfl⟩
      exact ⟨fun h ↦ (Finset.disjoint_left.mp hbip.disjoint)
          e.1.2 (h ▸ e.2.1.2),
        Nat.zero_lt_of_lt e.2.2.isLt⟩
    · rcases huv with ⟨rfl, rfl⟩
      exact ⟨fun h ↦ (Finset.disjoint_left.mp hbip.disjoint)
          e.1.2 (h.symm ▸ e.2.1.2),
        by simpa only [P.mult_comm] using Nat.zero_lt_of_lt e.2.2.isLt⟩
  edge_vert := by simp
  symm := ⟨by
    rintro u v ⟨e, hec, huv⟩
    exact ⟨e, hec, huv.symm⟩⟩

lemma colorClassSubgraphD_adj_iff
    {P : Pseudograph W} {A B : Finset W} {D : ℕ}
    (hbip : P.IsBipartiteWith A B)
    (C : (P.bipartiteMultigraph A B).ProperColoring D) (c : Fin D)
    (u v : W) :
    (colorClassSubgraphD hbip C c).Adj u v ↔
      ∃ e : BipartiteEdge P A B, C.color e = c ∧
        (((e.1 : W) = u ∧ (e.2.1 : W) = v) ∨
          ((e.1 : W) = v ∧ (e.2.1 : W) = u)) :=
  Iff.rfl

private lemma exists_left_color_of_properColoringD
    {P : Pseudograph W} {A B : Finset W} {D : ℕ}
    (hreg : (P.bipartiteMultigraph A B).IsRegular D)
    (C : (P.bipartiteMultigraph A B).ProperColoring D)
    (a : A) (c : Fin D) :
    ∃ e : BipartiteEdge P A B,
      (P.bipartiteMultigraph A B).left e = a ∧ C.color e = c := by
  classical
  letI : DecidablePred (fun e : BipartiteEdge P A B ↦
      (P.bipartiteMultigraph A B).left e = a) :=
    fun _ ↦ Classical.propDecidable _
  let T := {e : BipartiteEdge P A B //
    (P.bipartiteMultigraph A B).left e = a}
  let f : T → Fin D := fun e ↦ C.color e.1
  have hf : Function.Injective f := C.left_injective a
  have hcard : Fintype.card T = Fintype.card (Fin D) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    calc
      Nat.card T = Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).left e = a} := by rfl
      _ = D := by
        rw [Nat.card_eq_fintype_card]
        exact hreg.1 a
      _ = Nat.card (Fin D) := by simp
  have hsurj : Function.Surjective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hf, hcard⟩ |>.2
  obtain ⟨e, he⟩ := hsurj c
  exact ⟨e.1, e.2, he⟩

private lemma exists_right_color_of_properColoringD
    {P : Pseudograph W} {A B : Finset W} {D : ℕ}
    (hreg : (P.bipartiteMultigraph A B).IsRegular D)
    (C : (P.bipartiteMultigraph A B).ProperColoring D)
    (b : B) (c : Fin D) :
    ∃ e : BipartiteEdge P A B,
      (P.bipartiteMultigraph A B).right e = b ∧ C.color e = c := by
  classical
  letI : DecidablePred (fun e : BipartiteEdge P A B ↦
      (P.bipartiteMultigraph A B).right e = b) :=
    fun _ ↦ Classical.propDecidable _
  let T := {e : BipartiteEdge P A B //
    (P.bipartiteMultigraph A B).right e = b}
  let f : T → Fin D := fun e ↦ C.color e.1
  have hf : Function.Injective f := C.right_injective b
  have hcard : Fintype.card T = Fintype.card (Fin D) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    calc
      Nat.card T = Nat.card {e : BipartiteEdge P A B //
          (P.bipartiteMultigraph A B).right e = b} := by rfl
      _ = D := by
        rw [Nat.card_eq_fintype_card]
        exact hreg.2 b
      _ = Nat.card (Fin D) := by simp
  have hsurj : Function.Surjective f :=
    (Fintype.bijective_iff_injective_and_card f).2 ⟨hf, hcard⟩ |>.2
  obtain ⟨e, he⟩ := hsurj c
  exact ⟨e.1, e.2, he⟩

lemma colorClassSubgraphD_isPerfectMatching
    {P : Pseudograph W} {A B : Finset W} {D : ℕ}
    (hreg : P.IsRegularOfDegree D) (hbip : P.IsBipartiteWith A B)
    (C : (P.bipartiteMultigraph A B).ProperColoring D) (c : Fin D) :
    (colorClassSubgraphD hbip C c).IsPerfectMatching := by
  classical
  rw [SimpleGraph.Subgraph.isPerfectMatching_iff]
  let Q := P.bipartiteMultigraph A B
  have hQreg : Q.IsRegular D :=
    bipartiteMultigraph_isRegular_of_degree hreg hbip
  intro v
  by_cases hvA : v ∈ A
  · let a : A := ⟨v, hvA⟩
    obtain ⟨e, hea, hec⟩ :=
      exists_left_color_of_properColoringD hQreg C a c
    let w : W := e.2.1
    refine ⟨w, ?_, ?_⟩
    · apply (colorClassSubgraphD_adj_iff hbip C c v w).2
      refine ⟨e, hec, .inl ⟨?_, rfl⟩⟩
      exact congrArg Subtype.val hea
    · intro w' hw'
      obtain ⟨e', he'c, hdir | hdir⟩ :=
        (colorClassSubgraphD_adj_iff hbip C c v w').1 hw'
      · have he'a : Q.left e' = a := by
          apply Subtype.ext
          exact hdir.1
        have hsub : (⟨e', he'a⟩ : {x // Q.left x = a}) = ⟨e, hea⟩ :=
          C.left_injective a
            (a₁ := ⟨e', he'a⟩) (a₂ := ⟨e, hea⟩)
            (he'c.trans hec.symm)
        have heq : e' = e := congrArg Subtype.val hsub
        subst e'
        exact hdir.2.symm
      · have hevB : v ∈ B := by
          rw [← hdir.2]
          exact e'.2.1.2
        exact False.elim ((Finset.disjoint_left.mp hbip.disjoint) hvA hevB)
  · have hvB : v ∈ B := hbip.mem_right_of_not_mem_left hvA
    let b : B := ⟨v, hvB⟩
    obtain ⟨e, heb, hec⟩ :=
      exists_right_color_of_properColoringD hQreg C b c
    let w : W := e.1
    refine ⟨w, ?_, ?_⟩
    · apply (colorClassSubgraphD_adj_iff hbip C c v w).2
      refine ⟨e, hec, .inr ⟨rfl, ?_⟩⟩
      exact congrArg Subtype.val heb
    · intro w' hw'
      obtain ⟨e', he'c, hdir | hdir⟩ :=
        (colorClassSubgraphD_adj_iff hbip C c v w').1 hw'
      · have hevA : v ∈ A := by
          rw [← hdir.1]
          exact e'.1.2
        exact False.elim ((Finset.disjoint_left.mp hbip.disjoint) hevA hvB)
      · have he'b : Q.right e' = b := by
          apply Subtype.ext
          exact hdir.2
        have hsub : (⟨e', he'b⟩ : {x // Q.right x = b}) = ⟨e, heb⟩ :=
          C.right_injective b
            (a₁ := ⟨e', he'b⟩) (a₂ := ⟨e, heb⟩)
            (he'c.trans hec.symm)
        have heq : e' = e := congrArg Subtype.val hsub
        subst e'
        exact hdir.1.symm

/-- The empty pseudograph on a fixed finite vertex type. -/
def emptyGraph : Pseudograph W where
  mult _ _ := 0
  mult_comm _ _ := rfl

@[simp] lemma emptyGraph_mult (u v : W) :
    (emptyGraph : Pseudograph W).mult u v = 0 := rfl

@[simp] lemma emptyGraph_degree (v : W) :
    (emptyGraph : Pseudograph W).degree v = 0 := by
  simp [degree]

/-- The subgraph consisting of a chosen subfamily of the three artificial
edges of a six-cut matching closure. -/
noncomputable def selectedSixClosingPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool) :
    Pseudograph S :=
  ((if use₀₁ then
      singleEdge (sixPairEndpoint E 0) (sixPairEndpoint E 1)
    else emptyGraph) +
    (if use₂₃ then
      singleEdge (sixPairEndpoint E 2) (sixPairEndpoint E 3)
    else emptyGraph)) +
    (if use₄₅ then
      singleEdge (sixPairEndpoint E 4) (sixPairEndpoint E 5)
    else emptyGraph)

lemma degree_selectedSixClosingPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (use₀₁ use₂₃ use₄₅ : Bool)
    (v : S) :
    (selectedSixClosingPart E use₀₁ use₂₃ use₄₅).degree v =
      sixClosingDegree E use₀₁ use₂₃ use₄₅ v := by
  cases use₀₁ <;> cases use₂₃ <;> cases use₄₅ <;>
    simp [selectedSixClosingPart, sixClosingDegree, degree_add]

/-- A perfect matching in a quartic six-cut closure yields a cubic local
witness for any requested artificial-edge pattern for which every omitted
artificial pair belongs to the matching and every requested pair survives
in the cubic complement.  The genuine part is obtained by peeling one copy
of each requested pair; this deliberately permits an original edge parallel
to an artificial one. -/
lemma exists_sixClosureWitness_of_perfectMatching
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (use₀₁ use₂₃ use₄₅ : Bool)
    (M : (G.closeSixCutMatchingWith S E).toSimple.Subgraph)
    (hM : M.IsPerfectMatching)
    (hfalse01 : use₀₁ = false →
      M.Adj (sixPairEndpoint E 0) (sixPairEndpoint E 1))
    (hfalse23 : use₂₃ = false →
      M.Adj (sixPairEndpoint E 2) (sixPairEndpoint E 3))
    (hfalse45 : use₄₅ = false →
      M.Adj (sixPairEndpoint E 4) (sixPairEndpoint E 5))
    (htrue01 : use₀₁ = true →
      0 < ((G.closeSixCutMatchingWith S E).sdiff
        ((G.closeSixCutMatchingWith S E).ofUnderlyingSubgraph M)).mult
          (sixPairEndpoint E 0) (sixPairEndpoint E 1))
    (htrue23 : use₂₃ = true →
      0 < ((G.closeSixCutMatchingWith S E).sdiff
        ((G.closeSixCutMatchingWith S E).ofUnderlyingSubgraph M)).mult
          (sixPairEndpoint E 2) (sixPairEndpoint E 3))
    (htrue45 : use₄₅ = true →
      0 < ((G.closeSixCutMatchingWith S E).sdiff
        ((G.closeSixCutMatchingWith S E).ofUnderlyingSubgraph M)).mult
          (sixPairEndpoint E 4) (sixPairEndpoint E 5)) :
    ∃ H F : Pseudograph S,
      H.IsPart (G.closeSixCutMatchingWith S E) ∧
      (∃ v, H.degree v = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      SixClosureDecomposition E H use₀₁ use₂₃ use₄₅ F := by
  classical
  let Q := G.closeSixCutMatchingWith S E
  let P := Q.ofUnderlyingSubgraph M
  let H := Q.sdiff P
  let C := selectedSixClosingPart E use₀₁ use₂₃ use₄₅
  let F := H.sdiff C
  have hPQ : P.IsPart Q := Q.ofUnderlyingSubgraph_isPart M
  have hHQ : H.IsPart Q := Q.sdiff_isPart_left P
  have hQreg : Q.IsRegularOfDegree 4 :=
    G.closeSixCutMatchingWith_isRegularOfDegree S E hreg
  have hHdeg (v : S) : H.degree v = 3 := by
    have hdiff := Q.degree_sdiff_add P hPQ v
    have hPdeg : P.degree v = 1 :=
      Q.degree_ofUnderlyingSubgraph_of_isPerfectMatching M hM v
    change H.degree v + P.degree v = Q.degree v at hdiff
    rw [hPdeg, hQreg v] at hdiff
    omega
  have hne (i j : Fin 6) (hij : i ≠ j) :
      sixPairEndpoint E i ≠ sixPairEndpoint E j := fun h ↦ hij (hinj h)
  have hshapeDisjoint (i j k l : Fin 6)
      (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l)
      (x y : S) :
      ¬(((x = sixPairEndpoint E i ∧ y = sixPairEndpoint E j) ∨
          (x = sixPairEndpoint E j ∧ y = sixPairEndpoint E i)) ∧
        ((x = sixPairEndpoint E k ∧ y = sixPairEndpoint E l) ∨
          (x = sixPairEndpoint E l ∧ y = sixPairEndpoint E k))) := by
    rintro ⟨h, h'⟩
    rcases h with h | h <;> rcases h' with h' | h'
    · exact (hne i k hik) (h.1.symm.trans h'.1)
    · exact (hne i l hil) (h.1.symm.trans h'.1)
    · exact (hne j k hjk) (h.1.symm.trans h'.1)
    · exact (hne j l hjl) (h.1.symm.trans h'.1)
  have hCmult (x y : S) : C.mult x y =
      (if use₀₁ then
        if (x = sixPairEndpoint E 0 ∧ y = sixPairEndpoint E 1) ∨
            (x = sixPairEndpoint E 1 ∧ y = sixPairEndpoint E 0) then 1 else 0
       else 0) +
      (if use₂₃ then
        if (x = sixPairEndpoint E 2 ∧ y = sixPairEndpoint E 3) ∨
            (x = sixPairEndpoint E 3 ∧ y = sixPairEndpoint E 2) then 1 else 0
       else 0) +
      (if use₄₅ then
        if (x = sixPairEndpoint E 4 ∧ y = sixPairEndpoint E 5) ∨
            (x = sixPairEndpoint E 5 ∧ y = sixPairEndpoint E 4) then 1 else 0
       else 0) := by
    cases use₀₁ <;> cases use₂₃ <;> cases use₄₅ <;>
      simp [C, selectedSixClosingPart, Nat.add_assoc]
    all_goals ring
  have hCpart : C.IsPart H := by
    intro x y
    let shape01 : Prop :=
      (x = sixPairEndpoint E 0 ∧ y = sixPairEndpoint E 1) ∨
        (x = sixPairEndpoint E 1 ∧ y = sixPairEndpoint E 0)
    let shape23 : Prop :=
      (x = sixPairEndpoint E 2 ∧ y = sixPairEndpoint E 3) ∨
        (x = sixPairEndpoint E 3 ∧ y = sixPairEndpoint E 2)
    let shape45 : Prop :=
      (x = sixPairEndpoint E 4 ∧ y = sixPairEndpoint E 5) ∨
        (x = sixPairEndpoint E 5 ∧ y = sixPairEndpoint E 4)
    rw [hCmult]
    by_cases hs01 : shape01
    · have hs23 : ¬shape23 := by
        intro hs23
        exact hshapeDisjoint 0 1 2 3 (by decide) (by decide)
          (by decide) (by decide) x y ⟨hs01, hs23⟩
      have hs45 : ¬shape45 := by
        intro hs45
        exact hshapeDisjoint 0 1 4 5 (by decide) (by decide)
          (by decide) (by decide) x y ⟨hs01, hs45⟩
      cases use₀₁ with
      | false =>
          simp [shape01, shape23, shape45, hs01, hs23, hs45]
      | true =>
          have hp : 0 < H.mult (sixPairEndpoint E 0)
              (sixPairEndpoint E 1) := by
            simpa [H, Q, P] using htrue01 rfl
          rcases hs01 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
          · simpa [shape01, shape23, shape45, hs23, hs45] using
              (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hp))
          · have hp' : 0 < H.mult (sixPairEndpoint E 1)
                (sixPairEndpoint E 0) := by
              rw [H.mult_comm]
              exact hp
            simpa [shape01, shape23, shape45, hs23, hs45] using
              (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hp'))
    · by_cases hs23 : shape23
      · have hs45 : ¬shape45 := by
          intro hs45
          exact hshapeDisjoint 2 3 4 5 (by decide) (by decide)
            (by decide) (by decide) x y ⟨hs23, hs45⟩
        cases use₂₃ with
        | false =>
            simp [shape01, shape23, shape45, hs01, hs23, hs45]
        | true =>
            have hp : 0 < H.mult (sixPairEndpoint E 2)
                (sixPairEndpoint E 3) := by
              simpa [H, Q, P] using htrue23 rfl
            rcases hs23 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            · simpa [shape01, shape23, shape45, hs01, hs45] using
                (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hp))
            · have hp' : 0 < H.mult (sixPairEndpoint E 3)
                  (sixPairEndpoint E 2) := by
                rw [H.mult_comm]
                exact hp
              simpa [shape01, shape23, shape45, hs01, hs45] using
                (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hp'))
      · by_cases hs45 : shape45
        · cases use₄₅ with
          | false =>
              simp [shape01, shape23, shape45, hs01, hs23, hs45]
          | true =>
              have hp : 0 < H.mult (sixPairEndpoint E 4)
                  (sixPairEndpoint E 5) := by
                simpa [H, Q, P] using htrue45 rfl
              rcases hs45 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
              · simpa [shape01, shape23, shape45, hs01, hs23] using
                  (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hp))
              · have hp' : 0 < H.mult (sixPairEndpoint E 5)
                    (sixPairEndpoint E 4) := by
                  rw [H.mult_comm]
                  exact hp
                simpa [shape01, shape23, shape45, hs01, hs23] using
                  (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hp'))
        · simp [shape01, shape23, shape45, hs01, hs23, hs45]
  have hFbase : F.IsPart (G.induce S) := by
    intro x y
    change (Q.mult x y - P.mult x y) - C.mult x y ≤
      (G.induce S).mult x y
    let shape01 : Prop :=
      (x = sixPairEndpoint E 0 ∧ y = sixPairEndpoint E 1) ∨
        (x = sixPairEndpoint E 1 ∧ y = sixPairEndpoint E 0)
    let shape23 : Prop :=
      (x = sixPairEndpoint E 2 ∧ y = sixPairEndpoint E 3) ∨
        (x = sixPairEndpoint E 3 ∧ y = sixPairEndpoint E 2)
    let shape45 : Prop :=
      (x = sixPairEndpoint E 4 ∧ y = sixPairEndpoint E 5) ∨
        (x = sixPairEndpoint E 5 ∧ y = sixPairEndpoint E 4)
    have hQeq : Q.mult x y = (G.induce S).mult x y +
        (if shape01 then 1 else 0) + (if shape23 then 1 else 0) +
          (if shape45 then 1 else 0) := by
      simp only [Q, closeSixCutMatchingWith, add_mult, singleEdge_mult,
        shape01, shape23, shape45]
      ring
    have hPmult : P.mult x y = if M.Adj x y then 1 else 0 := by
      simp [P, ofUnderlyingSubgraph, ofSimple_mult]
    by_cases hs01 : shape01
    · have hs23 : ¬shape23 := by
        intro hs23
        exact hshapeDisjoint 0 1 2 3 (by decide) (by decide)
          (by decide) (by decide) x y ⟨hs01, hs23⟩
      have hs45 : ¬shape45 := by
        intro hs45
        exact hshapeDisjoint 0 1 4 5 (by decide) (by decide)
          (by decide) (by decide) x y ⟨hs01, hs45⟩
      cases use₀₁ with
      | false =>
          have hAdj : M.Adj x y := by
            rcases hs01 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            · exact hfalse01 rfl
            · exact (hfalse01 rfl).symm
          rw [hQeq, hPmult, hCmult]
          simp [shape01, shape23, shape45, hs01, hs23, hs45, hAdj]
      | true =>
          rw [hQeq, hPmult, hCmult]
          simp [shape01, shape23, shape45, hs01, hs23, hs45]
    · by_cases hs23 : shape23
      · have hs45 : ¬shape45 := by
          intro hs45
          exact hshapeDisjoint 2 3 4 5 (by decide) (by decide)
            (by decide) (by decide) x y ⟨hs23, hs45⟩
        cases use₂₃ with
        | false =>
            have hAdj : M.Adj x y := by
              rcases hs23 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
              · exact hfalse23 rfl
              · exact (hfalse23 rfl).symm
            rw [hQeq, hPmult, hCmult]
            simp [shape01, shape23, shape45, hs01, hs23, hs45, hAdj]
        | true =>
            rw [hQeq, hPmult, hCmult]
            simp [shape01, shape23, shape45, hs01, hs23, hs45]
      · by_cases hs45 : shape45
        · cases use₄₅ with
          | false =>
              have hAdj : M.Adj x y := by
                rcases hs45 with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
                · exact hfalse45 rfl
                · exact (hfalse45 rfl).symm
              rw [hQeq, hPmult, hCmult]
              simp [shape01, shape23, shape45, hs01, hs23, hs45, hAdj]
          | true =>
              rw [hQeq, hPmult, hCmult]
              simp [shape01, shape23, shape45, hs01, hs23, hs45]
        · rw [hQeq, hPmult, hCmult]
          simp [shape01, shape23, shape45, hs01, hs23, hs45]
  refine ⟨H, F, hHQ, ⟨sixPairEndpoint E 0, hHdeg _⟩,
    fun v ↦ .inr (hHdeg v), hFbase, ?_⟩
  intro v
  have hdiff := H.degree_sdiff_add C hCpart v
  change F.degree v + C.degree v = H.degree v at hdiff
  rw [degree_selectedSixClosingPart] at hdiff
  exact hdiff

/-- The local-witness package required by six-cut splicing. -/
def HasSixClosureWitness
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (use₀₁ use₂₃ use₄₅ : Bool) : Prop :=
  ∃ H F : Pseudograph S,
    H.IsPart (G.closeSixCutMatchingWith S E) ∧
    (∃ v, H.degree v = 3) ∧
    (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
    SixClosureDecomposition E H use₀₁ use₂₃ use₄₅ F

/-- Balanced base case of Tashkinov's Proposition 3.6.  Prescribe the first
two artificial pairs in a perfect matching.  Unless its complement is
already an original cubic part, the remaining cubic bipartite graph is
three-edge-coloured.  Complements of suitable colour classes realize the
patterns `001`, `110`, and `111`. -/
lemma balancedSixClosure_basePatterns
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      G.boundaryMultiplicity T = 4 → T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card = B.card)
    (h0 : sixPairEndpoint E 0 ∈ A)
    (h1 : sixPairEndpoint E 1 ∈ B)
    (h2 : sixPairEndpoint E 2 ∈ A)
    (h3 : sixPairEndpoint E 3 ∈ B)
    (h4 : sixPairEndpoint E 4 ∈ A)
    (h5 : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    G.ContainsRegularPart 3 ∨
      (HasSixClosureWitness G S E false false true ∧
       HasSixClosureWitness G S E true true false ∧
       HasSixClosureWitness G S E true true true) := by
  classical
  let Q := G.closeSixCutMatchingWith S E
  have hQreg : Q.IsRegularOfDegree 4 :=
    G.closeSixCutMatchingWith_isRegularOfDegree S E hreg
  have hQbip : Q.IsBipartiteWith A B :=
    closeSixCutMatchingWith_isBipartiteWith E A B hbip
      (.inl ⟨h0, h1⟩) (.inl ⟨h2, h3⟩) (.inl ⟨h4, h5⟩)
  obtain ⟨M₁, hM₁, hM₁01, hM₁23⟩ :=
    exists_perfectMatching_closeSix_containing_first_two
      G hreg hno4 S E A B hbip hcard h0 h1 h2 h3 h4 h5 hinj
  by_cases hM₁45 : M₁.Adj (sixPairEndpoint E 4) (sixPairEndpoint E 5)
  · exact .inl (containsRegularPart_of_perfectMatching_closeSix_containing_all
      G hreg S E hinj M₁ hM₁ hM₁01 hM₁23 hM₁45)
  · right
    let P₁ := Q.ofUnderlyingSubgraph M₁
    let R := Q.sdiff P₁
    have hP₁Q : P₁.IsPart Q := Q.ofUnderlyingSubgraph_isPart M₁
    have hRQ : R.IsPart Q := Q.sdiff_isPart_left P₁
    have hRreg : R.IsRegularOfDegree 3 := by
      intro v
      have hd := Q.degree_sdiff_add P₁ hP₁Q v
      have hPdeg : P₁.degree v = 1 :=
        Q.degree_ofUnderlyingSubgraph_of_isPerfectMatching M₁ hM₁ v
      change R.degree v + P₁.degree v = Q.degree v at hd
      rw [hPdeg, hQreg v] at hd
      omega
    have hRbip : R.IsBipartiteWith A B := hQbip.sdiff_right
    have hP₁01 : P₁.mult (sixPairEndpoint E 0)
        (sixPairEndpoint E 1) = 1 := by
      simp [P₁, ofUnderlyingSubgraph, ofSimple_mult, hM₁01]
    have hP₁23 : P₁.mult (sixPairEndpoint E 2)
        (sixPairEndpoint E 3) = 1 := by
      simp [P₁, ofUnderlyingSubgraph, ofSimple_mult, hM₁23]
    have hP₁45 : P₁.mult (sixPairEndpoint E 4)
        (sixPairEndpoint E 5) = 0 := by
      simp [P₁, ofUnderlyingSubgraph, ofSimple_mult, hM₁45]
    have hR01 : R.mult (sixPairEndpoint E 0) (sixPairEndpoint E 1) =
        (G.induce S).mult (sixPairEndpoint E 0) (sixPairEndpoint E 1) := by
      change Q.mult _ _ - P₁.mult _ _ = _
      rw [closeSixCutMatchingWith_mult_pair01 E hinj, hP₁01]
      omega
    have hR23 : R.mult (sixPairEndpoint E 2) (sixPairEndpoint E 3) =
        (G.induce S).mult (sixPairEndpoint E 2) (sixPairEndpoint E 3) := by
      change Q.mult _ _ - P₁.mult _ _ = _
      rw [closeSixCutMatchingWith_mult_pair23 E hinj, hP₁23]
      omega
    have hR45pos : 0 < R.mult (sixPairEndpoint E 4)
        (sixPairEndpoint E 5) := by
      change 0 < Q.mult _ _ - P₁.mult _ _
      rw [closeSixCutMatchingWith_mult_pair45 E hinj, hP₁45]
      omega
    let e₄₅ : BipartiteEdge R A B :=
      ⟨⟨sixPairEndpoint E 4, h4⟩, ⟨sixPairEndpoint E 5, h5⟩,
        ⟨0, hR45pos⟩⟩
    obtain ⟨C⟩ := (R.bipartiteMultigraph A B).exists_properColoring
      (bipartiteMultigraph_isRegular_of_degree hRreg hRbip)
    let c₄₅ : Fin 3 := C.color e₄₅
    let M₄₅R : R.toSimple.Subgraph := colorClassSubgraphD hRbip C c₄₅
    let M₄₅ : Q.toSimple.Subgraph :=
      liftUnderlyingSubgraphOfPart hRQ M₄₅R
    have hM₄₅pm : M₄₅.IsPerfectMatching :=
      liftUnderlyingSubgraphOfPart_isPerfectMatching hRQ M₄₅R
        (colorClassSubgraphD_isPerfectMatching hRreg hRbip C c₄₅)
    have hM₄₅adj : M₄₅.Adj (sixPairEndpoint E 4)
        (sixPairEndpoint E 5) := by
      change M₄₅R.Adj (sixPairEndpoint E 4) (sixPairEndpoint E 5)
      apply (colorClassSubgraphD_adj_iff hRbip C c₄₅ _ _).2
      exact ⟨e₄₅, rfl, .inl ⟨rfl, rfl⟩⟩
    have hM₄₅partR : (Q.ofUnderlyingSubgraph M₄₅).IsPart R :=
      ofUnderlyingSubgraph_liftUnderlyingSubgraphOfPart_isPart hRQ M₄₅R
    have htrue01_M₄₅ : 0 < (Q.sdiff (Q.ofUnderlyingSubgraph M₄₅)).mult
        (sixPairEndpoint E 0) (sixPairEndpoint E 1) := by
      have hle := hM₄₅partR (sixPairEndpoint E 0) (sixPairEndpoint E 1)
      rw [hR01] at hle
      change 0 < Q.mult _ _ - (Q.ofUnderlyingSubgraph M₄₅).mult _ _
      rw [closeSixCutMatchingWith_mult_pair01 E hinj]
      omega
    have htrue23_M₄₅ : 0 < (Q.sdiff (Q.ofUnderlyingSubgraph M₄₅)).mult
        (sixPairEndpoint E 2) (sixPairEndpoint E 3) := by
      have hle := hM₄₅partR (sixPairEndpoint E 2) (sixPairEndpoint E 3)
      rw [hR23] at hle
      change 0 < Q.mult _ _ - (Q.ofUnderlyingSubgraph M₄₅).mult _ _
      rw [closeSixCutMatchingWith_mult_pair23 E hinj]
      omega
    have h001 : HasSixClosureWitness G S E false false true := by
      unfold HasSixClosureWitness
      apply exists_sixClosureWitness_of_perfectMatching
        G hreg S E hinj false false true M₁ hM₁
      · exact fun _ ↦ hM₁01
      · exact fun _ ↦ hM₁23
      · simp
      · simp
      · simp
      · intro _
        simpa [Q, P₁, R] using hR45pos
    have h110 : HasSixClosureWitness G S E true true false := by
      unfold HasSixClosureWitness
      apply exists_sixClosureWitness_of_perfectMatching
        G hreg S E hinj true true false M₄₅ hM₄₅pm
      · simp
      · simp
      · exact fun _ ↦ hM₄₅adj
      · exact fun _ ↦ htrue01_M₄₅
      · exact fun _ ↦ htrue23_M₄₅
      · simp
    obtain ⟨c, hc, _⟩ := Fin.exists_ne_and_ne_of_two_lt c₄₅ c₄₅ (by decide)
    let McR : R.toSimple.Subgraph := colorClassSubgraphD hRbip C c
    let Mc : Q.toSimple.Subgraph := liftUnderlyingSubgraphOfPart hRQ McR
    have hMcpm : Mc.IsPerfectMatching :=
      liftUnderlyingSubgraphOfPart_isPerfectMatching hRQ McR
        (colorClassSubgraphD_isPerfectMatching hRreg hRbip C c)
    have hMcpartR : (Q.ofUnderlyingSubgraph Mc).IsPart R :=
      ofUnderlyingSubgraph_liftUnderlyingSubgraphOfPart_isPart hRQ McR
    have htrue01_Mc : 0 < (Q.sdiff (Q.ofUnderlyingSubgraph Mc)).mult
        (sixPairEndpoint E 0) (sixPairEndpoint E 1) := by
      have hle := hMcpartR (sixPairEndpoint E 0) (sixPairEndpoint E 1)
      rw [hR01] at hle
      change 0 < Q.mult _ _ - (Q.ofUnderlyingSubgraph Mc).mult _ _
      rw [closeSixCutMatchingWith_mult_pair01 E hinj]
      omega
    have htrue23_Mc : 0 < (Q.sdiff (Q.ofUnderlyingSubgraph Mc)).mult
        (sixPairEndpoint E 2) (sixPairEndpoint E 3) := by
      have hle := hMcpartR (sixPairEndpoint E 2) (sixPairEndpoint E 3)
      rw [hR23] at hle
      change 0 < Q.mult _ _ - (Q.ofUnderlyingSubgraph Mc).mult _ _
      rw [closeSixCutMatchingWith_mult_pair23 E hinj]
      omega
    have htrue45_Mc : 0 < (Q.sdiff (Q.ofUnderlyingSubgraph Mc)).mult
        (sixPairEndpoint E 4) (sixPairEndpoint E 5) := by
      by_cases hbase : (G.induce S).mult (sixPairEndpoint E 4)
          (sixPairEndpoint E 5) = 0
      · have hR45one : R.mult (sixPairEndpoint E 4)
            (sixPairEndpoint E 5) = 1 := by
          change Q.mult _ _ - P₁.mult _ _ = 1
          rw [closeSixCutMatchingWith_mult_pair45 E hinj, hP₁45, hbase]
      
        have hnotAdj : ¬ McR.Adj (sixPairEndpoint E 4)
            (sixPairEndpoint E 5) := by
          intro hadj
          obtain ⟨e, hec, hdir | hdir⟩ :=
            (colorClassSubgraphD_adj_iff hRbip C c _ _).1 hadj
          · have heq : e = e₄₅ :=
              bipartiteEdge_eq_of_endpoints_of_mult_eq_one e e₄₅
                hdir.1 hdir.2 (by simpa [hdir.1, hdir.2] using hR45one)
            subst e
            exact hc (by simpa [c₄₅] using hec.symm)
          · have heA : (e.1 : S) ∈ A := e.1.2
            have h5A : sixPairEndpoint E 5 ∈ A := by
              simpa [hdir.1] using heA
            exact (Finset.disjoint_left.mp hbip.disjoint) h5A h5
        have hPzero : (Q.ofUnderlyingSubgraph Mc).mult
            (sixPairEndpoint E 4) (sixPairEndpoint E 5) = 0 := by
          simp [Mc, McR, ofUnderlyingSubgraph, ofSimple_mult, hnotAdj]
        change 0 < Q.mult _ _ - (Q.ofUnderlyingSubgraph Mc).mult _ _
        rw [closeSixCutMatchingWith_mult_pair45 E hinj, hbase, hPzero]
        omega
      · have hbasepos : 0 < (G.induce S).mult (sixPairEndpoint E 4)
            (sixPairEndpoint E 5) := Nat.pos_of_ne_zero hbase
        have hPupper : (Q.ofUnderlyingSubgraph Mc).mult
            (sixPairEndpoint E 4) (sixPairEndpoint E 5) ≤ 1 := by
          by_cases hAdj : Mc.Adj (sixPairEndpoint E 4)
              (sixPairEndpoint E 5)
          · simp [ofUnderlyingSubgraph, ofSimple_mult, hAdj]
          · simp [ofUnderlyingSubgraph, ofSimple_mult, hAdj]
        change 0 < Q.mult _ _ - (Q.ofUnderlyingSubgraph Mc).mult _ _
        rw [closeSixCutMatchingWith_mult_pair45 E hinj]
        omega
    have h111 : HasSixClosureWitness G S E true true true := by
      unfold HasSixClosureWitness
      apply exists_sixClosureWitness_of_perfectMatching
        G hreg S E hinj true true true Mc hMcpm
      · simp
      · simp
      · simp
      · exact fun _ ↦ htrue01_Mc
      · exact fun _ ↦ htrue23_Mc
      · exact fun _ ↦ htrue45_Mc
    exact ⟨h001, h110, h111⟩

/-- Rotate the three consecutive labelled pairs:
`(01,23,45) ↦ (23,45,01)`. -/
noncomputable def finSixPairCycleEquiv : Fin 6 ≃ Fin 6 :=
  Equiv.ofBijective
    (fun i : Fin 6 ↦ ![2, 3, 4, 5, 0, 1] i)
    (by decide)

/-- Exchange the last two consecutive labelled pairs. -/
noncomputable def finSixPairSwapEquiv : Fin 6 ≃ Fin 6 :=
  Equiv.ofBijective
    (fun i : Fin 6 ↦ ![0, 1, 4, 5, 2, 3] i)
    (by decide)

@[simp] lemma finSixPairCycleEquiv_zero : finSixPairCycleEquiv 0 = 2 := rfl
@[simp] lemma finSixPairCycleEquiv_one : finSixPairCycleEquiv 1 = 3 := rfl
@[simp] lemma finSixPairCycleEquiv_two : finSixPairCycleEquiv 2 = 4 := rfl
@[simp] lemma finSixPairCycleEquiv_three : finSixPairCycleEquiv 3 = 5 := rfl
@[simp] lemma finSixPairCycleEquiv_four : finSixPairCycleEquiv 4 = 0 := rfl
@[simp] lemma finSixPairCycleEquiv_five : finSixPairCycleEquiv 5 = 1 := rfl

@[simp] lemma finSixPairSwapEquiv_zero : finSixPairSwapEquiv 0 = 0 := rfl
@[simp] lemma finSixPairSwapEquiv_one : finSixPairSwapEquiv 1 = 1 := rfl
@[simp] lemma finSixPairSwapEquiv_two : finSixPairSwapEquiv 2 = 4 := rfl
@[simp] lemma finSixPairSwapEquiv_three : finSixPairSwapEquiv 3 = 5 := rfl
@[simp] lemma finSixPairSwapEquiv_four : finSixPairSwapEquiv 4 = 2 := rfl
@[simp] lemma finSixPairSwapEquiv_five : finSixPairSwapEquiv 5 = 3 := rfl

lemma closeSixCutMatchingWith_cyclePairs
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) :
    G.closeSixCutMatchingWith S (finSixPairCycleEquiv.trans E) =
      G.closeSixCutMatchingWith S E := by
  apply Pseudograph.ext
  intro x y
  simp [closeSixCutMatchingWith, sixPairEndpoint, add_mult]
  ring

lemma closeSixCutMatchingWith_swapPairs
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) :
    G.closeSixCutMatchingWith S (finSixPairSwapEquiv.trans E) =
      G.closeSixCutMatchingWith S E := by
  apply Pseudograph.ext
  intro x y
  simp [closeSixCutMatchingWith, sixPairEndpoint, add_mult]
  ring

lemma sixClosingDegree_cyclePairs
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (b₀₁ b₂₃ b₄₅ : Bool) (v : S) :
    sixClosingDegree (finSixPairCycleEquiv.trans E) b₀₁ b₂₃ b₄₅ v =
      sixClosingDegree E b₄₅ b₀₁ b₂₃ v := by
  cases b₀₁ <;> cases b₂₃ <;> cases b₄₅ <;>
    simp [sixClosingDegree, sixPairEndpoint, degree_singleEdge]
  all_goals omega

lemma sixClosingDegree_swapPairs
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (b₀₁ b₂₃ b₄₅ : Bool) (v : S) :
    sixClosingDegree (finSixPairSwapEquiv.trans E) b₀₁ b₂₃ b₄₅ v =
      sixClosingDegree E b₀₁ b₄₅ b₂₃ v := by
  cases b₀₁ <;> cases b₂₃ <;> cases b₄₅ <;>
    simp [sixClosingDegree, sixPairEndpoint, degree_singleEdge]
  all_goals omega

lemma HasSixClosureWitness.reindex
    (G : Pseudograph W) (S : Finset W)
    (E E' : Fin 6 ≃ CrossingEdge G S)
    (a b c a' b' c' : Bool)
    (hclose : G.closeSixCutMatchingWith S E' =
      G.closeSixCutMatchingWith S E)
    (hdegree : ∀ v : S,
      sixClosingDegree E' a' b' c' v =
        sixClosingDegree E a b c v)
    (h : HasSixClosureWitness G S E' a' b' c') :
    HasSixClosureWitness G S E a b c := by
  rcases h with ⟨H, F, hH, hne, hdeg, hdec⟩
  refine ⟨H, F, ?_, hne, hdeg, hdec.1, ?_⟩
  · simpa [hclose] using hH
  · intro v
    rw [← hdegree v]
    exact hdec.2 v

/-- Every nonzero artificial-edge use pattern is available on a balanced
bipartite six-shore, unless that shore already contains an original cubic
part. -/
lemma balancedSixClosure_all_nonzero_patterns
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      G.boundaryMultiplicity T = 4 → T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card = B.card)
    (h0 : sixPairEndpoint E 0 ∈ A)
    (h1 : sixPairEndpoint E 1 ∈ B)
    (h2 : sixPairEndpoint E 2 ∈ A)
    (h3 : sixPairEndpoint E 3 ∈ B)
    (h4 : sixPairEndpoint E 4 ∈ A)
    (h5 : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    G.ContainsRegularPart 3 ∨
      ∀ use₀₁ use₂₃ use₄₅ : Bool,
        use₀₁ = true ∨ use₂₃ = true ∨ use₄₅ = true →
        HasSixClosureWitness G S E use₀₁ use₂₃ use₄₅ := by
  classical
  let Ec := finSixPairCycleEquiv.trans E
  let Es := finSixPairSwapEquiv.trans E
  have hinjc : Function.Injective (sixPairEndpoint Ec) := by
    intro i j hij
    apply finSixPairCycleEquiv.injective
    apply hinj
    exact hij
  have hinjs : Function.Injective (sixPairEndpoint Es) := by
    intro i j hij
    apply finSixPairSwapEquiv.injective
    apply hinj
    exact hij
  have hc := balancedSixClosure_basePatterns G hreg hno4 S Ec A B hbip hcard
    h2 h3 h4 h5 h0 h1 hinjc
  rcases hc with hcubic | ⟨hc001, hc110, _hc111⟩
  · exact .inl hcubic
  have hs := balancedSixClosure_basePatterns G hreg hno4 S Es A B hbip hcard
    h0 h1 h4 h5 h2 h3 hinjs
  rcases hs with hcubic | ⟨hs001, hs110, _hs111⟩
  · exact .inl hcubic
  have hi := balancedSixClosure_basePatterns G hreg hno4 S E A B hbip hcard
    h0 h1 h2 h3 h4 h5 hinj
  rcases hi with hcubic | ⟨hi001, hi110, hi111⟩
  · exact .inl hcubic
  right
  intro b₀₁ b₂₃ b₄₅ hnonzero
  cases b₀₁ <;> cases b₂₃ <;> cases b₄₅
  · simp at hnonzero
  · exact hi001
  · exact HasSixClosureWitness.reindex G S E Es false true false
      false false true (closeSixCutMatchingWith_swapPairs G S E)
      (sixClosingDegree_swapPairs E false false true) hs001
  · exact HasSixClosureWitness.reindex G S E Ec false true true
      true true false (closeSixCutMatchingWith_cyclePairs G S E)
      (sixClosingDegree_cyclePairs E true true false) hc110
  · exact HasSixClosureWitness.reindex G S E Ec true false false
      false false true (closeSixCutMatchingWith_cyclePairs G S E)
      (sixClosingDegree_cyclePairs E false false true) hc001
  · exact HasSixClosureWitness.reindex G S E Es true false true
      true true false (closeSixCutMatchingWith_swapPairs G S E)
      (sixClosingDegree_swapPairs E true true false) hs110
  · exact hi110
  · exact hi111

lemma HasSimpleMultiplicities.add_fresh_nonloop
    {H : Pseudograph W} (hsimple : H.HasSimpleMultiplicities)
    {a b : W} (hab : a ≠ b) (hfresh : H.mult a b = 0) :
    (H + singleEdge a b).HasSimpleMultiplicities := by
  constructor
  · intro v
    rw [add_mult, hsimple.1, Nat.zero_add, singleEdge_mult, if_neg]
    intro h
    rcases h with ⟨hva, hvb⟩ | ⟨hvb, hva⟩
    · exact hab (hva.symm.trans hvb)
    · exact hab (hva.symm.trans hvb)
  · intro u v
    rw [add_mult, singleEdge_mult]
    split_ifs with hshape
    · rcases hshape with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · rw [hfresh]
      · rw [H.mult_comm, hfresh]
    · exact hsimple.2 u v

/-- Adding one final edge to a loopless graph with at most one parallel
pair stays in Tashkinov's class. -/
lemma add_singleEdge_inTashkinovClass_of_loopless_parallel_le_one
    (H : Pseudograph W) (hloop : H.loopCount = 0)
    (hparallel : H.parallelPairCount ≤ 1)
    (a b : W)
    (hreg : (H + singleEdge a b).IsRegularOfDegree 4) :
    (H + singleEdge a b).InTashkinovClass := by
  have hp := parallelPairCount_add_singleEdge_le_add_one H a b
  by_cases hab : a = b
  · subst b
    rw [parallelPairCount_add_loop] at hp
    refine ⟨hreg, ?_, ?_⟩
    · rw [loopCount_add, loopCount_singleEdge, hloop]
      simp
    · rw [loopCount_add, loopCount_singleEdge, hloop,
        parallelPairCount_add_loop]
      have hp' := Nat.add_le_add_left hparallel 1
      norm_num at hp' ⊢
      exact hp'
  · refine ⟨hreg, ?_, ?_⟩
    · rw [loopCount_add, loopCount_singleEdge, if_neg hab, hloop]
      simp
    · rw [loopCount_add, loopCount_singleEdge, if_neg hab, hloop]
      omega

/-- A simple base plus two copies of one nonloop edge and one arbitrary
edge is in class `B`. -/
lemma add_duplicate_nonloop_then_edge_inTashkinovClass
    (H : Pseudograph W) (hsimple : H.HasSimpleMultiplicities)
    {a b c d : W} (hab : a ≠ b)
    (hreg : (((H + singleEdge a b) + singleEdge a b) +
      singleEdge c d).IsRegularOfDegree 4) :
    (((H + singleEdge a b) + singleEdge a b) +
      singleEdge c d).InTashkinovClass := by
  let K := (H + singleEdge a b) + singleEdge a b
  have hloopH : H.loopCount = 0 := by
    unfold loopCount
    simp [hsimple.1]
  have hparallelH : H.parallelPairCount = 0 :=
    parallelPairCount_eq_zero_of_hasSimpleMultiplicities H hsimple
  have hloopK : K.loopCount = 0 := by
    simp [K, loopCount_add, loopCount_singleEdge, hab, hloopH]
  have hparallelK : K.parallelPairCount ≤ 1 := by
    have h := parallelPairCount_add_two_sameEdge_le_add_one H a b
    simpa [K, hparallelH] using h
  exact add_singleEdge_inTashkinovClass_of_loopless_parallel_le_one
    K hloopK hparallelK c d hreg

/-- If the first of three added edges is a fresh nonloop, the remaining
two may be arbitrary except that they cannot both be loops. -/
lemma add_three_singleEdges_inTashkinovClass_of_first_fresh
    (H : Pseudograph W) (hsimple : H.HasSimpleMultiplicities)
    {a₀ b₀ a₁ b₁ a₂ b₂ : W}
    (hne₀ : a₀ ≠ b₀) (hfresh₀ : H.mult a₀ b₀ = 0)
    (hnotTwoLoops : ¬(a₁ = b₁ ∧ a₂ = b₂))
    (hreg : (((H + singleEdge a₀ b₀) + singleEdge a₁ b₁) +
      singleEdge a₂ b₂).IsRegularOfDegree 4) :
    (((H + singleEdge a₀ b₀) + singleEdge a₁ b₁) +
      singleEdge a₂ b₂).InTashkinovClass := by
  have hsimple' : (H + singleEdge a₀ b₀).HasSimpleMultiplicities :=
    hsimple.add_fresh_nonloop hne₀ hfresh₀
  exact add_two_singleEdges_inTashkinovClass_of_hasSimpleMultiplicities
    (H + singleEdge a₀ b₀) hsimple' a₁ b₁ a₂ b₂ hreg hnotTwoLoops

/-- An equivalence of `Fin 3` sending `0` and `1` to a prescribed ordered
pair of distinct indices. -/
noncomputable def finThreePairEquiv (i j : Fin 3) : Fin 3 ≃ Fin 3 :=
  (Equiv.swap 1 ((Equiv.swap 0 i).symm j)).trans (Equiv.swap 0 i)

@[simp] lemma finThreePairEquiv_zero {i j : Fin 3} (hij : i ≠ j) :
    finThreePairEquiv i j 0 = i := by
  have hk : (Equiv.swap 0 i).symm j ≠ 0 := by
    intro hk
    apply hij
    have := congrArg (Equiv.swap 0 i) hk
    simpa using this.symm
  have hk' : (0 : Fin 3) ≠ (Equiv.swap 0 i) j := by
    simpa using hk.symm
  change (Equiv.swap 0 i)
    ((Equiv.swap 1 ((Equiv.swap 0 i) j)) 0) = i
  rw [Equiv.swap_apply_of_ne_of_ne (by decide) hk',
    Equiv.swap_apply_left]

@[simp] lemma finThreePairEquiv_one {i j : Fin 3} (hij : i ≠ j) :
    finThreePairEquiv i j 1 = j := by
  simp [finThreePairEquiv]

lemma exists_right_reindex_avoiding_two_loops
    (L R : Fin 3 → W) (eA eB : Fin 3 ≃ Fin 3)
    (hLrem : L (eA 1) ≠ L (eA 2)) :
    ∃ eB' : Fin 3 ≃ Fin 3,
      eB' 0 = eB 0 ∧
      ¬(L (eA 1) = R (eB' 1) ∧ L (eA 2) = R (eB' 2)) := by
  classical
  by_cases hloops : L (eA 1) = R (eB 1) ∧
      L (eA 2) = R (eB 2)
  · let eB' := (Equiv.swap (1 : Fin 3) 2).trans eB
    refine ⟨eB', ?_, ?_⟩
    · change eB ((Equiv.swap (1 : Fin 3) 2) 0) = eB 0
      rw [Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)]
    · intro hboth
      apply hLrem
      calc
        L (eA 1) = R (eB' 1) := hboth.1
        _ = R (eB 2) := by simp [eB']
        _ = L (eA 2) := hloops.2.symm
  · exact ⟨eB, rfl, hloops⟩

@[simp] lemma finSixAlternatingReindex_zero
    (eA eB : Fin 3 ≃ Fin 3) :
    finSixAlternatingReindex eA eB 0 = alternatingLeftLabel (eA 0) := by
  simpa only [alternatingLeftLabel_zero] using
    finSixAlternatingReindex_left eA eB 0

@[simp] lemma finSixAlternatingReindex_one
    (eA eB : Fin 3 ≃ Fin 3) :
    finSixAlternatingReindex eA eB 1 = alternatingRightLabel (eB 0) := by
  simpa only [alternatingRightLabel_zero] using
    finSixAlternatingReindex_right eA eB 0

@[simp] lemma finSixAlternatingReindex_two
    (eA eB : Fin 3 ≃ Fin 3) :
    finSixAlternatingReindex eA eB 2 = alternatingLeftLabel (eA 1) := by
  simpa only [alternatingLeftLabel_one] using
    finSixAlternatingReindex_left eA eB 1

@[simp] lemma finSixAlternatingReindex_three
    (eA eB : Fin 3 ≃ Fin 3) :
    finSixAlternatingReindex eA eB 3 = alternatingRightLabel (eB 1) := by
  simpa only [alternatingRightLabel_one] using
    finSixAlternatingReindex_right eA eB 1

@[simp] lemma finSixAlternatingReindex_four
    (eA eB : Fin 3 ≃ Fin 3) :
    finSixAlternatingReindex eA eB 4 = alternatingLeftLabel (eA 2) := by
  simpa only [alternatingLeftLabel_two] using
    finSixAlternatingReindex_left eA eB 2

@[simp] lemma finSixAlternatingReindex_five
    (eA eB : Fin 3 ≃ Fin 3) :
    finSixAlternatingReindex eA eB 5 = alternatingRightLabel (eB 2) := by
  simpa only [alternatingRightLabel_two] using
    finSixAlternatingReindex_right eA eB 2

noncomputable def alternatingLeftOutside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) : W :=
  (E (alternatingLeftLabel i)).outside

noncomputable def alternatingRightOutside
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) : W :=
  (E (alternatingRightLabel i)).outside

lemma alternatingLeftOutside_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) :
    alternatingLeftOutside E i ∉ S :=
  (E (alternatingLeftLabel i)).outside_notMem

lemma alternatingRightOutside_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) :
    alternatingRightOutside E i ∉ S :=
  (E (alternatingRightLabel i)).outside_notMem

/-- Three distinct positive off-diagonal entries in one row already
contribute at least three to the pseudograph degree. -/
lemma three_le_degree_of_three_distinct_neighbors
    (P : Pseudograph W) {x y₀ y₁ y₂ : W}
    (hxy₀ : 0 < P.mult x y₀) (hxy₁ : 0 < P.mult x y₁)
    (hxy₂ : 0 < P.mult x y₂)
    (hy₀y₁ : y₀ ≠ y₁) (hy₀y₂ : y₀ ≠ y₂)
    (hy₁y₂ : y₁ ≠ y₂)
    (hxy₀ne : x ≠ y₀) (hxy₁ne : x ≠ y₁)
    (hxy₂ne : x ≠ y₂) :
    3 ≤ P.degree x := by
  classical
  have hsub : ({y₀, y₁, y₂} : Finset W) ⊆ Finset.univ.erase x := by
    intro y hy
    simp only [Finset.mem_insert, Finset.mem_singleton] at hy
    rcases hy with rfl | rfl | rfl
    · exact Finset.mem_erase.mpr ⟨hxy₀ne.symm, Finset.mem_univ _⟩
    · exact Finset.mem_erase.mpr ⟨hxy₁ne.symm, Finset.mem_univ _⟩
    · exact Finset.mem_erase.mpr ⟨hxy₂ne.symm, Finset.mem_univ _⟩
  have hsmall : 3 ≤ ∑ y ∈ ({y₀, y₁, y₂} : Finset W), P.mult x y := by
    simp [hy₀y₁, hy₀y₂, hy₁y₂]
    omega
  have hlarge := Finset.sum_le_sum_of_subset hsub
    (f := fun y ↦ P.mult x y)
  unfold degree
  exact hsmall.trans (hlarge.trans (Nat.le_add_left _ _))

/-- If every vertex on the opposite shore carries at most two cut
incidences, no three distinct labels can have the same outside endpoint. -/
lemma not_three_outsideEndpoints_eq_of_outsideDegree_le_two
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hout : ∀ v : W, v ∈ Sᶜ → G.outsideDegree Sᶜ v ≤ 2)
    {i j k : Fin 6} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    ¬((E i).outside = (E j).outside ∧
      (E i).outside = (E k).outside) := by
  classical
  intro heq
  let v := (E i).outside
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr (E i).outside_notMem
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  have hcount := G.outsideDegree_eq_listingEndpointCount Sᶜ EC v hvC
  have hthree : 3 ≤ listingEndpointCount G Sᶜ EC v := by
    unfold listingEndpointCount
    calc
      3 = ∑ q ∈ ({i, j, k} : Finset (Fin 6)),
          if (EC q).inside = v then 1 else 0 := by
            have hkj : (E k).outside = (E j).outside :=
              heq.2.symm.trans heq.1
            rw [Finset.sum_insert (by simp [hij, hik]),
              Finset.sum_insert (by simp [hjk]),
              Finset.sum_singleton]
            simp [EC, reverseSixCutListing_inside, v, heq.1, heq.2, hkj]
      _ ≤ ∑ q ∈ (Finset.univ : Finset (Fin 6)),
          if (EC q).inside = v then 1 else 0 := by
            exact Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hle := hout v hvC
  rw [hcount] at hle
  omega

lemma outsideDegree_compl_eq_two_of_two_outsideEndpoints_eq
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hout : ∀ v : W, v ∈ Sᶜ → G.outsideDegree Sᶜ v ≤ 2)
    {i j : Fin 6} (hij : i ≠ j)
    (heq : (E i).outside = (E j).outside) :
    G.outsideDegree Sᶜ (E i).outside = 2 := by
  classical
  let v := (E i).outside
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr (E i).outside_notMem
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  have hcount := G.outsideDegree_eq_listingEndpointCount Sᶜ EC v hvC
  have htwo : 2 ≤ listingEndpointCount G Sᶜ EC v := by
    unfold listingEndpointCount
    calc
      2 = ∑ q ∈ ({i, j} : Finset (Fin 6)),
          if (EC q).inside = v then 1 else 0 := by
            rw [Finset.sum_insert (by simpa using hij),
              Finset.sum_singleton]
            simp [EC, reverseSixCutListing_inside, v, heq]
      _ ≤ ∑ q ∈ (Finset.univ : Finset (Fin 6)),
          if (EC q).inside = v then 1 else 0 := by
            exact Finset.sum_le_sum_of_subset (Finset.subset_univ _)
  have hle := hout v hvC
  change G.outsideDegree Sᶜ v = 2
  rw [hcount]
  omega

noncomputable def alternatingLeftOutsideCompl
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) : ↑(Sᶜ) :=
  ⟨alternatingLeftOutside E i,
    Finset.mem_compl.mpr (alternatingLeftOutside_notMem E i)⟩

noncomputable def alternatingRightOutsideCompl
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) : ↑(Sᶜ) :=
  ⟨alternatingRightOutside E i,
    Finset.mem_compl.mpr (alternatingRightOutside_notMem E i)⟩

@[simp] lemma coe_alternatingLeftOutsideCompl
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) :
    (alternatingLeftOutsideCompl E i : W) = alternatingLeftOutside E i :=
  rfl

@[simp] lemma coe_alternatingRightOutsideCompl
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 3) :
    (alternatingRightOutsideCompl E i : W) = alternatingRightOutside E i :=
  rfl

/-- A reindexed opposite closure is in class `B` when its first artificial
edge is a fresh nonloop and its last two are not both loops. -/
lemma reindexedOppositeSixClosure_inTashkinovClass_of_first_fresh
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (eA eB : Fin 3 ≃ Fin 3)
    (hsimple : (G.induce Sᶜ).HasSimpleMultiplicities)
    (hne₀ : alternatingLeftOutsideCompl E (eA 0) ≠
      alternatingRightOutsideCompl E (eB 0))
    (hfresh₀ : (G.induce Sᶜ).mult
      (alternatingLeftOutsideCompl E (eA 0))
      (alternatingRightOutsideCompl E (eB 0)) = 0)
    (hnotTwoLoops : ¬(
      alternatingLeftOutsideCompl E (eA 1) =
        alternatingRightOutsideCompl E (eB 1) ∧
      alternatingLeftOutsideCompl E (eA 2) =
        alternatingRightOutsideCompl E (eB 2))) :
    (G.closeSixCutMatchingWith Sᶜ
      (reverseSixCutListing
        ((finSixAlternatingReindex eA eB).trans E))).InTashkinovClass := by
  let E' := (finSixAlternatingReindex eA eB).trans E
  let EC := reverseSixCutListing E'
  let a₀ := alternatingLeftOutsideCompl E (eA 0)
  let b₀ := alternatingRightOutsideCompl E (eB 0)
  let a₁ := alternatingLeftOutsideCompl E (eA 1)
  let b₁ := alternatingRightOutsideCompl E (eB 1)
  let a₂ := alternatingLeftOutsideCompl E (eA 2)
  let b₂ := alternatingRightOutsideCompl E (eB 2)
  have hclosure : G.closeSixCutMatchingWith Sᶜ EC =
      (((G.induce Sᶜ + singleEdge a₀ b₀) + singleEdge a₁ b₁) +
        singleEdge a₂ b₂) := by
    rfl
  rw [hclosure]
  apply add_three_singleEdges_inTashkinovClass_of_first_fresh
    (G.induce Sᶜ) hsimple hne₀ hfresh₀ hnotTwoLoops
  rw [← hclosure]
  exact G.closeSixCutMatchingWith_isRegularOfDegree Sᶜ EC hreg

/-- A reindexed opposite closure is in class `B` when its first two
artificial edges are the same nonloop edge. -/
lemma reindexedOppositeSixClosure_inTashkinovClass_of_duplicate
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (eA eB : Fin 3 ≃ Fin 3)
    (hsimple : (G.induce Sᶜ).HasSimpleMultiplicities)
    (hA : alternatingLeftOutsideCompl E (eA 0) =
      alternatingLeftOutsideCompl E (eA 1))
    (hB : alternatingRightOutsideCompl E (eB 0) =
      alternatingRightOutsideCompl E (eB 1))
    (hne : alternatingLeftOutsideCompl E (eA 0) ≠
      alternatingRightOutsideCompl E (eB 0)) :
    (G.closeSixCutMatchingWith Sᶜ
      (reverseSixCutListing
        ((finSixAlternatingReindex eA eB).trans E))).InTashkinovClass := by
  let E' := (finSixAlternatingReindex eA eB).trans E
  let EC := reverseSixCutListing E'
  let a := alternatingLeftOutsideCompl E (eA 0)
  let b := alternatingRightOutsideCompl E (eB 0)
  let c := alternatingLeftOutsideCompl E (eA 2)
  let d := alternatingRightOutsideCompl E (eB 2)
  have hclosure₀ : G.closeSixCutMatchingWith Sᶜ EC =
      (((G.induce Sᶜ +
          singleEdge (alternatingLeftOutsideCompl E (eA 0))
            (alternatingRightOutsideCompl E (eB 0))) +
        singleEdge (alternatingLeftOutsideCompl E (eA 1))
          (alternatingRightOutsideCompl E (eB 1))) +
        singleEdge (alternatingLeftOutsideCompl E (eA 2))
          (alternatingRightOutsideCompl E (eB 2))) := by
    rfl
  rw [← hA, ← hB] at hclosure₀
  have hclosure : G.closeSixCutMatchingWith Sᶜ EC =
      (((G.induce Sᶜ + singleEdge a b) + singleEdge a b) +
        singleEdge c d) := by
    simpa [a, b, c, d] using hclosure₀
  rw [hclosure]
  apply add_duplicate_nonloop_then_edge_inTashkinovClass
    (G.induce Sᶜ) hsimple hne
  rw [← hclosure]
  exact G.closeSixCutMatchingWith_isRegularOfDegree Sᶜ EC hreg

/-- The same duplicate-edge certificate when the second artificial edge
has the two endpoints in the opposite order. -/
lemma reindexedOppositeSixClosure_inTashkinovClass_of_swappedDuplicate
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (eA eB : Fin 3 ≃ Fin 3)
    (hsimple : (G.induce Sᶜ).HasSimpleMultiplicities)
    (hAtoB : alternatingLeftOutsideCompl E (eA 0) =
      alternatingRightOutsideCompl E (eB 1))
    (hBtoA : alternatingRightOutsideCompl E (eB 0) =
      alternatingLeftOutsideCompl E (eA 1))
    (hne : alternatingLeftOutsideCompl E (eA 0) ≠
      alternatingRightOutsideCompl E (eB 0)) :
    (G.closeSixCutMatchingWith Sᶜ
      (reverseSixCutListing
        ((finSixAlternatingReindex eA eB).trans E))).InTashkinovClass := by
  let E' := (finSixAlternatingReindex eA eB).trans E
  let EC := reverseSixCutListing E'
  let a := alternatingLeftOutsideCompl E (eA 0)
  let b := alternatingRightOutsideCompl E (eB 0)
  let c := alternatingLeftOutsideCompl E (eA 2)
  let d := alternatingRightOutsideCompl E (eB 2)
  have hclosure₀ : G.closeSixCutMatchingWith Sᶜ EC =
      (((G.induce Sᶜ +
          singleEdge (alternatingLeftOutsideCompl E (eA 0))
            (alternatingRightOutsideCompl E (eB 0))) +
        singleEdge (alternatingLeftOutsideCompl E (eA 1))
          (alternatingRightOutsideCompl E (eB 1))) +
        singleEdge (alternatingLeftOutsideCompl E (eA 2))
          (alternatingRightOutsideCompl E (eB 2))) := by
    rfl
  rw [← hBtoA, ← hAtoB,
    singleEdge_comm (alternatingRightOutsideCompl E (eB 0))
      (alternatingLeftOutsideCompl E (eA 0))] at hclosure₀
  have hclosure : G.closeSixCutMatchingWith Sᶜ EC =
      (((G.induce Sᶜ + singleEdge a b) + singleEdge a b) +
        singleEdge c d) := by
    simpa [a, b, c, d] using hclosure₀
  rw [hclosure]
  apply add_duplicate_nonloop_then_edge_inTashkinovClass
    (G.induce Sᶜ) hsimple hne
  rw [← hclosure]
  exact G.closeSixCutMatchingWith_isRegularOfDegree Sᶜ EC hreg

/-- A graph copy transports a literal regular subgraph. -/
lemma containsRegularSubgraph_of_graphCopy
    {X Y : Type*} [Fintype X] [Fintype Y]
    {J : SimpleGraph X} {G : SimpleGraph Y} {k : ℕ}
    (f : SimpleGraph.Copy J G) (h : ContainsRegularSubgraph J k) :
    ContainsRegularSubgraph G k := by
  classical
  obtain ⟨K, hKne, hKreg⟩ := h
  let K' : G.Subgraph := K.map f.toHom
  let e : K.coe ≃g K'.coe := f.isoSubgraphMap K
  refine ⟨K', ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hKne
    exact ⟨f v, Set.mem_image_of_mem f hv⟩
  · intro v
    obtain ⟨u, hu, huv⟩ := v.2
    let uK : K.verts := ⟨u, hu⟩
    have hev : e uK = v := by
      apply Subtype.ext
      exact huv
    rw [← hev]
    have hncard := Set.ncard_congr' (e.mapNeighborSet uK)
    exact hncard.symm.trans (hKreg uK)

lemma completeBipartiteThree_containsThreeRegular :
    ContainsRegularSubgraph
      (completeBipartiteGraph (Fin 3) (Fin 3)) 3 := by
  classical
  let K := completeBipartiteGraph (Fin 3) (Fin 3)
  let H : K.Subgraph := K.toSubgraph K le_rfl
  refine ⟨H, ⟨Sum.inl 0, by simp [H]⟩, ?_⟩
  intro v
  rw [← Set.fintypeCard_eq_ncard, SimpleGraph.card_neighborSet_eq_degree,
    SimpleGraph.Subgraph.coe_degree]
  change H.degree (v : Fin 3 ⊕ Fin 3) = 3
  rw [SimpleGraph.degree_toSubgraph]
  change K.degree (v : Fin 3 ⊕ Fin 3) = 3
  rcases v with ⟨v, _⟩
  rcases v with i | j
  · simp [K, SimpleGraph.degree, SimpleGraph.neighborFinset_eq_filter]
    decide
  · simp [K, SimpleGraph.degree, SimpleGraph.neighborFinset_eq_filter]
    decide

/-- Three distinct left vertices completely joined to three distinct right
vertices form a cubic `K₃,₃` subgraph. -/
lemma containsThreeRegular_of_completeBipartiteTriples
    (G : SimpleGraph W) (L R : Fin 3 → W)
    (hL : Function.Injective L) (hR : Function.Injective R)
    (hadj : ∀ i j, G.Adj (L i) (R j)) :
    ContainsRegularSubgraph G 3 := by
  let f : (Fin 3 ⊕ Fin 3) → W := Sum.elim L R
  have hf : Function.Injective f := by
    intro x y hxy
    rcases x with i | j <;> rcases y with i' | j'
    · exact congrArg Sum.inl (hL hxy)
    · exfalso
      exact (hadj i j').ne hxy
    · exfalso
      exact (hadj i' j).ne' hxy
    · exact congrArg Sum.inr (hR hxy)
  let C : SimpleGraph.Copy
      (completeBipartiteGraph (Fin 3) (Fin 3)) G := {
    toHom := {
      toFun := f
      map_rel' := by
        rintro (i | j) (i' | j') h
        · simp at h
        · exact hadj i j'
        · exact (hadj i' j).symm
        · simp at h }
    injective' := hf }
  exact containsRegularSubgraph_of_graphCopy C
    completeBipartiteThree_containsThreeRegular

/-- For a balanced bipartite six-shore, a compatible pairing of the six
opposite endpoints either closes in Tashkinov's induction class or the
opposite shore already contains the cubic graph `K₃,₃`. -/
lemma containsThreeRegular_or_reindexedOppositeSixClosure_inClass
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge (ofSimple G) S)
    (hout : ∀ v : W, v ∈ Sᶜ →
      (ofSimple G).outsideDegree Sᶜ v ≤ 2) :
    ContainsRegularSubgraph G 3 ∨
      ∃ eA eB : Fin 3 ≃ Fin 3,
        ((ofSimple G).closeSixCutMatchingWith Sᶜ
          (reverseSixCutListing
            ((finSixAlternatingReindex eA eB).trans E))).InTashkinovClass := by
  classical
  let P := ofSimple G
  let L : Fin 3 → W := alternatingLeftOutside E
  let R : Fin 3 → W := alternatingRightOutside E
  let LC : Fin 3 → ↑(Sᶜ) := alternatingLeftOutsideCompl E
  let RC : Fin 3 → ↑(Sᶜ) := alternatingRightOutsideCompl E
  have hPsimple : P.HasSimpleMultiplicities := by
    constructor
    · intro v
      simp [P]
    · intro u v
      simp only [P, ofSimple_mult]
      split_ifs <;> omega
  have hsimple : (P.induce Sᶜ).HasSimpleMultiplicities :=
    P.induce_hasSimpleMultiplicities hPsimple Sᶜ
  have hPReg : P.IsRegularOfDegree 4 :=
    (isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hleftLabelNe (eA : Fin 3 ≃ Fin 3) {p q : Fin 3} (hpq : p ≠ q) :
      alternatingLeftLabel (eA p) ≠ alternatingLeftLabel (eA q) := by
    intro h
    exact hpq (eA.injective (alternatingLeftLabel_injective h))
  have hrightLabelNe (eB : Fin 3 ≃ Fin 3) {p q : Fin 3} (hpq : p ≠ q) :
      alternatingRightLabel (eB p) ≠ alternatingRightLabel (eB q) := by
    intro h
    exact hpq (eB.injective (alternatingRightLabel_injective h))
  by_cases hLinj : Function.Injective L
  · by_cases hRinj : Function.Injective R
    · by_cases hcross : ∃ i j, L i = R j
      · right
        obtain ⟨i, j, hijEq⟩ := hcross
        by_cases hcross₂ : ∃ p q, p ≠ i ∧ q ≠ j ∧ L p = R q
        · obtain ⟨p, q, hpi, hqj, hpqEq⟩ := hcross₂
          let eA : Fin 3 ≃ Fin 3 := finThreePairEquiv i p
          let eB : Fin 3 ≃ Fin 3 := finThreePairEquiv q j
          refine ⟨eA, eB, ?_⟩
          apply reindexedOppositeSixClosure_inTashkinovClass_of_swappedDuplicate
            P hPReg S E eA eB hsimple
          · apply Subtype.ext
            change L (eA 0) = R (eB 1)
            simpa [eA, eB, hpi.symm, hqj] using hijEq
          · apply Subtype.ext
            change R (eB 0) = L (eA 1)
            simpa [eA, eB, hpi.symm, hqj] using hpqEq.symm
          · intro heq
            have hval : L i = R q := by
              simpa [L, R, LC, RC, eA, eB, hpi.symm, hqj] using
                congrArg Subtype.val heq
            exact hqj (hRinj (hijEq.symm.trans hval).symm)
        · let eA₀ : Fin 3 ≃ Fin 3 := Equiv.swap 0 i
          let eB₀ : Fin 3 ≃ Fin 3 := Equiv.swap 0 j
          have hcrossDistinct {p q : Fin 3} (hpi : p ≠ i) (hqj : q ≠ j) :
              L p ≠ R q := by
            intro hpq
            exact hcross₂ ⟨p, q, hpi, hqj, hpq⟩
          have houtTwo : P.outsideDegree Sᶜ (L (eA₀ 0)) = 2 := by
            have ht := outsideDegree_compl_eq_two_of_two_outsideEndpoints_eq
              E hout (alternatingLeftLabel_ne_rightLabel (eA₀ 0) (eB₀ 0))
              (by
                change L (eA₀ 0) = R (eB₀ 0)
                simpa [eA₀, eB₀] using hijEq)
            simpa only [P, L, alternatingLeftOutside] using ht
          have hxC : L (eA₀ 0) ∈ Sᶜ :=
            Finset.mem_compl.mpr (alternatingLeftOutside_notMem E (eA₀ 0))
          have hdegree := P.degree_induce_add_outsideDegree Sᶜ
            (L (eA₀ 0)) hxC
          rw [hPReg (L (eA₀ 0)), houtTwo] at hdegree
          have hindeg : (P.induce Sᶜ).degree ⟨L (eA₀ 0), hxC⟩ = 2 := by
            omega
          have hnotAll : ¬(
              G.Adj (L (eA₀ 0)) (R (eB₀ 1)) ∧
              G.Adj (L (eA₀ 0)) (R (eB₀ 2)) ∧
              G.Adj (L (eA₀ 1)) (R (eB₀ 0)) ∧
              G.Adj (L (eA₀ 2)) (R (eB₀ 0))) := by
            rintro ⟨h₁, h₂, h₃, _h₄⟩
            have hthree : 3 ≤ (P.induce Sᶜ).degree
                ⟨L (eA₀ 0), hxC⟩ := by
              apply three_le_degree_of_three_distinct_neighbors
                (x := ⟨L (eA₀ 0), hxC⟩)
                (y₀ := RC (eB₀ 1)) (y₁ := RC (eB₀ 2))
                (y₂ := LC (eA₀ 1))
              · simp [P, induce_mult, ofSimple_mult, L, R, LC, RC, h₁]
              · simp [P, induce_mult, ofSimple_mult, L, R, LC, RC, h₂]
              · simp only [P, induce_mult, ofSimple_mult]
                rw [if_pos]
                · omega
                · have hzero : L (eA₀ 0) = R (eB₀ 0) := by
                    simpa [eA₀, eB₀] using hijEq
                  rw [hzero]
                  simpa [L, R, LC, RC] using h₃.symm
              · intro h
                exact (by decide : (1 : Fin 3) ≠ 2)
                  (eB₀.injective (hRinj (congrArg Subtype.val h)))
              · intro h
                have hp : eA₀ 1 ≠ i := by
                  intro hp
                  exact (by decide : (1 : Fin 3) ≠ 0)
                    (eA₀.injective (hp.trans (by simp [eA₀])))
                have hq : eB₀ 1 ≠ j := by
                  intro hq
                  exact (by decide : (1 : Fin 3) ≠ 0)
                    (eB₀.injective (hq.trans (by simp [eB₀])))
                exact hcrossDistinct hp hq (congrArg Subtype.val h).symm
              · intro h
                have hp : eA₀ 1 ≠ i := by
                  intro hp
                  exact (by decide : (1 : Fin 3) ≠ 0)
                    (eA₀.injective (hp.trans (by simp [eA₀])))
                have hq : eB₀ 2 ≠ j := by
                  intro hq
                  exact (by decide : (2 : Fin 3) ≠ 0)
                    (eB₀.injective (hq.trans (by simp [eB₀])))
                exact hcrossDistinct hp hq (congrArg Subtype.val h).symm
              · intro h
                have hval := congrArg Subtype.val h
                exact (by decide : (0 : Fin 3) ≠ 1)
                  (eB₀.injective (hRinj (hijEq.symm.trans (by
                    simpa [R, RC, eA₀, eB₀] using hval))))
              · intro h
                have hval := congrArg Subtype.val h
                exact (by decide : (0 : Fin 3) ≠ 2)
                  (eB₀.injective (hRinj (hijEq.symm.trans (by
                    simpa [R, RC, eA₀, eB₀] using hval))))
              · intro h
                exact (by decide : (0 : Fin 3) ≠ 1)
                  (eA₀.injective (hLinj (congrArg Subtype.val h)))
            omega
          have closeOfFresh (eA eBbase : Fin 3 ≃ Fin 3)
              (hfresh : ¬ G.Adj (L (eA 0)) (R (eBbase 0)))
              (hne : LC (eA 0) ≠ RC (eBbase 0)) :
              ∃ eA' eB' : Fin 3 ≃ Fin 3,
                (P.closeSixCutMatchingWith Sᶜ
                  (reverseSixCutListing
                    ((finSixAlternatingReindex eA' eB').trans E))).InTashkinovClass := by
            have hLrem : LC (eA 1) ≠ LC (eA 2) := by
              intro h
              exact (by decide : (1 : Fin 3) ≠ 2)
                (eA.injective (hLinj (congrArg Subtype.val h)))
            obtain ⟨eB, heB0, hloops⟩ :=
              exists_right_reindex_avoiding_two_loops LC RC eA eBbase hLrem
            refine ⟨eA, eB, ?_⟩
            apply reindexedOppositeSixClosure_inTashkinovClass_of_first_fresh
              P hPReg S E eA eB hsimple
            · simpa [heB0] using hne
            · simp only [P, induce_mult, ofSimple_mult]
              rw [if_neg]
              intro hadj
              apply hfresh
              simpa [L, R, LC, RC, heB0] using hadj
            · exact hloops
          by_cases h₁ : G.Adj (L (eA₀ 0)) (R (eB₀ 1))
          · by_cases h₂ : G.Adj (L (eA₀ 0)) (R (eB₀ 2))
            · by_cases h₃ : G.Adj (L (eA₀ 1)) (R (eB₀ 0))
              · by_cases h₄ : G.Adj (L (eA₀ 2)) (R (eB₀ 0))
                · exact False.elim (hnotAll ⟨h₁, h₂, h₃, h₄⟩)
                · let eA := (Equiv.swap (0 : Fin 3) 2).trans eA₀
                  have hne : LC (eA 0) ≠ RC (eB₀ 0) := by
                    intro h
                    have hval : L (eA₀ 2) = L (eA₀ 0) := by
                      calc
                        L (eA₀ 2) = R (eB₀ 0) := by
                          simpa [eA, L, R, LC, RC] using congrArg Subtype.val h
                        _ = L (eA₀ 0) := by
                          simpa [eA₀, eB₀] using hijEq.symm
                    exact (by decide : (2 : Fin 3) ≠ 0)
                      (eA₀.injective (hLinj hval))
                  exact closeOfFresh eA eB₀ (by simpa [eA] using h₄) hne
              · let eA := (Equiv.swap (0 : Fin 3) 1).trans eA₀
                have hne : LC (eA 0) ≠ RC (eB₀ 0) := by
                  intro h
                  have hval : L (eA₀ 1) = L (eA₀ 0) := by
                    calc
                      L (eA₀ 1) = R (eB₀ 0) := by
                        simpa [eA, L, R, LC, RC] using congrArg Subtype.val h
                      _ = L (eA₀ 0) := by
                        simpa [eA₀, eB₀] using hijEq.symm
                  exact (by decide : (1 : Fin 3) ≠ 0)
                    (eA₀.injective (hLinj hval))
                exact closeOfFresh eA eB₀ (by simpa [eA] using h₃) hne
            · let eB := (Equiv.swap (0 : Fin 3) 2).trans eB₀
              have hne : LC (eA₀ 0) ≠ RC (eB 0) := by
                intro h
                have hval : R (eB₀ 0) = R (eB₀ 2) := by
                  calc
                    R (eB₀ 0) = L (eA₀ 0) := by
                      simpa [eA₀, eB₀] using hijEq.symm
                    _ = R (eB₀ 2) := by
                      simpa [eB, L, R, LC, RC] using congrArg Subtype.val h
                exact (by decide : (0 : Fin 3) ≠ 2)
                  (eB₀.injective (hRinj hval))
              exact closeOfFresh eA₀ eB (by simpa [eB] using h₂) hne
          · let eB := (Equiv.swap (0 : Fin 3) 1).trans eB₀
            have hne : LC (eA₀ 0) ≠ RC (eB 0) := by
              intro h
              have hval : R (eB₀ 0) = R (eB₀ 1) := by
                calc
                  R (eB₀ 0) = L (eA₀ 0) := by
                    simpa [eA₀, eB₀] using hijEq.symm
                  _ = R (eB₀ 1) := by
                    simpa [eB, L, R, LC, RC] using congrArg Subtype.val h
              exact (by decide : (0 : Fin 3) ≠ 1)
                (eB₀.injective (hRinj hval))
            exact closeOfFresh eA₀ eB (by simpa [eB] using h₁) hne
      · have hdisj : ∀ i j, L i ≠ R j := by
          intro i j hij
          exact hcross ⟨i, j, hij⟩
        by_cases hall : ∀ i j, G.Adj (L i) (R j)
        · exact .inl (containsThreeRegular_of_completeBipartiteTriples
            G L R hLinj hRinj hall)
        · right
          push_neg at hall
          obtain ⟨i, j, hijAdj⟩ := hall
          let eA : Fin 3 ≃ Fin 3 := Equiv.swap 0 i
          let eB₀ : Fin 3 ≃ Fin 3 := Equiv.swap 0 j
          have hLrem : LC (eA 1) ≠ LC (eA 2) := by
            intro h
            exact (by decide : (1 : Fin 3) ≠ 2)
              (eA.injective (hLinj (congrArg Subtype.val h)))
          obtain ⟨eB, heB0, hloops⟩ :=
            exists_right_reindex_avoiding_two_loops LC RC eA eB₀ hLrem
          refine ⟨eA, eB, ?_⟩
          apply reindexedOppositeSixClosure_inTashkinovClass_of_first_fresh
            P hPReg S E eA eB hsimple
          · intro heq
            apply hdisj i j
            simpa [L, R, LC, RC, eA, eB₀, heB0] using
              congrArg Subtype.val heq
          · simp only [P, induce_mult, ofSimple_mult]
            rw [if_neg]
            intro hadj
            apply hijAdj
            simpa [L, R, LC, RC, eA, eB₀, heB0] using hadj
          · exact hloops
    · right
      obtain ⟨k, l, hRkl, hkl⟩ := Function.not_injective_iff.mp hRinj
      let eB : Fin 3 ≃ Fin 3 := finThreePairEquiv k l
      -- The symmetric repeated-right case is handled by choosing a fresh
      -- first edge from the injective left triple.
      have hRCeq : RC (eB 0) = RC (eB 1) := by
        apply Subtype.ext
        change R (eB 0) = R (eB 1)
        simpa [eB, hkl] using hRkl
      have hnotLeftAtRepeatedRight (i : Fin 3) : LC i ≠ RC (eB 0) := by
        intro heq
        have hno := not_three_outsideEndpoints_eq_of_outsideDegree_le_two
          E hout
          (hrightLabelNe eB (by decide : (0 : Fin 3) ≠ 1))
          (alternatingLeftLabel_ne_rightLabel i (eB 0)).symm
          (alternatingLeftLabel_ne_rightLabel i (eB 1)).symm
        apply hno
        constructor
        · simpa [R, alternatingRightOutside, eB, hkl] using hRkl
        · exact congrArg Subtype.val heq |>.symm
      have hexFresh : ∃ i, ¬ G.Adj (L i) (R (eB 0)) := by
        by_contra hnone
        push_neg at hnone
        let x := R (eB 0)
        have houtTwo : P.outsideDegree Sᶜ x = 2 := by
          have ht := outsideDegree_compl_eq_two_of_two_outsideEndpoints_eq
            E hout
              (hrightLabelNe eB (by decide : (0 : Fin 3) ≠ 1))
              (by
                change R (eB 0) = R (eB 1)
                simpa [eB, hkl] using hRkl)
          simpa only [P, x, R, alternatingRightOutside] using ht
        have hxC : x ∈ Sᶜ := by
          exact Finset.mem_compl.mpr
            (alternatingRightOutside_notMem E (eB 0))
        have hdegree := P.degree_induce_add_outsideDegree Sᶜ x hxC
        rw [hPReg x, houtTwo] at hdegree
        have hindeg : (P.induce Sᶜ).degree ⟨x, hxC⟩ = 2 := by omega
        have hthree : 3 ≤ (P.induce Sᶜ).degree ⟨x, hxC⟩ := by
          apply three_le_degree_of_three_distinct_neighbors
            (x := ⟨x, hxC⟩) (y₀ := LC 0) (y₁ := LC 1) (y₂ := LC 2)
          · simp [P, induce_mult, ofSimple_mult, L, R, LC, x,
              (hnone 0).symm]
          · simp [P, induce_mult, ofSimple_mult, L, R, LC, x,
              (hnone 1).symm]
          · simp [P, induce_mult, ofSimple_mult, L, R, LC, x,
              (hnone 2).symm]
          · exact fun h ↦ (by decide : (0 : Fin 3) ≠ 1) (hLinj
              (congrArg Subtype.val h))
          · exact fun h ↦ (by decide : (0 : Fin 3) ≠ 2) (hLinj
              (congrArg Subtype.val h))
          · exact fun h ↦ (by decide : (1 : Fin 3) ≠ 2) (hLinj
              (congrArg Subtype.val h))
          · intro h
            exact (hnone 0).ne' (congrArg Subtype.val h)
          · intro h
            exact (hnone 1).ne' (congrArg Subtype.val h)
          · intro h
            exact (hnone 2).ne' (congrArg Subtype.val h)
        omega
      obtain ⟨i, hiFresh⟩ := hexFresh
      let eA₀ : Fin 3 ≃ Fin 3 := Equiv.swap 0 i
      have hLrem : LC (eA₀ 1) ≠ LC (eA₀ 2) := by
        intro h
        exact (by decide : (1 : Fin 3) ≠ 2)
          (eA₀.injective (hLinj (congrArg Subtype.val h)))
      obtain ⟨eB', heB'0, hloops⟩ :=
        exists_right_reindex_avoiding_two_loops LC RC eA₀ eB hLrem
      refine ⟨eA₀, eB', ?_⟩
      apply reindexedOppositeSixClosure_inTashkinovClass_of_first_fresh
        P hPReg S E eA₀ eB' hsimple
      · intro heq
        exact hnotLeftAtRepeatedRight i (by
          simpa [eA₀, eB, heB'0] using heq)
      · simp only [P, induce_mult, ofSimple_mult]
        rw [if_neg]
        intro hadj
        apply hiFresh
        simpa [L, R, LC, RC, eA₀, eB, heB'0] using hadj
      · exact hloops
  · right
    obtain ⟨i, j, hLij, hij⟩ := Function.not_injective_iff.mp hLinj
    let eA : Fin 3 ≃ Fin 3 := finThreePairEquiv i j
    by_cases hRinj : Function.Injective R
    · have hexFresh : ∃ k, ¬ G.Adj (L (eA 0)) (R k) := by
        by_contra hnone
        push_neg at hnone
        let x := L (eA 0)
        have houtTwo : P.outsideDegree Sᶜ x = 2 := by
          have ht := outsideDegree_compl_eq_two_of_two_outsideEndpoints_eq
            E hout
              (hleftLabelNe eA (by decide : (0 : Fin 3) ≠ 1))
              (by
                change L (eA 0) = L (eA 1)
                simpa [eA, hij] using hLij)
          simpa only [P, x, L, alternatingLeftOutside] using ht
        have hxC : x ∈ Sᶜ := by
          exact Finset.mem_compl.mpr
            (alternatingLeftOutside_notMem E (eA 0))
        have hdegree := P.degree_induce_add_outsideDegree Sᶜ x hxC
        rw [hPReg x, houtTwo] at hdegree
        have hindeg : (P.induce Sᶜ).degree ⟨x, hxC⟩ = 2 := by omega
        have hthree : 3 ≤ (P.induce Sᶜ).degree ⟨x, hxC⟩ := by
          apply three_le_degree_of_three_distinct_neighbors
            (x := ⟨x, hxC⟩) (y₀ := RC 0) (y₁ := RC 1) (y₂ := RC 2)
          · simp [P, induce_mult, ofSimple_mult, L, R, RC, x, hnone 0]
          · simp [P, induce_mult, ofSimple_mult, L, R, RC, x, hnone 1]
          · simp [P, induce_mult, ofSimple_mult, L, R, RC, x, hnone 2]
          · exact fun h ↦ (by decide : (0 : Fin 3) ≠ 1) (hRinj
              (congrArg Subtype.val h))
          · exact fun h ↦ (by decide : (0 : Fin 3) ≠ 2) (hRinj
              (congrArg Subtype.val h))
          · exact fun h ↦ (by decide : (1 : Fin 3) ≠ 2) (hRinj
              (congrArg Subtype.val h))
          · intro h
            exact (hnone 0).ne (congrArg Subtype.val h)
          · intro h
            exact (hnone 1).ne (congrArg Subtype.val h)
          · intro h
            exact (hnone 2).ne (congrArg Subtype.val h)
        omega
      obtain ⟨k, hkFresh⟩ := hexFresh
      let eB₀ : Fin 3 ≃ Fin 3 := Equiv.swap 0 k
      have hLrem : LC (eA 1) ≠ LC (eA 2) := by
        intro heq
        have hval₀₁ : L (eA 0) = L (eA 1) := by
          simpa [eA, hij] using hLij
        have hval₁₂ : L (eA 1) = L (eA 2) :=
          congrArg Subtype.val heq
        have hno := not_three_outsideEndpoints_eq_of_outsideDegree_le_two
          E hout (hleftLabelNe eA (by decide : (0 : Fin 3) ≠ 1))
            (hleftLabelNe eA (by decide : (0 : Fin 3) ≠ 2))
            (hleftLabelNe eA (by decide : (1 : Fin 3) ≠ 2))
        apply hno
        constructor
        · simpa [L, alternatingLeftOutside] using hval₀₁
        · simpa [L, alternatingLeftOutside] using hval₀₁.trans hval₁₂
      obtain ⟨eB, heB0, hloops⟩ :=
        exists_right_reindex_avoiding_two_loops LC RC eA eB₀ hLrem
      refine ⟨eA, eB, ?_⟩
      apply reindexedOppositeSixClosure_inTashkinovClass_of_first_fresh
        P hPReg S E eA eB hsimple
      · intro heq
        have hno := not_three_outsideEndpoints_eq_of_outsideDegree_le_two
          E hout (hleftLabelNe eA (by decide : (0 : Fin 3) ≠ 1))
            (alternatingLeftLabel_ne_rightLabel (eA 0) (eB 0))
            (alternatingLeftLabel_ne_rightLabel (eA 1) (eB 0))
        apply hno
        constructor
        · have hval : L (eA 0) = L (eA 1) := by
            simpa [eA, hij] using hLij
          simpa [L, alternatingLeftOutside] using hval
        · exact congrArg Subtype.val heq
      · simp only [P, induce_mult, ofSimple_mult]
        rw [if_neg]
        intro hadj
        apply hkFresh
        simpa [L, R, LC, RC, eB₀, heB0] using hadj
      · exact hloops
    · obtain ⟨k, l, hRkl, hkl⟩ := Function.not_injective_iff.mp hRinj
      let eB : Fin 3 ≃ Fin 3 := finThreePairEquiv k l
      refine ⟨eA, eB, ?_⟩
      apply reindexedOppositeSixClosure_inTashkinovClass_of_duplicate
        P hPReg S E eA eB hsimple
      · apply Subtype.ext
        change L (eA 0) = L (eA 1)
        simpa [eA, hij] using hLij
      · apply Subtype.ext
        change R (eB 0) = R (eB 1)
        simpa [eB, hkl] using hRkl
      · intro heq
        have hno := not_three_outsideEndpoints_eq_of_outsideDegree_le_two
          E hout (hleftLabelNe eA (by decide : (0 : Fin 3) ≠ 1))
            (alternatingLeftLabel_ne_rightLabel (eA 0) (eB 0))
            (alternatingLeftLabel_ne_rightLabel (eA 1) (eB 0))
        apply hno
        constructor
        · simpa [L, alternatingLeftOutside, eA, hij] using hLij
        · exact congrArg Subtype.val heq

/-- On the complementary side of a balanced bipartite six-shore, no vertex
can carry three cut incidences.  Four incidences give a forbidden two-cut;
three give a four-cut whose only possible trivial shore contradicts the odd
order of the ambient graph. -/
lemma outsideDegree_compl_le_two_of_balanced_six_shore
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card W))
    (hno2 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity T ≠ 2)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (hcut : (ofSimple G).boundaryMultiplicity S = 6)
    (hScard : 4 ≤ S.card)
    (A B : Finset S) (hbip : ((ofSimple G).induce S).IsBipartiteWith A B)
    (hcard : A.card = B.card)
    (v : W) (hv : v ∈ Sᶜ) :
    (ofSimple G).outsideDegree Sᶜ v ≤ 2 := by
  classical
  letI : DecidableEq S := Classical.decEq S
  let P := ofSimple G
  let T := S ∪ {v}
  have hvS : v ∉ S := Finset.mem_compl.mp hv
  have hdis : Disjoint S ({v} : Finset W) := by
    rw [Finset.disjoint_singleton_right]
    exact hvS
  have hbetween : P.betweenMultiplicity S {v} =
      P.outsideDegree Sᶜ v := by
    rw [P.betweenMultiplicity_comm,
      P.betweenMultiplicity_singleton v S hvS]
    simp [outsideDegree]
  have hPReg : P.IsRegularOfDegree 4 :=
    (isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    hPReg S {v} hdis
  have hsingle : P.boundaryMultiplicity {v} = 4 :=
    boundaryMultiplicity_singleton_of_quartic G hreg v
  rw [hcut, hsingle, hbetween] at htoggle
  have hTcard : T.card = S.card + 1 := by
    change (S ∪ {v}).card = S.card + 1
    rw [Finset.card_union_of_disjoint hdis]
    simp
  have hTnonempty : T.Nonempty := Finset.card_pos.mp (by omega)
  have hTproper : T ≠ Finset.univ := by
    intro hTuniv
    have hSc : Sᶜ = ({v} : Finset W) := by
      ext x
      simp only [Finset.mem_compl, Finset.mem_singleton]
      constructor
      · intro hx
        have hxT : x ∈ T := by rw [hTuniv]; simp
        rcases Finset.mem_union.mp hxT with hxS | hxv
        · exact False.elim (hx hxS)
        · simpa using hxv
      · intro hx
        subst x
        exact hvS
    have hcomp := P.boundaryMultiplicity_compl S
    rw [hSc, hsingle] at hcomp
    rw [hcut] at hcomp
    omega
  have hSeven : ∃ k, S.card = 2 * k := by
    refine ⟨A.card, ?_⟩
    have hAB : A.card + B.card = S.card := by
      have hdiscard := Finset.card_union_of_disjoint hbip.disjoint
      have hcovercard : (A ∪ B).card = (Finset.univ : Finset S).card := by
        rw [hbip.cover]
      calc
        A.card + B.card = (A ∪ B).card := hdiscard.symm
        _ = (Finset.univ : Finset S).card := hcovercard
        _ = S.card := by simp
    omega
  have hkUpper : P.outsideDegree Sᶜ v ≤ 4 := by
    have hdeg := P.degree_induce_add_outsideDegree Sᶜ v hv
    rw [hPReg v] at hdeg
    omega
  by_cases hle : P.outsideDegree Sᶜ v ≤ 2
  · exact hle
  · exfalso
    have hkLower : 3 ≤ P.outsideDegree Sᶜ v := by omega
    have hcases : P.outsideDegree Sᶜ v = 3 ∨
        P.outsideDegree Sᶜ v = 4 := by omega
    rcases hcases with hk | hk
    · have hcutT : P.boundaryMultiplicity T = 4 := by
        change P.boundaryMultiplicity (S ∪ {v}) = 4
        omega
      rcases hno4 T hTnonempty hTproper hcutT with hTone | hTcomp
      · omega
      · have hcards := Finset.card_add_card_compl T
        rw [hTcard, hTcomp] at hcards
        rw [Nat.card_eq_fintype_card] at hodd
        rcases hodd with ⟨k, hkodd⟩
        rcases hSeven with ⟨m, hm⟩
        rw [hm] at hcards
        omega
    · have hcutT : P.boundaryMultiplicity T = 2 := by
        change P.boundaryMultiplicity (S ∪ {v}) = 2
        omega
      exact hno2 T hTnonempty hTproper hcutT

/-- The balanced case of Proposition 3.6.  On a vertex-minimal bad graph,
the three cut ends on each colour class can be paired so that the opposite
closure remains in Tashkinov's class.  Minimality supplies a cubic part on
that closure, while the balanced-shore colouring supplies every nonzero
decomposition pattern needed to splice it back. -/
lemma IsVertexMinimalCounterexample.false_of_balanced_minimalBipartiteSixShore
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities)
    (M : MinimalBipartiteSixShore G.toSimple)
    (A B : Finset M.shore)
    (hbip : ((ofSimple G.toSimple).induce M.shore).IsBipartiteWith A B)
    (hcard : A.card = B.card) : False := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  have hPG : ofSimple G.toSimple = G :=
    eq_ofSimple_toSimple_of_hasSimpleMultiplicities G hsimple
  have hregP : (ofSimple G.toSimple).IsRegularOfDegree 4 := by
    simpa only [hPG] using hmin.in_class.1
  have hreg : G.toSimple.IsRegularOfDegree 4 :=
    (isRegularOfDegree_ofSimple_iff G.toSimple 4).mp hregP
  have hno2G := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple
  have hno2 : ∀ T : Finset (Fin n), T.Nonempty → T ≠ Finset.univ →
      (ofSimple G.toSimple).boundaryMultiplicity T ≠ 2 := by
    simpa only [hPG] using hno2G
  have hno4G :=
    hmin.only_trivial_four_cuts_of_hasSimpleMultiplicities hsimple
  have hno4 : ∀ T : Finset (Fin n), T.Nonempty → T ≠ Finset.univ →
      (ofSimple G.toSimple).boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1 := by
    intro T hT hTproper hcut
    have hcutG : G.boundaryMultiplicity T = 4 := by
      simpa only [hPG] using hcut
    rcases hno4G T hT hTproper hcutG with hTcard | hCcard
    · exact .inl hTcard
    · right
      convert hCcard using 1
      apply congrArg Finset.card
      ext x
      simp
  have hoddn := hmin.odd_order_of_hasSimpleMultiplicities hsimple
  have hodd : Odd (Nat.card (Fin n)) := by
    simpa [Nat.card_eq_fintype_card] using hoddn
  have hnoCubicSimple : ¬ ContainsRegularSubgraph G.toSimple 3 := by
    intro hcubic
    apply hmin.no_cubic_part
    have hp := containsRegularPart_of_containsRegularSubgraph G.toSimple hcubic
    simpa only [hPG] using hp
  let E₀ : Fin 6 ≃ CrossingEdge (ofSimple G.toSimple) M.shore :=
    ((ofSimple G.toSimple).cutEquiv M.shore M.cut).symm
  have hcases := bipartiteSixShore_card_and_labelCount_cases
    (ofSimple G.toSimple) hregP M.shore M.cut E₀ A B hbip
  have hcounts : sixLabelCount E₀ A = 3 ∧ sixLabelCount E₀ B = 3 := by
    rcases hcases with hbalanced | himbalanced | himbalanced
    · exact ⟨hbalanced.2.1, hbalanced.2.2⟩
    · omega
    · omega
  have hcover : ∀ v : M.shore, v ∈ A ∨ v ∈ B := by
    intro v
    by_cases hvA : v ∈ A
    · exact .inl hvA
    · exact .inr (hbip.mem_right_of_not_mem_left hvA)
  obtain ⟨E, hE₀, hE₁, hE₂, hE₃, hE₄, hE₅⟩ :=
    exists_alternatingSixCutListing E₀ A B hbip.disjoint hcover
      hcounts.1 hcounts.2
  have hinjE : Function.Injective (sixPairEndpoint E) :=
    M.cutEndpoints_injective hreg hno2 hno4 E
  have hScard : 4 ≤ M.shore.card := M.four_le_card hreg
  have hout : ∀ v : Fin n, v ∈ M.shoreᶜ →
      (ofSimple G.toSimple).outsideDegree M.shoreᶜ v ≤ 2 := by
    intro v hv
    exact outsideDegree_compl_le_two_of_balanced_six_shore
      G.toSimple hreg hodd hno2 hno4 M.shore M.cut hScard
        A B hbip hcard v hv
  rcases containsThreeRegular_or_reindexedOppositeSixClosure_inClass
      G.toSimple hreg M.shore E hout with hcubic | hclosure
  · exact hnoCubicSimple hcubic
  · obtain ⟨eA, eB, hclosureClass⟩ := hclosure
    let E' : Fin 6 ≃ CrossingEdge (ofSimple G.toSimple) M.shore :=
      (finSixAlternatingReindex eA eB).trans E
    have hleft (i : Fin 3) : sixPairEndpoint E (alternatingLeftLabel i) ∈ A := by
      fin_cases i
      · simpa using hE₀
      · simpa using hE₂
      · simpa using hE₄
    have hright (i : Fin 3) : sixPairEndpoint E (alternatingRightLabel i) ∈ B := by
      fin_cases i
      · simpa using hE₁
      · simpa using hE₃
      · simpa using hE₅
    have hE'₀ : sixPairEndpoint E' 0 ∈ A := by
      change sixPairEndpoint E (finSixAlternatingReindex eA eB 0) ∈ A
      simpa using hleft (eA 0)
    have hE'₁ : sixPairEndpoint E' 1 ∈ B := by
      change sixPairEndpoint E (finSixAlternatingReindex eA eB 1) ∈ B
      simpa using hright (eB 0)
    have hE'₂ : sixPairEndpoint E' 2 ∈ A := by
      change sixPairEndpoint E (finSixAlternatingReindex eA eB 2) ∈ A
      simpa using hleft (eA 1)
    have hE'₃ : sixPairEndpoint E' 3 ∈ B := by
      change sixPairEndpoint E (finSixAlternatingReindex eA eB 3) ∈ B
      simpa using hright (eB 1)
    have hE'₄ : sixPairEndpoint E' 4 ∈ A := by
      change sixPairEndpoint E (finSixAlternatingReindex eA eB 4) ∈ A
      simpa using hleft (eA 2)
    have hE'₅ : sixPairEndpoint E' 5 ∈ B := by
      change sixPairEndpoint E (finSixAlternatingReindex eA eB 5) ∈ B
      simpa using hright (eB 2)
    have hinjE' : Function.Injective (sixPairEndpoint E') := by
      intro i j hij
      apply (finSixAlternatingReindex eA eB).injective
      apply hinjE
      exact hij
    have hlocal := balancedSixClosure_all_nonzero_patterns
      (ofSimple G.toSimple) hregP hno4 M.shore E' A B hbip hcard
        hE'₀ hE'₁ hE'₂ hE'₃ hE'₄ hE'₅ hinjE'
    rcases hlocal with hcubicP | hpatterns
    · apply hmin.no_cubic_part
      simpa only [hPG] using hcubicP
    · have hCnonempty : M.shoreᶜ.Nonempty := by
        rw [Finset.nonempty_iff_ne_empty]
        intro hempty
        exact M.shore_ne_univ ((Finset.compl_eq_empty_iff M.shore).mp hempty)
      letI : Nonempty ↑(M.shoreᶜ) :=
        ⟨⟨hCnonempty.choose, hCnonempty.choose_spec⟩⟩
      have hcardsum : M.shore.card + M.shoreᶜ.card = n := by
        simpa using Finset.card_add_card_compl M.shore
      have hCcard : Fintype.card ↑(M.shoreᶜ) < n := by
        rw [Fintype.card_coe]
        omega
      have hCpart :
          ((ofSimple G.toSimple).closeSixCutMatchingWith M.shoreᶜ
            (reverseSixCutListing E')).ContainsRegularPart 3 :=
        hmin.contains_of_card_lt _ (by simpa only [E'] using hclosureClass) hCcard
      have hspliced :=
        (ofSimple G.toSimple).containsRegularPart_of_sixCutMatchingClosuresWith
          M.shore E' hpatterns hCpart
      apply hmin.no_cubic_part
      simpa only [hPG] using hspliced

/-! ### The imbalanced six-shore closure

When one side of the bipartition has one fewer vertex, its six cut ends are
distributed `1,5`.  Tashkinov repairs the imbalance by pairing the unique
end on the smaller side with one end on the larger side and adjoining a new
vertex incident with the other four ends.  The following endpoint form of a
four-star is independent of a cut listing and is convenient for that hybrid
closure. -/

noncomputable def fourEndpointCount {X : Type*} [Fintype X]
    (f : Fin 4 → X) (v : X) : ℕ :=
  ∑ i : Fin 4, if f i = v then 1 else 0

noncomputable def fourStarClosure {X : Type*} [Fintype X]
    (H : Pseudograph X) (f : Fin 4 → X) : Pseudograph (Option X) where
  mult u v := match u, v with
    | none, none => 0
    | some x, some y => H.mult x y
    | none, some y => fourEndpointCount f y
    | some x, none => fourEndpointCount f x
  mult_comm u v := by
    cases u <;> cases v <;> simp only
    exact H.mult_comm _ _

@[simp] lemma fourStarClosure_mult_none_none
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X) :
    (fourStarClosure H f).mult none none = 0 := rfl

@[simp] lemma fourStarClosure_mult_some_some
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X)
    (u v : X) :
    (fourStarClosure H f).mult (some u) (some v) = H.mult u v := rfl

@[simp] lemma fourStarClosure_mult_none_some
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X)
    (v : X) :
    (fourStarClosure H f).mult none (some v) = fourEndpointCount f v := rfl

@[simp] lemma fourStarClosure_mult_some_none
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X)
    (v : X) :
    (fourStarClosure H f).mult (some v) none = fourEndpointCount f v := rfl

lemma sum_fourEndpointCount {X : Type*} [Fintype X]
    (f : Fin 4 → X) : ∑ v : X, fourEndpointCount f v = 4 := by
  classical
  simp only [fourEndpointCount]
  rw [Finset.sum_comm]
  have hone (i : Fin 4) : (∑ v : X, if f i = v then 1 else 0) = 1 := by
    rw [Finset.sum_eq_single (f i)]
    · simp
    · intro b _hb hne
      simp [hne.symm]
    · simp
  simp only [hone, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, mul_one]
  decide

lemma degree_fourStarClosure_none
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X) :
    (fourStarClosure H f).degree none = 4 := by
  classical
  rw [degree_eq_mult_self_add_sum]
  simp [sum_fourEndpointCount]

lemma degree_fourStarClosure_some
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X)
    (v : X) :
    (fourStarClosure H f).degree (some v) =
      H.degree v + fourEndpointCount f v := by
  classical
  rw [degree_eq_mult_self_add_sum, degree_eq_mult_self_add_sum]
  simp only [fourStarClosure_mult_some_some, Fintype.sum_option,
    fourStarClosure_mult_some_none]
  omega

lemma fourStarClosure_isRegularOfDegree_four
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X)
    (hdegree : ∀ v, H.degree v + fourEndpointCount f v = 4) :
    (fourStarClosure H f).IsRegularOfDegree 4 := by
  intro v
  cases v with
  | none => exact degree_fourStarClosure_none H f
  | some v => exact (degree_fourStarClosure_some H f v).trans (hdegree v)

/-- The four labels strictly between the paired labels `0` and `5`. -/
def finFourMiddleLabel (i : Fin 4) : Fin 6 :=
  ![1, 2, 3, 4] i

@[simp] lemma finFourMiddleLabel_zero : finFourMiddleLabel 0 = 1 := rfl
@[simp] lemma finFourMiddleLabel_one : finFourMiddleLabel 1 = 2 := rfl
@[simp] lemma finFourMiddleLabel_two : finFourMiddleLabel 2 = 3 := rfl
@[simp] lemma finFourMiddleLabel_three : finFourMiddleLabel 3 = 4 := rfl

lemma finFourMiddleLabel_ne_zero (i : Fin 4) :
    finFourMiddleLabel i ≠ 0 := by
  fin_cases i <;> decide

lemma finFourMiddleLabel_ne_five (i : Fin 4) :
    finFourMiddleLabel i ≠ 5 := by
  fin_cases i <;> decide

noncomputable def imbalancedSixClosure
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) : Pseudograph (Option S) :=
  fourStarClosure
    (G.induce S + singleEdge (sixPairEndpoint E 0) (sixPairEndpoint E 5))
    (fun i ↦ sixPairEndpoint E (finFourMiddleLabel i))

lemma imbalancedSixClosure_isRegularOfDegree
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S) :
    (G.imbalancedSixClosure S E).IsRegularOfDegree 4 := by
  classical
  letI : DecidableEq S := Classical.decEq S
  apply fourStarClosure_isRegularOfDegree_four
  intro v
  have houtside := G.outsideDegree_eq_listingEndpointCount S E v v.2
  have hledger := G.degree_induce_add_outsideDegree S v v.2
  rw [hreg v, houtside] at hledger
  have hcount :
      (if v = sixPairEndpoint E 0 then 1 else 0) +
          (if v = sixPairEndpoint E 5 then 1 else 0) +
          fourEndpointCount
            (fun i ↦ sixPairEndpoint E (finFourMiddleLabel i)) v =
        G.listingEndpointCount S E v := by
    rw [fourEndpointCount, Fin.sum_univ_four,
      listingEndpointCount, Fin.sum_univ_six]
    simp only [finFourMiddleLabel_zero, finFourMiddleLabel_one,
      finFourMiddleLabel_two, finFourMiddleLabel_three]
    have heq (i : Fin 6) :
        (v = sixPairEndpoint E i) = ((E i).inside = (v : W)) := by
      apply propext
      constructor
      · intro h
        simpa [sixPairEndpoint] using congrArg Subtype.val h.symm
      · intro h
        apply Subtype.ext
        exact h.symm
    have heq' (i : Fin 6) :
        (sixPairEndpoint E i = v) = ((E i).inside = (v : W)) := by
      apply propext
      constructor
      · intro h
        simpa [sixPairEndpoint] using congrArg Subtype.val h
      · intro h
        apply Subtype.ext
        exact h
    simp_rw [heq, heq']
    omega
  have hrepair :
      (singleEdge (sixPairEndpoint E 0)
          (sixPairEndpoint E 5)).degree v +
          fourEndpointCount
            (fun i ↦ sixPairEndpoint E (finFourMiddleLabel i)) v =
        G.listingEndpointCount S E v := by
    rw [degree_singleEdge]
    exact hcount
  rw [degree_add, Nat.add_assoc, hrepair]
  exact hledger

lemma loopCount_fourStarClosure
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X) :
    (fourStarClosure H f).loopCount = H.loopCount := by
  classical
  unfold loopCount
  rw [Fintype.sum_option]
  simp

lemma parallelPairCount_fourStarClosure_le
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X) :
    (fourStarClosure H f).parallelPairCount ≤
      H.parallelPairCount +
        (Finset.univ.filter fun v : X ↦ 2 ≤ fourEndpointCount f v).card := by
  classical
  let heavy : Finset X :=
    Finset.univ.filter fun v ↦ 2 ≤ fourEndpointCount f v
  let R := Finset.univ.filter fun p : Option X × Option X ↦
    p.1 ≠ p.2 ∧ 2 ≤ (fourStarClosure H f).mult p.1 p.2
  let D := Finset.univ.filter fun p : X × X ↦
    p.1 ≠ p.2 ∧ 2 ≤ H.mult p.1 p.2
  let L : Finset (Option X × Option X) :=
    D.image fun p ↦ (some p.1, some p.2)
  let A : Finset (Option X × Option X) :=
    heavy.image fun v ↦ (none, some v)
  let B : Finset (Option X × Option X) :=
    heavy.image fun v ↦ (some v, none)
  have hsub : R ⊆ L ∪ A ∪ B := by
    intro p hp
    have hp' : p.1 ≠ p.2 ∧
        2 ≤ (fourStarClosure H f).mult p.1 p.2 := by
      simpa only [R, Finset.mem_filter, Finset.mem_univ, true_and] using hp
    rcases p with ⟨u, v⟩
    cases u with
    | none =>
        cases v with
        | none => simp at hp'
        | some v =>
            apply Finset.mem_union_left
            apply Finset.mem_union_right
            apply Finset.mem_image.mpr
            refine ⟨v, ?_, rfl⟩
            simpa [heavy] using hp'.2
    | some u =>
        cases v with
        | none =>
            apply Finset.mem_union_right
            apply Finset.mem_image.mpr
            refine ⟨u, ?_, rfl⟩
            simpa [heavy] using hp'.2
        | some v =>
            apply Finset.mem_union_left
            apply Finset.mem_union_left
            apply Finset.mem_image.mpr
            refine ⟨(u, v), ?_, rfl⟩
            simpa [D] using hp'
  have hL : L.card ≤ D.card := Finset.card_image_le
  have hA : A.card ≤ heavy.card := Finset.card_image_le
  have hB : B.card ≤ heavy.card := Finset.card_image_le
  have hR : R.card ≤ D.card + 2 * heavy.card := by
    have h₁ := Finset.card_le_card hsub
    have h₂ := Finset.card_union_le (L ∪ A) B
    have h₃ := Finset.card_union_le L A
    omega
  have hD : D.card = 2 * H.parallelPairCount := by
    simpa only [D] using H.parallelPairFilter_card_eq_two_mul
  have hfinal : R.card / 2 ≤ D.card / 2 + heavy.card := by
    rw [hD]
    omega
  unfold parallelPairCount
  dsimp only [R, D, heavy] at hfinal
  convert hfinal using 1 <;> congr 2 <;> ext p <;> simp

lemma fourEndpointCount_update
    {X : Type*} [Fintype X] (f : Fin 4 → X) (i : Fin 4) (z v : X) :
    fourEndpointCount (Function.update f i z) v +
        (if f i = v then 1 else 0) =
      fourEndpointCount f v + (if z = v then 1 else 0) := by
  classical
  fin_cases i <;>
    rw [fourEndpointCount, fourEndpointCount,
      Fin.sum_univ_four, Fin.sum_univ_four] <;>
    simp [Function.update] <;> omega

lemma fourEndpointCount_pos_iff
    {X : Type*} [Fintype X] (f : Fin 4 → X) (v : X) :
    0 < fourEndpointCount f v ↔ ∃ i, f i = v := by
  rw [fourEndpointCount, Fin.sum_univ_four]
  constructor
  · intro h
    by_contra hn
    push_neg at hn
    simp [hn] at h
  · rintro ⟨i, hi⟩
    fin_cases i <;> simp_all

lemma fourEndpointCount_eq_zero_of_ne
    {X : Type*} [Fintype X] (f : Fin 4 → X) (v : X)
    (h : ∀ i, f i ≠ v) :
    fourEndpointCount f v = 0 := by
  rw [fourEndpointCount, Fin.sum_univ_four]
  simp [h]

/-- If four entries already contain two repeated values, replacing one
occurrence by any fifth value can be done so that at most one value remains
repeated.  This is the finite multiplicity observation in the imbalanced
closure construction. -/
lemma exists_update_fourEndpointCount_heavy_le_one
    {X : Type*} [Fintype X] (f : Fin 4 → X) (z : X)
    (hlarge : 1 <
      (Finset.univ.filter fun v : X ↦ 2 ≤ fourEndpointCount f v).card) :
    ∃ i : Fin 4,
      (Finset.univ.filter fun v : X ↦
        2 ≤ fourEndpointCount (Function.update f i z) v).card ≤ 1 := by
  classical
  obtain ⟨x, hx, y, hy, hxy⟩ := Finset.one_lt_card.mp hlarge
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx hy
  have hsum := sum_fourEndpointCount f
  have hxySum : fourEndpointCount f x + fourEndpointCount f y ≤ 4 := by
    calc
      fourEndpointCount f x + fourEndpointCount f y =
          ∑ v ∈ ({x, y} : Finset X), fourEndpointCount f v := by
            rw [Finset.sum_insert (by simpa using hxy), Finset.sum_singleton]
      _ ≤ ∑ v : X, fourEndpointCount f v :=
        Finset.sum_le_sum_of_subset (Finset.subset_univ _)
      _ = 4 := hsum
  have hx2 : fourEndpointCount f x = 2 := by omega
  have hy2 : fourEndpointCount f y = 2 := by omega
  have hall (k : Fin 4) : f k = x ∨ f k = y := by
    by_contra hk
    push_neg at hk
    have hkpos : 0 < fourEndpointCount f (f k) :=
      (fourEndpointCount_pos_iff f (f k)).2 ⟨k, rfl⟩
    have hthree :
        fourEndpointCount f x + fourEndpointCount f y +
          fourEndpointCount f (f k) ≤ 4 := by
      calc
        _ = ∑ v ∈ ({x, y, f k} : Finset X),
            fourEndpointCount f v := by
              rw [Finset.sum_insert
                  (by simp [hxy, Ne.symm hk.1, Ne.symm hk.2]),
                Finset.sum_insert (by simp [Ne.symm hk.2]),
                Finset.sum_singleton]
              simp [Nat.add_assoc]
        _ ≤ ∑ v : X, fourEndpointCount f v :=
          Finset.sum_le_sum_of_subset (Finset.subset_univ _)
        _ = 4 := hsum
    omega
  obtain ⟨w, q, hwq, hw2, hq2, hwz, hallwq⟩ :
      ∃ w q, w ≠ q ∧ fourEndpointCount f w = 2 ∧
        fourEndpointCount f q = 2 ∧ w ≠ z ∧
        ∀ k, f k = w ∨ f k = q := by
    by_cases hxz : x = z
    · exact ⟨y, x, hxy.symm, hy2, hx2,
        fun hyz ↦ hxy (hxz.trans hyz.symm),
        fun k ↦ (hall k).symm⟩
    · exact ⟨x, y, hxy, hx2, hy2, hxz, hall⟩
  obtain ⟨t, ht⟩ := (fourEndpointCount_pos_iff f w).1 (by omega)
  refine ⟨t, Finset.card_le_one_iff.mpr ?_⟩
  intro a b ha hb
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
  have hnotHeavy (v : X) (hvq : v ≠ q) :
      fourEndpointCount (Function.update f t z) v < 2 := by
    by_cases hvw : v = w
    · subst v
      have hu := fourEndpointCount_update f t z w
      simp [ht, hwz.symm, hw2] at hu
      omega
    · have hzero : fourEndpointCount f v = 0 := by
        apply fourEndpointCount_eq_zero_of_ne
        intro k hkv
        rcases hallwq k with hkw | hkq
        · exact hvw (hkv.symm.trans hkw)
        · exact hvq (hkv.symm.trans hkq)
      have hu := fourEndpointCount_update f t z v
      have htv : f t ≠ v := by
        intro htv
        exact hvw (htv.symm.trans ht)
      simp [hzero, htv] at hu
      have hite : (if z = v then 1 else 0) ≤ 1 := by
        split_ifs <;> omega
      omega
  have haq : a = q := by
    by_contra h
    exact (not_lt_of_ge ha) (hnotHeavy a h)
  have hbq : b = q := by
    by_contra h
    exact (not_lt_of_ge hb) (hnotHeavy b h)
  exact haq.trans hbq.symm

lemma fourStarClosure_inTashkinovClass
    {X : Type*} [Fintype X] (H : Pseudograph X) (f : Fin 4 → X)
    (hdefect : H.loopCount + H.parallelPairCount ≤ 1)
    (hheavy :
      (Finset.univ.filter fun v : X ↦
        2 ≤ fourEndpointCount f v).card ≤ 1)
    (hreg : (fourStarClosure H f).IsRegularOfDegree 4) :
    (fourStarClosure H f).InTashkinovClass := by
  have hloop := loopCount_fourStarClosure H f
  have hparallel := parallelPairCount_fourStarClosure_le H f
  refine ⟨hreg, ?_, ?_⟩
  · rw [hloop]
    omega
  · rw [hloop]
    omega

lemma HasSimpleMultiplicities.add_singleEdge_defect_le_one
    {X : Type*} [Fintype X] {H : Pseudograph X}
    (hsimple : H.HasSimpleMultiplicities) (a b : X) :
    (H + singleEdge a b).loopCount +
      (H + singleEdge a b).parallelPairCount ≤ 1 := by
  classical
  by_cases hab : a = b
  · subst b
    have hloop := loopCount_add_singleEdge_le_one H hsimple.1 a a
    have hparallel : (H + singleEdge a a).parallelPairCount = 0 := by
      rw [parallelPairCount_add_loop]
      exact H.parallelPairCount_eq_zero_of_mult_le_one
        (fun u v _ ↦ hsimple.2 u v)
    omega
  · have hloop : (H + singleEdge a b).loopCount = 0 := by
      rw [loopCount_add, loopCount_singleEdge, if_neg hab]
      have hbase : H.loopCount = 0 := by
        unfold loopCount
        simp [hsimple.1]
      omega
    have hparallel := parallelPairCount_add_singleEdge_le_one H hsimple.2 a b
    omega

/-- Split six labels into one distinguished label and five remaining
labels, in their natural order. -/
noncomputable def finSixOneFiveEquiv : Fin 6 ≃ (Fin 1 ⊕ Fin 5) :=
  Equiv.ofBijective
    (fun i : Fin 6 ↦ ![Sum.inl 0, Sum.inr 0, Sum.inr 1,
      Sum.inr 2, Sum.inr 3, Sum.inr 4] i)
    (by decide)

@[simp] lemma finSixOneFiveEquiv_zero :
    finSixOneFiveEquiv 0 = Sum.inl 0 := rfl
@[simp] lemma finSixOneFiveEquiv_one :
    finSixOneFiveEquiv 1 = Sum.inr 0 := rfl
@[simp] lemma finSixOneFiveEquiv_two :
    finSixOneFiveEquiv 2 = Sum.inr 1 := rfl
@[simp] lemma finSixOneFiveEquiv_three :
    finSixOneFiveEquiv 3 = Sum.inr 2 := rfl
@[simp] lemma finSixOneFiveEquiv_four :
    finSixOneFiveEquiv 4 = Sum.inr 3 := rfl
@[simp] lemma finSixOneFiveEquiv_five :
    finSixOneFiveEquiv 5 = Sum.inr 4 := rfl

/-- Reindex a `1,5` bipartite six-cut so the unique small-side label is
`0` and the five large-side labels are `1,...,5`. -/
lemma exists_oneFiveSixCutListing
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (A B : Finset S)
    (hdisj : Disjoint A B) (hcover : ∀ v : S, v ∈ A ∨ v ∈ B)
    (hAcount : sixLabelCount E A = 1)
    (hBcount : sixLabelCount E B = 5) :
    ∃ E' : Fin 6 ≃ CrossingEdge G S,
      sixPairEndpoint E' 0 ∈ A ∧
      sixPairEndpoint E' 1 ∈ B ∧
      sixPairEndpoint E' 2 ∈ B ∧
      sixPairEndpoint E' 3 ∈ B ∧
      sixPairEndpoint E' 4 ∈ B ∧
      sixPairEndpoint E' 5 ∈ B := by
  classical
  let IA := (Finset.univ : Finset (Fin 6)).filter fun i ↦
    sixPairEndpoint E i ∈ A
  let IB := (Finset.univ : Finset (Fin 6)).filter fun i ↦
    sixPairEndpoint E i ∈ B
  have hIAcard : Fintype.card IA = 1 := by
    simpa only [Fintype.card_coe] using
      (show IA.card = 1 by simpa [IA, sixLabelCount] using hAcount)
  have hIBcard : Fintype.card IB = 5 := by
    simpa only [Fintype.card_coe] using
      (show IB.card = 5 by simpa [IB, sixLabelCount] using hBcount)
  let eA : IA ≃ Fin 1 := Fintype.equivFinOfCardEq hIAcard
  let eB : IB ≃ Fin 5 := Fintype.equivFinOfCardEq hIBcard
  have hIAdisj : Disjoint IA IB := by
    rw [Finset.disjoint_left]
    intro i hiA hiB
    exact (Finset.disjoint_left.mp hdisj)
      (Finset.mem_filter.mp hiA).2 (Finset.mem_filter.mp hiB).2
  have hIcover : ∀ i : Fin 6, i ∈ IA ∨ i ∈ IB := by
    intro i
    rcases hcover (sixPairEndpoint E i) with hi | hi
    · exact .inl (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩)
    · exact .inr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩)
  let p : (IA ⊕ IB) ≃ Fin 6 :=
    finsetPartitionEquiv IA IB hIAdisj hIcover
  let E' : Fin 6 ≃ CrossingEdge G S :=
    finSixOneFiveEquiv.trans
      ((Equiv.sumCongr eA.symm eB.symm).trans (p.trans E))
  refine ⟨E', ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change sixPairEndpoint E (eA.symm 0) ∈ A
    exact (Finset.mem_filter.mp (eA.symm 0).2).2
  · change sixPairEndpoint E (eB.symm 0) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 0).2).2
  · change sixPairEndpoint E (eB.symm 1) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 1).2).2
  · change sixPairEndpoint E (eB.symm 2) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 2).2).2
  · change sixPairEndpoint E (eB.symm 3) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 3).2).2
  · change sixPairEndpoint E (eB.symm 4) ∈ B
    exact (Finset.mem_filter.mp (eB.symm 4).2).2

/-- Hall's theorem with two prescribed disjoint edges, factored so a caller
only has to exclude the particular four-cut produced by a Hall defect. -/
lemma exists_perfectMatching_containing_two_edges_of_forbidHallFour
    {X : Type*} [Fintype X]
    (P : Pseudograph X) (hreg : P.IsRegularOfDegree 4)
    (A B : Finset X) (hbip : P.IsBipartiteWith A B)
    (hcard : A.card = B.card)
    {a b c d : X}
    (ha : a ∈ A) (hb : b ∈ B) (hc : c ∈ A) (hd : d ∈ B)
    (hac : a ≠ c) (hbd : b ≠ d)
    (hab : P.toSimple.Adj a b) (hcd : P.toSimple.Adj c d)
    (hforbid : ∀ Y : Finset X,
      P.boundaryMultiplicity Y = 4 →
      b ∈ Y → d ∈ Y → a ∉ Y → c ∉ Y → False) :
    ∃ M : P.toSimple.Subgraph,
      M.IsPerfectMatching ∧ M.Adj a b ∧ M.Adj c d := by
  classical
  have had : a ≠ d := by
    intro h
    subst d
    exact (Finset.disjoint_left.mp hbip.disjoint) ha hd
  have hbc : b ≠ c := by
    intro h
    subst c
    exact (Finset.disjoint_left.mp hbip.disjoint) hc hb
  let L : Finset X := A \ {a, c}
  let R : Finset X := B \ {b, d}
  have hpairAsub : ({a, c} : Finset X) ⊆ A := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact ha
    · exact hc
  have hpairBsub : ({b, d} : Finset X) ⊆ B := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact hb
    · exact hd
  have hLcard : L.card + 2 = A.card := by
    have h := Finset.card_sdiff_add_card_eq_card hpairAsub
    simpa [L, hac] using h
  have hRcard : R.card + 2 = B.card := by
    have h := Finset.card_sdiff_add_card_eq_card hpairBsub
    simpa [R, hbd] using h
  have hLRcard : L.card = R.card := by omega
  have hLsubA : L ⊆ A := fun _ hx ↦ (Finset.mem_sdiff.mp hx).1
  have hRsubB : R ⊆ B := fun _ hx ↦ (Finset.mem_sdiff.mp hx).1
  have hLRdisj : Disjoint L R :=
    Disjoint.mono hLsubA hRsubB hbip.disjoint
  have haLR : a ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
    · exact (Finset.disjoint_left.mp hbip.disjoint) ha (hRsubB hmem)
  have hbLR : b ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.disjoint_left.mp hbip.disjoint) (hLsubA hmem) hb
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
  have hcLR : c ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
    · exact (Finset.disjoint_left.mp hbip.disjoint) hc (hRsubB hmem)
  have hdLR : d ∉ L ∪ R := by
    intro hmem
    rcases Finset.mem_union.mp hmem with hmem | hmem
    · exact (Finset.disjoint_left.mp hbip.disjoint) (hLsubA hmem) hd
    · exact (Finset.mem_sdiff.mp hmem).2 (by simp)
  have hcover (v : X) :
      v ∈ L ∨ v ∈ R ∨ v = a ∨ v = b ∨ v = c ∨ v = d := by
    have hvAB : v ∈ A ∨ v ∈ B := by
      have hv : v ∈ Finset.univ := Finset.mem_univ v
      rw [← hbip.cover] at hv
      simpa only [Finset.mem_union] using hv
    rcases hvAB with hvA | hvB
    · by_cases hva : v = a
      · exact .inr (.inr (.inl hva))
      · by_cases hvc : v = c
        · exact .inr (.inr (.inr (.inr (.inl hvc))))
        · exact .inl (Finset.mem_sdiff.mpr
            ⟨hvA, by simp [hva, hvc]⟩)
    · by_cases hvb : v = b
      · exact .inr (.inr (.inr (.inl hvb)))
      · by_cases hvd : v = d
        · exact .inr (.inr (.inr (.inr (.inr hvd))))
        · exact .inr (.inl (Finset.mem_sdiff.mpr
            ⟨hvB, by simp [hvb, hvd]⟩))
  let rel : L → R → Prop := fun x y ↦ P.toSimple.Adj x y
  by_cases htrans : ∃ f : L → R, Function.Injective f ∧
      ∀ x, rel x (f x)
  · obtain ⟨f, hf, hadj⟩ := htrans
    obtain ⟨M, hM, hMab, hMcd⟩ :=
      exists_isPerfectMatching_of_transversal_and_two_edges
        P.toSimple L R hLRdisj hLRcard
        ⟨fun h ↦ haLR (Finset.mem_union_left R h),
          fun h ↦ haLR (Finset.mem_union_right L h)⟩
        ⟨fun h ↦ hbLR (Finset.mem_union_left R h),
          fun h ↦ hbLR (Finset.mem_union_right L h)⟩
        ⟨fun h ↦ hcLR (Finset.mem_union_left R h),
          fun h ↦ hcLR (Finset.mem_union_right L h)⟩
        ⟨fun h ↦ hdLR (Finset.mem_union_left R h),
          fun h ↦ hdLR (Finset.mem_union_right L h)⟩
        hac had hbc hbd hcover hab hcd f hf hadj
    exact ⟨M, hM, hMab, hMcd⟩
  · have htypeCard : Fintype.card L = Fintype.card R := by
      simpa using hLRcard
    obtain ⟨U', T', hUTcard, hneighbor⟩ :=
      exists_exact_hallDefect rel htypeCard htrans
    let U : Finset X := U'.image Subtype.val
    let T₀ : Finset X := T'.image Subtype.val
    let T : Finset X := T₀ ∪ {b, d}
    let Y : Finset X := U ∪ T
    have hUsubL : U ⊆ L := by
      intro x hx
      obtain ⟨x', _hxU, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    have hT₀subR : T₀ ⊆ R := by
      intro x hx
      obtain ⟨x', _hxT, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    have hbT₀ : b ∉ T₀ := by
      intro hmem
      exact (Finset.mem_sdiff.mp (hT₀subR hmem)).2 (by simp)
    have hdT₀ : d ∉ T₀ := by
      intro hmem
      exact (Finset.mem_sdiff.mp (hT₀subR hmem)).2 (by simp)
    have hTcard : T.card = U.card + 1 := by
      have hUcard : U.card = U'.card := by
        simp [U, Finset.card_image_of_injective _ Subtype.val_injective]
      have hT₀card : T₀.card = T'.card := by
        simp [T₀, Finset.card_image_of_injective _ Subtype.val_injective]
      have hdis : Disjoint T₀ ({b, d} : Finset X) := by
        rw [Finset.disjoint_left]
        intro x hx hxpair
        simp only [Finset.mem_insert, Finset.mem_singleton] at hxpair
        rcases hxpair with rfl | rfl
        · exact hbT₀ hx
        · exact hdT₀ hx
      change (T₀ ∪ {b, d}).card = U.card + 1
      rw [Finset.card_union_of_disjoint hdis]
      simp [hbd, hUcard, hT₀card]
      omega
    have hUsubA : U ⊆ A := hUsubL.trans hLsubA
    have hTsubB : T ⊆ B := by
      intro x hx
      rcases Finset.mem_union.mp hx with hx | hx
      · exact hRsubB (hT₀subR hx)
      · simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl
        · exact hb
        · exact hd
    have hclosed : ∀ u ∈ U, ∀ w, 0 < P.mult u w → w ∈ T := by
      intro u hu w huw
      have huA := hUsubA hu
      have hwB : w ∈ B := by
        rcases hbip.crosses huw with h | h
        · exact h.2
        · exact False.elim
            ((Finset.disjoint_left.mp hbip.disjoint) huA h.1)
      by_cases hwb : w = b
      · simp [T, hwb]
      by_cases hwd : w = d
      · simp [T, hwd]
      have hwR : w ∈ R := Finset.mem_sdiff.mpr
        ⟨hwB, by simp [hwb, hwd]⟩
      obtain ⟨u', hu'U, hu'eq⟩ := Finset.mem_image.mp hu
      let w' : R := ⟨w, hwR⟩
      have hrel : rel u' w' := by
        change P.toSimple.Adj (u' : X) (w' : X)
        refine ⟨?_, ?_⟩
        · intro heq
          have huB : u ∈ B := by
            rw [← hu'eq, heq]
            exact hwB
          exact (Finset.disjoint_left.mp hbip.disjoint) huA
            huB
        · simpa [hu'eq] using huw
      have hwT' := hneighbor u' hu'U w' hrel
      apply Finset.mem_union_left
      exact Finset.mem_image.mpr ⟨w', hwT', rfl⟩
    have hcut : P.boundaryMultiplicity Y = 4 := by
      change P.boundaryMultiplicity (U ∪ T) = 4
      exact boundaryMultiplicity_union_eq_four_of_bipartite_neighbor_closed
        P hreg A B U T hbip hUsubA hTsubB hTcard hclosed
    have hbY : b ∈ Y := by simp [Y, T]
    have hdY : d ∈ Y := by simp [Y, T]
    have haY : a ∉ Y := by
      intro haY
      rcases Finset.mem_union.mp haY with haU | haT
      · exact (Finset.mem_sdiff.mp (hUsubL haU)).2 (by simp)
      · exact (Finset.disjoint_left.mp hbip.disjoint) ha (hTsubB haT)
    have hcY : c ∉ Y := by
      intro hcY
      rcases Finset.mem_union.mp hcY with hcU | hcT
      · exact (Finset.mem_sdiff.mp (hUsubL hcU)).2 (by simp)
      · exact (Finset.disjoint_left.mp hbip.disjoint) hc (hTsubB hcT)
    exact False.elim (hforbid Y hcut hbY hdY haY hcY)

/-- Swap one of the four star labels with the paired label `5`. -/
noncomputable def finSixMiddleSwap (i : Fin 4) : Fin 6 ≃ Fin 6 :=
  Equiv.swap (finFourMiddleLabel i) 5

lemma finFourMiddleLabel_injective :
    Function.Injective finFourMiddleLabel := by
  intro i j h
  fin_cases i <;> fin_cases j <;> simp_all

@[simp] lemma finSixMiddleSwap_zero (i : Fin 4) :
    finSixMiddleSwap i 0 = 0 := by
  rw [finSixMiddleSwap, Equiv.swap_apply_of_ne_of_ne]
  · exact (finFourMiddleLabel_ne_zero i).symm
  · decide

@[simp] lemma finSixMiddleSwap_five (i : Fin 4) :
    finSixMiddleSwap i 5 = finFourMiddleLabel i := by
  simp [finSixMiddleSwap]

@[simp] lemma finSixMiddleSwap_middle_self (i : Fin 4) :
    finSixMiddleSwap i (finFourMiddleLabel i) = 5 := by
  simp [finSixMiddleSwap]

lemma finSixMiddleSwap_middle_of_ne {i j : Fin 4} (hij : j ≠ i) :
    finSixMiddleSwap i (finFourMiddleLabel j) = finFourMiddleLabel j := by
  rw [finSixMiddleSwap, Equiv.swap_apply_of_ne_of_ne]
  · exact fun h ↦ hij (finFourMiddleLabel_injective h)
  · exact finFourMiddleLabel_ne_five j

lemma fourStarEndpoints_reverse_middleSwap
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 4) :
    (fun j ↦ sixPairEndpoint
        (reverseSixCutListing ((finSixMiddleSwap i).trans E))
          (finFourMiddleLabel j)) =
      Function.update
        (fun j ↦ sixPairEndpoint (reverseSixCutListing E)
          (finFourMiddleLabel j)) i
        (sixPairEndpoint (reverseSixCutListing E) 5) := by
  classical
  funext j
  apply Subtype.ext
  by_cases hji : j = i
  · subst j
    simp [Function.update, sixPairEndpoint,
      reverseSixCutListing_inside]
  · simp [Function.update, hji, sixPairEndpoint,
      reverseSixCutListing_inside, Equiv.trans_apply,
      finSixMiddleSwap_middle_of_ne]

/-- Reindexing only among the five large-side labels can always make the
opposite imbalanced hybrid closure a member of Tashkinov's class. -/
lemma exists_middleReindex_oppositeImbalancedClosure_inTashkinovClass
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hsimple : (G.induce Sᶜ).HasSimpleMultiplicities) :
    ∃ p : Fin 6 ≃ Fin 6,
      p 0 = 0 ∧
      (∀ i : Fin 6, i ≠ 0 → p i ≠ 0) ∧
      (G.imbalancedSixClosure Sᶜ
        (reverseSixCutListing (p.trans E))).InTashkinovClass := by
  classical
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  let f : Fin 4 → ↑(Sᶜ) := fun i ↦
    sixPairEndpoint EC (finFourMiddleLabel i)
  let z : ↑(Sᶜ) := sixPairEndpoint EC 5
  let heavy : Finset ↑(Sᶜ) :=
    Finset.univ.filter fun v ↦ 2 ≤ fourEndpointCount f v
  by_cases hsmall : heavy.card ≤ 1
  · refine ⟨Equiv.refl _, rfl, ?_, ?_⟩
    · intro i hi
      simpa using hi
    · apply fourStarClosure_inTashkinovClass
        (G.induce Sᶜ + singleEdge
          (sixPairEndpoint EC 0) (sixPairEndpoint EC 5)) f
      · exact hsimple.add_singleEdge_defect_le_one _ _
      · simpa only [heavy] using hsmall
      · exact imbalancedSixClosure_isRegularOfDegree G hreg Sᶜ EC
  · have hlarge : 1 < heavy.card := by omega
    obtain ⟨i, hi⟩ := exists_update_fourEndpointCount_heavy_le_one
      f z (by simpa only [heavy] using hlarge)
    let p := finSixMiddleSwap i
    let EC' : Fin 6 ≃ CrossingEdge G Sᶜ :=
      reverseSixCutListing (p.trans E)
    have hf :
        (fun j ↦ sixPairEndpoint EC' (finFourMiddleLabel j)) =
          Function.update f i z := by
      simpa only [p, EC', f, z] using
        fourStarEndpoints_reverse_middleSwap G S E i
    refine ⟨p, finSixMiddleSwap_zero i, ?_, ?_⟩
    · intro j hj
      by_cases hj5 : j = 5
      · subst j
        simp [p, finFourMiddleLabel_ne_zero]
      · by_cases hex : ∃ k : Fin 4, j = finFourMiddleLabel k
        · obtain ⟨k, rfl⟩ := hex
          by_cases hki : k = i
          · subst k
            simp [p]
          · change finSixMiddleSwap i (finFourMiddleLabel k) ≠ 0
            rw [finSixMiddleSwap_middle_of_ne hki]
            exact finFourMiddleLabel_ne_zero k
        · have hjCases : j = 0 ∨ j = 5 ∨
              ∃ k : Fin 4, j = finFourMiddleLabel k := by
            fin_cases j
            · exact .inl rfl
            · exact .inr (.inr ⟨0, rfl⟩)
            · exact .inr (.inr ⟨1, rfl⟩)
            · exact .inr (.inr ⟨2, rfl⟩)
            · exact .inr (.inr ⟨3, rfl⟩)
            · exact .inr (.inl rfl)
          exact False.elim
            (hex ((hjCases.resolve_left hj).resolve_left hj5))
    · change (fourStarClosure
        (G.induce Sᶜ + singleEdge
          (sixPairEndpoint EC' 0) (sixPairEndpoint EC' 5))
        (fun j ↦ sixPairEndpoint EC' (finFourMiddleLabel j))).InTashkinovClass
      apply fourStarClosure_inTashkinovClass
      · have hbase :
            (G.induce Sᶜ + singleEdge
              (sixPairEndpoint EC' 0)
              (sixPairEndpoint EC' 5)).loopCount +
              (G.induce Sᶜ + singleEdge
                (sixPairEndpoint EC' 0)
                (sixPairEndpoint EC' 5)).parallelPairCount ≤ 1 :=
          hsimple.add_singleEdge_defect_le_one _ _
        exact hbase
      · rw [hf]
        exact hi
      · exact imbalancedSixClosure_isRegularOfDegree G hreg Sᶜ EC'

/-- If the paired label `0` is outside a set of old shore vertices, the
hybrid closure has exactly the same boundary on their `some`-image as the
original graph has on their ambient image.  The new center is outside the
image, so its four star edges replace labels `1,...,4`, while the paired
edge replaces label `5`; label `0` contributes on neither side. -/
lemma boundaryMultiplicity_imbalancedSixClosure_map_some
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (U : Finset S) (hzero : sixPairEndpoint E 0 ∉ U) :
    (G.imbalancedSixClosure S E).boundaryMultiplicity
        (U.map Function.Embedding.some) =
      G.boundaryMultiplicity
        (U.map (Function.Embedding.subtype _)) := by
  classical
  let Q := G.imbalancedSixClosure S E
  let Y : Finset (Option S) := U.map Function.Embedding.some
  let A : Finset W := U.map (Function.Embedding.subtype _)
  let eY : U ≃ Y := finsetMapEquiv U Function.Embedding.some
  let eA : U ≃ A :=
    finsetMapEquiv U (Function.Embedding.subtype _)
  have hpairZero (x y : U) :
      (singleEdge (sixPairEndpoint E 0)
        (sixPairEndpoint E 5)).mult (x : S) (y : S) = 0 := by
    rw [singleEdge_mult, if_neg]
    intro hshape
    rcases hshape with hshape | hshape
    · apply hzero
      rw [← hshape.1]
      exact x.2
    · apply hzero
      rw [← hshape.2]
      exact y.2
  have hgraphs :
      (Q.induce Y).relabel eY.symm =
        (G.induce A).relabel eA.symm := by
    apply Pseudograph.ext
    intro x y
    simp only [relabel_mult, Equiv.symm_symm,
      Equiv.apply_symm_apply, induce_mult]
    change Q.mult (some (x : S)) (some (y : S)) =
      G.mult (x : W) (y : W)
    change (G.induce S + singleEdge (sixPairEndpoint E 0)
      (sixPairEndpoint E 5)).mult (x : S) (y : S) = _
    rw [add_mult, hpairZero x y]
    simp [induce_mult]
  have hinducedDegree (x : U) :
      (Q.induce Y).degree (eY x) =
        (G.induce A).degree (eA x) := by
    calc
      (Q.induce Y).degree (eY x) =
          ((Q.induce Y).relabel eY.symm).degree x := by
            symm
            simpa using (Q.induce Y).degree_relabel eY.symm (eY x)
      _ = ((G.induce A).relabel eA.symm).degree x := by rw [hgraphs]
      _ = (G.induce A).degree (eA x) := by
            simpa using (G.induce A).degree_relabel eA.symm (eA x)
  have houtside (x : U) :
      Q.outsideDegree Y (some (x : S)) =
        G.outsideDegree A (x : W) := by
    have hxY : some (x : S) ∈ Y := by
      exact Finset.mem_map.mpr ⟨x, x.2, rfl⟩
    have hxA : (x : W) ∈ A := by
      exact Finset.mem_map.mpr ⟨x, x.2, rfl⟩
    have hQ := Q.degree_induce_add_outsideDegree
      Y (some (x : S)) hxY
    have hG := G.degree_induce_add_outsideDegree A (x : W) hxA
    have hQreg : Q.IsRegularOfDegree 4 :=
      imbalancedSixClosure_isRegularOfDegree G hreg S E
    rw [hQreg (some (x : S))] at hQ
    rw [hreg (x : W)] at hG
    have hQpoint :
        (Q.induce Y).degree (eY x) =
          (Q.induce Y).degree ⟨some (x : S), hxY⟩ := by
      congr 1
    have hApoint :
        (G.induce A).degree (eA x) =
          (G.induce A).degree ⟨(x : W), hxA⟩ := by
      congr 1
    rw [← hQpoint, hinducedDegree x, hApoint] at hQ
    omega
  rw [boundaryMultiplicity_eq_sum_outsideDegree,
    boundaryMultiplicity_eq_sum_outsideDegree]
  change (∑ v ∈ Y, Q.outsideDegree Y v) =
    ∑ v ∈ A, G.outsideDegree A v
  calc
    (∑ v ∈ Y, Q.outsideDegree Y v) =
        ∑ v ∈ U, Q.outsideDegree Y (some v) := by
      exact Finset.sum_map U Function.Embedding.some _
    _ = ∑ v ∈ U, G.outsideDegree A v := by
      apply Finset.sum_congr rfl
      intro v hv
      exact houtside ⟨v, hv⟩
    _ = ∑ v ∈ A, G.outsideDegree A v := by
      symm
      exact Finset.sum_map U (Function.Embedding.subtype _) _

/-- The preceding boundary comparison only needs the paired artificial edge
to be non-internal.  This is the form used by the Hall-defect argument: its
failure says that both paired endpoints lie in the complementary block. -/
lemma boundaryMultiplicity_imbalancedSixClosure_map_some_of_pair_not_internal
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (U : Finset S)
    (hpair : ¬ (sixPairEndpoint E 0 ∈ U ∧ sixPairEndpoint E 5 ∈ U)) :
    (G.imbalancedSixClosure S E).boundaryMultiplicity
        (U.map Function.Embedding.some) =
      G.boundaryMultiplicity
        (U.map (Function.Embedding.subtype _)) := by
  classical
  let Q := G.imbalancedSixClosure S E
  let Y : Finset (Option S) := U.map Function.Embedding.some
  let A : Finset W := U.map (Function.Embedding.subtype _)
  let eY : U ≃ Y := finsetMapEquiv U Function.Embedding.some
  let eA : U ≃ A :=
    finsetMapEquiv U (Function.Embedding.subtype _)
  have hpairZero (x y : U) :
      (singleEdge (sixPairEndpoint E 0)
        (sixPairEndpoint E 5)).mult (x : S) (y : S) = 0 := by
    rw [singleEdge_mult, if_neg]
    intro hshape
    apply hpair
    rcases hshape with hshape | hshape
    · exact ⟨hshape.1 ▸ x.2, hshape.2 ▸ y.2⟩
    · exact ⟨hshape.2 ▸ y.2, hshape.1 ▸ x.2⟩
  have hgraphs :
      (Q.induce Y).relabel eY.symm =
        (G.induce A).relabel eA.symm := by
    apply Pseudograph.ext
    intro x y
    simp only [relabel_mult, Equiv.symm_symm,
      Equiv.apply_symm_apply, induce_mult]
    change Q.mult (some (x : S)) (some (y : S)) =
      G.mult (x : W) (y : W)
    change (G.induce S + singleEdge (sixPairEndpoint E 0)
      (sixPairEndpoint E 5)).mult (x : S) (y : S) = _
    rw [add_mult, hpairZero x y]
    simp [induce_mult]
  have hinducedDegree (x : U) :
      (Q.induce Y).degree (eY x) =
        (G.induce A).degree (eA x) := by
    calc
      (Q.induce Y).degree (eY x) =
          ((Q.induce Y).relabel eY.symm).degree x := by
            symm
            simpa using (Q.induce Y).degree_relabel eY.symm (eY x)
      _ = ((G.induce A).relabel eA.symm).degree x := by rw [hgraphs]
      _ = (G.induce A).degree (eA x) := by
            simpa using (G.induce A).degree_relabel eA.symm (eA x)
  have houtside (x : U) :
      Q.outsideDegree Y (some (x : S)) =
        G.outsideDegree A (x : W) := by
    have hxY : some (x : S) ∈ Y := by
      exact Finset.mem_map.mpr ⟨x, x.2, rfl⟩
    have hxA : (x : W) ∈ A := by
      exact Finset.mem_map.mpr ⟨x, x.2, rfl⟩
    have hQ := Q.degree_induce_add_outsideDegree
      Y (some (x : S)) hxY
    have hG := G.degree_induce_add_outsideDegree A (x : W) hxA
    have hQreg : Q.IsRegularOfDegree 4 :=
      imbalancedSixClosure_isRegularOfDegree G hreg S E
    rw [hQreg (some (x : S))] at hQ
    rw [hreg (x : W)] at hG
    have hQpoint :
        (Q.induce Y).degree (eY x) =
          (Q.induce Y).degree ⟨some (x : S), hxY⟩ := by
      congr 1
    have hApoint :
        (G.induce A).degree (eA x) =
          (G.induce A).degree ⟨(x : W), hxA⟩ := by
      congr 1
    rw [← hQpoint, hinducedDegree x, hApoint] at hQ
    omega
  rw [boundaryMultiplicity_eq_sum_outsideDegree,
    boundaryMultiplicity_eq_sum_outsideDegree]
  change (∑ v ∈ Y, Q.outsideDegree Y v) =
    ∑ v ∈ A, G.outsideDegree A v
  calc
    (∑ v ∈ Y, Q.outsideDegree Y v) =
        ∑ v ∈ U, Q.outsideDegree Y (some v) := by
      exact Finset.sum_map U Function.Embedding.some _
    _ = ∑ v ∈ U, G.outsideDegree A v := by
      apply Finset.sum_congr rfl
      intro v hv
      exact houtside ⟨v, hv⟩
    _ = ∑ v ∈ A, G.outsideDegree A v := by
      symm
      exact Finset.sum_map U (Function.Embedding.subtype _) _

/-- If both paired endpoints are internal to a set of old shore vertices,
the artificial paired edge lowers the hybrid boundary by exactly two. -/
lemma boundaryMultiplicity_imbalancedSixClosure_map_some_add_two
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (U : Finset S)
    (hzero : sixPairEndpoint E 0 ∈ U)
    (hfive : sixPairEndpoint E 5 ∈ U) :
    (G.imbalancedSixClosure S E).boundaryMultiplicity
        (U.map Function.Embedding.some) + 2 =
      G.boundaryMultiplicity
        (U.map (Function.Embedding.subtype _)) := by
  classical
  letI : DecidableEq U := Classical.decEq _
  let Q := G.imbalancedSixClosure S E
  let Y : Finset (Option S) := U.map Function.Embedding.some
  let A : Finset W := U.map (Function.Embedding.subtype _)
  let eY : U ≃ Y := finsetMapEquiv U Function.Embedding.some
  let eA : U ≃ A :=
    finsetMapEquiv U (Function.Embedding.subtype _)
  let z : U := ⟨sixPairEndpoint E 0, hzero⟩
  let p : U := ⟨sixPairEndpoint E 5, hfive⟩
  have hzp : z ≠ p := by
    intro h
    apply (show (0 : Fin 6) ≠ 5 by decide)
    apply hinj
    exact congrArg Subtype.val h
  have hgraphs :
      (Q.induce Y).relabel eY.symm =
        (G.induce A).relabel eA.symm + singleEdge z p := by
    apply Pseudograph.ext
    intro x y
    simp only [relabel_mult, Equiv.symm_symm,
      Equiv.apply_symm_apply, induce_mult, add_mult]
    change Q.mult (some (x : S)) (some (y : S)) =
      G.mult (x : W) (y : W) + (singleEdge z p).mult x y
    change (G.induce S + singleEdge (sixPairEndpoint E 0)
      (sixPairEndpoint E 5)).mult (x : S) (y : S) = _
    simp only [add_mult, induce_mult]
    have hxz : ((x : U) : S) = sixPairEndpoint E 0 ↔ x = z := by
      constructor
      · intro h
        apply Subtype.ext
        exact h
      · intro h
        simpa [z] using congrArg Subtype.val h
    have hxp : ((x : U) : S) = sixPairEndpoint E 5 ↔ x = p := by
      constructor
      · intro h
        apply Subtype.ext
        exact h
      · intro h
        simpa [p] using congrArg Subtype.val h
    have hyz : ((y : U) : S) = sixPairEndpoint E 0 ↔ y = z := by
      constructor
      · intro h
        apply Subtype.ext
        exact h
      · intro h
        simpa [z] using congrArg Subtype.val h
    have hyp : ((y : U) : S) = sixPairEndpoint E 5 ↔ y = p := by
      constructor
      · intro h
        apply Subtype.ext
        exact h
      · intro h
        simpa [p] using congrArg Subtype.val h
    simp only [singleEdge_mult, hxz, hxp, hyz, hyp]
  have hinducedDegree (x : U) :
      (Q.induce Y).degree (eY x) =
        (G.induce A).degree (eA x) + (singleEdge z p).degree x := by
    calc
      (Q.induce Y).degree (eY x) =
          ((Q.induce Y).relabel eY.symm).degree x := by
            symm
            simpa using (Q.induce Y).degree_relabel eY.symm (eY x)
      _ = (((G.induce A).relabel eA.symm) +
            singleEdge z p).degree x := by rw [hgraphs]
      _ = ((G.induce A).relabel eA.symm).degree x +
            (singleEdge z p).degree x := degree_add _ _ _
      _ = (G.induce A).degree (eA x) +
            (singleEdge z p).degree x := by
          rw [show ((G.induce A).relabel eA.symm).degree x =
              (G.induce A).degree (eA x) by
            simpa using (G.induce A).degree_relabel eA.symm (eA x)]
  have houtside (x : U) :
      Q.outsideDegree Y (some (x : S)) +
          (singleEdge z p).degree x =
        G.outsideDegree A (x : W) := by
    have hxY : some (x : S) ∈ Y :=
      Finset.mem_map.mpr ⟨x, x.2, rfl⟩
    have hxA : (x : W) ∈ A :=
      Finset.mem_map.mpr ⟨x, x.2, rfl⟩
    have hQ := Q.degree_induce_add_outsideDegree
      Y (some (x : S)) hxY
    have hG := G.degree_induce_add_outsideDegree A (x : W) hxA
    have hQreg : Q.IsRegularOfDegree 4 :=
      imbalancedSixClosure_isRegularOfDegree G hreg S E
    rw [hQreg (some (x : S))] at hQ
    rw [hreg (x : W)] at hG
    have hQpoint :
        (Q.induce Y).degree (eY x) =
          (Q.induce Y).degree ⟨some (x : S), hxY⟩ := by
      congr 1
    have hApoint :
        (G.induce A).degree (eA x) =
          (G.induce A).degree ⟨(x : W), hxA⟩ := by
      congr 1
    rw [← hQpoint, hinducedDegree x, hApoint] at hQ
    omega
  have hpairDegree : ∑ x : U, (singleEdge z p).degree x = 2 := by
    simp_rw [degree_singleEdge]
    rw [Finset.sum_add_distrib]
    have hzsum : (∑ x : U, if x = z then 1 else 0) = 1 := by
      simpa using (Fintype.sum_ite_eq' z (fun _ : U ↦ (1 : ℕ)))
    have hpsum : (∑ x : U, if x = p then 1 else 0) = 1 := by
      simpa using (Fintype.sum_ite_eq' p (fun _ : U ↦ (1 : ℕ)))
    rw [hzsum, hpsum]
  rw [boundaryMultiplicity_eq_sum_outsideDegree,
    boundaryMultiplicity_eq_sum_outsideDegree]
  change (∑ v ∈ Y, Q.outsideDegree Y v) + 2 =
    ∑ v ∈ A, G.outsideDegree A v
  calc
    (∑ v ∈ Y, Q.outsideDegree Y v) + 2 =
        (∑ x : U, Q.outsideDegree Y (some (x : S))) +
          ∑ x : U, (singleEdge z p).degree x := by
      rw [hpairDegree]
      congr 1
      calc
        (∑ v ∈ Y, Q.outsideDegree Y v) =
            ∑ v ∈ U, Q.outsideDegree Y (some v) :=
          Finset.sum_map U Function.Embedding.some _
        _ = ∑ x : U, Q.outsideDegree Y (some (x : S)) :=
          (Finset.sum_coe_sort U _).symm
    _ = ∑ x : U, (Q.outsideDegree Y (some (x : S)) +
          (singleEdge z p).degree x) := by
      rw [Finset.sum_add_distrib]
    _ = ∑ x : U, G.outsideDegree A (x : W) := by
      apply Finset.sum_congr rfl
      intro x _hx
      exact houtside x
    _ = ∑ v ∈ U, G.outsideDegree A (v : W) :=
      by
        simpa only using
          (Finset.sum_coe_sort U (fun v : S ↦ G.outsideDegree A (v : W)))
    _ = ∑ v ∈ A, G.outsideDegree A v := by
      symm
      exact Finset.sum_map U (Function.Embedding.subtype _) _

/-- Symmetric submodularity of finite pseudograph cuts, in the diagonal
form used for intersecting two Hall partitions. -/
lemma boundaryMultiplicity_inter_add_compl_inter_compl_le
    (P : Pseudograph W) (X Y : Finset W) :
    P.boundaryMultiplicity (X ∩ Y) +
        P.boundaryMultiplicity (Xᶜ ∩ Yᶜ) ≤
      P.boundaryMultiplicity X + P.boundaryMultiplicity Y := by
  classical
  unfold boundaryMultiplicity
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro e _he
  induction e using Sym2.inductionOn with
  | _ a b =>
      by_cases haX : a ∈ X <;> by_cases hbX : b ∈ X <;>
        by_cases haY : a ∈ Y <;> by_cases hbY : b ∈ Y <;>
          simp [crossingIndicator_mk, haX, hbX, haY, hbY] <;> omega

/-- The exact form of symmetric cut submodularity.  The slack is twice the
number of edges between the two omitted diagonal blocks. -/
lemma boundaryMultiplicity_inter_add_compl_inter_compl_add_two_between
    (P : Pseudograph W) (X Y : Finset W) :
    P.boundaryMultiplicity (X ∩ Y) +
        P.boundaryMultiplicity (Xᶜ ∩ Yᶜ) +
        2 * P.betweenMultiplicity (Xᶜ ∩ Y) (X ∩ Yᶜ) =
      P.boundaryMultiplicity X + P.boundaryMultiplicity Y := by
  classical
  unfold boundaryMultiplicity betweenMultiplicity
  rw [Finset.mul_sum, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _he
  induction e using Sym2.inductionOn with
  | _ a b =>
      by_cases haX : a ∈ X <;> by_cases hbX : b ∈ X <;>
        by_cases haY : a ∈ Y <;> by_cases hbY : b ∈ Y <;>
          simp [crossingIndicator_mk, betweenIndicator_mk,
            haX, hbX, haY, hbY] <;> omega

/-! The bipartition of the hybrid closure puts the new center beside the
small colour class.  These explicit finite sides let the prescribed-edge
Hall lemma be used without coercion bookkeeping at every call. -/

noncomputable def optionLeftSide {X : Type*} [Fintype X] (A : Finset X) :
    Finset (Option X) :=
  insert none (A.map Function.Embedding.some)

noncomputable def optionRightSide {X : Type*} [Fintype X] (B : Finset X) :
    Finset (Option X) :=
  B.map Function.Embedding.some

@[simp] lemma mem_optionLeftSide_none
    {X : Type*} [Fintype X] (A : Finset X) :
    none ∈ optionLeftSide A := by
  simp [optionLeftSide]

@[simp] lemma mem_optionLeftSide_some
    {X : Type*} [Fintype X] (A : Finset X) (x : X) :
    some x ∈ optionLeftSide A ↔ x ∈ A := by
  simp [optionLeftSide]

@[simp] lemma mem_optionRightSide_some
    {X : Type*} [Fintype X] (B : Finset X) (x : X) :
    some x ∈ optionRightSide B ↔ x ∈ B := by
  simp [optionRightSide]

@[simp] lemma not_mem_optionRightSide_none
    {X : Type*} [Fintype X] (B : Finset X) :
    none ∉ optionRightSide B := by
  simp [optionRightSide]

lemma card_optionLeftSide
    {X : Type*} [Fintype X] (A : Finset X) :
    (optionLeftSide A).card = A.card + 1 := by
  classical
  simp [optionLeftSide, Finset.card_map]

lemma card_optionRightSide
    {X : Type*} [Fintype X] (B : Finset X) :
    (optionRightSide B).card = B.card := by
  classical
  simp [optionRightSide, Finset.card_map]

/-- The `1,5` endpoint distribution makes the hybrid closure bipartite:
the center joins the small side, the pair edge joins label `0` to label
`5`, and all four star edges run to the large side. -/
lemma imbalancedSixClosure_isBipartiteWith
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B) :
    (G.imbalancedSixClosure S E).IsBipartiteWith
      (optionLeftSide A) (optionRightSide B) := by
  classical
  let Q := G.imbalancedSixClosure S E
  constructor
  · rw [Finset.disjoint_left]
    intro x hxL hxR
    cases x with
    | none => simpa using hxR
    | some x =>
        have hxA : x ∈ A := by simpa using hxL
        have hxB : x ∈ B := by simpa using hxR
        exact (Finset.disjoint_left.mp hbip.disjoint) hxA hxB
  · ext x
    cases x with
    | none => simp
    | some x =>
        have hx : x ∈ A ∨ x ∈ B := by
          by_cases hxA : x ∈ A
          · exact .inl hxA
          · exact .inr (hbip.mem_right_of_not_mem_left hxA)
        simp only [Finset.mem_union, mem_optionLeftSide_some,
          mem_optionRightSide_some, Finset.mem_univ, iff_true]
        exact hx
  · intro u v huv
    cases u with
    | none =>
        cases v with
        | none =>
            change 0 < 0 at huv
            omega
        | some v =>
            have hvstar : 0 < fourEndpointCount
                (fun i ↦ sixPairEndpoint E (finFourMiddleLabel i)) v := by
              simpa only [Q, imbalancedSixClosure,
                fourStarClosure_mult_none_some] using huv
            obtain ⟨i, hi⟩ := (fourEndpointCount_pos_iff _ _).mp hvstar
            have hvB : v ∈ B := by
              fin_cases i <;> simp_all
            exact .inl ⟨by simp, by simpa using hvB⟩
    | some u =>
        cases v with
        | none =>
            have hustar : 0 < fourEndpointCount
                (fun i ↦ sixPairEndpoint E (finFourMiddleLabel i)) u := by
              simpa only [Q, imbalancedSixClosure,
                fourStarClosure_mult_some_none] using huv
            obtain ⟨i, hi⟩ := (fourEndpointCount_pos_iff _ _).mp hustar
            have huB : u ∈ B := by
              fin_cases i <;> simp_all
            exact .inr ⟨by simpa using huB, by simp⟩
        | some v =>
            have hsum : 0 <
                (G.induce S).mult u v +
                  (singleEdge (sixPairEndpoint E 0)
                    (sixPairEndpoint E 5)).mult u v := by
              simpa only [Q, imbalancedSixClosure,
                fourStarClosure_mult_some_some, add_mult] using huv
            rcases (show 0 < (G.induce S).mult u v ∨
                0 < (singleEdge (sixPairEndpoint E 0)
                  (sixPairEndpoint E 5)).mult u v by omega) with hbase | hpair
            · rcases hbip.crosses hbase with h | h
              · exact .inl ⟨by simpa using h.1, by simpa using h.2⟩
              · exact .inr ⟨by simpa using h.1, by simpa using h.2⟩
            · rw [singleEdge_mult] at hpair
              split at hpair
              · rename_i hshape
                rcases hshape with hshape | hshape
                · exact .inl ⟨by simpa [hshape.1] using h₀,
                    by simpa [hshape.2] using h₅⟩
                · exact .inr ⟨by simpa [hshape.1] using h₅,
                    by simpa [hshape.2] using h₀⟩
              · omega

/-- A four-boundary Hall set in the hybrid closure, containing two distinct
old vertices but neither the center nor label `0`, pulls back to a
nontrivial four-cut of the original graph. -/
lemma false_of_imbalancedSixClosure_hallFour
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      G.boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    {b d : S} (hbd : b ≠ d)
    (Y : Finset (Option S))
    (hcut : (G.imbalancedSixClosure S E).boundaryMultiplicity Y = 4)
    (hb : some b ∈ Y) (hd : some d ∈ Y)
    (hnone : none ∉ Y)
    (hzero : some (sixPairEndpoint E 0) ∉ Y) : False := by
  classical
  let U : Finset S := Finset.univ.filter fun x ↦ some x ∈ Y
  let A : Finset W := U.map (Function.Embedding.subtype _)
  have hY : Y = U.map Function.Embedding.some := by
    ext z
    cases z with
    | none => simp [hnone]
    | some z => simp [U]
  have hbU : b ∈ U := by simp [U, hb]
  have hdU : d ∈ U := by simp [U, hd]
  have hUtwo : 2 ≤ U.card := by
    have hsub : ({b, d} : Finset S) ⊆ U := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact hbU
      · exact hdU
    have hc := Finset.card_le_card hsub
    simpa [hbd] using hc
  have hzeroU : sixPairEndpoint E 0 ∉ U := by
    intro hz
    exact hzero (Finset.mem_filter.mp hz).2
  have hboundary : G.boundaryMultiplicity A = 4 := by
    have htransfer := boundaryMultiplicity_imbalancedSixClosure_map_some
      G hreg S E U hzeroU
    rw [hY] at hcut
    change G.boundaryMultiplicity A = 4
    rw [← htransfer]
    exact hcut
  have hbA : (b : W) ∈ A := by
    exact Finset.mem_map.mpr ⟨b, hbU, rfl⟩
  have hAnonempty : A.Nonempty := ⟨b, hbA⟩
  have houtNotA : (E 0).outside ∉ A := by
    intro hout
    obtain ⟨x, hxU, hx⟩ := Finset.mem_map.mp hout
    have hxS : (x : W) ∈ S := x.2
    exact (E 0).outside_notMem (hx.symm ▸ hxS)
  have hAproper : A ≠ Finset.univ := by
    intro hA
    exact houtNotA (by rw [hA]; simp)
  have hinsideNotA : (E 0).inside ∉ A := by
    intro hin
    obtain ⟨x, hxU, hx⟩ := Finset.mem_map.mp hin
    have hxeq : x = sixPairEndpoint E 0 := by
      apply Subtype.ext
      simpa [sixPairEndpoint] using hx
    exact hzeroU (hxeq ▸ hxU)
  have hinsideOutside : (E 0).inside ≠ (E 0).outside := by
    intro heq
    exact (E 0).outside_notMem (heq ▸ (E 0).inside_mem)
  have hCtwo : 2 ≤ Aᶜ.card := by
    have hsub : ({(E 0).inside, (E 0).outside} : Finset W) ⊆ Aᶜ := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact Finset.mem_compl.mpr hinsideNotA
      · exact Finset.mem_compl.mpr houtNotA
    have hc := Finset.card_le_card hsub
    simpa [hinsideOutside] using hc
  have hAtwo : 2 ≤ A.card := by
    simpa [A, Finset.card_map] using hUtwo
  rcases hno4 A hAnonempty hAproper hboundary with hAone | hCone
  · omega
  · omega

/-- An injective six-cut listing records exactly one incidence at each of
its six shore endpoints. -/
lemma listingEndpointCount_eq_one_of_sixPairEndpoint_injective
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 6) :
    G.listingEndpointCount S E (sixPairEndpoint E i) = 1 := by
  classical
  rw [listingEndpointCount, Finset.sum_eq_single i]
  · simp [sixPairEndpoint]
  · intro j _hj hji
    have hne : (E j).inside ≠
        ((sixPairEndpoint E i : S) : W) := by
      intro heq
      apply hji
      apply hinj
      apply Subtype.ext
      simpa [sixPairEndpoint] using heq
    simp [hne]
  · simp

/-- A simple graph vertex of degree three has a neighbour outside any two
prescribed vertices. -/
lemma exists_neighbor_ne_two_of_degree_three
    {X : Type*} [Fintype X] (G : SimpleGraph X)
    {a p q : X} (hdegree : G.degree a = 3) :
    ∃ d : X, G.Adj a d ∧ d ≠ p ∧ d ≠ q := by
  classical
  by_contra hnone
  have hsub : G.neighborFinset a ⊆ ({p, q} : Finset X) := by
    intro d hd
    have hadj : G.Adj a d := by
      simpa only [SimpleGraph.mem_neighborFinset] using hd
    have hcases : d = p ∨ d = q := by
      by_contra hcases
      apply hnone
      exact ⟨d, hadj, fun h ↦ hcases (.inl h),
        fun h ↦ hcases (.inr h)⟩
    rcases hcases with hdp | hdq
    · simp [hdp]
    · simp [hdq]
  have hcard := Finset.card_le_card hsub
  rw [SimpleGraph.card_neighborFinset_eq_degree, hdegree] at hcard
  have hpq : ({p, q} : Finset X).card ≤ 2 := Finset.card_insert_le p {q}
  omega

/-- At an injectively listed boundary endpoint of a simple quartic graph,
the induced shore graph has degree three. -/
lemma degree_induce_eq_three_of_sixPairEndpoint_injective
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 6) :
    (G.induce S).toSimple.degree (sixPairEndpoint E i) = 3 := by
  have hout : G.outsideDegree S (sixPairEndpoint E i) = 1 := by
    rw [G.outsideDegree_eq_listingEndpointCount S E _
      (sixPairEndpoint E i).2]
    exact listingEndpointCount_eq_one_of_sixPairEndpoint_injective
      G S E hinj i
  have hledger := G.degree_induce_add_outsideDegree S
    (sixPairEndpoint E i) (sixPairEndpoint E i).2
  rw [hreg (sixPairEndpoint E i), hout] at hledger
  have hledger' :
      (G.induce S).degree (sixPairEndpoint E i) + 1 = 4 := by
    simpa using hledger
  have hinduce : (G.induce S).degree (sixPairEndpoint E i) = 3 := by
    omega
  rw [degree_toSimple (G.induce S)
    (fun v ↦ hsimple.1 (v : W))
    (fun u v ↦ hsimple.2 (u : W) (v : W))]
  exact hinduce

lemma imbalancedSixClosure_adj_star
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 4) :
    (G.imbalancedSixClosure S E).toSimple.Adj none
      (some (sixPairEndpoint E (finFourMiddleLabel i))) := by
  constructor
  · simp
  · change 0 < fourEndpointCount
      (fun j ↦ sixPairEndpoint E (finFourMiddleLabel j))
      (sixPairEndpoint E (finFourMiddleLabel i))
    exact (fourEndpointCount_pos_iff _ _).2 ⟨i, rfl⟩

lemma imbalancedSixClosure_adj_pair
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (hne : sixPairEndpoint E 0 ≠ sixPairEndpoint E 5) :
    (G.imbalancedSixClosure S E).toSimple.Adj
      (some (sixPairEndpoint E 0)) (some (sixPairEndpoint E 5)) := by
  constructor
  · simpa using hne
  · change 0 < (G.induce S + singleEdge
      (sixPairEndpoint E 0) (sixPairEndpoint E 5)).mult
        (sixPairEndpoint E 0) (sixPairEndpoint E 5)
    rw [add_mult]
    have hp : 0 < (singleEdge (sixPairEndpoint E 0)
        (sixPairEndpoint E 5)).mult
          (sixPairEndpoint E 0) (sixPairEndpoint E 5) := by
      simp [singleEdge_mult]
    omega

lemma imbalancedSixClosure_adj_of_induce_adj
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) {u v : S}
    (h : (G.induce S).toSimple.Adj u v) :
    (G.imbalancedSixClosure S E).toSimple.Adj (some u) (some v) := by
  constructor
  · simpa using h.1
  · change 0 < (G.induce S + singleEdge
      (sixPairEndpoint E 0) (sixPairEndpoint E 5)).mult u v
    rw [add_mult]
    have hpos := h.2
    omega

/-- In the center-active branch, the bipartite shore supplies perfect
matchings realizing both possible states of the paired artificial edge.
One matching contains the pair; the other matches label `0` to a fresh
ordinary neighbour and therefore avoids the pair. -/
lemma exists_centerActive_imbalancedPerfectMatchings
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      G.boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 4) :
    ∃ Mpair Mavoid : (G.imbalancedSixClosure S E).toSimple.Subgraph,
      Mpair.IsPerfectMatching ∧
      Mpair.Adj none
        (some (sixPairEndpoint E (finFourMiddleLabel i))) ∧
      Mpair.Adj (some (sixPairEndpoint E 0))
        (some (sixPairEndpoint E 5)) ∧
      Mavoid.IsPerfectMatching ∧
      Mavoid.Adj none
        (some (sixPairEndpoint E (finFourMiddleLabel i))) ∧
      ¬ Mavoid.Adj (some (sixPairEndpoint E 0))
        (some (sixPairEndpoint E 5)) := by
  classical
  let Q := G.imbalancedSixClosure S E
  let L := optionLeftSide A
  let R := optionRightSide B
  let z := sixPairEndpoint E 0
  let p := sixPairEndpoint E 5
  let s := sixPairEndpoint E (finFourMiddleLabel i)
  have hne (j k : Fin 6) (hjk : j ≠ k) :
      sixPairEndpoint E j ≠ sixPairEndpoint E k := fun h ↦ hjk (hinj h)
  have hQreg : Q.IsRegularOfDegree 4 :=
    imbalancedSixClosure_isRegularOfDegree G hreg S E
  have hQbip : Q.IsBipartiteWith L R :=
    imbalancedSixClosure_isBipartiteWith G S E A B hbip
      h₀ h₁ h₂ h₃ h₄ h₅
  have hLRcard : L.card = R.card := by
    rw [card_optionLeftSide, card_optionRightSide]
    exact hcard
  have hzL : some z ∈ L := by simpa [L, z] using h₀
  have hpR : some p ∈ R := by simpa [R, p] using h₅
  have hsR : some s ∈ R := by
    fin_cases i <;> simp_all [R, s]
  have hcenterL : none ∈ L := by simp [L]
  have hsp : s ≠ p := by
    apply hne (finFourMiddleLabel i) 5
    exact finFourMiddleLabel_ne_five i
  have hstar : Q.toSimple.Adj none (some s) := by
    simpa [Q, s] using imbalancedSixClosure_adj_star G S E i
  have hpair : Q.toSimple.Adj (some z) (some p) := by
    apply imbalancedSixClosure_adj_pair
    exact hne 0 5 (by decide)
  have hforbidPair : ∀ Y : Finset (Option S),
      Q.boundaryMultiplicity Y = 4 →
      some s ∈ Y → some p ∈ Y → none ∉ Y → some z ∉ Y →
      False := by
    intro Y hcut hsY hpY hnY hzY
    exact false_of_imbalancedSixClosure_hallFour G hreg hno4 S E
      hsp Y hcut hsY hpY hnY hzY
  obtain ⟨Mpair, hMpair, hMpairStar, hMpairPair⟩ :=
    exists_perfectMatching_containing_two_edges_of_forbidHallFour
      Q hQreg L R hQbip hLRcard
      hcenterL hsR hzL hpR (by simp) (by simpa using hsp)
      hstar hpair hforbidPair
  have hzDegree : (G.induce S).toSimple.degree z = 3 := by
    simpa [z] using
      degree_induce_eq_three_of_sixPairEndpoint_injective
        G hreg hsimple S E hinj 0
  obtain ⟨d, hzd, hdp, hds⟩ :=
    exists_neighbor_ne_two_of_degree_three
      (G.induce S).toSimple (a := z) (p := p) (q := s) hzDegree
  have hdR : some d ∈ R := by
    have hdB : d ∈ B := by
      have hzA : z ∈ A := h₀
      rcases hbip.crosses hzd.2 with h | h
      · exact h.2
      · exact False.elim
          ((Finset.disjoint_left.mp hbip.disjoint) hzA h.1)
    simpa [R] using hdB
  have hzdQ : Q.toSimple.Adj (some z) (some d) := by
    exact imbalancedSixClosure_adj_of_induce_adj G S E hzd
  have hsd : s ≠ d := hds.symm
  have hforbidAvoid : ∀ Y : Finset (Option S),
      Q.boundaryMultiplicity Y = 4 →
      some s ∈ Y → some d ∈ Y → none ∉ Y → some z ∉ Y →
      False := by
    intro Y hcut hsY hdY hnY hzY
    exact false_of_imbalancedSixClosure_hallFour G hreg hno4 S E
      hsd Y hcut hsY hdY hnY hzY
  obtain ⟨Mavoid, hMavoid, hMavoidStar, hMavoidFresh⟩ :=
    exists_perfectMatching_containing_two_edges_of_forbidHallFour
      Q hQreg L R hQbip hLRcard
      hcenterL hsR hzL hdR (by simp) (by simpa using hsd)
      hstar hzdQ hforbidAvoid
  have hMavoidPair : ¬ Mavoid.Adj (some z) (some p) := by
    intro hbad
    have heq := hMavoid.1.eq_of_adj_left hMavoidFresh hbad
    exact hdp (Option.some.inj heq)
  exact ⟨Mpair, Mavoid, hMpair, hMpairStar, hMpairPair,
    hMavoid, hMavoidStar, hMavoidPair⟩

def FourStarOmitsExactly
    {X : Type*} [Fintype X] (f : Fin 4 → X)
    (H : Pseudograph (Option X)) (i : Fin 4) : Prop :=
  ∀ v : X, H.mult none (some v) =
    fourEndpointCount f v - if f i = v then 1 else 0

lemma exists_fourStarOmitsExactly_of_center_degree_three
    {X : Type*} [Fintype X] {B : Pseudograph X}
    {f : Fin 4 → X} {H : Pseudograph (Option X)}
    (hH : H.IsPart (fourStarClosure B f))
    (hcenter : H.degree none = 3) :
    ∃ i : Fin 4, FourStarOmitsExactly f H i := by
  classical
  have hloop : H.mult none none = 0 := by
    have h := hH none none
    simpa using h
  have hsumH : (∑ v : X, H.mult none (some v)) = 3 := by
    simpa [degree_eq_mult_self_add_sum, Fintype.sum_option, hloop]
      using hcenter
  have hsumC : (∑ v : X, fourEndpointCount f v) = 4 :=
    sum_fourEndpointCount f
  have hle (v : X) :
      H.mult none (some v) ≤ fourEndpointCount f v :=
    hH none (some v)
  obtain ⟨v, hvlt⟩ : ∃ v : X,
      H.mult none (some v) < fourEndpointCount f v := by
    by_contra h
    push_neg at h
    have heq : ∀ v : X,
        H.mult none (some v) = fourEndpointCount f v := by
      intro v
      exact Nat.le_antisymm (hle v) (h v)
    have hsumeq : (∑ v : X, H.mult none (some v)) =
        ∑ v : X, fourEndpointCount f v := by
      apply Finset.sum_congr rfl
      intro v _
      exact heq v
    omega
  have hcountpos : 0 < fourEndpointCount f v :=
    lt_of_le_of_lt (Nat.zero_le _) hvlt
  obtain ⟨i, hi⟩ := (fourEndpointCount_pos_iff f v).mp hcountpos
  have hsumOne : (∑ x : X, fourEndpointCount f x) =
      (∑ x : X, H.mult none (some x)) + 1 := by omega
  have hshape := functions_eq_sub_indicator_of_sum_eq_add_one
    (fun x : X ↦ H.mult none (some x))
    (fourEndpointCount f) hle hsumOne hvlt
  refine ⟨i, fun x ↦ ?_⟩
  have hx := hshape x
  by_cases hvx : v = x
  · have hix : f i = x := hi.trans hvx
    rw [if_pos hix]
    simpa [hvx] using hx
  · have hix : f i ≠ x := by
      intro hix
      exact hvx (hi.symm.trans hix)
    rw [if_neg hix]
    simpa [hvx] using hx

lemma fourStarCenter_edges_zero_of_degree_zero
    {X : Type*} [Fintype X] {H : Pseudograph (Option X)}
    (hcenter : H.degree none = 0) (v : X) :
    H.mult none (some v) = 0 := by
  have hle := mult_le_degree_of_ne H
    (show (none : Option X) ≠ some v by simp)
  rw [hcenter] at hle
  omega

noncomputable def hybridStarDegree
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (active : Option (Fin 4))
    (v : S) : ℕ :=
  match active with
  | none => 0
  | some i =>
      fourEndpointCount
          (fun j ↦ sixPairEndpoint E (finFourMiddleLabel j)) v -
        if sixPairEndpoint E (finFourMiddleLabel i) = v then 1 else 0

noncomputable def hybridClosingDegree
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (active : Option (Fin 4)) (usePair : Bool) (v : S) : ℕ :=
  (if usePair then
      (singleEdge (sixPairEndpoint E 0)
        (sixPairEndpoint E 5)).degree v
    else 0) + hybridStarDegree E active v

def HybridClosureDecomposition
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (H : Pseudograph (Option S))
    (active : Option (Fin 4)) (usePair : Bool)
    (F : Pseudograph S) : Prop :=
  F.IsPart (G.induce S) ∧
    (∀ v : S, F.degree v + hybridClosingDegree E active usePair v =
      H.degree (some v)) ∧
    (H.degree none = match active with
      | none => 0
      | some _ => 3) ∧
    ∀ v : S, H.mult none (some v) = hybridStarDegree E active v

/-- Every cubic-or-isolated part of a hybrid closure has a labelled
decomposition.  The option is `none` when the center is isolated and is the
unique omitted star label when the center has degree three. -/
lemma exists_hybridClosureDecomposition
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (H : Pseudograph (Option S))
    (hH : H.IsPart (G.imbalancedSixClosure S E))
    (hcenter : H.degree none = 0 ∨ H.degree none = 3) :
    ∃ active : Option (Fin 4), ∃ usePair : Bool, ∃ F : Pseudograph S,
      HybridClosureDecomposition E H active usePair F := by
  classical
  let B := G.induce S + singleEdge
    (sixPairEndpoint E 0) (sixPairEndpoint E 5)
  have hdrop : H.dropStarCenter.IsPart B := by
    intro u v
    exact hH (some u) (some v)
  obtain ⟨usePair, F, hF, hpairDegree⟩ :=
    exists_singleEdgeDecomposition (G.induce S) H.dropStarCenter
      (sixPairEndpoint E 0) (sixPairEndpoint E 5) (by
        simpa [B] using hdrop)
  rcases hcenter with hzero | hthree
  · refine ⟨none, usePair, F, hF, ?_, hzero, ?_⟩
    intro v
    have hdropDegree := degree_dropStarCenter_add H v
    have hstarZero : H.mult (some v) none = 0 := by
      rw [H.mult_comm]
      exact fourStarCenter_edges_zero_of_degree_zero hzero v
    rw [hstarZero, Nat.add_zero] at hdropDegree
    have hp := hpairDegree v
    simp only [hybridClosingDegree, hybridStarDegree, Nat.add_zero]
    omega
    intro v
    simp only [hybridStarDegree]
    exact fourStarCenter_edges_zero_of_degree_zero hzero v
  · obtain ⟨i, hi⟩ :=
      exists_fourStarOmitsExactly_of_center_degree_three hH hthree
    refine ⟨some i, usePair, F, hF, ?_, hthree, ?_⟩
    intro v
    have hdropDegree := degree_dropStarCenter_add H v
    have hstar : H.mult (some v) none =
        fourEndpointCount
            (fun j ↦ sixPairEndpoint E (finFourMiddleLabel j)) v -
          if sixPairEndpoint E (finFourMiddleLabel i) = v then 1 else 0 := by
      rw [H.mult_comm]
      by_cases h : sixPairEndpoint E (finFourMiddleLabel i) = v
      · simpa [h] using hi v
      · simpa [h] using hi v
    rw [hstar] at hdropDegree
    have hp := hpairDegree v
    simp only [hybridClosingDegree, hybridStarDegree]
    omega
    intro v
    rw [hybridStarDegree]
    by_cases h : sixPairEndpoint E (finFourMiddleLabel i) = v
    · simpa [h] using hi v
    · simpa [h] using hi v

noncomputable def hybridCrossingSelection
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (active : Option (Fin 4)) (usePair : Bool) : Pseudograph W :=
  match active, usePair with
  | none, false => (G.crossingPart S).sdiff (G.crossingPart S)
  | none, true => twoCrossingLabelPart (E 0) (E 5)
  | some i, true => crossingPartExcept E (finFourMiddleLabel i)
  | some i, false =>
      (crossingPartExcept E (finFourMiddleLabel i)).sdiff
        (twoCrossingLabelPart (E 0) (E 5))

lemma twoCrossingLabelPart_isPart_crossingPartExcept_of_inside_ne
    {G : Pseudograph W} {S : Finset W} {n : ℕ}
    (E : Fin n ≃ CrossingEdge G S) {i j k : Fin n}
    (hij : i ≠ j)
    (hki : (E k).inside ≠ (E i).inside)
    (hkj : (E k).inside ≠ (E j).inside) :
    (twoCrossingLabelPart (E i) (E j)).IsPart
      (crossingPartExcept E k) := by
  classical
  intro u v
  have hbase := twoCrossingLabelPart_isPart_crossingPart
    (E i) (E j) (fun h ↦ hij (E.injective h)) u v
  simp only [crossingPartExcept, removeSingleEdge_mult]
  by_cases hk : (u = (E k).inside ∧ v = (E k).outside) ∨
      (u = (E k).outside ∧ v = (E k).inside)
  · rw [if_pos hk]
    have hlabelZero (r : Fin n) (hkr : (E k).inside ≠ (E r).inside) :
        (crossingLabelPart (E r)).mult (E k).inside (E k).outside = 0 := by
      rw [crossingLabelPart, singleEdge_mult, if_neg]
      intro hshape
      rcases hshape with hshape | hshape
      · exact hkr hshape.1
      · apply (E r).outside_notMem
        rw [← hshape.1]
        exact (E k).inside_mem
    have hzero : (twoCrossingLabelPart (E i) (E j)).mult u v = 0 := by
      rcases hk with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · simp [twoCrossingLabelPart, hlabelZero i hki,
          hlabelZero j hkj]
      · rw [(twoCrossingLabelPart (E i) (E j)).mult_comm]
        simp [twoCrossingLabelPart, hlabelZero i hki,
          hlabelZero j hkj]
    rw [hzero]
    omega
  · rw [if_neg hk]
    exact hbase

lemma hybridCrossingSelection_isPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (active : Option (Fin 4)) (usePair : Bool) :
    (hybridCrossingSelection E active usePair).IsPart G := by
  cases active with
  | none =>
      cases usePair
      · exact ((G.crossingPart S).sdiff_isPart_left _).trans
          (G.crossingPart_isPart S)
      · exact (twoCrossingLabelPart_isPart_crossingPart
          (E 0) (E 5) (fun h ↦ by
            have := congrArg Fin.val (E.injective h)
            omega)).trans (G.crossingPart_isPart S)
  | some i =>
      cases usePair
      · exact ((crossingPartExcept E (finFourMiddleLabel i)).sdiff_isPart_left
          _).trans (crossingPartExcept_isPart E (finFourMiddleLabel i))
      · exact crossingPartExcept_isPart E (finFourMiddleLabel i)

lemma crossingPartExcept_isPart_crossingPart
    {G : Pseudograph W} {S : Finset W} {n : ℕ}
    (E : Fin n ≃ CrossingEdge G S) (i : Fin n) :
    (crossingPartExcept E i).IsPart (G.crossingPart S) := by
  intro u v
  simp only [crossingPartExcept, removeSingleEdge_mult]
  split <;> omega

lemma hybridCrossingSelection_isPart_crossingPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (active : Option (Fin 4)) (usePair : Bool) :
    (hybridCrossingSelection E active usePair).IsPart
      (G.crossingPart S) := by
  cases active with
  | none =>
      cases usePair
      · exact (G.crossingPart S).sdiff_isPart_left _
      · exact twoCrossingLabelPart_isPart_crossingPart
          (E 0) (E 5) (fun h ↦ by
            have := congrArg Fin.val (E.injective h)
            omega)
  | some i =>
      cases usePair
      · exact ((crossingPartExcept E
          (finFourMiddleLabel i)).sdiff_isPart_left _).trans
            (crossingPartExcept_isPart_crossingPart E
              (finFourMiddleLabel i))
      · exact crossingPartExcept_isPart_crossingPart E
          (finFourMiddleLabel i)

lemma pairPart_isPart_crossingPartExcept_middle
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 4) :
    (twoCrossingLabelPart (E 0) (E 5)).IsPart
      (crossingPartExcept E (finFourMiddleLabel i)) := by
  apply twoCrossingLabelPart_isPart_crossingPartExcept_of_inside_ne
  · decide
  · intro h
    exact finFourMiddleLabel_ne_zero i
      (hinj (Subtype.ext h))
  · intro h
    exact finFourMiddleLabel_ne_five i
      (hinj (Subtype.ext h))

lemma degree_hybridCrossingSelection_of_mem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (active : Option (Fin 4)) (usePair : Bool)
    (v : W) (hv : v ∈ S) :
    (hybridCrossingSelection E active usePair).degree v =
      hybridClosingDegree E active usePair ⟨v, hv⟩ := by
  classical
  have hout (j : Fin 6) : v ≠ (E j).outside := by
    intro h
    exact (E j).outside_notMem (h ▸ hv)
  have htotal : G.outsideDegree S v =
      (if v = (E 0).inside then 1 else 0) +
      (if v = (E 1).inside then 1 else 0) +
      (if v = (E 2).inside then 1 else 0) +
      (if v = (E 3).inside then 1 else 0) +
      (if v = (E 4).inside then 1 else 0) +
      (if v = (E 5).inside then 1 else 0) := by
    rw [G.outsideDegree_eq_listingEndpointCount S E v hv,
      listingEndpointCount, Fin.sum_univ_six]
    simp only [eq_comm]
  have hstarTotal :
      fourEndpointCount
          (fun j ↦ sixPairEndpoint E (finFourMiddleLabel j)) ⟨v, hv⟩ =
        (if v = (E 1).inside then 1 else 0) +
        (if v = (E 2).inside then 1 else 0) +
        (if v = (E 3).inside then 1 else 0) +
        (if v = (E 4).inside then 1 else 0) := by
    rw [fourEndpointCount, Fin.sum_univ_four]
    simp [sixPairEndpoint, finFourMiddleLabel_zero,
      finFourMiddleLabel_one, finFourMiddleLabel_two,
      finFourMiddleLabel_three, Subtype.ext_iff, eq_comm]
  have hpairTotal :
      (singleEdge (sixPairEndpoint E 0)
          (sixPairEndpoint E 5)).degree ⟨v, hv⟩ =
        (if v = (E 0).inside then 1 else 0) +
        (if v = (E 5).inside then 1 else 0) := by
    simp [degree_singleEdge, sixPairEndpoint, Subtype.ext_iff, eq_comm]
  have homit (i : Fin 4) :
      (if sixPairEndpoint E (finFourMiddleLabel i) = ⟨v, hv⟩
        then 1 else 0) =
      (if v = (E (finFourMiddleLabel i)).inside then 1 else 0) := by
    by_cases h : sixPairEndpoint E (finFourMiddleLabel i) = ⟨v, hv⟩
    · have h' : v = (E (finFourMiddleLabel i)).inside := by
        simpa [sixPairEndpoint, Subtype.ext_iff] using h.symm
      simp [h, h']
    · have h' : v ≠ (E (finFourMiddleLabel i)).inside := by
        intro h'
        apply h
        apply Subtype.ext
        simpa [sixPairEndpoint] using h'.symm
      simp [h, h']
  have homitLe (i : Fin 4) :
      (if sixPairEndpoint E (finFourMiddleLabel i) = ⟨v, hv⟩
        then 1 else 0) ≤
      fourEndpointCount
        (fun j ↦ sixPairEndpoint E (finFourMiddleLabel j)) ⟨v, hv⟩ := by
    by_cases h : sixPairEndpoint E (finFourMiddleLabel i) = ⟨v, hv⟩
    · rw [if_pos h]
      exact (fourEndpointCount_pos_iff _ _).2 ⟨i, h⟩
    · simp [h]
  cases active with
  | none =>
      cases usePair
      · have hdeg := (G.crossingPart S).degree_sdiff_add
            (G.crossingPart S) (IsPart.refl _) v
        simpa [hybridCrossingSelection, hybridClosingDegree,
          hybridStarDegree] using hdeg
      · rw [hybridCrossingSelection, hybridClosingDegree,
          hybridStarDegree, Nat.add_zero, hpairTotal,
          degree_twoCrossingLabelPart]
        simp [hout, eq_comm]
  | some i =>
      have hcross := degree_crossingPartExcept_add_of_mem
        E (finFourMiddleLabel i) v hv
      have hcross' :
          (crossingPartExcept E (finFourMiddleLabel i)).degree v +
              (if v = (E (finFourMiddleLabel i)).inside then 1 else 0) =
            G.outsideDegree S v := by
        simpa only [eq_comm] using hcross
      have hdecomp :
          (crossingPartExcept E (finFourMiddleLabel i)).degree v =
            (singleEdge (sixPairEndpoint E 0)
                (sixPairEndpoint E 5)).degree ⟨v, hv⟩ +
              hybridStarDegree E (some i) ⟨v, hv⟩ := by
        rw [hybridStarDegree, hpairTotal, hstarTotal, homit]
        have hle := homitLe i
        rw [hstarTotal, homit] at hle
        omega
      cases usePair
      · have hpart := pairPart_isPart_crossingPartExcept_middle E hinj i
        have hdiff := (crossingPartExcept E
          (finFourMiddleLabel i)).degree_sdiff_add
            (twoCrossingLabelPart (E 0) (E 5)) hpart v
        have htwoPair :
            (twoCrossingLabelPart (E 0) (E 5)).degree v =
              (singleEdge (sixPairEndpoint E 0)
                (sixPairEndpoint E 5)).degree ⟨v, hv⟩ := by
          rw [degree_twoCrossingLabelPart, hpairTotal]
          simp [hout, eq_comm]
        rw [htwoPair] at hdiff
        have hselection :
            ((crossingPartExcept E
                (finFourMiddleLabel i)).sdiff
              (twoCrossingLabelPart (E 0) (E 5))).degree v =
              hybridStarDegree E (some i) ⟨v, hv⟩ := by
          exact Nat.add_left_cancel (by
            calc
              (singleEdge (sixPairEndpoint E 0)
                    (sixPairEndpoint E 5)).degree ⟨v, hv⟩ +
                  ((crossingPartExcept E
                      (finFourMiddleLabel i)).sdiff
                    (twoCrossingLabelPart (E 0) (E 5))).degree v =
                  ((crossingPartExcept E
                      (finFourMiddleLabel i)).sdiff
                    (twoCrossingLabelPart (E 0) (E 5))).degree v +
                    (singleEdge (sixPairEndpoint E 0)
                      (sixPairEndpoint E 5)).degree ⟨v, hv⟩ :=
                Nat.add_comm _ _
              _ = (crossingPartExcept E
                    (finFourMiddleLabel i)).degree v := hdiff
              _ = (singleEdge (sixPairEndpoint E 0)
                    (sixPairEndpoint E 5)).degree ⟨v, hv⟩ +
                  hybridStarDegree E (some i) ⟨v, hv⟩ := hdecomp)
        simpa [hybridCrossingSelection, hybridClosingDegree] using hselection
      · simpa only [hybridCrossingSelection, hybridClosingDegree,
          Bool.true_eq, if_true] using hdecomp

lemma degree_hybridCrossingSelection_of_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (active : Option (Fin 4)) (usePair : Bool)
    (v : W) (hv : v ∉ S) :
    (hybridCrossingSelection E active usePair).degree v =
      hybridClosingDegree (reverseSixCutListing E) active usePair
        ⟨v, Finset.mem_compl.mpr hv⟩ := by
  classical
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  have hin (j : Fin 6) : v ≠ (E j).inside := by
    intro h
    exact hv (h ▸ (E j).inside_mem)
  have htotal : G.outsideDegree Sᶜ v =
      (if v = (E 0).outside then 1 else 0) +
      (if v = (E 1).outside then 1 else 0) +
      (if v = (E 2).outside then 1 else 0) +
      (if v = (E 3).outside then 1 else 0) +
      (if v = (E 4).outside then 1 else 0) +
      (if v = (E 5).outside then 1 else 0) := by
    rw [G.outsideDegree_eq_listingEndpointCount Sᶜ EC v hvC,
      listingEndpointCount, Fin.sum_univ_six]
    simp only [EC, reverseSixCutListing_inside, eq_comm]
  have hstarTotal :
      fourEndpointCount
          (fun j ↦ sixPairEndpoint EC (finFourMiddleLabel j)) ⟨v, hvC⟩ =
        (if v = (E 1).outside then 1 else 0) +
        (if v = (E 2).outside then 1 else 0) +
        (if v = (E 3).outside then 1 else 0) +
        (if v = (E 4).outside then 1 else 0) := by
    rw [fourEndpointCount, Fin.sum_univ_four]
    simp [EC, sixPairEndpoint, reverseSixCutListing_inside,
      finFourMiddleLabel_zero, finFourMiddleLabel_one,
      finFourMiddleLabel_two, finFourMiddleLabel_three,
      Subtype.ext_iff, eq_comm]
  have hpairTotal :
      (singleEdge (sixPairEndpoint EC 0)
          (sixPairEndpoint EC 5)).degree ⟨v, hvC⟩ =
        (if v = (E 0).outside then 1 else 0) +
        (if v = (E 5).outside then 1 else 0) := by
    simp [EC, degree_singleEdge, sixPairEndpoint,
      reverseSixCutListing_inside, Subtype.ext_iff, eq_comm]
  have homit (i : Fin 4) :
      (if sixPairEndpoint EC (finFourMiddleLabel i) = ⟨v, hvC⟩
        then 1 else 0) =
      (if v = (E (finFourMiddleLabel i)).outside then 1 else 0) := by
    by_cases h : sixPairEndpoint EC (finFourMiddleLabel i) = ⟨v, hvC⟩
    · have h' : v = (E (finFourMiddleLabel i)).outside := by
        simpa [EC, sixPairEndpoint, reverseSixCutListing_inside,
          Subtype.ext_iff] using h.symm
      simp [h, h']
    · have h' : v ≠ (E (finFourMiddleLabel i)).outside := by
        intro h'
        apply h
        apply Subtype.ext
        simpa [EC, sixPairEndpoint, reverseSixCutListing_inside]
          using h'.symm
      simp [h, h']
  have homitLe (i : Fin 4) :
      (if sixPairEndpoint EC (finFourMiddleLabel i) = ⟨v, hvC⟩
        then 1 else 0) ≤
      fourEndpointCount
        (fun j ↦ sixPairEndpoint EC (finFourMiddleLabel j)) ⟨v, hvC⟩ := by
    by_cases h : sixPairEndpoint EC (finFourMiddleLabel i) = ⟨v, hvC⟩
    · rw [if_pos h]
      exact (fourEndpointCount_pos_iff _ _).2 ⟨i, h⟩
    · simp [h]
  cases active with
  | none =>
      cases usePair
      · have hdeg := (G.crossingPart S).degree_sdiff_add
            (G.crossingPart S) (IsPart.refl _) v
        simpa [hybridCrossingSelection, hybridClosingDegree,
          hybridStarDegree, EC] using hdeg
      · rw [hybridCrossingSelection, hybridClosingDegree,
          hybridStarDegree, Nat.add_zero, hpairTotal,
          degree_twoCrossingLabelPart]
        simp [EC, hin, eq_comm]
  | some i =>
      have hcross := degree_crossingPartExcept_add_of_notMem
        E (finFourMiddleLabel i) v hv
      have hcross' :
          (crossingPartExcept E (finFourMiddleLabel i)).degree v +
              (if v = (E (finFourMiddleLabel i)).outside then 1 else 0) =
            G.outsideDegree Sᶜ v := by
        simpa only [eq_comm] using hcross
      have hdecomp :
          (crossingPartExcept E (finFourMiddleLabel i)).degree v =
            (singleEdge (sixPairEndpoint EC 0)
                (sixPairEndpoint EC 5)).degree ⟨v, hvC⟩ +
              hybridStarDegree EC (some i) ⟨v, hvC⟩ := by
        rw [hybridStarDegree, hpairTotal, hstarTotal, homit]
        have hle := homitLe i
        rw [hstarTotal, homit] at hle
        omega
      cases usePair
      · have hpart := pairPart_isPart_crossingPartExcept_middle E hinj i
        have hdiff := (crossingPartExcept E
          (finFourMiddleLabel i)).degree_sdiff_add
            (twoCrossingLabelPart (E 0) (E 5)) hpart v
        have htwoPair :
            (twoCrossingLabelPart (E 0) (E 5)).degree v =
              (singleEdge (sixPairEndpoint EC 0)
                (sixPairEndpoint EC 5)).degree ⟨v, hvC⟩ := by
          rw [degree_twoCrossingLabelPart, hpairTotal]
          simp [EC, hin, eq_comm]
        rw [htwoPair] at hdiff
        have hselection :
            ((crossingPartExcept E
                (finFourMiddleLabel i)).sdiff
              (twoCrossingLabelPart (E 0) (E 5))).degree v =
              hybridStarDegree EC (some i) ⟨v, hvC⟩ := by
          exact Nat.add_left_cancel (by
            calc
              (singleEdge (sixPairEndpoint EC 0)
                    (sixPairEndpoint EC 5)).degree ⟨v, hvC⟩ +
                  ((crossingPartExcept E
                      (finFourMiddleLabel i)).sdiff
                    (twoCrossingLabelPart (E 0) (E 5))).degree v =
                  ((crossingPartExcept E
                      (finFourMiddleLabel i)).sdiff
                    (twoCrossingLabelPart (E 0) (E 5))).degree v +
                    (singleEdge (sixPairEndpoint EC 0)
                      (sixPairEndpoint EC 5)).degree ⟨v, hvC⟩ :=
                Nat.add_comm _ _
              _ = (crossingPartExcept E
                    (finFourMiddleLabel i)).degree v := hdiff
              _ = (singleEdge (sixPairEndpoint EC 0)
                    (sixPairEndpoint EC 5)).degree ⟨v, hvC⟩ +
                  hybridStarDegree EC (some i) ⟨v, hvC⟩ := hdecomp)
        simpa [hybridCrossingSelection, hybridClosingDegree, EC]
          using hselection
      · simpa only [hybridCrossingSelection, hybridClosingDegree,
          Bool.true_eq, if_true, EC] using hdecomp

/-- Retain the two genuine shore parts of aligned hybrid closures and
restore exactly the original crossing copies prescribed by their common
center/pair pattern. -/
noncomputable def spliceImbalancedSixClosures
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (active : Option (Fin 4)) (usePair : Bool)
    (F : Pseudograph S) (L : Pseudograph ↑(Sᶜ)) : Pseudograph W :=
  extendFrom S F + extendFrom Sᶜ L +
    hybridCrossingSelection E active usePair

lemma degree_spliceImbalancedSixClosures_of_mem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (H : Pseudograph (Option S))
    (active : Option (Fin 4)) (usePair : Bool)
    (F : Pseudograph S)
    (hdec : HybridClosureDecomposition E H active usePair F)
    (L : Pseudograph ↑(Sᶜ)) (v : W) (hv : v ∈ S) :
    (spliceImbalancedSixClosures E active usePair F L).degree v =
      H.degree (some ⟨v, hv⟩) := by
  have hvC : v ∉ Sᶜ := by simp [hv]
  rw [spliceImbalancedSixClosures, degree_add, degree_add,
    degree_extendFrom_of_mem S F v hv,
    degree_extendFrom_of_notMem Sᶜ L v hvC,
    degree_hybridCrossingSelection_of_mem E hinj active usePair v hv,
    Nat.add_zero]
  exact hdec.2.1 ⟨v, hv⟩

lemma degree_spliceImbalancedSixClosures_of_notMem
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (K : Pseudograph (Option ↑(Sᶜ)))
    (active : Option (Fin 4)) (usePair : Bool)
    (L : Pseudograph ↑(Sᶜ))
    (hdec : HybridClosureDecomposition (reverseSixCutListing E) K
      active usePair L)
    (F : Pseudograph S) (v : W) (hv : v ∉ S) :
    (spliceImbalancedSixClosures E active usePair F L).degree v =
      K.degree (some ⟨v, Finset.mem_compl.mpr hv⟩) := by
  have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
  rw [spliceImbalancedSixClosures, degree_add, degree_add,
    degree_extendFrom_of_notMem S F v hv,
    degree_extendFrom_of_mem Sᶜ L v hvC,
    degree_hybridCrossingSelection_of_notMem E hinj active usePair v hv,
    Nat.zero_add]
  exact hdec.2.1 ⟨v, hvC⟩

lemma spliceImbalancedSixClosures_isPart
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (active : Option (Fin 4)) (usePair : Bool)
    (F : Pseudograph S) (L : Pseudograph ↑(Sᶜ))
    (hF : F.IsPart (G.induce S))
    (hL : L.IsPart (G.induce Sᶜ)) :
    (spliceImbalancedSixClosures E active usePair F L).IsPart G := by
  classical
  have hcross := hybridCrossingSelection_isPart E hinj active usePair
  have hcrossing :=
    hybridCrossingSelection_isPart_crossingPart E active usePair
  intro u v
  by_cases hu : u ∈ S <;> by_cases hv : v ∈ S
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∉ Sᶜ := by simp [hv]
    have hsel : (hybridCrossingSelection E active usePair).mult u v = 0 := by
      have hle := hcrossing u v
      have hcrossZero : (G.crossingPart S).mult u v = 0 := by
        simp [crossingPart, hu, hv]
      omega
    simpa [spliceImbalancedSixClosures, extendFrom, hu, hv,
      huC, hvC, hsel] using hF ⟨u, hu⟩ ⟨v, hv⟩
  · have huC : u ∉ Sᶜ := by simp [hu]
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    simpa [spliceImbalancedSixClosures, extendFrom, hu, hv,
      huC, hvC] using hcross u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∉ Sᶜ := by simp [hv]
    simpa [spliceImbalancedSixClosures, extendFrom, hu, hv,
      huC, hvC] using hcross u v
  · have huC : u ∈ Sᶜ := Finset.mem_compl.mpr hu
    have hvC : v ∈ Sᶜ := Finset.mem_compl.mpr hv
    have hsel : (hybridCrossingSelection E active usePair).mult u v = 0 := by
      have hle := hcrossing u v
      have hcrossZero : (G.crossingPart S).mult u v = 0 := by
        simp [crossingPart, hu, hv]
      omega
    simpa [spliceImbalancedSixClosures, extendFrom, hu, hv,
      huC, hvC, hsel] using hL ⟨u, huC⟩ ⟨v, hvC⟩

/-- Hybrid six-cut gluing.  A nonzero decomposition pattern of an arbitrary
cubic part on the opposite hybrid closure is matched on the chosen shore;
the zero pattern already lies wholly on that opposite shore. -/
theorem containsRegularPart_of_imbalancedSixClosuresWith
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (hS : ∀ active : Option (Fin 4), ∀ usePair : Bool,
      active ≠ none ∨ usePair = true →
      ∃ H : Pseudograph (Option S), ∃ F : Pseudograph S,
        H.IsPart (G.imbalancedSixClosure S E) ∧
        (∃ v : S, H.degree (some v) = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        HybridClosureDecomposition E H active usePair F)
    (hC : (G.imbalancedSixClosure Sᶜ
      (reverseSixCutListing E)).ContainsRegularPart 3) :
    G.ContainsRegularPart 3 := by
  classical
  let EC : Fin 6 ≃ CrossingEdge G Sᶜ := reverseSixCutListing E
  obtain ⟨K, hKpart, hKne, hKdeg⟩ := hC
  obtain ⟨active, usePair, L, hKdec⟩ :=
    exists_hybridClosureDecomposition EC K
      (by simpa only [EC] using hKpart) (hKdeg none)
  by_cases hzero : active = none ∧ usePair = false
  · have hLdeg (v : ↑(Sᶜ)) : L.degree v = K.degree (some v) := by
      have h := hKdec.2.1 v
      simp [hybridClosingDegree, hybridStarDegree, hzero.1, hzero.2] at h
      exact h
    refine ⟨extendFrom Sᶜ L, extendFrom_isPart hKdec.1, ?_, ?_⟩
    · obtain ⟨v, hv⟩ := hKne
      cases v with
      | none =>
          have hz : K.degree none = 0 := by
            simpa [hzero.1] using hKdec.2.2.1
          omega
      | some v =>
          refine ⟨v, ?_⟩
          rw [degree_extendFrom_of_mem Sᶜ L v v.2, hLdeg]
          exact hv
    · intro v
      by_cases hv : v ∈ Sᶜ
      · rw [degree_extendFrom_of_mem Sᶜ L v hv, hLdeg]
        exact hKdeg (some ⟨v, hv⟩)
      · exact .inl (degree_extendFrom_of_notMem Sᶜ L v hv)
  · have hnonzero : active ≠ none ∨ usePair = true := by
      cases active <;> cases usePair <;> simp_all
    obtain ⟨H, F, hHpart, hHne, hHdeg, hHdec⟩ :=
      hS active usePair hnonzero
    let Q := spliceImbalancedSixClosures E active usePair F L
    have hQpart : Q.IsPart G :=
      spliceImbalancedSixClosures_isPart E hinj active usePair F L
        hHdec.1 hKdec.1
    have hQdeg (v : W) : Q.degree v = 0 ∨ Q.degree v = 3 := by
      by_cases hv : v ∈ S
      · rw [show Q.degree v = H.degree (some ⟨v, hv⟩) by
          exact degree_spliceImbalancedSixClosures_of_mem
            E hinj H active usePair F hHdec L v hv]
        exact hHdeg (some ⟨v, hv⟩)
      · rw [show Q.degree v =
            K.degree (some ⟨v, Finset.mem_compl.mpr hv⟩) by
          exact degree_spliceImbalancedSixClosures_of_notMem
            E hinj K active usePair L hKdec F v hv]
        exact hKdeg (some ⟨v, Finset.mem_compl.mpr hv⟩)
    refine ⟨Q, hQpart, ?_, hQdeg⟩
    obtain ⟨v, hv⟩ := hHne
    refine ⟨v, ?_⟩
    rw [show Q.degree v = H.degree (some v) by
      exact degree_spliceImbalancedSixClosures_of_mem
        E hinj H active usePair F hHdec L v v.2]
    exact hv

lemma fourEndpointCount_eq_one_of_injective
    {X : Type*} [Fintype X] (f : Fin 4 → X)
    (hf : Function.Injective f) (i : Fin 4) :
    fourEndpointCount f (f i) = 1 := by
  classical
  rw [fourEndpointCount, Finset.sum_eq_single i]
  · simp
  · intro j _hj hji
    rw [if_neg]
    exact fun h ↦ hji (hf h)
  · simp

/-- Complement a prescribed perfect matching in the quartic hybrid closure
and peel the artificial pair exactly when it is meant to survive.  This is
the local witness constructor used in the center-active Hall branches. -/
lemma exists_hybridClosureWitness_of_perfectMatching
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (i : Fin 4) (usePair : Bool)
    (M : (G.imbalancedSixClosure S E).toSimple.Subgraph)
    (hM : M.IsPerfectMatching)
    (hMstar : M.Adj none
      (some (sixPairEndpoint E (finFourMiddleLabel i))))
    (hfalse : usePair = false →
      M.Adj (some (sixPairEndpoint E 0))
        (some (sixPairEndpoint E 5)))
    (htrue : usePair = true →
      ¬ M.Adj (some (sixPairEndpoint E 0))
        (some (sixPairEndpoint E 5))) :
    ∃ H : Pseudograph (Option S), ∃ F : Pseudograph S,
      H.IsPart (G.imbalancedSixClosure S E) ∧
      (∃ v : S, H.degree (some v) = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      HybridClosureDecomposition E H (some i) usePair F := by
  classical
  let Q := G.imbalancedSixClosure S E
  let P := Q.ofUnderlyingSubgraph M
  let H := Q.sdiff P
  let D := H.dropStarCenter
  let B := G.induce S
  let z := sixPairEndpoint E 0
  let p := sixPairEndpoint E 5
  let f : Fin 4 → S := fun j ↦
    sixPairEndpoint E (finFourMiddleLabel j)
  have hf : Function.Injective f := by
    intro j k h
    apply finFourMiddleLabel_injective
    apply hinj
    exact h
  have hPQ : P.IsPart Q := Q.ofUnderlyingSubgraph_isPart M
  have hHQ : H.IsPart Q := Q.sdiff_isPart_left P
  have hQreg : Q.IsRegularOfDegree 4 :=
    imbalancedSixClosure_isRegularOfDegree G hreg S E
  have hHdeg (v : Option S) : H.degree v = 3 := by
    have hdiff := Q.degree_sdiff_add P hPQ v
    have hPdeg : P.degree v = 1 :=
      Q.degree_ofUnderlyingSubgraph_of_isPerfectMatching M hM v
    change H.degree v + P.degree v = Q.degree v at hdiff
    rw [hPdeg, hQreg v] at hdiff
    omega
  have hstar (v : S) :
      H.mult none (some v) =
        fourEndpointCount f v - if f i = v then 1 else 0 := by
    by_cases heq : f i = v
    · have hs : sixPairEndpoint E (finFourMiddleLabel i) = v := by
        simpa [f] using heq
      have hAdj : M.spanningCoe.Adj none (some v) := by
        simpa [hs] using hMstar
      have hAdjM : M.Adj none (some v) := by simpa using hAdj
      have hPmult : P.mult none (some v) = 1 := by
        change (if M.Adj none (some v) then 1 else 0) = 1
        rw [if_pos hAdjM]
      have hcount : fourEndpointCount f v = 1 := by
        rw [← heq]
        exact fourEndpointCount_eq_one_of_injective f hf i
      change Q.mult none (some v) - P.mult none (some v) =
        fourEndpointCount f v - if f i = v then 1 else 0
      rw [hPmult]
      change fourEndpointCount f v - 1 =
        fourEndpointCount f v - if f i = v then 1 else 0
      simp [heq, hcount]
    · have hnotAdj : ¬ M.spanningCoe.Adj none (some v) := by
        intro hAdj
        have hAdj' : M.Adj none (some v) := by simpa using hAdj
        have ht := hM.1.eq_of_adj_left hMstar hAdj'
        exact heq (Option.some.inj ht)
      have hnotAdjM : ¬ M.Adj none (some v) := by simpa using hnotAdj
      have hPmult : P.mult none (some v) = 0 := by
        change (if M.Adj none (some v) then 1 else 0) = 0
        rw [if_neg hnotAdjM]
      change Q.mult none (some v) - P.mult none (some v) =
        fourEndpointCount f v - if f i = v then 1 else 0
      rw [hPmult]
      change fourEndpointCount f v - 0 =
        fourEndpointCount f v - if f i = v then 1 else 0
      simp [heq]
  have hDpart : D.IsPart (B + singleEdge z p) := by
    intro u v
    have h := hHQ (some u) (some v)
    simpa [D, B, z, p, Q, imbalancedSixClosure,
      dropStarCenter_mult] using h
  have hpairNe : z ≠ p := fun h ↦ by
    apply (show (0 : Fin 6) ≠ 5 by decide)
    exact hinj h
  cases usePair with
  | false =>
      have hMpair := hfalse rfl
      have hAdj : M.spanningCoe.Adj (some z) (some p) := by
        simpa using hMpair
      have hAdjM : M.Adj (some z) (some p) := by simpa using hAdj
      have hPpair : P.mult (some z) (some p) = 1 := by
        change (if M.Adj (some z) (some p) then 1 else 0) = 1
        rw [if_pos hAdjM]
      have hDpair : D.mult z p = B.mult z p := by
        change Q.mult (some z) (some p) - P.mult (some z) (some p) =
          B.mult z p
        rw [hPpair]
        change (B + singleEdge z p).mult z p - 1 = B.mult z p
        simp [singleEdge_mult, hpairNe]
      have hDB : D.IsPart B :=
        isPart_left_of_isPart_add_of_mult_le hDpart (by
          rw [hDpair])
      refine ⟨H, D, hHQ, ⟨z, hHdeg (some z)⟩,
        fun v ↦ .inr (hHdeg v), hDB, ?_, hHdeg none, ?_⟩
      · intro v
        have hdrop := degree_dropStarCenter_add H v
        rw [← H.mult_comm, hstar] at hdrop
        simpa [hybridClosingDegree, hybridStarDegree, f, D]
          using hdrop
      · intro v
        simpa [hybridStarDegree, f] using hstar v

  | true =>
      have hMpair := htrue rfl
      have hnotAdj : ¬ M.spanningCoe.Adj (some z) (some p) := by
        simpa using hMpair
      have hnotAdjM : ¬ M.Adj (some z) (some p) := by
        simpa using hnotAdj
      have hPpair : P.mult (some z) (some p) = 0 := by
        change (if M.Adj (some z) (some p) then 1 else 0) = 0
        rw [if_neg hnotAdjM]
      have hDpair : D.mult z p = B.mult z p + 1 := by
        change Q.mult (some z) (some p) - P.mult (some z) (some p) =
          B.mult z p + 1
        rw [hPpair]
        change (B + singleEdge z p).mult z p - 0 = B.mult z p + 1
        simp [singleEdge_mult, hpairNe]
      let F := D.removeSingleEdge z p
      have hFpart : F.IsPart B := removeSingleEdge_isPart_left hDpart
      have hpos : 0 < D.mult z p := by rw [hDpair]; omega
      have hFdeg (v : S) :
          F.degree v + (singleEdge z p).degree v = D.degree v := by
        have hr := degree_removeSingleEdge_add D z p v hpos
        simpa only [F, degree_singleEdge, Nat.add_assoc] using hr
      refine ⟨H, F, hHQ, ⟨z, hHdeg (some z)⟩,
        fun v ↦ .inr (hHdeg v), hFpart, ?_, hHdeg none, ?_⟩
      · intro v
        have hdrop := degree_dropStarCenter_add H v
        rw [← H.mult_comm, hstar] at hdrop
        have hpv := hFdeg v
        simp only [hybridClosingDegree, Bool.true_eq, if_true,
          hybridStarDegree]
        change F.degree v + ((singleEdge z p).degree v +
            (fourEndpointCount f v - if f i = v then 1 else 0)) =
          H.degree (some v)
        calc
          _ = (F.degree v + (singleEdge z p).degree v) +
                (fourEndpointCount f v - if f i = v then 1 else 0) := by
              rw [Nat.add_assoc]
          _ = D.degree v +
                (fourEndpointCount f v - if f i = v then 1 else 0) := by
              rw [hpv]
          _ = H.degree (some v) := hdrop
      · intro v
        simpa [hybridStarDegree, f] using hstar v

lemma exists_centerActive_hybridClosureWitness
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      G.boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E))
    (i : Fin 4) (usePair : Bool) :
    ∃ H : Pseudograph (Option S), ∃ F : Pseudograph S,
      H.IsPart (G.imbalancedSixClosure S E) ∧
      (∃ v : S, H.degree (some v) = 3) ∧
      (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
      HybridClosureDecomposition E H (some i) usePair F := by
  obtain ⟨Mpair, Mavoid, hMpair, hMpairStar, hMpairPair,
      hMavoid, hMavoidStar, hMavoidPair⟩ :=
    exists_centerActive_imbalancedPerfectMatchings
      G hreg hsimple hno4 S E A B hbip hcard
        h₀ h₁ h₂ h₃ h₄ h₅ hinj i
  cases usePair with
  | false =>
      exact exists_hybridClosureWitness_of_perfectMatching
        G hreg S E hinj i false Mpair hMpair hMpairStar
          (fun _ ↦ hMpairPair) (by simp)
  | true =>
      exact exists_hybridClosureWitness_of_perfectMatching
        G hreg S E hinj i true Mavoid hMavoid hMavoidStar
          (by simp) (fun _ ↦ hMavoidPair)

/-- A quartic bipartite block with one more right vertex and exactly one
missing left incidence has a six-edge boundary.  This is the numerical
ledger used for each of the two residual Hall defects in the imbalanced
case of Tashkinov's argument. -/
lemma boundaryMultiplicity_union_eq_six_of_bipartite
    [DecidableEq W]
    (P : Pseudograph W) (hreg : P.IsRegularOfDegree 4)
    (A B U T : Finset W) (hbip : P.IsBipartiteWith A B)
    (hUA : U ⊆ A) (hTB : T ⊆ B)
    (hcard : T.card = U.card + 1)
    (hbetween : P.betweenMultiplicity U T + 1 = 4 * U.card) :
    P.boundaryMultiplicity (U ∪ T) = 6 := by
  classical
  have hUT : Disjoint U T :=
    Disjoint.mono hUA hTB hbip.disjoint
  have hintU : P.internalMultiplicity U = 0 :=
    hbip.internalMultiplicity_eq_zero_of_subset_left hUA
  have hintT : P.internalMultiplicity T = 0 :=
    hbip.internalMultiplicity_eq_zero_of_subset_right hTB
  have hint : P.internalMultiplicity (U ∪ T) =
      P.internalMultiplicity U + P.internalMultiplicity T +
        P.betweenMultiplicity U T := by
    unfold internalMultiplicity betweenMultiplicity
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro e _
    induction e using Sym2.inductionOn with
    | _ a b =>
        have hUTa : ¬ (a ∈ U ∧ a ∈ T) := by
          exact fun h ↦ (Finset.disjoint_left.mp hUT) h.1 h.2
        have hUTb : ¬ (b ∈ U ∧ b ∈ T) := by
          exact fun h ↦ (Finset.disjoint_left.mp hUT) h.1 h.2
        by_cases haU : a ∈ U <;> by_cases hbU : b ∈ U <;>
          by_cases haT : a ∈ T <;> by_cases hbT : b ∈ T
        all_goals simp [internalIndicator_mk, betweenIndicator_mk,
          haU, hbU, haT, hbT] at *
        all_goals ring
  simp only [hintU, hintT, Nat.zero_add] at hint
  have hYcard : (U ∪ T).card = U.card + T.card :=
    Finset.card_union_of_disjoint hUT
  have hledger := P.regular_card_eq_two_internal_add_boundary
    hreg (U ∪ T)
  rw [hint, hYcard, hcard] at hledger
  omega

/-- The four large-side endpoints joined to the artificial center. -/
noncomputable def imbalancedMiddleFinset
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) : Finset S :=
  Finset.univ.image fun i : Fin 4 ↦
    sixPairEndpoint E (finFourMiddleLabel i)

lemma mem_imbalancedMiddleFinset
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S) (v : S) :
    v ∈ imbalancedMiddleFinset E ↔
      ∃ i : Fin 4, sixPairEndpoint E (finFourMiddleLabel i) = v := by
  classical
  simp [imbalancedMiddleFinset]

lemma card_imbalancedMiddleFinset
    {G : Pseudograph W} {S : Finset W}
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    (imbalancedMiddleFinset E).card = 4 := by
  classical
  rw [imbalancedMiddleFinset, Finset.card_image_of_injective]
  · simp
  · intro i j hij
    apply finFourMiddleLabel_injective
    exact hinj hij

/-- The four left-side vertices deleted in Tashkinov's residual graph:
the artificial center and the three old neighbours of one chosen middle
endpoint. -/
noncomputable def imbalancedDeletedLeft
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 4) :
    Finset (Option S) :=
  insert none (((G.induce S).toSimple.neighborFinset
    (sixPairEndpoint E (finFourMiddleLabel i))).map
      Function.Embedding.some)

lemma mem_imbalancedDeletedLeft_none
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 4) :
    none ∈ imbalancedDeletedLeft G S E i := by
  classical
  simp [imbalancedDeletedLeft]

lemma mem_imbalancedDeletedLeft_some
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S) (i : Fin 4) (v : S) :
    some v ∈ imbalancedDeletedLeft G S E i ↔
      (G.induce S).toSimple.Adj
        (sixPairEndpoint E (finFourMiddleLabel i)) v := by
  classical
  simp [imbalancedDeletedLeft, SimpleGraph.mem_neighborFinset,
    eq_comm]

lemma card_imbalancedDeletedLeft
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 4) :
    (imbalancedDeletedLeft G S E i).card = 4 := by
  classical
  have hnone : (none : Option S) ∉
      ((G.induce S).toSimple.neighborFinset
        (sixPairEndpoint E (finFourMiddleLabel i))).map
          Function.Embedding.some := by simp
  rw [imbalancedDeletedLeft, Finset.card_insert_of_notMem hnone,
    Finset.card_map, SimpleGraph.card_neighborFinset_eq_degree,
    degree_induce_eq_three_of_sixPairEndpoint_injective
      G hreg hsimple S E hinj]

/-- All quartic incidences of a left block land in a displayed right
block when the latter contains every positive-multiplicity neighbour. -/
lemma betweenMultiplicity_eq_four_mul_card_of_bipartite_neighbor_closed
    [DecidableEq W]
    (P : Pseudograph W) (hreg : P.IsRegularOfDegree 4)
    (A B U T : Finset W) (hbip : P.IsBipartiteWith A B)
    (hUA : U ⊆ A) (hTB : T ⊆ B)
    (hclosed : ∀ u ∈ U, ∀ w, 0 < P.mult u w → w ∈ T) :
    P.betweenMultiplicity U T = 4 * U.card := by
  classical
  have hUT : Disjoint U T :=
    Disjoint.mono hUA hTB hbip.disjoint
  rw [P.betweenMultiplicity_eq_sum_singleton_left U T hUT]
  calc
    (∑ u ∈ U, P.betweenMultiplicity {u} T) =
        ∑ _u ∈ U, 4 := by
      apply Finset.sum_congr rfl
      intro u hu
      have huA := hUA hu
      have huT : u ∉ T := by
        intro huT
        exact (Finset.disjoint_left.mp hUT) hu huT
      rw [P.betweenMultiplicity_singleton u T huT]
      have hloop : P.mult u u = 0 := by
        by_contra hne
        have hpos : 0 < P.mult u u := Nat.pos_of_ne_zero hne
        rcases hbip.crosses hpos with h | h
        · exact (Finset.disjoint_left.mp hbip.disjoint) h.1 h.2
        · exact (Finset.disjoint_left.mp hbip.disjoint) h.2 h.1
      rw [← hreg u, degree_eq_mult_self_add_sum, hloop,
        Nat.zero_add]
      apply Finset.sum_subset
      · intro w hw
        have hwT := hTB hw
        have hwu : w ≠ u := by
          intro hwu
          subst w
          exact (Finset.disjoint_left.mp hbip.disjoint) huA hwT
        simp [hwu]
      · intro w _hwAll hwT
        have hzero : P.mult u w = 0 := by
          by_contra hne
          exact hwT (hclosed u hu w (Nat.pos_of_ne_zero hne))
        exact hzero
    _ = 4 * U.card := by simp [Nat.mul_comm]

lemma degree_ofUnderlyingSubgraph_of_isMatching
    (P : Pseudograph W) (M : P.toSimple.Subgraph)
    (hM : M.IsMatching) (v : W) :
    (P.ofUnderlyingSubgraph M).degree v = if v ∈ M.verts then 1 else 0 := by
  classical
  rw [ofUnderlyingSubgraph, degree_ofSimple,
    SimpleGraph.Subgraph.degree_spanningCoe]
  by_cases hv : v ∈ M.verts
  · rw [if_pos hv]
    exact (SimpleGraph.Subgraph.isMatching_iff_forall_degree.mp hM) v hv
  · rw [if_neg hv, M.degree_of_notMem_verts hv]

/-- Hall's dichotomy for the graph obtained by deleting one middle
endpoint, its four left neighbours (including the artificial center), and
all four middle endpoints.  Failure of a residual transversal produces the
six-cut used in the double-defect argument. -/
lemma exists_residualTransversal_or_hallSixCut
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 4) :
    let Q := G.imbalancedSixClosure S E
    let DL := imbalancedDeletedLeft G S E i
    let C := (imbalancedMiddleFinset E).map Function.Embedding.some
    let L := optionLeftSide A \ DL
    let R := optionRightSide B \ C
    (∃ f : L → R, Function.Injective f ∧
        ∀ x : L, Q.toSimple.Adj x (f x)) ∨
      ∃ X : Finset (Option S),
        Q.boundaryMultiplicity X = 6 ∧
        none ∈ X ∧
        some (sixPairEndpoint E (finFourMiddleLabel i)) ∉ X ∧
        (∀ j : Fin 4, j ≠ i →
          some (sixPairEndpoint E (finFourMiddleLabel j)) ∈ X) ∧
        ∀ v : S, (G.induce S).toSimple.Adj
          (sixPairEndpoint E (finFourMiddleLabel i)) v → some v ∉ X := by
  let optionDecEq : DecidableEq (Option S) := inferInstance
  classical
  letI : DecidableEq (Option S) := optionDecEq
  let Q := G.imbalancedSixClosure S E
  let DL := imbalancedDeletedLeft G S E i
  let C := (imbalancedMiddleFinset E).map Function.Embedding.some
  let Ls := optionLeftSide A
  let Rs := optionRightSide B
  let L := Ls \ DL
  let R := Rs \ C
  let t := sixPairEndpoint E (finFourMiddleLabel i)
  let fmid : Fin 4 → S := fun j ↦
    sixPairEndpoint E (finFourMiddleLabel j)
  have hfmid : Function.Injective fmid := by
    intro j k hjk
    apply finFourMiddleLabel_injective
    exact hinj hjk
  have htB : t ∈ B := by
    fin_cases i <;> simp_all [t]
  have hQreg : Q.IsRegularOfDegree 4 :=
    imbalancedSixClosure_isRegularOfDegree G hreg S E
  have hQbip : Q.IsBipartiteWith Ls Rs :=
    imbalancedSixClosure_isBipartiteWith G S E A B hbip
      h₀ h₁ h₂ h₃ h₄ h₅
  have hCcard : C.card = 4 := by
    simpa [C] using card_imbalancedMiddleFinset E hinj
  have htC : some t ∈ C := by
    simp [C, t, fmid, imbalancedMiddleFinset]
  have hCsub : C ⊆ Rs := by
    intro x hx
    obtain ⟨v, hvC, rfl⟩ := Finset.mem_map.mp hx
    obtain ⟨j, hj⟩ := (mem_imbalancedMiddleFinset E v).mp hvC
    have hvB : v ∈ B := by
      subst v
      fin_cases j <;> simp_all
    simpa [Rs] using hvB
  have hDLsub : DL ⊆ Ls := by
    intro x hx
    cases x with
    | none => simp [Ls]
    | some x =>
        have htx : (G.induce S).toSimple.Adj t x := by
          simpa [DL, t] using
            (mem_imbalancedDeletedLeft_some G S E i x).mp hx
        have hxA : x ∈ A := by
          rcases hbip.crosses htx.2 with h | h
          · exact False.elim
              ((Finset.disjoint_left.mp hbip.disjoint) h.1 htB)
          · exact h.2
        simpa [Ls] using hxA
  have hDLcard : DL.card = 4 := by
    simpa [DL] using card_imbalancedDeletedLeft
      G hreg hsimple S E hinj i
  have hLsRs : Ls.card = Rs.card := by
    simpa [Ls, Rs, card_optionLeftSide, card_optionRightSide] using hcard
  have hLcard : L.card + 4 = Ls.card := by
    have h := Finset.card_sdiff_add_card_eq_card hDLsub
    simpa [L, hDLcard] using h
  have hRcard : R.card + 4 = Rs.card := by
    have h := Finset.card_sdiff_add_card_eq_card hCsub
    simpa [R, hCcard] using h
  have hLRcard : L.card = R.card := by omega
  let rel : L → R → Prop := fun x y ↦ Q.toSimple.Adj x y
  by_cases htrans : ∃ f : L → R, Function.Injective f ∧
      ∀ x, rel x (f x)
  · exact .inl (by simpa [Q, DL, C, L, R, rel] using htrans)
  · right
    have htypeCard : Fintype.card L = Fintype.card R := by
      simpa using hLRcard
    obtain ⟨U', T', hUTcard, hneighbor⟩ :=
      exists_exact_hallDefect rel htypeCard htrans
    let U : Finset (Option S) := U'.image Subtype.val
    let T₀ : Finset (Option S) := T'.image Subtype.val
    let U₁ : Finset (Option S) := insert none U
    let C' : Finset (Option S) := C.erase (some t)
    let T : Finset (Option S) := T₀ ∪ C'
    let X : Finset (Option S) := U₁ ∪ T
    have hUsubL : U ⊆ L := by
      intro x hx
      obtain ⟨x', _hx, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    have hT₀subR : T₀ ⊆ R := by
      intro x hx
      obtain ⟨x', _hx, rfl⟩ := Finset.mem_image.mp hx
      exact x'.2
    have hUsubLs : U ⊆ Ls := fun _ hx ↦
      (Finset.mem_sdiff.mp (hUsubL hx)).1
    have hT₀subRs : T₀ ⊆ Rs := fun _ hx ↦
      (Finset.mem_sdiff.mp (hT₀subR hx)).1
    have hnoneU : (none : Option S) ∉ U := by
      intro hn
      have hnL := hUsubL hn
      have hnDL : (none : Option S) ∈ DL := by
        simp [DL, mem_imbalancedDeletedLeft_none]
      exact (Finset.mem_sdiff.mp hnL).2 hnDL
    have hT₀C : Disjoint T₀ C := by
      rw [Finset.disjoint_left]
      intro x hxT hxC
      exact (Finset.mem_sdiff.mp (hT₀subR hxT)).2 hxC
    have hC'card : C'.card = 3 := by
      simpa [C', Finset.card_erase_of_mem htC, hCcard]
    have hT₀C' : Disjoint T₀ C' :=
      hT₀C.mono_right (Finset.erase_subset _ _)
    have hUcard : U.card = U'.card := by
      exact Finset.card_image_of_injective _ Subtype.val_injective
    have hT₀card : T₀.card = T'.card := by
      exact Finset.card_image_of_injective _ Subtype.val_injective
    have hU₁card : U₁.card = U.card + 1 := by
      simpa [U₁] using Finset.card_insert_of_notMem hnoneU
    have hTcard : T.card = T₀.card + 3 := by
      simpa [T, hC'card] using Finset.card_union_of_disjoint hT₀C'
    have hcardBlocks : T.card = U₁.card + 1 := by omega
    have hU₁subLs : U₁ ⊆ Ls := by
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hx
      · simp [Ls]
      · exact hUsubLs hx
    have hC'subRs : C' ⊆ Rs :=
      (Finset.erase_subset _ _).trans hCsub
    have hTsubRs : T ⊆ Rs := by
      intro x hx
      rcases Finset.mem_union.mp hx with hx | hx
      · exact hT₀subRs hx
      · exact hC'subRs hx
    have htT₀ : some t ∉ T₀ := by
      intro ht
      exact (Finset.mem_sdiff.mp (hT₀subR ht)).2 htC
    have htC' : some t ∉ C' := by simp [C']
    have htT : some t ∉ T := by simp [T, htT₀, htC']
    have htRs : some t ∈ Rs := by simpa [Rs] using htB
    have hclosed : ∀ x ∈ U₁, ∀ w,
        0 < Q.mult x w → w ∈ insert (some t) T := by
      intro x hx w hxw
      rcases Finset.mem_insert.mp hx with rfl | hxU
      · cases w with
        | none =>
            change 0 < 0 at hxw
            omega
        | some w =>
            have hwC : some w ∈ C := by
              change 0 < fourEndpointCount fmid w at hxw
              obtain ⟨j, hj⟩ := (fourEndpointCount_pos_iff fmid w).mp hxw
              apply Finset.mem_map.mpr
              refine ⟨w, ?_, rfl⟩
              exact (mem_imbalancedMiddleFinset E w).mpr ⟨j, hj⟩
            by_cases hwt : w = t
            · simp [hwt]
            · apply Finset.mem_insert_of_mem
              apply Finset.mem_union_right
              exact Finset.mem_erase.mpr ⟨by simpa using hwt, hwC⟩
      · have hxL := hUsubL hxU
        have hxLs := (Finset.mem_sdiff.mp hxL).1
        have hwRs : w ∈ Rs := by
          rcases hQbip.crosses hxw with h | h
          · exact h.2
          · exact False.elim
              ((Finset.disjoint_left.mp hQbip.disjoint) hxLs h.1)
        by_cases hwt : w = some t
        · subst w
          have hAdj : Q.toSimple.Adj x (some t) := by
            refine ⟨?_, hxw⟩
            intro heq
            exact (Finset.disjoint_left.mp hQbip.disjoint) hxLs
              (heq ▸ htRs)
          have hxDL : x ∈ DL := by
            cases x with
            | none => simp [DL, mem_imbalancedDeletedLeft_none]
            | some x =>
                apply (mem_imbalancedDeletedLeft_some G S E i x).mpr
                have hbase : (G.induce S).toSimple.Adj t x := by
                  have hpos : 0 < (G.induce S).mult x t := by
                    change 0 < (G.induce S + singleEdge
                      (sixPairEndpoint E 0)
                      (sixPairEndpoint E 5)).mult x t at hxw
                    rw [add_mult] at hxw
                    have hpairZero : (singleEdge
                        (sixPairEndpoint E 0)
                        (sixPairEndpoint E 5)).mult x t = 0 := by
                      rw [singleEdge_mult, if_neg]
                      intro hshape
                      rcases hshape with hshape | hshape
                      · exact finFourMiddleLabel_ne_five i
                          (hinj (by simpa [t] using hshape.2))
                      · exact finFourMiddleLabel_ne_zero i
                          (hinj (by simpa [t] using hshape.2))
                    rw [hpairZero, Nat.add_zero] at hxw
                    exact hxw
                  exact ⟨fun heq ↦ hAdj.1 (congrArg some heq.symm),
                    by simpa [G.mult_comm] using hpos⟩
                exact hbase
          exact False.elim ((Finset.mem_sdiff.mp hxL).2 hxDL)
        · apply Finset.mem_insert_of_mem
          by_cases hwC : w ∈ C
          · apply Finset.mem_union_right
            exact Finset.mem_erase.mpr ⟨hwt, hwC⟩
          · have hwR : w ∈ R := Finset.mem_sdiff.mpr ⟨hwRs, hwC⟩
            obtain ⟨x', hxU', hxeq⟩ := Finset.mem_image.mp hxU
            let w' : R := ⟨w, hwR⟩
            have hrel : rel x' w' := by
              change Q.toSimple.Adj (x' : Option S) (w' : Option S)
              refine ⟨?_, ?_⟩
              · intro heq
                exact (Finset.disjoint_left.mp hQbip.disjoint)
                  (hxeq ▸ hxLs) (heq ▸ hwRs)
              · simpa [hxeq] using hxw
            have hwT' := hneighbor x' hxU' w' hrel
            apply Finset.mem_union_left
            exact Finset.mem_image.mpr ⟨w', hwT', rfl⟩
    have hbetweenAll :
        Q.betweenMultiplicity U₁ (insert (some t) T) = 4 * U₁.card :=
      betweenMultiplicity_eq_four_mul_card_of_bipartite_neighbor_closed
        Q hQreg Ls Rs U₁ (insert (some t) T) hQbip hU₁subLs
          (by
            intro x hx
            rcases Finset.mem_insert.mp hx with rfl | hxT
            · exact htRs
            · exact hTsubRs hxT)
          hclosed
    have hUT : Disjoint U₁ T :=
      Disjoint.mono hU₁subLs hTsubRs hQbip.disjoint
    have hUt : Disjoint U₁ ({some t} : Finset (Option S)) := by
      simp only [Finset.disjoint_singleton_right]
      intro htU
      exact (Finset.disjoint_left.mp hQbip.disjoint) (hU₁subLs htU) htRs
    have hTt : Disjoint T ({some t} : Finset (Option S)) := by
      simp [htT]
    have hsplit := Q.betweenMultiplicity_union_right U₁ T
      ({some t} : Finset (Option S)) hTt
      (by
        apply Finset.disjoint_left.mpr
        intro x hxU hx
        have hx' : x ∈ T ∨ x ∈ ({some t} : Finset (Option S)) := by
          simpa only [Finset.mem_union] using hx
        rcases hx' with hxT | hxt
        · exact (Finset.disjoint_left.mp hUT) hxU hxT
        · exact (Finset.disjoint_left.mp hUt) hxU hxt)
    have hunionT :
        (letI : DecidableEq (Option S) := Classical.decEq _;
          T ∪ ({some t} : Finset (Option S))) = insert (some t) T := by
      ext x
      simp
    rw [hunionT] at hsplit
    have hcenterT : Q.betweenMultiplicity U₁ {some t} = 1 := by
      have hUdis : Disjoint U ({some t} : Finset (Option S)) :=
        Disjoint.mono hUsubLs (by simpa using htRs)
          hQbip.disjoint
      have hnoneUdis : Disjoint ({none} : Finset (Option S)) U := by
        simp [hnoneU]
      have hleftSplit := Q.betweenMultiplicity_union_left
        ({none} : Finset (Option S)) U {some t}
          hnoneUdis (by
            apply Finset.disjoint_left.mpr
            intro x hx hxT
            have hx' : x ∈ ({none} : Finset (Option S)) ∨ x ∈ U := by
              simpa only [Finset.mem_union] using hx
            rcases hx' with hxnone | hxU
            · simp only [Finset.mem_singleton] at hxnone hxT
              subst x
              simp at hxT
            · exact (Finset.disjoint_left.mp hUdis) hxU hxT)
      have hunionNone :
          (letI : DecidableEq (Option S) := Classical.decEq _;
            ({none} : Finset (Option S)) ∪ U) = insert none U := by
        ext x
        simp
      rw [hunionNone] at hleftSplit
      have hnoneT : Q.betweenMultiplicity {none} {some t} = 1 := by
        rw [Q.betweenMultiplicity_singleton none {some t} (by simp)]
        simp only [Finset.sum_singleton]
        change Q.mult none (some t) = 1
        change fourEndpointCount fmid t = 1
        exact fourEndpointCount_eq_one_of_injective fmid hfmid i
      have hUTzero : Q.betweenMultiplicity U {some t} = 0 := by
        apply Q.betweenMultiplicity_eq_zero_of_no_toSimple_adj U {some t} hUdis
        intro x hx y hy
        have hyEq : y = some t := by simpa using hy
        subst y
        intro hAdj
        have hxL := hUsubL hx
        have hxDL : x ∈ DL := by
          cases x with
          | none => simp [DL, mem_imbalancedDeletedLeft_none]
          | some x =>
              apply (mem_imbalancedDeletedLeft_some G S E i x).mpr
              have hposQ := hAdj.2
              have hpos : 0 < (G.induce S).mult x t := by
                change 0 < (G.induce S + singleEdge
                  (sixPairEndpoint E 0)
                  (sixPairEndpoint E 5)).mult x t at hposQ
                rw [add_mult] at hposQ
                have hpairZero : (singleEdge
                    (sixPairEndpoint E 0)
                    (sixPairEndpoint E 5)).mult x t = 0 := by
                  rw [singleEdge_mult, if_neg]
                  intro hshape
                  rcases hshape with hshape | hshape
                  · exact finFourMiddleLabel_ne_five i
                      (hinj (by simpa [t] using hshape.2))
                  · exact finFourMiddleLabel_ne_zero i
                      (hinj (by simpa [t] using hshape.2))
                omega
              exact ⟨fun heq ↦ hAdj.1 (congrArg some heq.symm),
                by simpa [G.mult_comm] using hpos⟩
        exact (Finset.mem_sdiff.mp hxL).2 hxDL
      change Q.betweenMultiplicity (({none} : Finset (Option S)) ∪ U)
        {some t} = 1
      calc
        Q.betweenMultiplicity (({none} : Finset (Option S)) ∪ U) {some t} =
            Q.betweenMultiplicity {none} {some t} +
              Q.betweenMultiplicity U {some t} := by
                simpa only [Finset.singleton_union] using hleftSplit
        _ = 1 := by rw [hnoneT, hUTzero]
    have hbetween : Q.betweenMultiplicity U₁ T + 1 = 4 * U₁.card := by
      calc
        Q.betweenMultiplicity U₁ T + 1 =
            Q.betweenMultiplicity U₁ T +
              Q.betweenMultiplicity U₁ {some t} := by rw [hcenterT]
        _ = Q.betweenMultiplicity U₁ (insert (some t) T) := by
          simpa only [Finset.union_singleton] using hsplit.symm
        _ = 4 * U₁.card := by
          exact hbetweenAll
    have hcut : Q.boundaryMultiplicity X = 6 := by
      change Q.boundaryMultiplicity (U₁ ∪ T) = 6
      exact boundaryMultiplicity_union_eq_six_of_bipartite
        Q hQreg Ls Rs U₁ T hQbip hU₁subLs hTsubRs
          hcardBlocks hbetween
    refine ⟨X, hcut, ?_, ?_, ?_, ?_⟩
    · simp [X, U₁]
    · intro htX
      rcases Finset.mem_union.mp htX with htU | htTmem
      · exact (Finset.disjoint_left.mp hQbip.disjoint)
          (hU₁subLs htU) htRs
      · exact htT htTmem
    · intro j hji
      apply Finset.mem_union_right
      apply Finset.mem_union_right
      apply Finset.mem_erase.mpr
      constructor
      · intro heq
        exact hji (hfmid (Option.some.inj heq))
      · apply Finset.mem_map.mpr
        refine ⟨fmid j, ?_, rfl⟩
        exact (mem_imbalancedMiddleFinset E (fmid j)).mpr ⟨j, rfl⟩
    · intro v htv hvX
      have hvDL : some v ∈ DL := by
        exact (mem_imbalancedDeletedLeft_some G S E i v).mpr htv
      rcases Finset.mem_union.mp hvX with hvU | hvT
      · have hvL : some v ∈ L := hUsubL (by
          exact Finset.mem_insert.mp hvU |>.resolve_left (by simp))
        exact (Finset.mem_sdiff.mp hvL).2 hvDL
      · have hvA : v ∈ A := by
          rcases hbip.crosses htv.2 with h | h
          · exact False.elim
              ((Finset.disjoint_left.mp hbip.disjoint) h.1 htB)
          · exact h.2
        have hvLs : some v ∈ Ls := by simpa [Ls] using hvA
        exact (Finset.disjoint_left.mp hQbip.disjoint)
          hvLs (hTsubRs hvT)

/-- A residual transversal is deleted after isolating the artificial center
and its chosen middle neighbour.  Every remaining old vertex then has
degree three: deleted-neighbour vertices lose the chosen middle edge,
the other middle endpoints lose their center edge, and all residual
vertices lose their transversal edge. -/
lemma residualTransversal_cubicPart
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 4)
    (f : ↥(optionLeftSide A \ imbalancedDeletedLeft G S E i) →
      ↥(optionRightSide B \
        (imbalancedMiddleFinset E).map Function.Embedding.some))
    (hf : Function.Injective f)
    (hadj : ∀ x : ↥(optionLeftSide A \ imbalancedDeletedLeft G S E i),
      (G.imbalancedSixClosure S E).toSimple.Adj x (f x)) :
    ∃ M : (G.imbalancedSixClosure S E).toSimple.Subgraph,
      ∃ H : Pseudograph (Option S),
        M.IsMatching ∧
        M.verts = ((optionLeftSide A \
            imbalancedDeletedLeft G S E i) ∪
          (optionRightSide B \
            (imbalancedMiddleFinset E).map Function.Embedding.some) :
              Finset (Option S)) ∧
        H.IsPart (G.imbalancedSixClosure S E) ∧
        H.degree none = 0 ∧
        H.degree (some
          (sixPairEndpoint E (finFourMiddleLabel i))) = 0 ∧
        (∀ v : S, v ≠ sixPairEndpoint E (finFourMiddleLabel i) →
          H.degree (some v) = 3) ∧
        H = (((G.imbalancedSixClosure S E).deleteIncidence none)
          |>.deleteIncidence
            (some (sixPairEndpoint E (finFourMiddleLabel i)))).sdiff
          ((G.imbalancedSixClosure S E).ofUnderlyingSubgraph M) := by
  let optionDecEq : DecidableEq (Option S) := inferInstance
  classical
  letI : DecidableEq (Option S) := optionDecEq
  let Q := G.imbalancedSixClosure S E
  let DL := imbalancedDeletedLeft G S E i
  let C := (imbalancedMiddleFinset E).map Function.Embedding.some
  let L := optionLeftSide A \ DL
  let R := optionRightSide B \ C
  let t := sixPairEndpoint E (finFourMiddleLabel i)
  let fmid : Fin 4 → S := fun j ↦
    sixPairEndpoint E (finFourMiddleLabel j)
  let M := transversalSubgraph Q.toSimple L R f hadj
  let P := Q.ofUnderlyingSubgraph M
  let D := (Q.deleteIncidence none).deleteIncidence (some t)
  let H := D.sdiff P
  have hfmid : Function.Injective fmid := by
    intro j k hjk
    apply finFourMiddleLabel_injective
    exact hinj hjk
  have htB : t ∈ B := by
    fin_cases i <;> simp_all [t]
  have hQreg : Q.IsRegularOfDegree 4 :=
    imbalancedSixClosure_isRegularOfDegree G hreg S E
  have hQbip : Q.IsBipartiteWith
      (optionLeftSide A) (optionRightSide B) :=
    imbalancedSixClosure_isBipartiteWith G S E A B hbip
      h₀ h₁ h₂ h₃ h₄ h₅
  have hLRdisj : Disjoint L R := by
    exact Disjoint.mono (Finset.sdiff_subset.trans (by rfl))
      (Finset.sdiff_subset.trans (by rfl)) hQbip.disjoint
  have hLcard : L.card = R.card := by
    have hDLsub : DL ⊆ optionLeftSide A := by
      intro x hx
      cases x with
      | none => simp
      | some x =>
          have htx : (G.induce S).toSimple.Adj t x := by
            simpa [DL, t] using
              (mem_imbalancedDeletedLeft_some G S E i x).mp hx
          have hxA : x ∈ A := by
            rcases hbip.crosses htx.2 with h | h
            · exact False.elim
                ((Finset.disjoint_left.mp hbip.disjoint) h.1 htB)
            · exact h.2
          simpa using hxA
    have hCsub : C ⊆ optionRightSide B := by
      intro x hx
      obtain ⟨v, hv, rfl⟩ := Finset.mem_map.mp hx
      obtain ⟨j, hj⟩ := (mem_imbalancedMiddleFinset E v).mp hv
      have hvB : v ∈ B := by
        subst v
        fin_cases j <;> simp_all
      simpa using hvB
    have hDLcard : DL.card = 4 := by
      simpa [DL] using card_imbalancedDeletedLeft
        G hreg hsimple S E hinj i
    have hCcard : C.card = 4 := by
      simpa [C] using card_imbalancedMiddleFinset E hinj
    have hleft : L.card + DL.card = A.card + 1 := by
      simpa only [L, card_optionLeftSide] using
        Finset.card_sdiff_add_card_eq_card hDLsub
    have hright : R.card + C.card = B.card := by
      simpa only [R, card_optionRightSide] using
        Finset.card_sdiff_add_card_eq_card hCsub
    rw [hDLcard] at hleft
    rw [hCcard] at hright
    change L.card = R.card
    omega
  have hMmatch : M.IsMatching :=
    transversalSubgraph_isMatching Q.toSimple L R hLRdisj hLcard f hf hadj
  have hMverts : M.verts = (L ∪ R : Finset (Option S)) := by
    change
      (letI : DecidableEq (Option S) := Classical.decEq _;
        ((L ∪ R : Finset (Option S)) : Set (Option S))) =
        ((L ∪ R : Finset (Option S)) : Set (Option S))
    ext x
    simp
  have hnoneDL : (none : Option S) ∈ DL := by
    simp [DL, mem_imbalancedDeletedLeft_none]
  have htC : some t ∈ C := by
    simp [C, t, imbalancedMiddleFinset]
  have hverts_not_none {v : Option S} (hv : v ∈ M.verts) : v ≠ none := by
    rw [hMverts] at hv
    rcases Finset.mem_union.mp hv with hvL | hvR
    · intro heq
      subst v
      exact (Finset.mem_sdiff.mp hvL).2 hnoneDL
    · intro heq
      subst v
      simpa using (Finset.mem_sdiff.mp hvR).1
  have hverts_not_t {v : Option S} (hv : v ∈ M.verts) : v ≠ some t := by
    rw [hMverts] at hv
    rcases Finset.mem_union.mp hv with hvL | hvR
    · intro heq
      subst v
      have htR : some t ∈ optionRightSide B := by simpa using htB
      exact (Finset.disjoint_left.mp hQbip.disjoint)
        (Finset.mem_sdiff.mp hvL).1 htR
    · intro heq
      subst v
      exact (Finset.mem_sdiff.mp hvR).2 htC
  have hPQ : P.IsPart Q := Q.ofUnderlyingSubgraph_isPart M
  have hPD : P.IsPart D := by
    intro u v
    have hle := hPQ u v
    by_cases huv : M.Adj u v
    · have huverts := M.edge_vert huv
      have hvverts := M.edge_vert huv.symm
      have hun := hverts_not_none huverts
      have hvn := hverts_not_none hvverts
      have hut := hverts_not_t huverts
      have hvt := hverts_not_t hvverts
      simpa [D, hun, hvn, hut, hvt] using hle
    · have hPzero : P.mult u v = 0 := by
        simp [P, ofUnderlyingSubgraph, ofSimple_mult, huv]
      rw [hPzero]
      omega
  have hHQ : H.IsPart Q := (D.sdiff_isPart_left P).trans
    ((Q.deleteIncidence none).deleteIncidence_isPart (some t) |>.trans
      (Q.deleteIncidence_isPart none))
  have hPdeg (v : Option S) :
      P.degree v = if v ∈ L ∪ R then 1 else 0 := by
    have h := degree_ofUnderlyingSubgraph_of_isMatching Q M hMmatch v
    simpa [P, hMverts] using h
  have hDledger (v : Option S) (hvn : v ≠ none) (hvt : v ≠ some t) :
      D.degree v + Q.mult v (some t) + Q.mult v none = 4 := by
    have h₁ : D.degree v + (Q.deleteIncidence none).mult v (some t) =
        (Q.deleteIncidence none).degree v := by
      simpa only [D] using
        (Q.deleteIncidence none).degree_deleteIncidence_add_mult_of_ne
          (u := some t) (v := v) hvt
    have h₂ := Q.degree_deleteIncidence_add_mult_of_ne
      (u := none) (v := v) hvn
    have hrow : (Q.deleteIncidence none).mult v (some t) =
        Q.mult v (some t) := by simp [hvn]
    rw [hrow] at h₁
    rw [hQreg v] at h₂
    omega
  have hcenterRow (v : S) :
      Q.mult (some v) none = if v ∈ imbalancedMiddleFinset E then 1 else 0 := by
    change fourEndpointCount fmid v = _
    by_cases hv : v ∈ imbalancedMiddleFinset E
    · rw [if_pos hv]
      obtain ⟨j, hj⟩ := (mem_imbalancedMiddleFinset E v).mp hv
      rw [← hj]
      exact fourEndpointCount_eq_one_of_injective fmid hfmid j
    · rw [if_neg hv]
      apply fourEndpointCount_eq_zero_of_ne
      intro j hj
      exact hv ((mem_imbalancedMiddleFinset E v).mpr ⟨j, hj⟩)
  have hpairAtT (v : S) :
      (singleEdge (sixPairEndpoint E 0)
        (sixPairEndpoint E 5)).mult v t = 0 := by
    rw [singleEdge_mult, if_neg]
    intro hshape
    rcases hshape with hshape | hshape
    · exact finFourMiddleLabel_ne_five i
        (hinj (by simpa [t] using hshape.2))
    · exact finFourMiddleLabel_ne_zero i
        (hinj (by simpa [t] using hshape.2))
  have hQt_of_adj (v : S) (hvt : (G.induce S).toSimple.Adj t v) :
      Q.mult (some v) (some t) = 1 := by
    change (G.induce S + singleEdge
      (sixPairEndpoint E 0) (sixPairEndpoint E 5)).mult v t = 1
    rw [add_mult, hpairAtT, Nat.add_zero]
    have hpos : 0 < (G.induce S).mult v t := by
      simpa [G.mult_comm] using hvt.2
    have hle : (G.induce S).mult v t ≤ 1 :=
      hsimple.2 (v : W) (t : W)
    omega
  have hQt_of_not_adj (v : S)
      (hvt : ¬ (G.induce S).toSimple.Adj t v) :
      Q.mult (some v) (some t) = 0 := by
    change (G.induce S + singleEdge
      (sixPairEndpoint E 0) (sixPairEndpoint E 5)).mult v t = 0
    rw [add_mult, hpairAtT, Nat.add_zero]
    by_contra hne
    apply hvt
    exact ⟨fun heq ↦ (Nat.ne_of_gt (Nat.pos_of_ne_zero hne))
      (by simpa [heq] using hsimple.1 (t : W)),
      by simpa [G.mult_comm] using Nat.pos_of_ne_zero hne⟩
  have hHcenter : H.degree none = 0 := by
    have hDzero : D.degree none = 0 := by
      have hdel : D.degree none +
          (Q.deleteIncidence none).mult none (some t) =
            (Q.deleteIncidence none).degree none := by
        simpa only [D] using
          (Q.deleteIncidence none).degree_deleteIncidence_add_mult_of_ne
            (u := some t) (v := none) (by simp)
      rw [Q.degree_deleteIncidence_self] at hdel
      omega
    have hdiff := D.degree_sdiff_add P hPD none
    change H.degree none + P.degree none = D.degree none at hdiff
    omega
  have hHt : H.degree (some t) = 0 := by
    have hDzero : D.degree (some t) = 0 := by simp [D]
    have hdiff := D.degree_sdiff_add P hPD (some t)
    change H.degree (some t) + P.degree (some t) = D.degree (some t) at hdiff
    omega
  have hHold (v : S) (hvt : v ≠ t) : H.degree (some v) = 3 := by
    have hvnone : (some v : Option S) ≠ none := by simp
    have hvst : (some v : Option S) ≠ some t := by simpa using hvt
    have hledger := hDledger (some v) hvnone hvst
    have hdiff := D.degree_sdiff_add P hPD (some v)
    change H.degree (some v) + P.degree (some v) = D.degree (some v) at hdiff
    by_cases hvA : v ∈ A
    · have hvC : v ∉ imbalancedMiddleFinset E := by
        intro hvC
        obtain ⟨j, hj⟩ := (mem_imbalancedMiddleFinset E v).mp hvC
        have hvB : v ∈ B := by
          subst v
          fin_cases j <;> simp_all
        exact (Finset.disjoint_left.mp hbip.disjoint) hvA hvB
      rw [hcenterRow, if_neg hvC] at hledger
      by_cases htAdj : (G.induce S).toSimple.Adj t v
      · rw [hQt_of_adj v htAdj] at hledger
        have hvDL : some v ∈ DL := by
          exact (mem_imbalancedDeletedLeft_some G S E i v).mpr htAdj
        have hvL : some v ∉ L := fun hvL ↦
          (Finset.mem_sdiff.mp hvL).2 hvDL
        have hvR : some v ∉ R := by
          intro hvR
          have hvRs := (Finset.mem_sdiff.mp hvR).1
          have hvLs : some v ∈ optionLeftSide A := by simpa using hvA
          exact (Finset.disjoint_left.mp hQbip.disjoint) hvLs hvRs
        rw [hPdeg, if_neg (by simp [hvL, hvR])] at hdiff
        omega
      · rw [hQt_of_not_adj v htAdj] at hledger
        have hvDL : some v ∉ DL := by
          intro hvDL
          exact htAdj
            ((mem_imbalancedDeletedLeft_some G S E i v).mp hvDL)
        have hvL : some v ∈ L := Finset.mem_sdiff.mpr
          ⟨by simpa using hvA, hvDL⟩
        rw [hPdeg, if_pos (Finset.mem_union_left R hvL)] at hdiff
        omega
    · have hvB : v ∈ B := hbip.mem_right_of_not_mem_left hvA
      have htNotAdj : ¬ (G.induce S).toSimple.Adj t v := by
        intro htv
        rcases hbip.crosses htv.2 with h | h
        · exact (Finset.disjoint_left.mp hbip.disjoint) h.1 htB
        · exact (Finset.disjoint_left.mp hbip.disjoint) h.2 hvB
      rw [hQt_of_not_adj v htNotAdj] at hledger
      by_cases hvC : v ∈ imbalancedMiddleFinset E
      · rw [hcenterRow, if_pos hvC] at hledger
        have hvCm : some v ∈ C := Finset.mem_map.mpr ⟨v, hvC, rfl⟩
        have hvR : some v ∉ R := fun hvR ↦
          (Finset.mem_sdiff.mp hvR).2 hvCm
        have hvL : some v ∉ L := by
          intro hvL
          have hvLs := (Finset.mem_sdiff.mp hvL).1
          have hvRs : some v ∈ optionRightSide B := by simpa using hvB
          exact (Finset.disjoint_left.mp hQbip.disjoint) hvLs hvRs
        rw [hPdeg, if_neg (by simp [hvL, hvR])] at hdiff
        omega
      · rw [hcenterRow, if_neg hvC] at hledger
        have hvR : some v ∈ R := Finset.mem_sdiff.mpr
          ⟨by simpa using hvB, by simpa [C] using hvC⟩
        rw [hPdeg, if_pos (Finset.mem_union_right L hvR)] at hdiff
        omega
  refine ⟨M, H, hMmatch, hMverts, hHQ, hHcenter, hHt, hHold, rfl⟩

/-- A residual transversal has the precise alternative used by Tashkinov.
If it uses the artificial pair, deleting it leaves a cubic part wholly in
the original shore.  If it avoids the pair, the pair survives and the same
construction is the missing center-isolated hybrid witness. -/
lemma containsRegularPart_or_centerIsolatedWitness_of_residualTransversal
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (hsimple : G.HasSimpleMultiplicities)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (A B : Finset S)
    (hbip : (G.induce S).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) (i : Fin 4)
    (f : ↥(optionLeftSide A \ imbalancedDeletedLeft G S E i) →
      ↥(optionRightSide B \
        (imbalancedMiddleFinset E).map Function.Embedding.some))
    (hf : Function.Injective f)
    (hadj : ∀ x : ↥(optionLeftSide A \ imbalancedDeletedLeft G S E i),
      (G.imbalancedSixClosure S E).toSimple.Adj x (f x)) :
    G.ContainsRegularPart 3 ∨
      ∃ H : Pseudograph (Option S), ∃ F : Pseudograph S,
        H.IsPart (G.imbalancedSixClosure S E) ∧
        (∃ v : S, H.degree (some v) = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        HybridClosureDecomposition E H none true F := by
  let optionDecEq : DecidableEq (Option S) := inferInstance
  classical
  letI : DecidableEq (Option S) := optionDecEq
  let Q := G.imbalancedSixClosure S E
  let z := sixPairEndpoint E 0
  let p := sixPairEndpoint E 5
  let t := sixPairEndpoint E (finFourMiddleLabel i)
  let L := optionLeftSide A \ imbalancedDeletedLeft G S E i
  let R := optionRightSide B \
    (imbalancedMiddleFinset E).map Function.Embedding.some
  obtain ⟨M, H, hMmatch, hMverts, hHQ, hHcenter, hHt, hHold, hHdef⟩ :=
    residualTransversal_cubicPart G hreg hsimple S E A B hbip hcard
      h₀ h₁ h₂ h₃ h₄ h₅ hinj i f hf hadj
  let D := H.dropStarCenter
  have hzt : z ≠ t := by
    intro h
    exact finFourMiddleLabel_ne_zero i (hinj h.symm)
  have hpt : p ≠ t := by
    intro h
    exact finFourMiddleLabel_ne_five i (hinj h.symm)
  have hzp : z ≠ p := fun h ↦ (by decide : (0 : Fin 6) ≠ 5) (hinj h)
  have hDpart : D.IsPart
      (G.induce S + singleEdge z p) := by
    intro u v
    have h := hHQ (some u) (some v)
    simpa [D, Q, imbalancedSixClosure, dropStarCenter_mult] using h
  have hstarZero (v : S) : H.mult none (some v) = 0 :=
    starEdge_eq_zero_of_center_degree_zero hHcenter v
  have hDdegree (v : S) : D.degree v = H.degree (some v) := by
    have hdrop := degree_dropStarCenter_add H v
    rw [H.mult_comm, hstarZero, Nat.add_zero] at hdrop
    exact hdrop
  have hpairQ : Q.mult (some z) (some p) =
      (G.induce S).mult z p + 1 := by
    change (G.induce S + singleEdge z p).mult z p = _
    simp [add_mult, singleEdge_mult, hzp]
  have hpairD :
      (((Q.deleteIncidence none).deleteIncidence (some t)).mult
        (some z) (some p)) = Q.mult (some z) (some p) := by
    simp [hzt, hpt]
  by_cases hMpair : M.Adj (some z) (some p)
  · left
    have hPpair : (Q.ofUnderlyingSubgraph M).mult
        (some z) (some p) = 1 := by
      simp [ofUnderlyingSubgraph, ofSimple_mult, hMpair]
    have hHpair : H.mult (some z) (some p) = (G.induce S).mult z p := by
      rw [hHdef]
      change (((Q.deleteIncidence none).deleteIncidence (some t)).mult
          (some z) (some p)) -
        (Q.ofUnderlyingSubgraph M).mult (some z) (some p) = _
      rw [hpairD, hPpair, hpairQ]
      omega
    have hDB : D.IsPart (G.induce S) :=
      isPart_left_of_isPart_add_of_mult_le hDpart (by
        change H.mult (some z) (some p) ≤ (G.induce S).mult z p
        rw [hHpair])
    refine ⟨extendFrom S D, extendFrom_isPart hDB, ?_, ?_⟩
    · refine ⟨z, ?_⟩
      rw [degree_extendFrom_of_mem S D z z.2, hDdegree]
      exact hHold z hzt
    · intro v
      by_cases hv : v ∈ S
      · rw [degree_extendFrom_of_mem S D v hv, hDdegree]
        by_cases hvt : (⟨v, hv⟩ : S) = t
        · rw [hvt, hHt]
          exact .inl rfl
        · exact .inr (hHold ⟨v, hv⟩ hvt)
      · exact .inl (degree_extendFrom_of_notMem S D v hv)
  · right
    have hPpair : (Q.ofUnderlyingSubgraph M).mult
        (some z) (some p) = 0 := by
      simp [ofUnderlyingSubgraph, ofSimple_mult, hMpair]
    have hHpair : H.mult (some z) (some p) =
        (G.induce S).mult z p + 1 := by
      rw [hHdef]
      change (((Q.deleteIncidence none).deleteIncidence (some t)).mult
          (some z) (some p)) -
        (Q.ofUnderlyingSubgraph M).mult (some z) (some p) = _
      rw [hpairD, hPpair, hpairQ]
      omega
    let F := D.removeSingleEdge z p
    have hFpart : F.IsPart (G.induce S) :=
      removeSingleEdge_isPart_left hDpart
    have hpos : 0 < D.mult z p := by
      change 0 < H.mult (some z) (some p)
      rw [hHpair]
      omega
    have hFdegree (v : S) :
        F.degree v + (singleEdge z p).degree v = D.degree v := by
      simpa [F, degree_singleEdge, Nat.add_assoc] using
        degree_removeSingleEdge_add D z p v hpos
    have hdegrees (v : Option S) : H.degree v = 0 ∨ H.degree v = 3 := by
      cases v with
      | none => exact .inl hHcenter
      | some v =>
          by_cases hvt : v = t
          · exact .inl (hvt ▸ hHt)
          · exact .inr (hHold v hvt)
    refine ⟨H, F, hHQ, ⟨z, hHold z hzt⟩, hdegrees,
      hFpart, ?_, hHcenter, ?_⟩
    · intro v
      simp only [hybridClosingDegree, Bool.true_eq, if_true,
        hybridStarDegree, Nat.add_zero]
      rw [hFdegree, hDdegree]
    · intro v
      simpa [hybridStarDegree] using hstarZero v

/-- Minimality of the chosen bipartite six-shore forces both endpoints of
the artificial pair into the old-vertex complement of every residual Hall
six-cut.  Otherwise the complement transfers to a strictly smaller
nontrivial bipartite six-shore of the original graph. -/
lemma hallSixCut_pair_mem_compl
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (hno2 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity T ≠ 2)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1)
    (M : MinimalBipartiteSixShore G)
    (E : Fin 6 ≃ CrossingEdge (ofSimple G) M.shore)
    (A B : Finset M.shore)
    (hbip : ((ofSimple G).induce M.shore).IsBipartiteWith A B)
    (hinj : Function.Injective (sixPairEndpoint E))
    (i : Fin 4) (X : Finset (Option M.shore))
    (hcut : ((ofSimple G).imbalancedSixClosure M.shore E).boundaryMultiplicity X = 6)
    (hcenter : none ∈ X)
    (ht : some (sixPairEndpoint E (finFourMiddleLabel i)) ∉ X)
    (hother : ∀ j : Fin 4, j ≠ i →
      some (sixPairEndpoint E (finFourMiddleLabel j)) ∈ X)
    (hneighbors : ∀ v : M.shore,
      ((ofSimple G).induce M.shore).toSimple.Adj
        (sixPairEndpoint E (finFourMiddleLabel i)) v → some v ∉ X) :
    some (sixPairEndpoint E 0) ∉ X ∧
      some (sixPairEndpoint E 5) ∉ X := by
  classical
  letI : DecidableEq (Option M.shore) := Classical.decEq _
  let P := ofSimple G
  let Q := P.imbalancedSixClosure M.shore E
  let t := sixPairEndpoint E (finFourMiddleLabel i)
  let U : Finset M.shore := Finset.univ.filter fun v ↦ some v ∉ X
  let Y : Finset (Option M.shore) := U.map Function.Embedding.some
  let T : Finset W := U.map (Function.Embedding.subtype _)
  have hXY : Xᶜ = Y := by
    ext x
    cases x with
    | none => simp [Y, hcenter]
    | some x => simp [Y, U]
  have hYcut : Q.boundaryMultiplicity Y = 6 := by
    have hc := Q.boundaryMultiplicity_compl X
    rw [hXY] at hc
    exact hc.trans (by simpa [Q, P] using hcut)
  have htU : t ∈ U := by simp [U, t, ht]
  have hNsub : (P.induce M.shore).toSimple.neighborFinset t ⊆ U := by
    intro v hv
    have htv : (P.induce M.shore).toSimple.Adj t v := by
      simpa only [SimpleGraph.mem_neighborFinset] using hv
    simp [U, hneighbors v htv]
  have htN : t ∉ (P.induce M.shore).toSimple.neighborFinset t := by
    simp
  have hNcard : ((P.induce M.shore).toSimple.neighborFinset t).card = 3 := by
    rw [SimpleGraph.card_neighborFinset_eq_degree]
    exact degree_induce_eq_three_of_sixPairEndpoint_injective
      P ((isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
        (by
          constructor
          · intro v
            simp [P]
          · intro u v
            simp only [P, ofSimple_mult]
            split_ifs <;> omega)
        M.shore E hinj (finFourMiddleLabel i)
  have hUfour : 4 ≤ U.card := by
    have hsub : insert t ((P.induce M.shore).toSimple.neighborFinset t) ⊆ U := by
      intro v hv
      rcases Finset.mem_insert.mp hv with rfl | hv
      · exact htU
      · exact hNsub hv
    have hc := Finset.card_le_card hsub
    rw [Finset.card_insert_of_notMem htN, hNcard] at hc
    exact hc
  let j : Fin 4 := ![1, 0, 0, 0] i
  have hji : j ≠ i := by fin_cases i <;> decide
  have hjX : some (sixPairEndpoint E (finFourMiddleLabel j)) ∈ X :=
    hother j hji
  have hjNotU : sixPairEndpoint E (finFourMiddleLabel j) ∉ U := by
    simp [U, hjX]
  have hUproper : U.card < M.shore.card := by
    have hlt : U.card < (Finset.univ : Finset M.shore).card :=
      Finset.card_lt_card ⟨Finset.subset_univ U, by
      intro hsub
      exact hjNotU (hsub (Finset.mem_univ _))⟩
    simpa using hlt
  have hTcard : T.card = U.card := by simp [T, Finset.card_map]
  have hTsub : T ⊆ M.shore := by
    intro x hx
    obtain ⟨v, _hv, rfl⟩ := Finset.mem_map.mp hx
    exact v.2
  have hTbip : IsBipartiteOn G T :=
    M.bipartite.mono hTsub
  have hTnontrivial : T.card ≠ 2 := by omega
  have hPReg : P.IsRegularOfDegree 4 :=
    (isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  by_contra hpair
  have hpairU : ¬ (sixPairEndpoint E 0 ∈ U ∧
      sixPairEndpoint E 5 ∈ U) := by
    intro hboth
    apply hpair
    exact ⟨by simpa [U] using hboth.1,
      by simpa [U] using hboth.2⟩
  have hTcut : P.boundaryMultiplicity T = 6 := by
    have htransfer :=
      boundaryMultiplicity_imbalancedSixClosure_map_some_of_pair_not_internal
        P hPReg M.shore E U hpairU
    change Q.boundaryMultiplicity Y = P.boundaryMultiplicity T at htransfer
    rw [← htransfer]
    exact hYcut
  have hminimal := M.minimal T hTcut hTbip hTnontrivial
  omega

lemma between_center_map_some_eq_card_middle_inter
    (G : Pseudograph W) (S : Finset W)
    (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (U : Finset S) :
    (G.imbalancedSixClosure S E).betweenMultiplicity {none}
        (U.map Function.Embedding.some) =
      (U ∩ imbalancedMiddleFinset E).card := by
  classical
  letI : DecidableEq (Option S) := Classical.decEq _
  let Q := G.imbalancedSixClosure S E
  let fmid : Fin 4 → S := fun j ↦
    sixPairEndpoint E (finFourMiddleLabel j)
  have hfmid : Function.Injective fmid := by
    intro j k hjk
    apply finFourMiddleLabel_injective
    exact hinj hjk
  have hnone : (none : Option S) ∉ U.map Function.Embedding.some := by simp
  rw [Q.betweenMultiplicity_singleton none
    (U.map Function.Embedding.some) hnone]
  rw [Finset.sum_map]
  change (∑ v ∈ U, fourEndpointCount fmid v) = _
  calc
    (∑ v ∈ U, fourEndpointCount fmid v) =
        ∑ v ∈ U, if v ∈ imbalancedMiddleFinset E then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro v _hv
      by_cases hvM : v ∈ imbalancedMiddleFinset E
      · rw [if_pos hvM]
        obtain ⟨j, hj⟩ := (mem_imbalancedMiddleFinset E v).mp hvM
        rw [← hj]
        exact fourEndpointCount_eq_one_of_injective fmid hfmid j
      · rw [if_neg hvM]
        apply fourEndpointCount_eq_zero_of_ne
        intro j hj
        exact hvM ((mem_imbalancedMiddleFinset E v).mpr ⟨j, hj⟩)
    _ = (U ∩ imbalancedMiddleFinset E).card := by
      simpa [Finset.filter_mem_eq_inter] using
        (Finset.sum_boole (fun v ↦ v ∈ imbalancedMiddleFinset E) U)

/-- Adding the center to an old block containing exactly two of the four
star endpoints does not change its hybrid boundary.  If the paired label
`0` is absent, this boundary therefore transfers unchanged to the original
graph. -/
lemma boundaryMultiplicity_centeredMiddlePair_transfer
    (G : Pseudograph W) (hreg : G.IsRegularOfDegree 4)
    (S : Finset W) (E : Fin 6 ≃ CrossingEdge G S)
    (hinj : Function.Injective (sixPairEndpoint E))
    (U : Finset S) (hzero : sixPairEndpoint E 0 ∉ U)
    (hmiddle : (U ∩ imbalancedMiddleFinset E).card = 2) :
    (G.imbalancedSixClosure S E).boundaryMultiplicity
        (insert none (U.map Function.Embedding.some)) =
      G.boundaryMultiplicity
        (U.map (Function.Embedding.subtype _)) := by
  classical
  let Q := G.imbalancedSixClosure S E
  let Y := U.map Function.Embedding.some
  have hQreg : Q.IsRegularOfDegree 4 :=
    imbalancedSixClosure_isRegularOfDegree G hreg S E
  have hdis : Disjoint ({none} : Finset (Option S)) Y := by simp [Y]
  have hbetween : Q.betweenMultiplicity {none} Y = 2 := by
    rw [between_center_map_some_eq_card_middle_inter G S E hinj U,
      hmiddle]
  have hsingle : Q.boundaryMultiplicity {none} = 4 := by
    have hloop : Q.mult none none = 0 := by
      simp [Q, imbalancedSixClosure]
    have hledger := Q.regular_card_eq_two_internal_add_boundary
      hQreg ({none} : Finset (Option S))
    rw [Q.internalMultiplicity_singleton none, hloop] at hledger
    simpa using hledger.symm
  have htoggle := Q.boundaryMultiplicity_union_add_two_between
    hQreg ({none} : Finset (Option S)) Y hdis
  have hmap := boundaryMultiplicity_imbalancedSixClosure_map_some
    G hreg S E U hzero
  have hunionInsert :
      (letI : DecidableEq (Option S) := Classical.decEq _;
        ({none} : Finset (Option S)) ∪ Y) = insert none Y := by
    ext x
    simp
  change Q.boundaryMultiplicity (insert none Y) = _
  have htoggle' : Q.boundaryMultiplicity (insert none Y) +
      2 * Q.betweenMultiplicity {none} Y =
      Q.boundaryMultiplicity {none} + Q.boundaryMultiplicity Y := by
    rw [← hunionInsert]
    exact htoggle
  rw [hbetween, hsingle] at htoggle'
  change Q.boundaryMultiplicity Y = _ at hmap
  omega

/-- The imbalanced half of Proposition 3.6.  Two failed residual matchings
give Hall six-cuts for the first two middle endpoints.  Their diagonal
intersection contains exactly the other two middle endpoints, while the
diagonal intersection of their complements contains the artificial pair.
Boundary transfer and minimality give respective hybrid lower bounds eight
and six, contradicting cut submodularity (`14 ≤ 12`). -/
lemma containsRegularPart_or_centerIsolatedWitness_of_imbalancedMinimalShore
    (G : SimpleGraph W) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity T ≠ 2)
    (hno4 : ∀ T : Finset W, T.Nonempty → T ≠ Finset.univ →
      (ofSimple G).boundaryMultiplicity T = 4 →
        T.card = 1 ∨ Tᶜ.card = 1)
    (M : MinimalBipartiteSixShore G)
    (E : Fin 6 ≃ CrossingEdge (ofSimple G) M.shore)
    (A B : Finset M.shore)
    (hbip : ((ofSimple G).induce M.shore).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card)
    (h₀ : sixPairEndpoint E 0 ∈ A)
    (h₁ : sixPairEndpoint E 1 ∈ B)
    (h₂ : sixPairEndpoint E 2 ∈ B)
    (h₃ : sixPairEndpoint E 3 ∈ B)
    (h₄ : sixPairEndpoint E 4 ∈ B)
    (h₅ : sixPairEndpoint E 5 ∈ B)
    (hinj : Function.Injective (sixPairEndpoint E)) :
    (ofSimple G).ContainsRegularPart 3 ∨
      ∃ H : Pseudograph (Option M.shore), ∃ F : Pseudograph M.shore,
        H.IsPart ((ofSimple G).imbalancedSixClosure M.shore E) ∧
        (∃ v : M.shore, H.degree (some v) = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        HybridClosureDecomposition E H none true F := by
  classical
  let P := ofSimple G
  let Q := P.imbalancedSixClosure M.shore E
  let fmid : Fin 4 → M.shore := fun j ↦
    sixPairEndpoint E (finFourMiddleLabel j)
  have hPReg : P.IsRegularOfDegree 4 :=
    (isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hPsimple : P.HasSimpleMultiplicities := by
    constructor
    · intro v
      simp [P]
    · intro u v
      simp only [P, ofSimple_mult]
      split_ifs <;> omega
  have hfmid : Function.Injective fmid := by
    intro j k hjk
    apply finFourMiddleLabel_injective
    exact hinj hjk
  have hcase₀ := exists_residualTransversal_or_hallSixCut
    P hPReg hPsimple M.shore E A B hbip hcard
      h₀ h₁ h₂ h₃ h₄ h₅ hinj 0
  rcases hcase₀ with htrans₀ | ⟨X₀, hcut₀, hc₀, ht₀, hother₀, hneighbors₀⟩
  · obtain ⟨f, hf, hadj⟩ := htrans₀
    exact containsRegularPart_or_centerIsolatedWitness_of_residualTransversal
      P hPReg hPsimple M.shore E A B hbip hcard
        h₀ h₁ h₂ h₃ h₄ h₅ hinj 0 f hf hadj
  have hcase₁ := exists_residualTransversal_or_hallSixCut
    P hPReg hPsimple M.shore E A B hbip hcard
      h₀ h₁ h₂ h₃ h₄ h₅ hinj 1
  rcases hcase₁ with htrans₁ | ⟨X₁, hcut₁, hc₁, ht₁, hother₁, hneighbors₁⟩
  · obtain ⟨f, hf, hadj⟩ := htrans₁
    exact containsRegularPart_or_centerIsolatedWitness_of_residualTransversal
      P hPReg hPsimple M.shore E A B hbip hcard
        h₀ h₁ h₂ h₃ h₄ h₅ hinj 1 f hf hadj
  exfalso
  have hpair₀ := hallSixCut_pair_mem_compl G hreg hno2 hno4
    M E A B hbip hinj 0 X₀ hcut₀ hc₀ ht₀ hother₀ hneighbors₀
  have hpair₁ := hallSixCut_pair_mem_compl G hreg hno2 hno4
    M E A B hbip hinj 1 X₁ hcut₁ hc₁ ht₁ hother₁ hneighbors₁
  let Y₁ : Finset (Option M.shore) := X₀ ∩ X₁
  let Y₂ : Finset (Option M.shore) := X₀ᶜ ∩ X₁ᶜ
  let U₁ : Finset M.shore := Finset.univ.filter fun v ↦ some v ∈ Y₁
  let U₂ : Finset M.shore := Finset.univ.filter fun v ↦ some v ∈ Y₂
  let T₁ : Finset W := U₁.map (Function.Embedding.subtype _)
  let T₂ : Finset W := U₂.map (Function.Embedding.subtype _)
  have hY₁ : Y₁ = insert none (U₁.map Function.Embedding.some) := by
