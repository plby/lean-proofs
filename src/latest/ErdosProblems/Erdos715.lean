      rw [Finset.card_insert_of_notMem (fun h ↦
        ht₁notN₁ (Finset.mem_of_mem_erase h))] at hc
      omega
    have mappedLower (U : Finset M.shore) (hthree : 3 ≤ U.card)
        (hz : sixPairEndpoint E 0 ∉ U)
        (hp : sixPairEndpoint E 5 ∉ U) :
        8 ≤ P.boundaryMultiplicity
          (U.map (Function.Embedding.subtype _)) := by
      let T : Finset W := U.map (Function.Embedding.subtype _)
      have hTcard : T.card = U.card := by simp [T, Finset.card_map]
      have hTnonempty : T.Nonempty := Finset.card_pos.mp (by omega)
      have hTproper : T ≠ Finset.univ := by
        intro hTuniv
        have hzT : (sixPairEndpoint E 0 : W) ∈ T := by
          rw [hTuniv]
          simp
        obtain ⟨v, hvU, hv⟩ := Finset.mem_map.mp hzT
        have hvz : v = sixPairEndpoint E 0 := Subtype.ext hv
        exact hz (hvz ▸ hvU)
      have hzp : (sixPairEndpoint E 0 : W) ≠ sixPairEndpoint E 5 := by
        intro h
        exact (by decide : (0 : Fin 6) ≠ 5)
          (hinj (Subtype.ext h))
      have hzT : (sixPairEndpoint E 0 : W) ∉ T := by
        intro h
        obtain ⟨v, hvU, hv⟩ := Finset.mem_map.mp h
        have hvz : v = sixPairEndpoint E 0 := Subtype.ext hv
        exact hz (hvz ▸ hvU)
      have hpT : (sixPairEndpoint E 5 : W) ∉ T := by
        intro h
        obtain ⟨v, hvU, hv⟩ := Finset.mem_map.mp h
        have hvp : v = sixPairEndpoint E 5 := Subtype.ext hv
        exact hp (hvp ▸ hvU)
      have hTcompTwo : 2 ≤ Tᶜ.card := by
        have hsub : ({(sixPairEndpoint E 0 : W),
            (sixPairEndpoint E 5 : W)} : Finset W) ⊆ Tᶜ := by
          intro v hv
          simp only [Finset.mem_insert, Finset.mem_singleton] at hv
          apply Finset.mem_compl.mpr
          rcases hv with rfl | rfl
          · exact hzT
          · exact hpT
        have hc := Finset.card_le_card hsub
        simpa [hzp] using hc
      have hTsub : T ⊆ M.shore := by
        intro x hx
        obtain ⟨v, _hv, rfl⟩ := Finset.mem_map.mp hx
        exact v.2
      have hTbip : IsBipartiteOn G T := M.bipartite.mono hTsub
      have hTlt : T.card < M.shore.card := by
        have hUproper : U.card < (Finset.univ : Finset M.shore).card :=
          Finset.card_lt_card ⟨Finset.subset_univ U, by
            intro hsub
            exact hz (hsub (Finset.mem_univ _))⟩
        simpa [hTcard] using hUproper
      exact lower T hTnonempty hTproper hTcompTwo (by omega)
        hTbip hTlt (fun _ htwo ↦ by omega)
    have hQZ₀ : Q.boundaryMultiplicity Z₀ =
        P.boundaryMultiplicity R₀ := by
      rw [hZ₀]
      simpa [R₀] using boundaryMultiplicity_imbalancedSixClosure_map_some
        P hPReg M.shore E V₀ hzeroV₀
    have hQZ₁ : Q.boundaryMultiplicity Z₁ =
        P.boundaryMultiplicity R₁ := by
      rw [hZ₁]
      simpa [R₁] using boundaryMultiplicity_imbalancedSixClosure_map_some
        P hPReg M.shore E V₁ hzeroV₁
    have hlowerZ₀ : 8 ≤ Q.boundaryMultiplicity Z₀ := by
      rw [hQZ₀]
      exact mappedLower V₀ hV₀three hzeroV₀ hfiveV₀
    have hlowerZ₁ : 8 ≤ Q.boundaryMultiplicity Z₁ := by
      rw [hQZ₁]
      exact mappedLower V₁ hV₁three hzeroV₁ hfiveV₁
    let XC : Finset (Option M.shore) := X₀ᶜ
    have hcross :=
      Q.boundaryMultiplicity_inter_add_compl_inter_compl_le XC X₁
    have hfirst :
        (letI : DecidableEq (Option M.shore) := Classical.decEq _;
          XC ∩ X₁) = Z₀ := by
      ext x
      simp [XC, Z₀]
    have hsecond :
        (letI : DecidableEq (Option M.shore) := Classical.decEq _;
          XCᶜ ∩ X₁ᶜ) = Z₁ := by
      ext x
      simp [XC, Z₁]
    have hXCcut : Q.boundaryMultiplicity XC = 6 := by
      have hcompl :
          (letI : DecidableEq (Option M.shore) := Classical.decEq _;
            X₀ᶜ) = XC := by
        ext x
        simp [XC]
      rw [← hcompl]
      exact (Q.boundaryMultiplicity_compl X₀).trans hcut₀
    rw [hfirst, hsecond, hXCcut, hcut₁] at hcross
    omega

/-- The imbalanced case of Proposition 3.6 for the vertex-minimal bad
pseudograph.  A reindexing makes the opposite hybrid closure eligible for
induction; the preceding two-defect lemma supplies the one missing local
decomposition pattern, and hybrid six-cut gluing contradicts minimality. -/
lemma IsVertexMinimalCounterexample.false_of_imbalanced_minimalBipartiteSixShore
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities)
    (M : MinimalBipartiteSixShore G.toSimple)
    (A B : Finset M.shore)
    (hbip : ((ofSimple G.toSimple).induce M.shore).IsBipartiteWith A B)
    (hcard : A.card + 1 = B.card) : False := by
  let finDecEq : DecidableEq (Fin n) := inferInstance
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  let P := ofSimple G.toSimple
  have hPG : P = G :=
    eq_ofSimple_toSimple_of_hasSimpleMultiplicities G hsimple
  have hregP : P.IsRegularOfDegree 4 := by
    simpa only [hPG] using hmin.in_class.1
  have hreg : G.toSimple.IsRegularOfDegree 4 :=
    (isRegularOfDegree_ofSimple_iff G.toSimple 4).mp hregP
  have hconn : G.toSimple.Connected := hmin.underlying_connected
  have hno2G := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple
  have hno2 : ∀ T : Finset (Fin n), T.Nonempty → T ≠ Finset.univ →
      P.boundaryMultiplicity T ≠ 2 := by
    simpa only [hPG] using hno2G
  have hno4G :=
    hmin.only_trivial_four_cuts_of_hasSimpleMultiplicities hsimple
  have hno4 : ∀ T : Finset (Fin n), T.Nonempty → T ≠ Finset.univ →
      P.boundaryMultiplicity T = 4 → T.card = 1 ∨ Tᶜ.card = 1 := by
    intro T hT hTproper hcut
    have hcutG : G.boundaryMultiplicity T = 4 := by
      simpa only [hPG] using hcut
    rcases hno4G T hT hTproper hcutG with hcard | hcard
    · exact Or.inl hcard
    · apply Or.inr
      have hcompl :
          (letI : DecidableEq (Fin n) := finDecEq; Tᶜ) = Tᶜ := by
        ext x
        simp
      rw [← hcompl]
      exact hcard
  let E₀ : Fin 6 ≃ CrossingEdge P M.shore :=
    (P.cutEquiv M.shore M.cut).symm
  have hcases := bipartiteSixShore_card_and_labelCount_cases
    P hregP M.shore M.cut E₀ A B hbip
  have hcounts : sixLabelCount E₀ A = 1 ∧ sixLabelCount E₀ B = 5 := by
    rcases hcases with hbalanced | himbalanced | himbalanced
    · omega
    · exact himbalanced.2
    · omega
  have hcover : ∀ v : M.shore, v ∈ A ∨ v ∈ B := by
    intro v
    by_cases hvA : v ∈ A
    · exact .inl hvA
    · exact .inr (hbip.mem_right_of_not_mem_left hvA)
  obtain ⟨E, hE₀, hE₁, hE₂, hE₃, hE₄, hE₅⟩ :=
    exists_oneFiveSixCutListing E₀ A B hbip.disjoint hcover
      hcounts.1 hcounts.2
  have hinjE : Function.Injective (sixPairEndpoint E) :=
    M.cutEndpoints_injective hreg (by simpa [P] using hno2)
      (by simpa [P] using hno4) E
  have hPsimple : P.HasSimpleMultiplicities := by
    simpa only [hPG] using hsimple
  have hCsimple : (P.induce M.shoreᶜ).HasSimpleMultiplicities :=
    P.induce_hasSimpleMultiplicities hPsimple M.shoreᶜ
  obtain ⟨p, hp0, hpnonzero, hCclass⟩ :=
    exists_middleReindex_oppositeImbalancedClosure_inTashkinovClass
      P hregP M.shore E hCsimple
  let E' : Fin 6 ≃ CrossingEdge P M.shore := p.trans E
  have hBnonzero (j : Fin 6) (hj : j ≠ 0) : sixPairEndpoint E j ∈ B := by
    fin_cases j <;> simp_all
  have hE'₀ : sixPairEndpoint E' 0 ∈ A := by
    change sixPairEndpoint E (p 0) ∈ A
    simpa [hp0] using hE₀
  have hE'B (j : Fin 6) (hj : j ≠ 0) : sixPairEndpoint E' j ∈ B := by
    change sixPairEndpoint E (p j) ∈ B
    exact hBnonzero (p j) (hpnonzero j hj)
  have hE'₁ : sixPairEndpoint E' 1 ∈ B := hE'B 1 (by decide)
  have hE'₂ : sixPairEndpoint E' 2 ∈ B := hE'B 2 (by decide)
  have hE'₃ : sixPairEndpoint E' 3 ∈ B := hE'B 3 (by decide)
  have hE'₄ : sixPairEndpoint E' 4 ∈ B := hE'B 4 (by decide)
  have hE'₅ : sixPairEndpoint E' 5 ∈ B := hE'B 5 (by decide)
  have hinjE' : Function.Injective (sixPairEndpoint E') := by
    intro i j hij
    apply p.injective
    apply hinjE
    exact hij
  have hisolated :
      ∃ H : Pseudograph (Option M.shore), ∃ F : Pseudograph M.shore,
        H.IsPart (P.imbalancedSixClosure M.shore E') ∧
        (∃ v : M.shore, H.degree (some v) = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        HybridClosureDecomposition E' H none true F := by
    rcases containsRegularPart_or_centerIsolatedWitness_of_imbalancedMinimalShore
        G.toSimple hreg hconn (by simpa [P] using hno2)
          (by simpa [P] using hno4) M E' A B hbip hcard
          hE'₀ hE'₁ hE'₂ hE'₃ hE'₄ hE'₅ hinjE' with hcubic | hwitness
    · exfalso
      apply hmin.no_cubic_part
      rw [← hPG]
      exact hcubic
    · exact hwitness
  have hlocal : ∀ active : Option (Fin 4), ∀ usePair : Bool,
      active ≠ none ∨ usePair = true →
      ∃ H : Pseudograph (Option M.shore), ∃ F : Pseudograph M.shore,
        H.IsPart (P.imbalancedSixClosure M.shore E') ∧
        (∃ v : M.shore, H.degree (some v) = 3) ∧
        (∀ v, H.degree v = 0 ∨ H.degree v = 3) ∧
        HybridClosureDecomposition E' H active usePair F := by
    intro active usePair hnonzero
    cases active with
    | none =>
        have htrue : usePair = true := hnonzero.resolve_left (by simp)
        subst usePair
        exact hisolated
    | some i =>
        exact exists_centerActive_hybridClosureWitness
          P hregP hPsimple hno4 M.shore E' A B hbip hcard
            hE'₀ hE'₁ hE'₂ hE'₃ hE'₄ hE'₅ hinjE' i usePair
  have hCnonempty : M.shoreᶜ.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hempty
    exact M.shore_ne_univ ((Finset.compl_eq_empty_iff M.shore).mp hempty)
  letI : Nonempty ↑(M.shoreᶜ) :=
    ⟨⟨hCnonempty.choose, hCnonempty.choose_spec⟩⟩
  have hcardsum : M.shore.card + M.shoreᶜ.card = n := by
    simpa using Finset.card_add_card_compl M.shore
  have hCcard : Fintype.card ↑(M.shoreᶜ) < n := by
    rw [Fintype.card_coe]
    have hScard := M.four_le_card hreg
    omega
  have hCclosureCard : Fintype.card (Option ↑(M.shoreᶜ)) < n := by
    rw [Fintype.card_option, Fintype.card_coe]
    have hScard := M.four_le_card hreg
    omega
  have hCpart :
      (P.imbalancedSixClosure M.shoreᶜ
        (reverseSixCutListing E')).ContainsRegularPart 3 :=
    hmin.contains_of_card_lt _ (by simpa only [E'] using hCclass)
      hCclosureCard
  have hspliced := P.containsRegularPart_of_imbalancedSixClosuresWith
    M.shore E' hinjE' hlocal hCpart
  apply hmin.no_cubic_part
  simpa only [hPG] using hspliced

/-- Proposition 3.6 for the vertex-minimal bad graph: every bipartite
six-shore is the trivial two-vertex shore. -/
theorem IsVertexMinimalCounterexample.hasNoNontrivialBipartiteSixShore
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities) :
    HasNoNontrivialBipartiteSixShore G.toSimple := by
  classical
  by_contra hnot
  letI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  obtain ⟨M⟩ := exists_minimalBipartiteSixShore G.toSimple hnot
  obtain ⟨A, B, hbip⟩ :=
    exists_isBipartiteWith_induce_of_isBipartiteOn
      G.toSimple M.shore M.bipartite
  have hPG : ofSimple G.toSimple = G :=
    eq_ofSimple_toSimple_of_hasSimpleMultiplicities G hsimple
  have hregP : (ofSimple G.toSimple).IsRegularOfDegree 4 := by
    simpa only [hPG] using hmin.in_class.1
  let E : Fin 6 ≃ CrossingEdge (ofSimple G.toSimple) M.shore :=
    ((ofSimple G.toSimple).cutEquiv M.shore M.cut).symm
  rcases bipartiteSixShore_card_and_labelCount_cases
      (ofSimple G.toSimple) hregP M.shore M.cut E A B hbip with
    hbalanced | himbalanced | himbalanced
  · exact false_of_balanced_minimalBipartiteSixShore
      hmin hsimple M A B hbip hbalanced.1
  · exact false_of_imbalanced_minimalBipartiteSixShore
      hmin hsimple M A B hbip himbalanced.1
  · exact false_of_imbalanced_minimalBipartiteSixShore
      hmin hsimple M B A hbip.swap himbalanced.1

end Pseudograph

/-! ### The type-A barrier and the triangle exclusion

The first part of Section 4 of Tashkinov's proof uses the full Tutte
certificate before six-cuts have been eliminated.  A type-A certificate has
one residual odd six-component and exactly one edge in its middle shore. -/

structure TypeABarrier (G : SimpleGraph V) (u : V) where
  left : Finset V
  middle : Finset V
  right : Finset V
  distinguished_mem_left : u ∈ left
  neighbor_mem_middle : ∀ {v : V}, G.Adj u v → v ∈ middle
  left_middle_disjoint : Disjoint left middle
  left_right_disjoint : Disjoint left right
  middle_right_disjoint : Disjoint middle right
  cover : left ∪ middle ∪ right = Finset.univ
  left_independent : G.IsIndepSet (left : Set V)
  left_right_nonadjacent : ∀ {x y : V}, x ∈ left → y ∈ right → ¬ G.Adj x y
  middle_internal :
    (Pseudograph.ofSimple G).internalMultiplicity middle = 1
  right_boundary :
    (Pseudograph.ofSimple G).boundaryMultiplicity right = 6
  right_odd : Odd right.card

namespace TypeABarrier

lemma disjoint_left_middle {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : Disjoint B.left B.middle :=
  B.left_middle_disjoint

lemma disjoint_left_right {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : Disjoint B.left B.right :=
  B.left_right_disjoint

lemma disjoint_middle_right {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : Disjoint B.middle B.right :=
  B.middle_right_disjoint

lemma middle_union_right_eq_left_compl {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : B.middle ∪ B.right = B.leftᶜ := by
  classical
  ext x
  have hcover := Finset.ext_iff.mp B.cover x
  have hLM := Finset.disjoint_left.mp B.disjoint_left_middle
  have hLR := Finset.disjoint_left.mp B.disjoint_left_right
  simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hcover
  simp only [Finset.mem_union, Finset.mem_compl]
  tauto

lemma left_union_right_eq_middle_compl {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : B.left ∪ B.right = B.middleᶜ := by
  classical
  ext x
  have hcover := Finset.ext_iff.mp B.cover x
  have hLM := Finset.disjoint_left.mp B.disjoint_left_middle
  have hMR := Finset.disjoint_left.mp B.disjoint_middle_right
  simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hcover
  simp only [Finset.mem_union, Finset.mem_compl]
  tauto

lemma middle_union_left_eq_right_compl {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : B.middle ∪ B.left = B.rightᶜ := by
  classical
  ext x
  have hcover := Finset.ext_iff.mp B.cover x
  have hMR := Finset.disjoint_left.mp B.disjoint_middle_right
  have hLR := Finset.disjoint_left.mp B.disjoint_left_right
  simp only [Finset.mem_union, Finset.mem_univ, iff_true] at hcover
  simp only [Finset.mem_union, Finset.mem_compl]
  tauto

lemma between_middle_right_eq_six {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) :
    (Pseudograph.ofSimple G).betweenMultiplicity B.middle B.right = 6 := by
  classical
  let P := Pseudograph.ofSimple G
  have hzero : P.betweenMultiplicity B.right B.left = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    exact B.left_right_nonadjacent hy hx hxy.symm
  have hdis : Disjoint B.right (B.middle ∪ B.left) :=
    Finset.disjoint_union_right.mpr
      ⟨B.middle_right_disjoint.symm, B.left_right_disjoint.symm⟩
  have hsplit := P.betweenMultiplicity_union_right B.right B.middle B.left
    B.left_middle_disjoint.symm hdis
  have hcut := B.right_boundary
  change P.boundaryMultiplicity B.right = 6 at hcut
  rw [P.boundaryMultiplicity_eq_between_compl,
    ← B.middle_union_left_eq_right_compl] at hcut
  rw [hsplit, hzero, Nat.add_zero] at hcut
  exact (P.betweenMultiplicity_comm B.middle B.right).trans hcut

end TypeABarrier

/-- A type-A pattern has a unique residual component with boundary six. -/
lemma existsUnique_sixComponent_of_typeA_pattern
    (G : SimpleGraph V) (u : V) (X : Set (antiNeighborhood G u))
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .A) :
    ∃! c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c) = 6 := by
  classical
  let A := antiNeighborhood G u
  let J := (deleteInducedSubgraph G A X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X c)
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun c ↦ cut c = 6
  change _ ∧ C6.card = 1 ∧ _ at hpattern
  obtain ⟨c, hc⟩ := Finset.card_eq_one.mp hpattern.2.1
  refine ⟨c, ?_, ?_⟩
  · have : c ∈ C6 := by simp [hc]
    simpa [A, J, cut, C6] using this
  · intro d hd
    have hdmem : d ∈ C6 := by simpa [A, J, cut, C6] using hd
    simpa [hc] using hdmem

/-- Every residual component other than the unique six-component of a
type-A certificate is a singleton four-component. -/
lemma typeA_other_component_singleton
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V) (X : Set (antiNeighborhood G u))
    (hvalues : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      let cut := (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c)
      cut = 4 ∨ cut = 6 ∨ cut = 8)
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .A)
    (component :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent)
    (component_unique : ∀ c,
      (Pseudograph.ofSimple G).boundaryMultiplicity
          (deletedComponentShore G (antiNeighborhood G u) X c) = 6 →
        c = component)
    (c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent)
    (hc : c ≠ component) :
    (deletedComponentShore G (antiNeighborhood G u) X c).card = 1 := by
  classical
  let A := antiNeighborhood G u
  let D := ambientDeletionSet A X
  let S := deletedComponentShore G A X c
  let J := (deleteInducedSubgraph G A X).coe
  let cut : J.ConnectedComponent → ℕ := fun d ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G A X d)
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun d ↦ cut d = 8
  have hC8card : C8.card = 0 := by
    change _ ∧ _ ∧ C8.card = 0 at hpattern
    exact hpattern.2.2
  have hcut4 : (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 := by
    rcases hvalues c with h4 | h6 | h8
    · simpa [A, S] using h4
    · exact False.elim (hc (component_unique c (by simpa [A, S] using h6)))
    · have hc8 : c ∈ C8 := by simpa [A, J, cut, C8] using h8
      have : C8.Nonempty := ⟨c, hc8⟩
      rw [Finset.card_eq_zero.mp hC8card] at this
      simpa using this
  have hSnonempty : S.Nonempty := by
    simpa [S] using deletedComponentShore_nonempty G A X c
  have huD : u ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    simp [A, antiNeighborhood]
  obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
  have hvD : v ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    exact fun hvA ↦ hvA.2 huv
  have huSnot : u ∉ S := fun huS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) huS huD
  have hvSnot : v ∉ S := fun hvS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) hvS hvD
  have hSproper : S ≠ Finset.univ := by
    intro hS
    exact huSnot (by rw [hS]; simp)
  have hcompcard_ne_one : Sᶜ.card ≠ 1 := by
    intro hcard
    have hsubset : ({u, v} : Finset V) ⊆ Sᶜ := by
      intro w hw
      simp only [Finset.mem_insert, Finset.mem_singleton] at hw
      rcases hw with rfl | rfl
      · simp [huSnot]
      · simp [hvSnot]
    have htwo := Finset.card_le_card hsubset
    have : 2 ≤ Sᶜ.card := by simpa [huv.ne] using htwo
    omega
  rcases hno4 S hSnonempty hSproper hcut4 with hcard | hcard
  · simpa [A, S] using hcard
  · exact (hcompcard_ne_one hcard).elim

/-- Extract the concrete three-shore type-A barrier from the full Tutte
certificate. -/
theorem exists_typeABarrier_of_pattern
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V) (X : Set (antiNeighborhood G u))
    (hall : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents)
    (hvalues : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      let cut := (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c)
      cut = 4 ∨ cut = 6 ∨ cut = 8)
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .A) :
    Nonempty (TypeABarrier G u) := by
  classical
  obtain ⟨c, hc6, hcUnique⟩ :=
    existsUnique_sixComponent_of_typeA_pattern G u X hpattern
  let M := barrierMiddle G u X
  let R := deletedComponentShore G (antiNeighborhood G u) X c
  let L := (M ∪ R)ᶜ
  have hMR : Disjoint M R := by
    rw [Finset.disjoint_left]
    intro v hvM hvR
    have hvD : v ∈ ambientDeletionSet (antiNeighborhood G u) X := by
      rw [ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle]
      exact Finset.mem_insert_of_mem hvM
    exact (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet
        G (antiNeighborhood G u) X c)) hvR hvD
  have hLM : Disjoint L M := by
    rw [Finset.disjoint_left]
    intro v hvL hvM
    have hvnot : v ∉ M ∪ R := by simpa [L] using hvL
    exact hvnot (Finset.mem_union_left _ hvM)
  have hLR : Disjoint L R := by
    rw [Finset.disjoint_left]
    intro v hvL hvR
    have hvnot : v ∉ M ∪ R := by simpa [L] using hvL
    exact hvnot (Finset.mem_union_right _ hvR)
  have hcover : L ∪ M ∪ R = Finset.univ := by
    ext v
    by_cases hvM : v ∈ M
    · simp [hvM]
    by_cases hvR : v ∈ R
    · simp [hvR]
    · have hvL : v ∈ L := by simp [L, hvM, hvR]
      simp [hvL]
  have huL : u ∈ L := by
    simp only [L, Finset.mem_compl, Finset.mem_union, not_or]
    constructor
    · exact notMem_barrierMiddle_self G u X
    · intro huR
      have huD : u ∈ ambientDeletionSet (antiNeighborhood G u) X := by
        apply mem_ambientDeletionSet.mpr
        left
        simp [antiNeighborhood]
      exact (Finset.disjoint_left.mp
        (deletedComponentShore_disjoint_ambientDeletionSet
          G (antiNeighborhood G u) X c)) huR huD
  have hneighbor : ∀ {v : V}, G.Adj u v → v ∈ M := by
    intro v huv
    exact mem_barrierMiddle.mpr (.inl huv)
  have hLindependent : G.IsIndepSet (L : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    intro habG
    have haM : a ∉ M := by
      intro haM
      have : a ∉ M ∪ R := by simpa [L] using ha
      exact this (Finset.mem_union_left _ haM)
    have hbM : b ∉ M := by
      intro hbM
      have : b ∉ M ∪ R := by simpa [L] using hb
      exact this (Finset.mem_union_left _ hbM)
    have haR : a ∉ R := by
      intro haR
      have : a ∉ M ∪ R := by simpa [L] using ha
      exact this (Finset.mem_union_right _ haR)
    let A := antiNeighborhood G u
    let D := ambientDeletionSet A X
    have hD : D = insert u M := by
      simpa [A, D, M] using
        ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle G u X
    by_cases hau : a = u
    · subst a
      exact hbM (hneighbor habG)
    have haD : a ∉ D := by rw [hD]; simp [hau, haM]
    obtain ⟨d, had⟩ :=
      exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet G A X haD
    have hdne : d ≠ c := by
      intro hd
      subst d
      exact haR (by simpa [A, R] using had)
    have hsingleton := typeA_other_component_singleton G hreg hno4 u X
      hvalues hpattern c hcUnique d hdne
    have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
      simp [Pseudograph.ofSimple_mult, habG]
    rcases deletedComponentShore_closed G A X d had b habmult with hbd | hbD
    · obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hsingleton
      rw [hz] at had hbd
      have haz : a = z := by simpa using had
      have hbz : b = z := by simpa using hbd
      exact hab (haz.trans hbz.symm)
    · have hbu : b = u := by
        change b ∈ D at hbD
        rw [hD] at hbD
        simpa [hbM] using hbD
      subst b
      exact haM (hneighbor habG.symm)
  have hLRnonadjacent : ∀ {a b : V}, a ∈ L → b ∈ R → ¬ G.Adj a b := by
    intro a b ha hb habG
    have haM : a ∉ M := by
      intro haM
      have : a ∉ M ∪ R := by simpa [L] using ha
      exact this (Finset.mem_union_left _ haM)
    let A := antiNeighborhood G u
    let D := ambientDeletionSet A X
    have hD : D = insert u M := by
      simpa [A, D, M] using
        ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle G u X
    by_cases hau : a = u
    · subst a
      have hbM : b ∈ M := hneighbor habG
      exact (Finset.disjoint_left.mp hMR) hbM hb
    have haD : a ∉ D := by rw [hD]; simp [hau, haM]
    obtain ⟨d, had⟩ :=
      exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet G A X haD
    have hdne : d ≠ c := by
      intro hd
      subst d
      have haR : a ∈ R := by simpa [A, R] using had
      exact (Finset.disjoint_left.mp hLR) ha haR
    have hsingleton := typeA_other_component_singleton G hreg hno4 u X
      hvalues hpattern c hcUnique d hdne
    have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
      simp [Pseudograph.ofSimple_mult, habG]
    rcases deletedComponentShore_closed G A X d had b habmult with hbd | hbD
    · obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hsingleton
      rw [hz] at had hbd
      have habEq : a = b := by
        have haz : a = z := by simpa using had
        have hbz : b = z := by simpa using hbd
        exact haz.trans hbz.symm
      exact habG.ne habEq
    · have hdisj := deletedComponentShore_disjoint_ambientDeletionSet
        G A X c
      have hbD' : b ∈ ambientDeletionSet A X := by simpa [D] using hbD
      exact (Finset.disjoint_left.mp hdisj) (by simpa [A, R] using hb) hbD'
  have hMiddle : (Pseudograph.ofSimple G).internalMultiplicity M = 1 := by
    change (Pseudograph.ofSimple G).internalMultiplicity
        (barrierMiddle G u X) = 1
    exact hpattern.1
  have hRcut : (Pseudograph.ofSimple G).boundaryMultiplicity R = 6 := by
    simpa [R] using hc6
  have hRodd : Odd R.card := by
    have hcodd := hall c
    change Odd c.supp.ncard at hcodd
    simpa [R, card_deletedComponentShore G
      (antiNeighborhood G u) X c] using hcodd
  exact ⟨{
    left := L
    middle := M
    right := R
    distinguished_mem_left := huL
    neighbor_mem_middle := hneighbor
    left_middle_disjoint := hLM
    left_right_disjoint := hLR
    middle_right_disjoint := hMR
    cover := hcover
    left_independent := hLindependent
    left_right_nonadjacent := hLRnonadjacent
    middle_internal := hMiddle
    right_boundary := hRcut
    right_odd := hRodd }⟩

/-- If two neighbours of `u` are adjacent, every genuine Tutte barrier at
`u` is type A: its middle has a positive internal edge count, whereas types
B and C have none. -/
theorem exists_typeABarrier_of_adjacent_neighbors
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (u v w : V) (huv : G.Adj u v) (huw : G.Adj u w)
    (hvw : G.Adj v w)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    Nonempty (TypeABarrier G u) := by
  classical
  obtain ⟨X, hfull⟩ :=
    exists_antiNeighborhood_barrier_pattern_of_noPerfectMatching
      G hreg hodd hconn hno2 hno4 u hno
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c)
  change J.oddComponents.ncard = X.ncard + 2 ∧
    (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
    (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
    ∃ kind : BarrierKind,
      IsAntiNeighborhoodBarrierPattern G u X kind at hfull
  rcases hfull with ⟨_hq, hall, hvalues, kind, hpattern⟩
  have hvM : v ∈ barrierMiddle G u X := mem_barrierMiddle.mpr (.inl huv)
  have hwM : w ∈ barrierMiddle G u X := mem_barrierMiddle.mpr (.inl huw)
  have hpositive : 0 < (Pseudograph.ofSimple G).internalMultiplicity
      (barrierMiddle G u X) :=
    internalMultiplicity_pos_of_adj_mem G (barrierMiddle G u X)
      hvw hvM hwM
  have hkindA : kind = .A := by
    rcases kind with _ | _ | _ | _
    · rfl
    · change _ = 0 ∧ _ at hpattern
      omega
    · change _ = 0 ∧ _ at hpattern
      omega
    · exfalso
      exact (not_degenerate_antiNeighborhood_barrierPattern
        G hreg hno4 hindependentComplement u X hvalues) hpattern
  subst kind
  exact exists_typeABarrier_of_pattern G hreg hno4 u X hall hvalues hpattern

/-- An internal multiplicity-one shore has the displayed edge as its unique
internal edge. -/
lemma unique_internal_edge_of_eq_one
    (G : SimpleGraph V) (S : Finset V) {x y : V}
    (hcount : (Pseudograph.ofSimple G).internalMultiplicity S = 1)
    (hxy : G.Adj x y) (hx : x ∈ S) (hy : y ∈ S) :
    ∀ {a b : V}, G.Adj a b → a ∈ S → b ∈ S → s(a, b) = s(x, y) := by
  classical
  have hcard : (Pseudograph.internalEdgeFinset G S).card = 1 := by
    rw [Pseudograph.card_internalEdgeFinset, hcount]
  obtain ⟨e, he⟩ := Finset.card_eq_one.mp hcard
  have hxyMem : s(x, y) ∈ Pseudograph.internalEdgeFinset G S :=
    (Pseudograph.mem_internalEdgeFinset_mk_iff G S x y).mpr ⟨hxy, hx, hy⟩
  have hexy : e = s(x, y) := by
    have h : s(x, y) = e := by simpa [he] using hxyMem
    exact h.symm
  intro a b hab ha hb
  have habMem : s(a, b) ∈ Pseudograph.internalEdgeFinset G S :=
    (Pseudograph.mem_internalEdgeFinset_mk_iff G S a b).mpr ⟨hab, ha, hb⟩
  simpa [he, hexy] using habMem

/-- If two disjoint subblocks separate the unique internal edge of a shore,
exactly one edge joins the subblocks. -/
lemma betweenMultiplicity_eq_one_of_unique_internal_edge
    (G : SimpleGraph V) (S A B : Finset V) {x y : V}
    (hcount : (Pseudograph.ofSimple G).internalMultiplicity S = 1)
    (hAB : Disjoint A B) (hAS : A ⊆ S) (hBS : B ⊆ S)
    (hxy : G.Adj x y) (hx : x ∈ A) (hy : y ∈ B) :
    (Pseudograph.ofSimple G).betweenMultiplicity A B = 1 := by
  classical
  have hunique : ∀ {a b : V}, G.Adj a b → a ∈ S → b ∈ S →
      s(a, b) = s(x, y) :=
    unique_internal_edge_of_eq_one G S hcount hxy (hAS hx) (hBS hy)
  have hfinset : Pseudograph.betweenEdgeFinset G A B = {s(x, y)} := by
    ext e
    induction e using Sym2.inductionOn with
    | _ a b =>
        constructor
        · intro he
          have he' := (Pseudograph.mem_betweenEdgeFinset_mk_iff G A B a b).mp he
          rcases he'.2 with ⟨ha, hb⟩ | ⟨ha, hb⟩
          · have := hunique he'.1 (hAS ha) (hBS hb)
            simpa [this]
          · have := hunique he'.1 (hBS ha) (hAS hb)
            simpa [this]
        · intro he
          simp only [Finset.mem_singleton] at he
          rw [he]
          exact (Pseudograph.mem_betweenEdgeFinset_mk_iff G A B x y).mpr
            ⟨hxy, .inl ⟨hx, hy⟩⟩
  rw [← Pseudograph.card_betweenEdgeFinset, hfinset]
  simp

namespace TypeABarrier

abbrev Side := TypeCBarrier.Side

noncomputable def side {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : Side → Finset V
  | .L => B.left
  | .M => B.middle
  | .R => B.right

@[simp] lemma side_L {G : SimpleGraph V} {u : V} (B : TypeABarrier G u) :
    B.side .L = B.left := rfl

@[simp] lemma side_M {G : SimpleGraph V} {u : V} (B : TypeABarrier G u) :
    B.side .M = B.middle := rfl

@[simp] lemma side_R {G : SimpleGraph V} {u : V} (B : TypeABarrier G u) :
    B.side .R = B.right := rfl

lemma disjoint_side {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) {a b : Side} (hab : a ≠ b) :
    Disjoint (B.side a) (B.side b) := by
  cases a <;> cases b
  · exact (hab rfl).elim
  · exact B.left_middle_disjoint
  · exact B.left_right_disjoint
  · exact B.left_middle_disjoint.symm
  · exact (hab rfl).elim
  · exact B.middle_right_disjoint
  · exact B.left_right_disjoint.symm
  · exact B.middle_right_disjoint.symm
  · exact (hab rfl).elim

lemma union_sides {G : SimpleGraph V} {u : V} (B : TypeABarrier G u) :
    B.side .L ∪ B.side .M ∪ B.side .R = Finset.univ := B.cover

noncomputable def block {G : SimpleGraph V} {u v : V}
    (B : TypeABarrier G u) (C : TypeABarrier G v)
    (a b : Side) : Finset V := B.side a ∩ C.side b

@[simp] lemma mem_block {G : SimpleGraph V} {u v x : V}
    {B : TypeABarrier G u} {C : TypeABarrier G v} {a b : Side} :
    x ∈ block B C a b ↔ x ∈ B.side a ∧ x ∈ C.side b := by
  simp [block]

lemma disjoint_block {G : SimpleGraph V} {u v : V}
    (B : TypeABarrier G u) (C : TypeABarrier G v)
    {a b a' b' : Side} (hne : a ≠ a' ∨ b ≠ b') :
    Disjoint (block B C a b) (block B C a' b') := by
  rw [Finset.disjoint_left]
  intro x hx hx'
  have hx := mem_block.mp hx
  have hx' := mem_block.mp hx'
  rcases hne with ha | hb
  · exact (Finset.disjoint_left.mp (B.disjoint_side ha)) hx.1 hx'.1
  · exact (Finset.disjoint_left.mp (C.disjoint_side hb)) hx.2 hx'.2

lemma block_row_union {G : SimpleGraph V} {u v : V}
    (B : TypeABarrier G u) (C : TypeABarrier G v) (a : Side) :
    block B C a .L ∪ block B C a .M ∪ block B C a .R = B.side a := by
  ext x
  constructor
  · intro hx
    simp only [Finset.mem_union] at hx
    rcases hx with (hx | hx) | hx
    · exact (mem_block.mp hx).1
    · exact (mem_block.mp hx).1
    · exact (mem_block.mp hx).1
  · intro hx
    have hcover : x ∈ C.side .L ∪ C.side .M ∪ C.side .R := by
      rw [C.union_sides]
      simp
    simp only [Finset.mem_union] at hcover
    rcases hcover with (hxL | hxM) | hxR
    · exact Finset.mem_union_left _
        (Finset.mem_union_left _ (mem_block.mpr ⟨hx, hxL⟩))
    · exact Finset.mem_union_left _
        (Finset.mem_union_right _ (mem_block.mpr ⟨hx, hxM⟩))
    · exact Finset.mem_union_right _ (mem_block.mpr ⟨hx, hxR⟩)

lemma block_column_union {G : SimpleGraph V} {u v : V}
    (B : TypeABarrier G u) (C : TypeABarrier G v) (b : Side) :
    block B C .L b ∪ block B C .M b ∪ block B C .R b = C.side b := by
  ext x
  constructor
  · intro hx
    simp only [Finset.mem_union] at hx
    rcases hx with (hx | hx) | hx
    · exact (mem_block.mp hx).2
    · exact (mem_block.mp hx).2
    · exact (mem_block.mp hx).2
  · intro hx
    have hcover : x ∈ B.side .L ∪ B.side .M ∪ B.side .R := by
      rw [B.union_sides]
      simp
    simp only [Finset.mem_union] at hcover
    rcases hcover with (hxL | hxM) | hxR
    · exact Finset.mem_union_left _
        (Finset.mem_union_left _ (mem_block.mpr ⟨hxL, hx⟩))
    · exact Finset.mem_union_left _
        (Finset.mem_union_right _ (mem_block.mpr ⟨hxM, hx⟩))
    · exact Finset.mem_union_right _ (mem_block.mpr ⟨hxR, hx⟩)

/-- The two five-term equations obtained by expanding the six edges from
each type-A right shore into its middle shore.  The two displayed middle
edges of the triangle are the unique internal middle edges, so the four
otherwise possible terms vanish. -/
lemma triangle_right_ledgers
    {G : SimpleGraph V} {u v w : V}
    (B : TypeABarrier G u) (C : TypeABarrier G v)
    (huv : G.Adj u v) (huw : G.Adj u w) (hvw : G.Adj v w) :
    let P := Pseudograph.ofSimple G
    let a := P.betweenMultiplicity (block B C .R .L) (block B C .M .M)
    let b := P.betweenMultiplicity (block B C .R .M) (block B C .M .L)
    let c := P.betweenMultiplicity (block B C .R .M) (block B C .M .R)
    let d := P.betweenMultiplicity (block B C .R .R) (block B C .M .M)
    let e := P.betweenMultiplicity (block B C .R .R) (block B C .M .R)
    let a' := P.betweenMultiplicity (block B C .L .R) (block B C .M .M)
    let b' := P.betweenMultiplicity (block B C .M .R) (block B C .L .M)
    let f := P.betweenMultiplicity (block B C .R .R) (block B C .R .M)
    a + b + c + d + e = 6 ∧ a' + b' + c + d + f = 6 := by
  classical
  let P := Pseudograph.ofSimple G
  let X31 := block B C .R .L
  let X32 := block B C .R .M
  let X33 := block B C .R .R
  let X21 := block B C .M .L
  let X22 := block B C .M .M
  let X23 := block B C .M .R
  let X13 := block B C .L .R
  let X12 := block B C .L .M
  have huX12 : u ∈ X12 := mem_block.mpr
    ⟨B.distinguished_mem_left, C.neighbor_mem_middle huv.symm⟩
  have hvX21 : v ∈ X21 := mem_block.mpr
    ⟨B.neighbor_mem_middle huv, C.distinguished_mem_left⟩
  have hwX22 : w ∈ X22 := mem_block.mpr
    ⟨B.neighbor_mem_middle huw, C.neighbor_mem_middle hvw⟩
  have hBunique : ∀ {a b : V}, G.Adj a b → a ∈ B.middle →
      b ∈ B.middle → s(a, b) = s(v, w) :=
    unique_internal_edge_of_eq_one G B.middle
      B.middle_internal hvw (B.neighbor_mem_middle huv)
        (B.neighbor_mem_middle huw)
  have hCunique : ∀ {a b : V}, G.Adj a b → a ∈ C.middle →
      b ∈ C.middle → s(a, b) = s(u, w) :=
    unique_internal_edge_of_eq_one G C.middle
      C.middle_internal huw (C.neighbor_mem_middle huv.symm)
        (C.neighbor_mem_middle hvw)
  have hzero31_21 : P.betweenMultiplicity X31 X21 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    exact C.left_independent (mem_block.mp hx).2 (mem_block.mp hy).2
      hxy.ne hxy
  have hzero31_23 : P.betweenMultiplicity X31 X23 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy
    exact C.left_right_nonadjacent (mem_block.mp hx).2 (mem_block.mp hy).2
  have hzero32_22 : P.betweenMultiplicity X32 X22 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    have he := hCunique hxy (mem_block.mp hx).2 (mem_block.mp hy).2
    rw [Sym2.eq_iff] at he
    rcases he with ⟨hxu, _⟩ | ⟨hxw, _⟩
    · subst x
      exact (Finset.disjoint_left.mp B.left_right_disjoint)
        B.distinguished_mem_left (mem_block.mp hx).1
    · subst x
      exact (Finset.disjoint_left.mp B.middle_right_disjoint)
        (B.neighbor_mem_middle huw) (mem_block.mp hx).1
  have hzero33_21 : P.betweenMultiplicity X33 X21 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    exact C.left_right_nonadjacent (mem_block.mp hy).2 (mem_block.mp hx).2 hxy.symm
  have hR12 : Disjoint X31 X32 := B.disjoint_block C (.inr (by decide))
  have hR13 : Disjoint X31 X33 := B.disjoint_block C (.inr (by decide))
  have hR23 : Disjoint X32 X33 := B.disjoint_block C (.inr (by decide))
  have hR123 : Disjoint (X31 ∪ X32) X33 :=
    Finset.disjoint_union_left.mpr ⟨hR13, hR23⟩
  have hM12 : Disjoint X21 X22 := B.disjoint_block C (.inr (by decide))
  have hM13 : Disjoint X21 X23 := B.disjoint_block C (.inr (by decide))
  have hM23 : Disjoint X22 X23 := B.disjoint_block C (.inr (by decide))
  have hM123 : Disjoint (X21 ∪ X22) X23 :=
    Finset.disjoint_union_left.mpr ⟨hM13, hM23⟩
  have hRM : Disjoint ((X31 ∪ X32) ∪ X33) ((X21 ∪ X22) ∪ X23) := by
    simpa [X31, X32, X33, X21, X22, X23,
      B.block_row_union C .R, B.block_row_union C .M] using
        B.middle_right_disjoint.symm
  have hfirst := P.betweenMultiplicity_three_by_three
    X31 X32 X33 X21 X22 X23 hR12 hR123 hM12 hM123 hRM
  rw [show (X31 ∪ X32) ∪ X33 = B.right by
      simpa [X31, X32, X33] using B.block_row_union C .R,
    show (X21 ∪ X22) ∪ X23 = B.middle by
      simpa [X21, X22, X23] using B.block_row_union C .M,
    (P.betweenMultiplicity_comm B.right B.middle),
    B.between_middle_right_eq_six,
    hzero31_21, hzero31_23, hzero32_22, hzero33_21] at hfirst
  have hzero13_12 : P.betweenMultiplicity X13 X12 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    exact B.left_independent (mem_block.mp hx).1 (mem_block.mp hy).1
      hxy.ne hxy
  have hzero13_32 : P.betweenMultiplicity X13 X32 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy
    exact B.left_right_nonadjacent (mem_block.mp hx).1 (mem_block.mp hy).1
  have hzero23_22 : P.betweenMultiplicity X23 X22 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    have he := hBunique hxy (mem_block.mp hx).1 (mem_block.mp hy).1
    rw [Sym2.eq_iff] at he
    rcases he with ⟨hxv, _⟩ | ⟨hxw, _⟩
    · subst x
      exact (Finset.disjoint_left.mp C.left_right_disjoint)
        C.distinguished_mem_left (mem_block.mp hx).2
    · subst x
      exact (Finset.disjoint_left.mp C.middle_right_disjoint)
        (C.neighbor_mem_middle hvw) (mem_block.mp hx).2
  have hzero33_12 : P.betweenMultiplicity X33 X12 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    exact B.left_right_nonadjacent (mem_block.mp hy).1 (mem_block.mp hx).1 hxy.symm
  have hCR12 : Disjoint X13 X23 := B.disjoint_block C (.inl (by decide))
  have hCR13 : Disjoint X13 X33 := B.disjoint_block C (.inl (by decide))
  have hCR23 : Disjoint X23 X33 := B.disjoint_block C (.inl (by decide))
  have hCR123 : Disjoint (X13 ∪ X23) X33 :=
    Finset.disjoint_union_left.mpr ⟨hCR13, hCR23⟩
  have hCM12 : Disjoint X12 X22 := B.disjoint_block C (.inl (by decide))
  have hCM13 : Disjoint X12 X32 := B.disjoint_block C (.inl (by decide))
  have hCM23 : Disjoint X22 X32 := B.disjoint_block C (.inl (by decide))
  have hCM123 : Disjoint (X12 ∪ X22) X32 :=
    Finset.disjoint_union_left.mpr ⟨hCM13, hCM23⟩
  have hCRM : Disjoint ((X13 ∪ X23) ∪ X33) ((X12 ∪ X22) ∪ X32) := by
    simpa [X13, X23, X33, X12, X22, X32,
      B.block_column_union C .R, B.block_column_union C .M] using
        C.middle_right_disjoint.symm
  have hsecond := P.betweenMultiplicity_three_by_three
    X13 X23 X33 X12 X22 X32 hCR12 hCR123 hCM12 hCM123 hCRM
  rw [show (X13 ∪ X23) ∪ X33 = C.right by
      simpa [X13, X23, X33] using B.block_column_union C .R,
    show (X12 ∪ X22) ∪ X32 = C.middle by
      simpa [X12, X22, X32] using B.block_column_union C .M,
    (P.betweenMultiplicity_comm C.right C.middle),
    C.between_middle_right_eq_six,
    hzero13_12, hzero13_32, hzero23_22, hzero33_12,
    P.betweenMultiplicity_comm X23 X32] at hsecond
  exact ⟨by simpa [P, X31, X32, X33, X21, X22, X23] using hfirst.symm,
    by simpa [P, X13, X23, X33, X12, X22, X32] using hsecond.symm⟩

/-- The diagonal, off-diagonal, and right-right cut identities in the
type-A triangle overlay. -/
lemma triangle_auxiliary_cut_ledgers
    {G : SimpleGraph V} {u v w : V}
    (B : TypeABarrier G u) (C : TypeABarrier G v)
    (hreg : G.IsRegularOfDegree 4)
    (huv : G.Adj u v) (huw : G.Adj u w) (hvw : G.Adj v w) :
    let P := Pseudograph.ofSimple G
    let a := P.betweenMultiplicity (block B C .R .L) (block B C .M .M)
    let b := P.betweenMultiplicity (block B C .R .M) (block B C .M .L)
    let d := P.betweenMultiplicity (block B C .R .R) (block B C .M .M)
    let e := P.betweenMultiplicity (block B C .R .R) (block B C .M .R)
    let a' := P.betweenMultiplicity (block B C .L .R) (block B C .M .M)
    let b' := P.betweenMultiplicity (block B C .M .R) (block B C .L .M)
    let f := P.betweenMultiplicity (block B C .R .R) (block B C .R .M)
    P.boundaryMultiplicity (block B C .L .L ∪ block B C .M .M) =
        2 + a + a' + d ∧
      P.boundaryMultiplicity (block B C .L .M ∪ block B C .M .L) =
        2 + b + b' ∧
      P.boundaryMultiplicity (block B C .R .R) = d + e + f ∧
      4 * (block B C .L .M).card =
        P.betweenMultiplicity (block B C .L .M) (block B C .M .L) +
          1 + b' ∧
      4 * (block B C .M .L).card =
        P.betweenMultiplicity (block B C .M .L) (block B C .L .M) +
          1 + b := by
  classical
  let P := Pseudograph.ofSimple G
  let X11 := block B C .L .L
  let X12 := block B C .L .M
  let X13 := block B C .L .R
  let X21 := block B C .M .L
  let X22 := block B C .M .M
  let X23 := block B C .M .R
  let X31 := block B C .R .L
  let X32 := block B C .R .M
  let X33 := block B C .R .R
  have huX12 : u ∈ X12 := mem_block.mpr
    ⟨B.distinguished_mem_left, C.neighbor_mem_middle huv.symm⟩
  have hvX21 : v ∈ X21 := mem_block.mpr
    ⟨B.neighbor_mem_middle huv, C.distinguished_mem_left⟩
  have hwX22 : w ∈ X22 := mem_block.mpr
    ⟨B.neighbor_mem_middle huw, C.neighbor_mem_middle hvw⟩
  have hregP : P.IsRegularOfDegree 4 := by
    simpa [P] using (Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg
  have hBunique : ∀ {a b : V}, G.Adj a b → a ∈ B.middle →
      b ∈ B.middle → s(a, b) = s(v, w) :=
    unique_internal_edge_of_eq_one G B.middle
      B.middle_internal hvw (B.neighbor_mem_middle huv)
        (B.neighbor_mem_middle huw)
  have hCunique : ∀ {a b : V}, G.Adj a b → a ∈ C.middle →
      b ∈ C.middle → s(a, b) = s(u, w) :=
    unique_internal_edge_of_eq_one G C.middle
      C.middle_internal huw (C.neighbor_mem_middle huv.symm)
        (C.neighbor_mem_middle hvw)
  have h22_12 : P.betweenMultiplicity X22 X12 = 1 := by
    simpa [P] using betweenMultiplicity_eq_one_of_unique_internal_edge
      G C.middle X22 X12 C.middle_internal
      (B.disjoint_block C (.inl (by decide)))
      (fun z hz ↦ (mem_block.mp hz).2) (fun z hz ↦ (mem_block.mp hz).2)
      huw.symm hwX22 huX12
  have h22_21 : P.betweenMultiplicity X22 X21 = 1 := by
    simpa [P] using betweenMultiplicity_eq_one_of_unique_internal_edge
      G B.middle X22 X21 B.middle_internal
      (B.disjoint_block C (.inr (by decide)))
      (fun z hz ↦ (mem_block.mp hz).1) (fun z hz ↦ (mem_block.mp hz).1)
      hvw.symm hwX22 hvX21
  have h22_32 : P.betweenMultiplicity X22 X32 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    have he := hCunique hxy (mem_block.mp hx).2 (mem_block.mp hy).2
    rw [Sym2.eq_iff] at he
    rcases he with ⟨hxu, _⟩ | ⟨_, hyu⟩
    · subst x
      exact (Finset.disjoint_left.mp B.left_middle_disjoint)
        B.distinguished_mem_left (mem_block.mp hx).1
    · subst y
      exact (Finset.disjoint_left.mp B.left_right_disjoint)
        B.distinguished_mem_left (mem_block.mp hy).1
  have h22_23 : P.betweenMultiplicity X22 X23 = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro x hx y hy hxy
    have he := hBunique hxy (mem_block.mp hx).1 (mem_block.mp hy).1
    rw [Sym2.eq_iff] at he
    rcases he with ⟨hxv, _⟩ | ⟨_, hyv⟩
    · subst x
      exact (Finset.disjoint_left.mp C.left_middle_disjoint)
        C.distinguished_mem_left (mem_block.mp hx).2
    · subst y
      exact (Finset.disjoint_left.mp C.left_right_disjoint)
        C.distinguished_mem_left (mem_block.mp hy).2
  have hX22ind : G.IsIndepSet (X22 : Set V) := by
    intro x hx y hy hxyne hxy
    have he := hBunique hxy (mem_block.mp hx).1 (mem_block.mp hy).1
    have hvnot : v ∉ X22 := fun hv ↦
      (Finset.disjoint_left.mp C.left_middle_disjoint)
        C.distinguished_mem_left (mem_block.mp hv).2
    rw [Sym2.eq_iff] at he
    rcases he with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hvnot hx
    · exact hvnot hy
  have hX11ind : G.IsIndepSet (X11 : Set V) := by
    intro x hx y hy hxy
    exact B.left_independent (mem_block.mp hx).1 (mem_block.mp hy).1 hxy
  have hX12ind : G.IsIndepSet (X12 : Set V) := by
    intro x hx y hy hxy
    exact B.left_independent (mem_block.mp hx).1 (mem_block.mp hy).1 hxy
  have hX21ind : G.IsIndepSet (X21 : Set V) := by
    intro x hx y hy hxy
    exact C.left_independent (mem_block.mp hx).2 (mem_block.mp hy).2 hxy
  have hBside (x : V) : x ∈ B.left ∨ x ∈ B.middle ∨ x ∈ B.right := by
    have hx : x ∈ B.left ∪ B.middle ∪ B.right := by rw [B.cover]; simp
    simpa [or_assoc] using hx
  have hCside (x : V) : x ∈ C.left ∨ x ∈ C.middle ∨ x ∈ C.right := by
    have hx : x ∈ C.left ∪ C.middle ∪ C.right := by rw [C.cover]; simp
    simpa [or_assoc] using hx
  have hX11neighbors : ∀ x ∈ X11, ∀ y, G.Adj x y → y ∈ X22 := by
    intro x hx y hxy
    have hx' := mem_block.mp hx
    have hyB : y ∈ B.middle := by
      rcases hBside y with hyL | hyM | hyR
      · exact False.elim (B.left_independent hx'.1 hyL hxy.ne hxy)
      · exact hyM
      · exact False.elim (B.left_right_nonadjacent hx'.1 hyR hxy)
    have hyC : y ∈ C.middle := by
      rcases hCside y with hyL | hyM | hyR
      · exact False.elim (C.left_independent hx'.2 hyL hxy.ne hxy)
      · exact hyM
      · exact False.elim (C.left_right_nonadjacent hx'.2 hyR hxy)
    exact mem_block.mpr ⟨hyB, hyC⟩
  have h11_22 : P.betweenMultiplicity X11 X22 = 4 * X11.card := by
    simpa [P] using betweenMultiplicity_eq_regular_mul_card_of_independent
      G hreg X11 X22 (B.disjoint_block C (.inl (by decide)))
        hX11ind hX11neighbors
  have hq11 : P.boundaryMultiplicity X11 = 4 * X11.card := by
    have hint := internalMultiplicity_eq_zero_of_isIndepSet G X11 hX11ind
    have hdeg := P.regular_card_eq_two_internal_add_boundary hregP X11
    rw [hint] at hdeg
    omega
  have hq22 : P.boundaryMultiplicity X22 = 4 * X22.card := by
    have hint := internalMultiplicity_eq_zero_of_isIndepSet G X22 hX22ind
    have hdeg := P.regular_card_eq_two_internal_add_boundary hregP X22
    rw [hint] at hdeg
    omega
  have h22L : P.betweenMultiplicity X22 C.left =
      P.betweenMultiplicity X22 X11 + P.betweenMultiplicity X22 X21 +
        P.betweenMultiplicity X22 X31 := by
    have h12 : Disjoint X11 X21 := B.disjoint_block C (.inl (by decide))
    have h13 : Disjoint X11 X31 := B.disjoint_block C (.inl (by decide))
    have h23 : Disjoint X21 X31 := B.disjoint_block C (.inl (by decide))
    have h123 : Disjoint (X11 ∪ X21) X31 :=
      Finset.disjoint_union_left.mpr ⟨h13, h23⟩
    have hsource : Disjoint X22 ((X11 ∪ X21) ∪ X31) :=
      Finset.disjoint_union_right.mpr
        ⟨Finset.disjoint_union_right.mpr
          ⟨B.disjoint_block C (.inr (by decide)),
            B.disjoint_block C (.inr (by decide))⟩,
          B.disjoint_block C (.inl (by decide))⟩
    rw [← show (X11 ∪ X21) ∪ X31 = C.left by
      simpa [X11, X21, X31] using B.block_column_union C .L]
    rw [P.betweenMultiplicity_union_right X22 (X11 ∪ X21) X31 h123 hsource,
      P.betweenMultiplicity_union_right X22 X11 X21 h12
        (Disjoint.mono (by rfl) Finset.subset_union_left hsource)]
  have h22R : P.betweenMultiplicity X22 C.right =
      P.betweenMultiplicity X22 X13 + P.betweenMultiplicity X22 X23 +
        P.betweenMultiplicity X22 X33 := by
    have h12 : Disjoint X13 X23 := B.disjoint_block C (.inl (by decide))
    have h13 : Disjoint X13 X33 := B.disjoint_block C (.inl (by decide))
    have h23 : Disjoint X23 X33 := B.disjoint_block C (.inl (by decide))
    have h123 : Disjoint (X13 ∪ X23) X33 :=
      Finset.disjoint_union_left.mpr ⟨h13, h23⟩
    have hsource : Disjoint X22 ((X13 ∪ X23) ∪ X33) :=
      Finset.disjoint_union_right.mpr
        ⟨Finset.disjoint_union_right.mpr
          ⟨B.disjoint_block C (.inl (by decide)),
            B.disjoint_block C (.inr (by decide))⟩,
          B.disjoint_block C (.inl (by decide))⟩
    rw [← show (X13 ∪ X23) ∪ X33 = C.right by
      simpa [X13, X23, X33] using B.block_column_union C .R]
    rw [P.betweenMultiplicity_union_right X22 (X13 ∪ X23) X33 h123 hsource,
      P.betweenMultiplicity_union_right X22 X13 X23 h12
        (Disjoint.mono (by rfl) Finset.subset_union_left hsource)]
  let Tmid := X12 ∪ X32
  have hmidDisj : Disjoint X12 X32 := B.disjoint_block C (.inl (by decide))
  have h22mid : P.betweenMultiplicity X22 Tmid = 1 := by
    have hsource : Disjoint X22 Tmid :=
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩
    rw [P.betweenMultiplicity_union_right X22 X12 X32 hmidDisj hsource,
      h22_12, h22_32]
  let T22 := (C.left ∪ Tmid) ∪ C.right
  have hLmid : Disjoint C.left Tmid := by
    exact Finset.disjoint_union_right.mpr ⟨
      Disjoint.mono (by rfl) (fun z hz ↦ (mem_block.mp hz).2)
        C.left_middle_disjoint,
      Disjoint.mono (by rfl) (fun z hz ↦ (mem_block.mp hz).2)
        C.left_middle_disjoint⟩
  have hLmidR : Disjoint (C.left ∪ Tmid) C.right :=
    Finset.disjoint_union_left.mpr ⟨C.left_right_disjoint,
      Finset.disjoint_union_left.mpr ⟨
        Disjoint.mono (fun z hz ↦ (mem_block.mp hz).2) (by rfl)
          C.middle_right_disjoint,
        Disjoint.mono (fun z hz ↦ (mem_block.mp hz).2) (by rfl)
          C.middle_right_disjoint⟩⟩
  have h22T : Disjoint X22 T22 := by
    exact Finset.disjoint_union_right.mpr ⟨
      Finset.disjoint_union_right.mpr ⟨
        Disjoint.mono (fun z hz ↦ (mem_block.mp hz).2) (by rfl)
          C.left_middle_disjoint.symm,
        Finset.disjoint_union_right.mpr ⟨
          B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩⟩,
      Disjoint.mono (fun z hz ↦ (mem_block.mp hz).2) (by rfl)
        C.middle_right_disjoint⟩
  have hcross22 : ∀ x ∈ X22, ∀ y, G.Adj x y → y ∉ X22 → y ∈ T22 := by
    intro x hx y hxy hy22
    rcases hCside y with hyL | hyM | hyR
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ hyL)
    · rcases hBside y with hyBL | hyBM | hyBR
      · exact Finset.mem_union_left _ (Finset.mem_union_right _
          (Finset.mem_union_left _ (mem_block.mpr ⟨hyBL, hyM⟩)))
      · exact False.elim (hy22 (mem_block.mpr ⟨hyBM, hyM⟩))
      · exact Finset.mem_union_left _ (Finset.mem_union_right _
          (Finset.mem_union_right _ (mem_block.mpr ⟨hyBR, hyM⟩)))
    · exact Finset.mem_union_right _ hyR
  have hq22expand : P.boundaryMultiplicity X22 =
      P.betweenMultiplicity X22 C.left + 1 +
        P.betweenMultiplicity X22 C.right := by
    have hbound := boundaryMultiplicity_eq_between_of_crossing_neighbors_subset
      G X22 T22 h22T hcross22
    change P.boundaryMultiplicity X22 = P.betweenMultiplicity X22 T22 at hbound
    rw [show T22 = (C.left ∪ Tmid) ∪ C.right by rfl,
      P.betweenMultiplicity_union_right X22 (C.left ∪ Tmid) C.right
        hLmidR h22T,
      P.betweenMultiplicity_union_right X22 C.left Tmid hLmid
        (Disjoint.mono (by rfl) Finset.subset_union_left h22T),
      h22mid] at hbound
    exact hbound
  have hq22counts : P.boundaryMultiplicity X22 =
      4 * X11.card + 2 +
        P.betweenMultiplicity X22 X31 +
        P.betweenMultiplicity X22 X13 +
        P.betweenMultiplicity X22 X33 := by
    rw [h22L, h22R, h22_21, h22_23,
      P.betweenMultiplicity_comm X22 X11, h11_22] at hq22expand
    omega
  have hH1 := P.boundaryMultiplicity_union_add_two_between
    hregP X11 X22 (B.disjoint_block C (.inl (by decide)))
  rw [hq11, hq22, h11_22] at hH1
  have hH1count : P.boundaryMultiplicity (X11 ∪ X22) =
      2 + P.betweenMultiplicity X31 X22 +
        P.betweenMultiplicity X13 X22 +
        P.betweenMultiplicity X33 X22 := by
    rw [hq22] at hq22counts
    rw [P.betweenMultiplicity_comm X22 X31,
      P.betweenMultiplicity_comm X22 X13,
      P.betweenMultiplicity_comm X22 X33] at hq22counts
    omega
  have hX12neighbors : ∀ x ∈ X12, ∀ y, G.Adj x y → y ∈ B.middle := by
    intro x hx y hxy
    rcases hBside y with hyL | hyM | hyR
    · exact False.elim (B.left_independent (mem_block.mp hx).1 hyL hxy.ne hxy)
    · exact hyM
    · exact False.elim (B.left_right_nonadjacent (mem_block.mp hx).1 hyR hxy)
  have hX21neighbors : ∀ x ∈ X21, ∀ y, G.Adj x y → y ∈ C.middle := by
    intro x hx y hxy
    rcases hCside y with hyL | hyM | hyR
    · exact False.elim (C.left_independent (mem_block.mp hx).2 hyL hxy.ne hxy)
    · exact hyM
    · exact False.elim (C.left_right_nonadjacent (mem_block.mp hx).2 hyR hxy)
  have hdeg12 : P.betweenMultiplicity X12 B.middle = 4 * X12.card := by
    simpa [P] using betweenMultiplicity_eq_regular_mul_card_of_independent
      G hreg X12 B.middle
        (Disjoint.mono (fun z hz ↦ (mem_block.mp hz).1) (by rfl)
          B.left_middle_disjoint) hX12ind hX12neighbors
  have hdeg21 : P.betweenMultiplicity X21 C.middle = 4 * X21.card := by
    simpa [P] using betweenMultiplicity_eq_regular_mul_card_of_independent
      G hreg X21 C.middle
        (Disjoint.mono (fun z hz ↦ (mem_block.mp hz).2) (by rfl)
          C.left_middle_disjoint) hX21ind hX21neighbors
  have hexpand12 : P.betweenMultiplicity X12 B.middle =
      P.betweenMultiplicity X12 X21 + P.betweenMultiplicity X12 X22 +
        P.betweenMultiplicity X12 X23 := by
    have h12 : Disjoint X21 X22 := B.disjoint_block C (.inr (by decide))
    have h13 : Disjoint X21 X23 := B.disjoint_block C (.inr (by decide))
    have h23 : Disjoint X22 X23 := B.disjoint_block C (.inr (by decide))
    have h123 : Disjoint (X21 ∪ X22) X23 :=
      Finset.disjoint_union_left.mpr ⟨h13, h23⟩
    have hs : Disjoint X12 ((X21 ∪ X22) ∪ X23) := by
      simpa [X21, X22, X23, B.block_row_union C .M] using
        (Disjoint.mono (fun z hz ↦ (mem_block.mp hz).1) (by rfl)
          B.left_middle_disjoint)
    rw [← show (X21 ∪ X22) ∪ X23 = B.middle by
      simpa [X21, X22, X23] using B.block_row_union C .M]
    rw [P.betweenMultiplicity_union_right X12 (X21 ∪ X22) X23 h123 hs,
      P.betweenMultiplicity_union_right X12 X21 X22 h12
        (Disjoint.mono (by rfl) Finset.subset_union_left hs)]
  have hexpand21 : P.betweenMultiplicity X21 C.middle =
      P.betweenMultiplicity X21 X12 + P.betweenMultiplicity X21 X22 +
        P.betweenMultiplicity X21 X32 := by
    have h12 : Disjoint X12 X22 := B.disjoint_block C (.inl (by decide))
    have h13 : Disjoint X12 X32 := B.disjoint_block C (.inl (by decide))
    have h23 : Disjoint X22 X32 := B.disjoint_block C (.inl (by decide))
    have h123 : Disjoint (X12 ∪ X22) X32 :=
      Finset.disjoint_union_left.mpr ⟨h13, h23⟩
    have hs : Disjoint X21 ((X12 ∪ X22) ∪ X32) := by
      simpa [X12, X22, X32, B.block_column_union C .M] using
        (Disjoint.mono (fun z hz ↦ (mem_block.mp hz).2) (by rfl)
          C.left_middle_disjoint)
    rw [← show (X12 ∪ X22) ∪ X32 = C.middle by
      simpa [X12, X22, X32] using B.block_column_union C .M]
    rw [P.betweenMultiplicity_union_right X21 (X12 ∪ X22) X32 h123 hs,
      P.betweenMultiplicity_union_right X21 X12 X22 h12
        (Disjoint.mono (by rfl) Finset.subset_union_left hs)]
  have hq12 : P.boundaryMultiplicity X12 = 4 * X12.card := by
    have hint := internalMultiplicity_eq_zero_of_isIndepSet G X12 hX12ind
    have hdeg := P.regular_card_eq_two_internal_add_boundary hregP X12
    rw [hint] at hdeg
    omega
  have hq21 : P.boundaryMultiplicity X21 = 4 * X21.card := by
    have hint := internalMultiplicity_eq_zero_of_isIndepSet G X21 hX21ind
    have hdeg := P.regular_card_eq_two_internal_add_boundary hregP X21
    rw [hint] at hdeg
    omega
  have hH2 := P.boundaryMultiplicity_union_add_two_between hregP X12 X21
    (B.disjoint_block C (.inl (by decide)))
  have hH2count : P.boundaryMultiplicity (X12 ∪ X21) =
      2 + P.betweenMultiplicity X32 X21 +
        P.betweenMultiplicity X23 X12 := by
    rw [hq12, hq21] at hH2
    rw [hexpand12, P.betweenMultiplicity_comm X12 X22, h22_12,
      P.betweenMultiplicity_comm X12 X23] at hdeg12
    rw [hexpand21, P.betweenMultiplicity_comm X21 X22, h22_21,
      P.betweenMultiplicity_comm X21 X12,
      P.betweenMultiplicity_comm X21 X32] at hdeg21
    omega
  let T33 := (X22 ∪ X23) ∪ X32
  have hT3312 : Disjoint X22 X23 := B.disjoint_block C (.inr (by decide))
  have hT3313 : Disjoint X22 X32 := B.disjoint_block C (.inl (by decide))
  have hT3323 : Disjoint X23 X32 := B.disjoint_block C (.inl (by decide))
  have hT33parts : Disjoint (X22 ∪ X23) X32 :=
    Finset.disjoint_union_left.mpr ⟨hT3313, hT3323⟩
  have h33T : Disjoint X33 T33 :=
    Finset.disjoint_union_right.mpr ⟨
      Finset.disjoint_union_right.mpr
        ⟨B.disjoint_block C (.inl (by decide)),
          B.disjoint_block C (.inl (by decide))⟩,
      B.disjoint_block C (.inr (by decide))⟩
  have hcross33 : ∀ x ∈ X33, ∀ y, G.Adj x y → y ∉ X33 → y ∈ T33 := by
    intro x hx y hxy hy33
    have hx' := mem_block.mp hx
    rcases hBside y with hyBL | hyBM | hyBR
    · exact False.elim (B.left_right_nonadjacent hyBL hx'.1 hxy.symm)
    · rcases hCside y with hyCL | hyCM | hyCR
      · exact False.elim (C.left_right_nonadjacent hyCL hx'.2 hxy.symm)
      · exact Finset.mem_union_left _
          (Finset.mem_union_left _ (mem_block.mpr ⟨hyBM, hyCM⟩))
      · exact Finset.mem_union_left _
          (Finset.mem_union_right _ (mem_block.mpr ⟨hyBM, hyCR⟩))
    · rcases hCside y with hyCL | hyCM | hyCR
      · exact False.elim (C.left_right_nonadjacent hyCL hx'.2 hxy.symm)
      · exact Finset.mem_union_right _ (mem_block.mpr ⟨hyBR, hyCM⟩)
      · exact False.elim (hy33 (mem_block.mpr ⟨hyBR, hyCR⟩))
  have hq33 := boundaryMultiplicity_eq_between_of_crossing_neighbors_subset
    G X33 T33 h33T hcross33
  change P.boundaryMultiplicity X33 = P.betweenMultiplicity X33 T33 at hq33
  rw [show T33 = (X22 ∪ X23) ∪ X32 by rfl,
    P.betweenMultiplicity_union_right X33 (X22 ∪ X23) X32
      hT33parts h33T,
    P.betweenMultiplicity_union_right X33 X22 X23 hT3312
      (Disjoint.mono (by rfl) Finset.subset_union_left h33T)] at hq33
  have hdeg12count : 4 * X12.card =
      P.betweenMultiplicity X12 X21 + 1 +
        P.betweenMultiplicity X23 X12 := by
    rw [hexpand12, P.betweenMultiplicity_comm X12 X22, h22_12,
      P.betweenMultiplicity_comm X12 X23] at hdeg12
    omega
  have hdeg21count : 4 * X21.card =
      P.betweenMultiplicity X21 X12 + 1 +
        P.betweenMultiplicity X32 X21 := by
    rw [hexpand21, P.betweenMultiplicity_comm X21 X22, h22_21,
      P.betweenMultiplicity_comm X21 X32] at hdeg21
    omega
  exact ⟨by simpa [P, X11, X22, X31, X13, X33] using hH1count,
    by simpa [P, X12, X21, X32, X23] using hH2count,
    by simpa [P, X22, X23, X32, X33] using hq33,
    by simpa [P, X12, X21, X23] using hdeg12count,
    by simpa [P, X12, X21, X32] using hdeg21count⟩

end TypeABarrier

/-- In a connected even-regular graph with no two-cut, every proper
nonempty shore has boundary at least four. -/
lemma four_le_boundaryMultiplicity_of_nonempty_proper
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (S : Finset V) (hS : S.Nonempty) (hcomp : Sᶜ.Nonempty) :
    4 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  have hproper : S ≠ Finset.univ := by
    intro h
    rw [h] at hcomp
    simpa using hcomp
  have hpos := boundaryMultiplicity_pos_of_connected G hconn S hS hproper
  have heven := Pseudograph.boundaryMultiplicity_even_of_even_regular
    (Pseudograph.ofSimple G) (r := 2)
    (by simpa using
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
  obtain ⟨k, hk⟩ := heven
  by_contra hnot
  have htwo : (Pseudograph.ofSimple G).boundaryMultiplicity S = 2 := by
    omega
  exact hno2 S hS hproper htwo

/-- Before six-cuts themselves are eliminated, the two- and four-cut
conclusions already force every shore nontrivial on both sides to have
boundary at least six. -/
lemma six_le_boundaryMultiplicity_of_two_sided_nontrivial
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (S : Finset V) (hcard : 2 ≤ S.card) (hcomp : 2 ≤ Sᶜ.card) :
    6 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  have hS : S.Nonempty := Finset.card_pos.mp (by omega)
  have hproper : S ≠ Finset.univ := by
    intro h
    have : Sᶜ.card = 0 := by simp [h]
    omega
  have hpos := boundaryMultiplicity_pos_of_connected G hconn S hS hproper
  have heven := Pseudograph.boundaryMultiplicity_even_of_even_regular
    (Pseudograph.ofSimple G) (r := 2)
    (by simpa using
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
  rcases heven with ⟨k, hk⟩
  by_contra hnot
  have hle : (Pseudograph.ofSimple G).boundaryMultiplicity S ≤ 5 := by omega
  have hcases : (Pseudograph.ofSimple G).boundaryMultiplicity S = 2 ∨
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 := by omega
  rcases hcases with h2 | h4
  · exact hno2 S hS hproper h2
  · rcases hno4 S hS hproper h4 with h1 | h1 <;> omega

/-- Proposition 3.6 upgrades the preceding lower bound to eight whenever a
bipartite shore contains two vertices in one independent colour class. -/
lemma eight_le_boundaryMultiplicity_of_bipartite_with_independent_pair
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hnoBip6 : Pseudograph.HasNoNontrivialBipartiteSixShore G)
    (S T : Finset V) (hTS : T ⊆ S) (hTind : G.IsIndepSet (T : Set V))
    (hTcard : 2 ≤ T.card) (hcomp : 2 ≤ Sᶜ.card)
    (hSbip : Pseudograph.IsBipartiteOn G S) :
    8 ≤ (Pseudograph.ofSimple G).boundaryMultiplicity S := by
  have hScard : 2 ≤ S.card := le_trans hTcard (Finset.card_le_card hTS)
  have hS : S.Nonempty := Finset.card_pos.mp (by omega)
  have hproper : S ≠ Finset.univ := by
    intro h
    have : Sᶜ.card = 0 := by simp [h]
    omega
  have h6 := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 S hScard hcomp
  have hne6 : (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 6 := by
    intro hcut
    have hcardS : S.card = 2 := hnoBip6 S hcut hSbip
    have hcardT : T.card = 2 := by
      have := Finset.card_le_card hTS
      omega
    have hTS' : T = S := by
      apply Finset.eq_of_subset_of_card_le hTS
      omega
    have hint : (Pseudograph.ofSimple G).internalMultiplicity S = 0 := by
      rw [← hTS']
      exact internalMultiplicity_eq_zero_of_isIndepSet G T hTind
    have hdegree := Pseudograph.regular_card_eq_two_internal_add_boundary
      (Pseudograph.ofSimple G)
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
    rw [hcardS, hint, hcut] at hdegree
    omega
  have heven := Pseudograph.boundaryMultiplicity_even_of_even_regular
    (Pseudograph.ofSimple G) (r := 2)
    (by simpa using
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) S
  rcases heven with ⟨k, hk⟩
  omega

/-- Two disjoint independent colour classes give an ambient two-colouring
of their union. -/
lemma isBipartiteOn_union_of_independent
    (G : SimpleGraph V) (A B : Finset V) (hAB : Disjoint A B)
    (hA : G.IsIndepSet (A : Set V)) (hB : G.IsIndepSet (B : Set V)) :
    Pseudograph.IsBipartiteOn G (A ∪ B) := by
  classical
  let color : V → Fin 2 := fun x ↦ if x ∈ A then 0 else 1
  refine ⟨color, ?_⟩
  intro x y hx hy hxy
  rcases Finset.mem_union.mp hx with hxA | hxB
  · rcases Finset.mem_union.mp hy with hyA | hyB
    · exact False.elim (hA (by simpa using hxA) (by simpa using hyA)
        hxy.ne hxy)
    · have hyA : y ∉ A := fun hyA ↦
        (Finset.disjoint_left.mp hAB) hyA hyB
      simp [color, hxA, hyA]
  · have hxA : x ∉ A := fun hxA ↦
      (Finset.disjoint_left.mp hAB) hxA hxB
    rcases Finset.mem_union.mp hy with hyA | hyB
    · simp [color, hxA, hyA]
    · exact False.elim (hB (by simpa using hxB) (by simpa using hyB)
        hxy.ne hxy)

/-- Tashkinov's Proposition 4.3 in the abstract type-A language: two
barriers centred at adjacent vertices of a triangle yield incompatible cut
ledgers. -/
theorem false_of_typeABarriers_triangle
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hnoBip6 : Pseudograph.HasNoNontrivialBipartiteSixShore G)
    {u v w : V} (huv : G.Adj u v) (huw : G.Adj u w) (hvw : G.Adj v w)
    (B : TypeABarrier G u) (C : TypeABarrier G v) : False := by
  classical
  let P := Pseudograph.ofSimple G
  let X11 := TypeABarrier.block B C .L .L
  let X12 := TypeABarrier.block B C .L .M
  let X13 := TypeABarrier.block B C .L .R
  let X21 := TypeABarrier.block B C .M .L
  let X22 := TypeABarrier.block B C .M .M
  let X23 := TypeABarrier.block B C .M .R
  let X31 := TypeABarrier.block B C .R .L
  let X32 := TypeABarrier.block B C .R .M
  let X33 := TypeABarrier.block B C .R .R
  let H1 := X11 ∪ X22
  let H2 := X12 ∪ X21
  let H3 := X13 ∪ X23
  let H4 := X31 ∪ X32
  let a := P.betweenMultiplicity X31 X22
  let b := P.betweenMultiplicity X32 X21
  let c := P.betweenMultiplicity X32 X23
  let d := P.betweenMultiplicity X33 X22
  let e := P.betweenMultiplicity X33 X23
  let a' := P.betweenMultiplicity X13 X22
  let b' := P.betweenMultiplicity X23 X12
  let f := P.betweenMultiplicity X33 X32
  have huX12 : u ∈ X12 := TypeABarrier.mem_block.mpr
    ⟨B.distinguished_mem_left, C.neighbor_mem_middle huv.symm⟩
  have hvX21 : v ∈ X21 := TypeABarrier.mem_block.mpr
    ⟨B.neighbor_mem_middle huv, C.distinguished_mem_left⟩
  have hwX22 : w ∈ X22 := TypeABarrier.mem_block.mpr
    ⟨B.neighbor_mem_middle huw, C.neighbor_mem_middle hvw⟩
  have huvne : u ≠ v := huv.ne
  have huWne : u ≠ w := huw.ne
  have hvWne : v ≠ w := hvw.ne
  have hright := B.triangle_right_ledgers C huv huw hvw
  dsimp only at hright
  change a + b + c + d + e = 6 ∧ a' + b' + c + d + f = 6 at hright
  have haux := B.triangle_auxiliary_cut_ledgers C hreg huv huw hvw
  dsimp only at haux
  change P.boundaryMultiplicity H1 = 2 + a + a' + d ∧
    P.boundaryMultiplicity H2 = 2 + b + b' ∧
    P.boundaryMultiplicity X33 = d + e + f ∧
    4 * X12.card = P.betweenMultiplicity X12 X21 + 1 + b' ∧
    4 * X21.card = P.betweenMultiplicity X21 X12 + 1 + b at haux
  have hBunique : ∀ {a b : V}, G.Adj a b → a ∈ B.middle →
      b ∈ B.middle → s(a, b) = s(v, w) :=
    unique_internal_edge_of_eq_one G B.middle
      B.middle_internal hvw (B.neighbor_mem_middle huv)
        (B.neighbor_mem_middle huw)
  have hCunique : ∀ {a b : V}, G.Adj a b → a ∈ C.middle →
      b ∈ C.middle → s(a, b) = s(u, w) :=
    unique_internal_edge_of_eq_one G C.middle
      C.middle_internal huw (C.neighbor_mem_middle huv.symm)
        (C.neighbor_mem_middle hvw)
  have hX13ind : G.IsIndepSet (X13 : Set V) := by
    intro x hx y hy hxy
    exact B.left_independent (TypeABarrier.mem_block.mp hx).1
      (TypeABarrier.mem_block.mp hy).1 hxy
  have hX23ind : G.IsIndepSet (X23 : Set V) := by
    intro x hx y hy hxyne hxy
    have heq := hBunique hxy (TypeABarrier.mem_block.mp hx).1
      (TypeABarrier.mem_block.mp hy).1
    have hvnot : v ∉ X23 := fun hz ↦
      (Finset.disjoint_left.mp C.left_right_disjoint)
        C.distinguished_mem_left (TypeABarrier.mem_block.mp hz).2
    have hwnot : w ∉ X23 := fun hz ↦
      (Finset.disjoint_left.mp C.middle_right_disjoint)
        (C.neighbor_mem_middle hvw) (TypeABarrier.mem_block.mp hz).2
    rw [Sym2.eq_iff] at heq
    rcases heq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hvnot hx
    · exact hwnot hx
  have hX31ind : G.IsIndepSet (X31 : Set V) := by
    intro x hx y hy hxy
    exact C.left_independent (TypeABarrier.mem_block.mp hx).2
      (TypeABarrier.mem_block.mp hy).2 hxy
  have hX32ind : G.IsIndepSet (X32 : Set V) := by
    intro x hx y hy hxyne hxy
    have heq := hCunique hxy (TypeABarrier.mem_block.mp hx).2
      (TypeABarrier.mem_block.mp hy).2
    have hunot : u ∉ X32 := fun hz ↦
      (Finset.disjoint_left.mp B.left_right_disjoint)
        B.distinguished_mem_left (TypeABarrier.mem_block.mp hz).1
    have hwnot : w ∉ X32 := fun hz ↦
      (Finset.disjoint_left.mp B.middle_right_disjoint)
        (B.neighbor_mem_middle huw) (TypeABarrier.mem_block.mp hz).1
    rw [Sym2.eq_iff] at heq
    rcases heq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hunot hx
    · exact hwnot hx
  have hX12ind : G.IsIndepSet (X12 : Set V) := by
    intro x hx y hy hxy
    exact B.left_independent (TypeABarrier.mem_block.mp hx).1
      (TypeABarrier.mem_block.mp hy).1 hxy
  have hX21ind : G.IsIndepSet (X21 : Set V) := by
    intro x hx y hy hxy
    exact C.left_independent (TypeABarrier.mem_block.mp hx).2
      (TypeABarrier.mem_block.mp hy).2 hxy
  have hCRdecomp : (X13 ∪ X33) ∪ X23 = C.right := by
    have h := B.block_column_union C .R
    simpa [X13, X23, X33, Finset.union_assoc, Finset.union_left_comm,
      Finset.union_comm] using h
  have h33large : 2 ≤ X33.card := by
    by_contra hnot
    have h33small : X33.card ≤ 1 := by omega
    have hX33ind : G.IsIndepSet (X33 : Set V) := by
      intro x hx y hy hxy _hxy
      exact hxy ((Finset.card_le_one.mp h33small) x hx y hy)
    have hAind : G.IsIndepSet ((X13 ∪ X33 : Finset V) : Set V) := by
      intro x hx y hy hxy hxyG
      rcases Finset.mem_union.mp hx with hx13 | hx33 <;>
        rcases Finset.mem_union.mp hy with hy13 | hy33
      · exact hX13ind (by simpa using hx13) (by simpa using hy13) hxy hxyG
      · exact B.left_right_nonadjacent (TypeABarrier.mem_block.mp hx13).1
          (TypeABarrier.mem_block.mp hy33).1 hxyG
      · exact B.left_right_nonadjacent (TypeABarrier.mem_block.mp hy13).1
          (TypeABarrier.mem_block.mp hx33).1 hxyG.symm
      · exact hX33ind (by simpa using hx33) (by simpa using hy33) hxy hxyG
    have hAD : Disjoint (X13 ∪ X33) X23 :=
      Finset.disjoint_union_left.mpr ⟨
        B.disjoint_block C (.inl (by decide)),
        B.disjoint_block C (.inl (by decide))⟩
    have hbip : Pseudograph.IsBipartiteOn G C.right := by
      rw [← hCRdecomp]
      exact isBipartiteOn_union_of_independent G (X13 ∪ X33) X23
        hAD hAind hX23ind
    have hcard := hnoBip6 C.right C.right_boundary hbip
    obtain ⟨k, hk⟩ := C.right_odd
    omega
  have hH1nonempty : H1.Nonempty := by
    exact ⟨w, Finset.mem_union_right _ hwX22⟩
  have huNotH1 : u ∉ H1 := by
    intro huH
    rcases Finset.mem_union.mp huH with hu11 | hu22
    · exact (Finset.disjoint_left.mp (B.disjoint_block C (.inr (by decide))))
        hu11 huX12
    · exact (Finset.disjoint_left.mp (B.disjoint_block C (.inl (by decide))))
        huX12 hu22
  have hH1proper : H1 ≠ Finset.univ := by
    intro h
    exact huNotH1 (by rw [h]; simp)
  have hH1lower := four_le_boundaryMultiplicity_of_connected_of_ne_two
    G hreg hconn hno2 H1 hH1nonempty hH1proper
  have hH2card : 2 ≤ H2.card := by
    have hsub : ({u, v} : Finset V) ⊆ H2 := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact Finset.mem_union_left _ huX12
      · exact Finset.mem_union_right _ hvX21
    have := Finset.card_le_card hsub
    simpa [huvne] using this
  have hBright : 2 ≤ B.right.card := by
    obtain ⟨k, hk⟩ := B.right_odd
    have hne1 : B.right.card ≠ 1 := by
      intro hcard
      obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hcard
      have hfour := boundaryMultiplicity_singleton_of_quartic G hreg z
      rw [← hz, B.right_boundary] at hfour
      omega
    omega
  have hBrightSub : B.right ⊆ H2ᶜ := by
    intro x hxR
    apply Finset.mem_compl.mpr
    intro hxH
    rcases Finset.mem_union.mp hxH with hx12 | hx21
    · exact (Finset.disjoint_left.mp B.left_right_disjoint)
        (TypeABarrier.mem_block.mp hx12).1 hxR
    · exact (Finset.disjoint_left.mp B.middle_right_disjoint)
        (TypeABarrier.mem_block.mp hx21).1 hxR
  have hH2comp : 2 ≤ H2ᶜ.card :=
    le_trans hBright (Finset.card_le_card hBrightSub)
  have hH2lower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 H2 hH2card hH2comp
  have huvSub33 : ({u, v} : Finset V) ⊆ X33ᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hx33
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact (Finset.disjoint_left.mp B.left_right_disjoint)
        B.distinguished_mem_left (TypeABarrier.mem_block.mp hx33).1
    · exact (Finset.disjoint_left.mp C.left_right_disjoint)
        C.distinguished_mem_left (TypeABarrier.mem_block.mp hx33).2
  have h33comp : 2 ≤ X33ᶜ.card := by
    have := Finset.card_le_card huvSub33
    simpa [huvne] using this
  have h33lower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 X33 h33large h33comp
  have hright₁ := hright.1
  have hright₂ := hright.2
  have haux₁ := haux.1
  have haux₂ := haux.2.1
  have haux₃ := haux.2.2.1
  change 4 ≤ P.boundaryMultiplicity H1 at hH1lower
  change 6 ≤ P.boundaryMultiplicity H2 at hH2lower
  change 6 ≤ P.boundaryMultiplicity X33 at h33lower
  have halower : 2 ≤ a + a' + d := by omega
  have hblower : 4 ≤ b + b' := by omega
  have hdlower : 6 ≤ d + e + f := by omega
  have harith : c = 0 ∧ b + b' = 4 ∧ a + a' + d = 2 ∧ d + e + f = 6 := by
    omega
  have hH2cut : P.boundaryMultiplicity H2 = 6 := by omega
  have hH2bip : Pseudograph.IsBipartiteOn G H2 :=
    isBipartiteOn_union_of_independent G X12 X21
      (B.disjoint_block C (.inl (by decide))) hX12ind hX21ind
  have hH2cardEq : H2.card = 2 := hnoBip6 H2 hH2cut hH2bip
  have hcardUnion := Finset.card_union_of_disjoint
    (B.disjoint_block C (.inl (by decide)) : Disjoint X12 X21)
  change H2.card = X12.card + X21.card at hcardUnion
  have hX12pos : 1 ≤ X12.card := Finset.card_pos.mpr ⟨u, huX12⟩
  have hX21pos : 1 ≤ X21.card := Finset.card_pos.mpr ⟨v, hvX21⟩
  have hX12card : X12.card = 1 := by omega
  have hX21card : X21.card = 1 := by omega
  have hX12eq : X12 = {u} := by
    obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hX12card
    have huz : u = z := by simpa [hz] using huX12
    simpa [huz] using hz
  have hX21eq : X21 = {v} := by
    obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hX21card
    have hvz : v = z := by simpa [hz] using hvX21
    simpa [hvz] using hz
  have hk : P.betweenMultiplicity X12 X21 = 1 := by
    rw [hX12eq, hX21eq]
    change (Pseudograph.ofSimple G).betweenMultiplicity {u} {v} = 1
    rw [Pseudograph.betweenMultiplicity_singleton_ofSimple G u {v}
      (by simp [huvne])]
    rw [Finset.filter_singleton, if_pos huv]
    simp
  have hbvals : b = 2 ∧ b' = 2 := by
    rw [hX12card, hX21card, hk,
      P.betweenMultiplicity_comm X21 X12, hk] at haux
    omega
  have huNotX23 : u ∉ X23 := by
    intro hu23
    exact (Finset.disjoint_left.mp B.left_middle_disjoint)
      B.distinguished_mem_left (TypeABarrier.mem_block.mp hu23).1
  have hvNotX32 : v ∉ X32 := by
    intro hv32
    exact (Finset.disjoint_left.mp C.left_middle_disjoint)
      C.distinguished_mem_left (TypeABarrier.mem_block.mp hv32).2
  have hX23card : 2 ≤ X23.card := by
    have hfilter : (X23.filter (G.Adj u)).card = 2 := by
      rw [← Pseudograph.betweenMultiplicity_singleton_ofSimple G u X23 huNotX23]
      rw [P.betweenMultiplicity_comm, ← hX12eq]
      exact hbvals.2
    exact le_trans (by simpa [hfilter] : 2 ≤ (X23.filter (G.Adj u)).card)
      (Finset.card_filter_le _ _)
  have hX32card : 2 ≤ X32.card := by
    have hfilter : (X32.filter (G.Adj v)).card = 2 := by
      rw [← Pseudograph.betweenMultiplicity_singleton_ofSimple G v X32 hvNotX32]
      rw [P.betweenMultiplicity_comm, ← hX21eq]
      exact hbvals.1
    exact le_trans (by simpa [hfilter] : 2 ≤ (X32.filter (G.Adj v)).card)
      (Finset.card_filter_le _ _)
  have hH3bip : Pseudograph.IsBipartiteOn G H3 :=
    isBipartiteOn_union_of_independent G X13 X23
      (B.disjoint_block C (.inl (by decide))) hX13ind hX23ind
  have hH4bip : Pseudograph.IsBipartiteOn G H4 :=
    isBipartiteOn_union_of_independent G X31 X32
      (B.disjoint_block C (.inr (by decide))) hX31ind hX32ind
  have huvSubH3 : ({u, v} : Finset V) ⊆ H3ᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxH
    rcases Finset.mem_union.mp hxH with hx13 | hx23
    · have hxR := (TypeABarrier.mem_block.mp hx13).2
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact (Finset.disjoint_left.mp C.middle_right_disjoint)
          (C.neighbor_mem_middle huv.symm) hxR
      · exact (Finset.disjoint_left.mp C.left_right_disjoint)
          C.distinguished_mem_left hxR
    · have hxR := (TypeABarrier.mem_block.mp hx23).2
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact (Finset.disjoint_left.mp C.middle_right_disjoint)
          (C.neighbor_mem_middle huv.symm) hxR
      · exact (Finset.disjoint_left.mp C.left_right_disjoint)
          C.distinguished_mem_left hxR
  have huvSubH4 : ({u, v} : Finset V) ⊆ H4ᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxH
    rcases Finset.mem_union.mp hxH with hx31 | hx32
    · have hxR := (TypeABarrier.mem_block.mp hx31).1
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact (Finset.disjoint_left.mp B.left_right_disjoint)
          B.distinguished_mem_left hxR
      · exact (Finset.disjoint_left.mp B.middle_right_disjoint)
          (B.neighbor_mem_middle huv) hxR
    · have hxR := (TypeABarrier.mem_block.mp hx32).1
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact (Finset.disjoint_left.mp B.left_right_disjoint)
          B.distinguished_mem_left hxR
      · exact (Finset.disjoint_left.mp B.middle_right_disjoint)
          (B.neighbor_mem_middle huv) hxR
  have hH3comp : 2 ≤ H3ᶜ.card := by
    have := Finset.card_le_card huvSubH3
    simpa [huvne] using this
  have hH4comp : 2 ≤ H4ᶜ.card := by
    have := Finset.card_le_card huvSubH4
    simpa [huvne] using this
  have hH3lower := eight_le_boundaryMultiplicity_of_bipartite_with_independent_pair
    G hreg hconn hno2 hno4 hnoBip6 H3 X23 Finset.subset_union_right
      hX23ind hX23card hH3comp hH3bip
  have hH4lower := eight_le_boundaryMultiplicity_of_bipartite_with_independent_pair
    G hreg hconn hno2 hno4 hnoBip6 H4 X32 Finset.subset_union_right
      hX32ind hX32card hH4comp hH4bip
  let BRc : Finset V := B.rightᶜ
  have hcross :=
    P.boundaryMultiplicity_inter_add_compl_inter_compl_le BRc C.right
  have hfirst :
      (letI : DecidableEq V := Classical.decEq _;
        BRc ∩ C.right) = H3 := by
    change B.rightᶜ ∩ C.right = H3
    rw [← B.middle_union_left_eq_right_compl]
    ext x
    simp only [H3, X13, X23, TypeABarrier.block,
      TypeABarrier.side_L, TypeABarrier.side_M,
      TypeABarrier.side_R, Finset.mem_inter, Finset.mem_union,
      Finset.mem_compl]
    tauto
  have hsecond :
      (letI : DecidableEq V := Classical.decEq _;
        BRcᶜ ∩ C.rightᶜ) = H4 := by
    change (B.rightᶜ)ᶜ ∩ C.rightᶜ = H4
    rw [compl_compl, ← C.middle_union_left_eq_right_compl]
    ext x
    simp only [H4, X31, X32, TypeABarrier.block,
      TypeABarrier.side_L, TypeABarrier.side_M,
      TypeABarrier.side_R, Finset.mem_inter, Finset.mem_union,
      Finset.mem_compl, not_not]
    tauto
  have hBRcut : P.boundaryMultiplicity BRc = 6 := by
    have hcompl :
        (letI : DecidableEq V := Classical.decEq _;
          B.rightᶜ) = BRc := by
      ext x
      simp [BRc]
    rw [← hcompl]
    exact (P.boundaryMultiplicity_compl B.right).trans B.right_boundary
  rw [hfirst, hsecond, hBRcut, C.right_boundary] at hcross
  change 8 ≤ P.boundaryMultiplicity H3 at hH3lower
  change 8 ≤ P.boundaryMultiplicity H4 at hH4lower
  change P.boundaryMultiplicity H3 + P.boundaryMultiplicity H4 ≤ 6 + 6 at hcross
  omega

def HasNoTriangles (G : SimpleGraph V) : Prop :=
  ∀ ⦃u v w : V⦄, G.Adj u v → G.Adj u w → G.Adj v w → False

/-- Tashkinov's Proposition 4.3 for the vertex-minimal counterexample. -/
theorem IsVertexMinimalCounterexample.hasNoTriangles
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities) :
    HasNoTriangles G.toSimple := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  letI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  let K := G.toSimple
  have hPG : Pseudograph.ofSimple K = G := by
    simpa [K] using
      Pseudograph.eq_ofSimple_toSimple_of_hasSimpleMultiplicities G hsimple
  have hreg : K.IsRegularOfDegree 4 := by
    rw [← Pseudograph.isRegularOfDegree_ofSimple_iff]
    simpa [hPG] using hmin.in_class.1
  have hconn : K.Connected := by
    simpa [K] using hmin.underlying_connected
  have hodd : Odd (Nat.card (Fin n)) := by
    simpa [K] using hmin.odd_order_of_hasSimpleMultiplicities hsimple
  have hno2 : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple K).boundaryMultiplicity S ≠ 2 := by
    intro S hS hproper
    have h := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple S hS hproper
    simpa [hPG] using h
  have hno4 : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple K).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1 := by
    intro S hS hproper hcut
    have hcutG : G.boundaryMultiplicity S = 4 := by simpa [hPG] using hcut
    rcases hmin.only_trivial_four_cuts_of_hasSimpleMultiplicities hsimple
        S hS hproper hcutG with hcard | hcard
    · exact .inl hcard
    · right
      simpa only [Finset.card_compl] using hcard
  have hnoBip : Pseudograph.HasNoNontrivialBipartiteSixShore K := by
    simpa [K] using
      Pseudograph.IsVertexMinimalCounterexample.hasNoNontrivialBipartiteSixShore
        hmin hsimple
  have hnoCubic : ¬ ContainsRegularSubgraph K 3 := by
    intro h
    apply hmin.no_cubic_part
    have hp := Pseudograph.containsRegularPart_of_containsRegularSubgraph K h
    simpa only [hPG] using hp
  have hindependent : ∀ U : Finset (Fin n),
      K.IsIndepSet (U : Set (Fin n)) →
        2 < (Pseudograph.ofSimple K).internalMultiplicity Uᶜ := by
    intro U hU
    exact Pseudograph.two_lt_internalMultiplicity_compl_of_independent
      K hreg hodd hnoCubic hnoBip U hU
  intro u v w huv huw hvw
  have hnoMatching (x : Fin n) :
      ¬ ∃ M : (K.induce (antiNeighborhood K x)).Subgraph,
        M.IsPerfectMatching := by
    intro hm
    obtain ⟨M, hM⟩ := hm
    exact hnoCubic
      (containsThreeRegular_of_isPerfectMatching_antiNeighborhood K x hreg M hM)
  obtain ⟨B⟩ := exists_typeABarrier_of_adjacent_neighbors
    K hreg hodd hconn hno2 hno4 hindependent u v w huv huw hvw
      (hnoMatching u)
  obtain ⟨C⟩ := exists_typeABarrier_of_adjacent_neighbors
    K hreg hodd hconn hno2 hno4 hindependent v u w huv.symm hvw huw
      (hnoMatching v)
  exact false_of_typeABarriers_triangle K hreg hconn hno2 hno4 hnoBip
    huv huw hvw B C

structure MinimalSixShore (G : SimpleGraph V) where
  shore : Finset V
  cut : (Pseudograph.ofSimple G).boundaryMultiplicity shore = 6
  nontrivial : shore.card ≠ 2 ∧ shoreᶜ.card ≠ 2
  minimal : ∀ T : Finset V,
    (Pseudograph.ofSimple G).boundaryMultiplicity T = 6 →
      T.card ≠ 2 → Tᶜ.card ≠ 2 → shore.card ≤ T.card

lemma exists_minimalSixShore
    (G : SimpleGraph V) (hnot : ¬ HasOnlyTrivialSixCuts G) :
    Nonempty (MinimalSixShore G) := by
  classical
  unfold HasOnlyTrivialSixCuts at hnot
  push Not at hnot
  obtain ⟨S, hcut, hS2, hSc2⟩ := hnot
  let p : ℕ → Prop := fun k ↦ ∃ T : Finset V,
    (Pseudograph.ofSimple G).boundaryMultiplicity T = 6 ∧
      T.card ≠ 2 ∧ Tᶜ.card ≠ 2 ∧ T.card = k
  have hp : ∃ k, p k := ⟨S.card, S, hcut, hS2, hSc2, rfl⟩
  obtain ⟨T, hTcut, hT2, hTc2, hTcard⟩ := Nat.find_spec hp
  refine ⟨⟨T, hTcut, ⟨hT2, hTc2⟩, ?_⟩⟩
  intro R hRcut hR2 hRc2
  rw [hTcard]
  exact Nat.find_min' hp ⟨R, hRcut, hR2, hRc2, rfl⟩

namespace MinimalSixShore

lemma three_le_card {G : SimpleGraph V} (M : MinimalSixShore G)
    (hreg : G.IsRegularOfDegree 4) : 3 ≤ M.shore.card := by
  have hne0 : M.shore.card ≠ 0 := by
    intro h
    have hS : M.shore = ∅ := Finset.card_eq_zero.mp h
    have hcut := M.cut
    rw [hS, Pseudograph.boundaryMultiplicity_empty] at hcut
    omega
  have hne1 : M.shore.card ≠ 1 := by
    intro h
    obtain ⟨v, hv⟩ := Finset.card_eq_one.mp h
    have hfour := boundaryMultiplicity_singleton_of_quartic G hreg v
    have hcut := M.cut
    rw [hv, hfour] at hcut
    omega
  have hne2 : M.shore.card ≠ 2 := M.nontrivial.1
  exact by omega

lemma three_le_compl_card {G : SimpleGraph V} (M : MinimalSixShore G)
    (hreg : G.IsRegularOfDegree 4) : 3 ≤ M.shoreᶜ.card := by
  have hcutC : (Pseudograph.ofSimple G).boundaryMultiplicity M.shoreᶜ = 6 := by
    simpa using (Pseudograph.boundaryMultiplicity_compl
      (Pseudograph.ofSimple G) M.shore).trans M.cut
  have hne0 : M.shoreᶜ.card ≠ 0 := by
    intro h
    have hS : M.shoreᶜ = ∅ := Finset.card_eq_zero.mp h
    rw [hS, Pseudograph.boundaryMultiplicity_empty] at hcutC
    omega
  have hne1 : M.shoreᶜ.card ≠ 1 := by
    intro h
    obtain ⟨v, hv⟩ := Finset.card_eq_one.mp h
    have hfour := boundaryMultiplicity_singleton_of_quartic G hreg v
    rw [hv, hfour] at hcutC
    omega
  have hne2 : M.shoreᶜ.card ≠ 2 := M.nontrivial.2
  exact by omega

/-- No vertex on the shore carries three incidences of the minimal
six-cut. -/
lemma outsideDegree_le_two
    {G : SimpleGraph V} (M : MinimalSixShore G)
    (hreg : G.IsRegularOfDegree 4)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (v : V) (hv : v ∈ M.shore) :
    (Pseudograph.ofSimple G).outsideDegree M.shore v ≤ 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let T := M.shore.erase v
  have hTcard : T.card + 1 = M.shore.card := by
    simpa [T] using Finset.card_erase_add_one hv
  have hTnonempty : T.Nonempty := Finset.card_pos.mp (by
    have := M.three_le_card hreg
    omega)
  have hTproper : T ≠ Finset.univ := by
    intro h
    have hvT : v ∈ T := by rw [h]; simp
    exact (Finset.notMem_erase v M.shore) hvT
  have hsplit := Pseudograph.between_erase_add_outsideDegree_eq_four
    G hreg M.shore v hv
  have htoggle := Pseudograph.erase_vertex_cut_equation G hreg M.shore v hv
  rw [M.cut] at htoggle
  change 6 + 2 * P.betweenMultiplicity T {v} =
    P.boundaryMultiplicity T + 4 at htoggle
  by_contra hnot
  change ¬ P.outsideDegree M.shore v ≤ 2 at hnot
  have hcases : P.outsideDegree M.shore v = 3 ∨
      P.outsideDegree M.shore v = 4 := by
    change P.betweenMultiplicity {v} T + P.outsideDegree M.shore v = 4 at hsplit
    omega
  rcases hcases with hout | hout
  · have hcutT : P.boundaryMultiplicity T = 4 := by
      change P.betweenMultiplicity {v} T + P.outsideDegree M.shore v = 4 at hsplit
      rw [P.betweenMultiplicity_comm {v} T] at hsplit
      omega
    rcases hno4 T hTnonempty hTproper hcutT with h1 | h1
    · have := M.three_le_card hreg
      omega
    · have hsub : M.shoreᶜ ⊆ Tᶜ := by
        intro x hx
        simp only [Finset.mem_compl] at hx ⊢
        intro hxT
        exact hx (Finset.mem_of_mem_erase hxT)
      have hcomp := M.three_le_compl_card hreg
      have := Finset.card_le_card hsub
      omega
  · have hcutT : P.boundaryMultiplicity T = 2 := by
      change P.betweenMultiplicity {v} T + P.outsideDegree M.shore v = 4 at hsplit
      rw [P.betweenMultiplicity_comm {v} T] at hsplit
      omega
    exact hno2 T hTnonempty hTproper hcutT

/-- Nor can a vertex outside the shore send three edges into it. -/
lemma insideDegree_of_notMem_le_two
    {G : SimpleGraph V} (M : MinimalSixShore G)
    (hreg : G.IsRegularOfDegree 4)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (v : V) (hv : v ∉ M.shore) :
    (Pseudograph.ofSimple G).betweenMultiplicity {v} M.shore ≤ 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let T := insert v M.shore
  have hdisj : Disjoint M.shore {v} := by simp [hv]
  have htoggle := P.boundaryMultiplicity_union_add_two_between
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
    M.shore {v} hdisj
  have hsingle := boundaryMultiplicity_singleton_of_quartic G hreg v
  rw [M.cut, hsingle, P.betweenMultiplicity_comm M.shore {v}] at htoggle
  have hTunion : M.shore ∪ {v} = T := by
    ext x
    simp [T, or_comm]
  rw [hTunion] at htoggle
  change P.boundaryMultiplicity T + 2 * P.betweenMultiplicity {v} M.shore = 10 at htoggle
  have hTnonempty : T.Nonempty := ⟨v, by simp [T]⟩
  have hTproper : T ≠ Finset.univ := by
    intro h
    have hcomp0 : Tᶜ.card = 0 := by simp [h]
    have hcomp := M.three_le_compl_card hreg
    have hcardErase : Tᶜ.card + 1 = M.shoreᶜ.card := by
      have hvC : v ∈ M.shoreᶜ := by simp [hv]
      have heq : Tᶜ = M.shoreᶜ.erase v := by
        ext x
        by_cases hxv : x = v <;> simp [T, hxv]
      rw [heq]
      simpa using Finset.card_erase_add_one hvC
    omega
  by_contra hnot
  change ¬ P.betweenMultiplicity {v} M.shore ≤ 2 at hnot
  have hcases : P.betweenMultiplicity {v} M.shore = 3 ∨
      P.betweenMultiplicity {v} M.shore = 4 := by
    have hvT : v ∈ T := by simp [T]
    have hdegree := Pseudograph.between_erase_add_outsideDegree_eq_four
      G hreg T v hvT
    have hTerase : T.erase v = M.shore := by
      ext x
      simp [T, hv]
    rw [hTerase] at hdegree
    have hle : P.betweenMultiplicity {v} M.shore ≤ 4 := by
      change P.betweenMultiplicity {v} M.shore +
        P.outsideDegree T v = 4 at hdegree
      omega
    omega
  rcases hcases with hin | hin
  · have hcutT : P.boundaryMultiplicity T = 4 := by omega
    rcases hno4 T hTnonempty hTproper hcutT with h1 | h1
    · have hsub : M.shore ⊆ T := fun x hx ↦ Finset.mem_insert_of_mem hx
      have := Finset.card_le_card hsub
      have hcard := M.three_le_card hreg
      omega
    · have hcardErase : Tᶜ.card + 1 = M.shoreᶜ.card := by
        have hvC : v ∈ M.shoreᶜ := by simp [hv]
        have heq : Tᶜ = M.shoreᶜ.erase v := by
          ext x
          by_cases hxv : x = v <;> simp [T, hxv]
        rw [heq]
        simpa using Finset.card_erase_add_one hvC
      have hcomp := M.three_le_compl_card hreg
      omega
  · have hcutT : P.boundaryMultiplicity T = 2 := by omega
    exact hno2 T hTnonempty hTproper hcutT

end MinimalSixShore

/-! A uniform barrier partition for Proposition 4.4.  Type B retains its
two six-components because the proof uses them separately. -/

structure Section4Barrier (G : SimpleGraph V) (u : V) where
  kind : BarrierKind
  left : Finset V
  middle : Finset V
  right : Finset V
  distinguished_mem_left : u ∈ left
  neighbor_mem_middle : ∀ {v : V}, G.Adj u v → v ∈ middle
  left_middle_disjoint : Disjoint left middle
  left_right_disjoint : Disjoint left right
  middle_right_disjoint : Disjoint middle right
  cover : left ∪ middle ∪ right = Finset.univ
  left_independent : G.IsIndepSet (left : Set V)
  left_right_nonadjacent : ∀ {x y : V}, x ∈ left → y ∈ right → ¬ G.Adj x y
  kind_data : match kind with
    | .A =>
        (Pseudograph.ofSimple G).internalMultiplicity middle = 1 ∧
        (Pseudograph.ofSimple G).boundaryMultiplicity right = 6 ∧
        Odd right.card
    | .B =>
        (Pseudograph.ofSimple G).internalMultiplicity middle = 0 ∧
        (Pseudograph.ofSimple G).boundaryMultiplicity right = 12 ∧
        ∃ right₁ right₂ : Finset V,
          Disjoint right₁ right₂ ∧ right₁ ∪ right₂ = right ∧
          (Pseudograph.ofSimple G).boundaryMultiplicity right₁ = 6 ∧
          (Pseudograph.ofSimple G).boundaryMultiplicity right₂ = 6 ∧
          Odd right₁.card ∧ Odd right₂.card
    | .C =>
        (Pseudograph.ofSimple G).internalMultiplicity middle = 0 ∧
        (Pseudograph.ofSimple G).boundaryMultiplicity right = 8 ∧
        Odd right.card
    | .degenerate => False

namespace Section4Barrier

noncomputable def ofTypeA {G : SimpleGraph V} {u : V}
    (B : TypeABarrier G u) : Section4Barrier G u where
  kind := .A
  left := B.left
  middle := B.middle
  right := B.right
  distinguished_mem_left := B.distinguished_mem_left
  neighbor_mem_middle := B.neighbor_mem_middle
  left_middle_disjoint := B.left_middle_disjoint
  left_right_disjoint := B.left_right_disjoint
  middle_right_disjoint := B.middle_right_disjoint
  cover := B.cover
  left_independent := B.left_independent
  left_right_nonadjacent := B.left_right_nonadjacent
  kind_data := ⟨B.middle_internal, B.right_boundary, B.right_odd⟩

lemma genuine {G : SimpleGraph V} {u : V} (B : Section4Barrier G u) :
    B.kind = .A ∨ B.kind = .B ∨ B.kind = .C := by
  rcases h : B.kind with _ | _ | _ | _
  · exact .inl rfl
  · exact .inr (.inl rfl)
  · exact .inr (.inr rfl)
  · simpa [h] using B.kind_data

/-- Build the abstract partition from a selected union of residual
components.  Every unselected component is required to be a singleton; this
single hypothesis proves both independence of the left shore and absence of
left--right edges. -/
noncomputable def ofSelectedComponents
    (G : SimpleGraph V) (u : V) (X : Set (antiNeighborhood G u))
    (kind : BarrierKind) (R : Finset V)
    (hRD : Disjoint R (ambientDeletionSet (antiNeighborhood G u) X))
    (hcomponents : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      deletedComponentShore G (antiNeighborhood G u) X c ⊆ R ∨
        (deletedComponentShore G (antiNeighborhood G u) X c).card = 1)
    (hdata : let M := barrierMiddle G u X
      match kind with
      | .A =>
          (Pseudograph.ofSimple G).internalMultiplicity M = 1 ∧
          (Pseudograph.ofSimple G).boundaryMultiplicity R = 6 ∧ Odd R.card
      | .B =>
          (Pseudograph.ofSimple G).internalMultiplicity M = 0 ∧
          (Pseudograph.ofSimple G).boundaryMultiplicity R = 12 ∧
          ∃ R₁ R₂ : Finset V, Disjoint R₁ R₂ ∧ R₁ ∪ R₂ = R ∧
            (Pseudograph.ofSimple G).boundaryMultiplicity R₁ = 6 ∧
            (Pseudograph.ofSimple G).boundaryMultiplicity R₂ = 6 ∧
            Odd R₁.card ∧ Odd R₂.card
      | .C =>
          (Pseudograph.ofSimple G).internalMultiplicity M = 0 ∧
          (Pseudograph.ofSimple G).boundaryMultiplicity R = 8 ∧ Odd R.card
      | .degenerate => False) :
    Section4Barrier G u := by
  classical
  let M := barrierMiddle G u X
  let L := (M ∪ R)ᶜ
  let D := ambientDeletionSet (antiNeighborhood G u) X
  have hD : D = insert u M := by
    simpa [D, M] using
      ambientDeletionSet_antiNeighborhood_eq_insert_barrierMiddle G u X
  have hMR : Disjoint M R := by
    rw [Finset.disjoint_left]
    intro v hvM hvR
    have hvD : v ∈ D := by rw [hD]; exact Finset.mem_insert_of_mem hvM
    exact (Finset.disjoint_left.mp hRD) hvR hvD
  have hLM : Disjoint L M := by
    rw [Finset.disjoint_left]
    intro v hvL hvM
    exact (show v ∉ M ∪ R by simpa [L] using hvL)
      (Finset.mem_union_left _ hvM)
  have hLR : Disjoint L R := by
    rw [Finset.disjoint_left]
    intro v hvL hvR
    exact (show v ∉ M ∪ R by simpa [L] using hvL)
      (Finset.mem_union_right _ hvR)
  have hcover : L ∪ M ∪ R = Finset.univ := by
    ext v
    by_cases hvM : v ∈ M <;> by_cases hvR : v ∈ R <;> simp [L, hvM, hvR]
  have huL : u ∈ L := by
    simp only [L, Finset.mem_compl, Finset.mem_union, not_or]
    constructor
    · exact notMem_barrierMiddle_self G u X
    · intro huR
      have huD : u ∈ D := by rw [hD]; simp
      exact (Finset.disjoint_left.mp hRD) huR huD
  have hneighbor : ∀ {v : V}, G.Adj u v → v ∈ M := by
    intro v huv
    exact mem_barrierMiddle.mpr (.inl huv)
  have hLindependent : G.IsIndepSet (L : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab hAdj
    have haM : a ∉ M := by
      intro haM
      exact (show a ∉ M ∪ R by simpa [L] using ha)
        (Finset.mem_union_left _ haM)
    have hbM : b ∉ M := by
      intro hbM
      exact (show b ∉ M ∪ R by simpa [L] using hb)
        (Finset.mem_union_left _ hbM)
    have haR : a ∉ R := by
      intro haR
      exact (show a ∉ M ∪ R by simpa [L] using ha)
        (Finset.mem_union_right _ haR)
    by_cases hau : a = u
    · subst a
      exact hbM (hneighbor hAdj)
    have haD : a ∉ D := by rw [hD]; simp [hau, haM]
    obtain ⟨c, hac⟩ :=
      exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet
        G (antiNeighborhood G u) X haD
    have hsingleton :
        (deletedComponentShore G (antiNeighborhood G u) X c).card = 1 := by
      rcases hcomponents c with hsub | hone
      · exact False.elim (haR (hsub hac))
      · exact hone
    have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
      simp [Pseudograph.ofSimple_mult, hAdj]
    rcases deletedComponentShore_closed G (antiNeighborhood G u) X c
        hac b habmult with hbc | hbD
    · obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hsingleton
      rw [hz] at hac hbc
      have haz : a = z := by simpa using hac
      have hbz : b = z := by simpa using hbc
      exact hab (haz.trans hbz.symm)
    · have hbu : b = u := by
        change b ∈ D at hbD
        rw [hD] at hbD
        simpa [hbM] using hbD
      subst b
      exact haM (hneighbor hAdj.symm)
  have hLRnonadjacent : ∀ {a b : V}, a ∈ L → b ∈ R → ¬ G.Adj a b := by
    intro a b ha hb hAdj
    have haM : a ∉ M := by
      intro haM
      exact (show a ∉ M ∪ R by simpa [L] using ha)
        (Finset.mem_union_left _ haM)
    have haR : a ∉ R := by
      intro haR
      exact (Finset.disjoint_left.mp hLR) ha haR
    by_cases hau : a = u
    · subst a
      exact (Finset.disjoint_left.mp hMR) (hneighbor hAdj) hb
    have haD : a ∉ D := by rw [hD]; simp [hau, haM]
    obtain ⟨c, hac⟩ :=
      exists_mem_deletedComponentShore_of_notMem_ambientDeletionSet
        G (antiNeighborhood G u) X haD
    have hsingleton :
        (deletedComponentShore G (antiNeighborhood G u) X c).card = 1 := by
      rcases hcomponents c with hsub | hone
      · exact False.elim (haR (hsub hac))
      · exact hone
    have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
      simp [Pseudograph.ofSimple_mult, hAdj]
    rcases deletedComponentShore_closed G (antiNeighborhood G u) X c
        hac b habmult with hbc | hbD
    · obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hsingleton
      rw [hz] at hac hbc
      have habEq : a = b := by
        have haz : a = z := by simpa using hac
        have hbz : b = z := by simpa using hbc
        exact haz.trans hbz.symm
      exact (Finset.disjoint_left.mp hLR) ha (habEq ▸ hb)
    · have hbD' : b ∈ D := hbD
      exact (Finset.disjoint_left.mp hRD) hb hbD'
  exact {
    kind := kind
    left := L
    middle := M
    right := R
    distinguished_mem_left := huL
    neighbor_mem_middle := hneighbor
    left_middle_disjoint := hLM
    left_right_disjoint := hLR
    middle_right_disjoint := hMR
    cover := hcover
    left_independent := hLindependent
    left_right_nonadjacent := hLRnonadjacent
    kind_data := by simpa [M] using hdata }

end Section4Barrier

lemma residual_four_component_singleton
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V) (X : Set (antiNeighborhood G u))
    (c : (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent)
    (hcut : (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c) = 4) :
    (deletedComponentShore G (antiNeighborhood G u) X c).card = 1 := by
  classical
  let A := antiNeighborhood G u
  let D := ambientDeletionSet A X
  let S := deletedComponentShore G A X c
  have hSnonempty : S.Nonempty := by
    simpa [S] using deletedComponentShore_nonempty G A X c
  have huD : u ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    simp [A, antiNeighborhood]
  obtain ⟨v, huv⟩ := (G.degree_pos_iff_exists_adj u).mp (by simp [hreg u])
  have hvD : v ∈ D := by
    apply mem_ambientDeletionSet.mpr
    left
    exact fun hvA ↦ hvA.2 huv
  have huSnot : u ∉ S := fun huS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) huS huD
  have hvSnot : v ∉ S := fun hvS ↦
    (Finset.disjoint_left.mp
      (deletedComponentShore_disjoint_ambientDeletionSet G A X c)) hvS hvD
  have hSproper : S ≠ Finset.univ := by
    intro hS
    exact huSnot (by rw [hS]; simp)
  have hcompcard_ne_one : Sᶜ.card ≠ 1 := by
    intro hcard
    have hsubset : ({u, v} : Finset V) ⊆ Sᶜ := by
      intro w hw
      simp only [Finset.mem_insert, Finset.mem_singleton] at hw
      rcases hw with rfl | rfl
      · simp [huSnot]
      · simp [hvSnot]
    have htwo := Finset.card_le_card hsubset
    have : 2 ≤ Sᶜ.card := by simpa [huv.ne] using htwo
    omega
  rcases hno4 S hSnonempty hSproper (by simpa [A, S] using hcut) with h | h
  · simpa [A, S] using h
  · exact (hcompcard_ne_one h).elim

/-- Construct the pre-six-cut type-C barrier directly from its unique
eight-component; unlike the later `TypeCBarrier`, this needs no no-six-cut
hypothesis. -/
theorem exists_section4Barrier_C
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V) (X : Set (antiNeighborhood G u))
    (hall : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents)
    (hvalues : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      let cut := (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c)
      cut = 4 ∨ cut = 6 ∨ cut = 8)
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .C) :
    Nonempty (Section4Barrier G u) := by
  classical
  obtain ⟨c, hc8, hcUnique⟩ :=
    existsUnique_eightComponent_of_typeC_pattern G u X hpattern
  let R := deletedComponentShore G (antiNeighborhood G u) X c
  let D := ambientDeletionSet (antiNeighborhood G u) X
  have hRD : Disjoint R D := by
    simpa [R, D] using deletedComponentShore_disjoint_ambientDeletionSet
      G (antiNeighborhood G u) X c
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
  let cut : J.ConnectedComponent → ℕ := fun d ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X d)
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun d ↦ cut d = 6
  have hC6zero : C6.card = 0 := by
    change _ ∧ C6.card = 0 ∧ _ at hpattern
    exact hpattern.2.1
  have hcomponents : ∀ d : J.ConnectedComponent,
      deletedComponentShore G (antiNeighborhood G u) X d ⊆ R ∨
        (deletedComponentShore G (antiNeighborhood G u) X d).card = 1 := by
    intro d
    by_cases hdc : d = c
    · subst d
      exact .inl (by rfl)
    · right
      have hcut4 : cut d = 4 := by
        rcases hvalues d with h4 | h6 | h8
        · exact h4
        · have hd : d ∈ C6 := by simp [C6, cut, h6]
          have : C6.Nonempty := ⟨d, hd⟩
          rw [Finset.card_eq_zero.mp hC6zero] at this
          simp at this
        · exact False.elim (hdc (hcUnique d (by simpa [cut] using h8)))
      exact residual_four_component_singleton G hreg hno4 u X d
        (by simpa [cut] using hcut4)
  have hoddR : Odd R.card := by
    have hcodd := hall c
    change Odd c.supp.ncard at hcodd
    simpa [R, card_deletedComponentShore G
      (antiNeighborhood G u) X c] using hcodd
  refine ⟨Section4Barrier.ofSelectedComponents G u X .C R hRD hcomponents ?_⟩
  change (Pseudograph.ofSimple G).internalMultiplicity
      (barrierMiddle G u X) = 0 ∧
    (Pseudograph.ofSimple G).boundaryMultiplicity R = 8 ∧ Odd R.card
  exact ⟨hpattern.1, by simpa [R] using hc8, hoddR⟩

/-- Construct the type-B barrier from its two residual six-components. -/
theorem exists_section4Barrier_B
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (u : V) (X : Set (antiNeighborhood G u))
    (hall : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      c ∈ (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.oddComponents)
    (hvalues : ∀ c :
      (deleteInducedSubgraph G (antiNeighborhood G u) X).coe.ConnectedComponent,
      let cut := (Pseudograph.ofSimple G).boundaryMultiplicity
        (deletedComponentShore G (antiNeighborhood G u) X c)
      cut = 4 ∨ cut = 6 ∨ cut = 8)
    (hpattern : IsAntiNeighborhoodBarrierPattern G u X .B) :
    Nonempty (Section4Barrier G u) := by
  classical
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
  let cut : J.ConnectedComponent → ℕ := fun d ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X d)
  let C6 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun d ↦ cut d = 6
  let C8 := (Finset.univ : Finset J.ConnectedComponent).filter
    fun d ↦ cut d = 8
  change (Pseudograph.ofSimple G).internalMultiplicity
      (barrierMiddle G u X) = 0 ∧ C6.card = 2 ∧ C8.card = 0 at hpattern
  obtain ⟨c₁, c₂, hcne, hC6⟩ := Finset.card_eq_two.mp hpattern.2.1
  let R₁ := deletedComponentShore G (antiNeighborhood G u) X c₁
  let R₂ := deletedComponentShore G (antiNeighborhood G u) X c₂
  let R := R₁ ∪ R₂
  let D := ambientDeletionSet (antiNeighborhood G u) X
  have hR12 : Disjoint R₁ R₂ := by
    simpa [R₁, R₂] using deletedComponentShore_disjoint
      G (antiNeighborhood G u) X hcne
  have hR1D : Disjoint R₁ D := by
    simpa [R₁, D] using deletedComponentShore_disjoint_ambientDeletionSet
      G (antiNeighborhood G u) X c₁
  have hR2D : Disjoint R₂ D := by
    simpa [R₂, D] using deletedComponentShore_disjoint_ambientDeletionSet
      G (antiNeighborhood G u) X c₂
  have hRD : Disjoint R D := by
    exact Finset.disjoint_union_left.mpr ⟨hR1D, hR2D⟩
  have hc1Cut : cut c₁ = 6 := by
    have : c₁ ∈ C6 := by simp [hC6]
    simpa [C6] using this
  have hc2Cut : cut c₂ = 6 := by
    have : c₂ ∈ C6 := by simp [hC6]
    simpa [C6] using this
  have hC8zero : C8.card = 0 := hpattern.2.2
  have hcomponents : ∀ d : J.ConnectedComponent,
      deletedComponentShore G (antiNeighborhood G u) X d ⊆ R ∨
        (deletedComponentShore G (antiNeighborhood G u) X d).card = 1 := by
    intro d
    by_cases hd1 : d = c₁
    · subst d
      exact .inl Finset.subset_union_left
    by_cases hd2 : d = c₂
    · subst d
      exact .inl Finset.subset_union_right
    right
    have hcut4 : cut d = 4 := by
      rcases hvalues d with h4 | h6 | h8
      · exact h4
      · have hd : d ∈ C6 := by simp [C6, cut, h6]
        rw [hC6] at hd
        simp only [Finset.mem_insert, Finset.mem_singleton] at hd
        exact (hd.elim hd1 hd2).elim
      · have hd : d ∈ C8 := by simp [C8, cut, h8]
        have : C8.Nonempty := ⟨d, hd⟩
        rw [Finset.card_eq_zero.mp hC8zero] at this
        simp at this
    exact residual_four_component_singleton G hreg hno4 u X d
      (by simpa [cut] using hcut4)
  have hbetween : (Pseudograph.ofSimple G).betweenMultiplicity R₁ R₂ = 0 := by
    apply betweenMultiplicity_eq_zero_of_no_adj
    intro a ha b hb hab
    have habmult : (Pseudograph.ofSimple G).mult a b ≠ 0 := by
      simp [Pseudograph.ofSimple_mult, hab]
    rcases deletedComponentShore_closed G (antiNeighborhood G u) X c₁
        (by simpa [R₁] using ha) b habmult with hb1 | hbD
    · exact (Finset.disjoint_left.mp hR12) hb1 hb
    · exact (Finset.disjoint_left.mp hR2D) hb hbD
  have hRcut : (Pseudograph.ofSimple G).boundaryMultiplicity R = 12 := by
    have hunion := (Pseudograph.ofSimple G).boundaryMultiplicity_union_add_two_between
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) R₁ R₂ hR12
    rw [hbetween] at hunion
    change (Pseudograph.ofSimple G).boundaryMultiplicity R + 2 * 0 =
      (Pseudograph.ofSimple G).boundaryMultiplicity R₁ +
        (Pseudograph.ofSimple G).boundaryMultiplicity R₂ at hunion
    change (Pseudograph.ofSimple G).boundaryMultiplicity R₁ = 6 at hc1Cut
    change (Pseudograph.ofSimple G).boundaryMultiplicity R₂ = 6 at hc2Cut
    omega
  have hodd1 : Odd R₁.card := by
    have h := hall c₁
    change Odd c₁.supp.ncard at h
    simpa [R₁, card_deletedComponentShore G
      (antiNeighborhood G u) X c₁] using h
  have hodd2 : Odd R₂.card := by
    have h := hall c₂
    change Odd c₂.supp.ncard at h
    simpa [R₂, card_deletedComponentShore G
      (antiNeighborhood G u) X c₂] using h
  refine ⟨Section4Barrier.ofSelectedComponents G u X .B R hRD hcomponents ?_⟩
  change (Pseudograph.ofSimple G).internalMultiplicity
      (barrierMiddle G u X) = 0 ∧
    (Pseudograph.ofSimple G).boundaryMultiplicity R = 12 ∧
      ∃ A B : Finset V, Disjoint A B ∧ A ∪ B = R ∧
        (Pseudograph.ofSimple G).boundaryMultiplicity A = 6 ∧
        (Pseudograph.ofSimple G).boundaryMultiplicity B = 6 ∧
        Odd A.card ∧ Odd B.card
  exact ⟨hpattern.1, hRcut, R₁, R₂, hR12, rfl,
    by simpa [R₁, cut] using hc1Cut, by simpa [R₂, cut] using hc2Cut,
    hodd1, hodd2⟩

theorem exists_section4Barrier
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hodd : Odd (Nat.card V)) (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hindependentComplement : ∀ U : Finset V,
      G.IsIndepSet (U : Set V) →
        2 < (Pseudograph.ofSimple G).internalMultiplicity Uᶜ)
    (u : V)
    (hno : ¬ ∃ M : (G.induce (antiNeighborhood G u)).Subgraph,
      M.IsPerfectMatching) :
    Nonempty (Section4Barrier G u) := by
  classical
  obtain ⟨X, hfull⟩ :=
    exists_antiNeighborhood_barrier_pattern_of_noPerfectMatching
      G hreg hodd hconn hno2 hno4 u hno
  let J := (deleteInducedSubgraph G (antiNeighborhood G u) X).coe
  let cut : J.ConnectedComponent → ℕ := fun c ↦
    (Pseudograph.ofSimple G).boundaryMultiplicity
      (deletedComponentShore G (antiNeighborhood G u) X c)
  change J.oddComponents.ncard = X.ncard + 2 ∧
    (∀ c : J.ConnectedComponent, c ∈ J.oddComponents) ∧
    (∀ c, cut c = 4 ∨ cut c = 6 ∨ cut c = 8) ∧
    ∃ kind : BarrierKind,
      IsAntiNeighborhoodBarrierPattern G u X kind at hfull
  rcases hfull with ⟨_hq, hall, hvalues, kind, hpattern⟩
  rcases kind with _ | _ | _ | _
  · obtain ⟨B⟩ := exists_typeABarrier_of_pattern
      G hreg hno4 u X hall hvalues hpattern
    exact ⟨Section4Barrier.ofTypeA B⟩
  · exact exists_section4Barrier_B G hreg hno4 u X hall hvalues hpattern
  · exact exists_section4Barrier_C G hreg hno4 u X hall hvalues hpattern
  · exact False.elim ((not_degenerate_antiNeighborhood_barrierPattern
      G hreg hno4 hindependentComplement u X hvalues) hpattern)

/-- An edge whose deletion makes the graph on a shore bipartite.  The
colouring is ambient, but its constraint omits precisely the displayed
unordered edge. -/
def IsNearBipartiteEdge (G : SimpleGraph V) (S : Finset V) (x y : V) : Prop :=
  x ∈ S ∧ y ∈ S ∧ G.Adj x y ∧
    ∃ color : V → Fin 2, ∀ {a b : V}, a ∈ S → b ∈ S → G.Adj a b →
      s(a, b) ≠ s(x, y) → color a ≠ color b

/-- A triangle-free quartic graph cannot have a three-vertex six-shore:
the degree ledger would force all three possible internal edges. -/
lemma card_ne_three_of_triangle_free_six_shore
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (htri : HasNoTriangles G) (S : Finset V)
    (hcut : (Pseudograph.ofSimple G).boundaryMultiplicity S = 6) :
    S.card ≠ 3 := by
  classical
  intro hcard
  obtain ⟨x, y, z, hxy, hxz, hyz, hS⟩ := Finset.card_eq_three.mp hcard
  have hledger := Pseudograph.regular_card_eq_two_internal_add_boundary
    (Pseudograph.ofSimple G)
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) S
  rw [hcard, hcut] at hledger
  have hint : (Pseudograph.ofSimple G).internalMultiplicity S = 3 := by omega
  let Eall : Finset (Sym2 V) := {s(x, y), s(x, z), s(y, z)}
  have hsub : Pseudograph.internalEdgeFinset G S ⊆ Eall := by
    intro e he
    induction e using Sym2.inductionOn with
    | _ a b =>
        have hm := (Pseudograph.mem_internalEdgeFinset_mk_iff G S a b).mp he
        have ha : a = x ∨ a = y ∨ a = z := by
          simpa [hS] using hm.2.1
        have hb : b = x ∨ b = y ∨ b = z := by
          simpa [hS] using hm.2.2
        rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl
        all_goals simp [Eall, Sym2.eq_swap]
        all_goals exact (G.loopless.irrefl _ hm.1).elim
  have hEcard : (Pseudograph.internalEdgeFinset G S).card = 3 := by
    rw [Pseudograph.card_internalEdgeFinset, hint]
  have hAllcard : Eall.card = 3 := by
    simp [Eall, Sym2.eq_iff, hxy, hxz, hyz, ne_comm]
  have hEq : Pseudograph.internalEdgeFinset G S = Eall :=
    Finset.eq_of_subset_of_card_le hsub (by omega)
  have hxyAdj : G.Adj x y := by
    have hm : s(x, y) ∈ Pseudograph.internalEdgeFinset G S := by
      rw [hEq]
      simp [Eall]
    exact ((Pseudograph.mem_internalEdgeFinset_mk_iff G S x y).mp hm).1
  have hxzAdj : G.Adj x z := by
    have hm : s(x, z) ∈ Pseudograph.internalEdgeFinset G S := by
      rw [hEq]
      simp [Eall]
    exact ((Pseudograph.mem_internalEdgeFinset_mk_iff G S x z).mp hm).1
  have hyzAdj : G.Adj y z := by
    have hm : s(y, z) ∈ Pseudograph.internalEdgeFinset G S := by
      rw [hEq]
      simp [Eall]
    exact ((Pseudograph.mem_internalEdgeFinset_mk_iff G S y z).mp hm).1
  exact htri hxyAdj hxzAdj hyzAdj

/-- A vertex of a minimal nontrivial six-shore cannot carry exactly two
incidences of that cut.  Erasing such a vertex leaves another six-shore;
minimality makes the remainder a pair, and hence the original shore a
triangle-sized six-shore, which is impossible in a triangle-free quartic
graph. -/
lemma MinimalSixShore.outsideDegree_ne_two_of_triangle_free
    {G : SimpleGraph V} (M : MinimalSixShore G)
    (hreg : G.IsRegularOfDegree 4) (htri : HasNoTriangles G)
    (v : V) (hv : v ∈ M.shore) :
    (Pseudograph.ofSimple G).outsideDegree M.shore v ≠ 2 := by
  classical
  let P := Pseudograph.ofSimple G
  let T := M.shore.erase v
  intro hout
  have hsplit := Pseudograph.between_erase_add_outsideDegree_eq_four
    G hreg M.shore v hv
  have htoggle := Pseudograph.erase_vertex_cut_equation G hreg M.shore v hv
  rw [M.cut] at htoggle
  change P.outsideDegree M.shore v = 2 at hout
  change P.betweenMultiplicity {v} T + P.outsideDegree M.shore v = 4 at hsplit
  change 6 + 2 * P.betweenMultiplicity T {v} =
    P.boundaryMultiplicity T + 4 at htoggle
  have hbetween : P.betweenMultiplicity T {v} = 2 := by
    rw [P.betweenMultiplicity_comm T {v}]
    omega
  have hTcut : P.boundaryMultiplicity T = 6 := by omega
  have hTcard : T.card + 1 = M.shore.card := by
    simpa [T] using Finset.card_erase_add_one hv
  have hcompSub : M.shoreᶜ ⊆ Tᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxT
    exact (Finset.mem_compl.mp hx) (Finset.mem_of_mem_erase hxT)
  have hTcomp : 3 ≤ Tᶜ.card :=
    le_trans (M.three_le_compl_card hreg) (Finset.card_le_card hcompSub)
  have hTcardEq : T.card = 2 := by
    by_contra hne
    have hminimal := M.minimal T hTcut hne (by omega)
    omega
  have hScard : M.shore.card = 3 := by omega
  exact card_ne_three_of_triangle_free_six_shore
    G hreg htri M.shore M.cut hScard

/-- On a minimal nontrivial six-shore there is at most one edge whose
deletion makes the induced graph bipartite.  For two such edges, compare the
two 2-colourings.  The vertices where the colourings agree and disagree form
a partition crossed by exactly those two edges.  Its two cuts sum to ten, so
the four-cut side is a singleton and the six-cut side has two vertices;
the original shore would have three vertices, contradicting triangle
freeness and the quartic degree ledger. -/
theorem nearBipartiteEdge_unique_on_minimalSixShore
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hnoBip6 : Pseudograph.HasNoNontrivialBipartiteSixShore G)
    (htri : HasNoTriangles G) (M : MinimalSixShore G)
    {x y a b : V}
    (hxyNear : IsNearBipartiteEdge G M.shore x y)
    (habNear : IsNearBipartiteEdge G M.shore a b) :
    s(x, y) = s(a, b) := by
  classical
  by_contra hedgeNe
  let P := Pseudograph.ofSimple G
  let S := M.shore
  rcases hxyNear with ⟨hxS, hyS, hxy, color₁, hcolor₁⟩
  rcases habNear with ⟨haS, hbS, hab, color₂, hcolor₂⟩
  have hsame₁ : color₁ x = color₁ y := by
    by_contra hdiff
    have hbip : Pseudograph.IsBipartiteOn G S := by
      refine ⟨color₁, ?_⟩
      intro p q hpS hqS hpq
      by_cases he : s(p, q) = s(x, y)
      · rw [Sym2.eq_iff] at he
        rcases he with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · exact hdiff
        · exact Ne.symm hdiff
      · exact hcolor₁ hpS hqS hpq he
    have hcard : S.card = 2 := hnoBip6 S M.cut hbip
    have hthree := M.three_le_card hreg
    change M.shore.card = 2 at hcard
    omega
  have hsame₂ : color₂ a = color₂ b := by
    by_contra hdiff
    have hbip : Pseudograph.IsBipartiteOn G S := by
      refine ⟨color₂, ?_⟩
      intro p q hpS hqS hpq
      by_cases he : s(p, q) = s(a, b)
      · rw [Sym2.eq_iff] at he
        rcases he with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · exact hdiff
        · exact Ne.symm hdiff
      · exact hcolor₂ hpS hqS hpq he
    have hcard : S.card = 2 := hnoBip6 S M.cut hbip
    have hthree := M.three_le_card hreg
    change M.shore.card = 2 at hcard
    omega
  have hdiff₂xy : color₂ x ≠ color₂ y :=
    hcolor₂ hxS hyS hxy hedgeNe
  have hdiff₁ab : color₁ a ≠ color₁ b :=
    hcolor₁ haS hbS hab (Ne.symm hedgeNe)
  have status_flip_of_same_ne (p q r t : Fin 2)
      (hpq : p = q) (hrt : r ≠ t) : (p = r ↔ q ≠ t) := by
    fin_cases p <;> fin_cases q <;> fin_cases r <;> fin_cases t <;>
      simp at hpq hrt ⊢
  have status_same_of_ne_ne (p q r t : Fin 2)
      (hpq : p ≠ q) (hrt : r ≠ t) : (p = r ↔ q = t) := by
    fin_cases p <;> fin_cases q <;> fin_cases r <;> fin_cases t <;>
      simp at hpq hrt ⊢
  let A := S.filter fun v ↦ color₁ v = color₂ v
  let B := S.filter fun v ↦ color₁ v ≠ color₂ v
  have hABdisj : Disjoint A B := by
    rw [Finset.disjoint_left]
    intro v hvA hvB
    exact (Finset.mem_filter.mp hvB).2 (Finset.mem_filter.mp hvA).2
  have hABunion : A ∪ B = S := by
    ext v
    by_cases hvS : v ∈ S
    · by_cases hstatus : color₁ v = color₂ v <;> simp [A, B, hvS, hstatus]
    · simp [A, B, hvS]
  have hxyStatus : (color₁ x = color₂ x ↔ color₁ y ≠ color₂ y) :=
    status_flip_of_same_ne _ _ _ _ hsame₁ hdiff₂xy
  have habStatus : (color₁ a = color₂ a ↔ color₁ b ≠ color₂ b) := by
    have h := status_flip_of_same_ne (color₂ a) (color₂ b)
      (color₁ a) (color₁ b) hsame₂ hdiff₁ab
    simpa [eq_comm] using h
  have hxyCross : (x ∈ A ∧ y ∈ B) ∨ (x ∈ B ∧ y ∈ A) := by
    by_cases hx : color₁ x = color₂ x
    · exact .inl ⟨Finset.mem_filter.mpr ⟨hxS, hx⟩,
        Finset.mem_filter.mpr ⟨hyS, hxyStatus.mp hx⟩⟩
    · have hy : color₁ y = color₂ y := by
        by_contra hy
        exact hx (hxyStatus.mpr hy)
      exact .inr ⟨Finset.mem_filter.mpr ⟨hxS, hx⟩,
        Finset.mem_filter.mpr ⟨hyS, hy⟩⟩
  have habCross : (a ∈ A ∧ b ∈ B) ∨ (a ∈ B ∧ b ∈ A) := by
    by_cases ha : color₁ a = color₂ a
    · exact .inl ⟨Finset.mem_filter.mpr ⟨haS, ha⟩,
        Finset.mem_filter.mpr ⟨hbS, habStatus.mp ha⟩⟩
    · have hb : color₁ b = color₂ b := by
        by_contra hb
        exact ha (habStatus.mpr hb)
      exact .inr ⟨Finset.mem_filter.mpr ⟨haS, ha⟩,
        Finset.mem_filter.mpr ⟨hbS, hb⟩⟩
  have hcrossClass : ∀ {p q : V}, G.Adj p q → p ∈ A → q ∈ B →
      s(p, q) = s(x, y) ∨ s(p, q) = s(a, b) := by
    intro p q hpq hpA hqB
    by_contra hne
    push_neg at hne
    have hpS := (Finset.mem_filter.mp hpA).1
    have hqS := (Finset.mem_filter.mp hqB).1
    have hdiff₁ := hcolor₁ hpS hqS hpq hne.1
    have hdiff₂ := hcolor₂ hpS hqS hpq hne.2
    have hstatus := status_same_of_ne_ne _ _ _ _ hdiff₁ hdiff₂
    exact (Finset.mem_filter.mp hqB).2
      (hstatus.mp (Finset.mem_filter.mp hpA).2)
  have hbetweenFinset :
      Pseudograph.betweenEdgeFinset G A B = {s(x, y), s(a, b)} := by
    ext e
    induction e using Sym2.inductionOn with
    | _ p q =>
        constructor
        · intro he
          have he' := (Pseudograph.mem_betweenEdgeFinset_mk_iff G A B p q).mp he
          rcases he'.2 with hpq | hqp
          · simpa using hcrossClass he'.1 hpq.1 hpq.2
          · have h := hcrossClass he'.1.symm hqp.2 hqp.1
            rcases h with h | h
            · have h' : s(p, q) = s(x, y) := by
                simpa only [Sym2.eq_swap] using h
              simp [h']
            · have h' : s(p, q) = s(a, b) := by
                simpa only [Sym2.eq_swap] using h
              simp [h']
        · intro he
          simp only [Finset.mem_insert, Finset.mem_singleton] at he
          rcases he with he | he
          · rw [he]
            exact (Pseudograph.mem_betweenEdgeFinset_mk_iff G A B x y).mpr
              ⟨hxy, hxyCross⟩
          · rw [he]
            exact (Pseudograph.mem_betweenEdgeFinset_mk_iff G A B a b).mpr
              ⟨hab, habCross⟩
  have hbetween : P.betweenMultiplicity A B = 2 := by
    rw [← Pseudograph.card_betweenEdgeFinset, hbetweenFinset]
    simp [hedgeNe]
  have hAnonempty : A.Nonempty := by
    rcases hxyCross with h | h
    · exact ⟨x, h.1⟩
    · exact ⟨y, h.2⟩
  have hBnonempty : B.Nonempty := by
    rcases hxyCross with h | h
    · exact ⟨y, h.2⟩
    · exact ⟨x, h.1⟩
  have hScomp := M.three_le_compl_card hreg
  change 3 ≤ Sᶜ.card at hScomp
  have hScompSubA : Sᶜ ⊆ Aᶜ := by
    intro v hv
    apply Finset.mem_compl.mpr
    intro hvA
    exact (Finset.mem_compl.mp hv) (Finset.mem_filter.mp hvA).1
  have hScompSubB : Sᶜ ⊆ Bᶜ := by
    intro v hv
    apply Finset.mem_compl.mpr
    intro hvB
    exact (Finset.mem_compl.mp hv) (Finset.mem_filter.mp hvB).1
  have hAcompNonempty : Aᶜ.Nonempty := by
    obtain ⟨v, hv⟩ := Finset.card_pos.mp (lt_of_lt_of_le (by decide) hScomp)
    exact ⟨v, hScompSubA hv⟩
  have hBcompNonempty : Bᶜ.Nonempty := by
    obtain ⟨v, hv⟩ := Finset.card_pos.mp (lt_of_lt_of_le (by decide) hScomp)
    exact ⟨v, hScompSubB hv⟩
  have hAlower := four_le_boundaryMultiplicity_of_nonempty_proper
    G hreg hconn hno2 A hAnonempty hAcompNonempty
  have hBlower := four_le_boundaryMultiplicity_of_nonempty_proper
    G hreg hconn hno2 B hBnonempty hBcompNonempty
  have hcutsum := P.boundaryMultiplicity_union_add_two_between
    ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) A B hABdisj
  rw [hABunion, M.cut, hbetween] at hcutsum
  have hAeven := P.boundaryMultiplicity_even_of_even_regular
    (r := 2) (by simpa using
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) A
  have hBeven := P.boundaryMultiplicity_even_of_even_regular
    (r := 2) (by simpa using
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)) B
  obtain ⟨ka, hka⟩ := hAeven
  obtain ⟨kb, hkb⟩ := hBeven
  change 4 ≤ P.boundaryMultiplicity A at hAlower
  change 4 ≤ P.boundaryMultiplicity B at hBlower
  change 6 + 2 * 2 = P.boundaryMultiplicity A +
    P.boundaryMultiplicity B at hcutsum
  change P.boundaryMultiplicity A = ka + ka at hka
  change P.boundaryMultiplicity B = kb + kb at hkb
  have hcutCases :
      (P.boundaryMultiplicity A = 4 ∧ P.boundaryMultiplicity B = 6) ∨
      (P.boundaryMultiplicity A = 6 ∧ P.boundaryMultiplicity B = 4) := by
    omega
  have hSCard : S.card = 3 := by
    rcases hcutCases with hcuts | hcuts
    · have hAproper : A ≠ Finset.univ := by
        intro h
        rw [h] at hAcompNonempty
        simpa using hAcompNonempty
      rcases hno4 A hAnonempty hAproper hcuts.1 with hAone | hAcOne
      · have hBcompNe2 : Bᶜ.card ≠ 2 := by
          have hle := Finset.card_le_card hScompSubB
          omega
        have hBltS : B.card < S.card := by
          have hcardAB := Finset.card_union_of_disjoint hABdisj
          rw [hABunion] at hcardAB
          exact by omega
        have hBone : B.card = 2 := by
          by_contra hBne
          have hle := M.minimal B hcuts.2 hBne hBcompNe2
          change S.card ≤ B.card at hle
          omega
        have hcardAB := Finset.card_union_of_disjoint hABdisj
        rw [hABunion, hAone, hBone] at hcardAB
        omega
      · have hsub : insert (Classical.choose hBnonempty) Sᶜ ⊆ Aᶜ := by
          intro v hv
          apply Finset.mem_compl.mpr
          simp only [Finset.mem_insert] at hv
          rcases hv with rfl | hv
          · intro hvA
            exact (Finset.disjoint_left.mp hABdisj) hvA
              (Classical.choose_spec hBnonempty)
          · exact fun hvA ↦ (Finset.mem_compl.mp hv)
              (Finset.mem_filter.mp hvA).1
        have hchooseNot : Classical.choose hBnonempty ∉ Sᶜ := by
          simp [(Finset.mem_filter.mp (Classical.choose_spec hBnonempty)).1]
        have hle := Finset.card_le_card hsub
        have hins : (insert (Classical.choose hBnonempty) Sᶜ).card = Sᶜ.card + 1 := by
          simp [hchooseNot]
        rw [hins, hAcOne] at hle
        omega
    · have hBproper : B ≠ Finset.univ := by
        intro h
        rw [h] at hBcompNonempty
        simpa using hBcompNonempty
      rcases hno4 B hBnonempty hBproper hcuts.2 with hBone | hBcOne
      · have hAcompNe2 : Aᶜ.card ≠ 2 := by
          have hle := Finset.card_le_card hScompSubA
          omega
        have hAltS : A.card < S.card := by
          have hcardAB := Finset.card_union_of_disjoint hABdisj
          rw [hABunion] at hcardAB
          exact by omega
        have hAone : A.card = 2 := by
          by_contra hAne
          have hle := M.minimal A hcuts.1 hAne hAcompNe2
          change S.card ≤ A.card at hle
          omega
        have hcardAB := Finset.card_union_of_disjoint hABdisj
        rw [hABunion, hAone, hBone] at hcardAB
        omega
      · have hsub : insert (Classical.choose hAnonempty) Sᶜ ⊆ Bᶜ := by
          intro v hv
          apply Finset.mem_compl.mpr
          simp only [Finset.mem_insert] at hv
          rcases hv with rfl | hv
          · intro hvB
            exact (Finset.disjoint_left.mp hABdisj)
              (Classical.choose_spec hAnonempty) hvB
          · exact fun hvB ↦ (Finset.mem_compl.mp hv)
              (Finset.mem_filter.mp hvB).1
        have hchooseNot : Classical.choose hAnonempty ∉ Sᶜ := by
          simp [(Finset.mem_filter.mp (Classical.choose_spec hAnonempty)).1]
        have hle := Finset.card_le_card hsub
        have hins : (insert (Classical.choose hAnonempty) Sᶜ).card = Sᶜ.card + 1 := by
          simp [hchooseNot]
        rw [hins, hBcOne] at hle
        omega
  exact card_ne_three_of_triangle_free_six_shore G hreg htri S M.cut hSCard

structure SixCutCenterSelection (G : SimpleGraph V)
    (M : MinimalSixShore G) where
  center : V
  choice :
    (∃ y, IsNearBipartiteEdge G M.shore center y) ∨
    ((¬ ∃ x y, IsNearBipartiteEdge G M.shore x y) ∧
      ∃ z, z ∉ M.shore ∧ center ∈ M.shore ∧ G.Adj z center ∧
        ∀ t, t ∈ M.shore → G.Adj z t → t = center) ∨
    ((¬ ∃ x y, IsNearBipartiteEdge G M.shore x y) ∧
      (¬ ∃ z x, z ∉ M.shore ∧ x ∈ M.shore ∧ G.Adj z x ∧
        ∀ t, t ∈ M.shore → G.Adj z t → t = x) ∧
      center ∉ M.shore ∧
      2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {center} M.shore)

namespace SixCutCenterSelection

lemma center_mem_or_two_inside
    {G : SimpleGraph V} {M : MinimalSixShore G}
    (selection : SixCutCenterSelection G M) :
    selection.center ∈ M.shore ∨
      (selection.center ∉ M.shore ∧
        2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity
          {selection.center} M.shore) := by
  rcases selection.choice with hnear | hunique | hout
  · obtain ⟨y, h⟩ := hnear
    exact .inl h.1
  · exact .inl hunique.2.choose_spec.2.1
  · exact .inr ⟨hout.2.2.1, hout.2.2.2⟩

end SixCutCenterSelection

theorem exists_sixCutCenterSelection
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (M : MinimalSixShore G) :
    Nonempty (SixCutCenterSelection G M) := by
  classical
  by_cases hnear : ∃ x y, IsNearBipartiteEdge G M.shore x y
  · obtain ⟨x, y, hxy⟩ := hnear
    exact ⟨⟨x, .inl ⟨y, hxy⟩⟩⟩
  by_cases hone : ∃ z x, z ∉ M.shore ∧ x ∈ M.shore ∧ G.Adj z x ∧
      ∀ t, t ∈ M.shore → G.Adj z t → t = x
  · obtain ⟨z, x, hz, hx, hzx, hunique⟩ := hone
    exact ⟨⟨x, .inr (.inl ⟨hnear, z, hz, hx, hzx, hunique⟩)⟩⟩
  have hSnonempty : M.shore.Nonempty := Finset.nonempty_iff_ne_empty.mpr (by
      intro h
      have hcut := M.cut
      rw [h, Pseudograph.boundaryMultiplicity_empty] at hcut
      omega)
  obtain ⟨x, hx⟩ := hSnonempty.exists_mem
  have hyexists : ∃ y, y ∉ M.shore := by
    by_contra h
    push_neg at h
    have huniv : M.shore = Finset.univ := by ext y; simp [h y]
    have hcut := M.cut
    rw [huniv] at hcut
    have hzero : (Pseudograph.ofSimple G).boundaryMultiplicity
        (Finset.univ : Finset V) = 0 := by
      simpa using (Pseudograph.ofSimple G).boundaryMultiplicity_compl
        (∅ : Finset V)
    rw [hzero] at hcut
    omega
  obtain ⟨y, hy⟩ := hyexists
  obtain ⟨p⟩ := hconn x y
  obtain ⟨⟨d, hadj⟩, _hd, hdx, hdy⟩ :=
    p.exists_boundary_dart (M.shore : Set V) (by simpa using hx) (by simpa using hy)
  let u := d.snd
  have huNot : u ∉ M.shore := by simpa [u] using hdy
  have hpositive : 0 < (Pseudograph.ofSimple G).betweenMultiplicity {u} M.shore :=
    by
      rw [Pseudograph.betweenMultiplicity_singleton_ofSimple
        G u M.shore huNot]
      exact Finset.card_pos.mpr ⟨d.1, Finset.mem_filter.mpr ⟨
        by simpa using hdx, by simpa [u] using hadj.symm⟩⟩
  have hle := M.insideDegree_of_notMem_le_two hreg hno2 hno4 u huNot
  have hneone : (Pseudograph.ofSimple G).betweenMultiplicity {u} M.shore ≠ 1 := by
    intro honeCount
    have hfilter : (M.shore.filter (G.Adj u)).card = 1 := by
      simpa [Pseudograph.betweenMultiplicity_singleton_ofSimple G u M.shore huNot]
        using honeCount
    obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hfilter
    apply hone
    refine ⟨u, z, huNot, ?_, ?_, ?_⟩
    · have : z ∈ M.shore.filter (G.Adj u) := by simp [hz]
      exact (Finset.mem_filter.mp this).1
    · have : z ∈ M.shore.filter (G.Adj u) := by simp [hz]
      exact (Finset.mem_filter.mp this).2
    · intro t ht hAdj
      have ht' : t ∈ M.shore.filter (G.Adj u) := Finset.mem_filter.mpr ⟨ht, hAdj⟩
      rw [hz] at ht'
      simpa using ht'
  have htwo : 2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity {u} M.shore := by
    omega
  exact ⟨⟨u, .inr (.inr ⟨hnear, hone, huNot, htwo⟩)⟩⟩

/-- The centre-selection rule guarantees that at least two vertices of the
minimal shore lie in the middle part of every barrier centred there. -/
lemma SixCutCenterSelection.two_le_middle_inter_shore
    {G : SimpleGraph V} {M : MinimalSixShore G}
    (selection : SixCutCenterSelection G M)
    (hreg : G.IsRegularOfDegree 4)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (B : Section4Barrier G selection.center) :
    2 ≤ (M.shore ∩ B.middle).card := by
  classical
  let u := selection.center
  let T := M.shore.filter (G.Adj u)
  have hTsub : T ⊆ M.shore ∩ B.middle := by
    intro x hx
    have hx' := Finset.mem_filter.mp hx
    exact Finset.mem_inter.mpr ⟨hx'.1, B.neighbor_mem_middle hx'.2⟩
  have hTcard : 2 ≤ T.card := by
    rcases selection.center_mem_or_two_inside with huS | ⟨huNot, hout⟩
    · have hsplit := Pseudograph.between_erase_add_outsideDegree_eq_four
        G hreg M.shore u huS
      have houtle := M.outsideDegree_le_two hreg hno2 hno4 u huS
      have hinternal : 2 ≤ (Pseudograph.ofSimple G).betweenMultiplicity
          {u} (M.shore.erase u) := by omega
      have huErase : u ∉ M.shore.erase u := Finset.notMem_erase u M.shore
      have hfilterErase :
          ((M.shore.erase u).filter (G.Adj u)).card =
            (Pseudograph.ofSimple G).betweenMultiplicity {u} (M.shore.erase u) := by
        symm
        exact Pseudograph.betweenMultiplicity_singleton_ofSimple
          G u (M.shore.erase u) huErase
      have hsub : (M.shore.erase u).filter (G.Adj u) ⊆ T := by
        intro x hx
        have hx' := Finset.mem_filter.mp hx
        exact Finset.mem_filter.mpr ⟨Finset.mem_of_mem_erase hx'.1, hx'.2⟩
      have hle := Finset.card_le_card hsub
      rw [hfilterErase] at hle
      exact le_trans hinternal hle
    · have hfilter : T.card =
          (Pseudograph.ofSimple G).betweenMultiplicity {u} M.shore := by
        symm
        exact Pseudograph.betweenMultiplicity_singleton_ofSimple
          G u M.shore huNot
      rw [hfilter]
      exact hout
  exact le_trans hTcard (Finset.card_le_card hTsub)

/-- The nonempty-intersection subcase for a type-A barrier in Proposition
4.4.  Symmetric cut submodularity makes both crossed shores six-shores;
minimality reduces one to an adjacent pair, and the centre rule then creates
a triangle. -/
theorem false_of_section4Barrier_A_of_right_inter_nonempty
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (htri : HasNoTriangles G)
    (M : MinimalSixShore G) (selection : SixCutCenterSelection G M)
    (B : Section4Barrier G selection.center) (hkind : B.kind = .A)
    (hR1nonempty : (B.right ∩ M.shore).Nonempty) : False := by
  classical
  let P := Pseudograph.ofSimple G
  let S := M.shore
  let M1 := B.middle ∩ S
  let H := S ∩ B.rightᶜ
  let R1 := B.right ∩ S
  let R2 := B.right ∩ Sᶜ
  have hdata := B.kind_data
  rw [hkind] at hdata
  have hMint : P.internalMultiplicity B.middle = 1 := hdata.1
  have hRcut : P.boundaryMultiplicity B.right = 6 := hdata.2.1
  have hRodd : Odd B.right.card := hdata.2.2
  have hM1card : 2 ≤ M1.card := by
    simpa [M1, S, Finset.inter_comm] using
      selection.two_le_middle_inter_shore hreg hno2 hno4 B
  have hM1subH : M1 ⊆ H := by
    intro x hx
    have hx' := Finset.mem_inter.mp hx
    exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
      (Finset.disjoint_left.mp B.middle_right_disjoint) hx'.1 hxR)⟩
  have hHcard : 2 ≤ H.card := le_trans hM1card (Finset.card_le_card hM1subH)
  have hRcard : 3 ≤ B.right.card := by
    obtain ⟨k, hk⟩ := hRodd
    have hne1 : B.right.card ≠ 1 := by
      intro hcard
      obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hcard
      have hfour := boundaryMultiplicity_singleton_of_quartic G hreg z
      rw [← hz, hRcut] at hfour
      omega
    omega
  have hRsubHc : B.right ⊆ Hᶜ := by
    intro x hxR
    simp only [H, Finset.mem_compl, Finset.mem_inter]
    intro hx
    exact hx.2 hxR
  have hHcomp : 3 ≤ Hᶜ.card :=
    le_trans hRcard (Finset.card_le_card hRsubHc)
  have hHlower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 H hHcard (by omega)
  have hR1R2 : B.right = R1 ∪ R2 := by
    ext x
    by_cases hxS : x ∈ S <;> simp [R1, R2, hxS]
  have hR1R2disj : Disjoint R1 R2 := by
    rw [Finset.disjoint_left]
    intro x hx1 hx2
    exact (Finset.mem_compl.mp (Finset.mem_inter.mp hx2).2)
      (Finset.mem_inter.mp hx1).2
  have hSHR1 : S = H ∪ R1 := by
    ext x
    by_cases hxR : x ∈ B.right <;> simp [H, R1, hxR]
  have hHR1disj : Disjoint H R1 := by
    rw [Finset.disjoint_left]
    intro x hxH hxR
    exact (Finset.mem_compl.mp (Finset.mem_inter.mp hxH).2)
      (Finset.mem_inter.mp hxR).1
  have hR2comp : 2 ≤ R2ᶜ.card := by
    have hsub : M1 ⊆ R2ᶜ := by
      intro x hx
      apply Finset.mem_compl.mpr
      intro hxR2
      exact (Finset.disjoint_left.mp B.middle_right_disjoint)
        (Finset.mem_inter.mp hx).1 (Finset.mem_inter.mp hxR2).1
    exact le_trans hM1card (Finset.card_le_card hsub)
  have hSleR : S.card ≤ B.right.card := by
    apply M.minimal B.right hRcut
    · intro h2
      obtain ⟨k, hk⟩ := hRodd
      omega
    · intro h2
      have hsub : insert selection.center M1 ⊆ B.rightᶜ := by
        intro x hx
        apply Finset.mem_compl.mpr
        simp only [Finset.mem_insert] at hx
        rcases hx with rfl | hxM
        · exact fun hxR ↦ (Finset.disjoint_left.mp B.left_right_disjoint)
            B.distinguished_mem_left hxR
        · exact fun hxR ↦ (Finset.disjoint_left.mp B.middle_right_disjoint)
            (Finset.mem_inter.mp hxM).1 hxR
      have hcenterNotM1 : selection.center ∉ M1 := by
        intro h
        exact (Finset.disjoint_left.mp B.left_middle_disjoint)
          B.distinguished_mem_left (Finset.mem_inter.mp h).1
      have hcardInsert : (insert selection.center M1).card = M1.card + 1 := by
        simp [hcenterNotM1]
      have hle := Finset.card_le_card hsub
      omega
  have hR2lower : 6 ≤ P.boundaryMultiplicity R2 := by
    by_contra hnot
    have hR2card : R2.card ≤ 1 := by
      by_contra hcard
      have htwo : 2 ≤ R2.card := by omega
      exact hnot (six_le_boundaryMultiplicity_of_two_sided_nontrivial
        G hreg hconn hno2 hno4 R2 htwo hR2comp)
    have hScardEq : S.card = H.card + R1.card := by
      have := Finset.card_union_of_disjoint hHR1disj
      rw [← hSHR1] at this
      exact this
    have hRcardEq : B.right.card = R1.card + R2.card := by
      have := Finset.card_union_of_disjoint hR1R2disj
      rw [← hR1R2] at this
      exact this
    omega
  have hsubmod := P.boundaryMultiplicity_inter_add_compl_inter_compl_le
    S B.rightᶜ
  have hRcompl := P.boundaryMultiplicity_compl B.right
  have hsubmod' : P.boundaryMultiplicity H + P.boundaryMultiplicity R2 ≤ 12 := by
    change P.boundaryMultiplicity (S ∩ B.rightᶜ) +
      P.boundaryMultiplicity (Sᶜ ∩ (B.rightᶜ)ᶜ) ≤
        P.boundaryMultiplicity S + P.boundaryMultiplicity B.rightᶜ at hsubmod
    rw [M.cut, hRcompl, hRcut] at hsubmod
    simpa [H, R2, Finset.inter_comm] using hsubmod
  change 6 ≤ P.boundaryMultiplicity H at hHlower
  have hHcut : P.boundaryMultiplicity H = 6 := by omega
  have hR2cut : P.boundaryMultiplicity R2 = 6 := by omega
  have hR1nonempty' : R1.Nonempty := by simpa [R1] using hR1nonempty
  have hHltS : H.card < S.card := by
    have hScardEq : S.card = H.card + R1.card := by
      have := Finset.card_union_of_disjoint hHR1disj
      rw [← hSHR1] at this
      exact this
    have : 0 < R1.card := Finset.card_pos.mpr hR1nonempty'
    omega
  have hHcardEq : H.card = 2 := by
    by_contra hne
    have hHcompNe : Hᶜ.card ≠ 2 := by omega
    have := M.minimal H hHcut hne hHcompNe
    change S.card ≤ H.card at this
    omega
  have hM1eqH : M1 = H := by
    apply Finset.eq_of_subset_of_card_le hM1subH
    omega
  have hHint : P.internalMultiplicity H = 1 := by
    have hdegree := P.regular_card_eq_two_internal_add_boundary
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg) H
    rw [hHcardEq, hHcut] at hdegree
    omega
  obtain ⟨x, y, hxyne, hHxy⟩ := Finset.card_eq_two.mp hHcardEq
  have hxy : G.Adj x y := by
    have hcardEdges : (Pseudograph.internalEdgeFinset G H).card = 1 := by
      rw [Pseudograph.card_internalEdgeFinset, hHint]
    obtain ⟨edge, hedge⟩ := Finset.card_eq_one.mp hcardEdges
    have hedgeMem : edge ∈ Pseudograph.internalEdgeFinset G H := by simp [hedge]
    induction edge using Sym2.inductionOn with
    | _ a b =>
      have hab := (Pseudograph.mem_internalEdgeFinset_mk_iff G H a b).mp hedgeMem
      have ha : a = x ∨ a = y := by simpa [hHxy] using hab.2.1
      have hb : b = x ∨ b = y := by simpa [hHxy] using hab.2.2
      rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
      · exact False.elim (G.loopless.irrefl _ hab.1)
      · exact hab.1
      · exact hab.1.symm
      · exact False.elim (G.loopless.irrefl _ hab.1)
  have huNotS : selection.center ∉ S := by
    intro huS
    have huH : selection.center ∈ H := Finset.mem_inter.mpr ⟨huS,
      Finset.mem_compl.mpr (fun huR ↦
        (Finset.disjoint_left.mp B.left_right_disjoint)
          B.distinguished_mem_left huR)⟩
    have huM1 : selection.center ∈ M1 := by rw [hM1eqH]; exact huH
    exact (Finset.disjoint_left.mp B.left_middle_disjoint)
      B.distinguished_mem_left (Finset.mem_inter.mp huM1).1
  have htwoCenter : 2 ≤ P.betweenMultiplicity {selection.center} S := by
    rcases selection.center_mem_or_two_inside with hu | hout
    · exact False.elim (huNotS hu)
    · exact hout.2
  have hfilter : (S.filter (G.Adj selection.center)).card =
      P.betweenMultiplicity {selection.center} S := by
    symm
    exact Pseudograph.betweenMultiplicity_singleton_ofSimple
      G selection.center S huNotS
  have hfilterSub : S.filter (G.Adj selection.center) ⊆ M1 := by
    intro z hz
    have hz' := Finset.mem_filter.mp hz
    exact Finset.mem_inter.mpr ⟨B.neighbor_mem_middle hz'.2, hz'.1⟩
  have hfilterEq : S.filter (G.Adj selection.center) = M1 := by
    apply Finset.eq_of_subset_of_card_le hfilterSub
    rw [hM1eqH, hHcardEq, hfilter]
    exact htwoCenter
  have hxM1 : x ∈ M1 := by rw [hM1eqH, hHxy]; simp
  have hyM1 : y ∈ M1 := by rw [hM1eqH, hHxy]; simp
  have hux : G.Adj selection.center x := by
    have : x ∈ S.filter (G.Adj selection.center) := by rw [hfilterEq]; exact hxM1
    exact (Finset.mem_filter.mp this).2
  have huy : G.Adj selection.center y := by
    have : y ∈ S.filter (G.Adj selection.center) := by rw [hfilterEq]; exact hyM1
    exact (Finset.mem_filter.mp this).2
  exact htri hux huy hxy

/-- The remaining type-A case of Proposition 4.4.  If the barrier's right
shore misses the minimal six-shore, that shore is the union of the independent
left block and the middle block, whose unique internal edge is therefore a
near-bipartite edge.  The priority rule chose the barrier centre on another
near-bipartite edge.  These edges are distinct because the centre lies in the
left block, contradicting uniqueness on a minimal six-shore. -/
theorem false_of_section4Barrier_A_of_right_inter_empty
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hnoBip6 : Pseudograph.HasNoNontrivialBipartiteSixShore G)
    (htri : HasNoTriangles G)
    (M : MinimalSixShore G) (selection : SixCutCenterSelection G M)
    (B : Section4Barrier G selection.center) (hkind : B.kind = .A)
    (hR1empty : B.right ∩ M.shore = ∅) : False := by
  classical
  let S := M.shore
  let L1 := B.left ∩ S
  let M1 := B.middle ∩ S
  have hdata := B.kind_data
  rw [hkind] at hdata
  have hMint : (Pseudograph.ofSimple G).internalMultiplicity B.middle = 1 :=
    hdata.1
  have hL1ind : G.IsIndepSet (L1 : Set V) := by
    exact B.left_independent.mono (by
      intro v hv
      exact (Finset.mem_inter.mp hv).1)
  have hL1M1disj : Disjoint L1 M1 := by
    rw [Finset.disjoint_left]
    intro v hvL hvM
    exact (Finset.disjoint_left.mp B.left_middle_disjoint)
      (Finset.mem_inter.mp hvL).1 (Finset.mem_inter.mp hvM).1
  have hpartition : L1 ∪ M1 = S := by
    ext v
    constructor
    · intro hv
      rcases Finset.mem_union.mp hv with hvL | hvM
      · exact (Finset.mem_inter.mp hvL).2
      · exact (Finset.mem_inter.mp hvM).2
    · intro hvS
      have hvcover : v ∈ B.left ∨ v ∈ B.middle ∨ v ∈ B.right := by
        have : v ∈ B.left ∪ B.middle ∪ B.right := by
          rw [B.cover]
          simp
        simpa [or_assoc] using this
      rcases hvcover with hvL | hvM | hvR
      · exact Finset.mem_union_left _ (Finset.mem_inter.mpr ⟨hvL, hvS⟩)
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hvM, hvS⟩)
      · have : v ∈ B.right ∩ M.shore :=
          Finset.mem_inter.mpr ⟨hvR, hvS⟩
        rw [hR1empty] at this
        simp at this
  have hM1notInd : ¬ G.IsIndepSet (M1 : Set V) := by
    intro hM1ind
    have hbip : Pseudograph.IsBipartiteOn G S := by
      rw [← hpartition]
      exact isBipartiteOn_union_of_independent
        G L1 M1 hL1M1disj hL1ind hM1ind
    have hcard : S.card = 2 := hnoBip6 S M.cut hbip
    have hthree := M.three_le_card hreg
    change M.shore.card = 2 at hcard
    omega
  have hexists : ∃ x ∈ M1, ∃ y ∈ M1, x ≠ y ∧ G.Adj x y := by
    by_contra hnot
    push_neg at hnot
    apply hM1notInd
    rw [SimpleGraph.isIndepSet_iff]
    intro x hx y hy hxy
    exact hnot x hx y hy hxy
  obtain ⟨x, hxM1, y, hyM1, hxyne, hxy⟩ := hexists
  have hunique : ∀ {a b : V}, G.Adj a b → a ∈ B.middle →
      b ∈ B.middle → s(a, b) = s(x, y) :=
    unique_internal_edge_of_eq_one G B.middle hMint hxy
      (Finset.mem_inter.mp hxM1).1 (Finset.mem_inter.mp hyM1).1
  let color : V → Fin 2 := fun v ↦ if v ∈ L1 then 0 else 1
  have hnearXY : IsNearBipartiteEdge G S x y := by
    refine ⟨(Finset.mem_inter.mp hxM1).2, (Finset.mem_inter.mp hyM1).2,
      hxy, color, ?_⟩
    intro a b haS hbS hab hedge
    have haPart : a ∈ L1 ∨ a ∈ M1 := by
      have : a ∈ L1 ∪ M1 := by rw [hpartition]; exact haS
      exact Finset.mem_union.mp this
    have hbPart : b ∈ L1 ∨ b ∈ M1 := by
      have : b ∈ L1 ∪ M1 := by rw [hpartition]; exact hbS
      exact Finset.mem_union.mp this
    rcases haPart with haL | haM <;> rcases hbPart with hbL | hbM
    · exact False.elim (hL1ind (by simpa using haL) (by simpa using hbL)
        hab.ne hab)
    · have hbNotL : b ∉ L1 := fun hbL ↦
        (Finset.disjoint_left.mp hL1M1disj) hbL hbM
      simp [color, haL, hbNotL]
    · have haNotL : a ∉ L1 := fun haL ↦
        (Finset.disjoint_left.mp hL1M1disj) haL haM
      simp [color, haNotL, hbL]
    · exact False.elim (hedge (hunique hab
        (Finset.mem_inter.mp haM).1 (Finset.mem_inter.mp hbM).1))
  have hnearExists : ∃ p q, IsNearBipartiteEdge G S p q :=
    ⟨x, y, hnearXY⟩
  obtain ⟨z, hnearCenter⟩ :
      ∃ z, IsNearBipartiteEdge G S selection.center z := by
    rcases selection.choice with hnear | hrest
    · exact hnear
    · rcases hrest with hunique | hout
      · exact False.elim (hunique.1 hnearExists)
      · exact False.elim (hout.1 hnearExists)
  have hedgeNe : s(x, y) ≠ s(selection.center, z) := by
    intro he
    rw [Sym2.eq_iff] at he
    rcases he with ⟨hxu, _hyz⟩ | ⟨_hxz, hyu⟩
    · subst x
      exact (Finset.disjoint_left.mp B.left_middle_disjoint)
        B.distinguished_mem_left (Finset.mem_inter.mp hxM1).1
    · subst y
      exact (Finset.disjoint_left.mp B.left_middle_disjoint)
        B.distinguished_mem_left (Finset.mem_inter.mp hyM1).1
  have heq := nearBipartiteEdge_unique_on_minimalSixShore
    G hreg hconn hno2 hno4 hnoBip6 htri M hnearXY hnearCenter
  exact hedgeNe heq

/-- The type-B case of Proposition 4.4.  The part of the crossed shore on
the left/middle side is bipartite and therefore has boundary at least eight.
Each of the two residual six-shores contributes a nontrivial outside part,
so their union has boundary at least twelve.  Symmetric submodularity bounds
the sum by `6 + 12`, which is impossible. -/
theorem false_of_section4Barrier_B
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hnoBip6 : Pseudograph.HasNoNontrivialBipartiteSixShore G)
    (M : MinimalSixShore G) (selection : SixCutCenterSelection G M)
    (B : Section4Barrier G selection.center) (hkind : B.kind = .B) : False := by
  classical
  let P := Pseudograph.ofSimple G
  let S := M.shore
  let M1 := B.middle ∩ S
  let H := S ∩ B.rightᶜ
  have hdata := B.kind_data
  rw [hkind] at hdata
  obtain ⟨hMint, hRcut, R₁, R₂, hR12disj, hR12, hR1cut, hR2cut,
      hR1odd, hR2odd⟩ := hdata
  have hM1card := selection.two_le_middle_inter_shore hreg hno2 hno4 B
  have hM1card' : 2 ≤ M1.card := by
    simpa [M1, S, Finset.inter_comm] using hM1card
  have hM1subH : M1 ⊆ H := by
    intro x hx
    have hx' := Finset.mem_inter.mp hx
    exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
      (Finset.disjoint_left.mp B.middle_right_disjoint) hx'.1 hxR)⟩
  have hHcard : 2 ≤ H.card := le_trans hM1card' (Finset.card_le_card hM1subH)
  have hM1ind : G.IsIndepSet (M1 : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro x hx y hy hxy hAdj
    have hpos := internalMultiplicity_pos_of_adj_mem G B.middle hAdj
      (Finset.mem_inter.mp hx).1 (Finset.mem_inter.mp hy).1
    omega
  let L1 := B.left ∩ S
  have hL1ind : G.IsIndepSet (L1 : Set V) := by
    exact B.left_independent.mono (by
      intro x hx
      exact Finset.mem_inter.mp hx |>.1)
  have hL1M1disj : Disjoint L1 M1 := by
    rw [Finset.disjoint_left]
    intro x hxL hxM
    exact (Finset.disjoint_left.mp B.left_middle_disjoint)
      (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxM).1
  have hHeq : H = L1 ∪ M1 := by
    ext x
    constructor
    · intro hx
      have hxS := (Finset.mem_inter.mp hx).1
      have hxNotR := Finset.mem_compl.mp (Finset.mem_inter.mp hx).2
      have hxcover : x ∈ B.left ∨ x ∈ B.middle ∨ x ∈ B.right := by
        have hxU : x ∈ B.left ∪ B.middle ∪ B.right := by
          rw [B.cover]
          simp
        simpa [or_assoc] using hxU
      rcases hxcover with hxL | hxM | hxR
      · exact Finset.mem_union_left _ (Finset.mem_inter.mpr ⟨hxL, hxS⟩)
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hxM, hxS⟩)
      · exact False.elim (hxNotR hxR)
    · intro hx
      rcases Finset.mem_union.mp hx with hxL | hxM
      · have hx' := Finset.mem_inter.mp hxL
        exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
          (Finset.disjoint_left.mp B.left_right_disjoint) hx'.1 hxR)⟩
      · exact hM1subH hxM
  have hHbip : Pseudograph.IsBipartiteOn G H := by
    rw [hHeq]
    exact isBipartiteOn_union_of_independent G L1 M1 hL1M1disj hL1ind hM1ind
  have hR1card : 3 ≤ R₁.card := by
    have hne1 : R₁.card ≠ 1 := by
      intro hcard
      obtain ⟨z, hz⟩ := Finset.card_eq_one.mp hcard
      have hfour := boundaryMultiplicity_singleton_of_quartic G hreg z
      have hsix : P.boundaryMultiplicity {z} = 6 := by
        simpa [P, hz] using hR1cut
      change P.boundaryMultiplicity {z} = 4 at hfour
      omega
    obtain ⟨k, hk⟩ := hR1odd
    omega
  have hR1subRight : R₁ ⊆ B.right := by
    intro x hx
    rw [← hR12]
    exact Finset.mem_union_left _ hx
  have hR2subRight : R₂ ⊆ B.right := by
    intro x hx
    rw [← hR12]
    exact Finset.mem_union_right _ hx
  have hR1subHc : R₁ ⊆ Hᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxH
    exact (Finset.mem_compl.mp (Finset.mem_inter.mp hxH).2) (hR1subRight hx)
  have hHcomp : 2 ≤ Hᶜ.card :=
    le_trans (by omega : 2 ≤ R₁.card) (Finset.card_le_card hR1subHc)
  have hHlower := eight_le_boundaryMultiplicity_of_bipartite_with_independent_pair
    G hreg hconn hno2 hno4 hnoBip6 H M1 hM1subH hM1ind hM1card' hHcomp hHbip
  have hpieceOutCard : ∀ Q : Finset V, Q ⊆ B.right →
      P.boundaryMultiplicity Q = 6 → Odd Q.card →
      2 ≤ (Q ∩ Sᶜ).card := by
    intro Q hQsub hQcut hQodd
    have hQne2 : Q.card ≠ 2 := by
      obtain ⟨k, hk⟩ := hQodd
      omega
    have hcenterNotM1 : selection.center ∉ M1 := by
      intro h
      exact (Finset.disjoint_left.mp B.left_middle_disjoint)
        B.distinguished_mem_left (Finset.mem_inter.mp h).1
    have hinsertSub : insert selection.center M1 ⊆ Qᶜ := by
      intro x hx
      apply Finset.mem_compl.mpr
      intro hxQ
      have hxR := hQsub hxQ
      simp only [Finset.mem_insert] at hx
      rcases hx with rfl | hxM
      · exact (Finset.disjoint_left.mp B.left_right_disjoint)
          B.distinguished_mem_left hxR
      · exact (Finset.disjoint_left.mp B.middle_right_disjoint)
          (Finset.mem_inter.mp hxM).1 hxR
    have hQcompNe2 : Qᶜ.card ≠ 2 := by
      have hcardInsert : (insert selection.center M1).card = M1.card + 1 := by
        simp [hcenterNotM1]
      have hle := Finset.card_le_card hinsertSub
      omega
    have hSleQ : S.card ≤ Q.card := M.minimal Q hQcut hQne2 hQcompNe2
    let Qin := Q ∩ S
    let Qout := Q ∩ Sᶜ
    have hQdecomp : Q = Qin ∪ Qout := by
      ext x
      by_cases hxS : x ∈ S <;> simp [Qin, Qout, hxS]
    have hQpartsDisj : Disjoint Qin Qout := by
      rw [Finset.disjoint_left]
      intro x hxin hxout
      exact (Finset.mem_compl.mp (Finset.mem_inter.mp hxout).2)
        (Finset.mem_inter.mp hxin).2
    have hHQinDisj : Disjoint H Qin := by
      rw [Finset.disjoint_left]
      intro x hxH hxQ
      exact (Finset.mem_compl.mp (Finset.mem_inter.mp hxH).2)
        (hQsub (Finset.mem_inter.mp hxQ).1)
    have hHQinSub : H ∪ Qin ⊆ S := by
      intro x hx
      rcases Finset.mem_union.mp hx with hxH | hxQ
      · exact (Finset.mem_inter.mp hxH).1
      · exact (Finset.mem_inter.mp hxQ).2
    have hScardLower : H.card + Qin.card ≤ S.card := by
      have hcardUnion := Finset.card_union_of_disjoint hHQinDisj
      have hle := Finset.card_le_card hHQinSub
      rw [hcardUnion] at hle
      exact hle
    have hQcardEq : Q.card = Qin.card + Qout.card := by
      have hcardUnion := Finset.card_union_of_disjoint hQpartsDisj
      rw [← hQdecomp] at hcardUnion
      exact hcardUnion
    change 2 ≤ Qout.card
    by_contra hnot
    have : Qout.card ≤ 1 := by omega
    omega
  have hQ1outCard := hpieceOutCard R₁ hR1subRight hR1cut hR1odd
  have hQ2outCard := hpieceOutCard R₂ hR2subRight hR2cut hR2odd
  let Q1out := R₁ ∩ Sᶜ
  let Q2out := R₂ ∩ Sᶜ
  change 2 ≤ Q1out.card at hQ1outCard
  change 2 ≤ Q2out.card at hQ2outCard
  have hM1subQ1c : M1 ⊆ Q1outᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxQ
    exact (Finset.disjoint_left.mp B.middle_right_disjoint)
      (Finset.mem_inter.mp hx).1 (hR1subRight (Finset.mem_inter.mp hxQ).1)
  have hM1subQ2c : M1 ⊆ Q2outᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxQ
    exact (Finset.disjoint_left.mp B.middle_right_disjoint)
      (Finset.mem_inter.mp hx).1 (hR2subRight (Finset.mem_inter.mp hxQ).1)
  have hQ1comp : 2 ≤ Q1outᶜ.card :=
    le_trans hM1card' (Finset.card_le_card hM1subQ1c)
  have hQ2comp : 2 ≤ Q2outᶜ.card :=
    le_trans hM1card' (Finset.card_le_card hM1subQ2c)
  have hQ1lower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 Q1out hQ1outCard hQ1comp
  have hQ2lower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 Q2out hQ2outCard hQ2comp
  have hbetweenR : P.betweenMultiplicity R₁ R₂ = 0 := by
    have hunion := P.boundaryMultiplicity_union_add_two_between
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
      R₁ R₂ hR12disj
    rw [hR12, hRcut, hR1cut, hR2cut] at hunion
    omega
  have hQ1R2disj : Disjoint Q1out R₂ :=
    Disjoint.mono (fun x hx ↦ (Finset.mem_inter.mp hx).1) (by rfl) hR12disj
  have hQ2R1disj : Disjoint Q2out R₁ :=
    Disjoint.mono (fun x hx ↦ (Finset.mem_inter.mp hx).1) (by rfl) hR12disj.symm
  have hbetweenOut : P.betweenMultiplicity Q1out Q2out = 0 := by
    have hle1 := P.betweenMultiplicity_mono_right Q1out Q2out R₂
      (fun x hx ↦ (Finset.mem_inter.mp hx).1) hQ1R2disj
    have hle2 := P.betweenMultiplicity_mono_right R₂ Q1out R₁
      (fun x hx ↦ (Finset.mem_inter.mp hx).1) hR12disj.symm
    rw [P.betweenMultiplicity_comm R₂ Q1out,
      P.betweenMultiplicity_comm R₂ R₁, hbetweenR] at hle2
    omega
  have hQoutDisj : Disjoint Q1out Q2out :=
    Disjoint.mono (fun x hx ↦ (Finset.mem_inter.mp hx).1)
      (fun x hx ↦ (Finset.mem_inter.mp hx).1) hR12disj
  let Rout := Q1out ∪ Q2out
  have hRoutLower : 12 ≤ P.boundaryMultiplicity Rout := by
    have hunion := P.boundaryMultiplicity_union_add_two_between
      ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
      Q1out Q2out hQoutDisj
    change P.boundaryMultiplicity Rout + 2 * P.betweenMultiplicity Q1out Q2out =
      P.boundaryMultiplicity Q1out + P.boundaryMultiplicity Q2out at hunion
    rw [hbetweenOut] at hunion
    have hQ1lower' : 6 ≤ P.boundaryMultiplicity Q1out := by
      simpa [P] using hQ1lower
    have hQ2lower' : 6 ≤ P.boundaryMultiplicity Q2out := by
      simpa [P] using hQ2lower
    omega
  have hRoutEq : Rout = Sᶜ ∩ B.right := by
    ext x
    constructor
    · intro hx
      rcases Finset.mem_union.mp hx with hx | hx
      · have hx' := Finset.mem_inter.mp hx
        exact Finset.mem_inter.mpr ⟨hx'.2, hR1subRight hx'.1⟩
      · have hx' := Finset.mem_inter.mp hx
        exact Finset.mem_inter.mpr ⟨hx'.2, hR2subRight hx'.1⟩
    · intro hx
      have hx' := Finset.mem_inter.mp hx
      have hxUnion : x ∈ R₁ ∪ R₂ := by
        rw [hR12]
        exact hx'.2
      rcases Finset.mem_union.mp hxUnion with hxR | hxR
      · exact Finset.mem_union_left _ (Finset.mem_inter.mpr ⟨hxR, hx'.1⟩)
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hxR, hx'.1⟩)
  have hsubmod := P.boundaryMultiplicity_inter_add_compl_inter_compl_le
    S B.rightᶜ
  have hRcompl := P.boundaryMultiplicity_compl B.right
  have hsubmod' : P.boundaryMultiplicity H + P.boundaryMultiplicity Rout ≤ 18 := by
    change P.boundaryMultiplicity (S ∩ B.rightᶜ) +
      P.boundaryMultiplicity (Sᶜ ∩ (B.rightᶜ)ᶜ) ≤
        P.boundaryMultiplicity S + P.boundaryMultiplicity B.rightᶜ at hsubmod
    rw [M.cut, hRcompl, hRcut] at hsubmod
    simpa [H, hRoutEq] using hsubmod
  change 8 ≤ P.boundaryMultiplicity H at hHlower
  omega

/-- The type-C case of Proposition 4.4.  We cross the minimal six-shore
with the barrier's eight-shore.  The two off-diagonal blocks have cuts eight
and six, and the exact uncrossing identity shows that the other diagonal
pair has no joining edge.  A near-bipartite edge would force a vertex of the
minimal shore to carry exactly two cut incidences.  The centre-selection
alternatives then make the remaining bipartite diagonal block too small for
the quartic degree ledger. -/
theorem false_of_section4Barrier_C
    (G : SimpleGraph V) (hreg : G.IsRegularOfDegree 4)
    (hconn : G.Connected)
    (hno2 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S ≠ 2)
    (hno4 : ∀ S : Finset V, S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple G).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1)
    (hnoBip6 : Pseudograph.HasNoNontrivialBipartiteSixShore G)
    (htri : HasNoTriangles G)
    (M : MinimalSixShore G) (selection : SixCutCenterSelection G M)
    (B : Section4Barrier G selection.center) (hkind : B.kind = .C) : False := by
  classical
  let P := Pseudograph.ofSimple G
  let S := M.shore
  let L1 := B.left ∩ S
  let M1 := B.middle ∩ S
  let Rin := B.right ∩ S
  let L2 := B.left ∩ Sᶜ
  let M2 := B.middle ∩ Sᶜ
  let Rout := B.right ∩ Sᶜ
  let H := S ∩ B.rightᶜ
  let A := Sᶜ ∩ B.rightᶜ
  have hdata := B.kind_data
  rw [hkind] at hdata
  have hMint : P.internalMultiplicity B.middle = 0 := hdata.1
  have hRcut : P.boundaryMultiplicity B.right = 8 := hdata.2.1
  have hM1card0 := selection.two_le_middle_inter_shore hreg hno2 hno4 B
  have hM1card : 2 ≤ M1.card := by
    simpa [M1, S, Finset.inter_comm] using hM1card0
  have hside (x : V) : x ∈ B.left ∨ x ∈ B.middle ∨ x ∈ B.right := by
    have hx : x ∈ B.left ∪ B.middle ∪ B.right := by rw [B.cover]; simp
    simpa [or_assoc] using hx
  have hM1ind : G.IsIndepSet (M1 : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro x hx y hy hxy hAdj
    have hpos := internalMultiplicity_pos_of_adj_mem G B.middle hAdj
      (Finset.mem_inter.mp hx).1 (Finset.mem_inter.mp hy).1
    omega
  have hM2ind : G.IsIndepSet (M2 : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro x hx y hy hxy hAdj
    have hpos := internalMultiplicity_pos_of_adj_mem G B.middle hAdj
      (Finset.mem_inter.mp hx).1 (Finset.mem_inter.mp hy).1
    omega
  have hL1ind : G.IsIndepSet (L1 : Set V) :=
    B.left_independent.mono (fun _ hx ↦ (Finset.mem_inter.mp hx).1)
  have hL2ind : G.IsIndepSet (L2 : Set V) :=
    B.left_independent.mono (fun _ hx ↦ (Finset.mem_inter.mp hx).1)
  have hL1M1disj : Disjoint L1 M1 := by
    rw [Finset.disjoint_left]
    intro x hxL hxM
    exact (Finset.disjoint_left.mp B.left_middle_disjoint)
      (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxM).1
  have hL2M2disj : Disjoint L2 M2 := by
    rw [Finset.disjoint_left]
    intro x hxL hxM
    exact (Finset.disjoint_left.mp B.left_middle_disjoint)
      (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxM).1
  have hHeq : H = L1 ∪ M1 := by
    ext x
    constructor
    · intro hx
      have hxS := (Finset.mem_inter.mp hx).1
      have hxNotR := Finset.mem_compl.mp (Finset.mem_inter.mp hx).2
      rcases hside x with hxL | hxM | hxR
      · exact Finset.mem_union_left _ (Finset.mem_inter.mpr ⟨hxL, hxS⟩)
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hxM, hxS⟩)
      · exact False.elim (hxNotR hxR)
    · intro hx
      rcases Finset.mem_union.mp hx with hxL | hxM
      · have hx' := Finset.mem_inter.mp hxL
        exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
          (Finset.disjoint_left.mp B.left_right_disjoint) hx'.1 hxR)⟩
      · have hx' := Finset.mem_inter.mp hxM
        exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
          (Finset.disjoint_left.mp B.middle_right_disjoint) hx'.1 hxR)⟩
  have hAeq : A = L2 ∪ M2 := by
    ext x
    constructor
    · intro hx
      have hxS := (Finset.mem_inter.mp hx).1
      have hxNotR := Finset.mem_compl.mp (Finset.mem_inter.mp hx).2
      rcases hside x with hxL | hxM | hxR
      · exact Finset.mem_union_left _ (Finset.mem_inter.mpr ⟨hxL, hxS⟩)
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hxM, hxS⟩)
      · exact False.elim (hxNotR hxR)
    · intro hx
      rcases Finset.mem_union.mp hx with hxL | hxM
      · have hx' := Finset.mem_inter.mp hxL
        exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
          (Finset.disjoint_left.mp B.left_right_disjoint) hx'.1 hxR)⟩
      · have hx' := Finset.mem_inter.mp hxM
        exact Finset.mem_inter.mpr ⟨hx'.2, Finset.mem_compl.mpr (fun hxR ↦
          (Finset.disjoint_left.mp B.middle_right_disjoint) hx'.1 hxR)⟩
  have hM1subH : M1 ⊆ H := by rw [hHeq]; exact Finset.subset_union_right
  have hHbip : Pseudograph.IsBipartiteOn G H := by
    rw [hHeq]
    exact isBipartiteOn_union_of_independent
      G L1 M1 hL1M1disj hL1ind hM1ind
  have hSdecomp : S = (L1 ∪ Rin) ∪ M1 := by
    ext x
    constructor
    · intro hxS
      rcases hside x with hxL | hxM | hxR
      · exact Finset.mem_union_left _ (Finset.mem_union_left _
          (Finset.mem_inter.mpr ⟨hxL, hxS⟩))
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hxM, hxS⟩)
      · exact Finset.mem_union_left _ (Finset.mem_union_right _
          (Finset.mem_inter.mpr ⟨hxR, hxS⟩))
    · intro hx
      rcases Finset.mem_union.mp hx with hx | hxM
      · rcases Finset.mem_union.mp hx with hxL | hxR
        · exact (Finset.mem_inter.mp hxL).2
        · exact (Finset.mem_inter.mp hxR).2
      · exact (Finset.mem_inter.mp hxM).2
  have hScdecomp : Sᶜ = (L2 ∪ Rout) ∪ M2 := by
    ext x
    constructor
    · intro hxS
      rcases hside x with hxL | hxM | hxR
      · exact Finset.mem_union_left _ (Finset.mem_union_left _
          (Finset.mem_inter.mpr ⟨hxL, hxS⟩))
      · exact Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hxM, hxS⟩)
      · exact Finset.mem_union_left _ (Finset.mem_union_right _
          (Finset.mem_inter.mpr ⟨hxR, hxS⟩))
    · intro hx
      rcases Finset.mem_union.mp hx with hx | hxM
      · rcases Finset.mem_union.mp hx with hxL | hxR
        · exact (Finset.mem_inter.mp hxL).2
        · exact (Finset.mem_inter.mp hxR).2
      · exact (Finset.mem_inter.mp hxM).2
  have hRinCard : 2 ≤ Rin.card := by
    by_contra hnot
    have hsmall : Rin.card ≤ 1 := by omega
    have hRinInd : G.IsIndepSet (Rin : Set V) := by
      rw [SimpleGraph.isIndepSet_iff]
      intro x hx y hy hxy _hAdj
      exact hxy ((Finset.card_le_one.mp hsmall) x hx y hy)
    have hL1RinDisj : Disjoint L1 Rin := by
      rw [Finset.disjoint_left]
      intro x hxL hxR
      exact (Finset.disjoint_left.mp B.left_right_disjoint)
        (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxR).1
    have hL1RinInd : G.IsIndepSet ((L1 ∪ Rin : Finset V) : Set V) := by
      rw [SimpleGraph.isIndepSet_iff]
      intro x hx y hy hxy hAdj
      rcases Finset.mem_union.mp hx with hxL | hxR <;>
        rcases Finset.mem_union.mp hy with hyL | hyR
      · exact hL1ind (by simpa using hxL) (by simpa using hyL) hxy hAdj
      · exact B.left_right_nonadjacent (Finset.mem_inter.mp hxL).1
          (Finset.mem_inter.mp hyR).1 hAdj
      · exact B.left_right_nonadjacent (Finset.mem_inter.mp hyL).1
          (Finset.mem_inter.mp hxR).1 hAdj.symm
      · exact hRinInd (by simpa using hxR) (by simpa using hyR) hxy hAdj
    have hColorDisj : Disjoint (L1 ∪ Rin) M1 := by
      rw [Finset.disjoint_left]
      intro x hx hxM
      rcases Finset.mem_union.mp hx with hxL | hxR
      · exact (Finset.disjoint_left.mp B.left_middle_disjoint)
          (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxM).1
      · exact (Finset.disjoint_left.mp B.middle_right_disjoint)
          (Finset.mem_inter.mp hxM).1 (Finset.mem_inter.mp hxR).1
    have hSbip : Pseudograph.IsBipartiteOn G S := by
      rw [hSdecomp]
      exact isBipartiteOn_union_of_independent G (L1 ∪ Rin) M1
        hColorDisj hL1RinInd hM1ind
    have hcard : S.card = 2 := hnoBip6 S M.cut hSbip
    have := M.three_le_card hreg
    change M.shore.card = 2 at hcard
    omega
  have hRoutCard : 2 ≤ Rout.card := by
    by_contra hnot
    have hsmall : Rout.card ≤ 1 := by omega
    have hRoutInd : G.IsIndepSet (Rout : Set V) := by
      rw [SimpleGraph.isIndepSet_iff]
      intro x hx y hy hxy _hAdj
      exact hxy ((Finset.card_le_one.mp hsmall) x hx y hy)
    have hL2RoutDisj : Disjoint L2 Rout := by
      rw [Finset.disjoint_left]
      intro x hxL hxR
      exact (Finset.disjoint_left.mp B.left_right_disjoint)
        (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxR).1
    have hL2RoutInd : G.IsIndepSet ((L2 ∪ Rout : Finset V) : Set V) := by
      rw [SimpleGraph.isIndepSet_iff]
      intro x hx y hy hxy hAdj
      rcases Finset.mem_union.mp hx with hxL | hxR <;>
        rcases Finset.mem_union.mp hy with hyL | hyR
      · exact hL2ind (by simpa using hxL) (by simpa using hyL) hxy hAdj
      · exact B.left_right_nonadjacent (Finset.mem_inter.mp hxL).1
          (Finset.mem_inter.mp hyR).1 hAdj
      · exact B.left_right_nonadjacent (Finset.mem_inter.mp hyL).1
          (Finset.mem_inter.mp hxR).1 hAdj.symm
      · exact hRoutInd (by simpa using hxR) (by simpa using hyR) hxy hAdj
    have hColorDisj : Disjoint (L2 ∪ Rout) M2 := by
      rw [Finset.disjoint_left]
      intro x hx hxM
      rcases Finset.mem_union.mp hx with hxL | hxR
      · exact (Finset.disjoint_left.mp B.left_middle_disjoint)
          (Finset.mem_inter.mp hxL).1 (Finset.mem_inter.mp hxM).1
      · exact (Finset.disjoint_left.mp B.middle_right_disjoint)
          (Finset.mem_inter.mp hxM).1 (Finset.mem_inter.mp hxR).1
    have hScbip : Pseudograph.IsBipartiteOn G Sᶜ := by
      rw [hScdecomp]
      exact isBipartiteOn_union_of_independent G (L2 ∪ Rout) M2
        hColorDisj hL2RoutInd hM2ind
    have hScut : P.boundaryMultiplicity Sᶜ = 6 := by
      simpa [P, S] using (Pseudograph.boundaryMultiplicity_compl
        (Pseudograph.ofSimple G) M.shore).trans M.cut
    have hcard : Sᶜ.card = 2 := hnoBip6 Sᶜ hScut hScbip
    have := M.three_le_compl_card hreg
    change M.shoreᶜ.card = 2 at hcard
    omega
  have hRinSubHc : Rin ⊆ Hᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxH
    exact (Finset.mem_compl.mp (Finset.mem_inter.mp hxH).2)
      (Finset.mem_inter.mp hx).1
  have hHcomp : 2 ≤ Hᶜ.card :=
    le_trans hRinCard (Finset.card_le_card hRinSubHc)
  have hHlower := eight_le_boundaryMultiplicity_of_bipartite_with_independent_pair
    G hreg hconn hno2 hno4 hnoBip6 H M1 hM1subH hM1ind hM1card hHcomp hHbip
  have hM1subRinC : M1 ⊆ Rinᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxR
    exact (Finset.disjoint_left.mp B.middle_right_disjoint)
      (Finset.mem_inter.mp hx).1 (Finset.mem_inter.mp hxR).1
  have hM1subRoutC : M1 ⊆ Routᶜ := by
    intro x hx
    apply Finset.mem_compl.mpr
    intro hxR
    exact (Finset.disjoint_left.mp B.middle_right_disjoint)
      (Finset.mem_inter.mp hx).1 (Finset.mem_inter.mp hxR).1
  have hRinComp : 2 ≤ Rinᶜ.card :=
    le_trans hM1card (Finset.card_le_card hM1subRinC)
  have hRoutComp : 2 ≤ Routᶜ.card :=
    le_trans hM1card (Finset.card_le_card hM1subRoutC)
  have hRinLower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 Rin hRinCard hRinComp
  have hRoutLower := six_le_boundaryMultiplicity_of_two_sided_nontrivial
    G hreg hconn hno2 hno4 Rout hRoutCard hRoutComp
  have hdiag := P.boundaryMultiplicity_inter_add_compl_inter_compl_add_two_between
    S B.rightᶜ
  have hRcomp := P.boundaryMultiplicity_compl B.right
  have hdiag' : P.boundaryMultiplicity H + P.boundaryMultiplicity Rout +
      2 * P.betweenMultiplicity A Rin = 14 := by
    change P.boundaryMultiplicity (S ∩ B.rightᶜ) +
        P.boundaryMultiplicity (Sᶜ ∩ (B.rightᶜ)ᶜ) +
        2 * P.betweenMultiplicity (Sᶜ ∩ B.rightᶜ)
          (S ∩ (B.rightᶜ)ᶜ) =
      P.boundaryMultiplicity S + P.boundaryMultiplicity B.rightᶜ at hdiag
    rw [M.cut, hRcomp, hRcut] at hdiag
    simpa [H, A, Rin, Rout, Finset.inter_comm] using hdiag
  change 8 ≤ P.boundaryMultiplicity H at hHlower
  change 6 ≤ P.boundaryMultiplicity Rin at hRinLower
  change 6 ≤ P.boundaryMultiplicity Rout at hRoutLower
  have hHcut : P.boundaryMultiplicity H = 8 := by omega
  have hRoutCut : P.boundaryMultiplicity Rout = 6 := by omega
  have hARinZero : P.betweenMultiplicity A Rin = 0 := by omega
  have hSHRin : S = H ∪ Rin := by
    ext x
    by_cases hxR : x ∈ B.right <;> simp [H, Rin, hxR]
  have hHRinDisj : Disjoint H Rin := by
    rw [Finset.disjoint_left]
    intro x hxH hxR
    exact (Finset.mem_compl.mp (Finset.mem_inter.mp hxH).2)
      (Finset.mem_inter.mp hxR).1
  have hHltS : H.card < S.card := by
    have hcard := Finset.card_union_of_disjoint hHRinDisj
    rw [← hSHRin] at hcard
    omega
  have hScompSubHcomp : Sᶜ ⊆ Hᶜ := by
