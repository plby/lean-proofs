  rw [hAHunion, hRcomp, hRcut, hHcut] at hAHcut
  rcases selection.choice with hnear | hrest
  · exact False.elim (hnoNear
      ⟨selection.center, hnear.choose, hnear.choose_spec⟩)
  · rcases hrest with hone | hout
    · obtain ⟨_hnone, z, hzNot, huS, hzu, hzUnique⟩ := hone
      have hzM2 : z ∈ M2 := Finset.mem_inter.mpr
        ⟨B.neighbor_mem_middle hzu.symm, Finset.mem_compl.mpr hzNot⟩
      have hzA : z ∈ A := by rw [hAeq]; exact Finset.mem_union_right _ hzM2
      have huH : selection.center ∈ H := by
        exact Finset.mem_inter.mpr ⟨huS, Finset.mem_compl.mpr (fun huR ↦
          (Finset.disjoint_left.mp B.left_right_disjoint)
            B.distinguished_mem_left huR)⟩
      have hzNotH : z ∉ H := fun hzH ↦
        hzNot (Finset.mem_inter.mp hzH).1
      have hzHfilter : H.filter (G.Adj z) = {selection.center} := by
        ext x
        constructor
        · intro hx
          have hx' := Finset.mem_filter.mp hx
          have hxeq := hzUnique x (Finset.mem_inter.mp hx'.1).1 hx'.2
          simpa [hxeq]
        · intro hx
          have hxeq : x = selection.center := by simpa using hx
          subst x
          exact Finset.mem_filter.mpr ⟨huH, hzu⟩
      have hzHcount : P.betweenMultiplicity {z} H = 1 := by
        rw [Pseudograph.betweenMultiplicity_singleton_ofSimple G z H hzNotH]
        simp [hzHfilter]
      rcases hAcutCases with hAone | hAtwo
      · have hAeqz : A = {z} := by
          obtain ⟨w, hw⟩ := Finset.card_eq_one.mp hAone.2
          have hzw : z = w := by simpa [hw] using hzA
          simpa [hzw] using hw
        have hAHcount : P.betweenMultiplicity A H = 1 := by
          rw [hAeqz]
          exact hzHcount
        rw [hAone.1, hAHcount] at hAHcut
        omega
      · obtain ⟨p, q, hpq, hApq⟩ := Finset.card_eq_two.mp hAtwo.2
        have hzVals : z = p ∨ z = q := by simpa [hApq] using hzA
        obtain ⟨l, hzl, hAlpair⟩ : ∃ l, z ≠ l ∧ A = {z, l} := by
          rcases hzVals with rfl | rfl
          · exact ⟨q, hpq, hApq⟩
          · exact ⟨p, hpq.symm, hApq.trans (Finset.pair_comm _ _)⟩
        have hzlAdj : G.Adj z l := by
          have hdisj : Disjoint ({z} : Finset V) {l} := by simp [hzl]
          have hunion := P.boundaryMultiplicity_union_add_two_between
            ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
            {z} {l} hdisj
          have hzcut := boundaryMultiplicity_singleton_of_quartic G hreg z
          have hlcut := boundaryMultiplicity_singleton_of_quartic G hreg l
          rw [show ({z} : Finset V) ∪ {l} = A by simpa [hAlpair],
            hAtwo.1, hzcut, hlcut] at hunion
          have hbetween : P.betweenMultiplicity {z} {l} = 1 := by omega
          rw [Pseudograph.betweenMultiplicity_singleton_ofSimple G z {l}
            (by simp [hzl])] at hbetween
          by_contra hnot
          rw [Finset.filter_singleton, if_neg hnot] at hbetween
          simp at hbetween
        have hlA : l ∈ A := by rw [hAlpair]; simp
        have hlPart : l ∈ L2 ∨ l ∈ M2 := by
          have : l ∈ L2 ∪ M2 := by rw [← hAeq]; exact hlA
          exact Finset.mem_union.mp this
        have hlL2 : l ∈ L2 := by
          rcases hlPart with h | h
          · exact h
          · have hpos := internalMultiplicity_pos_of_adj_mem
              G B.middle hzlAdj (Finset.mem_inter.mp hzM2).1
                (Finset.mem_inter.mp h).1
            omega
        have hlNotH : l ∉ H := fun hlH ↦
          (Finset.mem_compl.mp (Finset.mem_inter.mp hlA).1)
            (Finset.mem_inter.mp hlH).1
        have hlNotZ : l ∉ ({z} : Finset V) := by simpa using hzl.symm
        have hlTargetDisj : Disjoint ({l} : Finset V) ({z} ∪ H) := by
          rw [Finset.disjoint_left]
          intro x hxl hx
          have hxl' : x = l := by simpa using hxl
          subst x
          rcases Finset.mem_union.mp hx with hlz | hlH
          · exact hlNotZ hlz
          · exact hlNotH hlH
        have hlNeighbors : ∀ a ∈ ({l} : Finset V), ∀ b,
            G.Adj a b → b ∈ {z} ∪ H := by
          intro a ha b hab
          have hal : a = l := by simpa using ha
          subst a
          rcases hside b with hbL | hbM | hbR
          · exact False.elim (B.left_independent
              (Finset.mem_inter.mp hlL2).1 hbL hab.ne hab)
          · by_cases hbS : b ∈ S
            · exact Finset.mem_union_right _ (Finset.mem_inter.mpr
                ⟨hbS, Finset.mem_compl.mpr (fun hbR ↦
                  (Finset.disjoint_left.mp B.middle_right_disjoint) hbM hbR)⟩)
            · have hbM2 : b ∈ M2 :=
                Finset.mem_inter.mpr ⟨hbM, Finset.mem_compl.mpr hbS⟩
              have hbA : b ∈ A := by rw [hAeq]; exact Finset.mem_union_right _ hbM2
              have hbVals : b = z ∨ b = l := by simpa [hAlpair] using hbA
              rcases hbVals with rfl | rfl
              · exact Finset.mem_union_left _ (by simp)
              · exact False.elim (G.loopless.irrefl _ hab)
          · exact False.elim (B.left_right_nonadjacent
              (Finset.mem_inter.mp hlL2).1 hbR hab)
        have hlBoundary := boundaryMultiplicity_eq_between_of_neighbors_subset
          G {l} ({z} ∪ H) hlTargetDisj hlNeighbors
        have hlcut := boundaryMultiplicity_singleton_of_quartic G hreg l
        have hzhDisj : Disjoint ({z} : Finset V) H := by simp [hzNotH]
        have hsource : Disjoint ({l} : Finset V) ({z} ∪ H) := hlTargetDisj
        have hsplit := P.betweenMultiplicity_union_right
          {l} {z} H hzhDisj hsource
        have hlzCount : P.betweenMultiplicity {l} {z} = 1 := by
          rw [P.betweenMultiplicity_comm]
          rw [Pseudograph.betweenMultiplicity_singleton_ofSimple G z {l}
            (by simp [hzl])]
          rw [Finset.filter_singleton, if_pos hzlAdj]
          rfl
        have hlHcount : P.betweenMultiplicity {l} H = 3 := by
          rw [hlcut, hsplit, hlzCount] at hlBoundary
          omega
        have hzlDisj : Disjoint ({z} : Finset V) {l} := by simp [hzl]
        have hpairH : Disjoint (({z} : Finset V) ∪ {l}) H := by
          simpa [hAlpair] using hAHdisj
        have hsplitA := P.betweenMultiplicity_union_left
          {z} {l} H hzlDisj hpairH
        have hAHcount : P.betweenMultiplicity A H = 4 := by
          rw [show A = ({z} : Finset V) ∪ {l} by simpa [hAlpair],
            hsplitA, hzHcount, hlHcount]
        rw [hAtwo.1, hAHcount] at hAHcut
        omega
    · obtain ⟨_hnone, _hunique, huNot, hinside⟩ := hout
      have huA : selection.center ∈ A := by
        exact Finset.mem_inter.mpr ⟨Finset.mem_compl.mpr huNot,
          Finset.mem_compl.mpr (fun huR ↦
            (Finset.disjoint_left.mp B.left_right_disjoint)
              B.distinguished_mem_left huR)⟩
      obtain ⟨m, hmM2⟩ := hM2nonempty
      have hmA : m ∈ A := by rw [hAeq]; exact Finset.mem_union_right _ hmM2
      have hum : selection.center ≠ m := by
        intro h
        subst m
        exact (Finset.disjoint_left.mp B.left_middle_disjoint)
          B.distinguished_mem_left (Finset.mem_inter.mp hmM2).1
      rcases hAcutCases with hAone | hAtwo
      · have hEq := (Finset.card_le_one.mp (by omega : A.card ≤ 1))
          selection.center huA m hmA
        exact hum hEq
      · have hAeqPair : A = {selection.center, m} := by
          symm
          apply Finset.eq_of_subset_of_card_le
          · intro y hy
            simp only [Finset.mem_insert, Finset.mem_singleton] at hy
            rcases hy with rfl | rfl
            · exact huA
            · exact hmA
          · simp [hum, hAtwo.2]
        have humAdj : G.Adj selection.center m := by
          have hdisj : Disjoint ({selection.center} : Finset V) {m} := by
            simp [hum]
          have hunion := P.boundaryMultiplicity_union_add_two_between
            ((Pseudograph.isRegularOfDegree_ofSimple_iff G 4).mpr hreg)
            {selection.center} {m} hdisj
          have hucut := boundaryMultiplicity_singleton_of_quartic
            G hreg selection.center
          have hmcut := boundaryMultiplicity_singleton_of_quartic G hreg m
          rw [show ({selection.center} : Finset V) ∪ {m} = A by
              simpa [hAeqPair], hAtwo.1, hucut, hmcut] at hunion
          have hbetween : P.betweenMultiplicity {selection.center} {m} = 1 := by omega
          rw [Pseudograph.betweenMultiplicity_singleton_ofSimple
            G selection.center {m} (by simp [hum])] at hbetween
          by_contra hnot
          rw [Finset.filter_singleton, if_neg hnot] at hbetween
          simp at hbetween
        have huTargetDisj : Disjoint ({selection.center} : Finset V)
            (S ∪ {m}) := by
          rw [Finset.disjoint_left]
          intro x hxu hx
          have hxu' : x = selection.center := by simpa using hxu
          subst x
          rcases Finset.mem_union.mp hx with huS | humem
          · exact huNot huS
          · exact hum (by simpa using humem)
        have huNeighbors : ∀ a ∈ ({selection.center} : Finset V), ∀ b,
            G.Adj a b → b ∈ S ∪ {m} := by
          intro a ha b hab
          have hau : a = selection.center := by simpa using ha
          subst a
          by_cases hbS : b ∈ S
          · exact Finset.mem_union_left _ hbS
          · have hbM : b ∈ B.middle := B.neighbor_mem_middle hab
            have hbA : b ∈ A := by
              rw [hAeq]
              exact Finset.mem_union_right _
                (Finset.mem_inter.mpr ⟨hbM, Finset.mem_compl.mpr hbS⟩)
            have hbVals : b = selection.center ∨ b = m := by
              simpa [hAeqPair] using hbA
            rcases hbVals with rfl | rfl
            · exact False.elim (G.loopless.irrefl selection.center hab)
            · exact Finset.mem_union_right _ (by simp)
        have huBoundary := boundaryMultiplicity_eq_between_of_neighbors_subset
          G {selection.center} (S ∪ {m}) huTargetDisj huNeighbors
        have hucut := boundaryMultiplicity_singleton_of_quartic
          G hreg selection.center
        have hSmDisj : Disjoint S ({m} : Finset V) := by
          simp [(Finset.mem_compl.mp (Finset.mem_inter.mp hmM2).2)]
        have hsplit := P.betweenMultiplicity_union_right
          {selection.center} S {m} hSmDisj huTargetDisj
        have humCount : P.betweenMultiplicity {selection.center} {m} = 1 := by
          rw [Pseudograph.betweenMultiplicity_singleton_ofSimple
            G selection.center {m} (by simp [hum])]
          rw [Finset.filter_singleton, if_pos humAdj]
          rfl
        have hinsideEq : P.betweenMultiplicity {selection.center} S = 3 := by
          rw [hucut, hsplit, humCount] at huBoundary
          omega
        have hinsideUpper := M.insideDegree_of_notMem_le_two
          hreg hno2 hno4 selection.center huNot
        change P.betweenMultiplicity {selection.center} S ≤ 2 at hinsideUpper
        omega

/-! ### Completion of the minimal-counterexample argument -/

/-- Proposition 4.4: a vertex-minimal counterexample has no nontrivial
six-edge cut.  The selected centre and its Section 4 barrier fall into the
three genuine barrier kinds, all excluded above. -/
theorem IsVertexMinimalCounterexample.hasOnlyTrivialSixCuts
    {n : ℕ} {G : Pseudograph (Fin n)}
    (hmin : IsVertexMinimalCounterexample G)
    (hsimple : G.HasSimpleMultiplicities) :
    HasOnlyTrivialSixCuts G.toSimple := by
  classical
  letI : DecidableEq (Fin n) := Classical.decEq _
  letI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  let K := G.toSimple
  have hPG : Pseudograph.ofSimple K = G := by
    simpa [K] using
      Pseudograph.eq_ofSimple_toSimple_of_hasSimpleMultiplicities G hsimple
  have hreg : K.IsRegularOfDegree 4 := by
    rw [← Pseudograph.isRegularOfDegree_ofSimple_iff]
    simpa [hPG] using hmin.in_class.1
  have hconn : K.Connected := by
    simpa [K] using hmin.underlying_connected
  have hodd : Odd (Nat.card (Fin n)) := by
    simpa [K] using hmin.odd_order_of_hasSimpleMultiplicities hsimple
  have hno2 : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple K).boundaryMultiplicity S ≠ 2 := by
    intro S hS hproper
    have h := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple S hS hproper
    simpa [hPG] using h
  have hno4 : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple K).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1 := by
    intro S hS hproper hcut
    have hcutG : G.boundaryMultiplicity S = 4 := by simpa [hPG] using hcut
    rcases hmin.only_trivial_four_cuts_of_hasSimpleMultiplicities hsimple
        S hS hproper hcutG with hcard | hcard
    · exact .inl hcard
    · right
      simpa only [Finset.card_compl] using hcard
  have hnoBip : Pseudograph.HasNoNontrivialBipartiteSixShore K := by
    simpa [K] using
      Pseudograph.IsVertexMinimalCounterexample.hasNoNontrivialBipartiteSixShore
        hmin hsimple
  have hnoCubic : ¬ ContainsRegularSubgraph K 3 := by
    intro h
    apply hmin.no_cubic_part
    have hp := Pseudograph.containsRegularPart_of_containsRegularSubgraph K h
    simpa only [hPG] using hp
  have hindependent : ∀ U : Finset (Fin n),
      K.IsIndepSet (U : Set (Fin n)) →
        2 < (Pseudograph.ofSimple K).internalMultiplicity Uᶜ := by
    intro U hU
    exact Pseudograph.two_lt_internalMultiplicity_compl_of_independent
      K hreg hodd hnoCubic hnoBip U hU
  have htri : HasNoTriangles K := by
    simpa [K] using hmin.hasNoTriangles hsimple
  by_contra hnot
  obtain ⟨M⟩ := exists_minimalSixShore K hnot
  obtain ⟨selection⟩ :=
    exists_sixCutCenterSelection K hreg hconn hno2 hno4 M
  have hnoMatching :
      ¬ ∃ N : (K.induce (antiNeighborhood K selection.center)).Subgraph,
        N.IsPerfectMatching := by
    intro hm
    obtain ⟨N, hN⟩ := hm
    exact hnoCubic
      (containsThreeRegular_of_isPerfectMatching_antiNeighborhood
        K selection.center hreg N hN)
  obtain ⟨B⟩ := exists_section4Barrier K hreg hodd hconn hno2 hno4
    hindependent selection.center hnoMatching
  rcases B.genuine with hA | hB | hC
  · by_cases hR : (B.right ∩ M.shore).Nonempty
    · exact false_of_section4Barrier_A_of_right_inter_nonempty
        K hreg hconn hno2 hno4 htri M selection B hA hR
    · exact false_of_section4Barrier_A_of_right_inter_empty
        K hreg hconn hno2 hno4 hnoBip htri M selection B hA
          (Finset.not_nonempty_iff_eq_empty.mp hR)
  · exact false_of_section4Barrier_B
      K hreg hconn hno2 hno4 hnoBip M selection B hB
  · exact false_of_section4Barrier_C
      K hreg hconn hno2 hno4 hnoBip htri M selection B hC

/-- Every nonempty member of Tashkinov's quartic induction class contains a
nonempty cubic part. -/
theorem Pseudograph.containsRegularPart_three_of_inTashkinovClass
    {W : Type*} [Fintype W] [Nonempty W] (G : Pseudograph W)
    (hclass : G.InTashkinovClass) : G.ContainsRegularPart 3 := by
  classical
  by_contra hbad
  obtain ⟨n, G₀, hmin⟩ :=
    exists_vertexMinimalCounterexample G hclass hbad
  letI : DecidableEq (Fin n) := Classical.decEq _
  letI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hmin.positive_order
  have hsimple := hmin.hasSimpleMultiplicities
  let K := G₀.toSimple
  have hPG : Pseudograph.ofSimple K = G₀ := by
    simpa [K] using
      Pseudograph.eq_ofSimple_toSimple_of_hasSimpleMultiplicities G₀ hsimple
  have hreg : K.IsRegularOfDegree 4 := by
    rw [← Pseudograph.isRegularOfDegree_ofSimple_iff]
    simpa [hPG] using hmin.in_class.1
  have hconn : K.Connected := by
    simpa [K] using hmin.underlying_connected
  have hodd : Odd (Nat.card (Fin n)) := by
    simpa [K] using hmin.odd_order_of_hasSimpleMultiplicities hsimple
  have hno2 : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple K).boundaryMultiplicity S ≠ 2 := by
    intro S hS hproper
    have h := hmin.no_two_cut_of_hasSimpleMultiplicities hsimple S hS hproper
    simpa [hPG] using h
  have hno4 : ∀ S : Finset (Fin n), S.Nonempty → S ≠ Finset.univ →
      (Pseudograph.ofSimple K).boundaryMultiplicity S = 4 →
        S.card = 1 ∨ Sᶜ.card = 1 := by
    intro S hS hproper hcut
    have hcutG : G₀.boundaryMultiplicity S = 4 := by simpa [hPG] using hcut
    rcases hmin.only_trivial_four_cuts_of_hasSimpleMultiplicities hsimple
        S hS hproper hcutG with hcard | hcard
    · exact .inl hcard
    · right
      simpa only [Finset.card_compl] using hcard
  have hnoCubic : ¬ ContainsRegularSubgraph K 3 := by
    intro h
    apply hmin.no_cubic_part
    have hp := Pseudograph.containsRegularPart_of_containsRegularSubgraph K h
    simpa only [hPG] using hp
  have hnoBip : Pseudograph.HasNoNontrivialBipartiteSixShore K := by
    simpa [K] using
      Pseudograph.IsVertexMinimalCounterexample.hasNoNontrivialBipartiteSixShore
        hmin hsimple
  have hindependent : ∀ U : Finset (Fin n),
      K.IsIndepSet (U : Set (Fin n)) →
        2 < (Pseudograph.ofSimple K).internalMultiplicity Uᶜ := by
    intro U hU
    exact Pseudograph.two_lt_internalMultiplicity_compl_of_independent
      K hreg hodd hnoCubic hnoBip U hU
  have hno6 : HasOnlyTrivialSixCuts K := by
    simpa [K] using hmin.hasOnlyTrivialSixCuts hsimple
  have hcubic := containsThreeRegular_of_odd_of_structural_properties
    K hreg hodd hconn hno2 hno4 hindependent hno6
  exact hnoCubic hcubic

/-- **Erdős Problem 715 (Tashkinov).**  Every finite nonempty simple
4-regular graph contains a nonempty 3-regular subgraph. -/
theorem erdos_715 [Nonempty V] (G : SimpleGraph V)
    (hreg : G.IsRegularOfDegree 4) : ContainsRegularSubgraph G 3 := by
  have hpart := Pseudograph.containsRegularPart_three_of_inTashkinovClass
    (Pseudograph.ofSimple G) (Pseudograph.inTashkinovClass_ofSimple G hreg)
  exact Pseudograph.containsRegularSubgraph_of_containsRegularPart_ofSimple
    G (by decide) hpart

universe u

/-- A degree is cubic-forcing when every finite nonempty simple regular graph
of that degree contains a nonempty cubic subgraph. -/
def IsCubicForcingDegree (r : ℕ) : Prop :=
  ∀ (W : Type u) [Fintype W] [Nonempty W], ∀ G : SimpleGraph W,
    G.IsRegularOfDegree r → ContainsRegularSubgraph G 3

/-- The existential question in Problem 715 also has an affirmative answer:
degree four itself is cubic-forcing. -/
theorem erdos_715_exists_degree : ∃ r : ℕ, IsCubicForcingDegree.{u} r := by
  refine ⟨4, ?_⟩
  intro W _ _ G hreg
  exact erdos_715 G hreg

end Erdos715
