import Mathlib

/-!
# Integral rounding of locally finite flows

This file contains the integral-flow compactness lemma used in the proof of
Laczkovich's circle-squaring theorem.  We formulate the locally finite graph as
finitely many families of directed edges generated by permutations of the
vertex type.  This is exactly the grid graph attached to a free `ℤ^d`-action.
-/

namespace Erdos1124

open Finset

namespace IntegralFlow

universe u v

namespace WeightedHall

variable {I J : Type*} [Fintype I] [Fintype J]

private def filteredSlotsEquiv (k : J → ℕ) (P : J → Prop) [DecidablePred P] :
    ↑(Finset.univ.filter (fun s : Σ j, Fin (k j) ↦ P s.1)) ≃
      Σ j : ↑(Finset.univ.filter P), Fin (k j.1) where
  toFun s := ⟨⟨s.1.1, by simpa only [mem_filter, mem_univ, true_and] using s.2⟩, s.1.2⟩
  invFun s := ⟨⟨s.1.1, s.2⟩, by simpa only [mem_filter, mem_univ, true_and] using s.1.2⟩
  left_inv s := by simp
  right_inv s := by simp

private lemma card_filteredSlots (k : J → ℕ) (P : J → Prop) [DecidablePred P] :
    #(Finset.univ.filter (fun s : Σ j, Fin (k j) ↦ P s.1)) =
      ∑ j ∈ Finset.univ.filter P, k j := by
  classical
  rw [← Fintype.card_coe, Fintype.card_congr (filteredSlotsEquiv k P)]
  simp only [Fintype.card_sigma, Fintype.card_fin]
  exact Finset.sum_attach _ _

/-- Weighted Hall rounding: a fractional assignment with integral column
capacities has an integral assignment, using only positive-weight pairs. -/
theorem weightedHall [DecidableEq J]
    (w : I → J → ℝ) (k : J → ℕ)
    (hw : ∀ i j, 0 ≤ w i j)
    (hrow : ∀ i, ∑ j, w i j = 1)
    (hcol : ∀ j, ∑ i, w i j = k j) :
    ∃ f : I → J, (∀ i, 0 < w i (f i)) ∧ ∀ j, #{i | f i = j} = k j := by
  classical
  let Slot := Σ j, Fin (k j)
  let r : I → Slot → Prop := fun i s ↦ 0 < w i s.1
  have hall : ∀ A : Finset I, #A ≤ #{s | ∃ i ∈ A, r i s} := by
    intro A
    let N : Finset J := {j | ∃ i ∈ A, 0 < w i j}
    have hz : ∀ j ∈ Finset.univ, j ∉ N → ∑ i ∈ A, w i j = 0 := by
      intro j _ hj
      apply sum_eq_zero
      intro i hi
      apply le_antisymm
      · exact not_lt.mp (fun hp ↦ hj (by
          simp only [N, mem_filter, mem_univ, true_and]
          exact ⟨i, hi, hp⟩))
      · exact hw i j
    have hweight : (A.card : ℝ) ≤ ∑ j ∈ N, (k j : ℝ) := by
      calc
        (A.card : ℝ) = ∑ i ∈ A, ∑ j, w i j := by simp [hrow]
        _ = ∑ j, ∑ i ∈ A, w i j := by rw [sum_comm]
        _ = ∑ j ∈ N, ∑ i ∈ A, w i j := by
          exact (sum_subset (by simp) hz).symm
        _ ≤ ∑ j ∈ N, ∑ i, w i j := by
          exact sum_le_sum fun j _ ↦
            sum_le_sum_of_subset_of_nonneg (subset_univ A) (fun i _ _ ↦ hw i j)
        _ = ∑ j ∈ N, (k j : ℝ) := by simp [hcol]
    have hn : A.card ≤ ∑ j ∈ N, k j := by exact_mod_cast hweight
    rw [show #{s | ∃ i ∈ A, r i s} = ∑ j ∈ N, k j by
      simpa only [r, N, Slot] using card_filteredSlots k (fun j ↦ ∃ i ∈ A, 0 < w i j)]
    exact hn
  obtain ⟨g, hg, hgr⟩ :=
    (Fintype.all_card_le_filter_rel_iff_exists_injective r).mp hall
  let f : I → J := fun i ↦ (g i).1
  have hcard : Fintype.card I = Fintype.card Slot := by
    calc
      Fintype.card I = ∑ j, k j := by
        have hcR : (Fintype.card I : ℝ) = ∑ j, (k j : ℝ) := by
          calc
            (Fintype.card I : ℝ) = ∑ i, ∑ j, w i j := by simp [hrow]
            _ = ∑ j, ∑ i, w i j := by rw [sum_comm]
            _ = ∑ j, (k j : ℝ) := by simp [hcol]
        exact_mod_cast hcR
      _ = Fintype.card Slot := by simp [Slot]
  have hgbij : Function.Bijective g :=
    (Fintype.bijective_iff_injective_and_card g).2 ⟨hg, hcard⟩
  refine ⟨f, fun i ↦ hgr i, ?_⟩
  intro j
  let eg : I ≃ Slot := Equiv.ofBijective g hgbij
  let ep : ↑({i | f i = j} : Finset I) ≃ {i // f i = j} :=
    (Equiv.refl I).subtypeEquiv (fun i ↦ by simp)
  let e : ↑({i | f i = j} : Finset I) ≃ Fin (k j) :=
    ep.trans ((eg.subtypeEquiv (fun _ ↦ Iff.rfl)).trans (Equiv.sigmaSubtype j))
  rw [← Fintype.card_coe]
  exact (Fintype.card_congr e).trans (Fintype.card_fin (k j))

end WeightedHall

open Set

/-- A locally finite directed graph whose edges are `(x, i)` and run from `x`
to `move i x`.  The direction type is finite. -/
structure PermutationGraph (X : Type u) (ι : Type v) [Fintype ι] where
  move : ι → Equiv.Perm X

variable {X : Type u} {ι : Type v} [Fintype ι]

/-- Divergence, with the convention "incoming minus outgoing". -/
def PermutationGraph.divergence {R : Type*} [AddCommGroup R]
    (G : PermutationGraph X ι) (flow : X → ι → R) (x : X) : R :=
  ∑ i, (flow ((G.move i).symm x) i - flow x i)

/-- The finite type of integers in the capacity interval `[-b,b]`. -/
abbrev BoundedInt (b : ℕ) := Set.Icc (-(b : ℤ)) (b : ℤ)

noncomputable instance (b : ℕ) : Fintype (BoundedInt b) := by infer_instance

@[simp]
theorem BoundedInt.abs_coe_le (b : ℕ) (z : BoundedInt b) : |(z : ℤ)| ≤ b := by
  rw [abs_le]
  exact z.2

/-- A local system of divergence equations on a finite set of vertices. -/
def SatisfiesOn (G : PermutationGraph X ι) (rhs : X → ℤ) (s : Finset X)
    (flow : X → ι → ℤ) : Prop :=
  ∀ x ∈ s, G.divergence flow x = rhs x

/-- Compactness for bounded integer flows.  It is deliberately separated from
finite integral rounding: a solution to every finite subsystem gives a global
solution. -/
theorem exists_global_of_exists_local (G : PermutationGraph X ι) (rhs : X → ℤ) (b : ℕ)
    (hlocal : ∀ s : Finset X, ∃ flow : X → ι → ℤ,
      (∀ x i, |flow x i| ≤ b) ∧ SatisfiesOn G rhs s flow) :
    ∃ flow : X → ι → ℤ,
      (∀ x i, |flow x i| ≤ b) ∧ ∀ x, G.divergence flow x = rhs x := by
  classical
  let K := X → ι → BoundedInt b
  let C (x : X) : Set K :=
    {flow | G.divergence (fun y i ↦ (flow y i : ℤ)) x = rhs x}
  have hKC : CompactSpace K := by infer_instance
  have hclosed (x : X) : IsClosed (C x) := by
    change IsClosed {flow : X → ι → BoundedInt b |
      (∑ i, ((flow ((G.move i).symm x) i : ℤ) - (flow x i : ℤ))) = rhs x}
    exact isClosed_eq
      (continuous_finsetSum Finset.univ fun i _ ↦
        (continuous_subtype_val.comp
          (continuous_apply_apply ((G.move i).symm x) i)).sub
          (continuous_subtype_val.comp (continuous_apply_apply x i)))
      continuous_const
  have hfip (s : Finset X) : (⋂ x ∈ s, C x).Nonempty := by
    obtain ⟨flow, hbound, hflow⟩ := hlocal s
    let boundedFlow : K := fun x i ↦
      ⟨flow x i, (abs_le.mp (hbound x i))⟩
    refine ⟨boundedFlow, ?_⟩
    simp only [mem_iInter]
    intro x hx
    exact hflow x hx
  obtain ⟨flow, hflow⟩ :=
    (isCompact_univ : IsCompact (Set.univ : Set K)).inter_iInter_nonempty C hclosed
      (fun s ↦ by simpa using hfip s)
  refine ⟨fun x i ↦ (flow x i : ℤ), ?_, ?_⟩
  · exact fun x i ↦ BoundedInt.abs_coe_le b (flow x i)
  · intro x
    exact (Set.mem_iInter.mp hflow.2 x)

/-! ## Finite integral rounding -/

/-- Divergence on a finite directed multigraph.  Loops contribute zero. -/
def finiteDivergence {V E R : Type*} [Fintype E] [DecidableEq V] [AddCommGroup R]
    (src dst : E → V) (flow : E → R) (v : V) : R :=
  (∑ e, if dst e = v then flow e else 0) -
    ∑ e, if src e = v then flow e else 0

/-- Fractional assignment of an edge to its target (with weight `fract`) or
its source (with the complementary weight). -/
noncomputable def finiteWeight {V E : Type*} [DecidableEq V]
    (src dst : E → V) (flow : E → ℝ) (e : E) (v : V) : ℝ :=
  (if dst e = v then Int.fract (flow e) else 0) +
    if src e = v then 1 - Int.fract (flow e) else 0

lemma finiteWeight_nonneg {V E : Type*} [DecidableEq V]
    (src dst : E → V) (flow : E → ℝ) (e : E) (v : V) :
    0 ≤ finiteWeight src dst flow e v := by
  simp only [finiteWeight]
  exact add_nonneg (by split_ifs <;> positivity) (by split_ifs <;>
    simp_all only [sub_nonneg, Int.fract_lt_one, le_of_lt, le_refl])

lemma finiteWeight_sum {V E : Type*} [Fintype V] [DecidableEq V]
    (src dst : E → V) (flow : E → ℝ) (e : E) :
    ∑ v, finiteWeight src dst flow e v = 1 := by
  simp only [finiteWeight, sum_add_distrib]
  rw [Fintype.sum_ite_eq (dst e) (fun _ ↦ Int.fract (flow e)),
    Fintype.sum_ite_eq (src e) (fun _ ↦ 1 - Int.fract (flow e))]
  ring

lemma finiteWeight_column {V E : Type*} [Fintype V] [Fintype E]
    [DecidableEq V] (src dst : E → V) (flow : E → ℝ)
    (rhs : V → ℤ) (hdiv : ∀ v, finiteDivergence src dst flow v = rhs v)
    (v : V) :
    ∑ e, finiteWeight src dst flow e v =
      ((#{e | src e = v} : ℤ) + rhs v -
        finiteDivergence src dst (fun e ↦ ⌊flow e⌋) v : ℤ) := by
  push_cast
  rw [← hdiv v]
  simp only [finiteWeight, finiteDivergence, Int.fract, sum_add_distrib]
  simp only [sum_ite, sum_const_zero, Finset.card_filter]
  simp_rw [sum_sub_distrib]
  push_cast
  ring

/-- Every finite real flow with integral divergence can be rounded edgewise
to a floor or ceiling while preserving all divergences.  The ceiling is used
only on genuinely nonintegral edges. -/
theorem finite_integral_rounding {V E : Type*} [Fintype V] [Fintype E]
    [DecidableEq V] (src dst : E → V) (flow : E → ℝ) (rhs : V → ℤ)
    (hdiv : ∀ v, finiteDivergence src dst flow v = rhs v) :
    ∃ rounded : E → ℤ,
      (∀ v, finiteDivergence src dst rounded v = rhs v) ∧
      ∀ e, rounded e = ⌊flow e⌋ ∨
        (rounded e = ⌊flow e⌋ + 1 ∧ 0 < Int.fract (flow e)) := by
  classical
  let need : V → ℤ := fun v ↦
    (#{e | src e = v} : ℤ) + rhs v -
      finiteDivergence src dst (fun e ↦ ⌊flow e⌋) v
  have hcolumn (v : V) :
      ∑ e, finiteWeight src dst flow e v = (need v : ℝ) := by
    simpa only [need] using finiteWeight_column src dst flow rhs hdiv v
  have hneed (v : V) : 0 ≤ need v := by
    have hr : (0 : ℝ) ≤ (need v : ℝ) := by
      rw [← hcolumn v]
      exact sum_nonneg fun e _ ↦ finiteWeight_nonneg src dst flow e v
    exact_mod_cast hr
  let capacity : V → ℕ := fun v ↦ (need v).toNat
  have hcapacity (v : V) :
      ∑ e, finiteWeight src dst flow e v = capacity v := by
    rw [hcolumn]
    exact_mod_cast (Int.toNat_of_nonneg (hneed v)).symm
  obtain ⟨assigned, hpositive, hcount⟩ :=
    WeightedHall.weightedHall (finiteWeight src dst flow) capacity
      (finiteWeight_nonneg src dst flow) (finiteWeight_sum src dst flow) hcapacity
  let bit : E → ℤ := fun e ↦
    if assigned e = dst e ∧ 0 < Int.fract (flow e) then 1 else 0
  have hedge (e : E) (v : V) :
      (if assigned e = v then (1 : ℤ) else 0) =
        (if dst e = v then bit e else 0) +
          (if src e = v then 1 - bit e else 0) := by
    have hp := hpositive e
    have hsupp : assigned e = dst e ∨ assigned e = src e := by
      by_contra h
      push Not at h
      simp [finiteWeight, Ne.symm h.1, Ne.symm h.2] at hp
    by_cases hloop : src e = dst e
    · have ha : assigned e = dst e := by rcases hsupp with h | h <;> simpa [hloop] using h
      by_cases hdv : dst e = v
      · subst v
        simp [bit, ha, hloop]
      · have hav : assigned e ≠ v := by simpa [ha] using hdv
        have hsv : src e ≠ v := by simpa [hloop] using hdv
        simp [bit, hdv, hsv, hav]
    · rcases hsupp with ha | ha
      · have hfract : 0 < Int.fract (flow e) := by
          simpa [finiteWeight, ha, hloop] using hp
        simp [bit, ha, hfract]
      · have had : assigned e ≠ dst e := by
          intro h
          exact hloop (ha.symm.trans h)
        simp [bit, ha, hloop]
  have hbitDiv (v : V) :
      finiteDivergence src dst bit v =
        need v - (#{e | src e = v} : ℤ) := by
    have hc : (∑ e, if assigned e = v then (1 : ℤ) else 0) = need v := by
      have hsumNat : (∑ e, if assigned e = v then (1 : ℕ) else 0) = capacity v := by
        rw [← Finset.card_filter, hcount v]
      calc
        (∑ e, if assigned e = v then (1 : ℤ) else 0) =
            ((∑ e, if assigned e = v then (1 : ℕ) else 0 : ℕ) : ℤ) := by push_cast; rfl
        _ = capacity v := by exact_mod_cast hsumNat
        _ = need v := by exact_mod_cast Int.toNat_of_nonneg (hneed v)
    rw [show (∑ e, if assigned e = v then (1 : ℤ) else 0) =
        ∑ e, ((if dst e = v then bit e else 0) +
          if src e = v then 1 - bit e else 0) by
      apply sum_congr rfl
      intro e _
      exact hedge e v] at hc
    simp only [sum_add_distrib, sum_ite, sum_const_zero, finiteDivergence] at hc ⊢
    simp_rw [sum_sub_distrib] at hc
    simp only [sum_const, nsmul_eq_mul, mul_one] at hc
    omega
  let rounded : E → ℤ := fun e ↦ ⌊flow e⌋ + bit e
  refine ⟨rounded, ?_, ?_⟩
  · intro v
    change finiteDivergence src dst (fun e ↦ ⌊flow e⌋ + bit e) v = rhs v
    rw [show finiteDivergence src dst (fun e ↦ ⌊flow e⌋ + bit e) v =
        finiteDivergence src dst (fun e ↦ ⌊flow e⌋) v +
          finiteDivergence src dst bit v by
      simp only [finiteDivergence, sum_ite, sum_const_zero, sum_add_distrib]
      ring]
    rw [hbitDiv v]
    simp only [need]
    ring
  · intro e
    by_cases hb : assigned e = dst e ∧ 0 < Int.fract (flow e)
    · right
      exact ⟨by simp [rounded, bit, hb], hb.2⟩
    · left
      simp [rounded, bit, hb]

/-- The finite rounding theorem with an integral symmetric capacity. -/
theorem finite_integral_rounding_bounded {V E : Type*} [Fintype V] [Fintype E]
    [DecidableEq V] (src dst : E → V) (flow : E → ℝ) (rhs : V → ℤ) (b : ℕ)
    (hdiv : ∀ v, finiteDivergence src dst flow v = rhs v)
    (hbound : ∀ e, |flow e| ≤ b) :
    ∃ rounded : E → ℤ,
      (∀ v, finiteDivergence src dst rounded v = rhs v) ∧
      ∀ e, |rounded e| ≤ b := by
  obtain ⟨rounded, hrounded, hchoice⟩ :=
    finite_integral_rounding src dst flow rhs hdiv
  refine ⟨rounded, hrounded, fun e ↦ ?_⟩
  have hb := abs_le.mp (hbound e)
  have hfloorLower : -(b : ℤ) ≤ ⌊flow e⌋ := by
    rw [Int.le_floor]
    exact_mod_cast hb.1
  have hfloorUpper : ⌊flow e⌋ ≤ (b : ℤ) := by
    exact_mod_cast (Int.floor_le (flow e)).trans hb.2
  rcases hchoice e with h | ⟨h, hfract⟩
  · rw [h, abs_le]
    exact ⟨hfloorLower, hfloorUpper⟩
  · rw [h, abs_le]
    constructor
    · omega
    · have hlt : ((⌊flow e⌋ : ℤ) : ℝ) < flow e := by
        simpa only [Int.fract] using sub_pos.mp hfract
      have hltb : ⌊flow e⌋ < (b : ℤ) := by
        exact_mod_cast hlt.trans_le hb.2
      omega

/-! ## From finite rounding to a locally finite permutation graph -/

/-- Edges incident to a finite vertex set. -/
def incidentEdges [DecidableEq X] [DecidableEq ι]
    (G : PermutationGraph X ι) (s : Finset X) : Finset (X × ι) :=
  (s ×ˢ Finset.univ) ∪
    (s ×ˢ Finset.univ).image (fun p ↦ ((G.move p.2).symm p.1, p.2))

@[simp]
lemma outgoing_mem_incidentEdges [DecidableEq X] [DecidableEq ι]
    (G : PermutationGraph X ι) (s : Finset X) {x : X} (hx : x ∈ s) (i : ι) :
    (x, i) ∈ incidentEdges G s := by
  simp [incidentEdges, hx]

@[simp]
lemma incoming_mem_incidentEdges [DecidableEq X] [DecidableEq ι]
    (G : PermutationGraph X ι) (s : Finset X) {x : X} (hx : x ∈ s) (i : ι) :
    ((G.move i).symm x, i) ∈ incidentEdges G s := by
  apply Finset.mem_union.mpr
  right
  exact Finset.mem_image.mpr ⟨(x, i), by simp [hx], by simp⟩

/-- Collapse every vertex outside `s` to a single boundary vertex. -/
def collapseVertex (s : Finset X) [DecidableEq X] (x : X) : s ⊕ Unit :=
  if hx : x ∈ s then Sum.inl ⟨x, hx⟩ else Sum.inr ()

@[simp]
lemma collapseVertex_eq_inl [DecidableEq X] (s : Finset X) (x : s) (y : X) :
    collapseVertex s y = Sum.inl x ↔ y = x := by
  by_cases hy : y ∈ s
  · simp [collapseVertex, hy, Subtype.ext_iff]
  · simp only [collapseVertex, hy, ↓reduceDIte]
    constructor
    · intro h
      cases h
    · intro h
      subst y
      exact (hy x.2).elim

/-- On a vertex retained by the collapse, finite-graph divergence is the
original permutation-graph divergence. -/
lemma collapsed_divergence_inl {R : Type*} [AddCommGroup R]
    [DecidableEq X] [DecidableEq ι]
    (G : PermutationGraph X ι) (s : Finset X) (flow : X → ι → R) (x : s) :
    finiteDivergence
      (fun e : incidentEdges G s ↦ collapseVertex s e.1.1)
      (fun e : incidentEdges G s ↦ collapseVertex s (G.move e.1.2 e.1.1))
      (fun e : incidentEdges G s ↦ flow e.1.1 e.1.2) (Sum.inl x) =
        G.divergence flow x := by
  classical
  simp only [finiteDivergence, collapseVertex_eq_inl, PermutationGraph.divergence]
  have hin :
      (∑ e : incidentEdges G s,
        if G.move e.1.2 e.1.1 = x then flow e.1.1 e.1.2 else 0) =
        ∑ i, flow ((G.move i).symm x) i := by
    have hsub := Finset.sum_subtype (F := (incidentEdges G s).fintypeCoeSort)
      (incidentEdges G s) (fun _ ↦ Iff.rfl)
      (fun e : X × ι ↦
        if G.move e.2 e.1 = x then flow e.1 e.2 else 0)
    rw [← hsub]
    rw [← Finset.sum_filter]
    symm
    apply Finset.sum_bij (s := Finset.univ)
        (t := (incidentEdges G s).filter
          (fun e ↦ G.move e.2 e.1 = x))
        (fun i _ ↦ ((G.move i).symm x, i))
    · intro i _
      simp [incoming_mem_incidentEdges G s x.2 i]
    · intro i _ j _ h
      exact congrArg Prod.snd h
    · intro e he
      simp only [mem_filter] at he
      refine ⟨e.2, mem_univ _, ?_⟩
      apply Prod.ext
      · simpa using (congrArg (G.move e.2).symm he.2).symm
      · rfl
    · intro i _
      rfl
  have hout :
      (∑ e : incidentEdges G s,
        if e.1.1 = x then flow e.1.1 e.1.2 else 0) =
        ∑ i, flow x i := by
    have hsub := Finset.sum_subtype (F := (incidentEdges G s).fintypeCoeSort)
      (incidentEdges G s) (fun _ ↦ Iff.rfl)
      (fun e : X × ι ↦ if e.1 = x then flow e.1 e.2 else 0)
    rw [← hsub]
    rw [← Finset.sum_filter]
    symm
    apply Finset.sum_bij (s := Finset.univ)
      (t := (incidentEdges G s).filter (fun e ↦ e.1 = (x : X)))
      (fun i _ ↦ (x, i))
    · intro i _
      simp [outgoing_mem_incidentEdges G s x.2 i]
    · intro i _ j _ h
      exact congrArg Prod.snd h
    · intro e he
      simp only [mem_filter] at he
      exact ⟨e.2, mem_univ _, Prod.ext he.2.symm rfl⟩
    · intro i _
      rfl
  rw [hin, hout, ← sum_sub_distrib]

lemma sum_finiteDivergence {V E R : Type*} [Fintype V] [Fintype E]
    [DecidableEq V] [AddCommGroup R] (src dst : E → V) (flow : E → R) :
    ∑ v, finiteDivergence src dst flow v = 0 := by
  simp only [finiteDivergence, sum_sub_distrib]
  rw [sum_comm, sum_comm (f := fun v e ↦ if src e = v then flow e else 0)]
  simp

/-- Finite satisfiability for a locally finite permutation graph, obtained by
collapsing the complement of the requested vertex set to one boundary vertex
and applying finite integral rounding. -/
theorem exists_local_integral_flow [DecidableEq X] [DecidableEq ι]
    (G : PermutationGraph X ι) (flow : X → ι → ℝ) (rhs : X → ℤ) (b : ℕ)
    (hdiv : ∀ x, G.divergence flow x = rhs x)
    (hbound : ∀ x i, |flow x i| ≤ b) (s : Finset X) :
    ∃ rounded : X → ι → ℤ,
      (∀ x i, |rounded x i| ≤ b) ∧ SatisfiesOn G rhs s rounded := by
  classical
  let E := incidentEdges G s
  let V := s ⊕ Unit
  let src : E → V := fun e ↦ collapseVertex s e.1.1
  let dst : E → V := fun e ↦ collapseVertex s (G.move e.1.2 e.1.1)
  let localFlow : E → ℝ := fun e ↦ flow e.1.1 e.1.2
  let localRhs : V → ℤ
    | Sum.inl x => rhs x
    | Sum.inr _ => -∑ x : s, rhs x
  have hinl (x : s) :
      finiteDivergence src dst localFlow (Sum.inl x) = rhs x := by
    exact (collapsed_divergence_inl G s flow x).trans (hdiv x)
  have hlocalDiv (v : V) : finiteDivergence src dst localFlow v = localRhs v := by
    rcases v with x | u
    · exact hinl x
    · have hsum := sum_finiteDivergence src dst localFlow
      rw [Fintype.sum_sum_type] at hsum
      simp only [Fintype.sum_unique] at hsum
      simp_rw [hinl] at hsum
      simp only [localRhs]
      push_cast
      linarith
  have hlocalBound (e : E) : |localFlow e| ≤ b := hbound e.1.1 e.1.2
  obtain ⟨localRounded, hlocalRounded, hlocalRoundedBound⟩ :=
    finite_integral_rounding_bounded src dst localFlow localRhs b hlocalDiv hlocalBound
  let rounded : X → ι → ℤ := fun x i ↦
    if h : (x, i) ∈ incidentEdges G s then localRounded ⟨(x, i), h⟩ else 0
  refine ⟨rounded, ?_, ?_⟩
  · intro x i
    by_cases h : (x, i) ∈ incidentEdges G s
    · simpa [rounded, h] using hlocalRoundedBound ⟨(x, i), h⟩
    · simp [rounded, h]
  · intro x hx
    let xs : s := ⟨x, hx⟩
    have hrestrict :
        (fun e : E ↦ rounded e.1.1 e.1.2) = localRounded := by
      funext e
      simp [rounded]
    rw [← collapsed_divergence_inl G s rounded xs, hrestrict]
    exact hlocalRounded (Sum.inl xs)

/-- Integral-flow theorem for the locally finite graph of a finite family of
permutations.  The integer flow has the same divergence and the same integral
capacity as the given real flow. -/
theorem exists_integral_flow
    (G : PermutationGraph X ι) (flow : X → ι → ℝ) (rhs : X → ℤ) (b : ℕ)
    (hdiv : ∀ x, G.divergence flow x = rhs x)
    (hbound : ∀ x i, |flow x i| ≤ b) :
    ∃ rounded : X → ι → ℤ,
      (∀ x i, |rounded x i| ≤ b) ∧
      ∀ x, G.divergence rounded x = rhs x := by
  classical
  apply exists_global_of_exists_local G rhs b
  intro s
  exact exists_local_integral_flow G flow rhs b hdiv hbound s

end IntegralFlow

