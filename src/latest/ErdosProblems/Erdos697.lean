/-!
# Erdős Problem 697

For `m : ℕ` and `α : ℝ`, let `divisorSet m α` be the natural numbers
divisible by a `d ≡ 1 (mod m)` with `1 < d < exp (m ^ α)`.  We prove that
this set has a natural density and formalize Hall's sharp transition at
`1 / log 2`.

The hypotheses in the two limit declarations in the upstream
`formal-conjectures` file are reversed.  The corrected directions below
agree with its prose and with Hall's theorem: the limit is zero below the
critical exponent and one above it.
-/

open Filter Set Real
open scoped Topology

namespace Erdos697

noncomputable section

/-! ## Finite unions of sets of multiples -/

/-- The positive multiples of `a`. -/
private def positiveMultiples (a : ℕ) : Set ℕ := {n | 0 < n ∧ a ∣ n}

/-- The positive multiples generated by a finite set. -/
private def finitePositiveMultiples (s : Finset ℕ) : Set ℕ :=
  {n | 0 < n ∧ ∃ a ∈ s, a ∣ n}

@[simp]
private theorem mem_positiveMultiples {a n : ℕ} :
    n ∈ positiveMultiples a ↔ 0 < n ∧ a ∣ n := Iff.rfl

@[simp]
private theorem mem_finitePositiveMultiples {s : Finset ℕ} {n : ℕ} :
    n ∈ finitePositiveMultiples s ↔ 0 < n ∧ ∃ a ∈ s, a ∣ n := Iff.rfl

@[simp]
private theorem finitePositiveMultiples_empty :
    finitePositiveMultiples ∅ = ∅ := by
  ext n
  simp

private theorem finitePositiveMultiples_insert (a : ℕ) (s : Finset ℕ) :
    finitePositiveMultiples (insert a s) =
      positiveMultiples a ∪ finitePositiveMultiples s := by
  ext n
  simp only [mem_finitePositiveMultiples, Finset.mem_insert,
    mem_positiveMultiples, Set.mem_union]
  aesop

private theorem positiveMultiples_inter_finitePositiveMultiples
    (a : ℕ) (s : Finset ℕ) :
    positiveMultiples a ∩ finitePositiveMultiples s =
      finitePositiveMultiples (s.image (Nat.lcm a)) := by
  ext n
  constructor
  · rintro ⟨⟨hn, han⟩, ⟨_, b, hb, hbn⟩⟩
    exact ⟨hn, a.lcm b, Finset.mem_image.mpr ⟨b, hb, rfl⟩,
      Nat.lcm_dvd_iff.mpr ⟨han, hbn⟩⟩
  · rintro ⟨hn, c, hc, hcn⟩
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hc
    exact ⟨⟨hn, (Nat.lcm_dvd_iff.mp hcn).1⟩,
      ⟨hn, b, hb, (Nat.lcm_dvd_iff.mp hcn).2⟩⟩

/-- Inclusion-exclusion transfers natural densities to a union. -/
private theorem hasDensity_union_of_inter {S T : Set ℕ} {dS dT dI : ℝ}
    (hS : S.HasDensity dS) (hT : T.HasDensity dT)
    (hI : (S ∩ T).HasDensity dI) :
    (S ∪ T).HasDensity (dS + dT - dI) := by
  rw [Set.HasDensity] at hS hT hI ⊢
  apply (hS.add hT).sub hI |>.congr'
  filter_upwards with n
  simp only [Set.partialDensity, Set.inter_univ, Set.univ_inter]
  have hcard := Set.ncard_union_add_ncard_inter
    (S ∩ Set.Iio n) (T ∩ Set.Iio n)
  have hunion : (S ∪ T) ∩ Set.Iio n =
      (S ∩ Set.Iio n) ∪ (T ∩ Set.Iio n) := by aesop
  have hinter : (S ∩ T) ∩ Set.Iio n =
      (S ∩ Set.Iio n) ∩ (T ∩ Set.Iio n) := by aesop
  rw [hunion, hinter]
  rw [div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv, div_eq_mul_inv]
  have hcardR :
      ((S ∩ Set.Iio n ∪ T ∩ Set.Iio n).ncard : ℝ) +
          ((S ∩ Set.Iio n ∩ (T ∩ Set.Iio n)).ncard : ℝ) =
        ((S ∩ Set.Iio n).ncard : ℝ) +
          ((T ∩ Set.Iio n).ncard : ℝ) := by
    exact_mod_cast hcard
  linear_combination -hcardR * (((Set.Iio n).ncard : ℝ)⁻¹)

/-- A bounded-error linear count has the expected limiting density. -/
private theorem hasDensity_of_counting_error
    (S : Set ℕ) (c C : ℝ)
    (h : ∀ n, |((S ∩ Set.Iio n).ncard : ℝ) - c * n| ≤ C) :
    S.HasDensity c := by
  rw [Set.HasDensity]
  have hzero : Tendsto
      (fun n : ℕ => (((S ∩ Set.Iio n).ncard : ℝ) - c * n) / n)
      atTop (𝓝 0) := by
    exact squeeze_zero_norm
      (fun n => by
        simpa [abs_div] using
          div_le_div_of_nonneg_right (h n) (Nat.cast_nonneg n))
      (tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop)
  simpa only [zero_add] using (hzero.add_const c).congr' (by
    filter_upwards [Filter.eventually_gt_atTop 0] with n hn
    simp only [Set.partialDensity, Set.inter_univ, Set.univ_inter]
    have hIio : (Set.Iio n).ncard = n := by simp
    rw [hIio]
    field_simp
    ring)

private theorem singleton_zero_hasDensity : ({0} : Set ℕ).HasDensity 0 := by
  apply hasDensity_of_counting_error _ _ 1
  intro n
  simp only [zero_mul, sub_zero, Nat.cast_nonneg, abs_of_nonneg]
  by_cases hn : n = 0
  · subst n
    simp
  · have hnpos : 0 < n := Nat.pos_of_ne_zero hn
    have hset : ({0} : Set ℕ) ∩ Set.Iio n = {0} := by
      ext x
      simp [hnpos]
    rw [hset]
    simp

/-- The positive multiples of a positive integer have density `1 / a`. -/
private theorem positiveMultiples_hasDensity {a : ℕ} (ha : 0 < a) :
    (positiveMultiples a).HasDensity (1 / (a : ℝ)) := by
  apply hasDensity_of_counting_error _ _ 2
  intro n
  rcases n.eq_zero_or_pos with rfl | hn
  · simp [positiveMultiples]
  have hcard :
      (positiveMultiples a ∩ Set.Iio n).ncard = (n - 1) / a := by
    rw [show positiveMultiples a ∩ Set.Iio n =
        ↑((Finset.Ioc 0 (n - 1)).filter (fun m => a ∣ m)) by
      ext m
      simp only [Set.mem_inter_iff, mem_positiveMultiples, Set.mem_Iio,
        Finset.mem_coe, Finset.mem_filter, Finset.mem_Ioc]
      omega]
    simp only [Set.ncard_coe_finset]
    exact Nat.Ioc_filter_dvd_card_eq_div (n - 1) a
  rw [hcard]
  have hdivle : (((n - 1) / a : ℕ) : ℝ) ≤ ((n - 1 : ℕ) : ℝ) / a :=
    Nat.cast_div_le
  have hdivlower : ((n - 1 : ℕ) : ℝ) / a - 1 <
      (((n - 1) / a : ℕ) : ℝ) := by
    have hfloorNat : n - 1 < ((n - 1) / a + 1) * a :=
      (Nat.div_lt_iff_lt_mul ha).mp (by omega)
    have haR : (0 : ℝ) < a := by exact_mod_cast ha
    rw [sub_lt_iff_lt_add, div_lt_iff₀ haR]
    exact_mod_cast hfloorNat
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have haR : (0 : ℝ) < a := by exact_mod_cast ha
  have haOne : (1 : ℝ) ≤ a := by exact_mod_cast ha
  have hainvle : (1 : ℝ) / a ≤ 1 := by
    exact (div_le_one₀ haR).mpr haOne
  have hnsub : ((n - 1 : ℕ) : ℝ) = n - 1 := by
    rw [Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr hn.ne')]
    norm_num
  rw [hnsub] at hdivle hdivlower
  have hnonpos : (((n - 1) / a : ℕ) : ℝ) -
      1 / (a : ℝ) * n ≤ 0 := by
    have hqle : (((n - 1) / a : ℕ) : ℝ) ≤ (n : ℝ) / a :=
      hdivle.trans (div_le_div_of_nonneg_right (by linarith) haR.le)
    simpa [div_eq_mul_inv, one_div, mul_comm] using sub_nonpos.mpr hqle
  rw [abs_of_nonpos hnonpos]
  have hsplit : (n - 1 : ℝ) / a = n / a - 1 / a := by ring
  rw [hsplit] at hdivlower
  have hlower : (n : ℝ) / a - 2 < (((n - 1) / a : ℕ) : ℝ) := by
    linarith
  have hmul : (n : ℝ) / a = 1 / (a : ℝ) * n := by ring
  rw [← hmul]
  linarith

/-- Every finite union of sets of positive multiples has a natural density. -/
private theorem finitePositiveMultiples_hasDensity (s : Finset ℕ)
    (hpos : ∀ a ∈ s, 0 < a) :
    ∃ d : ℝ, (finitePositiveMultiples s).HasDensity d := by
  classical
  induction hcard : s.card using Nat.strong_induction_on generalizing s with
  | h k ih =>
      by_cases hs : s = ∅
      · subst s
        exact ⟨0, by simp [Set.HasDensity, finitePositiveMultiples_empty,
          Set.partialDensity]⟩
      · obtain ⟨a, ha⟩ := s.nonempty_iff_ne_empty.mpr hs
        let t := s.erase a
        have htcard : t.card < k := by
          rw [← hcard]
          exact Finset.card_erase_lt_of_mem ha
        have htpos : ∀ b ∈ t, 0 < b :=
          fun b hb => hpos b (Finset.mem_of_mem_erase hb)
        obtain ⟨dt, hdt⟩ := ih t.card htcard t htpos rfl
        let u := t.image (Nat.lcm a)
        have hucard : u.card < k := Finset.card_image_le.trans_lt htcard
        have hupos : ∀ b ∈ u, 0 < b := by
          intro b hb
          obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hb
          exact Nat.lcm_pos (hpos a ha) (htpos c hc)
        obtain ⟨du, hdu⟩ := ih u.card hucard u hupos rfl
        have haDensity := positiveMultiples_hasDensity (hpos a ha)
        have hinter :
            (positiveMultiples a ∩ finitePositiveMultiples t).HasDensity du := by
          simpa [u, positiveMultiples_inter_finitePositiveMultiples] using hdu
        refine ⟨1 / (a : ℝ) + dt - du, ?_⟩
        rw [show s = insert a t by simp [t, ha]]
        rw [finitePositiveMultiples_insert]
        exact hasDensity_union_of_inter haDensity hdt hinter

private theorem finitePositiveMultiples_density_le_sum (s : Finset ℕ)
    (hpos : ∀ a ∈ s, 0 < a) {d : ℝ}
    (hd : (finitePositiveMultiples s).HasDensity d) :
    d ≤ ∑ a ∈ s, 1 / (a : ℝ) := by
  classical
  induction hcard : s.card using Nat.strong_induction_on generalizing s d with
  | h k ih =>
      by_cases hs : s = ∅
      · subst s
        have hzero : (finitePositiveMultiples (∅ : Finset ℕ)).HasDensity 0 := by
          simp [Set.HasDensity, finitePositiveMultiples_empty, Set.partialDensity]
        have : d = 0 := tendsto_nhds_unique hd hzero
        simp [this]
      · obtain ⟨a, ha⟩ := s.nonempty_iff_ne_empty.mpr hs
        let t := s.erase a
        have htcard : t.card < k := by
          rw [← hcard]
          exact Finset.card_erase_lt_of_mem ha
        have htpos : ∀ b ∈ t, 0 < b :=
          fun b hb => hpos b (Finset.mem_of_mem_erase hb)
        obtain ⟨dt, hdt⟩ := finitePositiveMultiples_hasDensity t htpos
        let u := t.image (Nat.lcm a)
        have hupos : ∀ b ∈ u, 0 < b := by
          intro b hb
          obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hb
          exact Nat.lcm_pos (hpos a ha) (htpos c hc)
        obtain ⟨du, hdu⟩ := finitePositiveMultiples_hasDensity u hupos
        have haDensity := positiveMultiples_hasDensity (hpos a ha)
        have hinter :
            (positiveMultiples a ∩ finitePositiveMultiples t).HasDensity du := by
          simpa [u, positiveMultiples_inter_finitePositiveMultiples] using hdu
        have hunion :
            (positiveMultiples a ∪ finitePositiveMultiples t).HasDensity
              (1 / (a : ℝ) + dt - du) :=
          hasDensity_union_of_inter haDensity hdt hinter
        have hset : s = insert a t := by simp [t, ha]
        have hdeq : d = 1 / (a : ℝ) + dt - du := by
          apply tendsto_nhds_unique hd
          rw [hset, finitePositiveMultiples_insert]
          exact hunion
        have hdtle : dt ≤ ∑ b ∈ t, 1 / (b : ℝ) :=
          ih t.card htcard t htpos hdt rfl
        have hdunonneg : 0 ≤ du := by
          apply ge_of_tendsto' hdu
          intro n
          positivity
        rw [hset, Finset.sum_insert (Finset.notMem_erase a s)]
        rw [hdeq]
        linarith

/-- All (including zero) multiples generated by a finite set. -/
private def finiteMultiples (s : Finset ℕ) : Set ℕ :=
  {n | ∃ a ∈ s, a ∣ n}

private theorem finiteMultiples_hasDensity_of_positiveDensity (s : Finset ℕ)
    (hs : s.Nonempty) {d : ℝ}
    (hd : (finitePositiveMultiples s).HasDensity d) :
    (finiteMultiples s).HasDensity d := by
  have hinter : (({0} : Set ℕ) ∩ finitePositiveMultiples s).HasDensity 0 := by
    have : ({0} : Set ℕ) ∩ finitePositiveMultiples s = ∅ := by
      ext n
      simp [finitePositiveMultiples]
    rw [this]
    simp [Set.HasDensity, Set.partialDensity]
  have hunion := hasDensity_union_of_inter singleton_zero_hasDensity hd hinter
  have hset : finiteMultiples s = ({0} : Set ℕ) ∪ finitePositiveMultiples s := by
    ext n
    simp only [finiteMultiples, Set.mem_ofPred_eq, Set.mem_union, Set.mem_singleton_iff,
      mem_finitePositiveMultiples]
    constructor
    · rintro ⟨a, ha, hadvd⟩
      rcases n.eq_zero_or_pos with rfl | hn
      · exact Or.inl rfl
      · exact Or.inr ⟨hn, a, ha, hadvd⟩
    · rintro (rfl | ⟨hn, a, ha, hadvd⟩)
      · obtain ⟨a, ha⟩ := hs
        exact ⟨a, ha, dvd_zero a⟩
      · exact ⟨a, ha, hadvd⟩
  rw [hset]
  simpa using hunion

private theorem finiteMultiples_hasDensity (s : Finset ℕ)
    (hpos : ∀ a ∈ s, 0 < a) :
    ∃ d : ℝ, (finiteMultiples s).HasDensity d := by
  classical
  by_cases hs : s = ∅
  · subst s
    exact ⟨0, by simp [finiteMultiples, Set.HasDensity, Set.partialDensity]⟩
  obtain ⟨d, hd⟩ := finitePositiveMultiples_hasDensity s hpos
  exact ⟨d, finiteMultiples_hasDensity_of_positiveDensity s
    (s.nonempty_iff_ne_empty.mpr hs) hd⟩

/-! ## The divisor set in Problem 697 -/

/-- The finite set of eligible divisors. -/
def eligibleDivisors (m : ℕ) (α : ℝ) : Finset ℕ :=
  (Finset.range (Nat.ceil (Real.exp (m ^ α)))).filter fun d =>
    d ≡ 1 [MOD m] ∧ (d : ℝ) ∈ Set.Ioo 1 (Real.exp (m ^ α))

/-- The set whose density is denoted by `δ(m, α)`. -/
def divisorSet (m : ℕ) (α : ℝ) : Set ℕ :=
  {n : ℕ | ∃ d, d ≡ 1 [MOD m] ∧
    (d : ℝ) ∈ Set.Ioo 1 (Real.exp (m ^ α)) ∧ d ∣ n}

theorem divisorSet_eq_finiteMultiples (m : ℕ) (α : ℝ) :
    divisorSet m α = finiteMultiples (eligibleDivisors m α) := by
  ext n
  constructor
  · rintro ⟨d, hdmod, hdIoo, hdn⟩
    refine ⟨d, ?_, hdn⟩
    simp only [eligibleDivisors, Finset.mem_filter, Finset.mem_range]
    exact ⟨Nat.lt_ceil.mpr hdIoo.2, hdmod, hdIoo⟩
  · rintro ⟨d, hd, hdn⟩
    simp only [eligibleDivisors, Finset.mem_filter, Finset.mem_range] at hd
    exact ⟨d, hd.2.1, hd.2.2, hdn⟩

/-- The density in the definition of Problem 697 exists. -/
theorem density_exists (m : ℕ) (α : ℝ) :
    ∃ d, (divisorSet m α).HasDensity d := by
  rw [divisorSet_eq_finiteMultiples]
  apply finiteMultiples_hasDensity
  intro d hd
  have hd' := (Finset.mem_filter.mp hd).2.2.1
  exact_mod_cast (show (0 : ℝ) < d by linarith)

/-- The uniquely determined density of `divisorSet m α`. -/
noncomputable def δ (m : ℕ) (α : ℝ) : ℝ :=
  atTop.limUnder fun n : ℕ => (divisorSet m α).partialDensity Set.univ n

theorem divisorSet_hasDensity (m : ℕ) (α : ℝ) :
    (divisorSet m α).HasDensity (δ m α) :=
  tendsto_nhds_limUnder (density_exists m α)

theorem delta_nonneg (m : ℕ) (α : ℝ) : 0 ≤ δ m α := by
  apply ge_of_tendsto' (divisorSet_hasDensity m α)
  intro n
  positivity

theorem delta_le_one (m : ℕ) (α : ℝ) : δ m α ≤ 1 := by
  apply le_of_tendsto' (divisorSet_hasDensity m α)
  exact Set.partialDensity_le_one (divisorSet m α) Set.univ

theorem delta_le_sum_reciprocals (m : ℕ) (α : ℝ) :
    δ m α ≤ ∑ d ∈ eligibleDivisors m α, 1 / (d : ℝ) := by
  let s := eligibleDivisors m α
  have hpos : ∀ d ∈ s, 0 < d := by
    intro d hd
    have hd' := (Finset.mem_filter.mp hd).2.2.1
    exact_mod_cast (show (0 : ℝ) < d by linarith)
  obtain ⟨d, hd⟩ := finitePositiveMultiples_hasDensity s hpos
  by_cases hs : s = ∅
  · have hs' : eligibleDivisors m α = ∅ := by simpa [s] using hs
    have hδzero : δ m α = 0 := by
      apply tendsto_nhds_unique (divisorSet_hasDensity m α)
      rw [divisorSet_eq_finiteMultiples, hs']
      simp [finiteMultiples, Set.partialDensity]
    simp [hs', hδzero]
  have hall : (finiteMultiples s).HasDensity d :=
    finiteMultiples_hasDensity_of_positiveDensity s
      (s.nonempty_iff_ne_empty.mpr hs) hd
  have hactual : (divisorSet m α).HasDensity d := by
    rw [divisorSet_eq_finiteMultiples]
    exact hall
  have hdeq : d = δ m α := tendsto_nhds_unique hactual (divisorSet_hasDensity m α)
  rw [← hdeq]
  exact finitePositiveMultiples_density_le_sum s hpos hd

private theorem hasDensity_le_of_subset {S T : Set ℕ} {s t : ℝ}
    (hS : S.HasDensity s) (hT : T.HasDensity t) (hST : S ⊆ T) :
    s ≤ t := by
  apply le_of_tendsto_of_tendsto' hS hT
  intro n
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  have hsubset : (S ∩ Set.univ) ∩ Set.Iio n ⊆
      (T ∩ Set.univ) ∩ Set.Iio n := by
    rintro x ⟨⟨hxS, hxU⟩, hxn⟩
    exact ⟨⟨hST hxS, hxU⟩, hxn⟩
  exact_mod_cast Set.ncard_le_ncard hsubset

theorem divisorSet_mono_exponent {m : ℕ} (hm : 1 ≤ m) :
    Monotone (divisorSet m) := by
  intro α γ hαγ n
  rintro ⟨d, hmod, hd, hdn⟩
  refine ⟨d, hmod, ⟨hd.1, hd.2.trans_le ?_⟩, hdn⟩
  apply Real.exp_le_exp.mpr
  exact Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hm) hαγ

theorem delta_mono_exponent {m : ℕ} (hm : 1 ≤ m) :
    Monotone (δ m) := by
  intro α γ hαγ
  exact hasDensity_le_of_subset (divisorSet_hasDensity m α)
    (divisorSet_hasDensity m γ) (divisorSet_mono_exponent hm hαγ)

/-! ## Exact integer cutoff -/

/-- The largest natural number strictly smaller than `exp (m ^ α)`. -/
def cutoff (m : ℕ) (α : ℝ) : ℕ :=
  Nat.ceil (Real.exp (m ^ α)) - 1

theorem le_cutoff_iff {m d : ℕ} {α : ℝ} :
    d ≤ cutoff m α ↔ (d : ℝ) < Real.exp (m ^ α) := by
  rw [cutoff, Nat.le_sub_one_iff_lt (Nat.ceil_pos.mpr (Real.exp_pos _)), Nat.lt_ceil]

/-- A nontrivial integer congruent to `1` modulo a positive `m` is at
least `m + 1`. -/
theorem add_one_le_of_modEq_one {m d : ℕ}
    (hd : 1 < d) (hmod : d ≡ 1 [MOD m]) :
    m + 1 ≤ d := by
  have h1d : 1 ≤ d := hd.le
  obtain ⟨t, ht⟩ := (Nat.modEq_iff_exists_eq_add h1d).mp hmod.symm
  have htpos : 0 < t := by
    by_contra ht0
    have : t = 0 := Nat.eq_zero_of_not_pos ht0
    subst t
    simp at ht
    omega
  have hmul : m ≤ m * t := by
    simpa using Nat.mul_le_mul_left m htpos
  omega

/-- For positive moduli, the strict real cutoff in Problem 697 is exactly
the closed integer interval used in Hall's theorem. -/
theorem eligibleDivisors_eq_filter_Icc {m : ℕ} (hm : 1 < m) (α : ℝ) :
    eligibleDivisors m α =
      (Finset.Icc m (cutoff m α)).filter (fun d => d ≡ 1 [MOD m]) := by
  ext d
  simp only [eligibleDivisors, Finset.mem_filter, Finset.mem_range,
    Finset.mem_Icc, le_cutoff_iff, Set.mem_Ioo]
  constructor
  · rintro ⟨_, hmod, hd1, hdup⟩
    have hd1n : 1 < d := by exact_mod_cast hd1
    have hmd := add_one_le_of_modEq_one hd1n hmod
    exact ⟨⟨by omega, hdup⟩, hmod⟩
  · rintro ⟨⟨hmd, hdup⟩, hmod⟩
    have hd1n : 1 < d := by omega
    have hd1 : (1 : ℝ) < d := by exact_mod_cast hd1n
    exact ⟨Nat.lt_ceil.mpr hdup, hmod, hd1, hdup⟩

/-- The elementary harmonic-series estimate behind the easy range
`α < 1`. -/
theorem sum_reciprocals_eligible_le {m : ℕ} (hm : 0 < m) (α : ℝ) :
    (∑ d ∈ eligibleDivisors m α, 1 / (d : ℝ)) ≤
      (1 / (m : ℝ)) * (harmonic (cutoff m α) : ℝ) := by
  classical
  let I := Finset.Icc 1 (cutoff m α)
  let f : ℕ → ℕ := fun t => 1 + m * t
  have hsubset : eligibleDivisors m α ⊆ I.image f := by
    intro d hd
    have hddata := Finset.mem_filter.mp hd
    have hmod := hddata.2.1
    have hd1r := hddata.2.2.1
    have hdupr := hddata.2.2.2
    have hd1 : 1 < d := by exact_mod_cast hd1r
    obtain ⟨t, ht⟩ := (Nat.modEq_iff_exists_eq_add hd1.le).mp hmod.symm
    have htpos : 0 < t := by
      by_contra ht0
      have : t = 0 := Nat.eq_zero_of_not_pos ht0
      subst t
      simp at ht
      omega
    have ht_le_mul : t ≤ m * t := by
      simpa [mul_comm] using Nat.mul_le_mul_left t hm
    have htd : t ≤ d := by omega
    have hdc : d ≤ cutoff m α := le_cutoff_iff.mpr hdupr
    exact Finset.mem_image.mpr ⟨t, Finset.mem_Icc.mpr ⟨htpos, htd.trans hdc⟩, ht.symm⟩
  have hinj : Set.InjOn f ↑I := by
    intro a _ b _ hab
    have hmul : m * a = m * b := by
      dsimp [f] at hab
      omega
    exact Nat.mul_left_cancel hm hmul
  calc
    (∑ d ∈ eligibleDivisors m α, 1 / (d : ℝ))
        ≤ ∑ d ∈ I.image f, 1 / (d : ℝ) := by
          apply Finset.sum_le_sum_of_subset_of_nonneg hsubset
          intro d _ _
          positivity
    _ = ∑ t ∈ I, 1 / ((f t : ℕ) : ℝ) := by
          exact Finset.sum_image hinj
    _ ≤ ∑ t ∈ I, (1 / (m : ℝ)) * (1 / (t : ℝ)) := by
          apply Finset.sum_le_sum
          intro t ht
          have htpos : 0 < t := (Finset.mem_Icc.mp ht).1
          have hmtpos : (0 : ℝ) < m * t := by exact_mod_cast Nat.mul_pos hm htpos
          have hden : (m : ℝ) * t ≤ (f t : ℕ) := by
            dsimp [f]
            norm_num
          calc
            1 / ((f t : ℕ) : ℝ) ≤ 1 / ((m : ℝ) * t) :=
              one_div_le_one_div_of_le hmtpos hden
            _ = (1 / (m : ℝ)) * (1 / (t : ℝ)) := by ring
    _ = (1 / (m : ℝ)) * (harmonic (cutoff m α) : ℝ) := by
          rw [← Finset.mul_sum]
          congr 1
          have hh := harmonic_eq_sum_Icc (n := cutoff m α)
          simpa [I, one_div] using
            congrArg (fun q : ℚ => (q : ℝ)) hh.symm

/-- The standard elementary estimate from the problem statement.  The
non-strict form is what is needed for convergence. -/
theorem delta_le_trivial {m : ℕ} (hm : 0 < m) (α : ℝ) :
    δ m α ≤ ((m : ℝ) ^ α + 1) / m := by
  have hsum := (delta_le_sum_reciprocals m α).trans
    (sum_reciprocals_eligible_le hm α)
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hlog : Real.log (cutoff m α : ℝ) ≤ (m : ℝ) ^ α := by
    by_cases hc : cutoff m α = 0
    · simp only [hc, Nat.cast_zero, Real.log_zero]
      exact (Real.rpow_pos_of_pos hmR α).le
    · have hcpos : 0 < cutoff m α := Nat.pos_of_ne_zero hc
      exact (Real.log_lt_iff_lt_exp (by exact_mod_cast hcpos)).mpr
        (le_cutoff_iff.mp le_rfl) |>.le
  calc
    δ m α ≤ (1 / (m : ℝ)) * (harmonic (cutoff m α) : ℝ) := hsum
    _ ≤ (1 / (m : ℝ)) * (1 + Real.log (cutoff m α : ℝ)) := by
      exact mul_le_mul_of_nonneg_left (harmonic_le_one_add_log _)
        (one_div_nonneg.mpr hmR.le)
    _ ≤ (1 / (m : ℝ)) * (1 + (m : ℝ) ^ α) := by
      gcongr
    _ = ((m : ℝ) ^ α + 1) / m := by ring

/-- A density is unique. -/
theorem divisorSet_density_unique {m : ℕ} {α d : ℝ}
    (h : (divisorSet m α).HasDensity d) :
    d = δ m α :=
  tendsto_nhds_unique h (divisorSet_hasDensity m α)

/-! ## Critical exponent -/

def criticalExponent : ℝ := 1 / Real.log 2

theorem one_lt_criticalExponent : 1 < criticalExponent := by
  have hlogpos : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have hloglt : Real.log (2 : ℝ) < 1 := by
    nlinarith [Real.log_lt_sub_one_of_pos (by norm_num : (0 : ℝ) < 2) (by norm_num)]
  exact one_lt_one_div hlogpos hloglt

/-! ## Asymptotics of the strict integer cutoff -/

/-- Subtracting one after taking the ceiling does not change the first-order
asymptotics of the exponential cutoff. -/
theorem tendsto_cutoff_div_exp {α : ℝ} (hα : 0 < α) :
    Tendsto
      (fun m : ℕ => (cutoff m α : ℝ) / Real.exp ((m : ℝ) ^ α))
      atTop (𝓝 1) := by
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ α) atTop atTop :=
    (tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop
  have hexp : Tendsto (fun m : ℕ => Real.exp ((m : ℝ) ^ α)) atTop atTop :=
    Real.tendsto_exp_atTop.comp hpow
  have hceil : Tendsto
      (fun m : ℕ =>
        ((Nat.ceil (Real.exp ((m : ℝ) ^ α)) : ℕ) : ℝ) /
          Real.exp ((m : ℝ) ^ α)) atTop (𝓝 1) :=
    tendsto_nat_ceil_div_atTop.comp hexp
  have hinv : Tendsto
      (fun m : ℕ => 1 / Real.exp ((m : ℝ) ^ α)) atTop (𝓝 0) := by
    simpa only [one_div, Function.comp_def] using tendsto_inv_atTop_zero.comp hexp
  have hsub := hceil.sub hinv
  convert hsub using 1
  · funext m
    have hceilpos : 0 < Nat.ceil (Real.exp ((m : ℝ) ^ α)) :=
      Nat.ceil_pos.mpr (Real.exp_pos _)
    rw [cutoff, Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr hceilpos.ne')]
    ring
  · norm_num

/-- The logarithm of the strict cutoff is asymptotic to `m ^ α`. -/
theorem log_cutoff_isEquivalent_rpow {α : ℝ} (hα : 0 < α) :
    Asymptotics.IsEquivalent atTop
      (fun m : ℕ => Real.log (cutoff m α : ℝ))
      (fun m : ℕ => (m : ℝ) ^ α) := by
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ α) atTop atTop :=
    (tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop
  have hexp : Tendsto (fun m : ℕ => Real.exp ((m : ℝ) ^ α)) atTop atTop :=
    Real.tendsto_exp_atTop.comp hpow
  have hcut :
      Asymptotics.IsEquivalent atTop
        (fun m : ℕ => (cutoff m α : ℝ))
        (fun m : ℕ => Real.exp ((m : ℝ) ^ α)) :=
    Asymptotics.isEquivalent_of_tendsto_one (tendsto_cutoff_div_exp hα)
  have heq :
      (fun m : ℕ => Real.log (Real.exp ((m : ℝ) ^ α))) =ᶠ[atTop]
        (fun m : ℕ => (m : ℝ) ^ α) :=
    Filter.Eventually.of_forall fun _ => Real.log_exp _
  exact (hcut.log hexp).trans heq.isEquivalent

/-- Taking a second logarithm identifies the coefficient that drives Hall's
transition: `log log cutoff(m, α) ~ α log m`. -/
theorem log_log_cutoff_isEquivalent {α : ℝ} (hα : 0 < α) :
    Asymptotics.IsEquivalent atTop
      (fun m : ℕ => Real.log (Real.log (cutoff m α : ℝ)))
      (fun m : ℕ => α * Real.log (m : ℝ)) := by
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ α) atTop atTop :=
    (tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop
  have h := (log_cutoff_isEquivalent_rpow hα).log hpow
  have heq :
      (fun m : ℕ => Real.log ((m : ℝ) ^ α)) =ᶠ[atTop]
        (fun m : ℕ => α * Real.log (m : ℝ)) := by
    filter_upwards [eventually_gt_atTop 0] with m hm
    exact Real.log_rpow (by exact_mod_cast hm) α
  exact h.trans heq.isEquivalent

/-- A quotient form of the preceding asymptotic equivalence. -/
theorem tendsto_log_log_cutoff_div_log {α : ℝ} (hα : 0 < α) :
    Tendsto
      (fun m : ℕ =>
        Real.log (Real.log (cutoff m α : ℝ)) / Real.log (m : ℝ))
      atTop (𝓝 α) := by
  have hgne : ∀ᶠ m : ℕ in atTop,
      α * Real.log (m : ℝ) ≠ 0 := by
    filter_upwards [eventually_gt_atTop 1] with m hm
    exact mul_ne_zero hα.ne'
      (Real.log_pos (by exact_mod_cast hm)).ne'
  have hratio : Tendsto
      (fun m : ℕ =>
        Real.log (Real.log (cutoff m α : ℝ)) /
          (α * Real.log (m : ℝ))) atTop (𝓝 1) :=
    (Asymptotics.isEquivalent_iff_tendsto_one hgne).mp
      (log_log_cutoff_isEquivalent hα)
  have hmul : Tendsto
      (fun m : ℕ => α *
        (Real.log (Real.log (cutoff m α : ℝ)) /
          (α * Real.log (m : ℝ)))) atTop (𝓝 (α * 1)) :=
    (tendsto_const_nhds (x := α)).mul hratio
  simpa only [mul_one] using hmul.congr' (by
    filter_upwards [eventually_gt_atTop 1] with m hm
    have hlog : Real.log (m : ℝ) ≠ 0 :=
      (Real.log_pos (by exact_mod_cast hm)).ne'
    field_simp)

/-- The reciprocal-prime harmonic sum up to the exponential cutoff has
the expected first-order size `α log m`. -/
theorem tendsto_primeHarmonic_cutoff_div_log {α : ℝ} (hα : 0 < α) :
    Tendsto
      (fun m : ℕ => PrimeHarmonic.sum (cutoff m α) /
        Real.log (m : ℝ))
      atTop (𝓝 α) := by
  obtain ⟨C, hC, hMertens⟩ :=
    PrimeHarmonic.exists_uniform_abs_sum_sub_log_log
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ α) atTop atTop :=
    (tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop
  have hcut : Tendsto (fun m : ℕ => (cutoff m α : ℝ)) atTop atTop := by
    have hexp := Real.tendsto_exp_atTop.comp hpow
    exact (Asymptotics.isEquivalent_of_tendsto_one
      (tendsto_cutoff_div_exp hα)).symm.tendsto_atTop hexp
  have htwo : ∀ᶠ m : ℕ in atTop, 2 ≤ cutoff m α := by
    filter_upwards [hcut.eventually_ge_atTop (2 : ℝ)] with m hm
    exact_mod_cast hm
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  let e : ℕ → ℝ := fun m =>
    PrimeHarmonic.sum (cutoff m α) -
      Real.log (Real.log (cutoff m α : ℝ))
  have he : ∀ᶠ m : ℕ in atTop, |e m| ≤ C := by
    filter_upwards [htwo] with m hm
    exact hMertens _ hm
  have hezero : Tendsto
      (fun m : ℕ => e m / Real.log (m : ℝ)) atTop (𝓝 0) := by
    apply squeeze_zero_norm'
    · filter_upwards [he, hlog.eventually_gt_atTop 0] with m hem hlm
      simpa [abs_div, abs_of_pos hlm] using
        div_le_div_of_nonneg_right hem hlm.le
    · simpa only [zero_div] using tendsto_const_nhds.div_atTop hlog
  have hmain := (tendsto_log_log_cutoff_div_log hα).add hezero
  convert hmain using 1
  · funext m
    dsimp [e]
    ring
  · ring

/-- At the polynomial cutoff `m^3`, the reciprocal-prime mass is
asymptotic to `log log m`. -/
theorem tendsto_primeHarmonic_cube_div_loglog :
    Tendsto
      (fun m : ℕ => PrimeHarmonic.sum (m ^ 3) /
        Real.log (Real.log (m : ℝ)))
      atTop (𝓝 1) := by
  obtain ⟨C, hC, hMertens⟩ :=
    PrimeHarmonic.exists_uniform_abs_sum_sub_log_log
  let LL : ℕ → ℝ := fun m => Real.log (Real.log (m : ℝ))
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hLL : Tendsto LL atTop atTop := by
    simpa [LL, Function.comp_def] using Real.tendsto_log_atTop.comp hlog
  let e : ℕ → ℝ := fun m => PrimeHarmonic.sum (m ^ 3) -
    Real.log (Real.log ((m ^ 3 : ℕ) : ℝ))
  have he : ∀ᶠ m : ℕ in atTop, |e m| ≤ C := by
    filter_upwards [eventually_ge_atTop 2] with m hm
    exact hMertens _ (hm.trans (Nat.le_pow (by norm_num : 0 < 3)))
  have hezero : Tendsto (fun m : ℕ => e m / LL m) atTop (𝓝 0) := by
    apply squeeze_zero_norm'
    · filter_upwards [he, hLL.eventually_gt_atTop 0] with m hem hden
      simpa [abs_div, abs_of_pos hden] using
        div_le_div_of_nonneg_right hem hden.le
    · simpa only [zero_div] using tendsto_const_nhds.div_atTop hLL
  have hmain : Tendsto
      (fun m : ℕ => Real.log (Real.log ((m ^ 3 : ℕ) : ℝ)) / LL m)
      atTop (𝓝 1) := by
    have hsmall : Tendsto (fun m : ℕ => Real.log 3 / LL m)
        atTop (𝓝 0) := tendsto_const_nhds.div_atTop hLL
    have hraw := hsmall.add (tendsto_const_nhds (x := (1 : ℝ)))
    have heq : (fun m : ℕ => Real.log 3 / LL m + 1) =ᶠ[atTop]
        (fun m : ℕ => Real.log (Real.log ((m ^ 3 : ℕ) : ℝ)) / LL m) := by
      filter_upwards [eventually_gt_atTop 1, hLL.eventually_gt_atTop 0]
        with m hm hLLpos
      have hlogpos : 0 < Real.log (m : ℝ) :=
        Real.log_pos (by exact_mod_cast hm)
      have hLLne : LL m ≠ 0 := hLLpos.ne'
      dsimp [LL] at hLLne
      dsimp [LL]
      rw [Nat.cast_pow, Real.log_pow]
      norm_num
      rw [Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) hlogpos.ne']
      field_simp [hLLne]
    simpa only [zero_add] using hraw.congr' heq
  have hadd := hmain.add hezero
  convert hadd using 1
  · funext m
    dsimp [e, LL]
    ring
  · norm_num

/-- Primes only up to `floor (log m / 100)` contribute negligibly on the
`log log m` scale. -/
theorem tendsto_primeHarmonic_floorLog_div_loglog :
    Tendsto
      (fun m : ℕ => PrimeHarmonic.sum
          (Nat.floor (Real.log (m : ℝ) / 100)) /
        Real.log (Real.log (m : ℝ)))
      atTop (𝓝 0) := by
  obtain ⟨C, hC, hMertens⟩ :=
    PrimeHarmonic.exists_uniform_abs_sum_sub_log_log
  let LL : ℕ → ℝ := fun m => Real.log (Real.log (m : ℝ))
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hLL : Tendsto LL atTop atTop := by
    simpa [LL, Function.comp_def] using Real.tendsto_log_atTop.comp hlog
  have hupper : Tendsto (fun m : ℕ =>
      (Real.log (LL m) + C) / LL m) atTop (𝓝 0) := by
    have hratio := Real.isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp hLL
    have hconst : Tendsto (fun m : ℕ => C / LL m) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop hLL
    simpa [add_div] using hratio.add hconst
  apply squeeze_zero'
  · filter_upwards [hLL.eventually_gt_atTop 0] with m hden
    exact div_nonneg (by unfold PrimeHarmonic.sum; positivity) hden.le
  · filter_upwards [hlog.eventually_ge_atTop 300,
      hLL.eventually_gt_atTop 1] with m hlogm hLLm
    let R := Nat.floor (Real.log (m : ℝ) / 100)
    have hR2 : 2 ≤ R := by
      apply Nat.le_floor
      dsimp [R]
      linarith
    have hRpos : (0 : ℝ) < R := by exact_mod_cast (lt_of_lt_of_le (by omega : 0 < 2) hR2)
    have hRle : (R : ℝ) ≤ Real.log (m : ℝ) := by
      calc
        (R : ℝ) ≤ Real.log (m : ℝ) / 100 := Nat.floor_le (by positivity)
        _ ≤ Real.log (m : ℝ) := by linarith
    have hlogRle : Real.log (R : ℝ) ≤ LL m := by
      exact Real.log_le_log hRpos hRle
    have hlogRpos : 0 < Real.log (R : ℝ) :=
      Real.log_pos (by exact_mod_cast hR2)
    have hloglogRle : Real.log (Real.log (R : ℝ)) ≤ Real.log (LL m) :=
      Real.log_le_log hlogRpos hlogRle
    have hM := hMertens R hR2
    have hsumle : PrimeHarmonic.sum R ≤ Real.log (LL m) + C := by
      have := (sub_le_iff_le_add.mp (le_trans (le_abs_self _) hM))
      linarith
    exact div_le_div_of_nonneg_right hsumle (by dsimp [LL] at hLLm ⊢; linarith)
  · exact hupper

/-- A purely elementary consequence of Euler's product for `φ`: for every
positive exponent, `m / φ(m)` is eventually bounded by a constant times
`m^η`.  Only the finite split estimate from Problem 694 is used. -/
theorem exists_eventually_totient_ratio_le_rpow {η : ℝ} (hη : 0 < η) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ m : ℕ in atTop,
      (m : ℝ) / Nat.totient m ≤ C * (m : ℝ) ^ η := by
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hone : Tendsto (fun n : ℕ => (1 : ℝ) / n) atTop (𝓝 0) :=
    tendsto_one_div_atTop_nhds_zero_nat
  have hev : ∀ᶠ n : ℕ in atTop, (1 : ℝ) / n < η * Real.log 2 :=
    hone.eventually (Iio_mem_nhds (mul_pos hη hlogtwo))
  obtain ⟨Y, hYsmall, hY1⟩ :=
    (hev.and (eventually_ge_atTop 1)).exists
  let C := Erdos694.primeEulerProdNat Y
  have hC : 0 ≤ C := by
    dsimp [C, Erdos694.primeEulerProdNat]
    apply Finset.prod_nonneg
    intro p hp
    exact zero_le_one.trans
      (Erdos694.one_le_prime_factor p (Finset.mem_filter.mp hp).2)
  refine ⟨C, hC, ?_⟩
  filter_upwards [eventually_ge_atTop 1] with m hm
  have hm0 : m ≠ 0 := by omega
  have hbasepos : (0 : ℝ) < ((Y + 1 : ℕ) : ℝ) / Y := by positivity
  have hdenpos : 0 < Real.log ((Y + 1 : ℕ) : ℝ) := by
    apply Real.log_pos
    exact_mod_cast (show 1 < Y + 1 by omega)
  have hlogbase :
      Real.log (((Y + 1 : ℕ) : ℝ) / Y) ≤ 1 / (Y : ℝ) := by
    have h := Real.log_le_sub_one_of_pos hbasepos
    convert h using 1 <;> push_cast <;> field_simp <;> ring
  have hcoef :
      Real.log (((Y + 1 : ℕ) : ℝ) / Y) /
          Real.log ((Y + 1 : ℕ) : ℝ) < η := by
    have hdenlower : Real.log 2 ≤ Real.log ((Y + 1 : ℕ) : ℝ) := by
      apply Real.strictMonoOn_log.monotoneOn
      · norm_num
      · show (0 : ℝ) < (Y + 1 : ℕ)
        positivity
      · exact_mod_cast (show 2 ≤ Y + 1 by omega)
    have hlognonneg :
        0 ≤ Real.log (((Y + 1 : ℕ) : ℝ) / Y) := by
      apply Real.log_nonneg
      have hYR : (0 : ℝ) < Y := by exact_mod_cast hY1
      rw [one_le_div hYR]
      norm_num
    calc
      _ ≤ (1 / (Y : ℝ)) / Real.log ((Y + 1 : ℕ) : ℝ) :=
        div_le_div_of_nonneg_right hlogbase hdenpos.le
      _ ≤ (1 / (Y : ℝ)) / Real.log 2 := by
        exact div_le_div_of_nonneg_left (by positivity) hlogtwo hdenlower
      _ < η := by
        rw [div_lt_iff₀ hlogtwo]
        exact hYsmall
  have hrpow :
      ((((Y + 1 : ℕ) : ℝ) / Y) ^
          (Real.log m / Real.log (Y + 1))) ≤ (m : ℝ) ^ η := by
    rw [Real.rpow_def_of_pos hbasepos, Real.rpow_def_of_pos (by exact_mod_cast hm)]
    apply Real.exp_le_exp.mpr
    have hlogm : 0 ≤ Real.log (m : ℝ) := Real.log_nonneg (by exact_mod_cast hm)
    have hcoef' :
        Real.log (((Y + 1 : ℕ) : ℝ) / Y) /
            Real.log ((Y : ℝ) + 1) ≤ η := by
      simpa using hcoef.le
    calc
      Real.log (((Y + 1 : ℕ) : ℝ) / Y) *
          (Real.log (m : ℝ) / Real.log ((Y : ℝ) + 1)) =
          (Real.log (((Y + 1 : ℕ) : ℝ) / Y) /
            Real.log ((Y : ℝ) + 1)) * Real.log (m : ℝ) := by ring
      _ ≤ η * Real.log (m : ℝ) :=
        mul_le_mul_of_nonneg_right hcoef' hlogm
      _ = Real.log (m : ℝ) * η := by ring
  exact (Erdos694.ratio_totient_le_log_split_bound m Y hm0 hY1).trans
    (mul_le_mul_of_nonneg_left hrpow hC)

/-! ## Reciprocal-prime mass in exponential windows -/

/-- Mertens' theorem gives the exact logarithmic mass of the prime window
used in Hall's argument. -/
theorem tendsto_reciprocalMass_cutoff_div_log
    {lam θ : ℝ} (hlam : 0 < lam) (hlamθ : lam < θ) :
    Tendsto
      (fun m : ℕ =>
        PrimeWindow.reciprocalMass (cutoff m lam) (cutoff m θ) /
          Real.log (m : ℝ))
      atTop (𝓝 (θ - lam)) := by
  have hθ : 0 < θ := hlam.trans hlamθ
  have hpowlam : Tendsto (fun m : ℕ => (m : ℝ) ^ lam) atTop atTop :=
    (tendsto_rpow_atTop hlam).comp tendsto_natCast_atTop_atTop
  have hpowθ : Tendsto (fun m : ℕ => (m : ℝ) ^ θ) atTop atTop :=
    (tendsto_rpow_atTop hθ).comp tendsto_natCast_atTop_atTop
  have hcutlam : Tendsto (fun m : ℕ => (cutoff m lam : ℝ)) atTop atTop := by
    have hexp := Real.tendsto_exp_atTop.comp hpowlam
    exact (Asymptotics.isEquivalent_of_tendsto_one
      (tendsto_cutoff_div_exp hlam)).symm.tendsto_atTop hexp
  have hcutθ : Tendsto (fun m : ℕ => (cutoff m θ : ℝ)) atTop atTop := by
    have hexp := Real.tendsto_exp_atTop.comp hpowθ
    exact (Asymptotics.isEquivalent_of_tendsto_one
      (tendsto_cutoff_div_exp hθ)).symm.tendsto_atTop hexp
  have hLtwo : ∀ᶠ m : ℕ in atTop, 2 ≤ cutoff m lam := by
    filter_upwards [hcutlam.eventually_ge_atTop (2 : ℝ)] with m hm
    exact_mod_cast hm
  have hUtwo : ∀ᶠ m : ℕ in atTop, 2 ≤ cutoff m θ := by
    filter_upwards [hcutθ.eventually_ge_atTop (2 : ℝ)] with m hm
    exact_mod_cast hm
  have hLUall (m : ℕ) : cutoff m lam ≤ cutoff m θ := by
    rcases m.eq_zero_or_pos with rfl | hm
    · simp [cutoff, Real.zero_rpow hlam.ne', Real.zero_rpow hθ.ne']
    · apply le_cutoff_iff.mpr
      exact (le_cutoff_iff.mp (le_refl (cutoff m lam))).trans_le
        (Real.exp_le_exp.mpr
          (Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hm) hlamθ.le))
  have hLU : ∀ᶠ m : ℕ in atTop, cutoff m lam ≤ cutoff m θ := by
    exact Eventually.of_forall hLUall
  obtain ⟨C, hC, hMertens⟩ :=
    PrimeHarmonic.exists_uniform_abs_sum_sub_log_log
  let err : ℕ → ℝ := fun m =>
    (PrimeHarmonic.sum (cutoff m θ) -
        Real.log (Real.log (cutoff m θ : ℝ))) -
      (PrimeHarmonic.sum (cutoff m lam) -
        Real.log (Real.log (cutoff m lam : ℝ)))
  have herr : ∀ᶠ m : ℕ in atTop, |err m| ≤ 2 * C := by
    filter_upwards [hLtwo, hUtwo] with m hmL hmU
    dsimp [err]
    calc
      |(PrimeHarmonic.sum (cutoff m θ) -
          Real.log (Real.log (cutoff m θ : ℝ))) -
        (PrimeHarmonic.sum (cutoff m lam) -
          Real.log (Real.log (cutoff m lam : ℝ)))| ≤
          |PrimeHarmonic.sum (cutoff m θ) -
            Real.log (Real.log (cutoff m θ : ℝ))| +
          |PrimeHarmonic.sum (cutoff m lam) -
            Real.log (Real.log (cutoff m lam : ℝ))| := abs_sub _ _
      _ ≤ C + C := add_le_add (hMertens _ hmU) (hMertens _ hmL)
      _ = 2 * C := by ring
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have herrzero : Tendsto
      (fun m : ℕ => err m / Real.log (m : ℝ)) atTop (𝓝 0) := by
    apply squeeze_zero_norm'
    · filter_upwards [herr, hlog.eventually_gt_atTop 0] with m hm hlogm
      simpa [abs_div, abs_of_pos hlogm] using
        (div_le_div_of_nonneg_right hm hlogm.le)
    · simpa only [zero_div] using
        tendsto_const_nhds.div_atTop hlog
  have hmain := (tendsto_log_log_cutoff_div_log hθ).sub
    (tendsto_log_log_cutoff_div_log hlam)
  have hadd := hmain.add herrzero
  convert hadd using 1
  · funext m
    by_cases hm : Real.log (m : ℝ) = 0
    · simp [hm]
    · rw [PrimeWindow.reciprocalMass_eq_sub]
      · dsimp [err]
        field_simp
        ring
      · exact hLUall m
  · ring_nf

/-- Replacing `1/p` by the Bernoulli odds `1/(p-1)` changes a prime
window by a vanishing amount. -/
theorem tendsto_oddsMass_cutoff_div_log
    {lam θ : ℝ} (hlam : 0 < lam) (hlamθ : lam < θ) :
    Tendsto
      (fun m : ℕ =>
        PrimeWindow.oddsMass (cutoff m lam) (cutoff m θ) /
          Real.log (m : ℝ))
      atTop (𝓝 (θ - lam)) := by
  have hrec := tendsto_reciprocalMass_cutoff_div_log hlam hlamθ
  have hpowlam : Tendsto (fun m : ℕ => (m : ℝ) ^ lam) atTop atTop :=
    (tendsto_rpow_atTop hlam).comp tendsto_natCast_atTop_atTop
  have hcutlam : Tendsto (fun m : ℕ => (cutoff m lam : ℝ)) atTop atTop := by
    have hexp := Real.tendsto_exp_atTop.comp hpowlam
    exact (Asymptotics.isEquivalent_of_tendsto_one
      (tendsto_cutoff_div_exp hlam)).symm.tendsto_atTop hexp
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hdiff : Tendsto
      (fun m : ℕ =>
        (PrimeWindow.oddsMass (cutoff m lam) (cutoff m θ) -
          PrimeWindow.reciprocalMass (cutoff m lam) (cutoff m θ)) /
            Real.log (m : ℝ)) atTop (𝓝 0) := by
    apply squeeze_zero'
    · filter_upwards [hcutlam.eventually_ge_atTop (1 : ℝ),
        hlog.eventually_gt_atTop 0] with m hmL hlogm
      exact div_nonneg
        (PrimeWindow.oddsMass_sub_reciprocalMass_nonneg _ _) hlogm.le
    · filter_upwards [hcutlam.eventually_ge_atTop (1 : ℝ),
        hlog.eventually_gt_atTop 0] with m hmL hlogm
      have hLn : 1 ≤ cutoff m lam := by exact_mod_cast hmL
      exact div_le_div_of_nonneg_right
        (PrimeWindow.oddsMass_sub_reciprocalMass_le hLn) hlogm.le
    · have hinvcut : Tendsto (fun m : ℕ => 1 / (cutoff m lam : ℝ))
          atTop (𝓝 0) := by
        exact Tendsto.congr'
          (Eventually.of_forall fun m => by simp [Function.comp_def, one_div])
          (tendsto_inv_atTop_zero.comp hcutlam)
      simpa only [zero_div] using hinvcut.div_atTop hlog
  have hadd := hrec.add hdiff
  convert hadd using 1
  · funext m
    ring_nf
  · ring_nf

/-- The modulus is eventually below the quarter power of the lower
exponential endpoint. -/
theorem eventually_natCast_le_cutoff_rpow_quarter {lam : ℝ} (hlam : 0 < lam) :
    ∀ᶠ m : ℕ in atTop,
      (m : ℝ) ≤ Real.rpow (cutoff m lam : ℝ) (1 / 4 : ℝ) := by
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ lam) atTop atTop :=
    (tendsto_rpow_atTop hlam).comp tendsto_natCast_atTop_atTop
  have hlogsmall : Tendsto
      (fun m : ℕ => Real.log (m : ℝ) / (m : ℝ) ^ lam)
      atTop (𝓝 0) := by
    have h := (isLittleO_log_rpow_atTop hlam).tendsto_div_nhds_zero
    exact (h.comp tendsto_natCast_atTop_atTop).congr'
      (Eventually.of_forall fun _ => rfl)
  have hpne : ∀ᶠ m : ℕ in atTop, (m : ℝ) ^ lam ≠ 0 := by
    filter_upwards [eventually_gt_atTop 0] with m hm
    exact (Real.rpow_pos_of_pos (by exact_mod_cast hm) lam).ne'
  have hcutratio : Tendsto
      (fun m : ℕ => Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam)
      atTop (𝓝 1) :=
    (Asymptotics.isEquivalent_iff_tendsto_one hpne).mp
      (log_cutoff_isEquivalent_rpow hlam)
  filter_upwards [eventually_gt_atTop 1,
      hlogsmall.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 8)),
      hcutratio.eventually (lt_mem_nhds (by norm_num : (1 / 2 : ℝ) < 1))]
      with m hm hsmall hlarge
  have hmpos : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have hmpow : 0 < (m : ℝ) ^ lam := Real.rpow_pos_of_pos hmpos lam
  have hlogm : Real.log (m : ℝ) ≤ (1 / 8 : ℝ) * (m : ℝ) ^ lam := by
    rw [div_lt_iff₀ hmpow] at hsmall
    linarith
  have hlogcut : (1 / 2 : ℝ) * (m : ℝ) ^ lam ≤
      Real.log (cutoff m lam : ℝ) := by
    rw [lt_div_iff₀ hmpow] at hlarge
    linarith
  have hcutpos : (0 : ℝ) < cutoff m lam := by
    by_contra h
    have hc : cutoff m lam ≤ 0 := by exact_mod_cast (le_of_not_gt h)
    have hz : cutoff m lam = 0 := by omega
    rw [hz] at hlogcut
    simp only [Nat.cast_zero, Real.log_zero] at hlogcut
    have : 0 < (1 / 2 : ℝ) * (m : ℝ) ^ lam := mul_pos (by norm_num) hmpow
    linarith
  have hlogineq : Real.log (m : ℝ) ≤
      (1 / 4 : ℝ) * Real.log (cutoff m lam : ℝ) := by
    nlinarith [hmpow]
  rw [show (m : ℝ) = Real.exp (Real.log (m : ℝ)) by
    rw [Real.exp_log hmpos]]
  calc
    Real.exp (Real.log (m : ℝ)) ≤
        Real.exp (Real.log (cutoff m lam : ℝ) * (1 / 4 : ℝ)) :=
      Real.exp_le_exp.mpr (by simpa [mul_comm] using hlogineq)
    _ = Real.rpow (cutoff m lam : ℝ) (1 / 4 : ℝ) :=
      (Real.rpow_def_of_pos hcutpos _).symm

/-- Bombieri--Vinogradov, with an arbitrarily high logarithmic saving,
uniformly controls every endpoint in an exponential prime window. -/
theorem exists_eventually_weighted_residue_error
    {lam θ : ℝ} (hlam : 0 < lam) (hlamθ : lam < θ)
    (N : ℕ) (hN : 2 ≤ N) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ m : ℕ in atTop,
      4 ≤ cutoff m lam ∧ cutoff m lam ≤ cutoff m θ ∧
      1 ≤ Real.log (cutoff m lam : ℝ) ∧
      ∀ a ∈ BoundedGaps.Maynard.coprimeResidues m,
        |PrimeWindow.residueOddsMass (cutoff m lam) (cutoff m θ) m a -
            PrimeWindow.oddsMass (cutoff m lam) (cutoff m θ) /
              (m.totient : ℝ)| ≤
          20 * C / Real.log (cutoff m lam : ℝ) ^ (N - 1) := by
  have hA : (0 : ℝ) ≤ N := by positivity
  obtain ⟨C, hC, X0, hX0, hBV⟩ :=
    PrimeResidues.exists_progressionDiscrepancy_le_logSaving (N : ℝ) hA
  let B : ℕ := N + 5
  have hsmallReal :=
    (isLittleO_log_rpow_rpow_atTop (B : ℝ)
      (by norm_num : (0 : ℝ) < 1 / 4)).bound one_pos
  have hsmallNat :=
    (tendsto_natCast_atTop_atTop (R := ℝ)).eventually hsmallReal
  obtain ⟨Y0, hY0⟩ := eventually_atTop.1 hsmallNat
  have hθ : 0 < θ := hlam.trans hlamθ
  have hpowlam : Tendsto (fun m : ℕ => (m : ℝ) ^ lam) atTop atTop :=
    (tendsto_rpow_atTop hlam).comp tendsto_natCast_atTop_atTop
  have hpowθ : Tendsto (fun m : ℕ => (m : ℝ) ^ θ) atTop atTop :=
    (tendsto_rpow_atTop hθ).comp tendsto_natCast_atTop_atTop
  have hcutlam : Tendsto (fun m : ℕ => (cutoff m lam : ℝ)) atTop atTop := by
    exact (Asymptotics.isEquivalent_of_tendsto_one
      (tendsto_cutoff_div_exp hlam)).symm.tendsto_atTop
        (Real.tendsto_exp_atTop.comp hpowlam)
  have hcutθ : Tendsto (fun m : ℕ => (cutoff m θ : ℝ)) atTop atTop := by
    exact (Asymptotics.isEquivalent_of_tendsto_one
      (tendsto_cutoff_div_exp hθ)).symm.tendsto_atTop
        (Real.tendsto_exp_atTop.comp hpowθ)
  refine ⟨C, hC, ?_⟩
  filter_upwards [eventually_gt_atTop 1,
      hcutlam.eventually_ge_atTop (max (max X0 Y0) 4 : ℝ),
      hcutθ.eventually_ge_atTop (4 : ℝ),
      eventually_natCast_le_cutoff_rpow_quarter hlam]
      with m hm hmL hmU hmquarter
  have hLn : max (max X0 Y0) 4 ≤ cutoff m lam := by exact_mod_cast hmL
  have hL4 : 4 ≤ cutoff m lam := (le_max_right _ _).trans hLn
  have hLX : X0 ≤ cutoff m lam :=
    (le_max_left X0 Y0).trans (le_max_left (max X0 Y0) 4) |>.trans hLn
  have hLY : Y0 ≤ cutoff m lam :=
    (le_max_right X0 Y0).trans (le_max_left (max X0 Y0) 4) |>.trans hLn
  have hLU : cutoff m lam ≤ cutoff m θ := by
    apply le_cutoff_iff.mpr
    exact (le_cutoff_iff.mp le_rfl).trans_le
      (Real.exp_le_exp.mpr
        (Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast (show 0 < m by omega))
          hlamθ.le))
  have hlogL : 1 ≤ Real.log (cutoff m lam : ℝ) := by
    have hcast : (Real.exp 1 : ℝ) ≤ cutoff m lam := by
      calc
        Real.exp 1 ≤ 4 := (Real.exp_one_lt_d9.trans (by norm_num)).le
        _ ≤ cutoff m lam := by exact_mod_cast hL4
    have hcpos : (0 : ℝ) < cutoff m lam := by exact_mod_cast (show 0 < cutoff m lam by omega)
    exact (Real.le_log_iff_exp_le hcpos).mpr hcast
  refine ⟨hL4, hLU, hlogL, ?_⟩
  intro a ha
  let C₂ : ℝ := C / Real.log (cutoff m lam : ℝ) ^ (N - 2)
  have hC₂ : 0 ≤ C₂ := div_nonneg hC (by positivity)
  have hdisc : ∀ n ∈ Finset.Icc (cutoff m lam) (cutoff m θ),
      |(BoundedGaps.Maynard.primeCountUpTo n m a : ℝ) -
          (BoundedGaps.Maynard.primeCountTotal n : ℝ) /
            (m.totient : ℝ)| ≤
        C₂ * (n : ℝ) / Real.log (n : ℝ) ^ 2 := by
    intro n hn
    have hnL : cutoff m lam ≤ n := (Finset.mem_Icc.mp hn).1
    have hnX : X0 ≤ n := hLX.trans hnL
    have hnY : Y0 ≤ n := hLY.trans hnL
    have hn4 : 4 ≤ n := hL4.trans hnL
    have hnpos : (0 : ℝ) < n := by positivity
    have hlognpos : 0 < Real.log (n : ℝ) :=
      Real.log_pos (by exact_mod_cast (show 1 < n by omega))
    have hsmall := hY0 n hnY
    have hlogpow : Real.log (n : ℝ) ^ B ≤
        Real.rpow (n : ℝ) (1 / 4 : ℝ) := by
      simpa [Function.comp_apply, Real.norm_eq_abs, abs_of_pos hlognpos,
        abs_of_nonneg (Real.rpow_nonneg hnpos.le _), Real.rpow_natCast]
        using hsmall
    have hmquarter' : (m : ℝ) ≤ Real.rpow (n : ℝ) (1 / 4 : ℝ) :=
      hmquarter.trans (Real.rpow_le_rpow (by positivity) (by exact_mod_cast hnL)
        (by norm_num))
    have hmodrange : (m : ℝ) ≤ Real.sqrt (n : ℝ) /
        Real.rpow (Real.log (n : ℝ)) ((N : ℝ) + 5) := by
      rw [show (N : ℝ) + 5 = (B : ℕ) by push_cast; simp [B]]
      have hrpowB : Real.rpow (Real.log (n : ℝ)) (B : ℝ) =
          Real.log (n : ℝ) ^ B := Real.rpow_natCast _ _
      rw [hrpowB]
      rw [le_div_iff₀ (pow_pos hlognpos B)]
      calc
        (m : ℝ) * Real.log (n : ℝ) ^ B ≤
            Real.rpow (n : ℝ) (1 / 4 : ℝ) *
              Real.rpow (n : ℝ) (1 / 4 : ℝ) :=
          mul_le_mul hmquarter' hlogpow (pow_nonneg hlognpos.le B)
            (Real.rpow_nonneg hnpos.le _)
        _ = Real.rpow (n : ℝ) ((1 / 4 : ℝ) + (1 / 4 : ℝ)) :=
          (Real.rpow_add hnpos _ _).symm
        _ = Real.rpow (n : ℝ) (1 / 2 : ℝ) := by norm_num
        _ = Real.sqrt (n : ℝ) := by
          exact (Real.sqrt_eq_rpow (n : ℝ)).symm
    have hbase := hBV n hnX m (by omega) hmodrange a ha
    change BoundedGaps.Maynard.progressionDiscrepancy n m a ≤ _ at hbase
    have hrpowN : Real.rpow (Real.log (n : ℝ)) (N : ℝ) =
        Real.log (n : ℝ) ^ N := Real.rpow_natCast _ _
    rw [BoundedGaps.Maynard.progressionDiscrepancy, hrpowN] at hbase
    have hlogmono : Real.log (cutoff m lam : ℝ) ≤ Real.log (n : ℝ) := by
      exact Real.strictMonoOn_log.monotoneOn
        (by change (0 : ℝ) < cutoff m lam; positivity)
        (by change (0 : ℝ) < n; positivity) (by exact_mod_cast hnL)
    have hpown : Real.log (cutoff m lam : ℝ) ^ (N - 2) ≤
        Real.log (n : ℝ) ^ (N - 2) := by gcongr
    have hlogLpos : 0 < Real.log (cutoff m lam : ℝ) :=
      lt_of_lt_of_le zero_lt_one hlogL
    have hpowEq : Real.log (n : ℝ) ^ N =
        Real.log (n : ℝ) ^ (N - 2) * Real.log (n : ℝ) ^ 2 := by
      calc
        Real.log (n : ℝ) ^ N =
            Real.log (n : ℝ) ^ ((N - 2) + 2) := by congr 1 <;> omega
        _ = _ := pow_add _ _ _
    have hdenle :
        Real.log (cutoff m lam : ℝ) ^ (N - 2) *
            Real.log (n : ℝ) ^ 2 ≤
          Real.log (n : ℝ) ^ N := by
      rw [hpowEq]
      gcongr
    have hdensmall : 0 <
        Real.log (cutoff m lam : ℝ) ^ (N - 2) *
          Real.log (n : ℝ) ^ 2 := mul_pos (pow_pos hlogLpos _) (pow_pos hlognpos _)
    calc
      _ ≤ C * (n : ℝ) / Real.log (n : ℝ) ^ N := hbase
      _ ≤ C * (n : ℝ) /
          (Real.log (cutoff m lam : ℝ) ^ (N - 2) *
            Real.log (n : ℝ) ^ 2) :=
        div_le_div_of_nonneg_left (mul_nonneg hC hnpos.le) hdensmall hdenle
      _ = (C / Real.log (cutoff m lam : ℝ) ^ (N - 2)) *
          (n : ℝ) / Real.log (n : ℝ) ^ 2 := by ring
      _ = _ := rfl
  have htwenty := PrimeWindow.abs_residueOddsMass_sub_average_le_twenty
    hL4 hLU hC₂ hlogL hdisc
  dsimp [C₂] at htwenty
  calc
    _ ≤ 20 * (C / Real.log (cutoff m lam : ℝ) ^ (N - 2)) /
        Real.log (cutoff m lam : ℝ) := htwenty
    _ = 20 * C / Real.log (cutoff m lam : ℝ) ^ (N - 1) := by
      rw [show N - 1 = (N - 2) + 1 by omega, pow_succ]
      field_simp

/-- The transition parameter in de la Bretèche's uniform form of Hall's
theorem, specialized to modulus `m` and upper cutoff `cutoff m α`. -/
def hallParameter (m : ℕ) (α : ℝ) : ℝ :=
  let L := Real.log (Real.log (cutoff m α : ℝ))
  (Real.log 2 * L - Real.log (m : ℝ)) /
    (Real.log 2 * Real.sqrt L)

/-- After division by `sqrt (log m)`, Hall's parameter has a finite,
nonzero limit away from the critical exponent. -/
theorem tendsto_hallParameter_div_sqrt_log {α : ℝ} (hα : 0 < α) :
    Tendsto
      (fun m : ℕ => hallParameter m α / Real.sqrt (Real.log (m : ℝ)))
      atTop
      (𝓝 ((Real.log 2 * α - 1) /
        (Real.log 2 * Real.sqrt α))) := by
  let L : ℕ → ℝ := fun m => Real.log (Real.log (cutoff m α : ℝ))
  let R : ℕ → ℝ := fun m => L m / Real.log (m : ℝ)
  have hR : Tendsto R atTop (𝓝 α) := by
    simpa only [R, L] using tendsto_log_log_cutoff_div_log hα
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ α) atTop atTop :=
    (tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop
  have hlogcut : Tendsto
      (fun m : ℕ => Real.log (cutoff m α : ℝ)) atTop atTop :=
    (log_cutoff_isEquivalent_rpow hα).symm.tendsto_atTop hpow
  have hL : Tendsto L atTop atTop := by
    simpa only [L, Function.comp_def] using
      Real.tendsto_log_atTop.comp hlogcut
  have hsqrtRatio : Tendsto
      (fun m : ℕ => Real.sqrt (L m) / Real.sqrt (Real.log (m : ℝ)))
      atTop (𝓝 (Real.sqrt α)) := by
    refine hR.sqrt.congr' ?_
    filter_upwards [hL.eventually_gt_atTop 0] with m hLm
    exact Real.sqrt_div hLm.le _
  have hnum : Tendsto
      (fun m : ℕ =>
        (Real.log 2 * L m - Real.log (m : ℝ)) /
          Real.log (m : ℝ))
      atTop (𝓝 (Real.log 2 * α - 1)) := by
    have hraw : Tendsto
        (fun m : ℕ => Real.log 2 * R m - 1)
        atTop (𝓝 (Real.log 2 * α - 1)) :=
      ((tendsto_const_nhds (x := Real.log 2)).mul hR).sub
        (tendsto_const_nhds (x := (1 : ℝ)))
    refine hraw.congr' ?_
    filter_upwards [eventually_gt_atTop 1] with m hm
    have hlog : Real.log (m : ℝ) ≠ 0 :=
      (Real.log_pos (by exact_mod_cast hm)).ne'
    simp only [R]
    field_simp
  have hden : Tendsto
      (fun m : ℕ => Real.log 2 *
        (Real.sqrt (L m) / Real.sqrt (Real.log (m : ℝ))))
      atTop (𝓝 (Real.log 2 * Real.sqrt α)) :=
    (tendsto_const_nhds (x := Real.log 2)).mul hsqrtRatio
  have hdenne : Real.log 2 * Real.sqrt α ≠ 0 :=
    mul_ne_zero (Real.log_pos (by norm_num)).ne'
      (Real.sqrt_pos.2 hα).ne'
  have hquot : Tendsto
      (fun m : ℕ =>
        ((Real.log 2 * L m - Real.log (m : ℝ)) /
            Real.log (m : ℝ)) /
          (Real.log 2 *
            (Real.sqrt (L m) / Real.sqrt (Real.log (m : ℝ)))))
      atTop
      (𝓝 ((Real.log 2 * α - 1) /
        (Real.log 2 * Real.sqrt α))) :=
    hnum.div hden hdenne
  refine hquot.congr' ?_
  filter_upwards [eventually_gt_atTop 1, hL.eventually_gt_atTop 0] with m hm hLm
  have hlogpos : 0 < Real.log (m : ℝ) :=
    Real.log_pos (by exact_mod_cast hm)
  have hsqrtlog : Real.sqrt (Real.log (m : ℝ)) ≠ 0 :=
    (Real.sqrt_pos.2 hlogpos).ne'
  have hsqrtL : Real.sqrt (L m) ≠ 0 :=
    (Real.sqrt_pos.2 hLm).ne'
  have hlogtwo : Real.log 2 ≠ 0 :=
    (Real.log_pos (by norm_num)).ne'
  simp only [hallParameter, L]
  field_simp
  rw [Real.sq_sqrt hlogpos.le]
  ring

theorem tendsto_hallParameter_atTop {α : ℝ}
    (hcrit : criticalExponent < α) :
    Tendsto (hallParameter · α) atTop atTop := by
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hα : 0 < α := lt_trans (by linarith [one_lt_criticalExponent]) hcrit
  have hnum : 0 < Real.log 2 * α - 1 := by
    have hmul : 1 < α * Real.log 2 :=
      (div_lt_iff₀ hlogtwo).mp (by
        simpa only [criticalExponent] using hcrit)
    nlinarith [mul_comm α (Real.log 2)]
  have hden : 0 < Real.log 2 * Real.sqrt α :=
    mul_pos hlogtwo (Real.sqrt_pos.2 hα)
  have hconst : 0 < (Real.log 2 * α - 1) /
      (Real.log 2 * Real.sqrt α) := div_pos hnum hden
  have hnorm := tendsto_hallParameter_div_sqrt_log hα
  have hsqrtlog : Tendsto
      (fun m : ℕ => Real.sqrt (Real.log (m : ℝ))) atTop atTop := by
    simpa only [Function.comp_def] using Real.tendsto_sqrt_atTop.comp
      (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)
  have hprod : Tendsto
      (fun m : ℕ => Real.sqrt (Real.log (m : ℝ)) *
        (hallParameter m α / Real.sqrt (Real.log (m : ℝ))))
      atTop atTop := hsqrtlog.atTop_mul_pos hconst hnorm
  refine hprod.congr' ?_
  filter_upwards [eventually_gt_atTop 1] with m hm
  have hsqrt : Real.sqrt (Real.log (m : ℝ)) ≠ 0 :=
    (Real.sqrt_pos.2 (Real.log_pos (by exact_mod_cast hm))).ne'
  field_simp

theorem tendsto_hallParameter_atBot {α : ℝ}
    (hα : 0 < α) (hcrit : α < criticalExponent) :
    Tendsto (hallParameter · α) atTop atBot := by
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hnum : Real.log 2 * α - 1 < 0 := by
    have hmul : α * Real.log 2 < 1 :=
      (lt_div_iff₀ hlogtwo).mp (by
        simpa only [criticalExponent] using hcrit)
    nlinarith [mul_comm α (Real.log 2)]
  have hden : 0 < Real.log 2 * Real.sqrt α :=
    mul_pos hlogtwo (Real.sqrt_pos.2 hα)
  have hconst : (Real.log 2 * α - 1) /
      (Real.log 2 * Real.sqrt α) < 0 := div_neg_of_neg_of_pos hnum hden
  have hnorm := tendsto_hallParameter_div_sqrt_log hα
  have hsqrtlog : Tendsto
      (fun m : ℕ => Real.sqrt (Real.log (m : ℝ))) atTop atTop := by
    simpa only [Function.comp_def] using Real.tendsto_sqrt_atTop.comp
      (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)
  have hprod : Tendsto
      (fun m : ℕ => Real.sqrt (Real.log (m : ℝ)) *
        (hallParameter m α / Real.sqrt (Real.log (m : ℝ))))
      atTop atBot := hsqrtlog.atTop_mul_neg hconst hnorm
  refine hprod.congr' ?_
  filter_upwards [eventually_gt_atTop 1] with m hm
  have hsqrt : Real.sqrt (Real.log (m : ℝ)) ≠ 0 :=
    (Real.sqrt_pos.2 (Real.log_pos (by exact_mod_cast hm))).ne'
  field_simp

/-! ## Gaussian transition function -/

/-- The distribution function of the standard real Gaussian, presented as
an ordinary real integral so that Hall's density estimate can be combined
directly with real-valued limits. -/
def gaussianCDF (z : ℝ) : ℝ :=
  ∫ x in Set.Iic z, ProbabilityTheory.gaussianPDFReal 0 (1 : NNReal) x

private theorem gaussianCDF_eq_measureReal (z : ℝ) :
    gaussianCDF z =
      (ProbabilityTheory.gaussianReal 0 (1 : NNReal) (Set.Iic z)).toReal := by
  have hnonneg : 0 ≤
      ∫ x in Set.Iic z, ProbabilityTheory.gaussianPDFReal 0 (1 : NNReal) x := by
    exact MeasureTheory.integral_nonneg_of_ae
      (Filter.Eventually.of_forall fun x =>
        ProbabilityTheory.gaussianPDFReal_nonneg 0 (1 : NNReal) x)
  have h := ProbabilityTheory.gaussianReal_apply_eq_integral
    0 (v := (1 : NNReal)) (by norm_num) (Set.Iic z)
  apply Eq.symm
  simpa [gaussianCDF, ENNReal.toReal_ofReal hnonneg] using congrArg ENNReal.toReal h

theorem tendsto_gaussianCDF_atBot :
    Tendsto gaussianCDF atBot (nhds 0) := by
  exact MeasureTheory.tendsto_integral_Iic_zero
    (f := ProbabilityTheory.gaussianPDFReal 0 (1 : NNReal)) tendsto_id

theorem tendsto_gaussianCDF_atTop :
    Tendsto gaussianCDF atTop (nhds 1) := by
  let μ := ProbabilityTheory.gaussianReal 0 (1 : NNReal)
  have hmeasure : Tendsto (fun z : ℝ => (μ (Set.Iic z)).toReal) atTop (nhds 1) := by
    have htoReal := (ENNReal.tendsto_toReal (by simp : μ Set.univ ≠ ⊤)).comp
      (MeasureTheory.tendsto_measure_Iic_atTop μ)
    have huniv : (μ Set.univ).toReal = 1 := by simp [μ]
    rw [huniv] at htoReal
    exact htoReal.congr' (Filter.Eventually.of_forall fun _ => rfl)
  exact hmeasure.congr' (Filter.Eventually.of_forall fun z =>
    (gaussianCDF_eq_measureReal z).symm)

/-- The elementary part of the zero-limit range.  Hall's theorem extends
this from `α < 1` to `α < 1 / log 2`. -/
theorem tendsto_delta_zero_of_lt_one {α : ℝ} (hα : α < 1) :
    Tendsto (δ · α) atTop (𝓝 0) := by
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ (α - 1)) atTop (𝓝 0) := by
    have hraw := (tendsto_rpow_neg_atTop (sub_pos.mpr hα)).comp
      tendsto_natCast_atTop_atTop
    refine hraw.congr' (Eventually.of_forall fun m => ?_)
    simp only [Function.comp_apply, neg_sub]
  have hone : Tendsto (fun m : ℕ => (1 : ℝ) / m) atTop (𝓝 0) :=
    tendsto_one_div_atTop_nhds_zero_nat
  have hupper : Tendsto
      (fun m : ℕ => ((m : ℝ) ^ α + 1) / m) atTop (𝓝 0) := by
    have heq : (fun m : ℕ => (m : ℝ) ^ (α - 1) + 1 / m) =ᶠ[atTop]
        (fun m : ℕ => ((m : ℝ) ^ α + 1) / m) := by
      filter_upwards [eventually_gt_atTop 0] with m hm
      have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
      rw [add_div, ← Real.rpow_sub_one hm0 α]
    simpa only [zero_add] using (hpow.add hone).congr' heq
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le'
    tendsto_const_nhds hupper
  · exact Eventually.of_forall fun m => delta_nonneg m α
  · filter_upwards [eventually_gt_atTop 0] with m hm
    exact delta_le_trivial hm α

/-! ## Exact CRT-to-divisor transfer -/

/-- A finite family of distinct primes, all coprime to the modulus, gives
an exact Bernoulli lower bound for `δ`: every nonempty unit-product
relation supplies an eligible divisor. -/
theorem sum_weight_relation_le_delta
    {I : Type*} [Fintype I] [LinearOrder I]
    {m : ℕ} (hm : 0 < m) (α : ℝ)
    (a : I → ℕ) (hprime : ∀ i, (a i).Prime)
    (hinj : Function.Injective a) (hcopm : ∀ i, Nat.Coprime (a i) m)
    (hbound : ∀ T : Finset I, T.Nonempty →
      (((∏ i ∈ T, a i : ℕ) : ℕ) : ℝ) < Real.exp ((m : ℝ) ^ α)) :
    (∑ S ∈ WeightedSubset.relationSubsets
        (fun i => ZMod.unitOfCoprime (a i) (hcopm i)),
      Bernoulli.weight Finset.univ (fun i => 1 / (a i : ℝ)) S) ≤
      δ m α := by
  classical
  let f : I → (ZMod m)ˣ :=
    fun i => ZMod.unitOfCoprime (a i) (hcopm i)
  letI (i : I) : NeZero (a i) := ⟨(hprime i).ne_zero⟩
  have hpair : Pairwise (Function.onFun Nat.Coprime a) := by
    intro i j hij
    have hne : a i ≠ a j := fun h => hij (hinj h)
    exact (hprime i).coprime_iff_not_dvd.mpr fun hd =>
      hne ((Nat.prime_dvd_prime_iff_eq (hprime i) (hprime j)).mp hd)
  let Q : ℕ := ∏ i, a i
  letI : NeZero Q := ⟨by
    dsimp [Q]
    exact Finset.prod_ne_zero_iff.mpr fun i _ => (hprime i).ne_zero⟩
  let selected : ℕ → Finset I := fun n =>
    Finset.univ.filter fun i => a i ∣ n
  have hzero (n : ℕ) :
      CRTModel.zeroSet a
          (ZMod.prodEquivPi a hpair (n : ZMod Q)) = selected n := by
    ext i
    simp only [CRTModel.mem_zeroSet, selected, Finset.mem_filter,
      Finset.mem_univ, true_and]
    simp [ZMod.prodEquivPi_apply, ZMod.natCast_eq_zero_iff]
  let R : Set ℕ := {n | ¬ WeightedSubset.noRelationSet f (selected n)}
  have hRdensity : R.HasDensity
      (∑ S ∈ WeightedSubset.relationSubsets f,
        Bernoulli.weight Finset.univ (fun i => 1 / (a i : ℝ)) S) := by
    have hcrt := CRTModel.crt_zeroSet_good_hasDensity a hpair
      (fun S => ¬ WeightedSubset.noRelationSet f S)
    convert hcrt using 1
    · ext n
      simp only [R, Set.mem_setOf_eq]
      rw [hzero]
    · rfl
  have hRsub : R ⊆ divisorSet m α := by
    intro n hn
    simp only [R, Set.mem_setOf_eq] at hn
    simp only [WeightedSubset.noRelationSet, not_forall, not_not,
      _root_.not_imp] at hn
    obtain ⟨T, hTS, hTne, hprod⟩ := hn
    let d : ℕ := ∏ i ∈ T, a i
    have hdvd : d ∣ n := by
      apply Finset.prod_dvd_of_isRelPrime
      · intro i hi j hj hij
        exact Nat.coprime_iff_isRelPrime.mp (hpair hij)
      · intro i hi
        have hiS : i ∈ selected n := hTS hi
        simpa [selected] using hiS
    have hdgt : 1 < d := by
      obtain ⟨i, hi⟩ := hTne
      have haidvd : a i ∣ d := Finset.dvd_prod_of_mem (fun j => a j) hi
      exact lt_of_lt_of_le (hprime i).one_lt
        (Nat.le_of_dvd (Finset.prod_pos fun j _ => (hprime j).pos) haidvd)
    have hmod : d ≡ 1 [MOD m] := by
      rw [← ZMod.natCast_eq_natCast_iff]
      have hv := congrArg (fun u : (ZMod m)ˣ => (u : ZMod m)) hprod
      simpa [d, f] using hv
    exact ⟨d, hmod, ⟨by exact_mod_cast hdgt, hbound T hTne⟩, hdvd⟩
  exact hasDensity_le_of_subset hRdensity (divisorSet_hasDensity m α) hRsub

theorem sum_weight_boundedRelation_le_delta
    {I : Type*} [Fintype I] [LinearOrder I]
    {m : ℕ} (hm : 0 < m) (α : ℝ)
    (a : I → ℕ) (hprime : ∀ i, (a i).Prime)
    (hinj : Function.Injective a) (hcopm : ∀ i, Nat.Coprime (a i) m)
    (Kmax : ℕ)
    (hbound : ∀ T : Finset I, T.Nonempty → T.card ≤ Kmax →
      (((∏ i ∈ T, a i : ℕ) : ℕ) : ℝ) < Real.exp ((m : ℝ) ^ α)) :
    (∑ S ∈ WeightedSubset.boundedRelationSubsets
        (fun i => ZMod.unitOfCoprime (a i) (hcopm i)) Kmax,
      Bernoulli.weight Finset.univ (fun i => 1 / (a i : ℝ)) S) ≤
      δ m α := by
  classical
  let f : I → (ZMod m)ˣ :=
    fun i => ZMod.unitOfCoprime (a i) (hcopm i)
  letI (i : I) : NeZero (a i) := ⟨(hprime i).ne_zero⟩
  have hpair : Pairwise (Function.onFun Nat.Coprime a) := by
    intro i j hij
    have hne : a i ≠ a j := fun h => hij (hinj h)
    exact (hprime i).coprime_iff_not_dvd.mpr fun hd =>
      hne ((Nat.prime_dvd_prime_iff_eq (hprime i) (hprime j)).mp hd)
  let Q : ℕ := ∏ i, a i
  letI : NeZero Q := ⟨by
    dsimp [Q]
    exact Finset.prod_ne_zero_iff.mpr fun i _ => (hprime i).ne_zero⟩
  let selected : ℕ → Finset I := fun n =>
    Finset.univ.filter fun i => a i ∣ n
  have hzero (n : ℕ) :
      CRTModel.zeroSet a
          (ZMod.prodEquivPi a hpair (n : ZMod Q)) = selected n := by
    ext i
    simp only [CRTModel.mem_zeroSet, selected, Finset.mem_filter,
      Finset.mem_univ, true_and]
    simp [ZMod.prodEquivPi_apply, ZMod.natCast_eq_zero_iff]
  let R : Set ℕ := {n |
    ¬ WeightedSubset.noRelationSet f (selected n) ∧
      (selected n).card ≤ Kmax}
  have hRdensity : R.HasDensity
      (∑ S ∈ WeightedSubset.boundedRelationSubsets f Kmax,
        Bernoulli.weight Finset.univ (fun i => 1 / (a i : ℝ)) S) := by
    have hcrt := CRTModel.crt_zeroSet_good_hasDensity a hpair
      (fun S => ¬ WeightedSubset.noRelationSet f S ∧ S.card ≤ Kmax)
    convert hcrt using 1
    · ext n
      simp only [R, Set.mem_setOf_eq]
      rw [hzero]
    · rfl
  have hRsub : R ⊆ divisorSet m α := by
    intro n hn
    simp only [R, Set.mem_setOf_eq] at hn
    have hnrel := hn.1
    simp only [WeightedSubset.noRelationSet, not_forall, not_not] at hnrel
    obtain ⟨T, hTS, hTne, hprod⟩ := hnrel
    let d : ℕ := ∏ i ∈ T, a i
    have hTcard : T.card ≤ Kmax :=
      (Finset.card_le_card hTS).trans hn.2
    have hdvd : d ∣ n := by
      apply Finset.prod_dvd_of_isRelPrime
      · intro i hi j hj hij
        exact Nat.coprime_iff_isRelPrime.mp (hpair hij)
      · intro i hi
        have hiS : i ∈ selected n := hTS hi
        simpa [selected] using hiS
    have hdgt : 1 < d := by
      obtain ⟨i, hi⟩ := hTne
      have haidvd : a i ∣ d := Finset.dvd_prod_of_mem (fun j => a j) hi
      exact lt_of_lt_of_le (hprime i).one_lt
        (Nat.le_of_dvd (Finset.prod_pos fun j _ => (hprime j).pos) haidvd)
    have hmod : d ≡ 1 [MOD m] := by
      rw [← ZMod.natCast_eq_natCast_iff]
      have hv := congrArg (fun u : (ZMod m)ˣ => (u : ZMod m)) hprod
      simpa [d, f] using hv
    exact ⟨d, hmod,
      ⟨by exact_mod_cast hdgt, hbound T hTne hTcard⟩, hdvd⟩
  exact hasDensity_le_of_subset hRdensity (divisorSet_hasDensity m α) hRsub

/-! ## Prime-window normalization -/

/-- The abstract residue mass in the weighted subset lemmas is exactly the
odds-weighted prime mass in the corresponding reduced residue class. -/
theorem residueMass_primeUnits_eq
    {L U m : ℕ} (hm : 0 < m)
    (hcop : ∀ p ∈ PrimeWindow.primes L U, Nat.Coprime p m)
    (u : (ZMod m)ˣ) :
    WeightedSubset.residueMass
        (Bernoulli.odds (fun p : ↥(PrimeWindow.primes L U) =>
          1 / (p.1 : ℝ)))
        (fun p : ↥(PrimeWindow.primes L U) =>
          ZMod.unitOfCoprime p.1 (hcop p.1 p.2)) u =
      PrimeWindow.residueOddsMass L U m (u : ZMod m).val := by
  classical
  letI : NeZero m := ⟨hm.ne'⟩
  unfold WeightedSubset.residueMass Bernoulli.odds
    PrimeWindow.residueOddsMass
  rw [show (Finset.univ : Finset ↥(PrimeWindow.primes L U)) =
      (PrimeWindow.primes L U).attach by ext; simp]
  simp only [Finset.sum_filter]
  rw [← Finset.sum_attach (PrimeWindow.primes L U)
    (fun p => if p % m = (u : ZMod m).val % m then
      1 / ((p : ℝ) - 1) else 0)]
  apply Finset.sum_congr rfl
  intro p _hp
  have hpprime := (PrimeWindow.mem_primes.mp p.2).2.2
  have hpgt : (1 : ℝ) < p.1 := by exact_mod_cast hpprime.one_lt
  have hvalmod : (u : ZMod m).val % m = (u : ZMod m).val :=
    Nat.mod_eq_of_lt (ZMod.val_lt _)
  have heq :
      ZMod.unitOfCoprime p.1 (hcop p.1 p.2) = u ↔
        p.1 % m = (u : ZMod m).val % m := by
    constructor
    · intro h
      have hc := congrArg (fun v : (ZMod m)ˣ => (v : ZMod m)) h
      rw [ZMod.coe_unitOfCoprime] at hc
      have hv := congrArg ZMod.val hc
      simpa [hvalmod] using hv
    · intro h
      apply Units.ext
      rw [ZMod.coe_unitOfCoprime]
      apply ZMod.val_injective
      simpa [hvalmod] using h
  by_cases h : p.1 % m = (u : ZMod m).val % m
  · simp [h, heq, div_eq_mul_inv]
    field_simp
  · simp [h, heq]

/-- A pointwise progression estimate gives the required total-variation
bound on the unit group. -/
theorem residue_l1_le_of_pointwise
    {L U m : ℕ} [NeZero m] (hm : 0 < m)
    (hcop : ∀ p ∈ PrimeWindow.primes L U, Nat.Coprime p m)
    {W D : ℝ} (hW : W = PrimeWindow.oddsMass L U)
    (hWpos : 0 < W) (hD : 0 ≤ D)
    (hpoint : ∀ a ∈ BoundedGaps.Maynard.coprimeResidues m,
      |PrimeWindow.residueOddsMass L U m a -
        PrimeWindow.oddsMass L U / (m.totient : ℝ)| ≤ D) :
    (∑ u : (ZMod m)ˣ,
      |WeightedSubset.residueMass
          (Bernoulli.odds (fun p : ↥(PrimeWindow.primes L U) =>
            1 / (p.1 : ℝ)))
          (fun p : ↥(PrimeWindow.primes L U) =>
            ZMod.unitOfCoprime p.1 (hcop p.1 p.2)) u / W -
        1 / (Fintype.card (ZMod m)ˣ : ℝ)|) ≤
      (m.totient : ℝ) * D / W := by
  classical
  have hcard : Fintype.card (ZMod m)ˣ = m.totient :=
    ZMod.card_units_eq_totient m
  have hterm (u : (ZMod m)ˣ) :
      |WeightedSubset.residueMass
          (Bernoulli.odds (fun p : ↥(PrimeWindow.primes L U) =>
            1 / (p.1 : ℝ)))
          (fun p : ↥(PrimeWindow.primes L U) =>
            ZMod.unitOfCoprime p.1 (hcop p.1 p.2)) u / W -
        1 / (Fintype.card (ZMod m)ˣ : ℝ)| ≤ D / W := by
    have huCop : Nat.Coprime (u : ZMod m).val m := by
      have hu := (ZMod.unitsEquivCoprime u).property
      change Nat.Coprime (u : ZMod m).val m at hu
      exact hu
    have humem : (u : ZMod m).val ∈
        BoundedGaps.Maynard.coprimeResidues m := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_range.mpr (ZMod.val_lt _), huCop⟩
    have hp := hpoint (u : ZMod m).val humem
    rw [residueMass_primeUnits_eq hm hcop, hW, hcard]
    have htotpos : (0 : ℝ) < m.totient := by
      exact_mod_cast Nat.totient_pos.mpr hm
    have hodds : 0 < PrimeWindow.oddsMass L U := by
      simpa [hW] using hWpos
    have hid :
        PrimeWindow.residueOddsMass L U m (u : ZMod m).val /
              PrimeWindow.oddsMass L U - 1 / (m.totient : ℝ) =
          (PrimeWindow.residueOddsMass L U m (u : ZMod m).val -
              PrimeWindow.oddsMass L U / (m.totient : ℝ)) /
            PrimeWindow.oddsMass L U := by
      field_simp [hodds.ne', htotpos.ne']
    rw [hid, abs_div]
    rw [abs_of_pos hodds]
    exact div_le_div_of_nonneg_right hp hodds.le
  calc
    (∑ u : (ZMod m)ˣ, |WeightedSubset.residueMass
          (Bernoulli.odds (fun p : ↥(PrimeWindow.primes L U) =>
            1 / (p.1 : ℝ)))
          (fun p : ↥(PrimeWindow.primes L U) =>
            ZMod.unitOfCoprime p.1 (hcop p.1 p.2)) u / W -
        1 / (Fintype.card (ZMod m)ˣ : ℝ)|) ≤
      ∑ _u : (ZMod m)ˣ, D / W := Finset.sum_le_sum fun _ _ => hterm _
    _ = (m.totient : ℝ) * D / W := by
      simp [hcard]
      ring

/-- The omitted Bernoulli normalization cancels the exponential series
factor up to the difference between odds mass and reciprocal mass. -/
theorem zeroBase_mul_exp_odds_le
    {I : Type*} [Fintype I] [DecidableEq I]
    (p : I → ℝ) (hp0 : ∀ i, 0 ≤ p i) (hp1 : ∀ i, p i ≤ 1) :
    Bernoulli.zeroBase (Finset.univ : Finset I) p *
        Real.exp (∑ i, Bernoulli.odds p i) ≤
      Real.exp ((∑ i, Bernoulli.odds p i) - ∑ i, p i) := by
  have hprod : Bernoulli.zeroBase (Finset.univ : Finset I) p ≤
      Real.exp (-(∑ i, p i)) := by
    unfold Bernoulli.zeroBase
    rw [Real.exp_neg, Real.exp_sum]
    rw [← Finset.prod_inv_distrib]
    apply Finset.prod_le_prod
    · intro i _
      exact sub_nonneg.mpr (hp1 i)
    · intro i _
      rw [← Real.exp_neg]
      exact Real.one_sub_le_exp_neg _
  calc
    Bernoulli.zeroBase (Finset.univ : Finset I) p *
        Real.exp (∑ i, Bernoulli.odds p i) ≤
      Real.exp (-(∑ i, p i)) *
        Real.exp (∑ i, Bernoulli.odds p i) :=
      mul_le_mul_of_nonneg_right hprod (Real.exp_pos _).le
    _ = _ := by rw [← Real.exp_add]; congr 1 <;> ring

/-- Finite upper-regime estimate with all CRT and subset-product
bookkeeping discharged.  Only scalar error terms remain. -/
theorem one_sub_delta_le_primeWindow_error
    {L U m Kmin Kmax : ℕ} (hm : 0 < m) (α : ℝ)
    (hcop : ∀ p ∈ PrimeWindow.primes L U, Nat.Coprime p m)
    {D rlo rhi : ℝ} (hD : 0 ≤ D)
    (hpoint : ∀ a ∈ BoundedGaps.Maynard.coprimeResidues m,
      |PrimeWindow.residueOddsMass L U m a -
        PrimeWindow.oddsMass L U / (m.totient : ℝ)| ≤ D)
    (hEWpos : 0 < PrimeWindow.reciprocalMass L U)
    (hWpos : 0 < PrimeWindow.oddsMass L U)
    (hKmin : 1 ≤ Kmin) (hKK : Kmin ≤ Kmax)
    (hrlo0 : 0 < rlo) (hrlo1 : rlo < 1)
    (hKlo : (Kmin : ℝ) ≤ rlo * PrimeWindow.reciprocalMass L U)
    (hrhi : 1 < rhi)
    (hKhi : rhi * PrimeWindow.reciprocalMass L U ≤ (Kmax + 1 : ℕ))
    (hbound : ∀ T : Finset ↥(PrimeWindow.primes L U), T.Nonempty →
      T.card ≤ Kmax →
      ((((∏ i ∈ T, i.1 : ℕ) : ℕ) : ℝ) < Real.exp ((m : ℝ) ^ α))) :
    1 - δ m α ≤
      Real.exp
          ((rlo * ((1 - rlo) / (2 * rlo)) +
            (1 / (1 + ((1 - rlo) / (2 * rlo))) - 1)) *
              PrimeWindow.reciprocalMass L U) +
      2 * Real.exp
          (((-(rhi * ((rhi - 1) / (2 * rhi)))) +
            (1 / (1 - ((rhi - 1) / (2 * rhi))) - 1)) *
              PrimeWindow.reciprocalMass L U) +
      Real.exp (PrimeWindow.oddsMass L U -
          PrimeWindow.reciprocalMass L U) *
        ((m.totient : ℝ) / ((2 : ℝ) ^ Kmin - 1) +
          (Kmax : ℝ) * ((m.totient : ℝ) * D /
            PrimeWindow.oddsMass L U)) := by
  classical
  letI : NeZero m := ⟨hm.ne'⟩
  let I := ↥(PrimeWindow.primes L U)
  let p : I → ℝ := fun i => 1 / (i.1 : ℝ)
  let hcopI : ∀ i : I, Nat.Coprime i.1 m := fun i => hcop i.1 i.2
  let f : I → (ZMod m)ˣ := fun i =>
    ZMod.unitOfCoprime i.1 (hcopI i)
  have hpprime (i : I) : i.1.Prime :=
    (PrimeWindow.mem_primes.mp i.2).2.2
  have hp0 (i : I) : 0 ≤ p i := by dsimp [p]; positivity
  have hp1 (i : I) : p i < 1 := by
    dsimp [p]
    rw [one_div]
    exact inv_lt_one_of_one_lt₀ (by exact_mod_cast (hpprime i).one_lt)
  have hEW : PrimeWindow.reciprocalMass L U = ∑ i : I, p i := by
    unfold PrimeWindow.reciprocalMass
    rw [← Finset.sum_attach (PrimeWindow.primes L U) (fun q => 1 / (q : ℝ))]
    rfl
  have hW : PrimeWindow.oddsMass L U =
      ∑ i : I, Bernoulli.odds p i := by
    unfold PrimeWindow.oddsMass Bernoulli.odds
    rw [← Finset.sum_attach (PrimeWindow.primes L U)
      (fun q => 1 / ((q : ℝ) - 1))]
    apply Finset.sum_congr rfl
    intro i _
    have hi : (1 : ℝ) < i.1 := by exact_mod_cast (hpprime i).one_lt
    dsimp [p]
    field_simp
  have hTV := residue_l1_le_of_pointwise hm hcop
    (W := PrimeWindow.oddsMass L U)
    (D := D) rfl hWpos hD hpoint
  have heps : 0 ≤ (m.totient : ℝ) * D /
      PrimeWindow.oddsMass L U := by positivity
  have hfinite := WeightedSubset.one_sub_sum_weight_boundedRelation_le
    p f hp0 hp1 hEW hW hWpos heps hTV hKmin hKK
      hrlo0 hrlo1 hKlo hrhi hKhi
  have hrel := sum_weight_boundedRelation_le_delta hm α
    (fun i : I => i.1) hpprime Subtype.val_injective
      hcopI Kmax hbound
  have hrel' :
      (∑ S ∈ WeightedSubset.boundedRelationSubsets f Kmax,
        Bernoulli.weight Finset.univ p S) ≤ δ m α := by
    convert hrel using 1
    rfl
  have hnorm := zeroBase_mul_exp_odds_le p hp0 (fun i => (hp1 i).le)
  rw [← hEW, ← hW] at hnorm
  rw [ZMod.card_units_eq_totient] at hfinite
  have hdenpos : 0 < (2 : ℝ) ^ Kmin - 1 := by
    have hpow : (2 : ℝ) ≤ 2 ^ Kmin := by
      simpa using pow_le_pow_right₀ one_le_two hKmin
    linarith
  have hbracket : 0 ≤
      (m.totient : ℝ) / ((2 : ℝ) ^ Kmin - 1) +
        (Kmax : ℝ) * ((m.totient : ℝ) * D /
          PrimeWindow.oddsMass L U) := by positivity
  have hmiddle := mul_le_mul_of_nonneg_right hnorm hbracket
  calc
    1 - δ m α ≤ 1 -
        (∑ S ∈ WeightedSubset.boundedRelationSubsets f Kmax,
          Bernoulli.weight Finset.univ p S) := by linarith [hrel']
    _ ≤ _ := hfinite.trans (add_le_add_right hmiddle _)

/-! ## Scalar asymptotics for the sharp window -/

theorem tendsto_reciprocalMass_cutoff_atTop
    {lam θ : ℝ} (hlam : 0 < lam) (hlamθ : lam < θ) :
    Tendsto (fun m : ℕ =>
      PrimeWindow.reciprocalMass (cutoff m lam) (cutoff m θ))
      atTop atTop := by
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hratio := tendsto_reciprocalMass_cutoff_div_log hlam hlamθ
  have hc : 0 < θ - lam := sub_pos.mpr hlamθ
  have hprod := hlog.atTop_mul_pos hc hratio
  refine hprod.congr' ?_
  filter_upwards [eventually_gt_atTop 1] with m hm
  have hlogne : Real.log (m : ℝ) ≠ 0 :=
    (Real.log_pos (by exact_mod_cast hm)).ne'
  field_simp

theorem tendsto_oddsMass_cutoff_atTop
    {lam θ : ℝ} (hlam : 0 < lam) (hlamθ : lam < θ) :
    Tendsto (fun m : ℕ =>
      PrimeWindow.oddsMass (cutoff m lam) (cutoff m θ))
      atTop atTop := by
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hratio := tendsto_oddsMass_cutoff_div_log hlam hlamθ
  have hc : 0 < θ - lam := sub_pos.mpr hlamθ
  have hprod := hlog.atTop_mul_pos hc hratio
  refine hprod.congr' ?_
  filter_upwards [eventually_gt_atTop 1] with m hm
  have hlogne : Real.log (m : ℝ) ≠ 0 :=
    (Real.log_pos (by exact_mod_cast hm)).ne'
  field_simp

/-- A logarithmic-saving power at the lower exponential endpoint beats
the modulus as soon as its exponent exceeds `1 / lam`. -/
theorem tendsto_natCast_div_log_cutoff_pow
    {lam : ℝ} (hlam : 0 < lam) {k : ℕ} (hk : 1 < lam * k) :
    Tendsto (fun m : ℕ =>
      (m : ℝ) / Real.log (cutoff m lam : ℝ) ^ k) atTop (𝓝 0) := by
  have hpowne : ∀ᶠ m : ℕ in atTop, (m : ℝ) ^ lam ≠ 0 := by
    filter_upwards [eventually_gt_atTop 0] with m hm
    exact (Real.rpow_pos_of_pos (by exact_mod_cast hm) _).ne'
  have hratio : Tendsto (fun m : ℕ =>
      Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam) atTop (𝓝 1) :=
    (Asymptotics.isEquivalent_iff_tendsto_one hpowne).mp
      (log_cutoff_isEquivalent_rpow hlam)
  have hratioPow : Tendsto (fun m : ℕ =>
      (Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam) ^ k)
      atTop (𝓝 1) := by simpa using hratio.pow k
  have hbase : Tendsto (fun m : ℕ =>
      (m : ℝ) ^ (1 - lam * k)) atTop (𝓝 0) := by
    have hraw := (tendsto_rpow_neg_atTop (sub_pos.mpr hk)).comp
      tendsto_natCast_atTop_atTop
    simpa only [Function.comp_def, neg_sub] using hraw
  have hdiv := hbase.div hratioPow (by norm_num : (1 : ℝ) ≠ 0)
  have hdiv0 : Tendsto (fun m : ℕ =>
      (m : ℝ) ^ (1 - lam * k) /
        (Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam) ^ k)
      atTop (𝓝 0) := by
    convert hdiv using 1
    · funext m
      rfl
    · norm_num
  refine hdiv0.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with m hm
  have hmpos : (0 : ℝ) < m := by exact_mod_cast hm
  have hmpow : (m : ℝ) ^ lam ≠ 0 := (Real.rpow_pos_of_pos hmpos _).ne'
  have hlogeq :
      Real.log (cutoff m lam : ℝ) ^ k =
        (((m : ℝ) ^ lam) ^ k) *
          (Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam) ^ k := by
    rw [div_pow]
    field_simp
  rw [hlogeq]
  have hrpowmul : (((m : ℝ) ^ lam) ^ k) = (m : ℝ) ^ (lam * k) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hmpos.le]
  rw [hrpowmul]
  rw [← div_div]
  congr 1
  rw [Real.rpow_sub hmpos]
  norm_num

/-- The subset-product denominator beats the modulus precisely when the
chosen cardinality coefficient is larger than `1 / log 2`. -/
theorem tendsto_natCast_div_two_pow_floor_log
    {d : ℝ} (hd : 1 < d * Real.log 2) :
    Tendsto (fun m : ℕ =>
      (m : ℝ) /
        ((2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) - 1))
      atTop (𝓝 0) := by
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hdpos : 0 < d := by nlinarith
  have hepos : 0 < d * Real.log 2 := by positivity
  have hpowtop : Tendsto (fun m : ℕ =>
      (m : ℝ) ^ (d * Real.log 2)) atTop atTop :=
    (tendsto_rpow_atTop hepos).comp tendsto_natCast_atTop_atTop
  have hscaled : Tendsto (fun m : ℕ =>
      d * Real.log (m : ℝ)) atTop atTop :=
    (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).const_mul_atTop hdpos
  have hupper : Tendsto (fun m : ℕ =>
      4 * (m : ℝ) ^ (1 - d * Real.log 2)) atTop (𝓝 0) := by
    have hraw := (tendsto_rpow_neg_atTop (sub_pos.mpr hd)).comp
      tendsto_natCast_atTop_atTop
    have hzero : Tendsto (fun m : ℕ =>
        (m : ℝ) ^ (1 - d * Real.log 2)) atTop (𝓝 0) := by
      simpa only [Function.comp_def, neg_sub] using hraw
    simpa using (tendsto_const_nhds.mul hzero)
  apply squeeze_zero'
  · filter_upwards [eventually_gt_atTop 2,
      hscaled.eventually_ge_atTop 1] with m hm hscaled1
    have hlogpos : 0 < Real.log (m : ℝ) :=
      Real.log_pos (by exact_mod_cast (show 1 < m by omega))
    have hfloorone : 1 ≤ Nat.floor (d * Real.log (m : ℝ)) := by
      apply Nat.le_floor
      exact_mod_cast hscaled1
    have hdenpos : 0 < (2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) - 1 := by
      have : (2 : ℝ) ≤ 2 ^ Nat.floor (d * Real.log (m : ℝ)) := by
        simpa using pow_le_pow_right₀ one_le_two hfloorone
      linarith
    positivity
  · filter_upwards [eventually_gt_atTop 2,
      hpowtop.eventually_ge_atTop 4,
      hscaled.eventually_ge_atTop 1] with m hm hpow4 hscaled1
    have hmpos : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
    have hlogpos : 0 < Real.log (m : ℝ) :=
      Real.log_pos (by exact_mod_cast (show 1 < m by omega))
    have hxnonneg : 0 ≤ d * Real.log (m : ℝ) :=
      (mul_pos hdpos hlogpos).le
    have hfloorone : 1 ≤ Nat.floor (d * Real.log (m : ℝ)) := by
      apply Nat.le_floor
      exact_mod_cast hscaled1
    have hfloorlower : d * Real.log (m : ℝ) - 1 <
        (Nat.floor (d * Real.log (m : ℝ)) : ℝ) := by
      linarith [Nat.lt_floor_add_one (d * Real.log (m : ℝ))]
    have htwoLower :
        (m : ℝ) ^ (d * Real.log 2) / 2 <
          (2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) := by
      have hrpow := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1 : ℝ) < 2)
        hfloorlower
      rw [Real.rpow_natCast] at hrpow
      have heq : Real.rpow 2 (d * Real.log (m : ℝ) - 1) =
          (m : ℝ) ^ (d * Real.log 2) / 2 := by
        change (2 : ℝ) ^ (d * Real.log (m : ℝ) - 1) = _
        rw [Real.rpow_sub (by norm_num : (0 : ℝ) < 2), Real.rpow_one]
        congr 1
        rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2),
          Real.rpow_def_of_pos hmpos]
        congr 1
        ring
      calc
        (m : ℝ) ^ (d * Real.log 2) / 2 =
            Real.rpow 2 (d * Real.log (m : ℝ) - 1) := heq.symm
        _ < _ := hrpow
    have hdenlower : (m : ℝ) ^ (d * Real.log 2) / 4 ≤
        (2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) - 1 := by
      linarith
    have hdenpos : 0 < (2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) - 1 := by
      have : (2 : ℝ) ≤ 2 ^ Nat.floor (d * Real.log (m : ℝ)) := by
        simpa using pow_le_pow_right₀ one_le_two hfloorone
      linarith
    have hpowpos : 0 < (m : ℝ) ^ (d * Real.log 2) :=
      Real.rpow_pos_of_pos hmpos _
    calc
      (m : ℝ) / ((2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) - 1) ≤
          (m : ℝ) / ((m : ℝ) ^ (d * Real.log 2) / 4) :=
        div_le_div_of_nonneg_left hmpos.le (by positivity) hdenlower
      _ = 4 * (m : ℝ) ^ (1 - d * Real.log 2) := by
        rw [Real.rpow_sub hmpos]
        field_simp
        rw [Real.rpow_one]
  · exact hupper

/-- A logarithmic number of primes below the upper endpoint still has
product below the prescribed `exp (m^α)` cutoff when `θ < α`. -/
theorem eventually_primeWindow_product_lt_cutoff
    {θ α D₀ : ℝ} (hθ : 0 < θ) (hθα : θ < α) (hD₀ : 0 ≤ D₀) :
    ∀ᶠ m : ℕ in atTop,
      ∀ (L : ℕ) (T : Finset ↥(PrimeWindow.primes L (cutoff m θ))),
        T.card ≤ Nat.ceil (D₀ * Real.log (m : ℝ)) →
        ((((∏ i ∈ T, i.1 : ℕ) : ℕ) : ℝ) <
          Real.exp ((m : ℝ) ^ α)) := by
  have he : 0 < α - θ := sub_pos.mpr hθα
  have hpow : Tendsto (fun m : ℕ => (m : ℝ) ^ (α - θ)) atTop atTop :=
    (tendsto_rpow_atTop he).comp tendsto_natCast_atTop_atTop
  have hlogdivReal := (isLittleO_log_rpow_atTop he).tendsto_div_nhds_zero
  have hlogdiv : Tendsto (fun m : ℕ =>
      Real.log (m : ℝ) / (m : ℝ) ^ (α - θ)) atTop (𝓝 0) := by
    simpa only [Function.comp_def] using
      hlogdivReal.comp tendsto_natCast_atTop_atTop
  have hinv : Tendsto (fun m : ℕ =>
      1 / (m : ℝ) ^ (α - θ)) atTop (𝓝 0) := by
    simpa only [one_div, Function.comp_def] using
      (tendsto_inv_atTop_zero.comp hpow)
  have hpowθ : Tendsto (fun m : ℕ => (m : ℝ) ^ θ) atTop atTop :=
    (tendsto_rpow_atTop hθ).comp tendsto_natCast_atTop_atTop
  have hlogcut : Tendsto (fun m : ℕ =>
      Real.log (cutoff m θ : ℝ)) atTop atTop :=
    (log_cutoff_isEquivalent_rpow hθ).symm.tendsto_atTop hpowθ
  have hratio : Tendsto (fun m : ℕ =>
      (D₀ * Real.log (m : ℝ) + 1) / (m : ℝ) ^ (α - θ))
      atTop (𝓝 0) := by
    have := ((tendsto_const_nhds (x := D₀)).mul hlogdiv).add hinv
    convert this using 1
    · funext m
      ring
    · ring
  filter_upwards [eventually_gt_atTop 1,
      hratio.eventually (gt_mem_nhds (show (0 : ℝ) < 1 by norm_num)),
      hpow.eventually_gt_atTop 0,
      hlogcut.eventually_ge_atTop 1] with m hm hratio1 hpowpos hlogU
  intro L T hTcard
  let U := cutoff m θ
  have hUpos : 0 < U := by
    apply Nat.pos_of_ne_zero
    intro h
    change (1 : ℝ) ≤ Real.log (U : ℝ) at hlogU
    have hzero : Real.log (U : ℝ) = 0 := by simp [h]
    rw [hzero] at hlogU
    norm_num at hlogU
  have hUone : (1 : ℝ) ≤ U := by exact_mod_cast hUpos
  have hceil : (Nat.ceil (D₀ * Real.log (m : ℝ)) : ℝ) <
      D₀ * Real.log (m : ℝ) + 1 :=
    Nat.ceil_lt_add_one (mul_nonneg hD₀ (Real.log_nonneg (by exact_mod_cast hm.le)))
  have hKsmall : (Nat.ceil (D₀ * Real.log (m : ℝ)) : ℝ) *
      (m : ℝ) ^ θ < (m : ℝ) ^ α := by
    have hcoef : D₀ * Real.log (m : ℝ) + 1 <
        (m : ℝ) ^ (α - θ) := by
      rw [div_lt_one hpowpos] at hratio1
      exact hratio1
    have hmpos : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
    calc
      (Nat.ceil (D₀ * Real.log (m : ℝ)) : ℝ) * (m : ℝ) ^ θ <
          (D₀ * Real.log (m : ℝ) + 1) * (m : ℝ) ^ θ :=
        mul_lt_mul_of_pos_right hceil (Real.rpow_pos_of_pos hmpos _)
      _ < (m : ℝ) ^ (α - θ) * (m : ℝ) ^ θ :=
        mul_lt_mul_of_pos_right hcoef (Real.rpow_pos_of_pos hmpos _)
      _ = (m : ℝ) ^ α := by
        rw [← Real.rpow_add hmpos]
        congr 1
        ring
  have hprodU : (((∏ i ∈ T, i.1 : ℕ) : ℕ) : ℝ) ≤
      (U : ℝ) ^ T.card := by
    push_cast
    rw [show (U : ℝ) ^ T.card = ∏ _i ∈ T, (U : ℝ) by simp]
    apply Finset.prod_le_prod
    · intro i _
      positivity
    · intro i hi
      exact_mod_cast (PrimeWindow.mem_primes.mp i.2).2.1
  have hpowcard : (U : ℝ) ^ T.card ≤
      (U : ℝ) ^ Nat.ceil (D₀ * Real.log (m : ℝ)) :=
    pow_le_pow_right₀ hUone (hTcard.trans le_rfl)
  have hUexp : (U : ℝ) < Real.exp ((m : ℝ) ^ θ) := by
    exact le_cutoff_iff.mp (le_refl U)
  have hpowexp : (U : ℝ) ^ Nat.ceil (D₀ * Real.log (m : ℝ)) ≤
      Real.exp ((Nat.ceil (D₀ * Real.log (m : ℝ)) : ℝ) *
        (m : ℝ) ^ θ) := by
    calc
      (U : ℝ) ^ Nat.ceil (D₀ * Real.log (m : ℝ)) ≤
          (Real.exp ((m : ℝ) ^ θ)) ^
            Nat.ceil (D₀ * Real.log (m : ℝ)) :=
        pow_le_pow_left₀ (by positivity) hUexp.le _
      _ = _ := by rw [← Real.exp_nat_mul]
  exact (hprodU.trans hpowcard).trans_lt
    (hpowexp.trans_lt (Real.exp_lt_exp.mpr hKsmall))

/-- The three explicit error terms in Hall's density-one estimate vanish.
Keeping this analytic limit in a separate declaration also keeps elaboration of
the finite CRT argument within Lean's ordinary heartbeat budget. -/
private theorem tendsto_hall_density_one_error
    {lam θ d rlo rhi D₀ C : ℝ} {N : ℕ}
    (hlam : 0 < lam) (hlamθ : lam < θ)
    (hdcrit : criticalExponent < d)
    (hdlog : 1 < d * Real.log 2)
    (hrlo0 : 0 < rlo) (hrlo1 : rlo < 1) (hrhi : 1 < rhi)
    (hD₀ : 0 ≤ D₀) (hC : 0 ≤ C)
    (hkSave : 1 < lam * (N - 1 : ℕ)) :
    Tendsto (fun m : ℕ =>
      Real.exp
          ((rlo * ((1 - rlo) / (2 * rlo)) +
            (1 / (1 + ((1 - rlo) / (2 * rlo))) - 1)) *
            PrimeWindow.reciprocalMass (cutoff m lam) (cutoff m θ)) +
      2 * Real.exp
          (((-(rhi * ((rhi - 1) / (2 * rhi)))) +
            (1 / (1 - ((rhi - 1) / (2 * rhi))) - 1)) *
            PrimeWindow.reciprocalMass (cutoff m lam) (cutoff m θ)) +
      Real.exp
          (PrimeWindow.oddsMass (cutoff m lam) (cutoff m θ) -
            PrimeWindow.reciprocalMass (cutoff m lam) (cutoff m θ)) *
        ((m.totient : ℝ) /
            ((2 : ℝ) ^ Nat.floor (d * Real.log (m : ℝ)) - 1) +
          (Nat.ceil (D₀ * Real.log (m : ℝ)) : ℝ) *
            ((m.totient : ℝ) *
                (20 * C / Real.log (cutoff m lam : ℝ) ^ (N - 1)) /
              PrimeWindow.oddsMass (cutoff m lam) (cutoff m θ))))
      atTop (nhds 0) := by
  let L : ℕ → ℕ := fun m => cutoff m lam
  let U : ℕ → ℕ := fun m => cutoff m θ
  let EW : ℕ → ℝ := fun m => PrimeWindow.reciprocalMass (L m) (U m)
  let W : ℕ → ℝ := fun m => PrimeWindow.oddsMass (L m) (U m)
  let Kmin : ℕ → ℕ := fun m => Nat.floor (d * Real.log (m : ℝ))
  let Kmax : ℕ → ℕ := fun m => Nat.ceil (D₀ * Real.log (m : ℝ))
  let D : ℕ → ℝ := fun m => 20 * C / Real.log (L m : ℝ) ^ (N - 1)
  let c := θ - lam
  let clo := rlo * ((1 - rlo) / (2 * rlo)) +
    (1 / (1 + ((1 - rlo) / (2 * rlo))) - 1)
  let chi := (-(rhi * ((rhi - 1) / (2 * rhi)))) +
    (1 / (1 - ((rhi - 1) / (2 * rhi))) - 1)
  have hc : 0 < c := by dsimp [c]; linarith
  have hrecTop : Tendsto EW atTop atTop := by
    simpa [EW, L, U] using tendsto_reciprocalMass_cutoff_atTop hlam hlamθ
  have hoddsTop : Tendsto W atTop atTop := by
    simpa [W, L, U] using tendsto_oddsMass_cutoff_atTop hlam hlamθ
  have hoddsRatio : Tendsto (fun m : ℕ => W m / Real.log (m : ℝ))
      atTop (nhds c) := by
    simpa [W, L, U, c] using tendsto_oddsMass_cutoff_div_log hlam hlamθ
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hlogLtop : Tendsto (fun m : ℕ => Real.log (L m : ℝ)) atTop atTop := by
    have hpowlam : Tendsto (fun m : ℕ => (m : ℝ) ^ lam) atTop atTop :=
      (tendsto_rpow_atTop hlam).comp tendsto_natCast_atTop_atTop
    simpa [L] using (log_cutoff_isEquivalent_rpow hlam).symm.tendsto_atTop hpowlam
  have hclo : clo < 0 := Bernoulli.lower_exponent_neg hrlo0 hrlo1
  have hchi : chi < 0 := Bernoulli.upper_exponent_neg hrhi
  have htailLo : Tendsto (fun m => Real.exp (clo * EW m)) atTop (nhds 0) :=
    Real.tendsto_exp_atBot.comp (hrecTop.const_mul_atTop_of_neg hclo)
  have htailHi : Tendsto (fun m => 2 * Real.exp (chi * EW m)) atTop (nhds 0) := by
    simpa using tendsto_const_nhds.mul
      (Real.tendsto_exp_atBot.comp (hrecTop.const_mul_atTop_of_neg hchi))
  have hdiff : Tendsto (fun m => W m - EW m) atTop (nhds 0) := by
    apply squeeze_zero'
    · exact Eventually.of_forall fun m =>
        PrimeWindow.oddsMass_sub_reciprocalMass_nonneg (L m) (U m)
    · filter_upwards [hlogLtop.eventually_ge_atTop 1] with m hLm
      have hLone : 1 ≤ L m := by
        by_contra h
        have hLzero : L m = 0 := by omega
        norm_num [hLzero] at hLm
      exact PrimeWindow.oddsMass_sub_reciprocalMass_le hLone
    · have hLtop : Tendsto (fun m : ℕ => (L m : ℝ)) atTop atTop := by
        exact (Real.tendsto_exp_atTop.comp hlogLtop).congr' (by
          filter_upwards [hlogLtop.eventually_ge_atTop 1] with m hLm
          have hLpos : 0 < L m := by
            by_contra h
            have hLzero : L m = 0 := by omega
            norm_num [hLzero] at hLm
          change Real.exp (Real.log (L m : ℝ)) = (L m : ℝ)
          exact Real.exp_log (by exact_mod_cast hLpos))
      simpa [one_div, Function.comp_def] using tendsto_inv_atTop_zero.comp hLtop
  have hexpdiff : Tendsto (fun m => Real.exp (W m - EW m)) atTop (nhds 1) := by
    convert Real.continuous_exp.continuousAt.tendsto.comp hdiff using 1
    · funext m
      rfl
    · norm_num
  have hgroup : Tendsto (fun m =>
      (m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1)) atTop (nhds 0) := by
    have hmain := tendsto_natCast_div_two_pow_floor_log hdlog
    apply squeeze_zero'
    · filter_upwards [hlog.eventually_ge_atTop 1] with m hlogm
      have hkm : 1 ≤ Kmin m := by
        dsimp [Kmin]
        apply Nat.le_floor
        exact_mod_cast (show (1 : ℝ) ≤ d * Real.log (m : ℝ) by
          have : 1 < d := one_lt_criticalExponent.trans hdcrit
          nlinarith)
      have hden : 0 < (2 : ℝ) ^ Kmin m - 1 := by
        have htwo : (2 : ℝ) ≤ 2 ^ Kmin m := by
          simpa using pow_le_pow_right₀ one_le_two hkm
        linarith
      positivity
    · filter_upwards [hlog.eventually_ge_atTop 1] with m hlogm
      have hkm : 1 ≤ Kmin m := by
        dsimp [Kmin]
        apply Nat.le_floor
        exact_mod_cast (show (1 : ℝ) ≤ d * Real.log (m : ℝ) by
          have : 1 < d := one_lt_criticalExponent.trans hdcrit
          nlinarith)
      have hden : 0 < (2 : ℝ) ^ Kmin m - 1 := by
        have : (2 : ℝ) ≤ 2 ^ Kmin m := by
          simpa using pow_le_pow_right₀ one_le_two hkm
        linarith
      have htot : (m.totient : ℝ) ≤ (m : ℝ) := by
        exact_mod_cast Nat.totient_le m
      exact div_le_div_of_nonneg_right htot hden.le
    · simpa [Kmin] using hmain
  have hWlower : ∀ᶠ m : ℕ in atTop,
      (c / 2) * Real.log (m : ℝ) ≤ W m := by
    have hratio : ∀ᶠ m : ℕ in atTop,
        c / 2 < W m / Real.log (m : ℝ) :=
      hoddsRatio.eventually (Ioi_mem_nhds (by linarith : c / 2 < c))
    filter_upwards [hratio, hlog.eventually_gt_atTop 0] with m hm hlogm
    rw [lt_div_iff₀ hlogm] at hm
    exact hm.le
  have hresidue : Tendsto (fun m =>
      (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m))
      atTop (nhds 0) := by
    have hsave := tendsto_natCast_div_log_cutoff_pow hlam hkSave
    let A : ℝ := 40 * C * (D₀ + 1) / c
    have hupper : Tendsto (fun m : ℕ =>
        A * ((m : ℝ) / Real.log (L m : ℝ) ^ (N - 1)))
        atTop (nhds 0) := by
      simpa [L] using tendsto_const_nhds.mul hsave
    apply squeeze_zero'
    · filter_upwards [hoddsTop.eventually_gt_atTop 0] with m hWm
      dsimp [D]
      positivity
    · filter_upwards [eventually_gt_atTop 1, hlog.eventually_ge_atTop 1,
        hoddsTop.eventually_gt_atTop 0, hWlower,
        hlogLtop.eventually_ge_atTop 1] with m hm hlogm hWm hWlo hlogLm
      have hceil : (Kmax m : ℝ) < D₀ * Real.log (m : ℝ) + 1 := by
        dsimp [Kmax]
        exact Nat.ceil_lt_add_one
          (mul_nonneg hD₀ (Real.log_nonneg (by exact_mod_cast hm.le)))
      have hKbound : (Kmax m : ℝ) ≤ (D₀ + 1) * Real.log (m : ℝ) := by
        calc
          (Kmax m : ℝ) ≤ D₀ * Real.log (m : ℝ) + 1 := hceil.le
          _ ≤ D₀ * Real.log (m : ℝ) + Real.log (m : ℝ) :=
            by simpa [add_comm] using add_le_add_right hlogm
          _ = _ := by ring
      have htot : (m.totient : ℝ) ≤ (m : ℝ) := by
        exact_mod_cast Nat.totient_le m
      have hc2 : 0 < c / 2 := by positivity
      have hKW : (Kmax m : ℝ) / W m ≤ 2 * (D₀ + 1) / c := by
        have hden : 0 < (c / 2) * Real.log (m : ℝ) :=
          mul_pos hc2 (lt_of_lt_of_le zero_lt_one hlogm)
        calc
          (Kmax m : ℝ) / W m ≤
              (Kmax m : ℝ) / ((c / 2) * Real.log (m : ℝ)) :=
            div_le_div_of_nonneg_left (by positivity) hden hWlo
          _ ≤ ((D₀ + 1) * Real.log (m : ℝ)) /
                ((c / 2) * Real.log (m : ℝ)) :=
            div_le_div_of_nonneg_right hKbound hden.le
          _ = 2 * (D₀ + 1) / c := by field_simp
      dsimp [D, A]
      have hnonneg : 0 ≤ 20 * C / Real.log (L m : ℝ) ^ (N - 1) := by positivity
      calc
        (Kmax m : ℝ) *
            ((m.totient : ℝ) *
              (20 * C / Real.log (L m : ℝ) ^ (N - 1)) / W m) =
          ((Kmax m : ℝ) / W m) * (m.totient : ℝ) *
              (20 * C / Real.log (L m : ℝ) ^ (N - 1)) := by ring
        _ ≤ (2 * (D₀ + 1) / c) * (m : ℝ) *
              (20 * C / Real.log (L m : ℝ) ^ (N - 1)) := by
          gcongr
        _ = (40 * C * (D₀ + 1) / c) *
              ((m : ℝ) / Real.log (L m : ℝ) ^ (N - 1)) := by ring
    · exact hupper
  have hmiddle : Tendsto (fun m =>
      Real.exp (W m - EW m) *
        ((m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1) +
          (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m)))
      atTop (nhds 0) := by
    simpa using hexpdiff.mul (hgroup.add hresidue)
  have herr : Tendsto (fun m =>
      Real.exp (clo * EW m) + 2 * Real.exp (chi * EW m) +
        Real.exp (W m - EW m) *
          ((m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1) +
            (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m)))
      atTop (nhds 0) := by
    simpa only [zero_add] using (htailLo.add htailHi).add hmiddle
  simpa [L, U, EW, W, Kmin, Kmax, D, clo, chi] using herr

/-- Hall's density-one half above the critical exponent. -/
theorem tendsto_delta_one_of_critical_lt {α : ℝ}
    (hα : criticalExponent < α) :
    Tendsto (δ · α) atTop (𝓝 1) := by
  let gap := α - criticalExponent
  let lam := gap / 4
  let θ := criticalExponent + gap / 2
  let c := θ - lam
  let d := (criticalExponent + c) / 2
  let rlo := (d / c + 1) / 2
  let rhi : ℝ := 2
  let D₀ := 3 * c
  have hgap : 0 < gap := by dsimp [gap]; linarith
  have hlam : 0 < lam := by dsimp [lam]; positivity
  have hcritpos : 0 < criticalExponent :=
    lt_trans zero_lt_one one_lt_criticalExponent
  have hθ : 0 < θ := by dsimp [θ]; positivity
  have hlamθ : lam < θ := by
    dsimp [lam, θ, gap]
    linarith [one_lt_criticalExponent]
  have hθα : θ < α := by dsimp [θ, gap]; linarith
  have hc : 0 < c := by dsimp [c]; linarith
  have hccrit : criticalExponent < c := by
    dsimp [c, θ, lam, gap]
    linarith
  have hdcrit : criticalExponent < d := by dsimp [d]; linarith
  have hdc : d < c := by dsimp [d]; linarith
  have hdpos : 0 < d := hcritpos.trans hdcrit
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hcritlog : criticalExponent * Real.log 2 = 1 := by
    dsimp [criticalExponent]
    field_simp [hlogtwo.ne']
  have hdlog : 1 < d * Real.log 2 := by
    nlinarith [mul_lt_mul_of_pos_right hdcrit hlogtwo]
  have hrlo0 : 0 < rlo := by
    dsimp [rlo]
    have : 0 < d / c := div_pos hdpos hc
    positivity
  have hrlo1 : rlo < 1 := by
    dsimp [rlo]
    have : d / c < 1 := (div_lt_one hc).mpr hdc
    linarith
  have hdrlo : d < rlo * c := by
    dsimp [rlo]
    have hcne := hc.ne'
    field_simp [hcne]
    linarith
  have hrhi : 1 < rhi := by norm_num [rhi]
  have hD₀ : 0 ≤ D₀ := by dsimp [D₀]; positivity
  have hrhicD : rhi * c < D₀ := by dsimp [rhi, D₀]; linarith
  obtain ⟨k, hk⟩ := exists_nat_gt (1 / lam)
  let N := k + 2
  have hN : 2 ≤ N := by simp [N]
  have hkSave : 1 < lam * (N - 1 : ℕ) := by
    have hlamne := hlam.ne'
    have hkR : 1 / lam < (k : ℝ) := by exact_mod_cast hk
    dsimp [N]
    push_cast
    have : 1 < lam * (k : ℝ) := by
      rw [div_lt_iff₀ hlam] at hkR
      simpa [one_mul, mul_comm] using hkR
    nlinarith
  obtain ⟨C, hC, hpointEventually⟩ :=
    exists_eventually_weighted_residue_error hlam hlamθ N hN
  let L : ℕ → ℕ := fun m => cutoff m lam
  let U : ℕ → ℕ := fun m => cutoff m θ
  let EW : ℕ → ℝ := fun m => PrimeWindow.reciprocalMass (L m) (U m)
  let W : ℕ → ℝ := fun m => PrimeWindow.oddsMass (L m) (U m)
  let Kmin : ℕ → ℕ := fun m => Nat.floor (d * Real.log (m : ℝ))
  let Kmax : ℕ → ℕ := fun m => Nat.ceil (D₀ * Real.log (m : ℝ))
  let D : ℕ → ℝ := fun m =>
    20 * C / Real.log (L m : ℝ) ^ (N - 1)
  have hrecRatio : Tendsto (fun m : ℕ => EW m / Real.log (m : ℝ))
      atTop (𝓝 c) := by
    simpa [EW, L, U, c] using
      tendsto_reciprocalMass_cutoff_div_log hlam hlamθ
  have hoddsRatio : Tendsto (fun m : ℕ => W m / Real.log (m : ℝ))
      atTop (𝓝 c) := by
    simpa [W, L, U, c] using tendsto_oddsMass_cutoff_div_log hlam hlamθ
  have hrecTop : Tendsto EW atTop atTop := by
    simpa [EW, L, U] using tendsto_reciprocalMass_cutoff_atTop hlam hlamθ
  have hoddsTop : Tendsto W atTop atTop := by
    simpa [W, L, U] using tendsto_oddsMass_cutoff_atTop hlam hlamθ
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hscaledD : Tendsto (fun m : ℕ => D₀ * Real.log (m : ℝ))
      atTop atTop := hlog.const_mul_atTop (by dsimp [D₀]; positivity)
  have hcutProduct := eventually_primeWindow_product_lt_cutoff hθ hθα hD₀
  have hquarter := eventually_natCast_le_cutoff_rpow_quarter hlam
  have hratioLo : ∀ᶠ m : ℕ in atTop, d / rlo < EW m / Real.log (m : ℝ) :=
    hrecRatio.eventually (by
      apply Ioi_mem_nhds
      rw [div_lt_iff₀ hrlo0]
      simpa [mul_comm] using hdrlo)
  have hratioHi : ∀ᶠ m : ℕ in atTop,
      EW m / Real.log (m : ℝ) < D₀ / rhi :=
    hrecRatio.eventually (by
      apply Iio_mem_nhds
      rw [lt_div_iff₀ (lt_trans zero_lt_one hrhi)]
      simpa [mul_comm] using hrhicD)
  have hpoint : ∀ᶠ m : ℕ in atTop,
      4 ≤ L m ∧ L m ≤ U m ∧ 1 ≤ Real.log (L m : ℝ) ∧
      ∀ a ∈ BoundedGaps.Maynard.coprimeResidues m,
        |PrimeWindow.residueOddsMass (L m) (U m) m a -
          W m / (m.totient : ℝ)| ≤ D m := by
    simpa [L, U, W, D] using hpointEventually
  have hfinite : ∀ᶠ m : ℕ in atTop,
      1 - δ m α ≤
        Real.exp
            ((rlo * ((1 - rlo) / (2 * rlo)) +
              (1 / (1 + ((1 - rlo) / (2 * rlo))) - 1)) * EW m) +
        2 * Real.exp
            (((-(rhi * ((rhi - 1) / (2 * rhi)))) +
              (1 / (1 - ((rhi - 1) / (2 * rhi))) - 1)) * EW m) +
        Real.exp (W m - EW m) *
          ((m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1) +
            (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m)) := by
    filter_upwards [eventually_gt_atTop 1, hlog.eventually_ge_atTop 1,
      hscaledD.eventually_ge_atTop 1, hrecTop.eventually_gt_atTop 0,
      hoddsTop.eventually_gt_atTop 0, hratioLo, hratioHi, hpoint,
      hquarter, hcutProduct] with m hm hlogm hDlog hEWpos hWpos
        hlo hhi hp hq hprod
    have hmpos : 0 < m := by omega
    have hcop : ∀ p ∈ PrimeWindow.primes (L m) (U m), Nat.Coprime p m := by
      intro p hpP
      have hpL := (PrimeWindow.mem_primes.mp hpP).1
      have hLm : (m : ℝ) < L m := by
        have hL4 : (4 : ℝ) ≤ L m := by exact_mod_cast hp.1
        have hpowlt : Real.rpow (L m : ℝ) (1 / 4 : ℝ) < (L m : ℝ) := by
          have := Real.rpow_lt_rpow_of_exponent_lt (by linarith : (1 : ℝ) < L m)
            (by norm_num : (1 / 4 : ℝ) < 1)
          simpa using this
        exact lt_of_le_of_lt hq hpowlt
      apply (PrimeWindow.mem_primes.mp hpP).2.2.coprime_iff_not_dvd.mpr
      intro hdiv
      have : p ≤ m := Nat.le_of_dvd hmpos hdiv
      have hmLnat : m < L m := by exact_mod_cast hLm
      have : m < p := hmLnat.trans hpL
      omega
    have hKmin1 : 1 ≤ Kmin m := by
      dsimp [Kmin]
      apply Nat.le_floor
      have : (1 : ℝ) ≤ d * Real.log (m : ℝ) := by
        have hdcrit1 : 1 < d := one_lt_criticalExponent.trans hdcrit
        nlinarith
      exact_mod_cast this
    have hKlo : (Kmin m : ℝ) ≤ rlo * EW m := by
      have hmreal : (1 : ℝ) ≤ m := by exact_mod_cast hm.le
      have hfloor := Nat.floor_le (mul_nonneg hdpos.le (Real.log_nonneg hmreal))
      have hlogpos : 0 < Real.log (m : ℝ) := Real.log_pos (by exact_mod_cast hm)
      have : d * Real.log (m : ℝ) < rlo * EW m := by
        have hlo' : d / rlo * Real.log (m : ℝ) < EW m :=
          (lt_div_iff₀ hlogpos).mp hlo
        have hlo'' : d * Real.log (m : ℝ) / rlo < EW m := by
          simpa [div_mul_eq_mul_div] using hlo'
        simpa [mul_comm] using (div_lt_iff₀ hrlo0).mp hlo''
      exact hfloor.trans this.le
    have hKhi : rhi * EW m ≤ (Kmax m + 1 : ℕ) := by
      have hlogpos : 0 < Real.log (m : ℝ) := Real.log_pos (by exact_mod_cast hm)
      have hsmall : rhi * EW m < D₀ * Real.log (m : ℝ) := by
        rw [div_lt_iff₀ hlogpos] at hhi
        calc
          rhi * EW m < rhi * ((D₀ / rhi) * Real.log (m : ℝ)) :=
            mul_lt_mul_of_pos_left hhi (lt_trans zero_lt_one hrhi)
          _ = D₀ * Real.log (m : ℝ) := by
            field_simp [ne_of_gt (lt_trans zero_lt_one hrhi)]
      have hceil : D₀ * Real.log (m : ℝ) ≤ (Kmax m : ℝ) := by
        exact Nat.le_ceil _
      exact_mod_cast (show rhi * EW m ≤ (Kmax m : ℝ) + 1 by linarith)
    have hKK : Kmin m ≤ Kmax m := by
      have hmreal : (1 : ℝ) ≤ m := by exact_mod_cast hm.le
      have hfloor := Nat.floor_le (mul_nonneg hdpos.le (Real.log_nonneg hmreal))
      have hdD : d ≤ D₀ := by dsimp [D₀]; linarith
      have hceil : D₀ * Real.log (m : ℝ) ≤ (Kmax m : ℝ) := Nat.le_ceil _
      exact_mod_cast hfloor.trans ((mul_le_mul_of_nonneg_right hdD
        (Real.log_nonneg hmreal)).trans hceil)
    have hDbound : 0 ≤ D m := by dsimp [D]; positivity
    apply one_sub_delta_le_primeWindow_error hmpos α hcop hDbound hp.2.2.2
      hEWpos hWpos hKmin1 hKK hrlo0 hrlo1 hKlo hrhi hKhi
    intro T hTne hTcard
    exact hprod (L m) T hTcard
  /-
  The limit calculation below was factored into
  `tendsto_hall_density_one_error` so that the finite CRT estimate and its
  asymptotic analysis elaborate as separate declarations.
  let clo := rlo * ((1 - rlo) / (2 * rlo)) +
    (1 / (1 + ((1 - rlo) / (2 * rlo))) - 1)
  let chi := (-(rhi * ((rhi - 1) / (2 * rhi)))) +
    (1 / (1 - ((rhi - 1) / (2 * rhi))) - 1)
  have hclo : clo < 0 := Bernoulli.lower_exponent_neg hrlo0 hrlo1
  have hchi : chi < 0 := Bernoulli.upper_exponent_neg hrhi
  have htailLo : Tendsto (fun m => Real.exp (clo * EW m)) atTop (𝓝 0) :=
    Real.tendsto_exp_atBot.comp (hrecTop.const_mul_atTop_of_neg hclo)
  have htailHi : Tendsto (fun m => 2 * Real.exp (chi * EW m)) atTop (𝓝 0) := by
    simpa using tendsto_const_nhds.mul
      (Real.tendsto_exp_atBot.comp (hrecTop.const_mul_atTop_of_neg hchi))
  have hdiff : Tendsto (fun m => W m - EW m) atTop (𝓝 0) := by
    apply squeeze_zero'
    · exact Eventually.of_forall fun m =>
        PrimeWindow.oddsMass_sub_reciprocalMass_nonneg (L m) (U m)
    · filter_upwards [hpoint] with m hp
      exact PrimeWindow.oddsMass_sub_reciprocalMass_le (by omega : 1 ≤ L m)
    · have hpowlam : Tendsto (fun m : ℕ => (m : ℝ) ^ lam) atTop atTop :=
        (tendsto_rpow_atTop hlam).comp tendsto_natCast_atTop_atTop
      have hlogLtop : Tendsto (fun m : ℕ => Real.log (L m : ℝ)) atTop atTop := by
        simpa [L] using (log_cutoff_isEquivalent_rpow hlam).symm.tendsto_atTop hpowlam
      have hLtop : Tendsto (fun m : ℕ => (L m : ℝ)) atTop atTop := by
        exact (Real.tendsto_exp_atTop.comp hlogLtop).congr' (by
          filter_upwards [hpoint] with m hp
          change Real.exp (Real.log (L m : ℝ)) = (L m : ℝ)
          exact Real.exp_log (by exact_mod_cast (show 0 < L m by omega)))
      simpa [one_div, Function.comp_def] using tendsto_inv_atTop_zero.comp hLtop
  have hexpdiff : Tendsto (fun m => Real.exp (W m - EW m)) atTop (𝓝 1) := by
    convert Real.continuous_exp.continuousAt.tendsto.comp hdiff using 1
    · funext m
      rfl
    · norm_num
  have hgroup : Tendsto (fun m =>
      (m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1)) atTop (𝓝 0) := by
    have hmain := tendsto_natCast_div_two_pow_floor_log hdlog
    apply squeeze_zero'
    · filter_upwards [hlog.eventually_ge_atTop 1] with m hlogm
      have hkm : 1 ≤ Kmin m := by
        dsimp [Kmin]
        apply Nat.le_floor
        exact_mod_cast (show (1 : ℝ) ≤ d * Real.log (m : ℝ) by
          have : 1 < d := one_lt_criticalExponent.trans hdcrit
          nlinarith)
      have hden : 0 < (2 : ℝ) ^ Kmin m - 1 := by
        have htwo : (2 : ℝ) ≤ 2 ^ Kmin m := by
          simpa using pow_le_pow_right₀ one_le_two hkm
        linarith
      positivity
    · filter_upwards [hlog.eventually_ge_atTop 1] with m hlogm
      have hkm : 1 ≤ Kmin m := by
        dsimp [Kmin]
        apply Nat.le_floor
        exact_mod_cast (show (1 : ℝ) ≤ d * Real.log (m : ℝ) by
          have : 1 < d := one_lt_criticalExponent.trans hdcrit
          nlinarith)
      have hden : 0 < (2 : ℝ) ^ Kmin m - 1 := by
        have : (2 : ℝ) ≤ 2 ^ Kmin m := by
          simpa using pow_le_pow_right₀ one_le_two hkm
        linarith
      have htot : (m.totient : ℝ) ≤ (m : ℝ) := by
        exact_mod_cast Nat.totient_le m
      exact div_le_div_of_nonneg_right htot hden.le
    · simpa [Kmin] using hmain
  have hWlower : ∀ᶠ m : ℕ in atTop,
      (c / 2) * Real.log (m : ℝ) ≤ W m := by
    have hratio : ∀ᶠ m : ℕ in atTop,
        c / 2 < W m / Real.log (m : ℝ) :=
      hoddsRatio.eventually (Ioi_mem_nhds (by linarith : c / 2 < c))
    filter_upwards [hratio, hlog.eventually_gt_atTop 0] with m hm hlogm
    rw [lt_div_iff₀ hlogm] at hm
    exact hm.le
  have hresidue : Tendsto (fun m =>
      (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m))
      atTop (𝓝 0) := by
    have hsave := tendsto_natCast_div_log_cutoff_pow hlam hkSave
    let A : ℝ := 40 * C * (D₀ + 1) / c
    have hA : 0 ≤ A := by dsimp [A]; positivity
    have hupper : Tendsto (fun m : ℕ =>
        A * ((m : ℝ) / Real.log (L m : ℝ) ^ (N - 1)))
        atTop (𝓝 0) := by
      simpa [L] using (tendsto_const_nhds.mul hsave)
    apply squeeze_zero'
    · filter_upwards [hoddsTop.eventually_gt_atTop 0, hpoint] with m hWm hp
      dsimp [D]
      positivity
    · filter_upwards [eventually_gt_atTop 1, hlog.eventually_ge_atTop 1,
        hoddsTop.eventually_gt_atTop 0, hWlower, hpoint] with m hm hlogm
          hWm hWlo hp
      have hceil : (Kmax m : ℝ) < D₀ * Real.log (m : ℝ) + 1 := by
        dsimp [Kmax]
        exact Nat.ceil_lt_add_one (mul_nonneg hD₀ (Real.log_nonneg (by exact_mod_cast hm.le)))
      have hKbound : (Kmax m : ℝ) ≤ (D₀ + 1) * Real.log (m : ℝ) := by
        calc
          (Kmax m : ℝ) ≤ D₀ * Real.log (m : ℝ) + 1 := hceil.le
          _ ≤ D₀ * Real.log (m : ℝ) + Real.log (m : ℝ) :=
            by simpa [add_comm] using add_le_add_right hlogm
          _ = _ := by ring
      have htot : (m.totient : ℝ) ≤ (m : ℝ) := by
        exact_mod_cast Nat.totient_le m
      have hlogLpos : 0 < Real.log (L m : ℝ) := lt_of_lt_of_le zero_lt_one hp.2.2.1
      have hc2 : 0 < c / 2 := by positivity
      have hKW : (Kmax m : ℝ) / W m ≤ 2 * (D₀ + 1) / c := by
        have hden : 0 < (c / 2) * Real.log (m : ℝ) := mul_pos hc2 (lt_of_lt_of_le zero_lt_one hlogm)
        calc
          (Kmax m : ℝ) / W m ≤
              (Kmax m : ℝ) / ((c / 2) * Real.log (m : ℝ)) :=
            div_le_div_of_nonneg_left (by positivity) hden hWlo
          _ ≤
              ((D₀ + 1) * Real.log (m : ℝ)) /
                ((c / 2) * Real.log (m : ℝ)) :=
            div_le_div_of_nonneg_right hKbound hden.le
          _ = 2 * (D₀ + 1) / c := by field_simp
      dsimp [D, A]
      have hnonneg : 0 ≤ 20 * C / Real.log (L m : ℝ) ^ (N - 1) := by positivity
      calc
        (Kmax m : ℝ) *
            ((m.totient : ℝ) *
              (20 * C / Real.log (L m : ℝ) ^ (N - 1)) / W m) =
          ((Kmax m : ℝ) / W m) * (m.totient : ℝ) *
              (20 * C / Real.log (L m : ℝ) ^ (N - 1)) := by ring
        _ ≤ (2 * (D₀ + 1) / c) * (m : ℝ) *
              (20 * C / Real.log (L m : ℝ) ^ (N - 1)) := by
          gcongr
        _ = (40 * C * (D₀ + 1) / c) *
              ((m : ℝ) / Real.log (L m : ℝ) ^ (N - 1)) := by ring
    · exact hupper
  have hmiddle : Tendsto (fun m =>
      Real.exp (W m - EW m) *
        ((m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1) +
          (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m)))
      atTop (𝓝 0) := by
    simpa using hexpdiff.mul (hgroup.add hresidue)
  have herr : Tendsto (fun m =>
      Real.exp (clo * EW m) + 2 * Real.exp (chi * EW m) +
        Real.exp (W m - EW m) *
          ((m.totient : ℝ) / ((2 : ℝ) ^ Kmin m - 1) +
            (Kmax m : ℝ) * ((m.totient : ℝ) * D m / W m)))
      atTop (𝓝 0) := by
    simpa only [zero_add] using (htailLo.add htailHi).add hmiddle
  -/
  have herr := tendsto_hall_density_one_error hlam hlamθ hdcrit hdlog
    hrlo0 hrlo1 hrhi hD₀ hC hkSave
  have honeMinus : Tendsto (fun m : ℕ => 1 - δ m α) atTop (𝓝 0) := by
    apply squeeze_zero'
    · exact Eventually.of_forall fun m => sub_nonneg.mpr (delta_le_one m α)
    · exact hfinite
    · simpa [L, U, EW, W, Kmin, Kmax, D, one_div] using herr
  have hfinal : Tendsto (fun m : ℕ => (1 : ℝ) - (1 - δ m α)) atTop (nhds (1 - 0)) :=
    (tendsto_const_nhds (x := (1 : ℝ))).sub honeMinus
  convert hfinal using 1
  · funext m
    exact (sub_sub_cancel (1 : ℝ) (δ m α)).symm
  · norm_num

/-! ## The density-zero half at the sharp threshold -/

theorem two_pow_ceil_le_two_mul_exp {x : ℝ} (hx : 0 ≤ x) :
    (2 : ℝ) ^ Nat.ceil x ≤ 2 * Real.exp (Real.log 2 * x) := by
  have hceil : (Nat.ceil x : ℝ) < x + 1 := Nat.ceil_lt_add_one hx
  have hlogpos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  calc
    (2 : ℝ) ^ Nat.ceil x = Real.exp (Real.log 2 * (Nat.ceil x : ℝ)) := by
      rw [← Real.rpow_natCast]
      rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2)]
    _ ≤ Real.exp (Real.log 2 * (x + 1)) := by
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonneg_left hceil.le hlogpos.le
    _ = 2 * Real.exp (Real.log 2 * x) := by
      rw [show Real.log 2 * (x + 1) = Real.log 2 + Real.log 2 * x by ring,
        Real.exp_add, Real.exp_log (by norm_num)]

private theorem tendsto_loglog_sq_mul_exp_neg {b : ℝ} (hb : 0 < b) :
    Tendsto (fun m : ℕ =>
      Real.log (Real.log (m : ℝ)) ^ 2 *
        Real.exp (-b * Real.log (Real.log (m : ℝ))))
      atTop (𝓝 0) := by
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hLL : Tendsto (fun m : ℕ => Real.log (Real.log (m : ℝ)))
      atTop atTop := by
    simpa [Function.comp_def] using Real.tendsto_log_atTop.comp hlog
  have h :=
    (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero 2 b hb).comp hLL
  convert h using 1
  funext m
  simp only [Function.comp_apply, Real.rpow_two, neg_mul]

private theorem tendsto_log_rpow_mul_exp_neg {s b : ℝ} (hb : 0 < b) :
    Tendsto (fun m : ℕ =>
      Real.log (m : ℝ) ^ s * Real.exp (-b * Real.log (m : ℝ)))
      atTop (𝓝 0) := by
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  exact (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero s b hb).comp hlog

private theorem critical_mul_log_two :
    criticalExponent * Real.log 2 = 1 := by
  have hlog : Real.log (2 : ℝ) ≠ 0 := (Real.log_pos (by norm_num)).ne'
  simp [criticalExponent, hlog]

private theorem upperTail_eq_exp_neg_rate {r x : ℝ} (hr : 1 < r) :
    UpperBound.upperTail r x =
      Real.exp (-((r - 1) ^ 2 / (2 * (r + 1))) * x) := by
  have hr0 : r ≠ 0 := ne_of_gt (lt_trans zero_lt_one hr)
  have hrn1 : r + 1 ≠ 0 := by linarith
  have h1rn : 1 + r ≠ 0 := by linarith
  have hden : 1 - ((r - 1) / (2 * r)) = (r + 1) / (2 * r) := by
    field_simp [hr0]
    ring
  have hcoeff :
      (-(r * ((r - 1) / (2 * r))) +
          (1 / (1 - ((r - 1) / (2 * r))) - 1)) =
        -((r - 1) ^ 2 / (2 * (r + 1))) := by
    rw [hden]
    field_simp [hr0, hrn1, h1rn]
    ring
  unfold UpperBound.upperTail
  rw [hcoeff]

private theorem upperTail_le_exp_neg_rate_mul {r x z : ℝ}
    (hr : 1 < r) (hzx : z ≤ x) :
    UpperBound.upperTail r x ≤
      Real.exp (-((r - 1) ^ 2 / (2 * (r + 1))) * z) := by
  rw [upperTail_eq_exp_neg_rate hr]
  apply Real.exp_le_exp.mpr
  have hmul := mul_le_mul_of_nonneg_left hzx
    (by positivity : 0 ≤ (r - 1) ^ 2 / (2 * (r + 1)))
  calc
    -((r - 1) ^ 2 / (2 * (r + 1))) * x =
        -(((r - 1) ^ 2 / (2 * (r + 1))) * x) := by ring
    _ ≤ -(((r - 1) ^ 2 / (2 * (r + 1))) * z) := neg_le_neg hmul
    _ = -((r - 1) ^ 2 / (2 * (r + 1))) * z := by ring

private theorem tendsto_reciprocalMass_floorLog_cube_div_loglog :
    Tendsto (fun m : ℕ =>
      PrimeWindow.reciprocalMass
          (Nat.floor (Real.log (m : ℝ) / 100)) (m ^ 3) /
        Real.log (Real.log (m : ℝ))) atTop (𝓝 1) := by
  have hcube := tendsto_primeHarmonic_cube_div_loglog
  have hsmall := tendsto_primeHarmonic_floorLog_div_loglog
  have hsub := hcube.sub hsmall
  have heq : (fun m : ℕ =>
      PrimeHarmonic.sum (m ^ 3) / Real.log (Real.log (m : ℝ)) -
        PrimeHarmonic.sum (Nat.floor (Real.log (m : ℝ) / 100)) /
          Real.log (Real.log (m : ℝ))) =ᶠ[atTop]
      (fun m : ℕ =>
        PrimeWindow.reciprocalMass
            (Nat.floor (Real.log (m : ℝ) / 100)) (m ^ 3) /
          Real.log (Real.log (m : ℝ))) := by
    filter_upwards [eventually_ge_atTop 2,
      (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop).eventually_ge_atTop 0]
      with m hm hlog
    have hRP : Nat.floor (Real.log (m : ℝ) / 100) ≤ m ^ 3 := by
      have hfloor : ((Nat.floor (Real.log (m : ℝ) / 100) : ℕ) : ℝ) ≤
          Real.log (m : ℝ) / 100 := Nat.floor_le (by positivity)
      have hlogle : Real.log (m : ℝ) ≤ m := Real.log_le_sub_one_of_pos
        (by positivity) |>.trans (by linarith)
      have hmpow : (m : ℝ) ≤ (m ^ 3 : ℕ) := by exact_mod_cast
        (show m ≤ m ^ 3 from Nat.le_pow (by omega))
      have hlog0 : 0 ≤ Real.log (m : ℝ) := by
        simpa [Function.comp_apply] using hlog
      have hreal : ((Nat.floor (Real.log (m : ℝ) / 100) : ℕ) : ℝ) ≤
          (m ^ 3 : ℕ) := hfloor.trans <| calc
        Real.log (m : ℝ) / 100 ≤ Real.log (m : ℝ) := by linarith
        _ ≤ (m : ℝ) := hlogle
        _ ≤ (m ^ 3 : ℕ) := hmpow
      exact_mod_cast hreal
    rw [PrimeWindow.reciprocalMass_eq_sub hRP]
    ring
  simpa using hsub.congr' heq

private theorem tendsto_primeHarmonic_cube_div_log :
    Tendsto (fun m : ℕ => PrimeHarmonic.sum (m ^ 3) /
      Real.log (m : ℝ)) atTop (𝓝 0) := by
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hratio : Tendsto (fun m : ℕ =>
      Real.log (Real.log (m : ℝ)) / Real.log (m : ℝ)) atTop (𝓝 0) := by
    simpa [Function.comp_def] using
      Real.isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp hlog
  have h := tendsto_primeHarmonic_cube_div_loglog.mul hratio
  have heq : (fun m : ℕ =>
      PrimeHarmonic.sum (m ^ 3) / Real.log (Real.log (m : ℝ)) *
        (Real.log (Real.log (m : ℝ)) / Real.log (m : ℝ))) =ᶠ[atTop]
      (fun m : ℕ => PrimeHarmonic.sum (m ^ 3) / Real.log (m : ℝ)) := by
    filter_upwards [hlog.eventually_gt_atTop 1] with m hm
    have hLL : Real.log (Real.log (m : ℝ)) ≠ 0 :=
      (Real.log_pos hm).ne'
    field_simp
  simpa using h.congr' heq

private theorem tendsto_reciprocalMass_cube_cutoff_div_log
    {α : ℝ} (hα : 0 < α) :
    Tendsto (fun m : ℕ =>
      PrimeWindow.reciprocalMass (m ^ 3) (cutoff m α) /
        Real.log (m : ℝ)) atTop (𝓝 α) := by
  have hmain := tendsto_primeHarmonic_cutoff_div_log hα
  have hsmall := tendsto_primeHarmonic_cube_div_log
  have hsub := hmain.sub hsmall
  have heq : (fun m : ℕ =>
      PrimeHarmonic.sum (cutoff m α) / Real.log (m : ℝ) -
        PrimeHarmonic.sum (m ^ 3) / Real.log (m : ℝ)) =ᶠ[atTop]
      (fun m : ℕ =>
        PrimeWindow.reciprocalMass (m ^ 3) (cutoff m α) /
          Real.log (m : ℝ)) := by
    filter_upwards [eventually_ge_atTop 1,
        eventually_natCast_le_cutoff_rpow_quarter hα] with m hm hquarter
    have hmposR : (0 : ℝ) < (m : ℝ) := by
      exact_mod_cast (show 0 < m by omega)
    have hrootpos : (0 : ℝ) < (cutoff m α : ℝ) ^ (1 / 4 : ℝ) :=
      lt_of_lt_of_le hmposR hquarter
    have hUpos : (0 : ℝ) < cutoff m α := by
      by_contra h
      have hz : (cutoff m α : ℝ) = 0 := le_antisymm (le_of_not_gt h) (by positivity)
      rw [hz, Real.zero_rpow (by norm_num : (1 / 4 : ℝ) ≠ 0)] at hrootpos
      exact lt_irrefl 0 hrootpos
    have hpow4 : (m : ℝ) ^ 4 ≤
        ((cutoff m α : ℝ) ^ (1 / 4 : ℝ)) ^ 4 :=
      pow_le_pow_left₀ (by positivity) hquarter 4
    have hrootpow : ((cutoff m α : ℝ) ^ (1 / 4 : ℝ)) ^ 4 =
        (cutoff m α : ℝ) := by
      convert Real.rpow_inv_natCast_pow hUpos.le (by norm_num : (4 : ℕ) ≠ 0) using 1 <;>
        norm_num
    rw [hrootpow] at hpow4
    have hle4 : m ^ 4 ≤ cutoff m α := by exact_mod_cast hpow4
    have hle : m ^ 3 ≤ cutoff m α := by
      exact (Nat.pow_le_pow_right (by omega : 1 ≤ m) (by omega : 3 ≤ 4)).trans hle4
    rw [PrimeWindow.reciprocalMass_eq_sub hle]
    ring
  simpa using hsub.congr' heq

private theorem exists_smooth_multiplier_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ m : ℕ in atTop,
      Real.exp (2 * PrimeHarmonic.sum
          (Nat.floor (Real.log (m : ℝ) / 100))) ≤
        C * Real.log (Real.log (m : ℝ)) ^ 2 := by
  obtain ⟨C₀, hC₀, hMertens⟩ :=
    PrimeHarmonic.exists_uniform_abs_sum_sub_log_log
  refine ⟨Real.exp (2 * C₀), Real.exp_pos _ |>.le, ?_⟩
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hLL : Tendsto (fun m : ℕ => Real.log (Real.log (m : ℝ)))
      atTop atTop := Real.tendsto_log_atTop.comp hlog
  filter_upwards [hlog.eventually_ge_atTop 300,
      hLL.eventually_ge_atTop 1] with m hlogm hLLm
  let R := Nat.floor (Real.log (m : ℝ) / 100)
  have hR2 : 2 ≤ R := by
    apply Nat.le_floor
    dsimp [R]
    linarith
  have hRpos : (0 : ℝ) < R := by exact_mod_cast (show 0 < R by omega)
  have hRle : (R : ℝ) ≤ Real.log (m : ℝ) := by
    calc
      (R : ℝ) ≤ Real.log (m : ℝ) / 100 := Nat.floor_le (by positivity)
      _ ≤ Real.log (m : ℝ) := by linarith
  have hlogRpos : 0 < Real.log (R : ℝ) :=
    Real.log_pos (by exact_mod_cast hR2)
  have hlogRle : Real.log (R : ℝ) ≤ Real.log (Real.log (m : ℝ)) :=
    Real.log_le_log hRpos hRle
  have hsum : PrimeHarmonic.sum R ≤
      Real.log (Real.log (R : ℝ)) + C₀ := by
    have hM := hMertens R hR2
    linarith [le_abs_self
      (PrimeHarmonic.sum R - Real.log (Real.log (R : ℝ)))]
  calc
    Real.exp (2 * PrimeHarmonic.sum R) ≤
        Real.exp (2 * (Real.log (Real.log (R : ℝ)) + C₀)) := by
      exact Real.exp_le_exp.mpr (by linarith)
    _ = Real.exp (2 * C₀) * Real.log (R : ℝ) ^ 2 := by
      rw [show 2 * (Real.log (Real.log (R : ℝ)) + C₀) =
          2 * C₀ + 2 * Real.log (Real.log (R : ℝ)) by ring,
        Real.exp_add, show Real.exp (2 * Real.log (Real.log (R : ℝ))) =
          Real.log (R : ℝ) ^ 2 by
            have h := Real.exp_nat_mul (Real.log (Real.log (R : ℝ))) 2
            rw [Real.exp_log hlogRpos] at h
            simpa [mul_comm] using h]
    _ ≤ Real.exp (2 * C₀) * Real.log (Real.log (m : ℝ)) ^ 2 := by
      gcongr

private theorem tendsto_loglog_sq_mul_exp_loglog_sub_mul_log
    {c t : ℝ} (hc : 0 ≤ c) (ht : 0 < t) :
    Tendsto (fun m : ℕ =>
      Real.log (Real.log (m : ℝ)) ^ 2 *
        Real.exp (c * Real.log (Real.log (m : ℝ)) -
          t * Real.log (m : ℝ))) atTop (𝓝 0) := by
  have hlog : Tendsto (fun m : ℕ => Real.log (m : ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hLL : Tendsto (fun m : ℕ => Real.log (Real.log (m : ℝ)))
      atTop atTop := Real.tendsto_log_atTop.comp hlog
  have hupper := tendsto_log_rpow_mul_exp_neg (s := c + 2) ht
  refine squeeze_zero'
    (Eventually.of_forall fun m => mul_nonneg (sq_nonneg _) (Real.exp_pos _).le) ?_ hupper
  filter_upwards [hlog.eventually_gt_atTop 1,
        hLL.eventually_ge_atTop 0] with m hl hLL0
  let l := Real.log (m : ℝ)
  let ll := Real.log l
  have hlpos : 0 < l := by dsimp [l]; linarith
  have hl0 : 0 ≤ l := hlpos.le
  have hllle : ll ≤ l := by
    dsimp [ll, l]
    exact (Real.log_le_sub_one_of_pos hlpos).trans (by linarith)
  have hsquare : ll ^ 2 ≤ l ^ 2 := by nlinarith
  have hexpc : Real.exp (c * ll) = l ^ c := by
    rw [mul_comm, ← Real.rpow_def_of_pos hlpos]
  have hpow : l ^ c * l ^ (2 : ℝ) = l ^ (c + 2) := by
    rw [← Real.rpow_add hlpos]
  dsimp [ll, l] at hsquare hexpc hpow ⊢
  rw [Real.exp_sub, hexpc]
  calc
      Real.log (Real.log (m : ℝ)) ^ 2 *
          ((Real.log (m : ℝ)) ^ c /
            Real.exp (t * Real.log (m : ℝ))) ≤
          Real.log (m : ℝ) ^ 2 *
            ((Real.log (m : ℝ)) ^ c /
              Real.exp (t * Real.log (m : ℝ))) :=
        mul_le_mul_of_nonneg_right hsquare (by positivity)
      _ = Real.log (m : ℝ) ^ (c + 2) *
          Real.exp (-t * Real.log (m : ℝ)) := by
        rw [show Real.log (m : ℝ) ^ 2 =
            Real.log (m : ℝ) ^ (2 : ℝ) by
              exact (Real.rpow_two _).symm,
          show -t * Real.log (m : ℝ) =
            -(t * Real.log (m : ℝ)) by ring,
          Real.exp_neg, ← hpow]
        field_simp

private theorem eventually_log_cutoff_error_le_rpow
    {lam C : ℝ} {N : ℕ} (hlam : 0 < lam) (hC : 0 ≤ C) :
    ∀ᶠ m : ℕ in atTop,
      20 * C / Real.log (cutoff m lam : ℝ) ^ (N - 1) ≤
        20 * C * 2 ^ (N - 1) *
          (m : ℝ) ^ (-(lam * (N - 1 : ℕ))) := by
  have hne : ∀ᶠ m : ℕ in atTop, (m : ℝ) ^ lam ≠ 0 := by
    filter_upwards [eventually_gt_atTop 0] with m hm
    exact (Real.rpow_pos_of_pos (by exact_mod_cast hm) _).ne'
  have hlogcut : Tendsto (fun m : ℕ =>
      Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam) atTop (𝓝 1) :=
    (Asymptotics.isEquivalent_iff_tendsto_one hne).mp
      (log_cutoff_isEquivalent_rpow hlam)
  have hev : ∀ᶠ m : ℕ in atTop,
      (1 / 2 : ℝ) < Real.log (cutoff m lam : ℝ) / (m : ℝ) ^ lam :=
    hlogcut.eventually (Ioi_mem_nhds (by norm_num : (1 / 2 : ℝ) < 1))
  filter_upwards [hev, eventually_gt_atTop 0] with m hm hm0
  have hmpow : 0 < (m : ℝ) ^ lam :=
    Real.rpow_pos_of_pos (by exact_mod_cast hm0) _
  have hlogL : (1 / 2 : ℝ) * (m : ℝ) ^ lam ≤
      Real.log (cutoff m lam : ℝ) := by
    have h := mul_le_mul_of_nonneg_right hm.le hmpow.le
    field_simp [hmpow.ne'] at h
    linarith
  have hp := pow_le_pow_left₀ (by positivity) hlogL (N - 1)
  have hdiv := div_le_div_of_nonneg_left (by positivity : (0 : ℝ) ≤ 20 * C)
    (by positivity) hp
  calc
    20 * C / Real.log (cutoff m lam : ℝ) ^ (N - 1) ≤
        20 * C / (((1 / 2 : ℝ) * (m : ℝ) ^ lam) ^ (N - 1)) := hdiv
    _ = 20 * C * 2 ^ (N - 1) *
        (m : ℝ) ^ (-(lam * (N - 1 : ℕ))) := by
      rw [mul_pow]
      have hpowe : ((m : ℝ) ^ lam) ^ (N - 1) =
          (m : ℝ) ^ (lam * (N - 1 : ℕ)) := by
        rw [← Real.rpow_natCast,
          ← Real.rpow_mul (by exact_mod_cast hm0.le : (0 : ℝ) ≤ m)]
      rw [hpowe, div_eq_mul_inv, mul_inv_rev]
      have hhalf : ((1 / 2 : ℝ) ^ (N - 1))⁻¹ =
          (2 : ℝ) ^ (N - 1) := by
        rw [← inv_pow]
        norm_num
      have hneg : ((m : ℝ) ^ (lam * (N - 1 : ℕ)))⁻¹ =
          (m : ℝ) ^ (-(lam * (N - 1 : ℕ))) :=
        (Real.rpow_neg (by exact_mod_cast hm0.le : (0 : ℝ) ≤ m) _).symm
      rw [hhalf, hneg]
      ring

private theorem rankin_floorLog_bound {m : ℕ}
    (hm : 0 < m) (hlog : 0 ≤ Real.log (m : ℝ)) :
    (Real.sqrt (m : ℝ))⁻¹ *
        Real.exp (5 * (Nat.floor (Real.log (m : ℝ) / 100) + 1 : ℕ)) ≤
      Real.exp 5 * Real.exp (-(2 / 5 : ℝ) * Real.log (m : ℝ)) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hRup : ((Nat.floor (Real.log (m : ℝ) / 100) : ℕ) : ℝ) ≤
      Real.log (m : ℝ) / 100 := Nat.floor_le (by positivity)
  have hsqrt : (Real.sqrt (m : ℝ))⁻¹ =
      Real.exp (-(1 / 2 : ℝ) * Real.log (m : ℝ)) := by
    rw [Real.sqrt_eq_rpow, Real.rpow_def_of_pos hmR, ← Real.exp_neg]
    congr 1
    ring
  rw [hsqrt, ← Real.exp_add, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  push_cast
  nlinarith

private theorem mark_error_bound
    {x H W Cφ η lam w D DB : ℝ} (hx : 0 < x) (hCφ : 0 ≤ Cφ)
    (hH : H ≤ 1 + x ^ lam) (hW : W ≤ w * Real.log x)
    (hD : D ≤ DB) :
    1 / x ^ 3 + (2 / x) * H + W * (Cφ * x ^ η) / x + D ≤
      1 / x ^ 3 + (2 / x) * (1 + x ^ lam) +
        w * Real.log x * (Cφ * x ^ η) / x + DB := by
  have hmul : W * (Cφ * x ^ η) ≤
      (w * Real.log x) * (Cφ * x ^ η) :=
    mul_le_mul_of_nonneg_right hW (by positivity)
  have havg : W * (Cφ * x ^ η) / x ≤
      w * Real.log x * (Cφ * x ^ η) / x :=
    div_le_div_of_nonneg_right hmul hx.le
  exact add_le_add (add_le_add (add_le_add le_rfl
    (mul_le_mul_of_nonneg_left hH (by positivity)))
    havg) hD

private theorem middle_error_expand {x c : ℝ} (hx : 1 < x) :
    Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x)) *
          (200 / Real.log x + (2 / x) * (1 + 3 * Real.log x)) =
      200 * (Real.log (Real.log x) ^ 2 *
        Real.exp (-(1 - c) * Real.log (Real.log x))) +
      2 * (Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x) - Real.log x)) +
      6 * (Real.log (Real.log x) ^ 2 *
        Real.exp ((c + 1) * Real.log (Real.log x) - Real.log x)) := by
  have hx0 : 0 < x := lt_trans zero_lt_one hx
  have hl0 : 0 < Real.log x := Real.log_pos hx
  have hfirst : -(1 - c) * Real.log (Real.log x) =
      c * Real.log (Real.log x) - Real.log (Real.log x) := by ring
  have hthird : (c + 1) * Real.log (Real.log x) - Real.log x =
      c * Real.log (Real.log x) + Real.log (Real.log x) - Real.log x := by ring
  rw [hfirst, hthird]
  simp_rw [Real.exp_sub, Real.exp_add]
  rw [Real.exp_log hx0, Real.exp_log hl0]
  field_simp
  ring

private theorem mark_error_expand {x c q lam eta e A D : ℝ} (hx : 1 < x) :
    Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x) + q * Real.log x) *
          (1 / x ^ 3 + (2 / x) * (1 + x ^ lam) +
            A * Real.log x * x ^ eta / x + D * x ^ (-e)) =
      Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x) - (3 - q) * Real.log x) +
      2 * (Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x) - (1 - q) * Real.log x)) +
      2 * (Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x) - (1 - q - lam) * Real.log x)) +
      A * (Real.log (Real.log x) ^ 2 *
        Real.exp ((c + 1) * Real.log (Real.log x) -
          (1 - q - eta) * Real.log x)) +
      D * (Real.log (Real.log x) ^ 2 *
        Real.exp (c * Real.log (Real.log x) - (e - q) * Real.log x)) := by
  have hx0 : 0 < x := lt_trans zero_lt_one hx
  have hl0 : 0 < Real.log x := Real.log_pos hx
  have h1 : c * Real.log (Real.log x) - (3 - q) * Real.log x =
      c * Real.log (Real.log x) + q * Real.log x - 3 * Real.log x := by ring
  have h2 : c * Real.log (Real.log x) - (1 - q) * Real.log x =
      c * Real.log (Real.log x) + q * Real.log x - Real.log x := by ring
  have h3 : c * Real.log (Real.log x) - (1 - q - lam) * Real.log x =
      c * Real.log (Real.log x) + q * Real.log x + lam * Real.log x -
        Real.log x := by ring
  have h4 : (c + 1) * Real.log (Real.log x) - (1 - q - eta) * Real.log x =
      c * Real.log (Real.log x) + Real.log (Real.log x) +
        q * Real.log x + eta * Real.log x - Real.log x := by ring
  have h5 : c * Real.log (Real.log x) - (e - q) * Real.log x =
      c * Real.log (Real.log x) + q * Real.log x - e * Real.log x := by ring
  rw [h1, h2, h3, h4, h5]
  repeat' rw [Real.rpow_def_of_pos hx0]
  have hlam : Real.log x * lam = lam * Real.log x := by ring
  have heta : Real.log x * eta = eta * Real.log x := by ring
  have he : Real.log x * -e = -(e * Real.log x) := by ring
  have hthree : 3 * Real.log x =
      Real.log x + Real.log x + Real.log x := by ring
  rw [hlam, heta, he, hthree]
  simp_rw [Real.exp_sub, Real.exp_add, Real.exp_neg]
  rw [Real.exp_log hx0, Real.exp_log hl0]
  field_simp
  ring

private theorem eventually_mul_mass_le_floor
    {mass scale : ℕ → ℝ} {r target c : ℝ}
    (hscale : Tendsto scale atTop atTop)
    (hratio : Tendsto (fun m => mass m / scale m) atTop (𝓝 target))
    (hlt : r * target < c) :
    ∀ᶠ m : ℕ in atTop, r * mass m ≤
      (Nat.floor (c * scale m) + 1 : ℕ) := by
  have hscl := (tendsto_const_nhds (x := r)).mul hratio
  have hev : ∀ᶠ m : ℕ in atTop,
      r * (mass m / scale m) < c :=
    hscl.eventually (Iio_mem_nhds hlt)
  filter_upwards [hev, hscale.eventually_gt_atTop 0] with m hm hpos
  have hmain : r * mass m < c * scale m := by
    have h := mul_lt_mul_of_pos_right hm hpos
    field_simp [hpos.ne'] at h
    simpa [mul_assoc, mul_comm] using h
  have hfloor := Nat.lt_floor_add_one (c * scale m)
  simpa only [Nat.cast_add, Nat.cast_one] using hmain.le.trans hfloor.le

private theorem eventually_mul_scale_le_mass
    {mass scale : ℕ → ℝ} {target lower : ℝ}
    (hscale : Tendsto scale atTop atTop)
    (hratio : Tendsto (fun m => mass m / scale m) atTop (𝓝 target))
    (hlt : lower < target) :
    ∀ᶠ m : ℕ in atTop, lower * scale m ≤ mass m := by
  have hev := hratio.eventually (Ioi_mem_nhds hlt)
  filter_upwards [hev, hscale.eventually_gt_atTop 0] with m hm hpos
  have h := mul_le_mul_of_nonneg_right hm.le hpos.le
  field_simp [hpos.ne'] at h
  linarith

private theorem eventually_mass_le_mul_scale
    {mass scale : ℕ → ℝ} {target upper : ℝ}
    (hscale : Tendsto scale atTop atTop)
    (hratio : Tendsto (fun m => mass m / scale m) atTop (𝓝 target))
    (hlt : target < upper) :
    ∀ᶠ m : ℕ in atTop, mass m ≤ upper * scale m := by
  have hev := hratio.eventually (Iio_mem_nhds hlt)
  filter_upwards [hev, hscale.eventually_gt_atTop 0] with m hm hpos
  have h := mul_le_mul_of_nonneg_right hm.le hpos.le
  field_simp [hpos.ne'] at h
  linarith

private theorem cube_le_of_le_fourth_root {m L : ℕ} (hm : 0 < m)
    (hroot : (m : ℝ) ≤ (L : ℝ) ^ (1 / 4 : ℝ)) :
    m ^ 3 ≤ L := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hrootpos : 0 < (L : ℝ) ^ (1 / 4 : ℝ) :=
    lt_of_lt_of_le hmR hroot
  have hLpos : (0 : ℝ) < L := by
    by_contra hn
    have hz : (L : ℝ) = 0 := le_antisymm (le_of_not_gt hn) (by positivity)
    rw [hz, Real.zero_rpow (by norm_num : (1 / 4 : ℝ) ≠ 0)] at hrootpos
    exact lt_irrefl 0 hrootpos
  have hp4 : (m : ℝ) ^ 4 ≤ ((L : ℝ) ^ (1 / 4 : ℝ)) ^ 4 :=
    pow_le_pow_left₀ hmR.le hroot 4
  have hrootpow : ((L : ℝ) ^ (1 / 4 : ℝ)) ^ 4 = (L : ℝ) := by
    convert Real.rpow_inv_natCast_pow hLpos.le (by norm_num : (4 : ℕ) ≠ 0) using 1 <;>
      norm_num
  rw [hrootpow] at hp4
  have hp4n : m ^ 4 ≤ L := by exact_mod_cast hp4
  exact (Nat.pow_le_pow_right (by omega : 1 ≤ m) (by omega : 3 ≤ 4)).trans hp4n

private theorem residueOddsMass_le_mark_error
    {m P L U : ℕ} {Cφ η D : ℝ} [NeZero m]
    (hm : 0 < m) (hm2 : 2 ≤ m) (hP1 : 1 ≤ P) (hPL : P ≤ L) (hLU : L ≤ U)
    (hφ : (m : ℝ) / (m.totient : ℝ) ≤ Cφ * (m : ℝ) ^ η)
    (hpoint : ∀ a ∈ BoundedGaps.Maynard.coprimeResidues m,
      |PrimeWindow.residueOddsMass L U m a -
        PrimeWindow.oddsMass L U / (m.totient : ℝ)| ≤ D)
    (g : (ZMod m)ˣ) :
    PrimeWindow.residueOddsMass P U m (g : ZMod m).val ≤
      1 / (P : ℝ) + (2 / (m : ℝ)) * (harmonic L : ℝ) +
        PrimeWindow.oddsMass L U * (Cφ * (m : ℝ) ^ η) / m + D := by
  have hcop : Nat.Coprime (g : ZMod m).val m := by
    have hu := (ZMod.unitsEquivCoprime g).property
    change Nat.Coprime (g : ZMod m).val m at hu
    exact hu
  have hmem : (g : ZMod m).val ∈ BoundedGaps.Maynard.coprimeResidues m :=
    Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (ZMod.val_lt _), hcop⟩
  have hpnt := hpoint (g : ZMod m).val hmem
  have hhigh : PrimeWindow.residueOddsMass L U m (g : ZMod m).val ≤
      PrimeWindow.oddsMass L U / (m.totient : ℝ) + D := by
    linarith [le_abs_self (PrimeWindow.residueOddsMass L U m
      (g : ZMod m).val - PrimeWindow.oddsMass L U / (m.totient : ℝ))]
  have havg : PrimeWindow.oddsMass L U / (m.totient : ℝ) ≤
      PrimeWindow.oddsMass L U * (Cφ * (m : ℝ) ^ η) / m := by
    have hW0 : 0 ≤ PrimeWindow.oddsMass L U := by
      have hrec : 0 ≤ PrimeWindow.reciprocalMass L U := by
        unfold PrimeWindow.reciprocalMass
        positivity
      linarith [PrimeWindow.oddsMass_sub_reciprocalMass_nonneg L U]
    calc
      PrimeWindow.oddsMass L U / (m.totient : ℝ) =
          PrimeWindow.oddsMass L U * ((m : ℝ) / m.totient) / m := by
        field_simp
      _ ≤ PrimeWindow.oddsMass L U * (Cφ * (m : ℝ) ^ η) / m := by
        gcongr
  rw [UpperBound.residueOddsMass_split hPL hLU]
  have hlow := PrimeWindow.residueOddsMass_le_harmonic
    hP1 hm2 (U := L) (a := (g : ZMod m).val)
  linarith

private theorem master_error_le_expanded_envelope
    {m R P U Kmid Kmark N : ℕ}
    {α lam η d cmid rmid rmark bmid bmark C Cφ Cs Mmid Mmark : ℝ}
    (hm : 0 < m) (hlog : 300 ≤ Real.log (m : ℝ))
    (hCs : 0 ≤ Cs) (hMmid0 : 0 ≤ Mmid) (hMmark0 : 0 ≤ Mmark)
    (hmaster : δ m α ≤
      (Real.sqrt (m : ℝ))⁻¹ * Real.exp (5 * (R + 1 : ℕ)) +
      1 / (R : ℝ) + Real.exp (2 * PrimeHarmonic.sum R) *
        (UpperBound.upperTail rmid (PrimeWindow.reciprocalMass R P) +
          UpperBound.upperTail rmark (PrimeWindow.reciprocalMass P U) +
          (2 : ℝ) ^ Kmid * Mmid + (2 : ℝ) ^ (Kmid + Kmark) * Mmark))
    (hrank : (Real.sqrt (m : ℝ))⁻¹ * Real.exp (5 * (R + 1 : ℕ)) ≤
      Real.exp 5 * Real.exp (-(2 / 5 : ℝ) * Real.log (m : ℝ)))
    (hRrecip : 1 / (R : ℝ) ≤ 200 / Real.log (m : ℝ))
    (hsmooth : Real.exp (2 * PrimeHarmonic.sum R) ≤
      Cs * Real.log (Real.log (m : ℝ)) ^ 2)
    (htailMid : UpperBound.upperTail rmid (PrimeWindow.reciprocalMass R P) ≤
      Real.exp (-(bmid / 2) * Real.log (Real.log (m : ℝ))))
    (htailMark : UpperBound.upperTail rmark (PrimeWindow.reciprocalMass P U) ≤
      Real.exp (-(bmark * α / 2) * Real.log (m : ℝ)))
    (hpowMid : (2 : ℝ) ^ Kmid ≤
      Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ))))
    (hpowMark : (2 : ℝ) ^ Kmark ≤
      Real.exp (d * Real.log 2 * Real.log (m : ℝ)))
    (hMmid : Mmid ≤ 200 / Real.log (m : ℝ) +
      (2 / (m : ℝ)) * (1 + 3 * Real.log (m : ℝ)))
    (hMmark : Mmark ≤
      1 / (m : ℝ) ^ 3 + (2 / (m : ℝ)) * (1 + (m : ℝ) ^ lam) +
      (α - lam + 1) * Real.log (m : ℝ) * (Cφ * (m : ℝ) ^ η) / m +
      20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ)))) :
    δ m α ≤
      Real.exp 5 * Real.exp (-(2 / 5 : ℝ) * Real.log (m : ℝ)) +
      200 / Real.log (m : ℝ) + Cs *
        (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (-(bmid / 2) * Real.log (Real.log (m : ℝ))) +
          Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (-(bmark * α / 2) * Real.log (m : ℝ)) +
          200 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (-(1 - cmid * Real.log 2) * Real.log (Real.log (m : ℝ)))) +
          2 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) -
              Real.log (m : ℝ))) +
          6 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp ((cmid * Real.log 2 + 1) * Real.log (Real.log (m : ℝ)) -
              Real.log (m : ℝ))) +
          Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) -
              (3 - d * Real.log 2) * Real.log (m : ℝ)) +
          2 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) -
              (1 - d * Real.log 2) * Real.log (m : ℝ))) +
          2 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) -
              (1 - d * Real.log 2 - lam) * Real.log (m : ℝ))) +
          Cφ * (α - lam + 1) * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp ((cmid * Real.log 2 + 1) * Real.log (Real.log (m : ℝ)) -
              (1 - d * Real.log 2 - η) * Real.log (m : ℝ))) +
          20 * C * 2 ^ (N - 1) * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) -
              (lam * (N - 1 : ℕ) - d * Real.log 2) * Real.log (m : ℝ)))) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hpowBoth : (2 : ℝ) ^ Kmid * (2 : ℝ) ^ Kmark ≤
      Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) +
        d * Real.log 2 * Real.log (m : ℝ)) := by
    rw [Real.exp_add]
    exact mul_le_mul hpowMid hpowMark (by positivity) (by positivity)
  have hpre :
      Real.exp (2 * PrimeHarmonic.sum R) *
        (UpperBound.upperTail rmid (PrimeWindow.reciprocalMass R P) +
          UpperBound.upperTail rmark (PrimeWindow.reciprocalMass P U) +
          (2 : ℝ) ^ Kmid * Mmid + (2 : ℝ) ^ (Kmid + Kmark) * Mmark) ≤
      Cs * Real.log (Real.log (m : ℝ)) ^ 2 *
        (Real.exp (-(bmid / 2) * Real.log (Real.log (m : ℝ))) +
          Real.exp (-(bmark * α / 2) * Real.log (m : ℝ)) +
          Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ))) *
            (200 / Real.log (m : ℝ) +
              (2 / (m : ℝ)) * (1 + 3 * Real.log (m : ℝ))) +
          Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) +
            d * Real.log 2 * Real.log (m : ℝ)) *
            (1 / (m : ℝ) ^ 3 + (2 / (m : ℝ)) * (1 + (m : ℝ) ^ lam) +
              (α - lam + 1) * Real.log (m : ℝ) * (Cφ * (m : ℝ) ^ η) / m +
              20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ))))) := by
    have hbr0 : 0 ≤
        UpperBound.upperTail rmid (PrimeWindow.reciprocalMass R P) +
          UpperBound.upperTail rmark (PrimeWindow.reciprocalMass P U) +
          (2 : ℝ) ^ Kmid * Mmid + (2 : ℝ) ^ (Kmid + Kmark) * Mmark := by
      unfold UpperBound.upperTail
      positivity
    have hmidprod : (2 : ℝ) ^ Kmid * Mmid ≤
        Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ))) *
          (200 / Real.log (m : ℝ) +
            (2 / (m : ℝ)) * (1 + 3 * Real.log (m : ℝ))) :=
      mul_le_mul hpowMid hMmid hMmid0 (by positivity)
    have hmarkprod : (2 : ℝ) ^ (Kmid + Kmark) * Mmark ≤
        Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) +
          d * Real.log 2 * Real.log (m : ℝ)) *
          (1 / (m : ℝ) ^ 3 + (2 / (m : ℝ)) * (1 + (m : ℝ) ^ lam) +
            (α - lam + 1) * Real.log (m : ℝ) * (Cφ * (m : ℝ) ^ η) / m +
            20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ)))) := by
      rw [pow_add]
      exact mul_le_mul hpowBoth hMmark hMmark0 (by positivity)
    have hbr := add_le_add (add_le_add (add_le_add htailMid htailMark)
      hmidprod) hmarkprod
    calc
      _ ≤ Cs * Real.log (Real.log (m : ℝ)) ^ 2 *
          (UpperBound.upperTail rmid (PrimeWindow.reciprocalMass R P) +
            UpperBound.upperTail rmark (PrimeWindow.reciprocalMass P U) +
            (2 : ℝ) ^ Kmid * Mmid + (2 : ℝ) ^ (Kmid + Kmark) * Mmark) :=
        mul_le_mul_of_nonneg_right hsmooth hbr0
      _ ≤ _ := mul_le_mul_of_nonneg_left hbr (by positivity)
  have hid :
      Cs * Real.log (Real.log (m : ℝ)) ^ 2 *
        (Real.exp (-(bmid / 2) * Real.log (Real.log (m : ℝ))) +
          Real.exp (-(bmark * α / 2) * Real.log (m : ℝ)) +
          Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ))) *
            (200 / Real.log (m : ℝ) +
              (2 / (m : ℝ)) * (1 + 3 * Real.log (m : ℝ))) +
          Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) +
            d * Real.log 2 * Real.log (m : ℝ)) *
            (1 / (m : ℝ) ^ 3 + (2 / (m : ℝ)) * (1 + (m : ℝ) ^ lam) +
              (α - lam + 1) * Real.log (m : ℝ) * (Cφ * (m : ℝ) ^ η) / m +
              20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ))))) =
      Cs *
        (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (-(bmid / 2) * Real.log (Real.log (m : ℝ))) +
          Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (-(bmark * α / 2) * Real.log (m : ℝ)) +
          200 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (-(1 - cmid * Real.log 2) * Real.log (Real.log (m : ℝ)))) +
          2 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) - Real.log (m : ℝ))) +
          6 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp ((cmid * Real.log 2 + 1) * Real.log (Real.log (m : ℝ)) - Real.log (m : ℝ))) +
          Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) - (3 - d * Real.log 2) * Real.log (m : ℝ)) +
          2 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) - (1 - d * Real.log 2) * Real.log (m : ℝ))) +
          2 * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) - (1 - d * Real.log 2 - lam) * Real.log (m : ℝ))) +
          Cφ * (α - lam + 1) * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp ((cmid * Real.log 2 + 1) * Real.log (Real.log (m : ℝ)) - (1 - d * Real.log 2 - η) * Real.log (m : ℝ))) +
          20 * C * 2 ^ (N - 1) * (Real.log (Real.log (m : ℝ)) ^ 2 *
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) -
              (lam * (N - 1 : ℕ) - d * Real.log 2) * Real.log (m : ℝ)))) := by
    have hlpos : 0 < Real.log (m : ℝ) := by linarith
    have hmone : 1 < (m : ℝ) :=
      (Real.log_pos_iff hmR.le).mp hlpos
    have hmid := middle_error_expand
      (x := (m : ℝ)) (c := cmid * Real.log 2) hmone
    have hmark := mark_error_expand
      (x := (m : ℝ)) (c := cmid * Real.log 2) (q := d * Real.log 2)
      (lam := lam) (eta := η) (e := lam * (N - 1 : ℕ))
      (A := Cφ * (α - lam + 1)) (D := 20 * C * 2 ^ (N - 1)) hmone
    linear_combination Cs * hmid + Cs * hmark
  calc
    δ m α ≤ _ := hmaster
    _ ≤ Real.exp 5 * Real.exp (-(2 / 5 : ℝ) * Real.log (m : ℝ)) +
        200 / Real.log (m : ℝ) +
        Cs * Real.log (Real.log (m : ℝ)) ^ 2 *
          (Real.exp (-(bmid / 2) * Real.log (Real.log (m : ℝ))) +
            Real.exp (-(bmark * α / 2) * Real.log (m : ℝ)) +
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ))) *
              (200 / Real.log (m : ℝ) + (2 / (m : ℝ)) * (1 + 3 * Real.log (m : ℝ))) +
            Real.exp (cmid * Real.log 2 * Real.log (Real.log (m : ℝ)) + d * Real.log 2 * Real.log (m : ℝ)) *
              (1 / (m : ℝ) ^ 3 + (2 / (m : ℝ)) * (1 + (m : ℝ) ^ lam) +
                (α - lam + 1) * Real.log (m : ℝ) * (Cφ * (m : ℝ) ^ η) / m +
                20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ))))) :=
      add_le_add (add_le_add hrank hRrecip) hpre
    _ = _ := by rw [hid]

/-- Hall's multiscale upper bound, combined with Bombieri--Vinogradov and
Mertens' theorem, gives density zero throughout the difficult interval
`[1, 1 / log 2)`. -/
private theorem tendsto_delta_zero_of_one_le_of_lt_critical
    {α : ℝ} (hα1 : 1 ≤ α) (hαcrit : α < criticalExponent) :
    Tendsto (fun m : ℕ => δ m α) atTop (𝓝 0) := by
  classical
  have hlog2 : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  let d : ℝ := (α + criticalExponent) / 2
  let q : ℝ := d * Real.log 2
  let s : ℝ := 1 - q
  let lam : ℝ := s / 4
  let η : ℝ := s / 4
  let cmid : ℝ := (1 + criticalExponent) / 2
  let rmid : ℝ := (1 + cmid) / 2
  let rmark : ℝ := (1 + d / α) / 2
  have hαpos : 0 < α := lt_of_lt_of_le zero_lt_one hα1
  have hαd : α < d := by dsimp [d]; linarith
  have hdcrit : d < criticalExponent := by dsimp [d]; linarith
  have hdpos : 0 < d := hαpos.trans hαd
  have hqpos : 0 < q := mul_pos hdpos hlog2
  have hq1 : q < 1 := by
    dsimp [q]
    calc
      d * Real.log 2 < criticalExponent * Real.log 2 :=
        mul_lt_mul_of_pos_right hdcrit hlog2
      _ = 1 := critical_mul_log_two
  have hspos : 0 < s := by dsimp [s]; linarith
  have hlam : 0 < lam := by dsimp [lam]; linarith
  have hη : 0 < η := by dsimp [η]; linarith
  have hlamα : lam < α := by
    have hs1 : s < 1 := by dsimp [s]; linarith
    dsimp [lam]
    linarith
  have hcmid1 : 1 < cmid := by
    dsimp [cmid]
    linarith [one_lt_criticalExponent]
  have hcmidpos : 0 < cmid := zero_lt_one.trans hcmid1
  have hcmidlog : cmid * Real.log 2 < 1 := by
    have hloglt : Real.log (2 : ℝ) < 1 := by
      nlinarith [Real.log_lt_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
    calc
      cmid * Real.log 2 = (Real.log 2 + 1) / 2 := by
        dsimp [cmid]
        nlinarith [critical_mul_log_two]
      _ < 1 := by linarith
  have hrmid1 : 1 < rmid := by dsimp [rmid]; linarith
  have hrmidcmid : rmid < cmid := by dsimp [rmid]; linarith
  have hrmark1 : 1 < rmark := by
    dsimp [rmark]
    have : 1 < d / α := (lt_div_iff₀ hαpos).mpr (by simpa using hαd)
    linarith
  have hrmarkα : rmark * α < d := by
    dsimp [rmark]
    field_simp [hαpos.ne']
    linarith
  let N : ℕ := Nat.ceil (3 / lam) + 2
  have hN2 : 2 ≤ N := by dsimp [N]; omega
  have hsave : 3 < lam * (N - 1 : ℕ) := by
    have hthree : 0 ≤ 3 / lam := by positivity
    have hc : 3 / lam ≤ (Nat.ceil (3 / lam) : ℝ) := Nat.le_ceil _
    have hlamc : 3 ≤ lam * (Nat.ceil (3 / lam) : ℝ) := by
      rw [div_le_iff₀ hlam] at hc
      simpa [mul_comm] using hc
    dsimp [N]
    push_cast
    nlinarith
  obtain ⟨C, hC, hBV⟩ :=
    exists_eventually_weighted_residue_error hlam hlamα N hN2
  obtain ⟨Cφ, hCφ, hφ⟩ := exists_eventually_totient_ratio_le_rpow hη
  obtain ⟨Cs, hCs, hsmooth⟩ := exists_smooth_multiplier_bound
  let R : ℕ → ℕ := fun m => Nat.floor (Real.log (m : ℝ) / 100)
  let P : ℕ → ℕ := fun m => m ^ 3
  let L : ℕ → ℕ := fun m => cutoff m lam
  let U : ℕ → ℕ := fun m => cutoff m α
  let ell : ℕ → ℝ := fun m => Real.log (m : ℝ)
  let ll : ℕ → ℝ := fun m => Real.log (ell m)
  let Kmid : ℕ → ℕ := fun m => Nat.floor (cmid * ll m)
  let Kmark : ℕ → ℕ := fun m => Nat.floor (d * ell m)
  let D : ℕ → ℝ := fun m => 20 * C / Real.log (L m : ℝ) ^ (N - 1)
  let Mmid : ℕ → ℝ := fun m =>
    1 / (R m : ℝ) + (2 / (m : ℝ)) * (harmonic (P m) : ℝ)
  let Mmark : ℕ → ℝ := fun m =>
    1 / (P m : ℝ) + (2 / (m : ℝ)) * (harmonic (L m) : ℝ) +
      PrimeWindow.oddsMass (L m) (U m) * (Cφ * (m : ℝ) ^ η) / m + D m
  let bmid : ℝ := (rmid - 1) ^ 2 / (2 * (rmid + 1))
  let bmark : ℝ := (rmark - 1) ^ 2 / (2 * (rmark + 1))
  let c : ℝ := cmid * Real.log 2
  have hbmid : 0 < bmid := by dsimp [bmid]; positivity
  have hbmark : 0 < bmark := by dsimp [bmark]; positivity
  have hc0 : 0 ≤ c := by dsimp [c]; positivity
  have hc1 : c < 1 := by simpa [c] using hcmidlog
  have htMark : 0 < bmark * α / 2 := by positivity
  have ht3 : 0 < 3 - q := by linarith
  have ht1 : 0 < 1 - q := by linarith
  have htlam : 0 < 1 - q - lam := by
    dsimp [lam, s]
    linarith
  have htη : 0 < 1 - q - η := by
    dsimp [η, s]
    linarith
  have htD : 0 < lam * (N - 1 : ℕ) - q := by linarith
  let F : ℝ → ℝ → ℕ → ℝ := fun a t m =>
    ll m ^ 2 * Real.exp (a * ll m - t * ell m)
  let G : ℝ → ℕ → ℝ := fun b m =>
    ll m ^ 2 * Real.exp (-b * ll m)
  have hF (a t : ℝ) (ha : 0 ≤ a) (ht : 0 < t) :
      Tendsto (F a t) atTop (𝓝 0) := by
    simpa [F, ll, ell] using
      tendsto_loglog_sq_mul_exp_loglog_sub_mul_log ha ht
  have hG (b : ℝ) (hb : 0 < b) : Tendsto (G b) atTop (𝓝 0) := by
    simpa [G, ll, ell] using tendsto_loglog_sq_mul_exp_neg hb
  let E : ℕ → ℝ := fun m =>
    Real.exp 5 * Real.exp (-(2 / 5 : ℝ) * ell m) + 200 / ell m +
      Cs * (G (bmid / 2) m + F 0 (bmark * α / 2) m +
        200 * G (1 - c) m + 2 * F c 1 m + 6 * F (c + 1) 1 m +
        F c (3 - q) m + 2 * F c (1 - q) m +
        2 * F c (1 - q - lam) m +
        Cφ * (α - lam + 1) * F (c + 1) (1 - q - η) m +
        20 * C * 2 ^ (N - 1) * F c (lam * (N - 1 : ℕ) - q) m)
  have hE : Tendsto E atTop (𝓝 0) := by
    have hrank0 : Tendsto (fun m : ℕ =>
        Real.exp (-(2 / 5 : ℝ) * ell m)) atTop (𝓝 0) := by
      have h := tendsto_log_rpow_mul_exp_neg (s := 0)
        (by norm_num : (0 : ℝ) < 2 / 5)
      simpa [ell] using h
    have hlog : Tendsto ell atTop atTop := by
      simpa [ell, Function.comp_def] using
        Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
    have hinvlog : Tendsto (fun m : ℕ => 200 / ell m) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop hlog
    have hinner : Tendsto (fun m : ℕ =>
        G (bmid / 2) m + F 0 (bmark * α / 2) m +
          200 * G (1 - c) m + 2 * F c 1 m + 6 * F (c + 1) 1 m +
          F c (3 - q) m + 2 * F c (1 - q) m +
          2 * F c (1 - q - lam) m +
          Cφ * (α - lam + 1) * F (c + 1) (1 - q - η) m +
          20 * C * 2 ^ (N - 1) * F c (lam * (N - 1 : ℕ) - q) m)
        atTop (𝓝 0) := by
      have h1 := hG (bmid / 2) (by positivity)
      have h2 := hF 0 (bmark * α / 2) (by norm_num) htMark
      have h3 := (tendsto_const_nhds (x := (200 : ℝ))).mul
        (hG (1 - c) (sub_pos.mpr hc1))
      have h4 := (tendsto_const_nhds (x := (2 : ℝ))).mul
        (hF c 1 hc0 zero_lt_one)
      have h5 := (tendsto_const_nhds (x := (6 : ℝ))).mul
        (hF (c + 1) 1 (by positivity) zero_lt_one)
      have h6 := hF c (3 - q) hc0 ht3
      have h7 := (tendsto_const_nhds (x := (2 : ℝ))).mul
        (hF c (1 - q) hc0 ht1)
      have h8 := (tendsto_const_nhds (x := (2 : ℝ))).mul
        (hF c (1 - q - lam) hc0 htlam)
      have h9 := (tendsto_const_nhds
          (x := Cφ * (α - lam + 1))).mul
        (hF (c + 1) (1 - q - η) (by positivity) htη)
      have h10 := (tendsto_const_nhds
          (x := 20 * C * 2 ^ (N - 1))).mul
        (hF c (lam * (N - 1 : ℕ) - q) hc0 htD)
      simpa only [zero_add, mul_zero] using
        ((((((((h1.add h2).add h3).add h4).add h5).add h6).add h7).add h8).add h9).add h10
    dsimp [E]
    simpa only [zero_add, mul_zero] using
      (((tendsto_const_nhds (x := Real.exp 5)).mul hrank0).add hinvlog).add
        ((tendsto_const_nhds (x := Cs)).mul hinner)
  have hmidRatio : Tendsto (fun m : ℕ =>
      PrimeWindow.reciprocalMass (R m) (P m) / ll m)
      atTop (𝓝 1) := by
    simpa [R, P, ll, ell] using
      tendsto_reciprocalMass_floorLog_cube_div_loglog
  have hmarkRatio : Tendsto (fun m : ℕ =>
      PrimeWindow.reciprocalMass (P m) (U m) / ell m)
      atTop (𝓝 α) := by
    simpa [P, U, ell] using tendsto_reciprocalMass_cube_cutoff_div_log hαpos
  have hoddsRatio : Tendsto (fun m : ℕ =>
      PrimeWindow.oddsMass (L m) (U m) / ell m)
      atTop (𝓝 (α - lam)) := by
    simpa [L, U, ell] using tendsto_oddsMass_cutoff_div_log hlam hlamα
  have hlog : Tendsto ell atTop atTop := by
    simpa [ell, Function.comp_def] using
      Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hll : Tendsto ll atTop atTop := by
    simpa [ll, Function.comp_def] using Real.tendsto_log_atTop.comp hlog
  have hRtop : Tendsto R atTop atTop := by
    dsimp [R]
    exact tendsto_nat_floor_atTop.comp
      ((hlog.const_mul_atTop (by norm_num : (0 : ℝ) < 1 / 100)).congr'
        (Eventually.of_forall fun m => by dsimp [ell]; ring))
  have hmidThreshold : ∀ᶠ m : ℕ in atTop,
      rmid * PrimeWindow.reciprocalMass (R m) (P m) ≤
        (Kmid m + 1 : ℕ) := by
    simpa [Kmid] using eventually_mul_mass_le_floor hll hmidRatio
      (show rmid * 1 < cmid by simpa using hrmidcmid)
  have hmarkThreshold : ∀ᶠ m : ℕ in atTop,
      rmark * PrimeWindow.reciprocalMass (P m) (U m) ≤
        (Kmark m + 1 : ℕ) := by
    simpa [Kmark] using eventually_mul_mass_le_floor hlog hmarkRatio hrmarkα
  have hmidLower : ∀ᶠ m : ℕ in atTop,
      (1 / 2 : ℝ) * ll m ≤ PrimeWindow.reciprocalMass (R m) (P m) := by
    exact eventually_mul_scale_le_mass hll hmidRatio (by norm_num)
  have hmarkLower : ∀ᶠ m : ℕ in atTop,
      (α / 2) * ell m ≤ PrimeWindow.reciprocalMass (P m) (U m) := by
    exact eventually_mul_scale_le_mass hlog hmarkRatio (by linarith)
  have hoddsUpper : ∀ᶠ m : ℕ in atTop,
      PrimeWindow.oddsMass (L m) (U m) ≤ (α - lam + 1) * ell m := by
    exact eventually_mass_le_mul_scale hlog hoddsRatio (lt_add_one _)
  have hDUpper : ∀ᶠ m : ℕ in atTop,
      D m ≤ 20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ))) := by
    simpa [D, L] using eventually_log_cutoff_error_le_rpow
      (N := N) hlam hC
  have hδE : ∀ᶠ m : ℕ in atTop, δ m α ≤ E m := by
    filter_upwards [eventually_ge_atTop 2, hlog.eventually_ge_atTop 300,
        hll.eventually_ge_atTop 1, hRtop.eventually_ge_atTop 1,
        hmidThreshold, hmarkThreshold, hmidLower, hmarkLower, hoddsUpper,
        hDUpper, hBV, hφ, hsmooth,
        eventually_natCast_le_cutoff_rpow_quarter hlam]
      with m hm hlogm hllm hR1 hKtMid hKtMark hlowMid hlowMark hOdds
        hDup hBVm hφm hSm hquarter
    rcases hBVm with ⟨hL4, hLU, hlogL1, hpoint⟩
    have hmpos : 0 < m := by omega
    letI : NeZero m := ⟨hmpos.ne'⟩
    have hmRpos : (0 : ℝ) < m := by exact_mod_cast hmpos
    have hP : P m = m ^ 3 := rfl
    have hmP : m ≤ P m := by dsimp [P]; exact Nat.le_pow (by omega)
    have hRP : R m ≤ P m := by
      have hfloor : (R m : ℝ) ≤ ell m / 100 := by
        dsimp [R]
        exact Nat.floor_le (by positivity)
      have hlogle : ell m ≤ (m : ℝ) := by
        dsimp [ell]
        exact (Real.log_le_sub_one_of_pos hmRpos).trans (by linarith)
      have hreal : (R m : ℝ) ≤ (P m : ℕ) := hfloor.trans (by
        calc ell m / 100 ≤ ell m := by linarith
        _ ≤ (m : ℝ) := hlogle
        _ ≤ (P m : ℕ) := by exact_mod_cast hmP)
      exact_mod_cast hreal
    have hPL : P m ≤ L m := by
      dsimp [P]
      exact cube_le_of_le_fourth_root hmpos hquarter
    have hsub : divisorSet m α ⊆ UpperBound.boundedDivisorSet m (U m) := by
      rintro n ⟨a, hamod, haI, han⟩
      have ha1 : 1 < a := by exact_mod_cast haI.1
      have hma := add_one_le_of_modEq_one ha1 hamod
      exact ⟨a, by omega,
        (le_cutoff_iff.mpr haI.2), hamod, han⟩
    have hMmid0 : 0 ≤ Mmid m := by
      dsimp [Mmid]
      have hh : 0 ≤ (harmonic (P m) : ℝ) := by
        rw [harmonic_eq_sum_Icc]
        positivity
      positivity
    have hD0 : 0 ≤ D m := by
      dsimp [D]
      exact div_nonneg (by positivity) (pow_nonneg (by linarith) _)
    have hMmark0 : 0 ≤ Mmark m := by
      dsimp [Mmark]
      have hW0 : 0 ≤ PrimeWindow.oddsMass (L m) (U m) := by
        have hrec : 0 ≤ PrimeWindow.reciprocalMass (L m) (U m) := by
          unfold PrimeWindow.reciprocalMass
          positivity
        linarith [PrimeWindow.oddsMass_sub_reciprocalMass_nonneg (L m) (U m)]
      have hh : 0 ≤ (harmonic (L m) : ℝ) := by
        rw [harmonic_eq_sum_Icc]
        positivity
      exact add_nonneg (add_nonneg (add_nonneg (by positivity)
        (mul_nonneg (by positivity) hh)) (by positivity)) hD0
    have hresMid (g : (ZMod m)ˣ) :
        PrimeWindow.residueOddsMass (R m) (P m) m (g : ZMod m).val ≤ Mmid m := by
      dsimp [Mmid]
      exact PrimeWindow.residueOddsMass_le_harmonic hR1 (by omega)
    have hresMark (g : (ZMod m)ˣ) :
        PrimeWindow.residueOddsMass (P m) (U m) m (g : ZMod m).val ≤ Mmark m := by
      dsimp [Mmark]
      exact residueOddsMass_le_mark_error hmpos (by omega) (by omega)
        hPL hLU hφm (by simpa [D] using hpoint) g
    have hmaster := UpperBound.density_le_multiscale
      (divisorSet_hasDensity m α) hsub hmpos hR1 hRP hmP
      hrmid1 hrmark1 hKtMid hKtMark hMmid0 hMmark0 hresMid hresMark
    have hRlower : ell m / 200 ≤ (R m : ℝ) := by
      have hf := Nat.sub_one_lt_floor (ell m / 100)
      dsimp [R]
      linarith
    have hRrecip : 1 / (R m : ℝ) ≤ 200 / ell m := by
      have hRpos : (0 : ℝ) < R m := by exact_mod_cast (show 0 < R m by omega)
      exact (one_div_le_one_div_of_le (by positivity) hRlower).trans_eq (by field_simp)
    have hpowMid : (2 : ℝ) ^ Kmid m ≤ Real.exp (c * ll m) := by
      calc
        (2 : ℝ) ^ Kmid m = Real.exp (Real.log 2) ^ Kmid m := by
          rw [Real.exp_log (by norm_num : (0 : ℝ) < 2)]
        _ = Real.exp ((Kmid m : ℕ) * Real.log 2) :=
          (Real.exp_nat_mul _ _).symm
        _ ≤ Real.exp ((cmid * ll m) * Real.log 2) := by
          apply Real.exp_le_exp.mpr
          exact mul_le_mul_of_nonneg_right
            (Nat.floor_le (show 0 ≤ cmid * ll m by positivity)) hlog2.le
        _ = Real.exp (c * ll m) := by
          dsimp [c]
          congr 1
          ring
    have hpowMark : (2 : ℝ) ^ Kmark m ≤ Real.exp (q * ell m) := by
      calc
        (2 : ℝ) ^ Kmark m = Real.exp (Real.log 2) ^ Kmark m := by
          rw [Real.exp_log (by norm_num : (0 : ℝ) < 2)]
        _ = Real.exp ((Kmark m : ℕ) * Real.log 2) :=
          (Real.exp_nat_mul _ _).symm
        _ ≤ Real.exp ((d * ell m) * Real.log 2) := by
          apply Real.exp_le_exp.mpr
          exact mul_le_mul_of_nonneg_right
            (Nat.floor_le (show 0 ≤ d * ell m by positivity)) hlog2.le
        _ = Real.exp (q * ell m) := by
          dsimp [q]
          congr 1
          ring
    have hharmP : (harmonic (P m) : ℝ) ≤ 1 + 3 * ell m := by
      calc
        (harmonic (P m) : ℝ) ≤ 1 + Real.log (P m : ℝ) := harmonic_le_one_add_log _
        _ = 1 + 3 * ell m := by
          dsimp [P, ell]
          rw [Nat.cast_pow, Real.log_pow]
          norm_num
    have hharmL : (harmonic (L m) : ℝ) ≤ 1 + (m : ℝ) ^ lam := by
      calc
        (harmonic (L m) : ℝ) ≤ 1 + Real.log (L m : ℝ) := harmonic_le_one_add_log _
        _ ≤ 1 + (m : ℝ) ^ lam := by
          have hb : Real.log (L m : ℝ) ≤ (m : ℝ) ^ lam := by
            calc
              Real.log (L m : ℝ) ≤ Real.log (Real.exp ((m : ℝ) ^ lam)) := by
                apply Real.log_le_log (by exact_mod_cast (show 0 < L m by omega))
                exact (le_cutoff_iff.mp (show L m ≤ cutoff m lam by rfl)).le
              _ = (m : ℝ) ^ lam := Real.log_exp _
          linarith
    have htailMid : UpperBound.upperTail rmid
        (PrimeWindow.reciprocalMass (R m) (P m)) ≤
        Real.exp (-(bmid / 2) * ll m) := by
      have h := upperTail_le_exp_neg_rate_mul hrmid1 hlowMid
      dsimp [bmid]
      convert h using 1 <;> ring
    have htailMark : UpperBound.upperTail rmark
        (PrimeWindow.reciprocalMass (P m) (U m)) ≤
        Real.exp (-(bmark * α / 2) * ell m) := by
      have h := upperTail_le_exp_neg_rate_mul hrmark1 hlowMark
      dsimp [bmark]
      convert h using 1 <;> ring
    have hrank : (Real.sqrt (m : ℝ))⁻¹ * Real.exp (5 * (R m + 1 : ℕ)) ≤
        Real.exp 5 * Real.exp (-(2 / 5 : ℝ) * ell m) := by
      simpa [R, ell] using rankin_floorLog_bound hmpos (by linarith)
    have hmarkM : Mmark m ≤
        1 / (m : ℝ) ^ 3 + (2 / (m : ℝ)) * (1 + (m : ℝ) ^ lam) +
          (α - lam + 1) * ell m * (Cφ * (m : ℝ) ^ η) / m +
          20 * C * 2 ^ (N - 1) * (m : ℝ) ^ (-(lam * (N - 1 : ℕ))) := by
      dsimp [Mmark, P]
      simpa [Nat.cast_pow, ell] using
        (mark_error_bound (η := η) hmRpos hCφ hharmL hOdds hDup)
    have hmidM : Mmid m ≤ 200 / ell m +
        (2 / (m : ℝ)) * (1 + 3 * ell m) := by
      dsimp [Mmid]
      exact add_le_add hRrecip
        (mul_le_mul_of_nonneg_left hharmP (by positivity))
    have henv := master_error_le_expanded_envelope hmpos
      (by simpa [ell] using hlogm) hCs hMmid0 hMmark0 hmaster hrank hRrecip
      (by simpa [R, ell, ll] using hSm)
      (by simpa [ell, ll] using htailMid)
      (by simpa [ell] using htailMark)
      (by simpa [c, ell, ll] using hpowMid)
      (by simpa [q, ell] using hpowMark)
      (by simpa [ell] using hmidM)
      (by simpa [ell] using hmarkM)
    dsimp [E, F, G, c, q, ell, ll]
    convert henv using 1 <;> ring
  apply squeeze_zero'
  · exact Eventually.of_forall fun m => delta_nonneg m α
  · exact hδE
  · exact hE

/-- The zero half of Hall's transition, including the elementary range
below `1`. -/
theorem tendsto_delta_zero_of_critical_gt {α : ℝ}
    (hα : α < criticalExponent) :
    Tendsto (fun m : ℕ => δ m α) atTop (𝓝 0) := by
  by_cases h : α < 1
  · exact tendsto_delta_zero_of_lt_one h
  · exact tendsto_delta_zero_of_one_le_of_lt_critical (le_of_not_gt h) hα

/-- Hall's resolution of Erdős Problem 697, with the sharp exponent
`1 / log 2`. -/
theorem erdos_697_sharp_transition :
    1 < criticalExponent ∧
      (∀ α : ℝ, α < criticalExponent →
        Tendsto (fun m : ℕ => δ m α) atTop (𝓝 0)) ∧
      (∀ α : ℝ, criticalExponent < α →
        Tendsto (fun m : ℕ => δ m α) atTop (𝓝 1)) := by
  exact ⟨one_lt_criticalExponent, fun _ => tendsto_delta_zero_of_critical_gt,
    fun _ => tendsto_delta_one_of_critical_lt⟩

/-- Existential formulation matching the statement of Problem 697. -/
theorem erdos_697 :
    ∃ β : ℝ, 1 < β ∧
      (∀ α : ℝ, α < β → Tendsto (fun m : ℕ => δ m α) atTop (𝓝 0)) ∧
      (∀ α : ℝ, β < α → Tendsto (fun m : ℕ => δ m α) atTop (𝓝 1)) := by
  exact ⟨criticalExponent, erdos_697_sharp_transition⟩


end

end Erdos697
