/-- Cook--Nguyen polynomial rigidity on a good block: base-step analytic
unwrapping propagates to every natural multiple of the Dirichlet step. -/
lemma iteratedForwardDifference_scaledPhase_eq_centered_multiple_on_goodBlock
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ)
    (q₀ ell k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (v : ℕ) (hv : v + 2 * k * (ell + 1) * q₀ < W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    iteratedForwardDifference (((ell : ℕ) * q₀ : ℕ) : ℤ) (2 * k)
        (scaledRealPhaseProjection n points u t)
        (((s + v : ℕ) : ℤ) - (n : ℤ)) =
      iteratedForwardDifference (((ell : ℕ) * q₀ : ℕ) : ℤ) (2 * k)
        (fun x ↦ centeredModOne
          (scaledRealPhaseProjection n points u t x))
        (((s + v : ℕ) : ℤ) - (n : ℤ)) := by
  let j : ℤ := ((s + v : ℕ) : ℤ) - (n : ℤ)
  have hbase : ∀ w : ℕ, w ≤ (2 * k) * ell →
      iteratedForwardDifference (q₀ : ℤ) (2 * k)
          (scaledRealPhaseProjection n points u t)
          (j + (w : ℤ) * (q₀ : ℤ)) =
        iteratedForwardDifference (q₀ : ℤ) (2 * k)
          (fun x ↦ centeredModOne
            (scaledRealPhaseProjection n points u t x))
          (j + (w : ℤ) * (q₀ : ℤ)) := by
    intro w hw
    have hfitw : (v + w * q₀) + 2 * k * q₀ < W := by
      have hwq : w * q₀ ≤ (2 * k) * ell * q₀ :=
        Nat.mul_le_mul_right q₀ hw
      have hdecomp : 2 * k * (ell + 1) * q₀ =
          (2 * k) * ell * q₀ + 2 * k * q₀ := by ring
      rw [hdecomp] at hv
      omega
    have h := iteratedForwardDifference_scaledPhase_eq_centered_on_goodBlock
      n hn points u t q₀ k η hη hgap s W hs a ha hgood
        (v + w * q₀) hfitw hsmall
    convert h using 1 <;> dsimp [j] <;> push_cast <;> ring
  have hprop := iteratedForwardDifference_nat_mul_eq_centered_of_base
    (q₀ : ℤ) ell (2 * k) (scaledRealPhaseProjection n points u t) j hbase
  convert hprop using 1 <;> dsimp [j] <;> push_cast <;> ring

