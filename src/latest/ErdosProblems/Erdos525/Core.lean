theorem goodTruncatedChooseContribution_tendsto
    (k : ℕ) (hk : 0 < k)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 < u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 < velocityUpper) :
    Tendsto (fun n : ℕ ↦
      goodTruncatedChooseContribution n k u velocityLower velocityUpper)
      atTop
      (𝓝 ((((12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper) ^ k) /
          (k.factorial : ℝ))) := by
  let A : ℝ := (((12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper) ^ k)
  let reference : ℕ → ℝ := fun n ↦
    A * ((goodLocalSiteSets n k).card : ℝ) /
      (localMeshSize n : ℝ) ^ k
  have href : Tendsto reference atTop
      (𝓝 (A * (k.factorial : ℝ)⁻¹)) := by
    dsimp [reference]
    convert tendsto_const_nhds.mul
      (goodLocalSiteSets_ratio_tendsto_factorial k hk) using 1 <;> ring
  have hdiff : Tendsto (fun n : ℕ ↦
      goodTruncatedChooseContribution n k u velocityLower velocityUpper -
        reference n) atTop (𝓝 0) := by
    rw [Metric.tendsto_atTop]
    intro eps heps
    have hclose := eventually_goodTruncatedChooseContribution_close
      k hk u velocityLower velocityUpper hu hvelLower hvelUpper heps
    apply eventually_atTop.1
    exact hclose.mono fun n hn ↦ by
      simpa only [Real.dist_eq, sub_zero, reference, A] using hn
  have hsum := hdiff.add href
  convert hsum using 1
  · funext n
    simp only [reference]
    ring
  · congr 1
    dsimp [A]
    simp [div_eq_mul_inv]

