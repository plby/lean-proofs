noncomputable def rigidityPower (n : ℕ) (α : ℝ) : ℝ :=
  (n : ℝ) ^ α

lemma rigidityPower_nonneg (n : ℕ) (α : ℝ) :
    0 ≤ rigidityPower n α := by
  unfold rigidityPower
  positivity

lemma rigidityPower_pos {n : ℕ} (hn : 0 < n) (α : ℝ) :
    0 < rigidityPower n α := by
  unfold rigidityPower
  positivity

lemma rigidityPower_add {n : ℕ} (hn : 0 < n) (α β : ℝ) :
    rigidityPower n (α + β) =
      rigidityPower n α * rigidityPower n β := by
  exact Real.rpow_add (by exact_mod_cast hn) α β

lemma rigidityPower_mul {n : ℕ} (hn : 0 < n) (α β : ℝ) :
    rigidityPower n (α * β) = (rigidityPower n α) ^ β := by
  exact Real.rpow_mul (by exact_mod_cast hn.le) α β

lemma rigidityPower_nat_pow {n : ℕ} (hn : 0 < n) (α : ℝ) (k : ℕ) :
    (rigidityPower n α) ^ k = rigidityPower n (α * k) := by
  have h := rigidityPower_mul hn α (k : ℝ)
  simpa only [Real.rpow_natCast] using h.symm

lemma constant_div_rigidityPower_nat_pow
    {n : ℕ} (hn : 0 < n) (C α : ℝ) (k : ℕ) :
    (C / rigidityPower n α) ^ k =
      C ^ k * rigidityPower n (-(α * k)) := by
  rw [div_pow, rigidityPower_nat_pow hn]
  unfold rigidityPower
  rw [Real.rpow_neg (by exact_mod_cast hn.le)]
  ring

lemma tendsto_rigidityPower_atTop {α : ℝ} (hα : 0 < α) :
    Tendsto (fun n : ℕ ↦ rigidityPower n α) atTop atTop := by
  exact (tendsto_rpow_atTop hα).comp tendsto_natCast_atTop_atTop

/-- A fixed constant is absorbed by any strict power-law exponent gap. -/
lemma eventually_const_mul_rigidityPower_le
    (C α β : ℝ) (hαβ : α < β) :
    ∀ᶠ n : ℕ in atTop,
      C * rigidityPower n α ≤ rigidityPower n β := by
  have hgap : 0 < β - α := sub_pos.mpr hαβ
  have hlarge : ∀ᶠ n : ℕ in atTop,
      C ≤ rigidityPower n (β - α) :=
    (tendsto_rigidityPower_atTop hgap).eventually (eventually_ge_atTop C)
  filter_upwards [Nat.eventually_pos, hlarge] with n hn hlargeN
  calc
    C * rigidityPower n α = rigidityPower n α * C := by ring
    _ ≤ rigidityPower n α * rigidityPower n (β - α) :=
      mul_le_mul_of_nonneg_left hlargeN (rigidityPower_nonneg n α)
    _ = rigidityPower n (α + (β - α)) :=
      (rigidityPower_add hn α (β - α)).symm
    _ = rigidityPower n β := by ring_nf

lemma eventually_rigidityPower_le_const_mul
    (C α β : ℝ) (hC : 0 < C) (hαβ : α < β) :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n α ≤ C * rigidityPower n β := by
  have h := eventually_const_mul_rigidityPower_le C⁻¹ α β hαβ
  filter_upwards [h] with n hn
  have hp := rigidityPower_nonneg n α
  calc
    rigidityPower n α = C * (C⁻¹ * rigidityPower n α) := by
      field_simp
    _ ≤ C * rigidityPower n β :=
      mul_le_mul_of_nonneg_left hn hC.le

lemma natFloor_rigidityPower_upper (n : ℕ) (α : ℝ) :
    ((⌊rigidityPower n α⌋₊ : ℕ) : ℝ) ≤ rigidityPower n α :=
  Nat.floor_le (rigidityPower_nonneg n α)

lemma eventually_half_rigidityPower_le_natFloor {α : ℝ} (hα : 0 < α) :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n α / 2 ≤ ((⌊rigidityPower n α⌋₊ : ℕ) : ℝ) := by
  have htwo := (tendsto_rigidityPower_atTop hα).eventually
    (eventually_ge_atTop (2 : ℝ))
  filter_upwards [htwo] with n hn
  have hfloor := Nat.lt_floor_add_one (rigidityPower n α)
  push_cast at hfloor
  linarith

lemma natCeil_rigidityPower_lower (C : ℝ) (n : ℕ) (α : ℝ) :
    C * rigidityPower n α ≤
      ((⌈C * rigidityPower n α⌉₊ : ℕ) : ℝ) :=
  Nat.le_ceil _

lemma eventually_natCeil_rigidityPower_le
    (C α : ℝ) (hC : 0 < C) (hα : 0 < α) :
    ∀ᶠ n : ℕ in atTop,
      ((⌈C * rigidityPower n α⌉₊ : ℕ) : ℝ) ≤
        2 * C * rigidityPower n α := by
  have hone : ∀ᶠ n : ℕ in atTop,
      1 ≤ C * rigidityPower n α := by
    have h := (tendsto_rigidityPower_atTop hα).const_mul_atTop hC
    exact h.eventually (eventually_ge_atTop (1 : ℝ))
  filter_upwards [hone] with n hn
  have hceil := Nat.ceil_lt_add_one
    (show 0 ≤ C * rigidityPower n α by positivity)
  exact hceil.le.trans (by linarith)

noncomputable def rigiditySmoothScale (n : ℕ) : ℝ :=
  rigidityPower n rigiditySmoothExponent

noncomputable def rigidityEpsilonScale (m n : ℕ) : ℝ :=
  rigidityPower n (-rigidityEpsilonExponent m)

noncomputable def rigidityEnergyScale (n : ℕ) : ℝ :=
  rigidityPower n rigidityEnergyExponent

noncomputable def rigidityGoodThresholdScale (n : ℕ) : ℝ :=
  rigidityPower n (-rigidityGoodThresholdExponent)

noncomputable def rigidityDirichletScale (m n : ℕ) : ℕ :=
  ⌊rigidityPower n (rigidityDirichletExponent m)⌋₊

noncomputable def rigidityPropagationScale (m n : ℕ) : ℕ :=
  ⌈4000 * rigidityPower n (rigidityPropagationExponent m)⌉₊

noncomputable def rigidityDilationStepScale (m n : ℕ) : ℕ :=
  ⌊rigidityPower n (rigidityDilationStepExponent m)⌋₊

noncomputable def rigidityBlockScale (n : ℕ) : ℕ :=
  ⌊rigidityPower n rigidityBlockExponent⌋₊

noncomputable def rigidityCoreScale (n : ℕ) : ℕ :=
  ⌊rigidityPower n rigidityBlockExponent / 10⌋₊

noncomputable def rigidityLocationScale (n : ℕ) : ℝ :=
  20 * rigidityPower n (1 - rigidityBlockExponent)

lemma rigidityPropagationExponent_pos {m : ℕ} (hm : 0 < m) :
    0 < rigidityPropagationExponent m := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hmone : (1 : ℝ) ≤ m := by exact_mod_cast hm
  unfold rigidityPropagationExponent rigidityEpsilonExponent
  field_simp
  nlinarith

lemma rigidityDilationStepExponent_pos {m : ℕ} (hm : 0 < m) :
    0 < rigidityDilationStepExponent m := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hmone : (1 : ℝ) ≤ m := by exact_mod_cast hm
  unfold rigidityDilationStepExponent rigidityDilationLossExponent
  field_simp
  nlinarith

lemma tendsto_rigidityEpsilonScale_zero {m : ℕ} (hm : 0 < m) :
    Tendsto (rigidityEpsilonScale m) atTop (𝓝 0) := by
  unfold rigidityEpsilonScale rigidityPower
  exact (tendsto_rpow_neg_atTop (rigidityEpsilonExponent_pos hm)).comp
    tendsto_natCast_atTop_atTop

lemma tendsto_rigidityGoodThresholdScale_zero :
    Tendsto rigidityGoodThresholdScale atTop (𝓝 0) := by
  unfold rigidityGoodThresholdScale rigidityPower
  exact (tendsto_rpow_neg_atTop (by
    norm_num [rigidityGoodThresholdExponent])).comp
      tendsto_natCast_atTop_atTop

lemma tendsto_rigidityEnergyScale_atTop :
    Tendsto rigidityEnergyScale atTop atTop := by
  unfold rigidityEnergyScale
  exact tendsto_rigidityPower_atTop (by norm_num [rigidityEnergyExponent])

lemma tendsto_rigidityDirichletScale_atTop {m : ℕ} (hm : 0 < m) :
    Tendsto (rigidityDirichletScale m) atTop atTop := by
  unfold rigidityDirichletScale
  exact tendsto_nat_floor_atTop.comp
    (tendsto_rigidityPower_atTop (rigidityDirichletExponent_pos hm))

lemma tendsto_rigidityPropagationScale_atTop {m : ℕ} (hm : 0 < m) :
    Tendsto (rigidityPropagationScale m) atTop atTop := by
  unfold rigidityPropagationScale
  exact tendsto_nat_ceil_atTop.comp
    ((tendsto_rigidityPower_atTop (rigidityPropagationExponent_pos hm)).const_mul_atTop
      (by norm_num))

lemma tendsto_rigidityDilationStepScale_atTop {m : ℕ} (hm : 0 < m) :
    Tendsto (rigidityDilationStepScale m) atTop atTop := by
  unfold rigidityDilationStepScale
  exact tendsto_nat_floor_atTop.comp
    (tendsto_rigidityPower_atTop (rigidityDilationStepExponent_pos hm))

lemma tendsto_rigidityBlockScale_atTop :
    Tendsto rigidityBlockScale atTop atTop := by
  unfold rigidityBlockScale
  exact tendsto_nat_floor_atTop.comp
    (tendsto_rigidityPower_atTop (by norm_num [rigidityBlockExponent]))

lemma tendsto_rigidityCoreScale_atTop :
    Tendsto rigidityCoreScale atTop atTop := by
  unfold rigidityCoreScale
  apply tendsto_nat_floor_atTop.comp
  have h := tendsto_rigidityPower_atTop
    (α := rigidityBlockExponent)
    (by norm_num [rigidityBlockExponent])
  have h' := Tendsto.atTop_mul_const
    (by norm_num : (0 : ℝ) < 1 / 10) h
  simpa [div_eq_mul_inv] using h'

lemma eventually_rigidity_scale_positivity {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      0 < n ∧
      0 < rigidityDirichletScale m n ∧
      800 ≤ rigidityPropagationScale m n ∧
      800 ≤ rigidityDilationStepScale m n ∧
      0 < rigidityBlockScale n ∧
      0 < rigidityCoreScale n ∧
      0 < rigidityEpsilonScale m n ∧
      rigidityEpsilonScale m n < 1 / 16 ∧
      0 < rigidityGoodThresholdScale n ∧
      0 < rigidityEnergyScale n ∧
      0 ≤ rigidityLocationScale n := by
  have hQ := (tendsto_rigidityDirichletScale_atTop hm).eventually
    (eventually_gt_atTop 0)
  have hR := (tendsto_rigidityPropagationScale_atTop hm).eventually
    (eventually_ge_atTop 800)
  have hq := (tendsto_rigidityDilationStepScale_atTop hm).eventually
    (eventually_ge_atTop 800)
  have hW := tendsto_rigidityBlockScale_atTop.eventually (eventually_gt_atTop 0)
  have hH := tendsto_rigidityCoreScale_atTop.eventually (eventually_gt_atTop 0)
  have hε := (tendsto_rigidityEpsilonScale_zero hm).eventually
    (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 16))
  filter_upwards [Nat.eventually_pos, hQ, hR, hq, hW, hH, hε]
    with n hn hQn hRn hqn hWn hHn hεn
  refine ⟨hn, hQn, hRn, hqn, hWn, hHn, ?_, hεn, ?_, ?_, ?_⟩
  · exact rigidityPower_pos hn _
  · exact rigidityPower_pos hn _
  · exact rigidityPower_pos hn _
  · unfold rigidityLocationScale
    exact mul_nonneg (by norm_num) (rigidityPower_nonneg n _)

lemma rigidityDirichletScale_cast_upper (m n : ℕ) :
    (rigidityDirichletScale m n : ℝ) ≤
      rigidityPower n (rigidityDirichletExponent m) := by
  exact natFloor_rigidityPower_upper n _

lemma rigidityDilationStepScale_cast_upper (m n : ℕ) :
    (rigidityDilationStepScale m n : ℝ) ≤
      rigidityPower n (rigidityDilationStepExponent m) := by
  exact natFloor_rigidityPower_upper n _

lemma rigidityBlockScale_cast_upper (n : ℕ) :
    (rigidityBlockScale n : ℝ) ≤
      rigidityPower n rigidityBlockExponent := by
  exact natFloor_rigidityPower_upper n _

lemma rigidityCoreScale_cast_upper (n : ℕ) :
    (rigidityCoreScale n : ℝ) ≤
      rigidityPower n rigidityBlockExponent / 10 := by
  unfold rigidityCoreScale
  exact Nat.floor_le
    (div_nonneg (rigidityPower_nonneg n rigidityBlockExponent) (by norm_num))

lemma eventually_half_rigidityPower_le_blockScale :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n rigidityBlockExponent / 2 ≤
        (rigidityBlockScale n : ℝ) := by
  exact eventually_half_rigidityPower_le_natFloor
    (by norm_num [rigidityBlockExponent])

lemma eventually_half_rigidityPower_le_dirichletScale
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n (rigidityDirichletExponent m) / 2 ≤
        (rigidityDirichletScale m n : ℝ) := by
  exact eventually_half_rigidityPower_le_natFloor
    (rigidityDirichletExponent_pos hm)

lemma eventually_rigidityDilationStepScale_cast_lower {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n (rigidityDilationStepExponent m) / 2 ≤
        (rigidityDilationStepScale m n : ℝ) := by
  exact eventually_half_rigidityPower_le_natFloor
    (rigidityDilationStepExponent_pos hm)

lemma eventually_rigidityCoreScale_cast_lower :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n rigidityBlockExponent / 20 ≤
        (rigidityCoreScale n : ℝ) := by
  have hlarge := (tendsto_rigidityPower_atTop
    (α := rigidityBlockExponent)
    (by norm_num [rigidityBlockExponent])).eventually
      (eventually_ge_atTop (20 : ℝ))
  filter_upwards [hlarge] with n hn
  have hfloor := Nat.lt_floor_add_one
    (rigidityPower n rigidityBlockExponent / 10)
  change rigidityPower n rigidityBlockExponent / 20 ≤
    ((⌊rigidityPower n rigidityBlockExponent / 10⌋₊ : ℕ) : ℝ)
  push_cast at hfloor
  linarith

lemma eventually_rigidityPropagationScale_cast_upper {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      (rigidityPropagationScale m n : ℝ) ≤
        8000 * rigidityPower n (rigidityPropagationExponent m) := by
  have h := eventually_natCeil_rigidityPower_le 4000
    (rigidityPropagationExponent m) (by norm_num)
    (rigidityPropagationExponent_pos hm)
  filter_upwards [h] with n hn
  change ((⌈4000 * rigidityPower n (rigidityPropagationExponent m)⌉₊ : ℕ) : ℝ) ≤
    8000 * rigidityPower n (rigidityPropagationExponent m)
  norm_num at hn ⊢
  exact hn

lemma rigidityDirichletScale_pow_le_smooth
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    rigidityDirichletScale m n ^ (2 * m) ≤
      Nat.floor (rigiditySmoothScale n) + 1 := by
  have hnbase : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hQ := rigidityDirichletScale_cast_upper m n
  have hpowCast :
      ((rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) ≤
        (rigidityPower n (rigidityDirichletExponent m)) ^ (2 * m) := by
    push_cast
    exact pow_le_pow_left₀ (by positivity) hQ _
  have hpowEq :
      (rigidityPower n (rigidityDirichletExponent m)) ^ (2 * m) =
        rigidityPower n (1 / 20) := by
    have hmul := rigidityPower_mul hn
      (rigidityDirichletExponent m) (2 * m : ℕ)
    have hexp : rigidityDirichletExponent m * ((2 * m : ℕ) : ℝ) =
        1 / 20 := by
      have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
      unfold rigidityDirichletExponent
      push_cast
      field_simp
      ring
    rw [hexp] at hmul
    calc
      (rigidityPower n (rigidityDirichletExponent m)) ^ (2 * m) =
          (rigidityPower n (rigidityDirichletExponent m)) ^
            (((2 * m : ℕ) : ℝ)) :=
        (Real.rpow_natCast _ _).symm
      _ = rigidityPower n (1 / 20) := hmul.symm
  have hsmooth : rigidityPower n (1 / 20) ≤ rigiditySmoothScale n := by
    unfold rigidityPower rigiditySmoothScale rigiditySmoothExponent
    exact Real.rpow_le_rpow_of_exponent_le hnbase (by norm_num)
  have hcast :
      ((rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) ≤
        rigiditySmoothScale n := by
    exact hpowCast.trans (hpowEq.le.trans hsmooth)
  have hfloor : rigidityDirichletScale m n ^ (2 * m) ≤
      Nat.floor (rigiditySmoothScale n) := Nat.le_floor hcast
  omega

lemma rigidityDirichletScale_pow_cast_upper
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    ((rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) ≤
      rigidityPower n (1 / 20) := by
  have hQ := rigidityDirichletScale_cast_upper m n
  have hpow :
      ((rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) ≤
        (rigidityPower n (rigidityDirichletExponent m)) ^ (2 * m) := by
    push_cast
    exact pow_le_pow_left₀ (by positivity) hQ _
  have hmul := rigidityPower_mul hn
    (rigidityDirichletExponent m) (2 * m : ℕ)
  have hexp : rigidityDirichletExponent m * ((2 * m : ℕ) : ℝ) =
      1 / 20 := by
    have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
    unfold rigidityDirichletExponent
    push_cast
    field_simp
    ring
  rw [hexp] at hmul
  calc
    ((rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) ≤
        (rigidityPower n (rigidityDirichletExponent m)) ^ (2 * m) := hpow
    _ = (rigidityPower n (rigidityDirichletExponent m)) ^
          (((2 * m : ℕ) : ℝ)) := (Real.rpow_natCast _ _).symm
    _ = rigidityPower n (1 / 20) := hmul.symm

lemma individualDilationGap_le_one (q : ℕ) (rho : ℝ) :
    individualDilationGap q rho ≤ 1 := by
  unfold individualDilationGap
  calc
    4 * min (1 / 64) ((q : ℝ) * rho / 8000) ≤ 4 * (1 / 64) := by
      exact mul_le_mul_of_nonneg_left (min_le_left _ _) (by norm_num)
    _ ≤ 1 := by norm_num

lemma individualDilationGap_nonneg (q : ℕ) {rho : ℝ} (hrho : 0 ≤ rho) :
    0 ≤ individualDilationGap q rho := by
  unfold individualDilationGap
  exact mul_nonneg (by norm_num)
    (le_min (by norm_num)
      (div_nonneg (mul_nonneg (Nat.cast_nonneg _) hrho) (by norm_num)))

lemma rigidity_propagation_scale_condition
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    4000 * rigidityEpsilonScale m n /
        rigidityPropagationScale m n ≤
      rigiditySmoothScale n / n := by
  let x : ℝ := rigidityEpsilonExponent m
  let r : ℝ := rigidityPropagationExponent m
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hpowPos : 0 < rigidityPower n r := rigidityPower_pos hn r
  have hRlower : 4000 * rigidityPower n r ≤
      (rigidityPropagationScale m n : ℝ) := by
    exact natCeil_rigidityPower_lower 4000 n r
  have hRpos : (0 : ℝ) < rigidityPropagationScale m n :=
    (mul_pos (by norm_num) hpowPos).trans_le hRlower
  have hnum : 0 ≤ 4000 * rigidityPower n (-x) :=
    mul_nonneg (by norm_num) (rigidityPower_nonneg n _)
  calc
    4000 * rigidityEpsilonScale m n /
          rigidityPropagationScale m n =
        4000 * rigidityPower n (-x) /
          (rigidityPropagationScale m n : ℝ) := by
            rfl
    _ ≤ 4000 * rigidityPower n (-x) /
          (4000 * rigidityPower n r) := by
            exact div_le_div_of_nonneg_left hnum
              (mul_pos (by norm_num) hpowPos) hRlower
    _ = rigidityPower n ((-x) - r) := by
      rw [show 4000 * rigidityPower n (-x) /
          (4000 * rigidityPower n r) =
          rigidityPower n (-x) / rigidityPower n r by field_simp]
      exact (Real.rpow_sub hnreal (-x) r).symm
    _ = rigidityPower n (rigiditySmoothExponent - 1) := by
      congr 1
      dsimp [x, r]
      unfold rigidityPropagationExponent rigiditySmoothExponent
      ring
    _ = rigiditySmoothScale n / (n : ℝ) := by
      unfold rigiditySmoothScale rigidityPower
      simpa using Real.rpow_sub hnreal rigiditySmoothExponent 1

lemma eventually_rigidity_fit_condition {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      2 * rigidityCoreScale n +
          2 * (phaseTwistCount m * rigidityDilationStepScale m n) +
          2 * rigidityDifferenceOrder m *
            (rigidityPropagationScale m n *
              rigidityDirichletScale m n ^ (2 * m)) ≤
        rigidityBlockScale n := by
  have hqexp := rigidity_dilationStep_lt_block hm
  have hprodexp := rigidity_propagation_dirichlet_lt_block hm
  have hqsmall := eventually_const_mul_rigidityPower_le
    (40 * (phaseTwistCount m : ℝ))
    (rigidityDilationStepExponent m) rigidityBlockExponent hqexp
  have hprodsmall := eventually_const_mul_rigidityPower_le
    (320000 * (rigidityDifferenceOrder m : ℝ))
    (rigidityPropagationExponent m + 1 / 20)
    rigidityBlockExponent (by
      have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
      have heq : ((2 * m : ℕ) : ℝ) * rigidityDirichletExponent m =
          1 / 20 := by
        unfold rigidityDirichletExponent
        push_cast
        field_simp
        ring
      rw [heq] at hprodexp
      exact hprodexp)
  filter_upwards [Nat.eventually_pos,
      eventually_half_rigidityPower_le_blockScale,
      eventually_rigidityPropagationScale_cast_upper hm,
      hqsmall, hprodsmall]
    with n hn hWlower hRupper hqsmallN hprodsmallN
  let P : ℝ := rigidityPower n rigidityBlockExponent
  have hP0 : 0 ≤ P := rigidityPower_nonneg n _
  have hH : (rigidityCoreScale n : ℝ) ≤ P / 10 := by
    simpa [P] using rigidityCoreScale_cast_upper n
  have hqUpper : (rigidityDilationStepScale m n : ℝ) ≤
      rigidityPower n (rigidityDilationStepExponent m) :=
    rigidityDilationStepScale_cast_upper m n
  have hqterm :
      (2 * (phaseTwistCount m * rigidityDilationStepScale m n) : ℕ) ≤
        P / 20 := by
    push_cast
    have hmul := mul_le_mul_of_nonneg_left hqUpper
      (by positivity : 0 ≤ 2 * (phaseTwistCount m : ℝ))
    have hscaled :
        2 * (phaseTwistCount m : ℝ) *
            rigidityPower n (rigidityDilationStepExponent m) ≤ P / 20 := by
      have := hqsmallN
      dsimp [P] at *
      nlinarith [rigidityPower_nonneg n (rigidityDilationStepExponent m)]
    simpa only [mul_assoc] using hmul.trans hscaled
  have hQpow := rigidityDirichletScale_pow_cast_upper hm hn
  have hQpow' :
      (rigidityDirichletScale m n : ℝ) ^ (2 * m) ≤
        rigidityPower n (1 / 20) := by
    simpa only [Nat.cast_pow] using hQpow
  have hRQ :
      ((rigidityPropagationScale m n *
          rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) ≤
        8000 * rigidityPower n
          (rigidityPropagationExponent m + 1 / 20) := by
    push_cast
    calc
      (rigidityPropagationScale m n : ℝ) *
          (rigidityDirichletScale m n : ℝ) ^ (2 * m) ≤
        (8000 * rigidityPower n (rigidityPropagationExponent m)) *
          rigidityPower n (1 / 20) :=
            mul_le_mul hRupper hQpow'
              (pow_nonneg (Nat.cast_nonneg _) _)
              (mul_nonneg (by norm_num)
                (rigidityPower_nonneg n (rigidityPropagationExponent m)))
      _ = 8000 * rigidityPower n
          (rigidityPropagationExponent m + 1 / 20) := by
            rw [rigidityPower_add hn]
            ring
  have hprodterm :
      ((2 * rigidityDifferenceOrder m *
          (rigidityPropagationScale m n *
            rigidityDirichletScale m n ^ (2 * m)) : ℕ) : ℝ) ≤
        P / 20 := by
    push_cast
    have hmul := mul_le_mul_of_nonneg_left hRQ
      (by positivity : 0 ≤ 2 * (rigidityDifferenceOrder m : ℝ))
    have hscaled :
        2 * (rigidityDifferenceOrder m : ℝ) *
            (8000 * rigidityPower n
              (rigidityPropagationExponent m + 1 / 20)) ≤ P / 20 := by
      have := hprodsmallN
      dsimp [P] at *
      nlinarith [rigidityPower_nonneg n
        (rigidityPropagationExponent m + 1 / 20)]
    simpa only [Nat.cast_mul, Nat.cast_ofNat, Nat.cast_pow, mul_assoc] using
      hmul.trans hscaled
  have hcast :
      ((2 * rigidityCoreScale n +
          2 * (phaseTwistCount m * rigidityDilationStepScale m n) +
          2 * rigidityDifferenceOrder m *
            (rigidityPropagationScale m n *
              rigidityDirichletScale m n ^ (2 * m)) : ℕ) : ℝ) ≤
        (rigidityBlockScale n : ℝ) := by
    push_cast
    have hW : P / 2 ≤ (rigidityBlockScale n : ℝ) := by simpa [P] using hWlower
    calc
      2 * (rigidityCoreScale n : ℝ) +
          2 * ((phaseTwistCount m : ℝ) *
            (rigidityDilationStepScale m n : ℝ)) +
          2 * (rigidityDifferenceOrder m : ℝ) *
            ((rigidityPropagationScale m n : ℝ) *
              (rigidityDirichletScale m n : ℝ) ^ (2 * m)) ≤
        2 * (P / 10) + P / 20 + P / 20 := by
          have hHterm : 2 * (rigidityCoreScale n : ℝ) ≤ 2 * (P / 10) := by
            gcongr
          have hqterm' :
              2 * ((phaseTwistCount m : ℝ) *
                (rigidityDilationStepScale m n : ℝ)) ≤ P / 20 := by
            simpa only [Nat.cast_mul, Nat.cast_ofNat, mul_assoc] using hqterm
          have hprodterm' :
              2 * (rigidityDifferenceOrder m : ℝ) *
                ((rigidityPropagationScale m n : ℝ) *
                  (rigidityDirichletScale m n : ℝ) ^ (2 * m)) ≤ P / 20 := by
            simpa only [Nat.cast_mul, Nat.cast_ofNat, Nat.cast_pow, mul_assoc] using
              hprodterm
          exact add_le_add (add_le_add hHterm hqterm') hprodterm'
      _ ≤ P / 2 := by linarith
      _ ≤ (rigidityBlockScale n : ℝ) := hW
  exact_mod_cast hcast

lemma eventually_rigidity_location_condition :
    ∀ᶠ n : ℕ in atTop,
      (n : ℝ) ≤ rigidityLocationScale n * rigidityCoreScale n := by
  filter_upwards [Nat.eventually_pos, eventually_rigidityCoreScale_cast_lower]
    with n hn hHlower
  have hloc0 : 0 ≤ rigidityLocationScale n := by
    unfold rigidityLocationScale
    exact mul_nonneg (by norm_num) (rigidityPower_nonneg n _)
  calc
    (n : ℝ) = rigidityPower n 1 := by
      simp [rigidityPower]
    _ = (20 * rigidityPower n (1 - rigidityBlockExponent)) *
          (rigidityPower n rigidityBlockExponent / 20) := by
      symm
      calc
        (20 * rigidityPower n (1 - rigidityBlockExponent)) *
            (rigidityPower n rigidityBlockExponent / 20) =
          rigidityPower n (1 - rigidityBlockExponent) *
            rigidityPower n rigidityBlockExponent := by ring
        _ = rigidityPower n
            ((1 - rigidityBlockExponent) + rigidityBlockExponent) :=
          (rigidityPower_add hn _ _).symm
        _ = rigidityPower n 1 := by ring_nf
    _ ≤ rigidityLocationScale n * (rigidityCoreScale n : ℝ) := by
      unfold rigidityLocationScale
      exact mul_le_mul_of_nonneg_left hHlower hloc0

lemma rigidityEnergy_div_goodThreshold_sq
    {n : ℕ} (hn : 0 < n) :
    rigidityEnergyScale n / rigidityGoodThresholdScale n ^ 2 =
      rigidityPower n
        (rigidityEnergyExponent + 2 * rigidityGoodThresholdExponent) := by
  unfold rigidityEnergyScale rigidityGoodThresholdScale
  rw [rigidityPower_nat_pow hn]
  rw [show (-rigidityGoodThresholdExponent) * (2 : ℕ) =
      -(2 * rigidityGoodThresholdExponent) by push_cast; ring]
  calc
    rigidityPower n rigidityEnergyExponent /
        rigidityPower n (-(2 * rigidityGoodThresholdExponent)) =
      rigidityPower n
        (rigidityEnergyExponent - (-(2 * rigidityGoodThresholdExponent))) :=
      (Real.rpow_sub (by exact_mod_cast hn)
        rigidityEnergyExponent (-(2 * rigidityGoodThresholdExponent))).symm
    _ = rigidityPower n
        (rigidityEnergyExponent + 2 * rigidityGoodThresholdExponent) := by
      congr 1
      ring

lemma eventually_rigidity_block_condition :
    ∀ᶠ n : ℕ in atTop,
      (rigidityBlockScale n : ℝ) *
          (rigidityEnergyScale n / rigidityGoodThresholdScale n ^ 2 + 1) ≤
        2 * n + 1 := by
  let β : ℝ := rigidityBlockExponent + rigidityEnergyExponent +
    2 * rigidityGoodThresholdExponent
  have hβ : β < 1 := by
    simpa [β] using rigidity_good_block_margin
  have hβsmall := eventually_const_mul_rigidityPower_le 2 β 1 hβ
  have hb : rigidityBlockExponent < (1 : ℝ) := by
    norm_num [rigidityBlockExponent]
  have hbsmall := eventually_const_mul_rigidityPower_le
    2 rigidityBlockExponent 1 hb
  filter_upwards [Nat.eventually_pos, hβsmall, hbsmall]
    with n hn hβn hbn
  have hW := rigidityBlockScale_cast_upper n
  have hfactor0 : 0 ≤
      rigidityEnergyScale n / rigidityGoodThresholdScale n ^ 2 + 1 := by
    exact add_nonneg
      (div_nonneg (rigidityPower_nonneg n _)
        (sq_nonneg (rigidityGoodThresholdScale n))) (by norm_num)
  calc
    (rigidityBlockScale n : ℝ) *
          (rigidityEnergyScale n / rigidityGoodThresholdScale n ^ 2 + 1) ≤
        rigidityPower n rigidityBlockExponent *
          (rigidityEnergyScale n / rigidityGoodThresholdScale n ^ 2 + 1) :=
      mul_le_mul_of_nonneg_right hW hfactor0
    _ = rigidityPower n β + rigidityPower n rigidityBlockExponent := by
      rw [rigidityEnergy_div_goodThreshold_sq hn]
      dsimp [β]
      have hp :
          rigidityPower n rigidityBlockExponent *
              rigidityPower n
                (rigidityEnergyExponent + 2 * rigidityGoodThresholdExponent) =
            rigidityPower n
              (rigidityBlockExponent + rigidityEnergyExponent +
                2 * rigidityGoodThresholdExponent) := by
        calc
          rigidityPower n rigidityBlockExponent *
                rigidityPower n
                  (rigidityEnergyExponent + 2 * rigidityGoodThresholdExponent) =
              rigidityPower n
                (rigidityBlockExponent +
                  (rigidityEnergyExponent + 2 * rigidityGoodThresholdExponent)) :=
            (rigidityPower_add hn _ _).symm
          _ = rigidityPower n
                (rigidityBlockExponent + rigidityEnergyExponent +
                  2 * rigidityGoodThresholdExponent) := by
            congr 1
            ring
      rw [mul_add, mul_one, hp]
    _ ≤ rigidityPower n 1 / 2 + rigidityPower n 1 / 2 := by
      exact add_le_add (by nlinarith) (by nlinarith)
    _ = (n : ℝ) := by simp [rigidityPower]
    _ ≤ 2 * n + 1 := by
      have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      linarith

lemma rigiditySmoothScale_div_eq_power
    {n : ℕ} (hn : 0 < n) :
    rigiditySmoothScale n / n =
      rigidityPower n (rigiditySmoothExponent - 1) := by
  unfold rigiditySmoothScale rigidityPower
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  simpa using (Real.rpow_sub hnreal rigiditySmoothExponent 1).symm

lemma eventually_phaseCovarianceLoss_le (m : ℕ) :
    ∀ᶠ n : ℕ in atTop,
      (6 / (4 * (rigiditySmoothScale n / n))) * (4 * m : ℝ) ^ 2 ≤
        (2 * n + 1 : ℝ) / 12 := by
  have hpower := eventually_const_mul_rigidityPower_le
    (288 * (m : ℝ) ^ 2) (15 / 16) 1 (by norm_num)
  filter_upwards [Nat.eventually_pos, hpower] with n hn hpowerN
  let rho : ℝ := rigiditySmoothScale n / n
  have hrho : rho = rigidityPower n (-15 / 16) := by
    calc
      rho = rigidityPower n (rigiditySmoothExponent - 1) :=
        rigiditySmoothScale_div_eq_power hn
      _ = rigidityPower n (-15 / 16) := by
        congr 1
        unfold rigiditySmoothExponent
        ring
  have hrhoPos : 0 < rho := by rw [hrho]; exact rigidityPower_pos hn _
  have hinv : 1 / rho = rigidityPower n (15 / 16) := by
    rw [hrho]
    unfold rigidityPower
    rw [show (-15 / 16 : ℝ) = -(15 / 16) by ring,
      Real.rpow_neg (by exact_mod_cast hn.le)]
    field_simp
  have hnPower : rigidityPower n 1 = (n : ℝ) := by
    simp [rigidityPower]
  rw [hnPower] at hpowerN
  have hloss :
      (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 =
        24 * (m : ℝ) ^ 2 * rigidityPower n (15 / 16) := by
    rw [show 6 / (4 * rho) = (3 / 2) * (1 / rho) by
      field_simp [hrhoPos.ne']
      ring]
    rw [hinv]
    push_cast
    ring
  change (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 ≤ (2 * n + 1 : ℝ) / 12
  rw [hloss]
  push_cast at hpowerN ⊢
  nlinarith

theorem eventually_hasPhaseCovarianceLower_rigidity (m : ℕ) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      HasPhaseCovarianceLower n points (1 / 12) := by
  filter_upwards [Nat.eventually_pos, eventually_phaseCovarianceLoss_le m]
    with n hn hloss
  intro points hsmooth hspread u
  let rho : ℝ := rigiditySmoothScale n / n
  have hscale : 0 < rigiditySmoothScale n := by
    unfold rigiditySmoothScale
    exact rigidityPower_pos hn _
  have hrhoPos : 0 < rho := by
    dsimp [rho]
    positivity
  have henergy := phaseProjection_energy_lower_of_smooth_spread
    n hn (rigiditySmoothScale n) (rigiditySmoothScale n) points
    hsmooth hspread rho (by simp [rho]) hrhoPos u
  have hcoef : (1 / 12 : ℝ) * (2 * n + 1 : ℝ) ≤
      (2 * n + 1 : ℝ) / 6 - (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 := by
    have hloss' : (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 ≤
        (2 * n + 1 : ℝ) / 12 := by simpa [rho] using hloss
    linarith
  calc
    (1 / 12 : ℝ) * (2 * n + 1 : ℝ) * phaseNormSq u ≤
        ((2 * n + 1 : ℝ) / 6 -
          (6 / (4 * rho)) * (4 * m : ℝ) ^ 2) * phaseNormSq u :=
      mul_le_mul_of_nonneg_right hcoef (phaseNormSq_nonneg u)
    _ ≤ ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 := henergy

noncomputable def phaseNoWrapRadius (n m : ℕ) : ℝ :=
  Real.pi * Real.sqrt (2 * n + 1 : ℝ) / (16 * (m + 1 : ℕ))

lemma normalizedPhase_no_wrap_of_norm_le
    (n m : ℕ) (u : PhaseCoordinate m)
    (hu : ‖phaseToEuclidean u‖ ≤ phaseNoWrapRadius n m) :
    |(Real.sqrt (2 * n + 1 : ℝ))⁻¹| *
        (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2 := by
  let C : ℝ := 2 * n + 1
  let R : ℝ := Real.pi * Real.sqrt C / (16 * (m + 1 : ℕ))
  have hC : 0 < C := by dsimp [C]; positivity
  have hsqrt : 0 < Real.sqrt C := Real.sqrt_pos.2 hC
  have hpi : 0 < Real.pi := Real.pi_pos
  have hm1 : (0 : ℝ) < (m + 1 : ℕ) := by positivity
  have hL := phaseL1_le_dim_mul_euclideanNorm u
  have hnorm : ‖phaseToEuclidean u‖ ≤ R := by
    simpa [phaseNoWrapRadius, C, R] using hu
  have hfour : (0 : ℝ) ≤ 4 * m := by positivity
  have hscaled : (4 * m : ℝ) * ‖phaseToEuclidean u‖ ≤
      (4 * m : ℝ) * R := mul_le_mul_of_nonneg_left hnorm hfour
  have hbound :
      |(Real.sqrt C)⁻¹| *
          (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi ≤
        |(Real.sqrt C)⁻¹| * ((4 * m : ℝ) * R) / Real.pi := by
    exact div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (hL.trans hscaled) (abs_nonneg _)) hpi.le
  have heq :
      |(Real.sqrt C)⁻¹| * ((4 * m : ℝ) * R) / Real.pi =
        (m : ℝ) / (4 * (m + 1 : ℕ)) := by
    rw [abs_of_pos (inv_pos.mpr hsqrt)]
    dsimp [R]
    field_simp [hsqrt.ne', hpi.ne', hm1.ne']
    push_cast
    ring
  have hratio : (m : ℝ) / (4 * (m + 1 : ℕ)) < 1 / 2 := by
    rw [div_lt_iff₀ (by positivity : (0 : ℝ) < 4 * (m + 1 : ℕ))]
    push_cast
    nlinarith
  change |(Real.sqrt C)⁻¹| *
    (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2
  exact hbound.trans_lt (heq.trans_lt hratio)

theorem eventually_norm_normalizedPhaseCharFun_fixedGaussian
    (m : ℕ) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (u : PhaseCoordinate m),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ‖phaseToEuclidean u‖ ≤ phaseNoWrapRadius n m →
      ‖normalizedPhaseCharFun n points u‖ ≤
        Real.exp (-(phaseNormSq u / (12 * Real.pi ^ 2))) := by
  filter_upwards [eventually_hasPhaseCovarianceLower_rigidity m] with n hcov
  intro points u hsmooth hspread hnorm
  exact norm_normalizedPhaseCharFun_le_fixedGaussian_of_covariance
    n points (hcov points hsmooth hspread) u
    (normalizedPhase_no_wrap_of_norm_le n m u hnorm)

lemma rigidityDilation_exponent_identity (m : ℕ) :
    rigidityDilationStepExponent m + rigiditySmoothExponent - 1 =
      -rigidityDilationLossExponent m := by
  unfold rigidityDilationStepExponent rigiditySmoothExponent
  ring

lemma eventually_rigidity_individualDilationGap_lower
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      rigidityPower n (-rigidityDilationLossExponent m) / 4000 ≤
        individualDilationGap (rigidityDilationStepScale m n)
          (rigiditySmoothScale n / n) := by
  filter_upwards [Nat.eventually_pos,
      eventually_rigidityDilationStepScale_cast_lower hm]
    with n hn hqLower
  let d : ℝ := rigidityDilationLossExponent m
  let qexp : ℝ := rigidityDilationStepExponent m
  let rho : ℝ := rigiditySmoothScale n / n
  have hnbase : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hrho : rho = rigidityPower n (rigiditySmoothExponent - 1) := by
    simpa [rho] using rigiditySmoothScale_div_eq_power hn
  have hrhoPos : 0 < rho := by rw [hrho]; exact rigidityPower_pos hn _
  have hproduct :
      rigidityPower n (-d) / 2 ≤
        (rigidityDilationStepScale m n : ℝ) * rho := by
    have hmul := mul_le_mul_of_nonneg_right hqLower hrhoPos.le
    have hid :
        rigidityPower n qexp / 2 * rho = rigidityPower n (-d) / 2 := by
      rw [hrho]
      rw [show rigidityPower n qexp / 2 *
          rigidityPower n (rigiditySmoothExponent - 1) =
          (rigidityPower n qexp *
            rigidityPower n (rigiditySmoothExponent - 1)) / 2 by ring]
      rw [← rigidityPower_add hn]
      have hexp : qexp + (rigiditySmoothExponent - 1) = -d := by
        dsimp [qexp, d]
        linarith [rigidityDilation_exponent_identity m]
      rw [hexp]
    rw [hid] at hmul
    exact hmul
  have hpowOne : rigidityPower n (-d) ≤ 1 := by
    unfold rigidityPower
    have hd : 0 < d := by simpa [d] using rigidityDilationLossExponent_pos hm
    simpa using Real.rpow_le_rpow_of_exponent_le hnbase (show -d ≤ 0 by linarith)
  have hleft : rigidityPower n (-d) / 16000 ≤ (1 / 64 : ℝ) := by
    nlinarith [rigidityPower_nonneg n (-d)]
  have hright : rigidityPower n (-d) / 16000 ≤
      (rigidityDilationStepScale m n : ℝ) * rho / 8000 := by
    nlinarith
  unfold individualDilationGap
  change rigidityPower n (-d) / 4000 ≤
    4 * min (1 / 64) ((rigidityDilationStepScale m n : ℝ) * rho / 8000)
  have hmin := le_min hleft hright
  nlinarith

/-- If a chord is at most `2`, the sharp affine correction retained after
`k` double differences is bounded by the older coarse `4^k` correction. -/
lemma two_mul_pow_two_mul_sub_one_le_four_pow
    (x : ℝ) (hx0 : 0 ≤ x) (hx2 : x ≤ 2) (k : ℕ) (hk : 0 < k) :
    2 * x ^ (2 * k - 1) ≤ (4 : ℝ) ^ k := by
  have hpow : x ^ (2 * k - 1) ≤ (2 : ℝ) ^ (2 * k - 1) :=
    pow_le_pow_left₀ hx0 hx2 _
  calc
    2 * x ^ (2 * k - 1) ≤ 2 * (2 : ℝ) ^ (2 * k - 1) := by gcongr
    _ = (2 : ℝ) ^ (2 * k - 1 + 1) := by rw [pow_succ]; ring
    _ = (2 : ℝ) ^ (2 * k) := by congr 1 <;> omega
    _ = ((2 : ℝ) ^ 2) ^ k := by rw [pow_mul]
    _ = (4 : ℝ) ^ k := by norm_num

lemma eventually_rigidity_unwrap_condition {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ t : ℝ,
      |t| ≤ rigidityPower n (rigidityFourierExponent m) →
      (|t| / Real.pi) *
          ((4 * m : ℕ) *
            ((2 * Real.pi / rigidityDirichletScale m n) ^
                (2 * rigidityDifferenceOrder m) +
              2 * (rigidityDifferenceOrder m : ℝ) *
                ((rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n *
                (2 * Real.pi / rigidityDirichletScale m n) ^
                  (2 * rigidityDifferenceOrder m - 1))) +
        (2 : ℝ) ^ (2 * rigidityDifferenceOrder m) *
          rigidityGoodThresholdScale n < 1 := by
  let k : ℕ := rigidityDifferenceOrder m
  let β : ℝ := rigidityDirichletExponent m
  let αA : ℝ := rigidityFourierExponent m - 2 * (k : ℝ) * β
  let αB : ℝ := rigidityFourierExponent m + 1 / 20 - 1 -
    ((2 * k - 1 : ℕ) : ℝ) * β
  let αC : ℝ := -rigidityGoodThresholdExponent
  let CA : ℝ := (((4 * m : ℕ) : ℝ) / Real.pi) *
    (4 * Real.pi) ^ (2 * k)
  let CB : ℝ := (((4 * m : ℕ) : ℝ) / Real.pi) *
    (2 * (k : ℝ) * (4 * Real.pi) ^ (2 * k - 1))
  let CC : ℝ := (2 : ℝ) ^ (2 * k)
  have hαA : αA < 0 := by
    have hmargin := rigidity_unwrap_dirichlet_margin hm
    dsimp [αA, k, β]
    linarith
  have hαB : αB < 0 := by
    have hmargin := rigidity_unwrap_sharp_correction_margin hm
    simpa [αB, k, β] using hmargin
  have hαC : αC < 0 := by
    norm_num [αC, rigidityGoodThresholdExponent]
  have hAsmall := eventually_const_mul_rigidityPower_le
    (4 * CA) αA 0 hαA
  have hBsmall := eventually_const_mul_rigidityPower_le
    (4 * CB) αB 0 hαB
  have hCsmall := eventually_const_mul_rigidityPower_le
    (4 * CC) αC 0 hαC
  filter_upwards [Nat.eventually_pos,
      eventually_half_rigidityPower_le_dirichletScale hm,
      hAsmall, hBsmall, hCsmall]
    with n hn hQlower hAsmallN hBsmallN hCsmallN
  intro t ht
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hQpos : (0 : ℝ) < rigidityDirichletScale m n :=
    (div_pos (rigidityPower_pos hn β) (by norm_num)).trans_le hQlower
  have hQpow := rigidityDirichletScale_pow_cast_upper hm hn
  have hQpow' :
      (rigidityDirichletScale m n : ℝ) ^ (2 * m) ≤
        rigidityPower n (1 / 20) := by
    simpa only [Nat.cast_pow] using hQpow
  have hdir :
      2 * Real.pi / (rigidityDirichletScale m n : ℝ) ≤
        4 * Real.pi / rigidityPower n β := by
    have hnum : 0 ≤ 2 * Real.pi := by positivity
    calc
      2 * Real.pi / (rigidityDirichletScale m n : ℝ) ≤
          2 * Real.pi / (rigidityPower n β / 2) :=
        div_le_div_of_nonneg_left hnum
          (div_pos (rigidityPower_pos hn β) (by norm_num)) hQlower
      _ = 4 * Real.pi / rigidityPower n β := by ring
  have hdirPow :
      (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k) ≤
        (4 * Real.pi) ^ (2 * k) *
          rigidityPower n (-(β * (2 * k : ℕ))) := by
    calc
      (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k) ≤
          (4 * Real.pi / rigidityPower n β) ^ (2 * k) :=
        pow_le_pow_left₀ (by positivity) hdir _
      _ = (4 * Real.pi) ^ (2 * k) *
          rigidityPower n (-(β * (2 * k : ℕ))) :=
        constant_div_rigidityPower_nat_pow hn (4 * Real.pi) β (2 * k)
  have hdirPowSharp :
      (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k - 1) ≤
        (4 * Real.pi) ^ (2 * k - 1) *
          rigidityPower n (-(β * (2 * k - 1 : ℕ))) := by
    calc
      (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k - 1) ≤
          (4 * Real.pi / rigidityPower n β) ^ (2 * k - 1) :=
        pow_le_pow_left₀ (by positivity) hdir _
      _ = (4 * Real.pi) ^ (2 * k - 1) *
          rigidityPower n (-(β * (2 * k - 1 : ℕ))) :=
        constant_div_rigidityPower_nat_pow hn (4 * Real.pi) β (2 * k - 1)
  have htFac : |t| / Real.pi ≤
      rigidityPower n (rigidityFourierExponent m) / Real.pi := by
    exact div_le_div_of_nonneg_right ht Real.pi_pos.le
  have hA :
      (|t| / Real.pi) * ((4 * m : ℕ) : ℝ) *
          (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k) ≤
        CA * rigidityPower n αA := by
    have hprefix :
        (|t| / Real.pi) * ((4 * m : ℕ) : ℝ) ≤
          (rigidityPower n (rigidityFourierExponent m) / Real.pi) *
            ((4 * m : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_right htFac (Nat.cast_nonneg _)
    calc
      (|t| / Real.pi) * ((4 * m : ℕ) : ℝ) *
          (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k) ≤
        (rigidityPower n (rigidityFourierExponent m) / Real.pi) *
          ((4 * m : ℕ) : ℝ) *
          ((4 * Real.pi) ^ (2 * k) *
            rigidityPower n (-(β * (2 * k : ℕ)))) := by
              exact mul_le_mul hprefix hdirPow (by positivity)
                (mul_nonneg (div_nonneg (rigidityPower_nonneg n _) Real.pi_pos.le)
                  (Nat.cast_nonneg _))
      _ = CA * rigidityPower n αA := by
        have hexp : -(β * ((2 * k : ℕ) : ℝ)) =
            -(2 * (k : ℝ) * β) := by push_cast; ring
        have hp : rigidityPower n (rigidityFourierExponent m) *
              rigidityPower n (-(β * (2 * k : ℕ))) =
            rigidityPower n αA := by
          rw [hexp]
          dsimp [αA]
          calc
            rigidityPower n (rigidityFourierExponent m) *
                rigidityPower n (-(2 * (k : ℝ) * β)) =
              rigidityPower n
                (rigidityFourierExponent m + -(2 * (k : ℝ) * β)) :=
                (rigidityPower_add hn _ _).symm
            _ = rigidityPower n
                (rigidityFourierExponent m - 2 * (k : ℝ) * β) := by ring_nf
        calc
          (rigidityPower n (rigidityFourierExponent m) / Real.pi) *
            ((4 * m : ℕ) : ℝ) *
              ((4 * Real.pi) ^ (2 * k) *
                rigidityPower n (-(β * (2 * k : ℕ)))) =
            CA * (rigidityPower n (rigidityFourierExponent m) *
              rigidityPower n (-(β * (2 * k : ℕ)))) := by
                dsimp [CA]
                ring
          _ = CA * rigidityPower n αA := by rw [hp]
  have hBsharp :
      (|t| / Real.pi) * ((4 * m : ℕ) : ℝ) *
          (2 * (k : ℝ) *
            ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n *
            (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
              (2 * k - 1)) ≤
        CB * rigidityPower n αB := by
    have hprefix :
        (|t| / Real.pi) * ((4 * m : ℕ) : ℝ) ≤
          (rigidityPower n (rigidityFourierExponent m) / Real.pi) *
            ((4 * m : ℕ) : ℝ) :=
      mul_le_mul_of_nonneg_right htFac (Nat.cast_nonneg _)
    have hinside :
        2 * (k : ℝ) *
            ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n *
            (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
              (2 * k - 1) ≤
          2 * (k : ℝ) * (rigidityPower n (1 / 20) / n) *
            ((4 * Real.pi) ^ (2 * k - 1) *
              rigidityPower n (-(β * (2 * k - 1 : ℕ)))) := by
      have hQdiv :
          ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n ≤
            rigidityPower n (1 / 20) / n :=
        div_le_div_of_nonneg_right hQpow' hnreal.le
      have hcoef :
          2 * (k : ℝ) *
              (((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n) ≤
            2 * (k : ℝ) * (rigidityPower n (1 / 20) / n) :=
        mul_le_mul_of_nonneg_left hQdiv (by positivity)
      have hcoef' :
          2 * (k : ℝ) *
                ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n ≤
            2 * (k : ℝ) * (rigidityPower n (1 / 20) / n) := by
        convert hcoef using 1 <;> ring
      have hwave0 : 0 ≤
          (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
            (2 * k - 1) := pow_nonneg (by positivity) _
      have hcoefR0 : 0 ≤
          2 * (k : ℝ) * (rigidityPower n (1 / 20) / n) := by
        exact mul_nonneg (by positivity)
          (div_nonneg (rigidityPower_nonneg n _) hnreal.le)
      exact mul_le_mul hcoef' hdirPowSharp hwave0 hcoefR0
    calc
      (|t| / Real.pi) * ((4 * m : ℕ) : ℝ) *
          (2 * (k : ℝ) *
            ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n *
            (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
              (2 * k - 1)) ≤
        (rigidityPower n (rigidityFourierExponent m) / Real.pi) *
          ((4 * m : ℕ) : ℝ) *
          (2 * (k : ℝ) * (rigidityPower n (1 / 20) / n) *
            ((4 * Real.pi) ^ (2 * k - 1) *
              rigidityPower n (-(β * (2 * k - 1 : ℕ))))) := by
                have hleft0 : 0 ≤
                    2 * (k : ℝ) *
                      ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n *
                      (2 * Real.pi /
                        (rigidityDirichletScale m n : ℝ)) ^ (2 * k - 1) := by
                  positivity
                have hright0 : 0 ≤
                    (rigidityPower n (rigidityFourierExponent m) / Real.pi) *
                      ((4 * m : ℕ) : ℝ) :=
                  mul_nonneg
                    (div_nonneg (rigidityPower_nonneg n _) Real.pi_pos.le)
                    (Nat.cast_nonneg _)
                exact mul_le_mul hprefix hinside hleft0 hright0
      _ = CB * rigidityPower n αB := by
        have hdiv : rigidityPower n (1 / 20) / (n : ℝ) =
            rigidityPower n (1 / 20 - 1) := by
          simpa [rigidityPower] using
            (Real.rpow_sub hnreal (1 / 20) 1).symm
        have hp : rigidityPower n (rigidityFourierExponent m) *
              (rigidityPower n (1 / 20 - 1) *
                rigidityPower n (-(β * (2 * k - 1 : ℕ)))) =
            rigidityPower n αB := by
          calc
            rigidityPower n (rigidityFourierExponent m) *
                (rigidityPower n (1 / 20 - 1) *
                  rigidityPower n (-(β * (2 * k - 1 : ℕ)))) =
              (rigidityPower n (rigidityFourierExponent m) *
                rigidityPower n (1 / 20 - 1)) *
                  rigidityPower n (-(β * (2 * k - 1 : ℕ))) := by ring
            _ = rigidityPower n
                  (rigidityFourierExponent m + (1 / 20 - 1)) *
                    rigidityPower n (-(β * (2 * k - 1 : ℕ))) := by
              rw [← rigidityPower_add hn]
            _ = rigidityPower n
                  (rigidityFourierExponent m + (1 / 20 - 1) +
                    -(β * (2 * k - 1 : ℕ))) := by
              rw [← rigidityPower_add hn]
            _ = rigidityPower n αB := by
              congr 1
              dsimp [αB]
              push_cast
              ring
        rw [hdiv]
        rw [← hp]
        dsimp [CB]
        ring
  have hC :
      (2 : ℝ) ^ (2 * k) * rigidityGoodThresholdScale n =
        CC * rigidityPower n αC := by
    rfl
  have hAquarter : CA * rigidityPower n αA ≤ 1 / 4 := by
    unfold rigidityPower at hAsmallN
    rw [Real.rpow_zero] at hAsmallN
    calc
      CA * (n : ℝ) ^ αA = (4 * CA * (n : ℝ) ^ αA) / 4 := by ring
      _ ≤ 1 / 4 := div_le_div_of_nonneg_right hAsmallN (by norm_num)
  have hBquarter : CB * rigidityPower n αB ≤ 1 / 4 := by
    unfold rigidityPower at hBsmallN
    rw [Real.rpow_zero] at hBsmallN
    calc
      CB * (n : ℝ) ^ αB = (4 * CB * (n : ℝ) ^ αB) / 4 := by ring
      _ ≤ 1 / 4 := div_le_div_of_nonneg_right hBsmallN (by norm_num)
  have hCquarter : CC * rigidityPower n αC ≤ 1 / 4 := by
    unfold rigidityPower at hCsmallN
    rw [Real.rpow_zero] at hCsmallN
    calc
      CC * (n : ℝ) ^ αC = (4 * CC * (n : ℝ) ^ αC) / 4 := by ring
      _ ≤ 1 / 4 := div_le_div_of_nonneg_right hCsmallN (by norm_num)
  simp only [Nat.cast_pow]
  change
    (|t| / Real.pi) *
          (((4 * m : ℕ) : ℝ) *
            ((2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k) +
              2 * (k : ℝ) *
                (rigidityDirichletScale m n : ℝ) ^ (2 * m) / n *
                (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
                  (2 * k - 1))) +
        (2 : ℝ) ^ (2 * k) * rigidityGoodThresholdScale n < 1
  rw [show
    (|t| / Real.pi) *
          (((4 * m : ℕ) : ℝ) *
            ((2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k) +
              2 * (k : ℝ) *
                ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n *
                (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
                  (2 * k - 1))) +
        (2 : ℝ) ^ (2 * k) * rigidityGoodThresholdScale n =
      ((|t| / Real.pi) * ((4 * m : ℕ) : ℝ) *
        (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^ (2 * k)) +
      ((|t| / Real.pi) * ((4 * m : ℕ) : ℝ) *
        (2 * (k : ℝ) *
          ((rigidityDirichletScale m n : ℝ) ^ (2 * m)) / n *
          (2 * Real.pi / (rigidityDirichletScale m n : ℝ)) ^
            (2 * k - 1))) +
      ((2 : ℝ) ^ (2 * k) * rigidityGoodThresholdScale n) by ring]
  rw [hC]
  calc
    _ ≤ CA * rigidityPower n αA +
        CB * rigidityPower n αB + CC * rigidityPower n αC :=
      add_le_add (add_le_add hA hBsharp) le_rfl
    _ ≤ 1 / 4 + 1 / 4 + 1 / 4 :=
      add_le_add (add_le_add hAquarter hBquarter) hCquarter
    _ < 1 := by norm_num

lemma rigidityEpsilonScale_nat_pow
    {m n : ℕ} (hn : 0 < n) (r : ℕ) :
    rigidityEpsilonScale m n ^ r =
      rigidityPower n (-(rigidityEpsilonExponent m * r)) := by
  unfold rigidityEpsilonScale
  rw [rigidityPower_nat_pow hn]
  congr 1
  push_cast
  ring

lemma eventually_rigidity_correction_condition {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop,
      2 * (4 : ℝ) ^ phaseTwistCount m *
          ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * rigidityDifferenceOrder m)) *
          ((phaseTwistCount m * rigidityDilationStepScale m n : ℕ) : ℝ) / n +
        ((rigidityDifferenceOrder m : ℝ) *
            (4 : ℝ) ^ rigidityDifferenceOrder m * (1 / 2 : ℝ) *
            ((rigidityPropagationScale m n *
              rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n) *
          individualDilationGap (rigidityDilationStepScale m n)
              (rigiditySmoothScale n / n) ^ (2 * phaseTwistCount m) ≤
      (Real.sqrt (1 / (8 * (m : ℝ))) *
          rigidityEpsilonScale m n ^ (2 * rigidityDifferenceOrder m) *
          individualDilationGap (rigidityDilationStepScale m n)
              (rigiditySmoothScale n / n) ^ (2 * phaseTwistCount m)) / 2 := by
  let k : ℕ := rigidityDifferenceOrder m
  let ell : ℕ := phaseTwistCount m
  let x : ℝ := rigidityEpsilonExponent m
  let d : ℝ := rigidityDilationLossExponent m
  let αA : ℝ := rigidityDilationStepExponent m - 1
  let αR : ℝ := rigidityPropagationExponent m + 1 / 20 - 1
  let αε : ℝ := -(2 * (k : ℝ) * x)
  let αδ : ℝ := -(2 * (ell : ℝ) * d)
  let S : ℝ := Real.sqrt (1 / (8 * (m : ℝ)))
  let A : ℝ := 2 * (4 : ℝ) ^ ell *
    ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) * (ell : ℝ)
  let B : ℝ := (k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ)
  let D : ℝ := S / (4 * (4000 : ℝ) ^ (2 * ell))
  have hS : 0 < S := by
    dsimp [S]
    have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
    positivity
  have hD : 0 < D := by dsimp [D]; positivity
  have hAexp : αA < αε + αδ := by
    have h := rigidity_dilation_correction_margin hm
    dsimp [αA, αε, αδ, k, ell, x, d]
    linarith
  have hRexp : αR < αε := by
    have h := rigidity_propagation_correction_margin hm
    have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
    have heq : ((2 * m : ℕ) : ℝ) * rigidityDirichletExponent m =
        1 / 20 := by
      unfold rigidityDirichletExponent
      push_cast
      field_simp
      ring
    rw [heq] at h
    simpa [αR, αε, k, x] using h
  have hApoly := eventually_const_mul_rigidityPower_le
    (A / D) αA (αε + αδ) hAexp
  have hBpoly := eventually_const_mul_rigidityPower_le
    ((8000 * B) / (S / 4)) αR αε hRexp
  filter_upwards [Nat.eventually_pos,
      eventually_rigidityPropagationScale_cast_upper hm,
      eventually_rigidity_individualDilationGap_lower hm,
      hApoly, hBpoly]
    with n hn hRupper hδlower hApolyN hBpolyN
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  let δ : ℝ := individualDilationGap (rigidityDilationStepScale m n)
    (rigiditySmoothScale n / n)
  have hrho : 0 ≤ rigiditySmoothScale n / n := by
    exact div_nonneg (rigidityPower_nonneg n _) (Nat.cast_nonneg n)
  have hδ0 : 0 ≤ δ := by
    exact individualDilationGap_nonneg _ hrho
  have hq : (rigidityDilationStepScale m n : ℝ) ≤
      rigidityPower n (rigidityDilationStepExponent m) :=
    rigidityDilationStepScale_cast_upper m n
  have hqdiv : (rigidityDilationStepScale m n : ℝ) / n ≤
      rigidityPower n αA := by
    calc
      (rigidityDilationStepScale m n : ℝ) / n ≤
          rigidityPower n (rigidityDilationStepExponent m) / n :=
        div_le_div_of_nonneg_right hq hnreal.le
      _ = rigidityPower n αA := by
        dsimp [αA]
        simpa [rigidityPower] using
          (Real.rpow_sub hnreal (rigidityDilationStepExponent m) 1).symm
  have hfirstRaw :
      A * ((rigidityDilationStepScale m n : ℝ) / n) ≤
        D * rigidityPower n (αε + αδ) := by
    calc
      A * ((rigidityDilationStepScale m n : ℝ) / n) ≤
          A * rigidityPower n αA := by
        exact mul_le_mul_of_nonneg_left hqdiv (by dsimp [A]; positivity)
      _ = D * ((A / D) * rigidityPower n αA) := by
        field_simp
      _ ≤ D * rigidityPower n (αε + αδ) :=
        mul_le_mul_of_nonneg_left hApolyN hD.le
  have hεpow : rigidityEpsilonScale m n ^ (2 * k) =
      rigidityPower n αε := by
    rw [rigidityEpsilonScale_nat_pow hn]
    congr 1
    dsimp [αε]
    push_cast
    ring
  have hδpowLower :
      (rigidityPower n (-d) / 4000) ^ (2 * ell) ≤ δ ^ (2 * ell) := by
    exact pow_le_pow_left₀
      (div_nonneg (rigidityPower_nonneg n _) (by norm_num))
      (by simpa [δ, d] using hδlower) _
  have hbasePow :
      (rigidityPower n (-d) / 4000) ^ (2 * ell) =
        rigidityPower n αδ / (4000 : ℝ) ^ (2 * ell) := by
    rw [div_pow, rigidityPower_nat_pow hn]
    congr 2
    dsimp [αδ]
    push_cast
    ring
  have hfirst :
      A * ((rigidityDilationStepScale m n : ℝ) / n) ≤
        (S / 4) * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) := by
    calc
      A * ((rigidityDilationStepScale m n : ℝ) / n) ≤
          D * rigidityPower n (αε + αδ) := hfirstRaw
      _ = (S / 4) * rigidityPower n αε *
          (rigidityPower n αδ / (4000 : ℝ) ^ (2 * ell)) := by
        rw [rigidityPower_add hn]
        dsimp [D]
        field_simp
      _ = (S / 4) * rigidityEpsilonScale m n ^ (2 * k) *
          (rigidityPower n (-d) / 4000) ^ (2 * ell) := by
        rw [hεpow, hbasePow]
      _ ≤ (S / 4) * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) := by
        exact mul_le_mul_of_nonneg_left hδpowLower
          (mul_nonneg (div_nonneg hS.le (by norm_num))
            (pow_nonneg (rigidityPower_nonneg n _) _))
  have hQpow := rigidityDirichletScale_pow_cast_upper hm hn
  have hRQ :
      ((rigidityPropagationScale m n *
          rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n ≤
        8000 * rigidityPower n αR := by
    have hQpow' :
        (rigidityDirichletScale m n : ℝ) ^ (2 * m) ≤
          rigidityPower n (1 / 20) := by
      simpa only [Nat.cast_pow] using hQpow
    have hprod :
        ((rigidityPropagationScale m n : ℝ) *
          (rigidityDirichletScale m n : ℝ) ^ (2 * m)) ≤
          8000 * rigidityPower n
            (rigidityPropagationExponent m + 1 / 20) := by
      calc
        (rigidityPropagationScale m n : ℝ) *
            (rigidityDirichletScale m n : ℝ) ^ (2 * m) ≤
          (8000 * rigidityPower n (rigidityPropagationExponent m)) *
            rigidityPower n (1 / 20) :=
          mul_le_mul hRupper hQpow' (by positivity)
            (mul_nonneg (by norm_num) (rigidityPower_nonneg n _))
        _ = 8000 * rigidityPower n
            (rigidityPropagationExponent m + 1 / 20) := by
          rw [rigidityPower_add hn]
          ring
    push_cast
    calc
      (rigidityPropagationScale m n : ℝ) *
          (rigidityDirichletScale m n : ℝ) ^ (2 * m) / n ≤
        (8000 * rigidityPower n
          (rigidityPropagationExponent m + 1 / 20)) / n :=
        div_le_div_of_nonneg_right hprod hnreal.le
      _ = 8000 * rigidityPower n αR := by
        dsimp [αR]
        have hdiv : rigidityPower n
              (rigidityPropagationExponent m + 1 / 20) / (n : ℝ) =
            rigidityPower n
              (rigidityPropagationExponent m + 1 / 20 - 1) := by
          simpa [rigidityPower] using
            (Real.rpow_sub hnreal
              (rigidityPropagationExponent m + 1 / 20) 1).symm
        calc
          8000 * rigidityPower n
                (rigidityPropagationExponent m + 1 / 20) / (n : ℝ) =
              8000 * (rigidityPower n
                (rigidityPropagationExponent m + 1 / 20) / (n : ℝ)) := by ring
          _ = 8000 * rigidityPower n
              (rigidityPropagationExponent m + 1 / 20 - 1) := by rw [hdiv]
  have hsecondBase :
      B * (((rigidityPropagationScale m n *
          rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n) ≤
        (S / 4) * rigidityEpsilonScale m n ^ (2 * k) := by
    calc
      B * (((rigidityPropagationScale m n *
          rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n) ≤
        B * (8000 * rigidityPower n αR) :=
          mul_le_mul_of_nonneg_left hRQ (by dsimp [B]; positivity)
      _ = (S / 4) * (((8000 * B) / (S / 4)) *
          rigidityPower n αR) := by field_simp
      _ ≤ (S / 4) * rigidityPower n αε :=
        mul_le_mul_of_nonneg_left hBpolyN (by positivity)
      _ = (S / 4) * rigidityEpsilonScale m n ^ (2 * k) := by rw [hεpow]
  have hsecond :
      (B * (((rigidityPropagationScale m n *
          rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n)) *
          δ ^ (2 * ell) ≤
        (S / 4) * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) :=
    mul_le_mul_of_nonneg_right hsecondBase (pow_nonneg hδ0 _)
  calc
    2 * (4 : ℝ) ^ phaseTwistCount m *
          ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * rigidityDifferenceOrder m)) *
          ((phaseTwistCount m * rigidityDilationStepScale m n : ℕ) : ℝ) / n +
        ((rigidityDifferenceOrder m : ℝ) *
            (4 : ℝ) ^ rigidityDifferenceOrder m * (1 / 2 : ℝ) *
            ((rigidityPropagationScale m n *
              rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n) *
          individualDilationGap (rigidityDilationStepScale m n)
              (rigiditySmoothScale n / n) ^ (2 * phaseTwistCount m) =
      A * ((rigidityDilationStepScale m n : ℝ) / n) +
        (B * (((rigidityPropagationScale m n *
          rigidityDirichletScale m n ^ (2 * m) : ℕ) : ℝ) / n)) *
          δ ^ (2 * ell) := by
      dsimp [A, B, δ, k, ell]
      push_cast
      ring
    _ ≤ (S / 4) * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) +
        (S / 4) * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) :=
      add_le_add hfirst hsecond
    _ = (S * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell)) / 2 := by
      ring
    _ = (Real.sqrt (1 / (8 * (m : ℝ))) *
          rigidityEpsilonScale m n ^ (2 * rigidityDifferenceOrder m) *
          individualDilationGap (rigidityDilationStepScale m n)
              (rigiditySmoothScale n / n) ^ (2 * phaseTwistCount m)) / 2 := by
      rfl

lemma eventually_rigidity_demand_conditions {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ t : ℝ,
      rigidityPower n (-1 / 8) ≤ |t| →
      phaseHighPositionBudget t (rigidityEnergyScale n)
          (rigidityLocationScale n) (phaseTwistCount m)
          (rigidityDifferenceOrder m) <
        phaseHighPositionDemand m (rigidityCoreScale n)
          (rigidityDifferenceOrder m) (phaseTwistCount m)
          (rigidityEpsilonScale m n)
          (individualDilationGap (rigidityDilationStepScale m n)
            (rigiditySmoothScale n / n)) ∧
      phaseHighVelocityBudget t (rigidityEnergyScale n)
          (phaseTwistCount m) (rigidityDifferenceOrder m) <
        phaseHighVelocityDemand n m (rigidityCoreScale n)
          (rigidityDifferenceOrder m) (phaseTwistCount m)
          (rigidityEpsilonScale m n)
          (individualDilationGap (rigidityDilationStepScale m n)
            (rigiditySmoothScale n / n)) := by
  let k : ℕ := rigidityDifferenceOrder m
  let ell : ℕ := phaseTwistCount m
  let x : ℝ := rigidityEpsilonExponent m
  let d : ℝ := rigidityDilationLossExponent m
  let b : ℝ := rigidityBlockExponent
  let e : ℝ := rigidityEnergyExponent
  let αbudget : ℝ := 2 * (1 - b) + 1 / 4 + e
  let αvelocityBudget : ℝ := 1 / 4 + e
  let αposition : ℝ := b - 4 * (k : ℝ) * x - 4 * (ell : ℝ) * d
  let αvelocity : ℝ := 3 * b - 2 - 4 * (k : ℝ) * x - 4 * (ell : ℝ) * d
  let S : ℝ := Real.sqrt (1 / (8 * (m : ℝ)))
  let Cpos : ℝ := 18 * 20 ^ 2 * (36 : ℝ) ^ ell * Real.pi ^ 2 *
    (4 : ℝ) ^ (2 * k)
  let Cvel : ℝ := 2 * (36 : ℝ) ^ ell * Real.pi ^ 2 *
    (4 : ℝ) ^ (2 * k)
  let Dpos : ℝ := (1 / 20 : ℝ) *
    (S / (2 * (4000 : ℝ) ^ (2 * ell))) ^ 2
  let Dvel : ℝ := (1 / (20 ^ 3 : ℝ)) * (1 / (8 * (m : ℝ))) *
    (1 / (4000 : ℝ) ^ (4 * ell))
  have hS : 0 < S := by
    dsimp [S]
    have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
    positivity
  have hDpos : 0 < Dpos := by dsimp [Dpos]; positivity
  have hDvel : 0 < Dvel := by
    dsimp [Dvel]
    have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
    positivity
  have hposExp : αbudget < αposition := by
    have h := rigidity_position_demand_margin_from_eighth hm
    simpa [αbudget, αposition, b, e, k, ell, x, d] using h
  have hvelExp : αvelocityBudget < αvelocity := by
    have h := rigidity_velocity_demand_margin_from_eighth hm
    simpa [αvelocityBudget, αvelocity, b, e, k, ell, x, d] using h
  have hposPoly := eventually_const_mul_rigidityPower_le
    (2 * Cpos / Dpos) αbudget αposition hposExp
  have hvelPoly := eventually_const_mul_rigidityPower_le
    (2 * Cvel / Dvel) αvelocityBudget αvelocity hvelExp
  filter_upwards [Nat.eventually_pos,
      eventually_rigidityCoreScale_cast_lower,
      eventually_rigidity_individualDilationGap_lower hm,
      hposPoly, hvelPoly]
    with n hn hHlower hδlower hposPolyN hvelPolyN
  intro t ht
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hnbase : (1 : ℝ) ≤ n := by exact_mod_cast hn
  let δ : ℝ := individualDilationGap (rigidityDilationStepScale m n)
    (rigiditySmoothScale n / n)
  have hrho : 0 ≤ rigiditySmoothScale n / n :=
    div_nonneg (rigidityPower_nonneg n _) (Nat.cast_nonneg n)
  have hδ0 : 0 ≤ δ := individualDilationGap_nonneg _ hrho
  have hεpow : rigidityEpsilonScale m n ^ (2 * k) =
      rigidityPower n (-(2 * (k : ℝ) * x)) := by
    rw [rigidityEpsilonScale_nat_pow hn]
    congr 1
    dsimp [x]
    push_cast
    ring
  have hδpow :
      (rigidityPower n (-d) / 4000) ^ (2 * ell) ≤ δ ^ (2 * ell) :=
    pow_le_pow_left₀
      (div_nonneg (rigidityPower_nonneg n _) (by norm_num))
      (by simpa [δ, d] using hδlower) _
  have hδpowEq :
      (rigidityPower n (-d) / 4000) ^ (2 * ell) =
        rigidityPower n (-(2 * (ell : ℝ) * d)) /
          (4000 : ℝ) ^ (2 * ell) := by
    rw [div_pow, rigidityPower_nat_pow hn]
    congr 2
    push_cast
    ring
  have hcore :
      (1 / (4000 : ℝ) ^ (2 * ell)) *
          rigidityPower n (-(2 * (k : ℝ) * x + 2 * (ell : ℝ) * d)) ≤
        rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) := by
    calc
      (1 / (4000 : ℝ) ^ (2 * ell)) *
          rigidityPower n (-(2 * (k : ℝ) * x + 2 * (ell : ℝ) * d)) =
        rigidityPower n (-(2 * (k : ℝ) * x)) *
          (rigidityPower n (-(2 * (ell : ℝ) * d)) /
            (4000 : ℝ) ^ (2 * ell)) := by
        have hp : rigidityPower n (-(2 * (k : ℝ) * x)) *
              rigidityPower n (-(2 * (ell : ℝ) * d)) =
            rigidityPower n (-(2 * (k : ℝ) * x + 2 * (ell : ℝ) * d)) := by
          calc
            rigidityPower n (-(2 * (k : ℝ) * x)) *
                rigidityPower n (-(2 * (ell : ℝ) * d)) =
              rigidityPower n
                (-(2 * (k : ℝ) * x) + -(2 * (ell : ℝ) * d)) :=
                (rigidityPower_add hn _ _).symm
            _ = rigidityPower n
                (-(2 * (k : ℝ) * x + 2 * (ell : ℝ) * d)) := by ring_nf
        rw [← hp]
        ring
      _ = rigidityEpsilonScale m n ^ (2 * k) *
          (rigidityPower n (-d) / 4000) ^ (2 * ell) := by
        rw [hεpow, hδpowEq]
      _ ≤ rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell) := by
        exact mul_le_mul_of_nonneg_left hδpow (pow_nonneg (rigidityPower_nonneg n _) _)
  have hcoreSq :
      (1 / (4000 : ℝ) ^ (4 * ell)) *
          rigidityPower n (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) ≤
        (rigidityEpsilonScale m n ^ (2 * k)) ^ 2 *
          (δ ^ (2 * ell)) ^ 2 := by
    have hsquare := pow_le_pow_left₀
      (mul_nonneg (by positivity) (rigidityPower_nonneg n _)) hcore 2
    calc
      (1 / (4000 : ℝ) ^ (4 * ell)) *
          rigidityPower n (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) =
        ((1 / (4000 : ℝ) ^ (2 * ell)) *
          rigidityPower n (-(2 * (k : ℝ) * x + 2 * (ell : ℝ) * d))) ^ 2 := by
        rw [mul_pow]
        rw [rigidityPower_nat_pow hn]
        congr 2 <;> push_cast <;> ring
      _ ≤ (rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell)) ^ 2 := hsquare
      _ = (rigidityEpsilonScale m n ^ (2 * k)) ^ 2 *
          (δ ^ (2 * ell)) ^ 2 := by ring
  have hpi : (Real.pi / |t|) ^ 2 ≤
      Real.pi ^ 2 * rigidityPower n (1 / 4) := by
    let p : ℝ := rigidityPower n (1 / 8)
    have hp : 0 < p := rigidityPower_pos hn _
    have hneg : rigidityPower n (-1 / 8) = 1 / p := by
      dsimp [p, rigidityPower]
      rw [show (-1 / 8 : ℝ) = -(1 / 8) by ring,
        Real.rpow_neg (by exact_mod_cast hn.le)]
      simp [one_div]
    have htpos : 0 < |t| := by
      have : 0 < rigidityPower n (-1 / 8) := rigidityPower_pos hn _
      exact this.trans_le ht
    have hinv : 1 / |t| ≤ p := by
      have hone := one_div_le_one_div_of_le
        (rigidityPower_pos hn (-1 / 8)) ht
      rw [hneg] at hone
      simpa [one_div, hp.ne'] using hone
    have hdiv : Real.pi / |t| ≤ Real.pi * p := by
      simpa [div_eq_mul_inv, one_div] using
        (mul_le_mul_of_nonneg_left hinv Real.pi_pos.le)
    calc
      (Real.pi / |t|) ^ 2 ≤ (Real.pi * p) ^ 2 :=
        pow_le_pow_left₀ (by positivity) hdiv 2
      _ = Real.pi ^ 2 * rigidityPower n (1 / 4) := by
        rw [mul_pow]
        dsimp [p]
        rw [rigidityPower_nat_pow hn]
        congr 2
        push_cast
        ring
  have hJone : 1 ≤ rigidityLocationScale n := by
    unfold rigidityLocationScale
    have hp : 1 ≤ rigidityPower n (1 - rigidityBlockExponent) :=
      Real.one_le_rpow hnbase (by norm_num [rigidityBlockExponent])
    nlinarith
  have hJfactor :
      2 + 4 * (rigidityLocationScale n + 1) ^ 2 ≤
        18 * rigidityLocationScale n ^ 2 := by
    nlinarith [sq_nonneg (rigidityLocationScale n - 1)]
  have hJsq : rigidityLocationScale n ^ 2 =
      20 ^ 2 * rigidityPower n (2 * (1 - b)) := by
    unfold rigidityLocationScale
    rw [mul_pow, rigidityPower_nat_pow hn]
    congr 2
    dsimp [b]
    push_cast
    ring
  have hbudgetPos :
      phaseHighPositionBudget t (rigidityEnergyScale n)
          (rigidityLocationScale n) ell k ≤
        Cpos * rigidityPower n αbudget := by
    unfold phaseHighPositionBudget
    calc
      (2 + 4 * (rigidityLocationScale n + 1) ^ 2) * (36 : ℝ) ^ ell *
          ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
            rigidityEnergyScale n) ≤
        (18 * rigidityLocationScale n ^ 2) * (36 : ℝ) ^ ell *
          ((Real.pi ^ 2 * rigidityPower n (1 / 4)) *
            (4 : ℝ) ^ (2 * k) * rigidityEnergyScale n) := by
        gcongr
        · unfold rigidityEnergyScale
          exact mul_nonneg
            (mul_nonneg (sq_nonneg _) (pow_nonneg (by norm_num) _))
            (rigidityPower_nonneg n _)
        · unfold rigidityEnergyScale
          exact rigidityPower_nonneg n _
      _ = Cpos * rigidityPower n αbudget := by
        rw [hJsq]
        unfold rigidityEnergyScale
        have hp : rigidityPower n (2 * (1 - b)) *
              rigidityPower n (1 / 4) *
              rigidityPower n rigidityEnergyExponent =
            rigidityPower n αbudget := by
          dsimp [αbudget, e]
          rw [← rigidityPower_add hn, ← rigidityPower_add hn]
        calc
          (18 * (20 ^ 2 * rigidityPower n (2 * (1 - b)))) *
              (36 : ℝ) ^ ell *
              ((Real.pi ^ 2 * rigidityPower n (1 / 4)) *
                (4 : ℝ) ^ (2 * k) *
                rigidityPower n rigidityEnergyExponent) =
            Cpos * (rigidityPower n (2 * (1 - b)) *
              rigidityPower n (1 / 4) *
              rigidityPower n rigidityEnergyExponent) := by
                dsimp [Cpos]
                ring
          _ = Cpos * rigidityPower n αbudget := by rw [hp]
  have hdemandPos :
      Dpos * rigidityPower n αposition ≤
        phaseHighPositionDemand m (rigidityCoreScale n) k ell
          (rigidityEpsilonScale m n) δ := by
    unfold phaseHighPositionDemand
    calc
      Dpos * rigidityPower n αposition =
        (rigidityPower n b / 20) *
          ((S / 2) ^ 2 *
            ((1 / (4000 : ℝ) ^ (4 * ell)) *
              rigidityPower n
                (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)))) := by
        have hp : rigidityPower n b *
              rigidityPower n
                (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) =
            rigidityPower n αposition := by
          calc
            rigidityPower n b * rigidityPower n
                (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) =
              rigidityPower n
                (b + -(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) :=
                (rigidityPower_add hn _ _).symm
            _ = rigidityPower n αposition := by
              congr 1
              dsimp [αposition]
              ring
        rw [← hp]
        dsimp [Dpos]
        ring
      _ ≤ (rigidityCoreScale n : ℝ) *
          ((S / 2) ^ 2 *
            ((rigidityEpsilonScale m n ^ (2 * k)) ^ 2 *
              (δ ^ (2 * ell)) ^ 2)) := by
        have hsecond := mul_le_mul_of_nonneg_left hcoreSq (sq_nonneg (S / 2))
        exact mul_le_mul hHlower hsecond
          (mul_nonneg (sq_nonneg (S / 2))
            (mul_nonneg (by positivity) (rigidityPower_nonneg n _)))
          (Nat.cast_nonneg _)
      _ = (rigidityCoreScale n : ℝ) *
          ((S * rigidityEpsilonScale m n ^ (2 * k) * δ ^ (2 * ell)) / 2) ^ 2 := by
        ring
  have hbudgetVel :
      phaseHighVelocityBudget t (rigidityEnergyScale n) ell k ≤
        Cvel * rigidityPower n αvelocityBudget := by
    unfold phaseHighVelocityBudget
    calc
      2 * (36 : ℝ) ^ ell *
          ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
            rigidityEnergyScale n) ≤
        2 * (36 : ℝ) ^ ell *
          ((Real.pi ^ 2 * rigidityPower n (1 / 4)) *
            (4 : ℝ) ^ (2 * k) * rigidityEnergyScale n) := by
        gcongr
        unfold rigidityEnergyScale
        exact rigidityPower_nonneg n _
      _ = Cvel * rigidityPower n αvelocityBudget := by
        unfold rigidityEnergyScale
        dsimp [Cvel, αvelocityBudget, e]
        calc
          2 * (36 : ℝ) ^ ell *
              (Real.pi ^ 2 * rigidityPower n (1 / 4) *
                (4 : ℝ) ^ (2 * k) *
                rigidityPower n rigidityEnergyExponent) =
              (2 * (36 : ℝ) ^ ell * Real.pi ^ 2 *
                (4 : ℝ) ^ (2 * k)) *
                (rigidityPower n (1 / 4) *
                  rigidityPower n rigidityEnergyExponent) := by ring
          _ = (2 * (36 : ℝ) ^ ell * Real.pi ^ 2 *
                (4 : ℝ) ^ (2 * k)) *
              rigidityPower n (1 / 4 + rigidityEnergyExponent) := by
            rw [(rigidityPower_add hn _ _).symm]
  have hHcube :
      rigidityPower n (3 * b - 2) / (20 ^ 3 : ℝ) ≤
        (rigidityCoreScale n : ℝ) *
          ((rigidityCoreScale n : ℝ) / n) ^ 2 := by
    have hH0 : 0 ≤ rigidityPower n b / 20 :=
      div_nonneg (rigidityPower_nonneg n b) (by norm_num)
    have hcube := pow_le_pow_left₀ hH0 hHlower 3
    have hnum :
        (rigidityPower n b / 20) ^ 3 /
            (n : ℝ) ^ 2 ≤
          (rigidityCoreScale n : ℝ) ^ 3 / (n : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right hcube (sq_nonneg (n : ℝ))
    calc
      rigidityPower n (3 * b - 2) / (20 ^ 3 : ℝ) =
          (rigidityPower n b / 20) ^ 3 / (n : ℝ) ^ 2 := by
        symm
        have hdiv : rigidityPower n (b * (3 : ℕ)) / (n : ℝ) ^ 2 =
            rigidityPower n (3 * b - 2) := by
          unfold rigidityPower
          rw [show (n : ℝ) ^ (2 : ℕ) = (n : ℝ) ^ (2 : ℝ) by
            exact (Real.rpow_natCast (n : ℝ) 2).symm]
          rw [← Real.rpow_sub hnreal]
          congr 1
          push_cast
          ring
        calc
          (rigidityPower n b / 20) ^ 3 / (n : ℝ) ^ 2 =
              (rigidityPower n (b * (3 : ℕ)) / (n : ℝ) ^ 2) /
                (20 ^ 3 : ℝ) := by
            rw [div_pow, rigidityPower_nat_pow hn]
            ring
          _ = rigidityPower n (3 * b - 2) / (20 ^ 3 : ℝ) := by rw [hdiv]
      _ ≤ (rigidityCoreScale n : ℝ) ^ 3 / (n : ℝ) ^ 2 := hnum
      _ = (rigidityCoreScale n : ℝ) *
          ((rigidityCoreScale n : ℝ) / n) ^ 2 := by field_simp
  have hdemandVel :
      Dvel * rigidityPower n αvelocity ≤
        phaseHighVelocityDemand n m (rigidityCoreScale n) k ell
          (rigidityEpsilonScale m n) δ := by
    unfold phaseHighVelocityDemand
    calc
      Dvel * rigidityPower n αvelocity =
        (rigidityPower n (3 * b - 2) / (20 ^ 3 : ℝ)) *
          ((1 / (8 * (m : ℝ))) *
            ((1 / (4000 : ℝ) ^ (4 * ell)) *
              rigidityPower n
                (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)))) := by
        have hp : rigidityPower n (3 * b - 2) *
              rigidityPower n
                (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) =
            rigidityPower n αvelocity := by
          calc
            rigidityPower n (3 * b - 2) *
                rigidityPower n
                  (-(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) =
              rigidityPower n
                ((3 * b - 2) +
                  -(4 * (k : ℝ) * x + 4 * (ell : ℝ) * d)) :=
                (rigidityPower_add hn _ _).symm
            _ = rigidityPower n αvelocity := by
              congr 1
              dsimp [αvelocity]
              ring
        rw [← hp]
        dsimp [Dvel]
        ring
      _ ≤ ((rigidityCoreScale n : ℝ) *
          ((rigidityCoreScale n : ℝ) / n) ^ 2) *
          ((1 / (8 * (m : ℝ))) *
            ((rigidityEpsilonScale m n ^ (2 * k)) ^ 2 *
              (δ ^ (2 * ell)) ^ 2)) := by
        have hsecond := mul_le_mul_of_nonneg_left hcoreSq
          (by
            have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
            positivity : 0 ≤ 1 / (8 * (m : ℝ)))
        exact mul_le_mul hHcube hsecond
          (mul_nonneg (by positivity)
            (mul_nonneg (by positivity) (rigidityPower_nonneg n _)))
          (by positivity)
      _ = (rigidityCoreScale n : ℝ) *
          ((rigidityCoreScale n : ℝ) / n) ^ 2 *
          ((1 / (8 * (m : ℝ))) *
            (rigidityEpsilonScale m n ^ (2 * k)) ^ 2 *
            (δ ^ (2 * ell)) ^ 2) := by ring
  constructor
  · have hpoly : Cpos * rigidityPower n αbudget <
        Dpos * rigidityPower n αposition := by
      have hhalf : Cpos * rigidityPower n αbudget ≤
          (Dpos / 2) * rigidityPower n αposition := by
        calc
          Cpos * rigidityPower n αbudget =
              (Dpos / 2) * ((2 * Cpos / Dpos) *
                rigidityPower n αbudget) := by field_simp
          _ ≤ (Dpos / 2) * rigidityPower n αposition :=
            mul_le_mul_of_nonneg_left hposPolyN (by positivity)
      have hstrict : (Dpos / 2) * rigidityPower n αposition <
          Dpos * rigidityPower n αposition := by
        have hp := rigidityPower_pos hn αposition
        exact mul_lt_mul_of_pos_right
          (by nlinarith only [hDpos] : Dpos / 2 < Dpos) hp
      exact hhalf.trans_lt hstrict
    exact (hbudgetPos.trans_lt hpoly).trans_le hdemandPos
  · have hpoly : Cvel * rigidityPower n αvelocityBudget <
        Dvel * rigidityPower n αvelocity := by
      have hhalf : Cvel * rigidityPower n αvelocityBudget ≤
          (Dvel / 2) * rigidityPower n αvelocity := by
        calc
          Cvel * rigidityPower n αvelocityBudget =
              (Dvel / 2) * ((2 * Cvel / Dvel) *
                rigidityPower n αvelocityBudget) := by field_simp
          _ ≤ (Dvel / 2) * rigidityPower n αvelocity :=
            mul_le_mul_of_nonneg_left hvelPolyN (by positivity)
      have hstrict : (Dvel / 2) * rigidityPower n αvelocity <
          Dvel * rigidityPower n αvelocity := by
        have hp := rigidityPower_pos hn αvelocity
        exact mul_lt_mul_of_pos_right
          (by nlinarith only [hDvel] : Dvel / 2 < Dvel) hp
      exact hhalf.trans_lt hstrict
    exact (hbudgetVel.trans_lt hpoly).trans_le hdemandVel

/-- Fixed-Dirichlet-step velocity branch of the high-frequency argument.
Unlike `phaseLatticeEnergy_high_frequency_dichotomy`, this lemma does not
choose or amplify the Dirichlet step.  This is the form needed in the source
proof: it can be applied to every multiple of one simultaneous Dirichlet
step, after which the propagation lemma contradicts smoothness. -/
theorem phaseLatticeEnergy_fixedStep_largeVelocity
    (n m q k W H q₀ B : ℕ)
    (hn : 0 < n) (hm : 0 < m) (hq : 800 ≤ q)
    (hW : 0 < W) (hH : 0 < H) (hq₀B : q₀ ≤ B)
    (K lam a t E J eta ε : ℝ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m) (r : Fin m)
    (hu : phaseNormSq u = 1)
    (hsmooth : ∀ s, IsSmooth n K (points s))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hdirichlet : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ eta)
    (heta0 : 0 ≤ eta) (hε0 : 0 ≤ ε)
    (htarget : ε ≤
      ‖complexWave n (reflectedModeTime points (r, true)) (q₀ : ℤ) - 1‖)
    (hlarge : 1 / (2 * (m : ℝ)) ≤
      Complex.normSq (phaseVelocityCoeff u r))
    (ha : 0 < a) (ht : t ≠ 0)
    (henergy : phaseLatticeEnergy n points u t ≤ E)
    (hblock : (W : ℝ) * (E / a ^ 2 + 1) ≤ 2 * n + 1)
    (hfit : 2 * H + 2 * (phaseTwistCount m * q) + 2 * k * B ≤ W)
    (hJ : 0 ≤ J) (hJsize : (n : ℝ) ≤ J * H)
    (hunwrap :
      (|t| / Real.pi) *
          ((4 * m : ℕ) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (B : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (hdeltaOne :
      individualDilationGap q (min (K / n) (lam / n)) ≤ 1) :
    phaseHighVelocityDemand n m H k (phaseTwistCount m) ε
        (individualDilationGap q (min (K / n) (lam / n))) ≤
      phaseHighVelocityBudget t E (phaseTwistCount m) k := by
  let rho : ℝ := min (K / n) (lam / n)
  let delta : ℝ := individualDilationGap q rho
  let ell : ℕ := phaseTwistCount m
  let target : ReflectedMode m := (r, true)
  have hrho' : 0 < rho := by simpa [rho] using hrho
  have hdeltaPos : 0 < delta := by
    dsimp [delta, individualDilationGap]
    have hqreal : (0 : ℝ) < q := by
      exact_mod_cast (lt_of_lt_of_le (by norm_num) hq)
    positivity
  have hdelta0 : 0 ≤ delta := hdeltaPos.le
  have hdelta1 : delta ≤ 1 := by
    simpa [delta, rho] using hdeltaOne
  rcases exists_scaledPhase_good_block_of_energy_le
      n W points u t a E hW ha henergy hblock with ⟨s, hs, hgood⟩
  have hsle : s ≤ 2 * n := by omega
  have hjbase : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ (n : ℝ) := by
    have hsreal : (s : ℝ) ≤ 2 * (n : ℝ) := by exact_mod_cast hsle
    simp only [Int.cast_sub, Int.cast_natCast]
    rw [abs_le]
    constructor <;> linarith
  have hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H :=
    hjbase.trans hJsize
  have hdist : ∀ b : ReflectedMode m, b ≠ target →
      rho ≤ distanceToInteger
        ((reflectedModeTime points target - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
    intro b hbt
    simpa [rho, target] using reflectedMode_distance_lower
      n hn K lam points hsmooth hspread target b hbt.symm
  rcases exists_variableReflectedSteps n hn points target q hq rho hrho' hdist with
    ⟨step, hstep, hsep⟩
  let twists := variableReflectedTwists n points step target
  have hlen : twists.length = ell := by
    simpa [twists, ell, phaseTwistCount] using
      variableReflectedTwists_length n points step target
  have hspan : variableTwistSpan twists ≤ 2 * (ell * q) := by
    rw [variableTwistSpan_eq_two_mul_stepSum]
    have hs' := variableReflectedTwists_stepSum_le n points step target q
      (fun b hbt ↦ (hstep b hbt).2.le)
    simpa [twists, ell, phaseTwistCount] using Nat.mul_le_mul_left 2 hs'
  have hfitActual :
      2 * H + variableTwistSpan twists + 2 * k * q₀ ≤ W := by
    have hqmul : 2 * k * q₀ ≤ 2 * k * B :=
      Nat.mul_le_mul_left (2 * k) hq₀B
    calc
      2 * H + variableTwistSpan twists + 2 * k * q₀ ≤
          2 * H + 2 * (ell * q) + 2 * k * B := by omega
      _ ≤ W := by simpa [ell] using hfit
  have hl1 := phaseL1_le_of_phaseNormSq_eq_one u hu
  have hq₀Real : (q₀ : ℝ) ≤ B := by exact_mod_cast hq₀B
  have hunwrapActual :
      (|t| / Real.pi) *
          ((∑ s : Fin m, ∑ c : Fin 4, |u s c|) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1 := by
    apply lt_of_le_of_lt _ hunwrap
    have hsecond :
        (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n ≤
          (k : ℝ) * (4 : ℝ) ^ k * (B : ℝ) / n := by gcongr
    have hl1' : (∑ s : Fin m, ∑ c : Fin 4, |u s c|) ≤
        ((4 * m : ℕ) : ℝ) := by
      convert hl1 using 1 <;> push_cast <;> ring
    have hinside :
        (∑ s : Fin m, ∑ c : Fin 4, |u s c|) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n) ≤
          ((4 * m : ℕ) : ℝ) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (B : ℝ) / n) :=
      mul_le_mul hl1' (add_le_add le_rfl hsecond)
        (by positivity) (by positivity)
    exact add_le_add
      (mul_le_mul_of_nonneg_left hinside (by positivity)) le_rfl
  have hsep' : ∀ b : ReflectedMode m, b ≠ target →
      delta ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖ := by
    simpa [delta, rho] using hsep
  have hforce := goodBlock_largeVelocity_forces_latticeEnergy
    n hn points u t ht q₀ k eta heta0 hdirichlet
    s W hs a ha.le hgood step r delta hdelta0
    (by simpa [target] using hsep') H hH
    (by simpa [twists, target] using hfitActual) hunwrapActual
    (1 / (2 * (m : ℝ))) ε (by positivity) hε0 hlarge
    (by simpa [target] using htarget)
  have hbudget :
      2 * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) ≤
      2 * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E) := by
    gcongr
  have hforce' := hforce.trans hbudget
  rw [show (variableReflectedTwists n points step (r, true)).length = ell by
    simpa [twists, target] using hlen] at hforce'
  convert hforce' using 1 <;>
    (try dsimp only [phaseHighVelocityDemand, phaseHighVelocityBudget, delta,
      rho, ell])
  all_goals first | rfl | ring

/-- Fixed-Dirichlet-step position branch of the high-frequency argument.
The explicit correction hypothesis absorbs the two affine velocity terms
created by transporting the position coefficient through the isolating
twists. -/
theorem phaseLatticeEnergy_fixedStep_largePosition
    (n m q k W H q₀ B : ℕ)
    (hn : 0 < n) (hm : 0 < m) (hq : 800 ≤ q)
    (hW : 0 < W) (hH : 0 < H) (hq₀B : q₀ ≤ B)
    (K lam a t E J eta ε : ℝ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m) (r : Fin m)
    (hu : phaseNormSq u = 1)
    (hsmooth : ∀ s, IsSmooth n K (points s))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hdirichlet : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ eta)
    (heta0 : 0 ≤ eta) (hε0 : 0 ≤ ε)
    (htarget : ε ≤
      ‖complexWave n (reflectedModeTime points (r, true)) (q₀ : ℤ) - 1‖)
    (hlarge : phaseNormSq u / (2 * (m : ℝ)) ≤
      Complex.normSq (phasePositionCoeff u r))
    (ha : 0 < a) (ht : t ≠ 0)
    (henergy : phaseLatticeEnergy n points u t ≤ E)
    (hblock : (W : ℝ) * (E / a ^ 2 + 1) ≤ 2 * n + 1)
    (hfit : 2 * H + 2 * (phaseTwistCount m * q) + 2 * k * B ≤ W)
    (hJ : 0 ≤ J) (hJsize : (n : ℝ) ≤ J * H)
    (hunwrap :
      (|t| / Real.pi) *
          ((4 * m : ℕ) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (B : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (hdeltaOne :
      individualDilationGap q (min (K / n) (lam / n)) ≤ 1)
    (hcorr :
      2 * (4 : ℝ) ^ (phaseTwistCount m) *
          ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
          ((phaseTwistCount m * q : ℕ) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) * (B : ℝ) / n) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m) ≤
      (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m)) / 2) :
    phaseHighPositionDemand m H k (phaseTwistCount m) ε
        (individualDilationGap q (min (K / n) (lam / n))) ≤
      phaseHighPositionBudget t E J (phaseTwistCount m) k := by
  let rho : ℝ := min (K / n) (lam / n)
  let delta : ℝ := individualDilationGap q rho
  let ell : ℕ := phaseTwistCount m
  let target : ReflectedMode m := (r, true)
  have hrho' : 0 < rho := by simpa [rho] using hrho
  have hdeltaPos : 0 < delta := by
    dsimp [delta, individualDilationGap]
    have hqreal : (0 : ℝ) < q := by
      exact_mod_cast (lt_of_lt_of_le (by norm_num) hq)
    positivity
  have hdelta0 : 0 ≤ delta := hdeltaPos.le
  have hdelta1 : delta ≤ 1 := by
    simpa [delta, rho] using hdeltaOne
  rcases exists_scaledPhase_good_block_of_energy_le
      n W points u t a E hW ha henergy hblock with ⟨s, hs, hgood⟩
  have hsle : s ≤ 2 * n := by omega
  have hjbase : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ (n : ℝ) := by
    have hsreal : (s : ℝ) ≤ 2 * (n : ℝ) := by exact_mod_cast hsle
    simp only [Int.cast_sub, Int.cast_natCast]
    rw [abs_le]
    constructor <;> linarith
  have hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H :=
    hjbase.trans hJsize
  have hdist : ∀ b : ReflectedMode m, b ≠ target →
      rho ≤ distanceToInteger
        ((reflectedModeTime points target - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
    intro b hbt
    simpa [rho, target] using reflectedMode_distance_lower
      n hn K lam points hsmooth hspread target b hbt.symm
  rcases exists_variableReflectedSteps n hn points target q hq rho hrho' hdist with
    ⟨step, hstep, hsep⟩
  let twists := variableReflectedTwists n points step target
  have hlen : twists.length = ell := by
    simpa [twists, ell, phaseTwistCount] using
      variableReflectedTwists_length n points step target
  have hsum : variableStepSum twists ≤ ell * q := by
    have hs' := variableReflectedTwists_stepSum_le n points step target q
      (fun b hbt ↦ (hstep b hbt).2.le)
    simpa [twists, ell, phaseTwistCount] using hs'
  have hspan : variableTwistSpan twists ≤ 2 * (ell * q) := by
    rw [variableTwistSpan_eq_two_mul_stepSum]
    omega
  have hfitActual :
      2 * H + variableTwistSpan twists + 2 * k * q₀ ≤ W := by
    have hqmul : 2 * k * q₀ ≤ 2 * k * B :=
      Nat.mul_le_mul_left (2 * k) hq₀B
    calc
      2 * H + variableTwistSpan twists + 2 * k * q₀ ≤
          2 * H + 2 * (ell * q) + 2 * k * B := by omega
      _ ≤ W := by simpa [ell] using hfit
  have hl1 := phaseL1_le_of_phaseNormSq_eq_one u hu
  have hq₀Real : (q₀ : ℝ) ≤ B := by exact_mod_cast hq₀B
  have hunwrapActual :
      (|t| / Real.pi) *
          ((∑ s : Fin m, ∑ c : Fin 4, |u s c|) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1 := by
    apply lt_of_le_of_lt _ hunwrap
    have hsecond :
        (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n ≤
          (k : ℝ) * (4 : ℝ) ^ k * (B : ℝ) / n := by gcongr
    have hl1' : (∑ s : Fin m, ∑ c : Fin 4, |u s c|) ≤
        ((4 * m : ℕ) : ℝ) := by
      convert hl1 using 1 <;> push_cast <;> ring
    have hinside :
        (∑ s : Fin m, ∑ c : Fin 4, |u s c|) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n) ≤
          ((4 * m : ℕ) : ℝ) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (B : ℝ) / n) :=
      mul_le_mul hl1' (add_le_add le_rfl hsecond)
        (by positivity) (by positivity)
    exact add_le_add
      (mul_le_mul_of_nonneg_left hinside (by positivity)) le_rfl
  have hsep' : ∀ b : ReflectedMode m, b ≠ target →
      delta ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖ := by
    simpa [delta, rho] using hsep
  have hA := sqrt_one_div_eight_mul_le_reflectedPositionCoeff_true
    hm u hu r hlarge
  have hB := norm_reflectedVelocityCoeff_true_le_half_of_phaseNormSq_eq_one
    u hu r
  have hchordUpper :
      ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ≤ 2 := by
    calc
      ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ≤
          ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ)‖ +
            ‖(1 : ℂ)‖ := norm_sub_le _ _
      _ = 2 := by norm_num [norm_complexWave]
  have hchordPow :
      ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
          (2 * k) ≤ (2 : ℝ) ^ (2 * k) :=
    pow_le_pow_left₀ (norm_nonneg _) hchordUpper _
  have hsumReal : (variableStepSum twists : ℝ) ≤ ((ell * q : ℕ) : ℝ) := by
    exact_mod_cast hsum
  have hcorrActual :
      2 * (4 : ℝ) ^ twists.length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
          (variableStepSum twists : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
          delta ^ (2 * twists.length) ≤
      (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
        delta ^ (2 * twists.length)) / 2 := by
    have hleft :
        2 * (4 : ℝ) ^ twists.length *
            (‖reflectedVelocityCoeff u target‖ *
              ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
                (2 * k)) *
            (variableStepSum twists : ℝ) / n +
          ((k : ℝ) * (4 : ℝ) ^ k *
              ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
            delta ^ (2 * twists.length) ≤
        2 * (4 : ℝ) ^ ell *
            ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
            ((ell * q : ℕ) : ℝ) / n +
          ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) * (B : ℝ) / n) *
            delta ^ (2 * ell) := by
      rw [hlen]
      gcongr
    rw [hlen] at hleft ⊢
    exact hleft.trans (by
      convert hcorr using 1 <;> simp only [delta, rho, ell] <;> ring)
  have hforce := goodBlock_largePosition_forces_latticeEnergy
    n hn points u t ht q₀ k eta heta0 hdirichlet
    s W hs a ha.le hgood step r delta hdelta0
    (by simpa [target] using hsep') H hH J hJ hj
    (by simpa [twists, target] using hfitActual) hunwrapActual
    (Real.sqrt (1 / (8 * (m : ℝ)))) ε (Real.sqrt_nonneg _) hε0
    (by simpa [target] using hA) (by simpa [target] using htarget)
    (by simpa [twists, target] using hcorrActual)
  have hbudget :
      (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) ≤
      (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E) := by
    gcongr
  have hforce' := hforce.trans hbudget
  rw [show (variableReflectedTwists n points step (r, true)).length = ell by
    simpa [twists, target] using hlen] at hforce'
  simpa [phaseHighPositionDemand, phaseHighPositionBudget, delta, rho, ell]
    using hforce'

/-- Source-shaped high-frequency lattice separation.  One simultaneous
Dirichlet step is fixed, the fixed-step estimates are applied to every one
of its first `R - 1` multiples, and the resulting uniform chord control is
incompatible with smoothness.  Thus no small-lattice-energy alternative
survives. -/
theorem phaseLatticeEnergy_high_frequency_propagation
    (n m Q R q k W H : ℕ)
    (hn : 0 < n) (hm : 0 < m) (hQ : 0 < Q)
    (hR : 800 ≤ R) (hq : 800 ≤ q) (hW : 0 < W) (hH : 0 < H)
    (K lam ε a t E J : ℝ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hu : phaseNormSq u = 1)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hQK : Q ^ (2 * m) ≤ Nat.floor K + 1)
    (hε0 : 0 ≤ ε) (hεsmall : ε < 1 / 16)
    (hscale : 4000 * ε / R ≤ K / n)
    (ha : 0 < a) (ht : t ≠ 0)
    (hblock : (W : ℝ) * (E / a ^ 2 + 1) ≤ 2 * n + 1)
    (hfit : 2 * H + 2 * (phaseTwistCount m * q) +
        2 * k * (R * Q ^ (2 * m)) ≤ W)
    (hJ : 0 ≤ J) (hJsize : (n : ℝ) ≤ J * H)
    (hunwrap :
      (|t| / Real.pi) *
          ((4 * m : ℕ) *
            (phaseDirichletEta R Q ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k *
                ((R * Q ^ (2 * m) : ℕ) : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (hdeltaOne :
      individualDilationGap q (min (K / n) (lam / n)) ≤ 1)
    (hcorr :
      2 * (4 : ℝ) ^ (phaseTwistCount m) *
          ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
          ((phaseTwistCount m * q : ℕ) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) *
            ((R * Q ^ (2 * m) : ℕ) : ℝ) / n) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m) ≤
      (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m)) / 2)
    (hposition :
      phaseHighPositionBudget t E J (phaseTwistCount m) k <
        phaseHighPositionDemand m H k (phaseTwistCount m) ε
          (individualDilationGap q (min (K / n) (lam / n))))
    (hvelocity :
      phaseHighVelocityBudget t E (phaseTwistCount m) k <
        phaseHighVelocityDemand n m H k (phaseTwistCount m) ε
          (individualDilationGap q (min (K / n) (lam / n)))) :
    E < phaseLatticeEnergy n points u t := by
  by_contra hnot
  have henergy : phaseLatticeEnergy n points u t ≤ E := le_of_not_gt hnot
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge⟩
  let target : ReflectedMode m := (r, true)
  rcases exists_reflectedMode_dirichletStep n m Q hn hQ points with
    ⟨q₀, hq₀1, hq₀Q, hdirichlet⟩
  have hq₀K : q₀ ≤ Nat.floor K + 1 := hq₀Q.trans hQK
  have hmultiple : ∀ ell ∈ Finset.Ico 1 R,
      ‖complexWave n (reflectedModeTime points target)
          ((ell * q₀ : ℕ) : ℤ) - 1‖ ≤ ε := by
    intro ell hell
    have hellR : ell ≤ R := (Finset.mem_Ico.mp hell).2.le
    have hstepBound : ell * q₀ ≤ R * Q ^ (2 * m) :=
      Nat.mul_le_mul hellR hq₀Q
    have hdirichletMultiple : ∀ b : ReflectedMode m,
        ‖complexWave n (reflectedModeTime points b)
            ((ell * q₀ : ℕ) : ℤ) - 1‖ ≤ phaseDirichletEta R Q := by
      intro b
      have hmul := norm_complexWave_nat_mul_sub_one_le
        n (reflectedModeTime points b) q₀ ell
      have hbase :
          ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤
            2 * Real.pi / Q := (hdirichlet b).le
      have hellRreal : (ell : ℝ) ≤ R := by exact_mod_cast hellR
      calc
        ‖complexWave n (reflectedModeTime points b)
            ((ell * q₀ : ℕ) : ℤ) - 1‖ ≤
            (ell : ℝ) *
              ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ :=
          hmul
        _ ≤ (ell : ℝ) * (2 * Real.pi / Q) :=
          mul_le_mul_of_nonneg_left hbase (Nat.cast_nonneg ell)
        _ ≤ (R : ℝ) * (2 * Real.pi / Q) := by gcongr
        _ = phaseDirichletEta R Q := by rfl
    by_contra hlargeChord
    have htarget : ε ≤
        ‖complexWave n (reflectedModeTime points (r, true))
            ((ell * q₀ : ℕ) : ℤ) - 1‖ := by
      simpa [target, not_le] using le_of_not_ge hlargeChord
    rcases hlarge with hpos | hvel
    · have hforced := phaseLatticeEnergy_fixedStep_largePosition
        n m q k W H (ell * q₀) (R * Q ^ (2 * m))
        hn hm hq hW hH hstepBound K lam a t E J
        (phaseDirichletEta R Q) ε points u r hu hsmooth hspread hrho
        hdirichletMultiple (by unfold phaseDirichletEta; positivity) hε0
        htarget hpos ha ht henergy hblock hfit hJ hJsize hunwrap
        hdeltaOne hcorr
      exact (not_le_of_gt hposition hforced).elim
    · have hforced := phaseLatticeEnergy_fixedStep_largeVelocity
        n m q k W H (ell * q₀) (R * Q ^ (2 * m))
        hn hm hq hW hH hstepBound K lam a t E J
        (phaseDirichletEta R Q) ε points u r hu hsmooth hspread hrho
        hdirichletMultiple (by unfold phaseDirichletEta; positivity) hε0
        htarget (by simpa [hu] using hvel) ha ht henergy hblock hfit
        hJ hJsize hunwrap hdeltaOne
      exact (not_le_of_gt hvelocity hforced).elim
  have hsmoothTarget : IsSmooth n K (reflectedModeTime points target) := by
    simpa [target, reflectedModeTime] using hsmooth r
  rcases hsmoothTarget.exists_large_multipleWave hn hq₀1 hq₀K
      R hR ε hε0 hεsmall hscale with ⟨ell, hell, hlargeChord⟩
  exact (not_lt_of_ge (hmultiple ell hell)) hlargeChord

/-- Exact characteristic-function consequence of the propagated lattice
separation. -/
theorem norm_projectedPhaseWalk_charFun_high_frequency_of_propagation
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t E : ℝ)
    (henergy : E < phaseLatticeEnergy n points u t) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤ Real.exp (-E) :=
  norm_projectedPhaseWalk_charFun_le_exp_neg n points u t E henergy.le

/-- Full Cook--Nguyen high-frequency rigidity in source order.  The
simultaneous Dirichlet step is analytically unwrapped only once.  Integer
finite-difference rigidity then transports that equality to all of its first
`R - 1` multiples, so the final propagation contradiction has no spurious
`R/Q` loss. -/
theorem phaseLatticeEnergy_high_frequency_rigidity
    (n m Q R q k W H : ℕ)
    (hn : 0 < n) (hm : 0 < m) (hQ : 0 < Q)
    (hR : 800 ≤ R) (hq : 800 ≤ q) (hW : 0 < W) (hH : 0 < H)
    (K lam ε a t E J : ℝ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hu : phaseNormSq u = 1)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hQK : Q ^ (2 * m) ≤ Nat.floor K + 1)
    (hε0 : 0 ≤ ε) (hεsmall : ε < 1 / 16)
    (hscale : 4000 * ε / R ≤ K / n)
    (ha : 0 < a) (ht : t ≠ 0)
    (hblock : (W : ℝ) * (E / a ^ 2 + 1) ≤ 2 * n + 1)
    (hfit : 2 * H + 2 * (phaseTwistCount m * q) +
        2 * k * (R * Q ^ (2 * m)) ≤ W)
    (hJ : 0 ≤ J) (hJsize : (n : ℝ) ≤ J * H)
    (hunwrap :
      (|t| / Real.pi) *
          ((4 * m : ℕ) *
            ((2 * Real.pi / Q) ^ (2 * k) +
              2 * (k : ℝ) * ((Q ^ (2 * m) : ℕ) : ℝ) / n *
                (2 * Real.pi / Q) ^ (2 * k - 1))) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (hdeltaOne :
      individualDilationGap q (min (K / n) (lam / n)) ≤ 1)
    (hcorr :
      2 * (4 : ℝ) ^ (phaseTwistCount m) *
          ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
          ((phaseTwistCount m * q : ℕ) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) *
            ((R * Q ^ (2 * m) : ℕ) : ℝ) / n) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m) ≤
      (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m)) / 2)
    (hposition :
      phaseHighPositionBudget t E J (phaseTwistCount m) k <
        phaseHighPositionDemand m H k (phaseTwistCount m) ε
          (individualDilationGap q (min (K / n) (lam / n))))
    (hvelocity :
      phaseHighVelocityBudget t E (phaseTwistCount m) k <
        phaseHighVelocityDemand n m H k (phaseTwistCount m) ε
          (individualDilationGap q (min (K / n) (lam / n)))) :
    E < phaseLatticeEnergy n points u t := by
  by_contra hnot
  have henergy : phaseLatticeEnergy n points u t ≤ E := le_of_not_gt hnot
  let rho : ℝ := min (K / n) (lam / n)
  let delta : ℝ := individualDilationGap q rho
  let eta : ℝ := 2 * Real.pi / Q
  let ellTwist : ℕ := phaseTwistCount m
  have hrho' : 0 < rho := by simpa [rho] using hrho
  have hdeltaPos : 0 < delta := by
    dsimp [delta, individualDilationGap]
    have hqreal : (0 : ℝ) < q := by
      exact_mod_cast (lt_of_lt_of_le (by norm_num) hq)
    positivity
  have hdelta0 : 0 ≤ delta := hdeltaPos.le
  have heta0 : 0 ≤ eta := by dsimp [eta]; positivity
  rcases exists_scaledPhase_good_block_of_energy_le
      n W points u t a E hW ha henergy hblock with ⟨s, hs, hgood⟩
  have hsle : s ≤ 2 * n := by omega
  have hjbase : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ (n : ℝ) := by
    have hsreal : (s : ℝ) ≤ 2 * (n : ℝ) := by exact_mod_cast hsle
    simp only [Int.cast_sub, Int.cast_natCast]
    rw [abs_le]
    constructor <;> linarith
  have hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H :=
    hjbase.trans hJsize
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge⟩
  let target : ReflectedMode m := (r, true)
  rcases exists_reflectedMode_dirichletStep n m Q hn hQ points with
    ⟨q₀, hq₀1, hq₀Q, hdirichletStrict⟩
  have hdirichlet : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ eta := by
    intro b
    exact (hdirichletStrict b).le
  have hq₀K : q₀ ≤ Nat.floor K + 1 := hq₀Q.trans hQK
  have hdist : ∀ b : ReflectedMode m, b ≠ target →
      rho ≤ distanceToInteger
        ((reflectedModeTime points target - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
    intro b hbt
    simpa [rho] using reflectedMode_distance_lower
      n hn K lam points hsmooth hspread target b hbt.symm
  rcases exists_variableReflectedSteps n hn points target q hq rho hrho' hdist with
    ⟨step, hstep, hsep⟩
  let twists := variableReflectedTwists n points step target
  have hlen : twists.length = ellTwist := by
    simpa [twists, ellTwist, phaseTwistCount] using
      variableReflectedTwists_length n points step target
  have hsum : variableStepSum twists ≤ ellTwist * q := by
    have hs' := variableReflectedTwists_stepSum_le n points step target q
      (fun b hbt ↦ (hstep b hbt).2.le)
    simpa [twists, ellTwist, phaseTwistCount] using hs'
  have hspan : variableTwistSpan twists ≤ 2 * (ellTwist * q) := by
    rw [variableTwistSpan_eq_two_mul_stepSum]
    omega
  have hsep' : ∀ b : ReflectedMode m, b ≠ target →
      delta ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖ := by
    simpa [delta, rho] using hsep
  have hl1 := phaseL1_le_of_phaseNormSq_eq_one u hu
  have hq₀Real : (q₀ : ℝ) ≤ (Q ^ (2 * m) : ℕ) := by exact_mod_cast hq₀Q
  have hunwrapActual :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (eta ^ (2 * k) +
              2 * (k : ℝ) * (q₀ : ℝ) / n * eta ^ (2 * k - 1))) +
        (2 : ℝ) ^ (2 * k) * a < 1 := by
    apply lt_of_le_of_lt _ hunwrap
    have hsecond :
        2 * (k : ℝ) * (q₀ : ℝ) / n * eta ^ (2 * k - 1) ≤
          2 * (k : ℝ) * ((Q ^ (2 * m) : ℕ) : ℝ) / n *
            eta ^ (2 * k - 1) := by
      gcongr
    have hl1' : (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤
        ((4 * m : ℕ) : ℝ) := by
      convert hl1 using 1 <;> push_cast <;> ring
    have hinside :
        (∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (eta ^ (2 * k) +
              2 * (k : ℝ) * (q₀ : ℝ) / n * eta ^ (2 * k - 1)) ≤
          ((4 * m : ℕ) : ℝ) *
            ((2 * Real.pi / Q) ^ (2 * k) +
              2 * (k : ℝ) * ((Q ^ (2 * m) : ℕ) : ℝ) / n *
                (2 * Real.pi / Q) ^ (2 * k - 1)) := by
      dsimp [eta]
      exact mul_le_mul hl1' (add_le_add le_rfl hsecond)
        (by positivity) (by positivity)
    exact add_le_add
      (mul_le_mul_of_nonneg_left hinside (by positivity)) le_rfl
  have hmultiple : ∀ ell ∈ Finset.Ico 1 R,
      ‖complexWave n (reflectedModeTime points target)
          ((ell * q₀ : ℕ) : ℤ) - 1‖ ≤ ε := by
    intro ell hell
    have hellR : ell + 1 ≤ R := (Finset.mem_Ico.mp hell).2
    have hstepBound : (ell + 1) * q₀ ≤ R * Q ^ (2 * m) :=
      Nat.mul_le_mul hellR hq₀Q
    have hfitActual :
        2 * H + variableTwistSpan twists + 2 * k * (ell + 1) * q₀ ≤ W := by
      have hscaled : 2 * k * ((ell + 1) * q₀) ≤
          2 * k * (R * Q ^ (2 * m)) :=
        Nat.mul_le_mul_left (2 * k) hstepBound
      calc
        2 * H + variableTwistSpan twists + 2 * k * (ell + 1) * q₀ ≤
            2 * H + 2 * (ellTwist * q) +
              2 * k * ((ell + 1) * q₀) := by
                simpa [Nat.mul_assoc] using
                  Nat.add_le_add_right
                    (Nat.add_le_add_left hspan (2 * H))
                    (2 * k * ((ell + 1) * q₀))
        _ ≤ 2 * H + 2 * (ellTwist * q) +
              2 * k * (R * Q ^ (2 * m)) := by
                exact Nat.add_le_add_left
                  (by simpa [Nat.mul_assoc] using hscaled) _
        _ ≤ W := by simpa [ellTwist] using hfit
    by_contra hlargeChord
    have htarget : ε ≤
        ‖complexWave n (reflectedModeTime points (r, true))
            ((ell * q₀ : ℕ) : ℤ) - 1‖ := by
      simpa [target, not_le] using le_of_not_ge hlargeChord
    rcases hlarge with hpos | hvel
    · have hA := sqrt_one_div_eight_mul_le_reflectedPositionCoeff_true
        hm u hu r hpos
      have hB := norm_reflectedVelocityCoeff_true_le_half_of_phaseNormSq_eq_one
        u hu r
      have hchordUpper :
          ‖complexWave n (reflectedModeTime points target)
              ((ell * q₀ : ℕ) : ℤ) - 1‖ ≤ 2 := by
        calc
          ‖complexWave n (reflectedModeTime points target)
              ((ell * q₀ : ℕ) : ℤ) - 1‖ ≤
              ‖complexWave n (reflectedModeTime points target)
                ((ell * q₀ : ℕ) : ℤ)‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
          _ = 2 := by norm_num [norm_complexWave]
      have hchordPow :
          ‖complexWave n (reflectedModeTime points target)
              ((ell * q₀ : ℕ) : ℤ) - 1‖ ^ (2 * k) ≤
            (2 : ℝ) ^ (2 * k) :=
        pow_le_pow_left₀ (norm_nonneg _) hchordUpper _
      have hsumReal : (variableStepSum twists : ℝ) ≤
          ((ellTwist * q : ℕ) : ℝ) := by exact_mod_cast hsum
      have hellqReal : ((ell * q₀ : ℕ) : ℝ) ≤
          ((R * Q ^ (2 * m) : ℕ) : ℝ) := by
        exact_mod_cast
          (Nat.mul_le_mul_right q₀ (Nat.le_succ ell) |>.trans hstepBound)
      have hcorrActual :
          2 * (4 : ℝ) ^ twists.length *
              (‖reflectedVelocityCoeff u target‖ *
                ‖complexWave n (reflectedModeTime points target)
                    ((ell * q₀ : ℕ) : ℤ) - 1‖ ^ (2 * k)) *
              (variableStepSum twists : ℝ) / n +
            ((k : ℝ) * (4 : ℝ) ^ k *
                ‖reflectedVelocityCoeff u target‖ *
                  ((ell * q₀ : ℕ) : ℝ) / n) *
              delta ^ (2 * twists.length) ≤
          (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
            delta ^ (2 * twists.length)) / 2 := by
        have hleft :
            2 * (4 : ℝ) ^ twists.length *
                (‖reflectedVelocityCoeff u target‖ *
                  ‖complexWave n (reflectedModeTime points target)
                      ((ell * q₀ : ℕ) : ℤ) - 1‖ ^ (2 * k)) *
                (variableStepSum twists : ℝ) / n +
              ((k : ℝ) * (4 : ℝ) ^ k *
                  ‖reflectedVelocityCoeff u target‖ *
                    ((ell * q₀ : ℕ) : ℝ) / n) *
                delta ^ (2 * twists.length) ≤
            2 * (4 : ℝ) ^ ellTwist *
                ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
                ((ellTwist * q : ℕ) : ℝ) / n +
              ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) *
                  ((R * Q ^ (2 * m) : ℕ) : ℝ) / n) *
                delta ^ (2 * ellTwist) := by
          rw [hlen]
          gcongr
        rw [hlen] at hleft ⊢
        exact hleft.trans (by
          convert hcorr using 1 <;>
            simp only [delta, rho, ellTwist] <;> ring)
      have hforce := goodBlock_largePosition_forces_latticeEnergy_multiple_pow_gap
        n hn points u t ht q₀ ell k eta heta0 hdirichlet
        s W hs a ha.le hgood step r delta hdelta0
        (by simpa [target] using hsep') H hH J hJ hj
        (by simpa [twists, target] using hfitActual) hunwrapActual
        (Real.sqrt (1 / (8 * (m : ℝ)))) ε (Real.sqrt_nonneg _) hε0
        (by simpa [target] using hA) (by simpa [target] using htarget)
        (by simpa [twists, target] using hcorrActual)
      have hbudget :
          (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
              (variableReflectedTwists n points step (r, true)).length *
            ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
              phaseLatticeEnergy n points u t) ≤
          (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
              (variableReflectedTwists n points step (r, true)).length *
            ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E) := by
        gcongr
      have hforce' := hforce.trans hbudget
      rw [show (variableReflectedTwists n points step (r, true)).length =
          ellTwist by simpa [twists, target] using hlen] at hforce'
      have hforced :
          phaseHighPositionDemand m H k ellTwist ε delta ≤
            phaseHighPositionBudget t E J ellTwist k := by
        simpa [phaseHighPositionDemand, phaseHighPositionBudget] using hforce'
      exact (not_le_of_gt (by simpa [ellTwist, delta, rho] using hposition)
        hforced).elim
    · have hforce := goodBlock_largeVelocity_forces_latticeEnergy_multiple_pow_gap
        n hn points u t ht q₀ ell k eta heta0 hdirichlet
        s W hs a ha.le hgood step r delta hdelta0
        (by simpa [target] using hsep') H hH
        (by simpa [twists, target] using hfitActual) hunwrapActual
        (1 / (2 * (m : ℝ))) ε (by positivity) hε0
        (by simpa [hu] using hvel) (by simpa [target] using htarget)
      have hbudget :
          2 * (36 : ℝ) ^
              (variableReflectedTwists n points step (r, true)).length *
            ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
              phaseLatticeEnergy n points u t) ≤
          2 * (36 : ℝ) ^
              (variableReflectedTwists n points step (r, true)).length *
            ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E) := by
        gcongr
      have hforce' := hforce.trans hbudget
      rw [show (variableReflectedTwists n points step (r, true)).length =
          ellTwist by simpa [twists, target] using hlen] at hforce'
      have hforced :
          phaseHighVelocityDemand n m H k ellTwist ε delta ≤
            phaseHighVelocityBudget t E ellTwist k := by
        convert hforce' using 1 <;>
          (try dsimp only [phaseHighVelocityDemand, phaseHighVelocityBudget])
        all_goals first | rfl | ring
      exact (not_le_of_gt (by simpa [ellTwist, delta, rho] using hvelocity)
        hforced).elim
  have hsmoothTarget : IsSmooth n K (reflectedModeTime points target) := by
    simpa [target, reflectedModeTime] using hsmooth r
  rcases hsmoothTarget.exists_large_multipleWave hn hq₀1 hq₀K
      R hR ε hε0 hεsmall hscale with ⟨ell, hell, hlargeChord⟩
  exact (not_lt_of_ge (hmultiple ell hell)) hlargeChord

/-- Exact characteristic-function consequence of source-shaped
high-frequency rigidity. -/
theorem norm_projectedPhaseWalk_charFun_high_frequency_of_rigidity
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t E : ℝ)
    (henergy : E < phaseLatticeEnergy n points u t) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
      (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤ Real.exp (-E) :=
  norm_projectedPhaseWalk_charFun_le_exp_neg n points u t E henergy.le

/-- The explicit Cook--Nguyen scales satisfy every hypothesis of the
source-shaped rigidity theorem, uniformly throughout the high-frequency
window used in the local limit argument. -/
theorem eventually_phaseLatticeEnergy_high_frequency
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (u : PhaseCoordinate m)
        (t : ℝ),
      phaseNormSq u = 1 →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      rigidityPower n (-1 / 8) ≤ |t| →
      |t| ≤ rigidityPower n (rigidityFourierExponent m) →
      rigidityEnergyScale n < phaseLatticeEnergy n points u t := by
  filter_upwards [eventually_rigidity_scale_positivity hm,
      eventually_rigidity_fit_condition hm,
      eventually_rigidity_location_condition,
      eventually_rigidity_block_condition,
      eventually_rigidity_unwrap_condition hm,
      eventually_rigidity_correction_condition hm,
      eventually_rigidity_demand_conditions hm]
    with n hscales hfit hJsize hblock hunwrap hcorr hdemand
  rcases hscales with
    ⟨hn, hQ, hR, hq, hW, hH, hε, hεsmall, ha, hE, hJ⟩
  intro points u t hu hsmooth hspread htLower htUpper
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hK : 0 < rigiditySmoothScale n := by
    unfold rigiditySmoothScale
    exact rigidityPower_pos hn _
  have hrho : 0 < min
      (rigiditySmoothScale n / n) (rigiditySmoothScale n / n) := by
    simpa using div_pos hK hnreal
  have ht : t ≠ 0 := by
    intro ht
    subst t
    simp only [abs_zero] at htLower
    exact (not_le_of_gt (rigidityPower_pos hn (-1 / 8))) htLower
  have hdemandN := hdemand t htLower
  refine phaseLatticeEnergy_high_frequency_rigidity
    n m (rigidityDirichletScale m n) (rigidityPropagationScale m n)
    (rigidityDilationStepScale m n) (rigidityDifferenceOrder m)
    (rigidityBlockScale n) (rigidityCoreScale n)
    hn hm hQ hR hq hW hH
    (rigiditySmoothScale n) (rigiditySmoothScale n)
    (rigidityEpsilonScale m n) (rigidityGoodThresholdScale n) t
    (rigidityEnergyScale n) (rigidityLocationScale n)
    points u hu hsmooth hspread hrho
    (rigidityDirichletScale_pow_le_smooth hm hn) hε.le hεsmall
    (rigidity_propagation_scale_condition hm hn) ha ht hblock hfit hJ
    hJsize (hunwrap t htUpper)
    (by simpa only [min_self] using
      (individualDilationGap_le_one
        (rigidityDilationStepScale m n) (rigiditySmoothScale n / n)))
    (by simpa only [min_self] using hcorr)
    (by simpa only [min_self] using hdemandN.1)
    (by simpa only [min_self] using hdemandN.2)

/-- Uniform exponential Fourier decay in the same explicit high-frequency
window. -/
theorem eventually_norm_projectedPhaseWalk_charFun_high_frequency
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (u : PhaseCoordinate m)
        (t : ℝ),
      phaseNormSq u = 1 →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      rigidityPower n (-1 / 8) ≤ |t| →
      |t| ≤ rigidityPower n (rigidityFourierExponent m) →
      ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
          (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤
        Real.exp (-rigidityEnergyScale n) := by
  filter_upwards [eventually_phaseLatticeEnergy_high_frequency hm]
    with n henergy
  intro points u t hu hsmooth hspread htLower htUpper
  exact norm_projectedPhaseWalk_charFun_high_frequency_of_rigidity
    n points u t (rigidityEnergyScale n)
    (henergy points u t hu hsmooth hspread htLower htUpper)

/-- Polar form of the explicit high-frequency estimate for the normalized
multivariate characteristic function. -/
theorem eventually_norm_normalizedPhaseCharFun_high_frequency
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (u : PhaseCoordinate m),
      0 < phaseNormSq u →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      rigidityPower n (-1 / 8) ≤ |normalizedPhaseFrequency n u| →
      |normalizedPhaseFrequency n u| ≤
        rigidityPower n (rigidityFourierExponent m) →
      ‖normalizedPhaseCharFun n points u‖ ≤
        Real.exp (-rigidityEnergyScale n) := by
  filter_upwards [eventually_phaseLatticeEnergy_high_frequency hm]
    with n henergy
  intro points u hu hsmooth hspread htLower htUpper
  apply norm_normalizedPhaseCharFun_le_exp_neg_of_phaseLatticeEnergy
    n points u hu (rigidityEnergyScale n)
  exact (henergy points (phaseUnit u) (normalizedPhaseFrequency n u)
    (phaseNormSq_phaseUnit u hu) hsmooth hspread htLower htUpper).le

/-! ### Gaussian smoothing and multidimensional inversion -/

/-- The explicit coordinate pairing is the Euclidean inner product after
transport to the genuine `L²` phase space. -/
lemma phasePairing_eq_inner (u z : PhaseCoordinate m) :
    phasePairing u z = ⟪phaseToEuclidean u, phaseToEuclidean z⟫ := by
  simp [phasePairing, phaseToEuclidean, EuclideanSpace.inner_toLp_toLp,
    dotProduct, Fintype.sum_prod_type, mul_comm]

lemma finrank_phaseEuclidean :
    Module.finrank ℝ (PhaseEuclidean m) = 4 * m := by
  simp [PhaseEuclidean, mul_comm]

/-- The normalized phase walk as a vector in Euclidean `4m`-space. -/
noncomputable def normalizedPhaseEuclideanWalk
    (n : ℕ) (ε : SignVector (2 * n)) (points : Fin m → ℝ) :
    PhaseEuclidean m :=
  phaseToEuclidean (normalizedPhaseWalk n ε points)

/-- Euclidean-space form of the characteristic function. -/
lemma normalizedPhaseCharFun_euclidean
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseEuclidean m) :
    normalizedPhaseCharFun n points (euclideanToPhase u) =
      Erdos88.Fourier.finExpectation (SignVector (2 * n)) (fun ε ↦
        Complex.exp (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
          Complex.I)) := by
  unfold normalizedPhaseCharFun normalizedPhaseEuclideanWalk
  apply congrArg (Erdos88.Fourier.finExpectation (SignVector (2 * n)))
  funext ε
  congr 2
  rw [phasePairing_eq_inner]
  simp

/-- The elementary Gaussian integral in the characteristic-function
normalization `exp (i⟪u,w⟫)`.  Keeping the complex-power normalization in
the statement avoids hiding the dimension-dependent Fourier constant. -/
lemma phaseGaussian_integral
    (m : ℕ) (σ : ℝ) (hσ : 0 < σ) (w : PhaseEuclidean m) :
    (∫ u : PhaseEuclidean m,
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2 +
        Complex.I * (⟪w, u⟫ : ℂ))) =
      ((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
        Complex.exp (-((‖w‖ ^ 2 / (2 * σ ^ 2) : ℝ) : ℂ)) := by
  have h := GaussianFourier.integral_cexp_neg_mul_sq_norm_add
    (V := PhaseEuclidean m) (b := ((σ ^ 2 / 2 : ℝ) : ℂ))
    (by
      change 0 < σ ^ 2 / 2
      positivity) Complex.I w
  rw [h]
  congr 2
  rw [Complex.I_sq]
  push_cast
  field_simp [hσ.ne']
  ring

/-- Uniform expectation of the unnormalized Gaussian kernel centred at the
normalized phase walk. -/
noncomputable def phaseGaussianSmoothedMass
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (y : PhaseEuclidean m) : ℂ :=
  Erdos88.Fourier.finExpectation (SignVector (2 * n)) (fun ε ↦
    Complex.exp (-((‖normalizedPhaseEuclideanWalk n ε points - y‖ ^ 2 /
      (2 * σ ^ 2) : ℝ) : ℂ)))

lemma phaseSmoothing_term_eq
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (y u : PhaseEuclidean m)
    (ε : SignVector (2 * n)) :
    Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
        Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
        Complex.exp (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
          Complex.I) =
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2 +
        Complex.I *
          (⟪normalizedPhaseEuclideanWalk n ε points - y, u⟫ : ℂ)) := by
  rw [← Complex.exp_add, ← Complex.exp_add]
  congr 1
  rw [inner_sub_left]
  simp only [real_inner_comm u]
  push_cast
  ring

lemma integrable_phaseSmoothing_term
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) (ε : SignVector (2 * n)) :
    Integrable (fun u : PhaseEuclidean m ↦
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
        Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
        Complex.exp (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
          Complex.I)) := by
  have h := GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
    (V := PhaseEuclidean m) (b := ((σ ^ 2 / 2 : ℝ) : ℂ))
    (by
      change 0 < σ ^ 2 / 2
      positivity) Complex.I
      (normalizedPhaseEuclideanWalk n ε points - y)
  exact h.congr (Eventually.of_forall fun u ↦
    (phaseSmoothing_term_eq n points σ y u ε).symm)

lemma integral_phaseSmoothing_term
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) (ε : SignVector (2 * n)) :
    (∫ u : PhaseEuclidean m,
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
        Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
        Complex.exp (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
          Complex.I)) =
      ((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
        Complex.exp
          (-((‖normalizedPhaseEuclideanWalk n ε points - y‖ ^ 2 /
            (2 * σ ^ 2) : ℝ) : ℂ)) := by
  apply Eq.trans (integral_congr_ae (Eventually.of_forall fun u ↦
    phaseSmoothing_term_eq n points σ y u ε))
  exact phaseGaussian_integral m σ hσ
    (normalizedPhaseEuclideanWalk n ε points - y)

/-- Exact Fourier inversion after Gaussian smoothing.  This is a finite
identity, not a probabilistic limit: the normalized counting expectation is
moved through the integral and every summand is evaluated by the preceding
Gaussian formula. -/
theorem phaseGaussianSmoothedMass_fourier
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) :
    (∫ u : PhaseEuclidean m,
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
        Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
        normalizedPhaseCharFun n points (euclideanToPhase u)) =
      ((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
        phaseGaussianSmoothedMass n points σ y := by
  rw [show (fun u : PhaseEuclidean m ↦
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
        Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
        normalizedPhaseCharFun n points (euclideanToPhase u)) =
      (fun u ↦ (∑ ε : SignVector (2 * n),
        Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
          Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
          Complex.exp
            (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
              Complex.I)) /
        (Fintype.card (SignVector (2 * n)) : ℂ)) by
    funext u
    rw [normalizedPhaseCharFun_euclidean]
    unfold Erdos88.Fourier.finExpectation
    have hsum :
        (∑ ε : SignVector (2 * n),
          Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
            Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
                Complex.I)) =
          (Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
            Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I)) *
              ∑ ε : SignVector (2 * n),
                Complex.exp
                  (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
                    Complex.I) := by
      rw [Finset.mul_sum]
    rw [hsum]
    ring]
  rw [integral_div]
  rw [integral_finsetSum]
  · simp_rw [integral_phaseSmoothing_term n points σ hσ y]
    unfold phaseGaussianSmoothedMass Erdos88.Fourier.finExpectation
    have hsum :
        (∑ ε : SignVector (2 * n),
          ((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
              ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
            Complex.exp
              (-((‖normalizedPhaseEuclideanWalk n ε points - y‖ ^ 2 /
                (2 * σ ^ 2) : ℝ) : ℂ))) =
          ((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
              ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
            ∑ ε : SignVector (2 * n),
              Complex.exp
                (-((‖normalizedPhaseEuclideanWalk n ε points - y‖ ^ 2 /
                  (2 * σ ^ 2) : ℝ) : ℂ)) := by
      rw [Finset.mul_sum]
    rw [hsum]
    ring
  · intro ε _hε
    exact integrable_phaseSmoothing_term n points σ hσ y ε

/-- The radial Gaussian multiplier and oscillatory Fourier phase. -/
noncomputable def phaseFourierMultiplier
    (σ : ℝ) (y u : PhaseEuclidean m) : ℂ :=
  Complex.exp (((-(σ ^ 2 / 2) * ‖u‖ ^ 2 : ℝ) : ℂ)) *
    Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I)

lemma norm_phaseFourierMultiplier
    (σ : ℝ) (y u : PhaseEuclidean m) :
    ‖phaseFourierMultiplier σ y u‖ =
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) := by
  unfold phaseFourierMultiplier
  rw [norm_mul, Complex.norm_exp, Complex.norm_exp]
  have hfirst :
      (((-(σ ^ 2 / 2) * ‖u‖ ^ 2 : ℝ) : ℂ)).re =
        -(σ ^ 2 / 2) * ‖u‖ ^ 2 := rfl
  have hsecond : (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I).re = 0 := by simp
  rw [hfirst, hsecond, Real.exp_zero, mul_one]

lemma continuous_phaseFourierMultiplier
    (σ : ℝ) (y : PhaseEuclidean m) :
    Continuous (phaseFourierMultiplier σ y) := by
  unfold phaseFourierMultiplier
  fun_prop

lemma phaseFourierMultiplier_eq
    (σ : ℝ) (y u : PhaseEuclidean m) :
    phaseFourierMultiplier σ y u =
      Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
        Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) := by
  unfold phaseFourierMultiplier
  congr 2
  push_cast
  ring

/-- Gaussian-weighted inverse characteristic-function integral. -/
noncomputable def phaseFourierIntegral
    (σ : ℝ) (y : PhaseEuclidean m) (φ : PhaseEuclidean m → ℂ) : ℂ :=
  ∫ u, phaseFourierMultiplier σ y u * φ u

lemma phaseFourierIntegral_normalizedPhaseCharFun
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) :
    phaseFourierIntegral σ y
        (fun u ↦ normalizedPhaseCharFun n points (euclideanToPhase u)) =
      ((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
        phaseGaussianSmoothedMass n points σ y := by
  unfold phaseFourierIntegral
  apply Eq.trans (integral_congr_ae (Eventually.of_forall fun u ↦ by
    rw [phaseFourierMultiplier_eq]))
  exact phaseGaussianSmoothedMass_fourier n points σ hσ y

lemma integrable_phaseFourier_normalizedPhaseCharFun
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) :
    Integrable (fun u ↦ phaseFourierMultiplier σ y u *
      normalizedPhaseCharFun n points (euclideanToPhase u)) := by
  rw [show (fun u : PhaseEuclidean m ↦ phaseFourierMultiplier σ y u *
      normalizedPhaseCharFun n points (euclideanToPhase u)) =
      (fun u ↦ (∑ ε : SignVector (2 * n),
        Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
          Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
          Complex.exp
            (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
              Complex.I)) /
        (Fintype.card (SignVector (2 * n)) : ℂ)) by
    funext u
    rw [phaseFourierMultiplier_eq,
      normalizedPhaseCharFun_euclidean]
    unfold Erdos88.Fourier.finExpectation
    have hsum :
        (∑ ε : SignVector (2 * n),
          Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
            Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
                Complex.I)) =
          (Complex.exp (-((σ ^ 2 / 2 : ℝ) : ℂ) * ‖u‖ ^ 2) *
            Complex.exp (-((⟪u, y⟫ : ℝ) : ℂ) * Complex.I)) *
              ∑ ε : SignVector (2 * n),
                Complex.exp
                  (((⟪u, normalizedPhaseEuclideanWalk n ε points⟫ : ℝ) : ℂ) *
                    Complex.I) := by
      rw [Finset.mul_sum]
    rw [hsum]
    ring]
  exact (integrable_finsetSum (Finset.univ : Finset (SignVector (2 * n)))
    (fun ε _hε ↦ integrable_phaseSmoothing_term n points σ hσ y ε)).div_const _

/-- A generic `L¹` comparison for two Gaussian-smoothed Fourier inversions. -/
lemma norm_phaseFourierIntegral_sub_le
    (σ : ℝ) (y : PhaseEuclidean m) (φ ψ : PhaseEuclidean m → ℂ)
    (hφ : Integrable (fun u ↦ phaseFourierMultiplier σ y u * φ u))
    (hψ : Integrable (fun u ↦ phaseFourierMultiplier σ y u * ψ u)) :
    ‖phaseFourierIntegral σ y φ - phaseFourierIntegral σ y ψ‖ ≤
      ∫ u : PhaseEuclidean m,
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) * ‖φ u - ψ u‖ := by
  unfold phaseFourierIntegral
  rw [← integral_sub hφ hψ]
  have h := norm_integral_le_integral_norm (μ := volume)
    (fun u : PhaseEuclidean m ↦
      phaseFourierMultiplier σ y u * (φ u - ψ u))
  convert h using 1
  · apply congrArg norm
    apply integral_congr_ae
    filter_upwards [] with u
    ring
  · apply integral_congr_ae
    filter_upwards [] with u
    rw [norm_mul, norm_phaseFourierMultiplier]

lemma integrable_phaseGaussianRadial
    (m : ℕ) (σ : ℝ) (hσ : 0 < σ) :
    Integrable (fun u : PhaseEuclidean m ↦
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2)) := by
  have h := (GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
    (V := PhaseEuclidean m) (b := ((σ ^ 2 / 2 : ℝ) : ℂ))
    (by
      change 0 < σ ^ 2 / 2
      positivity) 0 (0 : PhaseEuclidean m)).norm
  apply h.congr
  filter_upwards [] with u
  rw [Complex.norm_exp]
  have hexp :
      (-((σ ^ 2 / 2 : ℝ) : ℂ) * (‖u‖ : ℂ) ^ 2 +
        0 * (⟪(0 : PhaseEuclidean m), u⟫ : ℂ)) =
        ((-(σ ^ 2 / 2) * ‖u‖ ^ 2 : ℝ) : ℂ) := by
    push_cast
    ring
  rw [hexp]
  rfl

/-- Characteristic function of the centered Gaussian having exactly the
finite-`n` covariance quadratic form. -/
noncomputable def normalizedPhaseCovarianceGaussian
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseEuclidean m) : ℂ :=
  (Real.exp
    (-(normalizedPhaseCovarianceForm n points (euclideanToPhase u)) / 2) : ℂ)

lemma norm_normalizedPhaseCovarianceGaussian_le_one
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseEuclidean m) :
    ‖normalizedPhaseCovarianceGaussian n points u‖ ≤ 1 := by
  unfold normalizedPhaseCovarianceGaussian
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]
  rw [Real.exp_le_one_iff]
  exact div_nonpos_of_nonpos_of_nonneg
    (neg_nonpos.mpr (normalizedPhaseCovarianceForm_nonneg n points _))
    (by norm_num)

lemma continuous_normalizedPhaseCovarianceGaussian
    (n : ℕ) (points : Fin m → ℝ) :
    Continuous (normalizedPhaseCovarianceGaussian n points) := by
  unfold normalizedPhaseCovarianceGaussian normalizedPhaseCovarianceForm
    phaseProjection euclideanToPhase
  fun_prop

lemma integrable_phaseFourier_covarianceGaussian
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) :
    Integrable (fun u ↦ phaseFourierMultiplier σ y u *
      normalizedPhaseCovarianceGaussian n points u) := by
  apply (integrable_phaseGaussianRadial m σ hσ).mono'
  · exact ((continuous_phaseFourierMultiplier σ y).mul
      (continuous_normalizedPhaseCovarianceGaussian n points)).aestronglyMeasurable
  · filter_upwards [] with u
    rw [norm_mul, norm_phaseFourierMultiplier]
    exact mul_le_of_le_one_right (Real.exp_nonneg _)
      (norm_normalizedPhaseCovarianceGaussian_le_one n points u)

/-- The smoothed local-CLT error is bounded exactly by the Gaussian-weighted
`L¹` distance between the Rademacher and covariance-Gaussian characteristic
functions. -/
theorem norm_phaseGaussianSmoothedMass_sub_covarianceFourier
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ)
    (y : PhaseEuclidean m) :
    ‖((Real.pi : ℂ) / ((σ ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
        phaseGaussianSmoothedMass n points σ y -
      phaseFourierIntegral σ y
        (normalizedPhaseCovarianceGaussian n points)‖ ≤
      ∫ u : PhaseEuclidean m,
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖ := by
  rw [← phaseFourierIntegral_normalizedPhaseCharFun n points σ hσ y]
  exact norm_phaseFourierIntegral_sub_le σ y _ _
    (integrable_phaseFourier_normalizedPhaseCharFun n points σ hσ y)
    (integrable_phaseFourier_covarianceGaussian n points σ hσ y)

/-- Major-arc comparison in intrinsic Euclidean coordinates. -/
lemma norm_phaseCharFun_sub_covarianceGaussian_major_euclidean
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseEuclidean m)
    (hu : (4 * m : ℝ) * ‖u‖ ≤ Real.sqrt (2 * n + 1 : ℝ)) :
    ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
        normalizedPhaseCovarianceGaussian n points u‖ ≤
      ((4 * m : ℝ) * ‖u‖) ^ 4 / (2 * n + 1 : ℝ) := by
  have hL := phaseL1_le_dim_mul_euclideanNorm (euclideanToPhase u)
  rw [phaseToEuclidean_euclideanToPhase] at hL
  have hmajor := norm_normalizedPhaseCharFun_sub_covarianceGaussian_le
    n points (euclideanToPhase u) (hL.trans hu)
  have hpow :
      (∑ r : Fin m, ∑ c : Fin 4, |euclideanToPhase u r c|) ^ 4 ≤
        ((4 * m : ℝ) * ‖u‖) ^ 4 :=
    pow_le_pow_left₀ (by positivity) hL 4
  simpa [normalizedPhaseCovarianceGaussian] using
    hmajor.trans (div_le_div_of_nonneg_right hpow (by positivity))

lemma norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
    (n : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (u : PhaseEuclidean m) :
    ‖normalizedPhaseCovarianceGaussian n points u‖ ≤
      Real.exp (-(‖u‖ ^ 2 / 24)) := by
  unfold normalizedPhaseCovarianceGaussian
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]
  apply Real.exp_le_exp.mpr
  have hlow := normalizedPhaseCovarianceForm_lower
    n points (1 / 12) hcov (euclideanToPhase u)
  rw [phaseNormSq_euclideanToPhase] at hlow
  nlinarith

/-- On the no-wrap ball both characteristic functions have integrable
Gaussian envelopes. -/
lemma norm_phaseCharFun_sub_covarianceGaussian_noWrap
    (n : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (u : PhaseEuclidean m)
    (hu : ‖u‖ ≤ phaseNoWrapRadius n m) :
    ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
        normalizedPhaseCovarianceGaussian n points u‖ ≤
      Real.exp (-(‖u‖ ^ 2 / (12 * Real.pi ^ 2))) +
        Real.exp (-(‖u‖ ^ 2 / 24)) := by
  calc
    ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
        normalizedPhaseCovarianceGaussian n points u‖ ≤
      ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖ +
        ‖normalizedPhaseCovarianceGaussian n points u‖ := norm_sub_le _ _
    _ ≤ Real.exp (-(‖u‖ ^ 2 / (12 * Real.pi ^ 2))) +
        Real.exp (-(‖u‖ ^ 2 / 24)) := add_le_add
      (by
        have hsmall := normalizedPhase_no_wrap_of_norm_le
          n m (euclideanToPhase u) (by simpa using hu)
        have h := norm_normalizedPhaseCharFun_le_fixedGaussian_of_covariance
          n points hcov (euclideanToPhase u) hsmall
        simpa [phaseNormSq_euclideanToPhase] using h)
      (norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
        n points hcov u)

lemma normalizedPhaseFrequency_euclidean
    (n : ℕ) (u : PhaseEuclidean m) :
    normalizedPhaseFrequency n (euclideanToPhase u) =
      ‖u‖ / Real.sqrt (2 * n + 1 : ℝ) := by
  unfold normalizedPhaseFrequency
  rw [phaseNormSq_euclideanToPhase, Real.sqrt_sq (norm_nonneg u)]

/-- The rigidity estimate with its scalar-frequency window converted to
Euclidean radii. -/
theorem eventually_norm_normalizedPhaseCharFun_high_frequency_euclidean
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (u : PhaseEuclidean m),
      0 < ‖u‖ →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      Real.sqrt (2 * n + 1 : ℝ) * rigidityPower n (-1 / 8) ≤ ‖u‖ →
      ‖u‖ ≤ Real.sqrt (2 * n + 1 : ℝ) *
        rigidityPower n (rigidityFourierExponent m) →
      ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖ ≤
        Real.exp (-rigidityEnergyScale n) := by
  filter_upwards [eventually_norm_normalizedPhaseCharFun_high_frequency hm]
    with n hhigh
  intro points u hu hsmooth hspread hlower hupper
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hnormsq : 0 < phaseNormSq (euclideanToPhase u) := by
    rw [phaseNormSq_euclideanToPhase]
    positivity
  apply hhigh points (euclideanToPhase u) hnormsq hsmooth hspread
  · rw [normalizedPhaseFrequency_euclidean,
      abs_of_nonneg (div_nonneg (norm_nonneg u) hsqrt.le)]
    exact (le_div_iff₀ hsqrt).2 (by simpa [mul_comm] using hlower)
  · rw [normalizedPhaseFrequency_euclidean,
      abs_of_nonneg (div_nonneg (norm_nonneg u) hsqrt.le)]
    exact (div_le_iff₀ hsqrt).2 (by simpa [mul_comm] using hupper)

lemma norm_phaseCharFun_sub_covarianceGaussian_high
    (n : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (u : PhaseEuclidean m)
    (hchar : ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖ ≤
      Real.exp (-rigidityEnergyScale n)) :
    ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
        normalizedPhaseCovarianceGaussian n points u‖ ≤
      Real.exp (-rigidityEnergyScale n) +
        Real.exp (-(‖u‖ ^ 2 / 24)) := by
  exact (norm_sub_le _ _).trans (add_le_add hchar
    (norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
      n points hcov u))

lemma integrable_rexp_neg_mul_norm_sq
    (m : ℕ) (c : ℝ) (hc : 0 < c) :
    Integrable (fun u : PhaseEuclidean m ↦ Real.exp (-c * ‖u‖ ^ 2)) := by
  have h := (GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
    (V := PhaseEuclidean m) (b := (c : ℂ))
    (by simpa using hc) 0 (0 : PhaseEuclidean m)).norm
  apply h.congr
  filter_upwards [] with u
  rw [Complex.norm_exp]
  have hexp :
      (-(c : ℂ) * (‖u‖ : ℂ) ^ 2 +
        0 * (⟪(0 : PhaseEuclidean m), u⟫ : ℂ)) =
        ((-c * ‖u‖ ^ 2 : ℝ) : ℂ) := by
    push_cast
    ring
  rw [hexp]
  rfl

/-- The tail integral of every fixed radial Gaussian tends to zero. -/
lemma gaussianTail_tendsto
    (m : ℕ) (c : ℝ) (hc : 0 < c) :
    Tendsto (fun R : ℝ ↦
      ∫ u : PhaseEuclidean m in {u | R ≤ ‖u‖},
        Real.exp (-c * ‖u‖ ^ 2)) atTop (𝓝 0) := by
  have hanti : Antitone (fun R : ℝ ↦ {u : PhaseEuclidean m | R ≤ ‖u‖}) := by
    intro R S hRS u hu
    exact hRS.trans hu
  have hmeas : ∀ R : ℝ, MeasurableSet {u : PhaseEuclidean m | R ≤ ‖u‖} := by
    intro R
    exact measurableSet_le measurable_const continuous_norm.measurable
  have hinter : (⋂ R : ℝ, {u : PhaseEuclidean m | R ≤ ‖u‖}) = ∅ := by
    ext u
    simp only [Set.mem_iInter, Set.mem_ofPred_eq, Set.mem_empty_iff_false,
      iff_false]
    intro h
    have := h (‖u‖ + 1)
    linarith
  have h := tendsto_setIntegral_of_antitone
    (f := fun u : PhaseEuclidean m ↦ Real.exp (-c * ‖u‖ ^ 2))
    hmeas hanti
    ⟨0, (integrable_rexp_neg_mul_norm_sq m c hc).integrableOn⟩
  rw [hinter] at h
  simpa using h

lemma volume_real_phase_ball (m : ℕ) (hm : 0 < m) (R : ℝ) (hR : 0 ≤ R) :
    volume.real (Metric.ball (0 : PhaseEuclidean m) R) =
      R ^ (4 * m) * (Real.pi ^ (2 * m) / (2 * m).factorial) := by
  let r : Fin m := ⟨0, hm⟩
  let c : Fin 4 := ⟨0, by norm_num⟩
  let i : Fin m × Fin 4 := (r, c)
  let x : PhaseEuclidean m := WithLp.toLp 2 (Function.update 0 i 1)
  have hx : x ≠ 0 := by
    intro h
    have := congrArg (fun z : PhaseEuclidean m ↦ z i) h
    simpa [x, i] using this
  letI : Nontrivial (PhaseEuclidean m) := ⟨⟨x, 0, hx⟩⟩
  have hdim : Module.finrank ℝ (PhaseEuclidean m) = 2 * (2 * m) := by
    rw [finrank_phaseEuclidean]
    omega
  rw [measureReal_def]
  rw [InnerProductSpace.volume_ball_of_dim_even hdim]
  rw [ENNReal.toReal_mul]
  rw [ENNReal.toReal_pow, ENNReal.toReal_ofReal hR,
    ENNReal.toReal_ofReal (by positivity)]
  rw [finrank_phaseEuclidean]

/-- The major-arc contribution is bounded by its uniform Taylor error times
the exact volume of a `4m`-dimensional ball. -/
lemma majorArc_setIntegral_le
    (n m : ℕ) (hm : 0 < m) (points : Fin m → ℝ)
    (σ R : ℝ) (hR : 0 ≤ R)
    (hmajor : (4 * m : ℝ) * R ≤ Real.sqrt (2 * n + 1 : ℝ)) :
    (∫ u : PhaseEuclidean m in Metric.ball 0 R,
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      (((4 * m : ℝ) * R) ^ 4 / (2 * n + 1 : ℝ)) *
        (R ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) := by
  let A : ℝ := ((4 * m : ℝ) * R) ^ 4 / (2 * n + 1 : ℝ)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hconst : IntegrableOn (fun _u : PhaseEuclidean m ↦ A)
      (Metric.ball 0 R) := integrableOn_const
  calc
    (∫ u : PhaseEuclidean m in Metric.ball 0 R,
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
        ∫ _u : PhaseEuclidean m in Metric.ball 0 R, A := by
      apply setIntegral_mono_of_nonneg
      · intro u _hu
        positivity
      · intro u hu
        have hnorm : ‖u‖ ≤ R := (mem_ball_zero_iff.mp hu).le
        have hpoint := norm_phaseCharFun_sub_covarianceGaussian_major_euclidean
          n points u ((mul_le_mul_of_nonneg_left hnorm (by positivity)).trans hmajor)
        have hpoint' :
            ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
                normalizedPhaseCovarianceGaussian n points u‖ ≤ A := by
          apply hpoint.trans
          dsimp [A]
          gcongr
        have hweight : Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          exact mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr (by positivity)) (sq_nonneg ‖u‖)
        exact (mul_le_mul hweight hpoint' (norm_nonneg _) (by positivity)).trans_eq
          (one_mul A)
      · exact hconst
    _ = A * (R ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) := by
      rw [setIntegral_const]
      rw [volume_real_phase_ball m hm R hR]
      simp
      ring
    _ = (((4 * m : ℝ) * R) ^ 4 / (2 * n + 1 : ℝ)) *
        (R ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) := by rfl

noncomputable def localCLTMajorExponent (m : ℕ) : ℝ :=
  1 / (16 * (m + 1 : ℕ))

noncomputable def localCLTMajorRadius (m n : ℕ) : ℝ :=
  rigidityPower n (localCLTMajorExponent m)

noncomputable def localCLTMajorBound (m n : ℕ) : ℝ :=
  (((4 * m : ℝ) * localCLTMajorRadius m n) ^ 4 /
      (2 * n + 1 : ℝ)) *
    (localCLTMajorRadius m n ^ (4 * m) *
      (Real.pi ^ (2 * m) / (2 * m).factorial))

lemma localCLTMajor_exponent_identity (m : ℕ) :
    localCLTMajorExponent m * 4 +
        localCLTMajorExponent m * (4 * m) - 1 = -3 / 4 := by
  unfold localCLTMajorExponent
  push_cast
  field_simp
  ring

lemma localCLTMajorBound_le_power
    (m : ℕ) (n : ℕ) (hn : 0 < n) :
    localCLTMajorBound m n ≤
      ((4 * m : ℝ) ^ 4 *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) *
        rigidityPower n (-3 / 4) := by
  let η : ℝ := localCLTMajorExponent m
  let R : ℝ := localCLTMajorRadius m n
  let G : ℝ := Real.pi ^ (2 * m) / (2 * m).factorial
  let C : ℝ := (4 * m : ℝ) ^ 4 * G
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hR0 : 0 ≤ R := by
    dsimp [R, localCLTMajorRadius]
    exact rigidityPower_nonneg n _
  have hG0 : 0 ≤ G := by dsimp [G]; positivity
  have hC0 : 0 ≤ C := mul_nonneg (by positivity) hG0
  have hpow4 : R ^ 4 = rigidityPower n (η * 4) := by
    simpa [R, η, localCLTMajorRadius] using
      rigidityPower_nat_pow hn (localCLTMajorExponent m) 4
  have hpowdim : R ^ (4 * m) = rigidityPower n (η * (4 * m)) := by
    simpa [R, η, localCLTMajorRadius] using
      rigidityPower_nat_pow hn (localCLTMajorExponent m) (4 * m)
  have hnum :
      ((4 * m : ℝ) * R) ^ 4 * (R ^ (4 * m) * G) =
        C * rigidityPower n (η * 4 + η * (4 * m)) := by
    rw [mul_pow, hpow4, hpowdim]
    calc
      (4 * (m : ℝ)) ^ 4 * rigidityPower n (η * 4) *
          (rigidityPower n (η * (4 * (m : ℝ))) * G) =
        C * (rigidityPower n (η * 4) *
          rigidityPower n (η * (4 * (m : ℝ)))) := by
            dsimp [C]
            ring
      _ = C * rigidityPower n (η * 4 + η * (4 * (m : ℝ))) := by
        rw [rigidityPower_add hn]
  have hden : (n : ℝ) ≤ 2 * n + 1 := by
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hnum0 : 0 ≤ ((4 * m : ℝ) * R) ^ 4 * (R ^ (4 * m) * G) := by
    positivity
  have hdiv :
      (((4 * m : ℝ) * R) ^ 4 * (R ^ (4 * m) * G)) /
          (2 * n + 1 : ℝ) ≤
        (((4 * m : ℝ) * R) ^ 4 * (R ^ (4 * m) * G)) / n := by
    exact div_le_div_of_nonneg_left hnum0 hnreal hden
  have hexp : η * 4 + η * (4 * m) - 1 = -3 / 4 := by
    simpa [η] using localCLTMajor_exponent_identity m
  have hquot :
      C * rigidityPower n (η * 4 + η * (4 * m)) / n =
        C * rigidityPower n (-3 / 4) := by
    rw [← hexp]
    have hadd := rigidityPower_add hn
      (η * 4 + η * (4 * m) - 1) 1
    have hone : rigidityPower n 1 = (n : ℝ) := by simp [rigidityPower]
    rw [show η * 4 + η * (4 * m) - 1 + 1 =
        η * 4 + η * (4 * m) by ring] at hadd
    rw [hadd, hone]
    field_simp
  unfold localCLTMajorBound
  change ((((4 * m : ℝ) * R) ^ 4 / (2 * n + 1 : ℝ)) *
      (R ^ (4 * m) * G)) ≤ C * rigidityPower n (-3 / 4)
  rw [show (((4 * m : ℝ) * R) ^ 4 / (2 * n + 1 : ℝ)) *
      (R ^ (4 * m) * G) =
      (((4 * m : ℝ) * R) ^ 4 * (R ^ (4 * m) * G)) /
        (2 * n + 1 : ℝ) by ring]
  calc
    _ ≤ (((4 * m : ℝ) * R) ^ 4 * (R ^ (4 * m) * G)) / n := hdiv
    _ = C * rigidityPower n (η * 4 + η * (4 * m)) / n := by rw [hnum]
    _ = C * rigidityPower n (-3 / 4) := hquot

lemma tendsto_rigidityPower_neg_zero
    {α : ℝ} (hα : 0 < α) :
    Tendsto (fun n : ℕ ↦ rigidityPower n (-α)) atTop (𝓝 0) := by
  have h := tendsto_inv_atTop_zero.comp (tendsto_rigidityPower_atTop hα)
  apply h.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  unfold rigidityPower
  rw [Real.rpow_neg (by exact_mod_cast hn.le)]
  simp [Function.comp_apply]

lemma localCLTMajorBound_tendsto_zero (m : ℕ) :
    Tendsto (localCLTMajorBound m) atTop (𝓝 0) := by
  let C : ℝ := (4 * m : ℝ) ^ 4 *
    (Real.pi ^ (2 * m) / (2 * m).factorial)
  have hpower : Tendsto (fun n : ℕ ↦ C * rigidityPower n (-3 / 4))
      atTop (𝓝 0) := by
    convert (tendsto_rigidityPower_neg_zero
      (by norm_num : (0 : ℝ) < 3 / 4)).const_mul C using 1 <;> ring
  apply squeeze_zero'
  · exact Eventually.of_forall fun n ↦ by
      unfold localCLTMajorBound localCLTMajorRadius rigidityPower
      positivity
  · filter_upwards [Nat.eventually_pos] with n hn
    simpa [C] using localCLTMajorBound_le_power m n hn
  · exact hpower

lemma localCLTMajorExponent_pos (m : ℕ) :
    0 < localCLTMajorExponent m := by
  unfold localCLTMajorExponent
  positivity

lemma localCLTMajorExponent_lt_half (m : ℕ) :
    localCLTMajorExponent m < 1 / 2 := by
  unfold localCLTMajorExponent
  have hm : (1 : ℝ) ≤ (m + 1 : ℕ) := by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le m)
  rw [div_lt_div_iff₀ (by positivity : (0 : ℝ) < 16 * (m + 1 : ℕ))
    (by norm_num : (0 : ℝ) < 2)]
  push_cast
  linarith

lemma localCLTMajorRadius_tendsto_atTop (m : ℕ) :
    Tendsto (localCLTMajorRadius m) atTop atTop := by
  exact tendsto_rigidityPower_atTop (localCLTMajorExponent_pos m)

lemma eventually_localCLTMajorRadius_fits (m : ℕ) :
    ∀ᶠ n : ℕ in atTop,
      (4 * m : ℝ) * localCLTMajorRadius m n ≤
        Real.sqrt (2 * n + 1 : ℝ) := by
  have hpower := eventually_const_mul_rigidityPower_le
    (4 * m : ℝ) (localCLTMajorExponent m) (1 / 2)
    (localCLTMajorExponent_lt_half m)
  filter_upwards [hpower] with n hn
  have hsqrtN : rigidityPower n (1 / 2) = Real.sqrt (n : ℝ) := by
    unfold rigidityPower
    rw [Real.sqrt_eq_rpow]
  have hsqrtLe : Real.sqrt (n : ℝ) ≤ Real.sqrt (2 * n + 1 : ℝ) := by
    apply Real.sqrt_le_sqrt
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    push_cast
    linarith
  have htrans : (4 * m : ℝ) * rigidityPower n
      (localCLTMajorExponent m) ≤ Real.sqrt (2 * n + 1 : ℝ) :=
    hn.trans (by rw [hsqrtN]; exact hsqrtLe)
  simpa [localCLTMajorRadius] using htrans

/-- Integral bound on the Gaussian-decay annulus between the major arc and
the start of the rigidity window. -/
lemma noWrapAnnulus_setIntegral_le_gaussianTails
    (n m : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (σ R Q : ℝ) (hQ : Q ≤ phaseNoWrapRadius n m) :
    (∫ u : PhaseEuclidean m in {u | R ≤ ‖u‖ ∧ ‖u‖ ≤ Q},
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      (∫ u : PhaseEuclidean m in {u | R ≤ ‖u‖},
        Real.exp (-(1 / (12 * Real.pi ^ 2)) * ‖u‖ ^ 2)) +
      (∫ u : PhaseEuclidean m in {u | R ≤ ‖u‖},
        Real.exp (-(1 / 24) * ‖u‖ ^ 2)) := by
  let S : Set (PhaseEuclidean m) := {u | R ≤ ‖u‖ ∧ ‖u‖ ≤ Q}
  let T : Set (PhaseEuclidean m) := {u | R ≤ ‖u‖}
  let g₁ : PhaseEuclidean m → ℝ := fun u ↦
    Real.exp (-(1 / (12 * Real.pi ^ 2)) * ‖u‖ ^ 2)
  let g₂ : PhaseEuclidean m → ℝ := fun u ↦
    Real.exp (-(1 / 24) * ‖u‖ ^ 2)
  have hc₁ : (0 : ℝ) < 1 / (12 * Real.pi ^ 2) := by positivity
  have hc₂ : (0 : ℝ) < 1 / 24 := by norm_num
  have hg₁ : Integrable g₁ := by
    simpa [g₁] using integrable_rexp_neg_mul_norm_sq m _ hc₁
  have hg₂ : Integrable g₂ := by
    simpa [g₂] using integrable_rexp_neg_mul_norm_sq m _ hc₂
  have hSsub : S ⊆ T := by
    intro u hu
    exact hu.1
  have hmono₁ : (∫ u in S, g₁ u) ≤ ∫ u in T, g₁ u := by
    apply setIntegral_mono_set hg₁.integrableOn
    · exact Eventually.of_forall fun u ↦ Real.exp_nonneg _
    · exact Eventually.of_forall fun u hu ↦ hSsub hu
  have hmono₂ : (∫ u in S, g₂ u) ≤ ∫ u in T, g₂ u := by
    apply setIntegral_mono_set hg₂.integrableOn
    · exact Eventually.of_forall fun u ↦ Real.exp_nonneg _
    · exact Eventually.of_forall fun u hu ↦ hSsub hu
  change (∫ u : PhaseEuclidean m in S,
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      (∫ u in T, g₁ u) + ∫ u in T, g₂ u
  calc
    _ ≤ ∫ u : PhaseEuclidean m in S, g₁ u + g₂ u := by
      apply setIntegral_mono_of_nonneg
      · intro u _hu
        positivity
      · intro u hu
        have hpoint := norm_phaseCharFun_sub_covarianceGaussian_noWrap
          n points hcov u (hu.2.trans hQ)
        have hpoint' :
            ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
                normalizedPhaseCovarianceGaussian n points u‖ ≤
              g₁ u + g₂ u := by
          simpa [g₁, g₂, div_eq_mul_inv, mul_comm, mul_left_comm,
            mul_assoc] using hpoint
        have hweight : Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          exact mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr (by positivity)) (sq_nonneg ‖u‖)
        exact (mul_le_mul hweight hpoint' (norm_nonneg _) (by positivity)).trans_eq
          (one_mul (g₁ u + g₂ u))
      · exact (hg₁.add hg₂).integrableOn
    _ = (∫ u in S, g₁ u) + ∫ u in S, g₂ u := by
      exact integral_add hg₁.integrableOn hg₂.integrableOn
    _ ≤ (∫ u in T, g₁ u) + ∫ u in T, g₂ u := add_le_add hmono₁ hmono₂

lemma localCLT_gaussianTails_tendsto_zero (m : ℕ) :
    Tendsto (fun n : ℕ ↦
      (∫ u : PhaseEuclidean m in {u | localCLTMajorRadius m n ≤ ‖u‖},
        Real.exp (-(1 / (12 * Real.pi ^ 2)) * ‖u‖ ^ 2)) +
      (∫ u : PhaseEuclidean m in {u | localCLTMajorRadius m n ≤ ‖u‖},
        Real.exp (-(1 / 24) * ‖u‖ ^ 2))) atTop (𝓝 0) := by
  have hc₁ : (0 : ℝ) < 1 / (12 * Real.pi ^ 2) := by positivity
  have hc₂ : (0 : ℝ) < 1 / 24 := by norm_num
  have h₁ := (gaussianTail_tendsto m _ hc₁).comp
    (localCLTMajorRadius_tendsto_atTop m)
  have h₂ := (gaussianTail_tendsto m _ hc₂).comp
    (localCLTMajorRadius_tendsto_atTop m)
  simpa using h₁.add h₂

noncomputable def localCLTHighStartTest (n : ℕ) : ℝ :=
  Real.sqrt (2 * n + 1 : ℝ) * rigidityPower n (-1 / 8)

noncomputable def localCLTHighRadiusTest (m n : ℕ) : ℝ :=
  Real.sqrt (2 * n + 1 : ℝ) *
    rigidityPower n (rigidityFourierExponent m)

noncomputable def localCLTSmoothingScaleTest (n : ℕ) : ℝ :=
  rigidityPower n (-2)

lemma rigidityPower_three_eighths_le_highStart_test (n : ℕ) (hn : 0 < n) :
    rigidityPower n (3 / 8) ≤ localCLTHighStartTest n := by
  have hsqrt : Real.sqrt (n : ℝ) ≤ Real.sqrt (2 * n + 1 : ℝ) := by
    apply Real.sqrt_le_sqrt
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    push_cast
    linarith
  have heq : rigidityPower n (3 / 8) =
      Real.sqrt (n : ℝ) * rigidityPower n (-1 / 8) := by
    calc
      rigidityPower n (3 / 8) = rigidityPower n (1 / 2 + (-1 / 8)) := by
        congr 1
        ring
      _ = rigidityPower n (1 / 2) * rigidityPower n (-1 / 8) :=
        rigidityPower_add hn _ _
      _ = Real.sqrt (n : ℝ) * rigidityPower n (-1 / 8) := by
        unfold rigidityPower
        rw [Real.sqrt_eq_rpow]
  rw [heq]
  exact mul_le_mul_of_nonneg_right hsqrt (rigidityPower_nonneg n _)

lemma eventually_localCLTMajorRadius_le_highStart_test (m : ℕ) :
    ∀ᶠ n : ℕ in atTop,
      localCLTMajorRadius m n ≤ localCLTHighStartTest n := by
  have hη : localCLTMajorExponent m < 3 / 8 := by
    unfold localCLTMajorExponent
    have hm : (1 : ℝ) ≤ (m + 1 : ℕ) := by
      exact_mod_cast Nat.succ_le_succ (Nat.zero_le m)
    rw [div_lt_div_iff₀ (by positivity : (0 : ℝ) < 16 * (m + 1 : ℕ))
      (by norm_num : (0 : ℝ) < 8)]
    push_cast
    linarith
  have hp := eventually_const_mul_rigidityPower_le
    1 (localCLTMajorExponent m) (3 / 8) hη
  filter_upwards [hp, Nat.eventually_pos] with n hpow hn
  have hmajor : localCLTMajorRadius m n ≤ rigidityPower n (3 / 8) := by
    simpa [localCLTMajorRadius] using hpow
  exact hmajor.trans (rigidityPower_three_eighths_le_highStart_test n hn)

lemma localCLTHighStart_tendsto_atTop_test :
    Tendsto localCLTHighStartTest atTop atTop := by
  rw [tendsto_atTop]
  intro A
  filter_upwards [Nat.eventually_pos,
    (tendsto_rigidityPower_atTop (by norm_num : (0 : ℝ) < 3 / 8)).eventually
      (eventually_ge_atTop A)] with n hn hlarge
  exact hlarge.trans (rigidityPower_three_eighths_le_highStart_test n hn)

lemma eventually_localCLTHighStart_le_noWrap_test (m : ℕ) :
    ∀ᶠ n : ℕ in atTop,
      localCLTHighStartTest n ≤ phaseNoWrapRadius n m := by
  have hc : (0 : ℝ) < Real.pi / (16 * (m + 1 : ℕ)) := by positivity
  have hsmall := (tendsto_rigidityPower_neg_zero
    (by norm_num : (0 : ℝ) < 1 / 8)).eventually (Iio_mem_nhds hc)
  filter_upwards [hsmall] with n hn
  have hsqrt : 0 ≤ Real.sqrt (2 * n + 1 : ℝ) := Real.sqrt_nonneg _
  have hn' : rigidityPower n (-1 / 8) ≤
      Real.pi / (16 * (m + 1 : ℕ)) := by
    simpa [neg_div] using hn.le
  unfold localCLTHighStartTest phaseNoWrapRadius
  calc
    Real.sqrt (2 * n + 1 : ℝ) * rigidityPower n (-1 / 8) ≤
        Real.sqrt (2 * n + 1 : ℝ) *
          (Real.pi / (16 * (m + 1 : ℕ))) :=
      mul_le_mul_of_nonneg_left hn' hsqrt
    _ = Real.pi * Real.sqrt (2 * n + 1 : ℝ) /
          (16 * (m + 1 : ℕ)) := by ring

lemma volume_real_phase_closedBall_test
    (m : ℕ) (hm : 0 < m) (R : ℝ) (hR : 0 ≤ R) :
    volume.real (Metric.closedBall (0 : PhaseEuclidean m) R) =
      R ^ (4 * m) * (Real.pi ^ (2 * m) / (2 * m).factorial) := by
  let r : Fin m := ⟨0, hm⟩
  let c : Fin 4 := ⟨0, by norm_num⟩
  let i : Fin m × Fin 4 := (r, c)
  let x : PhaseEuclidean m := WithLp.toLp 2 (Function.update 0 i 1)
  have hx : x ≠ 0 := by
    intro h
    have := congrArg (fun z : PhaseEuclidean m ↦ z i) h
    simpa [x, i] using this
  letI : Nontrivial (PhaseEuclidean m) := ⟨⟨x, 0, hx⟩⟩
  have hdim : Module.finrank ℝ (PhaseEuclidean m) = 2 * (2 * m) := by
    rw [finrank_phaseEuclidean]
    omega
  rw [measureReal_def]
  rw [InnerProductSpace.volume_closedBall_of_dim_even hdim]
  rw [ENNReal.toReal_mul]
  rw [ENNReal.toReal_pow, ENNReal.toReal_ofReal hR,
    ENNReal.toReal_ofReal (by positivity)]
  rw [finrank_phaseEuclidean]

lemma highAnnulus_setIntegral_le_test
    (n m : ℕ) (hm : 0 < m) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (σ A B E : ℝ) (hA : 0 < A) (hB : 0 ≤ B)
    (hchar : ∀ u : PhaseEuclidean m,
      0 < ‖u‖ → A ≤ ‖u‖ → ‖u‖ ≤ B →
      ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖ ≤ Real.exp (-E)) :
    (∫ u : PhaseEuclidean m in {u | A ≤ ‖u‖ ∧ ‖u‖ ≤ B},
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      Real.exp (-E) *
        (B ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) +
      (∫ u : PhaseEuclidean m in {u | A ≤ ‖u‖},
        Real.exp (-(1 / 24) * ‖u‖ ^ 2)) := by
  let S : Set (PhaseEuclidean m) := {u | A ≤ ‖u‖ ∧ ‖u‖ ≤ B}
  let T : Set (PhaseEuclidean m) := {u | A ≤ ‖u‖}
  let C : Set (PhaseEuclidean m) := Metric.closedBall 0 B
  let a : ℝ := Real.exp (-E)
  let g : PhaseEuclidean m → ℝ := fun u ↦ Real.exp (-(1 / 24) * ‖u‖ ^ 2)
  have hg : Integrable g := by
    simpa [g] using integrable_rexp_neg_mul_norm_sq m (1 / 24) (by norm_num)
  have hSC : S ⊆ C := by
    intro u hu
    simpa [C, mem_closedBall_zero_iff] using hu.2
  have hST : S ⊆ T := by intro u hu; exact hu.1
  have haint : IntegrableOn (fun _u : PhaseEuclidean m ↦ a) C :=
    integrableOn_const measure_closedBall_lt_top.ne
  have haintS : IntegrableOn (fun _u : PhaseEuclidean m ↦ a) S :=
    haint.mono_set hSC
  have hgS : IntegrableOn g S := hg.integrableOn
  have hmonoA : (∫ _u : PhaseEuclidean m in S, a) ≤ ∫ _u in C, a := by
    apply setIntegral_mono_set haint
    · exact Eventually.of_forall fun _u ↦ Real.exp_nonneg _
    · exact Eventually.of_forall fun u hu ↦ hSC hu
  have hmonoG : (∫ u : PhaseEuclidean m in S, g u) ≤ ∫ u in T, g u := by
    apply setIntegral_mono_set hg.integrableOn
    · exact Eventually.of_forall fun u ↦ Real.exp_nonneg _
    · exact Eventually.of_forall fun u hu ↦ hST hu
  change (∫ u : PhaseEuclidean m in S,
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      a * (B ^ (4 * m) *
        (Real.pi ^ (2 * m) / (2 * m).factorial)) +
      ∫ u in T, g u
  calc
    _ ≤ ∫ u : PhaseEuclidean m in S, a + g u := by
      apply setIntegral_mono_of_nonneg
      · intro u _hu
        positivity
      · intro u hu
        have hu0 : 0 < ‖u‖ := hA.trans_le hu.1
        have hpoint := (norm_sub_le
          (normalizedPhaseCharFun n points (euclideanToPhase u))
          (normalizedPhaseCovarianceGaussian n points u)).trans
            (add_le_add (hchar u hu0 hu.1 hu.2)
              (norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
                n points hcov u))
        have hpoint' :
            ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
                normalizedPhaseCovarianceGaussian n points u‖ ≤ a + g u := by
          simpa [a, g, div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hpoint
        have hweight : Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          exact mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr (by positivity)) (sq_nonneg ‖u‖)
        exact (mul_le_mul hweight hpoint' (norm_nonneg _) (by positivity)).trans_eq
          (one_mul (a + g u))
      · exact haintS.add hgS
    _ = (∫ _u : PhaseEuclidean m in S, a) + ∫ u in S, g u := by
      exact integral_add haintS hgS
    _ ≤ (∫ _u : PhaseEuclidean m in C, a) + ∫ u in T, g u :=
      add_le_add hmonoA hmonoG
    _ = a * (B ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) +
        ∫ u in T, g u := by
      rw [setIntegral_const]
      rw [volume_real_phase_closedBall_test m hm B hB]
      simp
      ring

noncomputable def localCLTHighAnnulusBoundTest (m n : ℕ) : ℝ :=
  Real.exp (-rigidityEnergyScale n) *
      (localCLTHighRadiusTest m n ^ (4 * m) *
        (Real.pi ^ (2 * m) / (2 * m).factorial)) +
    (∫ u : PhaseEuclidean m in {u | localCLTHighStartTest n ≤ ‖u‖},
      Real.exp (-(1 / 24) * ‖u‖ ^ 2))

theorem eventually_highAnnulus_setIntegral_le_test
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (σ : ℝ),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      (∫ u : PhaseEuclidean m in
          {u | localCLTHighStartTest n ≤ ‖u‖ ∧
            ‖u‖ ≤ localCLTHighRadiusTest m n},
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) ≤
        localCLTHighAnnulusBoundTest m n := by
  filter_upwards [Nat.eventually_pos,
      eventually_norm_normalizedPhaseCharFun_high_frequency_euclidean hm,
      eventually_hasPhaseCovarianceLower_rigidity m]
    with n hn hhigh hcov
  intro points σ hsmooth hspread
  have hA : 0 < localCLTHighStartTest n := by
    unfold localCLTHighStartTest
    exact mul_pos (Real.sqrt_pos.2 (by positivity)) (rigidityPower_pos hn _)
  have hB : 0 ≤ localCLTHighRadiusTest m n := by
    unfold localCLTHighRadiusTest
    exact mul_nonneg (Real.sqrt_nonneg _) (rigidityPower_nonneg n _)
  apply highAnnulus_setIntegral_le_test n m hm points
    (hcov points hsmooth hspread) σ (localCLTHighStartTest n)
      (localCLTHighRadiusTest m n) (rigidityEnergyScale n) hA hB
  intro u hu hlower hupper
  exact hhigh points u hu hsmooth hspread
    (by simpa [localCLTHighStartTest] using hlower)
    (by simpa [localCLTHighRadiusTest] using hupper)

lemma localCLTHighRadius_le_polynomial_test
    (m n : ℕ) (hn : 0 < n) :
    localCLTHighRadiusTest m n ≤
      2 * rigidityPower n (rigidityFourierExponent m + 1) := by
  have hnreal : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ≤ 2 * (n : ℝ) := by
    rw [Real.sqrt_le_iff]
    constructor
    · positivity
    · have hsqrtSq : (Real.sqrt (2 * n + 1 : ℝ)) ^ 2 =
          (2 * n + 1 : ℝ) := Real.sq_sqrt (by positivity)
      nlinarith
  have hpow0 := rigidityPower_nonneg n (rigidityFourierExponent m)
  unfold localCLTHighRadiusTest
  calc
    Real.sqrt (2 * n + 1 : ℝ) *
          rigidityPower n (rigidityFourierExponent m) ≤
        (2 * (n : ℝ)) * rigidityPower n (rigidityFourierExponent m) :=
      mul_le_mul_of_nonneg_right hsqrt hpow0
    _ = 2 * rigidityPower n (rigidityFourierExponent m + 1) := by
      rw [rigidityPower_add hn]
      simp [rigidityPower]
      ring

lemma tendsto_rigidityPower_mul_exp_neg_energy_test (p : ℝ) :
    Tendsto (fun n : ℕ ↦
      rigidityPower n p * Real.exp (-rigidityEnergyScale n)) atTop (𝓝 0) := by
  have hα : 0 < rigidityEnergyExponent := by
    norm_num [rigidityEnergyExponent]
  have hbase := (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero
    (p / rigidityEnergyExponent) 1 zero_lt_one).comp
      tendsto_rigidityEnergyScale_atTop
  apply hbase.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hpow : (rigidityEnergyScale n) ^ (p / rigidityEnergyExponent) =
      rigidityPower n p := by
    unfold rigidityEnergyScale
    rw [← rigidityPower_mul hn]
    congr 1
    field_simp [hα.ne']
  simp only [Function.comp_apply, one_mul]
  rw [hpow]
  congr 2
  ring

lemma localCLTHighAnnulusPolynomial_tendsto_zero_test (m : ℕ) :
    Tendsto (fun n : ℕ ↦
      Real.exp (-rigidityEnergyScale n) *
        ((2 * rigidityPower n (rigidityFourierExponent m + 1)) ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial))) atTop (𝓝 0) := by
  let p : ℝ := (rigidityFourierExponent m + 1) * (4 * m : ℕ)
  let C : ℝ := (2 : ℝ) ^ (4 * m) *
    (Real.pi ^ (2 * m) / (2 * m).factorial)
  have hcore : Tendsto (fun n : ℕ ↦
      C * (rigidityPower n p * Real.exp (-rigidityEnergyScale n)))
      atTop (𝓝 0) := by
    simpa using (tendsto_rigidityPower_mul_exp_neg_energy_test p).const_mul C
  apply hcore.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hpow : rigidityPower n (rigidityFourierExponent m + 1) ^ (4 * m) =
      rigidityPower n p := by
    simpa [p] using rigidityPower_nat_pow hn
      (rigidityFourierExponent m + 1) (4 * m)
  rw [mul_pow, hpow]
  dsimp [C]
  ring

lemma localCLTHighAnnulusBound_tendsto_zero_test (m : ℕ) :
    Tendsto (localCLTHighAnnulusBoundTest m) atTop (𝓝 0) := by
  have htail := (gaussianTail_tendsto m (1 / 24) (by norm_num)).comp
    localCLTHighStart_tendsto_atTop_test
  have hpoly := localCLTHighAnnulusPolynomial_tendsto_zero_test m
  let upper : ℕ → ℝ := fun n ↦
    Real.exp (-rigidityEnergyScale n) *
        ((2 * rigidityPower n (rigidityFourierExponent m + 1)) ^ (4 * m) *
          (Real.pi ^ (2 * m) / (2 * m).factorial)) +
      (∫ u : PhaseEuclidean m in {u | localCLTHighStartTest n ≤ ‖u‖},
        Real.exp (-(1 / 24) * ‖u‖ ^ 2))
  have hupperT : Tendsto upper atTop (𝓝 0) := by
    simpa only [upper, Function.comp_apply, add_zero] using hpoly.add htail
  refine squeeze_zero' (g := upper) ?_ ?_ hupperT
  · exact Eventually.of_forall fun n ↦ by
      unfold localCLTHighAnnulusBoundTest
      have hrad0 : 0 ≤ localCLTHighRadiusTest m n := by
        unfold localCLTHighRadiusTest
        exact mul_nonneg (Real.sqrt_nonneg _) (rigidityPower_nonneg n _)
      exact add_nonneg (mul_nonneg (Real.exp_nonneg _)
        (mul_nonneg (pow_nonneg hrad0 _) (by positivity)))
        (integral_nonneg_of_ae (Eventually.of_forall fun u ↦ Real.exp_nonneg _))
  · filter_upwards [Nat.eventually_pos] with n hn
    unfold localCLTHighAnnulusBoundTest upper
    have hrad0 : 0 ≤ localCLTHighRadiusTest m n := by
      unfold localCLTHighRadiusTest
      exact mul_nonneg (Real.sqrt_nonneg _) (rigidityPower_nonneg n _)
    have hpowle := pow_le_pow_left₀ hrad0
      (localCLTHighRadius_le_polynomial_test m n hn) (4 * m)
    have hG0 : 0 ≤ Real.pi ^ (2 * m) / (2 * m).factorial := by positivity
    have hinside :
        localCLTHighRadiusTest m n ^ (4 * m) *
            (Real.pi ^ (2 * m) / (2 * m).factorial) ≤
          (2 * rigidityPower n (rigidityFourierExponent m + 1)) ^ (4 * m) *
            (Real.pi ^ (2 * m) / (2 * m).factorial) :=
      mul_le_mul_of_nonneg_right hpowle hG0
    exact add_le_add
      (mul_le_mul_of_nonneg_left hinside (Real.exp_nonneg _)) le_rfl

lemma norm_normalizedPhaseCharFun_le_one_test
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    ‖normalizedPhaseCharFun n points u‖ ≤ 1 := by
  rw [normalizedPhaseCharFun_eq_projected]
  exact Erdos88.Fourier.norm_finCharFun_le_one _ _ _

lemma smoothingTail_setIntegral_le_test
    (n m : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (σ B : ℝ) (hσ : 0 < σ) (hB : 0 ≤ B) :
    (∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖},
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      2 * Real.exp (-(σ ^ 2 / 4) * B ^ 2) *
        (Real.pi / (σ ^ 2 / 4)) ^ (2 * m) := by
  let c : ℝ := σ ^ 2 / 4
  let C : ℝ := 2 * Real.exp (-c * B ^ 2)
  let g : PhaseEuclidean m → ℝ := fun u ↦ C * Real.exp (-c * ‖u‖ ^ 2)
  have hc : 0 < c := by dsimp [c]; positivity
  have hg : Integrable g :=
    (integrable_rexp_neg_mul_norm_sq m c hc).const_mul C
  calc
    (∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖},
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
        ∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖}, g u := by
      apply setIntegral_mono_of_nonneg
      · intro u _hu
        positivity
      · intro u hu
        have hchar := norm_normalizedPhaseCharFun_le_one_test
          n points (euclideanToPhase u)
        have hcov' := norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
          n points hcov u
        have hgaussOne : Real.exp (-(‖u‖ ^ 2 / 24)) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          exact neg_nonpos.mpr (by positivity)
        have herr :
            ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
                normalizedPhaseCovarianceGaussian n points u‖ ≤ 2 :=
          (norm_sub_le _ _).trans (by nlinarith)
        change B ≤ ‖u‖ at hu
        have hsquares : B ^ 2 ≤ ‖u‖ ^ 2 := by
          nlinarith [norm_nonneg u]
        have hexp : Real.exp (-c * ‖u‖ ^ 2) ≤
            Real.exp (-c * B ^ 2) := by
          apply Real.exp_le_exp.mpr
          have := mul_le_mul_of_nonneg_left hsquares hc.le
          nlinarith
        have hsplit : Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) =
            Real.exp (-c * ‖u‖ ^ 2) * Real.exp (-c * ‖u‖ ^ 2) := by
          rw [← Real.exp_add]
          congr 1
          dsimp [c]
          ring
        rw [hsplit]
        change (Real.exp (-c * ‖u‖ ^ 2) *
            Real.exp (-c * ‖u‖ ^ 2)) *
              ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
                normalizedPhaseCovarianceGaussian n points u‖ ≤ g u
        unfold g C
        calc
          _ ≤ (Real.exp (-c * B ^ 2) * Real.exp (-c * ‖u‖ ^ 2)) * 2 := by
            gcongr
          _ = 2 * Real.exp (-c * B ^ 2) * Real.exp (-c * ‖u‖ ^ 2) := by ring
      · exact hg.integrableOn
    _ ≤ ∫ u : PhaseEuclidean m, g u := by
      apply setIntegral_le_integral hg
      exact Eventually.of_forall fun u ↦ by unfold g C; positivity
    _ = C * (Real.pi / c) ^ (2 * m) := by
      unfold g
      rw [integral_const_mul]
      rw [GaussianFourier.integral_rexp_neg_mul_sq_norm hc]
      have he : ((Module.finrank ℝ (PhaseEuclidean m) : ℝ) / 2) =
          (2 * m : ℕ) := by
        rw [finrank_phaseEuclidean]
        push_cast
        ring
      rw [he, Real.rpow_natCast]
    _ = 2 * Real.exp (-(σ ^ 2 / 4) * B ^ 2) *
        (Real.pi / (σ ^ 2 / 4)) ^ (2 * m) := by rfl

noncomputable def localCLTSmoothingTailBoundTest (m n : ℕ) : ℝ :=
  2 * Real.exp (-(localCLTSmoothingScaleTest n ^ 2 / 4) *
      localCLTHighRadiusTest m n ^ 2) *
    (Real.pi / (localCLTSmoothingScaleTest n ^ 2 / 4)) ^ (2 * m)

theorem eventually_smoothingTail_setIntegral_le_test (m : ℕ) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      (∫ u : PhaseEuclidean m in {u | localCLTHighRadiusTest m n ≤ ‖u‖},
        Real.exp (-(localCLTSmoothingScaleTest n ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) ≤
        localCLTSmoothingTailBoundTest m n := by
  filter_upwards [Nat.eventually_pos,
      eventually_hasPhaseCovarianceLower_rigidity m]
    with n hn hcov
  intro points hsmooth hspread
  apply smoothingTail_setIntegral_le_test n m points
    (hcov points hsmooth hspread)
  · unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  · unfold localCLTHighRadiusTest
    exact mul_nonneg (Real.sqrt_nonneg _) (rigidityPower_nonneg n _)

lemma localCLTSmoothingScale_sq_test (n : ℕ) (hn : 0 < n) :
    localCLTSmoothingScaleTest n ^ 2 = rigidityPower n (-4) := by
  unfold localCLTSmoothingScaleTest
  convert rigidityPower_nat_pow hn (-2) 2 using 1 <;> ring

lemma localCLTHighRadius_sq_test (m n : ℕ) (hn : 0 < n) :
    localCLTHighRadiusTest m n ^ 2 =
      (2 * n + 1 : ℝ) *
        rigidityPower n (2 * rigidityFourierExponent m) := by
  unfold localCLTHighRadiusTest
  rw [mul_pow]
  rw [Real.sq_sqrt (by positivity)]
  rw [rigidityPower_nat_pow hn]
  congr 2
  ring

lemma localCLTSmoothingExponent_lower_test (m n : ℕ) (hn : 0 < n) :
    (1 / 4 : ℝ) * rigidityPower n (2 * rigidityFourierExponent m - 3) ≤
      (localCLTSmoothingScaleTest n ^ 2 / 4) *
        localCLTHighRadiusTest m n ^ 2 := by
  rw [localCLTSmoothingScale_sq_test n hn,
    localCLTHighRadius_sq_test m n hn]
  have hnle : (n : ℝ) ≤ 2 * n + 1 := by
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    push_cast
    linarith
  have hcoef : 0 ≤ rigidityPower n (-4) / 4 :=
    div_nonneg (rigidityPower_nonneg _ _) (by norm_num)
  have hpow0 : 0 ≤ rigidityPower n (2 * rigidityFourierExponent m) :=
    rigidityPower_nonneg _ _
  have hmono :
      (rigidityPower n (-4) / 4) *
          ((n : ℝ) * rigidityPower n (2 * rigidityFourierExponent m)) ≤
        (rigidityPower n (-4) / 4) *
          ((2 * n + 1 : ℝ) *
            rigidityPower n (2 * rigidityFourierExponent m)) := by
    gcongr
  calc
    (1 / 4 : ℝ) * rigidityPower n (2 * rigidityFourierExponent m - 3) =
        (rigidityPower n (-4) / 4) *
          ((n : ℝ) * rigidityPower n (2 * rigidityFourierExponent m)) := by
      rw [show (n : ℝ) = rigidityPower n 1 by simp [rigidityPower]]
      rw [← rigidityPower_add hn 1 (2 * rigidityFourierExponent m)]
      rw [show rigidityPower n (-4) / 4 *
          rigidityPower n (1 + 2 * rigidityFourierExponent m) =
          (1 / 4) * (rigidityPower n (-4) *
            rigidityPower n (1 + 2 * rigidityFourierExponent m)) by ring]
      rw [← rigidityPower_add hn (-4) (1 + 2 * rigidityFourierExponent m)]
      congr 2
      ring
    _ ≤ _ := hmono

lemma localCLTSmoothingDenominator_identity_test (n : ℕ) (hn : 0 < n) :
    Real.pi / (localCLTSmoothingScaleTest n ^ 2 / 4) =
      4 * Real.pi * rigidityPower n 4 := by
  rw [localCLTSmoothingScale_sq_test n hn]
  unfold rigidityPower
  rw [Real.rpow_neg (by exact_mod_cast hn.le)]
  have hnreal : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  field_simp

lemma tendsto_rigidityPower_mul_exp_neg_power_test
    (p q c : ℝ) (hq : 0 < q) (hc : 0 < c) :
    Tendsto (fun n : ℕ ↦
      rigidityPower n p * Real.exp (-c * rigidityPower n q)) atTop (𝓝 0) := by
  have hbase := (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero
    (p / q) c hc).comp (tendsto_rigidityPower_atTop hq)
  apply hbase.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hpow : (rigidityPower n q) ^ (p / q) = rigidityPower n p := by
    rw [← rigidityPower_mul hn]
    congr 1
    field_simp [hq.ne']
  simp only [Function.comp_apply]
  rw [hpow]

lemma localCLTSmoothingExponent_pos_test (m : ℕ) :
    0 < 2 * rigidityFourierExponent m - 3 := by
  unfold rigidityFourierExponent
  have hm : (1 : ℝ) ≤ (m + 1 : ℕ) := by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le m)
  push_cast
  linarith

noncomputable def localCLTSmoothingTailPolynomialBoundTest (m n : ℕ) : ℝ :=
  (2 * (4 * Real.pi) ^ (2 * m)) *
    (rigidityPower n (8 * m) *
      Real.exp (-(1 / 4) *
        rigidityPower n (2 * rigidityFourierExponent m - 3)))

lemma localCLTSmoothingTailBound_le_polynomial_test
    (m n : ℕ) (hn : 0 < n) :
    localCLTSmoothingTailBoundTest m n ≤
      localCLTSmoothingTailPolynomialBoundTest m n := by
  let q : ℝ := 2 * rigidityFourierExponent m - 3
  let A : ℝ := (localCLTSmoothingScaleTest n ^ 2 / 4) *
    localCLTHighRadiusTest m n ^ 2
  let P : ℝ := (1 / 4) * rigidityPower n q
  have hPA : P ≤ A := by
    simpa [P, A, q] using localCLTSmoothingExponent_lower_test m n hn
  have hexp : Real.exp (-A) ≤ Real.exp (-P) := by
    exact Real.exp_le_exp.mpr (neg_le_neg hPA)
  have hden := localCLTSmoothingDenominator_identity_test n hn
  have hpow :
      (Real.pi / (localCLTSmoothingScaleTest n ^ 2 / 4)) ^ (2 * m) =
        (4 * Real.pi) ^ (2 * m) * rigidityPower n (8 * m) := by
    rw [hden, mul_pow]
    rw [rigidityPower_nat_pow hn]
    congr 2
    push_cast
    ring
  unfold localCLTSmoothingTailBoundTest
  rw [hpow]
  unfold localCLTSmoothingTailPolynomialBoundTest
  rw [show -(localCLTSmoothingScaleTest n ^ 2 / 4) *
      localCLTHighRadiusTest m n ^ 2 = -A by
    dsimp [A]
    ring]
  rw [show -(1 / 4) *
      rigidityPower n (2 * rigidityFourierExponent m - 3) = -P by
    dsimp [P, q]
    ring]
  change 2 * Real.exp (-A) *
      ((4 * Real.pi) ^ (2 * m) * rigidityPower n (8 * m)) ≤
    (2 * (4 * Real.pi) ^ (2 * m)) *
      (rigidityPower n (8 * m) * Real.exp (-P))
  have hconst : 0 ≤ 2 * (4 * Real.pi) ^ (2 * m) *
      rigidityPower n (8 * m) :=
    mul_nonneg (mul_nonneg (by norm_num) (pow_nonneg (by positivity) _))
      (rigidityPower_nonneg _ _)
  calc
    _ = (2 * (4 * Real.pi) ^ (2 * m) *
        rigidityPower n (8 * m)) * Real.exp (-A) := by ring
    _ ≤ (2 * (4 * Real.pi) ^ (2 * m) *
        rigidityPower n (8 * m)) * Real.exp (-P) :=
      mul_le_mul_of_nonneg_left hexp hconst
    _ = _ := by ring

lemma localCLTSmoothingTailPolynomialBound_tendsto_zero_test (m : ℕ) :
    Tendsto (localCLTSmoothingTailPolynomialBoundTest m) atTop (𝓝 0) := by
  let q : ℝ := 2 * rigidityFourierExponent m - 3
  let C : ℝ := 2 * (4 * Real.pi) ^ (2 * m)
  have hcore := tendsto_rigidityPower_mul_exp_neg_power_test
    (8 * m : ℕ) q (1 / 4) (by
      simpa [q] using localCLTSmoothingExponent_pos_test m) (by norm_num)
  have hmul : Tendsto (fun n : ℕ ↦ C *
      (rigidityPower n (8 * m) *
        Real.exp (-(1 / 4) * rigidityPower n q))) atTop (𝓝 0) := by
    simpa using hcore.const_mul C
  change Tendsto (fun n : ℕ ↦
    (2 * (4 * Real.pi) ^ (2 * m)) *
      (rigidityPower n (8 * m) *
        Real.exp (-(1 / 4) *
          rigidityPower n (2 * rigidityFourierExponent m - 3)))) atTop (𝓝 0)
  simpa [C, q] using hmul

lemma localCLTSmoothingTailBound_tendsto_zero_test (m : ℕ) :
    Tendsto (localCLTSmoothingTailBoundTest m) atTop (𝓝 0) := by
  apply squeeze_zero'
  · exact Eventually.of_forall fun n ↦ by
      unfold localCLTSmoothingTailBoundTest
      positivity
  · filter_upwards [Nat.eventually_pos] with n hn
    exact localCLTSmoothingTailBound_le_polynomial_test m n hn
  · exact localCLTSmoothingTailPolynomialBound_tendsto_zero_test m

lemma integrable_phaseFourierError_test
    (n : ℕ) (points : Fin m → ℝ) (σ : ℝ) (hσ : 0 < σ) :
    Integrable (fun u : PhaseEuclidean m ↦
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) := by
  have h := ((integrable_phaseFourier_normalizedPhaseCharFun
      n points σ hσ (0 : PhaseEuclidean m)).sub
    (integrable_phaseFourier_covarianceGaussian
      n points σ hσ (0 : PhaseEuclidean m))).norm
  apply h.congr
  filter_upwards [] with u
  change ‖phaseFourierMultiplier σ 0 u *
        normalizedPhaseCharFun n points (euclideanToPhase u) -
      phaseFourierMultiplier σ 0 u *
        normalizedPhaseCovarianceGaussian n points u‖ = _
  rw [← mul_sub, norm_mul, norm_phaseFourierMultiplier]

lemma setIntegral_union_le_of_nonneg_test
    {α : Type*} [MeasureSpace α] {f : α → ℝ}
    (hf : Integrable f) (hnonneg : ∀ x, 0 ≤ f x)
    {s t : Set α} (hs : MeasurableSet s) (ht : MeasurableSet t) :
    (∫ x in s ∪ t, f x) ≤ (∫ x in s, f x) + ∫ x in t, f x := by
  rw [← integral_indicator (hs.union ht)]
  rw [← integral_indicator hs, ← integral_indicator ht]
  rw [← integral_add (hf.indicator hs) (hf.indicator ht)]
  apply integral_mono
  · exact hf.indicator (hs.union ht)
  · exact (hf.indicator hs).add (hf.indicator ht)
  · intro x
    by_cases hxs : x ∈ s <;> by_cases hxt : x ∈ t <;>
      simp [Set.indicator, hxs, hxt, hnonneg x]

lemma phaseFourierError_setIntegral_le_four_regions_test
    (n m : ℕ) (points : Fin m → ℝ) (σ R A B : ℝ) (hσ : 0 < σ) :
    (∫ u : PhaseEuclidean m,
      Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      (∫ u : PhaseEuclidean m in Metric.ball 0 R,
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) +
      (∫ u : PhaseEuclidean m in {u | R ≤ ‖u‖ ∧ ‖u‖ ≤ A},
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) +
      (∫ u : PhaseEuclidean m in {u | A ≤ ‖u‖ ∧ ‖u‖ ≤ B},
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) +
      (∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖},
        Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) := by
  let f : PhaseEuclidean m → ℝ := fun u ↦
    Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
      ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
        normalizedPhaseCovarianceGaussian n points u‖
  let S₀ : Set (PhaseEuclidean m) := Metric.ball 0 R
  let S₁ : Set (PhaseEuclidean m) := {u | R ≤ ‖u‖ ∧ ‖u‖ ≤ A}
  let S₂ : Set (PhaseEuclidean m) := {u | A ≤ ‖u‖ ∧ ‖u‖ ≤ B}
  let S₃ : Set (PhaseEuclidean m) := {u | B ≤ ‖u‖}
  have hf : Integrable f := by
    simpa [f] using integrable_phaseFourierError_test n points σ hσ
  have hnonneg : ∀ u, 0 ≤ f u := fun u ↦ by unfold f; positivity
  have hS₀ : MeasurableSet S₀ := measurableSet_ball
  have hS₁ : MeasurableSet S₁ :=
    (measurableSet_le measurable_const continuous_norm.measurable).inter
      (measurableSet_le continuous_norm.measurable measurable_const)
  have hS₂ : MeasurableSet S₂ :=
    (measurableSet_le measurable_const continuous_norm.measurable).inter
      (measurableSet_le continuous_norm.measurable measurable_const)
  have hS₃ : MeasurableSet S₃ :=
    measurableSet_le measurable_const continuous_norm.measurable
  have hcover : S₀ ∪ S₁ ∪ S₂ ∪ S₃ = Set.univ := by
    ext u
    constructor
    · intro _hu
      trivial
    · intro _hu
      by_cases hR : ‖u‖ < R
      · have hu0 : u ∈ S₀ := by simpa [S₀, mem_ball_zero_iff] using hR
        exact Set.mem_union_left _ (Set.mem_union_left _ (Set.mem_union_left _ hu0))
      · have hRle : R ≤ ‖u‖ := le_of_not_gt hR
        by_cases hA : ‖u‖ ≤ A
        · have hu1 : u ∈ S₁ := ⟨hRle, hA⟩
          exact Set.mem_union_left _ (Set.mem_union_left _ (Set.mem_union_right _ hu1))
        · have hAle : A ≤ ‖u‖ := (lt_of_not_ge hA).le
          by_cases hB : ‖u‖ ≤ B
          · have hu2 : u ∈ S₂ := ⟨hAle, hB⟩
            exact Set.mem_union_left _ (Set.mem_union_right _ hu2)
          · have hu3 : u ∈ S₃ := (lt_of_not_ge hB).le
            exact Set.mem_union_right _ hu3
  have h01 := setIntegral_union_le_of_nonneg_test hf hnonneg hS₀ hS₁
  have h012 := setIntegral_union_le_of_nonneg_test hf hnonneg
    (hS₀.union hS₁) hS₂
  have h0123 := setIntegral_union_le_of_nonneg_test hf hnonneg
    ((hS₀.union hS₁).union hS₂) hS₃
  change (∫ u : PhaseEuclidean m, f u) ≤
      (∫ u in S₀, f u) + (∫ u in S₁, f u) +
        (∫ u in S₂, f u) + ∫ u in S₃, f u
  rw [← setIntegral_univ, ← hcover]
  calc
    (∫ u in S₀ ∪ S₁ ∪ S₂ ∪ S₃, f u) ≤
        (∫ u in S₀ ∪ S₁ ∪ S₂, f u) + ∫ u in S₃, f u := h0123
    _ ≤ ((∫ u in S₀ ∪ S₁, f u) + ∫ u in S₂, f u) +
          ∫ u in S₃, f u := add_le_add h012 le_rfl
    _ ≤ (((∫ u in S₀, f u) + (∫ u in S₁, f u)) +
          (∫ u in S₂, f u)) + (∫ u in S₃, f u) := by
      exact add_le_add (add_le_add h01 le_rfl) le_rfl

noncomputable def localCLTNoWrapBoundTest (m n : ℕ) : ℝ :=
  (∫ u : PhaseEuclidean m in {u | localCLTMajorRadius m n ≤ ‖u‖},
      Real.exp (-(1 / (12 * Real.pi ^ 2)) * ‖u‖ ^ 2)) +
    (∫ u : PhaseEuclidean m in {u | localCLTMajorRadius m n ≤ ‖u‖},
      Real.exp (-(1 / 24) * ‖u‖ ^ 2))

noncomputable def localCLTFourierErrorBoundTest (m n : ℕ) : ℝ :=
  localCLTMajorBound m n + localCLTNoWrapBoundTest m n +
    localCLTHighAnnulusBoundTest m n + localCLTSmoothingTailBoundTest m n

theorem eventually_phaseFourierErrorIntegral_le_test
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      (∫ u : PhaseEuclidean m,
        Real.exp (-(localCLTSmoothingScaleTest n ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) ≤
        localCLTFourierErrorBoundTest m n := by
  filter_upwards [Nat.eventually_pos,
      eventually_localCLTMajorRadius_fits m,
      eventually_localCLTHighStart_le_noWrap_test m,
      eventually_hasPhaseCovarianceLower_rigidity m,
      eventually_highAnnulus_setIntegral_le_test hm,
      eventually_smoothingTail_setIntegral_le_test m]
    with n hn hmajorFits hstartWrap hcov hhigh htail
  intro points hsmooth hspread
  let σ : ℝ := localCLTSmoothingScaleTest n
  let R : ℝ := localCLTMajorRadius m n
  let A : ℝ := localCLTHighStartTest n
  let B : ℝ := localCLTHighRadiusTest m n
  let f : PhaseEuclidean m → ℝ := fun u ↦
    Real.exp (-(σ ^ 2 / 2) * ‖u‖ ^ 2) *
      ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
        normalizedPhaseCovarianceGaussian n points u‖
  have hσ : 0 < σ := by
    dsimp [σ, localCLTSmoothingScaleTest]
    exact rigidityPower_pos hn _
  have hfour := phaseFourierError_setIntegral_le_four_regions_test
    n m points σ R A B hσ
  have hmajor : (∫ u : PhaseEuclidean m in Metric.ball 0 R, f u) ≤
      localCLTMajorBound m n := by
    simpa [f, σ, R, localCLTMajorBound] using majorArc_setIntegral_le
      n m hm points σ R (rigidityPower_nonneg n _) hmajorFits
  have hnowrap :
      (∫ u : PhaseEuclidean m in {u | R ≤ ‖u‖ ∧ ‖u‖ ≤ A}, f u) ≤
        localCLTNoWrapBoundTest m n := by
    simpa [f, σ, R, A, localCLTNoWrapBoundTest] using
      noWrapAnnulus_setIntegral_le_gaussianTails n m points
        (hcov points hsmooth hspread) σ R A hstartWrap
  have hhigh' :
      (∫ u : PhaseEuclidean m in {u | A ≤ ‖u‖ ∧ ‖u‖ ≤ B}, f u) ≤
        localCLTHighAnnulusBoundTest m n := by
    simpa [f, σ, A, B] using hhigh points σ hsmooth hspread
  have htail' :
      (∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖}, f u) ≤
        localCLTSmoothingTailBoundTest m n := by
    simpa [f, σ, B] using htail points hsmooth hspread
  change (∫ u : PhaseEuclidean m, f u) ≤ localCLTFourierErrorBoundTest m n
  calc
    (∫ u : PhaseEuclidean m, f u) ≤
        (∫ u in Metric.ball 0 R, f u) +
        (∫ u in {u | R ≤ ‖u‖ ∧ ‖u‖ ≤ A}, f u) +
        (∫ u in {u | A ≤ ‖u‖ ∧ ‖u‖ ≤ B}, f u) +
        (∫ u in {u | B ≤ ‖u‖}, f u) := hfour
    _ ≤ localCLTMajorBound m n + localCLTNoWrapBoundTest m n +
          localCLTHighAnnulusBoundTest m n +
          localCLTSmoothingTailBoundTest m n :=
      add_le_add (add_le_add (add_le_add hmajor hnowrap) hhigh') htail'
    _ = localCLTFourierErrorBoundTest m n := rfl

lemma localCLTNoWrapBound_tendsto_zero_test (m : ℕ) :
    Tendsto (localCLTNoWrapBoundTest m) atTop (𝓝 0) := by
  change Tendsto (fun n : ℕ ↦
      (∫ u : PhaseEuclidean m in {u | localCLTMajorRadius m n ≤ ‖u‖},
        Real.exp (-(1 / (12 * Real.pi ^ 2)) * ‖u‖ ^ 2)) +
      (∫ u : PhaseEuclidean m in {u | localCLTMajorRadius m n ≤ ‖u‖},
        Real.exp (-(1 / 24) * ‖u‖ ^ 2))) atTop (𝓝 0)
  exact localCLT_gaussianTails_tendsto_zero m

lemma localCLTFourierErrorBound_tendsto_zero_test (m : ℕ) :
    Tendsto (localCLTFourierErrorBoundTest m) atTop (𝓝 0) := by
  change Tendsto (fun n : ℕ ↦
      localCLTMajorBound m n + localCLTNoWrapBoundTest m n +
        localCLTHighAnnulusBoundTest m n +
        localCLTSmoothingTailBoundTest m n) atTop (𝓝 0)
  simpa using (((localCLTMajorBound_tendsto_zero m).add
    (localCLTNoWrapBound_tendsto_zero_test m)).add
      (localCLTHighAnnulusBound_tendsto_zero_test m) |>.add
        (localCLTSmoothingTailBound_tendsto_zero_test m))

theorem eventually_smoothedLocalCLT_le_test
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (y : PhaseEuclidean m),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ‖((Real.pi : ℂ) /
            ((localCLTSmoothingScaleTest n ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points
            (localCLTSmoothingScaleTest n) y -
        phaseFourierIntegral (localCLTSmoothingScaleTest n) y
          (normalizedPhaseCovarianceGaussian n points)‖ ≤
        localCLTFourierErrorBoundTest m n := by
  filter_upwards [Nat.eventually_pos,
      eventually_phaseFourierErrorIntegral_le_test hm]
    with n hn herr
  intro points y hsmooth hspread
  have hσ : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  exact (norm_phaseGaussianSmoothedMass_sub_covarianceFourier
    n points (localCLTSmoothingScaleTest n) hσ y).trans
      (herr points hsmooth hspread)

theorem smoothedLocalCLT_uniform_test
    {m : ℕ} (hm : 0 < m) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (y : PhaseEuclidean m),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ‖((Real.pi : ℂ) /
            ((localCLTSmoothingScaleTest n ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points
            (localCLTSmoothingScaleTest n) y -
        phaseFourierIntegral (localCLTSmoothingScaleTest n) y
          (normalizedPhaseCovarianceGaussian n points)‖ < ε := by
  have hbound : ∀ᶠ n : ℕ in atTop, localCLTFourierErrorBoundTest m n < ε :=
    (localCLTFourierErrorBound_tendsto_zero_test m).eventually
      (Iio_mem_nhds hε)
  filter_upwards [eventually_smoothedLocalCLT_le_test hm, hbound]
    with n hlocal hsmall
  intro points y hsmooth hspread
  exact (hlocal points y hsmooth hspread).trans_lt hsmall

/-! ### A uniform small-ball consequence of the smoothed local CLT -/

lemma phaseFourierExponent_eq (m : ℕ) :
    ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) = (2 * m : ℕ) := by
  rw [finrank_phaseEuclidean]
  push_cast
  ring

lemma phaseFourierNormalization_norm
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2)‖ =
      (2 * Real.pi / sigma ^ 2) ^ (2 * m) := by
  rw [phaseFourierExponent_eq]
  rw [Complex.cpow_natCast]
  rw [norm_pow, norm_div, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs]
  rw [abs_of_pos Real.pi_pos, abs_of_pos (by positivity : 0 < sigma ^ 2 / 2)]
  congr 1
  field_simp [hsigma.ne']

lemma phaseFourierNormalization_eq_real
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    ((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
          ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) =
      (((2 * Real.pi / sigma ^ 2) ^ (2 * m) : ℝ) : ℂ) := by
  rw [phaseFourierExponent_eq, Complex.cpow_natCast]
  push_cast
  congr 1
  field_simp [hsigma.ne']

lemma phaseFourierNormalization_pos
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    0 < (2 * Real.pi / sigma ^ 2) ^ (2 * m) := by positivity

/-- The real Gaussian convolution of the normalized phase walk.  This is
the same quantity as `phaseGaussianSmoothedMass`, with its reality made
explicit so that it can be used in order estimates. -/
noncomputable def phaseGaussianSmoothedMassReal
    (n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) (y : PhaseEuclidean m) : ℝ :=
  uniformExpectation (fun e : SignVector (2 * n) ↦
    Real.exp (-(‖normalizedPhaseEuclideanWalk n e points - y‖ ^ 2 /
      (2 * sigma ^ 2))))

lemma phaseGaussianSmoothedMass_eq_real
    (n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) (y : PhaseEuclidean m) :
    phaseGaussianSmoothedMass n points sigma y =
      (phaseGaussianSmoothedMassReal n points sigma y : ℂ) := by
  unfold phaseGaussianSmoothedMass phaseGaussianSmoothedMassReal
    Erdos88.Fourier.finExpectation uniformExpectation
  push_cast
  congr 1

/-- A ball event contributes a fixed positive amount to the Gaussian
convolution at its centre. -/
lemma uniformProbability_phaseBall_mul_le_smoothedMassReal
    (n : ℕ) (points : Fin m → ℝ) (sigma delta : ℝ)
    (hsigma : 0 < sigma) (hdelta : 0 ≤ delta) (y : PhaseEuclidean m) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta) *
        Real.exp (-(delta ^ 2 / (2 * sigma ^ 2))) ≤
      phaseGaussianSmoothedMassReal n points sigma y := by
  rw [← uniformExpectation_indicator]
  change _ ≤ uniformExpectation (fun e : SignVector (2 * n) ↦
    Real.exp (-(‖normalizedPhaseEuclideanWalk n e points - y‖ ^ 2 /
      (2 * sigma ^ 2))))
  rw [mul_comm, ← uniformExpectation_const_mul]
  apply uniformExpectation_mono
  intro e
  by_cases he : ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta
  · rw [if_pos he, mul_one]
    apply Real.exp_le_exp.mpr
    have hsquare :
        ‖normalizedPhaseEuclideanWalk n e points - y‖ ^ 2 ≤ delta ^ 2 := by
      nlinarith [norm_nonneg (normalizedPhaseEuclideanWalk n e points - y)]
    have hden : 0 < 2 * sigma ^ 2 := by positivity
    exact neg_le_neg (div_le_div_of_nonneg_right hsquare hden.le)
  · rw [if_neg he, mul_zero]
    positivity

lemma smoothedMassReal_nonneg
    (n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) (y : PhaseEuclidean m) :
    0 ≤ phaseGaussianSmoothedMassReal n points sigma y := by
  unfold phaseGaussianSmoothedMassReal uniformExpectation
  positivity

/-- The no-wrap characteristic-function estimate with an arbitrary positive
covariance lower bound.  Keeping `gamma` explicit is essential for the
weakly separated configurations in the exceptional-tuple argument. -/
lemma norm_normalizedPhaseCharFun_le_gaussian_of_covariance
    (n : ℕ) (points : Fin m → ℝ) (gamma : ℝ)
    (hcov : HasPhaseCovarianceLower n points gamma)
    (u : PhaseCoordinate m)
    (hsmall :
      |(Real.sqrt (2 * n + 1 : ℝ))⁻¹| *
          (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2) :
    ‖normalizedPhaseCharFun n points u‖ ≤
      Real.exp (-(gamma / Real.pi ^ 2 * phaseNormSq u)) := by
  have h := norm_normalizedPhaseCharFun_low_frequency_of_covariance
    n points gamma hcov u hsmall
  convert h using 1
  have hcount : (0 : ℝ) < 2 * n + 1 := by positivity
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ^ 2 = (2 * n + 1 : ℝ) :=
    Real.sq_sqrt hcount.le
  congr 2
  rw [div_pow, inv_pow, hsqrt]
  field_simp [Real.pi_ne_zero]

lemma norm_normalizedPhaseCharFun_euclidean_le_gaussian_of_covariance
    (n : ℕ) (points : Fin m → ℝ) (gamma : ℝ)
    (hcov : HasPhaseCovarianceLower n points gamma)
    (u : PhaseEuclidean m) (hu : ‖u‖ ≤ phaseNoWrapRadius n m) :
    ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖ ≤
      Real.exp (-(gamma / Real.pi ^ 2 * ‖u‖ ^ 2)) := by
  have hsmall := normalizedPhase_no_wrap_of_norm_le
    n m (euclideanToPhase u) (by simpa using hu)
  have h := norm_normalizedPhaseCharFun_le_gaussian_of_covariance
    n points gamma hcov (euclideanToPhase u) hsmall
  simpa [phaseNormSq_euclideanToPhase] using h

/-- Gaussian inversion bounds the smoothed discrete mass by the weighted
`L¹` norm of its characteristic function, without introducing a comparison
Gaussian. -/
lemma phaseGaussianSmoothedMassReal_fourier_le
    (n m : ℕ) (points : Fin m → ℝ)
    (sigma : ℝ) (hsigma : 0 < sigma) (y : PhaseEuclidean m) :
    (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        phaseGaussianSmoothedMassReal n points sigma y ≤
      ∫ u : PhaseEuclidean m,
        Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖ := by
  have h := norm_integral_le_integral_norm (μ := volume)
    (fun u : PhaseEuclidean m ↦
      phaseFourierMultiplier sigma y u *
        normalizedPhaseCharFun n points (euclideanToPhase u))
  rw [show (∫ u : PhaseEuclidean m,
      phaseFourierMultiplier sigma y u *
        normalizedPhaseCharFun n points (euclideanToPhase u)) =
      phaseFourierIntegral sigma y
        (fun u ↦ normalizedPhaseCharFun n points (euclideanToPhase u)) by rfl,
    phaseFourierIntegral_normalizedPhaseCharFun n points sigma hsigma y,
    phaseFourierNormalization_eq_real m sigma hsigma,
    phaseGaussianSmoothedMass_eq_real] at h
  simpa only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (phaseFourierNormalization_pos m sigma hsigma),
    abs_of_nonneg (smoothedMassReal_nonneg n points sigma y),
    norm_phaseFourierMultiplier] using h

/-- Outside a Euclidean ball the smoothing multiplier alone supplies an
explicit Gaussian tail; no arithmetic separation is used here. -/
lemma normalizedPhaseCharFun_smoothingTail_le
    (n m : ℕ) (points : Fin m → ℝ)
    (sigma B : ℝ) (hsigma : 0 < sigma) (hB : 0 ≤ B) :
    (∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖},
      Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖) ≤
      Real.exp (-(sigma ^ 2 / 4) * B ^ 2) *
        (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := by
  let c : ℝ := sigma ^ 2 / 4
  let C : ℝ := Real.exp (-c * B ^ 2)
  let g : PhaseEuclidean m → ℝ := fun u ↦ C * Real.exp (-c * ‖u‖ ^ 2)
  have hc : 0 < c := by dsimp [c]; positivity
  have hg : Integrable g :=
    (integrable_rexp_neg_mul_norm_sq m c hc).const_mul C
  calc
    (∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖},
      Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖) ≤
        ∫ u : PhaseEuclidean m in {u | B ≤ ‖u‖}, g u := by
      apply setIntegral_mono_of_nonneg
      · intro u _hu
        positivity
      · intro u hu
        have hchar := norm_normalizedPhaseCharFun_le_one_test
          n points (euclideanToPhase u)
        change B ≤ ‖u‖ at hu
        have hsquares : B ^ 2 ≤ ‖u‖ ^ 2 := by
          nlinarith [norm_nonneg u]
        have hexp : Real.exp (-c * ‖u‖ ^ 2) ≤
            Real.exp (-c * B ^ 2) := by
          apply Real.exp_le_exp.mpr
          have := mul_le_mul_of_nonneg_left hsquares hc.le
          nlinarith
        have hsplit : Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) =
            Real.exp (-c * ‖u‖ ^ 2) * Real.exp (-c * ‖u‖ ^ 2) := by
          rw [← Real.exp_add]
          congr 1
          dsimp [c]
          ring
        rw [hsplit]
        unfold g C
        calc
          _ ≤ (Real.exp (-c * B ^ 2) * Real.exp (-c * ‖u‖ ^ 2)) * 1 := by
            gcongr
          _ = Real.exp (-c * B ^ 2) * Real.exp (-c * ‖u‖ ^ 2) := by ring
      · exact hg.integrableOn
    _ ≤ ∫ u : PhaseEuclidean m, g u := by
      apply setIntegral_le_integral hg
      exact Eventually.of_forall fun u ↦ by unfold g C; positivity
    _ = C * (Real.pi / c) ^ (2 * m) := by
      unfold g
      rw [integral_const_mul]
      rw [GaussianFourier.integral_rexp_neg_mul_sq_norm hc]
      have he : ((Module.finrank ℝ (PhaseEuclidean m) : ℝ) / 2) =
          (2 * m : ℕ) := by
        rw [finrank_phaseEuclidean]
        push_cast
        ring
      rw [he, Real.rpow_natCast]
    _ = Real.exp (-(sigma ^ 2 / 4) * B ^ 2) *
        (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := by rfl

/-- Covariance controls the whole smoothed Fourier integral: no-wrap
frequencies use Gaussian decay, while the smoothing kernel kills the tail. -/
lemma normalizedPhaseCharFun_integral_le_of_covariance
    (n m : ℕ) (points : Fin m → ℝ) (gamma sigma : ℝ)
    (hgamma : 0 < gamma) (hsigma : 0 < sigma)
    (hcov : HasPhaseCovarianceLower n points gamma) :
    (∫ u : PhaseEuclidean m,
      Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖) ≤
      (Real.pi / (gamma / Real.pi ^ 2)) ^ (2 * m) +
        Real.exp (-(sigma ^ 2 / 4) * phaseNoWrapRadius n m ^ 2) *
          (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := by
  let f : PhaseEuclidean m → ℝ := fun u ↦
    Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
      ‖normalizedPhaseCharFun n points (euclideanToPhase u)‖
  let B : Set (PhaseEuclidean m) := Metric.ball 0 (phaseNoWrapRadius n m)
  let g : PhaseEuclidean m → ℝ := fun u ↦
    Real.exp (-(gamma / Real.pi ^ 2) * ‖u‖ ^ 2)
  have hc : 0 < gamma / Real.pi ^ 2 := by positivity
  have hg : Integrable g := by
    simpa [g] using integrable_rexp_neg_mul_norm_sq m _ hc
  have hf : Integrable f := by
    have h := (integrable_phaseFourier_normalizedPhaseCharFun
      n points sigma hsigma (0 : PhaseEuclidean m)).norm
    apply h.congr
    filter_upwards [] with u
    dsimp [f]
    rw [norm_mul, norm_phaseFourierMultiplier]
  have hball : (∫ u in B, f u) ≤ ∫ u, g u := by
    calc
      (∫ u in B, f u) ≤ ∫ u in B, g u := by
        apply setIntegral_mono_on hf.integrableOn hg.integrableOn
          measurableSet_ball
        intro u hu
        have huR : ‖u‖ ≤ phaseNoWrapRadius n m :=
          (mem_ball_zero_iff.mp hu).le
        have hchar := norm_normalizedPhaseCharFun_euclidean_le_gaussian_of_covariance
          n points gamma hcov u huR
        have hweight : Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          exact mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr (by positivity)) (sq_nonneg _)
        dsimp [f, g]
        calc
          _ ≤ 1 * Real.exp (-(gamma / Real.pi ^ 2 * ‖u‖ ^ 2)) :=
            mul_le_mul hweight hchar (norm_nonneg _) zero_le_one
          _ = _ := by congr 1 <;> ring
      _ ≤ ∫ u, g u := setIntegral_le_integral hg
        (Eventually.of_forall fun u ↦ by dsimp [g]; positivity)
  have htail : (∫ u in Bᶜ, f u) ≤
      Real.exp (-(sigma ^ 2 / 4) * phaseNoWrapRadius n m ^ 2) *
        (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := by
    have h := normalizedPhaseCharFun_smoothingTail_le n m points sigma
      (phaseNoWrapRadius n m) hsigma (by
        unfold phaseNoWrapRadius
        positivity)
    have hBc : Bᶜ = {u : PhaseEuclidean m |
        phaseNoWrapRadius n m ≤ ‖u‖} := by
      ext u
      simp [B, mem_ball_zero_iff]
    rw [hBc]
    simpa [f] using h
  rw [← integral_add_compl (s := B) measurableSet_ball hf]
  calc
    (∫ u in B, f u) + ∫ u in Bᶜ, f u ≤
        (∫ u, g u) +
          Real.exp (-(sigma ^ 2 / 4) * phaseNoWrapRadius n m ^ 2) *
            (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := add_le_add hball htail
    _ = (Real.pi / (gamma / Real.pi ^ 2)) ^ (2 * m) +
          Real.exp (-(sigma ^ 2 / 4) * phaseNoWrapRadius n m ^ 2) *
            (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := by
      rw [show (∫ u : PhaseEuclidean m, g u) =
          (Real.pi / (gamma / Real.pi ^ 2)) ^ (2 * m) by
        dsimp [g]
        rw [GaussianFourier.integral_rexp_neg_mul_sq_norm hc]
        rw [finrank_phaseEuclidean]
        rw [show ((4 * m : ℕ) : ℝ) / 2 = (2 * m : ℕ) by push_cast; ring,
          Real.rpow_natCast]]

/-- A covariance-only small-ball inequality.  It is weaker than the local
CLT but remains quantitative when the covariance constant tends slowly to
zero, which is precisely what the close-base tuple class needs. -/
lemma uniformProbability_phaseBall_le_of_covariance
    (n m : ℕ) (points : Fin m → ℝ) (gamma sigma delta : ℝ)
    (hgamma : 0 < gamma) (hsigma : 0 < sigma) (hdelta : 0 ≤ delta)
    (hcov : HasPhaseCovarianceLower n points gamma)
    (y : PhaseEuclidean m) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta) ≤
      ((Real.pi / (gamma / Real.pi ^ 2)) ^ (2 * m) +
          Real.exp (-(sigma ^ 2 / 4) * phaseNoWrapRadius n m ^ 2) *
            (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m)) /
        ((2 * Real.pi / sigma ^ 2) ^ (2 * m) *
          Real.exp (-(delta ^ 2 / (2 * sigma ^ 2)))) := by
  have hmass := uniformProbability_phaseBall_mul_le_smoothedMassReal
    n points sigma delta hsigma hdelta y
  have hscaled := mul_le_mul_of_nonneg_left hmass
    (le_of_lt (phaseFourierNormalization_pos m sigma hsigma))
  have hfour := phaseGaussianSmoothedMassReal_fourier_le
    n m points sigma hsigma y
  have hintegral := normalizedPhaseCharFun_integral_le_of_covariance
    n m points gamma sigma hgamma hsigma hcov
  have hupper : (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        phaseGaussianSmoothedMassReal n points sigma y ≤
      (Real.pi / (gamma / Real.pi ^ 2)) ^ (2 * m) +
        Real.exp (-(sigma ^ 2 / 4) * phaseNoWrapRadius n m ^ 2) *
          (Real.pi / (sigma ^ 2 / 4)) ^ (2 * m) := hfour.trans hintegral
  have hden : 0 < (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
      Real.exp (-(delta ^ 2 / (2 * sigma ^ 2))) := by positivity
  apply (le_div_iff₀ hden).2
  calc
    _ = (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        (uniformProbability (fun e : SignVector (2 * n) ↦
          ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta) *
          Real.exp (-(delta ^ 2 / (2 * sigma ^ 2)))) := by ring
    _ ≤ (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        phaseGaussianSmoothedMassReal n points sigma y := hscaled
    _ ≤ _ := hupper

/-- The inverse Fourier transform of a covariance Gaussian is uniformly
bounded whenever the covariance has the fixed lower bound used above. -/
lemma norm_phaseFourierIntegral_covariance_le
    (n m : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (sigma : ℝ) (hsigma : 0 < sigma) (y : PhaseEuclidean m) :
    ‖phaseFourierIntegral sigma y
        (normalizedPhaseCovarianceGaussian n points)‖ ≤
      ∫ u : PhaseEuclidean m, Real.exp (-(1 / 24) * ‖u‖ ^ 2) := by
  unfold phaseFourierIntegral
  calc
    ‖∫ u : PhaseEuclidean m,
        phaseFourierMultiplier sigma y u *
          normalizedPhaseCovarianceGaussian n points u‖ ≤
        ∫ u : PhaseEuclidean m,
          ‖phaseFourierMultiplier sigma y u *
            normalizedPhaseCovarianceGaussian n points u‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ u : PhaseEuclidean m,
        Real.exp (-(1 / 24) * ‖u‖ ^ 2) := by
      apply integral_mono
      · exact ((integrable_phaseFourier_covarianceGaussian
          n points sigma hsigma y).norm)
      · exact integrable_rexp_neg_mul_norm_sq m (1 / 24) (by norm_num)
      · intro u
        dsimp only
        rw [norm_mul, norm_phaseFourierMultiplier]
        have hw : Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          exact mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr (by positivity)) (sq_nonneg _)
        calc
          _ ≤ 1 * Real.exp (-((‖u‖ ^ 2) / 24)) :=
            mul_le_mul hw
              (norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
                n points hcov u)
              (norm_nonneg _) zero_le_one
          _ = Real.exp (-(1 / 24) * ‖u‖ ^ 2) := by congr 1 <;> ring

lemma phaseGaussianSmoothedMassReal_le_of_fourierError
    (n m : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (sigma : ℝ) (hsigma : 0 < sigma) (y : PhaseEuclidean m)
    (eta : ℝ) (_heta : 0 ≤ eta)
    (herr :
      ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points sigma y -
        phaseFourierIntegral sigma y
          (normalizedPhaseCovarianceGaussian n points)‖ ≤ eta) :
    (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        phaseGaussianSmoothedMassReal n points sigma y ≤
      (∫ u : PhaseEuclidean m, Real.exp (-(1 / 24) * ‖u‖ ^ 2)) + eta := by
  let A : ℝ := (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
    phaseGaussianSmoothedMassReal n points sigma y
  let G : ℂ := phaseFourierIntegral sigma y
    (normalizedPhaseCovarianceGaussian n points)
  have herr' : ‖(A : ℂ) - G‖ ≤ eta := by
    rw [phaseFourierNormalization_eq_real m sigma hsigma,
      phaseGaussianSmoothedMass_eq_real] at herr
    simpa [A, G] using herr
  have hre : |A - G.re| ≤ eta := by
    calc
      |A - G.re| = |((A : ℂ) - G).re| := by rfl
      _ ≤ ‖(A : ℂ) - G‖ := Complex.abs_re_le_norm _
      _ ≤ eta := herr'
  have hGre : G.re ≤ ‖G‖ := (le_abs_self G.re).trans (Complex.abs_re_le_norm G)
  have hG := norm_phaseFourierIntegral_covariance_le
    n m points hcov sigma hsigma y
  change A ≤ _
  linarith [le_abs_self (A - G.re)]

/-- Quantitative small-ball bound obtained by inserting the preceding
Gaussian convolution between the finite law and its covariance Gaussian. -/
lemma uniformProbability_phaseBall_le_of_fourierError
    (n m : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (sigma delta : ℝ) (hsigma : 0 < sigma) (hdelta : 0 ≤ delta)
    (y : PhaseEuclidean m) (eta : ℝ) (heta : 0 ≤ eta)
    (herr :
      ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points sigma y -
        phaseFourierIntegral sigma y
          (normalizedPhaseCovarianceGaussian n points)‖ ≤ eta) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta) ≤
      ((∫ u : PhaseEuclidean m, Real.exp (-(1 / 24) * ‖u‖ ^ 2)) + eta) /
        ((2 * Real.pi / sigma ^ 2) ^ (2 * m) *
          Real.exp (-(delta ^ 2 / (2 * sigma ^ 2)))) := by
  have hmass := uniformProbability_phaseBall_mul_le_smoothedMassReal
    n points sigma delta hsigma hdelta y
  have hscaled := mul_le_mul_of_nonneg_left hmass
    (le_of_lt (phaseFourierNormalization_pos m sigma hsigma))
  have hupper := phaseGaussianSmoothedMassReal_le_of_fourierError
    n m points hcov sigma hsigma y eta heta herr
  have hden : 0 < (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
      Real.exp (-(delta ^ 2 / (2 * sigma ^ 2))) := by positivity
  apply (le_div_iff₀ hden).2
  calc
    _ = (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        (uniformProbability (fun e : SignVector (2 * n) ↦
          ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta) *
          Real.exp (-(delta ^ 2 / (2 * sigma ^ 2)))) := by ring
    _ ≤ (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
        phaseGaussianSmoothedMassReal n points sigma y := hscaled
    _ ≤ _ := hupper

noncomputable def phaseSmallBallConstant (m : ℕ) : ℝ :=
  ((∫ u : PhaseEuclidean m, Real.exp (-(1 / 24) * ‖u‖ ^ 2)) + 1) *
    Real.exp (1 / 2) / (2 * Real.pi) ^ (2 * m)

lemma phaseBall_bound_identity (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    ((∫ u : PhaseEuclidean m, Real.exp (-(1 / 24) * ‖u‖ ^ 2)) + 1) /
        ((2 * Real.pi / sigma ^ 2) ^ (2 * m) *
          Real.exp (-(sigma ^ 2 / (2 * sigma ^ 2)))) =
      phaseSmallBallConstant m * sigma ^ (4 * m) := by
  have hsigma0 : sigma ≠ 0 := hsigma.ne'
  have hcancel : sigma ^ 2 / (2 * sigma ^ 2) = (1 / 2 : ℝ) := by
    field_simp
  rw [hcancel, div_pow]
  unfold phaseSmallBallConstant
  rw [← pow_mul]
  have hexp : Real.exp (-(1 / 2 : ℝ)) * Real.exp (1 / 2) = 1 := by
    rw [← Real.exp_add]
    norm_num
  field_simp [hsigma0, Real.pi_ne_zero, Real.exp_ne_zero]
  rw [hexp]
  congr 1
  ring

/-- The local CLT yields the source-strength `delta^(4m)` anti-concentration
bound at the explicit polynomial smoothing scale, uniformly in every smooth,
spread point configuration. -/
theorem eventually_uniform_phaseSmallBall
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (y : PhaseEuclidean m),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      uniformProbability (fun e : SignVector (2 * n) ↦
          ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤
            localCLTSmoothingScaleTest n) ≤
        phaseSmallBallConstant m * localCLTSmoothingScaleTest n ^ (4 * m) := by
  filter_upwards [Nat.eventually_pos,
      smoothedLocalCLT_uniform_test hm (show (0 : ℝ) < 1 by norm_num),
      eventually_hasPhaseCovarianceLower_rigidity m]
    with n hn hclt hcov
  intro points y hsmooth hspread
  have hsigma : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  have hbound := uniformProbability_phaseBall_le_of_fourierError
    n m points (hcov points hsmooth hspread)
    (localCLTSmoothingScaleTest n) (localCLTSmoothingScaleTest n)
    hsigma hsigma.le y 1 (by norm_num) (le_of_lt (hclt points y hsmooth hspread))
  rw [phaseBall_bound_identity m (localCLTSmoothingScaleTest n) hsigma] at hbound
  exact hbound

lemma phaseFourierErrorIntegral_mono_smoothing
    (n : ℕ) (points : Fin m → ℝ) (sigma₀ sigma : ℝ)
    (hsigma₀ : 0 < sigma₀) (hsigma : sigma₀ ≤ sigma) :
    (∫ u : PhaseEuclidean m,
      Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
        ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
          normalizedPhaseCovarianceGaussian n points u‖) ≤
      ∫ u : PhaseEuclidean m,
        Real.exp (-(sigma₀ ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖ := by
  have hsigmaPos : 0 < sigma := hsigma₀.trans_le hsigma
  apply integral_mono
  · exact integrable_phaseFourierError_test n points sigma hsigmaPos
  · exact integrable_phaseFourierError_test n points sigma₀ hsigma₀
  · intro u
    have hsquares : sigma₀ ^ 2 ≤ sigma ^ 2 := by
      nlinarith
    have hexp : Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) ≤
        Real.exp (-(sigma₀ ^ 2 / 2) * ‖u‖ ^ 2) := by
      apply Real.exp_le_exp.mpr
      have hnorm : 0 ≤ ‖u‖ ^ 2 := sq_nonneg _
      nlinarith
    exact mul_le_mul_of_nonneg_right hexp (norm_nonneg _)

/-- The same Fourier error bound holds for every wider Gaussian smoothing
kernel; pointwise monotonicity of the radial multiplier is the only extra
input. -/
theorem eventually_phaseFourierErrorIntegral_le_of_smoothingScale
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ) (sigma : ℝ),
      localCLTSmoothingScaleTest n ≤ sigma →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      (∫ u : PhaseEuclidean m,
        Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseCharFun n points (euclideanToPhase u) -
            normalizedPhaseCovarianceGaussian n points u‖) ≤
        localCLTFourierErrorBoundTest m n := by
  filter_upwards [Nat.eventually_pos,
      eventually_phaseFourierErrorIntegral_le_test hm]
    with n hn hbase
  intro points sigma hsigma hsmooth hspread
  have hsigma₀ : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  exact (phaseFourierErrorIntegral_mono_smoothing n points
    (localCLTSmoothingScaleTest n) sigma hsigma₀ hsigma).trans
      (hbase points hsmooth hspread)

theorem eventually_smoothedLocalCLT_le_of_smoothingScale
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ)
        (sigma : ℝ) (y : PhaseEuclidean m),
      localCLTSmoothingScaleTest n ≤ sigma →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points sigma y -
        phaseFourierIntegral sigma y
          (normalizedPhaseCovarianceGaussian n points)‖ ≤
        localCLTFourierErrorBoundTest m n := by
  filter_upwards [Nat.eventually_pos,
      eventually_phaseFourierErrorIntegral_le_of_smoothingScale hm]
    with n hn herr
  intro points sigma y hsigma hsmooth hspread
  have hsigma₀ : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  have hsigmaPos : 0 < sigma := hsigma₀.trans_le hsigma
  exact (norm_phaseGaussianSmoothedMass_sub_covarianceFourier
    n points sigma hsigmaPos y).trans
      (herr points sigma hsigma hsmooth hspread)

/-- Uniform source-strength small-ball bound at every radius above the
explicit polynomial smoothing scale. -/
theorem eventually_uniform_phaseSmallBall_of_scale
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ)
        (y : PhaseEuclidean m) (delta : ℝ),
      localCLTSmoothingScaleTest n ≤ delta →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      uniformProbability (fun e : SignVector (2 * n) ↦
          ‖normalizedPhaseEuclideanWalk n e points - y‖ ≤ delta) ≤
        phaseSmallBallConstant m * delta ^ (4 * m) := by
  filter_upwards [Nat.eventually_pos,
      eventually_smoothedLocalCLT_le_of_smoothingScale hm,
      eventually_hasPhaseCovarianceLower_rigidity m,
      (localCLTFourierErrorBound_tendsto_zero_test m).eventually
        (Iio_mem_nhds (show (0 : ℝ) < 1 by norm_num))]
    with n hn hclt hcov herror
  intro points y delta hdelta hsmooth hspread
  have hsigma₀ : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  have hdeltaPos : 0 < delta := hsigma₀.trans_le hdelta
  have hbound := uniformProbability_phaseBall_le_of_fourierError
    n m points (hcov points hsmooth hspread) delta delta
    hdeltaPos hdeltaPos.le y 1 (by norm_num)
    ((hclt points delta y hdelta hsmooth hspread).trans herror.le)
  rw [phaseBall_bound_identity m delta hdeltaPos] at hbound
  exact hbound

/-! ### Uniform convergence of the finite covariance form -/

/-- Covariance form of `m` independent circular Gaussian position--velocity
pairs, with component variances `1/2` and `1/6`. -/
noncomputable def phaseLimitingCovarianceForm (u : PhaseCoordinate m) : ℝ :=
  (1 / 2) * ∑ r : Fin m, Complex.normSq (phasePositionCoeff u r) +
    (1 / 6) * ∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)

/-- The diagonal part of the exact finite covariance. -/
noncomputable def phaseFiniteDiagonalForm
    (n : ℕ) (u : PhaseCoordinate m) : ℝ :=
  (1 / 2) * ∑ r : Fin m, Complex.normSq (phasePositionCoeff u r) +
    ((n + 1 : ℝ) / (6 * n)) *
      ∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)

lemma abs_reflectedAffineCross_re_le_of_smooth_spread
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (rho : ℝ) (hrho : rho = min (K / n) (lam / n)) (hrhoPos : 0 < rho)
    (u : PhaseCoordinate m) (a b : ReflectedMode m) (hab : a ≠ b) :
    |(centeredAffineCrossMoment n
        (reflectedModeTime points b) (reflectedModeTime points a)
        (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
        (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re| ≤
      (6 / (4 * rho)) *
        (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) *
        (‖reflectedPositionCoeff u b‖ + ‖reflectedVelocityCoeff u b‖) := by
  let z : ℂ := centeredAffineCrossMoment n
    (reflectedModeTime points b) (reflectedModeTime points a)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)
  have hmom : ∀ k : Fin 3,
      ‖centeredWaveMoment n k
        (reflectedModeTime points a - reflectedModeTime points b)‖ ≤
          6 / (4 * rho) := by
    intro k
    rw [hrho]
    exact norm_centeredWaveMoment_reflected_sub_le_of_smooth_spread
      n k hn (by omega) K lam points hsmooth hspread a b hab
      (by simpa [← hrho] using hrhoPos)
  exact (Complex.abs_re_le_norm z).trans
    (norm_centeredAffineCrossMoment_le n
      (reflectedModeTime points b) (reflectedModeTime points a)
      (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
      (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)
      (6 / (4 * rho)) (by positivity) hmom)

lemma abs_reflectedAffineOffDiagonal_le
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (rho : ℝ) (hrho : rho = min (K / n) (lam / n)) (hrhoPos : 0 < rho)
    (u : PhaseCoordinate m) :
    |∑ a : ReflectedMode m, ∑ b ∈ (Finset.univ.erase a),
        (centeredAffineCrossMoment n
          (reflectedModeTime points b) (reflectedModeTime points a)
          (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
          (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re| ≤
      (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 * phaseNormSq u := by
  let f : ReflectedMode m → ReflectedMode m → ℝ := fun a b ↦
    (centeredAffineCrossMoment n
      (reflectedModeTime points b) (reflectedModeTime points a)
      (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
      (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re
  let w : ReflectedMode m → ℝ := fun a ↦
    ‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖
  let M : ℝ := 6 / (4 * rho)
  have hM : 0 ≤ M := by dsimp [M]; positivity
  have hw : ∀ a, 0 ≤ w a := fun a ↦ by dsimp [w]; positivity
  have hterm : ∀ a b, a ≠ b → |f a b| ≤ M * w a * w b := by
    intro a b hab
    simpa [f, w, M] using
      abs_reflectedAffineCross_re_le_of_smooth_spread
        n hn K lam points hsmooth hspread rho hrho hrhoPos u a b hab
  have habs : |∑ a : ReflectedMode m,
      ∑ b ∈ (Finset.univ.erase a), f a b| ≤
      ∑ a : ReflectedMode m, ∑ b ∈ (Finset.univ.erase a), |f a b| := by
    calc
      _ ≤ ∑ a : ReflectedMode m,
          |∑ b ∈ (Finset.univ.erase a), f a b| :=
        Finset.abs_sum_le_sum_abs _ _
      _ ≤ _ := by
        apply Finset.sum_le_sum
        intro a _ha
        exact Finset.abs_sum_le_sum_abs _ _
  have hterms : (∑ a : ReflectedMode m,
      ∑ b ∈ (Finset.univ.erase a), |f a b|) ≤
      ∑ a : ReflectedMode m,
        ∑ b ∈ (Finset.univ.erase a), M * w a * w b := by
    apply Finset.sum_le_sum
    intro a _ha
    apply Finset.sum_le_sum
    intro b hb
    exact hterm a b (Finset.ne_of_mem_erase hb).symm
  have hoff := sum_offDiagonal_mul_le_square w hw
  have hfactor : (∑ a : ReflectedMode m,
      ∑ b ∈ (Finset.univ.erase a), M * w a * w b) =
      M * (∑ a : ReflectedMode m,
        ∑ b ∈ (Finset.univ.erase a), w a * w b) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _ha
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _hb
    ring
  have hwsq := sum_reflectedCoeffWeight_sq_le u
  change |∑ a : ReflectedMode m,
      ∑ b ∈ (Finset.univ.erase a), f a b| ≤
    M * (4 * m : ℝ) ^ 2 * phaseNormSq u
  calc
    _ ≤ ∑ a : ReflectedMode m,
        ∑ b ∈ (Finset.univ.erase a), |f a b| := habs
    _ ≤ ∑ a : ReflectedMode m,
        ∑ b ∈ (Finset.univ.erase a), M * w a * w b := hterms
    _ = M * (∑ a : ReflectedMode m,
        ∑ b ∈ (Finset.univ.erase a), w a * w b) := hfactor
    _ ≤ M * (∑ a : ReflectedMode m, w a) ^ 2 :=
      mul_le_mul_of_nonneg_left hoff hM
    _ ≤ M * ((4 * m : ℝ) ^ 2 * phaseNormSq u) :=
      mul_le_mul_of_nonneg_left hwsq hM
    _ = _ := by ring

/-- The only difference between the exact covariance and its finite
block-diagonal part is the uniformly controlled reflected-mode cross sum. -/
lemma abs_normalizedPhaseCovarianceForm_sub_finiteDiagonal_le
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (rho : ℝ) (hrho : rho = min (K / n) (lam / n)) (hrhoPos : 0 < rho)
    (u : PhaseCoordinate m) :
    |normalizedPhaseCovarianceForm n points u -
        phaseFiniteDiagonalForm n u| ≤
      ((6 / (4 * rho)) * (4 * m : ℝ) ^ 2 * phaseNormSq u) /
        (2 * n + 1 : ℝ) := by
  let f : ReflectedMode m → ReflectedMode m → ℝ := fun a b ↦
    (centeredAffineCrossMoment n
      (reflectedModeTime points b) (reflectedModeTime points a)
      (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
      (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re
  let O : ℝ := ∑ a : ReflectedMode m,
    ∑ b ∈ (Finset.univ.erase a), f a b
  have hdecomp : (∑ a : ReflectedMode m, ∑ b : ReflectedMode m, f a b) =
      (∑ a : ReflectedMode m, f a a) + O := by
    simpa [O] using sum_double_eq_diag_add_offDiagonal f
  have hdiag : (∑ a : ReflectedMode m, f a a) =
      ((2 * n + 1 : ℝ) / 2) *
          (∑ r : Fin m, Complex.normSq (phasePositionCoeff u r)) +
        ((2 * n + 1 : ℝ) * (n + 1) / (6 * n)) *
          (∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)) := by
    simpa [f] using reflectedAffineDiagonal_eq n hn points u
  have hform : normalizedPhaseCovarianceForm n points u =
      phaseFiniteDiagonalForm n u + O / (2 * n + 1 : ℝ) := by
    unfold normalizedPhaseCovarianceForm
    rw [phaseProjection_energy_eq_reflectedCross]
    change (∑ a : ReflectedMode m, ∑ b : ReflectedMode m, f a b) /
        (2 * n + 1 : ℝ) = _
    rw [hdecomp, hdiag, add_div]
    unfold phaseFiniteDiagonalForm
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    field_simp
  rw [hform, add_sub_cancel_left, abs_div,
    abs_of_pos (show (0 : ℝ) < 2 * n + 1 by positivity)]
  apply div_le_div_of_nonneg_right _ (by positivity)
  simpa [O, f] using abs_reflectedAffineOffDiagonal_le
    n hn K lam points hsmooth hspread rho hrho hrhoPos u

lemma abs_phaseFiniteDiagonalForm_sub_limiting_le
    (n : ℕ) (hn : 0 < n) (u : PhaseCoordinate m) :
    |phaseFiniteDiagonalForm n u - phaseLimitingCovarianceForm u| ≤
      phaseNormSq u / (6 * n) := by
  let V : ℝ := ∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)
  let P : ℝ := ∑ r : Fin m, Complex.normSq (phasePositionCoeff u r)
  have hV0 : 0 ≤ V := Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _
  have hVle : V ≤ phaseNormSq u := by
    rw [← phaseCoeff_energy u]
    dsimp [V]
    apply Finset.sum_le_sum
    intro r _hr
    exact le_add_of_nonneg_left (Complex.normSq_nonneg _)
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  unfold phaseFiniteDiagonalForm phaseLimitingCovarianceForm
  change |(1 / 2) * P + ((n + 1 : ℝ) / (6 * n)) * V -
      ((1 / 2) * P + (1 / 6) * V)| ≤ _
  have heq : (1 / 2 : ℝ) * P + ((n + 1 : ℝ) / (6 * n)) * V -
      ((1 / 2) * P + (1 / 6) * V) = V / (6 * n) := by
    field_simp
    ring
  rw [heq, abs_of_nonneg (div_nonneg hV0 (by positivity))]
  exact div_le_div_of_nonneg_right hVle (by positivity)

/-- Quantitative covariance convergence to independent circular position
and velocity blocks. -/
lemma abs_normalizedPhaseCovarianceForm_sub_limiting_le
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (rho : ℝ) (hrho : rho = min (K / n) (lam / n)) (hrhoPos : 0 < rho)
    (u : PhaseCoordinate m) :
    |normalizedPhaseCovarianceForm n points u -
        phaseLimitingCovarianceForm u| ≤
      ((6 / (4 * rho)) * (4 * m : ℝ) ^ 2 /
          (2 * n + 1 : ℝ) + 1 / (6 * n)) * phaseNormSq u := by
  calc
    _ ≤ |normalizedPhaseCovarianceForm n points u -
          phaseFiniteDiagonalForm n u| +
        |phaseFiniteDiagonalForm n u - phaseLimitingCovarianceForm u| := by
      rw [show normalizedPhaseCovarianceForm n points u -
          phaseLimitingCovarianceForm u =
        (normalizedPhaseCovarianceForm n points u -
          phaseFiniteDiagonalForm n u) +
        (phaseFiniteDiagonalForm n u - phaseLimitingCovarianceForm u) by ring]
      exact abs_add_le _ _
    _ ≤ ((6 / (4 * rho)) * (4 * m : ℝ) ^ 2 * phaseNormSq u) /
          (2 * n + 1 : ℝ) + phaseNormSq u / (6 * n) :=
      add_le_add
        (abs_normalizedPhaseCovarianceForm_sub_finiteDiagonal_le
          n hn K lam points hsmooth hspread rho hrho hrhoPos u)
        (abs_phaseFiniteDiagonalForm_sub_limiting_le n hn u)
    _ = _ := by ring

noncomputable def phaseCovarianceApproxBound (m n : ℕ) : ℝ :=
  (6 / (4 * (rigiditySmoothScale n / n))) * (4 * m : ℝ) ^ 2 /
      (2 * n + 1 : ℝ) + 1 / (6 * n)

lemma phaseCovarianceApproxBound_nonneg (m n : ℕ) :
    0 ≤ phaseCovarianceApproxBound m n := by
  rcases n.eq_zero_or_pos with rfl | hn
  · simp [phaseCovarianceApproxBound, rigiditySmoothScale, rigidityPower]
  · unfold phaseCovarianceApproxBound
    have hscale : 0 < rigiditySmoothScale n := by
      unfold rigiditySmoothScale
      exact rigidityPower_pos hn _
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    positivity

lemma phaseCovarianceApproxBound_le_power
    (m n : ℕ) (hn : 0 < n) :
    phaseCovarianceApproxBound m n ≤
      24 * (m : ℝ) ^ 2 * rigidityPower n (-1 / 16) + 1 / (6 * n) := by
  let rho : ℝ := rigiditySmoothScale n / n
  have hrho : rho = rigidityPower n (-15 / 16) := by
    dsimp [rho]
    rw [rigiditySmoothScale_div_eq_power hn]
    unfold rigiditySmoothExponent
    congr 1
    ring
  have hrhoPos : 0 < rho := by
    rw [hrho]
    exact rigidityPower_pos hn _
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hden : (n : ℝ) ≤ 2 * n + 1 := by linarith
  have hnum : 0 ≤ (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 := by positivity
  have hoff :
      (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 / (2 * n + 1 : ℝ) ≤
        (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 / n := by
    exact div_le_div_of_nonneg_left hnum hnreal hden
  have hproduct : rho * (n : ℝ) = rigidityPower n (1 / 16) := by
    rw [hrho, show (n : ℝ) = rigidityPower n 1 by simp [rigidityPower]]
    calc
      rigidityPower n (-15 / 16) * rigidityPower n 1 =
          rigidityPower n ((-15 / 16) + 1) :=
        (rigidityPower_add hn _ _).symm
      _ = rigidityPower n (1 / 16) := by congr 1 <;> ring
  have hid : (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 / n =
      24 * (m : ℝ) ^ 2 * rigidityPower n (-1 / 16) := by
    rw [show rigidityPower n (-1 / 16) =
        (rigidityPower n (1 / 16))⁻¹ by
      unfold rigidityPower
      rw [show (-1 / 16 : ℝ) = -(1 / 16) by ring,
        Real.rpow_neg (by exact_mod_cast hn.le)]]
    rw [← hproduct]
    field_simp [hrhoPos.ne', hnreal.ne']
    ring
  change (6 / (4 * rho)) * (4 * m : ℝ) ^ 2 /
      (2 * n + 1 : ℝ) + 1 / (6 * (n : ℝ)) ≤
    24 * (m : ℝ) ^ 2 * rigidityPower n (-1 / 16) +
      1 / (6 * (n : ℝ))
  exact add_le_add (hoff.trans_eq hid) le_rfl

lemma phaseCovarianceApproxBound_tendsto_zero (m : ℕ) :
    Tendsto (phaseCovarianceApproxBound m) atTop (𝓝 0) := by
  have hpow : Tendsto
      (fun n : ℕ ↦ 24 * (m : ℝ) ^ 2 * rigidityPower n (-1 / 16))
      atTop (𝓝 0) := by
    have h := (tendsto_rigidityPower_neg_zero
      (by norm_num : (0 : ℝ) < 1 / 16)).const_mul (24 * (m : ℝ) ^ 2)
    have hfun : (fun n : ℕ ↦
        24 * (m : ℝ) ^ 2 * rigidityPower n (-(1 / 16))) =
        (fun n : ℕ ↦
          24 * (m : ℝ) ^ 2 * rigidityPower n (-1 / 16)) := by
      funext n
      congr 2
      ring
    rw [hfun] at h
    simpa using h
  have hinv : Tendsto (fun n : ℕ ↦ 1 / (6 * (n : ℝ))) atTop (𝓝 0) := by
    have h : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (𝓝 0) :=
      tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
    convert h.const_mul (1 / 6 : ℝ) using 1 <;> ring
  apply squeeze_zero'
  · exact Eventually.of_forall fun n ↦ phaseCovarianceApproxBound_nonneg m n
  · filter_upwards [Nat.eventually_pos] with n hn
    exact phaseCovarianceApproxBound_le_power m n hn
  · simpa using hpow.add hinv

/-- On every smooth, spread tuple, the exact covariance form converges
uniformly in direction to the independent circular Gaussian form. -/
theorem eventually_uniform_phaseCovariance_convergence
    {m : ℕ} {eta : ℝ} (heta : 0 < eta) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ∀ u : PhaseCoordinate m,
        |normalizedPhaseCovarianceForm n points u -
            phaseLimitingCovarianceForm u| ≤ eta * phaseNormSq u := by
  filter_upwards [Nat.eventually_pos,
      (phaseCovarianceApproxBound_tendsto_zero m).eventually
        (Iio_mem_nhds heta)]
    with n hn hbound
  intro points hsmooth hspread u
  have hscale : 0 < rigiditySmoothScale n := by
    unfold rigiditySmoothScale
    exact rigidityPower_pos hn _
  have hrho : 0 < rigiditySmoothScale n / n := by positivity
  have hraw := abs_normalizedPhaseCovarianceForm_sub_limiting_le
    n hn (rigiditySmoothScale n) (rigiditySmoothScale n) points
    hsmooth hspread (rigiditySmoothScale n / n) (by simp) hrho u
  change _ ≤ phaseCovarianceApproxBound m n * phaseNormSq u at hraw
  exact hraw.trans (mul_le_mul_of_nonneg_right hbound.le
    (phaseNormSq_nonneg u))

/-- The exponential is one-Lipschitz on the nonpositive half-line, in the
normalization used by Gaussian characteristic functions. -/
lemma abs_exp_neg_half_sub_exp_neg_half_le
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    |Real.exp (-a / 2) - Real.exp (-b / 2)| ≤ |a - b| / 2 := by
  have hdiff := (convex_Iic (0 : ℝ)).norm_image_sub_le_of_norm_deriv_le
    (f := Real.exp) (C := 1)
    (fun x _hx ↦ Real.differentiableAt_exp)
    (fun x hx ↦ by
      rw [Real.deriv_exp, Real.norm_eq_abs, abs_of_pos (Real.exp_pos x)]
      exact Real.exp_le_one_iff.mpr hx)
    (show -a / 2 ∈ Set.Iic (0 : ℝ) by
      exact div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr ha) (by norm_num))
    (show -b / 2 ∈ Set.Iic (0 : ℝ) by
      exact div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hb) (by norm_num))
  rw [one_mul] at hdiff
  calc
    |Real.exp (-a / 2) - Real.exp (-b / 2)| =
        |Real.exp (-b / 2) - Real.exp (-a / 2)| := abs_sub_comm _ _
    _ ≤ ‖-b / 2 - -a / 2‖ := hdiff
    _ = |a - b| / 2 := by
      rw [Real.norm_eq_abs]
      rw [show -b / 2 - -a / 2 = (a - b) / 2 by ring,
        abs_div, abs_of_pos (show (0 : ℝ) < 2 by norm_num)]

lemma phaseLimitingCovarianceForm_nonneg {m : ℕ} (u : PhaseCoordinate m) :
    0 ≤ phaseLimitingCovarianceForm u := by
  unfold phaseLimitingCovarianceForm
  exact add_nonneg
    (mul_nonneg (by norm_num)
      (Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _))
    (mul_nonneg (by norm_num)
      (Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _))

lemma phaseLimitingCovarianceForm_lower {m : ℕ} (u : PhaseCoordinate m) :
    (1 / 6) * phaseNormSq u ≤ phaseLimitingCovarianceForm u := by
  rw [← phaseCoeff_energy u]
  rw [Finset.sum_add_distrib]
  unfold phaseLimitingCovarianceForm
  have hP : 0 ≤ ∑ r : Fin m, Complex.normSq (phasePositionCoeff u r) :=
    Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _
  linarith

lemma phaseLimitingCovarianceForm_upper {m : ℕ} (u : PhaseCoordinate m) :
    phaseLimitingCovarianceForm u ≤ (1 / 2) * phaseNormSq u := by
  rw [← phaseCoeff_energy u]
  rw [Finset.sum_add_distrib]
  unfold phaseLimitingCovarianceForm
  have hV : 0 ≤ ∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r) :=
    Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _
  linarith

/-- Characteristic function of the independent circular limiting Gaussian. -/
noncomputable def normalizedPhaseLimitingGaussian (u : PhaseEuclidean m) : ℂ :=
  (Real.exp (-(phaseLimitingCovarianceForm (euclideanToPhase u)) / 2) : ℂ)

lemma continuous_normalizedPhaseLimitingGaussian {m : ℕ} :
    Continuous (normalizedPhaseLimitingGaussian : PhaseEuclidean m → ℂ) := by
  unfold normalizedPhaseLimitingGaussian phaseLimitingCovarianceForm
    phasePositionCoeff phaseVelocityCoeff euclideanToPhase
  fun_prop

lemma norm_normalizedPhaseLimitingGaussian_le_fixedGaussian
    {m : ℕ} (u : PhaseEuclidean m) :
    ‖normalizedPhaseLimitingGaussian u‖ ≤
      Real.exp (- (‖u‖ ^ 2 / 12)) := by
  unfold normalizedPhaseLimitingGaussian
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]
  apply Real.exp_le_exp.mpr
  have hlow := phaseLimitingCovarianceForm_lower (euclideanToPhase u)
  rw [phaseNormSq_euclideanToPhase] at hlow
  nlinarith

/-- The exponential comparison retains a common Gaussian lower envelope;
this makes covariance convergence integrable on the whole frequency space. -/
lemma abs_exp_neg_half_sub_exp_neg_half_le_with_lower
    {a b c : ℝ} (hca : c ≤ a) (hcb : c ≤ b) :
    |Real.exp (-a / 2) - Real.exp (-b / 2)| ≤
      |a - b| / 2 * Real.exp (-c / 2) := by
  have hdiff := (convex_Iic (-c / 2)).norm_image_sub_le_of_norm_deriv_le
    (f := Real.exp) (C := Real.exp (-c / 2))
    (fun x _hx ↦ Real.differentiableAt_exp)
    (fun x hx ↦ by
      rw [Real.deriv_exp, Real.norm_eq_abs, abs_of_pos (Real.exp_pos x)]
      exact Real.exp_le_exp.mpr hx)
    (show -a / 2 ∈ Set.Iic (-c / 2) by
      exact div_le_div_of_nonneg_right (neg_le_neg hca) (by norm_num))
    (show -b / 2 ∈ Set.Iic (-c / 2) by
      exact div_le_div_of_nonneg_right (neg_le_neg hcb) (by norm_num))
  calc
    |Real.exp (-a / 2) - Real.exp (-b / 2)| =
        |Real.exp (-b / 2) - Real.exp (-a / 2)| := abs_sub_comm _ _
    _ ≤ Real.exp (-c / 2) * ‖-b / 2 - -a / 2‖ := hdiff
    _ = |a - b| / 2 * Real.exp (-c / 2) := by
      rw [Real.norm_eq_abs]
      rw [show -b / 2 - -a / 2 = (a - b) / 2 by ring,
        abs_div, abs_of_pos (show (0 : ℝ) < 2 by norm_num)]
      ring

/-- Uniform pointwise comparison of the exact-covariance Gaussian and its
limiting independent-block Gaussian, with an integrable Gaussian envelope. -/
theorem eventually_uniform_normalizedPhaseCovarianceGaussian_convergence
    {m : ℕ} {eta : ℝ} (heta : 0 < eta) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ∀ u : PhaseEuclidean m,
        ‖normalizedPhaseCovarianceGaussian n points u -
            normalizedPhaseLimitingGaussian u‖ ≤
          eta / 2 * ‖u‖ ^ 2 * Real.exp (- (‖u‖ ^ 2 / 24)) := by
  filter_upwards [eventually_uniform_phaseCovariance_convergence heta,
      eventually_hasPhaseCovarianceLower_rigidity m]
    with n hconv hcov
  intro points hsmooth hspread u
  let a := normalizedPhaseCovarianceForm n points (euclideanToPhase u)
  let b := phaseLimitingCovarianceForm (euclideanToPhase u)
  let c := (1 / 12 : ℝ) * ‖u‖ ^ 2
  have habs : |a - b| ≤ eta * ‖u‖ ^ 2 := by
    simpa [a, b, phaseNormSq_euclideanToPhase] using
      hconv points hsmooth hspread (euclideanToPhase u)
  have hca : c ≤ a := by
    dsimp [a, c]
    simpa [phaseNormSq_euclideanToPhase] using
      normalizedPhaseCovarianceForm_lower n points (1 / 12)
        (hcov points hsmooth hspread) (euclideanToPhase u)
  have hcb : c ≤ b := by
    dsimp [b, c]
    have hlow := phaseLimitingCovarianceForm_lower (euclideanToPhase u)
    rw [phaseNormSq_euclideanToPhase] at hlow
    nlinarith [sq_nonneg ‖u‖]
  have hexp := abs_exp_neg_half_sub_exp_neg_half_le_with_lower hca hcb
  change ‖(Real.exp (-a / 2) : ℂ) - (Real.exp (-b / 2) : ℂ)‖ ≤ _
  rw [show (Real.exp (-a / 2) : ℂ) - (Real.exp (-b / 2) : ℂ) =
      ((Real.exp (-a / 2) - Real.exp (-b / 2) : ℝ) : ℂ) by push_cast; rfl,
    Complex.norm_real, Real.norm_eq_abs]
  calc
    |Real.exp (-a / 2) - Real.exp (-b / 2)| ≤
        |a - b| / 2 * Real.exp (-c / 2) := hexp
    _ ≤ (eta * ‖u‖ ^ 2) / 2 * Real.exp (-c / 2) := by
      gcongr
    _ = eta / 2 * ‖u‖ ^ 2 * Real.exp (- (‖u‖ ^ 2 / 24)) := by
      dsimp [c]
      congr 2 <;> ring

lemma integrable_phaseFixedGaussian {m : ℕ} :
    Integrable (fun u : PhaseEuclidean m ↦
      Real.exp (- (‖u‖ ^ 2 / 48))) := by
  let sigma : ℝ := Real.sqrt (1 / 24)
  have hsigma : 0 < sigma := by
    dsimp [sigma]
    positivity
  have h := integrable_phaseGaussianRadial m sigma hsigma
  convert h using 1
  funext u
  dsimp [sigma]
  rw [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 1 / 24)]
  congr 1
  ring

lemma sq_mul_exp_neg_div_twentyfour_le
    (x : ℝ) (_hx : 0 ≤ x) :
    x ^ 2 * Real.exp (- (x ^ 2 / 24)) ≤
      48 * Real.exp (- (x ^ 2 / 48)) := by
  let y : ℝ := x ^ 2 / 48
  have hy : 0 ≤ y := by dsimp [y]; positivity
  have hyexp : y ≤ Real.exp y := by
    linarith [Real.add_one_le_exp y]
  have hexp0 : 0 ≤ Real.exp (-2 * y) := (Real.exp_pos _).le
  calc
    x ^ 2 * Real.exp (- (x ^ 2 / 24)) =
        48 * y * Real.exp (-2 * y) := by dsimp [y]; congr 2 <;> ring
    _ ≤ 48 * Real.exp y * Real.exp (-2 * y) := by gcongr
    _ = 48 * Real.exp (-y) := by
      rw [mul_assoc, ← Real.exp_add]
      congr 2 <;> ring
    _ = 48 * Real.exp (- (x ^ 2 / 48)) := by rfl

lemma integrable_phaseNormSq_mul_fixedGaussian {m : ℕ} :
    Integrable (fun u : PhaseEuclidean m ↦
      ‖u‖ ^ 2 * Real.exp (- (‖u‖ ^ 2 / 24))) := by
  have hdom := (integrable_phaseFixedGaussian (m := m)).const_mul 48
  apply hdom.mono'
  · fun_prop
  · filter_upwards [] with u
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (sq_nonneg _) (Real.exp_pos _).le)]
    exact sq_mul_exp_neg_div_twentyfour_le ‖u‖ (norm_nonneg u)

lemma integrable_phaseFourier_limitingGaussian
    {m : ℕ} (sigma : ℝ) (y : PhaseEuclidean m) :
    Integrable (fun u ↦ phaseFourierMultiplier sigma y u *
      normalizedPhaseLimitingGaussian u) := by
  apply (integrable_phaseFixedGaussian (m := m)).mono'
  · exact ((continuous_phaseFourierMultiplier sigma y).mul
      continuous_normalizedPhaseLimitingGaussian).aestronglyMeasurable
  · filter_upwards [] with u
    rw [norm_mul, norm_phaseFourierMultiplier]
    calc
      Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
          ‖normalizedPhaseLimitingGaussian u‖ ≤
          1 * Real.exp (- (‖u‖ ^ 2 / 12)) := by
        gcongr
        · rw [Real.exp_le_one_iff]
          exact mul_nonpos_of_nonpos_of_nonneg
            (neg_nonpos.mpr (div_nonneg (sq_nonneg _) (by norm_num)))
            (sq_nonneg _)
        · exact norm_normalizedPhaseLimitingGaussian_le_fixedGaussian u
      _ ≤ Real.exp (- (‖u‖ ^ 2 / 48)) := by
        rw [one_mul]
        apply Real.exp_le_exp.mpr
        nlinarith [sq_nonneg ‖u‖]

/-- The exact-covariance Gaussian Fourier integral converges uniformly in
the phase point and in every nonnegative smoothing scale. -/
theorem eventually_uniform_phaseCovarianceFourier_convergence
    {m : ℕ} {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ∀ (sigma : ℝ), 0 ≤ sigma → ∀ y : PhaseEuclidean m,
        ‖phaseFourierIntegral sigma y
              (normalizedPhaseCovarianceGaussian n points) -
            phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian‖ < eps := by
  let I : ℝ := ∫ u : PhaseEuclidean m,
    ‖u‖ ^ 2 * Real.exp (- (‖u‖ ^ 2 / 24))
  have hI0 : 0 ≤ I := integral_nonneg fun u ↦
    mul_nonneg (sq_nonneg _) (Real.exp_pos _).le
  let eta : ℝ := eps / (I + 1)
  have heta : 0 < eta := by dsimp [eta]; positivity
  filter_upwards [Nat.eventually_pos,
      eventually_uniform_normalizedPhaseCovarianceGaussian_convergence heta,
      eventually_hasPhaseCovarianceLower_rigidity m]
    with n hn hpoint hcov
  intro points hsmooth hspread sigma hsigma y
  have hfinite : Integrable (fun u ↦ phaseFourierMultiplier sigma y u *
      normalizedPhaseCovarianceGaussian n points u) := by
    apply (integrable_phaseFixedGaussian (m := m)).mono'
    · exact ((continuous_phaseFourierMultiplier sigma y).mul
        (continuous_normalizedPhaseCovarianceGaussian n points)).aestronglyMeasurable
    · filter_upwards [] with u
      rw [norm_mul, norm_phaseFourierMultiplier]
      calc
        Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
            ‖normalizedPhaseCovarianceGaussian n points u‖ ≤
            1 * Real.exp (- (‖u‖ ^ 2 / 24)) := by
          gcongr
          · rw [Real.exp_le_one_iff]
            exact mul_nonpos_of_nonpos_of_nonneg
              (neg_nonpos.mpr (div_nonneg (sq_nonneg _) (by norm_num)))
              (sq_nonneg _)
          · exact norm_normalizedPhaseCovarianceGaussian_le_fixedGaussian
              n points (hcov points hsmooth hspread) u
        _ ≤ Real.exp (- (‖u‖ ^ 2 / 48)) := by
          rw [one_mul]
          apply Real.exp_le_exp.mpr
          nlinarith [sq_nonneg ‖u‖]
  have hlimit := integrable_phaseFourier_limitingGaussian
    (m := m) sigma y
  unfold phaseFourierIntegral
  rw [← integral_sub]
  · calc
      ‖∫ u : PhaseEuclidean m,
          phaseFourierMultiplier sigma y u *
              normalizedPhaseCovarianceGaussian n points u -
            phaseFourierMultiplier sigma y u *
              normalizedPhaseLimitingGaussian u‖ ≤
          ∫ u : PhaseEuclidean m,
            eta / 2 *
              (‖u‖ ^ 2 * Real.exp (- (‖u‖ ^ 2 / 24))) := by
        apply norm_integral_le_of_norm_le
          ((integrable_phaseNormSq_mul_fixedGaussian (m := m)).const_mul (eta / 2))
        filter_upwards [] with u
        rw [← mul_sub, norm_mul, norm_phaseFourierMultiplier]
        calc
          Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) *
              ‖normalizedPhaseCovarianceGaussian n points u -
                normalizedPhaseLimitingGaussian u‖ ≤
              1 * (eta / 2 * ‖u‖ ^ 2 *
                Real.exp (- (‖u‖ ^ 2 / 24))) := by
            gcongr
            · rw [Real.exp_le_one_iff]
              exact mul_nonpos_of_nonpos_of_nonneg
                (neg_nonpos.mpr (div_nonneg (sq_nonneg _) (by norm_num)))
                (sq_nonneg _)
            · exact hpoint points hsmooth hspread u
          _ = eta / 2 *
              (‖u‖ ^ 2 * Real.exp (- (‖u‖ ^ 2 / 24))) := by ring
      _ = eta / 2 * I := by rw [integral_const_mul]
      _ < eps := by
        dsimp [eta]
        have hden : 0 < I + 1 := by positivity
        have hfrac : I / (I + 1) < 1 := (div_lt_one hden).2 (by linarith)
        rw [show eps / (I + 1) / 2 * I = eps / 2 * (I / (I + 1)) by ring]
        have hhalf : 0 < eps / 2 := by positivity
        nlinarith [mul_lt_mul_of_pos_left hfrac hhalf]
  · exact hfinite
  · exact hlimit

noncomputable def phaseLimitingFrequencyWeight (sigma : ℝ) (c : Fin 4) : ℝ :=
  sigma ^ 2 / 2 + if c = 0 ∨ c = 1 then 1 / 4 else 1 / 12

lemma phaseLimitingCovarianceForm_half_eq_sum (u : PhaseCoordinate m) :
    phaseLimitingCovarianceForm u / 2 =
      ∑ r : Fin m, ∑ c : Fin 4,
        phaseLimitingFrequencyWeight 0 c * (u r c) ^ 2 := by
  unfold phaseLimitingCovarianceForm phaseLimitingFrequencyWeight
    phasePositionCoeff phaseVelocityCoeff Complex.normSq
  simp only [Fin.sum_univ_four]
  ring_nf
  simp [Finset.sum_add_distrib]
  rw [add_mul, add_mul]
  simp_rw [Finset.sum_mul]
  ring

lemma phaseLimitingFrequencyWeight_pos (sigma : ℝ) (c : Fin 4) :
    0 < phaseLimitingFrequencyWeight sigma c := by
  unfold phaseLimitingFrequencyWeight
  split_ifs <;> positivity

noncomputable def phaseLimitingFourierValue
    (sigma : ℝ) (y : PhaseEuclidean m) : ℂ :=
  ∏ i : Fin m × Fin 4,
    ((Real.pi : ℂ) / phaseLimitingFrequencyWeight sigma i.2) ^ (1 / 2 : ℂ) *
      Complex.exp (((-Complex.I * (y i : ℂ)) ^ 2) /
        (4 * phaseLimitingFrequencyWeight sigma i.2))

lemma phaseFourierMultiplier_mul_limitingGaussian_eq
    (sigma : ℝ) (y u : PhaseEuclidean m) :
    phaseFourierMultiplier sigma y u * normalizedPhaseLimitingGaussian u =
      Complex.exp
        (-∑ i : Fin m × Fin 4,
            (phaseLimitingFrequencyWeight sigma i.2 : ℂ) * (u i : ℂ) ^ 2 +
          ∑ i : Fin m × Fin 4, (-Complex.I * (y i : ℂ)) * (u i : ℂ)) := by
  rw [phaseFourierMultiplier_eq]
  unfold normalizedPhaseLimitingGaussian
  rw [Complex.ofReal_exp, ← Complex.exp_add, ← Complex.exp_add]
  congr 1
  push_cast
  have hQ := congrArg (fun x : ℝ ↦ (x : ℂ))
    (phaseLimitingCovarianceForm_half_eq_sum (euclideanToPhase u))
  push_cast at hQ
  rw [show -(phaseLimitingCovarianceForm (euclideanToPhase u) : ℂ) / 2 =
      -∑ r : Fin m, ∑ c : Fin 4,
        (phaseLimitingFrequencyWeight 0 c : ℂ) * (u (r, c) : ℂ) ^ 2 by
    calc
      -(phaseLimitingCovarianceForm (euclideanToPhase u) : ℂ) / 2 =
          -((phaseLimitingCovarianceForm (euclideanToPhase u) : ℂ) / 2) := by ring
      _ = _ := congrArg Neg.neg hQ]
  have hnorm := congrArg (fun x : ℝ ↦ (x : ℂ))
    (EuclideanSpace.real_norm_sq_eq u)
  push_cast at hnorm
  have hquad :
      (sigma : ℂ) ^ 2 / 2 * (‖u‖ : ℂ) ^ 2 +
          ∑ r : Fin m, ∑ c : Fin 4,
            (phaseLimitingFrequencyWeight 0 c : ℂ) * (u (r, c) : ℂ) ^ 2 =
        ∑ i : Fin m × Fin 4,
          (phaseLimitingFrequencyWeight sigma i.2 : ℂ) * (u i : ℂ) ^ 2 := by
    rw [hnorm]
    simp_rw [Fintype.sum_prod_type]
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro r _hr
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro c _hc
    unfold phaseLimitingFrequencyWeight
    push_cast
    ring
  have hosc :
      -((⟪u, y⟫ : ℝ) : ℂ) * Complex.I =
        ∑ i : Fin m × Fin 4,
          (-Complex.I * (y i : ℂ)) * (u i : ℂ) := by
    rw [PiLp.inner_apply]
    simp only [Real.inner_apply,
      Fintype.sum_prod_type]
    push_cast
    rw [neg_mul, Finset.sum_mul, ← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro r _hr
    rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro c _hc
    ring
  rw [hosc]
  linear_combination -hquad

/-- Exact evaluation of the smoothed limiting Fourier transform as a
product of one-dimensional Gaussian integrals. -/
lemma phaseFourierIntegral_limitingGaussian
    (sigma : ℝ) (y : PhaseEuclidean m) :
    phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian =
      phaseLimitingFourierValue sigma y := by
  unfold phaseFourierIntegral
  rw [show (fun u : PhaseEuclidean m ↦ phaseFourierMultiplier sigma y u *
      normalizedPhaseLimitingGaussian u) =
      (fun u ↦ Complex.exp
        (-∑ i : Fin m × Fin 4,
            (phaseLimitingFrequencyWeight sigma i.2 : ℂ) * (u i : ℂ) ^ 2 +
          ∑ i : Fin m × Fin 4, (-Complex.I * (y i : ℂ)) * (u i : ℂ))) by
    funext u
    exact phaseFourierMultiplier_mul_limitingGaussian_eq sigma y u]
  rw [← (PiLp.volume_preserving_toLp (Fin m × Fin 4)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ v : Fin m × Fin 4 → ℝ,
    Complex.exp
      (-∑ i : Fin m × Fin 4,
          (phaseLimitingFrequencyWeight sigma i.2 : ℂ) * (v i : ℂ) ^ 2 +
        ∑ i : Fin m × Fin 4, (-Complex.I * (y i : ℂ)) * (v i : ℂ))) = _
  rw [GaussianFourier.integral_cexp_neg_sum_mul_add
    (fun i ↦ by
      change 0 < phaseLimitingFrequencyWeight sigma i.2
      exact phaseLimitingFrequencyWeight_pos sigma i.2)
    (fun i : Fin m × Fin 4 ↦ -Complex.I * (y i : ℂ))]
  rfl

/-- Fully identified uniform local CLT after Gaussian smoothing. -/
theorem eventually_uniform_smoothedPhaseLocalCLT
    {m : ℕ} (hm : 0 < m) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ)
        (sigma : ℝ) (y : PhaseEuclidean m),
      localCLTSmoothingScaleTest n ≤ sigma →
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points sigma y -
        phaseLimitingFourierValue sigma y‖ < eps := by
  have herr : ∀ᶠ n : ℕ in atTop,
      localCLTFourierErrorBoundTest m n < eps / 2 :=
    (localCLTFourierErrorBound_tendsto_zero_test m).eventually
      (Iio_mem_nhds (by linarith))
  filter_upwards [Nat.eventually_pos,
      eventually_smoothedLocalCLT_le_of_smoothingScale hm,
      eventually_uniform_phaseCovarianceFourier_convergence
        (eps := eps / 2) (by linarith),
      herr]
    with n hn hclt hcov herrn
  intro points sigma y hsigma hsmooth hspread
  have hsigma0 : 0 ≤ sigma := by
    have hbase : 0 < localCLTSmoothingScaleTest n := by
      unfold localCLTSmoothingScaleTest
      exact rigidityPower_pos hn _
    exact hbase.le.trans hsigma
  rw [← phaseFourierIntegral_limitingGaussian]
  calc
    ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points sigma y -
        phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian‖ ≤
      ‖((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points sigma y -
        phaseFourierIntegral sigma y
          (normalizedPhaseCovarianceGaussian n points)‖ +
      ‖phaseFourierIntegral sigma y
          (normalizedPhaseCovarianceGaussian n points) -
        phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian‖ := by
      rw [show
        ((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
              ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
            phaseGaussianSmoothedMass n points sigma y -
          phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian =
        (((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
              ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
            phaseGaussianSmoothedMass n points sigma y -
          phaseFourierIntegral sigma y
            (normalizedPhaseCovarianceGaussian n points)) +
        (phaseFourierIntegral sigma y
            (normalizedPhaseCovarianceGaussian n points) -
          phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian) by abel]
      exact norm_add_le _ _
    _ < eps / 2 + eps / 2 := add_lt_add
      ((hclt points sigma y hsigma hsmooth hspread).trans_lt herrn)
      (hcov points hsmooth hspread sigma hsigma0 y)
    _ = eps := by ring

lemma phaseGaussianFourierFactor_eq_real
    {b x : ℝ} (hb : 0 < b) :
    ((Real.pi : ℂ) / (b : ℂ)) ^ (1 / 2 : ℂ) *
        Complex.exp (((-Complex.I * (x : ℂ)) ^ 2) / (4 * (b : ℂ))) =
      ((Real.sqrt (Real.pi / b) * Real.exp (-x ^ 2 / (4 * b)) : ℝ) : ℂ) := by
  have hbase : 0 ≤ Real.pi / b := (div_pos Real.pi_pos hb).le
  have hpow :
      ((Real.pi : ℂ) / (b : ℂ)) ^ (1 / 2 : ℂ) =
        (Real.sqrt (Real.pi / b) : ℂ) := by
    rw [show (Real.pi : ℂ) / (b : ℂ) = ((Real.pi / b : ℝ) : ℂ) by
      push_cast; rfl]
    rw [show (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) by norm_num]
    rw [← Complex.ofReal_cpow hbase]
    congr 1
    rw [Real.sqrt_eq_rpow]
  rw [hpow]
  rw [show ((-Complex.I * (x : ℂ)) ^ 2) / (4 * (b : ℂ)) =
      ((-x ^ 2 / (4 * b) : ℝ) : ℂ) by
    push_cast
    rw [show (-Complex.I * (x : ℂ)) ^ 2 = -((x : ℂ) ^ 2) by
      rw [mul_pow, neg_sq, Complex.I_sq]
      ring]]
  rw [← Complex.ofReal_exp]
  push_cast
  rfl

/-- Product density of the independent circular limiting Gaussian phase
vectors (position variance `1/2`, velocity variance `1/6`). -/
noncomputable def phaseLimitingDensity (y : PhaseEuclidean m) : ℝ :=
  ∏ r : Fin m,
    (3 / Real.pi ^ 2) *
      Real.exp (-(y (r, 0) ^ 2 + y (r, 1) ^ 2) -
        3 * (y (r, 2) ^ 2 + y (r, 3) ^ 2))

lemma phaseLimitingFourierBlock_zero
    (y : PhaseEuclidean m) (r : Fin m) :
    ∏ c : Fin 4,
        ((Real.pi : ℂ) / phaseLimitingFrequencyWeight 0 c) ^ (1 / 2 : ℂ) *
          Complex.exp (((-Complex.I * (y (r, c) : ℂ)) ^ 2) /
            (4 * phaseLimitingFrequencyWeight 0 c)) =
      ((48 * Real.pi ^ 2 *
        Real.exp (-(y (r, 0) ^ 2 + y (r, 1) ^ 2) -
          3 * (y (r, 2) ^ 2 + y (r, 3) ^ 2)) : ℝ) : ℂ) := by
  simp only [Fin.prod_univ_four]
  have h0 : phaseLimitingFrequencyWeight 0 (0 : Fin 4) = (1 / 4 : ℝ) := by
    simp [phaseLimitingFrequencyWeight]
  have h1 : phaseLimitingFrequencyWeight 0 (1 : Fin 4) = (1 / 4 : ℝ) := by
    simp [phaseLimitingFrequencyWeight]
  have h2 : phaseLimitingFrequencyWeight 0 (2 : Fin 4) = (1 / 12 : ℝ) := by
    simp [phaseLimitingFrequencyWeight,
      show (2 : Fin 4) ≠ 0 by decide, show (2 : Fin 4) ≠ 1 by decide]
  have h3 : phaseLimitingFrequencyWeight 0 (3 : Fin 4) = (1 / 12 : ℝ) := by
    simp [phaseLimitingFrequencyWeight,
      show (3 : Fin 4) ≠ 0 by decide, show (3 : Fin 4) ≠ 1 by decide]
  rw [h0, h1, h2, h3]
  rw [phaseGaussianFourierFactor_eq_real (by norm_num : (0 : ℝ) < 1 / 4),
    phaseGaussianFourierFactor_eq_real (by norm_num : (0 : ℝ) < 1 / 4),
    phaseGaussianFourierFactor_eq_real (by norm_num : (0 : ℝ) < 1 / 12),
    phaseGaussianFourierFactor_eq_real (by norm_num : (0 : ℝ) < 1 / 12)]
  norm_cast
  let A : ℝ := Real.sqrt (Real.pi / (1 / 4))
  let B : ℝ := Real.sqrt (Real.pi / (1 / 12))
  have hA : A * A = 4 * Real.pi := by
    dsimp [A]
    rw [Real.mul_self_sqrt (by positivity : 0 ≤ Real.pi / (1 / 4))]
    ring
  have hB : B * B = 12 * Real.pi := by
    dsimp [B]
    rw [Real.mul_self_sqrt (by positivity : 0 ≤ Real.pi / (1 / 12))]
    ring
  change
    (A * Real.exp (-y (r, 0) ^ 2 / (4 * (1 / 4))) *
      (A * Real.exp (-y (r, 1) ^ 2 / (4 * (1 / 4))))) *
      (B * Real.exp (-y (r, 2) ^ 2 / (4 * (1 / 12)))) *
        (B * Real.exp (-y (r, 3) ^ 2 / (4 * (1 / 12)))) = _
  rw [show
      (A * Real.exp (-y (r, 0) ^ 2 / (4 * (1 / 4))) *
        (A * Real.exp (-y (r, 1) ^ 2 / (4 * (1 / 4))))) *
        (B * Real.exp (-y (r, 2) ^ 2 / (4 * (1 / 12)))) *
          (B * Real.exp (-y (r, 3) ^ 2 / (4 * (1 / 12)))) =
      (A * A) * (B * B) *
        (Real.exp (-y (r, 0) ^ 2 / (4 * (1 / 4))) *
          Real.exp (-y (r, 1) ^ 2 / (4 * (1 / 4))) *
          Real.exp (-y (r, 2) ^ 2 / (4 * (1 / 12))) *
          Real.exp (-y (r, 3) ^ 2 / (4 * (1 / 12)))) by ring,
    hA, hB]
  rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
  rw [show (4 * Real.pi) * (12 * Real.pi) = 48 * Real.pi ^ 2 by ring]
  congr 1
  ring

/-- Fourier inversion at zero smoothing gives the explicit limiting
Gaussian density, including the full `(2π)^(4m)` normalization. -/
lemma phaseLimitingFourierValue_zero_eq_density
    (y : PhaseEuclidean m) :
    phaseLimitingFourierValue 0 y =
      ((2 * Real.pi : ℂ) ^ (4 * m) * phaseLimitingDensity y) := by
  unfold phaseLimitingFourierValue
  rw [Fintype.prod_prod_type]
  simp_rw [phaseLimitingFourierBlock_zero]
  unfold phaseLimitingDensity
  norm_cast
  let E : Fin m → ℝ := fun r ↦
    Real.exp (-(y (r, 0) ^ 2 + y (r, 1) ^ 2) -
      3 * (y (r, 2) ^ 2 + y (r, 3) ^ 2))
  change (∏ r : Fin m, 48 * Real.pi ^ 2 * E r) =
    (2 * Real.pi) ^ (4 * m) * ∏ r : Fin m, 3 / Real.pi ^ 2 * E r
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  rw [show (∏ r : Fin m, 48 * Real.pi ^ 2 * E r) =
      ∏ r : Fin m, (2 * Real.pi) ^ 4 * (3 / Real.pi ^ 2 * E r) by
    apply Finset.prod_congr rfl
    intro r _hr
    field_simp
    ring]
  rw [Finset.prod_mul_distrib]
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [pow_mul]

noncomputable def phaseLimitingSmoothingError {m : ℕ} (sigma : ℝ) : ℝ :=
  ∫ u : PhaseEuclidean m,
    |Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) - 1| *
      Real.exp (- (‖u‖ ^ 2 / 12))

lemma integrable_phaseLimitingEnvelope {m : ℕ} :
    Integrable (fun u : PhaseEuclidean m ↦
      Real.exp (- (‖u‖ ^ 2 / 12))) := by
  apply (integrable_phaseFixedGaussian (m := m)).mono'
  · fun_prop
  · filter_upwards [] with u
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    apply Real.exp_le_exp.mpr
    nlinarith [sq_nonneg ‖u‖]

lemma abs_exp_neg_sq_mul_sub_one_le_one (sigma x : ℝ) :
    |Real.exp (-(sigma ^ 2 / 2) * x ^ 2) - 1| ≤ 1 := by
  have hexp : Real.exp (-(sigma ^ 2 / 2) * x ^ 2) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    exact mul_nonpos_of_nonpos_of_nonneg
      (neg_nonpos.mpr (div_nonneg (sq_nonneg _) (by norm_num))) (sq_nonneg _)
  rw [abs_of_nonpos (sub_nonpos.mpr hexp)]
  linarith [Real.exp_pos (-(sigma ^ 2 / 2) * x ^ 2)]

lemma phaseLimitingSmoothingError_tendsto_zero {m : ℕ} :
    Tendsto (phaseLimitingSmoothingError (m := m)) (nhds 0) (nhds 0) := by
  let F : ℝ → PhaseEuclidean m → ℝ := fun sigma u ↦
    |Real.exp (-(sigma ^ 2 / 2) * ‖u‖ ^ 2) - 1| *
      Real.exp (- (‖u‖ ^ 2 / 12))
  have hcont : ContinuousAt (fun sigma : ℝ ↦ ∫ u : PhaseEuclidean m, F sigma u) 0 := by
    apply continuousAt_of_dominated
      (bound := fun u : PhaseEuclidean m ↦ Real.exp (- (‖u‖ ^ 2 / 12)))
    · exact Eventually.of_forall fun sigma ↦ (by fun_prop)
    · exact Eventually.of_forall fun sigma ↦ Eventually.of_forall fun u ↦ by
        dsimp [F]
        rw [abs_of_nonneg
          (mul_nonneg (abs_nonneg _) (Real.exp_pos _).le)]
        exact mul_le_of_le_one_left (Real.exp_nonneg _)
          (abs_exp_neg_sq_mul_sub_one_le_one sigma ‖u‖)
    · exact integrable_phaseLimitingEnvelope
    · exact Eventually.of_forall fun u ↦ (by dsimp [F]; fun_prop)
  have heq : phaseLimitingSmoothingError (m := m) =
      (fun sigma : ℝ ↦ ∫ u : PhaseEuclidean m, F sigma u) := by
    funext sigma
    unfold phaseLimitingSmoothingError
    apply integral_congr_ae
    filter_upwards [] with u
    dsimp [F]
  rw [heq]
  simpa [F] using hcont.tendsto

/-- Uniformly in the spatial phase point, removing Gaussian smoothing from
the limiting inverse transform costs at most an explicit scalar error. -/
lemma norm_phaseFourierIntegral_limiting_sub_zero_le
    (sigma : ℝ) (y : PhaseEuclidean m) :
    ‖phaseFourierIntegral sigma y normalizedPhaseLimitingGaussian -
        phaseFourierIntegral 0 y normalizedPhaseLimitingGaussian‖ ≤
      phaseLimitingSmoothingError (m := m) sigma := by
  unfold phaseFourierIntegral
  rw [← integral_sub
    (integrable_phaseFourier_limitingGaussian sigma y)
    (integrable_phaseFourier_limitingGaussian 0 y)]
  apply norm_integral_le_of_norm_le
  · apply (integrable_phaseLimitingEnvelope (m := m)).mono'
    · fun_prop
    · filter_upwards [] with u
      rw [Real.norm_eq_abs, abs_of_nonneg
        (mul_nonneg (abs_nonneg _) (Real.exp_pos _).le)]
      simpa using mul_le_mul_of_nonneg_right
        (abs_exp_neg_sq_mul_sub_one_le_one sigma ‖u‖)
        (Real.exp_pos _).le
  · filter_upwards [] with u
    rw [show phaseFourierMultiplier sigma y u * normalizedPhaseLimitingGaussian u -
        phaseFourierMultiplier 0 y u * normalizedPhaseLimitingGaussian u =
      (phaseFourierMultiplier sigma y u - phaseFourierMultiplier 0 y u) *
        normalizedPhaseLimitingGaussian u by ring,
      norm_mul]
    unfold phaseFourierMultiplier
    norm_num
    let A : ℂ := Complex.exp (-((sigma : ℂ) ^ 2 / 2 * (‖u‖ : ℂ) ^ 2))
    let B : ℂ := Complex.exp (-(((⟪u, y⟫ : ℝ) : ℂ) * Complex.I))
    change ‖A * B - B‖ * ‖normalizedPhaseLimitingGaussian u‖ ≤ _
    rw [show A * B - B = (A - 1) * B by ring,
      norm_mul]
    have him : (-(((⟪u, y⟫ : ℝ) : ℂ) * Complex.I)).re = 0 := by simp
    dsimp [B]
    rw [Complex.norm_exp, him]
    rw [Real.exp_zero, mul_one]
    dsimp [A]
    rw [show Complex.exp (-((sigma : ℂ) ^ 2 / 2 * (‖u‖ : ℂ) ^ 2)) - 1 =
      ((Real.exp (-(sigma ^ 2 / 2 * ‖u‖ ^ 2)) - 1 : ℝ) : ℂ) by
        rw [show -((sigma : ℂ) ^ 2 / 2 * (‖u‖ : ℂ) ^ 2) =
          ((-(sigma ^ 2 / 2 * ‖u‖ ^ 2) : ℝ) : ℂ) by push_cast; rfl]
        rw [← Complex.ofReal_exp]
        push_cast
        rfl,
      Complex.norm_real, Real.norm_eq_abs]
    calc
      |Real.exp (-(sigma ^ 2 / 2 * ‖u‖ ^ 2)) - 1| *
          ‖normalizedPhaseLimitingGaussian u‖ ≤
        |Real.exp (-(sigma ^ 2 / 2 * ‖u‖ ^ 2)) - 1| *
          Real.exp (- (‖u‖ ^ 2 / 12)) :=
        mul_le_mul_of_nonneg_left
          (norm_normalizedPhaseLimitingGaussian_le_fixedGaussian u) (abs_nonneg _)
      _ = _ := rfl

lemma localCLTSmoothingScaleTest_tendsto_zero :
    Tendsto localCLTSmoothingScaleTest atTop (nhds 0) := by
  convert tendsto_rigidityPower_neg_zero (show (0 : ℝ) < 2 by norm_num) using 1
  funext n
  unfold localCLTSmoothingScaleTest
  congr 1

/-- Uniform Gaussian-kernel local CLT with the limiting density explicitly
identified and the smoothing radius fixed to the source-scale sequence. -/
theorem eventually_uniform_smoothedPhaseDensity
    {m : ℕ} (hm : 0 < m) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ)
        (y : PhaseEuclidean m),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ‖((Real.pi : ℂ) /
            (((localCLTSmoothingScaleTest n) ^ 2 / 2 : ℝ) : ℂ)) ^
            ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
          phaseGaussianSmoothedMass n points
            (localCLTSmoothingScaleTest n) y -
        ((2 * Real.pi : ℂ) ^ (4 * m) * phaseLimitingDensity y)‖ < eps := by
  have hsmoothErr : ∀ᶠ n : ℕ in atTop,
      phaseLimitingSmoothingError (m := m) (localCLTSmoothingScaleTest n) < eps / 2 :=
    ((phaseLimitingSmoothingError_tendsto_zero (m := m)).comp
      localCLTSmoothingScaleTest_tendsto_zero).eventually
        (Iio_mem_nhds (by linarith))
  filter_upwards [eventually_uniform_smoothedPhaseLocalCLT hm (eps := eps / 2)
      (by linarith), hsmoothErr]
    with n hclt hsmoothErrn
  intro points y hsmooth hspread
  let sigma := localCLTSmoothingScaleTest n
  let A : ℂ := ((Real.pi : ℂ) / ((sigma ^ 2 / 2 : ℝ) : ℂ)) ^
      ((Module.finrank ℝ (PhaseEuclidean m) : ℂ) / 2) *
        phaseGaussianSmoothedMass n points sigma y
  let B : ℂ := phaseLimitingFourierValue sigma y
  let C : ℂ := (2 * Real.pi : ℂ) ^ (4 * m) * phaseLimitingDensity y
  have hAB : ‖A - B‖ < eps / 2 := by
    exact hclt points sigma y le_rfl hsmooth hspread
  have hBC : ‖B - C‖ ≤ phaseLimitingSmoothingError (m := m) sigma := by
    dsimp [B, C]
    rw [← phaseFourierIntegral_limitingGaussian sigma y,
      ← phaseLimitingFourierValue_zero_eq_density,
      ← phaseFourierIntegral_limitingGaussian 0 y]
    exact norm_phaseFourierIntegral_limiting_sub_zero_le sigma y
  change ‖A - C‖ < eps
  calc
    ‖A - C‖ ≤ ‖A - B‖ + ‖B - C‖ := by
      rw [show A - C = (A - B) + (B - C) by abel]
      exact norm_add_le _ _
    _ < eps / 2 + eps / 2 := add_lt_add hAB
      (hBC.trans_lt (by simpa [sigma] using hsmoothErrn))
    _ = eps := by ring

/-- Lebesgue density of the normalized phase walk after convolution with
an isotropic Gaussian of standard deviation `sigma`. -/
noncomputable def phaseSmoothedDensity (n : ℕ) (points : Fin m → ℝ)
    (sigma : ℝ) (y : PhaseEuclidean m) : ℝ :=
  ((2 * Real.pi / sigma ^ 2) ^ (2 * m) *
      phaseGaussianSmoothedMassReal n points sigma y) /
    (2 * Real.pi) ^ (4 * m)

/-- The source-scale Gaussian convolution has a density converging uniformly
to the explicit limiting Gaussian density, uniformly over smooth and spread
point configurations. -/
theorem eventually_uniform_phaseSmoothedDensity
    {m : ℕ} (hm : 0 < m) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ (points : Fin m → ℝ)
        (y : PhaseEuclidean m),
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      |phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y -
        phaseLimitingDensity y| < eps := by
  let K : ℝ := (2 * Real.pi) ^ (4 * m)
  have hK : 0 < K := by positivity
  filter_upwards [Nat.eventually_pos,
      eventually_uniform_smoothedPhaseDensity hm (eps := eps * K)
        (mul_pos heps hK)]
    with n hn hclt
  intro points y hsmooth hspread
  have hsigma : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  have h := hclt points y hsmooth hspread
  rw [phaseFourierNormalization_eq_real m _ hsigma,
    phaseGaussianSmoothedMass_eq_real] at h
  norm_cast at h
  change |(((2 * Real.pi / localCLTSmoothingScaleTest n ^ 2) ^ (2 * m) *
      phaseGaussianSmoothedMassReal n points (localCLTSmoothingScaleTest n) y) /
      K) - phaseLimitingDensity y| < eps
  rw [show
      ((2 * Real.pi / localCLTSmoothingScaleTest n ^ 2) ^ (2 * m) *
          phaseGaussianSmoothedMassReal n points (localCLTSmoothingScaleTest n) y) /
          K - phaseLimitingDensity y =
        (((2 * Real.pi / localCLTSmoothingScaleTest n ^ 2) ^ (2 * m) *
          phaseGaussianSmoothedMassReal n points (localCLTSmoothingScaleTest n) y) -
            K * phaseLimitingDensity y) / K by field_simp]
  rw [abs_div, abs_of_pos hK, div_lt_iff₀ hK]
  simpa [K] using h

/-- The centered isotropic Gaussian density used to perturb the discrete
phase walk. -/
noncomputable def phaseGaussianKernel (m : ℕ) (sigma : ℝ)
    (x : PhaseEuclidean m) : ℝ :=
  ((2 * Real.pi / sigma ^ 2) ^ (2 * m) /
      (2 * Real.pi) ^ (4 * m)) *
    Real.exp (-(‖x‖ ^ 2 / (2 * sigma ^ 2)))

lemma phaseGaussianKernel_nonneg (m : ℕ) (sigma : ℝ)
    (x : PhaseEuclidean m) : 0 ≤ phaseGaussianKernel m sigma x := by
  unfold phaseGaussianKernel
  positivity

lemma integrable_phaseGaussianKernel (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    Integrable (phaseGaussianKernel m sigma) := by
  unfold phaseGaussianKernel
  apply Integrable.const_mul
  convert integrable_rexp_neg_mul_norm_sq m (1 / (2 * sigma ^ 2)) (by positivity)
    using 1
  funext x
  congr 1
  ring

lemma integrable_phaseGaussianKernel_sub_left
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) (x : PhaseEuclidean m) :
    Integrable (fun y : PhaseEuclidean m ↦ phaseGaussianKernel m sigma (x - y)) := by
  have h := (integrable_phaseGaussianKernel m sigma hsigma).comp_sub_right x
  apply h.congr
  filter_upwards [] with y
  unfold phaseGaussianKernel
  rw [show x - y = -(y - x) by abel, norm_neg]

lemma integral_phaseGaussianKernel (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    ∫ x : PhaseEuclidean m, phaseGaussianKernel m sigma x = 1 := by
  unfold phaseGaussianKernel
  rw [integral_const_mul]
  have hgauss := GaussianFourier.integral_rexp_neg_mul_sq_norm
    (V := PhaseEuclidean m) (b := 1 / (2 * sigma ^ 2)) (by positivity)
  rw [show (fun x : PhaseEuclidean m ↦
      Real.exp (-(‖x‖ ^ 2 / (2 * sigma ^ 2)))) =
      (fun x ↦ Real.exp (-(1 / (2 * sigma ^ 2)) * ‖x‖ ^ 2)) by
        funext x
        congr 1
        ring]
  rw [hgauss, finrank_phaseEuclidean]
  rw [show ((4 * m : ℕ) : ℝ) / 2 = (2 * m : ℕ) by push_cast; ring,
    Real.rpow_natCast]
  have hsigma0 : sigma ≠ 0 := hsigma.ne'
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  field_simp
  rw [← mul_pow]
  rw [show 2 * Real.pi / sigma ^ 2 * (2 * Real.pi * sigma ^ 2) =
      (2 * Real.pi) ^ 2 by field_simp]
  rw [← pow_mul]
  congr 1
  omega

lemma phaseSmoothedDensity_eq_expectation_kernel
    (n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) (y : PhaseEuclidean m) :
    phaseSmoothedDensity n points sigma y =
      uniformExpectation (fun e : SignVector (2 * n) ↦
        phaseGaussianKernel m sigma
          (normalizedPhaseEuclideanWalk n e points - y)) := by
  unfold phaseSmoothedDensity phaseGaussianSmoothedMassReal
  rw [div_eq_mul_inv]
  calc
    (2 * Real.pi / sigma ^ 2) ^ (2 * m) *
          uniformExpectation (fun e : SignVector (2 * n) ↦
            Real.exp (-(‖normalizedPhaseEuclideanWalk n e points - y‖ ^ 2 /
              (2 * sigma ^ 2)))) * ((2 * Real.pi) ^ (4 * m))⁻¹ =
        (((2 * Real.pi) ^ (4 * m))⁻¹ *
          (2 * Real.pi / sigma ^ 2) ^ (2 * m)) *
            uniformExpectation (fun e : SignVector (2 * n) ↦
              Real.exp (-(‖normalizedPhaseEuclideanWalk n e points - y‖ ^ 2 /
                (2 * sigma ^ 2)))) := by ring
    _ = uniformExpectation (fun e : SignVector (2 * n) ↦
          (((2 * Real.pi) ^ (4 * m))⁻¹ *
            (2 * Real.pi / sigma ^ 2) ^ (2 * m)) *
              Real.exp (-(‖normalizedPhaseEuclideanWalk n e points - y‖ ^ 2 /
                (2 * sigma ^ 2)))) :=
      (uniformExpectation_const_mul _ _).symm
    _ = uniformExpectation (fun e : SignVector (2 * n) ↦
        phaseGaussianKernel m sigma
          (normalizedPhaseEuclideanWalk n e points - y)) := by
      apply congrArg uniformExpectation
      funext e
      unfold phaseGaussianKernel
      ring

/-- Integrating the smoothed phase density over a set is exactly the average
Gaussian mass contributed there by every point of the finite phase walk. -/
lemma integral_phaseSmoothedDensity
    (n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) (hsigma : 0 < sigma)
    (s : Set (PhaseEuclidean m)) :
    (∫ y : PhaseEuclidean m in s, phaseSmoothedDensity n points sigma y) =
      uniformExpectation (fun e : SignVector (2 * n) ↦
        ∫ y : PhaseEuclidean m in s,
          phaseGaussianKernel m sigma
            (normalizedPhaseEuclideanWalk n e points - y)) := by
  simp_rw [phaseSmoothedDensity_eq_expectation_kernel]
  unfold uniformExpectation
  rw [integral_div]
  rw [integral_finsetSum]
  · intro e _he
    exact (integrable_phaseGaussianKernel_sub_left m sigma hsigma
      (normalizedPhaseEuclideanWalk n e points)).integrableOn

/-- An integrable Gaussian envelope with twice the covariance of
`phaseGaussianKernel`; it provides a dimension-explicit tail estimate. -/
noncomputable def phaseGaussianWideEnvelope (m : ℕ) (sigma : ℝ)
    (x : PhaseEuclidean m) : ℝ :=
  ((2 * Real.pi / sigma ^ 2) ^ (2 * m) /
      (2 * Real.pi) ^ (4 * m)) *
    Real.exp (-(‖x‖ ^ 2 / (4 * sigma ^ 2)))

lemma phaseGaussianWideEnvelope_nonneg (m : ℕ) (sigma : ℝ)
    (x : PhaseEuclidean m) : 0 ≤ phaseGaussianWideEnvelope m sigma x := by
  unfold phaseGaussianWideEnvelope
  positivity

lemma integrable_phaseGaussianWideEnvelope
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    Integrable (phaseGaussianWideEnvelope m sigma) := by
  unfold phaseGaussianWideEnvelope
  apply Integrable.const_mul
  convert integrable_rexp_neg_mul_norm_sq m (1 / (4 * sigma ^ 2)) (by positivity)
    using 1
  funext x
  congr 1
  ring

lemma integral_phaseGaussianWideEnvelope
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) :
    ∫ x : PhaseEuclidean m, phaseGaussianWideEnvelope m sigma x =
      2 ^ (2 * m) := by
  unfold phaseGaussianWideEnvelope
  rw [integral_const_mul]
  have hgauss := GaussianFourier.integral_rexp_neg_mul_sq_norm
    (V := PhaseEuclidean m) (b := 1 / (4 * sigma ^ 2)) (by positivity)
  rw [show (fun x : PhaseEuclidean m ↦
      Real.exp (-(‖x‖ ^ 2 / (4 * sigma ^ 2)))) =
      (fun x ↦ Real.exp (-(1 / (4 * sigma ^ 2)) * ‖x‖ ^ 2)) by
        funext x
        congr 1
        ring]
  rw [hgauss, finrank_phaseEuclidean]
  rw [show ((4 * m : ℕ) : ℝ) / 2 = (2 * m : ℕ) by push_cast; ring,
    Real.rpow_natCast]
  have hsigma0 : sigma ≠ 0 := hsigma.ne'
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  field_simp
  rw [← mul_pow]
  rw [show 2 * Real.pi / sigma ^ 2 * (Real.pi * sigma ^ 2 * 4) =
      2 * (2 * Real.pi) ^ 2 by field_simp; norm_num]
  rw [mul_pow, ← pow_mul]
  rw [show 2 * (2 * m) = 4 * m by omega]
  ring

lemma phaseGaussianKernel_le_tailEnvelope
    (m : ℕ) (sigma r : ℝ) (hsigma : 0 < sigma)
    (hr : 0 ≤ r) (x : PhaseEuclidean m) (hx : r ≤ ‖x‖) :
    phaseGaussianKernel m sigma x ≤
      Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) *
        phaseGaussianWideEnvelope m sigma x := by
  unfold phaseGaussianKernel phaseGaussianWideEnvelope
  have hcoeff : 0 ≤ (2 * Real.pi / sigma ^ 2) ^ (2 * m) /
      (2 * Real.pi) ^ (4 * m) := by positivity
  have hsquares : r ^ 2 ≤ ‖x‖ ^ 2 := by
    nlinarith [norm_nonneg x]
  have hexp : Real.exp (-(‖x‖ ^ 2 / (2 * sigma ^ 2))) ≤
      Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) *
        Real.exp (-(‖x‖ ^ 2 / (4 * sigma ^ 2))) := by
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have hden : 0 < 4 * sigma ^ 2 := by positivity
    have hquot := div_le_div_of_nonneg_right hsquares hden.le
    have hneg := neg_le_neg hquot
    calc
      -(‖x‖ ^ 2 / (2 * sigma ^ 2)) =
          -(‖x‖ ^ 2 / (4 * sigma ^ 2)) +
            -(‖x‖ ^ 2 / (4 * sigma ^ 2)) := by field_simp; ring
      _ ≤ -(r ^ 2 / (4 * sigma ^ 2)) +
            -(‖x‖ ^ 2 / (4 * sigma ^ 2)) := add_le_add hneg le_rfl
  calc
    _ ≤ ((2 * Real.pi / sigma ^ 2) ^ (2 * m) /
          (2 * Real.pi) ^ (4 * m)) *
        (Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) *
          Real.exp (-(‖x‖ ^ 2 / (4 * sigma ^ 2)))) :=
      mul_le_mul_of_nonneg_left hexp hcoeff
    _ = _ := by ring

lemma phaseGaussianKernel_tail_le
    (m : ℕ) (sigma r : ℝ) (hsigma : 0 < sigma) (hr : 0 ≤ r) :
    (∫ x : PhaseEuclidean m in {x | r ≤ ‖x‖},
        phaseGaussianKernel m sigma x) ≤
      2 ^ (2 * m) * Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) := by
  let tail : Set (PhaseEuclidean m) := {x | r ≤ ‖x‖}
  let g : PhaseEuclidean m → ℝ := fun x ↦
    Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) *
      phaseGaussianWideEnvelope m sigma x
  have hkernel := integrable_phaseGaussianKernel m sigma hsigma
  have hg : Integrable g :=
    (integrable_phaseGaussianWideEnvelope m sigma hsigma).const_mul _
  calc
    (∫ x : PhaseEuclidean m in tail, phaseGaussianKernel m sigma x) ≤
        ∫ x : PhaseEuclidean m in tail, g x := by
      apply setIntegral_mono_on hkernel.integrableOn hg.integrableOn
        (by dsimp [tail]; exact measurableSet_le measurable_const continuous_norm.measurable)
      intro x hx
      exact phaseGaussianKernel_le_tailEnvelope m sigma r hsigma hr x hx
    _ ≤ ∫ x : PhaseEuclidean m, g x :=
      setIntegral_le_integral hg (Eventually.of_forall fun x ↦ by
        dsimp [g]
        exact mul_nonneg (Real.exp_pos _).le
          (phaseGaussianWideEnvelope_nonneg m sigma x))
    _ = _ := by
      dsimp [g]
      rw [integral_const_mul, integral_phaseGaussianWideEnvelope m sigma hsigma]
      ring

lemma integral_ball_phaseGaussianKernel_sub_left
    (m : ℕ) (sigma : ℝ) (_hsigma : 0 < sigma)
    (x : PhaseEuclidean m) (r : ℝ) :
    (∫ y : PhaseEuclidean m in Metric.ball x r,
        phaseGaussianKernel m sigma (x - y)) =
      ∫ z : PhaseEuclidean m in Metric.ball 0 r,
        phaseGaussianKernel m sigma z := by
  let f : PhaseEuclidean m → ℝ := fun z ↦
    (Metric.ball (0 : PhaseEuclidean m) r).indicator
      (phaseGaussianKernel m sigma) z
  have htrans := MeasureTheory.integral_sub_right_eq_self
    (μ := volume) f x
  rw [← integral_indicator Metric.isOpen_ball.measurableSet]
  rw [← integral_indicator Metric.isOpen_ball.measurableSet]
  rw [← htrans]
  apply integral_congr_ae
  filter_upwards [] with y
  dsimp [f]
  by_cases hy : y ∈ Metric.ball x r
  · rw [Set.indicator_of_mem hy]
    have hy' : y - x ∈ Metric.ball (0 : PhaseEuclidean m) r := by
      simpa only [Metric.mem_ball, dist_zero_right, dist_eq_norm, sub_zero] using hy
    rw [Set.indicator_of_mem hy']
    unfold phaseGaussianKernel
    rw [show x - y = -(y - x) by abel, norm_neg]
  · rw [Set.indicator_of_notMem hy]
    have hy' : y - x ∉ Metric.ball (0 : PhaseEuclidean m) r := by
      simpa only [Metric.mem_ball, dist_zero_right, dist_eq_norm, sub_zero] using hy
    rw [Set.indicator_of_notMem hy']

lemma phaseGaussianKernel_ball_lower
    (m : ℕ) (sigma r : ℝ) (hsigma : 0 < sigma) (hr : 0 ≤ r) :
    1 - 2 ^ (2 * m) * Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) ≤
      ∫ x : PhaseEuclidean m in Metric.ball 0 r,
        phaseGaussianKernel m sigma x := by
  have hsplit := integral_add_compl
    (s := Metric.ball (0 : PhaseEuclidean m) r)
    Metric.isOpen_ball.measurableSet
    (integrable_phaseGaussianKernel m sigma hsigma)
  rw [integral_phaseGaussianKernel m sigma hsigma] at hsplit
  have hcompl : (Metric.ball (0 : PhaseEuclidean m) r)ᶜ =
      {x | r ≤ ‖x‖} := by
    ext x
    simp [Metric.mem_ball]
  rw [hcompl] at hsplit
  have htail := phaseGaussianKernel_tail_le m sigma r hsigma hr
  linarith

lemma uniformProbability_mul_eq_expectation_indicator
    {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P : Ω → Prop) (c : ℝ) :
    uniformProbability P * c =
      uniformExpectation (fun omega ↦ if P omega then c else 0) := by
  rw [← uniformExpectation_indicator]
  calc
    uniformExpectation (fun omega ↦ if P omega then (1 : ℝ) else 0) * c =
        c * uniformExpectation (fun omega ↦ if P omega then (1 : ℝ) else 0) :=
      mul_comm _ _
    _ = uniformExpectation (fun omega ↦
          c * (if P omega then (1 : ℝ) else 0)) :=
      (uniformExpectation_const_mul _ _).symm
    _ = _ := by
      apply congrArg uniformExpectation
      funext omega
      by_cases h : P omega <;> simp [h]

lemma uniformExpectation_add_real
    {Ω : Type*} [Fintype Ω] [Nonempty Ω] (X Y : Ω → ℝ) :
    uniformExpectation (fun omega ↦ X omega + Y omega) =
      uniformExpectation X + uniformExpectation Y := by
  unfold uniformExpectation
  rw [Finset.sum_add_distrib, add_div]

lemma uniformExpectation_const_real
    {Ω : Type*} [Fintype Ω] [Nonempty Ω] (c : ℝ) :
    uniformExpectation (fun _ : Ω ↦ c) = c := by
  unfold uniformExpectation
  simp

lemma uniformProbability_mul_ballMass_le_integral_thickening
    (n : ℕ) (points : Fin m → ℝ) (sigma r : ℝ) (hsigma : 0 < sigma)
    (s : Set (PhaseEuclidean m)) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        normalizedPhaseEuclideanWalk n e points ∈ s) *
        (∫ x : PhaseEuclidean m in Metric.ball 0 r,
          phaseGaussianKernel m sigma x) ≤
      ∫ y : PhaseEuclidean m in Metric.thickening r s,
        phaseSmoothedDensity n points sigma y := by
  rw [integral_phaseSmoothedDensity n points sigma hsigma]
  rw [uniformProbability_mul_eq_expectation_indicator]
  apply uniformExpectation_mono
  intro e
  by_cases he : normalizedPhaseEuclideanWalk n e points ∈ s
  · rw [if_pos he]
    rw [← integral_ball_phaseGaussianKernel_sub_left m sigma hsigma
      (normalizedPhaseEuclideanWalk n e points) r]
    apply setIntegral_mono_set
    · exact (integrable_phaseGaussianKernel_sub_left m sigma hsigma
        (normalizedPhaseEuclideanWalk n e points)).integrableOn
    · exact Eventually.of_forall fun y ↦
        phaseGaussianKernel_nonneg m sigma
          (normalizedPhaseEuclideanWalk n e points - y)
    · exact Eventually.of_forall fun y hy ↦ by
        change y ∈ Metric.thickening r s
        rw [Metric.mem_thickening_iff]
        exact ⟨normalizedPhaseEuclideanWalk n e points, he, hy⟩
  · rw [if_neg he]
    exact integral_nonneg fun y ↦ phaseGaussianKernel_nonneg m sigma _

lemma uniformProbability_mul_gaussianLower_le_integral_thickening
    (n : ℕ) (points : Fin m → ℝ) (sigma r : ℝ)
    (hsigma : 0 < sigma) (hr : 0 ≤ r) (s : Set (PhaseEuclidean m)) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        normalizedPhaseEuclideanWalk n e points ∈ s) *
        (1 - 2 ^ (2 * m) * Real.exp (-(r ^ 2 / (4 * sigma ^ 2)))) ≤
      ∫ y : PhaseEuclidean m in Metric.thickening r s,
        phaseSmoothedDensity n points sigma y := by
  calc
    _ ≤ uniformProbability (fun e : SignVector (2 * n) ↦
          normalizedPhaseEuclideanWalk n e points ∈ s) *
        (∫ x : PhaseEuclidean m in Metric.ball 0 r,
          phaseGaussianKernel m sigma x) :=
      mul_le_mul_of_nonneg_left
        (phaseGaussianKernel_ball_lower m sigma r hsigma hr)
        (uniformProbability_nonneg _)
    _ ≤ _ := uniformProbability_mul_ballMass_le_integral_thickening
      n points sigma r hsigma s

lemma integral_phaseGaussianKernel_sub_left
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) (x : PhaseEuclidean m) :
    (∫ y : PhaseEuclidean m, phaseGaussianKernel m sigma (x - y)) = 1 := by
  calc
    (∫ y : PhaseEuclidean m, phaseGaussianKernel m sigma (x - y)) =
        ∫ y : PhaseEuclidean m, phaseGaussianKernel m sigma (y - x) := by
      apply integral_congr_ae
      filter_upwards [] with y
      unfold phaseGaussianKernel
      rw [show x - y = -(y - x) by abel, norm_neg]
    _ = ∫ y : PhaseEuclidean m, phaseGaussianKernel m sigma y :=
      MeasureTheory.integral_sub_right_eq_self _ x
    _ = 1 := integral_phaseGaussianKernel m sigma hsigma

lemma integral_phaseGaussianWideEnvelope_sub_left
    (m : ℕ) (sigma : ℝ) (hsigma : 0 < sigma) (x : PhaseEuclidean m) :
    (∫ y : PhaseEuclidean m, phaseGaussianWideEnvelope m sigma (x - y)) =
      2 ^ (2 * m) := by
  calc
    (∫ y : PhaseEuclidean m, phaseGaussianWideEnvelope m sigma (x - y)) =
        ∫ y : PhaseEuclidean m, phaseGaussianWideEnvelope m sigma (y - x) := by
      apply integral_congr_ae
      filter_upwards [] with y
      unfold phaseGaussianWideEnvelope
      rw [show x - y = -(y - x) by abel, norm_neg]
    _ = ∫ y : PhaseEuclidean m, phaseGaussianWideEnvelope m sigma y :=
      MeasureTheory.integral_sub_right_eq_self _ x
    _ = 2 ^ (2 * m) := integral_phaseGaussianWideEnvelope m sigma hsigma

lemma integral_gaussianKernel_innerErosion_le_of_not_mem
    (m : ℕ) (sigma r : ℝ) (hsigma : 0 < sigma) (hr : 0 ≤ r)
    (s : Set (PhaseEuclidean m)) (x : PhaseEuclidean m) (hx : x ∉ s) :
    (∫ y : PhaseEuclidean m in (Metric.thickening r sᶜ)ᶜ,
        phaseGaussianKernel m sigma (x - y)) ≤
      2 ^ (2 * m) * Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) := by
  let inner : Set (PhaseEuclidean m) := (Metric.thickening r sᶜ)ᶜ
  let g : PhaseEuclidean m → ℝ := fun y ↦
    Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) *
      phaseGaussianWideEnvelope m sigma (x - y)
  have hkernel := integrable_phaseGaussianKernel_sub_left m sigma hsigma x
  have hwide : Integrable (fun y : PhaseEuclidean m ↦
      phaseGaussianWideEnvelope m sigma (x - y)) := by
    have h := (integrable_phaseGaussianWideEnvelope m sigma hsigma).comp_sub_right x
    apply h.congr
    filter_upwards [] with y
    unfold phaseGaussianWideEnvelope
    rw [show x - y = -(y - x) by abel, norm_neg]
  have hg : Integrable g := hwide.const_mul _
  have hxcompl : x ∈ sᶜ := hx
  calc
    (∫ y : PhaseEuclidean m in inner,
        phaseGaussianKernel m sigma (x - y)) ≤
        ∫ y : PhaseEuclidean m in inner, g y := by
      apply setIntegral_mono_on hkernel.integrableOn hg.integrableOn
        (Metric.isOpen_thickening.measurableSet.compl)
      intro y hy
      have hdist : r ≤ ‖x - y‖ := by
        have hnot : ¬ dist y x < r := by
          intro hlt
          exact hy (Metric.mem_thickening_iff.mpr ⟨x, hxcompl, hlt⟩)
        have hle : r ≤ dist y x := le_of_not_gt hnot
        simpa only [dist_eq_norm, norm_sub_rev] using hle
      exact phaseGaussianKernel_le_tailEnvelope m sigma r hsigma hr (x - y) hdist
    _ ≤ ∫ y : PhaseEuclidean m, g y :=
      setIntegral_le_integral hg (Eventually.of_forall fun y ↦ by
        dsimp [g]
        exact mul_nonneg (Real.exp_pos _).le
          (phaseGaussianWideEnvelope_nonneg m sigma (x - y)))
    _ = _ := by
      dsimp [g]
      rw [integral_const_mul,
        integral_phaseGaussianWideEnvelope_sub_left m sigma hsigma x]
      ring

/-- The smoothed mass of the inner erosion of a set is at most the discrete
probability of that set plus an explicit Gaussian displacement tail. -/
lemma integral_innerErosion_phaseSmoothedDensity_le
    (n : ℕ) (points : Fin m → ℝ) (sigma r : ℝ)
    (hsigma : 0 < sigma) (hr : 0 ≤ r) (s : Set (PhaseEuclidean m)) :
    (∫ y : PhaseEuclidean m in (Metric.thickening r sᶜ)ᶜ,
        phaseSmoothedDensity n points sigma y) ≤
      uniformProbability (fun e : SignVector (2 * n) ↦
          normalizedPhaseEuclideanWalk n e points ∈ s) +
        2 ^ (2 * m) * Real.exp (-(r ^ 2 / (4 * sigma ^ 2))) := by
  rw [integral_phaseSmoothedDensity n points sigma hsigma]
  let tail : ℝ := 2 ^ (2 * m) * Real.exp (-(r ^ 2 / (4 * sigma ^ 2)))
  calc
    uniformExpectation (fun e : SignVector (2 * n) ↦
        ∫ y : PhaseEuclidean m in (Metric.thickening r sᶜ)ᶜ,
          phaseGaussianKernel m sigma
            (normalizedPhaseEuclideanWalk n e points - y)) ≤
      uniformExpectation (fun e : SignVector (2 * n) ↦
        (if normalizedPhaseEuclideanWalk n e points ∈ s then (1 : ℝ) else 0) +
          tail) := by
      apply uniformExpectation_mono
      intro e
      by_cases he : normalizedPhaseEuclideanWalk n e points ∈ s
      · rw [if_pos he]
        calc
          _ ≤ ∫ y : PhaseEuclidean m,
              phaseGaussianKernel m sigma
                (normalizedPhaseEuclideanWalk n e points - y) :=
            setIntegral_le_integral
              (integrable_phaseGaussianKernel_sub_left m sigma hsigma _)
              (Eventually.of_forall fun y ↦ phaseGaussianKernel_nonneg m sigma _)
          _ = 1 := integral_phaseGaussianKernel_sub_left m sigma hsigma _
          _ ≤ 1 + tail := by
            dsimp [tail]
            exact le_add_of_nonneg_right (mul_nonneg (by positivity) (Real.exp_pos _).le)
      · rw [if_neg he, zero_add]
        exact integral_gaussianKernel_innerErosion_le_of_not_mem
          m sigma r hsigma hr s _ he
    _ = uniformProbability (fun e : SignVector (2 * n) ↦
          normalizedPhaseEuclideanWalk n e points ∈ s) + tail := by
      rw [uniformExpectation_add_real]
      rw [uniformExpectation_indicator, uniformExpectation_const_real]
    _ = _ := rfl

/-- Quantitative high-frequency separation for a unit phase-space direction.
All choices used in the Cook--Nguyen argument are made inside the proof:
Dirichlet approximation, smooth target propagation, individual reflected-mode
dilations, the Markov good block, exact unwrapping, and `ℓ²` isolation.  The
two alternatives correspond to the large position/velocity coefficient
pigeonhole. -/
theorem phaseLatticeEnergy_high_frequency_dichotomy
    (n m Q L q k W H : ℕ)
    (hn : 0 < n) (hm : 0 < m) (hQ : 0 < Q)
    (hL : 800 ≤ L) (hq : 800 ≤ q) (hW : 0 < W) (hH : 0 < H)
    (K lam ε a t E J : ℝ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hu : phaseNormSq u = 1)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hQK : Q ^ (2 * m) ≤ Nat.floor K + 1)
    (hε0 : 0 ≤ ε) (hεsmall : ε < 1 / 16)
    (hscale : 4000 * ε / L ≤ K / n)
    (ha : 0 < a) (ht : t ≠ 0)
    (henergy : phaseLatticeEnergy n points u t ≤ E)
    (hblock : (W : ℝ) * (E / a ^ 2 + 1) ≤ 2 * n + 1)
    (hfit : 2 * H + 2 * (phaseTwistCount m * q) +
        2 * k * (L * Q ^ (2 * m)) ≤ W)
    (hJ : 0 ≤ J) (hJsize : (n : ℝ) ≤ J * H)
    (hunwrap :
      (|t| / Real.pi) *
          ((4 * m : ℕ) *
            (phaseDirichletEta L Q ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k *
                ((L * Q ^ (2 * m) : ℕ) : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (hdeltaOne :
      individualDilationGap q (min (K / n) (lam / n)) ≤ 1)
    (hcorr :
      2 * (4 : ℝ) ^ (phaseTwistCount m) *
          ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
          ((phaseTwistCount m * q : ℕ) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) *
            ((L * Q ^ (2 * m) : ℕ) : ℝ) / n) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m) ≤
      (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
          individualDilationGap q (min (K / n) (lam / n)) ^
            (2 * phaseTwistCount m)) / 2) :
    phaseHighPositionDemand m H k (phaseTwistCount m) ε
        (individualDilationGap q (min (K / n) (lam / n))) ≤
        phaseHighPositionBudget t E J (phaseTwistCount m) k ∨
      phaseHighVelocityDemand n m H k (phaseTwistCount m) ε
        (individualDilationGap q (min (K / n) (lam / n))) ≤
        phaseHighVelocityBudget t E (phaseTwistCount m) k := by
  let rho : ℝ := min (K / n) (lam / n)
  let delta : ℝ := individualDilationGap q rho
  let eta : ℝ := phaseDirichletEta L Q
  let ell : ℕ := phaseTwistCount m
  have hrho' : 0 < rho := by simpa [rho] using hrho
  have hdeltaPos : 0 < delta := by
    dsimp [delta, individualDilationGap]
    have hqreal : (0 : ℝ) < q := by exact_mod_cast (lt_of_lt_of_le (by norm_num) hq)
    positivity
  have hdelta0 : 0 ≤ delta := hdeltaPos.le
  have hdelta1 : delta ≤ 1 := by simpa [delta, rho] using hdeltaOne
  have heta0 : 0 ≤ eta := by
    dsimp [eta, phaseDirichletEta]
    positivity
  rcases exists_scaledPhase_good_block_of_energy_le
      n W points u t a E hW ha henergy hblock with ⟨s, hs, hgood⟩
  have hsle : s ≤ 2 * n := by omega
  have hjbase : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ (n : ℝ) := by
    have hsreal : (s : ℝ) ≤ 2 * (n : ℝ) := by exact_mod_cast hsle
    simp only [Int.cast_sub, Int.cast_natCast]
    rw [abs_le]
    constructor <;> linarith
  have hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H :=
    hjbase.trans hJsize
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge⟩
  let target : ReflectedMode m := (r, true)
  have hsmoothTarget : IsSmooth n K (reflectedModeTime points target) := by
    simpa [target, reflectedModeTime] using hsmooth r
  rcases exists_reflectedDirichletStep_with_targetGap
      n m Q L hn hQ points target K ε hsmoothTarget hQK hL
        hε0 hεsmall hscale with
    ⟨q₀, hq₀1, hq₀Bound, htarget, hdirichlet⟩
  have hdist : ∀ b : ReflectedMode m, b ≠ target →
      rho ≤ distanceToInteger
        ((reflectedModeTime points target - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
    intro b hbt
    simpa [rho] using reflectedMode_distance_lower
      n hn K lam points hsmooth hspread target b hbt.symm
  rcases exists_variableReflectedSteps n hn points target q hq rho hrho' hdist with
    ⟨step, hstep, hsep⟩
  let twists := variableReflectedTwists n points step target
  have hlen : twists.length = ell := by
    simpa [twists, ell, phaseTwistCount] using
      variableReflectedTwists_length n points step target
  have hsum : variableStepSum twists ≤ ell * q := by
    have hs' := variableReflectedTwists_stepSum_le n points step target q
      (fun b hbt ↦ (hstep b hbt).2.le)
    simpa [twists, ell, phaseTwistCount] using hs'
  have hspan : variableTwistSpan twists ≤ 2 * (ell * q) := by
    rw [variableTwistSpan_eq_two_mul_stepSum]
    omega
  have hfitActual : 2 * H + variableTwistSpan twists + 2 * k * q₀ ≤ W := by
    have hfit' : 2 * H + 2 * (ell * q) +
        2 * k * (L * Q ^ (2 * m)) ≤ W := by
      simpa [ell] using hfit
    have hqmul : 2 * k * q₀ ≤ 2 * k * (L * Q ^ (2 * m)) :=
      Nat.mul_le_mul_left (2 * k) hq₀Bound
    calc
      2 * H + variableTwistSpan twists + 2 * k * q₀ ≤
          2 * H + 2 * (ell * q) + 2 * k * q₀ := by omega
      _ ≤ 2 * H + 2 * (ell * q) + 2 * k * (L * Q ^ (2 * m)) := by omega
      _ ≤ W := hfit'
  have hl1 := phaseL1_le_of_phaseNormSq_eq_one u hu
  have hetaPow : eta ^ (2 * k) =
      phaseDirichletEta L Q ^ (2 * k) := by rfl
  have hq₀Real : (q₀ : ℝ) ≤ (L * Q ^ (2 * m) : ℕ) := by
    exact_mod_cast hq₀Bound
  have hunwrapActual :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1 := by
    apply lt_of_le_of_lt _ hunwrap
    have hinside :
        (∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (eta ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n) ≤
          ((4 * m : ℕ) : ℝ) *
            (phaseDirichletEta L Q ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k *
                ((L * Q ^ (2 * m) : ℕ) : ℝ) / n) := by
      have hsecond :
          (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n ≤
            (k : ℝ) * (4 : ℝ) ^ k *
              ((L * Q ^ (2 * m) : ℕ) : ℝ) / n := by gcongr
      have hl1' : (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤
          ((4 * m : ℕ) : ℝ) := by
        convert hl1 using 1 <;> push_cast <;> ring
      rw [hetaPow]
      exact mul_le_mul hl1' (add_le_add le_rfl hsecond)
        (by positivity) (by positivity)
    have htfac : 0 ≤ |t| / Real.pi := by positivity
    exact add_le_add (mul_le_mul_of_nonneg_left hinside htfac) le_rfl
  have hdirichlet' : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ eta := by
    simpa [eta, phaseDirichletEta] using hdirichlet
  have hsep' : ∀ b : ReflectedMode m, b ≠ target →
      delta ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖ := by
    simpa [delta, rho] using hsep
  rcases hlarge with hpos | hvel
  · left
    have hA := sqrt_one_div_eight_mul_le_reflectedPositionCoeff_true
      hm u hu r hpos
    have hB := norm_reflectedVelocityCoeff_true_le_half_of_phaseNormSq_eq_one
      u hu r
    have hchordUpper :
        ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ≤ 2 := by
      calc
        ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ≤
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ)‖ + ‖(1 : ℂ)‖ :=
          norm_sub_le _ _
        _ = 2 := by norm_num [norm_complexWave]
    have hchordPow :
        ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
            (2 * k) ≤ (2 : ℝ) ^ (2 * k) :=
      pow_le_pow_left₀ (norm_nonneg _) hchordUpper _
    have hsumReal : (variableStepSum twists : ℝ) ≤
        ((ell * q : ℕ) : ℝ) := by exact_mod_cast hsum
    have hcorrActual :
        2 * (4 : ℝ) ^ twists.length *
            (‖reflectedVelocityCoeff u target‖ *
              ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
                (2 * k)) *
            (variableStepSum twists : ℝ) / n +
          ((k : ℝ) * (4 : ℝ) ^ k *
              ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
            delta ^ (2 * twists.length) ≤
        (Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
          delta ^ (2 * twists.length)) / 2 := by
      have hleft :
          2 * (4 : ℝ) ^ twists.length *
              (‖reflectedVelocityCoeff u target‖ *
                ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
                  (2 * k)) *
              (variableStepSum twists : ℝ) / n +
            ((k : ℝ) * (4 : ℝ) ^ k *
                ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
              delta ^ (2 * twists.length) ≤
          2 * (4 : ℝ) ^ ell *
              ((1 / 2 : ℝ) * (2 : ℝ) ^ (2 * k)) *
              ((ell * q : ℕ) : ℝ) / n +
            ((k : ℝ) * (4 : ℝ) ^ k * (1 / 2 : ℝ) *
                ((L * Q ^ (2 * m) : ℕ) : ℝ) / n) *
              delta ^ (2 * ell) := by
        rw [hlen]
        have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
        gcongr
      rw [hlen] at hleft ⊢
      exact hleft.trans (by
        convert hcorr using 1 <;>
          simp only [delta, rho, ell] <;> ring)
    have hforce := goodBlock_largePosition_forces_latticeEnergy
      n hn points u t ht q₀ k eta heta0 hdirichlet'
      s W hs a ha.le hgood step r delta hdelta0
      (by simpa [target] using hsep') H hH J hJ hj
      (by simpa [twists, target] using hfitActual) hunwrapActual
      (Real.sqrt (1 / (8 * (m : ℝ)))) ε (Real.sqrt_nonneg _) hε0
      (by simpa [target] using hA) (by simpa [target] using htarget.le)
      (by simpa [twists, target] using hcorrActual)
    have hbudget :
        (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
            (variableReflectedTwists n points step (r, true)).length *
          ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
            phaseLatticeEnergy n points u t) ≤
        (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
            (variableReflectedTwists n points step (r, true)).length *
          ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E) := by
      gcongr
    have hforce' := hforce.trans hbudget
    rw [show (variableReflectedTwists n points step (r, true)).length = ell by
      simpa [twists, target] using hlen] at hforce'
    simpa [phaseHighPositionDemand, phaseHighPositionBudget, delta, rho,
      ell] using hforce'
  · right
    have hforce := goodBlock_largeVelocity_forces_latticeEnergy
      n hn points u t ht q₀ k eta heta0 hdirichlet'
      s W hs a ha.le hgood step r delta hdelta0
      (by simpa [target] using hsep') H hH
      (by simpa [twists, target] using hfitActual) hunwrapActual
      (1 / (2 * (m : ℝ))) ε (by positivity) hε0
      (by simpa [hu] using hvel) (by simpa [target] using htarget.le)
    have hbudget :
        2 * (36 : ℝ) ^
            (variableReflectedTwists n points step (r, true)).length *
          ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
            phaseLatticeEnergy n points u t) ≤
        2 * (36 : ℝ) ^
            (variableReflectedTwists n points step (r, true)).length *
          ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E) := by
      gcongr
    have hforce' := hforce.trans hbudget
    rw [show (variableReflectedTwists n points step (r, true)).length = ell by
      simpa [twists, target] using hlen] at hforce'
    convert hforce' using 1 <;>
      (try dsimp only [phaseHighVelocityDemand, phaseHighVelocityBudget, delta,
        rho, ell])
    all_goals first | rfl | ring

/-- Abstract final step of the high-frequency argument: if the small-energy
case forces one of two inequalities, and both are numerically impossible,
then the exact characteristic-function product has exponential decay. -/
theorem norm_projectedPhaseWalk_charFun_high_frequency_of_dichotomy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t T positionDemand positionBudget velocityDemand velocityBudget : ℝ)
    (hdichotomy : phaseLatticeEnergy n points u t ≤ T →
      positionDemand ≤ positionBudget ∨ velocityDemand ≤ velocityBudget)
    (hposition : positionBudget < positionDemand)
    (hvelocity : velocityBudget < velocityDemand) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤ Real.exp (-T) := by
  by_cases henergy : T ≤ phaseLatticeEnergy n points u t
  · exact norm_projectedPhaseWalk_charFun_le_exp_neg
      n points u t T henergy
  · rcases hdichotomy (le_of_not_ge henergy) with hpos | hvel
    · exact (not_le_of_gt hposition hpos).elim
    · exact (not_le_of_gt hvelocity hvel).elim

noncomputable def phaseCovarianceGap (n : ℕ) (K lam : ℝ) : ℝ :=
  4 * min (K / n) (lam / n)

noncomputable def phaseCovarianceDenominator (n m : ℕ) : ℝ :=
  let L := phaseTwistCount m
  let F : ℝ := (4 : ℝ) ^ L
  32 * (m : ℝ) * F ^ 2 * (n : ℝ) ^ 2 +
    8 * (m : ℝ) * (1 + 2 * (L : ℝ)) ^ 2 * F ^ 4

/-- An explicit (coarse but positive) lower-covariance constant obtained by
the complete twisted-difference argument. -/
noncomputable def phaseCovarianceGamma (n m : ℕ) (K lam : ℝ) : ℝ :=
  phaseCovarianceGap n K lam ^ (8 * phaseTwistCount m) /
    (phaseCovarianceDenominator n m * (2 * n + 1 : ℝ))

lemma phaseCovarianceDenominator_pos (n m : ℕ) (hn : 0 < n) (hm : 0 < m) :
    0 < phaseCovarianceDenominator n m := by
  unfold phaseCovarianceDenominator
  dsimp only
  positivity

/-- Quantitative nondegeneracy of the phase-step covariance on smooth,
spread tuples.  This closes the deterministic covariance lemma used in the
low-frequency Fourier estimate. -/
theorem hasPhaseCovarianceLower_of_smooth_spread
    (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (K lam : ℝ) (points : Fin m → ℝ)
    (hK : 0 ≤ K) (hlam : 0 ≤ lam)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hsize : 4 * m ≤ n)
    (hgapPos : 0 < phaseCovarianceGap n K lam)
    (hgapOne : phaseCovarianceGap n K lam ≤ 1) :
    HasPhaseCovarianceLower n points
      (phaseCovarianceGamma n m K lam) := by
  intro u
  let L : ℕ := phaseTwistCount m
  let delta : ℝ := phaseCovarianceGap n K lam
  let F : ℝ := (4 : ℝ) ^ L
  let S : ℝ := phaseNormSq u
  let E : ℝ :=
    ∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2
  let d : ℝ := delta ^ (2 * L)
  let Dv : ℝ := 32 * (m : ℝ) * F ^ 2 * (n : ℝ) ^ 2
  let Dp : ℝ := 8 * (m : ℝ) * (1 + 2 * (L : ℝ)) ^ 2 * F ^ 4
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hS : 0 ≤ S := phaseNormSq_nonneg u
  have hE : 0 ≤ E := Finset.sum_nonneg fun k _ ↦ sq_nonneg _
  have hdelta0 : 0 ≤ delta := hgapPos.le
  have hd0 : 0 ≤ d := pow_nonneg hdelta0 _
  have hd1 : d ≤ 1 := pow_le_one₀ hdelta0 hgapOne
  have hF1 : 1 ≤ F := by
    dsimp [F]
    exact one_le_pow₀ (by norm_num)
  have hDv0 : 0 ≤ Dv := by positivity
  have hDp0 : 0 ≤ Dp := by positivity
  have hDpos : 0 < Dv + Dp := by positivity
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge | hlarge⟩
  · let a : ℝ := ‖reflectedPositionCoeff u (r, true)‖
    let b : ℝ := ‖reflectedVelocityCoeff u (r, true)‖
    have ha : S / (8 * (m : ℝ)) ≤ a ^ 2 := by
      calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phasePositionCoeff u r) / 4 :=
          div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = a ^ 2 := by
          symm
          simpa [a] using norm_reflectedPositionCoeff_true_sq u r
    have hvel0 := reflectedVelocityCoeff_energy_bound n hn K lam points
      hK hlam hsmooth hspread (by omega) u (r, true)
    have hvel : b * d / (n : ℝ) ≤ 2 * F * Real.sqrt E := by
      convert hvel0 using 1 <;>
        simp [b, d, delta, F, E, L, phaseCovarianceGap,
          phaseTwistCount, reflectedTwists_length] <;> ring
    have hpos0 := reflectedPositionCoeff_energy_bound n hn K lam points
      hK hlam hsmooth hspread hsize u (r, true)
    have hpos : a * d ≤ F * Real.sqrt E + (L : ℝ) * F * b / (n : ℝ) := by
      simpa [a, b, d, delta, F, E, L, phaseCovarianceGap,
        phaseTwistCount, reflectedTwists_length] using hpos0
    have hcore := position_energy_algebra (m : ℝ) (n : ℝ) (L : ℝ)
      S E a b d F hmreal hnreal (Nat.cast_nonneg L) hE ha
      (norm_nonneg _) (norm_nonneg _) hd0 hd1 hF1 hvel hpos
    have huniform : d ^ 4 * S ≤ (Dv + Dp) * E := by
      calc
        d ^ 4 * S ≤ Dp * E := by simpa [Dp] using hcore
        _ ≤ (Dv + Dp) * E := by
          exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hDv0) hE
    have hleft : phaseCovarianceGamma n m K lam *
          (2 * n + 1 : ℝ) * phaseNormSq u = d ^ 4 * S / (Dv + Dp) := by
      have hcount : (2 * n + 1 : ℝ) ≠ 0 := by positivity
      have hpow : phaseCovarianceGap n K lam ^ (8 * phaseTwistCount m) =
          d ^ 4 := by
        dsimp [d, delta, L]
        rw [← pow_mul]
        congr 1
        omega
      have hden : phaseCovarianceDenominator n m = Dv + Dp := by
        simp [phaseCovarianceDenominator, Dv, Dp, F, L, phaseTwistCount]
      rw [phaseCovarianceGamma, hden, hpow]
      field_simp
      ring
    rw [hleft]
    exact (div_le_iff₀ hDpos).2 (by simpa [mul_comm] using huniform)

  · let b : ℝ := ‖reflectedVelocityCoeff u (r, true)‖
    have hb : S / (8 * (m : ℝ)) ≤ b ^ 2 := by
      calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phaseVelocityCoeff u r) / 4 :=
          div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = b ^ 2 := by
          symm
          simpa [b] using norm_reflectedVelocityCoeff_true_sq u r
    have hvel0 := reflectedVelocityCoeff_energy_bound n hn K lam points
      hK hlam hsmooth hspread (by omega) u (r, true)
    have hvel : b * d / (n : ℝ) ≤ 2 * F * Real.sqrt E := by
      convert hvel0 using 1 <;>
        simp [b, d, delta, F, E, L, phaseCovarianceGap,
          phaseTwistCount, reflectedTwists_length] <;> ring
    have hcore := velocity_energy_algebra (m : ℝ) (n : ℝ)
      S E b d F hmreal hnreal hE hb (norm_nonneg _) hd0
      (le_trans (by norm_num) hF1) hvel
    have hd4le : d ^ 4 * S ≤ d ^ 2 * S := by
      have hdSq : d ^ 2 ≤ 1 := pow_le_one₀ hd0 hd1
      have hd4 : d ^ 4 ≤ d ^ 2 := by
        calc
          d ^ 4 = d ^ 2 * d ^ 2 := by ring
          _ ≤ d ^ 2 * 1 := mul_le_mul_of_nonneg_left hdSq (sq_nonneg d)
          _ = d ^ 2 := by ring
      exact mul_le_mul_of_nonneg_right hd4 hS
    have huniform : d ^ 4 * S ≤ (Dv + Dp) * E := by
      calc
        d ^ 4 * S ≤ d ^ 2 * S := hd4le
        _ ≤ Dv * E := by simpa [Dv] using hcore
        _ ≤ (Dv + Dp) * E := by
          exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hDp0) hE
    have hleft : phaseCovarianceGamma n m K lam *
          (2 * n + 1 : ℝ) * phaseNormSq u = d ^ 4 * S / (Dv + Dp) := by
      have hcount : (2 * n + 1 : ℝ) ≠ 0 := by positivity
      have hpow : phaseCovarianceGap n K lam ^ (8 * phaseTwistCount m) =
          d ^ 4 := by
        dsimp [d, delta, L]
        rw [← pow_mul]
        congr 1
        omega
      have hden : phaseCovarianceDenominator n m = Dv + Dp := by
        simp [phaseCovarianceDenominator, Dv, Dp, F, L, phaseTwistCount]
      rw [phaseCovarianceGamma, hden, hpow]
      field_simp
      ring
    rw [hleft]
    exact (div_le_iff₀ hDpos).2 (by simpa [mul_comm] using huniform)

/-- Denominator in the covariance bound after using a dilation step `h`. -/
noncomputable def phaseCovarianceDenominatorAt (n m h : ℕ) : ℝ :=
  let L := phaseTwistCount m
  let F : ℝ := (4 : ℝ) ^ L
  32 * (m : ℝ) * F ^ 2 * (n : ℝ) ^ 2 +
    8 * (m : ℝ) * (1 + 2 * ((L * h : ℕ) : ℝ)) ^ 2 * F ^ 4

noncomputable def phaseCovarianceGammaAt
    (n m h : ℕ) (δ : ℝ) : ℝ :=
  δ ^ (8 * phaseTwistCount m) /
    (phaseCovarianceDenominatorAt n m h * (2 * n + 1 : ℝ))

lemma phaseCovarianceDenominatorAt_pos
    (n m h : ℕ) (hn : 0 < n) (hm : 0 < m) :
    0 < phaseCovarianceDenominatorAt n m h := by
  unfold phaseCovarianceDenominatorAt
  dsimp only
  positivity

/-- The deterministic covariance lemma in the exact form needed after a
simultaneous dilation: pairwise chord separation at one fitting step implies
a homogeneous positive lower bound for the whole phase matrix. -/
theorem hasPhaseCovarianceLower_of_reflectedSeparatedAt
    (n m h : ℕ) (hn : 0 < n) (hm : 0 < m)
    (points : Fin m → ℝ) (δ : ℝ)
    (hδpos : 0 < δ) (hδone : δ ≤ 1)
    (hsep : ReflectedSeparatedAt n points h δ)
    (hfit : 2 * phaseTwistCount m * h ≤ n) :
    HasPhaseCovarianceLower n points
      (phaseCovarianceGammaAt n m h δ) := by
  intro u
  let L : ℕ := phaseTwistCount m
  let F : ℝ := (4 : ℝ) ^ L
  let S : ℝ := phaseNormSq u
  let E : ℝ :=
    ∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2
  let d : ℝ := δ ^ (2 * L)
  let Dv : ℝ := 32 * (m : ℝ) * F ^ 2 * (n : ℝ) ^ 2
  let Dp : ℝ :=
    8 * (m : ℝ) * (1 + 2 * ((L * h : ℕ) : ℝ)) ^ 2 * F ^ 4
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hS : 0 ≤ S := phaseNormSq_nonneg u
  have hE : 0 ≤ E := Finset.sum_nonneg fun k _ ↦ sq_nonneg _
  have hδ0 : 0 ≤ δ := hδpos.le
  have hd0 : 0 ≤ d := pow_nonneg hδ0 _
  have hd1 : d ≤ 1 := pow_le_one₀ hδ0 hδone
  have hF1 : 1 ≤ F := by
    dsimp [F]
    exact one_le_pow₀ (by norm_num)
  have hDv0 : 0 ≤ Dv := by positivity
  have hDp0 : 0 ≤ Dp := by positivity
  have hDpos : 0 < Dv + Dp := by positivity
  have hfitVel : 2 * (2 * m - 1) * h + 1 ≤ 2 * n := by
    have hL : phaseTwistCount m = 2 * m - 1 := rfl
    rw [hL] at hfit
    omega
  have hfitPos : 2 * (2 * m - 1) * h ≤ n := by
    simpa [phaseTwistCount] using hfit
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge | hlarge⟩
  · let a : ℝ := ‖reflectedPositionCoeff u (r, true)‖
    let b : ℝ := ‖reflectedVelocityCoeff u (r, true)‖
    have ha : S / (8 * (m : ℝ)) ≤ a ^ 2 := by
      calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phasePositionCoeff u r) / 4 :=
          div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = a ^ 2 := by
          symm
          simpa [a] using norm_reflectedPositionCoeff_true_sq u r
    have hvel0 := reflectedVelocityCoeff_energy_bound_at n hn points h δ
      hδ0 hsep hfitVel u (r, true)
    have hvel : b * d / (n : ℝ) ≤ 2 * F * Real.sqrt E := by
      convert hvel0 using 1 <;>
        simp [b, d, F, E, L, phaseTwistCount,
          reflectedTwistsAt_length, Nat.mul_comm] <;> ring
    have hpos0 := reflectedPositionCoeff_energy_bound_at n hn points h δ
      hδ0 hsep hfitPos u (r, true)
    have hpos : a * d ≤ F * Real.sqrt E +
        ((L * h : ℕ) : ℝ) * F * b / (n : ℝ) := by
      convert hpos0 using 1 <;>
        simp [a, b, d, F, E, L, reflectedTwistsAt_length,
          phaseTwistCount, Nat.cast_mul, Nat.mul_comm] <;> ring
    have hcore := position_energy_algebra (m : ℝ) (n : ℝ)
      ((L * h : ℕ) : ℝ) S E a b d F hmreal hnreal
      (Nat.cast_nonneg (L * h)) hE ha
      (norm_nonneg _) (norm_nonneg _) hd0 hd1 hF1 hvel hpos
    have huniform : d ^ 4 * S ≤ (Dv + Dp) * E := by
      calc
        d ^ 4 * S ≤ Dp * E := by simpa [Dp] using hcore
        _ ≤ (Dv + Dp) * E := by
          exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hDv0) hE
    have hleft : phaseCovarianceGammaAt n m h δ *
          (2 * n + 1 : ℝ) * phaseNormSq u = d ^ 4 * S / (Dv + Dp) := by
      have hpow : δ ^ (8 * phaseTwistCount m) = d ^ 4 := by
        dsimp [d, L]
        rw [← pow_mul]
        congr 1
        omega
      have hden : phaseCovarianceDenominatorAt n m h = Dv + Dp := by
        simp [phaseCovarianceDenominatorAt, Dv, Dp, F, L,
          phaseTwistCount]
      rw [phaseCovarianceGammaAt, hden, hpow]
      field_simp
      ring
    rw [hleft]
    exact (div_le_iff₀ hDpos).2 (by simpa [mul_comm] using huniform)
  · let b : ℝ := ‖reflectedVelocityCoeff u (r, true)‖
    have hb : S / (8 * (m : ℝ)) ≤ b ^ 2 := by
      calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phaseVelocityCoeff u r) / 4 :=
          div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = b ^ 2 := by
          symm
          simpa [b] using norm_reflectedVelocityCoeff_true_sq u r
    have hvel0 := reflectedVelocityCoeff_energy_bound_at n hn points h δ
      hδ0 hsep hfitVel u (r, true)
    have hvel : b * d / (n : ℝ) ≤ 2 * F * Real.sqrt E := by
      convert hvel0 using 1 <;>
        simp [b, d, F, E, L, phaseTwistCount,
          reflectedTwistsAt_length, Nat.mul_comm] <;> ring
    have hcore := velocity_energy_algebra (m : ℝ) (n : ℝ)
      S E b d F hmreal hnreal hE hb (norm_nonneg _) hd0
      (le_trans (by norm_num) hF1) hvel
    have hd4le : d ^ 4 * S ≤ d ^ 2 * S := by
      have hdSq : d ^ 2 ≤ 1 := pow_le_one₀ hd0 hd1
      have hd4 : d ^ 4 ≤ d ^ 2 := by
        calc
          d ^ 4 = d ^ 2 * d ^ 2 := by ring
          _ ≤ d ^ 2 * 1 := mul_le_mul_of_nonneg_left hdSq (sq_nonneg d)
          _ = d ^ 2 := by ring
      exact mul_le_mul_of_nonneg_right hd4 hS
    have huniform : d ^ 4 * S ≤ (Dv + Dp) * E := by
      calc
        d ^ 4 * S ≤ d ^ 2 * S := hd4le
        _ ≤ Dv * E := by simpa [Dv] using hcore
        _ ≤ (Dv + Dp) * E := by
          exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hDp0) hE
    have hleft : phaseCovarianceGammaAt n m h δ *
          (2 * n + 1 : ℝ) * phaseNormSq u = d ^ 4 * S / (Dv + Dp) := by
      have hpow : δ ^ (8 * phaseTwistCount m) = d ^ 4 := by
        dsimp [d, L]
        rw [← pow_mul]
        congr 1
        omega
      have hden : phaseCovarianceDenominatorAt n m h = Dv + Dp := by
        simp [phaseCovarianceDenominatorAt, Dv, Dp, F, L,
          phaseTwistCount]
      rw [phaseCovarianceGammaAt, hden, hpow]
      field_simp
      ring
    rw [hleft]
    exact (div_le_iff₀ hDpos).2 (by simpa [mul_comm] using huniform)

lemma phaseCovarianceGammaAt_pos
    (n m h : ℕ) (hn : 0 < n) (hm : 0 < m) (δ : ℝ)
    (hδ : 0 < δ) :
    0 < phaseCovarianceGammaAt n m h δ := by
  unfold phaseCovarianceGammaAt
  exact div_pos (pow_pos hδ _)
    (mul_pos (phaseCovarianceDenominatorAt_pos n m h hn hm) (by positivity))

/-- Uniform denominator for the covariance argument when each reflected
mode is isolated at its own step below `q`. -/
noncomputable def phaseCovarianceDenominatorVariable
    (n m q : ℕ) : ℝ :=
  let L := phaseTwistCount m
  let F : ℝ := (4 : ℝ) ^ L
  32 * (m : ℝ) * F ^ 2 * (n : ℝ) ^ 2 +
    8 * (m : ℝ) * (1 + 2 * ((2 * (L * q) : ℕ) : ℝ)) ^ 2 * F ^ 4

noncomputable def phaseCovarianceGammaVariable
    (n m q : ℕ) (δ : ℝ) : ℝ :=
  δ ^ (8 * phaseTwistCount m) /
    (phaseCovarianceDenominatorVariable n m q * (2 * n + 1 : ℝ))

lemma phaseCovarianceDenominatorVariable_pos
    (n m q : ℕ) (hn : 0 < n) (hm : 0 < m) :
    0 < phaseCovarianceDenominatorVariable n m q := by
  unfold phaseCovarianceDenominatorVariable
  dsimp only
  positivity

lemma phaseCovarianceGammaVariable_pos
    (n m q : ℕ) (hn : 0 < n) (hm : 0 < m) (δ : ℝ)
    (hδ : 0 < δ) :
    0 < phaseCovarianceGammaVariable n m q δ := by
  unfold phaseCovarianceGammaVariable
  exact div_pos (pow_pos hδ _)
    (mul_pos (phaseCovarianceDenominatorVariable_pos n m q hn hm)
      (by positivity))

/-- Complete deterministic covariance bound using individual dilation.
Unlike simultaneous dilation, only one-dimensional rotation energy is
needed: each unwanted reflected mode receives a separate step below `q`. -/
theorem hasPhaseCovarianceLower_of_individualDilation
    (n m q : ℕ) (hn : 0 < n) (hm : 0 < m) (hq : 800 ≤ q)
    (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hfit : 2 * (phaseTwistCount m * q) ≤ n)
    (hgapOne : individualDilationGap q (min (K / n) (lam / n)) ≤ 1) :
    HasPhaseCovarianceLower n points
      (phaseCovarianceGammaVariable n m q
        (individualDilationGap q (min (K / n) (lam / n))) ) := by
  intro u
  let L : ℕ := phaseTwistCount m
  let rho : ℝ := min (K / n) (lam / n)
  let delta : ℝ := individualDilationGap q rho
  let F : ℝ := (4 : ℝ) ^ L
  let S : ℝ := phaseNormSq u
  let E : ℝ :=
    ∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2
  let d : ℝ := delta ^ (2 * L)
  let Lc : ℝ := ((2 * (L * q) : ℕ) : ℝ)
  let Dv : ℝ := 32 * (m : ℝ) * F ^ 2 * (n : ℝ) ^ 2
  let Dp : ℝ := 8 * (m : ℝ) * (1 + 2 * Lc) ^ 2 * F ^ 4
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hS : 0 ≤ S := phaseNormSq_nonneg u
  have hE : 0 ≤ E := Finset.sum_nonneg fun k _ ↦ sq_nonneg _
  have hrho' : 0 < rho := by simpa [rho] using hrho
  have hdeltaPos : 0 < delta := by
    dsimp [delta, individualDilationGap]
    have hqreal : (0 : ℝ) < q := by exact_mod_cast (lt_of_lt_of_le (by norm_num) hq)
    positivity
  have hdelta0 : 0 ≤ delta := hdeltaPos.le
  have hd0 : 0 ≤ d := pow_nonneg hdelta0 _
  have hd1 : d ≤ 1 := by
    apply pow_le_one₀ hdelta0
    simpa [delta, rho] using hgapOne
  have hF1 : 1 ≤ F := by
    dsimp [F]
    exact one_le_pow₀ (by norm_num)
  have hLc0 : 0 ≤ Lc := by positivity
  have hDv0 : 0 ≤ Dv := by positivity
  have hDp0 : 0 ≤ Dp := by positivity
  have hDpos : 0 < Dv + Dp := by positivity
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge⟩
  let target : ReflectedMode m := (r, true)
  have hdist : ∀ b : ReflectedMode m, b ≠ target →
      rho ≤ distanceToInteger
        ((reflectedModeTime points target - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
    intro b hba
    simpa [rho, target] using
      reflectedMode_distance_lower n hn K lam points hsmooth hspread target b hba.symm
  rcases exists_variableReflectedSteps n hn points target q hq rho hrho' hdist with
    ⟨step, hstep, hsep⟩
  let twists := variableReflectedTwists n points step target
  have hsum : variableStepSum twists ≤ L * q := by
    have hs := variableReflectedTwists_stepSum_le n points step target q
      (fun b hba ↦ (hstep b hba).2.le)
    simpa [twists, L, phaseTwistCount] using hs
  have hspan : variableTwistSpan twists ≤ n := by
    rw [variableTwistSpan_eq_two_mul_stepSum]
    have hfit' : 2 * (L * q) ≤ n := by simpa [L] using hfit
    omega
  have hspanVel : variableTwistSpan twists + 1 ≤ 2 * n := by omega
  have hlen : twists.length = L := by
    simpa [twists, L, phaseTwistCount] using
      variableReflectedTwists_length n points step target
  rcases hlarge with hlarge | hlarge
  · let a : ℝ := ‖reflectedPositionCoeff u target‖
    let b : ℝ := ‖reflectedVelocityCoeff u target‖
    have ha : S / (8 * (m : ℝ)) ≤ a ^ 2 := by
      calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phasePositionCoeff u r) / 4 :=
          div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = a ^ 2 := by
          symm
          simpa [a, target] using norm_reflectedPositionCoeff_true_sq u r
    have hvel0 := reflectedVelocityCoeff_energy_bound_variable
      n hn points step delta hdelta0 target hsep
      (by simpa [twists] using hspanVel) u
    have hvel : b * d / (n : ℝ) ≤ 2 * F * Real.sqrt E := by
      convert hvel0 using 1 <;>
        simp [b, d, F, E, twists, hlen] <;> ring
    have hpos0 := reflectedPositionCoeff_energy_bound_variable
      n hn points step delta hdelta0 target hsep
      (by simpa [twists] using hspan) u
    have hposExact : a * d ≤ F * Real.sqrt E +
        2 * F * b * (variableStepSum twists : ℝ) / (n : ℝ) := by
      convert hpos0 using 1 <;>
        simp [a, b, d, F, E, twists, hlen] <;> ring
    have hcorr :
        2 * F * b * (variableStepSum twists : ℝ) / (n : ℝ) ≤
          Lc * F * b / (n : ℝ) := by
      have hsumReal : (variableStepSum twists : ℝ) ≤ (L * q : ℕ) := by
        exact_mod_cast hsum
      have hfactor : 0 ≤ 2 * F * b / (n : ℝ) := by positivity
      calc
        2 * F * b * (variableStepSum twists : ℝ) / (n : ℝ) =
            (2 * F * b / (n : ℝ)) * (variableStepSum twists : ℝ) := by ring
        _ ≤ (2 * F * b / (n : ℝ)) * ((L * q : ℕ) : ℝ) :=
          mul_le_mul_of_nonneg_left hsumReal hfactor
        _ = Lc * F * b / (n : ℝ) := by
          dsimp [Lc]
          push_cast
          ring
    have hpos : a * d ≤ F * Real.sqrt E + Lc * F * b / (n : ℝ) :=
      hposExact.trans (add_le_add le_rfl hcorr)
    have hcore := position_energy_algebra (m : ℝ) (n : ℝ) Lc
      S E a b d F hmreal hnreal hLc0 hE ha
      (norm_nonneg _) (norm_nonneg _) hd0 hd1 hF1 hvel hpos
    have huniform : d ^ 4 * S ≤ (Dv + Dp) * E := by
      calc
        d ^ 4 * S ≤ Dp * E := by simpa [Dp] using hcore
        _ ≤ (Dv + Dp) * E :=
          mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hDv0) hE
    have hleft : phaseCovarianceGammaVariable n m q delta *
          (2 * n + 1 : ℝ) * phaseNormSq u = d ^ 4 * S / (Dv + Dp) := by
      have hpow : delta ^ (8 * phaseTwistCount m) = d ^ 4 := by
        dsimp [d, L]
        rw [← pow_mul]
        congr 1
        omega
      have hden : phaseCovarianceDenominatorVariable n m q = Dv + Dp := by
        simp [phaseCovarianceDenominatorVariable, Dv, Dp, F, L, Lc,
          phaseTwistCount]
      rw [phaseCovarianceGammaVariable, hden, hpow]
      field_simp
      ring
    change phaseCovarianceGammaVariable n m q delta *
      (2 * n + 1 : ℝ) * S ≤ E
    rw [hleft]
    exact (div_le_iff₀ hDpos).2 (by simpa [mul_comm] using huniform)
  · let b : ℝ := ‖reflectedVelocityCoeff u target‖
    have hb : S / (8 * (m : ℝ)) ≤ b ^ 2 := by
      calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phaseVelocityCoeff u r) / 4 :=
          div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = b ^ 2 := by
          symm
          simpa [b, target] using norm_reflectedVelocityCoeff_true_sq u r
    have hvel0 := reflectedVelocityCoeff_energy_bound_variable
      n hn points step delta hdelta0 target hsep
      (by simpa [twists] using hspanVel) u
    have hvel : b * d / (n : ℝ) ≤ 2 * F * Real.sqrt E := by
      convert hvel0 using 1 <;>
        simp [b, d, F, E, twists, hlen] <;> ring
    have hcore := velocity_energy_algebra (m : ℝ) (n : ℝ)
      S E b d F hmreal hnreal hE hb (norm_nonneg _) hd0
      (le_trans (by norm_num) hF1) hvel
    have hd4le : d ^ 4 * S ≤ d ^ 2 * S := by
      have hdSq : d ^ 2 ≤ 1 := pow_le_one₀ hd0 hd1
      have hd4 : d ^ 4 ≤ d ^ 2 := by
        calc
          d ^ 4 = d ^ 2 * d ^ 2 := by ring
          _ ≤ d ^ 2 * 1 := mul_le_mul_of_nonneg_left hdSq (sq_nonneg d)
          _ = d ^ 2 := by ring
      exact mul_le_mul_of_nonneg_right hd4 hS
    have huniform : d ^ 4 * S ≤ (Dv + Dp) * E := by
      calc
        d ^ 4 * S ≤ d ^ 2 * S := hd4le
        _ ≤ Dv * E := by simpa [Dv] using hcore
        _ ≤ (Dv + Dp) * E :=
          mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hDp0) hE
    have hleft : phaseCovarianceGammaVariable n m q delta *
          (2 * n + 1 : ℝ) * phaseNormSq u = d ^ 4 * S / (Dv + Dp) := by
      have hpow : delta ^ (8 * phaseTwistCount m) = d ^ 4 := by
        dsimp [d, L]
        rw [← pow_mul]
        congr 1
        omega
      have hden : phaseCovarianceDenominatorVariable n m q = Dv + Dp := by
        simp [phaseCovarianceDenominatorVariable, Dv, Dp, F, L, Lc,
          phaseTwistCount]
      rw [phaseCovarianceGammaVariable, hden, hpow]
      field_simp
      ring
    change phaseCovarianceGammaVariable n m q delta *
      (2 * n + 1 : ℝ) * S ≤ E
    rw [hleft]
    exact (div_le_iff₀ hDpos).2 (by simpa [mul_comm] using huniform)

lemma sum_sq_norm_realComplexPhaseProjection_left_le
    (n W : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hW : W ≤ 2 * n + 1) :
    ∑ r ∈ Finset.range W,
        ‖realComplexPhaseProjection n points u ((r : ℤ) - n)‖ ^ 2 ≤
      ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 := by
  let idx : Fin W → Fin (2 * n + 1) := fun r ↦ ⟨r, lt_of_lt_of_le r.isLt hW⟩
  have hidx : Function.Injective idx := by
    intro r s hrs
    apply Fin.ext
    simpa [idx] using congrArg Fin.val hrs
  rw [← Fin.sum_univ_eq_sum_range]
  have hterm : ∀ r : Fin W,
      ‖realComplexPhaseProjection n points u (((r : ℕ) : ℤ) - n)‖ ^ 2 =
        (phaseProjection n points u (idx r)) ^ 2 := by
    intro r
    rw [Complex.sq_norm]
    have hcenter : centeredIndex n (idx r) = ((r : ℕ) : ℤ) - n := by
      simp [idx, centeredIndex]
    rw [← hcenter, ← phaseProjection_sq_eq_normSq_realComplexPhaseProjection]
  calc
    ∑ r : Fin W,
        ‖realComplexPhaseProjection n points u (((r : ℕ) : ℤ) - n)‖ ^ 2 =
        ∑ r : Fin W, (phaseProjection n points u (idx r)) ^ 2 := by
      apply Finset.sum_congr rfl
      intro r _
      exact hterm r
    _ = ∑ j ∈ (Finset.univ : Finset (Fin W)).image idx,
        (phaseProjection n points u j) ^ 2 := by
      rw [Finset.sum_image]
      intro r _ s _ hrs
      exact hidx hrs
    _ ≤ ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · exact Finset.subset_univ _
      · intro j _ _
        exact sq_nonneg _

lemma l2_position_velocity_algebra
    (m H n S a b d C E F Cp Cv : ℝ)
    (hm : 0 < m) (hH : 0 ≤ H) (hn : 0 < n)
    (hS : 0 ≤ S) (ha0 : 0 ≤ a) (ha : S / (8 * m) ≤ a ^ 2)
    (hb : 0 ≤ b) (hd0 : 0 ≤ d) (hd1 : d ≤ 1)
    (hC : 0 ≤ C) (hE : 0 ≤ E) (hF : 0 ≤ F)
    (htransfer : a * d ≤ C + 2 * F * H / n * b)
    (hpos : H * C ^ 2 ≤ Cp * E)
    (hvel : H * (H * (b * d) / n) ^ 2 ≤ Cv * E) :
    H * S * d ^ 4 ≤
      (8 * m * (2 * Cp + 8 * F ^ 2 * Cv)) * E := by
  have had0 : 0 ≤ a * d := mul_nonneg ha0 hd0
  have hsum0 : 0 ≤ C + 2 * F * H / n * b := by positivity
  have hsq := pow_le_pow_left₀ had0 htransfer 2
  have hquad : (C + 2 * F * H / n * b) ^ 2 ≤
      2 * C ^ 2 + 2 * (2 * F * H / n * b) ^ 2 := by
    nlinarith [sq_nonneg (C - 2 * F * H / n * b)]
  have hd2 : d ^ 2 ≤ 1 := pow_le_one₀ hd0 hd1
  have hmain : H * (a ^ 2 * d ^ 4) ≤
      2 * (H * C ^ 2) +
        8 * F ^ 2 * (H * (H * (b * d) / n) ^ 2) := by
    calc
      H * (a ^ 2 * d ^ 4) = H * ((a * d) ^ 2 * d ^ 2) := by ring
      _ ≤ H * ((C + 2 * F * H / n * b) ^ 2 * d ^ 2) := by gcongr
      _ ≤ H * ((2 * C ^ 2 + 2 * (2 * F * H / n * b) ^ 2) * d ^ 2) := by gcongr
      _ ≤ H * (2 * C ^ 2 + 2 * (2 * F * H / n * b) ^ 2 * d ^ 2) := by
        gcongr
        nlinarith [sq_nonneg C]
      _ = 2 * (H * C ^ 2) +
          8 * F ^ 2 * (H * (H * (b * d) / n) ^ 2) := by
        field_simp
        ring
  have henergy : H * (a ^ 2 * d ^ 4) ≤
      (2 * Cp + 8 * F ^ 2 * Cv) * E := by
    calc
      _ ≤ 2 * (H * C ^ 2) +
          8 * F ^ 2 * (H * (H * (b * d) / n) ^ 2) := hmain
      _ ≤ 2 * (Cp * E) + 8 * F ^ 2 * (Cv * E) := by gcongr
      _ = (2 * Cp + 8 * F ^ 2 * Cv) * E := by ring
  have hscale : H * (S / (8 * m) * d ^ 4) ≤
      H * (a ^ 2 * d ^ 4) := by gcongr
  calc
    H * S * d ^ 4 = (8 * m) * (H * (S / (8 * m) * d ^ 4)) := by
      field_simp
    _ ≤ (8 * m) * (H * (a ^ 2 * d ^ 4)) := by gcongr
    _ ≤ (8 * m) * ((2 * Cp + 8 * F ^ 2 * Cv) * E) := by gcongr
    _ = (8 * m * (2 * Cp + 8 * F ^ 2 * Cv)) * E := by ring

noncomputable def phaseCovarianceL2Denominator (m : ℕ) (J : ℝ) : ℝ :=
  let L := phaseTwistCount m
  let F : ℝ := (4 : ℝ) ^ L
  let Cp : ℝ := (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^ L
  let Cv : ℝ := 2 * (36 : ℝ) ^ L
  8 * (m : ℝ) * (2 * Cp + (8 * F ^ 2 + J ^ 2) * Cv)

noncomputable def phaseCovarianceGammaVariableL2
    (n m H : ℕ) (J δ : ℝ) : ℝ :=
  (H : ℝ) * δ ^ (8 * phaseTwistCount m) /
    (phaseCovarianceL2Denominator m J * (2 * n + 1 : ℝ))

lemma phaseCovarianceL2Denominator_pos (m : ℕ) (hm : 0 < m) (J : ℝ) :
    0 < phaseCovarianceL2Denominator m J := by
  unfold phaseCovarianceL2Denominator
  dsimp only
  positivity

theorem hasPhaseCovarianceLower_of_individualDilation_l2
    (n m q H : ℕ) (hn : 0 < n) (hm : 0 < m) (hH : 0 < H)
    (hq : 800 ≤ q) (K lam J : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hgapOne : individualDilationGap q (min (K / n) (lam / n)) ≤ 1)
    (hspan : phaseTwistCount m * q ≤ H)
    (hfit : 2 * H + 2 * (phaseTwistCount m * q) ≤ 2 * n + 1)
    (hJ : 0 ≤ J) (hnJH : (n : ℝ) ≤ J * H) :
    HasPhaseCovarianceLower n points
      (phaseCovarianceGammaVariableL2 n m H J
        (individualDilationGap q (min (K / n) (lam / n)))) := by
  intro u
  let L : ℕ := phaseTwistCount m
  let rho : ℝ := min (K / n) (lam / n)
  let delta : ℝ := individualDilationGap q rho
  let d : ℝ := delta ^ (2 * L)
  let F : ℝ := (4 : ℝ) ^ L
  let Cp : ℝ := (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^ L
  let Cv : ℝ := 2 * (36 : ℝ) ^ L
  let D : ℝ := 8 * (m : ℝ) * (2 * Cp + (8 * F ^ 2 + J ^ 2) * Cv)
  let S : ℝ := phaseNormSq u
  let E : ℝ := ∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hHreal : (0 : ℝ) < H := by exact_mod_cast hH
  have hS : 0 ≤ S := phaseNormSq_nonneg u
  have hE : 0 ≤ E := Finset.sum_nonneg fun k _ ↦ sq_nonneg _
  have hrho' : 0 < rho := by simpa [rho] using hrho
  have hdelta : 0 < delta := by
    dsimp [delta, individualDilationGap]
    have hqreal : (0 : ℝ) < q := by exact_mod_cast (lt_of_lt_of_le (by norm_num) hq)
    positivity
  have hd0 : 0 ≤ d := by dsimp [d]; positivity
  have hd1 : d ≤ 1 := by
    apply pow_le_one₀ hdelta.le
    simpa [delta, rho] using hgapOne
  have hF0 : 0 ≤ F := by dsimp [F]; positivity
  have hD : 0 < D := by dsimp [D, Cp, Cv, F]; positivity
  rcases exists_large_phaseCoeff_general hm u with ⟨r, hlarge⟩
  let target : ReflectedMode m := (r, true)
  have hdist : ∀ b : ReflectedMode m, b ≠ target →
      rho ≤ distanceToInteger
        ((reflectedModeTime points target - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
    intro b hbt
    simpa [rho] using reflectedMode_distance_lower
      n hn K lam points hsmooth hspread target b hbt.symm
  rcases exists_variableReflectedSteps n hn points target q hq rho hrho' hdist with
    ⟨step, hstep, hsep⟩
  let twists := variableReflectedTwists n points step target
  let A : ℂ := reflectedPositionCoeff u target
  let B : ℂ := reflectedVelocityCoeff u target
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let X : ℂ := variableAffinePositionAfter n (reflectedModeTime points target)
    A B twists
  let P : ℂ := variableModeSeparationProduct n (reflectedModeTime points target) twists
  let a : ℝ := ‖A‖
  let b : ℝ := ‖B‖
  let C : ℝ := ‖X‖
  have hlen : twists.length = L := by
    simpa [twists, L, phaseTwistCount] using
      variableReflectedTwists_length n points step target
  have hsum : variableStepSum twists ≤ L * q := by
    have hs := variableReflectedTwists_stepSum_le n points step target q
      (fun b hbt ↦ (hstep b hbt).2.le)
    simpa [twists, L, phaseTwistCount] using hs
  have hsumH : variableStepSum twists ≤ H := by
    exact hsum.trans (by simpa [L] using hspan)
  have htwistSpan : variableTwistSpan twists ≤ 2 * (L * q) := by
    rw [variableTwistSpan_eq_two_mul_stepSum]
    omega
  have hwindow : 2 * H + variableTwistSpan twists ≤ 2 * n + 1 := by
    have hfit' : 2 * H + 2 * (L * q) ≤ 2 * n + 1 := by simpa [L] using hfit
    omega
  have hsep' : ∀ c : ReflectedMode m, c ≠ target →
      delta ≤ ‖complexWave n (reflectedModeTime points target) (step c : ℤ) -
        complexWave n (reflectedModeTime points c) (step c : ℤ)‖ := by
    simpa [delta, rho] using hsep
  have hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun z ↦ A * complexWave n (reflectedModeTime points target) z +
          B * weightedComplexWave n (reflectedModeTime points target) z) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext z
      exact realComplexPhaseProjection_eq_reflectedModeSum n points u z
    rw [hf]
    apply iteratedVariableDoubleTwist_complexModeSum_eq_single
    intro c hct
    exact ⟨step c, by simpa [twists] using
      variableReflectedTwists_contains_other n points step target c hct⟩
  have hinput :
      ∑ z ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f ((-n : ℤ) + z)‖ ^ 2 ≤ E := by
    have hbase := sum_sq_norm_realComplexPhaseProjection_left_le
      n (2 * H + variableTwistSpan twists) points u hwindow
    convert hbase using 1 <;> simp [f, E] <;> push_cast <;> ring
  have hvel0 := mul_sq_velocity_gap_div_le_isolation_energy
    n hn (reflectedModeTime points target) A B twists f (-n : ℤ) H
      delta hdelta.le
      (by simpa [twists] using variableReflectedTwists_unit n points step target)
      (by simpa [twists] using
        variableReflectedTwists_gap n points step target delta hsep')
      hisolate
  have hvel : (H : ℝ) * ((H : ℝ) * (b * d) / n) ^ 2 ≤ Cv * E := by
    have hupp := hvel0.trans
      (mul_le_mul_of_nonneg_left hinput (by positivity :
        0 ≤ 2 * (36 : ℝ) ^ twists.length))
    simpa [b, d, Cv, hlen] using hupp
  have hj : |((-n : ℤ) : ℝ)| ≤ J * H := by
    simpa using hnJH
  have hpos0 := mul_sq_variableAffinePosition_le_isolation_energy
    n hn (reflectedModeTime points target) A B twists f (-n : ℤ) H hH J hJ hj
      (by simpa [twists] using variableReflectedTwists_unit n points step target)
      hisolate
  have hpos : (H : ℝ) * C ^ 2 ≤ Cp * E := by
    have hupp := hpos0.trans
      (mul_le_mul_of_nonneg_left hinput (by positivity :
        0 ≤ (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^ twists.length))
    simpa [C, X, Cp, hlen] using hupp
  have hP : d ≤ ‖P‖ := by
    have hp := pow_gap_le_norm_variableModeSeparationProduct
      n (reflectedModeTime points target) twists delta hdelta.le
      (by simpa [twists] using
        variableReflectedTwists_gap n points step target delta hsep')
    rw [hlen] at hp
    simpa [d, P] using hp
  have hcorr0 := norm_variableAffinePositionAfter_sub_le
    n hn (reflectedModeTime points target) A B twists
      (by simpa [twists] using variableReflectedTwists_unit n points step target)
  have hcorr : ‖X - A * P‖ ≤ 2 * F * (H : ℝ) / n * b := by
    calc
      ‖X - A * P‖ ≤
          2 * (4 : ℝ) ^ twists.length * ‖B‖ *
            (variableStepSum twists : ℝ) / n := by
        simpa [X, P] using hcorr0
      _ ≤ 2 * F * (H : ℝ) * b / n := by
        have hsreal : (variableStepSum twists : ℝ) ≤ H := by exact_mod_cast hsumH
        have hfac : 0 ≤ 2 * (4 : ℝ) ^ twists.length * ‖B‖ / n := by positivity
        calc
          2 * (4 : ℝ) ^ twists.length * ‖B‖ *
              (variableStepSum twists : ℝ) / n =
              (2 * (4 : ℝ) ^ twists.length * ‖B‖ / n) *
                (variableStepSum twists : ℝ) := by ring
          _ ≤ (2 * (4 : ℝ) ^ twists.length * ‖B‖ / n) * H :=
            mul_le_mul_of_nonneg_left hsreal hfac
          _ = 2 * F * (H : ℝ) * b / n := by
            rw [hlen]
            dsimp [F, b]
            ring
      _ = 2 * F * (H : ℝ) / n * b := by ring
  have htransfer : a * d ≤ C + 2 * F * (H : ℝ) / n * b := by
    calc
      a * d ≤ a * ‖P‖ := mul_le_mul_of_nonneg_left hP (norm_nonneg A)
      _ = ‖A * P‖ := by simp [a, norm_mul]
      _ ≤ ‖X‖ + ‖X - A * P‖ := by
        calc
          ‖A * P‖ = ‖X - (X - A * P)‖ := by congr 1 <;> ring
          _ ≤ ‖X‖ + ‖X - A * P‖ := norm_sub_le _ _
      _ ≤ C + 2 * F * (H : ℝ) / n * b := by
        change ‖X‖ + ‖X - A * P‖ ≤ ‖X‖ + 2 * F * (H : ℝ) / n * b
        exact add_le_add le_rfl hcorr
  have hcore : (H : ℝ) * S * d ^ 4 ≤ D * E := by
    rcases hlarge with hlarge | hlarge
    · have ha : S / (8 * (m : ℝ)) ≤ a ^ 2 := by
        calc
        S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
        _ ≤ Complex.normSq (phasePositionCoeff u r) / 4 := by
          exact div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
        _ = a ^ 2 := by
          symm
          simpa [a, A, target] using norm_reflectedPositionCoeff_true_sq u r
      have hsmall := l2_position_velocity_algebra
        (m : ℝ) (H : ℝ) (n : ℝ) S a b d C E F Cp Cv hmreal hHreal.le hnreal
          hS (norm_nonneg _) ha (norm_nonneg _) hd0 hd1 (norm_nonneg _) hE hF0
          htransfer hpos hvel
      calc
        (H : ℝ) * S * d ^ 4 ≤
            (8 * (m : ℝ) * (2 * Cp + 8 * F ^ 2 * Cv)) * E := hsmall
        _ ≤ D * E := by
          apply mul_le_mul_of_nonneg_right _ hE
          dsimp [D]
          have : 0 ≤ J ^ 2 * Cv := by positivity
          nlinarith
    · have hvelLarge : S / (8 * (m : ℝ)) ≤ b ^ 2 := by
        calc
          S / (8 * (m : ℝ)) = (S / (2 * (m : ℝ))) / 4 := by ring
          _ ≤ Complex.normSq (phaseVelocityCoeff u r) / 4 := by
            exact div_le_div_of_nonneg_right (by simpa [S] using hlarge) (by norm_num)
          _ = b ^ 2 := by
            symm
            simpa [b, B, target] using norm_reflectedVelocityCoeff_true_sq u r
      have hSle : S ≤ 8 * (m : ℝ) * b ^ 2 := by
        rw [div_le_iff₀ (by positivity : (0 : ℝ) < 8 * (m : ℝ))] at hvelLarge
        simpa [mul_comm] using hvelLarge
      have hd4 : d ^ 4 ≤ d ^ 2 := by
        calc
          d ^ 4 = d ^ 2 * d ^ 2 := by ring
          _ ≤ d ^ 2 * 1 := mul_le_mul_of_nonneg_left
            (pow_le_one₀ hd0 hd1) (sq_nonneg d)
          _ = d ^ 2 := by ring
      have hJpos : 0 < J := by
        by_contra hJnot
        have hJzero : J = 0 := le_antisymm (le_of_not_gt hJnot) hJ
        rw [hJzero] at hnJH
        norm_num at hnJH
        omega
      have hratio : (1 : ℝ) ≤ J * (H : ℝ) / n := by
        rw [le_div_iff₀ hnreal]
        simpa [mul_comm] using hnJH
      have hbd0 : 0 ≤ b * d := mul_nonneg (norm_nonneg _) hd0
      have hlinear : b * d ≤ J * ((H : ℝ) * (b * d) / n) := by
        calc
          b * d = 1 * (b * d) := by ring
          _ ≤ (J * (H : ℝ) / n) * (b * d) := by gcongr
          _ = J * ((H : ℝ) * (b * d) / n) := by ring
      have hsquare : b ^ 2 * d ^ 2 ≤
          J ^ 2 * (((H : ℝ) * (b * d) / n) ^ 2) := by
        have := pow_le_pow_left₀ hbd0 hlinear 2
        simpa [mul_pow] using this
      calc
        (H : ℝ) * S * d ^ 4 ≤
            (H : ℝ) * (8 * (m : ℝ) * b ^ 2) * d ^ 4 := by gcongr
        _ ≤ (H : ℝ) * (8 * (m : ℝ) * b ^ 2) * d ^ 2 := by gcongr
        _ ≤ 8 * (m : ℝ) * J ^ 2 *
            ((H : ℝ) * (((H : ℝ) * (b * d) / n) ^ 2)) := by
          have hfac : 0 ≤ 8 * (m : ℝ) * (H : ℝ) := by positivity
          calc
            (H : ℝ) * (8 * (m : ℝ) * b ^ 2) * d ^ 2 =
                (8 * (m : ℝ) * (H : ℝ)) * (b ^ 2 * d ^ 2) := by ring
            _ ≤ (8 * (m : ℝ) * (H : ℝ)) *
                (J ^ 2 * (((H : ℝ) * (b * d) / n) ^ 2)) :=
              mul_le_mul_of_nonneg_left hsquare hfac
            _ = 8 * (m : ℝ) * J ^ 2 *
                ((H : ℝ) * (((H : ℝ) * (b * d) / n) ^ 2)) := by ring
        _ ≤ 8 * (m : ℝ) * J ^ 2 * (Cv * E) := by gcongr
        _ ≤ D * E := by
          have hCp0 : 0 ≤ Cp := by dsimp [Cp]; positivity
          have hF2 : 0 ≤ 8 * F ^ 2 * Cv := by positivity
          have hCv0 : 0 ≤ Cv := by dsimp [Cv]; positivity
          have hcoef : 8 * (m : ℝ) * J ^ 2 * Cv ≤ D := by
            rw [show D = 8 * (m : ℝ) * J ^ 2 * Cv +
                8 * (m : ℝ) * (2 * Cp + 8 * F ^ 2 * Cv) by
              dsimp [D]
              ring]
            exact le_add_of_nonneg_right (mul_nonneg (by positivity)
              (add_nonneg (mul_nonneg (by norm_num) hCp0) hF2))
          rw [show 8 * (m : ℝ) * J ^ 2 * (Cv * E) =
              (8 * (m : ℝ) * J ^ 2 * Cv) * E by ring]
          exact mul_le_mul_of_nonneg_right hcoef hE
  have hpow : d ^ 4 = delta ^ (8 * phaseTwistCount m) := by
    dsimp [d, L]
    rw [← pow_mul]
    congr 1
    omega
  have hden : phaseCovarianceL2Denominator m J = D := by
    simp [phaseCovarianceL2Denominator, D, Cp, Cv, F, L]
  have hgamma : phaseCovarianceGammaVariableL2 n m H J delta *
      (2 * n + 1 : ℝ) * S = (H : ℝ) * S * d ^ 4 / D := by
    rw [phaseCovarianceGammaVariableL2, hden, hpow]
    field_simp
  rw [hgamma]
  exact (div_le_iff₀ hD).2 (by simpa [mul_comm] using hcore)

/-- A deliberately small, moment-dependent exponent used in the weak-separation
part of the factorial-moment argument.  Its generous denominator leaves room
for every power loss in the covariance and smoothing estimates. -/
noncomputable def weakSeparationExponent (m : ℕ) : ℝ :=
  1 / (10000 * ((m : ℝ) + 1) ^ 2)

noncomputable def weakSpreadScale (m n : ℕ) : ℝ :=
  rigidityPower n (-weakSeparationExponent m)

noncomputable def weakDilationScale (m n : ℕ) : ℕ :=
  ⌊rigidityPower n (1 - 2 * weakSeparationExponent m)⌋₊

def weakCovarianceWindow (n : ℕ) : ℕ := n / 2

lemma weakSeparationExponent_pos (m : ℕ) : 0 < weakSeparationExponent m := by
  unfold weakSeparationExponent
  positivity

lemma weakDilationExponent_pos (m : ℕ) :
    0 < 1 - 2 * weakSeparationExponent m := by
  unfold weakSeparationExponent
  have hm : (1 : ℝ) ≤ (m : ℝ) + 1 := by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le m)
  have hden : (10000 : ℝ) ≤ 10000 * ((m : ℝ) + 1) ^ 2 := by
    nlinarith [sq_nonneg ((m : ℝ) + 1)]
  have hrecip : 1 / (10000 * ((m : ℝ) + 1) ^ 2) ≤ (1 / 10000 : ℝ) :=
    one_div_le_one_div_of_le (by norm_num) hden
  linarith

lemma weakDilationScale_tendsto_atTop (m : ℕ) :
    Tendsto (weakDilationScale m) atTop atTop := by
  unfold weakDilationScale
  exact tendsto_nat_floor_atTop.comp
    (tendsto_rigidityPower_atTop (weakDilationExponent_pos m))

lemma eventually_weakDilation_span (m : ℕ) :
    ∀ᶠ n : ℕ in atTop,
      phaseTwistCount m * weakDilationScale m n ≤ weakCovarianceWindow n := by
  have ha : 1 - 2 * weakSeparationExponent m < 1 := by
    linarith [weakSeparationExponent_pos m]
  have hpow := eventually_const_mul_rigidityPower_le
    (2 * phaseTwistCount m : ℝ) (1 - 2 * weakSeparationExponent m) 1 ha
  filter_upwards [hpow] with n hn
  have hq : ((weakDilationScale m n : ℕ) : ℝ) ≤
      rigidityPower n (1 - 2 * weakSeparationExponent m) := by
    exact natFloor_rigidityPower_upper n _
  have hrealR : ((2 * (phaseTwistCount m * weakDilationScale m n) : ℕ) : ℝ) ≤ n := by
    calc
      ((2 * (phaseTwistCount m * weakDilationScale m n) : ℕ) : ℝ) =
          (2 * phaseTwistCount m : ℝ) * weakDilationScale m n := by
            push_cast
            ring
      _ ≤ (2 * phaseTwistCount m : ℝ) *
          rigidityPower n (1 - 2 * weakSeparationExponent m) := by gcongr
      _ ≤ rigidityPower n 1 := hn
      _ = (n : ℝ) := by simp [rigidityPower]
  have hreal : (2 * (phaseTwistCount m * weakDilationScale m n) : ℕ) ≤ n := by
    exact_mod_cast hrealR
  exact (Nat.le_div_iff_mul_le (by norm_num)).2 (by simpa [mul_comm] using hreal)

lemma eventually_weakCovarianceWindow_bounds :
    ∀ᶠ n : ℕ in atTop,
      0 < weakCovarianceWindow n ∧ (n : ℝ) ≤ 3 * weakCovarianceWindow n := by
  filter_upwards [eventually_ge_atTop (2 : ℕ)] with n hn
  constructor
  · unfold weakCovarianceWindow
    omega
  · exact_mod_cast (show n ≤ 3 * weakCovarianceWindow n by
      unfold weakCovarianceWindow
      omega)

/-- Weak separation still gives a quantitative covariance lower bound.  The
scale is chosen so a long difference window fits inside the coefficient
interval even though the dilation length tends to infinity. -/
lemma eventually_hasPhaseCovarianceLower_weak
    {m : ℕ} (hm : 0 < m) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (weakSpreadScale m n) points →
      HasPhaseCovarianceLower n points
        (phaseCovarianceGammaVariableL2 n m (weakCovarianceWindow n) 3
          (individualDilationGap (weakDilationScale m n)
            (min (rigiditySmoothScale n / n) (weakSpreadScale m n / n)))) := by
  filter_upwards [Nat.eventually_pos,
      (weakDilationScale_tendsto_atTop m).eventually
        (eventually_ge_atTop 800),
      eventually_weakDilation_span m,
      eventually_weakCovarianceWindow_bounds]
    with n hn hq hspan hwindow
  intro points hsmooth hspread
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hK : 0 < rigiditySmoothScale n := by
    unfold rigiditySmoothScale
    exact rigidityPower_pos hn _
  have hlam : 0 < weakSpreadScale m n := by
    unfold weakSpreadScale
    exact rigidityPower_pos hn _
  have hrho : 0 < min (rigiditySmoothScale n / n)
      (weakSpreadScale m n / n) := by
    exact lt_min (div_pos hK hnreal) (div_pos hlam hnreal)
  apply hasPhaseCovarianceLower_of_individualDilation_l2
    n m (weakDilationScale m n) (weakCovarianceWindow n)
    hn hm hwindow.1 hq (rigiditySmoothScale n) (weakSpreadScale m n) 3
    points hsmooth hspread hrho
    (individualDilationGap_le_one _ _)
    hspan
  · have htwice : 2 * weakCovarianceWindow n ≤ n := by
      unfold weakCovarianceWindow
      omega
    omega
  · norm_num
  · exact hwindow.2

lemma phaseCovarianceGamma_pos
    (n m : ℕ) (hn : 0 < n) (hm : 0 < m) (K lam : ℝ)
    (hgap : 0 < phaseCovarianceGap n K lam) :
    0 < phaseCovarianceGamma n m K lam := by
  unfold phaseCovarianceGamma
  exact div_pos (pow_pos hgap _)
    (mul_pos (phaseCovarianceDenominator_pos n m hn hm) (by positivity))

/-- Checked low-frequency Fourier decay with the explicit covariance
constant just proved. -/
theorem norm_projectedPhaseWalk_charFun_low_frequency_of_smooth_spread
    (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (K lam : ℝ) (points : Fin m → ℝ)
    (hK : 0 ≤ K) (hlam : 0 ≤ lam)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hsize : 4 * m ≤ n)
    (hgapPos : 0 < phaseCovarianceGap n K lam)
    (hgapOne : phaseCovarianceGap n K lam ≤ 1)
    (u : PhaseCoordinate m) (t : ℝ)
    (hsmall : |t| * (∑ r : Fin m, ∑ c : Fin 4, |u r c|) /
      Real.pi < 1 / 2) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤
      Real.exp (-((t / Real.pi) ^ 2 *
        (phaseCovarianceGamma n m K lam *
          (2 * n + 1 : ℝ) * phaseNormSq u))) := by
  exact norm_projectedPhaseWalk_charFun_low_frequency_of_covariance
    n points (phaseCovarianceGamma n m K lam)
    (hasPhaseCovarianceLower_of_smooth_spread n m hn hm K lam points
      hK hlam hsmooth hspread hsize hgapPos hgapOne)
    u t hsmall

/-- Low-frequency Fourier decay using the individual-dilation covariance
constant. -/
theorem norm_projectedPhaseWalk_charFun_low_frequency_of_individualDilation
    (n m q : ℕ) (hn : 0 < n) (hm : 0 < m) (hq : 800 ≤ q)
    (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hrho : 0 < min (K / n) (lam / n))
    (hfit : 2 * (phaseTwistCount m * q) ≤ n)
    (hgapOne : individualDilationGap q (min (K / n) (lam / n)) ≤ 1)
    (u : PhaseCoordinate m) (t : ℝ)
    (hsmall : |t| * (∑ r : Fin m, ∑ c : Fin 4, |u r c|) /
      Real.pi < 1 / 2) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤
      Real.exp (-((t / Real.pi) ^ 2 *
        (phaseCovarianceGammaVariable n m q
            (individualDilationGap q (min (K / n) (lam / n))) *
          (2 * n + 1 : ℝ) * phaseNormSq u))) := by
  exact norm_projectedPhaseWalk_charFun_low_frequency_of_covariance
    n points
    (phaseCovarianceGammaVariable n m q
      (individualDilationGap q (min (K / n) (lam / n))))
    (hasPhaseCovarianceLower_of_individualDilation
      n m q hn hm hq K lam points hsmooth hspread hrho hfit hgapOne)
    u t hsmall

/-! ## Elementary consequences of the exact limiting law -/

lemma eventually_const_div_sqrt_lt_one {A : ℝ} (_hA : 0 < A) :
    ∀ᶠ N : ℕ in atTop, A / Real.sqrt N < 1 := by
  have hsqrt : Tendsto (fun N : ℕ ↦ Real.sqrt (N : ℝ)) atTop atTop :=
    Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop
  have hdiv : Tendsto (fun N : ℕ ↦ A / Real.sqrt (N : ℝ)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hsqrt
  exact hdiv.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1))

lemma exceptionalProbability_le_minimumTail_eventually (A : ℝ) (hA : 0 < A) :
    ∀ᶠ N : ℕ in atTop, exceptionalProbability N ≤ minimumTail N A := by
  filter_upwards [eventually_const_div_sqrt_lt_one hA] with N hN
  apply uniformProbability_mono
  intro ε hε
  exact lt_of_lt_of_le hN hε

lemma exists_pos_exp_neg_rate_lt {δ : ℝ} (hδ : 0 < δ) :
    ∃ A : ℝ, 0 < A ∧ Real.exp (-rate * A) < δ := by
  have hlinear : Tendsto (fun A : ℝ ↦ -rate * A) atTop atBot := by
    simpa only [id_eq] using
      tendsto_const_nhds.neg_mul_atTop (by linarith [rate_pos])
        (tendsto_id : Tendsto (fun A : ℝ ↦ A) atTop atTop)
  have hexp : Tendsto (fun A : ℝ ↦ Real.exp (-rate * A)) atTop (𝓝 0) :=
    Real.tendsto_exp_atBot.comp hlinear
  have hsmall : ∀ᶠ A : ℝ in atTop, Real.exp (-rate * A) < δ :=
    hexp.eventually (Iio_mem_nhds hδ)
  rcases (hsmall.and (eventually_gt_atTop (0 : ℝ))).exists with ⟨A, hsmallA, hA⟩
  exact ⟨A, hA, hsmallA⟩

/-- Tightness consequence: the probability of having minimum modulus at
least one tends to zero. -/
theorem exceptionalProbability_tendsto_zero_of_limitingLaw
    (hCN : LimitingLaw) :
    Tendsto exceptionalProbability atTop (𝓝 0) := by
  rw [tendsto_order]
  constructor
  · intro a ha
    exact Eventually.of_forall fun N ↦
      ha.trans_le (uniformProbability_nonneg fun ε : SignVector N ↦ 1 ≤ minModulus ε)
  · intro a ha
    rcases exists_pos_exp_neg_rate_lt ha with ⟨A, hA, hAexp⟩
    have htail :
        ∀ᶠ N : ℕ in atTop, minimumTail N A < a :=
      (hCN A hA).eventually (Iio_mem_nhds hAexp)
    filter_upwards [exceptionalProbability_le_minimumTail_eventually A hA, htail]
      with N hle hlt
    exact hle.trans_lt hlt

lemma exceptional_ratio_eq (N : ℕ) :
    ((exceptionalFamily N).card : ℝ) / (2 : ℝ) ^ N =
      2 * exceptionalProbability N := by
  rw [exceptionalProbability_eq, pow_succ]
  field_simp

/-- Counting form of the affirmative answer: the exceptional family has
cardinality `o(2^N)`. -/
theorem exceptionalFamily_isLittleO_of_limitingLaw (hCN : LimitingLaw) :
    IsLittleO atTop
      (fun N : ℕ ↦ ((exceptionalFamily N).card : ℝ))
      (fun N : ℕ ↦ (2 : ℝ) ^ N) := by
  rw [isLittleO_iff_tendsto' (Eventually.of_forall fun N hzero ↦ by
    have : (0 : ℝ) < 2 ^ N := by positivity
    exact (this.ne' hzero).elim)]
  have h : Tendsto (fun N : ℕ ↦ 2 * exceptionalProbability N) atTop (𝓝 0) := by
    simpa using (exceptionalProbability_tendsto_zero_of_limitingLaw hCN).const_mul 2
  convert h using 1
  funext N
  exact exceptional_ratio_eq N

/-- The literal event asked for by Erdős: there is a point of the unit circle
where the polynomial has modulus strictly below one. -/
def HasSmallValue {N : ℕ} (ε : SignVector N) : Prop :=
  ∃ z : ℂ, ‖z‖ = 1 ∧ ‖littlewoodEval ε z‖ < 1

lemma hasSmallValue_iff {N : ℕ} (ε : SignVector N) :
    HasSmallValue ε ↔ minModulus ε < 1 := by
  exact (minModulus_lt_iff ε 1).symm

lemma not_hasSmallValue_iff {N : ℕ} (ε : SignVector N) :
    ¬HasSmallValue ε ↔ 1 ≤ minModulus ε := by
  rw [hasSmallValue_iff, not_lt]

lemma uniformProbability_hasSmallValue_eq (N : ℕ) :
    uniformProbability (fun ε : SignVector N ↦ HasSmallValue ε) =
      1 - exceptionalProbability N := by
  unfold exceptionalProbability uniformProbability
  rw [show (Finset.univ.filter fun ε : SignVector N ↦ HasSmallValue ε) =
      (Finset.univ.filter fun ε : SignVector N ↦ 1 ≤ minModulus ε)ᶜ by
    ext ε
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_compl]
    rw [hasSmallValue_iff]
    exact lt_iff_not_ge]
  rw [Finset.card_compl]
  rw [Nat.cast_sub (Finset.card_le_univ _)]
  simp only [card_signVector]
  push_cast
  have hpow : (0 : ℝ) < 2 ^ (N + 1) := by positivity
  field_simp

theorem hasSmallValue_probability_tendsto_one_of_limitingLaw
    (hCN : LimitingLaw) :
    Tendsto
      (fun N : ℕ ↦ uniformProbability (fun ε : SignVector N ↦ HasSmallValue ε))
      atTop (𝓝 1) := by
  have hone : Tendsto (fun _ : ℕ ↦ (1 : ℝ)) atTop (𝓝 1) := tendsto_const_nhds
  simpa only [uniformProbability_hasSmallValue_eq, sub_zero] using
    hone.sub (exceptionalProbability_tendsto_zero_of_limitingLaw hCN)


noncomputable def blockRotatedPosition (a b : ℂ) : ℂ :=
  a * conj b / ‖b‖

def IsTruncatedBlockRepresentative
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ)
    (p : ℂ × ℂ) : Prop :=
  p.2 ≠ 0 ∧ velocityLower ≤ ‖p.2‖ ∧ ‖p.2‖ ≤ velocityUpper ∧
    |(blockRotatedPosition p.1 p.2).re| ≤ halfWidth * ‖p.2‖ ∧
    |(blockRotatedPosition p.1 p.2).im| ≤ u / n

noncomputable def blockLimitingDensity (p : ℂ × ℂ) : ℝ :=
  (3 / Real.pi ^ 2) *
    Real.exp (-(Complex.normSq p.1) - 3 * Complex.normSq p.2)

noncomputable def blockDirection (b : ℂ) (hb : b ≠ 0) : Circle :=
  ⟨conj b / (‖b‖ : ℂ), by
    apply mem_sphere_zero_iff_norm.mpr
    rw [norm_div, Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (norm_pos_iff.mpr hb)]
    exact div_self (norm_ne_zero_iff.mpr hb)⟩

lemma blockRotation_apply (a b : ℂ) (hb : b ≠ 0) :
    rotation (blockDirection b hb) a = blockRotatedPosition a b := by
  rw [rotation_apply]
  unfold blockDirection blockRotatedPosition
  push_cast
  ring

lemma norm_blockRotatedPosition (a b : ℂ) (hb : b ≠ 0) :
    ‖blockRotatedPosition a b‖ = ‖a‖ := by
  rw [← blockRotation_apply a b hb]
  exact LinearIsometryEquiv.norm_map _ _

def blockRectangle (n : ℕ) (u halfWidth velocityNorm : ℝ) : Set ℂ :=
  {q | |q.re| ≤ halfWidth * velocityNorm ∧ |q.im| ≤ u / n}

lemma blockRepresentative_section_iff
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ)
    (a b : ℂ) (hb : b ≠ 0) :
    IsTruncatedBlockRepresentative n u halfWidth velocityLower velocityUpper (a, b) ↔
      velocityLower ≤ ‖b‖ ∧ ‖b‖ ≤ velocityUpper ∧
    rotation (blockDirection b hb) a ∈
          blockRectangle n u halfWidth ‖b‖ := by
  simp only [IsTruncatedBlockRepresentative, hb, ne_eq, true_and,
    blockRectangle, Set.mem_setOf_eq, blockRotation_apply]
  tauto

lemma blockRectangle_eq_preimage_prod_Icc
    (n : ℕ) (u halfWidth velocityNorm : ℝ) :
    blockRectangle n u halfWidth velocityNorm =
      Complex.measurableEquivRealProd ⁻¹'
        (Set.Icc (-(halfWidth * velocityNorm)) (halfWidth * velocityNorm) ×ˢ
          Set.Icc (-(u / n)) (u / n)) := by
  ext q
  simp only [blockRectangle, Set.mem_setOf_eq, Set.mem_preimage,
    Complex.measurableEquivRealProd_apply, Set.mem_prod, Set.mem_Icc, abs_le]

lemma measurableSet_blockRectangle
    (n : ℕ) (u halfWidth velocityNorm : ℝ) :
    MeasurableSet (blockRectangle n u halfWidth velocityNorm) := by
  rw [blockRectangle_eq_preimage_prod_Icc]
  exact (measurableSet_Icc.prod measurableSet_Icc).preimage
    Complex.measurableEquivRealProd.measurable

lemma volumeReal_blockRectangle
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityNorm : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvel : 0 ≤ velocityNorm) :
    volume.real (blockRectangle n u halfWidth velocityNorm) =
      4 * halfWidth * velocityNorm * (u / n) := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  rw [blockRectangle_eq_preimage_prod_Icc]
  rw [measureReal_def]
  rw [Complex.volume_preserving_equiv_real_prod.measure_preimage
    (measurableSet_Icc.prod measurableSet_Icc).nullMeasurableSet]
  change (volume.prod volume).real
      (Set.Icc (-(halfWidth * velocityNorm)) (halfWidth * velocityNorm) ×ˢ
        Set.Icc (-(u / n)) (u / n)) = _
  rw [measureReal_def, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc]
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal, ENNReal.toReal_ofReal]
  · ring
  · have h := div_nonneg hu hnreal.le
    linarith
  · have h := mul_nonneg hhalf hvel
    linarith

def blockPositionSection
    (n : ℕ) (u halfWidth : ℝ) (b : ℂ) : Set ℂ :=
  {a | blockRotatedPosition a b ∈ blockRectangle n u halfWidth ‖b‖}

lemma blockPositionSection_eq_rotation_preimage
    (n : ℕ) (u halfWidth : ℝ) (b : ℂ) (hb : b ≠ 0) :
    blockPositionSection n u halfWidth b =
      (rotation (blockDirection b hb)) ⁻¹'
        blockRectangle n u halfWidth ‖b‖ := by
  ext a
  simp only [blockPositionSection, Set.mem_setOf_eq, Set.mem_preimage,
    blockRotation_apply]

lemma measurableSet_blockPositionSection
    (n : ℕ) (u halfWidth : ℝ) (b : ℂ) (hb : b ≠ 0) :
    MeasurableSet (blockPositionSection n u halfWidth b) := by
  rw [blockPositionSection_eq_rotation_preimage n u halfWidth b hb]
  exact (measurableSet_blockRectangle n u halfWidth ‖b‖).preimage
    (rotation (blockDirection b hb)).continuous.measurable

lemma measurableSet_blockPositionSection_all
    (n : ℕ) (u halfWidth : ℝ) (b : ℂ) :
    MeasurableSet (blockPositionSection n u halfWidth b) := by
  unfold blockPositionSection blockRotatedPosition blockRectangle
  measurability

lemma volumeReal_blockPositionSection
    (n : ℕ) (hn : 0 < n) (u halfWidth : ℝ) (b : ℂ) (hb : b ≠ 0)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) :
    volume.real (blockPositionSection n u halfWidth b) =
      4 * halfWidth * ‖b‖ * (u / n) := by
  rw [blockPositionSection_eq_rotation_preimage n u halfWidth b hb]
  rw [measureReal_def]
  rw [(LinearIsometryEquiv.measurePreserving
      (rotation (blockDirection b hb))).measure_preimage
    (measurableSet_blockRectangle n u halfWidth ‖b‖).nullMeasurableSet]
  rw [← measureReal_def]
  exact volumeReal_blockRectangle n hn u halfWidth ‖b‖ hu hhalf (norm_nonneg b)

lemma normSq_le_on_blockPositionSection
    (n : ℕ) (hn : 0 < n) (u halfWidth : ℝ) (b a : ℂ) (hb : b ≠ 0)
    (ha : a ∈ blockPositionSection n u halfWidth b) :
    Complex.normSq a ≤ (halfWidth * ‖b‖) ^ 2 + (u / n) ^ 2 := by
  have hrect := ha
  unfold blockPositionSection blockRectangle at hrect
  change |(blockRotatedPosition a b).re| ≤ halfWidth * ‖b‖ ∧
    |(blockRotatedPosition a b).im| ≤ u / n at hrect
  have hnorm := norm_blockRotatedPosition a b hb
  rw [Complex.normSq_eq_norm_sq, ← hnorm]
  rw [Complex.sq_norm]
  rw [Complex.normSq_apply]
  have hreNon : 0 ≤ halfWidth * ‖b‖ :=
    (abs_nonneg (blockRotatedPosition a b).re).trans hrect.1
  have himNon : 0 ≤ u / n :=
    (abs_nonneg (blockRotatedPosition a b).im).trans hrect.2
  have hreSq : (blockRotatedPosition a b).re ^ 2 ≤
      (halfWidth * ‖b‖) ^ 2 := by
    simpa only [sq_abs] using
      (sq_le_sq₀ (abs_nonneg (blockRotatedPosition a b).re) hreNon).2 hrect.1
  have himSq : (blockRotatedPosition a b).im ^ 2 ≤ (u / n) ^ 2 := by
    simpa only [sq_abs] using
      (sq_le_sq₀ (abs_nonneg (blockRotatedPosition a b).im) himNon).2 hrect.2
  linarith

lemma integrable_complex_exp_neg_normSq :
    Integrable (fun a : ℂ ↦ Real.exp (-Complex.normSq a)) := by
  have h := (GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
    (V := ℂ) (b := (1 : ℂ)) (by norm_num) 0 (0 : ℂ)).norm
  apply h.congr
  filter_upwards [] with a
  rw [Complex.norm_exp]
  simp [Complex.normSq_eq_norm_sq]
  rw [pow_two, Complex.mul_re]
  simp
  ring

lemma volume_blockPositionSection_ne_top
    (n : ℕ) (u halfWidth : ℝ) (b : ℂ) (hb : b ≠ 0) :
    volume (blockPositionSection n u halfWidth b) ≠ ⊤ := by
  rw [blockPositionSection_eq_rotation_preimage n u halfWidth b hb]
  rw [(LinearIsometryEquiv.measurePreserving
      (rotation (blockDirection b hb))).measure_preimage
    (measurableSet_blockRectangle n u halfWidth ‖b‖).nullMeasurableSet]
  rw [blockRectangle_eq_preimage_prod_Icc]
  rw [Complex.volume_preserving_equiv_real_prod.measure_preimage
    (measurableSet_Icc.prod measurableSet_Icc).nullMeasurableSet]
  change (volume.prod volume)
      (Set.Icc (-(halfWidth * ‖b‖)) (halfWidth * ‖b‖) ×ˢ
        Set.Icc (-(u / n)) (u / n)) ≠ ⊤
  rw [Measure.prod_prod, Real.volume_Icc, Real.volume_Icc]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top

lemma blockPositionIntegral_lower
    (n : ℕ) (hn : 0 < n) (u halfWidth : ℝ) (b : ℂ) (hb : b ≠ 0)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) :
    Real.exp (-((halfWidth * ‖b‖) ^ 2 + (u / n) ^ 2)) *
        (4 * halfWidth * ‖b‖ * (u / n)) ≤
      ∫ a : ℂ in blockPositionSection n u halfWidth b,
        Real.exp (-Complex.normSq a) := by
  let s := blockPositionSection n u halfWidth b
  have hs := measurableSet_blockPositionSection n u halfWidth b hb
  have hfinite : volume s ≠ ⊤ :=
    volume_blockPositionSection_ne_top n u halfWidth b hb
  have hfint : IntegrableOn (fun a : ℂ ↦ Real.exp (-Complex.normSq a)) s := by
    exact integrable_complex_exp_neg_normSq.integrableOn
  have h := setIntegral_ge_of_const_le_real hs hfinite
    (fun a ha ↦ Real.exp_le_exp.mpr
      (neg_le_neg (normSq_le_on_blockPositionSection n hn u halfWidth b a hb ha)))
    hfint
  rw [volumeReal_blockPositionSection n hn u halfWidth b hb hu hhalf] at h
  exact h

lemma blockPositionIntegral_upper
    (n : ℕ) (hn : 0 < n) (u halfWidth : ℝ) (b : ℂ) (hb : b ≠ 0)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) :
    (∫ a : ℂ in blockPositionSection n u halfWidth b,
        Real.exp (-Complex.normSq a)) ≤
      4 * halfWidth * ‖b‖ * (u / n) := by
  let s := blockPositionSection n u halfWidth b
  have hs := measurableSet_blockPositionSection n u halfWidth b hb
  have hfinite : volume s ≠ ⊤ :=
    volume_blockPositionSection_ne_top n u halfWidth b hb
  have hfint : IntegrableOn (fun a : ℂ ↦ Real.exp (-Complex.normSq a)) s := by
    exact integrable_complex_exp_neg_normSq.integrableOn
  calc
    (∫ a : ℂ in s, Real.exp (-Complex.normSq a)) ≤
        ∫ _a : ℂ in s, (1 : ℝ) := by
      apply setIntegral_mono_on hfint (integrableOn_const hfinite) hs
      intro a _ha
      rw [Real.exp_le_one_iff]
      exact neg_nonpos.mpr (Complex.normSq_nonneg a)
    _ = volume.real s := by rw [setIntegral_const]; simp
    _ = _ := volumeReal_blockPositionSection n hn u halfWidth b hb hu hhalf

def blockVelocityAnnulus (velocityLower velocityUpper : ℝ) : Set ℂ :=
  {b | velocityLower ≤ ‖b‖ ∧ ‖b‖ ≤ velocityUpper}

def truncatedBlockRegion
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) : Set (ℂ × ℂ) :=
  {p | p.2 ∈ blockVelocityAnnulus velocityLower velocityUpper ∧
    p.1 ∈ blockPositionSection n u halfWidth p.2}

lemma measurableSet_blockVelocityAnnulus
    (velocityLower velocityUpper : ℝ) :
    MeasurableSet (blockVelocityAnnulus velocityLower velocityUpper) := by
  unfold blockVelocityAnnulus
  exact (measurableSet_le measurable_const continuous_norm.measurable).inter
    (measurableSet_le continuous_norm.measurable measurable_const)

lemma measurableSet_truncatedBlockRegion
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    MeasurableSet
      (truncatedBlockRegion n u halfWidth velocityLower velocityUpper) := by
  unfold truncatedBlockRegion blockVelocityAnnulus blockPositionSection
  unfold blockRotatedPosition blockRectangle
  measurability

lemma integrable_complex_exp_neg_three_normSq :
    Integrable (fun b : ℂ ↦ Real.exp (-3 * Complex.normSq b)) := by
  have h := (GaussianFourier.integrable_cexp_neg_mul_sq_norm_add
    (V := ℂ) (b := (3 : ℂ)) (by norm_num) 0 (0 : ℂ)).norm
  apply h.congr
  filter_upwards [] with b
  rw [Complex.norm_exp]
  simp [Complex.normSq_eq_norm_sq]
  rw [pow_two, Complex.mul_re]
  simp
  ring

lemma integrable_blockLimitingDensity :
    Integrable (blockLimitingDensity : ℂ × ℂ → ℝ) := by
  have hp := integrable_complex_exp_neg_normSq.mul_prod
    integrable_complex_exp_neg_three_normSq
  apply hp.const_mul (3 / Real.pi ^ 2) |>.congr
  filter_upwards [] with p
  unfold blockLimitingDensity
  rw [← Real.exp_add]
  ring_nf

lemma truncatedBlockRegion_section
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) (b : ℂ) :
    {a : ℂ | (a, b) ∈
        truncatedBlockRegion n u halfWidth velocityLower velocityUpper} =
      if b ∈ blockVelocityAnnulus velocityLower velocityUpper then
        blockPositionSection n u halfWidth b else ∅ := by
  ext a
  by_cases hb : b ∈ blockVelocityAnnulus velocityLower velocityUpper <;>
    simp [truncatedBlockRegion, hb]

lemma integral_blockLimitingDensity_truncatedBlockRegion
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    (∫ p : ℂ × ℂ in
        truncatedBlockRegion n u halfWidth velocityLower velocityUpper,
        blockLimitingDensity p) =
      (3 / Real.pi ^ 2) *
        ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper,
          Real.exp (-3 * Complex.normSq b) *
            (∫ a : ℂ in blockPositionSection n u halfWidth b,
              Real.exp (-Complex.normSq a)) := by
  let s := truncatedBlockRegion n u halfWidth velocityLower velocityUpper
  have hs : MeasurableSet s :=
    measurableSet_truncatedBlockRegion n u halfWidth velocityLower velocityUpper
  have hInt : Integrable (s.indicator blockLimitingDensity) :=
    integrable_blockLimitingDensity.indicator hs
  rw [← integral_indicator hs]
  rw [MeasureTheory.Measure.volume_eq_prod]
  rw [integral_prod_symm _ hInt]
  rw [← integral_const_mul]
  rw [← integral_indicator (measurableSet_blockVelocityAnnulus
    velocityLower velocityUpper)]
  apply integral_congr_ae
  filter_upwards [volume.ae_ne (0 : ℂ)] with b hb
  by_cases hbAnn : b ∈ blockVelocityAnnulus velocityLower velocityUpper
  · rw [Set.indicator_of_mem hbAnn]
    rw [show (∫ a : ℂ, s.indicator blockLimitingDensity (a, b)) =
        (3 / Real.pi ^ 2) * Real.exp (-3 * Complex.normSq b) *
          (∫ a : ℂ in blockPositionSection n u halfWidth b,
            Real.exp (-Complex.normSq a)) by
      rw [← integral_const_mul]
      rw [← integral_indicator
        (measurableSet_blockPositionSection n u halfWidth b hb)]
      apply integral_congr_ae
      filter_upwards [] with a
      by_cases ha : a ∈ blockPositionSection n u halfWidth b
      · rw [Set.indicator_of_mem ha]
        have hp : (a, b) ∈ s := by exact ⟨hbAnn, ha⟩
        rw [Set.indicator_of_mem hp]
        unfold blockLimitingDensity
        simp only [Prod.fst, Prod.snd]
        rw [show -Complex.normSq a - 3 * Complex.normSq b =
          (-3 * Complex.normSq b) + (-Complex.normSq a) by ring,
          Real.exp_add]
        ring_nf
      · rw [Set.indicator_of_notMem ha]
        have hp : (a, b) ∉ s := by intro hp; exact ha hp.2
        rw [Set.indicator_of_notMem hp]
        ]
    ring
  · rw [Set.indicator_of_notMem hbAnn]
    have hz : (∫ a : ℂ, s.indicator blockLimitingDensity (a, b)) = 0 := by
      apply integral_eq_zero_of_ae
      filter_upwards [] with a
      have hp : (a, b) ∉ s := by intro hp; exact hbAnn hp.1
      simp [Set.indicator_of_notMem hp]
    rw [hz]

noncomputable def blockVelocityMass
    (velocityLower velocityUpper : ℝ) : ℝ :=
  ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper,
    ‖b‖ * Real.exp (-3 * Complex.normSq b)

lemma integrable_complex_norm_mul_exp_neg_three_normSq :
    Integrable (fun b : ℂ ↦ ‖b‖ * Real.exp (-3 * Complex.normSq b)) := by
  have hnorm : Integrable (fun b : ℂ ↦
      ‖b‖ * Real.exp (-3 * ‖b‖ ^ 2)) := by
    apply (integrable_fun_norm_addHaar (volume : Measure ℂ)
      (f := fun y : ℝ ↦ y * Real.exp (-3 * y ^ 2))).2
    simpa only [Complex.finrank_real_complex, Nat.reduceSubDiff, pow_one,
      smul_eq_mul, Real.rpow_two, pow_two, mul_assoc] using
      (integrableOn_rpow_mul_exp_neg_mul_sq (b := 3)
        (by norm_num) (s := 2) (by norm_num))
  simpa only [Complex.normSq_eq_norm_sq] using hnorm

def blockPositionRegion (n : ℕ) (u halfWidth : ℝ) : Set (ℂ × ℂ) :=
  {p | p.1 ∈ blockPositionSection n u halfWidth p.2}

lemma measurableSet_blockPositionRegion (n : ℕ) (u halfWidth : ℝ) :
    MeasurableSet (blockPositionRegion n u halfWidth) := by
  unfold blockPositionRegion blockPositionSection blockRotatedPosition blockRectangle
  measurability

lemma integrable_blockSectionWeight (n : ℕ) (u halfWidth : ℝ) :
    Integrable (fun b : ℂ ↦
      Real.exp (-3 * Complex.normSq b) *
        (∫ a : ℂ in blockPositionSection n u halfWidth b,
          Real.exp (-Complex.normSq a))) := by
  let s := blockPositionRegion n u halfWidth
  let f : ℂ × ℂ → ℝ := fun p ↦
    Real.exp (-Complex.normSq p.1) * Real.exp (-3 * Complex.normSq p.2)
  have hf : Integrable f :=
    integrable_complex_exp_neg_normSq.mul_prod
      integrable_complex_exp_neg_three_normSq
  have hs : MeasurableSet s := measurableSet_blockPositionRegion n u halfWidth
  have houter : Integrable (fun b : ℂ ↦
      ∫ a : ℂ, s.indicator f (a, b)) :=
    (hf.indicator hs).integral_prod_right
  apply houter.congr
  filter_upwards [] with b
  rw [show (∫ a : ℂ, s.indicator f (a, b)) =
      Real.exp (-3 * Complex.normSq b) *
        (∫ a : ℂ in blockPositionSection n u halfWidth b,
          Real.exp (-Complex.normSq a)) by
    rw [← integral_const_mul]
    rw [← integral_indicator (measurableSet_blockPositionSection_all
      n u halfWidth b)]
    apply integral_congr_ae
    filter_upwards [] with a
    by_cases ha : a ∈ blockPositionSection n u halfWidth b
    · rw [Set.indicator_of_mem ha]
      have hp : (a, b) ∈ s := ha
      rw [Set.indicator_of_mem hp]
      dsimp [f]
      ring
    · rw [Set.indicator_of_notMem ha]
      have hp : (a, b) ∉ s := ha
      rw [Set.indicator_of_notMem hp]]

lemma blockVelocityMass_nonneg
    (velocityLower velocityUpper : ℝ) :
    0 ≤ blockVelocityMass velocityLower velocityUpper := by
  unfold blockVelocityMass
  exact setIntegral_nonneg
    (measurableSet_blockVelocityAnnulus velocityLower velocityUpper)
    (fun _ _ ↦ mul_nonneg (norm_nonneg _) (Real.exp_pos _).le)

lemma blockLimitingDensity_truncatedBlockRegion_upper
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower) :
    (∫ p : ℂ × ℂ in
        truncatedBlockRegion n u halfWidth velocityLower velocityUpper,
        blockLimitingDensity p) ≤
      (3 / Real.pi ^ 2) * (4 * halfWidth * (u / n)) *
        blockVelocityMass velocityLower velocityUpper := by
  rw [integral_blockLimitingDensity_truncatedBlockRegion]
  rw [show (3 / Real.pi ^ 2) * (4 * halfWidth * (u / n)) *
      blockVelocityMass velocityLower velocityUpper =
    (3 / Real.pi ^ 2) *
      ((4 * halfWidth * (u / n)) *
        blockVelocityMass velocityLower velocityUpper) by ring]
  have hconst : 0 ≤ 3 / Real.pi ^ 2 := by positivity
  apply mul_le_mul_of_nonneg_left _ hconst
  unfold blockVelocityMass
  rw [← integral_const_mul]
  apply setIntegral_mono_on
  · exact (integrable_blockSectionWeight n u halfWidth).integrableOn
  · exact integrable_complex_norm_mul_exp_neg_three_normSq.integrableOn.const_mul _
  · exact measurableSet_blockVelocityAnnulus velocityLower velocityUpper
  · intro b hb
    have hb0 : b ≠ 0 := by
      intro hbzero
      subst b
      simp only [blockVelocityAnnulus, Set.mem_setOf_eq, norm_zero] at hb
      linarith
    have hpos := blockPositionIntegral_upper n hn u halfWidth b hb0 hu hhalf
    have hexp : 0 ≤ Real.exp (-3 * Complex.normSq b) := (Real.exp_pos _).le
    calc
      Real.exp (-3 * Complex.normSq b) *
          (∫ a : ℂ in blockPositionSection n u halfWidth b,
            Real.exp (-Complex.normSq a)) ≤
        Real.exp (-3 * Complex.normSq b) *
          (4 * halfWidth * ‖b‖ * (u / n)) :=
        mul_le_mul_of_nonneg_left hpos hexp
      _ = 4 * halfWidth * (u / n) *
          (‖b‖ * Real.exp (-3 * Complex.normSq b)) := by ring

lemma blockLimitingDensity_truncatedBlockRegion_lower
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 ≤ velocityUpper) :
    (3 / Real.pi ^ 2) *
        Real.exp (-((halfWidth * velocityUpper) ^ 2 + (u / n) ^ 2)) *
        (4 * halfWidth * (u / n)) *
        blockVelocityMass velocityLower velocityUpper ≤
      (∫ p : ℂ × ℂ in
        truncatedBlockRegion n u halfWidth velocityLower velocityUpper,
        blockLimitingDensity p) := by
  rw [integral_blockLimitingDensity_truncatedBlockRegion]
  rw [show (3 / Real.pi ^ 2) *
      Real.exp (-((halfWidth * velocityUpper) ^ 2 + (u / n) ^ 2)) *
      (4 * halfWidth * (u / n)) *
      blockVelocityMass velocityLower velocityUpper =
    (3 / Real.pi ^ 2) *
      ((Real.exp (-((halfWidth * velocityUpper) ^ 2 + (u / n) ^ 2)) *
        (4 * halfWidth * (u / n))) *
        blockVelocityMass velocityLower velocityUpper) by ring]
  have hconst : 0 ≤ 3 / Real.pi ^ 2 := by positivity
  apply mul_le_mul_of_nonneg_left _ hconst
  unfold blockVelocityMass
  rw [← integral_const_mul]
  apply setIntegral_mono_on
  · exact integrable_complex_norm_mul_exp_neg_three_normSq.integrableOn.const_mul _
  · exact (integrable_blockSectionWeight n u halfWidth).integrableOn
  · exact measurableSet_blockVelocityAnnulus velocityLower velocityUpper
  · intro b hb
    have hb0 : b ≠ 0 := by
      intro hbzero
      subst b
      simp only [blockVelocityAnnulus, Set.mem_setOf_eq, norm_zero] at hb
      linarith
    have hpos := blockPositionIntegral_lower n hn u halfWidth b hb0 hu hhalf
    have hbUpper : ‖b‖ ≤ velocityUpper := hb.2
    have hhalfMul : halfWidth * ‖b‖ ≤ halfWidth * velocityUpper :=
      mul_le_mul_of_nonneg_left hbUpper hhalf
    have hhalfMul0 : 0 ≤ halfWidth * ‖b‖ :=
      mul_nonneg hhalf (norm_nonneg b)
    have hsq : (halfWidth * ‖b‖) ^ 2 ≤
        (halfWidth * velocityUpper) ^ 2 :=
      (sq_le_sq₀ hhalfMul0 (mul_nonneg hhalf hvelUpper)).2 hhalfMul
    have hexp :
        Real.exp (-((halfWidth * velocityUpper) ^ 2 + (u / n) ^ 2)) ≤
          Real.exp (-((halfWidth * ‖b‖) ^ 2 + (u / n) ^ 2)) := by
      apply Real.exp_le_exp.mpr
      linarith
    have hweight : 0 ≤ ‖b‖ * Real.exp (-3 * Complex.normSq b) :=
      mul_nonneg (norm_nonneg b) (Real.exp_pos _).le
    calc
      Real.exp (-((halfWidth * velocityUpper) ^ 2 + (u / n) ^ 2)) *
          (4 * halfWidth * (u / n)) *
          (‖b‖ * Real.exp (-3 * Complex.normSq b)) =
        Real.exp (-3 * Complex.normSq b) *
          (Real.exp (-((halfWidth * velocityUpper) ^ 2 + (u / n) ^ 2)) *
            (4 * halfWidth * ‖b‖ * (u / n))) := by ring
      _ ≤ Real.exp (-3 * Complex.normSq b) *
          (Real.exp (-((halfWidth * ‖b‖) ^ 2 + (u / n) ^ 2)) *
            (4 * halfWidth * ‖b‖ * (u / n))) := by
        have hfactor : 0 ≤ 4 * halfWidth * ‖b‖ * (u / n) := by positivity
        gcongr
      _ ≤ Real.exp (-3 * Complex.normSq b) *
          (∫ a : ℂ in blockPositionSection n u halfWidth b,
            Real.exp (-Complex.normSq a)) :=
        mul_le_mul_of_nonneg_left hpos (Real.exp_pos _).le

lemma localMeshHalfWidth_tendsto_zero :
    Tendsto localMeshHalfWidth atTop (nhds 0) := by
  have hinv : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (nhds 0) :=
    tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
  have hden :=
    (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (1 : ℝ)) atTop (nhds 1)).add
      (hinv.pow 2)
  have hquot := hinv.div hden (by norm_num : (1 : ℝ) + 0 ^ 2 ≠ 0)
  have h := hquot.const_mul Real.pi
  have h' : Tendsto (fun n : ℕ ↦
      Real.pi * (((n : ℝ))⁻¹ / (1 + ((n : ℝ))⁻¹ ^ 2)))
      atTop (nhds 0) := by simpa using h
  refine h'.congr' ?_
  filter_upwards [Nat.eventually_pos] with n hn
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  change Real.pi * (((n : ℝ))⁻¹ / (1 + ((n : ℝ))⁻¹ ^ 2)) =
    localMeshHalfWidth n
  unfold localMeshHalfWidth localMeshSize
  push_cast
  field_simp

lemma blockPositionGaussianError_tendsto_one
    (u velocityUpper : ℝ) :
    Tendsto (fun n : ℕ ↦
      Real.exp (-((localMeshHalfWidth n * velocityUpper) ^ 2 +
        (u / n) ^ 2))) atTop (nhds 1) := by
  have huDiv : Tendsto (fun n : ℕ ↦ u / (n : ℝ)) atTop (nhds 0) := by
    have h := (tendsto_inv_atTop_zero.comp
      tendsto_natCast_atTop_atTop).const_mul u
    convert h using 1 <;> simp [Function.comp_def, div_eq_mul_inv]
  have hinside : Tendsto (fun n : ℕ ↦
      -((localMeshHalfWidth n * velocityUpper) ^ 2 +
        (u / n) ^ 2)) atTop (nhds 0) := by
    have h := (((localMeshHalfWidth_tendsto_zero.mul_const velocityUpper).pow 2).add
      (huDiv.pow 2)).neg
    convert h using 1 <;> ring
  have h := Real.continuous_exp.continuousAt.tendsto.comp hinside
  convert h using 1 <;> simp [Function.comp_def]

noncomputable def truncatedBlockLimitingMass
    (n : ℕ) (u velocityLower velocityUpper : ℝ) : ℝ :=
  ∫ p : ℂ × ℂ in
    truncatedBlockRegion n u (localMeshHalfWidth n) velocityLower velocityUpper,
    blockLimitingDensity p

lemma scaled_blockCoefficient_eq
    (n : ℕ) (hn : 0 < n) (u velocityLower velocityUpper : ℝ) :
    (localMeshSize n : ℝ) *
        ((3 / Real.pi ^ 2) *
          (4 * localMeshHalfWidth n * (u / n)) *
          blockVelocityMass velocityLower velocityUpper) =
      (12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hmesh0 : (localMeshSize n : ℝ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (localMeshSize_pos n))
  have hpi0 := Real.pi_ne_zero
  unfold localMeshHalfWidth
  field_simp
  ring

theorem truncatedBlockLimitingMass_tendsto
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 ≤ velocityUpper) :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) *
        truncatedBlockLimitingMass n u velocityLower velocityUpper)
      atTop (nhds ((12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper)) := by
  let L : ℝ := (12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper
  let lower : ℕ → ℝ := fun n ↦
    Real.exp (-((localMeshHalfWidth n * velocityUpper) ^ 2 +
      (u / n) ^ 2)) * L
  have hlower : Tendsto lower atTop (nhds L) := by
    have h := (blockPositionGaussianError_tendsto_one u velocityUpper).mul
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ L) atTop (nhds L))
    simpa [lower] using h
  have hupper : Tendsto (fun _ : ℕ ↦ L) atTop (nhds L) :=
    tendsto_const_nhds
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlower hupper
  · filter_upwards [Nat.eventually_pos] with n hn
    have hbound := blockLimitingDensity_truncatedBlockRegion_lower
      n hn u (localMeshHalfWidth n) velocityLower velocityUpper hu
      (by unfold localMeshHalfWidth; positivity) hvelLower hvelUpper
    have hscale := mul_le_mul_of_nonneg_left hbound
      (Nat.cast_nonneg (localMeshSize n))
    change lower n ≤
      (localMeshSize n : ℝ) *
        truncatedBlockLimitingMass n u velocityLower velocityUpper
    rw [show lower n =
        Real.exp (-((localMeshHalfWidth n * velocityUpper) ^ 2 +
          (u / n) ^ 2)) *
          ((localMeshSize n : ℝ) *
            ((3 / Real.pi ^ 2) *
              (4 * localMeshHalfWidth n * (u / n)) *
              blockVelocityMass velocityLower velocityUpper)) by
        rw [scaled_blockCoefficient_eq n hn]
        ]
    unfold truncatedBlockLimitingMass
    simpa only [mul_assoc, mul_left_comm, mul_comm] using hscale
  · filter_upwards [Nat.eventually_pos] with n hn
    have hbound := blockLimitingDensity_truncatedBlockRegion_upper
      n hn u (localMeshHalfWidth n) velocityLower velocityUpper hu
      (by unfold localMeshHalfWidth; positivity) hvelLower
    have hscale := mul_le_mul_of_nonneg_left hbound
      (Nat.cast_nonneg (localMeshSize n))
    change (localMeshSize n : ℝ) *
        truncatedBlockLimitingMass n u velocityLower velocityUpper ≤ L
    rw [show L =
        (localMeshSize n : ℝ) *
          ((3 / Real.pi ^ 2) *
            (4 * localMeshHalfWidth n * (u / n)) *
            blockVelocityMass velocityLower velocityUpper) by
      exact (scaled_blockCoefficient_eq n hn u velocityLower velocityUpper).symm]
    simpa [truncatedBlockLimitingMass] using hscale

lemma integral_complex_norm_mul_exp_neg_three_normSq_eq_gamma :
    (∫ b : ℂ, ‖b‖ * Real.exp (-3 * Complex.normSq b)) =
      (2 * Real.pi / 2) *
        (3 : ℝ) ^ (-(1 + 2 : ℝ) / 2) *
          Real.Gamma ((1 + 2 : ℝ) / 2) := by
  simpa only [Real.rpow_one, Real.rpow_two, Complex.normSq_eq_norm_sq] using
    (Complex.integral_rpow_mul_exp_neg_mul_rpow
      (p := 2) (q := 1) (b := 3) (by norm_num) (by norm_num) (by norm_num))

lemma three_rpow_neg_three_halves :
    (3 : ℝ) ^ (-(1 + 2 : ℝ) / 2) =
      (3 * Real.sqrt 3)⁻¹ := by
  rw [show (-(1 + 2 : ℝ) / 2) = -(1 + 1 / 2) by norm_num]
  rw [Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 3)]
  rw [Real.rpow_add (by norm_num : (0 : ℝ) < 3)]
  rw [Real.rpow_one, ← Real.sqrt_eq_rpow]

lemma scaled_total_velocityMass_eq_rate (u : ℝ) :
    (12 * u / Real.pi) *
        (∫ b : ℂ, ‖b‖ * Real.exp (-3 * Complex.normSq b)) =
      4 * rate * u := by
  rw [integral_complex_norm_mul_exp_neg_three_normSq_eq_gamma]
  rw [three_rpow_neg_three_halves]
  rw [show ((1 + 2 : ℝ) / 2) = 1 / 2 + 1 by norm_num]
  rw [Real.Gamma_add_one (by norm_num), Real.Gamma_one_half_eq]
  unfold rate
  rw [Real.sqrt_div (by positivity : 0 ≤ Real.pi)]
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  have hsqrt3 : Real.sqrt 3 ≠ 0 := by positivity
  have hsqrt12 : Real.sqrt 12 = 2 * Real.sqrt 3 := by
    rw [show (12 : ℝ) = 4 * 3 by norm_num,
      Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
    norm_num
  rw [hsqrt12]
  field_simp
  ring

noncomputable def blockVelocityExhaustion (k : ℕ) : Set ℂ :=
  blockVelocityAnnulus (1 / (k + 1 : ℝ)) (k + 1 : ℝ)

lemma blockVelocityMass_exhaustion_tendsto :
    Tendsto (fun k : ℕ ↦
      blockVelocityMass (1 / (k + 1 : ℝ)) (k + 1 : ℝ)) atTop
      (nhds (∫ b : ℂ, ‖b‖ * Real.exp (-3 * Complex.normSq b))) := by
  let f : ℂ → ℝ := fun b ↦
    ‖b‖ * Real.exp (-3 * Complex.normSq b)
  let F : ℕ → ℂ → ℝ := fun k ↦ (blockVelocityExhaustion k).indicator f
  have hDCT := tendsto_integral_of_dominated_convergence f
    (F := F) (f := f)
    (fun k ↦ (integrable_complex_norm_mul_exp_neg_three_normSq.aestronglyMeasurable.indicator
      (measurableSet_blockVelocityAnnulus
        (1 / (k + 1 : ℝ)) (k + 1 : ℝ))))
    integrable_complex_norm_mul_exp_neg_three_normSq
    (fun k ↦ Eventually.of_forall fun b ↦ by
      have hf0 : 0 ≤ f b := by
        dsimp [f]
        positivity
      by_cases hb : b ∈ blockVelocityExhaustion k
      · rw [show F k b = f b by simp [F, hb]]
        simpa [Real.norm_eq_abs, abs_of_nonneg hf0]
      · rw [show F k b = 0 by simp [F, hb]]
        simpa [Real.norm_eq_abs] using hf0)
    (by
      filter_upwards [volume.ae_ne (0 : ℂ)] with b hb
      have hbpos : 0 < ‖b‖ := norm_pos_iff.mpr hb
      have hlower : ∀ᶠ k : ℕ in atTop,
          1 / (k + 1 : ℝ) < ‖b‖ :=
        tendsto_one_div_add_atTop_nhds_zero_nat.eventually
          (Iio_mem_nhds hbpos)
      have hupperT : Tendsto (fun k : ℕ ↦ (k : ℝ) + 1) atTop atTop :=
        tendsto_atTop_add_const_right atTop 1 tendsto_natCast_atTop_atTop
      have hupper : ∀ᶠ k : ℕ in atTop, ‖b‖ < (k : ℝ) + 1 :=
        hupperT.eventually (eventually_gt_atTop ‖b‖)
      apply tendsto_const_nhds.congr'
      filter_upwards [hlower, hupper] with k hl hu
      have hmem : b ∈ blockVelocityExhaustion k := by
        exact ⟨hl.le, by simpa only [Nat.cast_add, Nat.cast_one] using hu.le⟩
      simp [F, hmem])
  apply hDCT.congr'
  filter_upwards [] with k
  dsimp [F, f, blockVelocityMass, blockVelocityExhaustion]
  rw [integral_indicator
    (measurableSet_blockVelocityAnnulus (1 / (k + 1 : ℝ)) (k + 1 : ℝ))]

noncomputable def phaseBlockComplexLinearEquivₗ :
    EuclideanSpace ℝ (Fin 4) ≃ₗ[ℝ] WithLp 2 (ℂ × ℂ) where
  toFun x := WithLp.toLp 2
    ((⟨x 0, x 1⟩ : ℂ), (⟨x 2, x 3⟩ : ℂ))
  invFun p := WithLp.toLp 2 ![
    (WithLp.ofLp p).1.re, (WithLp.ofLp p).1.im,
    (WithLp.ofLp p).2.re, (WithLp.ofLp p).2.im]
  left_inv x := by
    apply PiLp.ext
    intro c
    fin_cases c <;> rfl
  right_inv p := by
    apply WithLp.ofLp_injective 2
    apply Prod.ext <;> apply Complex.ext <;> rfl
  map_add' x y := by
    apply WithLp.ofLp_injective 2
    apply Prod.ext <;> apply Complex.ext <;> rfl
  map_smul' c x := by
    apply WithLp.ofLp_injective 2
    apply Prod.ext <;> apply Complex.ext <;> simp

@[simp] lemma phaseBlockComplexLinearEquivₗ_fst
    (x : EuclideanSpace ℝ (Fin 4)) :
    (phaseBlockComplexLinearEquivₗ x).fst = (⟨x 0, x 1⟩ : ℂ) := rfl

@[simp] lemma phaseBlockComplexLinearEquivₗ_snd
    (x : EuclideanSpace ℝ (Fin 4)) :
    (phaseBlockComplexLinearEquivₗ x).snd = (⟨x 2, x 3⟩ : ℂ) := rfl

noncomputable def phaseBlockComplexLinearEquiv :
    EuclideanSpace ℝ (Fin 4) ≃ₗᵢ[ℝ] WithLp 2 (ℂ × ℂ) where
  toLinearEquiv := phaseBlockComplexLinearEquivₗ
  norm_map' x := by
    rw [← sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)]
    rw [WithLp.prod_norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2]
    change ‖(phaseBlockComplexLinearEquivₗ x).fst‖ ^ 2 +
      ‖(phaseBlockComplexLinearEquivₗ x).snd‖ ^ 2 =
        ∑ i : Fin 4, ‖x i‖ ^ 2
    rw [phaseBlockComplexLinearEquivₗ_fst, phaseBlockComplexLinearEquivₗ_snd]
    rw [Complex.sq_norm, Complex.sq_norm]
    simp only [Complex.normSq_apply]
    rw [Fin.sum_univ_four]
    simp only [Real.norm_eq_abs, sq_abs]
    ring

@[simp] lemma phaseBlockComplexLinearEquiv_apply
    (x : EuclideanSpace ℝ (Fin 4)) :
    WithLp.ofLp (phaseBlockComplexLinearEquiv x) =
      ((⟨x 0, x 1⟩ : ℂ), (⟨x 2, x 3⟩ : ℂ)) := rfl

abbrev PhaseBlockLp (m : ℕ) :=
  PiLp 2 (fun _ : Fin m ↦ WithLp 2 (ℂ × ℂ))

noncomputable def phaseToBlockLp :
    PhaseEuclidean m ≃ₗᵢ[ℝ] PhaseBlockLp m :=
  (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ
      (Equiv.sigmaEquivProd (Fin m) (Fin 4)).symm).trans
    ((LinearIsometryEquiv.piLpCurry ℝ 2
      (fun _ : Fin m ↦ fun _ : Fin 4 ↦ ℝ)).trans
        (LinearIsometryEquiv.piLpCongrRight 2
          (fun _ : Fin m ↦ phaseBlockComplexLinearEquiv)))

@[simp] lemma phaseToBlockLp_apply_ofLp
    (y : PhaseEuclidean m) (r : Fin m) :
    WithLp.ofLp ((phaseToBlockLp y) r) =
      ((⟨y (r, 0), y (r, 1)⟩ : ℂ),
        (⟨y (r, 2), y (r, 3)⟩ : ℂ)) := by
  rfl

noncomputable def phaseToBlocks (y : PhaseEuclidean m) :
    Fin m → (ℂ × ℂ) :=
  fun r ↦ WithLp.ofLp ((phaseToBlockLp y) r)

@[simp] lemma phaseToBlocks_apply (y : PhaseEuclidean m) (r : Fin m) :
    phaseToBlocks y r =
      ((⟨y (r, 0), y (r, 1)⟩ : ℂ),
        (⟨y (r, 2), y (r, 3)⟩ : ℂ)) := rfl

noncomputable def piLpFinSuccLinearEquiv
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (n : ℕ) :
    PiLp 2 (fun _ : Fin (n + 1) ↦ E) ≃ₗ[ℝ]
      WithLp 2 (E × PiLp 2 (fun _ : Fin n ↦ E)) where
  toFun x := WithLp.toLp 2 (x 0, WithLp.toLp 2 (fun j ↦ x j.succ))
  invFun p := WithLp.toLp 2
    (Fin.cons (WithLp.ofLp p).1 (fun j ↦ (WithLp.ofLp p).2 j))
  left_inv x := by
    apply PiLp.ext
    intro i
    refine Fin.cases ?_ (fun j ↦ ?_) i <;> rfl
  right_inv p := by
    apply WithLp.ofLp_injective 2
    apply Prod.ext
    · rfl
    · apply PiLp.ext
      intro j
      rfl
  map_add' x y := by
    apply WithLp.ofLp_injective 2
    apply Prod.ext
    · rfl
    · apply PiLp.ext
      intro j
      rfl
  map_smul' c x := by
    apply WithLp.ofLp_injective 2
    apply Prod.ext
    · rfl
    · apply PiLp.ext
      intro j
      rfl

@[simp] lemma piLpFinSuccLinearEquiv_fst
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (n : ℕ) (x : PiLp 2 (fun _ : Fin (n + 1) ↦ E)) :
    (piLpFinSuccLinearEquiv n x).fst = x 0 := rfl

@[simp] lemma piLpFinSuccLinearEquiv_snd_apply
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (n : ℕ) (x : PiLp 2 (fun _ : Fin (n + 1) ↦ E)) (j : Fin n) :
    (piLpFinSuccLinearEquiv n x).snd j = x j.succ := rfl

noncomputable def piLpFinSuccIsometryEquiv
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (n : ℕ) :
    PiLp 2 (fun _ : Fin (n + 1) ↦ E) ≃ₗᵢ[ℝ]
      WithLp 2 (E × PiLp 2 (fun _ : Fin n ↦ E)) where
  toLinearEquiv := piLpFinSuccLinearEquiv n
  norm_map' x := by
    rw [← sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)]
    rw [WithLp.prod_norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2,
      PiLp.norm_sq_eq_of_L2]
    rw [piLpFinSuccLinearEquiv_fst]
    simp_rw [piLpFinSuccLinearEquiv_snd_apply]
    rw [Fin.sum_univ_succ]

noncomputable def piLpFinOneIsometryEquiv
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] :
    PiLp 2 (fun _ : Fin 1 ↦ E) ≃ₗᵢ[ℝ] E where
  toFun x := x 0
  invFun e := WithLp.toLp 2 (fun _ ↦ e)
  left_inv x := by
    apply PiLp.ext
    intro i
    exact Fin.eq_zero i ▸ rfl
  right_inv e := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  norm_map' x := by
    rw [PiLp.norm_eq_of_L2]
    simp
    rfl

lemma measurePreserving_piLp_ofLp_fin_one
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E] :
    MeasurePreserving (@WithLp.ofLp 2 (Fin 1 → E)) := by
  have h₁ : MeasurePreserving
      (piLpFinOneIsometryEquiv (E := E) :
        PiLp 2 (fun _ : Fin 1 ↦ E) → E)
      (volume : Measure (PiLp 2 (fun _ : Fin 1 ↦ E)))
      (volume : Measure E) :=
    LinearIsometryEquiv.measurePreserving
      (piLpFinOneIsometryEquiv (E := E))
  have h₂ : MeasurePreserving
      (MeasurableEquiv.piUnique (fun _ : Fin 1 ↦ E))
      (volume : Measure (Fin 1 → E)) (volume : Measure E) :=
    volume_preserving_piUnique (fun _ : Fin 1 ↦ E)
  have h₂' : MeasurePreserving
      (MeasurableEquiv.piUnique (fun _ : Fin 1 ↦ E)).symm
      (volume : Measure E) (volume : Measure (Fin 1 → E)) :=
    h₂.symm (MeasurableEquiv.piUnique (fun _ : Fin 1 ↦ E))
  convert! h₂'.comp h₁ using 1
  ext x i
  exact Fin.eq_zero i ▸ rfl

theorem measurePreserving_piLp_ofLp_fin_succ
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E]
    (n : ℕ) :
    MeasurePreserving (@WithLp.ofLp 2 (Fin (n + 1) → E)) := by
  induction n with
  | zero =>
      simpa using (measurePreserving_piLp_ofLp_fin_one (E := E))
  | succ n ih =>
      have h₁ := LinearIsometryEquiv.measurePreserving
        (piLpFinSuccIsometryEquiv (E := E) (n + 1))
      have h₂ := WithLp.volume_preserving_ofLp E
        (PiLp 2 (fun _ : Fin (n + 1) ↦ E))
      have h₃ := MeasurePreserving.prod
        (MeasurePreserving.id (volume : Measure E)) ih
      have h₄ := (volume_preserving_piFinSuccAbove
        (fun _ : Fin (n + 2) ↦ E) 0).symm
          (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 2) ↦ E) 0)
      convert! h₄.comp (h₃.comp (h₂.comp h₁)) using 1
      ext x i
      refine Fin.cases ?_ (fun j ↦ ?_) i <;> rfl

lemma measurePreserving_phaseToBlocks (hm : 0 < m) :
    MeasurePreserving (phaseToBlocks :
      PhaseEuclidean m → Fin m → (ℂ × ℂ)) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hm)
  have h₁ := LinearIsometryEquiv.measurePreserving
    (phaseToBlockLp (m := k + 1))
  have h₂ := measurePreserving_piLp_ofLp_fin_succ
    (E := WithLp 2 (ℂ × ℂ)) k
  have h₃ := volume_preserving_pi
    (fun _ : Fin (k + 1) ↦ WithLp.volume_preserving_ofLp ℂ ℂ)
  convert! h₃.comp (h₂.comp h₁) using 1

noncomputable def phaseToBlocksMeasurableEquiv :
    PhaseEuclidean m ≃ᵐ (Fin m → (ℂ × ℂ)) :=
  (phaseToBlockLp (m := m)).toHomeomorph.toMeasurableEquiv.trans
    ((MeasurableEquiv.toLp 2
      (Fin m → WithLp 2 (ℂ × ℂ))).symm.trans
        (MeasurableEquiv.piCongrRight
          (fun _ : Fin m ↦ (MeasurableEquiv.toLp 2 (ℂ × ℂ)).symm)))

@[simp] lemma phaseToBlocksMeasurableEquiv_apply
    (y : PhaseEuclidean m) :
    phaseToBlocksMeasurableEquiv y = phaseToBlocks y := rfl

lemma measurableEmbedding_phaseToBlocks :
    MeasurableEmbedding (phaseToBlocks :
      PhaseEuclidean m → Fin m → (ℂ × ℂ)) := by
  convert (phaseToBlocksMeasurableEquiv (m := m)).measurableEmbedding using 1
  funext y
  rfl

noncomputable def phaseBlockProductDensity
    (x : Fin m → (ℂ × ℂ)) : ℝ :=
  ∏ r : Fin m, blockLimitingDensity (x r)

lemma phaseLimitingDensity_eq_blockProduct
    (y : PhaseEuclidean m) :
    phaseLimitingDensity y = phaseBlockProductDensity (phaseToBlocks y) := by
  unfold phaseLimitingDensity phaseBlockProductDensity blockLimitingDensity
  apply Finset.prod_congr rfl
  intro r _
  rw [phaseToBlocks_apply, Complex.normSq_apply, Complex.normSq_apply]
  ring_nf

def truncatedBlockSet
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    Set (ℂ × ℂ) :=
  truncatedBlockRegion n u halfWidth velocityLower velocityUpper

def truncatedPhaseRegion
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    Set (PhaseEuclidean m) :=
  phaseToBlocks ⁻¹' Set.univ.pi
    (fun _ : Fin m ↦ truncatedBlockSet n u halfWidth velocityLower velocityUpper)

lemma measurableSet_truncatedBlockSet
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    MeasurableSet (truncatedBlockSet n u halfWidth velocityLower velocityUpper) := by
  simpa only [truncatedBlockSet, truncatedBlockRegion] using
    measurableSet_truncatedBlockRegion n u halfWidth velocityLower velocityUpper

lemma measurableSet_truncatedBlockPi
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    MeasurableSet (Set.univ.pi
      (fun _ : Fin m ↦ truncatedBlockSet n u halfWidth velocityLower velocityUpper)) :=
  MeasurableSet.univ_pi fun _ ↦
    measurableSet_truncatedBlockSet n u halfWidth velocityLower velocityUpper

lemma blockProduct_indicator_pi
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ)
    (x : Fin m → (ℂ × ℂ)) :
    (Set.univ.pi (fun _ : Fin m ↦
      truncatedBlockSet n u halfWidth velocityLower velocityUpper)).indicator
        phaseBlockProductDensity x =
      ∏ r : Fin m,
        (truncatedBlockSet n u halfWidth velocityLower velocityUpper).indicator
          blockLimitingDensity (x r) := by
  classical
  by_cases hx : ∀ r : Fin m,
      x r ∈ truncatedBlockSet n u halfWidth velocityLower velocityUpper
  · have hxpi : x ∈ Set.univ.pi (fun _ : Fin m ↦
        truncatedBlockSet n u halfWidth velocityLower velocityUpper) := by
      intro r _
      exact hx r
    rw [Set.indicator_of_mem hxpi]
    unfold phaseBlockProductDensity
    apply Finset.prod_congr rfl
    intro r _
    rw [Set.indicator_of_mem (hx r)]
  · have hxpi : x ∉ Set.univ.pi (fun _ : Fin m ↦
        truncatedBlockSet n u halfWidth velocityLower velocityUpper) := by
      intro hmem
      apply hx
      intro r
      exact hmem r (Set.mem_univ r)
    rw [Set.indicator_of_notMem hxpi]
    obtain ⟨r, hr⟩ := not_forall.mp hx
    exact (Finset.prod_eq_zero (Finset.mem_univ r)
      (Set.indicator_of_notMem hr _)).symm

lemma integral_phaseBlockProductDensity_truncatedPi
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    (∫ x : Fin m → (ℂ × ℂ) in
        Set.univ.pi (fun _ : Fin m ↦
          truncatedBlockSet n u halfWidth velocityLower velocityUpper),
        phaseBlockProductDensity x) =
      (∫ p : ℂ × ℂ in truncatedBlockSet n u halfWidth
        velocityLower velocityUpper, blockLimitingDensity p) ^ m := by
  rw [← integral_indicator
    (measurableSet_truncatedBlockPi
      (m := m) n u halfWidth velocityLower velocityUpper)]
  simp_rw [blockProduct_indicator_pi]
  rw [integral_fintype_prod_volume_eq_prod, Finset.prod_const]
  congr 1
  rw [integral_indicator
    (measurableSet_truncatedBlockSet n u halfWidth velocityLower velocityUpper)]
  simp

lemma integral_phaseLimitingDensity_truncatedPhaseRegion
    (hm : 0 < m) (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ) :
    (∫ y in truncatedPhaseRegion (m := m) n u halfWidth
        velocityLower velocityUpper, phaseLimitingDensity y) =
      (∫ p : ℂ × ℂ in truncatedBlockSet n u halfWidth
        velocityLower velocityUpper, blockLimitingDensity p) ^ m := by
  have hs : MeasurableSet
      (truncatedPhaseRegion (m := m) n u halfWidth velocityLower velocityUpper) :=
    (measurableSet_truncatedBlockPi
      (m := m) n u halfWidth velocityLower velocityUpper).preimage
        (measurePreserving_phaseToBlocks (m := m) hm).measurable
  calc
    (∫ y in truncatedPhaseRegion (m := m) n u halfWidth
        velocityLower velocityUpper, phaseLimitingDensity y) =
        ∫ y in truncatedPhaseRegion (m := m) n u halfWidth
          velocityLower velocityUpper,
            phaseBlockProductDensity (phaseToBlocks y) :=
      setIntegral_congr_fun hs fun y _ ↦ phaseLimitingDensity_eq_blockProduct y
    _ = ∫ x : Fin m → (ℂ × ℂ) in
        Set.univ.pi (fun _ : Fin m ↦
          truncatedBlockSet n u halfWidth velocityLower velocityUpper),
        phaseBlockProductDensity x := by
      exact (measurePreserving_phaseToBlocks (m := m) hm).setIntegral_preimage_emb
        (measurableEmbedding_phaseToBlocks (m := m)) _ _
    _ = _ := integral_phaseBlockProductDensity_truncatedPi
      (m := m) n u halfWidth velocityLower velocityUpper

lemma integral_phaseLimitingDensity_truncatedMeshRegion
    (hm : 0 < m) (n : ℕ) (u velocityLower velocityUpper : ℝ) :
    (∫ y in truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
        velocityLower velocityUpper, phaseLimitingDensity y) =
      (truncatedBlockLimitingMass n u velocityLower velocityUpper) ^ m := by
  simpa [truncatedBlockLimitingMass, truncatedBlockSet] using
    (integral_phaseLimitingDensity_truncatedPhaseRegion
      (m := m) hm n u (localMeshHalfWidth n) velocityLower velocityUpper)

lemma scaled_truncatedPhaseLimitingMass_tendsto
    (m : ℕ) (hm : 0 < m) (u velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 ≤ velocityUpper) :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) ^ m *
        ∫ y in truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
          velocityLower velocityUpper, phaseLimitingDensity y)
      atTop (nhds (((12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper) ^ m)) := by
  have hblock := (truncatedBlockLimitingMass_tendsto
    u velocityLower velocityUpper hu hvelLower hvelUpper).pow m
  apply hblock.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  rw [integral_phaseLimitingDensity_truncatedMeshRegion
    (m := m) hm n u velocityLower velocityUpper]
  rw [mul_pow]

lemma scaled_exhaustedBlockMass_tendsto (u : ℝ) :
    Tendsto (fun k : ℕ ↦
      (12 * u / Real.pi) *
        blockVelocityMass (1 / (k + 1 : ℝ)) (k + 1 : ℝ))
      atTop (nhds (4 * rate * u)) := by
  have h := (blockVelocityMass_exhaustion_tendsto.const_mul
    (12 * u / Real.pi))
  rw [scaled_total_velocityMass_eq_rate u] at h
  exact h

lemma scaled_exhaustedBlockMass_pow_tendsto (m : ℕ) (u : ℝ) :
    Tendsto (fun k : ℕ ↦
      (((12 * u / Real.pi) *
        blockVelocityMass (1 / (k + 1 : ℝ)) (k + 1 : ℝ)) ^ m))
      atTop (nhds ((4 * rate * u) ^ m)) :=
  (scaled_exhaustedBlockMass_tendsto u).pow m

lemma blockRotatedPosition_re (a b : ℂ) (hb : b ≠ 0) :
    (blockRotatedPosition a b).re = (a * conj b).re / ‖b‖ := by
  have hnorm : ‖b‖ ≠ 0 := norm_ne_zero_iff.mpr hb
  unfold blockRotatedPosition
  rw [Complex.div_re]
  simp [Complex.normSq_eq_norm_sq]
  field_simp

lemma blockRotatedPosition_im (a b : ℂ) (hb : b ≠ 0) :
    (blockRotatedPosition a b).im = (a * conj b).im / ‖b‖ := by
  have hnorm : ‖b‖ ≠ 0 := norm_ne_zero_iff.mpr hb
  unfold blockRotatedPosition
  rw [Complex.div_im]
  simp [Complex.normSq_eq_norm_sq]
  field_simp

lemma phaseToBlocks_phaseToEuclidean
    (z : PhaseCoordinate m) (r : Fin m) :
    phaseToBlocks (phaseToEuclidean z) r =
      (phasePosition z r, phaseVelocity z r) := rfl

lemma phaseToBlocks_normalizedPhaseEuclideanWalk
    (n : ℕ) (e : SignVector (2 * n)) (points : Fin m → ℝ) (r : Fin m) :
    phaseToBlocks (normalizedPhaseEuclideanWalk n e points) r =
      (rescaledCenteredEval n e (points r),
        rescaledCenteredVelocity n e (points r)) := by
  rw [show normalizedPhaseEuclideanWalk n e points =
      phaseToEuclidean (normalizedPhaseWalk n e points) by rfl]
  rw [phaseToBlocks_phaseToEuclidean,
    phasePosition_normalizedPhaseWalk, phaseVelocity_normalizedPhaseWalk]

lemma isTruncatedBlockRepresentative_iff_phase
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (z : PhaseCoordinate m) (r : Fin m) :
    IsTruncatedBlockRepresentative n u halfWidth velocityLower velocityUpper
        (phasePosition z r, phaseVelocity z r) ↔
      IsPhaseRepresentative n u halfWidth z r ∧
        velocityLower ≤ ‖phaseVelocity z r‖ ∧
        ‖phaseVelocity z r‖ ≤ velocityUpper := by
  let a := phasePosition z r
  let b := phaseVelocity z r
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  constructor
  · rintro ⟨hb, hlow, hupp, hre, him⟩
    change b ≠ 0 at hb
    change velocityLower ≤ ‖b‖ at hlow
    change ‖b‖ ≤ velocityUpper at hupp
    change |(blockRotatedPosition a b).re| ≤ halfWidth * ‖b‖ at hre
    change |(blockRotatedPosition a b).im| ≤ u / n at him
    have hbNorm : 0 < ‖b‖ := norm_pos_iff.mpr hb
    refine ⟨⟨hb, ?_, ?_⟩, hlow, hupp⟩
    · unfold phaseAffineOffset affineClosestOffset
      change |-((a * conj b).re) / Complex.normSq b| ≤ halfWidth
      rw [abs_div, abs_neg, Complex.normSq_eq_norm_sq,
        abs_of_nonneg (sq_nonneg ‖b‖)]
      rw [blockRotatedPosition_re a b hb] at hre
      rw [abs_div, abs_of_pos hbNorm] at hre
      exact (div_le_iff₀ (sq_pos_of_pos hbNorm)).2 (by
        calc
          |(a * conj b).re| ≤ halfWidth * ‖b‖ ^ 2 := by
            calc
              |(a * conj b).re| =
                  (|(a * conj b).re| / ‖b‖) * ‖b‖ := by field_simp
              _ ≤ (halfWidth * ‖b‖) * ‖b‖ :=
                mul_le_mul_of_nonneg_right hre hbNorm.le
              _ = _ := by ring
          _ = halfWidth * ‖b‖ ^ 2 := rfl)
    · unfold phaseSignedHeight
      change |n * ((a * conj b).im / ‖b‖)| ≤ u
      rw [← blockRotatedPosition_im a b hb]
      rw [abs_mul, abs_of_pos hnreal]
      have hmul := mul_le_mul_of_nonneg_left him hnreal.le
      calc
        (n : ℝ) * |(blockRotatedPosition a b).im| ≤
            (n : ℝ) * (u / n) := hmul
        _ = u := by field_simp
  · rintro ⟨⟨hb, hoff, hheight⟩, hlow, hupp⟩
    change b ≠ 0 at hb
    change velocityLower ≤ ‖b‖ at hlow
    change ‖b‖ ≤ velocityUpper at hupp
    have hbNorm : 0 < ‖b‖ := norm_pos_iff.mpr hb
    refine ⟨hb, hlow, hupp, ?_, ?_⟩
    · unfold phaseAffineOffset affineClosestOffset at hoff
      change |-((a * conj b).re) / Complex.normSq b| ≤ halfWidth at hoff
      rw [abs_div, abs_neg, Complex.normSq_eq_norm_sq,
        abs_of_nonneg (sq_nonneg ‖b‖)] at hoff
      rw [blockRotatedPosition_re a b hb, abs_div, abs_of_pos hbNorm]
      have := (div_le_iff₀ (sq_pos_of_pos hbNorm)).1 hoff
      apply (div_le_iff₀ hbNorm).2
      nlinarith
    · unfold phaseSignedHeight at hheight
      change |n * ((a * conj b).im / ‖b‖)| ≤ u at hheight
      rw [abs_mul, abs_of_pos hnreal] at hheight
      rw [blockRotatedPosition_im a b hb]
      exact (le_div_iff₀ hnreal).2 (by simpa [mul_comm] using hheight)

lemma mem_truncatedBlockRegion_iff
    (n : ℕ) (u halfWidth velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower) (p : ℂ × ℂ) :
    p ∈ truncatedBlockRegion n u halfWidth velocityLower velocityUpper ↔
      IsTruncatedBlockRepresentative n u halfWidth
        velocityLower velocityUpper p := by
  constructor
  · intro hp
    rcases hp with ⟨⟨hlow, hupp⟩, hpos⟩
    have hvel : p.2 ≠ 0 := by
      intro hz
      simpa [hz] using (hvelLower.trans_le hlow).ne'
    exact ⟨hvel, hlow, hupp, hpos.1, hpos.2⟩
  · rintro ⟨_hb, hlow, hupp, hre, him⟩
    exact ⟨⟨hlow, hupp⟩, hre, him⟩

def IsTruncatedLocalRepresentative
    (n : ℕ) (u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n)) : Prop :=
  IsLocalRepresentative n u e a ∧
    velocityLower ≤
      ‖rescaledCenteredVelocity n e (localMeshPoint n a)‖ ∧
    ‖rescaledCenteredVelocity n e (localMeshPoint n a)‖ ≤ velocityUpper

lemma joint_truncatedLocalRepresentatives_iff_region
    (n : ℕ) (hn : 0 < n) (u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower)
    (e : SignVector (2 * n))
    (s : Finset (Fin (localMeshSize n))) :
    (∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) ↔
      normalizedPhaseEuclideanWalk n e (localSitesPoints s) ∈
        truncatedPhaseRegion (m := s.card) n u (localMeshHalfWidth n)
          velocityLower velocityUpper := by
  rw [truncatedPhaseRegion]
  change (∀ a ∈ s,
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) ↔
    phaseToBlocks (normalizedPhaseEuclideanWalk n e (localSitesPoints s)) ∈
      Set.univ.pi (fun _ : Fin s.card ↦
        truncatedBlockSet n u (localMeshHalfWidth n) velocityLower velocityUpper)
  constructor
  · intro h r _hr
    have ha := h (localSite s r) (localSite_mem s r)
    rw [truncatedBlockSet,
      mem_truncatedBlockRegion_iff n u (localMeshHalfWidth n)
        velocityLower velocityUpper hvelLower]
    rw [phaseToBlocks_normalizedPhaseEuclideanWalk]
    rw [← phasePosition_normalizedPhaseWalk n e (localSitesPoints s) r,
      ← phaseVelocity_normalizedPhaseWalk n e (localSitesPoints s) r]
    rw [isTruncatedBlockRepresentative_iff_phase
      (m := s.card) n hn u (localMeshHalfWidth n) velocityLower velocityUpper]
    refine ⟨?_, ?_⟩
    rw [isPhaseRepresentative_normalized_iff]
    exact ha.1
    rw [phaseVelocity_normalizedPhaseWalk]
    exact ha.2
  · intro h a ha
    rcases localSite_surjective s ha with ⟨r, rfl⟩
    have hr := h r (Set.mem_univ r)
    rw [truncatedBlockSet,
      mem_truncatedBlockRegion_iff n u (localMeshHalfWidth n)
        velocityLower velocityUpper hvelLower] at hr
    rw [phaseToBlocks_normalizedPhaseEuclideanWalk] at hr
    rw [← phasePosition_normalizedPhaseWalk n e (localSitesPoints s) r,
      ← phaseVelocity_normalizedPhaseWalk n e (localSitesPoints s) r] at hr
    rw [isTruncatedBlockRepresentative_iff_phase
      (m := s.card) n hn u (localMeshHalfWidth n) velocityLower velocityUpper] at hr
    refine ⟨?_, ?_⟩
    rw [isPhaseRepresentative_normalized_iff] at hr
    exact hr.1
    rw [phaseVelocity_normalizedPhaseWalk] at hr
    exact hr.2

lemma norm_fst_withLpProd_le
    {E F : Type*} [NormedAddCommGroup E] [NormedAddCommGroup F]
    (p : WithLp 2 (E × F)) : ‖(WithLp.ofLp p).1‖ ≤ ‖p‖ := by
  rw [← sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)]
  rw [WithLp.prod_norm_sq_eq_of_L2]
  exact le_add_of_nonneg_right (sq_nonneg _)

lemma norm_snd_withLpProd_le
    {E F : Type*} [NormedAddCommGroup E] [NormedAddCommGroup F]
    (p : WithLp 2 (E × F)) : ‖(WithLp.ofLp p).2‖ ≤ ‖p‖ := by
  rw [← sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)]
  rw [WithLp.prod_norm_sq_eq_of_L2]
  exact le_add_of_nonneg_left (sq_nonneg _)

lemma norm_phaseToBlocks_fst_sub_le
    (x y : PhaseEuclidean m) (r : Fin m) :
    ‖(phaseToBlocks x r).1 - (phaseToBlocks y r).1‖ ≤ ‖x - y‖ := by
  calc
    ‖(phaseToBlocks x r).1 - (phaseToBlocks y r).1‖ =
        ‖(WithLp.ofLp ((phaseToBlockLp (x - y)) r)).1‖ := by
      congr 1
    _ ≤ ‖(phaseToBlockLp (x - y)) r‖ := norm_fst_withLpProd_le _
    _ ≤ ‖phaseToBlockLp (x - y)‖ := PiLp.norm_apply_le _ r
    _ = ‖x - y‖ := LinearIsometryEquiv.norm_map _ _

lemma norm_phaseToBlocks_snd_sub_le
    (x y : PhaseEuclidean m) (r : Fin m) :
    ‖(phaseToBlocks x r).2 - (phaseToBlocks y r).2‖ ≤ ‖x - y‖ := by
  calc
    ‖(phaseToBlocks x r).2 - (phaseToBlocks y r).2‖ =
        ‖(WithLp.ofLp ((phaseToBlockLp (x - y)) r)).2‖ := by
      congr 1
    _ ≤ ‖(phaseToBlockLp (x - y)) r‖ := norm_snd_withLpProd_le _
    _ ≤ ‖phaseToBlockLp (x - y)‖ := PiLp.norm_apply_le _ r
    _ = ‖x - y‖ := LinearIsometryEquiv.norm_map _ _

noncomputable def normalizedConjugateDirection (b : ℂ) : ℂ :=
  conj b / (‖b‖ : ℂ)

lemma norm_normalizedConjugateDirection (b : ℂ) (hb : b ≠ 0) :
    ‖normalizedConjugateDirection b‖ = 1 := by
  unfold normalizedConjugateDirection
  rw [norm_div, Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (norm_pos_iff.mpr hb), div_self (norm_ne_zero_iff.mpr hb)]

lemma norm_normalizedConjugateDirection_sub_le
    (b c : ℂ) (eta : ℝ) (heta : 0 < eta)
    (hb : eta ≤ ‖b‖) (hc : eta ≤ ‖c‖) :
    ‖normalizedConjugateDirection b - normalizedConjugateDirection c‖ ≤
      (2 / eta) * ‖b - c‖ := by
  have hbpos : 0 < ‖b‖ := heta.trans_le hb
  have hcpos : 0 < ‖c‖ := heta.trans_le hc
  have hdecomp : normalizedConjugateDirection b - normalizedConjugateDirection c =
      (conj b - conj c) / (‖b‖ : ℂ) +
        conj c * (((‖c‖ : ℝ) - ‖b‖) / (‖b‖ * ‖c‖) : ℝ) := by
    unfold normalizedConjugateDirection
    push_cast
    field_simp [hbpos.ne', hcpos.ne']
    ring
  rw [hdecomp]
  calc
    ‖(conj b - conj c) / (‖b‖ : ℂ) +
        conj c * (((‖c‖ : ℝ) - ‖b‖) / (‖b‖ * ‖c‖) : ℝ)‖ ≤
        ‖(conj b - conj c) / (‖b‖ : ℂ)‖ +
          ‖conj c * (((‖c‖ : ℝ) - ‖b‖) /
            (‖b‖ * ‖c‖) : ℝ)‖ := norm_add_le _ _
    _ = ‖b - c‖ / ‖b‖ + |‖c‖ - ‖b‖| / ‖b‖ := by
      rw [norm_div, norm_sub_rev (conj b) (conj c), ← map_sub,
        Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hbpos, norm_mul, Complex.norm_conj,
        Complex.norm_real, Real.norm_eq_abs]
      rw [abs_div, abs_of_pos (mul_pos hbpos hcpos)]
      field_simp
      rw [norm_sub_rev]
    _ ≤ ‖b - c‖ / ‖b‖ + ‖b - c‖ / ‖b‖ := by
      gcongr
      simpa [abs_sub_comm] using abs_norm_sub_norm_le b c
    _ ≤ (2 / eta) * ‖b - c‖ := by
      have hinv : 1 / ‖b‖ ≤ 1 / eta := one_div_le_one_div_of_le heta hb
      have hmul : ‖b - c‖ * ‖b‖⁻¹ ≤ ‖b - c‖ * eta⁻¹ := by
        simpa [one_div] using
          (mul_le_mul_of_nonneg_left hinv (norm_nonneg (b - c)))
      rw [div_eq_mul_inv, div_eq_mul_inv]
      calc
        ‖b - c‖ * ‖b‖⁻¹ + ‖b - c‖ * ‖b‖⁻¹ =
            2 * (‖b - c‖ * ‖b‖⁻¹) := by ring
        _ ≤ 2 * (‖b - c‖ * eta⁻¹) :=
          mul_le_mul_of_nonneg_left hmul (by norm_num)
        _ = 2 * eta⁻¹ * ‖b - c‖ := by ring

lemma norm_blockRotatedPosition_sub_le
    (a b a' b' : ℂ) (eta : ℝ) (heta : 0 < eta)
    (hb : eta ≤ ‖b‖) (hb' : eta ≤ ‖b'‖) :
    ‖blockRotatedPosition a b - blockRotatedPosition a' b'‖ ≤
      ‖a - a'‖ + ‖a'‖ * ((2 / eta) * ‖b - b'‖) := by
  have hb0 : b ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt (heta.trans_le hb))
  have hb0' : b' ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt (heta.trans_le hb'))
  rw [show blockRotatedPosition a b = a * normalizedConjugateDirection b by
      unfold blockRotatedPosition normalizedConjugateDirection
      ring,
    show blockRotatedPosition a' b' = a' * normalizedConjugateDirection b' by
      unfold blockRotatedPosition normalizedConjugateDirection
      ring]
  rw [show a * normalizedConjugateDirection b -
      a' * normalizedConjugateDirection b' =
      (a - a') * normalizedConjugateDirection b +
        a' * (normalizedConjugateDirection b -
          normalizedConjugateDirection b') by ring]
  calc
    _ ≤ ‖(a - a') * normalizedConjugateDirection b‖ +
        ‖a' * (normalizedConjugateDirection b -
          normalizedConjugateDirection b')‖ := norm_add_le _ _
    _ = ‖a - a'‖ + ‖a'‖ *
        ‖normalizedConjugateDirection b -
          normalizedConjugateDirection b'‖ := by
      rw [norm_mul, norm_mul, norm_normalizedConjugateDirection b hb0, mul_one]
    _ ≤ _ := add_le_add le_rfl (mul_le_mul_of_nonneg_left
      (norm_normalizedConjugateDirection_sub_le b b' eta heta hb hb')
      (norm_nonneg a'))

noncomputable def blockOuterPerturbationError
    (n : ℕ) (u halfWidth velocityLower velocityUpper radius : ℝ) : ℝ :=
  radius +
    (halfWidth * velocityUpper + u / n + radius) *
      (2 / (velocityLower - radius)) * radius

noncomputable def blockOuterHalfWidth
    (n : ℕ) (u halfWidth velocityLower velocityUpper radius : ℝ) : ℝ :=
  halfWidth +
    (halfWidth * radius +
      blockOuterPerturbationError n u halfWidth velocityLower velocityUpper radius) /
        (velocityLower - radius)

noncomputable def blockOuterHeight
    (n : ℕ) (u halfWidth velocityLower velocityUpper radius : ℝ) : ℝ :=
  u + n * blockOuterPerturbationError n u halfWidth
    velocityLower velocityUpper radius

lemma norm_fst_le_of_mem_truncatedBlockRegion
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower)
    {p : ℂ × ℂ}
    (hp : p ∈ truncatedBlockRegion n u halfWidth velocityLower velocityUpper) :
    ‖p.1‖ ≤ halfWidth * velocityUpper + u / n := by
  rcases hp with ⟨⟨_hlow, hupp⟩, hre, him⟩
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hb : p.2 ≠ 0 := by
    intro hb
    have : velocityLower ≤ ‖p.2‖ := _hlow
    simpa [hb] using (hvelLower.trans_le this).ne'
  rw [← norm_blockRotatedPosition p.1 p.2 hb]
  calc
    ‖blockRotatedPosition p.1 p.2‖ ≤
        |(blockRotatedPosition p.1 p.2).re| +
          |(blockRotatedPosition p.1 p.2).im| :=
      Complex.norm_le_abs_re_add_abs_im _
    _ ≤ halfWidth * ‖p.2‖ + u / n := add_le_add hre him
    _ ≤ halfWidth * velocityUpper + u / n :=
      add_le_add (mul_le_mul_of_nonneg_left hupp hhalf) le_rfl

lemma abs_re_le_abs_re_add_norm_sub (z w : ℂ) :
    |z.re| ≤ |w.re| + ‖z - w‖ := by
  calc
    |z.re| = |w.re + (z - w).re| := by congr 1; simp
    _ ≤ |w.re| + |(z - w).re| := abs_add_le _ _
    _ ≤ |w.re| + ‖z - w‖ := add_le_add le_rfl (Complex.abs_re_le_norm _)

lemma abs_im_le_abs_im_add_norm_sub (z w : ℂ) :
    |z.im| ≤ |w.im| + ‖z - w‖ := by
  calc
    |z.im| = |w.im + (z - w).im| := by congr 1; simp
    _ ≤ |w.im| + |(z - w).im| := abs_add_le _ _
    _ ≤ |w.im| + ‖z - w‖ := add_le_add le_rfl (Complex.abs_im_le_norm _)

lemma mem_truncatedBlockRegion_of_near
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper radius : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hr : 0 ≤ radius)
    (hrLower : radius < velocityLower)
    {p q : ℂ × ℂ}
    (hp : p ∈ truncatedBlockRegion n u halfWidth velocityLower velocityUpper)
    (hpos : ‖q.1 - p.1‖ ≤ radius) (hvel : ‖q.2 - p.2‖ ≤ radius) :
    q ∈ truncatedBlockRegion n
      (blockOuterHeight n u halfWidth velocityLower velocityUpper radius)
      (blockOuterHalfWidth n u halfWidth velocityLower velocityUpper radius)
      (velocityLower - radius) (velocityUpper + radius) := by
  let eta' := velocityLower - radius
  let E := blockOuterPerturbationError n u halfWidth
    velocityLower velocityUpper radius
  have heta' : 0 < eta' := sub_pos.mpr hrLower
  rcases hp with ⟨⟨hlow, hupp⟩, hre, him⟩
  have hqLower : eta' ≤ ‖q.2‖ := by
    have hrev := norm_sub_norm_le p.2 q.2
    rw [norm_sub_rev] at hvel
    dsimp [eta']
    linarith
  have hqUpper : ‖q.2‖ ≤ velocityUpper + radius := by
    calc
      ‖q.2‖ ≤ ‖p.2‖ + ‖q.2 - p.2‖ := by
        simpa using norm_add_le p.2 (q.2 - p.2)
      _ ≤ _ := by linarith
  have hpLower' : eta' ≤ ‖p.2‖ := by linarith
  have hpNorm := norm_fst_le_of_mem_truncatedBlockRegion
    n hn u halfWidth velocityLower velocityUpper hu hhalf (lt_of_le_of_lt hr hrLower)
      (show p ∈ truncatedBlockRegion n u halfWidth velocityLower velocityUpper from
        ⟨⟨hlow, hupp⟩, hre, him⟩)
  have hqNorm : ‖q.1‖ ≤ halfWidth * velocityUpper + u / n + radius := by
    calc
      ‖q.1‖ ≤ ‖p.1‖ + ‖q.1 - p.1‖ := by
        simpa using norm_add_le p.1 (q.1 - p.1)
      _ ≤ _ := by linarith
  have hbase0 : 0 ≤ halfWidth * velocityUpper + u / n :=
    (norm_nonneg p.1).trans hpNorm
  have hcoef0 : 0 ≤ 2 / eta' := by positivity
  have hE0 : 0 ≤ E := by
    dsimp [E, blockOuterPerturbationError]
    positivity
  have hrot : ‖blockRotatedPosition q.1 q.2 -
      blockRotatedPosition p.1 p.2‖ ≤ E := by
    have h := norm_blockRotatedPosition_sub_le q.1 q.2 p.1 p.2
      eta' heta' hqLower hpLower'
    dsimp [E, blockOuterPerturbationError]
    calc
      _ ≤ ‖q.1 - p.1‖ + ‖p.1‖ *
          ((2 / eta') * ‖q.2 - p.2‖) := h
      _ ≤ radius + (halfWidth * velocityUpper + u / n + radius) *
          ((2 / eta') * radius) := by
        apply add_le_add hpos
        apply mul_le_mul
        · exact hpNorm.trans (le_add_of_nonneg_right hr)
        · exact mul_le_mul_of_nonneg_left hvel hcoef0
        · exact mul_nonneg hcoef0 (norm_nonneg _)
        · positivity
      _ = radius + (halfWidth * velocityUpper + u / n + radius) *
          (2 / (velocityLower - radius)) * radius := by
        dsimp [eta']
        ring
  refine ⟨⟨hqLower, hqUpper⟩, ?_, ?_⟩
  · have hraw := (abs_re_le_abs_re_add_norm_sub
      (blockRotatedPosition q.1 q.2)
      (blockRotatedPosition p.1 p.2)).trans
        (add_le_add hre hrot)
    dsimp [blockOuterHalfWidth]
    have hq0 : 0 ≤ ‖q.2‖ := norm_nonneg _
    have hfactor : halfWidth * radius + E ≤
        ((halfWidth * radius + E) / eta') * ‖q.2‖ := by
      have hA0 : 0 ≤ halfWidth * radius + E :=
        add_nonneg (mul_nonneg hhalf hr) hE0
      calc
        halfWidth * radius + E =
            ((halfWidth * radius + E) / eta') * eta' := by field_simp
        _ ≤ ((halfWidth * radius + E) / eta') * ‖q.2‖ :=
          mul_le_mul_of_nonneg_left hqLower (div_nonneg hA0 heta'.le)
    calc
      |(blockRotatedPosition q.1 q.2).re| ≤
          halfWidth * ‖p.2‖ + E := hraw
      _ ≤ halfWidth * ‖q.2‖ + (halfWidth * radius + E) := by
        have hnorm := norm_sub_norm_le p.2 q.2
        rw [norm_sub_rev] at hvel
        nlinarith [mul_le_mul_of_nonneg_left
          (show ‖p.2‖ ≤ ‖q.2‖ + radius by linarith) hhalf]
      _ ≤ halfWidth * ‖q.2‖ +
          ((halfWidth * radius + E) / eta') * ‖q.2‖ :=
        add_le_add le_rfl hfactor
      _ = (halfWidth + (halfWidth * radius + E) / eta') * ‖q.2‖ := by ring
  · have hraw := (abs_im_le_abs_im_add_norm_sub
      (blockRotatedPosition q.1 q.2)
      (blockRotatedPosition p.1 p.2)).trans
        (add_le_add him hrot)
    dsimp [blockOuterHeight]
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    calc
      |(blockRotatedPosition q.1 q.2).im| ≤ u / n + E := hraw
      _ = (u + n * E) / n := by field_simp

lemma thickening_truncatedPhaseRegion_subset_outer
    (m n : ℕ) (hn : 0 < n)
    (u halfWidth velocityLower velocityUpper radius : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hr : 0 ≤ radius)
    (hrLower : radius < velocityLower) :
    Metric.thickening radius
        (truncatedPhaseRegion (m := m) n u halfWidth
          velocityLower velocityUpper) ⊆
      truncatedPhaseRegion (m := m) n
        (blockOuterHeight n u halfWidth velocityLower velocityUpper radius)
        (blockOuterHalfWidth n u halfWidth velocityLower velocityUpper radius)
        (velocityLower - radius) (velocityUpper + radius) := by
  intro y hy
  rw [Metric.mem_thickening_iff] at hy
  rcases hy with ⟨x, hx, hdist⟩
  change phaseToBlocks y ∈ Set.univ.pi (fun _ : Fin m ↦
      truncatedBlockSet n
        (blockOuterHeight n u halfWidth velocityLower velocityUpper radius)
        (blockOuterHalfWidth n u halfWidth velocityLower velocityUpper radius)
        (velocityLower - radius) (velocityUpper + radius))
  intro r _hr
  change phaseToBlocks x ∈ Set.univ.pi (fun _ : Fin m ↦
      truncatedBlockSet n u halfWidth velocityLower velocityUpper) at hx
  have hxr := hx r (Set.mem_univ r)
  change phaseToBlocks x r ∈
    truncatedBlockRegion n u halfWidth velocityLower velocityUpper at hxr
  change phaseToBlocks y r ∈ truncatedBlockRegion n
    (blockOuterHeight n u halfWidth velocityLower velocityUpper radius)
    (blockOuterHalfWidth n u halfWidth velocityLower velocityUpper radius)
    (velocityLower - radius) (velocityUpper + radius)
  apply mem_truncatedBlockRegion_of_near n hn u halfWidth
    velocityLower velocityUpper radius hu hhalf hr hrLower hxr
  · exact (norm_phaseToBlocks_fst_sub_le y x r).trans
      (le_of_lt (by simpa [dist_eq_norm] using hdist))
  · exact (norm_phaseToBlocks_snd_sub_le y x r).trans
      (le_of_lt (by simpa [dist_eq_norm] using hdist))

noncomputable def phaseBoundaryRadius (n : ℕ) : ℝ :=
  rigidityPower n (-(7 / 4))

lemma phaseBoundaryRadius_nonneg (n : ℕ) : 0 ≤ phaseBoundaryRadius n :=
  rigidityPower_nonneg n _

lemma phaseBoundaryRadius_tendsto_zero :
    Tendsto phaseBoundaryRadius atTop (nhds 0) := by
  change Tendsto (fun n : ℕ ↦ rigidityPower n (-(7 / 4 : ℝ)))
    atTop (nhds 0)
  exact tendsto_rigidityPower_neg_zero
    (show (0 : ℝ) < 7 / 4 by norm_num)

lemma scaled_phaseBoundaryRadius_tendsto_zero :
    Tendsto (fun n : ℕ ↦ (n : ℝ) * phaseBoundaryRadius n)
      atTop (nhds 0) := by
  have h := tendsto_rigidityPower_neg_zero
    (show (0 : ℝ) < 3 / 4 by norm_num)
  apply h.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  rw [show (n : ℝ) = rigidityPower n 1 by simp [rigidityPower]]
  rw [phaseBoundaryRadius, ← rigidityPower_add hn]
  congr 1
  ring

lemma scaled_localMeshHalfWidth_tendsto_pi :
    Tendsto (fun n : ℕ ↦ (n : ℝ) * localMeshHalfWidth n)
      atTop (nhds Real.pi) := by
  have h := meshRatio_tendsto_one.const_mul Real.pi
  convert h using 1
  · funext n
    unfold localMeshHalfWidth localMeshSize
    push_cast
    ring
  · ring

lemma blockOuterPerturbationError_scaled_tendsto_zero
    (u velocityLower velocityUpper : ℝ) (hvelLower : 0 < velocityLower) :
    Tendsto (fun n : ℕ ↦ (n : ℝ) *
      blockOuterPerturbationError n u (localMeshHalfWidth n)
        velocityLower velocityUpper (phaseBoundaryRadius n))
      atTop (nhds 0) := by
  have hr := phaseBoundaryRadius_tendsto_zero
  have hnr := scaled_phaseBoundaryRadius_tendsto_zero
  have hh := localMeshHalfWidth_tendsto_zero
  have huDiv : Tendsto (fun n : ℕ ↦ u / (n : ℝ)) atTop (nhds 0) := by
    have hinv : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (nhds 0) :=
      tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
    simpa [div_eq_mul_inv] using hinv.const_mul u
  have hbase : Tendsto (fun n : ℕ ↦
      localMeshHalfWidth n * velocityUpper + u / (n : ℝ) +
        phaseBoundaryRadius n) atTop (nhds 0) := by
    simpa using ((hh.mul_const velocityUpper).add huDiv).add hr
  have hden : Tendsto (fun n : ℕ ↦
      velocityLower - phaseBoundaryRadius n) atTop (nhds velocityLower) := by
    simpa using tendsto_const_nhds.sub hr
  have hcoef : Tendsto (fun n : ℕ ↦
      2 / (velocityLower - phaseBoundaryRadius n))
      atTop (nhds (2 / velocityLower)) := by
    exact tendsto_const_nhds.div hden hvelLower.ne'
  have hprod := (hbase.mul hcoef).mul hnr
  have hsum := hnr.add hprod
  simp only [zero_mul, zero_add] at hsum
  apply hsum.congr'
  filter_upwards [] with n
  unfold blockOuterPerturbationError
  ring

lemma blockOuterHalfWidth_relativeError_tendsto_zero
    (u velocityLower velocityUpper : ℝ) (hvelLower : 0 < velocityLower) :
    Tendsto (fun n : ℕ ↦
      (blockOuterHalfWidth n u (localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n) -
        localMeshHalfWidth n) / localMeshHalfWidth n)
      atTop (nhds 0) := by
  have hr := phaseBoundaryRadius_tendsto_zero
  have hnr := scaled_phaseBoundaryRadius_tendsto_zero
  have hnh := scaled_localMeshHalfWidth_tendsto_pi
  have hne := blockOuterPerturbationError_scaled_tendsto_zero
    u velocityLower velocityUpper hvelLower
  have hnum : Tendsto (fun n : ℕ ↦
      ((n : ℝ) * localMeshHalfWidth n) * phaseBoundaryRadius n +
        (n : ℝ) * blockOuterPerturbationError n u (localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n))
      atTop (nhds 0) := by
    simpa using (hnh.mul hr).add hne
  have hden : Tendsto (fun n : ℕ ↦
      (velocityLower - phaseBoundaryRadius n) *
        ((n : ℝ) * localMeshHalfWidth n))
      atTop (nhds (velocityLower * Real.pi)) := by
    simpa using (tendsto_const_nhds.sub hr).mul hnh
  have hden0 : velocityLower * Real.pi ≠ 0 :=
    mul_ne_zero hvelLower.ne' Real.pi_ne_zero
  have hquot := hnum.div hden hden0
  simp only [zero_div] at hquot
  apply hquot.congr'
  have hrlt : ∀ᶠ n : ℕ in atTop,
      phaseBoundaryRadius n < velocityLower :=
    hr.eventually (Iio_mem_nhds hvelLower)
  filter_upwards [Nat.eventually_pos, hrlt] with n hn hrn
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hhalf : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos hnreal) (by
      exact_mod_cast localMeshSize_pos n)
  change
    (((n : ℝ) * localMeshHalfWidth n) * phaseBoundaryRadius n +
        (n : ℝ) * blockOuterPerturbationError n u (localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n)) /
      ((velocityLower - phaseBoundaryRadius n) *
        ((n : ℝ) * localMeshHalfWidth n)) =
    ((blockOuterHalfWidth n u (localMeshHalfWidth n)
        velocityLower velocityUpper (phaseBoundaryRadius n) -
      localMeshHalfWidth n) / localMeshHalfWidth n)
  unfold blockOuterHalfWidth
  field_simp [hnreal.ne', hhalf.ne', (sub_pos.mpr hrn).ne']
  ring

lemma truncatedBlockRegion_mono
    (n : ℕ) (hn : 0 < n)
    {u₁ u₂ halfWidth₁ halfWidth₂ velocityLower₁ velocityLower₂
      velocityUpper₁ velocityUpper₂ : ℝ}
    (hu : u₁ ≤ u₂) (hhalf : halfWidth₁ ≤ halfWidth₂)
    (hlower : velocityLower₂ ≤ velocityLower₁)
    (hupper : velocityUpper₁ ≤ velocityUpper₂) :
    truncatedBlockRegion n u₁ halfWidth₁ velocityLower₁ velocityUpper₁ ⊆
      truncatedBlockRegion n u₂ halfWidth₂ velocityLower₂ velocityUpper₂ := by
  intro p hp
  rcases hp with ⟨⟨hpLower, hpUpper⟩, hpRe, hpIm⟩
  refine ⟨⟨hlower.trans hpLower, hpUpper.trans hupper⟩, ?_, ?_⟩
  · exact hpRe.trans (mul_le_mul_of_nonneg_right hhalf (norm_nonneg _))
  · exact hpIm.trans (div_le_div_of_nonneg_right hu (by exact_mod_cast hn.le))

lemma truncatedPhaseRegion_mono
    (m n : ℕ) (hn : 0 < n)
    {u₁ u₂ halfWidth₁ halfWidth₂ velocityLower₁ velocityLower₂
      velocityUpper₁ velocityUpper₂ : ℝ}
    (hu : u₁ ≤ u₂) (hhalf : halfWidth₁ ≤ halfWidth₂)
    (hlower : velocityLower₂ ≤ velocityLower₁)
    (hupper : velocityUpper₁ ≤ velocityUpper₂) :
    truncatedPhaseRegion (m := m) n u₁ halfWidth₁
        velocityLower₁ velocityUpper₁ ⊆
      truncatedPhaseRegion (m := m) n u₂ halfWidth₂
        velocityLower₂ velocityUpper₂ := by
  intro y hy
  change phaseToBlocks y ∈ Set.univ.pi (fun _ : Fin m ↦
    truncatedBlockSet n u₂ halfWidth₂ velocityLower₂ velocityUpper₂)
  intro r _hr
  change phaseToBlocks y ∈ Set.univ.pi (fun _ : Fin m ↦
    truncatedBlockSet n u₁ halfWidth₁ velocityLower₁ velocityUpper₁) at hy
  exact truncatedBlockRegion_mono n hn hu hhalf hlower hupper
    (hy r (Set.mem_univ r))

lemma eventually_thickening_truncatedMeshRegion_subset_expanded
    (m : ℕ) (u velocityLower velocityUpper eps : ℝ)
    (hu : 0 ≤ u) (hvelLower : 0 < velocityLower) (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop,
      Metric.thickening (phaseBoundaryRadius n)
          (truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
            velocityLower velocityUpper) ⊆
        truncatedPhaseRegion (m := m) n (u + eps)
          ((1 + eps) * localMeshHalfWidth n)
          (velocityLower - eps) (velocityUpper + eps) := by
  have hrSmall : ∀ᶠ n : ℕ in atTop, phaseBoundaryRadius n < eps :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds heps)
  have hrLower : ∀ᶠ n : ℕ in atTop,
      phaseBoundaryRadius n < velocityLower :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds hvelLower)
  have hheight : ∀ᶠ n : ℕ in atTop,
      (n : ℝ) * blockOuterPerturbationError n u (localMeshHalfWidth n)
        velocityLower velocityUpper (phaseBoundaryRadius n) < eps :=
    (blockOuterPerturbationError_scaled_tendsto_zero
      u velocityLower velocityUpper hvelLower).eventually (Iio_mem_nhds heps)
  have hwidth : ∀ᶠ n : ℕ in atTop,
      (blockOuterHalfWidth n u (localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n) -
        localMeshHalfWidth n) / localMeshHalfWidth n < eps :=
    (blockOuterHalfWidth_relativeError_tendsto_zero
      u velocityLower velocityUpper hvelLower).eventually (Iio_mem_nhds heps)
  filter_upwards [Nat.eventually_pos, hrSmall, hrLower, hheight, hwidth]
    with n hn hrEps hrEta hheightN hwidthN
  have hhalfPos : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos (by exact_mod_cast hn)) (by
      exact_mod_cast localMeshSize_pos n)
  have houterHeight :
      blockOuterHeight n u (localMeshHalfWidth n) velocityLower velocityUpper
        (phaseBoundaryRadius n) ≤ u + eps := by
    unfold blockOuterHeight
    linarith
  have houterWidth :
      blockOuterHalfWidth n u (localMeshHalfWidth n) velocityLower velocityUpper
          (phaseBoundaryRadius n) ≤
        (1 + eps) * localMeshHalfWidth n := by
    have hdiff :
        blockOuterHalfWidth n u (localMeshHalfWidth n) velocityLower velocityUpper
              (phaseBoundaryRadius n) - localMeshHalfWidth n <
            eps * localMeshHalfWidth n :=
      (div_lt_iff₀ hhalfPos).mp hwidthN
    linarith
  exact (thickening_truncatedPhaseRegion_subset_outer m n hn u
    (localMeshHalfWidth n) velocityLower velocityUpper (phaseBoundaryRadius n)
    hu hhalfPos.le (phaseBoundaryRadius_nonneg n) hrEta).trans
      (truncatedPhaseRegion_mono m n hn houterHeight houterWidth
        (by linarith) (by linarith))

lemma blockOuterPerturbationError_scaled_factor_tendsto_zero
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower) :
    Tendsto (fun n : ℕ ↦ (n : ℝ) *
      blockOuterPerturbationError n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper (phaseBoundaryRadius n))
      atTop (nhds 0) := by
  have hr := phaseBoundaryRadius_tendsto_zero
  have hnr := scaled_phaseBoundaryRadius_tendsto_zero
  have hh := localMeshHalfWidth_tendsto_zero
  have huDiv : Tendsto (fun n : ℕ ↦ u / (n : ℝ)) atTop (nhds 0) := by
    have hinv : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (nhds 0) :=
      tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
    simpa [div_eq_mul_inv] using hinv.const_mul u
  have hbase : Tendsto (fun n : ℕ ↦
      (widthFactor * localMeshHalfWidth n) * velocityUpper + u / (n : ℝ) +
        phaseBoundaryRadius n) atTop (nhds 0) := by
    have hh' : Tendsto (fun n : ℕ ↦ widthFactor * localMeshHalfWidth n)
        atTop (nhds 0) := by simpa using hh.const_mul widthFactor
    simpa using ((hh'.mul_const velocityUpper).add huDiv).add hr
  have hden : Tendsto (fun n : ℕ ↦
      velocityLower - phaseBoundaryRadius n) atTop (nhds velocityLower) := by
    simpa using tendsto_const_nhds.sub hr
  have hcoef : Tendsto (fun n : ℕ ↦
      2 / (velocityLower - phaseBoundaryRadius n))
      atTop (nhds (2 / velocityLower)) :=
    tendsto_const_nhds.div hden hvelLower.ne'
  have hsum := hnr.add ((hbase.mul hcoef).mul hnr)
  simp only [zero_mul, zero_add] at hsum
  apply hsum.congr'
  filter_upwards [] with n
  unfold blockOuterPerturbationError
  ring

lemma blockOuterHalfWidth_meshError_factor_tendsto_zero
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower) :
    Tendsto (fun n : ℕ ↦
      (blockOuterHalfWidth n u (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n) -
        widthFactor * localMeshHalfWidth n) / localMeshHalfWidth n)
      atTop (nhds 0) := by
  have hr := phaseBoundaryRadius_tendsto_zero
  have hnh := scaled_localMeshHalfWidth_tendsto_pi
  have hne := blockOuterPerturbationError_scaled_factor_tendsto_zero
    widthFactor u velocityLower velocityUpper hvelLower
  have hnum : Tendsto (fun n : ℕ ↦
      widthFactor * ((n : ℝ) * localMeshHalfWidth n) * phaseBoundaryRadius n +
        (n : ℝ) * blockOuterPerturbationError n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper
          (phaseBoundaryRadius n)) atTop (nhds 0) := by
    simpa using (((hnh.const_mul widthFactor).mul hr).add hne)
  have hden : Tendsto (fun n : ℕ ↦
      (velocityLower - phaseBoundaryRadius n) *
        ((n : ℝ) * localMeshHalfWidth n))
      atTop (nhds (velocityLower * Real.pi)) := by
    simpa using (tendsto_const_nhds.sub hr).mul hnh
  have hquot := hnum.div hden
    (mul_ne_zero hvelLower.ne' Real.pi_ne_zero)
  simp only [zero_div] at hquot
  apply hquot.congr'
  have hrlt : ∀ᶠ n : ℕ in atTop,
      phaseBoundaryRadius n < velocityLower :=
    hr.eventually (Iio_mem_nhds hvelLower)
  filter_upwards [Nat.eventually_pos, hrlt] with n hn hrn
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hhalf : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos hnreal) (by
      exact_mod_cast localMeshSize_pos n)
  change
    (widthFactor * ((n : ℝ) * localMeshHalfWidth n) * phaseBoundaryRadius n +
        (n : ℝ) * blockOuterPerturbationError n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper
          (phaseBoundaryRadius n)) /
      ((velocityLower - phaseBoundaryRadius n) *
        ((n : ℝ) * localMeshHalfWidth n)) =
    ((blockOuterHalfWidth n u (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper (phaseBoundaryRadius n) -
      widthFactor * localMeshHalfWidth n) / localMeshHalfWidth n)
  unfold blockOuterHalfWidth
  field_simp [hnreal.ne', hhalf.ne', (sub_pos.mpr hrn).ne']
  ring

lemma eventually_thickening_shrunkMeshRegion_subset
    (m : ℕ) (u velocityLower velocityUpper eps : ℝ)
    (heps : 0 < eps) (hepsOne : eps < 1) (hepsU : eps < u)
    (hvelLower : 0 < velocityLower) (hepsUpper : eps < velocityUpper) :
    ∀ᶠ n : ℕ in atTop,
      Metric.thickening (phaseBoundaryRadius n)
          (truncatedPhaseRegion (m := m) n (u - eps)
            ((1 - eps) * localMeshHalfWidth n)
            (velocityLower + eps) (velocityUpper - eps)) ⊆
        truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
          velocityLower velocityUpper := by
  have hlowerPos : 0 < velocityLower + eps := by linarith
  have hrSmall : ∀ᶠ n : ℕ in atTop, phaseBoundaryRadius n < eps :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds heps)
  have hrLower : ∀ᶠ n : ℕ in atTop,
      phaseBoundaryRadius n < velocityLower + eps :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds hlowerPos)
  have hheight : ∀ᶠ n : ℕ in atTop,
      (n : ℝ) * blockOuterPerturbationError n (u - eps)
        ((1 - eps) * localMeshHalfWidth n) (velocityLower + eps)
        (velocityUpper - eps) (phaseBoundaryRadius n) < eps :=
    (blockOuterPerturbationError_scaled_factor_tendsto_zero
      (1 - eps) (u - eps) (velocityLower + eps) (velocityUpper - eps)
      hlowerPos).eventually (Iio_mem_nhds heps)
  have hwidth : ∀ᶠ n : ℕ in atTop,
      (blockOuterHalfWidth n (u - eps) ((1 - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) -
        (1 - eps) * localMeshHalfWidth n) / localMeshHalfWidth n < eps :=
    (blockOuterHalfWidth_meshError_factor_tendsto_zero
      (1 - eps) (u - eps) (velocityLower + eps) (velocityUpper - eps)
      hlowerPos).eventually (Iio_mem_nhds heps)
  filter_upwards [Nat.eventually_pos, hrSmall, hrLower, hheight, hwidth]
    with n hn hrEps hrLowerN hheightN hwidthN
  have hhalfPos : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos (by exact_mod_cast hn)) (by
      exact_mod_cast localMeshSize_pos n)
  have hbaseHalf : 0 ≤ (1 - eps) * localMeshHalfWidth n :=
    mul_nonneg (sub_nonneg.mpr hepsOne.le) hhalfPos.le
  have houterHeight :
      blockOuterHeight n (u - eps) ((1 - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) ≤
        u := by
    unfold blockOuterHeight
    linarith
  have houterWidth :
      blockOuterHalfWidth n (u - eps) ((1 - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) ≤
        localMeshHalfWidth n := by
    have hdiff :
        blockOuterHalfWidth n (u - eps) ((1 - eps) * localMeshHalfWidth n)
              (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) -
            (1 - eps) * localMeshHalfWidth n <
          eps * localMeshHalfWidth n :=
      (div_lt_iff₀ hhalfPos).mp hwidthN
    linarith
  exact (thickening_truncatedPhaseRegion_subset_outer m n hn (u - eps)
    ((1 - eps) * localMeshHalfWidth n) (velocityLower + eps)
    (velocityUpper - eps) (phaseBoundaryRadius n) (sub_nonneg.mpr hepsU.le)
    hbaseHalf (phaseBoundaryRadius_nonneg n) hrLowerN).trans
      (truncatedPhaseRegion_mono m n hn houterHeight houterWidth
        (by linarith) (by linarith))

lemma eventually_shrunkMeshRegion_subset_innerErosion
    (m : ℕ) (u velocityLower velocityUpper eps : ℝ)
    (heps : 0 < eps) (hepsOne : eps < 1) (hepsU : eps < u)
    (hvelLower : 0 < velocityLower) (hepsUpper : eps < velocityUpper) :
    ∀ᶠ n : ℕ in atTop,
      truncatedPhaseRegion (m := m) n (u - eps)
          ((1 - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) ⊆
        (Metric.thickening (phaseBoundaryRadius n)
          (truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
            velocityLower velocityUpper)ᶜ)ᶜ := by
  filter_upwards [eventually_thickening_shrunkMeshRegion_subset
    m u velocityLower velocityUpper eps heps hepsOne hepsU hvelLower hepsUpper]
    with n hsubset
  intro x hx hxin
  rw [Metric.mem_thickening_iff] at hxin
  rcases hxin with ⟨y, hy, hyx⟩
  have hnear : y ∈ Metric.thickening (phaseBoundaryRadius n)
      (truncatedPhaseRegion (m := m) n (u - eps)
        ((1 - eps) * localMeshHalfWidth n)
        (velocityLower + eps) (velocityUpper - eps)) := by
    rw [Metric.mem_thickening_iff]
    exact ⟨x, hx, by simpa [dist_comm] using hyx⟩
  exact hy (hsubset hnear)

noncomputable def truncatedBlockFactorMass
    (n : ℕ) (widthFactor u velocityLower velocityUpper : ℝ) : ℝ :=
  ∫ p : ℂ × ℂ in truncatedBlockRegion n u
      (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
    blockLimitingDensity p

lemma scaled_blockFactorCoefficient_eq
    (n : ℕ) (hn : 0 < n)
    (widthFactor u velocityLower velocityUpper : ℝ) :
    (localMeshSize n : ℝ) *
        ((3 / Real.pi ^ 2) *
          (4 * (widthFactor * localMeshHalfWidth n) * (u / n)) *
          blockVelocityMass velocityLower velocityUpper) =
      widthFactor * ((12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper) := by
  have hmesh0 : (localMeshSize n : ℝ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (localMeshSize_pos n))
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold localMeshHalfWidth
  field_simp [hmesh0, hn0, Real.pi_ne_zero]
  ring

theorem truncatedBlockFactorMass_tendsto
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hfactor : 0 ≤ widthFactor) (hu : 0 ≤ u)
    (hvelLower : 0 < velocityLower) (hvelUpper : 0 ≤ velocityUpper) :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) *
        truncatedBlockFactorMass n widthFactor u velocityLower velocityUpper)
      atTop (nhds (widthFactor * ((12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper))) := by
  let L : ℝ := widthFactor * ((12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper)
  let lower : ℕ → ℝ := fun n ↦
    Real.exp (-(((widthFactor * localMeshHalfWidth n) * velocityUpper) ^ 2 +
      (u / n) ^ 2)) * L
  have herror : Tendsto (fun n : ℕ ↦
      Real.exp (-(((widthFactor * localMeshHalfWidth n) * velocityUpper) ^ 2 +
        (u / n) ^ 2))) atTop (nhds 1) := by
    have h := blockPositionGaussianError_tendsto_one u
      (widthFactor * velocityUpper)
    convert h using 1
    funext n
    ring
  have hlower : Tendsto lower atTop (nhds L) := by
    simpa [lower] using herror.mul
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ L) atTop (nhds L))
  have hupper : Tendsto (fun _ : ℕ ↦ L) atTop (nhds L) := tendsto_const_nhds
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hlower hupper
  · filter_upwards [Nat.eventually_pos] with n hn
    have hbound := blockLimitingDensity_truncatedBlockRegion_lower
      n hn u (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper hu
      (mul_nonneg hfactor (by unfold localMeshHalfWidth; positivity))
      hvelLower hvelUpper
    have hscale := mul_le_mul_of_nonneg_left hbound
      (Nat.cast_nonneg (localMeshSize n))
    change lower n ≤ (localMeshSize n : ℝ) *
      truncatedBlockFactorMass n widthFactor u velocityLower velocityUpper
    rw [show lower n =
        Real.exp (-(((widthFactor * localMeshHalfWidth n) * velocityUpper) ^ 2 +
          (u / n) ^ 2)) *
          ((localMeshSize n : ℝ) *
            ((3 / Real.pi ^ 2) *
              (4 * (widthFactor * localMeshHalfWidth n) * (u / n)) *
              blockVelocityMass velocityLower velocityUpper)) by
        rw [scaled_blockFactorCoefficient_eq n hn]]
    unfold truncatedBlockFactorMass
    simpa only [mul_assoc, mul_left_comm, mul_comm] using hscale
  · filter_upwards [Nat.eventually_pos] with n hn
    have hbound := blockLimitingDensity_truncatedBlockRegion_upper
      n hn u (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper hu
      (mul_nonneg hfactor (by unfold localMeshHalfWidth; positivity)) hvelLower
    have hscale := mul_le_mul_of_nonneg_left hbound
      (Nat.cast_nonneg (localMeshSize n))
    change (localMeshSize n : ℝ) *
        truncatedBlockFactorMass n widthFactor u velocityLower velocityUpper ≤ L
    rw [show L =
        (localMeshSize n : ℝ) *
          ((3 / Real.pi ^ 2) *
            (4 * (widthFactor * localMeshHalfWidth n) * (u / n)) *
            blockVelocityMass velocityLower velocityUpper) by
      exact (scaled_blockFactorCoefficient_eq n hn widthFactor u
        velocityLower velocityUpper).symm]
    simpa [truncatedBlockFactorMass] using hscale

lemma scaled_truncatedPhaseFactorMass_tendsto
    (m : ℕ) (hm : 0 < m)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hfactor : 0 ≤ widthFactor) (hu : 0 ≤ u)
    (hvelLower : 0 < velocityLower) (hvelUpper : 0 ≤ velocityUpper) :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) ^ m *
        ∫ y in truncatedPhaseRegion (m := m) n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
          phaseLimitingDensity y)
      atTop (nhds ((widthFactor * ((12 * u / Real.pi) *
        blockVelocityMass velocityLower velocityUpper)) ^ m)) := by
  have hblock := (truncatedBlockFactorMass_tendsto widthFactor u
    velocityLower velocityUpper hfactor hu hvelLower hvelUpper).pow m
  apply hblock.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  rw [integral_phaseLimitingDensity_truncatedPhaseRegion
    (m := m) hm n u (widthFactor * localMeshHalfWidth n)
      velocityLower velocityUpper]
  unfold truncatedBlockFactorMass truncatedBlockSet
  rw [mul_pow]

lemma truncatedBlockRegion_subset_compactProduct
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower) :
    truncatedBlockRegion n u halfWidth velocityLower velocityUpper ⊆
      Metric.closedBall (0 : ℂ) (halfWidth * velocityUpper + u / n) ×ˢ
        Metric.closedBall (0 : ℂ) velocityUpper := by
  intro p hp
  have ha := norm_fst_le_of_mem_truncatedBlockRegion n hn u halfWidth
    velocityLower velocityUpper hu hhalf hvelLower hp
  exact ⟨by simpa [Metric.mem_closedBall, dist_zero_right] using ha,
    by
      have hb := hp.1.2
      simpa [Metric.mem_closedBall, dist_zero_right] using hb⟩

lemma volume_truncatedBlockRegion_ne_top
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower) :
    volume (truncatedBlockRegion n u halfWidth velocityLower velocityUpper) ≠ ⊤ := by
  have hcompact : IsCompact
      (Metric.closedBall (0 : ℂ) (halfWidth * velocityUpper + u / n) ×ˢ
        Metric.closedBall (0 : ℂ) velocityUpper) :=
    (isCompact_closedBall _ _).prod (isCompact_closedBall _ _)
  exact ((measure_mono (truncatedBlockRegion_subset_compactProduct n hn u
    halfWidth velocityLower velocityUpper hu hhalf hvelLower)).trans_lt
      hcompact.measure_lt_top).ne

lemma volumeReal_truncatedBlockRegion
    (n : ℕ) (hn : 0 < n) (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower) :
    volume.real (truncatedBlockRegion n u halfWidth velocityLower velocityUpper) =
      4 * halfWidth * (u / n) *
        ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper, ‖b‖ := by
  let s := truncatedBlockRegion n u halfWidth velocityLower velocityUpper
  have hs := measurableSet_truncatedBlockRegion n u halfWidth
    velocityLower velocityUpper
  have hsfinite := volume_truncatedBlockRegion_ne_top n hn u halfWidth
    velocityLower velocityUpper hu hhalf hvelLower
  have hInt : Integrable (s.indicator fun _ : ℂ × ℂ ↦ (1 : ℝ)) :=
    (integrableOn_const hsfinite).integrable_indicator hs
  rw [← setIntegral_one_eq_measureReal, ← integral_indicator hs]
  rw [MeasureTheory.Measure.volume_eq_prod]
  rw [integral_prod_symm _ hInt]
  rw [← integral_indicator (measurableSet_blockVelocityAnnulus
    velocityLower velocityUpper)]
  apply Eq.trans (integral_congr_ae (Eventually.of_forall fun b ↦ ?_))
  · rw [← integral_const_mul]
  · by_cases hbAnn : b ∈ blockVelocityAnnulus velocityLower velocityUpper
    · rw [Set.indicator_of_mem hbAnn]
      have hb : b ≠ 0 := by
        intro hb0
        have := hbAnn.1
        simpa [hb0] using (hvelLower.trans_le this).ne'
      rw [show (∫ a : ℂ, s.indicator (fun _ : ℂ × ℂ ↦ (1 : ℝ)) (a, b)) =
          ∫ a : ℂ in blockPositionSection n u halfWidth b, (1 : ℝ) by
        rw [← integral_indicator (measurableSet_blockPositionSection n u halfWidth b hb)]
        apply integral_congr_ae
        filter_upwards [] with a
        by_cases ha : a ∈ blockPositionSection n u halfWidth b
        · rw [Set.indicator_of_mem ha]
          rw [Set.indicator_of_mem (show (a, b) ∈ s from ⟨hbAnn, ha⟩)]
        · rw [Set.indicator_of_notMem ha]
          rw [Set.indicator_of_notMem (show (a, b) ∉ s by
            intro hab
            exact ha hab.2)]]
      rw [setIntegral_one_eq_measureReal,
        volumeReal_blockPositionSection n hn u halfWidth b hb hu hhalf]
      ring
    · rw [Set.indicator_of_notMem hbAnn]
      rw [mul_zero]
      apply integral_eq_zero_of_ae
      filter_upwards [] with a
      simp only [Set.indicator_of_notMem (show (a, b) ∉ s by
        intro hab
        exact hbAnn hab.1), Pi.zero_apply]

lemma volumeReal_truncatedPhaseRegion
    (m n : ℕ) (hm : 0 < m) (hn : 0 < n)
    (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower) :
    volume.real (truncatedPhaseRegion (m := m) n u halfWidth
      velocityLower velocityUpper) =
      (4 * halfWidth * (u / n) *
        ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper, ‖b‖) ^ m := by
  have hpre := (measurePreserving_phaseToBlocks (m := m) hm).measure_preimage
    (measurableSet_truncatedBlockPi (m := m) n u halfWidth
      velocityLower velocityUpper).nullMeasurableSet
  change (volume (phaseToBlocks ⁻¹' Set.univ.pi
      (fun _ : Fin m ↦ truncatedBlockSet n u halfWidth
        velocityLower velocityUpper))).toReal = _
  rw [hpre, volume_pi_pi, Finset.prod_const, ENNReal.toReal_pow]
  rw [show Finset.univ.card = m by simp]
  rw [show (volume (truncatedBlockSet n u halfWidth velocityLower
      velocityUpper)).toReal =
      4 * halfWidth * (u / n) *
        ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper, ‖b‖ by
    simpa only [truncatedBlockSet, measureReal_def] using
      volumeReal_truncatedBlockRegion n hn u halfWidth velocityLower
        velocityUpper hu hhalf hvelLower]

lemma scaled_volumeReal_truncatedPhaseFactorRegion
    (m n : ℕ) (hm : 0 < m) (hn : 0 < n)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hfactor : 0 ≤ widthFactor) (hu : 0 ≤ u)
    (hvelLower : 0 < velocityLower) :
    (localMeshSize n : ℝ) ^ m *
        volume.real (truncatedPhaseRegion (m := m) n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper) =
      (4 * Real.pi * widthFactor * u *
        ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper, ‖b‖) ^ m := by
  rw [volumeReal_truncatedPhaseRegion m n hm hn u
    (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper hu
    (mul_nonneg hfactor (by unfold localMeshHalfWidth; positivity)) hvelLower]
  rw [← mul_pow]
  congr 1
  unfold localMeshHalfWidth
  have hnreal : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hmesh : (localMeshSize n : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt (localMeshSize_pos n))
  field_simp

lemma volume_truncatedPhaseRegion_ne_top
    (m n : ℕ) (hm : 0 < m) (hn : 0 < n)
    (u halfWidth velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hhalf : 0 ≤ halfWidth) (hvelLower : 0 < velocityLower) :
    volume (truncatedPhaseRegion (m := m) n u halfWidth
      velocityLower velocityUpper) ≠ ⊤ := by
  have hpre := (measurePreserving_phaseToBlocks (m := m) hm).measure_preimage
    (measurableSet_truncatedBlockPi (m := m) n u halfWidth
      velocityLower velocityUpper).nullMeasurableSet
  change volume (phaseToBlocks ⁻¹' Set.univ.pi
      (fun _ : Fin m ↦ truncatedBlockSet n u halfWidth
        velocityLower velocityUpper)) ≠ ⊤
  rw [hpre, volume_pi_pi]
  apply ENNReal.prod_ne_top
  intro r _hr
  simpa only [truncatedBlockSet] using
    volume_truncatedBlockRegion_ne_top n hn u halfWidth velocityLower
      velocityUpper hu hhalf hvelLower

lemma integrable_phaseLimitingDensity (m : ℕ) (hm : 0 < m) :
    Integrable (phaseLimitingDensity : PhaseEuclidean m → ℝ) := by
  have hprod : Integrable (phaseBlockProductDensity :
      (Fin m → (ℂ × ℂ)) → ℝ) := by
    unfold phaseBlockProductDensity
    rw [MeasureTheory.volume_pi]
    exact Integrable.fintype_prod fun _ ↦ integrable_blockLimitingDensity
  have hcomp : Integrable (phaseBlockProductDensity ∘
      (phaseToBlocks : PhaseEuclidean m → Fin m → (ℂ × ℂ))) :=
    ((measurePreserving_phaseToBlocks (m := m) hm).integrable_comp_emb
      (measurableEmbedding_phaseToBlocks (m := m))).2 hprod
  apply hcomp.congr
  filter_upwards [] with y
  exact (phaseLimitingDensity_eq_blockProduct y).symm

lemma continuous_phaseLimitingDensity (m : ℕ) :
    Continuous (phaseLimitingDensity : PhaseEuclidean m → ℝ) := by
  unfold phaseLimitingDensity
  fun_prop

lemma continuous_phaseGaussianKernel (m : ℕ) (sigma : ℝ) :
    Continuous (phaseGaussianKernel m sigma) := by
  unfold phaseGaussianKernel
  fun_prop

lemma continuous_phaseSmoothedDensity
    (m n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) :
    Continuous (phaseSmoothedDensity n points sigma) := by
  have heq : phaseSmoothedDensity n points sigma =
      fun y : PhaseEuclidean m ↦
        uniformExpectation (fun e : SignVector (2 * n) ↦
          phaseGaussianKernel m sigma
            (normalizedPhaseEuclideanWalk n e points - y)) := by
    funext y
    exact phaseSmoothedDensity_eq_expectation_kernel n points sigma y
  rw [heq]
  unfold uniformExpectation
  apply Continuous.div_const
  apply continuous_finset_sum
  intro e _he
  exact (continuous_phaseGaussianKernel m sigma).comp
    (continuous_const.sub continuous_id)

lemma abs_setIntegral_phaseSmoothedDensity_sub_limiting_le
    (m n : ℕ) (hm : 0 < m) (points : Fin m → ℝ) (sigma delta : ℝ)
    (s : Set (PhaseEuclidean m)) (hsfinite : volume s ≠ ⊤)
    (hdelta : 0 ≤ delta)
    (hclose : ∀ y : PhaseEuclidean m,
      |phaseSmoothedDensity n points sigma y - phaseLimitingDensity y| ≤ delta) :
    |(∫ y in s, phaseSmoothedDensity n points sigma y) -
        ∫ y in s, phaseLimitingDensity y| ≤ delta * volume.real s := by
  let d : PhaseEuclidean m → ℝ := fun y ↦
    phaseSmoothedDensity n points sigma y - phaseLimitingDensity y
  have hdcont : Continuous d :=
    (continuous_phaseSmoothedDensity m n points sigma).sub
      (continuous_phaseLimitingDensity m)
  have hd : IntegrableOn d s :=
    Measure.integrableOn_of_bounded hsfinite hdcont.aestronglyMeasurable
      (Eventually.of_forall fun y ↦ by
        rw [Real.norm_eq_abs]
        exact hclose y)
  have hlim : IntegrableOn (phaseLimitingDensity : PhaseEuclidean m → ℝ) s :=
    (integrable_phaseLimitingDensity m hm).integrableOn
  have hsmooth : IntegrableOn (phaseSmoothedDensity n points sigma) s := by
    apply (hd.add hlim).congr
    filter_upwards [] with y
    dsimp [d]
    ring
  rw [← integral_sub hsmooth hlim]
  simpa only [d, Real.norm_eq_abs] using
    (norm_setIntegral_le_of_norm_le_const (f := d) (C := delta)
      hsfinite.lt_top fun y _hy ↦ by
        simpa only [d, Real.norm_eq_abs] using hclose y)

theorem eventually_uniform_scaled_truncatedPhaseDensity_error
    (m : ℕ) (hm : 0 < m)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hfactor : 0 ≤ widthFactor) (hu : 0 ≤ u)
    (hvelLower : 0 < velocityLower) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      |(localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) -
        (localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseLimitingDensity y)| < eps := by
  let C : ℝ := (4 * Real.pi * widthFactor * u *
    ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper, ‖b‖) ^ m
  have hV : 0 ≤ ∫ b : ℂ in blockVelocityAnnulus velocityLower velocityUpper, ‖b‖ :=
    integral_nonneg fun _ ↦ norm_nonneg _
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  let delta : ℝ := eps / (C + 1)
  have hdelta : 0 < delta := div_pos heps (by linarith)
  filter_upwards [Nat.eventually_pos,
      eventually_uniform_phaseSmoothedDensity hm hdelta]
    with n hn hclt
  intro points hsmooth hspread
  let s := truncatedPhaseRegion (m := m) n u
    (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper
  have hsfinite : volume s ≠ ⊤ :=
    volume_truncatedPhaseRegion_ne_top m n hm hn u
      (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper hu
      (mul_nonneg hfactor (by unfold localMeshHalfWidth; positivity)) hvelLower
  have hclose : ∀ y : PhaseEuclidean m,
      |phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y -
        phaseLimitingDensity y| ≤ delta := fun y ↦
    (hclt points y hsmooth hspread).le
  have hbound := abs_setIntegral_phaseSmoothedDensity_sub_limiting_le
    m n hm points (localCLTSmoothingScaleTest n) delta s hsfinite hdelta.le hclose
  have hmesh : 0 ≤ (localMeshSize n : ℝ) ^ m := by positivity
  have hvol : (localMeshSize n : ℝ) ^ m * volume.real s = C := by
    simpa only [s, C] using
      scaled_volumeReal_truncatedPhaseFactorRegion m n hm hn widthFactor u
        velocityLower velocityUpper hfactor hu hvelLower
  rw [show
      (localMeshSize n : ℝ) ^ m * (∫ y in s,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) -
        (localMeshSize n : ℝ) ^ m * (∫ y in s, phaseLimitingDensity y) =
      (localMeshSize n : ℝ) ^ m *
        ((∫ y in s, phaseSmoothedDensity n points
            (localCLTSmoothingScaleTest n) y) -
          ∫ y in s, phaseLimitingDensity y) by ring,
    abs_mul, abs_of_nonneg hmesh]
  calc
    (localMeshSize n : ℝ) ^ m *
        |(∫ y in s, phaseSmoothedDensity n points
            (localCLTSmoothingScaleTest n) y) -
          ∫ y in s, phaseLimitingDensity y| ≤
        (localMeshSize n : ℝ) ^ m * (delta * volume.real s) :=
      mul_le_mul_of_nonneg_left hbound hmesh
    _ = delta * C := by rw [← hvol]; ring
    _ < eps := by
      dsimp [delta]
      rw [show eps / (C + 1) * C = eps * (C / (C + 1)) by ring]
      have hfrac : C / (C + 1) < 1 :=
        (div_lt_one (by linarith)).2 (by linarith)
      simpa using mul_lt_mul_of_pos_left hfrac heps

noncomputable def phaseBoundaryGaussianTail (m n : ℕ) : ℝ :=
  2 ^ (2 * m) * Real.exp (-(phaseBoundaryRadius n ^ 2 /
    (4 * localCLTSmoothingScaleTest n ^ 2)))

lemma phaseBoundaryGaussianExponent_eq
    (n : ℕ) (hn : 0 < n) :
    phaseBoundaryRadius n ^ 2 /
        (4 * localCLTSmoothingScaleTest n ^ 2) =
      (1 / 4 : ℝ) * rigidityPower n (1 / 2) := by
  unfold phaseBoundaryRadius localCLTSmoothingScaleTest
  rw [rigidityPower_nat_pow hn, rigidityPower_nat_pow hn]
  rw [show (-(7 / 4 : ℝ)) * (2 : ℕ) = 1 / 2 + ((-2 : ℝ) * (2 : ℕ)) by
    norm_num]
  rw [rigidityPower_add hn]
  rw [show (-2 : ℝ) * (2 : ℕ) = -(2 * (2 : ℝ)) by norm_num]
  have hne : rigidityPower n ((-2 : ℝ) * (2 : ℕ)) ≠ 0 :=
    (rigidityPower_pos hn _).ne'
  have hne' : rigidityPower n (-(2 * (2 : ℝ))) ≠ 0 :=
    (rigidityPower_pos hn _).ne'
  field_simp [hne, hne']
  exact mul_div_cancel_right₀ _ (rigidityPower_pos hn _).ne'

lemma meshQuotient_tendsto_one :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) / rigidityPower n 2) atTop (nhds 1) := by
  have h := meshRatio_tendsto_one.inv₀ one_ne_zero
  simpa only [inv_one] using h.congr' (by
    filter_upwards [Nat.eventually_pos] with n hn
    unfold localMeshSize rigidityPower
    push_cast
    have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
    field_simp
    exact Real.rpow_natCast (n : ℝ) 2)

lemma scaled_phaseBoundaryGaussianTail_tendsto_zero (m : ℕ) :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) ^ m * phaseBoundaryGaussianTail m n)
      atTop (nhds 0) := by
  have hquot := meshQuotient_tendsto_one.pow m
  have hcore := tendsto_rigidityPower_mul_exp_neg_power_test
    (2 * (m : ℝ)) (1 / 2) (1 / 4) (by norm_num) (by norm_num)
  have h := (hquot.mul hcore).const_mul (2 ^ (2 * m) : ℝ)
  simp only [one_pow, one_mul, mul_zero] at h
  apply h.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  unfold phaseBoundaryGaussianTail
  rw [phaseBoundaryGaussianExponent_eq n hn]
  have hpow : rigidityPower n 2 ^ m =
      rigidityPower n (2 * (m : ℝ)) := by
    simpa using rigidityPower_nat_pow hn 2 m
  have hbase : (localMeshSize n : ℝ) ^ m =
      ((localMeshSize n : ℝ) / rigidityPower n 2) ^ m *
        rigidityPower n (2 * (m : ℝ)) := by
    rw [← hpow, div_pow]
    have hne : rigidityPower n 2 ^ m ≠ 0 :=
      pow_ne_zero _ (rigidityPower_pos hn 2).ne'
    field_simp [hne]
  rw [hbase]
  ring

lemma continuousAt_blockVelocityMass (velocityLower velocityUpper : ℝ) :
    ContinuousAt (fun p : ℝ × ℝ ↦ blockVelocityMass p.1 p.2)
      (velocityLower, velocityUpper) := by
  change Tendsto (fun p : ℝ × ℝ ↦ blockVelocityMass p.1 p.2)
    (𝓝 (velocityLower, velocityUpper))
    (𝓝 (blockVelocityMass velocityLower velocityUpper))
  let f : ℂ → ℝ := fun b ↦
    ‖b‖ * Real.exp (-3 * Complex.normSq b)
  let F : (ℝ × ℝ) → ℂ → ℝ := fun p ↦
    (blockVelocityAnnulus p.1 p.2).indicator f
  have haeLower : ∀ᵐ b : ℂ ∂volume, ‖b‖ ≠ velocityLower := by
    rw [ae_iff]
    have hsphere := MeasureTheory.Measure.addHaar_sphere (volume : Measure ℂ)
      (0 : ℂ) velocityLower
    rw [show {b : ℂ | ¬ ‖b‖ ≠ velocityLower} =
        Metric.sphere (0 : ℂ) velocityLower by
      ext b
      simp only [Set.mem_setOf_eq, Metric.mem_sphere, dist_zero_right, not_ne_iff]]
    exact hsphere
  have haeUpper : ∀ᵐ b : ℂ ∂volume, ‖b‖ ≠ velocityUpper := by
    rw [ae_iff]
    have hsphere := MeasureTheory.Measure.addHaar_sphere (volume : Measure ℂ)
      (0 : ℂ) velocityUpper
    rw [show {b : ℂ | ¬ ‖b‖ ≠ velocityUpper} =
        Metric.sphere (0 : ℂ) velocityUpper by
      ext b
      simp only [Set.mem_setOf_eq, Metric.mem_sphere, dist_zero_right, not_ne_iff]]
    exact hsphere
  have hDCT := tendsto_integral_filter_of_dominated_convergence
    f (F := F) (f := F (velocityLower, velocityUpper))
    (Eventually.of_forall fun p ↦
      integrable_complex_norm_mul_exp_neg_three_normSq.aestronglyMeasurable.indicator
        (measurableSet_blockVelocityAnnulus p.1 p.2))
    (Eventually.of_forall fun p ↦ Eventually.of_forall fun b ↦ by
      have hf0 : 0 ≤ f b := by dsimp [f]; positivity
      by_cases hb : b ∈ blockVelocityAnnulus p.1 p.2
      · rw [show F p b = f b by simp [F, hb]]
        rw [Real.norm_eq_abs, abs_of_nonneg hf0]
      · rw [show F p b = 0 by simp [F, hb]]
        simpa only [Real.norm_eq_abs, norm_zero] using hf0)
    integrable_complex_norm_mul_exp_neg_three_normSq
    (by
      filter_upwards [haeLower, haeUpper] with b hbLower hbUpper
      by_cases hb : b ∈ blockVelocityAnnulus velocityLower velocityUpper
      · have hLower : velocityLower < ‖b‖ :=
          lt_of_le_of_ne hb.1 (Ne.symm hbLower)
        have hUpper : ‖b‖ < velocityUpper :=
          lt_of_le_of_ne hb.2 hbUpper
        have hevLower : ∀ᶠ p : ℝ × ℝ in 𝓝 (velocityLower, velocityUpper),
            p.1 < ‖b‖ :=
          (continuousAt_fst.tendsto.eventually (Iio_mem_nhds hLower))
        have hevUpper : ∀ᶠ p : ℝ × ℝ in 𝓝 (velocityLower, velocityUpper),
            ‖b‖ < p.2 :=
          (continuousAt_snd.tendsto.eventually (Ioi_mem_nhds hUpper))
        apply tendsto_const_nhds.congr'
        filter_upwards [hevLower, hevUpper] with p hpLower hpUpper
        have hp : b ∈ blockVelocityAnnulus p.1 p.2 :=
          ⟨hpLower.le, hpUpper.le⟩
        rw [show F p b = f b by simp [F, hp]]
        rw [show F (velocityLower, velocityUpper) b = f b by
          simp [F, hb]]
      · have hbad : ‖b‖ < velocityLower ∨ velocityUpper < ‖b‖ := by
          change ¬(velocityLower ≤ ‖b‖ ∧ ‖b‖ ≤ velocityUpper) at hb
          rcases not_and_or.mp hb with hbad | hbad
          · exact Or.inl (lt_of_not_ge hbad)
          · exact Or.inr (lt_of_not_ge hbad)
        rcases hbad with hbad | hbad
        · have hev : ∀ᶠ p : ℝ × ℝ in 𝓝 (velocityLower, velocityUpper),
              ‖b‖ < p.1 :=
            continuousAt_fst.tendsto.eventually (Ioi_mem_nhds hbad)
          apply tendsto_const_nhds.congr'
          filter_upwards [hev] with p hp
          have hp' : b ∉ blockVelocityAnnulus p.1 p.2 := fun hmem ↦
            (not_le_of_gt hp) hmem.1
          rw [show F p b = 0 by simp [F, hp']]
          rw [show F (velocityLower, velocityUpper) b = 0 by simp [F, hb]]
        · have hev : ∀ᶠ p : ℝ × ℝ in 𝓝 (velocityLower, velocityUpper),
              p.2 < ‖b‖ :=
            continuousAt_snd.tendsto.eventually (Iio_mem_nhds hbad)
          apply tendsto_const_nhds.congr'
          filter_upwards [hev] with p hp
          have hp' : b ∉ blockVelocityAnnulus p.1 p.2 := fun hmem ↦
            (not_le_of_gt hp) hmem.2
          rw [show F p b = 0 by simp [F, hp']]
          rw [show F (velocityLower, velocityUpper) b = 0 by simp [F, hb]])
  simpa only [blockVelocityMass, F, f,
    integral_indicator (measurableSet_blockVelocityAnnulus _ _)] using hDCT

theorem eventually_uniform_scaled_smoothed_truncatedPhaseFactorMass
    (m : ℕ) (hm : 0 < m)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hfactor : 0 ≤ widthFactor) (hu : 0 ≤ u)
    (hvelLower : 0 < velocityLower) (hvelUpper : 0 ≤ velocityUpper)
    {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      |(localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) -
        (widthFactor * ((12 * u / Real.pi) *
          blockVelocityMass velocityLower velocityUpper)) ^ m| < eps := by
  let A : ℝ := (widthFactor * ((12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper)) ^ m
  have hhalf : 0 < eps / 2 := by linarith
  have herr := eventually_uniform_scaled_truncatedPhaseDensity_error
    m hm widthFactor u velocityLower velocityUpper hfactor hu hvelLower hhalf
  have hlimit := scaled_truncatedPhaseFactorMass_tendsto m hm widthFactor u
    velocityLower velocityUpper hfactor hu hvelLower hvelUpper
  have hlim : ∀ᶠ n : ℕ in atTop,
      |(localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseLimitingDensity y) - A| < eps / 2 := by
    have hball := hlimit.eventually (Metric.ball_mem_nhds A hhalf)
    filter_upwards [hball] with n hn
    simpa only [Metric.mem_ball, Real.dist_eq, A] using hn
  filter_upwards [herr, hlim] with n hnerr hnlim
  intro points hsmooth hspread
  have h₁ := hnerr points hsmooth hspread
  have htriangle := abs_add_le
    ((localMeshSize n : ℝ) ^ m *
        (∫ y in truncatedPhaseRegion (m := m) n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) -
      (localMeshSize n : ℝ) ^ m *
        (∫ y in truncatedPhaseRegion (m := m) n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
          phaseLimitingDensity y))
    ((localMeshSize n : ℝ) ^ m *
        (∫ y in truncatedPhaseRegion (m := m) n u
          (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
          phaseLimitingDensity y) - A)
  change |(localMeshSize n : ℝ) ^ m *
      (∫ y in truncatedPhaseRegion (m := m) n u
        (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
        phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) - A| < eps
  calc
    _ = |((localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) -
        (localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseLimitingDensity y)) +
        ((localMeshSize n : ℝ) ^ m *
          (∫ y in truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper,
            phaseLimitingDensity y) - A)| := by congr 1; ring
    _ ≤ _ := htriangle
    _ < eps / 2 + eps / 2 := add_lt_add h₁ hnlim
    _ = eps := by ring

lemma phaseSmoothedDensity_nonneg
    (m n : ℕ) (points : Fin m → ℝ) (sigma : ℝ)
    (y : PhaseEuclidean m) :
    0 ≤ phaseSmoothedDensity n points sigma y := by
  rw [phaseSmoothedDensity_eq_expectation_kernel]
  unfold uniformExpectation
  apply div_nonneg
  · exact Finset.sum_nonneg fun e _ ↦ phaseGaussianKernel_nonneg m sigma _
  · positivity

lemma integrable_phaseSmoothedDensity
    (m n : ℕ) (points : Fin m → ℝ) (sigma : ℝ) (hsigma : 0 < sigma) :
    Integrable (phaseSmoothedDensity n points sigma) := by
  have heq : phaseSmoothedDensity n points sigma =
      fun y : PhaseEuclidean m ↦
        (∑ e : SignVector (2 * n), phaseGaussianKernel m sigma
          (normalizedPhaseEuclideanWalk n e points - y)) /
            Fintype.card (SignVector (2 * n)) := by
    funext y
    rw [phaseSmoothedDensity_eq_expectation_kernel]
    rfl
  rw [heq]
  apply Integrable.div_const
  classical
  have hsum : ∀ s : Finset (SignVector (2 * n)),
      Integrable (fun y : PhaseEuclidean m ↦
        ∑ e ∈ s, phaseGaussianKernel m sigma
          (normalizedPhaseEuclideanWalk n e points - y)) := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | @insert e s he ih =>
        simp only [Finset.sum_insert he]
        exact (integrable_phaseGaussianKernel_sub_left m sigma hsigma
          (normalizedPhaseEuclideanWalk n e points)).add ih
  simpa using hsum Finset.univ

noncomputable def truncatedPhaseProbability
    (m n : ℕ) (points : Fin m → ℝ)
    (u velocityLower velocityUpper : ℝ) : ℝ :=
  uniformProbability (fun e : SignVector (2 * n) ↦
    normalizedPhaseEuclideanWalk n e points ∈
      truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
        velocityLower velocityUpper)

theorem eventually_uniform_scaled_truncatedPhaseProbability_bracket
    (m : ℕ) (hm : 0 < m)
    (u velocityLower velocityUpper eta tol : ℝ)
    (hu : 0 ≤ u) (hvelLower : 0 < velocityLower)
    (heta : 0 < eta) (hetaOne : eta < 1) (hetaU : eta < u)
    (hetaLower : eta < velocityLower) (hetaUpper : eta < velocityUpper)
    (htol : 0 < tol) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ((1 - eta) * ((12 * (u - eta) / Real.pi) *
          blockVelocityMass (velocityLower + eta) (velocityUpper - eta))) ^ m - tol <
        (localMeshSize n : ℝ) ^ m *
          truncatedPhaseProbability m n points u velocityLower velocityUpper ∧
      (localMeshSize n : ℝ) ^ m *
          truncatedPhaseProbability m n points u velocityLower velocityUpper <
        ((1 + eta) * ((12 * (u + eta) / Real.pi) *
          blockVelocityMass (velocityLower - eta) (velocityUpper + eta))) ^ m + tol := by
  let Aminus : ℝ := ((1 - eta) * ((12 * (u - eta) / Real.pi) *
    blockVelocityMass (velocityLower + eta) (velocityUpper - eta))) ^ m
  let Aplus : ℝ := ((1 + eta) * ((12 * (u + eta) / Real.pi) *
    blockVelocityMass (velocityLower - eta) (velocityUpper + eta))) ^ m
  have htolHalf : 0 < tol / 2 := by linarith
  have hmassMinus :=
    eventually_uniform_scaled_smoothed_truncatedPhaseFactorMass
      m hm (1 - eta) (u - eta) (velocityLower + eta) (velocityUpper - eta)
      (sub_nonneg.mpr hetaOne.le) (sub_nonneg.mpr hetaU.le) (by linarith)
      (by linarith) htolHalf
  have hmassPlus :=
    eventually_uniform_scaled_smoothed_truncatedPhaseFactorMass
      m hm (1 + eta) (u + eta) (velocityLower - eta) (velocityUpper + eta)
      (by linarith) (by linarith) (by linarith) (by linarith) htolHalf
  have htail : ∀ᶠ n : ℕ in atTop,
      (localMeshSize n : ℝ) ^ m * phaseBoundaryGaussianTail m n < tol / 2 :=
    (scaled_phaseBoundaryGaussianTail_tendsto_zero m).eventually
      (Iio_mem_nhds htolHalf)
  filter_upwards [Nat.eventually_pos,
      eventually_thickening_truncatedMeshRegion_subset_expanded
        m u velocityLower velocityUpper eta hu hvelLower heta,
      eventually_shrunkMeshRegion_subset_innerErosion
        m u velocityLower velocityUpper eta heta hetaOne hetaU hvelLower hetaUpper,
      hmassMinus, hmassPlus, htail]
    with n hn houter hinner hmassMinusN hmassPlusN htailN
  intro points hsmooth hspread
  let q : ℝ := (localMeshSize n : ℝ) ^ m
  let p : ℝ := truncatedPhaseProbability m n points u velocityLower velocityUpper
  let tail : ℝ := phaseBoundaryGaussianTail m n
  let target := truncatedPhaseRegion (m := m) n u (localMeshHalfWidth n)
    velocityLower velocityUpper
  let expanded := truncatedPhaseRegion (m := m) n (u + eta)
    ((1 + eta) * localMeshHalfWidth n) (velocityLower - eta) (velocityUpper + eta)
  let shrunk := truncatedPhaseRegion (m := m) n (u - eta)
    ((1 - eta) * localMeshHalfWidth n) (velocityLower + eta) (velocityUpper - eta)
  have hsigma : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  have hq : 0 ≤ q := by dsimp [q]; positivity
  have htail0 : 0 ≤ tail := by
    dsimp [tail, phaseBoundaryGaussianTail]
    positivity
  have hp0 : 0 ≤ p := by
    dsimp [p, truncatedPhaseProbability]
    exact uniformProbability_nonneg _
  have hp1 : p ≤ 1 := by
    dsimp [p, truncatedPhaseProbability]
    exact uniformProbability_le_one _
  have hInt := integrable_phaseSmoothedDensity m n points
    (localCLTSmoothingScaleTest n) hsigma
  have hnonneg : ∀ y : PhaseEuclidean m,
      0 ≤ phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y :=
    phaseSmoothedDensity_nonneg m n points (localCLTSmoothingScaleTest n)
  have houterIntegral :
      (∫ y in Metric.thickening (phaseBoundaryRadius n) target,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        ∫ y in expanded,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y := by
    exact setIntegral_mono_set hInt.integrableOn (Eventually.of_forall hnonneg)
      (Eventually.of_forall fun x hx ↦ by
        change x ∈ expanded
        apply houter
        change x ∈ Metric.thickening (phaseBoundaryRadius n) target
        exact hx)
  have hupperSandwich :=
    uniformProbability_mul_gaussianLower_le_integral_thickening
      n points (localCLTSmoothingScaleTest n) (phaseBoundaryRadius n)
      hsigma (phaseBoundaryRadius_nonneg n) target
  have hupperRaw : p * (1 - tail) ≤
      ∫ y in expanded,
        phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y := by
    apply hupperSandwich.trans houterIntegral
  have hupperScaled : q * p ≤
      q * (∫ y in expanded,
        phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) + q * tail := by
    have hmain := mul_le_mul_of_nonneg_left hupperRaw hq
    have hpt : q * p * tail ≤ q * tail := by
      have hpTail := mul_le_mul_of_nonneg_right hp1 htail0
      nlinarith
    nlinarith
  have hinnerIntegral :
      (∫ y in shrunk,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        ∫ y in (Metric.thickening (phaseBoundaryRadius n) targetᶜ)ᶜ,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y := by
    exact setIntegral_mono_set hInt.integrableOn (Eventually.of_forall hnonneg)
      (Eventually.of_forall fun x hx ↦ by
        change x ∈ (Metric.thickening (phaseBoundaryRadius n) targetᶜ)ᶜ
        apply hinner
        change x ∈ shrunk
        exact hx)
  have hlowerSandwich := integral_innerErosion_phaseSmoothedDensity_le
    n points (localCLTSmoothingScaleTest n) (phaseBoundaryRadius n)
    hsigma (phaseBoundaryRadius_nonneg n) target
  have hlowerRaw :
      (∫ y in shrunk,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        p + tail := by
    exact hinnerIntegral.trans (by
      simpa only [p, tail, target, truncatedPhaseProbability,
        phaseBoundaryGaussianTail] using hlowerSandwich)
  have hlowerScaled :
      q * (∫ y in shrunk,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        q * p + q * tail := by
    have := mul_le_mul_of_nonneg_left hlowerRaw hq
    nlinarith
  have hminus := hmassMinusN points hsmooth hspread
  have hplus := hmassPlusN points hsmooth hspread
  have hminusBounds := abs_lt.mp (by simpa only [q, shrunk, Aminus] using hminus)
  have hplusBounds := abs_lt.mp (by simpa only [q, expanded, Aplus] using hplus)
  have htailBound : q * tail < tol / 2 := by
    simpa only [q, tail] using htailN
  constructor
  · change Aminus - tol < q * p
    nlinarith [hminusBounds.1, hlowerScaled]
  · change q * p < Aplus + tol
    nlinarith [hplusBounds.2, hupperScaled]

lemma continuousAt_expandedTruncatedPhaseIntensity
    (m : ℕ) (u velocityLower velocityUpper : ℝ) :
    ContinuousAt (fun eta : ℝ ↦
      ((1 + eta) * ((12 * (u + eta) / Real.pi) *
        blockVelocityMass (velocityLower - eta) (velocityUpper + eta))) ^ m) 0 := by
  have hmass : ContinuousAt (fun eta : ℝ ↦
      blockVelocityMass (velocityLower - eta) (velocityUpper + eta)) 0 :=
    by
      let g : ℝ → ℝ × ℝ := fun eta ↦
        (velocityLower - eta, velocityUpper + eta)
      have hg : ContinuousAt g 0 := by dsimp [g]; fun_prop
      have hbase : ContinuousAt (fun p : ℝ × ℝ ↦
          blockVelocityMass p.1 p.2) (g 0) := by
        dsimp [g]
        simpa only [sub_zero, add_zero] using
          continuousAt_blockVelocityMass velocityLower velocityUpper
      convert hbase.comp hg using 1
      ext eta
      rfl
  exact (((continuousAt_const.add continuousAt_id).mul
    ((((continuousAt_const.add continuousAt_id).const_mul 12).div_const Real.pi).mul
      hmass)).pow m)

lemma continuousAt_shrunkTruncatedPhaseIntensity
    (m : ℕ) (u velocityLower velocityUpper : ℝ) :
    ContinuousAt (fun eta : ℝ ↦
      ((1 - eta) * ((12 * (u - eta) / Real.pi) *
        blockVelocityMass (velocityLower + eta) (velocityUpper - eta))) ^ m) 0 := by
  have hmass : ContinuousAt (fun eta : ℝ ↦
      blockVelocityMass (velocityLower + eta) (velocityUpper - eta)) 0 :=
    by
      let g : ℝ → ℝ × ℝ := fun eta ↦
        (velocityLower + eta, velocityUpper - eta)
      have hg : ContinuousAt g 0 := by dsimp [g]; fun_prop
      have hbase : ContinuousAt (fun p : ℝ × ℝ ↦
          blockVelocityMass p.1 p.2) (g 0) := by
        dsimp [g]
        simpa only [sub_zero, add_zero] using
          continuousAt_blockVelocityMass velocityLower velocityUpper
      convert hbase.comp hg using 1
      ext eta
      rfl
  exact (((continuousAt_const.sub continuousAt_id).mul
    ((((continuousAt_const.sub continuousAt_id).const_mul 12).div_const Real.pi).mul
      hmass)).pow m)

theorem eventually_uniform_scaled_truncatedPhaseProbability
    (m : ℕ) (hm : 0 < m)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 < u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 < velocityUpper)
    {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      |(localMeshSize n : ℝ) ^ m *
          truncatedPhaseProbability m n points u velocityLower velocityUpper -
        (((12 * u / Real.pi) *
          blockVelocityMass velocityLower velocityUpper) ^ m)| < eps := by
  let A : ℝ := (((12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper) ^ m)
  let etaSeq : ℕ → ℝ := fun k ↦ 1 / (k + 1 : ℝ)
  have hetaZero : Tendsto etaSeq atTop (nhds 0) := by
    simpa only [etaSeq] using tendsto_one_div_add_atTop_nhds_zero_nat
  have hplus := (continuousAt_expandedTruncatedPhaseIntensity
    m u velocityLower velocityUpper).tendsto.comp hetaZero
  have hminus := (continuousAt_shrunkTruncatedPhaseIntensity
    m u velocityLower velocityUpper).tendsto.comp hetaZero
  have hplus' : Tendsto (fun k : ℕ ↦
      ((1 + etaSeq k) * ((12 * (u + etaSeq k) / Real.pi) *
        blockVelocityMass (velocityLower - etaSeq k)
          (velocityUpper + etaSeq k))) ^ m) atTop (nhds A) := by
    simpa [Function.comp_def, A] using hplus
  have hminus' : Tendsto (fun k : ℕ ↦
      ((1 - etaSeq k) * ((12 * (u - etaSeq k) / Real.pi) *
        blockVelocityMass (velocityLower + etaSeq k)
          (velocityUpper - etaSeq k))) ^ m) atTop (nhds A) := by
    simpa [Function.comp_def, A] using hminus
  have hhalf : 0 < eps / 2 := by linarith
  have hplusClose : ∀ᶠ k : ℕ in atTop,
      ((1 + etaSeq k) * ((12 * (u + etaSeq k) / Real.pi) *
        blockVelocityMass (velocityLower - etaSeq k)
          (velocityUpper + etaSeq k))) ^ m < A + eps / 2 :=
    hplus'.eventually (Iio_mem_nhds (lt_add_of_pos_right A hhalf))
  have hminusClose : ∀ᶠ k : ℕ in atTop,
      A - eps / 2 <
        ((1 - etaSeq k) * ((12 * (u - etaSeq k) / Real.pi) *
          blockVelocityMass (velocityLower + etaSeq k)
            (velocityUpper - etaSeq k))) ^ m :=
    hminus'.eventually (Ioi_mem_nhds (sub_lt_self A hhalf))
  have hetaOne : ∀ᶠ k : ℕ in atTop, etaSeq k < 1 :=
    hetaZero.eventually (Iio_mem_nhds zero_lt_one)
  have hetaU : ∀ᶠ k : ℕ in atTop, etaSeq k < u :=
    hetaZero.eventually (Iio_mem_nhds hu)
  have hetaLower : ∀ᶠ k : ℕ in atTop, etaSeq k < velocityLower :=
    hetaZero.eventually (Iio_mem_nhds hvelLower)
  have hetaUpper : ∀ᶠ k : ℕ in atTop, etaSeq k < velocityUpper :=
    hetaZero.eventually (Iio_mem_nhds hvelUpper)
  rcases (hplusClose.and (hminusClose.and
      (hetaOne.and (hetaU.and (hetaLower.and hetaUpper))))).exists with
    ⟨k, hplusK, hminusK, hetaOneK, hetaUK, hetaLowerK, hetaUpperK⟩
  have hetaPos : 0 < etaSeq k := by
    dsimp [etaSeq]
    positivity
  have hbracket := eventually_uniform_scaled_truncatedPhaseProbability_bracket
    m hm u velocityLower velocityUpper (etaSeq k) (eps / 2) hu.le hvelLower
    hetaPos hetaOneK hetaUK hetaLowerK hetaUpperK hhalf
  filter_upwards [hbracket] with n hn
  intro points hsmooth hspread
  have h := hn points hsmooth hspread
  rw [abs_lt]
  dsimp only [A] at hminusK hplusK ⊢
  constructor
  ·
    nlinarith [h.1, hminusK]
  ·
    nlinarith [h.2, hplusK]


/-- The cutoff version of the finite representative count. -/
noncomputable def truncatedLocalMinimumCount
    (n : ℕ) (u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) : ℕ :=
  (Finset.univ.filter fun a : Fin (localMeshSize n) ↦
    IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a).card

lemma choose_truncatedLocalMinimumCount
    (n k : ℕ) (u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) :
    Nat.choose (truncatedLocalMinimumCount n u velocityLower velocityUpper e) k =
      ∑ s ∈ Finset.univ.powersetCard k,
        if ∀ a ∈ s,
          IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
        then 1 else 0 := by
  classical
  unfold truncatedLocalMinimumCount
  convert choose_card_filter_eq_sum_powersetCard
    (fun a : Fin (localMeshSize n) ↦
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) k using 1
  apply Finset.sum_congr rfl
  intro s _hs
  by_cases h : ∀ a ∈ s,
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
  · rw [if_pos h, if_pos h]
  · rw [if_neg h, if_neg h]

lemma uniformChooseMoment_truncatedLocalMinimumCount
    (n k : ℕ) (u velocityLower velocityUpper : ℝ) :
    uniformChooseMoment
        (truncatedLocalMinimumCount n u velocityLower velocityUpper) k =
      ∑ s ∈ Finset.univ.powersetCard k,
        uniformProbability (fun e : SignVector (2 * n) ↦
          ∀ a ∈ s,
            IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) := by
  unfold uniformChooseMoment
  have heq :
      (fun e : SignVector (2 * n) ↦
        (Nat.choose
          (truncatedLocalMinimumCount n u velocityLower velocityUpper e) k : ℝ)) =
      (fun e ↦ ∑ s ∈ Finset.univ.powersetCard k,
        if ∀ a ∈ s,
          IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
        then (1 : ℝ) else 0) := by
    funext e
    exact_mod_cast choose_truncatedLocalMinimumCount
      n k u velocityLower velocityUpper e
  rw [heq]
  rw [uniformExpectation_finset_sum
    (Ω := SignVector (2 * n))
    (I := Finset (Fin (localMeshSize n)))
    (s := Finset.univ.powersetCard k)
    (X := fun s (e : SignVector (2 * n)) ↦
      if ∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
      then (1 : ℝ) else 0)]
  apply Finset.sum_congr rfl
  intro s _hs
  unfold uniformExpectation uniformProbability
  congr 1
  simp
  apply congrArg Finset.card
  ext e
  simp

noncomputable def halfSmoothLocalMeshSites (n : ℕ) :
    Finset (Fin (localMeshSize n)) :=
  (halfLocalMeshSites n).filter fun a ↦
    IsSmooth n (rigiditySmoothScale n) (localMeshPoint n a)

/-- Cook--Nguyen's cutoff representative count on the real fundamental
half-period, with all nonsmooth mesh centers removed. -/
noncomputable def halfTruncatedLocalMinimumCount
    (n : ℕ) (u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) : ℕ :=
  ((halfSmoothLocalMeshSites n).filter fun a ↦
    IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a).card

lemma choose_card_filter_eq_sum_powersetCard_on
    {I : Type*} [Fintype I] [DecidableEq I]
    (H : Finset I) (P : I → Prop) (k : ℕ) :
    Nat.choose (H.filter P).card k =
      ∑ s ∈ H.powersetCard k,
        if ∀ i ∈ s, P i then 1 else 0 := by
  classical
  let G : Finset I := H.filter P
  have hsets : G.powersetCard k =
      (H.powersetCard k).filter (fun s ↦ ∀ i ∈ s, P i) := by
    ext s
    simp only [Finset.mem_powersetCard, Finset.mem_filter]
    constructor
    · rintro ⟨hsub, hcard⟩
      refine ⟨⟨?_, hcard⟩, ?_⟩
      · intro i hi
        exact (Finset.mem_filter.mp (hsub hi)).1
      · intro i hi
        exact (Finset.mem_filter.mp (hsub hi)).2
    · rintro ⟨⟨hsub, hcard⟩, hP⟩
      refine ⟨?_, hcard⟩
      intro i hi
      exact Finset.mem_filter.mpr ⟨hsub hi, hP i hi⟩
  calc
    Nat.choose (H.filter P).card k = Nat.choose G.card k := by rfl
    _ = (G.powersetCard k).card := (Finset.card_powersetCard k G).symm
    _ = ((H.powersetCard k).filter
          (fun s ↦ ∀ i ∈ s, P i)).card := by rw [hsets]
    _ = ∑ s ∈ H.powersetCard k,
          if ∀ i ∈ s, P i then 1 else 0 := by simp

lemma uniformChooseMoment_halfTruncatedLocalMinimumCount
    (n k : ℕ) (u velocityLower velocityUpper : ℝ) :
    uniformChooseMoment
        (halfTruncatedLocalMinimumCount n u velocityLower velocityUpper) k =
      ∑ s ∈ (halfSmoothLocalMeshSites n).powersetCard k,
        uniformProbability (fun e : SignVector (2 * n) ↦
          ∀ a ∈ s,
            IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) := by
  unfold uniformChooseMoment
  have heq :
      (fun e : SignVector (2 * n) ↦
        (Nat.choose
          (halfTruncatedLocalMinimumCount n u velocityLower velocityUpper e)
          k : ℝ)) =
      (fun e ↦ ∑ s ∈ (halfSmoothLocalMeshSites n).powersetCard k,
        if ∀ a ∈ s,
          IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
        then (1 : ℝ) else 0) := by
    funext e
    unfold halfTruncatedLocalMinimumCount
    have hnat := choose_card_filter_eq_sum_powersetCard_on
      (halfSmoothLocalMeshSites n)
      (fun a ↦ IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
      k
    rw [hnat]
    push_cast
    apply Finset.sum_congr rfl
    intro s _hs
    by_cases h : ∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
    · simp [h]
    · simp [h]
  rw [heq]
  rw [uniformExpectation_finset_sum
    (Ω := SignVector (2 * n))
    (I := Finset (Fin (localMeshSize n)))
    (s := (halfSmoothLocalMeshSites n).powersetCard k)
    (X := fun s (e : SignVector (2 * n)) ↦
      if ∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a
      then (1 : ℝ) else 0)]
  apply Finset.sum_congr rfl
  intro s _hs
  unfold uniformExpectation uniformProbability
  congr 1
  simp
  apply congrArg Finset.card
  ext e
  simp

/-- A finite mesh set is good when every one of its sites is smooth and the
canonical enumeration is spread. -/
def IsGoodLocalSiteSet (n : ℕ)
    (s : Finset (Fin (localMeshSize n))) : Prop :=
  (∀ a ∈ s,
    IsSmooth n (rigiditySmoothScale n) (localMeshPoint n a)) ∧
  IsSpread n (rigiditySmoothScale n) (localSitesPoints s)

lemma joint_truncatedLocalProbability_eq_phase
    (n : ℕ) (hn : 0 < n) (u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower)
    (s : Finset (Fin (localMeshSize n))) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        ∀ a ∈ s,
          IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) =
      truncatedPhaseProbability s.card n (localSitesPoints s)
        u velocityLower velocityUpper := by
  unfold truncatedPhaseProbability
  apply congrArg uniformProbability
  funext e
  exact propext (joint_truncatedLocalRepresentatives_iff_region
    n hn u velocityLower velocityUpper hvelLower e s)

lemma IsGoodLocalSiteSet.smooth_points
    {n : ℕ} {s : Finset (Fin (localMeshSize n))}
    (hgood : IsGoodLocalSiteSet n s) :
    ∀ r, IsSmooth n (rigiditySmoothScale n) (localSitesPoints s r) := by
  intro r
  exact hgood.1 (localSite s r) (localSite_mem s r)

theorem eventually_uniform_scaled_good_truncatedLocalProbability
    (k : ℕ) (hk : 0 < k)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 < u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 < velocityUpper)
    {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ s : Finset (Fin (localMeshSize n)),
      s ∈ Finset.univ.powersetCard k →
      IsGoodLocalSiteSet n s →
      |(localMeshSize n : ℝ) ^ k *
          uniformProbability (fun e : SignVector (2 * n) ↦
            ∀ a ∈ s,
              IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) -
        (((12 * u / Real.pi) *
          blockVelocityMass velocityLower velocityUpper) ^ k)| < eps := by
  have hprob := eventually_uniform_scaled_truncatedPhaseProbability
    k hk u velocityLower velocityUpper hu hvelLower hvelUpper heps
  filter_upwards [hprob, Nat.eventually_pos] with n hnprob hn
  intro s hs hgood
  have hcard : s.card = k := (Finset.mem_powersetCard.mp hs).2
  subst k
  have hsmooth : ∀ r,
      IsSmooth n (rigiditySmoothScale n) (localSitesPoints s r) :=
    hgood.smooth_points
  rw [joint_truncatedLocalProbability_eq_phase n hn u velocityLower velocityUpper
    hvelLower s]
  exact hnprob (localSitesPoints s) hsmooth hgood.2

lemma localMeshPoint_smooth_argument
    (n : ℕ) (hn : 0 < n) (p : ℕ) (a : Fin (localMeshSize n)) :
    p * localMeshPoint n a / (Real.pi * n) =
      2 * p * (a : ℝ) / localMeshSize n + ((-(p : ℤ) : ℤ) : ℝ) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold localMeshPoint
  push_cast
  field_simp [hn0, Real.pi_ne_zero]
  ring

lemma distanceToInteger_localMeshPoint_smooth
    (n : ℕ) (hn : 0 < n) (p : ℕ) (a : Fin (localMeshSize n)) :
    distanceToInteger (p * localMeshPoint n a / (Real.pi * n)) =
      distanceToInteger (2 * p * (a : ℝ) / localMeshSize n) := by
  rw [localMeshPoint_smooth_argument n hn p a,
    distanceToInteger_add_int]

lemma localMeshPoint_sub_argument
    (n : ℕ) (hn : 0 < n)
    (a b : Fin (localMeshSize n)) :
    (localMeshPoint n a - localMeshPoint n b) / (2 * Real.pi * n) =
      ((a : ℝ) - (b : ℝ)) / localMeshSize n := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold localMeshPoint
  field_simp [hn0, Real.pi_ne_zero]
  ring

lemma localMeshPoint_add_argument
    (n : ℕ) (hn : 0 < n)
    (a b : Fin (localMeshSize n)) :
    (localMeshPoint n a + localMeshPoint n b) / (2 * Real.pi * n) =
      ((a : ℝ) + (b : ℝ)) / localMeshSize n + ((-1 : ℤ) : ℝ) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold localMeshPoint
  field_simp [hn0, Real.pi_ne_zero]
  ring

lemma distanceToInteger_localMeshPoint_add
    (n : ℕ) (hn : 0 < n)
    (a b : Fin (localMeshSize n)) :
    distanceToInteger
        ((localMeshPoint n a + localMeshPoint n b) / (2 * Real.pi * n)) =
      distanceToInteger (((a : ℝ) + (b : ℝ)) / localMeshSize n) := by
  rw [localMeshPoint_add_argument n hn a b, distanceToInteger_add_int]

lemma localMeshPoint_singleton_argument
    (n : ℕ) (hn : 0 < n) (a : Fin (localMeshSize n)) :
    localMeshPoint n a / (2 * Real.pi * n) =
      (a : ℝ) / localMeshSize n - 1 / 2 := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold localMeshPoint
  field_simp [hn0, Real.pi_ne_zero]
  ring

/-- Multiplication modulo a positive modulus, kept as an explicit finite map
for the mesh-counting argument. -/
def modularMultiply (M q : ℕ) (hM : 0 < M) (a : Fin M) : Fin M :=
  ⟨q * (a : ℕ) % M, Nat.mod_lt _ hM⟩

/-- The quotient accompanying `modularMultiply`.  The pair consisting of
remainder and quotient recovers the original index. -/
def modularQuotient (M q : ℕ) (hM : 0 < M) (hq : 0 < q)
    (a : Fin M) : Fin q :=
  ⟨q * (a : ℕ) / M, by
    rw [Nat.div_lt_iff_lt_mul hM]
    exact Nat.mul_lt_mul_of_pos_left a.isLt hq⟩

lemma modularMultiply_quotient_injective
    (M q : ℕ) (hM : 0 < M) (hq : 0 < q) :
    Function.Injective (fun a : Fin M ↦
      (modularMultiply M q hM a, modularQuotient M q hM hq a)) := by
  intro a b hab
  have hrem : q * (a : ℕ) % M = q * (b : ℕ) % M := by
    exact congrArg (fun x : Fin M × Fin q ↦ (x.1 : ℕ)) hab
  have hquot : q * (a : ℕ) / M = q * (b : ℕ) / M := by
    exact congrArg (fun x : Fin M × Fin q ↦ (x.2 : ℕ)) hab
  apply Fin.ext
  apply Nat.eq_of_mul_eq_mul_left hq
  calc
    q * (a : ℕ) = M * (q * (a : ℕ) / M) + q * (a : ℕ) % M := by
      exact (Nat.div_add_mod _ _).symm
    _ = M * (q * (b : ℕ) / M) + q * (b : ℕ) % M := by rw [hquot, hrem]
    _ = q * (b : ℕ) := Nat.div_add_mod _ _

lemma card_filter_modularMultiply_le
    (M q : ℕ) (hM : 0 < M) (hq : 0 < q)
    (B : Fin M → Prop) :
    (Finset.univ.filter fun a : Fin M ↦ B (modularMultiply M q hM a)).card ≤
      q * (Finset.univ.filter B).card := by
  classical
  let f : {a : Fin M // B (modularMultiply M q hM a)} →
      {r : Fin M // B r} × Fin q := fun a ↦
    (⟨modularMultiply M q hM a.1, a.2⟩,
      modularQuotient M q hM hq a.1)
  have hf : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    exact modularMultiply_quotient_injective M q hM hq
      (congrArg (fun x : {r : Fin M // B r} × Fin q ↦
        (x.1.1, x.2)) hab)
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_subtype, Fintype.card_prod,
    Fintype.card_fin, Nat.mul_comm] using hcard

lemma distanceToInteger_eq_self_of_nonneg_le_half
    {x : ℝ} (hx0 : 0 ≤ x) (hxhalf : x ≤ 1 / 2) :
    distanceToInteger x = x := by
  have hmem : x ∈ Set.Ioc (-1 / 2) (1 / 2) := by
    constructor <;> linarith
  rw [distanceToInteger,
    centeredModOne_eq_of_mem x x hmem ⟨0, by norm_num⟩]
  exact abs_of_nonneg hx0

lemma distanceToInteger_eq_one_sub_of_half_lt_lt_one
    {x : ℝ} (hxhalf : 1 / 2 < x) (hxone : x < 1) :
    distanceToInteger x = 1 - x := by
  have hmem : x - 1 ∈ Set.Ioc (-1 / 2) (1 / 2) := by
    constructor <;> linarith
  rw [distanceToInteger,
    centeredModOne_eq_of_mem x (x - 1) hmem ⟨1, by ring⟩]
  rw [abs_of_nonpos]
  · ring
  · linarith

lemma card_cyclicBoundary_le
    (M : ℕ) (hM : 0 < M) (delta : ℝ) (hdelta : 0 ≤ delta) :
    (Finset.univ.filter fun r : Fin M ↦
      distanceToInteger ((r : ℝ) / M) ≤ delta).card ≤
      2 * (Nat.floor (delta * M) + 1) := by
  classical
  let L : ℕ := Nat.floor (delta * M) + 1
  let f : {r : Fin M // distanceToInteger ((r : ℝ) / M) ≤ delta} →
      Fin L ⊕ Fin L := fun r ↦ by
    let x : ℝ := (r.1 : ℝ) / M
    by_cases hx : x ≤ 1 / 2
    · apply Sum.inl
      refine ⟨r.1, ?_⟩
      have hMreal : (0 : ℝ) < M := by exact_mod_cast hM
      have hx0 : 0 ≤ x := by dsimp [x]; positivity
      have hdist : distanceToInteger x = x :=
        distanceToInteger_eq_self_of_nonneg_le_half hx0 hx
      have hxdelta : x ≤ delta := by simpa [x, hdist] using r.2
      have hrdelta : (r.1 : ℝ) ≤ delta * M := by
        dsimp [x] at hxdelta
        exact (div_le_iff₀ hMreal).mp hxdelta
      exact Nat.lt_succ_of_le (Nat.le_floor hrdelta)
    · apply Sum.inr
      refine ⟨M - 1 - (r.1 : ℕ), ?_⟩
      have hMreal : (0 : ℝ) < M := by exact_mod_cast hM
      have hxhalf : 1 / 2 < x := lt_of_not_ge hx
      have hxone : x < 1 := by
        dsimp [x]
        exact (div_lt_one hMreal).2 (by exact_mod_cast r.1.isLt)
      have hdist : distanceToInteger x = 1 - x :=
        distanceToInteger_eq_one_sub_of_half_lt_lt_one hxhalf hxone
      have hxdelta : 1 - x ≤ delta := by simpa [x, hdist] using r.2
      have hrle : (r.1 : ℕ) ≤ M - 1 := by omega
      have hcast : ((M - 1 - (r.1 : ℕ) : ℕ) : ℝ) =
          (M : ℝ) - 1 - (r.1 : ℕ) := by
        rw [Nat.cast_sub hrle]
        rw [Nat.cast_sub (by omega : 1 ≤ M)]
        push_cast
        rfl
      have hrdelta : ((M - 1 - (r.1 : ℕ) : ℕ) : ℝ) ≤ delta * M := by
        rw [hcast]
        dsimp [x] at hxdelta
        have := mul_le_mul_of_nonneg_right hxdelta hMreal.le
        field_simp [hMreal.ne'] at this
        nlinarith
      exact Nat.lt_succ_of_le (Nat.le_floor hrdelta)
  have hf : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    dsimp only [f] at hab
    split at hab <;> split at hab
    · exact Fin.ext (congrArg (fun z : Fin L ⊕ Fin L ↦
        match z with
        | Sum.inl r => (r : ℕ)
        | Sum.inr r => (r : ℕ)) hab)
    · contradiction
    · contradiction
    · apply Fin.ext
      have hfin := Sum.inr.inj hab
      have hval := congrArg (fun z : Fin L ↦ (z : ℕ)) hfin
      change M - 1 - (a.1 : ℕ) = M - 1 - (b.1 : ℕ) at hval
      have ha : (a.1 : ℕ) ≤ M - 1 := by omega
      have hb : (b.1 : ℕ) ≤ M - 1 := by omega
      omega
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_subtype, Fintype.card_sum,
    Fintype.card_fin, L, two_mul] using hcard

lemma distanceToInteger_mul_div_eq_modularMultiply
    (M q : ℕ) (hM : 0 < M) (a : Fin M) :
    distanceToInteger (q * (a : ℝ) / M) =
      distanceToInteger ((modularMultiply M q hM a : ℕ) / (M : ℝ)) := by
  let k : ℕ := q * (a : ℕ) / M
  have hdecomp : q * (a : ℕ) = M * k + (modularMultiply M q hM a : ℕ) := by
    simpa [k, modularMultiply] using (Nat.div_add_mod (q * (a : ℕ)) M).symm
  have hdecompR : (q : ℝ) * (a : ℝ) =
      (M : ℝ) * k + (modularMultiply M q hM a : ℕ) := by
    exact_mod_cast hdecomp
  have heq : q * (a : ℝ) / M =
      ((modularMultiply M q hM a : ℕ) : ℝ) / M + ((k : ℤ) : ℝ) := by
    have hMreal : (0 : ℝ) < M := by exact_mod_cast hM
    push_cast
    field_simp [hMreal.ne']
    nlinarith [hdecompR]
  rw [heq, distanceToInteger_add_int]

lemma card_modularDistance_le
    (M q : ℕ) (hM : 0 < M) (hq : 0 < q)
    (delta : ℝ) (hdelta : 0 ≤ delta) :
    (Finset.univ.filter fun a : Fin M ↦
      distanceToInteger (q * (a : ℝ) / M) ≤ delta).card ≤
      q * (2 * (Nat.floor (delta * M) + 1)) := by
  let B : Fin M → Prop := fun r ↦
    distanceToInteger ((r : ℝ) / M) ≤ delta
  have hfiber := card_filter_modularMultiply_le M q hM hq B
  have hboundary := card_cyclicBoundary_le M hM delta hdelta
  calc
    (Finset.univ.filter fun a : Fin M ↦
        distanceToInteger (q * (a : ℝ) / M) ≤ delta).card =
        (Finset.univ.filter fun a : Fin M ↦
          B (modularMultiply M q hM a)).card := by
      apply congrArg Finset.card
      ext a
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      rw [distanceToInteger_mul_div_eq_modularMultiply]
    _ ≤ q * (Finset.univ.filter B).card := hfiber
    _ ≤ q * (2 * (Nat.floor (delta * M) + 1)) :=
      Nat.mul_le_mul_left q hboundary

noncomputable def smoothBadLocalSites (n : ℕ) (K : ℝ) :
    Finset (Fin (localMeshSize n)) :=
  Finset.univ.filter fun a ↦
    ¬IsSmooth n K (localMeshPoint n a)

lemma card_smoothBadLocalSites_le
    (n : ℕ) (hn : 0 < n) (K : ℝ) (hK : 0 ≤ K) :
    (smoothBadLocalSites n K).card ≤
      (Nat.floor K + 1) *
        ((2 * (Nat.floor K + 1)) *
          (2 * (Nat.floor ((K / n) * localMeshSize n) + 1))) := by
  classical
  let P : ℕ := Nat.floor K + 1
  let delta : ℝ := K / n
  let badAt : ℕ → Finset (Fin (localMeshSize n)) := fun p ↦
    Finset.univ.filter fun a ↦
      distanceToInteger (((2 * p : ℕ) : ℝ) * (a : ℝ) /
        localMeshSize n) ≤ delta
  have hsubset : smoothBadLocalSites n K ⊆
      (Finset.Icc 1 P).biUnion badAt := by
    intro a ha
    have ha' : ¬IsSmooth n K (localMeshPoint n a) := by
      simpa [smoothBadLocalSites] using ha
    rw [IsSmooth] at ha'
    push_neg at ha'
    rcases ha' with ⟨p, hp1, hpP, hpdist⟩
    have hpdist' :
        distanceToInteger
          (((2 * p : ℕ) : ℝ) * (a : ℝ) /
            localMeshSize n) ≤ delta := by
      push_cast
      rw [← distanceToInteger_localMeshPoint_smooth n hn p a]
      simpa [delta] using hpdist
    exact Finset.mem_biUnion.mpr ⟨p, by simpa [P] using ⟨hp1, hpP⟩,
      by simpa [badAt] using hpdist'⟩
  have hdelta : 0 ≤ delta := by dsimp [delta]; positivity
  have hbadAt : ∀ p ∈ Finset.Icc 1 P,
      (badAt p).card ≤
        (2 * P) * (2 * (Nat.floor (delta * localMeshSize n) + 1)) := by
    intro p hp
    have hp1 : 1 ≤ p := (Finset.mem_Icc.mp hp).1
    have hpP : p ≤ P := (Finset.mem_Icc.mp hp).2
    have hraw := card_modularDistance_le
      (localMeshSize n) (2 * p) (localMeshSize_pos n) (by omega)
      delta hdelta
    calc
      (badAt p).card ≤
          (2 * p) *
            (2 * (Nat.floor (delta * localMeshSize n) + 1)) := by
        simpa only [badAt] using hraw
      _ ≤ (2 * P) *
            (2 * (Nat.floor (delta * localMeshSize n) + 1)) := by
        exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 2 hpP)
  calc
    (smoothBadLocalSites n K).card ≤
        ((Finset.Icc 1 P).biUnion badAt).card :=
      Finset.card_le_card hsubset
    _ ≤ (Finset.Icc 1 P).card *
        ((2 * P) * (2 * (Nat.floor (delta * localMeshSize n) + 1))) :=
      Finset.card_biUnion_le_card_mul _ _ _ hbadAt
    _ = (Nat.floor K + 1) *
        ((2 * (Nat.floor K + 1)) *
          (2 * (Nat.floor ((K / n) * localMeshSize n) + 1))) := by
      rw [Nat.card_Icc]
      dsimp [P, delta]

lemma rigiditySmoothScale_cube_div_eq
    {n : ℕ} (hn : 0 < n) :
    rigiditySmoothScale n ^ 3 / n = rigidityPower n (-13 / 16) := by
  unfold rigiditySmoothScale
  rw [rigidityPower_nat_pow hn]
  have hnOne : (n : ℝ) = rigidityPower n 1 := by simp [rigidityPower]
  rw [hnOne]
  unfold rigidityPower rigiditySmoothExponent
  rw [← Real.rpow_sub (by exact_mod_cast hn : (0 : ℝ) < n)]
  congr 1
  ring

theorem smoothBadLocalSites_ratio_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      ((smoothBadLocalSites n (rigiditySmoothScale n)).card : ℝ) /
        localMeshSize n) atTop (𝓝 0) := by
  have hKtop : Tendsto rigiditySmoothScale atTop atTop := by
    unfold rigiditySmoothScale rigiditySmoothExponent
    exact tendsto_rigidityPower_atTop (by norm_num)
  have hKone : ∀ᶠ n : ℕ in atTop, 1 ≤ rigiditySmoothScale n :=
    hKtop.eventually (eventually_ge_atTop 1)
  have hupper : ∀ᶠ n : ℕ in atTop,
      ((smoothBadLocalSites n (rigiditySmoothScale n)).card : ℝ) /
          localMeshSize n ≤
        32 * rigidityPower n (-13 / 16) := by
    filter_upwards [Nat.eventually_pos, hKone] with n hn hKn
    let K : ℝ := rigiditySmoothScale n
    let P : ℕ := Nat.floor K + 1
    let M : ℕ := localMeshSize n
    let X : ℝ := (K / n) * M
    let D : ℕ := Nat.floor X + 1
    have hK0 : 0 ≤ K := by dsimp [K]; exact rigidityPower_nonneg _ _
    have hraw := card_smoothBadLocalSites_le n hn K hK0
    have hraw' : (smoothBadLocalSites n K).card ≤
        P * ((2 * P) * (2 * D)) := by
      simpa [P, D, X, M] using hraw
    have hrawR : ((smoothBadLocalSites n K).card : ℝ) ≤
        (P : ℝ) * ((2 * P : ℕ) * (2 * D : ℕ)) := by
      exact_mod_cast hraw'
    have hP : (P : ℝ) ≤ 2 * K := by
      have hfloor := Nat.floor_le hK0
      push_cast
      dsimp [P]
      push_cast
      linarith
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    have hMreal : (0 : ℝ) < M := by
      exact_mod_cast localMeshSize_pos n
    have hMge : (n : ℝ) ≤ M := by
      dsimp [M, localMeshSize]
      push_cast
      nlinarith [sq_nonneg (n : ℝ), show (1 : ℝ) ≤ n by exact_mod_cast hn]
    have hMn : (1 : ℝ) ≤ (M : ℝ) / n :=
      (le_div_iff₀ hnreal).2 (by simpa using hMge)
    have hXeq : X = K * ((M : ℝ) / n) := by dsimp [X]; ring
    have hXone : 1 ≤ X := by
      rw [hXeq]
      calc
        (1 : ℝ) = 1 * 1 := by ring
        _ ≤ K * ((M : ℝ) / n) := mul_le_mul hKn hMn (by norm_num) hK0
    have hD : (D : ℝ) ≤ 2 * X := by
      have hfloor := Nat.floor_le (by positivity : 0 ≤ X)
      push_cast
      dsimp [D]
      push_cast
      linarith
    have h2P : ((2 * P : ℕ) : ℝ) ≤ 4 * K := by
      push_cast
      linarith
    have h2D : ((2 * D : ℕ) : ℝ) ≤ 4 * X := by
      push_cast
      linarith
    have hcard : ((smoothBadLocalSites n K).card : ℝ) ≤
        32 * K ^ 2 * X := by
      calc
        ((smoothBadLocalSites n K).card : ℝ) ≤
            (P : ℝ) * ((2 * P : ℕ) * (2 * D : ℕ)) := hrawR
        _ ≤ (2 * K) * ((4 * K) * (4 * X)) := by
          apply mul_le_mul hP
          · exact mul_le_mul h2P h2D (by positivity) (by positivity)
          · positivity
          · positivity
        _ = 32 * K ^ 2 * X := by ring
    change ((smoothBadLocalSites n K).card : ℝ) / M ≤ _
    calc
      ((smoothBadLocalSites n K).card : ℝ) / M ≤
          (32 * K ^ 2 * X) / M :=
        div_le_div_of_nonneg_right hcard hMreal.le
      _ = 32 * K ^ 3 / n := by
        rw [hXeq]
        field_simp [hMreal.ne', hnreal.ne']
      _ = 32 * rigidityPower n (-13 / 16) := by
        dsimp [K]
        rw [show 32 * rigiditySmoothScale n ^ 3 / (n : ℝ) =
          32 * (rigiditySmoothScale n ^ 3 / n) by ring]
        rw [rigiditySmoothScale_cube_div_eq hn]
  apply squeeze_zero' (Eventually.of_forall fun n ↦ by positivity) hupper
  convert (tendsto_rigidityPower_neg_zero
    (show (0 : ℝ) < 13 / 16 by norm_num)).const_mul 32 using 1 <;> norm_num

noncomputable def modularSum
    (M : ℕ) (hM : 0 < M) (a b : Fin M) : Fin M := by
  letI : NeZero M := ⟨hM.ne'⟩
  exact (ZMod.finEquiv M).symm ((ZMod.finEquiv M a) + (ZMod.finEquiv M b))

noncomputable def modularDifference
    (M : ℕ) (hM : 0 < M) (a b : Fin M) : Fin M := by
  letI : NeZero M := ⟨hM.ne'⟩
  exact (ZMod.finEquiv M).symm ((ZMod.finEquiv M a) - (ZMod.finEquiv M b))

lemma modularSum_injective_right
    (M : ℕ) (hM : 0 < M) (a : Fin M) :
    Function.Injective (modularSum M hM a) := by
  letI : NeZero M := ⟨hM.ne'⟩
  intro b c hbc
  apply (ZMod.finEquiv M).injective
  apply add_left_cancel (a := ZMod.finEquiv M a)
  have h := congrArg (ZMod.finEquiv M) hbc
  simpa [modularSum] using h

lemma modularDifference_injective_right
    (M : ℕ) (hM : 0 < M) (a : Fin M) :
    Function.Injective (modularDifference M hM a) := by
  letI : NeZero M := ⟨hM.ne'⟩
  intro b c hbc
  apply (ZMod.finEquiv M).injective
  have h := congrArg (ZMod.finEquiv M) hbc
  have hsub : (ZMod.finEquiv M a) - (ZMod.finEquiv M b) =
      (ZMod.finEquiv M a) - (ZMod.finEquiv M c) := by
    simpa [modularDifference] using h
  exact sub_right_inj.mp hsub

lemma modularSum_val
    (M : ℕ) (hM : 0 < M) (a b : Fin M) :
    (modularSum M hM a b : ℕ) = ((a : ℕ) + (b : ℕ)) % M := by
  letI : NeZero M := ⟨hM.ne'⟩
  simpa [modularSum] using Fin.val_add a b

lemma modularDifference_val
    (M : ℕ) (hM : 0 < M) (a b : Fin M) :
    (modularDifference M hM a b : ℕ) =
      (M - (b : ℕ) + (a : ℕ)) % M := by
  letI : NeZero M := ⟨hM.ne'⟩
  simpa [modularDifference] using Fin.val_sub a b

lemma distanceToInteger_nat_div_eq_mod
    (M x : ℕ) (hM : 0 < M) :
    distanceToInteger ((x : ℝ) / M) =
      distanceToInteger (((x % M : ℕ) : ℝ) / M) := by
  let k : ℕ := x / M
  have hdecomp : x = M * k + x % M := by
    simpa [k] using (Nat.div_add_mod x M).symm
  have hdecompR : (x : ℝ) = (M : ℝ) * k + (x % M : ℕ) := by
    exact_mod_cast hdecomp
  have hMreal : (0 : ℝ) < M := by exact_mod_cast hM
  have heq : (x : ℝ) / M = ((x % M : ℕ) : ℝ) / M + ((k : ℤ) : ℝ) := by
    push_cast
    field_simp [hMreal.ne']
    nlinarith [hdecompR]
  rw [heq, distanceToInteger_add_int]

lemma distanceToInteger_add_div_eq_modularSum
    (M : ℕ) (hM : 0 < M) (a b : Fin M) :
    distanceToInteger (((a : ℝ) + (b : ℝ)) / M) =
      distanceToInteger ((modularSum M hM a b : ℕ) / (M : ℝ)) := by
  rw [modularSum_val]
  simpa only [Nat.cast_add] using
    distanceToInteger_nat_div_eq_mod M ((a : ℕ) + (b : ℕ)) hM

lemma distanceToInteger_sub_div_eq_modularDifference
    (M : ℕ) (hM : 0 < M) (a b : Fin M) :
    distanceToInteger (((a : ℝ) - (b : ℝ)) / M) =
      distanceToInteger ((modularDifference M hM a b : ℕ) / (M : ℝ)) := by
  let x : ℕ := M - (b : ℕ) + (a : ℕ)
  have hbM : (b : ℕ) ≤ M := b.isLt.le
  have hxreal : (x : ℝ) = (M : ℝ) - (b : ℝ) + (a : ℝ) := by
    dsimp [x]
    rw [Nat.cast_add, Nat.cast_sub hbM]
  have hMreal : (0 : ℝ) < M := by exact_mod_cast hM
  have heq : ((a : ℝ) - (b : ℝ)) / M = (x : ℝ) / M + ((-1 : ℤ) : ℝ) := by
    rw [hxreal]
    push_cast
    field_simp [hMreal.ne']
    ring
  rw [heq, distanceToInteger_add_int,
    distanceToInteger_nat_div_eq_mod M x hM, modularDifference_val]

lemma card_functions_coordinate_le
    (k M : ℕ) (r : Fin k) (B : Fin M → Prop) :
    (Finset.univ.filter fun a : Fin k → Fin M ↦ B (a r)).card ≤
      M ^ (k - 1) * (Finset.univ.filter B).card := by
  classical
  let f : {a : Fin k → Fin M // B (a r)} →
      ({i : Fin k // i ≠ r} → Fin M) × {b : Fin M // B b} := fun a ↦
    ((fun i ↦ a.1 i.1), ⟨a.1 r, a.2⟩)
  have hf : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    funext i
    by_cases hir : i = r
    · subst i
      exact congrArg (fun z ↦ z.2.1) hab
    · have hrest := congrArg (fun z ↦ z.1 ⟨i, hir⟩) hab
      exact hrest
  have hcompl : Fintype.card {i : Fin k // i ≠ r} = k - 1 := by
    rw [Fintype.card_subtype_compl (fun i : Fin k ↦ i = r)]
    simp
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_subtype, Fintype.card_prod,
    Fintype.card_fun, Fintype.card_fin, hcompl] using hcard

lemma card_functions_pairSum_le
    (k M : ℕ) (hM : 0 < M) (r s : Fin k) (hrs : r ≠ s)
    (B : Fin M → Prop) :
    (Finset.univ.filter fun a : Fin k → Fin M ↦
      B (modularSum M hM (a r) (a s))).card ≤
      M ^ (k - 1) * (Finset.univ.filter B).card := by
  classical
  let f : {a : Fin k → Fin M // B (modularSum M hM (a r) (a s))} →
      ({i : Fin k // i ≠ s} → Fin M) × {b : Fin M // B b} := fun a ↦
    ((fun i ↦ a.1 i.1),
      ⟨modularSum M hM (a.1 r) (a.1 s), a.2⟩)
  have hf : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    funext i
    by_cases his : i = s
    · subst i
      have hr : a.1 r = b.1 r :=
        congrArg (fun z ↦ z.1 ⟨r, hrs⟩) hab
      have hsum : modularSum M hM (a.1 r) (a.1 s) =
          modularSum M hM (b.1 r) (b.1 s) :=
        congrArg (fun z ↦ z.2.1) hab
      rw [hr] at hsum
      exact modularSum_injective_right M hM (b.1 r) hsum
    · exact congrArg (fun z ↦ z.1 ⟨i, his⟩) hab
  have hcompl : Fintype.card {i : Fin k // i ≠ s} = k - 1 := by
    rw [Fintype.card_subtype_compl (fun i : Fin k ↦ i = s)]
    simp
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_subtype, Fintype.card_prod,
    Fintype.card_fun, Fintype.card_fin, hcompl] using hcard

lemma card_functions_pairDifference_le
    (k M : ℕ) (hM : 0 < M) (r s : Fin k) (hrs : r ≠ s)
    (B : Fin M → Prop) :
    (Finset.univ.filter fun a : Fin k → Fin M ↦
      B (modularDifference M hM (a r) (a s))).card ≤
      M ^ (k - 1) * (Finset.univ.filter B).card := by
  classical
  let f : {a : Fin k → Fin M //
      B (modularDifference M hM (a r) (a s))} →
      ({i : Fin k // i ≠ s} → Fin M) × {b : Fin M // B b} := fun a ↦
    ((fun i ↦ a.1 i.1),
      ⟨modularDifference M hM (a.1 r) (a.1 s), a.2⟩)
  have hf : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    funext i
    by_cases his : i = s
    · subst i
      have hr : a.1 r = b.1 r :=
        congrArg (fun z ↦ z.1 ⟨r, hrs⟩) hab
      have hdiff : modularDifference M hM (a.1 r) (a.1 s) =
          modularDifference M hM (b.1 r) (b.1 s) :=
        congrArg (fun z ↦ z.2.1) hab
      rw [hr] at hdiff
      exact modularDifference_injective_right M hM (b.1 r) hdiff
    · exact congrArg (fun z ↦ z.1 ⟨i, his⟩) hab
  have hcompl : Fintype.card {i : Fin k // i ≠ s} = k - 1 := by
    rw [Fintype.card_subtype_compl (fun i : Fin k ↦ i = s)]
    simp
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_subtype, Fintype.card_prod,
    Fintype.card_fun, Fintype.card_fin, hcompl] using hcard

lemma distanceToInteger_two_mul_singletonIndex_le
    (M : ℕ) (hM : 0 < M) (a : Fin M) :
    distanceToInteger (2 * (a : ℝ) / M) ≤
      2 * distanceToInteger ((a : ℝ) / M - 1 / 2) := by
  let x : ℝ := (a : ℝ) / M - 1 / 2
  have h := distanceToInteger_nsmul_le 2 x
  norm_num at h
  have heq : 2 * x = 2 * (a : ℝ) / M + ((-1 : ℤ) : ℝ) := by
    dsimp [x]
    push_cast
    ring
  rw [heq, distanceToInteger_add_int] at h
  simpa [x] using h

lemma card_singletonSpreadBadSites_le
    (n : ℕ) (hn : 0 < n) (delta : ℝ) (hdelta : 0 ≤ delta) :
    (Finset.univ.filter fun a : Fin (localMeshSize n) ↦
      distanceToInteger
        (localMeshPoint n a / (2 * Real.pi * n)) < delta).card ≤
      2 * (2 * (Nat.floor ((2 * delta) * localMeshSize n) + 1)) := by
  let target : Finset (Fin (localMeshSize n)) :=
    Finset.univ.filter fun a ↦
      distanceToInteger (((2 : ℕ) : ℝ) * (a : ℝ) /
        localMeshSize n) ≤ 2 * delta
  have hsubset : (Finset.univ.filter fun a : Fin (localMeshSize n) ↦
      distanceToInteger
        (localMeshPoint n a / (2 * Real.pi * n)) < delta) ⊆ target := by
    intro a ha
    have ha' : distanceToInteger ((a : ℝ) / localMeshSize n - 1 / 2) <
        delta := by
      simpa [localMeshPoint_singleton_argument n hn a] using ha
    have hle := distanceToInteger_two_mul_singletonIndex_le
      (localMeshSize n) (localMeshSize_pos n) a
    have hlt : distanceToInteger (((2 : ℕ) : ℝ) * (a : ℝ) /
        localMeshSize n) <
        2 * delta := hle.trans_lt (mul_lt_mul_of_pos_left ha' (by norm_num))
    simpa [target] using hlt.le
  calc
    (Finset.univ.filter fun a : Fin (localMeshSize n) ↦
        distanceToInteger
          (localMeshPoint n a / (2 * Real.pi * n)) < delta).card ≤
        target.card := Finset.card_le_card hsubset
    _ ≤ 2 * (2 * (Nat.floor ((2 * delta) * localMeshSize n) + 1)) := by
      simpa only [target] using card_modularDistance_le
        (localMeshSize n) 2 (localMeshSize_pos n) (by norm_num)
        (2 * delta) (by positivity)

noncomputable def localTuplePoints (n k : ℕ)
    (a : Fin k → Fin (localMeshSize n)) : Fin k → ℝ :=
  fun r ↦ localMeshPoint n (a r)

def IsGoodLocalTuple (n k : ℕ)
    (a : Fin k → Fin (localMeshSize n)) : Prop :=
  (∀ r, IsSmooth n (rigiditySmoothScale n) (localMeshPoint n (a r))) ∧
  IsSpread n (rigiditySmoothScale n) (localTuplePoints n k a)

noncomputable def badLocalTuples (n k : ℕ) :
    Finset (Fin k → Fin (localMeshSize n)) :=
  Finset.univ.filter fun a ↦ ¬IsGoodLocalTuple n k a

noncomputable def cyclicBoundarySites (M : ℕ) (delta : ℝ) : Finset (Fin M) :=
  Finset.univ.filter fun r ↦ distanceToInteger ((r : ℝ) / M) ≤ delta

noncomputable def singletonSpreadBadSites (n : ℕ) (delta : ℝ) :
    Finset (Fin (localMeshSize n)) :=
  Finset.univ.filter fun a ↦
    distanceToInteger
      (localMeshPoint n a / (2 * Real.pi * n)) < delta

lemma card_cyclicBoundarySites_le
    (M : ℕ) (hM : 0 < M) (delta : ℝ) (hdelta : 0 ≤ delta) :
    (cyclicBoundarySites M delta).card ≤
      2 * (Nat.floor (delta * M) + 1) := by
  simpa only [cyclicBoundarySites] using card_cyclicBoundary_le M hM delta hdelta

lemma card_singletonSpreadBadSites_le'
    (n : ℕ) (hn : 0 < n) (delta : ℝ) (hdelta : 0 ≤ delta) :
    (singletonSpreadBadSites n delta).card ≤
      2 * (2 * (Nat.floor ((2 * delta) * localMeshSize n) + 1)) := by
  simpa only [singletonSpreadBadSites] using
    card_singletonSpreadBadSites_le n hn delta hdelta

lemma card_badLocalTuples_le
    (n k : ℕ) (hn : 0 < n) :
    (badLocalTuples n k).card ≤
      k * (localMeshSize n ^ (k - 1) *
        (smoothBadLocalSites n (rigiditySmoothScale n)).card) +
      k * (localMeshSize n ^ (k - 1) *
        (singletonSpreadBadSites n
          (rigiditySmoothScale n / n)).card) +
      2 * (k ^ 2 * (localMeshSize n ^ (k - 1) *
        (cyclicBoundarySites (localMeshSize n)
          (rigiditySmoothScale n / n)).card)) := by
  classical
  let M : ℕ := localMeshSize n
  let delta : ℝ := rigiditySmoothScale n / n
  let smoothFamily : Fin k → Finset (Fin k → Fin M) := fun r ↦
    Finset.univ.filter fun a ↦
      ¬IsSmooth n (rigiditySmoothScale n) (localMeshPoint n (a r))
  let singletonFamily : Fin k → Finset (Fin k → Fin M) := fun r ↦
    Finset.univ.filter fun a ↦ a r ∈ singletonSpreadBadSites n delta
  let pairIndices : Finset (Fin k × Fin k) :=
    Finset.univ.filter fun p ↦ p.1 ≠ p.2
  let differenceFamily : Fin k × Fin k → Finset (Fin k → Fin M) := fun p ↦
    Finset.univ.filter fun a ↦
      modularDifference M (localMeshSize_pos n) (a p.1) (a p.2) ∈
        cyclicBoundarySites M delta
  let sumFamily : Fin k × Fin k → Finset (Fin k → Fin M) := fun p ↦
    Finset.univ.filter fun a ↦
      modularSum M (localMeshSize_pos n) (a p.1) (a p.2) ∈
        cyclicBoundarySites M delta
  let smoothUnion := Finset.univ.biUnion smoothFamily
  let singletonUnion := Finset.univ.biUnion singletonFamily
  let differenceUnion := pairIndices.biUnion differenceFamily
  let sumUnion := pairIndices.biUnion sumFamily
  have hsubset : badLocalTuples n k ⊆
      ((smoothUnion ∪ singletonUnion) ∪ differenceUnion) ∪ sumUnion := by
    intro a ha
    have hbad : ¬IsGoodLocalTuple n k a := by
      simpa [badLocalTuples] using ha
    rw [IsGoodLocalTuple, not_and_or] at hbad
    rcases hbad with hsmooth | hspread
    · push Not at hsmooth
      rcases hsmooth with ⟨r, hr⟩
      apply Finset.mem_union_left
      apply Finset.mem_union_left
      apply Finset.mem_union_left
      exact Finset.mem_biUnion.mpr ⟨r, Finset.mem_univ r,
        by simpa [smoothFamily] using hr⟩
    · unfold IsSpread at hspread
      rw [not_and_or] at hspread
      rcases hspread with hsingle | hpairs
      · push Not at hsingle
        rcases hsingle with ⟨hkone, r, hr⟩
        apply Finset.mem_union_left
        apply Finset.mem_union_left
        apply Finset.mem_union_right
        apply Finset.mem_biUnion.mpr
        refine ⟨r, Finset.mem_univ r, ?_⟩
        have hr' : distanceToInteger
            (localMeshPoint n (a r) / (2 * Real.pi * n)) < delta := by
          simpa [localTuplePoints, delta] using hr
        simpa [singletonFamily, singletonSpreadBadSites] using hr'
      · push Not at hpairs
        rcases hpairs with ⟨r, s, hrs, hpairs⟩
        have hpmem : (r, s) ∈ pairIndices := by
          simpa [pairIndices] using hrs
        by_cases hdiffBound : delta ≤ distanceToInteger
            ((localTuplePoints n k a r - localTuplePoints n k a s) /
              (2 * Real.pi * n))
        · have hsum := hpairs hdiffBound
          have hsum' : distanceToInteger
              ((localMeshPoint n (a r) + localMeshPoint n (a s)) /
                (2 * Real.pi * n)) < delta := by
            simpa [localTuplePoints, delta] using hsum
          have hboundary : modularSum M (localMeshSize_pos n)
              (a r) (a s) ∈ cyclicBoundarySites M delta := by
            simp only [cyclicBoundarySites, Finset.mem_filter, Finset.mem_univ,
              true_and]
            rw [← distanceToInteger_add_div_eq_modularSum]
            rw [← distanceToInteger_localMeshPoint_add n hn]
            exact hsum'.le
          apply Finset.mem_union_right
          exact Finset.mem_biUnion.mpr ⟨(r, s), hpmem,
            by simpa [sumFamily] using hboundary⟩
        · have hdiff : distanceToInteger
              ((localTuplePoints n k a r - localTuplePoints n k a s) /
                (2 * Real.pi * n)) < delta := lt_of_not_ge hdiffBound
          have hdiff' : distanceToInteger
              ((localMeshPoint n (a r) - localMeshPoint n (a s)) /
                (2 * Real.pi * n)) < delta := by
            simpa [localTuplePoints, delta] using hdiff
          have hboundary : modularDifference M (localMeshSize_pos n)
              (a r) (a s) ∈ cyclicBoundarySites M delta := by
            simp only [cyclicBoundarySites, Finset.mem_filter, Finset.mem_univ,
              true_and]
            rw [← distanceToInteger_sub_div_eq_modularDifference]
            rw [← localMeshPoint_sub_argument n hn]
            exact hdiff'.le
          apply Finset.mem_union_left
          apply Finset.mem_union_right
          exact Finset.mem_biUnion.mpr ⟨(r, s), hpmem,
            by simpa [differenceFamily] using hboundary⟩
  have hsmoothFamily : ∀ r ∈ (Finset.univ : Finset (Fin k)),
      (smoothFamily r).card ≤ M ^ (k - 1) *
        (smoothBadLocalSites n (rigiditySmoothScale n)).card := by
    intro r _hr
    let bad := smoothBadLocalSites n (rigiditySmoothScale n)
    have h := card_functions_coordinate_le k M r (fun b ↦ b ∈ bad)
    have hfilter : (Finset.univ.filter fun b : Fin M ↦ b ∈ bad) = bad := by
      ext b
      simp
    have hleft : smoothFamily r =
        Finset.univ.filter (fun a : Fin k → Fin M ↦ a r ∈ bad) := by
      ext a
      simp [smoothFamily, bad, smoothBadLocalSites]
    calc
      (smoothFamily r).card =
          (Finset.univ.filter (fun a : Fin k → Fin M ↦ a r ∈ bad)).card :=
        congrArg Finset.card hleft
      _ ≤ M ^ (k - 1) *
          (Finset.univ.filter fun b : Fin M ↦ b ∈ bad).card := by
        convert h using 1
        · apply congrArg Finset.card
          ext x
          simp
        · apply congrArg (fun q : ℕ ↦ M ^ (k - 1) * q)
          apply congrArg Finset.card
          ext x
          simp
      _ = M ^ (k - 1) * bad.card := by rw [hfilter]
  have hsingleFamily : ∀ r ∈ (Finset.univ : Finset (Fin k)),
      (singletonFamily r).card ≤ M ^ (k - 1) *
        (singletonSpreadBadSites n delta).card := by
    intro r _hr
    let bad := singletonSpreadBadSites n delta
    have h := card_functions_coordinate_le k M r (fun b ↦ b ∈ bad)
    have hfilter : (Finset.univ.filter fun b : Fin M ↦ b ∈ bad) = bad := by
      ext b
      simp
    have hleft : singletonFamily r =
        Finset.univ.filter (fun a : Fin k → Fin M ↦ a r ∈ bad) := by
      ext a
      simp [singletonFamily, bad]
    calc
      (singletonFamily r).card =
          (Finset.univ.filter (fun a : Fin k → Fin M ↦ a r ∈ bad)).card :=
        congrArg Finset.card hleft
      _ ≤ M ^ (k - 1) *
          (Finset.univ.filter fun b : Fin M ↦ b ∈ bad).card := by
        convert h using 1
        · apply congrArg Finset.card
          ext x
          simp
        · apply congrArg (fun q : ℕ ↦ M ^ (k - 1) * q)
          apply congrArg Finset.card
          ext x
          simp
      _ = M ^ (k - 1) * bad.card := by rw [hfilter]
  have hdiffFamily : ∀ p ∈ pairIndices,
      (differenceFamily p).card ≤ M ^ (k - 1) *
        (cyclicBoundarySites M delta).card := by
    intro p hp
    have hpne : p.1 ≠ p.2 := by simpa [pairIndices] using hp
    let bad := cyclicBoundarySites M delta
    have h := card_functions_pairDifference_le k M (localMeshSize_pos n)
      p.1 p.2 hpne (fun b ↦ b ∈ bad)
    have hfilter : (Finset.univ.filter fun b : Fin M ↦ b ∈ bad) = bad := by
      ext b
      simp
    have hleft : differenceFamily p =
        Finset.univ.filter (fun a : Fin k → Fin M ↦
          modularDifference M (localMeshSize_pos n) (a p.1) (a p.2) ∈ bad) := by
      ext a
      simp [differenceFamily, bad]
    calc
      (differenceFamily p).card =
          (Finset.univ.filter (fun a : Fin k → Fin M ↦
            modularDifference M (localMeshSize_pos n) (a p.1) (a p.2) ∈ bad)).card :=
        congrArg Finset.card hleft
      _ ≤ M ^ (k - 1) *
          (Finset.univ.filter fun b : Fin M ↦ b ∈ bad).card := by
        convert h using 1
        · apply congrArg Finset.card
          ext x
          simp
        · apply congrArg (fun q : ℕ ↦ M ^ (k - 1) * q)
          apply congrArg Finset.card
          ext x
          simp
      _ = M ^ (k - 1) * bad.card := by rw [hfilter]
  have hsumFamily : ∀ p ∈ pairIndices,
      (sumFamily p).card ≤ M ^ (k - 1) *
        (cyclicBoundarySites M delta).card := by
    intro p hp
    have hpne : p.1 ≠ p.2 := by simpa [pairIndices] using hp
    let bad := cyclicBoundarySites M delta
    have h := card_functions_pairSum_le k M (localMeshSize_pos n)
      p.1 p.2 hpne (fun b ↦ b ∈ bad)
    have hfilter : (Finset.univ.filter fun b : Fin M ↦ b ∈ bad) = bad := by
      ext b
      simp
    have hleft : sumFamily p =
        Finset.univ.filter (fun a : Fin k → Fin M ↦
          modularSum M (localMeshSize_pos n) (a p.1) (a p.2) ∈ bad) := by
      ext a
      simp [sumFamily, bad]
    calc
      (sumFamily p).card =
          (Finset.univ.filter (fun a : Fin k → Fin M ↦
            modularSum M (localMeshSize_pos n) (a p.1) (a p.2) ∈ bad)).card :=
        congrArg Finset.card hleft
      _ ≤ M ^ (k - 1) *
          (Finset.univ.filter fun b : Fin M ↦ b ∈ bad).card := by
        convert h using 1
        · apply congrArg Finset.card
          ext x
          simp
        · apply congrArg (fun q : ℕ ↦ M ^ (k - 1) * q)
          apply congrArg Finset.card
          ext x
          simp
      _ = M ^ (k - 1) * bad.card := by rw [hfilter]
  have hpairCard : pairIndices.card ≤ k ^ 2 := by
    calc
      pairIndices.card ≤ (Finset.univ : Finset (Fin k × Fin k)).card :=
        Finset.card_filter_le _ _
      _ = k ^ 2 := by simp [pow_two]
  have hsmoothUnion : smoothUnion.card ≤
      k * (M ^ (k - 1) *
        (smoothBadLocalSites n (rigiditySmoothScale n)).card) := by
    simpa only [smoothUnion, Finset.card_univ, Fintype.card_fin] using
      Finset.card_biUnion_le_card_mul Finset.univ smoothFamily _ hsmoothFamily
  have hsingleUnion : singletonUnion.card ≤
      k * (M ^ (k - 1) * (singletonSpreadBadSites n delta).card) := by
    simpa only [singletonUnion, Finset.card_univ, Fintype.card_fin] using
      Finset.card_biUnion_le_card_mul Finset.univ singletonFamily _ hsingleFamily
  have hdiffUnion : differenceUnion.card ≤
      k ^ 2 * (M ^ (k - 1) * (cyclicBoundarySites M delta).card) := by
    calc
      differenceUnion.card ≤ pairIndices.card *
          (M ^ (k - 1) * (cyclicBoundarySites M delta).card) := by
        simpa only [differenceUnion] using
          Finset.card_biUnion_le_card_mul pairIndices differenceFamily _ hdiffFamily
      _ ≤ k ^ 2 * (M ^ (k - 1) * (cyclicBoundarySites M delta).card) :=
        Nat.mul_le_mul_right _ hpairCard
  have hsumUnion : sumUnion.card ≤
      k ^ 2 * (M ^ (k - 1) * (cyclicBoundarySites M delta).card) := by
    calc
      sumUnion.card ≤ pairIndices.card *
          (M ^ (k - 1) * (cyclicBoundarySites M delta).card) := by
        simpa only [sumUnion] using
          Finset.card_biUnion_le_card_mul pairIndices sumFamily _ hsumFamily
      _ ≤ k ^ 2 * (M ^ (k - 1) * (cyclicBoundarySites M delta).card) :=
        Nat.mul_le_mul_right _ hpairCard
  calc
    (badLocalTuples n k).card ≤
        (((smoothUnion ∪ singletonUnion) ∪ differenceUnion) ∪ sumUnion).card :=
      Finset.card_le_card hsubset
    _ ≤ smoothUnion.card + singletonUnion.card +
          differenceUnion.card + sumUnion.card := by
      have h₁ := Finset.card_union_le smoothUnion singletonUnion
      have h₂ := Finset.card_union_le (smoothUnion ∪ singletonUnion) differenceUnion
      have h₃ := Finset.card_union_le
        ((smoothUnion ∪ singletonUnion) ∪ differenceUnion) sumUnion
      omega
    _ ≤ k * (M ^ (k - 1) *
          (smoothBadLocalSites n (rigiditySmoothScale n)).card) +
        k * (M ^ (k - 1) * (singletonSpreadBadSites n delta).card) +
        2 * (k ^ 2 * (M ^ (k - 1) *
          (cyclicBoundarySites M delta).card)) := by
      omega
    _ = k * (localMeshSize n ^ (k - 1) *
          (smoothBadLocalSites n (rigiditySmoothScale n)).card) +
        k * (localMeshSize n ^ (k - 1) *
          (singletonSpreadBadSites n
            (rigiditySmoothScale n / n)).card) +
        2 * (k ^ 2 * (localMeshSize n ^ (k - 1) *
          (cyclicBoundarySites (localMeshSize n)
            (rigiditySmoothScale n / n)).card)) := by rfl

lemma rigiditySmoothScale_div_tendsto_zero :
    Tendsto (fun n : ℕ ↦ rigiditySmoothScale n / n) atTop (𝓝 0) := by
  apply (tendsto_rigidityPower_neg_zero
    (show (0 : ℝ) < 15 / 16 by norm_num)).congr'
  filter_upwards [Nat.eventually_pos] with n hn
  rw [rigiditySmoothScale_div_eq_power hn]
  congr 1
  unfold rigiditySmoothExponent
  ring

theorem cyclicBoundarySites_ratio_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      ((cyclicBoundarySites (localMeshSize n)
        (rigiditySmoothScale n / n)).card : ℝ) / localMeshSize n)
      atTop (𝓝 0) := by
  have hKtop : Tendsto rigiditySmoothScale atTop atTop := by
    unfold rigiditySmoothScale rigiditySmoothExponent
    exact tendsto_rigidityPower_atTop (by norm_num)
  have hKone : ∀ᶠ n : ℕ in atTop, 1 ≤ rigiditySmoothScale n :=
    hKtop.eventually (eventually_ge_atTop 1)
  have hupper : ∀ᶠ n : ℕ in atTop,
      ((cyclicBoundarySites (localMeshSize n)
        (rigiditySmoothScale n / n)).card : ℝ) / localMeshSize n ≤
          4 * (rigiditySmoothScale n / n) := by
    filter_upwards [Nat.eventually_pos, hKone] with n hn hKn
    let M : ℕ := localMeshSize n
    let delta : ℝ := rigiditySmoothScale n / n
    let X : ℝ := delta * M
    let D : ℕ := Nat.floor X + 1
    have hdelta : 0 ≤ delta := by dsimp [delta]; positivity
    have hraw := card_cyclicBoundarySites_le M (localMeshSize_pos n) delta hdelta
    have hrawR : ((cyclicBoundarySites M delta).card : ℝ) ≤ 2 * D := by
      exact_mod_cast hraw
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    have hMreal : (0 : ℝ) < M := by exact_mod_cast localMeshSize_pos n
    have hMge : (n : ℝ) ≤ M := by
      dsimp [M, localMeshSize]
      push_cast
      nlinarith [sq_nonneg (n : ℝ), show (1 : ℝ) ≤ n by exact_mod_cast hn]
    have hMn : (1 : ℝ) ≤ (M : ℝ) / n :=
      (le_div_iff₀ hnreal).2 (by simpa using hMge)
    have hXeq : X = rigiditySmoothScale n * ((M : ℝ) / n) := by
      dsimp [X, delta]
      ring
    have hXone : 1 ≤ X := by
      rw [hXeq]
      simpa only [one_mul] using
        (mul_le_mul hKn hMn (by norm_num) (by positivity))
    have hD : (D : ℝ) ≤ 2 * X := by
      have hfloor := Nat.floor_le (by positivity : 0 ≤ X)
      push_cast
      dsimp [D]
      push_cast
      linarith
    have hcard : ((cyclicBoundarySites M delta).card : ℝ) ≤ 4 * X := by
      calc
        _ ≤ 2 * (D : ℝ) := hrawR
        _ ≤ 2 * (2 * X) := by gcongr
        _ = 4 * X := by ring
    change ((cyclicBoundarySites M delta).card : ℝ) / M ≤ 4 * delta
    calc
      _ ≤ (4 * X) / M := div_le_div_of_nonneg_right hcard hMreal.le
      _ = 4 * delta := by
        dsimp [X]
        field_simp [hMreal.ne']
  apply squeeze_zero' (Eventually.of_forall fun n ↦ by positivity) hupper
  simpa using rigiditySmoothScale_div_tendsto_zero.const_mul 4

theorem singletonSpreadBadSites_ratio_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      ((singletonSpreadBadSites n
        (rigiditySmoothScale n / n)).card : ℝ) / localMeshSize n)
      atTop (𝓝 0) := by
  have hKtop : Tendsto rigiditySmoothScale atTop atTop := by
    unfold rigiditySmoothScale rigiditySmoothExponent
    exact tendsto_rigidityPower_atTop (by norm_num)
  have hKone : ∀ᶠ n : ℕ in atTop, 1 ≤ rigiditySmoothScale n :=
    hKtop.eventually (eventually_ge_atTop 1)
  have hupper : ∀ᶠ n : ℕ in atTop,
      ((singletonSpreadBadSites n
        (rigiditySmoothScale n / n)).card : ℝ) / localMeshSize n ≤
          16 * (rigiditySmoothScale n / n) := by
    filter_upwards [Nat.eventually_pos, hKone] with n hn hKn
    let M : ℕ := localMeshSize n
    let delta : ℝ := rigiditySmoothScale n / n
    let X : ℝ := (2 * delta) * M
    let D : ℕ := Nat.floor X + 1
    have hdelta : 0 ≤ delta := by dsimp [delta]; positivity
    have hraw := card_singletonSpreadBadSites_le' n hn delta hdelta
    have hraw' : (singletonSpreadBadSites n delta).card ≤ 4 * D := by
      dsimp [D, X, M]
      omega
    have hrawR : ((singletonSpreadBadSites n delta).card : ℝ) ≤ 4 * D := by
      exact_mod_cast hraw'
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    have hMreal : (0 : ℝ) < M := by exact_mod_cast localMeshSize_pos n
    have hMge : (n : ℝ) ≤ M := by
      dsimp [M, localMeshSize]
      push_cast
      nlinarith [sq_nonneg (n : ℝ), show (1 : ℝ) ≤ n by exact_mod_cast hn]
    have hMn : (1 : ℝ) ≤ (M : ℝ) / n :=
      (le_div_iff₀ hnreal).2 (by simpa using hMge)
    have hXeq : X = 2 * rigiditySmoothScale n * ((M : ℝ) / n) := by
      dsimp [X, delta]
      ring
    have hXone : 1 ≤ X := by
      rw [hXeq]
      have hprod : 1 ≤ rigiditySmoothScale n * ((M : ℝ) / n) :=
        by simpa only [one_mul] using
          (mul_le_mul hKn hMn (by norm_num) (by positivity))
      nlinarith
    have hD : (D : ℝ) ≤ 2 * X := by
      have hfloor := Nat.floor_le (by positivity : 0 ≤ X)
      push_cast
      dsimp [D]
      push_cast
      linarith
    have hcard : ((singletonSpreadBadSites n delta).card : ℝ) ≤ 8 * X := by
      calc
        _ ≤ 4 * (D : ℝ) := hrawR
        _ ≤ 4 * (2 * X) := by gcongr
        _ = 8 * X := by ring
    change ((singletonSpreadBadSites n delta).card : ℝ) / M ≤ 16 * delta
    calc
      _ ≤ (8 * X) / M := div_le_div_of_nonneg_right hcard hMreal.le
      _ = 16 * delta := by
        dsimp [X]
        field_simp [hMreal.ne']
        ring
  apply squeeze_zero' (Eventually.of_forall fun n ↦ by positivity) hupper
  simpa using rigiditySmoothScale_div_tendsto_zero.const_mul 16

lemma pow_pred_mul_div_pow_eq_div
    (M k : ℕ) (hM : 0 < M) (hk : 0 < k) (A : ℝ) :
    (M : ℝ) ^ (k - 1) * A / (M : ℝ) ^ k = A / M := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
  have hMreal : (M : ℝ) ≠ 0 := by exact_mod_cast hM.ne'
  simp only [Nat.succ_sub_one, pow_succ]
  field_simp

lemma pow_pred_mul_div_pow_eq_div_assoc
    (M k : ℕ) (hM : 0 < M) (hk : 0 < k) (A : ℝ) :
    (M : ℝ) ^ (k - 1) * (A / (M : ℝ) ^ k) = A / M := by
  rw [← mul_div_assoc]
  exact pow_pred_mul_div_pow_eq_div M k hM hk A

theorem badLocalTuples_ratio_tendsto_zero
    (k : ℕ) (hk : 0 < k) :
    Tendsto (fun n : ℕ ↦
      ((badLocalTuples n k).card : ℝ) / (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 0) := by
  let upper : ℕ → ℝ := fun n ↦
    k * (((smoothBadLocalSites n (rigiditySmoothScale n)).card : ℝ) /
      localMeshSize n) +
    k * (((singletonSpreadBadSites n
      (rigiditySmoothScale n / n)).card : ℝ) / localMeshSize n) +
    2 * k ^ 2 * (((cyclicBoundarySites (localMeshSize n)
      (rigiditySmoothScale n / n)).card : ℝ) / localMeshSize n)
  have hupperZero : Tendsto upper atTop (𝓝 0) := by
    have h₁ := smoothBadLocalSites_ratio_tendsto_zero.const_mul (k : ℝ)
    have h₂ := singletonSpreadBadSites_ratio_tendsto_zero.const_mul (k : ℝ)
    have h₃ := cyclicBoundarySites_ratio_tendsto_zero.const_mul
      (2 * (k : ℝ) ^ 2)
    simpa only [upper, mul_zero, zero_add] using (h₁.add h₂).add h₃
  have hbound : ∀ᶠ n : ℕ in atTop,
      ((badLocalTuples n k).card : ℝ) / (localMeshSize n : ℝ) ^ k ≤
        upper n := by
    filter_upwards [Nat.eventually_pos] with n hn
    have hraw := card_badLocalTuples_le n k hn
    have hrawR : ((badLocalTuples n k).card : ℝ) ≤
        k * ((localMeshSize n : ℝ) ^ (k - 1) *
          (smoothBadLocalSites n (rigiditySmoothScale n)).card) +
        k * ((localMeshSize n : ℝ) ^ (k - 1) *
          (singletonSpreadBadSites n
            (rigiditySmoothScale n / n)).card) +
        2 * (k ^ 2 * ((localMeshSize n : ℝ) ^ (k - 1) *
          (cyclicBoundarySites (localMeshSize n)
            (rigiditySmoothScale n / n)).card)) := by
      exact_mod_cast hraw
    have hden : 0 ≤ (localMeshSize n : ℝ) ^ k := by positivity
    have hdiv := div_le_div_of_nonneg_right hrawR hden
    rw [add_div, add_div] at hdiv
    simp only [mul_div_assoc] at hdiv
    rw [pow_pred_mul_div_pow_eq_div_assoc (localMeshSize n) k
      (localMeshSize_pos n) hk] at hdiv
    rw [pow_pred_mul_div_pow_eq_div_assoc (localMeshSize n) k
      (localMeshSize_pos n) hk] at hdiv
    rw [pow_pred_mul_div_pow_eq_div_assoc (localMeshSize n) k
      (localMeshSize_pos n) hk] at hdiv
    dsimp only [upper]
    simpa only [mul_assoc] using hdiv
  apply squeeze_zero' (Eventually.of_forall fun n ↦ by positivity) hbound hupperZero

noncomputable def localSetTuple {n k : ℕ}
    (s : Finset (Fin (localMeshSize n))) (hcard : s.card = k) :
    Fin k → Fin (localMeshSize n) :=
  fun r ↦ localSite s (Fin.cast hcard.symm r)

lemma isGoodLocalTuple_localSetTuple
    {n k : ℕ} {s : Finset (Fin (localMeshSize n))}
    (hgood : IsGoodLocalSiteSet n s) (hcard : s.card = k) :
    IsGoodLocalTuple n k (localSetTuple s hcard) := by
  subst k
  constructor
  · intro r
    exact hgood.1 (localSite s r) (localSite_mem s r)
  · convert hgood.2 using 1
    funext r
    rfl

lemma isGoodLocalSiteSet_of_localSetTuple
    {n k : ℕ} {s : Finset (Fin (localMeshSize n))}
    (hcard : s.card = k)
    (hgood : IsGoodLocalTuple n k (localSetTuple s hcard)) :
    IsGoodLocalSiteSet n s := by
  subst k
  constructor
  · intro a ha
    rcases localSite_surjective s ha with ⟨r, hr⟩
    have hh := hgood.1 r
    simpa [localSetTuple, hr] using hh
  · convert hgood.2 using 1
    funext r
    rfl

noncomputable def badLocalSiteSets (n k : ℕ) :
    Finset (Finset (Fin (localMeshSize n))) :=
  (Finset.univ.powersetCard k).filter fun s ↦ ¬IsGoodLocalSiteSet n s

lemma badLocalSiteSets_subset_badLocalTuples_card
    (n k : ℕ) :
    (badLocalSiteSets n k).card ≤ (badLocalTuples n k).card := by
  classical
  let f : {s : Finset (Fin (localMeshSize n)) // s ∈ badLocalSiteSets n k} →
      {a : Fin k → Fin (localMeshSize n) // a ∈ badLocalTuples n k} := fun s ↦ by
    have hs : s.1 ∈ Finset.univ.powersetCard k := by
      exact (Finset.mem_filter.mp s.2).1
    have hcard : s.1.card = k := (Finset.mem_powersetCard.mp hs).2
    refine ⟨localSetTuple s.1 hcard, ?_⟩
    have hnotGood : ¬IsGoodLocalSiteSet n s.1 :=
      (Finset.mem_filter.mp s.2).2
    have hnotTuple : ¬IsGoodLocalTuple n k (localSetTuple s.1 hcard) := by
      intro hgood
      exact hnotGood (isGoodLocalSiteSet_of_localSetTuple hcard hgood)
    simpa [badLocalTuples] using hnotTuple
  have hf : Function.Injective f := by
    intro s t hst
    apply Subtype.ext
    apply Finset.ext
    intro a
    have hs : s.1 ∈ Finset.univ.powersetCard k :=
      (Finset.mem_filter.mp s.2).1
    have ht : t.1 ∈ Finset.univ.powersetCard k :=
      (Finset.mem_filter.mp t.2).1
    have hscard : s.1.card = k := (Finset.mem_powersetCard.mp hs).2
    have htcard : t.1.card = k := (Finset.mem_powersetCard.mp ht).2
    have hfun : localSetTuple s.1 hscard = localSetTuple t.1 htcard :=
      congrArg Subtype.val hst
    constructor
    · intro ha
      rcases localSite_surjective s.1 ha with ⟨r, hr⟩
      let r' : Fin k := Fin.cast hscard r
      have hvalue : localSetTuple s.1 hscard r' = a := by
        dsimp [localSetTuple, r']
        simpa [hr]
      have htvalue : localSetTuple t.1 htcard r' = a := by
        rw [← hfun]
        exact hvalue
      have hmem := localSite_mem t.1 (Fin.cast htcard.symm r')
      rw [← htvalue]
      exact hmem
    · intro ha
      rcases localSite_surjective t.1 ha with ⟨r, hr⟩
      let r' : Fin k := Fin.cast htcard r
      have hvalue : localSetTuple t.1 htcard r' = a := by
        dsimp [localSetTuple, r']
        simpa [hr]
      have hsvalue : localSetTuple s.1 hscard r' = a := by
        rw [hfun]
        exact hvalue
      have hmem := localSite_mem s.1 (Fin.cast hscard.symm r')
      rw [← hsvalue]
      exact hmem
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_coe] using hcard

theorem badLocalSiteSets_ratio_tendsto_zero
    (k : ℕ) (hk : 0 < k) :
    Tendsto (fun n : ℕ ↦
      ((badLocalSiteSets n k).card : ℝ) / (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 0) := by
  apply squeeze_zero' (Eventually.of_forall fun n ↦ by positivity)
  · exact Eventually.of_forall fun n ↦ by
      have hcardR : ((badLocalSiteSets n k).card : ℝ) ≤
          (badLocalTuples n k).card := by
        exact_mod_cast badLocalSiteSets_subset_badLocalTuples_card n k
      exact div_le_div_of_nonneg_right hcardR (by positivity)
  · exact badLocalTuples_ratio_tendsto_zero k hk

noncomputable def goodLocalSiteSets (n k : ℕ) :
    Finset (Finset (Fin (localMeshSize n))) :=
  (Finset.univ.powersetCard k).filter fun s ↦ IsGoodLocalSiteSet n s

noncomputable def halfGoodLocalSiteSets (n k : ℕ) :
    Finset (Finset (Fin (localMeshSize n))) :=
  ((halfLocalMeshSites n).powersetCard k).filter fun s ↦
    IsGoodLocalSiteSet n s

noncomputable def halfBadLocalSiteSets (n k : ℕ) :
    Finset (Finset (Fin (localMeshSize n))) :=
  ((halfLocalMeshSites n).powersetCard k).filter fun s ↦
    ¬IsGoodLocalSiteSet n s

noncomputable def halfNonspreadLocalSiteSets (n k : ℕ) :
    Finset (Finset (Fin (localMeshSize n))) :=
  ((halfSmoothLocalMeshSites n).powersetCard k).filter fun s ↦
    ¬IsSpread n (rigiditySmoothScale n) (localSitesPoints s)

lemma halfSmoothPowerset_eq_good_union_nonspread (n k : ℕ) :
    (halfSmoothLocalMeshSites n).powersetCard k =
      halfGoodLocalSiteSets n k ∪ halfNonspreadLocalSiteSets n k := by
  ext s
  rw [Finset.mem_union]
  constructor
  · intro hs
    have hpow := Finset.mem_powersetCard.mp hs
    rcases hpow with ⟨hsub, hcard⟩
    have hhalf : s ⊆ halfLocalMeshSites n := fun a ha ↦
      (Finset.mem_filter.mp (show a ∈ halfSmoothLocalMeshSites n from
        hsub ha)).1
    have hsmooth : ∀ a ∈ s,
        IsSmooth n (rigiditySmoothScale n) (localMeshPoint n a) :=
      fun a ha ↦ (Finset.mem_filter.mp
        (show a ∈ halfSmoothLocalMeshSites n from hsub ha)).2
    by_cases hspread : IsSpread n (rigiditySmoothScale n) (localSitesPoints s)
    · apply Or.inl
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_powersetCard.mpr ⟨hhalf, hcard⟩,
        ⟨hsmooth, hspread⟩⟩
    · apply Or.inr
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_powersetCard.mpr ⟨hsub, hcard⟩, hspread⟩
  · rintro (hgood | hbad)
    · have hg := Finset.mem_filter.mp hgood
      have hpow := Finset.mem_powersetCard.mp hg.1
      rcases hpow with ⟨hhalf, hcard⟩
      have hdata := hg.2
      apply Finset.mem_powersetCard.mpr
      refine ⟨?_, hcard⟩
      intro a ha
      exact Finset.mem_filter.mpr ⟨hhalf ha, hdata.1 a ha⟩
    · exact (Finset.mem_filter.mp hbad).1

lemma halfGoodLocalSiteSets_disjoint_halfNonspread (n k : ℕ) :
    Disjoint (halfGoodLocalSiteSets n k)
      (halfNonspreadLocalSiteSets n k) := by
  rw [Finset.disjoint_left]
  intro s hgood hbad
  have hspread : IsSpread n (rigiditySmoothScale n) (localSitesPoints s) :=
    (Finset.mem_filter.mp hgood).2.2
  have hnot : ¬IsSpread n (rigiditySmoothScale n) (localSitesPoints s) :=
    (Finset.mem_filter.mp hbad).2
  exact hnot hspread

lemma halfBadLocalSiteSets_subset_badLocalSiteSets (n k : ℕ) :
    halfBadLocalSiteSets n k ⊆ badLocalSiteSets n k := by
  intro s hs
  rw [halfBadLocalSiteSets, Finset.mem_filter] at hs
  rw [badLocalSiteSets, Finset.mem_filter]
  refine ⟨?_, hs.2⟩
  rw [Finset.mem_powersetCard] at hs ⊢
  exact ⟨Finset.subset_univ s, hs.1.2⟩

lemma halfBadLocalSiteSets_card_le (n k : ℕ) :
    (halfBadLocalSiteSets n k).card ≤ (badLocalSiteSets n k).card :=
  Finset.card_le_card (halfBadLocalSiteSets_subset_badLocalSiteSets n k)

lemma halfGoodLocalSiteSets_card_add_halfBadLocalSiteSets_card
    (n k : ℕ) :
    (halfGoodLocalSiteSets n k).card +
        (halfBadLocalSiteSets n k).card =
      (halfLocalMeshSize n).choose k := by
  classical
  rw [halfGoodLocalSiteSets, halfBadLocalSiteSets,
    Finset.card_filter_add_card_filter_not, Finset.card_powersetCard,
    card_halfLocalMeshSites]

lemma goodLocalSiteSets_card_add_badLocalSiteSets_card
    (n k : ℕ) :
    (goodLocalSiteSets n k).card + (badLocalSiteSets n k).card =
      (localMeshSize n).choose k := by
  classical
  rw [goodLocalSiteSets, badLocalSiteSets,
    Finset.card_filter_add_card_filter_not,
    Finset.card_powersetCard, Finset.card_univ, Fintype.card_fin]

lemma localMeshSize_tendsto_atTop :
    Tendsto localMeshSize atTop atTop := by
  rw [tendsto_atTop]
  intro b
  filter_upwards [eventually_ge_atTop b] with n hn
  have hnle : n ≤ n ^ 2 + 1 := by nlinarith [Nat.zero_le n]
  exact hn.trans hnle

lemma halfLocalMeshSize_ratio_tendsto_half :
    Tendsto (fun n : ℕ ↦
      (halfLocalMeshSize n : ℝ) / (localMeshSize n : ℝ))
      atTop (𝓝 (1 / 2 : ℝ)) := by
  have hmeshR : Tendsto (fun n : ℕ ↦ (localMeshSize n : ℝ))
      atTop atTop := tendsto_natCast_atTop_iff.mpr localMeshSize_tendsto_atTop
  have hinv : Tendsto (fun n : ℕ ↦ 1 / (2 * (localMeshSize n : ℝ)))
      atTop (𝓝 0) := by
    have htwo : Tendsto (fun n : ℕ ↦ 2 * (localMeshSize n : ℝ))
        atTop atTop := hmeshR.const_mul_atTop (by norm_num)
    exact (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (1 : ℝ))
      atTop (𝓝 1)).div_atTop htwo
  have hlower : Tendsto (fun n : ℕ ↦
      (1 / 2 : ℝ) - 1 / (2 * (localMeshSize n : ℝ)))
      atTop (𝓝 (1 / 2 : ℝ)) := by
    convert tendsto_const_nhds.sub hinv using 1 <;> norm_num
  have hupper : Tendsto (fun _n : ℕ ↦ (1 / 2 : ℝ))
      atTop (𝓝 (1 / 2 : ℝ)) := tendsto_const_nhds
  apply Filter.Tendsto.squeeze hlower hupper
  · intro n
    have hnat : localMeshSize n ≤ 2 * halfLocalMeshSize n + 1 := by
      unfold halfLocalMeshSize
      omega
    have hnatR : (localMeshSize n : ℝ) ≤
        2 * (halfLocalMeshSize n : ℝ) + 1 := by exact_mod_cast hnat
    have hpos : (0 : ℝ) < localMeshSize n := by
      exact_mod_cast localMeshSize_pos n
    apply (le_div_iff₀ hpos).2
    field_simp
    nlinarith
  · intro n
    have hnat : 2 * halfLocalMeshSize n ≤ localMeshSize n := by
      unfold halfLocalMeshSize
      omega
    have hnatR : 2 * (halfLocalMeshSize n : ℝ) ≤
        localMeshSize n := by exact_mod_cast hnat
    have hpos : (0 : ℝ) < localMeshSize n := by
      exact_mod_cast localMeshSize_pos n
    apply (div_le_iff₀ hpos).2
    nlinarith

lemma halfLocalMeshSize_tendsto_atTop :
    Tendsto halfLocalMeshSize atTop atTop := by
  rw [tendsto_atTop]
  intro b
  filter_upwards [eventually_ge_atTop (max b 2)] with n hn
  have hn2 : 2 ≤ n := le_trans (le_max_right b 2) hn
  have hdouble : 2 * n ≤ localMeshSize n := by
    unfold localMeshSize
    nlinarith [Nat.mul_self_le_mul_self hn2]
  have hnHalf : n ≤ halfLocalMeshSize n := by
    rw [halfLocalMeshSize, Nat.le_div_iff_mul_le (by norm_num)]
    simpa [mul_comm] using hdouble
  exact (le_max_left b 2).trans (hn.trans hnHalf)

theorem allHalfLocalSiteSets_ratio_tendsto_factorial
    (k : ℕ) :
    Tendsto (fun n : ℕ ↦
      (((halfLocalMeshSize n).choose k : ℕ) : ℝ) /
        (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 (((1 / 2 : ℝ) ^ k) / (k.factorial : ℝ))) := by
  have hequiv := (isEquivalent_choose k).comp_tendsto
    halfLocalMeshSize_tendsto_atTop
  have hratio := hequiv.div
    (Asymptotics.IsEquivalent.refl :
      (fun n : ℕ ↦ (halfLocalMeshSize n : ℝ) ^ k) ~[atTop]
        (fun n : ℕ ↦ (halfLocalMeshSize n : ℝ) ^ k))
  have hchoose : Tendsto (fun n : ℕ ↦
      (((halfLocalMeshSize n).choose k : ℕ) : ℝ) /
        (halfLocalMeshSize n : ℝ) ^ k)
      atTop (𝓝 ((k.factorial : ℝ)⁻¹)) := by
    refine hratio.tendsto_nhds_iff.mpr ?_
    apply Tendsto.congr' _ tendsto_const_nhds
    filter_upwards [eventually_ge_atTop 1] with n hn
    have hhalf : halfLocalMeshSize n ≠ 0 := by
      have hsq : 1 ≤ n ^ 2 := by nlinarith
      unfold halfLocalMeshSize localMeshSize
      omega
    have hhalfR : (halfLocalMeshSize n : ℝ) ^ k ≠ 0 := by
      exact pow_ne_zero k (by exact_mod_cast hhalf)
    have hfac : (k.factorial : ℝ) ≠ 0 := by
      exact_mod_cast k.factorial_ne_zero
    simp only [Function.comp_apply, Pi.div_apply]
    field_simp
  have hhalfPow := halfLocalMeshSize_ratio_tendsto_half.pow k
  have hmul := hchoose.mul hhalfPow
  have hmul' : Tendsto (fun n : ℕ ↦
      (((halfLocalMeshSize n).choose k : ℕ) : ℝ) /
          (halfLocalMeshSize n : ℝ) ^ k *
        ((halfLocalMeshSize n : ℝ) / (localMeshSize n : ℝ)) ^ k)
      atTop (𝓝 (((1 / 2 : ℝ) ^ k) / (k.factorial : ℝ))) := by
    convert hmul using 1 <;> ring
  apply Tendsto.congr' _ hmul'
  filter_upwards [eventually_ge_atTop 1] with n hn
  have hhalf : halfLocalMeshSize n ≠ 0 := by
    have hpos : 0 < halfLocalMeshSize n := by
      have hsq : 1 ≤ n ^ 2 := by nlinarith
      unfold halfLocalMeshSize localMeshSize
      omega
    exact hpos.ne'
  have hmesh : (localMeshSize n : ℝ) ^ k ≠ 0 := by
    exact pow_ne_zero k (by exact_mod_cast (localMeshSize_pos n).ne')
  have hhalfR : (halfLocalMeshSize n : ℝ) ^ k ≠ 0 := by
    exact pow_ne_zero k (by exact_mod_cast hhalf)
  rw [div_pow]
  field_simp [hmesh, hhalfR]

theorem halfBadLocalSiteSets_ratio_tendsto_zero
    (k : ℕ) (hk : 0 < k) :
    Tendsto (fun n : ℕ ↦
      ((halfBadLocalSiteSets n k).card : ℝ) /
        (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 0) := by
  apply squeeze_zero' (Eventually.of_forall fun n ↦ by positivity)
  · exact Eventually.of_forall fun n ↦ by
      have hcardR : ((halfBadLocalSiteSets n k).card : ℝ) ≤
          (badLocalSiteSets n k).card := by
        exact_mod_cast halfBadLocalSiteSets_card_le n k
      exact div_le_div_of_nonneg_right hcardR (by positivity)
  · exact badLocalSiteSets_ratio_tendsto_zero k hk

theorem halfGoodLocalSiteSets_ratio_tendsto_factorial
    (k : ℕ) (hk : 0 < k) :
    Tendsto (fun n : ℕ ↦
      ((halfGoodLocalSiteSets n k).card : ℝ) /
        (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 (((1 / 2 : ℝ) ^ k) / (k.factorial : ℝ))) := by
  have hidentity : ∀ n : ℕ,
      ((halfGoodLocalSiteSets n k).card : ℝ) /
          (localMeshSize n : ℝ) ^ k =
        (((halfLocalMeshSize n).choose k : ℕ) : ℝ) /
            (localMeshSize n : ℝ) ^ k -
          ((halfBadLocalSiteSets n k).card : ℝ) /
            (localMeshSize n : ℝ) ^ k := by
    intro n
    have hsum := halfGoodLocalSiteSets_card_add_halfBadLocalSiteSets_card n k
    have hsumR : ((halfGoodLocalSiteSets n k).card : ℝ) +
        (halfBadLocalSiteSets n k).card =
          (halfLocalMeshSize n).choose k := by
      exact_mod_cast hsum
    rw [← hsumR]
    ring
  apply Tendsto.congr' (Eventually.of_forall fun n ↦ (hidentity n).symm)
  simpa using (allHalfLocalSiteSets_ratio_tendsto_factorial k).sub
    (halfBadLocalSiteSets_ratio_tendsto_zero k hk)

theorem allLocalSiteSets_ratio_tendsto_factorial
    (k : ℕ) :
    Tendsto (fun n : ℕ ↦
      (((localMeshSize n).choose k : ℕ) : ℝ) /
        (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 ((k.factorial : ℝ)⁻¹)) := by
  have hequiv := (isEquivalent_choose k).comp_tendsto localMeshSize_tendsto_atTop
  have hratio := hequiv.div
    (Asymptotics.IsEquivalent.refl :
      (fun n : ℕ ↦ (localMeshSize n : ℝ) ^ k) ~[atTop]
        (fun n : ℕ ↦ (localMeshSize n : ℝ) ^ k))
  refine hratio.tendsto_nhds_iff.mpr ?_
  convert tendsto_const_nhds (x := (k.factorial : ℝ)⁻¹) using 1
  funext n
  have hmesh : (localMeshSize n : ℝ) ^ k ≠ 0 := by
    exact pow_ne_zero k (by exact_mod_cast (localMeshSize_pos n).ne')
  have hfac : (k.factorial : ℝ) ≠ 0 := by
    exact_mod_cast k.factorial_ne_zero
  simp only [Function.comp_apply, Pi.div_apply]
  field_simp

theorem goodLocalSiteSets_ratio_tendsto_factorial
    (k : ℕ) (hk : 0 < k) :
    Tendsto (fun n : ℕ ↦
      ((goodLocalSiteSets n k).card : ℝ) /
        (localMeshSize n : ℝ) ^ k)
      atTop (𝓝 ((k.factorial : ℝ)⁻¹)) := by
  have hidentity : ∀ n : ℕ,
      ((goodLocalSiteSets n k).card : ℝ) /
