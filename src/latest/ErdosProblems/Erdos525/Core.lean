    ‖reflectedPositionCoeff u target‖ *
          ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
            (2 * k) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) ≤
      ‖variableAffinePositionAfter n (reflectedModeTime points target)
          (affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
            (reflectedPositionCoeff u target)
            (reflectedVelocityCoeff u target) (List.replicate k 1))
          (reflectedVelocityCoeff u target *
            modeSeparationProduct n (reflectedModeTime points target)
              (q₀ : ℤ) (List.replicate k 1))
          (variableReflectedTwists n points step target)‖ +
        2 * (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
          (variableStepSum
            (variableReflectedTwists n points step target) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) := by
  let twists := variableReflectedTwists n points step target
  let A : ℂ := reflectedPositionCoeff u target
  let B : ℂ := reflectedVelocityCoeff u target
  let P : ℂ := modeSeparationProduct n (reflectedModeTime points target)
    (q₀ : ℤ) (List.replicate k 1)
  let C : ℂ := affinePositionAfter n (reflectedModeTime points target)
    (q₀ : ℤ) A B (List.replicate k 1)
  let V : ℂ := B * P
  let Q : ℂ := variableModeSeparationProduct n
    (reflectedModeTime points target) twists
  let D : ℝ := δ ^ (2 * twists.length)
  let X : ℂ := variableAffinePositionAfter n
    (reflectedModeTime points target) C V twists
  have hD : 0 ≤ D := by dsimp [D]; positivity
  have hQ : D ≤ ‖Q‖ := by
    simpa [D, Q, twists] using
      pow_gap_le_norm_variableModeSeparationProduct n
        (reflectedModeTime points target) twists δ hδ
        (by simpa [twists] using
          variableReflectedTwists_gap n points step target δ hsep)
  have hP : ‖P‖ =
      ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
        (2 * k) := by
    simpa [P] using norm_modeSeparationProduct_replicate_one
      n (reflectedModeTime points target) (q₀ : ℤ) k
  have hord : ‖C - A * P‖ ≤
      (k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n := by
    simpa [C, A, B, P] using
      norm_affinePositionAfter_sub_le_general n hn
        (reflectedModeTime points target) (q₀ : ℤ) A B
        (List.replicate k 1)
        (by
          intro ζ hζ
          simp only [List.mem_replicate] at hζ
          rcases hζ with ⟨_hk, rfl⟩
          simp)
  have hvar : ‖X - C * Q‖ ≤
      2 * (4 : ℝ) ^ twists.length * ‖V‖ *
        (variableStepSum twists : ℝ) / n := by
    simpa [X, C, V, Q] using
      norm_variableAffinePositionAfter_sub_le n hn
        (reflectedModeTime points target) C V twists
        (by simpa [twists] using
          variableReflectedTwists_unit n points step target)
  have hAP : ‖A‖ * ‖P‖ * D ≤ ‖C * Q‖ + ‖C - A * P‖ * D := by
    have hAtoC : ‖A * P‖ ≤ ‖C‖ + ‖C - A * P‖ := by
      calc
        ‖A * P‖ = ‖C - (C - A * P)‖ := by congr 1 <;> ring
        _ ≤ ‖C‖ + ‖C - A * P‖ := norm_sub_le _ _
    calc
      ‖A‖ * ‖P‖ * D = ‖A * P‖ * D := by rw [norm_mul]
      _ ≤ (‖C‖ + ‖C - A * P‖) * D :=
        mul_le_mul_of_nonneg_right hAtoC hD
      _ = ‖C‖ * D + ‖C - A * P‖ * D := by ring
      _ ≤ ‖C‖ * ‖Q‖ + ‖C - A * P‖ * D := by gcongr
      _ = ‖C * Q‖ + ‖C - A * P‖ * D := by rw [norm_mul]
  have hCQ : ‖C * Q‖ ≤ ‖X‖ + ‖X - C * Q‖ := by
    calc
      ‖C * Q‖ = ‖X - (X - C * Q)‖ := by congr 1 <;> ring
      _ ≤ ‖X‖ + ‖X - C * Q‖ := norm_sub_le _ _
  calc
    ‖reflectedPositionCoeff u target‖ *
          ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
            (2 * k) * D = ‖A‖ * ‖P‖ * D := by rw [hP]
    _ ≤ ‖C * Q‖ + ‖C - A * P‖ * D := hAP
    _ ≤ (‖X‖ + ‖X - C * Q‖) + ‖C - A * P‖ * D := by gcongr
    _ ≤ (‖X‖ +
          2 * (4 : ℝ) ^ twists.length * ‖V‖ *
            (variableStepSum twists : ℝ) / n) +
          ((k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n) * D := by
      gcongr
    _ = ‖variableAffinePositionAfter n (reflectedModeTime points target)
          (affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
            (reflectedPositionCoeff u target)
            (reflectedVelocityCoeff u target) (List.replicate k 1))
          (reflectedVelocityCoeff u target *
            modeSeparationProduct n (reflectedModeTime points target)
              (q₀ : ℤ) (List.replicate k 1))
          (variableReflectedTwists n points step target)‖ +
        2 * (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
          (variableStepSum
            (variableReflectedTwists n points step target) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) := by
      simp [X, C, V, P, A, B, D, twists, norm_mul, hP]

lemma variableReflectedTwists_stepSum_le
    (n : ℕ) (points : Fin m → ℝ) (step : ReflectedMode m → ℕ)
    (a : ReflectedMode m) (q : ℕ)
    (hstep : ∀ b : ReflectedMode m, b ≠ a → step b ≤ q) :
    variableStepSum (variableReflectedTwists n points step a) ≤
      (2 * m - 1) * q := by
  let modes : List (ReflectedMode m) := (Finset.univ.erase a).toList
  have hterm : ∀ b ∈ modes, step b ≤ q := by
    intro b hb
    apply hstep b
    exact (by simpa [modes] using hb)
  have hsum := List.sum_le_card_nsmul (modes.map step) q
    (by
      intro h hh
      rcases List.mem_map.mp hh with ⟨b, hb, rfl⟩
      exact hterm b hb)
  simpa [variableStepSum, variableReflectedTwists, modes,
    variableReflectedTwists_length, Nat.mul_comm] using hsum

/-- The smooth/spread hypotheses give a direct lower bound on the
distance-to-integers between every two reflected frequencies. -/
lemma reflectedMode_distance_lower
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (a b : ReflectedMode m) (hab : a ≠ b) :
    min (K / n) (lam / n) ≤
      distanceToInteger
        ((reflectedModeTime points a - reflectedModeTime points b) /
          (2 * Real.pi * n)) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  rcases a with ⟨r, ar⟩
  rcases b with ⟨s, bs⟩
  cases ar <;> cases bs
  · change min (K / n) (lam / n) ≤
      distanceToInteger ((-points r - -points s) / (2 * Real.pi * n))
    have hrs : r ≠ s := by
      intro hrs
      subst s
      exact hab rfl
    rw [show (-points r - -points s) / (2 * Real.pi * n) =
        -((points r - points s) / (2 * Real.pi * n)) by ring,
      distanceToInteger_neg]
    exact (min_le_right _ _).trans (hspread.2 r s hrs).1
  · change min (K / n) (lam / n) ≤
      distanceToInteger ((-points r - points s) / (2 * Real.pi * n))
    by_cases hrs : r = s
    · subst s
      rw [show (-points r - points r) / (2 * Real.pi * n) =
          -(points r / (Real.pi * n)) by
        field_simp [hn0, Real.pi_ne_zero]
        <;> ring,
        distanceToInteger_neg]
      have hs := hsmooth r 1 (by norm_num) (by omega)
      exact (min_le_left _ _).trans (by simpa using hs.le)
    · rw [show (-points r - points s) / (2 * Real.pi * n) =
          -((points r + points s) / (2 * Real.pi * n)) by ring,
        distanceToInteger_neg]
      exact (min_le_right _ _).trans (hspread.2 r s hrs).2
  · change min (K / n) (lam / n) ≤
      distanceToInteger ((points r - -points s) / (2 * Real.pi * n))
    by_cases hrs : r = s
    · subst s
      rw [show (points r - -points r) / (2 * Real.pi * n) =
          points r / (Real.pi * n) by
        field_simp [hn0, Real.pi_ne_zero]
        <;> ring]
      have hs := hsmooth r 1 (by norm_num) (by omega)
      exact (min_le_left _ _).trans (by simpa using hs.le)
    · rw [sub_neg_eq_add]
      exact (min_le_right _ _).trans (hspread.2 r s hrs).2
  · change min (K / n) (lam / n) ≤
      distanceToInteger ((points r - points s) / (2 * Real.pi * n))
    have hrs : r ≠ s := by
      intro hrs
      subst s
      exact hab rfl
    exact (min_le_right _ _).trans (hspread.2 r s hrs).1

/-- Oscillatory moments between two distinct reflected modes.  The estimate
is uniform in the mode locations and loses only the inverse quotient-circle
gap. -/
lemma norm_centeredWaveMoment_reflected_sub_le
    (n k : ℕ) (hn : 0 < n) (hk : k ≤ 2)
    (points : Fin m → ℝ) (a b : ReflectedMode m)
    (rho : ℝ) (hrho : 0 < rho)
    (hdist : rho ≤ distanceToInteger
      ((reflectedModeTime points a - reflectedModeTime points b) /
        (2 * Real.pi * n))) :
    ‖centeredWaveMoment n k
        (reflectedModeTime points a - reflectedModeTime points b)‖ ≤
      6 / (4 * rho) := by
  have hchord :
      4 * rho ≤
        ‖complexWave n (reflectedModeTime points a) 1 -
          complexWave n (reflectedModeTime points b) 1‖ := by
    calc
      4 * rho ≤ 4 * distanceToInteger
          (((1 : ℤ) : ℝ) *
            (reflectedModeTime points a - reflectedModeTime points b) /
              (2 * Real.pi * n)) := by
        simpa only [Int.cast_one, one_mul] using
          mul_le_mul_of_nonneg_left hdist (by norm_num : (0 : ℝ) ≤ 4)
      _ ≤ ‖complexWave n (reflectedModeTime points a) 1 -
          complexWave n (reflectedModeTime points b) 1‖ :=
        four_mul_distance_le_norm_complexWave_sub n hn
          (reflectedModeTime points b) (reflectedModeTime points a) 1
  rw [← norm_complexWave_sub_one_eq_sub n
    (reflectedModeTime points b) (reflectedModeTime points a) 1] at hchord
  exact norm_centeredWaveMoment_le n k hn hk
    (reflectedModeTime points a - reflectedModeTime points b)
    (4 * rho) (mul_pos (by norm_num) hrho) hchord

lemma norm_centeredWaveMoment_reflected_sub_le_of_smooth_spread
    (n k : ℕ) (hn : 0 < n) (hk : k ≤ 2)
    (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (a b : ReflectedMode m) (hab : a ≠ b)
    (hrho : 0 < min (K / n) (lam / n)) :
    ‖centeredWaveMoment n k
        (reflectedModeTime points a - reflectedModeTime points b)‖ ≤
      6 / (4 * min (K / n) (lam / n)) := by
  exact norm_centeredWaveMoment_reflected_sub_le n k hn hk points a b
    (min (K / n) (lam / n)) hrho
    (reflectedMode_distance_lower n hn K lam points hsmooth hspread a b hab)

noncomputable def individualDilationGap (q : ℕ) (rho : ℝ) : ℝ :=
  4 * min (1 / 64) ((q : ℝ) * rho / 8000)

/-- Choose a separate bounded dilation for every unwanted reflected mode.
Each choice converts the common undilated circle-distance lower bound into
a common chordal spectral gap. -/
lemma exists_variableReflectedSteps
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (a : ReflectedMode m) (q : ℕ) (hq : 800 ≤ q) (rho : ℝ)
    (hrho : 0 < rho)
    (hdist : ∀ b : ReflectedMode m, b ≠ a →
      rho ≤ distanceToInteger
        ((reflectedModeTime points a - reflectedModeTime points b) /
          (2 * Real.pi * n))) :
    ∃ step : ReflectedMode m → ℕ,
      (∀ b : ReflectedMode m, b ≠ a → 1 ≤ step b ∧ step b < q) ∧
      ∀ b : ReflectedMode m, b ≠ a →
        individualDilationGap q rho ≤
          ‖complexWave n (reflectedModeTime points a) (step b : ℤ) -
            complexWave n (reflectedModeTime points b) (step b : ℤ)‖ := by
  have hex : ∀ b : ReflectedMode m, ∃ h : ℕ,
      (b ≠ a → 1 ≤ h ∧ h < q) ∧
      (b ≠ a → individualDilationGap q rho ≤
        ‖complexWave n (reflectedModeTime points a) (h : ℤ) -
          complexWave n (reflectedModeTime points b) (h : ℤ)‖) := by
    intro b
    by_cases hba : b = a
    · exact ⟨1, by simp [hba]⟩
    · let x : ℝ :=
          (reflectedModeTime points a - reflectedModeTime points b) /
            (2 * Real.pi * n)
      have hx : 0 < distanceToInteger x :=
        hrho.trans_le (by simpa [x] using hdist b hba)
      rcases exists_singleDilation q x hq hx with ⟨h, hh, hscale⟩
      have hh' : 1 ≤ h ∧ h < q := by simpa using hh
      refine ⟨h, ⟨fun _ ↦ hh', ?_⟩⟩
      intro _
      have hscaleMono : individualDilationGap q rho ≤
          4 * singleDilationScale q x := by
        unfold individualDilationGap singleDilationScale
        gcongr
        exact hdist b hba
      calc
        individualDilationGap q rho ≤
            4 * singleDilationScale q x := hscaleMono
        _ ≤ 4 * distanceToInteger (h * x) :=
          mul_le_mul_of_nonneg_left hscale (by norm_num)
        _ ≤ ‖complexWave n (reflectedModeTime points a) (h : ℤ) -
              complexWave n (reflectedModeTime points b) (h : ℤ)‖ := by
          convert four_mul_distance_le_norm_complexWave_sub
            n hn (reflectedModeTime points b) (reflectedModeTime points a) (h : ℤ)
              using 1 <;> simp [x] <;> ring
  choose step hstep using hex
  refine ⟨step, ?_, ?_⟩
  · intro b hba
    exact (hstep b).1 hba
  · intro b hba
    exact (hstep b).2 hba

/-- Exact termwise formula for applying a double spectral twist to the
complex phase projection.  When `s` equals one of the sample times, the two
terms at that time vanish; every other mode acquires an explicit squared
separation factor. -/
lemma doubleTwist_complexPhaseProjection
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (s : ℝ) (h j : ℤ) :
    doubleTwist h (complexWave n s h)
        (complexPhaseProjection n points u) j =
      ∑ r : Fin m,
        (phasePositionCoeff u r *
            ((complexWave n (points r) h - complexWave n s h) ^ 2 *
              complexWave n (points r) j) +
          phaseVelocityCoeff u r *
            (((complexWave n (points r) h - complexWave n s h) ^ 2 *
                weightedComplexWave n (points r) j) +
              (2 : ℂ) * ((h : ℝ) / n) * complexWave n (points r) h *
                (complexWave n (points r) h - complexWave n s h) *
                  complexWave n (points r) j)) := by
  unfold complexPhaseProjection
  rw [doubleTwist_sum]
  apply Finset.sum_congr rfl
  intro r _
  rw [doubleTwist_add, doubleTwist_const_mul, doubleTwist_const_mul]
  rw [show doubleTwist h (complexWave n s h)
        (complexWave n (points r)) j =
      (complexWave n (points r) h - complexWave n s h) ^ 2 *
        complexWave n (points r) j by
    exact twistedDifference_twice_complexWave n s (points r) h j]
  rw [show doubleTwist h (complexWave n s h)
        (weightedComplexWave n (points r)) j =
      (complexWave n (points r) h - complexWave n s h) ^ 2 *
          weightedComplexWave n (points r) j +
        (2 : ℂ) * ((h : ℝ) / n) * complexWave n (points r) h *
          (complexWave n (points r) h - complexWave n s h) *
            complexWave n (points r) j by
    exact twistedDifference_twice_weightedComplexWave n s (points r) h j]

lemma complex_re_sum {I : Type*} [Fintype I] (f : I → ℂ) :
    (∑ i, f i).re = ∑ i, (f i).re := by
  change Complex.reCLM (∑ i, f i) = ∑ i, Complex.reCLM (f i)
  exact map_sum Complex.reCLM f Finset.univ

lemma normSq_centeredAffineModeSum_eq {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ) (A B : I → ℂ)
    (j : Fin (2 * n + 1)) :
    Complex.normSq (centeredAffineModeSum n times A B j) =
      ∑ a : I, ∑ b : I,
        (centeredAffineMode n (times a) (A a) (B a) j *
          conj (centeredAffineMode n (times b) (A b) (B b) j)).re := by
  have hmul : centeredAffineModeSum n times A B j *
      conj (centeredAffineModeSum n times A B j) =
      ∑ a : I, ∑ b : I,
        centeredAffineMode n (times a) (A a) (B a) j *
          conj (centeredAffineMode n (times b) (A b) (B b) j) := by
    unfold centeredAffineModeSum
    rw [map_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
  rw [Complex.mul_conj] at hmul
  have hre := congrArg Complex.re hmul
  simpa only [Complex.ofReal_re, complex_re_sum] using hre

lemma sum_normSq_centeredAffineModeSum_eq {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ) (A B : I → ℂ) :
    ∑ j : Fin (2 * n + 1), Complex.normSq (centeredAffineModeSum n times A B j) =
      ∑ a : I, ∑ b : I,
        (centeredAffineCrossMoment n (times b) (times a)
          (A a) (B a) (A b) (B b)).re := by
  simp_rw [normSq_centeredAffineModeSum_eq]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro b _
  unfold centeredAffineCrossMoment
  exact (complex_re_sum _).symm

lemma six_mul_sum_range_sq (N : ℕ) :
    6 * (∑ q ∈ Finset.range N, (q : ℝ) ^ 2) =
      (N : ℝ) * ((N : ℝ) - 1) * (2 * (N : ℝ) - 1) := by
  induction N with
  | zero => simp
  | succ N ih =>
      rw [Finset.sum_range_succ, mul_add, ih]
      push_cast
      ring

lemma two_mul_sum_range_cast (N : ℕ) :
    2 * (∑ q ∈ Finset.range N, (q : ℝ)) =
      (N : ℝ) * ((N : ℝ) - 1) := by
  induction N with
  | zero => simp
  | succ N ih =>
      rw [Finset.sum_range_succ, mul_add, ih]
      push_cast
      ring

lemma sum_centered_ratio_eq_zero (n : ℕ) (hn : 0 < n) :
    ∑ q ∈ Finset.range (2 * n + 1), (((q : ℝ) - n) / n) = 0 := by
  have hsum := two_mul_sum_range_cast (2 * n + 1)
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  rw [← Finset.sum_div]
  simp_rw [Finset.sum_sub_distrib, Finset.sum_const]
  simp only [nsmul_eq_mul, Finset.card_range]
  push_cast at hsum ⊢
  field_simp
  nlinarith

lemma sum_centered_ratio_sq_eq (n : ℕ) (hn : 0 < n) :
    ∑ q ∈ Finset.range (2 * n + 1), (((q : ℝ) - n) / n) ^ 2 =
      (2 * n + 1 : ℝ) * (n + 1) / (3 * n) := by
  have hsum := two_mul_sum_range_cast (2 * n + 1)
  have hsq := six_mul_sum_range_sq (2 * n + 1)
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  simp_rw [div_pow, sub_sq]
  rw [← Finset.sum_div]
  rw [show
      ∑ q ∈ Finset.range (2 * n + 1),
          ((q : ℝ) ^ 2 - 2 * (q : ℝ) * n + (n : ℝ) ^ 2) =
        (∑ q ∈ Finset.range (2 * n + 1), (q : ℝ) ^ 2) -
          2 * (n : ℝ) * (∑ q ∈ Finset.range (2 * n + 1), (q : ℝ)) +
          (2 * n + 1 : ℝ) * (n : ℝ) ^ 2 by
    rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
    simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    rw [show (∑ q ∈ Finset.range (2 * n + 1), 2 * (q : ℝ) * n) =
        2 * (n : ℝ) * (∑ q ∈ Finset.range (2 * n + 1), (q : ℝ)) by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro q _
      ring]
    push_cast
    ring]
  push_cast at hsum hsq ⊢
  field_simp
  nlinarith

lemma centeredWaveMoment_zero (n k : ℕ) :
    centeredWaveMoment n k 0 =
      ((∑ q ∈ Finset.range (2 * n + 1),
        ((((q : ℝ) - n) / n) ^ k : ℝ)) : ℝ) := by
  unfold centeredWaveMoment complexWave
  rw [Finset.sum_fin_eq_sum_range]
  push_cast
  apply Finset.sum_congr rfl
  intro q hq
  simp only [Finset.mem_range] at hq
  simp [hq]

lemma centeredAffineCrossMoment_self_re (n : ℕ) (hn : 0 < n)
    (t : ℝ) (A B : ℂ) :
    (centeredAffineCrossMoment n t t A B A B).re =
      (2 * n + 1 : ℝ) * Complex.normSq A +
        ((2 * n + 1 : ℝ) * (n + 1) / (3 * n)) * Complex.normSq B := by
  rw [centeredAffineCrossMoment_eq]
  simp only [sub_self]
  rw [centeredWaveMoment_zero, centeredWaveMoment_zero,
    centeredWaveMoment_zero]
  rw [show (∑ q ∈ Finset.range (2 * n + 1),
      ((((q : ℝ) - n) / n) ^ 0 : ℝ)) = (2 * n + 1 : ℝ) by simp]
  rw [show (∑ q ∈ Finset.range (2 * n + 1),
      ((((q : ℝ) - n) / n) ^ 1 : ℝ)) = 0 by
        simpa using sum_centered_ratio_eq_zero n hn]
  rw [sum_centered_ratio_sq_eq n hn]
  simp only [Complex.add_re, Complex.mul_re, Complex.conj_re,
    Complex.conj_im, Complex.ofReal_re, Complex.ofReal_im, mul_zero,
    sub_zero, zero_mul, add_zero]
  simp [Complex.normSq_apply]
  ring

lemma phaseCoeff_energy (u : PhaseCoordinate m) :
    ∑ r : Fin m,
        (Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r)) = phaseNormSq u := by
  unfold phasePositionCoeff phaseVelocityCoeff phaseNormSq
  apply Finset.sum_congr rfl
  intro r _
  rw [Fin.sum_univ_four]
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

lemma sum_reflectedPositionCoeff_normSq_eq (u : PhaseCoordinate m) :
    ∑ a : ReflectedMode m, Complex.normSq (reflectedPositionCoeff u a) =
      (∑ r : Fin m, Complex.normSq (phasePositionCoeff u r)) / 2 := by
  rw [Fintype.sum_prod_type]
  conv_rhs => rw [div_eq_mul_inv, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro r _
  simp [reflectedPositionCoeff, Complex.normSq_apply]
  ring

lemma sum_reflectedVelocityCoeff_normSq_eq (u : PhaseCoordinate m) :
    ∑ a : ReflectedMode m, Complex.normSq (reflectedVelocityCoeff u a) =
      (∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)) / 2 := by
  rw [Fintype.sum_prod_type]
  conv_rhs => rw [div_eq_mul_inv, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro r _
  simp [reflectedVelocityCoeff, Complex.normSq_apply]
  ring

lemma reflectedAffineDiagonal_eq
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) :
    ∑ a : ReflectedMode m,
        (centeredAffineCrossMoment n
          (reflectedModeTime points a) (reflectedModeTime points a)
          (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
          (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)).re =
      ((2 * n + 1 : ℝ) / 2) *
          (∑ r : Fin m, Complex.normSq (phasePositionCoeff u r)) +
        ((2 * n + 1 : ℝ) * (n + 1) / (6 * n)) *
          (∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)) := by
  simp_rw [centeredAffineCrossMoment_self_re n hn]
  rw [Finset.sum_add_distrib]
  rw [← Finset.mul_sum, ← Finset.mul_sum]
  rw [sum_reflectedPositionCoeff_normSq_eq,
    sum_reflectedVelocityCoeff_normSq_eq]
  ring

lemma reflectedAffineDiagonal_lower
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) :
    ((2 * n + 1 : ℝ) / 6) * phaseNormSq u ≤
      ∑ a : ReflectedMode m,
        (centeredAffineCrossMoment n
          (reflectedModeTime points a) (reflectedModeTime points a)
          (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
          (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)).re := by
  rw [reflectedAffineDiagonal_eq n hn points u, ← phaseCoeff_energy]
  let P : ℝ := ∑ r : Fin m, Complex.normSq (phasePositionCoeff u r)
  let V : ℝ := ∑ r : Fin m, Complex.normSq (phaseVelocityCoeff u r)
  have hP : 0 ≤ P := Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _
  have hV : 0 ≤ V := Finset.sum_nonneg fun r _ ↦ Complex.normSq_nonneg _
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hpos : (2 * n + 1 : ℝ) / 6 ≤ (2 * n + 1 : ℝ) / 2 := by
    have hcount : (0 : ℝ) ≤ 2 * n + 1 := by positivity
    nlinarith
  have hvel : (2 * n + 1 : ℝ) / 6 ≤
      (2 * n + 1 : ℝ) * (n + 1) / (6 * n) := by
    apply (div_le_div_iff₀ (by positivity : (0 : ℝ) < 6)
      (by positivity : (0 : ℝ) < 6 * n)).2
    nlinarith
  rw [Finset.sum_add_distrib]
  change ((2 * n + 1 : ℝ) / 6) * (P + V) ≤
    ((2 * n + 1 : ℝ) / 2) * P +
      ((2 * n + 1 : ℝ) * (n + 1) / (6 * n)) * V
  rw [mul_add]
  exact add_le_add
    (mul_le_mul_of_nonneg_right hpos hP)
    (mul_le_mul_of_nonneg_right hvel hV)

lemma sum_offDiagonal_mul_le_square {I : Type*} [Fintype I] [DecidableEq I]
    (w : I → ℝ) (hw : ∀ a, 0 ≤ w a) :
    (∑ a : I, ∑ b ∈ (Finset.univ.erase a), w a * w b) ≤
      (∑ a : I, w a) ^ 2 := by
  calc
    (∑ a : I, ∑ b ∈ (Finset.univ.erase a), w a * w b) ≤
        ∑ a : I, ∑ b : I, w a * w b := by
      apply Finset.sum_le_sum
      intro a _
      exact Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.erase_subset a Finset.univ)
        (fun b _hb _hnot ↦ mul_nonneg (hw a) (hw b))
    _ = (∑ a : I, w a) ^ 2 := by
      conv_lhs =>
        enter [2, a]
        rw [← Finset.mul_sum]
      rw [← Finset.sum_mul]
      ring

lemma sum_double_eq_diag_add_offDiagonal {I : Type*} [Fintype I]
    [DecidableEq I] (f : I → I → ℝ) :
    (∑ a : I, ∑ b : I, f a b) =
      (∑ a : I, f a a) +
        ∑ a : I, ∑ b ∈ (Finset.univ.erase a), f a b := by
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro a _
  rw [add_comm]
  exact (Finset.sum_erase_add (s := Finset.univ)
    (f := fun b ↦ f a b) (Finset.mem_univ a)).symm

lemma diag_sub_square_le_sum_double {I : Type*} [Fintype I]
    [DecidableEq I] (f : I → I → ℝ) (w : I → ℝ) (M : ℝ)
    (hM : 0 ≤ M) (hw : ∀ a, 0 ≤ w a)
    (hf : ∀ a b, a ≠ b → -M * w a * w b ≤ f a b) :
    (∑ a : I, f a a) - M * (∑ a : I, w a) ^ 2 ≤
      ∑ a : I, ∑ b : I, f a b := by
  let Woff : ℝ := ∑ a : I, ∑ b ∈ (Finset.univ.erase a), w a * w b
  have hW : Woff ≤ (∑ a : I, w a) ^ 2 :=
    sum_offDiagonal_mul_le_square w hw
  have hneg : -M * (∑ a : I, w a) ^ 2 ≤ -M * Woff := by
    exact mul_le_mul_of_nonpos_left hW (neg_nonpos.mpr hM)
  have hfactor :
      -M * Woff =
        ∑ a : I, ∑ b ∈ (Finset.univ.erase a), -M * w a * w b := by
    dsimp [Woff]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  have hoff :
      (∑ a : I, ∑ b ∈ (Finset.univ.erase a), -M * w a * w b) ≤
        ∑ a : I, ∑ b ∈ (Finset.univ.erase a), f a b := by
    apply Finset.sum_le_sum
    intro a _
    apply Finset.sum_le_sum
    intro b hb
    exact hf a b (Finset.ne_of_mem_erase hb).symm
  rw [sum_double_eq_diag_add_offDiagonal]
  calc
    (∑ a : I, f a a) - M * (∑ a : I, w a) ^ 2 =
        (∑ a : I, f a a) + (-M * (∑ a : I, w a) ^ 2) := by ring
    _ ≤ (∑ a : I, f a a) + (-M * Woff) := add_le_add_right hneg _
    _ = (∑ a : I, f a a) +
        ∑ a : I, ∑ b ∈ (Finset.univ.erase a), -M * w a * w b := by rw [hfactor]
    _ ≤ (∑ a : I, f a a) +
        ∑ a : I, ∑ b ∈ (Finset.univ.erase a), f a b := add_le_add_right hoff _

lemma sum_reflectedCoeffWeight_sq_le (u : PhaseCoordinate m) :
    (∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖)) ^ 2 ≤
      (4 * m : ℝ) ^ 2 * phaseNormSq u := by
  let W : ℝ := ∑ a : ReflectedMode m,
    (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖)
  let R : ℝ := (4 * m : ℝ) * ‖phaseToEuclidean u‖
  have hW0 : 0 ≤ W := Finset.sum_nonneg fun a _ ↦
    add_nonneg (norm_nonneg _) (norm_nonneg _)
  have hWR : W ≤ R :=
    (sum_norm_reflectedCoeffs_le_l1 u).trans
      (phaseL1_le_dim_mul_euclideanNorm u)
  have hR0 : 0 ≤ R := by dsimp [R]; positivity
  have hsq : W ^ 2 ≤ R ^ 2 := by nlinarith
  change W ^ 2 ≤ (4 * m : ℝ) ^ 2 * phaseNormSq u
  calc
    W ^ 2 ≤ R ^ 2 := hsq
    _ = (4 * m : ℝ) ^ 2 * phaseNormSq u := by
      dsimp [R]
      rw [phaseNormSq_eq_norm_sq]
      ring

lemma reflectedAffineCross_re_lower_of_smooth_spread
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (rho : ℝ) (hrho : rho = min (K / n) (lam / n)) (hrhoPos : 0 < rho)
    (u : PhaseCoordinate m) (a b : ReflectedMode m) (hab : a ≠ b) :
    -(6 / (4 * rho)) *
        (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) *
        (‖reflectedPositionCoeff u b‖ + ‖reflectedVelocityCoeff u b‖) ≤
      (centeredAffineCrossMoment n
        (reflectedModeTime points b) (reflectedModeTime points a)
        (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
        (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re := by
  let z : ℂ := centeredAffineCrossMoment n
    (reflectedModeTime points b) (reflectedModeTime points a)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)
  have hM : 0 ≤ 6 / (4 * rho) := by positivity
  have hmom : ∀ k : Fin 3,
      ‖centeredWaveMoment n k
        (reflectedModeTime points a - reflectedModeTime points b)‖ ≤
          6 / (4 * rho) := by
    intro k
    rw [hrho]
    exact norm_centeredWaveMoment_reflected_sub_le_of_smooth_spread
      n k hn (by omega) K lam points hsmooth hspread a b hab
      (by simpa [← hrho] using hrhoPos)
  have hnorm : ‖z‖ ≤
      (6 / (4 * rho)) *
        (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) *
        (‖reflectedPositionCoeff u b‖ + ‖reflectedVelocityCoeff u b‖) := by
    exact norm_centeredAffineCrossMoment_le n
      (reflectedModeTime points b) (reflectedModeTime points a)
      (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
      (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)
      (6 / (4 * rho)) hM hmom
  have hre : -‖z‖ ≤ z.re :=
    (abs_le.mp (Complex.abs_re_le_norm z)).1
  calc
    -(6 / (4 * rho)) *
          (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) *
          (‖reflectedPositionCoeff u b‖ + ‖reflectedVelocityCoeff u b‖) =
        -((6 / (4 * rho)) *
          (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) *
          (‖reflectedPositionCoeff u b‖ + ‖reflectedVelocityCoeff u b‖)) := by ring
    _ ≤ -‖z‖ := neg_le_neg hnorm
    _ ≤ z.re := hre

lemma phaseVelocityCoeff_normSq_le_phaseNormSq
    (u : PhaseCoordinate m) (r : Fin m) :
    Complex.normSq (phaseVelocityCoeff u r) ≤ phaseNormSq u := by
  rw [← phaseCoeff_energy u]
  calc
    Complex.normSq (phaseVelocityCoeff u r) ≤
        Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r) :=
      le_add_of_nonneg_left (Complex.normSq_nonneg _)
    _ ≤ ∑ s : Fin m,
        (Complex.normSq (phasePositionCoeff u s) +
          Complex.normSq (phaseVelocityCoeff u s)) := by
      exact Finset.single_le_sum
        (f := fun s : Fin m ↦
          Complex.normSq (phasePositionCoeff u s) +
            Complex.normSq (phaseVelocityCoeff u s)) (s := Finset.univ)
        (fun s _hs ↦ add_nonneg (Complex.normSq_nonneg _)
          (Complex.normSq_nonneg _)) (Finset.mem_univ r)

lemma phasePositionCoeff_normSq_le_phaseNormSq
    (u : PhaseCoordinate m) (r : Fin m) :
    Complex.normSq (phasePositionCoeff u r) ≤ phaseNormSq u := by
  rw [← phaseCoeff_energy u]
  calc
    Complex.normSq (phasePositionCoeff u r) ≤
        Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r) :=
      le_add_of_nonneg_right (Complex.normSq_nonneg _)
    _ ≤ ∑ s : Fin m,
        (Complex.normSq (phasePositionCoeff u s) +
          Complex.normSq (phaseVelocityCoeff u s)) := by
      exact Finset.single_le_sum
        (f := fun s : Fin m ↦
          Complex.normSq (phasePositionCoeff u s) +
            Complex.normSq (phaseVelocityCoeff u s)) (s := Finset.univ)
        (fun s _hs ↦ add_nonneg (Complex.normSq_nonneg _)
          (Complex.normSq_nonneg _)) (Finset.mem_univ r)

lemma phaseCoordinate_sq_le_phaseNormSq
    (u : PhaseCoordinate m) (r : Fin m) (c : Fin 4) :
    (u r c) ^ 2 ≤ phaseNormSq u := by
  unfold phaseNormSq
  have hinner : (u r c) ^ 2 ≤ ∑ d : Fin 4, (u r d) ^ 2 := by
    exact Finset.single_le_sum (s := Finset.univ)
      (fun d _hd ↦ sq_nonneg (u r d)) (Finset.mem_univ c)
  have houter : (∑ d : Fin 4, (u r d) ^ 2) ≤
      ∑ s : Fin m, ∑ d : Fin 4, (u s d) ^ 2 := by
    exact Finset.single_le_sum (s := Finset.univ)
      (fun s _hs ↦ Finset.sum_nonneg fun d _hd ↦ sq_nonneg (u s d))
      (Finset.mem_univ r)
  exact hinner.trans houter

lemma phaseL1_le_of_phaseNormSq_eq_one
    (u : PhaseCoordinate m) (hu : phaseNormSq u = 1) :
    (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤ 4 * m := by
  have hcoord : ∀ r : Fin m, ∀ c : Fin 4, |u r c| ≤ 1 := by
    intro r c
    have hsquare := phaseCoordinate_sq_le_phaseNormSq u r c
    rw [hu] at hsquare
    nlinarith [sq_abs (u r c), abs_nonneg (u r c)]
  calc
    (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤
        ∑ _r : Fin m, ∑ _c : Fin 4, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro r _hr
      apply Finset.sum_le_sum
      intro c _hc
      exact hcoord r c
    _ = 4 * m := by simp [mul_comm]

/-- Some sample point carries at least the average amount of the total
phase-space energy.  This elementary pigeonhole step is the starting point
of the twisted-difference covariance argument. -/
lemma exists_phaseCoeff_energy_ge_average (hm : 0 < m)
    (u : PhaseCoordinate m) :
    ∃ r : Fin m, phaseNormSq u / m ≤
      Complex.normSq (phasePositionCoeff u r) +
        Complex.normSq (phaseVelocityCoeff u r) := by
  by_contra h
  push_neg at h
  have hsum :
      ∑ r : Fin m,
          (Complex.normSq (phasePositionCoeff u r) +
            Complex.normSq (phaseVelocityCoeff u r)) <
        ∑ _r : Fin m, phaseNormSq u / m := by
    simpa only using Finset.sum_lt_sum_of_nonempty
      (s := Finset.univ) ⟨⟨0, hm⟩, Finset.mem_univ _⟩ fun r _ ↦ h r
  rw [phaseCoeff_energy] at hsum
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul] at hsum
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  field_simp [hm0] at hsum
  exact (lt_irrefl _ hsum)

/-- For a unit phase direction, either its position coefficient or its
velocity coefficient is quantitatively nonzero at one sample point. -/
lemma exists_large_phaseCoeff (hm : 0 < m) (u : PhaseCoordinate m)
    (hu : phaseNormSq u = 1) :
    ∃ r : Fin m,
      1 / (2 * m : ℝ) ≤ Complex.normSq (phasePositionCoeff u r) ∨
      1 / (2 * m : ℝ) ≤ Complex.normSq (phaseVelocityCoeff u r) := by
  rcases exists_phaseCoeff_energy_ge_average hm u with ⟨r, hr⟩
  refine ⟨r, ?_⟩
  rw [hu] at hr
  by_contra h
  push_neg at h
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hsum :
      Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r) < 1 / (m : ℝ) := by
    calc
      Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r) <
          1 / (2 * m : ℝ) + 1 / (2 * m : ℝ) := add_lt_add h.1 h.2
      _ = 1 / (m : ℝ) := by field_simp; ring
  exact (not_lt_of_ge hr) hsum

/-- Unnormalized coefficient pigeonhole: one sample carries at least half
the average position or velocity energy. -/
lemma exists_large_phaseCoeff_general (hm : 0 < m)
    (u : PhaseCoordinate m) :
    ∃ r : Fin m,
      phaseNormSq u / (2 * m : ℝ) ≤
          Complex.normSq (phasePositionCoeff u r) ∨
      phaseNormSq u / (2 * m : ℝ) ≤
          Complex.normSq (phaseVelocityCoeff u r) := by
  rcases exists_phaseCoeff_energy_ge_average hm u with ⟨r, hr⟩
  refine ⟨r, ?_⟩
  by_contra h
  push Not at h
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hsum :
      Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r) <
        phaseNormSq u / (m : ℝ) := by
    calc
      Complex.normSq (phasePositionCoeff u r) +
          Complex.normSq (phaseVelocityCoeff u r) <
          phaseNormSq u / (2 * m : ℝ) +
            phaseNormSq u / (2 * m : ℝ) := add_lt_add h.1 h.2
      _ = phaseNormSq u / (m : ℝ) := by field_simp; ring
  exact (not_lt_of_ge hr) hsum

lemma norm_reflectedPositionCoeff_true_sq
    (u : PhaseCoordinate m) (r : Fin m) :
    ‖reflectedPositionCoeff u (r, true)‖ ^ 2 =
      Complex.normSq (phasePositionCoeff u r) / 4 := by
  rw [Complex.sq_norm]
  simp [reflectedPositionCoeff, Complex.normSq_apply,
    Complex.div_re, Complex.div_im]
  ring

lemma norm_reflectedVelocityCoeff_true_sq
    (u : PhaseCoordinate m) (r : Fin m) :
    ‖reflectedVelocityCoeff u (r, true)‖ ^ 2 =
      Complex.normSq (phaseVelocityCoeff u r) / 4 := by
  rw [Complex.sq_norm]
  simp [reflectedVelocityCoeff, Complex.normSq_apply,
    Complex.div_re, Complex.div_im]
  ring

lemma norm_reflectedVelocityCoeff_true_le_half_of_phaseNormSq_eq_one
    (u : PhaseCoordinate m) (hu : phaseNormSq u = 1) (r : Fin m) :
    ‖reflectedVelocityCoeff u (r, true)‖ ≤ 1 / 2 := by
  have hvel := phaseVelocityCoeff_normSq_le_phaseNormSq u r
  rw [hu] at hvel
  have href := norm_reflectedVelocityCoeff_true_sq u r
  have hsq : ‖reflectedVelocityCoeff u (r, true)‖ ^ 2 ≤ (1 / 2 : ℝ) ^ 2 := by
    rw [href]
    nlinarith
  nlinarith [norm_nonneg (reflectedVelocityCoeff u (r, true))]

lemma sqrt_one_div_eight_mul_le_reflectedPositionCoeff_true
    (hm : 0 < m) (u : PhaseCoordinate m) (hu : phaseNormSq u = 1)
    (r : Fin m)
    (hlarge : phaseNormSq u / (2 * m : ℝ) ≤
      Complex.normSq (phasePositionCoeff u r)) :
    Real.sqrt (1 / (8 * (m : ℝ))) ≤
      ‖reflectedPositionCoeff u (r, true)‖ := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hx : 0 ≤ 1 / (8 * (m : ℝ)) := by positivity
  have href := norm_reflectedPositionCoeff_true_sq u r
  have hsq : 1 / (8 * (m : ℝ)) ≤
      ‖reflectedPositionCoeff u (r, true)‖ ^ 2 := by
    rw [href]
    rw [hu] at hlarge
    calc
      1 / (8 * (m : ℝ)) = (1 / (2 * (m : ℝ))) / 4 := by ring
      _ ≤ Complex.normSq (phasePositionCoeff u r) / 4 := by gcongr
  have hsqrt := Real.sq_sqrt hx
  nlinarith [Real.sqrt_nonneg (1 / (8 * (m : ℝ))),
    norm_nonneg (reflectedPositionCoeff u (r, true))]

lemma phaseProjection_eq_re_complexPhaseProjection
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (j : Fin (2 * n + 1)) :
    phaseProjection n points u j =
      (complexPhaseProjection n points u (centeredIndex n j)).re := by
  unfold phaseProjection phaseStep complexPhaseProjection phasePositionCoeff
    phaseVelocityCoeff
  rw [complex_re_sum]
  apply Finset.sum_congr rfl
  intro r _
  rw [Fin.sum_univ_four]
  simp [centeredIndex_cast, weightedComplexWave, Complex.mul_re, Complex.mul_im]
  ring

lemma ofReal_phaseProjection_eq_realComplexPhaseProjection
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (j : Fin (2 * n + 1)) :
    (phaseProjection n points u j : ℂ) =
      realComplexPhaseProjection n points u (centeredIndex n j) := by
  rw [realComplexPhaseProjection_eq_re,
    phaseProjection_eq_re_complexPhaseProjection]

/-- The real scalar phase sequence whose quotient-lattice energy is exactly
`phaseLatticeEnergy`.  It is defined on all integer indices so ordinary
differences can be taken without dependent-index bookkeeping. -/
noncomputable def scaledRealPhaseProjection
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ)
    (j : ℤ) : ℝ :=
  t * (realComplexPhaseProjection n points u j).re / Real.pi

lemma scaledRealPhaseProjection_centeredIndex
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ)
    (j : Fin (2 * n + 1)) :
    scaledRealPhaseProjection n points u t (centeredIndex n j) =
      t * phaseProjection n points u j / Real.pi := by
  unfold scaledRealPhaseProjection
  rw [← ofReal_phaseProjection_eq_realComplexPhaseProjection]
  simp

lemma exists_scaledPhase_good_block
    (n W : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t a : ℝ) (hW : 0 < W)
    (hfit : W * ((phaseBadIndices n points u t a).card + 1) ≤
      2 * n + 1) :
    ∃ s : ℕ, s + W ≤ 2 * n + 1 ∧
      ∀ r : ℕ, r < W →
        |centeredModOne
          (scaledRealPhaseProjection n points u t
            (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a := by
  rcases exists_phase_good_block n W points u t a hW hfit with
    ⟨s, hs, hgood⟩
  refine ⟨s, hs, ?_⟩
  intro r hr
  have hsr : s + r < 2 * n + 1 :=
    lt_of_lt_of_le (Nat.add_lt_add_left hr s) hs
  let j : Fin (2 * n + 1) := ⟨s + r, hsr⟩
  have hindex : centeredIndex n j = ((s + r : ℕ) : ℤ) - n := by
    simp [centeredIndex, j]
  rw [← hindex, scaledRealPhaseProjection_centeredIndex]
  change distanceToInteger
      (t * phaseProjection n points u j / Real.pi) ≤ a
  exact hgood r hr j rfl

/-- Quantitative energy-to-block conversion.  Markov's inequality bounds
the number of residues larger than `a`; the displayed real inequality then
guarantees enough room for a consecutive block of length `W`. -/
lemma exists_scaledPhase_good_block_of_energy_le
    (n W : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t a E : ℝ) (hW : 0 < W) (ha : 0 < a)
    (henergy : phaseLatticeEnergy n points u t ≤ E)
    (hfit : (W : ℝ) * (E / a ^ 2 + 1) ≤ 2 * n + 1) :
    ∃ s : ℕ, s + W ≤ 2 * n + 1 ∧
      ∀ r : ℕ, r < W →
        |centeredModOne
          (scaledRealPhaseProjection n points u t
            (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a := by
  let bad := phaseBadIndices n points u t a
  have hmarkov := phaseBadIndices_card_mul_le_latticeEnergy
    n points u t a ha.le
  have hcard : (bad.card : ℝ) ≤ E / a ^ 2 := by
    apply (le_div_iff₀ (sq_pos_of_pos ha)).2
    exact hmarkov.trans henergy
  have hfitReal : ((W * (bad.card + 1) : ℕ) : ℝ) ≤
      ((2 * n + 1 : ℕ) : ℝ) := by
    push_cast
    calc
      (W : ℝ) * ((bad.card : ℝ) + 1) ≤
          (W : ℝ) * (E / a ^ 2 + 1) := by gcongr
      _ ≤ 2 * (n : ℝ) + 1 := hfit
  have hfitNat : W * (bad.card + 1) ≤ 2 * n + 1 := by
    exact_mod_cast hfitReal
  simpa [bad] using exists_scaledPhase_good_block
    n W points u t a hW hfitNat

/-- The squared centered residues on any consecutive block of phase indices
are bounded by the full quotient-lattice energy. -/
lemma sum_sq_centeredScaledPhase_block_le_latticeEnergy
    (n W s : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t : ℝ) (hs : s + W ≤ 2 * n + 1) :
    ∑ r ∈ Finset.range W,
        centeredModOne
          (scaledRealPhaseProjection n points u t
            (((s + r : ℕ) : ℤ) - (n : ℤ))) ^ 2 ≤
      phaseLatticeEnergy n points u t := by
  let idx : Fin W → Fin (2 * n + 1) := fun r ↦
    ⟨s + r, by omega⟩
  have hidx : Function.Injective idx := by
    intro r v hrv
    apply Fin.ext
    have hval := congrArg Fin.val hrv
    simpa [idx] using hval
  have hterm : ∀ r : Fin W,
      centeredModOne
          (scaledRealPhaseProjection n points u t
            (((s + (r : ℕ) : ℕ) : ℤ) - (n : ℤ))) ^ 2 =
        distanceToInteger
          (t * phaseProjection n points u (idx r) / Real.pi) ^ 2 := by
    intro r
    have hcenter : centeredIndex n (idx r) =
        (((s + (r : ℕ) : ℕ) : ℤ) - (n : ℤ)) := by
      simp [centeredIndex, idx]
    have hscaled := scaledRealPhaseProjection_centeredIndex
      n points u t (idx r)
    rw [hcenter] at hscaled
    rw [← hscaled]
    simp [distanceToInteger, sq_abs]
  have hfin :
      ∑ r : Fin W,
          centeredModOne
            (scaledRealPhaseProjection n points u t
              (((s + (r : ℕ) : ℕ) : ℤ) - (n : ℤ))) ^ 2 ≤
        ∑ j : Fin (2 * n + 1),
          distanceToInteger
            (t * phaseProjection n points u j / Real.pi) ^ 2 := by
    calc
      ∑ r : Fin W,
          centeredModOne
            (scaledRealPhaseProjection n points u t
              (((s + (r : ℕ) : ℕ) : ℤ) - (n : ℤ))) ^ 2 =
          ∑ r : Fin W,
            distanceToInteger
              (t * phaseProjection n points u (idx r) / Real.pi) ^ 2 := by
        apply Finset.sum_congr rfl
        intro r _hr
        exact hterm r
      _ = ∑ j ∈ (Finset.univ : Finset (Fin W)).image idx,
          distanceToInteger
            (t * phaseProjection n points u j / Real.pi) ^ 2 := by
        rw [Finset.sum_image]
        intro r _hr v _hv hrv
        exact hidx hrv
      _ ≤ ∑ j : Fin (2 * n + 1),
          distanceToInteger
            (t * phaseProjection n points u j / Real.pi) ^ 2 := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · exact Finset.subset_univ _
        · intro j _hj _hmem
          positivity
  rw [← Fin.sum_univ_eq_sum_range] at ⊢
  simpa [phaseLatticeEnergy] using hfin

/-- On any arithmetic-progression window contained in `[-n,n]`, the
centered representatives of the scalar phase sequence have high differences
controlled by the square root of the full quotient-lattice energy. -/
lemma abs_iteratedForwardDifference_centeredPhase_le_latticeEnergy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ)
    (h j : ℤ) (k : ℕ)
    (hwindow : ∀ r : ℕ, r ≤ k →
      ∃ a : Fin (2 * n + 1),
        centeredIndex n a = j + (r : ℤ) * h) :
    |iteratedForwardDifference h k
        (fun q ↦ centeredModOne
          (scaledRealPhaseProjection n points u t q)) j| ≤
      (2 : ℝ) ^ k * Real.sqrt (phaseLatticeEnergy n points u t) := by
  apply abs_iteratedForwardDifference_le_window
  intro r hr
  rcases hwindow r hr with ⟨a, ha⟩
  rw [← ha, scaledRealPhaseProjection_centeredIndex]
  change distanceToInteger
      (t * phaseProjection n points u a / Real.pi) ≤ _
  exact distance_phaseProjection_le_sqrt_latticeEnergy n points u t a

/-- Sharp analytic upper bound for the same high difference after the scalar
Fourier dilation `t/π`. -/
lemma abs_iteratedForwardDifference_scaledRealPhaseProjection_le_l1_pow_gap
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hj : |(j : ℝ)| ≤ n)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) h - 1‖ ≤ η) :
    |iteratedForwardDifference h (2 * k)
        (scaledRealPhaseProjection n points u t) j| ≤
      (|t| / Real.pi) *
        ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
          (η ^ (2 * k) +
            2 * (k : ℝ) * |(h : ℝ)| / n * η ^ (2 * k - 1))) := by
  have hfun : scaledRealPhaseProjection n points u t =
      fun q ↦ (t / Real.pi) *
        (realComplexPhaseProjection n points u q).re := by
    funext q
    unfold scaledRealPhaseProjection
    ring
  rw [hfun, iteratedForwardDifference_const_mul, abs_mul, abs_div,
    abs_of_pos Real.pi_pos]
  exact mul_le_mul_of_nonneg_left
    (abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le_l1_pow_gap
      n hn points u h j k η hη hj hgap)
    (by positivity)

/-- Analytic upper bound for the same high difference, now after the scalar
Fourier dilation `t/π`. -/
lemma abs_iteratedForwardDifference_scaledRealPhaseProjection_le_l1
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (h j : ℤ) (k : ℕ)
