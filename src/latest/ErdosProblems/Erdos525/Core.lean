import Mathlib
import ErdosProblems.Erdos525.External.Erdos88.Concentration
import ErdosProblems.Erdos525.External.Erdos88.Fourier
import ErdosProblems.Erdos485.Dirichlet
import ErdosProblems.Erdos358

/-!
# Erdős Problem 525

For a sign vector `ε : Fin (N + 1) → Bool`, let

`F_ε(z) = ∑ j, sign (ε j) * z ^ j`.

This core module uses literal normalized counting measure on the finite sign cube.
The minimum modulus is the actual minimum on the complex unit circle.  See
`tex/525.tex` for the mathematical proof, source normalization, and the map
from the Cook--Nguyen argument to the declarations below.
-/

open scoped BigOperators Topology ComplexConjugate RealInnerProductSpace

namespace Erdos525

open Classical Filter Finset Set MeasureTheory
open Asymptotics

/-- A sign encoded by a Boolean value. -/
def sign (b : Bool) : ℝ := if b then 1 else -1

@[simp] lemma sign_false : sign false = -1 := rfl
@[simp] lemma sign_true : sign true = 1 := rfl

@[simp] lemma sign_sq (b : Bool) : sign b ^ 2 = 1 := by
  cases b <;> simp [sign]

@[simp] lemma sign_not (b : Bool) : sign (!b) = -sign b := by
  cases b <;> simp [sign]

lemma abs_sign_sub_le_two (b c : Bool) : |sign b - sign c| ≤ 2 := by
  cases b <;> cases c <;> norm_num [sign]

/-- Flip one coordinate of a Boolean cube. -/
def flipBit {I : Type*} [DecidableEq I] (i : I) (epsilon : I → Bool) : I → Bool :=
  fun j ↦ if j = i then !(epsilon j) else epsilon j

@[simp] lemma flipBit_same {I : Type*} [DecidableEq I]
    (i : I) (epsilon : I → Bool) : flipBit i epsilon i = !(epsilon i) := by
  simp [flipBit]

lemma flipBit_of_ne {I : Type*} [DecidableEq I]
    {i j : I} (hji : j ≠ i) (epsilon : I → Bool) :
    flipBit i epsilon j = epsilon j := by
  simp [flipBit, hji]

/-- Coordinate flipping is an involutive permutation of the Boolean cube. -/
def flipBitEquiv {I : Type*} [DecidableEq I] (i : I) :
    (I → Bool) ≃ (I → Bool) where
  toFun := flipBit i
  invFun := flipBit i
  left_inv epsilon := by
    ext j
    by_cases hji : j = i
    · subst j
      simp
    · simp [flipBit_of_ne hji]
  right_inv epsilon := by
    ext j
    by_cases hji : j = i
    · subst j
      simp
    · simp [flipBit_of_ne hji]

/-- Real expectation under uniform counting measure on a Boolean cube. -/
noncomputable def cubeExpectation {I : Type*} [Fintype I] [DecidableEq I]
    (X : (I → Bool) → ℝ) : ℝ :=
  (∑ epsilon, X epsilon) / Fintype.card (I → Bool)

@[simp] lemma cubeExpectation_const {I : Type*} [Fintype I] [DecidableEq I] (c : ℝ) :
    cubeExpectation (fun _ : I → Bool ↦ c) = c := by
  simp [cubeExpectation]

lemma cubeExpectation_add {I : Type*} [Fintype I] [DecidableEq I]
    (X Y : (I → Bool) → ℝ) :
    cubeExpectation (fun epsilon ↦ X epsilon + Y epsilon) =
      cubeExpectation X + cubeExpectation Y := by
  simp [cubeExpectation, Finset.sum_add_distrib, add_div]

lemma cubeExpectation_neg {I : Type*} [Fintype I] [DecidableEq I]
    (X : (I → Bool) → ℝ) :
    cubeExpectation (fun epsilon ↦ -X epsilon) = -cubeExpectation X := by
  unfold cubeExpectation
  rw [Finset.sum_neg_distrib]
  ring

lemma cubeExpectation_const_mul {I : Type*} [Fintype I] [DecidableEq I]
    (c : ℝ) (X : (I → Bool) → ℝ) :
    cubeExpectation (fun epsilon ↦ c * X epsilon) = c * cubeExpectation X := by
  unfold cubeExpectation
  rw [← Finset.mul_sum]
  ring

lemma cubeExpectation_sum {I J : Type*} [Fintype I] [DecidableEq I] [Fintype J]
    (X : J → (I → Bool) → ℝ) :
    cubeExpectation (fun epsilon ↦ ∑ j, X j epsilon) =
      ∑ j, cubeExpectation (X j) := by
  unfold cubeExpectation
  rw [Finset.sum_comm, Finset.sum_div]

lemma cubeExpectation_comp_equiv {I : Type*} [Fintype I] [DecidableEq I]
    (e : (I → Bool) ≃ (I → Bool)) (X : (I → Bool) → ℝ) :
    cubeExpectation (fun epsilon ↦ X (e epsilon)) = cubeExpectation X := by
  simp only [cubeExpectation, e.sum_comp]

lemma cubeExpectation_sign {I : Type*} [Fintype I] [DecidableEq I] (i : I) :
    cubeExpectation (fun epsilon : I → Bool ↦ sign (epsilon i)) = 0 := by
  let X : (I → Bool) → ℝ := fun epsilon ↦ sign (epsilon i)
  have hinv := cubeExpectation_comp_equiv (flipBitEquiv i) X
  have hneg : cubeExpectation (fun epsilon ↦ X (flipBitEquiv i epsilon)) =
      -cubeExpectation X := by
    rw [← cubeExpectation_neg X]
    apply congrArg cubeExpectation
    funext epsilon
    simp [X, flipBitEquiv]
  rw [hneg] at hinv
  change cubeExpectation X = 0
  linarith

lemma cubeExpectation_sign_mul_sign {I : Type*} [Fintype I] [DecidableEq I] (i j : I) :
    cubeExpectation (fun epsilon : I → Bool ↦ sign (epsilon i) * sign (epsilon j)) =
      if i = j then 1 else 0 := by
  by_cases hij : i = j
  · subst j
    rw [show (fun epsilon : I → Bool ↦ sign (epsilon i) * sign (epsilon i)) =
        (fun _ ↦ 1) by
      funext epsilon
      rw [← pow_two, sign_sq]]
    simpa using cubeExpectation_const (I := I) 1
  · let X : (I → Bool) → ℝ :=
      fun epsilon ↦ sign (epsilon i) * sign (epsilon j)
    have hinv := cubeExpectation_comp_equiv (flipBitEquiv i) X
    have hneg : cubeExpectation (fun epsilon ↦ X (flipBitEquiv i epsilon)) =
        -cubeExpectation X := by
      rw [← cubeExpectation_neg X]
      apply congrArg cubeExpectation
      funext epsilon
      simp [X, flipBitEquiv, flipBit_of_ne (Ne.symm hij)]
    rw [hneg] at hinv
    simp [hij]
    linarith

lemma cubeExpectation_rademacher_linear {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) :
    cubeExpectation (fun epsilon : I → Bool ↦ ∑ i, a i * sign (epsilon i)) = 0 := by
  rw [cubeExpectation_sum]
  simp_rw [cubeExpectation_const_mul, cubeExpectation_sign, mul_zero]
  simp

/-- Exact covariance identity for a linear form in independent Rademacher
coordinates. -/
lemma cubeExpectation_rademacher_linear_sq {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℝ) :
    cubeExpectation
        (fun epsilon : I → Bool ↦ (∑ i, a i * sign (epsilon i)) ^ 2) =
      ∑ i, (a i) ^ 2 := by
  classical
  have hsquare :
      (fun epsilon : I → Bool ↦ (∑ i, a i * sign (epsilon i)) ^ 2) =
        (fun epsilon ↦ ∑ i, ∑ j,
          (a i * a j) * (sign (epsilon i) * sign (epsilon j))) := by
    funext epsilon
    rw [pow_two, Finset.sum_mul]
    simp_rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [hsquare, cubeExpectation_sum]
  simp_rw [cubeExpectation_sum, cubeExpectation_const_mul,
    cubeExpectation_sign_mul_sign]
  simp [pow_two]

lemma rademacherLinear_boundedDifference {d : ℕ} (a : Fin d → ℝ)
    (i : Fin d) (x y : Fin d → Bool)
    (hxy : ∀ j, j ≠ i → x j = y j) :
    |∑ j, a j * sign (x j) - ∑ j, a j * sign (y j)| ≤ 2 * |a i| := by
  have hsum :
      ∑ j, a j * sign (x j) - ∑ j, a j * sign (y j) =
        a i * (sign (x i) - sign (y i)) := by
    rw [← Finset.sum_sub_distrib]
    calc
      ∑ j, (a j * sign (x j) - a j * sign (y j)) =
          ∑ j, a j * (sign (x j) - sign (y j)) := by
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = a i * (sign (x i) - sign (y i)) := by
        apply Finset.sum_eq_single i
        · intro j _ hji
          rw [hxy j hji]
          simp
        · simp
  rw [hsum, abs_mul]
  nlinarith [abs_sign_sub_le_two (x i) (y i), abs_nonneg (a i)]

/-- Coefficient choices for a polynomial of degree at most `N`. -/
abbrev SignVector (N : ℕ) := Fin (N + 1) → Bool

/-- The real frequency corresponding to the coefficient indexed by `j` in
the symmetric degree-`2 * n` model. -/
def centeredFrequency (n : ℕ) (j : Fin (2 * n + 1)) : ℝ :=
  (j : ℝ) - n

/-- Evaluation of the Littlewood polynomial encoded by `ε`. -/
def littlewoodEval {N : ℕ} (ε : SignVector N) (z : ℂ) : ℂ :=
  ∑ j, (sign (ε j) : ℂ) * z ^ (j : ℕ)

lemma continuous_littlewoodEval {N : ℕ} (ε : SignVector N) :
    Continuous (littlewoodEval ε) := by
  unfold littlewoodEval
  fun_prop

/-- The complex unit circle, as a set. -/
def unitCircle : Set ℂ := Metric.sphere 0 1

lemma unitCircle_nonempty : unitCircle.Nonempty := by
  refine ⟨1, ?_⟩
  simp [unitCircle]

lemma unitCircle_compact : IsCompact unitCircle := by
  simpa [unitCircle] using (isCompact_sphere (0 : ℂ) 1)

/-- The set of modulus values attained by `F_ε` on the unit circle. -/
def modulusRange {N : ℕ} (ε : SignVector N) : Set ℝ :=
  (fun z : ℂ ↦ ‖littlewoodEval ε z‖) '' unitCircle

lemma modulusRange_nonempty {N : ℕ} (ε : SignVector N) :
    (modulusRange ε).Nonempty :=
  unitCircle_nonempty.image _

lemma modulusRange_compact {N : ℕ} (ε : SignVector N) :
    IsCompact (modulusRange ε) := by
  exact unitCircle_compact.image_of_continuousOn
    (continuous_littlewoodEval ε).norm.continuousOn

/-- The minimum of `|F_ε|` on the complex unit circle. -/
noncomputable def minModulus {N : ℕ} (ε : SignVector N) : ℝ :=
  sInf (modulusRange ε)

lemma minModulus_mem_modulusRange {N : ℕ} (ε : SignVector N) :
    minModulus ε ∈ modulusRange ε := by
  exact (modulusRange_compact ε).sInf_mem (modulusRange_nonempty ε)

lemma exists_unitCircle_norm_eq_minModulus {N : ℕ} (ε : SignVector N) :
    ∃ z : ℂ, z ∈ unitCircle ∧ ‖littlewoodEval ε z‖ = minModulus ε := by
  rcases minModulus_mem_modulusRange ε with ⟨z, hz, hval⟩
  exact ⟨z, hz, hval⟩

lemma minModulus_le {N : ℕ} (ε : SignVector N) {z : ℂ}
    (hz : z ∈ unitCircle) : minModulus ε ≤ ‖littlewoodEval ε z‖ := by
  exact csInf_le (modulusRange_compact ε).bddBelow ⟨z, hz, rfl⟩

lemma minModulus_nonneg {N : ℕ} (ε : SignVector N) : 0 ≤ minModulus ε := by
  rcases exists_unitCircle_norm_eq_minModulus ε with ⟨z, -, hz⟩
  rw [← hz]
  positivity

lemma minModulus_lt_iff {N : ℕ} (ε : SignVector N) (a : ℝ) :
    minModulus ε < a ↔
      ∃ z : ℂ, ‖z‖ = 1 ∧ ‖littlewoodEval ε z‖ < a := by
  constructor
  · intro h
    rcases exists_unitCircle_norm_eq_minModulus ε with ⟨z, hz, hval⟩
    refine ⟨z, ?_, ?_⟩
    · simpa [unitCircle, Metric.mem_sphere] using hz
    · simpa [hval] using h
  · rintro ⟨z, hz, hval⟩
    exact (minModulus_le ε (by simpa [unitCircle, Metric.mem_sphere] using hz)).trans_lt hval

/-- Uniform probability on a nonempty finite type, as normalized cardinality. -/
noncomputable def uniformProbability {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P : Ω → Prop) : ℝ :=
  ((Finset.univ.filter P).card : ℝ) / Fintype.card Ω

/-- Expectation under normalized counting measure on an arbitrary nonempty
finite type. -/
noncomputable def uniformExpectation {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (X : Ω → ℝ) : ℝ :=
  (∑ ω, X ω) / Fintype.card Ω

lemma uniformExpectation_sum {Ω I : Type*} [Fintype Ω] [Nonempty Ω]
    [Fintype I] (X : I → Ω → ℝ) :
    uniformExpectation (fun ω ↦ ∑ i, X i ω) =
      ∑ i, uniformExpectation (X i) := by
  unfold uniformExpectation
  rw [Finset.sum_comm, Finset.sum_div]

lemma uniformExpectation_finset_sum {Ω I : Type*} [Fintype Ω] [Nonempty Ω]
    (s : Finset I) (X : I → Ω → ℝ) :
    uniformExpectation (fun ω ↦ ∑ i ∈ s, X i ω) =
      ∑ i ∈ s, uniformExpectation (X i) := by
  unfold uniformExpectation
  rw [Finset.sum_comm]
  simp_rw [Finset.sum_div]

lemma uniformExpectation_mono {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    {X Y : Ω → ℝ} (h : ∀ ω, X ω ≤ Y ω) :
    uniformExpectation X ≤ uniformExpectation Y := by
  unfold uniformExpectation
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact Finset.sum_le_sum fun ω _ ↦ h ω

lemma uniformExpectation_const_mul {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (c : ℝ) (X : Ω → ℝ) :
    uniformExpectation (fun ω ↦ c * X ω) = c * uniformExpectation X := by
  unfold uniformExpectation
  rw [← Finset.mul_sum]
  ring

lemma uniformExpectation_indicator {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P : Ω → Prop) :
    uniformExpectation (fun ω ↦ if P ω then 1 else 0) =
      uniformProbability P := by
  unfold uniformExpectation uniformProbability
  congr 1
  simp

/-- The `K`th inclusion--exclusion polynomial evaluated at a count `x`. -/
noncomputable def voidBonferroni (K x : ℕ) : ℝ :=
  ∑ k ∈ Finset.range (K + 1), (-1 : ℝ) ^ k * (x.choose k : ℝ)

@[simp] lemma voidBonferroni_zero (K : ℕ) : voidBonferroni K 0 = 1 := by
  unfold voidBonferroni
  rw [Finset.sum_eq_single 0]
  · norm_num
  · intro k hk hk0
    have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
    rw [Nat.choose_eq_zero_of_lt hkpos]
    simp
  · simp

lemma voidBonferroni_of_pos {K x : ℕ} (hx : 0 < x) :
    voidBonferroni K x =
      (-1 : ℝ) ^ K * ((x - 1).choose K : ℝ) := by
  have hInt := Int.alternating_sum_range_choose_eq_choose
    (n := x - 1) (m := K)
  have hsucc : x - 1 + 1 = x := Nat.sub_add_cancel hx
  rw [hsucc] at hInt
  unfold voidBonferroni
  exact_mod_cast hInt

lemma voidBonferroni_lower_of_odd {K x : ℕ} (hK : Odd K) :
    voidBonferroni K x ≤ if x = 0 then 1 else 0 := by
  by_cases hx : x = 0
  · subst x
    simp
  · rw [if_neg hx, voidBonferroni_of_pos (Nat.pos_of_ne_zero hx)]
    rw [Odd.neg_one_pow hK]
    rw [neg_one_mul]
    have hnonneg : (0 : ℝ) ≤ ((x - 1).choose K : ℝ) := Nat.cast_nonneg _
    exact neg_nonpos.mpr hnonneg

lemma voidBonferroni_upper_of_even {K x : ℕ} (hK : Even K) :
    (if x = 0 then 1 else 0 : ℝ) ≤ voidBonferroni K x := by
  by_cases hx : x = 0
  · subst x
    simp
  · rw [if_neg hx, voidBonferroni_of_pos (Nat.pos_of_ne_zero hx)]
    rw [Even.neg_one_pow hK]
    positivity

/-- Binomial (equivalently, normalized factorial) moment of a finite random
count. -/
noncomputable def uniformChooseMoment {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (X : Ω → ℕ) (k : ℕ) : ℝ :=
  uniformExpectation (fun ω ↦ (Nat.choose (X ω) k : ℝ))

lemma uniformExpectation_voidBonferroni {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (X : Ω → ℕ) (K : ℕ) :
    uniformExpectation (fun ω ↦ voidBonferroni K (X ω)) =
      ∑ k ∈ Finset.range (K + 1),
        (-1 : ℝ) ^ k * uniformChooseMoment X k := by
  simp_rw [voidBonferroni]
  rw [uniformExpectation_finset_sum]
  apply Finset.sum_congr rfl
  intro k _
  rw [uniformExpectation_const_mul]
  rfl

lemma uniformVoidProbability_ge_bonferroni_odd
    {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (X : Ω → ℕ) {K : ℕ} (hK : Odd K) :
    uniformExpectation (fun ω ↦ voidBonferroni K (X ω)) ≤
      uniformProbability (fun ω ↦ X ω = 0) := by
  rw [← uniformExpectation_indicator]
  exact uniformExpectation_mono fun ω ↦ by
    by_cases hω : X ω = 0
    · simp [hω]
    · simpa [hω] using
        (voidBonferroni_lower_of_odd (K := K) (x := X ω) hK)

lemma uniformVoidProbability_le_bonferroni_even
    {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (X : Ω → ℕ) {K : ℕ} (hK : Even K) :
    uniformProbability (fun ω ↦ X ω = 0) ≤
      uniformExpectation (fun ω ↦ voidBonferroni K (X ω)) := by
  rw [← uniformExpectation_indicator]
  exact uniformExpectation_mono fun ω ↦ by
    by_cases hω : X ω = 0
    · simp [hω]
    · simpa [hω] using
        (voidBonferroni_upper_of_even (K := K) (x := X ω) hK)

/-- Partial exponential series in the normalization naturally produced by
binomial moments. -/
noncomputable def poissonVoidPartial (K : ℕ) (lam : ℝ) : ℝ :=
  ∑ k ∈ Finset.range (K + 1), (-1 : ℝ) ^ k * (lam ^ k / k.factorial)

lemma poissonVoidPartial_tendsto (lam : ℝ) :
    Tendsto (fun K ↦ poissonVoidPartial K lam) atTop
      (𝓝 (Real.exp (-lam))) := by
  have h := (NormedSpace.expSeries_div_hasSum_exp (-lam : ℝ)).tendsto_sum_nat
  rw [← Real.exp_eq_exp_ℝ] at h
  convert h.comp (tendsto_add_atTop_nat 1) using 1
  · funext K
    unfold poissonVoidPartial
    simp only [Function.comp_apply]
    apply Finset.sum_congr rfl
    intro k _
    rw [neg_pow]
    ring

lemma uniformExpectation_voidBonferroni_tendsto
    (d : ℕ → ℕ) (X : ∀ n, SignVector (d n) → ℕ) (lam : ℝ)
    (hmom : ∀ k : ℕ,
      Tendsto (fun n ↦ uniformChooseMoment (X n) k) atTop
        (𝓝 (lam ^ k / k.factorial))) (K : ℕ) :
    Tendsto
      (fun n ↦ uniformExpectation (fun ω ↦ voidBonferroni K (X n ω)))
      atTop (𝓝 (poissonVoidPartial K lam)) := by
  have heq :
      (fun n ↦ uniformExpectation (fun ω ↦ voidBonferroni K (X n ω))) =
        (fun n ↦ ∑ k ∈ Finset.range (K + 1),
          (-1 : ℝ) ^ k * uniformChooseMoment (X n) k) := by
    funext n
    exact uniformExpectation_voidBonferroni (X n) K
  rw [heq]
  unfold poissonVoidPartial
  apply tendsto_finset_sum
  intro k _
  exact (hmom k).const_mul ((-1 : ℝ) ^ k)

/-- Bonferroni's inequalities turn convergence of every binomial moment into
convergence of the void probability.  No separate uniform-integrability
hypothesis is needed for this single atom. -/
theorem uniformVoidProbability_tendsto_of_chooseMoments
    (d : ℕ → ℕ) (X : ∀ n, SignVector (d n) → ℕ)
    (lam : ℝ)
    (hmom : ∀ k : ℕ,
      Tendsto (fun n ↦ uniformChooseMoment (X n) k) atTop
        (𝓝 (lam ^ k / k.factorial))) :
    Tendsto
      (fun n ↦ uniformProbability (fun ω ↦ X n ω = 0))
      atTop (𝓝 (Real.exp (-lam))) := by
  have hevenIndex : Tendsto (fun q : ℕ ↦ 2 * q) atTop atTop :=
    tendsto_atTop_mono (fun q : ℕ ↦ by
      show q ≤ 2 * q
      omega) (tendsto_id : Tendsto (fun q : ℕ ↦ q) atTop atTop)
  have hoddIndex : Tendsto (fun q : ℕ ↦ 2 * q + 1) atTop atTop :=
    tendsto_atTop_mono (fun q : ℕ ↦ by
      show q ≤ 2 * q + 1
      omega) (tendsto_id : Tendsto (fun q : ℕ ↦ q) atTop atTop)
  rw [tendsto_order]
  constructor
  · intro a ha
    have hpartial := (poissonVoidPartial_tendsto lam).comp hoddIndex
    have hexists : ∃ q : ℕ, a < poissonVoidPartial (2 * q + 1) lam :=
      (hpartial.eventually (Ioi_mem_nhds ha)).exists
    rcases hexists with ⟨q, hq⟩
    let K : ℕ := 2 * q + 1
    have hKodd : Odd K := ⟨q, by simp [K, two_mul]⟩
    have hE := uniformExpectation_voidBonferroni_tendsto d X lam hmom K
    have hEa : ∀ᶠ n in atTop,
        a < uniformExpectation (fun ω ↦ voidBonferroni K (X n ω)) :=
      hE.eventually (Ioi_mem_nhds (by simpa [K] using hq))
    filter_upwards [hEa] with n hn
    exact hn.trans_le (uniformVoidProbability_ge_bonferroni_odd (X n) hKodd)
  · intro b hb
    have hpartial := (poissonVoidPartial_tendsto lam).comp hevenIndex
    have hexists : ∃ q : ℕ, poissonVoidPartial (2 * q) lam < b :=
      (hpartial.eventually (Iio_mem_nhds hb)).exists
    rcases hexists with ⟨q, hq⟩
    let K : ℕ := 2 * q
    have hKeven : Even K := ⟨q, by simp [K, two_mul]⟩
    have hE := uniformExpectation_voidBonferroni_tendsto d X lam hmom K
    have hEb : ∀ᶠ n in atTop,
        uniformExpectation (fun ω ↦ voidBonferroni K (X n ω)) < b :=
      hE.eventually (Iio_mem_nhds (by simpa [K] using hq))
    filter_upwards [hEb] with n hn
    exact (uniformVoidProbability_le_bonferroni_even (X n) hKeven).trans_lt hn

lemma uniformProbability_nonneg {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P : Ω → Prop) : 0 ≤ uniformProbability P := by
  unfold uniformProbability
  positivity

lemma uniformProbability_mono {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    {P Q : Ω → Prop} (h : ∀ ω, P ω → Q ω) :
    uniformProbability P ≤ uniformProbability Q := by
  unfold uniformProbability
  rw [div_le_div_iff_of_pos_right
    (by exact_mod_cast Fintype.card_pos : (0 : ℝ) < Fintype.card Ω)]
  exact_mod_cast Finset.card_le_card (by
    intro ω hω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω ⊢
    exact h ω hω)

lemma uniformProbability_or_le_add {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P Q : Ω → Prop) :
    uniformProbability (fun omega ↦ P omega ∨ Q omega) ≤
      uniformProbability P + uniformProbability Q := by
  classical
  unfold uniformProbability
  rw [← add_div]
  apply div_le_div_of_nonneg_right _ (by positivity)
  norm_cast
  refine (Finset.card_le_card ?_).trans
    (Finset.card_union_le (Finset.univ.filter P) (Finset.univ.filter Q))
  intro omega homega
  have hor : P omega ∨ Q omega := by simpa using homega
  rcases hor with hP | hQ
  · exact Finset.mem_union_left _ (by simp [hP])
  · exact Finset.mem_union_right _ (by simp [hQ])

lemma uniformProbability_le_one {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P : Ω → Prop) : uniformProbability P ≤ 1 := by
  unfold uniformProbability
  rw [div_le_one (by exact_mod_cast Fintype.card_pos : (0 : ℝ) < Fintype.card Ω)]
  exact_mod_cast Finset.card_le_univ (Finset.univ.filter P)

@[simp] lemma uniformProbability_true {Ω : Type*} [Fintype Ω] [Nonempty Ω] :
    uniformProbability (fun _ : Ω ↦ True) = 1 := by
  simp [uniformProbability, ne_of_gt
    (by exact_mod_cast Fintype.card_pos : (0 : ℝ) < Fintype.card Ω)]

/-- The exact finite-cube Hoeffding bound for the lower tail of a
Rademacher linear form. -/
lemma rademacherLinear_lower_tail_card (d : ℕ) (a : Fin d → ℝ)
    (t : ℝ) (ht : 0 ≤ t) :
    ((Finset.univ.filter fun epsilon : Fin d → Bool ↦
        ∑ i, a i * sign (epsilon i) ≤ -t).card : ℝ) ≤
      (2 : ℝ) ^ d *
        Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) := by
  classical
  let f : (Fin d → Bool) → ℝ :=
    fun epsilon ↦ ∑ i, a i * sign (epsilon i)
  let b : Fin d → ℝ := fun i ↦ 2 * |a i|
  have hbd : ∀ i x y, (∀ j, j ≠ i → x j = y j) → |f x - f y| ≤ b i := by
    intro i x y hxy
    exact rademacherLinear_boundedDifference a i x y hxy
  have hb : ∀ i, 0 ≤ b i := fun i ↦ mul_nonneg (by norm_num) (abs_nonneg _)
  have hmean : (∑ epsilon : Fin d → Bool, f epsilon) / (2 : ℝ) ^ d = 0 := by
    have hE := cubeExpectation_rademacher_linear a
    unfold cubeExpectation at hE
    simpa only [f, Fintype.card_fun, Fintype.card_fin, Fintype.card_bool,
      Nat.cast_pow, Nat.cast_ofNat] using hE
  have h := Erdos88.Concentration.cube_lower_tail d f b hbd hb t ht
  dsimp only at h
  rw [hmean, zero_sub] at h
  have hbsum : ∑ i, (b i) ^ 2 = 4 * ∑ i, (a i) ^ 2 := by
    simp only [b, mul_pow, sq_abs]
    rw [← Finset.mul_sum]
    norm_num
  rw [hbsum] at h
  have hexponent : -2 * t ^ 2 / (4 * ∑ i, (a i) ^ 2) =
      -t ^ 2 / (2 * ∑ i, (a i) ^ 2) := by ring
  rw [hexponent] at h
  simpa only [f] using h

lemma rademacherLinear_lower_tail (d : ℕ) (a : Fin d → ℝ)
    (t : ℝ) (ht : 0 ≤ t) :
    uniformProbability (fun epsilon : Fin d → Bool ↦
        ∑ i, a i * sign (epsilon i) ≤ -t) ≤
      Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) := by
  unfold uniformProbability
  simp only [Fintype.card_fun, Fintype.card_fin, Fintype.card_bool]
  norm_num only [Nat.cast_pow, Nat.cast_ofNat]
  rw [div_le_iff₀ (by positivity : (0 : ℝ) < 2 ^ d)]
  calc
    ((Finset.univ.filter fun epsilon : Fin d → Bool ↦
        ∑ i, a i * sign (epsilon i) ≤ -t).card : ℝ) ≤
        (2 : ℝ) ^ d * Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) :=
      rademacherLinear_lower_tail_card d a t ht
    _ = Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) * (2 : ℝ) ^ d := by ring

lemma rademacherLinear_upper_tail (d : ℕ) (a : Fin d → ℝ)
    (t : ℝ) (ht : 0 ≤ t) :
    uniformProbability (fun epsilon : Fin d → Bool ↦
        t ≤ ∑ i, a i * sign (epsilon i)) ≤
      Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) := by
  have h := rademacherLinear_lower_tail d (fun i ↦ -a i) t ht
  convert h using 1
  · apply congrArg uniformProbability
    funext epsilon
    apply propext
    simp only [neg_mul, Finset.sum_neg_distrib, neg_le_neg_iff]
  · congr 3
    apply Finset.sum_congr rfl
    intro i _
    ring

lemma rademacherLinear_abs_tail (d : ℕ) (a : Fin d → ℝ)
    (t : ℝ) (ht : 0 ≤ t) :
    uniformProbability (fun epsilon : Fin d → Bool ↦
        t ≤ |∑ i, a i * sign (epsilon i)|) ≤
      2 * Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) := by
  let X : (Fin d → Bool) → ℝ := fun epsilon ↦
    ∑ i, a i * sign (epsilon i)
  calc
    uniformProbability (fun epsilon : Fin d → Bool ↦ t ≤ |X epsilon|) ≤
        uniformProbability (fun epsilon ↦
          X epsilon ≤ -t ∨ t ≤ X epsilon) := by
      apply uniformProbability_mono
      intro epsilon hepsilon
      rcases le_abs.mp hepsilon with hright | hleft
      · exact Or.inr hright
      · exact Or.inl (by linarith)
    _ ≤ uniformProbability (fun epsilon ↦ X epsilon ≤ -t) +
        uniformProbability (fun epsilon ↦ t ≤ X epsilon) :=
      uniformProbability_or_le_add _ _
    _ ≤ Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) +
        Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) := by
      apply add_le_add
      · exact rademacherLinear_lower_tail d a t ht
      · exact rademacherLinear_upper_tail d a t ht
    _ = 2 * Real.exp (-t ^ 2 / (2 * ∑ i, (a i) ^ 2)) := by ring

@[simp] lemma card_signVector (N : ℕ) : Fintype.card (SignVector N) = 2 ^ (N + 1) := by
  simp [SignVector]

@[simp] lemma card_univ_signVector (N : ℕ) :
    (Finset.univ : Finset (SignVector N)).card = 2 ^ (N + 1) := by
  simp

/-- The tail probability at the natural `N⁻¹ᐟ²` scale. -/
noncomputable def minimumTail (N : ℕ) (τ : ℝ) : ℝ :=
  uniformProbability (fun ε : SignVector N ↦ τ / Real.sqrt N < minModulus ε)

/-- Probability of the exceptional event in the first question. -/
noncomputable def exceptionalProbability (N : ℕ) : ℝ :=
  uniformProbability (fun ε : SignVector N ↦ 1 ≤ minModulus ε)

/-- The finite exceptional family in the first question. -/
noncomputable def exceptionalFamily (N : ℕ) : Finset (SignVector N) :=
  Finset.univ.filter fun ε ↦ 1 ≤ minModulus ε

lemma exceptionalProbability_eq (N : ℕ) :
    exceptionalProbability N =
      (exceptionalFamily N).card / (2 : ℝ) ^ (N + 1) := by
  simp [exceptionalProbability, exceptionalFamily, uniformProbability]

/-- The rate after translating Cook--Nguyen's symmetric normalization to
degree-`N` Littlewood polynomials. -/
noncomputable def rate : ℝ := Real.sqrt (Real.pi / 12)

lemma rate_pos : 0 < rate := by
  exact Real.sqrt_pos.2 (div_pos Real.pi_pos (by norm_num))

/-! ## The centered normalization in the Cook--Nguyen theorem -/

/-- The centered, variance-one trigonometric polynomial associated to a
degree-`2 * n` Littlewood polynomial.  Its frequencies are `-n, ..., n`.
This is the normalization used in Cook--Nguyen. -/
noncomputable def centeredEval (n : ℕ) (ε : SignVector (2 * n)) (x : ℝ) : ℂ :=
  (Real.sqrt (2 * n + 1 : ℝ) : ℂ)⁻¹ *
    ∑ j : Fin (2 * n + 1),
      (sign (ε j) : ℂ) *
        Complex.exp ((centeredFrequency n j : ℂ) * (x : ℂ) * Complex.I)

lemma centeredEval_eq_phase_mul_littlewoodEval (n : ℕ)
    (ε : SignVector (2 * n)) (x : ℝ) :
    centeredEval n ε x =
      (Real.sqrt (2 * n + 1 : ℝ) : ℂ)⁻¹ *
        Complex.exp (((-(n : ℝ) * x : ℝ) : ℂ) * Complex.I) *
          littlewoodEval ε (Complex.exp ((x : ℂ) * Complex.I)) := by
  unfold centeredEval littlewoodEval
  rw [Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  rw [← Complex.exp_nat_mul]
  have hexp :
      Complex.exp ((centeredFrequency n j : ℂ) * (x : ℂ) * Complex.I) =
        Complex.exp (((-(n : ℝ) * x : ℝ) : ℂ) * Complex.I) *
          Complex.exp ((j : ℕ) * ((x : ℂ) * Complex.I)) := by
    rw [← Complex.exp_add]
    congr 1
    rw [centeredFrequency]
    push_cast
    ring
  rw [hexp]
  ring

lemma norm_centeredEval (n : ℕ) (ε : SignVector (2 * n)) (x : ℝ) :
    ‖centeredEval n ε x‖ =
      ‖littlewoodEval ε (Complex.exp ((x : ℂ) * Complex.I))‖ /
        Real.sqrt (2 * n + 1 : ℝ) := by
  rw [centeredEval_eq_phase_mul_littlewoodEval]
  simp only [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    Complex.norm_exp_ofReal_mul_I]
  rw [abs_of_nonneg (Real.sqrt_nonneg _)]
  ring

/-- Minimum of the centered normalized process on one full period. -/
noncomputable def centeredMin (n : ℕ) (ε : SignVector (2 * n)) : ℝ :=
  sInf ((fun x : ℝ ↦ ‖centeredEval n ε x‖) '' Set.Icc (-Real.pi) Real.pi)

lemma continuous_centeredEval (n : ℕ) (ε : SignVector (2 * n)) :
    Continuous (centeredEval n ε) := by
  unfold centeredEval
  fun_prop

lemma centeredMin_mem_range (n : ℕ) (ε : SignVector (2 * n)) :
    centeredMin n ε ∈
      (fun x : ℝ ↦ ‖centeredEval n ε x‖) '' Set.Icc (-Real.pi) Real.pi := by
  apply IsCompact.sInf_mem
  · exact isCompact_Icc.image_of_continuousOn (continuous_centeredEval n ε).norm.continuousOn
  · exact Set.Nonempty.image _ (Set.nonempty_Icc.2 (by linarith [Real.pi_pos]))

lemma centeredMin_le (n : ℕ) (ε : SignVector (2 * n)) {x : ℝ}
    (hx : x ∈ Set.Icc (-Real.pi) Real.pi) :
    centeredMin n ε ≤ ‖centeredEval n ε x‖ := by
  apply csInf_le
  · exact (isCompact_Icc.image_of_continuousOn
      (continuous_centeredEval n ε).norm.continuousOn).bddBelow
  · exact ⟨x, hx, rfl⟩

/-- Exact conversion of the source's centered minimum to the minimum modulus
of the corresponding degree-`2 * n` Littlewood polynomial. -/
lemma centeredMin_eq_minModulus_div_sqrt (n : ℕ) (ε : SignVector (2 * n)) :
    centeredMin n ε = minModulus ε / Real.sqrt (2 * n + 1 : ℝ) := by
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  apply le_antisymm
  · rcases exists_unitCircle_norm_eq_minModulus ε with ⟨z, hz, hval⟩
    have hnorm : ‖z‖ = 1 := by
      simpa [unitCircle, Metric.mem_sphere] using hz
    rcases Complex.norm_eq_one_iff'.mp hnorm with ⟨x, hx, hxz⟩
    have hxmin : centeredMin n ε ≤ ‖centeredEval n ε x‖ :=
      centeredMin_le n ε ⟨hx.1.le, hx.2⟩
    rw [norm_centeredEval, hxz, hval] at hxmin
    exact hxmin
  · rcases centeredMin_mem_range n ε with ⟨x, hx, hval⟩
    have hcircle : Complex.exp ((x : ℂ) * Complex.I) ∈ unitCircle := by
      simp [unitCircle, Complex.norm_exp_ofReal_mul_I]
    have hminimum := minModulus_le ε hcircle
    calc
      minModulus ε / Real.sqrt (2 * n + 1 : ℝ) ≤
          ‖littlewoodEval ε (Complex.exp ((x : ℂ) * Complex.I))‖ /
            Real.sqrt (2 * n + 1 : ℝ) :=
        (div_le_div_iff_of_pos_right hsqrt).2 hminimum
      _ = ‖centeredEval n ε x‖ := (norm_centeredEval n ε x).symm
      _ = centeredMin n ε := hval

/-- The analogous centered process for a degree-`2 * n + 1` polynomial.
Its `2 * n + 2` frequencies are the half-integers
`-(n + 1/2), ..., n + 1/2`. -/
noncomputable def oddCenteredEval (n : ℕ) (ε : SignVector (2 * n + 1))
    (x : ℝ) : ℂ :=
  (Real.sqrt (2 * n + 2 : ℝ) : ℂ)⁻¹ *
    ∑ j : Fin (2 * n + 2),
      (sign (ε j) : ℂ) *
        Complex.exp (((((j : ℕ) : ℝ) - (n + 1 / 2 : ℝ)) * x : ℂ) * Complex.I)

lemma oddCenteredEval_eq_phase_mul_littlewoodEval (n : ℕ)
    (ε : SignVector (2 * n + 1)) (x : ℝ) :
    oddCenteredEval n ε x =
      (Real.sqrt (2 * n + 2 : ℝ) : ℂ)⁻¹ *
        Complex.exp (((-(n + 1 / 2 : ℝ) * x : ℝ) : ℂ) * Complex.I) *
          littlewoodEval ε (Complex.exp ((x : ℂ) * Complex.I)) := by
  unfold oddCenteredEval littlewoodEval
  rw [Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  rw [← Complex.exp_nat_mul]
  have hexp :
      Complex.exp
          (((((j : ℕ) : ℝ) - (n + 1 / 2 : ℝ)) * x : ℂ) * Complex.I) =
        Complex.exp (((-(n + 1 / 2 : ℝ) * x : ℝ) : ℂ) * Complex.I) *
          Complex.exp ((j : ℕ) * ((x : ℂ) * Complex.I)) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [hexp]
  ring

lemma norm_oddCenteredEval (n : ℕ) (ε : SignVector (2 * n + 1)) (x : ℝ) :
    ‖oddCenteredEval n ε x‖ =
      ‖littlewoodEval ε (Complex.exp ((x : ℂ) * Complex.I))‖ /
        Real.sqrt (2 * n + 2 : ℝ) := by
  rw [oddCenteredEval_eq_phase_mul_littlewoodEval]
  simp only [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    Complex.norm_exp_ofReal_mul_I]
  rw [abs_of_nonneg (Real.sqrt_nonneg _)]
  ring

/-- Minimum of the odd-degree half-integer-centered process over a period. -/
noncomputable def oddCenteredMin (n : ℕ) (ε : SignVector (2 * n + 1)) : ℝ :=
  sInf ((fun x : ℝ ↦ ‖oddCenteredEval n ε x‖) '' Set.Icc (-Real.pi) Real.pi)

lemma continuous_oddCenteredEval (n : ℕ) (ε : SignVector (2 * n + 1)) :
    Continuous (oddCenteredEval n ε) := by
  unfold oddCenteredEval
  fun_prop

lemma oddCenteredMin_mem_range (n : ℕ) (ε : SignVector (2 * n + 1)) :
    oddCenteredMin n ε ∈
      (fun x : ℝ ↦ ‖oddCenteredEval n ε x‖) '' Set.Icc (-Real.pi) Real.pi := by
  apply IsCompact.sInf_mem
  · exact isCompact_Icc.image_of_continuousOn
      (continuous_oddCenteredEval n ε).norm.continuousOn
  · exact Set.Nonempty.image _ (Set.nonempty_Icc.2 (by linarith [Real.pi_pos]))

lemma oddCenteredMin_le (n : ℕ) (ε : SignVector (2 * n + 1)) {x : ℝ}
    (hx : x ∈ Set.Icc (-Real.pi) Real.pi) :
    oddCenteredMin n ε ≤ ‖oddCenteredEval n ε x‖ := by
  apply csInf_le
  · exact (isCompact_Icc.image_of_continuousOn
      (continuous_oddCenteredEval n ε).norm.continuousOn).bddBelow
  · exact ⟨x, hx, rfl⟩

lemma oddCenteredMin_eq_minModulus_div_sqrt
    (n : ℕ) (ε : SignVector (2 * n + 1)) :
    oddCenteredMin n ε = minModulus ε / Real.sqrt (2 * n + 2 : ℝ) := by
  have hsqrt : 0 < Real.sqrt (2 * n + 2 : ℝ) := by positivity
  apply le_antisymm
  · rcases exists_unitCircle_norm_eq_minModulus ε with ⟨z, hz, hval⟩
    have hnorm : ‖z‖ = 1 := by
      simpa [unitCircle, Metric.mem_sphere] using hz
    rcases Complex.norm_eq_one_iff'.mp hnorm with ⟨x, hx, hxz⟩
    have hxmin : oddCenteredMin n ε ≤ ‖oddCenteredEval n ε x‖ :=
      oddCenteredMin_le n ε ⟨hx.1.le, hx.2⟩
    rw [norm_oddCenteredEval, hxz, hval] at hxmin
    exact hxmin
  · rcases oddCenteredMin_mem_range n ε with ⟨x, hx, hval⟩
    have hcircle : Complex.exp ((x : ℂ) * Complex.I) ∈ unitCircle := by
      simp [unitCircle, Complex.norm_exp_ofReal_mul_I]
    have hminimum := minModulus_le ε hcircle
    calc
      minModulus ε / Real.sqrt (2 * n + 2 : ℝ) ≤
          ‖littlewoodEval ε (Complex.exp ((x : ℂ) * Complex.I))‖ /
            Real.sqrt (2 * n + 2 : ℝ) :=
        (div_le_div_iff_of_pos_right hsqrt).2 hminimum
      _ = ‖oddCenteredEval n ε x‖ := (norm_oddCenteredEval n ε x).symm
      _ = oddCenteredMin n ε := hval

/-- Upper tail for Cook--Nguyen's integer-frequency centered model. -/
noncomputable def centeredTail (n : ℕ) (u : ℝ) : ℝ :=
  uniformProbability
    (fun ε : SignVector (2 * n) ↦ u / (n : ℝ) < centeredMin n ε)

/-- Upper tail for the half-integer-frequency odd-degree model. -/
noncomputable def oddCenteredTail (n : ℕ) (u : ℝ) : ℝ :=
  uniformProbability
    (fun ε : SignVector (2 * n + 1) ↦
      u / (n + 1 / 2 : ℝ) < oddCenteredMin n ε)

lemma centeredTail_antitone (n : ℕ) : Antitone (centeredTail n) := by
  intro u v huv
  by_cases hn : n = 0
  · subst n
    simp [centeredTail]
  · apply uniformProbability_mono
    intro ε hε
    exact lt_of_le_of_lt
      ((div_le_div_iff_of_pos_right (by exact_mod_cast (Nat.pos_of_ne_zero hn))).2 huv) hε

lemma oddCenteredTail_antitone (n : ℕ) : Antitone (oddCenteredTail n) := by
  intro u v huv
  apply uniformProbability_mono
  intro ε hε
  exact lt_of_le_of_lt
    ((div_le_div_iff_of_pos_right (by positivity : (0 : ℝ) < n + 1 / 2)).2 huv) hε

/-- The two parity versions of the centered Cook--Nguyen limit, before the
conversion from bandwidth `n` to polynomial degree.  The analytic part below
establishes this proposition from the finite Rademacher cube. -/
def CenteredLimitingLaw : Prop :=
  (∀ u : ℝ, 0 < u →
    Tendsto (fun n : ℕ ↦ centeredTail n u) atTop
      (𝓝 (Real.exp (-2 * rate * u)))) ∧
  (∀ u : ℝ, 0 < u →
    Tendsto (fun n : ℕ ↦ oddCenteredTail n u) atTop
      (𝓝 (Real.exp (-2 * rate * u))))

/-- The source parameter corresponding exactly to the threshold
`τ / sqrt (2 * n)` for a degree-`2 * n` polynomial. -/
noncomputable def evenSourceParameter (n : ℕ) (τ : ℝ) : ℝ :=
  τ * n / (Real.sqrt (2 * n : ℝ) * Real.sqrt (2 * n + 1 : ℝ))

/-- The source parameter corresponding exactly to the threshold
`τ / sqrt (2 * n + 1)` for a degree-`2 * n + 1` polynomial. -/
noncomputable def oddSourceParameter (n : ℕ) (τ : ℝ) : ℝ :=
  τ * (n + 1 / 2 : ℝ) /
    (Real.sqrt (2 * n + 1 : ℝ) * Real.sqrt (2 * n + 2 : ℝ))

lemma minimumTail_even_eq_centeredTail (n : ℕ) (hn : 0 < n) (τ : ℝ) :
    minimumTail (2 * n) τ = centeredTail n (evenSourceParameter n τ) := by
  unfold minimumTail centeredTail
  apply congrArg uniformProbability
  funext ε
  apply propext
  rw [centeredMin_eq_minModulus_div_sqrt]
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hsqrtDegree : 0 < Real.sqrt (2 * n : ℝ) := by positivity
  have hsqrtCount : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hthreshold : evenSourceParameter n τ / (n : ℝ) =
      (τ / Real.sqrt (2 * n : ℝ)) / Real.sqrt (2 * n + 1 : ℝ) := by
    rw [evenSourceParameter]
    field_simp
  rw [hthreshold, div_lt_div_iff_of_pos_right hsqrtCount]
  norm_num

lemma minimumTail_odd_eq_oddCenteredTail (n : ℕ) (τ : ℝ) :
    minimumTail (2 * n + 1) τ = oddCenteredTail n (oddSourceParameter n τ) := by
  unfold minimumTail oddCenteredTail
  apply congrArg uniformProbability
  funext ε
  apply propext
  rw [oddCenteredMin_eq_minModulus_div_sqrt]
  have hband : (0 : ℝ) < n + 1 / 2 := by positivity
  have hsqrtDegree : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hsqrtCount : 0 < Real.sqrt (2 * n + 2 : ℝ) := by positivity
  have hthreshold : oddSourceParameter n τ / (n + 1 / 2 : ℝ) =
      (τ / Real.sqrt (2 * n + 1 : ℝ)) /
        Real.sqrt (2 * n + 2 : ℝ) := by
    rw [oddSourceParameter]
    field_simp
  rw [hthreshold, div_lt_div_iff_of_pos_right hsqrtCount]
  norm_num

lemma sourceRatio_identity {a : ℝ} (ha : 0 < a) :
    a / (Real.sqrt (2 * a) * Real.sqrt (2 * a + 1)) =
      (Real.sqrt 2 * Real.sqrt (2 + a⁻¹))⁻¹ := by
  have hsqrta : 0 < Real.sqrt a := Real.sqrt_pos.2 ha
  have hsqrt2 : 0 < Real.sqrt 2 := by positivity
  have hfirst : Real.sqrt (2 * a) = Real.sqrt 2 * Real.sqrt a := by
    rw [Real.sqrt_mul (by positivity : (0 : ℝ) ≤ 2)]
  have hfactor : 2 * a + 1 = (2 + a⁻¹) * a := by
    field_simp
  have hsecond : Real.sqrt (2 * a + 1) =
      Real.sqrt (2 + a⁻¹) * Real.sqrt a := by
    rw [hfactor, Real.sqrt_mul (by positivity : 0 ≤ 2 + a⁻¹)]
  rw [hfirst, hsecond]
  field_simp [hsqrta.ne', hsqrt2.ne']
  nlinarith [Real.sq_sqrt ha.le]

lemma sourceRatio_tendsto_half (a : ℕ → ℝ)
    (ha : Tendsto a atTop atTop) (ha0 : ∀ᶠ n in atTop, 0 < a n) :
    Tendsto
      (fun n ↦ a n / (Real.sqrt (2 * a n) * Real.sqrt (2 * a n + 1)))
      atTop (𝓝 (1 / 2 : ℝ)) := by
  have hinv : Tendsto (fun n ↦ (a n)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp ha
  have hinside : Tendsto (fun n ↦ 2 + (a n)⁻¹) atTop (𝓝 2) := by
    simpa using tendsto_const_nhds.add hinv
  have hsqrt : Tendsto (fun n ↦ Real.sqrt (2 + (a n)⁻¹)) atTop
      (𝓝 (Real.sqrt 2)) := hinside.sqrt
  have hprod : Tendsto
      (fun n ↦ Real.sqrt 2 * Real.sqrt (2 + (a n)⁻¹)) atTop
      (𝓝 (Real.sqrt 2 * Real.sqrt 2)) := tendsto_const_nhds.mul hsqrt
  have hne : Real.sqrt 2 * Real.sqrt 2 ≠ 0 := by positivity
  have hinvprod := hprod.inv₀ hne
  have hlimit : (Real.sqrt 2 * Real.sqrt 2)⁻¹ = (1 / 2 : ℝ) := by
    rw [Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  rw [hlimit] at hinvprod
  apply hinvprod.congr'
  filter_upwards [ha0] with n hn
  exact (sourceRatio_identity hn).symm

lemma evenSourceParameter_tendsto (τ : ℝ) :
    Tendsto (fun n : ℕ ↦ evenSourceParameter n τ) atTop (𝓝 (τ / 2)) := by
  have hratio := sourceRatio_tendsto_half
    (fun n : ℕ ↦ (n : ℝ)) tendsto_natCast_atTop_atTop
    (tendsto_natCast_atTop_atTop.eventually (eventually_gt_atTop (0 : ℝ)))
  have h := hratio.const_mul τ
  convert h using 1
  · funext n
    rw [evenSourceParameter]
    ring_nf
  · ring_nf

lemma oddSourceParameter_tendsto (τ : ℝ) :
    Tendsto (fun n : ℕ ↦ oddSourceParameter n τ) atTop (𝓝 (τ / 2)) := by
  let a : ℕ → ℝ := fun n ↦ (n : ℝ) + 1 / 2
  have ha : Tendsto a atTop atTop :=
    tendsto_atTop_add_const_right atTop (1 / 2 : ℝ) tendsto_natCast_atTop_atTop
  have ha0 : ∀ᶠ n in atTop, 0 < a n := Eventually.of_forall fun n ↦ by
    dsimp [a]
    positivity
  have hratio := sourceRatio_tendsto_half a ha ha0
  have h := hratio.const_mul τ
  convert h using 1
  · funext n
    rw [oddSourceParameter]
    dsimp [a]
    ring_nf
  · ring_nf

/-- A monotone-tail squeeze with a moving threshold.  This is the abstract
step needed because Cook--Nguyen state their theorem for a fixed source
parameter, while the exact degree normalization produces a convergent
sequence of parameters. -/
lemma tendsto_antitone_moving
    (T : ℕ → ℝ → ℝ) (L : ℝ → ℝ) (uSeq : ℕ → ℝ) (u : ℝ)
    (hT : ∀ n, Antitone (T n))
    (hfixed : ∀ v, 0 < v → Tendsto (fun n ↦ T n v) atTop (𝓝 (L v)))
    (hL : Continuous L) (huSeq : Tendsto uSeq atTop (𝓝 u)) (hu : 0 < u) :
    Tendsto (fun n ↦ T n (uSeq n)) atTop (𝓝 (L u)) := by
  have hdelta : Tendsto (fun k : ℕ ↦ (1 : ℝ) / (k + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  rw [tendsto_order]
  constructor
  · intro a ha
    have hplus : Tendsto (fun k : ℕ ↦ u + (1 : ℝ) / (k + 1)) atTop (𝓝 u) := by
      simpa using tendsto_const_nhds.add hdelta
    have hLplus := hL.continuousAt.tendsto.comp hplus
    have hevent : ∀ᶠ k : ℕ in atTop, a < L (u + (1 : ℝ) / (k + 1)) :=
      hLplus.eventually (Ioi_mem_nhds ha)
    rcases hevent.exists with ⟨k, hk⟩
    let v : ℝ := u + 1 / ((k : ℝ) + 1)
    have hdeltaPos : 0 < (1 : ℝ) / ((k : ℝ) + 1) := by positivity
    have huv : u < v := by dsimp [v]; linarith
    have hv : 0 < v := hu.trans huv
    have hseqLe : ∀ᶠ n in atTop, uSeq n ≤ v :=
      (huSeq.eventually (Iio_mem_nhds huv)).mono fun _ h ↦ h.le
    have htail : ∀ᶠ n in atTop, a < T n v :=
      (hfixed v hv).eventually (Ioi_mem_nhds (by simpa [v] using hk))
    filter_upwards [hseqLe, htail] with n hn hna
    exact hna.trans_le (hT n hn)
  · intro b hb
    have hminus : Tendsto (fun k : ℕ ↦ u - (1 : ℝ) / (k + 1)) atTop (𝓝 u) := by
      simpa using tendsto_const_nhds.sub hdelta
    have hLminus := hL.continuousAt.tendsto.comp hminus
    have heventL : ∀ᶠ k : ℕ in atTop, L (u - (1 : ℝ) / (k + 1)) < b :=
      hLminus.eventually (Iio_mem_nhds hb)
    have heventPos : ∀ᶠ k : ℕ in atTop, 0 < u - (1 : ℝ) / (k + 1) :=
      hminus.eventually (Ioi_mem_nhds hu)
    rcases (heventL.and heventPos).exists with ⟨k, hkL, hkPos⟩
    let v : ℝ := u - 1 / ((k : ℝ) + 1)
    have hdeltaPos : 0 < (1 : ℝ) / ((k : ℝ) + 1) := by positivity
    have hvu : v < u := by dsimp [v]; linarith
    have hv : 0 < v := by simpa [v] using hkPos
    have hseqGe : ∀ᶠ n in atTop, v ≤ uSeq n :=
      (huSeq.eventually (Ioi_mem_nhds hvu)).mono fun _ h ↦ h.le
    have htail : ∀ᶠ n in atTop, T n v < b :=
      (hfixed v hv).eventually (Iio_mem_nhds (by simpa [v] using hkL))
    filter_upwards [hseqGe, htail] with n hn hnb
    exact (hT n hn).trans_lt hnb

lemma centeredTail_moving_tendsto (hCN : CenteredLimitingLaw)
    (τ : ℝ) (hτ : 0 < τ) :
    Tendsto (fun n : ℕ ↦ centeredTail n (evenSourceParameter n τ)) atTop
      (𝓝 (Real.exp (-rate * τ))) := by
  have hmove := tendsto_antitone_moving centeredTail
    (fun u ↦ Real.exp (-2 * rate * u)) (fun n ↦ evenSourceParameter n τ) (τ / 2)
    centeredTail_antitone hCN.1 (by fun_prop) (evenSourceParameter_tendsto τ)
    (by positivity)
  convert hmove using 1
  ring_nf

lemma oddCenteredTail_moving_tendsto (hCN : CenteredLimitingLaw)
    (τ : ℝ) (hτ : 0 < τ) :
    Tendsto (fun n : ℕ ↦ oddCenteredTail n (oddSourceParameter n τ)) atTop
      (𝓝 (Real.exp (-rate * τ))) := by
  have hmove := tendsto_antitone_moving oddCenteredTail
    (fun u ↦ Real.exp (-2 * rate * u)) (fun n ↦ oddSourceParameter n τ) (τ / 2)
    oddCenteredTail_antitone hCN.2 (by fun_prop) (oddSourceParameter_tendsto τ)
    (by positivity)
  convert hmove using 1
  ring_nf

lemma tendsto_of_even_odd {f : ℕ → ℝ} {l : ℝ}
    (he : Tendsto (fun n ↦ f (2 * n)) atTop (𝓝 l))
    (ho : Tendsto (fun n ↦ f (2 * n + 1)) atTop (𝓝 l)) :
    Tendsto f atTop (𝓝 l) := by
  rw [tendsto_def]
  intro s hs
  rcases (eventually_atTop.1 (he.eventually hs)) with ⟨Ne, hNe⟩
  rcases (eventually_atTop.1 (ho.eventually hs)) with ⟨No, hNo⟩
  change ∀ᶠ N : ℕ in atTop, f N ∈ s
  rw [eventually_atTop]
  refine ⟨2 * max Ne No + 1, ?_⟩
  intro N hN
  rcases Nat.even_or_odd' N with ⟨k, rfl | rfl⟩
  · apply hNe
    omega
  · apply hNo
    omega

/-- Exact limiting-law proposition for degree-`N` Rademacher Littlewood
polynomials.  The analytic part of the file proves this proposition. -/
def LimitingLaw : Prop :=
  ∀ τ : ℝ, 0 < τ →
    Tendsto (fun N : ℕ ↦ minimumTail N τ) atTop
      (𝓝 (Real.exp (-rate * τ)))

/-- Exact parity recombination and normalization: the centered source law
implies the degree-indexed law stated in this file. -/
theorem limitingLaw_of_centeredLimitingLaw (hCN : CenteredLimitingLaw) :
    LimitingLaw := by
  intro τ hτ
  apply tendsto_of_even_odd
  · apply (centeredTail_moving_tendsto hCN τ hτ).congr'
    filter_upwards [Nat.eventually_pos] with n hn
    exact (minimumTail_even_eq_centeredTail n hn τ).symm
  · apply (oddCenteredTail_moving_tendsto hCN τ hτ).congr'
    exact Eventually.of_forall fun n ↦ (minimumTail_odd_eq_oddCenteredTail n τ).symm

/-! ## Cook--Nguyen source argument: local geometry and phase space -/

/-- Offset of the closest point to zero on the affine complex line
`a + t b`. -/
noncomputable def affineClosestOffset (a b : ℂ) : ℝ :=
  -(a * conj b).re / Complex.normSq b

lemma normSq_affine_eq (a b : ℂ) (t : ℝ) :
    Complex.normSq (a + (t : ℂ) * b) =
      Complex.normSq a + 2 * t * (a * conj b).re +
        t ^ 2 * Complex.normSq b := by
  simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, Complex.mul_im,
    Complex.conj_re, Complex.conj_im]
  ring

lemma normSq_affine_closest (a b : ℂ) (hb : b ≠ 0) :
    Complex.normSq (a + (affineClosestOffset a b : ℂ) * b) =
      (a * conj b).im ^ 2 / Complex.normSq b := by
  rw [normSq_affine_eq]
  have hbNorm : Complex.normSq b ≠ 0 := (Complex.normSq_eq_zero.not.mpr hb)
  have hbcoords : b.re ^ 2 + b.im ^ 2 ≠ 0 := by
    simpa [Complex.normSq_apply, pow_two] using hbNorm
  simp only [affineClosestOffset]
  rw [Complex.normSq_apply a, Complex.normSq_apply b]
  simp only [Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im]
  field_simp [hbcoords]
  ring

lemma normSq_affine_decomposition (a b : ℂ) (hb : b ≠ 0) (t : ℝ) :
    Complex.normSq (a + (t : ℂ) * b) =
      Complex.normSq (a + (affineClosestOffset a b : ℂ) * b) +
        Complex.normSq b * (t - affineClosestOffset a b) ^ 2 := by
  rw [normSq_affine_eq, normSq_affine_eq]
  have hbNorm : Complex.normSq b ≠ 0 := (Complex.normSq_eq_zero.not.mpr hb)
  simp only [affineClosestOffset]
  field_simp
  ring

/-- The exact signed-distance formula for a local linearization. -/
lemma affine_closest_norm (a b : ℂ) (hb : b ≠ 0) :
    ‖a + (affineClosestOffset a b : ℂ) * b‖ =
      |(a * conj b).im| / ‖b‖ := by
  rw [Complex.norm_def, normSq_affine_closest a b hb]
  rw [Real.sqrt_div (sq_nonneg _), Real.sqrt_sq_eq_abs]
  rfl

lemma affine_closest_min (a b : ℂ) (hb : b ≠ 0) (t : ℝ) :
    ‖a + (affineClosestOffset a b : ℂ) * b‖ ≤ ‖a + (t : ℂ) * b‖ := by
  rw [← sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)]
  simp only [← Complex.normSq_eq_norm_sq]
  rw [normSq_affine_decomposition a b hb t]
  exact le_add_of_nonneg_right
    (mul_nonneg (Complex.normSq_nonneg _) (sq_nonneg _))

/-- Real `4m`-dimensional phase-space coordinates, grouped into position
and normalized-velocity blocks at each of `m` sample points. -/
abbrev PhaseCoordinate (m : ℕ) := Fin m → Fin 4 → ℝ

/-- One deterministic step of the Cook--Nguyen phase-space walk.  The four
entries are real and imaginary position followed by real and imaginary
normalized velocity for the rescaled process `P_n(t/n)`. -/
noncomputable def phaseStep (n : ℕ) (points : Fin m → ℝ)
    (j : Fin (2 * n + 1)) : PhaseCoordinate m := fun r ↦
  let θ := centeredFrequency n j * (points r / n)
  let v := centeredFrequency n j / n
  ![Real.cos θ, Real.sin θ, -v * Real.sin θ, v * Real.cos θ]

lemma abs_centeredFrequency_le (n : ℕ) (j : Fin (2 * n + 1)) :
    |centeredFrequency n j| ≤ n := by
  have hjNat : (j : ℕ) ≤ 2 * n := by omega
  have hjReal : (j : ℝ) ≤ 2 * n := by exact_mod_cast hjNat
  rw [abs_le]
  constructor <;> simp only [centeredFrequency] <;> linarith

lemma abs_centeredFrequency_div_le_one (n : ℕ) (hn : 0 < n)
    (j : Fin (2 * n + 1)) :
    |centeredFrequency n j / n| ≤ 1 := by
  have hnabs : |(n : ℝ)| = n := abs_of_nonneg (Nat.cast_nonneg n)
  rw [abs_div, hnabs]
  exact (div_le_one (by exact_mod_cast hn : (0 : ℝ) < n)).2
    (abs_centeredFrequency_le n j)

lemma abs_phaseStep_le_one (n : ℕ) (points : Fin m → ℝ)
    (j : Fin (2 * n + 1)) (r : Fin m) (c : Fin 4) :
    |phaseStep n points j r c| ≤ 1 := by
  by_cases hn : n = 0
  · subst n
    fin_cases c <;> simp [phaseStep, centeredFrequency]
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn
  have hv := abs_centeredFrequency_div_le_one n hnpos j
  fin_cases c
  · exact Real.abs_cos_le_one _
  · exact Real.abs_sin_le_one _
  · change
      |-(centeredFrequency n j / (n : ℝ)) *
        Real.sin (centeredFrequency n j * (points r / n))| ≤ 1
    rw [abs_mul, abs_neg]
    calc
      |centeredFrequency n j / (n : ℝ)| *
          |Real.sin (centeredFrequency n j * (points r / n))| ≤ 1 * 1 :=
        mul_le_mul hv (Real.abs_sin_le_one _) (abs_nonneg _) zero_le_one
      _ = 1 := by norm_num
  · change
      |(centeredFrequency n j / (n : ℝ)) *
        Real.cos (centeredFrequency n j * (points r / n))| ≤ 1
    rw [abs_mul]
    calc
      |centeredFrequency n j / (n : ℝ)| *
          |Real.cos (centeredFrequency n j * (points r / n))| ≤ 1 * 1 :=
        mul_le_mul hv (Real.abs_cos_le_one _) (abs_nonneg _) zero_le_one
      _ = 1 := by norm_num

lemma phaseStep_sq_le_one (n : ℕ) (points : Fin m → ℝ)
    (j : Fin (2 * n + 1)) (r : Fin m) (c : Fin 4) :
    (phaseStep n points j r c) ^ 2 ≤ 1 := by
  nlinarith [sq_abs (phaseStep n points j r c),
    abs_phaseStep_le_one n points j r c,
    abs_nonneg (phaseStep n points j r c)]

/-- Each phase-space coordinate has unnormalized variance at most the
number of Rademacher summands. -/
lemma phaseStep_variance_le_count (n : ℕ) (points : Fin m → ℝ)
    (r : Fin m) (c : Fin 4) :
    ∑ j : Fin (2 * n + 1), (phaseStep n points j r c) ^ 2 ≤
      (2 * n + 1 : ℝ) := by
  calc
    ∑ j : Fin (2 * n + 1), (phaseStep n points j r c) ^ 2 ≤
        ∑ _j : Fin (2 * n + 1), (1 : ℝ) := by
      exact Finset.sum_le_sum fun j _ ↦ phaseStep_sq_le_one n points j r c
    _ = (2 * n + 1 : ℝ) := by simp

/-- The unnormalized phase-space walk for a sign vector. -/
noncomputable def phaseWalk (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) : PhaseCoordinate m := fun r c ↦
  ∑ j : Fin (2 * n + 1), sign (ε j) * phaseStep n points j r c

/-- Projection of one deterministic step onto a phase-space direction. -/
noncomputable def phaseProjection (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (j : Fin (2 * n + 1)) : ℝ :=
  ∑ r : Fin m, ∑ c : Fin 4, u r c * phaseStep n points j r c

lemma abs_phaseProjection_le (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (j : Fin (2 * n + 1)) :
    |phaseProjection n points u j| ≤ ∑ r : Fin m, ∑ c : Fin 4, |u r c| := by
  unfold phaseProjection
  calc
    |∑ r : Fin m, ∑ c : Fin 4, u r c * phaseStep n points j r c| ≤
        ∑ r : Fin m, |∑ c : Fin 4, u r c * phaseStep n points j r c| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ r : Fin m, ∑ c : Fin 4,
        |u r c * phaseStep n points j r c| := by
      exact Finset.sum_le_sum fun r _ ↦ Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ r : Fin m, ∑ c : Fin 4, |u r c| := by
      apply Finset.sum_le_sum
      intro r _
      apply Finset.sum_le_sum
      intro c _
      rw [abs_mul]
      exact mul_le_of_le_one_right (abs_nonneg _) (abs_phaseStep_le_one n points j r c)

/-- Scalar projection of the random phase-space walk. -/
noncomputable def projectedPhaseWalk (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (u : PhaseCoordinate m) : ℝ :=
  ∑ j : Fin (2 * n + 1), phaseProjection n points u j * sign (ε j)

lemma projectedPhaseWalk_eq (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    projectedPhaseWalk n ε points u =
      ∑ r : Fin m, ∑ c : Fin 4, u r c * phaseWalk n ε points r c := by
  simp only [projectedPhaseWalk, phaseProjection, phaseWalk]
  calc
    (∑ j, (∑ r, ∑ c, u r c * phaseStep n points j r c) * sign (ε j)) =
        ∑ j, ∑ r, ∑ c,
          (u r c * phaseStep n points j r c) * sign (ε j) := by
      simp_rw [Finset.sum_mul]
    _ = ∑ r, ∑ c, ∑ j,
          (u r c * phaseStep n points j r c) * sign (ε j) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro r _
      rw [Finset.sum_comm]
    _ = ∑ r, ∑ c, u r c *
          ∑ j, sign (ε j) * phaseStep n points j r c := by
      apply Finset.sum_congr rfl
      intro r _
      apply Finset.sum_congr rfl
      intro c _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring

lemma cubeExpectation_projectedPhaseWalk (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) :
    cubeExpectation (fun ε : SignVector (2 * n) ↦
      projectedPhaseWalk n ε points u) = 0 := by
  unfold projectedPhaseWalk
  exact cubeExpectation_rademacher_linear _

/-- The variance of every scalar projection is the quadratic form of the
deterministic phase-step matrix. -/
lemma cubeExpectation_projectedPhaseWalk_sq (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) :
    cubeExpectation (fun ε : SignVector (2 * n) ↦
      (projectedPhaseWalk n ε points u) ^ 2) =
        ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 := by
  unfold projectedPhaseWalk
  exact cubeExpectation_rademacher_linear_sq _

/-- Exact second moment of one coordinate of the phase-space walk. -/
lemma cubeExpectation_phaseWalk_coordinate_sq (n : ℕ) (points : Fin m → ℝ)
    (r : Fin m) (c : Fin 4) :
    cubeExpectation (fun ε : SignVector (2 * n) ↦
      (phaseWalk n ε points r c) ^ 2) =
        ∑ j : Fin (2 * n + 1), (phaseStep n points j r c) ^ 2 := by
  unfold phaseWalk
  simpa only [mul_comm] using
    (cubeExpectation_rademacher_linear_sq
      (fun j : Fin (2 * n + 1) ↦ phaseStep n points j r c))

/-- Sub-Gaussian tail for a fixed position or velocity coordinate. -/
lemma phaseWalk_coordinate_abs_tail (n : ℕ) (points : Fin m → ℝ)
    (r : Fin m) (c : Fin 4) (t : ℝ) (ht : 0 ≤ t) :
    uniformProbability (fun ε : SignVector (2 * n) ↦
        t ≤ |phaseWalk n ε points r c|) ≤
      2 * Real.exp
        (-t ^ 2 / (2 * ∑ j : Fin (2 * n + 1),
          (phaseStep n points j r c) ^ 2)) := by
  unfold phaseWalk
  simpa only [mul_comm] using
    (rademacherLinear_abs_tail (2 * n + 1)
      (fun j : Fin (2 * n + 1) ↦ phaseStep n points j r c) t ht)

lemma projectedPhaseWalk_abs_tail (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : 0 ≤ t) :
    uniformProbability (fun epsilon : SignVector (2 * n) ↦
        t ≤ |projectedPhaseWalk n epsilon points u|) ≤
      2 * Real.exp
        (-t ^ 2 / (2 * ∑ j : Fin (2 * n + 1),
          (phaseProjection n points u j) ^ 2)) := by
  unfold projectedPhaseWalk
  exact rademacherLinear_abs_tail (2 * n + 1)
    (phaseProjection n points u) t ht

/-- Exact independent-coordinate factorization of the phase-space
characteristic function for Rademacher coefficients. -/
lemma projectedPhaseWalk_charFun (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) :
    Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t =
      ∏ j : Fin (2 * n + 1),
        (Real.cos (t * phaseProjection n points u j) : ℂ) := by
  simpa [projectedPhaseWalk, sign, Erdos88.Fourier.rademacherSign] using
    (Erdos88.Fourier.finCharFun_rademacher_linear
      (fun j : Fin (2 * n + 1) ↦ phaseProjection n points u j) t)

lemma norm_projectedPhaseWalk_charFun (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ =
      ∏ j : Fin (2 * n + 1),
        |Real.cos (t * phaseProjection n points u j)| := by
  simpa [projectedPhaseWalk, sign, Erdos88.Fourier.rademacherSign] using
    (Erdos88.Fourier.norm_finCharFun_rademacher_linear
      (fun j : Fin (2 * n + 1) ↦ phaseProjection n points u j) t)

/-- Centered polynomial in the microscopic time coordinate `t = n x`. -/
noncomputable def rescaledCenteredEval (n : ℕ) (ε : SignVector (2 * n))
    (t : ℝ) : ℂ :=
  centeredEval n ε (t / n)

/-- Derivative of `rescaledCenteredEval` with respect to microscopic time. -/
noncomputable def rescaledCenteredVelocity (n : ℕ) (ε : SignVector (2 * n))
    (t : ℝ) : ℂ :=
  (Real.sqrt (2 * n + 1 : ℝ) : ℂ)⁻¹ *
    ∑ j : Fin (2 * n + 1),
        (sign (ε j) : ℂ) *
        (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          Complex.exp
            ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)

/-- Second derivative of the centered process in microscopic time. -/
noncomputable def rescaledCenteredAcceleration (n : ℕ)
    (ε : SignVector (2 * n)) (t : ℝ) : ℂ :=
  (Real.sqrt (2 * n + 1 : ℝ) : ℂ)⁻¹ *
    ∑ j : Fin (2 * n + 1),
      (sign (ε j) : ℂ) *
        (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
        (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          Complex.exp
            ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)

/-- The velocity declaration is the real derivative of the rescaled
centered polynomial. -/
lemma hasDerivAt_rescaledCenteredEval (n : ℕ) (ε : SignVector (2 * n))
    (t : ℝ) :
    HasDerivAt (rescaledCenteredEval n ε)
      (rescaledCenteredVelocity n ε t) t := by
  unfold rescaledCenteredEval centeredEval rescaledCenteredVelocity
  apply HasDerivAt.const_mul
  have hterm : ∀ j : Fin (2 * n + 1),
      HasDerivAt
        (fun s : ℝ ↦ (sign (ε j) : ℂ) *
          Complex.exp
            ((centeredFrequency n j : ℂ) * ((s / n : ℝ) : ℂ) * Complex.I))
        ((sign (ε j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)) t := by
    intro j
    have hlinear :
        HasDerivAt
          (fun s : ℝ ↦
            (centeredFrequency n j : ℂ) * ((s / n : ℝ) : ℂ) * Complex.I)
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) t := by
      have h :=
        (((hasDerivAt_id t).div_const (n : ℝ)).ofReal_comp.const_mul
          (centeredFrequency n j : ℂ)).mul_const Complex.I
      simpa [div_eq_mul_inv] using h
    simpa only [mul_assoc, mul_left_comm, mul_comm] using
      (HasDerivAt.const_mul (sign (ε j) : ℂ) hlinear.cexp)
  exact HasDerivAt.fun_sum (u := Finset.univ) (fun j _ ↦ hterm j)

/-- The declared acceleration is the derivative of the microscopic
velocity. -/
lemma hasDerivAt_rescaledCenteredVelocity (n : ℕ)
    (ε : SignVector (2 * n)) (t : ℝ) :
    HasDerivAt (rescaledCenteredVelocity n ε)
      (rescaledCenteredAcceleration n ε t) t := by
  unfold rescaledCenteredVelocity rescaledCenteredAcceleration
  apply HasDerivAt.const_mul
  have hterm : ∀ j : Fin (2 * n + 1),
      HasDerivAt
        (fun s : ℝ ↦
          (sign (ε j) : ℂ) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((s / n : ℝ) : ℂ) * Complex.I))
        ((sign (ε j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)) t := by
    intro j
    have hlinear :
        HasDerivAt
          (fun s : ℝ ↦
            (centeredFrequency n j : ℂ) * ((s / n : ℝ) : ℂ) * Complex.I)
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) t := by
      have h :=
        (((hasDerivAt_id t).div_const (n : ℝ)).ofReal_comp.const_mul
          (centeredFrequency n j : ℂ)).mul_const Complex.I
      simpa [div_eq_mul_inv] using h
    simpa only [mul_assoc, mul_left_comm, mul_comm] using
      (HasDerivAt.const_mul
        ((sign (ε j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I))
        hlinear.cexp)
  exact HasDerivAt.fun_sum (u := Finset.univ) (fun j _ ↦ hterm j)

/-- A deterministic global bound for the microscopic second derivative.
It is already strong enough for a quadratic mesh: a cell has width
`O(n⁻¹)`, while this bound is `O(√n)`. -/
lemma norm_rescaledCenteredAcceleration_le (n : ℕ)
    (ε : SignVector (2 * n)) (t : ℝ) :
    ‖rescaledCenteredAcceleration n ε t‖ ≤
      Real.sqrt (2 * n + 1 : ℝ) := by
  by_cases hn : n = 0
  · subst n
    simp [rescaledCenteredAcceleration, centeredFrequency]
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hterm : ∀ j : Fin (2 * n + 1),
      ‖(sign (ε j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)‖ ≤ 1 := by
    intro j
    have hsign : |sign (ε j)| = 1 := by
      cases ε j <;> simp [sign]
    have hexp :
        ‖Complex.exp
          ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)‖ = 1 := by
      rw [Complex.norm_exp]
      simp [Complex.mul_re]
    rw [norm_mul, norm_mul, norm_mul, hexp, Complex.norm_real,
      Real.norm_eq_abs, hsign]
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      one_mul, mul_one]
    have hv := abs_centeredFrequency_div_le_one n hnpos j
    nlinarith [abs_nonneg (centeredFrequency n j / (n : ℝ))]
  unfold rescaledCenteredAcceleration
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hsqrt]
  calc
    (Real.sqrt (2 * n + 1 : ℝ))⁻¹ *
        ‖∑ j : Fin (2 * n + 1),
          (sign (ε j) : ℂ) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
              Complex.exp
                ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)‖ ≤
        (Real.sqrt (2 * n + 1 : ℝ))⁻¹ *
          ∑ _j : Fin (2 * n + 1), (1 : ℝ) := by
      gcongr
      exact (norm_sum_le _ _).trans
        (Finset.sum_le_sum fun j _ ↦ hterm j)
    _ = Real.sqrt (2 * n + 1 : ℝ) := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
      simp only [nsmul_eq_mul, one_mul]
      have hsquare := Real.sq_sqrt (by positivity : (0 : ℝ) ≤ 2 * n + 1)
      norm_num at hsquare ⊢
      field_simp [hsqrt.ne']
      nlinarith

/-- A two-derivative Taylor bound on an ordered real segment.  The coarse
constant `C` (rather than `C / 2`) keeps the proof entirely in the vector
mean-value theorem and is sufficient for the quadratic mesh. -/
lemma norm_taylor_sub_le_of_le
    (f f' f'' : ℝ → ℂ) (C x y : ℝ)
    (hxy : x ≤ y)
    (hf : ∀ s, HasDerivAt f (f' s) s)
    (hf' : ∀ s, HasDerivAt f' (f'' s) s)
    (hC : 0 ≤ C) (hbound : ∀ s, ‖f'' s‖ ≤ C) :
    ‖f y - (f x + ((y - x : ℝ) : ℂ) * f' x)‖ ≤ C * (y - x) ^ 2 := by
  have hvel : ∀ s ∈ Set.Icc x y, ‖f' s - f' x‖ ≤ C * (s - x) := by
    exact norm_image_sub_le_of_norm_deriv_le_segment'
      (fun s _hs ↦ (hf' s).hasDerivWithinAt)
      (fun s _hs ↦ hbound s)
  let lin : ℝ → ℂ := fun s ↦ ((s - x : ℝ) : ℂ) * f' x
  let g : ℝ → ℂ := f - ((fun _ ↦ f x) + lin)
  have hg : ∀ s ∈ Set.Icc x y,
      HasDerivWithinAt g (f' s - f' x) (Set.Icc x y) s := by
    intro s _hs
    have hlinear : HasDerivAt
        lin (f' x) s := by
      dsimp only [lin]
      simpa [id_eq] using
        ((hasDerivAt_id s).sub_const x).ofReal_comp.mul_const (f' x)
    have hraw : HasDerivAt g (f' s - f' x) s := by
      have hsum : HasDerivAt ((fun _ ↦ f x) + lin) (f' x) s := by
        simpa using (hasDerivAt_const s (f x)).add hlinear
      exact (hf s).sub hsum
    exact hraw.hasDerivWithinAt
  have hgbound : ∀ s ∈ Set.Ico x y, ‖f' s - f' x‖ ≤ C * (y - x) := by
    intro s hs
    exact (hvel s ⟨hs.1, hs.2.le⟩).trans
      (mul_le_mul_of_nonneg_left (sub_le_sub_right hs.2.le x) hC)
  have hmvt := norm_image_sub_le_of_norm_deriv_le_segment' hg hgbound y
    (Set.right_mem_Icc.mpr hxy)
  simpa [g, lin, pow_two, mul_assoc] using hmvt

/-- The same Taylor bound with the endpoint to the left of the expansion
point. -/
lemma norm_taylor_sub_le_of_ge
    (f f' f'' : ℝ → ℂ) (C x y : ℝ)
    (hyx : y ≤ x)
    (hf : ∀ s, HasDerivAt f (f' s) s)
    (hf' : ∀ s, HasDerivAt f' (f'' s) s)
    (hC : 0 ≤ C) (hbound : ∀ s, ‖f'' s‖ ≤ C) :
    ‖f y - (f x + ((y - x : ℝ) : ℂ) * f' x)‖ ≤ C * (y - x) ^ 2 := by
  have hvel : ∀ s ∈ Set.Icc y x, ‖f' x - f' s‖ ≤ C * (x - s) := by
    intro s hs
    exact norm_image_sub_le_of_norm_deriv_le_segment'
      (fun r _hr ↦ (hf' r).hasDerivWithinAt)
      (fun r _hr ↦ hbound r) x ⟨hs.2, le_rfl⟩
  let lin : ℝ → ℂ := fun s ↦ ((s - x : ℝ) : ℂ) * f' x
  let g : ℝ → ℂ := f - ((fun _ ↦ f x) + lin)
  have hg : ∀ s ∈ Set.Icc y x,
      HasDerivWithinAt g (f' s - f' x) (Set.Icc y x) s := by
    intro s _hs
    have hlinear : HasDerivAt
        lin (f' x) s := by
      dsimp only [lin]
      simpa [id_eq] using
        ((hasDerivAt_id s).sub_const x).ofReal_comp.mul_const (f' x)
    have hraw : HasDerivAt g (f' s - f' x) s := by
      have hsum : HasDerivAt ((fun _ ↦ f x) + lin) (f' x) s := by
        simpa using (hasDerivAt_const s (f x)).add hlinear
      exact (hf s).sub hsum
    exact hraw.hasDerivWithinAt
  have hgbound : ∀ s ∈ Set.Ico y x, ‖f' s - f' x‖ ≤ C * (x - y) := by
    intro s hs
    rw [← norm_neg, neg_sub]
    exact (hvel s ⟨hs.1, hs.2.le⟩).trans
      (mul_le_mul_of_nonneg_left (sub_le_sub_left hs.1 x) hC)
  have hmvt := norm_image_sub_le_of_norm_deriv_le_segment' hg hgbound x
    (Set.right_mem_Icc.mpr hyx)
  have hgzero : g x = 0 := by simp [g, lin]
  have hnorm : ‖g y‖ ≤ C * (x - y) ^ 2 := by
    simpa [hgzero, norm_neg, pow_two, mul_assoc] using hmvt
  calc
    ‖f y - (f x + ((y - x : ℝ) : ℂ) * f' x)‖ = ‖g y‖ := by
      simp [g, lin]
    _ ≤ C * (x - y) ^ 2 := hnorm
    _ = C * (y - x) ^ 2 := by ring

/-- Uniform quadratic linearization error for the centered process. -/
lemma norm_rescaledCenteredEval_sub_linear_le (n : ℕ)
    (ε : SignVector (2 * n)) (x y : ℝ) :
    ‖rescaledCenteredEval n ε y -
        (rescaledCenteredEval n ε x + ((y - x : ℝ) : ℂ) *
          rescaledCenteredVelocity n ε x)‖ ≤
      Real.sqrt (2 * n + 1 : ℝ) * (y - x) ^ 2 := by
  rcases le_total x y with hxy | hyx
  · exact norm_taylor_sub_le_of_le
      (rescaledCenteredEval n ε) (rescaledCenteredVelocity n ε)
      (rescaledCenteredAcceleration n ε)
      (Real.sqrt (2 * n + 1 : ℝ)) x y hxy
      (hasDerivAt_rescaledCenteredEval n ε)
      (hasDerivAt_rescaledCenteredVelocity n ε)
      (Real.sqrt_nonneg _) (norm_rescaledCenteredAcceleration_le n ε)
  · exact norm_taylor_sub_le_of_ge
      (rescaledCenteredEval n ε) (rescaledCenteredVelocity n ε)
      (rescaledCenteredAcceleration n ε)
      (Real.sqrt (2 * n + 1 : ℝ)) x y hyx
      (hasDerivAt_rescaledCenteredEval n ε)
      (hasDerivAt_rescaledCenteredVelocity n ε)
      (Real.sqrt_nonneg _) (norm_rescaledCenteredAcceleration_le n ε)

@[simp] lemma exp_centeredFrequency_re (n : ℕ) (j : Fin (2 * n + 1)) (x : ℝ) :
    (Complex.exp ((centeredFrequency n j : ℂ) * (x : ℂ) * Complex.I)).re =
      Real.cos (centeredFrequency n j * x) := by
  convert Complex.exp_ofReal_mul_I_re (centeredFrequency n j * x) using 1 <;>
    push_cast <;> rfl

@[simp] lemma exp_centeredFrequency_im (n : ℕ) (j : Fin (2 * n + 1)) (x : ℝ) :
    (Complex.exp ((centeredFrequency n j : ℂ) * (x : ℂ) * Complex.I)).im =
      Real.sin (centeredFrequency n j * x) := by
  convert Complex.exp_ofReal_mul_I_im (centeredFrequency n j * x) using 1 <;>
    push_cast <;> rfl

@[simp] lemma exp_centeredFrequency_div_re (n : ℕ) (j : Fin (2 * n + 1))
    (t : ℝ) :
    (Complex.exp ((centeredFrequency n j : ℂ) * ((t : ℂ) / n) * Complex.I)).re =
      Real.cos (centeredFrequency n j * (t / n)) := by
  convert exp_centeredFrequency_re n j (t / n) using 1 <;> push_cast <;> rfl

@[simp] lemma exp_centeredFrequency_div_im (n : ℕ) (j : Fin (2 * n + 1))
    (t : ℝ) :
    (Complex.exp ((centeredFrequency n j : ℂ) * ((t : ℂ) / n) * Complex.I)).im =
      Real.sin (centeredFrequency n j * (t / n)) := by
  convert exp_centeredFrequency_im n j (t / n) using 1 <;> push_cast <;> rfl

lemma phaseWalk_position_re (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (r : Fin m) :
    phaseWalk n ε points r 0 / Real.sqrt (2 * n + 1 : ℝ) =
      (rescaledCenteredEval n ε (points r)).re := by
  unfold phaseWalk phaseStep rescaledCenteredEval centeredEval
  simp [Complex.mul_re, exp_centeredFrequency_div_re]
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ≠ 0 := by positivity
  field_simp [hsqrt]
  ring_nf
  apply Finset.sum_congr rfl
  intro j _
  congr 2
  ring

lemma phaseWalk_position_im (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (r : Fin m) :
    phaseWalk n ε points r 1 / Real.sqrt (2 * n + 1 : ℝ) =
      (rescaledCenteredEval n ε (points r)).im := by
  unfold phaseWalk phaseStep rescaledCenteredEval centeredEval
  simp [Complex.mul_im, exp_centeredFrequency_div_im]
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ≠ 0 := by positivity
  field_simp [hsqrt]
  ring_nf
  apply Finset.sum_congr rfl
  intro j _
  congr 2
  ring

lemma phaseWalk_velocity_re (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (r : Fin m) :
    phaseWalk n ε points r 2 / Real.sqrt (2 * n + 1 : ℝ) =
      (rescaledCenteredVelocity n ε (points r)).re := by
  by_cases hn : n = 0
  · subst n
    simp [phaseWalk, phaseStep, rescaledCenteredVelocity, centeredFrequency]
  unfold phaseWalk phaseStep rescaledCenteredVelocity
  simp [Complex.mul_re, Complex.mul_im, exp_centeredFrequency_div_re,
    exp_centeredFrequency_div_im]
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ≠ 0 := by positivity
  field_simp [hn', hsqrt]
  ring_nf
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  rw [show centeredFrequency n j * points r * (n : ℝ)⁻¹ =
      points r * (n : ℝ)⁻¹ * centeredFrequency n j by ring]
  ring

lemma phaseWalk_velocity_im (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (r : Fin m) :
    phaseWalk n ε points r 3 / Real.sqrt (2 * n + 1 : ℝ) =
      (rescaledCenteredVelocity n ε (points r)).im := by
  by_cases hn : n = 0
  · subst n
    simp [phaseWalk, phaseStep, rescaledCenteredVelocity, centeredFrequency]
  unfold phaseWalk phaseStep rescaledCenteredVelocity
  simp [Complex.mul_re, Complex.mul_im, exp_centeredFrequency_div_re,
    exp_centeredFrequency_div_im]
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ≠ 0 := by positivity
  field_simp [hn', hsqrt]
  ring_nf
  apply Finset.sum_congr rfl
  intro j _
  rw [show centeredFrequency n j * points r * (n : ℝ)⁻¹ =
      points r * (n : ℝ)⁻¹ * centeredFrequency n j by ring]
  ring

/-! ### Phase-space form of the representative event -/

/-- Phase walk divided by its natural variance normalization. -/
noncomputable def normalizedPhaseWalk (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) : PhaseCoordinate m := fun r c ↦
  phaseWalk n ε points r c / Real.sqrt (2 * n + 1 : ℝ)

/-- Euclidean pairing on the grouped `4m` phase coordinates.  We keep this
explicit because `PhaseCoordinate` is an ordinary finite function type (and
therefore carries the product sup norm rather than Mathlib's `PiLp 2` norm). -/
noncomputable def phasePairing (u z : PhaseCoordinate m) : ℝ :=
  ∑ r : Fin m, ∑ c : Fin 4, u r c * z r c

/-- Characteristic function of the normalized finite phase-space walk,
written directly as normalized counting expectation on the sign cube. -/
noncomputable def normalizedPhaseCharFun (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) : ℂ :=
  Erdos88.Fourier.finExpectation (SignVector (2 * n)) fun ε ↦
    Complex.exp (((phasePairing u (normalizedPhaseWalk n ε points) : ℝ) : ℂ) *
      Complex.I)

lemma phasePairing_normalizedPhaseWalk (n : ℕ)
    (ε : SignVector (2 * n)) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) :
    phasePairing u (normalizedPhaseWalk n ε points) =
      projectedPhaseWalk n ε points u / Real.sqrt (2 * n + 1 : ℝ) := by
  rw [projectedPhaseWalk_eq]
  unfold phasePairing normalizedPhaseWalk
  simp_rw [div_eq_mul_inv, ← mul_assoc]
  change
    (∑ r ∈ (Finset.univ : Finset (Fin m)),
      ∑ c ∈ (Finset.univ : Finset (Fin 4)),
        u r c * phaseWalk n ε points r c *
          (Real.sqrt (2 * n + 1 : ℝ))⁻¹) =
      (∑ r ∈ (Finset.univ : Finset (Fin m)),
        ∑ c ∈ (Finset.univ : Finset (Fin 4)),
          u r c * phaseWalk n ε points r c) *
            (Real.sqrt (2 * n + 1 : ℝ))⁻¹
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro r _
  rw [Finset.sum_mul]

lemma normalizedPhaseCharFun_eq_projected (n : ℕ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    normalizedPhaseCharFun n points u =
      Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u)
        (Real.sqrt (2 * n + 1 : ℝ))⁻¹ := by
  unfold normalizedPhaseCharFun Erdos88.Fourier.finCharFun
  apply congrArg (Erdos88.Fourier.finExpectation (SignVector (2 * n)))
  funext ε
  rw [phasePairing_normalizedPhaseWalk]
  congr 2
  push_cast
  ring

/-- Exact cosine product for the full normalized `4m`-dimensional
characteristic function. -/
lemma normalizedPhaseCharFun_eq_prod (n : ℕ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    normalizedPhaseCharFun n points u =
      ∏ j : Fin (2 * n + 1),
        (Real.cos
          (phaseProjection n points u j /
            Real.sqrt (2 * n + 1 : ℝ)) : ℂ) := by
  rw [normalizedPhaseCharFun_eq_projected, projectedPhaseWalk_charFun]
  apply Finset.prod_congr rfl
  intro j _
  congr 2
  ring

lemma norm_normalizedPhaseCharFun (n : ℕ)
    (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    ‖normalizedPhaseCharFun n points u‖ =
      ∏ j : Fin (2 * n + 1),
        |Real.cos
          (phaseProjection n points u j /
            Real.sqrt (2 * n + 1 : ℝ))| := by
  rw [normalizedPhaseCharFun_eq_projected,
    norm_projectedPhaseWalk_charFun]
  apply Finset.prod_congr rfl
  intro j _
  congr 2
  ring

/-- Normalized covariance quadratic form of the phase walk. -/
noncomputable def normalizedPhaseCovarianceForm
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) : ℝ :=
  (∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2) /
    (2 * n + 1 : ℝ)

lemma cubeExpectation_phasePairing_normalized_sq
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    cubeExpectation (fun ε : SignVector (2 * n) ↦
      (phasePairing u (normalizedPhaseWalk n ε points)) ^ 2) =
        normalizedPhaseCovarianceForm n points u := by
  simp_rw [phasePairing_normalizedPhaseWalk]
  rw [show (fun ε : SignVector (2 * n) ↦
      (projectedPhaseWalk n ε points u /
        Real.sqrt (2 * n + 1 : ℝ)) ^ 2) =
      (fun ε ↦ (Real.sqrt (2 * n + 1 : ℝ))⁻¹ ^ 2 *
        (projectedPhaseWalk n ε points u) ^ 2) by
    funext ε
    ring]
  rw [cubeExpectation_const_mul, cubeExpectation_projectedPhaseWalk_sq]
  unfold normalizedPhaseCovarianceForm
  have hsqrtSq : Real.sqrt (2 * n + 1 : ℝ) ^ 2 = (2 * n + 1 : ℝ) := by
    rw [Real.sq_sqrt]
    positivity
  rw [inv_pow, hsqrtSq]
  ring

lemma cubeExpectation_phasePairing_normalized
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    cubeExpectation (fun ε : SignVector (2 * n) ↦
      phasePairing u (normalizedPhaseWalk n ε points)) = 0 := by
  simp_rw [phasePairing_normalizedPhaseWalk, div_eq_mul_inv]
  rw [show (fun ε : SignVector (2 * n) ↦
      projectedPhaseWalk n ε points u *
        (Real.sqrt (2 * n + 1 : ℝ))⁻¹) =
      (fun ε ↦ (Real.sqrt (2 * n + 1 : ℝ))⁻¹ *
        projectedPhaseWalk n ε points u) by
    funext ε
    ring]
  rw [cubeExpectation_const_mul, cubeExpectation_projectedPhaseWalk, mul_zero]

lemma normalizedPhaseCovarianceForm_nonneg
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    0 ≤ normalizedPhaseCovarianceForm n points u := by
  unfold normalizedPhaseCovarianceForm
  positivity

lemma normalizedPhaseCovarianceForm_le_l1_sq
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    normalizedPhaseCovarianceForm n points u ≤
      (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ^ 2 := by
  let L : ℝ := ∑ r : Fin m, ∑ c : Fin 4, |u r c|
  have hterm : ∀ j : Fin (2 * n + 1),
      (phaseProjection n points u j) ^ 2 ≤ L ^ 2 := by
    intro j
    have habs := abs_phaseProjection_le n points u j
    have hL0 : 0 ≤ ∑ r : Fin m, ∑ c : Fin 4, |u r c| := by
      positivity
    have hsq := (sq_le_sq₀ (abs_nonneg (phaseProjection n points u j)) hL0).2 habs
    dsimp [L]
    simpa only [sq_abs] using hsq
  have hsum :
      ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 ≤
        (2 * n + 1 : ℝ) * L ^ 2 := by
    calc
      ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 ≤
          ∑ _j : Fin (2 * n + 1), L ^ 2 :=
        Finset.sum_le_sum fun j _ ↦ hterm j
      _ = (2 * n + 1 : ℝ) * L ^ 2 := by simp
  unfold normalizedPhaseCovarianceForm
  rw [div_le_iff₀ (by positivity : (0 : ℝ) < 2 * n + 1)]
  simpa [L, mul_comm] using hsum

/-- Fourth-order comparison of one Rademacher factor with its Gaussian
quadratic approximation. -/
lemma abs_cos_sub_exp_neg_half_sq_le_fourth
    (x : ℝ) (hx : |x| ≤ 1) :
    |Real.cos x - Real.exp (-(x ^ 2) / 2)| ≤ x ^ 4 := by
  have hx2 : x ^ 2 ≤ 1 := by
    have hfac : 0 ≤ (1 - |x|) * (1 + |x|) :=
      mul_nonneg (sub_nonneg.mpr hx) (by positivity)
    nlinarith [sq_abs x]
  have hy : |-x ^ 2 / 2| ≤ 1 := by
    rw [abs_of_nonpos (by nlinarith [sq_nonneg x] : -x ^ 2 / 2 ≤ 0)]
    nlinarith [sq_nonneg x]
  have hcos := Real.cos_bound hx
  have hexp0 := Real.abs_exp_sub_one_sub_id_le hy
  have hexp :
      |Real.exp (-(x ^ 2) / 2) - (1 - x ^ 2 / 2)| ≤ x ^ 4 / 4 := by
    convert hexp0 using 1 <;> ring
  have htriangle :
      |Real.cos x - Real.exp (-(x ^ 2) / 2)| ≤
        |Real.cos x - (1 - x ^ 2 / 2)| +
          |Real.exp (-(x ^ 2) / 2) - (1 - x ^ 2 / 2)| := by
    calc
      |Real.cos x - Real.exp (-(x ^ 2) / 2)| =
          |(Real.cos x - (1 - x ^ 2 / 2)) -
            (Real.exp (-(x ^ 2) / 2) - (1 - x ^ 2 / 2))| := by ring_nf
      _ ≤ |Real.cos x - (1 - x ^ 2 / 2)| +
          |Real.exp (-(x ^ 2) / 2) - (1 - x ^ 2 / 2)| := abs_sub _ _
  have hx4 : 0 ≤ x ^ 4 := by positivity
  calc
    |Real.cos x - Real.exp (-(x ^ 2) / 2)| ≤
        |Real.cos x - (1 - x ^ 2 / 2)| +
          |Real.exp (-(x ^ 2) / 2) - (1 - x ^ 2 / 2)| := htriangle
    _ ≤ |x| ^ 4 * (5 / 96) + x ^ 4 / 4 := add_le_add hcos hexp
    _ ≤ x ^ 4 := by
      have habs4 : |x| ^ 4 = x ^ 4 := by
        rw [← abs_pow, abs_of_nonneg hx4]
      rw [habs4]
      norm_num
      nlinarith

/-- Telescoping comparison of two finite products whose factors have
absolute value at most one. -/
lemma abs_prod_sub_prod_le_sum
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (a b : ι → ℝ)
    (ha : ∀ i ∈ s, |a i| ≤ 1) (hb : ∀ i ∈ s, |b i| ≤ 1) :
    |∏ i ∈ s, a i - ∏ i ∈ s, b i| ≤
      ∑ i ∈ s, |a i - b i| := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s his ih =>
      have hai := ha i (Finset.mem_insert_self i s)
      have hbi := hb i (Finset.mem_insert_self i s)
      have haS : ∀ j ∈ s, |a j| ≤ 1 := fun j hj ↦ ha j (Finset.mem_insert_of_mem hj)
      have hbS : ∀ j ∈ s, |b j| ≤ 1 := fun j hj ↦ hb j (Finset.mem_insert_of_mem hj)
      have hprodB : |∏ j ∈ s, b j| ≤ 1 := by
        rw [abs_prod]
        exact Finset.prod_le_one (fun j _ ↦ abs_nonneg _) hbS
      have htriangle :
          |a i * ∏ j ∈ s, a j - b i * ∏ j ∈ s, b j| ≤
            |a i| * |∏ j ∈ s, a j - ∏ j ∈ s, b j| +
              |a i - b i| * |∏ j ∈ s, b j| := by
        calc
          |a i * ∏ j ∈ s, a j - b i * ∏ j ∈ s, b j| =
          |a i * (∏ j ∈ s, a j - ∏ j ∈ s, b j) +
                (a i - b i) * ∏ j ∈ s, b j| := by ring_nf
          _ ≤ |a i * (∏ j ∈ s, a j - ∏ j ∈ s, b j)| +
              |(a i - b i) * ∏ j ∈ s, b j| := abs_add_le _ _
          _ = |a i| * |∏ j ∈ s, a j - ∏ j ∈ s, b j| +
              |a i - b i| * |∏ j ∈ s, b j| := by rw [abs_mul, abs_mul]
      rw [Finset.prod_insert his, Finset.prod_insert his,
        Finset.sum_insert his]
      calc
        |a i * ∏ j ∈ s, a j - b i * ∏ j ∈ s, b j| ≤
            |a i| * |∏ j ∈ s, a j - ∏ j ∈ s, b j| +
              |a i - b i| * |∏ j ∈ s, b j| := htriangle
        _ ≤ 1 * (∑ j ∈ s, |a j - b j|) + |a i - b i| * 1 := by
          gcongr
          exact ih haS hbS
        _ = |a i - b i| + ∑ j ∈ s, |a j - b j| := by ring

/-- Uniform major-arc comparison with the centered Gaussian having exactly
the finite-`n` covariance form. -/
lemma norm_normalizedPhaseCharFun_sub_covarianceGaussian_le
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hsmall : (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤
      Real.sqrt (2 * n + 1 : ℝ)) :
    ‖normalizedPhaseCharFun n points u -
        (Real.exp (-(normalizedPhaseCovarianceForm n points u) / 2) : ℂ)‖ ≤
      (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ^ 4 /
        (2 * n + 1 : ℝ) := by
  let C : ℝ := 2 * n + 1
  let L : ℝ := ∑ r : Fin m, ∑ c : Fin 4, |u r c|
  let x : Fin (2 * n + 1) → ℝ := fun j ↦
    phaseProjection n points u j / Real.sqrt C
  have hC : 0 < C := by dsimp [C]; positivity
  have hsqrtC : 0 < Real.sqrt C := Real.sqrt_pos.2 hC
  have hL0 : 0 ≤ L := by dsimp [L]; positivity
  have hx : ∀ j, |x j| ≤ 1 := by
    intro j
    have hproj := abs_phaseProjection_le n points u j
    have hratio : L / Real.sqrt C ≤ 1 :=
      (div_le_one hsqrtC).2 (by simpa [L, C] using hsmall)
    calc
      |x j| = |phaseProjection n points u j| / Real.sqrt C := by
        simp [x, abs_div, abs_of_pos hsqrtC]
      _ ≤ L / Real.sqrt C := div_le_div_of_nonneg_right hproj hsqrtC.le
      _ ≤ 1 := hratio
  have hcos : ∀ j ∈ (Finset.univ : Finset (Fin (2 * n + 1))),
      |Real.cos (x j)| ≤ 1 := fun j _ ↦ Real.abs_cos_le_one _
  have hexp : ∀ j ∈ (Finset.univ : Finset (Fin (2 * n + 1))),
      |Real.exp (-(x j ^ 2) / 2)| ≤ 1 := by
    intro j _
    rw [abs_of_pos (Real.exp_pos _)]
    exact Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg (x j)])
  have hprod := abs_prod_sub_prod_le_sum
    (Finset.univ : Finset (Fin (2 * n + 1)))
    (fun j ↦ Real.cos (x j)) (fun j ↦ Real.exp (-(x j ^ 2) / 2))
    hcos hexp
  have hfactor : ∀ j : Fin (2 * n + 1),
      |Real.cos (x j) - Real.exp (-(x j ^ 2) / 2)| ≤ x j ^ 4 :=
    fun j ↦ abs_cos_sub_exp_neg_half_sq_le_fourth (x j) (hx j)
  have hfourth :
      ∑ j : Fin (2 * n + 1), x j ^ 4 ≤ L ^ 4 / C := by
    have hsqrtSq : Real.sqrt C ^ 2 = C := Real.sq_sqrt hC.le
    have hterm : ∀ j : Fin (2 * n + 1), x j ^ 4 ≤ L ^ 4 / C ^ 2 := by
      intro j
      have hproj := abs_phaseProjection_le n points u j
      have hpow := pow_le_pow_left₀ (abs_nonneg _) hproj 4
      have hpow' : (phaseProjection n points u j) ^ 4 ≤ L ^ 4 := by
        have hleft : |phaseProjection n points u j| ^ 4 =
            (phaseProjection n points u j) ^ 4 := by
          rw [← abs_pow, abs_of_nonneg (by positivity :
            0 ≤ (phaseProjection n points u j) ^ 4)]
        have hright : L ^ 4 = |L| ^ 4 := by rw [abs_of_nonneg hL0]
        simpa [hleft, hright, L] using hpow
      dsimp [x]
      rw [div_pow, show Real.sqrt C ^ 4 = C ^ 2 by nlinarith]
      exact div_le_div_of_nonneg_right hpow' (sq_nonneg C)
    calc
      ∑ j : Fin (2 * n + 1), x j ^ 4 ≤
          ∑ _j : Fin (2 * n + 1), L ^ 4 / C ^ 2 :=
        Finset.sum_le_sum fun j _ ↦ hterm j
      _ = C * (L ^ 4 / C ^ 2) := by simp [C]
      _ = L ^ 4 / C := by field_simp
  have hsum :
      ∑ j : Fin (2 * n + 1),
          |Real.cos (x j) - Real.exp (-(x j ^ 2) / 2)| ≤ L ^ 4 / C :=
    (Finset.sum_le_sum fun j _ ↦ hfactor j).trans hfourth
  have hgaussProd :
      ∏ j : Fin (2 * n + 1), Real.exp (-(x j ^ 2) / 2) =
        Real.exp (-(normalizedPhaseCovarianceForm n points u) / 2) := by
    rw [← Real.exp_sum]
    congr 1
    unfold normalizedPhaseCovarianceForm
    dsimp [x, C]
    have hsqrtSq : Real.sqrt (2 * (n : ℝ) + 1) ^ 2 =
        2 * (n : ℝ) + 1 := by
      rw [Real.sq_sqrt]
      positivity
    simp only [div_eq_mul_inv, mul_pow]
    rw [inv_pow, hsqrtSq]
    rw [← Finset.sum_mul]
    rw [Finset.sum_neg_distrib]
    rw [Finset.sum_mul]
  rw [normalizedPhaseCharFun_eq_prod]
  have hprod' :
      |∏ j : Fin (2 * n + 1), Real.cos (x j) -
          ∏ j : Fin (2 * n + 1), Real.exp (-(x j ^ 2) / 2)| ≤
        L ^ 4 / C := hprod.trans hsum
  rw [hgaussProd] at hprod'
  change ‖(∏ j : Fin (2 * n + 1),
      (Real.cos (phaseProjection n points u j /
        Real.sqrt (2 * n + 1 : ℝ)) : ℂ)) -
      (Real.exp (-(normalizedPhaseCovarianceForm n points u) / 2) : ℂ)‖ ≤ _
  have hcoe :
      (∏ j : Fin (2 * n + 1),
          (Real.cos (phaseProjection n points u j /
            Real.sqrt (2 * n + 1 : ℝ)) : ℂ)) -
          (Real.exp (-(normalizedPhaseCovarianceForm n points u) / 2) : ℂ) =
        ((∏ j : Fin (2 * n + 1),
            Real.cos (phaseProjection n points u j /
              Real.sqrt (2 * n + 1 : ℝ))) -
          Real.exp (-(normalizedPhaseCovarianceForm n points u) / 2) : ℝ) := by
    push_cast
    rfl
  rw [hcoe, Complex.norm_real, Real.norm_eq_abs]
  simpa [x, L, C] using hprod'

/-- Complex position encoded by the first two real phase coordinates. -/
def phasePosition (z : PhaseCoordinate m) (r : Fin m) : ℂ :=
  ⟨z r 0, z r 1⟩

/-- Complex normalized velocity encoded by the last two coordinates. -/
def phaseVelocity (z : PhaseCoordinate m) (r : Fin m) : ℂ :=
  ⟨z r 2, z r 3⟩

lemma phasePosition_normalizedPhaseWalk (n : ℕ)
    (ε : SignVector (2 * n)) (points : Fin m → ℝ) (r : Fin m) :
    phasePosition (normalizedPhaseWalk n ε points) r =
      rescaledCenteredEval n ε (points r) := by
  apply Complex.ext
  · exact phaseWalk_position_re n ε points r
  · exact phaseWalk_position_im n ε points r

lemma phaseVelocity_normalizedPhaseWalk (n : ℕ)
    (ε : SignVector (2 * n)) (points : Fin m → ℝ) (r : Fin m) :
    phaseVelocity (normalizedPhaseWalk n ε points) r =
      rescaledCenteredVelocity n ε (points r) := by
  apply Complex.ext
  · exact phaseWalk_velocity_re n ε points r
  · exact phaseWalk_velocity_im n ε points r

noncomputable def phaseAffineOffset (z : PhaseCoordinate m) (r : Fin m) : ℝ :=
  affineClosestOffset (phasePosition z r) (phaseVelocity z r)

noncomputable def phaseSignedHeight (n : ℕ) (z : PhaseCoordinate m)
    (r : Fin m) : ℝ :=
  n * ((phasePosition z r * conj (phaseVelocity z r)).im /
    ‖phaseVelocity z r‖)

/-- The nonlinear phase-space region defining one affine local-minimum
representative. -/
def IsPhaseRepresentative (n : ℕ) (u halfWidth : ℝ)
    (z : PhaseCoordinate m) (r : Fin m) : Prop :=
  phaseVelocity z r ≠ 0 ∧
  |phaseAffineOffset z r| ≤ halfWidth ∧
  |phaseSignedHeight n z r| ≤ u

lemma isPhaseRepresentative_normalized_iff
    (n : ℕ) (u halfWidth : ℝ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (r : Fin m) :
    IsPhaseRepresentative n u halfWidth
        (normalizedPhaseWalk n ε points) r ↔
      rescaledCenteredVelocity n ε (points r) ≠ 0 ∧
      |affineClosestOffset
        (rescaledCenteredEval n ε (points r))
        (rescaledCenteredVelocity n ε (points r))| ≤ halfWidth ∧
      |n * ((rescaledCenteredEval n ε (points r) *
        conj (rescaledCenteredVelocity n ε (points r))).im /
          ‖rescaledCenteredVelocity n ε (points r)‖)| ≤ u := by
  rw [IsPhaseRepresentative, phaseAffineOffset, phaseSignedHeight,
    phasePosition_normalizedPhaseWalk, phaseVelocity_normalizedPhaseWalk]

/-! ### A finite mesh count for approximate local minima -/

/-- A deterministic quadratic mesh.  Its positivity avoids all degenerate
indexing cases while retaining the `n²` scale of the source proof. -/
def localMeshSize (n : ℕ) : ℕ := n ^ 2 + 1

lemma localMeshSize_pos (n : ℕ) : 0 < localMeshSize n := by
  simp [localMeshSize]

/-- Number of mesh centers in the real-coefficient fundamental half-period.
The other half is an exact reflected copy because the coefficients are real. -/
def halfLocalMeshSize (n : ℕ) : ℕ := localMeshSize n / 2

/-- Embed the upper half of the cyclic mesh into the full-period mesh. -/
def halfLocalMeshIndex (n : ℕ) (a : Fin (halfLocalMeshSize n)) :
    Fin (localMeshSize n) :=
  ⟨localMeshSize n - halfLocalMeshSize n + a,
    by
      have ha : a.val < halfLocalMeshSize n := a.isLt
      have hhalf : halfLocalMeshSize n ≤ localMeshSize n := Nat.div_le_self _ _
      omega⟩

lemma halfLocalMeshIndex_injective (n : ℕ) :
    Function.Injective (halfLocalMeshIndex n) := by
  intro a b hab
  apply Fin.ext
  have hab' := congrArg Fin.val hab
  change localMeshSize n - halfLocalMeshSize n + a.val =
    localMeshSize n - halfLocalMeshSize n + b.val at hab'
  omega

def halfLocalMeshSites (n : ℕ) : Finset (Fin (localMeshSize n)) :=
  Finset.univ.image (halfLocalMeshIndex n)

lemma card_halfLocalMeshSites (n : ℕ) :
    (halfLocalMeshSites n).card = halfLocalMeshSize n := by
  rw [halfLocalMeshSites, Finset.card_image_of_injective _
    (halfLocalMeshIndex_injective n)]
  simp

lemma halfLocalMeshIndex_lower (n : ℕ) (a : Fin (halfLocalMeshSize n)) :
    localMeshSize n ≤ 2 * (halfLocalMeshIndex n a).val := by
  change localMeshSize n ≤
    2 * (localMeshSize n - localMeshSize n / 2 + a.val)
  omega

lemma halfLocalMeshIndex_lt_size (n : ℕ) (a : Fin (halfLocalMeshSize n)) :
    (halfLocalMeshIndex n a).val < localMeshSize n :=
  (halfLocalMeshIndex n a).isLt

/-- Microscopic mesh point in one period `[-π n,π n)`. -/
noncomputable def localMeshPoint (n : ℕ) (a : Fin (localMeshSize n)) : ℝ :=
  -Real.pi * n + 2 * Real.pi * n * (a : ℝ) / localMeshSize n

noncomputable def halfLocalMeshPoint (n : ℕ)
    (a : Fin (halfLocalMeshSize n)) : ℝ :=
  localMeshPoint n (halfLocalMeshIndex n a)

lemma halfLocalMeshPoint_nonneg (n : ℕ)
    (a : Fin (halfLocalMeshSize n)) :
    0 ≤ halfLocalMeshPoint n a := by
  by_cases hn : n = 0
  · subst n
    simp [halfLocalMeshPoint, localMeshPoint]
  have hnreal : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hMreal : (0 : ℝ) < localMeshSize n := by
    exact_mod_cast localMeshSize_pos n
  have hindex : (localMeshSize n : ℝ) ≤
      2 * ((halfLocalMeshIndex n a).val : ℝ) := by
    exact_mod_cast halfLocalMeshIndex_lower n a
  unfold halfLocalMeshPoint localMeshPoint
  rw [show -Real.pi * (n : ℝ) + 2 * Real.pi * n *
      ((halfLocalMeshIndex n a).val : ℝ) / localMeshSize n =
      Real.pi * (n : ℝ) *
        (2 * ((halfLocalMeshIndex n a).val : ℝ) /
          localMeshSize n - 1) by ring]
  exact mul_nonneg (mul_nonneg Real.pi_pos.le hnreal.le)
    (sub_nonneg.mpr ((le_div_iff₀ hMreal).2 (by simpa using hindex)))

lemma halfLocalMeshPoint_lt_pi_mul (n : ℕ) (hn : 0 < n)
    (a : Fin (halfLocalMeshSize n)) :
    halfLocalMeshPoint n a < Real.pi * n := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hMreal : (0 : ℝ) < localMeshSize n := by
    exact_mod_cast localMeshSize_pos n
  have hindex : (((halfLocalMeshIndex n a).val : ℕ) : ℝ) <
      localMeshSize n := by
    exact_mod_cast halfLocalMeshIndex_lt_size n a
  unfold halfLocalMeshPoint localMeshPoint
  rw [show -Real.pi * (n : ℝ) + 2 * Real.pi * n *
      ((halfLocalMeshIndex n a).val : ℝ) / localMeshSize n =
      Real.pi * (n : ℝ) *
        (2 * ((halfLocalMeshIndex n a).val : ℝ) /
          localMeshSize n - 1) by ring]
  have hratio : 2 * ((halfLocalMeshIndex n a).val : ℝ) /
      localMeshSize n - 1 < 1 := by
    have hdiv : ((halfLocalMeshIndex n a).val : ℝ) /
        localMeshSize n < 1 := (div_lt_one hMreal).2 hindex
    rw [show 2 * ((halfLocalMeshIndex n a).val : ℝ) /
        localMeshSize n =
      2 * (((halfLocalMeshIndex n a).val : ℝ) /
        localMeshSize n) by ring]
    linarith
  simpa using
    (mul_lt_mul_of_pos_left hratio (mul_pos Real.pi_pos hnreal))

noncomputable def localMeshHalfWidth (n : ℕ) : ℝ :=
  Real.pi * n / localMeshSize n

/-- Deterministic Taylor error at the edge of one quadratic mesh cell. -/
noncomputable def localMeshTaylorError (n : ℕ) : ℝ :=
  Real.sqrt (2 * n + 1 : ℝ) * localMeshHalfWidth n ^ 2

noncomputable def localAffineOffset (n : ℕ) (ε : SignVector (2 * n))
    (a : Fin (localMeshSize n)) : ℝ :=
  affineClosestOffset
    (rescaledCenteredEval n ε (localMeshPoint n a))
    (rescaledCenteredVelocity n ε (localMeshPoint n a))

/-- Signed transverse height of the affine approximation, rescaled by `n`.
The representative predicate separately excludes zero velocity. -/
noncomputable def localSignedHeight (n : ℕ) (ε : SignVector (2 * n))
    (a : Fin (localMeshSize n)) : ℝ :=
  n *
    ((rescaledCenteredEval n ε (localMeshPoint n a) *
      conj (rescaledCenteredVelocity n ε (localMeshPoint n a))).im /
        ‖rescaledCenteredVelocity n ε (localMeshPoint n a)‖)

/-- The signed-height coordinate is exactly `n` times the distance from the
origin to the affine tangent line. -/
lemma norm_localAffineValue (n : ℕ) (hn : 0 < n)
    (ε : SignVector (2 * n)) (a : Fin (localMeshSize n))
    (hvel : rescaledCenteredVelocity n ε (localMeshPoint n a) ≠ 0) :
    ‖rescaledCenteredEval n ε (localMeshPoint n a) +
        (localAffineOffset n ε a : ℂ) *
          rescaledCenteredVelocity n ε (localMeshPoint n a)‖ =
      |localSignedHeight n ε a| / n := by
  change
    ‖rescaledCenteredEval n ε (localMeshPoint n a) +
        (affineClosestOffset
          (rescaledCenteredEval n ε (localMeshPoint n a))
          (rescaledCenteredVelocity n ε (localMeshPoint n a)) : ℂ) *
          rescaledCenteredVelocity n ε (localMeshPoint n a)‖ = _
  rw [affine_closest_norm _ _ hvel]
  unfold localSignedHeight
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hnorm : 0 < ‖rescaledCenteredVelocity n ε (localMeshPoint n a)‖ :=
    norm_pos_iff.mpr hvel
  rw [abs_mul, abs_of_pos hnreal, abs_div, abs_of_nonneg (norm_nonneg _)]
  field_simp

/-- The affine value at the declared offset minimizes the tangent-line
modulus. -/
lemma localAffineOffset_min (n : ℕ) (ε : SignVector (2 * n))
    (a : Fin (localMeshSize n))
    (hvel : rescaledCenteredVelocity n ε (localMeshPoint n a) ≠ 0)
    (s : ℝ) :
    ‖rescaledCenteredEval n ε (localMeshPoint n a) +
        (localAffineOffset n ε a : ℂ) *
          rescaledCenteredVelocity n ε (localMeshPoint n a)‖ ≤
      ‖rescaledCenteredEval n ε (localMeshPoint n a) +
        (s : ℂ) * rescaledCenteredVelocity n ε (localMeshPoint n a)‖ := by
  exact affine_closest_min _ _ hvel s

/-- The bare finite representative event used by the point-counting
reduction: the affine minimizer lies in its cell and has signed height in
the prescribed compact interval.  Derivative cutoffs can be intersected
with this predicate without changing the combinatorial identities below. -/
def IsLocalRepresentative (n : ℕ) (u : ℝ) (ε : SignVector (2 * n))
    (a : Fin (localMeshSize n)) : Prop :=
  rescaledCenteredVelocity n ε (localMeshPoint n a) ≠ 0 ∧
  |localAffineOffset n ε a| ≤ localMeshHalfWidth n ∧
  |localSignedHeight n ε a| ≤ u

lemma IsLocalRepresentative.affine_norm_le
    {n : ℕ} (hn : 0 < n) {u : ℝ} {ε : SignVector (2 * n)}
    {a : Fin (localMeshSize n)} (h : IsLocalRepresentative n u ε a) :
    ‖rescaledCenteredEval n ε (localMeshPoint n a) +
        (localAffineOffset n ε a : ℂ) *
          rescaledCenteredVelocity n ε (localMeshPoint n a)‖ ≤ u / n := by
  rw [norm_localAffineValue n hn ε a h.1]
  exact div_le_div_of_nonneg_right h.2.2 (Nat.cast_nonneg n)

/-- The centered minimum is bounded by the process at any microscopic time,
without first reducing that time to the chosen fundamental interval. -/
lemma centeredMin_le_rescaledCenteredEval (n : ℕ)
    (ε : SignVector (2 * n)) (t : ℝ) :
    centeredMin n ε ≤ ‖rescaledCenteredEval n ε t‖ := by
  rw [centeredMin_eq_minModulus_div_sqrt]
  unfold rescaledCenteredEval
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hcircle : Complex.exp ((((t / n : ℝ) : ℂ) * Complex.I)) ∈ unitCircle := by
    simp [unitCircle, Complex.norm_exp, Complex.mul_re]
  have hmin := minModulus_le ε hcircle
  calc
    minModulus ε / Real.sqrt (2 * n + 1 : ℝ) ≤
        ‖littlewoodEval ε
          (Complex.exp ((((t / n : ℝ) : ℂ) * Complex.I)))‖ /
            Real.sqrt (2 * n + 1 : ℝ) :=
      (div_le_div_iff_of_pos_right hsqrt).2 hmin
    _ = ‖centeredEval n ε (t / n)‖ := by
      rw [norm_centeredEval]

/-- Every local representative gives a genuine value of the process within
the deterministic quadratic Taylor error. -/
lemma IsLocalRepresentative.centeredMin_le
    {n : ℕ} (hn : 0 < n) {u : ℝ} {ε : SignVector (2 * n)}
    {a : Fin (localMeshSize n)} (h : IsLocalRepresentative n u ε a) :
    centeredMin n ε ≤ u / n + localMeshTaylorError n := by
  let x := localMeshPoint n a
  let s := localAffineOffset n ε a
  let A := rescaledCenteredEval n ε x + (s : ℂ) *
    rescaledCenteredVelocity n ε x
  have htime := centeredMin_le_rescaledCenteredEval n ε (x + s)
  have htaylor := norm_rescaledCenteredEval_sub_linear_le n ε x (x + s)
  have hlin : ‖A‖ ≤ u / n := by
    simpa [x, s, A] using h.affine_norm_le hn
  have hvalue : ‖rescaledCenteredEval n ε (x + s)‖ ≤
      ‖rescaledCenteredEval n ε (x + s) - A‖ + ‖A‖ := by
    have heq : rescaledCenteredEval n ε (x + s) =
        (rescaledCenteredEval n ε (x + s) - A) + A := by abel
    calc
      ‖rescaledCenteredEval n ε (x + s)‖ =
          ‖(rescaledCenteredEval n ε (x + s) - A) + A‖ := congrArg norm heq
      _ ≤ ‖rescaledCenteredEval n ε (x + s) - A‖ + ‖A‖ :=
        norm_add_le _ _
  calc
    centeredMin n ε ≤ ‖rescaledCenteredEval n ε (x + s)‖ := htime
    _ ≤ ‖rescaledCenteredEval n ε (x + s) - A‖ + ‖A‖ := hvalue
    _ ≤ Real.sqrt (2 * n + 1 : ℝ) * s ^ 2 + u / n := by
      gcongr
      simpa [x, s, A] using htaylor
    _ ≤ localMeshTaylorError n + u / n := by
      have hs := h.2.1
      change |s| ≤ localMeshHalfWidth n at hs
      have hs0 : 0 ≤ localMeshHalfWidth n := by
        unfold localMeshHalfWidth
        positivity
      rw [localMeshTaylorError]
      have hsSqAbs : |s| ^ 2 ≤ localMeshHalfWidth n ^ 2 :=
        (sq_le_sq₀ (abs_nonneg s) hs0).2 hs
      have hsSq : s ^ 2 ≤ localMeshHalfWidth n ^ 2 := by
        simpa only [sq_abs] using hsSqAbs
      have hmul := mul_le_mul_of_nonneg_left hsSq (Real.sqrt_nonneg (2 * n + 1 : ℝ))
      simpa only [add_comm] using add_le_add_right hmul (u / n)
    _ = u / n + localMeshTaylorError n := by ring

lemma sqrt_centeredCount_div_tendsto_zero :
    Tendsto (fun n : ℕ ↦ Real.sqrt (2 * n + 1 : ℝ) / n)
      atTop (𝓝 0) := by
  have hinv : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
  have hinside : Tendsto (fun n : ℕ ↦ 2 + ((n : ℝ))⁻¹)
      atTop (𝓝 2) := by
    simpa using tendsto_const_nhds.add hinv
  have hfirst : Tendsto (fun n : ℕ ↦ Real.sqrt (2 + ((n : ℝ))⁻¹))
      atTop (𝓝 (Real.sqrt 2)) := hinside.sqrt
  have hsqrtTop : Tendsto (fun n : ℕ ↦ Real.sqrt (n : ℝ)) atTop atTop :=
    Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop
  have hsecond : Tendsto (fun n : ℕ ↦ (Real.sqrt (n : ℝ))⁻¹)
      atTop (𝓝 0) := tendsto_inv_atTop_zero.comp hsqrtTop
  have hprod := hfirst.mul hsecond
  simp only [mul_zero] at hprod
  apply hprod.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hfactor : (2 * n + 1 : ℝ) =
      (2 + ((n : ℝ))⁻¹) * n := by
    field_simp
  rw [hfactor, Real.sqrt_mul (by positivity : (0 : ℝ) ≤ 2 + ((n : ℝ))⁻¹)]
  rw [mul_div_assoc, Real.sqrt_div_self]

lemma meshRatio_tendsto_one :
    Tendsto (fun n : ℕ ↦ (n : ℝ) ^ 2 / ((n : ℝ) ^ 2 + 1))
      atTop (𝓝 1) := by
  have hinv : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
  have hden : Tendsto (fun n : ℕ ↦ 1 + ((n : ℝ))⁻¹ ^ 2)
      atTop (𝓝 1) := by
    simpa using tendsto_const_nhds.add (hinv.pow 2)
  have h := hden.inv₀ (by norm_num)
  simpa using h.congr' (by
    filter_upwards [Nat.eventually_pos] with n hn
    have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
    field_simp)

lemma scaled_localMeshHalfWidth_sq_tendsto :
    Tendsto
      (fun n : ℕ ↦ (n : ℝ) ^ 2 * localMeshHalfWidth n ^ 2)
      atTop (𝓝 (Real.pi ^ 2)) := by
  have h := (meshRatio_tendsto_one.pow 2).const_mul (Real.pi ^ 2)
  simpa using h.congr' (Eventually.of_forall fun n ↦ by
    unfold localMeshHalfWidth localMeshSize
    norm_num
    ring)

/-- The deterministic Taylor error is negligible on the `1/n` minimum
scale. -/
lemma scaled_localMeshTaylorError_tendsto_zero :
    Tendsto (fun n : ℕ ↦ n * localMeshTaylorError n) atTop (𝓝 0) := by
  have h := sqrt_centeredCount_div_tendsto_zero.mul
    scaled_localMeshHalfWidth_sq_tendsto
  simp only [zero_mul] at h
  apply h.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold localMeshTaylorError
  field_simp

noncomputable def localMinimumCount (n : ℕ) (u : ℝ)
    (ε : SignVector (2 * n)) : ℕ :=
  (Finset.univ.filter fun a : Fin (localMeshSize n) ↦
    IsLocalRepresentative n u ε a).card

/-- Canonical enumeration of a finite collection of mesh sites. -/
noncomputable def localSite {n : ℕ}
    (s : Finset (Fin (localMeshSize n))) (r : Fin s.card) :
    Fin (localMeshSize n) :=
  (s.equivFin.symm r).1

noncomputable def localSitesPoints {n : ℕ}
    (s : Finset (Fin (localMeshSize n))) : Fin s.card → ℝ :=
  fun r ↦ localMeshPoint n (localSite s r)

lemma localSite_mem {n : ℕ} (s : Finset (Fin (localMeshSize n)))
    (r : Fin s.card) : localSite s r ∈ s := by
  exact (s.equivFin.symm r).2

lemma localSite_surjective {n : ℕ} (s : Finset (Fin (localMeshSize n)))
    {a : Fin (localMeshSize n)} (ha : a ∈ s) :
    ∃ r : Fin s.card, localSite s r = a := by
  let x : {a // a ∈ s} := ⟨a, ha⟩
  refine ⟨s.equivFin x, ?_⟩
  unfold localSite
  simp [x]

/-- A joint collection of mesh representatives is precisely membership of
the normalized phase walk in the corresponding nonlinear phase-space
region. -/
lemma joint_localRepresentatives_iff_phase
    (n : ℕ) (u : ℝ) (ε : SignVector (2 * n))
    (s : Finset (Fin (localMeshSize n))) :
    (∀ a ∈ s, IsLocalRepresentative n u ε a) ↔
      ∀ r : Fin s.card,
        IsPhaseRepresentative n u (localMeshHalfWidth n)
          (normalizedPhaseWalk n ε (localSitesPoints s)) r := by
  constructor
  · intro h r
    have hr := h (localSite s r) (localSite_mem s r)
    rw [isPhaseRepresentative_normalized_iff]
    change IsLocalRepresentative n u ε (localSite s r)
    exact hr
  · intro h a ha
    rcases localSite_surjective s ha with ⟨r, hr⟩
    have hh := h r
    rw [isPhaseRepresentative_normalized_iff] at hh
    change IsLocalRepresentative n u ε (localSite s r) at hh
    simpa [hr] using hh

/-- Choosing `k` successful sites from a finite predicate is the sum of its
joint `k`-site indicators. -/
lemma choose_card_filter_eq_sum_powersetCard
    {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Prop) (k : ℕ) :
    Nat.choose (Finset.univ.filter P).card k =
      ∑ s ∈ Finset.univ.powersetCard k,
        if ∀ i ∈ s, P i then 1 else 0 := by
  classical
  let H : Finset I := Finset.univ.filter P
  have hsets : H.powersetCard k =
      (Finset.univ.powersetCard k).filter (fun s ↦ ∀ i ∈ s, P i) := by
    ext s
    simp only [Finset.mem_powersetCard, Finset.mem_filter]
    constructor
    · rintro ⟨hsub, hcard⟩
      refine ⟨⟨Finset.subset_univ s, hcard⟩, ?_⟩
      intro i hi
      exact (Finset.mem_filter.mp (hsub hi)).2
    · rintro ⟨⟨_huniv, hcard⟩, hP⟩
      refine ⟨?_, hcard⟩
      intro i hi
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, hP i hi⟩
  calc
    Nat.choose (Finset.univ.filter P).card k = Nat.choose H.card k := by rfl
    _ = (H.powersetCard k).card := (Finset.card_powersetCard k H).symm
    _ = ((Finset.univ.powersetCard k).filter
          (fun s ↦ ∀ i ∈ s, P i)).card := by rw [hsets]
    _ = ∑ s ∈ Finset.univ.powersetCard k,
          if ∀ i ∈ s, P i then 1 else 0 := by simp

lemma choose_localMinimumCount (n k : ℕ) (u : ℝ)
    (ε : SignVector (2 * n)) :
    Nat.choose (localMinimumCount n u ε) k =
      ∑ s ∈ Finset.univ.powersetCard k,
        if ∀ a ∈ s, IsLocalRepresentative n u ε a then 1 else 0 := by
  classical
  unfold localMinimumCount
  convert choose_card_filter_eq_sum_powersetCard
    (fun a : Fin (localMeshSize n) ↦ IsLocalRepresentative n u ε a) k using 1
  apply Finset.sum_congr rfl
  intro s _hs
  by_cases h : ∀ a ∈ s, IsLocalRepresentative n u ε a
  · rw [if_pos h, if_pos h]
  · rw [if_neg h, if_neg h]

/-- Exact factorial-moment expansion of the finite local-minimum process. -/
lemma uniformChooseMoment_localMinimumCount (n k : ℕ) (u : ℝ) :
    uniformChooseMoment (localMinimumCount n u) k =
      ∑ s ∈ Finset.univ.powersetCard k,
        uniformProbability (fun ε : SignVector (2 * n) ↦
          ∀ a ∈ s, IsLocalRepresentative n u ε a) := by
  unfold uniformChooseMoment
  have heq :
      (fun ε : SignVector (2 * n) ↦
        (Nat.choose (localMinimumCount n u ε) k : ℝ)) =
      (fun ε ↦ ∑ s ∈ Finset.univ.powersetCard k,
        if ∀ a ∈ s, IsLocalRepresentative n u ε a
        then (1 : ℝ) else 0) := by
    funext ε
    exact_mod_cast choose_localMinimumCount n k u ε
  rw [heq]
  rw [uniformExpectation_finset_sum
    (Ω := SignVector (2 * n))
    (I := Finset (Fin (localMeshSize n)))
    (s := Finset.univ.powersetCard k)
    (X := fun s (ε : SignVector (2 * n)) ↦
      if ∀ a ∈ s, IsLocalRepresentative n u ε a then (1 : ℝ) else 0)]
  apply Finset.sum_congr rfl
  intro s _hs
  unfold uniformExpectation uniformProbability
  congr 1
  simp
  apply congrArg Finset.card
  ext ε
  simp

/-! ### Diophantine conditions -/

/-- The unique representative modulo `ℤ` in `(-1/2, 1/2]`. -/
noncomputable def centeredModOne (x : ℝ) : ℝ :=
  toIocMod (by norm_num : (0 : ℝ) < 1) (-1 / 2) x

/-- Distance of a real number from the nearest integer. -/
noncomputable def distanceToInteger (x : ℝ) : ℝ := |centeredModOne x|

lemma centeredModOne_mem (x : ℝ) : centeredModOne x ∈ Set.Ioc (-1 / 2) (1 / 2) := by
  unfold centeredModOne
  convert toIocMod_mem_Ioc (by norm_num : (0 : ℝ) < 1) (-1 / 2) x using 1 <;>
    norm_num

lemma abs_centeredModOne_le_half (x : ℝ) : |centeredModOne x| ≤ 1 / 2 := by
  apply (abs_le).2
  constructor
  · convert (centeredModOne_mem x).1.le using 1 <;> norm_num
  · exact (centeredModOne_mem x).2

lemma distanceToInteger_nonneg (x : ℝ) : 0 ≤ distanceToInteger x := abs_nonneg _

lemma distanceToInteger_le_half (x : ℝ) : distanceToInteger x ≤ 1 / 2 :=
  abs_centeredModOne_le_half x

lemma exists_int_add_centeredModOne (x : ℝ) :
    ∃ k : ℤ, x = k + centeredModOne x := by
  refine ⟨toIocDiv (by norm_num : (0 : ℝ) < 1) (-1 / 2) x, ?_⟩
  have h := toIocMod_add_toIocDiv_zsmul
    (by norm_num : (0 : ℝ) < 1) (-1 / 2) x
  simpa only [centeredModOne, zsmul_eq_mul, mul_one, add_comm] using h.symm

lemma centeredModOne_isCentered (x : ℝ) :
    Erdos88.Fourier.IsCenteredModOne x (centeredModOne x) := by
  refine ⟨abs_centeredModOne_le_half x, ?_⟩
  rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
  exact ⟨k, hk⟩

@[simp] lemma distanceToInteger_zero : distanceToInteger 0 = 0 := by
  have hmod : toIocMod (by norm_num : (0 : ℝ) < 1) (-1 / 2) 0 = 0 :=
    (toIocMod_eq_self (by norm_num : (0 : ℝ) < 1)).2 (by
      constructor <;> norm_num)
  simp only [distanceToInteger, centeredModOne]
  rw [hmod, abs_zero]

/-- Among all representatives obtained by subtracting an integer, the
centered representative has least absolute value. -/
lemma centeredModOne_minimal (x : ℝ) (k : ℤ) :
    |centeredModOne x| ≤ |x - (k : ℝ)| := by
  rcases exists_int_add_centeredModOne x with ⟨q, hq⟩
  have hd := abs_centeredModOne_le_half x
  have haux : ∀ z : ℤ, |centeredModOne x| ≤ |(z : ℝ) + centeredModOne x| := by
    intro z
    rcases lt_trichotomy z 0 with hz | hz | hz
    · have hzInt : z ≤ -1 := by omega
      have hzReal : (z : ℝ) ≤ -1 := by exact_mod_cast hzInt
      calc
        |centeredModOne x| ≤ 1 / 2 := hd
        _ ≤ -((z : ℝ) + centeredModOne x) := by
          have hupper := le_trans (le_abs_self (centeredModOne x)) hd
          linarith
        _ ≤ |(z : ℝ) + centeredModOne x| := neg_le_abs _
    · subst z
      simp
    · have hzInt : 1 ≤ z := by omega
      have hzReal : (1 : ℝ) ≤ z := by exact_mod_cast hzInt
      calc
        |centeredModOne x| ≤ 1 / 2 := hd
        _ ≤ (z : ℝ) + centeredModOne x := by
          have hlower := neg_le_of_abs_le hd
          linarith
        _ ≤ |(z : ℝ) + centeredModOne x| := le_abs_self _
  calc
    |centeredModOne x| ≤ |((q - k : ℤ) : ℝ) + centeredModOne x| :=
      haux (q - k)
    _ = |x - (k : ℝ)| := by
      congr 1
      push_cast
      linarith

lemma distanceToInteger_minimal (x : ℝ) (k : ℤ) :
    distanceToInteger x ≤ |x - (k : ℝ)| :=
  centeredModOne_minimal x k

lemma centeredModOne_add_int (x : ℝ) (k : ℤ) :
    centeredModOne (x + k) = centeredModOne x := by
  unfold centeredModOne
  convert toIocMod_add_intCast_mul
      (by norm_num : (0 : ℝ) < 1) (-1 / 2) x k using 1 <;>
    norm_num

@[simp] lemma distanceToInteger_add_int (x : ℝ) (k : ℤ) :
    distanceToInteger (x + k) = distanceToInteger x := by
  simp [distanceToInteger, centeredModOne_add_int]

lemma distanceToInteger_eq_zero_iff (x : ℝ) :
    distanceToInteger x = 0 ↔ ∃ k : ℤ, x = k := by
  constructor
  · intro h
    rw [distanceToInteger, abs_eq_zero] at h
    rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
    exact ⟨k, by simpa [h] using hk⟩
  · rintro ⟨k, rfl⟩
    have h := distanceToInteger_add_int 0 k
    simpa using h

@[simp] lemma distanceToInteger_neg (x : ℝ) :
    distanceToInteger (-x) = distanceToInteger x := by
  apply le_antisymm
  · rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
    have heq : -x - ((-k : ℤ) : ℝ) = -centeredModOne x := by
      push_cast
      linarith
    calc
      distanceToInteger (-x) ≤ |-x - (-k : ℤ)| :=
        distanceToInteger_minimal (-x) (-k)
      _ = |centeredModOne x| := by rw [heq, abs_neg]
      _ = distanceToInteger x := rfl
  · rcases exists_int_add_centeredModOne (-x) with ⟨k, hk⟩
    have heq : x - ((-k : ℤ) : ℝ) = -centeredModOne (-x) := by
      push_cast at hk ⊢
      linarith
    calc
      distanceToInteger x ≤ |x - (-k : ℤ)| :=
        distanceToInteger_minimal x (-k)
      _ = |centeredModOne (-x)| := by rw [heq, abs_neg]
      _ = distanceToInteger (-x) := rfl

lemma distanceToInteger_add_le (x y : ℝ) :
    distanceToInteger (x + y) ≤ distanceToInteger x + distanceToInteger y := by
  rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
  rcases exists_int_add_centeredModOne y with ⟨l, hl⟩
  calc
    distanceToInteger (x + y) ≤ |x + y - ((k + l : ℤ) : ℝ)| :=
      distanceToInteger_minimal (x + y) (k + l)
    _ = |centeredModOne x + centeredModOne y| := by
      congr 1
      push_cast
      linarith
    _ ≤ |centeredModOne x| + |centeredModOne y| := abs_add_le _ _
    _ = distanceToInteger x + distanceToInteger y := rfl

lemma distanceToInteger_sub_le (x y : ℝ) :
    distanceToInteger (x - y) ≤ distanceToInteger x + distanceToInteger y := by
  simpa [sub_eq_add_neg, distanceToInteger_neg] using
    distanceToInteger_add_le x (-y)

/-- Ordinary forward difference with an integer step.  This is the first,
integer-coefficient differencing operation in the lattice-avoidance proof. -/
def forwardDifference (q : ℤ) (f : ℤ → ℝ) : ℤ → ℝ :=
  fun j ↦ f (j + q) - f j

/-- `k` iterated ordinary forward differences. -/
def iteratedForwardDifference (q : ℤ) : ℕ → (ℤ → ℝ) → (ℤ → ℝ)
  | 0, f => f
  | k + 1, f => forwardDifference q (iteratedForwardDifference q k f)

@[simp] lemma iteratedForwardDifference_zero
    (q : ℤ) (f : ℤ → ℝ) :
    iteratedForwardDifference q 0 f = f := rfl

@[simp] lemma iteratedForwardDifference_succ
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) :
    iteratedForwardDifference q (k + 1) f =
      forwardDifference q (iteratedForwardDifference q k f) := rfl

lemma forwardDifference_comm (p q : ℤ) (f : ℤ → ℝ) :
    forwardDifference p (forwardDifference q f) =
      forwardDifference q (forwardDifference p f) := by
  funext j
  unfold forwardDifference
  rw [show j + p + q = j + q + p by ring]
  ring

lemma iteratedForwardDifference_forwardDifference_comm
    (p q : ℤ) (k : ℕ) (f : ℤ → ℝ) :
    iteratedForwardDifference p k (forwardDifference q f) =
      forwardDifference q (iteratedForwardDifference p k f) := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [iteratedForwardDifference_succ, iteratedForwardDifference_succ, ih]
      exact forwardDifference_comm p q _

lemma iteratedForwardDifference_succ_right
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) :
    iteratedForwardDifference q (k + 1) f =
      iteratedForwardDifference q k (forwardDifference q f) := by
  rw [iteratedForwardDifference_succ,
    iteratedForwardDifference_forwardDifference_comm]

/-- A difference at a natural multiple of a step is the telescoping sum of
the unit-step differences along that arithmetic progression. -/
lemma forwardDifference_nat_mul_eq_sum
    (q : ℤ) (ell : ℕ) (f : ℤ → ℝ) (j : ℤ) :
    forwardDifference ((ell : ℤ) * q) f j =
      ∑ a ∈ Finset.range ell,
        forwardDifference q f (j + (a : ℤ) * q) := by
  induction ell with
  | zero => simp [forwardDifference]
  | succ ell ih =>
      rw [Finset.sum_range_succ, ← ih]
      unfold forwardDifference
      push_cast
      ring

/-- Local polynomial rigidity for finite differences.  If the `k`th
base-step difference vanishes throughout the progression window needed by
an `ell`-fold dilation, then the `k`th difference at the dilated step also
vanishes.  This is the exact algebraic core of Cook--Nguyen Lemma 9.2. -/
lemma iteratedForwardDifference_nat_mul_eq_zero_of_base
    (q : ℤ) (ell k : ℕ) (f : ℤ → ℝ) (j : ℤ)
    (hzero : ∀ v : ℕ, v ≤ k * ell →
      iteratedForwardDifference q k f (j + (v : ℤ) * q) = 0) :
    iteratedForwardDifference ((ell : ℤ) * q) k f j = 0 := by
  induction k generalizing f j with
  | zero => simpa using hzero 0 (by omega)
  | succ k ih =>
      rw [iteratedForwardDifference_succ_right]
      apply ih
      intro v hv
      rw [iteratedForwardDifference_forwardDifference_comm]
      rw [forwardDifference_nat_mul_eq_sum]
      apply Finset.sum_eq_zero
      intro b hb
      have hb_lt : b < ell := Finset.mem_range.mp hb
      rw [← iteratedForwardDifference_succ]
      have hoff : j + (v : ℤ) * q + (b : ℤ) * q =
          j + ((v + b : ℕ) : ℤ) * q := by
        push_cast
        ring
      rw [hoff]
      apply hzero (v + b)
      simpa [Nat.succ_mul] using
        Nat.add_le_add hv (Nat.le_of_lt hb_lt)

lemma iteratedForwardDifference_add
    (q : ℤ) (a b : ℕ) (f : ℤ → ℝ) :
    iteratedForwardDifference q (a + b) f =
      iteratedForwardDifference q a (iteratedForwardDifference q b f) := by
  induction a with
  | zero => simp
  | succ a ih =>
      simp only [Nat.succ_add, iteratedForwardDifference_succ, ih]

lemma iteratedForwardDifference_const_mul
    (q : ℤ) (k : ℕ) (c : ℝ) (f : ℤ → ℝ) (j : ℤ) :
    iteratedForwardDifference q k (fun r ↦ c * f r) j =
      c * iteratedForwardDifference q k f j := by
  induction k generalizing j with
  | zero => rfl
  | succ k ih =>
      rw [iteratedForwardDifference_succ, forwardDifference,
        iteratedForwardDifference_succ, forwardDifference, ih, ih]
      ring

lemma iteratedForwardDifference_sub_fun
    (q : ℤ) (k : ℕ) (f g : ℤ → ℝ) (j : ℤ) :
    iteratedForwardDifference q k (fun x ↦ f x - g x) j =
      iteratedForwardDifference q k f j -
        iteratedForwardDifference q k g j := by
  induction k generalizing j with
  | zero => rfl
  | succ k ih =>
      rw [iteratedForwardDifference_succ, forwardDifference,
        iteratedForwardDifference_succ, forwardDifference,
        iteratedForwardDifference_succ, forwardDifference, ih, ih]
      ring

/-- Once base-step integer rigidity has been established on a sufficient
window, it propagates to a natural multiple of the base step without any
analytic smallness assumption at that multiple. -/
lemma iteratedForwardDifference_nat_mul_eq_centered_of_base
    (q : ℤ) (ell k : ℕ) (f : ℤ → ℝ) (j : ℤ)
    (hbase : ∀ v : ℕ, v ≤ k * ell →
      iteratedForwardDifference q k f (j + (v : ℤ) * q) =
        iteratedForwardDifference q k
          (fun x ↦ centeredModOne (f x)) (j + (v : ℤ) * q)) :
    iteratedForwardDifference ((ell : ℤ) * q) k f j =
      iteratedForwardDifference ((ell : ℤ) * q) k
        (fun x ↦ centeredModOne (f x)) j := by
  let g : ℤ → ℝ := fun x ↦ f x - centeredModOne (f x)
  have hzero : ∀ v : ℕ, v ≤ k * ell →
      iteratedForwardDifference q k g (j + (v : ℤ) * q) = 0 := by
    intro v hv
    rw [show iteratedForwardDifference q k g (j + (v : ℤ) * q) =
        iteratedForwardDifference q k f (j + (v : ℤ) * q) -
          iteratedForwardDifference q k
            (fun x ↦ centeredModOne (f x)) (j + (v : ℤ) * q) by
      exact iteratedForwardDifference_sub_fun q k f
        (fun x ↦ centeredModOne (f x)) _]
    rw [hbase v hv, sub_self]
  have hmultiple := iteratedForwardDifference_nat_mul_eq_zero_of_base
    q ell k g j hzero
  rw [show iteratedForwardDifference ((ell : ℤ) * q) k g j =
      iteratedForwardDifference ((ell : ℤ) * q) k f j -
        iteratedForwardDifference ((ell : ℤ) * q) k
          (fun x ↦ centeredModOne (f x)) j by
    exact iteratedForwardDifference_sub_fun ((ell : ℤ) * q) k f
      (fun x ↦ centeredModOne (f x)) j] at hmultiple
  linarith

/-- Iterated integer-coefficient differencing enlarges quotient-circle
errors by at most `2^k`. -/
lemma distance_iteratedForwardDifference_le
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (a : ℝ)
    (h : ∀ j, distanceToInteger (f j) ≤ a) (j : ℤ) :
    distanceToInteger (iteratedForwardDifference q k f j) ≤
      (2 : ℝ) ^ k * a := by
  induction k generalizing j with
  | zero => simpa using h j
  | succ k ih =>
      rw [iteratedForwardDifference_succ, forwardDifference]
      calc
        distanceToInteger
            (iteratedForwardDifference q k f (j + q) -
              iteratedForwardDifference q k f j) ≤
            distanceToInteger (iteratedForwardDifference q k f (j + q)) +
              distanceToInteger (iteratedForwardDifference q k f j) :=
          distanceToInteger_sub_le _ _
        _ ≤ (2 : ℝ) ^ k * a + (2 : ℝ) ^ k * a :=
          add_le_add (ih (j + q)) (ih j)
        _ = (2 : ℝ) ^ (k + 1) * a := by rw [pow_succ]; ring

/-- The corresponding real-norm estimate for iterated forward differences. -/
lemma abs_iteratedForwardDifference_le
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (a : ℝ)
    (h : ∀ j, |f j| ≤ a) (j : ℤ) :
    |iteratedForwardDifference q k f j| ≤ (2 : ℝ) ^ k * a := by
  induction k generalizing j with
  | zero => simpa using h j
  | succ k ih =>
      rw [iteratedForwardDifference_succ, forwardDifference]
      calc
        |iteratedForwardDifference q k f (j + q) -
            iteratedForwardDifference q k f j| ≤
            |iteratedForwardDifference q k f (j + q)| +
              |iteratedForwardDifference q k f j| := abs_sub _ _
        _ ≤ (2 : ℝ) ^ k * a + (2 : ℝ) ^ k * a :=
          add_le_add (ih (j + q)) (ih j)
        _ = (2 : ℝ) ^ (k + 1) * a := by rw [pow_succ]; ring

/-- Windowed version: the `k`-th difference at `j` only uses the points
`j+r q`, `0 ≤ r ≤ k`. -/
lemma distance_iteratedForwardDifference_le_window
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (a : ℝ) (j : ℤ)
    (h : ∀ r : ℕ, r ≤ k →
      distanceToInteger (f (j + (r : ℤ) * q)) ≤ a) :
    distanceToInteger (iteratedForwardDifference q k f j) ≤
      (2 : ℝ) ^ k * a := by
  induction k generalizing j with
  | zero =>
      simpa using h 0 (by omega)
  | succ k ih =>
      rw [iteratedForwardDifference_succ, forwardDifference]
      have hleft :
          distanceToInteger
              (iteratedForwardDifference q k f (j + q)) ≤
            (2 : ℝ) ^ k * a := by
        apply ih
        intro r hr
        rw [show j + q + (r : ℤ) * q =
            j + ((r + 1 : ℕ) : ℤ) * q by
          push_cast
          ring]
        exact h (r + 1) (by omega)
      have hright :
          distanceToInteger (iteratedForwardDifference q k f j) ≤
            (2 : ℝ) ^ k * a := by
        apply ih
        intro r hr
        exact h r (by omega)
      calc
        distanceToInteger
            (iteratedForwardDifference q k f (j + q) -
              iteratedForwardDifference q k f j) ≤
            distanceToInteger (iteratedForwardDifference q k f (j + q)) +
              distanceToInteger (iteratedForwardDifference q k f j) :=
          distanceToInteger_sub_le _ _
        _ ≤ (2 : ℝ) ^ k * a + (2 : ℝ) ^ k * a :=
          add_le_add hleft hright
        _ = (2 : ℝ) ^ (k + 1) * a := by rw [pow_succ]; ring

lemma abs_iteratedForwardDifference_le_window
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (a : ℝ) (j : ℤ)
    (h : ∀ r : ℕ, r ≤ k → |f (j + (r : ℤ) * q)| ≤ a) :
    |iteratedForwardDifference q k f j| ≤ (2 : ℝ) ^ k * a := by
  induction k generalizing j with
  | zero =>
      simpa using h 0 (by omega)
  | succ k ih =>
      rw [iteratedForwardDifference_succ, forwardDifference]
      have hleft :
          |iteratedForwardDifference q k f (j + q)| ≤
            (2 : ℝ) ^ k * a := by
        apply ih
        intro r hr
        rw [show j + q + (r : ℤ) * q =
            j + ((r + 1 : ℕ) : ℤ) * q by
          push_cast
          ring]
        exact h (r + 1) (by omega)
      have hright :
          |iteratedForwardDifference q k f j| ≤
            (2 : ℝ) ^ k * a := by
        apply ih
        intro r hr
        exact h r (by omega)
      calc
        |iteratedForwardDifference q k f (j + q) -
            iteratedForwardDifference q k f j| ≤
            |iteratedForwardDifference q k f (j + q)| +
              |iteratedForwardDifference q k f j| := abs_sub _ _
        _ ≤ (2 : ℝ) ^ k * a + (2 : ℝ) ^ k * a :=
          add_le_add hleft hright
        _ = (2 : ℝ) ^ (k + 1) * a := by rw [pow_succ]; ring

/-- Translating a shorter integer interval to the right stays inside a
larger interval, so a nonnegative sum over the translate is bounded by the
sum over the larger interval. -/
lemma sum_Ico_natShift_le (g : ℤ → ℝ) (hg : ∀ x, 0 ≤ g x)
    (j : ℤ) (q A B : ℕ) (hAB : A + q ≤ B) :
    ∑ x ∈ Finset.Ico j (j + A), g (x + q) ≤
      ∑ x ∈ Finset.Ico j (j + B), g x := by
  let e : ℤ → ℤ := fun x ↦ x + q
  have he : Function.Injective e := by
    intro x y hxy
    dsimp [e] at hxy
    omega
  have hsubset :
      (Finset.Ico j (j + A)).image e ⊆ Finset.Ico j (j + B) := by
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨x, hx, rfl⟩
    simp only [Finset.mem_Ico] at hx ⊢
    dsimp [e]
    constructor <;> omega
  calc
    ∑ x ∈ Finset.Ico j (j + A), g (x + q) =
        ∑ y ∈ (Finset.Ico j (j + A)).image e, g y := by
          rw [Finset.sum_image]
          intro x _hx y _hy hxy
          exact he hxy
    _ ≤ ∑ x ∈ Finset.Ico j (j + B), g x :=
      Finset.sum_le_sum_of_subset_of_nonneg hsubset
        (fun x _hx _hmem ↦ hg x)

/-- The squared `L²` norm of a `k`th forward difference on the part of a
window where it is defined is at most `4^k` times the squared norm of the
original sequence on the whole window. -/
lemma sum_sq_iteratedForwardDifference_le
    (q k W : ℕ) (f : ℤ → ℝ) (j : ℤ) (hfit : k * q ≤ W) :
    ∑ x ∈ Finset.Ico j (j + ((W - k * q : ℕ) : ℤ)),
        (iteratedForwardDifference (q : ℤ) k f x) ^ 2 ≤
      (4 : ℝ) ^ k * ∑ x ∈ Finset.Ico j (j + W), (f x) ^ 2 := by
  induction k with
  | zero =>
      simp [iteratedForwardDifference]
  | succ k ih =>
      have hfit' : k * q + q ≤ W := by
        simpa [Nat.add_mul] using hfit
      have hkfit : k * q ≤ W := by omega
      let A : ℕ := W - (k + 1) * q
      let B : ℕ := W - k * q
      let g : ℤ → ℝ := fun x ↦
        (iteratedForwardDifference (q : ℤ) k f x) ^ 2
      have hAqB : A + q ≤ B := by
        dsimp [A, B]
        have hmul : (k + 1) * q = k * q + q := by
          simp [Nat.add_mul]
        rw [hmul]
        omega
      have hbase :
          ∑ x ∈ Finset.Ico j (j + A), g x ≤
            ∑ x ∈ Finset.Ico j (j + B), g x := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro x hx
          simp only [Finset.mem_Ico] at hx ⊢
          constructor <;> omega
        · intro x _hx _hmem
          exact sq_nonneg _
      have hshift :
          ∑ x ∈ Finset.Ico j (j + A), g (x + q) ≤
            ∑ x ∈ Finset.Ico j (j + B), g x :=
        sum_Ico_natShift_le g (fun x ↦ sq_nonneg _) j q A B hAqB
      have hpoint : ∀ x : ℤ,
          (iteratedForwardDifference (q : ℤ) (k + 1) f x) ^ 2 ≤
            2 * g (x + q) + 2 * g x := by
        intro x
        rw [iteratedForwardDifference_succ, forwardDifference]
        dsimp [g]
        nlinarith [sq_nonneg
          (iteratedForwardDifference (q : ℤ) k f (x + q) +
            iteratedForwardDifference (q : ℤ) k f x)]
      have hstep :
          ∑ x ∈ Finset.Ico j (j + A),
              (iteratedForwardDifference (q : ℤ) (k + 1) f x) ^ 2 ≤
            4 * ∑ x ∈ Finset.Ico j (j + B), g x := by
        calc
          ∑ x ∈ Finset.Ico j (j + A),
              (iteratedForwardDifference (q : ℤ) (k + 1) f x) ^ 2 ≤
              ∑ x ∈ Finset.Ico j (j + A),
                (2 * g (x + q) + 2 * g x) :=
            Finset.sum_le_sum fun x _hx ↦ hpoint x
          _ = 2 * (∑ x ∈ Finset.Ico j (j + A), g (x + q)) +
              2 * (∑ x ∈ Finset.Ico j (j + A), g x) := by
            simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
          _ ≤ 2 * (∑ x ∈ Finset.Ico j (j + B), g x) +
              2 * (∑ x ∈ Finset.Ico j (j + B), g x) := by
            gcongr
          _ = 4 * ∑ x ∈ Finset.Ico j (j + B), g x := by ring
      have hind := ih hkfit
      change
        ∑ x ∈ Finset.Ico j (j + A),
            (iteratedForwardDifference (q : ℤ) (k + 1) f x) ^ 2 ≤
          (4 : ℝ) ^ (k + 1) *
            ∑ x ∈ Finset.Ico j (j + W), (f x) ^ 2
      calc
        ∑ x ∈ Finset.Ico j (j + A),
            (iteratedForwardDifference (q : ℤ) (k + 1) f x) ^ 2 ≤
            4 * ∑ x ∈ Finset.Ico j (j + B), g x := hstep
        _ ≤ 4 * ((4 : ℝ) ^ k *
            ∑ x ∈ Finset.Ico j (j + W), (f x) ^ 2) := by
          apply mul_le_mul_of_nonneg_left _ (by norm_num)
          simpa [B, g] using hind
        _ = (4 : ℝ) ^ (k + 1) *
            ∑ x ∈ Finset.Ico j (j + W), (f x) ^ 2 := by
          rw [pow_succ]
          ring

lemma sum_range_natShift_le (g : ℕ → ℝ) (hg : ∀ x, 0 ≤ g x)
    (q A B : ℕ) (hAB : A + q ≤ B) :
    ∑ x ∈ Finset.range A, g (x + q) ≤
      ∑ x ∈ Finset.range B, g x := by
  let e : ℕ → ℕ := fun x ↦ x + q
  have he : Function.Injective e := by
    intro x y hxy
    dsimp [e] at hxy
    omega
  have hsubset : (Finset.range A).image e ⊆ Finset.range B := by
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨x, hx, rfl⟩
    simp only [Finset.mem_range] at hx ⊢
    dsimp [e]
    omega
  calc
    ∑ x ∈ Finset.range A, g (x + q) =
        ∑ y ∈ (Finset.range A).image e, g y := by
          rw [Finset.sum_image]
          intro x _hx y _hy hxy
          exact he hxy
    _ ≤ ∑ x ∈ Finset.range B, g x :=
      Finset.sum_le_sum_of_subset_of_nonneg hsubset
        (fun x _hx _hmem ↦ hg x)

/-- Range-indexed version of `sum_sq_iteratedForwardDifference_le`, suited
to the natural indexing of a good block. -/
lemma sum_sq_iteratedForwardDifference_range_le
    (q k W : ℕ) (f : ℤ → ℝ) (j : ℤ) (hfit : k * q ≤ W) :
    ∑ v ∈ Finset.range (W - k * q),
        (iteratedForwardDifference (q : ℤ) k f (j + v)) ^ 2 ≤
      (4 : ℝ) ^ k *
        ∑ r ∈ Finset.range W, (f (j + r)) ^ 2 := by
  induction k with
  | zero =>
      simp [iteratedForwardDifference]
  | succ k ih =>
      have hfit' : k * q + q ≤ W := by
        simpa [Nat.add_mul] using hfit
      have hkfit : k * q ≤ W := by omega
      let A : ℕ := W - (k + 1) * q
      let B : ℕ := W - k * q
      let g : ℕ → ℝ := fun v ↦
        (iteratedForwardDifference (q : ℤ) k f (j + v)) ^ 2
      have hAqB : A + q ≤ B := by
        dsimp [A, B]
        have hmul : (k + 1) * q = k * q + q := by
          simp [Nat.add_mul]
        rw [hmul]
        omega
      have hbase :
          ∑ v ∈ Finset.range A, g v ≤
            ∑ v ∈ Finset.range B, g v := by
        apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono (by omega))
        intro v _hv _hmem
        exact sq_nonneg _
      have hshift :
          ∑ v ∈ Finset.range A, g (v + q) ≤
            ∑ v ∈ Finset.range B, g v :=
        sum_range_natShift_le g (fun v ↦ sq_nonneg _) q A B hAqB
      have hpoint : ∀ v : ℕ,
          (iteratedForwardDifference (q : ℤ) (k + 1) f (j + v)) ^ 2 ≤
            2 * g (v + q) + 2 * g v := by
        intro v
        rw [iteratedForwardDifference_succ, forwardDifference]
        have harg : (j + (v : ℤ)) + (q : ℤ) =
            j + ((v + q : ℕ) : ℤ) := by
          push_cast
          ring
        rw [harg]
        dsimp [g]
        let X : ℝ := iteratedForwardDifference (q : ℤ) k f
          (j + ((v : ℤ) + (q : ℤ)))
        let Y : ℝ := iteratedForwardDifference (q : ℤ) k f (j + v)
        change (X - Y) ^ 2 ≤ 2 * X ^ 2 + 2 * Y ^ 2
        nlinarith [sq_nonneg (X + Y)]
      have hstep :
          ∑ v ∈ Finset.range A,
              (iteratedForwardDifference (q : ℤ) (k + 1) f (j + v)) ^ 2 ≤
            4 * ∑ v ∈ Finset.range B, g v := by
        calc
          ∑ v ∈ Finset.range A,
              (iteratedForwardDifference (q : ℤ) (k + 1) f (j + v)) ^ 2 ≤
              ∑ v ∈ Finset.range A,
                (2 * g (v + q) + 2 * g v) :=
            Finset.sum_le_sum fun v _hv ↦ hpoint v
          _ = 2 * (∑ v ∈ Finset.range A, g (v + q)) +
              2 * (∑ v ∈ Finset.range A, g v) := by
            simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
          _ ≤ 2 * (∑ v ∈ Finset.range B, g v) +
              2 * (∑ v ∈ Finset.range B, g v) := by
            gcongr
          _ = 4 * ∑ v ∈ Finset.range B, g v := by ring
      have hind := ih hkfit
      change
        ∑ v ∈ Finset.range A,
            (iteratedForwardDifference (q : ℤ) (k + 1) f (j + v)) ^ 2 ≤
          (4 : ℝ) ^ (k + 1) *
            ∑ r ∈ Finset.range W, (f (j + r)) ^ 2
      calc
        ∑ v ∈ Finset.range A,
            (iteratedForwardDifference (q : ℤ) (k + 1) f (j + v)) ^ 2 ≤
            4 * ∑ v ∈ Finset.range B, g v := hstep
        _ ≤ 4 * ((4 : ℝ) ^ k *
            ∑ r ∈ Finset.range W, (f (j + r)) ^ 2) := by
          apply mul_le_mul_of_nonneg_left _ (by norm_num)
          simpa [B, g] using hind
        _ = (4 : ℝ) ^ (k + 1) *
            ∑ r ∈ Finset.range W, (f (j + r)) ^ 2 := by
          rw [pow_succ]
          ring

/-- If the quotient error of a real number is below `1/2`, the centered
representative realizes it without ambiguity. -/
lemma abs_centeredModOne_eq_distanceToInteger (x : ℝ) :
    |centeredModOne x| = distanceToInteger x := rfl

/-- Pointwise centered representatives inherit the global lattice-energy
bound, a form used before applying ordinary differences. -/
lemma abs_centeredModOne_le_sqrt_energy {I : Type*} [Fintype I]
    (f : I → ℝ) (i : I) :
    |centeredModOne (f i)| ≤
      Real.sqrt (∑ j, distanceToInteger (f j) ^ 2) := by
  have hnonneg : 0 ≤ ∑ j, distanceToInteger (f j) ^ 2 := by positivity
  rw [abs_centeredModOne_eq_distanceToInteger]
  rw [← sq_le_sq₀ (distanceToInteger_nonneg (f i)) (Real.sqrt_nonneg _)]
  rw [Real.sq_sqrt hnonneg]
  exact Finset.single_le_sum (fun j _ ↦ sq_nonneg (distanceToInteger (f j)))
    (Finset.mem_univ i)

/-- Ordinary differences of a function and of its centered quotient
representatives differ by an integer. -/
lemma exists_int_add_iteratedForwardDifference_centered
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (j : ℤ) :
    ∃ z : ℤ,
      iteratedForwardDifference q k f j =
        z + iteratedForwardDifference q k (fun r ↦ centeredModOne (f r)) j := by
  induction k generalizing j with
  | zero =>
      rcases exists_int_add_centeredModOne (f j) with ⟨z, hz⟩
      exact ⟨z, by simpa using hz⟩
  | succ k ih =>
      rcases ih (j + q) with ⟨z₁, hz₁⟩
      rcases ih j with ⟨z₀, hz₀⟩
      refine ⟨z₁ - z₀, ?_⟩
      rw [iteratedForwardDifference_succ, iteratedForwardDifference_succ,
        forwardDifference, forwardDifference, hz₁, hz₀]
      push_cast
      ring

/-- Rigidity below the unit lattice spacing: if an ordinary difference and
the corresponding difference of centered representatives have total error
strictly below one, the intervening integer is zero. -/
lemma iteratedForwardDifference_eq_centered_of_abs_add_lt_one
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (j : ℤ)
    (A B : ℝ)
    (hactual : |iteratedForwardDifference q k f j| ≤ A)
    (hcentered :
      |iteratedForwardDifference q k
        (fun r ↦ centeredModOne (f r)) j| ≤ B)
    (hsmall : A + B < 1) :
    iteratedForwardDifference q k f j =
      iteratedForwardDifference q k
        (fun r ↦ centeredModOne (f r)) j := by
  rcases exists_int_add_iteratedForwardDifference_centered q k f j with
    ⟨z, hz⟩
  have hzrepr : (z : ℝ) =
      iteratedForwardDifference q k f j -
        iteratedForwardDifference q k
          (fun r ↦ centeredModOne (f r)) j := by
    linarith
  have hzabs : |(z : ℝ)| < 1 := by
    rw [hzrepr]
    calc
      |iteratedForwardDifference q k f j -
          iteratedForwardDifference q k
            (fun r ↦ centeredModOne (f r)) j| ≤
          |iteratedForwardDifference q k f j| +
            |iteratedForwardDifference q k
              (fun r ↦ centeredModOne (f r)) j| := abs_sub _ _
      _ ≤ A + B := add_le_add hactual hcentered
      _ < 1 := hsmall
  have hzrange := abs_lt.mp hzabs
  have hzlower : (-1 : ℤ) < z := by exact_mod_cast hzrange.1
  have hzupper : z < (1 : ℤ) := by exact_mod_cast hzrange.2
  have hz0 : z = 0 := by omega
  simpa [hz0] using hz

lemma distance_iteratedForwardDifference_eq_centered
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (j : ℤ) :
    distanceToInteger (iteratedForwardDifference q k f j) =
      distanceToInteger
        (iteratedForwardDifference q k (fun r ↦ centeredModOne (f r)) j) := by
  rcases exists_int_add_iteratedForwardDifference_centered q k f j with ⟨z, hz⟩
  rw [hz, add_comm]
  exact distanceToInteger_add_int _ z

lemma distanceToInteger_nsmul_le (q : ℕ) (x : ℝ) :
    distanceToInteger (q * x) ≤ q * distanceToInteger x := by
  induction q with
  | zero => simp
  | succ q ih =>
      rw [Nat.cast_succ, add_mul, one_mul]
      calc
        distanceToInteger ((q : ℝ) * x + x) ≤
            distanceToInteger ((q : ℝ) * x) + distanceToInteger x :=
          distanceToInteger_add_le _ _
        _ ≤ q * distanceToInteger x + distanceToInteger x := by gcongr
        _ = (q + 1) * distanceToInteger x := by ring

lemma centeredModOne_eq_of_mem (x y : ℝ)
    (hy : y ∈ Set.Ioc (-1 / 2) (1 / 2))
    (hxy : ∃ k : ℤ, x = k + y) :
    centeredModOne x = y := by
  unfold centeredModOne
  apply (toIocMod_eq_iff (by norm_num : (0 : ℝ) < 1)).2
  refine ⟨by convert hy using 1 <;> norm_num, ?_⟩
  rcases hxy with ⟨k, hk⟩
  refine ⟨k, ?_⟩
  simpa only [zsmul_eq_mul, mul_one, add_comm] using hk

/-- Before the centered representative wraps around the quotient circle,
distance to the nearest integer scales exactly under multiplication. -/
lemma distanceToInteger_nsmul_eq (q : ℕ) (x : ℝ)
    (hsmall : q * distanceToInteger x < 1 / 2) :
    distanceToInteger (q * x) = q * distanceToInteger x := by
  rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
  have hq : (0 : ℝ) ≤ q := Nat.cast_nonneg q
  have habs : |(q : ℝ) * centeredModOne x| < 1 / 2 := by
    rw [abs_mul, abs_of_nonneg hq]
    exact hsmall
  have hmem : (q : ℝ) * centeredModOne x ∈ Set.Ioc (-1 / 2) (1 / 2) := by
    have hb := (abs_lt.mp habs)
    constructor
    · norm_num at hb ⊢
      exact hb.1
    · exact hb.2.le
  have hrepr : ∃ l : ℤ,
      (q : ℝ) * x = l + (q : ℝ) * centeredModOne x := by
    refine ⟨(q : ℤ) * k, ?_⟩
    calc
      (q : ℝ) * x = (q : ℝ) * ((k : ℝ) + centeredModOne x) :=
        congrArg (fun y : ℝ ↦ (q : ℝ) * y) hk
      _ = (((q : ℤ) * k : ℤ) : ℝ) + (q : ℝ) * centeredModOne x := by
        push_cast
        ring
  rw [distanceToInteger, centeredModOne_eq_of_mem _ _ hmem hrepr,
    abs_mul, abs_of_nonneg hq]
  rfl

lemma distanceToInteger_eq_abs_of_abs_lt_half {x : ℝ}
    (hx : |x| < 1 / 2) : distanceToInteger x = |x| := by
  have hmem : x ∈ Set.Ioc (-1 / 2) (1 / 2) := by
    have hb := abs_lt.mp hx
    constructor
    · norm_num at hb ⊢
      exact hb.1
    · exact hb.2.le
  rw [distanceToInteger, centeredModOne_eq_of_mem x x hmem]
  exact ⟨0, by norm_num⟩

/-- Below the wrap threshold, the modular size of an ordinary difference
is the actual size of the same difference applied to centered residues. -/
lemma distance_iteratedForwardDifference_eq_abs_centered
    (q : ℤ) (k : ℕ) (f : ℤ → ℝ) (j : ℤ)
    (hsmall :
      |iteratedForwardDifference q k
        (fun r ↦ centeredModOne (f r)) j| < 1 / 2) :
    distanceToInteger (iteratedForwardDifference q k f j) =
      |iteratedForwardDifference q k
        (fun r ↦ centeredModOne (f r)) j| := by
  rw [distance_iteratedForwardDifference_eq_centered]
  exact distanceToInteger_eq_abs_of_abs_lt_half hsmall

/-- Simultaneous Dirichlet approximation in the quotient-distance notation
used by the phase-space argument. -/
lemma simultaneousDirichlet_distance {E : Type*} [Fintype E]
    (alpha : E → ℝ) (Q : ℕ) (hQ : 0 < Q) :
    ∃ q : ℕ, 1 ≤ q ∧ q ≤ Q ^ Fintype.card E ∧
      ∀ e, distanceToInteger (q * alpha e) < (1 : ℝ) / Q := by
  rcases Erdos485.simultaneous_dirichlet_mul alpha Q hQ with
    ⟨q, hq1, hqQ, happrox⟩
  refine ⟨q, hq1, hqQ, ?_⟩
  intro e
  rcases happrox e with ⟨z, hz⟩
  exact (distanceToInteger_minimal ((q : ℝ) * alpha e) z).trans_lt hz

/-- Finite Markov inequality for a squared-energy sum, in the exact counting
form used to discard the few lattice coordinates with large error. -/
lemma card_large_sq_mul_le_sum_sq {I : Type*} [Fintype I]
    (f : I → ℝ) (a : ℝ) (ha : 0 ≤ a) :
    (((Finset.univ.filter fun i ↦ a < |f i|).card : ℕ) : ℝ) * a ^ 2 ≤
      ∑ i, (f i) ^ 2 := by
  let s : Finset I := Finset.univ.filter fun i ↦ a < |f i|
  have hterm : ∀ i ∈ s, a ^ 2 ≤ f i ^ 2 := by
    intro i hi
    have hi' : a < |f i| := by simpa [s] using hi
    nlinarith [sq_abs (f i), abs_nonneg (f i)]
  calc
    ((s.card : ℕ) : ℝ) * a ^ 2 = ∑ _i ∈ s, a ^ 2 := by simp
    _ ≤ ∑ i ∈ s, f i ^ 2 := Finset.sum_le_sum hterm
    _ ≤ ∑ i, f i ^ 2 := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · exact Finset.subset_univ s
      · intro i _ _
        exact sq_nonneg _

/-- Applied to quotient representatives: small total lattice energy forces
all but a quantitatively bounded number of coordinates to be close to an
integer. -/
lemma card_distance_large_mul_le_energy {I : Type*} [Fintype I]
    (f : I → ℝ) (a : ℝ) (ha : 0 ≤ a) :
    (((Finset.univ.filter fun i ↦
        a < distanceToInteger (f i)).card : ℕ) : ℝ) * a ^ 2 ≤
      ∑ i, distanceToInteger (f i) ^ 2 := by
  unfold distanceToInteger
  simpa only [sq_abs] using
    card_large_sq_mul_le_sum_sq (fun i ↦ centeredModOne (f i)) a ha

/-- A finite set of bad indices leaves a consecutive good block whose
length is the ambient length divided by one more than the number of bad
indices.  The quantitative form avoids sorting the bad set. -/
lemma exists_good_block_of_mul_card_succ_le
    (N W : ℕ) (bad : Finset ℕ) (hW : 0 < W)
    (hfit : W * (bad.card + 1) ≤ N) :
    ∃ s : ℕ, s + W ≤ N ∧
      ∀ r : ℕ, r < W → s + r ∉ bad := by
  classical
  by_contra hnone
  push Not at hnone
  have hfind : ∀ i : Fin (bad.card + 1),
      ∃ r : ℕ, r < W ∧ i.val * W + r ∈ bad := by
    intro i
    have hi : i.val + 1 ≤ bad.card + 1 := by omega
    have hmul : W * (i.val + 1) ≤ W * (bad.card + 1) :=
      Nat.mul_le_mul_left W hi
    have hbound : i.val * W + W ≤ N := by
      calc
        i.val * W + W = W * (i.val + 1) := by ring
        _ ≤ W * (bad.card + 1) := hmul
        _ ≤ N := hfit
    exact hnone (i.val * W) hbound
  let offset : Fin (bad.card + 1) → ℕ := fun i ↦ Classical.choose (hfind i)
  have hoffset : ∀ i, offset i < W := fun i ↦ (Classical.choose_spec (hfind i)).1
  have hoffsetMem : ∀ i, i.val * W + offset i ∈ bad := fun i ↦
    (Classical.choose_spec (hfind i)).2
  let pick : Fin (bad.card + 1) → {a // a ∈ bad} := fun i ↦
    ⟨i.val * W + offset i, hoffsetMem i⟩
  have hpick : Function.Injective pick := by
    intro i j hij
    apply Fin.ext
    by_contra hne
    rcases lt_or_gt_of_ne hne with hijlt | hjilt
    · have hnext : (i.val + 1) * W ≤ j.val * W :=
        Nat.mul_le_mul_right W (by omega)
      have hbefore : i.val * W + offset i < (i.val + 1) * W := by
        calc
          i.val * W + offset i < i.val * W + W :=
            Nat.add_lt_add_left (hoffset i) _
          _ = (i.val + 1) * W := by ring
      have hval := congrArg (fun a : {a // a ∈ bad} ↦ a.1) hij
      have hafter : j.val * W ≤ j.val * W + offset j := Nat.le_add_right _ _
      exact (ne_of_lt (hbefore.trans_le (hnext.trans hafter))) hval
    · have hnext : (j.val + 1) * W ≤ i.val * W :=
        Nat.mul_le_mul_right W (by omega)
      have hbefore : j.val * W + offset j < (j.val + 1) * W := by
        calc
          j.val * W + offset j < j.val * W + W :=
            Nat.add_lt_add_left (hoffset j) _
          _ = (j.val + 1) * W := by ring
      have hval := congrArg (fun a : {a // a ∈ bad} ↦ a.1) hij
      have hafter : i.val * W ≤ i.val * W + offset i := Nat.le_add_right _ _
      exact (ne_of_gt (hbefore.trans_le (hnext.trans hafter))) hval
  have hcard := Fintype.card_le_of_injective pick hpick
  simpa using hcard

/-- Compatibility with the quotient-circle norm used by the rotation-energy
lemmas in `Erdos358`. -/
lemma distanceToInteger_eq_circleDist (x : ℝ) :
    distanceToInteger x = Erdos358.LocalLimit.circleDist x := by
  rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
  let y : ℝ := centeredModOne x
  have hk' : x = (k : ℝ) + y := by simpa [y] using hk
  have hkzero : (((k : ℤ) : ℝ) : AddCircle (1 : ℝ)) = 0 := by
    rw [AddCircle.coe_eq_zero_iff]
    exact ⟨k, by simp⟩
  have hquot : (x : AddCircle (1 : ℝ)) = (y : AddCircle (1 : ℝ)) := by
    rw [hk']
    rw [QuotientAddGroup.mk_add, hkzero, zero_add]
  have hcircle : Erdos358.LocalLimit.circleDist x =
      Erdos358.LocalLimit.circleDist y := congrArg norm hquot
  have hy : |y| ≤ 1 / 2 := by simpa [y] using abs_centeredModOne_le_half x
  rw [hcircle, Erdos358.LocalLimit.circleDist_eq_abs hy]
  simp [distanceToInteger, y]

lemma distance_nsmul_eq_circleDist_abs_centered (q : ℕ) (x : ℝ) :
    distanceToInteger (q * x) =
      Erdos358.LocalLimit.circleDist
        (q * distanceToInteger x) := by
  rw [distanceToInteger_eq_circleDist]
  unfold Erdos358.LocalLimit.circleDist
  rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
  let y : ℝ := centeredModOne x
  have hk' : x = (k : ℝ) + y := by simpa [y] using hk
  have hkzero : (((k : ℤ) : ℝ) : AddCircle (1 : ℝ)) = 0 := by
    rw [AddCircle.coe_eq_zero_iff]
    exact ⟨k, by simp⟩
  have hquot : (x : AddCircle (1 : ℝ)) = (y : AddCircle (1 : ℝ)) := by
    rw [hk']
    rw [QuotientAddGroup.mk_add, hkzero, zero_add]
  have hmul :
      ((((q : ℝ) * x : ℝ) : AddCircle (1 : ℝ))) =
        (((q : ℝ) * y : ℝ) : AddCircle (1 : ℝ)) := by
    have hq := congrArg (fun z : AddCircle (1 : ℝ) ↦ q • z) hquot
    simpa [nsmul_eq_mul] using hq
  rw [hmul]
  change ‖(((q : ℝ) * y : ℝ) : AddCircle (1 : ℝ))‖ =
    ‖(((q : ℝ) * |y| : ℝ) : AddCircle (1 : ℝ))‖
  by_cases hy : 0 ≤ y
  · rw [abs_of_nonneg hy]
  · rw [abs_of_nonpos (le_of_not_ge hy)]
    have hneg : (((q : ℝ) * -y : ℝ) : AddCircle (1 : ℝ)) =
        -(((q : ℝ) * y : ℝ) : AddCircle (1 : ℝ)) := by
      push_cast
      simp
    rw [hneg, norm_neg]

lemma exists_mem_ge_of_card_mul_le_sum {I : Type*} [DecidableEq I]
    (s : Finset I) (hs : s.Nonempty) (f : I → ℝ) (c : ℝ)
    (h : (s.card : ℝ) * c ≤ ∑ i ∈ s, f i) :
    ∃ i ∈ s, c ≤ f i := by
  by_contra hnone
  push Not at hnone
  have hlt : (∑ i ∈ s, f i) < ∑ _i ∈ s, c :=
    Finset.sum_lt_sum_of_nonempty hs fun i hi ↦ hnone i hi
  simp only [Finset.sum_const, nsmul_eq_mul] at hlt
  exact (not_lt_of_ge h) hlt

lemma rotationEnergy_distance (q : ℕ) (x : ℝ) :
    Erdos358.LocalLimit.rotationEnergy q (distanceToInteger x) =
      ∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2 := by
  unfold Erdos358.LocalLimit.rotationEnergy
  apply Finset.sum_congr rfl
  intro r _hr
  rw [distance_nsmul_eq_circleDist_abs_centered]

/-- Propagation from a block of small multiples.  If every one of the first
`q-1` multiples is within `δ < 1/64` of the integer lattice, the original
point is within `8000 δ/q`.  This packages the two rotation-energy regimes
from `Erdos358`. -/
lemma distanceToInteger_le_of_multiples_le
    (q : ℕ) (x δ : ℝ) (hq : 800 ≤ q)
    (hδ0 : 0 ≤ δ) (hδsmall : δ < 1 / 64)
    (hmul : ∀ r ∈ Finset.Ico 1 q,
      distanceToInteger (r * x) ≤ δ) :
    distanceToInteger x ≤ 8000 * δ / q := by
  let d : ℝ := distanceToInteger x
  have hq0 : 0 < q := by omega
  have hqreal : (0 : ℝ) < q := by exact_mod_cast hq0
  have hd0 : 0 ≤ d := by simpa [d] using distanceToInteger_nonneg x
  have hdhalf : d ≤ 1 / 2 := by simpa [d] using distanceToInteger_le_half x
  have henergyUpper :
      Erdos358.LocalLimit.rotationEnergy q d ≤ (q : ℝ) * δ ^ 2 := by
    rw [show Erdos358.LocalLimit.rotationEnergy q d =
        ∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2 by
      simpa [d] using rotationEnergy_distance q x]
    calc
      (∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2) ≤
          ∑ _r ∈ Finset.Ico 1 q, δ ^ 2 := by
        apply Finset.sum_le_sum
        intro r hr
        exact pow_le_pow_left₀ (distanceToInteger_nonneg (r * x))
          (hmul r hr) 2
      _ = ((Finset.Ico 1 q).card : ℝ) * δ ^ 2 := by simp
      _ ≤ (q : ℝ) * δ ^ 2 := by
        gcongr
        norm_cast
        simp
  by_cases hd : d = 0
  · change d ≤ _
    rw [hd]
    positivity
  have hdpos : 0 < d := lt_of_le_of_ne hd0 (Ne.symm hd)
  have hdsmall : d ≤ 10 / (q : ℝ) := by
    by_contra hnot
    have hdlarge : 10 / (q : ℝ) ≤ d := le_of_not_ge hnot
    have hlower := Erdos358.LocalLimit.rotationEnergy_large q d
      (by omega) hdpos hdlarge hdhalf
    have hsq : (1 / 64 : ℝ) ^ 2 ≤ δ ^ 2 := by
      have := hlower.trans henergyUpper
      nlinarith
    nlinarith [sq_nonneg (δ - 1 / 64)]
  have hlower := Erdos358.LocalLimit.rotationEnergy_small q d hq hd0 hdsmall
  have hsquare : ((q : ℝ) * d) ^ 2 ≤ (8000 * δ) ^ 2 := by
    have := hlower.trans henergyUpper
    nlinarith
  have hleft : 0 ≤ (q : ℝ) * d := mul_nonneg hqreal.le hd0
  have hright : 0 ≤ 8000 * δ := by positivity
  have hlinear : (q : ℝ) * d ≤ 8000 * δ := by nlinarith
  exact (le_div_iff₀ hqreal).2 (by simpa [d, mul_comm] using hlinear)

noncomputable def singleDilationScale (q : ℕ) (x : ℝ) : ℝ :=
  min (1 / 64) ((q : ℝ) * distanceToInteger x / 8000)

/-- One-coordinate dilation.  Among the first `q-1` multiples, one moves a
nonzero circle point a controlled distance from the integer lattice.  This is
the individual-step substitute for simultaneous dilation in the covariance
argument. -/
theorem exists_singleDilation
    (q : ℕ) (x : ℝ) (hq : 800 ≤ q)
    (hx : 0 < distanceToInteger x) :
    ∃ r ∈ Finset.Ico 1 q,
      singleDilationScale q x ≤ distanceToInteger (r * x) := by
  let d : ℝ := distanceToInteger x
  have hd0 : 0 < d := by simpa [d] using hx
  have hdhalf : d ≤ 1 / 2 := by simpa [d] using distanceToInteger_le_half x
  have hs : (Finset.Ico 1 q).Nonempty := by
    refine ⟨1, ?_⟩
    simp
    omega
  have hcard : ((Finset.Ico 1 q).card : ℝ) ≤ q := by
    norm_cast
    simp
  by_cases hlarge : 10 / (q : ℝ) ≤ d
  · have henergy := Erdos358.LocalLimit.rotationEnergy_large q d
      (by omega) hd0 hlarge hdhalf
    rw [rotationEnergy_distance q x] at henergy
    have hcardmul : ((Finset.Ico 1 q).card : ℝ) * (1 / 4096 : ℝ) ≤
        ∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2 := by
      calc
        ((Finset.Ico 1 q).card : ℝ) * (1 / 4096 : ℝ) ≤
            (q : ℝ) * (1 / 4096 : ℝ) :=
          mul_le_mul_of_nonneg_right hcard (by norm_num)
        _ = (q : ℝ) / 4096 := by ring
        _ ≤ ∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2 := henergy
    rcases exists_mem_ge_of_card_mul_le_sum (Finset.Ico 1 q) hs
      (fun r ↦ distanceToInteger (r * x) ^ 2) (1 / 4096) hcardmul with
      ⟨r, hr, hrSq⟩
    have hr0 := distanceToInteger_nonneg (r * x)
    have hrLower : 1 / 64 ≤ distanceToInteger (r * x) := by
      nlinarith
    exact ⟨r, hr, (min_le_left _ _).trans hrLower⟩
  · have hsmall : d ≤ 10 / (q : ℝ) := le_of_not_ge hlarge
    have henergy := Erdos358.LocalLimit.rotationEnergy_small q d hq
      hd0.le hsmall
    rw [rotationEnergy_distance q x] at henergy
    let c : ℝ := (q : ℝ) ^ 2 * d ^ 2 / 64000000
    have hc0 : 0 ≤ c := by positivity
    have hcardmul : ((Finset.Ico 1 q).card : ℝ) * c ≤
        ∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2 := by
      calc
        ((Finset.Ico 1 q).card : ℝ) * c ≤ (q : ℝ) * c :=
          mul_le_mul_of_nonneg_right hcard hc0
        _ = (q : ℝ) ^ 3 * d ^ 2 / 64000000 := by simp [c]; ring
        _ ≤ ∑ r ∈ Finset.Ico 1 q, distanceToInteger (r * x) ^ 2 := henergy
    rcases exists_mem_ge_of_card_mul_le_sum (Finset.Ico 1 q) hs
      (fun r ↦ distanceToInteger (r * x) ^ 2) c hcardmul with
      ⟨r, hr, hrSq⟩
    have hr0 := distanceToInteger_nonneg (r * x)
    have hqd0 : 0 ≤ (q : ℝ) * d / 8000 := by positivity
    have hcEq : c = ((q : ℝ) * d / 8000) ^ 2 := by
      simp [c]
      ring
    rw [hcEq] at hrSq
    have hrLower : (q : ℝ) * d / 8000 ≤ distanceToInteger (r * x) := by
      nlinarith
    exact ⟨r, hr, (min_le_right _ _).trans (by simpa [d] using hrLower)⟩

/-- The standard unit-circle parametrization with period one. -/
noncomputable def circleExp (x : ℝ) : ℂ :=
  Complex.exp ((((2 * Real.pi * x : ℝ) : ℂ) * Complex.I))

lemma circleExp_add_int (x : ℝ) (k : ℤ) :
    circleExp (x + k) = circleExp x := by
  unfold circleExp
  have harg :
      ((((2 * Real.pi * (x + k) : ℝ) : ℂ) * Complex.I)) =
        (((k : ℂ) * (2 * Real.pi * Complex.I)) +
          (((2 * Real.pi * x : ℝ) : ℂ) * Complex.I)) := by
    push_cast
    ring
  rw [harg, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I]
  simp

lemma circleExp_centeredModOne (x : ℝ) :
    circleExp x = circleExp (centeredModOne x) := by
  rcases exists_int_add_centeredModOne x with ⟨k, hk⟩
  calc
    circleExp x = circleExp ((k : ℝ) + centeredModOne x) := congrArg circleExp hk
    _ = circleExp (centeredModOne x + k) := by rw [add_comm]
    _ = circleExp (centeredModOne x) := circleExp_add_int _ _

lemma norm_circleExp_sub_one (x : ℝ) :
    ‖circleExp x - 1‖ =
      2 * |Real.sin (Real.pi * centeredModOne x)| := by
  rw [circleExp_centeredModOne]
  unfold circleExp
  rw [show ((((2 * Real.pi * centeredModOne x : ℝ) : ℂ) * Complex.I)) =
      Complex.I * ((2 * Real.pi * centeredModOne x : ℝ) : ℂ) by ring]
  rw [Complex.norm_exp_I_mul_ofReal_sub_one]
  rw [show 2 * Real.pi * centeredModOne x / 2 =
      Real.pi * centeredModOne x by ring]
  simp

/-- Chord length controls quotient-circle distance with an explicit constant. -/
lemma four_mul_distanceToInteger_le_norm_circleExp_sub_one (x : ℝ) :
    4 * distanceToInteger x ≤ ‖circleExp x - 1‖ := by
  rw [norm_circleExp_sub_one]
  have hd := abs_centeredModOne_le_half x
  have harg : |Real.pi * centeredModOne x| ≤ Real.pi / 2 := by
    rw [abs_mul, abs_of_pos Real.pi_pos]
    nlinarith [Real.pi_pos]
  have hj := Real.mul_abs_le_abs_sin harg
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  have hsimplify :
      2 / Real.pi * |Real.pi * centeredModOne x| =
        2 * distanceToInteger x := by
    rw [abs_mul, abs_of_pos Real.pi_pos]
    unfold distanceToInteger
    field_simp
  rw [hsimplify] at hj
  linarith

/-- The converse elementary chord estimate.  Together with the previous
lemma this compares the quotient-circle distance and the Euclidean chord
with explicit absolute constants. -/
lemma norm_circleExp_sub_one_le_two_pi_mul_distanceToInteger (x : ℝ) :
    ‖circleExp x - 1‖ ≤
      2 * Real.pi * distanceToInteger x := by
  rw [norm_circleExp_sub_one]
  have hsin := Real.abs_sin_le_abs (x := Real.pi * centeredModOne x)
  have hpi : 0 ≤ Real.pi := Real.pi_pos.le
  calc
    2 * |Real.sin (Real.pi * centeredModOne x)| ≤
        2 * |Real.pi * centeredModOne x| :=
      mul_le_mul_of_nonneg_left hsin (by norm_num)
    _ = 2 * Real.pi * distanceToInteger x := by
      rw [abs_mul, abs_of_nonneg hpi]
      simp [distanceToInteger]
      ring

/-- Exact reduction of Fourier decay to a sum of squared quotient-circle
distances.  This is the finite-cube symmetrization step in the
Cook--Nguyen argument. -/
noncomputable def phaseLatticeEnergy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ) : ℝ :=
  ∑ j : Fin (2 * n + 1),
    distanceToInteger (t * phaseProjection n points u j / Real.pi) ^ 2

lemma phaseLatticeEnergy_nonneg
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ) :
    0 ≤ phaseLatticeEnergy n points u t := by
  unfold phaseLatticeEnergy
  positivity

/-- Natural-number encoding of the finite phase indices whose quotient
distance exceeds a chosen threshold. -/
noncomputable def phaseBadIndices
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t a : ℝ) : Finset ℕ :=
  (Finset.univ.filter fun j : Fin (2 * n + 1) ↦
    a < distanceToInteger (t * phaseProjection n points u j / Real.pi)).image
      Fin.val

lemma phaseBadIndices_card_mul_le_latticeEnergy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t a : ℝ) (ha : 0 ≤ a) :
    ((phaseBadIndices n points u t a).card : ℝ) * a ^ 2 ≤
      phaseLatticeEnergy n points u t := by
  have hcard : (phaseBadIndices n points u t a).card =
      (Finset.univ.filter fun j : Fin (2 * n + 1) ↦
        a < distanceToInteger
          (t * phaseProjection n points u j / Real.pi)).card := by
    unfold phaseBadIndices
    exact Finset.card_image_of_injective _ Fin.val_injective
  rw [hcard]
  simpa [phaseLatticeEnergy] using
    card_distance_large_mul_le_energy
      (fun j : Fin (2 * n + 1) ↦
        t * phaseProjection n points u j / Real.pi) a ha

/-- A cardinality bound for the large quotient residues produces one long
consecutive block on which every centered residue is pointwise small. -/
lemma exists_phase_good_block
    (n W : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t a : ℝ) (hW : 0 < W)
    (hfit : W * ((phaseBadIndices n points u t a).card + 1) ≤
      2 * n + 1) :
    ∃ s : ℕ, s + W ≤ 2 * n + 1 ∧
      ∀ r : ℕ, r < W → ∀ j : Fin (2 * n + 1), j.val = s + r →
        distanceToInteger
          (t * phaseProjection n points u j / Real.pi) ≤ a := by
  rcases exists_good_block_of_mul_card_succ_le
    (2 * n + 1) W (phaseBadIndices n points u t a) hW hfit with
    ⟨s, hs, hgood⟩
  refine ⟨s, hs, ?_⟩
  intro r hr
  have hsr : s + r < 2 * n + 1 :=
    lt_of_lt_of_le (Nat.add_lt_add_left hr s) hs
  intro j hj
  by_contra hlarge
  have hjfilter : j ∈ (Finset.univ.filter fun j : Fin (2 * n + 1) ↦
      a < distanceToInteger
        (t * phaseProjection n points u j / Real.pi)) := by
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact lt_of_not_ge hlarge
  have hjbad : j.val ∈ phaseBadIndices n points u t a := by
    unfold phaseBadIndices
    exact Finset.mem_image.mpr ⟨j, hjfilter, rfl⟩
  rw [hj] at hjbad
  exact hgood r hr hjbad

lemma distance_phaseProjection_le_sqrt_latticeEnergy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ)
    (j : Fin (2 * n + 1)) :
    distanceToInteger (t * phaseProjection n points u j / Real.pi) ≤
      Real.sqrt (phaseLatticeEnergy n points u t) := by
  unfold phaseLatticeEnergy
  change |centeredModOne (t * phaseProjection n points u j / Real.pi)| ≤ _
  exact abs_centeredModOne_le_sqrt_energy
    (fun k : Fin (2 * n + 1) ↦
      t * phaseProjection n points u k / Real.pi) j

lemma norm_projectedPhaseWalk_charFun_le_distance_sum
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤
      Real.exp
        (-phaseLatticeEnergy n points u t) := by
  simpa [projectedPhaseWalk, sign, Erdos88.Fourier.rademacherSign,
    distanceToInteger, phaseLatticeEnergy] using
    (Erdos88.Fourier.norm_finCharFun_rademacher_linear_le_exp_neg_sum_sq
      (fun j : Fin (2 * n + 1) ↦ phaseProjection n points u j)
      (fun j : Fin (2 * n + 1) ↦
        centeredModOne (t * phaseProjection n points u j / Real.pi)) t
      (fun j ↦ centeredModOne_isCentered
        (t * phaseProjection n points u j / Real.pi)))

lemma norm_projectedPhaseWalk_charFun_le_exp_neg
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t L : ℝ)
    (hL : L ≤ phaseLatticeEnergy n points u t) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤ Real.exp (-L) := by
  refine (norm_projectedPhaseWalk_charFun_le_distance_sum n points u t).trans ?_
  exact Real.exp_le_exp.mpr (neg_le_neg hL)

/-- In the no-wrap Fourier range, quotient distances are exactly Euclidean
and the lattice energy is the covariance quadratic form. -/
lemma phaseProjection_distance_sum_eq
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ)
    (hsmall : |t| * (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2) :
    phaseLatticeEnergy n points u t =
      (t / Real.pi) ^ 2 *
        ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 := by
  unfold phaseLatticeEnergy
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  have harg : |t * phaseProjection n points u j / Real.pi| < 1 / 2 := by
    calc
      |t * phaseProjection n points u j / Real.pi| =
          |t| * |phaseProjection n points u j| / Real.pi := by
        rw [abs_div, abs_mul, abs_of_pos Real.pi_pos]
      _ ≤ |t| * (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi := by
        gcongr
        exact abs_phaseProjection_le n points u j
      _ < 1 / 2 := hsmall
  rw [distanceToInteger_eq_abs_of_abs_lt_half harg, sq_abs]
  ring

lemma norm_projectedPhaseWalk_charFun_low_frequency
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (t : ℝ)
    (hsmall : |t| * (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤
      Real.exp (-((t / Real.pi) ^ 2 *
        ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2)) := by
  rw [← phaseProjection_distance_sum_eq n points u t hsmall]
  exact norm_projectedPhaseWalk_charFun_le_distance_sum n points u t

/-- Euclidean squared norm on the real `4m` phase-coordinate space. -/
noncomputable def phaseNormSq (u : PhaseCoordinate m) : ℝ :=
  ∑ r : Fin m, ∑ c : Fin 4, (u r c) ^ 2

/-- The same phase space equipped with its genuine Euclidean norm and
Lebesgue measure.  The earlier `PhaseCoordinate` function type is convenient
for componentwise algebra; this type is the analytic interface used for
multidimensional Fourier inversion. -/
abbrev PhaseEuclidean (m : ℕ) := EuclideanSpace ℝ (Fin m × Fin 4)

noncomputable def phaseToEuclidean (u : PhaseCoordinate m) : PhaseEuclidean m :=
  WithLp.toLp 2 (fun i ↦ u i.1 i.2)

noncomputable def euclideanToPhase (x : PhaseEuclidean m) : PhaseCoordinate m :=
  fun r c ↦ x (r, c)

@[simp] lemma phaseToEuclidean_apply (u : PhaseCoordinate m)
    (r : Fin m) (c : Fin 4) :
    phaseToEuclidean u (r, c) = u r c := rfl

@[simp] lemma euclideanToPhase_apply (x : PhaseEuclidean m)
    (r : Fin m) (c : Fin 4) :
    euclideanToPhase x r c = x (r, c) := rfl

@[simp] lemma euclideanToPhase_phaseToEuclidean (u : PhaseCoordinate m) :
    euclideanToPhase (phaseToEuclidean u) = u := by
  funext r c
  rfl

@[simp] lemma phaseToEuclidean_euclideanToPhase (x : PhaseEuclidean m) :
    phaseToEuclidean (euclideanToPhase x) = x := by
  ext i
  rfl

lemma phaseNormSq_eq_norm_sq (u : PhaseCoordinate m) :
    phaseNormSq u = ‖phaseToEuclidean u‖ ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq]
  unfold phaseNormSq
  rw [Fintype.sum_prod_type]
  simp

lemma phaseNormSq_euclideanToPhase (x : PhaseEuclidean m) :
    phaseNormSq (euclideanToPhase x) = ‖x‖ ^ 2 := by
  rw [phaseNormSq_eq_norm_sq, phaseToEuclidean_euclideanToPhase]

lemma abs_phaseCoordinate_le_euclideanNorm (u : PhaseCoordinate m)
    (r : Fin m) (c : Fin 4) :
    |u r c| ≤ ‖phaseToEuclidean u‖ := by
  have hsq : (u r c) ^ 2 ≤ ‖phaseToEuclidean u‖ ^ 2 := by
    rw [← phaseNormSq_eq_norm_sq]
    unfold phaseNormSq
    exact (Finset.single_le_sum
      (fun s _hs ↦ Finset.sum_nonneg fun d _hd ↦ sq_nonneg (u s d))
      (Finset.mem_univ r)).trans' <|
        Finset.single_le_sum (fun d _hd ↦ sq_nonneg (u r d))
          (Finset.mem_univ c)
  nlinarith [sq_abs (u r c), abs_nonneg (u r c), norm_nonneg (phaseToEuclidean u)]

lemma phaseL1_le_dim_mul_euclideanNorm (u : PhaseCoordinate m) :
    (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤
      (4 * m : ℝ) * ‖phaseToEuclidean u‖ := by
  calc
    (∑ r : Fin m, ∑ c : Fin 4, |u r c|) ≤
        ∑ _r : Fin m, ∑ _c : Fin 4, ‖phaseToEuclidean u‖ := by
      exact Finset.sum_le_sum fun r _hr ↦
        Finset.sum_le_sum fun c _hc ↦ abs_phaseCoordinate_le_euclideanNorm u r c
    _ = (4 * m : ℝ) * ‖phaseToEuclidean u‖ := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul]
      push_cast
      ring

lemma phaseNormSq_nonneg (u : PhaseCoordinate m) : 0 ≤ phaseNormSq u := by
  unfold phaseNormSq
  positivity

def phaseScale (a : ℝ) (u : PhaseCoordinate m) : PhaseCoordinate m :=
  fun r c ↦ a * u r c

noncomputable def phaseUnit (u : PhaseCoordinate m) : PhaseCoordinate m :=
  fun r c ↦ u r c / Real.sqrt (phaseNormSq u)

lemma phaseNormSq_phaseScale (a : ℝ) (u : PhaseCoordinate m) :
    phaseNormSq (phaseScale a u) = a ^ 2 * phaseNormSq u := by
  unfold phaseNormSq phaseScale
  simp_rw [mul_pow, Finset.mul_sum]

lemma phaseProjection_phaseScale (n : ℕ) (points : Fin m → ℝ)
    (a : ℝ) (u : PhaseCoordinate m) (j : Fin (2 * n + 1)) :
    phaseProjection n points (phaseScale a u) j =
      a * phaseProjection n points u j := by
  unfold phaseProjection phaseScale
  simp_rw [mul_assoc, ← Finset.mul_sum]

lemma projectedPhaseWalk_phaseScale (n : ℕ) (ε : SignVector (2 * n))
    (points : Fin m → ℝ) (a : ℝ) (u : PhaseCoordinate m) :
    projectedPhaseWalk n ε points (phaseScale a u) =
      a * projectedPhaseWalk n ε points u := by
  unfold projectedPhaseWalk
  simp_rw [phaseProjection_phaseScale, mul_assoc]
  rw [← Finset.mul_sum]

lemma phaseScale_sqrt_phaseUnit (u : PhaseCoordinate m)
    (hu : 0 < phaseNormSq u) :
    phaseScale (Real.sqrt (phaseNormSq u)) (phaseUnit u) = u := by
  funext r c
  unfold phaseScale phaseUnit
  rw [mul_div_cancel₀]
  exact (Real.sqrt_pos.2 hu).ne'

lemma phaseNormSq_phaseUnit (u : PhaseCoordinate m)
    (hu : 0 < phaseNormSq u) :
    phaseNormSq (phaseUnit u) = 1 := by
  have hsqrt : Real.sqrt (phaseNormSq u) ≠ 0 := (Real.sqrt_pos.2 hu).ne'
  have hscale := congrArg phaseNormSq (phaseScale_sqrt_phaseUnit u hu)
  rw [phaseNormSq_phaseScale, Real.sq_sqrt hu.le] at hscale
  apply (mul_left_cancel₀ hu.ne')
  simpa using hscale

lemma phaseProjection_eq_sqrt_mul_unit
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hu : 0 < phaseNormSq u) (j : Fin (2 * n + 1)) :
    phaseProjection n points u j =
      Real.sqrt (phaseNormSq u) * phaseProjection n points (phaseUnit u) j := by
  rw [← phaseProjection_phaseScale]
  rw [phaseScale_sqrt_phaseUnit u hu]

lemma projectedPhaseWalk_eq_sqrt_mul_unit
    (n : ℕ) (ε : SignVector (2 * n)) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (hu : 0 < phaseNormSq u) :
    projectedPhaseWalk n ε points u =
      Real.sqrt (phaseNormSq u) *
        projectedPhaseWalk n ε points (phaseUnit u) := by
  rw [← projectedPhaseWalk_phaseScale]
  rw [phaseScale_sqrt_phaseUnit u hu]

/-- Polar decomposition of the normalized phase characteristic function.
It reduces every nonzero Fourier vector to a unit phase direction and moves
its Euclidean length into the scalar Fourier parameter. -/
lemma normalizedPhaseCharFun_eq_unit_projected
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hu : 0 < phaseNormSq u) :
    normalizedPhaseCharFun n points u =
      Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points (phaseUnit u))
        (Real.sqrt (phaseNormSq u) /
          Real.sqrt (2 * n + 1 : ℝ)) := by
  rw [normalizedPhaseCharFun_eq_projected]
  unfold Erdos88.Fourier.finCharFun
  apply congrArg (Erdos88.Fourier.finExpectation (SignVector (2 * n)))
  funext ε
  rw [show (fun ε ↦ projectedPhaseWalk n ε points u) ε =
      Real.sqrt (phaseNormSq u) *
        projectedPhaseWalk n ε points (phaseUnit u) by
    exact projectedPhaseWalk_eq_sqrt_mul_unit n ε points u hu]
  congr 2
  push_cast
  ring

/-- Scalar Fourier frequency after polar normalization of a nonzero phase
vector.  This is the parameter to which the one-dimensional lattice-energy
estimates are applied. -/
noncomputable def normalizedPhaseFrequency
    (n : ℕ) (u : PhaseCoordinate m) : ℝ :=
  Real.sqrt (phaseNormSq u) / Real.sqrt (2 * n + 1 : ℝ)

lemma normalizedPhaseFrequency_pos
    (n : ℕ) (u : PhaseCoordinate m) (hu : 0 < phaseNormSq u) :
    0 < normalizedPhaseFrequency n u := by
  unfold normalizedPhaseFrequency
  positivity

/-- Any lattice-energy lower bound for the polar direction immediately gives
the corresponding normalized multivariate characteristic-function bound. -/
lemma norm_normalizedPhaseCharFun_le_exp_neg_of_phaseLatticeEnergy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (hu : 0 < phaseNormSq u) (E : ℝ)
    (henergy : E ≤ phaseLatticeEnergy n points (phaseUnit u)
      (normalizedPhaseFrequency n u)) :
    ‖normalizedPhaseCharFun n points u‖ ≤ Real.exp (-E) := by
  rw [normalizedPhaseCharFun_eq_unit_projected n points u hu]
  exact norm_projectedPhaseWalk_charFun_le_exp_neg
    n points (phaseUnit u) (normalizedPhaseFrequency n u) E henergy

/-- A homogeneous lower covariance bound for the deterministic phase-step
matrix.  The Cook--Nguyen covariance lemma supplies this predicate with a
quantitative `gamma` on spread tuples. -/
def HasPhaseCovarianceLower (n : ℕ) (points : Fin m → ℝ) (gamma : ℝ) : Prop :=
  ∀ u : PhaseCoordinate m,
    gamma * (2 * n + 1 : ℝ) * phaseNormSq u ≤
      ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2

lemma normalizedPhaseCovarianceForm_lower
    (n : ℕ) (points : Fin m → ℝ) (gamma : ℝ)
    (hcov : HasPhaseCovarianceLower n points gamma)
    (u : PhaseCoordinate m) :
    gamma * phaseNormSq u ≤
      normalizedPhaseCovarianceForm n points u := by
  unfold normalizedPhaseCovarianceForm
  rw [le_div_iff₀ (by positivity : (0 : ℝ) < 2 * n + 1)]
  simpa only [mul_assoc, mul_comm, mul_left_comm] using hcov u

lemma norm_projectedPhaseWalk_charFun_low_frequency_of_covariance
    (n : ℕ) (points : Fin m → ℝ) (gamma : ℝ)
    (hcov : HasPhaseCovarianceLower n points gamma)
    (u : PhaseCoordinate m) (t : ℝ)
    (hsmall : |t| * (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2) :
    ‖Erdos88.Fourier.finCharFun (SignVector (2 * n))
        (fun ε ↦ projectedPhaseWalk n ε points u) t‖ ≤
      Real.exp (-((t / Real.pi) ^ 2 *
        (gamma * (2 * n + 1 : ℝ) * phaseNormSq u))) := by
  apply norm_projectedPhaseWalk_charFun_le_exp_neg
  rw [phaseProjection_distance_sum_eq n points u t hsmall]
  exact mul_le_mul_of_nonneg_left (hcov u) (sq_nonneg _)

/-- Low-frequency Gaussian decay stated intrinsically for the normalized
`4m`-dimensional phase walk. -/
lemma norm_normalizedPhaseCharFun_low_frequency_of_covariance
    (n : ℕ) (points : Fin m → ℝ) (gamma : ℝ)
    (hcov : HasPhaseCovarianceLower n points gamma)
    (u : PhaseCoordinate m)
    (hsmall :
      |(Real.sqrt (2 * n + 1 : ℝ))⁻¹| *
          (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2) :
    ‖normalizedPhaseCharFun n points u‖ ≤
      Real.exp (-(((Real.sqrt (2 * n + 1 : ℝ))⁻¹ / Real.pi) ^ 2 *
        (gamma * (2 * n + 1 : ℝ) * phaseNormSq u))) := by
  rw [normalizedPhaseCharFun_eq_projected]
  exact norm_projectedPhaseWalk_charFun_low_frequency_of_covariance
    n points gamma hcov u (Real.sqrt (2 * n + 1 : ℝ))⁻¹ hsmall

lemma norm_normalizedPhaseCharFun_le_fixedGaussian_of_covariance
    (n : ℕ) (points : Fin m → ℝ)
    (hcov : HasPhaseCovarianceLower n points (1 / 12))
    (u : PhaseCoordinate m)
    (hsmall :
      |(Real.sqrt (2 * n + 1 : ℝ))⁻¹| *
          (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2) :
    ‖normalizedPhaseCharFun n points u‖ ≤
      Real.exp (-(phaseNormSq u / (12 * Real.pi ^ 2))) := by
  have h := norm_normalizedPhaseCharFun_low_frequency_of_covariance
    n points (1 / 12) hcov u hsmall
  convert h using 1
  have hcount : (0 : ℝ) < 2 * n + 1 := by positivity
  have hsqrt : Real.sqrt (2 * n + 1 : ℝ) ^ 2 = (2 * n + 1 : ℝ) :=
    Real.sq_sqrt hcount.le
  congr 2
  rw [div_pow]
  rw [inv_pow, hsqrt]
  field_simp [Real.pi_ne_zero]

lemma eventually_normalizedPhase_no_wrap (u : PhaseCoordinate m) :
    ∀ᶠ n : ℕ in atTop,
      |(Real.sqrt (2 * n + 1 : ℝ))⁻¹| *
          (∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi < 1 / 2 := by
  have hsqrt : Tendsto (fun n : ℕ ↦ Real.sqrt (2 * n + 1 : ℝ)) atTop atTop := by
    apply Real.tendsto_sqrt_atTop.comp
    have htwo : Tendsto (fun n : ℕ ↦ (2 : ℝ) * n) atTop atTop :=
      (tendsto_natCast_atTop_atTop (R := ℝ)).const_mul_atTop (by norm_num)
    simpa only [Nat.cast_ofNat, Nat.cast_add, Nat.cast_mul, Nat.cast_one] using
      tendsto_atTop_add_const_right atTop (1 : ℝ) htwo
  have hinv : Tendsto
      (fun n : ℕ ↦ (Real.sqrt (2 * n + 1 : ℝ))⁻¹)
      atTop (𝓝 0) := tendsto_inv_atTop_zero.comp hsqrt
  have hnonneg : ∀ n : ℕ,
      0 ≤ (Real.sqrt (2 * n + 1 : ℝ))⁻¹ := fun n ↦ by positivity
  have habs : Tendsto
      (fun n : ℕ ↦ |(Real.sqrt (2 * n + 1 : ℝ))⁻¹|)
      atTop (𝓝 0) := by
    simpa only [abs_of_nonneg (hnonneg _)] using hinv
  have hmul := (habs.mul_const
    ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi))
  have hmul0 : Tendsto
      (fun n : ℕ ↦ |(Real.sqrt (2 * n + 1 : ℝ))⁻¹| *
        ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) / Real.pi))
      atTop (𝓝 0) := by
    simpa only [zero_mul] using hmul
  have hsmall :=
    hmul0.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))
  simpa only [mul_div_assoc] using hsmall

/-- `K`-smoothness of one microscopic time in the form used in the source. -/
def IsSmooth (n : ℕ) (K t : ℝ) : Prop :=
  ∀ p : ℕ, 1 ≤ p → p ≤ Nat.floor K + 1 →
    K / n < distanceToInteger (p * t / (Real.pi * n))

/-- Separation both directly and after reflection; for a singleton this
also excludes the two real points of the circle. -/
def IsSpread (n : ℕ) (lam : ℝ) (points : Fin m → ℝ) : Prop :=
  (m = 1 → ∀ r, lam / n ≤
    distanceToInteger (points r / (2 * Real.pi * n))) ∧
  ∀ r s, r ≠ s →
    lam / n ≤ distanceToInteger ((points r - points s) / (2 * Real.pi * n)) ∧
    lam / n ≤ distanceToInteger ((points r + points s) / (2 * Real.pi * n))

lemma IsSmooth.circleExp_separation
    {n p : ℕ} {K t : ℝ} (hsmooth : IsSmooth n K t)
    (hp1 : 1 ≤ p) (hpK : p ≤ Nat.floor K + 1) :
    4 * (K / n) < ‖circleExp (p * t / (Real.pi * n)) - 1‖ := by
  have hdist := hsmooth p hp1 hpK
  exact (mul_lt_mul_of_pos_left hdist (by norm_num)).trans_le
    (four_mul_distanceToInteger_le_norm_circleExp_sub_one _)

/-! ### Exact twisted-difference identities -/

/-- A complex exponential wave at an integer frequency index. -/
noncomputable def complexWave (n : ℕ) (t : ℝ) (j : ℤ) : ℂ :=
  Complex.exp (((((j : ℝ) * t) / n : ℝ) : ℂ) * Complex.I)

@[simp] lemma complexWave_re (n : ℕ) (t : ℝ) (j : ℤ) :
    (complexWave n t j).re = Real.cos ((j : ℝ) * t / n) := by
  exact Complex.exp_ofReal_mul_I_re _

@[simp] lemma complexWave_im (n : ℕ) (t : ℝ) (j : ℤ) :
    (complexWave n t j).im = Real.sin ((j : ℝ) * t / n) := by
  exact Complex.exp_ofReal_mul_I_im _

@[simp] lemma norm_complexWave (n : ℕ) (t : ℝ) (j : ℤ) :
    ‖complexWave n t j‖ = 1 := by
  exact Complex.norm_exp_ofReal_mul_I _

/-- Discrete Abel summation in the precise finite-range form used to
control the covariance matrix. -/
lemma sum_mul_sub_one_eq_abel (a : ℕ → ℂ) (z : ℂ) (N : ℕ) :
    (∑ q ∈ Finset.range (N + 1), a q * z ^ q) * (z - 1) =
      a N * z ^ (N + 1) - a 0 +
        ∑ q ∈ Finset.Ico 1 (N + 1), (a (q - 1) - a q) * z ^ q := by
  induction N with
  | zero => simp; ring
  | succ N ih =>
      rw [Finset.sum_range_succ, add_mul, ih]
      rw [Finset.sum_Ico_succ_top (by omega : 1 ≤ N + 1)]
      simp only [Nat.add_sub_cancel, pow_succ]
      ring

lemma norm_sum_mul_pow_le_of_unit (a : ℕ → ℂ) (z : ℂ) (N : ℕ)
    (hz : ‖z‖ = 1) :
    ‖∑ q ∈ Finset.range (N + 1), a q * z ^ q‖ * ‖z - 1‖ ≤
      ‖a N‖ + ‖a 0‖ +
        ∑ q ∈ Finset.Ico 1 (N + 1), ‖a (q - 1) - a q‖ := by
  rw [← norm_mul, sum_mul_sub_one_eq_abel]
  calc
    ‖a N * z ^ (N + 1) - a 0 +
        ∑ q ∈ Finset.Ico 1 (N + 1), (a (q - 1) - a q) * z ^ q‖ ≤
      ‖a N * z ^ (N + 1) - a 0‖ +
        ‖∑ q ∈ Finset.Ico 1 (N + 1), (a (q - 1) - a q) * z ^ q‖ :=
          norm_add_le _ _
    _ ≤
      ‖a N * z ^ (N + 1)‖ + ‖a 0‖ +
        ‖∑ q ∈ Finset.Ico 1 (N + 1), (a (q - 1) - a q) * z ^ q‖ := by
          gcongr
          exact norm_sub_le (a N * z ^ (N + 1)) (a 0)
    _ ≤ ‖a N‖ + ‖a 0‖ +
        ∑ q ∈ Finset.Ico 1 (N + 1), ‖a (q - 1) - a q‖ := by
      rw [norm_mul, norm_pow, hz, one_pow, mul_one]
      gcongr
      calc
        ‖∑ q ∈ Finset.Ico 1 (N + 1), (a (q - 1) - a q) * z ^ q‖ ≤
            ∑ q ∈ Finset.Ico 1 (N + 1), ‖(a (q - 1) - a q) * z ^ q‖ :=
          norm_sum_le _ _
        _ = ∑ q ∈ Finset.Ico 1 (N + 1), ‖a (q - 1) - a q‖ := by
          apply Finset.sum_congr rfl
          intro q _
          rw [norm_mul, norm_pow, hz, one_pow, mul_one]

/-- Monomials in the normalized centered frequency `(q-n)/n`. -/
noncomputable def centeredMonomial (n k q : ℕ) : ℂ :=
  ((((q : ℝ) - n) / n) ^ k : ℝ)

lemma norm_centeredMonomial_le_one (n k q : ℕ) (hn : 0 < n)
    (hq : q ≤ 2 * n) : ‖centeredMonomial n k q‖ ≤ 1 := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hqreal : (q : ℝ) ≤ 2 * n := by exact_mod_cast hq
  have hbase : |((q : ℝ) - n) / n| ≤ 1 := by
    rw [abs_le]
    constructor
    · rw [le_div_iff₀ hnreal]
      linarith
    · rw [div_le_iff₀ hnreal]
      linarith
  simp only [centeredMonomial, Complex.norm_real, Real.norm_eq_abs, abs_pow]
  exact pow_le_one₀ (abs_nonneg _) hbase

lemma norm_centeredMonomial_sub_le (n k q : ℕ) (hn : 0 < n)
    (hk : k ≤ 2) (hq1 : 1 ≤ q) (hq : q ≤ 2 * n) :
    ‖centeredMonomial n k (q - 1) - centeredMonomial n k q‖ ≤ 2 / n := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hqm1 : q - 1 ≤ 2 * n := by omega
  have hq1real : (1 : ℝ) ≤ q := by exact_mod_cast hq1
  have hqreal : (q : ℝ) ≤ 2 * n := by exact_mod_cast hq
  interval_cases k <;>
    simp only [centeredMonomial, pow_zero, pow_one]
  · norm_num
    positivity
  · rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    rw [Nat.cast_sub hq1]
    norm_num
    rw [show (((q : ℝ) - 1 - n) / n - ((q : ℝ) - n) / n) = -1 / n by ring]
    rw [abs_div, abs_neg, abs_one, abs_of_pos hnreal]
    exact div_le_div_of_nonneg_right (by norm_num) hnreal.le
  · rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    rw [Nat.cast_sub hq1]
    norm_num
    let x : ℝ := ((q : ℝ) - 1 - n) / n
    let y : ℝ := ((q : ℝ) - n) / n
    have hxy : |x - y| = 1 / n := by
      dsimp [x, y]
      rw [show (((q : ℝ) - 1 - n) / n - ((q : ℝ) - n) / n) = -1 / n by ring]
      rw [abs_div, abs_neg, abs_one, abs_of_pos hnreal]
    have hx' : |x| ≤ 1 := by
      dsimp [x]
      rw [abs_div, abs_of_pos hnreal]
      apply (div_le_one hnreal).2
      rw [abs_le]
      constructor <;> linarith
    have hy' : |y| ≤ 1 := by
      dsimp [y]
      rw [abs_div, abs_of_pos hnreal]
      apply (div_le_one hnreal).2
      rw [abs_le]
      constructor <;> linarith
    change |x ^ 2 - y ^ 2| ≤ 2 / (n : ℝ)
    rw [show x ^ 2 - y ^ 2 = (x - y) * (x + y) by ring, abs_mul, hxy]
    calc
      1 / (n : ℝ) * |x + y| ≤ 1 / (n : ℝ) * (|x| + |y|) := by
        gcongr
        exact abs_add_le x y
      _ ≤ 1 / (n : ℝ) * (1 + 1) := by gcongr
      _ = 2 / n := by ring

/-- A uniform Abel-summation bound for the three centered frequency
monomials which occur in the position--velocity covariance matrix. -/
lemma norm_centeredMonomial_geometric_sum_le
    (n k : ℕ) (hn : 0 < n) (hk : k ≤ 2) (z : ℂ)
    (hz : ‖z‖ = 1) (delta : ℝ) (hdelta : 0 < delta)
    (hgap : delta ≤ ‖z - 1‖) :
    ‖∑ q ∈ Finset.range (2 * n + 1), centeredMonomial n k q * z ^ q‖ ≤
      6 / delta := by
  have hab := norm_sum_mul_pow_le_of_unit (centeredMonomial n k) z (2 * n) hz
  have hend0 := norm_centeredMonomial_le_one n k 0 hn (by omega)
  have hendN := norm_centeredMonomial_le_one n k (2 * n) hn (by omega)
  have hdiff :
      ∑ q ∈ Finset.Ico 1 (2 * n + 1),
          ‖centeredMonomial n k (q - 1) - centeredMonomial n k q‖ ≤ 4 := by
    calc
      _ ≤ ∑ _q ∈ Finset.Ico 1 (2 * n + 1), (2 / (n : ℝ)) := by
        apply Finset.sum_le_sum
        intro q hq
        simp only [Finset.mem_Ico] at hq
        exact norm_centeredMonomial_sub_le n k q hn hk hq.1 (by omega)
      _ = 4 := by
        rw [Finset.sum_const, Nat.card_Ico]
        simp only [nsmul_eq_mul]
        have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
        push_cast
        field_simp
        norm_num
  have hprod :
      ‖∑ q ∈ Finset.range (2 * n + 1), centeredMonomial n k q * z ^ q‖ *
          ‖z - 1‖ ≤ 6 := by
    calc
      _ ≤ ‖centeredMonomial n k (2 * n)‖ + ‖centeredMonomial n k 0‖ +
          ∑ q ∈ Finset.Ico 1 (2 * n + 1),
            ‖centeredMonomial n k (q - 1) - centeredMonomial n k q‖ := hab
      _ ≤ 1 + 1 + 4 := by gcongr
      _ = 6 := by norm_num
  have hprod' :
      ‖∑ q ∈ Finset.range (2 * n + 1), centeredMonomial n k q * z ^ q‖ *
          delta ≤ 6 := by
    exact (mul_le_mul_of_nonneg_left hgap (norm_nonneg _)).trans hprod
  exact (le_div_iff₀ hdelta).2 (by simpa [mul_comm] using hprod')

lemma complexWave_eq_circleExp (n : ℕ) (hn : 0 < n)
    (t : ℝ) (h : ℤ) :
    complexWave n t h =
      circleExp ((h : ℝ) * t / (2 * Real.pi * n)) := by
  unfold complexWave circleExp
  congr 1
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  push_cast
  field_simp

@[simp] lemma conj_complexWave (n : ℕ) (t : ℝ) (j : ℤ) :
    conj (complexWave n t j) = complexWave n (-t) j := by
  unfold complexWave
  rw [← Complex.exp_conj]
  congr 1
  push_cast
  simp
  ring

lemma complexWave_eq_mul_circleExp (n : ℕ) (hn : 0 < n)
    (s t : ℝ) (h : ℤ) :
    complexWave n t h = complexWave n s h *
      circleExp ((h : ℝ) * (t - s) / (2 * Real.pi * n)) := by
  unfold complexWave circleExp
  rw [← Complex.exp_add]
  congr 1
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  push_cast
  field_simp
  ring

lemma norm_complexWave_sub_complexWave (n : ℕ) (hn : 0 < n)
    (s t : ℝ) (h : ℤ) :
    ‖complexWave n t h - complexWave n s h‖ =
      ‖circleExp ((h : ℝ) * (t - s) / (2 * Real.pi * n)) - 1‖ := by
  rw [complexWave_eq_mul_circleExp n hn s t h]
  have hfactor :
      complexWave n s h *
          circleExp ((h : ℝ) * (t - s) / (2 * Real.pi * n)) -
        complexWave n s h =
      complexWave n s h *
        (circleExp ((h : ℝ) * (t - s) / (2 * Real.pi * n)) - 1) := by
    ring
  rw [hfactor, norm_mul, norm_complexWave, one_mul]

lemma four_mul_distance_le_norm_complexWave_sub (n : ℕ) (hn : 0 < n)
    (s t : ℝ) (h : ℤ) :
    4 * distanceToInteger ((h : ℝ) * (t - s) / (2 * Real.pi * n)) ≤
      ‖complexWave n t h - complexWave n s h‖ := by
  rw [norm_complexWave_sub_complexWave n hn s t h]
  exact four_mul_distanceToInteger_le_norm_circleExp_sub_one _

/-- Wave-form propagation lemma.  Uniform chord control for the first
`L-1` multiples of a base frequency forces that base frequency itself to
lie at quotient distance `O(ε/L)` from an integer. -/
lemma distance_baseWave_le_of_multipleWaves_close
    (n L q₀ : ℕ) (hn : 0 < n) (hL : 800 ≤ L)
    (t ε : ℝ) (hε0 : 0 ≤ ε) (hεsmall : ε < 1 / 16)
    (hmul : ∀ r ∈ Finset.Ico 1 L,
      ‖complexWave n t ((r * q₀ : ℕ) : ℤ) - 1‖ ≤ ε) :
    distanceToInteger ((q₀ : ℝ) * t / (2 * Real.pi * n)) ≤
      2000 * ε / L := by
  let x : ℝ := (q₀ : ℝ) * t / (2 * Real.pi * n)
  have hdist : ∀ r ∈ Finset.Ico 1 L,
      distanceToInteger ((r : ℝ) * x) ≤ ε / 4 := by
    intro r hr
    have hchord := four_mul_distanceToInteger_le_norm_circleExp_sub_one
      ((r : ℝ) * x)
    have hwave :
        complexWave n t ((r * q₀ : ℕ) : ℤ) =
          circleExp ((r : ℝ) * x) := by
      rw [complexWave_eq_circleExp n hn]
      simp only [Int.cast_natCast, Nat.cast_mul]
      dsimp [x]
      congr 1
      push_cast
      ring
    rw [← hwave] at hchord
    nlinarith [hmul r hr]
  have hprop := distanceToInteger_le_of_multiples_le
    L x (ε / 4) hL (by positivity) (by linarith) hdist
  change distanceToInteger
      ((q₀ : ℝ) * t / (2 * Real.pi * n)) ≤
        8000 * (ε / 4) / L at hprop
  exact hprop.trans_eq (by ring)

/-- Smoothness contradiction in propagation form.  A smooth frequency has
at least one large chord among the first `L-1` multiples of every admissible
base step. -/
lemma IsSmooth.exists_large_multipleWave
    {n q₀ : ℕ} {K t : ℝ} (hsmooth : IsSmooth n K t)
    (hn : 0 < n) (hq₀1 : 1 ≤ q₀)
    (hq₀K : q₀ ≤ Nat.floor K + 1)
    (L : ℕ) (hL : 800 ≤ L) (ε : ℝ)
    (hε0 : 0 ≤ ε) (hεsmall : ε < 1 / 16)
    (hscale : 4000 * ε / L ≤ K / n) :
    ∃ r ∈ Finset.Ico 1 L,
      ε < ‖complexWave n t ((r * q₀ : ℕ) : ℤ) - 1‖ := by
  by_contra hnone
  push Not at hnone
  have hbase := distance_baseWave_le_of_multipleWaves_close
    n L q₀ hn hL t ε hε0 hεsmall hnone
  let x : ℝ := (q₀ : ℝ) * t / (2 * Real.pi * n)
  have hdouble :
      distanceToInteger (q₀ * t / (Real.pi * n)) ≤
        2 * distanceToInteger x := by
    have h := distanceToInteger_nsmul_le 2 x
    convert h using 1 <;>
      dsimp [x] <;> push_cast <;> ring
  have hupper :
      distanceToInteger (q₀ * t / (Real.pi * n)) ≤
        4000 * ε / L := by
    calc
      distanceToInteger (q₀ * t / (Real.pi * n)) ≤
          2 * distanceToInteger x := hdouble
      _ ≤ 2 * (2000 * ε / L) := by
        exact mul_le_mul_of_nonneg_left (by simpa [x] using hbase) (by norm_num)
      _ = 4000 * ε / L := by ring
  exact (not_lt_of_ge (hupper.trans hscale))
    (hsmooth q₀ hq₀1 hq₀K)

lemma IsSmooth.norm_complexWave_reflection_lower
    {n : ℕ} (hn : 0 < n) {K t : ℝ} (hsmooth : IsSmooth n K t) :
    4 * (K / n) <
      ‖complexWave n t 1 - complexWave n (-t) 1‖ := by
  have hsep := hsmooth.circleExp_separation (p := 1)
    (by norm_num) (by omega)
  rw [norm_complexWave_sub_complexWave n hn (-t) t 1]
  convert hsep using 1 <;> push_cast <;> ring

lemma IsSpread.norm_complexWave_sub_lower
    (n : ℕ) (hn : 0 < n) (lam : ℝ) (points : Fin m → ℝ)
    (hspread : IsSpread n lam points) (r s : Fin m) (hrs : r ≠ s) :
    4 * (lam / n) ≤
      ‖complexWave n (points r) 1 - complexWave n (points s) 1‖ := by
  have hdist := (hspread.2 r s hrs).1
  calc
    4 * (lam / n) ≤
        4 * distanceToInteger
          ((1 : ℝ) * (points r - points s) / (2 * Real.pi * n)) := by
      simpa only [one_mul] using
        (mul_le_mul_of_nonneg_left hdist (by norm_num : (0 : ℝ) ≤ 4))
    _ ≤ ‖complexWave n (points r) 1 - complexWave n (points s) 1‖ := by
      simpa using four_mul_distance_le_norm_complexWave_sub
        n hn (points s) (points r) 1

lemma IsSpread.norm_complexWave_reflection_sub_lower
    (n : ℕ) (hn : 0 < n) (lam : ℝ) (points : Fin m → ℝ)
    (hspread : IsSpread n lam points) (r s : Fin m) (hrs : r ≠ s) :
    4 * (lam / n) ≤
      ‖complexWave n (points r) 1 - complexWave n (-points s) 1‖ := by
  have hdist := (hspread.2 r s hrs).2
  calc
    4 * (lam / n) ≤
        4 * distanceToInteger
          ((1 : ℝ) * (points r - (-points s)) / (2 * Real.pi * n)) := by
      simpa only [one_mul, sub_neg_eq_add] using (mul_le_mul_of_nonneg_left hdist (by norm_num))
    _ ≤ ‖complexWave n (points r) 1 - complexWave n (-points s) 1‖ := by
      simpa using four_mul_distance_le_norm_complexWave_sub
        n hn (-points s) (points r) 1

/-- The frequency-weighted wave which supplies the velocity coordinates. -/
noncomputable def weightedComplexWave (n : ℕ) (t : ℝ) (j : ℤ) : ℂ :=
  (((j : ℝ) / n : ℝ) : ℂ) * complexWave n t j

lemma norm_weightedComplexWave (n : ℕ) (hn : 0 < n)
    (t : ℝ) (j : ℤ) :
    ‖weightedComplexWave n t j‖ = |(j : ℝ)| / n := by
  unfold weightedComplexWave
  rw [norm_mul, norm_complexWave, mul_one, Complex.norm_real,
    Real.norm_eq_abs, abs_div, abs_of_pos (by exact_mod_cast hn : (0 : ℝ) < n)]

lemma norm_affineComplexMode (n : ℕ) (t : ℝ) (A B : ℂ) (j : ℤ) :
    ‖A * complexWave n t j + B * weightedComplexWave n t j‖ =
      ‖A + ((((j : ℝ) / n : ℝ) : ℂ) * B)‖ := by
  unfold weightedComplexWave
  rw [show A * complexWave n t j +
        B * (((((j : ℝ) / n : ℝ) : ℂ) * complexWave n t j)) =
      (A + ((((j : ℝ) / n : ℝ) : ℂ) * B)) * complexWave n t j by ring]
  simp

/-- An affine complex mode cannot have small `ℓ²` mass throughout a long
block unless its velocity coefficient is small.  Pairing the first half of
the block with the second half gives the explicit cubic gain `H³/n²`. -/
lemma mul_sq_velocity_div_le_two_sum_affineComplexMode
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ) (j : ℤ) (H : ℕ) :
    (H : ℝ) * (((H : ℝ) * ‖B‖ / n) ^ 2) ≤
      2 * ∑ v ∈ Finset.range (2 * H),
        ‖A * complexWave n t (j + v) +
          B * weightedComplexWave n t (j + v)‖ ^ 2 := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  let z : ℕ → ℂ := fun v ↦
    A + (((((j + (v : ℤ) : ℤ) : ℝ) / n : ℝ) : ℂ) * B)
  have hpoint : ∀ v : ℕ,
      (((H : ℝ) * ‖B‖ / n) ^ 2) ≤
        2 * (‖z v‖ ^ 2 + ‖z (H + v)‖ ^ 2) := by
    intro v
    have hdiff :
        (((((H : ℝ) / n : ℝ) : ℂ) * B)) = z (H + v) - z v := by
      dsimp [z]
      push_cast
      field_simp
      ring
    have hnormDiff : (H : ℝ) * ‖B‖ / n = ‖z (H + v) - z v‖ := by
      rw [← hdiff, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_div, abs_of_pos hnreal, abs_of_nonneg (Nat.cast_nonneg H)]
      ring
    have htri : (H : ℝ) * ‖B‖ / n ≤ ‖z (H + v)‖ + ‖z v‖ := by
      rw [hnormDiff]
      exact norm_sub_le _ _
    have hleft : 0 ≤ (H : ℝ) * ‖B‖ / n := by positivity
    have hx : 0 ≤ ‖z v‖ := norm_nonneg _
    have hy : 0 ≤ ‖z (H + v)‖ := norm_nonneg _
    nlinarith [sq_nonneg (‖z (H + v)‖ - ‖z v‖)]
  calc
    (H : ℝ) * (((H : ℝ) * ‖B‖ / n) ^ 2) =
        ∑ _v ∈ Finset.range H, (((H : ℝ) * ‖B‖ / n) ^ 2) := by simp
    _ ≤ ∑ v ∈ Finset.range H,
        2 * (‖z v‖ ^ 2 + ‖z (H + v)‖ ^ 2) :=
      Finset.sum_le_sum fun v _hv ↦ hpoint v
    _ = 2 * ∑ v ∈ Finset.range (2 * H), ‖z v‖ ^ 2 := by
      rw [show 2 * H = H + H by omega, Finset.sum_range_add]
      simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
    _ = 2 * ∑ v ∈ Finset.range (2 * H),
        ‖A * complexWave n t (j + v) +
          B * weightedComplexWave n t (j + v)‖ ^ 2 := by
      apply congrArg (fun x : ℝ ↦ 2 * x)
      apply Finset.sum_congr rfl
      intro v _hv
      rw [norm_affineComplexMode]

/-- The same affine block controls its position coefficient when the block
starts at distance at most `J H` from the origin.  The velocity estimate
above absorbs the possible cancellation between position and slope. -/
lemma mul_sq_position_le_factor_sum_affineComplexMode
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ) (j : ℤ)
    (H : ℕ) (hH : 0 < H) (J : ℝ) (hJ : 0 ≤ J)
    (hj : |(j : ℝ)| ≤ J * H) :
    (H : ℝ) * ‖A‖ ^ 2 ≤
      (2 + 4 * (J + 1) ^ 2) *
        ∑ v ∈ Finset.range (2 * H),
          ‖A * complexWave n t (j + v) +
            B * weightedComplexWave n t (j + v)‖ ^ 2 := by
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  let z : ℕ → ℂ := fun v ↦
    A + (((((j + (v : ℤ) : ℤ) : ℝ) / n : ℝ) : ℂ) * B)
  let Q : ℝ := (J + 1) * ((H : ℝ) * ‖B‖ / n)
  have hQ : 0 ≤ Q := by dsimp [Q]; positivity
  have hpoint : ∀ v ∈ Finset.range H,
      ‖A‖ ^ 2 ≤ 2 * (‖z v‖ ^ 2 + Q ^ 2) := by
    intro v hv
    have hvle : (v : ℝ) ≤ H := by
      exact_mod_cast (Finset.mem_range.mp hv).le
    have harg : |((j + (v : ℤ) : ℤ) : ℝ)| ≤ (J + 1) * H := by
      rw [Int.cast_add, Int.cast_natCast]
      calc
        |(j : ℝ) + (v : ℝ)| ≤ |(j : ℝ)| + |(v : ℝ)| := abs_add_le _ _
        _ = |(j : ℝ)| + (v : ℝ) := by
          rw [show |(v : ℝ)| = (v : ℝ) by
            exact abs_of_nonneg (Nat.cast_nonneg v)]
        _ ≤ J * (H : ℝ) + (H : ℝ) := add_le_add hj hvle
        _ = (J + 1) * (H : ℝ) := by ring
    have hscalar :
        ‖(((((j + (v : ℤ) : ℤ) : ℝ) / n : ℝ) : ℂ) * B)‖ ≤ Q := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_div,
        abs_of_pos hnreal]
      dsimp [Q]
      calc
        |((j + (v : ℤ) : ℤ) : ℝ)| / (n : ℝ) * ‖B‖ ≤
            ((J + 1) * (H : ℝ)) / (n : ℝ) * ‖B‖ := by gcongr
        _ = (J + 1) * ((H : ℝ) * ‖B‖ / n) := by ring
    have hid : A = z v -
        (((((j + (v : ℤ) : ℤ) : ℝ) / n : ℝ) : ℂ) * B) := by
      dsimp [z]
      ring
    have hnorm : ‖A‖ ≤ ‖z v‖ + Q := by
      rw [hid]
      exact (norm_sub_le _ _).trans (add_le_add le_rfl hscalar)
    have hA0 : 0 ≤ ‖A‖ := norm_nonneg _
    have hz0 : 0 ≤ ‖z v‖ := norm_nonneg _
    nlinarith [sq_nonneg (‖z v‖ - Q)]
  let S : ℝ := ∑ v ∈ Finset.range (2 * H),
    ‖A * complexWave n t (j + v) +
      B * weightedComplexWave n t (j + v)‖ ^ 2
  have hfirst : ∑ v ∈ Finset.range H, ‖z v‖ ^ 2 ≤ S := by
    have hsubset : Finset.range H ⊆ Finset.range (2 * H) :=
      Finset.range_mono (by omega)
    calc
      ∑ v ∈ Finset.range H, ‖z v‖ ^ 2 =
          ∑ v ∈ Finset.range H,
            ‖A * complexWave n t (j + v) +
              B * weightedComplexWave n t (j + v)‖ ^ 2 := by
        apply Finset.sum_congr rfl
        intro v _hv
        rw [norm_affineComplexMode]
      _ ≤ S := by
        dsimp [S]
        apply Finset.sum_le_sum_of_subset_of_nonneg hsubset
        intro v _hv _hmem
        exact sq_nonneg _
  have hvelocity :
      (H : ℝ) * (((H : ℝ) * ‖B‖ / n) ^ 2) ≤ 2 * S := by
    simpa [S] using
      mul_sq_velocity_div_le_two_sum_affineComplexMode n hn t A B j H
  have hsumPoint :
      (H : ℝ) * ‖A‖ ^ 2 ≤
        2 * (∑ v ∈ Finset.range H, ‖z v‖ ^ 2) +
          2 * (H : ℝ) * Q ^ 2 := by
    calc
      (H : ℝ) * ‖A‖ ^ 2 = ∑ _v ∈ Finset.range H, ‖A‖ ^ 2 := by simp
      _ ≤ ∑ v ∈ Finset.range H, 2 * (‖z v‖ ^ 2 + Q ^ 2) :=
        Finset.sum_le_sum hpoint
      _ = 2 * (∑ v ∈ Finset.range H, ‖z v‖ ^ 2) +
          2 * (H : ℝ) * Q ^ 2 := by
        simp [mul_add, Finset.sum_add_distrib, ← Finset.mul_sum]
        ring
  calc
    (H : ℝ) * ‖A‖ ^ 2 ≤
        2 * (∑ v ∈ Finset.range H, ‖z v‖ ^ 2) +
          2 * (H : ℝ) * Q ^ 2 := hsumPoint
    _ ≤ 2 * S + 2 * (J + 1) ^ 2 *
          ((H : ℝ) * (((H : ℝ) * ‖B‖ / n) ^ 2)) := by
      have hQeq : 2 * (H : ℝ) * Q ^ 2 =
          2 * (J + 1) ^ 2 *
            ((H : ℝ) * (((H : ℝ) * ‖B‖ / n) ^ 2)) := by
        dsimp [Q]
        ring
      rw [hQeq]
      gcongr
    _ ≤ 2 * S + 2 * (J + 1) ^ 2 * (2 * S) := by
      gcongr
    _ = (2 + 4 * (J + 1) ^ 2) * S := by ring

@[simp] lemma conj_weightedComplexWave (n : ℕ) (t : ℝ) (j : ℤ) :
    conj (weightedComplexWave n t j) = weightedComplexWave n (-t) j := by
  simp [weightedComplexWave, map_mul]

/-- A shifted first difference with a prescribed complex twist. -/
def twistedDifference (h : ℤ) (ζ : ℂ) (f : ℤ → ℂ) : ℤ → ℂ :=
  fun j ↦ f (j + h) - ζ * f j

lemma twistedDifference_add (h : ℤ) (ζ : ℂ) (f g : ℤ → ℂ) (j : ℤ) :
    twistedDifference h ζ (fun k ↦ f k + g k) j =
      twistedDifference h ζ f j + twistedDifference h ζ g j := by
  unfold twistedDifference
  ring

lemma twistedDifference_const_mul (h : ℤ) (ζ a : ℂ) (f : ℤ → ℂ) (j : ℤ) :
    twistedDifference h ζ (fun k ↦ a * f k) j =
      a * twistedDifference h ζ f j := by
  unfold twistedDifference
  ring

lemma twistedDifference_sum {I : Type*} [Fintype I]
    (h : ℤ) (ζ : ℂ) (f : I → ℤ → ℂ) (j : ℤ) :
    twistedDifference h ζ (fun k ↦ ∑ i, f i k) j =
      ∑ i, twistedDifference h ζ (f i) j := by
  unfold twistedDifference
  simp_rw [Finset.mul_sum, ← Finset.sum_sub_distrib]

lemma twistedDifference_comm (h k : ℤ) (ζ η : ℂ) (f : ℤ → ℂ) (j : ℤ) :
    twistedDifference h ζ (twistedDifference k η f) j =
      twistedDifference k η (twistedDifference h ζ f) j := by
  unfold twistedDifference
  rw [show j + h + k = j + k + h by ring]
  ring

/-- Apply the same twisted difference twice. -/
def doubleTwist (h : ℤ) (ζ : ℂ) (f : ℤ → ℂ) : ℤ → ℂ :=
  twistedDifference h ζ (twistedDifference h ζ f)

lemma doubleTwist_apply (h : ℤ) (ζ : ℂ) (f : ℤ → ℂ) (j : ℤ) :
    doubleTwist h ζ f j =
      f ((j + h) + h) - (2 : ℂ) * ζ * f (j + h) + ζ ^ 2 * f j := by
  unfold doubleTwist twistedDifference
  ring

/-- A double unitary twist costs at most the binomial `1+2+1` in norm. -/
lemma norm_doubleTwist_le (h : ℤ) (ζ : ℂ) (hζ : ‖ζ‖ = 1)
    (f : ℤ → ℂ) (j : ℤ) :
    ‖doubleTwist h ζ f j‖ ≤
      ‖f ((j + h) + h)‖ + 2 * ‖f (j + h)‖ + ‖f j‖ := by
  rw [doubleTwist_apply]
  calc
    ‖f ((j + h) + h) - (2 : ℂ) * ζ * f (j + h) + ζ ^ 2 * f j‖ ≤
        ‖f ((j + h) + h)‖ + ‖(2 : ℂ) * ζ * f (j + h)‖ +
          ‖ζ ^ 2 * f j‖ := by
      exact (norm_add_le _ _).trans
        (add_le_add (norm_sub_le _ _) le_rfl)
    _ = ‖f ((j + h) + h)‖ + 2 * ‖f (j + h)‖ + ‖f j‖ := by
      simp [norm_mul, hζ]

lemma doubleTwist_add (h : ℤ) (ζ : ℂ) (f g : ℤ → ℂ) (j : ℤ) :
    doubleTwist h ζ (fun k ↦ f k + g k) j =
      doubleTwist h ζ f j + doubleTwist h ζ g j := by
  unfold doubleTwist
  rw [show twistedDifference h ζ (fun k ↦ f k + g k) =
      fun k ↦ twistedDifference h ζ f k + twistedDifference h ζ g k by
    funext k
    exact twistedDifference_add h ζ f g k]
  exact twistedDifference_add h ζ _ _ j

lemma doubleTwist_const_mul (h : ℤ) (ζ a : ℂ) (f : ℤ → ℂ) (j : ℤ) :
    doubleTwist h ζ (fun k ↦ a * f k) j =
      a * doubleTwist h ζ f j := by
  unfold doubleTwist
  rw [show twistedDifference h ζ (fun k ↦ a * f k) =
      fun k ↦ a * twistedDifference h ζ f k by
    funext k
    exact twistedDifference_const_mul h ζ a f k]
  exact twistedDifference_const_mul h ζ a _ j

lemma doubleTwist_sum {I : Type*} [Fintype I]
    (h : ℤ) (ζ : ℂ) (f : I → ℤ → ℂ) (j : ℤ) :
    doubleTwist h ζ (fun k ↦ ∑ i, f i k) j =
      ∑ i, doubleTwist h ζ (f i) j := by
  unfold doubleTwist
  rw [show twistedDifference h ζ (fun k ↦ ∑ i, f i k) =
      fun k ↦ ∑ i, twistedDifference h ζ (f i) k by
    funext k
    exact twistedDifference_sum h ζ f k]
  exact twistedDifference_sum h ζ _ j

lemma doubleTwist_comm (h k : ℤ) (ζ η : ℂ) (f : ℤ → ℂ) (j : ℤ) :
    doubleTwist h ζ (doubleTwist k η f) j =
      doubleTwist k η (doubleTwist h ζ f) j := by
  unfold doubleTwist twistedDifference
  simp only [add_assoc, add_left_comm, add_comm]
  ring

/-- A commuting product of double spectral twists. -/
def iteratedDoubleTwist (h : ℤ) (twists : List ℂ) (f : ℤ → ℂ) : ℤ → ℂ :=
  twists.foldr (fun ζ g ↦ doubleTwist h ζ g) f

@[simp] lemma iteratedDoubleTwist_nil (h : ℤ) (f : ℤ → ℂ) :
    iteratedDoubleTwist h [] f = f := rfl

@[simp] lemma iteratedDoubleTwist_cons
    (h : ℤ) (ζ : ℂ) (twists : List ℂ) (f : ℤ → ℂ) :
    iteratedDoubleTwist h (ζ :: twists) f =
      doubleTwist h ζ (iteratedDoubleTwist h twists f) := rfl

lemma doubleTwist_one_re_eq_forwardDifference_two
    (h : ℤ) (f : ℤ → ℂ) (j : ℤ) :
    (doubleTwist h 1 f j).re =
      iteratedForwardDifference h 2 (fun q ↦ (f q).re) j := by
  rw [doubleTwist_apply]
  simp [iteratedForwardDifference, forwardDifference]
  ring

/-- `k` ordinary double twists are exactly the real `2k`-th forward
difference after taking real parts. -/
lemma iteratedDoubleTwist_replicate_one_re
    (h : ℤ) (k : ℕ) (f : ℤ → ℂ) (j : ℤ) :
    (iteratedDoubleTwist h (List.replicate k 1) f j).re =
      iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j := by
  induction k generalizing j with
  | zero => simp
  | succ k ih =>
      rw [List.replicate_succ, iteratedDoubleTwist_cons,
        doubleTwist_one_re_eq_forwardDifference_two]
      have hfun :
          (fun q ↦ (iteratedDoubleTwist h (List.replicate k 1) f q).re) =
            iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) := by
        funext q
        exact ih q
      rw [hfun, ← iteratedForwardDifference_add]
      rw [show 2 + 2 * k = 2 * (k + 1) by omega]

/-- If the input sequence is real-valued, ordinary complex double twists are
exactly the real embedding of the corresponding even forward difference. -/
lemma iteratedDoubleTwist_replicate_one_eq_ofReal
    (h : ℤ) (k : ℕ) (f : ℤ → ℂ)
    (hreal : ∀ j, (f j).im = 0) :
    iteratedDoubleTwist h (List.replicate k 1) f =
      fun j ↦ ((iteratedForwardDifference h (2 * k)
        (fun q ↦ (f q).re) j : ℝ) : ℂ) := by
  funext j
  apply Complex.ext
  · simpa using iteratedDoubleTwist_replicate_one_re h k f j
  · have him :
        (iteratedDoubleTwist h (List.replicate k 1) f j).im = 0 := by
      induction k generalizing j with
      | zero => simpa using hreal j
      | succ k ih =>
          have h0 := ih j
          have h1 := ih (j + h)
          have h2 := ih ((j + h) + h)
          rw [List.replicate_succ, iteratedDoubleTwist_cons,
            doubleTwist_apply]
          simp [h0, h1, h2]
    simpa [him]

lemma doubleTwist_iteratedDoubleTwist_comm
    (h : ℤ) (ζ : ℂ) (twists : List ℂ) (f : ℤ → ℂ) :
    doubleTwist h ζ (iteratedDoubleTwist h twists f) =
      iteratedDoubleTwist h twists (doubleTwist h ζ f) := by
  induction twists with
  | nil => rfl
  | cons η twists ih =>
      simp only [iteratedDoubleTwist_cons]
      rw [show doubleTwist h ζ (doubleTwist h η
            (iteratedDoubleTwist h twists f)) =
          doubleTwist h η (doubleTwist h ζ
            (iteratedDoubleTwist h twists f)) by
        funext j
        exact doubleTwist_comm h h ζ η _ j]
      rw [ih]

/-- Double twists at different integer steps commute as constant-coefficient
difference operators. -/
lemma doubleTwist_iteratedDoubleTwist_comm_general
    (k h : ℤ) (ζ : ℂ) (twists : List ℂ) (f : ℤ → ℂ) :
    doubleTwist k ζ (iteratedDoubleTwist h twists f) =
      iteratedDoubleTwist h twists (doubleTwist k ζ f) := by
  induction twists with
  | nil => rfl
  | cons η twists ih =>
      simp only [iteratedDoubleTwist_cons]
      rw [show doubleTwist k ζ
            (doubleTwist h η (iteratedDoubleTwist h twists f)) =
          doubleTwist h η
            (doubleTwist k ζ (iteratedDoubleTwist h twists f)) by
        funext j
        exact doubleTwist_comm k h ζ η _ j]
      rw [ih]

@[simp] lemma doubleTwist_zero (h : ℤ) (ζ : ℂ) :
    doubleTwist h ζ (0 : ℤ → ℂ) = 0 := by
  funext j
  simp [doubleTwist, twistedDifference]

@[simp] lemma iteratedDoubleTwist_zero (h : ℤ) (twists : List ℂ) :
    iteratedDoubleTwist h twists (0 : ℤ → ℂ) = 0 := by
  induction twists with
  | nil => rfl
  | cons ζ twists ih => simp [ih]

lemma iteratedDoubleTwist_add (h : ℤ) (twists : List ℂ)
    (f g : ℤ → ℂ) :
    iteratedDoubleTwist h twists (fun q ↦ f q + g q) =
      fun q ↦ iteratedDoubleTwist h twists f q +
        iteratedDoubleTwist h twists g q := by
  induction twists with
  | nil => rfl
  | cons ζ twists ih =>
      simp only [iteratedDoubleTwist_cons]
      rw [ih]
      funext q
      exact doubleTwist_add h ζ _ _ q

lemma iteratedDoubleTwist_const_mul (h : ℤ) (twists : List ℂ)
    (a : ℂ) (f : ℤ → ℂ) :
    iteratedDoubleTwist h twists (fun q ↦ a * f q) =
      fun q ↦ a * iteratedDoubleTwist h twists f q := by
  induction twists with
  | nil => rfl
  | cons ζ twists ih =>
      simp only [iteratedDoubleTwist_cons]
      rw [ih]
      funext q
      exact doubleTwist_const_mul h ζ a _ q

lemma iteratedDoubleTwist_sum {I : Type*} [Fintype I]
    (h : ℤ) (twists : List ℂ) (f : I → ℤ → ℂ) :
    iteratedDoubleTwist h twists (fun q ↦ ∑ i, f i q) =
      fun q ↦ ∑ i, iteratedDoubleTwist h twists (f i) q := by
  induction twists with
  | nil => rfl
  | cons ζ twists ih =>
      simp only [iteratedDoubleTwist_cons]
      rw [ih]
      funext q
      exact doubleTwist_sum h ζ _ q

/-- Local `ℓ¹` operator bound: a product of `L` unitary double twists has
coefficient norm at most `4^L`, and at `j` it only uses the original values
`j + qh`, `0 ≤ q ≤ 2L`. -/
lemma norm_iteratedDoubleTwist_le_of_window_bound
    (h : ℤ) (twists : List ℂ) (f : ℤ → ℂ) (j : ℤ) (M : ℝ)
    (hM : 0 ≤ M)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hwindow : ∀ q : ℕ, q ≤ 2 * twists.length →
      ‖f (j + (q : ℤ) * h)‖ ≤ M) :
    ‖iteratedDoubleTwist h twists f j‖ ≤ (4 : ℝ) ^ twists.length * M := by
  induction twists generalizing j with
  | nil =>
      simpa using hwindow 0 (by omega)
  | cons ζ twists ih =>
      have hζ : ‖ζ‖ = 1 := hunit ζ (by simp)
      have hunitRest : ∀ η ∈ twists, ‖η‖ = 1 := by
        intro η hη
        exact hunit η (by simp [hη])
      let g : ℤ → ℂ := iteratedDoubleTwist h twists f
      have hg0 : ‖g j‖ ≤ (4 : ℝ) ^ twists.length * M := by
        apply ih j hunitRest
        intro q hq
        exact hwindow q (by simp only [List.length_cons]; omega)
      have hg1 : ‖g (j + h)‖ ≤ (4 : ℝ) ^ twists.length * M := by
        apply ih (j + h) hunitRest
        intro q hq
        rw [show j + h + (q : ℤ) * h =
            j + ((q + 1 : ℕ) : ℤ) * h by
          push_cast
          ring]
        exact hwindow (q + 1) (by simp only [List.length_cons]; omega)
      have hg2 : ‖g ((j + h) + h)‖ ≤ (4 : ℝ) ^ twists.length * M := by
        apply ih ((j + h) + h) hunitRest
        intro q hq
        rw [show j + h + h + (q : ℤ) * h =
            j + ((q + 2 : ℕ) : ℤ) * h by
          push_cast
          ring]
        exact hwindow (q + 2) (by simp only [List.length_cons]; omega)
      rw [iteratedDoubleTwist_cons]
      calc
        ‖doubleTwist h ζ g j‖ ≤
            ‖g ((j + h) + h)‖ + 2 * ‖g (j + h)‖ + ‖g j‖ :=
          norm_doubleTwist_le h ζ hζ g j
        _ ≤ ((4 : ℝ) ^ twists.length * M) +
              2 * ((4 : ℝ) ^ twists.length * M) +
              ((4 : ℝ) ^ twists.length * M) := by gcongr
        _ = (4 : ℝ) ^ (ζ :: twists).length * M := by
          rw [List.length_cons, pow_succ]
          ring

/-! Variable-step spectral differences.  Assigning a separate dilation to
each unwanted mode avoids a simultaneous-dilation loss while preserving the
same triangular exponential-polynomial algebra. -/

abbrev VariableTwist := ℕ × ℂ

def variableTwistSpan : List VariableTwist → ℕ
  | [] => 0
  | (h, _) :: twists => 2 * h + variableTwistSpan twists

def iteratedVariableDoubleTwist
    (twists : List VariableTwist) (f : ℤ → ℂ) : ℤ → ℂ :=
  twists.foldr (fun hζ g ↦ doubleTwist (hζ.1 : ℤ) hζ.2 g) f

@[simp] lemma iteratedVariableDoubleTwist_nil (f : ℤ → ℂ) :
    iteratedVariableDoubleTwist [] f = f := rfl

@[simp] lemma iteratedVariableDoubleTwist_cons
    (h : ℕ) (ζ : ℂ) (twists : List VariableTwist) (f : ℤ → ℂ) :
    iteratedVariableDoubleTwist ((h, ζ) :: twists) f =
      doubleTwist (h : ℤ) ζ (iteratedVariableDoubleTwist twists f) := rfl

@[simp] lemma variableTwistSpan_nil : variableTwistSpan [] = 0 := rfl

@[simp] lemma variableTwistSpan_cons
    (h : ℕ) (ζ : ℂ) (twists : List VariableTwist) :
    variableTwistSpan ((h, ζ) :: twists) = 2 * h + variableTwistSpan twists := rfl

lemma iteratedVariableDoubleTwist_add
    (twists : List VariableTwist) (f g : ℤ → ℂ) :
    iteratedVariableDoubleTwist twists (fun q ↦ f q + g q) =
      fun q ↦ iteratedVariableDoubleTwist twists f q +
        iteratedVariableDoubleTwist twists g q := by
  induction twists with
  | nil => rfl
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      simp only [iteratedVariableDoubleTwist_cons]
      rw [ih]
      funext q
      exact doubleTwist_add (h : ℤ) ζ _ _ q

lemma iteratedVariableDoubleTwist_const_mul
    (twists : List VariableTwist) (a : ℂ) (f : ℤ → ℂ) :
    iteratedVariableDoubleTwist twists (fun q ↦ a * f q) =
      fun q ↦ a * iteratedVariableDoubleTwist twists f q := by
  induction twists with
  | nil => rfl
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      simp only [iteratedVariableDoubleTwist_cons]
      rw [ih]
      funext q
      exact doubleTwist_const_mul (h : ℤ) ζ a _ q

lemma iteratedVariableDoubleTwist_sum {I : Type*} [Fintype I]
    (twists : List VariableTwist) (f : I → ℤ → ℂ) :
    iteratedVariableDoubleTwist twists (fun q ↦ ∑ i, f i q) =
      fun q ↦ ∑ i, iteratedVariableDoubleTwist twists (f i) q := by
  induction twists with
  | nil => rfl
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      simp only [iteratedVariableDoubleTwist_cons]
      rw [ih]
      funext q
      exact doubleTwist_sum (h : ℤ) ζ _ q

@[simp] lemma iteratedVariableDoubleTwist_zero
    (twists : List VariableTwist) :
    iteratedVariableDoubleTwist twists (0 : ℤ → ℂ) = 0 := by
  induction twists with
  | nil => rfl
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      simp [ih]

/-- A variable-step isolating product commutes with a fixed-step product of
ordinary double differences. -/
lemma iteratedVariableDoubleTwist_iteratedDoubleTwist_comm
    (variableTwists : List VariableTwist) (h : ℤ)
    (twists : List ℂ) (f : ℤ → ℂ) :
    iteratedVariableDoubleTwist variableTwists
        (iteratedDoubleTwist h twists f) =
      iteratedDoubleTwist h twists
        (iteratedVariableDoubleTwist variableTwists f) := by
  induction variableTwists with
  | nil => rfl
  | cons hζ variableTwists ih =>
      rcases hζ with ⟨k, ζ⟩
      simp only [iteratedVariableDoubleTwist_cons]
      rw [ih, doubleTwist_iteratedDoubleTwist_comm_general]

/-- A variable-step product only samples the original function in the
integer interval whose length is the sum of twice the selected steps. -/
lemma norm_iteratedVariableDoubleTwist_le_of_window_bound
    (twists : List VariableTwist) (f : ℤ → ℂ) (j : ℤ) (M : ℝ)
    (hM : 0 ≤ M)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1)
    (hwindow : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖f (j + q)‖ ≤ M) :
    ‖iteratedVariableDoubleTwist twists f j‖ ≤
      (4 : ℝ) ^ twists.length * M := by
  induction twists generalizing j with
  | nil =>
      simpa using hwindow 0 (by simp)
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      have hζunit : ‖ζ‖ = 1 := hunit (h, ζ) (by simp)
      have hunitRest : ∀ kη ∈ twists, ‖kη.2‖ = 1 := by
        intro kη hkη
        exact hunit kη (by simp [hkη])
      let g : ℤ → ℂ := iteratedVariableDoubleTwist twists f
      have hg0 : ‖g j‖ ≤ (4 : ℝ) ^ twists.length * M := by
        apply ih j hunitRest
        intro q hq
        exact hwindow q (by simp only [variableTwistSpan_cons]; omega)
      have hg1 : ‖g (j + h)‖ ≤ (4 : ℝ) ^ twists.length * M := by
        apply ih (j + h) hunitRest
        intro q hq
        rw [show j + (h : ℤ) + (q : ℤ) = j + ((h + q : ℕ) : ℤ) by
          push_cast
          ring]
        exact hwindow (h + q) (by simp only [variableTwistSpan_cons]; omega)
      have hg2 : ‖g ((j + h) + h)‖ ≤ (4 : ℝ) ^ twists.length * M := by
        apply ih ((j + h) + h) hunitRest
        intro q hq
        rw [show j + (h : ℤ) + h + (q : ℤ) =
            j + ((2 * h + q : ℕ) : ℤ) by
          push_cast
          ring]
        exact hwindow (2 * h + q) (by simp only [variableTwistSpan_cons]; omega)
      rw [iteratedVariableDoubleTwist_cons]
      calc
        ‖doubleTwist (h : ℤ) ζ g j‖ ≤
            ‖g ((j + h) + h)‖ + 2 * ‖g (j + h)‖ + ‖g j‖ :=
          norm_doubleTwist_le (h : ℤ) ζ hζunit g j
        _ ≤ ((4 : ℝ) ^ twists.length * M) +
              2 * ((4 : ℝ) ^ twists.length * M) +
              ((4 : ℝ) ^ twists.length * M) := by gcongr
        _ = (4 : ℝ) ^ ((h, ζ) :: twists).length * M := by
          rw [List.length_cons, pow_succ]
          ring

/-- The variable-step isolating operator is bounded on a consecutive
`ℓ²` window.  The deliberately generous factor `36` per double twist keeps
the proof elementary: a unitary double twist has three translates with
coefficients `1,-2,1`, and Cauchy--Schwarz bounds its squared norm by twelve
times the sum of the three input squared norms. -/
lemma sum_sq_norm_iteratedVariableDoubleTwist_range_le
    (twists : List VariableTwist) (f : ℤ → ℂ) (j : ℤ) (W : ℕ)
    (hfit : variableTwistSpan twists ≤ W)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1) :
    ∑ v ∈ Finset.range (W - variableTwistSpan twists),
        ‖iteratedVariableDoubleTwist twists f (j + v)‖ ^ 2 ≤
      (36 : ℝ) ^ twists.length *
        ∑ r ∈ Finset.range W, ‖f (j + r)‖ ^ 2 := by
  induction twists generalizing j W with
  | nil =>
      simp
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      have hζunit : ‖ζ‖ = 1 := hunit (h, ζ) (by simp)
      have hunitRest : ∀ kη ∈ twists, ‖kη.2‖ = 1 := by
        intro kη hkη
        exact hunit kη (by simp [hkη])
      have hrestfit : variableTwistSpan twists ≤ W := by
        simp only [variableTwistSpan_cons] at hfit
        omega
      have hfit' : 2 * h + variableTwistSpan twists ≤ W := by
        simpa only [variableTwistSpan_cons] using hfit
      let A : ℕ := W - (2 * h + variableTwistSpan twists)
      let B : ℕ := W - variableTwistSpan twists
      let g : ℕ → ℝ := fun v ↦
        ‖iteratedVariableDoubleTwist twists f (j + v)‖ ^ 2
      have hAhB : A + h ≤ B := by
        dsimp [A, B]
        omega
      have hA2hB : A + 2 * h ≤ B := by
        dsimp [A, B]
        omega
      have hbase :
          ∑ v ∈ Finset.range A, g v ≤
            ∑ v ∈ Finset.range B, g v := by
        apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono (by omega))
        intro v _hv _hmem
        exact sq_nonneg _
      have hshift :
          ∑ v ∈ Finset.range A, g (v + h) ≤
            ∑ v ∈ Finset.range B, g v :=
        sum_range_natShift_le g (fun v ↦ sq_nonneg _) h A B hAhB
      have hdoubleShift :
          ∑ v ∈ Finset.range A, g (v + 2 * h) ≤
            ∑ v ∈ Finset.range B, g v :=
        sum_range_natShift_le g (fun v ↦ sq_nonneg _) (2 * h) A B hA2hB
      have hpoint : ∀ v : ℕ,
          ‖doubleTwist (h : ℤ) ζ
              (iteratedVariableDoubleTwist twists f) (j + v)‖ ^ 2 ≤
            12 * (g (v + 2 * h) + g (v + h) + g v) := by
        intro v
        let X : ℝ := ‖iteratedVariableDoubleTwist twists f
          ((j + (v : ℤ) + h) + h)‖
        let Y : ℝ := ‖iteratedVariableDoubleTwist twists f
          (j + (v : ℤ) + h)‖
        let Z : ℝ := ‖iteratedVariableDoubleTwist twists f (j + v)‖
        let N : ℝ := ‖doubleTwist (h : ℤ) ζ
          (iteratedVariableDoubleTwist twists f) (j + v)‖
        have hnorm : N ≤ X + 2 * Y + Z := by
          dsimp [N, X, Y, Z]
          simpa [add_assoc] using norm_doubleTwist_le (h : ℤ) ζ hζunit
            (iteratedVariableDoubleTwist twists f) (j + v)
        have hX : 0 ≤ X := norm_nonneg _
        have hY : 0 ≤ Y := norm_nonneg _
        have hZ : 0 ≤ Z := norm_nonneg _
        have hN : 0 ≤ N := norm_nonneg _
        have hg1 : g (v + h) = Y ^ 2 := by
          dsimp [g, Y]
          congr 2
          push_cast
          ring
        have hg2 : g (v + 2 * h) = X ^ 2 := by
          dsimp [g, X]
          congr 2
          push_cast
          ring
        have hg0 : g v = Z ^ 2 := by rfl
        rw [hg2, hg1, hg0]
        change N ^ 2 ≤ 12 * (X ^ 2 + Y ^ 2 + Z ^ 2)
        nlinarith [sq_nonneg (X - 2 * Y), sq_nonneg (X - Z),
          sq_nonneg (2 * Y - Z)]
      have hstep :
          ∑ v ∈ Finset.range A,
              ‖doubleTwist (h : ℤ) ζ
                (iteratedVariableDoubleTwist twists f) (j + v)‖ ^ 2 ≤
            36 * ∑ v ∈ Finset.range B, g v := by
        calc
          ∑ v ∈ Finset.range A,
              ‖doubleTwist (h : ℤ) ζ
                (iteratedVariableDoubleTwist twists f) (j + v)‖ ^ 2 ≤
              ∑ v ∈ Finset.range A,
                12 * (g (v + 2 * h) + g (v + h) + g v) :=
            Finset.sum_le_sum fun v _hv ↦ hpoint v
          _ = 12 * (∑ v ∈ Finset.range A, g (v + 2 * h)) +
                12 * (∑ v ∈ Finset.range A, g (v + h)) +
                12 * (∑ v ∈ Finset.range A, g v) := by
            simp only [mul_add, Finset.sum_add_distrib, ← Finset.mul_sum]
          _ ≤ 12 * (∑ v ∈ Finset.range B, g v) +
                12 * (∑ v ∈ Finset.range B, g v) +
                12 * (∑ v ∈ Finset.range B, g v) := by
            gcongr
          _ = 36 * ∑ v ∈ Finset.range B, g v := by ring
      have hind := ih (j := j) (W := W) hrestfit hunitRest
      change
        ∑ v ∈ Finset.range A,
            ‖doubleTwist (h : ℤ) ζ
              (iteratedVariableDoubleTwist twists f) (j + v)‖ ^ 2 ≤
          (36 : ℝ) ^ ((h, ζ) :: twists).length *
            ∑ r ∈ Finset.range W, ‖f (j + r)‖ ^ 2
      calc
        ∑ v ∈ Finset.range A,
            ‖doubleTwist (h : ℤ) ζ
              (iteratedVariableDoubleTwist twists f) (j + v)‖ ^ 2 ≤
            36 * ∑ v ∈ Finset.range B, g v := hstep
        _ ≤ 36 * ((36 : ℝ) ^ twists.length *
            ∑ r ∈ Finset.range W, ‖f (j + r)‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_left _ (by norm_num)
          simpa [B, g] using hind
        _ = (36 : ℝ) ^ ((h, ζ) :: twists).length *
            ∑ r ∈ Finset.range W, ‖f (j + r)‖ ^ 2 := by
          rw [List.length_cons, pow_succ]
          ring

lemma complexWave_add (n : ℕ) (t : ℝ) (j h : ℤ) :
    complexWave n t (j + h) = complexWave n t j * complexWave n t h := by
  unfold complexWave
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

lemma complexWave_time_add (n : ℕ) (s t : ℝ) (j : ℤ) :
    complexWave n (s + t) j = complexWave n s j * complexWave n t j := by
  unfold complexWave
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

lemma complexWave_mul_conj (n : ℕ) (s t : ℝ) (j : ℤ) :
    complexWave n t j * conj (complexWave n s j) =
      complexWave n (t - s) j := by
  unfold complexWave
  rw [← Complex.exp_conj, ← Complex.exp_add]
  congr 1
  push_cast
  simp
  ring

lemma norm_complexWave_sub_one_eq_sub (n : ℕ) (s t : ℝ) (j : ℤ) :
    ‖complexWave n (t - s) j - 1‖ =
      ‖complexWave n t j - complexWave n s j‖ := by
  have hfac : complexWave n t j =
      complexWave n s j * complexWave n (t - s) j := by
    rw [← complexWave_time_add]
    congr 2
    ring
  rw [hfac]
  have heq :
      complexWave n s j * complexWave n (t - s) j - complexWave n s j =
        complexWave n s j * (complexWave n (t - s) j - 1) := by ring
  rw [heq, norm_mul, norm_complexWave, one_mul]

lemma complexWave_nat_mul (n : ℕ) (t : ℝ) (q r : ℕ) :
    complexWave n t ((r * q : ℕ) : ℤ) =
      (complexWave n t (q : ℤ)) ^ r := by
  induction r with
  | zero => simp [complexWave]
  | succ r ih =>
      rw [Nat.succ_mul, Nat.cast_add, complexWave_add, ih, pow_succ]

/-- The `k`th centered-frequency moment of one exponential wave. -/
noncomputable def centeredWaveMoment (n k : ℕ) (t : ℝ) : ℂ :=
  ∑ j : Fin (2 * n + 1),
    (((((j : ℕ) : ℝ) - n) / n) ^ k : ℝ) *
      complexWave n t ((j : ℤ) - n)

noncomputable def centeredAffineMode (n : ℕ) (t : ℝ) (A B : ℂ)
    (j : Fin (2 * n + 1)) : ℂ :=
  (A + (((((j : ℕ) : ℝ) - n) / n : ℝ) : ℂ) * B) *
    complexWave n t ((j : ℤ) - n)

noncomputable def centeredAffineCrossMoment (n : ℕ) (s t : ℝ)
    (A B C D : ℂ) : ℂ :=
  ∑ j : Fin (2 * n + 1),
    centeredAffineMode n t A B j * conj (centeredAffineMode n s C D j)

noncomputable def centeredAffineModeSum {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ) (A B : I → ℂ)
    (j : Fin (2 * n + 1)) : ℂ :=
  ∑ a : I, centeredAffineMode n (times a) (A a) (B a) j

lemma centeredAffineCrossMoment_eq (n : ℕ) (s t : ℝ) (A B C D : ℂ) :
    centeredAffineCrossMoment n s t A B C D =
      (A * conj C) * centeredWaveMoment n 0 (t - s) +
      (A * conj D + B * conj C) * centeredWaveMoment n 1 (t - s) +
      (B * conj D) * centeredWaveMoment n 2 (t - s) := by
  unfold centeredAffineCrossMoment centeredAffineMode centeredWaveMoment
  simp_rw [Finset.mul_sum]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro j _
  simp only [map_mul, map_add, Complex.conj_ofReal]
  let v : ℝ := (((j : ℕ) : ℝ) - n) / n
  have hw :
      complexWave n t ((j : ℤ) - n) * conj (complexWave n s ((j : ℤ) - n)) =
        complexWave n (t - s) ((j : ℤ) - n) :=
    complexWave_mul_conj n s t ((j : ℤ) - n)
  change
    (A + (v : ℂ) * B) * complexWave n t ((j : ℤ) - n) *
        ((conj C + (v : ℂ) * conj D) * conj (complexWave n s ((j : ℤ) - n))) =
      (A * conj C) * (((v ^ 0 : ℝ) : ℂ) * complexWave n (t - s) ((j : ℤ) - n)) +
      (A * conj D + B * conj C) *
        (((v ^ 1 : ℝ) : ℂ) * complexWave n (t - s) ((j : ℤ) - n)) +
      (B * conj D) * (((v ^ 2 : ℝ) : ℂ) * complexWave n (t - s) ((j : ℤ) - n))
  calc
    _ = ((A + (v : ℂ) * B) * (conj C + (v : ℂ) * conj D)) *
        (complexWave n t ((j : ℤ) - n) * conj (complexWave n s ((j : ℤ) - n))) := by
      ring
    _ = _ := by rw [hw]; push_cast; ring

lemma norm_centeredAffineCrossMoment_le
    (n : ℕ) (s t : ℝ) (A B C D : ℂ) (M : ℝ) (_hM : 0 ≤ M)
    (hmom : ∀ k : Fin 3, ‖centeredWaveMoment n k (t - s)‖ ≤ M) :
    ‖centeredAffineCrossMoment n s t A B C D‖ ≤
      M * (‖A‖ + ‖B‖) * (‖C‖ + ‖D‖) := by
  rw [centeredAffineCrossMoment_eq]
  have h0 : ‖centeredWaveMoment n 0 (t - s)‖ ≤ M := by
    simpa using hmom ⟨0, by decide⟩
  have h1 : ‖centeredWaveMoment n 1 (t - s)‖ ≤ M := by
    simpa using hmom ⟨1, by decide⟩
  have h2 : ‖centeredWaveMoment n 2 (t - s)‖ ≤ M := by
    simpa using hmom ⟨2, by decide⟩
  have hcoeff : ‖A * conj D + B * conj C‖ ≤
      ‖A‖ * ‖D‖ + ‖B‖ * ‖C‖ := by
    calc
      _ ≤ ‖A * conj D‖ + ‖B * conj C‖ := norm_add_le _ _
      _ = _ := by simp [norm_mul, Complex.norm_conj]
  have hT0 : ‖(A * conj C) * centeredWaveMoment n 0 (t - s)‖ ≤
      (‖A‖ * ‖C‖) * M := by
    rw [norm_mul, norm_mul, Complex.norm_conj]
    gcongr
  have hT1 : ‖(A * conj D + B * conj C) * centeredWaveMoment n 1 (t - s)‖ ≤
      (‖A‖ * ‖D‖ + ‖B‖ * ‖C‖) * M := by
    rw [norm_mul]
    exact mul_le_mul hcoeff h1 (norm_nonneg _) (by positivity)
  have hT2 : ‖(B * conj D) * centeredWaveMoment n 2 (t - s)‖ ≤
      (‖B‖ * ‖D‖) * M := by
    rw [norm_mul, norm_mul, Complex.norm_conj]
    gcongr
  calc
    _ ≤ ‖(A * conj C) * centeredWaveMoment n 0 (t - s)‖ +
        ‖(A * conj D + B * conj C) * centeredWaveMoment n 1 (t - s)‖ +
        ‖(B * conj D) * centeredWaveMoment n 2 (t - s)‖ := by
      calc
        _ ≤ ‖(A * conj C) * centeredWaveMoment n 0 (t - s) +
              (A * conj D + B * conj C) * centeredWaveMoment n 1 (t - s)‖ +
            ‖(B * conj D) * centeredWaveMoment n 2 (t - s)‖ := norm_add_le _ _
        _ ≤ _ := by
          gcongr
          exact norm_add_le _ _
    _ ≤ (‖A‖ * ‖C‖) * M +
        (‖A‖ * ‖D‖ + ‖B‖ * ‖C‖) * M +
        (‖B‖ * ‖D‖) * M := by
      gcongr
    _ = M * (‖A‖ + ‖B‖) * (‖C‖ + ‖D‖) := by ring

lemma centeredWaveMoment_eq (n k : ℕ) (t : ℝ) :
    centeredWaveMoment n k t =
      complexWave n t (-(n : ℤ)) *
        ∑ q ∈ Finset.range (2 * n + 1),
          centeredMonomial n k q * (complexWave n t 1) ^ q := by
  unfold centeredWaveMoment
  rw [Finset.sum_fin_eq_sum_range, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro q hq
  simp only [Finset.mem_range] at hq
  simp only [hq, dite_true]
  rw [show (q : ℤ) - (n : ℤ) = -(n : ℤ) + (q : ℤ) by ring,
    complexWave_add]
  rw [show complexWave n t (q : ℤ) = (complexWave n t 1) ^ q by
    simpa using complexWave_nat_mul n t 1 q]
  simp [centeredMonomial]
  ring

lemma norm_centeredWaveMoment_le
    (n k : ℕ) (hn : 0 < n) (hk : k ≤ 2) (t : ℝ)
    (delta : ℝ) (hdelta : 0 < delta)
    (hgap : delta ≤ ‖complexWave n t 1 - 1‖) :
    ‖centeredWaveMoment n k t‖ ≤ 6 / delta := by
  rw [centeredWaveMoment_eq, norm_mul, norm_complexWave, one_mul]
  exact norm_centeredMonomial_geometric_sum_le n k hn hk (complexWave n t 1)
    (norm_complexWave n t 1) delta hdelta hgap

/-- On the unit circle, taking the `r`-th power expands the chord from one
by at most the factor `r`. -/
lemma norm_complexWave_nat_mul_sub_one_le
    (n : ℕ) (t : ℝ) (q r : ℕ) :
    ‖complexWave n t ((r * q : ℕ) : ℤ) - 1‖ ≤
      (r : ℝ) * ‖complexWave n t (q : ℤ) - 1‖ := by
  rw [complexWave_nat_mul]
  let z : ℂ := complexWave n t (q : ℤ)
  have hz : ‖z‖ = 1 := norm_complexWave n t q
  induction r with
  | zero => simp
  | succ r ih =>
      rw [pow_succ]
      have hid : z ^ r * z - 1 = z ^ r * (z - 1) + (z ^ r - 1) := by ring
      rw [hid]
      calc
        ‖z ^ r * (z - 1) + (z ^ r - 1)‖ ≤
            ‖z ^ r * (z - 1)‖ + ‖z ^ r - 1‖ := norm_add_le _ _
        _ = ‖z - 1‖ + ‖z ^ r - 1‖ := by simp [hz]
        _ ≤ ‖z - 1‖ + (r : ℝ) * ‖z - 1‖ := by gcongr
        _ = ((r + 1 : ℕ) : ℝ) * ‖z - 1‖ := by
          push_cast
          ring

/-- A wave is an eigenfunction of every twisted difference. -/
lemma twistedDifference_complexWave (n : ℕ) (t : ℝ) (h : ℤ) (ζ : ℂ) (j : ℤ) :
    twistedDifference h ζ (complexWave n t) j =
      (complexWave n t h - ζ) * complexWave n t j := by
  rw [twistedDifference]
  rw [complexWave_add]
  ring

@[simp] lemma twistedDifference_complexWave_same
    (n : ℕ) (t : ℝ) (h j : ℤ) :
    twistedDifference h (complexWave n t h) (complexWave n t) j = 0 := by
  rw [twistedDifference_complexWave]
  ring

/-- Two matching twisted differences annihilate a frequency-weighted wave. -/
lemma twistedDifference_twice_weightedComplexWave_same
    (n : ℕ) (t : ℝ) (h j : ℤ) :
    twistedDifference h (complexWave n t h)
        (twistedDifference h (complexWave n t h) (weightedComplexWave n t)) j = 0 := by
  unfold twistedDifference weightedComplexWave
  simp_rw [complexWave_add]
  push_cast
  ring

/-- One matching twist kills a pure wave and turns the weighted wave into a
constant multiple of that wave. -/
lemma twistedDifference_weightedComplexWave_same
    (n : ℕ) (t : ℝ) (h j : ℤ) :
    twistedDifference h (complexWave n t h) (weightedComplexWave n t) j =
      (((h : ℝ) / n : ℝ) : ℂ) * complexWave n t h * complexWave n t j := by
  unfold twistedDifference weightedComplexWave
  rw [complexWave_add]
  push_cast
  ring

lemma twistedDifference_affineMode_same
    (n : ℕ) (t : ℝ) (h j : ℤ) (A B : ℂ) :
    twistedDifference h (complexWave n t h)
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) j =
      B * ((((h : ℝ) / n : ℝ) : ℂ) *
        complexWave n t h * complexWave n t j) := by
  rw [twistedDifference_add, twistedDifference_const_mul,
    twistedDifference_const_mul, twistedDifference_complexWave_same,
    twistedDifference_weightedComplexWave_same]
  ring

lemma norm_velocityCoeff_div_le_two_max
    (n : ℕ) (hn : 0 < n) (t : ℝ) (j : ℤ) (A B : ℂ) :
    ‖B‖ / n ≤
      2 * max
        ‖A * complexWave n t j + B * weightedComplexWave n t j‖
        ‖A * complexWave n t (j + 1) + B * weightedComplexWave n t (j + 1)‖ := by
  let f : ℤ → ℂ :=
    fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q
  have htwist := twistedDifference_affineMode_same n t 1 j A B
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hnorm : ‖twistedDifference 1 (complexWave n t 1) f j‖ = ‖B‖ / n := by
    rw [htwist]
    simp only [norm_mul, norm_complexWave]
    rw [mul_one, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_div, abs_of_pos hnreal]
    norm_num
    rw [div_eq_mul_inv]
  rw [← hnorm]
  unfold twistedDifference
  calc
    ‖f (j + 1) - complexWave n t 1 * f j‖ ≤
        ‖f (j + 1)‖ + ‖complexWave n t 1 * f j‖ := norm_sub_le _ _
    _ = ‖f (j + 1)‖ + ‖f j‖ := by simp
    _ ≤ 2 * max ‖f j‖ ‖f (j + 1)‖ := by
      nlinarith [le_max_left ‖f j‖ ‖f (j + 1)‖,
        le_max_right ‖f j‖ ‖f (j + 1)‖]

lemma doubleTwist_mode_same
    (n : ℕ) (t : ℝ) (h j : ℤ) (A B : ℂ) :
    doubleTwist h (complexWave n t h)
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) j = 0 := by
  rw [doubleTwist_add, doubleTwist_const_mul, doubleTwist_const_mul]
  have hpure : doubleTwist h (complexWave n t h) (complexWave n t) j = 0 := by
    unfold doubleTwist
    rw [show twistedDifference h (complexWave n t h) (complexWave n t) = 0 by
      funext q
      exact twistedDifference_complexWave_same n t h q]
    simp [twistedDifference]
  rw [hpure]
  rw [show doubleTwist h (complexWave n t h) (weightedComplexWave n t) j = 0 by
    exact twistedDifference_twice_weightedComplexWave_same n t h j]
  ring

/-- An iterated product of commuting twists kills an affine-weighted mode as
soon as the matching twist occurs in the product. -/
lemma iteratedDoubleTwist_mode_zero
    (n : ℕ) (t : ℝ) (h : ℤ) (A B : ℂ) (twists : List ℂ)
    (hmem : complexWave n t h ∈ twists) :
    iteratedDoubleTwist h twists
      (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) = 0 := by
  induction twists with
  | nil => simp at hmem
  | cons ζ twists ih =>
      rcases List.mem_cons.mp hmem with hζ | hrest
      · subst ζ
        rw [iteratedDoubleTwist_cons,
          doubleTwist_iteratedDoubleTwist_comm]
        have hzero : doubleTwist h (complexWave n t h)
            (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) = 0 := by
          funext j
          exact doubleTwist_mode_same n t h j A B
        rw [hzero, iteratedDoubleTwist_zero]
      · rw [iteratedDoubleTwist_cons, ih hrest, doubleTwist_zero]

/-- On a different pure frequency, two twisted differences multiply by the
square of the spectral separation factor. -/
lemma twistedDifference_twice_complexWave
    (n : ℕ) (s t : ℝ) (h j : ℤ) :
    twistedDifference h (complexWave n s h)
        (twistedDifference h (complexWave n s h) (complexWave n t)) j =
      (complexWave n t h - complexWave n s h) ^ 2 * complexWave n t j := by
  unfold twistedDifference
  simp_rw [complexWave_add]
  ring

/-- The exact action of two twists on a weighted, nonmatching frequency. -/
lemma twistedDifference_twice_weightedComplexWave
    (n : ℕ) (s t : ℝ) (h j : ℤ) :
    twistedDifference h (complexWave n s h)
        (twistedDifference h (complexWave n s h) (weightedComplexWave n t)) j =
      (complexWave n t h - complexWave n s h) ^ 2 *
          weightedComplexWave n t j +
        (2 : ℂ) * ((h : ℝ) / n) * complexWave n t h *
          (complexWave n t h - complexWave n s h) * complexWave n t j := by
  unfold twistedDifference weightedComplexWave
  simp_rw [complexWave_add]
  push_cast
  ring

/-- A nonmatching double twist preserves the two-dimensional affine-mode
space.  Its velocity coefficient is multiplied by the squared spectral gap;
the displayed second term is the triangular correction to position. -/
lemma doubleTwist_affineMode
    (n : ℕ) (t : ℝ) (h : ℤ) (ζ : ℂ) (j : ℤ) (A B : ℂ) :
    doubleTwist h ζ
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) j =
      (A * (complexWave n t h - ζ) ^ 2 +
          B * ((2 : ℂ) * ((h : ℝ) / n) * complexWave n t h *
            (complexWave n t h - ζ))) *
          complexWave n t j +
        (B * (complexWave n t h - ζ) ^ 2) *
          weightedComplexWave n t j := by
  unfold doubleTwist twistedDifference weightedComplexWave
  simp_rw [complexWave_add]
  push_cast
  ring

/-- Product of the squared gaps acquired by a velocity mode under a list of
double twists. -/
noncomputable def modeSeparationProduct
    (n : ℕ) (t : ℝ) (h : ℤ) (twists : List ℂ) : ℂ :=
  (twists.map (fun ζ ↦ (complexWave n t h - ζ) ^ 2)).prod

@[simp] lemma modeSeparationProduct_nil (n : ℕ) (t : ℝ) (h : ℤ) :
    modeSeparationProduct n t h [] = 1 := rfl

@[simp] lemma modeSeparationProduct_cons
    (n : ℕ) (t : ℝ) (h : ℤ) (ζ : ℂ) (twists : List ℂ) :
    modeSeparationProduct n t h (ζ :: twists) =
      (complexWave n t h - ζ) ^ 2 *
        modeSeparationProduct n t h twists := rfl

lemma norm_modeSeparationProduct
    (n : ℕ) (t : ℝ) (h : ℤ) (twists : List ℂ) :
    ‖modeSeparationProduct n t h twists‖ =
      (twists.map (fun ζ ↦ ‖complexWave n t h - ζ‖ ^ 2)).prod := by
  induction twists with
  | nil => simp
  | cons ζ twists ih =>
      simp only [modeSeparationProduct_cons, norm_mul, norm_pow, List.map_cons,
        List.prod_cons, ih]

lemma norm_modeSeparationProduct_replicate_one
    (n : ℕ) (t : ℝ) (h : ℤ) (k : ℕ) :
    ‖modeSeparationProduct n t h (List.replicate k 1)‖ =
      ‖complexWave n t h - 1‖ ^ (2 * k) := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [List.replicate_succ, modeSeparationProduct_cons, norm_mul,
        norm_pow, ih]
      rw [show 2 * (k + 1) = 2 + 2 * k by omega, pow_add]

lemma pow_gap_le_norm_modeSeparationProduct
    (n : ℕ) (t : ℝ) (h : ℤ) (twists : List ℂ) (δ : ℝ)
    (hδ : 0 ≤ δ) (hgap : ∀ ζ ∈ twists, δ ≤ ‖complexWave n t h - ζ‖) :
    δ ^ (2 * twists.length) ≤ ‖modeSeparationProduct n t h twists‖ := by
  induction twists with
  | nil => simp
  | cons ζ twists ih =>
      have hζ : δ ≤ ‖complexWave n t h - ζ‖ := hgap ζ (by simp)
      have hrest : ∀ η ∈ twists, δ ≤ ‖complexWave n t h - η‖ := by
        intro η hη
        exact hgap η (by simp [hη])
      have hi := ih hrest
      rw [modeSeparationProduct_cons, norm_mul, norm_pow]
      rw [List.length_cons,
        show 2 * (twists.length + 1) = 2 + 2 * twists.length by omega,
        pow_add]
      exact mul_le_mul
        (by nlinarith [hζ, norm_nonneg (complexWave n t h - ζ)]) hi
        (pow_nonneg hδ _) (sq_nonneg _)

lemma norm_modeSeparationProduct_le_pow_gap
    (n : ℕ) (t : ℝ) (h : ℤ) (twists : List ℂ) (η : ℝ)
    (hη : 0 ≤ η)
    (hgap : ∀ ζ ∈ twists, ‖complexWave n t h - ζ‖ ≤ η) :
    ‖modeSeparationProduct n t h twists‖ ≤
      η ^ (2 * twists.length) := by
  induction twists with
  | nil => simp
  | cons ζ twists ih =>
      have hζ : ‖complexWave n t h - ζ‖ ≤ η := hgap ζ (by simp)
      have hrest : ∀ θ ∈ twists, ‖complexWave n t h - θ‖ ≤ η := by
        intro θ hθ
        exact hgap θ (by simp [hθ])
      have hi := ih hrest
      rw [modeSeparationProduct_cons, norm_mul, norm_pow,
        List.length_cons,
        show 2 * (twists.length + 1) = 2 + 2 * twists.length by omega,
        pow_add]
      exact mul_le_mul
        (pow_le_pow_left₀ (norm_nonneg _) hζ 2) hi
        (norm_nonneg _) (pow_nonneg hη 2)

lemma norm_modeSeparationProduct_le_four_pow
    (n : ℕ) (t : ℝ) (h : ℤ) (twists : List ℂ)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1) :
    ‖modeSeparationProduct n t h twists‖ ≤ (4 : ℝ) ^ twists.length := by
  induction twists with
  | nil => simp
  | cons ζ twists ih =>
      have hζ : ‖ζ‖ = 1 := hunit ζ (by simp)
      have hrest : ∀ η ∈ twists, ‖η‖ = 1 := by
        intro η hη
        exact hunit η (by simp [hη])
      have hgap : ‖complexWave n t h - ζ‖ ≤ 2 := by
        calc
          ‖complexWave n t h - ζ‖ ≤ ‖complexWave n t h‖ + ‖ζ‖ :=
            norm_sub_le _ _
          _ = 2 := by rw [norm_complexWave, hζ]; norm_num
      rw [modeSeparationProduct_cons, norm_mul, norm_pow,
        List.length_cons]
      rw [show (4 : ℝ) ^ (twists.length + 1) =
        4 * 4 ^ twists.length by rw [pow_succ]; ring]
      have hgapSq : ‖complexWave n t h - ζ‖ ^ 2 ≤ 4 := by
        nlinarith [norm_nonneg (complexWave n t h - ζ)]
      exact mul_le_mul hgapSq (ih hrest) (norm_nonneg _) (by norm_num)

/-- The position coefficient obtained after transporting an affine mode
through a list of double twists. -/
noncomputable def affinePositionAfter
    (n : ℕ) (t : ℝ) (h : ℤ) (A B : ℂ) : List ℂ → ℂ
  | [] => A
  | ζ :: twists =>
      affinePositionAfter n t h A B twists *
          (complexWave n t h - ζ) ^ 2 +
        (B * modeSeparationProduct n t h twists) *
          ((2 : ℂ) * ((h : ℝ) / n) * complexWave n t h *
            (complexWave n t h - ζ))

/-- Exact triangular transport formula for both coefficients of an affine
mode under all double twists. -/
lemma iteratedDoubleTwist_affineMode_eq_after
    (n : ℕ) (t : ℝ) (h : ℤ) (A B : ℂ) (twists : List ℂ) :
    iteratedDoubleTwist h twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) =
      fun q ↦ affinePositionAfter n t h A B twists * complexWave n t q +
        (B * modeSeparationProduct n t h twists) *
          weightedComplexWave n t q := by
  induction twists with
  | nil =>
      funext q
      simp [affinePositionAfter]
  | cons ζ twists ih =>
      simp only [iteratedDoubleTwist_cons]
      rw [ih]
      funext q
      rw [doubleTwist_affineMode]
      simp only [affinePositionAfter, modeSeparationProduct_cons]
      ring

/-- General-step form of the triangular transport bound.  A twist by the
integer step `h` costs `|h|/n` in the off-diagonal position--velocity term. -/
lemma norm_affinePositionAfter_sub_le_general
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h : ℤ) (A B : ℂ) (twists : List ℂ)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1) :
    ‖affinePositionAfter n t h A B twists -
        A * modeSeparationProduct n t h twists‖ ≤
      (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ * |(h : ℝ)| / n := by
  induction twists with
  | nil => simp [affinePositionAfter]
  | cons ζ twists ih =>
      have hζ : ‖ζ‖ = 1 := hunit ζ (by simp)
      have hrest : ∀ η ∈ twists, ‖η‖ = 1 := by
        intro η hη
        exact hunit η (by simp [hη])
      have ih' := ih hrest
      let gap : ℂ := complexWave n t h - ζ
      let correction : ℂ :=
        (2 : ℂ) * (((h : ℝ) / n : ℝ) : ℂ) * complexWave n t h * gap
      have hgap : ‖gap‖ ≤ 2 := by
        dsimp [gap]
        calc
          ‖complexWave n t h - ζ‖ ≤ ‖complexWave n t h‖ + ‖ζ‖ :=
            norm_sub_le _ _
          _ = 2 := by rw [norm_complexWave, hζ]; norm_num
      have hgapSq : ‖gap‖ ^ 2 ≤ 4 := by
        nlinarith [norm_nonneg gap]
      have hprod : ‖modeSeparationProduct n t h twists‖ ≤
          (4 : ℝ) ^ twists.length :=
        norm_modeSeparationProduct_le_four_pow n t h twists hrest
      have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
      have hcorrection : ‖correction‖ ≤ 4 * |(h : ℝ)| / n := by
        have heq : ‖correction‖ = 2 * (|(h : ℝ)| / (n : ℝ)) * ‖gap‖ := by
          dsimp [correction]
          simp only [norm_mul, norm_complexWave, mul_one, Complex.norm_real,
            Real.norm_eq_abs, abs_div, abs_of_pos hnreal]
          norm_num
        rw [heq]
        calc
          2 * (|(h : ℝ)| / (n : ℝ)) * ‖gap‖ ≤
              2 * (|(h : ℝ)| / (n : ℝ)) * 2 := by gcongr
          _ = 4 * |(h : ℝ)| / n := by ring
      have hid :
          affinePositionAfter n t h A B (ζ :: twists) -
              A * modeSeparationProduct n t h (ζ :: twists) =
            (affinePositionAfter n t h A B twists -
                A * modeSeparationProduct n t h twists) * gap ^ 2 +
              (B * modeSeparationProduct n t h twists) * correction := by
        simp only [affinePositionAfter, modeSeparationProduct_cons,
          gap, correction]
        push_cast
        ring
      rw [hid]
      calc
        ‖(affinePositionAfter n t h A B twists -
                A * modeSeparationProduct n t h twists) * gap ^ 2 +
              (B * modeSeparationProduct n t h twists) * correction‖ ≤
            ‖affinePositionAfter n t h A B twists -
                A * modeSeparationProduct n t h twists‖ * ‖gap‖ ^ 2 +
              (‖B‖ * ‖modeSeparationProduct n t h twists‖) *
                ‖correction‖ := by
          calc
            _ ≤ ‖(affinePositionAfter n t h A B twists -
                    A * modeSeparationProduct n t h twists) * gap ^ 2‖ +
                  ‖(B * modeSeparationProduct n t h twists) * correction‖ :=
                norm_add_le _ _
            _ = ‖affinePositionAfter n t h A B twists -
                    A * modeSeparationProduct n t h twists‖ * ‖gap‖ ^ 2 +
                  (‖B‖ * ‖modeSeparationProduct n t h twists‖) *
                    ‖correction‖ := by rw [norm_mul, norm_pow, norm_mul,
                      norm_mul]
        _ ≤ ((twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ *
                |(h : ℝ)| / n) * 4 +
              (‖B‖ * (4 : ℝ) ^ twists.length) *
                (4 * |(h : ℝ)| / n) := by
          gcongr
        _ = (((ζ :: twists).length : ℕ) : ℝ) *
              (4 : ℝ) ^ (ζ :: twists).length * ‖B‖ * |(h : ℝ)| / n := by
          simp only [List.length_cons, Nat.cast_add, Nat.cast_one, pow_succ]
          ring

/-- Sharp form of the triangular transport estimate.  When every spectral
gap is at most `η`, the position--velocity correction retains all but one of
the `2 * twists.length` small gap factors.  This is the quantitative feature
needed for polynomially large Fourier frequencies in Cook--Nguyen's local
central limit theorem. -/
lemma norm_affinePositionAfter_sub_le_pow_gap
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h : ℤ) (A B : ℂ)
    (twists : List ℂ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ ζ ∈ twists, ‖complexWave n t h - ζ‖ ≤ η) :
    ‖affinePositionAfter n t h A B twists -
        A * modeSeparationProduct n t h twists‖ ≤
      2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
        η ^ (2 * twists.length - 1) := by
  induction twists with
  | nil => simp [affinePositionAfter]
  | cons ζ twists ih =>
      have hζ : ‖complexWave n t h - ζ‖ ≤ η := hgap ζ (by simp)
      have hrest : ∀ θ ∈ twists,
          ‖complexWave n t h - θ‖ ≤ η := by
        intro θ hθ
        exact hgap θ (by simp [hθ])
      have ih' := ih hrest
      let gap : ℂ := complexWave n t h - ζ
      let correction : ℂ :=
        (2 : ℂ) * (((h : ℝ) / n : ℝ) : ℂ) * complexWave n t h * gap
      have hgap' : ‖gap‖ ≤ η := by simpa [gap] using hζ
      have hprod : ‖modeSeparationProduct n t h twists‖ ≤
          η ^ (2 * twists.length) :=
        norm_modeSeparationProduct_le_pow_gap n t h twists η hη hrest
      have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
      have hcorrection : ‖correction‖ ≤
          2 * (|(h : ℝ)| / n) * η := by
        have heq : ‖correction‖ =
            2 * (|(h : ℝ)| / n) * ‖gap‖ := by
          dsimp [correction]
          simp only [norm_mul, norm_complexWave, mul_one, Complex.norm_real,
            Real.norm_eq_abs, abs_div, abs_of_pos hnreal]
          norm_num
        rw [heq]
        exact mul_le_mul_of_nonneg_left hgap'
          (mul_nonneg (by norm_num) (by positivity))
      have hid :
          affinePositionAfter n t h A B (ζ :: twists) -
              A * modeSeparationProduct n t h (ζ :: twists) =
            (affinePositionAfter n t h A B twists -
                A * modeSeparationProduct n t h twists) * gap ^ 2 +
              (B * modeSeparationProduct n t h twists) * correction := by
        simp only [affinePositionAfter, modeSeparationProduct_cons,
          gap, correction]
        push_cast
        ring
      rw [hid]
      calc
        ‖(affinePositionAfter n t h A B twists -
                A * modeSeparationProduct n t h twists) * gap ^ 2 +
              (B * modeSeparationProduct n t h twists) * correction‖ ≤
            ‖affinePositionAfter n t h A B twists -
                A * modeSeparationProduct n t h twists‖ * ‖gap‖ ^ 2 +
              (‖B‖ * ‖modeSeparationProduct n t h twists‖) *
                ‖correction‖ := by
          calc
            _ ≤ ‖(affinePositionAfter n t h A B twists -
                    A * modeSeparationProduct n t h twists) * gap ^ 2‖ +
                  ‖(B * modeSeparationProduct n t h twists) * correction‖ :=
                norm_add_le _ _
            _ = _ := by rw [norm_mul, norm_pow, norm_mul, norm_mul]
        _ ≤
            (2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
                η ^ (2 * twists.length - 1)) * η ^ 2 +
              (‖B‖ * η ^ (2 * twists.length)) *
                (2 * (|(h : ℝ)| / n) * η) := by
          gcongr
        _ = 2 * ((ζ :: twists).length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
              η ^ (2 * (ζ :: twists).length - 1) := by
          by_cases hlen : twists.length = 0
          · simp [hlen]
            ring
          · have hpow₁ :
                η ^ (2 * twists.length - 1) * η ^ 2 =
                  η ^ (2 * twists.length + 1) := by
              rw [← pow_add]
              congr 1
              omega
            have hpow₂ :
                η ^ (2 * twists.length) * η =
                  η ^ (2 * twists.length + 1) := by
              rw [pow_succ]
            rw [show
              (2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
                    η ^ (2 * twists.length - 1)) * η ^ 2 =
                2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
                  (η ^ (2 * twists.length - 1) * η ^ 2) by ring]
            rw [show
              (‖B‖ * η ^ (2 * twists.length)) *
                    (2 * (|(h : ℝ)| / n) * η) =
                2 * ‖B‖ * |(h : ℝ)| / n *
                  (η ^ (2 * twists.length) * η) by ring]
            rw [hpow₁, hpow₂]
            simp only [List.length_cons, Nat.cast_add, Nat.cast_one]
            rw [show 2 * (twists.length + 1) - 1 =
                2 * twists.length + 1 by omega]
            ring

/-- Quantitative high-difference bound for one affine exponential mode.
The pure-mode factor retains every small spectral gap; the triangular
position--velocity correction is controlled separately by `|h|/n`. -/
lemma norm_iteratedDoubleTwist_affineMode_le_general
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h j : ℤ) (A B : ℂ)
    (twists : List ℂ) (η : ℝ) (hη : 0 ≤ η)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ ζ ∈ twists, ‖complexWave n t h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists
        (fun q ↦ A * complexWave n t q +
          B * weightedComplexWave n t q) j‖ ≤
      ‖A‖ * η ^ (2 * twists.length) +
        (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
          ‖B‖ * |(h : ℝ)| / n +
        ‖B‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n := by
  let P : ℂ := modeSeparationProduct n t h twists
  let C : ℂ := affinePositionAfter n t h A B twists
  have heq := congrFun
    (iteratedDoubleTwist_affineMode_eq_after n t h A B twists) j
  have hP : ‖P‖ ≤ η ^ (2 * twists.length) := by
    simpa [P] using
      norm_modeSeparationProduct_le_pow_gap n t h twists η hη hgap
  have hcorr : ‖C - A * P‖ ≤
      (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
        ‖B‖ * |(h : ℝ)| / n := by
    simpa [C, P] using
      norm_affinePositionAfter_sub_le_general n hn t h A B twists hunit
  have hC : ‖C‖ ≤
      ‖A‖ * η ^ (2 * twists.length) +
        (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
          ‖B‖ * |(h : ℝ)| / n := by
    calc
      ‖C‖ = ‖A * P + (C - A * P)‖ := by congr 1 <;> ring
      _ ≤ ‖A * P‖ + ‖C - A * P‖ := norm_add_le _ _
      _ = ‖A‖ * ‖P‖ + ‖C - A * P‖ := by rw [norm_mul]
      _ ≤ ‖A‖ * η ^ (2 * twists.length) +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
            ‖B‖ * |(h : ℝ)| / n := by
        gcongr
  rw [heq]
  calc
    ‖C * complexWave n t j +
        (B * P) * weightedComplexWave n t j‖ ≤
        ‖C * complexWave n t j‖ +
          ‖(B * P) * weightedComplexWave n t j‖ := norm_add_le _ _
    _ = ‖C‖ + (‖B‖ * ‖P‖) * (|(j : ℝ)| / n) := by
      rw [norm_mul, norm_complexWave, mul_one, norm_mul, norm_mul,
        norm_weightedComplexWave n hn]
    _ ≤
        (‖A‖ * η ^ (2 * twists.length) +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
            ‖B‖ * |(h : ℝ)| / n) +
        (‖B‖ * η ^ (2 * twists.length)) * (|(j : ℝ)| / n) := by
      gcongr
    _ = ‖A‖ * η ^ (2 * twists.length) +
        (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
          ‖B‖ * |(h : ℝ)| / n +
        ‖B‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n := by ring

/-- Sharp small-gap version of the affine-mode high-difference bound. -/
lemma norm_iteratedDoubleTwist_affineMode_le_pow_gap
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h j : ℤ) (A B : ℂ)
    (twists : List ℂ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ ζ ∈ twists, ‖complexWave n t h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists
        (fun q ↦ A * complexWave n t q +
          B * weightedComplexWave n t q) j‖ ≤
      ‖A‖ * η ^ (2 * twists.length) +
        (2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
          η ^ (2 * twists.length - 1)) +
        ‖B‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n := by
  let P : ℂ := modeSeparationProduct n t h twists
  let C : ℂ := affinePositionAfter n t h A B twists
  have heq := congrFun
    (iteratedDoubleTwist_affineMode_eq_after n t h A B twists) j
  have hP : ‖P‖ ≤ η ^ (2 * twists.length) := by
    simpa [P] using
      norm_modeSeparationProduct_le_pow_gap n t h twists η hη hgap
  have hcorr : ‖C - A * P‖ ≤
      2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
        η ^ (2 * twists.length - 1) := by
    simpa [C, P] using
      norm_affinePositionAfter_sub_le_pow_gap
        n hn t h A B twists η hη hgap
  have hC : ‖C‖ ≤
      ‖A‖ * η ^ (2 * twists.length) +
        2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
          η ^ (2 * twists.length - 1) := by
    calc
      ‖C‖ = ‖A * P + (C - A * P)‖ := by congr 1 <;> ring
      _ ≤ ‖A * P‖ + ‖C - A * P‖ := norm_add_le _ _
      _ = ‖A‖ * ‖P‖ + ‖C - A * P‖ := by rw [norm_mul]
      _ ≤ ‖A‖ * η ^ (2 * twists.length) +
          2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
            η ^ (2 * twists.length - 1) := by
        gcongr
  rw [heq]
  calc
    ‖C * complexWave n t j +
        (B * P) * weightedComplexWave n t j‖ ≤
        ‖C * complexWave n t j‖ +
          ‖(B * P) * weightedComplexWave n t j‖ := norm_add_le _ _
    _ = ‖C‖ + (‖B‖ * ‖P‖) * (|(j : ℝ)| / n) := by
      rw [norm_mul, norm_complexWave, mul_one, norm_mul, norm_mul,
        norm_weightedComplexWave n hn]
    _ ≤
        (‖A‖ * η ^ (2 * twists.length) +
          2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
            η ^ (2 * twists.length - 1)) +
        (‖B‖ * η ^ (2 * twists.length)) * (|(j : ℝ)| / n) := by
      gcongr
    _ = ‖A‖ * η ^ (2 * twists.length) +
        (2 * (twists.length : ℝ) * ‖B‖ * |(h : ℝ)| / n *
          η ^ (2 * twists.length - 1)) +
        ‖B‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n := by ring

noncomputable def variableModeSeparationProduct
    (n : ℕ) (t : ℝ) (twists : List VariableTwist) : ℂ :=
  (twists.map (fun hζ ↦
    (complexWave n t (hζ.1 : ℤ) - hζ.2) ^ 2)).prod

def variableStepSum (twists : List VariableTwist) : ℕ :=
  (twists.map Prod.fst).sum

@[simp] lemma variableModeSeparationProduct_nil (n : ℕ) (t : ℝ) :
    variableModeSeparationProduct n t [] = 1 := rfl

@[simp] lemma variableModeSeparationProduct_cons
    (n : ℕ) (t : ℝ) (h : ℕ) (ζ : ℂ) (twists : List VariableTwist) :
    variableModeSeparationProduct n t ((h, ζ) :: twists) =
      (complexWave n t h - ζ) ^ 2 *
        variableModeSeparationProduct n t twists := rfl

@[simp] lemma variableStepSum_nil : variableStepSum [] = 0 := rfl

@[simp] lemma variableStepSum_cons
    (h : ℕ) (ζ : ℂ) (twists : List VariableTwist) :
    variableStepSum ((h, ζ) :: twists) = h + variableStepSum twists := by
  simp [variableStepSum]

lemma variableTwistSpan_eq_two_mul_stepSum (twists : List VariableTwist) :
    variableTwistSpan twists = 2 * variableStepSum twists := by
  induction twists with
  | nil => rfl
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      simp [ih]
      omega

lemma pow_gap_le_norm_variableModeSeparationProduct
    (n : ℕ) (t : ℝ) (twists : List VariableTwist) (δ : ℝ)
    (hδ : 0 ≤ δ)
    (hgap : ∀ hζ ∈ twists,
      δ ≤ ‖complexWave n t (hζ.1 : ℤ) - hζ.2‖) :
    δ ^ (2 * twists.length) ≤
      ‖variableModeSeparationProduct n t twists‖ := by
  induction twists with
  | nil => simp
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      have hζgap : δ ≤ ‖complexWave n t h - ζ‖ :=
        hgap (h, ζ) (by simp)
      have hrest : ∀ kη ∈ twists,
          δ ≤ ‖complexWave n t (kη.1 : ℤ) - kη.2‖ := by
        intro kη hkη
        exact hgap kη (by simp [hkη])
      have hi := ih hrest
      rw [variableModeSeparationProduct_cons, norm_mul, norm_pow]
      rw [List.length_cons,
        show 2 * (twists.length + 1) = 2 + 2 * twists.length by omega,
        pow_add]
      exact mul_le_mul
        (by nlinarith [hζgap, norm_nonneg (complexWave n t h - ζ)]) hi
        (pow_nonneg hδ _) (sq_nonneg _)

lemma norm_variableModeSeparationProduct_le_four_pow
    (n : ℕ) (t : ℝ) (twists : List VariableTwist)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1) :
    ‖variableModeSeparationProduct n t twists‖ ≤
      (4 : ℝ) ^ twists.length := by
  induction twists with
  | nil => simp
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      have hζunit : ‖ζ‖ = 1 := hunit (h, ζ) (by simp)
      have hrest : ∀ kη ∈ twists, ‖kη.2‖ = 1 := by
        intro kη hkη
        exact hunit kη (by simp [hkη])
      have hgap : ‖complexWave n t h - ζ‖ ≤ 2 := by
        calc
          ‖complexWave n t h - ζ‖ ≤ ‖complexWave n t h‖ + ‖ζ‖ :=
            norm_sub_le _ _
          _ = 2 := by rw [norm_complexWave, hζunit]; norm_num
      rw [variableModeSeparationProduct_cons, norm_mul, norm_pow,
        List.length_cons]
      rw [show (4 : ℝ) ^ (twists.length + 1) =
          4 * 4 ^ twists.length by rw [pow_succ]; ring]
      have hgapSq : ‖complexWave n t h - ζ‖ ^ 2 ≤ 4 := by
        nlinarith [norm_nonneg (complexWave n t h - ζ)]
      exact mul_le_mul hgapSq (ih hrest) (norm_nonneg _) (by norm_num)

noncomputable def variableAffinePositionAfter
    (n : ℕ) (t : ℝ) (A B : ℂ) : List VariableTwist → ℂ
  | [] => A
  | (h, ζ) :: twists =>
      variableAffinePositionAfter n t A B twists *
          (complexWave n t h - ζ) ^ 2 +
        (B * variableModeSeparationProduct n t twists) *
          ((2 : ℂ) * (((h : ℝ) / n : ℝ) : ℂ) * complexWave n t h *
            (complexWave n t h - ζ))

lemma iteratedVariableDoubleTwist_affineMode_eq_after
    (n : ℕ) (t : ℝ) (A B : ℂ) (twists : List VariableTwist) :
    iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) =
      fun q ↦ variableAffinePositionAfter n t A B twists *
          complexWave n t q +
        (B * variableModeSeparationProduct n t twists) *
          weightedComplexWave n t q := by
  induction twists with
  | nil =>
      funext q
      simp [variableAffinePositionAfter]
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      simp only [iteratedVariableDoubleTwist_cons]
      rw [ih]
      funext q
      rw [doubleTwist_affineMode]
      simp only [variableAffinePositionAfter,
        variableModeSeparationProduct_cons]
      push_cast
      ring

/-- Lossless-in-length velocity extraction from an isolated affine mode.
The input `ℓ²` mass is measured on the exact window sampled by all variable
twists; the remaining `2H` outputs provide the cubic affine-energy gain. -/
lemma mul_sq_velocity_gap_div_le_isolation_energy
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ)
    (twists : List VariableTwist) (f : ℤ → ℂ) (j : ℤ)
    (H : ℕ) (δ : ℝ) (hδ : 0 ≤ δ)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1)
    (hgap : ∀ hζ ∈ twists,
      δ ≤ ‖complexWave n t (hζ.1 : ℤ) - hζ.2‖)
    (hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q)) :
    (H : ℝ) *
        (((H : ℝ) * (‖B‖ * δ ^ (2 * twists.length)) / n) ^ 2) ≤
      2 * (36 : ℝ) ^ twists.length *
        ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2 := by
  let C : ℂ := variableAffinePositionAfter n t A B twists
  let P : ℂ := variableModeSeparationProduct n t twists
  let g : ℤ → ℂ := iteratedVariableDoubleTwist twists f
  have hg : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedVariableDoubleTwist_affineMode_eq_after n t A B twists)
  have hP : δ ^ (2 * twists.length) ≤ ‖P‖ := by
    simpa [P] using
      pow_gap_le_norm_variableModeSeparationProduct n t twists δ hδ hgap
  have hBP : ‖B‖ * δ ^ (2 * twists.length) ≤ ‖B * P‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left hP (norm_nonneg B)
  have hcoeff :
      (H : ℝ) *
          (((H : ℝ) * (‖B‖ * δ ^ (2 * twists.length)) / n) ^ 2) ≤
        (H : ℝ) * (((H : ℝ) * ‖B * P‖ / n) ^ 2) := by
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    have hH : 0 ≤ (H : ℝ) := Nat.cast_nonneg H
    have hleft : 0 ≤ (H : ℝ) *
        (‖B‖ * δ ^ (2 * twists.length)) / n := by positivity
    have hright : 0 ≤ (H : ℝ) * ‖B * P‖ / n := by positivity
    have hlinear : (H : ℝ) *
        (‖B‖ * δ ^ (2 * twists.length)) / n ≤
          (H : ℝ) * ‖B * P‖ / n := by gcongr
    exact mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ hleft hlinear 2) hH
  have haffine := mul_sq_velocity_div_le_two_sum_affineComplexMode
    n hn t C (B * P) j H
  have hsumEq :
      ∑ v ∈ Finset.range (2 * H), ‖g (j + v)‖ ^ 2 =
        ∑ v ∈ Finset.range (2 * H),
          ‖C * complexWave n t (j + v) +
            (B * P) * weightedComplexWave n t (j + v)‖ ^ 2 := by
    apply Finset.sum_congr rfl
    intro v _hv
    rw [hg]
  have hoperator := sum_sq_norm_iteratedVariableDoubleTwist_range_le
    twists f j (2 * H + variableTwistSpan twists)
      (by omega) hunit
  have hsub : 2 * H + variableTwistSpan twists -
      variableTwistSpan twists = 2 * H := by omega
  have hoperator' :
      ∑ v ∈ Finset.range (2 * H), ‖g (j + v)‖ ^ 2 ≤
        (36 : ℝ) ^ twists.length *
          ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
            ‖f (j + r)‖ ^ 2 := by
    simpa [g, hsub] using hoperator
  calc
    (H : ℝ) *
        (((H : ℝ) * (‖B‖ * δ ^ (2 * twists.length)) / n) ^ 2) ≤
        (H : ℝ) * (((H : ℝ) * ‖B * P‖ / n) ^ 2) := hcoeff
    _ ≤ 2 * ∑ v ∈ Finset.range (2 * H),
          ‖C * complexWave n t (j + v) +
            (B * P) * weightedComplexWave n t (j + v)‖ ^ 2 := haffine
    _ = 2 * ∑ v ∈ Finset.range (2 * H), ‖g (j + v)‖ ^ 2 := by rw [hsumEq]
    _ ≤ 2 * ((36 : ℝ) ^ twists.length *
        ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2) := by gcongr
    _ = 2 * (36 : ℝ) ^ twists.length *
        ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2 := by ring

/-- The companion position estimate for an isolated affine mode.  A block
whose start is `O(H)` from the origin controls the transported position with
no loss in the block length. -/
lemma mul_sq_variableAffinePosition_le_isolation_energy
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ)
    (twists : List VariableTwist) (f : ℤ → ℂ) (j : ℤ)
    (H : ℕ) (hH : 0 < H) (J : ℝ) (hJ : 0 ≤ J)
    (hj : |(j : ℝ)| ≤ J * H)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1)
    (hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q)) :
    (H : ℝ) * ‖variableAffinePositionAfter n t A B twists‖ ^ 2 ≤
      (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^ twists.length *
        ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2 := by
  let C : ℂ := variableAffinePositionAfter n t A B twists
  let P : ℂ := variableModeSeparationProduct n t twists
  let g : ℤ → ℂ := iteratedVariableDoubleTwist twists f
  have hg : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedVariableDoubleTwist_affineMode_eq_after n t A B twists)
  have hposition := mul_sq_position_le_factor_sum_affineComplexMode
    n hn t C (B * P) j H hH J hJ hj
  have hsumEq :
      ∑ v ∈ Finset.range (2 * H), ‖g (j + v)‖ ^ 2 =
        ∑ v ∈ Finset.range (2 * H),
          ‖C * complexWave n t (j + v) +
            (B * P) * weightedComplexWave n t (j + v)‖ ^ 2 := by
    apply Finset.sum_congr rfl
    intro v _hv
    rw [hg]
  have hoperator := sum_sq_norm_iteratedVariableDoubleTwist_range_le
    twists f j (2 * H + variableTwistSpan twists)
      (by omega) hunit
  have hsub : 2 * H + variableTwistSpan twists -
      variableTwistSpan twists = 2 * H := by omega
  have hoperator' :
      ∑ v ∈ Finset.range (2 * H), ‖g (j + v)‖ ^ 2 ≤
        (36 : ℝ) ^ twists.length *
          ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
            ‖f (j + r)‖ ^ 2 := by
    simpa [g, hsub] using hoperator
  calc
    (H : ℝ) * ‖variableAffinePositionAfter n t A B twists‖ ^ 2 =
        (H : ℝ) * ‖C‖ ^ 2 := by rfl
    _ ≤ (2 + 4 * (J + 1) ^ 2) *
        ∑ v ∈ Finset.range (2 * H),
          ‖C * complexWave n t (j + v) +
            (B * P) * weightedComplexWave n t (j + v)‖ ^ 2 := hposition
    _ = (2 + 4 * (J + 1) ^ 2) *
        ∑ v ∈ Finset.range (2 * H), ‖g (j + v)‖ ^ 2 := by rw [hsumEq]
    _ ≤ (2 + 4 * (J + 1) ^ 2) *
        ((36 : ℝ) ^ twists.length *
          ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
            ‖f (j + r)‖ ^ 2) := by
      have hfactor : 0 ≤ 2 + 4 * (J + 1) ^ 2 := by positivity
      exact mul_le_mul_of_nonneg_left hoperator' hfactor
    _ = (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^ twists.length *
        ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2 := by ring

/-- Variable-step triangular correction.  Only the sum of selected steps
enters the off-diagonal loss. -/
lemma norm_variableAffinePositionAfter_sub_le
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ)
    (twists : List VariableTwist)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1) :
    ‖variableAffinePositionAfter n t A B twists -
        A * variableModeSeparationProduct n t twists‖ ≤
      2 * (4 : ℝ) ^ twists.length * ‖B‖ *
        (variableStepSum twists : ℝ) / n := by
  induction twists with
  | nil => simp [variableAffinePositionAfter]
  | cons hζ twists ih =>
      rcases hζ with ⟨h, ζ⟩
      have hζunit : ‖ζ‖ = 1 := hunit (h, ζ) (by simp)
      have hrest : ∀ kη ∈ twists, ‖kη.2‖ = 1 := by
        intro kη hkη
        exact hunit kη (by simp [hkη])
      have ih' := ih hrest
      let gap : ℂ := complexWave n t h - ζ
      let correction : ℂ :=
        (2 : ℂ) * (((h : ℝ) / n : ℝ) : ℂ) *
          complexWave n t h * gap
      have hgap : ‖gap‖ ≤ 2 := by
        dsimp [gap]
        calc
          ‖complexWave n t h - ζ‖ ≤ ‖complexWave n t h‖ + ‖ζ‖ :=
            norm_sub_le _ _
          _ = 2 := by rw [norm_complexWave, hζunit]; norm_num
      have hgapSq : ‖gap‖ ^ 2 ≤ 4 := by
        nlinarith [norm_nonneg gap]
      have hprod : ‖variableModeSeparationProduct n t twists‖ ≤
          (4 : ℝ) ^ twists.length :=
        norm_variableModeSeparationProduct_le_four_pow n t twists hrest
      have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
      have hhreal : (0 : ℝ) ≤ h := Nat.cast_nonneg h
      have hcorrection : ‖correction‖ ≤ 4 * (h : ℝ) / n := by
        have heq : ‖correction‖ =
            2 * ((h : ℝ) / (n : ℝ)) * ‖gap‖ := by
          dsimp [correction]
          simp only [norm_mul, norm_complexWave, mul_one, Complex.norm_real,
            Real.norm_eq_abs, abs_div, abs_of_pos hnreal,
            abs_of_nonneg hhreal]
          norm_num
        rw [heq]
        calc
          2 * ((h : ℝ) / (n : ℝ)) * ‖gap‖ ≤
              2 * ((h : ℝ) / (n : ℝ)) * 2 := by gcongr
          _ = 4 * (h : ℝ) / n := by ring
      have hid :
          variableAffinePositionAfter n t A B ((h, ζ) :: twists) -
              A * variableModeSeparationProduct n t ((h, ζ) :: twists) =
            (variableAffinePositionAfter n t A B twists -
                A * variableModeSeparationProduct n t twists) * gap ^ 2 +
              (B * variableModeSeparationProduct n t twists) * correction := by
        simp only [variableAffinePositionAfter,
          variableModeSeparationProduct_cons, gap, correction]
        push_cast
        ring
      rw [hid]
      calc
        ‖(variableAffinePositionAfter n t A B twists -
                A * variableModeSeparationProduct n t twists) * gap ^ 2 +
              (B * variableModeSeparationProduct n t twists) * correction‖ ≤
            ‖variableAffinePositionAfter n t A B twists -
                A * variableModeSeparationProduct n t twists‖ * ‖gap‖ ^ 2 +
              (‖B‖ * ‖variableModeSeparationProduct n t twists‖) *
                ‖correction‖ := by
          calc
            _ ≤ ‖(variableAffinePositionAfter n t A B twists -
                    A * variableModeSeparationProduct n t twists) * gap ^ 2‖ +
                  ‖(B * variableModeSeparationProduct n t twists) *
                    correction‖ := norm_add_le _ _
            _ = ‖variableAffinePositionAfter n t A B twists -
                    A * variableModeSeparationProduct n t twists‖ * ‖gap‖ ^ 2 +
                  (‖B‖ * ‖variableModeSeparationProduct n t twists‖) *
                    ‖correction‖ := by
              rw [norm_mul, norm_pow, norm_mul, norm_mul]
        _ ≤ (2 * (4 : ℝ) ^ twists.length * ‖B‖ *
                (variableStepSum twists : ℝ) / n) * 4 +
              (‖B‖ * (4 : ℝ) ^ twists.length) *
                (4 * (h : ℝ) / n) := by gcongr
        _ ≤ 2 * (4 : ℝ) ^ ((h, ζ) :: twists).length * ‖B‖ *
              (variableStepSum ((h, ζ) :: twists) : ℝ) / n := by
          simp only [List.length_cons, pow_succ, variableStepSum_cons,
            Nat.cast_add]
          have hh : (0 : ℝ) ≤ h := Nat.cast_nonneg h
          have hs : (0 : ℝ) ≤ variableStepSum twists := Nat.cast_nonneg _
          ring_nf
          have hnonneg : 0 ≤
              ‖B‖ * ((n : ℝ)⁻¹) * (h : ℝ) * (4 : ℝ) ^ twists.length := by
            positivity
          nlinarith

/-- A variable-step product annihilates an affine mode as soon as it
contains the matching step and phase for that mode. -/
lemma iteratedVariableDoubleTwist_mode_zero
    (n : ℕ) (t : ℝ) (A B : ℂ) (twists : List VariableTwist)
    (h : ℕ)
    (hmem : (h, complexWave n t (h : ℤ)) ∈ twists) :
    iteratedVariableDoubleTwist twists
      (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) = 0 := by
  induction twists with
  | nil => simp at hmem
  | cons kζ twists ih =>
      rcases kζ with ⟨k, ζ⟩
      rcases List.mem_cons.mp hmem with hmatch | hrest
      · have hk : k = h := congrArg Prod.fst hmatch.symm
        have hζ : ζ = complexWave n t (h : ℤ) := congrArg Prod.snd hmatch.symm
        subst k
        subst ζ
        simp only [iteratedVariableDoubleTwist_cons]
        rw [iteratedVariableDoubleTwist_affineMode_eq_after]
        funext q
        exact doubleTwist_mode_same n t (h : ℤ) q
          (variableAffinePositionAfter n t A B twists)
          (B * variableModeSeparationProduct n t twists)
      · simp only [iteratedVariableDoubleTwist_cons]
        rw [ih hrest, doubleTwist_zero]

/-- Variable-step velocity extraction.  The required window length is the
sum of the individual double-difference spans. -/
lemma variableVelocityCoeff_mul_gap_pow_div_le_of_isolation
    (n : ℕ) (hn : 0 < n) (t : ℝ) (j : ℤ) (A B : ℂ)
    (twists : List VariableTwist) (f : ℤ → ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1)
    (hgap : ∀ hζ ∈ twists,
      δ ≤ ‖complexWave n t (hζ.1 : ℤ) - hζ.2‖)
    (hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q))
    (hwindow0 : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖f (j + q)‖ ≤ M)
    (hwindow1 : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖f ((j + 1) + q)‖ ≤ M) :
    ‖B‖ * δ ^ (2 * twists.length) / n ≤
      2 * ((4 : ℝ) ^ twists.length * M) := by
  let C : ℂ := variableAffinePositionAfter n t A B twists
  let P : ℂ := variableModeSeparationProduct n t twists
  let g : ℤ → ℂ := iteratedVariableDoubleTwist twists f
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedVariableDoubleTwist_affineMode_eq_after n t A B twists)
  have hg0 : ‖g j‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedVariableDoubleTwist_le_of_window_bound
      twists f j M hM hunit
    exact hwindow0
  have hg1 : ‖g (j + 1)‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedVariableDoubleTwist_le_of_window_bound
      twists f (j + 1) M hM hunit
    exact hwindow1
  have hvelocity := norm_velocityCoeff_div_le_two_max n hn t j C (B * P)
  have hgEq0 := congrFun hgEq j
  have hgEq1 := congrFun hgEq (j + 1)
  rw [← hgEq0, ← hgEq1] at hvelocity
  have hupper : ‖B * P‖ / n ≤
      2 * ((4 : ℝ) ^ twists.length * M) :=
    hvelocity.trans
      (mul_le_mul_of_nonneg_left (max_le hg0 hg1) (by norm_num))
  have hprod := pow_gap_le_norm_variableModeSeparationProduct
    n t twists δ hδ hgap
  have hmul : ‖B‖ * δ ^ (2 * twists.length) ≤ ‖B * P‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (by simpa [P] using hprod) (norm_nonneg B)
  exact (div_le_div_of_nonneg_right hmul (Nat.cast_nonneg n)).trans hupper

/-- Variable-step position extraction, with the triangular correction
controlled by the sum of the chosen steps. -/
lemma variablePositionCoeff_mul_gap_pow_le_of_isolation
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ)
    (twists : List VariableTwist) (f : ℤ → ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1)
    (hgap : ∀ hζ ∈ twists,
      δ ≤ ‖complexWave n t (hζ.1 : ℤ) - hζ.2‖)
    (hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q))
    (hwindow : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖f q‖ ≤ M) :
    ‖A‖ * δ ^ (2 * twists.length) ≤
      (4 : ℝ) ^ twists.length * M +
        2 * (4 : ℝ) ^ twists.length * ‖B‖ *
          (variableStepSum twists : ℝ) / n := by
  let C : ℂ := variableAffinePositionAfter n t A B twists
  let P : ℂ := variableModeSeparationProduct n t twists
  let g : ℤ → ℂ := iteratedVariableDoubleTwist twists f
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedVariableDoubleTwist_affineMode_eq_after n t A B twists)
  have hg0 : ‖g 0‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedVariableDoubleTwist_le_of_window_bound
      twists f 0 M hM hunit
    intro q hq
    simpa using hwindow q hq
  have hC : ‖C‖ ≤ (4 : ℝ) ^ twists.length * M := by
    have h0 := congrFun hgEq 0
    have h0' : g 0 = C := by
      simpa [complexWave, weightedComplexWave] using h0
    simpa [h0'] using hg0
  have hcorrection : ‖C - A * P‖ ≤
      2 * (4 : ℝ) ^ twists.length * ‖B‖ *
        (variableStepSum twists : ℝ) / n := by
    simpa [C, P] using
      norm_variableAffinePositionAfter_sub_le n hn t A B twists hunit
  have hprod := pow_gap_le_norm_variableModeSeparationProduct
    n t twists δ hδ hgap
  have hlower : ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (by simpa [P] using hprod) (norm_nonneg A)
  calc
    ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := hlower
    _ = ‖C - (C - A * P)‖ := by congr 1 <;> ring
    _ ≤ ‖C‖ + ‖C - A * P‖ := norm_sub_le _ _
    _ ≤ (4 : ℝ) ^ twists.length * M +
          2 * (4 : ℝ) ^ twists.length * ‖B‖ *
            (variableStepSum twists : ℝ) / n :=
      add_le_add hC hcorrection

/-- Position extraction on a translated window.  Translation adds the
explicit `|j|/n` velocity correction. -/
lemma variablePositionCoeff_mul_gap_pow_le_of_isolation_at
    (n : ℕ) (hn : 0 < n) (t : ℝ) (j : ℤ) (A B : ℂ)
    (twists : List VariableTwist) (f : ℤ → ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ hζ ∈ twists, ‖hζ.2‖ = 1)
    (hgap : ∀ hζ ∈ twists,
      δ ≤ ‖complexWave n t (hζ.1 : ℤ) - hζ.2‖)
    (hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q))
    (hwindow : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖f (j + q)‖ ≤ M) :
    ‖A‖ * δ ^ (2 * twists.length) ≤
      (4 : ℝ) ^ twists.length * M +
        (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n +
        2 * (4 : ℝ) ^ twists.length * ‖B‖ *
          (variableStepSum twists : ℝ) / n := by
  let C : ℂ := variableAffinePositionAfter n t A B twists
  let P : ℂ := variableModeSeparationProduct n t twists
  let g : ℤ → ℂ := iteratedVariableDoubleTwist twists f
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedVariableDoubleTwist_affineMode_eq_after n t A B twists)
  have hg : ‖g j‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedVariableDoubleTwist_le_of_window_bound
      twists f j M hM hunit
    exact hwindow
  have hfactor : g j =
      (C + (B * P) * (((j : ℝ) / n : ℝ) : ℂ)) * complexWave n t j := by
    rw [congrFun hgEq j]
    unfold weightedComplexWave
    push_cast
    ring
  have hcomb :
      ‖C + (B * P) * (((j : ℝ) / n : ℝ) : ℂ)‖ ≤
        (4 : ℝ) ^ twists.length * M := by
    rw [hfactor, norm_mul, norm_complexWave, mul_one] at hg
    exact hg
  have hP : ‖P‖ ≤ (4 : ℝ) ^ twists.length :=
    norm_variableModeSeparationProduct_le_four_pow n t twists hunit
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hshift :
      ‖(B * P) * (((j : ℝ) / n : ℝ) : ℂ)‖ ≤
        (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n := by
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_div, abs_of_pos hnreal]
    calc
      ‖B‖ * ‖P‖ * (|(j : ℝ)| / (n : ℝ)) ≤
          ‖B‖ * (4 : ℝ) ^ twists.length *
            (|(j : ℝ)| / (n : ℝ)) := by gcongr
      _ = (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n := by ring
  have hC : ‖C‖ ≤
      (4 : ℝ) ^ twists.length * M +
        (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n := by
    calc
      ‖C‖ = ‖(C + (B * P) * (((j : ℝ) / n : ℝ) : ℂ)) -
          (B * P) * (((j : ℝ) / n : ℝ) : ℂ)‖ := by congr 1 <;> ring
      _ ≤ ‖C + (B * P) * (((j : ℝ) / n : ℝ) : ℂ)‖ +
          ‖(B * P) * (((j : ℝ) / n : ℝ) : ℂ)‖ := norm_sub_le _ _
      _ ≤ (4 : ℝ) ^ twists.length * M +
          (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n :=
        add_le_add hcomb hshift
  have hcorrection : ‖C - A * P‖ ≤
      2 * (4 : ℝ) ^ twists.length * ‖B‖ *
        (variableStepSum twists : ℝ) / n := by
    simpa [C, P] using
      norm_variableAffinePositionAfter_sub_le n hn t A B twists hunit
  have hprod := pow_gap_le_norm_variableModeSeparationProduct
    n t twists δ hδ hgap
  have hlower : ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (by simpa [P] using hprod) (norm_nonneg A)
  calc
    ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := hlower
    _ = ‖C - (C - A * P)‖ := by congr 1 <;> ring
    _ ≤ ‖C‖ + ‖C - A * P‖ := norm_sub_le _ _
    _ ≤ ((4 : ℝ) ^ twists.length * M +
          (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n) +
        2 * (4 : ℝ) ^ twists.length * ‖B‖ *
          (variableStepSum twists : ℝ) / n := add_le_add hC hcorrection
    _ = (4 : ℝ) ^ twists.length * M +
        (4 : ℝ) ^ twists.length * ‖B‖ * |(j : ℝ)| / n +
        2 * (4 : ℝ) ^ twists.length * ‖B‖ *
          (variableStepSum twists : ℝ) / n := by ring

/-- The triangular correction to the position coefficient is controlled by
the velocity coefficient.  Each unitary double twist costs at most four,
and its off-diagonal term costs at most `4/n`. -/
lemma norm_affinePositionAfter_sub_le
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ) (twists : List ℂ)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1) :
    ‖affinePositionAfter n t 1 A B twists -
        A * modeSeparationProduct n t 1 twists‖ ≤
      (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ / n := by
  induction twists with
  | nil => simp [affinePositionAfter]
  | cons ζ twists ih =>
      have hζ : ‖ζ‖ = 1 := hunit ζ (by simp)
      have hrest : ∀ η ∈ twists, ‖η‖ = 1 := by
        intro η hη
        exact hunit η (by simp [hη])
      have ih' := ih hrest
      let gap : ℂ := complexWave n t 1 - ζ
      let correction : ℂ :=
        (2 : ℂ) * (((1 : ℝ) / n : ℝ) : ℂ) * complexWave n t 1 * gap
      have hgap : ‖gap‖ ≤ 2 := by
        dsimp [gap]
        calc
          ‖complexWave n t 1 - ζ‖ ≤ ‖complexWave n t 1‖ + ‖ζ‖ :=
            norm_sub_le _ _
          _ = 2 := by rw [norm_complexWave, hζ]; norm_num
      have hgapSq : ‖gap‖ ^ 2 ≤ 4 := by
        nlinarith [norm_nonneg gap]
      have hprod : ‖modeSeparationProduct n t 1 twists‖ ≤
          (4 : ℝ) ^ twists.length :=
        norm_modeSeparationProduct_le_four_pow n t 1 twists hrest
      have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
      have hcorrection : ‖correction‖ ≤ 4 / n := by
        have heq : ‖correction‖ = 2 * (1 / (n : ℝ)) * ‖gap‖ := by
          dsimp [correction]
          simp only [norm_mul, norm_complexWave, mul_one, Complex.norm_real,
            Real.norm_eq_abs, abs_div, abs_one, abs_of_pos hnreal]
          norm_num
        rw [heq]
        calc
          2 * (1 / (n : ℝ)) * ‖gap‖ ≤ 2 * (1 / (n : ℝ)) * 2 := by
            gcongr
          _ = 4 / n := by ring
      have hid :
          affinePositionAfter n t 1 A B (ζ :: twists) -
              A * modeSeparationProduct n t 1 (ζ :: twists) =
            (affinePositionAfter n t 1 A B twists -
                A * modeSeparationProduct n t 1 twists) * gap ^ 2 +
              (B * modeSeparationProduct n t 1 twists) * correction := by
        simp only [affinePositionAfter, modeSeparationProduct_cons,
          gap, correction]
        push_cast
        ring
      rw [hid]
      calc
        ‖(affinePositionAfter n t 1 A B twists -
                A * modeSeparationProduct n t 1 twists) * gap ^ 2 +
              (B * modeSeparationProduct n t 1 twists) * correction‖ ≤
            ‖affinePositionAfter n t 1 A B twists -
                A * modeSeparationProduct n t 1 twists‖ * ‖gap‖ ^ 2 +
              (‖B‖ * ‖modeSeparationProduct n t 1 twists‖) *
                ‖correction‖ := by
          calc
            _ ≤ ‖(affinePositionAfter n t 1 A B twists -
                    A * modeSeparationProduct n t 1 twists) * gap ^ 2‖ +
                  ‖(B * modeSeparationProduct n t 1 twists) * correction‖ :=
                norm_add_le _ _
            _ = ‖affinePositionAfter n t 1 A B twists -
                    A * modeSeparationProduct n t 1 twists‖ * ‖gap‖ ^ 2 +
                  (‖B‖ * ‖modeSeparationProduct n t 1 twists‖) *
                    ‖correction‖ := by rw [norm_mul, norm_pow, norm_mul,
                      norm_mul]
        _ ≤ ((twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ / n) * 4 +
              (‖B‖ * (4 : ℝ) ^ twists.length) * (4 / n) := by
          gcongr
        _ = (((ζ :: twists).length : ℕ) : ℝ) *
              (4 : ℝ) ^ (ζ :: twists).length * ‖B‖ / n := by
          simp only [List.length_cons, Nat.cast_add, Nat.cast_one, pow_succ]
          ring

/-- After any commuting list of twists, an affine-weighted mode is still an
affine-weighted mode, and its velocity coefficient is exactly the original
coefficient times the product of squared gaps. -/
lemma exists_iteratedDoubleTwist_affineMode
    (n : ℕ) (t : ℝ) (h : ℤ) (A B : ℂ) (twists : List ℂ) :
    ∃ C : ℂ,
      iteratedDoubleTwist h twists
          (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q) =
        fun q ↦ C * complexWave n t q +
          (B * modeSeparationProduct n t h twists) *
            weightedComplexWave n t q := by
  induction twists with
  | nil =>
      refine ⟨A, ?_⟩
      funext q
      simp
  | cons ζ twists ih =>
      rcases ih with ⟨C, hC⟩
      let gap : ℂ := complexWave n t h - ζ
      let correction : ℂ :=
        (2 : ℂ) * ((h : ℝ) / n) * complexWave n t h * gap
      refine ⟨C * gap ^ 2 +
        (B * modeSeparationProduct n t h twists) * correction, ?_⟩
      simp only [iteratedDoubleTwist_cons]
      rw [hC]
      funext q
      rw [show doubleTwist h ζ
          (fun q ↦ C * complexWave n t q +
            (B * modeSeparationProduct n t h twists) *
              weightedComplexWave n t q) q =
          (C * gap ^ 2 +
              (B * modeSeparationProduct n t h twists) * correction) *
              complexWave n t q +
            ((B * modeSeparationProduct n t h twists) * gap ^ 2) *
              weightedComplexWave n t q by
        simpa only [gap, correction] using
          (doubleTwist_affineMode n
            (t := t) (h := h) (ζ := ζ) (j := q) C
            (B * modeSeparationProduct n t h twists))]
      simp only [modeSeparationProduct_cons, gap]
      ring

/-- Quantitative extraction of the velocity coefficient from a bounded
window of an affine mode.  This packages the entire repeated-difference
argument: every spectral gap contributes twice, every double twist costs at
most four, and the final matching first difference costs two. -/
lemma velocityCoeff_mul_gap_pow_div_le
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h j : ℤ) (A B : ℂ)
    (twists : List ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ ζ ∈ twists, δ ≤ ‖complexWave n t h - ζ‖)
    (hwindow0 : ∀ q : ℕ, q ≤ 2 * twists.length →
      ‖A * complexWave n t (j + (q : ℤ) * h) +
        B * weightedComplexWave n t (j + (q : ℤ) * h)‖ ≤ M)
    (hwindow1 : ∀ q : ℕ, q ≤ 2 * twists.length →
      ‖A * complexWave n t ((j + 1) + (q : ℤ) * h) +
        B * weightedComplexWave n t ((j + 1) + (q : ℤ) * h)‖ ≤ M) :
    ‖B‖ * δ ^ (2 * twists.length) / n ≤
      2 * ((4 : ℝ) ^ twists.length * M) := by
  let f : ℤ → ℂ :=
    fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q
  let g : ℤ → ℂ := iteratedDoubleTwist h twists f
  rcases exists_iteratedDoubleTwist_affineMode n t h A B twists with
    ⟨C, hC⟩
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * modeSeparationProduct n t h twists) *
        weightedComplexWave n t q := by
    exact hC
  have hg0 : ‖g j‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedDoubleTwist_le_of_window_bound h twists f j M hM hunit
    intro q hq
    exact hwindow0 q hq
  have hg1 : ‖g (j + 1)‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedDoubleTwist_le_of_window_bound h twists f (j + 1) M hM hunit
    intro q hq
    exact hwindow1 q hq
  have hvelocity := norm_velocityCoeff_div_le_two_max n hn t j C
    (B * modeSeparationProduct n t h twists)
  have hgEq0 := congrFun hgEq j
  have hgEq1 := congrFun hgEq (j + 1)
  rw [← hgEq0, ← hgEq1] at hvelocity
  have hupper : ‖B * modeSeparationProduct n t h twists‖ / n ≤
      2 * ((4 : ℝ) ^ twists.length * M) := by
    exact hvelocity.trans (mul_le_mul_of_nonneg_left (max_le hg0 hg1) (by norm_num))
  have hprod := pow_gap_le_norm_modeSeparationProduct n t h twists δ hδ hgap
  have hmul : ‖B‖ * δ ^ (2 * twists.length) ≤
      ‖B * modeSeparationProduct n t h twists‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left hprod (norm_nonneg B)
  exact (div_le_div_of_nonneg_right hmul (Nat.cast_nonneg n)).trans hupper

/-- The same velocity extraction when the target affine mode is first
isolated from a larger exponential polynomial.  The window bound is then
required only for the original polynomial, which is the form used for the
realified phase projection. -/
lemma velocityCoeff_mul_gap_pow_div_le_of_isolation
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h j : ℤ) (A B : ℂ)
    (twists : List ℂ) (f : ℤ → ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ ζ ∈ twists, δ ≤ ‖complexWave n t h - ζ‖)
    (hisolate : iteratedDoubleTwist h twists f =
      iteratedDoubleTwist h twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q))
    (hwindow0 : ∀ q : ℕ, q ≤ 2 * twists.length →
      ‖f (j + (q : ℤ) * h)‖ ≤ M)
    (hwindow1 : ∀ q : ℕ, q ≤ 2 * twists.length →
      ‖f ((j + 1) + (q : ℤ) * h)‖ ≤ M) :
    ‖B‖ * δ ^ (2 * twists.length) / n ≤
      2 * ((4 : ℝ) ^ twists.length * M) := by
  let g : ℤ → ℂ := iteratedDoubleTwist h twists f
  rcases exists_iteratedDoubleTwist_affineMode n t h A B twists with
    ⟨C, hC⟩
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * modeSeparationProduct n t h twists) *
        weightedComplexWave n t q := hisolate.trans hC
  have hg0 : ‖g j‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedDoubleTwist_le_of_window_bound h twists f j M hM hunit
    intro q hq
    exact hwindow0 q hq
  have hg1 : ‖g (j + 1)‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedDoubleTwist_le_of_window_bound h twists f (j + 1) M hM hunit
    intro q hq
    exact hwindow1 q hq
  have hvelocity := norm_velocityCoeff_div_le_two_max n hn t j C
    (B * modeSeparationProduct n t h twists)
  have hgEq0 := congrFun hgEq j
  have hgEq1 := congrFun hgEq (j + 1)
  rw [← hgEq0, ← hgEq1] at hvelocity
  have hupper : ‖B * modeSeparationProduct n t h twists‖ / n ≤
      2 * ((4 : ℝ) ^ twists.length * M) :=
    hvelocity.trans (mul_le_mul_of_nonneg_left (max_le hg0 hg1) (by norm_num))
  have hprod := pow_gap_le_norm_modeSeparationProduct n t h twists δ hδ hgap
  have hmul : ‖B‖ * δ ^ (2 * twists.length) ≤
      ‖B * modeSeparationProduct n t h twists‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left hprod (norm_nonneg B)
  exact (div_le_div_of_nonneg_right hmul (Nat.cast_nonneg n)).trans hupper

/-- Position-coefficient extraction after isolation.  The explicit second
term is precisely the triangular correction caused by the velocity
coefficient. -/
lemma positionCoeff_mul_gap_pow_le_of_isolation
    (n : ℕ) (hn : 0 < n) (t : ℝ) (A B : ℂ)
    (twists : List ℂ) (f : ℤ → ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ ζ ∈ twists, δ ≤ ‖complexWave n t 1 - ζ‖)
    (hisolate : iteratedDoubleTwist 1 twists f =
      iteratedDoubleTwist 1 twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q))
    (hwindow : ∀ q : ℕ, q ≤ 2 * twists.length → ‖f q‖ ≤ M) :
    ‖A‖ * δ ^ (2 * twists.length) ≤
      (4 : ℝ) ^ twists.length * M +
        (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ / n := by
  let C : ℂ := affinePositionAfter n t 1 A B twists
  let P : ℂ := modeSeparationProduct n t 1 twists
  let g : ℤ → ℂ := iteratedDoubleTwist 1 twists f
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedDoubleTwist_affineMode_eq_after n t 1 A B twists)
  have hg0 : ‖g 0‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedDoubleTwist_le_of_window_bound 1 twists f 0 M hM hunit
    intro q hq
    simpa using hwindow q hq
  have hC : ‖C‖ ≤ (4 : ℝ) ^ twists.length * M := by
    have h0 := congrFun hgEq 0
    have h0' : g 0 = C := by
      simpa [complexWave, weightedComplexWave] using h0
    simpa [h0'] using hg0
  have hcorrection : ‖C - A * P‖ ≤
      (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ / n := by
    simpa [C, P] using
      norm_affinePositionAfter_sub_le n hn t A B twists hunit
  have hprod := pow_gap_le_norm_modeSeparationProduct
    n t 1 twists δ hδ hgap
  have hlower : ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (by simpa [P] using hprod) (norm_nonneg A)
  calc
    ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := hlower
    _ = ‖C - (C - A * P)‖ := by congr 1 <;> ring
    _ ≤ ‖C‖ + ‖C - A * P‖ := norm_sub_le _ _
    _ ≤ (4 : ℝ) ^ twists.length * M +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ / n :=
      add_le_add hC hcorrection

/-- General-step position extraction.  This is the form needed after the
simultaneous-dilation step chooses a nontrivial integer increment. -/
lemma positionCoeff_mul_gap_pow_le_of_isolation_general
    (n : ℕ) (hn : 0 < n) (t : ℝ) (h : ℤ) (A B : ℂ)
    (twists : List ℂ) (f : ℤ → ℂ) (δ M : ℝ)
    (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ ζ ∈ twists, δ ≤ ‖complexWave n t h - ζ‖)
    (hisolate : iteratedDoubleTwist h twists f =
      iteratedDoubleTwist h twists
        (fun q ↦ A * complexWave n t q + B * weightedComplexWave n t q))
    (hwindow : ∀ q : ℕ, q ≤ 2 * twists.length →
      ‖f ((q : ℤ) * h)‖ ≤ M) :
    ‖A‖ * δ ^ (2 * twists.length) ≤
      (4 : ℝ) ^ twists.length * M +
        (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ *
          |(h : ℝ)| / n := by
  let C : ℂ := affinePositionAfter n t h A B twists
  let P : ℂ := modeSeparationProduct n t h twists
  let g : ℤ → ℂ := iteratedDoubleTwist h twists f
  have hgEq : g = fun q ↦ C * complexWave n t q +
      (B * P) * weightedComplexWave n t q := by
    exact hisolate.trans
      (iteratedDoubleTwist_affineMode_eq_after n t h A B twists)
  have hg0 : ‖g 0‖ ≤ (4 : ℝ) ^ twists.length * M := by
    apply norm_iteratedDoubleTwist_le_of_window_bound h twists f 0 M hM hunit
    intro q hq
    simpa using hwindow q hq
  have hC : ‖C‖ ≤ (4 : ℝ) ^ twists.length * M := by
    have h0 := congrFun hgEq 0
    have h0' : g 0 = C := by
      simpa [complexWave, weightedComplexWave] using h0
    simpa [h0'] using hg0
  have hcorrection : ‖C - A * P‖ ≤
      (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ *
        |(h : ℝ)| / n := by
    simpa [C, P] using
      norm_affinePositionAfter_sub_le_general n hn t h A B twists hunit
  have hprod := pow_gap_le_norm_modeSeparationProduct
    n t h twists δ hδ hgap
  have hlower : ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (by simpa [P] using hprod) (norm_nonneg A)
  calc
    ‖A‖ * δ ^ (2 * twists.length) ≤ ‖A * P‖ := hlower
    _ = ‖C - (C - A * P)‖ := by congr 1 <;> ring
    _ ≤ ‖C‖ + ‖C - A * P‖ := norm_sub_le _ _
    _ ≤ (4 : ℝ) ^ twists.length * M +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length * ‖B‖ *
            |(h : ℝ)| / n := add_le_add hC hcorrection

/-- Integer frequency represented by an index of the centered coefficient
array. -/
def centeredIndex (n : ℕ) (j : Fin (2 * n + 1)) : ℤ := (j : ℤ) - n

lemma centeredIndex_cast (n : ℕ) (j : Fin (2 * n + 1)) :
    (centeredIndex n j : ℝ) = centeredFrequency n j := by
  simp [centeredIndex, centeredFrequency]

/-- Complex coefficient whose real pairing with a wave gives the position
part of a real phase-space direction. -/
noncomputable def phasePositionCoeff (u : PhaseCoordinate m) (r : Fin m) : ℂ :=
  (u r 0 : ℂ) - (u r 1 : ℂ) * Complex.I

/-- Complex coefficient whose real pairing with a weighted wave gives the
normalized-velocity part of a phase-space direction. -/
noncomputable def phaseVelocityCoeff (u : PhaseCoordinate m) (r : Fin m) : ℂ :=
  (u r 3 : ℂ) + (u r 2 : ℂ) * Complex.I

lemma norm_phasePositionCoeff_le (u : PhaseCoordinate m) (r : Fin m) :
    ‖phasePositionCoeff u r‖ ≤ |u r 0| + |u r 1| := by
  unfold phasePositionCoeff
  calc
    ‖(u r 0 : ℂ) - (u r 1 : ℂ) * Complex.I‖ ≤
        ‖(u r 0 : ℂ)‖ + ‖(u r 1 : ℂ) * Complex.I‖ := norm_sub_le _ _
    _ = |u r 0| + |u r 1| := by simp [Real.norm_eq_abs]

lemma norm_phaseVelocityCoeff_le (u : PhaseCoordinate m) (r : Fin m) :
    ‖phaseVelocityCoeff u r‖ ≤ |u r 2| + |u r 3| := by
  unfold phaseVelocityCoeff
  calc
    ‖(u r 3 : ℂ) + (u r 2 : ℂ) * Complex.I‖ ≤
        ‖(u r 3 : ℂ)‖ + ‖(u r 2 : ℂ) * Complex.I‖ := norm_add_le _ _
    _ = |u r 2| + |u r 3| := by
      simp [Real.norm_eq_abs, add_comm]

lemma sum_norm_phaseCoeffs_le_l1 (u : PhaseCoordinate m) :
    ∑ r : Fin m,
        (‖phasePositionCoeff u r‖ + ‖phaseVelocityCoeff u r‖) ≤
      ∑ r : Fin m, ∑ c : Fin 4, |u r c| := by
  apply Finset.sum_le_sum
  intro r _
  rw [Fin.sum_univ_four]
  linarith [norm_phasePositionCoeff_le u r,
    norm_phaseVelocityCoeff_le u r]

/-- A general finite exponential polynomial with affine frequency weights. -/
noncomputable def complexModeSum {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ)
    (A B : I → ℂ) (j : ℤ) : ℂ :=
  ∑ r : I,
    (A r * complexWave n (times r) j +
      B r * weightedComplexWave n (times r) j)

lemma norm_iteratedDoubleTwist_complexModeSum_le_general
    {I : Type*} [Fintype I]
    (n : ℕ) (hn : 0 < n) (times : I → ℝ) (A B : I → ℂ)
    (h j : ℤ) (twists : List ℂ) (η : ℝ) (hη : 0 ≤ η)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ r, ∀ ζ ∈ twists,
      ‖complexWave n (times r) h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists (complexModeSum n times A B) j‖ ≤
      ∑ r : I,
        (‖A r‖ * η ^ (2 * twists.length) +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
            ‖B r‖ * |(h : ℝ)| / n +
          ‖B r‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n) := by
  unfold complexModeSum
  rw [iteratedDoubleTwist_sum]
  calc
    ‖∑ r : I,
        iteratedDoubleTwist h twists
          (fun q ↦ A r * complexWave n (times r) q +
            B r * weightedComplexWave n (times r) q) j‖ ≤
        ∑ r : I,
          ‖iteratedDoubleTwist h twists
            (fun q ↦ A r * complexWave n (times r) q +
              B r * weightedComplexWave n (times r) q) j‖ :=
      norm_sum_le _ _
    _ ≤ ∑ r : I,
        (‖A r‖ * η ^ (2 * twists.length) +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
            ‖B r‖ * |(h : ℝ)| / n +
          ‖B r‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n) := by
      apply Finset.sum_le_sum
      intro r _
      exact norm_iteratedDoubleTwist_affineMode_le_general
        n hn (times r) h j (A r) (B r) twists η hη hunit (hgap r)

/-- Sharp small-gap transport bound for a finite affine exponential sum. -/
lemma norm_iteratedDoubleTwist_complexModeSum_le_pow_gap
    {I : Type*} [Fintype I]
    (n : ℕ) (hn : 0 < n) (times : I → ℝ) (A B : I → ℂ)
    (h j : ℤ) (twists : List ℂ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ r, ∀ ζ ∈ twists,
      ‖complexWave n (times r) h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists (complexModeSum n times A B) j‖ ≤
      ∑ r : I,
        (‖A r‖ * η ^ (2 * twists.length) +
          (2 * (twists.length : ℝ) * ‖B r‖ * |(h : ℝ)| / n *
            η ^ (2 * twists.length - 1)) +
          ‖B r‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n) := by
  unfold complexModeSum
  rw [iteratedDoubleTwist_sum]
  calc
    ‖∑ r : I,
        iteratedDoubleTwist h twists
          (fun q ↦ A r * complexWave n (times r) q +
            B r * weightedComplexWave n (times r) q) j‖ ≤
        ∑ r : I,
          ‖iteratedDoubleTwist h twists
            (fun q ↦ A r * complexWave n (times r) q +
              B r * weightedComplexWave n (times r) q) j‖ :=
      norm_sum_le _ _
    _ ≤ ∑ r : I,
        (‖A r‖ * η ^ (2 * twists.length) +
          (2 * (twists.length : ℝ) * ‖B r‖ * |(h : ℝ)| / n *
            η ^ (2 * twists.length - 1)) +
          ‖B r‖ * η ^ (2 * twists.length) * |(j : ℝ)| / n) := by
      apply Finset.sum_le_sum
      intro r _
      exact norm_iteratedDoubleTwist_affineMode_le_pow_gap
        n hn (times r) h j (A r) (B r) twists η hη (hgap r)

/-- Exact coefficientwise transport of a finite affine exponential sum
through a fixed-step list of double twists. -/
lemma iteratedDoubleTwist_complexModeSum_eq_after
    {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ) (A B : I → ℂ)
    (h : ℤ) (twists : List ℂ) :
    iteratedDoubleTwist h twists (complexModeSum n times A B) =
      complexModeSum n times
        (fun r ↦ affinePositionAfter n (times r) h (A r) (B r) twists)
        (fun r ↦ B r * modeSeparationProduct n (times r) h twists) := by
  unfold complexModeSum
  rw [iteratedDoubleTwist_sum]
  funext j
  apply Finset.sum_congr rfl
  intro r _hr
  exact congrFun
    (iteratedDoubleTwist_affineMode_eq_after
      n (times r) h (A r) (B r) twists) j

/-- Twists matching every mode except `s` isolate that one affine-weighted
frequency from a finite exponential polynomial. -/
lemma iteratedDoubleTwist_complexModeSum_eq_single
    {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ) (A B : I → ℂ)
    (h : ℤ) (twists : List ℂ) (s : I)
    (hkill : ∀ r, r ≠ s → complexWave n (times r) h ∈ twists) :
    iteratedDoubleTwist h twists (complexModeSum n times A B) =
      iteratedDoubleTwist h twists
        (fun q ↦ A s * complexWave n (times s) q +
          B s * weightedComplexWave n (times s) q) := by
  unfold complexModeSum
  rw [iteratedDoubleTwist_sum]
  funext q
  rw [Finset.sum_eq_single s]
  · intro r _ hrs
    rw [iteratedDoubleTwist_mode_zero n (times r) h (A r) (B r)
      twists (hkill r hrs)]
    rfl
  · simp

/-- Variable-step analogue of spectral isolation: every unwanted affine
mode may be killed at its own integer step. -/
lemma iteratedVariableDoubleTwist_complexModeSum_eq_single
    {I : Type*} [Fintype I]
    (n : ℕ) (times : I → ℝ) (A B : I → ℂ)
    (twists : List VariableTwist) (s : I)
    (hkill : ∀ r, r ≠ s →
      ∃ h : ℕ, (h, complexWave n (times r) (h : ℤ)) ∈ twists) :
    iteratedVariableDoubleTwist twists (complexModeSum n times A B) =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A s * complexWave n (times s) q +
          B s * weightedComplexWave n (times s) q) := by
  unfold complexModeSum
  rw [iteratedVariableDoubleTwist_sum]
  funext q
  rw [Finset.sum_eq_single s]
  · intro r _ hrs
    rcases hkill r hrs with ⟨h, hh⟩
    rw [iteratedVariableDoubleTwist_mode_zero
      n (times r) (A r) (B r) twists h hh]
    rfl
  · simp

lemma doubleTwist_complexModeSum
    (n : ℕ) (times : Fin m → ℝ) (A B : Fin m → ℂ)
    (s : ℝ) (h j : ℤ) :
    doubleTwist h (complexWave n s h) (complexModeSum n times A B) j =
      ∑ r : Fin m,
        (A r *
            ((complexWave n (times r) h - complexWave n s h) ^ 2 *
              complexWave n (times r) j) +
          B r *
            (((complexWave n (times r) h - complexWave n s h) ^ 2 *
                weightedComplexWave n (times r) j) +
              (2 : ℂ) * ((h : ℝ) / n) * complexWave n (times r) h *
                (complexWave n (times r) h - complexWave n s h) *
                  complexWave n (times r) j)) := by
  unfold complexModeSum
  rw [doubleTwist_sum]
  apply Finset.sum_congr rfl
  intro r _
  rw [doubleTwist_add, doubleTwist_const_mul, doubleTwist_const_mul]
  rw [show doubleTwist h (complexWave n s h) (complexWave n (times r)) j =
      (complexWave n (times r) h - complexWave n s h) ^ 2 *
        complexWave n (times r) j by
    exact twistedDifference_twice_complexWave n s (times r) h j]
  rw [show doubleTwist h (complexWave n s h)
        (weightedComplexWave n (times r)) j =
      (complexWave n (times r) h - complexWave n s h) ^ 2 *
          weightedComplexWave n (times r) j +
        (2 : ℂ) * ((h : ℝ) / n) * complexWave n (times r) h *
          (complexWave n (times r) h - complexWave n s h) *
            complexWave n (times r) j by
    exact twistedDifference_twice_weightedComplexWave n s (times r) h j]

/-- Complex exponential-polynomial encoding of a scalar phase projection. -/
noncomputable def complexPhaseProjection (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (j : ℤ) : ℂ :=
  ∑ r : Fin m, (
    phasePositionCoeff u r * complexWave n (points r) j +
      phaseVelocityCoeff u r * weightedComplexWave n (points r) j)

lemma complexPhaseProjection_eq_complexModeSum
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    complexPhaseProjection n points u =
      complexModeSum n points (phasePositionCoeff u) (phaseVelocityCoeff u) := by
  rfl

lemma norm_iteratedDoubleTwist_complexPhaseProjection_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (twists : List ℂ)
    (η : ℝ) (hη : 0 ≤ η)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ r, ∀ ζ ∈ twists,
      ‖complexWave n (points r) h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists
        (complexPhaseProjection n points u) j‖ ≤
      ∑ r : Fin m,
        (‖phasePositionCoeff u r‖ * η ^ (2 * twists.length) +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
            ‖phaseVelocityCoeff u r‖ * |(h : ℝ)| / n +
          ‖phaseVelocityCoeff u r‖ * η ^ (2 * twists.length) *
            |(j : ℝ)| / n) := by
  rw [complexPhaseProjection_eq_complexModeSum]
  exact norm_iteratedDoubleTwist_complexModeSum_le_general
    n hn points (phasePositionCoeff u) (phaseVelocityCoeff u)
      h j twists η hη hunit hgap

/-- Dirichlet differencing specialization: all twists are the ordinary
forward-difference twist `1`. -/
lemma norm_iteratedOrdinaryDoubleDifference_complexPhaseProjection_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ r, ‖complexWave n (points r) h - 1‖ ≤ η) :
    ‖iteratedDoubleTwist h (List.replicate k 1)
        (complexPhaseProjection n points u) j‖ ≤
      ∑ r : Fin m,
        (‖phasePositionCoeff u r‖ * η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k *
            ‖phaseVelocityCoeff u r‖ * |(h : ℝ)| / n +
          ‖phaseVelocityCoeff u r‖ * η ^ (2 * k) *
            |(j : ℝ)| / n) := by
  simpa using norm_iteratedDoubleTwist_complexPhaseProjection_le
    n hn points u h j (List.replicate k 1) η hη
    (by
      intro ζ hζ
      simp only [List.mem_replicate] at hζ
      rcases hζ with ⟨_hk, rfl⟩
      simp)
    (by
      intro r ζ hζ
      simp only [List.mem_replicate] at hζ
      rcases hζ with ⟨_hk, rfl⟩
      exact hgap r)

/-- Realification of the complex exponential polynomial.  It has precisely
the scalar phase projection as its real value and explicitly contains both
the original and reflected spectral modes. -/
noncomputable def realComplexPhaseProjection (n : ℕ) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (j : ℤ) : ℂ :=
  (complexPhaseProjection n points u j +
      conj (complexPhaseProjection n points u j)) / 2

lemma realComplexPhaseProjection_eq_re
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (j : ℤ) :
    realComplexPhaseProjection n points u j =
      ((complexPhaseProjection n points u j).re : ℂ) := by
  apply Complex.ext <;>
    simp [realComplexPhaseProjection, Complex.div_re, Complex.div_im]

lemma conj_complexPhaseProjection
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (j : ℤ) :
    conj (complexPhaseProjection n points u j) =
      ∑ r : Fin m,
        (conj (phasePositionCoeff u r) * complexWave n (-points r) j +
          conj (phaseVelocityCoeff u r) *
            weightedComplexWave n (-points r) j) := by
  unfold complexPhaseProjection
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro r _
  simp only [map_add, map_mul, conj_complexWave, conj_weightedComplexWave]

lemma realComplexPhaseProjection_mode_expansion
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (j : ℤ) :
    realComplexPhaseProjection n points u j =
      (complexModeSum n points (phasePositionCoeff u) (phaseVelocityCoeff u) j +
        complexModeSum n (fun r ↦ -points r)
          (fun r ↦ conj (phasePositionCoeff u r))
          (fun r ↦ conj (phaseVelocityCoeff u r)) j) / 2 := by
  unfold realComplexPhaseProjection
  rw [conj_complexPhaseProjection]
  rfl

/-- The doubled frequency index used to regard a real trigonometric
polynomial as a complex exponential polynomial.  `true` is the original
mode and `false` is its reflected conjugate mode. -/
abbrev ReflectedMode (m : ℕ) := Fin m × Bool

def reflectedModeTime (points : Fin m → ℝ) (a : ReflectedMode m) : ℝ :=
  if a.2 then points a.1 else -points a.1

/-- Simultaneous Dirichlet approximation of all original and reflected
frequencies.  At the returned nonzero integer step every exponential mode
lies in the explicit `2π/Q` chord around `1`. -/
lemma exists_reflectedMode_dirichletStep
    (n m Q : ℕ) (hn : 0 < n) (hQ : 0 < Q)
    (points : Fin m → ℝ) :
    ∃ h : ℕ, 1 ≤ h ∧ h ≤ Q ^ (2 * m) ∧
      ∀ a : ReflectedMode m,
        ‖complexWave n (reflectedModeTime points a) (h : ℤ) - 1‖ <
          2 * Real.pi / Q := by
  let alpha : ReflectedMode m → ℝ := fun a ↦
    reflectedModeTime points a / (2 * Real.pi * n)
  rcases simultaneousDirichlet_distance alpha Q hQ with
    ⟨h, hh1, hhQ, happrox⟩
  refine ⟨h, hh1, ?_, ?_⟩
  · simpa [Fintype.card_prod, Fintype.card_fin, Fintype.card_bool,
      Nat.mul_comm] using hhQ
  · intro a
    rw [complexWave_eq_circleExp n hn]
    have harg :
        (h : ℝ) * reflectedModeTime points a / (2 * Real.pi * n) =
          (h : ℝ) * alpha a := by
      simp only [alpha]
      ring
    simp only [Int.cast_natCast]
    rw [harg]
    calc
      ‖circleExp ((h : ℝ) * alpha a) - 1‖ ≤
          2 * Real.pi * distanceToInteger ((h : ℝ) * alpha a) :=
        norm_circleExp_sub_one_le_two_pi_mul_distanceToInteger _
      _ < 2 * Real.pi * ((1 : ℝ) / Q) :=
        mul_lt_mul_of_pos_left (happrox a) (by positivity)
      _ = 2 * Real.pi / Q := by ring

/-- Dirichlet approximation followed by the smoothness propagation step.
All reflected modes remain close to one at the selected multiple, while the
chosen target mode has a definite nonzero chord. -/
lemma exists_reflectedDirichletStep_with_targetGap
    (n m Q L : ℕ) (hn : 0 < n) (hQ : 0 < Q)
    (points : Fin m → ℝ) (target : ReflectedMode m)
    (K ε : ℝ)
    (hsmooth : IsSmooth n K (reflectedModeTime points target))
    (hQK : Q ^ (2 * m) ≤ Nat.floor K + 1)
    (hL : 800 ≤ L) (hε0 : 0 ≤ ε) (hεsmall : ε < 1 / 16)
    (hscale : 4000 * ε / L ≤ K / n) :
    ∃ q₀ : ℕ,
      1 ≤ q₀ ∧ q₀ ≤ L * Q ^ (2 * m) ∧
      ε < ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ∧
      ∀ a : ReflectedMode m,
        ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤
          (L : ℝ) * (2 * Real.pi / Q) := by
  rcases exists_reflectedMode_dirichletStep n m Q hn hQ points with
    ⟨q, hq1, hqQ, hdir⟩
  rcases hsmooth.exists_large_multipleWave hn hq1 (hqQ.trans hQK)
      L hL ε hε0 hεsmall hscale with ⟨r, hr, htarget⟩
  refine ⟨r * q, ?_, ?_, htarget, ?_⟩
  · have hr1 : 1 ≤ r := (Finset.mem_Ico.mp hr).1
    exact Nat.mul_pos hr1 hq1
  · have hrL : r ≤ L := (Finset.mem_Ico.mp hr).2.le
    exact Nat.mul_le_mul hrL hqQ
  · intro a
    have hmultiple := norm_complexWave_nat_mul_sub_one_le
      n (reflectedModeTime points a) q r
    have hbase : ‖complexWave n (reflectedModeTime points a) (q : ℤ) - 1‖ ≤
        2 * Real.pi / Q := (hdir a).le
    have hrLreal : (r : ℝ) ≤ L := by
      exact_mod_cast (Finset.mem_Ico.mp hr).2.le
    have hfactor : 0 ≤ 2 * Real.pi / (Q : ℝ) := by positivity
    calc
      ‖complexWave n (reflectedModeTime points a) ((r * q : ℕ) : ℤ) - 1‖ ≤
          (r : ℝ) *
            ‖complexWave n (reflectedModeTime points a) (q : ℤ) - 1‖ :=
        hmultiple
      _ ≤ (r : ℝ) * (2 * Real.pi / Q) :=
        mul_le_mul_of_nonneg_left hbase (Nat.cast_nonneg r)
      _ ≤ (L : ℝ) * (2 * Real.pi / Q) :=
        mul_le_mul_of_nonneg_right hrLreal hfactor

noncomputable def reflectedPositionCoeff (u : PhaseCoordinate m)
    (a : ReflectedMode m) : ℂ :=
  if a.2 then phasePositionCoeff u a.1 / 2
  else conj (phasePositionCoeff u a.1) / 2

noncomputable def reflectedVelocityCoeff (u : PhaseCoordinate m)
    (a : ReflectedMode m) : ℂ :=
  if a.2 then phaseVelocityCoeff u a.1 / 2
  else conj (phaseVelocityCoeff u a.1) / 2

lemma sum_norm_reflectedCoeffs_eq (u : PhaseCoordinate m) :
    ∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) =
      ∑ r : Fin m,
        (‖phasePositionCoeff u r‖ + ‖phaseVelocityCoeff u r‖) := by
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro r _
  simp [reflectedPositionCoeff, reflectedVelocityCoeff, norm_div]
  ring

lemma sum_norm_reflectedCoeffs_le_l1 (u : PhaseCoordinate m) :
    ∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖) ≤
      ∑ r : Fin m, ∑ c : Fin 4, |u r c| := by
  rw [sum_norm_reflectedCoeffs_eq]
  exact sum_norm_phaseCoeffs_le_l1 u

/-- The realified phase projection is exactly one affine exponential sum
over the original and reflected modes. -/
lemma realComplexPhaseProjection_eq_reflectedModeSum
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) (j : ℤ) :
    realComplexPhaseProjection n points u j =
      complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) j := by
  rw [realComplexPhaseProjection_mode_expansion]
  unfold complexModeSum reflectedModeTime reflectedPositionCoeff
    reflectedVelocityCoeff
  rw [Fintype.sum_prod_type]
  simp_rw [Fintype.sum_bool]
  simp only [if_true, Bool.false_eq_true, if_false]
  simp_rw [Finset.sum_add_distrib]
  simp_rw [div_mul_eq_mul_div]
  simp_rw [add_div, Finset.sum_div]

lemma realComplexPhaseProjection_centeredIndex_eq_affineModeSum
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (j : Fin (2 * n + 1)) :
    realComplexPhaseProjection n points u (centeredIndex n j) =
      centeredAffineModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) j := by
  rw [realComplexPhaseProjection_eq_reflectedModeSum]
  unfold complexModeSum centeredAffineModeSum centeredAffineMode weightedComplexWave
  apply Finset.sum_congr rfl
  intro a _
  simp only [centeredIndex, centeredFrequency, Int.cast_sub, Int.cast_natCast]
  push_cast
  ring

lemma norm_iteratedDoubleTwist_realComplexPhaseProjection_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (twists : List ℂ)
    (η : ℝ) (hη : 0 ≤ η)
    (hunit : ∀ ζ ∈ twists, ‖ζ‖ = 1)
    (hgap : ∀ a : ReflectedMode m, ∀ ζ ∈ twists,
      ‖complexWave n (reflectedModeTime points a) h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists
        (realComplexPhaseProjection n points u) j‖ ≤
      ∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ * η ^ (2 * twists.length) +
          (twists.length : ℝ) * (4 : ℝ) ^ twists.length *
            ‖reflectedVelocityCoeff u a‖ * |(h : ℝ)| / n +
          ‖reflectedVelocityCoeff u a‖ * η ^ (2 * twists.length) *
            |(j : ℝ)| / n) := by
  have heq : realComplexPhaseProjection n points u =
      complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
    funext q
    exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
  rw [heq]
  exact norm_iteratedDoubleTwist_complexModeSum_le_general
    n hn (reflectedModeTime points) (reflectedPositionCoeff u)
      (reflectedVelocityCoeff u) h j twists η hη hunit hgap

lemma norm_iteratedDoubleTwist_realComplexPhaseProjection_le_pow_gap
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (twists : List ℂ)
    (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ a : ReflectedMode m, ∀ ζ ∈ twists,
      ‖complexWave n (reflectedModeTime points a) h - ζ‖ ≤ η) :
    ‖iteratedDoubleTwist h twists
        (realComplexPhaseProjection n points u) j‖ ≤
      ∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ * η ^ (2 * twists.length) +
          (2 * (twists.length : ℝ) * ‖reflectedVelocityCoeff u a‖ *
            |(h : ℝ)| / n * η ^ (2 * twists.length - 1)) +
          ‖reflectedVelocityCoeff u a‖ * η ^ (2 * twists.length) *
            |(j : ℝ)| / n) := by
  have heq : realComplexPhaseProjection n points u =
      complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
    funext q
    exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
  rw [heq]
  exact norm_iteratedDoubleTwist_complexModeSum_le_pow_gap
    n hn (reflectedModeTime points) (reflectedPositionCoeff u)
      (reflectedVelocityCoeff u) h j twists η hη hgap

/-- Ordinary fixed-step double differences with the sharp velocity
correction retained. -/
lemma abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le_pow_gap
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) h - 1‖ ≤ η) :
    |iteratedForwardDifference h (2 * k)
        (fun q ↦ (realComplexPhaseProjection n points u q).re) j| ≤
      ∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ * η ^ (2 * k) +
          (2 * (k : ℝ) * ‖reflectedVelocityCoeff u a‖ *
            |(h : ℝ)| / n * η ^ (2 * k - 1)) +
          ‖reflectedVelocityCoeff u a‖ * η ^ (2 * k) *
            |(j : ℝ)| / n) := by
  rw [← iteratedDoubleTwist_replicate_one_re]
  exact (Complex.abs_re_le_norm _).trans (by
    simpa using norm_iteratedDoubleTwist_realComplexPhaseProjection_le_pow_gap
      n hn points u h j (List.replicate k 1) η hη
      (by
        intro a ζ hζ
        simp only [List.mem_replicate] at hζ
        rcases hζ with ⟨_hk, rfl⟩
        exact hgap a))

/-- `ℓ¹` form of the sharp fixed-step estimate on the central index window. -/
lemma abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le_l1_pow_gap
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hj : |(j : ℝ)| ≤ n)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) h - 1‖ ≤ η) :
    |iteratedForwardDifference h (2 * k)
        (fun q ↦ (realComplexPhaseProjection n points u q).re) j| ≤
      (∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          2 * (k : ℝ) * |(h : ℝ)| / n * η ^ (2 * k - 1)) := by
  let E : ℝ := η ^ (2 * k)
  let D : ℝ := 2 * (k : ℝ) * |(h : ℝ)| / n * η ^ (2 * k - 1)
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hE : 0 ≤ E := by dsimp [E]; positivity
  have hD : 0 ≤ D := by dsimp [D]; positivity
  have hterm : ∀ a : ReflectedMode m,
      ‖reflectedPositionCoeff u a‖ * E +
          (2 * (k : ℝ) * ‖reflectedVelocityCoeff u a‖ *
            |(h : ℝ)| / n * η ^ (2 * k - 1)) +
          ‖reflectedVelocityCoeff u a‖ * E * |(j : ℝ)| / n ≤
        (‖reflectedPositionCoeff u a‖ +
          ‖reflectedVelocityCoeff u a‖) * (E + D) := by
    intro a
    let A : ℝ := ‖reflectedPositionCoeff u a‖
    let B : ℝ := ‖reflectedVelocityCoeff u a‖
    have hA : 0 ≤ A := norm_nonneg _
    have hB : 0 ≤ B := norm_nonneg _
    have hlast : B * E * |(j : ℝ)| / (n : ℝ) ≤ B * E := by
      calc
        B * E * |(j : ℝ)| / (n : ℝ) ≤
            B * E * (n : ℝ) / (n : ℝ) := by
          exact div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_left hj (mul_nonneg hB hE)) hnreal.le
        _ = B * E := by field_simp
    have hmiddle :
        2 * (k : ℝ) * B * |(h : ℝ)| / (n : ℝ) *
            η ^ (2 * k - 1) = B * D := by
      dsimp [D]
      ring
    dsimp [A, B] at hA hB ⊢
    rw [hmiddle]
    calc
      ‖reflectedPositionCoeff u a‖ * E +
            ‖reflectedVelocityCoeff u a‖ * D +
            ‖reflectedVelocityCoeff u a‖ * E * |(j : ℝ)| / (n : ℝ) ≤
          ‖reflectedPositionCoeff u a‖ * E +
            ‖reflectedVelocityCoeff u a‖ * D +
            ‖reflectedVelocityCoeff u a‖ * E := by gcongr
      _ ≤ (‖reflectedPositionCoeff u a‖ +
            ‖reflectedVelocityCoeff u a‖) * (E + D) := by
        nlinarith
  calc
    |iteratedForwardDifference h (2 * k)
        (fun q ↦ (realComplexPhaseProjection n points u q).re) j| ≤
        ∑ a : ReflectedMode m,
          (‖reflectedPositionCoeff u a‖ * E +
            (2 * (k : ℝ) * ‖reflectedVelocityCoeff u a‖ *
              |(h : ℝ)| / n * η ^ (2 * k - 1)) +
            ‖reflectedVelocityCoeff u a‖ * E * |(j : ℝ)| / n) := by
      simpa [E] using
        abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le_pow_gap
          n hn points u h j k η hη hgap
    _ ≤ ∑ a : ReflectedMode m,
        ((‖reflectedPositionCoeff u a‖ +
          ‖reflectedVelocityCoeff u a‖) * (E + D)) := by
      exact Finset.sum_le_sum fun a _ ↦ hterm a
    _ = (∑ a : ReflectedMode m,
          (‖reflectedPositionCoeff u a‖ +
            ‖reflectedVelocityCoeff u a‖)) * (E + D) := by
      rw [Finset.sum_mul]
    _ ≤ (∑ r : Fin m, ∑ c : Fin 4, |u r c|) * (E + D) :=
      mul_le_mul_of_nonneg_right (sum_norm_reflectedCoeffs_le_l1 u)
        (add_nonneg hE hD)
    _ = (∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          2 * (k : ℝ) * |(h : ℝ)| / n * η ^ (2 * k - 1)) := by rfl

lemma abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) h - 1‖ ≤ η) :
    |iteratedForwardDifference h (2 * k)
        (fun q ↦ (realComplexPhaseProjection n points u q).re) j| ≤
      ∑ a : ReflectedMode m,
        (‖reflectedPositionCoeff u a‖ * η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u a‖ * |(h : ℝ)| / n +
          ‖reflectedVelocityCoeff u a‖ * η ^ (2 * k) *
            |(j : ℝ)| / n) := by
  rw [← iteratedDoubleTwist_replicate_one_re]
  exact (Complex.abs_re_le_norm _).trans (by
    simpa using norm_iteratedDoubleTwist_realComplexPhaseProjection_le
      n hn points u h j (List.replicate k 1) η hη
      (by
        intro ζ hζ
        simp only [List.mem_replicate] at hζ
        rcases hζ with ⟨_hk, rfl⟩
        simp)
      (by
        intro a ζ hζ
        simp only [List.mem_replicate] at hζ
        rcases hζ with ⟨_hk, rfl⟩
        exact hgap a))

/-- A convenient `ℓ¹` form of the ordinary-difference estimate on the
central index window.  The bound is homogeneous in the Fourier coordinate
and will be compared with the centered lattice representatives. -/
lemma abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le_l1
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hj : |(j : ℝ)| ≤ n)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) h - 1‖ ≤ η) :
    |iteratedForwardDifference h (2 * k)
        (fun q ↦ (realComplexPhaseProjection n points u q).re) j| ≤
      (∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k * |(h : ℝ)| / n) := by
  let E : ℝ := η ^ (2 * k)
  let D : ℝ := (k : ℝ) * (4 : ℝ) ^ k * |(h : ℝ)| / n
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have hE : 0 ≤ E := by dsimp [E]; positivity
  have hD : 0 ≤ D := by dsimp [D]; positivity
  have hterm : ∀ a : ReflectedMode m,
      ‖reflectedPositionCoeff u a‖ * E +
          (k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u a‖ * |(h : ℝ)| / n +
          ‖reflectedVelocityCoeff u a‖ * E * |(j : ℝ)| / n ≤
        (‖reflectedPositionCoeff u a‖ +
          ‖reflectedVelocityCoeff u a‖) * (E + D) := by
    intro a
    let A : ℝ := ‖reflectedPositionCoeff u a‖
    let B : ℝ := ‖reflectedVelocityCoeff u a‖
    have hA : 0 ≤ A := norm_nonneg _
    have hB : 0 ≤ B := norm_nonneg _
    have hlast : B * E * |(j : ℝ)| / (n : ℝ) ≤ B * E := by
      calc
        B * E * |(j : ℝ)| / (n : ℝ) ≤
            B * E * (n : ℝ) / (n : ℝ) := by
          exact div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_left hj (mul_nonneg hB hE)) hnreal.le
        _ = B * E := by field_simp
    have hmiddle :
        (k : ℝ) * (4 : ℝ) ^ k * B * |(h : ℝ)| / (n : ℝ) = B * D := by
      dsimp [D]
      ring
    dsimp [A, B] at hA hB ⊢
    rw [hmiddle]
    calc
      ‖reflectedPositionCoeff u a‖ * E +
            ‖reflectedVelocityCoeff u a‖ * D +
            ‖reflectedVelocityCoeff u a‖ * E * |(j : ℝ)| / (n : ℝ) ≤
          ‖reflectedPositionCoeff u a‖ * E +
            ‖reflectedVelocityCoeff u a‖ * D +
            ‖reflectedVelocityCoeff u a‖ * E := by gcongr
      _ ≤ (‖reflectedPositionCoeff u a‖ +
            ‖reflectedVelocityCoeff u a‖) * (E + D) := by
        nlinarith
  calc
    |iteratedForwardDifference h (2 * k)
        (fun q ↦ (realComplexPhaseProjection n points u q).re) j| ≤
        ∑ a : ReflectedMode m,
          (‖reflectedPositionCoeff u a‖ * E +
            (k : ℝ) * (4 : ℝ) ^ k *
              ‖reflectedVelocityCoeff u a‖ * |(h : ℝ)| / n +
            ‖reflectedVelocityCoeff u a‖ * E * |(j : ℝ)| / n) := by
      simpa [E] using
        abs_iteratedOrdinaryDoubleDifference_realPhaseProjection_le
          n hn points u h j k η hη hgap
    _ ≤ ∑ a : ReflectedMode m,
        ((‖reflectedPositionCoeff u a‖ +
          ‖reflectedVelocityCoeff u a‖) * (E + D)) := by
      exact Finset.sum_le_sum fun a _ ↦ hterm a
    _ = (∑ a : ReflectedMode m,
          (‖reflectedPositionCoeff u a‖ +
            ‖reflectedVelocityCoeff u a‖)) * (E + D) := by
      rw [Finset.sum_mul]
    _ ≤ (∑ r : Fin m, ∑ c : Fin 4, |u r c|) * (E + D) :=
      mul_le_mul_of_nonneg_right (sum_norm_reflectedCoeffs_le_l1 u)
        (add_nonneg hE hD)
    _ = (∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k * |(h : ℝ)| / n) := by rfl

/-- All reflected twists except the one indexed by `a`. -/
noncomputable def reflectedTwists (n : ℕ) (points : Fin m → ℝ)
    (a : ReflectedMode m) : List ℂ :=
  ((Finset.univ.erase a).toList.map
    (fun b ↦ complexWave n (reflectedModeTime points b) 1))

lemma reflectedTwists_length (n : ℕ) (points : Fin m → ℝ)
    (a : ReflectedMode m) :
    (reflectedTwists n points a).length = 2 * m - 1 := by
  simp [reflectedTwists, Finset.length_toList, Fintype.card_prod,
    Fintype.card_fin, Fintype.card_bool, Nat.mul_comm]

lemma reflectedTwists_unit (n : ℕ) (points : Fin m → ℝ)
    (a : ReflectedMode m) :
    ∀ ζ ∈ reflectedTwists n points a, ‖ζ‖ = 1 := by
  intro ζ hζ
  rcases List.mem_map.mp hζ with ⟨b, _hb, rfl⟩
  exact norm_complexWave _ _ _

lemma reflectedTwists_contains_other (n : ℕ) (points : Fin m → ℝ)
    (a b : ReflectedMode m) (hba : b ≠ a) :
    complexWave n (reflectedModeTime points b) 1 ∈
      reflectedTwists n points a := by
  unfold reflectedTwists
  apply List.mem_map.mpr
  refine ⟨b, ?_, rfl⟩
  simp [hba]

/-- Smoothness separates a mode from its own reflection, while spreadness
separates modes belonging to distinct sample points.  This single lemma
packages all four sign choices. -/
lemma reflectedMode_separation
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hK : 0 ≤ K) (hlam : 0 ≤ lam)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (a b : ReflectedMode m) (hab : a ≠ b) :
    4 * min (K / n) (lam / n) ≤
      ‖complexWave n (reflectedModeTime points a) 1 -
        complexWave n (reflectedModeTime points b) 1‖ := by
  rcases a with ⟨r, ar⟩
  rcases b with ⟨s, bs⟩
  cases ar <;> cases bs
  · change 4 * min (K / n) (lam / n) ≤
      ‖complexWave n (-points r) 1 - complexWave n (-points s) 1‖
    have hrs : r ≠ s := by
      intro hrs
      subst s
      exact hab rfl
    have hsep := hspread.norm_complexWave_sub_lower n hn lam points r s hrs
    have hconj :
        ‖complexWave n (-points r) 1 - complexWave n (-points s) 1‖ =
          ‖complexWave n (points r) 1 - complexWave n (points s) 1‖ := by
      rw [← Complex.norm_conj]
      simp only [map_sub, conj_complexWave, neg_neg]
    rw [hconj]
    exact (mul_le_mul_of_nonneg_left (min_le_right _ _) (by norm_num)).trans hsep
  · change 4 * min (K / n) (lam / n) ≤
      ‖complexWave n (-points r) 1 - complexWave n (points s) 1‖
    by_cases hrs : r = s
    · subst s
      have hsep := (hsmooth r).norm_complexWave_reflection_lower hn
      rw [norm_sub_rev]
      exact (mul_le_mul_of_nonneg_left (min_le_left _ _) (by norm_num)).trans
        hsep.le
    · have hsep := hspread.norm_complexWave_reflection_sub_lower
        n hn lam points s r (Ne.symm hrs)
      rw [norm_sub_rev]
      exact (mul_le_mul_of_nonneg_left (min_le_right _ _) (by norm_num)).trans hsep
  · change 4 * min (K / n) (lam / n) ≤
      ‖complexWave n (points r) 1 - complexWave n (-points s) 1‖
    by_cases hrs : r = s
    · subst s
      exact (mul_le_mul_of_nonneg_left (min_le_left _ _) (by norm_num)).trans
        ((hsmooth r).norm_complexWave_reflection_lower hn).le
    · exact (mul_le_mul_of_nonneg_left (min_le_right _ _) (by norm_num)).trans
        (hspread.norm_complexWave_reflection_sub_lower n hn lam points r s hrs)
  · change 4 * min (K / n) (lam / n) ≤
      ‖complexWave n (points r) 1 - complexWave n (points s) 1‖
    have hrs : r ≠ s := by
      intro hrs
      subst s
      exact hab rfl
    exact (mul_le_mul_of_nonneg_left (min_le_right _ _) (by norm_num)).trans
      (hspread.norm_complexWave_sub_lower n hn lam points r s hrs)

lemma reflectedTwists_gap
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hK : 0 ≤ K) (hlam : 0 ≤ lam)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points) (a : ReflectedMode m) :
    ∀ ζ ∈ reflectedTwists n points a,
      4 * min (K / n) (lam / n) ≤
        ‖complexWave n (reflectedModeTime points a) 1 - ζ‖ := by
  intro ζ hζ
  rcases List.mem_map.mp hζ with ⟨b, hb, rfl⟩
  apply reflectedMode_separation n hn K lam points hK hlam hsmooth hspread
  exact Ne.symm (by simpa [reflectedTwists] using hb)

/-- Reflected spectral twists at an arbitrary integer dilation step. -/
noncomputable def reflectedTwistsAt (n : ℕ) (points : Fin m → ℝ)
    (h : ℤ) (a : ReflectedMode m) : List ℂ :=
  ((Finset.univ.erase a).toList.map
    (fun b ↦ complexWave n (reflectedModeTime points b) h))

lemma reflectedTwistsAt_length (n : ℕ) (points : Fin m → ℝ)
    (h : ℤ) (a : ReflectedMode m) :
    (reflectedTwistsAt n points h a).length = 2 * m - 1 := by
  simp [reflectedTwistsAt, Finset.length_toList, Fintype.card_prod,
    Fintype.card_fin, Fintype.card_bool, Nat.mul_comm]

lemma reflectedTwistsAt_unit (n : ℕ) (points : Fin m → ℝ)
    (h : ℤ) (a : ReflectedMode m) :
    ∀ ζ ∈ reflectedTwistsAt n points h a, ‖ζ‖ = 1 := by
  intro ζ hζ
  rcases List.mem_map.mp hζ with ⟨b, _hb, rfl⟩
  exact norm_complexWave _ _ _

lemma reflectedTwistsAt_contains_other (n : ℕ) (points : Fin m → ℝ)
    (h : ℤ) (a b : ReflectedMode m) (hba : b ≠ a) :
    complexWave n (reflectedModeTime points b) h ∈
      reflectedTwistsAt n points h a := by
  unfold reflectedTwistsAt
  apply List.mem_map.mpr
  refine ⟨b, ?_, rfl⟩
  simp [hba]

/-- Uniform separation of every pair of original/reflected modes at one
integer dilation step. -/
def ReflectedSeparatedAt (n : ℕ) (points : Fin m → ℝ)
    (h : ℤ) (δ : ℝ) : Prop :=
  ∀ a b : ReflectedMode m, a ≠ b →
    δ ≤ ‖complexWave n (reflectedModeTime points a) h -
      complexWave n (reflectedModeTime points b) h‖

lemma reflectedSeparatedAt_of_distance
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ) (h : ℤ) (rho : ℝ)
    (hdist : ∀ a b : ReflectedMode m, a ≠ b →
      rho ≤ distanceToInteger
        ((h : ℝ) *
          (reflectedModeTime points a - reflectedModeTime points b) /
            (2 * Real.pi * n))) :
    ReflectedSeparatedAt n points h (4 * rho) := by
  intro a b hab
  calc
    4 * rho ≤ 4 * distanceToInteger
        ((h : ℝ) *
          (reflectedModeTime points a - reflectedModeTime points b) /
            (2 * Real.pi * n)) :=
      mul_le_mul_of_nonneg_left (hdist a b hab) (by norm_num)
    _ ≤ ‖complexWave n (reflectedModeTime points a) h -
          complexWave n (reflectedModeTime points b) h‖ := by
      simpa using four_mul_distance_le_norm_complexWave_sub n hn
        (reflectedModeTime points b) (reflectedModeTime points a) h

lemma reflectedTwistsAt_gap
    (n : ℕ) (points : Fin m → ℝ) (h : ℤ) (δ : ℝ)
    (hsep : ReflectedSeparatedAt n points h δ) (a : ReflectedMode m) :
    ∀ ζ ∈ reflectedTwistsAt n points h a,
      δ ≤ ‖complexWave n (reflectedModeTime points a) h - ζ‖ := by
  intro ζ hζ
  rcases List.mem_map.mp hζ with ⟨b, hb, rfl⟩
  apply hsep a b
  exact Ne.symm (by simpa [reflectedTwistsAt] using hb)

/-- Reflected twists in which every unwanted mode is assigned its own
integer dilation step. -/
noncomputable def variableReflectedTwists
    (n : ℕ) (points : Fin m → ℝ) (step : ReflectedMode m → ℕ)
    (a : ReflectedMode m) : List VariableTwist :=
  ((Finset.univ.erase a).toList.map fun b ↦
    (step b, complexWave n (reflectedModeTime points b) (step b : ℤ)))

lemma variableReflectedTwists_length
    (n : ℕ) (points : Fin m → ℝ) (step : ReflectedMode m → ℕ)
    (a : ReflectedMode m) :
    (variableReflectedTwists n points step a).length = 2 * m - 1 := by
  simp [variableReflectedTwists, Finset.length_toList, Fintype.card_prod,
    Fintype.card_fin, Fintype.card_bool, Nat.mul_comm]

lemma variableReflectedTwists_unit
    (n : ℕ) (points : Fin m → ℝ) (step : ReflectedMode m → ℕ)
    (a : ReflectedMode m) :
    ∀ hζ ∈ variableReflectedTwists n points step a, ‖hζ.2‖ = 1 := by
  intro hζ hhζ
  rcases List.mem_map.mp hhζ with ⟨b, _hb, rfl⟩
  exact norm_complexWave _ _ _

lemma variableReflectedTwists_contains_other
    (n : ℕ) (points : Fin m → ℝ) (step : ReflectedMode m → ℕ)
    (a b : ReflectedMode m) (hba : b ≠ a) :
    (step b, complexWave n (reflectedModeTime points b) (step b : ℤ)) ∈
      variableReflectedTwists n points step a := by
  unfold variableReflectedTwists
  apply List.mem_map.mpr
  refine ⟨b, ?_, rfl⟩
  simp [hba]

/-- After ordinary high differencing, the variable reflected twists still
isolate exactly one transported affine mode.  The proof is purely algebraic:
the two constant-coefficient difference products commute. -/
lemma iteratedVariableTwist_ordinaryRealPhase_eq_single
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (q₀ : ℕ) (k : ℕ) (step : ReflectedMode m → ℕ)
    (target : ReflectedMode m) :
    iteratedVariableDoubleTwist
        (variableReflectedTwists n points step target)
        (iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)) =
      iteratedVariableDoubleTwist
        (variableReflectedTwists n points step target)
        (fun j ↦
          affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
              (reflectedPositionCoeff u target)
              (reflectedVelocityCoeff u target) (List.replicate k 1) *
            complexWave n (reflectedModeTime points target) j +
          (reflectedVelocityCoeff u target *
              modeSeparationProduct n (reflectedModeTime points target)
                (q₀ : ℤ) (List.replicate k 1)) *
            weightedComplexWave n (reflectedModeTime points target) j) := by
  let twists := variableReflectedTwists n points step target
  let f := realComplexPhaseProjection n points u
  let targetMode : ℤ → ℂ := fun j ↦
    reflectedPositionCoeff u target *
        complexWave n (reflectedModeTime points target) j +
      reflectedVelocityCoeff u target *
        weightedComplexWave n (reflectedModeTime points target) j
  have hf : f = complexModeSum n (reflectedModeTime points)
      (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
    funext j
    exact realComplexPhaseProjection_eq_reflectedModeSum n points u j
  have hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists targetMode := by
    rw [hf]
    exact iteratedVariableDoubleTwist_complexModeSum_eq_single
      n (reflectedModeTime points) (reflectedPositionCoeff u)
      (reflectedVelocityCoeff u) twists target
      (by
        intro b hbt
        exact ⟨step b,
          variableReflectedTwists_contains_other
            n points step target b hbt⟩)
  calc
    iteratedVariableDoubleTwist twists
        (iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1) f) =
        iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
          (iteratedVariableDoubleTwist twists f) :=
      iteratedVariableDoubleTwist_iteratedDoubleTwist_comm
        twists (q₀ : ℤ) (List.replicate k 1) f
    _ = iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
          (iteratedVariableDoubleTwist twists targetMode) := by rw [hisolate]
    _ = iteratedVariableDoubleTwist twists
          (iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1) targetMode) :=
      (iteratedVariableDoubleTwist_iteratedDoubleTwist_comm
        twists (q₀ : ℤ) (List.replicate k 1) targetMode).symm
    _ = iteratedVariableDoubleTwist twists
        (fun j ↦
          affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
              (reflectedPositionCoeff u target)
              (reflectedVelocityCoeff u target) (List.replicate k 1) *
            complexWave n (reflectedModeTime points target) j +
          (reflectedVelocityCoeff u target *
              modeSeparationProduct n (reflectedModeTime points target)
                (q₀ : ℤ) (List.replicate k 1)) *
            weightedComplexWave n (reflectedModeTime points target) j) := by
      apply congrArg (iteratedVariableDoubleTwist twists)
      exact iteratedDoubleTwist_affineMode_eq_after
        n (reflectedModeTime points target) (q₀ : ℤ)
          (reflectedPositionCoeff u target)
          (reflectedVelocityCoeff u target) (List.replicate k 1)

/-- Velocity extraction after the ordinary Dirichlet difference and the
variable-step reflected-mode isolation. -/
lemma ordinaryReflectedVelocityCoeff_mul_gap_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (q₀ k : ℕ)
    (step : ReflectedMode m → ℕ) (target : ReflectedMode m)
    (δ M : ℝ) (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hsep : ∀ b : ReflectedMode m, b ≠ target →
      δ ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (j : ℤ)
    (hwindow0 : ∀ q : ℕ,
      q ≤ variableTwistSpan
        (variableReflectedTwists n points step target) →
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
        (realComplexPhaseProjection n points u) (j + q)‖ ≤ M)
    (hwindow1 : ∀ q : ℕ,
      q ≤ variableTwistSpan
        (variableReflectedTwists n points step target) →
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
