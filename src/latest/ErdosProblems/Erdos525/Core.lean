        (scaledRealPhaseProjection n points u t
          (((s + v : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (r : Fin m)
    (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ∀ b : ReflectedMode m, b ≠ (r, true) →
      δ ≤ ‖complexWave n (reflectedModeTime points (r, true)) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (H : ℕ) (hH : 0 < H) (J : ℝ) (hJ : 0 ≤ J)
    (hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H)
    (hfit : 2 * H + variableTwistSpan
        (variableReflectedTwists n points step (r, true)) +
          2 * k * (ell + 1) * q₀ ≤ W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              2 * (k : ℝ) * (q₀ : ℝ) / n * η ^ (2 * k - 1))) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (Amin ε : ℝ) (hAmin : 0 ≤ Amin) (hε : 0 ≤ ε)
    (hlarge : Amin ≤ ‖reflectedPositionCoeff u (r, true)‖)
    (htarget : ε ≤
      ‖complexWave n (reflectedModeTime points (r, true))
          ((ell * q₀ : ℕ) : ℤ) - 1‖)
    (hcorr :
      2 * (4 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        (‖reflectedVelocityCoeff u (r, true)‖ *
          ‖complexWave n (reflectedModeTime points (r, true))
              ((ell * q₀ : ℕ) : ℤ) - 1‖ ^ (2 * k)) *
        (variableStepSum
          (variableReflectedTwists n points step (r, true)) : ℝ) / n +
      ((k : ℝ) * (4 : ℝ) ^ k *
          ‖reflectedVelocityCoeff u (r, true)‖ * ((ell * q₀ : ℕ) : ℝ) / n) *
        δ ^ (2 *
          (variableReflectedTwists n points step (r, true)).length) ≤
      (Amin * ε ^ (2 * k) *
        δ ^ (2 *
          (variableReflectedTwists n points step (r, true)).length)) / 2) :
    (H : ℝ) *
        ((Amin * ε ^ (2 * k) *
          δ ^ (2 *
            (variableReflectedTwists n points step (r, true)).length)) / 2) ^ 2 ≤
      (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) := by
  apply goodBlock_largePosition_forces_latticeEnergy_multiple_of_isolation
    n hn points u t ht q₀ ell k η hη hdirichlet s W hs a ha hgood
      step r δ hδ hsep H hH J hJ hj hfit
  · exact goodBlock_variableAffinePosition_l2_bound_multiple_pow_gap
      n hn points u t ht q₀ ell k η hη hdirichlet s W hs a ha hgood
        step (r, true) H hH J hJ hj hfit hsmall
  · exact hAmin
  · exact hε
  · exact hlarge
  · exact htarget
  · exact hcorr

/-- The high-difference energy on a good residue block still detects the
velocity of every isolated reflected mode.  Unlike the pointwise extraction
lemma, this estimate gains the full cubic affine factor `H³/n²`. -/
lemma goodBlock_reflectedVelocity_l2_bound
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hdirichlet : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (target : ReflectedMode m)
    (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ∀ b : ReflectedMode m, b ≠ target →
      δ ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (H : ℕ) (hH : 0 < H)
    (hfit : 2 * H + variableTwistSpan
        (variableReflectedTwists n points step target) + 2 * k * q₀ ≤ W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    (H : ℝ) *
        (((H : ℝ) *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k) *
            δ ^ (2 *
              (variableReflectedTwists n points step target).length)) / n) ^ 2) ≤
      2 * (36 : ℝ) ^
          (variableReflectedTwists n points step target).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) := by
  let twists := variableReflectedTwists n points step target
  let f : ℤ → ℂ := iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
    (realComplexPhaseProjection n points u)
  let j : ℤ := (s : ℤ) - (n : ℤ)
  let A : ℂ := affinePositionAfter n (reflectedModeTime points target)
    (q₀ : ℤ) (reflectedPositionCoeff u target)
      (reflectedVelocityCoeff u target) (List.replicate k 1)
  let B : ℂ := reflectedVelocityCoeff u target *
    modeSeparationProduct n (reflectedModeTime points target)
      (q₀ : ℤ) (List.replicate k 1)
  have hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n (reflectedModeTime points target) q +
          B * weightedComplexWave n (reflectedModeTime points target) q) := by
    simpa [twists, f, A, B] using
      iteratedVariableTwist_ordinaryRealPhase_eq_single
        n points u q₀ k step target
  have hl2 := mul_sq_velocity_gap_div_le_isolation_energy
    n hn (reflectedModeTime points target) A B twists f j H δ hδ
      (by simpa [twists] using
        variableReflectedTwists_unit n points step target)
      (by simpa [twists] using
        variableReflectedTwists_gap n points step target δ hsep)
      hisolate
  have hordinaryFit : 2 * k * q₀ < W := by omega
  have houtputLen : 2 * H + variableTwistSpan twists ≤
      W - 2 * k * q₀ := by
    dsimp [twists]
    omega
  have hsubset :
      ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2 ≤
        ∑ r ∈ Finset.range (W - 2 * k * q₀), ‖f (j + r)‖ ^ 2 := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.range_mono houtputLen)
    intro r _hr _hmem
    exact sq_nonneg _
  have hordinary0 := sum_sq_iteratedOrdinaryRealPhase_goodBlock_le
    n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood
      hordinaryFit hsmall
  have hordinary :
      ∑ r ∈ Finset.range (W - 2 * k * q₀), ‖f (j + r)‖ ^ 2 ≤
        (Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t := by
    convert hordinary0 using 1 <;>
      simp [f, j] <;> push_cast <;> ring
  have hsum := hsubset.trans hordinary
  have hfac : 0 ≤ 2 * (36 : ℝ) ^ twists.length := by positivity
  have hupper := mul_le_mul_of_nonneg_left hsum hfac
  have hl2' := hl2.trans hupper
  simpa [twists, B, norm_mul,
    norm_modeSeparationProduct_replicate_one, mul_assoc] using hl2'

/-- Position analogue of `goodBlock_reflectedVelocity_l2_bound`.  The
isolated transported position is controlled by the same lattice energy once
the block length is comparable with the distance of its start from zero. -/
lemma goodBlock_variableAffinePosition_l2_bound
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hdirichlet : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (target : ReflectedMode m)
    (H : ℕ) (hH : 0 < H) (J : ℝ) (hJ : 0 ≤ J)
    (hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H)
    (hfit : 2 * H + variableTwistSpan
        (variableReflectedTwists n points step target) + 2 * k * q₀ ≤ W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    (H : ℝ) *
        ‖variableAffinePositionAfter n (reflectedModeTime points target)
          (affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
            (reflectedPositionCoeff u target)
            (reflectedVelocityCoeff u target) (List.replicate k 1))
          (reflectedVelocityCoeff u target *
            modeSeparationProduct n (reflectedModeTime points target)
              (q₀ : ℤ) (List.replicate k 1))
          (variableReflectedTwists n points step target)‖ ^ 2 ≤
      (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
          (variableReflectedTwists n points step target).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) := by
  let twists := variableReflectedTwists n points step target
  let f : ℤ → ℂ := iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
    (realComplexPhaseProjection n points u)
  let j : ℤ := (s : ℤ) - (n : ℤ)
  let A : ℂ := affinePositionAfter n (reflectedModeTime points target)
    (q₀ : ℤ) (reflectedPositionCoeff u target)
      (reflectedVelocityCoeff u target) (List.replicate k 1)
  let B : ℂ := reflectedVelocityCoeff u target *
    modeSeparationProduct n (reflectedModeTime points target)
      (q₀ : ℤ) (List.replicate k 1)
  have hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ A * complexWave n (reflectedModeTime points target) q +
          B * weightedComplexWave n (reflectedModeTime points target) q) := by
    simpa [twists, f, A, B] using
      iteratedVariableTwist_ordinaryRealPhase_eq_single
        n points u q₀ k step target
  have hl2 := mul_sq_variableAffinePosition_le_isolation_energy
    n hn (reflectedModeTime points target) A B twists f j H hH J hJ
      (by simpa [j] using hj)
      (by simpa [twists] using
        variableReflectedTwists_unit n points step target)
      hisolate
  have hordinaryFit : 2 * k * q₀ < W := by omega
  have houtputLen : 2 * H + variableTwistSpan twists ≤
      W - 2 * k * q₀ := by
    dsimp [twists]
    omega
  have hsubset :
      ∑ r ∈ Finset.range (2 * H + variableTwistSpan twists),
          ‖f (j + r)‖ ^ 2 ≤
        ∑ r ∈ Finset.range (W - 2 * k * q₀), ‖f (j + r)‖ ^ 2 := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.range_mono houtputLen)
    intro r _hr _hmem
    exact sq_nonneg _
  have hordinary0 := sum_sq_iteratedOrdinaryRealPhase_goodBlock_le
    n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood
      hordinaryFit hsmall
  have hordinary :
      ∑ r ∈ Finset.range (W - 2 * k * q₀), ‖f (j + r)‖ ^ 2 ≤
        (Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t := by
    convert hordinary0 using 1 <;>
      simp [f, j] <;> push_cast <;> ring
  have hsum := hsubset.trans hordinary
  have hfac : 0 ≤ (2 + 4 * (J + 1) ^ 2) *
      (36 : ℝ) ^ twists.length := by positivity
  have hupper := mul_le_mul_of_nonneg_left hsum hfac
  exact hl2.trans (by
    simpa [twists, A, B, mul_assoc] using hupper)

/-- Coefficient-normalized form of the preceding estimate.  If the target
velocity carries squared mass at least `R` and its ordinary Dirichlet chord
is at least `ε`, then the lattice energy must pay the displayed amount. -/
lemma goodBlock_largeVelocity_forces_latticeEnergy
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hdirichlet : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ v : ℕ, v < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + v : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (r : Fin m)
    (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ∀ b : ReflectedMode m, b ≠ (r, true) →
      δ ≤ ‖complexWave n (reflectedModeTime points (r, true)) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (H : ℕ) (hH : 0 < H)
    (hfit : 2 * H + variableTwistSpan
        (variableReflectedTwists n points step (r, true)) + 2 * k * q₀ ≤ W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (R ε : ℝ) (hR : 0 ≤ R) (hε : 0 ≤ ε)
    (hlarge : R ≤ Complex.normSq (phaseVelocityCoeff u r))
    (htarget : ε ≤
      ‖complexWave n (reflectedModeTime points (r, true)) (q₀ : ℤ) - 1‖) :
    (H : ℝ) * ((H : ℝ) / n) ^ 2 *
        ((R / 4) * (ε ^ (2 * k)) ^ 2 *
          (δ ^ (2 *
            (variableReflectedTwists n points step (r, true)).length)) ^ 2) ≤
      2 * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) := by
  let target : ReflectedMode m := (r, true)
  let b : ℝ := ‖reflectedVelocityCoeff u target‖
  let c : ℝ := ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖
  let d : ℝ := δ ^ (2 *
    (variableReflectedTwists n points step target).length)
  have hb : R / 4 ≤ b ^ 2 := by
    have hdiv := div_le_div_of_nonneg_right hlarge (by norm_num : (0 : ℝ) ≤ 4)
    simpa [b, target] using
      hdiv.trans_eq (norm_reflectedVelocityCoeff_true_sq u r).symm
  have hc0 : 0 ≤ c := norm_nonneg _
  have hck : ε ^ (2 * k) ≤ c ^ (2 * k) :=
    pow_le_pow_left₀ hε (by simpa [c, target] using htarget) _
  have hd0 : 0 ≤ d := by dsimp [d]; positivity
  have hproduct :
      (R / 4) * (ε ^ (2 * k)) ^ 2 * d ^ 2 ≤
        (b * c ^ (2 * k) * d) ^ 2 := by
    calc
      (R / 4) * (ε ^ (2 * k)) ^ 2 * d ^ 2 ≤
          b ^ 2 * (ε ^ (2 * k)) ^ 2 * d ^ 2 := by gcongr
      _ ≤ b ^ 2 * (c ^ (2 * k)) ^ 2 * d ^ 2 := by
        have hsquare := pow_le_pow_left₀ (pow_nonneg hε _)
          hck 2
        gcongr
      _ = (b * c ^ (2 * k) * d) ^ 2 := by ring
  have hscale0 : 0 ≤ (H : ℝ) * ((H : ℝ) / n) ^ 2 := by positivity
  have hlower := mul_le_mul_of_nonneg_left hproduct hscale0
  have hl2 := goodBlock_reflectedVelocity_l2_bound
    n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood
      step target δ hδ (by simpa [target] using hsep) H hH
      (by simpa [target] using hfit) hsmall
  have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
  have heq :
      (H : ℝ) * ((H : ℝ) / n) ^ 2 *
          (b * c ^ (2 * k) * d) ^ 2 =
        (H : ℝ) *
          (((H : ℝ) * (b * c ^ (2 * k) * d) / n) ^ 2) := by
    field_simp
  rw [heq] at hlower
  exact hlower.trans (by simpa [target, b, c, d, mul_assoc] using hl2)

/-- Large-position counterpart.  Once the two explicit triangular velocity
corrections use at most half of the transported position signal, the isolated
affine-position `ℓ²` estimate forces a quantitative lattice-energy lower
bound. -/
lemma goodBlock_largePosition_forces_latticeEnergy
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hdirichlet : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ v : ℕ, v < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + v : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (r : Fin m)
    (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ∀ b : ReflectedMode m, b ≠ (r, true) →
      δ ≤ ‖complexWave n (reflectedModeTime points (r, true)) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (H : ℕ) (hH : 0 < H) (J : ℝ) (hJ : 0 ≤ J)
    (hj : |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| ≤ J * H)
    (hfit : 2 * H + variableTwistSpan
        (variableReflectedTwists n points step (r, true)) + 2 * k * q₀ ≤ W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1)
    (Amin ε : ℝ) (hAmin : 0 ≤ Amin) (hε : 0 ≤ ε)
    (hlarge : Amin ≤ ‖reflectedPositionCoeff u (r, true)‖)
    (htarget : ε ≤
      ‖complexWave n (reflectedModeTime points (r, true)) (q₀ : ℤ) - 1‖)
    (hcorr :
      2 * (4 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        (‖reflectedVelocityCoeff u (r, true)‖ *
          ‖complexWave n (reflectedModeTime points (r, true)) (q₀ : ℤ) - 1‖ ^
            (2 * k)) *
        (variableStepSum
          (variableReflectedTwists n points step (r, true)) : ℝ) / n +
      ((k : ℝ) * (4 : ℝ) ^ k *
          ‖reflectedVelocityCoeff u (r, true)‖ * (q₀ : ℝ) / n) *
        δ ^ (2 *
          (variableReflectedTwists n points step (r, true)).length) ≤
      (Amin * ε ^ (2 * k) *
        δ ^ (2 *
          (variableReflectedTwists n points step (r, true)).length)) / 2) :
    (H : ℝ) *
        ((Amin * ε ^ (2 * k) *
          δ ^ (2 *
            (variableReflectedTwists n points step (r, true)).length)) / 2) ^ 2 ≤
      (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^
          (variableReflectedTwists n points step (r, true)).length *
        ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
          phaseLatticeEnergy n points u t) := by
  let target : ReflectedMode m := (r, true)
  let D : ℝ := δ ^ (2 *
    (variableReflectedTwists n points step target).length)
  let X : ℂ := variableAffinePositionAfter n
    (reflectedModeTime points target)
    (affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
      (reflectedPositionCoeff u target)
      (reflectedVelocityCoeff u target) (List.replicate k 1))
    (reflectedVelocityCoeff u target *
      modeSeparationProduct n (reflectedModeTime points target)
        (q₀ : ℤ) (List.replicate k 1))
    (variableReflectedTwists n points step target)
  let Corr : ℝ :=
    2 * (4 : ℝ) ^
        (variableReflectedTwists n points step target).length *
      (‖reflectedVelocityCoeff u target‖ *
        ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
          (2 * k)) *
      (variableStepSum
        (variableReflectedTwists n points step target) : ℝ) / n +
    ((k : ℝ) * (4 : ℝ) ^ k *
        ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) * D
  have hD : 0 ≤ D := by dsimp [D]; positivity
  have hsignal : 0 ≤ Amin * ε ^ (2 * k) * D := by positivity
  have hsignalLower : Amin * ε ^ (2 * k) * D ≤
      ‖reflectedPositionCoeff u target‖ *
        ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
          (2 * k) * D := by
    have hchord := pow_le_pow_left₀ hε
      (by simpa [target] using htarget) (2 * k)
    gcongr
  have htransfer := reflectedPosition_product_le_variableAffinePosition_add
    n hn points u q₀ k step target δ hδ
      (by simpa [target] using hsep)
  have hsum : Amin * ε ^ (2 * k) * D ≤ ‖X‖ + Corr := by
    exact hsignalLower.trans (by
      simpa [target, D, X, Corr, add_assoc] using htransfer)
  have hcorr' : Corr ≤ (Amin * ε ^ (2 * k) * D) / 2 := by
    simpa [target, D, Corr] using hcorr
  have hXlower : (Amin * ε ^ (2 * k) * D) / 2 ≤ ‖X‖ := by
    linarith
  have hsq := pow_le_pow_left₀ (by positivity :
      0 ≤ (Amin * ε ^ (2 * k) * D) / 2) hXlower 2
  have hH0 : 0 ≤ (H : ℝ) := Nat.cast_nonneg H
  have hlower := mul_le_mul_of_nonneg_left hsq hH0
  have hl2 := goodBlock_variableAffinePosition_l2_bound
    n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood
      step target H hH J hJ (by simpa [target] using hj)
      (by simpa [target] using hfit) hsmall
  exact hlower.trans (by simpa [target, D, X] using hl2)

noncomputable def ordinaryGoodBlockBound (t a : ℝ) (k : ℕ) : ℝ :=
  Real.pi / |t| * ((2 : ℝ) ^ (2 * k) * a)

/-- A good residue block supplies both transported coefficient estimates at
one target reflected mode. -/
lemma goodBlock_reflectedCoefficient_bounds
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hdirichlet : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (target : ReflectedMode m)
    (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ∀ b : ReflectedMode m, b ≠ target →
      δ ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (hspan : variableTwistSpan
        (variableReflectedTwists n points step target) + 1 +
          2 * k * q₀ < W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    (‖reflectedVelocityCoeff u target‖ *
          ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
            (2 * k) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) / n ≤
        2 * ((4 : ℝ) ^
          (variableReflectedTwists n points step target).length *
            ordinaryGoodBlockBound t a k)) ∧
      (‖affinePositionAfter n (reflectedModeTime points target) (q₀ : ℤ)
            (reflectedPositionCoeff u target)
            (reflectedVelocityCoeff u target) (List.replicate k 1)‖ *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) ≤
        (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
              ordinaryGoodBlockBound t a k +
          (4 : ℝ) ^
              (variableReflectedTwists n points step target).length *
            ‖reflectedVelocityCoeff u target *
              modeSeparationProduct n (reflectedModeTime points target)
                (q₀ : ℤ) (List.replicate k 1)‖ *
              |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| / n +
          2 * (4 : ℝ) ^
              (variableReflectedTwists n points step target).length *
            ‖reflectedVelocityCoeff u target *
              modeSeparationProduct n (reflectedModeTime points target)
                (q₀ : ℤ) (List.replicate k 1)‖ *
            (variableStepSum
              (variableReflectedTwists n points step target) : ℝ) / n) := by
  let twists := variableReflectedTwists n points step target
  let j : ℤ := (s : ℤ) - (n : ℤ)
  let M : ℝ := ordinaryGoodBlockBound t a k
  have hM : 0 ≤ M := by
    dsimp [M, ordinaryGoodBlockBound]
    positivity
  have hwindow : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
        (realComplexPhaseProjection n points u) (j + q)‖ ≤ M := by
    intro q hq
    change q ≤ variableTwistSpan
      (variableReflectedTwists n points step target) at hq
    have hv : q + 2 * k * q₀ < W := by omega
    have hb := norm_iteratedOrdinaryRealPhase_le_on_goodBlock
      n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood q hv hsmall
    convert hb using 1 <;> simp [j, M, ordinaryGoodBlockBound] <;> push_cast <;> ring
  have hwindow1 : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
        (realComplexPhaseProjection n points u) ((j + 1) + q)‖ ≤ M := by
    intro q hq
    change q ≤ variableTwistSpan
      (variableReflectedTwists n points step target) at hq
    have hv : (1 + q) + 2 * k * q₀ < W := by omega
    have hb := norm_iteratedOrdinaryRealPhase_le_on_goodBlock
      n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood (1 + q) hv hsmall
    convert hb using 1 <;> simp [j, M, ordinaryGoodBlockBound] <;> push_cast <;> ring
  constructor
  · exact reflectedVelocityCoeff_mul_dirichletGap_le
      n hn points u q₀ k step target δ M hδ hM hsep j hwindow hwindow1
  · simpa [twists, j, M] using
      ordinaryReflectedPositionAfter_mul_gap_le_at
        n hn points u q₀ k step target δ M hδ hM hsep j hwindow

/-- A good residue block controls the original reflected position
coefficient, rather than only the position transported through the ordinary
Dirichlet differences.  This is the form used when the starting point of the
good block is allowed to vary in the lattice-avoidance argument. -/
lemma goodBlock_reflectedPositionCoeff_bound
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hdirichlet : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (step : ReflectedMode m → ℕ) (target : ReflectedMode m)
    (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ∀ b : ReflectedMode m, b ≠ target →
      δ ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (hspan : variableTwistSpan
        (variableReflectedTwists n points step target) +
          2 * k * q₀ < W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    ‖reflectedPositionCoeff u target‖ *
          ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
            (2 * k) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) ≤
      (4 : ℝ) ^
          (variableReflectedTwists n points step target).length *
            ordinaryGoodBlockBound t a k +
        (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
            |((((s : ℕ) : ℤ) - (n : ℤ)) : ℝ)| / n +
        2 * (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
          (variableStepSum
            (variableReflectedTwists n points step target) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) := by
  let twists := variableReflectedTwists n points step target
  let j : ℤ := (s : ℤ) - (n : ℤ)
  let M : ℝ := ordinaryGoodBlockBound t a k
  have hM : 0 ≤ M := by
    dsimp [M, ordinaryGoodBlockBound]
    positivity
  have hwindow : ∀ q : ℕ, q ≤ variableTwistSpan twists →
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
        (realComplexPhaseProjection n points u) (j + q)‖ ≤ M := by
    intro q hq
    change q ≤ variableTwistSpan
      (variableReflectedTwists n points step target) at hq
    have hv : q + 2 * k * q₀ < W := by omega
    have hb := norm_iteratedOrdinaryRealPhase_le_on_goodBlock
      n hn points u t ht q₀ k η hη hdirichlet s W hs a ha hgood q hv hsmall
    convert hb using 1 <;>
      simp [j, M, ordinaryGoodBlockBound] <;> push_cast <;> ring
  simpa [twists, j, M] using
    reflectedPositionCoeff_mul_dirichletGap_le_at
      n hn points u q₀ k step target δ M hδ hM hsep j hwindow

lemma phaseProjection_sq_eq_normSq_realComplexPhaseProjection
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (j : Fin (2 * n + 1)) :
    (phaseProjection n points u j) ^ 2 =
      Complex.normSq
        (realComplexPhaseProjection n points u (centeredIndex n j)) := by
  rw [← ofReal_phaseProjection_eq_realComplexPhaseProjection]
  simp [Complex.normSq_apply, pow_two]

lemma phaseProjection_energy_eq_reflectedCross
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m) :
    ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 =
      ∑ a : ReflectedMode m, ∑ b : ReflectedMode m,
        (centeredAffineCrossMoment n
          (reflectedModeTime points b) (reflectedModeTime points a)
          (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
          (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re := by
  calc
    ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 =
        ∑ j : Fin (2 * n + 1), Complex.normSq
          (realComplexPhaseProjection n points u (centeredIndex n j)) := by
      apply Finset.sum_congr rfl
      intro j _
      exact phaseProjection_sq_eq_normSq_realComplexPhaseProjection n points u j
    _ = ∑ j : Fin (2 * n + 1), Complex.normSq
          (centeredAffineModeSum n (reflectedModeTime points)
            (reflectedPositionCoeff u) (reflectedVelocityCoeff u) j) := by
      apply Finset.sum_congr rfl
      intro j _
      rw [realComplexPhaseProjection_centeredIndex_eq_affineModeSum]
    _ = _ := sum_normSq_centeredAffineModeSum_eq n
      (reflectedModeTime points) (reflectedPositionCoeff u)
      (reflectedVelocityCoeff u)

lemma phaseProjection_energy_lower_of_smooth_spread
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (rho : ℝ) (hrho : rho = min (K / n) (lam / n)) (hrhoPos : 0 < rho)
    (u : PhaseCoordinate m) :
    (((2 * n + 1 : ℝ) / 6) - (6 / (4 * rho)) * (4 * m : ℝ) ^ 2) *
        phaseNormSq u ≤
      ∑ j : Fin (2 * n + 1), (phaseProjection n points u j) ^ 2 := by
  let f : ReflectedMode m → ReflectedMode m → ℝ := fun a b ↦
    (centeredAffineCrossMoment n
      (reflectedModeTime points b) (reflectedModeTime points a)
      (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
      (reflectedPositionCoeff u b) (reflectedVelocityCoeff u b)).re
  let w : ReflectedMode m → ℝ := fun a ↦
    ‖reflectedPositionCoeff u a‖ + ‖reflectedVelocityCoeff u a‖
  let M : ℝ := 6 / (4 * rho)
  have hM : 0 ≤ M := by dsimp [M]; positivity
  have hw : ∀ a, 0 ≤ w a := fun a ↦ by dsimp [w]; positivity
  have hcross : ∀ a b, a ≠ b → -M * w a * w b ≤ f a b := by
    intro a b hab
    simpa [M, w, f] using reflectedAffineCross_re_lower_of_smooth_spread
      n hn K lam points hsmooth hspread rho hrho hrhoPos u a b hab
  have hdouble := diag_sub_square_le_sum_double f w M hM hw hcross
  have hdiag : ((2 * n + 1 : ℝ) / 6) * phaseNormSq u ≤
      ∑ a : ReflectedMode m, f a a := by
    simpa [f] using reflectedAffineDiagonal_lower n hn points u
  have hwsq : (∑ a : ReflectedMode m, w a) ^ 2 ≤
      (4 * m : ℝ) ^ 2 * phaseNormSq u := by
    simpa [w] using sum_reflectedCoeffWeight_sq_le u
  have hscaled : M * (∑ a : ReflectedMode m, w a) ^ 2 ≤
      M * ((4 * m : ℝ) ^ 2 * phaseNormSq u) :=
    mul_le_mul_of_nonneg_left hwsq hM
  have hmain :
      ((2 * n + 1 : ℝ) / 6) * phaseNormSq u -
          M * ((4 * m : ℝ) ^ 2 * phaseNormSq u) ≤
        (∑ a : ReflectedMode m, f a a) -
          M * (∑ a : ReflectedMode m, w a) ^ 2 :=
    sub_le_sub hdiag hscaled
  rw [phaseProjection_energy_eq_reflectedCross]
  change ((((2 * n + 1 : ℝ) / 6) - M * (4 * m : ℝ) ^ 2) *
      phaseNormSq u) ≤ ∑ a : ReflectedMode m, ∑ b : ReflectedMode m, f a b
  calc
    ((((2 * n + 1 : ℝ) / 6) - M * (4 * m : ℝ) ^ 2) *
        phaseNormSq u) =
      ((2 * n + 1 : ℝ) / 6) * phaseNormSq u -
        M * ((4 * m : ℝ) ^ 2 * phaseNormSq u) := by ring
    _ ≤ (∑ a : ReflectedMode m, f a a) -
        M * (∑ a : ReflectedMode m, w a) ^ 2 := hmain
    _ ≤ ∑ a : ReflectedMode m, ∑ b : ReflectedMode m, f a b := hdouble

lemma phaseProjection_sq_le_energy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (j : Fin (2 * n + 1)) :
    (phaseProjection n points u j) ^ 2 ≤
      ∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2 := by
  apply Finset.single_le_sum (fun k _ ↦ sq_nonneg (phaseProjection n points u k))
  simp

/-- Every value of the realified projection is bounded by the square root
of its total discrete energy. -/
lemma norm_realComplexPhaseProjection_le_sqrt_energy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (j : Fin (2 * n + 1)) :
    ‖realComplexPhaseProjection n points u (centeredIndex n j)‖ ≤
      Real.sqrt
        (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2) := by
  let E : ℝ := ∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2
  have hE : 0 ≤ E := Finset.sum_nonneg fun k _ ↦ sq_nonneg _
  have hsquare :
      ‖realComplexPhaseProjection n points u (centeredIndex n j)‖ ^ 2 ≤ E := by
    rw [Complex.sq_norm, ← phaseProjection_sq_eq_normSq_realComplexPhaseProjection]
    exact phaseProjection_sq_le_energy n points u j
  have hsqrt := Real.sq_sqrt hE
  nlinarith [norm_nonneg
    (realComplexPhaseProjection n points u (centeredIndex n j)),
    Real.sqrt_nonneg E]

/-- The same bound with the centered integer index written explicitly from
the left endpoint `-n`. -/
lemma norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (q : ℕ) (hq : q ≤ 2 * n) :
    ‖realComplexPhaseProjection n points u ((q : ℤ) - n)‖ ≤
      Real.sqrt
        (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2) := by
  let jq : Fin (2 * n + 1) := ⟨q, by omega⟩
  have hidx : centeredIndex n jq = (q : ℤ) - n := by
    simp [centeredIndex, jq]
  rw [← hidx]
  exact norm_realComplexPhaseProjection_le_sqrt_energy n points u jq

lemma norm_realComplexPhaseProjection_rightIndex_le_sqrt_energy
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (q : ℕ) (hq : q ≤ n) :
    ‖realComplexPhaseProjection n points u q‖ ≤
      Real.sqrt
        (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2) := by
  let jq : Fin (2 * n + 1) := ⟨n + q, by omega⟩
  have hidx : centeredIndex n jq = (q : ℤ) := by
    simp [centeredIndex, jq]
  rw [← hidx]
  exact norm_realComplexPhaseProjection_le_sqrt_energy n points u jq

/-- Reflected velocity extraction with a separately chosen dilation for
every unwanted mode. -/
lemma reflectedVelocityCoeff_energy_bound_variable
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (step : ReflectedMode m → ℕ) (δ : ℝ) (hδ : 0 ≤ δ)
    (a : ReflectedMode m)
    (hsep : ∀ b : ReflectedMode m, b ≠ a →
      δ ≤ ‖complexWave n (reflectedModeTime points a) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (hfit : variableTwistSpan
        (variableReflectedTwists n points step a) + 1 ≤ 2 * n)
    (u : PhaseCoordinate m) :
    ‖reflectedVelocityCoeff u a‖ *
          δ ^ (2 * (variableReflectedTwists n points step a).length) / n ≤
      2 * ((4 : ℝ) ^ (variableReflectedTwists n points step a).length *
        Real.sqrt
          (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)) := by
  let twists := variableReflectedTwists n points step a
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let M : ℝ := Real.sqrt
    (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)
  have hM : 0 ≤ M := Real.sqrt_nonneg _
  have hfit' : variableTwistSpan twists + 1 ≤ 2 * n := by
    simpa [twists] using hfit
  have hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ reflectedPositionCoeff u a *
            complexWave n (reflectedModeTime points a) q +
          reflectedVelocityCoeff u a *
            weightedComplexWave n (reflectedModeTime points a) q) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext q
      exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
    rw [hf]
    apply iteratedVariableDoubleTwist_complexModeSum_eq_single
    intro b hba
    exact ⟨step b, by simpa [twists] using
      variableReflectedTwists_contains_other n points step a b hba⟩
  apply variableVelocityCoeff_mul_gap_pow_div_le_of_isolation
    n hn (reflectedModeTime points a) (-n : ℤ)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    twists f δ M hδ hM
    (by simpa [twists] using variableReflectedTwists_unit n points step a)
    (by simpa [twists] using
      variableReflectedTwists_gap n points step a δ hsep)
    hisolate
  · intro q hq
    have hq' : q ≤ 2 * n := by omega
    have hbound := norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
      n points u q hq'
    convert hbound using 1 <;> simp [f, M] <;> push_cast <;> ring
  · intro q hq
    have hq' : q + 1 ≤ 2 * n := by omega
    have hbound := norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
      n points u (q + 1) hq'
    convert hbound using 1 <;> simp [f, M] <;> push_cast <;> ring

/-- Reflected position extraction with separately chosen dilation steps. -/
lemma reflectedPositionCoeff_energy_bound_variable
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (step : ReflectedMode m → ℕ) (δ : ℝ) (hδ : 0 ≤ δ)
    (a : ReflectedMode m)
    (hsep : ∀ b : ReflectedMode m, b ≠ a →
      δ ≤ ‖complexWave n (reflectedModeTime points a) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (hfit : variableTwistSpan
        (variableReflectedTwists n points step a) ≤ n)
    (u : PhaseCoordinate m) :
    ‖reflectedPositionCoeff u a‖ *
          δ ^ (2 * (variableReflectedTwists n points step a).length) ≤
      (4 : ℝ) ^ (variableReflectedTwists n points step a).length *
          Real.sqrt
            (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2) +
        2 * (4 : ℝ) ^ (variableReflectedTwists n points step a).length *
          ‖reflectedVelocityCoeff u a‖ *
            (variableStepSum
              (variableReflectedTwists n points step a) : ℝ) / n := by
  let twists := variableReflectedTwists n points step a
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let M : ℝ := Real.sqrt
    (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)
  have hM : 0 ≤ M := Real.sqrt_nonneg _
  have hfit' : variableTwistSpan twists ≤ n := by
    simpa [twists] using hfit
  have hisolate : iteratedVariableDoubleTwist twists f =
      iteratedVariableDoubleTwist twists
        (fun q ↦ reflectedPositionCoeff u a *
            complexWave n (reflectedModeTime points a) q +
          reflectedVelocityCoeff u a *
            weightedComplexWave n (reflectedModeTime points a) q) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext q
      exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
    rw [hf]
    apply iteratedVariableDoubleTwist_complexModeSum_eq_single
    intro b hba
    exact ⟨step b, by simpa [twists] using
      variableReflectedTwists_contains_other n points step a b hba⟩
  apply variablePositionCoeff_mul_gap_pow_le_of_isolation
    n hn (reflectedModeTime points a)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    twists f δ M hδ hM
    (by simpa [twists] using variableReflectedTwists_unit n points step a)
    (by simpa [twists] using
      variableReflectedTwists_gap n points step a δ hsep)
    hisolate
  intro q hq
  have hq' : q ≤ n := by omega
  have hbound := norm_realComplexPhaseProjection_rightIndex_le_sqrt_energy
    n points u q hq'
  simpa [f, M] using hbound

/-- Velocity-coefficient extraction at a dilated integer step.  The explicit
fit condition keeps every repeated-difference sample inside `[-n,n]`. -/
lemma reflectedVelocityCoeff_energy_bound_at
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (h : ℕ) (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ReflectedSeparatedAt n points h δ)
    (hfit : 2 * (2 * m - 1) * h + 1 ≤ 2 * n)
    (u : PhaseCoordinate m) (a : ReflectedMode m) :
    ‖reflectedVelocityCoeff u a‖ *
          δ ^ (2 * (reflectedTwistsAt n points h a).length) / n ≤
      2 * ((4 : ℝ) ^ (reflectedTwistsAt n points h a).length *
        Real.sqrt
          (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)) := by
  let twists := reflectedTwistsAt n points h a
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let M : ℝ := Real.sqrt
    (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)
  have hM : 0 ≤ M := Real.sqrt_nonneg _
  have hisolate : iteratedDoubleTwist (h : ℤ) twists f =
      iteratedDoubleTwist (h : ℤ) twists
        (fun q ↦ reflectedPositionCoeff u a *
            complexWave n (reflectedModeTime points a) q +
          reflectedVelocityCoeff u a *
            weightedComplexWave n (reflectedModeTime points a) q) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext q
      exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
    rw [hf]
    apply iteratedDoubleTwist_complexModeSum_eq_single
    intro b hba
    exact reflectedTwistsAt_contains_other n points h a b hba
  apply velocityCoeff_mul_gap_pow_div_le_of_isolation
    n hn (reflectedModeTime points a) (h : ℤ) (-n : ℤ)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    twists f δ M hδ hM
    (by simpa [twists] using reflectedTwistsAt_unit n points h a)
    (by simpa [twists] using reflectedTwistsAt_gap n points h δ hsep a)
    hisolate
  · intro q hq
    have hq' : q * h ≤ 2 * n := by
      have hlen : twists.length = 2 * m - 1 := by
        simpa [twists] using reflectedTwistsAt_length n points h a
      have hqh := Nat.mul_le_mul_right h hq
      rw [hlen] at hqh
      omega
    have hbound := norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
      n points u (q * h) hq'
    convert hbound using 1 <;> simp [f, M] <;> push_cast <;> ring
  · intro q hq
    have hq' : q * h + 1 ≤ 2 * n := by
      have hlen : twists.length = 2 * m - 1 := by
        simpa [twists] using reflectedTwistsAt_length n points h a
      have hqh := Nat.mul_le_mul_right h hq
      rw [hlen] at hqh
      omega
    have hbound := norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
      n points u (q * h + 1) hq'
    convert hbound using 1 <;> simp [f, M] <;> push_cast <;> ring

/-- Position-coefficient extraction at a dilated integer step. -/
lemma reflectedPositionCoeff_energy_bound_at
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (h : ℕ) (δ : ℝ) (hδ : 0 ≤ δ)
    (hsep : ReflectedSeparatedAt n points h δ)
    (hfit : 2 * (2 * m - 1) * h ≤ n)
    (u : PhaseCoordinate m) (a : ReflectedMode m) :
    ‖reflectedPositionCoeff u a‖ *
          δ ^ (2 * (reflectedTwistsAt n points h a).length) ≤
      (4 : ℝ) ^ (reflectedTwistsAt n points h a).length *
          Real.sqrt
            (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2) +
        ((reflectedTwistsAt n points h a).length : ℝ) *
            (4 : ℝ) ^ (reflectedTwistsAt n points h a).length *
              ‖reflectedVelocityCoeff u a‖ * (h : ℝ) / n := by
  let twists := reflectedTwistsAt n points h a
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let M : ℝ := Real.sqrt
    (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)
  have hM : 0 ≤ M := Real.sqrt_nonneg _
  have hisolate : iteratedDoubleTwist (h : ℤ) twists f =
      iteratedDoubleTwist (h : ℤ) twists
        (fun q ↦ reflectedPositionCoeff u a *
            complexWave n (reflectedModeTime points a) q +
          reflectedVelocityCoeff u a *
            weightedComplexWave n (reflectedModeTime points a) q) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext q
      exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
    rw [hf]
    apply iteratedDoubleTwist_complexModeSum_eq_single
    intro b hba
    exact reflectedTwistsAt_contains_other n points h a b hba
  have hbound := positionCoeff_mul_gap_pow_le_of_isolation_general
    n hn (reflectedModeTime points a) (h : ℤ)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    twists f δ M hδ hM
    (by simpa [twists] using reflectedTwistsAt_unit n points h a)
    (by simpa [twists] using reflectedTwistsAt_gap n points h δ hsep a)
    hisolate
    (by
      intro q hq
      have hq' : q * h ≤ n := by
        have hlen : twists.length = 2 * m - 1 := by
          simpa [twists] using reflectedTwistsAt_length n points h a
        have hqh := Nat.mul_le_mul_right h hq
        rw [hlen] at hqh
        omega
      have hv := norm_realComplexPhaseProjection_rightIndex_le_sqrt_energy
        n points u (q * h) hq'
      convert hv using 1 <;> simp [f, M] <;> push_cast <;> ring)
  have hhreal : (0 : ℝ) ≤ (h : ℝ) := Nat.cast_nonneg h
  simpa [twists, abs_of_nonneg hhreal] using hbound

/-- Quantitative extraction of any reflected velocity coefficient from the
total phase-projection energy.  The length hypothesis guarantees that every
window value used by the repeated differences remains among the centered
frequencies `-n,...,n`. -/
lemma reflectedVelocityCoeff_energy_bound
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hK : 0 ≤ K) (hlam : 0 ≤ lam)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hsize : 4 * m ≤ 2 * n) (u : PhaseCoordinate m)
    (a : ReflectedMode m) :
    ‖reflectedVelocityCoeff u a‖ *
          (4 * min (K / n) (lam / n)) ^
            (2 * (reflectedTwists n points a).length) / n ≤
      2 * ((4 : ℝ) ^ (reflectedTwists n points a).length *
        Real.sqrt
          (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)) := by
  let twists := reflectedTwists n points a
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let M : ℝ := Real.sqrt
    (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)
  have hdelta : 0 ≤ 4 * min (K / n) (lam / n) := by
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    positivity
  have hM : 0 ≤ M := Real.sqrt_nonneg _
  have hisolate : iteratedDoubleTwist 1 twists f =
      iteratedDoubleTwist 1 twists
        (fun q ↦ reflectedPositionCoeff u a *
            complexWave n (reflectedModeTime points a) q +
          reflectedVelocityCoeff u a *
            weightedComplexWave n (reflectedModeTime points a) q) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext q
      exact (realComplexPhaseProjection_eq_reflectedModeSum n points u q)
    rw [hf]
    apply iteratedDoubleTwist_complexModeSum_eq_single
    intro b hba
    exact reflectedTwists_contains_other n points a b hba
  apply velocityCoeff_mul_gap_pow_div_le_of_isolation
    n hn (reflectedModeTime points a) 1 (-n : ℤ)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    twists f (4 * min (K / n) (lam / n)) M hdelta hM
    (by simpa [twists] using reflectedTwists_unit n points a)
    (by simpa [twists] using
      reflectedTwists_gap n hn K lam points hK hlam hsmooth hspread a)
    hisolate
  · intro q hq
    have hq' : q ≤ 2 * n := by
      have hlen : twists.length = 2 * m - 1 := by
        simpa [twists] using reflectedTwists_length n points a
      rw [hlen] at hq
      omega
    have hbound := norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
      n points u q hq'
    convert hbound using 1 <;> simp [f, M] <;> ring
  · intro q hq
    have hq' : q + 1 ≤ 2 * n := by
      have hlen : twists.length = 2 * m - 1 := by
        simpa [twists] using reflectedTwists_length n points a
      rw [hlen] at hq
      omega
    have hbound := norm_realComplexPhaseProjection_leftIndex_le_sqrt_energy
      n points u (q + 1) hq'
    convert hbound using 1 <;> simp [f, M] <;> ring

/-- Companion estimate for a reflected position coefficient.  The second
term is controlled by the already-extracted velocity coefficient. -/
lemma reflectedPositionCoeff_energy_bound
    (n : ℕ) (hn : 0 < n) (K lam : ℝ) (points : Fin m → ℝ)
    (hK : 0 ≤ K) (hlam : 0 ≤ lam)
    (hsmooth : ∀ r, IsSmooth n K (points r))
    (hspread : IsSpread n lam points)
    (hsize : 4 * m ≤ n) (u : PhaseCoordinate m)
    (a : ReflectedMode m) :
    ‖reflectedPositionCoeff u a‖ *
          (4 * min (K / n) (lam / n)) ^
            (2 * (reflectedTwists n points a).length) ≤
      (4 : ℝ) ^ (reflectedTwists n points a).length *
          Real.sqrt
            (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2) +
        ((reflectedTwists n points a).length : ℝ) *
            (4 : ℝ) ^ (reflectedTwists n points a).length *
              ‖reflectedVelocityCoeff u a‖ / n := by
  let twists := reflectedTwists n points a
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  let M : ℝ := Real.sqrt
    (∑ k : Fin (2 * n + 1), (phaseProjection n points u k) ^ 2)
  have hdelta : 0 ≤ 4 * min (K / n) (lam / n) := by
    have hnreal : (0 : ℝ) < n := by exact_mod_cast hn
    positivity
  have hM : 0 ≤ M := Real.sqrt_nonneg _
  have hisolate : iteratedDoubleTwist 1 twists f =
      iteratedDoubleTwist 1 twists
        (fun q ↦ reflectedPositionCoeff u a *
            complexWave n (reflectedModeTime points a) q +
          reflectedVelocityCoeff u a *
            weightedComplexWave n (reflectedModeTime points a) q) := by
    have hf : f = complexModeSum n (reflectedModeTime points)
        (reflectedPositionCoeff u) (reflectedVelocityCoeff u) := by
      funext q
      exact realComplexPhaseProjection_eq_reflectedModeSum n points u q
    rw [hf]
    apply iteratedDoubleTwist_complexModeSum_eq_single
    intro b hba
    exact reflectedTwists_contains_other n points a b hba
  apply positionCoeff_mul_gap_pow_le_of_isolation
    n hn (reflectedModeTime points a)
    (reflectedPositionCoeff u a) (reflectedVelocityCoeff u a)
    twists f (4 * min (K / n) (lam / n)) M hdelta hM
    (by simpa [twists] using reflectedTwists_unit n points a)
    (by simpa [twists] using
      reflectedTwists_gap n hn K lam points hK hlam hsmooth hspread a)
    hisolate
  intro q hq
  have hq' : q ≤ n := by
    have hlen : twists.length = 2 * m - 1 := by
      simpa [twists] using reflectedTwists_length n points a
    rw [hlen] at hq
    omega
  have hbound := norm_realComplexPhaseProjection_rightIndex_le_sqrt_energy
    n points u q hq'
  simpa [f, M] using hbound

/-- Elementary real algebra underlying the velocity branch of the covariance
estimate. -/
lemma velocity_energy_algebra
    (m n S E b d F : ℝ)
    (hm : 0 < m) (hn : 0 < n) (hE : 0 ≤ E)
    (hb : S / (8 * m) ≤ b ^ 2)
    (hb0 : 0 ≤ b) (hd : 0 ≤ d) (hF : 0 ≤ F)
    (hbound : b * d / n ≤ 2 * F * Real.sqrt E) :
    d ^ 2 * S ≤ 32 * m * F ^ 2 * n ^ 2 * E := by
  have hsqrt : 0 ≤ Real.sqrt E := Real.sqrt_nonneg E
  have hleft : 0 ≤ b * d / n := by positivity
  have hright : 0 ≤ 2 * F * Real.sqrt E := by positivity
  have hsq : (b * d / n) ^ 2 ≤ (2 * F * Real.sqrt E) ^ 2 := by
    nlinarith
  have hn0 : n ≠ 0 := hn.ne'
  have hcore : b ^ 2 * d ^ 2 ≤ 4 * F ^ 2 * n ^ 2 * E := by
    calc
      b ^ 2 * d ^ 2 = (b * d / n) ^ 2 * n ^ 2 := by
        field_simp
      _ ≤ (2 * F * Real.sqrt E) ^ 2 * n ^ 2 :=
        mul_le_mul_of_nonneg_right hsq (sq_nonneg n)
      _ = 4 * F ^ 2 * n ^ 2 * (Real.sqrt E) ^ 2 := by ring
      _ = 4 * F ^ 2 * n ^ 2 * E := by rw [Real.sq_sqrt hE]
  have hdmul : S / (8 * m) * d ^ 2 ≤ b ^ 2 * d ^ 2 :=
    mul_le_mul_of_nonneg_right hb (sq_nonneg d)
  calc
    d ^ 2 * S = (S / (8 * m) * d ^ 2) * (8 * m) := by
      field_simp
    _ ≤ (b ^ 2 * d ^ 2) * (8 * m) :=
      mul_le_mul_of_nonneg_right hdmul (by positivity)
    _ ≤ (4 * F ^ 2 * n ^ 2 * E) * (8 * m) :=
      mul_le_mul_of_nonneg_right hcore (by positivity)
    _ = 32 * m * F ^ 2 * n ^ 2 * E := by ring

/-- Elementary real algebra underlying the position branch. -/
lemma position_energy_algebra
    (m n L S E a b d F : ℝ)
    (hm : 0 < m) (hn : 0 < n) (hL : 0 ≤ L) (hE : 0 ≤ E)
    (ha : S / (8 * m) ≤ a ^ 2)
    (ha0 : 0 ≤ a) (hb0 : 0 ≤ b)
    (hd0 : 0 ≤ d) (hd1 : d ≤ 1) (hF1 : 1 ≤ F)
    (hvel : b * d / n ≤ 2 * F * Real.sqrt E)
    (hpos : a * d ≤ F * Real.sqrt E + L * F * b / n) :
    d ^ 4 * S ≤ 8 * m * (1 + 2 * L) ^ 2 * F ^ 4 * E := by
  have hsqrt : 0 ≤ Real.sqrt E := Real.sqrt_nonneg E
  have hF0 : 0 ≤ F := le_trans (by norm_num) hF1
  have hvel' : b / n * d ≤ 2 * F * Real.sqrt E := by
    convert hvel using 1 <;> ring
  have hcorr : L * F * (b / n * d) ≤
      L * F * (2 * F * Real.sqrt E) :=
    mul_le_mul_of_nonneg_left hvel' (mul_nonneg hL hF0)
  have hFd : F * Real.sqrt E * d ≤ F * Real.sqrt E := by
    simpa using mul_le_mul_of_nonneg_left hd1 (mul_nonneg hF0 hsqrt)
  have hFF : F * Real.sqrt E ≤ F ^ 2 * Real.sqrt E := by
    gcongr
    nlinarith
  have hmain : a * d ^ 2 ≤ (1 + 2 * L) * F ^ 2 * Real.sqrt E := by
    calc
      a * d ^ 2 = (a * d) * d := by ring
      _ ≤ (F * Real.sqrt E + L * F * b / n) * d :=
        mul_le_mul_of_nonneg_right hpos hd0
      _ = F * Real.sqrt E * d + L * F * (b / n * d) := by ring
      _ ≤ F * Real.sqrt E + L * F * (2 * F * Real.sqrt E) :=
        add_le_add hFd hcorr
      _ ≤ F ^ 2 * Real.sqrt E + L * F * (2 * F * Real.sqrt E) :=
        add_le_add hFF le_rfl
      _ = (1 + 2 * L) * F ^ 2 * Real.sqrt E := by ring
  have hleft : 0 ≤ a * d ^ 2 := mul_nonneg ha0 (sq_nonneg d)
  have hright : 0 ≤ (1 + 2 * L) * F ^ 2 * Real.sqrt E := by positivity
  have hsq : (a * d ^ 2) ^ 2 ≤
      ((1 + 2 * L) * F ^ 2 * Real.sqrt E) ^ 2 := by
    nlinarith
  have hcore : a ^ 2 * d ^ 4 ≤ (1 + 2 * L) ^ 2 * F ^ 4 * E := by
    calc
      a ^ 2 * d ^ 4 = (a * d ^ 2) ^ 2 := by ring
      _ ≤ ((1 + 2 * L) * F ^ 2 * Real.sqrt E) ^ 2 := hsq
      _ = (1 + 2 * L) ^ 2 * F ^ 4 * (Real.sqrt E) ^ 2 := by ring
      _ = (1 + 2 * L) ^ 2 * F ^ 4 * E := by rw [Real.sq_sqrt hE]
  have hdmul : S / (8 * m) * d ^ 4 ≤ a ^ 2 * d ^ 4 :=
    mul_le_mul_of_nonneg_right ha (by positivity)
  calc
    d ^ 4 * S = (S / (8 * m) * d ^ 4) * (8 * m) := by
      field_simp
    _ ≤ (a ^ 2 * d ^ 4) * (8 * m) :=
      mul_le_mul_of_nonneg_right hdmul (by positivity)
    _ ≤ ((1 + 2 * L) ^ 2 * F ^ 4 * E) * (8 * m) :=
      mul_le_mul_of_nonneg_right hcore (by positivity)
    _ = 8 * m * (1 + 2 * L) ^ 2 * F ^ 4 * E := by ring

def phaseTwistCount (m : ℕ) : ℕ := 2 * m - 1

noncomputable def phaseDirichletEta (L Q : ℕ) : ℝ :=
  (L : ℝ) * (2 * Real.pi / Q)

noncomputable def phaseHighVelocityDemand
    (n m H k ell : ℕ) (ε δ : ℝ) : ℝ :=
  (H : ℝ) * ((H : ℝ) / n) ^ 2 *
    ((1 / (8 * (m : ℝ))) * (ε ^ (2 * k)) ^ 2 *
      (δ ^ (2 * ell)) ^ 2)

noncomputable def phaseHighPositionDemand
    (m H k ell : ℕ) (ε δ : ℝ) : ℝ :=
  (H : ℝ) *
    ((Real.sqrt (1 / (8 * (m : ℝ))) * ε ^ (2 * k) *
      δ ^ (2 * ell)) / 2) ^ 2

noncomputable def phaseHighVelocityBudget
    (t E : ℝ) (ell k : ℕ) : ℝ :=
  2 * (36 : ℝ) ^ ell *
    ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E)

noncomputable def phaseHighPositionBudget
    (t E J : ℝ) (ell k : ℕ) : ℝ :=
  (2 + 4 * (J + 1) ^ 2) * (36 : ℝ) ^ ell *
    ((Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) * E)

/-! ### A concrete polynomial scale table

The following exponents are a deliberately slack polynomial substitute for
the polylogarithmic choices in Cook--Nguyen.  They are arranged so that every
strict comparison needed by `phaseLatticeEnergy_high_frequency_rigidity` has
power-law room.  Keeping the table explicit makes the later `atTop` argument
an exercise in floor/ceiling estimates rather than informal exponent
bookkeeping. -/

def rigidityDifferenceOrder (m : ℕ) : ℕ := 1000 * m * (m + 1)

noncomputable def rigiditySmoothExponent : ℝ := 1 / 16
noncomputable def rigidityBlockExponent : ℝ := 99 / 100
noncomputable def rigidityEnergyExponent : ℝ := 1 / 1000
noncomputable def rigidityGoodThresholdExponent : ℝ := 3 / 1000

/-- Polynomial Fourier window needed for the `4m`-dimensional shrinking-box
local limit theorem. -/
noncomputable def rigidityFourierExponent (m : ℕ) : ℝ :=
  10 * (m + 1 : ℕ)

noncomputable def rigidityEpsilonExponent (m : ℕ) : ℝ :=
  1 / (1000000 * (m : ℝ) * ((m : ℝ) + 1))

noncomputable def rigidityDilationLossExponent (m : ℕ) : ℝ :=
  1 / (1000 * (m : ℝ))

noncomputable def rigidityDirichletExponent (m : ℕ) : ℝ :=
  1 / (40 * (m : ℝ))

noncomputable def rigidityPropagationExponent (m : ℕ) : ℝ :=
  15 / 16 - rigidityEpsilonExponent m

noncomputable def rigidityDilationStepExponent (m : ℕ) : ℝ :=
  15 / 16 - rigidityDilationLossExponent m

lemma phaseTwistCount_le_two_mul (m : ℕ) : phaseTwistCount m ≤ 2 * m := by
  unfold phaseTwistCount
  omega

lemma rigidityEpsilonExponent_pos {m : ℕ} (hm : 0 < m) :
    0 < rigidityEpsilonExponent m := by
  unfold rigidityEpsilonExponent
  positivity

lemma rigidityDilationLossExponent_pos {m : ℕ} (hm : 0 < m) :
    0 < rigidityDilationLossExponent m := by
  unfold rigidityDilationLossExponent
  positivity

lemma rigidityDirichletExponent_pos {m : ℕ} (hm : 0 < m) :
    0 < rigidityDirichletExponent m := by
  unfold rigidityDirichletExponent
  positivity

lemma rigidity_dilationStep_lt_block {m : ℕ} (hm : 0 < m) :
    rigidityDilationStepExponent m < rigidityBlockExponent := by
  have hd := rigidityDilationLossExponent_pos hm
  unfold rigidityDilationStepExponent rigidityBlockExponent
  linarith

lemma rigidity_propagation_dirichlet_lt_block {m : ℕ} (hm : 0 < m) :
    rigidityPropagationExponent m +
        (2 * m : ℕ) * rigidityDirichletExponent m <
      rigidityBlockExponent := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  unfold rigidityPropagationExponent rigidityEpsilonExponent
    rigidityDirichletExponent rigidityBlockExponent
  push_cast
  field_simp
  nlinarith

lemma rigidity_unwrap_dirichlet_margin {m : ℕ} (hm : 0 < m) :
    rigidityFourierExponent m <
      2 * (rigidityDifferenceOrder m : ℕ) *
        rigidityDirichletExponent m := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  unfold rigidityFourierExponent rigidityDifferenceOrder
    rigidityDirichletExponent
  push_cast
  field_simp
  nlinarith

lemma rigidity_unwrap_sharp_correction_margin {m : ℕ} (hm : 0 < m) :
    rigidityFourierExponent m + 1 / 20 - 1 -
        ((2 * rigidityDifferenceOrder m - 1 : ℕ) : ℝ) *
          rigidityDirichletExponent m < 0 := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hmone : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hk : 1 ≤ 2 * rigidityDifferenceOrder m := by
    have hk0 : 0 < rigidityDifferenceOrder m := by
      unfold rigidityDifferenceOrder
      exact Nat.mul_pos (Nat.mul_pos (by norm_num) hm) (Nat.succ_pos m)
    omega
  rw [Nat.cast_sub hk]
  unfold rigidityFourierExponent rigidityDifferenceOrder
    rigidityDirichletExponent
  push_cast
  field_simp
  ring_nf at *
  nlinarith

lemma rigidity_unwrap_step_margin {m : ℕ} (hm : 0 < m) :
    (1 / 2 : ℝ) +
        (2 * m : ℕ) * rigidityDirichletExponent m < 1 := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  unfold rigidityDirichletExponent
  push_cast
  field_simp
  nlinarith

lemma rigidity_propagation_correction_margin {m : ℕ} (hm : 0 < m) :
    rigidityPropagationExponent m +
          (2 * m : ℕ) * rigidityDirichletExponent m - 1 <
      -(2 * (rigidityDifferenceOrder m : ℕ) *
          rigidityEpsilonExponent m) := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  unfold rigidityPropagationExponent rigidityDifferenceOrder
    rigidityEpsilonExponent rigidityDirichletExponent
  push_cast
  field_simp
  nlinarith

lemma rigidity_dilation_correction_margin {m : ℕ} (hm : 0 < m) :
    rigidityDilationStepExponent m - 1 <
      -(2 * (rigidityDifferenceOrder m : ℕ) *
          rigidityEpsilonExponent m +
        2 * (phaseTwistCount m : ℕ) *
          rigidityDilationLossExponent m) := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hell : ((phaseTwistCount m : ℕ) : ℝ) ≤ 2 * (m : ℝ) := by
    exact_mod_cast phaseTwistCount_le_two_mul m
  have hdpos := rigidityDilationLossExponent_pos hm
  unfold rigidityDilationStepExponent rigidityDilationLossExponent
    rigidityDifferenceOrder rigidityEpsilonExponent at *
  push_cast at *
  have hbound :
      2 * (phaseTwistCount m : ℝ) * (1 / (1000 * (m : ℝ))) ≤
        1 / 250 := by
    have := mul_le_mul_of_nonneg_right hell (by positivity :
      0 ≤ 2 * (1 / (1000 * (m : ℝ))))
    calc
      2 * (phaseTwistCount m : ℝ) * (1 / (1000 * (m : ℝ))) =
          (phaseTwistCount m : ℝ) *
            (2 * (1 / (1000 * (m : ℝ)))) := by ring
      _ ≤ (2 * (m : ℝ)) *
            (2 * (1 / (1000 * (m : ℝ)))) := this
      _ = 1 / 250 := by field_simp; ring
  have heps :
      2 * (1000 * (m : ℝ) * ((m : ℝ) + 1)) *
          (1 / (1000000 * (m : ℝ) * ((m : ℝ) + 1))) = 1 / 500 := by
    field_simp
    ring
  rw [heps]
  linarith

lemma rigidity_good_block_margin :
    rigidityBlockExponent + rigidityEnergyExponent +
        2 * rigidityGoodThresholdExponent < 1 := by
  norm_num [rigidityBlockExponent, rigidityEnergyExponent,
    rigidityGoodThresholdExponent]

lemma rigidity_position_demand_margin {m : ℕ} (hm : 0 < m) :
    2 * (1 - rigidityBlockExponent) + rigidityEnergyExponent <
      rigidityBlockExponent -
        4 * (rigidityDifferenceOrder m : ℕ) *
          rigidityEpsilonExponent m -
        4 * (phaseTwistCount m : ℕ) *
          rigidityDilationLossExponent m := by
  have hmreal : (0 : ℝ) < m := by exact_mod_cast hm
  have hell : ((phaseTwistCount m : ℕ) : ℝ) ≤ 2 * (m : ℝ) := by
    exact_mod_cast phaseTwistCount_le_two_mul m
  have hdpos := rigidityDilationLossExponent_pos hm
  unfold rigidityBlockExponent rigidityEnergyExponent
    rigidityDifferenceOrder rigidityEpsilonExponent
    rigidityDilationLossExponent at *
  push_cast at *
  have hdelta :
      4 * (phaseTwistCount m : ℝ) * (1 / (1000 * (m : ℝ))) ≤
        1 / 125 := by
    have := mul_le_mul_of_nonneg_right hell (by positivity :
      0 ≤ 4 * (1 / (1000 * (m : ℝ))))
    calc
      4 * (phaseTwistCount m : ℝ) * (1 / (1000 * (m : ℝ))) =
          (phaseTwistCount m : ℝ) *
            (4 * (1 / (1000 * (m : ℝ)))) := by ring
      _ ≤ (2 * (m : ℝ)) *
            (4 * (1 / (1000 * (m : ℝ)))) := this
      _ = 1 / 125 := by field_simp; ring
  have heps :
      4 * (1000 * (m : ℝ) * ((m : ℝ) + 1)) *
          (1 / (1000000 * (m : ℝ) * ((m : ℝ) + 1))) = 1 / 250 := by
    field_simp
    ring
  rw [heps]
  linarith

