  simpa using (allLocalSiteSets_ratio_tendsto_factorial k).sub
    (badLocalSiteSets_ratio_tendsto_zero k hk)

noncomputable def goodTruncatedChooseContribution
    (n k : ℕ) (u velocityLower velocityUpper : ℝ) : ℝ :=
  ∑ s ∈ goodLocalSiteSets n k,
    uniformProbability (fun e : SignVector (2 * n) ↦
      ∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)

noncomputable def halfGoodTruncatedChooseContribution
    (n k : ℕ) (u velocityLower velocityUpper : ℝ) : ℝ :=
  ∑ s ∈ halfGoodLocalSiteSets n k,
    uniformProbability (fun e : SignVector (2 * n) ↦
      ∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)

noncomputable def halfNonspreadTruncatedChooseContribution
    (n k : ℕ) (u velocityLower velocityUpper : ℝ) : ℝ :=
  ∑ s ∈ halfNonspreadLocalSiteSets n k,
    uniformProbability (fun e : SignVector (2 * n) ↦
      ∀ a ∈ s,
        IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)

lemma uniformChooseMoment_halfTruncated_eq_good_add_nonspread
    (n k : ℕ) (u velocityLower velocityUpper : ℝ) :
    uniformChooseMoment
        (halfTruncatedLocalMinimumCount n u velocityLower velocityUpper) k =
      halfGoodTruncatedChooseContribution n k u velocityLower velocityUpper +
        halfNonspreadTruncatedChooseContribution n k u
          velocityLower velocityUpper := by
  rw [uniformChooseMoment_halfTruncatedLocalMinimumCount]
  rw [halfSmoothPowerset_eq_good_union_nonspread]
  rw [Finset.sum_union (halfGoodLocalSiteSets_disjoint_halfNonspread n k)]
  simp only [halfGoodTruncatedChooseContribution,
    halfNonspreadTruncatedChooseContribution]

lemma sum_sub_normalized_card
    {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (p : ι → ℝ) (q A : ℝ) (hq : q ≠ 0) :
    (∑ i ∈ s, p i) - A * (s.card : ℝ) / q =
      (∑ i ∈ s, (q * p i - A)) / q := by
  field_simp
  rw [Finset.sum_sub_distrib]
  rw [← Finset.mul_sum]
  simp
  ring

theorem eventually_goodTruncatedChooseContribution_close
    (k : ℕ) (hk : 0 < k)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 < u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 < velocityUpper)
    {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop,
      |goodTruncatedChooseContribution n k u velocityLower velocityUpper -
        (((12 * u / Real.pi) *
          blockVelocityMass velocityLower velocityUpper) ^ k) *
          ((goodLocalSiteSets n k).card : ℝ) /
            (localMeshSize n : ℝ) ^ k| < eps := by
  have hlocal := eventually_uniform_scaled_good_truncatedLocalProbability
    k hk u velocityLower velocityUpper hu hvelLower hvelUpper
      (half_pos heps)
  filter_upwards [hlocal] with n hn
  let A : ℝ := (((12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper) ^ k)
  let q : ℝ := (localMeshSize n : ℝ) ^ k
  have hqpos : 0 < q := by
    dsimp [q]
    exact pow_pos (by exact_mod_cast localMeshSize_pos n) k
  have hcardNat : (goodLocalSiteSets n k).card ≤
      (localMeshSize n) ^ k := by
    calc
      (goodLocalSiteSets n k).card ≤
          (Finset.univ.powersetCard k :
            Finset (Finset (Fin (localMeshSize n)))).card := by
        exact Finset.card_le_card (Finset.filter_subset _ _)
      _ = (localMeshSize n).choose k := by
        rw [Finset.card_powersetCard, Finset.card_univ, Fintype.card_fin]
      _ ≤ (localMeshSize n) ^ k := Nat.choose_le_pow _ _
  have hcardR : ((goodLocalSiteSets n k).card : ℝ) ≤ q := by
    dsimp [q]
    exact_mod_cast hcardNat
  have hsum :
      |∑ s ∈ goodLocalSiteSets n k,
          (q * uniformProbability (fun e : SignVector (2 * n) ↦
              ∀ a ∈ s,
                IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) -
            A)| ≤
        ((goodLocalSiteSets n k).card : ℝ) * (eps / 2) := by
    calc
      |∑ s ∈ goodLocalSiteSets n k,
          (q * uniformProbability (fun e : SignVector (2 * n) ↦
              ∀ a ∈ s,
                IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) -
            A)| ≤
          ∑ s ∈ goodLocalSiteSets n k,
            |q * uniformProbability (fun e : SignVector (2 * n) ↦
                ∀ a ∈ s,
                  IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) -
              A| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _s ∈ goodLocalSiteSets n k, eps / 2 := by
        apply Finset.sum_le_sum
        intro s hs
        have hall : s ∈ Finset.univ.powersetCard k :=
          (Finset.mem_filter.mp hs).1
        have hgood : IsGoodLocalSiteSet n s :=
          (Finset.mem_filter.mp hs).2
        simpa [q, A] using (hn s hall hgood).le
      _ = ((goodLocalSiteSets n k).card : ℝ) * (eps / 2) := by simp
  rw [goodTruncatedChooseContribution,
    sum_sub_normalized_card _ _ q A hqpos.ne']
  rw [abs_div, abs_of_pos hqpos]
  calc
    |∑ s ∈ goodLocalSiteSets n k,
        (q * uniformProbability (fun e : SignVector (2 * n) ↦
            ∀ a ∈ s,
              IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a) -
          A)| / q ≤
        (((goodLocalSiteSets n k).card : ℝ) * (eps / 2)) / q :=
      div_le_div_of_nonneg_right hsum hqpos.le
    _ = (((goodLocalSiteSets n k).card : ℝ) / q) * (eps / 2) := by ring
    _ ≤ 1 * (eps / 2) := by
      gcongr
      exact (div_le_one hqpos).2 hcardR
    _ < eps := by linarith

theorem eventually_halfGoodTruncatedChooseContribution_close
    (k : ℕ) (hk : 0 < k)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 < u) (hvelLower : 0 < velocityLower)
