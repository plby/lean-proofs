  have hactual' :
      |iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (scaledRealPhaseProjection n points u t) j| ≤
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) := by
    simpa using hactual
  have hunwrap := iteratedForwardDifference_eq_centered_of_abs_add_lt_one
    (q₀ : ℤ) (2 * k) (scaledRealPhaseProjection n points u t) j
    ((|t| / Real.pi) *
      ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)))
    ((2 : ℝ) ^ (2 * k) * a) hactual' hcentered hsmall
  simpa [j] using norm_iteratedOrdinaryRealPhase_eq_of_unwrapped
    n points u t ht (q₀ : ℤ) j k hunwrap

/-- Averaging over the whole good block removes the loss proportional to
the block length: the squared ordinary high differences are controlled by
the total lattice energy itself. -/
lemma sum_sq_iteratedOrdinaryRealPhase_goodBlock_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (hfit : 2 * k * q₀ < W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    ∑ v ∈ Finset.range (W - 2 * k * q₀),
        ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)
          (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ^ 2 ≤
      (Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
        phaseLatticeEnergy n points u t := by
  let f : ℤ → ℝ := fun q ↦ centeredModOne
    (scaledRealPhaseProjection n points u t q)
  let j : ℤ := (s : ℤ) - (n : ℤ)
  have hpoint : ∀ v ∈ Finset.range (W - 2 * k * q₀),
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)
          (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ^ 2 =
        (Real.pi / |t|) ^ 2 *
          (iteratedForwardDifference (q₀ : ℤ) (2 * k) f (j + v)) ^ 2 := by
    intro v hv
    have hv' : v + 2 * k * q₀ < W := by
      have hvlt : v < W - 2 * k * q₀ := Finset.mem_range.mp hv
      omega
    have heq := norm_iteratedOrdinaryRealPhase_eq_on_goodBlock
      n hn points u t ht q₀ k η hη hgap s W hs a ha hgood v hv' hsmall
    have hindex : (((s + v : ℕ) : ℤ) - (n : ℤ)) = j + v := by
      dsimp [j]
      push_cast
      ring
    rw [hindex] at heq ⊢
    dsimp [f]
    rw [heq]
    rw [mul_pow, sq_abs]
  calc
    ∑ v ∈ Finset.range (W - 2 * k * q₀),
        ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)
          (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ^ 2 =
        (Real.pi / |t|) ^ 2 *
          ∑ v ∈ Finset.range (W - 2 * k * q₀),
            (iteratedForwardDifference (q₀ : ℤ) (2 * k) f (j + v)) ^ 2 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro v hv
      exact hpoint v hv
    _ ≤ (Real.pi / |t|) ^ 2 *
        ((4 : ℝ) ^ (2 * k) *
          ∑ r ∈ Finset.range W, (f (j + r)) ^ 2) := by
      gcongr
      exact sum_sq_iteratedForwardDifference_range_le q₀ (2 * k) W f j
        (by omega)
    _ ≤ (Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
        phaseLatticeEnergy n points u t := by
      have hres := sum_sq_centeredScaledPhase_block_le_latticeEnergy
        n W s points u t hs
      have hsum :
          ∑ r ∈ Finset.range W, (f (j + r)) ^ 2 ≤
            phaseLatticeEnergy n points u t := by
        convert hres using 1 <;>
          simp [f, j] <;> push_cast <;> ring
      have hfac : 0 ≤ (Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) := by
        positivity
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hsum hfac

/-- Averaged high-difference energy at a multiple of a base step, assuming
the quotient-lattice representatives have already been unwrapped on every
required subwindow. -/
lemma sum_sq_iteratedOrdinaryRealPhase_multiple_goodBlock_le_of_unwrap
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ ell k : ℕ) (s W : ℕ) (hs : s + W ≤ 2 * n + 1)
    (hfit : 2 * k * (ell + 1) * q₀ < W)
    (hunwrap : ∀ v : ℕ, v + 2 * k * (ell + 1) * q₀ < W →
      iteratedForwardDifference (((ell : ℕ) * q₀ : ℕ) : ℤ) (2 * k)
          (scaledRealPhaseProjection n points u t)
          (((s + v : ℕ) : ℤ) - (n : ℤ)) =
        iteratedForwardDifference (((ell : ℕ) * q₀ : ℕ) : ℤ) (2 * k)
          (fun x ↦ centeredModOne
            (scaledRealPhaseProjection n points u t x))
          (((s + v : ℕ) : ℤ) - (n : ℤ))) :
    ∑ v ∈ Finset.range (W - 2 * k * (ell + 1) * q₀),
        ‖iteratedDoubleTwist ((ell * q₀ : ℕ) : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)
          (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ^ 2 ≤
      (Real.pi / |t|) ^ 2 * (4 : ℝ) ^ (2 * k) *
        phaseLatticeEnergy n points u t := by
  let f : ℤ → ℝ := fun x ↦ centeredModOne
    (scaledRealPhaseProjection n points u t x)
  let j : ℤ := (s : ℤ) - (n : ℤ)
  let q : ℕ := ell * q₀
  let U : ℕ := W - 2 * k * (ell + 1) * q₀
  let V : ℕ := W - 2 * k * q
  have hqfit : 2 * k * q ≤ W := by
    have hcore : (2 * k) * (ell * q₀) ≤
        (2 * k) * ((ell + 1) * q₀) :=
      Nat.mul_le_mul_left (2 * k)
        (Nat.mul_le_mul_right q₀ (Nat.le_succ ell))
    exact hcore.trans (by
      simpa [q, Nat.mul_assoc] using Nat.le_of_lt hfit)
  have hUV : U ≤ V := by
    have hcore : (2 * k) * (ell * q₀) ≤
        (2 * k) * ((ell + 1) * q₀) :=
      Nat.mul_le_mul_left (2 * k)
        (Nat.mul_le_mul_right q₀ (Nat.le_succ ell))
    dsimp [U, V, q]
    exact Nat.sub_le_sub_left (by simpa [Nat.mul_assoc] using hcore) W
  have hpoint : ∀ v ∈ Finset.range U,
      ‖iteratedDoubleTwist (q : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)
          (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ^ 2 =
        (Real.pi / |t|) ^ 2 *
          (iteratedForwardDifference (q : ℤ) (2 * k) f (j + v)) ^ 2 := by
    intro v hv
    have hv' : v + 2 * k * (ell + 1) * q₀ < W := by
      have hvlt : v < U := Finset.mem_range.mp hv
      dsimp [U] at hvlt
      omega
    have hunwrapV := hunwrap v hv'
    have heq := norm_iteratedOrdinaryRealPhase_eq_of_unwrapped
      n points u t ht (q : ℤ)
        (((s + v : ℕ) : ℤ) - (n : ℤ)) k (by
          simpa [q] using hunwrapV)
    have hindex : (((s + v : ℕ) : ℤ) - (n : ℤ)) = j + v := by
      dsimp [j]
      push_cast
      ring
    rw [hindex] at heq ⊢
    dsimp [f]
    rw [heq, mul_pow, sq_abs]
  calc
    ∑ v ∈ Finset.range (W - 2 * k * (ell + 1) * q₀),
        ‖iteratedDoubleTwist ((ell * q₀ : ℕ) : ℤ) (List.replicate k 1)
          (realComplexPhaseProjection n points u)
          (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ^ 2 =
