    · have hsvReal : (s : ℝ) + (v : ℝ) ≤ 2 * (n : ℝ) := by
        exact_mod_cast hsv
      simp only [j, Int.cast_sub, Int.cast_natCast, Nat.cast_add, Int.cast_add]
      linarith
  have hcentered :
      |iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (fun q ↦ centeredModOne
          (scaledRealPhaseProjection n points u t q)) j| ≤
        (2 : ℝ) ^ (2 * k) * a := by
    apply abs_iteratedForwardDifference_le_window
    intro r hr
    have hvr : v + r * q₀ < W := by
      have hmul : r * q₀ ≤ (2 * k) * q₀ := Nat.mul_le_mul_right q₀ hr
      omega
    rw [show j + (r : ℤ) * (q₀ : ℤ) =
        (((s + (v + r * q₀) : ℕ) : ℤ) - (n : ℤ)) by
