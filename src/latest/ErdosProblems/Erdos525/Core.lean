      n hn points u h j k η hη hj hgap)
    (by positivity)

/-- Quantitative unwrapping of the quotient lattice on one central
arithmetic-progression window.  This is the exact bridge between the
analytic high-difference estimate and integer rigidity. -/
lemma iteratedForwardDifference_scaledPhase_eq_centered
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (h j : ℤ) (k : ℕ)
    (η : ℝ) (hη : 0 ≤ η)
    (hj : |(j : ℝ)| ≤ n)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) h - 1‖ ≤ η)
    (hwindow : ∀ r : ℕ, r ≤ 2 * k →
      ∃ a : Fin (2 * n + 1),
        centeredIndex n a = j + (r : ℤ) * h)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * |(h : ℝ)| / n)) +
        (2 : ℝ) ^ (2 * k) *
          Real.sqrt (phaseLatticeEnergy n points u t) < 1) :
    iteratedForwardDifference h (2 * k)
        (scaledRealPhaseProjection n points u t) j =
      iteratedForwardDifference h (2 * k)
        (fun q ↦ centeredModOne
          (scaledRealPhaseProjection n points u t q)) j := by
  apply iteratedForwardDifference_eq_centered_of_abs_add_lt_one
    h (2 * k) (scaledRealPhaseProjection n points u t) j
    ((|t| / Real.pi) *
      ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k * |(h : ℝ)| / n)))
    ((2 : ℝ) ^ (2 * k) *
      Real.sqrt (phaseLatticeEnergy n points u t))
  · exact abs_iteratedForwardDifference_scaledRealPhaseProjection_le_l1
      n hn points u t h j k η hη hj hgap
  · exact abs_iteratedForwardDifference_centeredPhase_le_latticeEnergy
      n points u t h j (2 * k) hwindow
  · exact hsmall

/-- Good-block specialization of the base-step unwrapping identity. -/
lemma iteratedForwardDifference_scaledPhase_eq_centered_on_goodBlock
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ b : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points b) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (v : ℕ) (hv : v + 2 * k * q₀ < W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (scaledRealPhaseProjection n points u t)
        (((s + v : ℕ) : ℤ) - (n : ℤ)) =
      iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (fun x ↦ centeredModOne
          (scaledRealPhaseProjection n points u t x))
        (((s + v : ℕ) : ℤ) - (n : ℤ)) := by
  let j : ℤ := ((s + v : ℕ) : ℤ) - (n : ℤ)
  have hsv : s + v ≤ 2 * n := by omega
  have hj : |(j : ℝ)| ≤ n := by
    rw [abs_le]
    constructor
    · simp only [j, Int.cast_sub, Int.cast_natCast, Nat.cast_add, Int.cast_add]
      have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
      have hv0 : (0 : ℝ) ≤ v := Nat.cast_nonneg v
      linarith
    · have hsvReal : (s : ℝ) + (v : ℝ) ≤ 2 * (n : ℝ) := by
        exact_mod_cast hsv
      simp only [j, Int.cast_sub, Int.cast_natCast, Nat.cast_add, Int.cast_add]
      linarith
  have hwindow : ∀ r : ℕ, r ≤ 2 * k →
      ∃ b : Fin (2 * n + 1),
        centeredIndex n b = j + (r : ℤ) * (q₀ : ℤ) := by
    intro r hr
    have hvr : v + r * q₀ < W := by
      have hmul : r * q₀ ≤ (2 * k) * q₀ := Nat.mul_le_mul_right q₀ hr
      omega
    refine ⟨⟨s + (v + r * q₀), by omega⟩, ?_⟩
    simp only [centeredIndex, Fin.val_mk]
    dsimp [j]
    push_cast
    ring
  have hcentered :
      |iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (fun x ↦ centeredModOne
          (scaledRealPhaseProjection n points u t x)) j| ≤
        (2 : ℝ) ^ (2 * k) * a := by
    apply abs_iteratedForwardDifference_le_window
    intro r hr
    have hvr : v + r * q₀ < W := by
      have hmul : r * q₀ ≤ (2 * k) * q₀ := Nat.mul_le_mul_right q₀ hr
      omega
    rw [show j + (r : ℤ) * (q₀ : ℤ) =
        (((s + (v + r * q₀) : ℕ) : ℤ) - (n : ℤ)) by
      dsimp [j]
      push_cast
      ring]
    exact hgood (v + r * q₀) hvr
  have hactual :=
    abs_iteratedForwardDifference_scaledRealPhaseProjection_le_l1
      n hn points u t (q₀ : ℤ) j k η hη hj hgap
  have hq₀cast : 0 ≤ ((((q₀ : ℕ) : ℤ) : ℝ)) := by positivity
  rw [abs_of_nonneg hq₀cast] at hactual
  exact iteratedForwardDifference_eq_centered_of_abs_add_lt_one
    (q₀ : ℤ) (2 * k) (scaledRealPhaseProjection n points u t) j
    ((|t| / Real.pi) *
      ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)))
    ((2 : ℝ) ^ (2 * k) * a) hactual hcentered hsmall

