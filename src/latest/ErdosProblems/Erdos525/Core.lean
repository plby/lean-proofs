/-- The transported-position estimate rewritten in terms of the original
position and velocity coefficients and the ordinary Dirichlet chord. -/
lemma reflectedPositionCoeff_mul_dirichletGap_le
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (q₀ k : ℕ)
    (step : ReflectedMode m → ℕ) (target : ReflectedMode m)
    (δ M : ℝ) (hδ : 0 ≤ δ) (hM : 0 ≤ M)
    (hsep : ∀ b : ReflectedMode m, b ≠ target →
      δ ≤ ‖complexWave n (reflectedModeTime points target) (step b : ℤ) -
        complexWave n (reflectedModeTime points b) (step b : ℤ)‖)
    (hwindow : ∀ q : ℕ,
      q ≤ variableTwistSpan
        (variableReflectedTwists n points step target) →
      ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
        (realComplexPhaseProjection n points u) q‖ ≤ M) :
    ‖reflectedPositionCoeff u target‖ *
          ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
            (2 * k) *
          δ ^ (2 * (variableReflectedTwists n points step target).length) ≤
      (4 : ℝ) ^ (variableReflectedTwists n points step target).length * M +
        2 * (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
          (variableStepSum
            (variableReflectedTwists n points step target) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) := by
  let ordinary : List ℂ := List.replicate k 1
  let isolating := variableReflectedTwists n points step target
  let A : ℂ := reflectedPositionCoeff u target
  let B : ℂ := reflectedVelocityCoeff u target
  let P : ℂ := modeSeparationProduct n (reflectedModeTime points target)
    (q₀ : ℤ) ordinary
  let C : ℂ := affinePositionAfter n (reflectedModeTime points target)
    (q₀ : ℤ) A B ordinary
  let D : ℝ := δ ^ (2 * isolating.length)
  let G : ℝ :=
    ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
      (2 * k)
  have hD : 0 ≤ D := by dsimp [D]; positivity
  have hP : ‖P‖ = G := by
    dsimp [P, G, ordinary]
    exact norm_modeSeparationProduct_replicate_one _ _ _ _
  have htransport : ‖C - A * P‖ ≤
      (k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n := by
    simpa [C, A, B, P, ordinary] using
      norm_affinePositionAfter_sub_le_general n hn
        (reflectedModeTime points target) (q₀ : ℤ) A B ordinary
        (by
          intro ζ hζ
          simp only [ordinary, List.mem_replicate] at hζ
          rcases hζ with ⟨_hk, rfl⟩
          simp)
  have hAP : ‖A‖ * G ≤ ‖C‖ +
      (k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n := by
    calc
      ‖A‖ * G = ‖A * P‖ := by rw [norm_mul, hP]
      _ = ‖C - (C - A * P)‖ := by congr 1 <;> ring
      _ ≤ ‖C‖ + ‖C - A * P‖ := norm_sub_le _ _
      _ ≤ ‖C‖ +
          (k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n :=
        add_le_add le_rfl htransport
  have hpos := ordinaryReflectedPositionAfter_mul_gap_le
    n hn points u q₀ k step target δ M hδ hM hsep hwindow
  have hpos' : ‖C‖ * D ≤
      (4 : ℝ) ^ isolating.length * M +
        2 * (4 : ℝ) ^ isolating.length * (‖B‖ * G) *
          (variableStepSum isolating : ℝ) / n := by
    simpa [C, D, isolating, A, B, ordinary, norm_mul,
      norm_modeSeparationProduct_replicate_one, G] using hpos
  calc
    ‖reflectedPositionCoeff u target‖ * G * D = ‖A‖ * G * D := by rfl
    _ ≤ (‖C‖ +
          (k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n) * D :=
      mul_le_mul_of_nonneg_right hAP hD
    _ = ‖C‖ * D +
        ((k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n) * D := by ring
    _ ≤ ((4 : ℝ) ^ isolating.length * M +
          2 * (4 : ℝ) ^ isolating.length * (‖B‖ * G) *
            (variableStepSum isolating : ℝ) / n) +
        ((k : ℝ) * (4 : ℝ) ^ k * ‖B‖ * (q₀ : ℝ) / n) * D :=
      add_le_add hpos' le_rfl
    _ = (4 : ℝ) ^
          (variableReflectedTwists n points step target).length * M +
        2 * (4 : ℝ) ^
            (variableReflectedTwists n points step target).length *
          (‖reflectedVelocityCoeff u target‖ *
            ‖complexWave n (reflectedModeTime points target) (q₀ : ℤ) - 1‖ ^
              (2 * k)) *
          (variableStepSum
            (variableReflectedTwists n points step target) : ℝ) / n +
        ((k : ℝ) * (4 : ℝ) ^ k *
            ‖reflectedVelocityCoeff u target‖ * (q₀ : ℝ) / n) *
          δ ^ (2 *
            (variableReflectedTwists n points step target).length) := by
      rfl

