    rw [show (6 * u / Real.pi *
        blockVelocityMass velocityLower velocityUpper) =
      ((12 * u / Real.pi * blockVelocityMass velocityLower velocityUpper) *
        (1 / 2 : ℝ)) by ring, mul_pow]
    ring

/-- Third derivative of the centered process in microscopic time. -/
noncomputable def rescaledCenteredJerk (n : ℕ)
    (e : SignVector (2 * n)) (t : ℝ) : ℂ :=
  (Real.sqrt (2 * n + 1 : ℝ) : ℂ)⁻¹ *
    ∑ j : Fin (2 * n + 1),
      (sign (e j) : ℂ) *
        (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
        (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
        (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          Complex.exp
            ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)

lemma hasDerivAt_rescaledCenteredAcceleration (n : ℕ)
    (e : SignVector (2 * n)) (t : ℝ) :
    HasDerivAt (rescaledCenteredAcceleration n e)
      (rescaledCenteredJerk n e t) t := by
  unfold rescaledCenteredAcceleration rescaledCenteredJerk
  apply HasDerivAt.const_mul
  have hterm : ∀ j : Fin (2 * n + 1),
      HasDerivAt
        (fun s : ℝ ↦
          (sign (e j) : ℂ) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((s / n : ℝ) : ℂ) * Complex.I))
        ((sign (e j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)) t := by
    intro j
    have hlinear :
        HasDerivAt
          (fun s : ℝ ↦
            (centeredFrequency n j : ℂ) * ((s / n : ℝ) : ℂ) * Complex.I)
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) t := by
      have h :=
        (((hasDerivAt_id t).div_const (n : ℝ)).ofReal_comp.const_mul
          (centeredFrequency n j : ℂ)).mul_const Complex.I
      simpa [div_eq_mul_inv] using h
    simpa only [mul_assoc, mul_left_comm, mul_comm] using
      (HasDerivAt.const_mul
        ((sign (e j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I))
        hlinear.cexp)
  exact HasDerivAt.fun_sum (u := Finset.univ) (fun j _ ↦ hterm j)

lemma norm_rescaledCenteredJerk_le (n : ℕ)
    (e : SignVector (2 * n)) (t : ℝ) :
    ‖rescaledCenteredJerk n e t‖ ≤ Real.sqrt (2 * n + 1 : ℝ) := by
  by_cases hn : n = 0
  · subst n
    simp [rescaledCenteredJerk, centeredFrequency]
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hterm : ∀ j : Fin (2 * n + 1),
      ‖(sign (e j) : ℂ) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
          (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            Complex.exp
              ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)‖ ≤ 1 := by
    intro j
    have hsign : |sign (e j)| = 1 := by cases e j <;> simp [sign]
    have hexp :
        ‖Complex.exp
          ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)‖ = 1 := by
      rw [Complex.norm_exp]
      simp [Complex.mul_re]
    rw [norm_mul, norm_mul, norm_mul, norm_mul, hexp, Complex.norm_real,
      Real.norm_eq_abs, hsign]
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      one_mul, mul_one]
    have hv := abs_centeredFrequency_div_le_one n hnpos j
    nlinarith [abs_nonneg (centeredFrequency n j / (n : ℝ))]
  unfold rescaledCenteredJerk
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hsqrt]
  calc
    (Real.sqrt (2 * n + 1 : ℝ))⁻¹ *
        ‖∑ j : Fin (2 * n + 1),
          (sign (e j) : ℂ) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
            (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
              Complex.exp
                ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)‖ ≤
        (Real.sqrt (2 * n + 1 : ℝ))⁻¹ *
          ∑ _j : Fin (2 * n + 1), (1 : ℝ) := by
      gcongr
      exact (norm_sum_le _ _).trans
        (Finset.sum_le_sum fun j _ ↦ hterm j)
    _ = Real.sqrt (2 * n + 1 : ℝ) := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
      simp only [nsmul_eq_mul, one_mul]
      have hsquare := Real.sq_sqrt (by positivity : (0 : ℝ) ≤ 2 * n + 1)
      norm_num at hsquare ⊢
      field_simp [hsqrt.ne']
      nlinarith

noncomputable def accelerationCoeff (n : ℕ) (t : ℝ)
    (j : Fin (2 * n + 1)) : ℂ :=
  (Real.sqrt (2 * n + 1 : ℝ) : ℂ)⁻¹ *
    (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
    (((centeredFrequency n j / n : ℝ) : ℂ) * Complex.I) *
      Complex.exp
        ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I)

lemma rescaledCenteredAcceleration_eq_sum_coeff
    (n : ℕ) (e : SignVector (2 * n)) (t : ℝ) :
    rescaledCenteredAcceleration n e t =
      ∑ j : Fin (2 * n + 1),
        (sign (e j) : ℂ) * accelerationCoeff n t j := by
  unfold rescaledCenteredAcceleration accelerationCoeff
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  ring

lemma rescaledCenteredAcceleration_re_eq
    (n : ℕ) (e : SignVector (2 * n)) (t : ℝ) :
    (rescaledCenteredAcceleration n e t).re =
      ∑ j : Fin (2 * n + 1),
        (accelerationCoeff n t j).re * sign (e j) := by
  rw [rescaledCenteredAcceleration_eq_sum_coeff]
  rw [complex_re_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  ring

lemma rescaledCenteredAcceleration_im_eq
    (n : ℕ) (e : SignVector (2 * n)) (t : ℝ) :
    (rescaledCenteredAcceleration n e t).im =
      ∑ j : Fin (2 * n + 1),
        (accelerationCoeff n t j).im * sign (e j) := by
  rw [rescaledCenteredAcceleration_eq_sum_coeff]
  change Complex.imCLM (∑ j : Fin (2 * n + 1),
      (sign (e j) : ℂ) * accelerationCoeff n t j) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro j _hj
  change ((sign (e j) : ℂ) * accelerationCoeff n t j).im = _
  simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, add_zero]
  ring

lemma norm_accelerationCoeff_le (n : ℕ) (hn : 0 < n) (t : ℝ)
    (j : Fin (2 * n + 1)) :
    ‖accelerationCoeff n t j‖ ≤
      (Real.sqrt (2 * n + 1 : ℝ))⁻¹ := by
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  unfold accelerationCoeff
  rw [norm_mul, norm_mul, norm_mul, norm_inv, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hsqrt, Complex.norm_exp]
  have hexp :
      (((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I).re) = 0 := by
    simp [Complex.mul_re]
  rw [hexp, Real.exp_zero, mul_one]
  simp only [Complex.norm_real, Real.norm_eq_abs, norm_mul, Complex.norm_I,
    mul_one]
  have hv := abs_centeredFrequency_div_le_one n hn j
  have hsquare : |centeredFrequency n j / (n : ℝ)| ^ 2 ≤ 1 := by
    nlinarith [abs_nonneg (centeredFrequency n j / (n : ℝ))]
  nlinarith [inv_nonneg.mpr hsqrt.le]

lemma sum_accelerationCoeff_re_sq_le_one
    (n : ℕ) (hn : 0 < n) (t : ℝ) :
    ∑ j : Fin (2 * n + 1), (accelerationCoeff n t j).re ^ 2 ≤ 1 := by
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hterm : ∀ j : Fin (2 * n + 1),
      (accelerationCoeff n t j).re ^ 2 ≤
        (Real.sqrt (2 * n + 1 : ℝ))⁻¹ ^ 2 := by
    intro j
    have hre := Complex.abs_re_le_norm (accelerationCoeff n t j)
    have hnorm := norm_accelerationCoeff_le n hn t j
    have hsquare := (sq_le_sq₀ (abs_nonneg (accelerationCoeff n t j).re)
      (inv_nonneg.mpr hsqrt.le)).2 (hre.trans hnorm)
    simpa only [sq_abs] using hsquare
  calc
    ∑ j : Fin (2 * n + 1), (accelerationCoeff n t j).re ^ 2 ≤
        ∑ _j : Fin (2 * n + 1),
          (Real.sqrt (2 * n + 1 : ℝ))⁻¹ ^ 2 :=
      Finset.sum_le_sum fun j _ ↦ hterm j
    _ = 1 := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
      simp only [nsmul_eq_mul]
      push_cast
      rw [inv_pow, Real.sq_sqrt (by positivity)]
      field_simp

lemma sum_accelerationCoeff_im_sq_le_one
    (n : ℕ) (hn : 0 < n) (t : ℝ) :
    ∑ j : Fin (2 * n + 1), (accelerationCoeff n t j).im ^ 2 ≤ 1 := by
  have hsqrt : 0 < Real.sqrt (2 * n + 1 : ℝ) := by positivity
  have hterm : ∀ j : Fin (2 * n + 1),
      (accelerationCoeff n t j).im ^ 2 ≤
        (Real.sqrt (2 * n + 1 : ℝ))⁻¹ ^ 2 := by
    intro j
    have him := Complex.abs_im_le_norm (accelerationCoeff n t j)
    have hnorm := norm_accelerationCoeff_le n hn t j
    have hsquare := (sq_le_sq₀ (abs_nonneg (accelerationCoeff n t j).im)
      (inv_nonneg.mpr hsqrt.le)).2 (him.trans hnorm)
    simpa only [sq_abs] using hsquare
  calc
    ∑ j : Fin (2 * n + 1), (accelerationCoeff n t j).im ^ 2 ≤
        ∑ _j : Fin (2 * n + 1),
          (Real.sqrt (2 * n + 1 : ℝ))⁻¹ ^ 2 :=
      Finset.sum_le_sum fun j _ ↦ hterm j
    _ = 1 := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
      simp only [nsmul_eq_mul]
      push_cast
      rw [inv_pow, Real.sq_sqrt (by positivity)]
      field_simp

lemma rademacherLinear_abs_tail_of_sum_sq_le_one
    (d : ℕ) (a : Fin d → ℝ) (t : ℝ) (ht : 0 < t)
    (hsum : ∑ i, a i ^ 2 ≤ 1) :
    uniformProbability (fun e : Fin d → Bool ↦
        t ≤ |∑ i, a i * sign (e i)|) ≤
      2 * Real.exp (-t ^ 2 / 2) := by
  let S : ℝ := ∑ i, a i ^ 2
  have hS0 : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun i _ ↦ sq_nonneg (a i)
  by_cases hSz : S = 0
  · have ha : ∀ i, a i = 0 := by
      intro i
      have hi : a i ^ 2 ≤ S := by
        dsimp [S]
        exact Finset.single_le_sum (fun j _ ↦ sq_nonneg (a j))
          (Finset.mem_univ i)
      rw [hSz] at hi
      nlinarith [sq_nonneg (a i)]
    simp only [ha, zero_mul, Finset.sum_const_zero, abs_zero]
    have hnot : ¬t ≤ 0 := not_le.mpr ht
    rw [uniformProbability]
    simp [hnot]
    positivity
  · have hSpos : 0 < S := lt_of_le_of_ne hS0 (Ne.symm hSz)
    have hSle : S ≤ 1 := by simpa [S] using hsum
    have hbase := rademacherLinear_abs_tail d a t ht.le
    have hexponent : -t ^ 2 / (2 * S) ≤ -t ^ 2 / 2 := by
      have hfrac : t ^ 2 / 2 ≤ t ^ 2 / (2 * S) := by
        exact div_le_div_of_nonneg_left (sq_nonneg t) (by positivity) (by
          nlinarith)
      simpa only [neg_div] using neg_le_neg hfrac
    exact hbase.trans (mul_le_mul_of_nonneg_left
      (Real.exp_le_exp.mpr (by simpa [S] using hexponent)) (by norm_num))

lemma uniformProbability_acceleration_norm_ge
    (n : ℕ) (hn : 0 < n) (t T : ℝ) (hT : 0 < T) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        T ≤ ‖rescaledCenteredAcceleration n e t‖) ≤
      4 * Real.exp (-(T / 2) ^ 2 / 2) := by
  have hre := rademacherLinear_abs_tail_of_sum_sq_le_one
    (2 * n + 1) (fun j ↦ (accelerationCoeff n t j).re)
      (T / 2) (half_pos hT) (sum_accelerationCoeff_re_sq_le_one n hn t)
  have him := rademacherLinear_abs_tail_of_sum_sq_le_one
    (2 * n + 1) (fun j ↦ (accelerationCoeff n t j).im)
      (T / 2) (half_pos hT) (sum_accelerationCoeff_im_sq_le_one n hn t)
  calc
    uniformProbability (fun e : SignVector (2 * n) ↦
        T ≤ ‖rescaledCenteredAcceleration n e t‖) ≤
        uniformProbability (fun e : SignVector (2 * n) ↦
          T / 2 ≤ |(rescaledCenteredAcceleration n e t).re| ∨
          T / 2 ≤ |(rescaledCenteredAcceleration n e t).im|) := by
      apply uniformProbability_mono
      intro e he
      by_contra hboth
      push Not at hboth
      have hnorm := Complex.norm_le_abs_re_add_abs_im
        (rescaledCenteredAcceleration n e t)
      linarith
    _ ≤ uniformProbability (fun e : SignVector (2 * n) ↦
          T / 2 ≤ |(rescaledCenteredAcceleration n e t).re|) +
        uniformProbability (fun e : SignVector (2 * n) ↦
          T / 2 ≤ |(rescaledCenteredAcceleration n e t).im|) :=
      uniformProbability_or_le_add _ _
    _ ≤ 2 * Real.exp (-(T / 2) ^ 2 / 2) +
        2 * Real.exp (-(T / 2) ^ 2 / 2) := by
      apply add_le_add
      · simpa only [rescaledCenteredAcceleration_re_eq] using hre
      · simpa only [rescaledCenteredAcceleration_im_eq] using him
    _ = 4 * Real.exp (-(T / 2) ^ 2 / 2) := by ring

lemma uniformProbability_exists_le_sum
    {Ω I : Type*} [Fintype Ω] [Nonempty Ω] [Fintype I]
    (P : I → Ω → Prop) :
    uniformProbability (fun e ↦ ∃ i, P i e) ≤
      ∑ i, uniformProbability (P i) := by
  classical
  have haux : ∀ s : Finset I,
      uniformProbability (fun e : Ω ↦ ∃ i ∈ s, P i e) ≤
        ∑ i ∈ s, uniformProbability (P i) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        simp [uniformProbability]
    | @insert i s hi ih =>
        calc
          uniformProbability (fun e : Ω ↦ ∃ j ∈ insert i s, P j e) =
              uniformProbability (fun e : Ω ↦
                P i e ∨ ∃ j ∈ s, P j e) := by
            apply congrArg uniformProbability
            funext e
            apply propext
            simp
          _ ≤ uniformProbability (P i) +
              uniformProbability (fun e : Ω ↦ ∃ j ∈ s, P j e) :=
            uniformProbability_or_le_add _ _
          _ ≤ uniformProbability (P i) +
              ∑ j ∈ s, uniformProbability (P j) := by gcongr
          _ = ∑ j ∈ insert i s, uniformProbability (P j) := by
            rw [Finset.sum_insert hi]
  simpa using haux Finset.univ

noncomputable def accelerationCutoff (n : ℕ) : ℝ :=
  rigidityPower n (1 / 8)

def HasHighMeshAcceleration (n : ℕ) (e : SignVector (2 * n)) : Prop :=
  ∃ a : Fin (localMeshSize n),
    accelerationCutoff n ≤
      ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖

lemma uniformProbability_highMeshAcceleration_le
    (n : ℕ) (hn : 0 < n) :
    uniformProbability (HasHighMeshAcceleration n) ≤
      (localMeshSize n : ℝ) *
        (4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2)) := by
  have hcut : 0 < accelerationCutoff n := by
    unfold accelerationCutoff
    exact rigidityPower_pos hn _
  calc
    uniformProbability (HasHighMeshAcceleration n) ≤
        ∑ a : Fin (localMeshSize n),
          uniformProbability (fun e : SignVector (2 * n) ↦
            accelerationCutoff n ≤
              ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖) := by
      exact uniformProbability_exists_le_sum _
    _ ≤ ∑ _a : Fin (localMeshSize n),
        4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2) := by
      apply Finset.sum_le_sum
      intro a _ha
      exact uniformProbability_acceleration_norm_ge n hn
        (localMeshPoint n a) (accelerationCutoff n) hcut
    _ = (localMeshSize n : ℝ) *
        (4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2)) := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
      simp only [nsmul_eq_mul]

lemma highMeshAcceleration_upper_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) *
        (4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2)))
      atTop (𝓝 0) := by
  have hcore :=
    (tendsto_rigidityPower_mul_exp_neg_power_test
      2 (1 / 4) (1 / 8) (by norm_num) (by norm_num)).const_mul 8
  refine squeeze_zero'
    (g := fun n : ℕ ↦ 8 * (rigidityPower n 2 *
      Real.exp (-(1 / 8) * rigidityPower n (1 / 4))))
    (Eventually.of_forall fun n ↦ by positivity) ?_ ?_
  · show ∀ᶠ n : ℕ in atTop,
      (localMeshSize n : ℝ) *
          (4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2)) ≤
        8 * (rigidityPower n 2 *
          Real.exp (-(1 / 8) * rigidityPower n (1 / 4)))
    filter_upwards [Nat.eventually_pos] with n hn
    have hsize : (localMeshSize n : ℝ) ≤
        2 * rigidityPower n 2 := by
      simp only [localMeshSize, rigidityPower]
      norm_num
      push_cast
      nlinarith [show (1 : ℝ) ≤ n by exact_mod_cast hn]
    have hcutSq : accelerationCutoff n ^ 2 =
        rigidityPower n (1 / 4) := by
      unfold accelerationCutoff
      convert rigidityPower_nat_pow hn (1 / 8) 2 using 1 <;> norm_num
    have hexp : -(accelerationCutoff n / 2) ^ 2 / 2 =
        -(1 / 8) * rigidityPower n (1 / 4) := by
      rw [div_pow, hcutSq]
      ring
    rw [hexp]
    have hnonneg : 0 ≤ 4 * Real.exp
        (-(1 / 8) * rigidityPower n (1 / 4)) := by positivity
    calc
      (localMeshSize n : ℝ) *
          (4 * Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) ≤
        (2 * rigidityPower n 2) *
          (4 * Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) :=
        mul_le_mul_of_nonneg_right hsize hnonneg
      _ = 8 * (rigidityPower n 2 *
          Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) := by ring
  · simpa using hcore

theorem uniformProbability_highMeshAcceleration_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      uniformProbability (HasHighMeshAcceleration n)) atTop (𝓝 0) := by
  apply squeeze_zero' (Eventually.of_forall fun n ↦
    uniformProbability_nonneg _)
  · filter_upwards [Nat.eventually_pos] with n hn
    exact uniformProbability_highMeshAcceleration_le n hn
  · exact highMeshAcceleration_upper_tendsto_zero

lemma exists_localMeshPoint_within_step
    (n : ℕ) (hn : 0 < n) (t : ℝ)
    (ht : t ∈ Set.Ico (-(Real.pi * n)) (Real.pi * n)) :
    ∃ a : Fin (localMeshSize n),
      0 ≤ t - localMeshPoint n a ∧
      t - localMeshPoint n a < 2 * localMeshHalfWidth n := by
  let M : ℕ := localMeshSize n
  let x : ℝ := (t + Real.pi * n) * M / (2 * Real.pi * n)
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hM : (0 : ℝ) < M := by exact_mod_cast localMeshSize_pos n
  have hden : 0 < 2 * Real.pi * (n : ℝ) := by positivity
  have hx0 : 0 ≤ x := by
    dsimp [x]
    exact div_nonneg (mul_nonneg (by linarith [ht.1]) hM.le) hden.le
  have hxM : x < M := by
    rw [div_lt_iff₀ hden]
    have ht' : t + Real.pi * n < 2 * Real.pi * n := by
      linarith [ht.2]
    nlinarith
  let a : Fin M := ⟨Nat.floor x, (Nat.floor_lt hx0).2 hxM⟩
  refine ⟨a, ?_, ?_⟩
  · have hfloor := Nat.floor_le hx0
    have hidentity : t - localMeshPoint n a =
        (2 * Real.pi * n / M) * (x - Nat.floor x) := by
      dsimp [a, x, M]
      unfold localMeshPoint
      have hM0 : (localMeshSize n : ℝ) ≠ 0 := by positivity
      field_simp [hM0, hnR.ne', Real.pi_ne_zero]
      ring
    rw [hidentity]
    exact mul_nonneg (by positivity) (sub_nonneg.mpr hfloor)
  · have hfloor := Nat.lt_floor_add_one x
    have hidentity : t - localMeshPoint n a =
        (2 * Real.pi * n / M) * (x - Nat.floor x) := by
      dsimp [a, x, M]
      unfold localMeshPoint
      have hM0 : (localMeshSize n : ℝ) ≠ 0 := by positivity
      field_simp [hM0, hnR.ne', Real.pi_ne_zero]
      ring
    rw [hidentity]
    have hfactor : 0 < 2 * Real.pi * (n : ℝ) / M := by positivity
    have hdiff : x - (Nat.floor x : ℝ) < 1 := by linarith
    calc
      (2 * Real.pi * (n : ℝ) / M) * (x - Nat.floor x) <
          (2 * Real.pi * (n : ℝ) / M) * 1 :=
        mul_lt_mul_of_pos_left hdiff hfactor
      _ = 2 * localMeshHalfWidth n := by
        unfold localMeshHalfWidth
        dsimp [M]
        ring

lemma complexWave_add_period (n : ℕ) (t : ℝ) (j : ℤ) :
    complexWave n (t + 2 * Real.pi * n) j = complexWave n t j := by
  by_cases hn : n = 0
  · subst n
    simp
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  rw [complexWave_time_add]
  have hperiod : complexWave n (2 * Real.pi * n) j = 1 := by
    unfold complexWave
    have harg : ((((j : ℝ) * (2 * Real.pi * n)) / n : ℝ) : ℂ) *
        Complex.I = (((j : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I := by
      push_cast
      field_simp [hnR]
    rw [harg, Complex.exp_ofReal_mul_I]
    have hsin := Real.sin_int_mul_two_pi_sub (0 : ℝ) j
    simp only [sub_zero, Real.sin_zero, neg_zero] at hsin
    rw [Real.cos_int_mul_two_pi, hsin]
    norm_num
  rw [hperiod, mul_one]

lemma rescaledCenteredAcceleration_add_period
    (n : ℕ) (e : SignVector (2 * n)) (t : ℝ) :
    rescaledCenteredAcceleration n e (t + 2 * Real.pi * n) =
      rescaledCenteredAcceleration n e t := by
  unfold rescaledCenteredAcceleration
  congr 1
  apply Finset.sum_congr rfl
  intro j _hj
  congr 1
  have hleft :
      Complex.exp
          ((centeredFrequency n j : ℂ) *
            (((t + 2 * Real.pi * n) / n : ℝ) : ℂ) * Complex.I) =
        complexWave n (t + 2 * Real.pi * n) (centeredIndex n j) := by
    unfold complexWave
    rw [centeredIndex_cast]
    congr 1
    simp only [div_eq_mul_inv, Complex.ofReal_mul, Complex.ofReal_add]
    ring
  have hright :
      Complex.exp
          ((centeredFrequency n j : ℂ) * ((t / n : ℝ) : ℂ) * Complex.I) =
        complexWave n t (centeredIndex n j) := by
    unfold complexWave
    rw [centeredIndex_cast]
    congr 1
    simp only [div_eq_mul_inv, Complex.ofReal_mul]
    ring
  rw [hleft, hright, complexWave_add_period]

lemma norm_rescaledCenteredAcceleration_sub_le
    (n : ℕ) (e : SignVector (2 * n)) (x y : ℝ) :
    ‖rescaledCenteredAcceleration n e y -
        rescaledCenteredAcceleration n e x‖ ≤
      Real.sqrt (2 * n + 1 : ℝ) * |y - x| := by
  by_cases hxy : x ≤ y
  · have hbound := norm_image_sub_le_of_norm_deriv_le_segment'
      (f := rescaledCenteredAcceleration n e)
      (f' := rescaledCenteredJerk n e)
      (a := x) (b := y) (C := Real.sqrt (2 * n + 1 : ℝ))
      (fun t _ht ↦
        (hasDerivAt_rescaledCenteredAcceleration n e t).hasDerivWithinAt)
      (fun t _ht ↦ norm_rescaledCenteredJerk_le n e t)
      y (Set.right_mem_Icc.mpr hxy)
    simpa [abs_of_nonneg (sub_nonneg.mpr hxy)] using hbound
  · have hyx : y ≤ x := le_of_not_ge hxy
    have hbound := norm_image_sub_le_of_norm_deriv_le_segment'
      (f := rescaledCenteredAcceleration n e)
      (f' := rescaledCenteredJerk n e)
      (a := y) (b := x) (C := Real.sqrt (2 * n + 1 : ℝ))
      (fun t _ht ↦
        (hasDerivAt_rescaledCenteredAcceleration n e t).hasDerivWithinAt)
      (fun t _ht ↦ norm_rescaledCenteredJerk_le n e t)
      x (Set.right_mem_Icc.mpr hyx)
    rw [← norm_neg, neg_sub]
    simpa [abs_of_nonpos (sub_nonpos.mpr hyx)] using hbound

noncomputable def globalAccelerationBound (n : ℕ) : ℝ :=
  accelerationCutoff n +
    2 * Real.sqrt (2 * n + 1 : ℝ) * localMeshHalfWidth n

lemma norm_rescaledCenteredAcceleration_le_of_not_high
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (t : ℝ) (ht : t ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n)) :
    ‖rescaledCenteredAcceleration n e t‖ ≤ globalAccelerationBound n := by
  by_cases htop : t = Real.pi * n
  · subst t
    let a : Fin (localMeshSize n) := ⟨0, localMeshSize_pos n⟩
    have ha : ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖ <
        accelerationCutoff n := by
      exact lt_of_not_ge fun hge ↦ hgood ⟨a, hge⟩
    have hpoint : localMeshPoint n a = -(Real.pi * n) := by
      simp [a, localMeshPoint]
    have hperiod := rescaledCenteredAcceleration_add_period n e (-(Real.pi * n))
    have harg : -(Real.pi * n) + 2 * Real.pi * n = Real.pi * n := by ring
    rw [harg] at hperiod
    rw [hpoint] at ha
    rw [hperiod]
    unfold globalAccelerationBound
    have hhalf : 0 ≤ localMeshHalfWidth n := by
      unfold localMeshHalfWidth
      positivity
    exact ha.le.trans (le_add_of_nonneg_right
      (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _)) hhalf))
  · have htIco : t ∈ Set.Ico (-(Real.pi * n)) (Real.pi * n) :=
      ⟨ht.1, lt_of_le_of_ne ht.2 htop⟩
    rcases exists_localMeshPoint_within_step n hn t htIco with
      ⟨a, hdiff0, hdiff⟩
    have ha : ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖ <
        accelerationCutoff n := by
      exact lt_of_not_ge fun hge ↦ hgood ⟨a, hge⟩
    have hsub := norm_rescaledCenteredAcceleration_sub_le
      n e (localMeshPoint n a) t
    rw [abs_of_nonneg hdiff0] at hsub
    have htri : ‖rescaledCenteredAcceleration n e t‖ ≤
        ‖rescaledCenteredAcceleration n e t -
          rescaledCenteredAcceleration n e (localMeshPoint n a)‖ +
        ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖ := by
      have heq : rescaledCenteredAcceleration n e t =
          (rescaledCenteredAcceleration n e t -
            rescaledCenteredAcceleration n e (localMeshPoint n a)) +
          rescaledCenteredAcceleration n e (localMeshPoint n a) := by abel
      calc
        ‖rescaledCenteredAcceleration n e t‖ =
            ‖(rescaledCenteredAcceleration n e t -
              rescaledCenteredAcceleration n e (localMeshPoint n a)) +
              rescaledCenteredAcceleration n e (localMeshPoint n a)‖ :=
          congrArg norm heq
        _ ≤ _ := norm_add_le _ _
    unfold globalAccelerationBound
    have hsqrt : 0 ≤ Real.sqrt (2 * n + 1 : ℝ) := Real.sqrt_nonneg _
    calc
      ‖rescaledCenteredAcceleration n e t‖ ≤
          ‖rescaledCenteredAcceleration n e t -
            rescaledCenteredAcceleration n e (localMeshPoint n a)‖ +
          ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖ := htri
      _ ≤ Real.sqrt (2 * n + 1 : ℝ) *
            (t - localMeshPoint n a) +
          ‖rescaledCenteredAcceleration n e (localMeshPoint n a)‖ :=
        by gcongr
      _ ≤ Real.sqrt (2 * n + 1 : ℝ) *
            (2 * localMeshHalfWidth n) + accelerationCutoff n := by
        exact add_le_add
          (mul_le_mul_of_nonneg_left hdiff.le hsqrt) ha.le
      _ = accelerationCutoff n +
          2 * Real.sqrt (2 * n + 1 : ℝ) * localMeshHalfWidth n := by ring

lemma localMeshPoint_mem_Ico (n : ℕ) (hn : 0 < n)
    (a : Fin (localMeshSize n)) :
    localMeshPoint n a ∈
      Set.Ico (-(Real.pi * n)) (Real.pi * n) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hM : (0 : ℝ) < localMeshSize n := by
    exact_mod_cast localMeshSize_pos n
  constructor
  · unfold localMeshPoint
    have ha0 : (0 : ℝ) ≤ a := by positivity
    have hfactor : 0 ≤ 2 * Real.pi * (n : ℝ) := by positivity
    have := mul_nonneg hfactor ha0
    have hterm : 0 ≤ 2 * Real.pi * (n : ℝ) * (a : ℝ) /
        localMeshSize n := div_nonneg this hM.le
    linarith
  · unfold localMeshPoint
    have ha : (a : ℝ) < localMeshSize n := by exact_mod_cast a.isLt
    have hratio : (a : ℝ) / localMeshSize n < 1 :=
      (div_lt_one hM).2 ha
    have hfactor : 0 < 2 * Real.pi * (n : ℝ) := by positivity
    have hmul := mul_lt_mul_of_pos_left hratio hfactor
    have heq : 2 * Real.pi * (n : ℝ) *
        ((a : ℝ) / localMeshSize n) =
        2 * Real.pi * (n : ℝ) * (a : ℝ) / localMeshSize n := by ring
    rw [heq] at hmul
    nlinarith

lemma norm_taylor_sub_le_of_le_on
    (f f' f'' : ℝ → ℂ) (C x y : ℝ)
    (hxy : x ≤ y)
    (hf : ∀ s, HasDerivAt f (f' s) s)
    (hf' : ∀ s, HasDerivAt f' (f'' s) s)
    (hC : 0 ≤ C) (hbound : ∀ s ∈ Set.Icc x y, ‖f'' s‖ ≤ C) :
    ‖f y - (f x + ((y - x : ℝ) : ℂ) * f' x)‖ ≤ C * (y - x) ^ 2 := by
  have hvel : ∀ s ∈ Set.Icc x y, ‖f' s - f' x‖ ≤ C * (s - x) := by
    exact norm_image_sub_le_of_norm_deriv_le_segment'
      (fun s _hs ↦ (hf' s).hasDerivWithinAt)
      (fun s hs ↦ hbound s ⟨hs.1, hs.2.le⟩)
  let lin : ℝ → ℂ := fun s ↦ ((s - x : ℝ) : ℂ) * f' x
  let g : ℝ → ℂ := f - ((fun _ ↦ f x) + lin)
  have hg : ∀ s ∈ Set.Icc x y,
      HasDerivWithinAt g (f' s - f' x) (Set.Icc x y) s := by
    intro s _hs
    have hlinear : HasDerivAt lin (f' x) s := by
      dsimp only [lin]
      simpa [id_eq] using
        ((hasDerivAt_id s).sub_const x).ofReal_comp.mul_const (f' x)
    have hraw : HasDerivAt g (f' s - f' x) s := by
      have hsum : HasDerivAt ((fun _ ↦ f x) + lin) (f' x) s := by
        simpa using (hasDerivAt_const s (f x)).add hlinear
      exact (hf s).sub hsum
    exact hraw.hasDerivWithinAt
  have hgbound : ∀ s ∈ Set.Ico x y, ‖f' s - f' x‖ ≤ C * (y - x) := by
    intro s hs
    exact (hvel s ⟨hs.1, hs.2.le⟩).trans
      (mul_le_mul_of_nonneg_left (sub_le_sub_right hs.2.le x) hC)
  have hmvt := norm_image_sub_le_of_norm_deriv_le_segment' hg hgbound y
    (Set.right_mem_Icc.mpr hxy)
  simpa [g, lin, pow_two, mul_assoc] using hmvt

lemma norm_taylor_sub_le_of_ge_on
    (f f' f'' : ℝ → ℂ) (C x y : ℝ)
    (hyx : y ≤ x)
    (hf : ∀ s, HasDerivAt f (f' s) s)
    (hf' : ∀ s, HasDerivAt f' (f'' s) s)
    (hC : 0 ≤ C) (hbound : ∀ s ∈ Set.Icc y x, ‖f'' s‖ ≤ C) :
    ‖f y - (f x + ((y - x : ℝ) : ℂ) * f' x)‖ ≤ C * (y - x) ^ 2 := by
  have hvel : ∀ s ∈ Set.Icc y x, ‖f' x - f' s‖ ≤ C * (x - s) := by
    intro s hs
    exact norm_image_sub_le_of_norm_deriv_le_segment'
      (a := s) (b := x)
      (fun r _hr ↦ (hf' r).hasDerivWithinAt)
      (fun r hr ↦ hbound r ⟨hs.1.trans hr.1, hr.2.le⟩)
      x ⟨hs.2, le_rfl⟩
  let lin : ℝ → ℂ := fun s ↦ ((s - x : ℝ) : ℂ) * f' x
  let g : ℝ → ℂ := f - ((fun _ ↦ f x) + lin)
  have hg : ∀ s ∈ Set.Icc y x,
      HasDerivWithinAt g (f' s - f' x) (Set.Icc y x) s := by
    intro s _hs
    have hlinear : HasDerivAt lin (f' x) s := by
      dsimp only [lin]
      simpa [id_eq] using
        ((hasDerivAt_id s).sub_const x).ofReal_comp.mul_const (f' x)
    have hraw : HasDerivAt g (f' s - f' x) s := by
      have hsum : HasDerivAt ((fun _ ↦ f x) + lin) (f' x) s := by
        simpa using (hasDerivAt_const s (f x)).add hlinear
      exact (hf s).sub hsum
    exact hraw.hasDerivWithinAt
  have hgbound : ∀ s ∈ Set.Ico y x, ‖f' s - f' x‖ ≤ C * (x - y) := by
    intro s hs
    rw [← norm_neg, neg_sub]
    exact (hvel s ⟨hs.1, hs.2.le⟩).trans
      (mul_le_mul_of_nonneg_left (sub_le_sub_left hs.1 x) hC)
  have hmvt := norm_image_sub_le_of_norm_deriv_le_segment' hg hgbound x
    (Set.right_mem_Icc.mpr hyx)
  have hgzero : g x = 0 := by simp [g, lin]
  have hnorm : ‖g y‖ ≤ C * (x - y) ^ 2 := by
    simpa [hgzero, norm_neg, pow_two, mul_assoc] using hmvt
  calc
    ‖f y - (f x + ((y - x : ℝ) : ℂ) * f' x)‖ = ‖g y‖ := by
      simp [g, lin]
    _ ≤ C * (x - y) ^ 2 := hnorm
    _ = C * (y - x) ^ 2 := by ring

lemma norm_rescaledCenteredEval_sub_linear_le_of_not_high
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (x y : ℝ)
    (hx : x ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n))
    (hy : y ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n)) :
    ‖rescaledCenteredEval n e y -
        (rescaledCenteredEval n e x + ((y - x : ℝ) : ℂ) *
          rescaledCenteredVelocity n e x)‖ ≤
      globalAccelerationBound n * (y - x) ^ 2 := by
  by_cases hxy : x ≤ y
  · apply norm_taylor_sub_le_of_le_on
      (rescaledCenteredEval n e)
      (rescaledCenteredVelocity n e)
      (rescaledCenteredAcceleration n e)
      (globalAccelerationBound n) x y hxy
      (hasDerivAt_rescaledCenteredEval n e)
      (hasDerivAt_rescaledCenteredVelocity n e)
    · unfold globalAccelerationBound
      exact add_nonneg (rigidityPower_nonneg n _)
        (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
          (by unfold localMeshHalfWidth; positivity))
    · intro t htseg
      apply norm_rescaledCenteredAcceleration_le_of_not_high n hn e hgood
      exact ⟨hx.1.trans htseg.1, htseg.2.trans hy.2⟩
  · have hyx : y ≤ x := le_of_not_ge hxy
    apply norm_taylor_sub_le_of_ge_on
      (rescaledCenteredEval n e)
      (rescaledCenteredVelocity n e)
      (rescaledCenteredAcceleration n e)
      (globalAccelerationBound n) x y hyx
      (hasDerivAt_rescaledCenteredEval n e)
      (hasDerivAt_rescaledCenteredVelocity n e)
    · unfold globalAccelerationBound
      exact add_nonneg (rigidityPower_nonneg n _)
        (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
          (by unfold localMeshHalfWidth; positivity))
    · intro t htseg
      apply norm_rescaledCenteredAcceleration_le_of_not_high n hn e hgood
      exact ⟨hy.1.trans htseg.1, htseg.2.trans hx.2⟩

lemma norm_rescaledCenteredVelocity_sub_le_of_not_high
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (x y : ℝ)
    (hx : x ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n))
    (hy : y ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n)) :
    ‖rescaledCenteredVelocity n e y -
        rescaledCenteredVelocity n e x‖ ≤
      globalAccelerationBound n * |y - x| := by
  by_cases hxy : x ≤ y
  · have hbound := norm_image_sub_le_of_norm_deriv_le_segment'
      (f := rescaledCenteredVelocity n e)
      (f' := rescaledCenteredAcceleration n e)
      (a := x) (b := y) (C := globalAccelerationBound n)
      (fun t _ht ↦
        (hasDerivAt_rescaledCenteredVelocity n e t).hasDerivWithinAt)
      (fun t ht ↦ norm_rescaledCenteredAcceleration_le_of_not_high
        n hn e hgood t ⟨hx.1.trans ht.1, ht.2.le.trans hy.2⟩)
      y (Set.right_mem_Icc.mpr hxy)
    simpa [abs_of_nonneg (sub_nonneg.mpr hxy)] using hbound
  · have hyx : y ≤ x := le_of_not_ge hxy
    have hbound := norm_image_sub_le_of_norm_deriv_le_segment'
      (f := rescaledCenteredVelocity n e)
      (f' := rescaledCenteredAcceleration n e)
      (a := y) (b := x) (C := globalAccelerationBound n)
      (fun t _ht ↦
        (hasDerivAt_rescaledCenteredVelocity n e t).hasDerivWithinAt)
      (fun t ht ↦ norm_rescaledCenteredAcceleration_le_of_not_high
        n hn e hgood t ⟨hy.1.trans ht.1, ht.2.le.trans hx.2⟩)
      x (Set.right_mem_Icc.mpr hyx)
    rw [← norm_neg, neg_sub]
    simpa [abs_of_nonpos (sub_nonpos.mpr hyx)] using hbound

lemma localRepresentative_pair_affine_displacement_bound
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (u velocityLower velocityUpper : ℝ)
    (a b : Fin (localMeshSize n))
    (ha : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
    (hb : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e b) :
    velocityLower *
        |(localMeshPoint n b + localAffineOffset n e b) -
          (localMeshPoint n a + localAffineOffset n e a)| ≤
      2 * (u / n) +
        globalAccelerationBound n *
          (localMeshPoint n b - localMeshPoint n a) ^ 2 +
        localMeshHalfWidth n *
          (globalAccelerationBound n *
            |localMeshPoint n b - localMeshPoint n a|) := by
  let x : ℝ := localMeshPoint n a
  let y : ℝ := localMeshPoint n b
  let sx : ℝ := localAffineOffset n e a
  let sy : ℝ := localAffineOffset n e b
  let X : ℂ := rescaledCenteredEval n e x
  let Y : ℂ := rescaledCenteredEval n e y
  let Bx : ℂ := rescaledCenteredVelocity n e x
  let By : ℂ := rescaledCenteredVelocity n e y
  let Ax : ℂ := X + (sx : ℂ) * Bx
  let Ay : ℂ := Y + (sy : ℂ) * By
  let R : ℂ := Y - (X + ((y - x : ℝ) : ℂ) * Bx)
  let dr : ℝ := (y + sy) - (x + sx)
  have hx : x ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n) :=
    ⟨(localMeshPoint_mem_Ico n hn a).1,
      (localMeshPoint_mem_Ico n hn a).2.le⟩
  have hy : y ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n) :=
    ⟨(localMeshPoint_mem_Ico n hn b).1,
      (localMeshPoint_mem_Ico n hn b).2.le⟩
  have hAx : ‖Ax‖ ≤ u / n := by
    simpa [Ax, X, Bx, sx, x] using ha.1.affine_norm_le hn
  have hAy : ‖Ay‖ ≤ u / n := by
    simpa [Ay, Y, By, sy, y] using hb.1.affine_norm_le hn
  have hR : ‖R‖ ≤ globalAccelerationBound n * (y - x) ^ 2 := by
    simpa [R, X, Y, Bx] using
      norm_rescaledCenteredEval_sub_linear_le_of_not_high
        n hn e hgood x y hx hy
  have hvel : ‖By - Bx‖ ≤
      globalAccelerationBound n * |y - x| := by
    simpa [Bx, By] using
      norm_rescaledCenteredVelocity_sub_le_of_not_high
        n hn e hgood x y hx hy
  have hsy : |sy| ≤ localMeshHalfWidth n := by
    simpa [sy] using hb.1.2.1
  have hBx : velocityLower ≤ ‖Bx‖ := by
    simpa [Bx, x] using ha.2.1
  have hid : Ay - Ax =
      (dr : ℂ) * Bx + R + (sy : ℂ) * (By - Bx) := by
    dsimp [Ay, Ax, dr, R]
    simp only [Complex.ofReal_add, Complex.ofReal_sub]
    ring
  have hdrnorm : |dr| * ‖Bx‖ ≤
      ‖Ay - Ax‖ + ‖R‖ + ‖(sy : ℂ) * (By - Bx)‖ := by
    have hrearrange : (dr : ℂ) * Bx =
        (Ay - Ax) - R - (sy : ℂ) * (By - Bx) := by
      rw [hid]
      abel
    calc
      |dr| * ‖Bx‖ = ‖(dr : ℂ) * Bx‖ := by simp
      _ = ‖(Ay - Ax) - R - (sy : ℂ) * (By - Bx)‖ := by rw [hrearrange]
      _ ≤ ‖(Ay - Ax) - R‖ + ‖(sy : ℂ) * (By - Bx)‖ := norm_sub_le _ _
      _ ≤ (‖Ay - Ax‖ + ‖R‖) + ‖(sy : ℂ) * (By - Bx)‖ := by
        exact add_le_add (norm_sub_le (Ay - Ax) R) le_rfl
  have hleft : velocityLower * |dr| ≤ |dr| * ‖Bx‖ := by
    rw [mul_comm velocityLower]
    exact mul_le_mul_of_nonneg_left hBx (abs_nonneg dr)
  calc
    velocityLower * |dr| ≤ |dr| * ‖Bx‖ := hleft
    _ ≤ ‖Ay - Ax‖ + ‖R‖ + ‖(sy : ℂ) * (By - Bx)‖ := hdrnorm
    _ ≤ (‖Ay‖ + ‖Ax‖) + ‖R‖ +
          (|sy| * ‖By - Bx‖) := by
      gcongr
      · exact norm_sub_le Ay Ax
      · simp
    _ ≤ (u / n + u / n) +
          globalAccelerationBound n * (y - x) ^ 2 +
          (localMeshHalfWidth n *
            (globalAccelerationBound n * |y - x|)) := by
      have hhalf : 0 ≤ localMeshHalfWidth n := by
        unfold localMeshHalfWidth
        positivity
      exact add_le_add
        (add_le_add (add_le_add hAy hAx) hR)
        (mul_le_mul hsy hvel (norm_nonneg _) hhalf)
    _ = 2 * (u / n) +
        globalAccelerationBound n * (y - x) ^ 2 +
        localMeshHalfWidth n *
          (globalAccelerationBound n * |y - x|) := by ring

lemma centerDistance_sub_offsets_le_adjustedDistance
    (x y sx sy h : ℝ) (hsx : |sx| ≤ h) (hsy : |sy| ≤ h) :
    |y - x| - 2 * h ≤ |(y + sy) - (x + sx)| := by
  have hid : y - x = ((y + sy) - (x + sx)) - sy + sx := by ring
  have htri : |y - x| ≤
      |(y + sy) - (x + sx)| + |sy| + |sx| := by
    rw [hid]
    exact (abs_add_le _ _).trans
      (add_le_add (abs_sub ((y + sy) - (x + sx)) sy) le_rfl)
  linarith

lemma localMeshCenterDistance_le_of_two_representatives
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hvelocityLower : 0 < velocityLower)
    (a b : Fin (localMeshSize n))
    (ha : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
    (hb : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e b)
    (hquadratic : globalAccelerationBound n *
      |localMeshPoint n b - localMeshPoint n a| ≤ velocityLower / 4)
    (hcell : globalAccelerationBound n * localMeshHalfWidth n ≤
      velocityLower / 4) :
    |localMeshPoint n b - localMeshPoint n a| ≤
      4 * localMeshHalfWidth n +
        4 * (u / n) / velocityLower := by
  let x : ℝ := localMeshPoint n a
  let y : ℝ := localMeshPoint n b
  let sx : ℝ := localAffineOffset n e a
  let sy : ℝ := localAffineOffset n e b
  let h : ℝ := localMeshHalfWidth n
  let C : ℝ := globalAccelerationBound n
  let d : ℝ := |y - x|
  let q : ℝ := u / n
  have hd : 0 ≤ d := abs_nonneg _
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hC : 0 ≤ C := by
    dsimp [C, globalAccelerationBound]
    exact add_nonneg (rigidityPower_nonneg n _)
      (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
        (by unfold localMeshHalfWidth; positivity))
  have hh : 0 ≤ h := by
    dsimp [h, localMeshHalfWidth]
    positivity
  have hsx : |sx| ≤ h := by
    simpa [sx, h] using ha.1.2.1
  have hsy : |sy| ≤ h := by
    simpa [sy, h] using hb.1.2.1
  have hadjusted : d - 2 * h ≤ |(y + sy) - (x + sx)| := by
    exact centerDistance_sub_offsets_le_adjustedDistance x y sx sy h hsx hsy
  have hpair : velocityLower * |(y + sy) - (x + sx)| ≤
      2 * q + C * d ^ 2 + h * (C * d) := by
    simpa [x, y, sx, sy, h, C, d, q, sq_abs] using
      localRepresentative_pair_affine_displacement_bound
        n hn e hgood u velocityLower velocityUpper a b ha hb
  have hleft : velocityLower * (d - 2 * h) ≤
      velocityLower * |(y + sy) - (x + sx)| :=
    mul_le_mul_of_nonneg_left hadjusted hvelocityLower.le
  have hquad : C * d ≤ velocityLower / 4 := by
    simpa [C, d, x, y] using hquadratic
  have hcell' : C * h ≤ velocityLower / 4 := by
    simpa [C, h, mul_comm] using hcell
  have hquadTerm : C * d ^ 2 ≤ velocityLower / 4 * d := by
    calc
      C * d ^ 2 = (C * d) * d := by ring
      _ ≤ (velocityLower / 4) * d :=
        mul_le_mul_of_nonneg_right hquad hd
  have hcellTerm : h * (C * d) ≤ velocityLower / 4 * d := by
    calc
      h * (C * d) = (C * h) * d := by ring
      _ ≤ (velocityLower / 4) * d :=
        mul_le_mul_of_nonneg_right hcell' hd
  have hmul : velocityLower * d ≤
      4 * velocityLower * h + 4 * q := by
    nlinarith [hleft.trans hpair]
  calc
    d = (velocityLower * d) / velocityLower := by field_simp
    _ ≤ (4 * velocityLower * h + 4 * q) / velocityLower :=
      div_le_div_of_nonneg_right hmul hvelocityLower.le
    _ = 4 * h + 4 * q / velocityLower := by field_simp

lemma affineClosestOffset_real_projection_zero
    (a b : ℂ) (hb : b ≠ 0) :
    ((a + (affineClosestOffset a b : ℂ) * b) * conj b).re = 0 := by
  have hnorm : Complex.normSq b ≠ 0 :=
    Complex.normSq_eq_zero.not.mpr hb
  have hformula : ∀ t : ℝ,
      ((a + (t : ℂ) * b) * conj b).re =
        (a * conj b).re + t * Complex.normSq b := by
    intro t
    rw [add_mul, Complex.add_re, mul_assoc]
    simp [Complex.normSq_apply]
  rw [hformula, affineClosestOffset]
  field_simp
  ring

lemma localRepresentative_pair_affine_location_bound
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hvelocityLower : 0 ≤ velocityLower)
    (hvelocityUpper : 0 ≤ velocityUpper)
    (a b : Fin (localMeshSize n))
    (ha : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
    (hb : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e b) :
    velocityLower ^ 2 *
        |(localMeshPoint n b + localAffineOffset n e b) -
          (localMeshPoint n a + localAffineOffset n e a)| ≤
      (u / n) *
          (globalAccelerationBound n *
            |localMeshPoint n b - localMeshPoint n a|) +
        (globalAccelerationBound n *
            (localMeshPoint n b - localMeshPoint n a) ^ 2) *
          velocityUpper +
        localMeshHalfWidth n *
          (globalAccelerationBound n *
            |localMeshPoint n b - localMeshPoint n a|) *
          velocityUpper := by
  let x : ℝ := localMeshPoint n a
  let y : ℝ := localMeshPoint n b
  let sx : ℝ := localAffineOffset n e a
  let sy : ℝ := localAffineOffset n e b
  let X : ℂ := rescaledCenteredEval n e x
  let Y : ℂ := rescaledCenteredEval n e y
  let Bx : ℂ := rescaledCenteredVelocity n e x
  let By : ℂ := rescaledCenteredVelocity n e y
  let Ax : ℂ := X + (sx : ℂ) * Bx
  let Ay : ℂ := Y + (sy : ℂ) * By
  let R : ℂ := Y - (X + ((y - x : ℝ) : ℂ) * Bx)
  let dr : ℝ := (y + sy) - (x + sx)
  have hx : x ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n) :=
    ⟨(localMeshPoint_mem_Ico n hn a).1,
      (localMeshPoint_mem_Ico n hn a).2.le⟩
  have hy : y ∈ Set.Icc (-(Real.pi * n)) (Real.pi * n) :=
    ⟨(localMeshPoint_mem_Ico n hn b).1,
      (localMeshPoint_mem_Ico n hn b).2.le⟩
  have hAx : ‖Ax‖ ≤ u / n := by
    simpa [Ax, X, Bx, sx, x] using ha.1.affine_norm_le hn
  have hAy : ‖Ay‖ ≤ u / n := by
    simpa [Ay, Y, By, sy, y] using hb.1.affine_norm_le hn
  have hR : ‖R‖ ≤ globalAccelerationBound n * (y - x) ^ 2 := by
    simpa [R, X, Y, Bx] using
      norm_rescaledCenteredEval_sub_linear_le_of_not_high
        n hn e hgood x y hx hy
  have hvel : ‖By - Bx‖ ≤
      globalAccelerationBound n * |y - x| := by
    simpa [Bx, By] using
      norm_rescaledCenteredVelocity_sub_le_of_not_high
        n hn e hgood x y hx hy
  have hsy : |sy| ≤ localMeshHalfWidth n := by
    simpa [sy] using hb.1.2.1
  have hBxLower : velocityLower ≤ ‖Bx‖ := by
    simpa [Bx, x] using ha.2.1
  have hBxUpper : ‖Bx‖ ≤ velocityUpper := by
    simpa [Bx, x] using ha.2.2
  have hBx : Bx ≠ 0 := by
    simpa [Bx, x] using ha.1.1
  have hBy : By ≠ 0 := by
    simpa [By, y] using hb.1.1
  have hAxOrth : (Ax * conj Bx).re = 0 := by
    simpa [Ax, X, Bx, sx, x, localAffineOffset] using
      affineClosestOffset_real_projection_zero X Bx hBx
  have hAyOrth : (Ay * conj By).re = 0 := by
    simpa [Ay, Y, By, sy, y, localAffineOffset] using
      affineClosestOffset_real_projection_zero Y By hBy
  have hid : Ay - Ax =
      (dr : ℂ) * Bx + R + (sy : ℂ) * (By - Bx) := by
    dsimp [Ay, Ax, dr, R]
    simp only [Complex.ofReal_add, Complex.ofReal_sub]
    ring
  have hprojection : dr * Complex.normSq Bx =
      (Ay * conj (Bx - By)).re - (R * conj Bx).re -
        (((sy : ℂ) * (By - Bx)) * conj Bx).re := by
    have hrearrange : (dr : ℂ) * Bx =
        (Ay - Ax) - R - (sy : ℂ) * (By - Bx) := by
      rw [hid]
      abel
    have hAyRewrite : (Ay * conj Bx).re =
        (Ay * conj (Bx - By)).re := by
      have hc : conj Bx = conj (Bx - By) + conj By := by
        rw [map_sub]
        ring
      rw [hc, mul_add, Complex.add_re, hAyOrth, add_zero]
    calc
      dr * Complex.normSq Bx = (((dr : ℂ) * Bx) * conj Bx).re := by
        simp [Complex.normSq_apply]
        ring
      _ = (((Ay - Ax) - R - (sy : ℂ) * (By - Bx)) * conj Bx).re := by
        rw [hrearrange]
      _ = (Ay * conj (Bx - By)).re - (R * conj Bx).re -
          (((sy : ℂ) * (By - Bx)) * conj Bx).re := by
        simp only [sub_mul, Complex.sub_re, map_sub]
        rw [hAyRewrite, hAxOrth]
        rw [map_sub, mul_sub, Complex.sub_re]
        ring
  have hprojectionAbs : |dr| * ‖Bx‖ ^ 2 ≤
      ‖Ay‖ * ‖By - Bx‖ + ‖R‖ * ‖Bx‖ +
        |sy| * ‖By - Bx‖ * ‖Bx‖ := by
    have habs := congrArg abs hprojection
    rw [abs_mul, abs_of_nonneg (Complex.normSq_nonneg Bx),
      Complex.normSq_eq_norm_sq] at habs
    rw [habs]
    calc
      |(Ay * conj (Bx - By)).re - (R * conj Bx).re -
          (((sy : ℂ) * (By - Bx)) * conj Bx).re| ≤
        |(Ay * conj (Bx - By)).re| + |(R * conj Bx).re| +
          |(((sy : ℂ) * (By - Bx)) * conj Bx).re| := by
        exact (abs_sub _ _).trans
          (add_le_add (abs_sub _ _) le_rfl)
      _ ≤ ‖Ay * conj (Bx - By)‖ + ‖R * conj Bx‖ +
          ‖((sy : ℂ) * (By - Bx)) * conj Bx‖ := by
        gcongr <;> exact Complex.abs_re_le_norm _
      _ = ‖Ay‖ * ‖By - Bx‖ + ‖R‖ * ‖Bx‖ +
          |sy| * ‖By - Bx‖ * ‖Bx‖ := by
        simp only [norm_mul, Complex.norm_conj, Complex.norm_real,
          Real.norm_eq_abs]
        rw [norm_sub_rev Bx By]
  have hleft : velocityLower ^ 2 * |dr| ≤ |dr| * ‖Bx‖ ^ 2 := by
    have hsquare : velocityLower ^ 2 ≤ ‖Bx‖ ^ 2 := by
      exact (sq_le_sq₀ hvelocityLower (norm_nonneg Bx)).2 hBxLower
    nlinarith [abs_nonneg dr]
  calc
    velocityLower ^ 2 * |dr| ≤ |dr| * ‖Bx‖ ^ 2 := hleft
    _ ≤ ‖Ay‖ * ‖By - Bx‖ + ‖R‖ * ‖Bx‖ +
          |sy| * ‖By - Bx‖ * ‖Bx‖ := hprojectionAbs
    _ ≤ (u / n) * (globalAccelerationBound n * |y - x|) +
          (globalAccelerationBound n * (y - x) ^ 2) * velocityUpper +
          localMeshHalfWidth n *
            (globalAccelerationBound n * |y - x|) * velocityUpper := by
      have hnR : (0 : ℝ) ≤ n := by positivity
      have hC : 0 ≤ globalAccelerationBound n := by
        unfold globalAccelerationBound
        exact add_nonneg (rigidityPower_nonneg n _)
          (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
            (by unfold localMeshHalfWidth; positivity))
      have hhalf : 0 ≤ localMeshHalfWidth n := by
        unfold localMeshHalfWidth
        positivity
      exact add_le_add
        (add_le_add
          (mul_le_mul hAy hvel (norm_nonneg _) (div_nonneg hu hnR))
          (mul_le_mul hR hBxUpper (norm_nonneg _) (mul_nonneg hC (sq_nonneg _))))
        (mul_le_mul
          (mul_le_mul hsy hvel (norm_nonneg _)
            hhalf)
          hBxUpper (norm_nonneg _) (mul_nonneg hhalf
            (mul_nonneg hC (abs_nonneg _))))

lemma localMeshPoint_sub_eq
    (n : ℕ) (a b : Fin (localMeshSize n)) :
    localMeshPoint n b - localMeshPoint n a =
      2 * localMeshHalfWidth n * ((b : ℝ) - (a : ℝ)) := by
  unfold localMeshPoint localMeshHalfWidth
  ring

lemma localMeshPoint_sub_eq_two_halfWidth_of_succ
    (n : ℕ) (a b : Fin (localMeshSize n))
    (hab : b.val = a.val + 1) :
    localMeshPoint n b - localMeshPoint n a =
      2 * localMeshHalfWidth n := by
  rw [localMeshPoint_sub_eq]
  have hcast : (b : ℝ) - (a : ℝ) = 1 := by
    have habR : (b : ℝ) = (a : ℝ) + 1 := by exact_mod_cast hab
    linarith
  rw [hcast, mul_one]

noncomputable def adjacentAffineLocationError
    (n : ℕ) (u velocityLower velocityUpper : ℝ) : ℝ :=
  ((u / n) *
      (globalAccelerationBound n * (2 * localMeshHalfWidth n)) +
    (globalAccelerationBound n * (2 * localMeshHalfWidth n) ^ 2) *
      velocityUpper +
    localMeshHalfWidth n *
      (globalAccelerationBound n * (2 * localMeshHalfWidth n)) *
      velocityUpper) / velocityLower ^ 2

lemma adjacentRepresentatives_affine_locations_close
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hvelocityLower : 0 < velocityLower)
    (hvelocityUpper : 0 ≤ velocityUpper)
    (a b : Fin (localMeshSize n)) (hab : b.val = a.val + 1)
    (ha : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
    (hb : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e b) :
    |(localMeshPoint n b + localAffineOffset n e b) -
        (localMeshPoint n a + localAffineOffset n e a)| ≤
      adjacentAffineLocationError n u velocityLower velocityUpper := by
  have hbound := localRepresentative_pair_affine_location_bound
    n hn e hgood u velocityLower velocityUpper hu hvelocityLower.le
      hvelocityUpper a b ha hb
  rw [localMeshPoint_sub_eq_two_halfWidth_of_succ n a b hab] at hbound
  have hsq : velocityLower ^ 2 > 0 := sq_pos_of_pos hvelocityLower
  have htwo : 0 ≤ 2 * localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    positivity
  rw [abs_of_nonneg htwo] at hbound
  unfold adjacentAffineLocationError
  exact (le_div_iff₀ hsq).2 (by
    simpa only [mul_comm, mul_left_comm, mul_assoc] using hbound)

lemma adjacentRepresentatives_offsets_near_boundary
    (n : ℕ) (hn : 0 < n) (e : SignVector (2 * n))
    (hgood : ¬HasHighMeshAcceleration n e)
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 ≤ u) (hvelocityLower : 0 < velocityLower)
    (hvelocityUpper : 0 ≤ velocityUpper)
    (a b : Fin (localMeshSize n)) (hab : b.val = a.val + 1)
    (ha : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
    (hb : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e b) :
    localMeshHalfWidth n - localAffineOffset n e a ≤
        adjacentAffineLocationError n u velocityLower velocityUpper ∧
      localMeshHalfWidth n + localAffineOffset n e b ≤
        adjacentAffineLocationError n u velocityLower velocityUpper := by
  let h : ℝ := localMeshHalfWidth n
  let sx : ℝ := localAffineOffset n e a
  let sy : ℝ := localAffineOffset n e b
  have hsx : |sx| ≤ h := by simpa [sx, h] using ha.1.2.1
  have hsy : |sy| ≤ h := by simpa [sy, h] using hb.1.2.1
  have hloc := adjacentRepresentatives_affine_locations_close
    n hn e hgood u velocityLower velocityUpper hu hvelocityLower
      hvelocityUpper a b hab ha hb
  have hid :
      (localMeshPoint n b + localAffineOffset n e b) -
          (localMeshPoint n a + localAffineOffset n e a) =
        (h - sx) + (h + sy) := by
    dsimp [h, sx, sy]
    have hcenter := localMeshPoint_sub_eq_two_halfWidth_of_succ n a b hab
    linarith
  have hfirst : 0 ≤ h - sx := by rw [sub_nonneg]; exact (le_abs_self sx).trans hsx
  have hsecond : 0 ≤ h + sy := by rw [← neg_le_iff_add_nonneg]; exact (neg_le_abs sy).trans hsy
  rw [hid, abs_of_nonneg (add_nonneg hfirst hsecond)] at hloc
  exact ⟨(le_add_of_nonneg_right hsecond).trans hloc,
    (le_add_of_nonneg_left hfirst).trans hloc⟩

lemma accelerationCutoff_div_tendsto_zero :
    Tendsto (fun n : ℕ ↦ accelerationCutoff n / (n : ℝ))
      atTop (𝓝 0) := by
  have h := tendsto_rigidityPower_neg_zero
    (show (0 : ℝ) < 7 / 8 by norm_num)
  apply h.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  unfold accelerationCutoff
  have hadd := rigidityPower_add hn (1 / 8) (-1)
  have hone : rigidityPower n (-1) = ((n : ℝ))⁻¹ := by
    unfold rigidityPower
    rw [Real.rpow_neg_one]
  rw [show (-(7 / 8) : ℝ) = 1 / 8 + (-1) by norm_num, hadd, hone]
  ring

lemma globalAccelerationBound_div_tendsto_zero :
    Tendsto (fun n : ℕ ↦ globalAccelerationBound n / (n : ℝ))
      atTop (𝓝 0) := by
  have hsqrtH : Tendsto (fun n : ℕ ↦
      Real.sqrt (2 * n + 1 : ℝ) / n) atTop (𝓝 0) :=
    sqrt_centeredCount_div_tendsto_zero
  have hsecond := (hsqrtH.mul localMeshHalfWidth_tendsto_zero).const_mul 2
  have hsum := accelerationCutoff_div_tendsto_zero.add hsecond
  have hsum' : Tendsto (fun n : ℕ ↦
      accelerationCutoff n / (n : ℝ) +
        2 * (Real.sqrt (2 * n + 1 : ℝ) / n * localMeshHalfWidth n))
      atTop (𝓝 0) := by simpa using hsum
  apply hsum'.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  unfold globalAccelerationBound
  field_simp

lemma localMeshTaylorError_tendsto_zero :
    Tendsto localMeshTaylorError atTop (𝓝 0) := by
  have hinv : Tendsto (fun n : ℕ ↦ ((n : ℝ))⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
  have h := scaled_localMeshTaylorError_tendsto_zero.mul hinv
  have h' : Tendsto (fun n : ℕ ↦
      ((n : ℝ) * localMeshTaylorError n) * ((n : ℝ))⁻¹)
      atTop (𝓝 0) := by simpa using h
  apply h'.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  field_simp

lemma globalAccelerationBound_mul_halfWidth_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      globalAccelerationBound n * localMeshHalfWidth n)
      atTop (𝓝 0) := by
  have hfirst := accelerationCutoff_div_tendsto_zero.mul
    scaled_localMeshHalfWidth_tendsto_pi
  have hsecond := localMeshTaylorError_tendsto_zero.const_mul 2
  have hsum := hfirst.add hsecond
  have hsum' : Tendsto (fun n : ℕ ↦
      accelerationCutoff n / (n : ℝ) *
          ((n : ℝ) * localMeshHalfWidth n) +
        2 * localMeshTaylorError n) atTop (𝓝 0) := by
    simpa using hsum
  apply hsum'.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold globalAccelerationBound localMeshTaylorError
  field_simp

theorem adjacentAffineLocationError_relative_tendsto_zero
    (u velocityLower velocityUpper : ℝ) (hvelocityLower : velocityLower ≠ 0) :
    Tendsto (fun n : ℕ ↦
      adjacentAffineLocationError n u velocityLower velocityUpper /
        localMeshHalfWidth n) atTop (𝓝 0) := by
  let reference : ℕ → ℝ := fun n ↦
    (2 * u * (globalAccelerationBound n / (n : ℝ)) +
      6 * velocityUpper *
        (globalAccelerationBound n * localMeshHalfWidth n)) /
      velocityLower ^ 2
  have href : Tendsto reference atTop (𝓝 0) := by
    have hnum :=
      (globalAccelerationBound_div_tendsto_zero.const_mul (2 * u)).add
        (globalAccelerationBound_mul_halfWidth_tendsto_zero.const_mul
          (6 * velocityUpper))
    have hdiv := hnum.div_const (velocityLower ^ 2)
    simpa [reference] using hdiv
  apply href.congr'
  filter_upwards [Nat.eventually_pos] with n hn
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hh : localMeshHalfWidth n ≠ 0 := by
    unfold localMeshHalfWidth
    exact div_ne_zero (mul_ne_zero Real.pi_ne_zero (by exact_mod_cast hn.ne'))
      (by exact_mod_cast (localMeshSize_pos n).ne')
  dsimp [reference]
  unfold adjacentAffineLocationError
  field_simp
  ring

lemma eventually_thickening_factoredTruncatedMeshRegion_subset_expanded
    (m : ℕ) (widthFactor u velocityLower velocityUpper eps : ℝ)
    (hfactor : 0 ≤ widthFactor) (hu : 0 ≤ u)
    (hvelLower : 0 < velocityLower) (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop,
      Metric.thickening (phaseBoundaryRadius n)
          (truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n)
            velocityLower velocityUpper) ⊆
        truncatedPhaseRegion (m := m) n (u + eps)
          ((widthFactor + eps) * localMeshHalfWidth n)
          (velocityLower - eps) (velocityUpper + eps) := by
  have hrSmall : ∀ᶠ n : ℕ in atTop, phaseBoundaryRadius n < eps :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds heps)
  have hrLower : ∀ᶠ n : ℕ in atTop,
      phaseBoundaryRadius n < velocityLower :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds hvelLower)
  have hheight : ∀ᶠ n : ℕ in atTop,
      (n : ℝ) * blockOuterPerturbationError n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper (phaseBoundaryRadius n) < eps :=
    (blockOuterPerturbationError_scaled_factor_tendsto_zero
      widthFactor u velocityLower velocityUpper hvelLower).eventually
        (Iio_mem_nhds heps)
  have hwidth : ∀ᶠ n : ℕ in atTop,
      (blockOuterHalfWidth n u (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n) -
        widthFactor * localMeshHalfWidth n) / localMeshHalfWidth n < eps :=
    (blockOuterHalfWidth_meshError_factor_tendsto_zero
      widthFactor u velocityLower velocityUpper hvelLower).eventually
        (Iio_mem_nhds heps)
  filter_upwards [Nat.eventually_pos, hrSmall, hrLower, hheight, hwidth]
    with n hn hrEps hrEta hheightN hwidthN
  have hhalfPos : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos (by exact_mod_cast hn)) (by
      exact_mod_cast localMeshSize_pos n)
  have hbaseHalf : 0 ≤ widthFactor * localMeshHalfWidth n :=
    mul_nonneg hfactor hhalfPos.le
  have houterHeight :
      blockOuterHeight n u (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n) ≤ u + eps := by
    unfold blockOuterHeight
    linarith
  have houterWidth :
      blockOuterHalfWidth n u (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper (phaseBoundaryRadius n) ≤
        (widthFactor + eps) * localMeshHalfWidth n := by
    have hdiff :
        blockOuterHalfWidth n u (widthFactor * localMeshHalfWidth n)
              velocityLower velocityUpper (phaseBoundaryRadius n) -
            widthFactor * localMeshHalfWidth n <
          eps * localMeshHalfWidth n :=
      (div_lt_iff₀ hhalfPos).mp hwidthN
    linarith
  exact (thickening_truncatedPhaseRegion_subset_outer m n hn u
    (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper
    (phaseBoundaryRadius n) hu hbaseHalf (phaseBoundaryRadius_nonneg n)
    hrEta).trans
      (truncatedPhaseRegion_mono m n hn houterHeight houterWidth
        (by linarith) (by linarith))

lemma eventually_thickening_factoredShrunkMeshRegion_subset
    (m : ℕ) (widthFactor u velocityLower velocityUpper eps : ℝ)
    (heps : 0 < eps) (hepsFactor : eps < widthFactor)
    (hepsU : eps < u) (hvelLower : 0 < velocityLower)
    (hepsUpper : eps < velocityUpper) :
    ∀ᶠ n : ℕ in atTop,
      Metric.thickening (phaseBoundaryRadius n)
          (truncatedPhaseRegion (m := m) n (u - eps)
            ((widthFactor - eps) * localMeshHalfWidth n)
            (velocityLower + eps) (velocityUpper - eps)) ⊆
        truncatedPhaseRegion (m := m) n u
          (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper := by
  have hlowerPos : 0 < velocityLower + eps := by linarith
  have hrSmall : ∀ᶠ n : ℕ in atTop, phaseBoundaryRadius n < eps :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds heps)
  have hrLower : ∀ᶠ n : ℕ in atTop,
      phaseBoundaryRadius n < velocityLower + eps :=
    phaseBoundaryRadius_tendsto_zero.eventually (Iio_mem_nhds hlowerPos)
  have hheight : ∀ᶠ n : ℕ in atTop,
      (n : ℝ) * blockOuterPerturbationError n (u - eps)
        ((widthFactor - eps) * localMeshHalfWidth n) (velocityLower + eps)
        (velocityUpper - eps) (phaseBoundaryRadius n) < eps :=
    (blockOuterPerturbationError_scaled_factor_tendsto_zero
      (widthFactor - eps) (u - eps) (velocityLower + eps)
      (velocityUpper - eps) hlowerPos).eventually (Iio_mem_nhds heps)
  have hwidth : ∀ᶠ n : ℕ in atTop,
      (blockOuterHalfWidth n (u - eps)
          ((widthFactor - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) -
        (widthFactor - eps) * localMeshHalfWidth n) /
          localMeshHalfWidth n < eps :=
    (blockOuterHalfWidth_meshError_factor_tendsto_zero
      (widthFactor - eps) (u - eps) (velocityLower + eps)
      (velocityUpper - eps) hlowerPos).eventually (Iio_mem_nhds heps)
  filter_upwards [Nat.eventually_pos, hrSmall, hrLower, hheight, hwidth]
    with n hn hrEps hrLowerN hheightN hwidthN
  have hhalfPos : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos (by exact_mod_cast hn)) (by
      exact_mod_cast localMeshSize_pos n)
  have hbaseHalf : 0 ≤ (widthFactor - eps) * localMeshHalfWidth n :=
    mul_nonneg (sub_nonneg.mpr hepsFactor.le) hhalfPos.le
  have houterHeight :
      blockOuterHeight n (u - eps)
          ((widthFactor - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) ≤
        u := by
    unfold blockOuterHeight
    linarith
  have houterWidth :
      blockOuterHalfWidth n (u - eps)
          ((widthFactor - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) (phaseBoundaryRadius n) ≤
        widthFactor * localMeshHalfWidth n := by
    have hdiff :
        blockOuterHalfWidth n (u - eps)
              ((widthFactor - eps) * localMeshHalfWidth n)
              (velocityLower + eps) (velocityUpper - eps)
              (phaseBoundaryRadius n) -
            (widthFactor - eps) * localMeshHalfWidth n <
          eps * localMeshHalfWidth n :=
      (div_lt_iff₀ hhalfPos).mp hwidthN
    linarith
  exact (thickening_truncatedPhaseRegion_subset_outer m n hn (u - eps)
    ((widthFactor - eps) * localMeshHalfWidth n) (velocityLower + eps)
    (velocityUpper - eps) (phaseBoundaryRadius n) (sub_nonneg.mpr hepsU.le)
    hbaseHalf (phaseBoundaryRadius_nonneg n) hrLowerN).trans
      (truncatedPhaseRegion_mono m n hn houterHeight houterWidth
        (by linarith) (by linarith))

lemma eventually_factoredShrunkMeshRegion_subset_innerErosion
    (m : ℕ) (widthFactor u velocityLower velocityUpper eps : ℝ)
    (heps : 0 < eps) (hepsFactor : eps < widthFactor)
    (hepsU : eps < u) (hvelLower : 0 < velocityLower)
    (hepsUpper : eps < velocityUpper) :
    ∀ᶠ n : ℕ in atTop,
      truncatedPhaseRegion (m := m) n (u - eps)
          ((widthFactor - eps) * localMeshHalfWidth n)
          (velocityLower + eps) (velocityUpper - eps) ⊆
        (Metric.thickening (phaseBoundaryRadius n)
          (truncatedPhaseRegion (m := m) n u
            (widthFactor * localMeshHalfWidth n)
            velocityLower velocityUpper)ᶜ)ᶜ := by
  filter_upwards [eventually_thickening_factoredShrunkMeshRegion_subset
    m widthFactor u velocityLower velocityUpper eps heps hepsFactor hepsU
      hvelLower hepsUpper] with n hsubset
  intro x hx hxin
  rw [Metric.mem_thickening_iff] at hxin
  rcases hxin with ⟨y, hy, hyx⟩
  have hnear : y ∈ Metric.thickening (phaseBoundaryRadius n)
      (truncatedPhaseRegion (m := m) n (u - eps)
        ((widthFactor - eps) * localMeshHalfWidth n)
        (velocityLower + eps) (velocityUpper - eps)) := by
    rw [Metric.mem_thickening_iff]
    exact ⟨x, hx, by simpa [dist_comm] using hyx⟩
  exact hy (hsubset hnear)

noncomputable def factoredTruncatedPhaseProbability
    (m n : ℕ) (points : Fin m → ℝ)
    (widthFactor u velocityLower velocityUpper : ℝ) : ℝ :=
  uniformProbability (fun e : SignVector (2 * n) ↦
    normalizedPhaseEuclideanWalk n e points ∈
      truncatedPhaseRegion (m := m) n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper)

theorem eventually_uniform_scaled_factoredTruncatedPhaseProbability_bracket
    (m : ℕ) (hm : 0 < m)
    (widthFactor u velocityLower velocityUpper eta tol : ℝ)
    (hu : 0 ≤ u) (hvelLower : 0 < velocityLower)
    (heta : 0 < eta) (hetaFactor : eta < widthFactor)
    (hetaU : eta < u) (hetaLower : eta < velocityLower)
    (hetaUpper : eta < velocityUpper) (htol : 0 < tol) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      ((widthFactor - eta) * ((12 * (u - eta) / Real.pi) *
          blockVelocityMass (velocityLower + eta) (velocityUpper - eta))) ^ m - tol <
        (localMeshSize n : ℝ) ^ m *
          factoredTruncatedPhaseProbability m n points widthFactor u
            velocityLower velocityUpper ∧
      (localMeshSize n : ℝ) ^ m *
          factoredTruncatedPhaseProbability m n points widthFactor u
            velocityLower velocityUpper <
        ((widthFactor + eta) * ((12 * (u + eta) / Real.pi) *
          blockVelocityMass (velocityLower - eta) (velocityUpper + eta))) ^ m + tol := by
  let Aminus : ℝ := ((widthFactor - eta) * ((12 * (u - eta) / Real.pi) *
    blockVelocityMass (velocityLower + eta) (velocityUpper - eta))) ^ m
  let Aplus : ℝ := ((widthFactor + eta) * ((12 * (u + eta) / Real.pi) *
    blockVelocityMass (velocityLower - eta) (velocityUpper + eta))) ^ m
  have htolHalf : 0 < tol / 2 := by linarith
  have hmassMinus :=
    eventually_uniform_scaled_smoothed_truncatedPhaseFactorMass
      m hm (widthFactor - eta) (u - eta) (velocityLower + eta)
      (velocityUpper - eta) (sub_nonneg.mpr hetaFactor.le)
      (sub_nonneg.mpr hetaU.le) (by linarith) (by linarith) htolHalf
  have hmassPlus :=
    eventually_uniform_scaled_smoothed_truncatedPhaseFactorMass
      m hm (widthFactor + eta) (u + eta) (velocityLower - eta)
      (velocityUpper + eta) (by linarith) (by linarith) (by linarith)
      (by linarith) htolHalf
  have htail : ∀ᶠ n : ℕ in atTop,
      (localMeshSize n : ℝ) ^ m * phaseBoundaryGaussianTail m n < tol / 2 :=
    (scaled_phaseBoundaryGaussianTail_tendsto_zero m).eventually
      (Iio_mem_nhds htolHalf)
  filter_upwards [Nat.eventually_pos,
      eventually_thickening_factoredTruncatedMeshRegion_subset_expanded
        m widthFactor u velocityLower velocityUpper eta
        (le_trans heta.le hetaFactor.le) hu hvelLower heta,
      eventually_factoredShrunkMeshRegion_subset_innerErosion
        m widthFactor u velocityLower velocityUpper eta heta hetaFactor hetaU
          hvelLower hetaUpper,
      hmassMinus, hmassPlus, htail]
    with n hn houter hinner hmassMinusN hmassPlusN htailN
  intro points hsmooth hspread
  let q : ℝ := (localMeshSize n : ℝ) ^ m
  let p : ℝ := factoredTruncatedPhaseProbability m n points widthFactor u
    velocityLower velocityUpper
  let tail : ℝ := phaseBoundaryGaussianTail m n
  let target := truncatedPhaseRegion (m := m) n u
    (widthFactor * localMeshHalfWidth n) velocityLower velocityUpper
  let expanded := truncatedPhaseRegion (m := m) n (u + eta)
    ((widthFactor + eta) * localMeshHalfWidth n)
    (velocityLower - eta) (velocityUpper + eta)
  let shrunk := truncatedPhaseRegion (m := m) n (u - eta)
    ((widthFactor - eta) * localMeshHalfWidth n)
    (velocityLower + eta) (velocityUpper - eta)
  have hsigma : 0 < localCLTSmoothingScaleTest n := by
    unfold localCLTSmoothingScaleTest
    exact rigidityPower_pos hn _
  have hq : 0 ≤ q := by dsimp [q]; positivity
  have htail0 : 0 ≤ tail := by
    dsimp [tail, phaseBoundaryGaussianTail]
    positivity
  have hp0 : 0 ≤ p := by
    dsimp [p, factoredTruncatedPhaseProbability]
    exact uniformProbability_nonneg _
  have hp1 : p ≤ 1 := by
    dsimp [p, factoredTruncatedPhaseProbability]
    exact uniformProbability_le_one _
  have hInt := integrable_phaseSmoothedDensity m n points
    (localCLTSmoothingScaleTest n) hsigma
  have hnonneg : ∀ y : PhaseEuclidean m,
      0 ≤ phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y :=
    phaseSmoothedDensity_nonneg m n points (localCLTSmoothingScaleTest n)
  have houterIntegral :
      (∫ y in Metric.thickening (phaseBoundaryRadius n) target,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        ∫ y in expanded,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y := by
    exact setIntegral_mono_set hInt.integrableOn (Eventually.of_forall hnonneg)
      (Eventually.of_forall fun x hx ↦ by
        change x ∈ expanded
        apply houter
        change x ∈ Metric.thickening (phaseBoundaryRadius n) target
        exact hx)
  have hupperSandwich :=
    uniformProbability_mul_gaussianLower_le_integral_thickening
      n points (localCLTSmoothingScaleTest n) (phaseBoundaryRadius n)
      hsigma (phaseBoundaryRadius_nonneg n) target
  have hupperRaw : p * (1 - tail) ≤
      ∫ y in expanded,
        phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y := by
    apply hupperSandwich.trans houterIntegral
  have hupperScaled : q * p ≤
      q * (∫ y in expanded,
        phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) + q * tail := by
    have hmain := mul_le_mul_of_nonneg_left hupperRaw hq
    have hpt : q * p * tail ≤ q * tail := by
      have hpTail := mul_le_mul_of_nonneg_right hp1 htail0
      nlinarith
    nlinarith
  have hinnerIntegral :
      (∫ y in shrunk,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        ∫ y in (Metric.thickening (phaseBoundaryRadius n) targetᶜ)ᶜ,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y := by
    exact setIntegral_mono_set hInt.integrableOn (Eventually.of_forall hnonneg)
      (Eventually.of_forall fun x hx ↦ by
        change x ∈ (Metric.thickening (phaseBoundaryRadius n) targetᶜ)ᶜ
        apply hinner
        change x ∈ shrunk
        exact hx)
  have hlowerSandwich := integral_innerErosion_phaseSmoothedDensity_le
    n points (localCLTSmoothingScaleTest n) (phaseBoundaryRadius n)
    hsigma (phaseBoundaryRadius_nonneg n) target
  have hlowerRaw :
      (∫ y in shrunk,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        p + tail := by
    exact hinnerIntegral.trans (by
      simpa only [p, tail, target, factoredTruncatedPhaseProbability,
        phaseBoundaryGaussianTail] using hlowerSandwich)
  have hlowerScaled :
      q * (∫ y in shrunk,
          phaseSmoothedDensity n points (localCLTSmoothingScaleTest n) y) ≤
        q * p + q * tail := by
    have := mul_le_mul_of_nonneg_left hlowerRaw hq
    nlinarith
  have hminus := hmassMinusN points hsmooth hspread
  have hplus := hmassPlusN points hsmooth hspread
  have hminusBounds := abs_lt.mp (by simpa only [q, shrunk, Aminus] using hminus)
  have hplusBounds := abs_lt.mp (by simpa only [q, expanded, Aplus] using hplus)
  have htailBound : q * tail < tol / 2 := by
    simpa only [q, tail] using htailN
  constructor
  · change Aminus - tol < q * p
    nlinarith [hminusBounds.1, hlowerScaled]
  · change q * p < Aplus + tol
    nlinarith [hplusBounds.2, hupperScaled]

lemma continuousAt_expandedFactoredTruncatedPhaseIntensity
    (m : ℕ) (widthFactor u velocityLower velocityUpper : ℝ) :
    ContinuousAt (fun eta : ℝ ↦
      ((widthFactor + eta) * ((12 * (u + eta) / Real.pi) *
        blockVelocityMass (velocityLower - eta) (velocityUpper + eta))) ^ m) 0 := by
  have hmass : ContinuousAt (fun eta : ℝ ↦
      blockVelocityMass (velocityLower - eta) (velocityUpper + eta)) 0 := by
    let g : ℝ → ℝ × ℝ := fun eta ↦
      (velocityLower - eta, velocityUpper + eta)
    have hg : ContinuousAt g 0 := by dsimp [g]; fun_prop
    have hbase : ContinuousAt (fun p : ℝ × ℝ ↦
        blockVelocityMass p.1 p.2) (g 0) := by
      dsimp [g]
      simpa only [sub_zero, add_zero] using
        continuousAt_blockVelocityMass velocityLower velocityUpper
    convert hbase.comp hg using 1
    ext eta
    rfl
  exact (((continuousAt_const.add continuousAt_id).mul
    ((((continuousAt_const.add continuousAt_id).const_mul 12).div_const Real.pi).mul
      hmass)).pow m)

lemma continuousAt_shrunkFactoredTruncatedPhaseIntensity
    (m : ℕ) (widthFactor u velocityLower velocityUpper : ℝ) :
    ContinuousAt (fun eta : ℝ ↦
      ((widthFactor - eta) * ((12 * (u - eta) / Real.pi) *
        blockVelocityMass (velocityLower + eta) (velocityUpper - eta))) ^ m) 0 := by
  have hmass : ContinuousAt (fun eta : ℝ ↦
      blockVelocityMass (velocityLower + eta) (velocityUpper - eta)) 0 := by
    let g : ℝ → ℝ × ℝ := fun eta ↦
      (velocityLower + eta, velocityUpper - eta)
    have hg : ContinuousAt g 0 := by dsimp [g]; fun_prop
    have hbase : ContinuousAt (fun p : ℝ × ℝ ↦
        blockVelocityMass p.1 p.2) (g 0) := by
      dsimp [g]
      simpa only [sub_zero, add_zero] using
        continuousAt_blockVelocityMass velocityLower velocityUpper
    convert hbase.comp hg using 1
    ext eta
    rfl
  exact (((continuousAt_const.sub continuousAt_id).mul
    ((((continuousAt_const.sub continuousAt_id).const_mul 12).div_const Real.pi).mul
      hmass)).pow m)

theorem eventually_uniform_scaled_factoredTruncatedPhaseProbability
    (m : ℕ) (hm : 0 < m)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hfactor : 0 < widthFactor) (hu : 0 < u)
    (hvelLower : 0 < velocityLower) (hvelUpper : 0 < velocityUpper)
    {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ points : Fin m → ℝ,
      (∀ r, IsSmooth n (rigiditySmoothScale n) (points r)) →
      IsSpread n (rigiditySmoothScale n) points →
      |(localMeshSize n : ℝ) ^ m *
          factoredTruncatedPhaseProbability m n points widthFactor u
            velocityLower velocityUpper -
        ((widthFactor * ((12 * u / Real.pi) *
          blockVelocityMass velocityLower velocityUpper)) ^ m)| < eps := by
  let A : ℝ := (widthFactor * ((12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper)) ^ m
  let etaSeq : ℕ → ℝ := fun k ↦ 1 / (k + 1 : ℝ)
  have hetaZero : Tendsto etaSeq atTop (nhds 0) := by
    simpa only [etaSeq] using tendsto_one_div_add_atTop_nhds_zero_nat
  have hplus := (continuousAt_expandedFactoredTruncatedPhaseIntensity
    m widthFactor u velocityLower velocityUpper).tendsto.comp hetaZero
  have hminus := (continuousAt_shrunkFactoredTruncatedPhaseIntensity
    m widthFactor u velocityLower velocityUpper).tendsto.comp hetaZero
  have hplus' : Tendsto (fun k : ℕ ↦
      ((widthFactor + etaSeq k) * ((12 * (u + etaSeq k) / Real.pi) *
        blockVelocityMass (velocityLower - etaSeq k)
          (velocityUpper + etaSeq k))) ^ m) atTop (nhds A) := by
    simpa [Function.comp_def, A] using hplus
  have hminus' : Tendsto (fun k : ℕ ↦
      ((widthFactor - etaSeq k) * ((12 * (u - etaSeq k) / Real.pi) *
        blockVelocityMass (velocityLower + etaSeq k)
          (velocityUpper - etaSeq k))) ^ m) atTop (nhds A) := by
    simpa [Function.comp_def, A] using hminus
  have hhalf : 0 < eps / 2 := by linarith
  have hplusClose : ∀ᶠ k : ℕ in atTop,
      ((widthFactor + etaSeq k) * ((12 * (u + etaSeq k) / Real.pi) *
        blockVelocityMass (velocityLower - etaSeq k)
          (velocityUpper + etaSeq k))) ^ m < A + eps / 2 :=
    hplus'.eventually (Iio_mem_nhds (lt_add_of_pos_right A hhalf))
  have hminusClose : ∀ᶠ k : ℕ in atTop,
      A - eps / 2 <
        ((widthFactor - etaSeq k) * ((12 * (u - etaSeq k) / Real.pi) *
          blockVelocityMass (velocityLower + etaSeq k)
            (velocityUpper - etaSeq k))) ^ m :=
    hminus'.eventually (Ioi_mem_nhds (sub_lt_self A hhalf))
  have hetaFactor : ∀ᶠ k : ℕ in atTop, etaSeq k < widthFactor :=
    hetaZero.eventually (Iio_mem_nhds hfactor)
  have hetaU : ∀ᶠ k : ℕ in atTop, etaSeq k < u :=
    hetaZero.eventually (Iio_mem_nhds hu)
  have hetaLower : ∀ᶠ k : ℕ in atTop, etaSeq k < velocityLower :=
    hetaZero.eventually (Iio_mem_nhds hvelLower)
  have hetaUpper : ∀ᶠ k : ℕ in atTop, etaSeq k < velocityUpper :=
    hetaZero.eventually (Iio_mem_nhds hvelUpper)
  rcases (hplusClose.and (hminusClose.and
      (hetaFactor.and (hetaU.and (hetaLower.and hetaUpper))))).exists with
    ⟨k, hplusK, hminusK, hetaFactorK, hetaUK, hetaLowerK, hetaUpperK⟩
  have hetaPos : 0 < etaSeq k := by
    dsimp [etaSeq]
    positivity
  have hbracket :=
    eventually_uniform_scaled_factoredTruncatedPhaseProbability_bracket
      m hm widthFactor u velocityLower velocityUpper (etaSeq k) (eps / 2)
      hu.le hvelLower hetaPos hetaFactorK hetaUK hetaLowerK hetaUpperK hhalf
  filter_upwards [hbracket] with n hn
  intro points hsmooth hspread
  have h := hn points hsmooth hspread
  rw [abs_lt]
  dsimp only [A] at hminusK hplusK ⊢
  constructor
  · nlinarith [h.1, hminusK]
  · nlinarith [h.2, hplusK]

def IsFactoredTruncatedLocalRepresentative
    (n : ℕ) (widthFactor u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n)) : Prop :=
  rescaledCenteredVelocity n e (localMeshPoint n a) ≠ 0 ∧
    |localAffineOffset n e a| ≤ widthFactor * localMeshHalfWidth n ∧
    |localSignedHeight n e a| ≤ u ∧
    velocityLower ≤ ‖rescaledCenteredVelocity n e (localMeshPoint n a)‖ ∧
    ‖rescaledCenteredVelocity n e (localMeshPoint n a)‖ ≤ velocityUpper

lemma joint_factoredTruncatedLocalRepresentatives_iff_region
    (n : ℕ) (hn : 0 < n)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower)
    (e : SignVector (2 * n))
    (s : Finset (Fin (localMeshSize n))) :
    (∀ a ∈ s,
        IsFactoredTruncatedLocalRepresentative n widthFactor u
          velocityLower velocityUpper e a) ↔
      normalizedPhaseEuclideanWalk n e (localSitesPoints s) ∈
        truncatedPhaseRegion (m := s.card) n u
          (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper := by
  rw [truncatedPhaseRegion]
  change (∀ a ∈ s,
      IsFactoredTruncatedLocalRepresentative n widthFactor u
        velocityLower velocityUpper e a) ↔
    phaseToBlocks (normalizedPhaseEuclideanWalk n e (localSitesPoints s)) ∈
      Set.univ.pi (fun _ : Fin s.card ↦
        truncatedBlockSet n u (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper)
  constructor
  · intro h r _hr
    have ha := h (localSite s r) (localSite_mem s r)
    rw [truncatedBlockSet,
      mem_truncatedBlockRegion_iff n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper hvelLower]
    rw [phaseToBlocks_normalizedPhaseEuclideanWalk]
    rw [← phasePosition_normalizedPhaseWalk n e (localSitesPoints s) r,
      ← phaseVelocity_normalizedPhaseWalk n e (localSitesPoints s) r]
    rw [isTruncatedBlockRepresentative_iff_phase
      (m := s.card) n hn u (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper]
    refine ⟨?_, ?_, ?_⟩
    · rw [isPhaseRepresentative_normalized_iff]
      exact ⟨ha.1, ha.2.1, ha.2.2.1⟩
    · rw [phaseVelocity_normalizedPhaseWalk]
      exact ha.2.2.2.1
    · rw [phaseVelocity_normalizedPhaseWalk]
      exact ha.2.2.2.2
  · intro h a ha
    rcases localSite_surjective s ha with ⟨r, rfl⟩
    have hr := h r (Set.mem_univ r)
    rw [truncatedBlockSet,
      mem_truncatedBlockRegion_iff n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper hvelLower] at hr
    rw [phaseToBlocks_normalizedPhaseEuclideanWalk] at hr
    rw [← phasePosition_normalizedPhaseWalk n e (localSitesPoints s) r,
      ← phaseVelocity_normalizedPhaseWalk n e (localSitesPoints s) r] at hr
    rw [isTruncatedBlockRepresentative_iff_phase
      (m := s.card) n hn u (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper] at hr
    rw [isPhaseRepresentative_normalized_iff] at hr
    rw [phaseVelocity_normalizedPhaseWalk] at hr
    exact ⟨hr.1.1, hr.1.2.1, hr.1.2.2, hr.2.1, hr.2.2⟩

lemma joint_factoredTruncatedLocalProbability_eq_phase
    (n : ℕ) (hn : 0 < n)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower)
    (s : Finset (Fin (localMeshSize n))) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        ∀ a ∈ s,
          IsFactoredTruncatedLocalRepresentative n widthFactor u
            velocityLower velocityUpper e a) =
      factoredTruncatedPhaseProbability s.card n (localSitesPoints s)
        widthFactor u velocityLower velocityUpper := by
  unfold factoredTruncatedPhaseProbability
  apply congrArg uniformProbability
  funext e
  exact propext (joint_factoredTruncatedLocalRepresentatives_iff_region
    n hn widthFactor u velocityLower velocityUpper hvelLower e s)

lemma factoredTruncatedLocalProbability_eq_phase_one
    (n : ℕ) (hn : 0 < n)
    (widthFactor u velocityLower velocityUpper : ℝ)
    (hvelLower : 0 < velocityLower)
    (a : Fin (localMeshSize n)) :
    uniformProbability (fun e : SignVector (2 * n) ↦
        IsFactoredTruncatedLocalRepresentative n widthFactor u
          velocityLower velocityUpper e a) =
      factoredTruncatedPhaseProbability 1 n
        (fun _ : Fin 1 ↦ localMeshPoint n a)
        widthFactor u velocityLower velocityUpper := by
  unfold factoredTruncatedPhaseProbability
  apply congrArg uniformProbability
  funext e
  apply propext
  rw [truncatedPhaseRegion]
  change IsFactoredTruncatedLocalRepresentative n widthFactor u
      velocityLower velocityUpper e a ↔
    phaseToBlocks (normalizedPhaseEuclideanWalk n e
      (fun _ : Fin 1 ↦ localMeshPoint n a)) ∈
      Set.univ.pi (fun _ : Fin 1 ↦
        truncatedBlockSet n u (widthFactor * localMeshHalfWidth n)
          velocityLower velocityUpper)
  constructor
  · intro ha r _hr
    have hr0 : r = 0 := Subsingleton.elim _ _
    subst r
    rw [truncatedBlockSet,
      mem_truncatedBlockRegion_iff n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper hvelLower]
    rw [phaseToBlocks_normalizedPhaseEuclideanWalk]
    rw [← phasePosition_normalizedPhaseWalk n e
      (fun _ : Fin 1 ↦ localMeshPoint n a) 0,
      ← phaseVelocity_normalizedPhaseWalk n e
        (fun _ : Fin 1 ↦ localMeshPoint n a) 0]
    rw [isTruncatedBlockRepresentative_iff_phase
      (m := 1) n hn u (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper]
    rw [isPhaseRepresentative_normalized_iff]
    rw [phaseVelocity_normalizedPhaseWalk]
    exact ⟨⟨ha.1, ha.2.1, ha.2.2.1⟩, ha.2.2.2.1, ha.2.2.2.2⟩
  · intro h
    have hr := h (0 : Fin 1) (Set.mem_univ _)
    rw [truncatedBlockSet,
      mem_truncatedBlockRegion_iff n u
        (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper hvelLower] at hr
    rw [phaseToBlocks_normalizedPhaseEuclideanWalk] at hr
    rw [← phasePosition_normalizedPhaseWalk n e
      (fun _ : Fin 1 ↦ localMeshPoint n a) 0,
      ← phaseVelocity_normalizedPhaseWalk n e
        (fun _ : Fin 1 ↦ localMeshPoint n a) 0] at hr
    rw [isTruncatedBlockRepresentative_iff_phase
      (m := 1) n hn u (widthFactor * localMeshHalfWidth n)
        velocityLower velocityUpper] at hr
    rw [isPhaseRepresentative_normalized_iff,
      phaseVelocity_normalizedPhaseWalk] at hr
    exact ⟨hr.1.1, hr.1.2.1, hr.1.2.2, hr.2.1, hr.2.2⟩

lemma isFactoredTruncatedLocalRepresentative_one_iff
    (n : ℕ) (u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n)) :
    IsFactoredTruncatedLocalRepresentative n 1 u velocityLower velocityUpper e a ↔
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a := by
  simp only [IsFactoredTruncatedLocalRepresentative,
    IsTruncatedLocalRepresentative, IsLocalRepresentative, one_mul]
  tauto

lemma isFactoredTruncatedLocalRepresentative_mono
    (n : ℕ) (widthFactor₁ widthFactor₂ u velocityLower velocityUpper : ℝ)
    (hfactor : widthFactor₁ ≤ widthFactor₂)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n))
    (hrep : IsFactoredTruncatedLocalRepresentative n widthFactor₁ u
      velocityLower velocityUpper e a) :
    IsFactoredTruncatedLocalRepresentative n widthFactor₂ u
      velocityLower velocityUpper e a := by
  rcases hrep with ⟨hvel, hoff, hheight, hlower, hupper⟩
  refine ⟨hvel, hoff.trans ?_, hheight, hlower, hupper⟩
  exact mul_le_mul_of_nonneg_right hfactor (by
    unfold localMeshHalfWidth
    positivity)

lemma uniformProbability_and_not_eq_sub
    {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (P Q : Ω → Prop)
    (hQP : ∀ x, Q x → P x) :
    uniformProbability (fun x ↦ P x ∧ ¬Q x) =
      uniformProbability P - uniformProbability Q := by
  classical
  rw [← uniformExpectation_indicator, ← uniformExpectation_indicator,
    ← uniformExpectation_indicator]
  unfold uniformExpectation
  rw [← sub_div, ← Finset.sum_sub_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro x _hx
  by_cases hQ : Q x
  · have hP := hQP x hQ
    simp [hQ, hP]
  · by_cases hP : P x <;> simp [hQ, hP]

def IsRightBoundaryTruncatedLocalRepresentative
    (n : ℕ) (eta u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n)) : Prop :=
  IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a ∧
    (1 - eta) * localMeshHalfWidth n < localAffineOffset n e a

def IsLeftBoundaryTruncatedLocalRepresentative
    (n : ℕ) (eta u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n)) : Prop :=
  IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a ∧
    localAffineOffset n e a < -(1 - eta) * localMeshHalfWidth n

lemma rightBoundary_subset_full_not_factored
    (n : ℕ) (eta u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n))
    (h : IsRightBoundaryTruncatedLocalRepresentative n eta u
      velocityLower velocityUpper e a) :
    IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a ∧
      ¬IsFactoredTruncatedLocalRepresentative n (1 - eta) u
        velocityLower velocityUpper e a := by
  refine ⟨h.1, ?_⟩
  intro hnarrow
  have habs := hnarrow.2.1
  exact (not_le_of_gt h.2) ((le_abs_self _).trans habs)

lemma leftBoundary_subset_full_not_factored
    (n : ℕ) (eta u velocityLower velocityUpper : ℝ)
    (e : SignVector (2 * n)) (a : Fin (localMeshSize n))
    (h : IsLeftBoundaryTruncatedLocalRepresentative n eta u
      velocityLower velocityUpper e a) :
    IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a ∧
      ¬IsFactoredTruncatedLocalRepresentative n (1 - eta) u
        velocityLower velocityUpper e a := by
  refine ⟨h.1, ?_⟩
  intro hnarrow
  have habs := hnarrow.2.1
  have hleft := h.2
  have hbound : -(1 - eta) * localMeshHalfWidth n ≤
      localAffineOffset n e a := by
    calc
      -(1 - eta) * localMeshHalfWidth n =
          -((1 - eta) * localMeshHalfWidth n) := by ring
      _ ≤ -|localAffineOffset n e a| := neg_le_neg habs
      _ ≤ localAffineOffset n e a := neg_abs_le _
  exact (not_le_of_gt hleft) hbound

theorem eventually_uniform_scaled_rightBoundaryProbability
    (eta u velocityLower velocityUpper : ℝ)
    (heta : 0 < eta) (hetaOne : eta < 1)
    (hu : 0 < u) (hvelLower : 0 < velocityLower)
    (hvelUpper : 0 < velocityUpper)
    {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ n : ℕ in atTop, ∀ a : Fin (localMeshSize n),
      IsGoodLocalSiteSet n {a} →
      (localMeshSize n : ℝ) *
          uniformProbability (fun e : SignVector (2 * n) ↦
            IsRightBoundaryTruncatedLocalRepresentative n eta u
              velocityLower velocityUpper e a) <
        eta * ((12 * u / Real.pi) *
          blockVelocityMass velocityLower velocityUpper) + eps := by
  let intensity : ℝ := (12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper
  have hhalf : 0 < eps / 2 := by linarith
  have hfull := eventually_uniform_scaled_factoredTruncatedPhaseProbability
    1 (by norm_num) 1 u velocityLower velocityUpper (by norm_num) hu
      hvelLower hvelUpper hhalf
  have hnarrow := eventually_uniform_scaled_factoredTruncatedPhaseProbability
    1 (by norm_num) (1 - eta) u velocityLower velocityUpper
      (sub_pos.mpr hetaOne) hu hvelLower hvelUpper hhalf
  filter_upwards [hfull, hnarrow, Nat.eventually_pos]
    with n hfullN hnarrowN hn
  intro a hgood
  let points : Fin 1 → ℝ := fun _ ↦ localMeshPoint n a
  have hsmooth : ∀ r,
      IsSmooth n (rigiditySmoothScale n) (points r) := by
    intro r
    dsimp [points]
    exact hgood.1 a (by simp)
  have hspread : IsSpread n (rigiditySmoothScale n) points := by
    refine ⟨?_, ?_⟩
    · intro _hm r
      let r0 : Fin ({a} : Finset (Fin (localMeshSize n))).card := ⟨0, by simp⟩
      have hbase := hgood.2.1 (by simp) r0
      have hr0 : localSite ({a} : Finset (Fin (localMeshSize n))) r0 = a := by
        have := localSite_mem ({a} : Finset (Fin (localMeshSize n))) r0
        simpa using this
      simpa [points, localSitesPoints, hr0] using hbase
    · intro r q hrq
      exact (hrq (Subsingleton.elim _ _)).elim
  have hfullApprox := hfullN points hsmooth hspread
  have hnarrowApprox := hnarrowN points hsmooth hspread
  have hfullEq :
      uniformProbability (fun e : SignVector (2 * n) ↦
        IsFactoredTruncatedLocalRepresentative n 1 u velocityLower
          velocityUpper e a) =
      factoredTruncatedPhaseProbability 1 n points 1 u
        velocityLower velocityUpper := by
    simpa only [points] using factoredTruncatedLocalProbability_eq_phase_one
      n hn 1 u velocityLower velocityUpper hvelLower a
  have hnarrowEq :
      uniformProbability (fun e : SignVector (2 * n) ↦
        IsFactoredTruncatedLocalRepresentative n (1 - eta) u velocityLower
          velocityUpper e a) =
      factoredTruncatedPhaseProbability 1 n points (1 - eta) u
        velocityLower velocityUpper := by
    simpa only [points] using factoredTruncatedLocalProbability_eq_phase_one
      n hn (1 - eta) u velocityLower velocityUpper hvelLower a
  let P : SignVector (2 * n) → Prop := fun e ↦
    IsFactoredTruncatedLocalRepresentative n 1 u velocityLower
      velocityUpper e a
  let Q : SignVector (2 * n) → Prop := fun e ↦
    IsFactoredTruncatedLocalRepresentative n (1 - eta) u velocityLower
      velocityUpper e a
  have hQP : ∀ e, Q e → P e := by
    intro e he
    exact isFactoredTruncatedLocalRepresentative_mono n (1 - eta) 1 u
      velocityLower velocityUpper (by linarith) e a he
  have hboundary :
      uniformProbability (fun e : SignVector (2 * n) ↦
        IsRightBoundaryTruncatedLocalRepresentative n eta u
          velocityLower velocityUpper e a) ≤
        uniformProbability P - uniformProbability Q := by
    calc
      uniformProbability (fun e : SignVector (2 * n) ↦
          IsRightBoundaryTruncatedLocalRepresentative n eta u
            velocityLower velocityUpper e a) ≤
          uniformProbability (fun e ↦ P e ∧ ¬Q e) := by
        apply uniformProbability_mono
        intro e he
        have hdiff := rightBoundary_subset_full_not_factored
          n eta u velocityLower velocityUpper e a he
        exact ⟨(isFactoredTruncatedLocalRepresentative_one_iff
          n u velocityLower velocityUpper e a).2 hdiff.1, hdiff.2⟩
      _ = uniformProbability P - uniformProbability Q :=
        uniformProbability_and_not_eq_sub P Q hQP
  have hmesh : 0 ≤ (localMeshSize n : ℝ) := by positivity
  have hboundaryScaled := mul_le_mul_of_nonneg_left hboundary hmesh
  have hfullBounds :
      |(localMeshSize n : ℝ) * uniformProbability P - intensity| < eps / 2 := by
    simpa only [P, hfullEq, pow_one, one_mul, intensity] using hfullApprox
  have hnarrowBounds :
      |(localMeshSize n : ℝ) * uniformProbability Q -
        (1 - eta) * intensity| < eps / 2 := by
    simpa only [Q, hnarrowEq, pow_one, intensity] using hnarrowApprox
  have hfullUpper := (abs_lt.mp hfullBounds).2
  have hnarrowLower := (abs_lt.mp hnarrowBounds).1
  dsimp only [P, Q] at hboundaryScaled
  nlinarith

