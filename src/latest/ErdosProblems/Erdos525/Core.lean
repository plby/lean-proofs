        iteratedForwardDifference (q₀ : ℤ) (2 * k)
          (fun x ↦ centeredModOne
            (scaledRealPhaseProjection n points u t x))
          (j + (w : ℤ) * (q₀ : ℤ)) := by
    intro w hw
    have hfitw : (v + w * q₀) + 2 * k * q₀ < W := by
      have hwq : w * q₀ ≤ (2 * k) * ell * q₀ :=
        Nat.mul_le_mul_right q₀ hw
      have hdecomp : 2 * k * (ell + 1) * q₀ =
          (2 * k) * ell * q₀ + 2 * k * q₀ := by ring
      rw [hdecomp] at hv
      omega
    have h :=
      iteratedForwardDifference_scaledPhase_eq_centered_on_goodBlock_pow_gap
        n hn points u t q₀ k η hη hgap s W hs a ha hgood
          (v + w * q₀) hfitw hsmall
    convert h using 1 <;> dsimp [j] <;> push_cast <;> ring
  have hprop := iteratedForwardDifference_nat_mul_eq_centered_of_base
    (q₀ : ℤ) ell (2 * k) (scaledRealPhaseProjection n points u t) j hbase
  convert hprop using 1 <;> dsimp [j] <;> push_cast <;> ring

/-- Once quotient representatives have been unwrapped, their difference
bound transfers back to the unscaled real phase polynomial with the exact
factor `π/|t|`. -/
lemma norm_iteratedOrdinaryRealPhase_le_of_unwrapped
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t : ℝ) (ht : t ≠ 0) (h j : ℤ) (k : ℕ) (M : ℝ)
    (hunwrap :
      iteratedForwardDifference h (2 * k)
          (scaledRealPhaseProjection n points u t) j =
        iteratedForwardDifference h (2 * k)
          (fun q ↦ centeredModOne
            (scaledRealPhaseProjection n points u t q)) j)
    (hcentered :
      |iteratedForwardDifference h (2 * k)
        (fun q ↦ centeredModOne
          (scaledRealPhaseProjection n points u t q)) j| ≤ M) :
    ‖iteratedDoubleTwist h (List.replicate k 1)
        (realComplexPhaseProjection n points u) j‖ ≤
      Real.pi / |t| * M := by
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  have hfreal : ∀ q, (f q).im = 0 := by
    intro q
    simp [f, realComplexPhaseProjection_eq_re]
  have hcomplex := congrFun
    (iteratedDoubleTwist_replicate_one_eq_ofReal h k f hfreal) j
  have hfun : scaledRealPhaseProjection n points u t =
      fun q ↦ (t / Real.pi) * (f q).re := by
    funext q
    simp [scaledRealPhaseProjection, f]
    ring
  have hscaled :
      iteratedForwardDifference h (2 * k)
          (scaledRealPhaseProjection n points u t) j =
        (t / Real.pi) *
          iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j := by
    rw [hfun]
    exact iteratedForwardDifference_const_mul h (2 * k)
      (t / Real.pi) (fun q ↦ (f q).re) j
  have hprod :
      |t| / Real.pi *
          |iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j| ≤ M := by
    have hc := hcentered
    rw [← hunwrap, hscaled, abs_mul, abs_div,
      abs_of_pos Real.pi_pos] at hc
    exact hc
  have hcoeff : 0 < |t| / Real.pi := div_pos (abs_pos.2 ht) Real.pi_pos
  have hD :
      |iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j| ≤
        Real.pi / |t| * M := by
    have hdiv :
        |iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j| ≤
          M / (|t| / Real.pi) := by
      apply (le_div_iff₀ hcoeff).2
      rw [mul_comm]
      exact hprod
    calc
      |iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j| ≤
          M / (|t| / Real.pi) := hdiv
      _ = Real.pi / |t| * M := by field_simp
  rw [hcomplex]
  simpa [f] using hD

/-- Exact norm identity after unwrapping: the ordinary complex high
difference is the centered real high difference multiplied by `π/|t|`. -/
lemma norm_iteratedOrdinaryRealPhase_eq_of_unwrapped
    (n : ℕ) (points : Fin m → ℝ) (u : PhaseCoordinate m)
    (t : ℝ) (ht : t ≠ 0) (h j : ℤ) (k : ℕ)
    (hunwrap :
      iteratedForwardDifference h (2 * k)
          (scaledRealPhaseProjection n points u t) j =
        iteratedForwardDifference h (2 * k)
          (fun q ↦ centeredModOne
            (scaledRealPhaseProjection n points u t q)) j) :
    ‖iteratedDoubleTwist h (List.replicate k 1)
        (realComplexPhaseProjection n points u) j‖ =
      Real.pi / |t| *
        |iteratedForwardDifference h (2 * k)
          (fun q ↦ centeredModOne
            (scaledRealPhaseProjection n points u t q)) j| := by
  let f : ℤ → ℂ := realComplexPhaseProjection n points u
  have hfreal : ∀ q, (f q).im = 0 := by
    intro q
    simp [f, realComplexPhaseProjection_eq_re]
  have hcomplex := congrFun
    (iteratedDoubleTwist_replicate_one_eq_ofReal h k f hfreal) j
  have hfun : scaledRealPhaseProjection n points u t =
      fun q ↦ (t / Real.pi) * (f q).re := by
    funext q
    simp [scaledRealPhaseProjection, f]
    ring
  have hscaled :
      iteratedForwardDifference h (2 * k)
          (scaledRealPhaseProjection n points u t) j =
        (t / Real.pi) *
          iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j := by
    rw [hfun]
    exact iteratedForwardDifference_const_mul h (2 * k)
      (t / Real.pi) (fun q ↦ (f q).re) j
  have habs := congrArg abs hunwrap
  rw [hscaled, abs_mul, abs_div, abs_of_pos Real.pi_pos] at habs
  have htpos : 0 < |t| := abs_pos.2 ht
  have hreal :
      |iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j| =
        Real.pi / |t| *
          |iteratedForwardDifference h (2 * k)
            (fun q ↦ centeredModOne
              (scaledRealPhaseProjection n points u t q)) j| := by
    calc
      |iteratedForwardDifference h (2 * k) (fun q ↦ (f q).re) j| =
          |iteratedForwardDifference h (2 * k)
              (fun q ↦ centeredModOne
                (scaledRealPhaseProjection n points u t q)) j| /
            (|t| / Real.pi) :=
        (eq_div_iff (ne_of_gt (div_pos htpos Real.pi_pos))).2 (by
          rw [mul_comm]
          exact habs)
      _ = Real.pi / |t| *
          |iteratedForwardDifference h (2 * k)
            (fun q ↦ centeredModOne
              (scaledRealPhaseProjection n points u t q)) j| := by
        field_simp
  rw [hcomplex]
  simpa [f] using hreal

/-- Every starting point sufficiently far from the end of a good residue
block supplies a uniformly bounded ordinary high difference of the real
phase polynomial. -/
lemma norm_iteratedOrdinaryRealPhase_le_on_goodBlock
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
    (q₀ k : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hgap : ∀ a : ReflectedMode m,
      ‖complexWave n (reflectedModeTime points a) (q₀ : ℤ) - 1‖ ≤ η)
    (s W : ℕ) (hs : s + W ≤ 2 * n + 1) (a : ℝ) (ha : 0 ≤ a)
    (hgood : ∀ r : ℕ, r < W →
      |centeredModOne
        (scaledRealPhaseProjection n points u t
          (((s + r : ℕ) : ℤ) - (n : ℤ)))| ≤ a)
    (v : ℕ) (hv : v + 2 * k * q₀ < W)
    (hsmall :
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) +
        (2 : ℝ) ^ (2 * k) * a < 1) :
    ‖iteratedDoubleTwist (q₀ : ℤ) (List.replicate k 1)
        (realComplexPhaseProjection n points u)
        (((s + v : ℕ) : ℤ) - (n : ℤ))‖ ≤
      Real.pi / |t| * ((2 : ℝ) ^ (2 * k) * a) := by
  let j : ℤ := ((s + v : ℕ) : ℤ) - (n : ℤ)
  have hsv : s + v ≤ 2 * n := by omega
  have hj : |(j : ℝ)| ≤ n := by
    rw [abs_le]
    constructor
    · simp only [j, Int.cast_sub, Int.cast_natCast, Nat.cast_add, Int.cast_add]
      have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
      have hv0 : (0 : ℝ) ≤ v := Nat.cast_nonneg v
      linarith
    · have hsvReal : (s : ℝ) + (v : ℝ) ≤ 2 * (n : ℝ) := by
        exact_mod_cast hsv
      simp only [j, Int.cast_sub, Int.cast_natCast, Nat.cast_add, Int.cast_add]
      linarith
  have hcentered :
      |iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (fun q ↦ centeredModOne
          (scaledRealPhaseProjection n points u t q)) j| ≤
        (2 : ℝ) ^ (2 * k) * a := by
    apply abs_iteratedForwardDifference_le_window
    intro r hr
    have hvr : v + r * q₀ < W := by
      have hmul : r * q₀ ≤ (2 * k) * q₀ :=
        Nat.mul_le_mul_right q₀ hr
      omega
    rw [show j + (r : ℤ) * (q₀ : ℤ) =
        (((s + (v + r * q₀) : ℕ) : ℤ) - (n : ℤ)) by
      dsimp [j]
      push_cast
      ring]
    exact hgood (v + r * q₀) hvr
  have hactual :=
    abs_iteratedForwardDifference_scaledRealPhaseProjection_le_l1
      n hn points u t (q₀ : ℤ) j k η hη hj hgap
  have hactual' :
      |iteratedForwardDifference (q₀ : ℤ) (2 * k)
        (scaledRealPhaseProjection n points u t) j| ≤
      (|t| / Real.pi) *
          ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
            (η ^ (2 * k) +
              (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)) := by
    simpa using hactual
  have hunwrap := iteratedForwardDifference_eq_centered_of_abs_add_lt_one
    (q₀ : ℤ) (2 * k) (scaledRealPhaseProjection n points u t) j
    ((|t| / Real.pi) *
      ((∑ r : Fin m, ∑ c : Fin 4, |u r c|) *
        (η ^ (2 * k) +
          (k : ℝ) * (4 : ℝ) ^ k * (q₀ : ℝ) / n)))
    ((2 : ℝ) ^ (2 * k) * a) hactual' hcentered hsmall
  exact norm_iteratedOrdinaryRealPhase_le_of_unwrapped
    n points u t ht (q₀ : ℤ) j k ((2 : ℝ) ^ (2 * k) * a)
    hunwrap hcentered

lemma norm_iteratedOrdinaryRealPhase_eq_on_goodBlock
    (n : ℕ) (hn : 0 < n) (points : Fin m → ℝ)
    (u : PhaseCoordinate m) (t : ℝ) (ht : t ≠ 0)
