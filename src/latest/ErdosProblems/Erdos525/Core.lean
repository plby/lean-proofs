          (((s + v : ℕ) : ℤ) - (n : ℤ))| := by
  let j : ℤ := ((s + v : ℕ) : ℤ) - (n : ℤ)
  have hsv : s + v ≤ 2 * n := by omega
  have hj : |(j : ℝ)| ≤ n := by
