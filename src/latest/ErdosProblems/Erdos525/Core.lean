noncomputable def adjacentGoodLocalPairs (n : ℕ) :
    Finset (Fin (localMeshSize n) × Fin (localMeshSize n)) :=
  by
    classical
    exact Finset.univ.filter fun p ↦
      p.2.val = p.1.val + 1 ∧ IsGoodLocalSiteSet n {p.1}

lemma adjacentGoodLocalPairs_card_le (n : ℕ) :
    (adjacentGoodLocalPairs n).card ≤ localMeshSize n := by
  classical
  let f : {p : Fin (localMeshSize n) × Fin (localMeshSize n) //
      p ∈ adjacentGoodLocalPairs n} → Fin (localMeshSize n) := fun p ↦ p.1.1
  have hf : Function.Injective f := by
    intro p q hpq
    apply Subtype.ext
    apply Prod.ext
    · exact hpq
    · apply Fin.ext
      have hp' : p.1.2.val = p.1.1.val + 1 ∧
          IsGoodLocalSiteSet n {p.1.1} := by
        simpa [adjacentGoodLocalPairs] using p.2
      have hq' : q.1.2.val = q.1.1.val + 1 ∧
          IsGoodLocalSiteSet n {q.1.1} := by
        simpa [adjacentGoodLocalPairs] using q.2
      have hp := hp'.1
      have hq := hq'.1
      have hfirst : p.1.1.val = q.1.1.val := congrArg Fin.val hpq
      omega
  have hcard := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_coe, Fintype.card_fin] using hcard

theorem scaled_highMeshAcceleration_upper_tendsto_zero :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) ^ 2 *
        (4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2)))
      atTop (𝓝 0) := by
  have hcore :=
    (tendsto_rigidityPower_mul_exp_neg_power_test
      4 (1 / 4) (1 / 8) (by norm_num) (by norm_num)).const_mul 16
  refine squeeze_zero'
    (g := fun n : ℕ ↦ 16 * (rigidityPower n 4 *
      Real.exp (-(1 / 8) * rigidityPower n (1 / 4))))
    (Eventually.of_forall fun n ↦ by positivity) ?_ ?_
  · filter_upwards [Nat.eventually_pos] with n hn
    have hsize : (localMeshSize n : ℝ) ≤ 2 * rigidityPower n 2 := by
      simp only [localMeshSize, rigidityPower]
      norm_num
      push_cast
      nlinarith [show (1 : ℝ) ≤ n by exact_mod_cast hn]
    have hsizeSq : (localMeshSize n : ℝ) ^ 2 ≤
        4 * rigidityPower n 4 := by
      have hsq := (sq_le_sq₀ (by positivity)
        (mul_nonneg (by norm_num) (rigidityPower_nonneg n 2))).2 hsize
      have hpow : rigidityPower n 2 ^ 2 = rigidityPower n 4 := by
        convert rigidityPower_nat_pow hn 2 2 using 1 <;> norm_num
      nlinarith
    have hcutSq : accelerationCutoff n ^ 2 =
        rigidityPower n (1 / 4) := by
      unfold accelerationCutoff
      convert rigidityPower_nat_pow hn (1 / 8) 2 using 1 <;> norm_num
    have hexp : -(accelerationCutoff n / 2) ^ 2 / 2 =
        -(1 / 8) * rigidityPower n (1 / 4) := by
      rw [div_pow, hcutSq]
      ring
    rw [hexp]
    have hnonneg : 0 ≤ 4 * Real.exp
        (-(1 / 8) * rigidityPower n (1 / 4)) := by positivity
    calc
      (localMeshSize n : ℝ) ^ 2 *
          (4 * Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) ≤
        (4 * rigidityPower n 4) *
          (4 * Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) :=
        mul_le_mul_of_nonneg_right hsizeSq hnonneg
      _ = 16 * (rigidityPower n 4 *
          Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) := by ring
  · simpa using hcore

theorem localMeshSize_mul_highMeshAcceleration_tendsto_zero :
    Tendsto (fun n : ℕ ↦ (localMeshSize n : ℝ) *
      uniformProbability (HasHighMeshAcceleration n)) atTop (𝓝 0) := by
  apply squeeze_zero' (Eventually.of_forall fun n ↦
    mul_nonneg (by positivity) (uniformProbability_nonneg _))
  · filter_upwards [Nat.eventually_pos] with n hn
    have hprob := uniformProbability_highMeshAcceleration_le n hn
    have hmesh : 0 ≤ (localMeshSize n : ℝ) := by positivity
    have := mul_le_mul_of_nonneg_left hprob hmesh
    simpa [pow_two] using this
  · convert scaled_highMeshAcceleration_upper_tendsto_zero using 1
    funext n
    ring

/-- The global high-acceleration exception remains negligible after summing
over any fixed number of mesh indices. -/
theorem scaled_highMeshAcceleration_upper_tendsto_zero_pow (k : ℕ) :
    Tendsto (fun n : ℕ ↦
      (localMeshSize n : ℝ) ^ (k + 1) *
        (4 * Real.exp (-(accelerationCutoff n / 2) ^ 2 / 2)))
      atTop (𝓝 0) := by
  let C : ℝ := 4 * 2 ^ (k + 1)
  have hcore :=
    (tendsto_rigidityPower_mul_exp_neg_power_test
      (2 * (k + 1)) (1 / 4) (1 / 8) (by norm_num) (by norm_num)).const_mul C
  refine squeeze_zero'
    (g := fun n : ℕ ↦ C *
      (rigidityPower n (2 * (k + 1)) *
        Real.exp (-(1 / 8) * rigidityPower n (1 / 4))))
    (Eventually.of_forall fun n ↦ by positivity) ?_ ?_
  · filter_upwards [Nat.eventually_pos] with n hn
    have hsize : (localMeshSize n : ℝ) ≤ 2 * rigidityPower n 2 := by
      simp only [localMeshSize, rigidityPower]
      norm_num
      push_cast
      nlinarith [show (1 : ℝ) ≤ n by exact_mod_cast hn]
    have hsizePow : (localMeshSize n : ℝ) ^ (k + 1) ≤
        (2 * rigidityPower n 2) ^ (k + 1) := by
      exact pow_le_pow_left₀ (by positivity) hsize _
    have hrpow : rigidityPower n 2 ^ (k + 1) =
        rigidityPower n (2 * (k + 1)) := by
      convert rigidityPower_nat_pow hn 2 (k + 1) using 1 <;> norm_num
    have hsizePow' : (localMeshSize n : ℝ) ^ (k + 1) ≤
        2 ^ (k + 1) * rigidityPower n (2 * (k + 1)) := by
      calc
        _ ≤ (2 * rigidityPower n 2) ^ (k + 1) := hsizePow
        _ = 2 ^ (k + 1) * rigidityPower n (2 * (k + 1)) := by
          rw [mul_pow, hrpow]
    have hcutSq : accelerationCutoff n ^ 2 =
        rigidityPower n (1 / 4) := by
      unfold accelerationCutoff
      convert rigidityPower_nat_pow hn (1 / 8) 2 using 1 <;> norm_num
    have hexp : -(accelerationCutoff n / 2) ^ 2 / 2 =
        -(1 / 8) * rigidityPower n (1 / 4) := by
      rw [div_pow, hcutSq]
      ring
    rw [hexp]
    have hnonneg : 0 ≤ 4 * Real.exp
        (-(1 / 8) * rigidityPower n (1 / 4)) := by positivity
    calc
      (localMeshSize n : ℝ) ^ (k + 1) *
          (4 * Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) ≤
        (2 ^ (k + 1) * rigidityPower n (2 * (k + 1))) *
          (4 * Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) :=
        mul_le_mul_of_nonneg_right hsizePow' hnonneg
      _ = C * (rigidityPower n (2 * (k + 1)) *
          Real.exp (-(1 / 8) * rigidityPower n (1 / 4))) := by
        dsimp [C]
        ring
  · simpa [C] using hcore

theorem localMeshSize_pow_mul_highMeshAcceleration_tendsto_zero (k : ℕ) :
    Tendsto (fun n : ℕ ↦ (localMeshSize n : ℝ) ^ k *
      uniformProbability (HasHighMeshAcceleration n)) atTop (𝓝 0) := by
  apply squeeze_zero' (Eventually.of_forall fun n ↦
    mul_nonneg (by positivity) (uniformProbability_nonneg _))
  · filter_upwards [Nat.eventually_pos] with n hn
    have hprob := uniformProbability_highMeshAcceleration_le n hn
    have hmesh : 0 ≤ (localMeshSize n : ℝ) ^ k := by positivity
    have := mul_le_mul_of_nonneg_left hprob hmesh
    convert this using 1 <;> ring
  · convert scaled_highMeshAcceleration_upper_tendsto_zero_pow k using 1
    funext n
    ring

lemma adjacentRepresentatives_rightBoundary_of_not_high
    (eta u velocityLower velocityUpper : ℝ)
    (heta : 0 < eta)
    (n : ℕ) (hn : 0 < n)
    (herr : adjacentAffineLocationError n u velocityLower velocityUpper /
        localMeshHalfWidth n < eta)
    (e : SignVector (2 * n)) (hgood : ¬HasHighMeshAcceleration n e)
    (a b : Fin (localMeshSize n)) (hab : b.val = a.val + 1)
    (ha : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e a)
    (hb : IsTruncatedLocalRepresentative n u velocityLower velocityUpper e b)
    (hu : 0 ≤ u) (hvelocityLower : 0 < velocityLower)
    (hvelocityUpper : 0 ≤ velocityUpper) :
    IsRightBoundaryTruncatedLocalRepresentative n eta u
      velocityLower velocityUpper e a := by
  refine ⟨ha, ?_⟩
  have hnear := (adjacentRepresentatives_offsets_near_boundary
    n hn e hgood u velocityLower velocityUpper hu hvelocityLower
      hvelocityUpper a b hab ha hb).1
  have hhalf : 0 < localMeshHalfWidth n := by
    unfold localMeshHalfWidth
    exact div_pos (mul_pos Real.pi_pos (by exact_mod_cast hn))
      (by exact_mod_cast localMeshSize_pos n)
  have herr' : adjacentAffineLocationError n u velocityLower velocityUpper <
      eta * localMeshHalfWidth n := (div_lt_iff₀ hhalf).mp herr
  nlinarith

noncomputable def adjacentGoodTruncatedPairContribution
    (n : ℕ) (u velocityLower velocityUpper : ℝ) : ℝ :=
  ∑ p ∈ adjacentGoodLocalPairs n,
    uniformProbability (fun e : SignVector (2 * n) ↦
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e p.1 ∧
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e p.2)

theorem adjacentGoodTruncatedPairContribution_tendsto_zero
    (u velocityLower velocityUpper : ℝ)
    (hu : 0 < u) (hvelocityLower : 0 < velocityLower)
    (hvelocityUpper : 0 < velocityUpper) :
    Tendsto (fun n : ℕ ↦ adjacentGoodTruncatedPairContribution n u
      velocityLower velocityUpper) atTop (𝓝 0) := by
  rw [Metric.tendsto_atTop]
  intro eps heps
  let intensity : ℝ := (12 * u / Real.pi) *
    blockVelocityMass velocityLower velocityUpper
  have hintensity : 0 ≤ intensity := by
    dsimp [intensity]
    exact mul_nonneg (by positivity)
      (blockVelocityMass_nonneg velocityLower velocityUpper)
  let denom : ℝ := 8 * (intensity + 1) + eps
  have hdenom : 0 < denom := by dsimp [denom]; positivity
  let eta : ℝ := eps / denom
  have heta : 0 < eta := div_pos heps hdenom
  have hetaOne : eta < 1 := by
    dsimp [eta]
    rw [div_lt_one hdenom]
    dsimp [denom]
    nlinarith
  have hetaIntensity : eta * intensity < eps / 8 := by
    dsimp [eta]
    rw [div_mul_eq_mul_div, div_lt_iff₀ hdenom]
    dsimp [denom]
    nlinarith [mul_pos heps (show 0 < (8 : ℝ) by norm_num)]
  have herr : ∀ᶠ n : ℕ in atTop,
      adjacentAffineLocationError n u velocityLower velocityUpper /
          localMeshHalfWidth n < eta :=
    (adjacentAffineLocationError_relative_tendsto_zero
      u velocityLower velocityUpper hvelocityLower.ne').eventually
        (Iio_mem_nhds heta)
  have hboundary := eventually_uniform_scaled_rightBoundaryProbability
    eta u velocityLower velocityUpper heta hetaOne hu hvelocityLower
      hvelocityUpper (show 0 < eps / 8 by linarith)
  have hhigh : ∀ᶠ n : ℕ in atTop,
      (localMeshSize n : ℝ) *
          uniformProbability (HasHighMeshAcceleration n) < eps / 4 :=
    localMeshSize_mul_highMeshAcceleration_tendsto_zero.eventually
      (Iio_mem_nhds (by linarith))
  apply eventually_atTop.1
  filter_upwards [Nat.eventually_pos, herr, hboundary, hhigh]
    with n hn herrN hboundaryN hhighN
  have hmesh : 0 < (localMeshSize n : ℝ) := by
    exact_mod_cast localMeshSize_pos n
  let pairProbability :
      (Fin (localMeshSize n) × Fin (localMeshSize n)) → ℝ := fun p ↦
    uniformProbability (fun e : SignVector (2 * n) ↦
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e p.1 ∧
      IsTruncatedLocalRepresentative n u velocityLower velocityUpper e p.2)
  let boundaryProbability : Fin (localMeshSize n) → ℝ := fun a ↦
    uniformProbability (fun e : SignVector (2 * n) ↦
      IsRightBoundaryTruncatedLocalRepresentative n eta u
        velocityLower velocityUpper e a)
  have hpair : ∀ p ∈ adjacentGoodLocalPairs n,
      pairProbability p ≤ uniformProbability (HasHighMeshAcceleration n) +
        boundaryProbability p.1 := by
    intro p hp
    have hpData : p.2.val = p.1.val + 1 ∧
        IsGoodLocalSiteSet n {p.1} := by
      simpa [adjacentGoodLocalPairs] using hp
    calc
      pairProbability p ≤
          uniformProbability (fun e : SignVector (2 * n) ↦
            HasHighMeshAcceleration n e ∨
            IsRightBoundaryTruncatedLocalRepresentative n eta u
              velocityLower velocityUpper e p.1) := by
        apply uniformProbability_mono
        intro e he
        by_cases hacc : HasHighMeshAcceleration n e
        · exact Or.inl hacc
        · exact Or.inr (adjacentRepresentatives_rightBoundary_of_not_high
            eta u velocityLower velocityUpper heta n hn herrN e hacc p.1 p.2
            hpData.1 he.1 he.2 hu.le hvelocityLower hvelocityUpper.le)
      _ ≤ uniformProbability (HasHighMeshAcceleration n) +
          boundaryProbability p.1 := by
        exact uniformProbability_or_le_add _ _
  have hboundaryEach : ∀ p ∈ adjacentGoodLocalPairs n,
      (localMeshSize n : ℝ) * boundaryProbability p.1 < eps / 4 := by
    intro p hp
    have hpData : p.2.val = p.1.val + 1 ∧
        IsGoodLocalSiteSet n {p.1} := by
      simpa [adjacentGoodLocalPairs] using hp
    have hpGood : IsGoodLocalSiteSet n {p.1} := hpData.2
    have hb := hboundaryN p.1 hpGood
    dsimp only [boundaryProbability]
    nlinarith
  have hboundarySum :
      ∑ p ∈ adjacentGoodLocalPairs n, boundaryProbability p.1 ≤ eps / 4 := by
    have hscaled :
        (localMeshSize n : ℝ) *
            (∑ p ∈ adjacentGoodLocalPairs n, boundaryProbability p.1) ≤
          (localMeshSize n : ℝ) * (eps / 4) := by
      calc
        (localMeshSize n : ℝ) *
            (∑ p ∈ adjacentGoodLocalPairs n, boundaryProbability p.1) =
            ∑ p ∈ adjacentGoodLocalPairs n,
              (localMeshSize n : ℝ) * boundaryProbability p.1 := by
          rw [Finset.mul_sum]
        _ ≤ ∑ _p ∈ adjacentGoodLocalPairs n, eps / 4 := by
          apply Finset.sum_le_sum
          intro p hp
          exact (hboundaryEach p hp).le
        _ = ((adjacentGoodLocalPairs n).card : ℝ) * (eps / 4) := by simp
        _ ≤ (localMeshSize n : ℝ) * (eps / 4) := by
          gcongr
          exact_mod_cast adjacentGoodLocalPairs_card_le n
    nlinarith
  have hhighSum :
      ((adjacentGoodLocalPairs n).card : ℝ) *
          uniformProbability (HasHighMeshAcceleration n) < eps / 4 := by
    calc
      ((adjacentGoodLocalPairs n).card : ℝ) *
          uniformProbability (HasHighMeshAcceleration n) ≤
          (localMeshSize n : ℝ) *
            uniformProbability (HasHighMeshAcceleration n) := by
        apply mul_le_mul_of_nonneg_right
        · exact_mod_cast adjacentGoodLocalPairs_card_le n
        · exact uniformProbability_nonneg _
      _ < eps / 4 := hhighN
  have hsum :
      adjacentGoodTruncatedPairContribution n u velocityLower velocityUpper ≤
        ((adjacentGoodLocalPairs n).card : ℝ) *
            uniformProbability (HasHighMeshAcceleration n) +
          ∑ p ∈ adjacentGoodLocalPairs n, boundaryProbability p.1 := by
    unfold adjacentGoodTruncatedPairContribution
    change (∑ p ∈ adjacentGoodLocalPairs n, pairProbability p) ≤ _
    calc
      (∑ p ∈ adjacentGoodLocalPairs n, pairProbability p) ≤
          ∑ p ∈ adjacentGoodLocalPairs n,
            (uniformProbability (HasHighMeshAcceleration n) +
              boundaryProbability p.1) := by
        apply Finset.sum_le_sum
        intro p hp
        exact hpair p hp
      _ = ((adjacentGoodLocalPairs n).card : ℝ) *
            uniformProbability (HasHighMeshAcceleration n) +
          ∑ p ∈ adjacentGoodLocalPairs n, boundaryProbability p.1 := by
        rw [Finset.sum_add_distrib]
        simp
  have hnonneg : 0 ≤ adjacentGoodTruncatedPairContribution n u
      velocityLower velocityUpper := by
    unfold adjacentGoodTruncatedPairContribution
    exact Finset.sum_nonneg fun p _ ↦ uniformProbability_nonneg _
  rw [Real.dist_eq, sub_zero, abs_of_nonneg hnonneg]
  calc
    adjacentGoodTruncatedPairContribution n u velocityLower velocityUpper ≤
        _ := hsum
    _ < eps / 4 + eps / 4 := add_lt_add_of_lt_of_le hhighSum hboundarySum
    _ < eps := by linarith

end Erdos525
