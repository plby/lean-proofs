import ErdosProblems.Erdos117.ModuleLength
import Mathlib.LinearAlgebra.BilinearMap

/-!
# The length of the image of a bilinear map

The argument follows P. M. Neumann, *An improved bound for BFC p-groups*
(1970), §2–3. In particular it uses module composition length, not vector
space dimension, and will apply to finite abelian groups over `ℤ`.
-/

namespace Erdos117

variable {R U V W W' : Type*} [CommRing R]
  [AddCommGroup U] [Module R U] [AddCommGroup V] [Module R V]
  [AddCommGroup W] [Module R W] [AddCommGroup W'] [Module R W']

/-- The submodule generated by all values of a bilinear map. -/
def bilinearImage (β : U →ₗ[R] V →ₗ[R] W) : Submodule R W :=
  ⨆ u, LinearMap.range (β u)

theorem bilinearImage_le_iff (β : U →ₗ[R] V →ₗ[R] W) (S : Submodule R W) :
    bilinearImage β ≤ S ↔ ∀ u v, β u v ∈ S := by
  constructor
  · intro h u v
    exact h (le_iSup (fun x => LinearMap.range (β x)) u (LinearMap.mem_range_self _ _))
  · intro h
    apply iSup_le
    intro u w hw
    obtain ⟨v, rfl⟩ := hw
    exact h u v

theorem mem_bilinearImage (β : U →ₗ[R] V →ₗ[R] W) (u : U) (v : V) :
    β u v ∈ bilinearImage β :=
  (bilinearImage_le_iff β _).mp le_rfl u v

theorem bilinearImage_compr₂ (β : U →ₗ[R] V →ₗ[R] W) (f : W →ₗ[R] W') :
    bilinearImage (β.compr₂ f) = (bilinearImage β).map f := by
  unfold bilinearImage
  rw [Submodule.map_iSup]
  apply iSup_congr
  intro u
  change LinearMap.range (f.comp (β u)) = _
  exact LinearMap.range_comp _ _

theorem bilinear_row_sup_add (β : U →ₗ[R] V →ₗ[R] W) (u v : U) :
    LinearMap.range (β u) ⊔ LinearMap.range (β (u + v)) =
      LinearMap.range (β u) ⊔ LinearMap.range (β v) := by
  apply le_antisymm
  · apply sup_le le_sup_left
    rintro w ⟨x, rfl⟩
    rw [map_add, LinearMap.add_apply]
    exact Submodule.add_mem _
      ((le_sup_left : LinearMap.range (β u) ≤ _) (LinearMap.mem_range_self _ _))
      ((le_sup_right : LinearMap.range (β v) ≤ _) (LinearMap.mem_range_self _ _))
  · apply sup_le le_sup_left
    rintro w ⟨x, rfl⟩
    have heq : β v x = β (u + v) x - β u x := by
      rw [map_add, LinearMap.add_apply]
      abel
    rw [heq]
    exact Submodule.sub_mem _
      ((le_sup_right : LinearMap.range (β (u + v)) ≤ _) (LinearMap.mem_range_self _ _))
      ((le_sup_left : LinearMap.range (β u) ≤ _) (LinearMap.mem_range_self _ _))

/-- The initial row loses one unit of length after quotienting by a maximal
row, provided it does not annihilate the kernel of that row. -/
theorem bilinear_first_row_drop [Finite W] (β : U →ₗ[R] V →ₗ[R] W) {k : ℕ}
    (hrows : ∀ u, moduleLength R (LinearMap.range (β u)) ≤ k)
    (u₀ : U) (hmax : moduleLength R (LinearMap.range (β u₀)) = k)
    (u : U) (hx : ∃ x, β u₀ x = 0 ∧ β u x ≠ 0) :
    moduleLength R ((LinearMap.range (β u)).map (LinearMap.range (β u₀)).mkQ) + 1 ≤ k := by
  obtain ⟨x, hx₀, hxu⟩ := hx
  have hne : LinearMap.range (β u) ⊓ LinearMap.range (β (u + u₀)) ≠ ⊥ := by
    intro h
    have hmem : β u x ∈ LinearMap.range (β u) ⊓ LinearMap.range (β (u + u₀)) := by
      refine ⟨⟨x, rfl⟩, ⟨x, ?_⟩⟩
      simp only [map_add, LinearMap.add_apply, hx₀, add_zero]
    rw [h] at hmem
    exact hxu hmem
  have hpos := moduleLength_pos_of_ne_bot hne
  have hsum := moduleLength_sup_add_inf (LinearMap.range (β u))
    (LinearMap.range (β (u + u₀)))
  rw [bilinear_row_sup_add] at hsum
  have hquot := moduleLength_map_quotient_add_right (LinearMap.range (β u))
    (LinearMap.range (β u₀))
  have hu := hrows u
  have hu₀ := hrows (u + u₀)
  omega

/-- The later row-drop step: a row longer than the row of `u+v` meets the
row of `u` nontrivially, so quotienting by it strictly reduces that row. -/
theorem bilinear_later_row_drop [Finite W] (β : U →ₗ[R] V →ₗ[R] W) (u v : U)
    (h : moduleLength R (LinearMap.range (β (u + v))) <
      moduleLength R (LinearMap.range (β v))) :
    moduleLength R ((LinearMap.range (β u)).map (LinearMap.range (β v)).mkQ) <
      moduleLength R (LinearMap.range (β u)) := by
  have hsup := moduleLength_sup_le (LinearMap.range (β u))
    (LinearMap.range (β (u + v)))
  rw [bilinear_row_sup_add] at hsup
  have hquot := moduleLength_map_quotient_add_right (LinearMap.range (β u))
    (LinearMap.range (β v))
  omega

/-- Bounding columns on a spanning set suffices when the length of the
second domain is known. -/
theorem bilinearImage_length_le_domain [Finite V] [Finite W]
    (β : U →ₗ[R] V →ₗ[R] W) (s : Set V) (hs : Submodule.span R s = ⊤)
    {l : ℕ} (hcol : ∀ v ∈ s, moduleLength R (LinearMap.range (β.flip v)) ≤ l) :
    moduleLength R (bilinearImage β) ≤ moduleLength R V * l := by
  classical
  obtain ⟨t, ht, hcard, hspan⟩ := exists_small_spanning_subset s hs
  let C := t.sup (fun v => LinearMap.range (β.flip v))
  have hle : bilinearImage β ≤ C := by
    apply (bilinearImage_le_iff β C).mpr
    intro u v
    have hsub : Submodule.span R (t : Set V) ≤ C.comap (β u) := by
      apply Submodule.span_le.mpr
      intro x hx
      exact (Finset.le_sup (f := fun v => LinearMap.range (β.flip v)) hx)
        (LinearMap.mem_range_self _ u)
    rw [hspan] at hsub
    exact hsub (Submodule.mem_top : v ∈ (⊤ : Submodule R V))
  calc
    moduleLength R (bilinearImage β) ≤ moduleLength R C := moduleLength_mono hle
    _ ≤ ∑ v ∈ t, moduleLength R (LinearMap.range (β.flip v)) :=
      moduleLength_finset_sup_le _ _
    _ ≤ ∑ _v ∈ t, l := Finset.sum_le_sum (fun v hv => hcol v (ht hv))
    _ = t.card * l := by simp
    _ ≤ moduleLength R V * l := Nat.mul_le_mul_right _ hcard

/-- Quotienting the second variable by a common annihilator allows its
quotient length to replace the length of the original domain. -/
theorem bilinearImage_length_le_quotient [Finite V] [Finite W]
    (β : U →ₗ[R] V →ₗ[R] W) (X : Submodule R V)
    (hX : ∀ u x, x ∈ X → β u x = 0)
    (s : Set V) (hs : Submodule.span R s = ⊤)
    {l : ℕ} (hcol : ∀ v ∈ s, moduleLength R (LinearMap.range (β.flip v)) ≤ l) :
    moduleLength R (bilinearImage β) ≤ moduleLength R (V ⧸ X) * l := by
  have : Finite (V ⧸ X) := Finite.of_surjective X.mkQ X.mkQ_surjective
  have hker : X ≤ LinearMap.ker β.flip := by
    intro x hx
    ext u
    exact hX u x hx
  let γ : U →ₗ[R] (V ⧸ X) →ₗ[R] W := (X.liftQ β.flip hker).flip
  have hγ : ∀ u v, γ u (X.mkQ v) = β u v := by intros; rfl
  have hspan : Submodule.span R (X.mkQ '' s) = ⊤ := by
    rw [← Submodule.map_span, hs, Submodule.map_top, X.range_mkQ]
  have hcols : ∀ v ∈ X.mkQ '' s, moduleLength R (LinearMap.range (γ.flip v)) ≤ l := by
    rintro _ ⟨v, hv, rfl⟩
    exact hcol v hv
  have himg : bilinearImage γ = bilinearImage β := by
    apply le_antisymm
    · apply (bilinearImage_le_iff γ _).mpr
      intro u q
      obtain ⟨v, rfl⟩ := X.mkQ_surjective q
      rw [hγ]
      exact mem_bilinearImage β u v
    · apply (bilinearImage_le_iff β _).mpr
      intro u v
      rw [← hγ]
      exact mem_bilinearImage γ u (X.mkQ v)
  rw [← himg]
  exact bilinearImage_length_le_domain γ _ hspan hcols

/-- The finite row-selection process either lowers every row bound or uses
up all `k` steps. All discarded rows come from the fixed submodule `Y`. -/
theorem bilinear_stopping_submodule [Finite W]
    (β : U →ₗ[R] V →ₗ[R] W) (Y : Submodule R U) {k i : ℕ}
    (hrows : ∀ u, moduleLength R (LinearMap.range (β u)) ≤ k)
    (hi : i ≤ k) (S : Submodule R W)
    (hS : S ≤ bilinearImage (β.comp Y.subtype))
    (hlen : moduleLength R S ≤ i * k)
    (hout : ∀ u ∉ Y, moduleLength R ((LinearMap.range (β u)).map S.mkQ) ≤ k - i) :
    ∃ r : ℕ, i ≤ r ∧ r ≤ k ∧ ∃ T : Submodule R W,
      T ≤ bilinearImage (β.comp Y.subtype) ∧ moduleLength R T ≤ r * k ∧
      (∀ u ∉ Y, moduleLength R ((LinearMap.range (β u)).map T.mkQ) ≤ k - r) ∧
      (r = k ∨ ∀ u, moduleLength R ((LinearMap.range (β u)).map T.mkQ) ≤ k - r) := by
  classical
  have aux : ∀ j i : ℕ, i + j = k → ∀ S : Submodule R W,
      S ≤ bilinearImage (β.comp Y.subtype) → moduleLength R S ≤ i * k →
      (∀ u ∉ Y, moduleLength R ((LinearMap.range (β u)).map S.mkQ) ≤ k - i) →
      ∃ r : ℕ, i ≤ r ∧ r ≤ k ∧ ∃ T : Submodule R W,
        T ≤ bilinearImage (β.comp Y.subtype) ∧ moduleLength R T ≤ r * k ∧
        (∀ u ∉ Y, moduleLength R ((LinearMap.range (β u)).map T.mkQ) ≤ k - r) ∧
        (r = k ∨ ∀ u, moduleLength R ((LinearMap.range (β u)).map T.mkQ) ≤ k - r) := by
    intro j
    induction j with
    | zero =>
      intro i hik S hS hlen hout
      exact ⟨i, le_rfl, by omega, S, hS, hlen, hout, Or.inl (by omega)⟩
    | succ j ih =>
      intro i hik S hS hlen hout
      by_cases hall : ∀ u, moduleLength R ((LinearMap.range (β u)).map S.mkQ) ≤ k - i
      · exact ⟨i, le_rfl, by omega, S, hS, hlen, hout, Or.inr hall⟩
      push Not at hall
      obtain ⟨v, hvlen⟩ := hall
      have hv : v ∈ Y := by
        by_contra hv
        have h := hout v hv
        omega
      let T := S ⊔ LinearMap.range (β v)
      have hT : T ≤ bilinearImage (β.comp Y.subtype) := by
        apply sup_le hS
        rintro w ⟨x, rfl⟩
        exact mem_bilinearImage (β.comp Y.subtype) ⟨v, hv⟩ x
      have hTlen : moduleLength R T ≤ (i + 1) * k := by
        have hsum := moduleLength_sup_le S (LinearMap.range (β v))
        have hvr := hrows v
        dsimp [T]
        nlinarith
      have hTout : ∀ u ∉ Y,
          moduleLength R ((LinearMap.range (β u)).map T.mkQ) ≤ k - (i + 1) := by
        intro u hu
        have huv : u + v ∉ Y := by
          intro h
          apply hu
          simpa only [add_sub_cancel_right] using Y.sub_mem h hv
        have : Finite (W ⧸ S) := Finite.of_surjective S.mkQ S.mkQ_surjective
        let γ := β.compr₂ S.mkQ
        have hγ : ∀ x, LinearMap.range (γ x) = (LinearMap.range (β x)).map S.mkQ := by
          intro x
          exact LinearMap.range_comp _ _
        have hsmall := hout (u + v) huv
        have hdrop := bilinear_later_row_drop γ u v (by rw [hγ, hγ]; omega)
        rw [hγ u, hγ v] at hdrop
        rw [moduleLength_map_quotient_sup] at hdrop
        have hu' := hout u hu
        dsimp [T]
        omega
      obtain ⟨r, hir, hrk, T', hT', hlen', hout', hstop⟩ :=
        ih (i + 1) (by omega) T hT hTlen hTout
      exact ⟨r, by omega, hrk, T', hT', hlen', hout', hstop⟩
  exact aux (k - i) i (by omega) S hS hlen hout

/-- Neumann's bilinear length bound. A bound `k` on every row and a bound
`l ≥ k` on a spanning set of columns give total image length at most `k*l`.
This is a proved module theorem, not an assumed group-theoretic input. -/
theorem bilinearImage_length_le [Finite V] [Finite W]
    (β : U →ₗ[R] V →ₗ[R] W) {k l : ℕ} (hkl : k ≤ l)
    (hrows : ∀ u, moduleLength R (LinearMap.range (β u)) ≤ k)
    (s : Set V) (hs : Submodule.span R s = ⊤)
    (hcols : ∀ v ∈ s, moduleLength R (LinearMap.range (β.flip v)) ≤ l) :
    moduleLength R (bilinearImage β) ≤ k * l := by
  classical
  induction k using Nat.strong_induction_on generalizing W with
  | h k ih =>
    by_cases hk : k = 0
    · subst k
      have himg : bilinearImage β = ⊥ := by
        apply le_antisymm ((bilinearImage_le_iff β _).mpr ?_) bot_le
        intro u v
        have hrow : LinearMap.range (β u) = ⊥ :=
          (moduleLength_submodule_eq_zero_iff _).mp (Nat.eq_zero_of_le_zero (hrows u))
        have hv := LinearMap.mem_range_self (β u) v
        rw [hrow] at hv
        exact hv
      rw [himg, moduleLength_bot]
      omega
    by_cases hex : ∃ u₀, moduleLength R (LinearMap.range (β u₀)) = k
    · obtain ⟨u₀, hmax⟩ := hex
      let X := LinearMap.ker (β u₀)
      let Y : Submodule R U :=
        { carrier := {u | ∀ x ∈ X, β u x = 0}
          zero_mem' := by simp
          add_mem' := by
            intro u v hu hv x hx
            simp only [map_add, LinearMap.add_apply, hu x hx, hv x hx, add_zero]
          smul_mem' := by
            intro a u hu x hx
            simp only [map_smul, LinearMap.smul_apply, hu x hx, smul_zero] }
      have hu₀ : u₀ ∈ Y := by
        intro x hx
        exact hx
      have hS : LinearMap.range (β u₀) ≤ bilinearImage (β.comp Y.subtype) := by
        rintro w ⟨x, rfl⟩
        exact mem_bilinearImage (β.comp Y.subtype) ⟨u₀, hu₀⟩ x
      have hout : ∀ u ∉ Y,
          moduleLength R ((LinearMap.range (β u)).map (LinearMap.range (β u₀)).mkQ) ≤ k - 1 := by
        intro u hu
        have hx : ∃ x, β u₀ x = 0 ∧ β u x ≠ 0 := by
          by_contra! h
          apply hu
          intro x hx
          exact h x hx
        have hdrop := bilinear_first_row_drop β hrows u₀ hmax u hx
        omega
      obtain ⟨r, hrpos, hrk, S, hS', hlen, hout', hstop⟩ :=
        bilinear_stopping_submodule β Y hrows (show 1 ≤ k by omega)
          (LinearMap.range (β u₀)) hS (by omega) hout
      have himgY : bilinearImage (β.comp Y.subtype) ≤ bilinearImage β := by
        apply (bilinearImage_le_iff _ _).mpr
        intro u v
        exact mem_bilinearImage β u v
      have : Finite (W ⧸ S) := Finite.of_surjective S.mkQ S.mkQ_surjective
      rcases hstop with hr | hsmall
      · have hle : bilinearImage β ≤ bilinearImage (β.comp Y.subtype) := by
          apply (bilinearImage_le_iff β _).mpr
          intro u v
          by_cases hu : u ∈ Y
          · exact mem_bilinearImage (β.comp Y.subtype) ⟨u, hu⟩ v
          · have hzero : (LinearMap.range (β u)).map S.mkQ = ⊥ := by
              apply (moduleLength_submodule_eq_zero_iff _).mp
              have h := hout' u hu
              omega
            have hv : S.mkQ (β u v) ∈ (LinearMap.range (β u)).map S.mkQ :=
              ⟨β u v, LinearMap.mem_range_self _ _, rfl⟩
            rw [hzero] at hv
            have hmem : β u v ∈ S := S.ker_mkQ ▸ hv
            exact hS' hmem
        have hX : ∀ (u : Y) x, x ∈ X → (β.comp Y.subtype) u x = 0 := by
          intro u x hx
          exact u.property x hx
        have hcolsY : ∀ v ∈ s,
            moduleLength R (LinearMap.range ((β.comp Y.subtype).flip v)) ≤ l := by
          intro v hv
          have hsub : LinearMap.range ((β.comp Y.subtype).flip v) ≤
              LinearMap.range (β.flip v) := by
            rintro w ⟨u, rfl⟩
            exact ⟨(u : U), rfl⟩
          exact (moduleLength_mono hsub).trans (hcols v hv)
        have hbound := bilinearImage_length_le_quotient (β.comp Y.subtype) X hX s hs hcolsY
        have hXlen : moduleLength R (V ⧸ X) = k :=
          (moduleLength_eq_of_equiv (β u₀).quotKerEquivRange).trans hmax
        rw [hXlen] at hbound
        exact (moduleLength_mono hle).trans hbound
      · let γ := β.compr₂ S.mkQ
        have hγ : ∀ u, LinearMap.range (γ u) = (LinearMap.range (β u)).map S.mkQ := by
          intro u
          exact LinearMap.range_comp _ _
        have hγrows : ∀ u, moduleLength R (LinearMap.range (γ u)) ≤ k - r := by
          intro u
          rw [hγ]
          exact hsmall u
        have hγcols : ∀ v ∈ s, moduleLength R (LinearMap.range (γ.flip v)) ≤ l := by
          intro v hv
          have heq : LinearMap.range (γ.flip v) = (LinearMap.range (β.flip v)).map S.mkQ :=
            LinearMap.range_comp (β.flip v) S.mkQ
          rw [heq]
          exact (moduleLength_map_le _ _).trans (hcols v hv)
        have hrec := ih (k - r) (by omega) γ (by omega) hγrows hγcols
        have htotal := moduleLength_map_quotient_add (hS'.trans himgY)
        rw [← bilinearImage_compr₂] at htotal
        have hkr : (k - r) + r = k := by omega
        have hmul : r * k ≤ r * l := Nat.mul_le_mul_left r hkl
        dsimp [γ] at hrec
        nlinarith
    · have hsmall : ∀ u, moduleLength R (LinearMap.range (β u)) ≤ k - 1 := by
        intro u
        have hu := hrows u
        have hne : moduleLength R (LinearMap.range (β u)) ≠ k := by
          intro h
          exact hex ⟨u, h⟩
        omega
      have hrec := ih (k - 1) (by omega) β (by omega) hsmall hcols
      exact hrec.trans (Nat.mul_le_mul_right l (Nat.sub_le _ _))

end Erdos117
