def fastPrefix (a : Fin 4) (k : Nat) (c : Fin 4) : Nat :=
  ((prefixData[a.val]!).getD k #[]).getD c.val 0

theorem prefixData_correct : ∀ a : Fin 4, ∀ k : Fin 86, ∀ c : Fin 4,
    fastPrefix a k.val c = cumParikhCount a k.val c := by decide +kernel

