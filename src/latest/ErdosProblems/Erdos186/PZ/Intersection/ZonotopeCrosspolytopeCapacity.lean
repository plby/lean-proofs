import ErdosProblems.Erdos186.PZ.Intersection.ZonotopeThickness

/-!
# Adjugate capacity for zonotope thickness

Cramer's rule turns a coordinate cube into a scaled crosspolytope.  The
factor `d` in the coordinatewise adjugate bound pays for the `l1` sum of
the `d` resulting coefficients.  Combined with the covered-crosspolytope
theorem, this is the finite-dimensional geometric core of PZ Lemma 14.
-/

namespace Erdos186.PZ.Intersection

open scoped BigOperators
open Erdos186.CFP.Bilu.Mahler
open Erdos186.CFP.Bilu.MinkowskiSecond

noncomputable section

set_option autoImplicit false

/-- A coordinate cube is contained in the crosspolytope generated by the
rows of a nonsingular integral matrix when each adjugate column has enough
scaled capacity. -/
theorem cube_subset_scaledCrosspolytope_of_adjugate_capacity
    {d : ℕ} (hd : 0 < d) (P : GAP d d)
    (hdet : (stepMatrix P).det ≠ 0)
    (scale : Fin d → ℝ) (hscale : ∀ i, 0 < scale i)
    (radius : ℝ) (hradius : 0 ≤ radius)
    (hcapacity : ∀ i,
      (d : ℝ) * radius *
          (∑ j, |(((stepMatrix P).adjugate j i : ℤ) : ℝ)|) ≤
        |(((stepMatrix P).det : ℤ) : ℝ)| * scale i) :
    {y : Fin d → ℝ | ∀ j, |y j| ≤ radius} ⊆
      (Matrix.toLin' (scaledRealColumns scale P.steps)) '' l1UnitBall d := by
  intro y hy
  let M : Matrix (Fin d) (Fin d) ℝ :=
    (Int.castRingHom ℝ).mapMatrix (stepMatrix P)
  let Adj : Matrix (Fin d) (Fin d) ℝ :=
    (Int.castRingHom ℝ).mapMatrix (stepMatrix P).adjugate
  let detR : ℝ := ((stepMatrix P).det : ℤ)
  let numerator : Fin d → ℝ := fun i ↦ Matrix.vecMul y Adj i
  let coeff : Fin d → ℝ := fun i ↦ numerator i / detR
  let x : Fin d → ℝ := fun i ↦ coeff i / scale i
  have hdetR : detR ≠ 0 := by
    dsimp only [detR]
    exact_mod_cast hdet
  have hmatrix : Adj * M = detR • (1 : Matrix (Fin d) (Fin d) ℝ) := by
    calc
      Adj * M = M.adjugate * M := by
        rw [show Adj = M.adjugate by
          exact (Int.castRingHom ℝ).map_adjugate (stepMatrix P)]
      _ = M.det • (1 : Matrix (Fin d) (Fin d) ℝ) :=
        Matrix.adjugate_mul M
      _ = detR • (1 : Matrix (Fin d) (Fin d) ℝ) := by
        rw [show M.det = detR by
          exact (Int.cast_det (R := ℝ) (stepMatrix P)).symm]
  have hcoeff : Matrix.vecMul coeff M = y := by
    have hcoeffEq : coeff = detR⁻¹ • Matrix.vecMul y Adj := by
      funext i
      simp only [coeff, numerator, Pi.smul_apply, smul_eq_mul,
        div_eq_mul_inv]
      ring
    rw [hcoeffEq, Matrix.smul_vecMul, Matrix.vecMul_vecMul, hmatrix,
      Matrix.vecMul_smul, Matrix.vecMul_one, smul_smul,
      inv_mul_cancel₀ hdetR, one_smul]
  have hxscale (i : Fin d) : x i * scale i = coeff i := by
    dsimp only [x]
    exact div_mul_cancel₀ _ (hscale i).ne'
  have hximage :
      (Matrix.toLin' (scaledRealColumns scale P.steps)) x = y := by
    rw [Matrix.toLin'_apply, mulVec_scaledRealColumns]
    calc
      scaledCombination scale x P.steps = Matrix.vecMul coeff M := by
        funext j
        simp only [scaledCombination, Finset.sum_apply, Pi.smul_apply,
          smul_eq_mul, Matrix.vecMul, dotProduct, M, RingHom.mapMatrix_apply,
          stepMatrix]
        apply Finset.sum_congr rfl
        intro i _hi
        rw [← mul_assoc, hxscale]
        rfl
      _ = y := hcoeff
  refine ⟨x, ?_, hximage⟩
  change (∑ i, |x i|) ≤ 1
  have hcoord (i : Fin d) : |x i| ≤ ((d : ℝ))⁻¹ := by
    have hnum : |numerator i| ≤
        radius * (∑ j, |Adj j i|) := by
      calc
        |numerator i| = |∑ j, y j * Adj j i| := by
          rfl
        _ ≤ ∑ j, |y j * Adj j i| := Finset.abs_sum_le_sum_abs _ _
        _ = ∑ j, |y j| * |Adj j i| := by
          apply Finset.sum_congr rfl
          intro j _hj
          rw [abs_mul]
        _ ≤ ∑ j, radius * |Adj j i| := by
          apply Finset.sum_le_sum
          intro j _hj
          exact mul_le_mul_of_nonneg_right (hy j) (abs_nonneg _)
        _ = radius * (∑ j, |Adj j i|) := by
          rw [Finset.mul_sum]
    have hscaled :
        (d : ℝ) * |numerator i| ≤ |detR| * scale i := by
      calc
        (d : ℝ) * |numerator i| ≤
            (d : ℝ) * (radius * (∑ j, |Adj j i|)) := by
          exact mul_le_mul_of_nonneg_left hnum (by positivity)
        _ = (d : ℝ) * radius * (∑ j, |Adj j i|) := by ring
        _ ≤ |detR| * scale i := by
          change
            (d : ℝ) * radius *
                (∑ j, |(((stepMatrix P).adjugate j i : ℤ) : ℝ)|) ≤
              |(((stepMatrix P).det : ℤ) : ℝ)| * scale i
          exact hcapacity i
    have hdim : (0 : ℝ) < d := by exact_mod_cast hd
    have hdetAbs : 0 < |detR| := abs_pos.mpr hdetR
    rw [show |x i| = |numerator i| / |detR| / scale i by
      simp only [x, coeff, abs_div, abs_of_pos (hscale i)]]
    apply (div_le_iff₀ (hscale i)).2
    apply (div_le_iff₀ hdetAbs).2
    have hquot : |numerator i| ≤ (|detR| * scale i) / (d : ℝ) := by
      apply (le_div_iff₀ hdim).2
      simpa only [mul_comm] using hscaled
    calc
      |numerator i| ≤ (|detR| * scale i) / (d : ℝ) := hquot
      _ = (d : ℝ)⁻¹ * scale i * |detR| := by
        field_simp
  calc
    (∑ i, |x i|) ≤ ∑ _i : Fin d, ((d : ℝ))⁻¹ :=
      Finset.sum_le_sum fun i _hi ↦ hcoord i
    _ = (d : ℝ) * (d : ℝ)⁻¹ := by simp
    _ = 1 := mul_inv_cancel₀ (by exact_mod_cast hd.ne')

/-- A covered centered progression supplies genuine coordinate thickness
once its displayed step matrix has enough adjugate capacity.  This is the
direct composition of Cramer's rule with the covered-crosspolytope
construction, and contains no abstract thickness premise. -/
theorem cube_subset_centeredZonotope_of_covered_dilate_adjugate_capacity
    {d k : ℕ} (hd : 0 < d) (A : Finset (LatticePoint d))
    (P : GAP d d) {radii : Fin d → ℕ} (hP : P.Centered radii)
    (hnondegenerate : P.Nondegenerate)
    (hdet : (stepMatrix P).det ≠ 0)
    (t : LatticePoint d) (q : LatticePoint d → ℝ) (theta : ℝ)
    (htheta : 0 < theta) (hk : 0 < k)
    (hq : ∀ x ∈ A, theta ≤ q x)
    (hcovered : CFP.translate t (P.dilate k).carrier ⊆ GAP.subsetSums A)
    (radius : ℝ) (hradius : 0 ≤ radius)
    (hcapacity : ∀ i,
      (d : ℝ) * radius *
          (∑ j, |(((stepMatrix P).adjugate j i : ℤ) : ℝ)|) ≤
        |(((stepMatrix P).det : ℤ) : ℝ)| *
          (theta * (k * radii i : ℕ))) :
    {y : Fin d → ℝ | ∀ j, |y j| ≤ radius} ⊆
      centeredZonotope A q := by
  have hscale : ∀ i, 0 < theta * (k * radii i : ℕ) := by
    intro i
    have hradii : 0 < radii i := hP.nondegenerate_iff.mp hnondegenerate i
    positivity
  exact
    (cube_subset_scaledCrosspolytope_of_adjugate_capacity hd P hdet
      (fun i ↦ theta * (k * radii i : ℕ)) hscale radius hradius hcapacity).trans
      (covered_dilate_crosspolytope_subset_centeredZonotope hd A P hP t q theta
        htheta.le hq hcovered)

end

end Erdos186.PZ.Intersection
