import ErdosProblems.Erdos186.PZ.Reduction.BoundedContext
import ErdosProblems.Erdos186.PZ.Reduction.Termination

/-!
# Eligible coordinate replacements

This file turns failure of the bounded coordinate form of Definition 9 into
an actual relation on finite sets of varying ambient dimension.  It proves
that every step has the exact density retention and preserves
nonaveraging.  A uniform finite trace bound then produces a reachable state
which is irreducible, not merely an abstract terminal state.
-/

namespace Erdos186.PZ.Reduction

noncomputable section

variable {β η : ℝ} {C : HigherDimensionalContext β η}

/-- One eligible finite set in the varying-dimensional reduction. -/
structure CoordinateReplacementState (selector : BoundedCFPSelector C) where
  ambientDimension : ℕ
  points : Finset (LatticePoint ambientDimension)
  eligible : selector.Eligible points

namespace CoordinateReplacementState

variable {selector : BoundedCFPSelector C}

/-- The selected structured output at this state. -/
def selected (S : CoordinateReplacementState selector) : SelectedCFP S.points :=
  selector.chosen S.points S.eligible

/-- Definition 9 at a concrete eligible state. -/
def Irreducible (S : CoordinateReplacementState selector) (δ γ : ℝ) : Prop :=
  IsBoundedCoordinateIrreducible selector S.points S.eligible δ γ

theorem points_nonempty (S : CoordinateReplacementState selector) :
    S.points.Nonempty :=
  selector.eligible_nonempty S.eligible

end CoordinateReplacementState

/-- The next varying-dimensional state displayed by a failure of Definition
9.  Its ambient dimension is the current selected subset-sum dimension. -/
def BoundedIrreducibilityFailure.nextState
    {selector : BoundedCFPSelector C} {d : ℕ}
    {A : Finset (LatticePoint d)} {hA : selector.Eligible A} {δ γ : ℝ}
    (F : BoundedIrreducibilityFailure selector A hA δ γ) :
    CoordinateReplacementState selector where
  ambientDimension := (selector.chosen A hA).dimension
  points := F.nextPoints
  eligible := F.shifted_eligible

/-- The exact coordinate-replacement relation generated by failures of
Definition 9. -/
def CoordinateReplacement (selector : BoundedCFPSelector C) (δ γ : ℝ)
    (S T : CoordinateReplacementState selector) : Prop :=
  ∃ F : BoundedIrreducibilityFailure selector S.points S.eligible δ γ,
    T = F.nextState

namespace CoordinateReplacement

variable {selector : BoundedCFPSelector C} {δ γ : ℝ}
  {S T : CoordinateReplacementState selector}

/-- A coordinate replacement preserves vector nonaveraging. -/
theorem nonaveraging (hST : CoordinateReplacement selector δ γ S T)
    (hS : IsBoxNonaveraging S.points) :
    IsBoxNonaveraging T.points := by
  obtain ⟨F, rfl⟩ := hST
  exact F.nextPoints_nonaveraging hS

/-- A coordinate replacement retains at least a `delta` fraction of the
current population, before the next CFP core loss. -/
theorem dense (hST : CoordinateReplacement selector δ γ S T) :
    δ * (S.points.card : ℝ) ≤ (T.points.card : ℝ) := by
  obtain ⟨F, rfl⟩ := hST
  exact F.dense_nextPoints

end CoordinateReplacement

/-- Nonaveraging is preserved along the reflexive-transitive closure of
eligible coordinate replacements. -/
theorem nonaveraging_of_coordinateReachable
    {selector : BoundedCFPSelector C} {δ γ : ℝ}
    {S T : CoordinateReplacementState selector}
    (hST : Relation.ReflTransGen (CoordinateReplacement selector δ γ) S T)
    (hS : IsBoxNonaveraging S.points) :
    IsBoxNonaveraging T.points := by
  exact Relation.ReflTransGen.trans_induction_on hST
    (fun _ h ↦ h)
    (fun hstep h ↦ hstep.nonaveraging h)
    (fun _ _ ih₁ ih₂ h ↦ ih₂ (ih₁ h)) hS

/-- Cardinality is nonincreasing along every reachable coordinate
replacement, not only along a chosen trace. -/
theorem card_le_of_coordinateReachable
    {selector : BoundedCFPSelector C} {δ γ : ℝ}
    {S T : CoordinateReplacementState selector}
    (hST : Relation.ReflTransGen (CoordinateReplacement selector δ γ) S T) :
    T.points.card ≤ S.points.card := by
  exact Relation.ReflTransGen.trans_induction_on hST
    (fun _ ↦ le_rfl)
    (fun hstep ↦ by
      obtain ⟨F, rfl⟩ := hstep
      calc
        F.nextState.points.card = F.retained.card := F.card_nextPoints
        _ ≤ (selector.chosen _ _).identifiedCore.card :=
          Finset.card_le_card F.retained_subset
        _ = (selector.chosen _ _).core.card :=
          (selector.chosen _ _).card_identifiedCore
        _ ≤ _ := Finset.card_le_card (selector.chosen _ _).witness.core_subset)
    (fun _ _ h₁ h₂ ↦ h₂.trans h₁)

namespace RelationTrace

/-- Nonaveraging is preserved at every point of a coordinate replacement
trace. -/
theorem coordinate_nonaveraging
    {selector : BoundedCFPSelector C} {δ γ : ℝ}
    {initial : CoordinateReplacementState selector} {length : ℕ}
    (T : RelationTrace (CoordinateReplacement selector δ γ) initial length)
    (hzero : IsBoxNonaveraging initial.points) {m : ℕ} (hm : m ≤ length) :
    IsBoxNonaveraging (T.state m).points := by
  apply nonaveraging_of_coordinateReachable (T.reachable hm)
  simpa only [T.state_zero] using hzero

/-- Iterating the exact density retention of each coordinate replacement. -/
theorem coordinate_retention_pow_mul_card_le
    {selector : BoundedCFPSelector C} {δ γ : ℝ}
    {initial : CoordinateReplacementState selector} {length : ℕ}
    (T : RelationTrace (CoordinateReplacement selector δ γ) initial length)
    (hδ : 0 ≤ δ) {m : ℕ} (hm : m ≤ length) :
    δ ^ m * ((T.state 0).points.card : ℝ) ≤
      ((T.state m).points.card : ℝ) := by
  induction m with
  | zero => simp
  | succ m ih =>
      have hm' : m ≤ length := by omega
      have hstep := (T.valid m (by omega)).dense
      specialize ih hm'
      rw [pow_succ]
      calc
        δ ^ m * δ * ((T.state 0).points.card : ℝ) =
            δ * (δ ^ m * ((T.state 0).points.card : ℝ)) := by ring
        _ ≤ δ * ((T.state m).points.card : ℝ) :=
          mul_le_mul_of_nonneg_left ih hδ
        _ ≤ ((T.state (m + 1)).points.card : ℝ) := hstep

end RelationTrace

/-- Failure of irreducibility is equivalent to the existence of an eligible
coordinate replacement. -/
theorem not_stateIrreducible_iff_exists_replacement
    (selector : BoundedCFPSelector C) (δ γ : ℝ)
    (S : CoordinateReplacementState selector) :
    ¬ S.Irreducible δ γ ↔
      ∃ T, CoordinateReplacement selector δ γ S T := by
  rw [CoordinateReplacementState.Irreducible,
    not_boundedCoordinateIrreducible_iff]
  constructor
  · rintro ⟨F⟩
    exact ⟨F.nextState, F, rfl⟩
  · rintro ⟨T, F, _hT⟩
    exact ⟨F⟩

/-- **Irreducible replacement, exact terminal form.**  If the quantitative
estimates of Lemmas 6--8 give a common bound on every eligible failure trace,
then a reachable bounded-coordinate-irreducible set exists. -/
theorem exists_irreducible_replacement_of_trace_bound
    (selector : BoundedCFPSelector C) (δ γ : ℝ)
    (initial : CoordinateReplacementState selector) (bound : ℕ)
    (trace_bound : ∀ {length : ℕ},
      RelationTrace (CoordinateReplacement selector δ γ) initial length →
        length ≤ bound) :
    ∃ S, Relation.ReflTransGen (CoordinateReplacement selector δ γ) initial S ∧
      S.Irreducible δ γ := by
  apply exists_reachable_terminal_of_trace_bound
    (CoordinateReplacement selector δ γ)
    (fun S ↦ S.Irreducible δ γ) initial bound
  · intro S _hreachable hnot
    exact (not_stateIrreducible_iff_exists_replacement
      selector δ γ S).mp hnot
  · exact trace_bound

/-- The preceding terminal replacement can be chosen nonaveraging whenever
the initial set is nonaveraging. -/
theorem exists_nonaveraging_irreducible_replacement_of_trace_bound
    (selector : BoundedCFPSelector C) (δ γ : ℝ)
    (initial : CoordinateReplacementState selector) (bound : ℕ)
    (hNA : IsBoxNonaveraging initial.points)
    (trace_bound : ∀ {length : ℕ},
      RelationTrace (CoordinateReplacement selector δ γ) initial length →
        length ≤ bound) :
    ∃ S, Relation.ReflTransGen (CoordinateReplacement selector δ γ) initial S ∧
      S.Irreducible δ γ ∧ IsBoxNonaveraging S.points := by
  obtain ⟨S, hreach, hirr⟩ :=
    exists_irreducible_replacement_of_trace_bound
      selector δ γ initial bound trace_bound
  exact ⟨S, hreach, hirr,
    nonaveraging_of_coordinateReachable hreach hNA⟩

end

end Erdos186.PZ.Reduction
