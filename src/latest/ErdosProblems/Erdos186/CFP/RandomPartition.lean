import ErdosProblems.Erdos186.CFP.Stability

/-!
# Random finite partitions in the CFP argument

This file contains the finite probabilistic-method step behind Conlon--Fox--
Pham, Lemma 2.34, and the random partition at the start of the proof of their
Theorem 1.5.

The paper invokes a hypergeometric Hoeffding estimate.  Here we use an exact
finite counting substitute.  An obstacle is split into `t + 1` disjoint
chunks, each of size `r`.  A uniformly chosen coloring by `q + 1` colors
misses a fixed chunk in a fixed color in exactly

`q ^ r * (q + 1) ^ (N - r)`

of the `(q + 1) ^ N` colorings.  A union bound therefore produces one
coloring which meets every chunk in every color.  Every color class then has
more than `t` points in every obstacle, even after any `t` deletions.

The final section specializes the obstacle family to proper generated
subgroups.  Since the subgroup generated by a survivor is itself one of the
finitely many subgroups generated by subsets of the original finite set, the
robust hitting event implies exact equality of generated subgroups.  This is
the subgroup-span clause of CFP Lemma 2.34 and precisely the clause used in
the event `E` in the proof of Theorem 1.5.
-/

namespace Erdos186.CFP.RandomPartition

open scoped BigOperators
open Stability

/-! ## Color classes and exact avoidance counts -/

variable {X I : Type*} [Fintype X] [DecidableEq X]
  [Fintype I] [DecidableEq I]

/-- The elements assigned a specified color. -/
def colorClass {q : ℕ} (c : X → Fin (q + 1)) (i : Fin (q + 1)) :
    Finset X :=
  Finset.univ.filter fun x ↦ c x = i

@[simp]
theorem mem_colorClass_iff {q : ℕ} {c : X → Fin (q + 1)}
    {i : Fin (q + 1)} {x : X} :
    x ∈ colorClass c i ↔ c x = i := by
  simp [colorClass]

/-- The color classes form an exact partition of the finite ground type. -/
theorem mem_exactly_one_colorClass {q : ℕ} (c : X → Fin (q + 1)) (x : X) :
    ∃! i, x ∈ colorClass c i := by
  refine ⟨c x, by simp, ?_⟩
  intro i hi
  exact (mem_colorClass_iff.mp hi).symm

theorem colorClass_disjoint {q : ℕ} (c : X → Fin (q + 1))
    {i j : Fin (q + 1)} (hij : i ≠ j) :
    Disjoint (colorClass c i) (colorClass c j) := by
  rw [Finset.disjoint_left]
  intro x hxi hxj
  exact hij ((mem_colorClass_iff.mp hxi).symm.trans
    (mem_colorClass_iff.mp hxj))

theorem biUnion_colorClass {q : ℕ} (c : X → Fin (q + 1)) :
    (Finset.univ : Finset (Fin (q + 1))).biUnion (colorClass c) =
      (Finset.univ : Finset X) := by
  ext x
  simp [mem_colorClass_iff]

/-! ## A logarithmic numerical bound -/

/-- One block of `q` trials gains a factor of at least two over avoiding one
specified color.  This elementary binomial estimate is the exact finite
replacement for the exponential estimate used in the paper. -/
theorem two_mul_pow_le_succ_pow (q : ℕ) (hq : 0 < q) :
    2 * q ^ q ≤ (q + 1) ^ q := by
  rw [show q + 1 = 1 + q by omega, add_pow]
  let term : ℕ → ℕ := fun m ↦ 1 ^ m * q ^ (q - m) * q.choose m
  have hsub : ({0, 1} : Finset ℕ) ⊆ Finset.range (q + 1) := by
    intro m hm
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm
    rcases hm with rfl | rfl <;> simp [hq]
  have hle : (∑ m ∈ ({0, 1} : Finset ℕ), term m) ≤
      ∑ m ∈ Finset.range (q + 1), term m :=
    Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ ↦ Nat.zero_le _)
  have hpred : q ^ (q - 1) * q = q ^ q := by
    rw [← pow_succ]
    congr 1
    omega
  simpa [term, Nat.choose_one_right, hpred, two_mul] using hle

/-- Iterating the preceding block estimate: `q * k` sampled points suppress
avoidance by a factor of at least `2^k`. -/
theorem two_pow_mul_pow_le_succ_pow (q k : ℕ) (hq : 0 < q) :
    2 ^ k * q ^ (q * k) ≤ (q + 1) ^ (q * k) := by
  have hpow := Nat.pow_le_pow_left (two_mul_pow_le_succ_pow q hq) k
  simpa [mul_pow, pow_mul, mul_assoc, mul_left_comm, mul_comm] using hpow

/-- The exact union-bound inequality follows from a base-two bound on the
number of bad events. -/
theorem coloring_union_bound_of_two_pow {M q k N : ℕ} (hq : 0 < q)
    (hevents : M * (q + 1) < 2 ^ k) (hrange : q * k ≤ N) :
    M * (q + 1) *
        (q ^ (q * k) * (q + 1) ^ (N - q * k)) <
      (q + 1) ^ N := by
  have hqpow : 0 < q ^ (q * k) := pow_pos hq _
  have hratio : M * (q + 1) * q ^ (q * k) <
      (q + 1) ^ (q * k) :=
    ((Nat.mul_lt_mul_right hqpow).mpr hevents).trans_le
      (two_pow_mul_pow_le_succ_pow q k hq)
  have htail : 0 < (q + 1) ^ (N - q * k) := by positivity
  calc
    M * (q + 1) *
          (q ^ (q * k) * (q + 1) ^ (N - q * k)) =
        (M * (q + 1) * q ^ (q * k)) *
          (q + 1) ^ (N - q * k) := by ring
    _ < (q + 1) ^ (q * k) * (q + 1) ^ (N - q * k) :=
      (Nat.mul_lt_mul_right htail).mpr hratio
    _ = (q + 1) ^ N := pow_mul_pow_sub _ hrange

/-- Choosing one more than the binary logarithm of the number of bad events
automatically discharges the exact union-bound inequality. -/
theorem coloring_union_bound_logarithmic (M q N : ℕ) (hq : 0 < q)
    (hrange : q * (Nat.log 2 (M * (q + 1)) + 1) ≤ N) :
    M * (q + 1) *
        (q ^ (q * (Nat.log 2 (M * (q + 1)) + 1)) *
          (q + 1) ^
            (N - q * (Nat.log 2 (M * (q + 1)) + 1))) <
      (q + 1) ^ N := by
  apply coloring_union_bound_of_two_pow hq _ hrange
  exact Nat.lt_pow_succ_log_self Nat.one_lt_two _

/-- Turn a function on the partial domain `s` into an ordinary function when
`s` is the whole finite type. -/
private def totalize {q : ℕ}
    (f : ∀ x : X, x ∈ (Finset.univ : Finset X) → Fin (q + 1)) :
    X → Fin (q + 1) :=
  fun x ↦ f x (Finset.mem_univ x)

private theorem totalize_injective {q : ℕ} :
    Function.Injective (totalize (X := X) (q := q)) := by
  intro f g h
  funext x hx
  exact congrFun h x

/-- All colorings which do not use color `i` anywhere on `T`.  The definition
as an image of `Finset.pi` makes the exact cardinality transparent. -/
private noncomputable def avoidingColorings {q : ℕ}
    (T : Finset X) (i : Fin (q + 1)) : Finset (X → Fin (q + 1)) := by
  classical
  exact ((Finset.univ : Finset X).pi fun x ↦
    if x ∈ T then (Finset.univ.erase i) else Finset.univ).image totalize

private theorem mem_avoidingColorings_iff {q : ℕ}
    {T : Finset X} {i : Fin (q + 1)} {c : X → Fin (q + 1)} :
    c ∈ avoidingColorings T i ↔ ∀ x ∈ T, c x ≠ i := by
  classical
  constructor
  · intro hc
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hc
    intro x hxT hxi
    have hx := Finset.mem_pi.mp hf x (Finset.mem_univ x)
    simp only [if_pos hxT, Finset.mem_erase, Finset.mem_univ, and_true] at hx
    exact hx hxi
  · intro hc
    let f : ∀ x : X, x ∈ (Finset.univ : Finset X) → Fin (q + 1) :=
      fun x _ ↦ c x
    have hf : f ∈ (Finset.univ : Finset X).pi (fun x ↦
        if x ∈ T then (Finset.univ.erase i) else Finset.univ) := by
      apply Finset.mem_pi.mpr
      intro x hx
      by_cases hxT : x ∈ T
      · simp only [hxT, if_true, Finset.mem_erase, Finset.mem_univ, and_true]
        exact hc x hxT
      · simp [hxT]
    apply Finset.mem_image.mpr
    refine ⟨f, hf, ?_⟩
    funext x
    rfl

/-- Exact finite analogue of the one-obstacle hypergeometric calculation.
There are `q` allowed colors on `T` and `q + 1` elsewhere. -/
private theorem card_avoidingColorings {q r : ℕ}
    {T : Finset X} (hT : T.card = r) (i : Fin (q + 1)) :
    (avoidingColorings T i).card =
      q ^ r * (q + 1) ^ (Fintype.card X - r) := by
  classical
  rw [avoidingColorings,
    Finset.card_image_of_injective _ (totalize_injective (X := X)),
    Finset.card_pi]
  simp only [apply_ite]
  change (∏ x ∈ (Finset.univ : Finset X),
      if x ∈ T then
        ((Finset.univ : Finset (Fin (q + 1))).erase i).card
      else (Finset.univ : Finset (Fin (q + 1))).card) = _
  rw [Finset.prod_ite]
  have hyes : (Finset.univ : Finset X).filter (fun x ↦ x ∈ T) = T := by
    ext x
    simp
  have hno : (Finset.univ : Finset X).filter (fun x ↦ x ∉ T) =
      Finset.univ \ T := by
    ext x
    simp
  rw [hyes, hno]
  simp only [Finset.card_erase_of_mem (Finset.mem_univ i), Finset.card_univ,
    Fintype.card_fin, Finset.prod_const, Finset.card_sdiff_of_subset
      (Finset.subset_univ T), hT]
  congr 2 <;> omega

/-! ## Chunk systems and the union bound -/

/-- A certificate that every obstacle contains `t + 1` pairwise disjoint
chunks of a common size `r`. -/
structure ChunkSystem (obstacle : I → Finset X) (t r : ℕ) where
  chunk : I → Fin (t + 1) → Finset X
  chunk_subset : ∀ o j, chunk o j ⊆ obstacle o
  card_chunk : ∀ o j, (chunk o j).card = r
  disjoint_chunk : ∀ o, ∀ {j k}, j ≠ k → Disjoint (chunk o j) (chunk o k)

/-- A finite set of size at least `k * r` contains `k` pairwise disjoint
`r`-element chunks. -/
private theorem exists_disjoint_chunks (B : Finset X) (k r : ℕ)
    (hsize : k * r ≤ B.card) :
    ∃ chunk : Fin k → Finset X,
      (∀ j, chunk j ⊆ B) ∧
      (∀ j, (chunk j).card = r) ∧
      (∀ {j l}, j ≠ l → Disjoint (chunk j) (chunk l)) := by
  classical
  induction k generalizing B with
  | zero =>
      refine ⟨Fin.elim0, ?_, ?_, ?_⟩
      · intro j
        exact Fin.elim0 j
      · intro j
        exact Fin.elim0 j
      · intro j
        exact Fin.elim0 j
  | succ k ih =>
      have hrB : r ≤ B.card := by
        rw [Nat.succ_mul] at hsize
        omega
      obtain ⟨T, hTB, hTcard⟩ := Finset.exists_subset_card_eq hrB
      have hkrem : k * r ≤ (B \ T).card := by
        rw [Finset.card_sdiff_of_subset hTB, hTcard]
        rw [Nat.succ_mul] at hsize
        omega
      obtain ⟨old, holdsub, holdcard, holddis⟩ := ih (B \ T) hkrem
      let chunk : Fin (k + 1) → Finset X := fun j ↦
        if hj : j = 0 then T else old (j.pred hj)
      refine ⟨chunk, ?_, ?_, ?_⟩
      · intro j
        by_cases hj : j = 0
        · simpa [chunk, hj] using hTB
        · simp only [chunk, hj, ↓reduceDIte]
          exact (holdsub (j.pred hj)).trans Finset.sdiff_subset
      · intro j
        by_cases hj : j = 0
        · simpa [chunk, hj] using hTcard
        · simp only [chunk, hj, ↓reduceDIte]
          exact holdcard (j.pred hj)
      · intro j l hne
        by_cases hj : j = 0
        · by_cases hl : l = 0
          · exact False.elim (hne (hj.trans hl.symm))
          · simp only [chunk, hj, hl, ↓reduceDIte]
            apply Finset.disjoint_left.mpr
            intro x hxT hxold
            exact (Finset.mem_sdiff.mp (holdsub (l.pred hl) hxold)).2 hxT
        · by_cases hl : l = 0
          · simp only [chunk, hj, hl, ↓reduceDIte]
            apply Finset.disjoint_left.mpr
            intro x hxold hxT
            exact (Finset.mem_sdiff.mp (holdsub (j.pred hj) hxold)).2 hxT
          · simp only [chunk, hj, hl, ↓reduceDIte]
            apply holddis
            intro hpred
            apply hne
            apply Fin.ext
            have hval := congrArg Fin.val hpred
            simp only [Fin.val_pred] at hval
            have hjpos : 0 < (j : ℕ) := Nat.pos_of_ne_zero (by
              intro hz
              apply hj
              exact Fin.ext hz)
            have hlpos : 0 < (l : ℕ) := Nat.pos_of_ne_zero (by
              intro hz
              apply hl
              exact Fin.ext hz)
            omega

/-- Cardinal lower bounds on a finite obstacle family produce the chunk
certificate used by the exact union bound. -/
theorem exists_chunkSystem_of_card {t r : ℕ} {obstacle : I → Finset X}
    (hsize : ∀ o, (t + 1) * r ≤ (obstacle o).card) :
    Nonempty (ChunkSystem obstacle t r) := by
  classical
  choose chunk hsub hcard hdis using fun o ↦
    exists_disjoint_chunks (obstacle o) (t + 1) r (hsize o)
  exact ⟨{
    chunk := chunk
    chunk_subset := hsub
    card_chunk := hcard
    disjoint_chunk := fun o _ _ hne ↦ hdis o hne
  }⟩

/-- The union of the bad events: some color misses some certified chunk. -/
private noncomputable def badColorings {q t r : ℕ}
    {obstacle : I → Finset X} (chunks : ChunkSystem obstacle t r) :
    Finset (X → Fin (q + 1)) := by
  classical
  exact (Finset.univ : Finset (I × Fin (t + 1))).biUnion fun p ↦
    (Finset.univ : Finset (Fin (q + 1))).biUnion fun i ↦
      avoidingColorings (chunks.chunk p.1 p.2) i

/-- Exact union-bound estimate for bad colorings. -/
private theorem card_badColorings_le {q t r : ℕ}
    {obstacle : I → Finset X} (chunks : ChunkSystem obstacle t r) :
    (badColorings (q := q) chunks).card ≤
      Fintype.card (I × Fin (t + 1)) * (q + 1) *
        (q ^ r * (q + 1) ^ (Fintype.card X - r)) := by
  classical
  unfold badColorings
  calc
    ((Finset.univ : Finset (I × Fin (t + 1))).biUnion fun p ↦
        (Finset.univ : Finset (Fin (q + 1))).biUnion fun i ↦
          avoidingColorings (chunks.chunk p.1 p.2) i).card
        ≤ ∑ p : I × Fin (t + 1),
            ((Finset.univ : Finset (Fin (q + 1))).biUnion fun i ↦
              avoidingColorings (chunks.chunk p.1 p.2) i).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ _p : I × Fin (t + 1),
          (q + 1) * (q ^ r * (q + 1) ^ (Fintype.card X - r)) := by
      apply Finset.sum_le_sum
      intro p hp
      simpa using
        (Finset.card_biUnion_le_card_mul
          (Finset.univ : Finset (Fin (q + 1)))
          (fun i ↦ avoidingColorings (chunks.chunk p.1 p.2) i)
          (q ^ r * (q + 1) ^ (Fintype.card X - r))
          (by
            intro i hi
            rw [card_avoidingColorings (chunks.card_chunk p.1 p.2) i]))
    _ = Fintype.card (I × Fin (t + 1)) * (q + 1) *
          (q ^ r * (q + 1) ^ (Fintype.card X - r)) := by
      simp [mul_assoc]

/-- Finite probabilistic method: if the union-bound numerator is smaller
than the exact number of colorings, there is a coloring hitting every chunk
in every color. -/
theorem exists_coloring_hits_every_chunk {q t r : ℕ}
    {obstacle : I → Finset X} (chunks : ChunkSystem obstacle t r)
    (hcount :
      Fintype.card (I × Fin (t + 1)) * (q + 1) *
          (q ^ r * (q + 1) ^ (Fintype.card X - r)) <
        (q + 1) ^ Fintype.card X) :
    ∃ c : X → Fin (q + 1),
      ∀ o j i, (chunks.chunk o j ∩ colorClass c i).Nonempty := by
  classical
  have hbad : (badColorings (q := q) chunks).card <
      (Finset.univ : Finset (X → Fin (q + 1))).card := by
    apply lt_of_le_of_lt (card_badColorings_le chunks)
    simpa [Fintype.card_fun] using hcount
  have hex : ∃ c : X → Fin (q + 1),
      c ∉ badColorings (q := q) chunks := by
    by_contra h
    push_neg at h
    have hsub : (Finset.univ : Finset (X → Fin (q + 1))) ⊆
        badColorings (q := q) chunks := by
      intro c hc
      exact h c
    exact (Nat.not_lt_of_ge (Finset.card_le_card hsub)) hbad
  obtain ⟨c, hc⟩ := hex
  refine ⟨c, ?_⟩
  intro o j i
  by_contra hempty
  rw [Finset.not_nonempty_iff_eq_empty] at hempty
  have havoid : c ∈ avoidingColorings (chunks.chunk o j) i := by
    rw [mem_avoidingColorings_iff]
    intro x hx hxi
    have hxcolor : x ∈ colorClass c i := mem_colorClass_iff.mpr hxi
    have : x ∈ chunks.chunk o j ∩ colorClass c i :=
      Finset.mem_inter.mpr ⟨hx, hxcolor⟩
    simpa [hempty] using this
  apply hc
  apply Finset.mem_biUnion.mpr
  refine ⟨(o, j), Finset.mem_univ _, ?_⟩
  exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, havoid⟩

/-- Meeting `t + 1` disjoint chunks leaves more than `t` elements of every
obstacle in every color class.  This is the resilience conclusion for one
random-coloring partition. -/
theorem exists_coloring_robust_on_obstacles {q t r : ℕ}
    {obstacle : I → Finset X} (chunks : ChunkSystem obstacle t r)
    (hcount :
      Fintype.card (I × Fin (t + 1)) * (q + 1) *
          (q ^ r * (q + 1) ^ (Fintype.card X - r)) <
        (q + 1) ^ Fintype.card X) :
    ∃ c : X → Fin (q + 1),
      ∀ o i, t < (colorClass c i ∩ obstacle o).card := by
  classical
  obtain ⟨c, hc⟩ := exists_coloring_hits_every_chunk chunks hcount
  refine ⟨c, ?_⟩
  intro o i
  choose point hpoint using fun j ↦ (hc o j i).exists_mem
  let f : Fin (t + 1) → {x // x ∈ colorClass c i ∩ obstacle o} :=
    fun j ↦ ⟨point j, Finset.mem_inter.mpr
      ⟨(Finset.mem_inter.mp (hpoint j)).2,
        chunks.chunk_subset o j (Finset.mem_inter.mp (hpoint j)).1⟩⟩
  have hf : Function.Injective f := by
    intro j k hjk
    by_contra hne
    have hdisj := chunks.disjoint_chunk o hne
    rw [Finset.disjoint_left] at hdisj
    apply hdisj (Finset.mem_inter.mp (hpoint j)).1
    have hpointeq : point j = point k := by
      change point j = point k
      exact congrArg Subtype.val hjk
    rw [hpointeq]
    exact (Finset.mem_inter.mp (hpoint k)).1
  have hcard : Fintype.card (Fin (t + 1)) ≤
      Fintype.card {x // x ∈ colorClass c i ∩ obstacle o} :=
    Fintype.card_le_of_injective f hf
  simp only [Fintype.card_fin, Fintype.card_coe] at hcard
  omega

/-- Logarithmic form of the finite coloring lemma.  The chunk size is chosen
internally as

`q * (log₂(number of bad events) + 1)`,

so the caller supplies only the source-shaped lower bound saying that every
obstacle contains `t + 1` such chunks.  There is no union-bound inequality in
the hypotheses. -/
theorem exists_coloring_robust_on_obstacles_logarithmic {q t : ℕ}
    {obstacle : I → Finset X} (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card (I × Fin (t + 1)) * (q + 1)) + 1) ≤
        Fintype.card X)
    (hsize : ∀ o,
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card (I × Fin (t + 1)) * (q + 1)) + 1)) ≤
        (obstacle o).card) :
    ∃ c : X → Fin (q + 1),
      ∀ o i, t < (colorClass c i ∩ obstacle o).card := by
  classical
  let r := q * (Nat.log 2
    (Fintype.card (I × Fin (t + 1)) * (q + 1)) + 1)
  let chunks : ChunkSystem obstacle t r :=
    Classical.choice (exists_chunkSystem_of_card hsize)
  apply exists_coloring_robust_on_obstacles chunks
  simpa [r] using coloring_union_bound_logarithmic
    (Fintype.card (I × Fin (t + 1))) q (Fintype.card X) hq hrange

/-! ## The generated-subgroup specialization -/

section Span

variable {D : Type*} [Fintype D] [DecidableEq D]
  (G : D → Type*) [∀ d, AddGroup (G d)]
  [∀ d, DecidableEq (G d)]
  (φ : ∀ d, X → G d)

/-- The tuple of additive subgroups generated by a finite set in each
coordinate group. -/
private def generatedProfile (S : Finset X) : ∀ d, AddSubgroup (G d) :=
  fun d ↦ AddSubgroup.closure (φ d '' (S : Set X))

private theorem generatedProfile_mono {S T : Finset X} (hST : S ⊆ T) :
    ∀ d, generatedProfile G φ S d ≤ generatedProfile G φ T d := by
  intro d
  apply AddSubgroup.closure_mono
  exact Set.image_mono (by exact_mod_cast hST)

/-- The finite type of all proper subgroups which arise as the subgroup
generated by a subset of the original finite ground type. -/
private abbrev SpanIndex :=
  Σ d : D,
    {S : Finset X //
      generatedProfile G φ S d < generatedProfile G φ Finset.univ d}

private noncomputable instance : Fintype (SpanIndex G φ) := by
  classical
  exact Fintype.ofFinite _

/-- The elements outside one of the finitely many candidate proper spans. -/
private noncomputable def spanObstacle (w : SpanIndex G φ) : Finset X := by
  classical
  exact Finset.univ.filter fun x ↦
    φ w.1 x ∉ generatedProfile G φ w.2.1 w.1

/-- The distinct subgroup values generated by subsets of the ground type. -/
noncomputable def generatedSubgroupValues (d : D) :
    Finset (AddSubgroup (G d)) := by
  classical
  exact Finset.univ.powerset.image fun S ↦ generatedProfile G φ S d

/-- Candidate proper spans indexed by their subgroup value, rather than by a
possibly highly redundant generating subset.  This is the index whose
cardinality is bounded in the source argument. -/
abbrev DistinctSpanIndex :=
  Σ d : D,
    {H : AddSubgroup (G d) //
      H ∈ generatedSubgroupValues G φ d ∧
        H < generatedProfile G φ Finset.univ d}

noncomputable instance : Fintype (DistinctSpanIndex G φ) := by
  classical
  letI : ∀ d : D,
      Fintype {H : AddSubgroup (G d) //
        H ∈ generatedSubgroupValues G φ d ∧
          H < generatedProfile G φ Finset.univ d} := fun d ↦
    Fintype.ofFinset
      ((generatedSubgroupValues G φ d).filter fun H ↦
        H < generatedProfile G φ Finset.univ d) (by
          intro H
          rw [Finset.mem_filter]
          rfl)
  infer_instance

/-- The complement of a distinct candidate proper span. -/
noncomputable def distinctSpanObstacle (w : DistinctSpanIndex G φ) :
    Finset X := by
  classical
  exact Finset.univ.filter fun x ↦ φ w.1 x ∉ w.2.1

/-- Public closure-form elimination rule for membership in
`generatedSubgroupValues`.  This keeps the internal profile representation
out of downstream random-partition interfaces. -/
theorem exists_closure_eq_of_mem_generatedSubgroupValues (d : D)
    {H : AddSubgroup (G d)} (hH : H ∈ generatedSubgroupValues G φ d) :
    ∃ S : Finset X, AddSubgroup.closure (φ d '' (S : Set X)) = H := by
  classical
  obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hH
  exact ⟨S, by rfl⟩

/-- Public closure-form properness clause of a distinct span index. -/
theorem distinctSpanIndex_lt_closure_univ (w : DistinctSpanIndex G φ) :
    w.2.1 < AddSubgroup.closure (φ w.1 '' ((Finset.univ : Finset X) : Set X)) := by
  simpa [generatedProfile] using w.2.2.2

/-- If every color class contains more than `t` points outside every proper
subset-generated subgroup, then deleting at most `t` points from a color
class preserves the full generated subgroup in every coordinate. -/
theorem generatedProfile_eq_of_robust_obstacles {q t : ℕ}
    (c : X → Fin (q + 1))
    (hrobust : ∀ w : SpanIndex G φ, ∀ i,
      t < (colorClass c i ∩ spanObstacle G φ w).card) :
    ∀ i {S : Finset X}, S ⊆ colorClass c i →
      (colorClass c i).card ≤ S.card + t →
      ∀ d,
        generatedProfile G φ S d = generatedProfile G φ Finset.univ d := by
  classical
  intro i S hS hloss d
  apply le_antisymm
  · exact generatedProfile_mono G φ
      (hS.trans (Finset.subset_univ _)) d
  · by_contra hnot
    have hle : generatedProfile G φ S d ≤
        generatedProfile G φ Finset.univ d :=
      generatedProfile_mono G φ
        (hS.trans (Finset.subset_univ _)) d
    have hlt : generatedProfile G φ S d <
        generatedProfile G φ Finset.univ d :=
      lt_of_le_of_ne hle (by
        intro heq
        apply hnot
        rw [heq])
    let w : SpanIndex G φ := ⟨d, ⟨S, hlt⟩⟩
    have hout : colorClass c i ∩ spanObstacle G φ w ⊆
        colorClass c i \ S := by
      intro x hx
      have hxcolor := (Finset.mem_inter.mp hx).1
      have hxoutside := (Finset.mem_inter.mp hx).2
      simp only [spanObstacle, Finset.mem_filter, Finset.mem_univ,
        true_and] at hxoutside
      apply Finset.mem_sdiff.mpr
      refine ⟨hxcolor, ?_⟩
      intro hxS
      apply hxoutside
      exact AddSubgroup.subset_closure
        ⟨x, by exact_mod_cast hxS, rfl⟩
    have hcard := Finset.card_le_card hout
    have hsdiff : (colorClass c i \ S).card =
        (colorClass c i).card - S.card :=
      Finset.card_sdiff_of_subset hS
    have hupper : (colorClass c i \ S).card ≤ t := by
      rw [hsdiff]
      omega
    have := hrobust w i
    omega

/-- Distinct-value version of `generatedProfile_eq_of_robust_obstacles`. -/
theorem generatedProfile_eq_of_distinct_robust_obstacles {q t : ℕ}
    (c : X → Fin (q + 1))
    (hrobust : ∀ w : DistinctSpanIndex G φ, ∀ i,
      t < (colorClass c i ∩ distinctSpanObstacle G φ w).card) :
    ∀ i {S : Finset X}, S ⊆ colorClass c i →
      (colorClass c i).card ≤ S.card + t →
      ∀ d,
        generatedProfile G φ S d = generatedProfile G φ Finset.univ d := by
  classical
  intro i S hS hloss d
  apply le_antisymm
  · exact generatedProfile_mono G φ
      (hS.trans (Finset.subset_univ _)) d
  · by_contra hnot
    have hle : generatedProfile G φ S d ≤
        generatedProfile G φ Finset.univ d :=
      generatedProfile_mono G φ
        (hS.trans (Finset.subset_univ _)) d
    have hlt : generatedProfile G φ S d <
        generatedProfile G φ Finset.univ d :=
      lt_of_le_of_ne hle (by
        intro heq
        apply hnot
        rw [heq])
    have hvalue : generatedProfile G φ S d ∈
        generatedSubgroupValues G φ d := by
      simp [generatedSubgroupValues]
    let w : DistinctSpanIndex G φ :=
      ⟨d, ⟨generatedProfile G φ S d, hvalue, hlt⟩⟩
    have hout : colorClass c i ∩ distinctSpanObstacle G φ w ⊆
        colorClass c i \ S := by
      intro x hx
      have hxcolor := (Finset.mem_inter.mp hx).1
      have hxoutside := (Finset.mem_inter.mp hx).2
      simp only [distinctSpanObstacle, Finset.mem_filter, Finset.mem_univ,
        true_and] at hxoutside
      apply Finset.mem_sdiff.mpr
      refine ⟨hxcolor, ?_⟩
      intro hxS
      apply hxoutside
      exact AddSubgroup.subset_closure
        ⟨x, by exact_mod_cast hxS, rfl⟩
    have hcard := Finset.card_le_card hout
    have hsdiff : (colorClass c i \ S).card =
        (colorClass c i).card - S.card :=
      Finset.card_sdiff_of_subset hS
    have hupper : (colorClass c i \ S).card ≤ t := by
      rw [hsdiff]
      omega
    have := hrobust w i
    omega

/-- Exact finite subgroup-span inheritance theorem for a random-coloring
partition.  Its sole numerical hypothesis is the explicit union-bound
inequality; no probabilistic or concentration principle is assumed. -/
theorem exists_coloring_generatedProfile_robust {q t r : ℕ}
    (chunks : ChunkSystem (spanObstacle G φ) t r)
    (hcount :
      Fintype.card (SpanIndex G φ × Fin (t + 1)) * (q + 1) *
          (q ^ r * (q + 1) ^ (Fintype.card X - r)) <
        (q + 1) ^ Fintype.card X) :
    ∃ c : X → Fin (q + 1),
      ∀ i {S : Finset X}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d,
          generatedProfile G φ S d = generatedProfile G φ Finset.univ d := by
  classical
  obtain ⟨c, hc⟩ := exists_coloring_robust_on_obstacles chunks hcount
  exact ⟨c, generatedProfile_eq_of_robust_obstacles G φ c hc⟩

/-- Cardinal lower bounds for all proper-span obstacles are the only
structural input needed by the finite counting argument.  In particular,
callers do not need to construct the disjoint chunks themselves. -/
theorem exists_coloring_generatedProfile_robust_of_card {q t r : ℕ}
    (hsize : ∀ w : SpanIndex G φ,
      (t + 1) * r ≤ (spanObstacle G φ w).card)
    (hcount :
      Fintype.card (SpanIndex G φ × Fin (t + 1)) * (q + 1) *
          (q ^ r * (q + 1) ^ (Fintype.card X - r)) <
        (q + 1) ^ Fintype.card X) :
    ∃ c : X → Fin (q + 1),
      ∀ i {S : Finset X}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d,
          generatedProfile G φ S d = generatedProfile G φ Finset.univ d := by
  classical
  let chunks : ChunkSystem (spanObstacle G φ) t r :=
    Classical.choice (exists_chunkSystem_of_card hsize)
  exact exists_coloring_generatedProfile_robust G φ chunks hcount

/-- Source-shaped logarithmic form of generated-span inheritance.  The exact
counting inequality has been discharged by `coloring_union_bound_logarithmic`;
only the lower bound on proper-span complements remains. -/
theorem exists_coloring_generatedProfile_robust_logarithmic {q t : ℕ}
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card (SpanIndex G φ × Fin (t + 1)) * (q + 1)) + 1) ≤
        Fintype.card X)
    (hsize : ∀ w : SpanIndex G φ,
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card (SpanIndex G φ × Fin (t + 1)) * (q + 1)) + 1)) ≤
        (spanObstacle G φ w).card) :
    ∃ c : X → Fin (q + 1),
      ∀ i {S : Finset X}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d,
          generatedProfile G φ S d = generatedProfile G φ Finset.univ d := by
  classical
  obtain ⟨c, hc⟩ :=
    exists_coloring_robust_on_obstacles_logarithmic hq hrange hsize
  exact ⟨c, generatedProfile_eq_of_robust_obstacles G φ c hc⟩

/-- Logarithmic generated-span inheritance indexed by distinct subgroup
values.  This is the source-scale form used by the final strong-stability
theorem. -/
theorem exists_coloring_distinct_generatedProfile_robust_logarithmic
    {q t : ℕ} (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card (DistinctSpanIndex G φ × Fin (t + 1)) *
            (q + 1)) + 1) ≤ Fintype.card X)
    (hsize : ∀ w : DistinctSpanIndex G φ,
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card (DistinctSpanIndex G φ × Fin (t + 1)) *
              (q + 1)) + 1)) ≤
        (distinctSpanObstacle G φ w).card) :
    ∃ c : X → Fin (q + 1),
      ∀ i {S : Finset X}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d,
          generatedProfile G φ S d = generatedProfile G φ Finset.univ d := by
  classical
  obtain ⟨c, hc⟩ := exists_coloring_robust_on_obstacles_logarithmic
    (obstacle := distinctSpanObstacle G φ) hq hrange hsize
  exact ⟨c, generatedProfile_eq_of_distinct_robust_obstacles G φ c hc⟩

end Span

/-! ## From source span robustness to large proper-span obstacles -/

section SourceSpanRobust

variable {α : Type*} [DecidableEq α]

/-- The points of `A` lying outside the subgroup generated by `B`. -/
noncomputable def outsideGeneratedSubgroup {d : ℕ}
    (φ : α → LatticePoint d) (A B : Finset α) : Finset α := by
  classical
  exact A.filter fun a ↦ φ a ∉ generatedSubgroup φ B

/-- Passing from a finite set to its subtype does not change the subgroup
generated by all of its points. -/
theorem generatedSubgroup_subtype_univ {d : ℕ} (φ : α → LatticePoint d)
    (A : Finset α) :
    generatedSubgroup (fun a : {a // a ∈ A} ↦ φ a.1) Finset.univ =
      generatedSubgroup φ A := by
  unfold generatedSubgroup
  congr 1
  ext y
  simp

/-- The analogous identification for an arbitrary finite set of points in
the subtype. -/
theorem generatedSubgroup_subtype_map {d : ℕ} (φ : α → LatticePoint d)
    (A : Finset α) (B : Finset {a // a ∈ A}) :
    generatedSubgroup (fun a : {a // a ∈ A} ↦ φ a.1) B =
      generatedSubgroup φ (B.map ⟨Subtype.val, Subtype.val_injective⟩) := by
  unfold generatedSubgroup
  congr 1
  ext y
  simp

/-- Span robustness transports to the finite subtype of the original set.
This is the bridge from the preprocessing API, whose ground type is `ℤ`, to
the finite-coloring theorem above. -/
theorem spanRobust_subtype
    {anchor : α} {A : Finset α} {deletionBudget : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → α → LatticePoint d}
    (hrobust : SpanRobust anchor A deletionBudget relevant φ)
    (hanchorA : anchor ∈ A) :
    SpanRobust (⟨anchor, hanchorA⟩ : {a // a ∈ A}) Finset.univ
      deletionBudget relevant (fun d a ↦ φ d a.1) := by
  classical
  intro d hd B hB hcard hanchor
  let e : {a // a ∈ A} ↪ α := ⟨Subtype.val, Subtype.val_injective⟩
  have hmapA : B.map e ⊆ A := by
    intro a ha
    obtain ⟨b, hb, rfl⟩ := Finset.mem_map.mp ha
    exact b.2
  have hcardMap : (B.map e).card = B.card := Finset.card_map e
  have hunivCard : (Finset.univ : Finset {a // a ∈ A}).card = A.card := by
    simp
  have hlarge : A.card ≤ (B.map e).card + deletionBudget := by
    simpa [hunivCard, hcardMap] using hcard
  have hanchorMap : anchor ∈ B.map e := by
    apply Finset.mem_map.mpr
    exact ⟨⟨anchor, hanchorA⟩, hanchor, rfl⟩
  have h := hrobust hd hmapA hlarge hanchorMap
  change generatedSubgroup (fun a : {a // a ∈ A} ↦ φ d a.1) B =
    generatedSubgroup (fun a : {a // a ∈ A} ↦ φ d a.1) Finset.univ
  rw [generatedSubgroup_subtype_map (φ d) A B,
    generatedSubgroup_subtype_univ (φ d) A]
  simpa [e] using h

/-- A genuinely proper subgroup generated by a subset of a span-robust
finite set omits more points of the original set than the permitted deletion
budget.  This is the deterministic bridge from CFP strong stability to the
obstacle lower bounds used by the random-coloring argument above. -/
theorem card_outside_generatedSubgroup_gt
    {anchor : α} {A B : Finset α} {deletionBudget d : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → α → LatticePoint d}
    (hrobust : SpanRobust anchor A deletionBudget relevant φ)
    (hanchorA : anchor ∈ A) (hanchorZero : φ d anchor = 0)
    (hd : d ∈ relevant)
    (hproper : generatedSubgroup (φ d) B < generatedSubgroup (φ d) A) :
    deletionBudget < (outsideGeneratedSubgroup (φ d) A B).card := by
  classical
  by_contra hnot
  have houtside :
      (outsideGeneratedSubgroup (φ d) A B).card ≤ deletionBudget := by omega
  let C := A.filter fun a ↦ φ d a ∈ generatedSubgroup (φ d) B
  have hCA : C ⊆ A := Finset.filter_subset _ _
  have hpartition : C.card +
      (outsideGeneratedSubgroup (φ d) A B).card = A.card := by
    simpa [C, outsideGeneratedSubgroup] using
      (Finset.card_filter_add_card_filter_not
        (s := A) (fun a ↦ φ d a ∈ generatedSubgroup (φ d) B))
  have hlarge : A.card ≤ C.card + deletionBudget := by omega
  have hanchorC : anchor ∈ C := by
    simp only [C, Finset.mem_filter]
    refine ⟨hanchorA, ?_⟩
    rw [hanchorZero]
    exact (generatedSubgroup (φ d) B).zero_mem
  have hfull : generatedSubgroup (φ d) C = generatedSubgroup (φ d) A :=
    hrobust hd hCA hlarge hanchorC
  have hCle : generatedSubgroup (φ d) C ≤ generatedSubgroup (φ d) B := by
    apply (AddSubgroup.closure_le _).mpr
    rintro y ⟨a, haC, rfl⟩
    have haC' : a ∈ C := by exact_mod_cast haC
    exact (Finset.mem_filter.mp haC').2
  exact (not_le_of_gt hproper) (hfull ▸ hCle)

/-- The previous strict lower bound in the multiplicative form needed to
extract `t + 1` disjoint chunks of size `r`. -/
theorem chunk_capacity_of_spanRobust
    {anchor : α} {A B : Finset α} {deletionBudget d t r : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → α → LatticePoint d}
    (hrobust : SpanRobust anchor A deletionBudget relevant φ)
    (hanchorA : anchor ∈ A) (hanchorZero : φ d anchor = 0)
    (hd : d ∈ relevant)
    (hproper : generatedSubgroup (φ d) B < generatedSubgroup (φ d) A)
    (hcapacity : (t + 1) * r ≤ deletionBudget + 1) :
    (t + 1) * r ≤ (outsideGeneratedSubgroup (φ d) A B).card := by
  exact hcapacity.trans (Nat.succ_le_iff.mpr
    (card_outside_generatedSubgroup_gt hrobust hanchorA hanchorZero hd hproper))

/-- Logarithmic random-partition inheritance for the subgroup clause of CFP
strong stability, stated on a finite ground type.  If the original full set
is span-robust with budget `deletionBudget`, and that budget contains
`t + 1` chunks of the logarithmic size forced by the number of candidate
proper spans, then every color class remains full-span after any `t`
deletions.  Neither a tail estimate nor the desired conclusion occurs among
the assumptions. -/
theorem exists_coloring_spanRobust_logarithmic
    {α : Type*} [Fintype α] [DecidableEq α]
    {anchor : α} {deletionBudget q t : ℕ} {relevant : Finset ℕ}
    {φ : (d : ℕ) → α → LatticePoint d}
    (hrobust : SpanRobust anchor Finset.univ deletionBudget relevant φ)
    (hanchorZero : ∀ d ∈ relevant, φ d anchor = 0)
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card
              (SpanIndex
                (fun d : {d // d ∈ relevant} ↦ LatticePoint d.1)
                (fun d a ↦ φ d.1 a) × Fin (t + 1)) *
            (q + 1)) + 1) ≤ Fintype.card α)
    (hcapacity :
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card
                (SpanIndex
                  (fun d : {d // d ∈ relevant} ↦ LatticePoint d.1)
                  (fun d a ↦ φ d.1 a) × Fin (t + 1)) *
              (q + 1)) + 1)) ≤ deletionBudget + 1) :
    ∃ c : α → Fin (q + 1),
      ∀ i {S : Finset α}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d, d ∈ relevant →
          generatedSubgroup (φ d) S =
            generatedSubgroup (φ d) Finset.univ := by
  classical
  let G : {d // d ∈ relevant} → Type :=
    fun d ↦ LatticePoint d.1
  let ψ : ∀ d, α → G d := fun d a ↦ φ d.1 a
  have hsize : ∀ w : SpanIndex G ψ,
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card (SpanIndex G ψ × Fin (t + 1)) *
              (q + 1)) + 1)) ≤
        (spanObstacle G ψ w).card := by
    intro w
    have hw := chunk_capacity_of_spanRobust hrobust
      (Finset.mem_univ anchor) (hanchorZero w.1.1 w.1.2) w.1.2
      (B := w.2.1) (t := t)
      (r := q * (Nat.log 2
        (Fintype.card (SpanIndex G ψ × Fin (t + 1)) * (q + 1)) + 1))
      (by simpa [G, ψ, generatedProfile, generatedSubgroup] using w.2.2)
      hcapacity
    simpa [spanObstacle, outsideGeneratedSubgroup, G, ψ,
      generatedProfile, generatedSubgroup] using hw
  obtain ⟨c, hc⟩ :=
    exists_coloring_generatedProfile_robust_logarithmic G ψ hq hrange hsize
  refine ⟨c, ?_⟩
  intro i S hS hloss d hd
  have h := hc i hS hloss ⟨d, hd⟩
  simpa [G, ψ, generatedProfile, generatedSubgroup] using h

/-- Candidate proper spans after replacing a finite set by its subtype. -/
abbrev FinsetSpanIndex (A : Finset α) (relevant : Finset ℕ)
    (φ : (d : ℕ) → α → LatticePoint d) :=
  SpanIndex
    (fun d : {d // d ∈ relevant} ↦ LatticePoint d.1)
    (fun d (a : {a // a ∈ A}) ↦ φ d.1 a.1)

/-- Distinct-value version of `FinsetSpanIndex`. -/
abbrev FinsetDistinctSpanIndex (A : Finset α) (relevant : Finset ℕ)
    (φ : (d : ℕ) → α → LatticePoint d) :=
  DistinctSpanIndex
    (fun d : {d // d ∈ relevant} ↦ LatticePoint d.1)
    (fun d (a : {a // a ∈ A}) ↦ φ d.1 a.1)

/-- Finset form of `exists_coloring_spanRobust_logarithmic`.  It applies
directly to the `SpanRobust` object returned by CFP preprocessing and colors
the elements of `A` through the finite subtype `{a // a ∈ A}`. -/
theorem exists_coloring_finset_spanRobust_logarithmic
    {anchor : α} {A : Finset α} {deletionBudget q t : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → α → LatticePoint d}
    (hrobust : SpanRobust anchor A deletionBudget relevant φ)
    (hanchorA : anchor ∈ A)
    (hanchorZero : ∀ d ∈ relevant, φ d anchor = 0)
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card (FinsetSpanIndex A relevant φ × Fin (t + 1)) *
            (q + 1)) + 1) ≤ A.card)
    (hcapacity :
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card (FinsetSpanIndex A relevant φ × Fin (t + 1)) *
              (q + 1)) + 1)) ≤ deletionBudget + 1) :
    ∃ c : {a // a ∈ A} → Fin (q + 1),
      ∀ i {S : Finset {a // a ∈ A}}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d, d ∈ relevant →
          generatedSubgroup (fun a : {a // a ∈ A} ↦ φ d a.1) S =
            generatedSubgroup (φ d) A := by
  classical
  have hsub :
      SpanRobust (⟨anchor, hanchorA⟩ : {a // a ∈ A}) Finset.univ
        deletionBudget relevant (fun d a ↦ φ d a.1) :=
    spanRobust_subtype hrobust hanchorA
  obtain ⟨c, hc⟩ := exists_coloring_spanRobust_logarithmic hsub
    (fun d hd ↦ hanchorZero d hd) hq (by simpa using hrange)
    (by simpa using hcapacity)
  refine ⟨c, ?_⟩
  intro i S hS hloss d hd
  rw [← generatedSubgroup_subtype_univ (φ d) A]
  exact hc i hS hloss d hd

/-- Direct corollary for the subgroup component of `StronglyStableFor`.
This is the API used after `Preprocessing.preprocessing_of_spanRankCertificate`.
-/
theorem exists_coloring_stronglyStableFor_span_logarithmic
    {A : Finset ℤ} {box : (d : ℕ) → GAP 1 d}
    {x maxRank differenceBound C0 q t : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → ℤ → LatticePoint d}
    (hstable : StronglyStableFor A box x maxRank differenceBound relevant φ C0)
    (hφzero : ∀ d ∈ relevant, φ d 0 = 0)
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card (FinsetSpanIndex A relevant φ × Fin (t + 1)) *
            (q + 1)) + 1) ≤ A.card)
    (hcapacity :
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card (FinsetSpanIndex A relevant φ × Fin (t + 1)) *
              (q + 1)) + 1)) ≤ x / C0 + 1) :
    ∃ c : {a // a ∈ A} → Fin (q + 1),
      ∀ i {S : Finset {a // a ∈ A}}, S ⊆ colorClass c i →
        (colorClass c i).card ≤ S.card + t →
        ∀ d, d ∈ relevant →
          generatedSubgroup (fun a : {a // a ∈ A} ↦ φ d a.1) S =
            generatedSubgroup (φ d) A := by
  apply exists_coloring_finset_spanRobust_logarithmic hstable.spanRobust
    hstable.weaklyStable.zero_mem hφzero hq hrange hcapacity

end SourceSpanRobust

/-! ## Weak-stability box obstacles -/

section WeakObstacles

/-- Points of an integer set outside a candidate GAP. -/
noncomputable def outsideGAP {d : ℕ} (A : Finset ℤ) (P : GAP 1 d) :
    Finset ℤ := by
  classical
  exact A.filter fun a ↦ integerPoint a ∉ P.carrier

/-- Weak stability forces every admissible smaller GAP containing zero to
omit more than the deletion budget many points. -/
theorem card_outsideGAP_gt
    {A : Finset ℤ} {box : (d : ℕ) → GAP 1 d}
    {x maxRank differenceBound d : ℕ}
    (hweak : WeaklyStableFor A box x maxRank differenceBound)
    (hd : 0 < d) (hdRank : d ≤ maxRank) (P : GAP 1 d)
    (hsteps : HasDifferencesAtMost P differenceBound)
    (hvolume : 4 * P.volume ≤ 3 * (box d).volume)
    (hzeroP : integerPoint 0 ∈ P.carrier) :
    x < (outsideGAP A P).card := by
  classical
  by_contra hnot
  have hout : (outsideGAP A P).card ≤ x := by omega
  let B := A.filter fun a ↦ integerPoint a ∈ P.carrier
  have hBA : B ⊆ A := Finset.filter_subset _ _
  have hpartition : B.card + (outsideGAP A P).card = A.card := by
    simpa [B, outsideGAP] using
      (Finset.card_filter_add_card_filter_not
        (s := A) (fun a ↦ integerPoint a ∈ P.carrier))
  have hlarge : A.card ≤ B.card + x := by omega
  have hzeroB : 0 ∈ B := by
    simp only [B, Finset.mem_filter]
    exact ⟨hweak.zero_mem, hzeroP⟩
  have hcontained : integerPoints B ⊆ P.carrier := by
    intro y hy
    obtain ⟨a, ha, rfl⟩ := mem_integerPoints_iff.mp hy
    exact (Finset.mem_filter.mp ha).2
  exact (hweak.avoids hBA hlarge hzeroB hd hdRank P hsteps hvolume)
    hcontained

/-- A finite enumeration of all weak-stability box traces that can occur on
`A`.  The fields are purely geometric: they enumerate admissible GAPs and
say that every admissible GAP containing zero has the same outside trace on
`A` as one enumerated GAP.  No stability or inheritance conclusion is stored
in this certificate. -/
structure WeakBoxFamily (W : Type*) (A : Finset ℤ)
    (box : (d : ℕ) → GAP 1 d) (maxRank differenceBound : ℕ) where
  dimension : W → ℕ
  gap : ∀ w, GAP 1 (dimension w)
  positive : ∀ w, 0 < dimension w
  rank_le : ∀ w, dimension w ≤ maxRank
  steps_le : ∀ w, HasDifferencesAtMost (gap w) differenceBound
  volume_le : ∀ w, 4 * (gap w).volume ≤ 3 * (box (dimension w)).volume
  zero_mem : ∀ w, integerPoint 0 ∈ (gap w).carrier
  covers : ∀ {d : ℕ}, 0 < d → d ≤ maxRank →
    ∀ P : GAP 1 d, HasDifferencesAtMost P differenceBound →
      4 * P.volume ≤ 3 * (box d).volume →
      integerPoint 0 ∈ P.carrier →
      ∃ w, outsideGAP A P = outsideGAP A (gap w)

/-- The weak-box obstacle represented on the finite subtype of `A`. -/
noncomputable def weakBoxObstacle {W : Type*} {A : Finset ℤ}
    {box : (d : ℕ) → GAP 1 d} {maxRank differenceBound : ℕ}
    (family : WeakBoxFamily W A box maxRank differenceBound) (w : W) :
    Finset {a // a ∈ A} := by
  classical
  exact Finset.univ.filter fun a ↦
    integerPoint a.1 ∉ (family.gap w).carrier

/-- Every obstacle in a geometric weak-box enumeration is large whenever
the source set is weakly stable. -/
theorem card_weakBoxObstacle_gt {W : Type*} {A : Finset ℤ}
    {box : (d : ℕ) → GAP 1 d} {x maxRank differenceBound : ℕ}
    (hweak : WeaklyStableFor A box x maxRank differenceBound)
    (family : WeakBoxFamily W A box maxRank differenceBound) (w : W) :
    x < (weakBoxObstacle family w).card := by
  classical
  have h := card_outsideGAP_gt hweak (family.positive w)
    (family.rank_le w) (family.gap w) (family.steps_le w)
    (family.volume_le w) (family.zero_mem w)
  let e : {a // a ∈ A} ↪ ℤ := ⟨Subtype.val, Subtype.val_injective⟩
  have heq : (weakBoxObstacle family w).map e =
      outsideGAP A (family.gap w) := by
    ext a
    simp [weakBoxObstacle, outsideGAP, e, and_comm]
  have hcard : (weakBoxObstacle family w).card =
      (outsideGAP A (family.gap w)).card := by
    rw [← heq, Finset.card_map]
  omega

/-- The canonical finite type of distinct weak-box traces on `A`.  A trace is
stored as an element of `A.powerset`, so finiteness is automatic and no
external obstacle family is assumed. -/
abbrev WeakTraceIndex (A : Finset ℤ) (box : (d : ℕ) → GAP 1 d)
    (maxRank differenceBound : ℕ) :=
  {T : {T : Finset ℤ // T ∈ A.powerset} //
    ∃ d : ℕ, 0 < d ∧ d ≤ maxRank ∧
      ∃ P : GAP 1 d, HasDifferencesAtMost P differenceBound ∧
        4 * P.volume ≤ 3 * (box d).volume ∧
        integerPoint 0 ∈ P.carrier ∧ T.1 = outsideGAP A P}

noncomputable instance weakTraceIndexFintype (A : Finset ℤ)
    (box : (d : ℕ) → GAP 1 d) (maxRank differenceBound : ℕ) :
    Fintype (WeakTraceIndex A box maxRank differenceBound) := by
  classical
  exact Fintype.ofFinite _

/-- The canonical weak-box family obtained by choosing one representing GAP
for each distinct admissible trace. -/
noncomputable def canonicalWeakBoxFamily (A : Finset ℤ)
    (box : (d : ℕ) → GAP 1 d) (maxRank differenceBound : ℕ) :
    WeakBoxFamily (WeakTraceIndex A box maxRank differenceBound) A box
      maxRank differenceBound := by
  classical
  choose d hdpos hdrank P hsteps hvolume hzero htrace using
    fun w : WeakTraceIndex A box maxRank differenceBound ↦ w.2
  refine {
    dimension := d
    gap := P
    positive := hdpos
    rank_le := hdrank
    steps_le := hsteps
    volume_le := hvolume
    zero_mem := hzero
    covers := ?_
  }
  intro d' hd' hdRank' P' hsteps' hvolume' hzero'
  have hsub : outsideGAP A P' ⊆ A := Finset.filter_subset _ _
  let w : WeakTraceIndex A box maxRank differenceBound :=
    ⟨⟨outsideGAP A P', Finset.mem_powerset.mpr hsub⟩,
      ⟨d', hd', hdRank', P', hsteps', hvolume', hzero', rfl⟩⟩
  exact ⟨w, htrace w⟩

end WeakObstacles

/-! ## Full strong-stability inheritance -/

section StrongInheritance

variable {W : Type*} [Fintype W] [DecidableEq W]

/-- A color class of the subtype, mapped back to integers and with the
distinguished zero adjoined, as in CFP's stability convention. -/
def anchoredColorClass (A : Finset ℤ) {q : ℕ}
    (c : {a // a ∈ A} → Fin (q + 1)) (i : Fin (q + 1)) : Finset ℤ :=
  insert 0 ((colorClass c i).map ⟨Subtype.val, Subtype.val_injective⟩)

/-- The combined finite obstacle index used for full strong stability. -/
abbrev StrongObstacleIndex (A : Finset ℤ) (relevant : Finset ℕ)
    (φ : (d : ℕ) → ℤ → LatticePoint d) :=
  W ⊕ FinsetDistinctSpanIndex A relevant φ

/-- The combined obstacle family: weak-box complements on the left and
proper generated-span complements on the right. -/
noncomputable def strongObstacle {A : Finset ℤ}
    {box : (d : ℕ) → GAP 1 d} {maxRank differenceBound : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → ℤ → LatticePoint d}
    (family : WeakBoxFamily W A box maxRank differenceBound) :
    StrongObstacleIndex (W := W) A relevant φ → Finset {a // a ∈ A}
  | Sum.inl w => weakBoxObstacle family w
  | Sum.inr w =>
      distinctSpanObstacle
        (fun d : {d // d ∈ relevant} ↦ LatticePoint d.1)
        (fun d (a : {a // a ∈ A}) ↦ φ d.1 a.1) w

/-- Source-sharp finite form of the random-partition inheritance clause in
CFP Lemma 2.34.  A finite geometric enumeration supplies the bounded family
of weak boxes; proper generated spans are enumerated canonically.  The
source's `alpha * x > C log n` hypothesis appears as `hcapacity`, with the
exact logarithm of the combined event family.  The conclusion consists of
actual `StronglyStableFor` color parts. -/
theorem exists_coloring_stronglyStableFor_logarithmic
    {A : Finset ℤ} {box : (d : ℕ) → GAP 1 d}
    {x maxRank differenceBound C0 q t : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → ℤ → LatticePoint d}
    (hstable : StronglyStableFor A box x maxRank differenceBound relevant φ C0)
    (hφzero : ∀ d ∈ relevant, φ d 0 = 0)
    (family : WeakBoxFamily W A box maxRank differenceBound)
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card
              (StrongObstacleIndex (W := W) A relevant φ × Fin (t + 1)) *
            (q + 1)) + 1) ≤ A.card)
    (hcapacity :
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card
                (StrongObstacleIndex (W := W) A relevant φ × Fin (t + 1)) *
              (q + 1)) + 1)) ≤ x / C0 + 1) :
    ∃ c : {a // a ∈ A} → Fin (q + 1),
      ∀ i, StronglyStableFor (anchoredColorClass A c i) box t maxRank
        differenceBound relevant φ C0 := by
  classical
  let G : {d // d ∈ relevant} → Type := fun d ↦ LatticePoint d.1
  let ψ : ∀ d, {a // a ∈ A} → G d := fun d a ↦ φ d.1 a.1
  have hspanSubtype :
      SpanRobust (⟨0, hstable.weaklyStable.zero_mem⟩ : {a // a ∈ A})
        Finset.univ (x / C0) relevant (fun d a ↦ φ d a.1) :=
    spanRobust_subtype hstable.spanRobust hstable.weaklyStable.zero_mem
  have hobstacle : ∀ o : StrongObstacleIndex (W := W) A relevant φ,
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card
                (StrongObstacleIndex (W := W) A relevant φ × Fin (t + 1)) *
              (q + 1)) + 1)) ≤
        (strongObstacle family o).card := by
    intro o
    cases o with
    | inl w =>
        have hw := card_weakBoxObstacle_gt hstable.weaklyStable family w
        have hdiv : x / C0 ≤ x := Nat.div_le_self _ _
        exact hcapacity.trans ((Nat.succ_le_succ hdiv).trans
          (Nat.succ_le_iff.mpr hw))
    | inr w =>
        obtain ⟨S, hS, hgen⟩ := Finset.mem_image.mp w.2.2.1
        have hw := chunk_capacity_of_spanRobust hspanSubtype
          (Finset.mem_univ _)
          (hφzero w.1.1 w.1.2) w.1.2
          (B := S) (t := t)
          (r := q * (Nat.log 2
            (Fintype.card
                (StrongObstacleIndex (W := W) A relevant φ × Fin (t + 1)) *
              (q + 1)) + 1))
          (by
            have hproper := w.2.2.2
            rw [← hgen] at hproper
            simpa [G, ψ, generatedProfile, generatedSubgroup] using hproper)
          hcapacity
        have hobs : distinctSpanObstacle G ψ w =
            outsideGeneratedSubgroup (ψ w.1) Finset.univ S := by
          have hgen' : generatedSubgroup (ψ w.1) S = w.2.1 := by
            simpa [generatedProfile, generatedSubgroup] using hgen
          ext a
          simp [distinctSpanObstacle, outsideGeneratedSubgroup, hgen']
        change _ ≤ (distinctSpanObstacle G ψ w).card
        rw [hobs]
        exact hw
  obtain ⟨c, hc⟩ := exists_coloring_robust_on_obstacles_logarithmic
    (obstacle := strongObstacle family) hq (by simpa using hrange) hobstacle
  refine ⟨c, ?_⟩
  intro i
  let e : {a // a ∈ A} ↪ ℤ := ⟨Subtype.val, Subtype.val_injective⟩
  let part := anchoredColorClass A c i
  have hpartA : part ⊆ A := by
    intro a ha
    simp only [part, anchoredColorClass, Finset.mem_insert,
      Finset.mem_map] at ha
    rcases ha with rfl | ⟨b, hb, rfl⟩
    · exact hstable.weaklyStable.zero_mem
    · exact b.2
  have hweakPart : WeaklyStableFor part box t maxRank differenceBound := by
    refine ⟨by simp [part, anchoredColorClass], ?_⟩
    intro B hBpart hlarge hzeroB d hd hdRank P hsteps hvolume
    intro hcontained
    have hzeroP : integerPoint 0 ∈ P.carrier :=
      hcontained (integerPoint_mem_integerPoints_iff.mpr hzeroB)
    obtain ⟨w, hw⟩ := family.covers hd hdRank P hsteps hvolume hzeroP
    let T := colorClass c i ∩ weakBoxObstacle family w
    have hTlarge : t < T.card := by
      exact hc (Sum.inl w) i
    have hTsub : T.map e ⊆ part \ B := by
      intro a ha
      obtain ⟨b, hb, rfl⟩ := Finset.mem_map.mp ha
      have hbcolor := (Finset.mem_inter.mp hb).1
      have hboutside := (Finset.mem_inter.mp hb).2
      apply Finset.mem_sdiff.mpr
      refine ⟨?_, ?_⟩
      · exact Finset.mem_insert_of_mem (Finset.mem_map.mpr ⟨b, hbcolor, rfl⟩)
      · intro hbB
        have hbP : integerPoint b.1 ∈ P.carrier :=
          hcontained (integerPoint_mem_integerPoints_iff.mpr hbB)
        have hbGap : b.1 ∈ outsideGAP A (family.gap w) := by
          simpa [weakBoxObstacle, outsideGAP] using hboutside
        have hbOutP : b.1 ∈ outsideGAP A P := by
          rw [hw]
          exact hbGap
        exact (Finset.mem_filter.mp hbOutP).2 hbP
    have hTcard : T.card ≤ (part \ B).card := by
      rw [← Finset.card_map e]
      exact Finset.card_le_card hTsub
    have hdiff : (part \ B).card = part.card - B.card :=
      Finset.card_sdiff_of_subset hBpart
    have hdiffle : (part \ B).card ≤ t := by
      rw [hdiff]
      omega
    omega
  refine ⟨hweakPart, hstable.C0_pos, ?_⟩
  intro d hd B hBpart hlarge hzeroB
  let S := (colorClass c i).filter fun a ↦ a.1 ∈ B
  have hScolor : S ⊆ colorClass c i := Finset.filter_subset _ _
  have hmapSB : S.map e ⊆ B := by
    intro a ha
    obtain ⟨b, hb, rfl⟩ := Finset.mem_map.mp ha
    exact (Finset.mem_filter.mp hb).2
  have hmissing : (colorClass c i \ S).map e ⊆ part \ B := by
    intro a ha
    obtain ⟨b, hb, rfl⟩ := Finset.mem_map.mp ha
    have hbc := (Finset.mem_sdiff.mp hb).1
    have hbnot := (Finset.mem_sdiff.mp hb).2
    apply Finset.mem_sdiff.mpr
    refine ⟨Finset.mem_insert_of_mem (Finset.mem_map.mpr ⟨b, hbc, rfl⟩), ?_⟩
    intro hbB
    exact hbnot (Finset.mem_filter.mpr ⟨hbc, hbB⟩)
  have hmissCard : (colorClass c i \ S).card ≤ (part \ B).card := by
    rw [← Finset.card_map e]
    exact Finset.card_le_card hmissing
  have hpartDiff : (part \ B).card = part.card - B.card :=
    Finset.card_sdiff_of_subset hBpart
  have hSloss : (colorClass c i).card ≤ S.card + t := by
    have hsmall : (part \ B).card ≤ t / C0 := by
      rw [hpartDiff]
      apply Nat.sub_le_iff_le_add.mpr
      simpa [add_comm] using hlarge
    have hquot : t / C0 ≤ t := Nat.div_le_self _ _
    have hsdiff : (colorClass c i \ S).card =
        (colorClass c i).card - S.card :=
      Finset.card_sdiff_of_subset hScolor
    have htotal : (colorClass c i \ S).card + S.card =
        (colorClass c i).card :=
      Finset.card_sdiff_add_card_eq_card hScolor
    rw [hsdiff] at hmissCard
    omega
  have hprofile := generatedProfile_eq_of_distinct_robust_obstacles G ψ c
    (fun w j ↦ hc (Sum.inr w) j) i hScolor hSloss ⟨d, hd⟩
  have hSA : generatedSubgroup (φ d) (S.map e) =
      generatedSubgroup (φ d) A := by
    change generatedSubgroup (fun a : {a // a ∈ A} ↦ φ d a.1) S =
      generatedSubgroup (fun a : {a // a ∈ A} ↦ φ d a.1)
        Finset.univ at hprofile
    rw [generatedSubgroup_subtype_map (φ d) A S,
      generatedSubgroup_subtype_univ (φ d) A] at hprofile
    simpa [e] using hprofile
  have hBA : B ⊆ A := hBpart.trans hpartA
  have hpartSpan : generatedSubgroup (φ d) part =
      generatedSubgroup (φ d) A := by
    apply le_antisymm
    · exact generatedSubgroup_mono hpartA
    · rw [← hSA]
      exact generatedSubgroup_mono (hmapSB.trans hBpart)
  apply Eq.trans ?_ hpartSpan.symm
  apply le_antisymm
  · exact generatedSubgroup_mono hBA
  · rw [← hSA]
    exact generatedSubgroup_mono hmapSB

/-- Canonical form of the full inheritance theorem.  All admissible weak-box
traces are enumerated internally by `WeakTraceIndex`, so the only remaining
analytic input is the displayed logarithmic capacity bound for that concrete
finite family together with the concrete proper-span family. -/
theorem exists_coloring_stronglyStableFor_canonical_logarithmic
    {A : Finset ℤ} {box : (d : ℕ) → GAP 1 d}
    {x maxRank differenceBound C0 q t : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → ℤ → LatticePoint d}
    (hstable : StronglyStableFor A box x maxRank differenceBound relevant φ C0)
    (hφzero : ∀ d ∈ relevant, φ d 0 = 0)
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2
          (Fintype.card
              (StrongObstacleIndex
                (W := WeakTraceIndex A box maxRank differenceBound)
                A relevant φ × Fin (t + 1)) * (q + 1)) + 1) ≤ A.card)
    (hcapacity :
      (t + 1) *
          (q * (Nat.log 2
            (Fintype.card
                (StrongObstacleIndex
                  (W := WeakTraceIndex A box maxRank differenceBound)
                  A relevant φ × Fin (t + 1)) * (q + 1)) + 1)) ≤
        x / C0 + 1) :
    ∃ c : {a // a ∈ A} → Fin (q + 1),
      ∀ i, StronglyStableFor (anchoredColorClass A c i) box t maxRank
        differenceBound relevant φ C0 := by
  exact exists_coloring_stronglyStableFor_logarithmic hstable hφzero
    (canonicalWeakBoxFamily A box maxRank differenceBound) hq hrange hcapacity

/-- The exact finite-family estimate left to the bounded-box/subgroup-index
part of the CFP argument.  It says that the number of distinct admissible
weak-box traces together with the number of distinct proper generated spans
is polynomially bounded by `n`. -/
def CanonicalObstaclePolynomialBound (A : Finset ℤ)
    (box : (d : ℕ) → GAP 1 d) (maxRank differenceBound : ℕ)
    (relevant : Finset ℕ) (φ : (d : ℕ) → ℤ → LatticePoint d)
    (n exponent : ℕ) : Prop :=
  Fintype.card
      (StrongObstacleIndex
        (W := WeakTraceIndex A box maxRank differenceBound) A relevant φ) ≤
    n ^ exponent

/-- CFP-shaped corollary with a polynomial event-family bound.  Once the
bounded-dimension geometry supplies `CanonicalObstaclePolynomialBound`, the
only size assumption is the source-scale condition that `(t+1) * q` times a
binary logarithm of a polynomial in `n` fits inside the original robust span
budget.  The exact union-bound inequality is proved internally. -/
theorem exists_coloring_stronglyStableFor_of_polynomial_bound
    {A : Finset ℤ} {box : (d : ℕ) → GAP 1 d}
    {x maxRank differenceBound C0 q t n exponent : ℕ}
    {relevant : Finset ℕ} {φ : (d : ℕ) → ℤ → LatticePoint d}
    (hstable : StronglyStableFor A box x maxRank differenceBound relevant φ C0)
    (hφzero : ∀ d ∈ relevant, φ d 0 = 0)
    (hfamily : CanonicalObstaclePolynomialBound A box maxRank differenceBound
      relevant φ n exponent)
    (hq : 0 < q)
    (hrange :
      q * (Nat.log 2 (n ^ exponent * (t + 1) * (q + 1)) + 1) ≤ A.card)
    (hcapacity :
      (t + 1) *
          (q * (Nat.log 2 (n ^ exponent * (t + 1) * (q + 1)) + 1)) ≤
        x / C0 + 1) :
    ∃ c : {a // a ∈ A} → Fin (q + 1),
      ∀ i, StronglyStableFor (anchoredColorClass A c i) box t maxRank
        differenceBound relevant φ C0 := by
  classical
  let I := StrongObstacleIndex
    (W := WeakTraceIndex A box maxRank differenceBound) A relevant φ
  have hevents : Fintype.card (I × Fin (t + 1)) * (q + 1) ≤
      n ^ exponent * (t + 1) * (q + 1) := by
    simp only [Fintype.card_prod, Fintype.card_fin]
    exact Nat.mul_le_mul_right (q + 1)
      (Nat.mul_le_mul_right (t + 1) hfamily)
  have hlog :
      Nat.log 2 (Fintype.card (I × Fin (t + 1)) * (q + 1)) + 1 ≤
        Nat.log 2 (n ^ exponent * (t + 1) * (q + 1)) + 1 :=
    Nat.add_le_add_right (Nat.log_mono_right hevents) 1
  apply exists_coloring_stronglyStableFor_canonical_logarithmic
    hstable hφzero hq
  · exact (Nat.mul_le_mul_left q hlog).trans hrange
  · exact (Nat.mul_le_mul_left (t + 1)
      (Nat.mul_le_mul_left q hlog)).trans hcapacity

end StrongInheritance

end Erdos186.CFP.RandomPartition
