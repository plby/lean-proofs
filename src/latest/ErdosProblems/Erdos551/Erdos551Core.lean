/-!
# Erdős Problem 551

For natural numbers `k`, `n`, and `N`, `CycleCliqueRamseyProperty k n N`
says that every graph on `N` vertices contains an ordinary copy of the
cycle graph on `k` vertices or an independent set of cardinality `n`.
Thus `cycleCliqueRamseyNumber k n` is the usual graph Ramsey number
`R(Cₖ, Kₙ)` (for the intended range `k ≥ 3`).

The main theorem is the sufficiently-large-`n` consequence of the theorem
of Keevash, Long, and Skokan: once `n` is sufficiently large, the exact
value is `(k - 1) * (n - 1) + 1` simultaneously for every `k ≥ n`.
-/

open scoped BigOperators Classical SimpleGraph NNReal
open Filter Asymptotics
open Topology

namespace Erdos551

open Fintype SimpleGraph

/-- Every graph on `N` vertices contains `Cₖ` or an independent `n`-set. -/
def CycleCliqueRamseyProperty (k n N : ℕ) : Prop :=
  ∀ G : SimpleGraph (Fin N), cycleGraph k ⊑ G ∨ ¬ G.IndepSetFree n

/-- Finite Ramsey theory supplies some order with the cycle--clique property. -/
theorem cycleCliqueRamseyProperty_exists (k n : ℕ) :
    ∃ N, CycleCliqueRamseyProperty k n N := by
  refine ⟨Ramsey.ramseyNumber k n, ?_⟩
  intro G
  have hRamsey := Ramsey.ramseyNumber_spec k n G
  by_cases hclique : G.CliqueFree k
  · exact Or.inr fun hindep ↦ hRamsey ⟨hclique, hindep⟩
  · left
    have hcycleTop : cycleGraph k ⊑ completeGraph (Fin k) :=
      SimpleGraph.IsContained.of_le (show cycleGraph k ≤ ⊤ from le_top)
    exact hcycleTop.trans
      ((SimpleGraph.not_cliqueFree_iff_top_isContained k).mp hclique)

/-- The least order with the cycle--clique Ramsey property. -/
noncomputable def cycleCliqueRamseyNumber (k n : ℕ) : ℕ :=
  Nat.find (cycleCliqueRamseyProperty_exists k n)

theorem cycleCliqueRamseyNumber_spec (k n : ℕ) :
    CycleCliqueRamseyProperty k n (cycleCliqueRamseyNumber k n) :=
  Nat.find_spec (cycleCliqueRamseyProperty_exists k n)

theorem cycleCliqueRamseyNumber_le_of_property {k n N : ℕ}
    (hN : CycleCliqueRamseyProperty k n N) :
    cycleCliqueRamseyNumber k n ≤ N :=
  Nat.find_min' (cycleCliqueRamseyProperty_exists k n) hN

theorem cycleCliqueRamseyProperty_mono_vertices {k n N M : ℕ} (hNM : N ≤ M) :
    CycleCliqueRamseyProperty k n N → CycleCliqueRamseyProperty k n M := by
  intro hN G
  let f : Fin N ↪ Fin M := Fin.castLEEmb hNM
  rcases hN (G.comap f) with hcycle | hindep
  · exact Or.inl <| hcycle.trans (SimpleGraph.Embedding.comap f G).isContained
  · exact Or.inr fun hfree ↦
      hindep (SimpleGraph.IndepSetFree.comap (SimpleGraph.Embedding.comap f G) hfree)

theorem cycleCliqueRamseyProperty_of_card {k n N : ℕ} {α : Type*} [Fintype α]
    (hcard : Fintype.card α = N) (hprop : CycleCliqueRamseyProperty k n N) :
    ∀ G : SimpleGraph α, cycleGraph k ⊑ G ∨ ¬ G.IndepSetFree n := by
  intro G
  let H : SimpleGraph (Fin N) := G.overFin hcard
  let e : G ≃g H := SimpleGraph.overFinIso (G := G) hcard
  rcases hprop H with hcycle | hindep
  · exact Or.inl <| hcycle.trans ⟨e.symm.toCopy⟩
  · exact Or.inr fun hfree ↦ hindep ((e.indepSetFree_iff (n := n)).mp hfree)

theorem not_cycleCliqueRamseyProperty_of_lt {k n N : ℕ}
    (hN : N < cycleCliqueRamseyNumber k n) :
    ¬ CycleCliqueRamseyProperty k n N :=
  Nat.find_min (cycleCliqueRamseyProperty_exists k n) hN

/-! ## The universal lower bound -/

/-- A disjoint union of `a` cliques, each with `b` vertices. -/
def blockGraph (a b : ℕ) : SimpleGraph (Fin a × Fin b) where
  Adj x y := x.1 = y.1 ∧ x ≠ y
  symm := ⟨by
    intro x y h
    exact ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨by
    intro x h
    exact h.2 rfl⟩

@[simp]
theorem blockGraph_adj {a b : ℕ} {x y : Fin a × Fin b} :
    (blockGraph a b).Adj x y ↔ x.1 = y.1 ∧ x ≠ y :=
  Iff.rfl

/-- Along a walk in a block graph, the block coordinate is constant. -/
theorem blockGraph_walk_fst_eq {a b : ℕ} {x y : Fin a × Fin b}
    (p : (blockGraph a b).Walk x y) : x.1 = y.1 := by
  induction p with
  | nil => rfl
  | cons h _ ih => exact h.1.trans ih

theorem blockGraph_reachable_fst_eq {a b : ℕ} {x y : Fin a × Fin b}
    (h : (blockGraph a b).Reachable x y) : x.1 = y.1 :=
  h.elim blockGraph_walk_fst_eq

/-- A `k`-cycle cannot fit inside a clique block of order `k - 1`. -/
theorem cycleGraph_not_isContained_blockGraph (a k : ℕ) (hk : 1 ≤ k) :
    ¬ cycleGraph k ⊑ blockGraph a (k - 1) := by
  rintro ⟨f⟩
  have hfirst : ∀ x y : Fin k, (f x).1 = (f y).1 := by
    intro x y
    exact blockGraph_reachable_fst_eq
      ((cycleGraph_preconnected x y).map f.toHom)
  have hsecond : Function.Injective (fun x : Fin k ↦ (f x).2) := by
    intro x y hxy
    apply f.injective
    exact Prod.ext (hfirst x y) hxy
  have hcard := Fintype.card_le_of_injective (fun x : Fin k ↦ (f x).2) hsecond
  simp only [Fintype.card_fin] at hcard
  omega

/-- An independent set in a block graph uses at most one vertex per block. -/
theorem blockGraph_indepSetFree (a b n : ℕ) (ha : a < n) :
    (blockGraph a b).IndepSetFree n := by
  intro t ht
  have hproj : Function.Injective (fun x : t ↦ x.1.1) := by
    intro x y hxy
    apply Subtype.ext
    by_contra hne
    have hadj : (blockGraph a b).Adj x.1 y.1 := ⟨hxy, hne⟩
    exact ((blockGraph a b).isIndepSet_iff.mp ht.isIndepSet) x.2 y.2 hne hadj
  have hcard := Fintype.card_le_of_injective (fun x : t ↦ x.1.1) hproj
  have htcard : Fintype.card t = n := by simpa using ht.card_eq
  simp only [htcard, Fintype.card_fin] at hcard
  omega

/-- The standard disjoint-clique coloring witnesses the Ramsey lower bound. -/
theorem cycleCliqueRamsey_lower_bound (k n : ℕ) (hk : 1 ≤ k) (hn : 1 ≤ n) :
    (k - 1) * (n - 1) + 1 ≤ cycleCliqueRamseyNumber k n := by
  let e : Fin ((n - 1) * (k - 1)) ≃ Fin (n - 1) × Fin (k - 1) :=
    finProdFinEquiv.symm
  let B : SimpleGraph (Fin (n - 1) × Fin (k - 1)) := blockGraph (n - 1) (k - 1)
  let G : SimpleGraph (Fin ((n - 1) * (k - 1))) := B.comap e
  have hcycle : ¬ cycleGraph k ⊑ G := by
    intro h
    have hGB : G ≃g B := SimpleGraph.Iso.comap e B
    exact cycleGraph_not_isContained_blockGraph (n - 1) k hk
      (h.trans ⟨hGB.toCopy⟩)
  have hindepB : B.IndepSetFree n := by
    exact blockGraph_indepSetFree (n - 1) (k - 1) n (by omega)
  have hindep : G.IndepSetFree n := by
    have hGB : G ≃g B := SimpleGraph.Iso.comap e B
    exact (hGB.indepSetFree_iff (n := n)).mpr hindepB
  have hnot : ¬ CycleCliqueRamseyProperty k n ((n - 1) * (k - 1)) := by
    intro hprop
    rcases hprop G with h | h
    · exact hcycle h
    · exact h hindep
  have hlt : (n - 1) * (k - 1) < cycleCliqueRamseyNumber k n := by
    by_contra h
    have hle : cycleCliqueRamseyNumber k n ≤ (n - 1) * (k - 1) := by omega
    have hprop : CycleCliqueRamseyProperty k n ((n - 1) * (k - 1)) := by
      exact cycleCliqueRamseyProperty_mono_vertices hle
        (cycleCliqueRamseyNumber_spec k n)
    exact hnot hprop
  simpa [Nat.mul_comm] using hlt

/-! ## The inductive deletion step used by KLS -/

/-- In a counterexample for parameter `n`, the non-neighbourhood of any
vertex is too small to support the already-proved parameter `n - 1`. -/
theorem compl_degree_lt_of_previous_property {k n N M : ℕ} (hn : 2 ≤ n)
    (hprev : CycleCliqueRamseyProperty k (n - 1) M)
    (G : SimpleGraph (Fin N)) (hcycle : ¬ cycleGraph k ⊑ G)
    (hindep : G.IndepSetFree n) (v : Fin N) :
    Gᶜ.degree v < M := by
  classical
  by_contra hnot
  have hM : M ≤ Gᶜ.degree v := by omega
  let H : SimpleGraph (Gᶜ.neighborSet v) := G.induce (Gᶜ.neighborSet v)
  have hprop : CycleCliqueRamseyProperty k (n - 1) (Gᶜ.degree v) :=
    cycleCliqueRamseyProperty_mono_vertices hM hprev
  have hH : cycleGraph k ⊑ H ∨ ¬ H.IndepSetFree (n - 1) :=
    cycleCliqueRamseyProperty_of_card (Gᶜ.card_neighborSet_eq_degree v) hprop H
  rcases hH with hcopy | hnotfree
  · exact hcycle <| hcopy.trans
      (SimpleGraph.Embedding.induce (G := G) (s := Gᶜ.neighborSet v)).isContained
  · apply hnotfree
    intro t ht
    let t' : Finset (Fin N) :=
      Finset.map ⟨Subtype.val, Subtype.val_injective⟩ t
    have htInd :
        (((⊤ : SimpleGraph.Subgraph G).induce
          (Gᶜ.neighborSet v)).coe).IsNIndepSet (n - 1) t := by
      rw [← SimpleGraph.induce_eq_coe_induce_top]
      exact ht
    have ht' : G.IsNIndepSet (n - 1) t' := by
      simpa [H, t'] using
        (SimpleGraph.isNIndepSet_induce
          (G := G) (F := Gᶜ.neighborSet v) (s := t) (n := n - 1)).1 htInd
    have ht'compl : Gᶜ.IsNClique (n - 1) t' := by
      simpa using ht'
    have hvt : ∀ b ∈ t', Gᶜ.Adj v b := by
      intro b hb
      rcases Finset.mem_map.mp hb with ⟨x, hx, rfl⟩
      exact x.property
    have ht'' : G.IsNIndepSet ((n - 1) + 1) (insert v t') := by
      simpa using ht'compl.insert hvt
    have hn' : (n - 1) + 1 = n := by omega
    exact hindep _ (hn' ▸ ht'')

/-- The elementary induction at the start of the KLS proof: a minimal
counterexample has minimum degree at least `k - 1`. -/
theorem counterexample_minDegree {k n : ℕ} (hn : 2 ≤ n)
    (hprev : CycleCliqueRamseyProperty k (n - 1)
      ((k - 1) * (n - 2) + 1))
    (G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)))
    (hcycle : ¬ cycleGraph k ⊑ G) (hindep : G.IndepSetFree n) :
    k - 1 ≤ G.minDegree := by
  classical
  let _ : Nonempty (Fin ((k - 1) * (n - 1) + 1)) :=
    Fin.pos_iff_nonempty.mp (by omega)
  apply G.le_minDegree_of_forall_le_degree
  intro v
  have hcomp := compl_degree_lt_of_previous_property hn hprev G hcycle hindep v
  have hdegcomp := G.degree_compl (v := v)
  rw [Fintype.card_fin] at hdegcomp
  have hsplit : n - 1 = (n - 2) + 1 := by omega
  have hsize : (k - 1) * (n - 1) =
      (k - 1) * (n - 2) + (k - 1) := by
    rw [hsplit, Nat.mul_add, Nat.mul_one]
  have hdegcomp' : Gᶜ.degree v =
      ((k - 1) * (n - 2) + (k - 1)) - G.degree v := by
    calc
      Gᶜ.degree v = ((k - 1) * (n - 1) + 1) - 1 - G.degree v := hdegcomp
      _ = (k - 1) * (n - 1) - G.degree v := by
        rw [Nat.add_sub_cancel]
      _ = ((k - 1) * (n - 2) + (k - 1)) - G.degree v := by
        exact congrArg (fun z : ℕ ↦ z - G.degree v) hsize
  omega

/-- A counterexample at the extremal order has chromatic number at least `k`.
This is the clean numerical form of the independence-number input that feeds
the later KLS stability argument. -/
theorem IndepSetFree.card_lt {V : Type*} {G : SimpleGraph V} {m : ℕ}
    (hfree : G.IndepSetFree m) {s : Finset V}
    (hs : G.IsIndepSet (s : Set V)) : s.card < m := by
  by_contra! hms
  obtain ⟨t, hts, htcard⟩ := Finset.exists_subset_card_eq hms
  apply hfree t
  refine ⟨hs.mono ?_, htcard⟩
  intro v hv
  exact hts hv

/-- In an `m`-independent-set-free finite graph, every color class has at
most `m - 1` vertices. -/
theorem IndepSetFree.card_le_chromaticNumber_toNat_mul_pred
    {V : Type*} [Fintype V] {G : SimpleGraph V} {m : ℕ}
    (hfree : G.IndepSetFree m) :
    Fintype.card V ≤ G.chromaticNumber.toNat * (m - 1) := by
  classical
  let q : ℕ := G.chromaticNumber.toNat
  let C : G.Coloring (Fin q) :=
    (SimpleGraph.colorable_chromaticNumber_of_fintype G).some
  have hfiber : ∀ c ∈ (Finset.univ : Finset (Fin q)),
      (Finset.univ.filter fun v ↦ C v = c).card ≤ m - 1 := by
    intro c _hc
    have hlt : (Finset.univ.filter fun v ↦ C v = c).card < m := by
      apply Erdos551.IndepSetFree.card_lt hfree
      refine (C.isIndepSet_colorClass c).mono ?_
      intro v hv
      simpa [Coloring.colorClass] using hv
    omega
  have hcard := Finset.card_le_mul_card_image_of_maps_to
    (s := (Finset.univ : Finset V)) (t := (Finset.univ : Finset (Fin q)))
    (f := fun v ↦ C v) (fun _ _ ↦ Finset.mem_univ _) (m - 1) hfiber
  simpa [q, mul_comm] using hcard

/-- Any finite set of at least `n` vertices in an `n`-independent-set-free
graph contains an edge.  This is the basic source of a parity-breaking edge
inside a sufficiently large robust reservoir. -/
theorem exists_adj_in_finset_of_indepSetFree
    {V : Type*} [Fintype V] {G : SimpleGraph V} {n : ℕ}
    (hfree : G.IndepSetFree n) {U : Finset V} (hU : n ≤ U.card) :
    ∃ x ∈ U, ∃ y ∈ U, G.Adj x y := by
  by_contra hnot
  push_neg at hnot
  have hUind : G.IsIndepSet (U : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro x hx y hy _hxy
    exact hnot x hx y hy
  have hlt := Erdos551.IndepSetFree.card_lt hfree hUind
  omega

theorem counterexample_chromaticNumber_toNat_ge {k n : ℕ}
    (G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)))
    (hindep : G.IndepSetFree n) :
    k ≤ G.chromaticNumber.toNat := by
  have hcard : (k - 1) * (n - 1) + 1 ≤
      G.chromaticNumber.toNat * (n - 1) := by
    simpa using Erdos551.IndepSetFree.card_le_chromaticNumber_toNat_mul_pred hindep
  by_contra hk
  have hk' : G.chromaticNumber.toNat ≤ k - 1 := by omega
  have hmul : G.chromaticNumber.toNat * (n - 1) ≤ (k - 1) * (n - 1) :=
    Nat.mul_le_mul_right (n - 1) hk'
  omega

/-! ## Fixed-`k` induction bases -/

/-- The parameter `n = 1` is immediate: every nonempty one-vertex host has
an independent singleton. -/
theorem cycleCliqueRamseyProperty_one (k : ℕ) :
    CycleCliqueRamseyProperty k 1 1 := by
  intro G
  right
  intro hfree
  apply hfree (Finset.univ : Finset (Fin 1))
  refine ⟨?_, by simp⟩
  simp [SimpleGraph.isIndepSet_iff]

/-- For `n = 2`, avoiding an independent pair makes the host complete, so
it contains every graph on the same `k` vertices, in particular `Cₖ`. -/
theorem cycleCliqueRamseyProperty_two (k : ℕ) :
    CycleCliqueRamseyProperty k 2 k := by
  intro G
  by_cases hfree : G.IndepSetFree 2
  · left
    have hcompl : Gᶜ = ⊥ := by
      rw [← SimpleGraph.cliqueFree_compl, SimpleGraph.cliqueFree_two] at hfree
      exact hfree
    have htop : G = ⊤ := by
      have hc := congrArg (fun H : SimpleGraph (Fin k) ↦ Hᶜ) hcompl
      simpa using hc
    rw [htop]
    exact SimpleGraph.IsContained.of_le (show cycleGraph k ≤ ⊤ from le_top)
  · exact Or.inr hfree

/-- The preceding base case has exactly the extremal-order arithmetic used
by the main induction. -/
theorem cycleCliqueRamseyProperty_two_extremal (k : ℕ) (hk : 1 ≤ k) :
    CycleCliqueRamseyProperty k 2 ((k - 1) * (2 - 1) + 1) := by
  simpa [Nat.sub_add_cancel hk] using cycleCliqueRamseyProperty_two k

/-! ## The exact induction reduction -/

/-- The fixed-`k` diagonal upper statement.  This is the induction-safe form:
the induction runs over every `n ≤ k`, while eventuality is imposed later on
the outer parameter `k`. -/
def DiagonalUpperAt (k : ℕ) : Prop :=
  ∀ n : ℕ, 1 ≤ n → n ≤ k →
    CycleCliqueRamseyProperty k n ((k - 1) * (n - 1) + 1)

/-- The only non-elementary input needed after the deletion induction: no
extremal-order counterexample with the forced minimum degree exists. -/
def DenseCounterexampleExcludedAt (k : ℕ) : Prop :=
  ∀ n : ℕ, 3 ≤ n → n ≤ k →
    ∀ G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)),
      k - 1 ≤ G.minDegree →
      G.IndepSetFree n →
      ¬ cycleGraph k ⊑ G → False

/-- KLS's final induction, isolated from the stability/absorption core.
The low-degree branch is discharged by `counterexample_minDegree`; the only
remaining branch is exactly `DenseCounterexampleExcludedAt`. -/
theorem diagonalUpperAt_of_denseCounterexampleExcluded {k : ℕ} (hk : 1 ≤ k)
    (hExclude : DenseCounterexampleExcludedAt k) : DiagonalUpperAt k := by
  unfold DiagonalUpperAt
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro hn hnk
      by_cases hn1 : n = 1
      · subst n
        simpa using cycleCliqueRamseyProperty_one k
      by_cases hn2 : n = 2
      · subst n
        exact cycleCliqueRamseyProperty_two_extremal k hk
      have hn3 : 3 ≤ n := by omega
      intro G
      by_cases hcycle : cycleGraph k ⊑ G
      · exact Or.inl hcycle
      by_cases hindep : G.IndepSetFree n
      · exfalso
        have hprev : CycleCliqueRamseyProperty k (n - 1)
            ((k - 1) * ((n - 1) - 1) + 1) := by
          apply ih (n - 1)
          · omega
          · omega
          · omega
        have hprev' : CycleCliqueRamseyProperty k (n - 1)
            ((k - 1) * (n - 2) + 1) := by
          simpa only [Nat.sub_sub] using hprev
        have hmin : k - 1 ≤ G.minDegree :=
          counterexample_minDegree (k := k) (n := n) (by omega) hprev' G hcycle hindep
        exact hExclude n hn3 hnk G hmin hindep hcycle
      · exact Or.inr hindep

/-- An eventual proof of the stability/absorption core gives the requested
eventual Erdős 551 equality. -/
theorem erdos551_eventually_of_eventually_denseCounterexampleExcluded
    (hExclude : ∀ᶠ k : ℕ in atTop, DenseCounterexampleExcludedAt k) :
    ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → ∀ k : ℕ, n ≤ k →
      cycleCliqueRamseyNumber k n = (k - 1) * (n - 1) + 1 := by
  rcases eventually_atTop.1 hExclude with ⟨K₀, hK₀⟩
  refine ⟨max 3 K₀, ?_⟩
  intro n hn k hnk
  have hn3 : 3 ≤ n := (le_max_left 3 K₀).trans hn
  have hkK₀ : K₀ ≤ k := (le_max_right 3 K₀).trans (hn.trans hnk)
  have hprop : CycleCliqueRamseyProperty k n ((k - 1) * (n - 1) + 1) :=
    diagonalUpperAt_of_denseCounterexampleExcluded (k := k) (by omega) (hK₀ k hkK₀)
      n (by omega) hnk
  apply le_antisymm
  · exact cycleCliqueRamseyNumber_le_of_property hprop
  · exact cycleCliqueRamsey_lower_bound k n (by omega) (by omega)

/-! ## Long-path input for dense extraction -/

/-- A maximal simple path exists in every nonempty finite graph.  Mathlib
contains this argument internally in its path development; we keep the small
exported version needed by the KLS dense-extraction step here. -/
theorem exists_maximal_isPath {V : Type*} (G : SimpleGraph V) [Nonempty V]
    [Finite G.edgeSet] :
    ∃ (u v : V) (p : G.Walk u v) (_ : p.IsPath),
      ∀ (u' v' : V) (p' : G.Walk u' v') (_ : p'.IsPath), p'.length ≤ p.length := by
  have := Fintype.ofFinite G.edgeSet
  let s := {n | ∃ (u v : V) (p : G.Walk u v), p.IsPath ∧ p.length = n}
  have hs : s.Finite := Set.Finite.subset (Set.finite_le_nat G.edgeFinset.card)
    fun n ⟨_, _, _, hp, hn⟩ ↦ hn ▸ hp.isTrail.length_le_card_edgeFinset
  obtain ⟨x⟩ := ‹Nonempty V›
  obtain ⟨_, ⟨⟨u, v, p, hp, _⟩, hn⟩⟩ := hs.exists_maximal
    ⟨0, ⟨x, x, Walk.nil, by simp⟩⟩
  refine ⟨u, v, p, hp, fun u' v' p' hp' ↦ ?_⟩
  have h := hn ⟨u', v', p', hp', Eq.refl p'.length⟩
  lia

/-- A finite graph contains a simple path of length at least its minimum
degree.  This is the endpoint-neighbour counting part of the
Erdős--Gallai-style path input used by KLS. -/
theorem exists_isPath_length_ge_minDegree {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∃ u v : V, ∃ p : G.Walk u v, p.IsPath ∧ G.minDegree ≤ p.length := by
  obtain ⟨u, v, p, hp, hmax⟩ := exists_maximal_isPath G
  refine ⟨u, v, p, hp, ?_⟩
  have hsubset : G.neighborFinset u ⊆ p.support.toFinset.erase u := by
    intro w hw
    rw [SimpleGraph.mem_neighborFinset] at hw
    have hwu : G.Adj w u := hw.symm
    have hwmem : w ∈ p.support := by
      by_contra hnot
      have hp' : (p.cons hwu).IsPath := hp.cons hnot
      have hle := hmax w v (p.cons hwu) hp'
      simp at hle
    exact Finset.mem_erase.mpr ⟨hw.ne.symm, by simpa using hwmem⟩
  have hcard := Finset.card_le_card hsubset
  rw [SimpleGraph.card_neighborFinset_eq_degree] at hcard
  have hsupport : p.support.toFinset.card = p.length + 1 := by
    rw [List.toFinset_card_of_nodup hp.support_nodup]
    exact p.length_support
  have herase : (p.support.toFinset.erase u).card = p.length := by
    rw [Finset.card_erase_of_mem (by simp), hsupport]
    omega
  rw [herase] at hcard
  exact (G.minDegree_le_degree u).trans hcard

/-- A maximal simple path with a prescribed starting vertex. -/
theorem exists_maximal_isPath_from {V : Type*} (G : SimpleGraph V) (x : V)
    [Finite G.edgeSet] :
    ∃ (v : V) (p : G.Walk x v) (_ : p.IsPath),
      ∀ (v' : V) (p' : G.Walk x v') (_ : p'.IsPath), p'.length ≤ p.length := by
  have := Fintype.ofFinite G.edgeSet
  let s := {n | ∃ (v : V) (p : G.Walk x v), p.IsPath ∧ p.length = n}
  have hs : s.Finite := Set.Finite.subset (Set.finite_le_nat G.edgeFinset.card)
    fun n ⟨_, _, hp, hn⟩ ↦ hn ▸ hp.isTrail.length_le_card_edgeFinset
  obtain ⟨_, ⟨⟨v, p, hp, _⟩, hn⟩⟩ := hs.exists_maximal
    ⟨0, ⟨x, Walk.nil, by simp⟩⟩
  refine ⟨v, p, hp, fun v' p' hp' ↦ ?_⟩
  have h := hn ⟨v', p', hp', Eq.refl p'.length⟩
  lia

/-- Pósa endpoint rotation in the precise form needed by the short-dense
subgraph lemma.  If `u` is a neighbor of the terminal vertex of a simple
path, reverse the suffix after `u`; this preserves the starting vertex,
the length, and the support, but changes the terminal vertex to the
successor of `u` on the original path. -/
theorem exists_rotated_isPath_from_of_adj_endpoint_mem_support
    {V : Type*} (G : SimpleGraph V) {x v u : V}
    {p : G.Walk x v} (hp : p.IsPath) (hu : u ∈ p.support)
    (hvu : G.Adj v u) :
    ∃ w : V, ∃ q : G.Walk x w, q.IsPath ∧ q.length = p.length ∧
      q.support.toFinset = p.support.toFinset := by
  obtain ⟨a, r, ha, hr, hpr⟩ := (hp.mem_support_iff_exists_append).mp hu
  have huv : G.Adj u v := hvu.symm
  cases r with
  | nil =>
      exact (hvu.ne rfl).elim
  | cons huw r' =>
      let s := huv.toWalk.append r'.reverse
      let q := a.append s
      refine ⟨_, q, ?_, ?_, ?_⟩
      have hp' : (a.append (Walk.cons huw r')).IsPath := by simpa [hpr] using hp
      have hdis0 := hp'.disjoint_support_of_append (q := Walk.cons huw r') (by simp)
      have hdis : a.support.Disjoint r'.support := by simpa using hdis0
      have hr' : r'.IsPath := (Walk.cons_isPath_iff huw r').mp hr |>.1
      have hdisrev : a.support.Disjoint r'.support.reverse := by
        rw [List.disjoint_left] at hdis ⊢
        intro z hza hz
        exact hdis hza (by simpa using hz)
      unfold q s
      rw [Walk.isPath_def, Walk.support_append]
      simp only [Walk.support_append, Walk.support_reverse]
      simp only [Walk.support_cons, Walk.support_nil, List.tail_reverse, List.cons_append, List.nil_append,
    List.tail_cons]
      have hrev : r'.support.reverse = v :: r'.support.dropLast.reverse := by
        rw [← r'.dropLast_support_concat]
        simp
      have hsuf : (v :: r'.support.dropLast.reverse).Nodup := by
        rw [← hrev]
        exact List.nodup_reverse.mpr hr'.support_nodup
      have hdis2 : a.support.Disjoint (v :: r'.support.dropLast.reverse) := by
        rw [← hrev]
        exact hdisrev
      exact List.Nodup.append ha.support_nodup hsuf hdis2
      · simp [q, s, hpr]
      · ext z
        simp [q, s, hpr, Walk.support_append, Walk.support_reverse]

/-- Indexed Pósa rotation.  This version identifies the new endpoint as the
successor of position `i`; unlike the membership-only formulation above, it
is directly iterable over the terminal neighborhood and will supply a
linear set of distinct closed-neighborhood vertices in the short-dense
subgraph argument. -/
theorem exists_rotated_isPath_from_at_index
    {V : Type*} (G : SimpleGraph V) {x v : V}
    {p : G.Walk x v} (hp : p.IsPath) (i : ℕ) (hi : i < p.length)
    (hvi : G.Adj v (p.getVert i)) :
    ∃ q : G.Walk x (p.getVert (i + 1)), q.IsPath ∧ q.length = p.length ∧
      q.support.toFinset = p.support.toFinset := by
  let a := p.take i
  let r' := p.drop (i + 1)
  have huv : G.Adj (p.getVert i) v := hvi.symm
  let s := huv.toWalk.append r'.reverse
  let q := a.append s
  have hi1 : i + 1 ≤ p.length := by omega
  refine ⟨q, ?_, ?_, ?_⟩
  have hpSplit : (a.append (p.drop i)).IsPath := by
    dsimp [a]
    rw [p.append_take_drop_eq]
    exact hp
  have hdropNotNil : ¬ (p.drop i).Nil := by
    intro hnil
    have : (p.drop i).length = 0 := Walk.nil_iff_length_eq.mp hnil
    simp at this
    omega
  have hdis0 := hpSplit.disjoint_support_of_append (q := p.drop i) hdropNotNil
  have hdis : a.support.Disjoint r'.support := by
    simpa [r', Walk.support_tail_of_not_nil, hdropNotNil,
      Walk.drop_support_eq_support_drop_min, Nat.min_eq_left hi.le,
      Nat.min_eq_left hi1] using hdis0
  have hr' : r'.IsPath := hp.drop (i + 1)
  have hdisrev : a.support.Disjoint r'.support.reverse := by
    rw [List.disjoint_left] at hdis ⊢
    intro z hza hz
    exact hdis hza (by simpa using hz)
  unfold q s
  rw [Walk.isPath_def, Walk.support_append]
  simp only [Walk.support_append, Walk.support_reverse]
  simp only [Walk.support_cons, Walk.support_nil, List.tail_reverse, List.cons_append, List.nil_append,
    List.tail_cons]
  have hrev : r'.support.reverse = v :: r'.support.dropLast.reverse := by
    rw [← r'.dropLast_support_concat]
    simp
  have hsuf : (v :: r'.support.dropLast.reverse).Nodup := by
    rw [← hrev]
    exact List.nodup_reverse.mpr hr'.support_nodup
  have hdis2 : a.support.Disjoint (v :: r'.support.dropLast.reverse) := by
    rw [← hrev]
    exact hdisrev
  exact List.Nodup.append (hp.take i).support_nodup hsuf hdis2
  · simp [q, s, a, r', Nat.min_eq_left hi.le, Nat.min_eq_left hi1]
    omega
  · ext z
    simp only [List.mem_toFinset]
    rw [← List.mem_append, List.take_append_drop]

/-- Every indexed rotated endpoint of a path that is longest from its
starting vertex has all of its neighbors inside the original support.
Otherwise the rotated path could be extended by one edge, contradicting
maximality. -/
theorem neighborFinset_subset_support_of_maximal_rotated_endpoint
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length)
    (i : ℕ) (hi : i < p.length) (hvi : G.Adj v (p.getVert i)) :
    G.neighborFinset (p.getVert (i + 1)) ⊆ p.support.toFinset := by
  obtain ⟨q, hq, hqlen, hqsupp⟩ :=
    exists_rotated_isPath_from_at_index G hp i hi hvi
  intro z hz
  rw [SimpleGraph.mem_neighborFinset] at hz
  by_contra hznot
  have hzq : z ∉ q.support := by
    intro hzq
    apply hznot
    rw [← hqsupp]
    simpa using hzq
  have hqext : (q.concat hz).IsPath := hq.concat hzq (h := hz)
  have hle := hmax z (q.concat hz) hqext
  simp [hqlen] at hle

/-- Every neighbor of the endpoint of a longest path occurs strictly before
the final support position.  This is the indexing fact that makes the Pósa
successor map defined on the whole terminal neighborhood. -/
theorem idxOf_terminal_neighbor_lt_length_of_maximal_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length)
    {u : V} (hu : u ∈ G.neighborFinset v) :
    p.support.idxOf u < p.length := by
  have huAdj : G.Adj v u := by simpa [SimpleGraph.mem_neighborFinset] using hu
  have huSupp : u ∈ p.support := by
    by_contra hnot
    have hp' : (p.concat huAdj).IsPath := hp.concat hnot (h := huAdj)
    have hle := hmax u (p.concat huAdj) hp'
    simp at hle
  have hidx : p.support.idxOf u < p.support.length :=
    List.idxOf_lt_length_of_mem huSupp
  have hle : p.support.idxOf u ≤ p.length := by
    rw [p.length_support] at hidx
    omega
  by_contra hnot
  have heq : p.support.idxOf u = p.length := by omega
  have huv : u = v := by
    calc
      u = p.getVert (p.support.idxOf u) := (p.getVert_support_idxOf huSupp).symm
      _ = p.getVert p.length := by rw [heq]
      _ = v := p.getVert_length
  exact huAdj.ne huv.symm

/-- The successor of every terminal neighbor of a longest path is itself
closed inside the path support.  These successors are the vertices whose
degree sum gives the quadratic edge mass in the eventual short-dense
subgraph lemma. -/
theorem neighborFinset_subset_support_of_maximal_terminal_successor
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length)
    {u : V} (hu : u ∈ G.neighborFinset v) :
    G.neighborFinset (p.getVert (p.support.idxOf u + 1)) ⊆
      p.support.toFinset := by
  have huAdj : G.Adj v u := by simpa [SimpleGraph.mem_neighborFinset] using hu
  have huSupp : u ∈ p.support := by
    by_contra hnot
    have hp' : (p.concat huAdj).IsPath := hp.concat hnot (h := huAdj)
    have hle := hmax u (p.concat huAdj) hp'
    simp at hle
  have hi := idxOf_terminal_neighbor_lt_length_of_maximal_path G hp hmax hu
  have hvi : G.Adj v (p.getVert (p.support.idxOf u)) := by
    rw [p.getVert_support_idxOf huSupp]
    exact huAdj
  exact neighborFinset_subset_support_of_maximal_rotated_endpoint G hp hmax
    (p.support.idxOf u) hi hvi

/-- The set of Pósa successors of the terminal neighbors of a path. -/
noncomputable def terminalSuccessorFinset
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} (p : G.Walk x v) : Finset V :=
  (G.neighborFinset v).image fun u => p.getVert (p.support.idxOf u + 1)

/-- On a longest path from a fixed start, the Pósa successor map is
injective on the terminal neighborhood.  Hence the closed successor set has
exactly the terminal degree many vertices. -/
theorem card_terminalSuccessorFinset_eq_degree_of_maximal_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length) :
    (terminalSuccessorFinset G p).card = G.degree v := by
  classical
  have hsupp : ∀ u ∈ G.neighborFinset v, u ∈ p.support := by
    intro u hu
    have huAdj : G.Adj v u := by simpa [SimpleGraph.mem_neighborFinset] using hu
    by_contra hnot
    have hp' : (p.concat huAdj).IsPath := hp.concat hnot (h := huAdj)
    have hle := hmax u (p.concat huAdj) hp'
    simp at hle
  have hinj : Set.InjOn (fun u => p.getVert (p.support.idxOf u + 1))
      (G.neighborFinset v : Set V) := by
    intro u hu w hw heq
    have hu' : u ∈ p.support := hsupp u (by simpa using hu)
    have hw' : w ∈ p.support := hsupp w (by simpa using hw)
    have hiu := idxOf_terminal_neighbor_lt_length_of_maximal_path G hp hmax
      (by simpa using hu)
    have hiw := idxOf_terminal_neighbor_lt_length_of_maximal_path G hp hmax
      (by simpa using hw)
    have hiu' : p.support.idxOf u + 1 < p.support.length := by
      rw [p.length_support]
      omega
    have hiw' : p.support.idxOf w + 1 < p.support.length := by
      rw [p.length_support]
      omega
    let iu : Fin p.support.length := ⟨p.support.idxOf u + 1, hiu'⟩
    let iw : Fin p.support.length := ⟨p.support.idxOf w + 1, hiw'⟩
    have hget : p.support.get iu = p.support.get iw := by
      change p.support[p.support.idxOf u + 1] =
        p.support[p.support.idxOf w + 1]
      rw [← p.getVert_eq_support_getElem (by omega),
        ← p.getVert_eq_support_getElem (by omega)]
      exact heq
    have hieq : iu = iw := (hp.support_nodup.get_inj_iff).mp hget
    have hidx : p.support.idxOf u = p.support.idxOf w := by
      have hval := congrArg Fin.val hieq
      dsimp [iu, iw] at hval
      omega
    exact (List.idxOf_inj hu').mp hidx
  unfold terminalSuccessorFinset
  rw [Finset.card_image_of_injOn hinj]
  simpa using (SimpleGraph.card_neighborFinset_eq_degree (G := G) v)

/-- Every Pósa successor of a terminal neighbor is a vertex of the original
longest path.  This is the set-containment half of the short dense piece
counting argument. -/
theorem terminalSuccessorFinset_subset_support_of_maximal_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length) :
    terminalSuccessorFinset G p ⊆ p.support.toFinset := by
  classical
  intro z hz
  rw [terminalSuccessorFinset, Finset.mem_image] at hz
  obtain ⟨u, _hu, rfl⟩ := hz
  simpa using p.getVert_mem_support (p.support.idxOf u + 1)

/-- Every Pósa successor is closed inside the original path support: all of
its ambient neighbors lie on that path.  The rotation lemma above proves this
pointwise; this finite-set wrapper is the form used in the degree sum. -/
theorem neighborFinset_subset_support_of_mem_terminalSuccessorFinset
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length)
    {z : V} (hz : z ∈ terminalSuccessorFinset G p) :
    G.neighborFinset z ⊆ p.support.toFinset := by
  classical
  rw [terminalSuccessorFinset, Finset.mem_image] at hz
  obtain ⟨u, hu, rfl⟩ := hz
  exact neighborFinset_subset_support_of_maximal_terminal_successor G hp hmax hu

/-- From any prescribed vertex, a finite graph has a simple path of length
at least its minimum degree. -/
theorem exists_isPath_from_length_ge_minDegree {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (x : V) :
    ∃ v : V, ∃ p : G.Walk x v, p.IsPath ∧ G.minDegree ≤ p.length := by
  obtain ⟨v, p, hp, hmax⟩ := exists_maximal_isPath_from G x
  refine ⟨v, p, hp, ?_⟩
  have hsubset : G.neighborFinset v ⊆ p.support.toFinset.erase v := by
    intro w hw
    rw [SimpleGraph.mem_neighborFinset] at hw
    have hwmem : w ∈ p.support := by
      by_contra hnot
      have hp' : (p.concat hw).IsPath := hp.concat hnot (h := hw)
      have hle := hmax w (p.concat hw) hp'
      simp at hle
    exact Finset.mem_erase.mpr ⟨hw.ne.symm, by simpa using hwmem⟩
  have hcard := Finset.card_le_card hsubset
  rw [SimpleGraph.card_neighborFinset_eq_degree] at hcard
  have hsupport : p.support.toFinset.card = p.length + 1 := by
    rw [List.toFinset_card_of_nodup hp.support_nodup]
    exact p.length_support
  have herase : (p.support.toFinset.erase v).card = p.length := by
    rw [Finset.card_erase_of_mem (by simp), hsupport]
    omega
  rw [herase] at hcard
  exact (G.minDegree_le_degree v).trans hcard

/-- There is a path of length at least `D` starting at `x`. -/
def HasPathFromAtLeast {V : Type*} (G : SimpleGraph V) (x : V) (D : ℕ) : Prop :=
  ∃ v : V, ∃ p : G.Walk x v, p.IsPath ∧ D ≤ p.length

theorem HasPathFromAtLeast.mono {V : Type*} {G : SimpleGraph V} {x : V}
    {D E : ℕ} (hDE : D ≤ E) (h : HasPathFromAtLeast G x E) :
    HasPathFromAtLeast G x D := by
  obtain ⟨v, p, hp, hlen⟩ := h
  exact ⟨v, p, hp, hDE.trans hlen⟩

/-- Minimum degree alone already supplies a long path from every prescribed
start vertex. -/
theorem hasPathFromAtLeast_of_le_minDegree {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (x : V) {D : ℕ}
    (hD : D ≤ G.minDegree) : HasPathFromAtLeast G x D := by
  obtain ⟨v, p, hp, hlen⟩ := exists_isPath_from_length_ge_minDegree G x
  exact ⟨v, p, hp, hD.trans hlen⟩

theorem minDegree_lt_of_not_hasPathFromAtLeast {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (x : V) {D : ℕ}
    (hno : ¬ HasPathFromAtLeast G x D) : G.minDegree < D := by
  by_contra hD
  exact hno (hasPathFromAtLeast_of_le_minDegree G x (by omega))

/-- A Hamilton cycle in a graph on exactly `k` vertices is an ordinary copy
of `cycleGraph k`.  This is the bridge used whenever a dense extracted piece
is made Hamiltonian by a Dirac/Bondy-type argument. -/
theorem cycleGraph_isContained_of_isHamiltonian {k : ℕ} (hk : 2 < k)
    (G : SimpleGraph (Fin k)) (hG : G.IsHamiltonian) : cycleGraph k ⊑ G := by
  rw [SimpleGraph.cycleGraph_isContained_iff hk]
  have hkne : Fintype.card (Fin k) ≠ 1 := by simp; omega
  obtain ⟨v, p, hp⟩ := hG hkne
  exact ⟨v, p, hp.isCycle, by simpa using hp.length_eq⟩

/-- Dirac's theorem in the exact form used by the KLS cleanup: if every
degree is at least half the order, the graph contains a spanning ordinary
cycle.  The imported Bondy--Chvátal development proves Dirac without any
additional assumptions or placeholders. -/
theorem cycleGraph_isContained_of_two_mul_degree_ge_card
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) (hcard : Fintype.card V = k)
    (hdegree : ∀ v : V, k ≤ 2 * G.degree v) :
    cycleGraph k ⊑ G := by
  have hham : G.IsHamiltonian := by
    apply SimpleGraph.dirac_theorem (G := G)
    · omega
    · intro v
      simpa [hcard] using hdegree v
  rw [SimpleGraph.cycleGraph_isContained_iff (by omega)]
  have hkne : Fintype.card V ≠ 1 := by omega
  obtain ⟨v, p, hp⟩ := hham hkne
  exact ⟨v, p, hp.isCycle, hp.length_eq.trans hcard⟩

/-- Subtype version of the same dense-core criterion.  This is the form that
applies after stability produces a `k`-vertex subset with large induced
minimum degree. -/
theorem cycleGraph_isContained_of_induced_two_mul_degree_ge_card
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {k : ℕ} (hk : 3 ≤ k) (hcard : S.card = k)
    (hdegree : ∀ v : S, k ≤ 2 * (G.induce (S : Set V)).degree v) :
    cycleGraph k ⊑ G := by
  let H : SimpleGraph S := G.induce (S : Set V)
  have hH : cycleGraph k ⊑ H := by
    apply cycleGraph_isContained_of_two_mul_degree_ge_card H hk
    · simpa [H] using hcard
    · intro v
      simpa [H] using hdegree v
  exact hH.trans (SimpleGraph.Embedding.induce (G := G) (S : Set V)).isContained

/-- Degree of a vertex into a finite set, kept as a filtered cardinality so
that trimming estimates reduce to elementary finset counting. -/
def degreeIn {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (v : V) : ℕ :=
  (S.filter fun w => G.Adj v w).card

theorem degreeIn_mono
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S T : Finset V} (hST : S ⊆ T) (v : V) :
    degreeIn G S v ≤ degreeIn G T v := by
  exact Finset.card_le_card (Finset.filter_subset_filter _ hST)

/-- If a finite set contains every neighbor of a vertex, then the degree of
that vertex inside the set is its full ambient degree. -/
theorem degreeIn_eq_degree_of_neighborFinset_subset
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (v : V) (hsub : G.neighborFinset v ⊆ S) :
    degreeIn G S v = G.degree v := by
  classical
  have hfin : S.filter (fun w => G.Adj v w) = G.neighborFinset v := by
    ext w
    constructor
    · intro hw
      exact (SimpleGraph.mem_neighborFinset G v w).2 (Finset.mem_filter.mp hw).2
    · intro hw
      exact Finset.mem_filter.mpr
        ⟨hsub hw, (SimpleGraph.mem_neighborFinset G v w).1 hw⟩
  unfold degreeIn
  rw [hfin, SimpleGraph.card_neighborFinset_eq_degree]

def DisjointFinsetFamily {V : Type*} (F : Finset (Finset V)) : Prop :=
  ∀ A ∈ F, ∀ B ∈ F, A ≠ B → Disjoint A B

def PairwiseAnticomplete {V : Type*} (G : SimpleGraph V)
    (F : Finset (Finset V)) : Prop :=
  ∀ A ∈ F, ∀ B ∈ F, A ≠ B → ∀ a ∈ A, ∀ b ∈ B, ¬ G.Adj a b

def CompleteStablePartition {V : Type*} (G : SimpleGraph V) (k : ℕ) : Prop :=
  ∃ F : Finset (Finset V),
    (∀ A ∈ F, A.Nonempty) ∧ DisjointFinsetFamily F ∧
    PairwiseAnticomplete G F ∧
    (∀ v : V, ∃ A ∈ F, v ∈ A) ∧
    (∀ A ∈ F, A.card ≤ k - 1)

noncomputable def MultiSeedLeftoverFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V) : Finset V :=
  L.filter fun x =>
    ∃ i j : ι, i ≠ j ∧
      (∃ a ∈ U i, G.Adj x a) ∧
      ∃ b ∈ U j, G.Adj x b

theorem sub_le_card_sdiff_of_le_card_of_card_le
    {V : Type*} [Fintype V] {A X : Finset V} {τ E : ℕ}
    (hA : τ ≤ A.card) (hX : X.card ≤ E) :
    τ - E ≤ (A \ X).card := by
  rw [Finset.card_sdiff]
  have hinter : (X ∩ A).card ≤ X.card :=
    Finset.card_le_card Finset.inter_subset_left
  omega

theorem completeStablePartition_of_seed_blocks_and_leftover_assignment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : V → ι)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v ∈ L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v b)
    (hLedge : ∀ u ∈ L, ∀ v ∈ L, G.Adj u v → assign u = assign v)
    (hcap : ∀ i : ι,
      (B i ∪ L.filter fun v => assign v = i).card ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let C : ι → Finset V := fun i => B i ∪ L.filter fun v => assign v = i
  let F : Finset (Finset V) := (Finset.univ : Finset ι).image C
  refine ⟨F, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact (hBne i).mono Finset.subset_union_left
  · intro A hA D hD hAD
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hD with ⟨j, _hj, rfl⟩
    rw [Finset.disjoint_left]
    intro v hvi hvj
    simp only [C, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and] at hvi hvj
    rcases hvi with hvi | ⟨hvL, hvi⟩ <;>
      rcases hvj with hvj | ⟨hvL', hvj⟩
    · by_cases hij : i = j
      · apply hAD
        rw [hij]
      · exact (Finset.disjoint_left.mp (hBdisj i j hij)) hvi hvj
    · exact (Finset.disjoint_left.mp (hBL i)) hvi hvL'
    · exact (Finset.disjoint_left.mp (hBL j)) hvj hvL
    · have hij : i = j := by rw [← hvi, ← hvj]
      apply hAD
      rw [hij]
  · intro A hA D hD hAD a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hD with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      apply hAD
      rw [h]
    simp only [C, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
    rcases ha with ha | ⟨haL, hai⟩ <;>
      rcases hb with hb | ⟨hbL, hbj⟩
    · exact hBanti i j hij a ha b hb hab
    · have hine : i ≠ assign b := by simpa [hbj] using hij
      exact (hcompat b hbL i hine a ha) hab.symm
    · have hjne : j ≠ assign a := by
        intro h
        apply hij
        rw [← hai, ← h]
      exact hcompat a haL j hjne b hb hab
    · have heq := hLedge a haL b hbL hab
      apply hij
      rw [← hai, ← hbj, heq]
  · intro v
    rcases hcover v with hvL | ⟨i, hvi⟩
    · refine ⟨C (assign v), ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨assign v, Finset.mem_univ _, rfl⟩
      · simp [C, hvL]
    · refine ⟨C i, ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
      · exact Finset.mem_union_left _ hvi
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hcap i

/-
theorem exists_compatible_assignment_of_leftover_separation
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (B : ι → Finset V) (L : Finset V)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False) :
    ∃ assign : L → ι,
      (∀ v : L, ∀ j : ι, j ≠ assign v →
        ∀ b ∈ B j, ¬ G.Adj v.1 b) ∧
      (∀ u v : L, G.Adj u.1 v.1 → assign u = assign v) := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  let label : H.ConnectedComponent → ι := fun c =>
    if h : ∃ i : ι, ∃ u : L, u ∈ c.supp ∧ ∃ a ∈ B i, G.Adj u.1 a
    then Classical.choose h
    else Classical.choice inferInstance
  let assign : L → ι := fun v => label (H.connectedComponentMk v)
  refine ⟨assign, ?_, ?_⟩
  · intro v j hj b hb hvb
    let c : H.ConnectedComponent := H.connectedComponentMk v
    by_cases h : ∃ i : ι, ∃ u : L, u ∈ c.supp ∧ ∃ a ∈ B i, G.Adj u.1 a
    · obtain ⟨i, u, hu, a, ha, hua⟩ := h
      have hi : assign v = i := by
        simp [assign, label, c, h]
      have hji : j ≠ i := by simpa [hi] using hj
      exact hseparate i j hji u v
        (c.reachable_of_mem_supp hu
          (SimpleGraph.ConnectedComponent.connectedComponentMk_mem (G := H) (v := v)))
        ⟨a, ha, hua⟩ ⟨b, hb, hvb⟩
    · apply h
      exact ⟨j, v,
        SimpleGraph.ConnectedComponent.connectedComponentMk_mem (G := H) (v := v),
        b, hb, hvb⟩
  · intro u v huv
    have hHadj : H.Adj u v := huv
    have hcomp : H.connectedComponentMk u = H.connectedComponentMk v :=
      SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hHadj
    simp [assign, hcomp]
-/

theorem exists_compatible_assignment_of_leftover_separation_early
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (B : ι → Finset V) (L : Finset V)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False) :
    ∃ assign : L → ι,
      (∀ v : L, ∀ j : ι, j ≠ assign v →
        ∀ b ∈ B j, ¬ G.Adj v.1 b) ∧
      ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  have hcomponent : ∀ c : H.ConnectedComponent,
      ∃ i : ι, ∀ v : L, v ∈ c.supp → ∀ j : ι, j ≠ i →
        ∀ b ∈ B j, ¬ G.Adj v.1 b := by
    intro c
    by_cases hattach : ∃ i : ι, ∃ u : L, u ∈ c.supp ∧
        ∃ a ∈ B i, G.Adj u.1 a
    · rcases hattach with ⟨i, u, hu, a, ha, hua⟩
      refine ⟨i, ?_⟩
      intro v hv j hji b hb hvb
      exact hseparate i j (Ne.symm hji) u v
        (c.reachable_of_mem_supp hu hv)
        ⟨a, ha, hua⟩ ⟨b, hb, hvb⟩
    · let i : ι := Classical.choice inferInstance
      refine ⟨i, ?_⟩
      intro v hv j _hji b hb hvb
      exact (hattach ⟨j, v, hv, b, hb, hvb⟩).elim
  let label : H.ConnectedComponent → ι := fun c =>
    Classical.choose (hcomponent c)
  let assign : L → ι := fun v => label (H.connectedComponentMk v)
  refine ⟨assign, ?_, ?_⟩
  · intro v j hj b hb
    have hspec := Classical.choose_spec (hcomponent (H.connectedComponentMk v))
    have hj' : j ≠ Classical.choose (hcomponent (H.connectedComponentMk v)) := by
      simpa [assign, label] using hj
    exact hspec v
      (SimpleGraph.ConnectedComponent.connectedComponentMk_mem
        (G := H) (v := v)) j hj' b hb
  · intro u v huv
    have hHadj : H.Adj u v := huv
    have hcomp : H.connectedComponentMk u = H.connectedComponentMk v :=
      SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hHadj
    simp [assign, hcomp]

/-- If all neighbors of a vertex lie in a finite set and its degree is at
least one below the set order, then it is adjacent to every other vertex of
the set.  This small saturation lemma is the last local ingredient in the
long-path alternative for a dense counterexample. -/
theorem neighborFinset_eq_erase_of_subset_of_pred_le_degree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (v : V) (hv : v ∈ S)
    (hsub : G.neighborFinset v ⊆ S)
    (hdeg : S.card - 1 ≤ G.degree v) :
    G.neighborFinset v = S.erase v := by
  classical
  apply Finset.eq_of_subset_of_card_le
  · intro w hw
    have hadj : G.Adj v w := (SimpleGraph.mem_neighborFinset G v w).1 hw
    exact Finset.mem_erase.mpr ⟨hadj.ne.symm, hsub hw⟩
  · rw [Finset.card_erase_of_mem hv, SimpleGraph.card_neighborFinset_eq_degree]
    exact hdeg

/-- The degree in an induced graph is the filtered ambient degree. -/
theorem degree_induce_finset_eq_degreeIn
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (x : S) :
    (G.induce (S : Set V)).degree x = degreeIn G S x := by
  classical
  unfold SimpleGraph.degree SimpleGraph.neighborFinset degreeIn
  rw [Set.toFinset_card, ← Fintype.card_coe]
  apply Fintype.card_congr
  exact
    { toFun := fun y => ⟨y.1.1, Finset.mem_filter.mpr ⟨y.1.2, y.2⟩⟩
      invFun := fun y =>
        ⟨⟨y.1, (Finset.mem_filter.mp y.2).1⟩, (Finset.mem_filter.mp y.2).2⟩
      left_inv := fun y => by ext; rfl
      right_inv := fun y => by ext; rfl }

/-- Trimming from `S` to `T` deletes at most `|S|-|T|` neighbors of any
fixed vertex. -/
theorem degreeIn_le_degreeIn_add_card_loss
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {T S : Finset V} (hTS : T ⊆ S) (v : V) :
    degreeIn G S v ≤ degreeIn G T v + (S.card - T.card) := by
  classical
  let A := S.filter fun w => G.Adj v w
  let B := T.filter fun w => G.Adj v w
  have hBA : B ⊆ A := Finset.filter_subset_filter _ hTS
  have hdiff : A \ B ⊆ S \ T := by
    intro w hw
    rw [Finset.mem_sdiff] at hw ⊢
    have hwS : w ∈ S := (Finset.mem_filter.mp hw.1).1
    refine ⟨hwS, ?_⟩
    intro hwT
    exact hw.2 (Finset.mem_filter.mpr ⟨hwT, (Finset.mem_filter.mp hw.1).2⟩)
  have hcarddiff : (A \ B).card ≤ (S \ T).card := Finset.card_le_card hdiff
  have hsplitA : A.card = (A \ B).card + B.card := by
    have h := Finset.card_sdiff_add_card A B
    rw [Finset.union_eq_left.mpr hBA] at h
    omega
  have hsplitS : (S \ T).card + T.card = S.card := by
    have h := Finset.card_sdiff_add_card S T
    rw [Finset.union_eq_left.mpr hTS] at h
    exact h
  have hdiffcard : (S \ T).card = S.card - T.card := by
    have hcardTS := Finset.card_le_card hTS
    omega
  change A.card ≤ B.card + (S.card - T.card)
  omega

/-- If a dense induced set is larger than `k`, trimming it to exactly `k`
vertices preserves enough degree for Dirac whenever the original defect is
at most `k/2`.  This is the precise cleanup step used at the end of the KLS
stability lemma. -/
theorem cycleGraph_isContained_of_dense_induced_set
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {k d : ℕ} (hk : 3 ≤ k) (hkS : k ≤ S.card)
    (hd : 2 * d ≤ k)
    (hdegree : ∀ v : S, S.card - d ≤ (G.induce (S : Set V)).degree v) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨T, hTS, hTcard⟩ := Finset.exists_subset_card_eq hkS
  apply cycleGraph_isContained_of_induced_two_mul_degree_ge_card G hk hTcard
  intro v
  let vS : S := ⟨v.1, hTS v.2⟩
  have hlarge : S.card - d ≤ degreeIn G S v := by
    have hlarge' := hdegree vS
    rw [degree_induce_finset_eq_degreeIn] at hlarge'
    simpa [vS] using hlarge'
  have hloss : degreeIn G S v ≤ degreeIn G T v + (S.card - T.card) :=
    degreeIn_le_degreeIn_add_card_loss G hTS v
  have hTdegree : (G.induce (T : Set V)).degree v = degreeIn G T v :=
    degree_induce_finset_eq_degreeIn G T v
  rw [hTdegree]
  omega

/-- General trimming criterion: from a set of order at least `k`, each kept
vertex loses at most `|S|-k` neighbors when trimming to `k` vertices.  If the
remaining guaranteed degree is still at least `k/2`, Dirac gives `Cₖ`. -/
theorem cycleGraph_isContained_of_trimmed_minDegree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {k δ : ℕ} (hk : 3 ≤ k) (hkS : k ≤ S.card)
    (hmin : δ ≤ (G.induce (S : Set V)).minDegree)
    (htrim : k ≤ 2 * (δ - (S.card - k))) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨T, hTS, hTcard⟩ := Finset.exists_subset_card_eq hkS
  apply cycleGraph_isContained_of_induced_two_mul_degree_ge_card G hk hTcard
  intro v
  let vS : S := ⟨v.1, hTS v.2⟩
  have hlarge : δ ≤ degreeIn G S v := by
    have hlarge' := hmin.trans ((G.induce (S : Set V)).minDegree_le_degree vS)
    rw [degree_induce_finset_eq_degreeIn] at hlarge'
    simpa [vS] using hlarge'
  have hloss : degreeIn G S v ≤ degreeIn G T v + (S.card - T.card) :=
    degreeIn_le_degreeIn_add_card_loss G hTS v
  rw [degree_induce_finset_eq_degreeIn]
  rw [hTcard] at hloss
  omega

/-- Whole-vertex-set version of the trimming criterion.  It avoids an
unnecessary nested `induce univ` when the dense set is already the ambient
finite graph, which is especially useful for connected components. -/
theorem cycleGraph_isContained_of_trimmed_minDegree_univ
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k δ : ℕ} (hk : 3 ≤ k) (hkV : k ≤ Fintype.card V)
    (hmin : δ ≤ G.minDegree)
    (htrim : k ≤ 2 * (δ - (Fintype.card V - k))) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨T, hTuniv, hTcard⟩ :=
    Finset.exists_subset_card_eq (s := (Finset.univ : Finset V)) hkV
  apply cycleGraph_isContained_of_induced_two_mul_degree_ge_card G hk hTcard
  intro v
  have hlarge : δ ≤ degreeIn G Finset.univ v := by
    have h := hmin.trans (G.minDegree_le_degree v.1)
    have huniv : degreeIn G Finset.univ v = G.degree v := by
      unfold degreeIn
      rw [← G.card_neighborFinset_eq_degree]
      congr 1
      ext w
      simp [SimpleGraph.mem_neighborFinset]
    rw [huniv]
    exact h
  have hloss : degreeIn G Finset.univ v ≤
      degreeIn G T v + (Fintype.card V - T.card) := by
    simpa using degreeIn_le_degreeIn_add_card_loss G hTuniv v
  rw [degree_induce_finset_eq_degreeIn]
  rw [hTcard] at hloss
  omega

/-- Near-`k` dense-component form of the cleanup criterion: a set of order
between `k` and `k+d` whose induced minimum degree is at least `k` already
contains `Cₖ`, provided the surplus `d` is at most `k/2`. -/
theorem cycleGraph_isContained_of_near_k_minDegree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {k d : ℕ} (hk : 3 ≤ k) (hkS : k ≤ S.card)
    (hSk : S.card ≤ k + d) (hd : 2 * d ≤ k)
    (hmin : k ≤ (G.induce (S : Set V)).minDegree) :
    cycleGraph k ⊑ G := by
  apply cycleGraph_isContained_of_dense_induced_set G hk hkS hd
  intro v
  have hkdeg : k ≤ (G.induce (S : Set V)).degree v :=
    hmin.trans ((G.induce (S : Set V)).minDegree_le_degree v)
  omega

/-
/-- One-vertex absorption into a dense `(k-1)`-block.  If the block already
has Dirac-level internal degree and an outside vertex sees at least half of
it, adjoining that vertex creates a `k`-vertex Dirac graph and hence `Cₖ`.
This is the local cleanup move used after the stability partition. -/
theorem cycleGraph_isContained_of_absorb_one_vertex
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {x : V} {k : ℕ} (hk : 3 ≤ k)
    (hScard : S.card = k - 1) (hxS : x ∉ S)
    (hSmin : k ≤ 2 * (G.induce (S : Set V)).minDegree)
    (hxdeg : k ≤ 2 * degreeIn G S x) :
    cycleGraph k ⊑ G := by
  let T : Finset V := insert x S
  have hTcard : T.card = k := by
    simp [T, Finset.card_insert_of_notMem hxS, hScard]
    omega
  apply cycleGraph_isContained_of_induced_two_mul_degree_ge_card G hk hTcard
  intro v
  rw [degree_induce_finset_eq_degreeIn]
  by_cases hvx : (v : V) = x
  · have hxdeg' : k ≤ 2 * degreeIn G S v := by simpa [hvx] using hxdeg
    have hmono : degreeIn G S v ≤ degreeIn G T v :=
      degreeIn_mono G (by simp [T]) v
    exact hxdeg'.trans (Nat.mul_le_mul_left 2 hmono)
  · have hvS : (v : V) ∈ S := by
      have hvT : (v : V) ∈ T := v.property
      change (v : V) ∈ insert x S at hvT
      rw [Finset.mem_insert] at hvT
      exact hvT.resolve_left hvx
    let vS : S := ⟨v, hvS⟩
    have hSdeg : k ≤ 2 * degreeIn G S v := by
      have h := hSmin.trans
        (Nat.mul_le_mul_left 2 ((G.induce (S : Set V)).minDegree_le_degree vS))
      rw [degree_induce_finset_eq_degreeIn] at h
      simpa [vS] using h
    have hmono : degreeIn G S v ≤ degreeIn G T v :=
      degreeIn_mono G (by simp [T]) v
    omega

/-- Contrapositive absorption bound: in a `Cₖ`-free graph, every vertex
outside a dense `(k-1)`-block has strictly fewer than `k/2` neighbors in
that block.  This is the counting inequality used when assigning leftover
vertices to stable blocks. -/
theorem two_mul_degreeIn_lt_of_cycleFree_dense_block
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {x : V} {k : ℕ} (hk : 3 ≤ k)
    (hScard : S.card = k - 1) (hxS : x ∉ S)
    (hSmin : k ≤ 2 * (G.induce (S : Set V)).minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    2 * degreeIn G S x < k := by
  by_contra hnot
  apply hcycle
  exact cycleGraph_isContained_of_absorb_one_vertex G hk hScard hxS hSmin (by omega)

/-- Degree splits exactly between a finite block and its complement in the
ambient finite vertex set.  Keeping this in `degreeIn` form makes the later
absorption estimates elementary natural-number arithmetic. -/
theorem degreeIn_add_degreeIn_compl_eq_degree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (x : V) :
    degreeIn G S x + degreeIn G ((Finset.univ : Finset V) \ S) x = G.degree x := by
  classical
  have hdisj : Disjoint
      (S.filter fun w => G.Adj x w)
      (((Finset.univ : Finset V) \ S).filter fun w => G.Adj x w) := by
    rw [Finset.disjoint_left]
    intro w hwS hwC
    have hwSin : w ∈ S := (Finset.mem_filter.mp hwS).1
    have hwCout : w ∉ S :=
      (Finset.mem_sdiff.mp (Finset.mem_filter.mp hwC).1).2
    exact hwCout hwSin
  calc
    degreeIn G S x + degreeIn G ((Finset.univ : Finset V) \ S) x =
        (S.filter fun w => G.Adj x w).card +
          (((Finset.univ : Finset V) \ S).filter fun w => G.Adj x w).card := rfl
    _ = ((S.filter fun w => G.Adj x w) ∪
          (((Finset.univ : Finset V) \ S).filter fun w => G.Adj x w)).card :=
      (Finset.card_union_of_disjoint hdisj).symm
    _ = (((Finset.univ : Finset V).filter fun w => G.Adj x w)).card := by
      rw [← Finset.filter_union]
      simp
    _ = degreeIn G (Finset.univ : Finset V) x := rfl
    _ = G.degree x :=
      degreeIn_eq_degree_of_neighborFinset_subset G Finset.univ x
        (fun _ _ => Finset.mem_univ _)

/-- In a `Cₖ`-free graph with minimum degree at least `k-1`, a vertex outside
a dense `(k-1)`-block must send almost half the target scale outside that
block.  Otherwise too many neighbours lie in the block and the checked
one-vertex absorption theorem closes a `Cₖ`. -/
theorem pred_le_two_mul_degreeIn_compl_of_cycleFree_dense_block
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {x : V} {k : ℕ} (hk : 3 ≤ k)
    (hScard : S.card = k - 1) (hxS : x ∉ S)
    (hSmin : k ≤ 2 * (G.induce (S : Set V)).minDegree)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    k - 1 ≤ 2 * degreeIn G ((Finset.univ : Finset V) \ S) x := by
  have hinside :=
    two_mul_degreeIn_lt_of_cycleFree_dense_block G hk hScard hxS hSmin hcycle
  have hsplit := degreeIn_add_degreeIn_compl_eq_degree G S x
  have hdeg : k - 1 ≤ G.degree x :=
    hmin.trans (G.minDegree_le_degree x)
  omega

/-- If every neighbour of `x` outside a block `S` lies in `L`, then the
external degree of `x` is bounded by `|L|`.  This is the finite-set wrapper
used when compatible leftover assignments forbid all other seed blocks. -/
theorem degreeIn_compl_le_card_of_neighbors_outside_subset
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (S L : Finset V) (x : V)
    (hout : ∀ y : V, G.Adj x y → y ∉ S → y ∈ L) :
    degreeIn G ((Finset.univ : Finset V) \ S) x ≤ L.card := by
  unfold degreeIn
  apply Finset.card_le_card
  intro y hy
  rcases Finset.mem_filter.mp hy with ⟨hyS, hxy⟩
  exact hout y hxy (Finset.mem_sdiff.mp hyS).2

/-- A compatible assignment and a sub-half-scale leftover force every
leftover vertex to be neighbour-rich in its assigned block.  All neighbours
outside that block lie in the leftover by covering and compatibility; split
the ambient degree and use the global minimum-degree lower bound. -/
theorem two_mul_degreeIn_assigned_block_ge_of_small_compatible_leftover
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hmin : k - 1 ≤ G.minDegree)
    (hLsmall : 2 * L.card ≤ k - 2) :
    ∀ v : L, k ≤ 2 * degreeIn G (B (assign v)) v.1 := by
  intro v
  have hout : ∀ y : V, G.Adj v.1 y → y ∉ B (assign v) → y ∈ L := by
    intro y hvy hyB
    rcases hcover y with hyL | ⟨j, hyBj⟩
    · exact hyL
    · by_cases hj : j = assign v
      · subst j
        exact (hyB hyBj).elim
      · exfalso
        exact (hcompat v j hj y hyBj) hvy
  have hsplit := degreeIn_add_degreeIn_compl_eq_degree G (B (assign v)) v.1
  have houtside := degreeIn_compl_le_card_of_neighbors_outside_subset
    G (B (assign v)) L v.1 hout
  have hdeg : k - 1 ≤ G.degree v.1 :=
    hmin.trans (G.minDegree_le_degree v.1)
  omega

/-- Independence forces complete attachment to the assigned block when there
are already exactly `n-1` nonempty anticomplete seed blocks.  If `x` missed
one vertex in its assigned block, choose that missed vertex there and one
representative in every other block; together with `x` these give an
independent `n`-set. -/
theorem adj_all_assigned_block_of_indepSetFree_of_pred_seed_blocks
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ}
    (B : ι → Finset V) (x : V) (i : ι)
    (hι : Fintype.card ι = n - 1)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ j, (B j).Nonempty)
    (hBdisj : ∀ j ℓ, j ≠ ℓ → Disjoint (B j) (B ℓ))
    (hBanti : ∀ j ℓ, j ≠ ℓ → ∀ a ∈ B j, ∀ b ∈ B ℓ, ¬ G.Adj a b)
    (hxB : ∀ j, x ∉ B j)
    (hcompat : ∀ j, j ≠ i → ∀ b ∈ B j, ¬ G.Adj x b) :
    ∀ b ∈ B i, G.Adj x b := by
  classical
  intro b hb
  by_contra hxb
  let pick : ι → V := fun j => if hj : j = i then b else (hBne j).choose
  have hpick_mem : ∀ j : ι, pick j ∈ B j := by
    intro j
    by_cases hj : j = i
    · subst j
      simpa [pick] using hb
    · simp [pick, hj, (hBne j).choose_spec]
  have hpick_inj : Function.Injective pick := by
    intro j ℓ hjℓ
    by_contra hne
    exact (Finset.disjoint_left.mp (hBdisj j ℓ hne))
      (hpick_mem j) (hjℓ ▸ hpick_mem ℓ)
  let R : Finset V := insert x ((Finset.univ : Finset ι).image pick)
  have hxnot : x ∉ (Finset.univ : Finset ι).image pick := by
    intro hx
    rcases Finset.mem_image.mp hx with ⟨j, _hj, hjx⟩
    exact hxB j (hjx ▸ hpick_mem j)
  have hRcard : R.card = n := by
    calc
      R.card = ((Finset.univ : Finset ι).image pick).card + 1 := by
        rw [Finset.card_insert_of_not_mem hxnot]
      _ = Fintype.card ι + 1 := by
        rw [Finset.card_image_of_injective _ hpick_inj]
        simp
      _ = n := by omega
  have hxpick : ∀ j : ι, ¬ G.Adj x (pick j) := by
    intro j
    by_cases hj : j = i
    · subst j
      simpa [pick] using hxb
    · exact hcompat j hj (pick j) (hpick_mem j)
  have hRind : G.IsIndepSet (R : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha c hc hac
    simp only [R, Finset.mem_insert, Finset.mem_image, Finset.mem_univ, true_and] at ha hc
    rcases ha with rfl | ⟨j, rfl⟩ <;> rcases hc with rfl | ⟨ℓ, rfl⟩
    · exact (hac rfl).elim
    · exact hxpick ℓ
    · exact (hxpick j) |>.symm
    · by_cases hjℓ : j = ℓ
      · subst ℓ
        exact (hac rfl).elim
      · exact hBanti j ℓ hjℓ (pick j) (hpick_mem j)
          (pick ℓ) (hpick_mem ℓ)
  exact hfree R ⟨hRind, hRcard⟩

/-- If `x` is adjacent to every vertex of a finite block, its degree into
that block is the block cardinality. -/
theorem degreeIn_eq_card_of_forall_adj
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (x : V) (hadj : ∀ b ∈ S, G.Adj x b) :
    degreeIn G S x = S.card := by
  unfold degreeIn
  have hfilter : S.filter (fun b => G.Adj x b) = S := by
    apply Finset.filter_true_of_mem
    intro b hb
    exact hadj b hb
  rw [hfilter]

/-- Degree form of independence-forced attachment.  With exactly `n-1`
anticomplete seed blocks, a compatible leftover vertex sees its entire
assigned block; if every block has order at least `k/2`, every leftover
vertex is neighbour-rich on the target scale. -/
theorem two_mul_degreeIn_assigned_block_ge_of_pred_seed_blocks
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hι : Fintype.card ι = n - 1)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ j, (B j).Nonempty)
    (hBdisj : ∀ j ℓ, j ≠ ℓ → Disjoint (B j) (B ℓ))
    (hBanti : ∀ j ℓ, j ≠ ℓ → ∀ a ∈ B j, ∀ b ∈ B ℓ, ¬ G.Adj a b)
    (hBL : ∀ j, Disjoint (B j) L)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hBlarge : ∀ j, k ≤ 2 * (B j).card) :
    ∀ v : L, k ≤ 2 * degreeIn G (B (assign v)) v.1 := by
  intro v
  have hadj : ∀ b ∈ B (assign v), G.Adj v.1 b := by
    apply adj_all_assigned_block_of_indepSetFree_of_pred_seed_blocks
      G B v.1 (assign v) hι hfree hBne hBdisj hBanti
    · intro j hvBj
      exact (Finset.disjoint_left.mp (hBL j)) hvBj v.2
    · intro j hj b hb
      exact hcompat v j hj b hb
  rw [degreeIn_eq_card_of_forall_adj G (B (assign v)) v.1 hadj]
  exact hBlarge (assign v)

/-- A compatible leftover smaller than half the target scale is empty once
every seed block is a dense `(k-1)`-block.  For a hypothetical leftover
vertex, compatibility and covering put every neighbour outside its assigned
block back in the leftover; the preceding external-degree lower bound then
forces at least `(k-1)/2` leftover vertices. -/
theorem leftover_eq_empty_of_small_compatible_leftover_and_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBL : ∀ i, Disjoint (B i) L)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hBcard : ∀ i, (B i).card = k - 1)
    (hBmin : ∀ i, k ≤ 2 * (G.induce (B i : Set V)).minDegree)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hLsmall : 2 * L.card < k - 1) :
    L = ∅ := by
  by_contra hLne
  obtain ⟨x, hxL⟩ := Finset.nonempty_iff_ne_empty.mpr hLne
  let xv : L := ⟨x, hxL⟩
  let i : ι := assign xv
  have hxB : x ∉ B i := by
    intro hxBi
    exact (Finset.disjoint_left.mp (hBL i)) hxBi hxL
  have hout : ∀ y : V, G.Adj x y → y ∉ B i → y ∈ L := by
    intro y hxy hyBi
    rcases hcover y with hyL | ⟨j, hyBj⟩
    · exact hyL
    · by_cases hji : j = i
      · subst j
        exact (hyBi hyBj).elim
      · exfalso
        apply hcompat xv j
        · simpa [i, xv] using hji
        · exact hyBj
        · exact hxy
  have hlower :=
    pred_le_two_mul_degreeIn_compl_of_cycleFree_dense_block
      G hk (hBcard i) hxB (hBmin i) hmin hcycle
  have hupper := degreeIn_compl_le_card_of_neighbors_outside_subset
    G (B i) L x hout
  omega

/-- Stable-partition endpoint for the preceding elimination lemma.  Once the
compatible leftover is empty, the already prepared seed blocks cover every
vertex and the empty-leftover specialization of the assignment theorem gives
the complete anticomplete partition. -/
theorem completeStablePartition_of_small_compatible_leftover_and_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hBcard : ∀ i, (B i).card = k - 1)
    (hBmin : ∀ i, k ≤ 2 * (G.induce (B i : Set V)).minDegree)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hLsmall : 2 * L.card < k - 1) :
    CompleteStablePartition G k := by
  have hLempty := leftover_eq_empty_of_small_compatible_leftover_and_dense_blocks
    G B L assign hk hBL hcover hcompat hBcard hBmin hmin hcycle hLsmall
  let assignAll : V → ι := fun _ => Classical.choice inferInstance
  apply completeStablePartition_of_seed_blocks_and_leftover_assignment
    G B L assignAll hBne hBdisj hBL hBanti hcover
  · intro v hv
    rw [hLempty] at hv
    simp at hv
  · intro u hu
    rw [hLempty] at hu
    simp at hu
  · intro i
    rw [hLempty]
    simpa [hBcard i]

/-- Separator-fed dense-block endpoint.  A no-cross-reachable remainder
already has the compatible component assignment constructed earlier; if that
remainder is below half the target scale and the seed blocks are exact dense
`(k-1)`-blocks, the small-leftover elimination theorem closes the stability
argument. -/
theorem completeStablePartition_of_separated_small_leftover_and_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False)
    (hBcard : ∀ i, (B i).card = k - 1)
    (hBmin : ∀ i, k ≤ 2 * (G.induce (B i : Set V)).minDegree)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hLsmall : 2 * L.card < k - 1) :
    CompleteStablePartition G k := by
  obtain ⟨assign, hcompat, _hLedge⟩ :=
    exists_compatible_assignment_of_leftover_separation_early G B L hseparate
  exact completeStablePartition_of_small_compatible_leftover_and_dense_blocks
    G B L assign hk hBne hBdisj hBL hBanti hcover hcompat hBcard hBmin
      hmin hcycle hLsmall

/-- Exact dense block predicate used by the completion/absorption stage.  A
block has the final target order `k-1` and enough induced minimum degree for
the one-vertex absorption contrapositive. -/
def IsExactDenseBlock
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) (k : ℕ) (S : Finset V) : Prop :=
  S.card = k - 1 ∧ k ≤ 2 * (G.induce (S : Set V)).minDegree

/-- Vertexwise doubled degree bounds imply the induced minimum-degree bound
needed for an exact dense block.  Divide by two using the ceiling
`(k+1)/2`, apply `le_minDegree_of_forall_le_degree`, then multiply back. -/
theorem isExactDenseBlock_of_forall_two_mul_degreeIn_ge
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {k : ℕ} (hcard : S.card = k - 1)
    (hdeg : ∀ v : S, k ≤ 2 * degreeIn G S v) :
    IsExactDenseBlock G k S := by
  classical
  let H : SimpleGraph S := G.induce (S : Set V)
  let d : ℕ := (k + 1) / 2
  have hd : ∀ v : S, d ≤ H.degree v := by
    intro v
    have hv := hdeg v
    rw [degree_induce_finset_eq_degreeIn G S v] at hv
    dsimp [d]
    omega
  have hmin : d ≤ H.minDegree := H.le_minDegree_of_forall_le_degree hd
  refine ⟨hcard, ?_⟩
  change k ≤ 2 * H.minDegree
  dsimp [d] at hmin
  omega

/-- Family form of the preceding conversion.  Once absorption has completed
each displayed block to order `k-1` and established the vertexwise doubled
degree estimate, all blocks satisfy the exact dense-block predicate used by
the separator-fed stability endpoint. -/
theorem isExactDenseBlock_family_of_forall_two_mul_degreeIn_ge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (B : ι → Finset V) {k : ℕ}
    (hcard : ∀ i, (B i).card = k - 1)
    (hdeg : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v) :
    ∀ i, IsExactDenseBlock G k (B i) := by
  intro i
  exact isExactDenseBlock_of_forall_two_mul_degreeIn_ge
    G (hcard i) (hdeg i)

/-- Completion by padding.  If an old block already has the vertexwise
doubled-degree bound, enlarging it can only increase those degrees; hence to
obtain an exact dense block it is enough to verify the same bound for the new
absorbed vertices and to hit cardinality `k-1`. -/
theorem isExactDenseBlock_of_union_completion
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S P : Finset V} {k : ℕ}
    (hcard : (S ∪ P).card = k - 1)
    (hold : ∀ v : S, k ≤ 2 * degreeIn G S v)
    (hnew : ∀ v : P, k ≤ 2 * degreeIn G (S ∪ P) v) :
    IsExactDenseBlock G k (S ∪ P) := by
  apply isExactDenseBlock_of_forall_two_mul_degreeIn_ge G hcard
  intro v
  simp only [Finset.mem_union] at v
  rcases v.property with hvS | hvP
  · have hv := hold ⟨v.1, hvS⟩
    have hmono := degreeIn_mono G Finset.subset_union_left v.1
    omega
  · exact hnew ⟨v.1, hvP⟩

/-- Exact finite padding selection.  A disjoint available reservoir with at
least the missing number of vertices contains a subfinset that completes the
old block to order `k-1`.  This isolates the purely cardinal part of the
later absorption construction from its degree estimates. -/
theorem exists_completion_finset_of_available_card
    {V : Type*} [Fintype V]
    (S A : Finset V) {k : ℕ}
    (hSA : Disjoint S A) (hS : S.card ≤ k - 1)
    (hA : (k - 1) - S.card ≤ A.card) :
    ∃ P : Finset V, P ⊆ A ∧ P.card = (k - 1) - S.card ∧
      (S ∪ P).card = k - 1 := by
  obtain ⟨P, hPA, hPcard⟩ := Finset.exists_subset_card_eq hA
  have hSP : Disjoint S P := hSA.mono Finset.Subset.rfl hPA
  refine ⟨P, hPA, hPcard, ?_⟩
  rw [Finset.card_union_of_disjoint hSP, hPcard]
  omega

/-- Fibrewise completion selection.  If every compatible assignment fibre
contains at least the number of vertices missing from its seed block, choose
those vertices independently in the disjoint fibres and take their union.
Filtering the union back by a label recovers exactly the chosen piece for
that label, so every enlarged block has order `k-1`. -/
theorem exists_fiberwise_completion_finset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (B : ι → Finset V) (L : Finset V) (assign : L → ι) {k : ℕ}
    (hBL : ∀ i, Disjoint (B i) L)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card) :
    ∃ P : Finset V, P ⊆ L ∧
      ∀ i : ι,
        (B i ∪ P.filter fun v => assign ⟨v, by assumption⟩ = i).card = k - 1 := by
  classical
  let fiber : ι → Finset V := fun i =>
    L.filter fun v => assign ⟨v, by assumption⟩ = i
  let Q : ι → Finset V := fun i =>
    Classical.choose
      (exists_completion_finset_of_available_card
        (B i) (fiber i)
        ((hBL i).mono Finset.Subset.rfl (Finset.filter_subset _ _))
        (hBcard i) (by simpa [fiber] using havail i))
  have hQ : ∀ i,
      Q i ⊆ fiber i ∧ Q i.card = (k - 1) - (B i).card ∧
        (B i ∪ Q i).card = k - 1 := by
    intro i
    exact Classical.choose_spec
      (exists_completion_finset_of_available_card
        (B i) (fiber i)
        ((hBL i).mono Finset.Subset.rfl (Finset.filter_subset _ _))
        (hBcard i) (by simpa [fiber] using havail i))
  let P : Finset V := (Finset.univ : Finset ι).biUnion Q
  have hPL : P ⊆ L := by
    intro v hv
    rcases Finset.mem_biUnion.mp hv with ⟨i, _hi, hvi⟩
    exact (Finset.mem_filter.mp ((hQ i).1 hvi)).1
  refine ⟨P, hPL, ?_⟩
  intro i
  have hfilter :
      P.filter (fun v => assign ⟨v, hPL (by assumption)⟩ = i) = Q i := by
    ext v
    constructor
    · intro hv
      rcases Finset.mem_filter.mp hv with ⟨hvP, hvi⟩
      rcases Finset.mem_biUnion.mp hvP with ⟨j, _hj, hvQj⟩
      have hvfiber : v ∈ fiber j := (hQ j).1 hvQj
      have hvj : assign ⟨v, (Finset.mem_filter.mp hvfiber).1⟩ = j :=
        (Finset.mem_filter.mp hvfiber).2
      have hji : j = i := by
        rw [← hvj, ← hvi]
      subst j
      exact hvQj
    · intro hvQ
      have hvfiber : v ∈ fiber i := (hQ i).1 hvQ
      have hvL : v ∈ L := (Finset.mem_filter.mp hvfiber).1
      apply Finset.mem_filter.mpr
      constructor
      · exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hvQ⟩
      · simpa using (Finset.mem_filter.mp hvfiber).2
  rw [hfilter]
  exact (hQ i).2.2

/-- Assignment fibres partition an absorbed subset.  Their union is the
whole subset and distinct labels give disjoint filters, so cardinality is the
sum of the fibre cardinalities. -/
theorem card_eq_sum_card_assignment_fibers
    {V ι : Type*} [Fintype V] [Fintype ι]
    (L P : Finset V) (assign : L → ι) (hPL : P ⊆ L) :
    P.card = ∑ i : ι,
      (P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card := by
  classical
  let Q : ι → Finset V := fun i =>
    P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i
  have hpair : ((Finset.univ : Finset ι) : Set ι).PairwiseDisjoint Q := by
    intro i _hi j _hj hij
    rw [Finset.disjoint_left]
    intro v hvi hvj
    have hvi' : assign ⟨v, hPL (Finset.mem_filter.mp hvi).1⟩ = i :=
      (Finset.mem_filter.mp hvi).2
    have hvj' : assign ⟨v, hPL (Finset.mem_filter.mp hvj).1⟩ = j :=
      (Finset.mem_filter.mp hvj).2
    apply hij
    rw [← hvi', ← hvj']
  have hunion : (Finset.univ : Finset ι).biUnion Q = P := by
    ext v
    constructor
    · intro hv
      rcases Finset.mem_biUnion.mp hv with ⟨i, _hi, hvi⟩
      exact (Finset.mem_filter.mp hvi).1
    · intro hvP
      let i : ι := assign ⟨v, hPL hvP⟩
      apply Finset.mem_biUnion.mpr
      refine ⟨i, Finset.mem_univ _, ?_⟩
      exact Finset.mem_filter.mpr ⟨hvP, rfl⟩
  calc
    P.card = ((Finset.univ : Finset ι).biUnion Q).card := by rw [hunion]
    _ = ∑ i in (Finset.univ : Finset ι), (Q i).card :=
      Finset.card_biUnion hpair
    _ = ∑ i : ι,
        (P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card := by
      simp [Q]

/-- If every partially absorbed fibre completes its block to order `k-1`,
then the total absorbed cardinality is the sum of the missing block sizes.
This is the numerical bridge used to turn completion data into a bound on
the residual leftover `L \ P`. -/
theorem card_eq_sum_missing_of_fiberwise_completion
    {V ι : Type*} [Fintype V] [Fintype ι]
    (B : ι → Finset V) (L P : Finset V) (assign : L → ι) {k : ℕ}
    (hBL : ∀ i, Disjoint (B i) L) (hPL : P ⊆ L)
    (hcomplete : ∀ i : ι,
      (B i ∪ P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card = k - 1) :
    P.card = ∑ i : ι, ((k - 1) - (B i).card) := by
  rw [card_eq_sum_card_assignment_fibers L P assign hPL]
  apply Finset.sum_congr rfl
  intro i _hi
  let Pi : Finset V :=
    P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i
  have hdis : Disjoint (B i) Pi := by
    exact (hBL i).mono Finset.Subset.rfl
      (Finset.filter_subset _ _ |>.trans hPL)
  have hcard := hcomplete i
  change (B i ∪ Pi).card = k - 1 at hcard
  rw [Finset.card_union_of_disjoint hdis] at hcard
  change Pi.card = (k - 1) - (B i).card
  omega

/-- Fibrewise completion with an explicit small-residual conclusion.  The
residual cardinality is `|L|` minus the sum of all missing block sizes, so a
single numerical inequality turns the selected completion into the
sub-half-scale remainder required by the dense-block endpoint. -/
theorem exists_fiberwise_completion_finset_with_small_residual
    {V ι : Type*} [Fintype V] [Fintype ι]
    (B : ι → Finset V) (L : Finset V) (assign : L → ι) {k : ℕ}
    (hBL : ∀ i, Disjoint (B i) L)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card)
    (hresidual :
      2 * (L.card - ∑ i : ι, ((k - 1) - (B i).card)) < k - 1) :
    ∃ P : Finset V, P ⊆ L ∧
      (∀ i : ι,
        (B i ∪ P.filter fun v => assign ⟨v, by assumption⟩ = i).card = k - 1) ∧
      2 * (L \ P).card < k - 1 := by
  obtain ⟨P, hPL, hcomplete⟩ :=
    exists_fiberwise_completion_finset B L assign hBL hBcard havail
  refine ⟨P, hPL, hcomplete, ?_⟩
  have hPcard :=
    card_eq_sum_missing_of_fiberwise_completion B L P assign hBL hPL hcomplete
  rw [Finset.card_sdiff_of_subset hPL, hPcard]
  exact hresidual

/-- Cardinality accounting for a disjoint seed-block cover plus leftover.
Pairwise-disjoint blocks have union cardinality equal to the sum of their
cardinalities; disjointness from the leftover and covering then identify that
sum plus `|L|` with the ambient order. -/
theorem card_eq_sum_card_add_leftover_of_disjoint_cover
    {V ι : Type*} [Fintype V] [Fintype ι]
    (B : ι → Finset V) (L : Finset V)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i) :
    Fintype.card V = (∑ i : ι, (B i).card) + L.card := by
  classical
  let U : Finset V := (Finset.univ : Finset ι).biUnion B
  have hpair : ((Finset.univ : Finset ι) : Set ι).PairwiseDisjoint B := by
    intro i _hi j _hj hij
    exact hBdisj i j hij
  have hUL : Disjoint U L := by
    rw [Finset.disjoint_left]
    intro v hvU hvL
    rcases Finset.mem_biUnion.mp hvU with ⟨i, _hi, hvi⟩
    exact (Finset.disjoint_left.mp (hBL i)) hvi hvL
  have hunion : U ∪ L = (Finset.univ : Finset V) := by
    ext v
    constructor
    · intro _hv
      exact Finset.mem_univ _
    · intro _hv
      rcases hcover v with hvL | ⟨i, hvi⟩
      · exact Finset.mem_union_right _ hvL
      · exact Finset.mem_union_left _
          (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hvi⟩)
  calc
    Fintype.card V = (U ∪ L).card := by rw [hunion]; simp
    _ = U.card + L.card := Finset.card_union_of_disjoint hUL
    _ = (∑ i : ι, (B i).card) + L.card := by
      rw [show U.card = ∑ i in (Finset.univ : Finset ι), (B i).card by
        exact Finset.card_biUnion hpair]

/-- Extremal-order deficit identity.  With exactly `n-1` disjoint blocks at
ambient order `(k-1)(n-1)+1`, the sum of all missing capacities is precisely
one less than the leftover order.  This is the global counting source behind
the fibrewise completion step. -/
theorem sum_missing_eq_leftover_pred_at_extremal_order
    {V ι : Type*} [Fintype V] [Fintype ι]
    (B : ι → Finset V) (L : Finset V) {k n : ℕ}
    (hι : Fintype.card ι = n - 1)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hpartition : Fintype.card V = (∑ i : ι, (B i).card) + L.card)
    (hBcard : ∀ i, (B i).card ≤ k - 1) :
    ∑ i : ι, ((k - 1) - (B i).card) = L.card - 1 := by
  have hsum :
      (∑ i : ι, ((k - 1) - (B i).card)) +
          (∑ i : ι, (B i).card) = (n - 1) * (k - 1) := by
    calc
      (∑ i : ι, ((k - 1) - (B i).card)) +
          (∑ i : ι, (B i).card) =
          ∑ i : ι, (((k - 1) - (B i).card) + (B i).card) := by
            rw [Finset.sum_add_distrib]
      _ = ∑ _i : ι, (k - 1) := by
        apply Finset.sum_congr rfl
        intro i _hi
        exact Nat.sub_add_cancel (hBcard i)
      _ = Fintype.card ι * (k - 1) := by simp
      _ = (n - 1) * (k - 1) := by rw [hι]
  have horder' : Fintype.card V = (n - 1) * (k - 1) + 1 := by
    simpa [Nat.mul_comm] using horder
  omega

/-- At extremal order, filling every block deficit leaves at most one
leftover vertex.  Consequently the residual inequality required by the
fibrewise completion theorem is automatic once `k ≥ 4`. -/
theorem two_mul_residual_lt_of_extremal_deficit
    {V ι : Type*} [Fintype V] [Fintype ι]
    (B : ι → Finset V) (L : Finset V) {k n : ℕ} (hk : 4 ≤ k)
    (hι : Fintype.card ι = n - 1)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hpartition : Fintype.card V = (∑ i : ι, (B i).card) + L.card)
    (hBcard : ∀ i, (B i).card ≤ k - 1) :
    2 * (L.card - ∑ i : ι, ((k - 1) - (B i).card)) < k - 1 := by
  have hmissing := sum_missing_eq_leftover_pred_at_extremal_order
    B L hι horder hpartition hBcard
  omega

/-- Partial absorption into assigned seed fibres.  Absorb a chosen subset
`P` of a compatible leftover into the seed block selected by `assign`, keep
the residual `L \ P`, and then apply the dense-block small-remainder endpoint.
All structural properties of the enlarged blocks are proved here from the
original compatibility and edge-consistency assumptions; the only remaining
inputs are that completion reached exact dense blocks and left a sub-half-
scale residual. -/
theorem completeStablePartition_of_partial_absorption_to_exact_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L P : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hPL : P ⊆ L)
    (hCcard : ∀ i : ι,
      (B i ∪ P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card = k - 1)
    (hCmin : ∀ i : ι, k ≤ 2 *
      (G.induce ((B i ∪ P.filter fun v =>
        assign ⟨v, hPL (by assumption)⟩ = i) : Set V)).minDegree)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hRsmall : 2 * (L \ P).card < k - 1) :
    CompleteStablePartition G k := by
  classical
  let C : ι → Finset V := fun i =>
    B i ∪ P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i
  let R : Finset V := L \ P
  let assignR : R → ι := fun v => assign ⟨v.1, (Finset.mem_sdiff.mp v.2).1⟩
  apply completeStablePartition_of_small_compatible_leftover_and_dense_blocks
    G C R assignR hk
  · intro i
    exact (hBne i).mono Finset.subset_union_left
  · intro i j hij
    rw [Finset.disjoint_left]
    intro v hvi hvj
    simp only [C, Finset.mem_union, Finset.mem_filter] at hvi hvj
    rcases hvi with hvi | ⟨hvP, hvi⟩ <;>
      rcases hvj with hvj | ⟨hvP', hvj⟩
    · exact (Finset.disjoint_left.mp (hBdisj i j hij)) hvi hvj
    · exact (Finset.disjoint_left.mp (hBL i)) hvi (hPL hvP')
    · exact (Finset.disjoint_left.mp (hBL j)) hvj (hPL hvP)
    · apply hij
      rw [← hvi, ← hvj]
  · intro i
    rw [Finset.disjoint_left]
    intro v hvC hvR
    simp only [C, Finset.mem_union, Finset.mem_filter] at hvC
    rcases hvC with hvB | ⟨hvP, _hvassign⟩
    · exact (Finset.disjoint_left.mp (hBL i)) hvB (Finset.mem_sdiff.mp hvR).1
    · exact (Finset.mem_sdiff.mp hvR).2 hvP
  · intro i j hij a ha b hb hab
    simp only [C, Finset.mem_union, Finset.mem_filter] at ha hb
    rcases ha with haB | ⟨haP, hai⟩ <;>
      rcases hb with hbB | ⟨hbP, hbj⟩
    · exact hBanti i j hij a haB b hbB hab
    · have hine : i ≠ assign ⟨b, hPL hbP⟩ := by
        simpa [hbj] using hij
      exact (hcompat ⟨b, hPL hbP⟩ i hine a haB) hab.symm
    · have hjne : j ≠ assign ⟨a, hPL haP⟩ := by
        intro h
        apply hij
        rw [← hai, ← h]
      exact hcompat ⟨a, hPL haP⟩ j hjne b hbB hab
    · have heq := hLedge ⟨a, hPL haP⟩ ⟨b, hPL hbP⟩ hab
      apply hij
      rw [← hai, ← hbj, heq]
  · intro v
    rcases hcover v with hvL | ⟨i, hvi⟩
    · by_cases hvP : v ∈ P
      · right
        refine ⟨assign ⟨v, hvL⟩, ?_⟩
        apply Finset.mem_union_right
        exact Finset.mem_filter.mpr ⟨hvP, rfl⟩
      · left
        exact Finset.mem_sdiff.mpr ⟨hvL, hvP⟩
    · right
      exact ⟨i, Finset.mem_union_left _ hvi⟩
  · intro v j hj b hb
    have hvL : v.1 ∈ L := (Finset.mem_sdiff.mp v.2).1
    simp only [C, Finset.mem_union, Finset.mem_filter] at hb
    rcases hb with hbB | ⟨hbP, hbj⟩
    · have hj' : j ≠ assign ⟨v.1, hvL⟩ := by
        simpa [assignR] using hj
      exact hcompat ⟨v.1, hvL⟩ j hj' b hbB
    · intro hvb
      have heq := hLedge ⟨v.1, hvL⟩ ⟨b, hPL hbP⟩ hvb
      apply hj
      change j = assign ⟨v.1, hvL⟩
      rw [← hbj, ← heq]
  · intro i
    simpa [C] using hCcard i
  · intro i
    simpa [C] using hCmin i
  · exact hmin
  · exact hcycle
  · simpa [R] using hRsmall

/-- Vertexwise completion wrapper for partial absorption.  Instead of asking
directly for induced minimum-degree bounds on the completed blocks, it is
enough to know the old block degree bound and the corresponding bound for
every newly absorbed vertex; `isExactDenseBlock_of_union_completion` supplies
the exact dense-block hypotheses consumed by the preceding theorem. -/
theorem completeStablePartition_of_partial_absorption_with_vertexwise_completion
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L P : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hPL : P ⊆ L)
    (hCcard : ∀ i : ι,
      (B i ∪ P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card = k - 1)
    (hold : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v)
    (hnew : ∀ i, ∀ v : P.filter fun w =>
      assign ⟨w, hPL (by assumption)⟩ = i,
      k ≤ 2 * degreeIn G
        (B i ∪ P.filter fun w => assign ⟨w, hPL (by assumption)⟩ = i) v)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hRsmall : 2 * (L \ P).card < k - 1) :
    CompleteStablePartition G k := by
  apply completeStablePartition_of_partial_absorption_to_exact_dense_blocks
    G B L P assign hk hBne hBdisj hBL hBanti hcover hcompat hLedge hPL hCcard
  · intro i
    have hdense := isExactDenseBlock_of_union_completion G (hCcard i)
      (hold i) (hnew i)
    exact hdense.2
  · exact hmin
  · exact hcycle
  · exact hRsmall

/-- Fibrewise absorption completion interface.  Availability and one residual
inequality choose a completion set automatically; the remaining genuinely
graph-theoretic input is the vertexwise doubled-degree estimate for the newly
absorbed vertices selected in each fibre.  Once that estimate is supplied,
the previously checked partial-absorption theorem yields the complete stable
partition. -/
theorem completeStablePartition_of_fiberwise_absorption_with_vertexwise_degree
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card)
    (hresidual :
      2 * (L.card - ∑ i : ι, ((k - 1) - (B i).card)) < k - 1)
    (hold : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v)
    (hnew : ∀ P : Finset V, ∀ hPL : P ⊆ L,
      (∀ i : ι,
        (B i ∪ P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card = k - 1) →
      ∀ i, ∀ v : P.filter fun w => assign ⟨w, hPL (by assumption)⟩ = i,
        k ≤ 2 * degreeIn G
          (B i ∪ P.filter fun w => assign ⟨w, hPL (by assumption)⟩ = i) v)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  obtain ⟨P, hPL, hcomplete, hRsmall⟩ :=
    exists_fiberwise_completion_finset_with_small_residual
      B L assign hBL hBcard havail hresidual
  apply completeStablePartition_of_partial_absorption_with_vertexwise_completion
    G B L P assign hk hBne hBdisj hBL hBanti hcover hcompat hLedge hPL
    hcomplete hold
  · exact hnew P hPL hcomplete
  · exact hmin
  · exact hcycle
  · exact hRsmall

/-- Extremal-order fibrewise absorption interface.  When the seed index set
has exactly `n-1` labels and the ambient order is the Ramsey extremal order,
the block/leftover cover makes the residual inequality automatic by the
preceding deficit identity.  Thus the remaining absorption inputs are fibre
availability and the vertexwise degree estimate for selected new vertices. -/
theorem completeStablePartition_of_extremal_fiberwise_absorption_with_vertexwise_degree
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 4 ≤ k)
    (hι : Fintype.card ι = n - 1)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card)
    (hold : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v)
    (hnew : ∀ P : Finset V, ∀ hPL : P ⊆ L,
      (∀ i : ι,
        (B i ∪ P.filter fun v => assign ⟨v, hPL (by assumption)⟩ = i).card = k - 1) →
      ∀ i, ∀ v : P.filter fun w => assign ⟨w, hPL (by assumption)⟩ = i,
        k ≤ 2 * degreeIn G
          (B i ∪ P.filter fun w => assign ⟨w, hPL (by assumption)⟩ = i) v)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  have hpartition := card_eq_sum_card_add_leftover_of_disjoint_cover
    B L hBdisj hBL hcover
  have hresidual := two_mul_residual_lt_of_extremal_deficit
    B L hk hι horder hpartition hBcard
  apply completeStablePartition_of_fiberwise_absorption_with_vertexwise_degree
    G B L assign (by omega) hBne hBdisj hBL hBanti hcover hcompat hLedge
      hBcard havail hresidual hold hnew hmin hcycle

/-- Extremal fibrewise absorption with no separate new-vertex degree input.
After all deficits are filled, the extremal deficit identity leaves at most
one residual vertex.  Compatibility and leftover edge-consistency put every
neighbour of an absorbed vertex, except possibly that one residual vertex,
inside its completed block.  Minimum degree therefore gives the required
vertexwise doubled-degree bound automatically for `k ≥ 4`. -/
theorem completeStablePartition_of_extremal_fiberwise_absorption
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 4 ≤ k)
    (hι : Fintype.card ι = n - 1)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card)
    (hold : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  have hpartition := card_eq_sum_card_add_leftover_of_disjoint_cover
    B L hBdisj hBL hcover
  apply completeStablePartition_of_extremal_fiberwise_absorption_with_vertexwise_degree
    G B L assign hk hι horder hBne hBdisj hBL hBanti hcover hcompat hLedge
      hBcard havail hold
  · intro P hPL hcomplete i v
    let C : Finset V :=
      B i ∪ P.filter fun w => assign ⟨w, hPL (by assumption)⟩ = i
    let R : Finset V := L \ P
    have hvP : v.1 ∈ P := (Finset.mem_filter.mp v.2).1
    have hvL : v.1 ∈ L := hPL hvP
    have hvi : assign ⟨v.1, hvL⟩ = i := by
      simpa using (Finset.mem_filter.mp v.2).2
    have hPcard :=
      card_eq_sum_missing_of_fiberwise_completion B L P assign hBL hPL hcomplete
    have hmissing := sum_missing_eq_leftover_pred_at_extremal_order
      B L hι horder hpartition hBcard
    have hRcard : R.card ≤ 1 := by
      rw [show R.card = L.card - P.card by
        dsimp [R]; exact Finset.card_sdiff_of_subset hPL]
      rw [hPcard, hmissing]
      omega
    have hout : ∀ y : V, G.Adj v.1 y → y ∉ C → y ∈ R := by
      intro y hvy hyC
      rcases hcover y with hyL | ⟨j, hyBj⟩
      · by_cases hyP : y ∈ P
        · have heq := hLedge ⟨v.1, hvL⟩ ⟨y, hyL⟩ hvy
          have hyi : assign ⟨y, hyL⟩ = i := heq.symm.trans hvi
          apply (hyC ?_).elim
          exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hyP, hyi⟩)
        · exact Finset.mem_sdiff.mpr ⟨hyL, hyP⟩
      · by_cases hji : j = i
        · subst j
          exact (hyC (Finset.mem_union_left _ hyBj)).elim
        · exfalso
          have hjlabel : j ≠ assign ⟨v.1, hvL⟩ := by
            intro h
            exact hji (h.trans hvi)
          exact (hcompat ⟨v.1, hvL⟩ j hjlabel y hyBj) hvy
    have houtside := degreeIn_compl_le_card_of_neighbors_outside_subset
      G C R v.1 hout
    have hsplit := degreeIn_add_degreeIn_compl_eq_degree G C v.1
    have hdeg : k - 1 ≤ G.degree v.1 :=
      hmin.trans (G.minDegree_le_degree v.1)
    change k ≤ 2 * degreeIn G C v.1
    omega
  · exact hmin
  · exact hcycle

/-- No compatible fibre can contain more vertices than its block deficit in
a `Cₖ`-free near-dense configuration.  If it did, complete that one block
using exactly its deficit.  Independence forces every fibre vertex to be
adjacent to the whole old block, so the selected completion is an exact dense
block and one extra fibre vertex has doubled degree at least `k` into it,
contradicting the one-vertex absorption contrapositive. -/
theorem fiber_card_le_missing_of_cycleFree_near_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 4 ≤ k)
    (hι : Fintype.card ι = n - 1)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ j, (B j).Nonempty)
    (hBdisj : ∀ j ℓ, j ≠ ℓ → Disjoint (B j) (B ℓ))
    (hBanti : ∀ j ℓ, j ≠ ℓ → ∀ a ∈ B j, ∀ b ∈ B ℓ, ¬ G.Adj a b)
    (hBL : ∀ j, Disjoint (B j) L)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hBcard : ∀ j, (B j).card ≤ k - 1)
    (hBlarge : ∀ j, k ≤ 2 * (B j).card)
    (hold : ∀ j, ∀ v : B j, k ≤ 2 * degreeIn G (B j) v)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∀ i : ι,
      (L.filter fun v => assign ⟨v, by assumption⟩ = i).card ≤
        (k - 1) - (B i).card := by
  classical
  intro i
  let fiber : Finset V := L.filter fun v => assign ⟨v, by assumption⟩ = i
  by_contra hnot
  have hlt : (k - 1) - (B i).card < fiber.card := by
    simpa [fiber] using (Nat.lt_of_not_ge hnot)
  have hBfiber : Disjoint (B i) fiber :=
    (hBL i).mono Finset.Subset.rfl (Finset.filter_subset _ _)
  obtain ⟨P, hPfiber, hPcard, hCcard⟩ :=
    exists_completion_finset_of_available_card
      (B i) fiber hBfiber (hBcard i) hlt.le
  have hPL : P ⊆ L := hPfiber.trans (Finset.filter_subset _ _)
  let C : Finset V := B i ∪ P
  have hadj_old : ∀ v : L, assign v = i → ∀ b ∈ B i, G.Adj v.1 b := by
    intro v hvi
    have hadj := adj_all_assigned_block_of_indepSetFree_of_pred_seed_blocks
      G B v.1 i hι hfree hBne hBdisj hBanti
      (fun j hvBj => (Finset.disjoint_left.mp (hBL j)) hvBj v.2)
      (fun j hj b hb => by
        apply hcompat v j
        · simpa [hvi] using hj
        · exact hb)
    exact hadj
  have hnew : ∀ v : P, k ≤ 2 * degreeIn G C v.1 := by
    intro v
    have hvfiber : v.1 ∈ fiber := hPfiber v.2
    have hvL : v.1 ∈ L := (Finset.mem_filter.mp hvfiber).1
    have hvi : assign ⟨v.1, hvL⟩ = i := (Finset.mem_filter.mp hvfiber).2
    have hadj := hadj_old ⟨v.1, hvL⟩ hvi
    have hdegB : degreeIn G (B i) v.1 = (B i).card :=
      degreeIn_eq_card_of_forall_adj G (B i) v.1 hadj
    have hmono := degreeIn_mono G Finset.subset_union_left v.1
    dsimp [C]
    rw [hdegB] at hmono
    have := hBlarge i
    omega
  have hCdense : IsExactDenseBlock G k C := by
    apply isExactDenseBlock_of_union_completion G (by simpa [C] using hCcard)
    · exact hold i
    · simpa [C] using hnew
  obtain ⟨x, hxFiber, hxP⟩ :=
    Finset.exists_mem_notMem_of_card_lt_card hlt
  have hxL : x ∈ L := (Finset.mem_filter.mp hxFiber).1
  have hxi : assign ⟨x, hxL⟩ = i := (Finset.mem_filter.mp hxFiber).2
  have hxC : x ∉ C := by
    intro hxC
    rcases Finset.mem_union.mp hxC with hxB | hxP'
    · exact (Finset.disjoint_left.mp (hBL i)) hxB hxL
    · exact hxP hxP'
  have hxadj := hadj_old ⟨x, hxL⟩ hxi
  have hxdegB : degreeIn G (B i) x = (B i).card :=
    degreeIn_eq_card_of_forall_adj G (B i) x hxadj
  have hxmono := degreeIn_mono G Finset.subset_union_left x
  have hxlarge : k ≤ 2 * degreeIn G C x := by
    dsimp [C]
    rw [hxdegB] at hxmono
    have := hBlarge i
    omega
  have hxsmall := two_mul_degreeIn_lt_of_cycleFree_dense_block
    G (by omega) hCdense.1 hxC hCdense.2 hcycle
  exact (not_lt_of_ge hxlarge) hxsmall

/-- Extremal near-dense stability closes without any leftover.  The previous
lemma bounds every compatible fibre by its block deficit.  Summing those
bounds gives `|L| ≤` total deficit, while extremal-order accounting says the
total deficit is `|L|-1`; hence `L` is empty.  The original anticomplete
blocks then already give `CompleteStablePartition`. -/
theorem completeStablePartition_of_extremal_near_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 4 ≤ k)
    (hι : Fintype.card ι = n - 1)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ j, (B j).Nonempty)
    (hBdisj : ∀ j ℓ, j ≠ ℓ → Disjoint (B j) (B ℓ))
    (hBanti : ∀ j ℓ, j ≠ ℓ → ∀ a ∈ B j, ∀ b ∈ B ℓ, ¬ G.Adj a b)
    (hBL : ∀ j, Disjoint (B j) L)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hBcard : ∀ j, (B j).card ≤ k - 1)
    (hBlarge : ∀ j, k ≤ 2 * (B j).card)
    (hold : ∀ j, ∀ v : B j, k ≤ 2 * degreeIn G (B j) v)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  have hfiber : ∀ i : ι,
      (L.filter fun v => assign ⟨v, by assumption⟩ = i).card ≤
        (k - 1) - (B i).card :=
    fiber_card_le_missing_of_cycleFree_near_dense_blocks
      G B L assign hk hι hfree hBne hBdisj hBanti hBL hcompat hBcard
        hBlarge hold hcycle
  have hpartition := card_eq_sum_card_add_leftover_of_disjoint_cover
    B L hBdisj hBL hcover
  have hmissing := sum_missing_eq_leftover_pred_at_extremal_order
    B L hι horder hpartition hBcard
  have hfibersum :
      L.card = ∑ i : ι,
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card := by
    simpa using (card_eq_sum_card_assignment_fibers L L assign Finset.Subset.rfl)
  have hsumle :
      (∑ i : ι,
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card) ≤
      ∑ i : ι, ((k - 1) - (B i).card) := by
    exact Finset.sum_le_sum fun i _hi => hfiber i
  rw [← hfibersum, hmissing] at hsumle
  have hLcard : L.card = 0 := by omega
  have hLempty : L = ∅ := Finset.card_eq_zero.mp hLcard
  let assignAll : V → ι := fun _ => Classical.choice inferInstance
  apply completeStablePartition_of_seed_blocks_and_leftover_assignment
    G B L assignAll hBne hBdisj hBL hBanti hcover
  · intro v hv
    rw [hLempty] at hv
    simp at hv
  · intro u hu
    rw [hLempty] at hu
    simp at hu
  · intro i
    rw [hLempty]
    simpa using hBcard i

/-- Nonempty pairwise-disjoint anticomplete indexed blocks are fewer than
`n` in an `n`-independent-set-free graph.  Choose one representative from
each block; disjointness makes the representative map injective and
anticompleteness makes its image independent. -/
theorem card_index_lt_of_nonempty_disjoint_pairwiseAnticomplete
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ}
    (B : ι → Finset V)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b) :
    Fintype.card ι < n := by
  classical
  let pick : ι → V := fun i => (hBne i).choose
  have hpick : ∀ i, pick i ∈ B i := by
    intro i
    exact (hBne i).choose_spec
  have hpick_inj : Function.Injective pick := by
    intro i j hij
    by_contra hne
    exact (Finset.disjoint_left.mp (hBdisj i j hne))
      (hpick i) (hij ▸ hpick j)
  let R : Finset V := (Finset.univ : Finset ι).image pick
  have hRcard : R.card = Fintype.card ι := by
    calc
      R.card = (Finset.univ : Finset ι).card := by
        rw [Finset.card_image_of_injective _ hpick_inj]
      _ = Fintype.card ι := by simp
  have hRind : G.IsIndepSet (R : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_image.mp ha with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨j, _hj, rfl⟩
    by_cases hij : i = j
    · subst j
      exact (hab rfl).elim
    · exact hBanti i j hij (pick i) (hpick i) (pick j) (hpick j)
  rw [← hRcard]
  exact Erdos551.IndepSetFree.card_lt hfree hRind

/-- At extremal order, a leftover smaller than one block forces exactly
`n-1` nonempty anticomplete blocks.  Independence gives fewer than `n`
blocks.  If there were at most `n-2`, the block capacity plus the strict
leftover bound could not cover `(k-1)(n-1)+1` vertices. -/
theorem card_index_eq_pred_of_extremal_small_leftover
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n k : ℕ}
    (B : ι → Finset V) (L : Finset V)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hBL : ∀ i, Disjoint (B i) L)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (hLsmall : L.card < k - 1) :
    Fintype.card ι = n - 1 := by
  have hupper : Fintype.card ι < n :=
    card_index_lt_of_nonempty_disjoint_pairwiseAnticomplete
      G B hfree hBne hBdisj hBanti
  have hcount := card_eq_sum_card_add_leftover_of_disjoint_cover
    B L hBdisj hBL hcover
  have hsumle : (∑ i : ι, (B i).card) ≤ Fintype.card ι * (k - 1) := by
    calc
      (∑ i : ι, (B i).card) ≤ ∑ _i : ι, (k - 1) := by
        exact Finset.sum_le_sum fun i _hi => hBcard i
      _ = Fintype.card ι * (k - 1) := by simp
  by_contra hne
  have hlow : Fintype.card ι ≤ n - 2 := by omega
  have htotal : Fintype.card V < (n - 1) * (k - 1) + 1 := by
    calc
      Fintype.card V = (∑ i : ι, (B i).card) + L.card := hcount
      _ ≤ Fintype.card ι * (k - 1) + L.card :=
        Nat.add_le_add_right hsumle _
      _ ≤ (n - 2) * (k - 1) + L.card := by
        exact Nat.add_le_add_right (Nat.mul_le_mul_right _ hlow) _
      _ < (n - 1) * (k - 1) + 1 := by omega
  have horder' : Fintype.card V = (n - 1) * (k - 1) + 1 := by
    simpa [Nat.mul_comm] using horder
  omega

/-- Small-leftover near-dense stability endpoint without a supplied block
count.  The preceding extremal count first identifies the number of blocks
with `n-1`; the checked no-surplus theorem then removes the leftover and
returns the complete stable partition. -/
theorem completeStablePartition_of_extremal_small_leftover_near_dense_blocks
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 4 ≤ k)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hBne : ∀ j, (B j).Nonempty)
    (hBdisj : ∀ j ℓ, j ≠ ℓ → Disjoint (B j) (B ℓ))
    (hBanti : ∀ j ℓ, j ≠ ℓ → ∀ a ∈ B j, ∀ b ∈ B ℓ, ¬ G.Adj a b)
    (hBL : ∀ j, Disjoint (B j) L)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hBcard : ∀ j, (B j).card ≤ k - 1)
    (hBlarge : ∀ j, k ≤ 2 * (B j).card)
    (hold : ∀ j, ∀ v : B j, k ≤ 2 * degreeIn G (B j) v)
    (hLsmall : L.card < k - 1)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  have hι := card_index_eq_pred_of_extremal_small_leftover
    G B L horder hfree hBne hBdisj hBanti hBL hcover hBcard hLsmall
  exact completeStablePartition_of_extremal_near_dense_blocks
    G B L assign hk hι horder hfree hBne hBdisj hBanti hBL hcover hcompat
      hBcard hBlarge hold hcycle

/-- Neighbour-rich-fibre specialization.  If every leftover vertex has
doubled degree at least `k` already into its assigned old block, then any
selected fibrewise completion automatically satisfies the new-vertex degree
condition by monotonicity of `degreeIn`.  This is the cleanest final target
for the KLS absorbable-neighbour construction. -/
theorem completeStablePartition_of_neighbor_rich_fiberwise_absorption
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card)
    (hresidual :
      2 * (L.card - ∑ i : ι, ((k - 1) - (B i).card)) < k - 1)
    (hold : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v)
    (hfiberdeg : ∀ v : L,
      k ≤ 2 * degreeIn G (B (assign v)) v.1)
    (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  apply completeStablePartition_of_fiberwise_absorption_with_vertexwise_degree
    G B L assign hk hBne hBdisj hBL hBanti hcover hcompat hLedge hBcard
      havail hresidual hold
  · intro P hPL hcomplete i v
    have hvfiber : assign ⟨v.1, hPL (Finset.mem_filter.mp v.2).1⟩ = i :=
      (Finset.mem_filter.mp v.2).2
    have hv := hfiberdeg ⟨v.1, hPL (Finset.mem_filter.mp v.2).1⟩
    rw [hvfiber] at hv
    have hmono := degreeIn_mono G Finset.subset_union_left v.1
    omega
  · exact hmin
  · exact hcycle

/-- Small-compatible-leftover fibrewise absorption.  When the entire
leftover is already below half-scale, the residual inequality is automatic,
and minimum degree plus compatibility supplies the neighbour-rich property
for every assigned leftover vertex.  Thus availability of enough vertices in
each assignment fibre is the only remaining completion input. -/
theorem completeStablePartition_of_small_compatible_fiberwise_absorption
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : L → ι)
    (hk : 3 ≤ k)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v : L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v)
    (hBcard : ∀ i, (B i).card ≤ k - 1)
    (havail : ∀ i,
      (k - 1) - (B i).card ≤
        (L.filter fun v => assign ⟨v, by assumption⟩ = i).card)
    (hold : ∀ i, ∀ v : B i, k ≤ 2 * degreeIn G (B i) v)
    (hmin : k - 1 ≤ G.minDegree)
    (hLsmall : 2 * L.card ≤ k - 2)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CompleteStablePartition G k := by
  apply completeStablePartition_of_neighbor_rich_fiberwise_absorption
    G B L assign hk hBne hBdisj hBL hBanti hcover hcompat hLedge hBcard
      havail
  · have hsum_nonneg : 0 ≤ ∑ i : ι, ((k - 1) - (B i).card) := Nat.zero_le _
    omega
  · exact hold
  · exact two_mul_degreeIn_assigned_block_ge_of_small_compatible_leftover
      G B L assign hcover hcompat hmin hLsmall
  · exact hmin
  · exact hcycle

-/
/-! ## Turán density input -/

/-- Convenient loose form of Turán's theorem: an `(r+1)`-clique-free graph
has at most the usual quadratic edge density.  Mathlib supplies the exact
Turán extremal graph and its exact edge count; this is the single inequality
needed by the KLS dense-extraction estimates. -/
theorem cliqueFree_twice_mul_card_edgeFinset_le
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {r : ℕ} (hr : 0 < r) (hfree : G.CliqueFree (r + 1)) :
    2 * r * G.edgeFinset.card ≤ (r - 1) * (Fintype.card V) ^ 2 := by
  have hle : G.edgeFinset.card ≤
      (SimpleGraph.turanGraph (Fintype.card V) r).edgeFinset.card := by
    simpa [SimpleGraph.card_edgeFinset_turanGraph] using
      (SimpleGraph.CliqueFree.card_edgeFinset_le (G := G) (r := r) hfree)
  exact (Nat.mul_le_mul_left (2 * r) hle).trans
    (SimpleGraph.mul_card_edgeFinset_turanGraph_le
      (n := Fintype.card V) (r := r))

/-- A graph and its complement partition all unordered pairs of distinct
vertices. -/
theorem card_edgeFinset_add_card_edgeFinset_compl
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] :
    G.edgeFinset.card + Gᶜ.edgeFinset.card = (Fintype.card V).choose 2 := by
  classical
  have hdisj : Disjoint G.edgeFinset Gᶜ.edgeFinset := by
    rw [SimpleGraph.disjoint_edgeFinset]
    exact disjoint_compl_right
  have hunion : G.edgeFinset ∪ Gᶜ.edgeFinset = (⊤ : SimpleGraph V).edgeFinset := by
    have hset : G.edgeSet ∪ Gᶜ.edgeSet = (⊤ : SimpleGraph V).edgeSet := by
      rw [← SimpleGraph.edgeSet_sup, sup_compl_eq_top]
    ext e
    simpa [SimpleGraph.mem_edgeFinset] using Set.ext_iff.mp hset e
  calc
    G.edgeFinset.card + Gᶜ.edgeFinset.card = (G.edgeFinset ∪ Gᶜ.edgeFinset).card :=
      (Finset.card_union_of_disjoint hdisj).symm
    _ = (⊤ : SimpleGraph V).edgeFinset.card := by rw [hunion]
    _ = (Fintype.card V).choose 2 := SimpleGraph.card_edgeFinset_top_eq_card_choose_two

/-- Independence-number input in the arithmetic form used for dense
extraction.  It is just Turán applied to the complement, with the complement
edge count eliminated by the preceding partition identity. -/
theorem edge_lower_bound_of_indepSetFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {n : ℕ} (hn : 2 ≤ n) (hfree : G.IndepSetFree n) :
    (n - 1) * Fintype.card V * (Fintype.card V - 1) ≤
      2 * (n - 1) * G.edgeFinset.card + (n - 2) * (Fintype.card V) ^ 2 := by
  have hcompl : Gᶜ.CliqueFree ((n - 1) + 1) := by
    simpa only [Nat.sub_add_cancel (by omega : 1 ≤ n),
      SimpleGraph.cliqueFree_compl] using hfree
  have hTuran := cliqueFree_twice_mul_card_edgeFinset_le Gᶜ
    (r := n - 1) (by omega) hcompl
  have hpartition := card_edgeFinset_add_card_edgeFinset_compl G
  have hchoose : 2 * (Fintype.card V).choose 2 =
      Fintype.card V * (Fintype.card V - 1) := by
    rw [Nat.choose_two_right]
    rw [Nat.mul_comm]
    exact Nat.div_mul_cancel (Nat.even_mul_pred_self _).two_dvd
  rw [show n - 1 - 1 = n - 2 by omega] at hTuran
  calc
    (n - 1) * Fintype.card V * (Fintype.card V - 1) =
        (n - 1) * (2 * (Fintype.card V).choose 2) := by rw [hchoose]; ring
    _ = 2 * (n - 1) *
        (G.edgeFinset.card + Gᶜ.edgeFinset.card) := by rw [hpartition]; ring
    _ = 2 * (n - 1) * G.edgeFinset.card +
        2 * (n - 1) * Gᶜ.edgeFinset.card := by ring
    _ ≤ 2 * (n - 1) * G.edgeFinset.card +
        (n - 2) * (Fintype.card V) ^ 2 := by
          exact Nat.add_le_add_left hTuran _

/-- Independence-set-freeness is inherited by induced subgraphs. -/
theorem IndepSetFree.induce
    {V : Type*} [Fintype V] {G : SimpleGraph V} {n : ℕ}
    (hfree : G.IndepSetFree n) (S : Finset V) :
    (G.induce (S : Set V)).IndepSetFree n := by
  exact SimpleGraph.IndepSetFree.comap
    (SimpleGraph.Embedding.induce (G := G) (S : Set V)) hfree

/-- A coarse but clean corollary of the Turán estimate: once the vertex set
has room for `(n-1)(d+1)` vertices, an `n`-independent-set-free graph has
average degree at least `d`. -/
theorem avg_degree_ge_of_indepSetFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {n d : ℕ} (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : (n - 1) * (d + 1) ≤ Fintype.card V) :
    d * Fintype.card V ≤ 2 * G.edgeFinset.card := by
  have hedge := edge_lower_bound_of_indepSetFree G hn hfree
  have hnsub : n - 2 + 1 = n - 1 := by omega
  have hmpos : 0 < Fintype.card V := by
    have : 0 < n - 1 := by omega
    nlinarith
  have hmsub : Fintype.card V - 1 + 1 = Fintype.card V := by omega
  have hsizeMul := Nat.mul_le_mul_right (Fintype.card V) hsize
  have hsmall : (n - 1) * d * Fintype.card V +
      (n - 1) * Fintype.card V ≤ (Fintype.card V) ^ 2 := by
    nlinarith
  have hnpoly : (n - 2) * (Fintype.card V) ^ 2 + (Fintype.card V) ^ 2 =
      (n - 1) * (Fintype.card V) ^ 2 := by
    calc
      (n - 2) * (Fintype.card V) ^ 2 + (Fintype.card V) ^ 2 =
          (n - 2 + 1) * (Fintype.card V) ^ 2 := by ring
      _ = (n - 1) * (Fintype.card V) ^ 2 := by rw [hnsub]
  have hright : (n - 1) * Fintype.card V * (Fintype.card V - 1) +
      (n - 1) * Fintype.card V = (n - 1) * (Fintype.card V) ^ 2 := by
    calc
      (n - 1) * Fintype.card V * (Fintype.card V - 1) +
          (n - 1) * Fintype.card V =
          (n - 1) * Fintype.card V * (Fintype.card V - 1 + 1) := by ring
      _ = (n - 1) * Fintype.card V * Fintype.card V := by rw [hmsub]
      _ = (n - 1) * (Fintype.card V) ^ 2 := by ring
  have htotal : (n - 1) * d * Fintype.card V +
      (n - 2) * (Fintype.card V) ^ 2 + (n - 1) * Fintype.card V ≤
      (n - 1) * (Fintype.card V) ^ 2 := by
    calc
      (n - 1) * d * Fintype.card V +
          (n - 2) * (Fintype.card V) ^ 2 + (n - 1) * Fintype.card V =
          ((n - 1) * d * Fintype.card V + (n - 1) * Fintype.card V) +
            (n - 2) * (Fintype.card V) ^ 2 := by ring
      _ ≤ (Fintype.card V) ^ 2 + (n - 2) * (Fintype.card V) ^ 2 :=
        Nat.add_le_add_right hsmall _
      _ = (n - 1) * (Fintype.card V) ^ 2 := by rw [add_comm, hnpoly]
  have hpoly : (n - 1) * d * Fintype.card V +
      (n - 2) * (Fintype.card V) ^ 2 ≤
      (n - 1) * Fintype.card V * (Fintype.card V - 1) := by
    have htotal' := htotal
    rw [← hright] at htotal'
    omega
  have hmul : (n - 1) * d * Fintype.card V ≤
      2 * (n - 1) * G.edgeFinset.card := by omega
  have hnpos : 0 < n - 1 := by omega
  nlinarith

/-- The preceding average-degree bound applies uniformly inside every large
induced subset.  This is the numerical engine behind repeatedly extracting
dense pieces from a putative Ramsey counterexample. -/
theorem avg_degree_induce_ge_of_indepSetFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {n d : ℕ} (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : (n - 1) * (d + 1) ≤ S.card) :
    d * S.card ≤ 2 * (G.induce (S : Set V)).edgeFinset.card := by
  have h := avg_degree_ge_of_indepSetFree (G.induce (S : Set V)) (d := d) hn
    (Erdos551.IndepSetFree.induce hfree S)
  simpa using h (by simpa using hsize)

/-- Large independent-set-free pieces contain a genuine nonempty induced
minimum-degree core.  This packages Turán plus the already formalized
low-degree deletion lemma in the exact form consumed by dense extraction. -/
theorem exists_induced_minDegree_core_of_indepSetFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {n d : ℕ} (hn : 2 ≤ n) (hd : 0 < d)
    (hfree : G.IndepSetFree n)
    (hsize : (n - 1) * (d + 1) ≤ S.card) :
    ∃ H : SimpleGraph S, ∃ _ : DecidableRel H.Adj, ∃ hne : H.support.Nonempty,
      H ≤ G.induce (S : Set V) ∧
      H.edgeFinset.card = (H.induce H.support).edgeFinset.card ∧
      d ≤ 2 * (H.induce H.support).minDegree := by
  classical
  let J : SimpleGraph S := G.induce (S : Set V)
  have hdense : d * Fintype.card S ≤ 2 * J.edgeFinset.card := by
    simpa [J] using avg_degree_induce_ge_of_indepSetFree G hn hfree hsize
  have hScardpos : 0 < Fintype.card S := by
    have hnpos : 0 < n - 1 := by omega
    have hSd : 0 < (n - 1) * (d + 1) := by positivity
    simpa using hSd.trans_le hsize
  have hE : J.edgeFinset.Nonempty := by
    by_contra hnot
    rw [Finset.not_nonempty_iff_eq_empty] at hnot
    have hzero : J.edgeFinset.card = 0 := by simp [hnot]
    rw [hzero] at hdense
    have : 0 < d * Fintype.card S := Nat.mul_pos hd hScardpos
    omega
  have hsuppcard : J.support.ncard ≤ Fintype.card S := by
    simpa using Set.ncard_le_ncard
      (show J.support ⊆ Set.univ from Set.subset_univ J.support)
  have hdenseSupport : d * J.support.ncard ≤ 2 * J.edgeFinset.card :=
    (Nat.mul_le_mul_left d hsuppcard).trans hdense
  obtain ⟨H, instH, hne, hHJ, hedge, hmin⟩ :=
    Erdos182.exists_induced_minDegree_core J d hE hdenseSupport
  refine ⟨H, instH, hne, hHJ.trans ?_, hedge.symm, hmin⟩
  exact le_rfl

/-- A rounded minimum-degree core still has the corresponding average-degree
mass: `d ≤ 2δ` implies `d|V| ≤ 4e`.  This is the bridge from the deletion
core to the real-valued density hypothesis of DRC. -/
theorem four_mul_card_edgeFinset_ge_of_le_two_mul_minDegree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {d : ℕ} (hmin : d ≤ 2 * G.minDegree) :
    d * Fintype.card V ≤ 4 * G.edgeFinset.card := by
  have hsum : ∑ v : V, d ≤ ∑ v : V, 2 * G.degree v := by
    apply Finset.sum_le_sum
    intro v _hv
    exact hmin.trans (Nat.mul_le_mul_left 2 (G.minDegree_le_degree v))
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at hsum
  rw [← Finset.mul_sum, G.sum_degrees_eq_twice_card_edges] at hsum
  nlinarith

/-- The preceding integer mass estimate gives a canonical positive DRC
density parameter `d/(2|V|)` whenever `d>0`. -/
theorem drc_density_of_le_two_mul_minDegree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {d : ℕ} (hd : 0 < d)
    (hmin : d ≤ 2 * G.minDegree) :
    let ρ : ℝ := (d : ℝ) / (2 * Fintype.card V)
    0 < ρ ∧ ρ * Fintype.card V * Fintype.card V ≤ 2 * G.edgeFinset.card := by
  let ρ : ℝ := (d : ℝ) / (2 * Fintype.card V)
  have hVpos : (0 : ℝ) < Fintype.card V := by positivity
  have hdreal : (0 : ℝ) < d := by exact_mod_cast hd
  have hmass := four_mul_card_edgeFinset_ge_of_le_two_mul_minDegree G hmin
  have hmassReal : (d : ℝ) * Fintype.card V ≤ 4 * G.edgeFinset.card := by
    exact_mod_cast hmass
  refine ⟨?_, ?_⟩
  · positivity
  · calc
      (d : ℝ) / (2 * Fintype.card V) * Fintype.card V * Fintype.card V =
          ((d : ℝ) * Fintype.card V) / 2 := by field_simp
      _ ≤ (4 * G.edgeFinset.card : ℝ) / 2 := by gcongr
      _ = 2 * G.edgeFinset.card := by ring

/-! ## Greedy hub decomposition skeleton -/

/-- Pairwise disjointness for a finite family of finite vertex sets. -/
def DisjointFinsetFamily_late {V : Type*} (F : Finset (Finset V)) : Prop :=
  ∀ A ∈ F, ∀ B ∈ F, A ≠ B → Disjoint A B

/-- Distinct blocks have no graph edge between them. -/
def PairwiseAnticomplete_late {V : Type*} (G : SimpleGraph V)
    (F : Finset (Finset V)) : Prop :=
  ∀ A ∈ F, ∀ B ∈ F, A ≠ B → ∀ a ∈ A, ∀ b ∈ B, ¬ G.Adj a b

/-- A walk whose support lies in a union of pairwise anticomplete finite
blocks is contained in one block.  This is the localization step that turns
a path in a parity-layer union back into a path in one actual BFS layer. -/
theorem exists_member_containing_walk_support_of_pairwiseAnticomplete
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {F : Finset (Finset V)} (hanti : PairwiseAnticomplete G F)
    {a b : V} (p : G.Walk a b)
    (hsupp : ∀ z ∈ p.support, z ∈ F.biUnion id) :
    ∃ A ∈ F, ∀ z ∈ p.support, z ∈ A := by
  classical
  induction p with
  | @nil a =>
      have ha : a ∈ F.biUnion id := hsupp a (by simp)
      rcases Finset.mem_biUnion.mp ha with ⟨A, hA, haA⟩
      refine ⟨A, hA, ?_⟩
      intro z hz
      have hza : z = a := by simpa using hz
      simpa [hza] using haA
  | @cons a c b hac q ih =>
      have hqsupp : ∀ z ∈ q.support, z ∈ F.biUnion id := by
        intro z hz
        exact hsupp z (by simp [hz])
      obtain ⟨B, hB, hqB⟩ := ih hqsupp
      have haUnion : a ∈ F.biUnion id := hsupp a (by simp)
      rcases Finset.mem_biUnion.mp haUnion with ⟨A, hA, haA⟩
      have hcB : c ∈ B := hqB c (by simp)
      have hAB : A = B := by
        by_contra hne
        exact (hanti A hA B hB hne a haA c hcB) hac
      subst B
      refine ⟨A, hA, ?_⟩
      intro z hz
      simp only [Walk.support_cons, List.mem_cons] at hz
      rcases hz with rfl | hz
      · exact haA
      · exact hqB z hz

/-- A connected component of an induced graph contained in a union of
pairwise-disjoint anticomplete blocks lies in one block.  Choose a block for
one root vertex; every other component vertex is joined to that root by a
walk in the induced graph, and walk localization forces the entire mapped
walk into a single block.  Disjointness identifies that block with the root
block. -/
theorem exists_member_containing_induced_component_of_pairwiseAnticomplete
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {F : Finset (Finset V)} (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    {S : Finset V} (hS : S ⊆ F.biUnion id)
    (c : (G.induce (S : Set V)).ConnectedComponent) :
    ∃ A ∈ F, ∀ z : c, z.1.1 ∈ A := by
  classical
  let H : SimpleGraph S := G.induce (S : Set V)
  let e : H ↪g G := SimpleGraph.Embedding.induce (G := G) (S : Set V)
  let : Nonempty c := c.nonempty_supp.to_subtype
  let z₀ : c := Classical.choice inferInstance
  have hz₀U : z₀.1.1 ∈ F.biUnion id := hS z₀.1.property
  rcases Finset.mem_biUnion.mp hz₀U with ⟨A, hA, hz₀A⟩
  refine ⟨A, hA, ?_⟩
  intro z
  have hreach : H.Reachable z₀.1 z.1 :=
    c.reachable_of_mem_supp z₀.property z.property
  apply hreach.elim
  intro p
  let q : G.Walk (e z₀.1) (e z.1) := p.map e.toHom
  have hqsupp : ∀ w ∈ q.support, w ∈ F.biUnion id := by
    intro w hw
    dsimp [q] at hw
    rw [Walk.support_map] at hw
    rcases List.mem_map.mp hw with ⟨u, _hu, rfl⟩
    exact hS u.property
  obtain ⟨B, hB, hqB⟩ :=
    exists_member_containing_walk_support_of_pairwiseAnticomplete
      G hanti q hqsupp
  have hz₀B : z₀.1.1 ∈ B := hqB _ q.start_mem_support
  have hAB : A = B := by
    by_contra hne
    exact (Finset.disjoint_left.mp (hdisj A hA B hB hne)) hz₀A hz₀B
  subst B
  exact hqB _ q.end_mem_support

/-- Final counting contradiction for a complete stability partition.  At most
`n-1` nonempty anticomplete blocks are possible (choose one representative
from each), and blocks of size at most `k-1` therefore cover at most
`(k-1)(n-1)` vertices. -/
theorem card_le_mul_pred_of_anticomplete_partition
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {k n : ℕ}
    (hfree : G.IndepSetFree n)
    (hnonempty : ∀ A ∈ F, A.Nonempty)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hcover : ∀ v : V, ∃ A ∈ F, v ∈ A)
    (hcard : ∀ A ∈ F, A.card ≤ k - 1) :
    Fintype.card V ≤ (k - 1) * (n - 1) := by
  classical
  let pick : Finset V → V := fun A =>
    if hA : A ∈ F then (hnonempty A hA).choose else Classical.choice inferInstance
  have hpick_mem : ∀ A ∈ F, pick A ∈ A := by
    intro A hA
    simp only [pick, dif_pos hA]
    exact (hnonempty A hA).choose_spec
  have hpick_inj : Set.InjOn pick (F : Set (Finset V)) := by
    intro A hA B hB hab
    by_contra hAB
    have hABdisj := hdisj A hA B hB hAB
    exact (Finset.disjoint_left.mp hABdisj) (hpick_mem A hA)
      (hab ▸ hpick_mem B hB)
  let reps : Finset V := F.image pick
  have hrepscard : reps.card = F.card := by
    exact Finset.card_image_of_injOn hpick_inj
  have hrepsind : G.IsIndepSet (reps : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_image.mp ha with ⟨A, hA, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨B, hB, rfl⟩
    by_cases hAB : A = B
    · subst B
      exact (hab rfl).elim
    · exact hanti A hA B hB hAB (pick A) (hpick_mem A hA)
        (pick B) (hpick_mem B hB)
  have hFlt : F.card < n := by
    rw [← hrepscard]
    exact Erdos551.IndepSetFree.card_lt hfree hrepsind
  have hunionCard : (F.biUnion id).card ≤ F.card * (k - 1) := by
    apply Finset.card_biUnion_le_card_mul
    exact hcard
  have hunion : F.biUnion id = Finset.univ := by
    ext v
    simp only [Finset.mem_biUnion, id_eq, Finset.mem_univ, iff_true]
    exact hcover v
  have hVcard : Fintype.card V = (F.biUnion id).card := by
    rw [hunion]
    simp
  have hFle : F.card ≤ n - 1 := by omega
  rw [hVcard]
  calc
    (F.biUnion id).card ≤ F.card * (k - 1) := hunionCard
    _ ≤ (n - 1) * (k - 1) := Nat.mul_le_mul_right _ hFle
    _ = (k - 1) * (n - 1) := Nat.mul_comm _ _

/-- The union of internally independent, pairwise anticomplete finite pieces
is independent.  This is the counting bridge used for the parity-unbroken
remainders after deleting their small matching endpoint covers. -/
theorem isIndepSet_biUnion_of_pairwiseAnticomplete
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {F : Finset (Finset V)}
    (hInd : ∀ A ∈ F, G.IsIndepSet (A : Set V))
    (hanti : PairwiseAnticomplete G F) :
    G.IsIndepSet ((F.biUnion id : Finset V) : Set V) := by
  rw [SimpleGraph.isIndepSet_iff]
  intro a ha b hb hab
  rcases Finset.mem_biUnion.mp ha with ⟨A, hA, haA⟩
  rcases Finset.mem_biUnion.mp hb with ⟨B, hB, hbB⟩
  by_cases hAB : A = B
  · subst B
    have hAA := hInd A hA
    rw [SimpleGraph.isIndepSet_iff] at hAA
    exact hAA haA hbB hab
  · exact hanti A hA B hB hAB a haA b hbB

/-- Independence-freeness bounds the total order of disjoint anticomplete
independent pieces, not just their number.  Disjointness identifies the
biUnion cardinality with the sum of the individual cardinalities. -/
theorem sum_card_lt_of_disjoint_pairwiseAnticomplete_indep
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hInd : ∀ A ∈ F, G.IsIndepSet (A : Set V)) :
    ∑ A ∈ F, A.card < n := by
  have hpair : (F : Set (Finset V)).PairwiseDisjoint id := by
    intro A hA B hB hAB
    exact hdisj A (by simpa using hA) B (by simpa using hB) hAB
  have hcard :
      (F.biUnion id).card = ∑ A ∈ F, A.card := by
    simpa using Finset.card_biUnion hpair
  rw [← hcard]
  exact Erdos551.IndepSetFree.card_lt hfree
    (isIndepSet_biUnion_of_pairwiseAnticomplete G hInd hanti)

/-- The representative-counting part of the preceding partition theorem,
without any covering or block-size assumptions: an `n`-independent-set-free
graph has fewer than `n` nonempty pairwise-disjoint anticomplete blocks.
Cleanup uses this before the exceptional vertices have been assigned back to
blocks, so the family need not yet cover the ambient graph. -/
theorem card_lt_of_nonempty_disjoint_pairwiseAnticomplete
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hnonempty : ∀ A ∈ F, A.Nonempty)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F) :
    F.card < n := by
  classical
  let pick : Finset V → V := fun A =>
    if hA : A ∈ F then (hnonempty A hA).choose else Classical.choice inferInstance
  have hpick_mem : ∀ A ∈ F, pick A ∈ A := by
    intro A hA
    simp only [pick, dif_pos hA]
    exact (hnonempty A hA).choose_spec
  have hpick_inj : Set.InjOn pick (F : Set (Finset V)) := by
    intro A hA B hB hab
    by_contra hAB
    have hABdisj := hdisj A hA B hB hAB
    exact (Finset.disjoint_left.mp hABdisj) (hpick_mem A hA)
      (hab ▸ hpick_mem B hB)
  let reps : Finset V := F.image pick
  have hrepscard : reps.card = F.card := by
    exact Finset.card_image_of_injOn hpick_inj
  have hrepsind : G.IsIndepSet (reps : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_image.mp ha with ⟨A, hA, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨B, hB, rfl⟩
    by_cases hAB : A = B
    · subst B
      exact (hab rfl).elim
    · exact hanti A hA B hB hAB (pick A) (hpick_mem A hA)
        (pick B) (hpick_mem B hB)
  rw [← hrepscard]
  exact Erdos551.IndepSetFree.card_lt hfree hrepsind

/-- At the extremal-plus-one order, a complete anticomplete block partition
with block sizes at most `k-1` is impossible in an `n`-independent-set-free
graph.  This is the final numerical contradiction after KLS stability and
cleanup have absorbed the leftover vertices. -/
theorem false_of_anticomplete_partition_at_extremal_order
    {k n : ℕ}
    (G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1))) [DecidableRel G.Adj]
    [Nonempty (Fin ((k - 1) * (n - 1) + 1))]
    {F : Finset (Finset (Fin ((k - 1) * (n - 1) + 1)))}
    (hfree : G.IndepSetFree n)
    (hnonempty : ∀ A ∈ F, A.Nonempty)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hcover : ∀ v : Fin ((k - 1) * (n - 1) + 1), ∃ A ∈ F, v ∈ A)
    (hcard : ∀ A ∈ F, A.card ≤ k - 1) : False := by
  have hle := card_le_mul_pred_of_anticomplete_partition G hfree hnonempty hdisj
    hanti hcover hcard
  simp only [Fintype.card_fin] at hle
  omega

/-- The exact output needed from the stability/cleanup argument: a complete
partition into nonempty anticomplete blocks of order at most `k-1`. -/
def CompleteStablePartition_late {V : Type*} (G : SimpleGraph V) (k : ℕ) : Prop :=
  ∃ F : Finset (Finset V),
    (∀ A ∈ F, A.Nonempty) ∧ DisjointFinsetFamily F ∧
    PairwiseAnticomplete G F ∧
    (∀ v : V, ∃ A ∈ F, v ∈ A) ∧
    (∀ A ∈ F, A.card ≤ k - 1)

/-- An assignment of every vertex to a nonempty bounded block gives a
complete stable partition as soon as every ambient edge stays inside one
assignment fibre.  This is the abstract endpoint for the bounded-exception
absorption step: the hard work only has to construct the assignment. -/
theorem completeStablePartition_of_assignment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (assign : V → ι)
    (hne : ∀ i : ι, ∃ v : V, assign v = i)
    (hedge : ∀ a b : V, G.Adj a b → assign a = assign b)
    (hcard : ∀ i : ι,
      ((Finset.univ : Finset V).filter fun v => assign v = i).card ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let B : ι → Finset V :=
    fun i => (Finset.univ : Finset V).filter fun v => assign v = i
  let F : Finset (Finset V) := (Finset.univ : Finset ι).image B
  refine ⟨F, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    obtain ⟨v, hv⟩ := hne i
    exact ⟨v, by simp [B, hv]⟩
  · intro A hA C hC hAC
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨j, _hj, rfl⟩
    rw [Finset.disjoint_left]
    intro v hvi hvj
    have hi : assign v = i := by simpa [B] using hvi
    have hj : assign v = j := by simpa [B] using hvj
    have hij : i = j := by rw [← hi, ← hj]
    apply hAC
    rw [hij]
  · intro A hA C hC hAC a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨j, _hj, rfl⟩
    have hai : assign a = i := by simpa [B] using ha
    have hbj : assign b = j := by simpa [B] using hb
    have hij : i = j := by
      calc
        i = assign a := hai.symm
        _ = assign b := hedge a b hab
        _ = j := hbj
    apply hAC
    rw [hij]
  · intro v
    refine ⟨B (assign v), ?_, ?_⟩
    · exact Finset.mem_image.mpr ⟨assign v, Finset.mem_univ _, rfl⟩
    · simp [B]
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hcard i

/-- Absorption endpoint with explicit seed blocks and a leftover assignment.
The seed blocks are already pairwise anticomplete; every leftover vertex is
assigned to one seed, has no neighbours in any other seed, and leftover edges
stay inside one assigned fibre.  If the enlarged blocks respect the capacity
bound, they form the required complete stable partition. -/
theorem completeStablePartition_of_seed_blocks_and_leftover_assignment_late
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : V → ι)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v ∈ L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v b)
    (hLedge : ∀ u ∈ L, ∀ v ∈ L, G.Adj u v → assign u = assign v)
    (hcap : ∀ i : ι,
      (B i ∪ L.filter fun v => assign v = i).card ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let C : ι → Finset V := fun i => B i ∪ L.filter fun v => assign v = i
  let F : Finset (Finset V) := (Finset.univ : Finset ι).image C
  refine ⟨F, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact (hBne i).mono Finset.subset_union_left
  · intro A hA D hD hAD
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hD with ⟨j, _hj, rfl⟩
    rw [Finset.disjoint_left]
    intro v hvi hvj
    simp only [C, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and] at hvi hvj
    rcases hvi with hvi | ⟨hvL, hvi⟩ <;>
      rcases hvj with hvj | ⟨hvL', hvj⟩
    · by_cases hij : i = j
      · apply hAD
        rw [hij]
      · exact (Finset.disjoint_left.mp (hBdisj i j hij)) hvi hvj
    · exact (Finset.disjoint_left.mp (hBL i)) hvi hvL'
    · exact (Finset.disjoint_left.mp (hBL j)) hvj hvL
    · have hij : i = j := by rw [← hvi, ← hvj]
      apply hAD
      rw [hij]
  · intro A hA D hD hAD a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hD with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      apply hAD
      rw [h]
    simp only [C, Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
    rcases ha with ha | ⟨haL, hai⟩ <;>
      rcases hb with hb | ⟨hbL, hbj⟩
    · exact hBanti i j hij a ha b hb hab
    · have hine : i ≠ assign b := by simpa [hbj] using hij
      exact (hcompat b hbL i hine a ha) hab.symm
    · have hjne : j ≠ assign a := by
        intro h
        apply hij
        rw [← hai, ← h]
      exact hcompat a haL j hjne b hb hab
    · have heq := hLedge a haL b hbL hab
      apply hij
      rw [← hai, ← hbj, heq]
  · intro v
    rcases hcover v with hvL | ⟨i, hvi⟩
    · refine ⟨C (assign v), ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨assign v, Finset.mem_univ _, rfl⟩
      · simp [C, hvL]
    · refine ⟨C i, ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
      · exact Finset.mem_union_left _ hvi
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hcap i

/-- Global-slack form of the leftover absorption endpoint.  Bounding each
seed block plus the entire leftover set is stronger than the individual
fibre capacities, but it is exactly the estimate produced by a uniform small
exceptional set. -/
theorem completeStablePartition_of_seed_blocks_and_leftover_assignment_of_global_slack
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V) (assign : V → ι)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcompat : ∀ v ∈ L, ∀ j : ι, j ≠ assign v →
      ∀ b ∈ B j, ¬ G.Adj v b)
    (hLedge : ∀ u ∈ L, ∀ v ∈ L, G.Adj u v → assign u = assign v)
    (hslack : ∀ i : ι, (B i).card + L.card ≤ k - 1) :
    CompleteStablePartition G k := by
  apply completeStablePartition_of_seed_blocks_and_leftover_assignment
    G B L assign hBne hBdisj hBL hBanti hcover hcompat hLedge
  intro i
  calc
    (B i ∪ L.filter fun v => assign v = i).card ≤
        (B i).card + (L.filter fun v => assign v = i).card :=
      Finset.card_union_le _ _
    _ ≤ (B i).card + L.card := by
      exact Nat.add_le_add_left
        (Finset.card_le_card (Finset.filter_subset (fun v => assign v = i) L)) _
    _ ≤ k - 1 := hslack i

/-- Two-stage absorption endpoint.  The good remainder and an exceptional
remainder may be assigned separately; if the assignments agree on cross
edges and both are compatible with all other seed blocks, their union is a
valid leftover assignment.  This is the exact gluing step needed after the
multi-seed deletion is handled by a separate absorption argument. -/
theorem completeStablePartition_of_seed_blocks_and_two_leftover_assignments_of_global_slack
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (E L : Finset V)
    (assignE : E → ι) (assignL : L → ι)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBE : ∀ i, Disjoint (B i) E)
    (hBL : ∀ i, Disjoint (B i) L)
    (hEL : Disjoint E L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ E ∨ v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hEcompat : ∀ e : E, ∀ j : ι, j ≠ assignE e →
      ∀ b ∈ B j, ¬ G.Adj e.1 b)
    (hLcompat : ∀ v : L, ∀ j : ι, j ≠ assignL v →
      ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hEedge : ∀ e f : E, G.Adj e.1 f.1 → assignE e = assignE f)
    (hLedge : ∀ u v : L, G.Adj u.1 v.1 → assignL u = assignL v)
    (hcross : ∀ e : E, ∀ v : L, G.Adj e.1 v.1 → assignE e = assignL v)
    (hslack : ∀ i : ι, (B i).card + E.card + L.card ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let W : Finset V := E ∪ L
  let assign : V → ι := fun v =>
    if hvE : v ∈ E then assignE ⟨v, hvE⟩
    else if hvL : v ∈ L then assignL ⟨v, hvL⟩
    else Classical.choice inferInstance
  apply completeStablePartition_of_seed_blocks_and_leftover_assignment_of_global_slack
    G B W assign hBne hBdisj
  · intro i
    rw [Finset.disjoint_left]
    intro v hvB hvW
    simp only [W, Finset.mem_union] at hvW
    rcases hvW with hvE | hvL
    · exact (Finset.disjoint_left.mp (hBE i)) hvB hvE
    · exact (Finset.disjoint_left.mp (hBL i)) hvB hvL
  · exact hBanti
  · intro v
    rcases hcover v with hvE | hvL | ⟨i, hvi⟩
    · exact Or.inl (Finset.mem_union_left _ hvE)
    · exact Or.inl (Finset.mem_union_right _ hvL)
    · exact Or.inr ⟨i, hvi⟩
  · intro v hvW j hj b hb
    simp only [W, Finset.mem_union] at hvW
    rcases hvW with hvE | hvL
    · have hjE : j ≠ assignE ⟨v, hvE⟩ := by
        intro h
        apply hj
        simpa [assign, hvE] using h
      exact hEcompat ⟨v, hvE⟩ j hjE b hb
    · have hvE : v ∉ E := by
        intro hvE
        exact (Finset.disjoint_left.mp hEL hvE hvL)
      have hjL : j ≠ assignL ⟨v, hvL⟩ := by
        intro h
        apply hj
        simpa [assign, hvE, hvL] using h
      exact hLcompat ⟨v, hvL⟩ j hjL b hb
  · intro u huW v hvW huv
    simp only [W, Finset.mem_union] at huW hvW
    rcases huW with huE | huL <;> rcases hvW with hvE | hvL
    · simpa [assign, huE, hvE] using
        (hEedge ⟨u, huE⟩ ⟨v, hvE⟩ huv)
    · have hvnotE : v ∉ E := by
        intro hvE
        exact (Finset.disjoint_left.mp hEL hvE hvL)
      simpa [assign, huE, hvnotE, hvL] using
        (hcross ⟨u, huE⟩ ⟨v, hvL⟩ huv)
    · have hunotE : u ∉ E := by
        intro huE
        exact (Finset.disjoint_left.mp hEL huE huL)
      have h := (hcross ⟨v, hvE⟩ ⟨u, huL⟩ huv.symm).symm
      simpa [assign, hunotE, huL, hvE] using h
    · have hunotE : u ∉ E := by
        intro huE
        exact (Finset.disjoint_left.mp hEL huE huL)
      have hvnotE : v ∉ E := by
        intro hvE
        exact (Finset.disjoint_left.mp hEL hvE hvL)
      simpa [assign, hunotE, huL, hvnotE, hvL] using
        (hLedge ⟨u, huL⟩ ⟨v, hvL⟩ huv)
  · intro i
    calc
      (B i).card + W.card ≤ (B i).card + (E.card + L.card) :=
        Nat.add_le_add_left (Finset.card_union_le E L) _
      _ = (B i).card + E.card + L.card := by ring
      _ ≤ k - 1 := hslack i

/-- Separation-fed two-stage absorption.  The good leftover assignment is
chosen automatically from the no-cross-reachable hypothesis; the only
remaining explicit data are the assignments for the exceptional vertices
and their compatibility with that chosen good assignment. -/
theorem completeStablePartition_of_seed_blocks_exceptional_and_separated_leftover_of_global_slack
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (E L : Finset V)
    (assignE : E → ι)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBE : ∀ i, Disjoint (B i) E)
    (hBL : ∀ i, Disjoint (B i) L)
    (hEL : Disjoint E L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ E ∨ v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False)
    (hEcompat : ∀ e : E, ∀ j : ι, j ≠ assignE e →
      ∀ b ∈ B j, ¬ G.Adj e.1 b)
    (hEedge : ∀ e f : E, G.Adj e.1 f.1 → assignE e = assignE f)
    (hcross : ∀ assignL : L → ι,
      (∀ v : L, ∀ j : ι, j ≠ assignL v →
        ∀ b ∈ B j, ¬ G.Adj v.1 b) →
      (∀ u v : L, G.Adj u.1 v.1 → assignL u = assignL v) →
      ∀ e : E, ∀ v : L, G.Adj e.1 v.1 → assignE e = assignL v)
    (hslack : ∀ i : ι, (B i).card + E.card + L.card ≤ k - 1) :
    CompleteStablePartition G k := by
  obtain ⟨assignL, hLcompat, hLedge⟩ :=
    exists_compatible_assignment_of_leftover_separation_early G B L hseparate
  apply completeStablePartition_of_seed_blocks_and_two_leftover_assignments_of_global_slack
    G B E L assignE assignL hBne hBdisj hBE hBL hEL hBanti hcover
    hEcompat hLcompat hEedge hLedge
  · exact hcross assignL hLcompat hLedge
  · exact hslack

/-- Constant-assignment specialization of the two-stage endpoint.  If the
exceptional set is already anticomplete to every trimmed seed and to the
surviving separated remainder, assign all exceptional vertices one arbitrary
seed label; internal exceptional edges are then harmless and cross edges are
absent by hypothesis. -/
theorem completeStablePartition_of_seed_blocks_anticomplete_exceptional_and_separated_leftover_of_global_slack
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (E L : Finset V)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBE : ∀ i, Disjoint (B i) E)
    (hBL : ∀ i, Disjoint (B i) L)
    (hEL : Disjoint E L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ E ∨ v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False)
    (hEanti : ∀ e ∈ E, ∀ j : ι, ∀ b ∈ B j, ¬ G.Adj e b)
    (hELanti : ∀ e ∈ E, ∀ v ∈ L, ¬ G.Adj e v)
    (hslack : ∀ i : ι, (B i).card + E.card + L.card ≤ k - 1) :
    CompleteStablePartition G k := by
  let i₀ : ι := Classical.choice inferInstance
  let assignE : E → ι := fun _ => i₀
  apply completeStablePartition_of_seed_blocks_exceptional_and_separated_leftover_of_global_slack
    G B E L assignE hBne hBdisj hBE hBL hEL hBanti hcover hseparate
  · intro e j _hj b hb
    exact hEanti e.1 e.2 j b hb
  · intro e f _hef
    rfl
  · intro assignL _hLcompat _hLedge e v hev
    exact (hELanti e.1 e.2 v.1 v.2 hev).elim
  · exact hslack

/-- Componentwise absorption endpoint.  It is enough to label each connected
component of the leftover induced graph by one seed block which is
anticomplete to all the other seeds: adjacency inside the leftover cannot
cross two component labels, so the component labels supply the compatible
vertex assignment required by the preceding theorem. -/
theorem completeStablePartition_of_seed_blocks_and_leftover_components_of_global_slack
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hcomponent : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∃ i : ι, ∀ v : L, v ∈ c.supp → ∀ j : ι, j ≠ i →
        ∀ b ∈ B j, ¬ G.Adj v.1 b)
    (hslack : ∀ i : ι, (B i).card + L.card ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  let label : H.ConnectedComponent → ι := fun c =>
    Classical.choose (hcomponent c)
  let assign : V → ι := fun v =>
    if hv : v ∈ L then label (H.connectedComponentMk ⟨v, hv⟩)
    else Classical.choice inferInstance
  apply completeStablePartition_of_seed_blocks_and_leftover_assignment_of_global_slack
    G B L assign hBne hBdisj hBL hBanti hcover
  · intro v hv j hj b hb
    have hspec := Classical.choose_spec
      (hcomponent (H.connectedComponentMk ⟨v, hv⟩))
    have hj' : j ≠ Classical.choose
        (hcomponent (H.connectedComponentMk ⟨v, hv⟩)) := by
      simpa [assign, label, hv] using hj
    exact hspec ⟨v, hv⟩
      (SimpleGraph.ConnectedComponent.connectedComponentMk_mem
        (G := H) (v := ⟨v, hv⟩)) j hj' b hb
  · intro u hu v hv huv
    have hHadj : H.Adj ⟨u, hu⟩ ⟨v, hv⟩ := by
      exact huv
    have hcomp : H.connectedComponentMk ⟨u, hu⟩ =
        H.connectedComponentMk ⟨v, hv⟩ :=
      SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hHadj
    simp [assign, hu, hv, hcomp]
  · exact hslack

/-- Separation-to-label bridge.  If no connected path in the leftover can
have one endpoint adjacent to one seed and another endpoint adjacent to a
different seed, then every leftover component has a compatible seed label.
Components with no seed neighbour may be assigned an arbitrary label. -/
theorem exists_compatible_seed_for_leftover_components_of_no_cross_reachable
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (B : ι → Finset V) (L : Finset V)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False) :
    ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∃ i : ι, ∀ v : L, v ∈ c.supp → ∀ j : ι, j ≠ i →
        ∀ b ∈ B j, ¬ G.Adj v.1 b := by
  intro c
  by_cases hattach : ∃ i : ι, ∃ u : L, u ∈ c.supp ∧
      ∃ a ∈ B i, G.Adj u.1 a
  · rcases hattach with ⟨i, u, hu, a, ha, hua⟩
    refine ⟨i, ?_⟩
    intro v hv j hji b hb hvb
    exact hseparate i j (Ne.symm hji) u v
      (c.reachable_of_mem_supp hu hv)
      ⟨a, ha, hua⟩ ⟨b, hb, hvb⟩
  · let i : ι := Classical.choice inferInstance
    refine ⟨i, ?_⟩
    intro v hv j _hji b hb hvb
    exact (hattach ⟨j, v, hv, b, hb, hvb⟩).elim

/-- Assignment form of the separation bridge.  Choose the compatible label
of each leftover component and evaluate it on vertices; the result is
compatible with every other seed block and constant on leftover edges.  This
is the interface used when a later absorption step supplies assignments for
an additional exceptional set and the two assignments are glued together. -/
theorem exists_compatible_assignment_of_leftover_separation
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (B : ι → Finset V) (L : Finset V)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False) :
    ∃ assign : L → ι,
      (∀ v : L, ∀ j : ι, j ≠ assign v →
        ∀ b ∈ B j, ¬ G.Adj v.1 b) ∧
      ∀ u v : L, G.Adj u.1 v.1 → assign u = assign v := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  have hcomponent :=
    exists_compatible_seed_for_leftover_components_of_no_cross_reachable
      G B L hseparate
  let label : H.ConnectedComponent → ι := fun c =>
    Classical.choose (hcomponent c)
  let assign : L → ι := fun v => label (H.connectedComponentMk v)
  refine ⟨assign, ?_, ?_⟩
  · intro v j hj b hb
    have hspec := Classical.choose_spec (hcomponent (H.connectedComponentMk v))
    have hj' : j ≠ Classical.choose (hcomponent (H.connectedComponentMk v)) := by
      simpa [assign, label] using hj
    exact hspec v
      (SimpleGraph.ConnectedComponent.connectedComponentMk_mem
        (G := H) (v := v)) j hj' b hb
  · intro u v huv
    have hHadj : H.Adj u v := huv
    have hcomp : H.connectedComponentMk u = H.connectedComponentMk v :=
      SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hHadj
    simp [assign, hcomp]

/-- Separation is monotone under deleting more leftover vertices and under
trimming every seed block further.  Reachability in the smaller induced
leftover maps through the canonical induced embedding to reachability in the
larger leftover, while the smaller block witnesses are also witnesses for
the original blocks. -/
theorem leftover_separation_mono
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (B B' : ι → Finset V) (L S : Finset V)
    (hSL : S ⊆ L) (hBB' : ∀ i, B' i ⊆ B i)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False) :
    ∀ i j : ι, i ≠ j → ∀ u v : S,
      (G.induce (S : Set V)).Reachable u v →
      (∃ a ∈ B' i, G.Adj u.1 a) →
      (∃ b ∈ B' j, G.Adj v.1 b) → False := by
  let H : SimpleGraph S := G.induce (S : Set V)
  let K : SimpleGraph L := G.induce (L : Set V)
  have hSLset : (S : Set V) ⊆ (L : Set V) := by
    intro x hx
    exact hSL hx
  let e : H ↪g K := G.induceHomOfLE hSLset
  intro i j hij u v huv hu hv
  have huv' : K.Reachable (e u) (e v) := huv.map e.toHom
  apply hseparate i j hij (e u) (e v) huv'
  · rcases hu with ⟨a, ha, hua⟩
    exact ⟨a, hBB' i ha, hua⟩
  · rcases hv with ⟨b, hb, hvb⟩
    exact ⟨b, hBB' j hb, hvb⟩

/-- Concrete separation endpoint for absorption.  The only leftover input is
the path-separation condition used in KLS cleanup; the preceding bridge
chooses component labels and the global-slack endpoint absorbs them. -/
theorem completeStablePartition_of_seed_blocks_and_leftover_separation_of_global_slack
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k : ℕ}
    (B : ι → Finset V) (L : Finset V)
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hBL : ∀ i, Disjoint (B i) L)
    (hBanti : ∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b)
    (hcover : ∀ v : V, v ∈ L ∨ ∃ i : ι, v ∈ B i)
    (hseparate : ∀ i j : ι, i ≠ j → ∀ u v : L,
      (G.induce (L : Set V)).Reachable u v →
      (∃ a ∈ B i, G.Adj u.1 a) →
      (∃ b ∈ B j, G.Adj v.1 b) → False)
    (hslack : ∀ i : ι, (B i).card + L.card ≤ k - 1) :
    CompleteStablePartition G k := by
  apply completeStablePartition_of_seed_blocks_and_leftover_components_of_global_slack
    G B L hBne hBdisj hBL hBanti hcover
  · exact exists_compatible_seed_for_leftover_components_of_no_cross_reachable
      G B L hseparate
  · exact hslack

/-- Connected components themselves give a complete stable partition as
soon as every component has order at most `k-1`.  This turns the last
structural target into a concrete component-size statement. -/
theorem completeStablePartition_of_component_card_le
    {V : Type*} [Fintype V] (G : SimpleGraph V) {k : ℕ}
    (hcomp : ∀ c : G.ConnectedComponent, c.supp.ncard ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let f : G.ConnectedComponent ↪ Finset V :=
    { toFun := fun c => c.supp.toFinset
      inj' := by
        intro c d h
        apply SimpleGraph.ConnectedComponent.supp_injective
        simpa using h }
  let F : Finset (Finset V) := Finset.univ.map f
  refine ⟨F, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    change c.supp.toFinset.Nonempty
    simpa using c.nonempty_supp
  · intro A hA B hB hAB
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_map.mp hB with ⟨d, _hd, rfl⟩
    have hcd : c ≠ d := by
      intro h
      apply hAB
      subst d
      rfl
    rw [Finset.disjoint_left]
    intro v hvc hvd
    have hvc' : v ∈ c.supp := by
      change v ∈ c.supp.toFinset at hvc
      exact Set.mem_toFinset.mp hvc
    have hvd' : v ∈ d.supp := by
      change v ∈ d.supp.toFinset at hvd
      exact Set.mem_toFinset.mp hvd
    exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hvc' hvd')
  · intro A hA B hB hAB a ha b hb hab
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_map.mp hB with ⟨d, _hd, rfl⟩
    have hac : a ∈ c.supp := by
      change a ∈ c.supp.toFinset at ha
      exact Set.mem_toFinset.mp ha
    have hbd : b ∈ d.supp := by
      change b ∈ d.supp.toFinset at hb
      exact Set.mem_toFinset.mp hb
    have hca : G.connectedComponentMk a = c :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff c a).mp hac
    have hdb : G.connectedComponentMk b = d :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff d b).mp hbd
    apply hAB
    have hcd : c = d := by
      rw [← hca, ← hdb]
      exact SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hab
    simpa [hcd]
  · intro v
    let c := G.connectedComponentMk v
    refine ⟨c.supp.toFinset, ?_, ?_⟩
    · exact Finset.mem_map.mpr ⟨c, Finset.mem_univ _, rfl⟩
    · simpa [c] using (SimpleGraph.ConnectedComponent.connectedComponentMk_mem (G := G) (v := v))
  · intro A hA
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    change c.supp.toFinset.card ≤ k - 1
    rw [← Set.ncard_eq_toFinset_card']
    exact hcomp c

/-- Independence-freeness bounds the number of connected components.  Pick
one vertex from each component; representatives from different components
cannot be adjacent, so they form an independent set.  This is the counting
fact used when a leftover decomposition has already reduced every component
to bounded order. -/
theorem card_connectedComponent_lt_of_indepSetFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ}
    (hfree : G.IndepSetFree n) :
    Fintype.card G.ConnectedComponent < n := by
  classical
  let pick : G.ConnectedComponent → V := fun c =>
    Classical.choose c.nonempty_supp
  have hpick : ∀ c : G.ConnectedComponent, pick c ∈ c.supp := by
    intro c
    exact Classical.choose_spec c.nonempty_supp
  have hpick_inj : Function.Injective pick := by
    intro c d hcd
    apply SimpleGraph.ConnectedComponent.eq_of_common_vertex (hpick c)
    simpa [hcd] using hpick d
  let R : Finset V := (Finset.univ : Finset G.ConnectedComponent).image pick
  have hRcard : R.card = Fintype.card G.ConnectedComponent := by
    calc
      R.card = (Finset.univ : Finset G.ConnectedComponent).card := by
        rw [Finset.card_image_of_injective _ hpick_inj]
      _ = Fintype.card G.ConnectedComponent := by simp
  have hRind : G.IsIndepSet (R : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_image.mp ha with ⟨c, _hc, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨d, _hd, rfl⟩
    intro hadj
    have hdc : d = c := by
      apply SimpleGraph.ConnectedComponent.eq_of_common_vertex (hpick d)
      exact c.mem_supp_of_adj_mem_supp (hpick c) hadj
    subst d
    exact hab rfl
  rw [← hRcard]
  exact Erdos551.IndepSetFree.card_lt hfree hRind

/-- If every component of an induced leftover graph has at most two
vertices, then the whole leftover has at most `2(n-1)` vertices.  The proof
reuses the already checked complete-component partition and the final
anticomplete partition count, so no separate component-sum bookkeeping is
needed here. -/
theorem card_le_two_mul_pred_of_indepSetFree_of_components_card_le_two
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {L : Finset V} {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2) :
    L.card ≤ 2 * (n - 1) := by
  classical
  by_cases hL : L.Nonempty
  · let H : SimpleGraph L := G.induce (L : Set V)
    let : Nonempty L := hL.to_subtype
    obtain ⟨F, hnonempty, hdisj, hanti, hcover, hcard⟩ :=
      completeStablePartition_of_component_card_le H (k := 3) (by
        intro c
        simpa [H] using hsmall c)
    have hle := card_le_mul_pred_of_anticomplete_partition H
      (Erdos551.IndepSetFree.induce hfree L) hnonempty hdisj hanti hcover hcard
    simpa [H] using hle
  · simp only [Finset.not_nonempty_iff_eq_empty] at hL
    simp [hL]

/-- Component order is monotone under passing to an induced subset.  A
component of the smaller induced graph maps injectively into the ambient
component containing one chosen root; reachability maps through the induced
embedding, so every mapped vertex stays in that one ambient component. -/
theorem component_card_le_of_induce_subset
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S L : Finset V} {m : ℕ} (hSL : S ⊆ L)
    (hbound : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ m) :
    ∀ c : (G.induce (S : Set V)).ConnectedComponent,
      c.supp.ncard ≤ m := by
  classical
  let K : SimpleGraph S := G.induce (S : Set V)
  let H : SimpleGraph L := G.induce (L : Set V)
  have hSLset : (S : Set V) ⊆ (L : Set V) := by
    intro x hx
    exact hSL hx
  let e : K ↪g H := G.induceHomOfLE hSLset
  intro c
  obtain ⟨r, hr⟩ := c.nonempty_supp
  let d : H.ConnectedComponent := H.connectedComponentMk (e r)
  have hmem : ∀ y : c, e y.1 ∈ d.supp := by
    intro y
    have hreachK : K.Reachable r y.1 := c.reachable_of_mem_supp hr y.2
    have hreachH : H.Reachable (e r) (e y.1) := hreachK.map e.toHom
    change H.connectedComponentMk (e y.1) = H.connectedComponentMk (e r)
    exact (SimpleGraph.ConnectedComponent.sound hreachH).symm
  let f : c → d := fun y => ⟨e y.1, hmem y⟩
  have hfinj : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    apply e.injective
    exact congrArg Subtype.val hab
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  have hdCard : Fintype.card d = d.supp.ncard := by
    calc
      Fintype.card d = Fintype.card d.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = d.supp.ncard := Set.fintypeCard_eq_ncard d.supp
  calc
    c.supp.ncard = Fintype.card c := hcCard.symm
    _ ≤ Fintype.card d := Fintype.card_le_of_injective f hfinj
    _ = d.supp.ncard := hdCard
    _ ≤ m := hbound d

/-- Removing the leftover-side multi-seed vertices preserves a previously
proved two-vertex component bound.  This is the concrete monotonicity bridge
consumed by the multi-seed deletion/separation wrapper. -/
theorem component_card_le_two_after_multiSeedLeftoverDeletion
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2) :
    ∀ c :
      (G.induce ((L \ MultiSeedLeftoverFinset G U L : Finset V) : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2 := by
  apply component_card_le_of_induce_subset G Finset.sdiff_subset hsmall

/-- First component-size dichotomy from Dirac trimming.  In a `Cₖ`-free graph
of minimum degree at least `k-1`, a connected component cannot have an order
in the entire interval from `k` through roughly `3k/2`; it is either smaller
than `k` or genuinely large.  KLS stability is what rules out the latter
large alternative after hub cleanup. -/
theorem component_card_lt_or_three_mul_sub_two_lt_two_mul_card
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) (c : G.ConnectedComponent) :
    c.supp.ncard < k ∨ 3 * k - 2 < 2 * c.supp.ncard := by
  classical
  by_cases hsmall : c.supp.ncard < k
  · exact Or.inl hsmall
  · right
    by_contra hnotlarge
    have hkcard : k ≤ c.supp.ncard := by omega
    have hupper : 2 * c.supp.ncard ≤ 3 * k - 2 := by omega
    let C : SimpleGraph c := c.toSimpleGraph
    let : Nonempty c := c.nonempty_supp.to_subtype
    have hCmin : k - 1 ≤ C.minDegree := by
      apply C.le_minDegree_of_forall_le_degree
      intro v
      rw [Erdos752.degree_toSimpleGraph_eq G c v]
      exact hmin.trans (G.minDegree_le_degree v.1)
    have hccard : Fintype.card c = c.supp.ncard := by
      calc
        Fintype.card c = Fintype.card c.supp := by
          apply Fintype.card_congr
          exact
            { toFun := fun x => ⟨x.1, x.2⟩
              invFun := fun x => ⟨x.1, x.2⟩
              left_inv := fun x => by ext; rfl
              right_inv := fun x => by ext; rfl }
        _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
    have hkC : k ≤ Fintype.card c := by omega
    have htrim : k ≤ 2 * ((k - 1) - (Fintype.card c - k)) := by
      rw [hccard]
      omega
    have hcopyC : cycleGraph k ⊑ C :=
      cycleGraph_isContained_of_trimmed_minDegree_univ C hk hkC hCmin htrim
    apply hcycle
    exact hcopyC.trans
      (SimpleGraph.Embedding.induce (G := G) c.supp).isContained

/-- Once cleanup supplies a complete stable partition, the dense
counterexample branch is impossible by the preceding counting theorem. -/
theorem denseCounterexampleExcludedAt_of_completeStablePartitions
    {k : ℕ}
    (hstable : ∀ n : ℕ, 3 ≤ n → n ≤ k →
      ∀ G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)),
        k - 1 ≤ G.minDegree → G.IndepSetFree n →
        ¬ cycleGraph k ⊑ G → CompleteStablePartition G k) :
    DenseCounterexampleExcludedAt k := by
  intro n hn hnk G hmin hfree hcycle
  obtain ⟨F, hnonempty, hdisj, hanti, hcover, hcard⟩ :=
    hstable n hn hnk G hmin hfree hcycle
  let : Nonempty (Fin ((k - 1) * (n - 1) + 1)) :=
    Fin.pos_iff_nonempty.mp (by omega)
  exact false_of_anticomplete_partition_at_extremal_order G hfree hnonempty hdisj
    hanti hcover hcard

/-- A particularly concrete sufficient stability target: if every connected
component of every dense counterexample has at most `k-1` vertices, then the
component partition itself closes the induction. -/
theorem denseCounterexampleExcludedAt_of_components_small
    {k : ℕ}
    (hsmall : ∀ n : ℕ, 3 ≤ n → n ≤ k →
      ∀ G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)),
        k - 1 ≤ G.minDegree → G.IndepSetFree n →
        ¬ cycleGraph k ⊑ G →
        ∀ c : G.ConnectedComponent, c.supp.ncard ≤ k - 1) :
    DenseCounterexampleExcludedAt k := by
  apply denseCounterexampleExcludedAt_of_completeStablePartitions
  intro n hn hnk G hmin hfree hcycle
  exact completeStablePartition_of_component_card_le G
    (hsmall n hn hnk G hmin hfree hcycle)

/-- Eventual complete stability is now literally equivalent to the remaining
graph-theoretic work: the fixed-`k` induction and exact Ramsey equality are
already discharged above. -/
theorem erdos551_eventually_of_eventually_completeStablePartitions
    (hstable : ∀ᶠ k : ℕ in atTop,
      ∀ n : ℕ, 3 ≤ n → n ≤ k →
        ∀ G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)),
          k - 1 ≤ G.minDegree → G.IndepSetFree n →
          ¬ cycleGraph k ⊑ G → CompleteStablePartition G k) :
    ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → ∀ k : ℕ, n ≤ k →
      cycleCliqueRamseyNumber k n = (k - 1) * (n - 1) + 1 := by
  apply erdos551_eventually_of_eventually_denseCounterexampleExcluded
  filter_upwards [hstable] with k hk
  exact denseCounterexampleExcludedAt_of_completeStablePartitions hk

/-- Generic greedy decomposition.  If every remaining set of size at least
`m` contains a nonempty object satisfying `P`, then one can peel disjoint
`P`-objects until fewer than `m` vertices remain.  KLS applies this with
`P` equal to “is a hub”; keeping the finite induction explicit makes the
later quantitative bookkeeping independent of any maximal-choice argument. -/
theorem exists_disjoint_family_covering_up_to
    {V : Type*} [Fintype V] (P : Finset V → Prop) (m : ℕ)
    (hextract : ∀ S : Finset V, m ≤ S.card →
      ∃ H : Finset V, H ⊆ S ∧ H.Nonempty ∧ P H) :
    ∀ S : Finset V, ∃ F : Finset (Finset V),
      (∀ H ∈ F, P H) ∧ DisjointFinsetFamily F ∧
      F.biUnion id ⊆ S ∧ (S \ F.biUnion id).card < m := by
  classical
  intro S
  refine Finset.strongInductionOn S ?_
  intro S ih
  by_cases hsmall : S.card < m
  · refine ⟨∅, ?_, ?_, ?_, ?_⟩
    · simp
    · intro A hA
      simp at hA
    · simp
    · simpa using hsmall
  · obtain ⟨H, hHS, hHne, hPH⟩ := hextract S (by omega)
    let R := S \ H
    have hRS : R ⊂ S := by
      exact Finset.sdiff_ssubset hHS hHne
    obtain ⟨F, hPF, hdisj, hunion, hrem⟩ := ih R hRS
    have hH_disj_union : Disjoint H (F.biUnion id) := by
      rw [Finset.disjoint_left]
      intro x hxH hxF
      have hxR : x ∈ R := hunion hxF
      exact (Finset.mem_sdiff.mp hxR).2 hxH
    have hnewunion : (insert H F).biUnion id = H ∪ F.biUnion id := by simp
    refine ⟨insert H F, ?_, ?_, ?_, ?_⟩
    · intro A hA
      simp only [Finset.mem_insert] at hA
      rcases hA with rfl | hA
      · exact hPH
      · exact hPF A hA
    · intro A hA B hB hAB
      simp only [Finset.mem_insert] at hA hB
      rcases hA with rfl | hA <;> rcases hB with rfl | hB
      · exact (hAB rfl).elim
      · have hBsub : B ⊆ F.biUnion id := Finset.subset_biUnion_of_mem id hB
        exact hH_disj_union.mono_right hBsub
      · have hAsub : A ⊆ F.biUnion id := Finset.subset_biUnion_of_mem id hA
        exact (hH_disj_union.mono_right hAsub).symm
      · exact hdisj A hA B hB hAB
    · rw [hnewunion]
      exact Finset.union_subset hHS (hunion.trans Finset.sdiff_subset)
    · have hremEq : S \ (insert H F).biUnion id = R \ F.biUnion id := by
        rw [hnewunion]
        ext x
        simp [R, and_left_comm, and_assoc]
      rw [hremEq]
      exact hrem

/-- Greedy decomposition with separators.  An extraction step returns a core
H and a deleted envelope D containing it; the core is anticomplete to the
remaining set after D is deleted.  Iterating this operation records
pairwise-disjoint envelopes and pairwise-anticomplete cores, while the
unprocessed remainder becomes smaller than the cutoff.  This is the exact
finite recursion used by the BFS anticomplete-layer decomposition, where D
is the slow ball together with its neighbourhood. -/
theorem exists_separated_extraction_family_covering_up_to
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (P : Finset V → Finset V → Prop) (m : ℕ)
    (hextract : ∀ S : Finset V, m ≤ S.card →
      ∃ H D : Finset V, H ⊆ D ∧ D ⊆ S ∧ H.Nonempty ∧ P H D ∧
        ∀ a ∈ H, ∀ b ∈ S \ D, ¬ G.Adj a b) :
    ∀ S : Finset V, ∃ F : Finset (Finset V × Finset V),
      (∀ q ∈ F, q.1 ⊆ q.2 ∧ q.1.Nonempty ∧ P q.1 q.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r →
        ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b) ∧
      F.biUnion (fun q => q.2) ⊆ S ∧
      (S \ F.biUnion (fun q => q.2)).card < m := by
  classical
  intro S
  refine Finset.strongInductionOn S ?_
  intro S ih
  by_cases hsmall : S.card < m
  · refine ⟨∅, ?_, ?_, ?_, ?_, ?_⟩
    · simp
    · simp
    · simp
    · simp
    · simpa using hsmall
  · obtain ⟨H, D, hHD, hDS, hHne, hPH, hantiR⟩ := hextract S (by omega)
    let R : Finset V := S \ D
    have hDne : D.Nonempty := hHne.mono hHD
    have hRS : R ⊂ S := Finset.sdiff_ssubset hDS hDne
    obtain ⟨F, hcore, hdisj, hanti, hunion, hrem⟩ := ih R hRS
    have hD_disj_union : Disjoint D (F.biUnion fun q => q.2) := by
      rw [Finset.disjoint_left]
      intro x hxD hxF
      have hxR : x ∈ R := hunion hxF
      exact (Finset.mem_sdiff.mp hxR).2 hxD
    have hnewunion :
        (insert (H, D) F).biUnion (fun q => q.2) =
          D ∪ F.biUnion (fun q => q.2) := by simp
    refine ⟨insert (H, D) F, ?_, ?_, ?_, ?_, ?_⟩
    · intro q hq
      simp only [Finset.mem_insert] at hq
      rcases hq with rfl | hq
      · exact ⟨hHD, hHne, hPH⟩
      · exact hcore q hq
    · intro q hq r hr hqr
      simp only [Finset.mem_insert] at hq hr
      rcases hq with rfl | hq <;> rcases hr with rfl | hr
      · exact (hqr rfl).elim
      · have hrsub : r.2 ⊆ F.biUnion fun q => q.2 :=
          Finset.subset_biUnion_of_mem (fun q => q.2) hr
        exact hD_disj_union.mono_right hrsub
      · have hqsub : q.2 ⊆ F.biUnion fun q => q.2 :=
          Finset.subset_biUnion_of_mem (fun q => q.2) hq
        exact (hD_disj_union.mono_right hqsub).symm
      · exact hdisj q hq r hr hqr
    · intro q hq r hr hqr a ha b hb hab
      simp only [Finset.mem_insert] at hq hr
      rcases hq with rfl | hq <;> rcases hr with rfl | hr
      · exact (hqr rfl).elim
      · have hbD : b ∈ r.2 := (hcore r hr).1 hb
        have hbR : b ∈ R := hunion
          (Finset.mem_biUnion.mpr ⟨r, hr, hbD⟩)
        exact hantiR a ha b hbR hab
      · have haD : a ∈ q.2 := (hcore q hq).1 ha
        have haR : a ∈ R := hunion
          (Finset.mem_biUnion.mpr ⟨q, hq, haD⟩)
        exact hantiR b hb a haR hab.symm
      · exact hanti q hq r hr hqr a ha b hb hab
    · rw [hnewunion]
      exact Finset.union_subset hDS (hunion.trans Finset.sdiff_subset)
    · have hremEq :
          S \ (insert (H, D) F).biUnion (fun q => q.2) =
            R \ F.biUnion (fun q => q.2) := by
        rw [hnewunion]
        ext x
        simp [R, and_left_comm, and_assoc]
      rw [hremEq]
      exact hrem

/-! ## Erdős--Gallai style path-density bound -/

/-- If a finite graph contains no simple path of length at least `D`, then
it has fewer than `D|V|` edges.  The proof uses the already formalized
minimum-degree core: too many edges give a core of minimum degree at least
`D`, and the maximal-path lemma supplies the forbidden path. -/
theorem card_edgeFinset_lt_mul_card_of_no_long_path
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (D : ℕ)
    (hno : ¬ ∃ u v : V, ∃ p : G.Walk u v, p.IsPath ∧ D ≤ p.length) :
    G.edgeFinset.card < D * Fintype.card V := by
  classical
  have hD : 0 < D := by
    by_contra hDz
    have hDz' : D = 0 := Nat.eq_zero_of_not_pos hDz
    obtain ⟨x⟩ := ‹Nonempty V›
    apply hno
    exact ⟨x, x, Walk.nil, by simp, by simp [hDz']⟩
  by_contra hnot
  have hdense : D * Fintype.card V ≤ G.edgeFinset.card := by omega
  have hE : G.edgeFinset.Nonempty := by
    by_contra hempty
    rw [Finset.not_nonempty_iff_eq_empty] at hempty
    have hedgezero : G.edgeFinset.card = 0 := by simp [hempty]
    rw [hedgezero] at hdense
    have hVpos : 0 < Fintype.card V := Fintype.card_pos
    have : 0 < D * Fintype.card V := Nat.mul_pos hD hVpos
    omega
  have hsupp : G.support.ncard ≤ Fintype.card V := by
    simpa using Set.ncard_le_ncard (Set.subset_univ G.support)
  have hcoreDense : (2 * D) * G.support.ncard ≤ 2 * G.edgeFinset.card := by
    calc
      (2 * D) * G.support.ncard ≤ (2 * D) * Fintype.card V :=
        Nat.mul_le_mul_left _ hsupp
      _ = 2 * (D * Fintype.card V) := by ring
      _ ≤ 2 * G.edgeFinset.card := Nat.mul_le_mul_left 2 hdense
  obtain ⟨H, instH, hHsupport, hHG, _hedge, hHmin⟩ :=
    Erdos182.exists_induced_minDegree_core G (2 * D) hE hcoreDense
  let : DecidableRel H.Adj := instH
  let K : SimpleGraph H.support := H.induce H.support
  let : Nonempty H.support := hHsupport.to_subtype
  have hDmin : D ≤ K.minDegree := by
    dsimp [K]
    omega
  obtain ⟨u, v, p, hp, hplen⟩ := exists_isPath_length_ge_minDegree K
  let e : K ↪g H := SimpleGraph.Embedding.induce H.support
  let f : K →g G := (SimpleGraph.Hom.ofLE hHG).comp e.toHom
  have hf : Function.Injective f := by
    intro x y hxy
    apply e.injective
    simpa [f] using hxy
  let q : G.Walk (f u) (f v) := p.map f
  have hq : q.IsPath := hp.map hf
  have hqlen : q.length = p.length := by simp [q]
  apply hno
  exact ⟨f u, f v, q, hq, by rw [hqlen]; exact hDmin.trans hplen⟩

/-! ## Bipartite BFS dense slices -/

/-- Fixed-base growth estimate for the KLS first-slow-layer argument.  If an
accumulated BFS volume at least doubles at every step before j, then its
j-th value is at least 2^j.  The fixed base avoids real logarithms in the
graph-theoretic part of the eventual proof. -/
theorem two_pow_le_of_doubling_before
    (a : ℕ → ℕ) (j : ℕ) (ha0 : 1 ≤ a 0)
    (hgrow : ∀ i < j, 2 * a i ≤ a (i + 1)) :
    2 ^ j ≤ a j := by
  induction j with
  | zero => simpa using ha0
  | succ j ih =>
      have ih' : 2 ^ j ≤ a j := ih (fun i hi => hgrow i (by omega))
      calc
        2 ^ (j + 1) = 2 * 2 ^ j := by rw [Nat.pow_succ]; ring
        _ ≤ 2 * a j := Nat.mul_le_mul_left 2 ih'
        _ ≤ a (j + 1) := hgrow j (by omega)

/-- Consequently a first slow BFS index is bounded by the binary logarithm
of the ambient order.  This is the discrete replacement for the paper's
real-logarithm estimate when the growth factor is fixed to two. -/
theorem index_le_log_two_of_doubling_before
    (a : ℕ → ℕ) (j N : ℕ) (ha0 : 1 ≤ a 0)
    (hgrow : ∀ i < j, 2 * a i ≤ a (i + 1))
    (hbound : a j ≤ N) :
    j ≤ Nat.log 2 N := by
  apply Nat.le_log_of_pow_le (by omega)
  exact (two_pow_le_of_doubling_before a j ha0 hgrow).trans hbound

/-- Every uniformly bounded accumulated-volume sequence has a binary slow
step by the logarithmic time.  Applied to unions of BFS layers, this is the
finite stopping-time lemma behind the anticomplete-layer decomposition. -/
theorem exists_slow_index_le_log_two
    (a : ℕ → ℕ) (N : ℕ) (ha0 : 1 ≤ a 0)
    (hbound : ∀ i : ℕ, a i ≤ N) :
    ∃ j : ℕ, j ≤ Nat.log 2 N ∧ a (j + 1) ≤ 2 * a j := by
  by_contra hno
  push_neg at hno
  have hgrow : ∀ i < Nat.log 2 N + 1, 2 * a i ≤ a (i + 1) := by
    intro i hi
    have hstrict : 2 * a i < a (i + 1) := hno i (by omega)
    omega
  have hpow : 2 ^ (Nat.log 2 N + 1) ≤ a (Nat.log 2 N + 1) :=
    two_pow_le_of_doubling_before a (Nat.log 2 N + 1) ha0 hgrow
  have hNlt : N < 2 ^ (Nat.log 2 N + 1) := by
    simpa only [Nat.succ_eq_add_one] using
      (Nat.lt_pow_succ_log_self (b := 2) (by omega) N)
  have := hbound (Nat.log 2 N + 1)
  omega

/-- Variable-base form of `two_pow_le_of_doubling_before`.  This is the
version used in the KLS interaction graph, where the growth factor is a
power of the target scale rather than the fixed factor two. -/
theorem pow_le_of_mul_growth_before
    (a : ℕ → ℕ) (b j : ℕ) (ha0 : 1 ≤ a 0)
    (hgrow : ∀ i < j, b * a i ≤ a (i + 1)) :
    b ^ j ≤ a j := by
  induction j with
  | zero => simpa using ha0
  | succ j ih =>
      have ih' : b ^ j ≤ a j := ih (fun i hi => hgrow i (by omega))
      calc
        b ^ (j + 1) = b * b ^ j := by rw [Nat.pow_succ]; ring
        _ ≤ b * a j := Nat.mul_le_mul_left b ih'
        _ ≤ a (j + 1) := hgrow j (by omega)

/-- If a bounded sequence grows by a factor `b` before index `j`, then
`j` is at most the base-`b` logarithm of the bound. -/
theorem index_le_log_of_mul_growth_before
    (a : ℕ → ℕ) (b j N : ℕ) (hb : 2 ≤ b) (ha0 : 1 ≤ a 0)
    (hgrow : ∀ i < j, b * a i ≤ a (i + 1))
    (hbound : a j ≤ N) :
    j ≤ Nat.log b N := by
  apply Nat.le_log_of_pow_le (by omega)
  exact (pow_le_of_mul_growth_before a b j ha0 hgrow).trans hbound

/-- Every uniformly bounded sequence has a base-`b` slow step by the
base-`b` logarithmic time.  The strict negation of the desired slow step
gives the weak multiplicative growth inequality needed above. -/
theorem exists_slow_index_le_log
    (a : ℕ → ℕ) (b N : ℕ) (hb : 2 ≤ b) (ha0 : 1 ≤ a 0)
    (hbound : ∀ i : ℕ, a i ≤ N) :
    ∃ j : ℕ, j ≤ Nat.log b N ∧ a (j + 1) ≤ b * a j := by
  by_contra hno
  push_neg at hno
  have hgrow : ∀ i < Nat.log b N + 1, b * a i ≤ a (i + 1) := by
    intro i hi
    have hstrict : b * a i < a (i + 1) := hno i (by omega)
    omega
  have hpow : b ^ (Nat.log b N + 1) ≤ a (Nat.log b N + 1) :=
    pow_le_of_mul_growth_before a b (Nat.log b N + 1) ha0 hgrow
  have hNlt : N < b ^ (Nat.log b N + 1) := by
    simpa only [Nat.succ_eq_add_one] using
      (Nat.lt_pow_succ_log_self (b := b) (by omega) N)
  have := hbound (Nat.log b N + 1)
  omega

/-- The accumulated BFS ball through level i.  KLS uses these cumulative
volumes, rather than individual layers, to locate the first slow-growth
radius. -/
def bfsBall {V : Type*} (G : SimpleGraph V) (root : V) (i : ℕ) : Set V :=
  {v | G.dist root v ≤ i}

/-- A finite graph has a binary slow BFS ball by radius log₂ of its order.
No connectedness is needed for the counting statement: the root gives the
initial nonempty ball and every ball is a subset of the finite vertex set. -/
theorem exists_slow_bfsBall_index_le_log_two
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) :
    ∃ j : ℕ, j ≤ Nat.log 2 (Fintype.card V) ∧
      (bfsBall G root (j + 1)).ncard ≤ 2 * (bfsBall G root j).ncard := by
  have ha0 : 1 ≤ (bfsBall G root 0).ncard := by
    have hne : (bfsBall G root 0).Nonempty := by
      refine ⟨root, ?_⟩
      simp [bfsBall]
    exact hne.ncard_pos
  have hbound : ∀ i : ℕ, (bfsBall G root i).ncard ≤ Fintype.card V := by
    intro i
    simpa using Set.ncard_le_ncard
      (show bfsBall G root i ⊆ Set.univ from Set.subset_univ _)
  exact exists_slow_index_le_log_two
    (fun i => (bfsBall G root i).ncard) (Fintype.card V) ha0 hbound

/-- Variable-base slow-ball form used for polynomial BFS growth factors. -/
theorem exists_slow_bfsBall_index_le_log
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    (b : ℕ) (hb : 2 ≤ b) :
    ∃ j : ℕ, j ≤ Nat.log b (Fintype.card V) ∧
      (bfsBall G root (j + 1)).ncard ≤
        b * (bfsBall G root j).ncard := by
  have ha0 : 1 ≤ (bfsBall G root 0).ncard := by
    have hne : (bfsBall G root 0).Nonempty := by
      refine ⟨root, ?_⟩
      simp [bfsBall]
    exact hne.ncard_pos
  have hbound : ∀ i : ℕ, (bfsBall G root i).ncard ≤ Fintype.card V := by
    intro i
    simpa using Set.ncard_le_ncard
      (show bfsBall G root i ⊆ Set.univ from Set.subset_univ _)
  exact exists_slow_index_le_log
    (fun i => (bfsBall G root i).ncard) b (Fintype.card V) hb ha0 hbound

/-- A finite BFS ball is the disjoint union of its distance layers through
the displayed radius. -/
theorem bfsBall_toFinset_eq_biUnion_bfsLayers
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) (j : ℕ) :
    (bfsBall G root j).toFinset =
      (Finset.range (j + 1)).biUnion
        (fun i => (Erdos752.bfsLayer G root i).toFinset) := by
  classical
  ext v
  simp only [Set.mem_toFinset, Finset.mem_biUnion, Finset.mem_range,
    Set.mem_toFinset, Erdos752.mem_bfsLayer]
  constructor
  · intro hv
    exact ⟨G.dist root v, by simpa [bfsBall] using hv, rfl⟩
  · rintro ⟨i, hi, hdist⟩
    change G.dist root v ≤ j
    omega

/-- Cardinal form of the disjoint BFS-layer decomposition. -/
theorem ncard_bfsBall_eq_sum_ncard_bfsLayer
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) (j : ℕ) :
    (bfsBall G root j).ncard =
      ∑ i ∈ Finset.range (j + 1),
        (Erdos752.bfsLayer G root i).ncard := by
  classical
  rw [Set.ncard_eq_toFinset_card',
    bfsBall_toFinset_eq_biUnion_bfsLayers]
  rw [Finset.card_biUnion]
  · apply Finset.sum_congr rfl
    intro i hi
    simpa using (Set.ncard_eq_toFinset_card
      (Erdos752.bfsLayer G root i)).symm
  · intro i hi l hl hil
    change Disjoint
      (Erdos752.bfsLayer G root i).toFinset
      (Erdos752.bfsLayer G root l).toFinset
    rw [Finset.disjoint_left]
    intro v hvi hvl
    exact Set.disjoint_left.mp (Erdos752.bfsLayer_disjoint hil)
      (Set.mem_toFinset.mp hvi) (Set.mem_toFinset.mp hvl)

/-- Summing all degrees in the BFS ball through level `j` of a connected
bipartite graph counts each earlier slice twice and the last slice once. -/
theorem sum_degrees_bfsBall_eq
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected) (hbip : G.IsBipartite)
    (root : V) (j : ℕ) :
    ∑ i ∈ Finset.range (j + 1),
        ∑ v ∈ Erdos752.bfsLayer G root i, G.degree v =
      2 * (∑ i ∈ Finset.range j,
        (Erdos752.bfsPair G root i).edgeFinset.card) +
      (Erdos752.bfsPair G root j).edgeFinset.card := by
  induction j with
  | zero =>
      simpa using Erdos752.sum_degrees_bfsLayer_zero_eq hconn root
  | succ j ih =>
      rw [Finset.sum_range_succ]
      rw [ih]
      rw [Finset.sum_range_succ]
      rw [Erdos752.sum_degrees_bfsLayer_succ_eq hconn hbip root j]
      ring

/-- Every vertex supporting the slice between levels `i` and `i+1` lies in
the accumulated ball through any later level. -/
theorem bfsPair_support_subset_bfsBall
    {V : Type*} (G : SimpleGraph V) (root : V) {i j : ℕ}
    (hij : i ≤ j) :
    (Erdos752.bfsPair G root i).support ⊆ bfsBall G root (j + 1) := by
  intro v hv
  rcases Erdos752.bfsPair_support_subset hv with hv | hv
  · change G.dist root v ≤ j + 1
    have hdist : G.dist root v = i := hv
    omega
  · change G.dist root v ≤ j + 1
    have hdist : G.dist root v = i + 1 := hv
    omega

/-- The total support size of the first `j+1` consecutive BFS slices is at
most `j+1` times the size of the ball containing all of them.  This coarse
form is sufficient once the growth base is chosen polynomially. -/
theorem sum_ncard_bfsPair_support_le_mul_ncard_bfsBall
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) (j : ℕ) :
    (∑ i ∈ Finset.range (j + 1),
        (Erdos752.bfsPair G root i).support.ncard) ≤
      (j + 1) * (bfsBall G root (j + 1)).ncard := by
  calc
    (∑ i ∈ Finset.range (j + 1),
        (Erdos752.bfsPair G root i).support.ncard) ≤
        ∑ _i ∈ Finset.range (j + 1),
          (bfsBall G root (j + 1)).ncard := by
            apply Finset.sum_le_sum
            intro i hi
            have hij : i ≤ j := by
              exact Nat.le_of_lt_succ (by simpa using Finset.mem_range.mp hi)
            exact Set.ncard_le_ncard (bfsPair_support_subset_bfsBall G root
              hij)
    _ = (j + 1) * (bfsBall G root (j + 1)).ncard := by
      simp

/-- A pointwise lower degree bound gives the corresponding lower bound on
the total degree in an accumulated BFS ball. -/
theorem mul_ncard_bfsBall_le_sum_degrees
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (root : V) (j δ : ℕ)
    (hmin : ∀ v : V, δ ≤ G.degree v) :
    δ * (bfsBall G root j).ncard ≤
      ∑ i ∈ Finset.range (j + 1),
        ∑ v ∈ Erdos752.bfsLayer G root i, G.degree v := by
  rw [ncard_bfsBall_eq_sum_ncard_bfsLayer]
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro i hi
  rw [Set.ncard_eq_toFinset_card']
  calc
    δ * (Erdos752.bfsLayer G root i).toFinset.card =
        ∑ _v ∈ (Erdos752.bfsLayer G root i).toFinset, δ := by
          simp [Nat.mul_comm]
    _ ≤ ∑ v ∈ (Erdos752.bfsLayer G root i).toFinset,
          G.degree v := by
          apply Finset.sum_le_sum
          intro v hv
          exact hmin v

/-- At a slow-growth radius, sufficiently large minimum degree forces one
of the preceding consecutive BFS slices to be dense on its actual support.
The strict degree margin ensures that the selected slice has an edge. -/
theorem exists_dense_bfsPair_at_slow_radius
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected) (hbip : G.IsBipartite)
    (root : V) (j b q δ : ℕ)
    (hslow : (bfsBall G root (j + 1)).ncard ≤
      b * (bfsBall G root j).ncard)
    (hmin : ∀ v : V, δ ≤ G.degree v)
    (hmargin : 2 * (q * b * (j + 1)) < δ) :
    ∃ i : ℕ, i ≤ j ∧
      (Erdos752.bfsPair G root i).edgeFinset.Nonempty ∧
      q * (Erdos752.bfsPair G root i).support.ncard ≤
        (Erdos752.bfsPair G root i).edgeFinset.card := by
  classical
  have hballpos : 0 < (bfsBall G root j).ncard := by
    exact (show (bfsBall G root j).Nonempty from
      ⟨root, by simp [bfsBall]⟩).ncard_pos
  have hsupports :=
    sum_ncard_bfsPair_support_le_mul_ncard_bfsBall G root j
  have hdegree := mul_ncard_bfsBall_le_sum_degrees G root j δ hmin
  rw [sum_degrees_bfsBall_eq G hconn hbip root j] at hdegree
  have hedges :
      δ * (bfsBall G root j).ncard ≤
        2 * (∑ i ∈ Finset.range (j + 1),
          (Erdos752.bfsPair G root i).edgeFinset.card) := by
    calc
      δ * (bfsBall G root j).ncard ≤
          2 * (∑ i ∈ Finset.range j,
            (Erdos752.bfsPair G root i).edgeFinset.card) +
            (Erdos752.bfsPair G root j).edgeFinset.card := hdegree
      _ ≤ 2 * (∑ i ∈ Finset.range (j + 1),
            (Erdos752.bfsPair G root i).edgeFinset.card) := by
        rw [Finset.sum_range_succ]
        omega
  have hstrict :
      ∑ i ∈ Finset.range (j + 1),
          q * (Erdos752.bfsPair G root i).support.ncard <
        ∑ i ∈ Finset.range (j + 1),
          (Erdos752.bfsPair G root i).edgeFinset.card := by
    rw [← Finset.mul_sum]
    have hleft :
        2 * (q * (∑ i ∈ Finset.range (j + 1),
          (Erdos752.bfsPair G root i).support.ncard)) <
          δ * (bfsBall G root j).ncard := by
      calc
        2 * (q * (∑ i ∈ Finset.range (j + 1),
            (Erdos752.bfsPair G root i).support.ncard)) ≤
            2 * (q * ((j + 1) *
              (bfsBall G root (j + 1)).ncard)) := by
          have h := Nat.mul_le_mul_left (2 * q) hsupports
          simpa only [Nat.mul_assoc] using h
        _ ≤ 2 * (q * ((j + 1) *
              (b * (bfsBall G root j).ncard))) := by
          have h := Nat.mul_le_mul_left (2 * q * (j + 1)) hslow
          simpa only [Nat.mul_assoc] using h
        _ < δ * (bfsBall G root j).ncard := by
          have h := Nat.mul_lt_mul_of_pos_right hmargin hballpos
          calc
            2 * (q * ((j + 1) *
                (b * (bfsBall G root j).ncard))) =
                (2 * (q * b * (j + 1))) *
                  (bfsBall G root j).ncard := by ring
            _ < δ * (bfsBall G root j).ncard := h
    omega
  obtain ⟨i, hi, hidense⟩ :=
    Finset.exists_lt_of_sum_lt hstrict
  refine ⟨i, Nat.le_of_lt_succ (by simpa using Finset.mem_range.mp hi),
    ?_, hidense.le⟩
  exact Finset.card_pos.mp (by omega)

/-- Logarithmic stopping-time package for the preceding density lemma.  The
minimum-degree margin is stated using the worst allowed radius, so callers
need not retain the chosen slow index. -/
theorem exists_dense_bfsPair_index_le_log_of_minDegree
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected) (hbip : G.IsBipartite)
    (root : V) (b q δ : ℕ) (hb : 2 ≤ b)
    (hmin : ∀ v : V, δ ≤ G.degree v)
    (hmargin : 2 * (q * b * (Nat.log b (Fintype.card V) + 1)) < δ) :
    ∃ i : ℕ, i ≤ Nat.log b (Fintype.card V) ∧
      (Erdos752.bfsPair G root i).edgeFinset.Nonempty ∧
      q * (Erdos752.bfsPair G root i).support.ncard ≤
        (Erdos752.bfsPair G root i).edgeFinset.card := by
  obtain ⟨j, hj, hslow⟩ := exists_slow_bfsBall_index_le_log G root b hb
  have hjcoeff : q * b * (j + 1) ≤
      q * b * (Nat.log b (Fintype.card V) + 1) := by
    exact Nat.mul_le_mul_left (q * b) (Nat.add_le_add_right hj 1)
  have hjmargin : 2 * (q * b * (j + 1)) < δ := by
    exact (Nat.mul_le_mul_left 2 hjcoeff).trans_lt hmargin
  obtain ⟨i, hij, hE, hdense⟩ :=
    exists_dense_bfsPair_at_slow_radius G hconn hbip root j b q δ
      hslow hmin hjmargin
  exact ⟨i, hij.trans hj, hE, hdense⟩

/-- Vertices in BFS layers whose indices differ by at least two are
anticomplete.  The general distance inequality for an edge allows only
equal or consecutive distances from the root. -/
theorem not_adj_of_mem_bfsLayer_of_add_two_le
    {V : Type*} (G : SimpleGraph V) {root u v : V} {i j : ℕ}
    (hu : u ∈ Erdos752.bfsLayer G root i)
    (hv : v ∈ Erdos752.bfsLayer G root j)
    (hij : i + 2 ≤ j) :
    ¬ G.Adj u v := by
  intro huv
  have hu' : G.dist root u = i := hu
  have hv' : G.dist root v = j := hv
  rcases huv.diff_dist_adj (u := root) with h | h | h
  · omega
  · omega
  · omega

/-- Symmetric version of the previous layer-separation estimate. -/
theorem not_adj_of_mem_bfsLayer_of_le_add_two
    {V : Type*} (G : SimpleGraph V) {root u v : V} {i j : ℕ}
    (hu : u ∈ Erdos752.bfsLayer G root i)
    (hv : v ∈ Erdos752.bfsLayer G root j)
    (hij : j + 2 ≤ i) :
    ¬ G.Adj u v := by
  intro huv
  exact not_adj_of_mem_bfsLayer_of_add_two_le G hv hu hij huv.symm

/-- The finite family of BFS layers through radius j in one parity class.
KLS takes one of the two such families at a slow radius; layers in the same
family are pairwise anticomplete because their indices differ by at least
two. -/
noncomputable def parityBfsLayerFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    (j parity : ℕ) : Finset (Finset V) :=
  ((Finset.range (j + 1)).filter fun i => i % 2 = parity).image
    fun i => (Erdos752.bfsLayer G root i).toFinset

/-- Distinct layers in one BFS parity family have no cross-edge.  This is
the anticomplete-family output used when the slow-ball argument chooses one
parity class. -/
theorem pairwiseAnticomplete_parityBfsLayerFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    (j parity : ℕ) :
    PairwiseAnticomplete G (parityBfsLayerFamily G root j parity) := by
  classical
  intro A hA B hB hAB a ha b hb hab
  rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
  rcases Finset.mem_image.mp hB with ⟨l, hl, rfl⟩
  have hip : i % 2 = parity := (Finset.mem_filter.mp hi).2
  have hlp : l % 2 = parity := (Finset.mem_filter.mp hl).2
  have hil : i ≠ l := by
    intro h
    apply hAB
    subst l
    rfl
  have hsep : i + 2 ≤ l ∨ l + 2 ≤ i := by omega
  have ha' : a ∈ Erdos752.bfsLayer G root i := by simpa using ha
  have hb' : b ∈ Erdos752.bfsLayer G root l := by simpa using hb
  rcases hsep with hsep | hsep
  · exact not_adj_of_mem_bfsLayer_of_add_two_le G ha' hb' hsep hab
  · exact not_adj_of_mem_bfsLayer_of_le_add_two G ha' hb' hsep hab

/-- The vertices covered by one parity family of BFS layers. -/
noncomputable def parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    (j parity : ℕ) : Finset V :=
  (parityBfsLayerFamily G root j parity).biUnion id

/-- Membership in one BFS parity union is exactly the expected bounded
distance and parity condition.  Keeping this elementary conversion named is
useful when a separator envelope is re-induced: shortest paths preserve the
root distance, so parity-core membership transfers without reopening the
finite family bookkeeping. -/
theorem mem_parityBfsLayerUnion_iff
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    (j parity : ℕ) (z : V) :
    z ∈ parityBfsLayerUnion G root j parity ↔
      G.dist root z ≤ j ∧ G.dist root z % 2 = parity := by
  classical
  constructor
  · intro hz
    unfold parityBfsLayerUnion at hz
    rcases Finset.mem_biUnion.mp hz with ⟨A, hA, hzA⟩
    unfold parityBfsLayerFamily at hA
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    have hiz : G.dist root z = i :=
      (Erdos752.mem_bfsLayer).1 (Set.mem_toFinset.mp hzA)
    have hirange : i < j + 1 := Finset.mem_range.mp (Finset.mem_filter.mp hi).1
    exact ⟨by omega, by rw [hiz]; exact (Finset.mem_filter.mp hi).2⟩
  · rintro ⟨hzj, hzpar⟩
    unfold parityBfsLayerUnion
    apply Finset.mem_biUnion.mpr
    refine ⟨(Erdos752.bfsLayer G root (G.dist root z)).toFinset, ?_, ?_⟩
    · unfold parityBfsLayerFamily
      apply Finset.mem_image.mpr
      refine ⟨G.dist root z, ?_, rfl⟩
      exact Finset.mem_filter.mpr ⟨by simp; omega, hzpar⟩
    · apply Set.mem_toFinset.mpr
      exact (Erdos752.mem_bfsLayer).2 rfl

/-- Every vertex in the BFS ball through j lies in exactly one distance
layer and hence in one of the two parity unions.  This is the covering half
of the first-slow-layer decomposition. -/
theorem bfsBall_toFinset_subset_union_parityBfsLayerUnions
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) (j : ℕ) :
    (bfsBall G root j).toFinset ⊆
      parityBfsLayerUnion G root j 0 ∪ parityBfsLayerUnion G root j 1 := by
  classical
  intro v hv
  have hvball : G.dist root v ≤ j := by
    exact (Set.mem_toFinset (s := bfsBall G root j)).mp hv
  let i : ℕ := G.dist root v
  have hirange : i ∈ Finset.range (j + 1) := by
    simp [i]
    omega
  have hilayer : v ∈ Erdos752.bfsLayer G root i := by
    simp [i]
  have hiparity : i % 2 = 0 ∨ i % 2 = 1 := by
    have hlt := Nat.mod_lt i (by omega : 0 < 2)
    omega
  rcases hiparity with hiparity | hiparity
  · apply Finset.mem_union_left
    unfold parityBfsLayerUnion
    apply Finset.mem_biUnion.mpr
    refine ⟨(Erdos752.bfsLayer G root i).toFinset, ?_, ?_⟩
    · unfold parityBfsLayerFamily
      exact Finset.mem_image.mpr
        ⟨i, Finset.mem_filter.mpr ⟨hirange, hiparity⟩, rfl⟩
    · simpa using hilayer
  · apply Finset.mem_union_right
    unfold parityBfsLayerUnion
    apply Finset.mem_biUnion.mpr
    refine ⟨(Erdos752.bfsLayer G root i).toFinset, ?_, ?_⟩
    · unfold parityBfsLayerFamily
      exact Finset.mem_image.mpr
        ⟨i, Finset.mem_filter.mpr ⟨hirange, hiparity⟩, rfl⟩
    · simpa using hilayer

/-- At least one BFS parity union covers half of the slow ball.  Combined
with pairwise anticompleteness above, this is the finite local decomposition
that KLS iterates after deleting a slow ball and its neighbourhood. -/
theorem exists_large_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) (j : ℕ) :
    ∃ parity : Fin 2,
      (bfsBall G root j).ncard ≤
        2 * (parityBfsLayerUnion G root j parity).card := by
  classical
  have hsub := bfsBall_toFinset_subset_union_parityBfsLayerUnions G root j
  have hcard : (bfsBall G root j).toFinset.card ≤
      (parityBfsLayerUnion G root j 0).card +
        (parityBfsLayerUnion G root j 1).card := by
    calc
      (bfsBall G root j).toFinset.card ≤
          (parityBfsLayerUnion G root j 0 ∪
            parityBfsLayerUnion G root j 1).card :=
        Finset.card_le_card hsub
      _ ≤ (parityBfsLayerUnion G root j 0).card +
          (parityBfsLayerUnion G root j 1).card :=
        Finset.card_union_le _ _
  by_cases hzero : (bfsBall G root j).ncard ≤
      2 * (parityBfsLayerUnion G root j 0).card
  · exact ⟨0, by simpa using hzero⟩
  · refine ⟨1, ?_⟩
    have hcard' : (bfsBall G root j).ncard ≤
        (parityBfsLayerUnion G root j 0).card +
          (parityBfsLayerUnion G root j 1).card := by
      rw [Set.ncard_eq_toFinset_card']
      exact hcard
    have hone : (bfsBall G root j).ncard ≤
        2 * (parityBfsLayerUnion G root j 1).card := by
      omega
    simpa using hone

/-- A parity BFS union through radius j is contained in the corresponding
ball.  Together with the preceding coverage lemma this says the selected
anticomplete layers are genuinely localized near the root. -/
theorem parityBfsLayerUnion_subset_bfsBall_toFinset
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    (j parity : ℕ) :
    parityBfsLayerUnion G root j parity ⊆ (bfsBall G root j).toFinset := by
  classical
  intro v hv
  unfold parityBfsLayerUnion at hv
  rcases Finset.mem_biUnion.mp hv with ⟨A, hA, hvA⟩
  unfold parityBfsLayerFamily at hA
  rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
  have hirange : i ∈ Finset.range (j + 1) := (Finset.mem_filter.mp hi).1
  have hvLayer : v ∈ Erdos752.bfsLayer G root i := by simpa using hvA
  apply (Set.mem_toFinset (s := bfsBall G root j)).mpr
  change G.dist root v ≤ j
  have hdist : G.dist root v = i := hvLayer
  simp only [Finset.mem_range] at hirange
  omega

/-- Monotonicity of finite BFS balls with respect to the radius. -/
theorem bfsBall_toFinset_mono
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V)
    {i j : ℕ} (hij : i ≤ j) :
    (bfsBall G root i).toFinset ⊆ (bfsBall G root j).toFinset := by
  intro v hv
  apply (Set.mem_toFinset (s := bfsBall G root j)).mpr
  have hv' : G.dist root v ≤ i :=
    (Set.mem_toFinset (s := bfsBall G root i)).mp hv
  exact hv'.trans hij

/-- A vertex in the ball of radius j has no edge to a vertex outside the
ball of radius j+1.  This is the separator property that makes the retained
parity layers anticomplete to all later extraction steps. -/
theorem not_adj_of_mem_bfsBall_of_not_mem_succ
    {V : Type*} (G : SimpleGraph V) {root a b : V} {j : ℕ}
    (ha : a ∈ bfsBall G root j)
    (hb : b ∉ bfsBall G root (j + 1)) :
    ¬ G.Adj a b := by
  intro hab
  have ha' : G.dist root a ≤ j := ha
  have hb' : j + 1 < G.dist root b := by
    change ¬ G.dist root b ≤ j + 1 at hb
    omega
  rcases hab.diff_dist_adj (u := root) with h | h | h <;> omega

/-- Local first-slow-layer package.  At a radius at most log₂|V| there is a
parity family of pairwise anticomplete BFS layers, localized in that ball,
covering at least half of it; the next ball is at most twice as large.  This
is the checked finite core of KLS's BFS anticomplete-layer decomposition. -/
theorem exists_slow_large_anticomplete_bfs_parity_family
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) :
    ∃ j : ℕ, ∃ parity : Fin 2,
      j ≤ Nat.log 2 (Fintype.card V) ∧
      (bfsBall G root (j + 1)).ncard ≤ 2 * (bfsBall G root j).ncard ∧
      PairwiseAnticomplete G (parityBfsLayerFamily G root j parity) ∧
      parityBfsLayerUnion G root j parity ⊆ (bfsBall G root j).toFinset ∧
      (bfsBall G root j).ncard ≤
        2 * (parityBfsLayerUnion G root j parity).card := by
  obtain ⟨j, hjlog, hslow⟩ := exists_slow_bfsBall_index_le_log_two G root
  obtain ⟨parity, hlarge⟩ := exists_large_parityBfsLayerUnion G root j
  exact ⟨j, parity, hjlog, hslow,
    pairwiseAnticomplete_parityBfsLayerFamily G root j parity,
    parityBfsLayerUnion_subset_bfsBall_toFinset G root j parity, hlarge⟩

/-- One separated BFS extraction step.  The retained core is the large
parity union, the deleted envelope is the next ball, and the core is
anticomplete to every vertex left outside that envelope.  This packages the
local output in exactly the shape consumed by the separator-aware greedy
recursion. -/
theorem exists_slow_bfs_separated_core
    {V : Type*} [Fintype V] (G : SimpleGraph V) (root : V) :
    ∃ j : ℕ, ∃ parity : Fin 2, ∃ H D : Finset V,
      j ≤ Nat.log 2 (Fintype.card V) ∧
      H = parityBfsLayerUnion G root j parity ∧
      D = (bfsBall G root (j + 1)).toFinset ∧
      H ⊆ D ∧ H.Nonempty ∧
      PairwiseAnticomplete G (parityBfsLayerFamily G root j parity) ∧
      (bfsBall G root j).ncard ≤ 2 * H.card ∧
      D.card ≤ 4 * H.card ∧
      ∀ a ∈ H, ∀ b ∈ Finset.univ \ D, ¬ G.Adj a b := by
  obtain ⟨j, parity, hjlog, hslow, hanti, hHball, hlarge⟩ :=
    exists_slow_large_anticomplete_bfs_parity_family G root
  let H : Finset V := parityBfsLayerUnion G root j parity
  let D : Finset V := (bfsBall G root (j + 1)).toFinset
  have hlargeH : (bfsBall G root j).ncard ≤ 2 * H.card := by
    simpa [H] using hlarge
  have hHD : H ⊆ D := by
    exact hHball.trans (bfsBall_toFinset_mono G root (by omega))
  have hballpos : 0 < (bfsBall G root j).ncard := by
    have hne : (bfsBall G root j).Nonempty := by
      refine ⟨root, ?_⟩
      simp [bfsBall]
    exact hne.ncard_pos
  have hHne : H.Nonempty := by
    apply Finset.card_pos.mp
    omega
  refine ⟨j, parity, H, D, hjlog, rfl, rfl, hHD, hHne, hanti, ?_, ?_, ?_⟩
  · exact hlargeH
  · dsimp [D]
    rw [← Set.ncard_eq_toFinset_card']
    omega
  · intro a ha b hb
    have haBallFin : a ∈ (bfsBall G root j).toFinset := hHball ha
    have haBall : a ∈ bfsBall G root j :=
      (Set.mem_toFinset (s := bfsBall G root j)).mp haBallFin
    have hbD : b ∉ D := (Finset.mem_sdiff.mp hb).2
    have hbBall : b ∉ bfsBall G root (j + 1) := by
      intro hbBall
      exact hbD ((Set.mem_toFinset (s := bfsBall G root (j + 1))).mpr hbBall)
    exact not_adj_of_mem_bfsBall_of_not_mem_succ G haBall hbBall

/-- Induced-set version of one BFS separator step.  Running the preceding
construction on the graph induced by S and forgetting the subtype produces
an ambient core H and envelope D with H contained in D contained in S,
while H is anticomplete to the remaining vertices S minus D.  This is the
actual extraction hypothesis needed by the separator-aware greedy recursion. -/
theorem exists_separated_bfs_core_in_finset
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} (hS : S.Nonempty) :
    ∃ H D : Finset V, H ⊆ D ∧ D ⊆ S ∧ H.Nonempty ∧
      D.card ≤ 4 * H.card ∧
      ∀ a ∈ H, ∀ b ∈ S \ D, ¬ G.Adj a b := by
  classical
  let J : SimpleGraph S := G.induce (S : Set V)
  let : Nonempty S := hS.to_subtype
  let : DecidableEq S := Classical.decEq S
  let root : S := Classical.choice inferInstance
  obtain ⟨j, parity, Hs, Ds, _hj, _hHeq, _hDeq, hHDs, hHsne,
      _hpair, _hlarge, hcharge, hanti⟩ :=
    exists_slow_bfs_separated_core J root
  let e : S ↪ V := ⟨Subtype.val, Subtype.val_injective⟩
  let H : Finset V := Hs.map e
  let D : Finset V := Ds.map e
  have hHD : H ⊆ D := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨x, hx, rfl⟩
    exact Finset.mem_map.mpr ⟨x, hHDs hx, rfl⟩
  have hDS : D ⊆ S := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨x, _hx, rfl⟩
    exact x.property
  have hHne : H.Nonempty := by
    obtain ⟨x, hx⟩ := hHsne
    exact ⟨e x, Finset.mem_map.mpr ⟨x, hx, rfl⟩⟩
  have hcharge' : D.card ≤ 4 * H.card := by
    simpa [H, D] using hcharge
  refine ⟨H, D, hHD, hDS, hHne, hcharge', ?_⟩
  intro a ha b hb hab
  rcases Finset.mem_map.mp ha with ⟨a', ha', rfl⟩
  have hbS : b ∈ S := (Finset.mem_sdiff.mp hb).1
  let b' : S := ⟨b, hbS⟩
  have hb'D : b' ∉ Ds := by
    intro hb'D
    apply (Finset.mem_sdiff.mp hb).2
    exact Finset.mem_map.mpr ⟨b', hb'D, rfl⟩
  have hbrem : b' ∈ (Finset.univ : Finset S) \ Ds :=
    Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hb'D⟩
  have hnot : ¬ J.Adj a' b' := hanti a' ha' b' hbrem
  apply hnot
  exact hab

/-- Provenance retained for one induced BFS core.  The set S is the
remaining vertex set at the moment of extraction; the displayed core and
envelope are exactly the images of a parity-layer union and its next slow
ball in the induced graph on S. -/
def IsInducedBfsParityCore
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (H D : Finset V) : Prop :=
  ∃ S : Finset V, ∃ root : S, ∃ j : ℕ, ∃ parity : Fin 2,
    j ≤ Nat.log 2 (Fintype.card S) ∧
    H = (parityBfsLayerUnion (G.induce (S : Set V)) root j parity).map
      ⟨Subtype.val, Subtype.val_injective⟩ ∧
    D = ((bfsBall (G.induce (S : Set V)) root (j + 1)).toFinset).map
      ⟨Subtype.val, Subtype.val_injective⟩

/-- Connected-component provenance for the corrected second BFS step.
The first global extraction may leave several components in one distance
zero layer; the KLS refinement runs the next slow-ball argument inside one
connected component.  This witness records that connected graph before both
subtype inclusions are forgotten. -/
def IsComponentBfsParityCore
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (H D : Finset V) : Prop :=
  ∃ S : Finset V,
    ∃ c : (G.induce (S : Set V)).ConnectedComponent,
    ∃ root : c, ∃ j : ℕ, ∃ parity : Fin 2,
      j ≤ Nat.log 2 (Fintype.card c) ∧
      H = (parityBfsLayerUnion c.toSimpleGraph root j parity).map
        ⟨fun x => x.1.1, by
          intro x y hxy
          exact Subtype.ext (Subtype.ext hxy)⟩ ∧
      D = ((bfsBall c.toSimpleGraph root (j + 1)).toFinset).map
        ⟨fun x => x.1.1, by
          intro x y hxy
          exact Subtype.ext (Subtype.ext hxy)⟩

/-- The induced separator step with its BFS provenance retained.  This is
the version needed when a later path in the selected core must be localized
back to one actual layer and closed through the two root paths. -/
theorem exists_separated_bfs_core_in_finset_with_witness
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} (hS : S.Nonempty) :
    ∃ H D : Finset V, H ⊆ D ∧ D ⊆ S ∧ H.Nonempty ∧
      D.card ≤ 4 * H.card ∧ IsInducedBfsParityCore G H D ∧
      ∀ a ∈ H, ∀ b ∈ S \ D, ¬ G.Adj a b := by
  classical
  let J : SimpleGraph S := G.induce (S : Set V)
  let : Nonempty S := hS.to_subtype
  let : DecidableEq S := Classical.decEq S
  let root : S := Classical.choice inferInstance
  obtain ⟨j, parity, Hs, Ds, hj, hHeq, hDeq, hHDs, hHsne,
      _hpair, _hlarge, hcharge, hanti⟩ :=
    exists_slow_bfs_separated_core J root
  let e : S ↪ V := ⟨Subtype.val, Subtype.val_injective⟩
  let H : Finset V := Hs.map e
  let D : Finset V := Ds.map e
  have hHD : H ⊆ D := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨x, hx, rfl⟩
    exact Finset.mem_map.mpr ⟨x, hHDs hx, rfl⟩
  have hDS : D ⊆ S := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨x, _hx, rfl⟩
    exact x.property
  have hHne : H.Nonempty := by
    obtain ⟨x, hx⟩ := hHsne
    exact ⟨e x, Finset.mem_map.mpr ⟨x, hx, rfl⟩⟩
  have hcharge' : D.card ≤ 4 * H.card := by
    simpa [H, D] using hcharge
  have hwitness : IsInducedBfsParityCore G H D := by
    refine ⟨S, root, j, parity, hj, ?_, ?_⟩
    · subst Hs
      rfl
    · subst Ds
      rfl
  refine ⟨H, D, hHD, hDS, hHne, hcharge', hwitness, ?_⟩
  intro a ha b hb hab
  rcases Finset.mem_map.mp ha with ⟨a', ha', rfl⟩
  have hbS : b ∈ S := (Finset.mem_sdiff.mp hb).1
  let b' : S := ⟨b, hbS⟩
  have hb'D : b' ∉ Ds := by
    intro hb'D
    apply (Finset.mem_sdiff.mp hb).2
    exact Finset.mem_map.mpr ⟨b', hb'D, rfl⟩
  have hbrem : b' ∈ (Finset.univ : Finset S) \ Ds :=
    Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hb'D⟩
  have hnot : ¬ J.Adj a' b' := hanti a' ha' b' hbrem
  apply hnot
  exact hab

/-- Corrected induced separator step for the second BFS pass.  It first
chooses one connected component of the remaining induced graph and only then
runs the slow-ball extraction.  Hence the recorded provenance has a genuinely
connected ambient graph, while anticompleteness to the rest of the remaining
set follows either from the BFS envelope or from component separation. -/
theorem exists_separated_component_bfs_core_in_finset_with_witness
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} (hS : S.Nonempty) :
    ∃ H D : Finset V, H ⊆ D ∧ D ⊆ S ∧ H.Nonempty ∧
      D.card ≤ 4 * H.card ∧ IsComponentBfsParityCore G H D ∧
      ∀ a ∈ H, ∀ b ∈ S \ D, ¬ G.Adj a b := by
  classical
  let J : SimpleGraph S := G.induce (S : Set V)
  let : Nonempty S := hS.to_subtype
  let rootS : S := Classical.choice inferInstance
  let c : J.ConnectedComponent := J.connectedComponentMk rootS
  let K : SimpleGraph c := c.toSimpleGraph
  let : Nonempty c := c.nonempty_supp.to_subtype
  let : DecidableRel K.Adj := Classical.decRel _
  let root : c :=
    ⟨rootS, SimpleGraph.ConnectedComponent.connectedComponentMk_mem⟩
  obtain ⟨j, parity, Hc, Dc, hj, hHeq, hDeq, hHDc, hHcne,
      _hpair, _hlarge, hcharge, hanti⟩ :=
    exists_slow_bfs_separated_core K root
  let e : c ↪ V :=
    ⟨fun x => x.1.1, by
      intro x y hxy
      exact Subtype.ext (Subtype.ext hxy)⟩
  let H : Finset V := Hc.map e
  let D : Finset V := Dc.map e
  have hHD : H ⊆ D := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨x, hx, rfl⟩
    exact Finset.mem_map.mpr ⟨x, hHDc hx, rfl⟩
  have hDS : D ⊆ S := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨x, _hx, rfl⟩
    exact x.1.property
  have hHne : H.Nonempty := by
    obtain ⟨x, hx⟩ := hHcne
    exact ⟨e x, Finset.mem_map.mpr ⟨x, hx, rfl⟩⟩
  have hcharge' : D.card ≤ 4 * H.card := by
    simpa [H, D] using hcharge
  have hwitness : IsComponentBfsParityCore G H D := by
    refine ⟨S, c, root, j, parity, hj, ?_, ?_⟩
    · simpa [H, e, K] using
        congrArg (fun T : Finset c => T.map e) hHeq
    · simpa [D, e, K] using
        congrArg (fun T : Finset c => T.map e) hDeq
  refine ⟨H, D, hHD, hDS, hHne, hcharge', hwitness, ?_⟩
  intro a ha b hb hab
  rcases Finset.mem_map.mp ha with ⟨a', ha', rfl⟩
  have hbS : b ∈ S := (Finset.mem_sdiff.mp hb).1
  let bS : S := ⟨b, hbS⟩
  have habJ : J.Adj a'.1 bS := by
    exact hab
  by_cases hbC : bS ∈ c.supp
  · let b' : c := ⟨bS, hbC⟩
    have hb'D : b' ∉ Dc := by
      intro hb'D
      apply (Finset.mem_sdiff.mp hb).2
      exact Finset.mem_map.mpr ⟨b', hb'D, rfl⟩
    have hnot : ¬ K.Adj a' b' := by
      apply hanti a' ha' b'
      simpa only [Finset.mem_sdiff, Finset.mem_univ, true_and] using hb'D
    apply hnot
    exact hab
  · apply hbC
    exact (c.mem_supp_congr_adj habJ).mp a'.property

/-- Iterating the first-slow-ball extraction over the whole finite vertex
set gives a global anticomplete BFS decomposition.  The deleted envelopes
are disjoint and cover every vertex, and the local factor-four charge
therefore survives summation.  This is the quantitative bookkeeping bridge
between the local BFS lemma and the later density/DRC argument. -/
theorem exists_global_separated_bfs_core_family
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∃ F : Finset (Finset V × Finset V),
      (∀ q ∈ F, q.1 ⊆ q.2 ∧ q.1.Nonempty ∧
        q.2.card ≤ 4 * q.1.card) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r →
        ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b) ∧
      F.biUnion (fun q => q.2) = Finset.univ ∧
      Fintype.card V ≤ 4 * ∑ q ∈ F, q.1.card := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunionSub, hrem⟩ :=
    exists_separated_extraction_family_covering_up_to G
      (fun H D => D.card ≤ 4 * H.card) 1 (by
        intro S hS
        have hSne : S.Nonempty := Finset.card_pos.mp (by omega)
        exact exists_separated_bfs_core_in_finset G hSne) Finset.univ
  have hremEmpty : Finset.univ \ F.biUnion (fun q => q.2) = ∅ := by
    apply Finset.card_eq_zero.mp
    omega
  have hunion : F.biUnion (fun q => q.2) = Finset.univ := by
    apply Finset.Subset.antisymm hunionSub
    intro v _hv
    by_contra hv
    have hvrem : v ∈ Finset.univ \ F.biUnion (fun q => q.2) := by
      exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hv⟩
    rw [hremEmpty] at hvrem
    simpa using hvrem
  have henvPD : (F : Set (Finset V × Finset V)).PairwiseDisjoint
      (fun q => q.2) := by
    intro q hq r hr hqr
    exact hdisj q (by simpa using hq) r (by simpa using hr) hqr
  have hsum : ∑ q ∈ F, q.2.card ≤ ∑ q ∈ F, 4 * q.1.card := by
    apply Finset.sum_le_sum
    intro q hq
    exact (hcore q hq).2.2
  refine ⟨F, hcore, hdisj, hanti, hunion, ?_⟩
  calc
    Fintype.card V = (Finset.univ : Finset V).card := by simp
    _ = (F.biUnion (fun q => q.2)).card := by rw [hunion]
    _ = ∑ q ∈ F, q.2.card := Finset.card_biUnion henvPD
    _ ≤ ∑ q ∈ F, 4 * q.1.card := hsum
    _ = 4 * ∑ q ∈ F, q.1.card := by rw [Finset.mul_sum]

/-- Provenance-preserving global BFS separator decomposition.  This is the
same factor-four recursion as the preceding theorem, but each retained core
remembers the induced remaining graph, root, slow radius, and parity union
from which it came.  Later path and cycle arguments can therefore map a
selected core back to one concrete BFS layer. -/
theorem exists_global_separated_bfs_core_family_with_witness
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∃ F : Finset (Finset V × Finset V),
      (∀ q ∈ F, q.1 ⊆ q.2 ∧ q.1.Nonempty ∧
        q.2.card ≤ 4 * q.1.card ∧
        IsInducedBfsParityCore G q.1 q.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r →
        ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b) ∧
      F.biUnion (fun q => q.2) = Finset.univ ∧
      Fintype.card V ≤ 4 * ∑ q ∈ F, q.1.card := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunionSub, hrem⟩ :=
    exists_separated_extraction_family_covering_up_to G
      (fun H D => D.card ≤ 4 * H.card ∧ IsInducedBfsParityCore G H D) 1 (by
        intro S hS
        have hSne : S.Nonempty := Finset.card_pos.mp (by omega)
        obtain ⟨H, D, hHD, hDS, hHne, hcharge, hwit, hanti⟩ :=
          exists_separated_bfs_core_in_finset_with_witness G hSne
        exact ⟨H, D, hHD, hDS, hHne, ⟨hcharge, hwit⟩, hanti⟩) Finset.univ
  have hremEmpty : Finset.univ \ F.biUnion (fun q => q.2) = ∅ := by
    apply Finset.card_eq_zero.mp
    omega
  have hunion : F.biUnion (fun q => q.2) = Finset.univ := by
    apply Finset.Subset.antisymm hunionSub
    intro v _hv
    by_contra hv
    have hvrem : v ∈ Finset.univ \ F.biUnion (fun q => q.2) := by
      exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hv⟩
    rw [hremEmpty] at hvrem
    simpa using hvrem
  have henvPD : (F : Set (Finset V × Finset V)).PairwiseDisjoint
      (fun q => q.2) := by
    intro q hq r hr hqr
    exact hdisj q (by simpa using hq) r (by simpa using hr) hqr
  have hsum : ∑ q ∈ F, q.2.card ≤ ∑ q ∈ F, 4 * q.1.card := by
    apply Finset.sum_le_sum
    intro q hq
    exact (hcore q hq).2.2.1
  refine ⟨F, hcore, hdisj, hanti, hunion, ?_⟩
  calc
    Fintype.card V = (Finset.univ : Finset V).card := by simp
    _ = (F.biUnion (fun q => q.2)).card := by rw [hunion]
    _ = ∑ q ∈ F, q.2.card := Finset.card_biUnion henvPD
    _ ≤ ∑ q ∈ F, 4 * q.1.card := hsum
    _ = 4 * ∑ q ∈ F, q.1.card := by rw [Finset.mul_sum]

/-- Global separator recursion using the corrected connected-component BFS
step.  Each retained core now has provenance in a connected graph, so every
later path in a selected core can use the checked connected map-back lemma. -/
theorem exists_global_separated_component_bfs_core_family_with_witness
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∃ F : Finset (Finset V × Finset V),
      (∀ q ∈ F, q.1 ⊆ q.2 ∧ q.1.Nonempty ∧
        q.2.card ≤ 4 * q.1.card ∧
        IsComponentBfsParityCore G q.1 q.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r →
        ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b) ∧
      F.biUnion (fun q => q.2) = Finset.univ ∧
      Fintype.card V ≤ 4 * ∑ q ∈ F, q.1.card := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunionSub, hrem⟩ :=
    exists_separated_extraction_family_covering_up_to G
      (fun H D => D.card ≤ 4 * H.card ∧ IsComponentBfsParityCore G H D) 1 (by
        intro S hS
        have hSne : S.Nonempty := Finset.card_pos.mp (by omega)
        obtain ⟨H, D, hHD, hDS, hHne, hcharge, hwit, hanti⟩ :=
          exists_separated_component_bfs_core_in_finset_with_witness G hSne
        exact ⟨H, D, hHD, hDS, hHne, ⟨hcharge, hwit⟩, hanti⟩)
      Finset.univ
  have hremEmpty : Finset.univ \ F.biUnion (fun q => q.2) = ∅ := by
    apply Finset.card_eq_zero.mp
    omega
  have hunion : F.biUnion (fun q => q.2) = Finset.univ := by
    apply Finset.Subset.antisymm hunionSub
    intro v _hv
    by_contra hv
    have hvrem : v ∈ Finset.univ \ F.biUnion (fun q => q.2) := by
      exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hv⟩
    rw [hremEmpty] at hvrem
    simpa using hvrem
  have henvPD : (F : Set (Finset V × Finset V)).PairwiseDisjoint
      (fun q => q.2) := by
    intro q hq r hr hqr
    exact hdisj q (by simpa using hq) r (by simpa using hr) hqr
  have hsum : ∑ q ∈ F, q.2.card ≤ ∑ q ∈ F, 4 * q.1.card := by
    apply Finset.sum_le_sum
    intro q hq
    exact (hcore q hq).2.2.1
  refine ⟨F, hcore, hdisj, hanti, hunion, ?_⟩
  calc
    Fintype.card V = (Finset.univ : Finset V).card := by simp
    _ = (F.biUnion (fun q => q.2)).card := by rw [hunion]
    _ = ∑ q ∈ F, q.2.card := Finset.card_biUnion henvPD
    _ ≤ ∑ q ∈ F, 4 * q.1.card := hsum
    _ = 4 * ∑ q ∈ F, q.1.card := by rw [Finset.mul_sum]

/-- Relative form of the connected-component BFS separator recursion.  The
global theorem above starts from all vertices; KLS immediately runs the
same recursion a second time inside the union of the first retained cores.
This version starts from an arbitrary finite set, keeps every envelope
inside that set, and retains the same factor-four charge and component BFS
provenance. -/
theorem exists_separated_component_bfs_core_family_in_finset_with_witness
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) :
    ∃ F : Finset (Finset V × Finset V),
      (∀ q ∈ F, q.1 ⊆ q.2 ∧ q.2 ⊆ S ∧ q.1.Nonempty ∧
        q.2.card ≤ 4 * q.1.card ∧
        IsComponentBfsParityCore G q.1 q.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2) ∧
      (∀ q ∈ F, ∀ r ∈ F, q ≠ r →
        ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b) ∧
      F.biUnion (fun q => q.2) = S ∧
      S.card ≤ 4 * ∑ q ∈ F, q.1.card := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunionSub, hrem⟩ :=
    exists_separated_extraction_family_covering_up_to G
      (fun H D => D.card ≤ 4 * H.card ∧ IsComponentBfsParityCore G H D) 1 (by
        intro T hT
        have hTne : T.Nonempty := Finset.card_pos.mp (by omega)
        obtain ⟨H, D, hHD, hDT, hHne, hcharge, hwit, hanti⟩ :=
          exists_separated_component_bfs_core_in_finset_with_witness G hTne
        exact ⟨H, D, hHD, hDT, hHne, ⟨hcharge, hwit⟩, hanti⟩)
      S
  have hremEmpty : S \ F.biUnion (fun q => q.2) = ∅ := by
    apply Finset.card_eq_zero.mp
    omega
  have hunion : F.biUnion (fun q => q.2) = S := by
    apply Finset.Subset.antisymm hunionSub
    intro v hv
    by_contra hvU
    have hvrem : v ∈ S \ F.biUnion (fun q => q.2) :=
      Finset.mem_sdiff.mpr ⟨hv, hvU⟩
    rw [hremEmpty] at hvrem
    simpa using hvrem
  have henvPD : (F : Set (Finset V × Finset V)).PairwiseDisjoint
      (fun q => q.2) := by
    intro q hq r hr hqr
    exact hdisj q (by simpa using hq) r (by simpa using hr) hqr
  have hsum : ∑ q ∈ F, q.2.card ≤ ∑ q ∈ F, 4 * q.1.card := by
    apply Finset.sum_le_sum
    intro q hq
    exact (hcore q hq).2.2.1
  refine ⟨F, ?_, hdisj, hanti, hunion, ?_⟩
  · intro q hq
    have hqS : q.2 ⊆ S := by
      intro v hv
      exact hunionSub (Finset.mem_biUnion.mpr ⟨q, hq, hv⟩)
    exact ⟨(hcore q hq).1, hqS, (hcore q hq).2.1,
      (hcore q hq).2.2.1, (hcore q hq).2.2.2⟩
  · calc
      S.card = (F.biUnion (fun q => q.2)).card := by rw [hunion]
      _ = ∑ q ∈ F, q.2.card := Finset.card_biUnion henvPD
      _ ≤ ∑ q ∈ F, 4 * q.1.card := hsum
      _ = 4 * ∑ q ∈ F, q.1.card := by rw [Finset.mul_sum]

/-- At the Ramsey extremal order, the global BFS decomposition contains a
core on the linear `k/4` scale.  The proof is the clean counting point of
the fixed-base simplification: one representative from each anticomplete
core is independent, so there are at most `n-1` cores; if every core had
`4|H| ≤ k-1`, the factor-four envelope charge would cover at most
`(k-1)(n-1)` vertices, missing the final plus one. -/
theorem exists_large_global_bfs_core_at_extremal_order
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1) :
    ∃ F : Finset (Finset V × Finset V), ∃ q ∈ F,
      (∀ r ∈ F, r.1 ⊆ r.2 ∧ r.1.Nonempty ∧
        r.2.card ≤ 4 * r.1.card) ∧
      (∀ r ∈ F, ∀ s ∈ F, r ≠ s → Disjoint r.2 s.2) ∧
      (∀ r ∈ F, ∀ s ∈ F, r ≠ s →
        ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b) ∧
      F.biUnion (fun r => r.2) = Finset.univ ∧
      k ≤ 4 * q.1.card := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunion, hcharge⟩ :=
    exists_global_separated_bfs_core_family G
  let pick : Finset V × Finset V → V := fun q =>
    if hq : q ∈ F then (hcore q hq).2.1.choose else Classical.choice inferInstance
  have hpick : ∀ q ∈ F, pick q ∈ q.1 := by
    intro q hq
    simp only [pick, dif_pos hq]
    exact (hcore q hq).2.1.choose_spec
  have hpick_inj : Set.InjOn pick (F : Set (Finset V × Finset V)) := by
    intro q hq r hr hqrPick
    by_contra hqr
    have henvDisj : Disjoint q.2 r.2 :=
      hdisj q (by simpa using hq) r (by simpa using hr) hqr
    have hqmem : pick q ∈ q.2 := (hcore q (by simpa using hq)).1
      (hpick q (by simpa using hq))
    have hrmem : pick r ∈ r.2 := (hcore r (by simpa using hr)).1
      (hpick r (by simpa using hr))
    exact Finset.disjoint_left.mp henvDisj hqmem (hqrPick ▸ hrmem)
  let reps : Finset V := F.image pick
  have hrepscard : reps.card = F.card :=
    Finset.card_image_of_injOn hpick_inj
  have hrepsind : G.IsIndepSet (reps : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_image.mp ha with ⟨q, hq, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨r, hr, rfl⟩
    by_cases hqr : q = r
    · subst r
      exact (hab rfl).elim
    · exact hanti q hq r hr hqr (pick q) (hpick q hq)
        (pick r) (hpick r hr)
  have hFlt : F.card < n := by
    rw [← hrepscard]
    exact Erdos551.IndepSetFree.card_lt hfree hrepsind
  by_contra hno
  push_neg at hno
  have hsmall : ∀ r ∈ F, 4 * r.1.card ≤ k - 1 := by
    intro r hr
    have hrsmall := hno F r hr hcore hdisj hanti hunion
    omega
  have hsumSmall : 4 * ∑ r ∈ F, r.1.card ≤ F.card * (k - 1) := by
    calc
      4 * ∑ r ∈ F, r.1.card = ∑ r ∈ F, 4 * r.1.card := by
        rw [Finset.mul_sum]
      _ ≤ ∑ _r ∈ F, (k - 1) := by
        gcongr with r hr
        exact hsmall r hr
      _ = F.card * (k - 1) := by simp
  have hFle : F.card ≤ n - 1 := by omega
  have htooSmall : Fintype.card V ≤ (k - 1) * (n - 1) := by
    calc
      Fintype.card V ≤ 4 * ∑ r ∈ F, r.1.card := hcharge
      _ ≤ F.card * (k - 1) := hsumSmall
      _ ≤ (n - 1) * (k - 1) := Nat.mul_le_mul_right _ hFle
      _ = (k - 1) * (n - 1) := Nat.mul_comm _ _
  rw [horder] at htooSmall
  omega

/-! ## Edge bookkeeping for anticomplete BFS pieces -/

/-- Ambient edges with both endpoints in a finite vertex set.  Keeping this
as a finset of ambient unordered pairs avoids repeated subtype transports
when a BFS decomposition is used to sum induced edge counts. -/
noncomputable def inducedEdgeFinsetOn {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (S : Finset V) : Finset (Sym2 V) :=
  G.edgeFinset ∩ S.sym2

/-- The ambient degree sum inside a finite set is twice the number of
ambient edges with both endpoints in that set.  This is the finite
handshaking identity in the representation used by the BFS bookkeeping. -/
theorem sum_degreeIn_eq_twice_card_inducedEdgeFinsetOn
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) :
    ∑ v ∈ S, degreeIn G S v = 2 * (inducedEdgeFinsetOn G S).card := by
  classical
  have hsum := (G.induce (S : Set V)).sum_degrees_eq_twice_card_edges
  have hleft : (∑ x : S, (G.induce (S : Set V)).degree x) =
      ∑ v ∈ S, degreeIn G S v := by
    simp_rw [degree_induce_finset_eq_degreeIn]
    simp only [Finset.univ_eq_attach, Finset.sum_attach]
  have hedge :
      (G.induce (S : Set V)).edgeFinset.card =
        (inducedEdgeFinsetOn G S).card := by
    have hmap :
        (G.induce (S : Set V)).edgeFinset.map
          (Function.Embedding.subtype (· ∈ (S : Set V))).sym2Map =
          G.edgeFinset ∩ S.sym2 := by
      aesop (add simp [Finset.ext_iff, Sym2.exists, Sym2.forall, adj_comm])
    unfold inducedEdgeFinsetOn
    rw [← hmap]
    simp
  rw [← hleft, ← hedge]
  exact hsum

/-- Set-indexed companion of `inducedEdgeFinsetOn`; its subtype fintype is
the same one used by `SimpleGraph.map_edgeFinset_induce`, so it is the clean
transport interface back to ordinary induced-graph edge counts. -/
noncomputable def inducedEdgeFinsetOnSet {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (S : Set V) [Finite S] :
    Finset (Sym2 V) :=
  G.edgeFinset ∩ S.toFinset.sym2

/-- Ambient inside edges and subtype-induced edges have equal cardinality. -/
theorem card_inducedEdgeFinsetOnSet_eq_card_induce
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Set V) [Finite S] :
    (inducedEdgeFinsetOnSet G S).card = (G.induce S).edgeFinset.card := by
  classical
  rw [inducedEdgeFinsetOnSet, ← SimpleGraph.map_edgeFinset_induce]
  simp

/-- Finset-indexed specialization of the induced-edge transport identity. -/
theorem card_inducedEdgeFinsetOn_eq_card_induce_finset
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) :
    (inducedEdgeFinsetOn G S).card =
      (G.induce (S : Set V)).edgeFinset.card := by
  classical
  have hmap :
      (G.induce (S : Set V)).edgeFinset.map
        (Function.Embedding.subtype (· ∈ (S : Set V))).sym2Map =
        G.edgeFinset ∩ S.sym2 := by
    aesop (add simp [Finset.ext_iff, Sym2.exists, Sym2.forall, adj_comm])
  unfold inducedEdgeFinsetOn
  rw [← hmap]
  simp

/-- Set-indexed Turán density, stated in ambient-edge form.  This avoids
any dependence on a particular finite enumeration of the subtype while
remaining equivalent to the usual induced-graph average-degree bound. -/
theorem avg_degree_induce_set_ge_of_indepSetFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Set V} [Finite S] {n d : ℕ} (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hsize : (n - 1) * (d + 1) ≤ S.ncard) :
    d * S.ncard ≤ 2 * (inducedEdgeFinsetOnSet G S).card := by
  classical
  have hfreeS : (G.induce S).IndepSetFree n :=
    SimpleGraph.IndepSetFree.comap
      (SimpleGraph.Embedding.induce (G := G) S) hfree
  have havg : d * Fintype.card S ≤
      2 * (G.induce S).edgeFinset.card := by
    apply avg_degree_ge_of_indepSetFree (G.induce S) hn hfreeS
    rw [Set.fintypeCard_eq_ncard]
    exact hsize
  have hedge := card_inducedEdgeFinsetOnSet_eq_card_induce G S
  calc
    d * S.ncard = d * Fintype.card S := by rw [Set.fintypeCard_eq_ncard]
    _ ≤ 2 * (G.induce S).edgeFinset.card := havg
    _ = 2 * (inducedEdgeFinsetOnSet G S).card := by rw [hedge]

/-- In a disjoint anticomplete family, every edge induced by the union lies
in one unique member.  This is the exact finite edge-partition fact needed
to average Turán density over the BFS pieces. -/
theorem inducedEdgeFinsetOn_biUnion_eq_biUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)}
    (hdisj : DisjointFinsetFamily F) (hanti : PairwiseAnticomplete G F) :
    inducedEdgeFinsetOn G (F.biUnion id) =
      F.biUnion (fun A => inducedEdgeFinsetOn G A) := by
  classical
  ext e
  induction e using Sym2.inductionOn with
  | _ a b =>
      constructor
      · intro he
        have he' : G.Adj a b ∧ a ∈ F.biUnion id ∧ b ∈ F.biUnion id := by
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using he
        rcases Finset.mem_biUnion.mp he'.2.1 with ⟨A, hA, haA⟩
        rcases Finset.mem_biUnion.mp he'.2.2 with ⟨B, hB, hbB⟩
        by_cases hAB : A = B
        · subst B
          apply Finset.mem_biUnion.mpr
          refine ⟨A, hA, ?_⟩
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using
            And.intro he'.1 ⟨haA, hbB⟩
        · exact (hanti A hA B hB hAB a haA b hbB he'.1).elim
      · intro he
        rcases Finset.mem_biUnion.mp he with ⟨A, hA, heA⟩
        have heA' : G.Adj a b ∧ a ∈ A ∧ b ∈ A := by
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using heA
        have haU : a ∈ F.biUnion id :=
          Finset.mem_biUnion.mpr ⟨A, hA, heA'.2.1⟩
        have hbU : b ∈ F.biUnion id :=
          Finset.mem_biUnion.mpr ⟨A, hA, heA'.2.2⟩
        have haU' : ∃ C ∈ F, a ∈ C := Finset.mem_biUnion.mp haU
        have hbU' : ∃ C ∈ F, b ∈ C := Finset.mem_biUnion.mp hbU
        simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using
          And.intro heA'.1 ⟨haU', hbU'⟩

/-- Consequently induced edge counts add exactly across a disjoint
anticomplete partition.  The equality is stated with ambient inside-edge
finsets on the right so it can be combined directly with a weighted
averaging inequality. -/
theorem card_inducedEdgeFinsetOn_biUnion_eq_sum
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)}
    (hdisj : DisjointFinsetFamily F) (hanti : PairwiseAnticomplete G F) :
    (inducedEdgeFinsetOn G (F.biUnion id)).card =
      ∑ A ∈ F, (inducedEdgeFinsetOn G A).card := by
  classical
  have hpair : (F : Set (Finset V)).PairwiseDisjoint
      (fun A => inducedEdgeFinsetOn G A) := by
    intro A hA B hB hAB
    change Disjoint (inducedEdgeFinsetOn G A) (inducedEdgeFinsetOn G B)
    rw [Finset.disjoint_left]
    intro e heA heB
    induction e using Sym2.inductionOn with
    | _ a b =>
        have heA' : G.Adj a b ∧ a ∈ A ∧ b ∈ A := by
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using heA
        have heB' : G.Adj a b ∧ a ∈ B ∧ b ∈ B := by
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using heB
        exact Finset.disjoint_left.mp (hdisj A (by simpa using hA)
          B (by simpa using hB) hAB) heA'.2.1 heB'.2.1
  rw [inducedEdgeFinsetOn_biUnion_eq_biUnion G hdisj hanti,
    Finset.card_biUnion hpair]

/-- Weighted averaging across an anticomplete BFS family: if the union has
average degree at least `d`, then one member already has average degree at
least `d`.  The proof uses the exact edge partition above, not a lossy union
bound, so it is suitable for the two-stage KLS dense extraction. -/
theorem exists_dense_member_of_anticomplete_family
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {d : ℕ} (hF : F.Nonempty)
    (hdisj : DisjointFinsetFamily F) (hanti : PairwiseAnticomplete G F)
    (hdense : d * (F.biUnion id).card ≤
      2 * (inducedEdgeFinsetOn G (F.biUnion id)).card) :
    ∃ A ∈ F, d * A.card ≤ 2 * (inducedEdgeFinsetOn G A).card := by
  classical
  have hpair : (F : Set (Finset V)).PairwiseDisjoint id := by
    intro A hA B hB hAB
    change Disjoint A B
    exact hdisj A (by simpa using hA) B (by simpa using hB) hAB
  have hcard : (F.biUnion id).card = ∑ A ∈ F, A.card :=
    Finset.card_biUnion hpair
  have hedge := card_inducedEdgeFinsetOn_biUnion_eq_sum G hdisj hanti
  by_contra hno
  push_neg at hno
  have hstrict : ∑ A ∈ F, 2 * (inducedEdgeFinsetOn G A).card <
      ∑ A ∈ F, d * A.card := by
    apply Finset.sum_lt_sum_of_nonempty hF
    intro A hA
    exact hno A hA
  have hsumDense : d * ∑ A ∈ F, A.card ≤
      2 * ∑ A ∈ F, (inducedEdgeFinsetOn G A).card := by
    simpa [hcard, hedge] using hdense
  have hstrict' : 2 * ∑ A ∈ F, (inducedEdgeFinsetOn G A).card <
      d * ∑ A ∈ F, A.card := by
    simpa [Finset.mul_sum] using hstrict
  omega

/-- Turán density survives the anticomplete BFS partition in one member.
If the covered union is large enough compared with the forbidden
independent-set size, the induced graph on the union has average degree
`d`; exact edge additivity then yields one BFS piece with the same average
degree.  This is the verified density handoff used before the small-subgraph
and DRC steps. -/
theorem exists_dense_member_of_indepSetFree_anticomplete_family
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {n d : ℕ} (hF : F.Nonempty)
    (hdisj : DisjointFinsetFamily F) (hanti : PairwiseAnticomplete G F)
    (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : (n - 1) * (d + 1) ≤ (F.biUnion id).card) :
    ∃ A ∈ F, d * A.card ≤ 2 * (inducedEdgeFinsetOn G A).card := by
  classical
  let S : Set V := (F.biUnion id : Finset V)
  have hSncard : S.ncard = (F.biUnion id).card := by
    change ((F.biUnion id : Finset V) : Set V).ncard = (F.biUnion id).card
    exact Set.ncard_coe_finset _
  have hsizeS : (n - 1) * (d + 1) ≤ S.ncard := by
    rw [hSncard]
    exact hsize
  have hdenseS := avg_degree_induce_set_ge_of_indepSetFree G hn hfree hsizeS
  have hinside : inducedEdgeFinsetOnSet G S =
      inducedEdgeFinsetOn G (F.biUnion id) := by
    unfold inducedEdgeFinsetOnSet inducedEdgeFinsetOn
    congr 2
    ext v
    simp [S]
  have hdense : d * (F.biUnion id).card ≤
      2 * (inducedEdgeFinsetOn G (F.biUnion id)).card := by
    calc
      d * (F.biUnion id).card = d * S.ncard := by rw [hSncard]
      _ ≤ 2 * (inducedEdgeFinsetOnSet G S).card := hdenseS
      _ = 2 * (inducedEdgeFinsetOn G (F.biUnion id)).card := by rw [hinside]
  exact exists_dense_member_of_anticomplete_family G hF hdisj hanti hdense

/-- Exact edge additivity in the pair-indexed form produced by the global
BFS separator recursion.  The first coordinate is the retained core and the
second is its disjoint envelope; disjoint envelopes make the cores disjoint,
while the recorded anticompleteness prevents cross-edges. -/
theorem card_inducedEdgeFinsetOn_core_biUnion_eq_sum
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V × Finset V)}
    (hcore : ∀ q ∈ F, q.1 ⊆ q.2)
    (hdisj : ∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2)
    (hanti : ∀ q ∈ F, ∀ r ∈ F, q ≠ r →
      ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b) :
    (inducedEdgeFinsetOn G (F.biUnion fun q => q.1)).card =
      ∑ q ∈ F, (inducedEdgeFinsetOn G q.1).card := by
  classical
  have hedgeUnion : inducedEdgeFinsetOn G (F.biUnion fun q => q.1) =
      F.biUnion (fun q => inducedEdgeFinsetOn G q.1) := by
    ext e
    induction e using Sym2.inductionOn with
    | _ a b =>
        constructor
        · intro he
          have he' : G.Adj a b ∧ a ∈ F.biUnion (fun q => q.1) ∧
              b ∈ F.biUnion (fun q => q.1) := by
            simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using he
          rcases Finset.mem_biUnion.mp he'.2.1 with ⟨q, hq, haq⟩
          rcases Finset.mem_biUnion.mp he'.2.2 with ⟨r, hr, hbr⟩
          by_cases hqr : q = r
          · subst r
            apply Finset.mem_biUnion.mpr
            refine ⟨q, hq, ?_⟩
            simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using
              And.intro he'.1 ⟨haq, hbr⟩
          · exact (hanti q hq r hr hqr a haq b hbr he'.1).elim
        · intro he
          rcases Finset.mem_biUnion.mp he with ⟨q, hq, heq⟩
          have heq' : G.Adj a b ∧ a ∈ q.1 ∧ b ∈ q.1 := by
            simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using heq
          have haU : a ∈ F.biUnion (fun q => q.1) :=
            Finset.mem_biUnion.mpr ⟨q, hq, heq'.2.1⟩
          have hbU : b ∈ F.biUnion (fun q => q.1) :=
            Finset.mem_biUnion.mpr ⟨q, hq, heq'.2.2⟩
          have haU' : ∃ A : Finset V, (∃ D : Finset V, (A, D) ∈ F) ∧ a ∈ A :=
            ⟨q.1, ⟨q.2, hq⟩, heq'.2.1⟩
          have hbU' : ∃ A : Finset V, (∃ D : Finset V, (A, D) ∈ F) ∧ b ∈ A :=
            ⟨q.1, ⟨q.2, hq⟩, heq'.2.2⟩
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using
            And.intro heq'.1 ⟨haU', hbU'⟩
  have hedgePair : (F : Set (Finset V × Finset V)).PairwiseDisjoint
      (fun q => inducedEdgeFinsetOn G q.1) := by
    intro q hq r hr hqr
    change Disjoint (inducedEdgeFinsetOn G q.1) (inducedEdgeFinsetOn G r.1)
    rw [Finset.disjoint_left]
    intro e heq her
    induction e using Sym2.inductionOn with
    | _ a b =>
        have heq' : G.Adj a b ∧ a ∈ q.1 ∧ b ∈ q.1 := by
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using heq
        have her' : G.Adj a b ∧ a ∈ r.1 ∧ b ∈ r.1 := by
          simpa [inducedEdgeFinsetOn, Finset.mk_mem_sym2_iff] using her
        exact Finset.disjoint_left.mp
          (hdisj q (by simpa using hq) r (by simpa using hr) hqr)
          (hcore q (by simpa using hq) heq'.2.1)
          (hcore r (by simpa using hr) her'.2.1)
  rw [hedgeUnion, Finset.card_biUnion hedgePair]

/-- The same pair-indexed decomposition has exact core-cardinality
additivity. -/
theorem card_core_biUnion_eq_sum
    {V : Type*} [Fintype V]
    {F : Finset (Finset V × Finset V)}
    (hcore : ∀ q ∈ F, q.1 ⊆ q.2)
    (hdisj : ∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2) :
    (F.biUnion fun q => q.1).card = ∑ q ∈ F, q.1.card := by
  classical
  have hpair : (F : Set (Finset V × Finset V)).PairwiseDisjoint
      (fun q => q.1) := by
    intro q hq r hr hqr
    exact (hdisj q (by simpa using hq) r (by simpa using hr) hqr).mono
      (hcore q (by simpa using hq)) (hcore r (by simpa using hr))
  exact Finset.card_biUnion hpair

/-- Weighted averaging in the pair-indexed BFS output. -/
theorem exists_dense_core_of_pair_family
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V × Finset V)} {d : ℕ} (hF : F.Nonempty)
    (hcore : ∀ q ∈ F, q.1 ⊆ q.2)
    (hdisj : ∀ q ∈ F, ∀ r ∈ F, q ≠ r → Disjoint q.2 r.2)
    (hanti : ∀ q ∈ F, ∀ r ∈ F, q ≠ r →
      ∀ a ∈ q.1, ∀ b ∈ r.1, ¬ G.Adj a b)
    (hdense : d * (F.biUnion fun q => q.1).card ≤
      2 * (inducedEdgeFinsetOn G (F.biUnion fun q => q.1)).card) :
    ∃ q ∈ F, d * q.1.card ≤ 2 * (inducedEdgeFinsetOn G q.1).card := by
  classical
  have hcard := card_core_biUnion_eq_sum hcore hdisj
  have hedge := card_inducedEdgeFinsetOn_core_biUnion_eq_sum G hcore hdisj hanti
  by_contra hno
  push_neg at hno
  have hstrict : ∑ q ∈ F, 2 * (inducedEdgeFinsetOn G q.1).card <
      ∑ q ∈ F, d * q.1.card := by
    apply Finset.sum_lt_sum_of_nonempty hF
    intro q hq
    exact hno q hq
  have hsumDense : d * ∑ q ∈ F, q.1.card ≤
      2 * ∑ q ∈ F, (inducedEdgeFinsetOn G q.1).card := by
    simpa [hcard, hedge] using hdense
  have hstrict' : 2 * ∑ q ∈ F, (inducedEdgeFinsetOn G q.1).card <
      d * ∑ q ∈ F, q.1.card := by
    simpa [Finset.mul_sum] using hstrict
  omega

/-- The global BFS separator decomposition plus Turán yields a genuinely
dense retained core whenever the ambient order is four times large enough
for average degree `d`.  This is the first unconditional BFS-to-density
bridge in the KLS chain: it combines the factor-four coverage charge with
exact edge additivity and then averages to one core. -/
theorem exists_dense_global_bfs_core_of_indepSetFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n d : ℕ}
    (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : 4 * ((n - 1) * (d + 1)) ≤ Fintype.card V) :
    ∃ H : Finset V, H.Nonempty ∧
      d * H.card ≤ 2 * (inducedEdgeFinsetOn G H).card := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunion, hcharge⟩ :=
    exists_global_separated_bfs_core_family G
  have hF : F.Nonempty := by
    by_contra hnot
    rw [Finset.not_nonempty_iff_eq_empty] at hnot
    have hU : (Finset.univ : Finset V).Nonempty := Finset.univ_nonempty
    rw [← hunion] at hU
    simp [hnot] at hU
  let W : Finset V := F.biUnion fun q => q.1
  have hWcard : W.card = ∑ q ∈ F, q.1.card := by
    simpa [W] using card_core_biUnion_eq_sum
      (fun q hq => (hcore q hq).1) hdisj
  have hWcharge : Fintype.card V ≤ 4 * W.card := by
    rw [hWcard]
    exact hcharge
  have hWsize : (n - 1) * (d + 1) ≤ W.card := by
    omega
  let S : Set V := W
  have hSncard : S.ncard = W.card := by
    change ((W : Finset V) : Set V).ncard = W.card
    exact Set.ncard_coe_finset _
  have hsizeS : (n - 1) * (d + 1) ≤ S.ncard := by
    rw [hSncard]
    exact hWsize
  have hdenseS := avg_degree_induce_set_ge_of_indepSetFree G hn hfree hsizeS
  have hinside : inducedEdgeFinsetOnSet G S = inducedEdgeFinsetOn G W := by
    unfold inducedEdgeFinsetOnSet inducedEdgeFinsetOn
    congr 2
    ext v
    simp [S]
  have hdenseW : d * W.card ≤ 2 * (inducedEdgeFinsetOn G W).card := by
    calc
      d * W.card = d * S.ncard := by rw [hSncard]
      _ ≤ 2 * (inducedEdgeFinsetOnSet G S).card := hdenseS
      _ = 2 * (inducedEdgeFinsetOn G W).card := by rw [hinside]
  obtain ⟨q, hq, hqdense⟩ := exists_dense_core_of_pair_family G hF
    (fun r hr => (hcore r hr).1) hdisj hanti (by simpa [W] using hdenseW)
  exact ⟨q.1, (hcore q hq).2.1, hqdense⟩

/-- Provenance-preserving form of the global Turán-to-BFS density bridge.
The selected dense set is returned together with the envelope from the
separator recursion, so its induced BFS root and parity layers remain
available to the later path-to-cycle detour. -/
theorem exists_dense_global_bfs_core_with_witness_of_indepSetFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n d : ℕ}
    (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : 4 * ((n - 1) * (d + 1)) ≤ Fintype.card V) :
    ∃ H D : Finset V, H.Nonempty ∧
      d * H.card ≤ 2 * (inducedEdgeFinsetOn G H).card ∧
      IsInducedBfsParityCore G H D := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunion, hcharge⟩ :=
    exists_global_separated_bfs_core_family_with_witness G
  have hF : F.Nonempty := by
    by_contra hnot
    rw [Finset.not_nonempty_iff_eq_empty] at hnot
    have hU : (Finset.univ : Finset V).Nonempty := Finset.univ_nonempty
    rw [← hunion] at hU
    simp [hnot] at hU
  let W : Finset V := F.biUnion fun q => q.1
  have hWcard : W.card = ∑ q ∈ F, q.1.card := by
    simpa [W] using card_core_biUnion_eq_sum
      (fun q hq => (hcore q hq).1) hdisj
  have hWcharge : Fintype.card V ≤ 4 * W.card := by
    rw [hWcard]
    exact hcharge
  have hWsize : (n - 1) * (d + 1) ≤ W.card := by
    omega
  let S : Set V := W
  have hSncard : S.ncard = W.card := by
    change ((W : Finset V) : Set V).ncard = W.card
    exact Set.ncard_coe_finset _
  have hsizeS : (n - 1) * (d + 1) ≤ S.ncard := by
    rw [hSncard]
    exact hWsize
  have hdenseS := avg_degree_induce_set_ge_of_indepSetFree G hn hfree hsizeS
  have hinside : inducedEdgeFinsetOnSet G S = inducedEdgeFinsetOn G W := by
    unfold inducedEdgeFinsetOnSet inducedEdgeFinsetOn
    congr 2
    ext v
    simp [S]
  have hdenseW : d * W.card ≤ 2 * (inducedEdgeFinsetOn G W).card := by
    calc
      d * W.card = d * S.ncard := by rw [hSncard]
      _ ≤ 2 * (inducedEdgeFinsetOnSet G S).card := hdenseS
      _ = 2 * (inducedEdgeFinsetOn G W).card := by rw [hinside]
  obtain ⟨q, hq, hqdense⟩ := exists_dense_core_of_pair_family G hF
    (fun r hr => (hcore r hr).1) hdisj hanti (by simpa [W] using hdenseW)
  exact ⟨q.1, q.2, (hcore q hq).2.1, hqdense, (hcore q hq).2.2.2⟩

/-- Dense-core selection from the corrected connected-component BFS family.
This is the source-faithful second-pass density bridge: the selected core
retains both its average-degree lower bound and a connected BFS provenance
witness for cycle closure. -/
theorem exists_dense_global_component_bfs_core_with_witness_of_indepSetFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n d : ℕ}
    (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : 4 * ((n - 1) * (d + 1)) ≤ Fintype.card V) :
    ∃ H D : Finset V, H.Nonempty ∧
      d * H.card ≤ 2 * (inducedEdgeFinsetOn G H).card ∧
      IsComponentBfsParityCore G H D := by
  classical
  obtain ⟨F, hcore, hdisj, hanti, hunion, hcharge⟩ :=
    exists_global_separated_component_bfs_core_family_with_witness G
  have hF : F.Nonempty := by
    by_contra hnot
    rw [Finset.not_nonempty_iff_eq_empty] at hnot
    have hU : (Finset.univ : Finset V).Nonempty := Finset.univ_nonempty
    rw [← hunion] at hU
    simp [hnot] at hU
  let W : Finset V := F.biUnion fun q => q.1
  have hWcard : W.card = ∑ q ∈ F, q.1.card := by
    simpa [W] using card_core_biUnion_eq_sum
      (fun q hq => (hcore q hq).1) hdisj
  have hWcharge : Fintype.card V ≤ 4 * W.card := by
    rw [hWcard]
    exact hcharge
  have hWsize : (n - 1) * (d + 1) ≤ W.card := by
    omega
  let S : Set V := W
  have hSncard : S.ncard = W.card := by
    change ((W : Finset V) : Set V).ncard = W.card
    exact Set.ncard_coe_finset _
  have hsizeS : (n - 1) * (d + 1) ≤ S.ncard := by
    rw [hSncard]
    exact hWsize
  have hdenseS := avg_degree_induce_set_ge_of_indepSetFree G hn hfree hsizeS
  have hinside : inducedEdgeFinsetOnSet G S = inducedEdgeFinsetOn G W := by
    unfold inducedEdgeFinsetOnSet inducedEdgeFinsetOn
    congr 2
    ext v
    simp [S]
  have hdenseW : d * W.card ≤ 2 * (inducedEdgeFinsetOn G W).card := by
    calc
      d * W.card = d * S.ncard := by rw [hSncard]
      _ ≤ 2 * (inducedEdgeFinsetOnSet G S).card := hdenseS
      _ = 2 * (inducedEdgeFinsetOn G W).card := by rw [hinside]
  obtain ⟨q, hq, hqdense⟩ := exists_dense_core_of_pair_family G hF
    (fun r hr => (hcore r hr).1) hdisj hanti (by simpa [W] using hdenseW)
  exact ⟨q.1, q.2, (hcore q hq).2.1, hqdense, (hcore q hq).2.2.2⟩

/-- Two-pass KLS density extraction with both separator families retained.
The first connected BFS recursion covers the ambient graph by envelopes and
retains a core union of at least one quarter of the vertices.  Running the
relative recursion inside that union retains at least one sixteenth of the
ambient vertices.  Turán density on the second core union and exact
anticomplete edge additivity then select one genuinely dense second-pass
core, while all first- and second-pass provenance remains available for the
later exact nested-BFS cycle splice. -/
theorem exists_dense_second_component_bfs_core_of_indepSetFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n d : ℕ}
    (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (hsize : 16 * ((n - 1) * (d + 1)) ≤ Fintype.card V) :
    ∃ F₀ : Finset (Finset V × Finset V),
      ∃ F₁ : Finset (Finset V × Finset V),
      ∃ q ∈ F₁,
        (∀ r ∈ F₀, r.1 ⊆ r.2 ∧ r.1.Nonempty ∧
          r.2.card ≤ 4 * r.1.card ∧
          IsComponentBfsParityCore G r.1 r.2) ∧
        (∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s → Disjoint r.2 s.2) ∧
        (∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s →
          ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b) ∧
        (∀ r ∈ F₁, r.1 ⊆ r.2 ∧
          r.2 ⊆ F₀.biUnion (fun s => s.1) ∧ r.1.Nonempty ∧
          r.2.card ≤ 4 * r.1.card ∧
          IsComponentBfsParityCore G r.1 r.2) ∧
        (∀ r ∈ F₁, ∀ s ∈ F₁, r ≠ s → Disjoint r.2 s.2) ∧
        (∀ r ∈ F₁, ∀ s ∈ F₁, r ≠ s →
          ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b) ∧
        d * q.1.card ≤ 2 * (inducedEdgeFinsetOn G q.1).card := by
  classical
  obtain ⟨F₀, hcore₀, hdisj₀, hanti₀, _hunion₀, hcharge₀⟩ :=
    exists_global_separated_component_bfs_core_family_with_witness G
  let W₀ : Finset V := F₀.biUnion fun r => r.1
  have hW₀card : W₀.card = ∑ r ∈ F₀, r.1.card := by
    simpa [W₀] using card_core_biUnion_eq_sum
      (fun r hr => (hcore₀ r hr).1) hdisj₀
  have hW₀charge : Fintype.card V ≤ 4 * W₀.card := by
    rw [hW₀card]
    exact hcharge₀
  obtain ⟨F₁, hcore₁, hdisj₁, hanti₁, _hunion₁, hcharge₁⟩ :=
    exists_separated_component_bfs_core_family_in_finset_with_witness G W₀
  let W₁ : Finset V := F₁.biUnion fun r => r.1
  have hW₁card : W₁.card = ∑ r ∈ F₁, r.1.card := by
    simpa [W₁] using card_core_biUnion_eq_sum
      (fun r hr => (hcore₁ r hr).1) hdisj₁
  have hW₁charge : W₀.card ≤ 4 * W₁.card := by
    rw [hW₁card]
    exact hcharge₁
  have hW₁size : (n - 1) * (d + 1) ≤ W₁.card := by
    omega
  have hF₁ : F₁.Nonempty := by
    by_contra hnot
    rw [Finset.not_nonempty_iff_eq_empty] at hnot
    simp [W₁, hnot] at hW₁size
    have hnpos : 0 < n - 1 := by omega
    have hdpos : 0 < d + 1 := by omega
    have : 0 < (n - 1) * (d + 1) := Nat.mul_pos hnpos hdpos
    omega
  let S : Set V := W₁
  have hSncard : S.ncard = W₁.card := by
    change ((W₁ : Finset V) : Set V).ncard = W₁.card
    exact Set.ncard_coe_finset _
  have hsizeS : (n - 1) * (d + 1) ≤ S.ncard := by
    rw [hSncard]
    exact hW₁size
  have hdenseS := avg_degree_induce_set_ge_of_indepSetFree G hn hfree hsizeS
  have hinside : inducedEdgeFinsetOnSet G S = inducedEdgeFinsetOn G W₁ := by
    unfold inducedEdgeFinsetOnSet inducedEdgeFinsetOn
    congr 2
    ext v
    simp [S]
  have hdenseW₁ : d * W₁.card ≤ 2 * (inducedEdgeFinsetOn G W₁).card := by
    calc
      d * W₁.card = d * S.ncard := by rw [hSncard]
      _ ≤ 2 * (inducedEdgeFinsetOnSet G S).card := hdenseS
      _ = 2 * (inducedEdgeFinsetOn G W₁).card := by rw [hinside]
  obtain ⟨q, hq, hqdense⟩ := exists_dense_core_of_pair_family G hF₁
    (fun r hr => (hcore₁ r hr).1) hdisj₁ hanti₁
    (by simpa [W₁] using hdenseW₁)
  exact ⟨F₀, F₁, q, hq, hcore₀, hdisj₀, hanti₀,
    hcore₁, hdisj₁, hanti₁, hqdense⟩

/-- Extremal-order specialization of the two-pass extractor.  Taking
 d = floor((k-1)/16)-1 makes d+1 exactly the displayed quotient, and the
 factor-sixteen charge is absorbed by the extremal order
 (k-1)(n-1)+1.  All first- and second-pass provenance is retained for the
 exact nested-cycle closure. -/
theorem exists_dense_second_component_bfs_core_at_extremal_order
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hk : 17 ≤ k) (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1) :
    ∃ F₀ : Finset (Finset V × Finset V),
      ∃ F₁ : Finset (Finset V × Finset V),
      ∃ q ∈ F₁,
        (∀ r ∈ F₀, r.1 ⊆ r.2 ∧ r.1.Nonempty ∧
          r.2.card ≤ 4 * r.1.card ∧
          IsComponentBfsParityCore G r.1 r.2) ∧
        (∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s → Disjoint r.2 s.2) ∧
        (∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s →
          ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b) ∧
        (∀ r ∈ F₁, r.1 ⊆ r.2 ∧
          r.2 ⊆ F₀.biUnion (fun s => s.1) ∧ r.1.Nonempty ∧
          r.2.card ≤ 4 * r.1.card ∧
          IsComponentBfsParityCore G r.1 r.2) ∧
        (∀ r ∈ F₁, ∀ s ∈ F₁, r ≠ s → Disjoint r.2 s.2) ∧
        (∀ r ∈ F₁, ∀ s ∈ F₁, r ≠ s →
          ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b) ∧
        ((k - 1) / 16 - 1) * q.1.card ≤
          2 * (inducedEdgeFinsetOn G q.1).card := by
  have hqpos : 1 ≤ (k - 1) / 16 := by
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  have hqmul : 16 * ((k - 1) / 16) ≤ k - 1 :=
    Nat.mul_div_le (k - 1) 16
  have hsize : 16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) ≤
      Fintype.card V := by
    have hdeq : ((k - 1) / 16 - 1) + 1 = (k - 1) / 16 :=
      Nat.sub_add_cancel hqpos
    rw [hdeq, horder]
    have hmul : 16 * ((n - 1) * ((k - 1) / 16)) ≤
        (k - 1) * (n - 1) := by
      calc
        16 * ((n - 1) * ((k - 1) / 16)) =
            (16 * ((k - 1) / 16)) * (n - 1) := by ring
        _ ≤ (k - 1) * (n - 1) := Nat.mul_le_mul_right _ hqmul
    omega
  exact exists_dense_second_component_bfs_core_of_indepSetFree
    G hn hfree hsize

/-- At the Ramsey extremal order the preceding density bridge supplies a
core with average degree on the explicit `k/4` scale.  The harmless minus
one makes the natural-number division exact: if
`d = floor((k-1)/4)-1`, then `d+1 = floor((k-1)/4)`. -/
theorem exists_dense_global_bfs_core_at_extremal_order
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hk : 5 ≤ k) (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1) :
    ∃ H : Finset V, H.Nonempty ∧
      ((k - 1) / 4 - 1) * H.card ≤
        2 * (inducedEdgeFinsetOn G H).card := by
  have hqpos : 1 ≤ (k - 1) / 4 := by
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  have hqmul : 4 * ((k - 1) / 4) ≤ k - 1 :=
    Nat.mul_div_le (k - 1) 4
  have hsize : 4 * ((n - 1) * (((k - 1) / 4 - 1) + 1)) ≤
      Fintype.card V := by
    have hdeq : ((k - 1) / 4 - 1) + 1 = (k - 1) / 4 :=
      Nat.sub_add_cancel hqpos
    rw [hdeq, horder]
    have hmul : 4 * ((n - 1) * ((k - 1) / 4)) ≤
        (k - 1) * (n - 1) := by
      calc
        4 * ((n - 1) * ((k - 1) / 4)) =
            (4 * ((k - 1) / 4)) * (n - 1) := by ring
        _ ≤ (k - 1) * (n - 1) := Nat.mul_le_mul_right _ hqmul
    omega
  exact exists_dense_global_bfs_core_of_indepSetFree G hn hfree hsize

/-- Extremal-order version of the corrected connected-component density
bridge.  It is the second-pass replacement for the anonymous dense core
above and retains the connected BFS witness needed by interval closure. -/
theorem exists_dense_global_component_bfs_core_at_extremal_order
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hk : 5 ≤ k) (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1) :
    ∃ H D : Finset V, H.Nonempty ∧
      ((k - 1) / 4 - 1) * H.card ≤
        2 * (inducedEdgeFinsetOn G H).card ∧
      IsComponentBfsParityCore G H D := by
  have hqpos : 1 ≤ (k - 1) / 4 := by
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  have hqmul : 4 * ((k - 1) / 4) ≤ k - 1 :=
    Nat.mul_div_le (k - 1) 4
  have hsize : 4 * ((n - 1) * (((k - 1) / 4 - 1) + 1)) ≤
      Fintype.card V := by
    have hdeq : ((k - 1) / 4 - 1) + 1 = (k - 1) / 4 :=
      Nat.sub_add_cancel hqpos
    rw [hdeq, horder]
    have hmul : 4 * ((n - 1) * ((k - 1) / 4)) ≤
        (k - 1) * (n - 1) := by
      calc
        4 * ((n - 1) * ((k - 1) / 4)) =
            (4 * ((k - 1) / 4)) * (n - 1) := by ring
        _ ≤ (k - 1) * (n - 1) := Nat.mul_le_mul_right _ hqmul
    omega
  exact exists_dense_global_component_bfs_core_with_witness_of_indepSetFree
    G hn hfree hsize

/-- A maximum cut preserves at least half of every individual degree.  This
public local copy is the exact reduction used by KLS before applying the BFS
layer argument. -/
theorem exists_bipartite_subgraph_twice_degree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {d : ℕ} (hd : d ≤ G.minDegree) :
    ∃ H : SimpleGraph V, ∃ _ : DecidableRel H.Adj,
      H ≤ G ∧ H.IsBipartite ∧ ∀ v, d ≤ 2 * H.degree v := by
  classical
  obtain ⟨c, hc⟩ := Erdos182.PRSEntry.exists_cutGraph_forall_degree G
  let H := Erdos182.PRSEntry.cutGraph G c
  let : DecidableRel H.Adj := Classical.decRel H.Adj
  refine ⟨H, inferInstance, Erdos182.PRSEntry.cutGraph_le G c,
    (Erdos182.PRSEntry.cutGraph_isBipartiteWith G c).isBipartite, ?_⟩
  intro v
  have hGdeg : d ≤ Erdos182.PRSEntry.degreeNumber G v := by
    rw [Erdos182.PRSEntry.degreeNumber_eq_degree]
    exact hd.trans (G.minDegree_le_degree v)
  have hcut := hGdeg.trans (hc v)
  rw [Erdos182.PRSEntry.degreeNumber_eq_degree] at hcut
  exact hcut

/-- From minimum degree `4d`, a maximum cut, one connected component, and
the formalized BFS-layer lemma produce a nonempty two-layer bipartite slice
of average degree at least `d`.  The witnesses retain the embeddings back to
the original graph, which later lets a path or cycle found in the slice be
transported to the Ramsey counterexample. -/
theorem exists_dense_bfs_pair_of_minDegree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {d : ℕ} (hd : 0 < d)
    (hmin : 4 * d ≤ G.minDegree) :
    ∃ H : SimpleGraph V, ∃ _ : DecidableRel H.Adj,
      ∃ c : H.ConnectedComponent, ∃ _ : DecidableRel c.toSimpleGraph.Adj,
        H ≤ G ∧ H.IsBipartite ∧ c.toSimpleGraph.Connected ∧
        c.toSimpleGraph.IsBipartite ∧
        (∀ v : c, 2 * d ≤ c.toSimpleGraph.degree v) ∧
        ∃ root : c, ∃ i : ℕ,
          (Erdos752.bfsPair c.toSimpleGraph root i).edgeFinset.Nonempty ∧
          d * (Erdos752.bfsPair c.toSimpleGraph root i).support.ncard ≤
            2 * (Erdos752.bfsPair c.toSimpleGraph root i).edgeFinset.card := by
  classical
  obtain ⟨H, instH, hHG, hHbip, hHdeg⟩ :=
    exists_bipartite_subgraph_twice_degree G hmin
  let : DecidableRel H.Adj := instH
  obtain ⟨c, instC, hconn, hCbip, hCdeg, _hinjH, _hinjG⟩ :=
    Erdos752.exists_connected_bipartite_component_of_le H (by positivity)
      hHG hHbip hHdeg
  let : DecidableRel c.toSimpleGraph.Adj := instC
  let : Nonempty c := c.nonempty_supp.to_subtype
  let root : c := Classical.choice inferInstance
  have hdegree : ∀ v : c, 2 * d ≤ c.toSimpleGraph.degree v := by
    intro v
    have hv := hCdeg v
    omega
  obtain ⟨i, hE, hdense⟩ :=
    Erdos752.exists_dense_bfs_pair hconn hCbip d hd hdegree root
  exact ⟨H, instH, c, instC, hHG, hHbip, hconn, hCbip, hdegree,
    root, i, hE, hdense⟩

/-- A dense spanning subgraph on its support gives an equally dense induced
piece of any ambient supergraph.  The map of the induced edge finset back to
the ambient type identifies it with the ambient edges whose endpoints lie in
the support, and every edge of the subgraph lies in that set.  This is the
formal bridge from a BFS crossing graph to an induced graph on which local
DRC can run. -/
theorem dense_induced_of_subgraph_support
    {V : Type*} [Fintype V] (G H : SimpleGraph V)
    [DecidableRel G.Adj] [DecidableRel H.Adj] {d : ℕ}
    (hHG : H ≤ G)
    (hdense : d * H.support.ncard ≤ 2 * H.edgeFinset.card) :
    d * Fintype.card H.support ≤
      2 * (G.induce H.support).edgeFinset.card := by
  have hsub : H.edgeFinset ⊆ G.edgeFinset ∩ H.support.toFinset.sym2 := by
    intro e he
    rw [Finset.mem_inter]
    refine ⟨SimpleGraph.edgeFinset_mono hHG he, ?_⟩
    exact SimpleGraph.edgeFinset_subset_sym2_of_support_subset
      (G := H) (s := H.support) subset_rfl he
  have hcard : H.edgeFinset.card ≤
      (G.induce H.support).edgeFinset.card := by
    calc
      H.edgeFinset.card ≤ (G.edgeFinset ∩ H.support.toFinset.sym2).card :=
        Finset.card_le_card hsub
      _ = (G.induce H.support).edgeFinset.card := by
        rw [← SimpleGraph.map_edgeFinset_induce]
        simp
  have hdense' : d * H.support.ncard ≤
      2 * (G.induce H.support).edgeFinset.card :=
    hdense.trans (Nat.mul_le_mul_left 2 hcard)
  rw [Set.fintypeCard_eq_ncard]
  exact hdense'

/-! ## DRC interface for dense pieces -/

/-- On the full vertex set, the DRC edge-mass parameter is exactly twice the
number of edges.  This is the bridge from ordinary graph density estimates to
the already-formalized finite DRC theorem. -/
theorem drc_edgeMass_univ_eq_twice_card_edges {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Erdos163.DRC.edgeMass G Finset.univ Finset.univ =
      2 * G.edgeFinset.card := by
  classical
  unfold Erdos163.DRC.edgeMass
  have hfilter (y : V) :
      (Finset.univ.filter fun z : V ↦ G.Adj z y) = G.neighborFinset y := by
    ext z
    simp [SimpleGraph.mem_neighborFinset, adj_comm]
  simp_rw [hfilter]
  simp_rw [SimpleGraph.card_neighborFinset_eq_degree]
  exact G.sum_degrees_eq_twice_card_edges

/-- Full-vertex-set specialization of finite dependent random choice. -/
theorem exists_drc_univ {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ s D t τ : ℕ} (hD : 0 < D) (ht : 0 < t) (hst : s ≤ t)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hdensity : ρ * Fintype.card V * Fintype.card V ≤ 2 * G.edgeFinset.card)
    (hθ : (θ : ℝ) ≤ η * ρ ^ D * Fintype.card V)
    (hτ : (τ : ℝ) ^ D ≤ ((ρ ^ t) * Fintype.card V) ^ D / 2) :
    ∃ x ∈ Erdos163.FiniteDefect.samples t (Finset.univ : Finset V),
      let U := Erdos163.FiniteDefect.commonNeighbors G x Finset.univ
      τ ≤ U.card ∧
      Erdos163.FiniteDefect.moment G θ s (fun _ : Fin D => U) Finset.univ ≤
        2 * η ^ t := by
  classical
  apply Erdos163.DRC.exists_drc G
    (A := (Finset.univ : Finset V)) (B := (Finset.univ : Finset V))
    (by simp) (by simp) hD ht hst hη hρ
  · simpa [drc_edgeMass_univ_eq_twice_card_edges] using hdensity
  · simpa using hθ
  · simpa using hτ

/-- At exponent zero, finite defect power is exactly the indicator of a bad
tuple. -/
theorem defectPower_zero_eq_indicator_lt {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {ι : Type*} [Fintype ι] (q : ι → V) (T : Finset V) (θ : ℕ) :
    Erdos163.FiniteDefect.defectPower G θ q T 0 =
      Erdos163.DRC.indicator
        ((Erdos163.FiniteDefect.commonNeighbors G q T).card < θ) := by
  classical
  by_cases hsmall : (Erdos163.FiniteDefect.commonNeighbors G q T).card < θ
  · rw [Erdos163.DRC.indicator_true hsmall]
    have hdef : Erdos163.FiniteDefect.defect G θ q T ≠ 0 := by
      intro hzero
      have hnonneg := Erdos163.FiniteDefect.defect_nonneg G θ q T
      unfold Erdos163.FiniteDefect.defect at hzero
      simp only [Nat.not_le_of_lt hsmall, if_false] at hzero
      by_cases hcard : (Erdos163.FiniteDefect.commonNeighbors G q T).card = 0
      · simp [hcard, Nat.ne_of_gt (lt_of_le_of_lt (Nat.zero_le _) hsmall)] at hzero
        have : (0 : ℝ) < Fintype.card V + 1 := by positivity
        linarith
      · have hθ : 0 < θ := (Nat.pos_of_ne_zero hcard).trans hsmall
        have : (0 : ℝ) < (θ : ℝ) /
            (Erdos163.FiniteDefect.commonNeighbors G q T).card := by positivity
        simp [hcard] at hzero
        linarith
    simp [Erdos163.FiniteDefect.defectPower, hdef]
  · have hlarge : θ ≤ (Erdos163.FiniteDefect.commonNeighbors G q T).card :=
      Nat.le_of_not_gt hsmall
    rw [Erdos163.DRC.indicator_false hsmall,
      Erdos163.FiniteDefect.defectPower,
      if_pos (Erdos163.FiniteDefect.defect_eq_zero_of_threshold_le G hlarge)]

theorem moment_zero_eq_expect_indicator {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A T : Finset V) (D θ : ℕ) :
    Erdos163.FiniteDefect.moment G θ 0 (fun _ : Fin D => A) T =
      𝔼 q ∈ Erdos163.FiniteDefect.samples D A,
        Erdos163.DRC.indicator
          ((Erdos163.FiniteDefect.commonNeighbors G q T).card < θ) := by
  classical
  unfold Erdos163.FiniteDefect.moment Erdos163.FiniteDefect.samples
    Erdos163.FiniteDefect.tuples
  apply Finset.expect_congr rfl
  intro q hq
  exact defectPower_zero_eq_indicator_lt G q T θ

/-- A zero-th defect moment smaller than the mass of one sample rules out
every bad tuple. -/
theorem all_commonNeighbors_large_of_moment_zero_lt {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {A T : Finset V} (hA : A.Nonempty) {D θ : ℕ}
    (hmoment : Erdos163.FiniteDefect.moment G θ 0 (fun _ : Fin D => A) T <
      (1 : ℝ) / A.card ^ D) :
    ∀ q ∈ Erdos163.FiniteDefect.samples D A,
      θ ≤ (Erdos163.FiniteDefect.commonNeighbors G q T).card := by
  intro q hq
  by_contra hbad
  have hbad' : (Erdos163.FiniteDefect.commonNeighbors G q T).card < θ := by omega
  rw [moment_zero_eq_expect_indicator] at hmoment
  rw [Finset.expect_eq_sum_div_card] at hmoment
  have hsum : (1 : ℝ) ≤
      ∑ r ∈ Erdos163.FiniteDefect.samples D A,
        Erdos163.DRC.indicator
          ((Erdos163.FiniteDefect.commonNeighbors G r T).card < θ) := by
    calc
      (1 : ℝ) = Erdos163.DRC.indicator
          ((Erdos163.FiniteDefect.commonNeighbors G q T).card < θ) := by
            symm
            exact Erdos163.DRC.indicator_true hbad'
      _ ≤ ∑ r ∈ Erdos163.FiniteDefect.samples D A,
          Erdos163.DRC.indicator
            ((Erdos163.FiniteDefect.commonNeighbors G r T).card < θ) := by
            exact Finset.single_le_sum
              (f := fun r ↦ Erdos163.DRC.indicator
                ((Erdos163.FiniteDefect.commonNeighbors G r T).card < θ))
              (fun r _ ↦ Erdos163.DRC.indicator_nonneg _) hq
  have hcard : (Erdos163.FiniteDefect.samples D A).card = A.card ^ D := by
    simp
  rw [hcard] at hmoment
  have hdiv : (1 : ℝ) / A.card ^ D ≤
      (∑ r ∈ Erdos163.FiniteDefect.samples D A,
        Erdos163.DRC.indicator
          ((Erdos163.FiniteDefect.commonNeighbors G r T).card < θ)) / A.card ^ D := by
    exact div_le_div_of_nonneg_right hsum (by positivity)
  have hdiv' : (1 : ℝ) / A.card ^ D ≤
      (∑ r ∈ Erdos163.FiniteDefect.samples D A,
        Erdos163.DRC.indicator
          ((Erdos163.FiniteDefect.commonNeighbors G r T).card < θ)) /
        ((A.card ^ D : ℕ) : ℝ) := by
    simpa [Nat.cast_pow] using hdiv
  exact (not_le_of_gt hmoment) hdiv'

/-- Pair form of the preceding zero-moment criterion, the interface used by
hub routing: every ordered pair from `U` has at least `θ` common neighbors
in the target set. -/
theorem all_pairs_have_large_commonNeighbors_of_moment_zero_lt
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} (hU : U.Nonempty) {θ : ℕ}
    (hmoment : Erdos163.FiniteDefect.moment G θ 0
        (fun _ : Fin 2 => U) T < (1 : ℝ) / U.card ^ 2) :
    ∀ x ∈ U, ∀ y ∈ U,
      θ ≤ (Erdos163.FiniteDefect.commonNeighbors G ![x, y] T).card := by
  intro x hx y hy
  apply all_commonNeighbors_large_of_moment_zero_lt G hU hmoment ![x, y]
  simp [Erdos163.FiniteDefect.samples, hx, hy]

/-- A convenient robust-pair DRC output: under a sufficiently small
zero-moment bound, the selected set has the required pairwise common
neighborhood property. -/
theorem exists_drc_univ_with_all_pairs
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ t τ : ℕ} (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hdensity : ρ * Fintype.card V * Fintype.card V ≤ 2 * G.edgeFinset.card)
    (hθ : (θ : ℝ) ≤ η * ρ ^ 2 * Fintype.card V)
    (hτ : (τ : ℝ) ^ 2 ≤ ((ρ ^ t) * Fintype.card V) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card V : ℝ) ^ 2) :
    ∃ x ∈ Erdos163.FiniteDefect.samples t (Finset.univ : Finset V),
      let U := Erdos163.FiniteDefect.commonNeighbors G x Finset.univ
      τ ≤ U.card ∧
      ∀ a ∈ U, ∀ b ∈ U,
        θ ≤ (Erdos163.FiniteDefect.commonNeighbors G ![a, b] Finset.univ).card := by
  classical
  obtain ⟨x, hx, hresult⟩ := exists_drc_univ G
    (θ := θ) (s := 0) (D := 2) (t := t) (τ := τ)
    (by omega) ht (by omega) hη hρ hdensity hθ hτ
  dsimp only at hresult
  rcases hresult with ⟨hUcard, hmom⟩
  let U := Erdos163.FiniteDefect.commonNeighbors G x (Finset.univ : Finset V)
  have hUcard' : τ ≤ U.card := by simpa [U] using hUcard
  have hU : U.Nonempty := Finset.nonempty_iff_ne_empty.mpr (by
    intro hUempty
    rw [hUempty] at hUcard'
    simp at hUcard'
    omega)
  have hUle : U.card ≤ Fintype.card V := by
    exact Finset.card_le_univ U
  have hpowle : (U.card : ℝ) ^ 2 ≤ (Fintype.card V : ℝ) ^ 2 := by
    gcongr
  have hUpos : 0 < (U.card : ℝ) ^ 2 := by
    have : 0 < U.card := hU.card_pos
    positivity
  have hone : (1 : ℝ) / (Fintype.card V : ℝ) ^ 2 ≤ (1 : ℝ) / U.card ^ 2 :=
    one_div_le_one_div_of_le hUpos hpowle
  have hmom' : Erdos163.FiniteDefect.moment G θ 0 (fun _ : Fin 2 => U) Finset.univ <
      (1 : ℝ) / U.card ^ 2 := by
    have hmomU : Erdos163.FiniteDefect.moment G θ 0 (fun _ : Fin 2 => U) Finset.univ ≤
        2 * η ^ t := by simpa [U] using hmom
    exact hmomU.trans_lt (hsmall.trans_le hone)
  refine ⟨x, hx, ?_⟩
  dsimp only
  refine ⟨hUcard, ?_⟩
  simpa [U] using all_pairs_have_large_commonNeighbors_of_moment_zero_lt
    G hU hmom'

/-! ## Greedy routing inside a robust pair set -/

/-- A set whose every ordered pair has a large common neighborhood.  The
target `T` is kept explicit because KLS repeatedly routes while avoiding a
small exceptional set inside a larger ambient reservoir. -/
def RobustPairSet {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (U T : Finset V) (θ : ℕ) : Prop :=
  ∀ a ∈ U, ∀ b ∈ U,
    θ ≤ (Erdos163.FiniteDefect.commonNeighbors G ![a, b] T).card

/-- Forget the subtype on a finite set of vertices selected inside an
induced piece.  Keeping this operation named makes it possible to state DRC
locally, then use the selected hub in the original Ramsey graph. -/
def liftSubtypeFinset {V : Type*} [Fintype V] (S : Finset V)
    (U : Finset S) : Finset V :=
  U.map ⟨Subtype.val, Subtype.val_injective⟩

/-- Common neighbourhoods commute with forgetting the subtype of an induced
piece.  This is the bookkeeping fact behind transporting a DRC hub from a
dense induced subgraph back to the ambient graph. -/
theorem commonNeighbors_induce_map_eq
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) {a b : S} (T : Finset S) :
    (Erdos163.FiniteDefect.commonNeighbors (G.induce (S : Set V)) ![a, b] T).map
      ⟨Subtype.val, Subtype.val_injective⟩ =
    Erdos163.FiniteDefect.commonNeighbors G ![(a : V), (b : V)]
      (liftSubtypeFinset S T) := by
  ext x
  simp [liftSubtypeFinset, Erdos163.FiniteDefect.commonNeighbors,
    Erdos163.Defect.commonNeighbors]

/-- A robust pair set in an induced piece remains robust after its vertices
are viewed in the ambient graph.  The target set is transported at the same
time, so later routing lemmas can be applied without changing their API. -/
theorem RobustPairSet.of_induce
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {U T : Finset S} {θ : ℕ}
    (hrob : RobustPairSet (G.induce (S : Set V)) U T θ) :
    RobustPairSet G (liftSubtypeFinset S U) (liftSubtypeFinset S T) θ := by
  intro a ha b hb
  rcases Finset.mem_map.mp ha with ⟨a', ha', rfl⟩
  rcases Finset.mem_map.mp hb with ⟨b', hb', rfl⟩
  have h := hrob a' ha' b' hb'
  have hcard := congrArg Finset.card
    (commonNeighbors_induce_map_eq G S (a := a') (b := b') T)
  have h' : θ ≤
      ((Erdos163.FiniteDefect.commonNeighbors (G.induce (S : Set V))
        ![a', b'] T).map ⟨Subtype.val, Subtype.val_injective⟩).card := by
    simpa using h
  simpa [liftSubtypeFinset] using hcard ▸ h'

/-- Robust pair reservoirs are monotone under graph embeddings.  Map the
reservoir and target finite sets; every common neighbour in the source maps
injectively to a common neighbour in the target graph, so the cardinal
threshold is preserved. -/
theorem RobustPairSet.map_embedding
    {V W : Type*} [Fintype V] [Fintype W]
    {G : SimpleGraph V} {H : SimpleGraph W}
    [DecidableRel G.Adj] [DecidableRel H.Adj]
    (e : G ↪g H) {U T : Finset V} {θ : ℕ}
    (hrob : RobustPairSet G U T θ) :
    RobustPairSet H
      (U.map ⟨e, e.injective⟩) (T.map ⟨e, e.injective⟩) θ := by
  classical
  intro a ha b hb
  rcases Finset.mem_map.mp ha with ⟨a', ha', rfl⟩
  rcases Finset.mem_map.mp hb with ⟨b', hb', rfl⟩
  let f : V ↪ W := ⟨e, e.injective⟩
  let C : Finset V :=
    Erdos163.FiniteDefect.commonNeighbors G ![a', b'] T
  have hsub : C.map f ⊆
      Erdos163.FiniteDefect.commonNeighbors H ![e a', e b'] (T.map f) := by
    intro z hz
    rcases Finset.mem_map.mp hz with ⟨w, hw, rfl⟩
    change w ∈ Erdos163.Defect.commonNeighbors G ![a', b'] T at hw
    change e w ∈ Erdos163.Defect.commonNeighbors H ![e a', e b'] (T.map f)
    rw [Erdos163.Defect.mem_commonNeighbors] at hw ⊢
    refine ⟨Finset.mem_map.mpr ⟨w, hw.1, rfl⟩, ?_⟩
    intro i
    fin_cases i
    · exact e.map_rel_iff.mpr (hw.2 0)
    · exact e.map_rel_iff.mpr (hw.2 1)
  calc
    θ ≤ C.card := hrob a' ha' b' hb'
    _ = (C.map f).card := by simp
    _ ≤ (Erdos163.FiniteDefect.commonNeighbors H ![e a', e b']
        (T.map f)).card := Finset.card_le_card hsub

/-- The same transport only needs an injective graph homomorphism.  This is
the form used after low-degree deletion: the minimum-degree core may omit
ambient edges, so it maps into the Ramsey graph by an injective hom rather
than an induced embedding, and common-neighbour counts can only increase. -/
theorem RobustPairSet.map_injective_hom
    {V W : Type*} [Fintype V] [Fintype W]
    {G : SimpleGraph V} {H : SimpleGraph W}
    [DecidableRel G.Adj] [DecidableRel H.Adj]
    (e : G →g H) (he : Function.Injective e)
    {U T : Finset V} {θ : ℕ}
    (hrob : RobustPairSet G U T θ) :
    RobustPairSet H
      (U.map ⟨e, he⟩) (T.map ⟨e, he⟩) θ := by
  classical
  intro a ha b hb
  rcases Finset.mem_map.mp ha with ⟨a', ha', rfl⟩
  rcases Finset.mem_map.mp hb with ⟨b', hb', rfl⟩
  let f : V ↪ W := ⟨e, he⟩
  let C : Finset V :=
    Erdos163.FiniteDefect.commonNeighbors G ![a', b'] T
  have hsub : C.map f ⊆
      Erdos163.FiniteDefect.commonNeighbors H ![e a', e b'] (T.map f) := by
    intro z hz
    rcases Finset.mem_map.mp hz with ⟨w, hw, rfl⟩
    change w ∈ Erdos163.Defect.commonNeighbors G ![a', b'] T at hw
    change e w ∈ Erdos163.Defect.commonNeighbors H ![e a', e b'] (T.map f)
    rw [Erdos163.Defect.mem_commonNeighbors] at hw ⊢
    refine ⟨Finset.mem_map.mpr ⟨w, hw.1, rfl⟩, ?_⟩
    intro i
    fin_cases i
    · exact e.map_rel (hw.2 0)
    · exact e.map_rel (hw.2 1)
  calc
    θ ≤ C.card := hrob a' ha' b' hb'
    _ = (C.map f).card := by simp
    _ ≤ (Erdos163.FiniteDefect.commonNeighbors H ![e a', e b']
        (T.map f)).card := Finset.card_le_card hsub

theorem RobustPairSet.mono_left
    {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {U U' T : Finset V} {θ : ℕ} (h : RobustPairSet G U T θ)
    (hU' : U' ⊆ U) : RobustPairSet G U' T θ := by
  intro a ha b hb
  exact h a (hU' ha) b (hU' hb)

/-- Enlarging the common-neighbour target preserves robustness. -/
theorem RobustPairSet.mono_right
    {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {U T T' : Finset V} {θ : ℕ} (h : RobustPairSet G U T θ)
    (hTT' : T ⊆ T') : RobustPairSet G U T' θ := by
  intro a ha b hb
  exact (h a ha b hb).trans (Finset.card_le_card
    (Erdos163.Defect.commonNeighbors_mono_target G ![a, b] hTT'))

theorem RobustPairSet.mono_threshold
    {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {U T : Finset V} {θ θ' : ℕ} (h : RobustPairSet G U T θ)
    (hθ : θ' ≤ θ) : RobustPairSet G U T θ' := by
  intro a ha b hb
  exact hθ.trans (h a ha b hb)

/-- Deleting a finite forbidden set from both sides of a robust pair loses
at most the cardinality of that set from every common-neighbour threshold. -/
theorem RobustPairSet.sdiff
    {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {U T F : Finset V} {θ : ℕ} (h : RobustPairSet G U T θ) :
    RobustPairSet G (U \ F) (T \ F) (θ - F.card) := by
  intro a ha b hb
  have haU := (Finset.mem_sdiff.mp ha).1
  have hbU := (Finset.mem_sdiff.mp hb).1
  let C : Finset V :=
    Erdos163.FiniteDefect.commonNeighbors G ![a, b] T
  let C' : Finset V :=
    Erdos163.FiniteDefect.commonNeighbors G ![a, b] (T \ F)
  have hCF : C \ F ⊆ C' := by
    intro x hx
    have hx' := Finset.mem_sdiff.mp hx
    have hxC : x ∈ C := hx'.1
    change x ∈ Erdos163.Defect.commonNeighbors G ![a, b] (T \ F)
    change x ∈ Erdos163.Defect.commonNeighbors G ![a, b] T at hxC
    rw [Erdos163.Defect.mem_commonNeighbors] at hxC ⊢
    exact ⟨Finset.mem_sdiff.mpr ⟨hxC.1, hx'.2⟩, hxC.2⟩
  have hret : θ - F.card ≤ (C \ F).card :=
    sub_le_card_sdiff_of_le_card_of_card_le (h a haU b hbU) le_rfl
  exact hret.trans (Finset.card_le_card hCF)

/-- Deleting a forbidden set only from the target preserves the whole core
and loses at most the number of deleted vertices from every pair threshold.
This asymmetric form is needed when an alternating reservoir has already
reserved target vertices but its core must remain unchanged. -/
theorem RobustPairSet.sdiff_right
    {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {U T F : Finset V} {θ : ℕ} (h : RobustPairSet G U T θ) :
    RobustPairSet G U (T \ F) (θ - F.card) := by
  intro a ha b hb
  let C : Finset V :=
    Erdos163.FiniteDefect.commonNeighbors G ![a, b] T
  let C' : Finset V :=
    Erdos163.FiniteDefect.commonNeighbors G ![a, b] (T \ F)
  have hCF : C \ F ⊆ C' := by
    intro x hx
    have hx' := Finset.mem_sdiff.mp hx
    have hxC : x ∈ C := hx'.1
    change x ∈ Erdos163.Defect.commonNeighbors G ![a, b] (T \ F)
    change x ∈ Erdos163.Defect.commonNeighbors G ![a, b] T at hxC
    rw [Erdos163.Defect.mem_commonNeighbors] at hxC ⊢
    exact ⟨Finset.mem_sdiff.mpr ⟨hxC.1, hx'.2⟩, hxC.2⟩
  have hret : θ - F.card ≤ (C \ F).card :=
    sub_le_card_sdiff_of_le_card_of_card_le (h a ha b hb) le_rfl
  exact hret.trans (Finset.card_le_card hCF)

/-! ## Compact targets for DRC hubs -/

/-- The expected size of the intersection of a fixed finite set with an
independent Bernoulli sample is the sum of the coordinate probabilities.
This elementary identity supplies the size term in the compact-hub
sampling argument below. -/
theorem independentBits_expectation_card_inter_selected
    {I : Type*} [Fintype I] [DecidableEq I]
    (p : I → ℝ≥0) (hp : ∀ i, p i ≤ 1) (S : Finset I) :
    (Erdos207.FiniteLaw.independentBits p hp).expectation
        (fun ω ↦ ((S ∩ Erdos207.FiniteLaw.selectedByBits ω).card : ℝ≥0)) =
      ∑ i ∈ S, p i := by
  classical
  let L := Erdos207.FiniteLaw.independentBits p hp
  have hcard (ω : I → Bool) :
      ((S ∩ Erdos207.FiniteLaw.selectedByBits ω).card : ℝ≥0) =
        ∑ i ∈ S, if i ∈ Erdos207.FiniteLaw.selectedByBits ω then 1 else 0 := by
    rw [← Finset.filter_mem_eq_inter]
    exact (Finset.sum_boole
      (fun i ↦ i ∈ Erdos207.FiniteLaw.selectedByBits ω) S).symm
  simp_rw [Erdos207.FiniteLaw.expectation, hcard]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _hi
  have heq :
      (∑ ω, L.mass ω *
        if i ∈ Erdos207.FiniteLaw.selectedByBits ω then 1 else 0) =
        L.probability
          (fun ω ↦ i ∈ Erdos207.FiniteLaw.selectedByBits ω) := by
    unfold Erdos207.FiniteLaw.probability
    apply Finset.sum_congr rfl
    intro ω _hω
    by_cases hmem : i ∈ Erdos207.FiniteLaw.selectedByBits ω <;>
      simp [hmem]
  rw [show Erdos207.FiniteLaw.independentBits p hp = L by rfl, heq]
  have hprob :=
    Erdos207.FiniteLaw.independentBits_probability_subset_selected p hp {i}
  simpa [L] using hprob

/-- Independent sampling compresses a DRC target whenever the exact finite
lower-tail union bound and the first-moment size bound fit below one.  Every
ordered pair of core vertices retains at least `r + 1` common neighbours in
the sampled target, while the target itself has fewer than `K` vertices.
The conclusion is deterministic; probability is used only to select it. -/
theorem exists_compact_robustPairSet_target
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : Finset V) (r K : ℕ) (sigma : ℝ≥0)
    (hsigma : sigma ≤ 1) (hK : 0 < K)
    (hsmall :
      (∑ q ∈ U.product U,
        (1 - sigma / 2) ^
            (Erdos163.FiniteDefect.commonNeighbors G ![q.1, q.2] T).card /
          (1 / 2 : ℝ≥0) ^ r) +
        ((T.card : ℝ≥0) * sigma) / K < 1) :
    ∃ D : Finset V, D ⊆ T ∧ D.card < K ∧
      RobustPairSet G U D (r + 1) := by
  classical
  let L := Erdos207.FiniteLaw.independentBits
    (fun _ : V ↦ sigma) (fun _ ↦ hsigma)
  let selected : (V → Bool) → Finset V :=
    fun ω ↦ Erdos207.FiniteLaw.selectedByBits ω
  let C : V × V → Finset V := fun q ↦
    Erdos163.FiniteDefect.commonNeighbors G ![q.1, q.2] T
  let PairBad : V × V → (V → Bool) → Prop :=
    fun q ω ↦ (C q ∩ selected ω).card ≤ r
  let AnyPairBad : (V → Bool) → Prop := fun ω ↦
    ∃ q ∈ U.product U, PairBad q ω
  let SizeBad : (V → Bool) → Prop := fun ω ↦
    K ≤ (T ∩ selected ω).card
  have hpairs : L.probability AnyPairBad ≤
      ∑ q ∈ U.product U,
        (1 - sigma / 2) ^ (C q).card /
          (1 / 2 : ℝ≥0) ^ r := by
    calc
      L.probability AnyPairBad ≤
          ∑ q ∈ U.product U, L.probability (PairBad q) := by
        exact L.probability_exists_le (U.product U) PairBad
      _ ≤ ∑ q ∈ U.product U,
          (1 - sigma / 2) ^ (C q).card /
            (1 / 2 : ℝ≥0) ^ r := by
        apply Finset.sum_le_sum
        intro q _hq
        exact
          Erdos207.FiniteLaw.independentBits_probability_card_inter_selected_le_le_half
            sigma hsigma (C q) r
  have hexpect : L.expectation
      (fun ω ↦ ((T ∩ selected ω).card : ℝ≥0)) =
        (T.card : ℝ≥0) * sigma := by
    rw [show L = Erdos207.FiniteLaw.independentBits
      (fun _ : V ↦ sigma) (fun _ ↦ hsigma) by rfl]
    rw [independentBits_expectation_card_inter_selected]
    simp [Finset.sum_const, nsmul_eq_mul]
  have hsize : L.probability SizeBad ≤
      ((T.card : ℝ≥0) * sigma) / K := by
    have hmarkov := L.probability_le_expectation_div
      (fun ω ↦ ((T ∩ selected ω).card : ℝ≥0))
      (a := (K : ℝ≥0)) (by exact_mod_cast hK)
    rw [hexpect] at hmarkov
    simpa [SizeBad] using hmarkov
  have hsum : L.probability AnyPairBad + L.probability SizeBad < 1 := by
    calc
      L.probability AnyPairBad + L.probability SizeBad ≤
          (∑ q ∈ U.product U,
            (1 - sigma / 2) ^ (C q).card /
              (1 / 2 : ℝ≥0) ^ r) +
            ((T.card : ℝ≥0) * sigma) / K :=
        add_le_add hpairs hsize
      _ < 1 := by simpa [C] using hsmall
  let Bad : Bool → (V → Bool) → Prop := fun b ↦
    if b then SizeBad else AnyPairBad
  have hsumBad : ∑ b : Bool, L.probability (Bad b) < 1 := by
    simpa [Bad, Fintype.sum_bool, add_comm] using hsum
  obtain ⟨ω, hω⟩ := L.exists_avoiding_of_sum_probability_lt_one
    (Finset.univ : Finset Bool) Bad (by simpa using hsumBad)
  let D : Finset V := T ∩ selected ω
  have hnotPair : ¬ AnyPairBad ω := by
    simpa [Bad] using hω false (Finset.mem_univ false)
  have hnotSize : ¬ SizeBad ω := by
    simpa [Bad] using hω true (Finset.mem_univ true)
  refine ⟨D, Finset.inter_subset_left, Nat.lt_of_not_ge hnotSize, ?_⟩
  intro a ha b hb
  have hq : (a, b) ∈ U.product U := Finset.mem_product.mpr ⟨ha, hb⟩
  have hlarge : r < (C (a, b) ∩ selected ω).card := by
    exact Nat.lt_of_not_ge (fun hle ↦ hnotPair ⟨(a, b), hq, hle⟩)
  have heq :
      Erdos163.FiniteDefect.commonNeighbors G ![a, b] D =
        C (a, b) ∩ selected ω := by
    ext x
    simp [D, C, selected, Erdos163.FiniteDefect.commonNeighbors,
      Erdos163.Defect.commonNeighbors, and_assoc, and_left_comm]
    tauto
  rw [heq]
  omega

/-- Scalar form of compact-target sampling.  If the original target has
common-neighbour threshold `θ`, monotonicity of powers below one replaces
every pair-specific Chernoff term by the single worst-case term at `θ`.
Thus the union bound only sees the number `|U|^2` of ordered core pairs. -/
theorem exists_compact_robustPairSet_target_of_robust
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : Finset V) {θ : ℕ} (hrob : RobustPairSet G U T θ)
    (r K : ℕ) (sigma : ℝ≥0)
    (hsigma : sigma ≤ 1) (hK : 0 < K)
    (hsmall :
      ((U.card * U.card : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ r) +
        ((T.card : ℝ≥0) * sigma) / K < 1) :
    ∃ D : Finset V, D ⊆ T ∧ D.card < K ∧
      RobustPairSet G U D (r + 1) := by
  apply exists_compact_robustPairSet_target G U T r K sigma hsigma hK
  calc
    (∑ q ∈ U.product U,
        (1 - sigma / 2) ^
            (Erdos163.FiniteDefect.commonNeighbors G ![q.1, q.2] T).card /
          (1 / 2 : ℝ≥0) ^ r) +
        ((T.card : ℝ≥0) * sigma) / K ≤
      ((U.card * U.card : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ r) +
        ((T.card : ℝ≥0) * sigma) / K := by
      gcongr
      calc
        ∑ q ∈ U.product U,
            (1 - sigma / 2) ^
                (Erdos163.FiniteDefect.commonNeighbors G ![q.1, q.2] T).card /
              (1 / 2 : ℝ≥0) ^ r ≤
            ∑ _q ∈ U.product U,
              ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ r) := by
          apply Finset.sum_le_sum
          intro q hq
          have hmem := Finset.mem_product.mp hq
          apply div_le_div_of_nonneg_right _ zero_le
          apply NNReal.pow_antitone_exp θ
          · exact hrob q.1 hmem.1 q.2 hmem.2
          · exact tsub_le_self
        _ = ((U.card * U.card : ℕ) : ℝ≥0) *
              ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ r) := by
          simp [Finset.sum_const, nsmul_eq_mul]
    _ < 1 := hsmall

/-- A compact local hub records its core and its sampled routing target.
Unlike `IsLocalRobustHub`, the displayed region is only their union; it
does not retain the whole dense support in which DRC originally found the
core.  This is the form that can be greedily peeled at the KLS hub scale. -/
def IsCompactLocalRobustHub
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (θ τ M : ℕ) (H : Finset V) : Prop :=
  ∃ U D : Finset V, U.card = τ ∧ H = U ∪ D ∧ H.card < M ∧
    RobustPairSet G U D θ

/-- Named DRC output in the language used by hub arguments. -/
theorem exists_robustPairSet_univ_of_drc
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ t τ : ℕ} (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hdensity : ρ * Fintype.card V * Fintype.card V ≤ 2 * G.edgeFinset.card)
    (hθ : (θ : ℝ) ≤ η * ρ ^ 2 * Fintype.card V)
    (hτ : (τ : ℝ) ^ 2 ≤ ((ρ ^ t) * Fintype.card V) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card V : ℝ) ^ 2) :
    ∃ U : Finset V, τ ≤ U.card ∧ RobustPairSet G U Finset.univ θ := by
  obtain ⟨x, _hx, hUcard, hpairs⟩ := exists_drc_univ_with_all_pairs G ht hτpos
    hη hρ hdensity hθ hτ hsmall
  exact ⟨Erdos163.FiniteDefect.commonNeighbors G x Finset.univ, hUcard, hpairs⟩

/-- Minimum-degree-core specialization of robust-pair DRC.  The density
parameter is not hidden: every later numerical use can see exactly which
inequalities must be discharged. -/
theorem exists_robustPairSet_univ_of_le_two_mul_minDegree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {d θ t τ : ℕ} (hd : 0 < d) (hmin : d ≤ 2 * G.minDegree)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : (θ : ℝ) ≤ η *
      ((d : ℝ) / (2 * Fintype.card V)) ^ 2 * Fintype.card V)
    (hτ : (τ : ℝ) ^ 2 ≤
      ((((d : ℝ) / (2 * Fintype.card V)) ^ t) * Fintype.card V) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card V : ℝ) ^ 2) :
    ∃ U : Finset V, τ ≤ U.card ∧ RobustPairSet G U Finset.univ θ := by
  let ρ : ℝ := (d : ℝ) / (2 * Fintype.card V)
  obtain ⟨hρ, hdensity⟩ := drc_density_of_le_two_mul_minDegree G hd hmin
  apply exists_robustPairSet_univ_of_drc G ht hτpos hη hρ hdensity
  · simpa [ρ] using hθ
  · simpa [ρ] using hτ
  · simpa [ρ] using hsmall

/-- Localized DRC output.  The selected robust core is a genuine subset of
the prescribed dense piece S, while all common-neighbour routing takes
place in S itself.  This is the form stored by the greedy hub
decomposition. -/
theorem exists_local_robustPairSet_of_induced_drc
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {S : Finset V} (hS : S.Nonempty)
    {θ t τ : ℕ} (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hdensity : ρ * Fintype.card S * Fintype.card S ≤
      2 * (G.induce (S : Set V)).edgeFinset.card)
    (hθ : (θ : ℝ) ≤ η * ρ ^ 2 * Fintype.card S)
    (hτ : (τ : ℝ) ^ 2 ≤ ((ρ ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    ∃ U : Finset V, τ ≤ U.card ∧ U ⊆ S ∧ RobustPairSet G U S θ := by
  classical
  let H : SimpleGraph S := G.induce (S : Set V)
  let : Nonempty S := hS.to_subtype
  obtain ⟨U, hUcard, hrob⟩ :=
    exists_robustPairSet_univ_of_drc H ht hτpos hη hρ
      (by simpa [H] using hdensity)
      (by simpa [H] using hθ)
      (by simpa [H] using hτ)
      (by simpa [H] using hsmall)
  let U' : Finset V := liftSubtypeFinset S U
  refine ⟨U', ?_, ?_, ?_⟩
  · simpa [U', liftSubtypeFinset] using hUcard
  · intro v hv
    rcases Finset.mem_map.mp hv with ⟨u, _hu, rfl⟩
    exact u.property
  · have hrob' : RobustPairSet G (liftSubtypeFinset S U)
        (liftSubtypeFinset S (Finset.univ : Finset S)) θ :=
      RobustPairSet.of_induce G hrob
    have huniv : liftSubtypeFinset S (Finset.univ : Finset S) = S := by
      ext v
      simp [liftSubtypeFinset]
    rw [huniv] at hrob'
    simpa [U'] using hrob'

/-- A finite induced piece meets the four numerical inequalities needed by
the localized all-pairs DRC lemma.  Separating this predicate from the
extraction theorem lets the later BFS argument focus only on producing
dense pieces with these estimates. -/
def DrcAdmissiblePiece
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (θ t τ : ℕ) (η ρ : ℝ) (S : Finset V) : Prop :=
  S.Nonempty ∧
    ρ * Fintype.card S * Fintype.card S ≤
      2 * (G.induce (S : Set V)).edgeFinset.card ∧
    (θ : ℝ) ≤ η * ρ ^ 2 * Fintype.card S ∧
    (τ : ℝ) ^ 2 ≤ ((ρ ^ t) * Fintype.card S) ^ 2 / 2 ∧
    2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2

/-- Turán density supplies the density clause of DRC admissibility inside
every sufficiently large induced set.  The remaining three clauses are
left as visible parameter inequalities; later asymptotic estimates discharge
them uniformly for the chosen KLS scales. -/
theorem drcAdmissiblePiece_of_indepSetFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {n d θ t τ : ℕ} (hn : 2 ≤ n) (hd : 0 < d)
    (hfree : G.IndepSetFree n)
    (hsize : (n - 1) * (d + 1) ≤ S.card)
    {η : ℝ}
    (hθ : (θ : ℝ) ≤ η * ((d : ℝ) / S.card) ^ 2 * Fintype.card S)
    (hτ : (τ : ℝ) ^ 2 ≤
      ((((d : ℝ) / S.card) ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    DrcAdmissiblePiece G θ t τ η ((d : ℝ) / S.card) S := by
  have hSpos : 0 < S.card := by
    have hnpos : 0 < n - 1 := by omega
    have hprod : 0 < (n - 1) * (d + 1) := Nat.mul_pos hnpos (by omega)
    omega
  have hSne : S.Nonempty := Finset.card_pos.mp hSpos
  have havg := avg_degree_induce_ge_of_indepSetFree G hn hfree hsize
  have havgR : (d : ℝ) * S.card ≤
      2 * (G.induce (S : Set V)).edgeFinset.card := by
    exact_mod_cast havg
  refine ⟨hSne, ?_, hθ, hτ, hsmall⟩
  calc
    (d : ℝ) / S.card * Fintype.card S * Fintype.card S =
        (d : ℝ) * S.card := by
          simp only [Fintype.card_coe]
          field_simp
    _ ≤ 2 * (G.induce (S : Set V)).edgeFinset.card := havgR

/-- The named local-hub predicate stored by the greedy decomposition:
inside a region S there is a core of order at least τ whose every pair has
at least θ common neighbours in S. -/
def IsLocalRobustHub
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (θ τ : ℕ) (S : Finset V) : Prop :=
  ∃ U : Finset V, τ ≤ U.card ∧ U ⊆ S ∧ RobustPairSet G U S θ

/-- Forgetting the compact target decomposition gives an ordinary local
robust hub on the displayed compact region.  Target monotonicity is the only
step: all sampled common neighbours remain available in `U ∪ D`. -/
theorem IsCompactLocalRobustHub.isLocalRobustHub
    {V : Type*} [Fintype V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {θ τ M : ℕ} {H : Finset V}
    (h : IsCompactLocalRobustHub G θ τ M H) :
    IsLocalRobustHub G θ τ H := by
  rcases h with ⟨U, D, hUcard, rfl, _hcard, hrob⟩
  refine ⟨U, hUcard.ge, Finset.subset_union_left, ?_⟩
  exact hrob.mono_right Finset.subset_union_right

/-- Compress the target of a local DRC hub, after first normalizing its core
to exact order `τ`.  The returned compact region is contained in the
original dense support and has order strictly below `τ + K`; all later
routing can take place in its sampled target. -/
theorem exists_compactLocalRobustHub_of_isLocalRobustHub
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {Θ τ : ℕ} (hhub : IsLocalRobustHub G Θ τ S)
    (hτ : 0 < τ) (r K : ℕ) (sigma : ℝ≥0)
    (hsigma : sigma ≤ 1) (hK : 0 < K)
    (hsmall :
      ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ Θ / (1 / 2 : ℝ≥0) ^ r) +
        ((S.card : ℝ≥0) * sigma) / K < 1) :
    ∃ H : Finset V, H ⊆ S ∧ H.Nonempty ∧
      IsCompactLocalRobustHub G (r + 1) τ (τ + K) H := by
  classical
  obtain ⟨W, hWcard, hWS, hrobW⟩ := hhub
  obtain ⟨U, hUW, hUcard⟩ := Finset.exists_subset_card_eq hWcard
  have hrobU : RobustPairSet G U S Θ := hrobW.mono_left hUW
  have hsmall' :
      (∑ q ∈ U.product U,
        (1 - sigma / 2) ^
            (Erdos163.FiniteDefect.commonNeighbors G ![q.1, q.2] S).card /
          (1 / 2 : ℝ≥0) ^ r) +
        ((S.card : ℝ≥0) * sigma) / K < 1 := by
    calc
      _ ≤ ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ Θ / (1 / 2 : ℝ≥0) ^ r) +
        ((S.card : ℝ≥0) * sigma) / K := by
        gcongr
        calc
          ∑ q ∈ U.product U,
              (1 - sigma / 2) ^
                  (Erdos163.FiniteDefect.commonNeighbors G ![q.1, q.2] S).card /
                (1 / 2 : ℝ≥0) ^ r ≤
              ∑ _q ∈ U.product U,
                ((1 - sigma / 2) ^ Θ / (1 / 2 : ℝ≥0) ^ r) := by
            apply Finset.sum_le_sum
            intro q hq
            have hmem := Finset.mem_product.mp hq
            apply div_le_div_of_nonneg_right _ zero_le
            apply NNReal.pow_antitone_exp Θ
            · exact hrobU q.1 hmem.1 q.2 hmem.2
            · exact tsub_le_self
          _ = ((τ * τ : ℕ) : ℝ≥0) *
                ((1 - sigma / 2) ^ Θ / (1 / 2 : ℝ≥0) ^ r) := by
            simp [Finset.sum_const, nsmul_eq_mul, hUcard]
      _ < 1 := hsmall
  obtain ⟨D, hDS, hDcard, hrobD⟩ :=
    exists_compact_robustPairSet_target G U S r K sigma hsigma hK hsmall'
  let H : Finset V := U ∪ D
  have hUS : U ⊆ S := hUW.trans hWS
  have hHS : H ⊆ S := Finset.union_subset hUS hDS
  have hHne : H.Nonempty := by
    have hUpos : 0 < U.card := by simpa [hUcard] using hτ
    obtain ⟨u, hu⟩ := Finset.card_pos.mp hUpos
    exact ⟨u, Finset.mem_union_left D hu⟩
  refine ⟨H, hHS, hHne, U, D, hUcard, rfl, ?_, hrobD⟩
  have hcard : H.card ≤ U.card + D.card := Finset.card_union_le U D
  omega

/-- Greedy compact-hub peeling.  The dense extraction is allowed to find a
larger temporary support `R`, but only the sampled core--target union is
deleted.  A uniform bound `R.card ≤ Dmax` is enough to discharge the same
sampling inequality at every iteration. -/
theorem exists_disjoint_compactLocalRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {m Dmax Θ τ r K : ℕ} (hτ : 0 < τ) (hK : 0 < K)
    (sigma : ℝ≥0) (hsigma : sigma ≤ 1)
    (hextract : ∀ S : Finset V, m ≤ S.card →
      ∃ R : Finset V, R ⊆ S ∧ R.card ≤ Dmax ∧
        IsLocalRobustHub G Θ τ R)
    (hsample :
      ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ Θ / (1 / 2 : ℝ≥0) ^ r) +
        ((Dmax : ℝ≥0) * sigma) / K < 1) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactLocalRobustHub G (r + 1) τ (τ + K) H) ∧
      DisjointFinsetFamily F ∧ F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card < m := by
  apply exists_disjoint_family_covering_up_to
    (IsCompactLocalRobustHub G (r + 1) τ (τ + K)) m
  intro S hSm
  obtain ⟨R, hRS, hRcard, hhub⟩ := hextract S hSm
  have hsampleR :
      ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ Θ / (1 / 2 : ℝ≥0) ^ r) +
        ((R.card : ℝ≥0) * sigma) / K < 1 := by
    apply lt_of_le_of_lt _ hsample
    gcongr
  obtain ⟨H, hHR, hHne, hcompact⟩ :=
    exists_compactLocalRobustHub_of_isLocalRobustHub
      G hhub hτ r K sigma hsigma hK hsampleR
  exact ⟨H, hHR.trans hRS, hHne, hcompact⟩

/-! ### The large-`k` compact-target estimate -/

/-- Natural square root tends to infinity.  This elementary filter lemma is
recorded here because the sampling estimate is naturally parametrized by
`sqrt (sqrt k)`. -/
theorem tendsto_nat_sqrt_atTop : Tendsto Nat.sqrt atTop atTop := by
  rw [Filter.tendsto_atTop_atTop]
  intro b
  refine ⟨b ^ 2, fun a ha ↦ ?_⟩
  exact (Nat.le_sqrt').2 ha

theorem tendsto_natCast_sqrt_sqrt_atTop :
    Tendsto (fun k : ℕ ↦ (Nat.sqrt (Nat.sqrt k) : ℝ)) atTop atTop :=
  tendsto_natCast_atTop_atTop.comp
    (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop)

/-- A fourth-degree polynomial is eventually dominated by the fixed
exponential decay occurring in compact-target sampling. -/
theorem eventually_quartic_mul_exp_neg_lt_half :
    ∀ᶠ x : ℝ in atTop,
      (82944 * Real.exp (1 / 2) : ℝ) *
          (x ^ 4 * Real.exp (-(1 / (4 * 64 ^ 5)) * x)) < 1 / 2 := by
  have ht0 := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero
    (4 : ℝ) (1 / (4 * 64 ^ 5) : ℝ) (by positivity)
  have ht : Tendsto
      (fun x : ℝ ↦ x ^ 4 * Real.exp (-(1 / (4 * 64 ^ 5)) * x))
      atTop (𝓝 0) := by
    apply ht0.congr'
    filter_upwards with x
    have hx : x ^ (4 : ℝ) = x ^ (4 : ℕ) := by
      norm_num [Real.rpow_natCast]
    rw [hx]
  have ht' : Tendsto
      (fun x : ℝ ↦ (82944 * Real.exp (1 / 2) : ℝ) *
        (x ^ 4 * Real.exp (-(1 / (4 * 64 ^ 5)) * x)))
      atTop (𝓝 0) := by
    convert ht.const_mul (82944 * Real.exp (1 / 2) : ℝ) using 1 <;>
      simp
  exact ht'.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))

theorem eventually_quartic_mul_exp_neg_sqrt_sqrt_lt_half :
    ∀ᶠ k : ℕ in atTop,
      (82944 * Real.exp (1 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt k) : ℝ) ^ 4 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * Nat.sqrt (Nat.sqrt k))) < 1 / 2 :=
  tendsto_natCast_sqrt_sqrt_atTop.eventually
    eventually_quartic_mul_exp_neg_lt_half

/-- Pointwise numerical core of compact-target sampling.  Sampling each
vertex with probability `1 / sqrt k` leaves fewer than `8 * sqrt k`
vertices with positive probability, while every core pair keeps at least
seven common neighbours.  The first summand is controlled by exponential
decay in `sqrt (sqrt k)` and the second is below one half by the defining
inequalities for natural square root. -/
theorem compact_sampling_inequality_of_quartic_decay
    {k : ℕ} (hs : 1 ≤ Nat.sqrt k)
    (hdecay :
      (82944 * Real.exp (1 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt k) : ℝ) ^ 4 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * Nat.sqrt (Nat.sqrt k))) < 1 / 2) :
    ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
        ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
            (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5)) /
          (1 / 2 : ℝ≥0) ^ 6) +
      ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
        (8 * Nat.sqrt k)) < 1 := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let C : ℕ := 2 * 64 ^ 5
  let θ : ℕ := s * q / C
  let sigma : ℝ≥0 := 1 / (s : ℝ≥0)
  have hspos : 0 < s := by dsimp [s]; omega
  have hqpos : 0 < q := by
    dsimp [q]
    exact Nat.sqrt_pos.mpr hspos
  have hqone : 1 ≤ q := hqpos
  have hsqlt : s < (q + 1) ^ 2 := by
    dsimp [q]
    exact Nat.lt_succ_sqrt' s
  have hs2q4 : (s : ℝ) ^ 2 ≤ 16 * (q : ℝ) ^ 4 := by
    have hqsum : q + 1 ≤ 2 * q := by omega
    have hqsum2 := Nat.pow_le_pow_left hqsum 2
    have hsle : s ≤ 4 * q ^ 2 := by
      calc
        s ≤ (q + 1) ^ 2 := hsqlt.le
        _ ≤ (2 * q) ^ 2 := hqsum2
        _ = 4 * q ^ 2 := by ring
    have hsle2 := Nat.pow_le_pow_left hsle 2
    exact_mod_cast (show s ^ 2 ≤ 16 * q ^ 4 by
      calc
        s ^ 2 ≤ (4 * q ^ 2) ^ 2 := hsle2
        _ = 16 * q ^ 4 := by ring)
  have hsigma2 : sigma / 2 ≤ 1 := by
    have hsigma : sigma ≤ 1 := by
      dsimp [sigma]
      rw [div_le_one]
      · simpa using (show (1 : ℝ≥0) ≤ (s : ℝ≥0) by exact_mod_cast hs)
      · exact_mod_cast hspos
    exact (div_le_self (show 0 ≤ sigma from zero_le)
      (by norm_num : (1 : ℝ≥0) ≤ 2)).trans hsigma
  have hbaseCoe :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) = 1 - (1 / (s : ℝ)) / 2 := by
    rw [NNReal.coe_sub hsigma2]
    simp [sigma]
  have hbaseExp :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ≤
        Real.exp (-(1 / (s : ℝ) / 2)) := by
    rw [hbaseCoe]
    exact Real.one_sub_le_exp_neg _
  have hpowExp :
      (((1 - sigma / 2) ^ θ : ℝ≥0) : ℝ) ≤
        Real.exp (-((θ : ℝ) / (2 * s))) := by
    rw [NNReal.coe_pow]
    calc
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ^ θ ≤
          Real.exp (-(1 / (s : ℝ) / 2)) ^ θ :=
        pow_le_pow_left₀ (by positivity) hbaseExp θ
      _ = Real.exp (-((θ : ℝ) / (2 * s))) := by
        rw [← Real.exp_nat_mul]
        congr 1
        field_simp
  have hfloor : s * q ≤ C * θ + s * C := by
    have hlt : s * q < C * (s * q / C + 1) :=
      Nat.lt_mul_div_succ (s * q) (by positivity : 0 < C)
    dsimp [θ]
    have hCs : C ≤ s * C := by nlinarith
    omega
  have hexponent :
      -((θ : ℝ) / (2 * s)) ≤
        (1 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * q := by
    have hfloorR : (s : ℝ) * q ≤ C * θ + s * C := by exact_mod_cast hfloor
    dsimp [C] at hfloorR
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    field_simp
    nlinarith
  have htailExp :
      (((1 - sigma / 2) ^ θ : ℝ≥0) : ℝ) ≤
        Real.exp (1 / 2) *
          Real.exp (-(1 / (4 * 64 ^ 5)) * q) := by
    calc
      _ ≤ Real.exp (-((θ : ℝ) / (2 * s))) := hpowExp
      _ ≤ Real.exp ((1 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * q) :=
        Real.exp_le_exp.mpr hexponent
      _ = Real.exp (1 / 2) *
          Real.exp (-(1 / (4 * 64 ^ 5)) * q) := by
        rw [← Real.exp_add]
        congr 1
        ring
  have htail :
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ 6) : ℝ≥0) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    norm_num [div_eq_mul_inv]
    ring_nf
    have htailExp' :
        (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ θ) ≤
          Real.exp (1 / 2) *
            Real.exp (-(1 / (4 * 64 ^ 5)) * q) := by
      simpa [div_eq_mul_inv] using htailExp
    calc
      (s : ℝ) ^ 2 *
          (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ θ) * 5184 ≤
        5184 * (s : ℝ) ^ 2 *
          (Real.exp (1 / 2) *
            Real.exp (-(1 / (4 * 64 ^ 5)) * q)) := by
          nlinarith [mul_le_mul_of_nonneg_left htailExp'
            (show (0 : ℝ) ≤ 5184 * (s : ℝ) ^ 2 by positivity)]
      _ ≤ (82944 * Real.exp (1 / 2) : ℝ) *
          ((q : ℝ) ^ 4 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * q)) := by
          have hexpnonneg : 0 ≤ Real.exp (-(1 / (4 * 64 ^ 5)) * q) :=
            (Real.exp_pos _).le
          nlinarith [mul_le_mul_of_nonneg_right hs2q4
            (mul_nonneg (by positivity : 0 ≤ (5184 : ℝ) * Real.exp (1 / 2))
              hexpnonneg)]
      _ < 1 / 2 := by simpa [q, s] using hdecay
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hk4s : (k : ℝ) < 4 * (s : ℝ) ^ 2 := by
    have hkltR : (k : ℝ) < ((s + 1 : ℕ) : ℝ) ^ 2 := by exact_mod_cast hklt
    have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
    push_cast at hkltR
    nlinarith
  have hsize :
      (((k : ℝ≥0) * sigma / (8 * s) : ℝ≥0)) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    dsimp [sigma]
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    change (k : ℝ) * (1 / (s : ℝ)) / (8 * (s : ℝ)) < 1 / 2
    calc
      (k : ℝ) * (1 / (s : ℝ)) / (8 * (s : ℝ)) =
          (k : ℝ) / (8 * (s : ℝ) ^ 2) := by field_simp
      _ < (4 * (s : ℝ) ^ 2) / (8 * (s : ℝ) ^ 2) := by
        exact (div_lt_div_iff_of_pos_right (by positivity)).2 hk4s
      _ = 1 / 2 := by field_simp; norm_num
  change
    ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * sigma) / (8 * s) < 1)
  exact lt_of_lt_of_le (add_lt_add htail hsize) (by norm_num)

/-- The exact first-moment/union-bound inequality required by compact hub
sampling holds for all sufficiently large `k`. -/
theorem eventually_compact_sampling_inequality :
    ∀ᶠ k : ℕ in atTop,
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1 := by
  filter_upwards [eventually_ge_atTop 1,
    eventually_quartic_mul_exp_neg_sqrt_sqrt_lt_half] with k hk hdecay
  exact compact_sampling_inequality_of_quartic_decay
    ((Nat.le_sqrt').2 (by nlinarith)) hdecay

/-- The same exponential domination with the fixed loss incurred by first
reserving an alternating cycle. -/
theorem eventually_shifted_quartic_mul_exp_neg_lt_half :
    ∀ᶠ x : ℝ in atTop,
      (82944 * Real.exp (19 / 2) : ℝ) *
          (x ^ 4 * Real.exp (-(1 / (4 * 64 ^ 5)) * x)) < 1 / 2 := by
  have ht0 := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero
    (4 : ℝ) (1 / (4 * 64 ^ 5) : ℝ) (by positivity)
  have ht : Tendsto
      (fun x : ℝ ↦ x ^ 4 * Real.exp (-(1 / (4 * 64 ^ 5)) * x))
      atTop (𝓝 0) := by
    apply ht0.congr'
    filter_upwards with x
    have hx : x ^ (4 : ℝ) = x ^ (4 : ℕ) := by
      norm_num [Real.rpow_natCast]
    rw [hx]
  have ht' : Tendsto
      (fun x : ℝ ↦ (82944 * Real.exp (19 / 2) : ℝ) *
        (x ^ 4 * Real.exp (-(1 / (4 * 64 ^ 5)) * x)))
      atTop (𝓝 0) := by
    convert ht.const_mul (82944 * Real.exp (19 / 2) : ℝ) using 1 <;>
      simp
  exact ht'.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))

theorem eventually_shifted_quartic_mul_exp_neg_sqrt_sqrt_lt_half :
    ∀ᶠ k : ℕ in atTop,
      (82944 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt k) : ℝ) ^ 4 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * Nat.sqrt (Nat.sqrt k))) < 1 / 2 :=
  tendsto_natCast_sqrt_sqrt_atTop.eventually
    eventually_shifted_quartic_mul_exp_neg_lt_half

/-- The eighth-root scale used to make the sampled connector set
`o(sqrt k)` still tends to infinity. -/
theorem tendsto_natCast_sqrt_sqrt_sqrt_atTop :
    Tendsto
      (fun k : ℕ ↦ (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) : ℝ))
      atTop atTop :=
  tendsto_natCast_atTop_atTop.comp
    (tendsto_nat_sqrt_atTop.comp
      (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop))

/-- An eighth-degree polynomial is eventually dominated by the exponential
decay left after sampling at probability `1 / (sqrt k * k^(1/8))`. -/
theorem eventually_octavic_mul_exp_neg_lt_half :
    ∀ᶠ x : ℝ in atTop,
      (21233664 * Real.exp (19 / 2) : ℝ) *
          (x ^ 8 * Real.exp (-(1 / (4 * 64 ^ 5)) * x)) < 1 / 2 := by
  have ht0 := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero
    (8 : ℝ) (1 / (4 * 64 ^ 5) : ℝ) (by positivity)
  have ht : Tendsto
      (fun x : ℝ ↦ x ^ 8 * Real.exp (-(1 / (4 * 64 ^ 5)) * x))
      atTop (𝓝 0) := by
    apply ht0.congr'
    filter_upwards with x
    have hx : x ^ (8 : ℝ) = x ^ (8 : ℕ) := by
      norm_num [Real.rpow_natCast]
    rw [hx]
  have ht' : Tendsto
      (fun x : ℝ ↦ (21233664 * Real.exp (19 / 2) : ℝ) *
        (x ^ 8 * Real.exp (-(1 / (4 * 64 ^ 5)) * x)))
      atTop (𝓝 0) := by
    convert ht.const_mul (21233664 * Real.exp (19 / 2) : ℝ) using 1 <;>
      simp
  exact ht'.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))

theorem eventually_octavic_mul_exp_neg_sqrt_sqrt_sqrt_lt_half :
    ∀ᶠ k : ℕ in atTop,
