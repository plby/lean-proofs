      (fun x : ℝ ↦ x ^ 8 * Real.exp (-(1 / (2 * C : ℝ)) * x))
      atTop (𝓝 0) := by
    apply ht0.congr'
    filter_upwards with x
    have hx : x ^ (8 : ℝ) = x ^ (8 : ℕ) := by
      norm_num [Real.rpow_natCast]
    rw [hx]
  have ht' : Tendsto
      (fun x : ℝ ↦ (21233664 * Real.exp (19 / 2) : ℝ) *
        (x ^ 8 * Real.exp (-(1 / (2 * C : ℝ)) * x)))
      atTop (𝓝 0) := by
    convert ht.const_mul (21233664 * Real.exp (19 / 2) : ℝ) using 1 <;>
      simp
  exact ht'.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))

theorem eventually_octavic_mul_exp_neg_sqrt_sqrt_sqrt_lt_half_of_denominator
    (C : ℕ) (hC : 0 < C) :
    ∀ᶠ k : ℕ in atTop,
      (21233664 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt (Nat.sqrt k)) : ℝ) ^ 8 *
            Real.exp (-(1 / (2 * C : ℝ)) *
              Nat.sqrt (Nat.sqrt (Nat.sqrt k)))) < 1 / 2 :=
  tendsto_natCast_sqrt_sqrt_sqrt_atTop.eventually
    (eventually_octavic_mul_exp_neg_lt_half_of_denominator C hC)

/-- Pointwise thin-target estimate.  Writing `s = sqrt k` and
`r = sqrt (sqrt s)`, sampling with probability `1/(s*r)` leaves fewer than
`8*(s/r+1)=o(s)` connectors while preserving seven common neighbours for
every ordered core pair. -/
theorem thin_alternating_sampling_inequality_of_octavic_decay
    {k : ℕ} (hs : 1 ≤ Nat.sqrt k)
    (hrbig : 19 * (2 * 64 ^ 5) ≤
      Nat.sqrt (Nat.sqrt (Nat.sqrt k)))
    (hdecay :
      (21233664 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt (Nat.sqrt k)) : ℝ) ^ 8 *
            Real.exp (-(1 / (4 * 64 ^ 5)) *
              Nat.sqrt (Nat.sqrt (Nat.sqrt k)))) < 1 / 2) :
    let s := Nat.sqrt k
    let r := Nat.sqrt (Nat.sqrt s)
    let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
    let K := 8 * (s / r + 1)
    ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
        ((1 - sigma / 2) ^
            (s * Nat.sqrt s / (2 * 64 ^ 5) - 2 * (9 * s)) /
          (1 / 2 : ℝ≥0) ^ 6) +
      ((k : ℝ≥0) * sigma) / K) < 1 := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let r : ℕ := Nat.sqrt q
  let C : ℕ := 2 * 64 ^ 5
  let theta0 : ℕ := s * q / C
  let theta : ℕ := theta0 - 2 * (9 * s)
  let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
  let K : ℕ := 8 * (s / r + 1)
  have hspos : 0 < s := by dsimp [s]; omega
  have hqpos : 0 < q := by
    dsimp [q]
    exact Nat.sqrt_pos.mpr hspos
  have hrpos : 0 < r := by
    dsimp [r]
    exact Nat.sqrt_pos.mpr hqpos
  have hrone : 1 ≤ r := hrpos
  have hrq : r ≤ q := by
    dsimp [r]
    exact Nat.sqrt_le_self q
  have hqBig : 19 * C ≤ q := by
    have hCr : 19 * C ≤ r := by
      simpa [r, q, s, C] using hrbig
    exact hCr.trans hrq
  have hrSq : r ^ 2 ≤ q := by
    dsimp [r]
    exact Nat.sqrt_le' q
  have hqLt : q < (r + 1) ^ 2 := by
    dsimp [r]
    exact Nat.lt_succ_sqrt' q
  have hqLe : q ≤ 4 * r ^ 2 := by
    have hrSum : r + 1 ≤ 2 * r := by omega
    calc
      q ≤ (r + 1) ^ 2 := hqLt.le
      _ ≤ (2 * r) ^ 2 := Nat.pow_le_pow_left hrSum 2
      _ = 4 * r ^ 2 := by ring
  have hsLt : s < (q + 1) ^ 2 := by
    dsimp [q]
    exact Nat.lt_succ_sqrt' s
  have hsLe : s ≤ 64 * r ^ 4 := by
    have hqOne : 1 ≤ q := hqpos
    have hqSum : q + 1 ≤ 2 * q := by omega
    have hs4q : s ≤ 4 * q ^ 2 := by
      calc
        s ≤ (q + 1) ^ 2 := hsLt.le
        _ ≤ (2 * q) ^ 2 := Nat.pow_le_pow_left hqSum 2
        _ = 4 * q ^ 2 := by ring
    calc
      s ≤ 4 * q ^ 2 := hs4q
      _ ≤ 4 * (4 * r ^ 2) ^ 2 := by gcongr
      _ = 64 * r ^ 4 := by ring
  have hs2r8 : (s : ℝ) ^ 2 ≤ 4096 * (r : ℝ) ^ 8 := by
    have hsq := Nat.pow_le_pow_left hsLe 2
    exact_mod_cast (show s ^ 2 ≤ 4096 * r ^ 8 by
      calc
        s ^ 2 ≤ (64 * r ^ 4) ^ 2 := hsq
        _ = 4096 * r ^ 8 := by ring)
  have hsigma : sigma ≤ 1 := by
    dsimp [sigma]
    rw [div_le_one]
    · exact_mod_cast (Nat.mul_pos hspos hrpos)
    · exact_mod_cast (Nat.mul_pos hspos hrpos)
  have hsigma2 : sigma / 2 ≤ 1 :=
    (div_le_self (show 0 ≤ sigma from zero_le)
      (by norm_num : (1 : ℝ≥0) ≤ 2)).trans hsigma
  have hbaseCoe :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) =
        1 - (1 / ((s : ℝ) * r)) / 2 := by
    rw [NNReal.coe_sub hsigma2]
    simp [sigma]
  have hbaseExp :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ≤
        Real.exp (-(1 / ((s : ℝ) * r) / 2)) := by
    rw [hbaseCoe]
    exact Real.one_sub_le_exp_neg _
  have hpowExp :
      (((1 - sigma / 2) ^ theta : ℝ≥0) : ℝ) ≤
        Real.exp (-((theta : ℝ) / (2 * s * r))) := by
    rw [NNReal.coe_pow]
    calc
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ^ theta ≤
          Real.exp (-(1 / ((s : ℝ) * r) / 2)) ^ theta :=
        pow_le_pow_left₀ (by positivity) hbaseExp theta
      _ = Real.exp (-((theta : ℝ) / (2 * s * r))) := by
        rw [← Real.exp_nat_mul]
        congr 1
        field_simp
  have h18 : 18 * s ≤ theta0 := by
    apply (Nat.le_div_iff_mul_le (by positivity : 0 < C)).2
    have h18C : 18 * C ≤ q :=
      (Nat.mul_le_mul_right C (by norm_num : 18 ≤ 19)).trans hqBig
    calc
      18 * s * C = s * (18 * C) := by ring
      _ ≤ s * q := Nat.mul_le_mul_left _ h18C
  have hsplit : theta + 18 * s = theta0 := by
    dsimp [theta]
    omega
  have hfloor : s * q ≤ C * theta + 19 * s * C := by
    have hlt : s * q < C * (s * q / C + 1) :=
      Nat.lt_mul_div_succ (s * q) (by positivity : 0 < C)
    have hle : s * q ≤ C * (theta0 + 1) := by
      simpa [theta0] using hlt.le
    calc
      s * q ≤ C * (theta0 + 1) := hle
      _ = C * theta + 18 * s * C + C := by rw [← hsplit]; ring
      _ ≤ C * theta + 19 * s * C := by
        have hCs : C ≤ s * C := by nlinarith
        calc
          C * theta + 18 * s * C + C ≤
              C * theta + 18 * s * C + s * C :=
            Nat.add_le_add_left hCs _
          _ = C * theta + 19 * s * C := by ring
  have hexponent0 :
      -((theta : ℝ) / (2 * s * r)) ≤
        (19 : ℝ) / 2 - (q : ℝ) / (2 * C * r) := by
    have hfloorR : (s : ℝ) * q ≤ C * theta + 19 * s * C := by
      exact_mod_cast hfloor
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    have hrR : (0 : ℝ) < r := by exact_mod_cast hrpos
    have hrRone : (1 : ℝ) ≤ r := by exact_mod_cast hrone
    have h19 : (19 : ℝ) * s * C ≤ 19 * s * r * C := by
      calc
        (19 : ℝ) * s * C ≤ ((19 : ℝ) * s * C) * r :=
          le_mul_of_one_le_right (by positivity) hrRone
        _ = 19 * s * r * C := by ring
    have hfloorR' : (s : ℝ) * q ≤ C * theta + 19 * s * r * C := by
      nlinarith [hfloorR, h19]
    dsimp [C] at hfloorR' ⊢
    field_simp
    nlinarith [hfloorR']
  have hqr : (r : ℝ) ≤ (q : ℝ) / r := by
    have hrR : (0 : ℝ) < r := by exact_mod_cast hrpos
    rw [le_div_iff₀ hrR]
    exact_mod_cast (show r * r ≤ q by simpa [pow_two] using hrSq)
  have hexponent :
      -((theta : ℝ) / (2 * s * r)) ≤
        (19 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * r := by
    calc
      _ ≤ (19 : ℝ) / 2 - (q : ℝ) / (2 * C * r) := hexponent0
      _ ≤ (19 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * r := by
        dsimp [C]
        have := hqr
        field_simp at this ⊢
        nlinarith
  have htailExp :
      (((1 - sigma / 2) ^ theta : ℝ≥0) : ℝ) ≤
        Real.exp (19 / 2) *
          Real.exp (-(1 / (4 * 64 ^ 5)) * r) := by
    calc
      _ ≤ Real.exp (-((theta : ℝ) / (2 * s * r))) := hpowExp
      _ ≤ Real.exp ((19 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * r) :=
        Real.exp_le_exp.mpr hexponent
      _ = Real.exp (19 / 2) *
          Real.exp (-(1 / (4 * 64 ^ 5)) * r) := by
        rw [← Real.exp_add]
        congr 1
        ring
  have htail :
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ theta / (1 / 2 : ℝ≥0) ^ 6) : ℝ≥0) <
        1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    norm_num [div_eq_mul_inv]
    ring_nf
    have htailExp' :
        (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ theta) ≤
          Real.exp (19 / 2) *
            Real.exp (-(1 / (4 * 64 ^ 5)) * r) := by
      simpa [div_eq_mul_inv] using htailExp
    calc
      (s : ℝ) ^ 2 *
          (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ theta) * 5184 ≤
        5184 * (s : ℝ) ^ 2 *
          (Real.exp (19 / 2) *
            Real.exp (-(1 / (4 * 64 ^ 5)) * r)) := by
          nlinarith [mul_le_mul_of_nonneg_left htailExp'
            (show (0 : ℝ) ≤ 5184 * (s : ℝ) ^ 2 by positivity)]
      _ ≤ (21233664 * Real.exp (19 / 2) : ℝ) *
          ((r : ℝ) ^ 8 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * r)) := by
          have hexpnonneg : 0 ≤ Real.exp (-(1 / (4 * 64 ^ 5)) * r) :=
            (Real.exp_pos _).le
          nlinarith [mul_le_mul_of_nonneg_right hs2r8
            (mul_nonneg
              (by positivity : 0 ≤ (5184 : ℝ) * Real.exp (19 / 2))
              hexpnonneg)]
      _ < 1 / 2 := by simpa [r, q, s] using hdecay
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hk4s : (k : ℝ) < 4 * (s : ℝ) ^ 2 := by
    have hkltR : (k : ℝ) < ((s + 1 : ℕ) : ℝ) ^ 2 := by exact_mod_cast hklt
    have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
    push_cast at hkltR
    nlinarith
  have hdivNat : s < r * (s / r + 1) :=
    Nat.lt_mul_div_succ s hrpos
  have hdivR : (s : ℝ) < r * (((s / r : ℕ) : ℝ) + 1) := by
    exact_mod_cast hdivNat
  have hdenpos : (0 : ℝ) <
      8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1) := by positivity
  have hden : 8 * (s : ℝ) ^ 2 <
      8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1) := by
    have hmul := mul_lt_mul_of_pos_left hdivR
      (show (0 : ℝ) < 8 * s by positivity)
    calc
      8 * (s : ℝ) ^ 2 = (8 * s) * s := by ring
      _ < (8 * s) * (r * (((s / r : ℕ) : ℝ) + 1)) := hmul
      _ = 8 * s * r * (((s / r : ℕ) : ℝ) + 1) := by ring
  have hsize : (((k : ℝ≥0) * sigma / K : ℝ≥0)) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    dsimp [sigma, K]
    push_cast
    change (k : ℝ) * (1 / ((s : ℝ) * r)) /
      (8 * (((s / r : ℕ) : ℝ) + 1)) < 1 / 2
    calc
      _ = (k : ℝ) /
          (8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1)) := by
        field_simp
      _ < (4 * (s : ℝ) ^ 2) /
          (8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1)) :=
        (div_lt_div_iff_of_pos_right hdenpos).2 hk4s
      _ < 1 / 2 := by
        rw [div_lt_iff₀ hdenpos]
        have hhalf := mul_lt_mul_of_pos_left hden
          (by norm_num : (0 : ℝ) < 1 / 2)
        convert hhalf using 1 <;> ring
  change
    ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ theta / (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * sigma) / K < 1)
  exact lt_of_lt_of_le (add_lt_add htail hsize) (by norm_num)

/-- Pointwise thin-target estimate with an arbitrary fixed DRC denominator.
The proof keeps the exact natural-number floors used by the compact-hub
sampler; only the exponential rate changes from `1/(4*64^5)` to `1/(2*C)`.-/
theorem thin_alternating_sampling_inequality_of_octavic_decay_of_denominator
    {C k : ℕ} (hC : 0 < C) (hs : 1 ≤ Nat.sqrt k)
    (hrbig : 19 * C ≤ Nat.sqrt (Nat.sqrt (Nat.sqrt k)))
    (hdecay :
      (21233664 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt (Nat.sqrt k)) : ℝ) ^ 8 *
            Real.exp (-(1 / (2 * C : ℝ)) *
              Nat.sqrt (Nat.sqrt (Nat.sqrt k)))) < 1 / 2) :
    let s := Nat.sqrt k
    let r := Nat.sqrt (Nat.sqrt s)
    let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
    let K := 8 * (s / r + 1)
    ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
        ((1 - sigma / 2) ^
            (s * Nat.sqrt s / C - 2 * (9 * s)) /
          (1 / 2 : ℝ≥0) ^ 6) +
      ((k : ℝ≥0) * sigma) / K) < 1 := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let r : ℕ := Nat.sqrt q
  let theta0 : ℕ := s * q / C
  let theta : ℕ := theta0 - 2 * (9 * s)
  let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
  let K : ℕ := 8 * (s / r + 1)
  have hspos : 0 < s := by dsimp [s]; omega
  have hqpos : 0 < q := by
    dsimp [q]
    exact Nat.sqrt_pos.mpr hspos
  have hrpos : 0 < r := by
    dsimp [r]
    exact Nat.sqrt_pos.mpr hqpos
  have hrone : 1 ≤ r := hrpos
  have hrq : r ≤ q := by
    dsimp [r]
    exact Nat.sqrt_le_self q
  have hqBig : 19 * C ≤ q := by
    have hCr : 19 * C ≤ r := by
      simpa [r, q, s] using hrbig
    exact hCr.trans hrq
  have hrSq : r ^ 2 ≤ q := by
    dsimp [r]
    exact Nat.sqrt_le' q
  have hqLt : q < (r + 1) ^ 2 := by
    dsimp [r]
    exact Nat.lt_succ_sqrt' q
  have hqLe : q ≤ 4 * r ^ 2 := by
    have hrSum : r + 1 ≤ 2 * r := by omega
    calc
      q ≤ (r + 1) ^ 2 := hqLt.le
      _ ≤ (2 * r) ^ 2 := Nat.pow_le_pow_left hrSum 2
      _ = 4 * r ^ 2 := by ring
  have hsLt : s < (q + 1) ^ 2 := by
    dsimp [q]
    exact Nat.lt_succ_sqrt' s
  have hsLe : s ≤ 64 * r ^ 4 := by
    have hqOne : 1 ≤ q := hqpos
    have hqSum : q + 1 ≤ 2 * q := by omega
    have hs4q : s ≤ 4 * q ^ 2 := by
      calc
        s ≤ (q + 1) ^ 2 := hsLt.le
        _ ≤ (2 * q) ^ 2 := Nat.pow_le_pow_left hqSum 2
        _ = 4 * q ^ 2 := by ring
    calc
      s ≤ 4 * q ^ 2 := hs4q
      _ ≤ 4 * (4 * r ^ 2) ^ 2 := by gcongr
      _ = 64 * r ^ 4 := by ring
  have hs2r8 : (s : ℝ) ^ 2 ≤ 4096 * (r : ℝ) ^ 8 := by
    have hsq := Nat.pow_le_pow_left hsLe 2
    exact_mod_cast (show s ^ 2 ≤ 4096 * r ^ 8 by
      calc
        s ^ 2 ≤ (64 * r ^ 4) ^ 2 := hsq
        _ = 4096 * r ^ 8 := by ring)
  have hsigma : sigma ≤ 1 := by
    dsimp [sigma]
    rw [div_le_one]
    · exact_mod_cast (Nat.mul_pos hspos hrpos)
    · exact_mod_cast (Nat.mul_pos hspos hrpos)
  have hsigma2 : sigma / 2 ≤ 1 :=
    (div_le_self (show 0 ≤ sigma from zero_le)
      (by norm_num : (1 : ℝ≥0) ≤ 2)).trans hsigma
  have hbaseCoe :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) =
        1 - (1 / ((s : ℝ) * r)) / 2 := by
    rw [NNReal.coe_sub hsigma2]
    simp [sigma]
  have hbaseExp :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ≤
        Real.exp (-(1 / ((s : ℝ) * r) / 2)) := by
    rw [hbaseCoe]
    exact Real.one_sub_le_exp_neg _
  have hpowExp :
      (((1 - sigma / 2) ^ theta : ℝ≥0) : ℝ) ≤
        Real.exp (-((theta : ℝ) / (2 * s * r))) := by
    rw [NNReal.coe_pow]
    calc
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ^ theta ≤
          Real.exp (-(1 / ((s : ℝ) * r) / 2)) ^ theta :=
        pow_le_pow_left₀ (by positivity) hbaseExp theta
      _ = Real.exp (-((theta : ℝ) / (2 * s * r))) := by
        rw [← Real.exp_nat_mul]
        congr 1
        field_simp
  have h18 : 18 * s ≤ theta0 := by
    apply (Nat.le_div_iff_mul_le hC).2
    have h18C : 18 * C ≤ q :=
      (Nat.mul_le_mul_right C (by norm_num : 18 ≤ 19)).trans hqBig
    calc
      18 * s * C = s * (18 * C) := by ring
      _ ≤ s * q := Nat.mul_le_mul_left _ h18C
  have hsplit : theta + 18 * s = theta0 := by
    dsimp [theta]
    omega
  have hfloor : s * q ≤ C * theta + 19 * s * C := by
    have hlt : s * q < C * (s * q / C + 1) :=
      Nat.lt_mul_div_succ (s * q) hC
    have hle : s * q ≤ C * (theta0 + 1) := by
      simpa [theta0] using hlt.le
    calc
      s * q ≤ C * (theta0 + 1) := hle
      _ = C * theta + 18 * s * C + C := by rw [← hsplit]; ring
      _ ≤ C * theta + 19 * s * C := by
        have hCs : C ≤ s * C := by nlinarith
        calc
          C * theta + 18 * s * C + C ≤
              C * theta + 18 * s * C + s * C :=
            Nat.add_le_add_left hCs _
          _ = C * theta + 19 * s * C := by ring
  have hexponent0 :
      -((theta : ℝ) / (2 * s * r)) ≤
        (19 : ℝ) / 2 - (q : ℝ) / (2 * C * r) := by
    have hfloorR : (s : ℝ) * q ≤ C * theta + 19 * s * C := by
      exact_mod_cast hfloor
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    have hrR : (0 : ℝ) < r := by exact_mod_cast hrpos
    have hrRone : (1 : ℝ) ≤ r := by exact_mod_cast hrone
    have h19 : (19 : ℝ) * s * C ≤ 19 * s * r * C := by
      calc
        (19 : ℝ) * s * C ≤ ((19 : ℝ) * s * C) * r :=
          le_mul_of_one_le_right (by positivity) hrRone
        _ = 19 * s * r * C := by ring
    have hfloorR' : (s : ℝ) * q ≤ C * theta + 19 * s * r * C := by
      nlinarith [hfloorR, h19]
    field_simp
    nlinarith [hfloorR']
  have hqr : (r : ℝ) ≤ (q : ℝ) / r := by
    have hrR : (0 : ℝ) < r := by exact_mod_cast hrpos
    rw [le_div_iff₀ hrR]
    exact_mod_cast (show r * r ≤ q by simpa [pow_two] using hrSq)
  have hexponent :
      -((theta : ℝ) / (2 * s * r)) ≤
        (19 : ℝ) / 2 - (1 / (2 * C : ℝ)) * r := by
    calc
      _ ≤ (19 : ℝ) / 2 - (q : ℝ) / (2 * C * r) := hexponent0
      _ ≤ (19 : ℝ) / 2 - (1 / (2 * C : ℝ)) * r := by
        have := hqr
        field_simp at this ⊢
        nlinarith
  have htailExp :
      (((1 - sigma / 2) ^ theta : ℝ≥0) : ℝ) ≤
        Real.exp (19 / 2) *
          Real.exp (-(1 / (2 * C : ℝ)) * r) := by
    calc
      _ ≤ Real.exp (-((theta : ℝ) / (2 * s * r))) := hpowExp
      _ ≤ Real.exp ((19 : ℝ) / 2 - (1 / (2 * C : ℝ)) * r) :=
        Real.exp_le_exp.mpr hexponent
      _ = Real.exp (19 / 2) *
          Real.exp (-(1 / (2 * C : ℝ)) * r) := by
        rw [← Real.exp_add]
        congr 1
        ring
  have htail :
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ theta / (1 / 2 : ℝ≥0) ^ 6) : ℝ≥0) <
        1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    norm_num [div_eq_mul_inv]
    ring_nf
    have htailExp' :
        (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ theta) ≤
          Real.exp (19 / 2) *
            Real.exp (-(1 / (2 * C : ℝ)) * r) := by
      simpa [div_eq_mul_inv] using htailExp
    calc
      (s : ℝ) ^ 2 *
          (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ theta) * 5184 ≤
        5184 * (s : ℝ) ^ 2 *
          (Real.exp (19 / 2) *
            Real.exp (-(1 / (2 * C : ℝ)) * r)) := by
          nlinarith [mul_le_mul_of_nonneg_left htailExp'
            (show (0 : ℝ) ≤ 5184 * (s : ℝ) ^ 2 by positivity)]
      _ ≤ (21233664 * Real.exp (19 / 2) : ℝ) *
          ((r : ℝ) ^ 8 *
            Real.exp (-(1 / (2 * C : ℝ)) * r)) := by
          have hexpnonneg : 0 ≤ Real.exp (-(1 / (2 * C : ℝ)) * r) :=
            (Real.exp_pos _).le
          nlinarith [mul_le_mul_of_nonneg_right hs2r8
            (mul_nonneg
              (by positivity : 0 ≤ (5184 : ℝ) * Real.exp (19 / 2))
              hexpnonneg)]
      _ < 1 / 2 := by simpa [r, q, s] using hdecay
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hk4s : (k : ℝ) < 4 * (s : ℝ) ^ 2 := by
    have hkltR : (k : ℝ) < ((s + 1 : ℕ) : ℝ) ^ 2 := by exact_mod_cast hklt
    have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
    push_cast at hkltR
    nlinarith
  have hdivNat : s < r * (s / r + 1) :=
    Nat.lt_mul_div_succ s hrpos
  have hdivR : (s : ℝ) < r * (((s / r : ℕ) : ℝ) + 1) := by
    exact_mod_cast hdivNat
  have hdenpos : (0 : ℝ) <
      8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1) := by positivity
  have hden : 8 * (s : ℝ) ^ 2 <
      8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1) := by
    have hmul := mul_lt_mul_of_pos_left hdivR
      (show (0 : ℝ) < 8 * s by positivity)
    calc
      8 * (s : ℝ) ^ 2 = (8 * s) * s := by ring
      _ < (8 * s) * (r * (((s / r : ℕ) : ℝ) + 1)) := hmul
      _ = 8 * s * r * (((s / r : ℕ) : ℝ) + 1) := by ring
  have hsize : (((k : ℝ≥0) * sigma / K : ℝ≥0)) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    dsimp [sigma, K]
    push_cast
    change (k : ℝ) * (1 / ((s : ℝ) * r)) /
      (8 * (((s / r : ℕ) : ℝ) + 1)) < 1 / 2
    calc
      _ = (k : ℝ) /
          (8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1)) := by
        field_simp
      _ < (4 * (s : ℝ) ^ 2) /
          (8 * (s : ℝ) * r * (((s / r : ℕ) : ℝ) + 1)) :=
        (div_lt_div_iff_of_pos_right hdenpos).2 hk4s
      _ < 1 / 2 := by
        rw [div_lt_iff₀ hdenpos]
        have hhalf := mul_lt_mul_of_pos_left hden
          (by norm_num : (0 : ℝ) < 1 / 2)
        convert hhalf using 1 <;> ring
  change
    ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ theta / (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * sigma) / K < 1)
  exact lt_of_lt_of_le (add_lt_add htail hsize) (by norm_num)

/-- Uniform denominator-parameterized thin-target first-moment inequality. -/
theorem eventually_thin_alternating_sampling_inequality_of_denominator
    (C : ℕ) (hC : 0 < C) :
    ∀ᶠ k : ℕ in atTop,
      let s := Nat.sqrt k
      let r := Nat.sqrt (Nat.sqrt s)
      let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
      let K := 8 * (s / r + 1)
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^
              (s * Nat.sqrt s / C - 2 * (9 * s)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * sigma) / K) < 1 := by
  filter_upwards [eventually_ge_atTop 1,
    (tendsto_nat_sqrt_atTop.comp
      (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop)).eventually
        (eventually_ge_atTop (19 * C)),
    eventually_octavic_mul_exp_neg_sqrt_sqrt_sqrt_lt_half_of_denominator
      C hC] with k hk hrbig hdecay
  exact thin_alternating_sampling_inequality_of_octavic_decay_of_denominator
    hC ((Nat.le_sqrt').2 (by nlinarith)) hrbig hdecay

/-- Uniform thin-target first-moment inequality. -/
theorem eventually_thin_alternating_sampling_inequality :
    ∀ᶠ k : ℕ in atTop,
      let s := Nat.sqrt k
      let r := Nat.sqrt (Nat.sqrt s)
      let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
      let K := 8 * (s / r + 1)
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^
              (s * Nat.sqrt s / (2 * 64 ^ 5) - 2 * (9 * s)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * sigma) / K) < 1 := by
  filter_upwards [eventually_ge_atTop 1,
    (tendsto_nat_sqrt_atTop.comp
      (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop)).eventually
        (eventually_ge_atTop (19 * (2 * 64 ^ 5))),
    eventually_octavic_mul_exp_neg_sqrt_sqrt_sqrt_lt_half]
      with k hk hrbig hdecay
  exact thin_alternating_sampling_inequality_of_octavic_decay
    ((Nat.le_sqrt').2 (by nlinarith)) hrbig hdecay

/-- Reserving the `2 * 9 sqrt k` vertices of the alternating scaffold before
sampling still leaves exponential room.  The loss changes only the fixed
factor `exp(1/2)` in the original estimate to `exp(19/2)`. -/
theorem compact_alternating_sampling_inequality_of_quartic_decay
    {k : ℕ} (hs : 1 ≤ Nat.sqrt k)
    (hqbig : 19 * (2 * 64 ^ 5) ≤ Nat.sqrt (Nat.sqrt k))
    (hdecay :
      (82944 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt k) : ℝ) ^ 4 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * Nat.sqrt (Nat.sqrt k))) < 1 / 2) :
    ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
        ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
            (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5) -
              2 * (9 * Nat.sqrt k)) /
          (1 / 2 : ℝ≥0) ^ 6) +
      ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
        (8 * Nat.sqrt k)) < 1 := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let C : ℕ := 2 * 64 ^ 5
  let θ₀ : ℕ := s * q / C
  let θ : ℕ := θ₀ - 18 * s
  let sigma : ℝ≥0 := 1 / (s : ℝ≥0)
  have hspos : 0 < s := by dsimp [s]; omega
  have hqpos : 0 < q := by
    dsimp [q]
    exact Nat.sqrt_pos.mpr hspos
  have hqone : 1 ≤ q := hqpos
  have hsqlt : s < (q + 1) ^ 2 := by
    dsimp [q]
    exact Nat.lt_succ_sqrt' s
  have hs2q4 : (s : ℝ) ^ 2 ≤ 16 * (q : ℝ) ^ 4 := by
    have hqsum : q + 1 ≤ 2 * q := by omega
    have hqsum2 := Nat.pow_le_pow_left hqsum 2
    have hsle : s ≤ 4 * q ^ 2 := by
      calc
        s ≤ (q + 1) ^ 2 := hsqlt.le
        _ ≤ (2 * q) ^ 2 := hqsum2
        _ = 4 * q ^ 2 := by ring
    have hsle2 := Nat.pow_le_pow_left hsle 2
    exact_mod_cast (show s ^ 2 ≤ 16 * q ^ 4 by
      calc
        s ^ 2 ≤ (4 * q ^ 2) ^ 2 := hsle2
        _ = 16 * q ^ 4 := by ring)
  have hsigma2 : sigma / 2 ≤ 1 := by
    have hsigma : sigma ≤ 1 := by
      dsimp [sigma]
      rw [div_le_one]
      · simpa using (show (1 : ℝ≥0) ≤ (s : ℝ≥0) by exact_mod_cast hs)
      · exact_mod_cast hspos
    exact (div_le_self (show 0 ≤ sigma from zero_le)
      (by norm_num : (1 : ℝ≥0) ≤ 2)).trans hsigma
  have hbaseCoe :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) = 1 - (1 / (s : ℝ)) / 2 := by
    rw [NNReal.coe_sub hsigma2]
    simp [sigma]
  have hbaseExp :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ≤
        Real.exp (-(1 / (s : ℝ) / 2)) := by
    rw [hbaseCoe]
    exact Real.one_sub_le_exp_neg _
  have hpowExp :
      (((1 - sigma / 2) ^ θ : ℝ≥0) : ℝ) ≤
        Real.exp (-((θ : ℝ) / (2 * s))) := by
    rw [NNReal.coe_pow]
    calc
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ^ θ ≤
          Real.exp (-(1 / (s : ℝ) / 2)) ^ θ :=
        pow_le_pow_left₀ (by positivity) hbaseExp θ
      _ = Real.exp (-((θ : ℝ) / (2 * s))) := by
        rw [← Real.exp_nat_mul]
        congr 1
        field_simp
  have h18 : 18 * s ≤ θ₀ := by
    apply (Nat.le_div_iff_mul_le (by positivity : 0 < C)).2
    have hqC : 18 * C ≤ q := by
      have : 19 * C ≤ q := by simpa [q, s, C] using hqbig
      omega
    nlinarith
  have hsplit : θ + 18 * s = θ₀ := by
    dsimp [θ]
    exact Nat.sub_add_cancel h18
  have hfloor : s * q ≤ C * θ + 19 * s * C := by
    have hlt : s * q < C * (s * q / C + 1) :=
      Nat.lt_mul_div_succ (s * q) (by positivity : 0 < C)
    have hle : s * q ≤ C * (θ₀ + 1) := by
      simpa [θ₀] using hlt.le
    calc
      s * q ≤ C * (θ₀ + 1) := hle
      _ = C * θ + 18 * s * C + C := by rw [← hsplit]; ring
      _ ≤ C * θ + 19 * s * C := by
        have hCs : C ≤ s * C := by nlinarith
        nlinarith
  have hexponent :
      -((θ : ℝ) / (2 * s)) ≤
        (19 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * q := by
    have hfloorR : (s : ℝ) * q ≤ C * θ + 19 * s * C := by
      exact_mod_cast hfloor
    dsimp [C] at hfloorR
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    field_simp
    nlinarith
  have htailExp :
      (((1 - sigma / 2) ^ θ : ℝ≥0) : ℝ) ≤
        Real.exp (19 / 2) *
          Real.exp (-(1 / (4 * 64 ^ 5)) * q) := by
    calc
      _ ≤ Real.exp (-((θ : ℝ) / (2 * s))) := hpowExp
      _ ≤ Real.exp ((19 : ℝ) / 2 - (1 / (4 * 64 ^ 5)) * q) :=
        Real.exp_le_exp.mpr hexponent
      _ = Real.exp (19 / 2) *
          Real.exp (-(1 / (4 * 64 ^ 5)) * q) := by
        rw [← Real.exp_add]
        congr 1
        ring
  have htail :
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ 6) : ℝ≥0) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    norm_num [div_eq_mul_inv]
    ring_nf
    have htailExp' :
        (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ θ) ≤
          Real.exp (19 / 2) *
            Real.exp (-(1 / (4 * 64 ^ 5)) * q) := by
      simpa [div_eq_mul_inv] using htailExp
    calc
      (s : ℝ) ^ 2 *
          (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ θ) * 5184 ≤
        5184 * (s : ℝ) ^ 2 *
          (Real.exp (19 / 2) *
            Real.exp (-(1 / (4 * 64 ^ 5)) * q)) := by
          nlinarith [mul_le_mul_of_nonneg_left htailExp'
            (show (0 : ℝ) ≤ 5184 * (s : ℝ) ^ 2 by positivity)]
      _ ≤ (82944 * Real.exp (19 / 2) : ℝ) *
          ((q : ℝ) ^ 4 *
            Real.exp (-(1 / (4 * 64 ^ 5)) * q)) := by
          have hexpnonneg : 0 ≤ Real.exp (-(1 / (4 * 64 ^ 5)) * q) :=
            (Real.exp_pos _).le
          nlinarith [mul_le_mul_of_nonneg_right hs2q4
            (mul_nonneg (by positivity : 0 ≤ (5184 : ℝ) * Real.exp (19 / 2))
              hexpnonneg)]
      _ < 1 / 2 := by simpa [q, s] using hdecay
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hk4s : (k : ℝ) < 4 * (s : ℝ) ^ 2 := by
    have hkltR : (k : ℝ) < ((s + 1 : ℕ) : ℝ) ^ 2 := by exact_mod_cast hklt
    have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
    push_cast at hkltR
    nlinarith
  have hsize :
      (((k : ℝ≥0) * sigma / (8 * s) : ℝ≥0)) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    dsimp [sigma]
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    change (k : ℝ) * (1 / (s : ℝ)) / (8 * (s : ℝ)) < 1 / 2
    calc
      (k : ℝ) * (1 / (s : ℝ)) / (8 * (s : ℝ)) =
          (k : ℝ) / (8 * (s : ℝ) ^ 2) := by field_simp
      _ < (4 * (s : ℝ) ^ 2) / (8 * (s : ℝ) ^ 2) := by
        exact (div_lt_div_iff_of_pos_right (by positivity)).2 hk4s
      _ = 1 / 2 := by field_simp; norm_num
  have hshift : 18 * s = 2 * (9 * s) := by omega
  simpa [s, q, C, θ₀, θ, sigma, hshift, mul_assoc] using
    (lt_of_lt_of_le (add_lt_add htail hsize) (by norm_num :
      (1 / 2 : ℝ≥0) + 1 / 2 ≤ 1))

/-- The shifted first-moment inequality needed for alternating-hub peeling
holds uniformly for all sufficiently large target lengths. -/
theorem eventually_compact_alternating_sampling_inequality :
    ∀ᶠ k : ℕ in atTop,
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5) -
                2 * (9 * Nat.sqrt k)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1 := by
  filter_upwards [eventually_ge_atTop 1,
    (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop).eventually
      (eventually_ge_atTop (19 * (2 * 64 ^ 5))),
    eventually_shifted_quartic_mul_exp_neg_sqrt_sqrt_lt_half]
      with k hk hqbig hdecay
  exact compact_alternating_sampling_inequality_of_quartic_decay
    ((Nat.le_sqrt').2 (by nlinarith)) hqbig hdecay

/-- Denominator-parameterized form of the shifted compact sampling bound.
The proof only uses that the fixed denominator `C` is positive; the
exponential rate becomes `1 / (2C)`. -/
theorem compact_alternating_sampling_inequality_of_quartic_decay_of_denominator
    {C k : ℕ} (hC : 0 < C) (hs : 1 ≤ Nat.sqrt k)
    (hqbig : 19 * C ≤ Nat.sqrt (Nat.sqrt k))
    (hdecay :
      (82944 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt k) : ℝ) ^ 4 *
            Real.exp (-(1 / (2 * (C : ℝ))) *
              Nat.sqrt (Nat.sqrt k))) < 1 / 2) :
    ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
        ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
            (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / C -
              2 * (9 * Nat.sqrt k)) /
          (1 / 2 : ℝ≥0) ^ 6) +
      ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
        (8 * Nat.sqrt k)) < 1 := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let θ₀ : ℕ := s * q / C
  let θ : ℕ := θ₀ - 18 * s
  let sigma : ℝ≥0 := 1 / (s : ℝ≥0)
  have hCpos : (0 : ℝ) < C := by exact_mod_cast hC
  have hspos : 0 < s := by dsimp [s]; omega
  have hqpos : 0 < q := by
    dsimp [q]
    exact Nat.sqrt_pos.mpr hspos
  have hsqlt : s < (q + 1) ^ 2 := by
    dsimp [q]
    exact Nat.lt_succ_sqrt' s
  have hs2q4 : (s : ℝ) ^ 2 ≤ 16 * (q : ℝ) ^ 4 := by
    have hqsum : q + 1 ≤ 2 * q := by omega
    have hqsum2 := Nat.pow_le_pow_left hqsum 2
    have hsle : s ≤ 4 * q ^ 2 := by
      calc
        s ≤ (q + 1) ^ 2 := hsqlt.le
        _ ≤ (2 * q) ^ 2 := hqsum2
        _ = 4 * q ^ 2 := by ring
    have hsle2 := Nat.pow_le_pow_left hsle 2
    exact_mod_cast (show s ^ 2 ≤ 16 * q ^ 4 by
      calc
        s ^ 2 ≤ (4 * q ^ 2) ^ 2 := hsle2
        _ = 16 * q ^ 4 := by ring)
  have hsigma2 : sigma / 2 ≤ 1 := by
    have hsigma : sigma ≤ 1 := by
      dsimp [sigma]
      rw [div_le_one]
      · simpa using (show (1 : ℝ≥0) ≤ (s : ℝ≥0) by exact_mod_cast hs)
      · exact_mod_cast hspos
    exact (div_le_self (show 0 ≤ sigma from zero_le)
      (by norm_num : (1 : ℝ≥0) ≤ 2)).trans hsigma
  have hbaseCoe :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) = 1 - (1 / (s : ℝ)) / 2 := by
    rw [NNReal.coe_sub hsigma2]
    simp [sigma]
  have hbaseExp :
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ≤
        Real.exp (-(1 / (s : ℝ) / 2)) := by
    rw [hbaseCoe]
    exact Real.one_sub_le_exp_neg _
  have hpowExp :
      (((1 - sigma / 2) ^ θ : ℝ≥0) : ℝ) ≤
        Real.exp (-((θ : ℝ) / (2 * s))) := by
    rw [NNReal.coe_pow]
    calc
      ((1 - sigma / 2 : ℝ≥0) : ℝ) ^ θ ≤
          Real.exp (-(1 / (s : ℝ) / 2)) ^ θ :=
        pow_le_pow_left₀ (by positivity) hbaseExp θ
      _ = Real.exp (-((θ : ℝ) / (2 * s))) := by
        rw [← Real.exp_nat_mul]
        congr 1
        field_simp
  have h18 : 18 * s ≤ θ₀ := by
    apply (Nat.le_div_iff_mul_le hC).2
    have hqC : 18 * C ≤ q := by
      have : 19 * C ≤ q := by simpa [q, s] using hqbig
      omega
    nlinarith
  have hsplit : θ + 18 * s = θ₀ := by
    dsimp [θ]
    exact Nat.sub_add_cancel h18
  have hfloor : s * q ≤ C * θ + 19 * s * C := by
    have hlt : s * q < C * (s * q / C + 1) :=
      Nat.lt_mul_div_succ (s * q) hC
    have hle : s * q ≤ C * (θ₀ + 1) := by
      simpa [θ₀] using hlt.le
    calc
      s * q ≤ C * (θ₀ + 1) := hle
      _ = C * θ + 18 * s * C + C := by rw [← hsplit]; ring
      _ ≤ C * θ + 19 * s * C := by
        have hCs : C ≤ s * C := by nlinarith
        calc
          C * θ + 18 * s * C + C ≤ C * θ + 18 * s * C + s * C :=
            Nat.add_le_add_left hCs _
          _ = C * θ + 19 * s * C := by ring
  have hexponent :
      -((θ : ℝ) / (2 * s)) ≤
        (19 : ℝ) / 2 - (1 / (2 * (C : ℝ))) * q := by
    have hfloorR : (s : ℝ) * q ≤ C * θ + 19 * s * C := by
      exact_mod_cast hfloor
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    field_simp
    nlinarith
  have htailExp :
      (((1 - sigma / 2) ^ θ : ℝ≥0) : ℝ) ≤
        Real.exp (19 / 2) *
          Real.exp (-(1 / (2 * (C : ℝ))) * q) := by
    calc
      _ ≤ Real.exp (-((θ : ℝ) / (2 * s))) := hpowExp
      _ ≤ Real.exp ((19 : ℝ) / 2 - (1 / (2 * (C : ℝ))) * q) :=
        Real.exp_le_exp.mpr hexponent
      _ = Real.exp (19 / 2) *
          Real.exp (-(1 / (2 * (C : ℝ))) * q) := by
        rw [← Real.exp_add]
        congr 1
        ring
  have htail :
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ θ / (1 / 2 : ℝ≥0) ^ 6) : ℝ≥0) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    norm_num [div_eq_mul_inv]
    ring_nf
    have htailExp' :
        (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ θ) ≤
          Real.exp (19 / 2) *
            Real.exp (-(1 / (2 * (C : ℝ))) * q) := by
      simpa [div_eq_mul_inv] using htailExp
    calc
      (s : ℝ) ^ 2 *
          (((1 - sigma * (1 / 2) : ℝ≥0) : ℝ) ^ θ) * 5184 ≤
        5184 * (s : ℝ) ^ 2 *
          (Real.exp (19 / 2) *
            Real.exp (-(1 / (2 * (C : ℝ))) * q)) := by
          nlinarith [mul_le_mul_of_nonneg_left htailExp'
            (show (0 : ℝ) ≤ 5184 * (s : ℝ) ^ 2 by positivity)]
      _ ≤ (82944 * Real.exp (19 / 2) : ℝ) *
          ((q : ℝ) ^ 4 *
            Real.exp (-(1 / (2 * (C : ℝ))) * q)) := by
          have hexpnonneg :
              0 ≤ Real.exp (-(1 / (2 * (C : ℝ))) * q) :=
            (Real.exp_pos _).le
          nlinarith [mul_le_mul_of_nonneg_right hs2q4
            (mul_nonneg (by positivity : 0 ≤ (5184 : ℝ) * Real.exp (19 / 2))
              hexpnonneg)]
      _ < 1 / 2 := by simpa [q, s] using hdecay
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hk4s : (k : ℝ) < 4 * (s : ℝ) ^ 2 := by
    have hkltR : (k : ℝ) < ((s + 1 : ℕ) : ℝ) ^ 2 := by
      exact_mod_cast hklt
    have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
    push_cast at hkltR
    nlinarith
  have hsize :
      (((k : ℝ≥0) * sigma / (8 * s) : ℝ≥0)) < 1 / 2 := by
    rw [← NNReal.coe_lt_coe]
    push_cast
    dsimp [sigma]
    have hsR : (0 : ℝ) < s := by exact_mod_cast hspos
    change (k : ℝ) * (1 / (s : ℝ)) / (8 * (s : ℝ)) < 1 / 2
    calc
      (k : ℝ) * (1 / (s : ℝ)) / (8 * (s : ℝ)) =
          (k : ℝ) / (8 * (s : ℝ) ^ 2) := by field_simp
      _ < (4 * (s : ℝ) ^ 2) / (8 * (s : ℝ) ^ 2) := by
        exact (div_lt_div_iff_of_pos_right (by positivity)).2 hk4s
      _ = 1 / 2 := by field_simp; norm_num
  have hshift : 18 * s = 2 * (9 * s) := by omega
  simpa [s, q, θ₀, θ, sigma, hshift, mul_assoc] using
    (lt_of_lt_of_le (add_lt_add htail hsize) (by norm_num :
      (1 / 2 : ℝ≥0) + 1 / 2 ≤ 1))

/-- Every fixed positive sampling denominator gives the shifted compact
first-moment inequality for all sufficiently large target lengths. -/
theorem eventually_compact_alternating_sampling_inequality_of_denominator
    (C : ℕ) (hC : 0 < C) :
    ∀ᶠ k : ℕ in atTop,
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / C -
                2 * (9 * Nat.sqrt k)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1 := by
  have hrate : (0 : ℝ) < 1 / (2 * (C : ℝ)) := by positivity
  have ht0 := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero
    (4 : ℝ) (1 / (2 * (C : ℝ))) hrate
  have ht : Tendsto
      (fun x : ℝ ↦ x ^ 4 * Real.exp (-(1 / (2 * (C : ℝ))) * x))
      atTop (𝓝 0) := by
    apply ht0.congr'
    filter_upwards with x
    have hx : x ^ (4 : ℝ) = x ^ (4 : ℕ) := by
      norm_num [Real.rpow_natCast]
    rw [hx]
  have ht' : Tendsto
      (fun x : ℝ ↦ (82944 * Real.exp (19 / 2) : ℝ) *
        (x ^ 4 * Real.exp (-(1 / (2 * (C : ℝ))) * x)))
      atTop (𝓝 0) := by
    convert ht.const_mul (82944 * Real.exp (19 / 2) : ℝ) using 1 <;>
      simp
  have hdecayR : ∀ᶠ x : ℝ in atTop,
      (82944 * Real.exp (19 / 2) : ℝ) *
        (x ^ 4 * Real.exp (-(1 / (2 * (C : ℝ))) * x)) < 1 / 2 :=
    ht'.eventually (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))
  have hdecayN : ∀ᶠ k : ℕ in atTop,
      (82944 * Real.exp (19 / 2) : ℝ) *
          ((Nat.sqrt (Nat.sqrt k) : ℝ) ^ 4 *
            Real.exp (-(1 / (2 * (C : ℝ))) *
              Nat.sqrt (Nat.sqrt k))) < 1 / 2 :=
    tendsto_natCast_sqrt_sqrt_atTop.eventually hdecayR
  filter_upwards [eventually_ge_atTop 1,
    (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop).eventually
      (eventually_ge_atTop (19 * C)), hdecayN]
      with k hk hqbig hdecay
  exact
    compact_alternating_sampling_inequality_of_quartic_decay_of_denominator
      hC ((Nat.le_sqrt').2 (by nlinarith)) hqbig hdecay

/-- Every DRC-admissible induced piece contains a local robust hub. -/
theorem isLocalRobustHub_of_drcAdmissiblePiece
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ t τ : ℕ} (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ) {S : Finset V}
    (hS : DrcAdmissiblePiece G θ t τ η ρ S) :
    IsLocalRobustHub G θ τ S := by
  rcases hS with ⟨hSne, hdensity, hθ, hτ, hsmall⟩
  exact exists_local_robustPairSet_of_induced_drc G hSne ht hτpos hη hρ
    hdensity hθ hτ hsmall

/-- Greedy localized hub decomposition.  If every remaining set above the
cutoff m satisfies the explicit DRC inequalities, repeated local DRC
extraction yields pairwise-disjoint hub regions and leaves fewer than m
vertices.  This is the exact interface between the BFS density stage and
the later interaction/cleanup stage. -/
theorem exists_disjoint_localRobustHub_family_of_drcAdmissible_extraction
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ t τ m : ℕ} (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hextract : ∀ S : Finset V, m ≤ S.card →
      DrcAdmissiblePiece G θ t τ η ρ S) :
    ∀ S : Finset V, ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G θ τ H) ∧
      DisjointFinsetFamily F ∧ F.biUnion id ⊆ S ∧
      (S \ F.biUnion id).card < m := by
  apply exists_disjoint_family_covering_up_to
    (fun H => IsLocalRobustHub G θ τ H) m
  intro S hSm
  obtain ⟨U, hUcard, hUS, hrob⟩ :=
    isLocalRobustHub_of_drcAdmissiblePiece G ht hτpos hη hρ (hextract S hSm)
  refine ⟨S, Finset.Subset.rfl, ?_, ⟨U, hUcard, hUS, hrob⟩⟩
  obtain ⟨u, hu⟩ := Finset.card_pos.mp (hτpos.trans_le hUcard)
  exact ⟨u, hUS hu⟩

/-- Independence-driven greedy hub decomposition.  If the three remaining
DRC parameter estimates hold uniformly for sets above the cutoff m, then
Turán's theorem supplies the density estimate automatically and the graph
can be peeled into disjoint local robust hubs with fewer than m uncovered
vertices.  This is the reusable quantitative form of the KLS hub-extraction
step. -/
theorem exists_disjoint_localRobustHub_family_of_indepSetFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {n d θ t τ m : ℕ} (hn : 2 ≤ n) (hd : 0 < d)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hfree : G.IndepSetFree n)
    (hm : (n - 1) * (d + 1) ≤ m)
    (hθ : ∀ S : Finset V, m ≤ S.card →
      (θ : ℝ) ≤ η * ((d : ℝ) / S.card) ^ 2 * Fintype.card S)
    (hτ : ∀ S : Finset V, m ≤ S.card →
      (τ : ℝ) ^ 2 ≤
        ((((d : ℝ) / S.card) ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : ∀ S : Finset V, m ≤ S.card →
      2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    ∀ S : Finset V, ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G θ τ H) ∧
      DisjointFinsetFamily F ∧ F.biUnion id ⊆ S ∧
      (S \ F.biUnion id).card < m := by
  apply exists_disjoint_family_covering_up_to
    (fun H => IsLocalRobustHub G θ τ H) m
  intro S hSm
  have hsize : (n - 1) * (d + 1) ≤ S.card := hm.trans hSm
  have hSpos : 0 < S.card := by
    have hnpos : 0 < n - 1 := by omega
    have hprod : 0 < (n - 1) * (d + 1) := Nat.mul_pos hnpos (by omega)
    omega
  have hρ : (0 : ℝ) < (d : ℝ) / S.card := by
    positivity
  obtain ⟨U, hUcard, hUS, hrob⟩ :=
    isLocalRobustHub_of_drcAdmissiblePiece G ht hτpos hη hρ
      (drcAdmissiblePiece_of_indepSetFree G hn hd hfree hsize
        (hθ S hSm) (hτ S hSm) (hsmall S hSm))
  refine ⟨S, Finset.Subset.rfl, ?_, ⟨U, hUcard, hUS, hrob⟩⟩
  obtain ⟨u, hu⟩ := Finset.card_pos.mp (hτpos.trans_le hUcard)
  exact ⟨u, hUS hu⟩

/-- A robust pair has a common neighbor outside any forbidden set smaller
than the robustness threshold.  This is the one-step greedy choice used in
all later hub routings. -/
theorem exists_fresh_commonNeighbor_of_pair
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {T F : Finset V} {a b : V} {θ : ℕ}
    (hpair : θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![a, b] T).card)
    (hF : F.card < θ) :
    ∃ z : V, z ∈ T ∧ z ∉ F ∧ G.Adj a z ∧ G.Adj z b := by
  classical
  have hlt : F.card <
      (Erdos163.FiniteDefect.commonNeighbors G ![a, b] T).card :=
    hF.trans_le hpair
  obtain ⟨z, hzcommon, hzF⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt
  change z ∈ Erdos163.Defect.commonNeighbors G ![a, b] T at hzcommon
  rw [Erdos163.Defect.mem_commonNeighbors] at hzcommon
  refine ⟨z, hzcommon.1, hzF, ?_, ?_⟩
  · simpa using hzcommon.2 (0 : Fin 2)
  · have hbz : G.Adj b z := by simpa using hzcommon.2 (1 : Fin 2)
    exact hbz.symm

/-- The fresh common neighbor gives an explicit two-edge walk.  Keeping the
middle vertex visible is more useful than immediately hiding it in a walk:
the next greedy step only has to add that one vertex to its forbidden set. -/
theorem exists_fresh_twoEdgeWalk_of_pair
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {T F : Finset V} {a b : V} {θ : ℕ}
    (hpair : θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![a, b] T).card)
    (hF : F.card < θ) :
    ∃ z : V, ∃ p : G.Walk a b,
      z ∈ T ∧ z ∉ F ∧ G.Adj a z ∧ G.Adj z b ∧ p.length = 2 := by
  obtain ⟨z, hzT, hzF, haz, hzb⟩ :=
    exists_fresh_commonNeighbor_of_pair G hpair hF
  refine ⟨z, Walk.cons haz (Walk.cons hzb Walk.nil), hzT, hzF, haz, hzb, ?_⟩
  simp

/-- A bounded family of robust endpoint pairs can be routed greedily with
distinct fresh middle vertices.  The only budget is the transparent one:
the initially forbidden set plus the number of requested routes is at most
the common-neighborhood threshold. -/
theorem exists_fresh_middle_vertices_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {T F : Finset V} {θ q : ℕ} (a b : Fin q → V)
    (hpair : ∀ i : Fin q, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![a i, b i] T).card)
    (hbudget : F.card + q ≤ θ) :
    ∃ z : Fin q → V, Function.Injective z ∧
      ∀ i : Fin q, z i ∈ T ∧ z i ∉ F ∧ G.Adj (a i) (z i) ∧ G.Adj (z i) (b i) := by
  classical
  induction q generalizing F with
  | zero =>
      refine ⟨Fin.elim0, ?_, ?_⟩
      · intro i
        exact Fin.elim0 i
      · intro i
        exact Fin.elim0 i
  | succ q ih =>
      let a₀ : Fin q → V := fun i => a i.castSucc
      let b₀ : Fin q → V := fun i => b i.castSucc
      have hbudget₀ : F.card + q ≤ θ := by omega
      obtain ⟨z, hzinj, hz⟩ := ih a₀ b₀
        (fun i => hpair i.castSucc) hbudget₀
      let used : Finset V := F ∪ Finset.univ.image z
      have husedcard : used.card < θ := by
        calc
          used.card ≤ F.card + (Finset.univ.image z).card := Finset.card_union_le _ _
          _ = F.card + q := by
            rw [Finset.card_image_of_injective _ hzinj]
            simp
          _ < θ := by omega
      obtain ⟨c, hcT, hcused, hac, hcb⟩ :=
        exists_fresh_commonNeighbor_of_pair G (hpair (Fin.last q)) husedcard
      have hcF : c ∉ F := by
        intro hc
        exact hcused (Finset.mem_union_left _ hc)
      have hcrange : c ∉ Set.range z := by
        rintro ⟨i, rfl⟩
        apply hcused
        exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
      let z' : Fin (q + 1) → V := Fin.snoc z c
      refine ⟨z', Fin.snoc_injective_iff.mpr ⟨hzinj, hcrange⟩, ?_⟩
      intro i
      induction i using Fin.lastCases with
      | last =>
          simpa [z'] using ⟨hcT, hcF, hac, hcb⟩
      | cast i =>
          simpa [z', a₀, b₀] using hz i

/-- The cyclic successor on a nonempty finite ordinal. -/
def finCyclicSucc {q : ℕ} (hq : 0 < q) (i : Fin q) : Fin q :=
  ⟨(i.1 + 1) % q, Nat.mod_lt _ hq⟩

/-- An explicit alternating cycle scaffold.  The vertices `a i` form the
displayed core `A`; the distinct vertices `b i` form `B`; and `b i` joins
`a i` to the cyclic successor of `a i`.  Keeping the indexing data, rather
than merely a contained cycle, is what later reservoir cutting needs. -/
def IsCyclicAlternatingScaffold
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (q : ℕ) (A B : Finset V) : Prop :=
  ∃ hq : 0 < q, ∃ a b : Fin q → V,
    A = Finset.univ.image a ∧ B = Finset.univ.image b ∧
      Function.Injective a ∧ Function.Injective b ∧ Disjoint A B ∧
      (∀ i, G.Adj (a i) (b i)) ∧
      ∀ i, G.Adj (b i) (a (finCyclicSucc hq i))

/-- Data carried by an alternating scaffold.  Keeping one canonical choice
of this data lets later anchor selection and reservoir routing refer to the
same indexed alternating cycle, rather than making unrelated existential
choices from the proposition `IsCyclicAlternatingScaffold`. -/
structure CyclicAlternatingScaffoldData
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (q : ℕ) (A B : Finset V) where
  hq : 0 < q
  a : Fin q → V
  b : Fin q → V
  hA : A = Finset.univ.image a
  hB : B = Finset.univ.image b
  ha : Function.Injective a
  hb : Function.Injective b
  hAB : Disjoint A B
  hab : ∀ i, G.Adj (a i) (b i)
  hba : ∀ i, G.Adj (b i) (a (finCyclicSucc hq i))

/-- Every scaffold proposition supplies indexed data. -/
theorem nonempty_cyclicAlternatingScaffoldData
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    (h : IsCyclicAlternatingScaffold G q A B) :
    Nonempty (CyclicAlternatingScaffoldData G q A B) := by
  rcases h with ⟨hq, a, b, hA, hB, ha, hb, hAB, hab, hba⟩
  exact ⟨⟨hq, a, b, hA, hB, ha, hb, hAB, hab, hba⟩⟩

/-- The canonical indexed data used jointly by anchors and routes. -/
noncomputable def cyclicAlternatingScaffoldData
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    (h : IsCyclicAlternatingScaffold G q A B) :
    CyclicAlternatingScaffoldData G q A B :=
  Classical.choice (nonempty_cyclicAlternatingScaffoldData G h)

/-- A vertex of the alternating side and its selected-side partner in the
canonical indexed scaffold data. -/
noncomputable def IsCanonicalScaffoldMate
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    (x a : V) : Prop :=
  let d := cyclicAlternatingScaffoldData G hscaffold
  ∃ i : Fin q, d.b i = x ∧ d.a i = a

/-- A canonical scaffold partner is uniquely determined by its selected-side
anchor. -/
theorem IsCanonicalScaffoldMate.left_unique
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    {hscaffold : IsCyclicAlternatingScaffold G q A B}
    {x y a : V}
    (hx : IsCanonicalScaffoldMate G hscaffold x a)
    (hy : IsCanonicalScaffoldMate G hscaffold y a) : x = y := by
  classical
  unfold IsCanonicalScaffoldMate at hx hy
  obtain ⟨i, hix, hia⟩ := hx
  obtain ⟨j, hjy, hja⟩ := hy
  let d := cyclicAlternatingScaffoldData G hscaffold
  have hij : i = j := d.ha (hia.trans hja.symm)
  exact hix.symm.trans (congrArg d.b hij |>.trans hjy)

/-- The first coordinate of a canonical scaffold-mate relation belongs to
the alternating side of the scaffold. -/
theorem IsCanonicalScaffoldMate.mem_left
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    {hscaffold : IsCyclicAlternatingScaffold G q A B}
    {x a : V} (hx : IsCanonicalScaffoldMate G hscaffold x a) : x ∈ B := by
  classical
  unfold IsCanonicalScaffoldMate at hx
  obtain ⟨i, hi, _hia⟩ := hx
  let d := cyclicAlternatingScaffoldData G hscaffold
  rw [d.hB]
  exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, hi⟩

/-- A robust core with threshold at least twice its order contains an
alternating cycle scaffold.  Enumerate the core cyclically and greedily
choose one fresh target common neighbour for every consecutive pair. -/
theorem exists_cyclicAlternatingScaffold_of_robustPairSet
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {A T : Finset V} {θ q : ℕ} (hq : 0 < q)
    (hAcard : A.card = q) (hrob : RobustPairSet G A T θ)
    (hθ : 2 * q ≤ θ) :
    ∃ B : Finset V, B ⊆ T ∧ B.card = q ∧ Disjoint A B ∧
      IsCyclicAlternatingScaffold G q A B := by
  classical
  let e : Fin q ≃ A := (Finset.equivFinOfCardEq hAcard).symm
  let a : Fin q → V := fun i => e i
  have ha : Function.Injective a := by
    intro i j hij
    apply e.injective
    exact Subtype.ext hij
  have haA : ∀ i : Fin q, a i ∈ A := fun i => (e i).property
  let c : Fin q → V := fun i => a (finCyclicSucc hq i)
  have hpairs : ∀ i : Fin q, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![a i, c i] T).card := by
    intro i
    exact hrob (a i) (haA i) (c i) (haA (finCyclicSucc hq i))
  have hbudget : A.card + q ≤ θ := by omega
  obtain ⟨b, hb, hbadj⟩ :=
    exists_fresh_middle_vertices_fin G a c hpairs hbudget
  let B : Finset V := Finset.univ.image b
  have hBT : B ⊆ T := by
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨i, _hi, rfl⟩
    exact (hbadj i).1
  have hBcard : B.card = q := by
    dsimp [B]
    rw [Finset.card_image_of_injective _ hb]
    simp
  have hAB : Disjoint A B := by
    rw [Finset.disjoint_left]
    intro x hxA hxB
    rcases Finset.mem_image.mp hxB with ⟨i, _hi, rfl⟩
    exact (hbadj i).2.1 hxA
  have hAimage : A = Finset.univ.image a := by
    ext x
    constructor
    · intro hx
      obtain ⟨i, hi⟩ := e.surjective (⟨x, hx⟩ : A)
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, by
        simpa [a] using congrArg Subtype.val hi⟩
    · intro hx
      rcases Finset.mem_image.mp hx with ⟨i, _hi, rfl⟩
      exact haA i
  refine ⟨B, hBT, hBcard, hAB, hq, a, b, hAimage, rfl,
    ha, hb, hAB, ?_, ?_⟩
  · intro i
    exact (hbadj i).2.2.1
  · intro i
    exact (hbadj i).2.2.2

/-- Cyclically reindex an alternating scaffold.  This lets the cut-and-rejoin
argument put one prescribed endpoint at index zero without changing either
displayed side of the scaffold. -/
theorem IsCyclicAlternatingScaffold.rotate
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B) (t : Fin q) :
    IsCyclicAlternatingScaffold G q A B := by
  classical
  rcases hscaffold with
    ⟨hq, a, b, hA, hB, ha, hb, hAB, hab, hba⟩
  let : NeZero q := ⟨Nat.ne_of_gt hq⟩
  let e : Equiv.Perm (Fin q) := finCycle t
  let a' : Fin q → V := fun i => a (e i)
  let b' : Fin q → V := fun i => b (e i)
  have hA' : A = Finset.univ.image a' := by
    rw [hA]
    ext x
    constructor
    · intro hx
      rcases Finset.mem_image.mp hx with ⟨j, _hj, rfl⟩
      have he : e (e.symm j) = j := e.apply_symm_apply j
      exact Finset.mem_image.mpr
        ⟨e.symm j, Finset.mem_univ _, by simpa [a'] using congrArg a he⟩
    · intro hx
      rcases Finset.mem_image.mp hx with ⟨i, _hi, rfl⟩
      exact Finset.mem_image.mpr ⟨e i, Finset.mem_univ _, rfl⟩
  have hB' : B = Finset.univ.image b' := by
    rw [hB]
    ext x
    constructor
    · intro hx
      rcases Finset.mem_image.mp hx with ⟨j, _hj, rfl⟩
      have he : e (e.symm j) = j := e.apply_symm_apply j
      exact Finset.mem_image.mpr
        ⟨e.symm j, Finset.mem_univ _, by simpa [b'] using congrArg b he⟩
    · intro hx
      rcases Finset.mem_image.mp hx with ⟨i, _hi, rfl⟩
      exact Finset.mem_image.mpr ⟨e i, Finset.mem_univ _, rfl⟩
  have hsucc (i : Fin q) :
      e (finCyclicSucc hq i) = finCyclicSucc hq (e i) := by
    have hcyc (j : Fin q) : finCyclicSucc hq j = j + 1 := by
      apply Fin.ext
      simp [finCyclicSucc, Fin.add_def]
    rw [hcyc i, hcyc (e i)]
    dsimp [e]
    rw [finCycle_apply, finCycle_apply]
    ac_rfl
  refine ⟨hq, a', b', hA', hB', ha.comp e.injective,
    hb.comp e.injective, hAB, ?_, ?_⟩
  · intro i
    exact hab (e i)
  · intro i
    dsimp [a', b']
    rw [hsucc]
    exact hba (e i)

/-- Expose rotated scaffold data with a prescribed core vertex at index zero.
The stronger indexed conclusion is what the full cut-and-rejoin route uses. -/
theorem exists_cyclicAlternatingScaffold_data_starting_at
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {q : ℕ} {A B : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    {x : V} (hxA : x ∈ A) :
    ∃ hq : 0 < q, ∃ a b : Fin q → V,
      A = Finset.univ.image a ∧ B = Finset.univ.image b ∧
      Function.Injective a ∧ Function.Injective b ∧ Disjoint A B ∧
      (∀ i, G.Adj (a i) (b i)) ∧
      (∀ i, G.Adj (b i) (a (finCyclicSucc hq i))) ∧
      a (⟨0, hq⟩ : Fin q) = x ∧
      ∀ i, IsCanonicalScaffoldMate G hscaffold (b i) (a i) := by
  classical
  rcases hcanonical : cyclicAlternatingScaffoldData G hscaffold with
    ⟨hq, a₀, b₀, hA, hB, ha₀, hb₀, hAB, hab₀, hba₀⟩
  obtain ⟨t, _ht, hat⟩ := Finset.mem_image.mp (hA ▸ hxA)
  let : NeZero q := ⟨Nat.ne_of_gt hq⟩
  let e : Equiv.Perm (Fin q) := finCycle t
  let a : Fin q → V := fun i => a₀ (e i)
  let b : Fin q → V := fun i => b₀ (e i)
  have hA' : A = Finset.univ.image a := by
    rw [hA]
    ext v
    constructor
    · intro hv
      rcases Finset.mem_image.mp hv with ⟨j, _hj, rfl⟩
      have he : e (e.symm j) = j := e.apply_symm_apply j
      exact Finset.mem_image.mpr
        ⟨e.symm j, Finset.mem_univ _, by simpa [a] using congrArg a₀ he⟩
    · intro hv
      rcases Finset.mem_image.mp hv with ⟨i, _hi, rfl⟩
      exact Finset.mem_image.mpr ⟨e i, Finset.mem_univ _, rfl⟩
  have hB' : B = Finset.univ.image b := by
    rw [hB]
    ext v
    constructor
    · intro hv
      rcases Finset.mem_image.mp hv with ⟨j, _hj, rfl⟩
      have he : e (e.symm j) = j := e.apply_symm_apply j
      exact Finset.mem_image.mpr
        ⟨e.symm j, Finset.mem_univ _, by simpa [b] using congrArg b₀ he⟩
    · intro hv
      rcases Finset.mem_image.mp hv with ⟨i, _hi, rfl⟩
      exact Finset.mem_image.mpr ⟨e i, Finset.mem_univ _, rfl⟩
  have hsucc (i : Fin q) :
      e (finCyclicSucc hq i) = finCyclicSucc hq (e i) := by
    have hcyc (j : Fin q) : finCyclicSucc hq j = j + 1 := by
      apply Fin.ext
      simp [finCyclicSucc, Fin.add_def]
    rw [hcyc i, hcyc (e i)]
    dsimp [e]
    rw [finCycle_apply, finCycle_apply]
    ac_rfl
  refine ⟨hq, a, b, hA', hB', ha₀.comp e.injective,
    hb₀.comp e.injective, hAB, ?_, ?_, ?_, ?_⟩
  · intro i
    exact hab₀ (e i)
  · intro i
    dsimp [a, b]
    rw [hsucc]
    exact hba₀ (e i)
  · dsimp [a, e]
    rw [finCycle_apply, Fin.zero_add]
    exact hat
  · intro i
    unfold IsCanonicalScaffoldMate
    rw [hcanonical]
    exact ⟨e i, rfl, rfl⟩

/-- A compact KLS-style alternating hub.  The displayed region consists of
an exact core `A`, an equally large alternating-cycle side `B`, and a small
sampled connector set `D`.  Pairwise disjointness is explicit, and every
pair in `A` retains `θ` common neighbours in `D`. -/
def IsCompactAlternatingHub
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (θ τ M : ℕ) (H : Finset V) : Prop :=
  ∃ A B D : Finset V,
    A.card = τ ∧ B.card = τ ∧ Disjoint A B ∧ Disjoint (A ∪ B) D ∧
      H = (A ∪ B) ∪ D ∧ H.card < M ∧
      IsCyclicAlternatingScaffold G τ A B ∧ RobustPairSet G A D θ

/-- Preserve the alternating reservoir before compact-target sampling.
First normalize the robust core, then reserve distinct common neighbours
around its cyclic order, and finally sample connectors from the remaining
target.  Only the core--cycle union is charged against the original robust
threshold. -/
theorem exists_compactAlternatingHub_of_isLocalRobustHub
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {Θ τ : ℕ} (hhub : IsLocalRobustHub G Θ τ S)
    (hτ : 0 < τ) (h2τ : 2 * τ ≤ Θ)
    (r K : ℕ) (sigma : ℝ≥0)
    (hsigma : sigma ≤ 1) (hK : 0 < K)
    (hsmall :
      ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ (Θ - 2 * τ) / (1 / 2 : ℝ≥0) ^ r) +
        ((S.card : ℝ≥0) * sigma) / K < 1) :
    ∃ H : Finset V, H ⊆ S ∧ H.Nonempty ∧
      IsCompactAlternatingHub G (r + 1) τ (2 * τ + K) H := by
  classical
  obtain ⟨W, hWcard, hWS, hrobW⟩ := hhub
  obtain ⟨A, hAW, hAcard⟩ := Finset.exists_subset_card_eq hWcard
  have hAS : A ⊆ S := hAW.trans hWS
  have hrobA : RobustPairSet G A S Θ := hrobW.mono_left hAW
  obtain ⟨B, hBS, hBcard, hAB, hscaffold⟩ :=
    exists_cyclicAlternatingScaffold_of_robustPairSet
      G hτ hAcard hrobA h2τ
  let F₀ : Finset V := A ∪ B
  have hF₀card : F₀.card = 2 * τ := by
    dsimp [F₀]
    rw [Finset.card_union_of_disjoint hAB, hAcard, hBcard]
    omega
  have hrobRemain : RobustPairSet G A (S \ F₀) (Θ - 2 * τ) := by
    simpa [hF₀card] using hrobA.sdiff_right (F := F₀)
  have hsmall' :
      ((A.card * A.card : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ (Θ - 2 * τ) / (1 / 2 : ℝ≥0) ^ r) +
        (((S \ F₀).card : ℝ≥0) * sigma) / K < 1 := by
    have hcardNN : (((S \ F₀).card : ℕ) : ℝ≥0) ≤ (S.card : ℝ≥0) := by
      exact_mod_cast (Finset.card_le_card (Finset.sdiff_subset : S \ F₀ ⊆ S))
    calc
      _ ≤ ((τ * τ : ℕ) : ℝ≥0) *
            ((1 - sigma / 2) ^ (Θ - 2 * τ) / (1 / 2 : ℝ≥0) ^ r) +
          ((S.card : ℝ≥0) * sigma) / K := by
            rw [hAcard]
            gcongr
      _ < 1 := hsmall
  obtain ⟨D, hDremain, hDcard, hrobD⟩ :=
    exists_compact_robustPairSet_target_of_robust
      G A (S \ F₀) hrobRemain r K sigma hsigma hK hsmall'
  let H : Finset V := F₀ ∪ D
  have hDS : D ⊆ S := hDremain.trans Finset.sdiff_subset
  have hHD : Disjoint F₀ D := by
    rw [Finset.disjoint_left]
    intro x hxF hxD
    exact (Finset.mem_sdiff.mp (hDremain hxD)).2 hxF
  have hHS : H ⊆ S := Finset.union_subset
    (Finset.union_subset hAS hBS) hDS
  have hHne : H.Nonempty := by
    have hApos : 0 < A.card := by omega
    obtain ⟨a, ha⟩ := Finset.card_pos.mp hApos
    exact ⟨a, Finset.mem_union_left _ (Finset.mem_union_left _ ha)⟩
  have hHcard : H.card < 2 * τ + K := by
    have hle : H.card ≤ F₀.card + D.card := Finset.card_union_le _ _
    rw [hF₀card] at hle
    omega
  refine ⟨H, hHS, hHne, A, B, D, hAcard, hBcard, hAB, ?_, rfl,
    hHcard, hscaffold, hrobD⟩
  simpa [F₀] using hHD

/-- Greedy peeling for compact alternating hubs.  Dense extraction may use a
larger temporary support, but the deleted object is only its exact core,
alternating side, and sampled connector set. -/
theorem exists_disjoint_compactAlternatingHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {m Dmax Θ τ r K : ℕ} (hτ : 0 < τ) (h2τ : 2 * τ ≤ Θ)
    (hK : 0 < K) (sigma : ℝ≥0) (hsigma : sigma ≤ 1)
    (hextract : ∀ S : Finset V, m ≤ S.card →
      ∃ R : Finset V, R ⊆ S ∧ R.card ≤ Dmax ∧
        IsLocalRobustHub G Θ τ R)
    (hsample :
      ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ (Θ - 2 * τ) / (1 / 2 : ℝ≥0) ^ r) +
        ((Dmax : ℝ≥0) * sigma) / K < 1) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactAlternatingHub G (r + 1) τ (2 * τ + K) H) ∧
      DisjointFinsetFamily F ∧ F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card < m := by
  apply exists_disjoint_family_covering_up_to
    (IsCompactAlternatingHub G (r + 1) τ (2 * τ + K)) m
  intro S hSm
  obtain ⟨R, hRS, hRcard, hhub⟩ := hextract S hSm
  have hsampleR :
      ((τ * τ : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^ (Θ - 2 * τ) / (1 / 2 : ℝ≥0) ^ r) +
        ((R.card : ℝ≥0) * sigma) / K < 1 := by
    apply lt_of_le_of_lt _ hsample
    gcongr
  obtain ⟨H, hHR, hHne, hcompact⟩ :=
    exists_compactAlternatingHub_of_isLocalRobustHub
      G hhub hτ h2τ r K sigma hsigma hK hsampleR
  exact ⟨H, hHR.trans hRS, hHne, hcompact⟩

/-- Varying-reservoir form of the same greedy common-neighbour selection.
The endpoint pair and its robust target set may both depend on the request;
one uniform cardinal budget still produces globally distinct middle
vertices avoiding the initial forbidden set. -/
theorem exists_fresh_middle_vertices_fin_varying
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset V} {θ q : ℕ} (T : Fin q → Finset V) (a b : Fin q → V)
    (hpair : ∀ i : Fin q, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![a i, b i] (T i)).card)
    (hbudget : F.card + q ≤ θ) :
    ∃ z : Fin q → V, Function.Injective z ∧
      ∀ i : Fin q, z i ∈ T i ∧ z i ∉ F ∧
        G.Adj (a i) (z i) ∧ G.Adj (z i) (b i) := by
  classical
  induction q generalizing F with
  | zero =>
      exact ⟨Fin.elim0, fun i => i.elim0, fun i => i.elim0⟩
  | succ q ih =>
      let T₀ : Fin q → Finset V := fun i => T i.castSucc
      let a₀ : Fin q → V := fun i => a i.castSucc
      let b₀ : Fin q → V := fun i => b i.castSucc
      have hbudget₀ : F.card + q ≤ θ := by omega
      obtain ⟨z, hzinj, hz⟩ := ih T₀ a₀ b₀
        (fun i => hpair i.castSucc) hbudget₀
      let used : Finset V := F ∪ Finset.univ.image z
      have husedcard : used.card < θ := by
        calc
          used.card ≤ F.card + (Finset.univ.image z).card :=
            Finset.card_union_le _ _
          _ = F.card + q := by
            rw [Finset.card_image_of_injective _ hzinj]
            simp
          _ < θ := by omega
      obtain ⟨c, hcT, hcused, hac, hcb⟩ :=
        exists_fresh_commonNeighbor_of_pair G (hpair (Fin.last q)) husedcard
      have hcF : c ∉ F := by
        intro hc
        exact hcused (Finset.mem_union_left _ hc)
      have hcrange : c ∉ Set.range z := by
        rintro ⟨i, rfl⟩
        apply hcused
        exact Finset.mem_union_right _
          (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
      let z' : Fin (q + 1) → V := Fin.snoc z c
      refine ⟨z', Fin.snoc_injective_iff.mpr ⟨hzinj, hcrange⟩, ?_⟩
      intro i
      induction i using Fin.lastCases with
      | last =>
          simpa [z'] using ⟨hcT, hcF, hac, hcb⟩
      | cast i =>
          simpa [z', T₀, a₀, b₀] using hz i

/-- Globally distinct endpoint pairs in varying robust reservoirs have
pairwise vertex-disjoint two-edge routes.  All requested common neighbours
are chosen at once outside the endpoint set, which makes the final support
disjointness a finite nine-case check. -/
theorem exists_pairwise_disjoint_twoEdge_paths_varying_robust
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q θ : ℕ} (hub : Fin q → ι) (U T : ι → Finset V)
    (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
    (a b : Fin q → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hθ : 3 * q ≤ θ) :
    ∃ p : ∀ i : Fin q, G.Walk (a i) (b i),
      (∀ i, (p i).IsPath) ∧ (∀ i, (p i).length = 2) ∧
      ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  classical
  let F : Finset V := (Finset.univ.image a) ∪ (Finset.univ.image b)
  have hFcard : F.card ≤ 2 * q := by
    have haCard : (Finset.univ.image a).card ≤ q := by
      calc
        (Finset.univ.image a).card ≤ (Finset.univ : Finset (Fin q)).card :=
          Finset.card_image_le
        _ = q := by simp
    have hbCard : (Finset.univ.image b).card ≤ q := by
      calc
        (Finset.univ.image b).card ≤ (Finset.univ : Finset (Fin q)).card :=
          Finset.card_image_le
        _ = q := by simp
    have hu := Finset.card_union_le
      (Finset.univ.image a) (Finset.univ.image b)
    change F.card ≤ 2 * q
    dsimp [F]
    omega
  have hbudget : F.card + q ≤ θ := by omega
  have hpair : ∀ i : Fin q, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G
        ![a i, b i] (T (hub i))).card := by
    intro i
    exact hrob (hub i) (a i) (ha i) (b i) (hb i)
  obtain ⟨z, hzinj, hz⟩ :=
    exists_fresh_middle_vertices_fin_varying G
      (fun i => T (hub i)) a b hpair hbudget
  have hza : ∀ i j, z i ≠ a j := by
    intro i j h
    apply (hz i).2.1
    exact Finset.mem_union_left _
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, h.symm⟩)
  have hzb : ∀ i j, z i ≠ b j := by
    intro i j h
    apply (hz i).2.1
    exact Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, h.symm⟩)
  let p : ∀ i : Fin q, G.Walk (a i) (b i) := fun i =>
    Walk.cons (hz i).2.2.1 (Walk.cons (hz i).2.2.2 Walk.nil)
  refine ⟨p, ?_, ?_, ?_⟩
  · intro i
    simp [p, Walk.cons_isPath_iff, hab i, (hza i i).symm, hzb i i]
  · intro i
    simp [p]
  · intro i j hij v hvi hvj
    have hijPairs := hpairs i j hij
    have hzij : z i ≠ z j := fun h => hij (hzinj h)
    simp [p] at hvi hvj
    rcases hvi with (rfl | rfl | rfl) <;>
      rcases hvj with (h | h | h)
    · exact hijPairs.1 h
    · exact (hza j i) h.symm
    · exact hijPairs.2.1 h
    · exact (hza i j) h
    · exact hzij h
    · exact (hzb i j) h
    · exact hijPairs.2.2.1 h
    · exact (hzb j i) h.symm
    · exact hijPairs.2.2.2 h

/-- Walk-valued version of bounded robust routing.  The middle vertices are
injective and avoid the initial forbidden set, so these length-two routes
are internally vertex-disjoint whenever the endpoint pairs are disjoint. -/
theorem exists_fresh_twoEdgeWalks_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {T F : Finset V} {θ q : ℕ} (a b : Fin q → V)
    (hpair : ∀ i : Fin q, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![a i, b i] T).card)
    (hbudget : F.card + q ≤ θ) :
    ∃ z : Fin q → V, ∃ p : ∀ i : Fin q, G.Walk (a i) (b i),
      Function.Injective z ∧
      (∀ i : Fin q, z i ∈ T ∧ z i ∉ F ∧
        G.Adj (a i) (z i) ∧ G.Adj (z i) (b i)) ∧
      ∀ i : Fin q, (p i).length = 2 := by
  obtain ⟨z, hzinj, hz⟩ := exists_fresh_middle_vertices_fin G a b hpair hbudget
  let p : ∀ i : Fin q, G.Walk (a i) (b i) := fun i =>
    Walk.cons (hz i).2.2.1 (Walk.cons (hz i).2.2.2 Walk.nil)
  refine ⟨z, p, hzinj, hz, ?_⟩
  intro i
  simp [p]

/-- Distinct reservoir vertices joined by distinct fresh common neighbours
form one simple alternating path.  The support description is deliberately
kept in the statement: later hub routing uses it to prove that a second
route can avoid every vertex already spent by the first one. -/
theorem exists_alternating_path_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {q : ℕ} (a : Fin (q + 1) → V) (z : Fin q → V)
    (ha : Function.Injective a) (hz : Function.Injective z)
    (haz : ∀ i : Fin (q + 1), ∀ j : Fin q, a i ≠ z j)
    (hadj : ∀ i : Fin q,
      G.Adj (a i.castSucc) (z i) ∧ G.Adj (z i) (a i.succ)) :
    ∃ p : G.Walk (a 0) (a (Fin.last q)),
      p.IsPath ∧ p.length = 2 * q ∧
      ∀ v ∈ p.support,
        (∃ i : Fin (q + 1), a i = v) ∨ (∃ j : Fin q, z j = v) := by
  induction q with
  | zero =>
      refine ⟨.nil, SimpleGraph.Walk.IsPath.nil, by simp, ?_⟩
      intro v hv
      simp at hv
      exact Or.inl ⟨0, hv.symm⟩
  | succ q ih =>
      let a₀ : Fin (q + 1) → V := fun i => a i.castSucc
      let z₀ : Fin q → V := fun i => z i.castSucc
      have ha₀ : Function.Injective a₀ := by
        intro i j h
        exact Fin.castSucc_injective (q + 1) (ha h)
      have hz₀ : Function.Injective z₀ := by
        intro i j h
        exact Fin.castSucc_injective q (hz h)
      have haz₀ : ∀ i : Fin (q + 1), ∀ j : Fin q, a₀ i ≠ z₀ j := by
        intro i j h
        exact haz i.castSucc j.castSucc h
      have hadj₀ : ∀ i : Fin q,
          G.Adj (a₀ i.castSucc) (z₀ i) ∧ G.Adj (z₀ i) (a₀ i.succ) := by
        intro i
        simpa [a₀, z₀] using hadj i.castSucc
      obtain ⟨p, hp, hplen, hpsupp⟩ := ih a₀ z₀ ha₀ hz₀ haz₀ hadj₀
      let w : V := z (Fin.last q)
      let b : V := a (Fin.last (q + 1))
      have hleft : G.Adj (a₀ (Fin.last q)) w := by
        simpa [w, a₀] using (hadj (Fin.last q)).1
      have hright : G.Adj w b := by
        simpa [w, b] using (hadj (Fin.last q)).2
      have hw_not : w ∉ p.support := by
        intro hw
        rcases hpsupp w hw with ⟨i, hi⟩ | ⟨i, hi⟩
        · exact haz i.castSucc (Fin.last q) (by simpa [a₀, w] using hi)
        · have : i.castSucc = Fin.last q := hz (by simpa [z₀, w] using hi)
          exact Fin.castSucc_ne_last i this
      let p₁ : G.Walk (a₀ 0) w := p.concat hleft
      have hp₁ : p₁.IsPath := by
        apply hp.concat
        exact hw_not
      have hb_not : b ∉ p₁.support := by
        dsimp [p₁]
        rw [SimpleGraph.Walk.support_concat]
        simp only [List.mem_append, List.mem_singleton]
        intro hb
        rcases hb with hb | hb
        · rcases hpsupp b hb with ⟨i, hi⟩ | ⟨i, hi⟩
          · have : i.castSucc = Fin.last (q + 1) := ha (by simpa [a₀, b] using hi)
            exact Fin.castSucc_ne_last i this
          · exact haz (Fin.last (q + 1)) i.castSucc (by simpa [z₀, b] using hi.symm)
        · exact haz (Fin.last (q + 1)) (Fin.last q) (by simpa [w, b] using hb)
      let p₂ : G.Walk (a₀ 0) b := p₁.concat hright
      have hp₂ : p₂.IsPath := hp₁.concat hb_not hright
      have hstart : a₀ 0 = a 0 := by
        apply congrArg a
        exact Fin.ext rfl
      let p₃ : G.Walk (a 0) (a (Fin.last (q + 1))) := p₂.copy hstart rfl
      refine ⟨p₃, ?_, ?_, ?_⟩
      · simpa [p₃] using hp₂
      · dsimp [p₃]
        rw [SimpleGraph.Walk.length_copy]
        dsimp [p₂, p₁]
        rw [SimpleGraph.Walk.length_concat, SimpleGraph.Walk.length_concat, hplen]
        omega
      · intro v hv
        dsimp [p₃] at hv
        rw [SimpleGraph.Walk.support_copy] at hv
        dsimp [p₂, p₁] at hv
        rw [SimpleGraph.Walk.support_concat, SimpleGraph.Walk.support_concat] at hv
        simp only [List.mem_append, List.mem_singleton] at hv
        rcases hv with (hv | rfl) | rfl
        · rcases hpsupp v hv with ⟨i, hi⟩ | ⟨i, hi⟩
          · exact Or.inl ⟨i.castSucc, by simpa [a₀] using hi⟩
          · exact Or.inr ⟨i.castSucc, by simpa [z₀] using hi⟩
        · exact Or.inr ⟨Fin.last q, rfl⟩
        · exact Or.inl ⟨Fin.last (q + 1), rfl⟩

/-- Every proper prefix of an alternating scaffold is a simple path of the
corresponding even length.  This is the indexed primitive used when the
cyclic reservoir is cut into disjoint linear pieces. -/
theorem exists_prefix_path_of_cyclicAlternatingScaffold
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q r : ℕ} {A B : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    (hr : r < q) :
    ∃ x ∈ A, ∃ y ∈ A, ∃ p : G.Walk x y,
      p.IsPath ∧ p.length = 2 * r ∧
        ∀ v ∈ p.support, v ∈ A ∪ B := by
  classical
  rcases hscaffold with
    ⟨hq, a, b, hA, hB, ha, hb, hAB, hab, hba⟩
  have hrA : r + 1 ≤ q := by omega
  have hrB : r ≤ q := hr.le
  let ea : Fin (r + 1) → Fin q := fun i => Fin.castLE hrA i
  let eb : Fin r → Fin q := fun i => Fin.castLE hrB i
  let a' : Fin (r + 1) → V := fun i => a (ea i)
  let b' : Fin r → V := fun i => b (eb i)
  have hea : Function.Injective ea := by
    intro i j hij
    apply Fin.ext
    exact congrArg (fun x : Fin q ↦ x.val) hij
  have heb : Function.Injective eb := by
    intro i j hij
    apply Fin.ext
    exact congrArg (fun x : Fin q ↦ x.val) hij
  have ha' : Function.Injective a' := ha.comp hea
  have hb' : Function.Injective b' := hb.comp heb
  have hab' : ∀ i : Fin (r + 1), ∀ j : Fin r, a' i ≠ b' j := by
    intro i j hij
    have hai : a' i ∈ A := by
      rw [hA]
      exact Finset.mem_image.mpr ⟨ea i, Finset.mem_univ _, rfl⟩
    have hbj : b' j ∈ B := by
      rw [hB]
      exact Finset.mem_image.mpr ⟨eb j, Finset.mem_univ _, rfl⟩
    exact (Finset.disjoint_left.mp hAB) hai (hij ▸ hbj)
  have hsucc (i : Fin r) :
      finCyclicSucc hq (eb i) = ea i.succ := by
    apply Fin.ext
    change ((i.val + 1) % q) = i.val + 1
    rw [Nat.mod_eq_of_lt]
    exact lt_of_lt_of_le i.succ.isLt hrA
  have hadj : ∀ i : Fin r,
      G.Adj (a' i.castSucc) (b' i) ∧
        G.Adj (b' i) (a' i.succ) := by
    intro i
    constructor
    · simpa [a', b', ea, eb] using hab (eb i)
    · rw [show a' i.succ = a (finCyclicSucc hq (eb i)) by
          simp only [a']; rw [hsucc i]]
      exact hba (eb i)
  obtain ⟨p, hp, hplen, hpsupp⟩ :=
    exists_alternating_path_fin G a' b' ha' hb' hab' hadj
  refine ⟨a' 0, ?_, a' (Fin.last r), ?_, p, hp, hplen, ?_⟩
  · rw [hA]
    exact Finset.mem_image.mpr ⟨ea 0, Finset.mem_univ _, rfl⟩
  · rw [hA]
    exact Finset.mem_image.mpr
      ⟨ea (Fin.last r), Finset.mem_univ _, rfl⟩
  · intro v hv
    rcases hpsupp v hv with ⟨i, rfl⟩ | ⟨j, rfl⟩
    · exact Finset.mem_union_left _ (by
        rw [hA]
        exact Finset.mem_image.mpr ⟨ea i, Finset.mem_univ _, rfl⟩)
    · exact Finset.mem_union_right _ (by
        rw [hB]
        exact Finset.mem_image.mpr ⟨eb j, Finset.mem_univ _, rfl⟩)

/-- Indexed interval form of the scaffold-prefix lemma.  It exposes the
precise consecutive index range occupied by the path, which permits two or
more reservoir intervals to be proved disjoint by arithmetic alone. -/
theorem exists_segment_path_of_cyclicAlternatingScaffold_data
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q s r : ℕ} (hq : 0 < q) (a b : Fin q → V)
    (ha : Function.Injective a) (hb : Function.Injective b)
    (habdisj : ∀ i j : Fin q, a i ≠ b j)
    (hab : ∀ i, G.Adj (a i) (b i))
    (hba : ∀ i, G.Adj (b i) (a (finCyclicSucc hq i)))
    (hsr : s + r < q) :
    let ea : Fin (r + 1) → Fin q := fun i => ⟨s + i.val, by omega⟩
    let eb : Fin r → Fin q := fun i => ⟨s + i.val, by omega⟩
    ∃ p : G.Walk (a (ea 0)) (a (ea (Fin.last r))),
      p.IsPath ∧ p.length = 2 * r ∧
        ∀ v ∈ p.support,
          (∃ i : Fin (r + 1), a (ea i) = v) ∨
            ∃ j : Fin r, b (eb j) = v := by
  let ea : Fin (r + 1) → Fin q := fun i => ⟨s + i.val, by omega⟩
  let eb : Fin r → Fin q := fun i => ⟨s + i.val, by omega⟩
  have hea : Function.Injective ea := by
    intro i j hij
    apply Fin.ext
    have hval := congrArg (fun x : Fin q ↦ x.val) hij
    dsimp [ea] at hval
    omega
  have heb : Function.Injective eb := by
    intro i j hij
    apply Fin.ext
    have hval := congrArg (fun x : Fin q ↦ x.val) hij
    dsimp [eb] at hval
    omega
  have hcross : ∀ i : Fin (r + 1), ∀ j : Fin r,
      a (ea i) ≠ b (eb j) := by
    intro i j
    exact habdisj (ea i) (eb j)
  have hsucc (i : Fin r) :
      finCyclicSucc hq (eb i) = ea i.succ := by
    apply Fin.ext
    change ((s + i.val + 1) % q) = s + (i.val + 1)
    rw [Nat.mod_eq_of_lt]
    · omega
    · omega
  have hadj : ∀ i : Fin r,
      G.Adj (a (ea i.castSucc)) (b (eb i)) ∧
        G.Adj (b (eb i)) (a (ea i.succ)) := by
    intro i
    constructor
    · exact hab (eb i)
    · rw [← hsucc i]
      exact hba (eb i)
  exact exists_alternating_path_fin G
    (fun i => a (ea i)) (fun i => b (eb i))
    (ha.comp hea) (hb.comp heb) hcross hadj

/-- Two fresh connector vertices splice arbitrary core endpoints onto a
chosen scaffold segment.  The long part of the route is paid for by the
alternating cycle; the robust target is charged only two vertices. -/
theorem exists_path_via_scaffold_segment
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {A B D : Finset V} {theta : ℕ}
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D) (htheta : 2 ≤ theta)
    {x u v y : V} (hxA : x ∈ A) (huA : u ∈ A)
    (hvA : v ∈ A) (hyA : y ∈ A)
    {p : G.Walk u v} (hp : p.IsPath)
    (hploc : ∀ w ∈ p.support, w ∈ A ∪ B)
    (hxnot : x ∉ p.support) (hynot : y ∉ p.support) (hxy : x ≠ y) :
    ∃ q : G.Walk x y, q.IsPath ∧ q.length = p.length + 4 ∧
      (∀ w ∈ q.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      ∀ w ∈ q.support, w = x ∨ w = y ∨ w ∈ p.support ∨ w ∈ D := by
  classical
  let left : Fin 2 → V := ![x, v]
  let right : Fin 2 → V := ![u, y]
  have hpairs : ∀ i : Fin 2, theta ≤
      (Erdos163.FiniteDefect.commonNeighbors G
        ![left i, right i] D).card := by
    intro i
    fin_cases i
    · simpa [left, right] using hrob x hxA u huA
    · simpa [left, right] using hrob v hvA y hyA
  obtain ⟨z, hzinj, hz⟩ :=
    exists_fresh_middle_vertices_fin G left right hpairs
      (F := ∅) (by simpa using htheta)
  let z0 : V := z 0
  let z1 : V := z 1
  have hz0D : z0 ∈ D := by simpa [z0] using (hz (0 : Fin 2)).1
  have hz1D : z1 ∈ D := by simpa [z1] using (hz (1 : Fin 2)).1
  have hxz0 : G.Adj x z0 := by
    simpa [left, z0] using (hz (0 : Fin 2)).2.2.1
  have hz0u : G.Adj z0 u := by
    simpa [right, z0] using (hz (0 : Fin 2)).2.2.2
  have hvz1 : G.Adj v z1 := by
    simpa [left, z1] using (hz (1 : Fin 2)).2.2.1
  have hz1y : G.Adj z1 y := by
    simpa [right, z1] using (hz (1 : Fin 2)).2.2.2
  have hz01 : z0 ≠ z1 := by
    intro h
    exact Fin.zero_ne_one (hzinj h)
  have hDnotMajor : ∀ z ∈ D, z ∉ A ∪ B := by
    intro z hzD hzMajor
    exact (Finset.disjoint_left.mp hmajorD) hzMajor hzD
  have hz0Major : z0 ∉ A ∪ B := hDnotMajor z0 hz0D
  have hz1Major : z1 ∉ A ∪ B := hDnotMajor z1 hz1D
  have hz0p : z0 ∉ p.support := by
    intro h
    exact hz0Major (hploc z0 h)
  have hz1p : z1 ∉ p.support := by
    intro h
    exact hz1Major (hploc z1 h)
  have hz0y : z0 ≠ y := by
    intro h
    exact hz0Major (h ▸ Finset.mem_union_left B hyA)
  have hz1yNe : z1 ≠ y := by
    intro h
    exact hz1Major (h ▸ Finset.mem_union_left B hyA)
  have hxz1Ne : x ≠ z1 := by
    intro h
    apply hz1Major
    rw [← h]
    exact Finset.mem_union_left B hxA
  have hxz0Ne : x ≠ z0 := by
    intro h
    apply hz0Major
    rw [← h]
    exact Finset.mem_union_left B hxA
  let p1 : G.Walk u z1 := p.concat hvz1
  have hp1 : p1.IsPath := hp.concat hz1p hvz1
  let p2 : G.Walk u y := p1.concat hz1y
  have hynot1 : y ∉ p1.support := by
    dsimp [p1]
    rw [SimpleGraph.Walk.support_concat]
    simp only [List.mem_append, List.mem_singleton]
    intro h
    rcases h with h | h
    · exact hynot h
    · exact hz1yNe h.symm
  have hp2 : p2.IsPath := hp1.concat hynot1 hz1y
  let p3 : G.Walk z0 y := Walk.cons hz0u p2
  have hz0not2 : z0 ∉ p2.support := by
    dsimp [p2, p1]
    rw [SimpleGraph.Walk.support_concat,
      SimpleGraph.Walk.support_concat]
    simp only [List.mem_append, List.mem_singleton]
    intro h
    rcases h with (h | h) | h
    · exact hz0p h
    · exact hz01 h
    · exact hz0y h
  have hp3 : p3.IsPath := hp2.cons hz0not2
  let q : G.Walk x y := Walk.cons hxz0 p3
  have hxnot3 : x ∉ p3.support := by
    dsimp [p3, p2, p1]
    rw [SimpleGraph.Walk.support_concat,
      SimpleGraph.Walk.support_concat]
    simp only [List.mem_cons, List.mem_append, List.mem_singleton,
      List.not_mem_nil, or_false]
    intro h
    rcases h with h | (h | h) | h
    · exact hxz0Ne h
    · exact hxnot h
    · exact hxz1Ne h
    · exact hxy h
  refine ⟨q, hp3.cons hxnot3, ?_, ?_, ?_⟩
  · simp [q, p3, p2, p1]
  · intro w hw
    dsimp [q, p3, p2, p1] at hw
    rw [SimpleGraph.Walk.support_concat,
      SimpleGraph.Walk.support_concat] at hw
    simp only [List.mem_cons, List.mem_append, List.mem_singleton,
      List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl | (hw | rfl) | rfl
    · exact Or.inl (Finset.mem_union_left _ hxA)
    · exact Or.inr hz0D
    · exact Or.inl (hploc w hw)
    · exact Or.inr hz1D
    · exact Or.inl (Finset.mem_union_left _ hyA)
  · intro w hw
    dsimp [q, p3, p2, p1] at hw
    rw [SimpleGraph.Walk.support_concat,
      SimpleGraph.Walk.support_concat] at hw
    simp only [List.mem_cons, List.mem_append, List.mem_singleton,
      List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl | (hw | rfl) | rfl
    · exact Or.inl rfl
    · exact Or.inr (Or.inr (Or.inr hz0D))
    · exact Or.inr (Or.inr (Or.inl hw))
    · exact Or.inr (Or.inr (Or.inr hz1D))
    · exact Or.inr (Or.inl rfl)

/-- Indexed one-segment splice.  The caller specifies a nonwrapping scaffold
interval and proves that neither prescribed endpoint index occurs in it. -/
theorem exists_route_via_scaffold_segment_avoiding_indices
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q s r theta : ℕ} {A B D : Finset V}
    (hq : 0 < q) (a b : Fin q → V)
    (ha : Function.Injective a) (hb : Function.Injective b)
    (haA : ∀ i, a i ∈ A) (hbB : ∀ i, b i ∈ B)
    (hAB : Disjoint A B)
    (hab : ∀ i, G.Adj (a i) (b i))
    (hba : ∀ i, G.Adj (b i) (a (finCyclicSucc hq i)))
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D) (htheta : 2 ≤ theta)
    (hsr : s + r < q) (ix iy : Fin q)
    (hix : ∀ i : Fin (r + 1), ix.val ≠ s + i.val)
    (hiy : ∀ i : Fin (r + 1), iy.val ≠ s + i.val)
    (hxy : a ix ≠ a iy) :
    ∃ p : G.Walk (a ix) (a iy), p.IsPath ∧ p.length = 2 * r + 4 ∧
      (∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      b ix ∉ p.support ∧ b iy ∉ p.support := by
  classical
  let ea : Fin (r + 1) → Fin q := fun i => ⟨s + i.val, by omega⟩
  let eb : Fin r → Fin q := fun i => ⟨s + i.val, by omega⟩
  have habdisj : ∀ i j : Fin q, a i ≠ b j := by
    intro i j hij
    exact (Finset.disjoint_left.mp hAB) (haA i) (hij ▸ hbB j)
  obtain ⟨p, hp, hplen, hpsupp⟩ :=
    exists_segment_path_of_cyclicAlternatingScaffold_data
      G hq a b ha hb habdisj hab hba hsr
  have hploc : ∀ w ∈ p.support, w ∈ A ∪ B := by
    intro w hw
    rcases hpsupp w hw with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact Finset.mem_union_left _ (haA (ea i))
    · exact Finset.mem_union_right _ (hbB (eb i))
  have hxnot : a ix ∉ p.support := by
    intro hx
    rcases hpsupp (a ix) hx with ⟨i, hi⟩ | ⟨i, hi⟩
    · have hieq : ix = ea i := (ha hi).symm
      have hval := congrArg (fun z : Fin q ↦ z.val) hieq
      exact hix i (by simpa [ea] using hval)
    · exact (Finset.disjoint_left.mp hAB) (haA ix) (hi ▸ hbB (eb i))
  have hynot : a iy ∉ p.support := by
    intro hy
    rcases hpsupp (a iy) hy with ⟨i, hi⟩ | ⟨i, hi⟩
    · have hieq : iy = ea i := (ha hi).symm
      have hval := congrArg (fun z : Fin q ↦ z.val) hieq
      exact hiy i (by simpa [ea] using hval)
    · exact (Finset.disjoint_left.mp hAB) (haA iy) (hi ▸ hbB (eb i))
  have hbixnot : b ix ∉ p.support := by
    intro hx
    rcases hpsupp (b ix) hx with ⟨i, hi⟩ | ⟨i, hi⟩
    · exact (Finset.disjoint_left.mp hAB) (haA (ea i)) (hi ▸ hbB ix)
    · have hieq : eb i = ix := hb hi
      have hval := congrArg (fun z : Fin q ↦ z.val) hieq
      exact hix i.castSucc (by simpa [eb] using hval.symm)
  have hbiynot : b iy ∉ p.support := by
    intro hy
    rcases hpsupp (b iy) hy with ⟨i, hi⟩ | ⟨i, hi⟩
    · exact (Finset.disjoint_left.mp hAB) (haA (ea i)) (hi ▸ hbB iy)
    · have hieq : eb i = iy := hb hi
      have hval := congrArg (fun z : Fin q ↦ z.val) hieq
      exact hiy i.castSucc (by simpa [eb] using hval.symm)
  obtain ⟨route, hroute, hrouteLen, hrouteLoc, hrouteSupport⟩ :=
    exists_path_via_scaffold_segment G hrob hmajorD htheta
      (haA ix) (haA (ea 0)) (haA (ea (Fin.last r))) (haA iy)
      hp hploc hxnot hynot hxy
  refine ⟨route, hroute, by omega, hrouteLoc, ?_, ?_⟩
  · intro hx
    rcases hrouteSupport (b ix) hx with hx | hx | hx | hx
    · exact (Finset.disjoint_left.mp hAB) (haA ix) (hx ▸ hbB ix)
    · exact (Finset.disjoint_left.mp hAB) (haA iy) (hx ▸ hbB ix)
    · exact hbixnot hx
    · exact (Finset.disjoint_left.mp hmajorD)
        (Finset.mem_union_right A (hbB ix)) hx
  · intro hy
    rcases hrouteSupport (b iy) hy with hy | hy | hy | hy
    · exact (Finset.disjoint_left.mp hAB) (haA ix) (hy ▸ hbB iy)
    · exact (Finset.disjoint_left.mp hAB) (haA iy) (hy ▸ hbB iy)
    · exact hbiynot hy
    · exact (Finset.disjoint_left.mp hmajorD)
        (Finset.mem_union_right A (hbB iy)) hy

/-- Three disjoint candidate intervals let a scaffold route avoid two
prescribed core endpoints.  The chosen interval uses `r + 1` core vertices;
if `3 * (r + 1) ≤ q`, two endpoints can spoil at most two of the first three
intervals.  Two fresh vertices of `D` then splice the endpoints onto the
remaining interval. -/
theorem exists_short_route_via_cyclicAlternatingScaffold
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q r theta : ℕ} {A B D : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D) (htheta : 2 ≤ theta)
    (hthree : 3 * (r + 1) ≤ q)
    {x y : V} (hxA : x ∈ A) (hyA : y ∈ A) (hxy : x ≠ y) :
    ∃ p : G.Walk x y, p.IsPath ∧ p.length = 2 * r + 4 ∧
      ∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D := by
  classical
  rcases hscaffold with
    ⟨hq, a, b, hA, hB, ha, hb, hAB, hab, hba⟩
  obtain ⟨ix, _hix, hax⟩ := Finset.mem_image.mp (hA ▸ hxA)
  obtain ⟨iy, _hiy, hay⟩ := Finset.mem_image.mp (hA ▸ hyA)
  subst x
  subst y
  let L : ℕ := r + 1
  have hqL : 3 * L ≤ q := by simpa [L] using hthree
  have build (s : ℕ) (hsr : s + r < q)
      (hix : ∀ i : Fin (r + 1), ix.val ≠ s + i.val)
      (hiy : ∀ i : Fin (r + 1), iy.val ≠ s + i.val) :
      ∃ p : G.Walk (a ix) (a iy), p.IsPath ∧ p.length = 2 * r + 4 ∧
        ∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D := by
    let ea : Fin (r + 1) → Fin q := fun i => ⟨s + i.val, by omega⟩
    let eb : Fin r → Fin q := fun i => ⟨s + i.val, by omega⟩
    have habdisj : ∀ i j : Fin q, a i ≠ b j := by
      intro i j hij
      apply (Finset.disjoint_left.mp hAB)
        (show a i ∈ A by
          rw [hA]
          exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
      rw [hij, hB]
      exact Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩
    obtain ⟨p, hp, hplen, hpsupp⟩ :=
      exists_segment_path_of_cyclicAlternatingScaffold_data
        G hq a b ha hb habdisj hab hba hsr
    have heaA : ∀ i : Fin (r + 1), a (ea i) ∈ A := by
      intro i
      rw [hA]
      exact Finset.mem_image.mpr ⟨ea i, Finset.mem_univ _, rfl⟩
    have hebB : ∀ i : Fin r, b (eb i) ∈ B := by
      intro i
      rw [hB]
      exact Finset.mem_image.mpr ⟨eb i, Finset.mem_univ _, rfl⟩
    have haixA : a ix ∈ A := by
      rw [hA]
      exact Finset.mem_image.mpr ⟨ix, Finset.mem_univ _, rfl⟩
    have haiyA : a iy ∈ A := by
      rw [hA]
      exact Finset.mem_image.mpr ⟨iy, Finset.mem_univ _, rfl⟩
    have hploc : ∀ w ∈ p.support, w ∈ A ∪ B := by
      intro w hw
      rcases hpsupp w hw with ⟨i, rfl⟩ | ⟨i, rfl⟩
      · exact Finset.mem_union_left _ (heaA i)
      · exact Finset.mem_union_right _ (hebB i)
    have hxnot : a ix ∉ p.support := by
      intro hx
      rcases hpsupp (a ix) hx with ⟨i, hi⟩ | ⟨i, hi⟩
      · have hieq : ix = ea i := (ha hi).symm
        have hval := congrArg (fun z : Fin q ↦ z.val) hieq
        exact hix i (by simpa [ea] using hval)
      · exact (Finset.disjoint_left.mp hAB) haixA (hi ▸ hebB i)
    have hynot : a iy ∉ p.support := by
      intro hy
      rcases hpsupp (a iy) hy with ⟨i, hi⟩ | ⟨i, hi⟩
      · have hieq : iy = ea i := (ha hi).symm
        have hval := congrArg (fun z : Fin q ↦ z.val) hieq
        exact hiy i (by simpa [ea] using hval)
      · exact (Finset.disjoint_left.mp hAB) haiyA (hi ▸ hebB i)
    obtain ⟨route, hroute, hrouteLen, hrouteLoc, _hrouteSupport⟩ :=
      exists_path_via_scaffold_segment G hrob hmajorD htheta
        haixA
        (heaA 0) (heaA (Fin.last r))
        haiyA
        hp hploc hxnot hynot hxy
    refine ⟨route, hroute, ?_, hrouteLoc⟩
    omega
  by_cases h0x : ix.val < L
  · by_cases h0y : iy.val < L
    · exact build L (by omega)
        (by
          intro i hi
          have hiLt : i.val < L := by simpa [L] using i.isLt
          dsimp [L] at h0x hiLt hi ⊢
          omega)
        (by
          intro i hi
          have hiLt : i.val < L := by simpa [L] using i.isLt
          dsimp [L] at h0y hiLt hi ⊢
          omega)
    · by_cases h1y : L ≤ iy.val ∧ iy.val < 2 * L
      · have hix2 : ix.val < 2 * L := by omega
        have hiy2 : iy.val < 2 * L := h1y.2
        exact build (2 * L) (by omega)
          (by
            intro i hi
            dsimp [L] at hi hix2
            omega)
          (by
            intro i hi
            dsimp [L] at hi hiy2
            omega)
      · exact build L (by omega)
          (by
            intro i hi
            have hiLt : i.val < L := by simpa [L] using i.isLt
            dsimp [L] at h0x hiLt hi ⊢
            omega)
          (by
            intro i hi
            have hiLt : i.val < L := by simpa [L] using i.isLt
            dsimp [L] at h1y hiLt hi ⊢
            omega)
  · by_cases h0y : iy.val < L
    · by_cases h1x : L ≤ ix.val ∧ ix.val < 2 * L
      · have hix2 : ix.val < 2 * L := h1x.2
        have hiy2 : iy.val < 2 * L := by omega
        exact build (2 * L) (by omega)
          (by
            intro i hi
            dsimp [L] at hi hix2
            omega)
          (by
            intro i hi
            dsimp [L] at hi hiy2
            omega)
      · exact build L (by omega)
          (by
            intro i hi
            have hiLt : i.val < L := by simpa [L] using i.isLt
            dsimp [L] at h1x hiLt hi ⊢
            omega)
          (by
            intro i hi
            have hiLt : i.val < L := by simpa [L] using i.isLt
            dsimp [L] at h0y hiLt hi ⊢
            omega)
    · exact build 0 (by omega)
        (by
          intro i hi
          have hiLt : i.val < L := by simpa [L] using i.isLt
          dsimp [L] at h0x hiLt hi ⊢
          omega)
        (by
          intro i hi
          have hiLt : i.val < L := by simpa [L] using i.isLt
          dsimp [L] at h0y hiLt hi ⊢
          omega)

/-- A robust pair reservoir contains an alternating path using any prescribed
number of reservoir vertices, provided the fresh-neighbour budget covers the
chosen endpoints and the new middle vertices.  This is the fixed-parameter
reservoir path used by the eventual version of the KLS hub argument. -/
theorem exists_alternating_path_of_robustPairSet
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ q : ℕ} (hrob : RobustPairSet G U T θ)
    (hUcard : q + 1 ≤ U.card) (hbudget : 2 * q + 1 ≤ θ) :
    ∃ a b : V, ∃ p : G.Walk a b,
      a ∈ U ∧ b ∈ U ∧ p.IsPath ∧ p.length = 2 * q := by
  classical
  obtain ⟨A, hAU, hAcard⟩ := Finset.exists_subset_card_eq hUcard
  let e : Fin (q + 1) ≃ A := (Finset.equivFinOfCardEq hAcard).symm
  let a : Fin (q + 1) → V := fun i => e i
  have ha : Function.Injective a := by
    intro i j hij
    apply e.injective
    exact Subtype.ext hij
  have haU : ∀ i : Fin (q + 1), a i ∈ U := by
    intro i
    exact hAU (e i).property
  let left : Fin q → V := fun i => a i.castSucc
  let right : Fin q → V := fun i => a i.succ
  have hpair : ∀ i : Fin q, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![left i, right i] T).card := by
    intro i
    exact hrob _ (haU i.castSucc) _ (haU i.succ)
  have hbudget' : A.card + q ≤ θ := by
    rw [hAcard]
    omega
  obtain ⟨z, hz, hzadjs⟩ :=
    exists_fresh_middle_vertices_fin G left right hpair hbudget'
  have haz : ∀ i : Fin (q + 1), ∀ j : Fin q, a i ≠ z j := by
    intro i j hij
    apply (hzadjs j).2.1
    rw [← hij]
    exact (e i).property
  have hadj : ∀ i : Fin q,
      G.Adj (a i.castSucc) (z i) ∧ G.Adj (z i) (a i.succ) := by
    intro i
    simpa [left, right] using (hzadjs i).2.2
  obtain ⟨p, hp, hplen, _hsupp⟩ :=
    exists_alternating_path_fin G a z ha hz haz hadj
  exact ⟨a 0, a (Fin.last q), p, haU 0, haU (Fin.last q), hp, hplen⟩

/-- Prescribed-endpoint even route through a robust reservoir.  Besides the
two endpoints, the proof chooses exactly r further reservoir vertices and
then applies the alternating-path constructor.  This is the route shape
needed when an external handle has already fixed its two attachment points. -/
theorem exists_even_path_between_of_robustPairSet
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ r : ℕ} (hrob : RobustPairSet G U T θ)
    {a b : V} (haU : a ∈ U) (hbU : b ∈ U) (hab : a ≠ b)
    (hUcard : r + 2 ≤ U.card) (hbudget : 2 * (r + 1) + 1 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = 2 * (r + 1) := by
  classical
  let W : Finset V := (U.erase a).erase b
  have hbErase : b ∈ U.erase a := Finset.mem_erase.mpr ⟨hab.symm, hbU⟩
  have hWcard : r ≤ W.card := by
    simp only [W, Finset.card_erase_of_mem hbErase, Finset.card_erase_of_mem haU]
    omega
  obtain ⟨A, hAW, hAcard⟩ := Finset.exists_subset_card_eq hWcard
  let e : Fin r ≃ A := (Finset.equivFinOfCardEq hAcard).symm
  let g : Fin (r + 1) → V := Fin.cons a (fun i : Fin r => e i)
  let f : Fin (r + 2) → V := Fin.snoc g b
  have heinj : Function.Injective (fun i : Fin r => (e i : V)) := by
    intro i j h
    apply e.injective
    exact Subtype.ext h
  have ha_not_range : a ∉ Set.range (fun i : Fin r => (e i : V)) := by
    rintro ⟨i, hi⟩
    have heiW : (e i : V) ∈ W := hAW (e i).property
    have hne : (e i : V) ≠ a := (Finset.mem_erase.mp (Finset.mem_erase.mp heiW).2).1
    exact hne hi
  have hginj : Function.Injective g := by
    exact Fin.cons_injective_iff.mpr ⟨ha_not_range, heinj⟩
  have hb_not_range : b ∉ Set.range g := by
    rintro ⟨i, hi⟩
    induction i using Fin.cases with
    | zero =>
        exact hab (by simpa [g] using hi)
    | succ i =>
        have heiW : (e i : V) ∈ W := hAW (e i).property
        have hne : (e i : V) ≠ b := (Finset.mem_erase.mp heiW).1
        exact hne (by simpa [g] using hi)
  have hfinj : Function.Injective f :=
    Fin.snoc_injective_iff.mpr ⟨hginj, hb_not_range⟩
  have hfU : ∀ i : Fin (r + 2), f i ∈ U := by
    intro i
    induction i using Fin.lastCases with
    | last => simpa [f] using hbU
    | cast i =>
        dsimp [f]
        rw [Fin.snoc_castSucc]
        induction i using Fin.cases with
        | zero =>
            change a ∈ U
            exact haU
        | succ j =>
            have hejW : (e j : V) ∈ W := hAW (e j).property
            have hejU : (e j : V) ∈ U :=
              (Finset.mem_erase.mp (Finset.mem_erase.mp hejW).2).2
            change (e j : V) ∈ U
            exact hejU
  let F : Finset V := Finset.univ.image f
  have hFcard : F.card = r + 2 := by
    dsimp [F]
    rw [Finset.card_image_of_injective _ hfinj]
    simp
  let left : Fin (r + 1) → V := fun i => f i.castSucc
  let right : Fin (r + 1) → V := fun i => f i.succ
  have hpair : ∀ i : Fin (r + 1), θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![left i, right i] T).card := by
    intro i
    exact hrob _ (hfU i.castSucc) _ (hfU i.succ)
  have hrouteBudget : F.card + (r + 1) ≤ θ := by
    rw [hFcard]
    omega
  obtain ⟨z, hzinj, hz⟩ :=
    exists_fresh_middle_vertices_fin G left right hpair hrouteBudget
  have hfz : ∀ i : Fin (r + 2), ∀ j : Fin (r + 1), f i ≠ z j := by
    intro i j hij
    apply (hz j).2.1
    rw [← hij]
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hadj : ∀ i : Fin (r + 1),
      G.Adj (f i.castSucc) (z i) ∧ G.Adj (z i) (f i.succ) := by
    intro i
    simpa [left, right] using (hz i).2.2
  obtain ⟨p, hp, hplen, _⟩ :=
    exists_alternating_path_fin G f z hfinj hzinj hfz hadj
  have hstart : f 0 = a := by simp [f, g]
  have hend : f (Fin.last (r + 1)) = b := by simp [f]
  let p' : G.Walk a b := p.copy hstart hend
  refine ⟨p', ?_, ?_⟩
  · simpa [p'] using hp
  · simpa [p', SimpleGraph.Walk.length_copy] using hplen

/-- Avoiding version of the prescribed even route.  A previously used finite
set is charged directly to the common-neighbour budget, while every new
reservoir vertex is chosen outside it.  This is the basic disjointness
interface for greedy assembly of several hub paths. -/
theorem exists_even_path_between_of_robustPairSet_avoiding
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T F : Finset V} {θ r : ℕ} (hrob : RobustPairSet G U T θ)
    {a b : V} (haU : a ∈ U) (hbU : b ∈ U) (haF : a ∉ F) (hbF : b ∉ F)
    (hab : a ≠ b) (hUcard : r + 2 ≤ (U \ F).card)
    (hbudget : F.card + 2 * (r + 1) + 1 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = 2 * (r + 1) ∧
      (∀ v ∈ p.support, v ∉ F) ∧
      ∀ v ∈ p.support, v ∈ U ∨ v ∈ T := by
  classical
  let U' : Finset V := U \ F
  have haU' : a ∈ U' := Finset.mem_sdiff.mpr ⟨haU, haF⟩
  have hbU' : b ∈ U' := Finset.mem_sdiff.mpr ⟨hbU, hbF⟩
  let W : Finset V := (U'.erase a).erase b
  have hbErase : b ∈ U'.erase a := Finset.mem_erase.mpr ⟨hab.symm, hbU'⟩
  have hWcard : r ≤ W.card := by
    simp only [W, Finset.card_erase_of_mem hbErase, Finset.card_erase_of_mem haU']
    change r ≤ (U \ F).card - 1 - 1
    omega
  obtain ⟨A, hAW, hAcard⟩ := Finset.exists_subset_card_eq hWcard
  let e : Fin r ≃ A := (Finset.equivFinOfCardEq hAcard).symm
  let g : Fin (r + 1) → V := Fin.cons a (fun i : Fin r => e i)
  let f : Fin (r + 2) → V := Fin.snoc g b
  have heinj : Function.Injective (fun i : Fin r => (e i : V)) := by
    intro i j h
    apply e.injective
    exact Subtype.ext h
  have ha_not_range : a ∉ Set.range (fun i : Fin r => (e i : V)) := by
    rintro ⟨i, hi⟩
    have heiW : (e i : V) ∈ W := hAW (e i).property
    have hne : (e i : V) ≠ a := (Finset.mem_erase.mp (Finset.mem_erase.mp heiW).2).1
    exact hne hi
  have hginj : Function.Injective g :=
    Fin.cons_injective_iff.mpr ⟨ha_not_range, heinj⟩
  have hb_not_range : b ∉ Set.range g := by
    rintro ⟨i, hi⟩
    induction i using Fin.cases with
    | zero => exact hab (by simpa [g] using hi)
    | succ i =>
        have heiW : (e i : V) ∈ W := hAW (e i).property
        have hne : (e i : V) ≠ b := (Finset.mem_erase.mp heiW).1
        exact hne (by simpa [g] using hi)
  have hfinj : Function.Injective f :=
    Fin.snoc_injective_iff.mpr ⟨hginj, hb_not_range⟩
  have hfU' : ∀ i : Fin (r + 2), f i ∈ U' := by
    intro i
    induction i using Fin.lastCases with
    | last => simpa [f] using hbU'
    | cast i =>
        dsimp [f]
        rw [Fin.snoc_castSucc]
        induction i using Fin.cases with
        | zero => exact haU'
        | succ j =>
            have hejW : (e j : V) ∈ W := hAW (e j).property
            exact (Finset.mem_erase.mp (Finset.mem_erase.mp hejW).2).2
  have hfU : ∀ i : Fin (r + 2), f i ∈ U := by
    intro i
    exact (Finset.mem_sdiff.mp (hfU' i)).1
  have hfF : ∀ i : Fin (r + 2), f i ∉ F := by
    intro i
    exact (Finset.mem_sdiff.mp (hfU' i)).2
  let endpoints : Finset V := Finset.univ.image f
  have hendpointsCard : endpoints.card = r + 2 := by
    dsimp [endpoints]
    rw [Finset.card_image_of_injective _ hfinj]
    simp
  let forbidden : Finset V := F ∪ endpoints
  have hforbiddenCard : forbidden.card ≤ F.card + (r + 2) := by
    calc
      forbidden.card ≤ F.card + endpoints.card := Finset.card_union_le _ _
      _ = F.card + (r + 2) := by rw [hendpointsCard]
  let left : Fin (r + 1) → V := fun i => f i.castSucc
  let right : Fin (r + 1) → V := fun i => f i.succ
  have hpair : ∀ i : Fin (r + 1), θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![left i, right i] T).card := by
    intro i
    exact hrob _ (hfU i.castSucc) _ (hfU i.succ)
  have hrouteBudget : forbidden.card + (r + 1) ≤ θ := by
    omega
  obtain ⟨z, hzinj, hz⟩ :=
    exists_fresh_middle_vertices_fin G left right hpair hrouteBudget
  have hfz : ∀ i : Fin (r + 2), ∀ j : Fin (r + 1), f i ≠ z j := by
    intro i j hij
    apply (hz j).2.1
    apply Finset.mem_union_right
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, hij⟩
  have hzF : ∀ j : Fin (r + 1), z j ∉ F := by
    intro j hzF
    exact (hz j).2.1 (Finset.mem_union_left _ hzF)
  have hadj : ∀ i : Fin (r + 1),
      G.Adj (f i.castSucc) (z i) ∧ G.Adj (z i) (f i.succ) := by
    intro i
    simpa [left, right] using (hz i).2.2
  obtain ⟨p, hp, hplen, hpsupp⟩ :=
    exists_alternating_path_fin G f z hfinj hzinj hfz hadj
  have hstart : f 0 = a := by simp [f, g]
  have hend : f (Fin.last (r + 1)) = b := by simp [f]
  let p' : G.Walk a b := p.copy hstart hend
  refine ⟨p', ?_, ?_, ?_, ?_⟩
  · simpa [p'] using hp
  · simpa [p', SimpleGraph.Walk.length_copy] using hplen
  · intro v hv
    have hvp : v ∈ p.support := by simpa [p'] using hv
    rcases hpsupp v hvp with ⟨i, rfl⟩ | ⟨j, rfl⟩
    · exact hfF i
    · exact hzF j
  · intro v hv
    have hvp : v ∈ p.support := by simpa [p'] using hv
    rcases hpsupp v hvp with ⟨i, rfl⟩ | ⟨j, rfl⟩
    · exact Or.inl (hfU i)
    · exact Or.inr (hz j).1

/-- Greedy family form of avoiding even robust routes.  All endpoint pairs
are globally distinct.  Earlier routes are asked to avoid the endpoints of
later routes; the final route then avoids the accumulated earlier supports.
The displayed uniform bounds charge at most `length + 1` vertices per route
and are intentionally simple to compose with a doubled-tree traversal. -/
theorem exists_pairwise_disjoint_even_paths_varying_robust
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∀ {q s θ : ℕ} (hub : Fin q → ι) (U T : ι → Finset V)
      (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
      (a b : Fin q → V) (F : Finset V),
      (∀ i, a i ∈ U (hub i)) → (∀ i, b i ∈ U (hub i)) →
      (∀ i, a i ∉ F) → (∀ i, b i ∉ F) →
      (∀ i, a i ≠ b i) →
      (∀ i j, i ≠ j →
        a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j) →
      (∀ i, F.card + q * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hub i)).card) →
      F.card + q * (2 * (s + 1) + 1) ≤ θ →
      ∃ p : ∀ i : Fin q, G.Walk (a i) (b i),
        (∀ i, (p i).IsPath) ∧
        (∀ i, (p i).length = 2 * (s + 1)) ∧
        (∀ i, ∀ v ∈ (p i).support, v ∉ F) ∧
        (∀ i, ∀ v ∈ (p i).support,
          v ∈ U (hub i) ∨ v ∈ T (hub i)) ∧
        ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  intro q
  induction q with
  | zero =>
      intro s θ hub U T hrob a b F ha hb haF hbF hab hpairs hU hθ
      exact ⟨fun i => i.elim0, by simp⟩
  | succ q ih =>
      intro s θ hub U T hrob a b F ha hb haF hbF hab hpairs hU hθ
      let last : Fin (q + 1) := Fin.last q
      let hub₀ : Fin q → ι := fun i => hub i.castSucc
      let a₀ : Fin q → V := fun i => a i.castSucc
      let b₀ : Fin q → V := fun i => b i.castSucc
      let F' : Finset V := insert (a last) (insert (b last) F)
      have hF'card : F'.card ≤ F.card + 2 := by
        dsimp [F']
        calc
          (insert (a last) (insert (b last) F)).card ≤
              (insert (b last) F).card + 1 := Finset.card_insert_le _ _
          _ ≤ F.card + 1 + 1 := Nat.add_le_add_right (Finset.card_insert_le _ _) 1
          _ = F.card + 2 := by omega
      have ha₀F : ∀ i, a₀ i ∉ F' := by
        intro i
        have hpair := hpairs i.castSucc last (Fin.castSucc_ne_last i)
        simp [a₀, F', hpair.1, hpair.2.1, haF i.castSucc]
      have hb₀F : ∀ i, b₀ i ∉ F' := by
        intro i
        have hpair := hpairs i.castSucc last (Fin.castSucc_ne_last i)
        simp [b₀, F', hpair.2.2.1, hpair.2.2.2, hbF i.castSucc]
      have hU₀ : ∀ i, F'.card + q * (2 * (s + 1) + 1) + (s + 2) ≤
          (U (hub₀ i)).card := by
        intro i
        have hi := hU i.castSucc
        have hmul : (q + 1) * (2 * (s + 1) + 1) =
            q * (2 * (s + 1) + 1) + (2 * (s + 1) + 1) := by
          rw [Nat.add_mul]
          simp
        dsimp [hub₀]
        omega
      have hθ₀ : F'.card + q * (2 * (s + 1) + 1) ≤ θ := by
        have hmul : (q + 1) * (2 * (s + 1) + 1) =
            q * (2 * (s + 1) + 1) + (2 * (s + 1) + 1) := by
          rw [Nat.add_mul]
          simp
        omega
      obtain ⟨p, hp, hplen, hpavoid, hploc, hpdisj⟩ :=
        ih hub₀ U T hrob a₀ b₀ F'
          (fun i => ha i.castSucc) (fun i => hb i.castSucc)
          ha₀F hb₀F (fun i => hab i.castSucc)
          (fun i j hij => hpairs i.castSucc j.castSucc (by
            intro h
            exact hij (Fin.castSucc_injective _ h)))
          hU₀ hθ₀
      let used : Finset V :=
        F ∪ (Finset.univ : Finset (Fin q)).biUnion
          (fun i => (p i).support.toFinset)
      have hsuppCard : ∀ i : Fin q,
          (p i).support.toFinset.card = 2 * (s + 1) + 1 := by
        intro i
        rw [List.toFinset_card_of_nodup (hp i).support_nodup,
          (p i).length_support, hplen i]
      have hUnionCard : ((Finset.univ : Finset (Fin q)).biUnion
          (fun i => (p i).support.toFinset)).card ≤
          q * (2 * (s + 1) + 1) := by
        calc
          ((Finset.univ : Finset (Fin q)).biUnion
              (fun i => (p i).support.toFinset)).card ≤
              (Finset.univ : Finset (Fin q)).card * (2 * (s + 1) + 1) := by
            apply Finset.card_biUnion_le_card_mul
            intro i _hi
            exact (hsuppCard i).le
          _ = q * (2 * (s + 1) + 1) := by simp
      have husedCard : used.card ≤ F.card + q * (2 * (s + 1) + 1) := by
        have hu := Finset.card_union_le F
          ((Finset.univ : Finset (Fin q)).biUnion
            (fun i => (p i).support.toFinset))
        change used.card ≤ F.card + q * (2 * (s + 1) + 1)
        dsimp [used]
        omega
      have haLastUsed : a last ∉ used := by
        intro hmem
        rcases Finset.mem_union.mp hmem with hmem | hmem
        · exact haF last hmem
        · rcases Finset.mem_biUnion.mp hmem with ⟨i, _hi, hmem⟩
          have hav := hpavoid i (a last) (by simpa using hmem)
          exact hav (by simp [F'])
      have hbLastUsed : b last ∉ used := by
        intro hmem
        rcases Finset.mem_union.mp hmem with hmem | hmem
        · exact hbF last hmem
        · rcases Finset.mem_biUnion.mp hmem with ⟨i, _hi, hmem⟩
          have hav := hpavoid i (b last) (by simpa using hmem)
          exact hav (by simp [F'])
      have hLastCard : s + 2 ≤ (U (hub last) \ used).card := by
        have hUl := hU last
        have hmul : (q + 1) * (2 * (s + 1) + 1) =
            q * (2 * (s + 1) + 1) + (2 * (s + 1) + 1) := by
          rw [Nat.add_mul]
          simp
        have hbase : s + 2 ≤ (U (hub last)).card - used.card := by
          omega
        have hret : (U (hub last)).card - used.card ≤
            (U (hub last) \ used).card :=
          sub_le_card_sdiff_of_le_card_of_card_le le_rfl le_rfl
        exact hbase.trans hret
      have hLastBudget : used.card + 2 * (s + 1) + 1 ≤ θ := by
        have hmul : (q + 1) * (2 * (s + 1) + 1) =
            q * (2 * (s + 1) + 1) + (2 * (s + 1) + 1) := by
          rw [Nat.add_mul]
          simp
        omega
      obtain ⟨plast, hplast, hplastlen, hplastavoid, hplastloc⟩ :=
        exists_even_path_between_of_robustPairSet_avoiding G (hrob (hub last))
          (ha last) (hb last) haLastUsed hbLastUsed (hab last)
          hLastCard hLastBudget
      let p' : ∀ i : Fin (q + 1), G.Walk (a i) (b i) :=
        Fin.lastCases plast p
      refine ⟨p', ?_, ?_, ?_, ?_, ?_⟩
      · intro i
        induction i using Fin.lastCases with
        | last => simpa [p'] using hplast
        | cast i => simpa [p', a₀, b₀] using hp i
      · intro i
        induction i using Fin.lastCases with
        | last => simpa [p'] using hplastlen
        | cast i => simpa [p'] using hplen i
      · intro i v hv
        induction i using Fin.lastCases with
        | last =>
            exact fun hvF => hplastavoid v (by simpa [p'] using hv)
              (Finset.mem_union_left _ hvF)
        | cast i =>
            have hold := hpavoid i v (by simpa [p'] using hv)
            intro hvF
            apply hold
            exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hvF)
      · intro i v hv
        induction i using Fin.lastCases with
        | last => simpa [p'] using hplastloc v (by simpa [p'] using hv)
        | cast i => simpa [p', hub₀] using hploc i v (by simpa [p'] using hv)
      · intro i j hij
        induction i using Fin.lastCases with
        | last =>
            induction j using Fin.lastCases with
            | last => exact (hij rfl).elim
            | cast j =>
                intro v hvlast hvj
                apply hplastavoid v (by simpa [p'] using hvlast)
                apply Finset.mem_union_right
                apply Finset.mem_biUnion.mpr
                exact ⟨j, Finset.mem_univ _, by simpa [p'] using hvj⟩
        | cast i =>
            induction j using Fin.lastCases with
            | last =>
                intro v hvi hvlast
                apply hplastavoid v (by simpa [p'] using hvlast)
                apply Finset.mem_union_right
                apply Finset.mem_biUnion.mpr
                exact ⟨i, Finset.mem_univ _, by simpa [p'] using hvi⟩
            | cast j =>
                have hij' : i ≠ j := by
                  intro h
                  exact hij (congrArg Fin.castSucc h)
                simpa [p'] using hpdisj i j hij'

/-- Greedy robust routing with an individually prescribed even length for
each request.  The resource hypothesis is the sum of the actual path-support
sizes rather than a uniform maximum times the number of requests.  This is
the local allocation form used when a doubled-tree tour revisits hubs with
very different degrees. -/
theorem exists_pairwise_disjoint_even_paths_lengths_robust
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    ∀ {q θ : ℕ} (r : Fin q → ℕ) (hub : Fin q → ι)
      (U T : ι → Finset V)
      (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
      (a b : Fin q → V) (F : Finset V),
      (∀ i, a i ∈ U (hub i)) → (∀ i, b i ∈ U (hub i)) →
      (∀ i, a i ∉ F) → (∀ i, b i ∉ F) →
      (∀ i, a i ≠ b i) →
      (∀ i j, i ≠ j →
        a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j) →
      (∀ i, F.card + (∑ j : Fin q, (2 * (r j + 1) + 1)) +
          (r i + 2) ≤ (U (hub i)).card) →
      F.card + (∑ j : Fin q, (2 * (r j + 1) + 1)) ≤ θ →
      ∃ p : ∀ i : Fin q, G.Walk (a i) (b i),
        (∀ i, (p i).IsPath) ∧
        (∀ i, (p i).length = 2 * (r i + 1)) ∧
        (∀ i, ∀ v ∈ (p i).support, v ∉ F) ∧
        (∀ i, ∀ v ∈ (p i).support,
          v ∈ U (hub i) ∨ v ∈ T (hub i)) ∧
        ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  intro q
  induction q with
  | zero =>
      intro θ r hub U T hrob a b F ha hb haF hbF hab hpairs hU hθ
      exact ⟨fun i => i.elim0, by simp⟩
  | succ q ih =>
      intro θ r hub U T hrob a b F ha hb haF hbF hab hpairs hU hθ
      let last : Fin (q + 1) := Fin.last q
      let r₀ : Fin q → ℕ := fun i => r i.castSucc
      let hub₀ : Fin q → ι := fun i => hub i.castSucc
      let a₀ : Fin q → V := fun i => a i.castSucc
      let b₀ : Fin q → V := fun i => b i.castSucc
      let F' : Finset V := insert (a last) (insert (b last) F)
      have hF'card : F'.card ≤ F.card + 2 := by
        dsimp [F']
        calc
          (insert (a last) (insert (b last) F)).card ≤
              (insert (b last) F).card + 1 := Finset.card_insert_le _ _
          _ ≤ F.card + 1 + 1 :=
            Nat.add_le_add_right (Finset.card_insert_le _ _) 1
          _ = F.card + 2 := by omega
      have hsum :
          (∑ i : Fin (q + 1), (2 * (r i + 1) + 1)) =
            (∑ i : Fin q, (2 * (r₀ i + 1) + 1)) +
              (2 * (r last + 1) + 1) := by
        rw [Fin.sum_univ_castSucc]
      have ha₀F : ∀ i, a₀ i ∉ F' := by
        intro i
        have hpair := hpairs i.castSucc last (Fin.castSucc_ne_last i)
        simp [a₀, F', hpair.1, hpair.2.1, haF i.castSucc]
      have hb₀F : ∀ i, b₀ i ∉ F' := by
        intro i
        have hpair := hpairs i.castSucc last (Fin.castSucc_ne_last i)
        simp [b₀, F', hpair.2.2.1, hpair.2.2.2, hbF i.castSucc]
      have hU₀ : ∀ i,
          F'.card + (∑ j : Fin q, (2 * (r₀ j + 1) + 1)) +
            (r₀ i + 2) ≤ (U (hub₀ i)).card := by
        intro i
        have hi := hU i.castSucc
        rw [hsum] at hi
        dsimp [r₀, hub₀] at hi ⊢
        omega
      have hθ₀ :
          F'.card + (∑ j : Fin q, (2 * (r₀ j + 1) + 1)) ≤ θ := by
        rw [hsum] at hθ
        dsimp [r₀] at hθ ⊢
        omega
      obtain ⟨p, hp, hplen, hpavoid, hploc, hpdisj⟩ :=
        ih r₀ hub₀ U T hrob a₀ b₀ F'
          (fun i => ha i.castSucc) (fun i => hb i.castSucc)
          ha₀F hb₀F (fun i => hab i.castSucc)
          (fun i j hij => hpairs i.castSucc j.castSucc (by
            intro h
            exact hij (Fin.castSucc_injective _ h)))
          hU₀ hθ₀
      let used : Finset V :=
        F ∪ (Finset.univ : Finset (Fin q)).biUnion
          (fun i => (p i).support.toFinset)
      have hsuppCard : ∀ i : Fin q,
          (p i).support.toFinset.card = 2 * (r₀ i + 1) + 1 := by
        intro i
        rw [List.toFinset_card_of_nodup (hp i).support_nodup,
          (p i).length_support, hplen i]
      have hUnionCard :
          ((Finset.univ : Finset (Fin q)).biUnion
            (fun i => (p i).support.toFinset)).card ≤
              ∑ i : Fin q, (2 * (r₀ i + 1) + 1) := by
        have hraw :
            ((Finset.univ : Finset (Fin q)).biUnion
              (fun i => (p i).support.toFinset)).card ≤
                ∑ i : Fin q, (p i).support.toFinset.card := by
          simpa using (Finset.card_biUnion_le
            (s := (Finset.univ : Finset (Fin q)))
            (t := fun i => (p i).support.toFinset))
        calc
          ((Finset.univ : Finset (Fin q)).biUnion
              (fun i => (p i).support.toFinset)).card ≤
              ∑ i : Fin q, (p i).support.toFinset.card := hraw
          _ = ∑ i : Fin q, (2 * (r₀ i + 1) + 1) := by
            apply Finset.sum_congr rfl
            intro i _hi
            exact hsuppCard i
      have husedCard :
          used.card ≤ F.card + ∑ i : Fin q, (2 * (r₀ i + 1) + 1) := by
        have hu := Finset.card_union_le F
          ((Finset.univ : Finset (Fin q)).biUnion
            (fun i => (p i).support.toFinset))
        change used.card ≤ F.card + ∑ i : Fin q, (2 * (r₀ i + 1) + 1)
        dsimp [used]
        omega
      have haLastUsed : a last ∉ used := by
        intro hmem
        rcases Finset.mem_union.mp hmem with hmem | hmem
        · exact haF last hmem
        · rcases Finset.mem_biUnion.mp hmem with ⟨i, _hi, hmem⟩
          have hav := hpavoid i (a last) (by simpa using hmem)
          exact hav (by simp [F'])
      have hbLastUsed : b last ∉ used := by
        intro hmem
        rcases Finset.mem_union.mp hmem with hmem | hmem
        · exact hbF last hmem
        · rcases Finset.mem_biUnion.mp hmem with ⟨i, _hi, hmem⟩
          have hav := hpavoid i (b last) (by simpa using hmem)
          exact hav (by simp [F'])
      have hLastCard : r last + 2 ≤ (U (hub last) \ used).card := by
        have hUl := hU last
        rw [hsum] at hUl
        have hbase : r last + 2 ≤ (U (hub last)).card - used.card := by
          omega
        have hret : (U (hub last)).card - used.card ≤
            (U (hub last) \ used).card :=
          sub_le_card_sdiff_of_le_card_of_card_le le_rfl le_rfl
        exact hbase.trans hret
      have hLastBudget :
          used.card + 2 * (r last + 1) + 1 ≤ θ := by
        rw [hsum] at hθ
        omega
      obtain ⟨plast, hplast, hplastlen, hplastavoid, hplastloc⟩ :=
        exists_even_path_between_of_robustPairSet_avoiding G (hrob (hub last))
          (ha last) (hb last) haLastUsed hbLastUsed (hab last)
          hLastCard hLastBudget
      let p' : ∀ i : Fin (q + 1), G.Walk (a i) (b i) :=
        Fin.lastCases plast p
      refine ⟨p', ?_, ?_, ?_, ?_, ?_⟩
      · intro i
        induction i using Fin.lastCases with
        | last => simpa [p'] using hplast
        | cast i => simpa [p', a₀, b₀] using hp i
      · intro i
        induction i using Fin.lastCases with
        | last => simpa [p', last] using hplastlen
        | cast i => simpa [p', r₀] using hplen i
      · intro i v hv
        induction i using Fin.lastCases with
        | last =>
            exact fun hvF => hplastavoid v (by simpa [p'] using hv)
              (Finset.mem_union_left _ hvF)
        | cast i =>
            have hold := hpavoid i v (by simpa [p'] using hv)
            intro hvF
            apply hold
            exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hvF)
      · intro i v hv
        induction i using Fin.lastCases with
        | last => simpa [p'] using hplastloc v (by simpa [p'] using hv)
        | cast i => simpa [p', hub₀] using hploc i v (by simpa [p'] using hv)
      · intro i j hij
        induction i using Fin.lastCases with
        | last =>
            induction j using Fin.lastCases with
            | last => exact (hij rfl).elim
            | cast j =>
                intro v hvlast hvj
                apply hplastavoid v (by simpa [p'] using hvlast)
                apply Finset.mem_union_right
                apply Finset.mem_biUnion.mpr
                exact ⟨j, Finset.mem_univ _, by simpa [p'] using hvj⟩
        | cast i =>
            induction j using Fin.lastCases with
            | last =>
                intro v hvi hvlast
                apply hplastavoid v (by simpa [p'] using hvlast)
                apply Finset.mem_union_right
                apply Finset.mem_biUnion.mpr
                exact ⟨i, Finset.mem_univ _, by simpa [p'] using hvi⟩
            | cast j =>
                have hij' : i ≠ j := by
                  intro h
                  exact hij (congrArg Fin.castSucc h)
                simpa [p'] using hpdisj i j hij'

/-- Fintype-indexed wrapper for the greedy family of exact even robust
routes.  This form is convenient when requests are grouped by their hub,
since each fiber of the hub map is naturally a finite subtype rather than a
syntactic `Fin q`. -/
theorem exists_pairwise_disjoint_even_paths_fintype_robust
    {V ι J : Type*} [Fintype V] [Fintype J]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {s θ : ℕ} (hub : J → ι) (U T : ι → Finset V)
    (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
    (a b : J → V) (F : Finset V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (haF : ∀ i, a i ∉ F) (hbF : ∀ i, b i ∉ F)
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hU : ∀ i,
      F.card + Fintype.card J * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hub i)).card)
    (hθ : F.card + Fintype.card J * (2 * (s + 1) + 1) ≤ θ) :
    ∃ p : ∀ i : J, G.Walk (a i) (b i),
      (∀ i, (p i).IsPath) ∧
      (∀ i, (p i).length = 2 * (s + 1)) ∧
      (∀ i, ∀ v ∈ (p i).support, v ∉ F) ∧
      (∀ i, ∀ v ∈ (p i).support,
        v ∈ U (hub i) ∨ v ∈ T (hub i)) ∧
      ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  classical
  let e : Fin (Fintype.card J) ≃ J := (Fintype.equivFin J).symm
  let hub' : Fin (Fintype.card J) → ι := fun i => hub (e i)
  let a' : Fin (Fintype.card J) → V := fun i => a (e i)
  let b' : Fin (Fintype.card J) → V := fun i => b (e i)
  obtain ⟨q, hq, hqlen, hqavoid, hqloc, hqdisj⟩ :=
    exists_pairwise_disjoint_even_paths_varying_robust G hub' U T hrob
      a' b' F (fun i => ha (e i)) (fun i => hb (e i))
      (fun i => haF (e i)) (fun i => hbF (e i))
      (fun i => hab (e i))
      (fun i j hij => hpairs (e i) (e j) (fun h => hij (e.injective h)))
      (fun i => hU (e i)) hθ
  let p : ∀ i : J, G.Walk (a i) (b i) := fun i =>
    (q (e.symm i)).copy (by simp [a', e]) (by simp [b', e])
  refine ⟨p, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    simpa [p] using hq (e.symm i)
  · intro i
    simpa [p] using hqlen (e.symm i)
  · intro i v hv
    apply hqavoid (e.symm i) v
    simpa [p] using hv
  · intro i v hv
    have hloc := hqloc (e.symm i) v (by simpa [p] using hv)
    simpa [hub', e] using hloc
  · intro i j hij
    have hij' : e.symm i ≠ e.symm j := by
      intro h
      apply hij
      exact e.symm.injective h
    simpa [p] using hqdisj (e.symm i) (e.symm j) hij'

/-- Fintype-indexed wrapper for individually prescribed even robust routes.
The total capacity is invariant under the chosen equivalence with a finite
ordinal. -/
theorem exists_pairwise_disjoint_even_paths_lengths_fintype_robust
    {V ι J : Type*} [Fintype V] [Fintype J]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ : ℕ} (r : J → ℕ) (hub : J → ι) (U T : ι → Finset V)
    (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
    (a b : J → V) (F : Finset V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (haF : ∀ i, a i ∉ F) (hbF : ∀ i, b i ∉ F)
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hU : ∀ i,
      F.card + (∑ j : J, (2 * (r j + 1) + 1)) + (r i + 2) ≤
        (U (hub i)).card)
    (hθ : F.card + (∑ j : J, (2 * (r j + 1) + 1)) ≤ θ) :
    ∃ p : ∀ i : J, G.Walk (a i) (b i),
      (∀ i, (p i).IsPath) ∧
      (∀ i, (p i).length = 2 * (r i + 1)) ∧
      (∀ i, ∀ v ∈ (p i).support, v ∉ F) ∧
      (∀ i, ∀ v ∈ (p i).support,
        v ∈ U (hub i) ∨ v ∈ T (hub i)) ∧
      ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  classical
  let e : Fin (Fintype.card J) ≃ J := (Fintype.equivFin J).symm
  let r' : Fin (Fintype.card J) → ℕ := fun i => r (e i)
  let hub' : Fin (Fintype.card J) → ι := fun i => hub (e i)
  let a' : Fin (Fintype.card J) → V := fun i => a (e i)
  let b' : Fin (Fintype.card J) → V := fun i => b (e i)
  have hsum : (∑ i : Fin (Fintype.card J),
      (2 * (r' i + 1) + 1)) = ∑ j : J, (2 * (r j + 1) + 1) := by
    exact e.sum_comp (fun j : J => 2 * (r j + 1) + 1)
  obtain ⟨q, hq, hqlen, hqavoid, hqloc, hqdisj⟩ :=
    exists_pairwise_disjoint_even_paths_lengths_robust G r' hub' U T hrob
      a' b' F (fun i => ha (e i)) (fun i => hb (e i))
      (fun i => haF (e i)) (fun i => hbF (e i))
      (fun i => hab (e i))
      (fun i j hij => hpairs (e i) (e j) (fun h => hij (e.injective h)))
      (fun i => by
        rw [hsum]
        exact hU (e i))
      (by rw [hsum]; exact hθ)
  let p : ∀ i : J, G.Walk (a i) (b i) := fun i =>
    (q (e.symm i)).copy (by simp [a', e]) (by simp [b', e])
  refine ⟨p, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    simpa [p] using hq (e.symm i)
  · intro i
    simpa [p, r'] using hqlen (e.symm i)
  · intro i v hv
    apply hqavoid (e.symm i) v
    simpa [p] using hv
  · intro i v hv
    have hloc := hqloc (e.symm i) v (by simpa [p] using hv)
    simpa [hub', e] using hloc
  · intro i j hij
    have hij' : e.symm i ≠ e.symm j := by
      intro h
      apply hij
      exact e.symm.injective h
    simpa [p] using hqdisj (e.symm i) (e.symm j) hij'

/-- Route requests independently inside each robust hub.  The required
capacity is charged only by the number of requests in the same fiber of
`hub`; disjoint routing regions make paths belonging to different hubs
automatically disjoint.  This is the resource accounting needed for a
doubled-tree traversal with repeated auxiliary vertices. -/
theorem exists_pairwise_disjoint_even_paths_grouped_robust
    {V ι J : Type*} [Fintype V] [Fintype ι] [Fintype J]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {s θ : ℕ} (hub : J → ι) (U T : ι → Finset V)
    (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : J → V) (F : ι → Finset V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (haF : ∀ i, a i ∉ F (hub i)) (hbF : ∀ i, b i ∉ F (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hU : ∀ i : ι,
      (F i).card + Fintype.card {j : J // hub j = i} *
        (2 * (s + 1) + 1) + (s + 2) ≤ (U i).card)
    (hθ : ∀ i : ι,
      (F i).card + Fintype.card {j : J // hub j = i} *
        (2 * (s + 1) + 1) ≤ θ) :
    ∃ p : ∀ i : J, G.Walk (a i) (b i),
      (∀ i, (p i).IsPath) ∧
      (∀ i, (p i).length = 2 * (s + 1)) ∧
      (∀ i, ∀ v ∈ (p i).support, v ∉ F (hub i)) ∧
      (∀ i, ∀ v ∈ (p i).support,
        v ∈ U (hub i) ∨ v ∈ T (hub i)) ∧
      ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  classical
  have hex : ∀ i : ι,
      ∃ p : ∀ x : {j : J // hub j = i}, G.Walk (a x.1) (b x.1),
        (∀ x, (p x).IsPath) ∧
        (∀ x, (p x).length = 2 * (s + 1)) ∧
        (∀ x, ∀ v ∈ (p x).support, v ∉ F i) ∧
        (∀ x, ∀ v ∈ (p x).support, v ∈ U i ∨ v ∈ T i) ∧
        ∀ x y, x ≠ y → (p x).support.Disjoint (p y).support := by
    intro i
    apply exists_pairwise_disjoint_even_paths_fintype_robust
      G (fun _ : {j : J // hub j = i} => i) U T hrob
        (fun x => a x.1) (fun x => b x.1) (F i)
    · intro x
      simpa [x.property] using ha x.1
    · intro x
      simpa [x.property] using hb x.1
    · intro x
      simpa [x.property] using haF x.1
    · intro x
      simpa [x.property] using hbF x.1
    · exact fun x => hab x.1
    · intro x y hxy
      apply hpairs x.1 y.1
      intro h
      exact hxy (Subtype.ext h)
    · intro x
      simpa using hU i
    · simpa using hθ i
  let route := fun i : ι => Classical.choose (hex i)
  have hlocal := fun i : ι => Classical.choose_spec (hex i)
  let p : ∀ j : J, G.Walk (a j) (b j) := fun j =>
    route (hub j) ⟨j, rfl⟩
  refine ⟨p, ?_, ?_, ?_, ?_, ?_⟩
  · intro j
    exact (hlocal (hub j)).1 ⟨j, rfl⟩
  · intro j
    exact (hlocal (hub j)).2.1 ⟨j, rfl⟩
  · intro j v hv
    exact (hlocal (hub j)).2.2.1 ⟨j, rfl⟩ v (by simpa [p] using hv)
  · intro j v hv
    exact (hlocal (hub j)).2.2.2.1 ⟨j, rfl⟩ v (by simpa [p] using hv)
  · intro i j hij
    by_cases hh : hub i = hub j
    · have hsub : (⟨i, rfl⟩ : {x : J // hub x = hub i}) ≠
          ⟨j, hh.symm⟩ := by
        intro h
        apply hij
        exact congrArg Subtype.val h
      have hd := (hlocal (hub i)).2.2.2.2 ⟨i, rfl⟩ ⟨j, hh.symm⟩ hsub
      have harg :
          HEq (⟨j, hh.symm⟩ : {x : J // hub x = hub i})
            (⟨j, rfl⟩ : {x : J // hub x = hub j}) := by
        exact Mathlib.Tactic.DepRewrite.hdcongrArg hh
          (fun c hc =>
            (⟨j, hh.symm.trans hc⟩ : {x : J // hub x = c}))
      let supp : ∀ c : ι, {x : J // hub x = c} → List V :=
        fun c x => (route c x).support
      have hfun : supp (hub i) ≍ supp (hub j) :=
        congr_arg_heq supp hh
      have hsupp : supp (hub i) ⟨j, hh.symm⟩ =
          supp (hub j) ⟨j, rfl⟩ := congr_heq hfun harg
      dsimp [p]
      change (supp (hub i) ⟨i, rfl⟩).Disjoint
        (supp (hub j) ⟨j, rfl⟩)
      rw [← hsupp]
      exact hd
    · intro v hvi hvj
      have hli := (hlocal (hub i)).2.2.2.1 ⟨i, rfl⟩ v
        (by simpa [p] using hvi)
      have hlj := (hlocal (hub j)).2.2.2.1 ⟨j, rfl⟩ v
        (by simpa [p] using hvj)
      apply (Finset.disjoint_left.mp (hregions (hub i) (hub j) hh))
      · exact Finset.mem_union.mpr hli
      · exact Finset.mem_union.mpr hlj

/-- Per-hub form of the variable-length greedy routing theorem.  Every fiber
is routed with its own exact support sum, and disjoint hub regions supply the
cross-fiber disjointness. -/
theorem exists_pairwise_disjoint_even_paths_lengths_grouped_robust
    {V ι J : Type*} [Fintype V] [Fintype ι] [Fintype J]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ : ℕ} (r : J → ℕ) (hub : J → ι) (U T : ι → Finset V)
    (hrob : ∀ i : ι, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : J → V) (F : ι → Finset V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (haF : ∀ i, a i ∉ F (hub i)) (hbF : ∀ i, b i ∉ F (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hU : ∀ i : ι, ∀ x : {j : J // hub j = i},
      (F i).card +
        (∑ y : {j : J // hub j = i}, (2 * (r y.1 + 1) + 1)) +
          (r x.1 + 2) ≤ (U i).card)
    (hθ : ∀ i : ι,
      (F i).card +
        (∑ y : {j : J // hub j = i}, (2 * (r y.1 + 1) + 1)) ≤ θ) :
    ∃ p : ∀ i : J, G.Walk (a i) (b i),
      (∀ i, (p i).IsPath) ∧
      (∀ i, (p i).length = 2 * (r i + 1)) ∧
      (∀ i, ∀ v ∈ (p i).support, v ∉ F (hub i)) ∧
      (∀ i, ∀ v ∈ (p i).support,
        v ∈ U (hub i) ∨ v ∈ T (hub i)) ∧
      ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support := by
  classical
  have hex : ∀ i : ι,
      ∃ p : ∀ x : {j : J // hub j = i}, G.Walk (a x.1) (b x.1),
        (∀ x, (p x).IsPath) ∧
        (∀ x, (p x).length = 2 * (r x.1 + 1)) ∧
        (∀ x, ∀ v ∈ (p x).support, v ∉ F i) ∧
        (∀ x, ∀ v ∈ (p x).support, v ∈ U i ∨ v ∈ T i) ∧
        ∀ x y, x ≠ y → (p x).support.Disjoint (p y).support := by
    intro i
    apply exists_pairwise_disjoint_even_paths_lengths_fintype_robust
      G (fun x : {j : J // hub j = i} => r x.1)
        (fun _ : {j : J // hub j = i} => i) U T hrob
        (fun x => a x.1) (fun x => b x.1) (F i)
    · intro x
      simpa [x.property] using ha x.1
    · intro x
      simpa [x.property] using hb x.1
    · intro x
      simpa [x.property] using haF x.1
    · intro x
      simpa [x.property] using hbF x.1
    · exact fun x => hab x.1
    · intro x y hxy
      apply hpairs x.1 y.1
      intro h
      exact hxy (Subtype.ext h)
    · exact hU i
    · exact hθ i
  let route := fun i : ι => Classical.choose (hex i)
  have hlocal := fun i : ι => Classical.choose_spec (hex i)
  let p : ∀ j : J, G.Walk (a j) (b j) := fun j =>
    route (hub j) ⟨j, rfl⟩
  refine ⟨p, ?_, ?_, ?_, ?_, ?_⟩
  · intro j
    exact (hlocal (hub j)).1 ⟨j, rfl⟩
  · intro j
    exact (hlocal (hub j)).2.1 ⟨j, rfl⟩
  · intro j v hv
    exact (hlocal (hub j)).2.2.1 ⟨j, rfl⟩ v (by simpa [p] using hv)
  · intro j v hv
    exact (hlocal (hub j)).2.2.2.1 ⟨j, rfl⟩ v (by simpa [p] using hv)
  · intro i j hij
    by_cases hh : hub i = hub j
    · have hsub : (⟨i, rfl⟩ : {x : J // hub x = hub i}) ≠
          ⟨j, hh.symm⟩ := by
        intro h
        apply hij
        exact congrArg Subtype.val h
      have hd := (hlocal (hub i)).2.2.2.2 ⟨i, rfl⟩ ⟨j, hh.symm⟩ hsub
      have harg :
          HEq (⟨j, hh.symm⟩ : {x : J // hub x = hub i})
            (⟨j, rfl⟩ : {x : J // hub x = hub j}) := by
        exact Mathlib.Tactic.DepRewrite.hdcongrArg hh
          (fun c hc =>
            (⟨j, hh.symm.trans hc⟩ : {x : J // hub x = c}))
      let supp : ∀ c : ι, {x : J // hub x = c} → List V :=
        fun c x => (route c x).support
      have hfun : supp (hub i) ≍ supp (hub j) :=
        congr_arg_heq supp hh
      have hsupp : supp (hub i) ⟨j, hh.symm⟩ =
          supp (hub j) ⟨j, rfl⟩ := congr_heq hfun harg
      dsimp [p]
      change (supp (hub i) ⟨i, rfl⟩).Disjoint
        (supp (hub j) ⟨j, rfl⟩)
      rw [← hsupp]
      exact hd
    · intro v hvi hvj
      have hli := (hlocal (hub i)).2.2.2.1 ⟨i, rfl⟩ v
        (by simpa [p] using hvi)
      have hlj := (hlocal (hub j)).2.2.2.1 ⟨j, rfl⟩ v
        (by simpa [p] using hvj)
      apply (Finset.disjoint_left.mp (hregions (hub i) (hub j) hh))
      · exact Finset.mem_union.mpr hli
      · exact Finset.mem_union.mpr hlj

/-- An internal edge of the reservoir changes parity.  Two even routes are
chosen successively, with the second avoiding the full support of the first;
after splicing the internal edge between them, the result is a simple odd
path of every length in the displayed arithmetic family. -/
theorem exists_odd_path_between_of_robustPairSet_and_edge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ r s : ℕ} (hrob : RobustPairSet G U T θ)
    {a x y b : V} (haU : a ∈ U) (hxU : x ∈ U) (hyU : y ∈ U) (hbU : b ∈ U)
    (hxy : G.Adj x y) (hax : a ≠ x) (hay : a ≠ y) (hab : a ≠ b)
    (hxb : x ≠ b) (hyb : y ≠ b)
    (hUcard : 2 * r + s + 5 ≤ U.card)
    (hbudget : 2 * r + 2 * s + 6 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = 2 * r + 2 * s + 5 ∧
      ∀ v ∈ p.support, v ∈ U ∨ v ∈ T := by
  classical
  let F₀ : Finset V := {b, y}
  have haF₀ : a ∉ F₀ := by simp [F₀, hab, hay]
  have hxF₀ : x ∉ F₀ := by simp [F₀, hxb, hxy.ne]
  have hF₀card : F₀.card ≤ 2 := Finset.card_le_two
  have hleftCard : r + 2 ≤ (U \ F₀).card := by
    rw [Finset.card_sdiff]
    have hinter : (F₀ ∩ U).card ≤ F₀.card :=
      Finset.card_le_card Finset.inter_subset_left
    omega
  have hleftBudget : F₀.card + 2 * (r + 1) + 1 ≤ θ := by
    omega
  obtain ⟨p, hp, hplen, hpavoid, hploc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G hrob haU hxU haF₀ hxF₀
      hax hleftCard hleftBudget
  have hyNotP : y ∉ p.support := by
    intro hy
    exact hpavoid y hy (by simp [F₀])
  have hbNotP : b ∉ p.support := by
    intro hb
    exact hpavoid b hb (by simp [F₀])
  let F₁ : Finset V := p.support.toFinset
  have hF₁card : F₁.card = 2 * (r + 1) + 1 := by
    dsimp [F₁]
    rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support, hplen]
  have hyF₁ : y ∉ F₁ := by simpa [F₁] using hyNotP
  have hbF₁ : b ∉ F₁ := by simpa [F₁] using hbNotP
  have hrightCard : s + 2 ≤ (U \ F₁).card := by
    rw [Finset.card_sdiff]
    have hinter : (F₁ ∩ U).card ≤ F₁.card :=
      Finset.card_le_card Finset.inter_subset_left
    rw [hF₁card] at hinter
    omega
  have hrightBudget : F₁.card + 2 * (s + 1) + 1 ≤ θ := by
    rw [hF₁card]
    omega
  obtain ⟨q, hq, hqlen, hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G hrob hyU hbU hyF₁ hbF₁
      hyb hrightCard hrightBudget
  let px : G.Walk a y := p.concat hxy
  have hpx : px.IsPath := hp.concat hyNotP hxy
  have hdisj : px.support.Disjoint q.support.tail := by
    intro v hvpx hvq
    have hvq' : v ∈ q.support := List.mem_of_mem_tail hvq
    dsimp [px] at hvpx
    rw [SimpleGraph.Walk.support_concat] at hvpx
    simp only [List.mem_append, List.mem_singleton] at hvpx
    rcases hvpx with hvp | rfl
    · exact hqavoid v hvq' (by simpa [F₁] using hvp)
    · have hn := hq.support_nodup
      rw [← q.cons_tail_support] at hn
      exact hn.notMem hvq
  let w : G.Walk a b := px.append q
  have hw : w.IsPath := by
    dsimp [w]
    rw [Walk.isPath_def, Walk.support_append, List.nodup_append']
    exact ⟨hpx.support_nodup, hq.support_nodup.tail, hdisj⟩
  refine ⟨w, hw, ?_, ?_⟩
  · dsimp [w, px]
    rw [SimpleGraph.Walk.length_append, SimpleGraph.Walk.length_concat, hplen, hqlen]
    omega
  · intro v hv
    dsimp [w, px] at hv
    rw [Walk.support_append, SimpleGraph.Walk.support_concat] at hv
    simp only [List.mem_append, List.mem_singleton] at hv
    rcases hv with (hvp | rfl) | hvq
    · exact hploc v hvp
    · exact Or.inl hyU
    · exact hqloc v (List.mem_of_mem_tail hvq)

/-- A finite family of ordered adjacent pairs whose distinct members have no
endpoint in common.  This lightweight matching interface avoids importing
extra matching machinery while retaining exactly the disjointness used by
the KLS parity-broken-hub argument. -/
def DisjointAdjPairFamily {V : Type*} (G : SimpleGraph V)
    (M : Finset (V × V)) : Prop :=
  (∀ e ∈ M, G.Adj e.1 e.2) ∧
  ∀ e ∈ M, ∀ f ∈ M, e ≠ f →
    e.1 ≠ f.1 ∧ e.1 ≠ f.2 ∧ e.2 ≠ f.1 ∧ e.2 ≠ f.2

/-- If fewer vertices are forbidden than the minimum degree, some edge
avoids all of them.  Choose a vertex outside the forbidden set; its
neighbour set is larger than that set, so one neighbour also lies outside. -/
theorem exists_adj_avoiding_finset_of_card_lt_minDegree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (F : Finset V)
    (hF : F.card < G.minDegree) :
    ∃ a ∉ F, ∃ b ∉ F, G.Adj a b := by
  classical
  have hFcard : F.card < Fintype.card V :=
    hF.trans G.minDegree_lt_card
  have haex : ∃ a : V, a ∉ F := by
    by_contra hno
    push_neg at hno
    have hsub : (Finset.univ : Finset V) ⊆ F := by
      intro a _ha
      exact hno a
    have hcard := Finset.card_le_card hsub
    simpa using (not_lt_of_ge hcard hFcard)
  obtain ⟨a, haF⟩ := haex
  have hdeg : G.minDegree ≤ G.degree a := G.minDegree_le_degree a
  have hbex : ∃ b ∈ G.neighborFinset a, b ∉ F := by
    by_contra hno
    push_neg at hno
    have hsub : G.neighborFinset a ⊆ F := by
      intro b hb
      exact hno b hb
    have hcard := Finset.card_le_card hsub
    have hdegreeCard : G.degree a ≤ F.card := by simpa using hcard
    omega
  obtain ⟨b, hbN, hbF⟩ := hbex
  exact ⟨a, haF, b, hbF, by simpa using hbN⟩

/-- Minimum degree at least five supplies three vertex-disjoint internal
edges.  Greedily choose an edge, then an edge avoiding its two endpoints,
then an edge avoiding all four already used endpoints. -/
theorem exists_three_disjointAdjPairFamily_of_five_le_minDegree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (hδ : 5 ≤ G.minDegree) :
    ∃ M : Finset (V × V), DisjointAdjPairFamily G M ∧ 2 < M.card := by
  classical
  have hEmpty : (∅ : Finset V).card < G.minDegree := by
    simp only [Finset.card_empty]
    omega
  obtain ⟨a₀, ha₀, b₀, hb₀, hab₀⟩ :=
    exists_adj_avoiding_finset_of_card_lt_minDegree G ∅ hEmpty
  let F₁ : Finset V := {a₀, b₀}
  have hF₁ : F₁.card < G.minDegree := by
    have hcard : F₁.card ≤ 2 := Finset.card_le_two
    omega
  obtain ⟨a₁, ha₁, b₁, hb₁, hab₁⟩ :=
    exists_adj_avoiding_finset_of_card_lt_minDegree G F₁ hF₁
  let F₂ : Finset V := {a₀, b₀, a₁, b₁}
  have hF₂ : F₂.card < G.minDegree := by
    have hcard : F₂.card ≤ 4 := by
      dsimp [F₂]
      apply Finset.card_le_four
    omega
  obtain ⟨a₂, ha₂, b₂, hb₂, hab₂⟩ :=
    exists_adj_avoiding_finset_of_card_lt_minDegree G F₂ hF₂
  dsimp [F₁] at ha₁ hb₁
  dsimp [F₂] at ha₂ hb₂
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at ha₁ hb₁ ha₂ hb₂
  have ha₀b₀ : a₀ ≠ b₀ := hab₀.ne
  have ha₀a₁ : a₀ ≠ a₁ := Ne.symm ha₁.1
  have ha₀b₁ : a₀ ≠ b₁ := Ne.symm hb₁.1
  have hb₀a₁ : b₀ ≠ a₁ := Ne.symm ha₁.2
  have hb₀b₁ : b₀ ≠ b₁ := Ne.symm hb₁.2
  have ha₀a₂ : a₀ ≠ a₂ := Ne.symm ha₂.1
  have ha₀b₂ : a₀ ≠ b₂ := Ne.symm hb₂.1
  have hb₀a₂ : b₀ ≠ a₂ := Ne.symm ha₂.2.1
  have hb₀b₂ : b₀ ≠ b₂ := Ne.symm hb₂.2.1
  have ha₁a₂ : a₁ ≠ a₂ := Ne.symm ha₂.2.2.1
  have ha₁b₂ : a₁ ≠ b₂ := Ne.symm hb₂.2.2.1
  have hb₁a₂ : b₁ ≠ a₂ := Ne.symm ha₂.2.2.2
  have hb₁b₂ : b₁ ≠ b₂ := Ne.symm hb₂.2.2.2
  let p₀ : V × V := (a₀, b₀)
  let p₁ : V × V := (a₁, b₁)
  let p₂ : V × V := (a₂, b₂)
  have hp₀₁ : p₀ ≠ p₁ := by
    intro h
    exact ha₁.1 (congrArg Prod.fst h).symm
  have hp₀₂ : p₀ ≠ p₂ := by
    intro h
    exact ha₂.1 (congrArg Prod.fst h).symm
  have hp₁₂ : p₁ ≠ p₂ := by
    intro h
    exact ha₂.2.2.1 (congrArg Prod.fst h).symm
  let M : Finset (V × V) := {p₀, p₁, p₂}
  refine ⟨M, ?_, ?_⟩
  · constructor
    · intro e he
      simp only [M, Finset.mem_insert, Finset.mem_singleton] at he
      rcases he with rfl | rfl | rfl
      · exact hab₀
      · exact hab₁
      · exact hab₂
    · intro e he f hf hef
      simp only [M, Finset.mem_insert, Finset.mem_singleton] at he hf
      rcases he with rfl | rfl | rfl <;>
        rcases hf with rfl | rfl | rfl
      all_goals simp_all [p₀, p₁, p₂, ha₀b₀, ha₀a₁, ha₀b₁, hb₀a₁,
        hb₀b₁, ha₀a₂, ha₀b₂, hb₀a₂, hb₀b₂, ha₁a₂, ha₁b₂, hb₁a₂, hb₁b₂]
  · have hp₁₀ : p₁ ≠ p₀ := hp₀₁.symm
    have hp₂₀ : p₂ ≠ p₀ := hp₀₂.symm
    have hp₂₁ : p₂ ≠ p₁ := hp₁₂.symm
    simp [M, hp₀₁, hp₀₂, hp₁₂, hp₁₀, hp₂₀, hp₂₁]

/-- A finite set carries three pairwise vertex-disjoint internal edges. -/
def HasThreeDisjointAdjPairFamily {V : Type*} (G : SimpleGraph V)
    (S : Finset V) : Prop :=
  ∃ M : Finset (V × V), DisjointAdjPairFamily G M ∧ 2 < M.card ∧
    ∀ e ∈ M, e.1 ∈ S ∧ e.2 ∈ S

/-- A scalable internal matching predicate.  This is the parity-broken-hub
condition at an arbitrary matching scale; the three-edge predicate above is
its small fixed specialization used by the compact path ladders. -/
def HasInternalMatchingAtLeast {V : Type*} (G : SimpleGraph V)
    (S : Finset V) (m : ℕ) : Prop :=
  ∃ M : Finset (V × V), DisjointAdjPairFamily G M ∧ m ≤ M.card ∧
    ∀ e ∈ M, e.1 ∈ S ∧ e.2 ∈ S

/-- Enlarging the allowed core preserves a three-edge matching witness. -/
theorem HasThreeDisjointAdjPairFamily.mono
    {V : Type*} {G : SimpleGraph V} {S T : Finset V}
    (hS : HasThreeDisjointAdjPairFamily G S) (hST : S ⊆ T) :
    HasThreeDisjointAdjPairFamily G T := by
  obtain ⟨M, hM, hMcard, hMS⟩ := hS
  refine ⟨M, hM, hMcard, ?_⟩
  intro e he
  have h := hMS e he
  exact ⟨hST h.1, hST h.2⟩

/-- Any subset of a parity-unbroken core remains parity-unbroken. -/
theorem not_hasThreeDisjointAdjPairFamily_of_subset
    {V : Type*} {G : SimpleGraph V} {S T : Finset V}
    (hST : S ⊆ T) (hnot : ¬ HasThreeDisjointAdjPairFamily G T) :
    ¬ HasThreeDisjointAdjPairFamily G S := by
  intro hS
  exact hnot (hS.mono hST)

/-- Three disjoint internal edges survive an injective graph homomorphism.
The image pair family has the same cardinality, adjacency is preserved by
the homomorphism, and endpoint disjointness is preserved by injectivity. -/
theorem HasThreeDisjointAdjPairFamily.map_injective_hom
    {V W : Type*} [Fintype V] [Fintype W]
    {G : SimpleGraph V} {H : SimpleGraph W}
    (e : G →g H) (he : Function.Injective e)
    {S : Finset V} (hS : HasThreeDisjointAdjPairFamily G S) :
    HasThreeDisjointAdjPairFamily H (S.map ⟨e, he⟩) := by
  classical
  obtain ⟨M, hM, hMcard, hMS⟩ := hS
  let f : (V × V) ↪ (W × W) :=
    { toFun := fun p => (e p.1, e p.2)
      inj' := by
        intro p q hpq
        apply Prod.ext
        · exact he (congrArg Prod.fst hpq)
        · exact he (congrArg Prod.snd hpq) }
  let M' : Finset (W × W) := M.map f
  refine ⟨M', ?_, ?_, ?_⟩
  · constructor
    · intro p hp
      rcases Finset.mem_map.mp hp with ⟨q, hq, rfl⟩
      exact e.map_rel (hM.1 q hq)
    · intro p hp q hq hpq
      rcases Finset.mem_map.mp hp with ⟨p₀, hp₀, rfl⟩
      rcases Finset.mem_map.mp hq with ⟨q₀, hq₀, rfl⟩
      have hp₀q₀ : p₀ ≠ q₀ := by
        intro h
        subst q₀
        exact hpq rfl
      have hdis := hM.2 p₀ hp₀ q₀ hq₀ hp₀q₀
      exact ⟨fun h => hdis.1 (he h),
        fun h => hdis.2.1 (he h),
        fun h => hdis.2.2.1 (he h),
        fun h => hdis.2.2.2 (he h)⟩
  · simpa [M'] using hMcard
  · intro p hp
    rcases Finset.mem_map.mp hp with ⟨q, hq, rfl⟩
    have hqS := hMS q hq
    exact ⟨Finset.mem_map.mpr ⟨q.1, hqS.1, rfl⟩,
      Finset.mem_map.mpr ⟨q.2, hqS.2, rfl⟩⟩

/-- A minimum-degree-five induced core supplies the matching witness in the
ambient graph.  Build three disjoint edges in the induced graph, then map
them through the canonical induced embedding; its image vertex set is the
original finite core. -/
theorem hasThreeDisjointAdjPairFamily_of_induce_minDegree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (S : Finset V) (hS : S.Nonempty)
    (hδ : 5 ≤ (G.induce (S : Set V)).minDegree) :
    HasThreeDisjointAdjPairFamily G S := by
  classical
  let H : SimpleGraph S := G.induce (S : Set V)
  let : Nonempty S := hS.to_subtype
  obtain ⟨M, hM, hMcard⟩ :=
    exists_three_disjointAdjPairFamily_of_five_le_minDegree H
      (by simpa [H] using hδ)
  have hHS : HasThreeDisjointAdjPairFamily H (Finset.univ : Finset S) := by
    refine ⟨M, hM, hMcard, ?_⟩
    intro e _he
    simp
  let e : H ↪g G := SimpleGraph.Embedding.induce (G := G) (S : Set V)
  let f : S ↪ V := ⟨e, e.injective⟩
  have hmap := HasThreeDisjointAdjPairFamily.map_injective_hom
    e.toHom e.injective hHS
  change HasThreeDisjointAdjPairFamily G
    ((Finset.univ : Finset S).map f) at hmap
  have himage : (Finset.univ : Finset S).map f = S := by
    ext v
    constructor
    · intro hv
      rcases Finset.mem_map.mp hv with ⟨u, _hu, rfl⟩
      exact u.property
    · intro hv
      exact Finset.mem_map.mpr ⟨⟨v, hv⟩, Finset.mem_univ _, rfl⟩
  rw [himage] at hmap
  exact hmap

/-- An independent-set-free graph has three disjoint internal edges in any
finite set with four spare vertices beyond the forbidden independent-set
size.  Remove the endpoints of two greedily chosen edges; the remaining set
still has at least n vertices, so it contains the third edge. -/
theorem hasThreeDisjointAdjPairFamily_of_indepSetFree_of_add_four_le_card
    {V : Type*} [Fintype V] {G : SimpleGraph V} {S : Finset V} {n : ℕ}
    (hfree : G.IndepSetFree n) (hcard : n + 4 ≤ S.card) :
    HasThreeDisjointAdjPairFamily G S := by
  classical
  obtain ⟨a₀, ha₀, b₀, hb₀, hab₀⟩ :=
    exists_adj_in_finset_of_indepSetFree hfree (U := S) (by omega)
  let S₁ : Finset V := (S.erase a₀).erase b₀
  have hb₀erase : b₀ ∈ S.erase a₀ :=
    Finset.mem_erase.mpr ⟨hab₀.ne.symm, hb₀⟩
  have hS₁card : S₁.card = S.card - 2 := by
    simp [S₁, Finset.card_erase_of_mem ha₀,
      Finset.card_erase_of_mem hb₀erase]
    omega
  have hnS₁ : n + 2 ≤ S₁.card := by
    rw [hS₁card]
    omega
  obtain ⟨a₁, ha₁, b₁, hb₁, hab₁⟩ :=
    exists_adj_in_finset_of_indepSetFree hfree (U := S₁) (by omega)
  let S₂ : Finset V := (S₁.erase a₁).erase b₁
  have hb₁erase : b₁ ∈ S₁.erase a₁ :=
    Finset.mem_erase.mpr ⟨hab₁.ne.symm, hb₁⟩
  have hS₂card : S₂.card = S₁.card - 2 := by
    simp [S₂, Finset.card_erase_of_mem ha₁,
      Finset.card_erase_of_mem hb₁erase]
    omega
  have hnS₂ : n ≤ S₂.card := by
    rw [hS₂card]
    omega
  obtain ⟨a₂, ha₂, b₂, hb₂, hab₂⟩ :=
    exists_adj_in_finset_of_indepSetFree hfree (U := S₂) hnS₂
  have ha₁S : a₁ ∈ S :=
    (Finset.mem_erase.mp (Finset.mem_erase.mp ha₁).2).2
  have hb₁S : b₁ ∈ S :=
    (Finset.mem_erase.mp (Finset.mem_erase.mp hb₁).2).2
  have ha₂S₁ : a₂ ∈ S₁ :=
    (Finset.mem_erase.mp (Finset.mem_erase.mp ha₂).2).2
  have hb₂S₁ : b₂ ∈ S₁ :=
    (Finset.mem_erase.mp (Finset.mem_erase.mp hb₂).2).2
  have ha₂S : a₂ ∈ S :=
    (Finset.mem_erase.mp (Finset.mem_erase.mp ha₂S₁).2).2
  have hb₂S : b₂ ∈ S :=
    (Finset.mem_erase.mp (Finset.mem_erase.mp hb₂S₁).2).2
  have ha₁a₀ : a₁ ≠ a₀ := (Finset.mem_erase.mp
    (Finset.mem_erase.mp ha₁).2).1
  have ha₁b₀ : a₁ ≠ b₀ := (Finset.mem_erase.mp ha₁).1
  have hb₁a₀ : b₁ ≠ a₀ := (Finset.mem_erase.mp
    (Finset.mem_erase.mp hb₁).2).1
  have hb₁b₀ : b₁ ≠ b₀ := (Finset.mem_erase.mp hb₁).1
  have ha₂a₁ : a₂ ≠ a₁ := (Finset.mem_erase.mp
    (Finset.mem_erase.mp ha₂).2).1
  have ha₂b₁ : a₂ ≠ b₁ := (Finset.mem_erase.mp ha₂).1
  have hb₂a₁ : b₂ ≠ a₁ := (Finset.mem_erase.mp
    (Finset.mem_erase.mp hb₂).2).1
  have hb₂b₁ : b₂ ≠ b₁ := (Finset.mem_erase.mp hb₂).1
  have ha₁a₂ : a₁ ≠ a₂ := Ne.symm ha₂a₁
  have ha₁b₂ : a₁ ≠ b₂ := Ne.symm hb₂a₁
  have hb₁a₂ : b₁ ≠ a₂ := Ne.symm ha₂b₁
  have hb₁b₂ : b₁ ≠ b₂ := Ne.symm hb₂b₁
  have ha₀a₁ : a₀ ≠ a₁ := Ne.symm ha₁a₀
  have ha₀b₁ : a₀ ≠ b₁ := Ne.symm hb₁a₀
  have hb₀a₁ : b₀ ≠ a₁ := Ne.symm ha₁b₀
  have hb₀b₁ : b₀ ≠ b₁ := Ne.symm hb₁b₀
  have ha₂a₀ : a₂ ≠ a₀ := (Finset.mem_erase.mp
    (Finset.mem_erase.mp ha₂S₁).2).1
  have ha₂b₀ : a₂ ≠ b₀ := (Finset.mem_erase.mp ha₂S₁).1
  have hb₂a₀ : b₂ ≠ a₀ := (Finset.mem_erase.mp
    (Finset.mem_erase.mp hb₂S₁).2).1
  have hb₂b₀ : b₂ ≠ b₀ := (Finset.mem_erase.mp hb₂S₁).1
  have ha₀a₂ : a₀ ≠ a₂ := Ne.symm ha₂a₀
  have ha₀b₂ : a₀ ≠ b₂ := Ne.symm hb₂a₀
  have hb₀a₂ : b₀ ≠ a₂ := Ne.symm ha₂b₀
  have hb₀b₂ : b₀ ≠ b₂ := Ne.symm hb₂b₀
  let p₀ : V × V := (a₀, b₀)
  let p₁ : V × V := (a₁, b₁)
  let p₂ : V × V := (a₂, b₂)
  have hp₀₁ : p₀ ≠ p₁ := by
    intro h
    exact ha₁a₀ (congrArg Prod.fst h).symm
  have hp₀₂ : p₀ ≠ p₂ := by
    intro h
    exact ha₂a₀ (congrArg Prod.fst h).symm
  have hp₁₂ : p₁ ≠ p₂ := by
    intro h
    exact ha₂a₁ (congrArg Prod.fst h).symm
  let M : Finset (V × V) := {p₀, p₁, p₂}
  refine ⟨M, ?_, ?_, ?_⟩
  · constructor
    · intro e he
      simp only [M, Finset.mem_insert, Finset.mem_singleton] at he
      rcases he with rfl | rfl | rfl
      · exact hab₀
      · exact hab₁
      · exact hab₂
    · intro e he f hf hef
      simp only [M, Finset.mem_insert, Finset.mem_singleton] at he hf
      rcases he with rfl | rfl | rfl <;>
        rcases hf with rfl | rfl | rfl
      all_goals simp_all [p₀, p₁, p₂, hab₀.ne, hab₁.ne, hab₂.ne,
        ha₁a₀, ha₁b₀, hb₁a₀, hb₁b₀, ha₂a₀, ha₂b₀, hb₂a₀, hb₂b₀,
        ha₂a₁, ha₂b₁, hb₂a₁, hb₂b₁, ha₁a₂, ha₁b₂, hb₁a₂, hb₁b₂,
        ha₀a₁, ha₀b₁, hb₀a₁, hb₀b₁, ha₀a₂, ha₀b₂, hb₀a₂, hb₀b₂]
  · have hp₁₀ : p₁ ≠ p₀ := hp₀₁.symm
    have hp₂₀ : p₂ ≠ p₀ := hp₀₂.symm
    have hp₂₁ : p₂ ≠ p₁ := hp₁₂.symm
    simp [M, hp₀₁, hp₀₂, hp₁₂, hp₁₀, hp₂₀, hp₂₁]
  · intro e he
    simp only [M, Finset.mem_insert, Finset.mem_singleton] at he
    rcases he with rfl | rfl | rfl
    · exact ⟨ha₀, hb₀⟩
    · exact ⟨ha₁S, hb₁S⟩
    · exact ⟨ha₂S, hb₂S⟩

/-- Counting form of the parity split: in an independent-set-free graph,
every core without three disjoint internal edges has fewer than n + 4
vertices. -/
theorem card_lt_add_four_of_not_hasThreeDisjointAdjPairFamily
    {V : Type*} [Fintype V] {G : SimpleGraph V} {S : Finset V} {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hnot : ¬ HasThreeDisjointAdjPairFamily G S) :
    S.card < n + 4 := by
  by_contra h
  apply hnot
  exact hasThreeDisjointAdjPairFamily_of_indepSetFree_of_add_four_le_card
    hfree (by omega)

/-- More disjoint internal edges than forbidden vertices guarantee one edge
avoiding the forbidden set.  Pick one forbidden endpoint from every edge
that hits the set; disjointness makes that choice injective, contradicting
the cardinal inequality. -/
theorem exists_adjPair_avoiding_of_disjointAdjPairFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (M : Finset (V × V)) (F : Finset V)
    (hM : DisjointAdjPairFamily G M) (hcard : F.card < M.card) :
    ∃ e ∈ M, e.1 ∉ F ∧ e.2 ∉ F ∧ G.Adj e.1 e.2 := by
  classical
  by_contra hno
  have hhit : ∀ e ∈ M, e.1 ∈ F ∨ e.2 ∈ F := by
    intro e he
    by_contra hmiss
    apply hno
    exact ⟨e, he, by
      constructor
      · intro h
        exact hmiss (Or.inl h)
      · constructor
        · intro h
          exact hmiss (Or.inr h)
        · exact hM.1 e he⟩
  let pick : V × V → V := fun e => if e.1 ∈ F then e.1 else e.2
  have hpickF : ∀ e ∈ M, pick e ∈ F := by
    intro e he
    rcases hhit e he with heF | heF
    · simp [pick, heF]
    · by_cases hfirst : e.1 ∈ F
      · simp [pick, hfirst]
      · simp [pick, hfirst, heF]
  have hpickInj : Set.InjOn pick (M : Set (V × V)) := by
    intro e he f hf hpick
    by_contra hef
    have hsep := hM.2 e he f hf hef
    by_cases hefirst : e.1 ∈ F <;> by_cases hffirst : f.1 ∈ F
    · have : e.1 = f.1 := by simpa [pick, hefirst, hffirst] using hpick
      exact hsep.1 this
    · have : e.1 = f.2 := by simpa [pick, hefirst, hffirst] using hpick
      exact hsep.2.1 this
    · have : e.2 = f.1 := by simpa [pick, hefirst, hffirst] using hpick
      exact hsep.2.2.1 this
    · have : e.2 = f.2 := by simpa [pick, hefirst, hffirst] using hpick
      exact hsep.2.2.2 this
  let P : Finset V := M.image pick
  have hPcard : P.card = M.card := Finset.card_image_of_injOn hpickInj
  have hPF : P ⊆ F := by
    intro v hv
    rcases Finset.mem_image.mp hv with ⟨e, he, rfl⟩
    exact hpickF e he
  have hle : M.card ≤ F.card := by
    rw [← hPcard]
    exact Finset.card_le_card hPF
  omega

/-- A finite core has a maximum-cardinality disjoint adjacent-pair family.
The explicit endpoint-membership clause keeps the selector local to the
core, while the final maximality clause is the only property needed for the
parity-unbroken independent-remainder argument. -/
theorem exists_maximal_disjointAdjPairFamily_in_finset
    {V : Type*} [Fintype V] (G : SimpleGraph V) (S : Finset V) :
    ∃ M : Finset (V × V),
      DisjointAdjPairFamily G M ∧
      (∀ e ∈ M, e.1 ∈ S ∧ e.2 ∈ S) ∧
      ∀ N : Finset (V × V), DisjointAdjPairFamily G N →
        (∀ e ∈ N, e.1 ∈ S ∧ e.2 ∈ S) → N.card ≤ M.card := by
  classical
  let C : Finset (Finset (V × V)) :=
    Finset.univ.filter fun M =>
      DisjointAdjPairFamily G M ∧
        ∀ e ∈ M, e.1 ∈ S ∧ e.2 ∈ S
  have hCne : C.Nonempty := by
    refine ⟨∅, ?_⟩
    simp [C, DisjointAdjPairFamily]
  let D : Finset ℕ := C.image Finset.card
  have hDne : D.Nonempty := hCne.image Finset.card
  let t : ℕ := D.max' hDne
  have htD : t ∈ D := D.max'_mem hDne
  rcases Finset.mem_image.mp htD with ⟨M, hMC, hMt⟩
  have hMC' :
      DisjointAdjPairFamily G M ∧
        ∀ e ∈ M, e.1 ∈ S ∧ e.2 ∈ S :=
    (Finset.mem_filter.mp hMC).2
  refine ⟨M, hMC'.1, hMC'.2, ?_⟩
  intro N hN hNS
  have hNC : N ∈ C := by
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, ⟨hN, hNS⟩⟩
  have hNcard : N.card ∈ D := Finset.mem_image.mpr ⟨N, hNC, rfl⟩
  have hle : N.card ≤ t := D.le_max' N.card hNcard
  rw [← hMt] at hle
  exact hle

/-- The vertices left uncovered by a maximum local disjoint-edge family are
independent.  Otherwise one uncovered edge could be inserted, increasing
the matching cardinality and contradicting maximality. -/
theorem isIndepSet_sdiff_endpointCover_of_maximal_disjointAdjPairFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V) (S : Finset V)
    (M : Finset (V × V))
    (hM : DisjointAdjPairFamily G M)
    (hMS : ∀ e ∈ M, e.1 ∈ S ∧ e.2 ∈ S)
    (hmax : ∀ N : Finset (V × V), DisjointAdjPairFamily G N →
      (∀ e ∈ N, e.1 ∈ S ∧ e.2 ∈ S) → N.card ≤ M.card) :
    let F : Finset V := M.biUnion fun e => {e.1, e.2}
    G.IsIndepSet ((S \ F : Finset V) : Set V) := by
  classical
  let F : Finset V := M.biUnion fun e => {e.1, e.2}
  rw [SimpleGraph.isIndepSet_iff]
  intro x hx y hy _hxy hxy
  have hx' := Finset.mem_sdiff.mp hx
  have hy' := Finset.mem_sdiff.mp hy
  have havoid : ∀ z : V, z ∉ F → ∀ e ∈ M,
      z ≠ e.1 ∧ z ≠ e.2 := by
    intro z hz e he
    constructor
    · intro h
      apply hz
      exact Finset.mem_biUnion.mpr ⟨e, he, by simp [h]⟩
    · intro h
      apply hz
      exact Finset.mem_biUnion.mpr ⟨e, he, by simp [h]⟩
  have hxavoid := havoid x hx'.2
  have hyavoid := havoid y hy'.2
  have hpairNot : (x, y) ∉ M := by
    intro hpair
    exact hx'.2 (Finset.mem_biUnion.mpr
      ⟨(x, y), hpair, by simp⟩)
  let N : Finset (V × V) := insert (x, y) M
  have hN : DisjointAdjPairFamily G N := by
    constructor
    · intro e he
      simp only [N, Finset.mem_insert] at he
      rcases he with rfl | he
      · exact hxy
      · exact hM.1 e he
    · intro e he f hf hef
      simp only [N, Finset.mem_insert] at he hf
      rcases he with rfl | he <;> rcases hf with rfl | hf
      · exact (hef rfl).elim
      · have hxe := hxavoid f hf
        have hye := hyavoid f hf
        exact ⟨hxe.1, hxe.2, hye.1, hye.2⟩
      · have hxe := hxavoid e he
        have hye := hyavoid e he
        exact ⟨Ne.symm hxe.1, Ne.symm hye.1,
          Ne.symm hxe.2, Ne.symm hye.2⟩
      · exact hM.2 e he f hf hef
  have hNS : ∀ e ∈ N, e.1 ∈ S ∧ e.2 ∈ S := by
    intro e he
    simp only [N, Finset.mem_insert] at he
    rcases he with rfl | he
    · exact ⟨hx'.1, hy'.1⟩
    · exact hMS e he
  have hle := hmax N hN hNS
  have hcardN : N.card = M.card + 1 := by
    simp [N, hpairNot]
  rw [hcardN] at hle
  omega

/-- If a finite core is not parity broken at scale `m`, fewer than `2m`
vertices cover every internal edge.  Choose a maximum disjoint adjacent-pair
family in the core.  Its cardinality is below `m`, its endpoints have the
claimed size, and maximality makes the uncovered remainder independent. -/
theorem exists_small_endpointCover_with_indep_sdiff_of_not_hasInternalMatchingAtLeast
    {V : Type*} [Fintype V] (G : SimpleGraph V) (S : Finset V) (m : ℕ)
    (hnot : ¬ HasInternalMatchingAtLeast G S m) :
    ∃ F : Finset V, F ⊆ S ∧ F.card < 2 * m ∧
      G.IsIndepSet ((S \ F : Finset V) : Set V) := by
  classical
  obtain ⟨M, hM, hMS, hmax⟩ :=
    exists_maximal_disjointAdjPairFamily_in_finset G S
  have hMlt : M.card < m := by
    by_contra h
    apply hnot
    exact ⟨M, hM, by omega, hMS⟩
  let F : Finset V := M.biUnion fun e => {e.1, e.2}
  have hFsub : F ⊆ S := by
    intro v hv
    rcases Finset.mem_biUnion.mp hv with ⟨e, he, hve⟩
    have heS := hMS e he
    simp only [Finset.mem_insert, Finset.mem_singleton] at hve
    rcases hve with rfl | rfl
    · exact heS.1
    · exact heS.2
  have hFcard : F.card ≤ M.card * 2 := by
    dsimp [F]
    apply Finset.card_biUnion_le_card_mul
    intro e _he
    exact Finset.card_le_two
  refine ⟨F, hFsub, by omega, ?_⟩
  exact isIndepSet_sdiff_endpointCover_of_maximal_disjointAdjPairFamily
    G S M hM hMS hmax

/-- Quantitative remainder of a core that is not parity broken at scale
`m`: after deleting at most `2m-1` vertices, the retained independent set
has the corresponding cardinality lower bound. -/
theorem exists_large_indep_sdiff_of_not_hasInternalMatchingAtLeast
    {V : Type*} [Fintype V] (G : SimpleGraph V) (S : Finset V) (m : ℕ)
    (hnot : ¬ HasInternalMatchingAtLeast G S m) :
    ∃ I : Finset V, I ⊆ S ∧ G.IsIndepSet (I : Set V) ∧
      S.card - (2 * m - 1) ≤ I.card := by
  obtain ⟨F, hFS, hFcard, hInd⟩ :=
    exists_small_endpointCover_with_indep_sdiff_of_not_hasInternalMatchingAtLeast
      G S m hnot
  refine ⟨S \ F, Finset.sdiff_subset, hInd, ?_⟩
  apply sub_le_card_sdiff_of_le_card_of_card_le le_rfl
  omega

/-- Global scalable parity-unbroken count.  In a disjoint anticomplete
family, delete the small endpoint cover in every core.  The retained pieces
remain disjoint and their union is independent, so the sum of all retained
lower bounds is smaller than the forbidden independent-set order. -/
theorem sum_card_sub_two_mul_sub_one_lt_of_disjoint_pairwiseAnticomplete_not_internalMatching
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} {n m : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hnot : ∀ S ∈ F, ¬ HasInternalMatchingAtLeast G S m) :
    ∑ S ∈ F, (S.card - (2 * m - 1)) < n := by
  classical
  let I : Finset V → Finset V := fun S =>
    if hS : S ∈ F then
      Classical.choose
        (exists_large_indep_sdiff_of_not_hasInternalMatchingAtLeast
          G S m (hnot S hS))
    else ∅
  have hI : ∀ S ∈ F, I S ⊆ S ∧ G.IsIndepSet (I S : Set V) ∧
      S.card - (2 * m - 1) ≤ (I S).card := by
    intro S hS
    simp only [I, dif_pos hS]
    exact Classical.choose_spec
      (exists_large_indep_sdiff_of_not_hasInternalMatchingAtLeast
        G S m (hnot S hS))
  have hpair : (F : Set (Finset V)).PairwiseDisjoint I := by
    intro S hS T hT hST
    exact (hdisj S (by simpa using hS) T (by simpa using hT) hST).mono
      (hI S (by simpa using hS)).1 (hI T (by simpa using hT)).1
  have hUnionInd : G.IsIndepSet ((F.biUnion I : Finset V) : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_biUnion.mp ha with ⟨S, hS, haS⟩
    rcases Finset.mem_biUnion.mp hb with ⟨T, hT, hbT⟩
    by_cases hST : S = T
    · subst T
      have hSI := (hI S hS).2.1
      rw [SimpleGraph.isIndepSet_iff] at hSI
      exact hSI haS hbT hab
    · exact hanti S hS T hT hST a ((hI S hS).1 haS)
        b ((hI T hT).1 hbT)
  have hsumI :
      (F.biUnion I).card = ∑ S ∈ F, (I S).card := by
    simpa using Finset.card_biUnion hpair
  calc
    ∑ S ∈ F, (S.card - (2 * m - 1)) ≤
        ∑ S ∈ F, (I S).card := by
      apply Finset.sum_le_sum
      intro S hS
      exact (hI S hS).2.2
    _ = (F.biUnion I).card := hsumI.symm
    _ < n := Erdos551.IndepSetFree.card_lt hfree hUnionInd

/-- Uniform-order consequence of the scalable parity-unbroken count. -/
theorem mul_card_sub_two_mul_sub_one_lt_of_disjoint_pairwiseAnticomplete_not_internalMatching
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} {n m tau : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hnot : ∀ S ∈ F, ¬ HasInternalMatchingAtLeast G S m)
    (hcard : ∀ S ∈ F, tau ≤ S.card) :
    (tau - (2 * m - 1)) * F.card < n := by
  have hsum :=
    sum_card_sub_two_mul_sub_one_lt_of_disjoint_pairwiseAnticomplete_not_internalMatching
      G hfree hdisj hanti hnot
  have hle : (tau - (2 * m - 1)) * F.card ≤
      ∑ S ∈ F, (S.card - (2 * m - 1)) := by
    calc
      (tau - (2 * m - 1)) * F.card =
          ∑ _S ∈ F, (tau - (2 * m - 1)) := by
        simp [Nat.mul_comm]
      _ ≤ ∑ S ∈ F, (S.card - (2 * m - 1)) := by
        apply Finset.sum_le_sum
        intro S hS
        have := hcard S hS
        omega
  exact hle.trans_lt hsum

/-- The graph consisting only of edges crossing between two displayed
vertex sets.  Keeping the ambient vertex type makes maximum-matching
selection reuse the finite ordered-pair machinery above. -/
def CrossEdgeGraph {V : Type*} (G : SimpleGraph V)
    (A B : Finset V) : SimpleGraph V where
  Adj x y := G.Adj x y ∧
    ((x ∈ A ∧ y ∈ B) ∨ (x ∈ B ∧ y ∈ A))
  symm := ⟨by
    intro x y h
    exact ⟨h.1.symm, h.2.elim
      (fun hxy => Or.inr ⟨hxy.2, hxy.1⟩)
      (fun hxy => Or.inl ⟨hxy.2, hxy.1⟩)⟩⟩
  loopless := ⟨by
    intro x h
    exact h.1.ne rfl⟩

@[simp]
theorem crossEdgeGraph_adj {V : Type*} {G : SimpleGraph V}
    {A B : Finset V} {x y : V} :
    (CrossEdgeGraph G A B).Adj x y ↔
      G.Adj x y ∧ ((x ∈ A ∧ y ∈ B) ∨ (x ∈ B ∧ y ∈ A)) :=
  Iff.rfl

/-- Finite cross-matching dichotomy.  Between two vertex sets there is
either a vertex-disjoint family of at least `m` crossing edges, or fewer
than `2m` vertices meet every crossing edge.  This is the exact local
maximal-matching cleanup used in the KLS interaction graph. -/
theorem exists_crossMatching_or_small_cross_vertexCover
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) (A B : Finset V) (m : ℕ) :
    (∃ M : Finset (V × V),
      DisjointAdjPairFamily G M ∧ m ≤ M.card ∧
      ∀ e ∈ M, (e.1 ∈ A ∧ e.2 ∈ B) ∨
        (e.1 ∈ B ∧ e.2 ∈ A)) ∨
    ∃ X : Finset V, X.card < 2 * m ∧
      ∀ a ∈ A \ X, ∀ b ∈ B \ X, ¬ G.Adj a b := by
  classical
  let K : SimpleGraph V := CrossEdgeGraph G A B
  obtain ⟨M, hM, hMS, hmax⟩ :=
    exists_maximal_disjointAdjPairFamily_in_finset K (A ∪ B)
  by_cases hlarge : m ≤ M.card
  · left
    refine ⟨M, ?_, hlarge, ?_⟩
    · constructor
      · intro e he
        exact (hM.1 e he).1
      · exact hM.2
    · intro e he
      exact (hM.1 e he).2
  · right
    let X : Finset V := M.biUnion fun e => {e.1, e.2}
    have hXcard : X.card ≤ M.card * 2 := by
      dsimp [X]
      apply Finset.card_biUnion_le_card_mul
      intro e _he
      exact Finset.card_le_two
    have hMlt : M.card < m := by omega
    have hXlt : X.card < 2 * m := by omega
    refine ⟨X, hXlt, ?_⟩
    have hInd : K.IsIndepSet (((A ∪ B) \ X : Finset V) : Set V) :=
      isIndepSet_sdiff_endpointCover_of_maximal_disjointAdjPairFamily
        K (A ∪ B) M hM hMS hmax
    rw [SimpleGraph.isIndepSet_iff] at hInd
    intro a ha b hb hab
    have ha' : a ∈ (A ∪ B) \ X := by
      exact Finset.mem_sdiff.mpr
        ⟨Finset.mem_union_left B (Finset.mem_sdiff.mp ha).1,
          (Finset.mem_sdiff.mp ha).2⟩
    have hb' : b ∈ (A ∪ B) \ X := by
      exact Finset.mem_sdiff.mpr
        ⟨Finset.mem_union_right A (Finset.mem_sdiff.mp hb).1,
          (Finset.mem_sdiff.mp hb).2⟩
    exact hInd ha' hb' hab.ne ⟨hab, Or.inl
      ⟨(Finset.mem_sdiff.mp ha).1, (Finset.mem_sdiff.mp hb).1⟩⟩

/-- Two finite sets have a cross matching of the displayed cardinality. -/
def HasCrossMatchingAtLeast {V : Type*} (G : SimpleGraph V)
    (A B : Finset V) (m : ℕ) : Prop :=
  ∃ M : Finset (V × V),
    DisjointAdjPairFamily G M ∧ m ≤ M.card ∧
    ∀ e ∈ M, (e.1 ∈ A ∧ e.2 ∈ B) ∨
      (e.1 ∈ B ∧ e.2 ∈ A)

/-- Three disjoint internal edges are, in particular, a size-three cross
matching when the two displayed reservoirs coincide. -/
theorem hasCrossMatchingAtLeast_self_three_of_hasThree
    {V : Type*} {G : SimpleGraph V} {U : Finset V}
    (h : HasThreeDisjointAdjPairFamily G U) :
    HasCrossMatchingAtLeast G U U 3 := by
  obtain ⟨M, hM, hMcard, hMU⟩ := h
  refine ⟨M, hM, by omega, ?_⟩
  intro e he
  exact Or.inl (hMU e he)

theorem HasCrossMatchingAtLeast.mono
    {V : Type*} {G : SimpleGraph V} {A B : Finset V} {r m : ℕ}
    (h : HasCrossMatchingAtLeast G A B m) (hrm : r ≤ m) :
    HasCrossMatchingAtLeast G A B r := by
  obtain ⟨M, hM, hm, hcross⟩ := h
  exact ⟨M, hM, hrm.trans hm, hcross⟩

/-- Enlarging both endpoint reservoirs preserves a cross-matching
certificate. -/
theorem HasCrossMatchingAtLeast.mono_sets
    {V : Type*} {G : SimpleGraph V}
    {A B A' B' : Finset V} {m : ℕ}
    (h : HasCrossMatchingAtLeast G A B m)
    (hAA' : A ⊆ A') (hBB' : B ⊆ B') :
    HasCrossMatchingAtLeast G A' B' m := by
  obtain ⟨M, hM, hm, hcross⟩ := h
  refine ⟨M, hM, hm, ?_⟩
  intro e he
  rcases hcross e he with heAB | heBA
  · exact Or.inl ⟨hAA' heAB.1, hBB' heAB.2⟩
  · exact Or.inr ⟨hBB' heBA.1, hAA' heBA.2⟩

theorem hasCrossMatchingAtLeast_comm
    {V : Type*} {G : SimpleGraph V} {A B : Finset V} {m : ℕ} :
    HasCrossMatchingAtLeast G A B m ↔
      HasCrossMatchingAtLeast G B A m := by
  constructor <;> rintro ⟨M, hM, hm, hcross⟩
  · refine ⟨M, hM, hm, ?_⟩
    intro e he
    exact (hcross e he).symm
  · refine ⟨M, hM, hm, ?_⟩
    intro e he
    exact (hcross e he).symm

/-- Orient a cross matching toward its first displayed reservoir.  Its
first endpoints form a set of the same cardinality as the matching and each
has a neighbour in the second reservoir. -/
theorem exists_left_endpointFinset_of_hasCrossMatchingAtLeast
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {A B : Finset V} {m : ℕ} (hAB : Disjoint A B)
    (hcross : HasCrossMatchingAtLeast G A B m) :
    ∃ P : Finset V, P ⊆ A ∧ m ≤ P.card ∧
      ∀ x ∈ P, ∃ y ∈ B, G.Adj x y := by
  classical
  obtain ⟨M, hM, hm, hMcross⟩ := hcross
  let pick : V × V → V := fun e => if e.1 ∈ A then e.1 else e.2
  let mate : V × V → V := fun e => if e.1 ∈ A then e.2 else e.1
  have hpickA : ∀ e ∈ M, pick e ∈ A := by
    intro e he
    rcases hMcross e he with heAB | heBA
    · simp [pick, heAB.1]
    · have he1notA : e.1 ∉ A := by
        intro he1A
        exact (Finset.disjoint_left.mp hAB) he1A heBA.1
      simp [pick, he1notA, heBA.2]
  have hmateB : ∀ e ∈ M, mate e ∈ B := by
    intro e he
    rcases hMcross e he with heAB | heBA
    · simp [mate, heAB.1, heAB.2]
    · have he1notA : e.1 ∉ A := by
        intro he1A
        exact (Finset.disjoint_left.mp hAB) he1A heBA.1
      simp [mate, he1notA, heBA.1]
  have hAdj : ∀ e ∈ M, G.Adj (pick e) (mate e) := by
    intro e he
    have hedge := hM.1 e he
    by_cases he1A : e.1 ∈ A
    · simpa [pick, mate, he1A] using hedge
    · simpa [pick, mate, he1A] using hedge.symm
  have hpickInj : Set.InjOn pick (M : Set (V × V)) := by
    intro e he f hf hpick
    by_contra hef
    have hsep := hM.2 e he f hf hef
    by_cases hefirst : e.1 ∈ A <;> by_cases hffirst : f.1 ∈ A
    · exact hsep.1 (by simpa [pick, hefirst, hffirst] using hpick)
    · exact hsep.2.1 (by simpa [pick, hefirst, hffirst] using hpick)
    · exact hsep.2.2.1 (by simpa [pick, hefirst, hffirst] using hpick)
    · exact hsep.2.2.2 (by simpa [pick, hefirst, hffirst] using hpick)
  let P : Finset V := M.image pick
  refine ⟨P, ?_, ?_, ?_⟩
  · intro x hx
    rcases Finset.mem_image.mp hx with ⟨e, he, rfl⟩
    exact hpickA e he
  · rw [show P.card = M.card by
      exact Finset.card_image_of_injOn hpickInj]
    exact hm
  · intro x hx
    rcases Finset.mem_image.mp hx with ⟨e, he, rfl⟩
    exact ⟨mate e, hmateB e he, hAdj e he⟩

/-- Auxiliary graph whose edges are hub pairs carrying a cross matching of
size at least `m`.  The `fromRel` wrapper records looplessness while the
preceding commutativity lemma supplies ordered witnesses. -/
def LargeCrossMatchingGraph {V ι : Type*} (G : SimpleGraph V)
    (U : ι → Finset V) (m : ℕ) : SimpleGraph ι :=
  SimpleGraph.fromRel fun i j => HasCrossMatchingAtLeast G (U i) (U j) m

theorem hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
    {V ι : Type*} {G : SimpleGraph V} {U : ι → Finset V} {m : ℕ}
    {i j : ι} (hij : (LargeCrossMatchingGraph G U m).Adj i j) :
    HasCrossMatchingAtLeast G (U i) (U j) m := by
  rw [LargeCrossMatchingGraph, SimpleGraph.fromRel_adj] at hij
  rcases hij with ⟨_hij, h | h⟩
  · exact h
  · exact hasCrossMatchingAtLeast_comm.mpr h

/-- If vertices in one core cannot attach to two different other cores,
then the matchings represented by different auxiliary neighbours consume
disjoint endpoint sets.  Hence `m * degree` is bounded by the core order. -/
theorem mul_degree_largeCrossMatchingGraph_le_card_of_no_repeated_attachment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (A W : ι → Finset V) (m : ℕ)
    (hWA : ∀ i, W i ⊆ A i)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (A i) (A j))
    (hnorep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ x ∈ W i, ∀ y ∈ A j, ∀ z ∈ A ℓ,
        G.Adj x y → G.Adj x z → False)
    (i : ι) :
    m * (LargeCrossMatchingGraph G W m).degree i ≤ (A i).card := by
  classical
  let H : SimpleGraph ι := LargeCrossMatchingGraph G W m
  have hcross (j : H.neighborSet i) :
      HasCrossMatchingAtLeast G (W i) (W j.1) m := by
    apply hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
    change H.Adj i j.1
    exact j.2
  have hWij (j : H.neighborSet i) : Disjoint (W i) (W j.1) := by
    apply (hdisj i j.1 ?_).mono (hWA i) (hWA j.1)
    have hij : H.Adj i j.1 := by exact j.2
    exact hij.ne
  let P : H.neighborSet i → Finset V := fun j =>
    Classical.choose
      (exists_left_endpointFinset_of_hasCrossMatchingAtLeast
        G (hWij j) (hcross j))
  have hP (j : H.neighborSet i) :
      P j ⊆ W i ∧ m ≤ (P j).card ∧
        ∀ x ∈ P j, ∃ y ∈ W j.1, G.Adj x y := by
    exact Classical.choose_spec
      (exists_left_endpointFinset_of_hasCrossMatchingAtLeast
        G (hWij j) (hcross j))
  have hpair :
      ((Finset.univ : Finset (H.neighborSet i)) : Set _).PairwiseDisjoint P := by
    intro j _hj ℓ _hℓ hjℓ
    change Disjoint (P j) (P ℓ)
    rw [Finset.disjoint_left]
    intro x hxj hxℓ
    obtain ⟨y, hy, hxy⟩ := (hP j).2.2 x hxj
    obtain ⟨z, hz, hxz⟩ := (hP ℓ).2.2 x hxℓ
    have hijAdj : H.Adj i j.1 := by exact j.2
    have hiℓAdj : H.Adj i ℓ.1 := by exact ℓ.2
    have hjℓ' : j.1 ≠ ℓ.1 := by
      intro h
      exact hjℓ (Subtype.ext h)
    exact hnorep i j.1 ℓ.1 hijAdj.ne hiℓAdj.ne hjℓ' x
      ((hP j).1 hxj) y (hWA j.1 hy) z (hWA ℓ.1 hz) hxy hxz
  have hUnionSub :
      (Finset.univ : Finset (H.neighborSet i)).biUnion P ⊆ A i := by
    intro x hx
    rcases Finset.mem_biUnion.mp hx with ⟨j, _hj, hxP⟩
    exact hWA i ((hP j).1 hxP)
  calc
    m * H.degree i = m * Fintype.card (H.neighborSet i) := by
      rw [H.card_neighborSet_eq_degree]
    _ = ∑ j : H.neighborSet i, m := by simp [Nat.mul_comm]
    _ ≤ ∑ j : H.neighborSet i, (P j).card := by
      exact Finset.sum_le_sum fun j _hj => (hP j).2.1
    _ = ((Finset.univ : Finset (H.neighborSet i)).biUnion P).card := by
      simpa using (Finset.card_biUnion hpair).symm
    _ ≤ (A i).card := Finset.card_le_card hUnionSub

/-- A cross matching larger than a forbidden vertex set contains a crossing
edge avoiding that set.  The matching may store either orientation, so the
conclusion reorients the surviving edge from `A` to `B`. -/
theorem exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {A B F : Finset V} {m : ℕ}
    (hcross : HasCrossMatchingAtLeast G A B m)
    (hF : F.card < m) :
    ∃ a ∈ A, ∃ b ∈ B, a ∉ F ∧ b ∉ F ∧ G.Adj a b := by
  classical
  obtain ⟨M, hM, hm, hMcross⟩ := hcross
  have hFcard : F.card < M.card := hF.trans_le hm
  obtain ⟨e, heM, he1F, he2F, heAdj⟩ :=
    exists_adjPair_avoiding_of_disjointAdjPairFamily G M F hM hFcard
  rcases hMcross e heM with heAB | heBA
  · exact ⟨e.1, heAB.1, e.2, heAB.2, he1F, he2F, heAdj⟩
  · exact ⟨e.2, heBA.2, e.1, heBA.1, he2F, he1F, heAdj.symm⟩

/-- Consecutive large cross matchings along a line yield oriented
representatives whose two attachments at every internal displayed set are
different.  Two matching edges suffice locally: after the incoming endpoint
has been fixed, the next representative avoids that single vertex. -/
theorem exists_distinct_oriented_cross_edge_chain
    {V : Type*} [Fintype V] (G : SimpleGraph V) :
    ∀ {m : ℕ} (U : Fin (m + 1) → Finset V),
      (∀ i : Fin m,
        HasCrossMatchingAtLeast G (U i.castSucc) (U i.succ) 2) →
      ∃ p q : Fin m → V,
        (∀ i : Fin m,
          p i ∈ U i.castSucc ∧ q i ∈ U i.succ ∧ G.Adj (p i) (q i)) ∧
        ∀ i j : Fin m, j.val = i.val + 1 → q i ≠ p j := by
  intro m
  induction m with
  | zero =>
      intro U _hcross
      exact ⟨fun i => i.elim0, fun i => i.elim0, by simp⟩
  | succ m ih =>
      cases m with
      | zero =>
          intro U hcross
          obtain ⟨x, hx, y, hy, _hxF, _hyF, hxy⟩ :=
            exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
              G (hcross 0) (F := ∅) (by simp)
          let p : Fin 1 → V := fun _ => x
          let q : Fin 1 → V := fun _ => y
          refine ⟨p, q, ?_, ?_⟩
          · intro i
            fin_cases i
            exact ⟨hx, hy, hxy⟩
          · intro i j hij
            omega
      | succ m =>
          intro U hcross
          let U' : Fin (m + 2) → Finset V := fun i => U i.castSucc
          have hcross' : ∀ i : Fin (m + 1),
              HasCrossMatchingAtLeast G (U' i.castSucc) (U' i.succ) 2 := by
            intro i
            simpa [U'] using hcross i.castSucc
          obtain ⟨p, q, hpq, hdistinct⟩ := ih U' hcross'
          let F : Finset V := {q (Fin.last m)}
          have hF : F.card < 2 := by
            simp [F]
          obtain ⟨x, hx, y, hy, hxF, _hyF, hxy⟩ :=
            exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
              G (hcross (Fin.last (m + 1))) hF
          let p' : Fin (m + 2) → V := Fin.lastCases x p
          let q' : Fin (m + 2) → V := Fin.lastCases y q
          refine ⟨p', q', ?_, ?_⟩
          · intro i
            induction i using Fin.lastCases with
            | last =>
                simpa [p', q'] using And.intro hx (And.intro hy hxy)
            | cast i =>
                simpa [p', q', U'] using hpq i
          · intro i j hij
            induction j using Fin.lastCases with
            | last =>
                have hi : i = (Fin.last m).castSucc := by
                  apply Fin.ext
                  simp at hij ⊢
                  omega
                subst i
                have hxne : x ≠ q (Fin.last m) := by
                  simpa [F] using hxF
                simpa [p', q'] using hxne.symm
            | cast j =>
                have hiBound : i.val < m + 1 := by
                  have hjBound := j.isLt
                  simp at hij
                  omega
                let i' : Fin (m + 1) := ⟨i.val, hiBound⟩
                have hrec : q i' ≠ p j := by
                  apply hdistinct i' j
                  simpa [i'] using hij
                have hii : i = i'.castSucc := by
                  apply Fin.ext
                  rfl
                rw [hii]
                simpa [p', q'] using hrec

/-- Quantitative globally-disjoint version of the chain selector.  If every
cross matching is larger than twice the number of requested handles, greedily
choosing the handles leaves all of their endpoints pairwise distinct.  This
is the endpoint-selection input for a doubled-tree traversal, where a hub may
occur many times. -/
theorem exists_globally_disjoint_oriented_cross_edge_chain
    {V : Type*} [Fintype V] (G : SimpleGraph V) :
    ∀ {m R : ℕ} (U : Fin (m + 1) → Finset V),
      2 * m < R →
      (∀ i : Fin m,
        HasCrossMatchingAtLeast G (U i.castSucc) (U i.succ) R) →
      ∃ p q : Fin m → V,
        (∀ i : Fin m,
          p i ∈ U i.castSucc ∧ q i ∈ U i.succ ∧ G.Adj (p i) (q i)) ∧
        ∀ i j : Fin m, i ≠ j →
          p i ≠ p j ∧ p i ≠ q j ∧ q i ≠ p j ∧ q i ≠ q j := by
  intro m
  induction m with
  | zero =>
      intro R U _hR _hcross
      exact ⟨fun i => i.elim0, fun i => i.elim0, by simp⟩
  | succ m ih =>
      intro R U hR hcross
      let U' : Fin (m + 1) → Finset V := fun i => U i.castSucc
      have hR' : 2 * m < R := by omega
      have hcross' : ∀ i : Fin m,
          HasCrossMatchingAtLeast G (U' i.castSucc) (U' i.succ) R := by
        intro i
        simpa [U'] using hcross i.castSucc
      obtain ⟨p, q, hpq, hdisj⟩ := ih U' hR' hcross'
      let F : Finset V :=
        (Finset.univ.image p) ∪ (Finset.univ.image q)
      have hFcard : F.card < R := by
        have hpCard : (Finset.univ.image p).card ≤ m := by
          calc
            (Finset.univ.image p).card ≤ (Finset.univ : Finset (Fin m)).card :=
              Finset.card_image_le
            _ = m := by simp
        have hqCard : (Finset.univ.image q).card ≤ m := by
          calc
            (Finset.univ.image q).card ≤ (Finset.univ : Finset (Fin m)).card :=
              Finset.card_image_le
            _ = m := by simp
        have hUnion := Finset.card_union_le
          (Finset.univ.image p) (Finset.univ.image q)
        change F.card < R
        dsimp [F]
        omega
      obtain ⟨x, hx, y, hy, hxF, hyF, hxy⟩ :=
        exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
          G (hcross (Fin.last m)) hFcard
      have hxP : ∀ i : Fin m, x ≠ p i := by
        intro i h
        apply hxF
        exact Finset.mem_union_left _
          (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, h.symm⟩)
      have hxQ : ∀ i : Fin m, x ≠ q i := by
        intro i h
        apply hxF
        exact Finset.mem_union_right _
          (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, h.symm⟩)
      have hyP : ∀ i : Fin m, y ≠ p i := by
        intro i h
        apply hyF
        exact Finset.mem_union_left _
          (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, h.symm⟩)
      have hyQ : ∀ i : Fin m, y ≠ q i := by
        intro i h
        apply hyF
        exact Finset.mem_union_right _
          (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, h.symm⟩)
      let p' : Fin (m + 1) → V := Fin.lastCases x p
      let q' : Fin (m + 1) → V := Fin.lastCases y q
      refine ⟨p', q', ?_, ?_⟩
      · intro i
        induction i using Fin.lastCases with
        | last => simpa [p', q'] using And.intro hx (And.intro hy hxy)
        | cast i => simpa [p', q', U'] using hpq i
      · intro i j hij
        induction i using Fin.lastCases with
        | last =>
            induction j using Fin.lastCases with
            | last => exact (hij rfl).elim
            | cast j =>
                simpa [p', q'] using
                  And.intro (hxP j) (And.intro (hxQ j)
                    (And.intro (hyP j) (hyQ j)))
        | cast i =>
            induction j using Fin.lastCases with
            | last =>
                simpa [p', q'] using
                  And.intro (Ne.symm (hxP i)) (And.intro (Ne.symm (hyP i))
                    (And.intro (Ne.symm (hxQ i)) (Ne.symm (hyQ i))))
            | cast j =>
                have hij' : i ≠ j := by
                  intro h
                  exact hij (congrArg Fin.castSucc h)
                simpa [p', q'] using hdisj i j hij'

/-- Walk-indexed wrapper around the globally-disjoint chain selector.  An
auxiliary walk supplies the ordered hub sequence; every traversed auxiliary
edge is replaced by a fresh oriented ambient cross-edge. -/
theorem exists_globally_disjoint_cross_edges_along_walk
    {V ι : Type*} [Fintype V] (G : SimpleGraph V)
    (H : SimpleGraph ι) (U : ι → Finset V)
    {u v : ι} (w : H.Walk u v) {R : ℕ}
    (hbudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R) :
    ∃ p q : Fin w.length → V,
      (∀ i : Fin w.length,
        p i ∈ U (w.getVert i.val) ∧
        q i ∈ U (w.getVert (i.val + 1)) ∧
        G.Adj (p i) (q i)) ∧
      ∀ i j : Fin w.length, i ≠ j →
        p i ≠ p j ∧ p i ≠ q j ∧ q i ≠ p j ∧ q i ≠ q j := by
  let W : Fin (w.length + 1) → Finset V := fun i => U (w.getVert i.val)
  have hstep : ∀ i : Fin w.length,
      HasCrossMatchingAtLeast G (W i.castSucc) (W i.succ) R := by
    intro i
    apply hlarge
    exact w.adj_getVert_succ i.isLt
  obtain ⟨p, q, hpq, hdisj⟩ :=
    exists_globally_disjoint_oriented_cross_edge_chain G W hbudget hstep
  refine ⟨p, q, ?_, hdisj⟩
  intro i
  simpa [W] using hpq i

/-- A nontrivial closed auxiliary walk becomes a cyclic ambient handle
system.  The predecessor permutation turns each traversed edge's target into
the incoming attachment of the next visit.  Global endpoint disjointness is
retained even when the closed walk visits the same hub many times. -/
theorem exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
    {V ι : Type*} [Fintype V] (G : SimpleGraph V)
    (H : SimpleGraph ι) (U : ι → Finset V)
    {u : ι} (w : H.Walk u u) {R : ℕ}
    (hlen : 2 ≤ w.length) (hbudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R) :
    ∃ a b : Fin w.length → V,
      (∀ i, a i ∈ U (w.getVert i.val)) ∧
      (∀ i, b i ∈ U (w.getVert i.val)) ∧
      (∀ i, a i ≠ b i) ∧
      (∀ i j, i ≠ j →
        a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j) ∧
      (∀ i j : Fin w.length, j.val = i.val + 1 →
        G.Adj (b i) (a j)) ∧
      ∀ i j : Fin w.length, i.val + 1 = w.length → j.val = 0 →
        G.Adj (b i) (a j) := by
  classical
  obtain ⟨p, q, hpq, hpqDisj⟩ :=
    exists_globally_disjoint_cross_edges_along_walk
      G H U w hbudget hlarge
  let lastEdge : Fin w.length := ⟨w.length - 1, by omega⟩
  let pred : Fin w.length → Fin w.length := fun i =>
    if hi : i.val = 0 then lastEdge else ⟨i.val - 1, by omega⟩
  have hpredZero : ∀ i : Fin w.length, i.val = 0 → pred i = lastEdge := by
    intro i hi
    simp [pred, hi]
  have hpredPos : ∀ i : Fin w.length, i.val ≠ 0 →
      (pred i).val = i.val - 1 := by
    intro i hi
    simp [pred, hi]
  have hpredInj : Function.Injective pred := by
    intro i j hij
    apply Fin.ext
    have hval := congrArg Fin.val hij
    by_cases hi : i.val = 0
    · by_cases hj : j.val = 0
      · exact hi.trans hj.symm
      · simp [pred, hi, hj, lastEdge] at hval
        omega
    · by_cases hj : j.val = 0
      · simp [pred, hi, hj, lastEdge] at hval
        omega
      · simp [pred, hi, hj] at hval
        omega
  have hpredNe : ∀ i : Fin w.length, pred i ≠ i := by
    intro i h
    have hval := congrArg Fin.val h
    by_cases hi : i.val = 0
    · simp [pred, hi, lastEdge] at hval
      omega
    · simp [pred, hi] at hval
      omega
  let a : Fin w.length → V := fun i => q (pred i)
  let b : Fin w.length → V := p
  have ha : ∀ i, a i ∈ U (w.getVert i.val) := by
    intro i
    by_cases hi : i.val = 0
    · have hq := (hpq lastEdge).2.1
      have hend : w.getVert (lastEdge.val + 1) = w.getVert i.val := by
        rw [show lastEdge.val + 1 = w.length by
          dsimp [lastEdge]
          omega]
        simp [hi]
      simpa [a, hpredZero i hi, hend] using hq
    · have hpredVal : (pred i).val + 1 = i.val := by
        rw [hpredPos i hi]
        omega
      have hq := (hpq (pred i)).2.1
      simpa [a, hpredVal] using hq
  have hb : ∀ i, b i ∈ U (w.getVert i.val) := by
    intro i
    exact (hpq i).1
  have hab : ∀ i, a i ≠ b i := by
    intro i
    exact (hpqDisj (pred i) i (hpredNe i)).2.2.1
  have hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j := by
    intro i j hij
    have hpredij : pred i ≠ pred j := fun h => hij (hpredInj h)
    have haa : a i ≠ a j := (hpqDisj (pred i) (pred j) hpredij).2.2.2
    have hab' : a i ≠ b j := by
      by_cases h : pred i = j
      · subst j
        exact (hpq (pred i)).2.2.ne'
      · exact (hpqDisj (pred i) j h).2.2.1
    have hba : b i ≠ a j := by
      by_cases h : i = pred j
      · subst i
        exact (hpq (pred j)).2.2.ne
      · exact (hpqDisj i (pred j) h).2.1
    have hbb : b i ≠ b j := (hpqDisj i j hij).1
    exact ⟨haa, hab', hba, hbb⟩
  refine ⟨a, b, ha, hb, hab, hpairs, ?_, ?_⟩
  · intro i j hij
    have hjpos : j.val ≠ 0 := by omega
    have hpredj : pred j = i := by
      apply Fin.ext
      rw [hpredPos j hjpos]
      omega
    simpa [a, b, hpredj] using (hpq i).2.2
  · intro i j hi hj
    have hiLast : i = lastEdge := by
      apply Fin.ext
      dsimp [lastEdge]
      omega
    have hpredj : pred j = lastEdge := hpredZero j hj
    simpa [a, b, hiLast, hpredj] using (hpq lastEdge).2.2

/-- A cyclic sequence of cross matchings of size three has representatives
with two distinct attachments in every displayed set.  First choose the
nonclosing edges along a line, avoiding the previous incoming attachment;
the closing matching then avoids the two still exposed endpoints. -/
theorem exists_distinct_oriented_cyclic_cross_edges
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {m : ℕ} (hm : 2 ≤ m) (U : Fin (m + 1) → Finset V)
    (hstep : ∀ i : Fin m,
      HasCrossMatchingAtLeast G (U i.castSucc) (U i.succ) 3)
    (hclose : HasCrossMatchingAtLeast G (U (Fin.last m)) (U 0) 3) :
    ∃ a b : Fin (m + 1) → V,
      (∀ i, a i ∈ U i) ∧ (∀ i, b i ∈ U i) ∧
      (∀ i, a i ≠ b i) ∧
      (∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ)) ∧
      G.Adj (b (Fin.last m)) (a 0) := by
  classical
  have hstepTwo : ∀ i : Fin m,
      HasCrossMatchingAtLeast G (U i.castSucc) (U i.succ) 2 := by
    intro i
    exact (hstep i).mono (by omega)
  obtain ⟨p, q, hpq, hdistinct⟩ :=
    exists_distinct_oriented_cross_edge_chain G U hstepTwo
  let firstPath : Fin m := ⟨0, by omega⟩
  let lastPath : Fin m := ⟨m - 1, by omega⟩
  let F : Finset V := {q lastPath, p firstPath}
  have hF : F.card < 3 := by
    have hcard : F.card ≤ 2 := Finset.card_le_two
    omega
  obtain ⟨x, hx, y, hy, hxF, hyF, hxy⟩ :=
    exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
      G hclose hF
  let a : Fin (m + 1) → V := Fin.cases y q
  let b : Fin (m + 1) → V := Fin.lastCases x p
  refine ⟨a, b, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    induction i using Fin.cases with
    | zero => simpa [a] using hy
    | succ i => simpa [a] using (hpq i).2.1
  · intro i
    induction i using Fin.lastCases with
    | last => simpa [b] using hx
    | cast i => simpa [b] using (hpq i).1
  · intro i
    induction i using Fin.cases with
    | zero =>
        have hyne : y ≠ p firstPath := by
          have havoid : y ≠ q lastPath ∧ y ≠ p firstPath := by
            simpa [F] using hyF
          exact havoid.2
        have hzero : (0 : Fin (m + 1)) = firstPath.castSucc := by
          apply Fin.ext
          rfl
        have haZero : a 0 = y := by simp [a]
        have hbZero : b 0 = p firstPath := by
          rw [hzero]
          simp [b]
        rw [haZero, hbZero]
        exact hyne
    | succ i =>
        by_cases hilast : i.val + 1 = m
        · have hi : i = lastPath := by
            apply Fin.ext
            dsimp [lastPath]
            omega
          have hisucc : i.succ = Fin.last m := by
            apply Fin.ext
            simp
            omega
          have hxne : x ≠ q lastPath := by
            have havoid : x ≠ q lastPath ∧ x ≠ p firstPath := by
              simpa [F] using hxF
            exact havoid.1
          have haSucc : a i.succ = q lastPath := by
            simp [a, hi]
          have hbSucc : b i.succ = x := by
            rw [hisucc]
            simp [b]
          rw [haSucc, hbSucc]
          exact hxne.symm
        · let j : Fin m := ⟨i.val + 1, by omega⟩
          have hne : q i ≠ p j := by
            apply hdistinct i j
            rfl
          have hisucc : i.succ = j.castSucc := by
            apply Fin.ext
            rfl
          have haSucc : a i.succ = q i := by simp [a]
          have hbSucc : b i.succ = p j := by
            rw [hisucc]
            simp [b]
          rw [haSucc, hbSucc]
          exact hne
  · intro i
    simpa [a, b] using (hpq i).2.2
  · simpa [a, b] using hxy

/-- A copied auxiliary cycle in the large-cross-matching graph supplies an
injective cyclic list of robust-core indices together with distinct ambient
attachments at every index.  Unlike the ordinary interaction graph, no
repeated-attachment deletion is needed: the local matchings choose the
attachments coherently. -/
theorem exists_distinct_cyclic_cross_edges_of_cycleGraph_isContained_largeCrossMatchingGraph
    {V ι : Type*} [Fintype V] {m : ℕ} (hm : 2 ≤ m)
    (G : SimpleGraph V) (U : ι → Finset V)
    (hcopy : cycleGraph (m + 1) ⊑ LargeCrossMatchingGraph G U 3) :
    ∃ f : Fin (m + 1) → ι, Function.Injective f ∧
      ∃ a b : Fin (m + 1) → V,
        (∀ i, a i ∈ U (f i)) ∧ (∀ i, b i ∈ U (f i)) ∧
        (∀ i, a i ≠ b i) ∧
        (∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ)) ∧
        G.Adj (b (Fin.last m)) (a 0) := by
  classical
  rcases hcopy with ⟨c⟩
  let f : Fin (m + 1) → ι := fun i => c.toHom i
  have hfinj : Function.Injective f := c.injective
  have hstep : ∀ i : Fin m,
      (LargeCrossMatchingGraph G U 3).Adj (f i.castSucc) (f i.succ) := by
    intro i
    apply c.toHom.map_adj
    rw [SimpleGraph.cycleGraph_adj']
    right
    rw [Fin.sub_val_of_le (by
      change i.val ≤ i.val + 1
      omega)]
    simp
  have hclose :
      (LargeCrossMatchingGraph G U 3).Adj (f (Fin.last m)) (f 0) := by
    apply c.toHom.map_adj
    rw [SimpleGraph.cycleGraph_adj']
    right
    simp
    omega
  have hstep' : ∀ i : Fin m,
      HasCrossMatchingAtLeast G (U (f i.castSucc)) (U (f i.succ)) 3 :=
    fun i => hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj (hstep i)
  have hclose' :
      HasCrossMatchingAtLeast G (U (f (Fin.last m))) (U (f 0)) 3 :=
    hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj hclose
  obtain ⟨a, b, ha, hb, hab, hcross, hlast⟩ :=
    exists_distinct_oriented_cyclic_cross_edges G hm
      (fun i => U (f i)) hstep' hclose'
  exact ⟨f, hfinj, a, b, ha, hb, hab, hcross, hlast⟩

/-- The small side of the cross-matching dichotomy, exposed under the
negation of `HasCrossMatchingAtLeast`.  Deleting fewer than `2m` endpoints
makes the two displayed cores anticomplete. -/
theorem exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (A B : Finset V) (m : ℕ)
    (hsmall : ¬ HasCrossMatchingAtLeast G A B m) :
    ∃ X : Finset V, X.card < 2 * m ∧
      ∀ a ∈ A \ X, ∀ b ∈ B \ X, ¬ G.Adj a b := by
  rcases exists_crossMatching_or_small_cross_vertexCover G A B m with
    hlarge | hcover
  · exact (hsmall hlarge).elim
  · exact hcover

/-- Simultaneous cleanup of every ordered hub pair that is not a
large-cross-matching edge.  The deliberately simple square bound is enough
for later parameter arithmetic; its key structural conclusion is that every
surviving cross-edge must lie inside one component of the large-matching
auxiliary graph. -/
theorem exists_global_exceptional_set_of_not_hasCrossMatchingAtLeast
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (U : ι → Finset V) (m : ℕ) :
    ∃ X : Finset V,
      X.card ≤ 2 * m * Fintype.card ι * Fintype.card ι ∧
      ∀ i j : ι, i ≠ j →
        ¬ HasCrossMatchingAtLeast G (U i) (U j) m →
        ∀ a ∈ U i \ X, ∀ b ∈ U j \ X, ¬ G.Adj a b := by
  classical
  let cover : ι × ι → Finset V := fun q =>
    if hq : q.1 ≠ q.2 ∧
        ¬ HasCrossMatchingAtLeast G (U q.1) (U q.2) m then
      Classical.choose
        (exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
          G (U q.1) (U q.2) m hq.2)
    else ∅
  let Q : Finset (ι × ι) := Finset.univ
  let X : Finset V := Q.biUnion cover
  have hcoverCard : ∀ q ∈ Q, (cover q).card ≤ 2 * m := by
    intro q _hq
    by_cases hcond : q.1 ≠ q.2 ∧
        ¬ HasCrossMatchingAtLeast G (U q.1) (U q.2) m
    · simp only [cover, dif_pos hcond]
      exact Nat.le_of_lt (Classical.choose_spec
        (exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
          G (U q.1) (U q.2) m hcond.2)).1
    · simp [cover, hcond]
  have hXcard : X.card ≤ Q.card * (2 * m) :=
    Finset.card_biUnion_le_card_mul _ _ _ hcoverCard
  refine ⟨X, ?_, ?_⟩
  · calc
      X.card ≤ Q.card * (2 * m) := hXcard
      _ = 2 * m * Fintype.card ι * Fintype.card ι := by
        simp [Q, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
  · intro i j hij hsmall a ha b hb
    have hcond : i ≠ j ∧
        ¬ HasCrossMatchingAtLeast G (U i) (U j) m := ⟨hij, hsmall⟩
    have hqmem : (i, j) ∈ Q := Finset.mem_univ _
    have hcoverSub : cover (i, j) ⊆ X :=
      Finset.subset_biUnion_of_mem cover hqmem
    have ha' := Finset.mem_sdiff.mp ha
    have hb' := Finset.mem_sdiff.mp hb
    have haCover : a ∉ cover (i, j) := fun hac => ha'.2 (hcoverSub hac)
    have hbCover : b ∉ cover (i, j) := fun hbc => hb'.2 (hcoverSub hbc)
    have hlocal : ∀ x ∈ U i \ cover (i, j),
        ∀ y ∈ U j \ cover (i, j), ¬ G.Adj x y := by
      simp only [cover, dif_pos hcond]
      exact (Classical.choose_spec
        (exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
          G (U i) (U j) m hsmall)).2
    exact hlocal a (Finset.mem_sdiff.mpr ⟨ha'.1, haCover⟩)
      b (Finset.mem_sdiff.mpr ⟨hb'.1, hbCover⟩)

/-- Component form of the preceding cleanup.  After the same bounded
deletion, unions of trimmed cores belonging to distinct connected components
of the large-matching graph are anticomplete in the ambient graph. -/
theorem exists_exceptional_set_separating_largeCrossMatching_components
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (U : ι → Finset V) (m : ℕ) :
    let H : SimpleGraph ι := LargeCrossMatchingGraph G U m
    ∃ X : Finset V,
      X.card ≤ 2 * m * Fintype.card ι * Fintype.card ι ∧
      ∀ c d : H.ConnectedComponent, c ≠ d →
        ∀ i ∈ c.supp, ∀ j ∈ d.supp,
          ∀ a ∈ U i \ X, ∀ b ∈ U j \ X, ¬ G.Adj a b := by
  classical
  let H : SimpleGraph ι := LargeCrossMatchingGraph G U m
  obtain ⟨X, hXcard, hclean⟩ :=
    exists_global_exceptional_set_of_not_hasCrossMatchingAtLeast G U m
  refine ⟨X, hXcard, ?_⟩
  intro c d hcd i hic j hjd
  have hij : i ≠ j := by
    intro h
    subst j
    exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hic hjd)
  have hsmall : ¬ HasCrossMatchingAtLeast G (U i) (U j) m := by
    intro hlarge
    have hAdj : H.Adj i j := by
      change (LargeCrossMatchingGraph G U m).Adj i j
      rw [LargeCrossMatchingGraph, SimpleGraph.fromRel_adj]
      exact ⟨hij, Or.inl hlarge⟩
    have hci : H.connectedComponentMk i = c :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff c i).mp hic
    have hdj : H.connectedComponentMk j = d :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff d j).mp hjd
    apply hcd
    rw [← hci, ← hdj]
    exact SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hAdj
  exact hclean i j hij hsmall

/-- A parity-unbroken finite core has a four-vertex cover of all its internal
edges.  Choose a maximum disjoint-edge family; if it had three members it
would itself be a parity witness, while maximality makes the complement of
its at most four endpoints independent. -/
theorem exists_four_vertexCover_with_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V) (S : Finset V)
    (hnot : ¬ HasThreeDisjointAdjPairFamily G S) :
    ∃ F : Finset V, F ⊆ S ∧ F.card ≤ 4 ∧
      G.IsIndepSet ((S \ F : Finset V) : Set V) := by
  classical
  obtain ⟨M, hM, hMS, hmax⟩ :=
    exists_maximal_disjointAdjPairFamily_in_finset G S
  let F : Finset V := M.biUnion fun e => {e.1, e.2}
  have hMcard : M.card ≤ 2 := by
    by_contra h
    apply hnot
    exact ⟨M, hM, by omega, hMS⟩
  have hFsub : F ⊆ S := by
    intro v hv
    rcases Finset.mem_biUnion.mp hv with ⟨e, he, hve⟩
    have heS := hMS e he
    simp only [Finset.mem_insert, Finset.mem_singleton] at hve
    rcases hve with rfl | rfl
    · exact heS.1
    · exact heS.2
  have hFcard : F.card ≤ M.card * 2 := by
    dsimp [F]
    apply Finset.card_biUnion_le_card_mul
    intro e _he
    exact Finset.card_le_two
  refine ⟨F, hFsub, ?_, ?_⟩
  · omega
  · exact isIndepSet_sdiff_endpointCover_of_maximal_disjointAdjPairFamily
      G S M hM hMS hmax

/-- Quantitative parity-unbroken remainder: after deleting at most four
vertices, an independent subset retaining at least |S| - 4 vertices remains
inside the original core. -/
theorem exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V) (S : Finset V)
    (hnot : ¬ HasThreeDisjointAdjPairFamily G S) :
    ∃ I : Finset V, I ⊆ S ∧ G.IsIndepSet (I : Set V) ∧
      S.card - 4 ≤ I.card := by
  obtain ⟨F, hFS, hFcard, hInd⟩ :=
    exists_four_vertexCover_with_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
      G S hnot
  refine ⟨S \ F, Finset.sdiff_subset, hInd, ?_⟩
  exact sub_le_card_sdiff_of_le_card_of_card_le le_rfl hFcard

/-- Global counting form of the parity-unbroken branch.  From every
parity-unbroken anticomplete region remove at most four matching endpoints;
the retained pieces are still disjoint and their union is independent, so
the sum of the retained lower bounds is smaller than n. -/
theorem sum_card_sub_four_lt_of_disjoint_pairwiseAnticomplete_not_hasThree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hnot : ∀ S ∈ F, ¬ HasThreeDisjointAdjPairFamily G S) :
    ∑ S ∈ F, (S.card - 4) < n := by
  classical
  let I : Finset V → Finset V := fun S =>
    if hS : S ∈ F then
      Classical.choose
        (exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
          G S (hnot S hS))
    else ∅
  have hI : ∀ S ∈ F, I S ⊆ S ∧ G.IsIndepSet (I S : Set V) ∧
      S.card - 4 ≤ (I S).card := by
    intro S hS
    simp only [I, dif_pos hS]
    exact Classical.choose_spec
      (exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
        G S (hnot S hS))
  have hpair : (F : Set (Finset V)).PairwiseDisjoint I := by
    intro S hS T hT hST
    exact (hdisj S (by simpa using hS) T (by simpa using hT) hST).mono
      (hI S (by simpa using hS)).1 (hI T (by simpa using hT)).1
  have hUnionInd : G.IsIndepSet ((F.biUnion I : Finset V) : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_biUnion.mp ha with ⟨S, hS, haS⟩
    rcases Finset.mem_biUnion.mp hb with ⟨T, hT, hbT⟩
    by_cases hST : S = T
    · subst T
      have hSI := (hI S hS).2.1
      rw [SimpleGraph.isIndepSet_iff] at hSI
      exact hSI haS hbT hab
    · exact hanti S hS T hT hST a ((hI S hS).1 haS)
        b ((hI T hT).1 hbT)
  have hsumI :
      (F.biUnion I).card = ∑ S ∈ F, (I S).card := by
    simpa using Finset.card_biUnion hpair
  calc
    ∑ S ∈ F, (S.card - 4) ≤ ∑ S ∈ F, (I S).card := by
      apply Finset.sum_le_sum
      intro S hS
      exact (hI S hS).2.2
    _ = (F.biUnion I).card := hsumI.symm
    _ < n := Erdos551.IndepSetFree.card_lt hfree hUnionInd

/-- If every parity-unbroken anticomplete core has order at least tau, the
preceding independent-remnant count bounds the number of such cores by
(tau - 4) times the family cardinality. -/
theorem mul_card_sub_four_lt_of_disjoint_pairwiseAnticomplete_not_hasThree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} {n τ : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    (hnot : ∀ S ∈ F, ¬ HasThreeDisjointAdjPairFamily G S)
    (hcard : ∀ S ∈ F, τ ≤ S.card) :
    (τ - 4) * F.card < n := by
  have hsum :=
    sum_card_sub_four_lt_of_disjoint_pairwiseAnticomplete_not_hasThree
      G hfree hdisj hanti hnot
  have hle : (τ - 4) * F.card ≤ ∑ S ∈ F, (S.card - 4) := by
    calc
      (τ - 4) * F.card = ∑ _S ∈ F, (τ - 4) := by
        simp [Nat.mul_comm]
      _ ≤ ∑ S ∈ F, (S.card - 4) := by
        apply Finset.sum_le_sum
        intro S hS
        have := hcard S hS
        omega
  exact hle.trans_lt hsum

/-- A large robust reservoir in an independent-set-free graph contains an
internal parity-breaking edge away from any prescribed endpoints.  The even
route handles even lengths, while the odd route through that edge handles
odd lengths.  Consequently every length at least five up to the visible
reservoir and common-neighbour budgets is available. -/
theorem exists_path_between_of_large_robustPairSet
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n ℓ : ℕ} (hrob : RobustPairSet G U T θ)
    (hfree : G.IndepSetFree n) (hUn : n + 2 ≤ U.card)
    {a b : V} (haU : a ∈ U) (hbU : b ∈ U) (hab : a ≠ b)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U.card) (hℓθ : ℓ + 1 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = ℓ ∧
      ∀ v ∈ p.support, v ∈ U ∨ v ∈ T := by
  classical
  by_cases heven : ℓ % 2 = 0
  · let r : ℕ := ℓ / 2 - 1
    have hlen : 2 * (r + 1) = ℓ := by
      dsimp [r]
      omega
    have hUcard : r + 2 ≤ U.card := by
      dsimp [r]
      omega
    have hbudget : 2 * (r + 1) + 1 ≤ θ := by
      rw [hlen]
      exact hℓθ
    obtain ⟨p, hp, hplen, _hpavoid, hploc⟩ :=
      exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := r)
        hrob haU hbU (by simp) (by simp) hab (by simpa) (by simpa using hbudget)
    exact ⟨p, hp, by omega, hploc⟩
  · have hodd : ℓ % 2 = 1 := by omega
    let r : ℕ := (ℓ - 5) / 2
    have hlen : 2 * r + 5 = ℓ := by
      dsimp [r]
      omega
    let W : Finset V := (U.erase a).erase b
    have hbErase : b ∈ U.erase a := Finset.mem_erase.mpr ⟨hab.symm, hbU⟩
    have hWcard : n ≤ W.card := by
      simp only [W, Finset.card_erase_of_mem hbErase, Finset.card_erase_of_mem haU]
      omega
    obtain ⟨x, hxW, y, hyW, hxy⟩ :=
      exists_adj_in_finset_of_indepSetFree hfree hWcard
    have hxerase := Finset.mem_erase.mp hxW
    have hyerase := Finset.mem_erase.mp hyW
    have hxU : x ∈ U := (Finset.mem_erase.mp hxerase.2).2
    have hyU : y ∈ U := (Finset.mem_erase.mp hyerase.2).2
    have hax : a ≠ x := (Finset.mem_erase.mp hxerase.2).1.symm
    have hay : a ≠ y := (Finset.mem_erase.mp hyerase.2).1.symm
    have hxb : x ≠ b := hxerase.1
    have hyb : y ≠ b := hyerase.1
    have hUcard : 2 * r + 0 + 5 ≤ U.card := by
      rw [hlen]
      exact hℓU
    have hbudget : 2 * r + 2 * 0 + 6 ≤ θ := by
      rw [show 2 * r + 2 * 0 + 6 = ℓ + 1 by omega]
      exact hℓθ
    obtain ⟨p, hp, hplen, hploc⟩ :=
      exists_odd_path_between_of_robustPairSet_and_edge G (r := r) (s := 0)
        hrob haU hxU hyU hbU hxy hax hay hab hxb hyb hUcard hbudget
    exact ⟨p, hp, by omega, hploc⟩

/-- Source-faithful all-parity routing interface for a parity-broken hub.
Unlike the preceding convenience lemma, this one does not ask the hub to be
larger than n: it takes the parity-breaking internal edge explicitly, exactly
as supplied by the matching in the KLS stability argument. -/
theorem exists_path_between_of_robustPairSet_and_parity_edge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ ℓ : ℕ} (hrob : RobustPairSet G U T θ)
    {a x y b : V} (haU : a ∈ U) (hxU : x ∈ U) (hyU : y ∈ U) (hbU : b ∈ U)
    (hxy : G.Adj x y) (hax : a ≠ x) (hay : a ≠ y) (hab : a ≠ b)
    (hxb : x ≠ b) (hyb : y ≠ b)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U.card) (hℓθ : ℓ + 1 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = ℓ ∧
      ∀ v ∈ p.support, v ∈ U ∨ v ∈ T := by
  classical
  by_cases heven : ℓ % 2 = 0
  · let r : ℕ := ℓ / 2 - 1
    have hlen : 2 * (r + 1) = ℓ := by
      dsimp [r]
      omega
    have hUcard : r + 2 ≤ U.card := by
      dsimp [r]
      omega
    have hbudget : 2 * (r + 1) + 1 ≤ θ := by
      rw [hlen]
      exact hℓθ
    obtain ⟨p, hp, hplen, _hpavoid, hploc⟩ :=
      exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := r)
        hrob haU hbU (by simp) (by simp) hab (by simpa) (by simpa using hbudget)
    exact ⟨p, hp, by omega, hploc⟩
  · have hodd : ℓ % 2 = 1 := by omega
    let r : ℕ := (ℓ - 5) / 2
    have hlen : 2 * r + 5 = ℓ := by
      dsimp [r]
      omega
    have hUcard : 2 * r + 0 + 5 ≤ U.card := by
      rw [hlen]
      exact hℓU
    have hbudget : 2 * r + 2 * 0 + 6 ≤ θ := by
      rw [show 2 * r + 2 * 0 + 6 = ℓ + 1 by omega]
      exact hℓθ
    obtain ⟨p, hp, hplen, hploc⟩ :=
      exists_odd_path_between_of_robustPairSet_and_edge G (r := r) (s := 0)
        hrob haU hxU hyU hbU hxy hax hay hab hxb hyb hUcard hbudget
    exact ⟨p, hp, by omega, hploc⟩

/-- Avoiding all-parity route from an explicit internal edge.  Simultaneously
delete the forbidden set from the core and target reservoir; robustness drops
by at most its cardinality, after which the ordinary parity-route theorem
applies unchanged. -/
theorem exists_path_between_of_robustPairSet_and_parity_edge_avoiding
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T F : Finset V} {θ ℓ : ℕ} (hrob : RobustPairSet G U T θ)
    {a x y b : V} (haU : a ∈ U) (hxU : x ∈ U) (hyU : y ∈ U) (hbU : b ∈ U)
    (haF : a ∉ F) (hxF : x ∉ F) (hyF : y ∉ F) (hbF : b ∉ F)
    (hxy : G.Adj x y) (hax : a ≠ x) (hay : a ≠ y) (hab : a ≠ b)
    (hxb : x ≠ b) (hyb : y ≠ b)
    (hℓ : 5 ≤ ℓ) (hℓU : F.card + ℓ ≤ U.card)
    (hℓθ : F.card + ℓ + 1 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = ℓ ∧
      (∀ v ∈ p.support, v ∉ F) ∧
      ∀ v ∈ p.support, v ∈ U ∨ v ∈ T := by
  have hrob' : RobustPairSet G (U \ F) (T \ F) (θ - F.card) := hrob.sdiff
  have hU' : ℓ ≤ (U \ F).card := by
    have hbase : ℓ ≤ U.card - F.card := by omega
    have hret : U.card - F.card ≤ (U \ F).card :=
      sub_le_card_sdiff_of_le_card_of_card_le le_rfl le_rfl
    exact hbase.trans hret
  have hθ' : ℓ + 1 ≤ θ - F.card := by omega
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge G hrob'
      (Finset.mem_sdiff.mpr ⟨haU, haF⟩)
      (Finset.mem_sdiff.mpr ⟨hxU, hxF⟩)
      (Finset.mem_sdiff.mpr ⟨hyU, hyF⟩)
      (Finset.mem_sdiff.mpr ⟨hbU, hbF⟩)
      hxy hax hay hab hxb hyb hℓ hU' hθ'
  refine ⟨p, hp, hplen, ?_, ?_⟩
  · intro v hv
    rcases hploc v hv with hv | hv
    · exact (Finset.mem_sdiff.mp hv).2
    · exact (Finset.mem_sdiff.mp hv).2
  · intro v hv
    rcases hploc v hv with hv | hv
    · exact Or.inl (Finset.mem_sdiff.mp hv).1
    · exact Or.inr (Finset.mem_sdiff.mp hv).1

/-- One parity-breaking edge inside a robust reservoir converts two
parity-correct two-edge routes into a five-edge simple path.  This is the
local form of the KLS parity-correction move. -/
theorem exists_fiveEdgePath_of_robustPairSet_and_edge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ : ℕ} (hrob : RobustPairSet G U T θ)
    {a x y b : V} (ha : a ∈ U) (hx : x ∈ U) (hy : y ∈ U) (hb : b ∈ U)
    (hxy : G.Adj x y)
    (hax : a ≠ x) (hay : a ≠ y) (hab : a ≠ b)
    (hxyne : x ≠ y) (hxb : x ≠ b) (hyb : y ≠ b)
    (hbudget : ({a, b, x, y} : Finset V).card + 2 ≤ θ) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = 5 := by
  classical
  let left : Fin 2 → V := ![a, y]
  let right : Fin 2 → V := ![x, b]
  have hpairs : ∀ i : Fin 2, θ ≤
      (Erdos163.FiniteDefect.commonNeighbors G ![left i, right i] T).card := by
    intro i
    fin_cases i
    · simpa [left, right] using hrob a ha x hx
    · simpa [left, right] using hrob y hy b hb
  obtain ⟨z, hzinj, hz⟩ := exists_fresh_middle_vertices_fin G left right hpairs hbudget
  let z₀ : V := z 0
  let z₁ : V := z 1
  have hz₀ := hz (0 : Fin 2)
  have hz₁ := hz (1 : Fin 2)
  have hz₀F : z₀ ∉ ({a, b, x, y} : Finset V) := by simpa [z₀] using hz₀.2.1
  have hz₁F : z₁ ∉ ({a, b, x, y} : Finset V) := by simpa [z₁] using hz₁.2.1
  have hz₀z₁ : z₀ ≠ z₁ := by
    intro h
    exact Fin.zero_ne_one (hzinj h)
  have haz₀ : G.Adj a z₀ := by simpa [left, z₀] using hz₀.2.2.1
  have hz₀x : G.Adj z₀ x := by simpa [right, z₀] using hz₀.2.2.2
  have hyz₁ : G.Adj y z₁ := by simpa [left, z₁] using hz₁.2.2.1
  have hz₁b : G.Adj z₁ b := by simpa [right, z₁] using hz₁.2.2.2
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hz₀F hz₁F
  have hz₀a : z₀ ≠ a := hz₀F.1
  have hz₀b : z₀ ≠ b := hz₀F.2.1
  have hz₀xne : z₀ ≠ x := hz₀F.2.2.1
  have hz₀y : z₀ ≠ y := hz₀F.2.2.2
  have hz₁a : z₁ ≠ a := hz₁F.1
  have hz₁bne : z₁ ≠ b := hz₁F.2.1
  have hz₁x : z₁ ≠ x := hz₁F.2.2.1
  have hz₁y : z₁ ≠ y := hz₁F.2.2.2
  let p : G.Walk a b := Walk.cons haz₀ <|
    Walk.cons hz₀x <| Walk.cons hxy <| Walk.cons hyz₁ <| Walk.cons hz₁b Walk.nil
  refine ⟨p, ?_, ?_⟩
  · simp [p, Walk.cons_isPath_iff, hax, hay, hab, hxyne, hxb, hyb,
      hz₀a, hz₀a.symm, hz₀b, hz₀b.symm, hz₀xne, hz₀xne.symm,
      hz₀y, hz₀y.symm, hz₁a, hz₁a.symm, hz₁bne, hz₁bne.symm,
      hz₁x, hz₁x.symm, hz₁y, hz₁y.symm, hz₀z₁, hz₀z₁.symm]
  · simp [p]

/-- A robust reservoir containing at least `n+2` vertices automatically has
enough room to find a parity-breaking edge away from any two prescribed
endpoints.  Thus every distinct endpoint pair has a simple five-edge route
once the common-neighborhood budget is at least six. -/
theorem exists_fiveEdgePath_of_large_robustPairSet
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n : ℕ} (hrob : RobustPairSet G U T θ)
    (hfree : G.IndepSetFree n) (hUcard : n + 2 ≤ U.card) (hθ : 6 ≤ θ)
    {a b : V} (ha : a ∈ U) (hb : b ∈ U) (hab : a ≠ b) :
    ∃ p : G.Walk a b, p.IsPath ∧ p.length = 5 := by
  classical
  let W : Finset V := (U.erase a).erase b
  have hb' : b ∈ U.erase a := Finset.mem_erase.mpr ⟨hab.symm, hb⟩
  have hWcard : n ≤ W.card := by
    simp only [W, Finset.card_erase_of_mem hb', Finset.card_erase_of_mem ha]
    omega
  obtain ⟨x, hxW, y, hyW, hxy⟩ := exists_adj_in_finset_of_indepSetFree hfree hWcard
  have hxerase := Finset.mem_erase.mp hxW
  have hyerase := Finset.mem_erase.mp hyW
  have hxU : x ∈ U := (Finset.mem_erase.mp hxerase.2).2
  have hyU : y ∈ U := (Finset.mem_erase.mp hyerase.2).2
  have hax : a ≠ x := (Finset.mem_erase.mp hxerase.2).1.symm
  have hay : a ≠ y := (Finset.mem_erase.mp hyerase.2).1.symm
  have hxb : x ≠ b := hxerase.1
  have hyb : y ≠ b := hyerase.1
  have hbudget : ({a, b, x, y} : Finset V).card + 2 ≤ θ := by
    have hfour : ({a, b, x, y} : Finset V).card ≤ 4 := Finset.card_le_four
    omega
  exact exists_fiveEdgePath_of_robustPairSet_and_edge G hrob ha hxU hyU hb hxy
    hax hay hab hxy.ne hxb hyb hbudget

/-- Closing a simple `a`--`b` path by a fresh common neighbor of its
endpoints produces a genuine simple cycle.  This is the elementary cycle
assembly step behind the later absorption argument. -/
theorem cycleGraph_isContained_of_path_and_fresh_commonNeighbor
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) {a b z : V} {p : G.Walk a b}
    (hp : p.IsPath) (hlen : p.length + 2 = k)
    (haz : G.Adj a z) (hzb : G.Adj z b) (hz : z ∉ p.support) :
    cycleGraph k ⊑ G := by
  let c : G.Walk a a := Walk.cons haz (Walk.cons hzb p.reverse)
  have htail : c.tail.IsPath := by
    simp [c, Walk.cons_isPath_iff, hp.reverse, Walk.support_reverse, hz]
  have hclen : c.length = k := by
    simp only [c, Walk.length_cons, Walk.length_reverse]
    omega
  have hcycle : c.IsCycle := by
    rw [Walk.isCycle_iff_isPath_tail_and_le_length]
    exact ⟨htail, by rw [hclen]; exact hk⟩
  rw [SimpleGraph.cycleGraph_isContained_iff (by omega)]
  exact ⟨a, c, hcycle, hclen⟩

/-- General handle-closing lemma: two internally disjoint simple paths with
opposite endpoints form an ordinary cycle of the sum of their lengths.  This
is the reusable assembly primitive for BFS detours and later hub handles. -/
theorem cycleGraph_isContained_of_two_disjoint_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) {a b : V}
    {p : G.Walk a b} {q : G.Walk b a}
    (hp : p.IsPath) (hq : q.IsPath)
    (hdisj : p.support.tail.Disjoint q.support.tail)
    (hlong : 1 < p.length ∨ 1 < q.length)
    (hlen : p.length + q.length = k) :
    cycleGraph k ⊑ G := by
  let c : G.Walk a a := p.append q
  have hcycle : c.IsCycle := by
    exact hp.isCycle_append hq hdisj hlong
  have hclen : c.length = k := by
    simp only [c, Walk.length_append]
    exact hlen
  rw [SimpleGraph.cycleGraph_isContained_iff (by omega)]
  exact ⟨a, c, hcycle, hclen⟩

/-- Exact trimming form of the two-path closure.  In the BFS part of the
KLS argument one first constructs a long path `p`, then a return detour from
one chosen vertex of `p` back to its start.  Once the chosen prefix length
and the detour length add to `k`, only that prefix is needed: it and the
detour are the two sides of an ordinary `k`-cycle.  Keeping the prefix index
explicit avoids any interval-cycle weakening at the exact-length handoff. -/
theorem cycleGraph_isContained_of_path_prefix_and_return_detour
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k t : ℕ} (hk : 3 ≤ k) {a b : V} {p : G.Walk a b}
    (hp : p.IsPath) (ht : t ≤ p.length)
    {q : G.Walk (p.getVert t) a} (hq : q.IsPath)
    (hdisj : (p.take t).support.tail.Disjoint q.support.tail)
    (hlen : t + q.length = k) :
    cycleGraph k ⊑ G := by
  have htake : (p.take t).IsPath := hp.take t
  have htakelen : (p.take t).length = t := by
    simp [Walk.take_length, Nat.min_eq_left ht]
  apply cycleGraph_isContained_of_two_disjoint_paths G hk htake hq hdisj
  · by_cases hpt : 1 < t
    · exact Or.inl (by simpa [htakelen] using hpt)
    · right
      omega
  · rw [htakelen]
    exact hlen

/-- Two paths with a common endpoint concatenate to a simple path whenever
the first support is disjoint from the tail of the second support.  This is
the exact support condition produced by two nested BFS trees: the common
endpoint is allowed, while every other tree vertex avoids the retained
middle layer. -/
theorem isPath_append_of_support_disjoint_tail
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {a b c : V} {p : G.Walk a b} {q : G.Walk b c}
    (hp : p.IsPath) (hq : q.IsPath)
    (hdisj : p.support.Disjoint q.support.tail) :
    (p.append q).IsPath := by
  rw [Walk.isPath_def, Walk.support_append, List.nodup_append]
  refine ⟨hp.support_nodup, hq.support_nodup.tail, ?_⟩
  intro x hx y hy hxy
  subst y
  exact hdisj hx hy

/-- Exact three-path BFS splice.  A first detour from a to b, a trimmed
middle path from b to c, and a second detour from c back to a form a cycle
of the sum of their lengths.  The two disjointness hypotheses are stated at
the support-tail level needed by the append and cycle constructors, so later
BFS map-back lemmas can discharge them without rebuilding cycle bookkeeping. -/
theorem cycleGraph_isContained_of_three_path_splice
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) {a b c : V}
    {p : G.Walk a b} {q : G.Walk b c} {r : G.Walk c a}
    (hp : p.IsPath) (hq : q.IsPath) (hr : r.IsPath)
    (hqr : q.support.Disjoint r.support.tail)
    (hps : p.support.tail.Disjoint (q.append r).support.tail)
    (hlen : p.length + q.length + r.length = k) :
    cycleGraph k ⊑ G := by
  have hreturn : (q.append r).IsPath :=
    isPath_append_of_support_disjoint_tail G hq hr hqr
  apply cycleGraph_isContained_of_two_disjoint_paths G hk hp hreturn hps
  · by_cases hpLong : 1 < p.length
    · exact Or.inl hpLong
    · right
      simp only [Walk.length_append]
      omega
  · simp only [Walk.length_append]
    omega

/-- Append two vertex-disjoint paths through one cross-edge.  The only
shared vertex introduced by concatenation is the endpoint where the
cross-edge meets the second path; its tail omits that vertex, so the result
is still a path.  This is the inductive assembly move for cyclic systems of
hubs. -/
theorem isPath_append_cross_of_disjoint_support
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {a b c d : V} {p : G.Walk a b} {q : G.Walk c d}
    (hp : p.IsPath) (hq : q.IsPath) (hdisj : p.support.Disjoint q.support)
    (hbc : G.Adj b c) :
    ((p.concat hbc).append q).IsPath := by
  have hc_not_p : c ∉ p.support := by
    intro hc
    exact hdisj hc q.start_mem_support
  have hp' : (p.concat hbc).IsPath := hp.concat hc_not_p hbc
  have hc_not_tail : c ∉ q.support.tail := by
    have hn := hq.support_nodup
    rw [← q.cons_tail_support] at hn
    exact hn.notMem
  rw [Walk.isPath_def, Walk.support_append, List.nodup_append]
  refine ⟨hp'.support_nodup, hq.support_nodup.tail, ?_⟩
  intro x hx y hy hxy
  subst y
  rw [Walk.support_concat] at hx
  simp only [List.mem_append, List.mem_singleton] at hx
  rcases hx with hxp | rfl
  · exact hdisj hxp (List.mem_of_mem_tail hy)
  · exact hc_not_tail hy

/-- Two disjoint internal paths and two cross-edges form a cycle.  This is
the generic two-hub handle splice: one path is used as the first side, and
the second path together with the two handle edges is the return side. -/
theorem cycleGraph_isContained_of_two_cross_edges_and_disjoint_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k)
    {a b c d : V} {p : G.Walk a b} {q : G.Walk c d}
    (hp : p.IsPath) (hq : q.IsPath) (hab : a ≠ b)
    (hdisj : p.support.Disjoint q.support)
    (hbc : G.Adj b c) (hda : G.Adj d a)
    (hlen : p.length + q.length + 2 = k) :
    cycleGraph k ⊑ G := by
  have ha_not_q : a ∉ q.support := by
    intro ha
    exact hdisj p.start_mem_support ha
  have hb_not_q : b ∉ q.support := by
    intro hb
    exact hdisj p.end_mem_support hb
  let q' : G.Walk c a := q.concat hda
  have hq' : q'.IsPath := hq.concat ha_not_q hda
  have hb_not_q' : b ∉ q'.support := by
    dsimp [q']
    rw [SimpleGraph.Walk.support_concat]
    simp only [List.mem_append, List.mem_singleton]
    intro hb
    rcases hb with hb | hb
    · exact hb_not_q hb
    · exact hab hb.symm
  let r : G.Walk b a := Walk.cons hbc q'
  have hr : r.IsPath := hq'.cons hb_not_q'
  have htail : r.support.tail = q'.support := by
    simp [r]
  have hdisj' : p.support.tail.Disjoint r.support.tail := by
    rw [htail]
    intro v hvp hvq'
    dsimp [q'] at hvq'
    rw [SimpleGraph.Walk.support_concat] at hvq'
    simp only [List.mem_append, List.mem_singleton] at hvq'
    rcases hvq' with hvq | rfl
    · exact hdisj (List.mem_of_mem_tail hvp) hvq
    · have hn := hp.support_nodup
      rw [← p.cons_tail_support] at hn
      exact hn.notMem hvp
  apply cycleGraph_isContained_of_two_disjoint_paths G hk hp hr hdisj'
  · right
    dsimp [r, q']
    simp
  · dsimp [r, q']
    rw [SimpleGraph.Walk.length_concat]
    omega

/-- Three pairwise-disjoint internal paths joined cyclically by three
cross-edges form a prescribed ordinary cycle.  This is the first
multi-hub handle lemma: two of the paths are first spliced into one path,
then the already-proved two-handle closing lemma finishes the cycle. -/
theorem cycleGraph_isContained_of_three_cross_edges_and_disjoint_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k)
    {a₁ b₁ a₂ b₂ a₃ b₃ : V}
    {p : G.Walk a₁ b₁} {q : G.Walk a₂ b₂} {r : G.Walk a₃ b₃}
    (hp : p.IsPath) (hq : q.IsPath) (hr : r.IsPath) (hab₁ : a₁ ≠ b₁)
    (hpq : p.support.Disjoint q.support)
    (hpr : p.support.Disjoint r.support)
    (hqr : q.support.Disjoint r.support)
    (h₁₂ : G.Adj b₁ a₂) (h₂₃ : G.Adj b₂ a₃) (h₃₁ : G.Adj b₃ a₁)
    (hlen : p.length + q.length + r.length + 3 = k) :
    cycleGraph k ⊑ G := by
  let s : G.Walk a₂ b₃ := (q.concat h₂₃).append r
  have hs : s.IsPath := by
    exact isPath_append_cross_of_disjoint_support G hq hr hqr h₂₃
  have hps : p.support.Disjoint s.support := by
    intro x hxp hxs
    dsimp [s] at hxs
    rw [Walk.support_append, Walk.support_concat] at hxs
    simp only [List.mem_append, List.mem_singleton] at hxs
    rcases hxs with hxs | hxs
    · rcases hxs with hxq | rfl
      · exact hpq hxp hxq
      · exact hpr hxp r.start_mem_support
    · exact hpr hxp (List.mem_of_mem_tail hxs)
  apply cycleGraph_isContained_of_two_cross_edges_and_disjoint_paths G hk hp hs hab₁
    hps h₁₂ h₃₁
  dsimp [s]
  rw [Walk.length_append, Walk.length_concat]
  omega

/-- A finite sequence of pairwise-disjoint paths, joined by one cross-edge
between each consecutive pair, concatenates to one simple path.  The support
certificate records that no new vertices appear outside the original path
supports, which is the induction invariant needed for cyclic hub systems. -/
theorem exists_chain_path_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m : ℕ}
    (a b : Fin (m + 1) → V)
    (p : ∀ i : Fin (m + 1), G.Walk (a i) (b i))
    (hp : ∀ i : Fin (m + 1), (p i).IsPath)
    (hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support)
    (hcross : ∀ i : Fin m,
      G.Adj (b i.castSucc) (a i.succ)) :
    ∃ q : G.Walk (a 0) (b (Fin.last m)),
      q.IsPath ∧
      q.length = (∑ i : Fin (m + 1), (p i).length) + m ∧
      ∀ v ∈ q.support, ∃ i : Fin (m + 1), v ∈ (p i).support := by
  induction m with
  | zero =>
      refine ⟨p 0, hp 0, ?_, ?_⟩
      · simp
      · intro v hv
        exact ⟨0, hv⟩
  | succ m ih =>
      let a₀ : Fin (m + 1) → V := fun i => a i.castSucc
      let b₀ : Fin (m + 1) → V := fun i => b i.castSucc
      let p₀ : ∀ i : Fin (m + 1), G.Walk (a₀ i) (b₀ i) :=
        fun i => p i.castSucc
      have hp₀ : ∀ i : Fin (m + 1), (p₀ i).IsPath := by
        intro i
        exact hp i.castSucc
      have hdisj₀ : ∀ i j : Fin (m + 1), i ≠ j →
          (p₀ i).support.Disjoint (p₀ j).support := by
        intro i j hij
        exact hdisj i.castSucc j.castSucc
          (fun h => hij (Fin.castSucc_injective (m + 1) h))
      have hcross₀ : ∀ i : Fin m,
          G.Adj (b₀ i.castSucc) (a₀ i.succ) := by
        intro i
        simpa [a₀, b₀] using hcross i.castSucc
      obtain ⟨q, hq, hqlen, hqsupp⟩ :=
        ih a₀ b₀ p₀ hp₀ hdisj₀ hcross₀
      let r : G.Walk (a (Fin.last (m + 1))) (b (Fin.last (m + 1))) :=
        p (Fin.last (m + 1))
      have hr : r.IsPath := hp (Fin.last (m + 1))
      have hlastCross :
          G.Adj (b₀ (Fin.last m)) (a (Fin.last (m + 1))) := by
        simpa [a₀, b₀] using hcross (Fin.last m)
      have hqr : q.support.Disjoint r.support := by
        intro v hvq hvr
        rcases hqsupp v hvq with ⟨i, hvi⟩
        exact (hdisj i.castSucc (Fin.last (m + 1))
          (Fin.castSucc_ne_last i)) hvi hvr
      let q' : G.Walk (a₀ 0) (b (Fin.last (m + 1))) :=
        (q.concat hlastCross).append r
      have hq' : q'.IsPath := by
        exact isPath_append_cross_of_disjoint_support G hq hr hqr hlastCross
      have hstart : a₀ 0 = a 0 := by
        apply congrArg a
        exact Fin.ext rfl
      let q'' : G.Walk (a 0) (b (Fin.last (m + 1))) :=
        q'.copy hstart rfl
      have hq'' : q''.IsPath := by
        simpa [q''] using hq'
      have hsum :
          (∑ i : Fin (m + 1 + 1), (p i).length) =
            (∑ i : Fin (m + 1), (p i.castSucc).length) +
              (p (Fin.last (m + 1))).length := by
        rw [Fin.sum_univ_castSucc]
      refine ⟨q'', hq'', ?_, ?_⟩
      · dsimp [q'']
        rw [Walk.length_copy]
        dsimp [q']
        rw [Walk.length_append, Walk.length_concat, hqlen]
        rw [hsum]
        simp only [p₀, r]
        omega
      · intro v hv
        dsimp [q''] at hv
        rw [Walk.support_copy] at hv
        dsimp [q'] at hv
        rw [Walk.support_append, Walk.support_concat] at hv
        simp only [List.mem_append, List.mem_singleton] at hv
        rcases hv with (hvq | rfl) | hvr
        · rcases hqsupp v hvq with ⟨i, hvi⟩
          exact ⟨i.castSucc, hvi⟩
        · exact ⟨Fin.last (m + 1), r.start_mem_support⟩
        · exact ⟨Fin.last (m + 1), List.mem_of_mem_tail hvr⟩

/-- Three fresh robust connectors join two disjoint scaffold segments into
one simple prescribed-endpoint path.  This is the cut-and-rejoin primitive
used after deleting two endpoints from an alternating cycle. -/
theorem exists_path_joining_two_disjoint_major_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {A B D : Finset V} {theta : ℕ}
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D) (htheta : 3 ≤ theta)
    {x y u₀ v₀ u₁ v₁ : V}
    (hxA : x ∈ A) (hyA : y ∈ A)
    (hu₀A : u₀ ∈ A) (hv₀A : v₀ ∈ A)
    (hu₁A : u₁ ∈ A) (hv₁A : v₁ ∈ A)
    {p₀ : G.Walk u₀ v₀} {p₁ : G.Walk u₁ v₁}
    (hp₀ : p₀.IsPath) (hp₁ : p₁.IsPath)
    (hpdisj : p₀.support.Disjoint p₁.support)
    (hp₀loc : ∀ w ∈ p₀.support, w ∈ A ∪ B)
    (hp₁loc : ∀ w ∈ p₁.support, w ∈ A ∪ B)
    (hx₀ : x ∉ p₀.support) (hx₁ : x ∉ p₁.support)
    (hy₀ : y ∉ p₀.support) (hy₁ : y ∉ p₁.support)
    (hxy : x ≠ y) :
    ∃ p : G.Walk x y, p.IsPath ∧
      p.length = p₀.length + p₁.length + 6 ∧
      (∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      ∀ w ∈ p.support,
        w = x ∨ w = y ∨ w ∈ p₀.support ∨ w ∈ p₁.support ∨ w ∈ D := by
  classical
  let left : Fin 3 → V := ![x, v₀, v₁]
  let right : Fin 3 → V := ![u₀, u₁, y]
  have hpairs : ∀ i : Fin 3, theta ≤
      (Erdos163.FiniteDefect.commonNeighbors G
        ![left i, right i] D).card := by
    intro i
    fin_cases i
    · simpa [left, right] using hrob x hxA u₀ hu₀A
    · simpa [left, right] using hrob v₀ hv₀A u₁ hu₁A
    · simpa [left, right] using hrob v₁ hv₁A y hyA
  obtain ⟨z, hzinj, hz⟩ :=
    exists_fresh_middle_vertices_fin G left right hpairs
      (F := ∅) (by simpa using htheta)
  let z₀ : V := z 0
  let z₁ : V := z 1
  let z₂ : V := z 2
  have hz₀D : z₀ ∈ D := by simpa [z₀] using (hz (0 : Fin 3)).1
  have hz₁D : z₁ ∈ D := by simpa [z₁] using (hz (1 : Fin 3)).1
  have hz₂D : z₂ ∈ D := by simpa [z₂] using (hz (2 : Fin 3)).1
  have hxz₀ : G.Adj x z₀ := by
    simpa [left, z₀] using (hz (0 : Fin 3)).2.2.1
  have hz₀u₀ : G.Adj z₀ u₀ := by
    simpa [right, z₀] using (hz (0 : Fin 3)).2.2.2
  have hv₀z₁ : G.Adj v₀ z₁ := by
    simpa [left, z₁] using (hz (1 : Fin 3)).2.2.1
  have hz₁u₁ : G.Adj z₁ u₁ := by
    simpa [right, z₁] using (hz (1 : Fin 3)).2.2.2
  have hv₁z₂ : G.Adj v₁ z₂ := by
    simpa [left, z₂] using (hz (2 : Fin 3)).2.2.1
  have hz₂y : G.Adj z₂ y := by
    simpa [right, z₂] using (hz (2 : Fin 3)).2.2.2
  have hDnotMajor : ∀ z ∈ D, z ∉ A ∪ B := by
    intro z hzD hzMajor
    exact (Finset.disjoint_left.mp hmajorD) hzMajor hzD
  have hz₀p₀ : z₀ ∉ p₀.support := fun h =>
    hDnotMajor z₀ hz₀D (hp₀loc z₀ h)
  have hz₀p₁ : z₀ ∉ p₁.support := fun h =>
    hDnotMajor z₀ hz₀D (hp₁loc z₀ h)
  have hz₁p₀ : z₁ ∉ p₀.support := fun h =>
    hDnotMajor z₁ hz₁D (hp₀loc z₁ h)
  have hz₁p₁ : z₁ ∉ p₁.support := fun h =>
    hDnotMajor z₁ hz₁D (hp₁loc z₁ h)
  have hz₂p₀ : z₂ ∉ p₀.support := fun h =>
    hDnotMajor z₂ hz₂D (hp₀loc z₂ h)
  have hz₂p₁ : z₂ ∉ p₁.support := fun h =>
    hDnotMajor z₂ hz₂D (hp₁loc z₂ h)
  have hz₀x : z₀ ≠ x := by
    intro h
    exact hDnotMajor z₀ hz₀D (h ▸ Finset.mem_union_left B hxA)
  have hz₀y : z₀ ≠ y := by
    intro h
    exact hDnotMajor z₀ hz₀D (h ▸ Finset.mem_union_left B hyA)
  have hz₁x : z₁ ≠ x := by
    intro h
    exact hDnotMajor z₁ hz₁D (h ▸ Finset.mem_union_left B hxA)
  have hz₁y : z₁ ≠ y := by
    intro h
    exact hDnotMajor z₁ hz₁D (h ▸ Finset.mem_union_left B hyA)
  have hz₂x : z₂ ≠ x := by
    intro h
    exact hDnotMajor z₂ hz₂D (h ▸ Finset.mem_union_left B hxA)
  have hz₂yNe : z₂ ≠ y := by
    intro h
    exact hDnotMajor z₂ hz₂D (h ▸ Finset.mem_union_left B hyA)
  have hz₀₁ : z₀ ≠ z₁ := by
    intro h
    exact Fin.zero_ne_one (hzinj h)
  have hz₀₂ : z₀ ≠ z₂ := by
    intro h
    have : (0 : Fin 3) = 2 := hzinj h
    omega
  have hz₁₂ : z₁ ≠ z₂ := by
    intro h
    have : (1 : Fin 3) = 2 := hzinj h
    omega
  let W : Fin 7 → (Σ u v : V, G.Walk u v) :=
    ![⟨x, x, Walk.nil⟩, ⟨z₀, z₀, Walk.nil⟩, ⟨u₀, v₀, p₀⟩,
      ⟨z₁, z₁, Walk.nil⟩, ⟨u₁, v₁, p₁⟩,
      ⟨z₂, z₂, Walk.nil⟩, ⟨y, y, Walk.nil⟩]
  let start : Fin 7 → V := fun i => (W i).1
  let finish : Fin 7 → V := fun i => (W i).2.1
  let route : ∀ i : Fin 7, G.Walk (start i) (finish i) :=
    fun i => (W i).2.2
  have hroute : ∀ i : Fin 7, (route i).IsPath := by
    intro i
    fin_cases i <;> simp [route, start, finish, W, hp₀, hp₁]
  have hrdisj : ∀ i j : Fin 7, i ≠ j →
      (route i).support.Disjoint (route j).support := by
    intro i j hij
    fin_cases i <;> fin_cases j
    all_goals first
      | exact (hij rfl).elim
      | simp [route, start, finish, W,
          List.disjoint_cons_left, List.disjoint_cons_right,
          hpdisj, hpdisj.symm, hx₀, hx₁, hy₀, hy₁,
          hz₀p₀, hz₀p₁, hz₁p₀, hz₁p₁, hz₂p₀, hz₂p₁,
          hxy, hxy.symm, hz₀x, hz₀x.symm, hz₀y, hz₀y.symm,
          hz₁x, hz₁x.symm, hz₁y, hz₁y.symm,
          hz₂x, hz₂x.symm, hz₂yNe, hz₂yNe.symm,
          hz₀₁, hz₀₁.symm, hz₀₂, hz₀₂.symm, hz₁₂, hz₁₂.symm]
  have hcross : ∀ i : Fin 6,
      G.Adj (finish i.castSucc) (start i.succ) := by
    intro i
    fin_cases i
    · simpa [start, finish, W] using hxz₀
    · simpa [start, finish, W] using hz₀u₀
    · simpa [start, finish, W] using hv₀z₁
    · simpa [start, finish, W] using hz₁u₁
    · simpa [start, finish, W] using hv₁z₂
    · simpa [start, finish, W] using hz₂y
  obtain ⟨p, hp, hplen, hpsupp⟩ :=
    exists_chain_path_fin G start finish route hroute hrdisj hcross
  have hstart : start 0 = x := by simp [start, W]
  have hend : finish (Fin.last 6) = y := by simp [finish, W]
  let p' : G.Walk x y := p.copy hstart hend
  refine ⟨p', by simpa [p'] using hp, ?_, ?_, ?_⟩
  · rw [show p'.length = p.length by simp [p']]
    rw [hplen]
    simp [Fin.sum_univ_succ, route, start, finish, W]
  · intro w hw
    have hwp : w ∈ p.support := by simpa [p'] using hw
    rcases hpsupp w hwp with ⟨i, hi⟩
    fin_cases i
    · left
      have : w = x := by simpa [route, start, finish, W] using hi
      simpa [this] using Finset.mem_union_left B hxA
    · right
      have : w = z₀ := by simpa [route, start, finish, W] using hi
      simpa [this] using hz₀D
    · left
      exact hp₀loc w (by simpa [route, start, finish, W] using hi)
    · right
      have : w = z₁ := by simpa [route, start, finish, W] using hi
      simpa [this] using hz₁D
    · left
      exact hp₁loc w (by simpa [route, start, finish, W] using hi)
    · right
      have : w = z₂ := by simpa [route, start, finish, W] using hi
      simpa [this] using hz₂D
    · left
      have : w = y := by simpa [route, start, finish, W] using hi
      simpa [this] using Finset.mem_union_left B hyA
  · intro w hw
    have hwp : w ∈ p.support := by simpa [p'] using hw
    rcases hpsupp w hwp with ⟨i, hi⟩
    fin_cases i
    · left
      simpa [route, start, finish, W] using hi
    · right; right; right; right
      have : w = z₀ := by simpa [route, start, finish, W] using hi
      simpa [this] using hz₀D
    · right; right; left
      simpa [route, start, finish, W] using hi
    · right; right; right; right
      have : w = z₁ := by simpa [route, start, finish, W] using hi
      simpa [this] using hz₁D
    · right; right; right; left
      simpa [route, start, finish, W] using hi
    · right; right; right; right
      have : w = z₂ := by simpa [route, start, finish, W] using hi
      simpa [this] using hz₂D
    · right; left
      simpa [route, start, finish, W] using hi

/-- Five fresh robust connectors join four pairwise-disjoint major paths
into one prescribed-endpoint path.  This fixed four-arc splice is the local
operation obtained after deleting four attachment vertices from an
alternating scaffold. -/
theorem exists_path_joining_four_disjoint_major_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {A B D : Finset V} {theta : ℕ}
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D) (htheta : 5 ≤ theta)
    {x y u₀ v₀ u₁ v₁ u₂ v₂ u₃ v₃ : V}
    (hxA : x ∈ A) (hyA : y ∈ A)
    (hu₀A : u₀ ∈ A) (hv₀A : v₀ ∈ A)
    (hu₁A : u₁ ∈ A) (hv₁A : v₁ ∈ A)
    (hu₂A : u₂ ∈ A) (hv₂A : v₂ ∈ A)
    (hu₃A : u₃ ∈ A) (hv₃A : v₃ ∈ A)
    {p₀ : G.Walk u₀ v₀} {p₁ : G.Walk u₁ v₁}
    {p₂ : G.Walk u₂ v₂} {p₃ : G.Walk u₃ v₃}
    (hp₀ : p₀.IsPath) (hp₁ : p₁.IsPath)
    (hp₂ : p₂.IsPath) (hp₃ : p₃.IsPath)
    (hp₀₁ : p₀.support.Disjoint p₁.support)
    (hp₀₂ : p₀.support.Disjoint p₂.support)
    (hp₀₃ : p₀.support.Disjoint p₃.support)
    (hp₁₂ : p₁.support.Disjoint p₂.support)
    (hp₁₃ : p₁.support.Disjoint p₃.support)
    (hp₂₃ : p₂.support.Disjoint p₃.support)
    (hp₀loc : ∀ w ∈ p₀.support, w ∈ A ∪ B)
    (hp₁loc : ∀ w ∈ p₁.support, w ∈ A ∪ B)
    (hp₂loc : ∀ w ∈ p₂.support, w ∈ A ∪ B)
    (hp₃loc : ∀ w ∈ p₃.support, w ∈ A ∪ B)
    (hx₀ : x ∉ p₀.support) (hx₁ : x ∉ p₁.support)
    (hx₂ : x ∉ p₂.support) (hx₃ : x ∉ p₃.support)
    (hy₀ : y ∉ p₀.support) (hy₁ : y ∉ p₁.support)
    (hy₂ : y ∉ p₂.support) (hy₃ : y ∉ p₃.support)
    (hxy : x ≠ y) :
    ∃ p : G.Walk x y, p.IsPath ∧
      p.length = p₀.length + p₁.length + p₂.length + p₃.length + 10 ∧
      (∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      ∀ w ∈ p.support, w = x ∨ w = y ∨
        w ∈ p₀.support ∨ w ∈ p₁.support ∨ w ∈ p₂.support ∨
        w ∈ p₃.support ∨ w ∈ D := by
  classical
  let left : Fin 5 → V := ![x, v₀, v₁, v₂, v₃]
  let right : Fin 5 → V := ![u₀, u₁, u₂, u₃, y]
  have hpairs : ∀ i : Fin 5, theta ≤
      (Erdos163.FiniteDefect.commonNeighbors G
        ![left i, right i] D).card := by
    intro i
    fin_cases i
    · simpa [left, right] using hrob x hxA u₀ hu₀A
    · simpa [left, right] using hrob v₀ hv₀A u₁ hu₁A
    · simpa [left, right] using hrob v₁ hv₁A u₂ hu₂A
    · simpa [left, right] using hrob v₂ hv₂A u₃ hu₃A
    · simpa [left, right] using hrob v₃ hv₃A y hyA
  obtain ⟨z, hzinj, hz⟩ :=
    exists_fresh_middle_vertices_fin G left right hpairs
      (F := ∅) (by simpa using htheta)
  have hzD : ∀ i : Fin 5, z i ∈ D := by
    intro i
    exact (hz i).1
  have hDnotMajor : ∀ a ∈ D, a ∉ A ∪ B := by
    intro a haD haMajor
    exact (Finset.disjoint_left.mp hmajorD) haMajor haD
  have hzPath : ∀ i : Fin 5, z i ∉ p₀.support ∧
      z i ∉ p₁.support ∧ z i ∉ p₂.support ∧
      z i ∉ p₃.support := by
    intro i
    exact ⟨fun h => hDnotMajor (z i) (hzD i) (hp₀loc _ h),
      fun h => hDnotMajor (z i) (hzD i) (hp₁loc _ h),
      fun h => hDnotMajor (z i) (hzD i) (hp₂loc _ h),
      fun h => hDnotMajor (z i) (hzD i) (hp₃loc _ h)⟩
  have hzX : ∀ i : Fin 5, z i ≠ x := by
    intro i h
    exact hDnotMajor (z i) (hzD i)
      (h ▸ Finset.mem_union_left B hxA)
  have hzY : ∀ i : Fin 5, z i ≠ y := by
    intro i h
    exact hDnotMajor (z i) (hzD i)
      (h ▸ Finset.mem_union_left B hyA)
  have hzNe : ∀ i j : Fin 5, i ≠ j → z i ≠ z j := by
    intro i j hij h
    exact hij (hzinj h)
  have hadj₀ : G.Adj x (z 0) := by
    simpa [left] using (hz (0 : Fin 5)).2.2.1
  have hadj₁ : G.Adj (z 0) u₀ := by
    simpa [right] using (hz (0 : Fin 5)).2.2.2
  have hadj₂ : G.Adj v₀ (z 1) := by
    simpa [left] using (hz (1 : Fin 5)).2.2.1
  have hadj₃ : G.Adj (z 1) u₁ := by
    simpa [right] using (hz (1 : Fin 5)).2.2.2
  have hadj₄ : G.Adj v₁ (z 2) := by
    simpa [left] using (hz (2 : Fin 5)).2.2.1
  have hadj₅ : G.Adj (z 2) u₂ := by
    simpa [right] using (hz (2 : Fin 5)).2.2.2
  have hadj₆ : G.Adj v₂ (z 3) := by
    simpa [left] using (hz (3 : Fin 5)).2.2.1
  have hadj₇ : G.Adj (z 3) u₃ := by
    simpa [right] using (hz (3 : Fin 5)).2.2.2
  have hadj₈ : G.Adj v₃ (z 4) := by
    simpa [left] using (hz (4 : Fin 5)).2.2.1
  have hadj₉ : G.Adj (z 4) y := by
    simpa [right] using (hz (4 : Fin 5)).2.2.2
  let W : Fin 11 → (Σ u v : V, G.Walk u v) :=
    ![⟨x, x, Walk.nil⟩, ⟨z 0, z 0, Walk.nil⟩, ⟨u₀, v₀, p₀⟩,
      ⟨z 1, z 1, Walk.nil⟩, ⟨u₁, v₁, p₁⟩,
      ⟨z 2, z 2, Walk.nil⟩, ⟨u₂, v₂, p₂⟩,
      ⟨z 3, z 3, Walk.nil⟩, ⟨u₃, v₃, p₃⟩,
      ⟨z 4, z 4, Walk.nil⟩, ⟨y, y, Walk.nil⟩]
  let start : Fin 11 → V := fun i => (W i).1
  let finish : Fin 11 → V := fun i => (W i).2.1
  let route : ∀ i : Fin 11, G.Walk (start i) (finish i) :=
    fun i => (W i).2.2
  have hroute : ∀ i : Fin 11, (route i).IsPath := by
    intro i
    fin_cases i <;> simp [route, start, finish, W, hp₀, hp₁, hp₂, hp₃]
  have hrdisj : ∀ i j : Fin 11, i ≠ j →
      (route i).support.Disjoint (route j).support := by
    intro i j hij
    fin_cases i
    · fin_cases j <;> simp [route, start, finish, W, hij,
        hx₀, hx₁, hx₂, hx₃, hxy, hxy.symm, hzX] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij, hzX, hzY,
        (hzX 0).symm, (hzY 0).symm, hzPath, hzNe] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij,
        hx₀, hy₀, hp₀₁, hp₀₂, hp₀₃, hzPath] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij, hzX, hzY,
        (hzX 1).symm, (hzY 1).symm, hzPath, hzNe] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij,
        hx₁, hy₁, hp₀₁, hp₀₁.symm,
        hp₁₂, hp₁₃, hzPath] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij, hzX, hzY,
        (hzX 2).symm, (hzY 2).symm, hzPath, hzNe] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij,
        hx₂, hy₂, hp₀₂, hp₀₂.symm,
        hp₁₂, hp₁₂.symm, hp₂₃, hzPath] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij, hzX, hzY,
        (hzX 3).symm, (hzY 3).symm, hzPath, hzNe] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij,
        hx₃, hy₃, hp₀₃, hp₀₃.symm,
        hp₁₃, hp₁₃.symm, hp₂₃, hp₂₃.symm, hzPath] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij, hzX, hzY,
        (hzX 4).symm, (hzY 4).symm, hzPath, hzNe] at hij ⊢
    · fin_cases j <;> simp [route, start, finish, W, hij,
        hy₀, hy₁, hy₂, hy₃, hxy, hxy.symm,
        hzY, (hzY 0).symm, (hzY 1).symm, (hzY 2).symm,
        (hzY 3).symm, (hzY 4).symm] at hij ⊢
  have hcross : ∀ i : Fin 10,
      G.Adj (finish i.castSucc) (start i.succ) := by
    intro i
    fin_cases i
    · simpa [start, finish, W] using hadj₀
    · simpa [start, finish, W] using hadj₁
    · simpa [start, finish, W] using hadj₂
    · simpa [start, finish, W] using hadj₃
    · simpa [start, finish, W] using hadj₄
    · simpa [start, finish, W] using hadj₅
    · simpa [start, finish, W] using hadj₆
    · simpa [start, finish, W] using hadj₇
    · simpa [start, finish, W] using hadj₈
    · simpa [start, finish, W] using hadj₉
  obtain ⟨p, hp, hplen, hpsupp⟩ :=
    exists_chain_path_fin G start finish route hroute hrdisj hcross
  have hstart : start 0 = x := by simp [start, W]
  have hend : finish (Fin.last 10) = y := by simp [finish, W]
  let p' : G.Walk x y := p.copy hstart hend
  refine ⟨p', by simpa [p'] using hp, ?_, ?_, ?_⟩
  · rw [show p'.length = p.length by simp [p']]
    rw [hplen]
    simp [Fin.sum_univ_succ, route, start, finish, W, Nat.add_assoc]
  · intro w hw
    have hwp : w ∈ p.support := by simpa [p'] using hw
    rcases hpsupp w hwp with ⟨i, hi⟩
    fin_cases i
    · left
      have : w = x := by simpa [route, start, finish, W] using hi
      simpa [this] using Finset.mem_union_left B hxA
    · right
      have : w = z 0 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 0
    · left
      exact hp₀loc w (by simpa [route, start, finish, W] using hi)
    · right
      have : w = z 1 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 1
    · left
      exact hp₁loc w (by simpa [route, start, finish, W] using hi)
    · right
      have : w = z 2 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 2
    · left
      exact hp₂loc w (by simpa [route, start, finish, W] using hi)
    · right
      have : w = z 3 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 3
    · left
      exact hp₃loc w (by simpa [route, start, finish, W] using hi)
    · right
      have : w = z 4 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 4
    · left
      have : w = y := by simpa [route, start, finish, W] using hi
      simpa [this] using Finset.mem_union_left B hyA
  · intro w hw
    have hwp : w ∈ p.support := by simpa [p'] using hw
    rcases hpsupp w hwp with ⟨i, hi⟩
    fin_cases i
    · left; simpa [route, start, finish, W] using hi
    · right; right; right; right; right; right
      have : w = z 0 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 0
    · right; right; left
      simpa [route, start, finish, W] using hi
    · right; right; right; right; right; right
      have : w = z 1 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 1
    · right; right; right; left
      simpa [route, start, finish, W] using hi
    · right; right; right; right; right; right
      have : w = z 2 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 2
    · right; right; right; right; left
      simpa [route, start, finish, W] using hi
    · right; right; right; right; right; right
      have : w = z 3 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 3
    · right; right; right; right; right; left
      simpa [route, start, finish, W] using hi
    · right; right; right; right; right; right
      have : w = z 4 := by simpa [route, start, finish, W] using hi
      simpa [this] using hzD 4
    · right; left
      simpa [route, start, finish, W] using hi

/-- Four scaffold arcs form one long strand while a fifth fresh connector
forms a disjoint two-edge strand between the other attachment pair.  The
long splice is run after deleting the short strand's endpoints from the core
and its middle vertex from the target, so disjointness is structural. -/
theorem exists_disjoint_long_four_arc_and_twoEdge_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {A B D : Finset V} {theta : ℕ}
    (hrob : RobustPairSet G A D theta)
    (hAB : Disjoint A B) (hmajorD : Disjoint (A ∪ B) D)
    (htheta : 7 ≤ theta)
    {x y u v u₀ v₀ u₁ v₁ u₂ v₂ u₃ v₃ : V}
    (hxA : x ∈ A) (hyA : y ∈ A) (huA : u ∈ A) (hvA : v ∈ A)
    (hxy : x ≠ y) (hxu : x ≠ u) (hxv : x ≠ v)
    (hyu : y ≠ u) (hyv : y ≠ v) (huv : u ≠ v)
    (hu₀A : u₀ ∈ A) (hv₀A : v₀ ∈ A)
    (hu₁A : u₁ ∈ A) (hv₁A : v₁ ∈ A)
    (hu₂A : u₂ ∈ A) (hv₂A : v₂ ∈ A)
    (hu₃A : u₃ ∈ A) (hv₃A : v₃ ∈ A)
    {p₀ : G.Walk u₀ v₀} {p₁ : G.Walk u₁ v₁}
    {p₂ : G.Walk u₂ v₂} {p₃ : G.Walk u₃ v₃}
    (hp₀ : p₀.IsPath) (hp₁ : p₁.IsPath)
    (hp₂ : p₂.IsPath) (hp₃ : p₃.IsPath)
    (hp₀₁ : p₀.support.Disjoint p₁.support)
    (hp₀₂ : p₀.support.Disjoint p₂.support)
    (hp₀₃ : p₀.support.Disjoint p₃.support)
    (hp₁₂ : p₁.support.Disjoint p₂.support)
    (hp₁₃ : p₁.support.Disjoint p₃.support)
    (hp₂₃ : p₂.support.Disjoint p₃.support)
    (hp₀loc : ∀ w ∈ p₀.support, w ∈ A ∪ B)
    (hp₁loc : ∀ w ∈ p₁.support, w ∈ A ∪ B)
    (hp₂loc : ∀ w ∈ p₂.support, w ∈ A ∪ B)
    (hp₃loc : ∀ w ∈ p₃.support, w ∈ A ∪ B)
    (hx₀ : x ∉ p₀.support) (hx₁ : x ∉ p₁.support)
    (hx₂ : x ∉ p₂.support) (hx₃ : x ∉ p₃.support)
    (hy₀ : y ∉ p₀.support) (hy₁ : y ∉ p₁.support)
    (hy₂ : y ∉ p₂.support) (hy₃ : y ∉ p₃.support)
    (hu₀ : u ∉ p₀.support) (hu₁ : u ∉ p₁.support)
    (hu₂ : u ∉ p₂.support) (hu₃ : u ∉ p₃.support)
    (hv₀ : v ∉ p₀.support) (hv₁ : v ∉ p₁.support)
    (hv₂ : v ∉ p₂.support) (hv₃ : v ∉ p₃.support) :
    ∃ p : G.Walk x y, ∃ q : G.Walk u v,
      p.IsPath ∧ q.IsPath ∧ p.support.Disjoint q.support ∧
      p.length = p₀.length + p₁.length + p₂.length + p₃.length + 10 ∧
      q.length = 2 ∧
      (∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      (∀ w ∈ q.support, w ∈ A ∨ w ∈ D) ∧
      ∀ w ∈ p.support, w = x ∨ w = y ∨
        w ∈ p₀.support ∨ w ∈ p₁.support ∨ w ∈ p₂.support ∨
        w ∈ p₃.support ∨ w ∈ D := by
  classical
  obtain ⟨z, hzD, _hzempty, huz, hzv⟩ :=
    exists_fresh_commonNeighbor_of_pair G (hrob u huA v hvA)
      (F := ∅) (by simpa using (show 0 < theta by omega))
  have hzMajor : z ∉ A ∪ B := by
    intro h
    exact (Finset.disjoint_left.mp hmajorD) h hzD
  have hzu : z ≠ u := by
    intro h
    exact hzMajor (h ▸ Finset.mem_union_left B huA)
  have hzvNe : z ≠ v := by
    intro h
    exact hzMajor (h ▸ Finset.mem_union_left B hvA)
  let q : G.Walk u v := Walk.cons huz (Walk.cons hzv Walk.nil)
  have hq : q.IsPath := by
    simp [q, Walk.cons_isPath_iff, huv, hzu, hzu.symm, hzvNe]
  have hqlen : q.length = 2 := by simp [q]
  let E : Finset V := {u, v}
  let Z : Finset V := {z}
  have hrobE : RobustPairSet G (A \ E) D theta :=
    hrob.mono_left Finset.sdiff_subset
  have hrobEZ : RobustPairSet G (A \ E) (D \ Z) (theta - 1) := by
    simpa [Z] using hrobE.sdiff_right (F := Z)
  have hmajorEZ : Disjoint ((A \ E) ∪ B) (D \ Z) :=
    hmajorD.mono (Finset.union_subset_union_left Finset.sdiff_subset)
      Finset.sdiff_subset
  have endpoint_mem (a : V) (ha : a ∈ A) (hau : a ≠ u) (hav : a ≠ v) :
      a ∈ A \ E := by
    exact Finset.mem_sdiff.mpr ⟨ha, by simp [E, hau, hav]⟩
  have hxE : x ∈ A \ E := endpoint_mem x hxA hxu hxv
  have hyE : y ∈ A \ E := endpoint_mem y hyA hyu hyv
  have segment_loc
      {a b : V} {r : G.Walk a b}
      (hrloc : ∀ w ∈ r.support, w ∈ A ∪ B)
      (hur : u ∉ r.support) (hvr : v ∉ r.support) :
      ∀ w ∈ r.support, w ∈ (A \ E) ∪ B := by
    intro w hw
    rcases Finset.mem_union.mp (hrloc w hw) with hwA | hwB
    · exact Finset.mem_union_left _ (Finset.mem_sdiff.mpr
        ⟨hwA, by
          simp only [E, Finset.mem_insert, Finset.mem_singleton]
          intro h
          rcases h with h | h
          · exact hur (h ▸ hw)
          · exact hvr (h ▸ hw)⟩)
    · exact Finset.mem_union_right _ hwB
  have endpointE (a : V) (ha : a ∈ A)
      (hur : u ≠ a) (hvr : v ≠ a) : a ∈ A \ E := by
    exact Finset.mem_sdiff.mpr ⟨ha, by
      simp only [E, Finset.mem_insert, Finset.mem_singleton]
      intro h
      exact h.elim hur.symm hvr.symm⟩
  have hu₀E : u₀ ∈ A \ E := endpointE u₀ hu₀A
    (fun h => hu₀ (h ▸ p₀.start_mem_support))
    (fun h => hv₀ (h ▸ p₀.start_mem_support))
  have hv₀E : v₀ ∈ A \ E := endpointE v₀ hv₀A
    (fun h => hu₀ (h ▸ p₀.end_mem_support))
    (fun h => hv₀ (h ▸ p₀.end_mem_support))
  have hu₁E : u₁ ∈ A \ E := endpointE u₁ hu₁A
    (fun h => hu₁ (h ▸ p₁.start_mem_support))
    (fun h => hv₁ (h ▸ p₁.start_mem_support))
  have hv₁E : v₁ ∈ A \ E := endpointE v₁ hv₁A
    (fun h => hu₁ (h ▸ p₁.end_mem_support))
    (fun h => hv₁ (h ▸ p₁.end_mem_support))
  have hu₂E : u₂ ∈ A \ E := endpointE u₂ hu₂A
    (fun h => hu₂ (h ▸ p₂.start_mem_support))
    (fun h => hv₂ (h ▸ p₂.start_mem_support))
  have hv₂E : v₂ ∈ A \ E := endpointE v₂ hv₂A
    (fun h => hu₂ (h ▸ p₂.end_mem_support))
    (fun h => hv₂ (h ▸ p₂.end_mem_support))
  have hu₃E : u₃ ∈ A \ E := endpointE u₃ hu₃A
    (fun h => hu₃ (h ▸ p₃.start_mem_support))
    (fun h => hv₃ (h ▸ p₃.start_mem_support))
  have hv₃E : v₃ ∈ A \ E := endpointE v₃ hv₃A
    (fun h => hu₃ (h ▸ p₃.end_mem_support))
    (fun h => hv₃ (h ▸ p₃.end_mem_support))
  obtain ⟨p, hp, hplen, hploc, hpsupport⟩ :=
    exists_path_joining_four_disjoint_major_paths G hrobEZ
      hmajorEZ (by omega)
      hxE hyE hu₀E hv₀E hu₁E hv₁E hu₂E hv₂E hu₃E hv₃E
      hp₀ hp₁ hp₂ hp₃ hp₀₁ hp₀₂ hp₀₃ hp₁₂ hp₁₃ hp₂₃
      (segment_loc hp₀loc hu₀ hv₀) (segment_loc hp₁loc hu₁ hv₁)
      (segment_loc hp₂loc hu₂ hv₂) (segment_loc hp₃loc hu₃ hv₃)
      hx₀ hx₁ hx₂ hx₃ hy₀ hy₁ hy₂ hy₃ hxy
  have hpq : p.support.Disjoint q.support := by
    intro w hwp hwq
    have hwq' : w = u ∨ w = z ∨ w = v := by
      simpa [q] using hwq
    rcases hploc w hwp with hwMajor | hwTarget
    · rcases Finset.mem_union.mp hwMajor with hwAE | hwB
      · have hwne := (Finset.mem_sdiff.mp hwAE).2
        rcases hwq' with rfl | rfl | rfl
        · exact hwne (by simp [E])
        · exact hzMajor (Finset.mem_union_left B (Finset.mem_sdiff.mp hwAE).1)
        · exact hwne (by simp [E])
      · rcases hwq' with rfl | rfl | rfl
        · exact (Finset.disjoint_left.mp hAB) huA hwB
        · exact hzMajor (Finset.mem_union_right A hwB)
        · exact (Finset.disjoint_left.mp hAB) hvA hwB
    · have hwDZ := Finset.mem_sdiff.mp hwTarget
      rcases hwq' with rfl | rfl | rfl
      · exact (Finset.disjoint_left.mp hmajorD)
          (Finset.mem_union_left B huA) hwDZ.1
      · exact hwDZ.2 (by simp [Z])
      · exact (Finset.disjoint_left.mp hmajorD)
          (Finset.mem_union_left B hvA) hwDZ.1
  refine ⟨p, q, hp, hq, hpq, hplen, hqlen, ?_, ?_, ?_⟩
  · intro w hw
    rcases hploc w hw with hw | hw
    · rcases Finset.mem_union.mp hw with hw | hw
      · exact Or.inl (Finset.mem_union_left _ (Finset.mem_sdiff.mp hw).1)
      · exact Or.inl (Finset.mem_union_right _ hw)
    · exact Or.inr (Finset.mem_sdiff.mp hw).1
  · intro w hw
    have hw' : w = u ∨ w = z ∨ w = v := by simpa [q] using hw
    rcases hw' with rfl | rfl | rfl
    · exact Or.inl huA
    · exact Or.inr hzD
    · exact Or.inl hvA
  · intro w hw
    rcases hpsupport w hw with hw | hw | hw | hw | hw | hw | hw
    · exact Or.inl hw
    · exact Or.inr (Or.inl hw)
    · exact Or.inr (Or.inr (Or.inl hw))
    · exact Or.inr (Or.inr (Or.inr (Or.inl hw)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hw))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hw)))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
        (Or.inr (Finset.mem_sdiff.mp hw).1)))))

/-- Allocate an exact natural total under coordinate-dependent finite
capacities.  The head receives as much of the demand as possible and the
induction distributes the remaining demand over the tail. -/
theorem exists_fin_weights_sum_eq_le_fun
    {q z : ℕ} (c : Fin q → ℕ) (hz : z ≤ ∑ i, c i) :
    ∃ r : Fin q → ℕ, (∑ i, r i) = z ∧ ∀ i, r i ≤ c i := by
  induction q generalizing z with
  | zero =>
      have hz0 : z = 0 := by simpa using hz
      refine ⟨Fin.elim0, by simp [hz0], fun i => i.elim0⟩
  | succ q ih =>
      let a : ℕ := min z (c 0)
      let z' : ℕ := z - a
      let c' : Fin q → ℕ := fun i => c i.succ
      have hsum : (∑ i : Fin (q + 1), c i) = c 0 + ∑ i : Fin q, c' i := by
        rw [Fin.sum_univ_succ]
      have hz'tail : z' ≤ ∑ i : Fin q, c' i := by
        dsimp [z', a]
        rw [hsum] at hz
        by_cases hzc : z ≤ c 0
        · simp [Nat.min_eq_left hzc]
        · have hcz : c 0 ≤ z := Nat.le_of_not_ge hzc
          rw [Nat.min_eq_right hcz]
          omega
      obtain ⟨r', hrsum, hrle⟩ := ih c' hz'tail
      let r : Fin (q + 1) → ℕ := Fin.cases a r'
      refine ⟨r, ?_, ?_⟩
      · rw [Fin.sum_univ_succ]
        simp only [r, Fin.cases_zero, Fin.cases_succ, hrsum]
        dsimp [z', a]
        omega
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · dsimp [r, a]
          exact Nat.min_le_right _ _
        · simpa [r, c'] using hrle j

/-- Exact allocation which keeps every positive capacity nonempty.  One unit
is first reserved on the support of `c`; the preceding allocator distributes
the remaining demand under the pointwise spare capacities. -/
theorem exists_positive_fin_weights_sum_eq_le_fun
    {q z : ℕ} (c : Fin q → ℕ)
    (hsupport : ((Finset.univ : Finset (Fin q)).filter fun i => c i ≠ 0).card ≤ z)
    (hz : z ≤ ∑ i, c i) :
    ∃ g : Fin q → ℕ, (∑ i, g i) = z ∧
      (∀ i, g i ≤ c i) ∧ ∀ i, g i = 0 ↔ c i = 0 := by
  classical
  let b : Fin q → ℕ := fun i => if c i = 0 then 0 else 1
  let spare : Fin q → ℕ := fun i => c i - b i
  have hble : ∀ i, b i ≤ c i := by
    intro i
    by_cases hi : c i = 0
    · simp [b, hi]
    · simp [b, hi, Nat.one_le_iff_ne_zero.mpr hi]
  have hbsum : (∑ i, b i) =
      ((Finset.univ : Finset (Fin q)).filter fun i => c i ≠ 0).card := by
    calc
      (∑ i, b i) = ∑ i : Fin q, if c i ≠ 0 then 1 else 0 := by
        apply Finset.sum_congr rfl
        intro i _hi
        simp [b]
      _ = ((Finset.univ : Finset (Fin q)).filter fun i => c i ≠ 0).card := by
        simpa only [Nat.cast_id] using
          (Finset.sum_boole (R := ℕ) (fun i : Fin q => c i ≠ 0) Finset.univ)
  have hsplit : (∑ i, spare i) + (∑ i, b i) = ∑ i, c i := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _hi
    dsimp [spare]
    exact Nat.sub_add_cancel (hble i)
  let e : ℕ := z - ∑ i, b i
  have hesum : e ≤ ∑ i, spare i := by
    dsimp [e]
    rw [hbsum]
    omega
  obtain ⟨a, hasum, hale⟩ :=
    exists_fin_weights_sum_eq_le_fun spare hesum
  let g : Fin q → ℕ := fun i => b i + a i
  refine ⟨g, ?_, ?_, ?_⟩
  · rw [show (∑ i, g i) = (∑ i, b i) + ∑ i, a i by
      simp only [g, Finset.sum_add_distrib]]
    rw [hasum]
    dsimp [e]
    rw [hbsum]
    omega
  · intro i
    change b i + a i ≤ c i
    calc
      b i + a i ≤ b i + spare i := Nat.add_le_add_left (hale i) _
      _ = c i := by
        dsimp [spare]
        exact Nat.add_sub_of_le (hble i)
  · intro i
    have hgi : g i ≤ c i := by
      change b i + a i ≤ c i
      calc
        b i + a i ≤ b i + spare i := Nat.add_le_add_left (hale i) _
        _ = c i := by
          dsimp [spare]
          exact Nat.add_sub_of_le (hble i)
    constructor
    · intro hgi
      by_contra hci
      have hbi : b i = 1 := by simp [b, hci]
      have : 1 ≤ g i := by dsimp [g]; omega
      omega
    · intro hci
      omega

/-- Four disjoint linear index intervals can be packed into the complement
of four cyclic cut indices, using any total edge budget `R ≤ q - 8`.
After rotating one cut to zero and sorting the other three, the four gaps
have total capacity `q - 4`; four nonempty groups are reserved across their
support and the remaining `R` units are allocated freely. -/
theorem exists_four_disjoint_intervals_avoiding_sorted_cuts
    {q d₀ d₁ d₂ R : ℕ} (hq : 8 ≤ q)
    (hd₀ : 0 < d₀) (hd₀₁ : d₀ < d₁)
    (hd₁₂ : d₁ < d₂) (hd₂q : d₂ < q)
    (hR : R ≤ q - 8) :
    ∃ s r : Fin 4 → ℕ,
      (∀ i, s i + r i < q) ∧
      (∀ i, 0 < s i) ∧
      (∀ i, (s i + r i < d₀ ∨ d₀ < s i) ∧
        (s i + r i < d₁ ∨ d₁ < s i) ∧
        (s i + r i < d₂ ∨ d₂ < s i)) ∧
      (∀ i j, i ≠ j →
        s i + r i < s j ∨ s j + r j < s i) ∧
      (∑ i, r i) = R := by
  classical
  let base : Fin 4 → ℕ := ![1, d₀ + 1, d₁ + 1, d₂ + 1]
  let cap : Fin 4 → ℕ :=
    ![d₀ - 1, d₁ - d₀ - 1, d₂ - d₁ - 1, q - d₂ - 1]
  have hcapSum : (∑ i : Fin 4, cap i) = q - 4 := by
    simp [cap, Fin.sum_univ_succ]
    omega
  have hsupport :
      ((Finset.univ : Finset (Fin 4)).filter fun i => cap i ≠ 0).card ≤ 4 := by
    calc
      _ ≤ (Finset.univ : Finset (Fin 4)).card := Finset.card_filter_le _ _
      _ = 4 := by simp
  have hfour : 4 ≤ ∑ i : Fin 4, cap i := by rw [hcapSum]; omega
  obtain ⟨groups, hgroupSum, hgroupLe, hgroupZero⟩ :=
    exists_positive_fin_weights_sum_eq_le_fun cap hsupport hfour
  let spare : Fin 4 → ℕ := fun i => cap i - groups i
  have hsplit : (∑ i, spare i) + (∑ i, groups i) = ∑ i, cap i := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _hi
    dsimp [spare]
    exact Nat.sub_add_cancel (hgroupLe i)
  have hRspare : R ≤ ∑ i, spare i := by
    rw [hgroupSum, hcapSum] at hsplit
    omega
  obtain ⟨extra, hextraSum, hextraLe⟩ :=
    exists_fin_weights_sum_eq_le_fun spare hRspare
  let used : Fin 4 → ℕ := fun i => groups i + extra i
  have husedLe : ∀ i, used i ≤ cap i := by
    intro i
    have hi := hextraLe i
    have hgi := hgroupLe i
    dsimp [spare, used] at hi ⊢
    omega
  have hgroupUsed : ∀ i, groups i ≤ used i := by
    intro i
    simp [used]
  have husedSum : (∑ i, used i) = 4 + R := by
    simp only [used, Finset.sum_add_distrib, hgroupSum, hextraSum]
  let I : Type := Σ i : Fin 4, Fin (groups i)
  have hcardI : Fintype.card (Fin 4) = Fintype.card I := by
    simp only [Fintype.card_fin, I, Fintype.card_sigma]
    simpa using hgroupSum.symm
  let e : Fin 4 ≃ I := Fintype.equivOfCardEq hcardI
  let rawStart : I → ℕ := fun t =>
    base t.1 + if t.2.val = 0 then 0 else used t.1 - groups t.1 + t.2.val
  let rawLen : I → ℕ := fun t =>
    if t.2.val = 0 then used t.1 - groups t.1 else 0
  let s : Fin 4 → ℕ := fun i => rawStart (e i)
  let r : Fin 4 → ℕ := fun i => rawLen (e i)
  have hbaseCap : ∀ i : Fin 4, base i + cap i ≤ q := by
    intro i
    fin_cases i <;> simp [base, cap] <;> omega
  have hrawWithin : ∀ t : I,
      base t.1 ≤ rawStart t ∧
      rawStart t + rawLen t < base t.1 + cap t.1 := by
    rintro ⟨i, j⟩
    have hgroupsPos : 0 < groups i := by
      by_contra hnot
      have hz : groups i = 0 := Nat.eq_zero_of_not_pos hnot
      simpa [hz] using j.isLt
    have hcapPos : 0 < cap i := by
      have : cap i ≠ 0 := by
        intro hcap
        exact (Nat.ne_of_gt hgroupsPos) ((hgroupZero i).mpr hcap)
      exact Nat.pos_of_ne_zero this
    have hj := j.isLt
    have hgu := hgroupUsed i
    have huc := husedLe i
    by_cases hj0 : j.val = 0
    · simp [rawStart, rawLen, hj0]
      omega
    · simp [rawStart, rawLen, hj0]
      omega
  have hrawQ : ∀ t : I, rawStart t + rawLen t < q := by
    intro t
    exact (hrawWithin t).2.trans_le (hbaseCap t.1)
  have hrawPos : ∀ t : I, 0 < rawStart t := by
    rintro ⟨i, j⟩
    have hb : 0 < base i := by
      fin_cases i <;> simp [base] <;> omega
    exact hb.trans_le (hrawWithin ⟨i, j⟩).1
  have hrawAvoid : ∀ t : I,
      (rawStart t + rawLen t < d₀ ∨ d₀ < rawStart t) ∧
      (rawStart t + rawLen t < d₁ ∨ d₁ < rawStart t) ∧
      (rawStart t + rawLen t < d₂ ∨ d₂ < rawStart t) := by
    rintro ⟨i, j⟩
    have hw := hrawWithin ⟨i, j⟩
    fin_cases i <;> simp [base, cap] at hw ⊢ <;> omega
  have hblockOrder : ∀ i k : Fin 4, i.val < k.val →
      base i + cap i ≤ base k := by
    intro i k hik
    fin_cases i <;> fin_cases k <;> simp [base, cap] at hik ⊢ <;> omega
  have hrawDisj : ∀ t u : I, t ≠ u →
      rawStart t + rawLen t < rawStart u ∨
        rawStart u + rawLen u < rawStart t := by
    rintro ⟨i, j⟩ ⟨k, l⟩ hne
    by_cases hik : i = k
    · subst k
      have hjl : j.val ≠ l.val := by
        intro h
        apply hne
        have hjl' : j = l := Fin.ext h
        subst l
        rfl
      have hj := j.isLt
      have hl := l.isLt
      have hgu := hgroupUsed i
      by_cases hj0 : j.val = 0 <;> by_cases hl0 : l.val = 0 <;>
        simp [rawStart, rawLen, hj0, hl0] <;> omega
    · have hwi := hrawWithin ⟨i, j⟩
      have hwk := hrawWithin ⟨k, l⟩
      have hvalne : i.val ≠ k.val := fun h => hik (Fin.ext h)
      rcases lt_or_gt_of_ne hvalne with hik' | hki'
      · left
        exact hwi.2.trans_le ((hblockOrder i k hik').trans hwk.1)
      · right
        exact hwk.2.trans_le ((hblockOrder k i hki').trans hwi.1)
  have hrawLenSum : (∑ t : I, rawLen t) = R := by
    have hone (i : Fin 4) :
        (∑ j : Fin (groups i),
          (if j.val = 0 then used i - groups i else 0)) =
            used i - groups i := by
      cases hgi : groups i with
      | zero =>
          have hc : cap i = 0 := (hgroupZero i).mp hgi
          have hu : used i = 0 := Nat.eq_zero_of_le_zero (hc ▸ husedLe i)
          simp [hgi, hu]
      | succ n =>
          rw [Fin.sum_univ_succ]
          simp
    calc
      (∑ t : I, rawLen t) =
          ∑ i : Fin 4, ∑ j : Fin (groups i),
            (if j.val = 0 then used i - groups i else 0) := by
              rw [Fintype.sum_sigma]
      _ = ∑ i : Fin 4, (used i - groups i) := by
        apply Finset.sum_congr rfl
        intro i _hi
        exact hone i
      _ = R := by
        have hpoint : ∀ i, used i - groups i = extra i := by
          intro i
          simp [used]
        simp_rw [hpoint]
        exact hextraSum
  refine ⟨s, r, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact hrawQ (e i)
  · intro i
    exact hrawPos (e i)
  · intro i
    exact hrawAvoid (e i)
  · intro i j hij
    exact hrawDisj (e i) (e j) (fun h => hij (e.injective h))
  · rw [show (∑ i : Fin 4, r i) = ∑ t : I, rawLen t by
      exact Fintype.sum_equiv e _ _ (fun _ => rfl)]
    exact hrawLenSum

/-- Unsorted wrapper for the four-cut interval allocator.  The three
nonzero cuts are distinct, so six linear-order cases reduce to the sorted
theorem; the returned intervals avoid the original labelled cuts. -/
theorem exists_four_disjoint_intervals_avoiding_cuts
    {q d₀ d₁ d₂ R : ℕ} (hq : 8 ≤ q)
    (hd₀pos : 0 < d₀) (hd₁pos : 0 < d₁) (hd₂pos : 0 < d₂)
    (hd₀q : d₀ < q) (hd₁q : d₁ < q) (hd₂q : d₂ < q)
    (hd₀₁ : d₀ ≠ d₁) (hd₀₂ : d₀ ≠ d₂) (hd₁₂ : d₁ ≠ d₂)
    (hR : R ≤ q - 8) :
    ∃ s r : Fin 4 → ℕ,
      (∀ i, s i + r i < q) ∧
      (∀ i, 0 < s i) ∧
      (∀ i, (s i + r i < d₀ ∨ d₀ < s i) ∧
        (s i + r i < d₁ ∨ d₁ < s i) ∧
        (s i + r i < d₂ ∨ d₂ < s i)) ∧
      (∀ i j, i ≠ j →
        s i + r i < s j ∨ s j + r j < s i) ∧
      (∑ i, r i) = R := by
  have finish {a b c : ℕ} (ha : 0 < a) (hab : a < b) (hbc : b < c)
      (hcq : c < q) (haCuts : a = d₀ ∨ a = d₁ ∨ a = d₂)
      (hbCuts : b = d₀ ∨ b = d₁ ∨ b = d₂)
      (hcCuts : c = d₀ ∨ c = d₁ ∨ c = d₂) :
      ∃ s r : Fin 4 → ℕ,
        (∀ i, s i + r i < q) ∧
        (∀ i, 0 < s i) ∧
        (∀ i, (s i + r i < d₀ ∨ d₀ < s i) ∧
          (s i + r i < d₁ ∨ d₁ < s i) ∧
          (s i + r i < d₂ ∨ d₂ < s i)) ∧
        (∀ i j, i ≠ j →
          s i + r i < s j ∨ s j + r j < s i) ∧
        (∑ i, r i) = R := by
    obtain ⟨s, r, hsr, hspos, havoid, hdisj, hrsum⟩ :=
      exists_four_disjoint_intervals_avoiding_sorted_cuts
        hq ha hab hbc hcq hR
    refine ⟨s, r, hsr, hspos, ?_, hdisj, hrsum⟩
    intro i
    have hi := havoid i
    rcases haCuts with rfl | rfl | rfl <;>
      rcases hbCuts with rfl | rfl | rfl <;>
      rcases hcCuts with rfl | rfl | rfl <;> first | omega | aesop
  by_cases h₀₁ : d₀ < d₁
  · by_cases h₀₂ : d₀ < d₂
    · by_cases h₁₂ : d₁ < d₂
      · exact finish hd₀pos h₀₁ h₁₂ hd₂q
          (Or.inl rfl) (Or.inr (Or.inl rfl)) (Or.inr (Or.inr rfl))
      · exact finish hd₀pos h₀₂ (by omega) hd₁q
          (Or.inl rfl) (Or.inr (Or.inr rfl)) (Or.inr (Or.inl rfl))
    · exact finish hd₂pos (by omega) h₀₁ hd₁q
        (Or.inr (Or.inr rfl)) (Or.inl rfl) (Or.inr (Or.inl rfl))
  · have h₁₀ : d₁ < d₀ := by omega
    by_cases h₁₂ : d₁ < d₂
    · by_cases h₀₂ : d₀ < d₂
      · exact finish hd₁pos h₁₀ h₀₂ hd₂q
          (Or.inr (Or.inl rfl)) (Or.inl rfl) (Or.inr (Or.inr rfl))
      · exact finish hd₁pos h₁₂ (by omega) hd₀q
          (Or.inr (Or.inl rfl)) (Or.inr (Or.inr rfl)) (Or.inl rfl)
    · exact finish hd₂pos (by omega) h₁₀ hd₀q
        (Or.inr (Or.inr rfl)) (Or.inr (Or.inl rfl)) (Or.inl rfl)

/-- Two disjoint strands through one cyclic alternating scaffold.  Four
attachment vertices cut the scaffold into at most four linear gaps.  The
preceding interval allocator chooses four nonempty subsegments of total
internal edge budget `2R`; five connectors join them into the long strand,
while one further connector gives the disjoint two-edge strand. -/
theorem exists_disjoint_long_and_short_routes_via_cyclicAlternatingScaffold
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q theta R : ℕ} {A B D : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D)
    (hq : 8 ≤ q) (htheta : 7 ≤ theta) (hR : R ≤ q - 8)
    {x y u v : V}
    (hxA : x ∈ A) (hyA : y ∈ A) (huA : u ∈ A) (hvA : v ∈ A)
    (hxy : x ≠ y) (hxu : x ≠ u) (hxv : x ≠ v)
    (hyu : y ≠ u) (hyv : y ≠ v) (huv : u ≠ v) :
    ∃ p : G.Walk x y, ∃ r : G.Walk u v,
      p.IsPath ∧ r.IsPath ∧ p.support.Disjoint r.support ∧
      p.length = 2 * R + 10 ∧ r.length = 2 ∧
      (∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      (∀ w ∈ r.support, w ∈ A ∨ w ∈ D) ∧
      ∀ z, (IsCanonicalScaffoldMate G hscaffold z x ∨
        IsCanonicalScaffoldMate G hscaffold z y ∨
        IsCanonicalScaffoldMate G hscaffold z u ∨
        IsCanonicalScaffoldMate G hscaffold z v) →
        z ∉ p.support ∧ z ∉ r.support := by
  classical
  rcases exists_cyclicAlternatingScaffold_data_starting_at G hscaffold hxA with
    ⟨hqpos, a, b, hA, hB, ha, hb, hAB, hab, hba, ha0, hmate⟩
  let i0 : Fin q := ⟨0, hqpos⟩
  have haA : ∀ i : Fin q, a i ∈ A := by
    intro i
    rw [hA]
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hbB : ∀ i : Fin q, b i ∈ B := by
    intro i
    rw [hB]
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  obtain ⟨iy, _hiy, hay⟩ := Finset.mem_image.mp (hA ▸ hyA)
  obtain ⟨iu, _hiu, hau⟩ := Finset.mem_image.mp (hA ▸ huA)
  obtain ⟨iv, _hiv, hav⟩ := Finset.mem_image.mp (hA ▸ hvA)
  have hpos (d : Fin q) (had : a d ≠ a i0) : 0 < d.val := by
    have hd0 : d.val ≠ 0 := by
      intro h
      apply had
      apply congrArg a
      exact Fin.ext h
    omega
  have hiy0 : a iy ≠ a i0 := by
    intro h
    apply hxy
    exact ha0.symm.trans (h.symm.trans hay)
  have hiu0 : a iu ≠ a i0 := by
    intro h
    apply hxu
    exact ha0.symm.trans (h.symm.trans hau)
  have hiv0 : a iv ≠ a i0 := by
    intro h
    apply hxv
    exact ha0.symm.trans (h.symm.trans hav)
  have hiypos : 0 < iy.val := hpos iy hiy0
  have hiupos : 0 < iu.val := hpos iu hiu0
  have hivpos : 0 < iv.val := hpos iv hiv0
  have hiyiu : iy.val ≠ iu.val := by
    intro h
    have heq : iy = iu := Fin.ext h
    apply hyu
    exact hay.symm.trans (congrArg a heq |>.trans hau)
  have hiyiv : iy.val ≠ iv.val := by
    intro h
    have heq : iy = iv := Fin.ext h
    apply hyv
    exact hay.symm.trans (congrArg a heq |>.trans hav)
  have hiuiv : iu.val ≠ iv.val := by
    intro h
    have heq : iu = iv := Fin.ext h
    apply huv
    exact hau.symm.trans (congrArg a heq |>.trans hav)
  obtain ⟨s, len, hsq, hspos, havoid, hintervalDisj, hlensum⟩ :=
    exists_four_disjoint_intervals_avoiding_cuts hq
      hiypos hiupos hivpos iy.isLt iu.isLt iv.isLt
      hiyiu hiyiv hiuiv hR
  let ea (j : Fin 4) : Fin (len j + 1) → Fin q :=
    fun t => ⟨s j + t.val, by have := hsq j; omega⟩
  let eb (j : Fin 4) : Fin (len j) → Fin q :=
    fun t => ⟨s j + t.val, by have := hsq j; omega⟩
  have habdisj : ∀ i j : Fin q, a i ≠ b j := by
    intro i j hij
    exact (Finset.disjoint_left.mp hAB) (haA i) (hij ▸ hbB j)
  choose p hp hplen hpsupp using fun j : Fin 4 =>
    exists_segment_path_of_cyclicAlternatingScaffold_data
      G hqpos a b ha hb habdisj hab hba (hsq j)
  change ∀ j : Fin 4, ∀ w ∈ (p j).support,
      (∃ i : Fin (len j + 1), a (ea j i) = w) ∨
        ∃ t : Fin (len j), b (eb j t) = w at hpsupp
  have hploc : ∀ j : Fin 4, ∀ w ∈ (p j).support, w ∈ A ∪ B := by
    intro j w hw
    rcases hpsupp j w hw with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact Finset.mem_union_left _ (haA (ea j i))
    · exact Finset.mem_union_right _ (hbB (eb j i))
  have hpdisj : ∀ i j : Fin 4, i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij w hwi hwj
    rcases hpsupp i w hwi with ⟨u₀, hu₀⟩ | ⟨u₀, hu₀⟩ <;>
      rcases hpsupp j w hwj with ⟨u₁, hu₁⟩ | ⟨u₁, hu₁⟩
    · have heq : ea i u₀ = ea j u₁ := ha (hu₀.trans hu₁.symm)
      have hval := congrArg Fin.val heq
      have hi0 := u₀.isLt
      have hi1 := u₁.isLt
      have hd := hintervalDisj i j hij
      dsimp [ea] at hval
      omega
    · exact (Finset.disjoint_left.mp hAB)
        (haA (ea i u₀)) (hu₀ ▸ hu₁ ▸ hbB (eb j u₁))
    · exact (Finset.disjoint_left.mp hAB)
        (haA (ea j u₁)) (hu₁ ▸ hu₀ ▸ hbB (eb i u₀))
    · have heq : eb i u₀ = eb j u₁ := hb (hu₀.trans hu₁.symm)
      have hval := congrArg Fin.val heq
      have hi0 := u₀.isLt
      have hi1 := u₁.isLt
      have hd := hintervalDisj i j hij
      dsimp [eb] at hval
      omega
  have hindexAvoid (d : Fin q)
      (hd : ∀ j : Fin 4, s j + len j < d.val ∨ d.val < s j) :
      ∀ j : Fin 4, a d ∉ (p j).support := by
    intro j hmem
    rcases hpsupp j (a d) hmem with ⟨t, ht⟩ | ⟨t, ht⟩
    · have heq : d = ea j t := (ha ht).symm
      have hval := congrArg Fin.val heq
      have htlt := t.isLt
      have hdj := hd j
      dsimp [ea] at hval
      omega
    · exact (Finset.disjoint_left.mp hAB) (haA d) (ht ▸ hbB (eb j t))
  have hmateIndexAvoid (d : Fin q)
      (hd : ∀ j : Fin 4, s j + len j < d.val ∨ d.val < s j) :
      ∀ j : Fin 4, b d ∉ (p j).support := by
    intro j hmem
    rcases hpsupp j (b d) hmem with ⟨t, ht⟩ | ⟨t, ht⟩
    · exact (Finset.disjoint_left.mp hAB) (haA (ea j t)) (ht ▸ hbB d)
    · have heq : eb j t = d := hb ht
      have hval := congrArg Fin.val heq
      have htlt := t.isLt
      have hdj := hd j
      dsimp [eb] at hval
      omega
  have hxavoid : ∀ j : Fin 4, a i0 ∉ (p j).support := by
    apply hindexAvoid i0
    intro j
    right
    simpa [i0] using hspos j
  have hyavoid : ∀ j : Fin 4, a iy ∉ (p j).support := by
    apply hindexAvoid iy
    intro j
    exact (havoid j).1
  have huavoid : ∀ j : Fin 4, a iu ∉ (p j).support := by
    apply hindexAvoid iu
    intro j
    exact (havoid j).2.1
  have hvavoid : ∀ j : Fin 4, a iv ∉ (p j).support := by
    apply hindexAvoid iv
    intro j
    exact (havoid j).2.2
  have hbxavoid : ∀ j : Fin 4, b i0 ∉ (p j).support := by
    apply hmateIndexAvoid i0
    intro j
    right
    simpa [i0] using hspos j
  have hbyavoid : ∀ j : Fin 4, b iy ∉ (p j).support := by
    apply hmateIndexAvoid iy
    intro j
    exact (havoid j).1
  have hbuavoid : ∀ j : Fin 4, b iu ∉ (p j).support := by
    apply hmateIndexAvoid iu
    intro j
    exact (havoid j).2.1
  have hbvavoid : ∀ j : Fin 4, b iv ∉ (p j).support := by
    apply hmateIndexAvoid iv
    intro j
    exact (havoid j).2.2
  obtain ⟨long, short, hlong, hshort, hdisj, hlonglen, hshortlen,
      hlongloc, hshortloc, hlongSupport⟩ :=
    exists_disjoint_long_four_arc_and_twoEdge_paths G hrob hAB hmajorD htheta
      (haA i0) (haA iy) (haA iu) (haA iv)
      (by
        intro h
        exact hxy (ha0.symm.trans (h.trans hay)))
      (by
        intro h
        exact hxu (ha0.symm.trans (h.trans hau)))
      (by
        intro h
        exact hxv (ha0.symm.trans (h.trans hav)))
      (by simpa [hay, hau] using hyu)
      (by simpa [hay, hav] using hyv)
      (by simpa [hau, hav] using huv)
      (haA (ea 0 0)) (haA (ea 0 (Fin.last (len 0))))
      (haA (ea 1 0)) (haA (ea 1 (Fin.last (len 1))))
      (haA (ea 2 0)) (haA (ea 2 (Fin.last (len 2))))
      (haA (ea 3 0)) (haA (ea 3 (Fin.last (len 3))))
      (hp 0) (hp 1) (hp 2) (hp 3)
      (hpdisj 0 1 (by decide)) (hpdisj 0 2 (by decide))
      (hpdisj 0 3 (by decide)) (hpdisj 1 2 (by decide))
      (hpdisj 1 3 (by decide)) (hpdisj 2 3 (by decide))
      (hploc 0) (hploc 1) (hploc 2) (hploc 3)
      (hxavoid 0) (hxavoid 1) (hxavoid 2) (hxavoid 3)
      (hyavoid 0) (hyavoid 1) (hyavoid 2) (hyavoid 3)
      (huavoid 0) (huavoid 1) (huavoid 2) (huavoid 3)
      (hvavoid 0) (hvavoid 1) (hvavoid 2) (hvavoid 3)
  have mateLongAvoid (d : Fin q) (hd : ∀ j : Fin 4, b d ∉ (p j).support) :
      b d ∉ long.support := by
    intro hz
    rcases hlongSupport (b d) hz with hz | hz | hz | hz | hz | hz | hz
    · exact (Finset.disjoint_left.mp hAB) (haA i0) (hz ▸ hbB d)
    · exact (Finset.disjoint_left.mp hAB) (haA iy) (hz ▸ hbB d)
    · exact hd 0 hz
    · exact hd 1 hz
    · exact hd 2 hz
    · exact hd 3 hz
    · exact (Finset.disjoint_left.mp hmajorD)
        (Finset.mem_union_right A (hbB d)) hz
  have mateShortAvoid (d : Fin q) : b d ∉ short.support := by
    intro hz
    rcases hshortloc (b d) hz with hzA | hzD
    · exact (Finset.disjoint_left.mp hAB) hzA (hbB d)
    · exact (Finset.disjoint_left.mp hmajorD)
        (Finset.mem_union_right A (hbB d)) hzD
  have hbxLong := mateLongAvoid i0 hbxavoid
  have hbyLong := mateLongAvoid iy hbyavoid
  have hbuLong := mateLongAvoid iu hbuavoid
  have hbvLong := mateLongAvoid iv hbvavoid
  have hbxShort := mateShortAvoid i0
  have hbyShort := mateShortAvoid iy
  have hbuShort := mateShortAvoid iu
  have hbvShort := mateShortAvoid iv
  let long' : G.Walk x y := long.copy ha0 hay
  let short' : G.Walk u v := short.copy hau hav
  refine ⟨long', short', by simpa [long'] using hlong,
    by simpa [short'] using hshort, ?_, ?_, by simpa [short'] using hshortlen,
    ?_, ?_, ?_⟩
  · simpa [long', short'] using hdisj
  · have hlen0 := hplen 0
    have hlen1 := hplen 1
    have hlen2 := hplen 2
    have hlen3 := hplen 3
    have hsum : len 0 + len 1 + len 2 + len 3 = R := by
      simpa [Fin.sum_univ_succ, Nat.add_assoc] using hlensum
    simpa [long'] using (show long.length = 2 * R + 10 by omega)
  · intro w hw
    exact hlongloc w (by simpa [long'] using hw)
  · intro w hw
    exact hshortloc w (by simpa [short'] using hw)
  · intro z hzmate
    rcases hzmate with hzx | hzy | hzu | hzv
    · have hm : IsCanonicalScaffoldMate G hscaffold (b i0) x := by
        have h := hmate i0
        rw [ha0] at h
        exact h
      have hzEq : z = b i0 :=
        IsCanonicalScaffoldMate.left_unique G hzx hm
      constructor
      · intro hz
        apply hbxLong
        simpa [long', hzEq] using hz
      · intro hz
        apply hbxShort
        simpa [short', hzEq] using hz
    · have hm : IsCanonicalScaffoldMate G hscaffold (b iy) y := by
        have h := hmate iy
        rw [hay] at h
        exact h
      have hzEq : z = b iy :=
        IsCanonicalScaffoldMate.left_unique G hzy hm
      constructor
      · intro hz
        apply hbyLong
        simpa [long', hzEq] using hz
      · intro hz
        apply hbyShort
        simpa [short', hzEq] using hz
    · have hm : IsCanonicalScaffoldMate G hscaffold (b iu) u := by
        have h := hmate iu
        rw [hau] at h
        exact h
      have hzEq : z = b iu :=
        IsCanonicalScaffoldMate.left_unique G hzu hm
      constructor
      · intro hz
        apply hbuLong
        simpa [long', hzEq] using hz
      · intro hz
        apply hbuShort
        simpa [short', hzEq] using hz
    · have hm : IsCanonicalScaffoldMate G hscaffold (b iv) v := by
        have h := hmate iv
        rw [hav] at h
        exact h
      have hzEq : z = b iv :=
        IsCanonicalScaffoldMate.left_unique G hzv hm
      constructor
      · intro hz
        apply hbvLong
        simpa [long', hzEq] using hz
      · intro hz
        apply hbvShort
        simpa [short', hzEq] using hz

/-- Deleting two prescribed core endpoints cuts the alternating cycle into
at most two scaffold arcs.  Any total of at most `q - 4` internal scaffold
steps can be split between those arcs; three robust connectors (only two in
the adjacent-endpoint cases) then give a simple route of length `2*R + 6`. -/
theorem exists_long_route_via_cyclicAlternatingScaffold
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q theta R : ℕ} {A B D : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D)
    (hqfour : 4 ≤ q) (htheta : 3 ≤ theta) (hR : R ≤ q - 4)
    {x y : V} (hxA : x ∈ A) (hyA : y ∈ A) (hxy : x ≠ y) :
    ∃ p : G.Walk x y, p.IsPath ∧ p.length = 2 * R + 6 ∧
      (∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D) ∧
      ∀ z, (IsCanonicalScaffoldMate G hscaffold z x ∨
        IsCanonicalScaffoldMate G hscaffold z y) → z ∉ p.support := by
  classical
  rcases exists_cyclicAlternatingScaffold_data_starting_at
      G hscaffold hxA with
    ⟨hq, a, b, hA, hB, ha, hb, hAB, hab, hba, ha0, hmate⟩
  let i0 : Fin q := ⟨0, hq⟩
  have haA : ∀ i : Fin q, a i ∈ A := by
    intro i
    rw [hA]
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hbB : ∀ i : Fin q, b i ∈ B := by
    intro i
    rw [hB]
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  obtain ⟨d, _hdmem, had⟩ := Finset.mem_image.mp (hA ▸ hyA)
  have hd0 : 0 < d.val := by
    have hdne : d ≠ i0 := by
      intro hd
      apply hxy
      have had0 : a i0 = y := by simpa [hd] using had
      exact ha0.symm.trans had0
    have hdval : d.val ≠ 0 := by
      intro h
      apply hdne
      apply Fin.ext
      exact h
    omega
  have hxy' : a i0 ≠ a d := by
    intro h
    apply hxy
    exact ha0.symm.trans (h.trans had)
  have transport {p : G.Walk (a i0) (a d)}
      (hp : p.IsPath) (hplen : p.length = 2 * R + 6)
      (hploc : ∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D)
      (hbi0 : b i0 ∉ p.support) (hbd : b d ∉ p.support) :
      ∃ p' : G.Walk x y, p'.IsPath ∧ p'.length = 2 * R + 6 ∧
        (∀ w ∈ p'.support, w ∈ A ∪ B ∨ w ∈ D) ∧
        ∀ z, (IsCanonicalScaffoldMate G hscaffold z x ∨
          IsCanonicalScaffoldMate G hscaffold z y) → z ∉ p'.support := by
    let p' : G.Walk x y := p.copy ha0 had
    refine ⟨p', by simpa [p'] using hp, by simpa [p'] using hplen, ?_, ?_⟩
    · intro w hw
      exact hploc w (by simpa [p'] using hw)
    · intro z hzmate hz
      have hzp : z ∈ p.support := by simpa [p'] using hz
      rcases hzmate with hzx | hzy
      · have hmate0 : IsCanonicalScaffoldMate G hscaffold (b i0) x := by
          have h := hmate i0
          rw [ha0] at h
          exact h
        have hzEq : z = b i0 :=
          IsCanonicalScaffoldMate.left_unique G hzx hmate0
        exact hbi0 (hzEq ▸ hzp)
      · have hmated : IsCanonicalScaffoldMate G hscaffold (b d) y := by
          have h := hmate d
          rw [had] at h
          exact h
        have hzEq : z = b d :=
          IsCanonicalScaffoldMate.left_unique G hzy hmated
        exact hbd (hzEq ▸ hzp)
  by_cases hd1 : d.val = 1
  · obtain ⟨p, hp, hplen, hploc, _hbix, _hbiy⟩ :=
      exists_route_via_scaffold_segment_avoiding_indices
        G hq a b ha hb haA hbB hAB hab hba hrob hmajorD
          (by omega) (s := 2) (r := R + 1) (by omega) i0 d
          (by
            intro i hi
            change 0 = 2 + i.val at hi
            omega)
          (by
            intro i hi
            change d.val = 2 + i.val at hi
            omega)
          hxy'
    apply transport hp (by omega) hploc _hbix _hbiy
  · by_cases hdlast : d.val = q - 1
    · obtain ⟨p, hp, hplen, hploc, _hbix, _hbiy⟩ :=
        exists_route_via_scaffold_segment_avoiding_indices
          G hq a b ha hb haA hbB hAB hab hba hrob hmajorD
            (by omega) (s := 1) (r := R + 1) (by omega) i0 d
            (by
              intro i hi
              change 0 = 1 + i.val at hi
              omega)
            (by
              intro i hi
              change d.val = 1 + i.val at hi
              have hiLt := i.isLt
              omega)
            hxy'
      apply transport hp (by omega) hploc _hbix _hbiy
    · have hdlo : 2 ≤ d.val := by omega
      have hdhi : d.val ≤ q - 2 := by omega
      let c₀ : ℕ := d.val - 2
      let c₁ : ℕ := q - d.val - 2
      let r₀ : ℕ := min R c₀
      let r₁ : ℕ := R - r₀
      have hcSum : c₀ + c₁ = q - 4 := by
        dsimp [c₀, c₁]
        omega
      have hr₀le : r₀ ≤ c₀ := by simp [r₀]
      have hr₀R : r₀ ≤ R := by simp [r₀]
      have hrsum : r₀ + r₁ = R := by
        dsimp [r₁]
        omega
      have hr₁le : r₁ ≤ c₁ := by
        by_cases hRc : R ≤ c₀
        · have hr₀eq : r₀ = R := Nat.min_eq_left hRc
          simp [r₁, hr₀eq]
        · have hc₀R : c₀ ≤ R := Nat.le_of_not_ge hRc
          have hr₀eq : r₀ = c₀ := Nat.min_eq_right hc₀R
          dsimp [r₁]
          rw [hr₀eq]
          omega
      let ea₀ : Fin (r₀ + 1) → Fin q := fun i => ⟨1 + i.val, by omega⟩
      let eb₀ : Fin r₀ → Fin q := fun i => ⟨1 + i.val, by omega⟩
      let ea₁ : Fin (r₁ + 1) → Fin q := fun i => ⟨d.val + 1 + i.val, by omega⟩
      let eb₁ : Fin r₁ → Fin q := fun i => ⟨d.val + 1 + i.val, by omega⟩
      have habdisj : ∀ i j : Fin q, a i ≠ b j := by
        intro i j hij
        exact (Finset.disjoint_left.mp hAB) (haA i) (hij ▸ hbB j)
      obtain ⟨p₀, hp₀, hp₀len, hp₀supp⟩ :=
        exists_segment_path_of_cyclicAlternatingScaffold_data
          G hq a b ha hb habdisj hab hba
            (s := 1) (r := r₀) (by
              dsimp [c₀] at hr₀le
              omega)
      obtain ⟨p₁, hp₁, hp₁len, hp₁supp⟩ :=
        exists_segment_path_of_cyclicAlternatingScaffold_data
          G hq a b ha hb habdisj hab hba
            (s := d.val + 1) (r := r₁) (by
              dsimp [c₁] at hr₁le
              omega)
      change ∀ v ∈ p₀.support,
        (∃ i : Fin (r₀ + 1), a (ea₀ i) = v) ∨
          ∃ j : Fin r₀, b (eb₀ j) = v at hp₀supp
      change ∀ v ∈ p₁.support,
        (∃ i : Fin (r₁ + 1), a (ea₁ i) = v) ∨
          ∃ j : Fin r₁, b (eb₁ j) = v at hp₁supp
      have hp₀loc : ∀ w ∈ p₀.support, w ∈ A ∪ B := by
        intro w hw
        rcases hp₀supp w hw with ⟨i, rfl⟩ | ⟨i, rfl⟩
        · exact Finset.mem_union_left _ (haA (ea₀ i))
        · exact Finset.mem_union_right _ (hbB (eb₀ i))
      have hp₁loc : ∀ w ∈ p₁.support, w ∈ A ∪ B := by
        intro w hw
        rcases hp₁supp w hw with ⟨i, rfl⟩ | ⟨i, rfl⟩
        · exact Finset.mem_union_left _ (haA (ea₁ i))
        · exact Finset.mem_union_right _ (hbB (eb₁ i))
      have hx₀ : a i0 ∉ p₀.support := by
        intro hx
        rcases hp₀supp (a i0) hx with ⟨i, hi⟩ | ⟨i, hi⟩
        · have := congrArg Fin.val ((ha hi).symm : i0 = ea₀ i)
          dsimp [i0, ea₀] at this
          omega
        · exact (Finset.disjoint_left.mp hAB) (haA i0) (hi ▸ hbB (eb₀ i))
      have hx₁ : a i0 ∉ p₁.support := by
        intro hx
        rcases hp₁supp (a i0) hx with ⟨i, hi⟩ | ⟨i, hi⟩
        · have := congrArg Fin.val ((ha hi).symm : i0 = ea₁ i)
          dsimp [i0, ea₁] at this
          omega
        · exact (Finset.disjoint_left.mp hAB) (haA i0) (hi ▸ hbB (eb₁ i))
      have hy₀ : a d ∉ p₀.support := by
        intro hy
        rcases hp₀supp (a d) hy with ⟨i, hi⟩ | ⟨i, hi⟩
        · have := congrArg Fin.val ((ha hi).symm : d = ea₀ i)
          have hiLt : i.val < r₀ + 1 := i.isLt
          dsimp [ea₀] at this hiLt
          dsimp [c₀] at hr₀le
          omega
        · exact (Finset.disjoint_left.mp hAB) (haA d) (hi ▸ hbB (eb₀ i))
      have hy₁ : a d ∉ p₁.support := by
        intro hy
        rcases hp₁supp (a d) hy with ⟨i, hi⟩ | ⟨i, hi⟩
        · have := congrArg Fin.val ((ha hi).symm : d = ea₁ i)
          dsimp [ea₁] at this
          omega
        · exact (Finset.disjoint_left.mp hAB) (haA d) (hi ▸ hbB (eb₁ i))
      have hbi0₀ : b i0 ∉ p₀.support := by
        intro hz
        rcases hp₀supp (b i0) hz with ⟨i, hi⟩ | ⟨i, hi⟩
        · exact (Finset.disjoint_left.mp hAB) (haA (ea₀ i)) (hi ▸ hbB i0)
        · have heq : eb₀ i = i0 := hb hi
          have hval := congrArg Fin.val heq
          dsimp [eb₀, i0] at hval
          omega
      have hbi0₁ : b i0 ∉ p₁.support := by
        intro hz
        rcases hp₁supp (b i0) hz with ⟨i, hi⟩ | ⟨i, hi⟩
        · exact (Finset.disjoint_left.mp hAB) (haA (ea₁ i)) (hi ▸ hbB i0)
        · have heq : eb₁ i = i0 := hb hi
          have hval := congrArg Fin.val heq
          dsimp [eb₁, i0] at hval
          omega
      have hbd₀ : b d ∉ p₀.support := by
        intro hz
        rcases hp₀supp (b d) hz with ⟨i, hi⟩ | ⟨i, hi⟩
        · exact (Finset.disjoint_left.mp hAB) (haA (ea₀ i)) (hi ▸ hbB d)
        · have heq : eb₀ i = d := hb hi
          have hval := congrArg Fin.val heq
          have hiLt := i.isLt
          dsimp [eb₀] at hval
          dsimp [c₀] at hr₀le
          omega
      have hbd₁ : b d ∉ p₁.support := by
        intro hz
        rcases hp₁supp (b d) hz with ⟨i, hi⟩ | ⟨i, hi⟩
        · exact (Finset.disjoint_left.mp hAB) (haA (ea₁ i)) (hi ▸ hbB d)
        · have heq : eb₁ i = d := hb hi
          have hval := congrArg Fin.val heq
          dsimp [eb₁] at hval
          omega
      have hpdisj : p₀.support.Disjoint p₁.support := by
        intro w hw₀ hw₁
        rcases hp₀supp w hw₀ with ⟨i, hi⟩ | ⟨i, hi⟩ <;>
          rcases hp₁supp w hw₁ with ⟨j, hj⟩ | ⟨j, hj⟩
        · have heq : ea₀ i = ea₁ j := ha (hi.trans hj.symm)
          have hval := congrArg Fin.val heq
          have hiLt : i.val < r₀ + 1 := i.isLt
          dsimp [ea₀, ea₁] at hval hiLt
          dsimp [c₀] at hr₀le
          omega
        · exact (Finset.disjoint_left.mp hAB)
            (haA (ea₀ i)) (hi ▸ hj ▸ hbB (eb₁ j))
        · exact (Finset.disjoint_left.mp hAB)
            (haA (ea₁ j)) (hj ▸ hi ▸ hbB (eb₀ i))
        · have heq : eb₀ i = eb₁ j := hb (hi.trans hj.symm)
          have hval := congrArg Fin.val heq
          have hiLt : i.val < r₀ := i.isLt
          dsimp [eb₀, eb₁] at hval hiLt
          dsimp [c₀] at hr₀le
          omega
      obtain ⟨p, hp, hplen, hploc, hpsupport⟩ :=
        exists_path_joining_two_disjoint_major_paths
          G hrob hmajorD htheta
          (haA i0) (haA d)
          (haA (ea₀ 0)) (haA (ea₀ (Fin.last r₀)))
          (haA (ea₁ 0)) (haA (ea₁ (Fin.last r₁)))
          hp₀ hp₁ hpdisj hp₀loc hp₁loc hx₀ hx₁ hy₀ hy₁ hxy'
      have hbi0p : b i0 ∉ p.support := by
        intro hz
        rcases hpsupport (b i0) hz with hz | hz | hz | hz | hz
        · exact (Finset.disjoint_left.mp hAB) (haA i0) (hz ▸ hbB i0)
        · exact (Finset.disjoint_left.mp hAB) (haA d) (hz ▸ hbB i0)
        · exact hbi0₀ hz
        · exact hbi0₁ hz
        · exact (Finset.disjoint_left.mp hmajorD)
            (Finset.mem_union_right A (hbB i0)) hz
      have hbdp : b d ∉ p.support := by
        intro hz
        rcases hpsupport (b d) hz with hz | hz | hz | hz | hz
        · exact (Finset.disjoint_left.mp hAB) (haA i0) (hz ▸ hbB d)
        · exact (Finset.disjoint_left.mp hAB) (haA d) (hz ▸ hbB d)
        · exact hbd₀ hz
        · exact hbd₁ hz
        · exact (Finset.disjoint_left.mp hmajorD)
            (Finset.mem_union_right A (hbB d)) hz
      apply transport hp (by
        rw [hplen, hp₀len, hp₁len]
        omega) hploc hbi0p hbdp

/-- Sharp endpoint-to-endpoint specialization of the cut-and-rejoin route:
using all `q - 4` available internal scaffold steps gives length `2*q - 2`. -/
theorem exists_full_route_via_cyclicAlternatingScaffold
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q theta : ℕ} {A B D : Finset V}
    (hscaffold : IsCyclicAlternatingScaffold G q A B)
    (hrob : RobustPairSet G A D theta)
    (hmajorD : Disjoint (A ∪ B) D)
    (hqfour : 4 ≤ q) (htheta : 3 ≤ theta)
    {x y : V} (hxA : x ∈ A) (hyA : y ∈ A) (hxy : x ≠ y) :
    ∃ p : G.Walk x y, p.IsPath ∧ p.length = 2 * q - 2 ∧
      ∀ w ∈ p.support, w ∈ A ∪ B ∨ w ∈ D := by
  obtain ⟨p, hp, hplen, hploc, _havoid⟩ :=
    exists_long_route_via_cyclicAlternatingScaffold
      G hscaffold hrob hmajorD hqfour htheta
        (R := q - 4) (by omega) hxA hyA hxy
  refine ⟨p, hp, ?_, hploc⟩
  omega

/-- A robust pair admits a zero-or-two-edge local route between arbitrary
displayed endpoints.  Equal endpoints use the nil walk; distinct endpoints
use one fresh common neighbour.  This is the short-route mechanism for the
root-side part of a mixed selected/BFS auxiliary cycle, where two incident
ordinary cross-edges are allowed to share their attachment. -/
theorem exists_short_even_route_of_robustPairSet
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {theta : ℕ}
    (hrob : RobustPairSet G U T theta)
    (hUcard : 2 ≤ U.card) (htheta : 3 ≤ theta)
    {a b : V} (ha : a ∈ U) (hb : b ∈ U) :
    ∃ p : G.Walk a b, p.IsPath ∧ Even p.length ∧ p.length ≤ 2 ∧
      ∀ z ∈ p.support, z ∈ U ∨ z ∈ T := by
  classical
  by_cases hab : a = b
  · subst b
    refine ⟨Walk.nil, by simp, by simp, by simp, ?_⟩
    intro z hz
    have hza : z = a := by simpa using hz
    subst z
    exact Or.inl ha
  · obtain ⟨p, hp, hplen, _havoid, hploc⟩ :=
      exists_even_path_between_of_robustPairSet_avoiding
        G (F := ∅) (r := 0) hrob ha hb (by simp) (by simp) hab
          (by simpa using hUcard) (by simpa using htheta)
    refine ⟨p, hp, ?_, ?_, hploc⟩
    · rw [hplen]
      exact even_two
    · omega

/-- Mixed local routing over pairwise-disjoint hubs.  Marked visits use the
full alternating-scaffold route and therefore carry an arbitrary weight up
to `q - 4`; unmarked visits use the zero-or-two-edge robust route and do not
require distinct attachments.  Since the hub labels are injective, region
disjointness makes all chosen routes pairwise vertex-disjoint automatically.
This separates the high-capacity selected prefix from the short ordinary
BFS return in the eventual hybrid cycle lift. -/
theorem exists_mixed_alternatingScaffold_routes_fin
    {V ι : Type*} [Fintype V] {t q theta : ℕ}
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = q)
    (hq : 4 ≤ q) (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (f : Fin t → ι) (hfinj : Function.Injective f)
    (strong : Fin t → Prop)
    (a b : Fin t → V)
    (ha : ∀ i, a i ∈ A (f i)) (hb : ∀ i, b i ∈ A (f i))
    (hab : ∀ i, strong i → a i ≠ b i)
    (weight : Fin t → ℕ)
    (hweight : ∀ i, strong i → weight i ≤ q - 4) :
    ∃ route : ∀ i : Fin t, G.Walk (a i) (b i),
      (∀ i, (route i).IsPath) ∧
      (∀ i j, i ≠ j → (route i).support.Disjoint (route j).support) ∧
      (∀ i, ∀ z ∈ (route i).support,
        z ∈ (A (f i) ∪ B (f i)) ∨ z ∈ D (f i)) ∧
      (∀ i, strong i → (route i).length = 2 * weight i + 6) ∧
      ∀ i, ¬ strong i → Even (route i).length ∧ (route i).length ≤ 2 := by
  classical
  have hexists : ∀ i : Fin t,
      ∃ p : G.Walk (a i) (b i),
        p.IsPath ∧
        (∀ z ∈ p.support,
          z ∈ (A (f i) ∪ B (f i)) ∨ z ∈ D (f i)) ∧
        (strong i → p.length = 2 * weight i + 6) ∧
        (¬ strong i → Even p.length ∧ p.length ≤ 2) := by
    intro i
    by_cases hi : strong i
    · obtain ⟨p, hp, hplen, hploc, _havoid⟩ :=
        exists_long_route_via_cyclicAlternatingScaffold
          G (hscaffold (f i)) (hrob (f i)) (hmajorD (f i))
            hq htheta (hweight i hi) (ha i) (hb i) (hab i hi)
      exact ⟨p, hp, hploc, fun _ => hplen, fun h => (h hi).elim⟩
    · obtain ⟨p, hp, hpeven, hplen, hploc⟩ :=
        exists_short_even_route_of_robustPairSet
          G (hrob (f i)) (by rw [hAcard]; omega) htheta (ha i) (hb i)
      refine ⟨p, hp, ?_, fun h => (hi h).elim, fun _ => ⟨hpeven, hplen⟩⟩
      intro z hz
      rcases hploc z hz with hzA | hzD
      · exact Or.inl (Finset.mem_union_left _ hzA)
      · exact Or.inr hzD
  choose route hroute hrouteLoc hrouteStrong hrouteWeak using hexists
  refine ⟨route, hroute, ?_, hrouteLoc, hrouteStrong, hrouteWeak⟩
  intro i j hij z hzi hzj
  have hfij : f i ≠ f j := fun h => hij (hfinj h)
  have hzi' : z ∈ (A (f i) ∪ B (f i)) ∪ D (f i) := by
    rcases hrouteLoc i z hzi with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ h
  have hzj' : z ∈ (A (f j) ∪ B (f j)) ∪ D (f j) := by
    rcases hrouteLoc j z hzj with h | h
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ h
  exact Finset.disjoint_left.mp (hregions (f i) (f j) hfij) hzi' hzj'

/-- The hub position visited at a given step of the doubled traversal of a
path with `d+1` edges: first traverse all `d+2` vertices forwards, then the
`d` internal vertices backwards. -/
def doubledPathPosition (d : ℕ) : Fin ((d + 2) + d) → Fin (d + 2) :=
  Fin.addCases (fun j => j) (fun j => (Fin.rev j).castSucc.succ)

/-- The doubled-path position map agrees with the vertex sequence of the
closed walk obtained by traversing a path and then its reverse. -/
theorem getVert_append_reverse_eq_doubledPathPosition
    {V : Type*} {H : SimpleGraph V} {u v : V} (w : H.Walk u v)
    {d : ℕ} (hwlen : w.length = d + 1)
    (i : Fin ((d + 2) + d)) :
    (w.append w.reverse).getVert i.val =
      w.getVert (doubledPathPosition d i).val := by
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · rw [Walk.getVert_append']
    have hj := j.isLt
    rw [if_pos (by
      change j.val ≤ w.length
      rw [hwlen]
      omega)]
    simp [doubledPathPosition]
  · rw [Walk.getVert_append']
    have hj := j.isLt
    rw [if_neg (by simp [hwlen]; omega)]
    rw [Walk.getVert_reverse]
    apply congrArg w.getVert
    simp [doubledPathPosition, hwlen]
    omega

/-- Route family for the doubled traversal of a simple auxiliary path of
length `d+1`.  The two endpoint hubs occur once and use one long route;
every internal hub occurs twice and uses the disjoint long/short scaffold
pair.  The total internal length is exactly
`2 * sum(weight) + 12 * (d+1)`. -/
theorem exists_doubled_path_alternatingScaffold_routes
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) {u v : ι} (w : H.Walk u v)
    {d q theta : ℕ} (hwlen : w.length = d + 1) (hwpath : w.IsPath)
    (A B D : ι → Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 8 ≤ q) (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (weight : Fin (d + 2) → ℕ) (hweight : ∀ i, weight i ≤ q - 8)
    (a b : Fin ((d + 2) + d) → V)
    (ha : ∀ i, a i ∈ A (w.getVert (doubledPathPosition d i).val))
    (hb : ∀ i, b i ∈ A (w.getVert (doubledPathPosition d i).val))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j) :
    ∃ route : ∀ i : Fin ((d + 2) + d), G.Walk (a i) (b i),
      (∀ i, (route i).IsPath) ∧
      (∀ i j, i ≠ j → (route i).support.Disjoint (route j).support) ∧
      (∑ i, (route i).length) = 2 * (∑ i, weight i) + 12 * (d + 1) ∧
      (route 0).length = 2 * weight 0 + 6 ∧
      (∀ i, ∀ z ∈ (route i).support,
        z ∈ (A (w.getVert (doubledPathPosition d i).val) ∪
          B (w.getVert (doubledPathPosition d i).val)) ∨
        z ∈ D (w.getVert (doubledPathPosition d i).val)) ∧
      ∀ i j z, (IsCanonicalScaffoldMate G
            (hscaffold (w.getVert (doubledPathPosition d j).val)) z (a j) ∨
          IsCanonicalScaffoldMate G
            (hscaffold (w.getVert (doubledPathPosition d j).val)) z (b j)) →
        z ∉ (route i).support := by
  classical
  let pos : Fin ((d + 2) + d) → Fin (d + 2) :=
    doubledPathPosition d
  let fwd : Fin (d + 2) → Fin ((d + 2) + d) := Fin.castAdd d
  let back : Fin d → Fin ((d + 2) + d) := Fin.natAdd (d + 2)
  let mid : Fin d → Fin (d + 2) := fun j => j.castSucc.succ
  have hposFwd : ∀ j : Fin (d + 2), pos (fwd j) = j := by
    intro j
    simp [pos, fwd, doubledPathPosition]
  have hposBack : ∀ j : Fin d, pos (back j) = (Fin.rev j).castSucc.succ := by
    intro j
    simp [pos, back, doubledPathPosition]
  have hposPair : ∀ j : Fin d, pos (back (Fin.rev j)) = mid j := by
    intro j
    simp [hposBack, mid]
  let first : Fin ((d + 2) + d) := fwd 0
  let last : Fin ((d + 2) + d) := fwd (Fin.last (d + 1))
  obtain ⟨pFirst, hpFirst, hpFirstLen, hpFirstLoc, hpFirstAvoid⟩ :=
    exists_long_route_via_cyclicAlternatingScaffold
      G (hscaffold (w.getVert 0)) (hrob (w.getVert 0))
        (hmajorD (w.getVert 0)) (by omega) (by omega)
        ((hweight 0).trans (by omega))
        (by simpa [first, fwd, doubledPathPosition] using ha first)
        (by simpa [first, fwd, doubledPathPosition] using hb first) (hab first)
  obtain ⟨pLast, hpLast, hpLastLen, hpLastLoc, hpLastAvoid⟩ :=
    exists_long_route_via_cyclicAlternatingScaffold
      G (hscaffold (w.getVert (d + 1))) (hrob (w.getVert (d + 1)))
        (hmajorD (w.getVert (d + 1))) (by omega) (by omega)
        ((hweight (Fin.last (d + 1))).trans (by omega))
        (by simpa [last, fwd, doubledPathPosition] using ha last)
        (by simpa [last, fwd, doubledPathPosition] using hb last) (hab last)
  have hvisitNe : ∀ j : Fin d, fwd (mid j) ≠ back (Fin.rev j) := by
    intro j h
    have := congrArg Fin.val h
    have hj := j.isLt
    simp [fwd, back, mid] at this
    omega
  choose pLong pShort hpLong hpShort hpPairDisj hpLongLen hpShortLen
      hpLongLoc hpShortLoc hpMateAvoid using fun j : Fin d =>
    exists_disjoint_long_and_short_routes_via_cyclicAlternatingScaffold
      G (hscaffold (w.getVert (mid j).val))
        (hrob (w.getVert (mid j).val))
        (hmajorD (w.getVert (mid j).val)) hq htheta (hweight (mid j))
        (by simpa [fwd, mid, doubledPathPosition] using ha (fwd (mid j)))
        (by simpa [fwd, mid, doubledPathPosition] using hb (fwd (mid j)))
        (by simpa [back, mid, doubledPathPosition] using ha (back (Fin.rev j)))
        (by simpa [back, mid, doubledPathPosition] using hb (back (Fin.rev j)))
        (hab (fwd (mid j)))
        (hpairs (fwd (mid j)) (back (Fin.rev j)) (hvisitNe j)).1
        (hpairs (fwd (mid j)) (back (Fin.rev j)) (hvisitNe j)).2.1
        (hpairs (fwd (mid j)) (back (Fin.rev j)) (hvisitNe j)).2.2.1
        (hpairs (fwd (mid j)) (back (Fin.rev j)) (hvisitNe j)).2.2.2
        (hab (back (Fin.rev j)))
  let forward : ∀ j : Fin (d + 2), G.Walk (a (fwd j)) (b (fwd j)) :=
    Fin.cases pFirst
      (fun t : Fin (d + 1) => Fin.lastCases pLast pLong t)
  have hforwardPath : ∀ j, (forward j).IsPath := by
    intro j
    refine Fin.cases ?_ (fun t => ?_) j
    · simpa [forward] using hpFirst
    · refine Fin.lastCases ?_ (fun i => ?_) t
      · simpa only [forward, Fin.cases_succ, Fin.lastCases_last] using hpLast
      · simpa [forward, mid] using hpLong i
  have hforwardLoc : ∀ j, ∀ z ∈ (forward j).support,
      z ∈ A (w.getVert j.val) ∪ B (w.getVert j.val) ∨
        z ∈ D (w.getVert j.val) := by
    intro j
    refine Fin.cases ?_ (fun t => ?_) j
    · simpa [forward] using hpFirstLoc
    · refine Fin.lastCases ?_ (fun i => ?_) t
      · simpa only [forward, Fin.cases_succ, Fin.lastCases_last,
          Fin.val_succ, Fin.val_last] using hpLastLoc
      · simpa [forward, mid] using hpLongLoc i
  let backward : ∀ j : Fin d, G.Walk (a (back j)) (b (back j)) :=
    fun j => (pShort (Fin.rev j)).copy (by simp [back]) (by simp [back])
  have hbackwardPath : ∀ j, (backward j).IsPath := by
    intro j
    simpa [backward] using hpShort (Fin.rev j)
  have hbackwardLoc : ∀ j, ∀ z ∈ (backward j).support,
      z ∈ A (w.getVert ((Fin.rev j).val + 1)) ∨
        z ∈ D (w.getVert ((Fin.rev j).val + 1)) := by
    intro j
    simpa [backward, mid] using hpShortLoc (Fin.rev j)
  let route : ∀ i : Fin ((d + 2) + d), G.Walk (a i) (b i) :=
    Fin.addCases forward backward
  have hroutePath : ∀ i, (route i).IsPath := by
    intro i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    ·
      simpa [route, fwd] using hforwardPath j
    ·
      simpa [route, back] using hbackwardPath j
  have hrouteLoc : ∀ i, ∀ z ∈ (route i).support,
      z ∈ (A (w.getVert (pos i).val) ∪ B (w.getVert (pos i).val)) ∨
        z ∈ D (w.getVert (pos i).val) := by
    intro i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    ·
      simpa [route, fwd, hposFwd] using hforwardLoc j
    ·
      intro z hz
      rcases hbackwardLoc j z (by simpa [route, back] using hz) with h | h
      · exact Or.inl (Finset.mem_union_left _ (by
          simpa [pos, back, doubledPathPosition] using h))
      · exact Or.inr (by simpa [pos, back, doubledPathPosition] using h)
  have hforwardMateAvoid : ∀ j z,
      (IsCanonicalScaffoldMate G (hscaffold (w.getVert j.val))
          z (a (fwd j)) ∨
        IsCanonicalScaffoldMate G (hscaffold (w.getVert j.val))
          z (b (fwd j))) → z ∉ (forward j).support := by
    intro j
    refine Fin.cases ?_ (fun t => ?_) j
    · intro z hz
      simpa [forward, fwd] using hpFirstAvoid z (by simpa [fwd] using hz)
    · refine Fin.lastCases ?_ (fun i => ?_) t
      · intro z hz
        simpa only [forward, Fin.cases_succ, Fin.lastCases_last,
            Fin.val_succ, Fin.val_last] using
          hpLastAvoid z (by
            simpa [last, fwd, doubledPathPosition] using hz)
      · intro z hz
        have hz' := (by
          simpa [fwd, mid, doubledPathPosition] using hz)
        simpa [forward, mid] using
          (hpMateAvoid i z (hz'.elim Or.inl (fun h => Or.inr (Or.inl h)))).1
  have hbackwardMateAvoid : ∀ j z,
      (IsCanonicalScaffoldMate G
          (hscaffold (w.getVert ((Fin.rev j).val + 1))) z (a (back j)) ∨
        IsCanonicalScaffoldMate G
          (hscaffold (w.getVert ((Fin.rev j).val + 1))) z (b (back j))) →
        z ∉ (backward j).support := by
    intro j z hz
    have hbackrev : back (Fin.rev (Fin.rev j)) = back j := by
      rw [Fin.rev_rev]
    have hz' :
        IsCanonicalScaffoldMate G
            (hscaffold (w.getVert (mid (Fin.rev j)).val)) z
              (a (back (Fin.rev (Fin.rev j)))) ∨
          IsCanonicalScaffoldMate G
            (hscaffold (w.getVert (mid (Fin.rev j)).val)) z
              (b (back (Fin.rev (Fin.rev j)))) := by
      simpa [back, mid, doubledPathPosition, hbackrev] using hz
    have h := (hpMateAvoid (Fin.rev j) z
      (hz'.elim (fun h => Or.inr (Or.inr (Or.inl h)))
        (fun h => Or.inr (Or.inr (Or.inr h))))).2
    simpa [backward] using h
  have hsamePosMateAvoid : ∀ i j z, pos i = pos j →
      (IsCanonicalScaffoldMate G (hscaffold (w.getVert (pos j).val)) z (a j) ∨
        IsCanonicalScaffoldMate G (hscaffold (w.getVert (pos j).val)) z (b j)) →
      z ∉ (route i).support := by
    intro i
    refine Fin.addCases (fun fi => ?_) (fun bi => ?_) i
    · intro j
      refine Fin.addCases (fun fj => ?_) (fun bj => ?_) j
      · intro z hposij hz
        have hfi : fi = fj := by
          simpa [pos, fwd, doubledPathPosition] using hposij
        subst fj
        simpa [route, fwd, pos, doubledPathPosition] using
          hforwardMateAvoid fi z (by
            simpa [pos, fwd, doubledPathPosition] using hz)
      · intro z hposij hz
        have hfi : fi = (Fin.rev bj).castSucc.succ := by
          simpa [pos, fwd, back, doubledPathPosition] using hposij
        subst fi
        have hbackrev : back (Fin.rev (Fin.rev bj)) = back bj := by
          rw [Fin.rev_rev]
        have hz' :
            IsCanonicalScaffoldMate G
                (hscaffold (w.getVert (mid (Fin.rev bj)).val)) z
                  (a (back (Fin.rev (Fin.rev bj)))) ∨
              IsCanonicalScaffoldMate G
                (hscaffold (w.getVert (mid (Fin.rev bj)).val)) z
                  (b (back (Fin.rev (Fin.rev bj)))) := by
          simpa [pos, fwd, back, mid, doubledPathPosition, hbackrev] using hz
        simpa [route, fwd, forward, mid] using
          (hpMateAvoid (Fin.rev bj) z
            (hz'.elim (fun h => Or.inr (Or.inr (Or.inl h)))
              (fun h => Or.inr (Or.inr (Or.inr h))))).1
    · intro j
      refine Fin.addCases (fun fj => ?_) (fun bj => ?_) j
      · intro z hposij hz
        have hfj : fj = (Fin.rev bi).castSucc.succ := by
          simpa [pos, fwd, back, doubledPathPosition] using hposij.symm
        subst fj
        have hz' := (by
          simpa [pos, fwd, back, mid, doubledPathPosition] using hz)
        have h := (hpMateAvoid (Fin.rev bi) z
          (hz'.elim Or.inl (fun h => Or.inr (Or.inl h)))).2
        simpa [route, back, backward] using h
      · intro z hposij hz
        have hrev : Fin.rev bi = Fin.rev bj := by
          simpa [pos, back, doubledPathPosition] using hposij
        have hij : bi = bj := Fin.rev_injective hrev
        subst bj
        simpa [route, back, pos, doubledPathPosition] using
          hbackwardMateAvoid bi z (by
            simpa [pos, back, doubledPathPosition] using hz)
  have hdisjoint_of_pos_ne : ∀ i j, pos i ≠ pos j →
      (route i).support.Disjoint (route j).support := by
    intro i j hij z hzi hzj
    have hhubNe : w.getVert (pos i).val ≠ w.getVert (pos j).val := by
      intro h
      apply hij
      apply Fin.ext
      exact hwpath.getVert_injOn (by simp; omega) (by simp; omega) h
    have hzi' : z ∈ (A (w.getVert (pos i).val) ∪
        B (w.getVert (pos i).val)) ∪ D (w.getVert (pos i).val) := by
      rcases hrouteLoc i z hzi with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    have hzj' : z ∈ (A (w.getVert (pos j).val) ∪
        B (w.getVert (pos j).val)) ∪ D (w.getVert (pos j).val) := by
      rcases hrouteLoc j z hzj with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    exact Finset.disjoint_left.mp (hregions _ _ hhubNe) hzi' hzj'
  have hsamePosDisj : ∀ i j, i ≠ j → pos i = pos j →
      (route i).support.Disjoint (route j).support := by
    intro i
    refine Fin.addCases (fun fi => ?_) (fun bi => ?_) i
    · intro j
      refine Fin.addCases (fun fj => ?_) (fun bj => ?_) j
      · intro hij hposij
        exfalso
        apply hij
        have : fi = fj := by
          simpa [pos, fwd, doubledPathPosition] using hposij
        subst fj
        rfl
      · intro _hij hposij
        have hfi : fi = (Fin.rev bj).castSucc.succ := by
          simpa [pos, fwd, back, doubledPathPosition] using hposij
        subst fi
        simpa [route, fwd, back, forward, backward, mid] using
          hpPairDisj (Fin.rev bj)
    · intro j
      refine Fin.addCases (fun fj => ?_) (fun bj => ?_) j
      · intro _hij hposij
        have hfj : fj = (Fin.rev bi).castSucc.succ := by
          simpa [pos, fwd, back, doubledPathPosition] using hposij.symm
        subst fj
        simpa [route, fwd, back, forward, backward, mid] using
          (hpPairDisj (Fin.rev bi)).symm
      · intro hij hposij
        exfalso
        apply hij
        have hrev : Fin.rev bi = Fin.rev bj := by
          simpa [pos, back, doubledPathPosition] using hposij
        have : bi = bj := Fin.rev_injective hrev
        subst bj
        rfl
  have hrouteDisj : ∀ i j, i ≠ j →
      (route i).support.Disjoint (route j).support := by
    intro i j hij
    by_cases hposij : pos i = pos j
    · exact hsamePosDisj i j hij hposij
    · exact hdisjoint_of_pos_ne i j hposij
  have hforwardSum : (∑ j : Fin (d + 2), (forward j).length) =
      2 * (∑ j : Fin (d + 2), weight j) + 10 * d + 12 := by
    have hlong : ∀ j : Fin d,
        (forward (j.castSucc.succ)).length = 2 * weight (mid j) + 10 := by
      intro j
      simpa [forward, mid] using hpLongLen j
    have hfirst : (forward 0).length = 2 * weight 0 + 6 := by
      simpa [forward] using hpFirstLen
    have hlast : (forward (Fin.last d).succ).length =
        2 * weight (Fin.last d).succ + 6 := by
      have hpLastLen' : pLast.length =
          2 * weight (Fin.last d).succ + 6 := by
        simpa using hpLastLen
      simpa only [forward, Fin.cases_succ, Fin.lastCases_last] using hpLastLen'
    rw [Fin.sum_univ_succ]
    rw [Fin.sum_univ_castSucc]
    have hweights : (∑ j : Fin (d + 2), weight j) =
        weight 0 + (∑ j : Fin d, weight (mid j)) +
          weight (Fin.last d).succ := by
      rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc]
      simp [mid, Nat.add_assoc]
    rw [hfirst, hlast]
    simp_rw [hlong]
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    simp
    simp [mid] at hweights ⊢
    omega
  have hbackwardSum : (∑ j : Fin d, (backward j).length) = 2 * d := by
    have hshort : ∀ j : Fin d, (backward j).length = 2 := by
      intro j
      simpa [backward] using hpShortLen (Fin.rev j)
    simp_rw [hshort]
    simp [Nat.mul_comm]
  have hrouteSum : (∑ i, (route i).length) =
      2 * (∑ j, weight j) + 12 * (d + 1) := by
    rw [Fin.sum_univ_add]
    simp only [route, Fin.addCases_left, Fin.addCases_right]
    rw [hforwardSum, hbackwardSum]
    omega
  refine ⟨route, hroutePath, hrouteDisj, hrouteSum, ?_, ?_, ?_⟩
  · have hzero : (0 : Fin ((d + 2) + d)) =
        Fin.castAdd d (0 : Fin (d + 2)) := by
      apply Fin.ext
      simp
    calc
      (route 0).length = (route (Fin.castAdd d (0 : Fin (d + 2)))).length := by
        rw [hzero]
      _ = (forward 0).length := by simp [route]
      _ = 2 * weight 0 + 6 := by simpa [forward] using hpFirstLen
  · simpa [pos] using hrouteLoc
  · intro i j z hz
    by_cases hij : pos i = pos j
    · exact hsamePosMateAvoid i j z hij (by simpa [pos] using hz)
    · intro hzi
      have hhubNe : w.getVert (pos i).val ≠ w.getVert (pos j).val := by
        intro h
        apply hij
        apply Fin.ext
        exact hwpath.getVert_injOn (by simp; omega) (by simp; omega) h
      have hzi' : z ∈ (A (w.getVert (pos i).val) ∪
          B (w.getVert (pos i).val)) ∪ D (w.getVert (pos i).val) := by
        rcases hrouteLoc i z hzi with h | h
        · exact Finset.mem_union_left _ h
        · exact Finset.mem_union_right _ h
      have hzB : z ∈ B (w.getVert (pos j).val) := by
        rcases hz with hz | hz
        · exact IsCanonicalScaffoldMate.mem_left G (by simpa [pos] using hz)
        · exact IsCanonicalScaffoldMate.mem_left G (by simpa [pos] using hz)
      have hzj' : z ∈ (A (w.getVert (pos j).val) ∪
          B (w.getVert (pos j).val)) ∪ D (w.getVert (pos j).val) :=
        Finset.mem_union_left _ (Finset.mem_union_right _ hzB)
      exact Finset.disjoint_left.mp (hregions _ _ hhubNe) hzi' hzj'

/-- Odd-parity version of the doubled-path route family.  The first endpoint
hub is visited only once, so a three-edge matching in that core supplies an
internal edge avoiding the two attachments.  Replacing the ordinary
six-edge endpoint route by the resulting five-edge route changes the total
length by exactly one without affecting any other hub. -/
theorem exists_doubled_path_alternatingScaffold_routes_odd_first
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) {u v : ι} (w : H.Walk u v)
    {d q theta : ℕ} (hwlen : w.length = d + 1) (hwpath : w.IsPath)
    (A B D : ι → Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 8 ≤ q) (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hmatch : HasThreeDisjointAdjPairFamily G (A (w.getVert 0)))
    (weight : Fin (d + 2) → ℕ) (hweight : ∀ i, weight i ≤ q - 8)
    (hweightZero : weight 0 = 0)
    (a b : Fin ((d + 2) + d) → V)
    (ha : ∀ i, a i ∈ A (w.getVert (doubledPathPosition d i).val))
    (hb : ∀ i, b i ∈ A (w.getVert (doubledPathPosition d i).val))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j) :
    ∃ route : ∀ i : Fin ((d + 2) + d), G.Walk (a i) (b i),
      (∀ i, (route i).IsPath) ∧
      (∀ i j, i ≠ j → (route i).support.Disjoint (route j).support) ∧
      (∑ i, (route i).length) =
        2 * (∑ i, weight i) + 12 * (d + 1) - 1 ∧
      (∀ i, ∀ z ∈ (route i).support,
        z ∈ (A (w.getVert (doubledPathPosition d i).val) ∪
          B (w.getVert (doubledPathPosition d i).val)) ∨
        z ∈ D (w.getVert (doubledPathPosition d i).val)) ∧
      ∀ i j z, (IsCanonicalScaffoldMate G
            (hscaffold (w.getVert (doubledPathPosition d j).val)) z (a j) ∨
          IsCanonicalScaffoldMate G
            (hscaffold (w.getVert (doubledPathPosition d j).val)) z (b j)) →
        z ∉ (route i).support := by
  classical
  obtain ⟨route, hroute, hrouteDisj, hrouteSum, hrouteZeroLen, hrouteLoc,
      hrouteMateAvoid⟩ :=
    exists_doubled_path_alternatingScaffold_routes
      G H w hwlen hwpath A B D hscaffold hrob hmajorD hq htheta hregions
        weight hweight a b ha hb hab hpairs
  obtain ⟨M, hM, hMcard, hMA⟩ := hmatch
  let F : Finset V := {a 0, b 0}
  have hFcard : F.card < M.card := by
    have htwo : F.card ≤ 2 := Finset.card_le_two
    omega
  obtain ⟨e, heM, he₁F, he₂F, heAdj⟩ :=
    exists_adjPair_avoiding_of_disjointAdjPairFamily G M F hM hFcard
  have heA := hMA e heM
  have he₁F' : e.1 ≠ a 0 ∧ e.1 ≠ b 0 := by simpa [F] using he₁F
  have he₂F' : e.2 ≠ a 0 ∧ e.2 ≠ b 0 := by simpa [F] using he₂F
  obtain ⟨_hqpos, aa, _bb, hA, _hB, haa, _hbb, hAB0, _hab, _hba⟩ :=
    hscaffold (w.getVert 0)
  have hAcard : (A (w.getVert 0)).card = q := by
    rw [hA, Finset.card_image_of_injective _ haa]
    simp
  have hpositionZero :
      doubledPathPosition d (0 : Fin ((d + 2) + d)) = 0 := by
    have hzero : (0 : Fin ((d + 2) + d)) =
        Fin.castAdd d (0 : Fin (d + 2)) := by
      apply Fin.ext
      simp
    rw [hzero]
    simp [doubledPathPosition]
  have hpositionZeroVal :
      (doubledPathPosition d (0 : Fin ((d + 2) + d))).val = 0 := by
    simpa using congrArg Fin.val hpositionZero
  have haZero : a 0 ∈ A (w.getVert 0) := by
    simpa only [hpositionZeroVal] using ha 0
  have hbZero : b 0 ∈ A (w.getVert 0) := by
    simpa only [hpositionZeroVal] using hb 0
  obtain ⟨pOdd, hpOdd, hpOddLen, hpOddLoc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge G
      (ℓ := 5)
      (hrob (w.getVert 0)) haZero heA.1 heA.2 hbZero heAdj
      he₁F'.1.symm he₂F'.1.symm (hab 0) he₁F'.2 he₂F'.2
      (by omega) (by rw [hAcard]; omega) (by omega)
  let route' : ∀ i : Fin ((d + 2) + d), G.Walk (a i) (b i) :=
    Function.update route 0 pOdd
  have hroute' : ∀ i, (route' i).IsPath := by
    intro i
    by_cases hi : i = 0
    · subst i
      simpa [route'] using hpOdd
    · simpa [route', hi] using hroute i
  have hposZero : ∀ i : Fin ((d + 2) + d),
      doubledPathPosition d i = 0 → i = 0 := by
    intro i
    refine Fin.addCases (fun j h => ?_) (fun j h => ?_) i
    · apply Fin.ext
      have hv := congrArg Fin.val h
      simpa [doubledPathPosition] using hv
    · have hv := congrArg Fin.val h
      simp [doubledPathPosition] at hv
  have hhubNe : ∀ i : Fin ((d + 2) + d), i ≠ 0 →
      w.getVert 0 ≠ w.getVert (doubledPathPosition d i).val := by
    intro i hi heq
    have hpos : (0 : Fin (d + 2)) = doubledPathPosition d i := by
      apply Fin.ext
      exact hwpath.getVert_injOn (by simp) (by simp; omega) heq
    exact hi (hposZero i hpos.symm)
  have hroute'Loc : ∀ i, ∀ z ∈ (route' i).support,
      z ∈ (A (w.getVert (doubledPathPosition d i).val) ∪
        B (w.getVert (doubledPathPosition d i).val)) ∨
      z ∈ D (w.getVert (doubledPathPosition d i).val) := by
    intro i z hz
    by_cases hi : i = 0
    · subst i
      rcases hpOddLoc z (by simpa [route'] using hz) with h | h
      · exact Or.inl (Finset.mem_union_left _ (by
          simpa only [hpositionZeroVal] using h))
      · exact Or.inr (by simpa only [hpositionZeroVal] using h)
    · exact hrouteLoc i z (by simpa [route', hi] using hz)
  have hroute'Disj : ∀ i j, i ≠ j →
      (route' i).support.Disjoint (route' j).support := by
    intro i j hij
    by_cases hi : i = 0
    · subst i
      have hj : j ≠ 0 := fun h => hij h.symm
      intro z hzi hzj
      have hzi' : z ∈ (A (w.getVert 0) ∪ B (w.getVert 0)) ∪
          D (w.getVert 0) := by
        rcases hpOddLoc z (by simpa [route'] using hzi) with h | h
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ h)
        · exact Finset.mem_union_right _ h
      have hzj' : z ∈
          (A (w.getVert (doubledPathPosition d j).val) ∪
            B (w.getVert (doubledPathPosition d j).val)) ∪
          D (w.getVert (doubledPathPosition d j).val) := by
        rcases hrouteLoc j z (by simpa [route', hj] using hzj) with h | h
        · exact Finset.mem_union_left _ h
        · exact Finset.mem_union_right _ h
      exact Finset.disjoint_left.mp (hregions _ _ (hhubNe j hj)) hzi' hzj'
    · by_cases hj : j = 0
      · subst j
        intro z hzi hzj
        have hzi' : z ∈
            (A (w.getVert (doubledPathPosition d i).val) ∪
              B (w.getVert (doubledPathPosition d i).val)) ∪
            D (w.getVert (doubledPathPosition d i).val) := by
          rcases hrouteLoc i z (by simpa [route', hi] using hzi) with h | h
          · exact Finset.mem_union_left _ h
          · exact Finset.mem_union_right _ h
        have hzj' : z ∈ (A (w.getVert 0) ∪ B (w.getVert 0)) ∪
            D (w.getVert 0) := by
          rcases hpOddLoc z (by simpa [route'] using hzj) with h | h
          · exact Finset.mem_union_left _ (Finset.mem_union_left _ h)
          · exact Finset.mem_union_right _ h
        exact Finset.disjoint_left.mp
          (hregions _ _ (hhubNe i hi).symm) hzi' hzj'
      · simpa [route', hi, hj] using hrouteDisj i j hij
  have hroute'Sum : (∑ i, (route' i).length) =
      2 * (∑ i, weight i) + 12 * (d + 1) - 1 := by
    let rest : ℕ := ∑ i ∈
      (Finset.univ : Finset (Fin ((d + 2) + d))).erase 0, (route i).length
    have holdDecomp : rest + (route 0).length = ∑ i, (route i).length := by
      simpa [rest] using Finset.sum_erase_add
        (Finset.univ : Finset (Fin ((d + 2) + d)))
        (fun i => (route i).length) (by simp : (0 : Fin ((d + 2) + d)) ∈ Finset.univ)
    calc
      (∑ i, (route' i).length) =
          (∑ i ∈ (Finset.univ : Finset (Fin ((d + 2) + d))).erase 0,
            (route' i).length) + (route' 0).length := by
              symm
              exact Finset.sum_erase_add _ _ (by simp)
      _ = rest + pOdd.length := by
        congr 1
        · apply Finset.sum_congr rfl
          intro i hi
          have hi0 : i ≠ 0 := (Finset.mem_erase.mp hi).1
          simp [route', hi0]
      _ = 2 * (∑ i, weight i) + 12 * (d + 1) - 1 := by
        rw [hpOddLen]
        rw [hweightZero] at hrouteZeroLen
        omega
  have hroute'MateAvoid : ∀ i j z,
      (IsCanonicalScaffoldMate G
          (hscaffold (w.getVert (doubledPathPosition d j).val)) z (a j) ∨
        IsCanonicalScaffoldMate G
          (hscaffold (w.getVert (doubledPathPosition d j).val)) z (b j)) →
      z ∉ (route' i).support := by
    intro i j z hz
    by_cases hi : i = 0
    · subst i
      intro hzi
      have hziLoc := hpOddLoc z (by simpa [route'] using hzi)
      by_cases hjpos : doubledPathPosition d j = 0
      · have hj : j = 0 := hposZero j hjpos
        subst j
        have hzB : z ∈ B (w.getVert 0) := by
          rcases hz with hz | hz
          · have hzB' := IsCanonicalScaffoldMate.mem_left G hz
            rw [hpositionZeroVal] at hzB'
            exact hzB'
          · have hzB' := IsCanonicalScaffoldMate.mem_left G hz
            rw [hpositionZeroVal] at hzB'
            exact hzB'
        rcases hziLoc with hzA | hzD
        · exact (Finset.disjoint_left.mp hAB0) hzA hzB
        · exact (Finset.disjoint_left.mp (hmajorD (w.getVert 0)))
            (Finset.mem_union_right _ hzB) hzD
      · have hj : j ≠ 0 := fun h => hjpos (h ▸ hpositionZero)
        have hzB : z ∈ B (w.getVert (doubledPathPosition d j).val) := by
          rcases hz with hz | hz
          · exact IsCanonicalScaffoldMate.mem_left G hz
          · exact IsCanonicalScaffoldMate.mem_left G hz
        have hziRegion : z ∈ (A (w.getVert 0) ∪ B (w.getVert 0)) ∪
            D (w.getVert 0) := by
          rcases hziLoc with hzA | hzD
          · exact Finset.mem_union_left _ (Finset.mem_union_left _ hzA)
          · exact Finset.mem_union_right _ hzD
        have hzjRegion : z ∈
            (A (w.getVert (doubledPathPosition d j).val) ∪
              B (w.getVert (doubledPathPosition d j).val)) ∪
              D (w.getVert (doubledPathPosition d j).val) :=
          Finset.mem_union_left _ (Finset.mem_union_right _ hzB)
        exact Finset.disjoint_left.mp (hregions _ _ (hhubNe j hj))
          hziRegion hzjRegion
    · simpa [route', hi] using hrouteMateAvoid i j z hz
  exact ⟨route', hroute', hroute'Disj, hroute'Sum, hroute'Loc,
    hroute'MateAvoid⟩

/-- A cyclic family of pairwise-disjoint paths and cross-edges gives an
ordinary cycle whose length is the sum of all internal path lengths plus one
edge for every hub-to-hub handle.  This is the generic finite cyclic-handle
assembly lemma used by the stability argument. -/
theorem cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m k : ℕ} (hk : 3 ≤ k)
    (a b : Fin (m + 1) → V)
    (p : ∀ i : Fin (m + 1), G.Walk (a i) (b i))
    (hp : ∀ i : Fin (m + 1), (p i).IsPath)
    (hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support)
    (hcross : ∀ i : Fin m,
      G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hlong : 1 < (∑ i : Fin (m + 1), (p i).length) + m)
    (hlen : (∑ i : Fin (m + 1), (p i).length) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨q, hq, hqlen, _hqsupp⟩ :=
    exists_chain_path_fin G a b p hp hdisj hcross
  let r : G.Walk (b (Fin.last m)) (a 0) :=
    Walk.cons hclose Walk.nil
  have hr : r.IsPath := by
    simp [r, hclose.ne]
  have htailDisj : q.support.tail.Disjoint r.support.tail := by
    intro v hvq hvr
    have hva : v = a 0 := by
      simpa [r] using hvr
    subst v
    have hn := hq.support_nodup
    rw [← q.cons_tail_support] at hn
    exact hn.notMem hvq
  apply cycleGraph_isContained_of_two_disjoint_paths G hk hq hr htailDisj
  · left
    rw [hqlen]
    exact hlong
  · dsimp [r]
    rw [hqlen]
    omega

/-- Cardinal-indexed wrapper for cyclic handle assembly.  Consecutive and
closing handles are stated only through index values, avoiding coercion
problems when the number of visits is presented as the length of an
auxiliary walk rather than syntactically as `m + 1`. -/
theorem cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_val
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {q k : ℕ} (hq : 0 < q) (hk : 3 ≤ k)
    (a b : Fin q → V)
    (p : ∀ i : Fin q, G.Walk (a i) (b i))
    (hp : ∀ i, (p i).IsPath)
    (hdisj : ∀ i j, i ≠ j → (p i).support.Disjoint (p j).support)
    (hcross : ∀ i j : Fin q, j.val = i.val + 1 →
      G.Adj (b i) (a j))
    (hclose : ∀ i j : Fin q, i.val + 1 = q → j.val = 0 →
      G.Adj (b i) (a j))
    (hlong : 1 < (∑ i : Fin q, (p i).length) + (q - 1))
    (hlen : (∑ i : Fin q, (p i).length) + q = k) :
    cycleGraph k ⊑ G := by
  cases q with
  | zero => omega
  | succ m =>
      apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
        G hk a b p hp hdisj
      · intro i
        apply hcross i.castSucc i.succ
        simp
      · apply hclose (Fin.last m) 0
        · simp
        · simp
      · simpa using hlong
      · omega

/-- A simple auxiliary path whose edges carry large cross matchings lifts,
through cyclic alternating hubs, to an ambient cycle of any compatible
length.  The auxiliary path is traversed forward and backward.  Its endpoint
hubs carry one long route, while each internal hub carries the disjoint
long/short pair supplied by the doubled-path scaffold theorem. -/
theorem cycleGraph_isContained_of_largeCrossMatching_path_alternatingScaffolds
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) {u v : ι} (w : H.Walk u v)
    {d q theta R k : ℕ}
    (hwlen : w.length = d + 1) (hwpath : w.IsPath)
    (A B D : ι → Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 8 ≤ q) (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (A i) (A j) R)
    (hmatchBudget : 4 * (d + 1) < R)
    (hk : 3 ≤ k)
    (hbase : 14 * (d + 1) ≤ k)
    (hparity : (k - 14 * (d + 1)) % 2 = 0)
    (hcapacity : (k - 14 * (d + 1)) / 2 ≤
      (q - 8) * (d + 2)) :
    cycleGraph k ⊑ G := by
  classical
  let closed : H.Walk u u := w.append w.reverse
  have hclosedLen : closed.length = (d + 2) + d := by
    simp [closed, hwlen]
    omega
  have hclosedLong : 2 ≤ closed.length := by
    rw [hclosedLen]
    omega
  have hclosedBudget : 2 * closed.length < R := by
    rw [hclosedLen]
    omega
  obtain ⟨ac, bc, hac, hbc, habc, hpairsC, hcrossC, hcloseC⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H A closed hclosedLong hclosedBudget hlarge
  let toClosed : Fin ((d + 2) + d) → Fin closed.length :=
    fun i => Fin.cast hclosedLen.symm i
  have hclosedGet : ∀ i : Fin ((d + 2) + d),
      closed.getVert (toClosed i).val =
        w.getVert (doubledPathPosition d i).val := by
    intro i
    simpa [closed, toClosed] using
      getVert_append_reverse_eq_doubledPathPosition w hwlen i
  let a : Fin ((d + 2) + d) → V := fun i => ac (toClosed i)
  let b : Fin ((d + 2) + d) → V := fun i => bc (toClosed i)
  have ha : ∀ i, a i ∈ A (w.getVert (doubledPathPosition d i).val) := by
    intro i
    rw [← hclosedGet i]
    exact hac (toClosed i)
  have hb : ∀ i, b i ∈ A (w.getVert (doubledPathPosition d i).val) := by
    intro i
    rw [← hclosedGet i]
    exact hbc (toClosed i)
  have hab : ∀ i, a i ≠ b i := by
    intro i
    exact habc (toClosed i)
  have hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j := by
    intro i j hij
    have hcast : toClosed i ≠ toClosed j := by
      intro h
      apply hij
      apply Fin.ext
      simpa [toClosed] using congrArg Fin.val h
    exact hpairsC (toClosed i) (toClosed j) hcast
  have hcross : ∀ i j : Fin ((d + 2) + d), j.val = i.val + 1 →
      G.Adj (b i) (a j) := by
    intro i j hij
    exact hcrossC (toClosed i) (toClosed j) (by simpa [toClosed] using hij)
  have hclose : ∀ i j : Fin ((d + 2) + d),
      i.val + 1 = (d + 2) + d → j.val = 0 → G.Adj (b i) (a j) := by
    intro i j hi hj
    apply hcloseC (toClosed i) (toClosed j)
    · simpa [toClosed, hclosedLen] using hi
    · simpa [toClosed] using hj
  let z : ℕ := (k - 14 * (d + 1)) / 2
  obtain ⟨weight, hweightSum, hweight⟩ :=
    exists_fin_weights_sum_eq_le_fun
      (fun _ : Fin (d + 2) => q - 8) (z := z) (by
        simpa [z, Nat.mul_comm] using hcapacity)
  obtain ⟨route, hroute, hrouteDisj, hrouteSum, _hrouteFirstLen,
      _hrouteLoc, _hrouteMateAvoid⟩ :=
    exists_doubled_path_alternatingScaffold_routes
      G H w hwlen hwpath A B D hscaffold hrob hmajorD hq htheta hregions
        weight hweight a b ha hb hab hpairs
  have hdiff : k - 14 * (d + 1) = 2 * z := by
    dsimp [z]
    have hdivmod :
        2 * ((k - 14 * (d + 1)) / 2) +
            (k - 14 * (d + 1)) % 2 = k - 14 * (d + 1) :=
      Nat.div_add_mod (k - 14 * (d + 1)) 2
    omega
  have hkz : k = 14 * (d + 1) + 2 * z := by omega
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_val
    G (by omega) hk a b route hroute hrouteDisj hcross hclose
  · rw [hrouteSum, hweightSum]
    omega
  · rw [hrouteSum, hweightSum]
    omega

/-- Odd-parity companion to
`cycleGraph_isContained_of_largeCrossMatching_path_alternatingScaffolds`.
The first endpoint hub is used only once by the doubled traversal.  A
three-edge matching in that core permits its internal route to be shortened
from six edges to five, while all `d+1` remaining weight coordinates retain
their full `q-8` capacity. -/
theorem cycleGraph_isContained_of_largeCrossMatching_path_alternatingScaffolds_odd
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) {u v : ι} (w : H.Walk u v)
    {d q theta R k : ℕ}
    (hwlen : w.length = d + 1) (hwpath : w.IsPath)
    (A B D : ι → Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 8 ≤ q) (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (A i) (A j) R)
    (hmatch : HasThreeDisjointAdjPairFamily G (A (w.getVert 0)))
    (hmatchBudget : 4 * (d + 1) < R)
    (hk : 3 ≤ k)
    (hbase : 14 * (d + 1) - 1 ≤ k)
    (hparity : (k - (14 * (d + 1) - 1)) % 2 = 0)
    (hcapacity : (k - (14 * (d + 1) - 1)) / 2 ≤
      (q - 8) * (d + 1)) :
    cycleGraph k ⊑ G := by
  classical
  let closed : H.Walk u u := w.append w.reverse
  have hclosedLen : closed.length = (d + 2) + d := by
    simp [closed, hwlen]
    omega
  have hclosedLong : 2 ≤ closed.length := by
    rw [hclosedLen]
    omega
  have hclosedBudget : 2 * closed.length < R := by
    rw [hclosedLen]
    omega
  obtain ⟨ac, bc, hac, hbc, habc, hpairsC, hcrossC, hcloseC⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H A closed hclosedLong hclosedBudget hlarge
  let toClosed : Fin ((d + 2) + d) → Fin closed.length :=
    fun i => Fin.cast hclosedLen.symm i
  have hclosedGet : ∀ i : Fin ((d + 2) + d),
      closed.getVert (toClosed i).val =
        w.getVert (doubledPathPosition d i).val := by
    intro i
    simpa [closed, toClosed] using
      getVert_append_reverse_eq_doubledPathPosition w hwlen i
  let a : Fin ((d + 2) + d) → V := fun i => ac (toClosed i)
  let b : Fin ((d + 2) + d) → V := fun i => bc (toClosed i)
  have ha : ∀ i, a i ∈ A (w.getVert (doubledPathPosition d i).val) := by
    intro i
    rw [← hclosedGet i]
    exact hac (toClosed i)
  have hb : ∀ i, b i ∈ A (w.getVert (doubledPathPosition d i).val) := by
    intro i
    rw [← hclosedGet i]
    exact hbc (toClosed i)
  have hab : ∀ i, a i ≠ b i := by
    intro i
    exact habc (toClosed i)
  have hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j := by
    intro i j hij
    have hcast : toClosed i ≠ toClosed j := by
      intro h
      apply hij
      apply Fin.ext
      simpa [toClosed] using congrArg Fin.val h
    exact hpairsC (toClosed i) (toClosed j) hcast
  have hcross : ∀ i j : Fin ((d + 2) + d), j.val = i.val + 1 →
      G.Adj (b i) (a j) := by
    intro i j hij
    exact hcrossC (toClosed i) (toClosed j) (by simpa [toClosed] using hij)
  have hclose : ∀ i j : Fin ((d + 2) + d),
      i.val + 1 = (d + 2) + d → j.val = 0 → G.Adj (b i) (a j) := by
    intro i j hi hj
    apply hcloseC (toClosed i) (toClosed j)
    · simpa [toClosed, hclosedLen] using hi
    · simpa [toClosed] using hj
  let z : ℕ := (k - (14 * (d + 1) - 1)) / 2
  obtain ⟨weightTail, hweightTailSum, hweightTail⟩ :=
    exists_fin_weights_sum_eq_le_fun
      (fun _ : Fin (d + 1) => q - 8) (z := z) (by
        simpa [z, Nat.mul_comm] using hcapacity)
  let weight : Fin (d + 2) → ℕ := Fin.cases 0 weightTail
  have hweightZero : weight 0 = 0 := by simp [weight]
  have hweight : ∀ i, weight i ≤ q - 8 := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [weight]
    · simpa [weight] using hweightTail j
  have hweightSum : (∑ i, weight i) = z := by
    rw [Fin.sum_univ_succ]
    simpa [weight] using hweightTailSum
  obtain ⟨route, hroute, hrouteDisj, hrouteSum, _hrouteLoc,
      _hrouteMateAvoid⟩ :=
    exists_doubled_path_alternatingScaffold_routes_odd_first
      G H w hwlen hwpath A B D hscaffold hrob hmajorD hq htheta hregions
        hmatch weight hweight hweightZero a b ha hb hab hpairs
  have hdiff : k - (14 * (d + 1) - 1) = 2 * z := by
    dsimp [z]
    have hdivmod :
        2 * ((k - (14 * (d + 1) - 1)) / 2) +
            (k - (14 * (d + 1) - 1)) % 2 =
              k - (14 * (d + 1) - 1) :=
      Nat.div_add_mod (k - (14 * (d + 1) - 1)) 2
    omega
  have hkz : k = (14 * (d + 1) - 1) + 2 * z := by omega
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_val
    G (by omega) hk a b route hroute hrouteDisj hcross hclose
  · rw [hrouteSum, hweightSum]
    omega
  · rw [hrouteSum, hweightSum]
    omega

universe u

/-- Every finite tree has a closed depth-first traversal which visits every
vertex and uses exactly twice as many steps as the tree has edges.  The base
vertex is allowed to be chosen by the construction.  At the induction step
we delete a leaf, rotate the smaller traversal to its unique neighbour, and
then add the leaf edge at the beginning and end. -/
theorem SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one
    {V : Type u} [Fintype V] (T : SimpleGraph V) (hT : T.IsTree) :
    ∃ r : V, ∃ w : T.Walk r r,
      w.length = 2 * (Fintype.card V - 1) ∧
      ∀ v : V, v ∈ w.support := by
  classical
  let P : ∀ (α : Type u) [Fintype α], Prop := fun α _ =>
    ∀ (K : SimpleGraph α), K.IsTree →
      ∃ r : α, ∃ w : K.Walk r r,
        w.length = 2 * (Fintype.card α - 1) ∧
        ∀ v : α, v ∈ w.support
  refine Fintype.induction_subsingleton_or_nontrivial (P := P) V ?_ ?_ T hT
  · intro α _ hsub K hK
    let : Nonempty α := hK.connected.nonempty
    let r : α := Classical.choice inferInstance
    refine ⟨r, Walk.nil, ?_, ?_⟩
    · have hcard : Fintype.card α = 1 :=
        Fintype.card_eq_one_iff.mpr ⟨r, fun x => hsub.elim x r⟩
      simp [hcard]
    · intro v
      simpa [hsub.elim v r]
  · intro α _ hnontriv ih K hK
    obtain ⟨v, hvdeg⟩ := hK.exists_vert_degree_one_of_nontrivial
    obtain ⟨u, hvu, _huniq⟩ :=
      degree_eq_one_iff_existsUnique_adj.mp hvdeg
    let S : Set α := {v}ᶜ
    let K' : SimpleGraph S := K.induce S
    have hK' : K'.IsTree := by
      refine ⟨?_, ?_⟩
      · simpa [K', S] using
          hK.connected.induce_compl_singleton_of_degree_eq_one hvdeg
      · simpa [K', S] using hK.isAcyclic.induce ({v}ᶜ : Set α)
    have hcardS : Fintype.card S = Fintype.card α - 1 := by
      dsimp [S]
      rw [Fintype.card_compl_set]
      simp
    have hcardlt : Fintype.card S < Fintype.card α := by
      rw [hcardS]
      have := Fintype.one_lt_card (α := α)
      omega
    obtain ⟨r, wr, hwrlen, hwrcov⟩ := ih S hcardlt K' hK'
    have huS : u ∈ S := by
      simp [S, hvu.ne.symm]
    let u' : S := ⟨u, huS⟩
    have huwr : u' ∈ wr.support := hwrcov u'
    let wr' : K'.Walk u' u' := wr.rotate u' huwr
    let e : K' ↪g K := SimpleGraph.Embedding.induce S
    have heu : e u' = u := by
      change (u' : α) = u
      rfl
    let wm : K.Walk u u := (wr'.map e.toHom).copy heu heu
    let w : K.Walk v v := Walk.cons hvu (wm.concat hvu.symm)
    refine ⟨v, w, ?_, ?_⟩
    · dsimp [w, wm]
      rw [Walk.length_concat, Walk.length_copy,
        Walk.length_map, Walk.length_rotate, hwrlen, hcardS]
      have := Fintype.one_lt_card (α := α)
      omega
    · intro z
      by_cases hz : z = v
      · subst z
        exact w.start_mem_support
      · let z' : S := ⟨z, by simpa [S] using hz⟩
        have hzwr : z' ∈ wr.support := hwrcov z'
        have hzwr' : z' ∈ wr'.support := by
          exact (wr.mem_support_rotate_iff u' huwr).2 hzwr
        have hzwm : z ∈ wm.support := by
          dsimp [wm]
          rw [Walk.support_copy, Walk.support_map]
          exact List.mem_map.mpr ⟨z', hzwr', rfl⟩
        dsimp [w]
        simp only [List.mem_cons]
        right
        rw [Walk.support_concat]
        simp only [List.mem_append, List.mem_singleton]
        exact Or.inl hzwm

/-- The doubled-tree traversal may be rooted at a leaf.  Consequently its
root does not occur at any of the noninitial hub visits (the terminal copy
of the root is not indexed by a handle). -/
theorem SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one_fresh_root
    {V : Type u} [Fintype V] (T : SimpleGraph V) (hT : T.IsTree) :
    ∃ r : V, ∃ w : T.Walk r r,
      w.length = 2 * (Fintype.card V - 1) ∧
      (∀ v : V, v ∈ w.support) ∧
      ∀ j : Fin (w.length - 1), w.getVert (j.val + 1) ≠ r := by
  classical
  rcases subsingleton_or_nontrivial V with hsub | hnontriv
  · let : Subsingleton V := hsub
    let : Nonempty V := hT.connected.nonempty
    let r : V := Classical.choice inferInstance
    refine ⟨r, Walk.nil, ?_, ?_, ?_⟩
    · have hcard : Fintype.card V = 1 :=
        Fintype.card_eq_one_iff.mpr ⟨r, fun x => Subsingleton.elim x r⟩
      simp [hcard]
    · intro v
      simpa [Subsingleton.elim v r]
    · intro j
      exact j.elim0
  · let : Nontrivial V := hnontriv
    obtain ⟨v, hvdeg⟩ := hT.exists_vert_degree_one_of_nontrivial
    obtain ⟨u, hvu, _huniq⟩ :=
      degree_eq_one_iff_existsUnique_adj.mp hvdeg
    let S : Set V := {v}ᶜ
    let T' : SimpleGraph S := T.induce S
    have hT' : T'.IsTree := by
      refine ⟨?_, ?_⟩
      · simpa [T', S] using
          hT.connected.induce_compl_singleton_of_degree_eq_one hvdeg
      · simpa [T', S] using hT.isAcyclic.induce ({v}ᶜ : Set V)
    have hcardS : Fintype.card S = Fintype.card V - 1 := by
      dsimp [S]
      rw [Fintype.card_compl_set]
      simp
    obtain ⟨r, wr, hwrlen, hwrcov⟩ :=
      Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one
        T' hT'
    have huS : u ∈ S := by
      simp [S, hvu.ne.symm]
    let u' : S := ⟨u, huS⟩
    have huwr : u' ∈ wr.support := hwrcov u'
    let wr' : T'.Walk u' u' := wr.rotate u' huwr
    let e : T' ↪g T := SimpleGraph.Embedding.induce S
    have heu : e u' = u := by
      change (u' : V) = u
      rfl
    let wm : T.Walk u u := (wr'.map e.toHom).copy heu heu
    let w : T.Walk v v := Walk.cons hvu (wm.concat hvu.symm)
    have hwlen : w.length = 2 * (Fintype.card V - 1) := by
      dsimp [w, wm]
      rw [Walk.length_concat, Walk.length_copy,
        Walk.length_map, Walk.length_rotate, hwrlen, hcardS]
      have := Fintype.one_lt_card (α := V)
      omega
    refine ⟨v, w, hwlen, ?_, ?_⟩
    · intro z
      by_cases hz : z = v
      · subst z
        exact w.start_mem_support
      · let z' : S := ⟨z, by simpa [S] using hz⟩
        have hzwr : z' ∈ wr.support := hwrcov z'
        have hzwr' : z' ∈ wr'.support :=
          (wr.mem_support_rotate_iff u' huwr).2 hzwr
        have hzwm : z ∈ wm.support := by
          dsimp [wm]
          rw [Walk.support_copy, Walk.support_map]
          exact List.mem_map.mpr ⟨z', hzwr', rfl⟩
        dsimp [w]
        simp only [List.mem_cons]
        right
        rw [Walk.support_concat]
        simp only [List.mem_append, List.mem_singleton]
        exact Or.inl hzwm
    · intro j
      have hwshape : w.length = wm.length + 2 := by
        simp [w]
      have hjle : j.val ≤ wm.length := by
        have hj := j.isLt
        omega
      have hget : w.getVert (j.val + 1) = wm.getVert j.val := by
        dsimp [w]
        simp [Walk.concat_eq_append, Walk.getVert_append', hjle]
      have hwm : wm.getVert j.val ≠ v := by
        have hmemS := (wr'.getVert j.val).property
        change (wr'.getVert j.val : V) ≠ v at hmemS
        intro heq
        apply hmemS
        have hgetwm : wm.getVert j.val = e (wr'.getVert j.val) := by
          simp [wm]
        rw [hgetwm] at heq
        exact heq
      rw [hget]
      exact hwm

/-- A finite connected graph has a spanning-tree traversal of length
`2 * (|V| - 1)` visiting every vertex. -/
theorem SimpleGraph.Connected.exists_closed_walk_length_twice_card_sub_one
    {V : Type u} [Fintype V] (H : SimpleGraph V) (hH : H.Connected) :
    ∃ r : V, ∃ w : H.Walk r r,
      w.length = 2 * (Fintype.card V - 1) ∧
      ∀ v : V, v ∈ w.support := by
  classical
  obtain ⟨T, hTH, hT⟩ := hH.exists_isTree_le
  obtain ⟨r, w, hwlen, hwcov⟩ :=
    Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one T hT
  let w' : H.Walk r r := w.mapLe hTH
  refine ⟨r, w', ?_, ?_⟩
  · simpa [w'] using hwlen
  · intro v
    simpa [w', Walk.support_mapLe_eq_support] using hwcov v

/-- A connected finite graph has a doubled spanning-tree tour based at a leaf
of the chosen tree.  The base vertex therefore never occurs at an indexed
noninitial visit. -/
theorem SimpleGraph.Connected.exists_closed_walk_length_twice_card_sub_one_fresh_root
    {V : Type u} [Fintype V] (H : SimpleGraph V) (hH : H.Connected) :
    ∃ r : V, ∃ w : H.Walk r r,
      w.length = 2 * (Fintype.card V - 1) ∧
      (∀ v : V, v ∈ w.support) ∧
      ∀ j : Fin (w.length - 1), w.getVert (j.val + 1) ≠ r := by
  classical
  obtain ⟨T, hTH, hT⟩ := hH.exists_isTree_le
  obtain ⟨r, w, hwlen, hwcov, hwfresh⟩ :=
    Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one_fresh_root
      T hT
  let w' : H.Walk r r := w.mapLe hTH
  refine ⟨r, w', ?_, ?_, ?_⟩
  · simpa [w'] using hwlen
  · intro v
    simpa [w', Walk.support_mapLe_eq_support] using hwcov v
  · intro j
    have hlen : w'.length - 1 = w.length - 1 := by simp [w']
    let j' : Fin (w.length - 1) := Fin.cast hlen j
    simpa [w', j'] using hwfresh j'

/-- Rooted form of the spanning-tree traversal.  Full support of the
unrooted tour lets us rotate it to any prescribed base vertex without
changing either its length or the vertices it visits. -/
theorem SimpleGraph.Connected.exists_closed_walk_length_twice_card_sub_one_at
    {V : Type u} [Fintype V] (H : SimpleGraph V) (hH : H.Connected)
    (r : V) :
    ∃ w : H.Walk r r,
      w.length = 2 * (Fintype.card V - 1) ∧
      ∀ v : V, v ∈ w.support := by
  obtain ⟨r₀, w₀, hwlen, hwcov⟩ :=
    Erdos551.SimpleGraph.Connected.exists_closed_walk_length_twice_card_sub_one
      H hH
  have hr : r ∈ w₀.support := hwcov r
  let w : H.Walk r r := w₀.rotate r hr
  refine ⟨w, ?_, ?_⟩
  · simpa [w] using hwlen
  · intro v
    exact (w₀.mem_support_rotate_iff r hr).2 (hwcov v)

/-- Exact-order pruning form of the doubled-tree traversal.  If only `t`
vertices are needed, repeatedly delete a leaf until the ambient tree has
that order; map the recursively constructed tour back through each induced
embedding. -/
theorem SimpleGraph.IsTree.exists_closed_walk_length_twice_sub_one_of_le_card
    {V : Type u} [Fintype V] (T : SimpleGraph V) (hT : T.IsTree)
    {t : ℕ} (ht : 1 ≤ t) (htV : t ≤ Fintype.card V) :
    ∃ r : V, ∃ w : T.Walk r r, w.length = 2 * (t - 1) := by
  classical
  let P : ∀ (α : Type u) [Fintype α], Prop := fun α _ =>
    ∀ (K : SimpleGraph α), K.IsTree → ∀ t : ℕ,
      1 ≤ t → t ≤ Fintype.card α →
      ∃ r : α, ∃ w : K.Walk r r, w.length = 2 * (t - 1)
  refine Fintype.induction_subsingleton_or_nontrivial (P := P) V ?_ ?_
    T hT t ht htV
  · intro α _ hsub K hK t ht htcard
    let : Nonempty α := hK.connected.nonempty
    let r : α := Classical.choice inferInstance
    have hcard : Fintype.card α = 1 :=
      Fintype.card_eq_one_iff.mpr ⟨r, fun x => hsub.elim x r⟩
    have htone : t = 1 := by omega
    subst t
    exact ⟨r, Walk.nil, by simp⟩
  · intro α _ hnontriv ih K hK t ht htcard
    by_cases htfull : t = Fintype.card α
    · subst t
      obtain ⟨r, w, hwlen, _hwcov⟩ :=
        Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one
          K hK
      exact ⟨r, w, hwlen⟩
    · obtain ⟨v, hvdeg⟩ := hK.exists_vert_degree_one_of_nontrivial
      let S : Set α := {v}ᶜ
      let K' : SimpleGraph S := K.induce S
      have hK' : K'.IsTree := by
        refine ⟨?_, ?_⟩
        · simpa [K', S] using
            hK.connected.induce_compl_singleton_of_degree_eq_one hvdeg
        · simpa [K', S] using hK.isAcyclic.induce ({v}ᶜ : Set α)
      have hcardS : Fintype.card S = Fintype.card α - 1 := by
        dsimp [S]
        rw [Fintype.card_compl_set]
        simp
      have hcardlt : Fintype.card S < Fintype.card α := by
        rw [hcardS]
        have := Fintype.one_lt_card (α := α)
        omega
      have htS : t ≤ Fintype.card S := by
        rw [hcardS]
        omega
      obtain ⟨r, w, hwlen⟩ := ih S hcardlt K' hK' t ht htS
      let e : K' ↪g K := SimpleGraph.Embedding.induce S
      exact ⟨e r, w.map e.toHom, by simpa using hwlen⟩

/-- Exact-order leaf-pruning with a fresh base vertex.  The recursive tour is
rooted at a leaf of the retained subtree, and mapping the tour back through
the induced embeddings preserves the fact that the root has no indexed
noninitial occurrence. -/
theorem SimpleGraph.IsTree.exists_closed_walk_length_twice_sub_one_fresh_root_of_le_card
    {V : Type u} [Fintype V] (T : SimpleGraph V) (hT : T.IsTree)
    {t : ℕ} (ht : 1 ≤ t) (htV : t ≤ Fintype.card V) :
    ∃ r : V, ∃ w : T.Walk r r,
      w.length = 2 * (t - 1) ∧
      w.support.toFinset.card = t ∧
      ∀ j : Fin (w.length - 1), w.getVert (j.val + 1) ≠ r := by
  classical
  let P : ∀ (α : Type u) [Fintype α], Prop := fun α _ =>
    ∀ (K : SimpleGraph α), K.IsTree → ∀ t : ℕ,
      1 ≤ t → t ≤ Fintype.card α →
      ∃ r : α, ∃ w : K.Walk r r,
        w.length = 2 * (t - 1) ∧
        w.support.toFinset.card = t ∧
        ∀ j : Fin (w.length - 1), w.getVert (j.val + 1) ≠ r
  refine Fintype.induction_subsingleton_or_nontrivial (P := P) V ?_ ?_
    T hT t ht htV
  · intro α _ hsub K hK t ht htcard
    let : Nonempty α := hK.connected.nonempty
    let r : α := Classical.choice inferInstance
    have hcard : Fintype.card α = 1 :=
      Fintype.card_eq_one_iff.mpr ⟨r, fun x => hsub.elim x r⟩
    have htone : t = 1 := by omega
    subst t
    refine ⟨r, Walk.nil, by simp, by simp, ?_⟩
    intro j
    exact j.elim0
  · intro α _ hnontriv ih K hK t ht htcard
    by_cases htfull : t = Fintype.card α
    · subst t
      obtain ⟨r, w, hwlen, hwcov, hwfresh⟩ :=
        Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_card_sub_one_fresh_root
          K hK
      have hsupp : w.support.toFinset = Finset.univ := by
        ext x
        simp [hwcov x]
      exact ⟨r, w, hwlen, by simp [hsupp], hwfresh⟩
    · obtain ⟨v, hvdeg⟩ := hK.exists_vert_degree_one_of_nontrivial
      let S : Set α := {v}ᶜ
      let K' : SimpleGraph S := K.induce S
      have hK' : K'.IsTree := by
        refine ⟨?_, ?_⟩
        · simpa [K', S] using
            hK.connected.induce_compl_singleton_of_degree_eq_one hvdeg
        · simpa [K', S] using hK.isAcyclic.induce ({v}ᶜ : Set α)
      have hcardS : Fintype.card S = Fintype.card α - 1 := by
        dsimp [S]
        rw [Fintype.card_compl_set]
        simp
      have hcardlt : Fintype.card S < Fintype.card α := by
        rw [hcardS]
        have := Fintype.one_lt_card (α := α)
        omega
      have htS : t ≤ Fintype.card S := by
        rw [hcardS]
        omega
      obtain ⟨r, w, hwlen, hwsupp, hwfresh⟩ :=
        ih S hcardlt K' hK' t ht htS
      let e : K' ↪g K := SimpleGraph.Embedding.induce S
      let wm : K.Walk (e r) (e r) := w.map e.toHom
      have hwmsupp :
          (@List.toFinset α (Classical.decEq α) wm.support).card =
            (@List.toFinset S (Classical.decEq S) w.support).card := by
        have hto : (@List.toFinset α (Classical.decEq α) wm.support) =
            (@List.toFinset S (Classical.decEq S) w.support).image e.toHom := by
          ext x
          simp [wm]
        rw [hto]
        exact Finset.card_image_of_injective _
          (fun _ _ h => e.injective h)
      refine ⟨e r, wm, by simpa [wm] using hwlen,
        hwmsupp.trans hwsupp, ?_⟩
      intro j
      have hlen : wm.length - 1 = w.length - 1 := by simp [wm]
      let j' : Fin (w.length - 1) := Fin.cast hlen j
      intro heq
      apply hwfresh j'
      apply e.injective
      simpa [wm, j'] using heq

/-- Every finite connected graph contains a closed spanning-tree tour of
the exact doubled order `2(t-1)` for each `1 ≤ t ≤ |V|`. -/
theorem SimpleGraph.Connected.exists_closed_walk_length_twice_sub_one_of_le_card
    {V : Type u} [Fintype V] (H : SimpleGraph V) (hH : H.Connected)
    {t : ℕ} (ht : 1 ≤ t) (htV : t ≤ Fintype.card V) :
    ∃ r : V, ∃ w : H.Walk r r, w.length = 2 * (t - 1) := by
  classical
  obtain ⟨T, hTH, hT⟩ := hH.exists_isTree_le
  obtain ⟨r, w, hwlen⟩ :=
    Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_sub_one_of_le_card
      T hT ht htV
  exact ⟨r, w.mapLe hTH, by simpa using hwlen⟩

/-- Connected exact-order wrapper for the fresh-root pruned tree tour. -/
theorem SimpleGraph.Connected.exists_closed_walk_length_twice_sub_one_fresh_root_of_le_card
    {V : Type u} [Fintype V] (H : SimpleGraph V) (hH : H.Connected)
    {t : ℕ} (ht : 1 ≤ t) (htV : t ≤ Fintype.card V) :
    ∃ r : V, ∃ w : H.Walk r r,
      w.length = 2 * (t - 1) ∧
      w.support.toFinset.card = t ∧
      ∀ j : Fin (w.length - 1), w.getVert (j.val + 1) ≠ r := by
  classical
  obtain ⟨T, hTH, hT⟩ := hH.exists_isTree_le
  obtain ⟨r, w, hwlen, hwsupp, hwfresh⟩ :=
    Erdos551.SimpleGraph.IsTree.exists_closed_walk_length_twice_sub_one_fresh_root_of_le_card
      T hT ht htV
  let w' : H.Walk r r := w.mapLe hTH
  refine ⟨r, w', by simpa [w'] using hwlen, ?_, ?_⟩
  · simpa [w', Walk.support_mapLe_eq_support] using hwsupp
  intro j
  have hlen : w'.length - 1 = w.length - 1 := by simp [w']
  let j' : Fin (w.length - 1) := Fin.cast hlen j
  simpa [w', j'] using hwfresh j'

/-- Put the same residual weight on one chosen visit of each member of a
finite set covered by a visit map.  The chosen visits are distinct, so every
fiber receives total residual at most `c`, while the global residual is
exactly `|S|c`. -/
theorem exists_visit_weights_of_covers_finset
    {ι : Type*} [Fintype ι]
    (m c : ℕ) (f : Fin m → ι) (S : Finset ι)
    (hsurj : ∀ i ∈ S, ∃ j : Fin m, f j = i) :
    ∃ r : Fin m → ℕ,
      (∑ j, r j) = S.card * c ∧
      (∀ j, r j ≤ c) ∧
      ∀ i, (∑ j : {j : Fin m // f j = i}, r j.1) ≤ c := by
  classical
  choose pick hpick using fun i : S => hsurj i.1 i.2
  have hpick_inj : Function.Injective pick := by
    intro a b hab
    apply Subtype.ext
    rw [← hpick a, ← hpick b, hab]
  let selected : Finset (Fin m) := Finset.univ.image pick
  let r : Fin m → ℕ := fun j => if j ∈ selected then c else 0
  refine ⟨r, ?_, ?_, ?_⟩
  · have hselcard : selected.card = S.card := by
      rw [show selected = Finset.univ.image pick by rfl]
      rw [Finset.card_image_of_injective _ hpick_inj]
      simp
    simpa [r, hselcard] using
      (Finset.sum_const_nat (s := selected) (m := c))
  · intro j
    by_cases hj : j ∈ selected <;> simp [r, hj]
  · intro i
    let fiber : Finset (Fin m) := Finset.univ.filter (fun j => f j = i)
    have hinter : (fiber ∩ selected).card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro x hx y hy
      have hxf : f x = i :=
        (Finset.mem_filter.mp (Finset.mem_inter.mp hx).1).2
      have hyf : f y = i :=
        (Finset.mem_filter.mp (Finset.mem_inter.mp hy).1).2
      have hxs : x ∈ selected := (Finset.mem_inter.mp hx).2
      have hys : y ∈ selected := (Finset.mem_inter.mp hy).2
      rcases Finset.mem_image.mp hxs with ⟨a, _ha, hxa⟩
      rcases Finset.mem_image.mp hys with ⟨b, _hb, hyb⟩
      have hab : a = b := by
        apply Subtype.ext
        rw [← hpick a, ← hpick b, hxa, hyb, hxf, hyf]
      rw [← hxa, ← hyb, hab]
    have heq : (∑ j : {j : Fin m // f j = i}, r j.1) =
        (fiber ∩ selected).card * c := by
      rw [← Finset.sum_subtype fiber (by simp [fiber]) (fun j => r j)]
      simp [fiber, r]
    rw [heq]
    calc
      (fiber ∩ selected).card * c ≤ 1 * c :=
        Nat.mul_le_mul_right c hinter
      _ = c := one_mul c

/-- Exact balanced residual allocation.  One visit is selected for each
covered value; quotient weight is put on every selected visit, and one extra
unit is put on a subset whose size is the remainder.  Hence the total weight
is exactly `z`, while every fiber receives at most `z / |S| + 1`. -/
theorem exists_exact_balanced_visit_weights_of_covers_finset
    {ι : Type*} [Fintype ι]
    (m z : ℕ) (f : Fin m → ι) (S : Finset ι) (hS : S.Nonempty)
    (hsurj : ∀ i ∈ S, ∃ j : Fin m, f j = i) :
    ∃ r : Fin m → ℕ,
      (∑ j, r j) = z ∧
      (∀ j, r j ≤ z / S.card + 1) ∧
      ∀ i, (∑ j : {j : Fin m // f j = i}, r j.1) ≤
        z / S.card + 1 := by
  classical
  choose pick hpick using fun i : S => hsurj i.1 i.2
  have hpick_inj : Function.Injective pick := by
    intro a b hab
    apply Subtype.ext
    rw [← hpick a, ← hpick b, hab]
  let selected : Finset (Fin m) := Finset.univ.image pick
  have hselcard : selected.card = S.card := by
    rw [show selected = Finset.univ.image pick by rfl]
    rw [Finset.card_image_of_injective _ hpick_inj]
    simp
  let q : ℕ := z / S.card
  let rem : ℕ := z % S.card
  have hcardpos : 0 < S.card := Finset.card_pos.mpr hS
  have hremle : rem ≤ selected.card := by
    rw [hselcard]
    exact (Nat.mod_lt z hcardpos).le
  obtain ⟨extra, hextra, hextraCard⟩ :=
    Finset.exists_subset_card_eq hremle
  let r : Fin m → ℕ := fun j =>
    if j ∈ selected then q + if j ∈ extra then 1 else 0 else 0
  refine ⟨r, ?_, ?_, ?_⟩
  · have hsum : (∑ j, r j) = selected.card * q + extra.card := by
      calc
        (∑ j, r j) = ∑ j ∈ selected,
            (q + if j ∈ extra then 1 else 0) := by
              simp [r]
        _ = (∑ _j ∈ selected, q) +
            ∑ j ∈ selected, (if j ∈ extra then 1 else 0) := by
              rw [← Finset.sum_add_distrib]
        _ = selected.card * q + extra.card := by
              have hintereq : selected ∩ extra = extra :=
                Finset.inter_eq_right.mpr hextra
              simp [hintereq]
    rw [hsum, hselcard, hextraCard]
    dsimp [q, rem]
    simpa [Nat.mul_comm] using Nat.div_add_mod z S.card
  · intro j
    by_cases hjs : j ∈ selected <;> by_cases hje : j ∈ extra <;>
      simp [r, hjs, hje, q]
  · intro i
    let fiber : Finset (Fin m) := Finset.univ.filter (fun j => f j = i)
    have hinter : (fiber ∩ selected).card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro x hx y hy
      have hxf : f x = i :=
        (Finset.mem_filter.mp (Finset.mem_inter.mp hx).1).2
      have hyf : f y = i :=
        (Finset.mem_filter.mp (Finset.mem_inter.mp hy).1).2
      have hxs : x ∈ selected := (Finset.mem_inter.mp hx).2
      have hys : y ∈ selected := (Finset.mem_inter.mp hy).2
      rcases Finset.mem_image.mp hxs with ⟨a, _ha, hxa⟩
      rcases Finset.mem_image.mp hys with ⟨b, _hb, hyb⟩
      have hab : a = b := by
        apply Subtype.ext
        rw [← hpick a, ← hpick b, hxa, hyb, hxf, hyf]
      rw [← hxa, ← hyb, hab]
    have hrle : ∀ j, r j ≤ q + 1 := by
      intro j
      by_cases hjs : j ∈ selected <;> by_cases hje : j ∈ extra <;>
        simp [r, hjs, hje]
    calc
      (∑ j : {j : Fin m // f j = i}, r j.1) =
          ∑ j ∈ fiber ∩ selected, r j := by
            rw [← Finset.sum_subtype fiber (by simp [fiber]) (fun j => r j)]
            symm
            apply Finset.sum_subset Finset.inter_subset_left
            intro j hjfiber hjnot
            have hjs : j ∉ selected := by
              intro hjs
              exact hjnot (Finset.mem_inter.mpr ⟨hjfiber, hjs⟩)
            simp [r, hjs]
      _ ≤ (fiber ∩ selected).card * (q + 1) := by
            exact Finset.sum_le_card_nsmul _ _ _ fun j _ => hrle j
      _ ≤ 1 * (q + 1) := Nat.mul_le_mul_right (q + 1) hinter
      _ = z / S.card + 1 := by simp [q]

/-- Exact balanced residual allocation on all visits of a spanning closed
walk.  Every vertex has a visit among the cyclic indices `Fin w.length`, so
the preceding finite-set construction applies with `S = univ`. -/
theorem exists_exact_balanced_visit_weights_of_spanning_closed_walk
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (H : SimpleGraph ι) {u : ι} (w : H.Walk u u) {z : ℕ}
    (hwpos : 0 < w.length) (hspan : ∀ i : ι, i ∈ w.support) :
    ∃ r : Fin w.length → ℕ,
      (∑ j, r j) = z ∧
      (∀ j, r j ≤ z / Fintype.card ι + 1) ∧
      ∀ i, (∑ j : {j : Fin w.length // w.getVert j.val = i}, r j.1) ≤
        z / Fintype.card ι + 1 := by
  have hcover : ∀ i ∈ (Finset.univ : Finset ι),
      ∃ j : Fin w.length, w.getVert j.val = i := by
    intro i _hi
    obtain ⟨n, hn, hnle⟩ :=
      SimpleGraph.Walk.mem_support_iff_exists_getVert.mp (hspan i)
    by_cases hnlt : n < w.length
    · exact ⟨⟨n, hnlt⟩, hn⟩
    · have hneq : n = w.length := by omega
      subst n
      exact ⟨⟨0, hwpos⟩, by simpa using hn⟩
  simpa using
    (exists_exact_balanced_visit_weights_of_covers_finset
      w.length z (fun j : Fin w.length => w.getVert j.val)
        (Finset.univ : Finset ι) Finset.univ_nonempty hcover)

/-- The grouped robust-routing cost of a finite family is three per route
plus twice its total residual. -/
theorem sum_three_plus_twice_visit_weight_le
    {α : Type*} [Fintype α] (r : α → ℕ) {c : ℕ}
    (h : (∑ x, r x) ≤ c) :
    (∑ x, (2 * (r x + 1) + 1)) ≤
      3 * Fintype.card α + 2 * c := by
  have heq : (∑ x, (2 * (r x + 1) + 1)) =
      2 * (∑ x, r x) + 3 * Fintype.card α := by
    calc
      (∑ x, (2 * (r x + 1) + 1)) = ∑ x, (2 * r x + 3) := by
        apply Finset.sum_congr rfl
        intro x _hx
        omega
      _ = (∑ x, 2 * r x) + ∑ _x : α, 3 := Finset.sum_add_distrib
      _ = 2 * (∑ x, r x) + 3 * Fintype.card α := by
        simp [Finset.mul_sum, Nat.mul_comm]
  rw [heq]
  have hm := Nat.mul_le_mul_left 2 h
  omega

/-- Balanced residual allocation on the nonroot support of a fresh-root
closed walk.  One visit of each of the other `t-1` support vertices receives
weight `c`; repeated visits receive no extra weight. -/
theorem exists_balanced_visit_weights_of_closed_walk_fresh_root
    {ι : Type*} [Fintype ι] (H : SimpleGraph ι) {u : ι}
    (w : H.Walk u u) {t c : ℕ}
    (hsupp : w.support.toFinset.card = t)
    (hwfresh : ∀ j : Fin (w.length - 1),
      w.getVert (j.val + 1) ≠ u) :
    ∃ r : Fin (w.length - 1) → ℕ,
      (∑ j, r j) = (t - 1) * c ∧
      (∀ j, r j ≤ c) ∧
      ∀ i, (∑ j : {j : Fin (w.length - 1) //
        w.getVert (j.val + 1) = i}, r j.1) ≤ c := by
  classical
  let S : Finset ι := w.support.toFinset.erase u
  have hu : u ∈ w.support.toFinset := by
    simpa using w.start_mem_support
  have hScard : S.card = t - 1 := by
    simp [S, Finset.card_erase_of_mem hu, hsupp]
  have hcover : ∀ i ∈ S, ∃ j : Fin (w.length - 1),
      w.getVert (j.val + 1) = i := by
    intro i hi
    have hiSupp : i ∈ w.support := by
      exact List.mem_toFinset.mp (Finset.mem_of_mem_erase hi)
    have hiu : i ≠ u := Finset.ne_of_mem_erase hi
    obtain ⟨n, hn, hnle⟩ :=
      SimpleGraph.Walk.mem_support_iff_exists_getVert.mp hiSupp
    have hnpos : 0 < n := by
      by_contra hn0
      have hnzero : n = 0 := by omega
      subst n
      exact hiu (by simpa using hn.symm)
    have hnlt : n < w.length := by
      by_contra hnnot
      have hneq : n = w.length := by omega
      subst n
      exact hiu (by simpa using hn.symm)
    let j : Fin (w.length - 1) := ⟨n - 1, by omega⟩
    refine ⟨j, ?_⟩
    simpa [j, show n - 1 + 1 = n by omega] using hn
  obtain ⟨r, hrsum, hrle, hrfiber⟩ :=
    exists_visit_weights_of_covers_finset
      (w.length - 1) c (fun j => w.getVert (j.val + 1)) S hcover
  refine ⟨r, ?_, hrle, hrfiber⟩
  simpa [hScard] using hrsum

/-- A closed walk in an auxiliary graph whose traversed edges carry large
cross matchings lifts to a concrete ambient cycle when every robust visit is
routed through one fresh common neighbour.  Repeated auxiliary vertices are
allowed: global endpoint selection and varying-reservoir routing keep all
ambient paths disjoint. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_twoEdge
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V) {θ R : ℕ}
    {u : ι} (w : H.Walk u u)
    (hwlen : 2 ≤ w.length) (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hθ : 3 * w.length ≤ θ) :
    cycleGraph (3 * w.length) ⊑ G := by
  classical
  obtain ⟨a, b, ha, hb, hab, hpairs, hcross, hclose⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H U w hwlen hmatchBudget hlarge
  obtain ⟨p, hp, hplen, hdisj⟩ :=
    exists_pairwise_disjoint_twoEdge_paths_varying_robust
      G (fun i : Fin w.length => w.getVert i.val) U T hrob
      a b ha hb hab hpairs hθ
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_val
    G (by omega) (by omega) a b p hp hdisj hcross hclose
  · have hsum : (∑ i : Fin w.length, (p i).length) = 2 * w.length := by
      simp [hplen, Nat.mul_comm]
    rw [hsum]
    omega
  · have hsum : (∑ i : Fin w.length, (p i).length) = 2 * w.length := by
      simp [hplen, Nat.mul_comm]
    rw [hsum]
    omega

/-- Adjoin a distinguished head value to a family indexed by the remaining
`q - 1` positions.  The explicit cast makes this usable when `q` is a
dependent quantity such as a walk length. -/
def finHeadTail {α : Type*} {q : ℕ} (hq : 0 < q)
    (a0 : α) (a : Fin (q - 1) → α) (j : Fin q) : α :=
  Fin.cases a0 a (Fin.cast (by omega : q = (q - 1) + 1) j)

@[simp] theorem finHeadTail_zero {α : Type*} {q : ℕ} (hq : 0 < q)
    (a0 : α) (a : Fin (q - 1) → α) :
    finHeadTail hq a0 a (⟨0, hq⟩ : Fin q) = a0 := by
  simp [finHeadTail]

@[simp] theorem finHeadTail_succ {α : Type*} {q : ℕ} (hq : 0 < q)
    (a0 : α) (a : Fin (q - 1) → α) (j : Fin (q - 1)) :
    finHeadTail hq a0 a (⟨j.val + 1, by omega⟩ : Fin q) = a j := by
  simp [finHeadTail]

theorem finHeadTail_comp {α β : Type*} {q : ℕ} (hq : 0 < q)
    (f : α → β) (a0 : α) (a : Fin (q - 1) → α) (j : Fin q) :
    finHeadTail hq (f a0) (fun x => f (a x)) j =
      f (finHeadTail hq a0 a j) := by
  simp only [finHeadTail]
  induction Fin.cast (by omega : q = (q - 1) + 1) j using Fin.cases with
  | zero => rfl
  | succ x => rfl

/-- For a nonhead value, its fiber in a head--tail family is exactly its
fiber among the tail positions. -/
def finHeadTailFiberEquiv {α : Type*} [DecidableEq α] {q : ℕ} (hq : 0 < q)
    (a0 : α) (a : Fin (q - 1) → α) {i : α} (hi : i ≠ a0) :
    {j : Fin (q - 1) // a j = i} ≃
      {j : Fin q // finHeadTail hq a0 a j = i} where
  toFun j := ⟨⟨j.1.val + 1, by omega⟩, by
    simpa only [finHeadTail_succ] using j.2⟩
  invFun j := by
    have hj0 : j.1.val ≠ 0 := by
      intro hz
      have hjzero : j.1 = (⟨0, hq⟩ : Fin q) := Fin.ext hz
      have : a0 = i := by simpa [hjzero] using j.2
      exact hi this.symm
    let x : Fin (q - 1) := ⟨j.1.val - 1, by omega⟩
    exact ⟨x, by
      have hjx : j.1 = (⟨x.val + 1, by omega⟩ : Fin q) := by
        apply Fin.ext
        dsimp [x]
        omega
      simpa [hjx] using j.2⟩
  left_inv j := by
    apply Subtype.ext
    apply Fin.ext
    simp
  right_inv j := by
    apply Subtype.ext
    have hj0 : j.1.val ≠ 0 := by
      intro hz
      have hjzero : j.1 = (⟨0, hq⟩ : Fin q) := Fin.ext hz
      have : a0 = i := by simpa [hjzero] using j.2
      exact hi this.symm
    apply Fin.ext
    dsimp
    omega

def finHeadTailFiberEquivOfEq {α : Type*} [DecidableEq α] {q : ℕ}
    (hq : 0 < q) (a0 : α) (a : Fin (q - 1) → α)
    (g : Fin q → α) (hg : ∀ j, finHeadTail hq a0 a j = g j)
    {i : α} (hi : i ≠ a0) :
    {j : Fin (q - 1) // a j = i} ≃ {j : Fin q // g j = i} :=
  (finHeadTailFiberEquiv hq a0 a hi).trans
    { toFun := fun j => ⟨j.1, by simpa only [← hg j.1] using j.2⟩
      invFun := fun j => ⟨j.1, by simpa only [hg j.1] using j.2⟩
      left_inv := fun j => by rfl
      right_inv := fun j => by rfl }

theorem finHeadTailFiber_sum_of_eq {α : Type*} [DecidableEq α] {q : ℕ}
    (hq : 0 < q) (a0 : α) (a : Fin (q - 1) → α)
    (g : Fin q → α) (hg : ∀ j, finHeadTail hq a0 a j = g j)
    {i : α} (hi : i ≠ a0) (b0 : ℕ) (b : Fin (q - 1) → ℕ) :
    (∑ j : {j : Fin q // g j = i}, finHeadTail hq b0 b j.1) =
      ∑ j : {j : Fin (q - 1) // a j = i}, b j.1 := by
  symm
  apply Fintype.sum_equiv (finHeadTailFiberEquivOfEq hq a0 a g hg hi)
  intro j
  exact (finHeadTail_succ hq b0 b j.1).symm

/-- If no tail position has the head value, its full fiber is the singleton
consisting of position zero. -/
theorem finHeadTailFiber_sum_root_of_eq
    {α : Type*} [DecidableEq α] {q : ℕ}
    (hq : 0 < q) (a0 : α) (a : Fin (q - 1) → α)
    (g : Fin q → α) (hg : ∀ j, finHeadTail hq a0 a j = g j)
    (hfresh : ∀ j, a j ≠ a0) (b0 : ℕ) (b : Fin (q - 1) → ℕ) :
    (∑ j : {j : Fin q // g j = a0}, finHeadTail hq b0 b j.1) = b0 := by
  classical
  let z : {j : Fin q // g j = a0} := ⟨⟨0, hq⟩, by
    rw [← hg]
    simp⟩
  rw [Fintype.sum_eq_single z]
  · simp [z]
  · intro j hj
    exfalso
    apply hj
    apply Subtype.ext
    by_contra hj0
    let x : Fin (q - 1) := ⟨j.1.val - 1, by
      have : j.1.val ≠ 0 := by
        intro hz
        apply hj0
        apply Fin.ext
        simpa [z] using hz
      omega⟩
    have hjx : j.1 = (⟨x.val + 1, by omega⟩ : Fin q) := by
      apply Fin.ext
      dsimp [x]
      have hpos : 0 < j.1.val := by
        by_contra h
        apply hj0
        apply Fin.ext
        dsimp [z]
        omega
      omega
    have htail : a x = a0 := by
      calc
        a x = finHeadTail hq a0 a j.1 := by simp [hjx]
        _ = g j.1 := hg j.1
        _ = a0 := j.2
    exact (hfresh x htail).elim

theorem sum_finHeadTail {α : Type*} [AddCommMonoid α] {q : ℕ}
    (hq : 0 < q) (a0 : α) (a : Fin (q - 1) → α) :
    (∑ j : Fin q, finHeadTail hq a0 a j) = a0 + ∑ j, a j := by
  calc
    (∑ j : Fin q, finHeadTail hq a0 a j) =
        ∑ j : Fin ((q - 1) + 1), Fin.cases a0 a j := by
      apply Fintype.sum_equiv (finCongr (by omega : q = (q - 1) + 1))
      intro j
      rfl
    _ = a0 + ∑ j, a j := Fin.sum_univ_succ _

theorem finHeadTail_getVert_closed_walk
    {ι : Type*} {H : SimpleGraph ι} {u : ι}
    (w : H.Walk u u) (hq : 0 < w.length) (j : Fin w.length) :
    finHeadTail hq u (fun x : Fin (w.length - 1) =>
      w.getVert (x.val + 1)) j = w.getVert j.val := by
  by_cases hj0 : j.val = 0
  · have hj : j = (⟨0, hq⟩ : Fin w.length) := Fin.ext hj0
    subst j
    simp
  · let x : Fin (w.length - 1) := ⟨j.val - 1, by omega⟩
    have hjx : j = (⟨x.val + 1, by omega⟩ : Fin w.length) := by
      apply Fin.ext
      dsimp [x]
      omega
    rw [hjx]
    exact finHeadTail_succ hq u
      (fun x : Fin (w.length - 1) => w.getVert (x.val + 1)) x

/-- Variable all-even lift for a closed large-cross-matching walk.  Every
visit receives its own even robust route and the grouped router charges each
hub only for the visits actually made there. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_all_even_lengths
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} {u : ι} (w : H.Walk u u)
    (r : Fin w.length → ℕ)
    (hwlen : 2 ≤ w.length) (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι,
      ∀ x : {j : Fin w.length // w.getVert j.val = i},
        (∑ y : {j : Fin w.length // w.getVert j.val = i},
          (2 * (r y.1 + 1) + 1)) + (r x.1 + 2) ≤ (U i).card)
    (hθ : ∀ i : ι,
      (∑ y : {j : Fin w.length // w.getVert j.val = i},
        (2 * (r y.1 + 1) + 1)) ≤ θ)
    (hlen : (∑ j : Fin w.length, 2 * (r j + 1)) + w.length = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨a, b, ha, hb, hab, hpairs, hcross, hclose⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H U w hwlen hmatchBudget hlarge
  obtain ⟨p, hp, hplen, _hpavoid, _hploc, hpdisj⟩ :=
    exists_pairwise_disjoint_even_paths_lengths_grouped_robust
      G r (fun j : Fin w.length => w.getVert j.val) U T hrob hregions
        a b (fun _ => ∅) ha hb (by simp) (by simp) hab hpairs
        (by
          intro i x
          simpa using hU i x)
        (by
          intro i
          simpa using hθ i)
  have hrfirst :
      2 ≤ 2 * (r (⟨0, by omega⟩ : Fin w.length) + 1) := by
    omega
  have hrsumge :
      2 ≤ ∑ j : Fin w.length, 2 * (r j + 1) := by
    exact le_trans hrfirst
      (Finset.single_le_sum
        (s := (Finset.univ : Finset (Fin w.length)))
        (f := fun j : Fin w.length => 2 * (r j + 1))
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ _))
  have hk : 3 ≤ k := by omega
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_val
    G (by omega) hk a b p hp hpdisj hcross hclose
  · have hsum : (∑ j : Fin w.length, (p j).length) =
        ∑ j : Fin w.length, 2 * (r j + 1) := by
      apply Finset.sum_congr rfl
      intro j _hj
      exact hplen j
    rw [hsum]
    omega
  · have hsum : (∑ j : Fin w.length, (p j).length) =
        ∑ j : Fin w.length, 2 * (r j + 1) := by
      apply Finset.sum_congr rfl
      intro j _hj
      exact hplen j
    rw [hsum]
    exact hlen

/-- Exact-length repeated-hub splice with one adjustable even route.  The
distinguished first route avoids every later attachment; all remaining
uniform routes then avoid its full support and each other via the checked
greedy family theorem.  No distinctness of hub indices is required. -/
theorem cycleGraph_isContained_of_cyclic_repeated_robust_routes_even_residual
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {m ℓ s θ k : ℕ} (hk : 3 ≤ k)
    (hub : Fin (m + 1) → ι) (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hℓ : 2 ≤ ℓ) (hℓeven : ℓ % 2 = 0)
    (hFirstU : 2 * m + ℓ / 2 + 1 ≤ (U (hub 0)).card)
    (hFirstθ : 2 * m + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : Fin m,
      ℓ + 1 + m * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hub i.succ)).card)
    (hRestθ : ℓ + 1 + m * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + m * (2 * (s + 1)) + (m + 1) = k) :
    cycleGraph k ⊑ G := by
  classical
  let aR : Fin m → V := fun i => a i.succ
  let bR : Fin m → V := fun i => b i.succ
  let hubR : Fin m → ι := fun i => hub i.succ
  let F₀ : Finset V :=
    (Finset.univ.image aR) ∪ (Finset.univ.image bR)
  have hF₀card : F₀.card ≤ 2 * m := by
    have haCard : (Finset.univ.image aR).card ≤ m := by
      calc
        (Finset.univ.image aR).card ≤ (Finset.univ : Finset (Fin m)).card :=
          Finset.card_image_le
        _ = m := by simp
    have hbCard : (Finset.univ.image bR).card ≤ m := by
      calc
        (Finset.univ.image bR).card ≤ (Finset.univ : Finset (Fin m)).card :=
          Finset.card_image_le
        _ = m := by simp
    have hu := Finset.card_union_le
      (Finset.univ.image aR) (Finset.univ.image bR)
    change F₀.card ≤ 2 * m
    dsimp [F₀]
    omega
  have ha₀F : a 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).1 (by simpa [aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.1 (by simpa [bR] using hbi.symm)
  have hb₀F : b 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.2.1 (by simpa [aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.2.2 (by simpa [bR] using hbi.symm)
  let r₀ : ℕ := ℓ / 2 - 1
  have hr₀len : 2 * (r₀ + 1) = ℓ := by
    dsimp [r₀]
    omega
  have hFirstCard : r₀ + 2 ≤ (U (hub 0) \ F₀).card := by
    have hbase : r₀ + 2 ≤ (U (hub 0)).card - F₀.card := by
      dsimp [r₀]
      omega
    have hret : (U (hub 0)).card - F₀.card ≤
        (U (hub 0) \ F₀).card :=
      sub_le_card_sdiff_of_le_card_of_card_le le_rfl le_rfl
    exact hbase.trans hret
  have hFirstBudget : F₀.card + 2 * (r₀ + 1) + 1 ≤ θ := by
    rw [hr₀len]
    omega
  obtain ⟨p₀, hp₀, hp₀len, hp₀avoid, _hp₀loc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (hrob (hub 0))
      (ha 0) (hb 0) ha₀F hb₀F (hab 0) hFirstCard hFirstBudget
  let F₁ : Finset V := p₀.support.toFinset
  have hF₁card : F₁.card = ℓ + 1 := by
    dsimp [F₁]
    rw [List.toFinset_card_of_nodup hp₀.support_nodup,
      p₀.length_support, hp₀len, hr₀len]
  have haRF : ∀ i, aR i ∉ F₁ := by
    intro i h
    apply hp₀avoid (aR i) (by simpa [F₁] using h)
    apply Finset.mem_union_left
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hbRF : ∀ i, bR i ∉ F₁ := by
    intro i h
    apply hp₀avoid (bR i) (by simpa [F₁] using h)
    apply Finset.mem_union_right
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hRestU' : ∀ i,
      F₁.card + m * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hubR i)).card := by
    intro i
    rw [hF₁card]
    exact hRestU i
  have hRestθ' : F₁.card + m * (2 * (s + 1) + 1) ≤ θ := by
    rw [hF₁card]
    exact hRestθ
  obtain ⟨pR, hpR, hpRlen, hpRavoid, _hpRloc, hpRdisj⟩ :=
    exists_pairwise_disjoint_even_paths_varying_robust G hubR U T hrob
      aR bR F₁ (fun i => ha i.succ) (fun i => hb i.succ)
      haRF hbRF (fun i => hab i.succ)
      (fun i j hij => hpairs i.succ j.succ (by
        intro h
        exact hij (Fin.succ_injective _ h)))
      hRestU' hRestθ'
  let p : ∀ i : Fin (m + 1), G.Walk (a i) (b i) := Fin.cases p₀ pR
  have hp : ∀ i, (p i).IsPath := by
    intro i
    induction i using Fin.cases with
    | zero => simpa [p] using hp₀
    | succ i => simpa [p, aR, bR] using hpR i
  have hpdisj : ∀ i j, i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    induction i using Fin.cases with
    | zero =>
        induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j =>
            intro v hv₀ hvR
            exact hpRavoid j v (by simpa [p] using hvR)
              (by simpa [F₁, p] using hv₀)
    | succ i =>
        induction j using Fin.cases with
        | zero =>
            intro v hvR hv₀
            exact hpRavoid i v (by simpa [p] using hvR)
              (by simpa [F₁, p] using hv₀)
        | succ j =>
            have hij' : i ≠ j := by
              intro h
              exact hij (congrArg Fin.succ h)
            simpa [p] using hpRdisj i j hij'
  have hsum : (∑ i : Fin (m + 1), (p i).length) =
      ℓ + m * (2 * (s + 1)) := by
    rw [Fin.sum_univ_succ]
    have hrest : (∑ i : Fin m, (p i.succ).length) =
        m * (2 * (s + 1)) := by
      simp [p, hpRlen]
    rw [hrest]
    simp [p, hp₀len, hr₀len]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hpdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- Exact-length repeated-hub splice with no parity restriction on the
distinguished route.  A sufficiently large internal matching in its hub
supplies an edge avoiding all later attachments and both distinguished
endpoints.  The avoiding parity-route theorem then constructs the first
route, after which the same greedy even-route family used above routes every
remaining visit. -/
theorem cycleGraph_isContained_of_cyclic_repeated_robust_routes_residual
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {m ℓ s θ k : ℕ} (hk : 3 ≤ k)
    (hub : Fin (m + 1) → ι) (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U (hub 0)) (U (hub 0))
      (2 * m + 3))
    (hFirstU : 2 * m + ℓ ≤ (U (hub 0)).card)
    (hFirstθ : 2 * m + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : Fin m,
      ℓ + 1 + m * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hub i.succ)).card)
    (hRestθ : ℓ + 1 + m * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + m * (2 * (s + 1)) + (m + 1) = k) :
    cycleGraph k ⊑ G := by
  classical
  let aR : Fin m → V := fun i => a i.succ
  let bR : Fin m → V := fun i => b i.succ
  let hubR : Fin m → ι := fun i => hub i.succ
  let F₀ : Finset V :=
    (Finset.univ.image aR) ∪ (Finset.univ.image bR)
  have hF₀card : F₀.card ≤ 2 * m := by
    have haCard : (Finset.univ.image aR).card ≤ m := by
      calc
        (Finset.univ.image aR).card ≤ (Finset.univ : Finset (Fin m)).card :=
          Finset.card_image_le
        _ = m := by simp
    have hbCard : (Finset.univ.image bR).card ≤ m := by
      calc
        (Finset.univ.image bR).card ≤ (Finset.univ : Finset (Fin m)).card :=
          Finset.card_image_le
        _ = m := by simp
    have hu := Finset.card_union_le
      (Finset.univ.image aR) (Finset.univ.image bR)
    change F₀.card ≤ 2 * m
    dsimp [F₀]
    omega
  have ha₀F : a 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).1 (by simpa [aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.1 (by simpa [bR] using hbi.symm)
  have hb₀F : b 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.2.1 (by simpa [aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.2.2 (by simpa [bR] using hbi.symm)
  let Fedge : Finset V := insert (a 0) (insert (b 0) F₀)
  have hFedgecard : Fedge.card < 2 * m + 3 := by
    have hcard : Fedge.card ≤ F₀.card + 2 := by
      dsimp [Fedge]
      calc
        (insert (a 0) (insert (b 0) F₀)).card ≤
            (insert (b 0) F₀).card + 1 := Finset.card_insert_le _ _
        _ ≤ F₀.card + 1 + 1 :=
          Nat.add_le_add_right (Finset.card_insert_le _ _) 1
        _ = F₀.card + 2 := by omega
    omega
  obtain ⟨x, hxU, y, hyU, hxFedge, hyFedge, hxy⟩ :=
    exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
      G hparity hFedgecard
  have hxdata : x ≠ a 0 ∧ x ≠ b 0 ∧ x ∉ F₀ := by
    simpa [Fedge] using hxFedge
  have hydata : y ≠ a 0 ∧ y ≠ b 0 ∧ y ∉ F₀ := by
    simpa [Fedge] using hyFedge
  have hFirstCard : F₀.card + ℓ ≤ (U (hub 0)).card := by omega
  have hFirstBudget : F₀.card + ℓ + 1 ≤ θ := by omega
  obtain ⟨p₀, hp₀, hp₀len, hp₀avoid, _hp₀loc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge_avoiding G
      (hrob (hub 0)) (ha 0) hxU hyU (hb 0) ha₀F hxdata.2.2
      hydata.2.2 hb₀F hxy hxdata.1.symm hydata.1.symm (hab 0)
      hxdata.2.1 hydata.2.1 hℓ hFirstCard hFirstBudget
  let F₁ : Finset V := p₀.support.toFinset
  have hF₁card : F₁.card = ℓ + 1 := by
    dsimp [F₁]
    rw [List.toFinset_card_of_nodup hp₀.support_nodup,
      p₀.length_support, hp₀len]
  have haRF : ∀ i, aR i ∉ F₁ := by
    intro i h
    apply hp₀avoid (aR i) (by simpa [F₁] using h)
    apply Finset.mem_union_left
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hbRF : ∀ i, bR i ∉ F₁ := by
    intro i h
    apply hp₀avoid (bR i) (by simpa [F₁] using h)
    apply Finset.mem_union_right
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hRestU' : ∀ i,
      F₁.card + m * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hubR i)).card := by
    intro i
    rw [hF₁card]
    exact hRestU i
  have hRestθ' : F₁.card + m * (2 * (s + 1) + 1) ≤ θ := by
    rw [hF₁card]
    exact hRestθ
  obtain ⟨pR, hpR, hpRlen, hpRavoid, _hpRloc, hpRdisj⟩ :=
    exists_pairwise_disjoint_even_paths_varying_robust G hubR U T hrob
      aR bR F₁ (fun i => ha i.succ) (fun i => hb i.succ)
      haRF hbRF (fun i => hab i.succ)
      (fun i j hij => hpairs i.succ j.succ (by
        intro h
        exact hij (Fin.succ_injective _ h)))
      hRestU' hRestθ'
  let p : ∀ i : Fin (m + 1), G.Walk (a i) (b i) := Fin.cases p₀ pR
  have hp : ∀ i, (p i).IsPath := by
    intro i
    induction i using Fin.cases with
    | zero => simpa [p] using hp₀
    | succ i => simpa [p, aR, bR] using hpR i
  have hpdisj : ∀ i j, i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    induction i using Fin.cases with
    | zero =>
        induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j =>
            intro v hv₀ hvR
            exact hpRavoid j v (by simpa [p] using hvR)
              (by simpa [F₁, p] using hv₀)
    | succ i =>
        induction j using Fin.cases with
        | zero =>
            intro v hvR hv₀
            exact hpRavoid i v (by simpa [p] using hvR)
              (by simpa [F₁, p] using hv₀)
        | succ j =>
            have hij' : i ≠ j := by
              intro h
              exact hij (congrArg Fin.succ h)
            simpa [p] using hpRdisj i j hij'
  have hsum : (∑ i : Fin (m + 1), (p i).length) =
      ℓ + m * (2 * (s + 1)) := by
    rw [Fin.sum_univ_succ]
    have hrest : (∑ i : Fin m, (p i.succ).length) =
        m * (2 * (s + 1)) := by
      simp [p, hpRlen]
    rw [hrest]
    simp [p, hp₀len]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hpdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- Per-hub-capacity version of the exact arbitrary-parity repeated-hub
splice.  Requests after the distinguished one are grouped by their hub, so
each reservoir is charged only for its own visits.  Paths in different hub
regions are automatically disjoint. -/
theorem cycleGraph_isContained_of_cyclic_grouped_robust_routes_residual
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {m ℓ s θ k : ℕ} (hk : 3 ≤ k)
    (hub : Fin (m + 1) → ι) (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U (hub 0)) (U (hub 0))
      (2 * m + 3))
    (hFirstU : 2 * m + ℓ ≤ (U (hub 0)).card)
    (hFirstθ : 2 * m + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      (if i = hub 0 then ℓ + 1 else 0) +
        Fintype.card {j : Fin m // hub j.succ = i} *
          (2 * (s + 1) + 1) + (s + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = hub 0 then ℓ + 1 else 0) +
        Fintype.card {j : Fin m // hub j.succ = i} *
          (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + m * (2 * (s + 1)) + (m + 1) = k) :
    cycleGraph k ⊑ G := by
  classical
  let aR : Fin m → V := fun i => a i.succ
  let bR : Fin m → V := fun i => b i.succ
  let hubR : Fin m → ι := fun i => hub i.succ
  let F₀ : Finset V :=
    (Finset.univ.image aR) ∪ (Finset.univ.image bR)
  have hF₀card : F₀.card ≤ 2 * m := by
    have haCard : (Finset.univ.image aR).card ≤ m := by
      calc
        (Finset.univ.image aR).card ≤ (Finset.univ : Finset (Fin m)).card :=
          Finset.card_image_le
        _ = m := by simp
    have hbCard : (Finset.univ.image bR).card ≤ m := by
      calc
        (Finset.univ.image bR).card ≤ (Finset.univ : Finset (Fin m)).card :=
          Finset.card_image_le
        _ = m := by simp
    have hu := Finset.card_union_le
      (Finset.univ.image aR) (Finset.univ.image bR)
    change F₀.card ≤ 2 * m
    dsimp [F₀]
    omega
  have ha₀F : a 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).1 (by simpa [aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.1 (by simpa [bR] using hbi.symm)
  have hb₀F : b 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.2.1 (by simpa [aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.succ hne).2.2.2 (by simpa [bR] using hbi.symm)
  let Fedge : Finset V := insert (a 0) (insert (b 0) F₀)
  have hFedgecard : Fedge.card < 2 * m + 3 := by
    have hcard : Fedge.card ≤ F₀.card + 2 := by
      dsimp [Fedge]
      calc
        (insert (a 0) (insert (b 0) F₀)).card ≤
            (insert (b 0) F₀).card + 1 := Finset.card_insert_le _ _
        _ ≤ F₀.card + 1 + 1 :=
          Nat.add_le_add_right (Finset.card_insert_le _ _) 1
        _ = F₀.card + 2 := by omega
    omega
  obtain ⟨x, hxU, y, hyU, hxFedge, hyFedge, hxy⟩ :=
    exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
      G hparity hFedgecard
  have hxdata : x ≠ a 0 ∧ x ≠ b 0 ∧ x ∉ F₀ := by
    simpa [Fedge] using hxFedge
  have hydata : y ≠ a 0 ∧ y ≠ b 0 ∧ y ∉ F₀ := by
    simpa [Fedge] using hyFedge
  have hFirstCard : F₀.card + ℓ ≤ (U (hub 0)).card := by omega
  have hFirstBudget : F₀.card + ℓ + 1 ≤ θ := by omega
  obtain ⟨p₀, hp₀, hp₀len, hp₀avoid, hp₀loc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge_avoiding G
      (hrob (hub 0)) (ha 0) hxU hyU (hb 0) ha₀F hxdata.2.2
      hydata.2.2 hb₀F hxy hxdata.1.symm hydata.1.symm (hab 0)
      hxdata.2.1 hydata.2.1 hℓ hFirstCard hFirstBudget
  let F₁ : Finset V := p₀.support.toFinset
  have hF₁card : F₁.card = ℓ + 1 := by
    dsimp [F₁]
    rw [List.toFinset_card_of_nodup hp₀.support_nodup,
      p₀.length_support, hp₀len]
  have haRF : ∀ i, aR i ∉ F₁ := by
    intro i h
    apply hp₀avoid (aR i) (by simpa [F₁] using h)
    exact Finset.mem_union_left _
      (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
  have hbRF : ∀ i, bR i ∉ F₁ := by
    intro i h
    apply hp₀avoid (bR i) (by simpa [F₁] using h)
    exact Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
  let Fhub : ι → Finset V := fun i =>
    if i = hub 0 then F₁ else ∅
  have haRlocal : ∀ i, aR i ∉ Fhub (hubR i) := by
    intro i
    by_cases hi : hubR i = hub 0
    · simpa [Fhub, hi] using haRF i
    · simp [Fhub, hi]
  have hbRlocal : ∀ i, bR i ∉ Fhub (hubR i) := by
    intro i
    by_cases hi : hubR i = hub 0
    · simpa [Fhub, hi] using hbRF i
    · simp [Fhub, hi]
  have hRestU' : ∀ i : ι,
      (Fhub i).card + Fintype.card {j : Fin m // hubR j = i} *
        (2 * (s + 1) + 1) + (s + 2) ≤ (U i).card := by
    intro i
    by_cases hi : i = hub 0
    · simpa [Fhub, hi, hF₁card, hubR] using hRestU i
    · simpa [Fhub, hi, hubR] using hRestU i
  have hRestθ' : ∀ i : ι,
      (Fhub i).card + Fintype.card {j : Fin m // hubR j = i} *
        (2 * (s + 1) + 1) ≤ θ := by
    intro i
    by_cases hi : i = hub 0
    · simpa [Fhub, hi, hF₁card, hubR] using hRestθ i
    · simpa [Fhub, hi, hubR] using hRestθ i
  obtain ⟨pR, hpR, hpRlen, hpRavoid, hpRloc, hpRdisj⟩ :=
    exists_pairwise_disjoint_even_paths_grouped_robust G hubR U T hrob
      hregions aR bR Fhub (fun i => ha i.succ) (fun i => hb i.succ)
      haRlocal hbRlocal (fun i => hab i.succ)
      (fun i j hij => hpairs i.succ j.succ (by
        intro h
        exact hij (Fin.succ_injective _ h)))
      hRestU' hRestθ'
  have hp₀R : ∀ j, p₀.support.Disjoint (pR j).support := by
    intro j
    by_cases hj : hubR j = hub 0
    · intro v hv₀ hvR
      apply hpRavoid j v hvR
      simpa [Fhub, hj, F₁] using hv₀
    · intro v hv₀ hvR
      have hv₀loc := hp₀loc v hv₀
      have hvRloc := hpRloc j v hvR
      exact (Finset.disjoint_left.mp
        (hregions (hub 0) (hubR j) (Ne.symm hj)))
          (Finset.mem_union.mpr hv₀loc) (Finset.mem_union.mpr hvRloc)
  let p : ∀ i : Fin (m + 1), G.Walk (a i) (b i) := Fin.cases p₀ pR
  have hp : ∀ i, (p i).IsPath := by
    intro i
    induction i using Fin.cases with
    | zero => simpa [p] using hp₀
    | succ i => simpa [p, aR, bR] using hpR i
  have hpdisj : ∀ i j, i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    induction i using Fin.cases with
    | zero =>
        induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j => simpa [p] using hp₀R j
    | succ i =>
        induction j using Fin.cases with
        | zero => simpa [p] using (hp₀R i).symm
        | succ j =>
            have hij' : i ≠ j := by
              intro h
              exact hij (congrArg Fin.succ h)
            simpa [p] using hpRdisj i j hij'
  have hsum : (∑ i : Fin (m + 1), (p i).length) =
      ℓ + m * (2 * (s + 1)) := by
    rw [Fin.sum_univ_succ]
    have hrest : (∑ i : Fin m, (p i.succ).length) =
        m * (2 * (s + 1)) := by
      simp [p, hpRlen]
    rw [hrest]
    simp [p, hp₀len]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hpdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- Per-hub-capacity exact splice with an individually assigned even length
for every route after the distinguished parity-breaking route. -/
theorem cycleGraph_isContained_of_cyclic_grouped_robust_routes_lengths_residual
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {m ℓ θ k : ℕ} (r : Fin m → ℕ) (hk : 3 ≤ k)
    (hub : Fin (m + 1) → ι) (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U (hub 0)) (U (hub 0))
      (2 * Fintype.card {j : Fin m // hub j.succ = hub 0} + 3))
    (hFirstU : 2 * Fintype.card {j : Fin m // hub j.succ = hub 0} + ℓ ≤
      (U (hub 0)).card)
    (hFirstθ :
      2 * Fintype.card {j : Fin m // hub j.succ = hub 0} + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι, ∀ x : {j : Fin m // hub j.succ = i},
      (if i = hub 0 then ℓ + 1 else 0) +
        (∑ y : {j : Fin m // hub j.succ = i},
          (2 * (r y.1 + 1) + 1)) + (r x.1 + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = hub 0 then ℓ + 1 else 0) +
        (∑ y : {j : Fin m // hub j.succ = i},
          (2 * (r y.1 + 1) + 1)) ≤ θ)
    (hlen : ℓ + (∑ j : Fin m, 2 * (r j + 1)) + (m + 1) = k) :
    cycleGraph k ⊑ G := by
  classical
  let aR : Fin m → V := fun i => a i.succ
  let bR : Fin m → V := fun i => b i.succ
  let hubR : Fin m → ι := fun i => hub i.succ
  let rootVisit : Type := {j : Fin m // hubR j = hub 0}
  let aRoot : rootVisit → V := fun j => aR j.1
  let bRoot : rootVisit → V := fun j => bR j.1
  let F₀ : Finset V :=
    (Finset.univ.image aRoot) ∪ (Finset.univ.image bRoot)
  have hrootCard : Fintype.card rootVisit =
      Fintype.card {j : Fin m // hub j.succ = hub 0} := by
    simp [rootVisit, hubR]
  have hF₀card : F₀.card ≤ 2 * Fintype.card rootVisit := by
    have haCard : (Finset.univ.image aRoot).card ≤ Fintype.card rootVisit := by
      calc
        (Finset.univ.image aRoot).card ≤
            (Finset.univ : Finset rootVisit).card :=
          Finset.card_image_le
        _ = Fintype.card rootVisit := by simp
    have hbCard : (Finset.univ.image bRoot).card ≤ Fintype.card rootVisit := by
      calc
        (Finset.univ.image bRoot).card ≤
            (Finset.univ : Finset rootVisit).card :=
          Finset.card_image_le
        _ = Fintype.card rootVisit := by simp
    have hu := Finset.card_union_le
      (Finset.univ.image aRoot) (Finset.univ.image bRoot)
    change F₀.card ≤ 2 * Fintype.card rootVisit
    dsimp [F₀]
    omega
  have ha₀F : a 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.1.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.1.succ hne).1
        (by simpa [aRoot, aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.1.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.1.succ hne).2.1
        (by simpa [bRoot, bR] using hbi.symm)
  have hb₀F : b 0 ∉ F₀ := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hai⟩
      have hne : (0 : Fin (m + 1)) ≠ i.1.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.1.succ hne).2.2.1
        (by simpa [aRoot, aR] using hai.symm)
    · rcases Finset.mem_image.mp h with ⟨i, _hi, hbi⟩
      have hne : (0 : Fin (m + 1)) ≠ i.1.succ := by
        intro hzero
        have hval := congrArg Fin.val hzero
        simp at hval
      exact (hpairs 0 i.1.succ hne).2.2.2
        (by simpa [bRoot, bR] using hbi.symm)
  let Fedge : Finset V := insert (a 0) (insert (b 0) F₀)
  have hFedgecard : Fedge.card < 2 * Fintype.card rootVisit + 3 := by
    have hcard : Fedge.card ≤ F₀.card + 2 := by
      dsimp [Fedge]
      calc
        (insert (a 0) (insert (b 0) F₀)).card ≤
            (insert (b 0) F₀).card + 1 := Finset.card_insert_le _ _
        _ ≤ F₀.card + 1 + 1 :=
          Nat.add_le_add_right (Finset.card_insert_le _ _) 1
        _ = F₀.card + 2 := by omega
    omega
  have hparity' : HasCrossMatchingAtLeast G (U (hub 0)) (U (hub 0))
      (2 * Fintype.card rootVisit + 3) := by
    rw [hrootCard]
    exact hparity
  obtain ⟨x, hxU, y, hyU, hxFedge, hyFedge, hxy⟩ :=
    exists_oriented_cross_edge_avoiding_of_hasCrossMatchingAtLeast
      G hparity' hFedgecard
  have hxdata : x ≠ a 0 ∧ x ≠ b 0 ∧ x ∉ F₀ := by
    simpa [Fedge] using hxFedge
  have hydata : y ≠ a 0 ∧ y ≠ b 0 ∧ y ∉ F₀ := by
    simpa [Fedge] using hyFedge
  have hFirstU' : 2 * Fintype.card rootVisit + ℓ ≤ (U (hub 0)).card := by
    rw [hrootCard]
    exact hFirstU
  have hFirstθ' : 2 * Fintype.card rootVisit + ℓ + 1 ≤ θ := by
    rw [hrootCard]
    exact hFirstθ
  have hFirstCard : F₀.card + ℓ ≤ (U (hub 0)).card := by omega
  have hFirstBudget : F₀.card + ℓ + 1 ≤ θ := by omega
  obtain ⟨p₀, hp₀, hp₀len, hp₀avoid, hp₀loc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge_avoiding G
      (hrob (hub 0)) (ha 0) hxU hyU (hb 0) ha₀F hxdata.2.2
      hydata.2.2 hb₀F hxy hxdata.1.symm hydata.1.symm (hab 0)
      hxdata.2.1 hydata.2.1 hℓ hFirstCard hFirstBudget
  let F₁ : Finset V := p₀.support.toFinset
  have hF₁card : F₁.card = ℓ + 1 := by
    dsimp [F₁]
    rw [List.toFinset_card_of_nodup hp₀.support_nodup,
      p₀.length_support, hp₀len]
  let Fhub : ι → Finset V := fun i =>
    if i = hub 0 then F₁ else ∅
  have haRlocal : ∀ i, aR i ∉ Fhub (hubR i) := by
    intro i
    by_cases hi : hubR i = hub 0
    · intro h
      apply hp₀avoid (aR i) (by simpa [Fhub, hi, F₁] using h)
      exact Finset.mem_union_left _
        (Finset.mem_image.mpr
          ⟨(⟨i, hi⟩ : rootVisit), Finset.mem_univ _, rfl⟩)
    · simp [Fhub, hi]
  have hbRlocal : ∀ i, bR i ∉ Fhub (hubR i) := by
    intro i
    by_cases hi : hubR i = hub 0
    · intro h
      apply hp₀avoid (bR i) (by simpa [Fhub, hi, F₁] using h)
      exact Finset.mem_union_right _
        (Finset.mem_image.mpr
          ⟨(⟨i, hi⟩ : rootVisit), Finset.mem_univ _, rfl⟩)
    · simp [Fhub, hi]
  have hRestU' : ∀ i : ι, ∀ x : {j : Fin m // hubR j = i},
      (Fhub i).card +
        (∑ y : {j : Fin m // hubR j = i},
          (2 * (r y.1 + 1) + 1)) + (r x.1 + 2) ≤ (U i).card := by
    intro i x
    by_cases hi : i = hub 0
    · simpa [Fhub, hi, hF₁card, hubR] using hRestU i x
    · simpa [Fhub, hi, hubR] using hRestU i x
  have hRestθ' : ∀ i : ι,
      (Fhub i).card +
        (∑ y : {j : Fin m // hubR j = i},
          (2 * (r y.1 + 1) + 1)) ≤ θ := by
    intro i
    by_cases hi : i = hub 0
    · simpa [Fhub, hi, hF₁card, hubR] using hRestθ i
    · simpa [Fhub, hi, hubR] using hRestθ i
  obtain ⟨pR, hpR, hpRlen, hpRavoid, hpRloc, hpRdisj⟩ :=
    exists_pairwise_disjoint_even_paths_lengths_grouped_robust G r hubR U T
      hrob hregions aR bR Fhub (fun i => ha i.succ) (fun i => hb i.succ)
      haRlocal hbRlocal (fun i => hab i.succ)
      (fun i j hij => hpairs i.succ j.succ (by
        intro h
        exact hij (Fin.succ_injective _ h)))
      hRestU' hRestθ'
  have hp₀R : ∀ j, p₀.support.Disjoint (pR j).support := by
    intro j
    by_cases hj : hubR j = hub 0
    · intro v hv₀ hvR
      apply hpRavoid j v hvR
      simpa [Fhub, hj, F₁] using hv₀
    · intro v hv₀ hvR
      have hv₀loc := hp₀loc v hv₀
      have hvRloc := hpRloc j v hvR
      exact (Finset.disjoint_left.mp
        (hregions (hub 0) (hubR j) (Ne.symm hj)))
          (Finset.mem_union.mpr hv₀loc) (Finset.mem_union.mpr hvRloc)
  let p : ∀ i : Fin (m + 1), G.Walk (a i) (b i) := Fin.cases p₀ pR
  have hp : ∀ i, (p i).IsPath := by
    intro i
    induction i using Fin.cases with
    | zero => simpa [p] using hp₀
    | succ i => simpa [p, aR, bR] using hpR i
  have hpdisj : ∀ i j, i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    induction i using Fin.cases with
    | zero =>
        induction j using Fin.cases with
        | zero => exact (hij rfl).elim
        | succ j => simpa [p] using hp₀R j
    | succ i =>
        induction j using Fin.cases with
        | zero => simpa [p] using (hp₀R i).symm
        | succ j =>
            have hij' : i ≠ j := by
              intro h
              exact hij (congrArg Fin.succ h)
            simpa [p] using hpRdisj i j hij'
  have hsum : (∑ i : Fin (m + 1), (p i).length) =
      ℓ + ∑ j : Fin m, 2 * (r j + 1) := by
    rw [Fin.sum_univ_succ]
    have hrest : (∑ i : Fin m, (p i.succ).length) =
        ∑ i : Fin m, 2 * (r i + 1) := by
      apply Finset.sum_congr rfl
      intro i _hi
      simpa [p] using hpRlen i
    rw [hrest]
    simp [p, hp₀len]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hpdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- Value-indexed wrapper of the exact repeated-hub splice.  This is the
form consumed by an auxiliary closed walk, whose number of visits is known
as `w.length` rather than syntactically as a successor. -/
theorem cycleGraph_isContained_of_cyclic_repeated_robust_routes_even_residual_val
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q ℓ s θ k : ℕ} (hq : 0 < q) (hk : 3 ≤ k)
    (hub : Fin q → ι) (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (a b : Fin q → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i j : Fin q, j.val = i.val + 1 → G.Adj (b i) (a j))
    (hclose : ∀ i j : Fin q, i.val + 1 = q → j.val = 0 →
      G.Adj (b i) (a j))
    (hℓ : 2 ≤ ℓ) (hℓeven : ℓ % 2 = 0)
    (hFirstU : 2 * (q - 1) + ℓ / 2 + 1 ≤ (U (hub ⟨0, hq⟩)).card)
    (hFirstθ : 2 * (q - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : Fin q, i.val ≠ 0 →
      ℓ + 1 + (q - 1) * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hub i)).card)
    (hRestθ : ℓ + 1 + (q - 1) * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (q - 1) * (2 * (s + 1)) + q = k) :
    cycleGraph k ⊑ G := by
  cases q with
  | zero => omega
  | succ m =>
      apply cycleGraph_isContained_of_cyclic_repeated_robust_routes_even_residual
        G hk hub U T hrob a b ha hb hab hpairs
      · intro i
        apply hcross i.castSucc i.succ
        simp
      · apply hclose (Fin.last m) 0
        · simp
        · simp
      · exact hℓ
      · exact hℓeven
      · simpa using hFirstU
      · simpa using hFirstθ
      · intro i
        apply hRestU i.succ
        simp
      · simpa using hRestθ
      · simpa using hlen

/-- Value-indexed all-parity wrapper of the exact repeated-hub splice. -/
theorem cycleGraph_isContained_of_cyclic_repeated_robust_routes_residual_val
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q ℓ s θ k : ℕ} (hq : 0 < q) (hk : 3 ≤ k)
    (hub : Fin q → ι) (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (a b : Fin q → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i j : Fin q, j.val = i.val + 1 → G.Adj (b i) (a j))
    (hclose : ∀ i j : Fin q, i.val + 1 = q → j.val = 0 →
      G.Adj (b i) (a j))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G
      (U (hub ⟨0, hq⟩)) (U (hub ⟨0, hq⟩)) (2 * (q - 1) + 3))
    (hFirstU : 2 * (q - 1) + ℓ ≤ (U (hub ⟨0, hq⟩)).card)
    (hFirstθ : 2 * (q - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : Fin q, i.val ≠ 0 →
      ℓ + 1 + (q - 1) * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (hub i)).card)
    (hRestθ : ℓ + 1 + (q - 1) * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (q - 1) * (2 * (s + 1)) + q = k) :
    cycleGraph k ⊑ G := by
  cases q with
  | zero => omega
  | succ m =>
      apply cycleGraph_isContained_of_cyclic_repeated_robust_routes_residual
        G hk hub U T hrob a b ha hb hab hpairs
      · intro i
        apply hcross i.castSucc i.succ
        simp
      · apply hclose (Fin.last m) 0
        · simp
        · simp
      · exact hℓ
      · simpa using hparity
      · simpa using hFirstU
      · simpa using hFirstθ
      · intro i
        apply hRestU i.succ
        simp
      · simpa using hRestθ
      · simpa using hlen

/-- Value-indexed wrapper for the per-hub-capacity arbitrary-parity splice. -/
theorem cycleGraph_isContained_of_cyclic_grouped_robust_routes_residual_val
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q ℓ s θ k : ℕ} (hq : 0 < q) (hk : 3 ≤ k)
    (hub : Fin q → ι) (tail : Fin (q - 1) → Fin q)
    (htail : ∀ j, (tail j).val = j.val + 1)
    (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : Fin q → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i j : Fin q, j.val = i.val + 1 → G.Adj (b i) (a j))
    (hclose : ∀ i j : Fin q, i.val + 1 = q → j.val = 0 →
      G.Adj (b i) (a j))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G
      (U (hub ⟨0, hq⟩)) (U (hub ⟨0, hq⟩)) (2 * (q - 1) + 3))
    (hFirstU : 2 * (q - 1) + ℓ ≤ (U (hub ⟨0, hq⟩)).card)
    (hFirstθ : 2 * (q - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      (if i = hub ⟨0, hq⟩ then ℓ + 1 else 0) +
        Fintype.card {j : Fin (q - 1) //
          hub (tail j) = i} *
          (2 * (s + 1) + 1) + (s + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = hub ⟨0, hq⟩ then ℓ + 1 else 0) +
        Fintype.card {j : Fin (q - 1) //
          hub (tail j) = i} *
          (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (q - 1) * (2 * (s + 1)) + q = k) :
    cycleGraph k ⊑ G := by
  cases q with
  | zero => omega
  | succ m =>
      have htailCard (i : ι) :
          Fintype.card {j : Fin m // hub (tail j) = i} =
          Fintype.card {j : Fin m // hub j.succ = i} := by
        apply Fintype.card_congr
        exact
          { toFun := fun j => ⟨j.1, by
              have hj : tail j.1 = j.1.succ := Fin.ext (htail j.1)
              simpa [hj] using j.2⟩
            invFun := fun j => ⟨j.1, by
              have hj : tail j.1 = j.1.succ := Fin.ext (htail j.1)
              simpa [hj] using j.2⟩
            left_inv := fun j => Subtype.ext rfl
            right_inv := fun j => Subtype.ext rfl }
      have hzero : (0 : Fin (m + 1)) = ⟨0, hq⟩ := Fin.ext rfl
      have hhubzero : hub (0 : Fin (m + 1)) = hub ⟨0, hq⟩ :=
        congrArg hub hzero
      apply cycleGraph_isContained_of_cyclic_grouped_robust_routes_residual
        (s := s) G hk hub U T hrob hregions a b ha hb hab hpairs
      · intro i
        apply hcross i.castSucc i.succ
        simp
      · apply hclose (Fin.last m) 0
        · simp
        · simp
      · exact hℓ
      · simpa using hparity
      · simpa using hFirstU
      · simpa using hFirstθ
      · intro i
        rw [← htailCard i]
        rw [hhubzero]
        exact hRestU i
      · intro i
        rw [← htailCard i]
        rw [hhubzero]
        exact hRestθ i
      · simpa using hlen

/-- Value-indexed wrapper for the per-hub, variable-length arbitrary-parity
splice.  The explicit tail embedding identifies the noninitial visits with
the successors after the cardinal is exposed as a successor. -/
theorem cycleGraph_isContained_of_cyclic_grouped_robust_routes_lengths_residual_val
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {q ℓ θ k : ℕ} (hq : 0 < q) (hk : 3 ≤ k)
    (r : Fin (q - 1) → ℕ)
    (hub : Fin q → ι) (tail : Fin (q - 1) → Fin q)
    (htail : ∀ j, (tail j).val = j.val + 1)
    (U T : ι → Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : Fin q → V)
    (ha : ∀ i, a i ∈ U (hub i)) (hb : ∀ i, b i ∈ U (hub i))
    (hab : ∀ i, a i ≠ b i)
    (hpairs : ∀ i j, i ≠ j →
      a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j)
    (hcross : ∀ i j : Fin q, j.val = i.val + 1 → G.Adj (b i) (a j))
    (hclose : ∀ i j : Fin q, i.val + 1 = q → j.val = 0 →
      G.Adj (b i) (a j))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G
      (U (hub ⟨0, hq⟩)) (U (hub ⟨0, hq⟩))
      (2 * Fintype.card {j : Fin (q - 1) //
        hub (tail j) = hub ⟨0, hq⟩} + 3))
    (hFirstU : 2 * Fintype.card {j : Fin (q - 1) //
      hub (tail j) = hub ⟨0, hq⟩} + ℓ ≤ (U (hub ⟨0, hq⟩)).card)
    (hFirstθ : 2 * Fintype.card {j : Fin (q - 1) //
      hub (tail j) = hub ⟨0, hq⟩} + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      ∀ x : {j : Fin (q - 1) // hub (tail j) = i},
        (if i = hub ⟨0, hq⟩ then ℓ + 1 else 0) +
          (∑ y : {j : Fin (q - 1) // hub (tail j) = i},
            (2 * (r y.1 + 1) + 1)) + (r x.1 + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = hub ⟨0, hq⟩ then ℓ + 1 else 0) +
        (∑ y : {j : Fin (q - 1) // hub (tail j) = i},
          (2 * (r y.1 + 1) + 1)) ≤ θ)
    (hlen : ℓ + (∑ j : Fin (q - 1), 2 * (r j + 1)) + q = k) :
    cycleGraph k ⊑ G := by
  cases q with
  | zero => omega
  | succ m =>
      have hm : m + 1 - 1 = m := Nat.add_sub_cancel m 1
      let indexEquiv : Fin (m + 1 - 1) ≃ Fin m :=
        (Fin.castOrderIso hm).toEquiv
      let rM : Fin m → ℕ := fun j => r (indexEquiv.symm j)
      let fiberEquiv (i : ι) :
          {j : Fin (m + 1 - 1) // hub (tail j) = i} ≃
            {j : Fin m // hub j.succ = i} :=
        { toFun := fun j => ⟨indexEquiv j.1, by
            have hj : tail j.1 = (indexEquiv j.1).succ := by
              apply Fin.ext
              simpa [indexEquiv] using htail j.1
            simpa [hj] using j.2⟩
          invFun := fun j => ⟨indexEquiv.symm j.1, by
            have hj : tail (indexEquiv.symm j.1) = j.1.succ := by
              apply Fin.ext
              simpa [indexEquiv] using htail (indexEquiv.symm j.1)
            simpa [hj] using j.2⟩
          left_inv := fun j => Subtype.ext (indexEquiv.symm_apply_apply j.1)
          right_inv := fun j => Subtype.ext (indexEquiv.apply_symm_apply j.1) }
      have htailSum (i : ι) :
          (∑ j : {j : Fin (m + 1 - 1) // hub (tail j) = i},
            (2 * (r j.1 + 1) + 1)) =
          ∑ j : {j : Fin m // hub j.succ = i},
            (2 * (rM j.1 + 1) + 1) := by
        simpa [fiberEquiv, rM] using
          (fiberEquiv i).sum_comp
            (fun j : {j : Fin m // hub j.succ = i} =>
              2 * (rM j.1 + 1) + 1)
      have hlengthSum :
          (∑ j : Fin (m + 1 - 1), 2 * (r j + 1)) =
            ∑ j : Fin m, 2 * (rM j + 1) := by
        simpa [rM] using
          indexEquiv.sum_comp (fun j : Fin m => 2 * (rM j + 1))
      have hzero : (0 : Fin (m + 1)) = ⟨0, hq⟩ := Fin.ext rfl
      have hhubzero : hub (0 : Fin (m + 1)) = hub ⟨0, hq⟩ :=
        congrArg hub hzero
      have hrootCard :
          Fintype.card {j : Fin (m + 1 - 1) //
            hub (tail j) = hub ⟨0, hq⟩} =
          Fintype.card {j : Fin m // hub j.succ = hub 0} := by
        calc
          Fintype.card {j : Fin (m + 1 - 1) //
              hub (tail j) = hub ⟨0, hq⟩} =
              Fintype.card {j : Fin m //
                hub j.succ = hub ⟨0, hq⟩} :=
            Fintype.card_congr (fiberEquiv (hub ⟨0, hq⟩))
          _ = Fintype.card {j : Fin m // hub j.succ = hub 0} := by
            rw [hhubzero]
      apply cycleGraph_isContained_of_cyclic_grouped_robust_routes_lengths_residual
        G rM hk hub U T hrob hregions a b ha hb hab hpairs
      · intro i
        apply hcross i.castSucc i.succ
        simp
      · apply hclose (Fin.last m) 0
        · simp
        · simp
      · exact hℓ
      · have hp := hparity
        rw [hrootCard] at hp
        simpa [hhubzero] using hp
      · have hU := hFirstU
        rw [hrootCard] at hU
        simpa [hhubzero] using hU
      · have hθ := hFirstθ
        rw [hrootCard] at hθ
        simpa using hθ
      · intro i x
        rw [hhubzero]
        have hx := hRestU i ((fiberEquiv i).symm x)
        have hs := htailSum i
        have hv : r ((fiberEquiv i).symm x).1 = rM x.1 := by
          simp [fiberEquiv, rM]
        omega
      · intro i
        rw [hhubzero]
        have hx := hRestθ i
        have hs := htailSum i
        omega
      · omega

/-- Source-facing exact lift for a closed auxiliary walk.  Large cross
matchings provide globally fresh handles, while the repeated-hub robust
splice chooses one residual even route and uniform even routes at all other
visits. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_even_residual
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {ℓ s θ R k : ℕ} {u : ι} (w : H.Walk u u)
    (hwlen : 2 ≤ w.length) (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hℓ : 2 ≤ ℓ) (hℓeven : ℓ % 2 = 0)
    (hFirstU : 2 * (w.length - 1) + ℓ / 2 + 1 ≤
      (U (w.getVert 0)).card)
    (hFirstθ : 2 * (w.length - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : Fin w.length, i.val ≠ 0 →
      ℓ + 1 + (w.length - 1) * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (w.getVert i.val)).card)
    (hRestθ : ℓ + 1 + (w.length - 1) * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (w.length - 1) * (2 * (s + 1)) + w.length = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨a, b, ha, hb, hab, hpairs, hcross, hclose⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H U w hwlen hmatchBudget hlarge
  apply cycleGraph_isContained_of_cyclic_repeated_robust_routes_even_residual_val
    G (by omega) (by omega) (fun i => w.getVert i.val) U T hrob
      a b ha hb hab hpairs hcross hclose hℓ hℓeven
  · simpa using hFirstU
  · exact hFirstθ
  · exact hRestU
  · exact hRestθ
  · exact hlen

/-- Source-facing exact all-parity lift for a closed auxiliary walk.  In
addition to the large cross matchings carried by its traversed edges, the
distinguished hub carries a large internal matching.  One edge of that
matching is the parity breaker for the adjustable route. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_residual
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {ℓ s θ R k : ℕ} {u : ι} (w : H.Walk u u)
    (hwlen : 2 ≤ w.length) (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U u) (U u)
      (2 * (w.length - 1) + 3))
    (hFirstU : 2 * (w.length - 1) + ℓ ≤
      (U (w.getVert 0)).card)
    (hFirstθ : 2 * (w.length - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : Fin w.length, i.val ≠ 0 →
      ℓ + 1 + (w.length - 1) * (2 * (s + 1) + 1) + (s + 2) ≤
        (U (w.getVert i.val)).card)
    (hRestθ : ℓ + 1 + (w.length - 1) * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (w.length - 1) * (2 * (s + 1)) + w.length = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨a, b, ha, hb, hab, hpairs, hcross, hclose⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H U w hwlen hmatchBudget hlarge
  apply cycleGraph_isContained_of_cyclic_repeated_robust_routes_residual_val
    G (by omega) (by omega) (fun i => w.getVert i.val) U T hrob
      a b ha hb hab hpairs hcross hclose hℓ
  · simpa using hparity
  · simpa using hFirstU
  · exact hFirstθ
  · exact hRestU
  · exact hRestθ
  · exact hlen

/-- Source-facing all-parity lift with the robust-routing budget charged only
at the hubs actually visited by the closed auxiliary walk.  The subtype in
`hRestU` and `hRestθ` counts the noninitial visits to each hub. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_grouped_residual
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {ℓ s θ R k : ℕ} {u : ι} (w : H.Walk u u)
    (hwlen : 2 ≤ w.length) (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U u) (U u)
      (2 * (w.length - 1) + 3))
    (hFirstU : 2 * (w.length - 1) + ℓ ≤
      (U (w.getVert 0)).card)
    (hFirstθ : 2 * (w.length - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      (if i = u then ℓ + 1 else 0) +
        Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} *
          (2 * (s + 1) + 1) + (s + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = u then ℓ + 1 else 0) +
        Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} *
          (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (w.length - 1) * (2 * (s + 1)) + w.length = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨a, b, ha, hb, hab, hpairs, hcross, hclose⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H U w hwlen hmatchBudget hlarge
  let tail : Fin (w.length - 1) → Fin w.length := fun j =>
    ⟨j.val + 1, by omega⟩
  apply cycleGraph_isContained_of_cyclic_grouped_robust_routes_residual_val
    G (by omega) (by omega) (fun i => w.getVert i.val) tail
      (fun _ => rfl) U T hrob hregions a b ha hb hab hpairs hcross hclose hℓ
  · simpa using hparity
  · simpa using hFirstU
  · exact hFirstθ
  · intro i
    simpa [tail] using hRestU i
  · intro i
    simpa [tail] using hRestθ i
  · exact hlen

/-- Source-facing closed-walk lift with an individually assigned even length
for each noninitial visit and exact per-hub sum accounting. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_lengths_residual
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {ℓ θ R k : ℕ} {u : ι} (w : H.Walk u u)
    (r : Fin (w.length - 1) → ℕ)
    (hwlen : 2 ≤ w.length) (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U u) (U u)
      (2 * Fintype.card {j : Fin (w.length - 1) //
        w.getVert (j.val + 1) = u} + 3))
    (hFirstU : 2 * Fintype.card {j : Fin (w.length - 1) //
      w.getVert (j.val + 1) = u} + ℓ ≤
      (U (w.getVert 0)).card)
    (hFirstθ : 2 * Fintype.card {j : Fin (w.length - 1) //
      w.getVert (j.val + 1) = u} + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      ∀ x : {j : Fin (w.length - 1) // w.getVert (j.val + 1) = i},
        (if i = u then ℓ + 1 else 0) +
          (∑ y : {j : Fin (w.length - 1) // w.getVert (j.val + 1) = i},
            (2 * (r y.1 + 1) + 1)) + (r x.1 + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = u then ℓ + 1 else 0) +
        (∑ y : {j : Fin (w.length - 1) // w.getVert (j.val + 1) = i},
          (2 * (r y.1 + 1) + 1)) ≤ θ)
    (hlen : ℓ + (∑ j : Fin (w.length - 1), 2 * (r j + 1)) +
      w.length = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨a, b, ha, hb, hab, hpairs, hcross, hclose⟩ :=
    exists_globally_disjoint_cyclic_cross_edges_along_closed_walk
      G H U w hwlen hmatchBudget hlarge
  let tail : Fin (w.length - 1) → Fin w.length := fun j =>
    ⟨j.val + 1, by omega⟩
  apply cycleGraph_isContained_of_cyclic_grouped_robust_routes_lengths_residual_val
    G (by omega) (by omega) r (fun i => w.getVert i.val) tail
      (fun _ => rfl) U T hrob hregions a b ha hb hab hpairs hcross hclose hℓ
  · simpa using hparity
  · simpa using hFirstU
  · simpa [tail] using hFirstθ
  · intro i x
    simpa [tail] using hRestU i x
  · intro i
    simpa [tail] using hRestθ i
  · exact hlen

/-- Fresh-root specialization of the variable-length closed-walk lift.  If
the base hub never occurs among the indexed noninitial visits, the first
route has no later attachment in its own region.  Thus three internal
matching edges suffice for parity, and the first robust reservoir is charged
only for the route itself. -/
theorem cycleGraph_isContained_of_closed_largeCrossMatching_walk_fresh_root_lengths_residual
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {ℓ θ R k : ℕ} {u : ι} (w : H.Walk u u)
    (r : Fin (w.length - 1) → ℕ)
    (hwlen : 2 ≤ w.length)
    (hwfresh : ∀ j : Fin (w.length - 1),
      w.getVert (j.val + 1) ≠ u)
    (hmatchBudget : 2 * w.length < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hℓ : 5 ≤ ℓ)
    (hparity : HasCrossMatchingAtLeast G (U u) (U u) 3)
    (hFirstU : ℓ ≤ (U u).card)
    (hFirstθ : ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      ∀ x : {j : Fin (w.length - 1) // w.getVert (j.val + 1) = i},
        (if i = u then ℓ + 1 else 0) +
          (∑ y : {j : Fin (w.length - 1) // w.getVert (j.val + 1) = i},
            (2 * (r y.1 + 1) + 1)) + (r x.1 + 2) ≤ (U i).card)
    (hRestθ : ∀ i : ι,
      (if i = u then ℓ + 1 else 0) +
        (∑ y : {j : Fin (w.length - 1) // w.getVert (j.val + 1) = i},
          (2 * (r y.1 + 1) + 1)) ≤ θ)
    (hlen : ℓ + (∑ j : Fin (w.length - 1), 2 * (r j + 1)) +
      w.length = k) :
    cycleGraph k ⊑ G := by
  let : IsEmpty {j : Fin (w.length - 1) //
      w.getVert (j.val + 1) = u} :=
    ⟨fun j => (hwfresh j.1 j.2).elim⟩
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_lengths_residual
    G H U T w r hwlen hmatchBudget hlarge hrob hregions hℓ
  · simpa using hparity
  · simpa using hFirstU
  · simpa using hFirstθ
  · exact hRestU
  · exact hRestθ
  · exact hlen

/-- Quotient/remainder form of the balanced route length.  After paying six
edges per nonroot support hub, division by `2(t-1)` puts an equal residual
`c` on all of them and leaves an adjustable first-route length in the short
interval `[5, 2(t-1)+4]`. -/
theorem exists_balanced_route_decomposition {t k : ℕ}
    (ht : 2 ≤ t) (hk : 6 * (t - 1) + 3 ≤ k) :
    ∃ c ℓ : ℕ,
      5 ≤ ℓ ∧ ℓ ≤ 2 * (t - 1) + 4 ∧
      2 * (t - 1) * c ≤ k ∧
      ℓ + 2 * ((t - 1) * c + (2 * (t - 1) - 1)) +
        2 * (t - 1) = k := by
  let d : ℕ := t - 1
  let b : ℕ := k - (6 * d - 2)
  have hd : 0 < d := by dsimp [d]; omega
  have hb : 5 ≤ b := by dsimp [b, d]; omega
  let z : ℕ := b - 5
  let c : ℕ := z / (2 * d)
  let rem : ℕ := z % (2 * d)
  let ℓ : ℕ := 5 + rem
  have hmod : rem < 2 * d := by
    exact Nat.mod_lt z (by omega)
  have hdiv : 2 * d * c + rem = z := by
    simpa [c, rem] using Nat.div_add_mod z (2 * d)
  have hdiv' : 2 * (d * c) + rem = z := by
    simpa [Nat.mul_assoc] using hdiv
  have hkbase : 6 * d - 2 ≤ k := by dsimp [d]; omega
  have hbrel : (6 * d - 2) + b = k := by
    dsimp [b]
    omega
  have hzrel : 5 + z = b := by
    dsimp [z]
    omega
  refine ⟨c, ℓ, by simp [ℓ], ?_, ?_, ?_⟩
  · dsimp [ℓ]
    omega
  · have hc : 2 * d * c ≤ k := by omega
    simpa [d] using hc
  · dsimp [ℓ]
    have hgoal :
        5 + rem + 2 * (d * c + (2 * d - 1)) + 2 * d = k := by
      omega
    simpa [d] using hgoal

/-- Balanced exact-order component lift.  A fresh-root pruned tree tour uses
exactly `t` auxiliary hubs.  One visit of each nonroot hub absorbs residual
`c`, while all repeated visits use the minimum even route.  Consequently the
per-hub charge is linear in `t+c`, rather than their product. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_balanced_of_card_ge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {t c ℓ θ R k : ℕ} (hconn : H.Connected)
    (ht : 2 ≤ t) (htcard : t ≤ Fintype.card ι)
    (hmatchBudget : 2 * (2 * (t - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hℓ : 5 ≤ ℓ)
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i) 3)
    (hFirstU : ∀ i : ι, ℓ ≤ (U i).card)
    (hFirstθ : ℓ + 1 ≤ θ)
    (hRouteU : ∀ i : ι,
      3 * (2 * (t - 1) - 1) + 3 * c + 2 ≤ (U i).card)
    (hRouteθ : 3 * (2 * (t - 1) - 1) + 2 * c ≤ θ)
    (hlen : ℓ + 2 * ((t - 1) * c + (2 * (t - 1) - 1)) +
      2 * (t - 1) = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨u, w, hwlen, hwsupp, hwfresh⟩ :=
    Erdos551.SimpleGraph.Connected.exists_closed_walk_length_twice_sub_one_fresh_root_of_le_card
      H hconn (by omega) htcard
  obtain ⟨r, hrsum, hrle, hrfiber⟩ :=
    exists_balanced_visit_weights_of_closed_walk_fresh_root
      H w hwsupp hwfresh (c := c)
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_fresh_root_lengths_residual
    G H U T w r
  · rw [hwlen]
    omega
  · exact hwfresh
  · rw [hwlen]
    exact hmatchBudget
  · exact hlarge
  · exact hrob
  · exact hregions
  · exact hℓ
  · exact hparity u
  · simpa using hFirstU u
  · exact hFirstθ
  · intro i x
    have hiu : i ≠ u := by
      intro hi
      subst i
      exact hwfresh x.1 x.2
    have hcost := sum_three_plus_twice_visit_weight_le
      (fun y : {j : Fin (w.length - 1) //
        w.getVert (j.val + 1) = i} => r y.1) (hrfiber i)
    have hcardfiber : Fintype.card {j : Fin (w.length - 1) //
        w.getVert (j.val + 1) = i} ≤ w.length - 1 := by
      calc
        Fintype.card {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i} ≤
            Fintype.card (Fin (w.length - 1)) := Fintype.card_subtype_le _
        _ = w.length - 1 := Fintype.card_fin _
    have hrx := hrle x.1
    have hUi := hRouteU i
    simp only [if_neg hiu]
    have hcardfiber' : Fintype.card {j : Fin (w.length - 1) //
        w.getVert (j.val + 1) = i} ≤ 2 * (t - 1) - 1 := by
      omega
    have hcost' :
        (∑ y : {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i}, (2 * (r y.1 + 1) + 1)) ≤
          3 * (2 * (t - 1) - 1) + 2 * c := by
      calc
        _ ≤ 3 * Fintype.card {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i} + 2 * c := hcost
        _ ≤ 3 * (2 * (t - 1) - 1) + 2 * c := by
          exact Nat.add_le_add_right (Nat.mul_le_mul_left 3 hcardfiber') _
    have hlocal :
        (∑ y : {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i}, (2 * (r y.1 + 1) + 1)) +
          (r x.1 + 2) ≤ 3 * (2 * (t - 1) - 1) + 3 * c + 2 := by
      omega
    simpa only [zero_add] using hlocal.trans hUi
  · intro i
    by_cases hi : i = u
    · subst i
      let : IsEmpty {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = u} :=
        ⟨fun j => (hwfresh j.1 j.2).elim⟩
      simpa using hFirstθ
    · have hcost := sum_three_plus_twice_visit_weight_le
        (fun y : {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} => r y.1) (hrfiber i)
      have hcardfiber : Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} ≤ w.length - 1 := by
        calc
          Fintype.card {j : Fin (w.length - 1) //
              w.getVert (j.val + 1) = i} ≤
              Fintype.card (Fin (w.length - 1)) := Fintype.card_subtype_le _
          _ = w.length - 1 := Fintype.card_fin _
      simp only [if_neg hi]
      have hcardfiber' : Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} ≤ 2 * (t - 1) - 1 := by
        omega
      have hcost' :
          (∑ y : {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i}, (2 * (r y.1 + 1) + 1)) ≤
            3 * (2 * (t - 1) - 1) + 2 * c := by
        calc
          _ ≤ 3 * Fintype.card {j : Fin (w.length - 1) //
              w.getVert (j.val + 1) = i} + 2 * c := hcost
          _ ≤ 3 * (2 * (t - 1) - 1) + 2 * c := by
            exact Nat.add_le_add_right (Nat.mul_le_mul_left 3 hcardfiber') _
      simpa only [zero_add] using hcost'.trans hRouteθ
  · have hroute : (∑ j : Fin (w.length - 1), 2 * (r j + 1)) =
        2 * ((t - 1) * c + (2 * (t - 1) - 1)) := by
      calc
        (∑ j : Fin (w.length - 1), 2 * (r j + 1)) =
            2 * (∑ j : Fin (w.length - 1), r j) +
              2 * Fintype.card (Fin (w.length - 1)) := by
          calc
            (∑ j : Fin (w.length - 1), 2 * (r j + 1)) =
                ∑ j : Fin (w.length - 1), (2 * r j + 2) := by
              apply Finset.sum_congr rfl
              intro j _hj
              omega
            _ = (∑ j : Fin (w.length - 1), 2 * r j) +
                ∑ _j : Fin (w.length - 1), 2 := Finset.sum_add_distrib
            _ = 2 * (∑ j : Fin (w.length - 1), r j) +
                2 * Fintype.card (Fin (w.length - 1)) := by
              simp [Finset.mul_sum, Nat.mul_comm]
        _ = 2 * ((t - 1) * c + (2 * (t - 1) - 1)) := by
          rw [hrsum]
          simp only [Fintype.card_fin]
          rw [hwlen]
          omega
    rw [hroute, hwlen]
    exact hlen

/-- Even-length balanced exact-order component lift.  Because every robust
route is even, no internal parity-breaking matching is needed.  The initial
route absorbs the quotient/remainder residue and the fresh-root tour makes
its hub fiber a singleton. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_balanced_even_of_card_ge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {t c ℓ θ R k : ℕ} (hconn : H.Connected)
    (ht : 2 ≤ t) (htcard : t ≤ Fintype.card ι)
    (hmatchBudget : 2 * (2 * (t - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hℓ : 6 ≤ ℓ) (hℓdouble : 2 * (ℓ / 2) = ℓ)
    (hFirstU : ∀ i : ι, ℓ + ℓ / 2 + 2 ≤ (U i).card)
    (hFirstθ : ℓ + 1 ≤ θ)
    (hRouteU : ∀ i : ι,
      3 * (2 * (t - 1) - 1) + 3 * c + 2 ≤ (U i).card)
    (hRouteθ : 3 * (2 * (t - 1) - 1) + 2 * c ≤ θ)
    (hlen : ℓ + 2 * ((t - 1) * c + (2 * (t - 1) - 1)) +
      2 * (t - 1) = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨u, w, hwlen, hwsupp, hwfresh⟩ :=
    Erdos551.SimpleGraph.Connected.exists_closed_walk_length_twice_sub_one_fresh_root_of_le_card
      H hconn (by omega) htcard
  obtain ⟨r, hrsum, hrle, hrfiber⟩ :=
    exists_balanced_visit_weights_of_closed_walk_fresh_root
      H w hwsupp hwfresh (c := c)
  have hwpos : 0 < w.length := by rw [hwlen]; omega
  let r0 : ℕ := ℓ / 2 - 1
  let rAll : Fin w.length → ℕ := finHeadTail hwpos r0 r
  have hhub : ∀ j : Fin w.length,
      finHeadTail hwpos u
        (fun x : Fin (w.length - 1) => w.getVert (x.val + 1)) j =
          w.getVert j.val :=
    finHeadTail_getVert_closed_walk w hwpos
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_all_even_lengths
    G H U T w rAll
  · rw [hwlen]
    omega
  · rw [hwlen]
    exact hmatchBudget
  · exact hlarge
  · exact hrob
  · exact hregions
  · intro i x
    by_cases hi : i = u
    · subst i
      have hsum :
          (∑ y : {j : Fin w.length // w.getVert j.val = u},
            (2 * (rAll y.1 + 1) + 1)) = ℓ + 1 := by
        calc
          (∑ y : {j : Fin w.length // w.getVert j.val = u},
              (2 * (rAll y.1 + 1) + 1)) =
              ∑ y : {j : Fin w.length // w.getVert j.val = u},
                finHeadTail hwpos (2 * (r0 + 1) + 1)
                  (fun z => 2 * (r z + 1) + 1) y.1 := by
            apply Finset.sum_congr rfl
            intro y _hy
            exact (finHeadTail_comp hwpos
              (fun z : ℕ => 2 * (z + 1) + 1) r0 r y.1).symm
          _ = 2 * (r0 + 1) + 1 :=
            finHeadTailFiber_sum_root_of_eq hwpos u
              (fun z : Fin (w.length - 1) => w.getVert (z.val + 1))
              (fun j : Fin w.length => w.getVert j.val) hhub hwfresh
              (2 * (r0 + 1) + 1) (fun z => 2 * (r z + 1) + 1)
          _ = ℓ + 1 := by dsimp [r0]; omega
      have hx0 : x.1 = (⟨0, hwpos⟩ : Fin w.length) := by
        apply Fin.ext
        have hxval : x.1.val = 0 := by
          by_contra hxne
          let z : Fin (w.length - 1) := ⟨x.1.val - 1, by omega⟩
          have hxz : x.1 = (⟨z.val + 1, by omega⟩ : Fin w.length) := by
            apply Fin.ext
            dsimp [z]
            omega
          have htail : w.getVert (z.val + 1) = u := by
            calc
              w.getVert (z.val + 1) =
                  finHeadTail hwpos u
                    (fun y : Fin (w.length - 1) =>
                      w.getVert (y.val + 1)) x.1 := by
                rw [hxz]
                exact (finHeadTail_succ hwpos u
                  (fun y : Fin (w.length - 1) =>
                    w.getVert (y.val + 1)) z).symm
              _ = w.getVert x.1.val := hhub x.1
              _ = u := x.2
          exact hwfresh z htail
        exact hxval
      have hrx : rAll x.1 = r0 := by simp [hx0, rAll]
      rw [hsum, hrx]
      have hu := hFirstU u
      dsimp [r0]
      omega
    · have hsum :
          (∑ y : {j : Fin w.length // w.getVert j.val = i},
            (2 * (rAll y.1 + 1) + 1)) =
          ∑ y : {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i},
              (2 * (r y.1 + 1) + 1) := by
        calc
          (∑ y : {j : Fin w.length // w.getVert j.val = i},
              (2 * (rAll y.1 + 1) + 1)) =
              ∑ y : {j : Fin w.length // w.getVert j.val = i},
                finHeadTail hwpos (2 * (r0 + 1) + 1)
                  (fun z => 2 * (r z + 1) + 1) y.1 := by
            apply Finset.sum_congr rfl
            intro y _hy
            exact (finHeadTail_comp hwpos
              (fun z : ℕ => 2 * (z + 1) + 1) r0 r y.1).symm
          _ = _ := finHeadTailFiber_sum_of_eq hwpos u
            (fun z : Fin (w.length - 1) => w.getVert (z.val + 1))
            (fun j : Fin w.length => w.getVert j.val) hhub hi
            (2 * (r0 + 1) + 1) (fun z => 2 * (r z + 1) + 1)
      have hcost := sum_three_plus_twice_visit_weight_le
        (fun y : {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} => r y.1) (hrfiber i)
      have hcardfiber : Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} ≤ w.length - 1 := by
        calc
          _ ≤ Fintype.card (Fin (w.length - 1)) :=
            Fintype.card_subtype_le _
          _ = w.length - 1 := Fintype.card_fin _
      have hcardfiber' : Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} ≤ 2 * (t - 1) - 1 := by
        omega
      have hcost' :
          (∑ y : {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i}, (2 * (r y.1 + 1) + 1)) ≤
            3 * (2 * (t - 1) - 1) + 2 * c := by
        calc
          _ ≤ 3 * Fintype.card {j : Fin (w.length - 1) //
              w.getVert (j.val + 1) = i} + 2 * c := hcost
          _ ≤ 3 * (2 * (t - 1) - 1) + 2 * c := by
            exact Nat.add_le_add_right
              (Nat.mul_le_mul_left 3 hcardfiber') _
      have hxpos : x.1.val ≠ 0 := by
        intro hx0
        have hxzero : x.1 = (⟨0, hwpos⟩ : Fin w.length) := Fin.ext hx0
        exact hi (by simpa [hxzero] using x.2.symm)
      let z : Fin (w.length - 1) := ⟨x.1.val - 1, by omega⟩
      have hxz : x.1 = (⟨z.val + 1, by omega⟩ : Fin w.length) := by
        apply Fin.ext
        dsimp [z]
        omega
      have hrx : rAll x.1 = r z := by simp [rAll, hxz]
      have hrz := hrle z
      have hUi := hRouteU i
      rw [hsum, hrx]
      exact (by omega :
        (∑ y : {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i}, (2 * (r y.1 + 1) + 1)) +
          (r z + 2) ≤ (U i).card)
  · intro i
    by_cases hi : i = u
    · subst i
      have hsum :
          (∑ y : {j : Fin w.length // w.getVert j.val = u},
            (2 * (rAll y.1 + 1) + 1)) = ℓ + 1 := by
        calc
          (∑ y : {j : Fin w.length // w.getVert j.val = u},
              (2 * (rAll y.1 + 1) + 1)) =
              ∑ y : {j : Fin w.length // w.getVert j.val = u},
                finHeadTail hwpos (2 * (r0 + 1) + 1)
                  (fun z => 2 * (r z + 1) + 1) y.1 := by
            apply Finset.sum_congr rfl
            intro y _hy
            exact (finHeadTail_comp hwpos
              (fun z : ℕ => 2 * (z + 1) + 1) r0 r y.1).symm
          _ = 2 * (r0 + 1) + 1 :=
            finHeadTailFiber_sum_root_of_eq hwpos u
              (fun z : Fin (w.length - 1) => w.getVert (z.val + 1))
              (fun j : Fin w.length => w.getVert j.val) hhub hwfresh
              (2 * (r0 + 1) + 1) (fun z => 2 * (r z + 1) + 1)
          _ = ℓ + 1 := by dsimp [r0]; omega
      rw [hsum]
      exact hFirstθ
    · have hsum :
          (∑ y : {j : Fin w.length // w.getVert j.val = i},
            (2 * (rAll y.1 + 1) + 1)) =
          ∑ y : {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i},
              (2 * (r y.1 + 1) + 1) := by
        calc
          (∑ y : {j : Fin w.length // w.getVert j.val = i},
              (2 * (rAll y.1 + 1) + 1)) =
              ∑ y : {j : Fin w.length // w.getVert j.val = i},
                finHeadTail hwpos (2 * (r0 + 1) + 1)
                  (fun z => 2 * (r z + 1) + 1) y.1 := by
            apply Finset.sum_congr rfl
            intro y _hy
            exact (finHeadTail_comp hwpos
              (fun z : ℕ => 2 * (z + 1) + 1) r0 r y.1).symm
          _ = _ := finHeadTailFiber_sum_of_eq hwpos u
            (fun z : Fin (w.length - 1) => w.getVert (z.val + 1))
            (fun j : Fin w.length => w.getVert j.val) hhub hi
            (2 * (r0 + 1) + 1) (fun z => 2 * (r z + 1) + 1)
      rw [hsum]
      have hcost := sum_three_plus_twice_visit_weight_le
        (fun y : {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} => r y.1) (hrfiber i)
      have hcardfiber : Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} ≤ w.length - 1 := by
        calc
          _ ≤ Fintype.card (Fin (w.length - 1)) :=
            Fintype.card_subtype_le _
          _ = w.length - 1 := Fintype.card_fin _
      have hcardfiber' : Fintype.card {j : Fin (w.length - 1) //
          w.getVert (j.val + 1) = i} ≤ 2 * (t - 1) - 1 := by
        omega
      have hcost' :
          (∑ y : {j : Fin (w.length - 1) //
            w.getVert (j.val + 1) = i}, (2 * (r y.1 + 1) + 1)) ≤
            3 * (2 * (t - 1) - 1) + 2 * c := by
        calc
          _ ≤ 3 * Fintype.card {j : Fin (w.length - 1) //
              w.getVert (j.val + 1) = i} + 2 * c := hcost
          _ ≤ 3 * (2 * (t - 1) - 1) + 2 * c := by
            exact Nat.add_le_add_right
              (Nat.mul_le_mul_left 3 hcardfiber') _
      exact hcost'.trans hRouteθ
  · have hsumAll : (∑ j : Fin w.length, 2 * (rAll j + 1)) =
        ℓ + ∑ j : Fin (w.length - 1), 2 * (r j + 1) := by
      have hcases : (∑ j : Fin w.length, 2 * (rAll j + 1)) =
          ∑ j : Fin w.length,
            finHeadTail hwpos (2 * (r0 + 1))
              (fun z => 2 * (r z + 1)) j := by
        apply Finset.sum_congr rfl
        intro j _hj
        exact (finHeadTail_comp hwpos
          (fun z : ℕ => 2 * (z + 1)) r0 r j).symm
      rw [hcases]
      rw [sum_finHeadTail]
      dsimp [r0]
      omega
    rw [hsumAll]
    have hroute : (∑ j : Fin (w.length - 1), 2 * (r j + 1)) =
        2 * ((t - 1) * c + (2 * (t - 1) - 1)) := by
      calc
        _ = 2 * (∑ j : Fin (w.length - 1), r j) +
            2 * Fintype.card (Fin (w.length - 1)) := by
          calc
            _ = ∑ j : Fin (w.length - 1), (2 * r j + 2) := by
              apply Finset.sum_congr rfl
              intro j _hj
              omega
            _ = (∑ j : Fin (w.length - 1), 2 * r j) +
                ∑ _j : Fin (w.length - 1), 2 := Finset.sum_add_distrib
            _ = 2 * (∑ j : Fin (w.length - 1), r j) +
                2 * Fintype.card (Fin (w.length - 1)) := by
              simp [Finset.mul_sum, Nat.mul_comm]
        _ = 2 * ((t - 1) * c + (2 * (t - 1) - 1)) := by
          rw [hrsum]
          simp only [Fintype.card_fin]
          rw [hwlen]
          omega
    rw [hroute, hwlen]
    exact hlen

/-- Interval form of the parity-free balanced lift for even target lengths.
The quotient/remainder first route is itself even because the tour and all
tail routes have even total length. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_balanced_even_range_of_card_ge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {t θ R k : ℕ} (hconn : H.Connected)
    (ht : 2 ≤ t) (htcard : t ≤ Fintype.card ι)
    (hfit : 6 * (t - 1) + 3 ≤ k) (hkEven : Even k)
    (hmatchBudget : 2 * (2 * (t - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hFirstU : ∀ i : ι, 3 * (t - 1) + 8 ≤ (U i).card)
    (hFirstθ : 2 * (t - 1) + 5 ≤ θ)
    (hRouteU : ∀ i : ι,
      3 * (2 * (t - 1) - 1) +
        3 * (k / (2 * (t - 1))) + 2 ≤ (U i).card)
    (hRouteθ : 3 * (2 * (t - 1) - 1) +
      2 * (k / (2 * (t - 1))) ≤ θ) :
    cycleGraph k ⊑ G := by
  obtain ⟨c, ℓ, hℓ, hℓupper, hcprod, hlen⟩ :=
    exists_balanced_route_decomposition ht hfit
  have htailEven : Even
      (2 * ((t - 1) * c + (2 * (t - 1) - 1)) + 2 * (t - 1)) := by
    refine ⟨((t - 1) * c + (2 * (t - 1) - 1)) + (t - 1), ?_⟩
    omega
  have htotalEven : Even
      (ℓ + (2 * ((t - 1) * c + (2 * (t - 1) - 1)) +
        2 * (t - 1))) := by
    rw [show ℓ + (2 * ((t - 1) * c + (2 * (t - 1) - 1)) +
      2 * (t - 1)) = k by omega]
    exact hkEven
  have hℓEven : Even ℓ := (Nat.even_add.mp htotalEven).mpr htailEven
  have hℓsix : 6 ≤ ℓ := by
    rcases hℓEven with ⟨d, hd⟩
    omega
  have hℓdouble : 2 * (ℓ / 2) = ℓ :=
    Nat.two_mul_div_two_of_even hℓEven
  have hden : 0 < 2 * (t - 1) := by omega
  have hc : c ≤ k / (2 * (t - 1)) := by
    apply (Nat.le_div_iff_mul_le hden).2
    simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hcprod
  apply cycleGraph_isContained_of_connected_largeCrossMatching_balanced_even_of_card_ge
    G H U T hconn ht htcard hmatchBudget hlarge hrob hregions
      hℓsix hℓdouble (c := c) (ℓ := ℓ)
  · intro i
    have hhalf : ℓ / 2 ≤ t - 1 + 2 := by
      apply Nat.div_le_of_le_mul
      omega
    have hUi := hFirstU i
    exact (by omega : ℓ + ℓ / 2 + 2 ≤ (U i).card)
  · have hℓnext : ℓ + 1 ≤ (2 * (t - 1) + 4) + 1 :=
      Nat.add_le_add_right hℓupper 1
    have hcap : (2 * (t - 1) + 4) + 1 ≤ θ := by
      simpa [Nat.add_assoc] using hFirstθ
    exact hℓnext.trans hcap
  · intro i
    have hscale :
        3 * (2 * (t - 1) - 1) + 3 * c + 2 ≤
          3 * (2 * (t - 1) - 1) +
            3 * (k / (2 * (t - 1))) + 2 := by
      exact Nat.add_le_add_right
        (Nat.add_le_add_left (Nat.mul_le_mul_left 3 hc) _) 2
    exact hscale.trans (hRouteU i)
  · have hscale :
        3 * (2 * (t - 1) - 1) + 2 * c ≤
          3 * (2 * (t - 1) - 1) +
            2 * (k / (2 * (t - 1))) := by
      exact Nat.add_le_add_left (Nat.mul_le_mul_left 2 hc) _
    exact hscale.trans hRouteθ
  · exact hlen

/-- Interval form of the balanced component lift.  Quotient/remainder
allocation removes the exact product-form hypothesis: every target at least
`6(t-1)+3` is covered by the displayed `t + k/t` local budgets. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_balanced_range_of_card_ge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {t θ R k : ℕ} (hconn : H.Connected)
    (ht : 2 ≤ t) (htcard : t ≤ Fintype.card ι)
    (hfit : 6 * (t - 1) + 3 ≤ k)
    (hmatchBudget : 2 * (2 * (t - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i) 3)
    (hFirstU : ∀ i : ι, 2 * (t - 1) + 4 ≤ (U i).card)
    (hFirstθ : 2 * (t - 1) + 5 ≤ θ)
    (hRouteU : ∀ i : ι,
      3 * (2 * (t - 1) - 1) +
        3 * (k / (2 * (t - 1))) + 2 ≤ (U i).card)
    (hRouteθ : 3 * (2 * (t - 1) - 1) +
      2 * (k / (2 * (t - 1))) ≤ θ) :
    cycleGraph k ⊑ G := by
  obtain ⟨c, ℓ, hℓ, hℓupper, hcprod, hlen⟩ :=
    exists_balanced_route_decomposition ht hfit
  have hden : 0 < 2 * (t - 1) := by omega
  have hc : c ≤ k / (2 * (t - 1)) := by
    apply (Nat.le_div_iff_mul_le hden).2
    simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hcprod
  apply cycleGraph_isContained_of_connected_largeCrossMatching_balanced_of_card_ge
    G H U T hconn ht htcard hmatchBudget hlarge hrob hregions hℓ
      hparity (c := c) (ℓ := ℓ)
  · intro i
    exact hℓupper.trans (hFirstU i)
  · have hℓnext : ℓ + 1 ≤ (2 * (t - 1) + 4) + 1 :=
      Nat.add_le_add_right hℓupper 1
    have hcap : (2 * (t - 1) + 4) + 1 ≤ θ := by
      simpa [Nat.add_assoc] using hFirstθ
    exact hℓnext.trans hcap
  · intro i
    have hscale :
        3 * (2 * (t - 1) - 1) + 3 * c + 2 ≤
          3 * (2 * (t - 1) - 1) +
            3 * (k / (2 * (t - 1))) + 2 := by
      exact Nat.add_le_add_right
        (Nat.add_le_add_left (Nat.mul_le_mul_left 3 hc) _) 2
    exact hscale.trans (hRouteU i)
  · have hscale :
        3 * (2 * (t - 1) - 1) + 2 * c ≤
          3 * (2 * (t - 1) - 1) +
            2 * (k / (2 * (t - 1))) := by
      exact Nat.add_le_add_left (Nat.mul_le_mul_left 2 hc) _
    exact hscale.trans hRouteθ
  · exact hlen

/-- Square-root scale of the balanced component lift.  A component with more
than `sqrt k` hubs creates `C_k` once cross matchings have size `4 sqrt k`
and every robust core has the corresponding linear local capacities. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_sqrt_scale
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} (hconn : H.Connected)
    (hsqrt : 7 ≤ Nat.sqrt k)
    (hcard : Nat.sqrt k + 1 ≤ Fintype.card ι)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i) 3)
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ) :
    cycleGraph k ⊑ G := by
  let s : ℕ := Nat.sqrt k
  have hs : 7 ≤ s := by simpa [s] using hsqrt
  have hs2 : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hfit : 6 * s + 3 ≤ k := by
    nlinarith
  have hden : 0 < 2 * s := by omega
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hsquare : (s + 1) ^ 2 ≤ (s + 1) * (2 * s) := by
    nlinarith
  have hquot : k / (2 * s) ≤ s := by
    have hlt : k / (2 * s) < s + 1 := by
      apply (Nat.div_lt_iff_lt_mul hden).2
      exact hklt.trans_le hsquare
    omega
  apply cycleGraph_isContained_of_connected_largeCrossMatching_balanced_range_of_card_ge
    G H U T (t := s + 1) (θ := θ) (R := R) (k := k) hconn (by omega)
      (by simpa [s] using hcard)
  · simpa using hfit
  · dsimp [s]
    omega
  · exact hlarge
  · exact hrob
  · exact hregions
  · exact hparity
  · intro i
    have hi := hU i
    simp only [Nat.add_sub_cancel] at hi ⊢
    omega
  · simp only [Nat.add_sub_cancel]
    omega
  · intro i
    have hi := hU i
    simp only [Nat.add_sub_cancel]
    omega
  · simp only [Nat.add_sub_cancel]
    omega

