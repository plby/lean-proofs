/-- Every large-cross-matching component has fewer than `sqrt k + 1` labels
in a `C_k`-free graph when `k` is even; unlike the all-parity version, no
internal matching assumption is needed. -/
theorem ncard_connectedComponent_lt_succ_sqrt_of_cycleFree_largeCrossMatchingGraph_even
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) {θ R k : ℕ} (hkEven : Even k)
    (hsqrt : 7 ≤ Nat.sqrt k)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G U R).ConnectedComponent) :
    c.supp.ncard < Nat.sqrt k + 1 := by
  let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
  let K : SimpleGraph c := c.toSimpleGraph
  let Uc : c → Finset V := fun i => U i.1
  let Tc : c → Finset V := fun i => T i.1
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Uc i) (Uc j) R := by
    intro i j hij
    apply hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
      (G := G) (U := U) (m := R)
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint (Uc i ∪ Tc i) (Uc j ∪ Tc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hKcard : Fintype.card c < Nat.sqrt k + 1 := by
    apply card_lt_succ_sqrt_of_cycleFree_connected_largeCrossMatching_even
      G K Uc Tc c.connected_toSimpleGraph hkEven hsqrt hmatchBudget hKlarge
        (fun i => hrob i.1) hKregions (fun i => hU i.1) hθ hcycle
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  simpa [hcCard] using hKcard

/-- A finite graph which is not bipartite contains an odd closed walk.  This
is the parity obstruction in the two-colour characterization of bipartite
graphs, stated in the form needed by the auxiliary interaction graph. -/
theorem exists_odd_closed_walk_of_not_isBipartite
    {V : Type*} (H : SimpleGraph V) (hH : ¬ H.IsBipartite) :
    ∃ u : V, ∃ w : H.Walk u u, Odd w.length := by
  change ¬ H.Colorable 2 at hH
  rw [SimpleGraph.two_colorable_iff_forall_loop_even] at hH
  push_neg at hH
  obtain ⟨u, w, hw⟩ := hH
  exact ⟨u, w, Nat.not_even_iff_odd.mp hw⟩

/-- A connected finite non-bipartite graph has an odd closed walk of length
strictly less than twice its order.  We colour each vertex by the parity of a
simple root path.  A monochromatic edge exists because the graph is not
bipartite, and the two root paths together with that edge form the required
odd loop. -/
theorem exists_short_odd_closed_walk_of_connected_not_isBipartite
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hH : ¬ H.IsBipartite) :
    ∃ u : V, ∃ w : H.Walk u u,
      Odd w.length ∧ w.length < 2 * Fintype.card V := by
  classical
  let : Nonempty V := hconn.nonempty
  let r : V := Classical.choice hconn.nonempty
  let p : ∀ v : V, H.Walk r v := fun v => (hconn r v).some.bypass
  have hp : ∀ v : V, (p v).IsPath := fun v => Walk.bypass_isPath _
  let f : V → Fin 2 := fun v =>
    ⟨(p v).length % 2, Nat.mod_lt _ (by omega)⟩
  have hbad : ∃ a b : V, H.Adj a b ∧ f a = f b := by
    by_contra hnot
    apply hH
    refine ⟨SimpleGraph.Coloring.mk f ?_⟩
    intro a b hab heq
    apply hnot
    exact ⟨a, b, hab, heq⟩
  obtain ⟨a, b, hab, hf⟩ := hbad
  let w : H.Walk r r := ((p a).concat hab).append (p b).reverse
  refine ⟨r, w, ?_, ?_⟩
  · have hmod : (p a).length % 2 = (p b).length % 2 := by
      exact congrArg Fin.val hf
    rw [Nat.odd_iff]
    simp [w, Nat.add_mod, hmod]
    omega
  · have hpa := (hp a).length_lt
    have hpb := (hp b).length_lt
    simp [w]
    omega

/-- Support-sensitive form of the short odd-loop construction.  One of the
two simple root paths has enough distinct vertices to pay for half the loop
length.  This stronger estimate is what makes two-edge support extensions
preserve the final strict `2 |V|` bound. -/
theorem exists_short_supported_odd_closed_walk_of_connected_not_isBipartite
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hH : ¬ H.IsBipartite) :
    ∃ u : V, ∃ w : H.Walk u u,
      Odd w.length ∧ w.length < 2 * w.support.toFinset.card := by
  classical
  let : Nonempty V := hconn.nonempty
  let r : V := Classical.choice hconn.nonempty
  let p : ∀ v : V, H.Walk r v := fun v => (hconn r v).some.bypass
  have hp : ∀ v : V, (p v).IsPath := fun v => Walk.bypass_isPath _
  let f : V → Fin 2 := fun v =>
    ⟨(p v).length % 2, Nat.mod_lt _ (by omega)⟩
  have hbad : ∃ a b : V, H.Adj a b ∧ f a = f b := by
    by_contra hnot
    apply hH
    refine ⟨SimpleGraph.Coloring.mk f ?_⟩
    intro a b hab heq
    apply hnot
    exact ⟨a, b, hab, heq⟩
  obtain ⟨a, b, hab, hf⟩ := hbad
  let w : H.Walk r r := ((p a).concat hab).append (p b).reverse
  refine ⟨r, w, ?_, ?_⟩
  · have hmod : (p a).length % 2 = (p b).length % 2 := by
      exact congrArg Fin.val hf
    rw [Nat.odd_iff]
    simp [w, Nat.add_mod, hmod]
    omega
  · have hpaSub : (p a).support.toFinset ⊆ w.support.toFinset := by
      intro x hx
      simp only [List.mem_toFinset] at hx ⊢
      exact Walk.support_subset_support_append_left ((p a).concat hab) (p b).reverse
        (Walk.support_subset_support_concat (p a) hab hx)
    have hpbSub : (p b).support.toFinset ⊆ w.support.toFinset := by
      intro x hx
      simp only [List.mem_toFinset] at hx ⊢
      apply Walk.support_subset_support_append_right ((p a).concat hab) (p b).reverse
      simpa using hx
    have hpaCard : (p a).support.toFinset.card = (p a).length + 1 := by
      rw [List.toFinset_card_of_nodup (hp a).support_nodup,
        Walk.length_support]
    have hpbCard : (p b).support.toFinset.card = (p b).length + 1 := by
      rw [List.toFinset_card_of_nodup (hp b).support_nodup,
        Walk.length_support]
    have hpaLe := Finset.card_le_card hpaSub
    have hpbLe := Finset.card_le_card hpbSub
    simp only [hpaCard] at hpaLe
    simp only [hpbCard] at hpbLe
    have hwLen : w.length = (p a).length + 1 + (p b).length := by
      simp [w]
    rw [hwLen]
    omega

/-- A nontrivial finite vertex cut in a connected graph has an edge crossing
it.  We use the first vertex outside the cut along a connecting walk. -/
theorem exists_adj_mem_not_mem_of_connected
    {V : Type*} [Fintype V] (H : SimpleGraph V) (hconn : H.Connected)
    (S : Finset V) (hne : S.Nonempty) (hproper : S ≠ Finset.univ) :
    ∃ y ∈ S, ∃ z ∉ S, H.Adj y z := by
  classical
  obtain ⟨s, hs⟩ := hne
  have hnotall : ¬ ∀ x : V, x ∈ S := by
    intro hall
    exact hproper (Finset.eq_univ_iff_forall.mpr hall)
  push_neg at hnotall
  obtain ⟨x, hx⟩ := hnotall
  let q : H.Walk s x := (hconn s x).some
  have hex : ∃ n : ℕ, q.getVert n ∉ S := by
    exact ⟨q.length, by simpa using hx⟩
  let m : ℕ := Nat.find hex
  have hmOut : q.getVert m ∉ S := Nat.find_spec hex
  have hmle : m ≤ q.length := by
    exact Nat.find_min' hex (by simpa using hx)
  have hmpos : 0 < m := by
    by_contra hm
    have hmzero : m = 0 := by omega
    exact hmOut (by simpa [hmzero] using hs)
  have hmPred : q.getVert (m - 1) ∈ S := by
    by_contra hout
    exact Nat.find_min hex (by omega) hout
  refine ⟨q.getVert (m - 1), hmPred, q.getVert m, hmOut, ?_⟩
  have hpredlt : m - 1 < m := Nat.sub_lt hmpos (by omega)
  have hadj := q.adj_getVert_succ (i := m - 1) (hpredlt.trans_le hmle)
  have heq : m - 1 + 1 = m := Nat.sub_add_cancel (by omega)
  simpa only [heq] using hadj

/-- A finite connected graph of maximum degree at most two has a spanning
simple path.  A maximal path cannot have an outside neighbour at an endpoint,
while an outside neighbour at an internal vertex would give that vertex its
two path neighbours plus a third distinct neighbour. -/
theorem exists_spanning_isPath_of_connected_degree_le_two
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hdeg : ∀ v : V, H.degree v ≤ 2) :
    ∃ u v : V, ∃ p : H.Walk u v, p.IsPath ∧
      p.support.toFinset = Finset.univ := by
  classical
  let : Nonempty V := hconn.nonempty
  obtain ⟨u, v, p, hp, hmax⟩ := exists_maximal_isPath H
  refine ⟨u, v, p, hp, ?_⟩
  by_contra hproper
  obtain ⟨y, hy, z, hz, hyz⟩ :=
    exists_adj_mem_not_mem_of_connected H hconn p.support.toFinset
      ⟨u, by simp⟩ hproper
  have hySupport : y ∈ p.support := by simpa using hy
  by_cases hyu : y = u
  · subst y
    have hzSupport : z ∉ p.support := by simpa using hz
    have hpath : (p.cons hyz.symm).IsPath := hp.cons hzSupport
    have hle := hmax z v (p.cons hyz.symm) hpath
    simp at hle
  · by_cases hyv : y = v
    · subst y
      have hzSupport : z ∉ p.support := by simpa using hz
      have hpath : (p.concat hyz).IsPath := hp.concat hzSupport hyz
      have hle := hmax u z (p.concat hyz) hpath
      simp at hle
    · obtain ⟨i, hiy, hi⟩ :=
        Walk.mem_support_iff_exists_getVert.mp hySupport
      have hi0 : i ≠ 0 := by
        intro h
        apply hyu
        simpa [h] using hiy.symm
      have hilt : i < p.length := by
        by_contra hnot
        have hilength : i = p.length := by omega
        apply hyv
        simpa [hilength] using hiy.symm
      have hzNotSub : z ∉ p.toSubgraph.neighborSet y := by
        intro hzSub
        have hzVert : z ∈ p.toSubgraph.verts :=
          p.toSubgraph.neighborSet_subset_verts y hzSub
        exact hz (by simpa [Walk.mem_verts_toSubgraph] using hzVert)
      have hinsertSub : insert z (p.toSubgraph.neighborSet y) ⊆
          H.neighborSet y := by
        intro x hx
        rcases hx with rfl | hx
        · exact hyz
        · exact p.toSubgraph.neighborSet_subset y hx
      have hthree : (insert z (p.toSubgraph.neighborSet y)).ncard = 3 := by
        rw [Set.ncard_insert_of_notMem hzNotSub]
        rw [← hiy]
        have htwo := hp.ncard_neighborSet_toSubgraph_internal_eq_two hi0 hilt
        omega
      have hle : 3 ≤ (H.neighborSet y).ncard := by
        rw [← hthree]
        exact Set.ncard_mono hinsertSub
      have hydeg : (H.neighborSet y).ncard = H.degree y := by
        rw [← Set.fintypeCard_eq_ncard]
        exact H.card_neighborSet_eq_degree y
      have : 3 ≤ H.degree y := hle.trans_eq hydeg
      have hyUpper := hdeg y
      omega

/-- Every feasible initial length occurs as a simple path in a finite
connected graph of maximum degree at most two.  Take a spanning path and
truncate it at the requested number of edges. -/
theorem exists_isPath_length_eq_of_connected_degree_le_two
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hdeg : ∀ v : V, H.degree v ≤ 2)
    {ℓ : ℕ} (hℓ : ℓ < Fintype.card V) :
    ∃ u v : V, ∃ p : H.Walk u v, p.IsPath ∧ p.length = ℓ := by
  classical
  obtain ⟨u, v, p, hp, hsupp⟩ :=
    exists_spanning_isPath_of_connected_degree_le_two H hconn hdeg
  have hpcard : p.length + 1 = Fintype.card V := by
    have hsupport : p.support.toFinset.card = p.length + 1 := by
      rw [List.toFinset_card_of_nodup hp.support_nodup,
        Walk.length_support]
    rw [hsupp] at hsupport
    simpa using hsupport.symm
  let q : H.Walk u (p.getVert ℓ) := p.take ℓ
  refine ⟨u, p.getVert ℓ, q, hp.take ℓ, ?_⟩
  simp [q]
  omega

/-- The numerical window used by the path-ladder component bound.  At
`L = floor(sqrt k / 16)`, the scaffold capacity `9 * sqrt k - 8` absorbs
the entire residual in both parity cases.  The deliberately coarse lower
threshold keeps all floor and subtraction estimates integral. -/
theorem sqrt_sixteenth_path_ladder_estimates {k : ℕ}
    (hsqrt : 256 ≤ Nat.sqrt k) :
    let s := Nat.sqrt k
    let L := s / 16
    let d := L - 1
    d + 1 = L ∧ 8 ≤ 9 * s ∧ 3 ≤ k ∧
      14 * L ≤ k ∧
      (k - 14 * L) / 2 ≤ (9 * s - 8) * (L + 1) ∧
      (k - (14 * L - 1)) / 2 ≤ (9 * s - 8) * L := by
  let s := Nat.sqrt k
  let L := s / 16
  let d := L - 1
  have hs : 256 ≤ s := by simpa [s] using hsqrt
  have hL16 : 16 ≤ L := by
    dsimp [L]
    omega
  have hLpos : 0 < L := by omega
  have hd : d + 1 = L := by
    dsimp [d]
    omega
  have hLlower : 16 * L ≤ s := by
    dsimp [L]
    have h := Nat.div_mul_le_self s 16
    simpa [Nat.mul_comm] using h
  have hLupper : s < 16 * (L + 1) := by
    dsimp [L]
    omega
  have hsquare : s ^ 2 ≤ k := by
    simpa [s] using Nat.sqrt_le' k
  have hkupper : k < (s + 1) ^ 2 := by
    simpa [s] using Nat.lt_succ_sqrt' k
  have hbase : 14 * L ≤ k := by
    have h14s : 14 ≤ s := by omega
    have hLs : L ≤ s := by omega
    have hmul : 14 * L ≤ s * s := Nat.mul_le_mul h14s hLs
    nlinarith
  let r : ℕ := s - 16 * L
  have hrDecomp : 16 * L + r = s := by
    dsimp [r]
    omega
  have hr : r ≤ 15 := by
    dsimp [r]
    omega
  let a : ℕ := 9 * s - 8
  have haDecomp : a + 8 = 9 * s := by
    dsimp [a]
    omega
  have hrL : r * L ≤ 15 * L := Nat.mul_le_mul_right L hr
  have hrr : r * r ≤ 15 * 15 := Nat.mul_le_mul hr hr
  have hLL : 16 * L ≤ L * L := Nat.mul_le_mul_right L hL16
  have hraw : k ≤ 2 * (a * L) := by
    have hsquareUpper : k ≤ (s + 1) ^ 2 := Nat.le_of_lt hkupper
    have hpoly : (s + 1) ^ 2 ≤ 2 * (a * L) := by
      nlinarith
    exact hsquareUpper.trans hpoly
  have hrawEven : k ≤ 2 * (a * (L + 1)) := by
    have hmono : a * L ≤ a * (L + 1) :=
      Nat.mul_le_mul_left a (Nat.le_succ L)
    exact hraw.trans (Nat.mul_le_mul_left 2 hmono)
  have hevenCap : (k - 14 * L) / 2 ≤ (9 * s - 8) * (L + 1) := by
    change (k - 14 * L) / 2 ≤ a * (L + 1)
    omega
  have hoddCap : (k - (14 * L - 1)) / 2 ≤ (9 * s - 8) * L := by
    change (k - (14 * L - 1)) / 2 ≤ a * L
    omega
  exact ⟨hd, by omega, by nlinarith, hbase, hevenCap, hoddCap⟩

/-- A cycle-free ambient graph bounds the order of a connected
maximum-degree-two interaction graph as soon as the even doubled-path ladder
fits at one requested length.  If the component were larger, truncate a
spanning path and apply the exact ladder lift. -/
theorem card_le_add_one_of_cycleFree_connected_degree_le_two_alternatingScaffold_even
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (hconn : H.Connected)
    (hdeg : ∀ i : ι, H.degree i ≤ 2)
    (A B D : ι → Finset V) {d q theta R k : ℕ}
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 8 ≤ q) (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (A i) (A j) R)
    (hmatchBudget : 4 * (d + 1) < R)
    (hk : 3 ≤ k) (hbase : 14 * (d + 1) ≤ k)
    (hparity : (k - 14 * (d + 1)) % 2 = 0)
    (hcapacity : (k - 14 * (d + 1)) / 2 ≤
      (q - 8) * (d + 2))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card ι ≤ d + 1 := by
  by_contra hnot
  have hroom : d + 1 < Fintype.card ι := by omega
  obtain ⟨u, v, w, hwpath, hwlen⟩ :=
    exists_isPath_length_eq_of_connected_degree_le_two H hconn hdeg hroom
  apply hcycle
  exact cycleGraph_isContained_of_largeCrossMatching_path_alternatingScaffolds
    G H w hwlen hwpath A B D hscaffold hrob hmajorD hq htheta hregions
      hlarge hmatchBudget hk hbase hparity hcapacity

/-- Odd-length companion to the preceding component bound.  Every possible
initial vertex has a three-edge internal matching, so whichever endpoint the
truncated spanning path chooses supplies the unique five-edge parity route. -/
theorem card_le_add_one_of_cycleFree_connected_degree_le_two_alternatingScaffold_odd
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (hconn : H.Connected)
    (hdeg : ∀ i : ι, H.degree i ≤ 2)
    (A B D : ι → Finset V) {d q theta R k : ℕ}
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 8 ≤ q) (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (A i) (A j) R)
    (hmatch : ∀ i : ι, HasThreeDisjointAdjPairFamily G (A i))
    (hmatchBudget : 4 * (d + 1) < R)
    (hk : 3 ≤ k) (hbase : 14 * (d + 1) - 1 ≤ k)
    (hparity : (k - (14 * (d + 1) - 1)) % 2 = 0)
    (hcapacity : (k - (14 * (d + 1) - 1)) / 2 ≤
      (q - 8) * (d + 1))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card ι ≤ d + 1 := by
  by_contra hnot
  have hroom : d + 1 < Fintype.card ι := by omega
  obtain ⟨u, v, w, hwpath, hwlen⟩ :=
    exists_isPath_length_eq_of_connected_degree_le_two H hconn hdeg hroom
  apply hcycle
  exact cycleGraph_isContained_of_largeCrossMatching_path_alternatingScaffolds_odd
    G H w hwlen hwpath A B D hscaffold hrob hmajorD hq htheta hregions
      hlarge (hmatch (w.getVert 0)) hmatchBudget hk hbase hparity hcapacity

/-- Concrete square-root component bound supplied by the two path ladders.
For every target parity, a connected maximum-degree-two interaction graph of
matched alternating hubs has order at most `floor(sqrt k / 16)`. -/
theorem card_le_sqrt_div_sixteen_of_cycleFree_connected_degree_le_two_alternatingScaffold
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (hconn : H.Connected)
    (hdeg : ∀ i : ι, H.degree i ≤ 2)
    (A B D : ι → Finset V) {theta R k : ℕ}
    (hsqrt : 256 ≤ Nat.sqrt k)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (A i) (A j) R)
    (hmatch : ∀ i : ι, HasThreeDisjointAdjPairFamily G (A i))
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card ι ≤ Nat.sqrt k / 16 := by
  let s := Nat.sqrt k
  let L := s / 16
  let d := L - 1
  obtain ⟨hd, hq, hk, hbase, hevenCapacity, hoddCapacity⟩ :=
    sqrt_sixteenth_path_ladder_estimates hsqrt
  have hLs : L ≤ s := by
    have hLlower : 16 * L ≤ s := by
      dsimp [L]
      have h := Nat.div_mul_le_self s 16
      simpa [Nat.mul_comm] using h
    omega
  have hbudget : 4 * (d + 1) < R := by
    rw [hd]
    exact (Nat.mul_le_mul_left 4 hLs).trans_lt (by simpa [s] using hmatchBudget)
  have hd2 : d + 2 = L + 1 := by omega
  have hkmod : k % 2 < 2 := Nat.mod_lt k (by omega)
  by_cases heven : k % 2 = 0
  · have hparity : (k - 14 * (d + 1)) % 2 = 0 := by
      rw [hd]
      omega
    have hcapacity : (k - 14 * (d + 1)) / 2 ≤
        (9 * s - 8) * (d + 2) := by
      rw [hd, hd2]
      exact hevenCapacity
    have hbase' : 14 * (d + 1) ≤ k := by
      rw [hd]
      exact hbase
    have hbound :=
      card_le_add_one_of_cycleFree_connected_degree_le_two_alternatingScaffold_even
        G H hconn hdeg A B D (d := d) (q := 9 * s) (theta := theta)
          (R := R) (k := k) (by simpa [s] using hscaffold) hrob hmajorD
          hq htheta hregions hlarge hbudget hk hbase'
          hparity hcapacity hcycle
    rw [hd] at hbound
    simpa [L, s] using hbound
  · have hodd : k % 2 = 1 := by omega
    have hoddBase : 14 * (d + 1) - 1 ≤ k := by
      rw [hd]
      omega
    have hparity : (k - (14 * (d + 1) - 1)) % 2 = 0 := by
      rw [hd]
      omega
    have hcapacity : (k - (14 * (d + 1) - 1)) / 2 ≤
        (9 * s - 8) * (d + 1) := by
      rw [hd]
      exact hoddCapacity
    have hbound :=
      card_le_add_one_of_cycleFree_connected_degree_le_two_alternatingScaffold_odd
        G H hconn hdeg A B D (d := d) (q := 9 * s) (theta := theta)
          (R := R) (k := k) (by simpa [s] using hscaffold) hrob hmajorD
          hq htheta hregions hlarge hmatch hbudget hk hoddBase hparity
          hcapacity hcycle
    rw [hd] at hbound
    simpa [L, s] using hbound

/-- In a connected graph of maximum degree at most two, the support of any
cycle is all of the vertex set.  Otherwise an edge crossing from the cycle
support to its complement would give a cycle vertex three distinct
neighbours. -/
theorem cycle_support_eq_univ_of_connected_degree_le_two
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hdeg : ∀ v : V, H.degree v ≤ 2)
    {u : V} (p : H.Walk u u) (hp : p.IsCycle) :
    p.support.toFinset = Finset.univ := by
  classical
  by_contra hproper
  obtain ⟨y, hy, z, hz, hyz⟩ :=
    exists_adj_mem_not_mem_of_connected H hconn p.support.toFinset
      ⟨u, by simp⟩ hproper
  have hySupport : y ∈ p.support := by simpa using hy
  have hzNotSub : z ∉ p.toSubgraph.neighborSet y := by
    intro hzSub
    have hzVert : z ∈ p.toSubgraph.verts :=
      p.toSubgraph.neighborSet_subset_verts y hzSub
    exact hz (by simpa [Walk.mem_verts_toSubgraph] using hzVert)
  have hinsertSub : insert z (p.toSubgraph.neighborSet y) ⊆ H.neighborSet y := by
    intro x hx
    rcases hx with rfl | hx
    · exact hyz
    · exact p.toSubgraph.neighborSet_subset y hx
  have hthree : (insert z (p.toSubgraph.neighborSet y)).ncard = 3 := by
    rw [Set.ncard_insert_of_notMem hzNotSub]
    rw [hp.ncard_neighborSet_toSubgraph_eq_two hySupport]
  have hle : 3 ≤ (H.neighborSet y).ncard := by
    rw [← hthree]
    exact Set.ncard_mono hinsertSub
  have hydeg : (H.neighborSet y).ncard = H.degree y := by
    rw [← Set.fintypeCard_eq_ncard]
    exact H.card_neighborSet_eq_degree y
  have hthreeDegree : 3 ≤ H.degree y := hle.trans_eq hydeg
  have hyUpper := hdeg y
  omega

/-- A spanning copy of a cycle in a graph of maximum degree at most two is
induced, hence is a graph isomorphism.  The proof upgrades the vertex
injection to a bijection and uses equality of the two-element neighbour sets
to reflect adjacency. -/
theorem exists_cycleGraph_iso_of_spanning_copy_degree_le_two
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    {n : ℕ} (hn : 3 ≤ n) (f : SimpleGraph.Copy (cycleGraph n) H)
    (hcard : n = Fintype.card V) (hdeg : ∀ v : V, H.degree v ≤ 2) :
    Nonempty (cycleGraph n ≃g H) := by
  classical
  have hfSurj : Function.Surjective f := by
    apply f.injective.surjective_of_finite
    apply Fintype.equivOfCardEq
    simpa [hcard]
  let e : Fin n ≃ V := Equiv.ofBijective f ⟨f.injective, hfSurj⟩
  refine ⟨{ __ := e, map_rel_iff' := ?_ }⟩
  intro x y
  change H.Adj (f x) (f y) ↔ (cycleGraph n).Adj x y
  constructor
  · intro hxy
    have hsrcdeg : (cycleGraph n).degree x = 2 := by
      obtain ⟨m, rfl : n = m + 3⟩ := Nat.exists_eq_add_of_le' hn
      simpa using
        (cycleGraph_degree_three_le (n := m) (v := x))
    have htgtdeg : H.degree (f x) = 2 := by
      apply le_antisymm (hdeg (f x))
      rw [← hsrcdeg]
      exact f.degree_le x
    have hneighborCard :
        Fintype.card ((cycleGraph n).neighborSet x) =
          Fintype.card (H.neighborSet (f x)) := by
      rw [(cycleGraph n).card_neighborSet_eq_degree x,
        H.card_neighborSet_eq_degree (f x), hsrcdeg, htgtdeg]
    have hmapSurj : Function.Surjective (f.mapNeighborSet x) := by
      apply (f.mapNeighborSet x).injective.surjective_of_finite
      exact Fintype.equivOfCardEq hneighborCard
    have hfy : f y ∈ H.neighborSet (f x) := by
      exact hxy
    obtain ⟨z, hz⟩ := hmapSurj ⟨f y, hfy⟩
    have hzy : z.1 = y := by
      apply f.injective
      exact congrArg Subtype.val hz
    simpa [hzy] using z.2
  · exact f.toHom.map_rel

/-- A cycle whose support is the whole finite vertex set has length equal to
the order of the graph. -/
theorem cycle_length_eq_card_of_support_eq_univ
    {V : Type*} [Fintype V] {H : SimpleGraph V} {u : V}
    (p : H.Walk u u) (hp : p.IsCycle)
    (hsupp : p.support.toFinset = Finset.univ) :
    p.length = Fintype.card V := by
  have hdropEq : p.support.dropLast.toFinset = p.support.toFinset := by
    have hplen := hp.three_le_length
    have huDrop : u ∈ p.support.dropLast := by
      have hne : p.support.dropLast ≠ [] := by
        intro hempty
        have hzero := congrArg List.length hempty
        simp only [List.length_nil] at hzero
        rw [List.length_dropLast, Walk.length_support] at hzero
        omega
      have hhead : p.support.dropLast.head hne = u := by
        rw [List.head_dropLast]
        simp
      have hmem := List.head_mem hne
      rwa [hhead] at hmem
    calc
      p.support.dropLast.toFinset =
          (p.support.dropLast ++ [u]).toFinset := by
        rw [List.toFinset_append]
        symm
        apply Finset.union_eq_left.mpr
        intro x hx
        simp only [List.toFinset_cons, List.toFinset_nil,
          Finset.mem_insert] at hx
        simp at hx
        subst x
        simpa using huDrop
      _ = p.support.toFinset :=
        congrArg List.toFinset p.dropLast_support_concat
  calc
    p.length = p.support.dropLast.length := by
      have hplen := hp.three_le_length
      rw [List.length_dropLast, Walk.length_support]
      omega
    _ = p.support.dropLast.toFinset.card := by
      rw [List.toFinset_card_of_nodup hp.nodup_dropLast_support]
    _ = p.support.toFinset.card := by rw [hdropEq]
    _ = Fintype.card V := by simp [hsupp]

/-- A connected finite non-bipartite graph of maximum degree at most two is
an odd cycle.  The conclusion is given as an odd Hamiltonian closed walk,
which is the precise form consumed by the balanced robust-hub router. -/
theorem exists_odd_hamiltonian_cycle_of_connected_degree_le_two_not_bipartite
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hdeg : ∀ v : V, H.degree v ≤ 2)
    (hnotbip : ¬ H.IsBipartite) :
    ∃ u : V, ∃ p : H.Walk u u,
      p.IsCycle ∧ Odd p.length ∧ p.length = Fintype.card V := by
  have hnotacyc : ¬ H.IsAcyclic := fun hacyc => hnotbip hacyc.isBipartite
  unfold SimpleGraph.IsAcyclic at hnotacyc
  push_neg at hnotacyc
  obtain ⟨u, p, hp⟩ := hnotacyc
  have hsupp : p.support.toFinset = Finset.univ :=
    cycle_support_eq_univ_of_connected_degree_le_two H hconn hdeg p hp
  have hlen : p.length = Fintype.card V :=
    cycle_length_eq_card_of_support_eq_univ p hp hsupp
  have hodd : Odd p.length := by
    by_contra hnotodd
    have heven : Even p.length := Nat.not_odd_iff_even.mp hnotodd
    have hcopy : cycleGraph p.length ⊑ H := by
      apply (cycleGraph_isContained_iff hp.three_le_length).2
      exact ⟨u, p, hp, rfl⟩
    obtain ⟨f⟩ := hcopy
    obtain ⟨e⟩ :=
      exists_cycleGraph_iso_of_spanning_copy_degree_le_two
        H hp.three_le_length f hlen hdeg
    let c : H.Coloring Bool :=
      (cycleGraph.bicoloring_of_even p.length heven).comap e.symm.toHom
    apply hnotbip
    simpa using c.colorable
  exact ⟨u, p, hp, hodd, hlen⟩

/-- Insert one new support vertex into a closed walk using an out-and-back
detour across a cut edge.  The length rises by exactly two and the support by
exactly one. -/
theorem exists_closed_walk_add_one_support_of_connected
    {V : Type*} [Fintype V] (H : SimpleGraph V) (hconn : H.Connected)
    {u : V} (p : H.Walk u u) (hproper : p.support.toFinset ≠ Finset.univ) :
    ∃ z : V, ∃ w : H.Walk z z,
      z ∉ p.support.toFinset ∧ w.length = p.length + 2 ∧
        w.support.toFinset = insert z p.support.toFinset := by
  classical
  have hpne : p.support.toFinset.Nonempty := by
    exact ⟨u, by simp⟩
  obtain ⟨y, hy, z, hz, hyz⟩ :=
    exists_adj_mem_not_mem_of_connected H hconn p.support.toFinset hpne hproper
  have hySupport : y ∈ p.support := by simpa using hy
  let w : H.Walk z z := ((p.rotate y hySupport).concat hyz).cons hyz.symm
  refine ⟨z, w, hz, ?_, ?_⟩
  · simp [w]
  · ext x
    simp [w, Walk.mem_support_rotate_iff]

/-- Iterating the one-vertex detour extends any closed walk to a spanning
closed walk.  The exact cost is two edges per previously absent vertex. -/
theorem exists_spanning_closed_walk_with_exact_extension_length
    {V : Type*} [Fintype V] (H : SimpleGraph V) (hconn : H.Connected)
    {u : V} (p : H.Walk u u) :
    ∃ v : V, ∃ w : H.Walk v v,
      w.length = p.length +
          2 * (Fintype.card V - p.support.toFinset.card) ∧
        ∀ x : V, x ∈ w.support := by
  classical
  let m := Fintype.card V - p.support.toFinset.card
  have hm : Fintype.card V - p.support.toFinset.card = m := rfl
  clear_value m
  induction m generalizing u with
  | zero =>
      have hcardle : p.support.toFinset.card ≤ Fintype.card V :=
        Finset.card_le_univ p.support.toFinset
      have hcardeq : p.support.toFinset.card = Fintype.card V := by omega
      have hfull : p.support.toFinset = Finset.univ :=
        (Finset.card_eq_iff_eq_univ p.support.toFinset).mp hcardeq
      refine ⟨u, p, by omega, ?_⟩
      intro x
      have hx : x ∈ p.support.toFinset := by simp [hfull]
      simpa using hx
  | succ m ih =>
      have hproper : p.support.toFinset ≠ Finset.univ := by
        intro hfull
        have hcardeq : p.support.toFinset.card = Fintype.card V := by
          simp [hfull]
        omega
      obtain ⟨z, w, hz, hwLen, hwSupp⟩ :=
        exists_closed_walk_add_one_support_of_connected H hconn p hproper
      have hwCard : w.support.toFinset.card = p.support.toFinset.card + 1 := by
        rw [hwSupp]
        simp [hz]
      have hpCardLe : p.support.toFinset.card ≤ Fintype.card V :=
        Finset.card_le_univ p.support.toFinset
      have hwMissing : Fintype.card V - w.support.toFinset.card = m := by
        omega
      obtain ⟨v, q, hqLen, hqSpan⟩ := ih w hwMissing
      refine ⟨v, q, ?_, hqSpan⟩
      omega

/-- Inducing a walk on any vertex set containing its support preserves its
length.  This elementary structural lemma is kept explicit because the
endpoint proof terms in `Walk.induce` make the fact inconvenient to recover
by simplification alone. -/
theorem length_walk_induce
    {V : Type*} {G : SimpleGraph V} {s : Set V} {u v : V}
    (w : G.Walk u v) (hw : ∀ x ∈ w.support, x ∈ s) :
    (w.induce s hw).length = w.length := by
  induction w with
  | nil => rfl
  | cons h w ih =>
      simp only [Walk.induce_cons, Walk.length_cons]
      exact congrArg Nat.succ (ih _)

/-- In a connected graph, an odd closed walk can be enlarged by two-edge
detours until its support has any prescribed feasible cardinality.  Each
detour preserves odd parity and raises the support cardinality by one. -/
theorem exists_odd_closed_walk_with_exact_support_card_of_connected
    {V : Type*} [Fintype V] (H : SimpleGraph V) (hconn : H.Connected)
    {u : V} (p : H.Walk u u) (hpOdd : Odd p.length) {t : ℕ}
    (hpCard : p.support.toFinset.card ≤ t) (htCard : t ≤ Fintype.card V) :
    ∃ v : V, ∃ w : H.Walk v v,
      Odd w.length ∧ w.support.toFinset.card = t := by
  classical
  let m := t - p.support.toFinset.card
  have hm : t - p.support.toFinset.card = m := rfl
  clear_value m
  induction m generalizing u with
  | zero =>
      refine ⟨u, p, hpOdd, ?_⟩
      omega
  | succ m ih =>
      have hproper : p.support.toFinset ≠ Finset.univ := by
        intro hfull
        have hcardeq : p.support.toFinset.card = Fintype.card V := by
          simp [hfull]
        omega
      obtain ⟨z, w, hz, hwLen, hwSupp⟩ :=
        exists_closed_walk_add_one_support_of_connected H hconn p hproper
      have hwOdd : Odd w.length := by
        rw [hwLen]
        exact hpOdd.add_even ⟨1, by omega⟩
      have hwCard : w.support.toFinset.card = p.support.toFinset.card + 1 := by
        rw [hwSupp]
        simp [hz]
      have hwCardLe : w.support.toFinset.card ≤ t := by omega
      have hwMissing : t - w.support.toFinset.card = m := by omega
      exact ih w hwOdd hwCardLe hwMissing

/-- Exact-size normalization of a small odd witness.  The enlarged walk
spans its support, so the induced graph on that support is connected; its odd
induced walk also rules out a two-colouring. -/
theorem exists_induced_connected_nonbipartite_exact_card_of_odd_walk
    {V : Type*} [Fintype V] (H : SimpleGraph V) (hconn : H.Connected)
    {u : V} (p : H.Walk u u) (hpOdd : Odd p.length) {t : ℕ}
    (hpCard : p.support.toFinset.card ≤ t) (htCard : t ≤ Fintype.card V) :
    ∃ S : Finset V, S.card = t ∧
      (H.induce (S : Set V)).Connected ∧
        ¬ (H.induce (S : Set V)).IsBipartite := by
  classical
  obtain ⟨v, w, hwOdd, hwCard⟩ :=
    exists_odd_closed_walk_with_exact_support_card_of_connected
      H hconn p hpOdd hpCard htCard
  let S : Finset V := w.support.toFinset
  refine ⟨S, by simpa [S] using hwCard, ?_, ?_⟩
  · have hSet : (S : Set V) = {x | x ∈ w.support} := by
      ext x
      simp [S]
    rw [hSet]
    exact w.connected_induce_support
  · intro hbip
    change (H.induce (S : Set V)).Colorable 2 at hbip
    have hall := SimpleGraph.two_colorable_iff_forall_loop_even.mp hbip
    have hsupport : ∀ x ∈ w.support, x ∈ (S : Set V) := by
      intro x hx
      simpa [S] using hx
    let wi := w.induce (S : Set V) hsupport
    have heven := hall _ wi
    have hlen : wi.length = w.length := by
      exact length_walk_induce w hsupport
    rw [hlen] at heven
    exact (Nat.not_even_iff_odd.mpr hwOdd) heven

/-- Quantitative spanning form of the odd obstruction.  Starting from the
support-sensitive odd loop and adding each missing vertex by a two-edge
detour gives an odd spanning closed walk of length strictly below twice the
order. -/
theorem exists_bounded_odd_spanning_closed_walk_of_connected_not_isBipartite
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hH : ¬ H.IsBipartite) :
    ∃ u : V, ∃ w : H.Walk u u,
      Odd w.length ∧ w.length < 2 * Fintype.card V ∧
        ∀ v : V, v ∈ w.support := by
  obtain ⟨u, p, hpOdd, hpLen⟩ :=
    exists_short_supported_odd_closed_walk_of_connected_not_isBipartite
      H hconn hH
  obtain ⟨v, w, hwLen, hwSpan⟩ :=
    exists_spanning_closed_walk_with_exact_extension_length H hconn p
  refine ⟨v, w, ?_, ?_, hwSpan⟩
  · rw [hwLen]
    exact hpOdd.add_even
      ⟨Fintype.card V - p.support.toFinset.card, by omega⟩
  · have hpCardLe : p.support.toFinset.card ≤ Fintype.card V :=
      Finset.card_le_univ p.support.toFinset
    omega

/-- In a connected finite non-bipartite graph, an odd closed walk can be
augmented by a doubled spanning-tree tour so that its support contains every
vertex while its parity remains odd. -/
theorem exists_odd_spanning_closed_walk_of_connected_not_isBipartite
    {V : Type*} [Fintype V] (H : SimpleGraph V)
    (hconn : H.Connected) (hH : ¬ H.IsBipartite) :
    ∃ u : V, ∃ w : H.Walk u u,
      Odd w.length ∧ ∀ v : V, v ∈ w.support := by
  obtain ⟨u, w, hwOdd, _hwLen, hwSupp⟩ :=
    exists_bounded_odd_spanning_closed_walk_of_connected_not_isBipartite
      H hconn hH
  exact ⟨u, w, hwOdd, hwSupp⟩

/-- Quantitative odd interaction-component lift.  A connected non-bipartite
auxiliary graph supplies a spanning odd closed walk of length less than twice
its order.  Exact balanced visit weights then distribute the remaining even
length among the robust hubs, with per-hub cost `O(|H| + k / |H|)`. -/
theorem cycleGraph_isContained_of_connected_nonbipartite_largeCrossMatching
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} (hconn : H.Connected) (hnotbip : ¬ H.IsBipartite)
    (hkOdd : Odd k) (hfit : 6 * Fintype.card ι ≤ k)
    (hmatchBudget : 4 * Fintype.card ι < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι,
      6 * Fintype.card ι +
        3 * (k / Fintype.card ι + 1) + 2 ≤ (U i).card)
    (hθ : 6 * Fintype.card ι +
      2 * (k / Fintype.card ι + 1) ≤ θ) :
    cycleGraph k ⊑ G := by
  let : Nonempty ι := hconn.nonempty
  obtain ⟨u, w, hwOdd, hwlt, hspan⟩ :=
    exists_bounded_odd_spanning_closed_walk_of_connected_not_isBipartite
      H hconn hnotbip
  have hwpos : 0 < w.length := by
    exact Nat.pos_of_ne_zero fun hwzero => by
      rw [hwzero] at hwOdd
      exact Nat.not_odd_iff_even.mpr Even.zero hwOdd
  have hwlen : 2 ≤ w.length := by
    by_contra hnot
    have hone : w.length = 1 := by omega
    exact H.loopless.irrefl u (w.adj_of_length_eq_one hone)
  have hbase : 3 * w.length ≤ k := by omega
  let z : ℕ := (k - 3 * w.length) / 2
  have h3odd : Odd (3 * w.length) :=
    (show Odd (3 : ℕ) by norm_num).mul hwOdd
  have hdiffEven : Even (k - 3 * w.length) :=
    Nat.Odd.sub_odd hkOdd h3odd
  have hdouble : 2 * z = k - 3 * w.length := by
    dsimp [z]
    exact Nat.two_mul_div_two_of_even hdiffEven
  obtain ⟨r, hrsum, hrle, hrfiber⟩ :=
    exists_exact_balanced_visit_weights_of_spanning_closed_walk
      H w hwpos hspan (z := z)
  have hzle : z ≤ k := by
    dsimp [z]
    omega
  have hzquot : z / Fintype.card ι ≤ k / Fintype.card ι :=
    Nat.div_le_div_right hzle
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_all_even_lengths
    G H U T w r hwlen
  · exact (by omega : 2 * w.length < R)
  · exact hlarge
  · exact hrob
  · exact hregions
  · intro i x
    have hcost := sum_three_plus_twice_visit_weight_le
      (fun y : {j : Fin w.length // w.getVert j.val = i} => r y.1)
      (hrfiber i)
    have hfiber : Fintype.card {j : Fin w.length //
        w.getVert j.val = i} ≤ w.length := by
      calc
        _ ≤ Fintype.card (Fin w.length) := Fintype.card_subtype_le _
        _ = w.length := Fintype.card_fin _
    have hcost' :
        (∑ y : {j : Fin w.length // w.getVert j.val = i},
          (2 * (r y.1 + 1) + 1)) ≤
          3 * w.length + 2 * (k / Fintype.card ι + 1) := by
      calc
        _ ≤ 3 * Fintype.card {j : Fin w.length //
            w.getVert j.val = i} + 2 * (z / Fintype.card ι + 1) := hcost
        _ ≤ 3 * w.length + 2 * (k / Fintype.card ι + 1) := by
          omega
    have hrx := hrle x.1
    have hcap := hU i
    omega
  · intro i
    have hcost := sum_three_plus_twice_visit_weight_le
      (fun y : {j : Fin w.length // w.getVert j.val = i} => r y.1)
      (hrfiber i)
    have hfiber : Fintype.card {j : Fin w.length //
        w.getVert j.val = i} ≤ w.length := by
      calc
        _ ≤ Fintype.card (Fin w.length) := Fintype.card_subtype_le _
        _ = w.length := Fintype.card_fin _
    have hcost' :
        (∑ y : {j : Fin w.length // w.getVert j.val = i},
          (2 * (r y.1 + 1) + 1)) ≤
          3 * w.length + 2 * (k / Fintype.card ι + 1) := by
      calc
        _ ≤ 3 * Fintype.card {j : Fin w.length //
            w.getVert j.val = i} + 2 * (z / Fintype.card ι + 1) := hcost
        _ ≤ 3 * w.length + 2 * (k / Fintype.card ι + 1) := by
          omega
    have hcap := hθ
    omega
  · have hsum : (∑ j : Fin w.length, 2 * (r j + 1)) =
        2 * (∑ j : Fin w.length, r j) + 2 * w.length := by
      calc
        _ = ∑ j : Fin w.length, (2 * r j + 2) := by
          apply Finset.sum_congr rfl
          intro j _hj
          omega
        _ = (∑ j : Fin w.length, 2 * r j) +
            ∑ _j : Fin w.length, 2 := Finset.sum_add_distrib
        _ = 2 * (∑ j : Fin w.length, r j) + 2 * w.length := by
          simp [Finset.mul_sum, Nat.mul_comm]
    rw [hsum, hrsum, hdouble]
    omega

/-- Optimized odd interaction lift when the auxiliary obstruction is already
a Hamiltonian odd cycle.  Its spanning loop has length exactly the auxiliary
order, halving the linear routing charge from the general connected
non-bipartite bound. -/
theorem cycleGraph_isContained_of_odd_hamiltonian_largeCrossMatching
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {u : ι} (w : H.Walk u u) { θ R k : ℕ}
    (hwOdd : Odd w.length) (hspan : ∀ v : ι, v ∈ w.support)
    (hwcard : w.length = Fintype.card ι)
    (hkOdd : Odd k) (hfit : 3 * Fintype.card ι ≤ k)
    (hmatchBudget : 2 * Fintype.card ι < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι,
      3 * Fintype.card ι +
        3 * (k / Fintype.card ι + 1) + 2 ≤ (U i).card)
    (hθ : 3 * Fintype.card ι +
      2 * (k / Fintype.card ι + 1) ≤ θ) :
    cycleGraph k ⊑ G := by
  let : Nonempty ι := ⟨u⟩
  have hwpos : 0 < w.length := by
    exact Nat.pos_of_ne_zero fun hwzero => by
      rw [hwzero] at hwOdd
      exact Nat.not_odd_iff_even.mpr Even.zero hwOdd
  have hwlen : 2 ≤ w.length := by
    by_contra hnot
    have hone : w.length = 1 := by omega
    exact H.loopless.irrefl u (w.adj_of_length_eq_one hone)
  have hbase : 3 * w.length ≤ k := by omega
  let z : ℕ := (k - 3 * w.length) / 2
  have h3odd : Odd (3 * w.length) :=
    (show Odd (3 : ℕ) by norm_num).mul hwOdd
  have hdiffEven : Even (k - 3 * w.length) :=
    Nat.Odd.sub_odd hkOdd h3odd
  have hdouble : 2 * z = k - 3 * w.length := by
    dsimp [z]
    exact Nat.two_mul_div_two_of_even hdiffEven
  obtain ⟨r, hrsum, hrle, hrfiber⟩ :=
    exists_exact_balanced_visit_weights_of_spanning_closed_walk
      H w hwpos hspan (z := z)
  have hzle : z ≤ k := by
    dsimp [z]
    omega
  have hzquot : z / Fintype.card ι ≤ k / Fintype.card ι :=
    Nat.div_le_div_right hzle
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_all_even_lengths
    G H U T w r hwlen
  · exact (by omega : 2 * w.length < R)
  · exact hlarge
  · exact hrob
  · exact hregions
  · intro i x
    have hcost := sum_three_plus_twice_visit_weight_le
      (fun y : {j : Fin w.length // w.getVert j.val = i} => r y.1)
      (hrfiber i)
    have hfiber : Fintype.card {j : Fin w.length //
        w.getVert j.val = i} ≤ w.length := by
      calc
        _ ≤ Fintype.card (Fin w.length) := Fintype.card_subtype_le _
        _ = w.length := Fintype.card_fin _
    have hcost' :
        (∑ y : {j : Fin w.length // w.getVert j.val = i},
          (2 * (r y.1 + 1) + 1)) ≤
          3 * w.length + 2 * (k / Fintype.card ι + 1) := by
      calc
        _ ≤ 3 * Fintype.card {j : Fin w.length //
            w.getVert j.val = i} + 2 * (z / Fintype.card ι + 1) := hcost
        _ ≤ 3 * w.length + 2 * (k / Fintype.card ι + 1) := by
          omega
    have hrx := hrle x.1
    have hcap := hU i
    omega
  · intro i
    have hcost := sum_three_plus_twice_visit_weight_le
      (fun y : {j : Fin w.length // w.getVert j.val = i} => r y.1)
      (hrfiber i)
    have hfiber : Fintype.card {j : Fin w.length //
        w.getVert j.val = i} ≤ w.length := by
      calc
        _ ≤ Fintype.card (Fin w.length) := Fintype.card_subtype_le _
        _ = w.length := Fintype.card_fin _
    have hcost' :
        (∑ y : {j : Fin w.length // w.getVert j.val = i},
          (2 * (r y.1 + 1) + 1)) ≤
          3 * w.length + 2 * (k / Fintype.card ι + 1) := by
      calc
        _ ≤ 3 * Fintype.card {j : Fin w.length //
            w.getVert j.val = i} + 2 * (z / Fintype.card ι + 1) := hcost
        _ ≤ 3 * w.length + 2 * (k / Fintype.card ι + 1) := by
          omega
    have hcap := hθ
    omega
  · have hsum : (∑ j : Fin w.length, 2 * (r j + 1)) =
        2 * (∑ j : Fin w.length, r j) + 2 * w.length := by
      calc
        _ = ∑ j : Fin w.length, (2 * r j + 2) := by
          apply Finset.sum_congr rfl
          intro j _hj
          omega
        _ = (∑ j : Fin w.length, 2 * r j) +
            ∑ _j : Fin w.length, 2 := Finset.sum_add_distrib
        _ = 2 * (∑ j : Fin w.length, r j) + 2 * w.length := by
          simp [Finset.mul_sum, Nat.mul_comm]
    rw [hsum, hrsum, hdouble]
    omega

/-- Above the local-bipartiteness cutoff, division by an auxiliary order at
most `sqrt k` has the uniform bound needed by the Hamiltonian odd-cycle
router. -/
theorem div_le_two_mul_sqrt_sub_two_of_medium
    {k m : ℕ} (hs : 30 ≤ Nat.sqrt k)
    (hmLow : 2 * (Nat.sqrt k / 3) < m) :
    k / m ≤ 2 * Nat.sqrt k - 2 := by
  let s := Nat.sqrt k
  let d := s / 3
  have hs' : 30 ≤ s := by simpa [s] using hs
  have hd : 10 ≤ d := by dsimp [d]; omega
  have hsLower : 3 * d ≤ s := by
    dsimp [d]
    simpa [Nat.mul_comm] using Nat.div_mul_le_self s 3
  have hsUpper : s < 3 * (d + 1) := by
    dsimp [d]
    omega
  have hm : 2 * d + 1 ≤ m := by simpa [d, s] using hmLow
  have hmpos : 0 < m := by omega
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  let A := 2 * s - 1
  have hAeq : A + 1 = 2 * s := by
    dsimp [A]
    omega
  have hbase : (s + 1) ^ 2 ≤ A * (2 * d + 1) := by
    nlinarith
  have hmul : A * (2 * d + 1) ≤ A * m :=
    Nat.mul_le_mul_left A hm
  have hprod : (s + 1) ^ 2 ≤ (2 * s - 1) * m := by
    exact hbase.trans (by simpa [A] using hmul)
  have hquotlt : k / m < 2 * s - 1 := by
    apply (Nat.div_lt_iff_lt_mul hmpos).2
    exact hklt.trans_le hprod
  dsimp [s] at hquotlt ⊢
  omega

/-- The Hamiltonian odd-cycle costs fit the exact DRC capacities throughout
the medium range between the local-bipartiteness scale and `sqrt k`. -/
theorem medium_hamiltonian_costs
    {k m : ℕ} (hs : 30 ≤ Nat.sqrt k)
    (hmLow : 2 * (Nat.sqrt k / 3) < m) (hmHigh : m ≤ Nat.sqrt k) :
    3 * m + 3 * (k / m + 1) + 2 ≤ 9 * Nat.sqrt k ∧
      3 * m + 2 * (k / m + 1) ≤ 8 * Nat.sqrt k := by
  have hquot := div_le_two_mul_sqrt_sub_two_of_medium hs hmLow
  constructor <;> omega

/-- Square-root specialization of the odd non-bipartite interaction lift.
The rational scale `2 * (sqrt k / 3)` lies close to the minimizer of
`6t + 3k/t`; from `sqrt k ≥ 30` both local costs fit inside the existing
`9 sqrt k` core and `8 sqrt k` routing capacities. -/
theorem cycleGraph_isContained_of_connected_nonbipartite_largeCrossMatching_sqrt_scale
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} (hconn : H.Connected) (hnotbip : ¬ H.IsBipartite)
    (hkOdd : Odd k) (hsqrt : 30 ≤ Nat.sqrt k)
    (hcard : Fintype.card ι = 2 * (Nat.sqrt k / 3))
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ) :
    cycleGraph k ⊑ G := by
  let s : ℕ := Nat.sqrt k
  let d : ℕ := s / 3
  let t : ℕ := 2 * d
  have hs : 30 ≤ s := by simpa [s] using hsqrt
  have hd : 10 ≤ d := by
    dsimp [d]
    omega
  have hsLower : 3 * d ≤ s := by
    dsimp [d]
    simpa [Nat.mul_comm] using Nat.div_mul_le_self s 3
  have hsUpper : s < 3 * (d + 1) := by
    dsimp [d]
    omega
  let r : ℕ := s - 3 * d
  have hsEq : s = 3 * d + r := by
    dsimp [r]
    omega
  have hr : r ≤ 2 := by
    dsimp [r]
    omega
  have htpos : 0 < t := by dsimp [t]; omega
  have htcard : Fintype.card ι = t := by simpa [t, d, s] using hcard
  have hs2 : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hfit : 6 * t ≤ k := by
    have : 6 * t ≤ s ^ 2 := by
      dsimp [t]
      nlinarith
    exact this.trans hs2
  have htLe : t ≤ s := by dsimp [t]; omega
  have hmatch : 4 * t < R := by omega
  let A : ℕ := 3 * s - 2 * t - 1
  have hApos : 0 < A := by
    dsimp [A]
    dsimp [t]
    omega
  have hAeq : A + 2 * t + 1 = 3 * s := by
    dsimp [A, t]
    omega
  have hprodU : (s + 1) ^ 2 < A * t := by
    dsimp [t] at hAeq ⊢
    nlinarith
  have hquotU : k / t ≤ A - 1 := by
    have hlt : k / t < A := by
      apply (Nat.div_lt_iff_lt_mul htpos).2
      exact hklt.trans hprodU
    omega
  let B : ℕ := 4 * s - 3 * t
  have hBeq : B + 3 * t = 4 * s := by
    dsimp [B, t]
    omega
  have hprodθ : (s + 1) ^ 2 < B * t := by
    dsimp [t] at hBeq ⊢
    nlinarith
  have hquotθ : k / t ≤ B - 1 := by
    have hlt : k / t < B := by
      apply (Nat.div_lt_iff_lt_mul htpos).2
      exact hklt.trans hprodθ
    omega
  apply cycleGraph_isContained_of_connected_nonbipartite_largeCrossMatching
    G H U T hconn hnotbip hkOdd
  · simpa [htcard] using hfit
  · simpa [htcard] using hmatch
  · exact hlarge
  · exact hrob
  · exact hregions
  · intro i
    have hi := hU i
    rw [htcard]
    omega
  · rw [htcard]
    omega

/-- Short-odd-witness form of the square-root lift.  If a connected
interaction graph is large enough and already contains an odd closed walk
on at most `2 * (sqrt k / 3)` vertices, the exact-size normalization enlarges
that witness to the optimal rational scale and the preceding theorem applies
to the induced interaction core. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_short_odd_walk_sqrt_scale
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} (hconn : H.Connected) (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k)
    (hcard : 2 * (Nat.sqrt k / 3) ≤ Fintype.card ι)
    {u : ι} (p : H.Walk u u) (hpOdd : Odd p.length)
    (hpCard : p.support.toFinset.card ≤ 2 * (Nat.sqrt k / 3))
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ) :
    cycleGraph k ⊑ G := by
  obtain ⟨S, hScard, hSconn, hSnotbip⟩ :=
    exists_induced_connected_nonbipartite_exact_card_of_odd_walk
      H hconn p hpOdd hpCard hcard
  let J : SimpleGraph S := H.induce (S : Set ι)
  let US : S → Finset V := fun i => U i.1
  let TS : S → Finset V := fun i => T i.1
  have hJlarge : ∀ i j : S, J.Adj i j →
      HasCrossMatchingAtLeast G (US i) (US j) R := by
    intro i j hij
    apply hlarge i.1 j.1
    simpa [J] using hij
  have hJregions : ∀ i j : S, i ≠ j →
      Disjoint (US i ∪ TS i) (US j ∪ TS j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  apply cycleGraph_isContained_of_connected_nonbipartite_largeCrossMatching_sqrt_scale
    G J US TS
  · simpa [J] using hSconn
  · simpa [J] using hSnotbip
  · exact hkOdd
  · exact hsqrt
  · simpa [hScard]
  · exact hmatchBudget
  · exact hJlarge
  · intro i
    exact hrob i.1
  · exact hJregions
  · intro i
    exact hU i.1
  · exact hθ

/-- Local bipartiteness forced by `C_k`-freeness in an odd target.  In a
large interaction component, every closed walk supported on at most
`2 * (sqrt k / 3)` labels has even length; an odd one would normalize to the
exact square-root core and lift to `C_k`. -/
theorem even_length_of_small_support_closed_walk_of_cycleFree_largeCrossMatching_sqrt_scale
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} (hconn : H.Connected) (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k)
    (hcard : 2 * (Nat.sqrt k / 3) ≤ Fintype.card ι)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    {u : ι} (p : H.Walk u u)
    (hpCard : p.support.toFinset.card ≤ 2 * (Nat.sqrt k / 3)) :
    Even p.length := by
  by_contra hpNotEven
  apply hcycle
  apply cycleGraph_isContained_of_connected_largeCrossMatching_short_odd_walk_sqrt_scale
    G H U T hconn hkOdd hsqrt hcard p
      (Nat.not_even_iff_odd.mp hpNotEven) hpCard hmatchBudget hlarge hrob
      hregions hU hθ

/-- Induced-subgraph form of local bipartiteness.  Every interaction vertex
set of cardinality at most `2 * (sqrt k / 3)` induces a bipartite graph in
the odd `C_k`-free branch.  Any odd induced loop would map back to a small
odd-support loop in the whole component. -/
theorem induce_isBipartite_of_small_card_of_cycleFree_largeCrossMatching_sqrt_scale
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {θ R k : ℕ} (hconn : H.Connected) (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k)
    (hcard : 2 * (Nat.sqrt k / 3) ≤ Fintype.card ι)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (S : Finset ι) (hS : S.card ≤ 2 * (Nat.sqrt k / 3)) :
    (H.induce (S : Set ι)).IsBipartite := by
  change (H.induce (S : Set ι)).Colorable 2
  rw [SimpleGraph.two_colorable_iff_forall_loop_even]
  intro u w
  let wm := w.map (SimpleGraph.Embedding.induce (S : Set ι)).toHom
  have hsub : wm.support.toFinset ⊆ S := by
    intro x hx
    simp only [List.mem_toFinset] at hx
    rw [Walk.support_map] at hx
    obtain ⟨y, _hy, rfl⟩ := List.mem_map.mp hx
    exact y.property
  have hwCard : wm.support.toFinset.card ≤ 2 * (Nat.sqrt k / 3) :=
    (Finset.card_le_card hsub).trans hS
  have heven :=
    even_length_of_small_support_closed_walk_of_cycleFree_largeCrossMatching_sqrt_scale
      G H U T hconn hkOdd hsqrt hcard hmatchBudget hlarge hrob hregions
        hU hθ hcycle wm hwCard
  simpa only [wm, Walk.length_map] using heven

/-- Connected-component form of the odd-target local-bipartiteness
alternative.  A large component of the auxiliary large-cross-matching graph
has no non-bipartite induced subgraph on at most the optimal square-root
scale. -/
theorem induce_isBipartite_of_small_card_of_cycleFree_largeCrossMatching_component
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) {θ R k : ℕ} (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G U R).ConnectedComponent)
    (hcard : 2 * (Nat.sqrt k / 3) ≤ c.supp.ncard)
    (S : Finset c) (hS : S.card ≤ 2 * (Nat.sqrt k / 3)) :
    (c.toSimpleGraph.induce (S : Set c)).IsBipartite := by
  let K : SimpleGraph c := c.toSimpleGraph
  let Uc : c → Finset V := fun i => U i.1
  let Tc : c → Finset V := fun i => T i.1
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Uc i) (Uc j) R := by
    intro i j hij
    apply hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
      (G := G) (U := U) (m := R)
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint (Uc i ∪ Tc i) (Uc j ∪ Tc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  apply induce_isBipartite_of_small_card_of_cycleFree_largeCrossMatching_sqrt_scale
    G K Uc Tc c.connected_toSimpleGraph hkOdd hsqrt
  · simpa [hcCard] using hcard
  · exact hmatchBudget
  · exact hKlarge
  · intro i
    exact hrob i.1
  · exact hKregions
  · intro i
    exact hU i.1
  · exact hθ
  · exact hcycle
  · exact hS

/-- Component-local bipartiteness when the auxiliary large-matching graph is
built from pruned subsets `W i ⊆ U i`, while robust routing remains available
in the original cores `U i`.  Cross-matching certificates enlarge from `W`
to `U`. -/
theorem induce_isBipartite_of_small_card_of_cycleFree_largeCrossMatching_component_mono
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U W T : ι → Finset V) { θ R k : ℕ} (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k) (hWU : ∀ i, W i ⊆ U i)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G W R).ConnectedComponent)
    (hcard : 2 * (Nat.sqrt k / 3) ≤ c.supp.ncard)
    (S : Finset c) (hS : S.card ≤ 2 * (Nat.sqrt k / 3)) :
    (c.toSimpleGraph.induce (S : Set c)).IsBipartite := by
  let K : SimpleGraph c := c.toSimpleGraph
  let Uc : c → Finset V := fun i => U i.1
  let Tc : c → Finset V := fun i => T i.1
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Uc i) (Uc j) R := by
    intro i j hij
    apply HasCrossMatchingAtLeast.mono_sets
      (hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
        (G := G) (U := W) (m := R) ?_)
      (hWU i.1) (hWU j.1)
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint (Uc i ∪ Tc i) (Uc j ∪ Tc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  apply induce_isBipartite_of_small_card_of_cycleFree_largeCrossMatching_sqrt_scale
    G K Uc Tc c.connected_toSimpleGraph hkOdd hsqrt
  · simpa [hcCard] using hcard
  · exact hmatchBudget
  · exact hKlarge
  · intro i
    exact hrob i.1
  · exact hKregions
  · intro i
    exact hU i.1
  · exact hθ
  · exact hcycle
  · exact hS

/-- A medium-sized connected component of a pruned large-cross-matching graph
is bipartite once the pruning has forced maximum degree two.  Indeed, a
connected non-bipartite graph of maximum degree two is an odd Hamiltonian
cycle, and the optimized Hamiltonian router lifts that cycle into the
forbidden ambient `C_k`. -/
theorem isBipartite_of_medium_largeCrossMatching_component_degree_le_two
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U W T : ι → Finset V) {θ R k : ℕ} (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k) (hWU : ∀ i, W i ⊆ U i)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hdeg : ∀ i : ι, (LargeCrossMatchingGraph G W R).degree i ≤ 2)
    (c : (LargeCrossMatchingGraph G W R).ConnectedComponent)
    (hcardLow : 2 * (Nat.sqrt k / 3) < c.supp.ncard)
    (hcardHigh : c.supp.ncard ≤ Nat.sqrt k) :
    c.toSimpleGraph.IsBipartite := by
  let H : SimpleGraph ι := LargeCrossMatchingGraph G W R
  let K : SimpleGraph c := c.toSimpleGraph
  let Uc : c → Finset V := fun i => U i.1
  let Tc : c → Finset V := fun i => T i.1
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  have hKdeg : ∀ i : c, K.degree i ≤ 2 := by
    intro i
    let f : SimpleGraph.Copy K H :=
      ⟨c.toSimpleGraph_hom, fun _ _ h => Subtype.ext h⟩
    exact (f.degree_le i).trans (hdeg i.1)
  by_contra hnotbip
  obtain ⟨u, w, hwCycle, hwOdd, hwcard⟩ :=
    exists_odd_hamiltonian_cycle_of_connected_degree_le_two_not_bipartite
      K c.connected_toSimpleGraph hKdeg hnotbip
  have hwHam : w.IsHamiltonianCycle :=
    Walk.isHamiltonianCycle_iff_isCycle_and_length_eq.mpr ⟨hwCycle, hwcard⟩
  have hspan : ∀ v : c, v ∈ w.support := fun v => hwHam.mem_support v
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Uc i) (Uc j) R := by
    intro i j hij
    apply HasCrossMatchingAtLeast.mono_sets
      (hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
        (G := G) (U := W) (m := R) ?_)
      (hWU i.1) (hWU j.1)
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K, H] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint (Uc i ∪ Tc i) (Uc j ∪ Tc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hcost := medium_hamiltonian_costs hsqrt
    (by simpa [← hcCard] using hcardLow)
    (by simpa [← hcCard] using hcardHigh)
  apply hcycle
  apply cycleGraph_isContained_of_odd_hamiltonian_largeCrossMatching
    G K Uc Tc w (θ := θ) (R := R) (k := k) hwOdd hspan hwcard hkOdd
  · have hsquare : (Nat.sqrt k) ^ 2 ≤ k := Nat.sqrt_le' k
    have hm : Fintype.card c ≤ Nat.sqrt k := by simpa [hcCard] using hcardHigh
    have hs := hsqrt
    nlinarith
  · have hm : Fintype.card c ≤ Nat.sqrt k := by simpa [hcCard] using hcardHigh
    omega
  · exact hKlarge
  · intro i
    exact hrob i.1
  · exact hKregions
  · intro i
    exact hcost.1.trans (hU i.1)
  · exact hcost.2.trans hθ

/-- Every connected component of the auxiliary graph whose edges represent
`R` disjoint cross handles has fewer than `sqrt k + 1` hub labels in a
`C_k`-free ambient graph. -/
theorem ncard_connectedComponent_lt_succ_sqrt_of_cycleFree_largeCrossMatchingGraph
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) {θ R k : ℕ}
    (hsqrt : 7 ≤ Nat.sqrt k)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i) 3)
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G U R).ConnectedComponent) :
    c.supp.ncard < Nat.sqrt k + 1 := by
  let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
  let K : SimpleGraph c := c.toSimpleGraph
  let Uc : c → Finset V := fun i => U i.1
  let Tc : c → Finset V := fun i => T i.1
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Uc i) (Uc j) R := by
    intro i j hij
    apply hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
      (G := G) (U := U) (m := R)
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint (Uc i ∪ Tc i) (Uc j ∪ Tc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hKcard : Fintype.card c < Nat.sqrt k + 1 := by
    apply card_lt_succ_sqrt_of_cycleFree_connected_largeCrossMatching
      G K Uc Tc c.connected_toSimpleGraph hsqrt hmatchBudget hKlarge
        (fun i => hrob i.1) hKregions (fun i => hparity i.1)
        (fun i => hU i.1) hθ hcycle
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  simpa [hcCard] using hKcard

/-- The square-root component bound persists after pruning the interaction
reservoirs from `U i` to arbitrary subsets `W i`.  Internal three-edge
matchings in the original robust cores supply the sole parity correction. -/
theorem ncard_component_lt_succ_sqrt_pruned_of_hasThree
    {V ι : Type*} [Fintype V] [Fintype ι]
