/-- Exact-order form used for the KLS small-component contradiction.  A
connected auxiliary graph with at least `t` vertices contains a pruned
spanning-tree tour of length `2(t-1)`; the route and matching budgets depend
only on this requested order, not on the possibly much larger component. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_of_card_ge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {t ℓ s θ R k : ℕ} (hconn : H.Connected)
    (ht : 2 ≤ t) (htcard : t ≤ Fintype.card ι)
    (hmatchBudget : 2 * (2 * (t - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hℓ : 5 ≤ ℓ)
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i)
      (2 * (2 * (t - 1) - 1) + 3))
    (hFirstU : ∀ i : ι,
      2 * (2 * (t - 1) - 1) + ℓ ≤ (U i).card)
    (hFirstθ : 2 * (2 * (t - 1) - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      ℓ + 1 + (2 * (t - 1) - 1) * (2 * (s + 1) + 1) + (s + 2) ≤
        (U i).card)
    (hRestθ : ℓ + 1 + (2 * (t - 1) - 1) * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (2 * (t - 1) - 1) * (2 * (s + 1)) +
      2 * (t - 1) = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨r, w, hwlen⟩ :=
    Erdos551.SimpleGraph.Connected.exists_closed_walk_length_twice_sub_one_of_le_card
      H hconn (by omega) htcard
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_residual
    G H U T w
  · rw [hwlen]
    omega
  · rw [hwlen]
    exact hmatchBudget
  · exact hlarge
  · exact hrob
  · exact hℓ
  · simpa [hwlen] using hparity r
  · simpa [hwlen] using hFirstU r
  · simpa [hwlen] using hFirstθ
  · intro i hi
    simpa [hwlen] using hRestU (w.getVert i.val)
  · simpa [hwlen] using hRestθ
  · simpa [hwlen] using hlen

/-- Contrapositive small-component theorem: under the displayed KLS handle
and routing budgets, every connected large-cross-matching component in a
`Cₖ`-free graph has fewer than `t` vertices. -/
theorem card_lt_of_cycleFree_connected_largeCrossMatching
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {t ℓ s θ R k : ℕ} (hconn : H.Connected)
    (ht : 2 ≤ t)
    (hmatchBudget : 2 * (2 * (t - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hℓ : 5 ≤ ℓ)
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i)
      (2 * (2 * (t - 1) - 1) + 3))
    (hFirstU : ∀ i : ι,
      2 * (2 * (t - 1) - 1) + ℓ ≤ (U i).card)
    (hFirstθ : 2 * (2 * (t - 1) - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      ℓ + 1 + (2 * (t - 1) - 1) * (2 * (s + 1) + 1) + (s + 2) ≤
        (U i).card)
    (hRestθ : ℓ + 1 + (2 * (t - 1) - 1) * (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (2 * (t - 1) - 1) * (2 * (s + 1)) +
      2 * (t - 1) = k)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card ι < t := by
  by_contra hnot
  apply hcycle
  exact cycleGraph_isContained_of_connected_largeCrossMatching_of_card_ge
    G H U T hconn ht (by omega) hmatchBudget hlarge hrob hℓ hparity
      hFirstU hFirstθ hRestU hRestθ hlen

/-- Two external path handles and two internal paths form a cycle.  The four
paths are pairwise vertex-disjoint and the four displayed edges join them in
cyclic order, so the finite cyclic-path assembler gives the prescribed total
length.  This is the exact abstraction needed when a diameter-two remainder
piece supplies a short path between two stable seeds. -/
theorem cycleGraph_isContained_of_two_path_handles_and_disjoint_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k)
    {a b u v c d y z : V}
    {p : G.Walk a b} {h : G.Walk u v} {q : G.Walk c d} {s : G.Walk y z}
    (hp : p.IsPath) (hh : h.IsPath) (hq : q.IsPath) (hs : s.IsPath)
    (hph : p.support.Disjoint h.support)
    (hpq : p.support.Disjoint q.support)
    (hps : p.support.Disjoint s.support)
    (hhq : h.support.Disjoint q.support)
    (hhs : h.support.Disjoint s.support)
    (hqs : q.support.Disjoint s.support)
    (hbu : G.Adj b u) (hvc : G.Adj v c)
    (hdy : G.Adj d y) (hza : G.Adj z a)
    (hlen : p.length + h.length + q.length + s.length + 4 = k) :
    cycleGraph k ⊑ G := by
  let W : Fin 4 → (Σ x y : V, G.Walk x y) :=
    ![⟨a, b, p⟩, ⟨u, v, h⟩, ⟨c, d, q⟩, ⟨y, z, s⟩]
  let A : Fin 4 → V := fun i => (W i).1
  let B : Fin 4 → V := fun i => (W i).2.1
  let r : ∀ i : Fin 4, G.Walk (A i) (B i) := fun i => (W i).2.2
  have hr : ∀ i : Fin 4, (r i).IsPath := by
    intro i
    fin_cases i <;> simp [r, A, B, W, hp, hh, hq, hs]
  have hrdisj : ∀ i j : Fin 4, i ≠ j →
      (r i).support.Disjoint (r j).support := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all only [Fin.mk_one, Fin.isValue, Fin.zero_eta, Fin.reduceFinMk]
    all_goals first
      | exact hph.symm
      | exact hpq.symm
      | exact hps.symm
      | exact hhq.symm
      | exact hhs.symm
      | exact hqs.symm
  have hcross : ∀ i : Fin 3, G.Adj (B i.castSucc) (A i.succ) := by
    intro i
    fin_cases i
    · simpa [A, B, W] using hbu
    · simpa [A, B, W] using hvc
    · simpa [A, B, W] using hdy
  have hclose : G.Adj (B (Fin.last 3)) (A 0) := by
    simpa [A, B, W] using hza
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk A B r hr hrdisj hcross hclose
  · simp [r, A, B, W]
  · simpa [Fin.sum_univ_succ, r, A, B, W, Nat.add_assoc] using hlen

/-- Two internally disjoint length-two external handles and two disjoint
internal paths form a cycle.  The two middle handle vertices are represented
as singleton paths in the generic finite cyclic-path assembler; this keeps
the four-edge contribution explicit for the later absorption/separation
argument. -/
theorem cycleGraph_isContained_of_two_twoEdge_handles_and_disjoint_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k)
    {a b c d x y : V} {p : G.Walk a b} {q : G.Walk c d}
    (hp : p.IsPath) (hq : q.IsPath)
    (hpq : p.support.Disjoint q.support)
    (hxp : x ∉ p.support) (hxq : x ∉ q.support)
    (hyp : y ∉ p.support) (hyq : y ∉ q.support) (hxy : x ≠ y)
    (hbx : G.Adj b x) (hxc : G.Adj x c)
    (hdy : G.Adj d y) (hya : G.Adj y a)
    (hlen : p.length + q.length + 4 = k) :
    cycleGraph k ⊑ G := by
  let W : Fin 4 → (Σ u v : V, G.Walk u v) :=
    ![⟨a, b, p⟩, ⟨x, x, Walk.nil⟩, ⟨c, d, q⟩, ⟨y, y, Walk.nil⟩]
  let A : Fin 4 → V := fun i => (W i).1
  let B : Fin 4 → V := fun i => (W i).2.1
  let r : ∀ i : Fin 4, G.Walk (A i) (B i) := fun i => (W i).2.2
  have hr : ∀ i : Fin 4, (r i).IsPath := by
    intro i
    fin_cases i <;> simp [r, A, B, W, hp, hq]
  have hrdisj : ∀ i j : Fin 4, i ≠ j →
      (r i).support.Disjoint (r j).support := by
    intro i j hij
    fin_cases i <;> fin_cases j <;>
      simp_all only [Fin.mk_one, Fin.isValue, Fin.reduceFinMk, Fin.zero_eta]
    all_goals first | exact hpq.symm | exact Ne.symm hxy
  have hcross : ∀ i : Fin 3, G.Adj (B i.castSucc) (A i.succ) := by
    intro i
    fin_cases i
    · simpa [A, B, W] using hbx
    · simpa [A, B, W] using hxc
    · simpa [A, B, W] using hdy
  have hclose : G.Adj (B (Fin.last 3)) (A 0) := by
    simpa [A, B, W] using hya
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk A B r hr hrdisj hcross hclose
  · simp [r, A, B, W]
  · simpa [Fin.sum_univ_succ, r, A, B, W] using hlen

/-- Cyclic even-route system for finitely many disjoint robust hubs.  Each
hub supplies one prescribed even internal path, disjoint routing regions make
all supports disjoint, and the generic cyclic-handle assembler closes the
ambient cycle. -/
theorem cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_even_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m k : ℕ} (hk : 3 ≤ k)
    (U T : Fin (m + 1) → Finset V)
    (θ r : Fin (m + 1) → ℕ)
    (hrob : ∀ i : Fin (m + 1), RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j : Fin (m + 1), i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i : Fin (m + 1), a i ∈ U i)
    (hb : ∀ i : Fin (m + 1), b i ∈ U i)
    (hab : ∀ i : Fin (m + 1), a i ≠ b i)
    (hcross : ∀ i : Fin m,
      G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hU : ∀ i : Fin (m + 1), r i + 2 ≤ (U i).card)
    (hθ : ∀ i : Fin (m + 1), 2 * (r i + 1) + 1 ≤ θ i)
    (hlen : (∑ i : Fin (m + 1), 2 * (r i + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  choose p hp hplen _havoid hploc using fun i : Fin (m + 1) =>
    exists_even_path_between_of_robustPairSet_avoiding
      G (F := ∅) (r := r i) (hrob i) (ha i) (hb i)
        (by simp) (by simp) (hab i) (by simpa using hU i) (by simpa using hθ i)
  have hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    intro v hvi hvj
    have hvi' : v ∈ U i ∪ T i := by
      rcases hploc i v hvi with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    have hvj' : v ∈ U j ∪ T j := by
      rcases hploc j v hvj with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    exact Finset.disjoint_left.mp (hregions i j hij) hvi' hvj'
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hdisj hcross hclose
  · have hsumpos :
        1 < (∑ i : Fin (m + 1), 2 * (r i + 1)) + m := by
      have hfirst :
          2 * (r 0 + 1) ≤ ∑ i : Fin (m + 1), 2 * (r i + 1) := by
        exact Finset.single_le_sum
          (s := (Finset.univ : Finset (Fin (m + 1))))
          (f := fun i : Fin (m + 1) => 2 * (r i + 1))
          (fun _ _ => Nat.zero_le _) (Finset.mem_univ 0)
      omega
    rw [show (∑ i : Fin (m + 1), (p i).length) =
        ∑ i : Fin (m + 1), 2 * (r i + 1) by
      apply Finset.sum_congr rfl
      intro i _
      exact hplen i]
    exact hsumpos
  · rw [show (∑ i : Fin (m + 1), (p i).length) =
        ∑ i : Fin (m + 1), 2 * (r i + 1) by
      apply Finset.sum_congr rfl
      intro i _
      exact hplen i]
    exact hlen

/-- Cyclic assembly from disjoint alternating scaffolds.  One routed pair is
used in each hub.  The three-interval lemma makes every route avoid its two
fixed cross-edge endpoints, and disjoint displayed hub regions make the
resulting path supports globally disjoint. -/
theorem cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_even_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m k q theta : ℕ} (hk : 3 ≤ k)
    (A B D : Fin (m + 1) → Finset V)
    (r : Fin (m + 1) → ℕ)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (htheta : 2 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ A i) (hb : ∀ i, b i ∈ A i)
    (hab : ∀ i, a i ≠ b i)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hfit : ∀ i, 3 * (r i + 1) ≤ q)
    (hlen : (∑ i : Fin (m + 1), (2 * r i + 4)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  choose p hp hplen hploc using fun i : Fin (m + 1) =>
    exists_short_route_via_cyclicAlternatingScaffold
      G (hscaffold i) (hrob i) (hmajorD i) htheta (hfit i)
        (ha i) (hb i) (hab i)
  have hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij v hvi hvj
    have hvi' : v ∈ (A i ∪ B i) ∪ D i := by
      rcases hploc i v hvi with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    have hvj' : v ∈ (A j ∪ B j) ∪ D j := by
      rcases hploc j v hvj with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    exact Finset.disjoint_left.mp (hregions i j hij) hvi' hvj'
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hdisj hcross hclose
  · have hsum : (∑ i : Fin (m + 1), (p i).length) =
        ∑ i : Fin (m + 1), (2 * r i + 4) := by
      apply Finset.sum_congr rfl
      intro i _hi
      exact hplen i
    rw [hsum]
    omega
  · rw [show (∑ i : Fin (m + 1), (p i).length) =
        ∑ i : Fin (m + 1), (2 * r i + 4) by
      apply Finset.sum_congr rfl
      intro i _hi
      exact hplen i]
    exact hlen

/-- Full-capacity cyclic assembly from disjoint alternating scaffolds.  The
cut-and-rejoin route uses any prescribed `r i ≤ q - 4`, so the internal
route in hub `i` has length `2 * r i + 6`. -/
theorem cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_long_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m k q theta : ℕ} (hk : 3 ≤ k)
    (A B D : Fin (m + 1) → Finset V)
    (r : Fin (m + 1) → ℕ)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 4 ≤ q) (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ A i) (hb : ∀ i, b i ∈ A i)
    (hab : ∀ i, a i ≠ b i)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hfit : ∀ i, r i ≤ q - 4)
    (hlen : (∑ i : Fin (m + 1), (2 * r i + 6)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  choose p hp hplen hploc _havoid using fun i : Fin (m + 1) =>
    exists_long_route_via_cyclicAlternatingScaffold
      G (hscaffold i) (hrob i) (hmajorD i) hq htheta (hfit i)
        (ha i) (hb i) (hab i)
  have hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij v hvi hvj
    have hvi' : v ∈ (A i ∪ B i) ∪ D i := by
      rcases hploc i v hvi with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    have hvj' : v ∈ (A j ∪ B j) ∪ D j := by
      rcases hploc j v hvj with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    exact Finset.disjoint_left.mp (hregions i j hij) hvi' hvj'
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hdisj hcross hclose
  · have hsum : (∑ i : Fin (m + 1), (p i).length) =
        ∑ i : Fin (m + 1), (2 * r i + 6) := by
      apply Finset.sum_congr rfl
      intro i _hi
      exact hplen i
    rw [hsum]
    omega
  · rw [show (∑ i : Fin (m + 1), (p i).length) =
        ∑ i : Fin (m + 1), (2 * r i + 6) by
      apply Finset.sum_congr rfl
      intro i _hi
      exact hplen i]
    exact hlen

/-- A matching-backed first alternating scaffold changes the parity of the
usual full-capacity cyclic assembly at the cost of one scaffold slot.  The
first hub uses the five-edge parity-breaking route, while every successor
hub keeps the `2 * r + 6` long scaffold route.  Thus the total internal
length is one less than the ordinary seven-edges-per-hub baseline, without
requiring the robust parameter to grow with the target cycle length. -/
theorem cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_matched_odd_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m k q theta : ℕ} (hk : 3 ≤ k)
    (A B D : Fin (m + 1) → Finset V)
    (r : Fin m → ℕ)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 5 ≤ q) (htheta : 6 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hmatch : HasThreeDisjointAdjPairFamily G (A 0))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ A i) (hb : ∀ i, b i ∈ A i)
    (hab : ∀ i, a i ≠ b i)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hfit : ∀ i, r i ≤ q - 4)
    (hlen : 5 + (∑ i : Fin m, (2 * r i + 6)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨M, hM, hMcard, hMA⟩ := hmatch
  let F : Finset V := {a 0, b 0}
  have hFcard : F.card < M.card := by
    have htwo : F.card ≤ 2 := Finset.card_le_two
    omega
  obtain ⟨e, heM, he₁F, he₂F, heAdj⟩ :=
    exists_adjPair_avoiding_of_disjointAdjPairFamily G M F hM hFcard
  have heA := hMA e heM
  have he₁F' : e.1 ≠ a 0 ∧ e.1 ≠ b 0 := by
    simpa [F] using he₁F
  have he₂F' : e.2 ≠ a 0 ∧ e.2 ≠ b 0 := by
    simpa [F] using he₂F
  obtain ⟨_hqpos, aa, _bb, hA, _hB, haa, _hbb, _hAB, _hab,
      _hba⟩ := hscaffold 0
  have hAcard : (A 0).card = q := by
    rw [hA, Finset.card_image_of_injective _ haa]
    simp
  obtain ⟨p₀, hp₀, hp₀len, hp₀loc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge G (ℓ := 5)
      (hrob 0) (ha 0) heA.1 heA.2 (hb 0) heAdj
      he₁F'.1.symm he₂F'.1.symm (hab 0) he₁F'.2 he₂F'.2
      (by omega) (by rw [hAcard]; omega) (by omega)
  choose p hp hplen hploc _havoid using fun i : Fin m =>
    exists_long_route_via_cyclicAlternatingScaffold
      G (hscaffold i.succ) (hrob i.succ) (hmajorD i.succ)
        (by omega) (by omega) (hfit i)
        (ha i.succ) (hb i.succ) (hab i.succ)
  let route : ∀ i : Fin (m + 1), G.Walk (a i) (b i) :=
    Fin.cases p₀ p
  have hroute : ∀ i : Fin (m + 1), (route i).IsPath := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [route] using hp₀
    · simpa [route] using hp j
  have hrouteloc : ∀ i : Fin (m + 1), ∀ v ∈ (route i).support,
      v ∈ A i ∪ B i ∨ v ∈ D i := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · intro v hv
      rcases hp₀loc v (by simpa [route] using hv) with hvA | hvD
      · exact Or.inl (Finset.mem_union_left _ hvA)
      · exact Or.inr hvD
    · simpa [route] using hploc j
  have hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (route i).support.Disjoint (route j).support := by
    intro i j hij v hvi hvj
    have hvi' : v ∈ (A i ∪ B i) ∪ D i := by
      rcases hrouteloc i v hvi with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    have hvj' : v ∈ (A j ∪ B j) ∪ D j := by
      rcases hrouteloc j v hvj with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ h
    exact Finset.disjoint_left.mp (hregions i j hij) hvi' hvj'
  have hsum :
      (∑ i : Fin (m + 1), (route i).length) =
        5 + ∑ i : Fin m, (2 * r i + 6) := by
    rw [Fin.sum_univ_succ]
    simp [route, hp₀len, hplen]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b route hroute hdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- Support-location certificates from two routed hub paths turn disjoint
regions into disjoint path supports.  Naming this tiny bridge keeps the
three-hub and later cyclic-handle arguments focused on their combinatorial
shape rather than repeating union membership bookkeeping. -/
theorem walk_support_disjoint_of_location_of_disjoint_regions
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {U₁ T₁ U₂ T₂ : Finset V} {a b c d : V}
    {p : G.Walk a b} {q : G.Walk c d}
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hploc : ∀ v ∈ p.support, v ∈ U₁ ∨ v ∈ T₁)
    (hqloc : ∀ v ∈ q.support, v ∈ U₂ ∨ v ∈ T₂) :
    p.support.Disjoint q.support := by
  intro v hvp hvq
  have hv₁ : v ∈ U₁ ∪ T₁ := by
    rcases hploc v hvp with hv | hv
    · exact Finset.mem_union_left _ hv
    · exact Finset.mem_union_right _ hv
  have hv₂ : v ∈ U₂ ∪ T₂ := by
    rcases hqloc v hvq with hv | hv
    · exact Finset.mem_union_left _ hv
    · exact Finset.mem_union_right _ hv
  exact Finset.disjoint_left.mp hregions hv₁ hv₂

/-- One parity-broken hub followed by any finite cyclic list of even robust
routes realizes every admissible total length.  This is the finite-hub
version of the three-hub all-length splice: the distinguished first hub
absorbs the parity of the target while the remaining hubs only need the
uniform even routing interface. -/
theorem cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_all_lengths_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m n ℓ k : ℕ} (hk : 3 ≤ k)
    (U T : Fin (m + 1) → Finset V)
    (θ : Fin (m + 1) → ℕ)
    (hrob : ∀ i : Fin (m + 1), RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j : Fin (m + 1), i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hfree : G.IndepSetFree n) (hU₀n : n + 2 ≤ (U 0).card)
    (a b : Fin (m + 1) → V)
    (ha : ∀ i : Fin (m + 1), a i ∈ U i)
    (hb : ∀ i : Fin (m + 1), b i ∈ U i)
    (hab : ∀ i : Fin (m + 1), a i ≠ b i)
    (hcross : ∀ i : Fin m,
      G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ (U 0).card) (hℓθ : ℓ + 1 ≤ θ 0)
    (r : Fin m → ℕ)
    (hU : ∀ i : Fin m, r i + 2 ≤ (U i.succ).card)
    (hθ : ∀ i : Fin m, 2 * (r i + 1) + 1 ≤ θ i.succ)
    (hlen : ℓ + (∑ i : Fin m, 2 * (r i + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨p₀, hp₀, hp₀len, hp₀loc⟩ :=
    exists_path_between_of_large_robustPairSet G (hrob 0) hfree hU₀n
      (ha 0) (hb 0) (hab 0) hℓ hℓU hℓθ
  choose q hq hqlen _hqavoid hqloc using fun i : Fin m =>
    exists_even_path_between_of_robustPairSet_avoiding
      G (F := ∅) (r := r i) (hrob i.succ) (ha i.succ) (hb i.succ)
        (by simp) (by simp) (hab i.succ) (by simpa using hU i)
          (by simpa using hθ i)
  let p : ∀ i : Fin (m + 1), G.Walk (a i) (b i) :=
    Fin.cases p₀ q
  have hp : ∀ i : Fin (m + 1), (p i).IsPath := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [p] using hp₀
    · simpa [p] using hq j
  have hploc : ∀ i : Fin (m + 1), ∀ v ∈ (p i).support,
      v ∈ U i ∨ v ∈ T i := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [p] using hp₀loc
    · simpa [p] using hqloc j
  have hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    exact walk_support_disjoint_of_location_of_disjoint_regions G
      (hregions i j hij) (hploc i) (hploc j)
  have hsum :
      (∑ i : Fin (m + 1), (p i).length) =
        ℓ + ∑ i : Fin m, 2 * (r i + 1) := by
    rw [Fin.sum_univ_succ]
    simp [p, hp₀len, hqlen]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- A matching-backed robust hub supplies the parity-breaking edge needed
by the preceding cyclic splice without any Ramsey-sized lower bound on its
core.  Three vertex-disjoint internal edges guarantee that one avoids the
two prescribed cross-edge endpoints; the explicit-parity routing lemma then
absorbs the parity of the requested first route while all later hubs use
even routes.  This is the finite form actually used by the KLS stability
argument, where the dense cores are only of square-root size. -/
theorem cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_matched_fin
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {m ℓ k : ℕ} (hk : 3 ≤ k)
    (U T : Fin (m + 1) → Finset V)
    (θ : Fin (m + 1) → ℕ)
    (hrob : ∀ i : Fin (m + 1), RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j : Fin (m + 1), i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hmatch : HasThreeDisjointAdjPairFamily G (U 0))
    (a b : Fin (m + 1) → V)
    (ha : ∀ i : Fin (m + 1), a i ∈ U i)
    (hb : ∀ i : Fin (m + 1), b i ∈ U i)
    (hab : ∀ i : Fin (m + 1), a i ≠ b i)
    (hcross : ∀ i : Fin m,
      G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ (U 0).card) (hℓθ : ℓ + 1 ≤ θ 0)
    (r : Fin m → ℕ)
    (hU : ∀ i : Fin m, r i + 2 ≤ (U i.succ).card)
    (hθ : ∀ i : Fin m, 2 * (r i + 1) + 1 ≤ θ i.succ)
    (hlen : ℓ + (∑ i : Fin m, 2 * (r i + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨M, hM, hMcard, hMU⟩ := hmatch
  let F : Finset V := {a 0, b 0}
  have hFcard : F.card < M.card := by
    have htwo : F.card ≤ 2 := Finset.card_le_two
    omega
  obtain ⟨e, heM, he₁F, he₂F, heAdj⟩ :=
    exists_adjPair_avoiding_of_disjointAdjPairFamily G M F hM hFcard
  have heU := hMU e heM
  have he₁F' : e.1 ≠ a 0 ∧ e.1 ≠ b 0 := by
    simpa [F] using he₁F
  have he₂F' : e.2 ≠ a 0 ∧ e.2 ≠ b 0 := by
    simpa [F] using he₂F
  obtain ⟨p₀, hp₀, hp₀len, hp₀loc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge G (hrob 0)
      (ha 0) heU.1 heU.2 (hb 0) heAdj
      he₁F'.1.symm he₂F'.1.symm (hab 0) he₁F'.2 he₂F'.2
      hℓ hℓU hℓθ
  choose q hq hqlen _hqavoid hqloc using fun i : Fin m =>
    exists_even_path_between_of_robustPairSet_avoiding
      G (F := ∅) (r := r i) (hrob i.succ) (ha i.succ) (hb i.succ)
        (by simp) (by simp) (hab i.succ) (by simpa using hU i)
          (by simpa using hθ i)
  let p : ∀ i : Fin (m + 1), G.Walk (a i) (b i) :=
    Fin.cases p₀ q
  have hp : ∀ i : Fin (m + 1), (p i).IsPath := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [p] using hp₀
    · simpa [p] using hq j
  have hploc : ∀ i : Fin (m + 1), ∀ v ∈ (p i).support,
      v ∈ U i ∨ v ∈ T i := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [p] using hp₀loc
    · simpa [p] using hqloc j
  have hdisj : ∀ i j : Fin (m + 1), i ≠ j →
      (p i).support.Disjoint (p j).support := by
    intro i j hij
    exact walk_support_disjoint_of_location_of_disjoint_regions G
      (hregions i j hij) (hploc i) (hploc j)
  have hsum :
      (∑ i : Fin (m + 1), (p i).length) =
        ℓ + ∑ i : Fin m, 2 * (r i + 1) := by
    rw [Fin.sum_univ_succ]
    simp [p, hp₀len, hqlen]
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b p hp hdisj hcross hclose
  · rw [hsum]
    omega
  · rw [hsum]
    exact hlen

/-- A cycle in the large-cross-matching auxiliary graph lifts directly to
an exact ambient cycle.  The matching-backed cyclic selector above already
guarantees distinct incoming and outgoing attachments, while this theorem
feeds those handles into the robust routing splice. -/
theorem cycleGraph_isContained_of_largeCrossMatchingGraph_cycle_matched
    {V ι : Type*} [Fintype V] {m ℓ k : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (U i))
    (hℓ : 5 ≤ ℓ)
    (hℓU : ∀ i, ℓ ≤ (U i).card)
    (hℓθ : ∀ i, ℓ + 1 ≤ θ i)
    (r : Fin m → ℕ)
    (hU : ∀ i : ι, ∀ j : Fin m, r j + 2 ≤ (U i).card)
    (hθ : ∀ i : ι, ∀ j : Fin m,
      2 * (r j + 1) + 1 ≤ θ i)
    (hcopy : cycleGraph (m + 1) ⊑ LargeCrossMatchingGraph G U 3)
    (hlen : ℓ + (∑ j : Fin m, 2 * (r j + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, ha, hb, hab, hcross, hclose⟩ :=
    exists_distinct_cyclic_cross_edges_of_cycleGraph_isContained_largeCrossMatchingGraph
      hm G U hcopy
  apply cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_matched_fin
    G hk (fun i => U (f i)) (fun i => T (f i)) (fun i => θ (f i))
      (fun i => hrob (f i))
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      (hmatch (f 0)) a b ha hb hab hcross hclose
      hℓ (hℓU (f 0)) (hℓθ (f 0)) r
  · intro j
    exact hU (f j.succ) j
  · intro j
    exact hθ (f j.succ) j
  · exact hlen

/-- Uniform-route exclusion for the large-cross-matching interaction graph.
Every auxiliary cycle whose routing-length interval contains `k` would lift
to `Cₖ`, so a `Cₖ`-free graph contains no such auxiliary cycle. -/
theorem not_cycleGraph_isContained_largeCrossMatchingGraph_of_matched_uniform_routes
    {V ι : Type*} [Fintype V] {m s L k : ℕ}
    (hm : 2 ≤ m)
    (hfitlow : 2 * (s + 1) * m + m + 6 ≤ k)
    (hfitup : k ≤ L + 2 * (s + 1) * m + m + 1)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (U i))
    (hL : ∀ i, L ≤ (U i).card)
    (hLθ : ∀ i, L + 1 ≤ θ i)
    (hsU : ∀ i, s + 2 ≤ (U i).card)
    (hsθ : ∀ i, 2 * (s + 1) + 1 ≤ θ i)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph (m + 1) ⊑ LargeCrossMatchingGraph G U 3 := by
  intro hcopy
  apply hcycle
  let ℓ : ℕ := k - (2 * (s + 1) * m + m + 1)
  have hℓ : 5 ≤ ℓ := by
    dsimp [ℓ]
    omega
  have hℓL : ℓ ≤ L := by
    dsimp [ℓ]
    omega
  apply cycleGraph_isContained_of_largeCrossMatchingGraph_cycle_matched
    hm (by omega) G U T θ hrob hregions hmatch hℓ
      (fun i => hℓL.trans (hL i))
      (fun i => by
        have hi := hLθ i
        omega)
      (fun _ : Fin m => s)
  · intro i j
    exact hsU i
  · intro i j
    exact hsθ i
  · exact hcopy
  · simp only [Fin.sum_const]
    change ℓ + m * (2 * (s + 1)) + m + 1 = k
    rw [Nat.mul_comm m (2 * (s + 1))]
    dsimp [ℓ]
    omega

/-- Three pairwise-disjoint robust regions whose interaction graph contains
a triangle realize every admissible even-route total.  It is the concrete
three-hub corollary of the generic cyclic handle lemma, and is the first
place where a cycle in the auxiliary hub graph is converted back into a
cycle of the original graph. -/
theorem cycleGraph_isContained_of_three_disjoint_robustPairSets_even
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ U₃ T₃ : Finset V}
    {θ₁ θ₂ θ₃ r s t k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁)
    (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hrob₃ : RobustPairSet G U₃ T₃ θ₃)
    (hregions₁₂ : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hregions₁₃ : Disjoint (U₁ ∪ T₁) (U₃ ∪ T₃))
    (hregions₂₃ : Disjoint (U₂ ∪ T₂) (U₃ ∪ T₃))
    {a₁ b₁ a₂ b₂ a₃ b₃ : V}
    (ha₁ : a₁ ∈ U₁) (hb₁ : b₁ ∈ U₁)
    (ha₂ : a₂ ∈ U₂) (hb₂ : b₂ ∈ U₂)
    (ha₃ : a₃ ∈ U₃) (hb₃ : b₃ ∈ U₃)
    (hab₁ : a₁ ≠ b₁) (hab₂ : a₂ ≠ b₂) (hab₃ : a₃ ≠ b₃)
    (h₁₂ : G.Adj b₁ a₂) (h₂₃ : G.Adj b₂ a₃) (h₃₁ : G.Adj b₃ a₁)
    (hU₁ : r + 2 ≤ U₁.card) (hθ₁ : 2 * (r + 1) + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hU₃ : t + 2 ≤ U₃.card) (hθ₃ : 2 * (t + 1) + 1 ≤ θ₃)
    (hlen : 2 * (r + 1) + 2 * (s + 1) + 2 * (t + 1) + 3 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, _hpavoid, hploc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := r)
      hrob₁ ha₁ hb₁ (by simp) (by simp) hab₁ (by simpa) (by simpa using hθ₁)
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := s)
      hrob₂ ha₂ hb₂ (by simp) (by simp) hab₂ (by simpa) (by simpa using hθ₂)
  obtain ⟨w, hw, hwlen, _hwavoid, hwloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := t)
      hrob₃ ha₃ hb₃ (by simp) (by simp) hab₃ (by simpa) (by simpa using hθ₃)
  have hpq : p.support.Disjoint q.support :=
    walk_support_disjoint_of_location_of_disjoint_regions G hregions₁₂ hploc hqloc
  have hpw : p.support.Disjoint w.support :=
    walk_support_disjoint_of_location_of_disjoint_regions G hregions₁₃ hploc hwloc
  have hqw : q.support.Disjoint w.support :=
    walk_support_disjoint_of_location_of_disjoint_regions G hregions₂₃ hqloc hwloc
  apply cycleGraph_isContained_of_three_cross_edges_and_disjoint_paths G hk
    hp hq hw hab₁ hpq hpw hqw h₁₂ h₂₃ h₃₁
  omega

/-- All-length three-hub splice.  The first robust region uses the
independent-set parity correction to route an arbitrary length `ℓ`, while
the other two regions contribute even routes.  Three cyclic cross-edges then
close the three disjoint internal paths to the prescribed ordinary cycle. -/
theorem cycleGraph_isContained_of_three_disjoint_robustPairSets_all_lengths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ U₃ T₃ : Finset V}
    {θ₁ θ₂ θ₃ n ℓ s t k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁)
    (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hrob₃ : RobustPairSet G U₃ T₃ θ₃)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions₁₂ : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hregions₁₃ : Disjoint (U₁ ∪ T₁) (U₃ ∪ T₃))
    (hregions₂₃ : Disjoint (U₂ ∪ T₂) (U₃ ∪ T₃))
    {a₁ b₁ a₂ b₂ a₃ b₃ : V}
    (ha₁ : a₁ ∈ U₁) (hb₁ : b₁ ∈ U₁)
    (ha₂ : a₂ ∈ U₂) (hb₂ : b₂ ∈ U₂)
    (ha₃ : a₃ ∈ U₃) (hb₃ : b₃ ∈ U₃)
    (hab₁ : a₁ ≠ b₁) (hab₂ : a₂ ≠ b₂) (hab₃ : a₃ ≠ b₃)
    (h₁₂ : G.Adj b₁ a₂) (h₂₃ : G.Adj b₂ a₃) (h₃₁ : G.Adj b₃ a₁)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hU₃ : t + 2 ≤ U₃.card) (hθ₃ : 2 * (t + 1) + 1 ≤ θ₃)
    (hlen : ℓ + 2 * (s + 1) + 2 * (t + 1) + 3 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob₁ hfree hU₁n
      ha₁ hb₁ hab₁ hℓ hℓU hℓθ
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := s)
      hrob₂ ha₂ hb₂ (by simp) (by simp) hab₂ (by simpa) (by simpa using hθ₂)
  obtain ⟨w, hw, hwlen, _hwavoid, hwloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := t)
      hrob₃ ha₃ hb₃ (by simp) (by simp) hab₃ (by simpa) (by simpa using hθ₃)
  have hpq : p.support.Disjoint q.support :=
    walk_support_disjoint_of_location_of_disjoint_regions G hregions₁₂ hploc hqloc
  have hpw : p.support.Disjoint w.support :=
    walk_support_disjoint_of_location_of_disjoint_regions G hregions₁₃ hploc hwloc
  have hqw : q.support.Disjoint w.support :=
    walk_support_disjoint_of_location_of_disjoint_regions G hregions₂₃ hqloc hwloc
  apply cycleGraph_isContained_of_three_cross_edges_and_disjoint_paths G hk
    hp hq hw hab₁ hpq hpw hqw h₁₂ h₂₃ h₃₁
  omega

/-- Exact three-hub cleanup with the second and third routes fixed at length
two.  A separated cyclic triangle of robust regions therefore forces `C_k`
as soon as the first hub routes through `k - 7`. -/
theorem cycleGraph_isContained_of_three_robustPairSets_all_lengths_short_second_third
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ U₃ T₃ : Finset V}
    {θ₁ θ₂ θ₃ n k : ℕ} (hk : 12 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁)
    (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hrob₃ : RobustPairSet G U₃ T₃ θ₃)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions₁₂ : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hregions₁₃ : Disjoint (U₁ ∪ T₁) (U₃ ∪ T₃))
    (hregions₂₃ : Disjoint (U₂ ∪ T₂) (U₃ ∪ T₃))
    {a₁ b₁ a₂ b₂ a₃ b₃ : V}
    (ha₁ : a₁ ∈ U₁) (hb₁ : b₁ ∈ U₁)
    (ha₂ : a₂ ∈ U₂) (hb₂ : b₂ ∈ U₂)
    (ha₃ : a₃ ∈ U₃) (hb₃ : b₃ ∈ U₃)
    (hab₁ : a₁ ≠ b₁) (hab₂ : a₂ ≠ b₂) (hab₃ : a₃ ≠ b₃)
    (h₁₂ : G.Adj b₁ a₂) (h₂₃ : G.Adj b₂ a₃) (h₃₁ : G.Adj b₃ a₁)
    (hU₁ : k - 7 ≤ U₁.card) (hθ₁ : k - 6 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hU₃ : 2 ≤ U₃.card) (hθ₃ : 3 ≤ θ₃) :
    cycleGraph k ⊑ G := by
  apply cycleGraph_isContained_of_three_disjoint_robustPairSets_all_lengths
    G (by omega) hrob₁ hrob₂ hrob₃ hfree hU₁n hregions₁₂ hregions₁₃
      hregions₂₃ ha₁ hb₁ ha₂ hb₂ ha₃ hb₃ hab₁ hab₂ hab₃ h₁₂ h₂₃ h₃₁
      (ℓ := k - 7) (s := 0) (t := 0)
  · omega
  · exact hU₁
  · have hsub : (k - 7) + 1 = k - 6 := by omega
    rw [hsub]
    exact hθ₁
  · simpa using hU₂
  · simpa using hθ₂
  · simpa using hU₃
  · simpa using hθ₃
  · omega

/-- Three robust cores have separated cyclic handles when each core supplies
two distinct attachment vertices and the three displayed cross-edges join
them cyclically.  This is the exact local configuration excluded by the
all-length three-hub splice in a `C_k`-free graph. -/
def HasSeparatedTriangleHandles
    {V : Type*} (G : SimpleGraph V)
    (U₁ U₂ U₃ : Finset V) : Prop :=
  ∃ a₁ b₁ a₂ b₂ a₃ b₃ : V,
    a₁ ∈ U₁ ∧ b₁ ∈ U₁ ∧ a₂ ∈ U₂ ∧ b₂ ∈ U₂ ∧ a₃ ∈ U₃ ∧ b₃ ∈ U₃ ∧
      a₁ ≠ b₁ ∧ a₂ ≠ b₂ ∧ a₃ ≠ b₃ ∧
      G.Adj b₁ a₂ ∧ G.Adj b₂ a₃ ∧ G.Adj b₃ a₁

/-- If three displayed cross-edges do not form separated triangle handles,
then at least one hub reuses its attachment vertex on its two incident
cross-edges.  This is the elementary repeated-attachment alternative behind
the next stability reduction. -/
theorem repeated_attachment_of_not_hasSeparatedTriangleHandles
    {V : Type*} (G : SimpleGraph V)
    {U₁ U₂ U₃ : Finset V}
    (hnot : ¬ HasSeparatedTriangleHandles G U₁ U₂ U₃)
    {a₁ b₁ a₂ b₂ a₃ b₃ : V}
    (ha₁ : a₁ ∈ U₁) (hb₁ : b₁ ∈ U₁)
    (ha₂ : a₂ ∈ U₂) (hb₂ : b₂ ∈ U₂)
    (ha₃ : a₃ ∈ U₃) (hb₃ : b₃ ∈ U₃)
    (h₁₂ : G.Adj b₁ a₂) (h₂₃ : G.Adj b₂ a₃) (h₃₁ : G.Adj b₃ a₁) :
    a₁ = b₁ ∨ a₂ = b₂ ∨ a₃ = b₃ := by
  by_cases h₁ : a₁ = b₁
  · exact Or.inl h₁
  by_cases h₂ : a₂ = b₂
  · exact Or.inr (Or.inl h₂)
  by_cases h₃ : a₃ = b₃
  · exact Or.inr (Or.inr h₃)
  exfalso
  exact hnot ⟨a₁, b₁, a₂, b₂, a₃, b₃, ha₁, hb₁, ha₂, hb₂, ha₃, hb₃,
    h₁, h₂, h₃, h₁₂, h₂₃, h₃₁⟩

/-- Contrapositive triangle obstruction for cleanup.  A `C_k`-free graph
with the displayed robust capacities has no separated cyclic three-handle
configuration among three disjoint hubs. -/
theorem not_hasSeparatedTriangleHandles_of_cycleFree_three_robustPairSets
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ U₃ T₃ : Finset V}
    {θ₁ θ₂ θ₃ n k : ℕ} (hk : 12 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁)
    (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hrob₃ : RobustPairSet G U₃ T₃ θ₃)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions₁₂ : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hregions₁₃ : Disjoint (U₁ ∪ T₁) (U₃ ∪ T₃))
    (hregions₂₃ : Disjoint (U₂ ∪ T₂) (U₃ ∪ T₃))
    (hU₁ : k - 7 ≤ U₁.card) (hθ₁ : k - 6 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hU₃ : 2 ≤ U₃.card) (hθ₃ : 3 ≤ θ₃)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ HasSeparatedTriangleHandles G U₁ U₂ U₃ := by
  rintro ⟨a₁, b₁, a₂, b₂, a₃, b₃, ha₁, hb₁, ha₂, hb₂, ha₃, hb₃,
    hab₁, hab₂, hab₃, h₁₂, h₂₃, h₃₁⟩
  apply hcycle
  exact cycleGraph_isContained_of_three_robustPairSets_all_lengths_short_second_third
    G hk hrob₁ hrob₂ hrob₃ hfree hU₁n hregions₁₂ hregions₁₃ hregions₂₃
    ha₁ hb₁ ha₂ hb₂ ha₃ hb₃ hab₁ hab₂ hab₃ h₁₂ h₂₃ h₃₁
    hU₁ hθ₁ hU₂ hθ₂ hU₃ hθ₃

/-- Family form of the separated-triangle obstruction.  In a disjoint
robust-hub family with the uniform cleanup-scale capacities, every three
distinct cores avoid separated cyclic handles. -/
theorem not_hasSeparatedTriangleHandles_of_cycleFree_short_second_hub_family
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G)
    (i j ℓ : ι) (hij : i ≠ j) (hiℓ : i ≠ ℓ) (hjℓ : j ≠ ℓ) :
    ¬ HasSeparatedTriangleHandles G (U i) (U j) (U ℓ) := by
  apply not_hasSeparatedTriangleHandles_of_cycleFree_three_robustPairSets
    G hk (hrob i) (hrob j) (hrob ℓ) hfree (hUn i)
      (hregions i j hij) (hregions i ℓ hiℓ) (hregions j ℓ hjℓ)
  · have := hUk i
    omega
  · have := hθ i
    omega
  · have := hUk j
    omega
  · have := hθ j
    omega
  · have := hUk ℓ
    omega
  · have := hθ ℓ
    omega
  · exact hcycle

/-- Repeated-attachment form of the family triangle obstruction.  Any three
cyclic cross-edges among distinct robust hubs in a `C_k`-free graph must use
the same endpoint twice in at least one of the three hubs. -/
theorem repeated_attachment_of_three_cross_edges_in_cycleFree_short_second_hub_family
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G)
    (i j ℓ : ι) (hij : i ≠ j) (hiℓ : i ≠ ℓ) (hjℓ : j ≠ ℓ)
    {a₁ b₁ a₂ b₂ a₃ b₃ : V}
    (ha₁ : a₁ ∈ U i) (hb₁ : b₁ ∈ U i)
    (ha₂ : a₂ ∈ U j) (hb₂ : b₂ ∈ U j)
    (ha₃ : a₃ ∈ U ℓ) (hb₃ : b₃ ∈ U ℓ)
    (h₁₂ : G.Adj b₁ a₂) (h₂₃ : G.Adj b₂ a₃) (h₃₁ : G.Adj b₃ a₁) :
    a₁ = b₁ ∨ a₂ = b₂ ∨ a₃ = b₃ := by
  apply repeated_attachment_of_not_hasSeparatedTriangleHandles G
    (not_hasSeparatedTriangleHandles_of_cycleFree_short_second_hub_family
      G U T θ hk hrob hfree hUn hUk hθ hregions hcycle i j ℓ hij hiℓ hjℓ)
    ha₁ hb₁ ha₂ hb₂ ha₃ hb₃ h₁₂ h₂₃ h₃₁

/-- Two disjoint robust regions joined by two cross-edges give every even
cycle length allowed by the two visible route budgets.  The support-location
certificate from the avoiding route theorem turns disjoint regions into
disjoint paths, after which the generic handle splice applies. -/
theorem cycleGraph_isContained_of_two_disjoint_robustPairSets_even
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ r s k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d : V} (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d) (hbc : G.Adj b c) (hda : G.Adj d a)
    (hU₁ : r + 2 ≤ U₁.card) (hθ₁ : 2 * (r + 1) + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hlen : 2 * (r + 1) + 2 * (s + 1) + 2 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, _hpavoid, hploc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := r)
      hrob₁ ha hb (by simp) (by simp) hab (by simpa) (by simpa using hθ₁)
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := s)
      hrob₂ hc hd (by simp) (by simp) hcd (by simpa) (by simpa using hθ₂)
  have hdisj : p.support.Disjoint q.support := by
    intro v hvp hvq
    have hv₁ : v ∈ U₁ ∪ T₁ := by
      rcases hploc v hvp with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    have hv₂ : v ∈ U₂ ∪ T₂ := by
      rcases hqloc v hvq with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    exact Finset.disjoint_left.mp hregions hv₁ hv₂
  apply cycleGraph_isContained_of_two_cross_edges_and_disjoint_paths G hk hp hq hab
    hdisj hbc hda
  omega

/-- If one of two disjoint robust regions is large enough for the
independent-set parity correction, then the same two-handle splice realizes
all admissible lengths, not only the even ones.  This is the local
all-parity handle lemma used when KLS discards the exceptional non-broken
hubs. -/
theorem cycleGraph_isContained_of_two_disjoint_robustPairSets_all_lengths
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n ℓ s k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d : V} (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d) (hbc : G.Adj b c) (hda : G.Adj d a)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hlen : ℓ + 2 * (s + 1) + 2 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob₁ hfree hU₁n ha hb hab
      hℓ hℓU hℓθ
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := s)
      hrob₂ hc hd (by simp) (by simp) hcd (by simpa) (by simpa using hθ₂)
  have hdisj : p.support.Disjoint q.support := by
    intro v hvp hvq
    have hv₁ : v ∈ U₁ ∪ T₁ := by
      rcases hploc v hvp with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    have hv₂ : v ∈ U₂ ∪ T₂ := by
      rcases hqloc v hvq with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    exact Finset.disjoint_left.mp hregions hv₁ hv₂
  apply cycleGraph_isContained_of_two_cross_edges_and_disjoint_paths G hk hp hq hab
    hdisj hbc hda
  omega

/-- All-length two-hub splice with two length-two external handles.  The first
robust region supplies the parity-corrected route, the second supplies an even
route, and the two explicitly outside middle vertices contribute four handle
edges.  This is the local obstruction used when two remainder vertices both
link the same pair of stable seeds. -/
theorem cycleGraph_isContained_of_two_robustPairSets_all_lengths_twoEdge_handles
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n ℓ s k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d x y : V}
    (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d)
    (hx₁ : x ∉ U₁ ∪ T₁) (hx₂ : x ∉ U₂ ∪ T₂)
    (hy₁ : y ∉ U₁ ∪ T₁) (hy₂ : y ∉ U₂ ∪ T₂) (hxy : x ≠ y)
    (hbx : G.Adj b x) (hxc : G.Adj x c)
    (hdy : G.Adj d y) (hya : G.Adj y a)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hlen : ℓ + 2 * (s + 1) + 4 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob₁ hfree hU₁n ha hb hab
      hℓ hℓU hℓθ
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := s)
      hrob₂ hc hd (by simp) (by simp) hcd (by simpa) (by simpa using hθ₂)
  have hpq : p.support.Disjoint q.support := by
    intro v hvp hvq
    have hv₁ : v ∈ U₁ ∪ T₁ := by
      rcases hploc v hvp with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    have hv₂ : v ∈ U₂ ∪ T₂ := by
      rcases hqloc v hvq with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    exact Finset.disjoint_left.mp hregions hv₁ hv₂
  have hxp : x ∉ p.support := by
    intro h
    exact hx₁ (by
      rcases hploc x h with hx | hx
      · exact Finset.mem_union_left _ hx
      · exact Finset.mem_union_right _ hx)
  have hxq : x ∉ q.support := by
    intro h
    exact hx₂ (by
      rcases hqloc x h with hx | hx
      · exact Finset.mem_union_left _ hx
      · exact Finset.mem_union_right _ hx)
  have hyp : y ∉ p.support := by
    intro h
    exact hy₁ (by
      rcases hploc y h with hy | hy
      · exact Finset.mem_union_left _ hy
      · exact Finset.mem_union_right _ hy)
  have hyq : y ∉ q.support := by
    intro h
    exact hy₂ (by
      rcases hqloc y h with hy | hy
      · exact Finset.mem_union_left _ hy
      · exact Finset.mem_union_right _ hy)
  apply cycleGraph_isContained_of_two_twoEdge_handles_and_disjoint_paths
    G hk hp hq hpq hxp hxq hyp hyq hxy hbx hxc hdy hya
  omega

/-- All-length two-hub splice with arbitrary disjoint outside path handles.
The two handle paths lie completely outside both robust routing regions, so
their supports are automatically disjoint from the internal hub routes; the
generic four-path assembler then closes the target cycle.  Diameter-two
remainder pieces instantiate these handles with paths of length at most two.
-/
theorem cycleGraph_isContained_of_two_robustPairSets_all_lengths_path_handles
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n ℓ t k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d u v y z : V}
    {h₁ : G.Walk u v} {h₂ : G.Walk y z}
    (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d)
    (hh₁ : h₁.IsPath) (hh₂ : h₂.IsPath)
    (h₁outside : ∀ w ∈ h₁.support, w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (h₂outside : ∀ w ∈ h₂.support, w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (hhandles : h₁.support.Disjoint h₂.support)
    (hbu : G.Adj b u) (hvc : G.Adj v c)
    (hdy : G.Adj d y) (hza : G.Adj z a)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : t + 2 ≤ U₂.card) (hθ₂ : 2 * (t + 1) + 1 ≤ θ₂)
    (hlen : ℓ + h₁.length + 2 * (t + 1) + h₂.length + 4 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob₁ hfree hU₁n ha hb hab
      hℓ hℓU hℓθ
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := t)
      hrob₂ hc hd (by simp) (by simp) hcd (by simpa) (by simpa using hθ₂)
  have hpq : p.support.Disjoint q.support := by
    intro w hwp hwq
    have hw₁ : w ∈ U₁ ∪ T₁ := by
      rcases hploc w hwp with hw | hw
      · exact Finset.mem_union_left _ hw
      · exact Finset.mem_union_right _ hw
    have hw₂ : w ∈ U₂ ∪ T₂ := by
      rcases hqloc w hwq with hw | hw
      · exact Finset.mem_union_left _ hw
      · exact Finset.mem_union_right _ hw
    exact Finset.disjoint_left.mp hregions hw₁ hw₂
  have hph₁ : p.support.Disjoint h₁.support := by
    intro w hwp hwh
    have hw₁ : w ∈ U₁ ∪ T₁ := by
      rcases hploc w hwp with hw | hw
      · exact Finset.mem_union_left _ hw
      · exact Finset.mem_union_right _ hw
    exact (h₁outside w hwh).1 hw₁
  have hph₂ : p.support.Disjoint h₂.support := by
    intro w hwp hwh
    have hw₁ : w ∈ U₁ ∪ T₁ := by
      rcases hploc w hwp with hw | hw
      · exact Finset.mem_union_left _ hw
      · exact Finset.mem_union_right _ hw
    exact (h₂outside w hwh).1 hw₁
  have hh₁q : h₁.support.Disjoint q.support := by
    intro w hwh hwq
    have hw₂ : w ∈ U₂ ∪ T₂ := by
      rcases hqloc w hwq with hw | hw
      · exact Finset.mem_union_left _ hw
      · exact Finset.mem_union_right _ hw
    exact (h₁outside w hwh).2 hw₂
  have hqh₂ : q.support.Disjoint h₂.support := by
    intro w hwq hwh
    have hw₂ : w ∈ U₂ ∪ T₂ := by
      rcases hqloc w hwq with hw | hw
      · exact Finset.mem_union_left _ hw
      · exact Finset.mem_union_right _ hw
    exact (h₂outside w hwh).2 hw₂
  apply cycleGraph_isContained_of_two_path_handles_and_disjoint_paths
    G hk hp hh₁ hq hh₂ hph₁ hpq hph₂ hh₁q hhandles hqh₂
      hbu hvc hdy hza
  omega

/-- Exact bounded-remainder specialization of the path-handle splice.  If
both outside handles have length at most two, then a `k-6` all-length route
budget in the first robust seed and one two-edge route in the second suffice
for an exact `Cₖ`; the residual first-route length is chosen arithmetically
from the two visible handle lengths. -/
theorem cycleGraph_isContained_of_two_robustPairSets_all_lengths_short_path_handles
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 15 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d u v y z : V}
    {h₁ : G.Walk u v} {h₂ : G.Walk y z}
    (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d)
    (hh₁ : h₁.IsPath) (hh₂ : h₂.IsPath)
    (h₁len : h₁.length ≤ 2) (h₂len : h₂.length ≤ 2)
    (h₁outside : ∀ w ∈ h₁.support, w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (h₂outside : ∀ w ∈ h₂.support, w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (hhandles : h₁.support.Disjoint h₂.support)
    (hbu : G.Adj b u) (hvc : G.Adj v c)
    (hdy : G.Adj d y) (hza : G.Adj z a)
    (hU₁ : k - 6 ≤ U₁.card) (hθ₁ : k - 5 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂) :
    cycleGraph k ⊑ G := by
  let ℓ : ℕ := k - (h₁.length + h₂.length + 6)
  apply cycleGraph_isContained_of_two_robustPairSets_all_lengths_path_handles
    G (by omega) hrob₁ hrob₂ hfree hU₁n hregions ha hb hc hd hab hcd
      hh₁ hh₂ h₁outside h₂outside hhandles hbu hvc hdy hza (ℓ := ℓ) (t := 0)
  · dsimp [ℓ]
    omega
  · dsimp [ℓ]
    omega
  · dsimp [ℓ]
    omega
  · simpa using hU₂
  · simpa using hθ₂
  · dsimp [ℓ]
    omega

/-- Ck-free cleanup form of the bounded path-handle obstruction.  Two
vertex-disjoint outside paths of length at most two cannot connect the same
two robust seeds with distinct attachments at both seeds; otherwise the
preceding exact splice produces `Cₖ`. -/
theorem repeated_attachment_or_intersecting_handles_of_cycleFree_two_robustPairSets_short_path_handles
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 15 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d u v y z : V}
    {h₁ : G.Walk u v} {h₂ : G.Walk y z}
    (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hh₁ : h₁.IsPath) (hh₂ : h₂.IsPath)
    (h₁len : h₁.length ≤ 2) (h₂len : h₂.length ≤ 2)
    (h₁outside : ∀ w ∈ h₁.support, w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (h₂outside : ∀ w ∈ h₂.support, w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (hbu : G.Adj b u) (hvc : G.Adj v c)
    (hdy : G.Adj d y) (hza : G.Adj z a)
    (hU₁ : k - 6 ≤ U₁.card) (hθ₁ : k - 5 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    a = b ∨ c = d ∨ ¬ h₁.support.Disjoint h₂.support := by
  by_cases hab : a = b
  · exact Or.inl hab
  by_cases hcd : c = d
  · exact Or.inr (Or.inl hcd)
  by_cases hhandles : h₁.support.Disjoint h₂.support
  · exfalso
    apply hcycle
    exact cycleGraph_isContained_of_two_robustPairSets_all_lengths_short_path_handles
      G hk hrob₁ hrob₂ hfree hU₁n hregions ha hb hc hd hab hcd
        hh₁ hh₂ h₁len h₂len h₁outside h₂outside hhandles hbu hvc hdy hza
        hU₁ hθ₁ hU₂ hθ₂
  · exact Or.inr (Or.inr hhandles)

/-- Finite-family cleanup consequence.  A family of pairwise-disjoint short
outside handles between two fixed robust seeds has at most one member once
its left and right attachment maps are injective.  For two distinct handles,
reverse the second one and apply the preceding repeated-attachment
alternative; injectivity rules out both repeated-end alternatives, while
pairwise support disjointness rules out the last alternative. -/
theorem card_le_one_of_injective_short_path_handles_between_cycleFree_robustPairSets
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 15 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (left right u v : ι → V)
    (h : ∀ i : ι, G.Walk (u i) (v i))
    (hleft : ∀ i, left i ∈ U₁) (hright : ∀ i, right i ∈ U₂)
    (hpath : ∀ i, (h i).IsPath) (hlen : ∀ i, (h i).length ≤ 2)
    (houtside : ∀ i w, w ∈ (h i).support →
      w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (hleftAdj : ∀ i, G.Adj (left i) (u i))
    (hrightAdj : ∀ i, G.Adj (v i) (right i))
    (hdisj : ∀ i j, i ≠ j → (h i).support.Disjoint (h j).support)
    (hleftInj : Function.Injective left)
    (hrightInj : Function.Injective right)
    (hU₁ : k - 6 ≤ U₁.card) (hθ₁ : k - 5 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card ι ≤ 1 := by
  rw [← Finset.card_univ, Finset.card_le_one_iff]
  intro i j _hi _hj
  by_contra hij
  have hbad :=
    repeated_attachment_or_intersecting_handles_of_cycleFree_two_robustPairSets_short_path_handles
      G hk hrob₁ hrob₂ hfree hU₁n hregions
      (a := left j) (b := left i) (c := right i) (d := right j)
      (h₁ := h i) (h₂ := (h j).reverse)
      (hleft j) (hleft i) (hright i) (hright j)
      (hpath i) (hpath j).reverse (hlen i) (by simpa using hlen j)
      (houtside i)
      (by
        intro w hw
        apply houtside j w
        simpa [Walk.support_reverse] using hw)
      (hleftAdj i) (hrightAdj i)
      (hrightAdj j).symm (hleftAdj j).symm
      hU₁ hθ₁ hU₂ hθ₂ hcycle
  rcases hbad with hleftEq | hrightEq | hinter
  · exact hij (hleftInj hleftEq).symm
  · exact hij (hrightInj hrightEq)
  · apply hinter
    intro w hwi hwj
    apply (hdisj i j hij) hwi
    simpa [Walk.support_reverse] using hwj

/-- Elementary two-coordinate Helly lemma.  If every two indexed pairs agree
in the first coordinate or in the second coordinate, then all first
coordinates are equal or all second coordinates are equal.  This is the
finite combinatorial form of the one-attachment cleanup after the short-path
obstruction has ruled out two disjoint attachment pairs. -/
theorem exists_common_left_or_right_of_pairwise_left_eq_or_right_eq
    {ι α β : Type*} [Nonempty ι]
    (left : ι → α) (right : ι → β)
    (hpair : ∀ i j : ι, left i = left j ∨ right i = right j) :
    (∃ a : α, ∀ i : ι, left i = a) ∨
      ∃ b : β, ∀ i : ι, right i = b := by
  let i₀ : ι := Classical.choice inferInstance
  by_cases hleft : ∀ i : ι, left i = left i₀
  · exact Or.inl ⟨left i₀, hleft⟩
  · push_neg at hleft
    obtain ⟨j, hj⟩ := hleft
    have hrightji₀ : right j = right i₀ := by
      rcases hpair j i₀ with h | h
      · exact (hj h).elim
      · exact h
    right
    refine ⟨right i₀, ?_⟩
    intro i
    rcases hpair i i₀ with hlefti | hrighti
    · rcases hpair j i with hleftji | hrightji
      · exact (hj (hleftji.trans hlefti)).elim
      · exact hrightji.symm.trans hrightji₀
    · exact hrighti

/-- Concentration form of the Ck-free short-handle cleanup.  For a nonempty
pairwise-disjoint family of short outside paths joining two fixed robust
seeds, all left attachments coincide or all right attachments coincide.
Thus one seed vertex covers every surviving handle between this seed pair. -/
theorem exists_common_attachment_of_cycleFree_short_path_handles_between_robustPairSets
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 15 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (left right u v : ι → V)
    (h : ∀ i : ι, G.Walk (u i) (v i))
    (hleft : ∀ i, left i ∈ U₁) (hright : ∀ i, right i ∈ U₂)
    (hpath : ∀ i, (h i).IsPath) (hlen : ∀ i, (h i).length ≤ 2)
    (houtside : ∀ i w, w ∈ (h i).support →
      w ∉ U₁ ∪ T₁ ∧ w ∉ U₂ ∪ T₂)
    (hleftAdj : ∀ i, G.Adj (left i) (u i))
    (hrightAdj : ∀ i, G.Adj (v i) (right i))
    (hdisj : ∀ i j, i ≠ j → (h i).support.Disjoint (h j).support)
    (hU₁ : k - 6 ≤ U₁.card) (hθ₁ : k - 5 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (∃ a : V, ∀ i : ι, left i = a) ∨
      ∃ b : V, ∀ i : ι, right i = b := by
  apply exists_common_left_or_right_of_pairwise_left_eq_or_right_eq left right
  intro i j
  by_cases hij : i = j
  · subst j
    exact Or.inl rfl
  have hbad :=
    repeated_attachment_or_intersecting_handles_of_cycleFree_two_robustPairSets_short_path_handles
      G hk hrob₁ hrob₂ hfree hU₁n hregions
      (a := left j) (b := left i) (c := right i) (d := right j)
      (h₁ := h i) (h₂ := (h j).reverse)
      (hleft j) (hleft i) (hright i) (hright j)
      (hpath i) (hpath j).reverse (hlen i) (by simpa using hlen j)
      (houtside i)
      (by
        intro w hw
        apply houtside j w
        simpa [Walk.support_reverse] using hw)
      (hleftAdj i) (hrightAdj i)
      (hrightAdj j).symm (hleftAdj j).symm
      hU₁ hθ₁ hU₂ hθ₂ hcycle
  rcases hbad with hleftEq | hrightEq | hinter
  · exact Or.inl hleftEq.symm
  · exact Or.inr hrightEq
  · exact (hinter (by
      intro w hwi hwj
      apply (hdisj i j hij) hwi
      simpa [Walk.support_reverse] using hwj)).elim

/-- Global short-handle cleanup.  For a pairwise-disjoint family of short
outside paths indexed by an arbitrary finite type, choose one common
attachment for every ordered pair of robust seeds.  The resulting exceptional
set has at most `|ι|²` vertices and meets one endpoint of every handle.  This
is the finite global form of KLS's separation deletion before leftover
components are assigned back to stable blocks. -/
theorem exists_global_exceptional_set_meeting_short_path_handles_of_cycleFree_robust_family
    {V ι κ : Type*} [Fintype V] [Nonempty V] [Fintype ι] [Fintype κ]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 6 ≤ (U i).card)
    (hθ : ∀ i, k - 5 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (src dst : κ → ι) (left right u v : κ → V)
    (h : ∀ a : κ, G.Walk (u a) (v a))
    (hsrcne : ∀ a, src a ≠ dst a)
    (hleft : ∀ a, left a ∈ U (src a))
    (hright : ∀ a, right a ∈ U (dst a))
    (hpath : ∀ a, (h a).IsPath) (hlen : ∀ a, (h a).length ≤ 2)
    (houtside : ∀ a w, w ∈ (h a).support →
      w ∉ U (src a) ∪ T (src a) ∧ w ∉ U (dst a) ∪ T (dst a))
    (hleftAdj : ∀ a, G.Adj (left a) (u a))
    (hrightAdj : ∀ a, G.Adj (v a) (right a))
    (hdisj : ∀ a b, a ≠ b → (h a).support.Disjoint (h b).support)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ a : κ, left a ∈ X ∨ right a ∈ X := by
  classical
  have hpair : ∀ i j : ι, i ≠ j → ∃ x : V,
      (∀ a : κ, src a = i → dst a = j → left a = x) ∨
        (∀ a : κ, src a = i → dst a = j → right a = x) := by
    intro i j hij
    let K := {a : κ // src a = i ∧ dst a = j}
    by_cases hK : Nonempty K
    · let : Nonempty K := hK
      obtain ⟨x, hx⟩ | ⟨x, hx⟩ :=
        exists_common_attachment_of_cycleFree_short_path_handles_between_robustPairSets
          G hk (hrob i) (hrob j) hfree (hUn i) (hregions i j hij)
          (fun a : K => left a.1) (fun a : K => right a.1)
          (fun a : K => u a.1) (fun a : K => v a.1)
          (fun a : K => h a.1)
          (fun a : K => by simpa [a.2.1] using hleft a.1)
          (fun a : K => by simpa [a.2.2] using hright a.1)
          (fun a : K => hpath a.1) (fun a : K => hlen a.1)
          (by
            intro a w hw
            simpa [a.2.1, a.2.2] using houtside a.1 w hw)
          (fun a : K => hleftAdj a.1) (fun a : K => hrightAdj a.1)
          (by
            intro a b hab
            apply hdisj a.1 b.1
            intro heq
            apply hab
            exact Subtype.ext heq)
          (hUk i) (hθ i)
          (by have := hUk j; omega)
          (by have := hθ j; omega) hcycle
      · refine ⟨x, Or.inl ?_⟩
        intro a hsrc hdst
        let a' : K := ⟨a, hsrc, hdst⟩
        exact hx a'
      · refine ⟨x, Or.inr ?_⟩
        intro a hsrc hdst
        let a' : K := ⟨a, hsrc, hdst⟩
        exact hx a'
    · let x : V := Classical.choice inferInstance
      refine ⟨x, Or.inl ?_⟩
      intro a hsrc hdst
      exfalso
      exact hK ⟨⟨a, hsrc, hdst⟩⟩
  let cover : ι × ι → V := fun ij =>
    if hij : ij.1 ≠ ij.2 then Classical.choose (hpair ij.1 ij.2 hij)
    else Classical.choice inferInstance
  let X : Finset V := (Finset.univ : Finset (ι × ι)).image cover
  refine ⟨X, ?_, ?_⟩
  · calc
      X.card ≤ (Finset.univ : Finset (ι × ι)).card := Finset.card_image_le
      _ = Fintype.card ι * Fintype.card ι := by simp
      _ = (Fintype.card ι) ^ 2 := by ring
  · intro a
    have hsne : src a ≠ dst a := hsrcne a
    have hspec := Classical.choose_spec (hpair (src a) (dst a) hsne)
    have hmem : cover (src a, dst a) ∈ X :=
      Finset.mem_image.mpr ⟨(src a, dst a), Finset.mem_univ _, rfl⟩
    have hcover : cover (src a, dst a) =
        Classical.choose (hpair (src a) (dst a) hsne) := by
      simp [cover, hsne]
    rw [hcover] at hmem
    rcases hspec with hleftAll | hrightAll
    · left
      rw [hleftAll a rfl rfl]
      exact hmem
    · right
      rw [hrightAll a rfl rfl]
      exact hmem

/-- Trimmed short-handle cleanup.  After deleting the exceptional set from
the preceding theorem, no listed short outside handle can keep both of its
seed attachments.  This is the form used by the leftover-component
separation argument: a surviving component joining two trimmed seeds would
itself provide one of the forbidden handles. -/
theorem exists_global_exceptional_set_forbidding_surviving_short_path_handles_of_cycleFree_robust_family
    {V ι κ : Type*} [Fintype V] [Nonempty V] [Fintype ι] [Fintype κ]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 6 ≤ (U i).card)
    (hθ : ∀ i, k - 5 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (src dst : κ → ι) (left right u v : κ → V)
    (h : ∀ a : κ, G.Walk (u a) (v a))
    (hsrcne : ∀ a, src a ≠ dst a)
    (hleft : ∀ a, left a ∈ U (src a))
    (hright : ∀ a, right a ∈ U (dst a))
    (hpath : ∀ a, (h a).IsPath) (hlen : ∀ a, (h a).length ≤ 2)
    (houtside : ∀ a w, w ∈ (h a).support →
      w ∉ U (src a) ∪ T (src a) ∧ w ∉ U (dst a) ∪ T (dst a))
    (hleftAdj : ∀ a, G.Adj (left a) (u a))
    (hrightAdj : ∀ a, G.Adj (v a) (right a))
    (hdisj : ∀ a b, a ≠ b → (h a).support.Disjoint (h b).support)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ a : κ, left a ∉ X → right a ∉ X → False := by
  obtain ⟨X, hXcard, hXmeet⟩ :=
    exists_global_exceptional_set_meeting_short_path_handles_of_cycleFree_robust_family
      G U T θ hk hrob hfree hUn hUk hθ hregions src dst left right u v h
      hsrcne hleft hright hpath hlen houtside hleftAdj hrightAdj hdisj hcycle
  refine ⟨X, hXcard, ?_⟩
  intro a hleftout hrightout
  rcases hXmeet a with hleftmem | hrightmem
  · exact hleftout hleftmem
  · exact hrightout hrightmem

/-- Separation interface for the short-handle cleanup.  Suppose a finite
handle family contains a witness for every reachable leftover connection
whose endpoints see two distinct robust cores.  The preceding exceptional
set then separates the trimmed cores: no leftover component can still see
two of them.  This is precisely the hypothesis expected by the
componentwise absorption theorem. -/
theorem exists_exceptional_set_separating_leftover_of_short_path_handle_cover
    {V ι κ : Type*} [Fintype V] [Nonempty V] [Fintype ι] [Fintype κ]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (L : Finset V)
    {n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 6 ≤ (U i).card)
    (hθ : ∀ i, k - 5 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (src dst : κ → ι) (left right u v : κ → V)
    (h : ∀ a : κ, G.Walk (u a) (v a))
    (hsrcne : ∀ a, src a ≠ dst a)
    (hleft : ∀ a, left a ∈ U (src a))
    (hright : ∀ a, right a ∈ U (dst a))
    (hpath : ∀ a, (h a).IsPath) (hlen : ∀ a, (h a).length ≤ 2)
    (houtside : ∀ a w, w ∈ (h a).support →
      w ∉ U (src a) ∪ T (src a) ∧ w ∉ U (dst a) ∪ T (dst a))
    (hleftAdj : ∀ a, G.Adj (left a) (u a))
    (hrightAdj : ∀ a, G.Adj (v a) (right a))
    (hdisj : ∀ a b, a ≠ b → (h a).support.Disjoint (h b).support)
    (hcover : ∀ i j : ι, i ≠ j → ∀ x y : L,
      (G.induce (L : Set V)).Reachable x y →
      ∀ a ∈ U i, G.Adj x.1 a →
      ∀ b ∈ U j, G.Adj y.1 b →
      ∃ q : κ, src q = i ∧ dst q = j ∧ left q = a ∧ right q = b)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  obtain ⟨X, hXcard, hXsurvive⟩ :=
    exists_global_exceptional_set_forbidding_surviving_short_path_handles_of_cycleFree_robust_family
      G U T θ hk hrob hfree hUn hUk hθ hregions src dst left right u v h
      hsrcne hleft hright hpath hlen houtside hleftAdj hrightAdj hdisj hcycle
  refine ⟨X, hXcard, ?_⟩
  intro i j hij x y hxy
  rintro ⟨a, ha, hxa⟩ ⟨b, hb, hyb⟩
  obtain ⟨q, hsrc, hdst, hleftq, hrightq⟩ :=
    hcover i j hij x y hxy a (Finset.mem_sdiff.mp ha).1 hxa
      b (Finset.mem_sdiff.mp hb).1 hyb
  apply hXsurvive q
  · rw [hleftq]
    exact (Finset.mem_sdiff.mp ha).2
  · rw [hrightq]
    exact (Finset.mem_sdiff.mp hb).2

/-- Every vertex of a walk stays in any connected component containing its
initial vertex.  This elementary support-localization fact is useful when a
short handle is selected inside a leftover component: later disjointness
arguments may work only with the component labels, not with the chosen
walks themselves. -/
theorem walk_support_subset_of_start_mem_connectedComponent
    {V : Type*} (G : SimpleGraph V) (c : G.ConnectedComponent)
    {x y : V} (hx : x ∈ c.supp) (p : G.Walk x y) :
    ∀ z ∈ p.support, z ∈ c.supp := by
  induction p with
  | @nil x =>
      intro z hz
      have hzx : z = x := by simpa using hz
      simpa [hzx] using hx
  | @cons x w y hxw q ih =>
      intro z hz
      simp only [Walk.support_cons, List.mem_cons] at hz
      rcases hz with rfl | hz
      · exact hx
      · exact ih (c.mem_supp_of_adj_mem_supp hx hxw) z hz

/-- Supports of walks started in distinct connected components are disjoint.
In the KLS cleanup this is what makes one chosen short connector per
leftover component a pairwise-disjoint handle family. -/
theorem walk_support_disjoint_of_distinct_connectedComponents
    {V : Type*} (G : SimpleGraph V)
    {c d : G.ConnectedComponent} (hcd : c ≠ d)
    {x y u v : V} (hx : x ∈ c.supp) (hu : u ∈ d.supp)
    (p : G.Walk x y) (q : G.Walk u v) :
    p.support.Disjoint q.support := by
  rw [List.disjoint_left]
  intro z hzp hzq
  have hzc : z ∈ c.supp :=
    walk_support_subset_of_start_mem_connectedComponent G c hx p z hzp
  have hzd : z ∈ d.supp :=
    walk_support_subset_of_start_mem_connectedComponent G d hu q z hzq
  exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hzc hzd)

/-- Mapping component-local walks through a graph embedding preserves the
support disjointness supplied by distinct source components.  In particular,
paths chosen in distinct components of an induced leftover graph remain
disjoint after they are viewed as ambient handles. -/
theorem walk_map_support_disjoint_of_distinct_connectedComponents
    {W V : Type*} (H : SimpleGraph W) (G : SimpleGraph V)
    (e : H ↪g G) {c d : H.ConnectedComponent} (hcd : c ≠ d)
    {x y u v : W} (hx : x ∈ c.supp) (hu : u ∈ d.supp)
    (p : H.Walk x y) (q : H.Walk u v) :
    (p.map e.toHom).support.Disjoint (q.map e.toHom).support := by
  have hdis : p.support.Disjoint q.support :=
    walk_support_disjoint_of_distinct_connectedComponents H hcd hx hu p q
  rw [List.disjoint_left]
  intro z hzp hzq
  rw [Walk.support_map] at hzp hzq
  rcases List.mem_map.mp hzp with ⟨a, ha, haz⟩
  rcases List.mem_map.mp hzq with ⟨b, hb, hbz⟩
  have hab : a = b := e.injective (haz.trans hbz.symm)
  subst b
  exact (List.disjoint_left.mp hdis ha hb)

/-- The finite data carried by a leftover component which still sees two
distinct robust seeds.  Keeping the two attachment vertices and the two
leftover endpoints in one structure makes the later component selector
definitionally finite: the index type will be a subtype of the finite set of
connected components, while all witnesses are chosen from this structure. -/
structure CrossSeedAttachmentInComponent
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V)
    (c : (G.induce (L : Set V)).ConnectedComponent) where
  src : ι
  dst : ι
  src_ne_dst : src ≠ dst
  x : L
  y : L
  x_mem : x ∈ c.supp
  y_mem : y ∈ c.supp
  left : V
  right : V
  left_mem : left ∈ U src
  right_mem : right ∈ U dst
  left_adj : G.Adj x.1 left
  right_adj : G.Adj y.1 right

/-- After the repeated-attachment cleanup, one leftover component is allowed
at most one ordered cross-seed attachment pattern.  The endpoint vertices in
the leftover may vary, but the two seed labels and the two seed attachment
vertices are canonical. -/
def UniqueCrossSeedAttachmentsInComponents
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V) : Prop :=
  ∀ c : (G.induce (L : Set V)).ConnectedComponent,
    ∀ a b : CrossSeedAttachmentInComponent G U L c,
      a.src = b.src ∧ a.dst = b.dst ∧ a.left = b.left ∧ a.right = b.right

/-- The label-only part of canonical cross attachment: a leftover component
may see at most one ordered pair of distinct seeds.  The later one-core
routing lemma upgrades this to uniqueness of the actual attachment vertices. -/
def UniqueCrossSeedLabelsInComponents
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V) : Prop :=
  ∀ c : (G.induce (L : Set V)).ConnectedComponent,
    ∀ a b : CrossSeedAttachmentInComponent G U L c,
      a.src = b.src ∧ a.dst = b.dst

/-- Orientation-insensitive canonicality of a cross-seed attachment pattern.
The same leftover connector may of course be read backwards, so the useful
invariant identifies two witnesses either directly or after swapping both
seed labels and both attachment vertices. -/
def CanonicalCrossSeedAttachmentsInComponents
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V) : Prop :=
  ∀ c : (G.induce (L : Set V)).ConnectedComponent,
    ∀ a b : CrossSeedAttachmentInComponent G U L c,
      (a.src = b.src ∧ a.dst = b.dst ∧
          a.left = b.left ∧ a.right = b.right) ∨
        (a.src = b.dst ∧ a.dst = b.src ∧
          a.left = b.right ∧ a.right = b.left)

/-- Label-only orientation-insensitive canonicality.  This is the genuine
small-component stability invariant: a component may see one unordered pair
of seeds, with either orientation allowed when it is recorded as a handle. -/
def CanonicalCrossSeedLabelsInComponents
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V) : Prop :=
  ∀ c : (G.induce (L : Set V)).ConnectedComponent,
    ∀ a b : CrossSeedAttachmentInComponent G U L c,
      (a.src = b.src ∧ a.dst = b.dst) ∨
        (a.src = b.dst ∧ a.dst = b.src)

/-- Component-indexed short-handle cleanup.  If every leftover component has
diameter at most two and its cross-seed attachment pattern is canonical, then
the finite type of components carrying such a pattern supplies the handle
family required by the abstract cover theorem.  Distinct indices are
distinct components, so their mapped paths are automatically disjoint. -/
theorem exists_exceptional_set_separating_leftover_of_unique_short_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (L : Finset V)
    {n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 6 ≤ (U i).card)
    (hθ : ∀ i, k - 5 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hdiam : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∀ x y : L, x ∈ c.supp → y ∈ c.supp →
        ∃ p : (G.induce (L : Set V)).Walk x y,
          p.IsPath ∧ p.length ≤ 2)
    (hunique : UniqueCrossSeedAttachmentsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  let κ := {c : H.ConnectedComponent //
    Nonempty (CrossSeedAttachmentInComponent G U L c)}
  let : Fintype κ := Fintype.ofFinite κ
  let data : ∀ q : κ, CrossSeedAttachmentInComponent G U L q.1 :=
    fun q => Classical.choice q.2
  let pathH : ∀ q : κ, H.Walk (data q).x (data q).y :=
    fun q => Classical.choose (hdiam q.1 (data q).x (data q).y
      (data q).x_mem (data q).y_mem)
  have hpathH : ∀ q : κ, (pathH q).IsPath ∧ (pathH q).length ≤ 2 := by
    intro q
    exact Classical.choose_spec (hdiam q.1 (data q).x (data q).y
      (data q).x_mem (data q).y_mem)
  let e : H ↪g G := SimpleGraph.Embedding.induce (G := G) (L : Set V)
  let src : κ → ι := fun q => (data q).src
  let dst : κ → ι := fun q => (data q).dst
  let left : κ → V := fun q => (data q).left
  let right : κ → V := fun q => (data q).right
  let u : κ → V := fun q => e (data q).x
  let v : κ → V := fun q => e (data q).y
  let path : ∀ q : κ, G.Walk (u q) (v q) :=
    fun q => (pathH q).map e.toHom
  apply exists_exceptional_set_separating_leftover_of_short_path_handle_cover
    G U T θ L hk hrob hfree hUn hUk hθ hregions
    src dst left right u v path
  · intro q
    exact (data q).src_ne_dst
  · intro q
    exact (data q).left_mem
  · intro q
    exact (data q).right_mem
  · intro q
    exact (hpathH q).1.map e.injective
  · intro q
    simpa [path] using (hpathH q).2
  · intro q w hw
    dsimp [path] at hw
    rw [Walk.support_map] at hw
    rcases List.mem_map.mp hw with ⟨z, hz, rfl⟩
    have hzL : (z : V) ∈ L := z.property
    constructor
    · intro hzreg
      exact (Finset.disjoint_left.mp (hLregions (src q)) hzL hzreg)
    · intro hzreg
      exact (Finset.disjoint_left.mp (hLregions (dst q)) hzL hzreg)
  · intro q
    change G.Adj (data q).left (data q).x.1
    exact (data q).left_adj.symm
  · intro q
    change G.Adj (data q).y.1 (data q).right
    exact (data q).right_adj
  · intro q r hqr
    have hcomp : q.1 ≠ r.1 := by
      intro h
      apply hqr
      exact Subtype.ext h
    exact walk_map_support_disjoint_of_distinct_connectedComponents
      H G e hcomp (data q).x_mem (data r).x_mem (pathH q) (pathH r)
  · intro i j hij x y hxy a ha hxa b hb hyb
    let c : H.ConnectedComponent := H.connectedComponentMk x
    have hxmem : x ∈ c.supp := by
      exact SimpleGraph.ConnectedComponent.connectedComponentMk_mem
    have hymem : y ∈ c.supp := by
      change H.connectedComponentMk y = H.connectedComponentMk x
      exact (SimpleGraph.ConnectedComponent.sound hxy).symm
    let d : CrossSeedAttachmentInComponent G U L c :=
      { src := i
        dst := j
        src_ne_dst := hij
        x := x
        y := y
        x_mem := hxmem
        y_mem := hymem
        left := a
        right := b
        left_mem := ha
        right_mem := hb
        left_adj := hxa
        right_adj := hyb }
    let q : κ := ⟨c, ⟨d⟩⟩
    have hcan := hunique c (data q) d
    refine ⟨q, ?_, ?_, ?_, ?_⟩
    · change (data q).src = i
      simpa [d] using hcan.1
    · change (data q).dst = j
      simpa [d] using hcan.2.1
    · change (data q).left = a
      simpa [d] using hcan.2.2.1
    · change (data q).right = b
      simpa [d] using hcan.2.2.2
  · exact hcycle

/-- A connected component on at most three vertices has diameter at most two.
The proof chooses a simple path inside the component and counts its
duplicate-free support.  This is the concrete diameter hypothesis needed by
the component-indexed short-handle selector above. -/
theorem exists_path_length_le_two_in_small_induced_component
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (L : Finset V)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 3) :
    ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∀ x y : L, x ∈ c.supp → y ∈ c.supp →
        ∃ p : (G.induce (L : Set V)).Walk x y,
          p.IsPath ∧ p.length ≤ 2 := by
  classical
  intro c x y hx hy
  obtain ⟨p, hp⟩ := (c.reachable_of_mem_supp hx hy).exists_isPath
  refine ⟨p, hp, ?_⟩
  have hsupp : p.support.toFinset ⊆ c.supp.toFinset := by
    intro z hz
    have hz' : z ∈ p.support := List.mem_toFinset.mp hz
    exact Set.mem_toFinset.mpr
      (walk_support_subset_of_start_mem_connectedComponent
        (G.induce (L : Set V)) c hx p z hz')
  have hcard : p.support.toFinset.card ≤ c.supp.toFinset.card :=
    Finset.card_le_card hsupp
  have hc : c.supp.toFinset.card ≤ 3 := by
    rw [← Set.ncard_eq_toFinset_card']
    exact hsmall c
  rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support] at hcard
  omega

/-- Small-component specialization of the component-indexed cleanup.  The
separate diameter hypothesis disappears: cardinality at most three supplies
all short paths needed by the selector. -/
theorem exists_exceptional_set_separating_leftover_of_unique_small_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (L : Finset V)
    {n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 6 ≤ (U i).card)
    (hθ : ∀ i, k - 5 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 3)
    (hunique : UniqueCrossSeedAttachmentsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  apply exists_exceptional_set_separating_leftover_of_unique_short_components
    G U T θ L hk hrob hfree hUn hUk hθ hregions hLregions
  · exact exists_path_length_le_two_in_small_induced_component G L hsmall
  · exact hunique
  · exact hcycle

/-- One-vertex attachment cleanup.  An outside vertex cannot see two
different vertices of a large robust core in a `Cₖ`-free graph: route a
`k-2` path between the two core vertices and close it through the outside
vertex.  This is the local uniqueness input used when canonicalizing the
attachment pattern of a small leftover component. -/
theorem unique_attachment_in_large_robustPairSet_of_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n k : ℕ} (hk : 7 ≤ k)
    (hrob : RobustPairSet G U T θ)
    (hfree : G.IndepSetFree n) (hUn : n + 2 ≤ U.card)
    (hUk : k - 2 ≤ U.card) (hθ : k - 1 ≤ θ)
    {x a b : V} (hxoutside : x ∉ U ∪ T)
    (ha : a ∈ U) (hb : b ∈ U)
    (hxa : G.Adj x a) (hxb : G.Adj x b)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    a = b := by
  by_contra hab
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob hfree hUn ha hb hab
      (by omega) hUk (by omega)
  apply hcycle
  apply cycleGraph_isContained_of_path_and_fresh_commonNeighbor
    G (by omega) hp
  · omega
  · exact hxa.symm
  · exact hxb
  · intro hxpsupp
    rcases hploc x hxpsupp with hxU | hxT
    · exact hxoutside (Finset.mem_union_left _ hxU)
    · exact hxoutside (Finset.mem_union_right _ hxT)

/-- Degree form of one-core attachment uniqueness.  An outside vertex has at
most one neighbour in a large robust core, since two such neighbours would
close the routed `k-2` path from the preceding lemma. -/
theorem degreeIn_le_one_of_outside_large_robustPairSet_of_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n k : ℕ} (hk : 7 ≤ k)
    (hrob : RobustPairSet G U T θ)
    (hfree : G.IndepSetFree n) (hUn : n + 2 ≤ U.card)
    (hUk : k - 2 ≤ U.card) (hθ : k - 1 ≤ θ)
    {x : V} (hxoutside : x ∉ U ∪ T)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    degreeIn G U x ≤ 1 := by
  unfold degreeIn
  rw [Finset.card_le_one_iff]
  intro a b ha hb
  apply unique_attachment_in_large_robustPairSet_of_cycleFree
    G hk hrob hfree hUn hUk hθ hxoutside
  · exact (Finset.mem_filter.mp ha).1
  · exact (Finset.mem_filter.mp hb).1
  · exact (Finset.mem_filter.mp ha).2
  · exact (Finset.mem_filter.mp hb).2
  · exact hcycle

/-- Summed degree budget for vertices outside a family of disjoint robust
regions.  Each core contributes at most one neighbour by the preceding
one-core obstruction, so the whole selected-core union contributes at most
the number of seed labels.  No disjointness is needed for this upper bound:
overlaps only decrease the union cardinality. -/
theorem degreeIn_biUnion_le_card_of_outside_large_robustPairSet_family_of_cycleFree
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 7 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 2 ≤ (U i).card)
    (hθ : ∀ i, k - 1 ≤ θ i)
    {x : V} (hxoutside : ∀ i, x ∉ U i ∪ T i)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    degreeIn G ((Finset.univ : Finset ι).biUnion U) x ≤ Fintype.card ι := by
  classical
  let P : ι → Finset V := fun i => (U i).filter fun y => G.Adj x y
  have hsub :
      ((Finset.univ : Finset ι).biUnion U).filter (fun y => G.Adj x y) ⊆
        (Finset.univ : Finset ι).biUnion P := by
    intro y hy
    rcases Finset.mem_filter.mp hy with ⟨hyU, hxy⟩
    rcases Finset.mem_biUnion.mp hyU with ⟨i, hi, hyi⟩
    exact Finset.mem_biUnion.mpr
      ⟨i, hi, Finset.mem_filter.mpr ⟨hyi, hxy⟩⟩
  have hPcard : ∀ i ∈ (Finset.univ : Finset ι), (P i).card ≤ 1 := by
    intro i _hi
    simpa [P, degreeIn] using
      (degreeIn_le_one_of_outside_large_robustPairSet_of_cycleFree
        G hk (hrob i) hfree (hUn i) (hUk i) (hθ i) (hxoutside i) hcycle)
  unfold degreeIn
  calc
    (((Finset.univ : Finset ι).biUnion U).filter fun y => G.Adj x y).card ≤
        ((Finset.univ : Finset ι).biUnion P).card := Finset.card_le_card hsub
    _ ≤ (Finset.univ : Finset ι).card * 1 :=
      Finset.card_biUnion_le_card_mul _ _ _ hPcard
    _ = Fintype.card ι := by simp

/-- A leftover-side multi-seed vertex contributes two genuinely distinct
neighbours to the selected-core union.  Distinct seed labels together with
disjoint routing regions rule out the two displayed attachments being the
same vertex. -/
theorem two_le_degreeIn_biUnion_of_mem_multiSeedLeftoverFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    {x : V} (hx : x ∈ MultiSeedLeftoverFinset G U L) :
    2 ≤ degreeIn G ((Finset.univ : Finset ι).biUnion U) x := by
  classical
  rcases Finset.mem_filter.mp hx with
    ⟨_hxL, i, j, hij, ⟨a, haU, hxa⟩, b, hbU, hxb⟩
  have hUdisj : Disjoint (U i) (U j) :=
    (hregions i j hij).mono Finset.subset_union_left Finset.subset_union_left
  have hab : a ≠ b := by
    intro hab
    subst b
    exact (Finset.disjoint_left.mp hUdisj) haU hbU
  let S : Finset V := ((Finset.univ : Finset ι).biUnion U).filter fun y => G.Adj x y
  have haS : a ∈ S := by
    apply Finset.mem_filter.mpr
    refine ⟨?_, hxa⟩
    exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, haU⟩
  have hbS : b ∈ S := by
    apply Finset.mem_filter.mpr
    refine ⟨?_, hxb⟩
    exact Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hbU⟩
  have hpair : ({a, b} : Finset V) ⊆ S := by
    intro y hy
    simp only [Finset.mem_insert, Finset.mem_singleton] at hy
    rcases hy with rfl | rfl
    · exact haS
    · exact hbS
  unfold degreeIn
  calc
    2 = ({a, b} : Finset V).card := by simp [hab]
    _ ≤ S.card := Finset.card_le_card hpair
    _ = (((Finset.univ : Finset ι).biUnion U).filter fun y => G.Adj x y).card := rfl

/-- Degree sandwich for a multi-seed leftover vertex outside every robust
region: it sees at least two selected-core vertices by definition, but at
most one per core by the one-core cycle obstruction.  This is the exact
numerical interface used when the final absorption step charges such a
vertex to the finite seed family. -/
theorem degreeIn_biUnion_bounds_of_mem_multiSeedLeftoverFinset_of_cycleFree
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (L : Finset V)
    {n k : ℕ} (hk : 7 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 2 ≤ (U i).card)
    (hθ : ∀ i, k - 1 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    {x : V} (hxoutside : ∀ i, x ∉ U i ∪ T i)
    (hx : x ∈ MultiSeedLeftoverFinset G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    2 ≤ degreeIn G ((Finset.univ : Finset ι).biUnion U) x ∧
      degreeIn G ((Finset.univ : Finset ι).biUnion U) x ≤ Fintype.card ι := by
  exact ⟨two_le_degreeIn_biUnion_of_mem_multiSeedLeftoverFinset
      G U T L hregions hx,
    degreeIn_biUnion_le_card_of_outside_large_robustPairSet_family_of_cycleFree
      G U T θ hk hrob hfree hUn hUk hθ hxoutside hcycle⟩

/-- A short outside path between two attachment vertices closes against an
all-length route in one large robust core.  The robust route has the
complementary length `k - (q.length + 2)`, while the two displayed attachment
edges contribute the final two edges of the cycle. -/
theorem cycleGraph_isContained_of_large_robustPairSet_and_short_outside_handle
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n k : ℕ} (hk : 9 ≤ k)
    (hrob : RobustPairSet G U T θ)
    (hfree : G.IndepSetFree n) (hUn : n + 2 ≤ U.card)
    (hUk : k ≤ U.card) (hθ : k + 1 ≤ θ)
    {a b x y : V} (ha : a ∈ U) (hb : b ∈ U) (hab : a ≠ b)
    {q : G.Walk x y} (hq : q.IsPath) (hqlen : q.length ≤ 2)
    (hqoutside : ∀ w ∈ q.support, w ∉ U ∪ T)
    (hxa : G.Adj x a) (hyb : G.Adj y b) :
    cycleGraph k ⊑ G := by
  let ℓ : ℕ := k - (q.length + 2)
  have hℓ : 5 ≤ ℓ := by
    dsimp [ℓ]
    omega
  have hℓU : ℓ ≤ U.card := by
    dsimp [ℓ]
    omega
  have hℓθ : ℓ + 1 ≤ θ := by
    dsimp [ℓ]
    omega
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob hfree hUn ha hb hab
      hℓ hℓU hℓθ
  have hpq : p.support.Disjoint q.reverse.support := by
    rw [List.disjoint_left]
    intro w hwp hwq
    have hwq' : w ∈ q.support := by
      simpa [Walk.support_reverse] using hwq
    have hwreg : w ∈ U ∪ T := by
      rcases hploc w hwp with hwU | hwT
      · exact Finset.mem_union_left _ hwU
      · exact Finset.mem_union_right _ hwT
    exact hqoutside w hwq' hwreg
  apply cycleGraph_isContained_of_two_cross_edges_and_disjoint_paths
    G (by omega) hp hq.reverse hab hpq hyb.symm hxa
  rw [hplen]
  rw [Walk.length_reverse]
  dsimp [ℓ]
  omega

/-- Componentwise same-seed attachment uniqueness.  If two vertices in one
diameter-two leftover component see the same large robust core, they must see
the same core vertex; otherwise their short component path is the outside
handle in the preceding one-core cycle closure. -/
theorem equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} (L : Finset V) {θ n k : ℕ} (hk : 9 ≤ k)
    (hrob : RobustPairSet G U T θ)
    (hfree : G.IndepSetFree n) (hUn : n + 2 ≤ U.card)
    (hUk : k ≤ U.card) (hθ : k + 1 ≤ θ)
    (hLregion : Disjoint L (U ∪ T))
    (hdiam : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∀ x y : L, x ∈ c.supp → y ∈ c.supp →
        ∃ p : (G.induce (L : Set V)).Walk x y,
          p.IsPath ∧ p.length ≤ 2)
    {c : (G.induce (L : Set V)).ConnectedComponent}
    {x y : L} (hx : x ∈ c.supp) (hy : y ∈ c.supp)
    {a b : V} (ha : a ∈ U) (hb : b ∈ U)
    (hxa : G.Adj x.1 a) (hyb : G.Adj y.1 b)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    a = b := by
  by_contra hab
  obtain ⟨q, hq, hqlen⟩ := hdiam c x y hx hy
  let e : G.induce (L : Set V) ↪g G :=
    SimpleGraph.Embedding.induce (G := G) (L : Set V)
  let r : G.Walk (e x) (e y) := q.map e.toHom
  have hr : r.IsPath := hq.map e.injective
  have hrlen : r.length ≤ 2 := by simpa [r] using hqlen
  have hrout : ∀ w ∈ r.support, w ∉ U ∪ T := by
    intro w hw
    dsimp [r] at hw
    rw [Walk.support_map] at hw
    rcases List.mem_map.mp hw with ⟨z, hz, rfl⟩
    exact Finset.disjoint_left.mp hLregion z.property
  apply hcycle
  apply cycleGraph_isContained_of_large_robustPairSet_and_short_outside_handle
    G hk hrob hfree hUn hUk hθ ha hb hab hr hrlen hrout
  · change G.Adj x.1 a
    exact hxa
  · change G.Adj y.1 b
    exact hyb

/-- Label canonicality plus the one-core short-handle obstruction yields full
canonicality of cross-seed attachment data.  Once two cross attachments in a
component use the same ordered seed pair, their left attachments coincide by
routing in the first core and their right attachments coincide by routing in
the second core. -/
theorem uniqueCrossSeedAttachmentsInComponents_of_unique_labels
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 9 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hdiam : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∀ x y : L, x ∈ c.supp → y ∈ c.supp →
        ∃ p : (G.induce (L : Set V)).Walk x y,
          p.IsPath ∧ p.length ≤ 2)
    (hlabels : UniqueCrossSeedLabelsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    UniqueCrossSeedAttachmentsInComponents G U L := by
  intro c a b
  obtain ⟨hsrc, hdst⟩ := hlabels c a b
  have hleft : a.left = b.left := by
    apply equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
      G L hk (hrob a.src) hfree (hUn a.src) (hUk a.src) hθ
      (hLregions a.src) hdiam a.x_mem b.x_mem a.left_mem
    · simpa [hsrc] using b.left_mem
    · exact a.left_adj
    · exact b.left_adj
    · exact hcycle
  have hright : a.right = b.right := by
    apply equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
      G L hk (hrob a.dst) hfree (hUn a.dst) (hUk a.dst) hθ
      (hLregions a.dst) hdiam a.y_mem b.y_mem a.right_mem
    · simpa [hdst] using b.right_mem
    · exact a.right_adj
    · exact b.right_adj
    · exact hcycle
  exact ⟨hsrc, hdst, hleft, hright⟩

/-- Orientation-insensitive version of the preceding upgrade.  In the swapped
case, the left attachment of one witness is compared with the right
attachment of the other inside the same robust core, and conversely. -/
theorem canonicalCrossSeedAttachmentsInComponents_of_canonical_labels
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 9 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hdiam : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∀ x y : L, x ∈ c.supp → y ∈ c.supp →
        ∃ p : (G.induce (L : Set V)).Walk x y,
          p.IsPath ∧ p.length ≤ 2)
    (hlabels : CanonicalCrossSeedLabelsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    CanonicalCrossSeedAttachmentsInComponents G U L := by
  intro c a b
  rcases hlabels c a b with hsame | hswap
  · have hleft : a.left = b.left := by
      apply equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
        G L hk (hrob a.src) hfree (hUn a.src) (hUk a.src) hθ
        (hLregions a.src) hdiam a.x_mem b.x_mem a.left_mem
      · simpa [hsame.1] using b.left_mem
      · exact a.left_adj
      · exact b.left_adj
      · exact hcycle
    have hright : a.right = b.right := by
      apply equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
        G L hk (hrob a.dst) hfree (hUn a.dst) (hUk a.dst) hθ
        (hLregions a.dst) hdiam a.y_mem b.y_mem a.right_mem
      · simpa [hsame.2] using b.right_mem
      · exact a.right_adj
      · exact b.right_adj
      · exact hcycle
    exact Or.inl ⟨hsame.1, hsame.2, hleft, hright⟩
  · have hleft : a.left = b.right := by
      apply equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
        G L hk (hrob a.src) hfree (hUn a.src) (hUk a.src) hθ
        (hLregions a.src) hdiam a.x_mem b.y_mem a.left_mem
      · simpa [hswap.1] using b.right_mem
      · exact a.left_adj
      · exact b.right_adj
      · exact hcycle
    have hright : a.right = b.left := by
      apply equal_attachments_to_same_large_robustPairSet_on_short_component_of_cycleFree
        G L hk (hrob a.dst) hfree (hUn a.dst) (hUk a.dst) hθ
        (hLregions a.dst) hdiam a.y_mem b.x_mem a.right_mem
      · simpa [hswap.2] using b.left_mem
      · exact a.right_adj
      · exact b.left_adj
      · exact hcycle
    exact Or.inr ⟨hswap.1, hswap.2, hleft, hright⟩

/-- Orientation-insensitive component-indexed cleanup.  One arbitrary
orientation is chosen for each bad component.  Canonicality says every later
cross attachment agrees with that choice directly or after reversal, and in
either case the exceptional set meeting the chosen handle meets one of the
later attachment vertices as well. -/
theorem exists_exceptional_set_separating_leftover_of_canonical_short_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (L : Finset V)
    {n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 6 ≤ (U i).card)
    (hθ : ∀ i, k - 5 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hdiam : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      ∀ x y : L, x ∈ c.supp → y ∈ c.supp →
        ∃ p : (G.induce (L : Set V)).Walk x y,
          p.IsPath ∧ p.length ≤ 2)
    (hcanonical : CanonicalCrossSeedAttachmentsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  let κ := {c : H.ConnectedComponent //
    Nonempty (CrossSeedAttachmentInComponent G U L c)}
  let : Fintype κ := Fintype.ofFinite κ
  let data : ∀ q : κ, CrossSeedAttachmentInComponent G U L q.1 :=
    fun q => Classical.choice q.2
  let pathH : ∀ q : κ, H.Walk (data q).x (data q).y :=
    fun q => Classical.choose (hdiam q.1 (data q).x (data q).y
      (data q).x_mem (data q).y_mem)
  have hpathH : ∀ q : κ, (pathH q).IsPath ∧ (pathH q).length ≤ 2 := by
    intro q
    exact Classical.choose_spec (hdiam q.1 (data q).x (data q).y
      (data q).x_mem (data q).y_mem)
  let e : H ↪g G := SimpleGraph.Embedding.induce (G := G) (L : Set V)
  let src : κ → ι := fun q => (data q).src
  let dst : κ → ι := fun q => (data q).dst
  let left : κ → V := fun q => (data q).left
  let right : κ → V := fun q => (data q).right
  let u : κ → V := fun q => e (data q).x
  let v : κ → V := fun q => e (data q).y
  let path : ∀ q : κ, G.Walk (u q) (v q) :=
    fun q => (pathH q).map e.toHom
  obtain ⟨X, hXcard, hXmeet⟩ :=
    exists_global_exceptional_set_meeting_short_path_handles_of_cycleFree_robust_family
      G U T θ hk hrob hfree hUn hUk hθ hregions
      src dst left right u v path
      (fun q => (data q).src_ne_dst)
      (fun q => (data q).left_mem)
      (fun q => (data q).right_mem)
      (fun q => (hpathH q).1.map e.injective)
      (fun q => by simpa [path] using (hpathH q).2)
      (by
        intro q w hw
        dsimp [path] at hw
        rw [Walk.support_map] at hw
        rcases List.mem_map.mp hw with ⟨z, hz, rfl⟩
        have hzL : (z : V) ∈ L := z.property
        exact ⟨fun hzreg =>
            (Finset.disjoint_left.mp (hLregions (src q)) hzL hzreg),
          fun hzreg =>
            (Finset.disjoint_left.mp (hLregions (dst q)) hzL hzreg)⟩)
      (fun q => by
        change G.Adj (data q).left (data q).x.1
        exact (data q).left_adj.symm)
      (fun q => by
        change G.Adj (data q).y.1 (data q).right
        exact (data q).right_adj)
      (by
        intro q r hqr
        have hcomp : q.1 ≠ r.1 := by
          intro h
          apply hqr
          exact Subtype.ext h
        exact walk_map_support_disjoint_of_distinct_connectedComponents
          H G e hcomp (data q).x_mem (data r).x_mem (pathH q) (pathH r))
      hcycle
  refine ⟨X, hXcard, ?_⟩
  intro i j hij x y hxy
  rintro ⟨a, ha, hxa⟩ ⟨b, hb, hyb⟩
  let c : H.ConnectedComponent := H.connectedComponentMk x
  have hxmem : x ∈ c.supp :=
    SimpleGraph.ConnectedComponent.connectedComponentMk_mem
  have hymem : y ∈ c.supp := by
    change H.connectedComponentMk y = H.connectedComponentMk x
    exact (SimpleGraph.ConnectedComponent.sound hxy).symm
  let d : CrossSeedAttachmentInComponent G U L c :=
    { src := i
      dst := j
      src_ne_dst := hij
      x := x
      y := y
      x_mem := hxmem
      y_mem := hymem
      left := a
      right := b
      left_mem := (Finset.mem_sdiff.mp ha).1
      right_mem := (Finset.mem_sdiff.mp hb).1
      left_adj := hxa
      right_adj := hyb }
  let q : κ := ⟨c, ⟨d⟩⟩
  rcases hcanonical c (data q) d with hsame | hswap
  · rcases hXmeet q with hleftX | hrightX
    · exact (Finset.mem_sdiff.mp ha).2 (by
        change (data q).left ∈ X at hleftX
        rw [hsame.2.2.1] at hleftX
        simpa [d] using hleftX)
    · exact (Finset.mem_sdiff.mp hb).2 (by
        change (data q).right ∈ X at hrightX
        rw [hsame.2.2.2] at hrightX
        simpa [d] using hrightX)
  · rcases hXmeet q with hleftX | hrightX
    · exact (Finset.mem_sdiff.mp hb).2 (by
        change (data q).left ∈ X at hleftX
        rw [hswap.2.2.1] at hleftX
        simpa [d] using hleftX)
    · exact (Finset.mem_sdiff.mp ha).2 (by
        change (data q).right ∈ X at hrightX
        rw [hswap.2.2.2] at hrightX
        simpa [d] using hrightX)

/-- Correct orientation-insensitive small-component separation theorem.  A
component may present its one unordered seed pair in either order; robust
one-core routing upgrades that label information to canonical attachment
vertices, and the component-indexed cleanup then separates every surviving
trimmed core pair. -/
theorem exists_exceptional_set_separating_leftover_of_canonical_labels_small_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 3)
    (hlabels : CanonicalCrossSeedLabelsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  have hdiam := exists_path_length_le_two_in_small_induced_component G L hsmall
  have hcanonical : CanonicalCrossSeedAttachmentsInComponents G U L :=
    canonicalCrossSeedAttachmentsInComponents_of_canonical_labels
      G U T L (by omega) hrob hfree hUn hUk hθ hLregions hdiam hlabels hcycle
  apply exists_exceptional_set_separating_leftover_of_canonical_short_components
    G U T (fun _ : ι => θ) L hk hrob hfree hUn
  · intro i
    have := hUk i
    omega
  · intro i
    omega
  · exact hregions
  · exact hLregions
  · exact hdiam
  · exact hcanonical
  · exact hcycle

/-- Two distinct elements already exhaust a finite set of cardinality at most
two.  Hence any other distinct ordered pair in the set agrees with the first
pair directly or after swapping. -/
theorem eq_or_swap_of_mem_finset_card_le_two
    {α : Type*} [DecidableEq α] (S : Finset α)
    (hS : S.card ≤ 2) {a b c d : α}
    (hab : a ≠ b) (hcd : c ≠ d)
    (ha : a ∈ S) (hb : b ∈ S) (hc : c ∈ S) (hd : d ∈ S) :
    (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
  have hpair : ({a, b} : Finset α) ⊆ S := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact ha
    · exact hb
  have hpairCard : ({a, b} : Finset α).card = 2 := Finset.card_pair hab
  have hcard : S.card ≤ ({a, b} : Finset α).card := by
    rw [hpairCard]
    exact hS
  have hSeq : ({a, b} : Finset α) = S :=
    Finset.eq_of_subset_of_card_le hpair hcard
  rw [← hSeq] at hc hd
  simp only [Finset.mem_insert, Finset.mem_singleton] at hc hd
  rcases hc with rfl | rfl <;> rcases hd with rfl | rfl
  · exact (hcd rfl).elim
  · exact Or.inl ⟨rfl, rfl⟩
  · exact Or.inr ⟨rfl, rfl⟩
  · exact (hcd rfl).elim

/-- The finite set of robust seed labels seen by one leftover component. -/
noncomputable def ComponentSeedLabelFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V)
    (c : (G.induce (L : Set V)).ConnectedComponent) : Finset ι :=
  Finset.univ.filter fun i =>
    ∃ x : L, x ∈ c.supp ∧ ∃ a ∈ U i, G.Adj x.1 a

/-- If every leftover component sees at most two robust seed labels, then its
cross-seed labels are canonical up to orientation.  This is the exact finite
bridge from a small interaction component bound to the corrected cleanup
invariant. -/
theorem canonicalCrossSeedLabelsInComponents_of_componentSeedLabelFinset_card_le_two
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V)
    (hcard : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      (ComponentSeedLabelFinset G U L c).card ≤ 2) :
    CanonicalCrossSeedLabelsInComponents G U L := by
  classical
  intro c a b
  apply eq_or_swap_of_mem_finset_card_le_two
    (ComponentSeedLabelFinset G U L c) (hcard c)
    a.src_ne_dst b.src_ne_dst
  · simp only [ComponentSeedLabelFinset, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨a.x, a.x_mem, a.left, a.left_mem, a.left_adj⟩
  · simp only [ComponentSeedLabelFinset, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨a.y, a.y_mem, a.right, a.right_mem, a.right_adj⟩
  · simp only [ComponentSeedLabelFinset, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨b.x, b.x_mem, b.left, b.left_mem, b.left_adj⟩
  · simp only [ComponentSeedLabelFinset, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨b.y, b.y_mem, b.right, b.right_mem, b.right_adj⟩

/-- Fully concrete two-label small-component cleanup.  The only remaining
structural hypotheses are that leftover components have at most three
vertices and see at most two robust seed labels; all canonicality and handle
selection are now internal consequences. -/
theorem exists_exceptional_set_separating_leftover_of_two_seed_small_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 3)
    (htwo : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      (ComponentSeedLabelFinset G U L c).card ≤ 2)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  apply exists_exceptional_set_separating_leftover_of_canonical_labels_small_components
    G U T L hk hrob hfree hUn hUk hθ hregions hLregions hsmall
  · exact canonicalCrossSeedLabelsInComponents_of_componentSeedLabelFinset_card_le_two
      G U L htwo
  · exact hcycle

/-- After repeated-attachment deletion, one leftover vertex is allowed to
see at most one robust seed label. -/
def AtMostOneSeedLabelPerLeftoverVertex
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V) : Prop :=
  ∀ x : L, ∀ i j : ι, i ≠ j →
    (∃ a ∈ U i, G.Adj x.1 a) →
    (∃ b ∈ U j, G.Adj x.1 b) → False

/-- The genuinely leftover-side repeated-attachment set.  This is distinct
from `RepeatedAttachmentFinset`, whose vertices lie inside selected hub
cores: here we record vertices of the leftover set which see two different
seed labels.  Keeping the two objects separate avoids silently applying a
hub-core pruning statement to outside vertices. -/
noncomputable def MultiSeedLeftoverFinset_late
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V) : Finset V :=
  L.filter fun x =>
    ∃ i j : ι, i ≠ j ∧
      (∃ a ∈ U i, G.Adj x a) ∧
      ∃ b ∈ U j, G.Adj x b

/-- After deleting the actual leftover-side repeated attachments, every
surviving leftover vertex sees at most one seed label.  This is the precise
input required by the component label-counting lemma below. -/
theorem atMostOneSeedLabelPerLeftoverVertex_sdiff_multiSeedLeftoverFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V) :
    AtMostOneSeedLabelPerLeftoverVertex G U
      (L \ MultiSeedLeftoverFinset G U L) := by
  classical
  intro x i j hij hi hj
  have hxnot : x.1 ∉ MultiSeedLeftoverFinset G U L :=
    (Finset.mem_sdiff.mp x.property).2
  apply hxnot
  simp only [MultiSeedLeftoverFinset, Finset.mem_filter]
  exact ⟨(Finset.mem_sdiff.mp x.property).1, i, j, hij, hi, hj⟩

/-- The leftover-side repeated-attachment set is literally a subset of the
leftover.  This tiny bookkeeping fact is useful when its cardinality is
charged to the final absorption slack. -/
theorem multiSeedLeftoverFinset_subset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V) :
    MultiSeedLeftoverFinset G U L ⊆ L := by
  intro x hx
  exact (Finset.mem_filter.mp hx).1

/-- Close an exceptional leftover set under its neighbours inside the
leftover.  This is the finite one-step closure used before assigning all
exceptional vertices to one seed: after passing to the complement, no edge
can run from the exceptional side back into the surviving leftover. -/
noncomputable def LeftoverNeighborClosure
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (L E : Finset V) : Finset V :=
  E ∪ L.filter fun v => ∃ e ∈ E, G.Adj e v

/-- The neighbor closure stays inside the original leftover whenever the
exceptional seed set was already inside that leftover. -/
theorem leftoverNeighborClosure_subset
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {L E : Finset V} (hEL : E ⊆ L) :
    LeftoverNeighborClosure G L E ⊆ L := by
  intro v hv
  simp only [LeftoverNeighborClosure, Finset.mem_union, Finset.mem_filter] at hv
  rcases hv with hvE | ⟨hvL, _⟩
  · exact hEL hvE
  · exact hvL

/-- By construction, an exceptional vertex has no edge to a leftover vertex
outside the one-step neighbor closure.  This is the cross-edge vanishing
input for the constant exceptional assignment in the two-stage absorption
endpoint. -/
theorem no_edge_from_exceptional_to_sdiff_leftoverNeighborClosure
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (L E : Finset V) :
    ∀ e ∈ E, ∀ v ∈ L \ LeftoverNeighborClosure G L E,
      ¬ G.Adj e v := by
  intro e he v hv hev
  have hvL : v ∈ L := (Finset.mem_sdiff.mp hv).1
  have hvnot : v ∉ LeftoverNeighborClosure G L E :=
    (Finset.mem_sdiff.mp hv).2
  apply hvnot
  apply Finset.mem_union_right
  exact Finset.mem_filter.mpr ⟨hvL, e, he, hev⟩

/-- In a leftover whose induced components all have at most two vertices,
each leftover vertex has at most one leftover neighbour.  Pass to the
vertex's connected component, use `degree_lt_card_verts` there, and map the
component degree back to the induced ambient graph. -/
theorem degreeIn_le_one_of_components_card_le_two
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (L : Finset V)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    {e : V} (he : e ∈ L) :
    degreeIn G L e ≤ 1 := by
  classical
  let H : SimpleGraph L := G.induce (L : Set V)
  let c : H.ConnectedComponent := H.connectedComponentMk ⟨e, he⟩
  let ec : c :=
    ⟨⟨e, he⟩, SimpleGraph.ConnectedComponent.connectedComponentMk_mem⟩
  have hcardc : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  have hcsmall : Fintype.card c ≤ 2 := by
    rw [hcardc]
    exact hsmall c
  have hdeglt : H.degree ⟨e, he⟩ < 2 := by
    calc
      H.degree ⟨e, he⟩ = c.toSimpleGraph.degree ec := by
        symm
        exact Erdos752.degree_toSimpleGraph_eq H c ec
      _ < Fintype.card c := c.toSimpleGraph.degree_lt_card_verts ec
      _ ≤ 2 := hcsmall
  have hdegIn : degreeIn G L e < 2 := by
    rw [← degree_induce_finset_eq_degreeIn G L ⟨e, he⟩]
    simpa [H] using hdeglt
  omega

/-- The one-step leftover neighbor closure costs at most two vertices per
exceptional vertex when all leftover components have order at most two: one
vertex for the exception itself and at most one leftover neighbour. -/
theorem card_leftoverNeighborClosure_le_two_mul_of_components_card_le_two
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {L E : Finset V} (hEL : E ⊆ L)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2) :
    (LeftoverNeighborClosure G L E).card ≤ 2 * E.card := by
  classical
  let N : V → Finset V := fun e => L.filter fun v => G.Adj e v
  have hsub : LeftoverNeighborClosure G L E ⊆ E ∪ E.biUnion N := by
    intro v hv
    simp only [LeftoverNeighborClosure, Finset.mem_union, Finset.mem_filter] at hv
    rcases hv with hvE | ⟨hvL, e, he, hev⟩
    · exact Finset.mem_union_left _ hvE
    · apply Finset.mem_union_right
      exact Finset.mem_biUnion.mpr
        ⟨e, he, Finset.mem_filter.mpr ⟨hvL, hev⟩⟩
  have hNcard : ∀ e ∈ E, (N e).card ≤ 1 := by
    intro e he
    simpa [N, degreeIn] using
      (degreeIn_le_one_of_components_card_le_two G L hsmall (hEL he))
  calc
    (LeftoverNeighborClosure G L E).card ≤ (E ∪ E.biUnion N).card :=
      Finset.card_le_card hsub
    _ ≤ E.card + (E.biUnion N).card := Finset.card_union_le _ _
    _ ≤ E.card + E.card * 1 := by
      exact Nat.add_le_add_left
        (Finset.card_biUnion_le_card_mul E N 1 hNcard) _
    _ = 2 * E.card := by ring

/-- For two-vertex leftover components, the one-step neighbor closure is a
union of whole leftover components and is therefore anticomplete to its
complement.  If a newly added neighbour had another edge out of the closure,
it would have two distinct leftover neighbours, contradicting the checked
degree-at-most-one bound. -/
theorem no_edge_from_leftoverNeighborClosure_to_sdiff_of_components_card_le_two
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {L E : Finset V} (hEL : E ⊆ L)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2) :
    ∀ e ∈ LeftoverNeighborClosure G L E,
      ∀ v ∈ L \ LeftoverNeighborClosure G L E,
      ¬ G.Adj e v := by
  classical
  intro e he v hv hev
  have hvL : v ∈ L := (Finset.mem_sdiff.mp hv).1
  have hvnot : v ∉ LeftoverNeighborClosure G L E :=
    (Finset.mem_sdiff.mp hv).2
  simp only [LeftoverNeighborClosure, Finset.mem_union, Finset.mem_filter] at he
  rcases he with heE | ⟨heL, e₀, he₀E, he₀e⟩
  · exact no_edge_from_exceptional_to_sdiff_leftoverNeighborClosure
      G L E e heE v hv hev
  · have hdeg : degreeIn G L e ≤ 1 :=
      degreeIn_le_one_of_components_card_le_two G L hsmall heL
    unfold degreeIn at hdeg
    rw [Finset.card_le_one_iff] at hdeg
    have he₀mem : e₀ ∈ L.filter fun w => G.Adj e w := by
      exact Finset.mem_filter.mpr ⟨hEL he₀E, he₀e.symm⟩
    have hvmem : v ∈ L.filter fun w => G.Adj e w := by
      exact Finset.mem_filter.mpr ⟨hvL, hev⟩
    have heq : e₀ = v := hdeg he₀mem hvmem
    subst v
    apply hvnot
    exact Finset.mem_union_left _ he₀E

/-- Selected-core vertices adjacent to an exceptional set.  Removing this
finite set from every robust core makes the exceptional vertices compatible
with every remaining seed block, which is exactly what a constant
exceptional assignment needs. -/
noncomputable def CoreNeighborFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (E : Finset V) : Finset V :=
  E.biUnion fun e =>
    ((Finset.univ : Finset ι).biUnion U).filter fun a => G.Adj e a

/-- Once all exceptional core neighbours are deleted, no exceptional vertex
is adjacent to a surviving vertex of any selected core. -/
theorem no_edge_from_exceptional_to_sdiff_coreNeighborFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (E : Finset V) :
    ∀ e ∈ E, ∀ i : ι, ∀ a ∈ U i \ CoreNeighborFinset G U E,
      ¬ G.Adj e a := by
  classical
  intro e he i a ha hea
  apply (Finset.mem_sdiff.mp ha).2
  simp only [CoreNeighborFinset, Finset.mem_biUnion]
  refine ⟨e, he, ?_⟩
  apply Finset.mem_filter.mpr
  refine ⟨?_, hea⟩
  exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, (Finset.mem_sdiff.mp ha).1⟩

/-- A uniform degree bound into the selected-core union gives the same
uniform charge for the exceptional core-neighbour deletion. -/
theorem card_coreNeighborFinset_le_mul_of_degree_bound
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (E : Finset V) {q : ℕ}
    (hdeg : ∀ e ∈ E,
      degreeIn G ((Finset.univ : Finset ι).biUnion U) e ≤ q) :
    (CoreNeighborFinset G U E).card ≤ E.card * q := by
  classical
  unfold CoreNeighborFinset
  apply Finset.card_biUnion_le_card_mul
  intro e he
  simpa [degreeIn] using hdeg e he

/-- In the cycle-free robust setting, every exceptional vertex outside all
routing regions has at most one selected-core neighbour per seed.  Hence the
core-neighbour deletion costs at most `|E|·|seeds|`. -/
theorem card_coreNeighborFinset_le_mul_seed_card_of_cycleFree
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (E : Finset V)
    {n k : ℕ} (hk : 7 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 2 ≤ (U i).card)
    (hθ : ∀ i, k - 1 ≤ θ i)
    (houtside : ∀ e ∈ E, ∀ i, e ∉ U i ∪ T i)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (CoreNeighborFinset G U E).card ≤ E.card * Fintype.card ι := by
  apply card_coreNeighborFinset_le_mul_of_degree_bound G U E
  intro e he
  exact degreeIn_biUnion_le_card_of_outside_large_robustPairSet_family_of_cycleFree
    G U T θ hk hrob hfree hUn hUk hθ (houtside e he) hcycle

/-- If every leftover vertex sees at most one seed label, choosing one
representative leftover vertex for each label seen by a component is
injective.  Therefore the number of labels seen by the component is at most
the component order. -/
theorem card_componentSeedLabelFinset_le_component_card_of_atMostOneSeedLabelPerLeftoverVertex
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (U : ι → Finset V) (L : Finset V)
    (hone : AtMostOneSeedLabelPerLeftoverVertex G U L) :
    ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      (ComponentSeedLabelFinset G U L c).card ≤ c.supp.ncard := by
  classical
  intro c
  let S : Finset ι := ComponentSeedLabelFinset G U L c
  have hmem : ∀ i : S, ∃ x : L, x ∈ c.supp ∧
      ∃ a ∈ U i.1, G.Adj x.1 a := by
    intro i
    simpa [S, ComponentSeedLabelFinset] using i.2
  let witness : S → L := fun i => Classical.choose (hmem i)
  have hwitness : ∀ i : S, witness i ∈ c.supp ∧
      ∃ a ∈ U i.1, G.Adj (witness i).1 a := by
    intro i
    exact Classical.choose_spec (hmem i)
  let rep : S → c := fun i => ⟨witness i, (hwitness i).1⟩
  have hrep : Function.Injective rep := by
    intro i j hij
    by_contra hne
    have hijval : i.1 ≠ j.1 := by
      intro h
      apply hne
      exact Subtype.ext h
    have hwEq : witness i = witness j := by
      exact congrArg Subtype.val hij
    apply hone (witness i) i.1 j.1 hijval
    · exact (hwitness i).2
    · rcases (hwitness j).2 with ⟨b, hb, hbj⟩
      exact ⟨b, hb, by simpa [hwEq] using hbj⟩
  have hcard := Fintype.card_le_of_injective rep hrep
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  change S.card ≤ c.supp.ncard
  calc
    S.card = Fintype.card S := by simp
    _ ≤ Fintype.card c := hcard
    _ = c.supp.ncard := hcCard

/-- Two-vertex remainder specialization.  Once repeated-attachment deletion
ensures one seed label per leftover vertex, every component of order at most
two sees at most two labels, so the fully concrete cleanup theorem applies. -/
theorem exists_exceptional_set_separating_leftover_of_two_vertex_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    (hone : AtMostOneSeedLabelPerLeftoverVertex G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  apply exists_exceptional_set_separating_leftover_of_two_seed_small_components
    G U T L hk hrob hfree hUn hUk hθ hregions hLregions
  · intro c
    exact (hsmall c).trans (by omega)
  · intro c
    exact (card_componentSeedLabelFinset_le_component_card_of_atMostOneSeedLabelPerLeftoverVertex
      G U L hone c).trans (hsmall c)
  · exact hcycle

/-- Correct two-vertex cleanup after deleting the actual leftover-side
multi-seed vertices.  The hypothesis on component order is imposed only on
the surviving leftover, and the one-label condition is supplied
definitionally by `MultiSeedLeftoverFinset`.  This is the clean interface for
the later quantitative argument, which only has to bound the first deletion
and prove the two-vertex component estimate. -/
theorem exists_exceptional_set_separating_leftover_after_multiSeedDeletion
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c :
      (G.induce ((L \ MultiSeedLeftoverFinset G U L : Finset V) : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j →
        ∀ x y : (L \ MultiSeedLeftoverFinset G U L : Finset V),
        (G.induce ((L \ MultiSeedLeftoverFinset G U L : Finset V) : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  let L' : Finset V := L \ MultiSeedLeftoverFinset G U L
  apply exists_exceptional_set_separating_leftover_of_two_vertex_components
    G U T L' hk hrob hfree hUn hUk hθ hregions
  · intro i
    exact (hLregions i).mono Finset.sdiff_subset Finset.Subset.rfl
  · simpa [L'] using hsmall
  · simpa [L'] using
      (atMostOneSeedLabelPerLeftoverVertex_sdiff_multiSeedLeftoverFinset G U L)
  · exact hcycle

/-- A two-vertex remainder bounds the actual leftover-side multi-seed
deletion by `2(n-1)`: the deletion is a subset of the remainder, while the
component partition count bounds the whole remainder. -/
theorem card_multiSeedLeftoverFinset_le_two_mul_pred_of_two_vertex_components
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V) {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2) :
    (MultiSeedLeftoverFinset G U L).card ≤ 2 * (n - 1) := by
  calc
    (MultiSeedLeftoverFinset G U L).card ≤ L.card :=
      Finset.card_le_card (multiSeedLeftoverFinset_subset G U L)
    _ ≤ 2 * (n - 1) :=
      card_le_two_mul_pred_of_indepSetFree_of_components_card_le_two G hfree hsmall

/-- Quantitative two-vertex cleanup in the form needed by absorption.  The
original remainder has at most two vertices per component; consequently the
multi-seed exceptional part costs at most `2(n-1)`, and after deleting it a
second exceptional set of size at most the square of the seed count
separates all surviving trimmed robust cores. -/
theorem bounded_multiSeedDeletion_and_separation_of_two_vertex_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (MultiSeedLeftoverFinset G U L).card ≤ 2 * (n - 1) ∧
      ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
        ∀ i j : ι, i ≠ j →
          ∀ x y : (L \ MultiSeedLeftoverFinset G U L : Finset V),
          (G.induce ((L \ MultiSeedLeftoverFinset G U L : Finset V) : Set V)).Reachable x y →
          (∃ a ∈ U i \ X, G.Adj x.1 a) →
          (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  constructor
  · exact card_multiSeedLeftoverFinset_le_two_mul_pred_of_two_vertex_components
      G U L hfree hsmall
  · apply exists_exceptional_set_separating_leftover_after_multiSeedDeletion
      G U T L hk hrob hfree hUn hUk hθ hregions hLregions
    · exact component_card_le_two_after_multiSeedLeftoverDeletion G U L hsmall
    · exact hcycle

/-- The multi-seed set together with its one-step leftover-neighbour closure
costs at most `4(n-1)` vertices in a two-vertex remainder. -/
theorem card_multiSeed_leftoverNeighborClosure_le_four_mul_pred
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (L : Finset V) {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2) :
    (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L)).card ≤
      4 * (n - 1) := by
  have hE₀L : MultiSeedLeftoverFinset G U L ⊆ L :=
    multiSeedLeftoverFinset_subset G U L
  have hclosure :=
    card_leftoverNeighborClosure_le_two_mul_of_components_card_le_two
      G hE₀L hsmall
  have hmulti :=
    card_multiSeedLeftoverFinset_le_two_mul_pred_of_two_vertex_components
      G U L hfree hsmall
  calc
    (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L)).card ≤
        2 * (MultiSeedLeftoverFinset G U L).card := hclosure
    _ ≤ 2 * (2 * (n - 1)) := Nat.mul_le_mul_left 2 hmulti
    _ = 4 * (n - 1) := by ring

/-- The core-neighbour deletion of the closed multi-seed exceptional set has
the explicit charge `4(n-1)|ι|`.  Every closure vertex remains in the
leftover, hence outside all robust routing regions; the one-core degree
obstruction then supplies the per-seed bound. -/
theorem card_coreNeighborFinset_of_multiSeed_closure_le_four_mul_pred_mul_seed_card
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (CoreNeighborFinset G U
      (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L))).card ≤
      4 * (n - 1) * Fintype.card ι := by
  let E₀ : Finset V := MultiSeedLeftoverFinset G U L
  let E : Finset V := LeftoverNeighborClosure G L E₀
  have hE₀L : E₀ ⊆ L := by
    simpa [E₀] using (multiSeedLeftoverFinset_subset G U L)
  have hEL : E ⊆ L := by
    simpa [E] using (leftoverNeighborClosure_subset G hE₀L)
  have hY := card_coreNeighborFinset_le_mul_seed_card_of_cycleFree
    G U T (fun _ : ι => θ) E (by omega) hrob hfree hUn
    (fun i => by have := hUk i; omega)
    (fun _ => by omega)
    (by
      intro e he i hei
      exact (Finset.disjoint_left.mp (hLregions i)) (hEL he) hei)
    hcycle
  have hEcard : E.card ≤ 4 * (n - 1) := by
    simpa [E₀, E] using
      (card_multiSeed_leftoverNeighborClosure_le_four_mul_pred
        G U L hfree hsmall)
  calc
    (CoreNeighborFinset G U
      (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L))).card =
        (CoreNeighborFinset G U E).card := by rfl
    _ ≤ E.card * Fintype.card ι := hY
    _ ≤ (4 * (n - 1)) * Fintype.card ι :=
      Nat.mul_le_mul_right _ hEcard
    _ = 4 * (n - 1) * Fintype.card ι := by rfl

/-- Deleting two finite exceptional sets cannot empty a set whose order is
strictly larger than the sum of their cardinalities.  This elementary
survival lemma is the arithmetic form used for twice-trimmed robust cores. -/
theorem nonempty_sdiff_sdiff_of_card_add_lt
    {V : Type*} [Fintype V]
    (U X Y : Finset V) (hcharge : X.card + Y.card < U.card) :
    ((U \ X) \ Y).Nonempty := by
  have hretX : U.card - X.card ≤ (U \ X).card :=
    sub_le_card_sdiff_of_le_card_of_card_le le_rfl le_rfl
  have hretY : (U.card - X.card) - Y.card ≤ ((U \ X) \ Y).card :=
    sub_le_card_sdiff_of_le_card_of_card_le hretX le_rfl
  apply Finset.card_pos.mp
  have hpos : 0 < (U.card - X.card) - Y.card := by omega
  exact hpos.trans_le hretY

/-- Numerical survival of every selected core after the square separator and
the closed multi-seed core-neighbour deletion.  The displayed budget is the
only input: `|ι|² + 4(n-1)|ι|` must fit below the core order. -/
theorem selected_core_survives_multiSeed_cleanup
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L X : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hX : X.card ≤ (Fintype.card ι) ^ 2)
    (hbudget : ∀ i,
      (Fintype.card ι) ^ 2 + 4 * (n - 1) * Fintype.card ι < (U i).card) :
    ∀ i, ((U i \ X) \ CoreNeighborFinset G U
      (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L))).Nonempty := by
  have hY :=
    card_coreNeighborFinset_of_multiSeed_closure_le_four_mul_pred_mul_seed_card
      G U T L hk hrob hfree hUn hUk hθ hLregions hsmall hcycle
  intro i
  apply nonempty_sdiff_sdiff_of_card_add_lt
  have hcharge : X.card +
      (CoreNeighborFinset G U
        (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L))).card <
      (U i).card := by
    calc
      X.card +
          (CoreNeighborFinset G U
            (LeftoverNeighborClosure G L (MultiSeedLeftoverFinset G U L))).card ≤
          (Fintype.card ι) ^ 2 + 4 * (n - 1) * Fintype.card ι :=
        Nat.add_le_add hX hY
      _ < (U i).card := hbudget i
  exact hcharge

/-- Full two-vertex cleanup endpoint.  Starting from the canonical
multi-seed deletion, close it under leftover neighbours, delete every
selected-core neighbour of that closure, and use separation monotonicity for
the surviving remainder.  The explicit `hready` input is only the remaining
quantitative stability bookkeeping: after these displayed deletions, the
trimmed blocks must stay nonempty, anticomplete, covering, and below the
`k-1` capacity. -/
theorem completeStablePartition_of_two_vertex_multiSeed_cleanup
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 2)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hready : ∀ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 →
      let E₀ : Finset V := MultiSeedLeftoverFinset G U L
      let E : Finset V := LeftoverNeighborClosure G L E₀
      let Y : Finset V := CoreNeighborFinset G U E
      let B : ι → Finset V := fun i => (U i \ X) \ Y
      let L' : Finset V := L \ E
      (∀ i, (B i).Nonempty) ∧
        (∀ i j, i ≠ j → ∀ a ∈ B i, ∀ b ∈ B j, ¬ G.Adj a b) ∧
        (∀ v : V, v ∈ E ∨ v ∈ L' ∨ ∃ i : ι, v ∈ B i) ∧
        ∀ i : ι, (B i).card + E.card + L'.card ≤ k - 1) :
    CompleteStablePartition G k := by
  obtain ⟨_hE₀card, X, hX, hsep₀⟩ :=
    bounded_multiSeedDeletion_and_separation_of_two_vertex_components
      G U T L hk hrob hfree hUn hUk hθ hregions hLregions hsmall hcycle
  let E₀ : Finset V := MultiSeedLeftoverFinset G U L
  let E : Finset V := LeftoverNeighborClosure G L E₀
  let Y : Finset V := CoreNeighborFinset G U E
  let B : ι → Finset V := fun i => (U i \ X) \ Y
  let L' : Finset V := L \ E
  obtain ⟨hBne, hBanti, hcover, hslack⟩ := hready X hX
  have hE₀L : E₀ ⊆ L := by
    simpa [E₀] using (multiSeedLeftoverFinset_subset G U L)
  have hELsub : E ⊆ L := by
    simpa [E] using (leftoverNeighborClosure_subset G hE₀L)
  apply completeStablePartition_of_seed_blocks_anticomplete_exceptional_and_separated_leftover_of_global_slack
    G B E L' hBne
  · intro i j hij
    rw [Finset.disjoint_left]
    intro v hvi hvj
    have hviU : v ∈ U i := (Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hvi).1).1
    have hvjU : v ∈ U j := (Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hvj).1).1
    have hUdisj : Disjoint (U i) (U j) :=
      (hregions i j hij).mono Finset.subset_union_left Finset.subset_union_left
    exact (Finset.disjoint_left.mp hUdisj) hviU hvjU
  · intro i
    rw [Finset.disjoint_left]
    intro v hvB hvE
    have hvU : v ∈ U i := (Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hvB).1).1
    exact (Finset.disjoint_left.mp (hLregions i)) (hELsub hvE)
      (Finset.mem_union_left _ hvU)
  · intro i
    rw [Finset.disjoint_left]
    intro v hvB hvL'
    have hvU : v ∈ U i := (Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hvB).1).1
    have hvL : v ∈ L := (Finset.mem_sdiff.mp hvL').1
    exact (Finset.disjoint_left.mp (hLregions i)) hvL
      (Finset.mem_union_left _ hvU)
  · rw [Finset.disjoint_left]
    intro v hvE hvL'
    exact (Finset.mem_sdiff.mp hvL').2 hvE
  · exact hBanti
  · exact hcover
  · apply leftover_separation_mono G (fun i => U i \ X) B (L \ E₀) L'
    · intro v hvL'
      have hvL : v ∈ L := (Finset.mem_sdiff.mp hvL').1
      have hvnotE : v ∉ E := (Finset.mem_sdiff.mp hvL').2
      apply Finset.mem_sdiff.mpr
      refine ⟨hvL, ?_⟩
      intro hvE₀
      apply hvnotE
      change v ∈ LeftoverNeighborClosure G L E₀
      exact Finset.mem_union_left _ hvE₀
    · intro i v hv
      exact (Finset.mem_sdiff.mp hv).1
    · simpa [E₀] using hsep₀
  · intro e he i b hb
    have hbUY : b ∈ U i \ Y := by
      exact Finset.mem_sdiff.mpr
        ⟨(Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hb).1).1,
          (Finset.mem_sdiff.mp hb).2⟩
    exact no_edge_from_exceptional_to_sdiff_coreNeighborFinset
      G U E e he i b hbUY
  · intro e he v hv
    have hanti :=
      no_edge_from_leftoverNeighborClosure_to_sdiff_of_components_card_le_two
        G hE₀L hsmall
    exact hanti e (by simpa [E] using he) v (by simpa [L', E] using hv)
  · exact hslack

/-- Small-component separation with only label canonicality as an input.
The one-core short-handle obstruction first upgrades labels to full
attachment canonicality; the component-indexed cleanup then deletes at most
one vertex per ordered seed pair and separates all surviving trimmed cores. -/
theorem exists_exceptional_set_separating_leftover_of_unique_labels_small_components
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (L : Finset V) {θ n k : ℕ} (hk : 15 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k ≤ (U i).card)
    (hθ : k + 1 ≤ θ)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hLregions : ∀ i, Disjoint L (U i ∪ T i))
    (hsmall : ∀ c : (G.induce (L : Set V)).ConnectedComponent,
      c.supp.ncard ≤ 3)
    (hlabels : UniqueCrossSeedLabelsInComponents G U L)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      ∀ i j : ι, i ≠ j → ∀ x y : L,
        (G.induce (L : Set V)).Reachable x y →
        (∃ a ∈ U i \ X, G.Adj x.1 a) →
        (∃ b ∈ U j \ X, G.Adj y.1 b) → False := by
  have hdiam := exists_path_length_le_two_in_small_induced_component G L hsmall
  have hunique : UniqueCrossSeedAttachmentsInComponents G U L :=
    uniqueCrossSeedAttachmentsInComponents_of_unique_labels
      G U T L (by omega) hrob hfree hUn hUk hθ hLregions hdiam hlabels hcycle
  apply exists_exceptional_set_separating_leftover_of_unique_small_components
    G U T (fun _ : ι => θ) L hk hrob hfree hUn
  · intro i
    have := hUk i
    omega
  · intro i
    omega
  · exact hregions
  · exact hLregions
  · exact hsmall
  · exact hunique
  · exact hcycle

/-- Exact cleanup specialization of the two length-two-handle splice.  One
large robust seed routes through `k-6`, the second contributes a two-edge
route, and two distinct outside connectors therefore force `Cₖ`. -/
theorem cycleGraph_isContained_of_two_robustPairSets_all_lengths_short_second_twoEdge_handles
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 11 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d x y : V}
    (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d)
    (hx₁ : x ∉ U₁ ∪ T₁) (hx₂ : x ∉ U₂ ∪ T₂)
    (hy₁ : y ∉ U₁ ∪ T₁) (hy₂ : y ∉ U₂ ∪ T₂) (hxy : x ≠ y)
    (hbx : G.Adj b x) (hxc : G.Adj x c)
    (hdy : G.Adj d y) (hya : G.Adj y a)
    (hU₁ : k - 6 ≤ U₁.card) (hθ₁ : k - 5 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂) :
    cycleGraph k ⊑ G := by
  apply cycleGraph_isContained_of_two_robustPairSets_all_lengths_twoEdge_handles
    G (by omega) hrob₁ hrob₂ hfree hU₁n hregions ha hb hc hd hab hcd
      hx₁ hx₂ hy₁ hy₂ hxy hbx hxc hdy hya (ℓ := k - 6) (s := 0)
  · omega
  · exact hU₁
  · have hsub : (k - 6) + 1 = k - 5 := by omega
    rw [hsub]
    exact hθ₁
  · simpa using hU₂
  · simpa using hθ₂
  · omega

/-- Contrapositive short-handle obstruction.  In a `Cₖ`-free graph, two
outside length-two connectors between the same robust regions cannot have
distinct middle vertices and distinct attachments at both ends.  Hence one
side repeats an attachment, or the two connectors are actually the same
outside vertex; this is the local deletion alternative used by remainder
cleanup. -/
theorem repeated_attachment_or_same_middle_of_cycleFree_two_robustPairSets_twoEdge_handles
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 11 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d x y : V}
    (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hx₁ : x ∉ U₁ ∪ T₁) (hx₂ : x ∉ U₂ ∪ T₂)
    (hy₁ : y ∉ U₁ ∪ T₁) (hy₂ : y ∉ U₂ ∪ T₂)
    (hbx : G.Adj b x) (hxc : G.Adj x c)
    (hdy : G.Adj d y) (hya : G.Adj y a)
    (hU₁ : k - 6 ≤ U₁.card) (hθ₁ : k - 5 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    a = b ∨ c = d ∨ x = y := by
  by_cases hab : a = b
  · exact Or.inl hab
  by_cases hcd : c = d
  · exact Or.inr (Or.inl hcd)
  by_cases hxy : x = y
  · exact Or.inr (Or.inr hxy)
  exfalso
  apply hcycle
  exact cycleGraph_isContained_of_two_robustPairSets_all_lengths_short_second_twoEdge_handles
    G hk hrob₁ hrob₂ hfree hU₁n hregions ha hb hc hd hab hcd
      hx₁ hx₂ hy₁ hy₂ hxy hbx hxc hdy hya hU₁ hθ₁ hU₂ hθ₂

/-- Exact-length two-hub cleanup with the second route fixed at length two.
Once one robust region can route every length through k-4 and a second
region supplies one two-edge return route, two handles already force Ck. -/
theorem cycleGraph_isContained_of_two_robustPairSets_all_lengths_short_second
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 9 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a b c d : V} (ha : a ∈ U₁) (hb : b ∈ U₁) (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hab : a ≠ b) (hcd : c ≠ d) (hbc : G.Adj b c) (hda : G.Adj d a)
    (hU₁ : k - 4 ≤ U₁.card) (hθ₁ : k - 3 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂) :
    cycleGraph k ⊑ G := by
  apply cycleGraph_isContained_of_two_disjoint_robustPairSets_all_lengths
    G (by omega) hrob₁ hrob₂ hfree hU₁n hregions ha hb hc hd
      hab hcd hbc hda (ℓ := k - 4) (s := 0)
  · omega
  · exact hU₁
  · have hk4 : 4 ≤ k := by omega
    have hsub : (k - 4) + 1 = k - 3 := by omega
    rw [hsub]
    exact hθ₁
  · simpa using hU₂
  · simpa using hθ₂
  · omega

/-- Source-faithful two-hub splice with an explicit parity-breaking edge in
the first hub.  This is the version used for subcritical hubs: the edge is
chosen from a matching away from the four handle endpoints, and no hub-size
comparison with n is required. -/
theorem cycleGraph_isContained_of_two_disjoint_robustPairSets_parity_edge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ ℓ s k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {a x y b c d : V}
    (ha : a ∈ U₁) (hx : x ∈ U₁) (hy : y ∈ U₁) (hb : b ∈ U₁)
    (hc : c ∈ U₂) (hd : d ∈ U₂)
    (hxy : G.Adj x y) (hax : a ≠ x) (hay : a ≠ y) (hab : a ≠ b)
    (hxb : x ≠ b) (hyb : y ≠ b) (hcd : c ≠ d)
    (hbc : G.Adj b c) (hda : G.Adj d a)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hlen : ℓ + 2 * (s + 1) + 2 = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨p, hp, hplen, hploc⟩ :=
    exists_path_between_of_robustPairSet_and_parity_edge G hrob₁
      ha hx hy hb hxy hax hay hab hxb hyb hℓ hℓU hℓθ
  obtain ⟨q, hq, hqlen, _hqavoid, hqloc⟩ :=
    exists_even_path_between_of_robustPairSet_avoiding G (F := ∅) (r := s)
      hrob₂ hc hd (by simp) (by simp) hcd (by simpa) (by simpa using hθ₂)
  have hdisj : p.support.Disjoint q.support := by
    intro v hvp hvq
    have hv₁ : v ∈ U₁ ∪ T₁ := by
      rcases hploc v hvp with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    have hv₂ : v ∈ U₂ ∪ T₂ := by
      rcases hqloc v hvq with hv | hv
      · exact Finset.mem_union_left _ hv
      · exact Finset.mem_union_right _ hv
    exact Finset.disjoint_left.mp hregions hv₁ hv₂
  apply cycleGraph_isContained_of_two_cross_edges_and_disjoint_paths G hk hp hq hab
    hdisj hbc hda
  omega

/-- Between two finite vertex sets, every two cross-edges share an endpoint.
This is the finite sparse-interaction predicate used for the auxiliary graph
of hubs. -/
def AtMostOneCrossEdge
    {V : Type*} (G : SimpleGraph V) (A B : Finset V) : Prop :=
  ∀ a ∈ A, ∀ b ∈ B, ∀ a' ∈ A, ∀ b' ∈ B,
    G.Adj a b → G.Adj a' b' → a = a' ∨ b = b'

/-- The auxiliary graph on a family of hub cores: two indices are adjacent
when the corresponding cores have at least one cross-edge in the original
graph. -/
def HubInteractionGraph {V ι : Type*} (G : SimpleGraph V)
    (U : ι → Finset V) : SimpleGraph ι :=
  SimpleGraph.fromRel fun i j => ∃ a ∈ U i, ∃ b ∈ U j, G.Adj a b

/-- A triangle in an auxiliary graph, with the three vertices displayed in
cyclic order. -/
def HasHubInteractionTriangle {ι : Type*} (H : SimpleGraph ι) : Prop :=
  ∃ i j ℓ : ι, i ≠ j ∧ i ≠ ℓ ∧ j ≠ ℓ ∧
    H.Adj i j ∧ H.Adj j ℓ ∧ H.Adj ℓ i

/-- An edge of the hub interaction graph comes from an actual ambient
cross-edge in the displayed order. -/
theorem exists_cross_edge_of_hubInteractionGraph_adj
    {V ι : Type*} (G : SimpleGraph V) (U : ι → Finset V)
    {i j : ι} (hij : (HubInteractionGraph G U).Adj i j) :
    ∃ a ∈ U i, ∃ b ∈ U j, G.Adj a b := by
  rw [HubInteractionGraph, SimpleGraph.fromRel_adj] at hij
  rcases hij with ⟨_hij, hforward | hbackward⟩
  · exact hforward
  · rcases hbackward with ⟨b, hb, a, ha, hba⟩
    exact ⟨a, ha, b, hb, hba.symm⟩

/-- Orient one ambient cross-edge along every step of an ordinary
hub-interaction walk.  No freshness is asserted: repeated attachments are
handled later by zero-length local routes on the short BFS-return part. -/
theorem exists_cross_edges_along_hubInteraction_walk
    {V ι : Type*} (G : SimpleGraph V) (U : ι → Finset V)
    {u v : ι} (w : (HubInteractionGraph G U).Walk u v) :
    ∃ p q : Fin w.length → V,
      ∀ i : Fin w.length,
        p i ∈ U (w.getVert i.val) ∧
        q i ∈ U (w.getVert (i.val + 1)) ∧
        G.Adj (p i) (q i) := by
  classical
  have hstep : ∀ i : Fin w.length,
      (HubInteractionGraph G U).Adj
        (w.getVert i.val) (w.getVert (i.val + 1)) := by
    intro i
    exact w.adj_getVert_succ i.isLt
  choose p hp q hq hpq using fun i : Fin w.length =>
    exists_cross_edge_of_hubInteractionGraph_adj G U (hstep i)
  exact ⟨p, q, fun i => ⟨hp i, hq i, hpq i⟩⟩

/-- Convert oriented ambient edges on the steps of a nonempty closed
auxiliary walk into incoming/outgoing attachment arrays on its vertex
visits.  This purely index-theoretic predecessor rotation is shared by the
fully fresh and mixed selected/BFS lifts. -/
theorem exists_cyclic_attachments_of_oriented_edges_along_closed_walk
    {V ι : Type*} (G : SimpleGraph V) (H : SimpleGraph ι)
    (U : ι → Finset V) {u : ι} (w : H.Walk u u)
    (hlen : 0 < w.length)
    (p q : Fin w.length → V)
    (hpq : ∀ i : Fin w.length,
      p i ∈ U (w.getVert i.val) ∧
      q i ∈ U (w.getVert (i.val + 1)) ∧
      G.Adj (p i) (q i)) :
    ∃ a b : Fin w.length → V,
      (∀ i, a i ∈ U (w.getVert i.val)) ∧
      (∀ i, b i ∈ U (w.getVert i.val)) ∧
      (∀ i j : Fin w.length, j.val = i.val + 1 →
        G.Adj (b i) (a j)) ∧
      (∀ i j : Fin w.length, i.val + 1 = w.length → j.val = 0 →
        G.Adj (b i) (a j)) ∧
      ∀ i : Fin w.length, i.val ≠ 0 →
        a i = q ⟨i.val - 1, by omega⟩ ∧ b i = p i := by
  classical
  let lastEdge : Fin w.length := ⟨w.length - 1, by omega⟩
  let pred : Fin w.length → Fin w.length := fun i =>
    if hi : i.val = 0 then lastEdge else ⟨i.val - 1, by omega⟩
  have hpredZero : ∀ i : Fin w.length, i.val = 0 → pred i = lastEdge := by
    intro i hi
    simp [pred, hi]
  have hpredPos : ∀ i : Fin w.length, i.val ≠ 0 →
      (pred i).val = i.val - 1 := by
    intro i hi
    simp [pred, hi]
  let a : Fin w.length → V := fun i => q (pred i)
  let b : Fin w.length → V := p
  have ha : ∀ i, a i ∈ U (w.getVert i.val) := by
    intro i
    by_cases hi : i.val = 0
    · have hq := (hpq lastEdge).2.1
      have hend : w.getVert (lastEdge.val + 1) = w.getVert i.val := by
        rw [show lastEdge.val + 1 = w.length by
          dsimp [lastEdge]
          omega]
        simp [hi]
      simpa [a, hpredZero i hi, hend] using hq
    · have hpredVal : (pred i).val + 1 = i.val := by
        rw [hpredPos i hi]
        omega
      have hq := (hpq (pred i)).2.1
      simpa [a, hpredVal] using hq
  have hb : ∀ i, b i ∈ U (w.getVert i.val) := by
    intro i
    exact (hpq i).1
  refine ⟨a, b, ha, hb, ?_, ?_, ?_⟩
  · intro i j hij
    have hjpos : j.val ≠ 0 := by omega
    have hpredj : pred j = i := by
      apply Fin.ext
      rw [hpredPos j hjpos]
      omega
    simpa [a, b, hpredj] using (hpq i).2.2
  · intro i j hi hj
    have hiLast : i = lastEdge := by
      apply Fin.ext
      dsimp [lastEdge]
      omega
    have hpredj : pred j = lastEdge := hpredZero j hj
    simpa [a, b, hiLast, hpredj] using (hpq lastEdge).2.2
  · intro i hi
    constructor
    · dsimp [a]
      congr 1
      apply Fin.ext
      exact hpredPos i hi
    · rfl

/-- Requiring a cross matching of size one is exactly the ordinary
hub-interaction relation. -/
theorem largeCrossMatchingGraph_one_eq_hubInteractionGraph
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) (U : ι → Finset V) :
    LargeCrossMatchingGraph G U 1 = HubInteractionGraph G U := by
  ext i j
  constructor
  · intro hij
    have hcross := hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj hij
    obtain ⟨M, hM, hcard, hMU⟩ := hcross
    have hMne : M.Nonempty := Finset.nonempty_iff_ne_empty.mpr (by
      intro hzero
      subst M
      simp at hcard)
    obtain ⟨e, he⟩ := hMne
    rcases hMU e he with heij | heji
    · rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      exact ⟨hij.ne, Or.inl ⟨e.1, heij.1, e.2, heij.2, hM.1 e he⟩⟩
    · rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      exact ⟨hij.ne,
        Or.inl ⟨e.2, heji.2, e.1, heji.1, (hM.1 e he).symm⟩⟩
  · intro hij
    obtain ⟨a, ha, b, hb, hab⟩ :=
      exists_cross_edge_of_hubInteractionGraph_adj G U hij
    rw [LargeCrossMatchingGraph, SimpleGraph.fromRel_adj]
    refine ⟨hij.ne, Or.inl ?_⟩
    let e : V × V := (a, b)
    refine ⟨{e}, ?_, by simp, ?_⟩
    · constructor
      · intro q hq
        have hqe : q = e := by simpa using hq
        subst q
        exact hab
      · intro q hq r hr hqr
        simp only [Finset.mem_singleton] at hq hr
        exact (hqr (hq.trans hr.symm)).elim
    · intro q hq
      simp only [Finset.mem_singleton] at hq
      subst q
      exact Or.inl ⟨ha, hb⟩

/-- If remaining vertices cannot attach to two different cores, distinct
ordinary interaction neighbours consume distinct vertices of the original
core. -/
theorem degree_hubInteractionGraph_le_card_of_no_repeated_attachment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (A W : ι → Finset V)
    (hWA : ∀ i, W i ⊆ A i)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (A i) (A j))
    (hnorep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ x ∈ W i, ∀ y ∈ A j, ∀ z ∈ A ℓ,
        G.Adj x y → G.Adj x z → False)
    (i : ι) :
    (HubInteractionGraph G W).degree i ≤ (A i).card := by
  have hbudget :=
    mul_degree_largeCrossMatchingGraph_le_card_of_no_repeated_attachment
      G A W 1 hWA hdisj hnorep i
  rw [largeCrossMatchingGraph_one_eq_hubInteractionGraph] at hbudget
  simpa using hbudget

/-- A copy of a cycle in the hub interaction graph can be lifted to an
injectively indexed cyclic list of actual ambient cross-edges.  Incoming and
outgoing endpoints are packaged as two functions on the cycle vertices, so
the result plugs directly into the finite cyclic-handle assembler. -/
theorem exists_cyclic_cross_edges_of_cycleGraph_isContained_hubInteractionGraph
    {V ι : Type*} {m : ℕ} (hm : 2 ≤ m)
    (G : SimpleGraph V) (U : ι → Finset V)
    (hcopy : cycleGraph (m + 1) ⊑ HubInteractionGraph G U) :
    ∃ f : Fin (m + 1) → ι, Function.Injective f ∧
      ∃ a b : Fin (m + 1) → V,
        (∀ i, a i ∈ U (f i)) ∧ (∀ i, b i ∈ U (f i)) ∧
        (∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ)) ∧
        G.Adj (b (Fin.last m)) (a 0) := by
  classical
  rcases hcopy with ⟨c⟩
  let f : Fin (m + 1) → ι := fun i => c.toHom i
  have hfinj : Function.Injective f := by
    intro i j hij
    exact c.injective hij
  have hstep : ∀ i : Fin m,
      (HubInteractionGraph G U).Adj (f i.castSucc) (f i.succ) := by
    intro i
    apply c.toHom.map_adj
    rw [SimpleGraph.cycleGraph_adj']
    right
    rw [Fin.sub_val_of_le (by
      change i.val ≤ i.val + 1
      omega)]
    simp
  have hlast :
      (HubInteractionGraph G U).Adj (f (Fin.last m)) (f 0) := by
    apply c.toHom.map_adj
    rw [SimpleGraph.cycleGraph_adj']
    right
    simp
    omega
  choose bout hbout ain hain hcross using fun i : Fin m =>
    exists_cross_edge_of_hubInteractionGraph_adj G U (hstep i)
  obtain ⟨blast, hblast, afirst, hafirst, hclose⟩ :=
    exists_cross_edge_of_hubInteractionGraph_adj G U hlast
  let a : Fin (m + 1) → V := Fin.cases afirst ain
  let b : Fin (m + 1) → V := Fin.lastCases blast bout
  refine ⟨f, hfinj, a, b, ?_, ?_, ?_, ?_⟩
  · intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [a] using hafirst
    · simpa [a] using hain j
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa [b] using hblast
    · simpa [b] using hbout j
  · intro i
    simpa [a, b] using hcross i
  · simpa [a, b] using hclose

/-- On a cyclic list of at least three distinct hubs, the no-repeated-
attachment condition forces the incoming and outgoing attachment vertices in
every hub to differ.  The predecessor and successor hubs are distinct because
the auxiliary cycle has length at least three. -/
theorem distinct_attachments_of_no_repeated_attachment_on_cyclic_cross_edges
    {V ι : Type*} {m : ℕ} (hm : 2 ≤ m)
    (G : SimpleGraph V) (U : ι → Finset V) (X : Finset V)
    (f : Fin (m + 1) → ι) (hfinj : Function.Injective f)
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ U (f i) \ X)
    (hb : ∀ i, b i ∈ U (f i) \ X)
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (hnorep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U ℓ,
        G.Adj x y → G.Adj x z → False) :
    ∀ i : Fin (m + 1), a i ≠ b i := by
  classical
  let nxt : Fin (m + 1) → Fin (m + 1) :=
    Fin.lastCases 0 (fun i : Fin m => i.succ)
  let prv : Fin (m + 1) → Fin (m + 1) :=
    Fin.cases (Fin.last m) (fun i : Fin m => i.castSucc)
  have hnext : ∀ i : Fin (m + 1),
      G.Adj (b i) (a (nxt i)) := by
    intro i
    induction i using Fin.lastCases with
    | last =>
        simpa [nxt] using hclose
    | cast j =>
        simpa [nxt] using hcross j
  have hprev : ∀ i : Fin (m + 1),
      G.Adj (b (prv i)) (a i) := by
    intro i
    induction i using Fin.cases with
    | zero =>
        simpa [prv] using hclose
    | succ j =>
        simpa [prv] using hcross j
  have hnxtVal : ∀ i : Fin (m + 1),
      (nxt i).val = if i.val = m then 0 else i.val + 1 := by
    intro i
    induction i using Fin.lastCases with
    | last =>
        simp [nxt]
    | cast j =>
        simp [nxt]
        omega
  have hprvVal : ∀ i : Fin (m + 1),
      (prv i).val = if i.val = 0 then m else i.val - 1 := by
    intro i
    induction i using Fin.cases with
    | zero =>
        simp [prv]
    | succ j =>
        simp [prv]
  have hselfNext : ∀ i : Fin (m + 1), i ≠ nxt i := by
    intro i h
    have hval := congrArg Fin.val h
    rw [hnxtVal i] at hval
    by_cases hi : i.val = m
    · simp [hi] at hval
      omega
    · simp [hi] at hval
  have hselfPrev : ∀ i : Fin (m + 1), i ≠ prv i := by
    intro i h
    have hval := congrArg Fin.val h
    rw [hprvVal i] at hval
    by_cases hi : i.val = 0
    · simp [hi] at hval
      omega
    · simp [hi] at hval
      omega
  have hprevNext : ∀ i : Fin (m + 1), prv i ≠ nxt i := by
    intro i h
    have hval := congrArg Fin.val h
    have hval' :
        (if i.val = 0 then m else i.val - 1) =
          (if i.val = m then 0 else i.val + 1) := by
      rw [← hprvVal i, ← hnxtVal i]
      exact hval
    by_cases hi0 : i.val = 0
    · have him : i.val ≠ m := by omega
      rw [if_pos hi0, if_neg him] at hval'
      omega
    · by_cases him : i.val = m
      · rw [if_neg hi0, if_pos him] at hval'
        omega
      · rw [if_neg hi0, if_neg him] at hval'
        omega
  intro i hai
  have hiPrev : f i ≠ f (prv i) := by
    intro h
    exact hselfPrev i (hfinj h)
  have hiNext : f i ≠ f (nxt i) := by
    intro h
    exact hselfNext i (hfinj h)
  have hPrevNext : f (prv i) ≠ f (nxt i) := by
    intro h
    exact hprevNext i (hfinj h)
  have hai' := Finset.mem_sdiff.mp (ha i)
  have hprevMem := (Finset.mem_sdiff.mp (hb (prv i))).1
  have hnextMem := (Finset.mem_sdiff.mp (ha (nxt i))).1
  have hsecond : G.Adj (a i) (a (nxt i)) := by
    simpa [hai] using hnext i
  exact hnorep (f i) (f (prv i)) (f (nxt i))
    hiPrev hiNext hPrevNext (a i) hai'.1 hai'.2
      (b (prv i)) hprevMem (a (nxt i)) hnextMem
      (hprev i).symm hsecond

/-- A cycle in the pruned hub interaction graph lifts all the way back to an
exact ambient cycle.  The first hub absorbs the target parity and every other
hub contributes the shortest even route.  Thus a cycle on m+1 auxiliary
vertices forces C_k whenever the long-route and three-edges-per-extra-hub
length equation fits. -/
theorem cycleGraph_isContained_of_pruned_hubInteraction_cycle
    {V ι : Type*} [Fintype V] {m n ℓ k : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUeven : ∀ i, 2 ≤ (U i).card)
    (hθeven : ∀ i, 3 ≤ θ i)
    (hℓ : 5 ≤ ℓ)
    (hℓU : ∀ i, ℓ ≤ (U i).card)
    (hℓθ : ∀ i, ℓ + 1 ≤ θ i)
    (hcopy : cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => U i \ X))
    (hnorep : ∀ i j q : ι, i ≠ j → i ≠ q → j ≠ q →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U q,
        G.Adj x y → G.Adj x z → False)
    (hlen : ℓ + 2 * m + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haX, hbX, hcross, hclose⟩ :=
    exists_cyclic_cross_edges_of_cycleGraph_isContained_hubInteractionGraph
      hm G (fun i => U i \ X) hcopy
  have hab : ∀ i : Fin (m + 1), a i ≠ b i :=
    distinct_attachments_of_no_repeated_attachment_on_cyclic_cross_edges
      hm G U X f hfinj a b haX hbX hcross hclose hnorep
  have ha : ∀ i : Fin (m + 1), a i ∈ U (f i) := by
    intro i
    exact (Finset.mem_sdiff.mp (haX i)).1
  have hb : ∀ i : Fin (m + 1), b i ∈ U (f i) := by
    intro i
    exact (Finset.mem_sdiff.mp (hbX i)).1
  apply cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_all_lengths_fin
    G hk (fun i => U (f i)) (fun i => T (f i)) (fun i => θ (f i))
      (fun i => hrob (f i))
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      hfree (hUn (f 0)) a b ha hb hab hcross hclose
      hℓ (hℓU (f 0)) (hℓθ (f 0)) (fun _ : Fin m => 0)
  · intro i
    simpa using hUeven (f i.succ)
  · intro i
    simpa using hθeven (f i.succ)
  · simpa [Fin.sum_const, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hlen

/-- Matching-backed version of the pruned interaction-cycle lift.  It has the
same cross-edge extraction and repeated-attachment distinctness bookkeeping
as the large-core lift above, but uses three disjoint internal edges in the
distinguished core instead of an independent-set-free lower bound on that
core.  The remaining hubs may use independently prescribed even route
lengths. -/
theorem cycleGraph_isContained_of_pruned_hubInteraction_cycle_matched
    {V ι : Type*} [Fintype V] {m ℓ k : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (U i))
    (hℓ : 5 ≤ ℓ)
    (hℓU : ∀ i, ℓ ≤ (U i).card)
    (hℓθ : ∀ i, ℓ + 1 ≤ θ i)
    (r : Fin m → ℕ)
    (hU : ∀ i : ι, ∀ j : Fin m, r j + 2 ≤ (U i).card)
    (hθ : ∀ i : ι, ∀ j : Fin m, 2 * (r j + 1) + 1 ≤ θ i)
    (hcopy : cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => U i \ X))
    (hnorep : ∀ i j q : ι, i ≠ j → i ≠ q → j ≠ q →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U q,
        G.Adj x y → G.Adj x z → False)
    (hlen : ℓ + (∑ j : Fin m, 2 * (r j + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haX, hbX, hcross, hclose⟩ :=
    exists_cyclic_cross_edges_of_cycleGraph_isContained_hubInteractionGraph
      hm G (fun i => U i \ X) hcopy
  have hab : ∀ i : Fin (m + 1), a i ≠ b i :=
    distinct_attachments_of_no_repeated_attachment_on_cyclic_cross_edges
      hm G U X f hfinj a b haX hbX hcross hclose hnorep
  have ha : ∀ i : Fin (m + 1), a i ∈ U (f i) := by
    intro i
    exact (Finset.mem_sdiff.mp (haX i)).1
  have hb : ∀ i : Fin (m + 1), b i ∈ U (f i) := by
    intro i
    exact (Finset.mem_sdiff.mp (hbX i)).1
  apply cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_matched_fin
    G hk (fun i => U (f i)) (fun i => T (f i)) (fun i => θ (f i))
      (fun i => hrob (f i))
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      (hmatch (f 0)) a b ha hb hab hcross hclose
      hℓ (hℓU (f 0)) (hℓθ (f 0)) r
  · intro j
    exact hU (f j.succ) j
  · intro j
    exact hθ (f j.succ) j
  · exact hlen

/-- Uniform-even-route exclusion for a matched pruned interaction cycle.
If every non-distinguished hub contributes the same even length
2 * (s + 1), then the distinguished matched hub can absorb any residual
between five and L.  The two displayed fitting inequalities are exactly
the lower and upper ends of that interval. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_matched_uniform_routes
    {V ι : Type*} [Fintype V] {m s L k : ℕ}
    (hm : 2 ≤ m)
    (hfitlow : 2 * (s + 1) * m + m + 6 ≤ k)
    (hfitup : k ≤ L + 2 * (s + 1) * m + m + 1)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (U i))
    (hL : ∀ i, L ≤ (U i).card)
    (hLθ : ∀ i, L + 1 ≤ θ i)
    (hsU : ∀ i, s + 2 ≤ (U i).card)
    (hsθ : ∀ i, 2 * (s + 1) + 1 ≤ θ i)
    (hnorep : ∀ i j q : ι, i ≠ j → i ≠ q → j ≠ q →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U q,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => U i \ X) := by
  intro hcopy
  apply hcycle
  let ℓ : ℕ := k - (2 * (s + 1) * m + m + 1)
  have hℓ : 5 ≤ ℓ := by
    dsimp [ℓ]
    omega
  have hℓL : ℓ ≤ L := by
    dsimp [ℓ]
    omega
  apply cycleGraph_isContained_of_pruned_hubInteraction_cycle_matched
    hm (by omega) G U T θ X hrob hregions hmatch hℓ
      (fun i => hℓL.trans (hL i))
      (fun i => by
        have hi := hLθ i
        omega)
      (fun _ : Fin m => s)
  · intro i j
    exact hsU i
  · intro i j
    exact hsθ i
  · exact hcopy
  · exact hnorep
  · have hsum :
        (∑ _j : Fin m, 2 * (s + 1)) = 2 * (s + 1) * m := by
      simp [Nat.mul_comm]
    rw [hsum]
    dsimp [ℓ]
    have hbase : 2 * (s + 1) * m + m + 1 ≤ k := by omega
    omega

/-- Independent-set-free large-core version of the uniform-route exclusion.
Four spare core vertices are enough to greedily build the three disjoint
internal edges consumed by the matched theorem above. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_large_core_uniform_routes
    {V ι : Type*} [Fintype V] {m s L k n : ℕ}
    (hm : 2 ≤ m)
    (hfitlow : 2 * (s + 1) * m + m + 6 ≤ k)
    (hfitup : k ≤ L + 2 * (s + 1) * m + m + 1)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 4 ≤ (U i).card)
    (hL : ∀ i, L ≤ (U i).card)
    (hLθ : ∀ i, L + 1 ≤ θ i)
    (hsU : ∀ i, s + 2 ≤ (U i).card)
    (hsθ : ∀ i, 2 * (s + 1) + 1 ≤ θ i)
    (hnorep : ∀ i j q : ι, i ≠ j → i ≠ q → j ≠ q →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U q,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => U i \ X) := by
  apply not_cycleGraph_isContained_pruned_hubInteraction_of_matched_uniform_routes
    hm hfitlow hfitup G U T θ X hrob hregions
      (fun i =>
        hasThreeDisjointAdjPairFamily_of_indepSetFree_of_add_four_le_card
          hfree (hUn i))
      hL hLθ hsU hsθ hnorep hcycle

/-- Quantitative short-cycle exclusion for the pruned interaction graph.  If
an auxiliary cycle on m+1 hubs is short enough that its m short even routes
leave at least five edges for the parity-broken hub, the preceding lifting
theorem contradicts ambient C_k-freeness. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_cycleFree
    {V ι : Type*} [Fintype V] {m n k : ℕ}
    (hm : 2 ≤ m) (hfit : 3 * m + 6 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hnorep : ∀ i j q : ι, i ≠ j → i ≠ q → j ≠ q →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U q,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => U i \ X) := by
  intro hcopy
  apply hcycle
  let ℓ : ℕ := k - (3 * m + 1)
  have hℓ : 5 ≤ ℓ := by
    dsimp [ℓ]
    omega
  have hℓle : ℓ ≤ k - 4 := by
    dsimp [ℓ]
    omega
  apply cycleGraph_isContained_of_pruned_hubInteraction_cycle
    hm (by omega) G U T θ X hrob hregions hfree hUn
      (fun i => by
        have := hUk i
        omega)
      (fun i => by
        have := hθ i
        omega)
      hℓ
      (fun i => hℓle.trans (hUk i))
      (fun i => by
        have hi := hθ i
        omega)
      hcopy hnorep
  dsimp [ℓ]
  omega

/-- After deleting every vertex that still sees two different other hub
cores, a remaining interaction triangle would have two distinct attachment
vertices in each of its three hubs, hence would give separated handles. -/
theorem not_hasHubInteractionTriangle_of_no_repeated_attachment
    {V ι : Type*} (G : SimpleGraph V)
    (U : ι → Finset V) (X : Finset V)
    (hsep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ¬ HasSeparatedTriangleHandles G (U i) (U j) (U ℓ))
    (hnorep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ a ∈ U i, a ∉ X → ∀ b ∈ U j, ∀ c ∈ U ℓ,
        G.Adj a b → G.Adj a c → False) :
    ¬ HasHubInteractionTriangle
      (HubInteractionGraph G (fun i => U i \ X)) := by
  rintro ⟨i, j, ℓ, hij, hiℓ, hjℓ, hijAdj, hjℓAdj, hℓiAdj⟩
  obtain ⟨b₁, hb₁, a₂, ha₂, h₁₂⟩ :=
    exists_cross_edge_of_hubInteractionGraph_adj
      G (fun i => U i \ X) hijAdj
  obtain ⟨b₂, hb₂, a₃, ha₃, h₂₃⟩ :=
    exists_cross_edge_of_hubInteractionGraph_adj
      G (fun i => U i \ X) hjℓAdj
  obtain ⟨b₃, hb₃, a₁, ha₁, h₃₁⟩ :=
    exists_cross_edge_of_hubInteractionGraph_adj
      G (fun i => U i \ X) hℓiAdj
  have hb₁' := Finset.mem_sdiff.mp hb₁
  have ha₂' := Finset.mem_sdiff.mp ha₂
  have hb₂' := Finset.mem_sdiff.mp hb₂
  have ha₃' := Finset.mem_sdiff.mp ha₃
  have hb₃' := Finset.mem_sdiff.mp hb₃
  have ha₁' := Finset.mem_sdiff.mp ha₁
  have ha₁b₁ : a₁ ≠ b₁ := by
    intro h
    subst b₁
    exact hnorep i ℓ j hiℓ hij hjℓ.symm
      a₁ ha₁'.1 ha₁'.2 b₃ hb₃'.1 a₂ ha₂'.1 h₃₁.symm h₁₂
  have ha₂b₂ : a₂ ≠ b₂ := by
    intro h
    subst b₂
    exact hnorep j i ℓ hij.symm hjℓ hiℓ
      a₂ ha₂'.1 ha₂'.2 b₁ hb₁'.1 a₃ ha₃'.1 h₁₂.symm h₂₃
  have ha₃b₃ : a₃ ≠ b₃ := by
    intro h
    subst b₃
    exact hnorep ℓ j i hjℓ.symm hiℓ.symm hij.symm
      a₃ ha₃'.1 ha₃'.2 b₂ hb₂'.1 a₁ ha₁'.1 h₂₃.symm h₃₁
  exact (hsep i j ℓ hij hiℓ hjℓ)
    ⟨a₁, b₁, a₂, b₂, a₃, b₃,
      ha₁'.1, hb₁'.1, ha₂'.1, hb₂'.1, ha₃'.1, hb₃'.1,
      ha₁b₁, ha₂b₂, ha₃b₃, h₁₂, h₂₃, h₃₁⟩

/-- Cycle-free robust hubs have no interaction triangle after the repeated
attachment vertices are deleted.  This is the first stability output in a
form that can be combined with a quantitative bound on the deleted set. -/
theorem not_hasHubInteractionTriangle_of_cycleFree_short_second_hub_family_after_no_repeated_attachment
    {V ι : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G)
    (X : Finset V)
    (hnorep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ a ∈ U i, a ∉ X → ∀ b ∈ U j, ∀ c ∈ U ℓ,
        G.Adj a b → G.Adj a c → False) :
    ¬ HasHubInteractionTriangle
      (HubInteractionGraph G (fun i => U i \ X)) := by
  apply not_hasHubInteractionTriangle_of_no_repeated_attachment G U X
  · intro i j ℓ hij hiℓ hjℓ
    exact not_hasSeparatedTriangleHandles_of_cycleFree_short_second_hub_family
      G U T θ hk hrob hfree hUn hUk hθ hregions hcycle
        i j ℓ hij hiℓ hjℓ
  · exact hnorep

/-- Vertices that attach to two distinct hub cores.  Removing this canonical
finite set turns the qualitative no-repeated-attachment hypothesis above into
an automatic fact. -/
noncomputable def RepeatedAttachmentFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) : Finset V :=
  Finset.univ.filter fun a =>
    ∃ i j ℓ : ι, i ≠ j ∧ i ≠ ℓ ∧ j ≠ ℓ ∧ a ∈ U i ∧
      ∃ b ∈ U j, G.Adj a b ∧ ∃ c ∈ U ℓ, G.Adj a c

/-- Restricting a family along an embedding cannot create a new repeated
attachment.  Every three labels witnessing membership in the restricted
exceptional set map to three distinct labels of the original family. -/
theorem RepeatedAttachmentFinset_comp_embedding_subset
    {V ι κ : Type*} [Fintype V] [Fintype ι] [Fintype κ]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) (e : κ ↪ ι) :
    RepeatedAttachmentFinset G (fun i => U (e i)) ⊆
      RepeatedAttachmentFinset G U := by
  classical
  intro a ha
  simp only [RepeatedAttachmentFinset, Finset.mem_filter, Finset.mem_univ,
    true_and] at ha ⊢
  obtain ⟨i, j, ℓ, hij, hiℓ, hjℓ, haU, b, hbU, hab,
      c, hcU, hac⟩ := ha
  refine ⟨e i, e j, e ℓ, ?_, ?_, ?_, haU, b, hbU, hab,
    c, hcU, hac⟩
  · exact fun h => hij (e.injective h)
  · exact fun h => hiℓ (e.injective h)
  · exact fun h => hjℓ (e.injective h)

/-- Outside the repeated-attachment set, a vertex of one hub cannot see
vertices in two distinct other hubs. -/
theorem no_repeated_attachment_outside_RepeatedAttachmentFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) :
    ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ a ∈ U i, a ∉ RepeatedAttachmentFinset G U →
        ∀ b ∈ U j, ∀ c ∈ U ℓ,
          G.Adj a b → G.Adj a c → False := by
  classical
  intro i j ℓ hij hiℓ hjℓ a ha haX b hb c hc hab hac
  apply haX
  simp only [RepeatedAttachmentFinset, Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨i, j, ℓ, hij, hiℓ, hjℓ, ha, b, hb, hab, c, hc, hac⟩

/-- Outside the repeated-attachment set, distinct ordinary interaction
neighbours consume distinct vertices of the displayed core.  Thus ordinary
interaction degree is bounded by the original core cardinality. -/
theorem degree_hubInteractionGraph_after_RepeatedAttachmentFinset_le_card
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j))
    (i : ι) :
    (HubInteractionGraph G
      (fun j => U j \ RepeatedAttachmentFinset G U)).degree i ≤
        (U i).card := by
  let X : Finset V := RepeatedAttachmentFinset G U
  let W : ι → Finset V := fun j => U j \ X
  have hbudget :
      1 * (LargeCrossMatchingGraph G W 1).degree i ≤ (U i).card := by
    apply mul_degree_largeCrossMatchingGraph_le_card_of_no_repeated_attachment
      G U W 1
    · intro j
      exact Finset.sdiff_subset
    · exact hdisj
    · intro a b c hab hac hbc x hx y hy z hz hxy hxz
      apply no_repeated_attachment_outside_RepeatedAttachmentFinset
        G U a b c hab hac hbc x
      · exact (Finset.mem_sdiff.mp hx).1
      · simpa [X] using (Finset.mem_sdiff.mp hx).2
      · exact hy
      · exact hz
      · exact hxy
      · exact hxz
  rw [largeCrossMatchingGraph_one_eq_hubInteractionGraph] at hbudget
  simpa [W, X] using hbudget

/-! ### Globally selected cross-edge systems

The source transversal argument does not use an arbitrary representative
for every interacting pair of classes.  It chooses a globally
vertex-disjoint family of ambient edges, with at most one representative for
each unordered pair of class labels, and makes that family maximal.  The
class-pair coordinate is retained explicitly below; this avoids encoding a
multigraph and makes both freshness and maximality available to later cycle
lifts. -/

/-- A selected cross edge stores its two class labels and its two oriented
ambient endpoints. -/
abbrev SelectedCrossEdge (V ι : Type*) := (ι × ι) × (V × V)

/-- Validity of a finite selected cross-edge system.  Every record is a
genuine ambient edge between two different displayed classes; different
records have four different ambient endpoints and different unordered class
pairs. -/
def IsSelectedCrossEdgeSystem {V ι : Type*}
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι)) : Prop :=
  (∀ e ∈ M,
    e.1.1 ≠ e.1.2 ∧ e.2.1 ∈ I e.1.1 ∧ e.2.2 ∈ I e.1.2 ∧
      G.Adj e.2.1 e.2.2) ∧
  (∀ e ∈ M, ∀ f ∈ M, e ≠ f →
    e.2.1 ≠ f.2.1 ∧ e.2.1 ≠ f.2.2 ∧
      e.2.2 ≠ f.2.1 ∧ e.2.2 ≠ f.2.2) ∧
  (∀ e ∈ M, ∀ f ∈ M,
    s(e.1.1, e.1.2) = s(f.1.1, f.1.2) → e = f)

/-- The ordinary auxiliary graph represented by a selected cross-edge
system.  The stored edge orientation is forgotten. -/
def SelectedCrossEdgeGraph {V ι : Type*}
    (M : Finset (SelectedCrossEdge V ι)) : SimpleGraph ι :=
  SimpleGraph.fromRel fun i j =>
    ∃ e ∈ M,
      (e.1.1 = i ∧ e.1.2 = j) ∨ (e.1.1 = j ∧ e.1.2 = i)

/-- Relabel a selected cross-edge record along an injective class map,
leaving its ambient endpoints unchanged. -/
def mapSelectedCrossEdgeLabels {V ρ ι : Type*}
    (e : ρ ↪ ι) (r : SelectedCrossEdge V ρ) :
    SelectedCrossEdge V ι :=
  ((e r.1.1, e r.1.2), r.2)

theorem mapSelectedCrossEdgeLabels_injective
    {V ρ ι : Type*} (e : ρ ↪ ι) :
    Function.Injective (mapSelectedCrossEdgeLabels (V := V) e) := by
  intro r s hrs
  apply Prod.ext
  · apply Prod.ext
    · exact e.injective (congrArg (fun z => z.1.1) hrs)
    · exact e.injective (congrArg (fun z => z.1.2) hrs)
  · simpa [mapSelectedCrossEdgeLabels] using congrArg Prod.snd hrs

/-- The finite selected system after relabelling its classes. -/
def mapSelectedCrossEdgeSystem {V ρ ι : Type*}
    (e : ρ ↪ ι) (M : Finset (SelectedCrossEdge V ρ)) :
    Finset (SelectedCrossEdge V ι) :=
  M.map ⟨mapSelectedCrossEdgeLabels e,
    mapSelectedCrossEdgeLabels_injective e⟩

/-- Valid selected systems are preserved by injective class relabelling,
provided every old class is included in its displayed new class. -/
theorem IsSelectedCrossEdgeSystem.map_labels
    {V ρ ι : Type*} {G : SimpleGraph V}
    {J : ρ → Finset V} {I : ι → Finset V}
    {M : Finset (SelectedCrossEdge V ρ)}
    (hM : IsSelectedCrossEdgeSystem G J M)
    (e : ρ ↪ ι) (hJI : ∀ i, J i ⊆ I (e i)) :
    IsSelectedCrossEdgeSystem G I (mapSelectedCrossEdgeSystem e M) := by
  classical
  let E : SelectedCrossEdge V ρ ↪ SelectedCrossEdge V ι :=
    ⟨mapSelectedCrossEdgeLabels e, mapSelectedCrossEdgeLabels_injective e⟩
  constructor
  · intro r hr
    rcases Finset.mem_map.mp hr with ⟨s, hsM, rfl⟩
    have hs := hM.1 s hsM
    exact ⟨fun h => hs.1 (e.injective h),
      hJI s.1.1 hs.2.1, hJI s.1.2 hs.2.2.1, hs.2.2.2⟩
  constructor
  · intro r hr s hs hrs
    rcases Finset.mem_map.mp hr with ⟨r₀, hr₀, rfl⟩
    rcases Finset.mem_map.mp hs with ⟨s₀, hs₀, rfl⟩
    have hrs₀ : r₀ ≠ s₀ := fun h => hrs (congrArg E h)
    simpa [mapSelectedCrossEdgeLabels] using hM.2.1 r₀ hr₀ s₀ hs₀ hrs₀
  · intro r hr s hs hpairs
    rcases Finset.mem_map.mp hr with ⟨r₀, hr₀, rfl⟩
    rcases Finset.mem_map.mp hs with ⟨s₀, hs₀, rfl⟩
    have hpairs₀ : s(r₀.1.1, r₀.1.2) = s(s₀.1.1, s₀.1.2) := by
      apply e.sym2Map.injective
      simpa [mapSelectedCrossEdgeLabels] using hpairs
    exact congrArg E (hM.2.2 r₀ hr₀ s₀ hs₀ hpairs₀)

/-- The selected auxiliary graph maps along the same injective relabelling. -/
def selectedCrossEdgeGraphMapLabelsHom
    {V ρ ι : Type*} (e : ρ ↪ ι)
    (M : Finset (SelectedCrossEdge V ρ)) :
    SelectedCrossEdgeGraph M →g
      SelectedCrossEdgeGraph (mapSelectedCrossEdgeSystem e M) :=
  { toFun := e
    map_rel' := by
      intro i j hij
      have hrecord : ∃ r ∈ M,
          (r.1.1 = i ∧ r.1.2 = j) ∨ (r.1.1 = j ∧ r.1.2 = i) := by
        rw [SelectedCrossEdgeGraph, SimpleGraph.fromRel_adj] at hij
        rcases hij with ⟨_hne, h | h⟩
        · exact h
        · rcases h with ⟨r, hr, hdir | hrev⟩
          · exact ⟨r, hr, Or.inr hdir⟩
          · exact ⟨r, hr, Or.inl hrev⟩
      obtain ⟨r, hr, hdir⟩ := hrecord
      rw [SelectedCrossEdgeGraph, SimpleGraph.fromRel_adj]
      refine ⟨fun h => hij.ne (e.injective h), Or.inl ?_⟩
      refine ⟨mapSelectedCrossEdgeLabels e r, Finset.mem_map.mpr ⟨r, hr, rfl⟩, ?_⟩
      rcases hdir with hdir | hrev
      · exact Or.inl ⟨by simpa [mapSelectedCrossEdgeLabels] using congrArg e hdir.1,
          by simpa [mapSelectedCrossEdgeLabels] using congrArg e hdir.2⟩
      · exact Or.inr ⟨by simpa [mapSelectedCrossEdgeLabels] using congrArg e hrev.1,
          by simpa [mapSelectedCrossEdgeLabels] using congrArg e hrev.2⟩ }

/-- The selected ambient endpoints charged to one class.  Validity ensures
that an incident record has exactly one endpoint in the displayed class. -/
def selectedCrossEndpointFinset {V ι : Type*} [DecidableEq V] [DecidableEq ι]
    (M : Finset (SelectedCrossEdge V ι)) (ι₀ : ι) : Finset V :=
  (M.filter fun e => e.1.1 = ι₀ ∨ e.1.2 = ι₀).image fun e =>
    if e.1.1 = ι₀ then e.2.1 else e.2.2

/-- All ambient endpoints used by a selected cross-edge system. -/
def selectedCrossGlobalEndpointFinset
    {V ι : Type*} [DecidableEq V]
    (M : Finset (SelectedCrossEdge V ι)) : Finset V :=
  M.biUnion fun e => {e.2.1, e.2.2}

theorem card_selectedCrossGlobalEndpointFinset_le
    {V ι : Type*} [DecidableEq V]
    (M : Finset (SelectedCrossEdge V ι)) :
    (selectedCrossGlobalEndpointFinset M).card ≤ 2 * M.card := by
  classical
  have h := Finset.card_biUnion_le_card_mul M
    (fun e : SelectedCrossEdge V ι => {e.2.1, e.2.2}) 2 (by
      intro e _he
      exact Finset.card_le_two)
  simpa [selectedCrossGlobalEndpointFinset, Nat.mul_comm] using h

theorem selectedCrossEndpointFinset_subset_global
    {V ι : Type*} [DecidableEq V] [DecidableEq ι]
    (M : Finset (SelectedCrossEdge V ι)) (i : ι) :
    selectedCrossEndpointFinset M i ⊆ selectedCrossGlobalEndpointFinset M := by
  classical
  intro x hx
  unfold selectedCrossEndpointFinset at hx
  rcases Finset.mem_image.mp hx with ⟨e, he, rfl⟩
  have heM := (Finset.mem_filter.mp he).1
  unfold selectedCrossGlobalEndpointFinset
  apply Finset.mem_biUnion.mpr
  refine ⟨e, heM, ?_⟩
  by_cases h : e.1.1 = i
  · simp [h]
  · simp [h]

/-- A maximum-cardinality valid selected system exists.  Cardinal
maximality is the convenient finite form: inserting one further compatible
record would strictly increase its size. -/
theorem exists_maximal_selectedCrossEdgeSystem
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (I : ι → Finset V) :
    ∃ M : Finset (SelectedCrossEdge V ι),
      IsSelectedCrossEdgeSystem G I M ∧
      ∀ N : Finset (SelectedCrossEdge V ι),
        IsSelectedCrossEdgeSystem G I N → N.card ≤ M.card := by
  classical
  let C : Finset (Finset (SelectedCrossEdge V ι)) :=
    Finset.univ.filter fun M => IsSelectedCrossEdgeSystem G I M
  have hCne : C.Nonempty := by
    refine ⟨∅, ?_⟩
    simp [C, IsSelectedCrossEdgeSystem]
  let D : Finset ℕ := C.image Finset.card
  have hDne : D.Nonempty := hCne.image Finset.card
  let t : ℕ := D.max' hDne
  have htD : t ∈ D := D.max'_mem hDne
  rcases Finset.mem_image.mp htD with ⟨M, hMC, hMt⟩
  have hM : IsSelectedCrossEdgeSystem G I M :=
    (Finset.mem_filter.mp hMC).2
  refine ⟨M, hM, ?_⟩
  intro N hN
  have hNC : N ∈ C :=
    Finset.mem_filter.mpr ⟨Finset.mem_univ _, hN⟩
  have hNcard : N.card ∈ D := Finset.mem_image.mpr ⟨N, hNC, rfl⟩
  have hle : N.card ≤ t := D.le_max' N.card hNcard
  rw [← hMt] at hle
  exact hle

theorem selectedCrossEdgeGraph_adj_of_mem
    {V ι : Type*} {M : Finset (SelectedCrossEdge V ι)}
    {e : SelectedCrossEdge V ι} (heM : e ∈ M) (hne : e.1.1 ≠ e.1.2) :
    (SelectedCrossEdgeGraph M).Adj e.1.1 e.1.2 := by
  rw [SelectedCrossEdgeGraph, SimpleGraph.fromRel_adj]
  exact ⟨hne, Or.inl ⟨e, heM, Or.inl ⟨rfl, rfl⟩⟩⟩

theorem exists_selectedCrossEdge_of_graph_adj
    {V ι : Type*} {M : Finset (SelectedCrossEdge V ι)} {i j : ι}
    (hij : (SelectedCrossEdgeGraph M).Adj i j) :
    ∃ e ∈ M,
      (e.1.1 = i ∧ e.1.2 = j) ∨ (e.1.1 = j ∧ e.1.2 = i) := by
  rw [SelectedCrossEdgeGraph, SimpleGraph.fromRel_adj] at hij
  rcases hij with ⟨_hne, h | h⟩
  · exact h
  · rcases h with ⟨e, he, hdir | hrev⟩
    · exact ⟨e, he, Or.inr hdir⟩
    · exact ⟨e, he, Or.inl hrev⟩

/-- A valid selected system has exactly one record for every edge of its
auxiliary graph.  Thus auxiliary edge density can be counted directly in
the selected records, without losing a factor to orientations. -/
theorem card_edgeFinset_selectedCrossEdgeGraph
    {V ι : Type*} [Fintype ι]
    {G : SimpleGraph V} {I : ι → Finset V}
    {M : Finset (SelectedCrossEdge V ι)}
    (hM : IsSelectedCrossEdgeSystem G I M) :
    (SelectedCrossEdgeGraph M).edgeFinset.card = M.card := by
  classical
  let pair : SelectedCrossEdge V ι → Sym2 ι := fun e => s(e.1.1, e.1.2)
  have hinj : Set.InjOn pair (M : Set (SelectedCrossEdge V ι)) := by
    intro e he f hf hef
    exact hM.2.2 e (by simpa using he) f (by simpa using hf) hef
  have himage : M.image pair = (SelectedCrossEdgeGraph M).edgeFinset := by
    ext z
    induction z using Sym2.inductionOn with
    | _ i j =>
      constructor
      · intro hz
        rcases Finset.mem_image.mp hz with ⟨e, heM, hePair⟩
        apply SimpleGraph.mem_edgeFinset.mpr
        rw [SimpleGraph.mem_edgeSet]
        rcases Sym2.eq_iff.mp hePair with hdir | hrev
        · simpa [hdir.1, hdir.2] using
            selectedCrossEdgeGraph_adj_of_mem heM (hM.1 e heM).1
        · have hadj := selectedCrossEdgeGraph_adj_of_mem heM
            (hM.1 e heM).1
          simpa [hrev.1, hrev.2] using hadj.symm
      · intro hz
        have hadj : (SelectedCrossEdgeGraph M).Adj i j :=
          SimpleGraph.mem_edgeFinset.mp hz
        obtain ⟨e, heM, hdir | hrev⟩ :=
          exists_selectedCrossEdge_of_graph_adj hadj
        · apply Finset.mem_image.mpr
          refine ⟨e, heM, ?_⟩
          simp [pair, hdir.1, hdir.2]
        · apply Finset.mem_image.mpr
          refine ⟨e, heM, ?_⟩
          simp [pair, hrev.1, hrev.2, Sym2.eq_swap]
  rw [← himage]
  exact Finset.card_image_of_injOn hinj

/-- An auxiliary selected edge can be oriented along either requested class
direction.  Besides the ambient endpoints, the conclusion retains the
underlying selected record and certifies that both oriented endpoints are
among that record's two globally protected endpoints. -/
theorem exists_oriented_selectedCrossEdge_of_graph_adj
    {V ι : Type*} {G : SimpleGraph V} {I : ι → Finset V}
    {M : Finset (SelectedCrossEdge V ι)}
    (hM : IsSelectedCrossEdgeSystem G I M) {i j : ι}
    (hij : (SelectedCrossEdgeGraph M).Adj i j) :
    ∃ e ∈ M, s(e.1.1, e.1.2) = s(i, j) ∧
      ∃ x y : V, x ∈ I i ∧ y ∈ I j ∧ G.Adj x y ∧
        (x = e.2.1 ∨ x = e.2.2) ∧ (y = e.2.1 ∨ y = e.2.2) := by
  obtain ⟨e, he, hdir | hrev⟩ := exists_selectedCrossEdge_of_graph_adj hij
  · have hedata := hM.1 e he
    refine ⟨e, he, ?_, e.2.1, e.2.2, ?_, ?_, ?_, Or.inl rfl, Or.inr rfl⟩
    · rw [hdir.1, hdir.2]
    · simpa [hdir.1] using hedata.2.1
    · simpa [hdir.2] using hedata.2.2.1
    · exact hedata.2.2.2
  · have hedata := hM.1 e he
    refine ⟨e, he, ?_, e.2.2, e.2.1, ?_, ?_, ?_, Or.inr rfl, Or.inl rfl⟩
    · rw [hrev.1, hrev.2, Sym2.eq_swap]
    · simpa [hrev.2] using hedata.2.2.1
    · simpa [hrev.1] using hedata.2.1
    · exact hedata.2.2.2.symm

/-- A simple walk in a valid selected-edge graph has an oriented ambient
cross-edge on every step, and all endpoints belonging to different steps
are globally distinct.  This is the open-path analogue of the selected
cycle extractor below.  It deliberately retains the two endpoint arrays:
at every internal label the preceding target and following source are then
different, even if a later short return detour uses ordinary interaction
edges. -/
theorem exists_globally_disjoint_cross_edges_along_selected_path
    {V ι : Type*} {G : SimpleGraph V} {I : ι → Finset V}
    {M : Finset (SelectedCrossEdge V ι)}
    (hM : IsSelectedCrossEdgeSystem G I M)
    {u v : ι} (w : (SelectedCrossEdgeGraph M).Walk u v)
    (hw : w.IsPath) :
    ∃ p q : Fin w.length → V,
      (∀ i : Fin w.length,
        p i ∈ I (w.getVert i.val) ∧
        q i ∈ I (w.getVert (i.val + 1)) ∧
        G.Adj (p i) (q i)) ∧
      ∀ i j : Fin w.length, i ≠ j →
        p i ≠ p j ∧ p i ≠ q j ∧ q i ≠ p j ∧ q i ≠ q j := by
  classical
  have hstep : ∀ i : Fin w.length,
      (SelectedCrossEdgeGraph M).Adj
        (w.getVert i.val) (w.getVert (i.val + 1)) := by
    intro i
    exact w.adj_getVert_succ i.isLt
  choose e heM hePair p q hp hq hpq hpRec hqRec using
    fun i : Fin w.length =>
      exists_oriented_selectedCrossEdge_of_graph_adj hM (hstep i)
  have heNe : ∀ i j : Fin w.length, i ≠ j → e i ≠ e j := by
    intro i j hij heq
    have hpairs :
        s(w.getVert i.val, w.getVert (i.val + 1)) =
          s(w.getVert j.val, w.getVert (j.val + 1)) := by
      calc
        s(w.getVert i.val, w.getVert (i.val + 1)) =
            s((e i).1.1, (e i).1.2) := (hePair i).symm
        _ = s((e j).1.1, (e j).1.2) := by rw [heq]
        _ = s(w.getVert j.val, w.getVert (j.val + 1)) := hePair j
    rcases Sym2.eq_iff.mp hpairs with hdir | hswap
    · apply hij
      apply Fin.ext
      exact hw.getVert_injOn (by simp) (by simp) hdir.1
    · have h₁ : i.val = j.val + 1 :=
        hw.getVert_injOn (by simp) (by simp) hswap.1
      have h₂ : i.val + 1 = j.val :=
        hw.getVert_injOn (by simp) (by simp) hswap.2
      omega
  refine ⟨p, q, ?_, ?_⟩
  · intro i
    exact ⟨hp i, hq i, hpq i⟩
  · intro i j hij
    have hfour := hM.2.1 (e i) (heM i) (e j) (heM j) (heNe i j hij)
    constructor
    · intro h
      rcases hpRec i with hi₁ | hi₂ <;>
        rcases hpRec j with hj₁ | hj₂
      · exact hfour.1 (hi₁.symm.trans (h.trans hj₁))
      · exact hfour.2.1 (hi₁.symm.trans (h.trans hj₂))
      · exact hfour.2.2.1 (hi₂.symm.trans (h.trans hj₁))
      · exact hfour.2.2.2 (hi₂.symm.trans (h.trans hj₂))
    constructor
    · intro h
      rcases hpRec i with hi₁ | hi₂ <;>
        rcases hqRec j with hj₁ | hj₂
      · exact hfour.1 (hi₁.symm.trans (h.trans hj₁))
      · exact hfour.2.1 (hi₁.symm.trans (h.trans hj₂))
      · exact hfour.2.2.1 (hi₂.symm.trans (h.trans hj₁))
      · exact hfour.2.2.2 (hi₂.symm.trans (h.trans hj₂))
    constructor
    · intro h
      rcases hqRec i with hi₁ | hi₂ <;>
        rcases hpRec j with hj₁ | hj₂
      · exact hfour.1 (hi₁.symm.trans (h.trans hj₁))
      · exact hfour.2.1 (hi₁.symm.trans (h.trans hj₂))
      · exact hfour.2.2.1 (hi₂.symm.trans (h.trans hj₁))
      · exact hfour.2.2.2 (hi₂.symm.trans (h.trans hj₂))
    · intro h
      rcases hqRec i with hi₁ | hi₂ <;>
        rcases hqRec j with hj₁ | hj₂
      · exact hfour.1 (hi₁.symm.trans (h.trans hj₁))
      · exact hfour.2.1 (hi₁.symm.trans (h.trans hj₂))
      · exact hfour.2.2.1 (hi₂.symm.trans (h.trans hj₁))
      · exact hfour.2.2.2 (hi₂.symm.trans (h.trans hj₂))

/-- A selected simple path closed by an ordinary interaction return has
cyclic ambient handles whose internal selected-path visits have distinct
incoming and outgoing attachments.  The return is allowed to repeat an
attachment at a hub.  Exactly `p.length - 1` visits retain the selected
freshness certificate. -/
theorem exists_cyclic_attachments_with_selected_path_interior
    {V ι : Type*} [Fintype ι]
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hM : IsSelectedCrossEdgeSystem G I M)
    {u v : ι} (p : (SelectedCrossEdgeGraph M).Walk u v)
    (hp : p.IsPath) (hplen : 2 ≤ p.length)
    (r : (HubInteractionGraph G I).Walk v u) (hr : r.IsPath)
    (hdisj : p.support.tail.Disjoint r.support.tail) :
    ∃ m : ℕ, ∃ f : Fin (m + 1) → ι,
      ∃ a b : Fin (m + 1) → V,
      ∃ S : Finset (Fin (m + 1)),
        m + 1 = p.length + r.length ∧
        Function.Injective f ∧
        (∀ i, a i ∈ I (f i)) ∧
        (∀ i, b i ∈ I (f i)) ∧
        (∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ)) ∧
        G.Adj (b (Fin.last m)) (a 0) ∧
        S.card = p.length - 1 ∧
        ∀ i ∈ S, a i ≠ b i := by
  classical
  let H : SimpleGraph ι := HubInteractionGraph G I
  let e : SelectedCrossEdgeGraph M →g H :=
    { toFun := id
      map_rel' := by
        intro i j hij
        obtain ⟨_e, _heM, _hePair, x, y, hx, hy, hxy,
            _hxRec, _hyRec⟩ :=
          exists_oriented_selectedCrossEdge_of_graph_adj hM hij
        change (HubInteractionGraph G I).Adj i j
        rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
        exact ⟨hij.ne, Or.inl ⟨x, hx, y, hy, hxy⟩⟩ }
  let pH : H.Walk u v := p.map e
  have hpH : pH.IsPath := hp.map Function.injective_id
  have hpHlen : pH.length = p.length := by simp [pH]
  have hpHsupport : pH.support = p.support := by simp [pH, e]
  have hdisjH : pH.support.tail.Disjoint r.support.tail := by
    simpa [hpHsupport] using hdisj
  have huv : u ≠ v := by
    intro huv
    have hnil : p.Nil := hp.nil_iff_eq.mpr huv
    have := hnil.length_eq_zero
    omega
  have hrpos : 0 < r.length := by
    apply Nat.pos_of_ne_zero
    intro hzero
    exact huv.symm ((Walk.length_eq_zero_iff.mp hzero).eq)
  let closed : H.Walk u u := pH.append r
  have hclosedCycle : closed.IsCycle := by
    exact hpH.isCycle_append hr hdisjH (Or.inl (by rw [hpHlen]; omega))
  have hclosedLen : closed.length = p.length + r.length := by
    simpa only [closed, Walk.length_append, hpHlen]
  have hclosedThree : 3 ≤ closed.length := by
    rw [hclosedLen]
    omega
  obtain ⟨sp, sq, hselected, hselectedDisj⟩ :=
    exists_globally_disjoint_cross_edges_along_selected_path hM p hp
  obtain ⟨rp, rq, hreturn⟩ :=
    exists_cross_edges_along_hubInteraction_walk G I r
  let edgeOut' : Fin (p.length + r.length) → V := Fin.addCases sp rp
  let edgeIn' : Fin (p.length + r.length) → V := Fin.addCases sq rq
  have hedges' : ∀ j : Fin (p.length + r.length),
      edgeOut' j ∈ I (closed.getVert j.val) ∧
      edgeIn' j ∈ I (closed.getVert (j.val + 1)) ∧
      G.Adj (edgeOut' j) (edgeIn' j) := by
    intro j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) j
    · simpa [edgeOut', edgeIn', closed, pH, e, Walk.getVert_append']
        using hselected i
    · have hnot₀ : ¬ p.length + i.val < p.length := by omega
      have hnot₁ : ¬ p.length + i.val + 1 < p.length := by omega
      have hsub₁ : p.length + i.val + 1 - p.length = i.val + 1 := by omega
      simpa [edgeOut', edgeIn', closed, pH, e, Walk.getVert_append,
        hnot₀, hnot₁, hsub₁]
        using hreturn i
  let toEdges : Fin closed.length → Fin (p.length + r.length) :=
    fun i => Fin.cast hclosedLen i
  let edgeOut : Fin closed.length → V := fun i => edgeOut' (toEdges i)
  let edgeIn : Fin closed.length → V := fun i => edgeIn' (toEdges i)
  have hedges : ∀ i : Fin closed.length,
      edgeOut i ∈ I (closed.getVert i.val) ∧
      edgeIn i ∈ I (closed.getVert (i.val + 1)) ∧
      G.Adj (edgeOut i) (edgeIn i) := by
    intro i
    simpa [edgeOut, edgeIn, toEdges] using hedges' (toEdges i)
  obtain ⟨ac, bc, hac, hbc, hcrossVal, hcloseVal, hacbc⟩ :=
    exists_cyclic_attachments_of_oriented_edges_along_closed_walk
      G H I closed (by omega) edgeOut edgeIn hedges
  let m : ℕ := closed.length - 1
  have hm : 2 ≤ m := by dsimp [m]; omega
  have hmLen : m + 1 = closed.length := by dsimp [m]; omega
  let toClosed : Fin (m + 1) → Fin closed.length := fun i => Fin.cast hmLen i
  let f : Fin (m + 1) → ι := fun i => closed.getVert (toClosed i).val
  let a : Fin (m + 1) → V := fun i => ac (toClosed i)
  let b : Fin (m + 1) → V := fun i => bc (toClosed i)
  have hfinj : Function.Injective f := by
    intro i j hij
    apply Fin.ext
    have hval : (toClosed i).val = (toClosed j).val := by
      exact hclosedCycle.getVert_injOn' (by simp [m, toClosed]; omega)
        (by simp [m, toClosed]; omega) hij
    simpa [toClosed] using hval
  have ha : ∀ i, a i ∈ I (f i) := by
    intro i
    exact hac (toClosed i)
  have hb : ∀ i, b i ∈ I (f i) := by
    intro i
    exact hbc (toClosed i)
  have hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ) := by
    intro i
    apply hcrossVal (toClosed i.castSucc) (toClosed i.succ)
    simp [toClosed]
  have hclose : G.Adj (b (Fin.last m)) (a 0) := by
    apply hcloseVal (toClosed (Fin.last m)) (toClosed 0)
    · simp [toClosed, hmLen]
    · simp [toClosed]
  let interior : Fin (p.length - 1) → Fin (m + 1) := fun j =>
    ⟨j.val + 1, by
      rw [hmLen, hclosedLen]
      have hj := j.isLt
      omega⟩
  have hinteriorInj : Function.Injective interior := by
    intro i j hij
    apply Fin.ext
    have hval := congrArg Fin.val hij
    simp [interior] at hval
    omega
  let S : Finset (Fin (m + 1)) :=
    (Finset.univ : Finset (Fin (p.length - 1))).image interior
  have hScard : S.card = p.length - 1 := by
    rw [Finset.card_image_of_injective _ hinteriorInj]
    simp [S]
  have hab : ∀ i ∈ S, a i ≠ b i := by
    intro i hi
    rcases Finset.mem_image.mp hi with ⟨j, _hj, rfl⟩
    let prev : Fin p.length := ⟨j.val, by have := j.isLt; omega⟩
    let next : Fin p.length := ⟨j.val + 1, by have := j.isLt; omega⟩
    have hprevNext : prev ≠ next := by
      intro h
      have := congrArg Fin.val h
      simp [prev, next] at this
    have hfresh : sq prev ≠ sp next :=
      (hselectedDisj prev next hprevNext).2.2.1
    have hpos : (toClosed (interior j)).val ≠ 0 := by
      simp [toClosed, interior]
    have hacform := (hacbc (toClosed (interior j)) hpos).1
    have hbcform := (hacbc (toClosed (interior j)) hpos).2
    intro heq
    apply hfresh
    have haeq : a (interior j) = sq prev := by
      rw [show a (interior j) = ac (toClosed (interior j)) by rfl, hacform]
      change Fin.addCases sq rq ⟨j.val, by omega⟩ = sq prev
      rw [show (⟨j.val, by omega⟩ : Fin (p.length + r.length)) =
        Fin.castAdd r.length prev by apply Fin.ext; rfl]
      simp
    have hbeq : b (interior j) = sp next := by
      rw [show b (interior j) = bc (toClosed (interior j)) by rfl, hbcform]
      change Fin.addCases sp rp ⟨j.val + 1, by omega⟩ = sp next
      rw [show (⟨j.val + 1, by omega⟩ : Fin (p.length + r.length)) =
        Fin.castAdd r.length next by apply Fin.ext; rfl]
      simp
    exact haeq.symm.trans (heq.trans hbeq)
  refine ⟨m, f, a, b, S, ?_, hfinj, ha, hb, hcross, hclose, hScard, hab⟩
  rw [hmLen, hclosedLen]

/-- A copied auxiliary cycle in a valid selected-edge graph has cyclically
oriented ambient handles with distinct incoming and outgoing attachments in
every class.  Distinctness is now automatic from global endpoint-disjointness
of the selected records; no repeated-attachment deletion is required. -/
theorem exists_distinct_cyclic_cross_edges_of_cycleGraph_isContained_selectedCrossEdgeGraph
    {V ι : Type*} {m : ℕ} (hm : 2 ≤ m)
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hcopy : cycleGraph (m + 1) ⊑ SelectedCrossEdgeGraph M) :
    ∃ f : Fin (m + 1) → ι, Function.Injective f ∧
      ∃ a b : Fin (m + 1) → V,
        (∀ i, a i ∈ I (f i)) ∧ (∀ i, b i ∈ I (f i)) ∧
        (∀ i, a i ≠ b i) ∧
        (∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ)) ∧
        G.Adj (b (Fin.last m)) (a 0) := by
  classical
  rcases hcopy with ⟨c⟩
  let f : Fin (m + 1) → ι := fun i => c.toHom i
  have hfinj : Function.Injective f := c.injective
  have hstep : ∀ i : Fin m,
      (SelectedCrossEdgeGraph M).Adj (f i.castSucc) (f i.succ) := by
    intro i
    apply c.toHom.map_adj
    rw [SimpleGraph.cycleGraph_adj']
    right
    rw [Fin.sub_val_of_le (by
      change i.val ≤ i.val + 1
      omega)]
    simp
  have hlast :
      (SelectedCrossEdgeGraph M).Adj (f (Fin.last m)) (f 0) := by
    apply c.toHom.map_adj
    rw [SimpleGraph.cycleGraph_adj']
    right
    simp
    omega
  choose eStep heStep hpStep bout ain hbout hain hcross
      hboutRec hainRec using fun i : Fin m =>
    exists_oriented_selectedCrossEdge_of_graph_adj hM (hstep i)
  obtain ⟨eClose, heClose, hpClose, blast, afirst, hblast, hafirst,
      hclose, hblastRec, hafirstRec⟩ :=
    exists_oriented_selectedCrossEdge_of_graph_adj hM hlast
  let eIn : Fin (m + 1) → SelectedCrossEdge V ι :=
    Fin.cases eClose eStep
  let eOut : Fin (m + 1) → SelectedCrossEdge V ι :=
    Fin.lastCases eClose eStep
  let a : Fin (m + 1) → V := Fin.cases afirst ain
  let b : Fin (m + 1) → V := Fin.lastCases blast bout
  let nxt : Fin (m + 1) → Fin (m + 1) :=
    Fin.lastCases 0 (fun i : Fin m => i.succ)
  let prv : Fin (m + 1) → Fin (m + 1) :=
    Fin.cases (Fin.last m) (fun i : Fin m => i.castSucc)
  have hnxtVal : ∀ i : Fin (m + 1),
      (nxt i).val = if i.val = m then 0 else i.val + 1 := by
    intro i
    induction i using Fin.lastCases with
    | last => simp [nxt]
    | cast j =>
        simp [nxt]
        omega
  have hprvVal : ∀ i : Fin (m + 1),
      (prv i).val = if i.val = 0 then m else i.val - 1 := by
    intro i
    induction i using Fin.cases with
    | zero => simp [prv]
    | succ j => simp [prv]
  have hselfPrev : ∀ i : Fin (m + 1), prv i ≠ i := by
    intro i h
    have hval := congrArg Fin.val h
    rw [hprvVal i] at hval
    by_cases hi : i.val = 0
    · simp [hi] at hval
      omega
    · simp [hi] at hval
      omega
  have hprevNext : ∀ i : Fin (m + 1), prv i ≠ nxt i := by
    intro i h
    have hval := congrArg Fin.val h
    have hval' :
        (if i.val = 0 then m else i.val - 1) =
          (if i.val = m then 0 else i.val + 1) := by
      rw [← hprvVal i, ← hnxtVal i]
      exact hval
    by_cases hi0 : i.val = 0
    · have him : i.val ≠ m := by omega
      rw [if_pos hi0, if_neg him] at hval'
      omega
    · by_cases him : i.val = m
      · rw [if_neg hi0, if_pos him] at hval'
        omega
      · rw [if_neg hi0, if_neg him] at hval'
        omega
  have heIn : ∀ i : Fin (m + 1), eIn i ∈ M := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [eIn] using heClose
    · simpa [eIn] using heStep j
  have heOut : ∀ i : Fin (m + 1), eOut i ∈ M := by
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa [eOut] using heClose
    · simpa [eOut] using heStep j
  have hpIn : ∀ i : Fin (m + 1),
      s((eIn i).1.1, (eIn i).1.2) = s(f (prv i), f i) := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [eIn, prv] using hpClose
    · simpa [eIn, prv] using hpStep j
  have hpOut : ∀ i : Fin (m + 1),
      s((eOut i).1.1, (eOut i).1.2) = s(f i, f (nxt i)) := by
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa [eOut, nxt] using hpClose
    · simpa [eOut, nxt] using hpStep j
  have heNe : ∀ i : Fin (m + 1), eIn i ≠ eOut i := by
    intro i heq
    have hpairs : s(f (prv i), f i) = s(f i, f (nxt i)) := by
      calc
        s(f (prv i), f i) = s((eIn i).1.1, (eIn i).1.2) := (hpIn i).symm
        _ = s((eOut i).1.1, (eOut i).1.2) := by rw [heq]
        _ = s(f i, f (nxt i)) := hpOut i
    rcases Sym2.eq_iff.mp hpairs with hdir | hswap
    · exact hselfPrev i (hfinj hdir.1)
    · exact hprevNext i (hfinj hswap.1)
  have haRec : ∀ i : Fin (m + 1),
      a i = (eIn i).2.1 ∨ a i = (eIn i).2.2 := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [a, eIn] using hafirstRec
    · simpa [a, eIn] using hainRec j
  have hbRec : ∀ i : Fin (m + 1),
      b i = (eOut i).2.1 ∨ b i = (eOut i).2.2 := by
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa [b, eOut] using hblastRec
    · simpa [b, eOut] using hboutRec j
  have hab : ∀ i : Fin (m + 1), a i ≠ b i := by
    intro i hai
    have hfour := hM.2.1 (eIn i) (heIn i) (eOut i) (heOut i) (heNe i)
    rcases haRec i with ha₁ | ha₂ <;>
      rcases hbRec i with hb₁ | hb₂
    · exact hfour.1 (ha₁.symm.trans (hai.trans hb₁))
    · exact hfour.2.1 (ha₁.symm.trans (hai.trans hb₂))
    · exact hfour.2.2.1 (ha₂.symm.trans (hai.trans hb₁))
    · exact hfour.2.2.2 (ha₂.symm.trans (hai.trans hb₂))
  refine ⟨f, hfinj, a, b, ?_, ?_, hab, ?_, ?_⟩
  · intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [a] using hafirst
    · simpa [a] using hain j
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa [b] using hblast
    · simpa [b] using hbout j
  · intro i
    simpa [a, b] using hcross i
  · simpa [a, b] using hclose

theorem selectedCrossEdge_left_mem_endpointFinset
    {V ι : Type*} [DecidableEq V] [DecidableEq ι]
    {M : Finset (SelectedCrossEdge V ι)} {e : SelectedCrossEdge V ι}
    (he : e ∈ M) :
    e.2.1 ∈ selectedCrossEndpointFinset M e.1.1 := by
  unfold selectedCrossEndpointFinset
  apply Finset.mem_image.mpr
  refine ⟨e, Finset.mem_filter.mpr ⟨he, Or.inl rfl⟩, ?_⟩
  simp

theorem selectedCrossEdge_right_mem_endpointFinset
    {V ι : Type*} [DecidableEq V] [DecidableEq ι]
    {G : SimpleGraph V} {I : ι → Finset V}
    {M : Finset (SelectedCrossEdge V ι)}
    (hM : IsSelectedCrossEdgeSystem G I M)
    {e : SelectedCrossEdge V ι} (he : e ∈ M) :
    e.2.2 ∈ selectedCrossEndpointFinset M e.1.2 := by
  have hne : e.1.1 ≠ e.1.2 := (hM.1 e he).1
  unfold selectedCrossEndpointFinset
  apply Finset.mem_image.mpr
  refine ⟨e, Finset.mem_filter.mpr ⟨he, Or.inr rfl⟩, ?_⟩
  simp [hne]

/-- At one class, the globally selected endpoint charge is no larger than
the ordinary degree of the selected auxiliary graph.  Pair uniqueness makes
the map from an incident record to its opposite class injective. -/
theorem card_selectedCrossEndpointFinset_le_degree
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hM : IsSelectedCrossEdgeSystem G I M) (i : ι) :
    (selectedCrossEndpointFinset M i).card ≤
      (SelectedCrossEdgeGraph M).degree i := by
  classical
  let E : Finset (SelectedCrossEdge V ι) :=
    M.filter fun e => e.1.1 = i ∨ e.1.2 = i
  let other : SelectedCrossEdge V ι → ι := fun e =>
    if e.1.1 = i then e.1.2 else e.1.1
  have hmap : ∀ e ∈ E,
      other e ∈ (SelectedCrossEdgeGraph M).neighborFinset i := by
    intro e he
    have he' := Finset.mem_filter.mp he
    have heM : e ∈ M := he'.1
    have hvalid := hM.1 e heM
    rw [SimpleGraph.mem_neighborFinset]
    rcases he'.2 with hei | hei
    · subst i
      simpa [other] using
        selectedCrossEdgeGraph_adj_of_mem heM hvalid.1
    · have hfirst : e.1.1 ≠ i := by
        intro h
        exact hvalid.1 (h.trans hei.symm)
      have hadj := selectedCrossEdgeGraph_adj_of_mem heM hvalid.1
      simpa [other, hfirst, hei] using hadj.symm
  have hinj : Set.InjOn other (E : Set (SelectedCrossEdge V ι)) := by
    intro e he f hf heq
    have he' := Finset.mem_filter.mp he
    have hf' := Finset.mem_filter.mp hf
    have heM : e ∈ M := he'.1
    have hfM : f ∈ M := hf'.1
    have hevalid := hM.1 e heM
    have hfvalid := hM.1 f hfM
    have hpairs : s(e.1.1, e.1.2) = s(f.1.1, f.1.2) := by
      rcases he'.2 with hei | hei <;> rcases hf'.2 with hfi | hfi
      · have hother : e.1.2 = f.1.2 := by
          simpa [other, hei, hfi] using heq
        exact Sym2.eq_iff.mpr (Or.inl ⟨hei.trans hfi.symm, hother⟩)
      · have hffirst : f.1.1 ≠ i := by
          intro h
          exact hfvalid.1 (h.trans hfi.symm)
        have hother : e.1.2 = f.1.1 := by
          simpa [other, hei, hffirst] using heq
        exact Sym2.eq_iff.mpr (Or.inr ⟨hei.trans hfi.symm, hother⟩)
      · have hefirst : e.1.1 ≠ i := by
          intro h
          exact hevalid.1 (h.trans hei.symm)
        have hother : e.1.1 = f.1.2 := by
          simpa [other, hefirst, hfi] using heq
        exact Sym2.eq_iff.mpr (Or.inr ⟨hother, hei.trans hfi.symm⟩)
      · have hefirst : e.1.1 ≠ i := by
          intro h
          exact hevalid.1 (h.trans hei.symm)
        have hffirst : f.1.1 ≠ i := by
          intro h
          exact hfvalid.1 (h.trans hfi.symm)
        have hother : e.1.1 = f.1.1 := by
          simpa [other, hefirst, hffirst] using heq
        exact Sym2.eq_iff.mpr (Or.inl ⟨hother, hei.trans hfi.symm⟩)
    exact hM.2.2 e heM f hfM hpairs
  have hEcard : E.card ≤
      ((SelectedCrossEdgeGraph M).neighborFinset i).card := by
    exact Finset.card_le_card_of_injOn other hmap hinj
  calc
    (selectedCrossEndpointFinset M i).card ≤ E.card := by
      simpa [selectedCrossEndpointFinset, E] using
        Finset.card_image_le (s := E) (f := fun e =>
          if e.1.1 = i then e.2.1 else e.2.2)
    _ ≤ ((SelectedCrossEdgeGraph M).neighborFinset i).card := hEcard
    _ = (SelectedCrossEdgeGraph M).degree i :=
      (SelectedCrossEdgeGraph M).card_neighborFinset_eq_degree i

/-- Any endpoint of a selected record that lies in class `i` is charged to
the endpoint finset of that class.  Pairwise disjointness identifies which
of the two stored class labels is `i`. -/
theorem mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    {e : SelectedCrossEdge V ι} (he : e ∈ M)
    {i : ι} {x : V} (hxI : x ∈ I i)
    (hx : x = e.2.1 ∨ x = e.2.2) :
    x ∈ selectedCrossEndpointFinset M i := by
  classical
  have hvalid := hM.1 e he
  rcases hx with hleft | hright
  · by_cases hi : i = e.1.1
    · subst i
      simpa [hleft] using selectedCrossEdge_left_mem_endpointFinset he
    · exact (Finset.disjoint_left.mp (hdisj i e.1.1 hi)) hxI
        (hleft ▸ hvalid.2.1) |>.elim
  · by_cases hi : i = e.1.2
    · subst i
      simpa [hright] using
        selectedCrossEdge_right_mem_endpointFinset hM he
    · exact (Finset.disjoint_left.mp (hdisj i e.1.2 hi)) hxI
        (hright ▸ hvalid.2.2.1) |>.elim

/-- Maximality has the exact source consequence: if two class labels are
nonadjacent in the selected auxiliary graph, then their vertices remaining
after the selected endpoint charge are anticomplete in the ambient graph.
Otherwise the uncovered ambient edge could be inserted without reusing an
endpoint or an unordered class pair. -/
theorem anticomplete_sdiff_selectedCrossEndpointFinset_of_maximal
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hmax : ∀ N : Finset (SelectedCrossEdge V ι),
      IsSelectedCrossEdgeSystem G I N → N.card ≤ M.card)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    {i j : ι} (hij : i ≠ j)
    (hijH : ¬ (SelectedCrossEdgeGraph M).Adj i j) :
    ∀ a ∈ I i \ selectedCrossEndpointFinset M i,
      ∀ b ∈ I j \ selectedCrossEndpointFinset M j, ¬ G.Adj a b := by
  classical
  intro a ha b hb hab
  let e : SelectedCrossEdge V ι := ((i, j), (a, b))
  have heNot : e ∉ M := by
    intro he
    exact (Finset.mem_sdiff.mp ha).2 (by
      simpa [e] using selectedCrossEdge_left_mem_endpointFinset he)
  let N : Finset (SelectedCrossEdge V ι) := insert e M
  have hN : IsSelectedCrossEdgeSystem G I N := by
    refine ⟨?_, ?_, ?_⟩
    · intro q hq
      simp only [N, Finset.mem_insert] at hq
      rcases hq with rfl | hq
      · exact ⟨hij, (Finset.mem_sdiff.mp ha).1,
          (Finset.mem_sdiff.mp hb).1, hab⟩
      · exact hM.1 q hq
    · intro q hq r hr hqr
      simp only [N, Finset.mem_insert] at hq hr
      rcases hq with rfl | hq <;> rcases hr with rfl | hr
      · exact (hqr rfl).elim
      · have ha1 : a ≠ r.2.1 := by
          intro h
          exact (Finset.mem_sdiff.mp ha).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hr (Finset.mem_sdiff.mp ha).1 (Or.inl h))
        have ha2 : a ≠ r.2.2 := by
          intro h
          exact (Finset.mem_sdiff.mp ha).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hr (Finset.mem_sdiff.mp ha).1 (Or.inr h))
        have hb1 : b ≠ r.2.1 := by
          intro h
          exact (Finset.mem_sdiff.mp hb).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hr (Finset.mem_sdiff.mp hb).1 (Or.inl h))
        have hb2 : b ≠ r.2.2 := by
          intro h
          exact (Finset.mem_sdiff.mp hb).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hr (Finset.mem_sdiff.mp hb).1 (Or.inr h))
        exact ⟨ha1, ha2, hb1, hb2⟩
      · have ha1 : a ≠ q.2.1 := by
          intro h
          exact (Finset.mem_sdiff.mp ha).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hq (Finset.mem_sdiff.mp ha).1 (Or.inl h))
        have ha2 : a ≠ q.2.2 := by
          intro h
          exact (Finset.mem_sdiff.mp ha).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hq (Finset.mem_sdiff.mp ha).1 (Or.inr h))
        have hb1 : b ≠ q.2.1 := by
          intro h
          exact (Finset.mem_sdiff.mp hb).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hq (Finset.mem_sdiff.mp hb).1 (Or.inl h))
        have hb2 : b ≠ q.2.2 := by
          intro h
          exact (Finset.mem_sdiff.mp hb).2
            (mem_selectedCrossEndpointFinset_of_mem_class_of_eq_endpoint
              G I M hM hdisj hq (Finset.mem_sdiff.mp hb).1 (Or.inr h))
        exact ⟨Ne.symm ha1, Ne.symm hb1, Ne.symm ha2, Ne.symm hb2⟩
      · exact hM.2.1 q hq r hr hqr
    · intro q hq r hr hpairs
      simp only [N, Finset.mem_insert] at hq hr
      rcases hq with rfl | hq <;> rcases hr with rfl | hr
      · rfl
      · exfalso
        apply hijH
        have hrvalid := hM.1 r hr
        have hadj := selectedCrossEdgeGraph_adj_of_mem hr hrvalid.1
        rw [Sym2.eq_iff] at hpairs
        dsimp [e] at hpairs
        rcases hpairs with hpairs | hpairs
        · rw [hpairs.1, hpairs.2]
          exact hadj
        · rw [hpairs.1, hpairs.2]
          exact hadj.symm
      · exfalso
        apply hijH
        have hqvalid := hM.1 q hq
        have hadj := selectedCrossEdgeGraph_adj_of_mem hq hqvalid.1
        rw [Sym2.eq_iff] at hpairs
        dsimp [e] at hpairs
        rcases hpairs with hpairs | hpairs
        · simpa [e, hpairs.1, hpairs.2] using hadj
        · simpa [e, hpairs.1, hpairs.2] using hadj.symm
      · exact hM.2.2 q hq r hr hpairs
  have hcard := hmax N hN
  have hNcard : N.card = M.card + 1 := by simp [N, heNot]
  rw [hNcard] at hcard
  omega

/-- Sparse selected-H1 cleanup for the large-cross-matching H3 graph.
Selected endpoints pay two vertices per H1 edge.  Every H1 edge that is not
an H3 edge has a cross-edge vertex cover of fewer than `2R` vertices.  Thus
one deletion of at most `(2R+2)|E(H1)|` vertices makes different H3
components anticomplete, with no quadratic all-pairs charge. -/
theorem exists_sparse_selected_exceptional_set_separating_largeCrossMatching_components
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hmax : ∀ N : Finset (SelectedCrossEdge V ι),
      IsSelectedCrossEdgeSystem G I N → N.card ≤ M.card)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    (R : ℕ) :
    let E := selectedCrossGlobalEndpointFinset M
    let U : ι → Finset V := fun i => I i \ E
    let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
    ∃ X : Finset V,
      X.card ≤ (2 * R + 2) * M.card ∧ E ⊆ X ∧
      ∀ c d : H.ConnectedComponent, c ≠ d →
        ∀ i ∈ c.supp, ∀ j ∈ d.supp,
          ∀ a ∈ I i \ X, ∀ b ∈ I j \ X, ¬ G.Adj a b := by
  classical
  let E := selectedCrossGlobalEndpointFinset M
  let U : ι → Finset V := fun i => I i \ E
  let H₁ : SimpleGraph ι := SelectedCrossEdgeGraph M
  let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
  let cover : SelectedCrossEdge V ι → Finset V := fun e =>
    if hsmall : ¬ HasCrossMatchingAtLeast G (U e.1.1) (U e.1.2) R then
      Classical.choose
        (exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
          G (U e.1.1) (U e.1.2) R hsmall)
    else ∅
  let Y : Finset V := M.biUnion cover
  let X : Finset V := E ∪ Y
  have hcoverCard : ∀ e ∈ M, (cover e).card ≤ 2 * R := by
    intro e _he
    by_cases hsmall : ¬ HasCrossMatchingAtLeast G (U e.1.1) (U e.1.2) R
    · simp only [cover, dif_pos hsmall]
      exact Nat.le_of_lt (Classical.choose_spec
        (exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
          G (U e.1.1) (U e.1.2) R hsmall)).1
    · have hempty : cover e = ∅ := by simp [cover, hsmall]
      rw [hempty, Finset.card_empty]
      exact Nat.zero_le _
  have hYcard : Y.card ≤ M.card * (2 * R) :=
    Finset.card_biUnion_le_card_mul M cover _ hcoverCard
  have hEcard : E.card ≤ 2 * M.card := by
    simpa [E] using card_selectedCrossGlobalEndpointFinset_le M
  have hXcard : X.card ≤ (2 * R + 2) * M.card := by
    calc
      X.card ≤ E.card + Y.card := by
        simpa [X] using Finset.card_union_le E Y
      _ ≤ 2 * M.card + M.card * (2 * R) := Nat.add_le_add hEcard hYcard
      _ = (2 * R + 2) * M.card := by ring
  refine ⟨X, hXcard, Finset.subset_union_left, ?_⟩
  intro c d hcd i hic j hjd
  have hij : i ≠ j := by
    intro h
    subst j
    exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hic hjd)
  have hnotH : ¬ H.Adj i j := by
    intro hijH
    have hci : H.connectedComponentMk i = c :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff c i).mp hic
    have hdj : H.connectedComponentMk j = d :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff d j).mp hjd
    apply hcd
    rw [← hci, ← hdj]
    exact SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hijH
  intro a ha b hb hab
  have haI : a ∈ I i := (Finset.mem_sdiff.mp ha).1
  have hbI : b ∈ I j := (Finset.mem_sdiff.mp hb).1
  have haE : a ∉ E := fun haE =>
    (Finset.mem_sdiff.mp ha).2 (Finset.mem_union_left Y haE)
  have hbE : b ∉ E := fun hbE =>
    (Finset.mem_sdiff.mp hb).2 (Finset.mem_union_left Y hbE)
  by_cases hijH₁ : H₁.Adj i j
  · obtain ⟨e, heM, horient⟩ :=
      exists_selectedCrossEdge_of_graph_adj (M := M) hijH₁
    have hevalid := hM.1 e heM
    have hsmall : ¬ HasCrossMatchingAtLeast G (U e.1.1) (U e.1.2) R := by
      intro hlarge
      have heH : H.Adj e.1.1 e.1.2 := by
        change (LargeCrossMatchingGraph G U R).Adj e.1.1 e.1.2
        rw [LargeCrossMatchingGraph, SimpleGraph.fromRel_adj]
        exact ⟨hevalid.1, Or.inl hlarge⟩
      apply hnotH
      rcases horient with hdir | hrev
      · rcases hdir with ⟨h₁, h₂⟩
        simpa [h₁, h₂] using heH
      · rcases hrev with ⟨h₁, h₂⟩
        simpa [h₁, h₂] using heH.symm
    have hcoverSpec : ∀ x ∈ U e.1.1 \ cover e,
        ∀ y ∈ U e.1.2 \ cover e, ¬ G.Adj x y := by
      simp only [cover, dif_pos hsmall]
      exact (Classical.choose_spec
        (exists_small_cross_vertexCover_of_not_hasCrossMatchingAtLeast
          G (U e.1.1) (U e.1.2) R hsmall)).2
    have hcoverSubY : cover e ⊆ Y :=
      Finset.subset_biUnion_of_mem cover heM
    have haCover : a ∉ cover e := fun h =>
      (Finset.mem_sdiff.mp ha).2
        (Finset.mem_union_right E (hcoverSubY h))
    have hbCover : b ∉ cover e := fun h =>
      (Finset.mem_sdiff.mp hb).2
        (Finset.mem_union_right E (hcoverSubY h))
    rcases horient with hdir | hrev
    · rcases hdir with ⟨h₁, h₂⟩
      subst i
      subst j
      exact hcoverSpec a (Finset.mem_sdiff.mpr
          ⟨Finset.mem_sdiff.mpr ⟨haI, haE⟩, haCover⟩)
        b (Finset.mem_sdiff.mpr
          ⟨Finset.mem_sdiff.mpr ⟨hbI, hbE⟩, hbCover⟩) hab
    · rcases hrev with ⟨h₁, h₂⟩
      subst j
      subst i
      exact hcoverSpec b (Finset.mem_sdiff.mpr
          ⟨Finset.mem_sdiff.mpr ⟨hbI, hbE⟩, hbCover⟩)
        a (Finset.mem_sdiff.mpr
          ⟨Finset.mem_sdiff.mpr ⟨haI, haE⟩, haCover⟩) hab.symm
  · have haLocal : a ∈ I i \ selectedCrossEndpointFinset M i :=
      Finset.mem_sdiff.mpr ⟨haI, fun hlocal => haE
        (selectedCrossEndpointFinset_subset_global M i hlocal)⟩
    have hbLocal : b ∈ I j \ selectedCrossEndpointFinset M j :=
      Finset.mem_sdiff.mpr ⟨hbI, fun hlocal => hbE
        (selectedCrossEndpointFinset_subset_global M j hlocal)⟩
    exact anticomplete_sdiff_selectedCrossEndpointFinset_of_maximal
      G I M hM hmax hdisj hij (by simpa [H₁] using hijH₁)
        a haLocal b hbLocal hab

/-- A maximum independent set in a finite graph dominates every vertex.
If all degrees are at most `Δ`, its closed neighbourhoods give the standard
cardinality bound `|V| ≤ α(H) * (Δ + 1)`. -/
theorem exists_indepSet_card_mul_succ_ge_of_degree_le
    {ι : Type*} [Fintype ι] (H : SimpleGraph ι) [DecidableRel H.Adj]
    {Δ : ℕ} (hdeg : ∀ i, H.degree i ≤ Δ) :
    ∃ S : Finset ι, H.IsIndepSet (S : Set ι) ∧
      Fintype.card ι ≤ S.card * (Δ + 1) := by
  classical
  obtain ⟨S, hSmax⟩ := H.maximumIndepSet_exists
  have hcover : (Finset.univ : Finset ι) ⊆
      S.biUnion fun i => insert i (H.neighborFinset i) := by
    intro v _hv
    by_cases hvS : v ∈ S
    · exact Finset.mem_biUnion.mpr ⟨v, hvS, by simp⟩
    · have hex : ∃ i ∈ S, H.Adj i v := by
        by_contra hno
        push_neg at hno
        have hind : H.IsIndepSet ((insert v S : Finset ι) : Set ι) := by
          rw [SimpleGraph.isIndepSet_iff]
          intro a ha b hb hab
          change a ∈ insert v S at ha
          change b ∈ insert v S at hb
          simp only [Finset.mem_insert] at ha hb
          rcases ha with rfl | haS <;> rcases hb with rfl | hbS
          · exact (hab rfl).elim
          · exact fun hvb => hno b hbS hvb.symm
          · exact fun hav => hno a haS hav
          · exact (H.isIndepSet_iff.mp hSmax.isIndepSet) haS hbS hab
        have hlarge := hSmax.maximum (insert v S) hind
        simp [hvS] at hlarge
      obtain ⟨i, hiS, hiv⟩ := hex
      exact Finset.mem_biUnion.mpr ⟨i, hiS, by simp [hiv]⟩
  have hpiece : ∀ i ∈ S,
      (insert i (H.neighborFinset i)).card ≤ Δ + 1 := by
    intro i _hi
    have hcard : (insert i (H.neighborFinset i)).card ≤
        (H.neighborFinset i).card + 1 :=
      Finset.card_insert_le i (H.neighborFinset i)
    rw [H.card_neighborFinset_eq_degree] at hcard
    exact hcard.trans (Nat.add_le_add_right (hdeg i) 1)
  refine ⟨S, hSmax.isIndepSet, ?_⟩
  calc
    Fintype.card ι = (Finset.univ : Finset ι).card := by simp
    _ ≤ (S.biUnion fun i => insert i (H.neighborFinset i)).card :=
      Finset.card_le_card hcover
    _ ≤ S.card * (Δ + 1) :=
      Finset.card_biUnion_le_card_mul _ _ _ hpiece

/-- Average-degree form of the preceding independent-set estimate, tailored
to the KLS class-transversal argument.  If a finite graph has no simple path
of length at least `D`, Erdős--Gallai bounds its edge count.  At least half
of its vertices then have degree below `4D`; a maximum independent set in
that induced low-degree graph has size large enough that eight times `D`
times its cardinality covers the whole vertex set. -/
theorem exists_indepSet_eight_mul_pathThreshold_mul_card_ge_of_no_long_path
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (H : SimpleGraph ι) [DecidableRel H.Adj] {D : ℕ} (hD : 0 < D)
    (hno : ¬ ∃ u v : ι, ∃ p : H.Walk u v,
      p.IsPath ∧ D ≤ p.length) :
    ∃ S : Finset ι, H.IsIndepSet (S : Set ι) ∧
      (∀ i ∈ S, H.degree i < 4 * D) ∧
      Fintype.card ι ≤ 8 * D * S.card := by
  classical
  let low : Finset ι :=
    (Finset.univ : Finset ι).filter fun i => H.degree i < 4 * D
  let high : Finset ι := (Finset.univ : Finset ι) \ low
  have hlowSub : low ⊆ (Finset.univ : Finset ι) := Finset.subset_univ low
  have hlowCard : low.card ≤ Fintype.card ι := by
    simpa using Finset.card_le_card hlowSub
  have hcards : high.card + low.card = Fintype.card ι := by
    dsimp [high]
    rw [Finset.card_sdiff]
    simpa using Nat.sub_add_cancel hlowCard
  have hhighDegree : ∀ i ∈ high, 4 * D ≤ H.degree i := by
    intro i hi
    have hi' := Finset.mem_sdiff.mp hi
    have hinot : ¬ H.degree i < 4 * D := by
      intro hlt
      apply hi'.2
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hlt⟩
    omega
  have hedge := card_edgeFinset_lt_mul_card_of_no_long_path H D hno
  have hsumDegree : (∑ i : ι, H.degree i) = 2 * H.edgeFinset.card :=
    H.sum_degrees_eq_twice_card_edges
  have hhighSum : 4 * D * high.card ≤ ∑ i ∈ high, H.degree i := by
    calc
      4 * D * high.card = ∑ _i ∈ high, 4 * D := by
        simp [Nat.mul_comm]
      _ ≤ ∑ i ∈ high, H.degree i := by
        apply Finset.sum_le_sum
        intro i hi
        exact hhighDegree i hi
  have hhighSumAll : (∑ i ∈ high, H.degree i) ≤ ∑ i : ι, H.degree i := by
    exact Finset.sum_le_univ_sum_of_nonneg (fun _ => Nat.zero_le _)
  have hlowHalf : Fintype.card ι ≤ 2 * low.card := by
    by_contra hnot
    have hhighHalf : Fintype.card ι < 2 * high.card := by omega
    have hstrict : 2 * D * Fintype.card ι < 4 * D * high.card := by
      nlinarith
    have hedge' : 2 * H.edgeFinset.card < 2 * D * Fintype.card ι := by
      simpa [Nat.mul_assoc] using
        (Nat.mul_lt_mul_left (by omega : 0 < 2)).mpr hedge
    have : 4 * D * high.card ≤ 2 * H.edgeFinset.card := by
      calc
        4 * D * high.card ≤ ∑ i ∈ high, H.degree i := hhighSum
        _ ≤ ∑ i : ι, H.degree i := hhighSumAll
        _ = 2 * H.edgeFinset.card := hsumDegree
    omega
  let K : SimpleGraph low := H.induce (low : Set ι)
  have hKdegree : ∀ v : low, K.degree v ≤ 4 * D - 1 := by
    intro v
    have hvlow : H.degree v.1 < 4 * D :=
      (Finset.mem_filter.mp v.2).2
    have hdegLe : K.degree v ≤ H.degree v.1 := by
      let f : K.neighborSet v → H.neighborSet v.1 :=
        fun w => ⟨w.1.1, w.2⟩
      have hf : Function.Injective f := by
        intro a b hab
        have hab0 : (f a).1 = (f b).1 :=
          congrArg (fun x : H.neighborSet v.1 => x.1) hab
        exact Subtype.ext (Subtype.ext hab0)
      rw [← K.card_neighborSet_eq_degree,
        ← H.card_neighborSet_eq_degree]
      exact Fintype.card_le_of_injective f hf
    omega
  obtain ⟨T, hTind, hTcard⟩ :=
    exists_indepSet_card_mul_succ_ge_of_degree_le
      K (Δ := 4 * D - 1) hKdegree
  let e : low ↪ ι := ⟨Subtype.val, Subtype.val_injective⟩
  let S : Finset ι := T.map e
  have hScard : S.card = T.card := by simp [S]
  have hSind : H.IsIndepSet (S : Set ι) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_map.mp ha with ⟨a', haT, rfl⟩
    rcases Finset.mem_map.mp hb with ⟨b', hbT, rfl⟩
    have hab' : a' ≠ b' := by
      intro h
      apply hab
      exact congrArg Subtype.val h
    have hnotAdj := (K.isIndepSet_iff.mp hTind) haT hbT hab'
    simpa [K, e] using hnotAdj
  refine ⟨S, hSind, ?_, ?_⟩
  · intro i hi
    rcases Finset.mem_map.mp hi with ⟨i', _hiT, rfl⟩
    exact (Finset.mem_filter.mp i'.2).2
  have hlowBound : low.card ≤ T.card * (4 * D) := by
    have hTD : T.card * ((4 * D - 1) + 1) = T.card * (4 * D) := by
      congr 1
      omega
    simpa [K, hTD] using hTcard
  calc
    Fintype.card ι ≤ 2 * low.card := hlowHalf
    _ ≤ 2 * (T.card * (4 * D)) := Nat.mul_le_mul_left 2 hlowBound
    _ = 8 * D * S.card := by rw [hScard]; ring

/-- The ambient counting half of the KLS class-transversal argument.  If
the interaction graph on disjoint independent classes has no path of length
`D`, the preceding low-degree lemma supplies an independent set of class
indices.  Its classes are pairwise anticomplete in the ambient graph, so
their disjoint union is an ambient independent set. -/
theorem mul_fintypeCard_lt_eight_mul_pathThreshold_mul_of_no_long_hubInteraction_path
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) {n σ D : ℕ}
    (hσ : 0 < σ) (hD : 0 < D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    (hno : ¬ ∃ u v : ι, ∃ p : (HubInteractionGraph G I).Walk u v,
      p.IsPath ∧ D ≤ p.length) :
    σ * Fintype.card ι < 8 * D * n := by
  classical
  let H : SimpleGraph ι := HubInteractionGraph G I
  obtain ⟨S, hSind, _hSdegree, hScard⟩ :=
    exists_indepSet_eight_mul_pathThreshold_mul_card_ge_of_no_long_path
      H hD hno
  let F : Finset (Finset V) := S.image I
  have hIne : ∀ i, (I i).Nonempty := by
    intro i
    exact Finset.card_pos.mp (hσ.trans_le (hIcard i))
  have hIinj : Set.InjOn I (S : Set ι) := by
    intro i hi j hj hij
    by_contra hne
    obtain ⟨v, hv⟩ := hIne i
    have hvj : v ∈ I j := by rw [← hij]; exact hv
    exact (Finset.disjoint_left.mp (hdisj i j hne)) hv hvj
  have hFcard : F.card = S.card := Finset.card_image_of_injOn hIinj
  have hFdisj : DisjointFinsetFamily F := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, hj, rfl⟩
    apply hdisj i j
    intro hij
    subst j
    exact hAB rfl
  have hFanti : PairwiseAnticomplete G F := by
    intro A hA B hB hAB a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB rfl
    have hAdj : H.Adj i j := by
      change (HubInteractionGraph G I).Adj i j
      rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      exact ⟨hij, Or.inl ⟨a, ha, b, hb, hab⟩⟩
    exact (H.isIndepSet_iff.mp hSind) hi hj hij hAdj
  have hFind : ∀ A ∈ F, G.IsIndepSet (A : Set V) := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hIind i
  have hFsize : ∀ A ∈ F, σ ≤ A.card := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hIcard i
  have hsumlt : ∑ A ∈ F, A.card < n :=
    sum_card_lt_of_disjoint_pairwiseAnticomplete_indep
      G hfree hFdisj hFanti hFind
  have hsmall : σ * S.card < n := by
    rw [← hFcard]
    calc
      σ * F.card = ∑ _A ∈ F, σ := by simp [Nat.mul_comm]
      _ ≤ ∑ A ∈ F, A.card := by
        apply Finset.sum_le_sum
        intro A hA
        exact hFsize A hA
      _ < n := hsumlt
  calc
    σ * Fintype.card ι ≤ σ * (8 * D * S.card) :=
      Nat.mul_le_mul_left σ hScard
    _ = (8 * D) * (σ * S.card) := by ring
    _ < (8 * D) * n :=
      Nat.mul_lt_mul_of_pos_left hsmall (by omega)
    _ = 8 * D * n := by ring

/-- Source-faithful transversal count for a maximal globally selected edge
system.  Under exclusion of a `D`-long auxiliary path, choose the low-degree
independent label set supplied by Erdős--Gallai.  Each selected system
charges fewer than `4D` endpoints to such a class, and maximality makes the
uncovered class remainders pairwise anticomplete.  Their union is therefore
one ambient independent set. -/
theorem sub_four_mul_pathThreshold_mul_fintypeCard_lt_of_maximal_selected_no_long_path
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) (M : Finset (SelectedCrossEdge V ι))
    {n σ D : ℕ} (hD : 0 < D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hmax : ∀ N : Finset (SelectedCrossEdge V ι),
      IsSelectedCrossEdgeSystem G I N → N.card ≤ M.card)
    (hno : ¬ ∃ u v : ι, ∃ p : (SelectedCrossEdgeGraph M).Walk u v,
      p.IsPath ∧ D ≤ p.length) :
    (σ - 4 * D) * Fintype.card ι < 8 * D * n := by
  classical
  let H : SimpleGraph ι := SelectedCrossEdgeGraph M
  obtain ⟨S, hSind, hSdegree, hScard⟩ :=
    exists_indepSet_eight_mul_pathThreshold_mul_card_ge_of_no_long_path
      H hD hno
  let J : ι → Finset V := fun i => I i \ selectedCrossEndpointFinset M i
  have hJcard : ∀ i ∈ S, σ - 4 * D ≤ (J i).card := by
    intro i hi
    have hEcard : (selectedCrossEndpointFinset M i).card ≤ 4 * D := by
      have hdegree : (selectedCrossEndpointFinset M i).card ≤ H.degree i := by
        simpa [H] using card_selectedCrossEndpointFinset_le_degree G I M hM i
      exact hdegree.trans (Nat.le_of_lt (hSdegree i hi))
    exact sub_le_card_sdiff_of_le_card_of_card_le (hIcard i) hEcard
  have hJpair : (S : Set ι).PairwiseDisjoint J := by
    intro i hi j hj hij
    exact (hdisj i j hij).mono Finset.sdiff_subset Finset.sdiff_subset
  let U : Finset V := S.biUnion J
  have hUind : G.IsIndepSet (U : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_biUnion.mp ha with ⟨i, hi, hai⟩
    rcases Finset.mem_biUnion.mp hb with ⟨j, hj, hbj⟩
    by_cases hij : i = j
    · subst j
      exact (G.isIndepSet_iff.mp (hIind i))
        (Finset.sdiff_subset hai) (Finset.sdiff_subset hbj) hab
    · have hnotH : ¬ H.Adj i j :=
        (H.isIndepSet_iff.mp hSind) hi hj hij
      exact anticomplete_sdiff_selectedCrossEndpointFinset_of_maximal
        G I M hM hmax hdisj hij (by simpa [H] using hnotH)
          a hai b hbj
  have hUcard : U.card < n := Erdos551.IndepSetFree.card_lt hfree hUind
  have hsum : U.card = ∑ i ∈ S, (J i).card := by
    simpa [U] using Finset.card_biUnion hJpair
  have hsmall : (σ - 4 * D) * S.card < n := by
    calc
      (σ - 4 * D) * S.card = ∑ _i ∈ S, (σ - 4 * D) := by
        simp [Nat.mul_comm]
      _ ≤ ∑ i ∈ S, (J i).card := by
        apply Finset.sum_le_sum
        intro i hi
        exact hJcard i hi
      _ = U.card := hsum.symm
      _ < n := hUcard
  calc
    (σ - 4 * D) * Fintype.card ι ≤
        (σ - 4 * D) * (8 * D * S.card) :=
      Nat.mul_le_mul_left (σ - 4 * D) hScard
    _ = (8 * D) * ((σ - 4 * D) * S.card) := by ring
    _ < (8 * D) * n :=
      Nat.mul_lt_mul_of_pos_left hsmall (by omega)
    _ = 8 * D * n := by ring

/-- Localized selected-edge path/count dichotomy for a separated family of
label cores.  We choose one maximum selected system on the union of all
cores, rather than choosing unrelated systems core by core.  Pairwise
anticompleteness in the ordinary hub-interaction graph then forces every
selected path into one actual core.  If there is no long selected path, the
global selected-endpoint transversal estimate applies on the whole union;
the factor-four charge for the separated cores turns its factor `8` into
`32`. -/
theorem exists_localized_selected_path_or_sub_four_mul_card_lt
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) (C : Finset (Finset ι))
    {n σ D : ℕ} (hD : 0 < D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    (hCne : C.Nonempty)
    (hmemne : ∀ A ∈ C, A.Nonempty)
    (hCdisj : DisjointFinsetFamily C)
    (hCanti : PairwiseAnticomplete (HubInteractionGraph G I) C)
    (hcover : Fintype.card ι ≤ 4 * ∑ A ∈ C, A.card) :
    (∃ A ∈ C, ∃ u v : ι, ∃ p : (HubInteractionGraph G I).Walk u v,
      p.IsPath ∧ D ≤ p.length ∧ ∀ z ∈ p.support, z ∈ A) ∨
      (σ - 4 * D) * Fintype.card ι < 32 * D * n := by
  classical
  let L : Finset ι := C.biUnion id
  have hLne : L.Nonempty := by
    obtain ⟨A, hA⟩ := hCne
    obtain ⟨i, hi⟩ := hmemne A hA
    exact ⟨i, Finset.mem_biUnion.mpr ⟨A, hA, hi⟩⟩
  let ρ := {i : ι // i ∈ L}
  let : Nonempty ρ := hLne.to_subtype
  let J : ρ → Finset V := fun i => I i.1
  obtain ⟨M, hM, hmax⟩ := exists_maximal_selectedCrossEdgeSystem G J
  by_cases hpath : ∃ u v : ρ, ∃ p : (SelectedCrossEdgeGraph M).Walk u v,
      p.IsPath ∧ D ≤ p.length
  · left
    obtain ⟨u, v, p, hp, hplen⟩ := hpath
    let K : SimpleGraph ι := HubInteractionGraph G I
    let e : SelectedCrossEdgeGraph M →g K :=
      { toFun := Subtype.val
        map_rel' := by
          intro i j hij
          obtain ⟨_r, _hrM, _hrpair, x, y, hx, hy, hxy, _hxend, _hyend⟩ :=
            exists_oriented_selectedCrossEdge_of_graph_adj hM hij
          have hijval : i.1 ≠ j.1 := by
            intro hval
            exact hij.ne (Subtype.ext hval)
          change (HubInteractionGraph G I).Adj i.1 j.1
          rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
          refine ⟨hijval, Or.inl ?_⟩
          exact ⟨x, by simpa [J] using hx,
            y, by simpa [J] using hy, hxy⟩ }
    let q : K.Walk (e u) (e v) := p.map e
    have hqsupp : ∀ z ∈ q.support, z ∈ C.biUnion id := by
      intro z hz
      dsimp [q] at hz
      rw [Walk.support_map] at hz
      rcases List.mem_map.mp hz with ⟨w, _hw, rfl⟩
      exact w.property
    obtain ⟨A, hA, hqA⟩ :=
      exists_member_containing_walk_support_of_pairwiseAnticomplete
        K (by simpa [K] using hCanti) q hqsupp
    refine ⟨A, hA, e u, e v, q, hp.map Subtype.val_injective, ?_, hqA⟩
    simpa [q] using hplen
  · right
    have hJcard : ∀ i, σ ≤ (J i).card := by
      intro i
      simpa [J] using hIcard i.1
    have hJind : ∀ i, G.IsIndepSet (J i : Set V) := by
      intro i
      simpa [J] using hIind i.1
    have hJdisj : ∀ i j : ρ, i ≠ j → Disjoint (J i) (J j) := by
      intro i j hij
      apply hdisj i.1 j.1
      intro hval
      exact hij (Subtype.ext hval)
    have hsmall : (σ - 4 * D) * Fintype.card ρ < 8 * D * n :=
      sub_four_mul_pathThreshold_mul_fintypeCard_lt_of_maximal_selected_no_long_path
        G J M hD hfree hJcard hJind hJdisj hM hmax hpath
    have hpair : (C : Set (Finset ι)).PairwiseDisjoint id := by
      intro A hA B hB hAB
      exact hCdisj A (by simpa using hA) B (by simpa using hB) hAB
    have hLcard : L.card = ∑ A ∈ C, A.card := by
      simpa [L] using Finset.card_biUnion hpair
    have hρcard : Fintype.card ρ = L.card := by
      simp [ρ]
    have hcharge : Fintype.card ι ≤ 4 * Fintype.card ρ := by
      rw [hρcard, hLcard]
      exact hcover
    calc
      (σ - 4 * D) * Fintype.card ι ≤
          (σ - 4 * D) * (4 * Fintype.card ρ) :=
        Nat.mul_le_mul_left (σ - 4 * D) hcharge
      _ = 4 * ((σ - 4 * D) * Fintype.card ρ) := by ring
      _ < 4 * (8 * D * n) := Nat.mul_lt_mul_of_pos_left hsmall (by omega)
      _ = 32 * D * n := by ring

/-- Provenance-preserving form of the localized selected path/count
dichotomy.  In the path branch the maximum selected system is relabelled
back from the covered subtype to the original label type, and the returned
path lives in that valid global system.  This is the information needed to
retain fresh attachments after the later ordinary BFS closure. -/
theorem exists_localized_selected_system_path_or_sub_four_mul_card_lt
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) (C : Finset (Finset ι))
    {n σ D : ℕ} (hD : 0 < D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j))
    (hCne : C.Nonempty)
    (hmemne : ∀ A ∈ C, A.Nonempty)
    (hCdisj : DisjointFinsetFamily C)
    (hCanti : PairwiseAnticomplete (HubInteractionGraph G I) C)
    (hcover : Fintype.card ι ≤ 4 * ∑ A ∈ C, A.card) :
    (∃ M : Finset (SelectedCrossEdge V ι),
      IsSelectedCrossEdgeSystem G I M ∧
      ∃ A ∈ C, ∃ u v : ι,
        ∃ p : (SelectedCrossEdgeGraph M).Walk u v,
          p.IsPath ∧ D ≤ p.length ∧ ∀ z ∈ p.support, z ∈ A) ∨
      (σ - 4 * D) * Fintype.card ι < 32 * D * n := by
  classical
  let L : Finset ι := C.biUnion id
  have hLne : L.Nonempty := by
    obtain ⟨A, hA⟩ := hCne
    obtain ⟨i, hi⟩ := hmemne A hA
    exact ⟨i, Finset.mem_biUnion.mpr ⟨A, hA, hi⟩⟩
  let ρ := {i : ι // i ∈ L}
  let : Nonempty ρ := hLne.to_subtype
  let J : ρ → Finset V := fun i => I i.1
  obtain ⟨M, hM, hmax⟩ := exists_maximal_selectedCrossEdgeSystem G J
  by_cases hpath : ∃ u v : ρ,
      ∃ p : (SelectedCrossEdgeGraph M).Walk u v,
        p.IsPath ∧ D ≤ p.length
  · left
    obtain ⟨u, v, p, hp, hplen⟩ := hpath
    let emb : ρ ↪ ι := ⟨Subtype.val, Subtype.val_injective⟩
    let M' : Finset (SelectedCrossEdge V ι) :=
      mapSelectedCrossEdgeSystem emb M
    have hM' : IsSelectedCrossEdgeSystem G I M' := by
      dsimp [M']
      apply hM.map_labels emb
      intro i
      simp [J, emb]
    let eSel : SelectedCrossEdgeGraph M →g SelectedCrossEdgeGraph M' :=
      selectedCrossEdgeGraphMapLabelsHom emb M
    let p' : (SelectedCrossEdgeGraph M').Walk u.1 v.1 := p.map eSel
    have hp' : p'.IsPath := hp.map Subtype.val_injective
    have hp'len : p'.length = p.length := by
      exact p.length_map eSel
    let K : SimpleGraph ι := HubInteractionGraph G I
    let eK : SelectedCrossEdgeGraph M' →g K :=
      { toFun := id
        map_rel' := by
          intro i j hij
          obtain ⟨_r, _hrM, _hrpair, x, y, hx, hy, hxy,
              _hxend, _hyend⟩ :=
            exists_oriented_selectedCrossEdge_of_graph_adj hM' hij
          change (HubInteractionGraph G I).Adj i j
          rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
          exact ⟨hij.ne, Or.inl ⟨x, hx, y, hy, hxy⟩⟩ }
    let q : K.Walk u.1 v.1 := p'.map eK
    have hqsupp : ∀ z ∈ q.support, z ∈ C.biUnion id := by
      intro z hz
      dsimp only [q] at hz
      rw [Walk.support_map] at hz
      rcases List.mem_map.mp hz with ⟨w, hw, rfl⟩
      dsimp only [p'] at hw
      have hmem : (w ∈ (p.map eSel).support) =
          (w ∈ p.support.map eSel) :=
        congrArg (fun s => w ∈ s) (Walk.support_map eSel p)
      have hw' : w ∈ p.support.map eSel := Eq.mp hmem hw
      rcases List.mem_map.mp hw' with ⟨x, hx, rfl⟩
      exact x.property
    obtain ⟨A, hA, hqA⟩ :=
      exists_member_containing_walk_support_of_pairwiseAnticomplete
        K (by simpa [K] using hCanti) q hqsupp
    refine ⟨M', hM', A, hA, u.1, v.1, p', hp', ?_, ?_⟩
    · simpa [hp'len] using hplen
    · intro z hz
      apply hqA z
      simpa [q, eK, Walk.support_map] using hz
  · right
    have hJcard : ∀ i, σ ≤ (J i).card := by
      intro i
      simpa [J] using hIcard i.1
    have hJind : ∀ i, G.IsIndepSet (J i : Set V) := by
      intro i
      simpa [J] using hIind i.1
    have hJdisj : ∀ i j : ρ, i ≠ j → Disjoint (J i) (J j) := by
      intro i j hij
      apply hdisj i.1 j.1
      intro hval
      exact hij (Subtype.ext hval)
    have hsmall : (σ - 4 * D) * Fintype.card ρ < 8 * D * n :=
      sub_four_mul_pathThreshold_mul_fintypeCard_lt_of_maximal_selected_no_long_path
        G J M hD hfree hJcard hJind hJdisj hM hmax hpath
    have hpair : (C : Set (Finset ι)).PairwiseDisjoint id := by
      intro A hA B hB hAB
      exact hCdisj A (by simpa using hA) B (by simpa using hB) hAB
    have hLcard : L.card = ∑ A ∈ C, A.card := by
      simpa [L] using Finset.card_biUnion hpair
    have hρcard : Fintype.card ρ = L.card := by
      simp [ρ]
    have hcharge : Fintype.card ι ≤ 4 * Fintype.card ρ := by
      rw [hρcard, hLcard]
      exact hcover
    calc
      (σ - 4 * D) * Fintype.card ι ≤
          (σ - 4 * D) * (4 * Fintype.card ρ) :=
        Nat.mul_le_mul_left (σ - 4 * D) hcharge
      _ = 4 * ((σ - 4 * D) * Fintype.card ρ) := by ring
      _ < 4 * (8 * D * n) := Nat.mul_lt_mul_of_pos_left hsmall (by omega)
      _ = 32 * D * n := by ring

/-- Path/count dichotomy in the exact form used by the KLS stability step:
either the auxiliary interaction graph contains a simple path of length at
least `D`, or the number of disjoint independent classes satisfies the
quantitative transversal bound. -/
theorem exists_long_hubInteraction_path_or_mul_fintypeCard_lt
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) {n σ D : ℕ}
    (hσ : 0 < σ) (hD : 0 < D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j)) :
    (∃ u v : ι, ∃ p : (HubInteractionGraph G I).Walk u v,
      p.IsPath ∧ D ≤ p.length) ∨
      σ * Fintype.card ι < 8 * D * n := by
  by_cases hpath : ∃ u v : ι,
      ∃ p : (HubInteractionGraph G I).Walk u v,
        p.IsPath ∧ D ≤ p.length
  · exact Or.inl hpath
  · exact Or.inr
      (mul_fintypeCard_lt_eight_mul_pathThreshold_mul_of_no_long_hubInteraction_path
        G I hσ hD hfree hIcard hIind hdisj hpath)

/-- Bounded ordinary interaction sharply counts parity-unbroken cores.  A
maximum independent set of core indices has no cross-edges; deleting four
vertices inside every parity-unbroken core then gives one ambient independent
set.  Combining this with the preceding domination bound yields the stated
global estimate. -/
theorem mul_card_lt_of_unbroken_hubInteraction
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U B : ι → Finset V) {n σ Δ : ℕ}
    (hσ : 0 < σ)
    (hfree : G.IndepSetFree n)
    (hBU : ∀ i, B i ⊆ U i)
    (hBcard : ∀ i, σ ≤ (B i).card)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j))
    (hunbroken : ∀ i, ¬ HasThreeDisjointAdjPairFamily G (U i))
    (hdeg : ∀ i, (HubInteractionGraph G B).degree i ≤ Δ) :
    (σ - 4) * Fintype.card ι < n * (Δ + 1) := by
  classical
  let H : SimpleGraph ι := HubInteractionGraph G B
  obtain ⟨S, hSind, hcardS⟩ :=
    exists_indepSet_card_mul_succ_ge_of_degree_le H hdeg
  let F : Finset (Finset V) := S.image B
  have hBne : ∀ i, (B i).Nonempty := by
    intro i
    exact Finset.card_pos.mp (hσ.trans_le (hBcard i))
  have hBinj : Set.InjOn B (S : Set ι) := by
    intro i hi j hj hij
    by_contra hne
    obtain ⟨v, hv⟩ := hBne i
    have hvj : v ∈ B j := by rw [← hij]; exact hv
    exact (Finset.disjoint_left.mp
      ((hdisj i j hne).mono (hBU i) (hBU j))) hv hvj
  have hFcard : F.card = S.card := Finset.card_image_of_injOn hBinj
  have hFdisj : DisjointFinsetFamily F := by
    intro A hA C hC hAC
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨j, hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAC rfl
    exact (hdisj i j hij).mono (hBU i) (hBU j)
  have hFanti : PairwiseAnticomplete G F := by
    intro A hA C hC hAC a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨j, hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAC rfl
    have hAdj : H.Adj i j := by
      change (HubInteractionGraph G B).Adj i j
      rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      exact ⟨hij, Or.inl ⟨a, ha, b, hb, hab⟩⟩
    exact (H.isIndepSet_iff.mp hSind) hi hj hij hAdj
  have hFnot : ∀ A ∈ F, ¬ HasThreeDisjointAdjPairFamily G A := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact not_hasThreeDisjointAdjPairFamily_of_subset (hBU i) (hunbroken i)
  have hFsize : ∀ A ∈ F, σ ≤ A.card := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hBcard i
  have hsmall : (σ - 4) * F.card < n :=
    mul_card_sub_four_lt_of_disjoint_pairwiseAnticomplete_not_hasThree
      G hfree hFdisj hFanti hFnot hFsize
  rw [hFcard] at hsmall
  calc
    (σ - 4) * Fintype.card ι ≤
        (σ - 4) * (S.card * (Δ + 1)) :=
      Nat.mul_le_mul_left (σ - 4) hcardS
    _ = ((σ - 4) * S.card) * (Δ + 1) := by
      simp [Nat.mul_assoc]
    _ < n * (Δ + 1) := by
      exact Nat.mul_lt_mul_of_pos_right hsmall (by omega)

/-- No-repeated-attachment form of the parity-unbroken count.  The ordinary
interaction degree bound is discharged from the core size bound, leaving a
statement that applies directly to a selected subtype of unbroken cores. -/
theorem mul_card_lt_of_unbroken_no_repeated_attachment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U B : ι → Finset V) {n σ Δ : ℕ}
    (hσ : 0 < σ)
    (hfree : G.IndepSetFree n)
    (hBU : ∀ i, B i ⊆ U i)
    (hBcard : ∀ i, σ ≤ (B i).card)
    (hUcard : ∀ i, (U i).card ≤ Δ)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j))
    (hunbroken : ∀ i, ¬ HasThreeDisjointAdjPairFamily G (U i))
    (hnorep : ∀ i j ℓ : ι, i ≠ j → i ≠ ℓ → j ≠ ℓ →
      ∀ x ∈ B i, ∀ y ∈ U j, ∀ z ∈ U ℓ,
        G.Adj x y → G.Adj x z → False) :
    (σ - 4) * Fintype.card ι < n * (Δ + 1) := by
  apply mul_card_lt_of_unbroken_hubInteraction
    G U B hσ hfree hBU hBcard hdisj hunbroken
  intro i
  exact (degree_hubInteractionGraph_le_card_of_no_repeated_attachment
    G U B hBU hdisj hnorep i).trans (hUcard i)

/-- For the exact `9 * sqrt k` core family, the preceding count can be
applied directly to the subtype of parity-unbroken cores.  The retained part
of each such core is obtained by deleting the canonical repeated-attachment
set of the full family; using the full family here is important, since it
makes the no-repeated-attachment conclusion automatic. -/
theorem card_unbroken_exact_cores_bound_after_RepeatedAttachmentFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) {n k σ : ℕ}
    (hσ : 0 < σ)
    (hfree : G.IndepSetFree n)
    (hU : ∀ i, (U i).card = 9 * Nat.sqrt k)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j))
    (hretain : ∀ i, ¬ HasThreeDisjointAdjPairFamily G (U i) →
      σ ≤ (U i \ RepeatedAttachmentFinset G U).card) :
    (σ - 4) *
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (U i)} <
      n * (9 * Nat.sqrt k + 1) := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (U i)}
  let UJ : J → Finset V := fun i => U i.1
  let BJ : J → Finset V :=
    fun i => U i.1 \ RepeatedAttachmentFinset G U
  apply mul_card_lt_of_unbroken_no_repeated_attachment
    G UJ BJ (n := n) (σ := σ) (Δ := 9 * Nat.sqrt k) hσ hfree
  · intro i
    exact Finset.sdiff_subset
  · intro i
    exact hretain i.1 i.2
  · intro i
    rw [show UJ i = U i.1 by rfl, hU]
  · intro i j hij
    apply hdisj i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  · intro i
    exact i.2
  · intro i j l hij hil hjl x hx y hy z hz hxy hxz
    apply no_repeated_attachment_outside_RepeatedAttachmentFinset G U
      i.1 j.1 l.1
    · intro h
      exact hij (Subtype.ext h)
    · intro h
      exact hil (Subtype.ext h)
    · intro h
      exact hjl (Subtype.ext h)
    · exact (Finset.mem_sdiff.mp hx).1
    · exact (Finset.mem_sdiff.mp hx).2
    · exact hy
    · exact hz
    · exact hxy
    · exact hxz

/-- Unconditional form of the preceding estimate.  Either the subtype of
parity-unbroken exact cores already satisfies the global count, or one of
those cores loses all but fewer than `σ` vertices to repeated attachments.
This is the quantitative parity/attachment dichotomy used by the stability
stage. -/
theorem unbroken_exact_cores_count_or_heavy_repeated_attachment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) {n k σ : ℕ}
    (hσ : 0 < σ)
    (hfree : G.IndepSetFree n)
    (hU : ∀ i, (U i).card = 9 * Nat.sqrt k)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j)) :
    ((σ - 4) *
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (U i)} <
      n * (9 * Nat.sqrt k + 1)) ∨
      ∃ i : ι, ¬ HasThreeDisjointAdjPairFamily G (U i) ∧
        (U i \ RepeatedAttachmentFinset G U).card < σ := by
  classical
  by_cases hretain : ∀ i, ¬ HasThreeDisjointAdjPairFamily G (U i) →
      σ ≤ (U i \ RepeatedAttachmentFinset G U).card
  · exact Or.inl
      (card_unbroken_exact_cores_bound_after_RepeatedAttachmentFinset
        G U hσ hfree hU hdisj hretain)
  · right
    push Not at hretain
    exact hretain

/-- Disjoint equal-sized pieces cannot all be heavily consumed by one
exceptional set.  If fewer than `σ` vertices of a `q`-set survive outside
`X`, then at least `q - σ + 1` of its vertices lie in `X`; summing these
pairwise disjoint intersections gives the global charge. -/
theorem mul_card_heavy_sdiff_lt_le_card
    {V ι : Type*} [Fintype V] [Fintype ι]
    (U : ι → Finset V) (X : Finset V) {q σ : ℕ}
    (hUcard : ∀ i, (U i).card = q) (hσq : σ ≤ q)
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j)) :
    (q - σ + 1) *
        ((Finset.univ : Finset ι).filter
          (fun i => (U i \ X).card < σ)).card ≤ X.card := by
  classical
  let H : Finset ι := (Finset.univ : Finset ι).filter
    (fun i => (U i \ X).card < σ)
  let P : ι → Finset V := fun i => U i ∩ X
  have hPcard : ∀ i ∈ H, q - σ + 1 ≤ (P i).card := by
    intro i hi
    have hlt : (U i \ X).card < σ :=
      (Finset.mem_filter.mp hi).2
    have hdecomp : (U i \ X).card + (P i).card = q := by
      simpa [P, hUcard i] using Finset.card_sdiff_add_card_inter (U i) X
    omega
  have hpair : (H : Set ι).PairwiseDisjoint P := by
    intro i _hi j _hj hij
    exact (hdisj i j hij).mono
      Finset.inter_subset_left Finset.inter_subset_left
  have hsubset : H.biUnion P ⊆ X := by
    intro x hx
    obtain ⟨i, _hi, hxi⟩ := Finset.mem_biUnion.mp hx
    exact (Finset.mem_inter.mp hxi).2
  calc
    (q - σ + 1) *
          ((Finset.univ : Finset ι).filter
            (fun i => (U i \ X).card < σ)).card =
        ∑ i ∈ H, (q - σ + 1) := by simp [H, Nat.mul_comm]
    _ ≤ ∑ i ∈ H, (P i).card := by
      apply Finset.sum_le_sum
      intro i hi
      exact hPcard i hi
    _ = (H.biUnion P).card := (Finset.card_biUnion hpair).symm
    _ ≤ X.card := Finset.card_le_card hsubset

/-- Two successive predicate splits on a finite type.  If fewer than `n`
members of the complement of `P` satisfy `Q`, then every index is accounted
for by a `P`-index, at most `n-1` light complement indices, or a heavy
complement index. -/
theorem fintypeCard_le_subtype_add_pred_of_complement_light
    {ι : Type*} [Fintype ι] (P : ι → Prop)
    (Q : {i : ι // ¬ P i} → Prop) {n : ℕ}
    (hlight : Fintype.card {i : {i : ι // ¬ P i} // Q i} < n) :
    Fintype.card ι ≤
      Fintype.card {i : ι // P i} + (n - 1) +
        Fintype.card {i : {i : ι // ¬ P i} // ¬ Q i} := by
  classical
  have hP := Fintype.card_subtype_compl P
  have hPle : Fintype.card {i : ι // P i} ≤ Fintype.card ι :=
    Fintype.card_subtype_le _
  have hsplitP : Fintype.card ι =
      Fintype.card {i : ι // P i} + Fintype.card {i : ι // ¬ P i} := by
    omega
  have hQ := Fintype.card_subtype_compl Q
  have hQle : Fintype.card {i : {i : ι // ¬ P i} // Q i} ≤
      Fintype.card {i : ι // ¬ P i} := Fintype.card_subtype_le _
  have hsplitQ : Fintype.card {i : ι // ¬ P i} =
      Fintype.card {i : {i : ι // ¬ P i} // Q i} +
        Fintype.card {i : {i : ι // ¬ P i} // ¬ Q i} := by
    omega
  omega

/-- At the exact `9 * sqrt k` core scale, deleting the canonical repeated
attachments makes the large-cross-matching graph have maximum degree at most
two.  Indeed, three distinct auxiliary neighbours would consume three
disjoint sets of `R` endpoints in one core, while `R > 4 * sqrt k`. -/
theorem degree_largeCrossMatchingGraph_after_RepeatedAttachmentFinset_le_two
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) {R k : ℕ}
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (U i) (U j))
    (hcard : ∀ i : ι, (U i).card ≤ 9 * Nat.sqrt k)
    (hR : 4 * Nat.sqrt k < R) (i : ι) :
    (LargeCrossMatchingGraph G
      (fun j => U j \ RepeatedAttachmentFinset G U) R).degree i ≤ 2 := by
  let X : Finset V := RepeatedAttachmentFinset G U
  let W : ι → Finset V := fun j => U j \ X
  have hbudget :
      R * (LargeCrossMatchingGraph G W R).degree i ≤ (U i).card := by
    apply mul_degree_largeCrossMatchingGraph_le_card_of_no_repeated_attachment
      G U W R
    · intro j
      exact Finset.sdiff_subset
    · exact hdisj
    · intro a b c hab hac hbc x hx y hy z hz hxy hxz
      apply no_repeated_attachment_outside_RepeatedAttachmentFinset
        G U a b c hab hac hbc x
      · exact (Finset.mem_sdiff.mp hx).1
      · simpa [X] using (Finset.mem_sdiff.mp hx).2
      · exact hy
      · exact hz
      · exact hxy
      · exact hxz
  change (LargeCrossMatchingGraph G W R).degree i ≤ 2
  by_contra hdegNot
  have hdeg : 3 ≤ (LargeCrossMatchingGraph G W R).degree i := by omega
  have h3R : 3 * R ≤ R * (LargeCrossMatchingGraph G W R).degree i := by
    simpa [Nat.mul_comm] using Nat.mul_le_mul_left R hdeg
  have h12 : 12 * Nat.sqrt k < 3 * R := by omega
  have h9 : 9 * Nat.sqrt k < 3 * R := by omega
  exact (not_lt_of_ge (hbudget.trans (hcard i))) (h9.trans_le h3R)

/-- Canonical connected-component form of the square-root path-ladder
bound.  Repeated-attachment pruning supplies maximum degree two, and every
large-cross-matching edge in the pruned graph enlarges to a matching between
the original alternating cores. -/
theorem ncard_component_le_sqrt_div_sixteen_after_RepeatedAttachmentFinset_of_matched_alternatingScaffolds
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {theta R k : ℕ}
    (hsqrt : 256 ≤ Nat.sqrt k)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (A i))
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G
      (fun i => A i \ RepeatedAttachmentFinset G A) R).ConnectedComponent) :
    c.supp.ncard ≤ Nat.sqrt k / 16 := by
  let W : ι → Finset V :=
    fun i => A i \ RepeatedAttachmentFinset G A
  let H : SimpleGraph ι := LargeCrossMatchingGraph G W R
  let K : SimpleGraph c := c.toSimpleGraph
  let Ac : c → Finset V := fun i => A i.1
  let Bc : c → Finset V := fun i => B i.1
  let Dc : c → Finset V := fun i => D i.1
  have hAdisj : ∀ i j : ι, i ≠ j → Disjoint (A i) (A j) := by
    intro i j hij
    exact (hregions i j hij).mono
      (Finset.subset_union_left.trans Finset.subset_union_left)
      (Finset.subset_union_left.trans Finset.subset_union_left)
  have hHdeg : ∀ i : ι, H.degree i ≤ 2 := by
    intro i
    apply degree_largeCrossMatchingGraph_after_RepeatedAttachmentFinset_le_two
      G A hAdisj
    · intro j
      rw [hAcard j]
    · exact hmatchBudget
  have hKdeg : ∀ i : c, K.degree i ≤ 2 := by
    intro i
    let f : SimpleGraph.Copy K H :=
      ⟨c.toSimpleGraph_hom, fun _ _ h => Subtype.ext h⟩
    exact (f.degree_le i).trans (hHdeg i.1)
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Ac i) (Ac j) R := by
    intro i j hij
    apply HasCrossMatchingAtLeast.mono_sets
      (hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
        (G := G) (U := W) (m := R) ?_)
      Finset.sdiff_subset Finset.sdiff_subset
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K, H] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint ((Ac i ∪ Bc i) ∪ Dc i) ((Ac j ∪ Bc j) ∪ Dc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hbound : Fintype.card c ≤ Nat.sqrt k / 16 := by
    apply card_le_sqrt_div_sixteen_of_cycleFree_connected_degree_le_two_alternatingScaffold
      G K c.connected_toSimpleGraph hKdeg Ac Bc Dc hsqrt
    · intro i
      exact hscaffold i.1
    · intro i
      exact hrob i.1
    · intro i
      exact hmajorD i.1
    · exact htheta
    · exact hKregions
    · exact hKlarge
    · intro i
      exact hmatch i.1
    · exact hmatchBudget
    · exact hcycle
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  simpa [hcCard] using hbound

/-- Stable-block output for the parity-broken subfamily.  Prune repeated
attachments inside that subfamily and delete the standard small-cross-
matching covers.  Distinct auxiliary components are then anticomplete, and
the path-ladder bound makes every component union smaller than `k`. -/
theorem exists_exceptional_set_separating_small_matched_alternatingScaffold_components
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {theta R k : ℕ}
    (hsqrt : 256 ≤ Nat.sqrt k)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (htheta : 7 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let J := {i : ι // HasThreeDisjointAdjPairFamily G (A i)}
    let AJ : J → Finset V := fun i => A i.1
    let W : J → Finset V :=
      fun i => AJ i \ RepeatedAttachmentFinset G AJ
    let H : SimpleGraph J := LargeCrossMatchingGraph G W R
    ∃ X : Finset V,
      X.card ≤ 2 * R * Fintype.card J * Fintype.card J ∧
      (∀ c d : H.ConnectedComponent, c ≠ d →
        ∀ i ∈ c.supp, ∀ j ∈ d.supp,
          ∀ a ∈ W i \ X, ∀ b ∈ W j \ X, ¬ G.Adj a b) ∧
      ∀ c : H.ConnectedComponent,
        (c.supp.toFinset.biUnion fun i => W i \ X).card ≤ k - 1 := by
  classical
  let J := {i : ι // HasThreeDisjointAdjPairFamily G (A i)}
  let AJ : J → Finset V := fun i => A i.1
  let BJ : J → Finset V := fun i => B i.1
  let DJ : J → Finset V := fun i => D i.1
  let W : J → Finset V :=
    fun i => AJ i \ RepeatedAttachmentFinset G AJ
  let H : SimpleGraph J := LargeCrossMatchingGraph G W R
  obtain ⟨X, hX, hsep⟩ :=
    exists_exceptional_set_separating_largeCrossMatching_components G W R
  refine ⟨X, hX, hsep, ?_⟩
  intro c
  have hcomponent : c.supp.ncard ≤ Nat.sqrt k / 16 := by
    apply ncard_component_le_sqrt_div_sixteen_after_RepeatedAttachmentFinset_of_matched_alternatingScaffolds
      G AJ BJ DJ hsqrt
    · intro i
      exact hscaffold i.1
    · intro i
      exact hrob i.1
    · intro i
      exact hmajorD i.1
    · intro i
      exact hAcard i.1
    · exact htheta
    · intro i j hij
      apply hregions i.1 j.1
      intro h
      exact hij (Subtype.ext h)
    · intro i
      exact i.2
    · exact hmatchBudget
    · exact hcycle
  have hpiece : ∀ i ∈ c.supp.toFinset, (W i \ X).card ≤ 9 * Nat.sqrt k := by
    intro i _hi
    calc
      (W i \ X).card ≤ (AJ i).card := by
        apply Finset.card_le_card
        exact Finset.sdiff_subset.trans Finset.sdiff_subset
      _ = 9 * Nat.sqrt k := hAcard i.1
  have hblock : (c.supp.toFinset.biUnion fun i => W i \ X).card ≤
      c.supp.toFinset.card * (9 * Nat.sqrt k) :=
    Finset.card_biUnion_le_card_mul _ _ _ hpiece
  have hsuppCard : c.supp.toFinset.card = c.supp.ncard := by
    simpa using (Set.ncard_eq_toFinset_card c.supp).symm
  have hblock' : (c.supp.toFinset.biUnion fun i => W i \ X).card ≤
      (Nat.sqrt k / 16) * (9 * Nat.sqrt k) := by
    calc
      (c.supp.toFinset.biUnion fun i => W i \ X).card ≤
          c.supp.toFinset.card * (9 * Nat.sqrt k) := hblock
      _ ≤ (Nat.sqrt k / 16) * (9 * Nat.sqrt k) := by
        rw [hsuppCard]
        exact Nat.mul_le_mul_right _ hcomponent
  let s := Nat.sqrt k
  let L := s / 16
  have hs : 256 ≤ s := by simpa [s] using hsqrt
  have hLlower : 16 * L ≤ s := by
    dsimp [L]
    have h := Nat.div_mul_le_self s 16
    simpa [Nat.mul_comm] using h
  have h9L : 9 * L < s := by omega
  have hspos : 0 < s := by omega
  have hprod : L * (9 * s) < s ^ 2 := by
    have hmul := Nat.mul_lt_mul_of_pos_right h9L hspos
    nlinarith
  have hsquare : s ^ 2 ≤ k := by
    simpa [s] using Nat.sqrt_le' k
  have htarget : (Nat.sqrt k / 16) * (9 * Nat.sqrt k) ≤ k - 1 := by
    change L * (9 * s) ≤ k - 1
    omega
  exact hblock'.trans htarget

/-- Turn componentwise large-cross-matching separation into an ordinary
finite block family.  Nonempty trimmed label sets ensure that every
auxiliary component contributes a nonempty block; disjointness of the label
sets makes the component unions disjoint, and the component separation
hypothesis makes them anticomplete.  The last equality records exactly which
ambient vertices the blocks cover. -/
theorem exists_anticomplete_small_largeCrossMatching_component_block_family
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (U : ι → Finset V) (R : ℕ) (X : Finset V) {k : ℕ}
    (hUdisj : ∀ i j, i ≠ j → Disjoint (U i) (U j))
    (hUne : ∀ i, (U i \ X).Nonempty)
    (hsep :
      let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
      ∀ c d : H.ConnectedComponent, c ≠ d →
        ∀ i ∈ c.supp, ∀ j ∈ d.supp,
          ∀ a ∈ U i \ X, ∀ b ∈ U j \ X, ¬ G.Adj a b)
    (hcard :
      let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
      ∀ c : H.ConnectedComponent,
        (c.supp.toFinset.biUnion fun i => U i \ X).card ≤ k - 1) :
    let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
    let block : H.ConnectedComponent → Finset V :=
      fun c => c.supp.toFinset.biUnion fun i => U i \ X
    ∃ F : Finset (Finset V),
      F = Finset.univ.image block ∧
      (∀ A ∈ F, A.Nonempty) ∧
      DisjointFinsetFamily F ∧
      PairwiseAnticomplete G F ∧
      (∀ A ∈ F, A.card ≤ k - 1) ∧
      F.biUnion id =
        (Finset.univ : Finset ι).biUnion fun i => U i \ X := by
  classical
  let H : SimpleGraph ι := LargeCrossMatchingGraph G U R
  let block : H.ConnectedComponent → Finset V :=
    fun c => c.supp.toFinset.biUnion fun i => U i \ X
  let F : Finset (Finset V) := Finset.univ.image block
  have hmem (c : H.ConnectedComponent) (v : V) :
      v ∈ block c ↔ ∃ i : ι, i ∈ c.supp ∧ v ∈ U i \ X := by
    simp [block]
  refine ⟨F, rfl, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    obtain ⟨i, hi⟩ := c.nonempty_supp
    obtain ⟨v, hv⟩ := hUne i
    exact ⟨v, (hmem c v).2 ⟨i, hi, hv⟩⟩
  · intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨d, _hd, rfl⟩
    have hcd : c ≠ d := by
      intro h
      apply hAB
      subst d
      rfl
    rw [Finset.disjoint_left]
    intro v hvc hvd
    rcases (hmem c v).1 hvc with ⟨i, hic, hvi⟩
    rcases (hmem d v).1 hvd with ⟨j, hjd, hvj⟩
    by_cases hij : i = j
    · subst j
      exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hic hjd)
    · exact (Finset.disjoint_left.mp (hUdisj i j hij))
        (Finset.mem_sdiff.mp hvi).1 (Finset.mem_sdiff.mp hvj).1
  · intro A hA B hB hAB a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨d, _hd, rfl⟩
    have hcd : c ≠ d := by
      intro h
      apply hAB
      subst d
      rfl
    rcases (hmem c a).1 ha with ⟨i, hic, hai⟩
    rcases (hmem d b).1 hb with ⟨j, hjd, hbj⟩
    exact hsep c d hcd i hic j hjd a hai b hbj hab
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    exact hcard c
  · ext v
    constructor
    · intro hv
      rcases Finset.mem_biUnion.mp hv with ⟨A, hAF, hvA⟩
      rcases Finset.mem_image.mp hAF with ⟨c, _hc, rfl⟩
      rcases (hmem c v).1 hvA with ⟨i, _hic, hvi⟩
      exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hvi⟩
    · intro hv
      rcases Finset.mem_biUnion.mp hv with ⟨i, _hi, hvi⟩
      let c : H.ConnectedComponent := H.connectedComponentMk i
      apply Finset.mem_biUnion.mpr
      refine ⟨block c, Finset.mem_image.mpr ⟨c, Finset.mem_univ _, rfl⟩, ?_⟩
      exact (hmem c v).2
        ⟨i, SimpleGraph.ConnectedComponent.connectedComponentMk_mem, hvi⟩

/-- Exact-core specialization of the medium pruned-component theorem.  At
the canonical `9 * sqrt k` scale, repeated-attachment deletion supplies the
maximum-degree-two hypothesis automatically. -/
theorem isBipartite_of_medium_component_after_RepeatedAttachmentFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) {θ R k : ℕ} (hkOdd : Odd k)
    (hsqrt : 30 ≤ Nat.sqrt k)
    (hmatchBudget : 4 * Nat.sqrt k < R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i : ι, (U i).card = 9 * Nat.sqrt k)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G
      (fun i => U i \ RepeatedAttachmentFinset G U) R).ConnectedComponent)
    (hcardLow : 2 * (Nat.sqrt k / 3) < c.supp.ncard)
    (hcardHigh : c.supp.ncard ≤ Nat.sqrt k) :
    c.toSimpleGraph.IsBipartite := by
  let W : ι → Finset V :=
    fun i => U i \ RepeatedAttachmentFinset G U
  apply isBipartite_of_medium_largeCrossMatching_component_degree_le_two
    G U W T hkOdd hsqrt
  · intro i
    exact Finset.sdiff_subset
  · exact hmatchBudget
  · exact hrob
  · exact hregions
  · intro i
    rw [hU i]
  · exact hθ
  · exact hcycle
  · intro i
    apply degree_largeCrossMatchingGraph_after_RepeatedAttachmentFinset_le_two
      G U
    · intro a b hab
      exact (hregions a b hab).mono Finset.subset_union_left
        Finset.subset_union_left
    · intro j
      rw [hU j]
    · exact hmatchBudget
  · exact hcardLow
  · exact hcardHigh

/-- Every repeated-attachment vertex lies in one of the displayed hub
cores. -/
theorem RepeatedAttachmentFinset_subset_biUnion
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) :
    RepeatedAttachmentFinset G U ⊆
      (Finset.univ : Finset ι).biUnion U := by
  classical
  intro a ha
  simp only [RepeatedAttachmentFinset, Finset.mem_filter,
    Finset.mem_univ, true_and] at ha
  rcases ha with ⟨i, j, ℓ, _hij, _hiℓ, _hjℓ, hai, _⟩
  exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hai⟩

/-- A uniform local estimate for repeated attachments gives a global one by
summing over the hub cores.  The pieces need not be proved disjoint for this
upper bound; overlap can only make the union smaller. -/
theorem card_RepeatedAttachmentFinset_le_mul_of_local
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V) {σ : ℕ}
    (hlocal : ∀ i : ι,
      (U i ∩ RepeatedAttachmentFinset G U).card ≤ σ) :
    (RepeatedAttachmentFinset G U).card ≤ Fintype.card ι * σ := by
  classical
  let R : Finset V := RepeatedAttachmentFinset G U
  let P : ι → Finset V := fun i => U i ∩ R
  have hsub : R ⊆ (Finset.univ : Finset ι).biUnion P := by
    intro a ha
    have haUnion : a ∈ (Finset.univ : Finset ι).biUnion U :=
      RepeatedAttachmentFinset_subset_biUnion G U ha
    rcases Finset.mem_biUnion.mp haUnion with ⟨i, hi, hai⟩
    apply Finset.mem_biUnion.mpr
    exact ⟨i, hi, Finset.mem_inter.mpr ⟨hai, ha⟩⟩
  have hPcard : ∀ i ∈ (Finset.univ : Finset ι), (P i).card ≤ σ := by
    intro i _hi
    simpa [P, R] using hlocal i
  calc
    R.card ≤ ((Finset.univ : Finset ι).biUnion P).card :=
      Finset.card_le_card hsub
    _ ≤ (Finset.univ : Finset ι).card * σ :=
      Finset.card_biUnion_le_card_mul _ _ _ hPcard
    _ = Fintype.card ι * σ := by simp

/-- Canonical trimmed-triangle exclusion: after deleting exactly the
repeated-attachment vertices, the interaction graph of a cycle-free robust
hub family has no triangle. -/
theorem not_hasHubInteractionTriangle_of_cycleFree_short_second_hub_family_after_RepeatedAttachmentFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ HasHubInteractionTriangle
      (HubInteractionGraph G
        (fun i => U i \ RepeatedAttachmentFinset G U)) := by
  apply
    not_hasHubInteractionTriangle_of_cycleFree_short_second_hub_family_after_no_repeated_attachment
      G U T θ hk hrob hfree hUn hUk hθ hregions hcycle
        (RepeatedAttachmentFinset G U)
  exact no_repeated_attachment_outside_RepeatedAttachmentFinset G U

/-- If k is at least three times the number of hubs (up to the fixed routing
overhead), every cycle in the pruned interaction graph would be short enough
for the cyclic-handle lift.  Hence the whole pruned interaction graph is
acyclic, not merely triangle-free. -/
theorem isAcyclic_pruned_hubInteraction_of_cycleFree
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ}
    (hlarge : 3 * Fintype.card ι + 3 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (HubInteractionGraph G
      (fun i => U i \ RepeatedAttachmentFinset G U)).IsAcyclic := by
  rw [SimpleGraph.isAcyclic_iff_free_cycleGraph]
  intro q hq hcopy
  rcases hcopy with ⟨c⟩
  have hqcard : q ≤ Fintype.card ι := by
    simpa using Fintype.card_le_of_injective c.toHom c.injective
  let m : ℕ := q - 1
  have hm : 2 ≤ m := by
    dsimp [m]
    omega
  have hmq : m + 1 = q := by
    dsimp [m]
    omega
  have hfit : 3 * m + 6 ≤ k := by
    dsimp [m]
    omega
  apply not_cycleGraph_isContained_pruned_hubInteraction_of_cycleFree
    hm hfit G U T θ (RepeatedAttachmentFinset G U)
      hrob hregions hfree hUn hUk hθ
      (no_repeated_attachment_outside_RepeatedAttachmentFinset G U) hcycle
  rw [hmq]
  exact ⟨c⟩

/-- The explicit triangle predicate is exactly strong enough to discharge
Mathlib's three-clique-free interface. -/
theorem cliqueFree_three_of_not_hasHubInteractionTriangle
    {ι : Type*} (H : SimpleGraph ι)
    (htri : ¬ HasHubInteractionTriangle H) :
    H.CliqueFree 3 := by
  intro S hS
  obtain ⟨i, j, ℓ, hij, hiℓ, hjℓ, _hcard⟩ :=
    SimpleGraph.is3Clique_iff.mp hS
  apply htri
  exact ⟨i, j, ℓ, hij.ne, hiℓ.ne, hjℓ.ne,
    hij, hjℓ, hiℓ.symm⟩

/-- Mantel/Turán consequence of the explicit triangle exclusion: a
triangle-free finite interaction graph has at most one quarter of the
ambient square many edges. -/
theorem four_mul_card_edgeFinset_le_sq_of_not_hasHubInteractionTriangle
    {ι : Type*} [Fintype ι] (H : SimpleGraph ι) [DecidableRel H.Adj]
    (htri : ¬ HasHubInteractionTriangle H) :
    4 * H.edgeFinset.card ≤ (Fintype.card ι) ^ 2 := by
  have hfree : H.CliqueFree 3 :=
    cliqueFree_three_of_not_hasHubInteractionTriangle H htri
  have hbound :=
    cliqueFree_twice_mul_card_edgeFinset_le H (r := 2) (by omega) hfree
  simpa using hbound

/-- Quantitative form of canonical trimmed-triangle exclusion.  After
deleting repeated attachment vertices from a cycle-free robust family, its
remaining interaction graph satisfies the sharp triangle-free quadratic edge
bound. -/
theorem four_mul_card_edgeFinset_le_sq_of_cycleFree_short_second_hub_family_after_RepeatedAttachmentFinset
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let H : SimpleGraph ι :=
      HubInteractionGraph G
        (fun i => U i \ RepeatedAttachmentFinset G U)
    4 * H.edgeFinset.card ≤ (Fintype.card ι) ^ 2 := by
  let H : SimpleGraph ι :=
    HubInteractionGraph G
      (fun i => U i \ RepeatedAttachmentFinset G U)
  apply four_mul_card_edgeFinset_le_sq_of_not_hasHubInteractionTriangle H
  exact
    not_hasHubInteractionTriangle_of_cycleFree_short_second_hub_family_after_RepeatedAttachmentFinset
      G U T θ hk hrob hfree hUn hUk hθ hregions hcycle

/-- Independent sets of the hub interaction graph lift to independent sets
of the original graph by choosing one representative from each disjoint
nonempty core.  Thus the original independent-set obstruction is inherited
by the auxiliary graph. -/
theorem hubInteractionGraph_indepSetFree_of_indepSetFree
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj] (U : ι → Finset V) {n : ℕ}
    (hfree : G.IndepSetFree n) (hne : ∀ i, (U i).Nonempty)
    (hdisj : ∀ i j, i ≠ j → Disjoint (U i) (U j)) :
    (HubInteractionGraph G U).IndepSetFree n := by
  classical
  intro S hS
  let pick : ι → V := fun i => (hne i).choose
  have hpick : ∀ i, pick i ∈ U i := by
    intro i
    exact (hne i).choose_spec
  have hpick_inj : Set.InjOn pick (S : Set ι) := by
    intro i hi j hj hij
    by_contra hneij
    exact (Finset.disjoint_left.mp (hdisj i j hneij)) (hpick i) (hij ▸ hpick j)
  let R : Finset V := S.image pick
  have hRcard : R.card = n := by
    calc
      R.card = S.card := Finset.card_image_of_injOn hpick_inj
      _ = n := hS.card_eq
  have hRind : G.IsIndepSet (R : Set V) := by
    rw [SimpleGraph.isIndepSet_iff]
    intro a ha b hb hab
    rcases Finset.mem_image.mp ha with ⟨i, hi, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨j, hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hab rfl
    intro hadj
    have hHubAdj : (HubInteractionGraph G U).Adj i j := by
      rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      refine ⟨hij, Or.inl ?_⟩
      exact ⟨pick i, hpick i, pick j, hpick j, hadj⟩
    exact hS.isIndepSet hi hj hij hHubAdj
  exact hfree R ⟨hRind, hRcard⟩

/-- A graph with no independent n-set and more than twice n-1 vertices
cannot be a forest: forests are two-colorable, while the standard coloring
count bounds an independent-set-free graph by its chromatic number times
n-1.  Applied to the hub interaction graph, this supplies the first cyclic
handle system once sufficiently many hubs have been extracted. -/
theorem exists_cycle_of_indepSetFree_of_two_mul_pred_lt_card
    {ι : Type*} [Fintype ι] (H : SimpleGraph ι) [DecidableRel H.Adj]
    {n : ℕ} (hfree : H.IndepSetFree n)
    (hcard : 2 * (n - 1) < Fintype.card ι) :
    ∃ v : ι, ∃ c : H.Walk v v, c.IsCycle := by
  by_contra hno
  have hacyc : H.IsAcyclic := by
    intro v c hc
    exact hno ⟨v, c, hc⟩
  have hχ : H.chromaticNumber.toNat ≤ 2 := by
    have hχ' := hacyc.chromaticNumber_le_two
    exact ENat.toNat_le_toNat hχ' (by simp)
  have hbound : Fintype.card ι ≤ H.chromaticNumber.toNat * (n - 1) :=
    Erdos551.IndepSetFree.card_le_chromaticNumber_toNat_mul_pred hfree
  have : H.chromaticNumber.toNat * (n - 1) ≤ 2 * (n - 1) :=
    Nat.mul_le_mul_right _ hχ
  omega

/-- Grouping a disjoint cover of vertices by connected components of its hub
interaction graph produces a complete stable partition as soon as every
grouped component has order at most k-1.  Vertices in distinct interaction
components cannot be adjacent, by the definition of the auxiliary graph. -/
theorem completeStablePartition_of_hubInteraction_components
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) (B : ι → Finset V) {k : ℕ}
    (hBne : ∀ i, (B i).Nonempty)
    (hBdisj : ∀ i j, i ≠ j → Disjoint (B i) (B j))
    (hcover : ∀ v : V, ∃ i : ι, v ∈ B i)
    (hcard : ∀ c : (HubInteractionGraph G B).ConnectedComponent,
      ((c.supp.toFinset).biUnion B).card ≤ k - 1) :
    CompleteStablePartition G k := by
  classical
  let H : SimpleGraph ι := HubInteractionGraph G B
  let block : H.ConnectedComponent → Finset V :=
    fun c => c.supp.toFinset.biUnion B
  let F : Finset (Finset V) := Finset.univ.image block
  have hmem (c : H.ConnectedComponent) (v : V) :
      v ∈ block c ↔ ∃ i : ι, i ∈ c.supp ∧ v ∈ B i := by
    simp [block]
  refine ⟨F, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    obtain ⟨i, hi⟩ := c.nonempty_supp
    obtain ⟨v, hv⟩ := hBne i
    exact ⟨v, (hmem c v).2 ⟨i, hi, hv⟩⟩
  · intro A hA C hC hAC
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨d, _hd, rfl⟩
    have hcd : c ≠ d := by
      intro h
      apply hAC
      subst d
      rfl
    rw [Finset.disjoint_left]
    intro v hvc hvd
    rcases (hmem c v).1 hvc with ⟨i, hic, hvi⟩
    rcases (hmem d v).1 hvd with ⟨j, hjd, hvj⟩
    by_cases hij : i = j
    · subst j
      exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hic hjd)
    · exact (Finset.disjoint_left.mp (hBdisj i j hij)) hvi hvj
  · intro A hA C hC hAC a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨d, _hd, rfl⟩
    have hcd : c ≠ d := by
      intro h
      apply hAC
      subst d
      rfl
    rcases (hmem c a).1 ha with ⟨i, hic, hai⟩
    rcases (hmem d b).1 hb with ⟨j, hjd, hbj⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hic hjd)
    have hHij : H.Adj i j := by
      change (HubInteractionGraph G B).Adj i j
      rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      refine ⟨hij, Or.inl ?_⟩
      exact ⟨a, hai, b, hbj, hab⟩
    have hci : H.connectedComponentMk i = c :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff c i).mp hic
    have hdj : H.connectedComponentMk j = d :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff d j).mp hjd
    apply hcd
    rw [← hci, ← hdj]
    exact SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hHij
  · intro v
    obtain ⟨i, hvi⟩ := hcover v
    let c := H.connectedComponentMk i
    refine ⟨block c, ?_, ?_⟩
    · exact Finset.mem_image.mpr ⟨c, Finset.mem_univ _, rfl⟩
    · apply (hmem c v).2
      exact ⟨i,
        SimpleGraph.ConnectedComponent.connectedComponentMk_mem (G := H) (v := i),
        hvi⟩
  · intro A hA
    rcases Finset.mem_image.mp hA with ⟨c, _hc, rfl⟩
    exact hcard c

/-- In a cycle-free graph, two disjoint robust regions with the displayed
route capacity have sparse interaction: two vertex-disjoint cross-edges
would be exactly the two handles consumed by the all-length splice above. -/
theorem atMostOneCrossEdge_of_cycleFree_two_robustPairSets
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n ℓ s k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hlen : ℓ + 2 * (s + 1) + 2 = k)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    AtMostOneCrossEdge G U₁ U₂ := by
  intro a ha b hb a' ha' b' hb' hab ha'b'
  by_contra hne
  have haa' : a ≠ a' := by
    intro h
    exact hne (Or.inl h)
  have hbb' : b ≠ b' := by
    intro h
    exact hne (Or.inr h)
  apply hcycle
  exact cycleGraph_isContained_of_two_disjoint_robustPairSets_all_lengths G hk
    hrob₁ hrob₂ hfree hU₁n hregions ha' ha hb hb' haa'.symm hbb'
    hab ha'b'.symm hℓ hℓU hℓθ hU₂ hθ₂ hlen

/-- Exact-length cleanup consequence of the short-second-hub splice.  In a
`C_k`-free graph, once one robust region routes through `k - 4` and a
disjoint second region supplies a two-edge return route, every two cross
edges share an endpoint. -/
theorem atMostOneCrossEdge_of_cycleFree_two_robustPairSets_all_lengths_short_second
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ n k : ℕ} (hk : 9 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hfree : G.IndepSetFree n) (hU₁n : n + 2 ≤ U₁.card)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    (hU₁ : k - 4 ≤ U₁.card) (hθ₁ : k - 3 ≤ θ₁)
    (hU₂ : 2 ≤ U₂.card) (hθ₂ : 3 ≤ θ₂)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    AtMostOneCrossEdge G U₁ U₂ := by
  intro a ha b hb a' ha' b' hb' hab ha'b'
  by_contra hne
  have haa' : a ≠ a' := by
    intro h
    exact hne (Or.inl h)
  have hbb' : b ≠ b' := by
    intro h
    exact hne (Or.inr h)
  apply hcycle
  exact cycleGraph_isContained_of_two_robustPairSets_all_lengths_short_second G hk
    hrob₁ hrob₂ hfree hU₁n hregions ha' ha hb hb' haa'.symm hbb'
    hab ha'b'.symm hU₁ hθ₁ hU₂ hθ₂

/-- Source-faithful sparse interaction from a parity-breaking matching.
Three disjoint internal edges suffice for this local two-handle statement:
after two cross-edge endpoints in the first hub are fixed, one matching edge
remains disjoint from them and supplies the parity correction. -/
theorem atMostOneCrossEdge_of_cycleFree_two_robustPairSets_of_matching
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U₁ T₁ U₂ T₂ : Finset V} {θ₁ θ₂ ℓ s k : ℕ} (hk : 3 ≤ k)
    (hrob₁ : RobustPairSet G U₁ T₁ θ₁) (hrob₂ : RobustPairSet G U₂ T₂ θ₂)
    (hregions : Disjoint (U₁ ∪ T₁) (U₂ ∪ T₂))
    {M : Finset (V × V)} (hM : DisjointAdjPairFamily G M)
    (hMU : ∀ e ∈ M, e.1 ∈ U₁ ∧ e.2 ∈ U₁) (hMcard : 2 < M.card)
    (hℓ : 5 ≤ ℓ) (hℓU : ℓ ≤ U₁.card) (hℓθ : ℓ + 1 ≤ θ₁)
    (hU₂ : s + 2 ≤ U₂.card) (hθ₂ : 2 * (s + 1) + 1 ≤ θ₂)
    (hlen : ℓ + 2 * (s + 1) + 2 = k)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    AtMostOneCrossEdge G U₁ U₂ := by
  intro a ha b hb a' ha' b' hb' hab ha'b'
  by_contra hne
  have haa' : a ≠ a' := by
    intro h
    exact hne (Or.inl h)
  have hbb' : b ≠ b' := by
    intro h
    exact hne (Or.inr h)
  let F : Finset V := {a, a'}
  have hFcard : F.card < M.card := by
    have : F.card ≤ 2 := Finset.card_le_two
    omega
  obtain ⟨e, heM, he1F, he2F, heAdj⟩ :=
    exists_adjPair_avoiding_of_disjointAdjPairFamily G M F hM hFcard
  have heU := hMU e heM
  simp only [F, Finset.mem_insert, Finset.mem_singleton, not_or] at he1F he2F
  apply hcycle
  exact cycleGraph_isContained_of_two_disjoint_robustPairSets_parity_edge G hk
    hrob₁ hrob₂ hregions ha' heU.1 heU.2 ha hb hb'
    heAdj (Ne.symm he1F.2) (Ne.symm he2F.2) haa'.symm he1F.1 he2F.1 hbb'
    hab ha'b'.symm hℓ hℓU hℓθ hU₂ hθ₂ hlen

/-- Ordered cross-edges between two finite sets.  Ordered pairs avoid the
quotient bookkeeping of undirected edge sets and are the convenient counting
object for sparse hub interaction. -/
def CrossPairFinset {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (A B : Finset V) : Finset (V × V) :=
  (A.product B).filter fun e => G.Adj e.1 e.2

/-- Pairwise-intersecting cross-edges have only linear total size.  Choose
one cross-edge; every other one must use its first endpoint or its second
endpoint, so the whole ordered cross-edge set lies in the union of two
stars. -/
theorem card_crossPairFinset_le_add_of_atMostOneCrossEdge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B : Finset V) (hcross : AtMostOneCrossEdge G A B) :
    (CrossPairFinset G A B).card ≤ A.card + B.card := by
  classical
  by_cases hempty : (CrossPairFinset G A B).Nonempty
  · obtain ⟨e, he⟩ := hempty
    rcases e with ⟨a₀, b₀⟩
    have he' : (a₀ ∈ A ∧ b₀ ∈ B) ∧ G.Adj a₀ b₀ := by
      simpa [CrossPairFinset] using he
    have hsub : CrossPairFinset G A B ⊆
        (({a₀} : Finset V).product B) ∪ (A.product {b₀}) := by
      intro e he
      rcases e with ⟨a, b⟩
      have heab : (a ∈ A ∧ b ∈ B) ∧ G.Adj a b := by
        simpa [CrossPairFinset] using he
      have hshare := hcross a heab.1.1 b heab.1.2 a₀ he'.1.1 b₀ he'.1.2
        heab.2 he'.2
      rcases hshare with rfl | rfl
      · exact Finset.mem_union_left _ (by simp [heab.1.2])
      · exact Finset.mem_union_right _ (by simp [heab.1.1])
    calc
      (CrossPairFinset G A B).card ≤
          ((({a₀} : Finset V).product B) ∪ (A.product {b₀})).card :=
        Finset.card_le_card hsub
      _ ≤ (({a₀} : Finset V).product B).card + (A.product {b₀}).card :=
        Finset.card_union_le _ _
      _ = A.card + B.card := by simp [Nat.add_comm]
  · have hzero : CrossPairFinset G A B = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp hempty
    simp [hzero]

/-- Pairwise-intersecting cross-edges have a two-vertex cover.  After
deleting the two endpoints of one chosen cross-edge, the remaining parts of
the two sets are anticomplete.  This is the cleanup form used after the
short-second-hub interaction lemma: it converts sparse interaction into a
bounded exceptional set rather than merely an edge-count estimate. -/
theorem exists_small_cross_vertex_cover_of_atMostOneCrossEdge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B : Finset V) (hcross : AtMostOneCrossEdge G A B) :
    ∃ F : Finset V, F.card ≤ 2 ∧
      ∀ a ∈ A, ∀ b ∈ B, a ∉ F → b ∉ F → ¬ G.Adj a b := by
  classical
  by_cases hne : (CrossPairFinset G A B).Nonempty
  · obtain ⟨e, he⟩ := hne
    rcases e with ⟨a₀, b₀⟩
    have he' : (a₀ ∈ A ∧ b₀ ∈ B) ∧ G.Adj a₀ b₀ := by
      simpa [CrossPairFinset] using he
    refine ⟨{a₀, b₀}, Finset.card_le_two, ?_⟩
    intro a ha b hb haF hbF hab
    have hshare := hcross a ha b hb a₀ he'.1.1 b₀ he'.1.2 hab he'.2
    rcases hshare with h | h
    · exact haF (by simp [h])
    · exact hbF (by simp [h])
  · refine ⟨∅, by simp, ?_⟩
    intro a ha b hb _haF _hbF hab
    apply hne
    refine ⟨(a, b), ?_⟩
    simpa [CrossPairFinset] using ⟨⟨ha, hb⟩, hab⟩

/-- A finite family with pairwise-intersecting cross-edges becomes genuinely
pairwise anticomplete after deleting a quadratic-size exceptional set.  For
each ordered pair of distinct blocks choose the preceding two-vertex cover,
then delete the union of all chosen covers.  This is the finite bookkeeping
form of KLS cleanup: every later absorption argument may charge at most two
vertices per ordered hub pair. -/
theorem exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset (Finset V))
    (hcross : ∀ A ∈ F, ∀ B ∈ F, A ≠ B → AtMostOneCrossEdge G A B) :
    ∃ X : Finset V, X.card ≤ 2 * F.card * F.card ∧
      PairwiseAnticomplete G (F.image fun A => A \ X) := by
  classical
  let cover : Finset V × Finset V → Finset V := fun q =>
    if hq : q.1 ∈ F ∧ q.2 ∈ F ∧ q.1 ≠ q.2 then
      Classical.choose
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G q.1 q.2
          (hcross q.1 hq.1 q.2 hq.2.1 hq.2.2))
    else ∅
  let X : Finset V := (F.product F).biUnion cover
  have hcoverCard : ∀ q ∈ F.product F, (cover q).card ≤ 2 := by
    intro q _hq
    by_cases hcond : q.1 ∈ F ∧ q.2 ∈ F ∧ q.1 ≠ q.2
    · simp only [cover, dif_pos hcond]
      exact (Classical.choose_spec
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G q.1 q.2
          (hcross q.1 hcond.1 q.2 hcond.2.1 hcond.2.2))).1
    · simp only [cover, dif_neg hcond]
      simp
  have hXcard : X.card ≤ (F.product F).card * 2 := by
    exact Finset.card_biUnion_le_card_mul _ _ _ hcoverCard
  refine ⟨X, ?_, ?_⟩
  · calc
      X.card ≤ (F.product F).card * 2 := hXcard
      _ = 2 * F.card * F.card := by
        simp [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
  · intro A' hA' B' hB' hAB' a ha b hb hab
    rcases Finset.mem_image.mp hA' with ⟨A, hAF, rfl⟩
    rcases Finset.mem_image.mp hB' with ⟨B, hBF, rfl⟩
    have hAB : A ≠ B := by
      intro h
      subst B
      exact hAB' rfl
    have hcond : A ∈ F ∧ B ∈ F ∧ A ≠ B := ⟨hAF, hBF, hAB⟩
    have hqmem : (A, B) ∈ F.product F := by simp [hAF, hBF]
    have hcoverSub : cover (A, B) ⊆ X := by
      exact Finset.subset_biUnion_of_mem cover hqmem
    have ha' := Finset.mem_sdiff.mp ha
    have hb' := Finset.mem_sdiff.mp hb
    have haNotCover : a ∉ cover (A, B) := by
      intro hac
      exact ha'.2 (hcoverSub hac)
    have hbNotCover : b ∉ cover (A, B) := by
      intro hbc
      exact hb'.2 (hcoverSub hbc)
    have hlocal : ∀ x ∈ A, ∀ y ∈ B,
        x ∉ cover (A, B) → y ∉ cover (A, B) → ¬ G.Adj x y := by
      simp only [cover, dif_pos hcond]
      exact (Classical.choose_spec
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G A B
          (hcross A hAF B hBF hAB))).2
    exact hlocal a ha'.1 b hb'.1 haNotCover hbNotCover hab

/-- Ordered distinct block pairs that actually have a cross-edge.  Cleanup
only needs to pay for these pairs; noninteracting pairs already are
anticomplete and contribute no exceptional vertices. -/
noncomputable def InteractingBlockPairFinset
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset (Finset V)) : Finset (Finset V × Finset V) :=
  (F.product F).filter fun q =>
    q.1 ≠ q.2 ∧ (CrossPairFinset G q.1 q.2).Nonempty

/-- Refined global cleanup: charge two exceptional vertices only for each
ordered pair of distinct blocks with at least one cross-edge.  The proof is
the same two-vertex-cover construction as above, but the biunion is indexed
by the actual interaction-pair finset rather than all ordered pairs. -/
theorem exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge_interactions
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset (Finset V))
    (hcross : ∀ A ∈ F, ∀ B ∈ F, A ≠ B → AtMostOneCrossEdge G A B) :
    ∃ X : Finset V,
      X.card ≤ 2 * (InteractingBlockPairFinset G F).card ∧
      PairwiseAnticomplete G (F.image fun A => A \ X) := by
  classical
  let cover : Finset V × Finset V → Finset V := fun q =>
    if hq : q.1 ∈ F ∧ q.2 ∈ F ∧ q.1 ≠ q.2 then
      Classical.choose
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G q.1 q.2
          (hcross q.1 hq.1 q.2 hq.2.1 hq.2.2))
    else ∅
  let Q : Finset (Finset V × Finset V) := InteractingBlockPairFinset G F
  let X : Finset V := Q.biUnion cover
  have hcoverCard : ∀ q ∈ Q, (cover q).card ≤ 2 := by
    intro q hq
    have hq' := Finset.mem_filter.mp hq
    have hmem := Finset.mem_product.mp hq'.1
    have hcond : q.1 ∈ F ∧ q.2 ∈ F ∧ q.1 ≠ q.2 :=
      ⟨hmem.1, hmem.2, hq'.2.1⟩
    simp only [cover, dif_pos hcond]
    exact (Classical.choose_spec
      (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G q.1 q.2
        (hcross q.1 hcond.1 q.2 hcond.2.1 hcond.2.2))).1
  have hXcard : X.card ≤ Q.card * 2 := by
    exact Finset.card_biUnion_le_card_mul _ _ _ hcoverCard
  refine ⟨X, ?_, ?_⟩
  · calc
      X.card ≤ Q.card * 2 := hXcard
      _ = 2 * (InteractingBlockPairFinset G F).card := by
        simp [Q, Nat.mul_comm]
  · intro A' hA' B' hB' hAB' a ha b hb hab
    rcases Finset.mem_image.mp hA' with ⟨A, hAF, rfl⟩
    rcases Finset.mem_image.mp hB' with ⟨B, hBF, rfl⟩
    have hAB : A ≠ B := by
      intro h
      subst B
      exact hAB' rfl
    have hcond : A ∈ F ∧ B ∈ F ∧ A ≠ B := ⟨hAF, hBF, hAB⟩
    have ha' := Finset.mem_sdiff.mp ha
    have hb' := Finset.mem_sdiff.mp hb
    have hpair : (CrossPairFinset G A B).Nonempty := by
      refine ⟨(a, b), ?_⟩
      simpa [CrossPairFinset] using ⟨⟨ha'.1, hb'.1⟩, hab⟩
    have hqmem : (A, B) ∈ Q := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_product.mpr ⟨hAF, hBF⟩, ⟨hAB, hpair⟩⟩
    have hcoverSub : cover (A, B) ⊆ X := by
      exact Finset.subset_biUnion_of_mem cover hqmem
    have haNotCover : a ∉ cover (A, B) := by
      intro hac
      exact ha'.2 (hcoverSub hac)
    have hbNotCover : b ∉ cover (A, B) := by
      intro hbc
      exact hb'.2 (hcoverSub hbc)
    have hlocal : ∀ x ∈ A, ∀ y ∈ B,
        x ∉ cover (A, B) → y ∉ cover (A, B) → ¬ G.Adj x y := by
      simp only [cover, dif_pos hcond]
      exact (Classical.choose_spec
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G A B
          (hcross A hAF B hBF hAB))).2
    exact hlocal a ha'.1 b hb'.1 haNotCover hbNotCover hab

/-- Directed edges of the hub interaction graph on a finite family of
blocks.  Unlike `InteractingBlockPairFinset`, the vertices here are the
subtype `F` itself, so Mathlib's dart/edge handshaking formula applies
directly. -/
noncomputable def HubInteractionDartFinsetOnFamily
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset (Finset V)) : Finset (F × F) :=
  let H : SimpleGraph F := HubInteractionGraph G (fun A : F => (A : Finset V))
  Finset.univ.filter fun q => H.Adj q.1 q.2

/-- Edge-count form of global cleanup.  One two-vertex cover is chosen for
each directed edge (dart) of the hub interaction graph.  Since the number of
darts is twice the number of undirected edges, deleting at most four vertices
per interaction edge makes all trimmed blocks pairwise anticomplete. -/
theorem exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge_edge_count
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset (Finset V))
    (hcross : ∀ A ∈ F, ∀ B ∈ F, A ≠ B → AtMostOneCrossEdge G A B) :
    let H : SimpleGraph F := HubInteractionGraph G (fun A : F => (A : Finset V))
    ∃ X : Finset V, X.card ≤ 4 * H.edgeFinset.card ∧
      PairwiseAnticomplete G (F.image fun A => A \ X) := by
  classical
  let H : SimpleGraph F := HubInteractionGraph G (fun A : F => (A : Finset V))
  let cover : F × F → Finset V := fun q =>
    if hq : H.Adj q.1 q.2 then
      Classical.choose
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G
          (q.1 : Finset V) (q.2 : Finset V)
          (hcross q.1 q.1.2 q.2 q.2.2 (by
            intro h
            apply hq.ne
            exact Subtype.ext h)))
    else ∅
  let Q : Finset (F × F) := HubInteractionDartFinsetOnFamily G F
  let X : Finset V := Q.biUnion cover
  have hcoverCard : ∀ q ∈ Q, (cover q).card ≤ 2 := by
    intro q hq
    have hq' : H.Adj q.1 q.2 := by
      simpa [Q, HubInteractionDartFinsetOnFamily, H] using
        (Finset.mem_filter.mp hq).2
    simp only [cover, dif_pos hq']
    exact (Classical.choose_spec
      (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G
        (q.1 : Finset V) (q.2 : Finset V)
        (hcross q.1 q.1.2 q.2 q.2.2 (by
          intro h
          apply hq'.ne
          exact Subtype.ext h)))).1
  have hXcard : X.card ≤ Q.card * 2 := by
    exact Finset.card_biUnion_le_card_mul _ _ _ hcoverCard
  have hQcard : Q.card = 2 * H.edgeFinset.card := by
    have h := H.two_mul_card_edgeFinset
    simpa [Q, HubInteractionDartFinsetOnFamily, H] using h.symm
  refine ⟨X, ?_, ?_⟩
  · change X.card ≤ 4 * H.edgeFinset.card
    rw [hQcard] at hXcard
    omega
  · intro A' hA' B' hB' hAB' a ha b hb hab
    rcases Finset.mem_image.mp hA' with ⟨A, hAF, rfl⟩
    rcases Finset.mem_image.mp hB' with ⟨B, hBF, rfl⟩
    have hAB : A ≠ B := by
      intro h
      subst B
      exact hAB' rfl
    let i : F := ⟨A, hAF⟩
    let j : F := ⟨B, hBF⟩
    have hij : i ≠ j := by
      intro h
      apply hAB
      exact congrArg Subtype.val h
    have hAdj : H.Adj i j := by
      change (HubInteractionGraph G (fun A : F => (A : Finset V))).Adj i j
      rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      refine ⟨hij, Or.inl ?_⟩
      exact ⟨a, (Finset.mem_sdiff.mp ha).1, b, (Finset.mem_sdiff.mp hb).1, hab⟩
    have hqmem : (i, j) ∈ Q := by
      simpa [Q, HubInteractionDartFinsetOnFamily, H] using hAdj
    have hcoverSub : cover (i, j) ⊆ X := by
      exact Finset.subset_biUnion_of_mem cover hqmem
    have ha' := Finset.mem_sdiff.mp ha
    have hb' := Finset.mem_sdiff.mp hb
    have haNotCover : a ∉ cover (i, j) := by
      intro hac
      exact ha'.2 (hcoverSub hac)
    have hbNotCover : b ∉ cover (i, j) := by
      intro hbc
      exact hb'.2 (hcoverSub hbc)
    have hlocal : ∀ x ∈ A, ∀ y ∈ B,
        x ∉ cover (i, j) → y ∉ cover (i, j) → ¬ G.Adj x y := by
      simp only [cover, dif_pos hAdj]
      exact (Classical.choose_spec
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G A B
          (hcross A hAF B hBF hAB))).2
    exact hlocal a ha'.1 b hb'.1 haNotCover hbNotCover hab

/-- Indexed form of edge-count cleanup.  This avoids passing through the
image finset of cores, so the auxiliary graph in the conclusion is exactly
the indexed interaction graph used by the stability estimates. -/
theorem exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge_indexed_edge_count
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U : ι → Finset V)
    (hcross : ∀ i j : ι, i ≠ j → AtMostOneCrossEdge G (U i) (U j)) :
    let H : SimpleGraph ι := HubInteractionGraph G U
    ∃ X : Finset V, X.card ≤ 4 * H.edgeFinset.card ∧
      PairwiseAnticomplete G
        ((Finset.univ : Finset ι).image fun i => U i \ X) := by
  classical
  let H : SimpleGraph ι := HubInteractionGraph G U
  let cover : ι × ι → Finset V := fun q =>
    if hq : H.Adj q.1 q.2 then
      Classical.choose
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G
          (U q.1) (U q.2) (hcross q.1 q.2 hq.ne))
    else ∅
  let Q : Finset (ι × ι) :=
    Finset.univ.filter fun q => H.Adj q.1 q.2
  let X : Finset V := Q.biUnion cover
  have hcoverCard : ∀ q ∈ Q, (cover q).card ≤ 2 := by
    intro q hq
    have hq' : H.Adj q.1 q.2 := (Finset.mem_filter.mp hq).2
    simp only [cover, dif_pos hq']
    exact (Classical.choose_spec
      (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G
        (U q.1) (U q.2) (hcross q.1 q.2 hq'.ne))).1
  have hXcard : X.card ≤ Q.card * 2 :=
    Finset.card_biUnion_le_card_mul _ _ _ hcoverCard
  have hQcard : Q.card = 2 * H.edgeFinset.card := by
    have h := H.two_mul_card_edgeFinset
    simpa [Q, H] using h.symm
  refine ⟨X, ?_, ?_⟩
  · change X.card ≤ 4 * H.edgeFinset.card
    rw [hQcard] at hXcard
    omega
  · intro A' hA' B' hB' hAB' a ha b hb hab
    rcases Finset.mem_image.mp hA' with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hB' with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB' rfl
    have hAdj : H.Adj i j := by
      change (HubInteractionGraph G U).Adj i j
      rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
      refine ⟨hij, Or.inl ?_⟩
      exact ⟨a, (Finset.mem_sdiff.mp ha).1,
        b, (Finset.mem_sdiff.mp hb).1, hab⟩
    have hqmem : (i, j) ∈ Q := by
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hAdj⟩
    have hcoverSub : cover (i, j) ⊆ X :=
      Finset.subset_biUnion_of_mem cover hqmem
    have ha' := Finset.mem_sdiff.mp ha
    have hb' := Finset.mem_sdiff.mp hb
    have haNotCover : a ∉ cover (i, j) := by
      intro hac
      exact ha'.2 (hcoverSub hac)
    have hbNotCover : b ∉ cover (i, j) := by
      intro hbc
      exact hb'.2 (hcoverSub hbc)
    have hlocal : ∀ x ∈ U i, ∀ y ∈ U j,
        x ∉ cover (i, j) → y ∉ cover (i, j) → ¬ G.Adj x y := by
      simp only [cover, dif_pos hAdj]
      exact (Classical.choose_spec
        (exists_small_cross_vertex_cover_of_atMostOneCrossEdge G
          (U i) (U j) (hcross i j hij))).2
    exact hlocal a ha'.1 b hb'.1 haNotCover hbNotCover hab

/-- After first deleting repeated attachments, the remaining robust cores
still have pairwise sparse cross-interaction.  The indexed cleanup and the
triangle-free Mantel bound therefore make them pairwise anticomplete after a
second exceptional deletion of size at most the square of the number of
hubs. -/
theorem exists_quadratic_exceptional_set_after_RepeatedAttachmentFinset_of_cycleFree_short_second_hub_family
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let R : Finset V := RepeatedAttachmentFinset G U
    let U' : ι → Finset V := fun i => U i \ R
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      PairwiseAnticomplete G
        ((Finset.univ : Finset ι).image fun i => U' i \ X) := by
  let R : Finset V := RepeatedAttachmentFinset G U
  let U' : ι → Finset V := fun i => U i \ R
  have hcross : ∀ i j : ι, i ≠ j → AtMostOneCrossEdge G (U' i) (U' j) := by
    intro i j hij
    have hraw : AtMostOneCrossEdge G (U i) (U j) := by
      apply atMostOneCrossEdge_of_cycleFree_two_robustPairSets_all_lengths_short_second
        G (by omega) (hrob i) (hrob j) hfree (hUn i) (hregions i j hij)
          (hUk i) (hθ i)
      · have := hUk j
        omega
      · have := hθ j
        omega
      · exact hcycle
    intro a ha b hb a' ha' b' hb' hab ha'b'
    exact hraw a (Finset.mem_sdiff.mp ha).1
      b (Finset.mem_sdiff.mp hb).1
      a' (Finset.mem_sdiff.mp ha').1
      b' (Finset.mem_sdiff.mp hb').1 hab ha'b'
  obtain ⟨X, hX, hanti⟩ :=
    exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge_indexed_edge_count
      G U' hcross
  refine ⟨X, ?_, hanti⟩
  let H : SimpleGraph ι := HubInteractionGraph G U'
  have hMantel : 4 * H.edgeFinset.card ≤ (Fintype.card ι) ^ 2 := by
    change 4 * (HubInteractionGraph G
      (fun i => U i \ RepeatedAttachmentFinset G U)).edgeFinset.card ≤
        (Fintype.card ι) ^ 2
    exact
      four_mul_card_edgeFinset_le_sq_of_cycleFree_short_second_hub_family_after_RepeatedAttachmentFinset
        G U T θ hk hrob hfree hUn hUk hθ hregions hcycle
  exact hX.trans hMantel

/-- A finite acyclic graph has at most as many edges as vertices.  Decompose
into connected components, use Mathlib's exact tree edge count on each
component, and add the induced edge counts with the anticomplete-family
edge-partition lemma proved above.  The slightly weaker `≤ |V|` form is the
one needed for robust-hub cleanup and avoids a separate empty-graph case. -/
theorem card_edgeFinset_le_card_of_isAcyclic
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (hacyc : G.IsAcyclic) :
    G.edgeFinset.card ≤ Fintype.card V := by
  classical
  let f : G.ConnectedComponent ↪ Finset V :=
    { toFun := fun c => c.supp.toFinset
      inj' := by
        intro c d h
        apply SimpleGraph.ConnectedComponent.supp_injective
        simpa using h }
  let F : Finset (Finset V) := Finset.univ.map f
  have hdisj : DisjointFinsetFamily F := by
    intro A hA B hB hAB
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_map.mp hB with ⟨d, _hd, rfl⟩
    have hcd : c ≠ d := by
      intro h
      apply hAB
      subst d
      rfl
    rw [Finset.disjoint_left]
    intro v hvc hvd
    have hvc' : v ∈ c.supp := Set.mem_toFinset.mp hvc
    have hvd' : v ∈ d.supp := Set.mem_toFinset.mp hvd
    exact hcd (SimpleGraph.ConnectedComponent.eq_of_common_vertex hvc' hvd')
  have hanti : PairwiseAnticomplete G F := by
    intro A hA B hB hAB a ha b hb hab
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    rcases Finset.mem_map.mp hB with ⟨d, _hd, rfl⟩
    have hac : a ∈ c.supp := Set.mem_toFinset.mp ha
    have hbd : b ∈ d.supp := Set.mem_toFinset.mp hb
    have hca : G.connectedComponentMk a = c :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff c a).mp hac
    have hdb : G.connectedComponentMk b = d :=
      (SimpleGraph.ConnectedComponent.mem_supp_iff d b).mp hbd
    apply hAB
    have hcd : c = d := by
      rw [← hca, ← hdb]
      exact SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hab
    simpa [hcd]
  have hcover : F.biUnion id = Finset.univ := by
    ext v
    simp only [Finset.mem_biUnion, id_eq, Finset.mem_univ, iff_true]
    let c := G.connectedComponentMk v
    refine ⟨c.supp.toFinset, ?_, ?_⟩
    · exact Finset.mem_map.mpr ⟨c, Finset.mem_univ _, rfl⟩
    · simpa [c] using
        (SimpleGraph.ConnectedComponent.connectedComponentMk_mem (G := G) (v := v))
  have hinside : ∀ A ∈ F, (inducedEdgeFinsetOn G A).card ≤ A.card := by
    intro A hA
    rcases Finset.mem_map.mp hA with ⟨c, _hc, rfl⟩
    have htree := (hacyc.isTree_connectedComponent c).card_edgeFinset
    have hcCard : Fintype.card c = c.supp.ncard := by
      calc
        Fintype.card c = Fintype.card c.supp := by
          apply Fintype.card_congr
          exact
            { toFun := fun x => ⟨x.1, x.2⟩
              invFun := fun x => ⟨x.1, x.2⟩
              left_inv := fun x => by ext; rfl
              right_inv := fun x => by ext; rfl }
        _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
    have htreeSet :
        c.toSimpleGraph.edgeSet.ncard + 1 = c.supp.ncard := by
      have h := htree
      unfold SimpleGraph.edgeFinset at h
      rw [← Set.ncard_eq_toFinset_card'] at h
      rw [← hcCard]
      exact h
    have hedgeSet :
        (inducedEdgeFinsetOn G c.supp.toFinset).card =
          c.toSimpleGraph.edgeSet.ncard := by
      have hset := card_inducedEdgeFinsetOnSet_eq_card_induce G c.supp
      unfold SimpleGraph.edgeFinset at hset
      rw [← Set.ncard_eq_toFinset_card'] at hset
      calc
        (inducedEdgeFinsetOn G c.supp.toFinset).card =
            (inducedEdgeFinsetOnSet G c.supp).card := by
          congr 1
          ext e
          simp [inducedEdgeFinsetOn, inducedEdgeFinsetOnSet]
        _ = (G.induce c.supp).edgeSet.ncard := hset
        _ = c.toSimpleGraph.edgeSet.ncard := by
          change (G.induce c.supp).edgeSet.ncard =
            (G.induce c.supp).edgeSet.ncard
          rfl
    have hcard :
        (inducedEdgeFinsetOn G c.supp.toFinset).card + 1 = c.supp.toFinset.card := by
      calc
        (inducedEdgeFinsetOn G c.supp.toFinset).card + 1 =
            c.toSimpleGraph.edgeSet.ncard + 1 := by rw [hedgeSet]
        _ = c.supp.ncard := htreeSet
        _ = c.supp.toFinset.card := by rw [Set.ncard_eq_toFinset_card']
    change (inducedEdgeFinsetOn G c.supp.toFinset).card ≤ c.supp.toFinset.card
    omega
  have hpair : (F : Set (Finset V)).PairwiseDisjoint id := by
    intro A hA B hB hAB
    exact hdisj A (by simpa using hA) B (by simpa using hB) hAB
  calc
    G.edgeFinset.card = (inducedEdgeFinsetOn G (F.biUnion id)).card := by
      rw [hcover]
      simp [inducedEdgeFinsetOn]
    _ = ∑ A ∈ F, (inducedEdgeFinsetOn G A).card :=
      card_inducedEdgeFinsetOn_biUnion_eq_sum G hdisj hanti
    _ ≤ ∑ A ∈ F, A.card := by
      exact Finset.sum_le_sum fun A hA => hinside A hA
    _ = (F.biUnion id).card := by
      simpa using (Finset.card_biUnion hpair).symm
    _ = Fintype.card V := by
      rw [hcover]
      simp

/-- Under the global short-cycle budget, canonical repeated-attachment
pruning makes the interaction graph acyclic.  The indexed edge cleanup
therefore costs at most four vertices per hub, replacing the earlier
quadratic Mantel charge by a linear one. -/
theorem exists_linear_exceptional_set_after_RepeatedAttachmentFinset_of_cycleFree_short_second_hub_family
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 12 ≤ k)
    (hlarge : 3 * Fintype.card ι + 3 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let R : Finset V := RepeatedAttachmentFinset G U
    let U' : ι → Finset V := fun i => U i \ R
    ∃ X : Finset V, X.card ≤ 4 * Fintype.card ι ∧
      PairwiseAnticomplete G
        ((Finset.univ : Finset ι).image fun i => U' i \ X) := by
  let R : Finset V := RepeatedAttachmentFinset G U
  let U' : ι → Finset V := fun i => U i \ R
  have hcross : ∀ i j : ι, i ≠ j → AtMostOneCrossEdge G (U' i) (U' j) := by
    intro i j hij
    have hraw : AtMostOneCrossEdge G (U i) (U j) := by
      apply atMostOneCrossEdge_of_cycleFree_two_robustPairSets_all_lengths_short_second
        G (by omega) (hrob i) (hrob j) hfree (hUn i) (hregions i j hij)
          (hUk i) (hθ i)
      · have := hUk j
        omega
      · have := hθ j
        omega
      · exact hcycle
    intro a ha b hb a' ha' b' hb' hab ha'b'
    exact hraw a (Finset.mem_sdiff.mp ha).1
      b (Finset.mem_sdiff.mp hb).1
      a' (Finset.mem_sdiff.mp ha').1
      b' (Finset.mem_sdiff.mp hb').1 hab ha'b'
  obtain ⟨X, hX, hanti⟩ :=
    exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge_indexed_edge_count
      G U' hcross
  refine ⟨X, ?_, hanti⟩
  let H : SimpleGraph ι := HubInteractionGraph G U'
  have hacyc : H.IsAcyclic := by
    simpa [H, U', R] using
      (isAcyclic_pruned_hubInteraction_of_cycleFree
        G U T θ hlarge hrob hfree hUn hUk hθ hregions hcycle)
  have hedge : H.edgeFinset.card ≤ Fintype.card ι :=
    card_edgeFinset_le_card_of_isAcyclic H hacyc
  have hlin : 4 * H.edgeFinset.card ≤ 4 * Fintype.card ι :=
    Nat.mul_le_mul_left 4 hedge
  exact hX.trans hlin

/-- Deleting a set of order at most E from a set of order at least tau
leaves at least tau - E vertices.  This elementary estimate is kept named
because the cleanup exceptional set is global, while every robust core must
retain its own local reservoir after that one deletion. -/
theorem sub_le_card_sdiff_of_le_card_of_card_le_late
    {V : Type*} [Fintype V] {A X : Finset V} {τ E : ℕ}
    (hA : τ ≤ A.card) (hX : X.card ≤ E) :
    τ - E ≤ (A \ X).card := by
  rw [Finset.card_sdiff]
  have hinter : (X ∩ A).card ≤ X.card :=
    Finset.card_le_card Finset.inter_subset_left
  omega

/-- Deleting the same exceptional set from every member of a disjoint
family preserves disjointness. -/
theorem disjointFinsetFamily_image_sdiff
    {V : Type*} [Fintype V] (F : Finset (Finset V)) (X : Finset V)
    (hdisj : DisjointFinsetFamily F) :
    DisjointFinsetFamily (F.image fun A => A \ X) := by
  classical
  intro A hA B hB hAB
  rcases Finset.mem_image.mp hA with ⟨A₀, hA₀, rfl⟩
  rcases Finset.mem_image.mp hB with ⟨B₀, hB₀, rfl⟩
  have hA₀B₀ : A₀ ≠ B₀ := by
    intro h
    subst B₀
    exact hAB rfl
  exact (hdisj A₀ hA₀ B₀ hB₀ hA₀B₀).mono Finset.sdiff_subset Finset.sdiff_subset

/-- Parity-unbroken counting survives a common cleanup deletion.  Each
trimmed core remains parity-unbroken by subset monotonicity, and the existing
image-sdiff lemma supplies the disjointness required by the global
independent-remnant bound. -/
theorem sum_card_sub_four_lt_of_trimmed_unbroken_anticomplete_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} (X : Finset V) {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G (F.image fun A => A \ X))
    (hnot : ∀ A ∈ F, ¬ HasThreeDisjointAdjPairFamily G A) :
    ∑ B ∈ F.image (fun A => A \ X), (B.card - 4) < n := by
  apply sum_card_sub_four_lt_of_disjoint_pairwiseAnticomplete_not_hasThree
    G hfree (disjointFinsetFamily_image_sdiff F X hdisj) hanti
  intro B hB
  rcases Finset.mem_image.mp hB with ⟨A, hA, rfl⟩
  exact not_hasThreeDisjointAdjPairFamily_of_subset Finset.sdiff_subset
    (hnot A hA)

/-- Cardinal form of the trimmed parity-unbroken count.  A uniform retained
core lower bound converts the summed independent remnants into a direct
bound on the number of trimmed cores. -/
theorem mul_card_sub_four_lt_of_trimmed_unbroken_anticomplete_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) {F : Finset (Finset V)} (X : Finset V) {n τ : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G (F.image fun A => A \ X))
    (hnot : ∀ A ∈ F, ¬ HasThreeDisjointAdjPairFamily G A)
    (hcard : ∀ B ∈ F.image (fun A => A \ X), τ ≤ B.card) :
    (τ - 4) * (F.image fun A => A \ X).card < n := by
  apply mul_card_sub_four_lt_of_disjoint_pairwiseAnticomplete_not_hasThree
    G hfree (disjointFinsetFamily_image_sdiff F X hdisj) hanti
  · intro B hB
    rcases Finset.mem_image.mp hB with ⟨A, hA, rfl⟩
    exact not_hasThreeDisjointAdjPairFamily_of_subset Finset.sdiff_subset
      (hnot A hA)
  · exact hcard

/-- If every trimmed block is still nonempty, common deletion cannot merge
two originally disjoint blocks.  Hence the image family has exactly the same
number of blocks as the original family. -/
theorem card_image_sdiff_eq_of_nonempty_of_disjointFinsetFamily
    {V : Type*} [Fintype V] (F : Finset (Finset V)) (X : Finset V)
    (hdisj : DisjointFinsetFamily F)
    (hne : ∀ A ∈ F, (A \ X).Nonempty) :
    (F.image fun A => A \ X).card = F.card := by
  classical
  apply Finset.card_image_of_injOn
  intro A hA B hB hEq
  by_contra hAB
  obtain ⟨v, hv⟩ := hne A hA
  have hvA : v ∈ A := (Finset.mem_sdiff.mp hv).1
  change A \ X = B \ X at hEq
  have hvBX : v ∈ B \ X := by
    rw [← hEq]
    exact hv
  have hvB : v ∈ B := (Finset.mem_sdiff.mp hvBX).1
  exact (Finset.disjoint_left.mp (hdisj A hA B hB hAB)) hvA hvB

/-- Counting surviving trimmed blocks: if a common exceptional deletion
leaves every block nonempty and makes the trimmed family anticomplete, then
the original family already has fewer than `n` members. -/
theorem card_lt_of_nonempty_sdiff_pairwiseAnticomplete
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {X : Finset V} {n : ℕ}
    (hfree : G.IndepSetFree n)
    (hdisj : DisjointFinsetFamily F)
    (hne : ∀ A ∈ F, (A \ X).Nonempty)
    (hanti : PairwiseAnticomplete G (F.image fun A => A \ X)) :
    F.card < n := by
  have htrimne : ∀ A ∈ F.image (fun A => A \ X), A.Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨B, hB, rfl⟩
    exact hne B hB
  have hlt := card_lt_of_nonempty_disjoint_pairwiseAnticomplete G hfree htrimne
    (disjointFinsetFamily_image_sdiff F X hdisj) hanti
  rw [card_image_sdiff_eq_of_nonempty_of_disjointFinsetFamily F X hdisj hne] at hlt
  exact hlt

/-- Survival/count handoff after repeated-attachment pruning.  If the
canonical first deletion plus the triangle-free quadratic second deletion is
smaller than the robust-core size, every twice-trimmed core survives. -/
theorem exists_surviving_anticomplete_cores_after_RepeatedAttachmentFinset_of_cycleFree_short_second_hub_family
    {V ι : Type*} [Fintype V] [Nonempty V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {τ n k : ℕ} (hk : 12 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hτ : ∀ i, τ ≤ (U i).card)
    (hcharge : (RepeatedAttachmentFinset G U).card +
      (Fintype.card ι) ^ 2 < τ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let R : Finset V := RepeatedAttachmentFinset G U
    ∃ X : Finset V, X.card ≤ (Fintype.card ι) ^ 2 ∧
      PairwiseAnticomplete G
        ((Finset.univ : Finset ι).image
          fun i => (U i \ R) \ X) ∧
      (∀ i : ι, ((U i \ R) \ X).Nonempty) ∧
      ((Finset.univ : Finset ι).image
          fun i => (U i \ R) \ X).card < n := by
  let R : Finset V := RepeatedAttachmentFinset G U
  obtain ⟨X, hX, hanti⟩ :=
    exists_quadratic_exceptional_set_after_RepeatedAttachmentFinset_of_cycleFree_short_second_hub_family
      G U T θ hk hrob hfree hUn hUk hθ hregions hcycle
  have hne : ∀ i : ι, ((U i \ R) \ X).Nonempty := by
    intro i
    have hretR : τ - R.card ≤ (U i \ R).card :=
      sub_le_card_sdiff_of_le_card_of_card_le (hτ i) (E := R.card) le_rfl
    have hretX : (τ - R.card) - (Fintype.card ι) ^ 2 ≤
        ((U i \ R) \ X).card :=
      sub_le_card_sdiff_of_le_card_of_card_le hretR hX
    apply Finset.card_pos.mp
    have hpos : 0 < (τ - R.card) - (Fintype.card ι) ^ 2 := by
      dsimp [R] at hcharge ⊢
      omega
    exact hpos.trans_le hretX
  let B : ι → Finset V := fun i => (U i \ R) \ X
  have hBdisj : DisjointFinsetFamily
      ((Finset.univ : Finset ι).image B) := by
    intro A hA C hC hAC
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAC rfl
    have hiSub : B i ⊆ U i ∪ T i :=
      Finset.sdiff_subset.trans
        (Finset.sdiff_subset.trans Finset.subset_union_left)
    have hjSub : B j ⊆ U j ∪ T j :=
      Finset.sdiff_subset.trans
        (Finset.sdiff_subset.trans Finset.subset_union_left)
    exact (hregions i j hij).mono hiSub hjSub
  have hBne : ∀ A ∈ (Finset.univ : Finset ι).image B, A.Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hne i
  have hlt :
      ((Finset.univ : Finset ι).image B).card < n :=
    card_lt_of_nonempty_disjoint_pairwiseAnticomplete G hfree hBne hBdisj hanti
  refine ⟨X, hX, hanti, hne, ?_⟩
  exact hlt

/-- Exact family-level cleanup for disjoint robust hubs in a `C_k`-free
graph.  Every core can serve as the long first hub, while every distinct
core can serve as the fixed two-edge return hub.  Hence the preceding
short-second-hub splice gives pairwise-intersecting cross-edges, and the
global exceptional-set lemma makes all trimmed cores anticomplete at once. -/
theorem exists_global_exceptional_set_of_cycleFree_short_second_hub_family
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 9 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let F : Finset (Finset V) := Finset.univ.image U
    ∃ X : Finset V, X.card ≤ 2 * F.card * F.card ∧
      PairwiseAnticomplete G (F.image fun A => A \ X) := by
  classical
  let F : Finset (Finset V) := Finset.univ.image U
  have hcross : ∀ A ∈ F, ∀ B ∈ F, A ≠ B → AtMostOneCrossEdge G A B := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB rfl
    apply atMostOneCrossEdge_of_cycleFree_two_robustPairSets_all_lengths_short_second
      G hk (hrob i) (hrob j) hfree (hUn i) (hregions i j hij)
      (hUk i) (hθ i)
    · have := hUk j
      omega
    · have := hθ j
      omega
    · exact hcycle
  exact exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge G F hcross

/-- Edge-count refinement of robust-hub family cleanup.  The exact
short-second-hub splice again supplies pairwise-intersecting interactions;
using the interaction-graph version of the cover lemma charges the resulting
exceptional set by four vertices per auxiliary edge. -/
theorem exists_global_exceptional_set_of_cycleFree_short_second_hub_family_edge_count
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) {n k : ℕ} (hk : 9 ≤ k)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hfree : G.IndepSetFree n)
    (hUn : ∀ i, n + 2 ≤ (U i).card)
    (hUk : ∀ i, k - 4 ≤ (U i).card)
    (hθ : ∀ i, k - 3 ≤ θ i)
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let F : Finset (Finset V) := Finset.univ.image U
    let H : SimpleGraph F := HubInteractionGraph G (fun A : F => (A : Finset V))
    ∃ X : Finset V, X.card ≤ 4 * H.edgeFinset.card ∧
      PairwiseAnticomplete G (F.image fun A => A \ X) := by
  classical
  let F : Finset (Finset V) := Finset.univ.image U
  have hcross : ∀ A ∈ F, ∀ B ∈ F, A ≠ B → AtMostOneCrossEdge G A B := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB rfl
    apply atMostOneCrossEdge_of_cycleFree_two_robustPairSets_all_lengths_short_second
      G hk (hrob i) (hrob j) hfree (hUn i) (hregions i j hij)
      (hUk i) (hθ i)
    · have := hUk j
      omega
    · have := hθ j
      omega
    · exact hcycle
  exact exists_global_exceptional_set_of_pairwise_atMostOneCrossEdge_edge_count
    G F hcross

/-- Select the robust core stored in every greedily peeled local-hub region
and run the exact family cleanup on those selected cores.  Because each core
lies in its own peeled region, the routing regions remain pairwise disjoint;
the uniform lower bounds on `τ` and `θ` supply every numerical hypothesis of
the short-second-hub splice. -/
theorem exists_exceptional_anticomplete_cores_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 9 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let C : Finset (Finset V) := Finset.univ.image U
      ∃ X : Finset V, X.card ≤ 2 * C.card * C.card ∧
        PairwiseAnticomplete G (C.image fun A => A \ X) := by
  classical
  let U : F → Finset V := fun i =>
    Classical.choose (hhub i.1 i.2)
  have hU : ∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
      RobustPairSet G (U i) (i : Finset V) θ := by
    intro i
    exact Classical.choose_spec (hhub i.1 i.2)
  refine ⟨U, hU, ?_⟩
  apply exists_global_exceptional_set_of_cycleFree_short_second_hub_family
    G U (fun i : F => (i : Finset V)) (fun _ : F => θ) hk
  · intro i
    exact (hU i).2.2
  · exact hfree
  · intro i
    exact hτn.trans (hU i).1
  · intro i
    exact hτk.trans (hU i).1
  · intro _i
    exact hθ
  · intro i j hij
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    have hiUnion : U i ∪ (i : Finset V) = (i : Finset V) :=
      Finset.union_eq_right.mpr (hU i).2.1
    have hjUnion : U j ∪ (j : Finset V) = (j : Finset V) :=
      Finset.union_eq_right.mpr (hU j).2.1
    rw [hiUnion, hjUnion]
    exact hdisj i i.2 j j.2 hval
  · exact hcycle

/-- Edge-count version of the selected local-hub cleanup.  This is the
sharper handoff used once the stability argument bounds the auxiliary hub
interaction graph: the selected cores become anticomplete after deleting at
most four vertices per interaction edge. -/
theorem exists_exceptional_anticomplete_cores_edge_count_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 9 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let C : Finset (Finset V) := Finset.univ.image U
      let H : SimpleGraph C := HubInteractionGraph G (fun A : C => (A : Finset V))
      ∃ X : Finset V, X.card ≤ 4 * H.edgeFinset.card ∧
        PairwiseAnticomplete G (C.image fun A => A \ X) := by
  classical
  let U : F → Finset V := fun i =>
    Classical.choose (hhub i.1 i.2)
  have hU : ∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
      RobustPairSet G (U i) (i : Finset V) θ := by
    intro i
    exact Classical.choose_spec (hhub i.1 i.2)
  refine ⟨U, hU, ?_⟩
  apply exists_global_exceptional_set_of_cycleFree_short_second_hub_family_edge_count
    G U (fun i : F => (i : Finset V)) (fun _ : F => θ) hk
  · intro i
    exact (hU i).2.2
  · exact hfree
  · intro i
    exact hτn.trans (hU i).1
  · intro i
    exact hτk.trans (hU i).1
  · intro _i
    exact hθ
  · intro i j hij
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    have hiUnion : U i ∪ (i : Finset V) = (i : Finset V) :=
      Finset.union_eq_right.mpr (hU i).2.1
    have hjUnion : U j ∪ (j : Finset V) = (j : Finset V) :=
      Finset.union_eq_right.mpr (hU j).2.1
    rw [hiUnion, hjUnion]
    exact hdisj i i.2 j j.2 hval
  · exact hcycle

/-- Survival/count consequence of the edge-count cleanup.  The implication
is recorded with the selected interaction graph itself, so later stability
lemmas may discharge the sparse-edge inequality after seeing the actual
family of cores. -/
theorem exists_exceptional_anticomplete_cores_edge_count_with_card_lt_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 9 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let C : Finset (Finset V) := Finset.univ.image U
      let H : SimpleGraph C := HubInteractionGraph G (fun A : C => (A : Finset V))
      ∃ X : Finset V, X.card ≤ 4 * H.edgeFinset.card ∧
        PairwiseAnticomplete G (C.image fun A => A \ X) ∧
        (4 * H.edgeFinset.card < τ → C.card < n) := by
  obtain ⟨U, hU, hcleanup⟩ :=
    exists_exceptional_anticomplete_cores_edge_count_of_cycleFree_localRobustHub_family
      G hk hhub hdisj hfree hτn hτk hθ hcycle
  refine ⟨U, hU, ?_⟩
  let C : Finset (Finset V) := Finset.univ.image U
  let H : SimpleGraph C := HubInteractionGraph G (fun A : C => (A : Finset V))
  obtain ⟨X, hX, hanti⟩ := hcleanup
  refine ⟨X, hX, hanti, ?_⟩
  intro hsparse
  change 4 * H.edgeFinset.card < τ at hsparse
  have hne : ∀ A ∈ C, (A \ X).Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    apply Finset.card_pos.mp
    have hret : τ - 4 * H.edgeFinset.card ≤ (U i \ X).card :=
      sub_le_card_sdiff_of_le_card_of_card_le (hU i).1 hX
    have hpos : 0 < τ - 4 * H.edgeFinset.card := by omega
    exact hpos.trans_le hret
  have hCdisj : DisjointFinsetFamily C := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB rfl
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    exact (hdisj i i.2 j j.2 hval).mono (hU i).2.1 (hU j).2.1
  exact card_lt_of_nonempty_sdiff_pairwiseAnticomplete G hfree hCdisj hne hanti

/-- If the selected hub interaction graph is acyclic, the preceding
edge-count cleanup costs at most four vertices per selected core.  This is
the form used after the three-hub obstruction has ruled out cyclic
interaction patterns: the only remaining numerical input is that this
linear charge is smaller than the robust-core size. -/
theorem exists_exceptional_anticomplete_cores_acyclic_interaction_with_card_lt_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 9 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let C : Finset (Finset V) := Finset.univ.image U
      let H : SimpleGraph C := HubInteractionGraph G (fun A : C => (A : Finset V))
      ∃ X : Finset V, X.card ≤ 4 * H.edgeFinset.card ∧
        PairwiseAnticomplete G (C.image fun A => A \ X) ∧
        (H.IsAcyclic → 4 * C.card < τ → C.card < n) := by
  obtain ⟨U, hU, hcleanup⟩ :=
    exists_exceptional_anticomplete_cores_edge_count_with_card_lt_of_cycleFree_localRobustHub_family
      G hk hhub hdisj hfree hτn hτk hθ hcycle
  refine ⟨U, hU, ?_⟩
  let C : Finset (Finset V) := Finset.univ.image U
  let H : SimpleGraph C := HubInteractionGraph G (fun A : C => (A : Finset V))
  obtain ⟨X, hX, hanti, hsurvive⟩ := hcleanup
  refine ⟨X, hX, hanti, ?_⟩
  intro hacyc hsmall
  apply hsurvive
  change 4 * H.edgeFinset.card < τ
  have hedge : H.edgeFinset.card ≤ Fintype.card C :=
    card_edgeFinset_le_card_of_isAcyclic H hacyc
  have hcharge : 4 * H.edgeFinset.card ≤ 4 * C.card := by
    calc
      4 * H.edgeFinset.card ≤ 4 * Fintype.card C :=
        Nat.mul_le_mul_left 4 hedge
      _ = 4 * C.card := by rw [Fintype.card_coe]
  exact hcharge.trans_lt hsmall

/-- Quantitative version of the selected-core cleanup: besides making the
trimmed cores anticomplete, record the uniform lower bound that survives the
global exceptional deletion.  This is the precise handoff from hub cleanup
to the later absorption/assignment step. -/
theorem exists_exceptional_anticomplete_large_cores_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 9 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let C : Finset (Finset V) := Finset.univ.image U
      ∃ X : Finset V, X.card ≤ 2 * C.card * C.card ∧
        PairwiseAnticomplete G (C.image fun A => A \ X) ∧
        ∀ i : F, τ - 2 * C.card * C.card ≤ (U i \ X).card := by
  obtain ⟨U, hU, hcleanup⟩ :=
    exists_exceptional_anticomplete_cores_of_cycleFree_localRobustHub_family
      G hk hhub hdisj hfree hτn hτk hθ hcycle
  refine ⟨U, hU, ?_⟩
  let C : Finset (Finset V) := Finset.univ.image U
  obtain ⟨X, hX, hanti⟩ := hcleanup
  refine ⟨X, hX, hanti, ?_⟩
  intro i
  exact sub_le_card_sdiff_of_le_card_of_card_le (hU i).1 hX

/-- Bootstrap the cleanup count.  If the quadratic exceptional charge based
on the number of peeled regions is smaller than the uniform core size `τ`,
then every selected core survives the deletion.  The surviving anticomplete
cores are still distinct, so independence forces their number below `n`. -/
theorem exists_exceptional_anticomplete_cores_with_card_lt_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 9 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hτF : 2 * F.card * F.card < τ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let C : Finset (Finset V) := Finset.univ.image U
      ∃ X : Finset V, X.card ≤ 2 * C.card * C.card ∧
        PairwiseAnticomplete G (C.image fun A => A \ X) ∧ C.card < n := by
  obtain ⟨U, hU, hcleanup⟩ :=
    exists_exceptional_anticomplete_large_cores_of_cycleFree_localRobustHub_family
      G hk hhub hdisj hfree hτn hτk hθ hcycle
  refine ⟨U, hU, ?_⟩
  let C : Finset (Finset V) := Finset.univ.image U
  obtain ⟨X, hX, hanti, hret⟩ := hcleanup
  have hCcard : C.card ≤ F.card := by
    calc
      C.card ≤ (Finset.univ : Finset F).card := Finset.card_image_le
      _ = F.card := by simp
  have hcharge : 2 * C.card * C.card < τ := by
    have hle : 2 * C.card * C.card ≤ 2 * F.card * F.card := by
      gcongr
    exact hle.trans_lt hτF
  have hne : ∀ A ∈ C, (A \ X).Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    apply Finset.card_pos.mp
    have hpos : 0 < τ - 2 * C.card * C.card := by omega
    exact hpos.trans_le (hret i)
  have hCdisj : DisjointFinsetFamily C := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAB rfl
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    exact (hdisj i i.2 j j.2 hval).mono (hU i).2.1 (hU j).2.1
  refine ⟨X, hX, hanti, ?_⟩
  exact card_lt_of_nonempty_sdiff_pairwiseAnticomplete G hfree hCdisj hne hanti

/-- A path whose endpoints lie in a robust pair set can be closed to the
prescribed cycle length whenever the pair reservoir is larger than the path
support.  This is the first direct bridge from the DRC output to `Cₖ`. -/
theorem cycleGraph_isContained_of_robust_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ k : ℕ} (hk : 3 ≤ k)
    (hrob : RobustPairSet G U T θ)
    {a b : V} (ha : a ∈ U) (hb : b ∈ U) {p : G.Walk a b}
    (hp : p.IsPath) (hlen : p.length + 2 = k) (hsupport : p.support.toFinset.card < θ) :
    cycleGraph k ⊑ G := by
  obtain ⟨z, _hzT, hzsupport, haz, hzb⟩ :=
    exists_fresh_commonNeighbor_of_pair G (hrob a ha b hb) hsupport
  apply cycleGraph_isContained_of_path_and_fresh_commonNeighbor G hk hp hlen haz hzb
  simpa using hzsupport

/-- In the most common numerical form, a robust threshold strictly larger
than `k - 1` closes every path of length `k - 2` between two reservoir
vertices. -/
theorem cycleGraph_isContained_of_robust_path_length_pred
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ k : ℕ} (hk : 3 ≤ k)
    (hrob : RobustPairSet G U T θ) (hθ : k - 1 < θ)
    {a b : V} (ha : a ∈ U) (hb : b ∈ U) {p : G.Walk a b}
    (hp : p.IsPath) (hlen : p.length = k - 2) :
    cycleGraph k ⊑ G := by
  apply cycleGraph_isContained_of_robust_path G hk hrob ha hb hp
  · omega
  · rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support, hlen]
    omega

/-- A single robust reservoir that is large on the scale of the target cycle
already forces that cycle.  Build a path of length k-2 between two
reservoir vertices and close it through one additional fresh common
neighbour.  In a counterexample this theorem is the quantitative reason
that every surviving hub must stay below the full cycle scale. -/
theorem cycleGraph_isContained_of_large_robustPairSet
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n k : ℕ} (hk : 7 ≤ k)
    (hrob : RobustPairSet G U T θ) (hfree : G.IndepSetFree n)
    (hUn : n + 2 ≤ U.card) (hUk : k - 2 ≤ U.card) (hθ : k ≤ θ) :
    cycleGraph k ⊑ G := by
  have htwo : 1 < U.card := by omega
  obtain ⟨a, b, haU, hbU, hab⟩ := Finset.one_lt_card_iff.mp htwo
  obtain ⟨p, hp, hplen, _hploc⟩ :=
    exists_path_between_of_large_robustPairSet G hrob hfree hUn haU hbU hab
      (ℓ := k - 2) (by omega) hUk (by omega)
  apply cycleGraph_isContained_of_robust_path_length_pred G (by omega) hrob
      (by omega) haU hbU hp
  exact hplen

/-- Contrapositive form used by stability: a cycle-free graph cannot contain
a robust reservoir that is simultaneously large enough for the independent
set argument and large enough to span the target cycle scale. -/
theorem robustPairSet_card_lt_of_cycleFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ n k : ℕ} (hk : 7 ≤ k)
    (hrob : RobustPairSet G U T θ) (hfree : G.IndepSetFree n)
    (hUn : n + 2 ≤ U.card) (hθ : k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    U.card < k - 2 := by
  by_contra hnot
  apply hcycle
  exact cycleGraph_isContained_of_large_robustPairSet G hk hrob hfree hUn
    (by omega) hθ

/-- Direct DRC-to-cycle bridge.  Once the selected common-neighbour set is
large enough both for parity breaking and for the target path length, the
earlier DRC inequalities cannot all hold in a cycle-free graph. -/
theorem cycleGraph_isContained_of_drc_univ
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {θ t τ n k : ℕ} (hk : 7 ≤ k) (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hdensity : ρ * Fintype.card V * Fintype.card V ≤ 2 * G.edgeFinset.card)
    (hθDRC : (θ : ℝ) ≤ η * ρ ^ 2 * Fintype.card V)
    (hτDRC : (τ : ℝ) ^ 2 ≤ ((ρ ^ t) * Fintype.card V) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card V : ℝ) ^ 2)
    (hτn : n + 2 ≤ τ) (hτk : k - 2 ≤ τ) (hθk : k ≤ θ)
    (hfree : G.IndepSetFree n) :
    cycleGraph k ⊑ G := by
  obtain ⟨U, hUcard, hrob⟩ :=
    exists_robustPairSet_univ_of_drc G ht hτpos hη hρ hdensity hθDRC
      hτDRC hsmall
  exact cycleGraph_isContained_of_large_robustPairSet G hk hrob hfree
    (hτn.trans hUcard) (hτk.trans hUcard) hθk

/-- Minimum-degree form of the preceding DRC-to-cycle bridge.  This is the
version consumed after passing to one of the induced minimum-degree cores
or to a BFS dense slice. -/
theorem cycleGraph_isContained_of_minDegree_drc
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {d θ t τ n k : ℕ} (hk : 7 ≤ k) (hd : 0 < d)
    (hmin : d ≤ 2 * G.minDegree) (ht : 0 < t) (hτpos : 0 < τ)
    {η : ℝ} (hη : 0 < η)
    (hθDRC : (θ : ℝ) ≤ η *
      ((d : ℝ) / (2 * Fintype.card V)) ^ 2 * Fintype.card V)
    (hτDRC : (τ : ℝ) ^ 2 ≤
      ((((d : ℝ) / (2 * Fintype.card V)) ^ t) * Fintype.card V) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card V : ℝ) ^ 2)
    (hτn : n + 2 ≤ τ) (hτk : k - 2 ≤ τ) (hθk : k ≤ θ)
    (hfree : G.IndepSetFree n) :
    cycleGraph k ⊑ G := by
  obtain ⟨U, hUcard, hrob⟩ :=
    exists_robustPairSet_univ_of_le_two_mul_minDegree G hd hmin ht hτpos
      hη hθDRC hτDRC hsmall
  exact cycleGraph_isContained_of_large_robustPairSet G hk hrob hfree
    (hτn.trans hUcard) (hτk.trans hUcard) hθk

/-- Induced-piece form of the DRC-to-cycle bridge.  Dense extraction produces
a finite vertex set rather than a new ambient graph; run DRC on its induced
graph, then transport the resulting cycle through the canonical induced
embedding. -/
theorem cycleGraph_isContained_of_induced_drc
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {S : Finset V} (hS : S.Nonempty)
    {θ t τ n k : ℕ} (hk : 7 ≤ k) (ht : 0 < t) (hτpos : 0 < τ)
    {η ρ : ℝ} (hη : 0 < η) (hρ : 0 < ρ)
    (hdensity : ρ * Fintype.card S * Fintype.card S ≤
      2 * (G.induce (S : Set V)).edgeFinset.card)
    (hθDRC : (θ : ℝ) ≤ η * ρ ^ 2 * Fintype.card S)
    (hτDRC : (τ : ℝ) ^ 2 ≤ ((ρ ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2)
    (hτn : n + 2 ≤ τ) (hτk : k - 2 ≤ τ) (hθk : k ≤ θ)
    (hfree : G.IndepSetFree n) :
    cycleGraph k ⊑ G := by
  classical
  let H : SimpleGraph S := G.induce (S : Set V)
  let : Nonempty S := hS.to_subtype
  have hcopy : cycleGraph k ⊑ H := by
    apply cycleGraph_isContained_of_drc_univ H hk ht hτpos hη hρ
    · simpa [H] using hdensity
    · simpa [H] using hθDRC
    · simpa [H] using hτDRC
    · simpa [H] using hsmall
    · exact hτn
    · exact hτk
    · exact hθk
    · simpa [H] using Erdos551.IndepSetFree.induce hfree S
  exact hcopy.trans (SimpleGraph.Embedding.induce (G := G) (S : Set V)).isContained

/-- If a robust set lives in a Ck-free graph, then its induced graph has
small minimum degree.  Indeed a long path inside the set has both endpoints
in the robust reservoir and the preceding lemma closes it to Ck.  This is
the first stability inequality extracted from the hub condition. -/
theorem induced_minDegree_lt_of_robustPairSet_of_cycleFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ k : ℕ} (hk : 3 ≤ k) (hU : U.Nonempty)
    (hrob : RobustPairSet G U T θ) (hθ : k - 1 < θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (G.induce (U : Set V)).minDegree < k - 2 := by
  classical
  let H : SimpleGraph U := G.induce (U : Set V)
  let : Nonempty U := hU.to_subtype
  by_contra hnot
  have hmin : k - 2 ≤ H.minDegree := by
    simpa [H] using (Nat.le_of_not_gt hnot)
  obtain ⟨x⟩ := ‹Nonempty U›
  obtain ⟨y, p, hp, hplen⟩ := hasPathFromAtLeast_of_le_minDegree H x hmin
  let p' := p.take (k - 2)
  have hp' : p'.IsPath := by
    exact hp.take (k - 2)
  have hp'len : p'.length = k - 2 := by
    simp only [p', Walk.take_length]
    omega
  let e : H ↪g G := SimpleGraph.Embedding.induce (U : Set V)
  let q : G.Walk (e x) (e (p.getVert (k - 2))) := p'.map e.toHom
  have hq : q.IsPath := by
    exact hp'.map e.injective
  have hqlen : q.length = k - 2 := by
    simpa [q] using hp'len
  apply hcycle
  apply cycleGraph_isContained_of_robust_path_length_pred G hk hrob hθ
      (a := e x) (b := e (p.getVert (k - 2))) (p := q)
  · exact x.property
  · exact (p.getVert (k - 2)).property
  · exact hq
  · exact hqlen

/-- A cycle-free robust reservoir is sparse in the Erdős--Gallai sense.
Every path of length at least \`k-2\` in the graph induced by \`U\` has an
initial segment of length exactly \`k-2\`; its endpoints still lie in \`U\`,
and robustness closes that segment through one fresh common neighbour.
The already-proved path-density estimate therefore bounds the number of
internal edges by \`(k-2)|U|\`.  This is the quantitative form of the first
stability inequality used when hubs are deleted greedily. -/
theorem induced_edgeFinset_card_lt_mul_of_robustPairSet_of_cycleFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {U T : Finset V} {θ k : ℕ} (hk : 3 ≤ k) (hU : U.Nonempty)
    (hrob : RobustPairSet G U T θ) (hθ : k - 1 < θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (G.induce (U : Set V)).edgeFinset.card < (k - 2) * U.card := by
  classical
  let H : SimpleGraph U := G.induce (U : Set V)
  let : Nonempty U := hU.to_subtype
  have hno : ¬ ∃ u v : U, ∃ p : H.Walk u v,
      p.IsPath ∧ k - 2 ≤ p.length := by
    rintro ⟨u, v, p, hp, hplen⟩
    let p₀ := p.take (k - 2)
    have hp₀ : p₀.IsPath := hp.take (k - 2)
    have hp₀len : p₀.length = k - 2 := by
      simp only [p₀, Walk.take_length]
      omega
    let e : H ↪g G := SimpleGraph.Embedding.induce (U : Set V)
    let q : G.Walk (e u) (e (p.getVert (k - 2))) := p₀.map e.toHom
    have hq : q.IsPath := hp₀.map e.injective
    have hqlen : q.length = k - 2 := by
      simpa [q] using hp₀len
    apply hcycle
    apply cycleGraph_isContained_of_robust_path_length_pred G hk hrob hθ
        (a := e u) (b := e (p.getVert (k - 2))) (p := q)
    · exact u.property
    · exact (p.getVert (k - 2)).property
    · exact hq
    · exact hqlen
  simpa [H] using card_edgeFinset_lt_mul_card_of_no_long_path H (k - 2) hno

/-- If no `D`-long path starts at `x`, a maximal path from `x` is short and
its terminal neighbourhood is completely trapped inside its support. -/
theorem exists_short_path_trapping_terminal_neighbors {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (x : V) (D : ℕ)
    (hno : ¬ HasPathFromAtLeast G x D) :
    ∃ v : V, ∃ p : G.Walk x v, p.IsPath ∧ p.length < D ∧
      p.support.toFinset.card ≤ D ∧
      G.neighborFinset v ⊆ p.support.toFinset := by
  obtain ⟨v, p, hp, hmax⟩ := exists_maximal_isPath_from G x
  have hlen : p.length < D := by
    by_contra hlen
    exact hno ⟨v, p, hp, by omega⟩
  refine ⟨v, p, hp, hlen, ?_, ?_⟩
  · rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support]
    omega
  · intro w hw
    rw [SimpleGraph.mem_neighborFinset] at hw
    have hwmem : w ∈ p.support := by
      by_contra hnot
      have hp' : (p.concat hw).IsPath := hp.concat hnot (h := hw)
      have hle := hmax w (p.concat hw) hp'
      simp at hle
    simpa using hwmem

/-- The successors of the terminal neighbors of a longest path force a
quadratic amount of edge mass inside the path support.  Each successor has
all of its neighbors on the path, the successor map is injective, and there
are at least minimum-degree-many successors. -/
theorem minDegree_sq_le_twice_card_inducedEdgeFinsetOn_of_maximal_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length) :
    G.minDegree * G.minDegree ≤
      2 * (inducedEdgeFinsetOn G p.support.toFinset).card := by
  classical
  let S : Finset V := p.support.toFinset
  let T : Finset V := terminalSuccessorFinset G p
  have hTS : T ⊆ S := by
    simpa [S, T] using
      terminalSuccessorFinset_subset_support_of_maximal_path G hp hmax
  have hclosed : ∀ z ∈ T, degreeIn G S z = G.degree z := by
    intro z hz
    apply degreeIn_eq_degree_of_neighborFinset_subset
    simpa [S, T] using
      neighborFinset_subset_support_of_mem_terminalSuccessorFinset G hp hmax hz
  have hdegreeSum :
      G.minDegree * T.card ≤ ∑ z ∈ T, degreeIn G S z := by
    calc
      G.minDegree * T.card = ∑ _z ∈ T, G.minDegree := by
        simp [Nat.mul_comm]
      _ ≤ ∑ z ∈ T, degreeIn G S z := by
        apply Finset.sum_le_sum
        intro z hz
        rw [hclosed z hz]
        exact G.minDegree_le_degree z
  have hsubsetSum :
      ∑ z ∈ T, degreeIn G S z ≤ ∑ z ∈ S, degreeIn G S z :=
    Finset.sum_le_sum_of_subset hTS
  have hhandshake :
      ∑ z ∈ S, degreeIn G S z =
        2 * (inducedEdgeFinsetOn G S).card :=
    sum_degreeIn_eq_twice_card_inducedEdgeFinsetOn G S
  have hTcard : T.card = G.degree v := by
    simpa [T] using card_terminalSuccessorFinset_eq_degree_of_maximal_path G hp hmax
  have hminT : G.minDegree ≤ T.card := by
    rw [hTcard]
    exact G.minDegree_le_degree v
  calc
    G.minDegree * G.minDegree ≤ G.minDegree * T.card :=
      Nat.mul_le_mul_left _ hminT
    _ ≤ ∑ z ∈ T, degreeIn G S z := hdegreeSum
    _ ≤ ∑ z ∈ S, degreeIn G S z := hsubsetSum
    _ = 2 * (inducedEdgeFinsetOn G S).card := hhandshake
    _ = 2 * (inducedEdgeFinsetOn G p.support.toFinset).card := by rfl

/-- The same successor set gives the complementary size estimate: the
support of a longest path contains at least minimum-degree-many vertices.
Together with the upper length bound this keeps every later DRC parameter
uniform on a genuine interval of piece sizes. -/
theorem minDegree_le_card_support_of_maximal_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {x v : V} {p : G.Walk x v} (hp : p.IsPath)
    (hmax : ∀ (v' : V) (p' : G.Walk x v'), p'.IsPath → p'.length ≤ p.length) :
    G.minDegree ≤ p.support.toFinset.card := by
  have hsub :=
    terminalSuccessorFinset_subset_support_of_maximal_path G hp hmax
  have hcard := Finset.card_le_card hsub
  have hTcard :=
    card_terminalSuccessorFinset_eq_degree_of_maximal_path G hp hmax
  rw [hTcard] at hcard
  exact (G.minDegree_le_degree v).trans hcard

/-- If a prescribed start has no long path, its longest path has bounded
support but still contains quadratic edge mass.  This is the short dense
alternative used before applying dependent random choice. -/
theorem exists_short_dense_support_of_no_long_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (x : V) (D : ℕ) (hno : ¬ HasPathFromAtLeast G x D) :
    ∃ S : Finset V, S.Nonempty ∧ S.card ≤ D ∧
      G.minDegree * G.minDegree ≤ 2 * (inducedEdgeFinsetOn G S).card := by
  classical
  obtain ⟨v, p, hp, hmax⟩ := exists_maximal_isPath_from G x
  have hlen : p.length < D := by
    by_contra hlen
    exact hno ⟨v, p, hp, by omega⟩
  refine ⟨p.support.toFinset, ?_, ?_, ?_⟩
  · exact ⟨x, by simp⟩
  · rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support]
    omega
  · exact minDegree_sq_le_twice_card_inducedEdgeFinsetOn_of_maximal_path G hp hmax

/-- Strengthened short-dense alternative retaining both size bounds.  The
lower bound is as important as the upper bound when one chooses uniform DRC
parameters for all pieces extracted from a counterexample. -/
theorem exists_short_dense_support_with_size_bounds_of_no_long_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (x : V) (D : ℕ) (hno : ¬ HasPathFromAtLeast G x D) :
    ∃ S : Finset V, S.Nonempty ∧ G.minDegree ≤ S.card ∧ S.card ≤ D ∧
      G.minDegree * G.minDegree ≤ 2 * (inducedEdgeFinsetOn G S).card := by
  classical
  obtain ⟨v, p, hp, hmax⟩ := exists_maximal_isPath_from G x
  have hlen : p.length < D := by
    by_contra hlen
    exact hno ⟨v, p, hp, by omega⟩
  refine ⟨p.support.toFinset, ⟨x, by simp⟩, ?_, ?_, ?_⟩
  · exact minDegree_le_card_support_of_maximal_path G hp hmax
  · rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support]
    omega
  · exact minDegree_sq_le_twice_card_inducedEdgeFinsetOn_of_maximal_path G hp hmax

/-- In a graph of minimum degree at least k-1, failure of a k-edge path
from one vertex already forces a k-cycle.  On the longest short path the
Pósa successor set has at least k-1 vertices.  If its support has only
k-1 vertices the terminal degree is impossible; if it has k vertices, the
successors saturate the support and Dirac closes a spanning cycle. -/
theorem cycleGraph_isContained_of_no_long_path_of_minDegree_pred
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) (hmin : k - 1 ≤ G.minDegree)
    (x : V) (hno : ¬ HasPathFromAtLeast G x k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨v, p, hp, hmax⟩ := exists_maximal_isPath_from G x
  have hlen : p.length < k := by
    by_contra hlen
    exact hno ⟨v, p, hp, by omega⟩
  let S : Finset V := p.support.toFinset
  let T : Finset V := terminalSuccessorFinset G p
  have hSnonempty : S.Nonempty := ⟨x, by simp [S]⟩
  have hSle : S.card ≤ k := by
    dsimp [S]
    rw [List.toFinset_card_of_nodup hp.support_nodup, p.length_support]
    omega
  have hSlow : k - 1 ≤ S.card :=
    hmin.trans (by
      simpa [S] using minDegree_le_card_support_of_maximal_path G hp hmax)
  have hTsub : T ⊆ S := by
    simpa [S, T] using
      terminalSuccessorFinset_subset_support_of_maximal_path G hp hmax
  have hTcard : T.card = G.degree v := by
    simpa [T] using card_terminalSuccessorFinset_eq_degree_of_maximal_path G hp hmax
  have hTlow : k - 1 ≤ T.card := by
    rw [hTcard]
    exact hmin.trans (G.minDegree_le_degree v)
  have hclosed : ∀ z ∈ T, G.neighborFinset z ⊆ S := by
    intro z hz
    simpa [S, T] using
      neighborFinset_subset_support_of_mem_terminalSuccessorFinset G hp hmax hz
  have hScases : S.card = k - 1 ∨ S.card = k := by omega
  rcases hScases with hScard | hScard
  · have hterminal : G.neighborFinset v ⊆ S := by
      intro w hw
      have hwAdj : G.Adj v w := (SimpleGraph.mem_neighborFinset G v w).1 hw
      have hwmem : w ∈ p.support := by
        by_contra hnot
        have hp' : (p.concat hwAdj).IsPath := hp.concat hnot (h := hwAdj)
        have hle := hmax w (p.concat hwAdj) hp'
        simp at hle
      simpa [S] using hwmem
    have hsuberase : G.neighborFinset v ⊆ S.erase v := by
      intro w hw
      have hadj : G.Adj v w := (SimpleGraph.mem_neighborFinset G v w).1 hw
      exact Finset.mem_erase.mpr ⟨hadj.ne.symm, hterminal hw⟩
    have hcardle := Finset.card_le_card hsuberase
    rw [SimpleGraph.card_neighborFinset_eq_degree,
      Finset.card_erase_of_mem (by simp [S]), hScard] at hcardle
    have hvdeg : k - 1 ≤ G.degree v := hmin.trans (G.minDegree_le_degree v)
    omega
  · apply cycleGraph_isContained_of_induced_two_mul_degree_ge_card G hk hScard
    intro y
    have hyS : (y : V) ∈ S := y.property
    by_cases hyT : (y : V) ∈ T
    · have hyclosed : G.neighborFinset y ⊆ S := hclosed y hyT
      have hydeg : k - 1 ≤ G.degree y := hmin.trans (G.minDegree_le_degree y)
      rw [degree_induce_finset_eq_degreeIn]
      rw [degreeIn_eq_degree_of_neighborFinset_subset G S y hyclosed]
      omega
    · have hTneighbors : T ⊆ S.filter fun z => G.Adj y z := by
        intro z hz
        have hzclosed : G.neighborFinset z ⊆ S := hclosed z hz
        have hzdeg : S.card - 1 ≤ G.degree z := by
          rw [hScard]
          exact hmin.trans (G.minDegree_le_degree z)
        have hsat :=
          neighborFinset_eq_erase_of_subset_of_pred_le_degree G S z
            (hTsub hz) hzclosed hzdeg
        have hyz : (y : V) ∈ S.erase z := Finset.mem_erase.mpr ⟨by
          intro hyz
          apply hyT
          simpa [hyz] using hz, hyS⟩
        have hzy : G.Adj z y := by
          apply (SimpleGraph.mem_neighborFinset G z y).1
          rw [hsat]
          exact hyz
        exact Finset.mem_filter.mpr ⟨hTsub hz, hzy.symm⟩
      have hcardle := Finset.card_le_card hTneighbors
      have hydegIn : k - 1 ≤ degreeIn G S y := by
        unfold degreeIn
        exact hTlow.trans hcardle
      rw [degree_induce_finset_eq_degreeIn]
      omega

/-- Consequently, in the dense counterexample branch every prescribed
vertex starts a k-edge path.  This is the path side of the KLS
long-path-or-dense-piece dichotomy after the low-degree deletion induction
has raised the ambient minimum degree to k-1. -/
theorem hasPathFromAtLeast_of_cycleFree_minDegree_pred
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {k : ℕ} (hk : 3 ≤ k) (hmin : k - 1 ≤ G.minDegree)
    (hcycle : ¬ cycleGraph k ⊑ G) (x : V) :
    HasPathFromAtLeast G x k := by
  by_contra hno
  exact hcycle
    (cycleGraph_isContained_of_no_long_path_of_minDegree_pred G hk hmin x hno)

/-- Every nonterminal vertex on a shortest path from a root lies in a
strictly earlier BFS layer.  This is the elementary metric fact behind the
tree-detour part of KLS: shortest root paths leave a fixed layer immediately
and do not return to it before their endpoints. -/
theorem dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
    {V : Type*} (G : SimpleGraph V) {root a z : V}
    {p : G.Walk root a} (hshort : p.length = G.dist root a)
    (hz : z ∈ p.support) (hza : z ≠ a) :
    G.dist root z < p.length := by
  classical
  let j : ℕ := p.support.idxOf z
  have hjltSupport : j < p.support.length := List.idxOf_lt_length_of_mem hz
  have hjle : j ≤ p.length := by
    rw [p.length_support] at hjltSupport
    omega
  have hjlt : j < p.length := by
    by_contra hnot
    have hjeq : j = p.length := by omega
    apply hza
    calc
      z = p.getVert j := (p.getVert_support_idxOf hz).symm
      _ = p.getVert p.length := by rw [hjeq]
      _ = a := p.getVert_length
  have htake :=
    SimpleGraph.length_eq_dist_of_subwalk hshort (p.isSubwalk_take j)
  have htakelen : (p.take j).length = j := by
    simp [Walk.take_length, Nat.min_eq_left hjle]
  rw [htakelen, p.getVert_support_idxOf hz] at htake
  omega

/-- Every prefix of a shortest root path is itself shortest, with its
endpoint lying in the BFS layer indexed by the prefix length.  Keeping the
statement at `getVert` indices makes the parity bookkeeping for the union of
two root geodesics completely local. -/
theorem dist_getVert_eq_index_of_shortest_path
    {V : Type*} (G : SimpleGraph V) {root a : V}
    {p : G.Walk root a} (hshort : p.length = G.dist root a)
    {j : ℕ} (hj : j ≤ p.length) :
    G.dist root (p.getVert j) = j := by
  have htake :=
    SimpleGraph.length_eq_dist_of_subwalk hshort (p.isSubwalk_take j)
  have htakelen : (p.take j).length = j := by
    simp [Walk.take_length, Nat.min_eq_left hj]
  rw [htakelen] at htake
  exact htake.symm

/-- Consecutive vertices of a shortest root path have opposite distance
parity.  This is phrased for every edge of the walk subgraph so it can be
used after reversing and adjoining two shortest paths. -/
theorem dist_mod_two_ne_of_adj_toSubgraph_of_shortest_path
    {V : Type*} (G : SimpleGraph V) {root a x y : V}
    {p : G.Walk root a} (hshort : p.length = G.dist root a)
    (hxy : p.toSubgraph.Adj x y) :
    (G.dist root x % 2 = 0) ≠ (G.dist root y % 2 = 0) := by
  obtain ⟨j, hedge, hj⟩ := (p.toSubgraph_adj_iff).mp hxy
  have hjle : j ≤ p.length := by omega
  have hjsuccle : j + 1 ≤ p.length := by omega
  have hjdist : G.dist root (p.getVert j) = j :=
    dist_getVert_eq_index_of_shortest_path G hshort hjle
  have hjsuccdist : G.dist root (p.getVert (j + 1)) = j + 1 :=
    dist_getVert_eq_index_of_shortest_path G hshort hjsuccle
  have hparity : (j % 2 = 0) ≠ ((j + 1) % 2 = 0) := by
    intro heq
    by_cases hjzero : j % 2 = 0
    · have hsuccne : (j + 1) % 2 ≠ 0 := by omega
      apply hsuccne
      rw [← heq]
      exact hjzero
    · have hsucczero : (j + 1) % 2 = 0 := by omega
      apply hjzero
      rw [heq]
      exact hsucczero
  rcases Sym2.eq_iff.mp hedge with hdir | hswap
  · rcases hdir with ⟨h₁, h₂⟩
    have hx : G.dist root x = j := by
      rw [← h₁]
      exact hjdist
    have hy : G.dist root y = j + 1 := by
      rw [← h₂]
      exact hjsuccdist
    rw [hx, hy]
    exact hparity
  · rcases hswap with ⟨h₁, h₂⟩
    have hx : G.dist root x = j + 1 := by
      rw [← h₂]
      exact hjsuccdist
    have hy : G.dist root y = j := by
      rw [← h₁]
      exact hjdist
    rw [hx, hy]
    exact hparity.symm

/-- Bypassing the union of two shortest root paths to vertices in the same
BFS layer preserves even length.  The union is bipartite under root-distance
parity: every one of its edges lies on one of the two geodesics.  Transferring
the bypassed path to that union and applying the two-coloring parity theorem
then gives the required parity without making any assumption about which
common vertices the bypass operation removes. -/
theorem even_length_bypass_reverse_append_of_shortest_paths
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a b : V} {i : ℕ}
    {pa : G.Walk root a} {pb : G.Walk root b}
    (hpa : pa.length = G.dist root a)
    (hpb : pb.length = G.dist root b)
    (ha : G.dist root a = i) (hb : G.dist root b = i) :
    Even ((pa.reverse.append pb).bypass.length) := by
  classical
  let r : G.Walk a b := pa.reverse.append pb
  let q : G.Walk a b := r.bypass
  let K : SimpleGraph V := r.toSubgraph.spanningCoe
  let c : K.Coloring Bool :=
    Coloring.mk (fun z => G.dist root z % 2 = 0) (by
      intro x y hxy
      have hrxy : r.toSubgraph.Adj x y := by
        simpa [K] using hxy
      have hsplit : pa.toSubgraph.Adj x y ∨ pb.toSubgraph.Adj x y := by
        simpa [r] using hrxy
      rcases hsplit with hpaXY | hpbXY
      · have hne := dist_mod_two_ne_of_adj_toSubgraph_of_shortest_path
          G hpa hpaXY
        intro hdec
        exact hne (propext (decide_eq_decide.mp hdec))
      · have hne := dist_mod_two_ne_of_adj_toSubgraph_of_shortest_path
          G hpb hpbXY
        intro hdec
        exact hne (propext (decide_eq_decide.mp hdec)))
  have hqedges : ∀ e, e ∈ q.edges → e ∈ K.edgeSet := by
    intro e he
    change e ∈ r.toSubgraph.edgeSet
    rw [Walk.mem_edges_toSubgraph]
    exact r.edges_bypass_subset_edges he
  let qK : K.Walk a b := q.transfer K hqedges
  have hcolor : c a ↔ c b := by
    change (decide (G.dist root a % 2 = 0) = true ↔
      decide (G.dist root b % 2 = 0) = true)
    rw [ha, hb]
  have heven : Even qK.length :=
    (c.even_length_iff_congr qK).2 hcolor
  simpa [qK, q] using heven

/-- A shortest root path to a vertex in one BFS layer has no other vertex
in that same layer.  This is the endpoint-oriented version of the preceding
metric lemma: it packages the chosen shortest path together with the exact
support-avoidance fact used when a nested BFS tree is spliced to a long path
in the terminal layer. -/
theorem exists_shortest_path_to_bfsLayer_avoiding_layer
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a : V} {i : ℕ}
    (hroota : G.Reachable root a) (ha : G.dist root a = i) :
    ∃ q : G.Walk root a, q.IsPath ∧ q.length = i ∧
      ∀ z ∈ q.support, z = a ∨ z ∉ Erdos752.bfsLayer G root i := by
  classical
  obtain ⟨q, hq, hqLen⟩ := hroota.exists_path_of_dist
  refine ⟨q, hq, hqLen.trans ha, ?_⟩
  intro z hz
  by_cases hza : z = a
  · exact Or.inl hza
  · right
    intro hzlayer
    have hzdist : G.dist root z = i := hzlayer
    have hlt :=
      dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
        G hqLen hz hza
    rw [hqLen, ha] at hlt
    omega

/-- Every vertex on a shortest root path lies in the BFS ball whose radius
bounds the path length.  This is the finite-set membership form needed after
a separator step: the recorded envelope is the next BFS ball, so all
vertices of the later inner-root detour remain inside that envelope. -/
theorem shortest_path_support_subset_bfsBall_toFinset
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a : V} {j : ℕ} {q : G.Walk root a}
    (hshort : q.length = G.dist root a) (hlen : q.length ≤ j) :
    ∀ z ∈ q.support, z ∈ (bfsBall G root j).toFinset := by
  intro z hz
  apply (Set.mem_toFinset (s := bfsBall G root j)).mpr
  change G.dist root z ≤ j
  by_cases hza : z = a
  · subst z
    rw [← hshort]
    exact hlen
  · have hlt :=
      dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
        G hshort hz hza
    omega

/-- A mapped BFS ball contained in a union of pairwise-disjoint
anticomplete blocks lies in one block.  Every ball vertex has a shortest
path to the root that stays in the ball, so walk localization identifies its
block with the root block.  This is the exact first-pass/second-pass
provenance bridge used by the KLS nested splice. -/
theorem exists_member_containing_mapped_bfsBall_of_pairwiseAnticomplete
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {F : Finset (Finset V)} (hdisj : DisjointFinsetFamily F)
    (hanti : PairwiseAnticomplete G F)
    {S D : Finset V}
    {c : (G.induce (S : Set V)).ConnectedComponent}
    {root : c} {j : ℕ}
    (hDeq : D = ((bfsBall c.toSimpleGraph root (j + 1)).toFinset).map
      ⟨fun x => x.1.1, by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)⟩)
    (hD : D ⊆ F.biUnion id) :
    ∃ A ∈ F, ∀ z : c,
      z ∈ (bfsBall c.toSimpleGraph root (j + 1)).toFinset →
        z.1.1 ∈ A := by
  classical
  let K : SimpleGraph c := c.toSimpleGraph
  let e : K ↪g G :=
    { toFun := fun x => x.1.1
      inj' := by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)
      map_rel_iff' := by
        intro x y
        rfl }
  have hrootBall : root ∈ (bfsBall K root (j + 1)).toFinset := by
    apply (Set.mem_toFinset (s := bfsBall K root (j + 1))).mpr
    simp [bfsBall]
  have hrootD : root.1.1 ∈ D := by
    rw [hDeq]
    exact Finset.mem_map.mpr ⟨root, by simpa [K] using hrootBall, rfl⟩
  have hrootU : root.1.1 ∈ F.biUnion id := hD hrootD
  rcases Finset.mem_biUnion.mp hrootU with ⟨A, hA, hrootA⟩
  refine ⟨A, hA, ?_⟩
  intro z hzBall
  have hzdist : K.dist root z ≤ j + 1 := by
    exact (Set.mem_toFinset (s := bfsBall K root (j + 1))).mp hzBall
  obtain ⟨p, hp, hpLen⟩ := c.connected_toSimpleGraph.exists_path_of_dist root z
  have hpBall : ∀ w ∈ p.support,
      w ∈ (bfsBall K root (j + 1)).toFinset :=
    shortest_path_support_subset_bfsBall_toFinset K hpLen (by
      rw [hpLen]
      exact hzdist)
  let q : G.Walk (e root) (e z) := p.map e.toHom
  have hqsupp : ∀ w ∈ q.support, w ∈ F.biUnion id := by
    intro w hw
    dsimp [q] at hw
    rw [Walk.support_map] at hw
    rcases List.mem_map.mp hw with ⟨u, hu, rfl⟩
    apply hD
    rw [hDeq]
    exact Finset.mem_map.mpr ⟨u, by simpa [K] using hpBall u hu, rfl⟩
  obtain ⟨B, hB, hqB⟩ :=
    exists_member_containing_walk_support_of_pairwiseAnticomplete
      G hanti q hqsupp
  have hrootB : root.1.1 ∈ B := hqB _ q.start_mem_support
  have hAB : A = B := by
    by_contra hne
    exact (Finset.disjoint_left.mp (hdisj A hA B hB hne)) hrootA hrootB
  subst B
  exact hqB _ q.end_mem_support

/-- The subgraph induced by a metric ball in a connected graph is still
connected.  A shortest root path to a ball vertex never leaves the ball,
so it supplies a walk in the induced graph. -/
theorem induce_bfsBall_connected_of_connected
    {V : Type*} [Fintype V] (G : SimpleGraph V) (hconn : G.Connected)
    (root : V) (j : ℕ) :
    (G.induce (((bfsBall G root j).toFinset : Finset V) : Set V)).Connected := by
  classical
  let B : Finset V := (bfsBall G root j).toFinset
  rw [connected_iff_exists_forall_reachable]
  have hroot : root ∈ B := by
    apply (Set.mem_toFinset (s := bfsBall G root j)).mpr
    simp [bfsBall]
  refine ⟨⟨root, hroot⟩, ?_⟩
  rintro ⟨z, hz⟩
  have hzdist : G.dist root z ≤ j := by
    exact (Set.mem_toFinset (s := bfsBall G root j)).mp hz
  obtain ⟨p, _hp, hpLen⟩ := hconn.exists_path_of_dist root z
  have hpB : ∀ w ∈ p.support, w ∈ B :=
    shortest_path_support_subset_bfsBall_toFinset G hpLen (by
      rw [hpLen]
      exact hzdist)
  let q := p.induce (B : Set V) hpB
  simpa [B, q] using q.reachable

/-- Root distances are unchanged after inducing a connected graph on one of
its BFS balls.  The forward inequality maps an induced shortest path back to
the original graph; the reverse inequality lifts an original shortest path,
which stays in the ball by the preceding metric lemma. -/
theorem dist_induce_bfsBall_eq_dist_of_connected
    {V : Type*} [Fintype V] (G : SimpleGraph V) (hconn : G.Connected)
    (root : V) (j : ℕ)
    (z : (bfsBall G root j).toFinset) :
    (G.induce (((bfsBall G root j).toFinset : Finset V) : Set V)).dist
        ⟨root, by
          apply (Set.mem_toFinset (s := bfsBall G root j)).mpr
          simp [bfsBall]⟩ z =
      G.dist root z.1 := by
  classical
  let B : Finset V := (bfsBall G root j).toFinset
  let H : SimpleGraph B := G.induce (B : Set V)
  have hHconn : H.Connected := by
    simpa [H, B] using induce_bfsBall_connected_of_connected G hconn root j
  let r : B := ⟨root, by
    apply (Set.mem_toFinset (s := bfsBall G root j)).mpr
    simp [bfsBall]⟩
  obtain ⟨p, _hp, hpLen⟩ := hconn.exists_path_of_dist root z.1
  have hzdist : G.dist root z.1 ≤ j := by
    exact (Set.mem_toFinset (s := bfsBall G root j)).mp z.2
  have hpB : ∀ w ∈ p.support, w ∈ B :=
    shortest_path_support_subset_bfsBall_toFinset G hpLen (by
      rw [hpLen]
      exact hzdist)
  let q : H.Walk r z := by
    simpa [H, B, r] using p.induce (B : Set V) hpB
  have hleHG : H.dist r z ≤ G.dist root z.1 := by
    calc
      H.dist r z ≤ q.length := SimpleGraph.dist_le q
      _ = p.length := by
        let eB : H ↪g G := SimpleGraph.Embedding.induce (G := G) (B : Set V)
        have hmap : q.map eB.toHom = p := by
          simpa [q, eB, H, B, r] using
            (Walk.map_induce (s := (B : Set V)) p hpB)
        calc
          q.length = (q.map eB.toHom).length := by simp
          _ = p.length := congrArg Walk.length hmap
      _ = G.dist root z.1 := hpLen
  obtain ⟨s, _hs, hsLen⟩ := hHconn.exists_path_of_dist r z
  let e : H ↪g G := SimpleGraph.Embedding.induce (G := G) (B : Set V)
  have hleGH : G.dist root z.1 ≤ H.dist r z := by
    have hraw :
        G.dist (e r) (e z) ≤ (s.map e.toHom).length :=
      SimpleGraph.dist_le (s.map e.toHom)
    have hlen : (s.map e.toHom).length = s.length := by simp
    simpa [e, H, B, r, hlen] using hraw.trans_eq (hlen.trans hsLen)
  simpa [H, B, r] using le_antisymm hleHG hleGH

/-- A graph isomorphism preserves ordinary graph distance on a connected
graph.  We prove the two inequalities by mapping shortest paths in both
directions; this local form avoids any dependence on a separate extended-
distance API when comparing two induced copies of the same BFS ball. -/
theorem dist_eq_of_iso_of_connected
    {V W : Type*} [Fintype V] [Fintype W]
    {G : SimpleGraph V} {H : SimpleGraph W}
    (e : G ≃g H) (hconn : G.Connected) (x y : V) :
    G.dist x y = H.dist (e x) (e y) := by
  obtain ⟨p, _hp, hpLen⟩ := hconn.exists_path_of_dist x y
  let q : H.Walk (e x) (e y) := p.map e.toHom
  have hHG : H.dist (e x) (e y) ≤ G.dist x y := by
    calc
      H.dist (e x) (e y) ≤ q.length := SimpleGraph.dist_le q
      _ = p.length := by simp [q]
      _ = G.dist x y := hpLen
  have hreachH : H.Reachable (e x) (e y) := (hconn x y).map e.toHom
  obtain ⟨r, _hr, hrLen⟩ := hreachH.exists_path_of_dist
  have hGH : G.dist x y ≤ H.dist (e x) (e y) := by
    have hraw :
        G.dist (e.symm (e x)) (e.symm (e y)) ≤
          (r.map e.symm.toHom).length :=
      SimpleGraph.dist_le (r.map e.symm.toHom)
    have hlen : (r.map e.symm.toHom).length = r.length := by simp
    simpa [hlen] using hraw.trans_eq (hlen.trans hrLen)
  exact le_antisymm hGH hHG

/- 
/-- A connected graph whose embedding lands in one BFS parity union lands
in one concrete layer.  Map paths from one chosen vertex to every other
vertex, localize each mapped path inside the anticomplete parity family, and
compare its starting layer with the chosen vertex's layer. -/
theorem exists_bfsLayer_containing_connected_embedding_of_parityBfsLayerUnion
    {V W : Type*} [Fintype V] [Fintype W]
    (G : SimpleGraph V) (H : SimpleGraph W) (hHconn : H.Connected)
    (e : H ↪g G) {root : V} {j parity : ℕ}
    (hsupp : ∀ z : W, e z ∈ parityBfsLayerUnion G root j parity) :
    ∃ i : ℕ, i ≤ j ∧ i % 2 = parity ∧
      ∀ z : W, G.dist root (e z) = i := by
  classical
  letI : Nonempty W := hHconn.nonempty
  let z₀ : W := Classical.choice inferInstance
  let q₀ : G.Walk (e z₀) (e z₀) := Walk.nil
  have hq₀supp : ∀ z ∈ q₀.support,
      z ∈ parityBfsLayerUnion G root j parity := by
    intro z hz
    simpa [q₀] using hsupp z₀
  obtain ⟨i, hij, hpar, hi₀⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion G q₀ hq₀supp
  refine ⟨i, hij, hpar, ?_⟩
  intro z
  obtain ⟨p, _hp⟩ := (hHconn z₀ z).exists_isPath
  let q : G.Walk (e z₀) (e z) := p.map e.toHom
  have hqsupp : ∀ w ∈ q.support,
      w ∈ parityBfsLayerUnion G root j parity := by
    intro w hw
    dsimp [q] at hw
    rw [Walk.support_map] at hw
    rcases List.mem_map.mp hw with ⟨u, _hu, rfl⟩
    exact hsupp u
  obtain ⟨i', _hi'j, _hi'par, hi'⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion G q hqsupp
  have hstart : i' = i := by
    calc
      i' = G.dist root (e z₀) := (hi' _ q.start_mem_support).symm
      _ = i := hi₀ _ q₀.start_mem_support
  calc
    G.dist root (e z) = i' := hi' _ q.end_mem_support
    _ = i := hstart
-/

/-- The ambient graph induced by the finite image of a component BFS ball is
isomorphic to the component graph induced by the ball itself.  The finite-map
equality gives the inverse on vertices; both adjacency relations reduce to
the same ambient adjacency after forgetting subtypes. -/
theorem exists_iso_induce_mapped_bfsBall
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {S D : Finset V}
    {c : (G.induce (S : Set V)).ConnectedComponent}
    {root : c} {j : ℕ}
    (hDeq : D = ((bfsBall c.toSimpleGraph root (j + 1)).toFinset).map
      ⟨fun x => x.1.1, by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)⟩) :
    ∃ e : G.induce (D : Set V) ≃g
        c.toSimpleGraph.induce
          (((bfsBall c.toSimpleGraph root (j + 1)).toFinset : Finset c) : Set c),
      ∀ y : D, (e y).1.1 = y.1 := by
  classical
  let B : Finset c := (bfsBall c.toSimpleGraph root (j + 1)).toFinset
  have hpre : ∀ y : D, ∃ x : B, x.1.1 = y.1 := by
    intro y
    have hy : (y : V) ∈ D := y.property
    have hymap : (y : V) ∈
        ((bfsBall c.toSimpleGraph root (j + 1)).toFinset).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      simpa [hDeq] using hy
    rcases Finset.mem_map.mp hymap with ⟨x, hx, hxval⟩
    exact ⟨⟨x, by simpa [B] using hx⟩, hxval⟩
  let lift : D → B := fun y => Classical.choose (hpre y)
  have hliftval : ∀ y : D, (lift y).1.1 = y.1 := by
    intro y
    exact Classical.choose_spec (hpre y)
  let down : B → D := fun x =>
    ⟨x.1.1, by
      rw [hDeq]
      exact Finset.mem_map.mpr ⟨x.1, by simpa [B] using x.2, rfl⟩⟩
  have hdownval : ∀ x : B, (down x).1 = x.1.1 := by
    intro x
    rfl
  have hleft : Function.LeftInverse down lift := by
    intro y
    apply Subtype.ext
    exact hliftval y
  have hright : Function.RightInverse down lift := by
    intro x
    apply Subtype.ext
    exact Subtype.ext (Subtype.ext ((hliftval (down x)).trans (hdownval x)))
  let equiv : D ≃ B :=
    { toFun := lift
      invFun := down
      left_inv := hleft
      right_inv := hright }
  let e : G.induce (D : Set V) ≃g c.toSimpleGraph.induce (B : Set c) :=
    { toEquiv := equiv
      map_rel_iff' := by
        intro x y
        change G.Adj (lift x).1.1 (lift y).1.1 ↔ G.Adj x.1 y.1
        simp [hliftval x, hliftval y] }
  refine ⟨e, ?_⟩
  intro y
  exact hliftval y

/-- A prefix of a path lying in one BFS layer is internally disjoint from
the reverse of a shortest root path to its endpoint.  The prefix contributes
only layer vertices, while the reversed shortest path contributes no layer
vertex after its first endpoint.  This is the inner-tree disjointness half
of the exact nested-BFS splice. -/
theorem path_prefix_tail_disjoint_reverse_shortest_path_tail_of_bfsLayer
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a b : V} {i t : ℕ} {p : G.Walk a b}
    (hp : p.IsPath) (ht : t ≤ p.length)
    (hplayer : ∀ z ∈ p.support, G.dist root z = i)
    {q : G.Walk root (p.getVert t)} (hq : q.IsPath)
    (hqavoid : ∀ z ∈ q.support,
      z = p.getVert t ∨ z ∉ Erdos752.bfsLayer G root i) :
    (p.take t).support.tail.Disjoint q.reverse.support.tail := by
  rw [List.disjoint_left]
  intro z hzp hzq
  have hzp' : z ∈ p.support := by
    have hzpTake : z ∈ (p.take t).support := List.mem_of_mem_tail hzp
    rw [Walk.support_take] at hzpTake
    exact List.mem_of_mem_take hzpTake
  have hzlayer : z ∈ Erdos752.bfsLayer G root i := hplayer z hzp'
  have hzq' : z ∈ q.support := by
    have hzqRev : z ∈ q.reverse.support := List.mem_of_mem_tail hzq
    simpa [Walk.support_reverse] using hzqRev
  have hend_not_tail : p.getVert t ∉ q.reverse.support.tail := by
    have hnodup := hq.reverse.support_nodup
    rw [q.reverse.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  rcases hqavoid z hzq' with hzend | hzoutside
  · exact hend_not_tail (hzend ▸ hzq)
  · exact hzoutside hzlayer

/-- Outer-tree disjointness for the nested splice.  A path wholly contained
in one layer cannot meet the tail of a return path whose only layer vertices
are its two endpoints, provided the far endpoint is not on the first path.
The near endpoint is automatically absent from the return tail because the
return path is simple. -/
theorem support_disjoint_tail_of_layer_path_and_avoiding_return
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {layerRoot start a : V} {i : ℕ} {x : V}
    {q : G.Walk x start} {r : G.Walk start a}
    (hr : r.IsPath)
    (hqlayer : ∀ z ∈ q.support, z ∈ Erdos752.bfsLayer G layerRoot i)
    (hravoid : ∀ z ∈ r.support,
      z = start ∨ z = a ∨ z ∉ Erdos752.bfsLayer G layerRoot i)
    (haq : a ∉ q.support) :
    q.support.Disjoint r.support.tail := by
  rw [List.disjoint_left]
  intro z hzq hzr
  have hzr' : z ∈ r.support := List.mem_of_mem_tail hzr
  have hroot_not_tail : start ∉ r.support.tail := by
    have hnodup := hr.support_nodup
    rw [r.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  rcases hravoid z hzr' with hzroot | hza | hzoutside
  · exact hroot_not_tail (hzroot ▸ hzr)
  · exact haq (hza ▸ hzq)
  · exact hzoutside (hqlayer z hzq)

/-- Reachable form of the root-side BFS detour.  Connectedness is stronger
than the argument needs: two shortest root paths suffice, so this version
also applies inside one component of an induced remaining graph. -/
theorem exists_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a b : V} {i : ℕ}
    (hroota : G.Reachable root a) (hrootb : G.Reachable root b)
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b) :
    ∃ q : G.Walk a b, q.IsPath ∧ q.length ≤ 2 * i ∧
      ∀ z ∈ q.support, z = a ∨ z = b ∨ z ∉ Erdos752.bfsLayer G root i := by
  classical
  obtain ⟨pa, _hpa, hpaLen⟩ := hroota.exists_path_of_dist
  obtain ⟨pb, _hpb, hpbLen⟩ := hrootb.exists_path_of_dist
  let r : G.Walk a b := pa.reverse.append pb
  let q : G.Walk a b := r.bypass
  refine ⟨q, by simpa [q] using r.bypass_isPath, ?_, ?_⟩
  · calc
      q.length ≤ r.length := r.length_bypass_le_length
      _ = pa.length + pb.length := by simp [r]
      _ = 2 * i := by rw [hpaLen, hpbLen, ha, hb]; omega
  · intro z hz
    have hzr : z ∈ r.support := r.support_bypass_subset_support hz
    dsimp [r] at hzr
    rw [Walk.support_append, Walk.support_reverse] at hzr
    simp only [List.mem_append, List.mem_reverse] at hzr
    rcases hzr with hza | hzb
    · by_cases hza' : z = a
      · exact Or.inl hza'
      · right
        right
        intro hzlayer
        have hzdist : G.dist root z = i := hzlayer
        have hlt :=
          dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
            G hpaLen hza hza'
        rw [hpaLen, ha] at hlt
        omega
    · by_cases hzb' : z = b
      · exact Or.inr (Or.inl hzb')
      · right
        right
        intro hzlayer
        have hzdist : G.dist root z = i := hzlayer
        have hzbSupport : z ∈ pb.support := List.mem_of_mem_tail hzb
        have hlt :=
          dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
            G hpbLen hzbSupport hzb'
        rw [hpbLen, hb] at hlt
        omega

/-- Parity-refined component-local root detour.  The same bypassed union of
two shortest root paths used above has even length because its edges are
properly two-colored by root-distance parity.  Thus a path selected inside
one BFS layer closes to a cycle of the same parity as that path. -/
theorem exists_even_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a b : V} {i : ℕ}
    (hroota : G.Reachable root a) (hrootb : G.Reachable root b)
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b) :
    ∃ q : G.Walk a b, q.IsPath ∧ Even q.length ∧ q.length ≤ 2 * i ∧
      ∀ z ∈ q.support, z = a ∨ z = b ∨ z ∉ Erdos752.bfsLayer G root i := by
  classical
  obtain ⟨pa, _hpa, hpaLen⟩ := hroota.exists_path_of_dist
  obtain ⟨pb, _hpb, hpbLen⟩ := hrootb.exists_path_of_dist
  let r : G.Walk a b := pa.reverse.append pb
  let q : G.Walk a b := r.bypass
  have hqeven : Even q.length := by
    simpa [q, r] using
      even_length_bypass_reverse_append_of_shortest_paths
        G hpaLen hpbLen ha hb
  refine ⟨q, by simpa [q] using r.bypass_isPath, hqeven, ?_, ?_⟩
  · calc
      q.length ≤ r.length := r.length_bypass_le_length
      _ = pa.length + pb.length := by simp [r]
      _ = 2 * i := by rw [hpaLen, hpbLen, ha, hb]; omega
  · intro z hz
    have hzr : z ∈ r.support := r.support_bypass_subset_support hz
    dsimp [r] at hzr
    rw [Walk.support_append, Walk.support_reverse] at hzr
    simp only [List.mem_append, List.mem_reverse] at hzr
    rcases hzr with hza | hzb
    · by_cases hza' : z = a
      · exact Or.inl hza'
      · right
        right
        intro hzlayer
        have hzdist : G.dist root z = i := hzlayer
        have hlt :=
          dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
            G hpaLen hza hza'
        rw [hpaLen, ha] at hlt
        omega
    · by_cases hzb' : z = b
      · exact Or.inr (Or.inl hzb')
      · right
        right
        intro hzlayer
        have hzdist : G.dist root z = i := hzlayer
        have hzbSupport : z ∈ pb.support := List.mem_of_mem_tail hzb
        have hlt :=
          dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
            G hpbLen hzbSupport hzb'
        rw [hpbLen, hb] at hlt
        omega

/-- Decomposition form of the same-parity BFS closure.  A simple path in
one layer is accompanied by an even short return path in the opposite
direction.  Their tails are disjoint, so the two walks already contain all
the combinatorial data of the resulting simple cycle.  Keeping the return
walk (rather than only the abstract copied cycle) is essential for the
selected-edge lift: the long layer path and the short root detour can then
be routed by different local hub mechanisms. -/
theorem exists_even_short_return_path_disjoint_of_path_in_bfsLayer_of_reachable
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root a b : V} {i : ℕ} {p : G.Walk a b}
    (hroota : G.Reachable root a) (hrootb : G.Reachable root b)
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b)
    (hp : p.IsPath)
    (hplayer : ∀ z ∈ p.support, z ∈ Erdos752.bfsLayer G root i) :
    ∃ q : G.Walk b a, q.IsPath ∧ Even q.length ∧ q.length ≤ 2 * i ∧
      p.support.tail.Disjoint q.support.tail ∧
      ∀ z ∈ q.support,
        z = b ∨ z = a ∨ z ∉ Erdos752.bfsLayer G root i := by
  classical
  obtain ⟨r, hr, hreven, hrbound, hravoid⟩ :=
    exists_even_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
      G hroota hrootb ha hb hab
  have ha_not_tail : a ∉ p.support.tail := by
    have hnodup := hp.support_nodup
    rw [p.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hb_not_tail : b ∉ r.reverse.support.tail := by
    have hnodup := hr.reverse.support_nodup
    rw [r.reverse.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hdisj : p.support.tail.Disjoint r.reverse.support.tail := by
    rw [List.disjoint_left]
    intro z hzp hzq
    have hzlayer : z ∈ Erdos752.bfsLayer G root i :=
      hplayer z (List.mem_of_mem_tail hzp)
    have hzrsupp : z ∈ r.support := by
      have hzr' : z ∈ r.reverse.support := List.mem_of_mem_tail hzq
      simpa [Walk.support_reverse] using hzr'
    rcases hravoid z hzrsupp with hza | hzb | hznot
    · subst z
      exact ha_not_tail hzp
    · subst z
      exact hb_not_tail hzq
    · exact hznot hzlayer
  refine ⟨r.reverse, hr.reverse, ?_, ?_, hdisj, ?_⟩
  · simpa using hreven
  · simpa using hrbound
  · intro z hz
    have hz' : z ∈ r.support := by
      simpa [Walk.support_reverse] using hz
    rcases hravoid z hz' with hza | hzb | hznot
    · exact Or.inr (Or.inl hza)
    · exact Or.inl hzb
    · exact Or.inr (Or.inr hznot)

/-- Two vertices in one BFS layer are joined by a short path whose internal
vertices avoid that layer.  Take shortest root paths to the two endpoints,
append one in reverse to the other, and bypass repetitions.  The preceding
metric lemma proves that only the displayed endpoints can remain in the
original layer. -/
theorem exists_short_path_between_bfsLayer_vertices_avoiding_layer
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    (hconn : G.Connected) {root a b : V} {i : ℕ}
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b) :
    ∃ q : G.Walk a b, q.IsPath ∧ q.length ≤ 2 * i ∧
      ∀ z ∈ q.support, z = a ∨ z = b ∨ z ∉ Erdos752.bfsLayer G root i := by
  classical
  obtain ⟨pa, _hpa, hpaLen⟩ := hconn.exists_path_of_dist root a
  obtain ⟨pb, _hpb, hpbLen⟩ := hconn.exists_path_of_dist root b
  let r : G.Walk a b := pa.reverse.append pb
  let q : G.Walk a b := r.bypass
  refine ⟨q, by simpa [q] using r.bypass_isPath, ?_, ?_⟩
  · calc
      q.length ≤ r.length := r.length_bypass_le_length
      _ = pa.length + pb.length := by simp [r]
      _ = 2 * i := by rw [hpaLen, hpbLen, ha, hb]; omega
  · intro z hz
    have hzr : z ∈ r.support := r.support_bypass_subset_support hz
    dsimp [r] at hzr
    rw [Walk.support_append, Walk.support_reverse] at hzr
    simp only [List.mem_append, List.mem_reverse] at hzr
    rcases hzr with hza | hzb
    · by_cases hza' : z = a
      · exact Or.inl hza'
      · right
        right
        intro hzlayer
        have hzdist : G.dist root z = i := hzlayer
        have hlt :=
          dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
            G hpaLen hza hza'
        rw [hpaLen, ha] at hlt
        omega
    · by_cases hzb' : z = b
      · exact Or.inr (Or.inl hzb')
      · right
        right
        intro hzlayer
        have hzdist : G.dist root z = i := hzlayer
        have hzbSupport : z ∈ pb.support := List.mem_of_mem_tail hzb
        have hlt :=
          dist_lt_length_of_mem_support_of_ne_endpoint_of_shortest_path
            G hpbLen hzbSupport hzb'
        rw [hpbLen, hb] at hlt
        omega

/-- Component-local cycle closure from one BFS layer. -/
theorem exists_cycle_in_interval_of_path_in_bfsLayer_of_reachable
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj]
    {root a b : V} {i : ℕ} {p : G.Walk a b}
    (hroota : G.Reachable root a) (hrootb : G.Reachable root b)
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b)
    (hp : p.IsPath) (hplayer : ∀ z ∈ p.support, z ∈ Erdos752.bfsLayer G root i)
    (hplen : 2 ≤ p.length) :
    ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * i := by
  classical
  obtain ⟨q, hq, hqbound, hqavoid⟩ :=
    exists_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
      G hroota hrootb ha hb hab
  have ha_not_tail : a ∉ p.support.tail := by
    have hnodup := hp.support_nodup
    rw [p.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hb_not_tail : b ∉ q.reverse.support.tail := by
    have hnodup := hq.reverse.support_nodup
    rw [q.reverse.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hdisj : p.support.tail.Disjoint q.reverse.support.tail := by
    rw [List.disjoint_left]
    intro z hzp hzq
    have hzlayer : z ∈ Erdos752.bfsLayer G root i :=
      hplayer z (List.mem_of_mem_tail hzp)
    have hzqsupp : z ∈ q.support := by
      have hzq' : z ∈ q.reverse.support := List.mem_of_mem_tail hzq
      simpa [Walk.support_reverse] using hzq'
    rcases hqavoid z hzqsupp with hza | hzb | hznot
    · subst z
      exact ha_not_tail hzp
    · subst z
      exact hb_not_tail hzq
    · exact hznot hzlayer
  have hqpos : 0 < q.length := by
    apply Nat.pos_of_ne_zero
    intro hzero
    exact hab ((Walk.length_eq_zero_iff.mp hzero).eq)
  let ℓ : ℕ := p.length + q.length
  refine ⟨ℓ, ?_, ?_, ?_⟩
  · apply cycleGraph_isContained_of_two_disjoint_paths G (k := ℓ)
    · dsimp [ℓ]
      omega
    · exact hp
    · exact hq.reverse
    · exact hdisj
    · exact Or.inl (by omega)
    · simp [ℓ]
  · dsimp [ℓ]
    omega
  · dsimp [ℓ]
    omega

/-- Same-parity refinement of the component-local BFS closure.  The
root-side detour is even, so the resulting cycle has exactly the parity of
the path chosen in the terminal layer, in addition to the usual interval
bounds. -/
theorem exists_same_parity_cycle_in_interval_of_path_in_bfsLayer_of_reachable
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj]
    {root a b : V} {i : ℕ} {p : G.Walk a b}
    (hroota : G.Reachable root a) (hrootb : G.Reachable root b)
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b)
    (hp : p.IsPath) (hplayer : ∀ z ∈ p.support, z ∈ Erdos752.bfsLayer G root i)
    (hplen : 2 ≤ p.length) :
    ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * i ∧
      ℓ % 2 = p.length % 2 := by
  classical
  obtain ⟨q, hq, hqeven, hqbound, hqavoid⟩ :=
    exists_even_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
      G hroota hrootb ha hb hab
  have ha_not_tail : a ∉ p.support.tail := by
    have hnodup := hp.support_nodup
    rw [p.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hb_not_tail : b ∉ q.reverse.support.tail := by
    have hnodup := hq.reverse.support_nodup
    rw [q.reverse.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hdisj : p.support.tail.Disjoint q.reverse.support.tail := by
    rw [List.disjoint_left]
    intro z hzp hzq
    have hzlayer : z ∈ Erdos752.bfsLayer G root i :=
      hplayer z (List.mem_of_mem_tail hzp)
    have hzqsupp : z ∈ q.support := by
      have hzq' : z ∈ q.reverse.support := List.mem_of_mem_tail hzq
      simpa [Walk.support_reverse] using hzq'
    rcases hqavoid z hzqsupp with hza | hzb | hznot
    · subst z
      exact ha_not_tail hzp
    · subst z
      exact hb_not_tail hzq
    · exact hznot hzlayer
  have hqpos : 0 < q.length := by
    apply Nat.pos_of_ne_zero
    intro hzero
    exact hab ((Walk.length_eq_zero_iff.mp hzero).eq)
  let ℓ : ℕ := p.length + q.length
  refine ⟨ℓ, ?_, ?_, ?_, ?_⟩
  · apply cycleGraph_isContained_of_two_disjoint_paths G (k := ℓ)
    · dsimp [ℓ]
      omega
    · exact hp
    · exact hq.reverse
    · exact hdisj
    · exact Or.inl (by omega)
    · simp [ℓ]
  · dsimp [ℓ]
    omega
  · dsimp [ℓ]
    exact Nat.add_le_add_left hqbound p.length
  · rcases hqeven with ⟨t, ht⟩
    dsimp [ℓ]
    rw [ht]
    omega

/-- A long path lying in one BFS layer closes through the root-side detour
to a cycle whose length is larger by at most twice the layer depth.  This is
the checked interval-cycle form consumed by the two-level KLS detour: the
main path stays in the layer, while the detour has no internal layer vertex,
so the two supports meet only at their endpoints. -/
theorem exists_cycle_in_interval_of_path_in_bfsLayer
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected)
    {root a b : V} {i : ℕ} {p : G.Walk a b}
    (ha : G.dist root a = i) (hb : G.dist root b = i) (hab : a ≠ b)
    (hp : p.IsPath) (hplayer : ∀ z ∈ p.support, z ∈ Erdos752.bfsLayer G root i)
    (hplen : 2 ≤ p.length) :
    ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * i := by
  classical
  obtain ⟨q, hq, hqbound, hqavoid⟩ :=
    exists_short_path_between_bfsLayer_vertices_avoiding_layer
      G hconn ha hb hab
  have ha_not_tail : a ∉ p.support.tail := by
    have hnodup := hp.support_nodup
    rw [p.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hb_not_tail : b ∉ q.reverse.support.tail := by
    have hnodup := hq.reverse.support_nodup
    rw [q.reverse.support_eq_cons] at hnodup
    exact (List.nodup_cons.mp hnodup).1
  have hdisj : p.support.tail.Disjoint q.reverse.support.tail := by
    rw [List.disjoint_left]
    intro z hzp hzq
    have hzlayer : z ∈ Erdos752.bfsLayer G root i :=
      hplayer z (List.mem_of_mem_tail hzp)
    have hzqsupp : z ∈ q.support := by
      have hzq' : z ∈ q.reverse.support := List.mem_of_mem_tail hzq
      simpa [Walk.support_reverse] using hzq'
    rcases hqavoid z hzqsupp with hza | hzb | hznot
    · subst z
      exact ha_not_tail hzp
    · subst z
      exact hb_not_tail hzq
    · exact hznot hzlayer
  have hqpos : 0 < q.length := by
    apply Nat.pos_of_ne_zero
    intro hzero
    exact hab ((Walk.length_eq_zero_iff.mp hzero).eq)
  let ℓ : ℕ := p.length + q.length
  refine ⟨ℓ, ?_, ?_, ?_⟩
  · apply cycleGraph_isContained_of_two_disjoint_paths G (k := ℓ)
    · dsimp [ℓ]
      omega
    · exact hp
    · exact hq.reverse
    · exact hdisj
    · exact Or.inl (by omega)
    · simp [ℓ]
  · dsimp [ℓ]
    omega
  · dsimp [ℓ]
    omega

/-- Specializing the anticomplete-block localization to a parity BFS union
shows that any walk supported by that union actually lives in one concrete
distance layer.  The returned index and parity certificate are the data
needed to apply the root-detour cycle lemma. -/
theorem exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root : V} {j parity : ℕ} {a b : V} (p : G.Walk a b)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion G root j parity) :
    ∃ i : ℕ, i ≤ j ∧ i % 2 = parity ∧
      ∀ z ∈ p.support, G.dist root z = i := by
  classical
  have hanti :=
    pairwiseAnticomplete_parityBfsLayerFamily G root j parity
  have hsupp' : ∀ z ∈ p.support,
      z ∈ (parityBfsLayerFamily G root j parity).biUnion id := by
    simpa [parityBfsLayerUnion] using hsupp
  obtain ⟨A, hA, hpA⟩ :=
    exists_member_containing_walk_support_of_pairwiseAnticomplete
      G hanti p hsupp'
  unfold parityBfsLayerFamily at hA
  rcases Finset.mem_image.mp hA with ⟨i, hi, rfl⟩
  rw [Finset.mem_filter] at hi
  have hij : i ≤ j := by
    rw [Finset.mem_range] at hi
    omega
  refine ⟨i, hij, hi.2, ?_⟩
  intro z hz
  have hzLayer : z ∈ (Erdos752.bfsLayer G root i).toFinset := hpA z hz
  exact (Erdos752.mem_bfsLayer).1 (Set.mem_toFinset.mp hzLayer)

/-- A connected graph whose embedding lands in one BFS parity union lands
in one concrete layer.  Connect a chosen vertex to every other vertex,
map the path, and use walk localization twice to identify the common
distance layer. -/
theorem exists_bfsLayer_containing_connected_embedding_of_parityBfsLayerUnion
    {V W : Type*} [Fintype V] [Fintype W]
    (G : SimpleGraph V) (H : SimpleGraph W) (hHconn : H.Connected)
    (e : H ↪g G) {root : V} {j parity : ℕ}
    (hsupp : ∀ z : W, e z ∈ parityBfsLayerUnion G root j parity) :
    ∃ i : ℕ, i ≤ j ∧ i % 2 = parity ∧
      ∀ z : W, G.dist root (e z) = i := by
  classical
  let : Nonempty W := hHconn.nonempty
  let z₀ : W := Classical.choice inferInstance
  let q₀ : G.Walk (e z₀) (e z₀) := Walk.nil
  have hq₀supp : ∀ z ∈ q₀.support,
      z ∈ parityBfsLayerUnion G root j parity := by
    intro z hz
    have hz0 : z = e z₀ := by simpa [q₀] using hz
    simpa [hz0] using hsupp z₀
  obtain ⟨i, hij, hpar, hi₀⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion G q₀ hq₀supp
  refine ⟨i, hij, hpar, ?_⟩
  intro z
  obtain ⟨p, _hp⟩ := (hHconn z₀ z).exists_isPath
  let q : G.Walk (e z₀) (e z) := p.map e.toHom
  have hqsupp : ∀ w ∈ q.support,
      w ∈ parityBfsLayerUnion G root j parity := by
    intro w hw
    dsimp [q] at hw
    rw [Walk.support_map] at hw
    rcases List.mem_map.mp hw with ⟨u, _hu, rfl⟩
    exact hsupp u
  obtain ⟨i', _hi'j, _hi'par, hi'⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion G q hqsupp
  have hstart : i' = i := by
    calc
      i' = G.dist root (e z₀) := (hi' _ q.start_mem_support).symm
      _ = i := hi₀ _ q₀.start_mem_support
  calc
    G.dist root (e z) = i' := hi' _ q.end_mem_support
    _ = i := hstart

/-- A connected component of the graph induced by one parity BFS union is
contained in one concrete distance layer.  Any two vertices in the
component are joined by a walk inside the parity union; the preceding walk
localization puts that whole walk in one layer, so its endpoints have the
same root distance.  This is the nesting fact needed by the exact two-level
BFS splice. -/
theorem exists_bfsLayer_containing_induced_parity_component
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    {root : V} {j : ℕ} {parity : Fin 2}
    (c :
      (G.induce ((parityBfsLayerUnion G root j parity : Finset V) : Set V)).ConnectedComponent) :
    ∃ i : ℕ, i ≤ j ∧ i % 2 = parity ∧
      ∀ z : c, G.dist root z.1.1 = i := by
  classical
  let X : Finset V := parityBfsLayerUnion G root j parity
  let H : SimpleGraph X := G.induce (X : Set V)
  let e : H ↪g G := SimpleGraph.Embedding.induce (G := G) (X : Set V)
  have hsame : ∀ x y : c, G.dist root x.1.1 = G.dist root y.1.1 := by
    intro x y
    have hreach :
        (G.induce ((parityBfsLayerUnion G root j parity : Finset V) : Set V)).Reachable x.1 y.1 :=
      c.reachable_of_mem_supp x.property y.property
    apply hreach.elim
    intro p
    let q : G.Walk (e x.1) (e y.1) := p.map e.toHom
    have hsupp : ∀ z ∈ q.support, z ∈ parityBfsLayerUnion G root j parity := by
      intro z hz
      dsimp [q] at hz
      rw [Walk.support_map] at hz
      rcases List.mem_map.mp hz with ⟨w, _hw, rfl⟩
      change (w : V) ∈ X
      exact w.property
    obtain ⟨i, _hij, _hpar, hi⟩ :=
      exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion G q hsupp
    calc
      G.dist root x.1.1 = i := hi _ q.start_mem_support
      _ = G.dist root y.1.1 := (hi _ q.end_mem_support).symm
  let : Nonempty c := c.nonempty_supp.to_subtype
  let z₀ : c := Classical.choice inferInstance
  let p₀ :
      (G.induce ((parityBfsLayerUnion G root j parity : Finset V) : Set V)).Walk z₀.1 z₀.1 :=
    Walk.nil
  let q₀ : G.Walk (e z₀.1) (e z₀.1) := p₀.map e.toHom
  have hq₀supp : ∀ z ∈ q₀.support,
      z ∈ parityBfsLayerUnion G root j parity := by
    intro z hz
    dsimp [q₀] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨w, _hw, rfl⟩
    change (w : V) ∈ X
    exact w.property
  obtain ⟨i, hij, hpar, hi⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion G q₀ hq₀supp
  refine ⟨i, hij, hpar, ?_⟩
  intro z
  calc
    G.dist root z.1.1 = G.dist root z₀.1.1 := hsame z z₀
    _ = i := hi _ q₀.start_mem_support

/-- Exact two-level BFS closure.  The outer parity component lies in one
outer distance layer, while the displayed long path lies in one inner
distance layer.  A shortest inner-root path to a chosen prefix endpoint and
an outer root detour back to the prefix start have total length at most
j₁ + 2*j₀.  If one extra edge of room remains, trim the long path to the
unique complementary length and splice the three internally disjoint paths
to obtain exactly Cₖ.

This is the exact-length form of the KLS two-BFS argument; unlike the
single-level interval lemma below, it does not lose the target cycle length
inside a short interval. -/
theorem cycleGraph_isContained_of_long_path_in_nested_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected)
    {root₀ : V} {j₀ : ℕ} {parity₀ : Fin 2}
    (c :
      (G.induce ((parityBfsLayerUnion G root₀ j₀ parity₀ : Finset V) : Set V)).ConnectedComponent)
    {root₁ : c} {j₁ : ℕ} {parity₁ : Fin 2}
    {a b : c} {p : c.toSimpleGraph.Walk a b} {k : ℕ}
    (hk : 3 ≤ k) (hp : p.IsPath)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion c.toSimpleGraph root₁ j₁ parity₁)
    (hroom : 2 * j₀ + j₁ + 1 ≤ k) (hkpath : k ≤ p.length) :
    cycleGraph k ⊑ G := by
  classical
  let K : SimpleGraph c := c.toSimpleGraph
  let e : K ↪g G :=
    { toFun := fun z => z.1.1
      inj' := by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)
      map_rel_iff' := by
        intro x y
        rfl }
  obtain ⟨i₀, hi₀j, _hi₀par, hcLayer⟩ :=
    exists_bfsLayer_containing_induced_parity_component G c
  obtain ⟨i₁, hi₁j, _hi₁par, hpLayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      K p hsupp
  have hrootOuter : G.dist root₀ root₁.1.1 = i₀ := hcLayer root₁
  have haOuter : G.dist root₀ a.1.1 = i₀ := hcLayer a
  have houter :
      ∃ r : G.Walk root₁.1.1 a.1.1, r.IsPath ∧ r.length ≤ 2 * i₀ ∧
        ∀ z ∈ r.support,
          z = root₁.1.1 ∨ z = a.1.1 ∨
            z ∉ Erdos752.bfsLayer G root₀ i₀ := by
    by_cases hra : root₁.1.1 = a.1.1
    · have hsub : root₁ = a := by
        apply Subtype.ext
        apply Subtype.ext
        exact hra
      subst a
      refine ⟨Walk.nil, ?_, ?_, ?_⟩
      · simp
      · simp
      · intro z hz
        left
        simpa using hz
    · exact exists_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
        G (hconn root₀ root₁.1.1) (hconn root₀ a.1.1)
          hrootOuter haOuter hra
  obtain ⟨r, hr, hrlen, hravoid⟩ := houter
  let t : ℕ := k - i₁ - r.length
  have hsumle : i₁ + r.length + 1 ≤ k := by
    have hrj : r.length ≤ 2 * j₀ := hrlen.trans (Nat.mul_le_mul_left 2 hi₀j)
    omega
  have htpos : 0 < t := by
    dsimp [t]
    omega
  have htle : t ≤ p.length := by
    have htk : t ≤ k := by
      dsimp [t]
      omega
    exact htk.trans hkpath
  let x : c := p.getVert t
  have hxInner : K.dist root₁ x = i₁ := by
    exact hpLayer x (p.getVert_mem_support t)
  have hKconn : K.Connected := by
    simpa [K] using c.connected_toSimpleGraph
  obtain ⟨s, hs, hslen, hsavoid⟩ :=
    exists_shortest_path_to_bfsLayer_avoiding_layer
      K (hKconn root₁ x) hxInner
  have hinnerDisj :
      (p.take t).support.tail.Disjoint s.reverse.support.tail :=
    path_prefix_tail_disjoint_reverse_shortest_path_tail_of_bfsLayer
      K hp htle hpLayer hs hsavoid
  let P : G.Walk a.1.1 x.1.1 := (p.take t).map e.toHom
  let Q : G.Walk x.1.1 root₁.1.1 := s.reverse.map e.toHom
  have hP : P.IsPath := by
    exact (hp.take t).map e.injective
  have hQ : Q.IsPath := by
    exact hs.reverse.map e.injective
  have hPQ : P.support.tail.Disjoint Q.support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzQ
    dsimp [P] at hzP
    dsimp [Q] at hzQ
    rw [Walk.support_map] at hzP hzQ
    rw [← List.map_tail] at hzP hzQ
    rcases List.mem_map.mp hzP with ⟨u, hu, rfl⟩
    rcases List.mem_map.mp hzQ with ⟨v, hv, huv⟩
    have huv' : u = v := e.injective huv.symm
    subst v
    exact List.disjoint_left.mp hinnerDisj hu hv
  have hQouter : ∀ z ∈ Q.support,
      z ∈ Erdos752.bfsLayer G root₀ i₀ := by
    intro z hz
    dsimp [Q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨u, _hu, rfl⟩
    exact hcLayer u
  have ha_not_Q : a.1.1 ∉ Q.support := by
    intro haQ
    dsimp [Q] at haQ
    rw [Walk.support_map] at haQ
    rcases List.mem_map.mp haQ with ⟨u, hu, hua⟩
    have hua' : u = a := e.injective hua
    subst u
    have haS : a ∈ s.support := by
      simpa [Walk.support_reverse] using hu
    have haInner : a ∈ Erdos752.bfsLayer K root₁ i₁ :=
      hpLayer a p.start_mem_support
    rcases hsavoid a haS with hax | haout
    · have hzero : t = 0 := by
        apply (hp.getVert_eq_start_iff htle).mp
        simpa [x] using hax.symm
      omega
    · exact haout haInner
  have hQr : Q.support.Disjoint r.support.tail :=
    support_disjoint_tail_of_layer_path_and_avoiding_return
      G hr hQouter hravoid ha_not_Q
  have hPreturn : P.support.tail.Disjoint (Q.append r).support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzReturn
    have hsupport :
        (Q.append r).support.tail = Q.support.tail ++ r.support.tail := by
      rw [Walk.support_append, ← Q.cons_tail_support]
      simp
    rw [hsupport] at hzReturn
    rcases List.mem_append.mp hzReturn with hzQ | hzR
    · exact List.disjoint_left.mp hPQ hzP hzQ
    · have hPouter : ∀ w ∈ P.support.tail,
          w ∈ Erdos752.bfsLayer G root₀ i₀ := by
        intro w hw
        dsimp [P] at hw
        rw [Walk.support_map] at hw
        rw [← List.map_tail] at hw
        rcases List.mem_map.mp hw with ⟨u, _hu, rfl⟩
        exact hcLayer u
      have ha_not_Ptail : a.1.1 ∉ P.support.tail := by
        have hnodup := hP.support_nodup
        rw [P.support_eq_cons] at hnodup
        exact (List.nodup_cons.mp hnodup).1
      have hroot_not_rtail : root₁.1.1 ∉ r.support.tail := by
        have hnodup := hr.support_nodup
        rw [r.support_eq_cons] at hnodup
        exact (List.nodup_cons.mp hnodup).1
      have hzRsupp : z ∈ r.support := List.mem_of_mem_tail hzR
      rcases hravoid z hzRsupp with hzroot | hza | hzoutside
      · exact hroot_not_rtail (hzroot ▸ hzR)
      · exact ha_not_Ptail (hza ▸ hzP)
      · exact hzoutside (hPouter z hzP)
  have hPlen : P.length = t := by
    simp [P, Walk.take_length, Nat.min_eq_left htle]
  have hQlen : Q.length = i₁ := by
    simp [Q, hslen]
  apply cycleGraph_isContained_of_three_path_splice G hk hP hQ hr hQr hPreturn
  rw [hPlen, hQlen]
  dsimp [t]
  omega

/-- Embedded-subgraph form of the exact nested-BFS closure.  The inner
connected graph need not be a whole connected component of the outer parity
union: separator deletion can leave only a connected subgraph of one outer
layer.  It is enough to retain an embedding into the outer connected graph
and a proof that every embedded inner vertex has one common outer distance.
The inner parity localization and exact three-path splice are unchanged. -/
theorem cycleGraph_isContained_of_long_path_in_nested_layer_subgraph
    {W C : Type*} [Fintype W] [Fintype C]
    (J : SimpleGraph W) [DecidableRel J.Adj] (hJconn : J.Connected)
    (K : SimpleGraph C) [DecidableRel K.Adj] (hKconn : K.Connected)
    (f : K ↪g J)
    {root₀ : W} {i₀ j₀ : ℕ} (hi₀j : i₀ ≤ j₀)
    (houter : ∀ z : C, J.dist root₀ (f z) = i₀)
    {root₁ : C} {j₁ : ℕ} {parity₁ : Fin 2}
    {a b : C} {p : K.Walk a b} {k : ℕ}
    (hk : 3 ≤ k) (hp : p.IsPath)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion K root₁ j₁ parity₁)
    (hroom : 2 * j₀ + j₁ + 1 ≤ k) (hkpath : k ≤ p.length) :
    cycleGraph k ⊑ J := by
  classical
  obtain ⟨i₁, hi₁j, _hi₁par, hpLayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      K p hsupp
  have hrootOuter : J.dist root₀ (f root₁) = i₀ := houter root₁
  have haOuter : J.dist root₀ (f a) = i₀ := houter a
  have houterPath :
      ∃ r : J.Walk (f root₁) (f a), r.IsPath ∧ r.length ≤ 2 * i₀ ∧
        ∀ z ∈ r.support,
          z = f root₁ ∨ z = f a ∨
            z ∉ Erdos752.bfsLayer J root₀ i₀ := by
    by_cases hra : f root₁ = f a
    · have hsub : root₁ = a := f.injective hra
      subst a
      refine ⟨Walk.nil, ?_, ?_, ?_⟩
      · simp
      · simp
      · intro z hz
        left
        simpa using hz
    · exact exists_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
        J (hJconn root₀ (f root₁)) (hJconn root₀ (f a))
          hrootOuter haOuter hra
  obtain ⟨r, hr, hrlen, hravoid⟩ := houterPath
  let t : ℕ := k - i₁ - r.length
  have hsumle : i₁ + r.length + 1 ≤ k := by
    have hrj : r.length ≤ 2 * j₀ := hrlen.trans (Nat.mul_le_mul_left 2 hi₀j)
    omega
  have htpos : 0 < t := by
    dsimp [t]
    omega
  have htle : t ≤ p.length := by
    have htk : t ≤ k := by
      dsimp [t]
      omega
    exact htk.trans hkpath
  let x : C := p.getVert t
  have hxInner : K.dist root₁ x = i₁ := hpLayer x (p.getVert_mem_support t)
  obtain ⟨s, hs, hslen, hsavoid⟩ :=
    exists_shortest_path_to_bfsLayer_avoiding_layer
      K (hKconn root₁ x) hxInner
  have hinnerDisj :
      (p.take t).support.tail.Disjoint s.reverse.support.tail :=
    path_prefix_tail_disjoint_reverse_shortest_path_tail_of_bfsLayer
      K hp htle hpLayer hs hsavoid
  let P : J.Walk (f a) (f x) := (p.take t).map f.toHom
  let Q : J.Walk (f x) (f root₁) := s.reverse.map f.toHom
  have hP : P.IsPath := (hp.take t).map f.injective
  have hQ : Q.IsPath := hs.reverse.map f.injective
  have hPQ : P.support.tail.Disjoint Q.support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzQ
    dsimp [P] at hzP
    dsimp [Q] at hzQ
    rw [Walk.support_map] at hzP hzQ
    rw [← List.map_tail] at hzP hzQ
    rcases List.mem_map.mp hzP with ⟨u, hu, rfl⟩
    rcases List.mem_map.mp hzQ with ⟨v, hv, huv⟩
    have huv' : u = v := f.injective huv.symm
    subst v
    exact List.disjoint_left.mp hinnerDisj hu hv
  have hQouter : ∀ z ∈ Q.support,
      z ∈ Erdos752.bfsLayer J root₀ i₀ := by
    intro z hz
    dsimp [Q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨u, _hu, rfl⟩
    exact houter u
  have ha_not_Q : f a ∉ Q.support := by
    intro haQ
    dsimp [Q] at haQ
    rw [Walk.support_map] at haQ
    rcases List.mem_map.mp haQ with ⟨u, hu, hua⟩
    have hua' : u = a := f.injective hua
    subst u
    have haS : a ∈ s.support := by
      simpa [Walk.support_reverse] using hu
    have haInner : a ∈ Erdos752.bfsLayer K root₁ i₁ :=
      hpLayer a p.start_mem_support
    rcases hsavoid a haS with hax | haout
    · have hzero : t = 0 := by
        apply (hp.getVert_eq_start_iff htle).mp
        simpa [x] using hax.symm
      omega
    · exact haout haInner
  have hQr : Q.support.Disjoint r.support.tail :=
    support_disjoint_tail_of_layer_path_and_avoiding_return
      J hr hQouter hravoid ha_not_Q
  have hPreturn : P.support.tail.Disjoint (Q.append r).support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzReturn
    have hsupport :
        (Q.append r).support.tail = Q.support.tail ++ r.support.tail := by
      rw [Walk.support_append, ← Q.cons_tail_support]
      simp
    rw [hsupport] at hzReturn
    rcases List.mem_append.mp hzReturn with hzQ | hzR
    · exact List.disjoint_left.mp hPQ hzP hzQ
    · have hPouter : ∀ w ∈ P.support.tail,
          w ∈ Erdos752.bfsLayer J root₀ i₀ := by
        intro w hw
        dsimp [P] at hw
        rw [Walk.support_map] at hw
        rw [← List.map_tail] at hw
        rcases List.mem_map.mp hw with ⟨u, _hu, rfl⟩
        exact houter u
      have ha_not_Ptail : f a ∉ P.support.tail := by
        have hnodup := hP.support_nodup
        rw [P.support_eq_cons] at hnodup
        exact (List.nodup_cons.mp hnodup).1
      have hroot_not_rtail : f root₁ ∉ r.support.tail := by
        have hnodup := hr.support_nodup
        rw [r.support_eq_cons] at hnodup
        exact (List.nodup_cons.mp hnodup).1
      have hzRsupp : z ∈ r.support := List.mem_of_mem_tail hzR
      rcases hravoid z hzRsupp with hzroot | hza | hzoutside
      · exact hroot_not_rtail (hzroot ▸ hzR)
      · exact ha_not_Ptail (hza ▸ hzP)
      · exact hzoutside (hPouter z hzP)
  have hPlen : P.length = t := by
    simp [P, Walk.take_length, Nat.min_eq_left htle]
  have hQlen : Q.length = i₁ := by
    simp [Q, hslen]
  apply cycleGraph_isContained_of_three_path_splice J hk hP hQ hr hQr hPreturn
  rw [hPlen, hQlen]
  dsimp [t]
  omega

/-- Separator-compatible exact nested-BFS closure.  The second separator
pass only certifies that its retained path and its next BFS ball lie in the
first-pass core; vertices farther out in the second connected component may
have been discarded.  Those two support hypotheses are exactly what the
three-path proof uses, so they still suffice for an exact target cycle. -/
theorem cycleGraph_isContained_of_long_path_with_bfsBall_in_outer_layer
    {W C : Type*} [Fintype W] [Fintype C]
    (J : SimpleGraph W) [DecidableRel J.Adj] (hJconn : J.Connected)
    (K : SimpleGraph C) [DecidableRel K.Adj] (hKconn : K.Connected)
    (f : K ↪g J)
    {root₀ : W} {i₀ j₀ : ℕ} (hi₀j : i₀ ≤ j₀)
    {root₁ : C} {j₁ : ℕ} {parity₁ : Fin 2}
    {a b : C} {p : K.Walk a b} {k : ℕ}
    (hk : 3 ≤ k) (hp : p.IsPath)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion K root₁ j₁ parity₁)
    (hpathOuter : ∀ z ∈ p.support, J.dist root₀ (f z) = i₀)
    (hballOuter : ∀ z : C,
      z ∈ (bfsBall K root₁ (j₁ + 1)).toFinset →
        J.dist root₀ (f z) = i₀)
    (hroom : 2 * j₀ + j₁ + 1 ≤ k) (hkpath : k ≤ p.length) :
    cycleGraph k ⊑ J := by
  classical
  obtain ⟨i₁, hi₁j, _hi₁par, hpLayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      K p hsupp
  have hrootBall : root₁ ∈ (bfsBall K root₁ (j₁ + 1)).toFinset := by
    apply (Set.mem_toFinset (s := bfsBall K root₁ (j₁ + 1))).mpr
    simp [bfsBall]
  have hrootOuter : J.dist root₀ (f root₁) = i₀ :=
    hballOuter root₁ hrootBall
  have haOuter : J.dist root₀ (f a) = i₀ :=
    hpathOuter a p.start_mem_support
  have houterPath :
      ∃ r : J.Walk (f root₁) (f a), r.IsPath ∧ r.length ≤ 2 * i₀ ∧
        ∀ z ∈ r.support,
          z = f root₁ ∨ z = f a ∨
            z ∉ Erdos752.bfsLayer J root₀ i₀ := by
    by_cases hra : f root₁ = f a
    · have hsub : root₁ = a := f.injective hra
      subst a
      refine ⟨Walk.nil, ?_, ?_, ?_⟩
      · simp
      · simp
      · intro z hz
        left
        simpa using hz
    · exact exists_short_path_between_bfsLayer_vertices_avoiding_layer_of_reachable
        J (hJconn root₀ (f root₁)) (hJconn root₀ (f a))
          hrootOuter haOuter hra
  obtain ⟨r, hr, hrlen, hravoid⟩ := houterPath
  let t : ℕ := k - i₁ - r.length
  have hsumle : i₁ + r.length + 1 ≤ k := by
    have hrj : r.length ≤ 2 * j₀ := hrlen.trans (Nat.mul_le_mul_left 2 hi₀j)
    omega
  have htpos : 0 < t := by
    dsimp [t]
    omega
  have htle : t ≤ p.length := by
    have htk : t ≤ k := by
      dsimp [t]
      omega
    exact htk.trans hkpath
  let x : C := p.getVert t
  have hxInner : K.dist root₁ x = i₁ := hpLayer x (p.getVert_mem_support t)
  obtain ⟨s, hs, hslen, hsavoid⟩ :=
    exists_shortest_path_to_bfsLayer_avoiding_layer
      K (hKconn root₁ x) hxInner
  have hinnerDisj :
      (p.take t).support.tail.Disjoint s.reverse.support.tail :=
    path_prefix_tail_disjoint_reverse_shortest_path_tail_of_bfsLayer
      K hp htle hpLayer hs hsavoid
  let P : J.Walk (f a) (f x) := (p.take t).map f.toHom
  let Q : J.Walk (f x) (f root₁) := s.reverse.map f.toHom
  have hP : P.IsPath := (hp.take t).map f.injective
  have hQ : Q.IsPath := hs.reverse.map f.injective
  have hPQ : P.support.tail.Disjoint Q.support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzQ
    dsimp [P] at hzP
    dsimp [Q] at hzQ
    rw [Walk.support_map] at hzP hzQ
    rw [← List.map_tail] at hzP hzQ
    rcases List.mem_map.mp hzP with ⟨u, hu, rfl⟩
    rcases List.mem_map.mp hzQ with ⟨v, hv, huv⟩
    have huv' : u = v := f.injective huv.symm
    subst v
    exact List.disjoint_left.mp hinnerDisj hu hv
  have hQouter : ∀ z ∈ Q.support,
      z ∈ Erdos752.bfsLayer J root₀ i₀ := by
    intro z hz
    dsimp [Q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨u, hu, rfl⟩
    have huS : u ∈ s.support := by
      simpa [Walk.support_reverse] using hu
    have hsShort : s.length = K.dist root₁ x := hslen.trans hxInner.symm
    have huBall : u ∈ (bfsBall K root₁ (j₁ + 1)).toFinset :=
      shortest_path_support_subset_bfsBall_toFinset K hsShort (by omega) u huS
    exact hballOuter u huBall
  have ha_not_Q : f a ∉ Q.support := by
    intro haQ
    dsimp [Q] at haQ
    rw [Walk.support_map] at haQ
    rcases List.mem_map.mp haQ with ⟨u, hu, hua⟩
    have hua' : u = a := f.injective hua
    subst u
    have haS : a ∈ s.support := by
      simpa [Walk.support_reverse] using hu
    have haInner : a ∈ Erdos752.bfsLayer K root₁ i₁ :=
      hpLayer a p.start_mem_support
    rcases hsavoid a haS with hax | haout
    · have hzero : t = 0 := by
        apply (hp.getVert_eq_start_iff htle).mp
        simpa [x] using hax.symm
      omega
    · exact haout haInner
  have hQr : Q.support.Disjoint r.support.tail :=
    support_disjoint_tail_of_layer_path_and_avoiding_return
      J hr hQouter hravoid ha_not_Q
  have hPreturn : P.support.tail.Disjoint (Q.append r).support.tail := by
    rw [List.disjoint_left]
    intro z hzP hzReturn
    have hsupport :
        (Q.append r).support.tail = Q.support.tail ++ r.support.tail := by
      rw [Walk.support_append, ← Q.cons_tail_support]
      simp
    rw [hsupport] at hzReturn
    rcases List.mem_append.mp hzReturn with hzQ | hzR
    · exact List.disjoint_left.mp hPQ hzP hzQ
    · have hPouter : ∀ w ∈ P.support.tail,
          w ∈ Erdos752.bfsLayer J root₀ i₀ := by
        intro w hw
        dsimp [P] at hw
        rw [Walk.support_map] at hw
        rw [← List.map_tail] at hw
        rcases List.mem_map.mp hw with ⟨u, hu, rfl⟩
        have huTake : u ∈ (p.take t).support := List.mem_of_mem_tail hu
        rw [Walk.support_take] at huTake
        have huP : u ∈ p.support := List.mem_of_mem_take huTake
        exact hpathOuter u huP
      have ha_not_Ptail : f a ∉ P.support.tail := by
        have hnodup := hP.support_nodup
        rw [P.support_eq_cons] at hnodup
        exact (List.nodup_cons.mp hnodup).1
      have hroot_not_rtail : f root₁ ∉ r.support.tail := by
        have hnodup := hr.support_nodup
        rw [r.support_eq_cons] at hnodup
        exact (List.nodup_cons.mp hnodup).1
      have hzRsupp : z ∈ r.support := List.mem_of_mem_tail hzR
      rcases hravoid z hzRsupp with hzroot | hza | hzoutside
      · exact hroot_not_rtail (hzroot ▸ hzR)
      · exact ha_not_Ptail (hza ▸ hzP)
      · exact hzoutside (hPouter z hzP)
  have hPlen : P.length = t := by
    simp [P, Walk.take_length, Nat.min_eq_left htle]
  have hQlen : Q.length = i₁ := by
    simp [Q, hslen]
  apply cycleGraph_isContained_of_three_path_splice J hk hP hQ hr hQr hPreturn
  rw [hPlen, hQlen]
  dsimp [t]
  omega

/-- Provenance-preserving two-pass closure for component BFS cores.  The
second envelope is exactly a mapped BFS ball.  Re-inducing on that envelope
gives a connected graph isomorphic to the genuine component ball, so inner
distances and parity membership are preserved.  If the whole envelope lies
in one first-pass parity core, connected localization puts it in one outer
layer and the exact nested splice produces the prescribed cycle. -/
theorem cycleGraph_isContained_of_long_path_in_nested_component_bfs_cores
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H₀ D₀ H₁ D₁ : Finset V}
    (hcore₀ : IsComponentBfsParityCore G H₀ D₀)
    (hcore₁ : IsComponentBfsParityCore G H₁ D₁)
    (hH₁D₁ : H₁ ⊆ D₁) (hD₁H₀ : D₁ ⊆ H₀)
    {a b : H₁} {p : (G.induce (H₁ : Set V)).Walk a b} {k : ℕ}
    (hk : 3 ≤ k) (hp : p.IsPath)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hkpath : k ≤ p.length) :
    cycleGraph k ⊑ G := by
  classical
  rcases hcore₀ with ⟨S₀, c₀, root₀, j₀, parity₀, hj₀, hH₀eq, _hD₀eq⟩
  rcases hcore₁ with ⟨S₁, c₁, root₁, j₁, parity₁, hj₁, hH₁eq, hD₁eq⟩
  let J : SimpleGraph c₀ := c₀.toSimpleGraph
  let K : SimpleGraph c₁ := c₁.toSimpleGraph
  let B : Finset c₁ := (bfsBall K root₁ (j₁ + 1)).toFinset
  let Q : SimpleGraph D₁ := G.induce (D₁ : Set V)
  let KB : SimpleGraph B := K.induce (B : Set c₁)
  obtain ⟨e, heval⟩ := exists_iso_induce_mapped_bfsBall G hD₁eq
  have hKBconn : KB.Connected := by
    simpa [KB, B, K] using
      induce_bfsBall_connected_of_connected K c₁.connected_toSimpleGraph root₁ (j₁ + 1)
  have hQconn : Q.Connected := by
    rw [connected_iff_exists_forall_reachable]
    let z₀ : D₁ := e.symm ⟨root₁, by
      apply (Set.mem_toFinset (s := bfsBall K root₁ (j₁ + 1))).mpr
      simp [bfsBall]⟩
    refine ⟨z₀, ?_⟩
    intro z
    have hreach : KB.Reachable (e z₀) (e z) := hKBconn (e z₀) (e z)
    simpa [Q, KB, z₀] using hreach.map e.symm.toHom
  have hpre₀ : ∀ y : D₁, ∃ x : c₀, x.1.1 = y.1 := by
    intro y
    have hyH₀ : (y : V) ∈ H₀ := hD₁H₀ y.property
    rw [hH₀eq] at hyH₀
    rcases Finset.mem_map.mp hyH₀ with ⟨x, _hx, hxval⟩
    exact ⟨x, hxval⟩
  let lift₀ : D₁ → c₀ := fun y => Classical.choose (hpre₀ y)
  have hlift₀val : ∀ y : D₁, (lift₀ y).1.1 = y.1 := by
    intro y
    exact Classical.choose_spec (hpre₀ y)
  let f : Q ↪g J :=
    { toFun := lift₀
      inj' := by
        intro x y hxy
        apply Subtype.ext
        calc
          x.1 = (lift₀ x).1.1 := (hlift₀val x).symm
          _ = (lift₀ y).1.1 := by rw [hxy]
          _ = y.1 := hlift₀val y
      map_rel_iff' := by
        intro x y
        change G.Adj (lift₀ x).1.1 (lift₀ y).1.1 ↔ G.Adj x.1 y.1
        simp [hlift₀val x, hlift₀val y] }
  have hfouter : ∀ y : D₁,
      f y ∈ parityBfsLayerUnion J root₀ j₀ parity₀ := by
    intro y
    have hyH₀ : (y : V) ∈ H₀ := hD₁H₀ y.property
    rw [hH₀eq] at hyH₀
    rcases Finset.mem_map.mp hyH₀ with ⟨x, hx, hxval⟩
    have hxy : x = f y := by
      apply Subtype.ext
      apply Subtype.ext
      calc
        x.1.1 = y.1 := hxval
        _ = (lift₀ y).1.1 := (hlift₀val y).symm
    simpa [J, hxy] using hx
  obtain ⟨i₀, hi₀j, _hi₀par, houter⟩ :=
    exists_bfsLayer_containing_connected_embedding_of_parityBfsLayerUnion
      J Q hQconn f hfouter
  have hrootB : root₁ ∈ B := by
    apply (Set.mem_toFinset (s := bfsBall K root₁ (j₁ + 1))).mpr
    simp [bfsBall]
  let rootB : B := ⟨root₁, hrootB⟩
  let rootQ : D₁ := e.symm rootB
  have hrootQval : rootQ.1 = root₁.1.1 := by
    have h := heval rootQ
    have heq : e rootQ = rootB := by simp [rootQ]
    rw [heq] at h
    simpa [rootB] using h.symm
  let inc : G.induce (H₁ : Set V) ↪g Q :=
    G.induceHomOfLE (by
      intro z hz
      exact hH₁D₁ hz)
  let q : Q.Walk (inc a) (inc b) := p.map inc.toHom
  have hqpath : q.IsPath := hp.map inc.injective
  have hqval : ∀ y : H₁, (inc y).1 = y.1 := by
    intro y
    rfl
  have hqInner : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion Q rootQ j₁ parity₁ := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH₁ : (y : V) ∈ H₁ := y.property
    have hyH₁map : (y : V) ∈
        Finset.map ⟨fun x : c₁ => x.1.1, by
          intro x y hxy
          exact Subtype.ext (Subtype.ext hxy)⟩
          (parityBfsLayerUnion K root₁ j₁ parity₁) := by
      simpa [hH₁eq, K] using hyH₁
    rcases Finset.mem_map.mp hyH₁map with ⟨x, hx, hxval⟩
    have hex : e (inc y) = ⟨x, by
        have hxball : x ∈ (bfsBall K root₁ (j₁ + 1)).toFinset :=
          by
            apply (Set.mem_toFinset (s := bfsBall K root₁ (j₁ + 1))).mpr
            have hxj : K.dist root₁ x ≤ j₁ :=
              (mem_parityBfsLayerUnion_iff K root₁ j₁ parity₁ x).1 hx |>.1
            change K.dist root₁ x ≤ j₁ + 1
            omega
        simpa [B, K] using hxball⟩ := by
      apply Subtype.ext
      apply Subtype.ext
      apply Subtype.ext
      calc
        (e (inc y)).1.1 = (inc y).1 := heval (inc y)
        _ = y.1 := hqval y
        _ = x.1.1 := hxval.symm
    have hdistIso : Q.dist rootQ (inc y) = KB.dist (e rootQ) (e (inc y)) :=
      dist_eq_of_iso_of_connected e hQconn rootQ (inc y)
    have hdistBall : KB.dist rootB (e (inc y)) = K.dist root₁ x := by
      have h := dist_induce_bfsBall_eq_dist_of_connected
        K c₁.connected_toSimpleGraph root₁ (j₁ + 1) (e (inc y))
      simpa [KB, B, K, rootB, hex] using h
    have heroot : e rootQ = rootB := by simp [rootQ]
    have hdist : Q.dist rootQ (inc y) = K.dist root₁ x := by
      rw [hdistIso, heroot, hdistBall]
    have hxmetric := (mem_parityBfsLayerUnion_iff K root₁ j₁ parity₁ x).1 hx
    apply (mem_parityBfsLayerUnion_iff Q rootQ j₁ parity₁ (inc y)).2
    rw [hdist]
    exact hxmetric
  have hc₀V : Fintype.card c₀ ≤ Fintype.card V :=
    Fintype.card_le_of_injective (fun x : c₀ => x.1.1) (by
      intro x y hxy
      exact Subtype.ext (Subtype.ext hxy))
  have hc₁V : Fintype.card c₁ ≤ Fintype.card V :=
    Fintype.card_le_of_injective (fun x : c₁ => x.1.1) (by
      intro x y hxy
      exact Subtype.ext (Subtype.ext hxy))
  have hj₀V : j₀ ≤ Nat.log 2 (Fintype.card V) :=
    hj₀.trans (Nat.log_mono_right hc₀V)
  have hj₁V : j₁ ≤ Nat.log 2 (Fintype.card V) :=
    hj₁.trans (Nat.log_mono_right hc₁V)
  have hroom' : 2 * j₀ + j₁ + 1 ≤ k := by
    omega
  have hJ : cycleGraph k ⊑ J := by
    apply cycleGraph_isContained_of_long_path_with_bfsBall_in_outer_layer
      J c₀.connected_toSimpleGraph Q hQconn f hi₀j
      (root₀ := root₀) (root₁ := rootQ) (j₁ := j₁) (parity₁ := parity₁)
      (p := q) hk hqpath hqInner
    · intro z _hz
      exact houter z
    · intro z _hz
      exact houter z
    · exact hroom'
    · simpa [q] using hkpath
  let eJ : J ↪g G.induce (S₀ : Set V) := by
    simpa [J, SimpleGraph.ConnectedComponent.toSimpleGraph] using
      (SimpleGraph.Embedding.induce
        (G := G.induce (S₀ : Set V)) (c₀.supp : Set S₀))
  let eG : G.induce (S₀ : Set V) ↪g G :=
    SimpleGraph.Embedding.induce (G := G) (S₀ : Set V)
  exact hJ.trans (eJ.isContained.trans eG.isContained)

/-- Family form of the preceding two-pass closure.  The first separator
family is stored as core-envelope pairs.  Its core projection remains
pairwise disjoint and anticomplete, so the mapped second BFS ball lies in one
first core; that member supplies the outer provenance required by the exact
nested-component splice. -/
theorem cycleGraph_isContained_of_long_path_in_second_component_bfs_core_family
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F₀ : Finset (Finset V × Finset V)} {H₁ D₁ : Finset V}
    (hcore₀ : ∀ r ∈ F₀, r.1 ⊆ r.2 ∧
      IsComponentBfsParityCore G r.1 r.2)
    (hdisj₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s → Disjoint r.2 s.2)
    (hanti₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s →
      ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b)
    (hcore₁ : IsComponentBfsParityCore G H₁ D₁)
    (hH₁D₁ : H₁ ⊆ D₁)
    (hD₁W₀ : D₁ ⊆ F₀.biUnion (fun r => r.1))
    {a b : H₁} {p : (G.induce (H₁ : Set V)).Walk a b} {k : ℕ}
    (hk : 3 ≤ k) (hp : p.IsPath)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hkpath : k ≤ p.length) :
    cycleGraph k ⊑ G := by
  classical
  let C₀ : Finset (Finset V) := F₀.image fun r => r.1
  have hdisjC₀ : DisjointFinsetFamily C₀ := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨r, hr, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨s, hs, rfl⟩
    have hrs : r ≠ s := by
      intro hrs
      subst s
      exact hAB rfl
    exact (hdisj₀ r hr s hs hrs).mono (hcore₀ r hr).1 (hcore₀ s hs).1
  have hantiC₀ : PairwiseAnticomplete G C₀ := by
    intro A hA B hB hAB a ha b hb
    rcases Finset.mem_image.mp hA with ⟨r, hr, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨s, hs, rfl⟩
    have hrs : r ≠ s := by
      intro hrs
      subst s
      exact hAB rfl
    exact hanti₀ r hr s hs hrs a ha b hb
  have hD₁C₀ : D₁ ⊆ C₀.biUnion id := by
    intro v hv
    rcases Finset.mem_biUnion.mp (hD₁W₀ hv) with ⟨r, hr, hvr⟩
    exact Finset.mem_biUnion.mpr
      ⟨r.1, Finset.mem_image.mpr ⟨r, hr, rfl⟩, hvr⟩
  rcases hcore₁ with ⟨S₁, c₁, root₁, j₁, parity₁, hj₁, hH₁eq, hD₁eq⟩
  obtain ⟨A, hA, hballA⟩ :=
    exists_member_containing_mapped_bfsBall_of_pairwiseAnticomplete
      G hdisjC₀ hantiC₀ hD₁eq hD₁C₀
  have hD₁A : D₁ ⊆ A := by
    intro v hv
    rw [hD₁eq] at hv
    rcases Finset.mem_map.mp hv with ⟨z, hz, hzval⟩
    have hzA := hballA z hz
    simpa [← hzval] using hzA
  rcases Finset.mem_image.mp hA with ⟨r, hr, hrA⟩
  subst A
  have hcore₁' : IsComponentBfsParityCore G H₁ D₁ :=
    ⟨S₁, c₁, root₁, j₁, parity₁, hj₁, hH₁eq, hD₁eq⟩
  exact cycleGraph_isContained_of_long_path_in_nested_component_bfs_cores
    G (hcore₀ r hr).2 hcore₁' hH₁D₁ hD₁A hk hp hroom hkpath

/-- In a cycle-free graph the selected second-pass component core has no
path of the target length.  This is the exact long-path exclusion needed by
the Pósa short-dense alternative: any such path would trigger the preceding
two-pass BFS closure. -/
theorem not_hasPathFromAtLeast_in_second_component_bfs_core_family_of_cycleFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F₀ : Finset (Finset V × Finset V)} {H₁ D₁ : Finset V}
    (hcore₀ : ∀ r ∈ F₀, r.1 ⊆ r.2 ∧
      IsComponentBfsParityCore G r.1 r.2)
    (hdisj₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s → Disjoint r.2 s.2)
    (hanti₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s →
      ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b)
    (hcore₁ : IsComponentBfsParityCore G H₁ D₁)
    (hH₁D₁ : H₁ ⊆ D₁)
    (hD₁W₀ : D₁ ⊆ F₀.biUnion (fun r => r.1))
    {k : ℕ} (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G) (x : H₁) :
    ¬ HasPathFromAtLeast (G.induce (H₁ : Set V)) x k := by
  rintro ⟨y, p, hp, hkpath⟩
  exact hcycle
    (cycleGraph_isContained_of_long_path_in_second_component_bfs_core_family
      G hcore₀ hdisj₀ hanti₀ hcore₁ hH₁D₁ hD₁W₀ hk hp hroom hkpath)

/-- The cycle-free selected second-pass core therefore contains, from every
chosen start, a bounded support carrying the Pósa quadratic edge mass.  This
is the local dense object passed to the already formalized DRC extractor. -/
theorem exists_short_dense_support_in_second_component_bfs_core_family_of_cycleFree
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F₀ : Finset (Finset V × Finset V)} {H₁ D₁ : Finset V}
    (hcore₀ : ∀ r ∈ F₀, r.1 ⊆ r.2 ∧
      IsComponentBfsParityCore G r.1 r.2)
    (hdisj₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s → Disjoint r.2 s.2)
    (hanti₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s →
      ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b)
    (hcore₁ : IsComponentBfsParityCore G H₁ D₁)
    (hH₁D₁ : H₁ ⊆ D₁)
    (hD₁W₀ : D₁ ⊆ F₀.biUnion (fun r => r.1))
    {k : ℕ} (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G) (x : H₁) :
    ∃ S : Finset H₁, S.Nonempty ∧ S.card ≤ k ∧
      (G.induce (H₁ : Set V)).minDegree *
          (G.induce (H₁ : Set V)).minDegree ≤
        2 * (inducedEdgeFinsetOn (G.induce (H₁ : Set V)) S).card := by
  apply exists_short_dense_support_of_no_long_path
    (G.induce (H₁ : Set V)) x k
  exact not_hasPathFromAtLeast_in_second_component_bfs_core_family_of_cycleFree
    G hcore₀ hdisj₀ hanti₀ hcore₁ hH₁D₁ hD₁W₀ hk hroom hcycle x

/-- Average density plus exclusion of every k-long path yields a genuine
minimum-degree core whose every start has a short Pósa support with quadratic
edge mass.  First run the standard low-degree deletion on the dense graph;
then any forbidden path in the resulting induced support maps injectively
back to the original graph, so the path-free hypothesis survives and the
already checked Pósa alternative applies. -/
theorem exists_minDegree_core_with_short_dense_support_of_dense_no_long_path
    {W : Type*} [Fintype W] [Nonempty W]
    (K : SimpleGraph W) [DecidableRel K.Adj] {d k : ℕ}
    (hd : 0 < d)
    (hdense : d * Fintype.card W ≤ 2 * K.edgeFinset.card)
    (hno : ¬ ∃ u v : W, ∃ p : K.Walk u v, p.IsPath ∧ k ≤ p.length) :
    ∃ H : SimpleGraph W, ∃ _ : DecidableRel H.Adj,
      ∃ hne : H.support.Nonempty,
        H ≤ K ∧ d ≤ 2 * (H.induce H.support).minDegree ∧
        ∀ x : H.support,
          ∃ S : Finset H.support, S.Nonempty ∧
            (H.induce H.support).minDegree ≤ S.card ∧ S.card ≤ k ∧
            (H.induce H.support).minDegree *
                (H.induce H.support).minDegree ≤
              2 * (inducedEdgeFinsetOn (H.induce H.support) S).card := by
  classical
  have hE : K.edgeFinset.Nonempty := by
    by_contra hnot
    rw [Finset.not_nonempty_iff_eq_empty] at hnot
    have hzero : K.edgeFinset.card = 0 := by simp [hnot]
    rw [hzero] at hdense
    have hpos : 0 < d * Fintype.card W := Nat.mul_pos hd Fintype.card_pos
    omega
  have hsuppcard : K.support.ncard ≤ Fintype.card W := by
    simpa using Set.ncard_le_ncard (Set.subset_univ K.support)
  have hdenseSupport : d * K.support.ncard ≤ 2 * K.edgeFinset.card :=
    (Nat.mul_le_mul_left d hsuppcard).trans hdense
  obtain ⟨H, instH, hne, hHK, _hedge, hmin⟩ :=
    Erdos182.exists_induced_minDegree_core K d hE hdenseSupport
  let C : SimpleGraph H.support := H.induce H.support
  refine ⟨H, instH, hne, hHK, ?_, ?_⟩
  · simpa [C] using hmin
  · intro x
    have hnoC : ¬ HasPathFromAtLeast C x k := by
      rintro ⟨y, p, hp, hkpath⟩
      let e : C ↪g H := SimpleGraph.Embedding.induce H.support
      let f : C →g K := (SimpleGraph.Hom.ofLE hHK).comp e.toHom
      have hf : Function.Injective f := by
        intro a b hab
        apply e.injective
        simpa [f] using hab
      let q : K.Walk (f x) (f y) := p.map f
      apply hno
      exact ⟨f x, f y, q, hp.map hf, by simpa [q] using hkpath⟩
    simpa [C] using
      exists_short_dense_support_with_size_bounds_of_no_long_path C x k hnoC

/-- Applied to one selected second-pass core, the previous dense path-free
lemma supplies the exact minimum-degree/Pósa object used before DRC.  The
absence of every k-long path is not an extra hypothesis: the checked
two-pass family closure turns any such path into the forbidden ambient C_k. -/
theorem exists_minDegree_core_with_short_dense_support_of_second_component_bfs_core
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {F₀ : Finset (Finset V × Finset V)} {H₁ D₁ : Finset V}
    (hcore₀ : ∀ r ∈ F₀, r.1 ⊆ r.2 ∧
      IsComponentBfsParityCore G r.1 r.2)
    (hdisj₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s → Disjoint r.2 s.2)
    (hanti₀ : ∀ r ∈ F₀, ∀ s ∈ F₀, r ≠ s →
      ∀ a ∈ r.1, ∀ b ∈ s.1, ¬ G.Adj a b)
    (hcore₁ : IsComponentBfsParityCore G H₁ D₁)
    (hH₁D₁ : H₁ ⊆ D₁)
    (hD₁W₀ : D₁ ⊆ F₀.biUnion (fun r => r.1))
    (hH₁ne : H₁.Nonempty) {d k : ℕ} (hd : 0 < d)
    (hdense : d * H₁.card ≤ 2 * (inducedEdgeFinsetOn G H₁).card)
    (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ H : SimpleGraph H₁, ∃ _ : DecidableRel H.Adj,
      ∃ hne : H.support.Nonempty,
        H ≤ G.induce (H₁ : Set V) ∧
        d ≤ 2 * (H.induce H.support).minDegree ∧
        ∀ x : H.support,
          ∃ S : Finset H.support, S.Nonempty ∧
            (H.induce H.support).minDegree ≤ S.card ∧ S.card ≤ k ∧
            (H.induce H.support).minDegree *
                (H.induce H.support).minDegree ≤
              2 * (inducedEdgeFinsetOn (H.induce H.support) S).card := by
  classical
  let J : SimpleGraph H₁ := G.induce (H₁ : Set V)
  let : Nonempty H₁ := hH₁ne.to_subtype
  have hedge : (inducedEdgeFinsetOn G H₁).card = J.edgeFinset.card := by
    simpa [J] using card_inducedEdgeFinsetOn_eq_card_induce_finset G H₁
  have hJdense : d * Fintype.card H₁ ≤ 2 * J.edgeFinset.card := by
    rw [Fintype.card_coe, ← hedge]
    exact hdense
  have hno : ¬ ∃ u v : H₁, ∃ p : J.Walk u v, p.IsPath ∧ k ≤ p.length := by
    rintro ⟨u, v, p, hp, hkpath⟩
    exact hcycle
      (cycleGraph_isContained_of_long_path_in_second_component_bfs_core_family
        G hcore₀ hdisj₀ hanti₀ hcore₁ hH₁D₁ hD₁W₀ hk hp hroom hkpath)
  simpa [J] using
    exists_minDegree_core_with_short_dense_support_of_dense_no_long_path
      J hd hJdense hno

/-- Large-set form of the complete two-pass dense-to-Pósa package.  It keeps
the density parameter d explicit, so the theorem can be applied inside every
remaining induced set during greedy hub peeling, not only at the original
extremal order. -/
theorem exists_short_dense_minDegree_core_of_large_indepSetFree_cycleFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n d k : ℕ}
    (hn : 2 ≤ n) (hd : 0 < d) (hfree : G.IndepSetFree n)
    (hsize : 16 * ((n - 1) * (d + 1)) ≤ Fintype.card V)
    (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ H₁ : Finset V, ∃ H : SimpleGraph H₁,
      ∃ _ : DecidableRel H.Adj, ∃ hne : H.support.Nonempty,
        H ≤ G.induce (H₁ : Set V) ∧
        d ≤ 2 * (H.induce H.support).minDegree ∧
        ∀ x : H.support,
          ∃ S : Finset H.support, S.Nonempty ∧
            (H.induce H.support).minDegree ≤ S.card ∧ S.card ≤ k ∧
            (H.induce H.support).minDegree *
                (H.induce H.support).minDegree ≤
              2 * (inducedEdgeFinsetOn (H.induce H.support) S).card := by
  obtain ⟨F₀, F₁, q, hq, hcore₀, hdisj₀, hanti₀,
      hcore₁, _hdisj₁, _hanti₁, hqdense⟩ :=
    exists_dense_second_component_bfs_core_of_indepSetFree
      G hn hfree hsize
  obtain ⟨H, instH, hne, hHJ, hmin, hshort⟩ :=
    exists_minDegree_core_with_short_dense_support_of_second_component_bfs_core
      G
      (fun r hr => ⟨(hcore₀ r hr).1, (hcore₀ r hr).2.2.2⟩)
      hdisj₀ hanti₀
      (hcore₁ q hq).2.2.2.2
      (hcore₁ q hq).1 (hcore₁ q hq).2.1
      (hcore₁ q hq).2.2.1 hd hqdense hk hroom hcycle
  exact ⟨q.1, H, instH, hne, hHJ, hmin, hshort⟩

/-- At the Ramsey extremal order on the diagonal range, every slow BFS
radius is at most twice the binary logarithm of k, up to the harmless
additive one from the strict power bound.  This estimate is placed before
the diagonal core wrapper because that wrapper uses it immediately. -/
theorem log_extremal_order_le_two_mul_log_add_one
    {k n : ℕ} (hk : 1 ≤ k) (hnk : n ≤ k) :
    Nat.log 2 ((k - 1) * (n - 1) + 1) ≤
      2 * (Nat.log 2 k + 1) := by
  have hn1 : n - 1 ≤ k - 1 := Nat.sub_le_sub_right hnk 1
  have horder : (k - 1) * (n - 1) + 1 ≤ k * k := by
    calc
      (k - 1) * (n - 1) + 1 ≤ (k - 1) * (k - 1) + 1 :=
        Nat.add_le_add_right (Nat.mul_le_mul_left _ hn1) 1
      _ ≤ (k - 1) * (k - 1) + (2 * (k - 1) + 1) := by omega
      _ = ((k - 1) + 1) * ((k - 1) + 1) := by ring
      _ = k * k := by rw [Nat.sub_add_cancel hk]
  have hkpow : k ≤ 2 ^ (Nat.log 2 k + 1) := by
    exact (Nat.lt_pow_succ_log_self (b := 2) (by omega) k).le
  have hpow : (k - 1) * (n - 1) + 1 ≤
      2 ^ (2 * (Nat.log 2 k + 1)) := by
    calc
      (k - 1) * (n - 1) + 1 ≤ k * k := horder
      _ ≤ 2 ^ (Nat.log 2 k + 1) * 2 ^ (Nat.log 2 k + 1) :=
        Nat.mul_le_mul hkpow hkpow
      _ = 2 ^ (2 * (Nat.log 2 k + 1)) := by
        rw [← Nat.pow_add]
        congr 1
        omega
  calc
    Nat.log 2 ((k - 1) * (n - 1) + 1) ≤
        Nat.clog 2 ((k - 1) * (n - 1) + 1) :=
      Nat.log_le_clog _ _
    _ ≤ 2 * (Nat.log 2 k + 1) := Nat.clog_le_of_le_pow hpow

/-- A concrete exponential estimate used to dominate the binary logarithm. -/
theorem eight_mul_add_seven_le_two_pow_of_eight_le
    {q : ℕ} (hq : 8 ≤ q) : 8 * q + 7 ≤ 2 ^ q := by
  induction q using Nat.strong_induction_on with
  | h q ih =>
      by_cases hq8 : q = 8
      · subst q
        norm_num
      have hqgt : 8 < q := by omega
      have hpred : 8 ≤ q - 1 := by omega
      have ihpred := ih (q - 1) (by omega) hpred
      have hqform : q = (q - 1) + 1 := by omega
      rw [hqform, pow_succ]
      have htwice : 2 * (8 * (q - 1) + 7) ≤ 2 * 2 ^ (q - 1) :=
        Nat.mul_le_mul_left 2 ihpred
      omega

/-- From k at least 64 onward, six binary logarithms plus the fixed splice
overhead fit below k. -/
theorem six_mul_log_add_one_le_self_of_64_le
    {k : ℕ} (hk : 64 ≤ k) :
    6 * (Nat.log 2 k + 1) + 1 ≤ k := by
  let q : ℕ := k / 8
  have hq8 : 8 ≤ q := by
    dsimp [q]
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  have hkq : k ≤ 8 * q + 7 := by
    have hmod : k % 8 < 8 := Nat.mod_lt k (by omega)
    have hdivmod : 8 * (k / 8) + k % 8 = k := Nat.div_add_mod k 8
    dsimp [q]
    omega
  have hkpow : k ≤ 2 ^ q :=
    hkq.trans (eight_mul_add_seven_le_two_pow_of_eight_le hq8)
  have hlog : Nat.log 2 k ≤ q :=
    (Nat.log_le_clog 2 k).trans (Nat.clog_le_of_le_pow hkpow)
  have hqk : 8 * q ≤ k := by
    dsimp [q]
    exact Nat.mul_div_le k 8
  have hmain : 6 * (Nat.log 2 k + 1) + 1 ≤ 8 * q := by omega
  exact hmain.trans hqk

/-- At diagonal extremal order, the entire two-level BFS detour budget fits
below k from the same concrete threshold. -/
theorem three_mul_log_extremal_order_add_one_le_of_64_le
    {k n : ℕ} (hk : 64 ≤ k) (hnk : n ≤ k) :
    3 * Nat.log 2 ((k - 1) * (n - 1) + 1) + 1 ≤ k := by
  have hlog := log_extremal_order_le_two_mul_log_add_one (by omega : 1 ≤ k) hnk
  have hklog := six_mul_log_add_one_le_self_of_64_le hk
  calc
    3 * Nat.log 2 ((k - 1) * (n - 1) + 1) + 1 ≤
        3 * (2 * (Nat.log 2 k + 1)) + 1 :=
      Nat.add_le_add_right (Nat.mul_le_mul_left 3 hlog) 1
    _ = 6 * (Nat.log 2 k + 1) + 1 := by ring
    _ ≤ k := hklog

/-- Elementary exponential domination at the square-root scale. -/
theorem succ_sq_le_two_pow_of_six_le {s : ℕ} (hs : 6 ≤ s) :
    (s + 1) ^ 2 ≤ 2 ^ s := by
  induction s, hs using Nat.le_induction with
  | base => norm_num
  | succ s hs ih =>
      have hstep : (s + 2) ^ 2 ≤ 2 * (s + 1) ^ 2 := by
        nlinarith
      calc
        (s + 2) ^ 2 ≤ 2 * (s + 1) ^ 2 := hstep
        _ ≤ 2 * 2 ^ s := Nat.mul_le_mul_left 2 ih
        _ = 2 ^ (s + 1) := by rw [Nat.pow_succ]; ring

/-- Binary logarithm is at most the natural square root once the latter is
at least six. -/
theorem log_two_le_sqrt_of_six_le_sqrt {k : ℕ}
    (hs : 6 ≤ Nat.sqrt k) :
    Nat.log 2 k ≤ Nat.sqrt k := by
  let s : ℕ := Nat.sqrt k
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hkpow : k ≤ 2 ^ s :=
    hklt.le.trans (succ_sq_le_two_pow_of_six_le (by simpa [s] using hs))
  exact (Nat.log_le_clog 2 k).trans (Nat.clog_le_of_le_pow hkpow)

/-- The explicit square-root-scale selected-path interval fits below the
target cycle length throughout the diagonal range.  The label count may be
any number bounded by the extremal host order. -/
theorem seven_mul_sqrt_sixteenth_log_interval_le
    {k n L : ℕ} (hs : 64 ≤ Nat.sqrt k) (hnk : n ≤ k)
    (hL : L ≤ (k - 1) * (n - 1) + 1) :
    7 * (Nat.sqrt k / 16 + 1 + 2 * Nat.log 2 L) ≤ k := by
  let s : ℕ := Nat.sqrt k
  have hk1 : 1 ≤ k := by
    exact (show 1 ≤ s by omega).trans (Nat.sqrt_le_self k)
  have hlogL : Nat.log 2 L ≤ 2 * (Nat.log 2 k + 1) :=
    (Nat.log_mono_right hL).trans
      (log_extremal_order_le_two_mul_log_add_one hk1 hnk)
  have hlogk : Nat.log 2 k ≤ s := by
    simpa [s] using log_two_le_sqrt_of_six_le_sqrt (by omega)
  have hDs : s / 16 ≤ s := Nat.div_le_self s 16
  have hsquare : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hbound :
      7 * (s / 16 + 1 + 2 * Nat.log 2 L) ≤ 35 * s + 35 := by
    omega
  have hsqbound : 35 * s + 35 ≤ s ^ 2 := by
    nlinarith
  exact hbound.trans (hsqbound.trans hsquare)

/-- At the same square-root scale, every cycle length above
`sqrt k / 16 + 1` has enough aggregate alternating-scaffold capacity for
the exact `C_k` lift. -/
theorem sqrt_sixteenth_long_capacity
    {k ℓ : ℕ} (hs : 64 ≤ Nat.sqrt k)
    (hℓ : Nat.sqrt k / 16 + 1 ≤ ℓ) :
    (k - 7 * ℓ) / 2 ≤ (9 * Nat.sqrt k - 4) * ℓ := by
  let s : ℕ := Nat.sqrt k
  have hsℓ : s < 16 * ℓ := by
    have hdiv : s < 16 * (s / 16 + 1) :=
      Nat.lt_mul_div_succ s (by omega)
    exact hdiv.trans_le (Nat.mul_le_mul_left 16 hℓ)
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hsub : 9 * s - 4 + 4 = 9 * s :=
    Nat.sub_add_cancel (by omega)
  have hprod : (s + 1) ^ 2 ≤ ((9 * s - 4) * ℓ) * 2 := by
    nlinarith
  have htwice : k ≤ ((9 * s - 4) * ℓ) * 2 := hklt.le.trans hprod
  calc
    (k - 7 * ℓ) / 2 ≤ k / 2 := Nat.div_le_div_right (Nat.sub_le k _)
    _ ≤ (9 * s - 4) * ℓ := Nat.div_le_of_le_mul (by
      simpa [Nat.mul_comm] using htwice)
    _ = (9 * Nat.sqrt k - 4) * ℓ := by simp [s]

/-- The internal vertices of a `sqrt k / 16` selected prefix alone carry
half the target length once `sqrt k` is at least 336.  This is the capacity
estimate needed by the hybrid lift, whose two junction vertices are routed
only by short robust paths. -/
theorem sqrt_sixteenth_internal_selected_capacity
    {k d : ℕ} (hs : 336 ≤ Nat.sqrt k)
    (hd : Nat.sqrt k / 16 ≤ d) :
    k / 2 ≤ (9 * Nat.sqrt k - 4) * (d - 1) := by
  let s : ℕ := Nat.sqrt k
  let D : ℕ := s / 16
  have hD : 21 ≤ D := by
    dsimp [D]
    apply (Nat.le_div_iff_mul_le (by omega)).2
    simpa [s] using hs
  have hsupper : s ≤ 16 * D + 15 := by
    have hmod : s % 16 < 16 := Nat.mod_lt s (by omega)
    have hdivmod : 16 * (s / 16) + s % 16 = s := Nat.div_add_mod s 16
    dsimp [D]
    omega
  have hklt : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hsubS : 9 * s - 4 + 4 = 9 * s :=
    Nat.sub_add_cancel (by omega)
  have hsubD : D - 1 + 1 = D := Nat.sub_add_cancel (by omega)
  have hsDlower : 16 * D ≤ s := by
    dsimp [D]
    exact Nat.mul_div_le s 16
  have hsDupper : s ≤ 17 * D := by omega
  have hsSq : s * s ≤ 17 * s * D := by
    calc
      s * s ≤ s * (17 * D) := Nat.mul_le_mul_left s hsDupper
      _ = 17 * s * D := by ring
  have hE : 1 ≤ D - 20 := by omega
  have hsE : s ≤ s * (D - 20) := by
    simpa using Nat.mul_le_mul_left s hE
  have hsquare : (s + 1) ^ 2 ≤ 2 * (9 * s - 4) * (D - 1) := by
    nlinarith
  have htwiceD : k ≤ ((9 * s - 4) * (D - 1)) * 2 := by
    calc
      k ≤ (s + 1) ^ 2 := hklt.le
      _ ≤ ((9 * s - 4) * (D - 1)) * 2 := by
        simpa [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hsquare
  have hDle : D - 1 ≤ d - 1 := by
    dsimp [D, s]
    omega
  calc
    k / 2 ≤ (9 * s - 4) * (D - 1) := Nat.div_le_of_le_mul (by
      simpa [Nat.mul_comm] using htwiceD)
    _ ≤ (9 * s - 4) * (d - 1) := Nat.mul_le_mul_left _ hDle
    _ = (9 * Nat.sqrt k - 4) * (d - 1) := by simp [s]

/-- At the diagonal extremal order, a C_k-free independent-set-free graph
therefore contains a path-free minimum-degree core on the explicit k/16
scale, and every start in that core has a k-bounded Pósa support with
quadratic edge mass.  The first/second separator families are existentially
hidden after they have discharged the exact path exclusion. -/
theorem exists_short_dense_minDegree_core_at_extremal_order_of_cycleFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hk : 64 ≤ k) (hn : 2 ≤ n) (hnk : n ≤ k)
    (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ H₁ : Finset V, ∃ H : SimpleGraph H₁,
      ∃ _ : DecidableRel H.Adj, ∃ hne : H.support.Nonempty,
        H ≤ G.induce (H₁ : Set V) ∧
        ((k - 1) / 16 - 1) ≤ 2 * (H.induce H.support).minDegree ∧
        ∀ x : H.support,
          ∃ S : Finset H.support, S.Nonempty ∧
            (H.induce H.support).minDegree ≤ S.card ∧ S.card ≤ k ∧
            (H.induce H.support).minDegree *
                (H.induce H.support).minDegree ≤
              2 * (inducedEdgeFinsetOn (H.induce H.support) S).card := by
  obtain ⟨F₀, F₁, q, hq, hcore₀, hdisj₀, hanti₀,
      hcore₁, _hdisj₁, _hanti₁, hqdense⟩ :=
    exists_dense_second_component_bfs_core_at_extremal_order
      G (by omega) hn hfree horder
  have hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k := by
    rw [horder]
    exact three_mul_log_extremal_order_add_one_le_of_64_le hk hnk
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  obtain ⟨H, instH, hne, hHJ, hmin, hshort⟩ :=
    exists_minDegree_core_with_short_dense_support_of_second_component_bfs_core
      G
      (fun r hr => ⟨(hcore₀ r hr).1, (hcore₀ r hr).2.2.2⟩)
      hdisj₀ hanti₀
      (hcore₁ q hq).2.2.2.2
      (hcore₁ q hq).1 (hcore₁ q hq).2.1
      (hcore₁ q hq).2.2.1 hd hqdense (by omega) hroom hcycle
  exact ⟨q.1, H, instH, hne, hHJ, hmin, hshort⟩

/- 
/-- Structural DRC handoff at extremal order.  Once uniform numerical DRC
estimates are supplied for every possible Pósa support and its inherited
minimum degree, the preceding core theorem produces an ambient local robust
hub.  The core maps into G by an injective homomorphism: low-degree deletion
may discard edges, but that only enlarges ambient common neighbourhoods. -/
theorem exists_localRobustHub_at_extremal_order_of_cycleFree
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n θ t τ : ℕ}
    (hk : 64 ≤ k) (hn : 2 ≤ n) (hnk : n ≤ k)
    (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : ∀ δ m : ℕ, ((k - 1) / 16 - 1) ≤ 2 * δ →
      δ ≤ m → m ≤ k →
        (θ : ℝ) ≤ η * (((δ : ℝ) / k) ^ 2) ^ 2 * m)
    (hτ : ∀ δ m : ℕ, ((k - 1) / 16 - 1) ≤ 2 * δ →
      δ ≤ m → m ≤ k →
        (τ : ℝ) ^ 2 ≤
          (((((δ : ℝ) / k) ^ 2) ^ t) * m) ^ 2 / 2)
    (hsmall : ∀ m : ℕ, 1 ≤ m → m ≤ k →
      2 * η ^ t < (1 : ℝ) / (m : ℝ) ^ 2) :
    ∃ R : Finset V, IsLocalRobustHub G θ τ R := by
  obtain ⟨H₁, H, instH, hne, hHJ, hmin, hshort⟩ :=
    exists_short_dense_minDegree_core_at_extremal_order_of_cycleFree
      G hk hn hnk hfree horder hcycle
  let C : SimpleGraph H.support := H.induce H.support
  letI : DecidableRel C.Adj := Classical.decRel _
  letI : Nonempty H.support := hne.to_subtype
  let x : H.support := Classical.choice inferInstance
  obtain ⟨S, hS, hδS, hSle, hmass⟩ := hshort x
  let e₀ : C ↪g H := SimpleGraph.Embedding.induce H.support
  let e₁ : H →g G.induce (H₁ : Set V) := SimpleGraph.Hom.ofLE hHJ
  let e₂ : G.induce (H₁ : Set V) ↪g G :=
    SimpleGraph.Embedding.induce (G := G) (H₁ : Set V)
  let e : C →g G := e₂.toHom.comp (e₁.comp e₀.toHom)
  have he : Function.Injective e := by
    intro a b hab
    apply e₀.injective
    apply e₂.injective
    simpa [e, e₁] using hab
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  have hδ : 0 < C.minDegree := by
    dsimp [C] at hmin ⊢
    omega
  let R : Finset V := S.map ⟨e, he⟩
  refine ⟨R, ?_⟩
  apply isLocalRobustHub_of_short_dense_support_under_injective_hom
    G C e he hS hδ (by omega : 0 < k) hSle hmass ht hτpos hη
  · simpa [C] using hθ C.minDegree S.card (by simpa [C] using hmin)
      (by simpa [C] using hδS) hSle
  · simpa [C] using hτ C.minDegree S.card (by simpa [C] using hmin)
      (by simpa [C] using hδS) hSle
  · simpa using hsmall S.card hS.card_pos hSle
-/

/-- Map-back form of the exact nested-BFS closure.  Dense extraction records
the inner parity core as an ambient finite image, whereas its long path is
found in the graph induced by that image.  Lift each image vertex back to
the recorded connected component, apply the exact two-level theorem there,
and keep the resulting cycle in the outer ambient graph. -/
theorem cycleGraph_isContained_of_long_path_in_mapped_nested_parityBfsLayerUnion
    {W : Type*} [Fintype W] (J : SimpleGraph W)
    [DecidableRel J.Adj] (hconn : J.Connected)
    {root₀ : W} {j₀ : ℕ} {parity₀ : Fin 2}
    (c :
      (J.induce ((parityBfsLayerUnion J root₀ j₀ parity₀ : Finset W) : Set W)).ConnectedComponent)
    {root₁ : c} {j₁ : ℕ} {parity₁ : Fin 2} {H : Finset W}
    (hHeq : H = (parityBfsLayerUnion c.toSimpleGraph root₁ j₁ parity₁).map
      ⟨fun x => x.1.1, by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)⟩)
    {a b : H} {p : (J.induce (H : Set W)).Walk a b} {k : ℕ}
    (hk : 3 ≤ k) (hp : p.IsPath)
    (hroom : 2 * j₀ + j₁ + 1 ≤ k) (hkpath : k ≤ p.length) :
    cycleGraph k ⊑ J := by
  classical
  let K : SimpleGraph c := c.toSimpleGraph
  have hpre : ∀ y : H, ∃ x : c, x.1.1 = y.1 := by
    intro y
    have hyH : (y : W) ∈ H := y.property
    have hyH' : (y : W) ∈
        (parityBfsLayerUnion c.toSimpleGraph root₁ j₁ parity₁).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, _hx, hxval⟩
    exact ⟨x, hxval⟩
  let lift : H → c := fun y => Classical.choose (hpre y)
  have hliftval : ∀ y : H, (lift y).1.1 = y.1 := by
    intro y
    exact Classical.choose_spec (hpre y)
  let e : J.induce (H : Set W) ↪g K :=
    { toFun := lift
      inj' := by
        intro x y hxy
        apply Subtype.ext
        calc
          x.1 = (lift x).1.1 := (hliftval x).symm
          _ = (lift y).1.1 := by rw [hxy]
          _ = y.1 := hliftval y
      map_rel_iff' := by
        intro x y
        change J.Adj (lift x).1.1 (lift y).1.1 ↔ J.Adj x.1 y.1
        simp [hliftval x, hliftval y] }
  let q : K.Walk (e a) (e b) := p.map e.toHom
  have hqpath : q.IsPath := hp.map e.injective
  have hqsupp : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion K root₁ j₁ parity₁ := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH : (y : W) ∈ H := y.property
    have hyH' : (y : W) ∈
        (parityBfsLayerUnion K root₁ j₁ parity₁).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      change (y : W) ∈
        (parityBfsLayerUnion c.toSimpleGraph root₁ j₁ parity₁).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, hx, hxval⟩
    have hxy : x = e y := by
      apply Subtype.ext
      apply Subtype.ext
      calc
        x.1.1 = y.1 := hxval
        _ = (lift y).1.1 := (hliftval y).symm
    simpa [hxy] using hx
  apply cycleGraph_isContained_of_long_path_in_nested_parityBfsLayerUnion
    J hconn c hk hqpath hqsupp hroom
  simpa [q] using hkpath

/-- A path in a parity BFS union therefore closes to a cycle in a uniformly
short interval, with the detour length bounded by the outer slow-layer
radius rather than by the unknown localized layer.  This is the reusable
single-BFS interval output for both the small-dense and interaction stages. -/
theorem exists_cycle_in_interval_of_path_in_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected)
    {root : V} {j parity : ℕ} {a b : V} {p : G.Walk a b}
    (hp : p.IsPath)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion G root j parity)
    (hplen : 2 ≤ p.length) :
    ∃ i : ℕ, i ≤ j ∧ i % 2 = parity ∧
      ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
        p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  obtain ⟨i, hij, hpar, hplayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      G p hsupp
  have hab : a ≠ b := by
    intro hab
    have hnil : p.Nil := hp.nil_iff_eq.mpr hab
    have hzero : p.length = 0 := hnil.length_eq_zero
    omega
  obtain ⟨ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_bfsLayer G hconn
      (hplayer a (by simp)) (hplayer b (by simp)) hab hp hplayer hplen
  refine ⟨i, hij, hpar, ℓ, hcycle, hlow, ?_⟩
  exact hupp.trans (Nat.add_le_add_left (Nat.mul_le_mul_left 2 hij) _)

/-- Same-parity form of the connected parity-union closure.  Localization
puts the path in one actual BFS layer; connectedness supplies the two root
reachability witnesses, and the even root detour preserves the path parity. -/
theorem exists_same_parity_cycle_in_interval_of_path_in_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj] (hconn : G.Connected)
    {root : V} {j parity : ℕ} {a b : V} {p : G.Walk a b}
    (hp : p.IsPath)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion G root j parity)
    (hplen : 2 ≤ p.length) :
    ∃ i : ℕ, i ≤ j ∧ i % 2 = parity ∧
      ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
        p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j ∧
        ℓ % 2 = p.length % 2 := by
  obtain ⟨i, hij, hpar, hplayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      G p hsupp
  have hab : a ≠ b := by
    intro hab
    have hnil : p.Nil := hp.nil_iff_eq.mpr hab
    have hzero : p.length = 0 := hnil.length_eq_zero
    omega
  obtain ⟨ℓ, hcycle, hlow, hupp, hparity⟩ :=
    exists_same_parity_cycle_in_interval_of_path_in_bfsLayer_of_reachable G
      (hconn root a) (hconn root b)
      (hplayer a (by simp)) (hplayer b (by simp)) hab hp hplayer hplen
  refine ⟨i, hij, hpar, ℓ, hcycle, hlow, ?_, hparity⟩
  exact hupp.trans (Nat.add_le_add_left (Nat.mul_le_mul_left 2 hij) _)

/-- Positive-distance component-local form of the parity-union cycle
closure.  The positivity hypothesis excludes the junk zero distance of
vertices outside the root component, and therefore supplies exactly the
two reachability facts needed by the preceding component-local detour. -/
theorem exists_cycle_in_interval_of_path_in_parityBfsLayerUnion_of_positive_distance
    {V : Type*} [Fintype V] (G : SimpleGraph V)
    [DecidableRel G.Adj]
    {root : V} {j parity : ℕ} {a b : V} {p : G.Walk a b}
    (hp : p.IsPath)
    (hsupp : ∀ z ∈ p.support,
      z ∈ parityBfsLayerUnion G root j parity)
    (hpositive : ∀ z ∈ p.support, 0 < G.dist root z)
    (hplen : 2 ≤ p.length) :
    ∃ i : ℕ, 0 < i ∧ i ≤ j ∧ i % 2 = parity ∧
      ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
        p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  obtain ⟨i, hij, hpar, hplayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      G p hsupp
  have hipos : 0 < i := by
    have haPos := hpositive a (by simp)
    rw [hplayer a (by simp)] at haPos
    exact haPos
  have hab : a ≠ b := by
    intro hab
    have hnil : p.Nil := hp.nil_iff_eq.mpr hab
    have hzero : p.length = 0 := hnil.length_eq_zero
    omega
  have hroota : G.Reachable root a :=
    Reachable.of_dist_ne_zero (by rw [hplayer a (by simp)]; omega)
  have hrootb : G.Reachable root b :=
    Reachable.of_dist_ne_zero (by rw [hplayer b (by simp)]; omega)
  obtain ⟨ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_bfsLayer_of_reachable G
      hroota hrootb (hplayer a (by simp)) (hplayer b (by simp))
      hab hp hplayer hplen
  refine ⟨i, hipos, hij, hpar, ℓ, hcycle, hlow, ?_⟩
  exact hupp.trans (Nat.add_le_add_left (Nat.mul_le_mul_left 2 hij) _)

/-- Map-back from a path in an ambient induced core to the induced remaining
graph that supplied its BFS parity provenance.  Under the positive-distance
branch, the preceding component-local closure gives an ambient cycle with
the same interval bounds as the path in the core. -/
theorem exists_cycle_in_interval_of_path_in_mapped_parityBfsLayerUnion_of_positive_distance
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S H : Finset V} {root : S} {j : ℕ} {parity : Fin 2}
    (hHeq : H = (parityBfsLayerUnion (G.induce (S : Set V)) root j parity).map
      ⟨Subtype.val, Subtype.val_injective⟩)
    (hpositive : ∀ z ∈
      parityBfsLayerUnion (G.induce (S : Set V)) root j parity,
      0 < (G.induce (S : Set V)).dist root z)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  classical
  let J : SimpleGraph S := G.induce (S : Set V)
  have hHS : (H : Set V) ⊆ (S : Set V) := by
    intro v hv
    rw [hHeq] at hv
    rcases Finset.mem_map.mp hv with ⟨x, _hx, rfl⟩
    exact x.property
  let e : G.induce (H : Set V) ↪g J := G.induceHomOfLE hHS
  let q : J.Walk (e a) (e b) := p.map e.toHom
  have hqpath : q.IsPath := hp.map e.injective
  have hqsupp : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion J root j parity := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion J root j parity).map
          ⟨Subtype.val, Subtype.val_injective⟩ := by
      change (y : V) ∈
        (parityBfsLayerUnion (G.induce (S : Set V)) root j parity).map
          ⟨Subtype.val, Subtype.val_injective⟩
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, hx, hxval⟩
    have hxy : x = e y := by
      apply Subtype.ext
      exact hxval
    simpa [hxy] using hx
  have hpositiveJ : ∀ z ∈ parityBfsLayerUnion J root j parity,
      0 < J.dist root z := by
    simpa [J] using hpositive
  have hqlen : 2 ≤ q.length := by
    simpa [q] using hplen
  obtain ⟨_i, _hipos, _hij, _hpar, ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_parityBfsLayerUnion_of_positive_distance
      J hqpath hqsupp (fun z hz => hpositiveJ z (hqsupp z hz)) hqlen
  refine ⟨ℓ, hcycle.trans ?_, ?_, ?_⟩
  · exact (SimpleGraph.Embedding.induce (G := G) (S : Set V)).isContained
  · simpa [q] using hlow
  · simpa [q] using hupp

/-- Connected-component map-back.  When the induced remaining graph itself
is connected, no positivity side condition is needed: the connected parity
detour handles the root layer and all later layers uniformly. -/
theorem exists_cycle_in_interval_of_path_in_mapped_parityBfsLayerUnion_of_connected
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S H : Finset V} {root : S} {j : ℕ} {parity : Fin 2}
    (hconn : (G.induce (S : Set V)).Connected)
    (hHeq : H = (parityBfsLayerUnion (G.induce (S : Set V)) root j parity).map
      ⟨Subtype.val, Subtype.val_injective⟩)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  classical
  let J : SimpleGraph S := G.induce (S : Set V)
  have hHS : (H : Set V) ⊆ (S : Set V) := by
    intro v hv
    rw [hHeq] at hv
    rcases Finset.mem_map.mp hv with ⟨x, _hx, rfl⟩
    exact x.property
  let e : G.induce (H : Set V) ↪g J := G.induceHomOfLE hHS
  let q : J.Walk (e a) (e b) := p.map e.toHom
  have hqpath : q.IsPath := hp.map e.injective
  have hqsupp : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion J root j parity := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion J root j parity).map
          ⟨Subtype.val, Subtype.val_injective⟩ := by
      change (y : V) ∈
        (parityBfsLayerUnion (G.induce (S : Set V)) root j parity).map
          ⟨Subtype.val, Subtype.val_injective⟩
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, hx, hxval⟩
    have hxy : x = e y := by
      apply Subtype.ext
      exact hxval
    simpa [hxy] using hx
  have hconnJ : J.Connected := by simpa [J] using hconn
  have hqlen : 2 ≤ q.length := by
    simpa [q] using hplen
  obtain ⟨_i, _hij, _hpar, ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_parityBfsLayerUnion
      J hconnJ hqpath hqsupp hqlen
  refine ⟨ℓ, hcycle.trans ?_, ?_, ?_⟩
  · exact (SimpleGraph.Embedding.induce (G := G) (S : Set V)).isContained
  · simpa [q] using hlow
  · simpa [q] using hupp

/-- Path map-back for the corrected component witness.  The finite-map
equality supplies a canonical lift of every core vertex into the connected
component; mapping a core path through that lift lets the connected parity
detour close it, and the component embedding returns the cycle to G. -/
theorem exists_cycle_in_interval_of_path_in_component_mapped_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S H : Finset V}
    {c : (G.induce (S : Set V)).ConnectedComponent}
    {root : c} {j : ℕ} {parity : Fin 2}
    (hHeq : H = (parityBfsLayerUnion c.toSimpleGraph root j parity).map
      ⟨fun x => x.1.1, by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)⟩)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  classical
  let K : SimpleGraph c := c.toSimpleGraph
  have hpre : ∀ y : H, ∃ x : c, x.1.1 = y.1 := by
    intro y
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion c.toSimpleGraph root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, _hx, hxval⟩
    exact ⟨x, hxval⟩
  let lift : H → c := fun y => Classical.choose (hpre y)
  have hliftval : ∀ y : H, (lift y).1.1 = y.1 := by
    intro y
    exact Classical.choose_spec (hpre y)
  let e : G.induce (H : Set V) ↪g K :=
    { toFun := lift
      inj' := by
        intro x y hxy
        apply Subtype.ext
        calc
          x.1 = (lift x).1.1 := (hliftval x).symm
          _ = (lift y).1.1 := by rw [hxy]
          _ = y.1 := hliftval y
      map_rel_iff' := by
        intro x y
        change G.Adj (lift x).1.1 (lift y).1.1 ↔ G.Adj x.1 y.1
        simp [hliftval x, hliftval y] }
  let q : K.Walk (e a) (e b) := p.map e.toHom
  have hqpath : q.IsPath := hp.map e.injective
  have hqsupp : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion K root j parity := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion K root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      change (y : V) ∈
        (parityBfsLayerUnion c.toSimpleGraph root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, hx, hxval⟩
    have hxy : x = e y := by
      apply Subtype.ext
      apply Subtype.ext
      calc
        x.1.1 = y.1 := hxval
        _ = (lift y).1.1 := (hliftval y).symm
    simpa [hxy] using hx
  have hKconn : K.Connected := by
    simpa [K] using c.connected_toSimpleGraph
  have hqlen : 2 ≤ q.length := by
    simpa [q] using hplen
  obtain ⟨_i, _hij, _hpar, ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_parityBfsLayerUnion
      K hKconn hqpath hqsupp hqlen
  let f : K ↪g G :=
    { toFun := fun x => x.1.1
      inj' := by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)
      map_rel_iff' := by
        intro x y
        rfl }
  refine ⟨ℓ, hcycle.trans f.isContained, ?_, ?_⟩
  · simpa [q] using hlow
  · simpa [q] using hupp

