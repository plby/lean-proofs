  have hRR : (0 : ℝ) < R := by exact_mod_cast hR
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hratio : (1 : ℝ) / R ≤ (δ : ℝ) / k := by
    apply (le_div_iff₀ hkR).2
    have hkδR : (k : ℝ) ≤ R * δ := by exact_mod_cast hkδ
    have hstep : (k : ℝ) / R ≤ δ := (div_le_iff₀ hRR).2 (by
      simpa [mul_comm] using hkδR)
    simpa [one_div, div_eq_mul_inv, mul_comm, mul_left_comm,
      mul_assoc] using hstep
  have hratio10 : (((1 : ℝ) / R) ^ 2) ^ 10 ≤
      (((δ : ℝ) / k) ^ 2) ^ 10 := by
    gcongr
  have hkm : k ≤ R * m := hkδ.trans (Nat.mul_le_mul_left R hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ R * m := by
    exact_mod_cast hs2k.trans hkm
  have hslarge : 18 * R ^ 21 ≤ s := by simpa [s] using hsqrt
  have hbase : (18 : ℝ) * s ≤ (s : ℝ) ^ 2 / (R : ℝ) ^ 21 := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < (R : ℝ) ^ 21)).2
    have hslargeR : (18 : ℝ) * (R : ℝ) ^ 21 ≤ s := by
      exact_mod_cast hslarge
    have hsnonneg : (0 : ℝ) ≤ s := by positivity
    nlinarith [mul_le_mul_of_nonneg_right hslargeR hsnonneg]
  have hlow : (18 : ℝ) * s ≤
      (((δ : ℝ) / k) ^ 2) ^ 10 * m := by
    calc
      (18 : ℝ) * s ≤ (s : ℝ) ^ 2 / (R : ℝ) ^ 21 := hbase
      _ = (((1 : ℝ) / R) ^ 2) ^ 10 * ((s : ℝ) ^ 2 / R) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 10 * m := by
        have hsm : (s : ℝ) ^ 2 / R ≤ m := (div_le_iff₀ hRR).2 (by
          simpa [mul_comm] using hs2m)
        gcongr
  have hsnonneg : (0 : ℝ) ≤ s := by positivity
  have hxnonneg : (0 : ℝ) ≤ (((δ : ℝ) / k) ^ 2) ^ 10 * m := by
    positivity
  change ((9 * s : ℕ) : ℝ) ^ 2 ≤ _
  push_cast
  nlinarith [sq_nonneg
    (((((δ : ℝ) / k) ^ 2) ^ 10 * m) - (18 : ℝ) * s)]

/-- Linear-core form of the exponent-ten DRC estimate.  The fixed density
ratio contributes `64⁻²⁰`, and the support lower bound contributes the
last factor `64⁻¹`.  Thus the common-neighbour sample itself has order at
least `k / 64²¹`; after the harmless factor two used by the squared DRC
inequality, `floor (k / (2 * 64²¹))` is a valid core lower bound.  Unlike the
square-root specialization above, this retains the linear core required by
the source-scale class-transversal argument. -/
theorem div_two_mul_64_pow21_sq_le_density_ten_mul_card_sq_div_two
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m) :
    ((k / (2 * 64 ^ 21) : ℕ) : ℝ) ^ 2 ≤
      (((((δ : ℝ) / k) ^ 2) ^ 10) * m) ^ 2 / 2 := by
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio10 : (((1 : ℝ) / 64) ^ 2) ^ 10 ≤
      (((δ : ℝ) / k) ^ 2) ^ 10 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hkmR : (k : ℝ) / 64 ≤ m := by
    have hkmR' : (k : ℝ) ≤ 64 * m := by exact_mod_cast hkm
    nlinarith
  have hlow : (k : ℝ) / 64 ^ 21 ≤
      (((δ : ℝ) / k) ^ 2) ^ 10 * m := by
    calc
      (k : ℝ) / 64 ^ 21 =
          (((1 : ℝ) / 64) ^ 2) ^ 10 * ((k : ℝ) / 64) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 10 * m := by gcongr
  have hdivmul : (k / (2 * 64 ^ 21)) * (2 * 64 ^ 21) ≤ k :=
    Nat.div_mul_le_self k (2 * 64 ^ 21)
  have hτk : ((k / (2 * 64 ^ 21) : ℕ) : ℝ) ≤
      (k : ℝ) / (2 * 64 ^ 21) := by
    have hdivmulR : ((k / (2 * 64 ^ 21) : ℕ) : ℝ) *
        (2 * 64 ^ 21) ≤ k := by exact_mod_cast hdivmul
    have hden : (0 : ℝ) < 2 * 64 ^ 21 := by positivity
    exact (le_div_iff₀ hden).2 (by simpa [mul_comm] using hdivmulR)
  have hτhalf : ((k / (2 * 64 ^ 21) : ℕ) : ℝ) ≤
      ((((δ : ℝ) / k) ^ 2) ^ 10 * m) / 2 := by
    calc
      ((k / (2 * 64 ^ 21) : ℕ) : ℝ) ≤
          (k : ℝ) / (2 * 64 ^ 21) := hτk
      _ = ((k : ℝ) / 64 ^ 21) / 2 := by ring
      _ ≤ ((((δ : ℝ) / k) ^ 2) ^ 10 * m) / 2 :=
        div_le_div_of_nonneg_right hlow (by norm_num)
  nlinarith [sq_nonneg
    (((((δ : ℝ) / k) ^ 2) ^ 10 * m) / 2 -
      ((k / (2 * 64 ^ 21) : ℕ) : ℝ))]

/-- Uniform threshold-three DRC pair estimate at the fixed 1/64 density
ratio.  A support has order at least its inherited minimum degree, hence at
least floor(sqrt k)^2/64 vertices; after multiplying by the fourth density
power and eta = 1/(floor(sqrt k)+1), this exceeds three once the square-root
threshold is large enough. -/
theorem three_le_inv_succ_sqrt_mul_density_four_mul_card
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m) (hmk : m ≤ k)
    (hsqrt : 3 * 64 ^ 5 + 1 ≤ Nat.sqrt k) :
    (3 : ℝ) ≤
      ((1 : ℝ) / (Nat.sqrt k + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  let s : ℕ := Nat.sqrt k
  let a : ℕ := s + 1
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio4 : (((1 : ℝ) / 64) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ 64 * m := by
    have hs2mN : s ^ 2 ≤ 64 * m := hs2k.trans hkm
    exact_mod_cast hs2mN
  have hsR : (3 * 64 ^ 5 + 1 : ℝ) ≤ s := by
    dsimp [s]
    exact_mod_cast hsqrt
  have haR : (0 : ℝ) < a := by
    dsimp [a]
    positivity
  have hthree : (3 : ℝ) ≤ (s : ℝ) ^ 2 / ((a : ℝ) * 64 ^ 5) := by
    apply (le_div_iff₀ (by positivity)).2
    dsimp [a]
    norm_num at hsR ⊢
    have hsRR : (3221225473 : ℝ) ≤ (s : ℝ) := by exact_mod_cast hsR
    have hbase : (3221225472 : ℝ) ≤ (s : ℝ) - 1 := by nlinarith
    have hmul := mul_le_mul_of_nonneg_right hbase
      (by positivity : (0 : ℝ) ≤ (s : ℝ) + 1)
    nlinarith
  calc
    (3 : ℝ) ≤ (s : ℝ) ^ 2 / ((a : ℝ) * 64 ^ 5) := hthree
    _ = ((1 : ℝ) / a) * (((1 : ℝ) / 64) ^ 2) ^ 2 *
        ((s : ℝ) ^ 2 / 64) := by ring
    _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      have hsm : (s : ℝ) ^ 2 / 64 ≤ m := by nlinarith
      gcongr
    _ = ((1 : ℝ) / (Nat.sqrt k + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by simp [a, s]

/-- Quantitative version of the preceding pair estimate: the DRC threshold
can be chosen on the square-root scale.  The same lower bound is at least
sqrt(k)/(2·64^5), because sqrt(k)+1 is at most twice sqrt(k). -/
theorem sqrt_div_two_mul_64_pow5_le_inv_succ_sqrt_mul_density_four_mul_card
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m) :
    ((Nat.sqrt k / (2 * 64 ^ 5) : ℕ) : ℝ) ≤
      ((1 : ℝ) / (Nat.sqrt k + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  let s : ℕ := Nat.sqrt k
  let a : ℕ := s + 1
  have hspos : 0 < s := by
    dsimp [s]
    exact Nat.sqrt_pos.mpr (by omega)
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio4 : (((1 : ℝ) / 64) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ 64 * m := by
    have hs2mN : s ^ 2 ≤ 64 * m := hs2k.trans hkm
    exact_mod_cast hs2mN
  have hdivmul : (s / (2 * 64 ^ 5)) * (2 * 64 ^ 5) ≤ s :=
    Nat.div_mul_le_self s (2 * 64 ^ 5)
  have hθR : ((s / (2 * 64 ^ 5) : ℕ) : ℝ) ≤
      (s : ℝ) / (2 * 64 ^ 5) := by
    have hdivmulR : ((s / (2 * 64 ^ 5) : ℕ) : ℝ) *
        (2 * 64 ^ 5) ≤ s := by exact_mod_cast hdivmul
    apply (le_div_iff₀ (by positivity)).2
    simpa [mul_comm] using hdivmulR
  have hratioMain : (s : ℝ) / (2 * 64 ^ 5) ≤
      (s : ℝ) ^ 2 / ((a : ℝ) * 64 ^ 5) := by
    have ha : (a : ℝ) ≤ 2 * s := by
      have haN : a ≤ 2 * s := by
        dsimp [a]
        omega
      exact_mod_cast haN
    apply (div_le_div_iff₀ (by positivity) (by positivity)).2
    dsimp [a] at ha ⊢
    have hmul := mul_le_mul_of_nonneg_right ha
      (by positivity : (0 : ℝ) ≤ (s : ℝ) * 64 ^ 5)
    convert hmul using 1 <;> ring
  calc
    ((Nat.sqrt k / (2 * 64 ^ 5) : ℕ) : ℝ) =
        ((s / (2 * 64 ^ 5) : ℕ) : ℝ) := by rfl
    _ ≤ (s : ℝ) / (2 * 64 ^ 5) := hθR
    _ ≤ (s : ℝ) ^ 2 / ((a : ℝ) * 64 ^ 5) := hratioMain
    _ = ((1 : ℝ) / a) * (((1 : ℝ) / 64) ^ 2) ^ 2 *
        ((s : ℝ) ^ 2 / 64) := by ring
    _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      have hsm : (s : ℝ) ^ 2 / 64 ≤ m := by nlinarith
      gcongr
    _ = ((1 : ℝ) / (Nat.sqrt k + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by simp [a, s]

/-- Parameterized square-root DRC pair estimate.  If k ≤ Rδ and δ ≤ m,
then the density ratio is at least 1/R and a support of order m carries a
pair threshold floor(sqrt(k)/(2R^5)) for the same eta choice. -/
theorem sqrt_div_two_mul_pow5_le_inv_succ_sqrt_mul_density_four_mul_card_of_ratio
    {R k δ m : ℕ} (hR : 0 < R) (hk : 0 < k)
    (hkδ : k ≤ R * δ) (hδm : δ ≤ m) :
    ((Nat.sqrt k / (2 * R ^ 5) : ℕ) : ℝ) ≤
      ((1 : ℝ) / (Nat.sqrt k + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  let s : ℕ := Nat.sqrt k
  let a : ℕ := s + 1
  have hspos : 0 < s := by
    dsimp [s]
    exact Nat.sqrt_pos.mpr hk
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hratio : (1 : ℝ) / R ≤ (δ : ℝ) / k := by
    apply (le_div_iff₀ hkR).2
    have hkδR : (k : ℝ) ≤ R * δ := by exact_mod_cast hkδ
    have hRR : (0 : ℝ) < R := by exact_mod_cast hR
    rw [show (1 : ℝ) / R * k = (k : ℝ) / R by ring]
    apply (div_le_iff₀ hRR).2
    calc
      (k : ℝ) ≤ R * δ := hkδR
      _ = δ * R := by ring
  have hratio4 : (((1 : ℝ) / R) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkm : k ≤ R * m := hkδ.trans (Nat.mul_le_mul_left R hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ R * m := by
    have hs2mN : s ^ 2 ≤ R * m := hs2k.trans hkm
    exact_mod_cast hs2mN
  have hdivmul : (s / (2 * R ^ 5)) * (2 * R ^ 5) ≤ s :=
    Nat.div_mul_le_self s (2 * R ^ 5)
  have hθR : ((s / (2 * R ^ 5) : ℕ) : ℝ) ≤
      (s : ℝ) / (2 * R ^ 5) := by
    have hdivmulR : ((s / (2 * R ^ 5) : ℕ) : ℝ) *
        (2 * R ^ 5) ≤ s := by exact_mod_cast hdivmul
    apply (le_div_iff₀ (by positivity)).2
    simpa [mul_comm] using hdivmulR
  have hratioMain : (s : ℝ) / (2 * R ^ 5) ≤
      (s : ℝ) ^ 2 / ((a : ℝ) * R ^ 5) := by
    have ha : (a : ℝ) ≤ 2 * s := by
      have haN : a ≤ 2 * s := by
        dsimp [a]
        omega
      exact_mod_cast haN
    apply (div_le_div_iff₀ (by positivity) (by positivity)).2
    dsimp [a] at ha ⊢
    have hmul := mul_le_mul_of_nonneg_right ha
      (by positivity : (0 : ℝ) ≤ (s : ℝ) * R ^ 5)
    convert hmul using 1 <;> ring
  calc
    ((Nat.sqrt k / (2 * R ^ 5) : ℕ) : ℝ) =
        ((s / (2 * R ^ 5) : ℕ) : ℝ) := by rfl
    _ ≤ (s : ℝ) / (2 * R ^ 5) := hθR
    _ ≤ (s : ℝ) ^ 2 / ((a : ℝ) * R ^ 5) := hratioMain
    _ = ((1 : ℝ) / a) * (((1 : ℝ) / R) ^ 2) ^ 2 *
        ((s : ℝ) ^ 2 / R) := by ring
    _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      have hsm : (s : ℝ) ^ 2 / R ≤ m := by
        have hRR : (0 : ℝ) < R := by exact_mod_cast hR
        apply (div_le_iff₀ hRR).2
        nlinarith
      gcongr
    _ = ((1 : ℝ) / (Nat.sqrt k + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by simp [a, s]

/-- Uniform tau-one DRC reservoir estimate for exponent six.  The sixth
power of the fixed density ratio is 1/64^12, and the support lower bound
contributes another factor k/64; once sqrt k dominates 64^13, the resulting
expected common-neighbour scale is already at least two. -/
theorem one_sq_le_density_six_mul_card_sq_div_two
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m)
    (hsqrt : 2 * 64 ^ 13 ≤ Nat.sqrt k) :
    (1 : ℝ) ^ 2 ≤
      (((((δ : ℝ) / k) ^ 2) ^ 6) * m) ^ 2 / 2 := by
  let s : ℕ := Nat.sqrt k
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio6 : (((1 : ℝ) / 64) ^ 2) ^ 6 ≤
      (((δ : ℝ) / k) ^ 2) ^ 6 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ 64 * m := by
    have hs2mN : s ^ 2 ≤ 64 * m := hs2k.trans hkm
    exact_mod_cast hs2mN
  have hsR : (2 * 64 ^ 13 : ℝ) ≤ s := by
    dsimp [s]
    exact_mod_cast hsqrt
  have hbase : (2 : ℝ) ≤
      (((1 : ℝ) / 64) ^ 2) ^ 6 * ((s : ℝ) ^ 2 / 64) := by
    have hpos : (0 : ℝ) < 64 ^ 13 := by positivity
    calc
      (2 : ℝ) ≤ (s : ℝ) ^ 2 / 64 ^ 13 := by
        apply (le_div_iff₀ hpos).2
        nlinarith
      _ = (((1 : ℝ) / 64) ^ 2) ^ 6 * ((s : ℝ) ^ 2 / 64) := by ring
  have hlow : (2 : ℝ) ≤ (((δ : ℝ) / k) ^ 2) ^ 6 * m := by
    have hsm : (s : ℝ) ^ 2 / 64 ≤ m := by nlinarith
    exact hbase.trans (by gcongr)
  nlinarith [sq_nonneg ((((δ : ℝ) / k) ^ 2) ^ 6 * m - 2)]

/-- Linear reservoir-size version of the same exponent-six estimate.  The
common-neighbour scale is at least k/64^13, so half that scale is a valid
integer DRC lower bound after squaring and dividing by two. -/
theorem div_two_mul_64_pow13_sq_le_density_six_mul_card_sq_div_two
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m) :
    ((k / (2 * 64 ^ 13) : ℕ) : ℝ) ^ 2 ≤
      (((((δ : ℝ) / k) ^ 2) ^ 6) * m) ^ 2 / 2 := by
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio6 : (((1 : ℝ) / 64) ^ 2) ^ 6 ≤
      (((δ : ℝ) / k) ^ 2) ^ 6 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hkmR : (k : ℝ) / 64 ≤ m := by
    have hkmR' : (k : ℝ) ≤ 64 * m := by exact_mod_cast hkm
    nlinarith
  have hlow : (k : ℝ) / 64 ^ 13 ≤
      (((δ : ℝ) / k) ^ 2) ^ 6 * m := by
    calc
      (k : ℝ) / 64 ^ 13 =
          (((1 : ℝ) / 64) ^ 2) ^ 6 * ((k : ℝ) / 64) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 6 * m := by gcongr
  have hdivmul : (k / (2 * 64 ^ 13)) * (2 * 64 ^ 13) ≤ k :=
    Nat.div_mul_le_self k (2 * 64 ^ 13)
  have hτk : ((k / (2 * 64 ^ 13) : ℕ) : ℝ) ≤
      (k : ℝ) / (2 * 64 ^ 13) := by
    have hdivmulR : ((k / (2 * 64 ^ 13) : ℕ) : ℝ) *
        (2 * 64 ^ 13) ≤ k := by exact_mod_cast hdivmul
    have hden : (0 : ℝ) < 2 * 64 ^ 13 := by positivity
    exact (le_div_iff₀ hden).2 (by simpa [mul_comm] using hdivmulR)
  have hxnonneg : (0 : ℝ) ≤ (((δ : ℝ) / k) ^ 2) ^ 6 * m := by positivity
  have hτnonneg : (0 : ℝ) ≤ ((k / (2 * 64 ^ 13) : ℕ) : ℝ) := by positivity
  have hτhalf : ((k / (2 * 64 ^ 13) : ℕ) : ℝ) ≤
      ((((δ : ℝ) / k) ^ 2) ^ 6 * m) / 2 := by
    calc
      ((k / (2 * 64 ^ 13) : ℕ) : ℝ) ≤
          (k : ℝ) / (2 * 64 ^ 13) := hτk
      _ = ((k : ℝ) / 64 ^ 13) / 2 := by ring
      _ ≤ ((((δ : ℝ) / k) ^ 2) ^ 6 * m) / 2 :=
        div_le_div_of_nonneg_right hlow (by norm_num)
  nlinarith [sq_nonneg
    (((((δ : ℝ) / k) ^ 2) ^ 6 * m) / 2 -
      ((k / (2 * 64 ^ 13) : ℕ) : ℝ))]

/-- Parameterized linear reservoir estimate.  Under k ≤ Rδ ≤ Rm, the
exponent-six common-neighbour scale is at least k/R^13, so
floor(k/(2R^13)) is a valid DRC reservoir lower bound. -/
theorem div_two_mul_pow13_sq_le_density_six_mul_card_sq_div_two_of_ratio
    {R k δ m : ℕ} (hR : 0 < R) (hk : 0 < k)
    (hkδ : k ≤ R * δ) (hδm : δ ≤ m) :
    ((k / (2 * R ^ 13) : ℕ) : ℝ) ^ 2 ≤
      (((((δ : ℝ) / k) ^ 2) ^ 6) * m) ^ 2 / 2 := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hratio : (1 : ℝ) / R ≤ (δ : ℝ) / k := by
    apply (le_div_iff₀ hkR).2
    have hkδR : (k : ℝ) ≤ R * δ := by exact_mod_cast hkδ
    have hRR : (0 : ℝ) < R := by exact_mod_cast hR
    rw [show (1 : ℝ) / R * k = (k : ℝ) / R by ring]
    apply (div_le_iff₀ hRR).2
    calc
      (k : ℝ) ≤ R * δ := hkδR
      _ = δ * R := by ring
  have hratio6 : (((1 : ℝ) / R) ^ 2) ^ 6 ≤
      (((δ : ℝ) / k) ^ 2) ^ 6 := by
    gcongr
  have hkm : k ≤ R * m := hkδ.trans (Nat.mul_le_mul_left R hδm)
  have hkmR : (k : ℝ) / R ≤ m := by
    have hkmR' : (k : ℝ) ≤ R * m := by exact_mod_cast hkm
    have hRR : (0 : ℝ) < R := by exact_mod_cast hR
    apply (div_le_iff₀ hRR).2
    nlinarith
  have hlow : (k : ℝ) / R ^ 13 ≤
      (((δ : ℝ) / k) ^ 2) ^ 6 * m := by
    calc
      (k : ℝ) / R ^ 13 =
          (((1 : ℝ) / R) ^ 2) ^ 6 * ((k : ℝ) / R) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 6 * m := by gcongr
  have hdivmul : (k / (2 * R ^ 13)) * (2 * R ^ 13) ≤ k :=
    Nat.div_mul_le_self k (2 * R ^ 13)
  have hτk : ((k / (2 * R ^ 13) : ℕ) : ℝ) ≤
      (k : ℝ) / (2 * R ^ 13) := by
    have hdivmulR : ((k / (2 * R ^ 13) : ℕ) : ℝ) *
        (2 * R ^ 13) ≤ k := by exact_mod_cast hdivmul
    have hden : (0 : ℝ) < 2 * R ^ 13 := by positivity
    exact (le_div_iff₀ hden).2 (by simpa [mul_comm] using hdivmulR)
  have hxnonneg : (0 : ℝ) ≤ (((δ : ℝ) / k) ^ 2) ^ 6 * m := by positivity
  have hτnonneg : (0 : ℝ) ≤ ((k / (2 * R ^ 13) : ℕ) : ℝ) := by positivity
  have hτhalf : ((k / (2 * R ^ 13) : ℕ) : ℝ) ≤
      ((((δ : ℝ) / k) ^ 2) ^ 6 * m) / 2 := by
    calc
      ((k / (2 * R ^ 13) : ℕ) : ℝ) ≤
          (k : ℝ) / (2 * R ^ 13) := hτk
      _ = ((k : ℝ) / R ^ 13) / 2 := by ring
      _ ≤ ((((δ : ℝ) / k) ^ 2) ^ 6 * m) / 2 :=
        div_le_div_of_nonneg_right hlow (by norm_num)
  nlinarith [sq_nonneg
    (((((δ : ℝ) / k) ^ 2) ^ 6 * m) / 2 -
      ((k / (2 * R ^ 13) : ℕ) : ℝ))]

/-- A dense corrected BFS core contains a long induced path and an ambient
cycle interval. -/
theorem exists_path_and_cycle_interval_of_dense_component_bfs_core
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H D : Finset V} (hcore : IsComponentBfsParityCore G H D)
    (hHne : H.Nonempty) {d r : ℕ} (hr : 2 ≤ r) (hdr : 2 * r ≤ d)
    (hdense : d * H.card ≤ 2 * (inducedEdgeFinsetOn G H).card) :
    ∃ a b : H, ∃ p : (G.induce (H : Set V)).Walk a b,
      p.IsPath ∧ r ≤ p.length ∧
      ∃ j ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
        p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  classical
  let K : SimpleGraph H := G.induce (H : Set V)
  let : Nonempty H := hHne.to_subtype
  have hedge :
      (inducedEdgeFinsetOn G H).card = K.edgeFinset.card := by
    simpa [K] using card_inducedEdgeFinsetOn_eq_card_induce_finset G H
  have htwice : 2 * (r * H.card) ≤
      2 * (inducedEdgeFinsetOn G H).card := by
    calc
      2 * (r * H.card) = (2 * r) * H.card := by ring
      _ ≤ d * H.card := Nat.mul_le_mul_right _ hdr
      _ ≤ 2 * (inducedEdgeFinsetOn G H).card := hdense
  have hdenseK : r * Fintype.card H ≤ K.edgeFinset.card := by
    rw [Fintype.card_coe, ← hedge]
    omega
  have hpath :
      ∃ a b : H, ∃ p : K.Walk a b, p.IsPath ∧ r ≤ p.length := by
    by_contra hno
    have hlt := card_edgeFinset_lt_mul_card_of_no_long_path K r hno
    omega
  obtain ⟨a, b, p, hp, hplen⟩ := hpath
  obtain ⟨j, ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_component_bfs_core G hcore hp
      (hr.trans hplen)
  exact ⟨a, b, p, hp, hplen, j, ℓ, hcycle, hlow, hupp⟩

/-- At extremal order, the corrected second BFS pass yields a path on the
explicit k/8 scale together with a controlled ambient cycle interval. -/
theorem exists_long_path_and_cycle_interval_at_extremal_order
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hk : 21 ≤ k) (hn : 2 ≤ n) (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1) :
    ∃ H D : Finset V, IsComponentBfsParityCore G H D ∧
      ∃ a b : H, ∃ p : (G.induce (H : Set V)).Walk a b,
        p.IsPath ∧ ((k - 1) / 4 - 1) / 2 ≤ p.length ∧
        ∃ j ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
          p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  let d : ℕ := (k - 1) / 4 - 1
  let r : ℕ := d / 2
  have hr : 2 ≤ r := by
    dsimp [r, d]
    omega
  have hdr : 2 * r ≤ d := by
    dsimp [r]
    exact Nat.mul_div_le d 2
  obtain ⟨H, D, hHne, hdense, hcore⟩ :=
    exists_dense_global_component_bfs_core_at_extremal_order
      G (by omega) hn hfree horder
  obtain ⟨a, b, p, hp, hplen, j, ℓ, hcycle, hlow, hupp⟩ :=
    exists_path_and_cycle_interval_of_dense_component_bfs_core
      G hcore hHne hr hdr (by simpa [d] using hdense)
  exact ⟨H, D, hcore, a, b, p, hp, by simpa [r, d] using hplen,
    j, ℓ, hcycle, hlow, hupp⟩

/-- Diagonal-range refinement of the preceding handoff: the detour overhead
is explicitly logarithmic in k. -/
theorem exists_long_path_and_logarithmic_cycle_interval_at_extremal_order
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {k n : ℕ}
    (hk : 21 ≤ k) (hn : 2 ≤ n) (hnk : n ≤ k)
    (hfree : G.IndepSetFree n)
    (horder : Fintype.card V = (k - 1) * (n - 1) + 1) :
    ∃ H D : Finset V, IsComponentBfsParityCore G H D ∧
      ∃ a b : H, ∃ p : (G.induce (H : Set V)).Walk a b,
        p.IsPath ∧ ((k - 1) / 4 - 1) / 2 ≤ p.length ∧
        ∃ j ℓ : ℕ, j ≤ 2 * (Nat.log 2 k + 1) ∧
          cycleGraph ℓ ⊑ G ∧ p.length + 1 ≤ ℓ ∧
          ℓ ≤ p.length + 2 * j := by
  obtain ⟨H, D, hcore, a, b, p, hp, hplen, _j, _ℓ,
      _hcycle, _hlow, _hupp⟩ :=
    exists_long_path_and_cycle_interval_at_extremal_order G hk hn hfree horder
  obtain ⟨j, ℓ, hjV, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_component_bfs_core_with_radius_bound
      G hcore hp (by omega)
  have hjorder : j ≤ Nat.log 2 ((k - 1) * (n - 1) + 1) := by
    rw [← horder]
    exact hjV
  have hjk : j ≤ 2 * (Nat.log 2 k + 1) :=
    hjorder.trans (log_extremal_order_le_two_mul_log_add_one (by omega) hnk)
  exact ⟨H, D, hcore, a, b, p, hp, hplen, j, ℓ, hjk,
    hcycle, hlow, hupp⟩

/-- The Pósa alternative in the exact finite form used by the fixed-parameter
KLS extraction: either a start reaches the requested length, or a bounded
vertex set already carries quadratic edge mass. -/
theorem hasPathFromAtLeast_or_exists_short_dense_support
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (x : V) (D : ℕ) :
    HasPathFromAtLeast G x D ∨
      ∃ S : Finset V, S.Nonempty ∧ S.card ≤ D ∧
        G.minDegree * G.minDegree ≤
          2 * (inducedEdgeFinsetOn G S).card := by
  by_cases h : HasPathFromAtLeast G x D
  · exact Or.inl h
  · exact Or.inr (exists_short_dense_support_of_no_long_path G x D h)

/-- A short support with quadratic edge mass has a canonical DRC density:
if its order is at most D and its edge mass is at least delta squared, then
rho = (delta / D)^2 is a valid induced-density parameter. -/
theorem drc_density_of_short_dense_support
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {δ D : ℕ} (hδ : 0 < δ) (hD : 0 < D)
    (hSle : S.card ≤ D)
    (hmass : δ * δ ≤ 2 * (inducedEdgeFinsetOn G S).card) :
    let ρ : ℝ := ((δ : ℝ) / D) ^ 2
    0 < ρ ∧ ρ * Fintype.card S * Fintype.card S ≤
      2 * (G.induce (S : Set V)).edgeFinset.card := by
  classical
  let ρ : ℝ := ((δ : ℝ) / D) ^ 2
  have hδR : (0 : ℝ) < δ := by exact_mod_cast hδ
  have hDR : (0 : ℝ) < D := by exact_mod_cast hD
  have hSR : (S.card : ℝ) ≤ D := by exact_mod_cast hSle
  have hratio : (0 : ℝ) < (δ : ℝ) / D := div_pos hδR hDR
  have hratioS : (δ : ℝ) / D * S.card ≤ δ := by
    calc
      (δ : ℝ) / D * S.card ≤ (δ : ℝ) / D * D := by
        gcongr
      _ = δ := by field_simp
  have hsq : (((δ : ℝ) / D) * S.card) ^ 2 ≤ (δ : ℝ) ^ 2 := by
    exact (sq_le_sq₀ (by positivity) (by positivity)).2 hratioS
  have hmassR :
      (δ : ℝ) ^ 2 ≤ 2 * (inducedEdgeFinsetOn G S).card := by
    have hmassR' :
        (δ : ℝ) * δ ≤ 2 * (inducedEdgeFinsetOn G S).card := by
      exact_mod_cast hmass
    simpa [pow_two] using hmassR'
  have hedge :
      (inducedEdgeFinsetOn G S).card =
        (G.induce (S : Set V)).edgeFinset.card := by
    have hmap :
        (G.induce (S : Set V)).edgeFinset.map
          (Function.Embedding.subtype (· ∈ (S : Set V))).sym2Map =
          G.edgeFinset ∩ S.sym2 := by
      aesop (add simp [Finset.ext_iff, Sym2.exists, Sym2.forall, adj_comm])
    unfold inducedEdgeFinsetOn
    rw [← hmap]
    simp
  refine ⟨by positivity, ?_⟩
  calc
    ρ * Fintype.card S * Fintype.card S =
        (((δ : ℝ) / D) * S.card) ^ 2 := by
          simp only [ρ, Fintype.card_coe]
          ring
    _ ≤ (δ : ℝ) ^ 2 := hsq
    _ ≤ 2 * (inducedEdgeFinsetOn G S).card := hmassR
    _ = 2 * (G.induce (S : Set V)).edgeFinset.card := by rw [hedge]

/-- The short-dense alternative plugs directly into the already-verified
localized DRC extractor.  All remaining hypotheses are the three explicit
parameter inequalities; the graph-theoretic density clause is discharged by
the Pósa edge-mass estimate. -/
theorem exists_local_robustPairSet_of_short_dense_support
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {δ D θ t τ : ℕ}
    (hS : S.Nonempty) (hδ : 0 < δ) (hD : 0 < D) (hSle : S.card ≤ D)
    (hmass : δ * δ ≤ 2 * (inducedEdgeFinsetOn G S).card)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : (θ : ℝ) ≤ η * (((δ : ℝ) / D) ^ 2) ^ 2 * Fintype.card S)
    (hτ : (τ : ℝ) ^ 2 ≤
      (((((δ : ℝ) / D) ^ 2) ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    ∃ U : Finset V, τ ≤ U.card ∧ U ⊆ S ∧ RobustPairSet G U S θ := by
  let ρ : ℝ := ((δ : ℝ) / D) ^ 2
  obtain ⟨hρ, hdensity⟩ :=
    drc_density_of_short_dense_support G hδ hD hSle hmass
  apply exists_local_robustPairSet_of_induced_drc G hS ht hτpos hη hρ hdensity
  · simpa [ρ] using hθ
  · simpa [ρ] using hτ
  · simpa [ρ] using hsmall

/-- A short dense support in any graph embedded into the ambient Ramsey
graph produces an ambient local robust hub on its mapped vertex set.  Run
localized DRC before mapping, then transport the robust pair certificate
along the embedding. -/
theorem isLocalRobustHub_of_short_dense_support_under_embedding
    {V W : Type*} [Fintype V] [Fintype W]
    (G : SimpleGraph V) (K : SimpleGraph W)
    [DecidableRel G.Adj] [DecidableRel K.Adj]
    (e : K ↪g G) {S : Finset W} {δ D θ t τ : ℕ}
    (hS : S.Nonempty) (hδ : 0 < δ) (hD : 0 < D) (hSle : S.card ≤ D)
    (hmass : δ * δ ≤ 2 * (inducedEdgeFinsetOn K S).card)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : (θ : ℝ) ≤ η * (((δ : ℝ) / D) ^ 2) ^ 2 * Fintype.card S)
    (hτ : (τ : ℝ) ^ 2 ≤
      (((((δ : ℝ) / D) ^ 2) ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    IsLocalRobustHub G θ τ (S.map ⟨e, e.injective⟩) := by
  obtain ⟨U, hUcard, hUS, hrob⟩ :=
    exists_local_robustPairSet_of_short_dense_support K hS hδ hD hSle hmass
      ht hτpos hη hθ hτ hsmall
  let f : W ↪ V := ⟨e, e.injective⟩
  refine ⟨U.map f, ?_, ?_, ?_⟩
  · simpa [f] using hUcard
  · intro v hv
    rcases Finset.mem_map.mp hv with ⟨u, hu, rfl⟩
    exact Finset.mem_map.mpr ⟨u, hUS hu, rfl⟩
  · simpa [f] using RobustPairSet.map_embedding e hrob

/-- Injective-hom version of the preceding bridge.  It is the precise form
needed for a low-degree-deletion core: deleted edges do not hurt DRC inside
the core, and mapping the resulting common neighbours into the ambient graph
preserves every robust-pair lower bound. -/
theorem isLocalRobustHub_of_short_dense_support_under_injective_hom
    {V W : Type*} [Fintype V] [Fintype W]
    (G : SimpleGraph V) (K : SimpleGraph W)
    [DecidableRel G.Adj] [DecidableRel K.Adj]
    (e : K →g G) (he : Function.Injective e)
    {S : Finset W} {δ D θ t τ : ℕ}
    (hS : S.Nonempty) (hδ : 0 < δ) (hD : 0 < D) (hSle : S.card ≤ D)
    (hmass : δ * δ ≤ 2 * (inducedEdgeFinsetOn K S).card)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : (θ : ℝ) ≤ η * (((δ : ℝ) / D) ^ 2) ^ 2 * Fintype.card S)
    (hτ : (τ : ℝ) ^ 2 ≤
      (((((δ : ℝ) / D) ^ 2) ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : 2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    IsLocalRobustHub G θ τ (S.map ⟨e, he⟩) := by
  obtain ⟨U, hUcard, hUS, hrob⟩ :=
    exists_local_robustPairSet_of_short_dense_support K hS hδ hD hSle hmass
      ht hτpos hη hθ hτ hsmall
  let f : W ↪ V := ⟨e, he⟩
  refine ⟨U.map f, ?_, ?_, ?_⟩
  · simpa [f] using hUcard
  · intro v hv
    rcases Finset.mem_map.mp hv with ⟨u, hu, rfl⟩
    exact Finset.mem_map.mpr ⟨u, hUS hu, rfl⟩
  · simpa [f] using RobustPairSet.map_injective_hom e he hrob

/-- Greedy-extraction form of the two-pass KLS dense-to-hub step.  Apply the
large-set package to the graph induced by an arbitrary remaining set S,
transport its short dense minimum-degree core back to the ambient graph, and
obtain a local robust-hub region still contained in S.  Only the uniform
cardinal numerical DRC estimates remain as explicit hypotheses. -/
theorem exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {S : Finset V} {n d k θ t τ : ℕ}
    (hn : 2 ≤ n) (hd : 0 < d) (hfree : G.IndepSetFree n)
    (hSsize : 16 * ((n - 1) * (d + 1)) ≤ S.card)
    (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : ∀ δ m : ℕ, d ≤ 2 * δ → δ ≤ m → m ≤ k →
      (θ : ℝ) ≤ η * (((δ : ℝ) / k) ^ 2) ^ 2 * m)
    (hτ : ∀ δ m : ℕ, d ≤ 2 * δ → δ ≤ m → m ≤ k →
      (τ : ℝ) ^ 2 ≤
        (((((δ : ℝ) / k) ^ 2) ^ t) * m) ^ 2 / 2)
    (hsmall : ∀ m : ℕ, 1 ≤ m → m ≤ k →
      2 * η ^ t < (1 : ℝ) / (m : ℝ) ^ 2) :
    ∃ R : Finset V, R ⊆ S ∧ R.card ≤ k ∧
      IsLocalRobustHub G θ τ R := by
  classical
  have hSpos : 0 < S.card := by
    have hnpos : 0 < n - 1 := by omega
    have hdpos : 0 < d + 1 := by omega
    have : 0 < 16 * ((n - 1) * (d + 1)) := by positivity
    omega
  let : Nonempty S := (Finset.card_pos.mp hSpos).to_subtype
  let J : SimpleGraph S := G.induce (S : Set V)
  have hJfree : J.IndepSetFree n := by
    simpa [J] using Erdos551.IndepSetFree.induce hfree S
  have hJsize : 16 * ((n - 1) * (d + 1)) ≤ Fintype.card S := by
    simpa using hSsize
  have hcardS : Fintype.card S ≤ Fintype.card V := by
    simpa using Finset.card_le_univ S
  have hlogS : Nat.log 2 (Fintype.card S) ≤ Nat.log 2 (Fintype.card V) :=
    Nat.log_mono_right hcardS
  have hroomJ : 3 * Nat.log 2 (Fintype.card S) + 1 ≤ k := by
    omega
  have hcycleJ : ¬ cycleGraph k ⊑ J := by
    intro hcopy
    apply hcycle
    exact hcopy.trans (SimpleGraph.Embedding.induce (G := G) (S : Set V)).isContained
  obtain ⟨H₁, H, instH, hne, hHJ, hmin, hshort⟩ :=
    exists_short_dense_minDegree_core_of_large_indepSetFree_cycleFree
      J hn hd hJfree hJsize hk hroomJ hcycleJ
  let C : SimpleGraph H.support := H.induce H.support
  let : Nonempty H.support := hne.to_subtype
  let x : H.support := Classical.choice inferInstance
  obtain ⟨T, hT, hδT, hTle, hmass⟩ := hshort x
  change d ≤ 2 * C.minDegree at hmin
  change C.minDegree ≤ T.card at hδT
  change C.minDegree * C.minDegree ≤
    2 * (inducedEdgeFinsetOn C T).card at hmass
  let e₀ : C ↪g H := SimpleGraph.Embedding.induce H.support
  let e₁ : H →g J.induce (H₁ : Set S) := SimpleGraph.Hom.ofLE hHJ
  let e₂ : J.induce (H₁ : Set S) ↪g J :=
    SimpleGraph.Embedding.induce (G := J) (H₁ : Set S)
  let e₃ : J ↪g G := SimpleGraph.Embedding.induce (G := G) (S : Set V)
  let e : C →g G := e₃.toHom.comp (e₂.toHom.comp (e₁.comp e₀.toHom))
  have he : Function.Injective e := by
    intro a b hab
    apply e₀.injective
    apply e₂.injective
    apply e₃.injective
    simpa [e, e₁] using hab
  have hδ : 0 < C.minDegree := by
    by_contra hnot
    have hzero : C.minDegree = 0 :=
      Nat.eq_zero_of_not_pos hnot
    have hmin0 : d ≤ 0 := by
      calc
        d ≤ 2 * C.minDegree := hmin
        _ = 0 := by simp [hzero]
    omega
  let R : Finset V := T.map ⟨e, he⟩
  have hRcard : R.card ≤ k := by
    simpa [R] using hTle
  have hRsub : R ⊆ S := by
    intro v hv
    rcases Finset.mem_map.mp hv with ⟨u, _hu, rfl⟩
    change ((e₂ (e₁ (e₀ u)) : S) : V) ∈ S
    exact (e₂ (e₁ (e₀ u))).property
  have hθ' : (θ : ℝ) ≤
      η * (((C.minDegree : ℝ) / k) ^ 2) ^ 2 * Fintype.card T := by
    simpa using hθ C.minDegree T.card hmin hδT hTle
  have hτ' : (τ : ℝ) ^ 2 ≤
      (((((C.minDegree : ℝ) / k) ^ 2) ^ t) * Fintype.card T) ^ 2 / 2 := by
    simpa using hτ C.minDegree T.card hmin hδT hTle
  have hsmall' : 2 * η ^ t < (1 : ℝ) / (Fintype.card T : ℝ) ^ 2 := by
    simpa using hsmall T.card hT.card_pos hTle
  have hhub : IsLocalRobustHub G θ τ R :=
    isLocalRobustHub_of_short_dense_support_under_injective_hom
      (δ := C.minDegree) (D := k)
      G C e he hT hδ (by omega : 0 < k) hTle hmass ht hτpos hη
        hθ' hτ' hsmall'
  exact ⟨R, hRsub, hRcard, hhub⟩

/-- Greedy two-pass KLS hub decomposition in the ambient graph.  Repeatedly
apply the preceding remaining-set extractor until fewer than the explicit
factor-sixteen cutoff vertices remain; the extracted local-hub regions are
pairwise disjoint and their union is contained in the original vertex set. -/
theorem exists_disjoint_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {n d k θ t τ : ℕ}
    (hn : 2 ≤ n) (hd : 0 < d) (hfree : G.IndepSetFree n)
    (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : ∀ δ m : ℕ, d ≤ 2 * δ → δ ≤ m → m ≤ k →
      (θ : ℝ) ≤ η * (((δ : ℝ) / k) ^ 2) ^ 2 * m)
    (hτ : ∀ δ m : ℕ, d ≤ 2 * δ → δ ≤ m → m ≤ k →
      (τ : ℝ) ^ 2 ≤
        (((((δ : ℝ) / k) ^ 2) ^ t) * m) ^ 2 / 2)
    (hsmall : ∀ m : ℕ, 1 ≤ m → m ≤ k →
      2 * η ^ t < (1 : ℝ) / (m : ℝ) ^ 2) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G θ τ H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (d + 1)) := by
  apply exists_disjoint_family_covering_up_to
    (fun H => IsLocalRobustHub G θ τ H)
    (16 * ((n - 1) * (d + 1)))
  intro S hSsize
  obtain ⟨R, hRS, _hRcard, hhub⟩ :=
    exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
      G hn hd hfree hSsize hk hroom hcycle ht hτpos hη hθ hτ hsmall
  have hRne : R.Nonempty := by
    rcases hhub with ⟨U, hUcard, hUR, _hrob⟩
    obtain ⟨u, hu⟩ := Finset.card_pos.mp (hτpos.trans_le hUcard)
    exact ⟨u, hUR hu⟩
  exact ⟨R, hRS, hRne, hhub⟩

/-- Bounded-region version of the greedy two-pass hub family.  The Pósa
support from which every hub is mapped has at most k vertices, so the
greedy family can retain this capacity invariant for the later stability
grouping rather than discarding it at extraction time. -/
theorem exists_disjoint_bounded_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {n d k θ t τ : ℕ}
    (hn : 2 ≤ n) (hd : 0 < d) (hfree : G.IndepSetFree n)
    (hk : 3 ≤ k)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : ∀ δ m : ℕ, d ≤ 2 * δ → δ ≤ m → m ≤ k →
      (θ : ℝ) ≤ η * (((δ : ℝ) / k) ^ 2) ^ 2 * m)
    (hτ : ∀ δ m : ℕ, d ≤ 2 * δ → δ ≤ m → m ≤ k →
      (τ : ℝ) ^ 2 ≤
        (((((δ : ℝ) / k) ^ 2) ^ t) * m) ^ 2 / 2)
    (hsmall : ∀ m : ℕ, 1 ≤ m → m ≤ k →
      2 * η ^ t < (1 : ℝ) / (m : ℝ) ^ 2) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G θ τ H ∧ H.card ≤ k) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (d + 1)) := by
  apply exists_disjoint_family_covering_up_to
    (fun H => IsLocalRobustHub G θ τ H ∧ H.card ≤ k)
    (16 * ((n - 1) * (d + 1)))
  intro S hSsize
  obtain ⟨R, hRS, hRcard, hhub⟩ :=
    exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
      G hn hd hfree hSsize hk hroom hcycle ht hτpos hη hθ hτ hsmall
  have hRne : R.Nonempty := by
    rcases hhub with ⟨U, hUcard, hUR, _hrob⟩
    obtain ⟨u, hu⟩ := Finset.card_pos.mp (hτpos.trans_le hUcard)
    exact ⟨u, hUR hu⟩
  exact ⟨R, hRS, hRne, hhub, hRcard⟩

/-- First fully instantiated two-pass DRC decomposition.  With exponent six,
eta = 1/(floor(sqrt k)+1), threshold three, and reservoir lower bound one,
the preceding fixed-ratio estimates discharge all numerical hypotheses once
sqrt k is above an explicit constant.  This is the short-handle hub family
used by the later interaction graph stage. -/
theorem exists_disjoint_threshold_three_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 2 * 64 ^ 13 ≤ Nat.sqrt k) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G 3 1 H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  have hsqrt3 : 3 * 64 ^ 5 + 1 ≤ Nat.sqrt k := by
    have hconst : 3 * 64 ^ 5 + 1 ≤ 2 * 64 ^ 13 := by norm_num
    exact hconst.trans hsqrt
  apply exists_disjoint_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 6)
      (by omega : 0 < 1) (by positivity : (0 : ℝ) < 1 / (Nat.sqrt k + 1))
  · intro δ m hδ hδm hmk
    exact three_le_inv_succ_sqrt_mul_density_four_mul_card
      hk hδ hδm hmk hsqrt3
  · intro δ m hδ hδm _hmk
    simpa using one_sq_le_density_six_mul_card_sq_div_two
      hk hδ hδm hsqrt
  · intro m hm1 hmk
    exact two_mul_inv_succ_sqrt_pow_six_lt_inv_sq (by omega) hm1 hmk

/-- Linear-reservoir refinement of the instantiated threshold-three family.
The same exponent-six calculation gives every selected robust core at least
floor(k/(2·64^13)) vertices, while retaining the identical explicit
leftover cutoff. -/
theorem exists_disjoint_threshold_three_linear_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 2 * 64 ^ 13 ≤ Nat.sqrt k) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G 3 (k / (2 * 64 ^ 13)) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  have hsqrt3 : 3 * 64 ^ 5 + 1 ≤ Nat.sqrt k := by
    have hconst : 3 * 64 ^ 5 + 1 ≤ 2 * 64 ^ 13 := by norm_num
    exact hconst.trans hsqrt
  have hkbig : 2 * 64 ^ 13 ≤ k :=
    hsqrt.trans (Nat.sqrt_le_self k)
  have hτpos : 0 < k / (2 * 64 ^ 13) := by
    apply Nat.pos_of_ne_zero
    intro hzero
    have hlt : k < 2 * 64 ^ 13 :=
      ((Nat.div_eq_zero_iff).mp hzero).resolve_left (by positivity)
    omega
  apply exists_disjoint_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 6)
      hτpos (by positivity : (0 : ℝ) < 1 / (Nat.sqrt k + 1))
  · intro δ m hδ hδm hmk
    exact three_le_inv_succ_sqrt_mul_density_four_mul_card
      hk hδ hδm hmk hsqrt3
  · intro δ m hδ hδm _hmk
    simpa using div_two_mul_64_pow13_sq_le_density_six_mul_card_sq_div_two
      hk hδ hδm
  · intro m hm1 hmk
    exact two_mul_inv_succ_sqrt_pow_six_lt_inv_sq (by omega) hm1 hmk

/-- Square-root-threshold, linear-reservoir two-pass DRC decomposition.  This
is the quantitative hub family closest to the KLS routing scale: every hub
has at least floor(k/(2·64^13)) core vertices and pairwise common-neighbour
threshold floor(sqrt(k)/(2·64^5)). -/
theorem exists_disjoint_sqrt_threshold_linear_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 2 * 64 ^ 13 ≤ Nat.sqrt k) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G
        (Nat.sqrt k / (2 * 64 ^ 5)) (k / (2 * 64 ^ 13)) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  have hkbig : 2 * 64 ^ 13 ≤ k :=
    hsqrt.trans (Nat.sqrt_le_self k)
  have hτpos : 0 < k / (2 * 64 ^ 13) := by
    apply Nat.pos_of_ne_zero
    intro hzero
    have hlt : k < 2 * 64 ^ 13 :=
      ((Nat.div_eq_zero_iff).mp hzero).resolve_left (by positivity)
    omega
  apply exists_disjoint_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 6)
      hτpos (by positivity : (0 : ℝ) < 1 / (Nat.sqrt k + 1))
  · intro δ m hδ hδm _hmk
    exact sqrt_div_two_mul_64_pow5_le_inv_succ_sqrt_mul_density_four_mul_card
      hk hδ hδm
  · intro δ m hδ hδm _hmk
    simpa using div_two_mul_64_pow13_sq_le_density_six_mul_card_sq_div_two
      hk hδ hδm
  · intro m hm1 hmk
    exact two_mul_inv_succ_sqrt_pow_six_lt_inv_sq (by omega) hm1 hmk

/-- Routing-scale two-pass DRC decomposition.  Increasing the DRC exponent
to ten and taking `eta` at fourth-root scale simultaneously gives threshold
`8 sqrt k` and an exact-core lower bound `9 sqrt k`, precisely the capacities
used by the balanced interaction-component lift. -/
theorem exists_disjoint_bounded_eight_sqrt_nine_sqrt_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * 64 ^ 21 ≤ Nat.sqrt k) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G
        (8 * Nat.sqrt k) (9 * Nat.sqrt k) H ∧ H.card ≤ k) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  have hspos : 0 < Nat.sqrt k := by omega
  have hτpos : 0 < 9 * Nat.sqrt k := by positivity
  have hfourth : 16 * 64 ^ 5 ≤ Nat.sqrt (Nat.sqrt k) := by
    apply (Nat.le_sqrt').2
    have hconst : (16 * 64 ^ 5) ^ 2 ≤ 18 * 64 ^ 21 := by norm_num
    exact hconst.trans hsqrt
  apply exists_disjoint_bounded_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 10)
      hτpos (by positivity :
        (0 : ℝ) < 1 / (Nat.sqrt (Nat.sqrt k) + 1))
  · intro δ m hδ hδm _hmk
    simpa using
      (eight_mul_sqrt_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
        hk hδ hδm hfourth)
  · intro δ m hδ hδm _hmk
    simpa using nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two
      hk hδ hδm hsqrt
  · intro m hm1 hmk
    exact two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
      (by omega) hm1 hmk

/-- Strengthened routing-scale two-pass DRC decomposition.  Before target
compression, exponent ten produces a `k^(3/4)`-scale common-neighbour
reservoir, while the robust core still has exact usable order at least
`9 * sqrt k`.  This is the quantitative input needed for Bernoulli
compression to a region of square-root order. -/
theorem exists_disjoint_bounded_three_quarter_nine_sqrt_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * 64 ^ 21 ≤ Nat.sqrt k) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G
        (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5))
        (9 * Nat.sqrt k) H ∧ H.card ≤ k) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  have hd : 0 < (k - 1) / 16 - 1 := by omega
  have hspos : 0 < Nat.sqrt k := by omega
  have hτpos : 0 < 9 * Nat.sqrt k := by positivity
  apply exists_disjoint_bounded_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 10)
      hτpos (by positivity :
        (0 : ℝ) < 1 / (Nat.sqrt (Nat.sqrt k) + 1))
  · intro δ m hδ hδm _hmk
    simpa using
      (sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
        hk hδ hδm)
  · intro δ m hδ hδm _hmk
    simpa using nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two
      hk hδ hδm hsqrt
  · intro m hm1 hmk
    exact two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
      (by omega) hm1 hmk

/-- Compact form of the strengthened two-pass DRC decomposition.  The dense
Pósa support used to find a hub may contain up to `k` vertices, but Bernoulli
compression means that the region actually removed by the greedy algorithm
has order less than `9 * sqrt k + 8 * sqrt k`.  Every pair of exact-core
vertices retains at least seven common neighbours in the sampled target. -/
theorem exists_disjoint_compact_seven_nine_sqrt_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * 64 ^ 21 ≤ Nat.sqrt k)
    (hsample :
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactLocalRobustHub G 7
        (9 * Nat.sqrt k) (9 * Nat.sqrt k + 8 * Nat.sqrt k) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  let d : ℕ := (k - 1) / 16 - 1
  let Θ : ℕ := Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5)
  let τ : ℕ := 9 * Nat.sqrt k
  let K : ℕ := 8 * Nat.sqrt k
  let sigma : ℝ≥0 := 1 / (Nat.sqrt k : ℝ≥0)
  have hd : 0 < d := by dsimp [d]; omega
  have hspos : 0 < Nat.sqrt k := by omega
  have hτpos : 0 < τ := by dsimp [τ]; positivity
  have hKpos : 0 < K := by dsimp [K]; positivity
  have hsigma : sigma ≤ 1 := by
    dsimp [sigma]
    rw [div_le_one]
    · exact_mod_cast (show 1 ≤ Nat.sqrt k by omega)
    · exact_mod_cast hspos
  apply exists_disjoint_compactLocalRobustHub_family
    G hτpos hKpos sigma hsigma
    (m := 16 * ((n - 1) * (d + 1)))
    (Dmax := k) (Θ := Θ) (r := 6)
  · intro S hSsize
    apply exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
      G hn hd hfree hSsize (by omega) hroom hcycle (by omega : 0 < 10)
        hτpos (by positivity :
          (0 : ℝ) < 1 / (Nat.sqrt (Nat.sqrt k) + 1))
    · intro δ m hδ hδm _hmk
      simpa [Θ, d] using
        (sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
          hk hδ hδm)
    · intro δ m hδ hδm _hmk
      simpa [τ, d] using
        nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two
          hk hδ hδm hsqrt
    · intro m hm1 hmk
      exact two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
        (by omega) hm1 hmk
  · simpa [τ, K, Θ, sigma] using hsample

/-- The compact seven-route hub family exists uniformly for every sufficiently
large target length `k` satisfying the graph-theoretic hypotheses. -/
theorem eventually_exists_disjoint_compact_seven_nine_sqrt_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ} :
    ∀ᶠ k : ℕ in atTop,
      2 ≤ n → G.IndepSetFree n →
      3 * Nat.log 2 (Fintype.card V) + 1 ≤ k →
      ¬ cycleGraph k ⊑ G →
      ∃ F : Finset (Finset V),
