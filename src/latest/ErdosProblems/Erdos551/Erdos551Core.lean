  · simpa [q] using hupp
  · simpa [q] using hparity

/-- Decomposition-preserving component map-back.  Instead of returning only
the copied cycle, retain the even root-side return path in the ambient
graph, together with its support disjointness from the original core path.
This is the component-BFS interface consumed by the hybrid selected-edge
lift. -/
theorem exists_even_short_return_path_in_component_mapped_parityBfsLayerUnion
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {S H : Finset V}
    {c : (G.induce (S : Set V)).ConnectedComponent}
    {root : c} {j : ℕ} {parity : Fin 2}
    (hHeq : H = (parityBfsLayerUnion c.toSimpleGraph root j parity).map
      ⟨fun x => x.1.1, by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)⟩)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ r : G.Walk b.1 a.1,
      r.IsPath ∧ Even r.length ∧ r.length ≤ 2 * j ∧
      (p.map (SimpleGraph.Embedding.induce (G := G) (H : Set V)).toHom).support.tail.Disjoint
        r.support.tail := by
  classical
  let K : SimpleGraph c := c.toSimpleGraph
  have hpre : ∀ y : H, ∃ x : c, x.1.1 = y.1 := by
    intro y
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion c.toSimpleGraph root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, _hx, hxval⟩
    exact ⟨x, hxval⟩
  let lift : H → c := fun y => Classical.choose (hpre y)
  have hliftval : ∀ y : H, (lift y).1.1 = y.1 := by
    intro y
    exact Classical.choose_spec (hpre y)
  let e : G.induce (H : Set V) ↪g K :=
    { toFun := lift
      inj' := by
        intro x y hxy
        apply Subtype.ext
        calc
          x.1 = (lift x).1.1 := (hliftval x).symm
          _ = (lift y).1.1 := by rw [hxy]
          _ = y.1 := hliftval y
      map_rel_iff' := by
        intro x y
        change G.Adj (lift x).1.1 (lift y).1.1 ↔ G.Adj x.1 y.1
        simp [hliftval x, hliftval y] }
  let q : K.Walk (e a) (e b) := p.map e.toHom
  have hqpath : q.IsPath := hp.map e.injective
  have hqsupp : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion K root j parity := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion K root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      change (y : V) ∈
        (parityBfsLayerUnion c.toSimpleGraph root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, hx, hxval⟩
    have hxy : x = e y := by
      apply Subtype.ext
      apply Subtype.ext
      calc
        x.1.1 = y.1 := hxval
        _ = (lift y).1.1 := (hliftval y).symm
    simpa [hxy] using hx
  obtain ⟨i, hij, _hipar, hplayer⟩ :=
    exists_bfsLayer_containing_walk_support_of_parityBfsLayerUnion
      K q hqsupp
  have hab : e a ≠ e b := by
    intro hab
    have hnil : q.Nil := hqpath.nil_iff_eq.mpr hab
    have hzero := hnil.length_eq_zero
    have hqlen : q.length = p.length := by simp [q]
    omega
  have hKconn : K.Connected := by
    simpa [K] using c.connected_toSimpleGraph
  obtain ⟨s, hs, hseven, hsbound, hdisj, _hsavoid⟩ :=
    exists_even_short_return_path_disjoint_of_path_in_bfsLayer_of_reachable
      K (hKconn root (e a)) (hKconn root (e b))
        (hplayer (e a) (by simp)) (hplayer (e b) (by simp)) hab
        hqpath hplayer
  let f : K ↪g G :=
    { toFun := fun x => x.1.1
      inj' := by
        intro x y hxy
        exact Subtype.ext (Subtype.ext hxy)
      map_rel_iff' := by
        intro x y
        rfl }
  let s₀ : G.Walk (f (e b)) (f (e a)) := s.map f.toHom
  let r : G.Walk b.1 a.1 := s₀.copy (hliftval b) (hliftval a)
  have hr : r.IsPath := by
    simpa [r, s₀] using hs.map f.injective
  have hreven : Even r.length := by
    have hlen : r.length = s.length := by simp [r, s₀]
    rw [hlen]
    exact hseven
  have hrbound : r.length ≤ 2 * j := by
    calc
      r.length = s.length := by simp [r, s₀]
      _ ≤ 2 * i := hsbound
      _ ≤ 2 * j := Nat.mul_le_mul_left 2 hij
  have hmapdisj :
      (q.map f.toHom).support.tail.Disjoint
        (s.map f.toHom).support.tail := by
    simpa [Walk.support_map] using hdisj.map f.injective
  have hqSupport :
      (q.map f.toHom).support =
        (p.map (SimpleGraph.Embedding.induce
          (G := G) (H : Set V)).toHom).support := by
    simp only [q, Walk.support_map, List.map_map]
    apply List.map_congr_left
    intro y _hy
    exact hliftval y
  have hrSupport : r.support = (s.map f.toHom).support := by
    simp [r, s₀]
  refine ⟨r, hr, hreven, hrbound, ?_⟩
  simpa [hqSupport, hrSupport] using hmapdisj

/-- Public elimination form of component BFS provenance. -/
theorem exists_cycle_in_interval_of_path_in_component_bfs_core
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H D : Finset V} (hcore : IsComponentBfsParityCore G H D)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ j ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j := by
  rcases hcore with ⟨S, c, root, j, parity, _hj, hHeq, _hDeq⟩
  obtain ⟨ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_component_mapped_parityBfsLayerUnion
      G hHeq hp hplen
  exact ⟨j, ℓ, hcycle, hlow, hupp⟩

/-- Public same-parity elimination form of component BFS provenance. -/
theorem exists_same_parity_cycle_in_interval_of_path_in_component_bfs_core
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H D : Finset V} (hcore : IsComponentBfsParityCore G H D)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ j ℓ : ℕ, cycleGraph ℓ ⊑ G ∧
      p.length + 1 ≤ ℓ ∧ ℓ ≤ p.length + 2 * j ∧
      ℓ % 2 = p.length % 2 := by
  rcases hcore with ⟨S, c, root, j, parity, _hj, hHeq, _hDeq⟩
  obtain ⟨ℓ, hcycle, hlow, hupp, hparity⟩ :=
    exists_same_parity_cycle_in_interval_of_path_in_component_mapped_parityBfsLayerUnion
      G hHeq hp hplen
  exact ⟨j, ℓ, hcycle, hlow, hupp, hparity⟩

/-- Same-parity component closure with the slow-radius bound retained in the
ambient vertex count. -/
theorem exists_same_parity_cycle_in_interval_of_path_in_component_bfs_core_with_radius_bound
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H D : Finset V} (hcore : IsComponentBfsParityCore G H D)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ j ℓ : ℕ, j ≤ Nat.log 2 (Fintype.card V) ∧
      cycleGraph ℓ ⊑ G ∧ p.length + 1 ≤ ℓ ∧
      ℓ ≤ p.length + 2 * j ∧ ℓ % 2 = p.length % 2 := by
  rcases hcore with ⟨S, c, root, j, parity, hj, hHeq, _hDeq⟩
  have hcV : Fintype.card c ≤ Fintype.card V :=
    Fintype.card_le_of_injective (fun x : c => x.1.1) (by
      intro x y hxy
      exact Subtype.ext (Subtype.ext hxy))
  have hjV : j ≤ Nat.log 2 (Fintype.card V) :=
    hj.trans (Nat.log_mono_right hcV)
  obtain ⟨ℓ, hcycle, hlow, hupp, hparity⟩ :=
    exists_same_parity_cycle_in_interval_of_path_in_component_mapped_parityBfsLayerUnion
      G hHeq hp hplen
  exact ⟨j, ℓ, hjV, hcycle, hlow, hupp, hparity⟩

/-- Component-core return-path interface with the slow-radius estimate
retained. -/
theorem exists_even_short_return_path_in_component_bfs_core_with_radius_bound
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H D : Finset V} (hcore : IsComponentBfsParityCore G H D)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ j : ℕ, j ≤ Nat.log 2 (Fintype.card V) ∧
      ∃ r : G.Walk b.1 a.1,
        r.IsPath ∧ Even r.length ∧ r.length ≤ 2 * j ∧
        (p.map (SimpleGraph.Embedding.induce
          (G := G) (H : Set V)).toHom).support.tail.Disjoint
            r.support.tail := by
  rcases hcore with ⟨S, c, root, j, parity, hj, hHeq, _hDeq⟩
  have hcV : Fintype.card c ≤ Fintype.card V :=
    Fintype.card_le_of_injective (fun x : c => x.1.1) (by
      intro x y hxy
      exact Subtype.ext (Subtype.ext hxy))
  have hjV : j ≤ Nat.log 2 (Fintype.card V) :=
    hj.trans (Nat.log_mono_right hcV)
  obtain ⟨r, hr, hreven, hrbound, hdisj⟩ :=
    exists_even_short_return_path_in_component_mapped_parityBfsLayerUnion
      G hHeq hp hplen
  exact ⟨j, hjV, r, hr, hreven, hrbound, hdisj⟩

/-- Global component-BFS specialization of the selected path/count
dichotomy.  A selected path of length at least `D+1` is localized in one
retained BFS core.  Its prefix of length `D` or `D+1`, chosen to have the
prescribed parity, closes inside that core to an ordinary interaction cycle
of the same parity.  In the complementary branch the global factor-`32`
transversal count holds. -/
theorem exists_same_parity_hubInteraction_cycle_or_selected_transversal_count
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) {n σ D parity : ℕ}
    (hD : 2 ≤ D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j)) :
    (∃ j ℓ : ℕ, j ≤ Nat.log 2 (Fintype.card ι) ∧
      cycleGraph ℓ ⊑ HubInteractionGraph G I ∧
      D + 1 ≤ ℓ ∧ ℓ ≤ D + 1 + 2 * j ∧ ℓ % 2 = parity % 2) ∨
      (σ - 4 * (D + 1)) * Fintype.card ι <
        32 * (D + 1) * n := by
  classical
  let K : SimpleGraph ι := HubInteractionGraph G I
  obtain ⟨F, hcore, henvDisj, hanti, hunion, hcharge⟩ :=
    exists_global_separated_component_bfs_core_family_with_witness K
  let C : Finset (Finset ι) := F.image Prod.fst
  have hFne : F.Nonempty := by
    let i₀ : ι := Classical.choice inferInstance
    have hi₀ : i₀ ∈ F.biUnion (fun q => q.2) := by
      rw [hunion]
      exact Finset.mem_univ _
    rcases Finset.mem_biUnion.mp hi₀ with ⟨q, hq, _hi₀q⟩
    exact ⟨q, hq⟩
  have hfstInj : Set.InjOn Prod.fst (F : Set (Finset ι × Finset ι)) := by
    intro q hq r hr hqrCore
    have hqF : q ∈ F := by simpa using hq
    have hrF : r ∈ F := by simpa using hr
    by_contra hqr
    obtain ⟨x, hx⟩ := (hcore q hqF).2.1
    have hxq : x ∈ q.2 := (hcore q hqF).1 hx
    have hxrCore : x ∈ r.1 := by simpa [hqrCore] using hx
    have hxr : x ∈ r.2 := (hcore r hrF).1 hxrCore
    exact (Finset.disjoint_left.mp (henvDisj q hqF r hrF hqr)) hxq hxr
  have hCne : C.Nonempty := by
    simpa [C] using hFne.image Prod.fst
  have hmemne : ∀ A ∈ C, A.Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    exact (hcore q hq).2.1
  have hCdisj : DisjointFinsetFamily C := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨r, hr, rfl⟩
    have hqr : q ≠ r := by
      intro h
      subst r
      exact hAB rfl
    exact (henvDisj q hq r hr hqr).mono
      (hcore q hq).1 (hcore r hr).1
  have hCanti : PairwiseAnticomplete K C := by
    intro A hA B hB hAB a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨r, hr, rfl⟩
    have hqr : q ≠ r := by
      intro h
      subst r
      exact hAB rfl
    exact (hanti q hq r hr hqr a ha b hb) hab
  have hsum : ∑ A ∈ C, A.card = ∑ q ∈ F, q.1.card := by
    dsimp [C]
    rw [Finset.sum_image]
    intro q hq r hr hqr
    exact hfstInj (by simpa using hq) (by simpa using hr) hqr
  have hcover : Fintype.card ι ≤ 4 * ∑ A ∈ C, A.card := by
    rw [hsum]
    exact hcharge
  obtain hlong | hcount :=
      exists_localized_selected_path_or_sub_four_mul_card_lt
        G I C (D := D + 1) (by omega) hfree hIcard hIind hdisj
          hCne hmemne hCdisj (by simpa [K] using hCanti) hcover
  · left
    obtain ⟨A, hA, u, v, p, hp, hplen, hpsupp⟩ := hlong
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    let d : ℕ := if D % 2 = parity % 2 then D else D + 1
    have hdlo : D ≤ d := by
      dsimp [d]
      split <;> omega
    have hdhi : d ≤ D + 1 := by
      dsimp [d]
      split <;> omega
    have hdparity : d % 2 = parity % 2 := by
      dsimp [d]
      split <;> omega
    have hdplen : d ≤ p.length := hdhi.trans hplen
    let p₀ := p.take d
    have hp₀supp : ∀ z ∈ p₀.support, z ∈ q.1 := by
      intro z hz
      dsimp [p₀] at hz
      rw [Walk.support_take] at hz
      exact hpsupp z (List.mem_of_mem_take hz)
    let r := p₀.induce (q.1 : Set ι) hp₀supp
    let e : K.induce (q.1 : Set ι) ↪g K :=
      SimpleGraph.Embedding.induce (G := K) (q.1 : Set ι)
    have hrmap : r.map e.toHom = p₀ := by
      simpa [r, e] using Walk.map_induce p₀ hp₀supp
    have hrpath : r.IsPath := by
      have hmapPath : (r.map e.toHom).IsPath := by
        rw [hrmap]
        exact hp.take d
      exact hmapPath.of_map
    have hp₀len : p₀.length = d := by
      simp [p₀, Walk.take_length, Nat.min_eq_left hdplen]
    have hrlen : r.length = d := by
      calc
        r.length = (r.map e.toHom).length := by simp
        _ = p₀.length := congrArg Walk.length hrmap
        _ = d := hp₀len
    obtain ⟨j, ℓ, hj, hcycle, hlow, hupp, hcycleParity⟩ :=
      exists_same_parity_cycle_in_interval_of_path_in_component_bfs_core_with_radius_bound
        K (hcore q hq).2.2.2 hrpath (by rw [hrlen]; omega)
    refine ⟨j, ℓ, hj, ?_, ?_, ?_, ?_⟩
    · simpa [K] using hcycle
    · rw [hrlen] at hlow
      omega
    · rw [hrlen] at hupp
      omega
    · rw [hrlen] at hcycleParity
      exact hcycleParity.trans hdparity
  · exact Or.inr hcount

/-- Decomposition-preserving selected path/count dichotomy.  The long
selected prefix is returned together with the even, internally disjoint
ordinary BFS return path, rather than being collapsed to an abstract
interaction cycle. -/
theorem exists_selected_path_with_even_return_or_transversal_count
    {V ι : Type*} [Fintype V] [Fintype ι] [Nonempty ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (I : ι → Finset V) {n σ D parity : ℕ}
    (hD : 2 ≤ D)
    (hfree : G.IndepSetFree n)
    (hIcard : ∀ i, σ ≤ (I i).card)
    (hIind : ∀ i, G.IsIndepSet (I i : Set V))
    (hdisj : ∀ i j : ι, i ≠ j → Disjoint (I i) (I j)) :
    (∃ M : Finset (SelectedCrossEdge V ι),
      IsSelectedCrossEdgeSystem G I M ∧
      ∃ u v : ι, ∃ p : (SelectedCrossEdgeGraph M).Walk u v,
        ∃ r : (HubInteractionGraph G I).Walk v u, ∃ j : ℕ,
          p.IsPath ∧ D ≤ p.length ∧ p.length ≤ D + 1 ∧
          p.length % 2 = parity % 2 ∧
          j ≤ Nat.log 2 (Fintype.card ι) ∧
          r.IsPath ∧ Even r.length ∧ r.length ≤ 2 * j ∧
          p.support.tail.Disjoint r.support.tail) ∨
      (σ - 4 * (D + 1)) * Fintype.card ι <
        32 * (D + 1) * n := by
  classical
  let K : SimpleGraph ι := HubInteractionGraph G I
  obtain ⟨F, hcore, henvDisj, hanti, hunion, hcharge⟩ :=
    exists_global_separated_component_bfs_core_family_with_witness K
  let C : Finset (Finset ι) := F.image Prod.fst
  have hFne : F.Nonempty := by
    let i₀ : ι := Classical.choice inferInstance
    have hi₀ : i₀ ∈ F.biUnion (fun q => q.2) := by
      rw [hunion]
      exact Finset.mem_univ _
    rcases Finset.mem_biUnion.mp hi₀ with ⟨q, hq, _⟩
    exact ⟨q, hq⟩
  have hfstInj : Set.InjOn Prod.fst (F : Set (Finset ι × Finset ι)) := by
    intro q hq r hr hqrCore
    by_contra hqr
    obtain ⟨x, hx⟩ := (hcore q hq).2.1
    have hxq : x ∈ q.2 := (hcore q hq).1 hx
    have hxrCore : x ∈ r.1 := by simpa [hqrCore] using hx
    have hxr : x ∈ r.2 := (hcore r hr).1 hxrCore
    exact (Finset.disjoint_left.mp (henvDisj q hq r hr hqr)) hxq hxr
  have hCne : C.Nonempty := by simpa [C] using hFne.image Prod.fst
  have hmemne : ∀ A ∈ C, A.Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    exact (hcore q hq).2.1
  have hCdisj : DisjointFinsetFamily C := by
    intro A hA B hB hAB
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨r, hr, rfl⟩
    have hqr : q ≠ r := by
      intro h
      subst r
      exact hAB rfl
    exact (henvDisj q hq r hr hqr).mono (hcore q hq).1 (hcore r hr).1
  have hCanti : PairwiseAnticomplete K C := by
    intro A hA B hB hAB a ha b hb hab
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    rcases Finset.mem_image.mp hB with ⟨r, hr, rfl⟩
    have hqr : q ≠ r := by
      intro h
      subst r
      exact hAB rfl
    exact (hanti q hq r hr hqr a ha b hb) hab
  have hsum : ∑ A ∈ C, A.card = ∑ q ∈ F, q.1.card := by
    dsimp [C]
    rw [Finset.sum_image]
    intro q hq r hr hqr
    exact hfstInj (by simpa using hq) (by simpa using hr) hqr
  have hcover : Fintype.card ι ≤ 4 * ∑ A ∈ C, A.card := by
    rw [hsum]
    exact hcharge
  obtain hlong | hcount :=
    exists_localized_selected_system_path_or_sub_four_mul_card_lt
      G I C (D := D + 1) (by omega) hfree hIcard hIind hdisj
        hCne hmemne hCdisj (by simpa [K] using hCanti) hcover
  · left
    obtain ⟨M, hM, A, hA, u, v, p, hp, hplen, hpsupp⟩ := hlong
    rcases Finset.mem_image.mp hA with ⟨q, hq, rfl⟩
    let d : ℕ := if D % 2 = parity % 2 then D else D + 1
    have hdlo : D ≤ d := by dsimp [d]; split <;> omega
    have hdhi : d ≤ D + 1 := by dsimp [d]; split <;> omega
    have hdparity : d % 2 = parity % 2 := by dsimp [d]; split <;> omega
    have hdplen : d ≤ p.length := hdhi.trans hplen
    let p₀ := p.take d
    have hp₀supp : ∀ z ∈ p₀.support, z ∈ q.1 := by
      intro z hz
      dsimp [p₀] at hz
      rw [Walk.support_take] at hz
      exact hpsupp z (List.mem_of_mem_take hz)
    let eK : SelectedCrossEdgeGraph M →g K :=
      { toFun := id
        map_rel' := by
          intro i l hil
          obtain ⟨_r, _hrM, _hrpair, x, y, hx, hy, hxy, _, _⟩ :=
            exists_oriented_selectedCrossEdge_of_graph_adj hM hil
          change (HubInteractionGraph G I).Adj i l
          rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
          exact ⟨hil.ne, Or.inl ⟨x, hx, y, hy, hxy⟩⟩ }
    let pK : K.Walk u (p.getVert d) := p₀.map eK
    have hpKsupp : ∀ z ∈ pK.support, z ∈ q.1 := by
      intro z hz
      have hz₀ : z ∈ p₀.support := by
        simpa [pK, eK, Walk.support_map] using hz
      exact hp₀supp z hz₀
    let pSub := pK.induce (q.1 : Set ι) hpKsupp
    let eSub : K.induce (q.1 : Set ι) ↪g K :=
      SimpleGraph.Embedding.induce (G := K) (q.1 : Set ι)
    have hpSubMap : pSub.map eSub.toHom = pK := by
      simpa [pSub, eSub] using Walk.map_induce pK hpKsupp
    have heKinj : Function.Injective eK := by
      intro x y hxy
      exact hxy
    have hpK : pK.IsPath := (hp.take d).map heKinj
    have hpSub : pSub.IsPath := by
      apply (show (pSub.map eSub.toHom).IsPath by rw [hpSubMap]; exact hpK).of_map
    have hp₀len : p₀.length = d := by
      simp [p₀, Walk.take_length, Nat.min_eq_left hdplen]
    have hpSublen : pSub.length = d := by
      calc
        pSub.length = (pSub.map eSub.toHom).length :=
          (pSub.length_map eSub.toHom).symm
        _ = pK.length := congrArg Walk.length hpSubMap
        _ = p₀.length := by simp [pK]
        _ = d := hp₀len
    obtain ⟨j, hj, ret, hret, hreteven, hretlen, hretDisj⟩ :=
      exists_even_short_return_path_in_component_bfs_core_with_radius_bound
        K (hcore q hq).2.2.2 hpSub (by rw [hpSublen]; omega)
    have hpKRet : pK.support.tail.Disjoint ret.support.tail := by
      have htail := congrArg (fun w ↦ w.support.tail) hpSubMap
      rw [htail] at hretDisj
      exact hretDisj
    have hp₀Ret : p₀.support.tail.Disjoint ret.support.tail := by
      simpa [pK, eK, Walk.support_map] using hpKRet
    refine ⟨M, hM, u, p.getVert d, p₀, ret, j, hp.take d, ?_, ?_, ?_, hj,
      hret, hreteven, hretlen, hp₀Ret⟩
    · rw [hp₀len]; exact hdlo
    · rw [hp₀len]; exact hdhi
    · rw [hp₀len]; exact hdparity
  · exact Or.inr hcount

/-- The same component-core interval closure retains the logarithmic slow
radius bound in the ambient vertex count. -/
theorem exists_cycle_in_interval_of_path_in_component_bfs_core_with_radius_bound
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    {H D : Finset V} (hcore : IsComponentBfsParityCore G H D)
    {a b : H} {p : (G.induce (H : Set V)).Walk a b}
    (hp : p.IsPath) (hplen : 2 ≤ p.length) :
    ∃ j ℓ : ℕ, j ≤ Nat.log 2 (Fintype.card V) ∧
      cycleGraph ℓ ⊑ G ∧ p.length + 1 ≤ ℓ ∧
      ℓ ≤ p.length + 2 * j := by
  rcases hcore with ⟨S, c, root, j, parity, hj, hHeq, _hDeq⟩
  have hcV : Fintype.card c ≤ Fintype.card V :=
    Fintype.card_le_of_injective (fun x : c => x.1.1) (by
      intro x y hxy
      exact Subtype.ext (Subtype.ext hxy))
  have hjV : j ≤ Nat.log 2 (Fintype.card V) :=
    hj.trans (Nat.log_mono_right hcV)
  obtain ⟨ℓ, hcycle, hlow, hupp⟩ :=
    exists_cycle_in_interval_of_path_in_component_mapped_parityBfsLayerUnion
      G hHeq hp hplen
  exact ⟨j, ℓ, hjV, hcycle, hlow, hupp⟩

/- 
/-- At the Ramsey extremal order on the diagonal range, every slow BFS
radius is at most twice the binary logarithm of k, up to the harmless
additive one from the strict power bound. -/
theorem log_extremal_order_le_two_mul_log_add_one
    {k n : ℕ} (hk : 1 ≤ k) (hnk : n ≤ k) :
    Nat.log 2 ((k - 1) * (n - 1) + 1) ≤
      2 * (Nat.log 2 k + 1) := by
  have hn1 : n - 1 ≤ k - 1 := Nat.sub_le_sub_right hnk 1
  have horder : (k - 1) * (n - 1) + 1 ≤ k * k := by
    calc
      (k - 1) * (n - 1) + 1 ≤ (k - 1) * (k - 1) + 1 :=
        Nat.add_le_add_right (Nat.mul_le_mul_left _ hn1) 1
      _ ≤ (k - 1) * (k - 1) + (2 * (k - 1) + 1) := by omega
      _ = ((k - 1) + 1) * ((k - 1) + 1) := by ring
      _ = k * k := by rw [Nat.sub_add_cancel hk]
  have hkpow : k ≤ 2 ^ (Nat.log 2 k + 1) := by
    exact (Nat.lt_pow_succ_log_self (b := 2) (by omega) k).le
  have hpow : (k - 1) * (n - 1) + 1 ≤
      2 ^ (2 * (Nat.log 2 k + 1)) := by
    calc
      (k - 1) * (n - 1) + 1 ≤ k * k := horder
      _ ≤ 2 ^ (Nat.log 2 k + 1) * 2 ^ (Nat.log 2 k + 1) :=
        Nat.mul_le_mul hkpow hkpow
      _ = 2 ^ (2 * (Nat.log 2 k + 1)) := by
        rw [← Nat.pow_add]
        congr 1
        omega
  calc
    Nat.log 2 ((k - 1) * (n - 1) + 1) ≤
        Nat.clog 2 ((k - 1) * (n - 1) + 1) :=
      Nat.log_le_clog _ _
    _ ≤ 2 * (Nat.log 2 k + 1) := Nat.clog_le_of_le_pow hpow

/-- A concrete exponential estimate used to dominate the binary logarithm.
Starting at exponent eight, doubling the right-hand side preserves the
linear inequality with room to spare. -/
theorem eight_mul_add_seven_le_two_pow_of_eight_le
    {q : ℕ} (hq : 8 ≤ q) : 8 * q + 7 ≤ 2 ^ q := by
  induction q using Nat.strong_induction_on with
  | h q ih =>
      by_cases hq8 : q = 8
      · subst q
        norm_num
      have hqgt : 8 < q := by omega
      have hpred : 8 ≤ q - 1 := by omega
      have ihpred := ih (q - 1) (by omega) hpred
      have hqform : q = (q - 1) + 1 := by omega
      rw [hqform, pow_succ]
      have htwice : 2 * (8 * (q - 1) + 7) ≤ 2 * 2 ^ (q - 1) :=
        Nat.mul_le_mul_left 2 ihpred
      omega

/-- From k at least 64 onward, six binary logarithms plus the fixed splice
overhead fit below k.  Divide k by eight, bound k by 8 floor(k/8)+7, and
use the preceding exponential estimate to bound the ceiling logarithm. -/
theorem six_mul_log_add_one_le_self_of_64_le
    {k : ℕ} (hk : 64 ≤ k) :
    6 * (Nat.log 2 k + 1) + 1 ≤ k := by
  let q : ℕ := k / 8
  have hq8 : 8 ≤ q := by
    dsimp [q]
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  have hkq : k ≤ 8 * q + 7 := by
    have hmod : k % 8 < 8 := Nat.mod_lt k (by omega)
    have hdivmod : 8 * (k / 8) + k % 8 = k := Nat.div_add_mod k 8
    dsimp [q]
    omega
  have hkpow : k ≤ 2 ^ q :=
    hkq.trans (eight_mul_add_seven_le_two_pow_of_eight_le hq8)
  have hlog : Nat.log 2 k ≤ q :=
    (Nat.log_le_clog 2 k).trans (Nat.clog_le_of_le_pow hkpow)
  have hqk : 8 * q ≤ k := by
    dsimp [q]
    exact Nat.mul_div_le k 8
  have hmain : 6 * (Nat.log 2 k + 1) + 1 ≤ 8 * q := by
    omega
  exact hmain.trans hqk

/-- At diagonal extremal order, the entire two-level BFS detour budget fits
below k from the same concrete threshold. -/
theorem three_mul_log_extremal_order_add_one_le_of_64_le
    {k n : ℕ} (hk : 64 ≤ k) (hnk : n ≤ k) :
    3 * Nat.log 2 ((k - 1) * (n - 1) + 1) + 1 ≤ k := by
  have hlog := log_extremal_order_le_two_mul_log_add_one (by omega : 1 ≤ k) hnk
  have hklog := six_mul_log_add_one_le_self_of_64_le hk
  omega
-/

/-- The factor-sixteen dense core still has minimum-degree scale linear in
k.  If d = floor((k-1)/16)-1 and d ≤ 2δ, then k ≤ 64δ once k ≥ 64.  This
fixed-ratio estimate is the numerical input for every later DRC power. -/
theorem k_le_64_mul_of_pred_div16_sub_one_le_two_mul
    {k δ : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ) :
    k ≤ 64 * δ := by
  let q : ℕ := (k - 1) / 16
  have hq3 : 3 ≤ q := by
    dsimp [q]
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  have hmod : (k - 1) % 16 < 16 := Nat.mod_lt (k - 1) (by omega)
  have hdivmod : 16 * ((k - 1) / 16) + (k - 1) % 16 = k - 1 :=
    Nat.div_add_mod (k - 1) 16
  have hkq : k ≤ 32 * (q - 1) := by
    dsimp [q]
    omega
  have hqδ : q - 1 ≤ 2 * δ := by simpa [q] using hδ
  calc
    k ≤ 32 * (q - 1) := hkq
    _ ≤ 32 * (2 * δ) := Nat.mul_le_mul_left 32 hqδ
    _ = 64 * δ := by ring

/-- Parameterized fixed-ratio estimate.  For any positive divisor B, the
choice d = floor((k-1)/B)-1 satisfies k ≤ 4Bδ whenever d ≤ 2δ and k is at
least 4B.  Larger B makes the greedy leftover cutoff proportionally smaller
while preserving a uniform DRC density ratio. -/
theorem k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul
    {B k δ : ℕ} (hB : 0 < B) (hk : 4 * B ≤ k)
    (hδ : (k - 1) / B - 1 ≤ 2 * δ) :
    k ≤ (4 * B) * δ := by
  let q : ℕ := (k - 1) / B
  have hq3 : 3 ≤ q := by
    dsimp [q]
    apply (Nat.le_div_iff_mul_le hB).2
    omega
  have hmod : (k - 1) % B < B := Nat.mod_lt (k - 1) hB
  have hdivmod : B * ((k - 1) / B) + (k - 1) % B = k - 1 :=
    Nat.div_add_mod (k - 1) B
  have hkq : k ≤ 2 * B * (q - 1) := by
    have hkBq : k ≤ B * (q + 1) := by
      have hrem : (k - 1) % B + 1 ≤ B := by omega
      calc
        k = B * q + ((k - 1) % B + 1) := by
          dsimp [q]
          omega
        _ ≤ B * q + B := Nat.add_le_add_left hrem _
        _ = B * (q + 1) := by ring
    have hq2 : q + 1 ≤ 2 * (q - 1) := by omega
    calc
      k ≤ B * (q + 1) := hkBq
      _ ≤ B * (2 * (q - 1)) := Nat.mul_le_mul_left B hq2
      _ = 2 * B * (q - 1) := by ring
  have hqδ : q - 1 ≤ 2 * δ := by simpa [q] using hδ
  calc
    k ≤ 2 * B * (q - 1) := hkq
    _ ≤ 2 * B * (2 * δ) := Nat.mul_le_mul_left (2 * B) hqδ
    _ = (4 * B) * δ := by ring

/-- Real density-ratio form of the parameterized estimate. -/
theorem one_div_four_mul_divisor_le_delta_div_k_of_pred_div_sub_one_le_two_mul
    {B k δ : ℕ} (hB : 0 < B) (hk : 4 * B ≤ k)
    (hδ : (k - 1) / B - 1 ≤ 2 * δ) :
    (1 : ℝ) / (4 * B) ≤ (δ : ℝ) / k := by
  have hkδ : k ≤ (4 * B) * δ :=
    k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul hB hk hδ
  have hkR : (0 : ℝ) < k := by exact_mod_cast (by omega : 0 < k)
  apply (le_div_iff₀ hkR).2
  have hkδR : (k : ℝ) ≤ (4 * B) * δ := by exact_mod_cast hkδ
  have hBR : (0 : ℝ) < B := by exact_mod_cast hB
  have hden : (0 : ℝ) < 4 * B := by positivity
  rw [show (1 : ℝ) / (4 * B) * k = (k : ℝ) / (4 * B) by ring]
  apply (div_le_iff₀ hden).2
  calc
    (k : ℝ) ≤ (4 * B) * δ := hkδR
    _ = δ * (4 * B) := by ring

/-- Extremal-order size estimate for an arbitrary fixed divisor B at least
16.  With d = floor((k-1)/B)-1, the two-pass factor-sixteen extraction only
requires a 16/B fraction of the extremal vertex set. -/
theorem sixteen_mul_pred_mul_pred_divisor_le_extremal_order
    {B k n : ℕ} (hB : 16 ≤ B) (hk : B + 1 ≤ k) :
    16 * ((n - 1) * (((k - 1) / B - 1) + 1)) ≤
      (k - 1) * (n - 1) + 1 := by
  have hBpos : 0 < B := by omega
  have hqpos : 1 ≤ (k - 1) / B := by
    apply (Nat.le_div_iff_mul_le hBpos).2
    omega
  have hdeq : ((k - 1) / B - 1) + 1 = (k - 1) / B :=
    Nat.sub_add_cancel hqpos
  rw [hdeq]
  have hqmul : B * ((k - 1) / B) ≤ k - 1 := Nat.mul_div_le (k - 1) B
  have h16q : 16 * ((k - 1) / B) ≤ B * ((k - 1) / B) :=
    Nat.mul_le_mul_right _ hB
  calc
    16 * ((n - 1) * ((k - 1) / B)) =
        (16 * ((k - 1) / B)) * (n - 1) := by ring
    _ ≤ (B * ((k - 1) / B)) * (n - 1) :=
      Nat.mul_le_mul_right _ h16q
    _ ≤ (k - 1) * (n - 1) := Nat.mul_le_mul_right _ hqmul
    _ ≤ (k - 1) * (n - 1) + 1 := by omega

/-- Real-valued form of the preceding fixed-ratio estimate: every inherited
minimum degree δ has density ratio at least 1/64 against the target length
k. -/
theorem one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul
    {k δ : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ) :
    (1 : ℝ) / 64 ≤ (δ : ℝ) / k := by
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkR : (0 : ℝ) < k := by exact_mod_cast (by omega : 0 < k)
  apply (le_div_iff₀ hkR).2
  have hkδR : (k : ℝ) ≤ 64 * δ := by exact_mod_cast hkδ
  nlinarith

/-- Uniform small-moment estimate for the concrete DRC choice
eta = 1/(floor(sqrt k)+1) and t = 6.  Every support order m at most k is
strictly below (floor(sqrt k)+1)^2, while the sixth power of that denominator
dominates twice m^2. -/
theorem two_mul_inv_succ_sqrt_pow_six_lt_inv_sq
    {k m : ℕ} (hk : 3 ≤ k) (hm1 : 1 ≤ m) (hmk : m ≤ k) :
    2 * ((1 : ℝ) / (Nat.sqrt k + 1)) ^ 6 < (1 : ℝ) / (m : ℝ) ^ 2 := by
  let a : ℕ := Nat.sqrt k + 1
  have ha2 : 2 ≤ a := by
    dsimp [a]
    have hspos : 0 < Nat.sqrt k := Nat.sqrt_pos.mpr (by omega)
    omega
  have hma : m < a ^ 2 := by
    have hklt : k < (Nat.sqrt k + 1) ^ 2 := Nat.lt_succ_sqrt' k
    dsimp [a]
    exact hmk.trans_lt hklt
  have hmR : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have haR : (0 : ℝ) < a := by exact_mod_cast (by omega : 0 < a)
  have hmaR : (m : ℝ) < (a : ℝ) ^ 2 := by exact_mod_cast hma
  have hm2lt : (m : ℝ) ^ 2 < (a : ℝ) ^ 4 := by
    nlinarith [sq_lt_sq₀ (by positivity : (0 : ℝ) ≤ m)
      (by positivity : (0 : ℝ) ≤ (a : ℝ) ^ 2) |>.2 hmaR]
  have ha6 : 2 * (a : ℝ) ^ 4 ≤ (a : ℝ) ^ 6 := by
    have ha2R : (2 : ℝ) ≤ a ^ 2 := by
      have : (2 : ℝ) ≤ a := by exact_mod_cast ha2
      nlinarith
    nlinarith [mul_le_mul_of_nonneg_right ha2R (by positivity : (0 : ℝ) ≤ (a : ℝ) ^ 4)]
  have hnum : 2 * (m : ℝ) ^ 2 < (a : ℝ) ^ 6 := by
    exact (mul_lt_mul_of_pos_left hm2lt (by positivity)).trans_le ha6
  calc
    2 * ((1 : ℝ) / (Nat.sqrt k + 1)) ^ 6 =
        2 / (a : ℝ) ^ 6 := by simp [a]; ring
    _ < (1 : ℝ) / (m : ℝ) ^ 2 := by
      apply (div_lt_div_iff₀ (by positivity) (by positivity)).2
      simpa using hnum

/-- Exponent-ten moment estimate with the fourth-root-scale choice
`eta = 1/(sqrt(sqrt k)+1)`.  Every support order at most `k` is below the
fourth power of that denominator, so the tenth power dominates twice its
square. -/
theorem two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
    {k m : ℕ} (hk : 3 ≤ k) (hm1 : 1 ≤ m) (hmk : m ≤ k) :
    2 * ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) ^ 10 <
      (1 : ℝ) / (m : ℝ) ^ 2 := by
  let s : ℕ := Nat.sqrt k
  let a : ℕ := Nat.sqrt s + 1
  have ha2 : 2 ≤ a := by
    dsimp [a, s]
    have hspos : 0 < Nat.sqrt k := Nat.sqrt_pos.mpr (by omega)
    have hqpos : 0 < Nat.sqrt (Nat.sqrt k) := Nat.sqrt_pos.mpr hspos
    omega
  have hks : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hsa : s + 1 ≤ a ^ 2 := by
    have hslt : s < (Nat.sqrt s + 1) ^ 2 := Nat.lt_succ_sqrt' s
    dsimp [a]
    omega
  have hka : k < a ^ 4 := by
    have hp := Nat.pow_le_pow_left hsa 2
    have hp' : (s + 1) ^ 2 ≤ a ^ 4 := by
      calc
        (s + 1) ^ 2 ≤ (a ^ 2) ^ 2 := hp
        _ = a ^ 4 := by ring
    exact hks.trans_le hp'
  have hma : m < a ^ 4 := hmk.trans_lt hka
  have hmR : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have haR : (0 : ℝ) < a := by exact_mod_cast (by omega : 0 < a)
  have hmaR : (m : ℝ) < (a : ℝ) ^ 4 := by exact_mod_cast hma
  have hm2lt : (m : ℝ) ^ 2 < (a : ℝ) ^ 8 := by
    have hsquare := sq_lt_sq₀ (by positivity : (0 : ℝ) ≤ m)
      (by positivity : (0 : ℝ) ≤ (a : ℝ) ^ 4) |>.2 hmaR
    nlinarith
  have ha10 : 2 * (a : ℝ) ^ 8 ≤ (a : ℝ) ^ 10 := by
    have ha2R : (2 : ℝ) ≤ (a : ℝ) ^ 2 := by
      have : (2 : ℝ) ≤ a := by exact_mod_cast ha2
      nlinarith
    calc
      2 * (a : ℝ) ^ 8 ≤ (a : ℝ) ^ 2 * (a : ℝ) ^ 8 := by gcongr
      _ = (a : ℝ) ^ 10 := by ring
  have hnum : 2 * (m : ℝ) ^ 2 < (a : ℝ) ^ 10 :=
    (mul_lt_mul_of_pos_left hm2lt (by positivity)).trans_le ha10
  calc
    2 * ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) ^ 10 =
        2 / (a : ℝ) ^ 10 := by simp [a, s]; ring
    _ < (1 : ℝ) / (m : ℝ) ^ 2 := by
      apply (div_lt_div_iff₀ (by positivity) (by positivity)).2
      simpa using hnum

/-- Exponent-twenty moment estimate at eighth-root scale.  Three successive
natural square roots give `k < (r+1)^8`; hence every `m ≤ k` has
`2m² < (r+1)^20`.  This is the fixed-parameter moment estimate used by the
sublinear KLS hub extraction. -/
theorem two_mul_inv_succ_sqrt_sqrt_sqrt_pow_twenty_lt_inv_sq
    {k m : ℕ} (hk : 3 ≤ k) (hm1 : 1 ≤ m) (hmk : m ≤ k) :
    2 * ((1 : ℝ) /
        (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1)) ^ 20 <
      (1 : ℝ) / (m : ℝ) ^ 2 := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let r : ℕ := Nat.sqrt q
  let a : ℕ := r + 1
  have ha2 : 2 ≤ a := by
    dsimp [a, r, q, s]
    have hspos : 0 < Nat.sqrt k := Nat.sqrt_pos.mpr (by omega)
    have hqpos : 0 < Nat.sqrt (Nat.sqrt k) := Nat.sqrt_pos.mpr hspos
    have hrpos : 0 < Nat.sqrt (Nat.sqrt (Nat.sqrt k)) :=
      Nat.sqrt_pos.mpr hqpos
    omega
  have hks : k < (s + 1) ^ 2 := by
    dsimp [s]
    exact Nat.lt_succ_sqrt' k
  have hsq : s + 1 ≤ (q + 1) ^ 2 := by
    have h := Nat.lt_succ_sqrt' s
    simpa [q] using h
  have hqr : q + 1 ≤ a ^ 2 := by
    have h := Nat.lt_succ_sqrt' q
    simpa [a, r] using h
  have hsA : s + 1 ≤ a ^ 4 := by
    calc
      s + 1 ≤ (q + 1) ^ 2 := hsq
      _ ≤ (a ^ 2) ^ 2 := Nat.pow_le_pow_left hqr 2
      _ = a ^ 4 := by ring
  have hkA : k < a ^ 8 := by
    exact hks.trans_le <| by
      calc
        (s + 1) ^ 2 ≤ (a ^ 4) ^ 2 := Nat.pow_le_pow_left hsA 2
        _ = a ^ 8 := by ring
  have hmA : m < a ^ 8 := hmk.trans_lt hkA
  have hmR : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have haR : (0 : ℝ) < a := by exact_mod_cast (by omega : 0 < a)
  have hmAR : (m : ℝ) < (a : ℝ) ^ 8 := by exact_mod_cast hmA
  have hm2lt : (m : ℝ) ^ 2 < (a : ℝ) ^ 16 := by
    have hsquare := sq_lt_sq₀ (by positivity : (0 : ℝ) ≤ m)
      (by positivity : (0 : ℝ) ≤ (a : ℝ) ^ 8) |>.2 hmAR
    nlinarith
  have ha20 : 2 * (a : ℝ) ^ 16 ≤ (a : ℝ) ^ 20 := by
    have ha4 : (2 : ℝ) ≤ (a : ℝ) ^ 4 := by
      have ha2R : (2 : ℝ) ≤ a := by exact_mod_cast ha2
      nlinarith [sq_nonneg ((a : ℝ) ^ 2 - 2)]
    calc
      2 * (a : ℝ) ^ 16 ≤ (a : ℝ) ^ 4 * (a : ℝ) ^ 16 := by
        gcongr
      _ = (a : ℝ) ^ 20 := by ring
  have hnum : 2 * (m : ℝ) ^ 2 < (a : ℝ) ^ 20 :=
    (mul_lt_mul_of_pos_left hm2lt (by positivity)).trans_le ha20
  calc
    2 * ((1 : ℝ) /
        (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1)) ^ 20 =
        2 / (a : ℝ) ^ 20 := by simp [a, r, q, s]; ring
    _ < (1 : ℝ) / (m : ℝ) ^ 2 := by
      apply (div_lt_div_iff₀ (by positivity) (by positivity)).2
      simpa using hnum

/-- A parameterized exponent-twenty DRC core estimate at eighth-root scale.
Under the fixed density ratio `k ≤ R * δ`, the raw DRC reservoir has real
size at least `k / R^41`.  Thus `floor (k / (8 * a * R^5))` fits into the
squared DRC lower bound as soon as `R^36 ≤ 4a`.  In the eventual application
`a` is one more than the eighth root of `k`, so this last condition holds for
every sufficiently large `k`. -/
theorem div_eight_mul_a_mul_pow5_sq_le_density_twenty_mul_card_sq_div_two_of_ratio
    {R a k δ m : ℕ} (hR : 0 < R) (ha : 0 < a) (hk : 0 < k)
    (hkδ : k ≤ R * δ) (hδm : δ ≤ m) (hscale : R ^ 36 ≤ 4 * a) :
    ((k / (8 * a * R ^ 5) : ℕ) : ℝ) ^ 2 ≤
      (((((δ : ℝ) / k) ^ 2) ^ 20 * m) ^ 2 / 2) := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hRR : (0 : ℝ) < R := by exact_mod_cast hR
  have haR : (0 : ℝ) < a := by exact_mod_cast ha
  have hratio : (1 : ℝ) / R ≤ (δ : ℝ) / k := by
    apply (le_div_iff₀ hkR).2
    have hkδR : (k : ℝ) ≤ R * δ := by exact_mod_cast hkδ
    rw [show (1 : ℝ) / R * k = (k : ℝ) / R by ring]
    apply (div_le_iff₀ hRR).2
    simpa [mul_comm] using hkδR
  have hratio20 : (((1 : ℝ) / R) ^ 2) ^ 20 ≤
      (((δ : ℝ) / k) ^ 2) ^ 20 := by
    gcongr
  have hkm : k ≤ R * m := hkδ.trans (Nat.mul_le_mul_left R hδm)
  have hkmR : (k : ℝ) / R ≤ m := by
    apply (div_le_iff₀ hRR).2
    exact_mod_cast (show k ≤ m * R by simpa [mul_comm] using hkm)
  have hlow : (k : ℝ) / R ^ 41 ≤
      (((δ : ℝ) / k) ^ 2) ^ 20 * m := by
    calc
      (k : ℝ) / R ^ 41 =
          (((1 : ℝ) / R) ^ 2) ^ 20 * ((k : ℝ) / R) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 20 * m := by gcongr
  have hscaleR : (R : ℝ) ^ 36 ≤ 4 * a := by exact_mod_cast hscale
  have htarget : (k : ℝ) / (8 * a * R ^ 5) ≤
      ((k : ℝ) / R ^ 41) / 2 := by
    have hden : (2 : ℝ) * (R : ℝ) ^ 41 ≤
        8 * (a : ℝ) * (R : ℝ) ^ 5 := by
      calc
        (2 : ℝ) * (R : ℝ) ^ 41 =
            2 * (R : ℝ) ^ 36 * (R : ℝ) ^ 5 := by ring
        _ ≤ 2 * (4 * (a : ℝ)) * (R : ℝ) ^ 5 := by gcongr
        _ = 8 * (a : ℝ) * (R : ℝ) ^ 5 := by ring
    have hk0 : (0 : ℝ) ≤ k := by positivity
    calc
      (k : ℝ) / (8 * a * R ^ 5) ≤ k / (2 * R ^ 41) :=
        div_le_div_of_nonneg_left hk0 (by positivity) hden
      _ = ((k : ℝ) / R ^ 41) / 2 := by ring
  have hdivmul : (k / (8 * a * R ^ 5)) * (8 * a * R ^ 5) ≤ k :=
    Nat.div_mul_le_self k (8 * a * R ^ 5)
  have hτk : ((k / (8 * a * R ^ 5) : ℕ) : ℝ) ≤
      (k : ℝ) / (8 * a * R ^ 5) := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 8 * a * R ^ 5)).2
    exact_mod_cast hdivmul
  have hτhalf : ((k / (8 * a * R ^ 5) : ℕ) : ℝ) ≤
      ((((δ : ℝ) / k) ^ 2) ^ 20 * m) / 2 := by
    calc
      ((k / (8 * a * R ^ 5) : ℕ) : ℝ) ≤
          (k : ℝ) / (8 * a * R ^ 5) := hτk
      _ ≤ ((k : ℝ) / R ^ 41) / 2 := htarget
      _ ≤ ((((δ : ℝ) / k) ^ 2) ^ 20 * m) / 2 :=
        div_le_div_of_nonneg_right hlow (by norm_num)
  nlinarith [sq_nonneg
    (((((δ : ℝ) / k) ^ 2) ^ 20 * m) / 2 -
      ((k / (8 * a * R ^ 5) : ℕ) : ℝ))]

/-- The pair threshold associated with density ratio `1/R` and sampling
parameter `1/a` is at least `floor (k / (2aR^5))`.  This is the second
numerical input to the exponent-twenty hub extraction. -/
theorem div_two_mul_a_mul_pow5_le_inv_a_mul_density_four_mul_card_of_ratio
    {R a k δ m : ℕ} (hR : 0 < R) (ha : 0 < a) (hk : 0 < k)
    (hkδ : k ≤ R * δ) (hδm : δ ≤ m) :
    ((k / (2 * a * R ^ 5) : ℕ) : ℝ) ≤
      ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hRR : (0 : ℝ) < R := by exact_mod_cast hR
  have haR : (0 : ℝ) < a := by exact_mod_cast ha
  have hratio : (1 : ℝ) / R ≤ (δ : ℝ) / k := by
    apply (le_div_iff₀ hkR).2
    have hkδR : (k : ℝ) ≤ R * δ := by exact_mod_cast hkδ
    rw [show (1 : ℝ) / R * k = (k : ℝ) / R by ring]
    apply (div_le_iff₀ hRR).2
    simpa [mul_comm] using hkδR
  have hratio4 : (((1 : ℝ) / R) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkm : k ≤ R * m := hkδ.trans (Nat.mul_le_mul_left R hδm)
  have hkmR : (k : ℝ) / R ≤ m := by
    apply (div_le_iff₀ hRR).2
    exact_mod_cast (show k ≤ m * R by simpa [mul_comm] using hkm)
  have hlow : (k : ℝ) / R ^ 5 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
    calc
      (k : ℝ) / R ^ 5 =
          (((1 : ℝ) / R) ^ 2) ^ 2 * ((k : ℝ) / R) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 2 * m := by gcongr
  have hdivmul : (k / (2 * a * R ^ 5)) * (2 * a * R ^ 5) ≤ k :=
    Nat.div_mul_le_self k (2 * a * R ^ 5)
  have hτk : ((k / (2 * a * R ^ 5) : ℕ) : ℝ) ≤
      (k : ℝ) / (2 * a * R ^ 5) := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2 * a * R ^ 5)).2
    exact_mod_cast hdivmul
  calc
    ((k / (2 * a * R ^ 5) : ℕ) : ℝ) ≤
        (k : ℝ) / (2 * a * R ^ 5) := hτk
    _ ≤ ((1 : ℝ) / a) * ((k : ℝ) / R ^ 5) := by
      have hnonneg : (0 : ℝ) ≤
          ((1 : ℝ) / a) * ((k : ℝ) / R ^ 5) := by positivity
      rw [show (k : ℝ) / (2 * a * R ^ 5) =
        (((1 : ℝ) / a) * ((k : ℝ) / R ^ 5)) / 2 by ring]
      nlinarith
    _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      calc
        ((1 : ℝ) / a) * ((k : ℝ) / R ^ 5) ≤
            ((1 : ℝ) / a) *
              ((((δ : ℝ) / k) ^ 2) ^ 2 * m) := by gcongr
        _ = _ := by ring

/-- The same fourth-root choice makes the DRC pair threshold at least
`8 sqrt k` once the fourth-root is above an explicit constant. -/
theorem eight_mul_sqrt_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m)
    (hfourth : 16 * 64 ^ 5 ≤ Nat.sqrt (Nat.sqrt k)) :
    (8 * Nat.sqrt k : ℝ) ≤
      ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let a : ℕ := q + 1
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio4 : (((1 : ℝ) / 64) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ 64 * m := by
    exact_mod_cast hs2k.trans hkm
  have hq2s : q ^ 2 ≤ s := by
    dsimp [q]
    exact Nat.sqrt_le' s
  have hqbig : 16 * 64 ^ 5 ≤ q := by
    simpa [q, s] using hfourth
  have hbaseN : 8 * a * 64 ^ 5 ≤ s := by
    have hqa : a ≤ 2 * q := by dsimp [a]; omega
    have hmul : 8 * a * 64 ^ 5 ≤ 16 * 64 ^ 5 * q := by
      nlinarith
    have hsq : 16 * 64 ^ 5 * q ≤ q ^ 2 := by
      nlinarith
    exact hmul.trans (hsq.trans hq2s)
  have haR : (0 : ℝ) < a := by dsimp [a]; positivity
  have hsR : (0 : ℝ) ≤ s := by positivity
  have hbaseR : (8 : ℝ) * a * 64 ^ 5 ≤ s := by exact_mod_cast hbaseN
  have height : (8 : ℝ) * s ≤ (s : ℝ) ^ 2 / (a * 64 ^ 5) := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < a * 64 ^ 5)).2
    nlinarith [mul_le_mul_of_nonneg_right hbaseR hsR]
  calc
    (8 * Nat.sqrt k : ℝ) = (8 : ℝ) * s := by simp [s]
    _ ≤ (s : ℝ) ^ 2 / ((a : ℝ) * 64 ^ 5) := height
    _ = ((1 : ℝ) / a) * (((1 : ℝ) / 64) ^ 2) ^ 2 *
        ((s : ℝ) ^ 2 / 64) := by ring
    _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      have hsm : (s : ℝ) ^ 2 / 64 ≤ m := by nlinarith
      gcongr
    _ = ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by simp [a, q, s]

/-- The fourth-root DRC choice in fact retains a pair threshold on the
`k^(3/4)` scale.  We state the threshold with natural-number division so
that it can be fed directly to the compact-target sampling lemma.  The key
estimate is `sqrt(sqrt k) * (sqrt(sqrt k) + 1) ≤ 2 * sqrt k`; unlike the
coarser `8 * sqrt k` consequence above, no extra largeness assumption is
needed. -/
theorem sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
    (hδm : δ ≤ m) :
    ((Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5) : ℕ) : ℝ) ≤
      ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let a : ℕ := q + 1
  have hratio : (1 : ℝ) / 64 ≤ (δ : ℝ) / k :=
    one_div_64_le_delta_div_k_of_pred_div16_sub_one_le_two_mul hk hδ
  have hratio4 : (((1 : ℝ) / 64) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ 64 * m := by
    exact_mod_cast hs2k.trans hkm
  have hq2s : q ^ 2 ≤ s := by
    dsimp [q]
    exact Nat.sqrt_le' s
  have hqs : q ≤ s := by
    dsimp [q]
    exact Nat.sqrt_le_self s
  have hqa : q * a ≤ 2 * s := by
    dsimp [a]
    nlinarith
  have hqaR : (q : ℝ) * a ≤ 2 * s := by exact_mod_cast hqa
  have hsR : (0 : ℝ) ≤ s := by positivity
  have htargetCast :
      ((s * q / (2 * 64 ^ 5) : ℕ) : ℝ) ≤
        ((s * q : ℕ) : ℝ) / ((2 * 64 ^ 5 : ℕ) : ℝ) :=
    Nat.cast_div_le
  have height :
      (s : ℝ) * q / (2 * 64 ^ 5) ≤
        (s : ℝ) ^ 2 / (a * 64 ^ 5) := by
    apply (div_le_div_iff₀ (by positivity : (0 : ℝ) < 2 * 64 ^ 5)
      (by positivity : (0 : ℝ) < a * 64 ^ 5)).2
    have hmul := mul_le_mul_of_nonneg_left hqaR hsR
    norm_num at hmul ⊢
    nlinarith
  calc
    ((Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5) : ℕ) : ℝ) =
        ((s * q / (2 * 64 ^ 5) : ℕ) : ℝ) := by simp [s, q]
    _ ≤ ((s * q : ℕ) : ℝ) / ((2 * 64 ^ 5 : ℕ) : ℝ) := htargetCast
    _ = (s : ℝ) * q / (2 * 64 ^ 5) := by norm_num
    _ ≤ (s : ℝ) ^ 2 / ((a : ℝ) * 64 ^ 5) := height
    _ = ((1 : ℝ) / a) * (((1 : ℝ) / 64) ^ 2) ^ 2 *
        ((s : ℝ) ^ 2 / 64) := by ring
    _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      have hsm : (s : ℝ) ^ 2 / 64 ≤ m := by nlinarith
      gcongr
    _ = ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by simp [a, q, s]

/-- Parameterized exponent-ten pair-threshold estimate.  The fixed constant
`64` in the preceding theorem is only a lower bound for the reciprocal
density.  If the source extraction gives the abstract ratio `k ≤ R * δ`,
the identical calculation retains pair threshold
`sqrt k * sqrt (sqrt k) / (2 * R^5)`. -/
theorem sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card_of_ratio
    {R k δ m : ℕ} (hR : 0 < R) (hk : 0 < k)
    (hkδ : k ≤ R * δ) (hδm : δ ≤ m) :
    ((Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * R ^ 5) : ℕ) : ℝ) ≤
      ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let a : ℕ := q + 1
  have hRR : (0 : ℝ) < R := by exact_mod_cast hR
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hratio : (1 : ℝ) / R ≤ (δ : ℝ) / k := by
    apply (le_div_iff₀ hkR).2
    have hkδR : (k : ℝ) ≤ R * δ := by exact_mod_cast hkδ
    have hstep : (k : ℝ) / R ≤ δ := (div_le_iff₀ hRR).2 (by
      simpa [mul_comm] using hkδR)
    simpa [one_div, div_eq_mul_inv, mul_comm, mul_left_comm,
      mul_assoc] using hstep
  have hratio4 : (((1 : ℝ) / R) ^ 2) ^ 2 ≤
      (((δ : ℝ) / k) ^ 2) ^ 2 := by
    gcongr
  have hkm : k ≤ R * m := hkδ.trans (Nat.mul_le_mul_left R hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ R * m := by
    exact_mod_cast hs2k.trans hkm
  have hq2s : q ^ 2 ≤ s := by
    dsimp [q]
    exact Nat.sqrt_le' s
  have hqs : q ≤ s := by
    dsimp [q]
    exact Nat.sqrt_le_self s
  have hqa : q * a ≤ 2 * s := by
    dsimp [a]
    nlinarith
  have hqaR : (q : ℝ) * a ≤ 2 * s := by exact_mod_cast hqa
  have hsR : (0 : ℝ) ≤ s := by positivity
  have htargetCast :
      ((s * q / (2 * R ^ 5) : ℕ) : ℝ) ≤
        ((s * q : ℕ) : ℝ) / ((2 * R ^ 5 : ℕ) : ℝ) :=
    Nat.cast_div_le
  have height :
      (s : ℝ) * q / (2 * (R : ℝ) ^ 5) ≤
        (s : ℝ) ^ 2 / (a * (R : ℝ) ^ 5) := by
    apply (div_le_div_iff₀
      (by positivity : (0 : ℝ) < 2 * (R : ℝ) ^ 5)
      (by positivity : (0 : ℝ) < a * (R : ℝ) ^ 5)).2
    have hmul := mul_le_mul_of_nonneg_left hqaR hsR
    calc
      (s : ℝ) * q * (a * (R : ℝ) ^ 5) =
          ((s : ℝ) * (q * a)) * (R : ℝ) ^ 5 := by ring
      _ ≤ ((s : ℝ) * (2 * s)) * (R : ℝ) ^ 5 :=
        mul_le_mul_of_nonneg_right hmul (by positivity)
      _ = (s : ℝ) ^ 2 * (2 * (R : ℝ) ^ 5) := by ring
  calc
    ((Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * R ^ 5) : ℕ) : ℝ) =
        ((s * q / (2 * R ^ 5) : ℕ) : ℝ) := by simp [s, q]
    _ ≤ ((s * q : ℕ) : ℝ) / ((2 * R ^ 5 : ℕ) : ℝ) := htargetCast
    _ = (s : ℝ) * q / (2 * (R : ℝ) ^ 5) := by push_cast; rfl
    _ ≤ (s : ℝ) ^ 2 / ((a : ℝ) * (R : ℝ) ^ 5) := height
    _ = ((1 : ℝ) / a) * (((1 : ℝ) / R) ^ 2) ^ 2 *
        ((s : ℝ) ^ 2 / R) := by ring
      _ ≤ ((1 : ℝ) / a) * (((δ : ℝ) / k) ^ 2) ^ 2 * m := by
      have hsm : (s : ℝ) ^ 2 / R ≤ m := (div_le_iff₀ hRR).2 (by
        simpa [mul_comm] using hs2m)
      gcongr
    _ = ((1 : ℝ) / (Nat.sqrt (Nat.sqrt k) + 1)) *
        (((δ : ℝ) / k) ^ 2) ^ 2 * m := by simp [a, q, s]

/-- With exponent ten the same density input retains a core of order at
least `9 sqrt k`; the twentieth density power costs only the fixed factor
`64^21`, which is absorbed by the explicit square-root threshold. -/
theorem nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two
    {k δ m : ℕ} (hk : 64 ≤ k)
    (hδ : (k - 1) / 16 - 1 ≤ 2 * δ)
