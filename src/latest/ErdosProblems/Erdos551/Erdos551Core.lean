/-- Thin alternating-reservoir refinement.  The alternating scaffold still
has `9 * sqrt k` vertices on each side, but the connector set now has size
`O(k^(3/8)) = o(sqrt k)`.  This is the quantitative form needed when the
stable-block argument charges every connector vertex. -/
theorem exists_disjoint_thin_compact_alternating_nine_sqrt_hub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * 64 ^ 21 ≤ Nat.sqrt k)
    (hreserve : 2 * (9 * Nat.sqrt k) ≤
      Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5))
    (hsample :
      let s := Nat.sqrt k
      let r := Nat.sqrt (Nat.sqrt s)
      let sigma : ℝ≥0 := 1 / ((s * r : ℕ) : ℝ≥0)
      let K := 8 * (s / r + 1)
      ((((9 * s) * (9 * s) : ℕ) : ℝ≥0) *
          ((1 - sigma / 2) ^
              (s * Nat.sqrt s / (2 * 64 ^ 5) - 2 * (9 * s)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * sigma) / K) < 1) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactAlternatingHub G 7
        (9 * Nat.sqrt k)
        (2 * (9 * Nat.sqrt k) +
          8 * (Nat.sqrt k / Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1)) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  let d : ℕ := (k - 1) / 16 - 1
  let Θ : ℕ := Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5)
  let τ : ℕ := 9 * Nat.sqrt k
  let r : ℕ := Nat.sqrt (Nat.sqrt (Nat.sqrt k))
  let K : ℕ := 8 * (Nat.sqrt k / r + 1)
  let sigma : ℝ≥0 := 1 / (((Nat.sqrt k) * r : ℕ) : ℝ≥0)
  have hd : 0 < d := by dsimp [d]; omega
  have hspos : 0 < Nat.sqrt k := by omega
  have hrpos : 0 < r := by
    dsimp [r]
    positivity
  have hτpos : 0 < τ := by dsimp [τ]; positivity
  have hKpos : 0 < K := by dsimp [K]; positivity
  have hsigma : sigma ≤ 1 := by
    dsimp [sigma]
    rw [div_le_one]
    · exact_mod_cast
        (Nat.one_le_iff_ne_zero.mpr
          (Nat.mul_ne_zero (Nat.ne_of_gt hspos) (Nat.ne_of_gt hrpos)))
    · exact_mod_cast (Nat.mul_pos hspos hrpos)
  apply exists_disjoint_compactAlternatingHub_family
    G hτpos (by simpa [τ, Θ] using hreserve) hKpos sigma hsigma
    (m := 16 * ((n - 1) * (d + 1)))
    (Dmax := k) (Θ := Θ) (r := 6)
  · intro S hSsize
    apply exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
      G hn hd hfree hSsize (by omega) hroom hcycle (by omega : 0 < 10)
        hτpos (by positivity :
          (0 : ℝ) < 1 / (Nat.sqrt (Nat.sqrt k) + 1))
    · intro δ m hδ hδm _hmk
      simpa [Θ, d] using
        (sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
          hk hδ hδm)
    · intro δ m hδ hδm _hmk
      simpa [τ, d] using
        nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two
          hk hδ hδm hsqrt
    · intro m hm1 hmk
      exact two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
        (by omega) hm1 hmk
  · simpa [τ, K, Θ, r, sigma] using hsample

/-- The thin alternating-hub decomposition is available uniformly at all
sufficiently large target lengths. -/
theorem eventually_exists_disjoint_thin_compact_alternating_nine_sqrt_hub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ} :
    ∀ᶠ k : ℕ in atTop,
