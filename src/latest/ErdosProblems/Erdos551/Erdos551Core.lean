/-- Denominator-parameterized exponential domination for the thin-target
sampling estimate.  This is the same analytic fact as the fixed-64 version,
but its decay rate may be any fixed positive reciprocal. -/
theorem eventually_octavic_mul_exp_neg_lt_half_of_denominator
    (C : ℕ) (hC : 0 < C) :
    ∀ᶠ x : ℝ in atTop,
      (21233664 * Real.exp (19 / 2) : ℝ) *
          (x ^ 8 * Real.exp (-(1 / (2 * C : ℝ)) * x)) < 1 / 2 := by
