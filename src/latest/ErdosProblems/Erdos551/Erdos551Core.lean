    (hregions : ∀ i j : ι, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hparity : ∀ i : ι, HasThreeDisjointAdjPairFamily G (U i))
    (hU : ∀ i : ι, 9 * Nat.sqrt k ≤ (U i).card)
    (hθ : 8 * Nat.sqrt k ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (c : (LargeCrossMatchingGraph G W R).ConnectedComponent) :
    c.supp.ncard < Nat.sqrt k + 1 := by
  let H : SimpleGraph ι := LargeCrossMatchingGraph G W R
  let K : SimpleGraph c := c.toSimpleGraph
  let Uc : c → Finset V := fun i => U i.1
  let Tc : c → Finset V := fun i => T i.1
  have hKlarge : ∀ i j : c, K.Adj i j →
      HasCrossMatchingAtLeast G (Uc i) (Uc j) R := by
    intro i j hij
    apply HasCrossMatchingAtLeast.mono_sets
      (hasCrossMatchingAtLeast_of_largeCrossMatchingGraph_adj
        (G := G) (U := W) (m := R) ?_)
      (hWU i.1) (hWU j.1)
    apply (c.toSimpleGraph_adj i.property j.property).mp
    simpa [K, H] using hij
  have hKregions : ∀ i j : c, i ≠ j →
      Disjoint (Uc i ∪ Tc i) (Uc j ∪ Tc j) := by
    intro i j hij
    apply hregions i.1 j.1
    intro h
    exact hij (Subtype.ext h)
  have hKcard : Fintype.card c < Nat.sqrt k + 1 := by
    apply card_lt_succ_sqrt_of_cycleFree_connected_largeCrossMatching
      G K Uc Tc c.connected_toSimpleGraph hsqrt hmatchBudget hKlarge
        (fun i => hrob i.1) hKregions
        (fun i => hasCrossMatchingAtLeast_self_three_of_hasThree
          (hparity i.1))
        (fun i => hU i.1) hθ hcycle
  have hcCard : Fintype.card c = c.supp.ncard := by
    calc
      Fintype.card c = Fintype.card c.supp := by
        apply Fintype.card_congr
        exact
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
            left_inv := fun x => by ext; rfl
            right_inv := fun x => by ext; rfl }
      _ = c.supp.ncard := Set.fintypeCard_eq_ncard c.supp
  simpa [hcCard] using hKcard

/-- Connected-component form of the exact all-parity lift.  A spanning-tree
tour replaces an assumed auxiliary closed walk, so every numerical hypothesis
is expressed in terms of the number of auxiliary vertices. -/
theorem cycleGraph_isContained_of_connected_largeCrossMatching_component
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (H : SimpleGraph ι) (U T : ι → Finset V)
    {ℓ s θ R k : ℕ} (hconn : H.Connected)
    (hcard : 2 ≤ Fintype.card ι)
    (hmatchBudget : 2 * (2 * (Fintype.card ι - 1)) < R)
    (hlarge : ∀ i j : ι, H.Adj i j →
      HasCrossMatchingAtLeast G (U i) (U j) R)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) θ)
    (hℓ : 5 ≤ ℓ)
    (hparity : ∀ i : ι, HasCrossMatchingAtLeast G (U i) (U i)
      (2 * (2 * (Fintype.card ι - 1) - 1) + 3))
    (hFirstU : ∀ i : ι,
      2 * (2 * (Fintype.card ι - 1) - 1) + ℓ ≤ (U i).card)
    (hFirstθ : 2 * (2 * (Fintype.card ι - 1) - 1) + ℓ + 1 ≤ θ)
    (hRestU : ∀ i : ι,
      ℓ + 1 + (2 * (Fintype.card ι - 1) - 1) *
        (2 * (s + 1) + 1) + (s + 2) ≤ (U i).card)
    (hRestθ : ℓ + 1 + (2 * (Fintype.card ι - 1) - 1) *
      (2 * (s + 1) + 1) ≤ θ)
    (hlen : ℓ + (2 * (Fintype.card ι - 1) - 1) *
      (2 * (s + 1)) + 2 * (Fintype.card ι - 1) = k) :
    cycleGraph k ⊑ G := by
  obtain ⟨r, w, hwlen, _hwcov⟩ :=
    Erdos551.SimpleGraph.Connected.exists_closed_walk_length_twice_card_sub_one
      H hconn
  apply cycleGraph_isContained_of_closed_largeCrossMatching_walk_residual
    G H U T w
  · rw [hwlen]
    omega
  · rw [hwlen]
    exact hmatchBudget
  · exact hlarge
  · exact hrob
  · exact hℓ
  · simpa [hwlen] using hparity r
  · simpa [hwlen] using hFirstU r
  · simpa [hwlen] using hFirstθ
  · intro i hi
    simpa [hwlen] using hRestU (w.getVert i.val)
  · simpa [hwlen] using hRestθ
  · simpa [hwlen] using hlen

