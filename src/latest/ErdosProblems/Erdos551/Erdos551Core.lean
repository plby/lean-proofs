      (((δ : ℝ) / k) ^ 2) ^ 10 := by
    gcongr
  have hkδ : k ≤ 64 * δ :=
    k_le_64_mul_of_pred_div16_sub_one_le_two_mul hk hδ
  have hkm : k ≤ 64 * m := hkδ.trans (Nat.mul_le_mul_left 64 hδm)
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hs2m : (s : ℝ) ^ 2 ≤ 64 * m := by
    exact_mod_cast hs2k.trans hkm
  have hslarge : 18 * 64 ^ 21 ≤ s := by simpa [s] using hsqrt
  have hbase : (18 : ℝ) * s ≤ (s : ℝ) ^ 2 / 64 ^ 21 := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 64 ^ 21)).2
    have hslargeR : (18 : ℝ) * 64 ^ 21 ≤ s := by exact_mod_cast hslarge
    have hsnonneg : (0 : ℝ) ≤ s := by positivity
    nlinarith [mul_le_mul_of_nonneg_right hslargeR hsnonneg]
  have hlow : (18 : ℝ) * s ≤ (((δ : ℝ) / k) ^ 2) ^ 10 * m := by
    calc
      (18 : ℝ) * s ≤ (s : ℝ) ^ 2 / 64 ^ 21 := hbase
      _ = (((1 : ℝ) / 64) ^ 2) ^ 10 * ((s : ℝ) ^ 2 / 64) := by ring
      _ ≤ (((δ : ℝ) / k) ^ 2) ^ 10 * m := by
        have hsm : (s : ℝ) ^ 2 / 64 ≤ m := by nlinarith
        gcongr
  have hsnonneg : (0 : ℝ) ≤ s := by positivity
  have hxnonneg : (0 : ℝ) ≤ (((δ : ℝ) / k) ^ 2) ^ 10 * m := by positivity
  change ((9 * s : ℕ) : ℝ) ^ 2 ≤ _
  push_cast
  nlinarith [sq_nonneg
    (((((δ : ℝ) / k) ^ 2) ^ 10 * m) - (18 : ℝ) * s)]

/-- Parameterized exponent-ten core-size estimate.  Under the abstract
density-ratio input `k ≤ R * δ`, a square-root threshold of
`18 * R^21` retains an exact core of order `9 * sqrt k`. -/
theorem nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two_of_ratio
    {R k δ m : ℕ} (hR : 0 < R) (hk : 0 < k)
