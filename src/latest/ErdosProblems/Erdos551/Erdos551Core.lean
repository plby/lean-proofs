          _ = y.1 := hliftval y
      map_rel_iff' := by
        intro x y
        change G.Adj (lift x).1.1 (lift y).1.1 ↔ G.Adj x.1 y.1
        simp [hliftval x, hliftval y] }
  let q : K.Walk (e a) (e b) := p.map e.toHom
  have hqpath : q.IsPath := hp.map e.injective
  have hqsupp : ∀ z ∈ q.support,
      z ∈ parityBfsLayerUnion K root j parity := by
    intro z hz
    dsimp [q] at hz
    rw [Walk.support_map] at hz
    rcases List.mem_map.mp hz with ⟨y, hy, rfl⟩
    have hyH : (y : V) ∈ H := y.property
    have hyH' : (y : V) ∈
        (parityBfsLayerUnion K root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩ := by
      change (y : V) ∈
        (parityBfsLayerUnion c.toSimpleGraph root j parity).map
          ⟨fun x => x.1.1, by
            intro x y hxy
            exact Subtype.ext (Subtype.ext hxy)⟩
      rw [← hHeq]
      exact hyH
    rcases Finset.mem_map.mp hyH' with ⟨x, hx, hxval⟩
    have hxy : x = e y := by
      apply Subtype.ext
      apply Subtype.ext
      calc
        x.1.1 = y.1 := hxval
        _ = (lift y).1.1 := (hliftval y).symm
    simpa [hxy] using hx
  have hKconn : K.Connected := by
