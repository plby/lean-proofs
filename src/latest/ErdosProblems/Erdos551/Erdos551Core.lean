  filter_upwards [eventually_ge_atTop 64,
    (tendsto_nat_sqrt_atTop.eventually
      (eventually_ge_atTop (18 * 64 ^ 21))),
    eventually_compact_sampling_inequality] with k hk hsqrt hsample
  intro hn hfree hroom hcycle
  exact
    exists_disjoint_compact_seven_nine_sqrt_localRobustHub_family_of_two_pass_cycleFree
      G hk hn hfree hroom hcycle hsqrt hsample

/-- Alternating-reservoir refinement of the compact two-pass decomposition.
Before sampling connectors we reserve an alternating cycle with
`9 * sqrt k` vertices on each side.  The retained connector set has pair
threshold seven, and the whole displayed hub has fewer than
`2 * (9 * sqrt k) + 8 * sqrt k` vertices. -/
theorem exists_disjoint_compact_alternating_nine_sqrt_hub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {k n : ℕ} (hk : 64 ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * 64 ^ 21 ≤ Nat.sqrt k)
    (hreserve : 2 * (9 * Nat.sqrt k) ≤
      Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5))
    (hsample :
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5) -
                2 * (9 * Nat.sqrt k)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactAlternatingHub G 7
        (9 * Nat.sqrt k) (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  let d : ℕ := (k - 1) / 16 - 1
  let Θ : ℕ := Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5)
  let τ : ℕ := 9 * Nat.sqrt k
  let K : ℕ := 8 * Nat.sqrt k
  let sigma : ℝ≥0 := 1 / (Nat.sqrt k : ℝ≥0)
  have hd : 0 < d := by dsimp [d]; omega
  have hspos : 0 < Nat.sqrt k := by omega
  have hτpos : 0 < τ := by dsimp [τ]; positivity
  have hKpos : 0 < K := by dsimp [K]; positivity
  have hsigma : sigma ≤ 1 := by
    dsimp [sigma]
    rw [div_le_one]
    · exact_mod_cast (show 1 ≤ Nat.sqrt k by omega)
    · exact_mod_cast hspos
  apply exists_disjoint_compactAlternatingHub_family
    G hτpos (by simpa [τ, Θ] using hreserve) hKpos sigma hsigma
    (m := 16 * ((n - 1) * (d + 1)))
    (Dmax := k) (Θ := Θ) (r := 6)
  · intro S hSsize
    apply exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
      G hn hd hfree hSsize (by omega) hroom hcycle (by omega : 0 < 10)
        hτpos (by positivity :
          (0 : ℝ) < 1 / (Nat.sqrt (Nat.sqrt k) + 1))
    · intro δ m hδ hδm _hmk
      simpa [Θ, d] using
        (sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card
          hk hδ hδm)
    · intro δ m hδ hδm _hmk
      simpa [τ, d] using
        nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two
          hk hδ hδm hsqrt
    · intro m hm1 hmk
      exact two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
        (by omega) hm1 hmk
  · simpa [τ, K, Θ, sigma] using hsample

/-- Flexible-divisor compact alternating-hub decomposition.  Replacing the
fixed divisor `16` by any `B ≥ 16` shrinks the greedy uncovered cutoff to the
`16 / B` scale.  The price is only in the fixed DRC ratio `R = 4B`; the
preceding parameterized exponent-ten estimates retain the same exact
`9 * sqrt k` alternating cores. -/
theorem exists_disjoint_compact_alternating_nine_sqrt_hub_family_of_divisor_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {B k n : ℕ} (hB : 16 ≤ B) (hk : 4 * B ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * (4 * B) ^ 21 ≤ Nat.sqrt k)
    (hreserve : 2 * (9 * Nat.sqrt k) ≤
      Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * (4 * B) ^ 5))
    (hsample :
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * (4 * B) ^ 5) -
                2 * (9 * Nat.sqrt k)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1) :
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactAlternatingHub G 7
        (9 * Nat.sqrt k) (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / B - 1) + 1)) := by
  let d : ℕ := (k - 1) / B - 1
  let R : ℕ := 4 * B
  let Θ : ℕ := Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * R ^ 5)
  let τ : ℕ := 9 * Nat.sqrt k
  let K : ℕ := 8 * Nat.sqrt k
  let sigma : ℝ≥0 := 1 / (Nat.sqrt k : ℝ≥0)
  have hBpos : 0 < B := by omega
  have hRpos : 0 < R := by dsimp [R]; positivity
  have hd : 0 < d := by
    dsimp [d]
    have hq3 : 3 ≤ (k - 1) / B := by
      apply (Nat.le_div_iff_mul_le hBpos).2
      omega
    omega
  have hkpos : 0 < k := by omega
  have hspos : 0 < Nat.sqrt k := by
    exact Nat.sqrt_pos.mpr hkpos
  have hτpos : 0 < τ := by dsimp [τ]; positivity
  have hKpos : 0 < K := by dsimp [K]; positivity
  have hsigma : sigma ≤ 1 := by
    dsimp [sigma]
    rw [div_le_one]
    · exact_mod_cast (show 1 ≤ Nat.sqrt k by omega)
    · exact_mod_cast hspos
  apply exists_disjoint_compactAlternatingHub_family
    G hτpos (by simpa [τ, Θ, R] using hreserve) hKpos sigma hsigma
    (m := 16 * ((n - 1) * (d + 1)))
    (Dmax := k) (Θ := Θ) (r := 6)
  · intro S hSsize
    apply exists_localRobustHub_in_finset_of_large_indepSetFree_cycleFree
      G hn hd hfree hSsize (by omega) hroom hcycle (by omega : 0 < 10)
        hτpos (by positivity :
          (0 : ℝ) < 1 / (Nat.sqrt (Nat.sqrt k) + 1))
    · intro δ m hδ hδm _hmk
      have hkδ : k ≤ R * δ := by
        simpa [R, d] using
          (k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul
            hBpos hk hδ)
      simpa [Θ] using
        (sqrt_mul_sqrt_sqrt_div_le_inv_succ_sqrt_sqrt_mul_density_four_mul_card_of_ratio
          hRpos hkpos hkδ hδm)
    · intro δ m hδ hδm _hmk
      have hkδ : k ≤ R * δ := by
        simpa [R, d] using
          (k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul
            hBpos hk hδ)
      simpa [τ, R] using
        (nine_mul_sqrt_sq_le_density_ten_mul_card_sq_div_two_of_ratio
          hRpos hkpos hkδ hδm (by simpa [R] using hsqrt))
    · intro m hm1 hmk
      exact two_mul_inv_succ_sqrt_sqrt_pow_ten_lt_inv_sq
        (by omega) hm1 hmk
  · simpa [τ, K, Θ, sigma, R] using hsample

/-- Uniform numerical package for any fixed divisor `B`.  Natural square
roots and fourth roots tend to infinity, while the denominator-parameterized
first-moment estimate is eventual; hence all hypotheses of the flexible
compact alternating-hub decomposition hold simultaneously. -/
theorem eventually_divisor_compact_alternating_hub_numerics
    (B : ℕ) (hB : 16 ≤ B) :
    ∀ᶠ k : ℕ in atTop,
      4 * B ≤ k ∧
      18 * (4 * B) ^ 21 ≤ Nat.sqrt k ∧
      2 * (9 * Nat.sqrt k) ≤
        Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * (4 * B) ^ 5) ∧
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * (4 * B) ^ 5) -
                2 * (9 * Nat.sqrt k)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1 := by
  let R : ℕ := 4 * B
  let C : ℕ := 2 * R ^ 5
  have hR : 0 < R := by dsimp [R]; omega
  have hC : 0 < C := by dsimp [C]; positivity
  filter_upwards [eventually_ge_atTop (4 * B),
    tendsto_nat_sqrt_atTop.eventually
      (eventually_ge_atTop (18 * R ^ 21)),
    (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop).eventually
      (eventually_ge_atTop (36 * R ^ 5)),
    eventually_compact_alternating_sampling_inequality_of_denominator C hC]
      with k hk hsqrt hfourth hsample
  refine ⟨hk, by simpa [R] using hsqrt, ?_, ?_⟩
  · apply (Nat.le_div_iff_mul_le hC).2
    calc
      2 * (9 * Nat.sqrt k) * C =
          Nat.sqrt k * (36 * R ^ 5) := by simp [C]; ring
      _ ≤ Nat.sqrt k * Nat.sqrt (Nat.sqrt k) :=
        Nat.mul_le_mul_left _ hfourth
  · simpa [C, R] using hsample

/-- Bundled structural output of the flexible compact decomposition.  It
selects the exact alternating core, its cycle side, and its connector set
inside every greedy region, preserves the equality with that region, and
records the resulting lower count on the number of regions. -/
theorem exists_divisor_compact_alternating_core_family_of_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {B k n : ℕ} (hB : 16 ≤ B) (hk : 4 * B ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hsqrt : 18 * (4 * B) ^ 21 ≤ Nat.sqrt k)
    (hreserve : 2 * (9 * Nat.sqrt k) ≤
      Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * (4 * B) ^ 5))
    (hsample :
      ((((9 * Nat.sqrt k) * (9 * Nat.sqrt k) : ℕ) : ℝ≥0) *
          ((1 - (1 / (Nat.sqrt k : ℝ≥0)) / 2) ^
              (Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * (4 * B) ^ 5) -
                2 * (9 * Nat.sqrt k)) /
            (1 / 2 : ℝ≥0) ^ 6) +
        ((k : ℝ≥0) * (1 / (Nat.sqrt k : ℝ≥0))) /
          (8 * Nat.sqrt k)) < 1) :
    ∃ F : Finset (Finset V), ∃ A Bside D : F → Finset V,
      (∀ i : F,
        (A i).card = 9 * Nat.sqrt k ∧
        (Bside i).card = 9 * Nat.sqrt k ∧
        Disjoint (A i) (Bside i) ∧
        Disjoint (A i ∪ Bside i) (D i) ∧
        (i : Finset V) = (A i ∪ Bside i) ∪ D i ∧
        (i : Finset V).card <
          2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k ∧
        IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (Bside i) ∧
        RobustPairSet G (A i) (D i) 7) ∧
      (∀ i j : F, i ≠ j →
        Disjoint ((A i ∪ Bside i) ∪ D i)
          ((A j ∪ Bside j) ∪ D j)) ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / B - 1) + 1)) ∧
      Fintype.card V <
        16 * ((n - 1) * (((k - 1) / B - 1) + 1)) +
          (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) * F.card := by
  classical
  obtain ⟨F, hhub, hdisj, hcover, hleft⟩ :=
    exists_disjoint_compact_alternating_nine_sqrt_hub_family_of_divisor_two_pass_cycleFree
      G hB hk hn hfree hroom hcycle hsqrt hreserve hsample
  have hchoice : ∀ i : F, ∃ A Bside D : Finset V,
      A.card = 9 * Nat.sqrt k ∧ Bside.card = 9 * Nat.sqrt k ∧
      Disjoint A Bside ∧ Disjoint (A ∪ Bside) D ∧
      (i : Finset V) = (A ∪ Bside) ∪ D ∧
      (i : Finset V).card <
        2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k ∧
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) A Bside ∧
      RobustPairSet G A D 7 := by
    intro i
    simpa [IsCompactAlternatingHub] using hhub i.1 i.2
  choose A Bside D hdata using hchoice
  have hregions : ∀ i j : F, i ≠ j →
      Disjoint ((A i ∪ Bside i) ∪ D i)
        ((A j ∪ Bside j) ∪ D j) := by
    intro i j hij
    rw [← (hdata i).2.2.2.2.1, ← (hdata j).2.2.2.2.1]
    apply hdisj i i.2 j j.2
    intro h
    exact hij (Subtype.ext h)
  have hsize : ∀ H ∈ F,
      H.card ≤ 2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k := by
    intro H hH
    have hi := (hdata (⟨H, hH⟩ : F)).2.2.2.2.2.1
    exact hi.le
  have hunion : (F.biUnion id).card ≤
      F.card * (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) :=
    Finset.card_biUnion_le_card_mul F id _ hsize
  have hunion' : (F.biUnion id).card ≤
      (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) * F.card := by
    simpa [Nat.mul_comm] using hunion
  have hsplit :
      ((Finset.univ : Finset V) \ F.biUnion id).card +
          (F.biUnion id).card = Fintype.card V := by
    simpa using Finset.card_sdiff_add_card_eq_card hcover
  have hcount : Fintype.card V <
      16 * ((n - 1) * (((k - 1) / B - 1) + 1)) +
        (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) * F.card := by
    omega
  exact ⟨F, A, Bside, D, hdata, hregions, hcover, hleft, hcount⟩

/-- For every fixed finite graph, the structured alternating-hub family is
available uniformly for all sufficiently large requested cycle lengths. -/
theorem eventually_exists_disjoint_compact_alternating_nine_sqrt_hub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ} :
    ∀ᶠ k : ℕ in atTop,
      2 ≤ n → G.IndepSetFree n →
      3 * Nat.log 2 (Fintype.card V) + 1 ≤ k →
      ¬ cycleGraph k ⊑ G →
      ∃ F : Finset (Finset V),
        (∀ H ∈ F, IsCompactAlternatingHub G 7
          (9 * Nat.sqrt k) (2 * (9 * Nat.sqrt k) + 8 * Nat.sqrt k) H) ∧
        DisjointFinsetFamily F ∧
        F.biUnion id ⊆ Finset.univ ∧
        ((Finset.univ : Finset V) \ F.biUnion id).card <
          16 * ((n - 1) * (((k - 1) / 16 - 1) + 1)) := by
  filter_upwards [eventually_ge_atTop 64,
    tendsto_nat_sqrt_atTop.eventually
      (eventually_ge_atTop (18 * 64 ^ 21)),
    (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop).eventually
      (eventually_ge_atTop (19 * (2 * 64 ^ 5))),
    eventually_compact_alternating_sampling_inequality]
      with k hk hsqrt hqbig hsample
  intro hn hfree hroom hcycle
  have hq : 18 * (2 * 64 ^ 5) ≤ Nat.sqrt (Nat.sqrt k) := by
    exact (Nat.mul_le_mul_right (2 * 64 ^ 5)
      (by norm_num : 18 ≤ 19)).trans hqbig
  have hreserve : 2 * (9 * Nat.sqrt k) ≤
      Nat.sqrt k * Nat.sqrt (Nat.sqrt k) / (2 * 64 ^ 5) := by
    apply (Nat.le_div_iff_mul_le (by positivity : 0 < 2 * 64 ^ 5)).2
    calc
      2 * (9 * Nat.sqrt k) * (2 * 64 ^ 5) =
          Nat.sqrt k * (18 * (2 * 64 ^ 5)) := by ring
      _ ≤ Nat.sqrt k * Nat.sqrt (Nat.sqrt k) :=
        Nat.mul_le_mul_left _ hq
  exact
    exists_disjoint_compact_alternating_nine_sqrt_hub_family_of_two_pass_cycleFree
