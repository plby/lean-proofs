      ((Nat.div_eq_zero_iff).mp hzero).resolve_left (by positivity)
    omega
  apply exists_disjoint_bounded_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 6)
      hτpos (by positivity : (0 : ℝ) < 1 / (Nat.sqrt k + 1))
  · intro δ m hδ hδm _hmk
    have hkδ : k ≤ (4 * B) * δ :=
      k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul hBpos hk hδ
    exact sqrt_div_two_mul_pow5_le_inv_succ_sqrt_mul_density_four_mul_card_of_ratio
      (by positivity : 0 < 4 * B) hkpos hkδ hδm
  · intro δ m hδ hδm _hmk
    have hkδ : k ≤ (4 * B) * δ :=
      k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul hBpos hk hδ
    simpa using div_two_mul_pow13_sq_le_density_six_mul_card_sq_div_two_of_ratio
      (by positivity : 0 < 4 * B) hkpos hkδ hδm
  · intro m hm1 hmk
    exact two_mul_inv_succ_sqrt_pow_six_lt_inv_sq (by omega) hm1 hmk

/-- Eighth-root-scale fixed-divisor hub decomposition.  Compared with the
square-root family, the DRC moment is raised to twenty and the sampling
parameter is `1/(⌊k^(1/8)⌋+1)`.  The selected robust core consequently has
order `k^(1-o(1))`, on the explicit scale `k/(8aR^5)`, while every peeled
region still has at most `k` vertices. -/
theorem exists_disjoint_bounded_divisor_eighthRoot_localRobustHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {B k n : ℕ} (hB : 16 ≤ B) (hk : 4 * B ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hscale : (4 * B) ^ 36 ≤
      4 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1))
    (hpositive : 8 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) *
      (4 * B) ^ 5 ≤ k) :
    let a := Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1
    let R := 4 * B
    let Θ := k / (2 * a * R ^ 5)
    let τ := k / (8 * a * R ^ 5)
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsLocalRobustHub G Θ τ H ∧ H.card ≤ k) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / B - 1) + 1)) := by
  let a : ℕ := Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1
  let R : ℕ := 4 * B
  let Θ : ℕ := k / (2 * a * R ^ 5)
  let τ : ℕ := k / (8 * a * R ^ 5)
  have hBpos : 0 < B := by omega
  have hRpos : 0 < R := by dsimp [R]; positivity
  have hkpos : 0 < k := by omega
  have hapos : 0 < a := by dsimp [a]; positivity
  have hd : 0 < (k - 1) / B - 1 := by
    have hq3 : 3 ≤ (k - 1) / B := by
      apply (Nat.le_div_iff_mul_le hBpos).2
      omega
    omega
  have hτpos : 0 < τ := by
    dsimp [τ]
    exact Nat.div_pos hpositive (by positivity)
  apply exists_disjoint_bounded_localRobustHub_family_of_two_pass_cycleFree
    G hn hd hfree (by omega) hroom hcycle (by omega : 0 < 20)
      hτpos (by positivity : (0 : ℝ) < 1 / a)
  · intro δ m hδ hδm _hmk
    have hkδ : k ≤ R * δ := by
      simpa [R] using
        (k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul
          hBpos hk hδ)
    simpa [Θ] using
      (div_two_mul_a_mul_pow5_le_inv_a_mul_density_four_mul_card_of_ratio
        hRpos hapos hkpos hkδ hδm)
  · intro δ m hδ hδm _hmk
    have hkδ : k ≤ R * δ := by
      simpa [R] using
        (k_le_four_mul_divisor_mul_of_pred_div_sub_one_le_two_mul
          hBpos hk hδ)
    simpa [τ] using
      (div_eight_mul_a_mul_pow5_sq_le_density_twenty_mul_card_sq_div_two_of_ratio
        hRpos hapos hkpos hkδ hδm (by simpa [R, a] using hscale))
  · intro m hm1 hmk
    simpa [a] using
      (two_mul_inv_succ_sqrt_sqrt_sqrt_pow_twenty_lt_inv_sq
        (by omega) hm1 hmk)

/-- Reserve an alternating cycle directly inside a bounded local robust hub.
No connector sampling is needed: after selecting an exact core `A` and its
alternating mate set `B`, the unused part of the original region remains a
robust target with the exact loss `2τ`. -/
theorem isCompactAlternatingHub_of_isLocalRobustHub_bounded
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {H : Finset V} {Θ τ K : ℕ}
    (hhub : IsLocalRobustHub G Θ τ H) (hτ : 0 < τ)
    (h2τ : 2 * τ ≤ Θ) (hHK : H.card ≤ K) :
    IsCompactAlternatingHub G (Θ - 2 * τ) τ (K + 1) H := by
  classical
  obtain ⟨W, hWcard, hWH, hrobW⟩ := hhub
  obtain ⟨A, hAW, hAcard⟩ := Finset.exists_subset_card_eq hWcard
  have hAH : A ⊆ H := hAW.trans hWH
  have hrobA : RobustPairSet G A H Θ := hrobW.mono_left hAW
  obtain ⟨B, hBH, hBcard, hAB, hscaffold⟩ :=
    exists_cyclicAlternatingScaffold_of_robustPairSet
      G hτ hAcard hrobA h2τ
  let F₀ : Finset V := A ∪ B
  let D : Finset V := H \ F₀
  have hF₀H : F₀ ⊆ H := Finset.union_subset hAH hBH
  have hF₀card : F₀.card = 2 * τ := by
    dsimp [F₀]
    rw [Finset.card_union_of_disjoint hAB, hAcard, hBcard]
    omega
  have hdisjD : Disjoint F₀ D := by
    exact Finset.disjoint_sdiff
  have hdecomp : H = F₀ ∪ D := by
    exact (Finset.union_sdiff_of_subset hF₀H).symm
  have hrobD : RobustPairSet G A D (Θ - 2 * τ) := by
    simpa [D, F₀, hF₀card] using hrobA.sdiff_right (F := F₀)
  refine ⟨A, B, D, hAcard, hBcard, hAB, ?_, ?_, ?_, hscaffold, hrobD⟩
  · simpa [F₀] using hdisjD
  · simpa [F₀] using hdecomp
  · omega

/-- Structural alternating-hub form of the eighth-root decomposition.  Each
region has an exact core and alternating side of order `τ`, a disjoint
remaining target robust at threshold `Θ-2τ`, and total order at most `k`. -/
theorem exists_disjoint_bounded_divisor_eighthRoot_alternatingHub_family_of_two_pass_cycleFree
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {B k n : ℕ} (hB : 16 ≤ B) (hk : 4 * B ≤ k) (hn : 2 ≤ n)
    (hfree : G.IndepSetFree n)
    (hroom : 3 * Nat.log 2 (Fintype.card V) + 1 ≤ k)
    (hcycle : ¬ cycleGraph k ⊑ G)
    (hscale : (4 * B) ^ 36 ≤
      4 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1))
    (hpositive : 8 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) *
      (4 * B) ^ 5 ≤ k)
    (hreserve : 2 *
      (k / (8 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) * (4 * B) ^ 5)) ≤
      k / (2 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) * (4 * B) ^ 5)) :
    let a := Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1
    let R := 4 * B
    let Θ := k / (2 * a * R ^ 5)
    let τ := k / (8 * a * R ^ 5)
    ∃ F : Finset (Finset V),
      (∀ H ∈ F, IsCompactAlternatingHub G (Θ - 2 * τ) τ (k + 1) H) ∧
      DisjointFinsetFamily F ∧
      F.biUnion id ⊆ Finset.univ ∧
      ((Finset.univ : Finset V) \ F.biUnion id).card <
        16 * ((n - 1) * (((k - 1) / B - 1) + 1)) := by
  let a : ℕ := Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1
  let R : ℕ := 4 * B
  let Θ : ℕ := k / (2 * a * R ^ 5)
  let τ : ℕ := k / (8 * a * R ^ 5)
  obtain ⟨F, hhub, hdisj, hcover, hleft⟩ :=
    exists_disjoint_bounded_divisor_eighthRoot_localRobustHub_family_of_two_pass_cycleFree
      G hB hk hn hfree hroom hcycle hscale hpositive
  refine ⟨F, ?_, hdisj, hcover, hleft⟩
  intro H hHF
  exact isCompactAlternatingHub_of_isLocalRobustHub_bounded
    G (hhub H hHF).1 (by
      exact Nat.div_pos (by simpa [a, R] using hpositive) (by positivity))
    (by simpa [Θ, τ, a, R] using hreserve) (hhub H hHF).2

/-- The floor loss between denominators eight and two is harmless: twice
the smaller quotient is bounded by the larger quotient. -/
theorem two_mul_div_eight_mul_le_div_two_mul (k c : ℕ) (hc : 0 < c) :
    2 * (k / (8 * c)) ≤ k / (2 * c) := by
  apply (Nat.le_div_iff_mul_le (by positivity : 0 < 2 * c)).2
  have hdiv := Nat.div_mul_le_self k (8 * c)
  calc
    2 * (k / (8 * c)) * (2 * c) =
        (k / (8 * c)) * (4 * c) := by ring
    _ ≤ (k / (8 * c)) * (8 * c) := by gcongr; omega
    _ ≤ k := hdiv

/-- For each fixed divisor `B`, every arithmetic hypothesis of the
eighth-root alternating-hub decomposition holds eventually. -/
theorem eventually_divisor_eighthRoot_alternatingHub_numerics
    (B : ℕ) (hB : 16 ≤ B) :
    ∀ᶠ k : ℕ in atTop,
      4 * B ≤ k ∧
      (4 * B) ^ 36 ≤
        4 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) ∧
      8 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) * (4 * B) ^ 5 ≤ k ∧
      2 *
          (k / (8 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) *
            (4 * B) ^ 5)) ≤
        k / (2 * (Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1) *
          (4 * B) ^ 5) := by
  let R : ℕ := 4 * B
  let C : ℕ := max (R ^ 36) (16 * R ^ 5)
  have hRpos : 0 < R := by dsimp [R]; omega
  have htriple : Tendsto
      (fun k : ℕ => Nat.sqrt (Nat.sqrt (Nat.sqrt k))) atTop atTop :=
    tendsto_nat_sqrt_atTop.comp
      (tendsto_nat_sqrt_atTop.comp tendsto_nat_sqrt_atTop)
  filter_upwards [eventually_ge_atTop (4 * B),
    htriple.eventually (eventually_ge_atTop C)] with k hk hrC
  let s : ℕ := Nat.sqrt k
  let q : ℕ := Nat.sqrt s
  let r : ℕ := Nat.sqrt q
  let a : ℕ := r + 1
  have hrR36 : R ^ 36 ≤ r := by
    exact (le_max_left (R ^ 36) (16 * R ^ 5)).trans (by
      simpa [C, r, q, s] using hrC)
  have hrCoef : 16 * R ^ 5 ≤ r := by
    exact (le_max_right (R ^ 36) (16 * R ^ 5)).trans (by
      simpa [C, r, q, s] using hrC)
  have hrpos : 0 < r := hRpos.trans_le (by
    have : R ≤ 16 * R ^ 5 := by
      calc
        R ≤ R ^ 5 := Nat.le_self_pow (by norm_num : (5 : ℕ) ≠ 0) R
        _ ≤ 16 * R ^ 5 :=
          Nat.le_mul_of_pos_left (R ^ 5) (by norm_num : 0 < 16)
    exact this.trans hrCoef)
  have hrone : 1 ≤ r := hrpos
  have hr2q : r ^ 2 ≤ q := by
    dsimp [r]
    exact Nat.sqrt_le' q
  have hq2s : q ^ 2 ≤ s := by
    dsimp [q]
    exact Nat.sqrt_le' s
  have hs2k : s ^ 2 ≤ k := by
    dsimp [s]
    exact Nat.sqrt_le' k
  have hr4s : r ^ 4 ≤ s := by
    calc
      r ^ 4 = (r ^ 2) ^ 2 := by ring
      _ ≤ q ^ 2 := Nat.pow_le_pow_left hr2q 2
      _ ≤ s := hq2s
  have hr8k : r ^ 8 ≤ k := by
    calc
      r ^ 8 = (r ^ 4) ^ 2 := by ring
      _ ≤ s ^ 2 := Nat.pow_le_pow_left hr4s 2
      _ ≤ k := hs2k
  have ha2r : a ≤ 2 * r := by
    dsimp [a]
    omega
  have hcoef7 : 16 * R ^ 5 ≤ r ^ 7 :=
    hrCoef.trans (Nat.le_self_pow (by norm_num : (7 : ℕ) ≠ 0) r)
  have hpositive : 8 * a * R ^ 5 ≤ k := by
    calc
      8 * a * R ^ 5 ≤ 8 * (2 * r) * R ^ 5 := by gcongr
      _ = r * (16 * R ^ 5) := by ring
      _ ≤ r * r ^ 7 := Nat.mul_le_mul_left r hcoef7
      _ = r ^ 8 := by ring
      _ ≤ k := hr8k
  have hscale : R ^ 36 ≤ 4 * a := by
    exact hrR36.trans (by dsimp [a]; omega)
  have hreserve : 2 * (k / (8 * a * R ^ 5)) ≤
      k / (2 * a * R ^ 5) := by
    simpa [mul_assoc] using
      two_mul_div_eight_mul_le_div_two_mul k (a * R ^ 5) (by positivity)
  exact ⟨hk, by simpa [R, a, r, q, s] using hscale,
    by simpa [R, a, r, q, s] using hpositive,
    by simpa [R, a, r, q, s] using hreserve⟩

/-- Eventual structural extraction at every fixed divisor. -/
theorem eventually_exists_divisor_eighthRoot_alternatingHub_family
    (B : ℕ) (hB : 16 ≤ B) :
    ∀ᶠ k : ℕ in atTop,
      ∀ {V : Type*} [Fintype V]
        (G : SimpleGraph V) [DecidableRel G.Adj] {n : ℕ},
        2 ≤ n → G.IndepSetFree n →
        3 * Nat.log 2 (Fintype.card V) + 1 ≤ k →
        ¬ cycleGraph k ⊑ G →
        let a := Nat.sqrt (Nat.sqrt (Nat.sqrt k)) + 1
        let R := 4 * B
        let Θ := k / (2 * a * R ^ 5)
        let τ := k / (8 * a * R ^ 5)
        ∃ F : Finset (Finset V),
          (∀ H ∈ F,
            IsCompactAlternatingHub G (Θ - 2 * τ) τ (k + 1) H) ∧
          DisjointFinsetFamily F ∧
          F.biUnion id ⊆ Finset.univ ∧
          ((Finset.univ : Finset V) \ F.biUnion id).card <
            16 * ((n - 1) * (((k - 1) / B - 1) + 1)) := by
  filter_upwards [eventually_divisor_eighthRoot_alternatingHub_numerics B hB]
    with k hk
  intro V instV G instG n hn hfree hroom hcycle
  exact
    exists_disjoint_bounded_divisor_eighthRoot_alternatingHub_family_of_two_pass_cycleFree
      G hB hk.1 hn hfree hroom hcycle hk.2.1 hk.2.2.1 hk.2.2.2

/-- Counting disjoint local hubs.  Each hub region contains its selected
robust core of order at least tau, so summing over a disjoint region family
gives tau times the number of hubs at most the ambient vertex count. -/
theorem mul_card_le_card_of_disjoint_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ : ℕ}
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F) :
    τ * F.card ≤ Fintype.card V := by
  classical
  have hHcard : ∀ H ∈ F, τ ≤ H.card := by
    intro H hH
    rcases hhub H hH with ⟨U, hUcard, hUH, _hrob⟩
    exact hUcard.trans (Finset.card_le_card hUH)
  have hpair : (F : Set (Finset V)).PairwiseDisjoint id := by
    intro A hA B hB hAB
    exact hdisj A (by simpa using hA) B (by simpa using hB) hAB
  calc
    τ * F.card = ∑ H ∈ F, τ := by simp [Nat.mul_comm]
    _ ≤ ∑ H ∈ F, H.card := by
      exact Finset.sum_le_sum fun H hH => hHcard H hH
    _ = (F.biUnion id).card := by
      simpa using (Finset.card_biUnion hpair).symm
    _ ≤ (Finset.univ : Finset V).card :=
      Finset.card_le_card (Finset.subset_univ _)
    _ = Fintype.card V := by simp

/-- Coverage-to-count conversion for a bounded greedy family.  If fewer
than `m` ambient vertices lie outside the union and every displayed region
has at most `M` vertices, then the ambient order is strictly below
`m + M * |F|`.  This is the quantitative lower bound on the number of
compact hubs used by the stability split. -/
theorem card_lt_cutoff_add_mul_card_of_family_covering_up_to
    {V : Type*} [Fintype V]
    (F : Finset (Finset V)) {m M : ℕ}
    (hcover : F.biUnion id ⊆ (Finset.univ : Finset V))
    (hleft : ((Finset.univ : Finset V) \ F.biUnion id).card < m)
    (hsize : ∀ H ∈ F, H.card ≤ M) :
    Fintype.card V < m + M * F.card := by
  have hunion : (F.biUnion id).card ≤ F.card * M :=
    Finset.card_biUnion_le_card_mul F id M hsize
  have hunion' : (F.biUnion id).card ≤ M * F.card := by
    simpa [Nat.mul_comm] using hunion
  have hsplit :
      ((Finset.univ : Finset V) \ F.biUnion id).card +
          (F.biUnion id).card = Fintype.card V := by
    simpa using Finset.card_sdiff_add_card_eq_card hcover
  omega

/-- A pairwise-disjoint family of nonempty finite subsets has at most as
many members as the ambient finite type. -/
theorem card_family_le_of_nonempty_disjoint
    {V : Type*} [Fintype V] {F : Finset (Finset V)}
    (hne : ∀ A ∈ F, A.Nonempty)
    (hdisj : DisjointFinsetFamily F) :
    F.card ≤ Fintype.card V := by
  classical
  by_cases hFempty : F = ∅
  · simp [hFempty]
  have hVnonempty : Nonempty V := by
    obtain ⟨A, hA⟩ := Finset.nonempty_iff_ne_empty.mpr hFempty
    obtain ⟨v, _hv⟩ := hne A hA
    exact ⟨v⟩
  let pick' : Finset V → V := fun A =>
    if hA : A ∈ F then (hne A hA).choose else Classical.choice hVnonempty
  have hpick : ∀ A ∈ F, pick' A ∈ A := by
    intro A hA
    simp only [pick', dif_pos hA]
    exact (hne A hA).choose_spec
  have hinj : Set.InjOn pick' (F : Set (Finset V)) := by
    intro A hA B hB hab
    by_contra hAB
    exact (Finset.disjoint_left.mp (hdisj A hA B hB hAB))
      (hpick A hA) (hab ▸ hpick B hB)
  calc
    F.card = (F.image pick').card := (Finset.card_image_of_injOn hinj).symm
    _ ≤ (Finset.univ : Finset V).card :=
      Finset.card_le_card (Finset.subset_univ _)
    _ = Fintype.card V := by simp

/-- Choose the robust core inside every member of a disjoint local-hub
family.  Using the hub region itself as the target set keeps the regions
pairwise disjoint, because each selected core is a subset of its region. -/
theorem exists_core_data_of_disjoint_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ : ℕ}
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      ∀ i j : F, i ≠ j →
        Disjoint (U i ∪ (i : Finset V)) (U j ∪ (j : Finset V)) := by
  classical
  let U : F → Finset V := fun i => Classical.choose (hhub i.1 i.2)
  have hU : ∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
      RobustPairSet G (U i) (i : Finset V) θ := by
    intro i
    exact Classical.choose_spec (hhub i.1 i.2)
  refine ⟨U, hU, ?_⟩
  intro i j hij
  have hijv : (i : Finset V) ≠ (j : Finset V) := by
    intro h
    apply hij
    exact Subtype.ext h
  have hiUnion : U i ∪ (i : Finset V) = (i : Finset V) :=
    Finset.union_eq_right.mpr (hU i).2.1
  have hjUnion : U j ∪ (j : Finset V) = (j : Finset V) :=
    Finset.union_eq_right.mpr (hU j).2.1
  rw [hiUnion, hjUnion]
  exact hdisj i i.2 j j.2 hijv

/-- Normalize every selected DRC core to the common size `τ`.  The local
hub predicate only gives a core of size at least `τ`; taking an exact-size
subset preserves the all-pairs common-neighbour certificate and is essential
when an interaction component is later converted into one stable block. -/
theorem exists_exact_core_data_of_disjoint_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ : ℕ}
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F) :
    ∃ U : F → Finset V,
      (∀ i : F, (U i).card = τ ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      ∀ i j : F, i ≠ j →
        Disjoint (U i ∪ (i : Finset V)) (U j ∪ (j : Finset V)) := by
  classical
  let W : F → Finset V := fun i => Classical.choose (hhub i.1 i.2)
  have hW : ∀ i : F, τ ≤ (W i).card ∧ W i ⊆ (i : Finset V) ∧
      RobustPairSet G (W i) (i : Finset V) θ := by
    intro i
    exact Classical.choose_spec (hhub i.1 i.2)
  let U : F → Finset V := fun i =>
    Classical.choose (Finset.exists_subset_card_eq (hW i).1)
  have hUsub : ∀ i : F, U i ⊆ W i := by
    intro i
    exact (Classical.choose_spec
      (Finset.exists_subset_card_eq (hW i).1)).1
  have hUcard : ∀ i : F, (U i).card = τ := by
    intro i
    exact (Classical.choose_spec
      (Finset.exists_subset_card_eq (hW i).1)).2
  refine ⟨U, ?_, ?_⟩
  · intro i
    exact ⟨hUcard i, (hUsub i).trans (hW i).2.1,
      (hW i).2.2.mono_left (hUsub i)⟩
  · intro i j hij
    have hijv : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    have hiUnion : U i ∪ (i : Finset V) = (i : Finset V) :=
      Finset.union_eq_right.mpr ((hUsub i).trans (hW i).2.1)
    have hjUnion : U j ∪ (j : Finset V) = (j : Finset V) :=
      Finset.union_eq_right.mpr ((hUsub j).trans (hW j).2.1)
    rw [hiUnion, hjUnion]
    exact hdisj i i.2 j j.2 hijv

/-- Core-selection interface for the parity-broken branch.  If every local
hub guarantees n+4 selected vertices, independent-set-freeness turns each
chosen robust core into a matching-backed core while preserving the same
pairwise-disjoint routing regions. -/
theorem exists_matched_core_data_of_disjoint_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n : ℕ}
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n) (hτn : n + 4 ≤ τ) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      (∀ i j : F, i ≠ j →
        Disjoint (U i ∪ (i : Finset V)) (U j ∪ (j : Finset V))) ∧
      ∀ i : F, HasThreeDisjointAdjPairFamily G (U i) := by
  obtain ⟨U, hU, hregions⟩ :=
    exists_core_data_of_disjoint_localRobustHub_family G hhub hdisj
  refine ⟨U, hU, hregions, ?_⟩
  intro i
  apply hasThreeDisjointAdjPairFamily_of_indepSetFree_of_add_four_le_card hfree
  exact hτn.trans (hU i).1

/-- Family-level matched interaction exclusion.  Select matching-backed
robust cores from the disjoint local hubs, prune the canonical repeated
attachments, and apply the uniform-route interval obstruction to the
resulting auxiliary graph. -/
theorem exists_matched_core_data_with_no_uniform_pruned_interaction_cycle
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n m s L k : ℕ}
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n) (hτn : n + 4 ≤ τ)
    (hm : 2 ≤ m)
    (hfitlow : 2 * (s + 1) * m + m + 6 ≤ k)
    (hfitup : k ≤ L + 2 * (s + 1) * m + m + 1)
    (hL : L ≤ τ) (hLθ : L + 1 ≤ θ)
    (hsU : s + 2 ≤ τ) (hsθ : 2 * (s + 1) + 1 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      (∀ i j : F, i ≠ j →
        Disjoint (U i ∪ (i : Finset V)) (U j ∪ (j : Finset V))) ∧
      (∀ i : F, HasThreeDisjointAdjPairFamily G (U i)) ∧
      ¬ cycleGraph (m + 1) ⊑ HubInteractionGraph G
        (fun i : F => U i \ RepeatedAttachmentFinset G U) := by
  obtain ⟨U, hU, hregions, hmatch⟩ :=
    exists_matched_core_data_of_disjoint_localRobustHub_family
      G hhub hdisj hfree hτn
  refine ⟨U, hU, hregions, hmatch, ?_⟩
  apply not_cycleGraph_isContained_pruned_hubInteraction_of_matched_uniform_routes
    hm hfitlow hfitup G U (fun i : F => (i : Finset V))
      (fun _ : F => θ) (RepeatedAttachmentFinset G U)
      (fun i => (hU i).2.2) hregions hmatch
  · intro i
    exact hL.trans (hU i).1
  · intro i
    exact hLθ
  · intro i
    exact hsU.trans (hU i).1
  · intro i
    exact hsθ
  · exact no_repeated_attachment_outside_RepeatedAttachmentFinset G U
  · exact hcycle

/-- Even-route lift for a pruned hub-interaction cycle.  Unlike the earlier
long-first-hub wrapper, this version never uses an n-sized parity-breaking
hub: every auxiliary vertex contributes one explicitly budgeted even robust
route, and the resulting total-length identity closes the exact target
cycle. -/
theorem cycleGraph_isContained_of_pruned_hubInteraction_cycle_even_routes
    {V ι : Type*} [Fintype V] {m k : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hcopy : cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => U i \ X))
    (hnorep : ∀ i j q : ι, i ≠ j → i ≠ q → j ≠ q →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U q,
        G.Adj x y → G.Adj x z → False)
    (r : Fin (m + 1) → ℕ)
    (hUr : ∀ i : ι, ∀ j : Fin (m + 1), r j + 2 ≤ (U i).card)
    (hθr : ∀ i : ι, ∀ j : Fin (m + 1),
      2 * (r j + 1) + 1 ≤ θ i)
    (hlen : (∑ i : Fin (m + 1), 2 * (r i + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haX, hbX, hcross, hclose⟩ :=
    exists_cyclic_cross_edges_of_cycleGraph_isContained_hubInteractionGraph
      hm G (fun i => U i \ X) hcopy
  have hab : ∀ i : Fin (m + 1), a i ≠ b i :=
    distinct_attachments_of_no_repeated_attachment_on_cyclic_cross_edges
      hm G U X f hfinj a b haX hbX hcross hclose hnorep
  have ha : ∀ i : Fin (m + 1), a i ∈ U (f i) := by
    intro i
    exact (Finset.mem_sdiff.mp (haX i)).1
  have hb : ∀ i : Fin (m + 1), b i ∈ U (f i) := by
    intro i
    exact (Finset.mem_sdiff.mp (hbX i)).1
  apply cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_even_fin
    G hk (fun i => U (f i)) (fun i => T (f i)) (fun i => θ (f i))
      r (fun i => hrob (f i))
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      a b ha hb hab hcross hclose
  · intro i
    exact hUr (f i) i
  · intro i
    exact hθr (f i) i
  · exact hlen

/-- Length-two specialization of the even-route lift.  A pruned auxiliary
cycle on q hubs contributes two internal edges and one cross edge per hub,
so when k = 3q it is forbidden in a C_k-free graph as soon as every hub has
two vertices and threshold three. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_three_mul
    {V ι : Type*} [Fintype V] {q k : ℕ}
    (hq : 3 ≤ q) (hkq : k = 3 * q)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i, 2 ≤ (U i).card)
    (hθ : ∀ i, 3 ≤ θ i)
    (hnorep : ∀ i j r : ι, i ≠ j → i ≠ r → j ≠ r →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U r,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph q ⊑ HubInteractionGraph G (fun i => U i \ X) := by
  intro hcopy
  apply hcycle
  let m : ℕ := q - 1
  have hm : 2 ≤ m := by
    dsimp [m]
    omega
  have hmq : m + 1 = q := by
    dsimp [m]
    omega
  apply cycleGraph_isContained_of_pruned_hubInteraction_cycle_even_routes
    hm (by rw [hkq]; omega) G U T θ X hrob hregions
      (by rw [hmq]; exact hcopy) hnorep (fun _ : Fin (m + 1) => 0)
  · intro i j
    simpa using hU i
  · intro i j
    simpa using hθ i
  · simp [Fin.sum_const, hkq, hmq, m]
    omega

/-- Every k at least twelve has a near-third decomposition k = 3q + 2r
with q at least three and r at most two.  Choose q according to k modulo
six so that q has the parity needed for the even-route correction. -/
theorem exists_near_third_decomposition
    {k : ℕ} (hk : 12 ≤ k) :
    ∃ q r : ℕ, 3 ≤ q ∧ r ≤ 2 ∧ k = 3 * q + 2 * r := by
  let a : ℕ := k / 6
  have hmod : k % 6 < 6 := Nat.mod_lt k (by omega)
  have hdivmod : 6 * (k / 6) + k % 6 = k := Nat.div_add_mod k 6
  have ha2 : 2 ≤ a := by
    dsimp [a]
    apply (Nat.le_div_iff_mul_le (by omega)).2
    omega
  interval_cases hrem : k % 6
  · exact ⟨2 * a, 0, by omega, by omega, by dsimp [a]; omega⟩
  · exact ⟨2 * a - 1, 2, by omega, by omega, by dsimp [a]; omega⟩
  · exact ⟨2 * a, 1, by omega, by omega, by dsimp [a]; omega⟩
  · exact ⟨2 * a + 1, 0, by omega, by omega, by dsimp [a]; omega⟩
  · exact ⟨2 * a, 2, by omega, by omega, by dsimp [a]; omega⟩
  · exact ⟨2 * a + 1, 1, by omega, by omega, by dsimp [a]; omega⟩

/-- Distribute a residual of size at most twice the number of coordinates
over a finite index type, putting at most two units on each coordinate. -/
theorem exists_fin_weights_sum_eq_le_two {q z : ℕ} (hq : 0 < q)
    (hz : z ≤ 2 * q) :
    ∃ r : Fin q → ℕ, (∑ i, r i) = z ∧ ∀ i, r i ≤ 2 := by
  classical
  by_cases heq : z = 2 * q
  · refine ⟨fun _ => 2, ?_, fun _ => le_rfl⟩
    simp [heq, Nat.mul_comm]
  · have hzlt : z < 2 * q := lt_of_le_of_ne hz heq
    obtain ⟨r, hsum, hpoint, _hfiber⟩ :=
      exists_exact_balanced_visit_weights_of_covers_finset
        q z (fun i : Fin q => i) (Finset.univ : Finset (Fin q))
        (by exact ⟨⟨0, hq⟩, Finset.mem_univ _⟩) (by
          intro i _hi
          exact ⟨i, rfl⟩)
    refine ⟨r, hsum, ?_⟩
    intro i
    have hi := hpoint i
    simp only [Finset.card_univ, Fintype.card_fin] at hi
    have hdiv : z / q < 2 := by
      exact (Nat.div_lt_iff_lt_mul hq).2 (by simpa [Nat.mul_comm] using hzlt)
    omega

/-- General finite capacity allocation.  If a residual `z` fits in `q`
coordinates of capacity `R`, balanced quotient/remainder allocation realizes
it exactly without exceeding `R` in any coordinate. -/
theorem exists_fin_weights_sum_eq_le {q z R : ℕ} (hq : 0 < q)
    (hz : z ≤ R * q) :
    ∃ r : Fin q → ℕ, (∑ i, r i) = z ∧ ∀ i, r i ≤ R := by
  classical
  by_cases heq : z = R * q
  · refine ⟨fun _ => R, ?_, fun _ => le_rfl⟩
    simp [heq, Nat.mul_comm]
  · have hzlt : z < R * q := lt_of_le_of_ne hz heq
    obtain ⟨r, hsum, hpoint, _hfiber⟩ :=
      exists_exact_balanced_visit_weights_of_covers_finset
        q z (fun i : Fin q => i) (Finset.univ : Finset (Fin q))
        (by exact ⟨⟨0, hq⟩, Finset.mem_univ _⟩) (by
          intro i _hi
          exact ⟨i, rfl⟩)
    refine ⟨r, hsum, ?_⟩
    intro i
    have hi := hpoint i
    simp only [Finset.card_univ, Fintype.card_fin] at hi
    have hdiv : z / q < R := by
      exact (Nat.div_lt_iff_lt_mul hq).2 (by simpa [Nat.mul_comm] using hzlt)
    omega

/-- Capacity allocation supported on an arbitrary finite subset.  This is
the indexing form needed when only the internal vertices of a selected
prefix receive long alternating-scaffold routes. -/
theorem exists_finset_weights_sum_eq_le
    {α : Type*} [Fintype α] [DecidableEq α]
    (S : Finset α) {z R : ℕ} (hz : z ≤ R * S.card) :
    ∃ weight : α → ℕ,
      (∑ i ∈ S, weight i) = z ∧
      (∀ i ∈ S, weight i ≤ R) ∧
      ∀ i ∉ S, weight i = 0 := by
  classical
  by_cases hS : S.Nonempty
  · have hcardpos : 0 < Fintype.card S := by
      simpa using hS.card_pos
    have hz' : z ≤ R * Fintype.card S := by simpa using hz
    obtain ⟨r, hrsum, hrle⟩ :=
      exists_fin_weights_sum_eq_le hcardpos hz'
    let e : Fin (Fintype.card S) ≃ S := (Fintype.equivFin S).symm
    let weight : α → ℕ := fun i =>
      if hi : i ∈ S then r (e.symm ⟨i, hi⟩) else 0
    refine ⟨weight, ?_, ?_, ?_⟩
    · calc
        (∑ i ∈ S, weight i) = ∑ x ∈ S.attach, weight x.1 :=
          (Finset.sum_attach S weight).symm
        _ = ∑ x : S, weight x.1 := by
          rw [Finset.attach_eq_univ]
        _ = ∑ j : Fin (Fintype.card S), r j := by
          symm
          apply Fintype.sum_equiv e
          intro j
          simp [weight, e]
        _ = z := hrsum
    · intro i hi
      simpa [weight, hi] using hrle (e.symm ⟨i, hi⟩)
    · intro i hi
      simp [weight, hi]
  · have hSempt : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
    have hz0 : z = 0 := by simpa [hSempt] using hz
    refine ⟨fun _ => 0, ?_, ?_, ?_⟩
    · simp [hSempt, hz0]
    · simp [hSempt]
    · simp

/-- Exact cycle lift with a high-capacity set of marked hub visits and
zero-or-two-edge routes on all remaining visits.  The displayed
`shortCost` is determined solely by whether the two ordinary attachments at
an unmarked hub coincide.  Thus the even residual can be allocated across
the marked alternating scaffolds before the routes are chosen. -/
theorem cycleGraph_isContained_of_mixed_alternatingScaffold_cycle
    {V ι : Type*} [Fintype V] [DecidableEq V]
    {m k q theta : ℕ} (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = q)
    (hq : 4 ≤ q) (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (f : Fin (m + 1) → ι) (hfinj : Function.Injective f)
    (a b : Fin (m + 1) → V)
    (ha : ∀ i, a i ∈ A (f i)) (hb : ∀ i, b i ∈ A (f i))
    (hcross : ∀ i : Fin m, G.Adj (b i.castSucc) (a i.succ))
    (hclose : G.Adj (b (Fin.last m)) (a 0))
    (S : Finset (Fin (m + 1)))
    (hab : ∀ i ∈ S, a i ≠ b i)
    (hbase :
      (m + 1) + 6 * S.card +
          ∑ i ∈ (Finset.univ : Finset (Fin (m + 1))) \ S,
            (if a i = b i then 0 else 2) ≤ k)
    (hpar :
      (k - ((m + 1) + 6 * S.card +
          ∑ i ∈ (Finset.univ : Finset (Fin (m + 1))) \ S,
            (if a i = b i then 0 else 2))) % 2 = 0)
    (hcap :
      (k - ((m + 1) + 6 * S.card +
          ∑ i ∈ (Finset.univ : Finset (Fin (m + 1))) \ S,
            (if a i = b i then 0 else 2))) / 2 ≤
        (q - 4) * S.card) :
    cycleGraph k ⊑ G := by
  let vDec : DecidableEq V := inferInstance
  classical
  let : DecidableEq V := vDec
  let shortCost : ℕ :=
    ∑ i ∈ (Finset.univ : Finset (Fin (m + 1))) \ S,
      (if a i = b i then 0 else 2)
  let base : ℕ := (m + 1) + 6 * S.card + shortCost
  let z : ℕ := (k - base) / 2
  have hbase' : base ≤ k := by simpa [base, shortCost] using hbase
  have hpar' : (k - base) % 2 = 0 := by
    simpa [base, shortCost] using hpar
  have hcap' : z ≤ (q - 4) * S.card := by
    simpa [z, base, shortCost] using hcap
  have hdiff : k - base = 2 * z := by
    have hdivmod :
        2 * ((k - base) / 2) + (k - base) % 2 = k - base :=
      Nat.div_add_mod (k - base) 2
    dsimp [z]
    omega
  have hkform : k = base + 2 * z := by omega
  obtain ⟨weight, hweightsum, hweightle, hweightzero⟩ :=
    exists_finset_weights_sum_eq_le S hcap'
  obtain ⟨route, hroute, hrouteDisj, hrouteLoc,
      hrouteStrong, hrouteWeak⟩ :=
    exists_mixed_alternatingScaffold_routes_fin
      G A B D hscaffold hrob (by
        intro i
        convert hmajorD i using 1 <;> ext x <;> simp) hAcard hq htheta (by
          intro i j hij
          convert hregions i j hij using 1 <;> ext x <;> simp)
        f hfinj (fun i => i ∈ S) a b ha hb hab weight hweightle
  have hweakExact : ∀ i, i ∉ S →
      (route i).length = if a i = b i then 0 else 2 := by
    intro i hi
    have hshort := hrouteWeak i hi
    by_cases hiab : a i = b i
    · have hnil : (route i).Nil := (hroute i).nil_iff_eq.mpr hiab
      simp [hiab, hnil.length_eq_zero]
    · have hnezero : (route i).length ≠ 0 := by
        intro hzero
        exact hiab ((Walk.length_eq_zero_iff.mp hzero).eq)
      rcases hshort.1 with ⟨r, hr⟩
      simp [hiab]
      omega
  have hstrongSum :
      (∑ i ∈ S, (route i).length) = 2 * z + 6 * S.card := by
    calc
      (∑ i ∈ S, (route i).length) =
          ∑ i ∈ S, (2 * weight i + 6) := by
            apply Finset.sum_congr rfl
            intro i hi
            exact hrouteStrong i hi
      _ = 2 * (∑ i ∈ S, weight i) + 6 * S.card := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum]
        simp [Nat.mul_comm]
      _ = 2 * z + 6 * S.card := by rw [hweightsum]
  have hweakSum :
      (∑ i ∈ (Finset.univ : Finset (Fin (m + 1))) \ S,
          (route i).length) = shortCost := by
    dsimp [shortCost]
    apply Finset.sum_congr rfl
    intro i hi
    exact hweakExact i (Finset.mem_sdiff.mp hi).2
  have hrouteSum :
      (∑ i : Fin (m + 1), (route i).length) =
        2 * z + 6 * S.card + shortCost := by
    have hsplit := Finset.sum_sdiff
      (s₁ := S) (s₂ := (Finset.univ : Finset (Fin (m + 1))))
      (f := fun i => (route i).length) (Finset.subset_univ S)
    calc
      (∑ i : Fin (m + 1), (route i).length) =
          (∑ i ∈ (Finset.univ : Finset (Fin (m + 1))) \ S,
            (route i).length) + ∑ i ∈ S, (route i).length := by
        simpa using hsplit.symm
      _ = shortCost + (2 * z + 6 * S.card) := by rw [hweakSum, hstrongSum]
      _ = 2 * z + 6 * S.card + shortCost := by omega
  apply cycleGraph_isContained_of_cyclic_cross_edges_and_disjoint_paths_fin
    G hk a b route hroute hrouteDisj hcross hclose
  · rw [hrouteSum]
    dsimp [base] at hkform
    omega
  · rw [hrouteSum]
    dsimp [base] at hkform
    omega

/-- Hybrid full-capacity lift.  A long path from a valid selected-edge
system is closed by an arbitrary internally disjoint path in the ordinary
hub-interaction graph.  Internal selected-path hubs supply all adjustable
length, while the two junction hubs and every BFS-return hub use only a
zero-or-two-edge robust route.  Consequently repeated-attachment pruning is
unnecessary. -/
theorem cycleGraph_isContained_of_selected_path_and_hubInteraction_return
    {V ι : Type*} [Fintype V] [Fintype ι]
    {k q theta : ℕ} (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = q)
    (hq : 4 ≤ q) (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hIA : ∀ i, I i ⊆ A i)
    (hM : IsSelectedCrossEdgeSystem G I M)
    {u v : ι} (p : (SelectedCrossEdgeGraph M).Walk u v)
    (hp : p.IsPath) (hplen : 2 ≤ p.length)
    (r : (HubInteractionGraph G I).Walk v u) (hr : r.IsPath)
    (hdisj : p.support.tail.Disjoint r.support.tail)
    (hbase :
      (p.length + r.length) + 6 * (p.length - 1) +
        2 * (r.length + 1) ≤ k)
    (hparity : k % 2 = (p.length + r.length) % 2)
    (hcap :
      (k - ((p.length + r.length) + 6 * (p.length - 1))) / 2 ≤
        (q - 4) * (p.length - 1)) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨m, f, a, b, S, hmlen, hfinj, haI, hbI,
      hcross, hclose, hScard, hab⟩ :=
    exists_cyclic_attachments_with_selected_path_interior
      G I M hM p hp hplen r hr hdisj
  have hm : 2 ≤ m := by
    have huv : u ≠ v := by
      intro huv
      have hnil : p.Nil := hp.nil_iff_eq.mpr huv
      have := hnil.length_eq_zero
      omega
    have hrpos : 0 < r.length := by
      apply Nat.pos_of_ne_zero
      intro hzero
      exact huv.symm ((Walk.length_eq_zero_iff.mp hzero).eq)
    omega
  let T : Finset (Fin (m + 1)) :=
    (Finset.univ : Finset (Fin (m + 1))) \ S
  let shortCost : ℕ :=
    ∑ i ∈ T, (if a i = b i then 0 else 2)
  have hTcard : T.card = r.length + 1 := by
    dsimp [T]
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ S)]
    simp only [Finset.card_univ, Fintype.card_fin]
    omega
  have hshortBound : shortCost ≤ 2 * (r.length + 1) := by
    calc
      shortCost ≤ ∑ _i ∈ T, 2 := by
        apply Finset.sum_le_sum
        intro i hi
        split <;> omega
      _ = 2 * T.card := by simp [Nat.mul_comm]
      _ = 2 * (r.length + 1) := by rw [hTcard]
  have hshortEven : Even shortCost := by
    dsimp [shortCost]
    rw [Nat.even_iff, Finset.sum_nat_mod]
    have hz : (∑ i ∈ T, (if a i = b i then 0 else 2) % 2) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      split <;> simp_all
    simp [hz]
  have hbaseExact :
      (m + 1) + 6 * S.card + shortCost ≤ k := by
    omega
  have hparExact :
      (k - ((m + 1) + 6 * S.card + shortCost)) % 2 = 0 := by
    rcases hshortEven with ⟨z, hz⟩
    omega
  have hcapExact :
      (k - ((m + 1) + 6 * S.card + shortCost)) / 2 ≤
        (q - 4) * S.card := by
    have hsub :
        k - ((m + 1) + 6 * S.card + shortCost) ≤
          k - ((m + 1) + 6 * S.card) := by omega
    have hbaseEq : (m + 1) + 6 * S.card =
        (p.length + r.length) + 6 * (p.length - 1) := by omega
    calc
      (k - ((m + 1) + 6 * S.card + shortCost)) / 2 ≤
          (k - ((m + 1) + 6 * S.card)) / 2 :=
        Nat.div_le_div_right hsub
      _ = (k - ((p.length + r.length) + 6 * (p.length - 1))) / 2 := by
        rw [hbaseEq]
      _ ≤ (q - 4) * (p.length - 1) := hcap
      _ = (q - 4) * S.card := by rw [hScard]
  apply cycleGraph_isContained_of_mixed_alternatingScaffold_cycle (S := S)
    hm hk G A B D hscaffold hrob hmajorD hAcard hq htheta hregions
      f hfinj a b
  · intro i
    exact hIA (f i) (haI i)
  · intro i
    exact hIA (f i) (hbI i)
  · exact hcross
  · exact hclose
  · exact hab
  · simpa [T, shortCost] using hbaseExact
  · simpa [T, shortCost] using hparExact
  · simpa [T, shortCost] using hcapExact

/-- A same-parity auxiliary cycle lifts through disjoint alternating
scaffolds whenever its residual length fits the one-route scaffold capacity.
Every hub pays a base route of length four, every auxiliary edge pays one,
and the remaining even residual is distributed across the scaffold paths. -/
theorem cycleGraph_isContained_of_pruned_alternatingScaffold_cycle_even_capacity
    {V ι : Type*} [Fintype V] {m k q theta : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) (X : Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (htheta : 2 ≤ theta) (hq : 3 ≤ q)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcopy : cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => A i \ X))
    (hnorep : ∀ i j s : ι, i ≠ j → i ≠ s → j ≠ s →
      ∀ x ∈ A i, x ∉ X → ∀ y ∈ A j, ∀ z ∈ A s,
        G.Adj x y → G.Adj x z → False)
    (hbase : 5 * (m + 1) ≤ k)
    (hpar : (k - 5 * (m + 1)) % 2 = 0)
    (hcap : (k - 5 * (m + 1)) / 2 ≤
      (q / 3 - 1) * (m + 1)) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haX, hbX, hcross, hclose⟩ :=
    exists_cyclic_cross_edges_of_cycleGraph_isContained_hubInteractionGraph
      hm G (fun i => A i \ X) hcopy
  have hab : ∀ i : Fin (m + 1), a i ≠ b i :=
    distinct_attachments_of_no_repeated_attachment_on_cyclic_cross_edges
      hm G A X f hfinj a b haX hbX hcross hclose hnorep
  let z : ℕ := (k - 5 * (m + 1)) / 2
  let R : ℕ := q / 3 - 1
  obtain ⟨r, hrsum, hrle⟩ := exists_fin_weights_sum_eq_le
    (q := m + 1) (z := z) (R := R) (by omega) (by
      simpa [z, R] using hcap)
  have hfit : ∀ i : Fin (m + 1), 3 * (r i + 1) ≤ q := by
    intro i
    have hi := hrle i
    have hdiv : (q / 3) * 3 ≤ q := Nat.div_mul_le_self q 3
    dsimp [R] at hi
    omega
  have hdiff : k - 5 * (m + 1) = 2 * z := by
    dsimp [z]
    have hdivmod :
        2 * ((k - 5 * (m + 1)) / 2) +
            (k - 5 * (m + 1)) % 2 = k - 5 * (m + 1) :=
      Nat.div_add_mod (k - 5 * (m + 1)) 2
    omega
  have hkz : k = 5 * (m + 1) + 2 * z := by omega
  have hsumform :
      (∑ i : Fin (m + 1), (2 * r i + 4)) =
        2 * (∑ i : Fin (m + 1), r i) + 4 * (m + 1) := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    simp
    omega
  apply cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_even_fin
    G hk (fun i => A (f i)) (fun i => B (f i)) (fun i => D (f i)) r
      (fun i => hscaffold (f i)) (fun i => hrob (f i))
      (fun i => hmajorD (f i)) htheta
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      a b (fun i => (Finset.mem_sdiff.mp (haX i)).1)
      (fun i => (Finset.mem_sdiff.mp (hbX i)).1) hab hcross hclose hfit
  rw [hsumform, hrsum]
  omega

/-- Full-capacity same-parity lift for a pruned hub-interaction cycle.  Each
hub pays six internal route edges and one auxiliary cross edge, while every
additional pair of target edges consumes one of its `q - 4` scaffold steps. -/
theorem cycleGraph_isContained_of_pruned_alternatingScaffold_cycle_long_capacity
    {V ι : Type*} [Fintype V] {m k q theta : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) (X : Finset V)
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 4 ≤ q) (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcopy : cycleGraph (m + 1) ⊑
      HubInteractionGraph G (fun i => A i \ X))
    (hnorep : ∀ i j s : ι, i ≠ j → i ≠ s → j ≠ s →
      ∀ x ∈ A i, x ∉ X → ∀ y ∈ A j, ∀ z ∈ A s,
        G.Adj x y → G.Adj x z → False)
    (hbase : 7 * (m + 1) ≤ k)
    (hpar : (k - 7 * (m + 1)) % 2 = 0)
    (hcap : (k - 7 * (m + 1)) / 2 ≤
      (q - 4) * (m + 1)) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haX, hbX, hcross, hclose⟩ :=
    exists_cyclic_cross_edges_of_cycleGraph_isContained_hubInteractionGraph
      hm G (fun i => A i \ X) hcopy
  have hab : ∀ i : Fin (m + 1), a i ≠ b i :=
    distinct_attachments_of_no_repeated_attachment_on_cyclic_cross_edges
      hm G A X f hfinj a b haX hbX hcross hclose hnorep
  let z : ℕ := (k - 7 * (m + 1)) / 2
  let R : ℕ := q - 4
  obtain ⟨r, hrsum, hrle⟩ := exists_fin_weights_sum_eq_le
    (q := m + 1) (z := z) (R := R) (by omega) (by
      simpa [z, R] using hcap)
  have hdiff : k - 7 * (m + 1) = 2 * z := by
    dsimp [z]
    have hdivmod :
        2 * ((k - 7 * (m + 1)) / 2) +
            (k - 7 * (m + 1)) % 2 = k - 7 * (m + 1) :=
      Nat.div_add_mod (k - 7 * (m + 1)) 2
    omega
  have hkz : k = 7 * (m + 1) + 2 * z := by omega
  have hsumform :
      (∑ i : Fin (m + 1), (2 * r i + 6)) =
        2 * (∑ i : Fin (m + 1), r i) + 6 * (m + 1) := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    simp
    omega
  apply cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_long_fin
    G hk (fun i => A (f i)) (fun i => B (f i)) (fun i => D (f i)) r
      (fun i => hscaffold (f i)) (fun i => hrob (f i))
      (fun i => hmajorD (f i)) hq htheta
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      a b (fun i => (Finset.mem_sdiff.mp (haX i)).1)
      (fun i => (Finset.mem_sdiff.mp (hbX i)).1) hab hcross hclose
      (fun i => by simpa [R] using hrle i)
  rw [hsumform, hrsum]
  omega

/-- Full-capacity lift of a globally selected auxiliary cycle.  The selected
system itself supplies pairwise fresh incoming and outgoing ambient handles,
so unlike the pruned ordinary-interaction theorem no repeated-attachment
hypothesis is needed.  The selected classes may be trimmed subsets of the
alternating scaffold cores. -/
theorem cycleGraph_isContained_of_selectedCrossEdgeGraph_alternatingScaffold_cycle_long_capacity
    {V ι : Type*} [Fintype V] {m k q theta : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 4 ≤ q) (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hIA : ∀ i, I i ⊆ A i)
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hcopy : cycleGraph (m + 1) ⊑ SelectedCrossEdgeGraph M)
    (hbase : 7 * (m + 1) ≤ k)
    (hpar : (k - 7 * (m + 1)) % 2 = 0)
    (hcap : (k - 7 * (m + 1)) / 2 ≤
      (q - 4) * (m + 1)) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haI, hbI, hab, hcross, hclose⟩ :=
    exists_distinct_cyclic_cross_edges_of_cycleGraph_isContained_selectedCrossEdgeGraph
      hm G I M hM hcopy
  have ha : ∀ i : Fin (m + 1), a i ∈ A (f i) := by
    intro i
    exact hIA (f i) (haI i)
  have hb : ∀ i : Fin (m + 1), b i ∈ A (f i) := by
    intro i
    exact hIA (f i) (hbI i)
  let z : ℕ := (k - 7 * (m + 1)) / 2
  let R : ℕ := q - 4
  obtain ⟨r, hrsum, hrle⟩ := exists_fin_weights_sum_eq_le
    (q := m + 1) (z := z) (R := R) (by omega) (by
      simpa [z, R] using hcap)
  have hdiff : k - 7 * (m + 1) = 2 * z := by
    dsimp [z]
    have hdivmod :
        2 * ((k - 7 * (m + 1)) / 2) +
            (k - 7 * (m + 1)) % 2 = k - 7 * (m + 1) :=
      Nat.div_add_mod (k - 7 * (m + 1)) 2
    omega
  have hsumform :
      (∑ i : Fin (m + 1), (2 * r i + 6)) =
        2 * (∑ i : Fin (m + 1), r i) + 6 * (m + 1) := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    simp
    omega
  apply cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_long_fin
    G hk (fun i => A (f i)) (fun i => B (f i)) (fun i => D (f i)) r
      (fun i => hscaffold (f i)) (fun i => hrob (f i))
      (fun i => hmajorD (f i)) hq htheta
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      a b ha hb hab hcross hclose
      (fun i => by simpa [R] using hrle i)
  rw [hsumform, hrsum]
  omega

/-- Opposite-parity full-capacity lift of a selected auxiliary cycle.  A
matching edge in the first scaffold replaces its ordinary six-edge internal
route by a five-edge route; all remaining hubs retain their full `q - 4`
adjustable capacity. -/
theorem cycleGraph_isContained_of_selectedCrossEdgeGraph_alternatingScaffold_cycle_matched_odd_capacity
    {V ι : Type*} [Fintype V] {m k q theta : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 5 ≤ q) (htheta : 6 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hIA : ∀ i, I i ⊆ A i)
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (A i))
    (hcopy : cycleGraph (m + 1) ⊑ SelectedCrossEdgeGraph M)
    (hbase : 7 * (m + 1) - 1 ≤ k)
    (hpar : (k - (7 * (m + 1) - 1)) % 2 = 0)
    (hcap : (k - (7 * (m + 1) - 1)) / 2 ≤
      (q - 4) * m) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haI, hbI, hab, hcross, hclose⟩ :=
    exists_distinct_cyclic_cross_edges_of_cycleGraph_isContained_selectedCrossEdgeGraph
      hm G I M hM hcopy
  have ha : ∀ i : Fin (m + 1), a i ∈ A (f i) := by
    intro i
    exact hIA (f i) (haI i)
  have hb : ∀ i : Fin (m + 1), b i ∈ A (f i) := by
    intro i
    exact hIA (f i) (hbI i)
  let base : ℕ := 7 * (m + 1) - 1
  let z : ℕ := (k - base) / 2
  let R : ℕ := q - 4
  obtain ⟨r, hrsum, hrle⟩ := exists_fin_weights_sum_eq_le
    (q := m) (z := z) (R := R) (by omega) (by
      simpa [base, z, R] using hcap)
  have hdiff : k - base = 2 * z := by
    dsimp [z]
    have hdivmod :
        2 * ((k - base) / 2) + (k - base) % 2 = k - base :=
      Nat.div_add_mod (k - base) 2
    have hpar' : (k - base) % 2 = 0 := by simpa [base] using hpar
    omega
  have hkz : k = base + 2 * z := by
    have hbase' : base ≤ k := by simpa [base] using hbase
    omega
  have hsumform :
      (∑ i : Fin m, (2 * r i + 6)) =
        2 * (∑ i : Fin m, r i) + 6 * m := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum]
    simp
    omega
  apply cycleGraph_isContained_of_cyclic_disjoint_alternatingScaffolds_matched_odd_fin
    G hk (fun i => A (f i)) (fun i => B (f i)) (fun i => D (f i)) r
      (fun i => hscaffold (f i)) (fun i => hrob (f i))
      (fun i => hmajorD (f i)) hq htheta
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      (hmatch (f 0)) a b ha hb hab hcross hclose
      (fun i => by simpa [R] using hrle i)
  rw [hsumform, hrsum]
  dsimp [base] at hkz
  omega

/-- All-parity full-capacity selected-cycle lift for thin alternating hubs.
The single capacity hypothesis reserves the first hub for parity correction;
an even target may also use it, while an odd target invokes the preceding
five-edge first-hub assembly. -/
theorem cycleGraph_isContained_of_selectedCrossEdgeGraph_alternatingScaffold_cycle_matched_capacity
    {V ι : Type*} [Fintype V] {m k q theta : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D I : ι → Finset V)
    (M : Finset (SelectedCrossEdge V ι))
    (hscaffold : ∀ i, IsCyclicAlternatingScaffold G q (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hq : 5 ≤ q) (htheta : 6 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hIA : ∀ i, I i ⊆ A i)
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (A i))
    (hcopy : cycleGraph (m + 1) ⊑ SelectedCrossEdgeGraph M)
    (hbase : 7 * (m + 1) ≤ k)
    (hcap : (k - (7 * (m + 1) - 1)) / 2 ≤
      (q - 4) * m) :
    cycleGraph k ⊑ G := by
  classical
  by_cases heven : (k - 7 * (m + 1)) % 2 = 0
  · apply cycleGraph_isContained_of_selectedCrossEdgeGraph_alternatingScaffold_cycle_long_capacity
      hm hk G A B D I M hscaffold hrob hmajorD (by omega) (by omega)
        hregions hIA hM hcopy hbase heven
    have hsub : k - 7 * (m + 1) ≤
        k - (7 * (m + 1) - 1) := by omega
    calc
      (k - 7 * (m + 1)) / 2 ≤
          (k - (7 * (m + 1) - 1)) / 2 := Nat.div_le_div_right hsub
      _ ≤ (q - 4) * m := hcap
      _ ≤ (q - 4) * (m + 1) := Nat.mul_le_mul_left _ (by omega)
  · have hodd : (k - 7 * (m + 1)) % 2 = 1 := by omega
    have hshift : k - (7 * (m + 1) - 1) =
        (k - 7 * (m + 1)) + 1 := by omega
    have hpar : (k - (7 * (m + 1) - 1)) % 2 = 0 := by
      rw [hshift]
      omega
    exact
      cycleGraph_isContained_of_selectedCrossEdgeGraph_alternatingScaffold_cycle_matched_odd_capacity
        hm hk G A B D I M hscaffold hrob hmajorD hq htheta hregions
          hIA hM hmatch hcopy (by omega) hpar hcap

/-- All-parity lift for a cycle in a globally selected auxiliary graph.
Freshness of selected handles gives distinct attachments at every hub, and
one matching-backed hub supplies the parity correction.  This is the exact
selected-edge analogue of the large-cross-matching cycle lift. -/
theorem cycleGraph_isContained_of_selectedCrossEdgeGraph_cycle_matched
    {V ι : Type*} [Fintype V] {m ℓ k : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T I : ι → Finset V) (θ : ι → ℕ)
    (M : Finset (SelectedCrossEdge V ι))
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hIU : ∀ i, I i ⊆ U i)
    (hM : IsSelectedCrossEdgeSystem G I M)
    (hmatch : ∀ i, HasThreeDisjointAdjPairFamily G (U i))
    (hℓ : 5 ≤ ℓ)
    (hℓU : ∀ i, ℓ ≤ (U i).card)
    (hℓθ : ∀ i, ℓ + 1 ≤ θ i)
    (r : Fin m → ℕ)
    (hU : ∀ i : ι, ∀ j : Fin m, r j + 2 ≤ (U i).card)
    (hθ : ∀ i : ι, ∀ j : Fin m,
      2 * (r j + 1) + 1 ≤ θ i)
    (hcopy : cycleGraph (m + 1) ⊑ SelectedCrossEdgeGraph M)
    (hlen : ℓ + (∑ j : Fin m, 2 * (r j + 1)) + m + 1 = k) :
    cycleGraph k ⊑ G := by
  classical
  obtain ⟨f, hfinj, a, b, haI, hbI, hab, hcross, hclose⟩ :=
    exists_distinct_cyclic_cross_edges_of_cycleGraph_isContained_selectedCrossEdgeGraph
      hm G I M hM hcopy
  apply cycleGraph_isContained_of_cyclic_disjoint_robustPairSets_matched_fin
    G hk (fun i => U (f i)) (fun i => T (f i)) (fun i => θ (f i))
      (fun i => hrob (f i))
      (fun i j hij => hregions (f i) (f j) (by
        intro h
        exact hij (hfinj h)))
      (hmatch (f 0)) a b
      (fun i => hIU (f i) (haI i))
      (fun i => hIU (f i) (hbI i))
      hab hcross hclose hℓ (hℓU (f 0)) (hℓθ (f 0)) r
  · intro j
    exact hU (f j.succ) j
  · intro j
    exact hθ (f j.succ) j
  · exact hlen

/-- Every parity-unbroken alternating core is counted directly, without
repeated-attachment pruning.  The independent remainder in each core feeds
the provenance-preserving selected-path dichotomy; its long branch is
excluded by the hybrid selected-prefix/BFS-return lift. -/
theorem unbroken_alternatingScaffold_selected_count_of_hybrid_lift
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {theta k n σ pathThreshold : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hpath : 2 ≤ pathThreshold)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hσA : ∀ i, σ ≤ (A i).card)
    (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hbase : ∀ d s : ℕ,
      pathThreshold ≤ d → d ≤ pathThreshold + 1 →
      s ≤ 2 * Nat.log 2
        (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}) →
      (d + s) + 6 * (d - 1) + 2 * (s + 1) ≤ k)
    (hcap : ∀ d s : ℕ,
      pathThreshold ≤ d → d ≤ pathThreshold + 1 →
      s ≤ 2 * Nat.log 2
        (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}) →
      (k - ((d + s) + 6 * (d - 1))) / 2 ≤
        (9 * Nat.sqrt k - 4) * (d - 1))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (((σ - 4) - 4 * (pathThreshold + 1)) *
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} <
      32 * (pathThreshold + 1) * n) := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
  let AJ : J → Finset V := fun i => A i.1
  let BJ : J → Finset V := fun i => B i.1
  let DJ : J → Finset V := fun i => D i.1
  by_cases hJ : Nonempty J
  · let : Nonempty J := hJ
    let I : J → Finset V := fun i =>
      Classical.choose
        (exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
          G (AJ i) i.2)
    have hI : ∀ i : J,
        I i ⊆ AJ i ∧ G.IsIndepSet (I i : Set V) ∧
          (AJ i).card - 4 ≤ (I i).card := by
      intro i
      exact Classical.choose_spec
        (exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
          G (AJ i) i.2)
    have hIcard : ∀ i : J, σ - 4 ≤ (I i).card := by
      intro i
      exact (Nat.sub_le_sub_right (by simpa [AJ] using hσA i.1) 4).trans
        (hI i).2.2
    have hIdisj : ∀ i j : J, i ≠ j → Disjoint (I i) (I j) := by
      intro i j hij
      apply (hregions i.1 j.1 (by intro h; exact hij (Subtype.ext h))).mono
      · exact (hI i).1.trans
          (Finset.subset_union_left.trans Finset.subset_union_left)
      · exact (hI j).1.trans
          (Finset.subset_union_left.trans Finset.subset_union_left)
    obtain hlong | hcount :=
      exists_selected_path_with_even_return_or_transversal_count
        G I (n := n) (σ := σ - 4) (D := pathThreshold) (parity := k)
          hpath hfree hIcard (fun i => (hI i).2.1) hIdisj
    · obtain ⟨M, hM, u, v, p, r, j, hp, hplow, hpup, hpparity,
          hj, hr, hreven, hrlen, hdisj⟩ := hlong
      exfalso
      apply hcycle
      refine cycleGraph_isContained_of_selected_path_and_hubInteraction_return
        hk G AJ BJ DJ I M
          (fun i ↦ hscaffold i.1)
          (fun i ↦ hrob i.1)
          (fun i ↦ hmajorD i.1)
          (fun i ↦ by simpa [AJ] using hAcard i.1)
          (by
            have hsqrt : 1 ≤ Nat.sqrt k := Nat.sqrt_pos.mpr (by omega)
            omega)
          htheta
          (fun i l hil ↦ hregions i.1 l.1 (by
            intro h
            exact hil (Subtype.ext h)))
          (fun i ↦ (hI i).1) hM
          p hp (hpath.trans hplow) r hr hdisj ?_ ?_ ?_
      · apply hbase p.length r.length hplow hpup
        exact hrlen.trans (Nat.mul_le_mul_left 2 hj)
      · rcases hreven with ⟨t, ht⟩
        omega
      · apply hcap p.length r.length hplow hpup
        exact hrlen.trans (Nat.mul_le_mul_left 2 hj)
    · simpa [J] using hcount
  · have hcard : Fintype.card J = 0 :=
      Fintype.card_eq_zero_iff.mpr (not_nonempty_iff.mp hJ)
    simp [J] at hcard
    simp only [card_subtype_compl, gt_iff_lt]
    positivity

/-- Parity-unbroken alternating cores satisfy a selected-transversal count
unless one core is heavily consumed by repeated attachments.  On the
retained branch, delete at most four internal-matching endpoints from every
unbroken pruned core.  The resulting independent classes feed the global
component-BFS selected-path dichotomy.  Its same-parity interaction cycle
lies in the canonically pruned cores and therefore lifts, at full aggregate
scaffold capacity, to the forbidden ambient `C_k`. -/
theorem unbroken_alternatingScaffold_selected_count_or_heavy_repeated_attachment
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {theta k n σ pathThreshold : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hpath : 2 ≤ pathThreshold)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hbase : ∀ ℓ : ℕ,
      pathThreshold + 1 ≤ ℓ →
      ℓ ≤ pathThreshold + 1 +
        2 * Nat.log 2
          (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}) →
      7 * ℓ ≤ k)
    (hcap : ∀ ℓ : ℕ,
      pathThreshold + 1 ≤ ℓ →
      ℓ ≤ pathThreshold + 1 +
        2 * Nat.log 2
          (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}) →
      (k - 7 * ℓ) / 2 ≤ (9 * Nat.sqrt k - 4) * ℓ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (((σ - 4) - 4 * (pathThreshold + 1)) *
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} <
      32 * (pathThreshold + 1) * n) ∨
      ∃ i : {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)},
        (A i.1 \ RepeatedAttachmentFinset G
          (fun j : {j : ι // ¬ HasThreeDisjointAdjPairFamily G (A j)} =>
            A j.1)).card < σ := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
  let AJ : J → Finset V := fun i => A i.1
  let BJ : J → Finset V := fun i => B i.1
  let DJ : J → Finset V := fun i => D i.1
  let R : Finset V := RepeatedAttachmentFinset G AJ
  let S : J → Finset V := fun i => AJ i \ R
  by_cases hJ : Nonempty J
  · let : Nonempty J := hJ
    by_cases hretain : ∀ i : J, σ ≤ (S i).card
    · let I : J → Finset V := fun i =>
        Classical.choose
          (exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
            G (S i)
              (not_hasThreeDisjointAdjPairFamily_of_subset
                Finset.sdiff_subset i.2))
      have hI : ∀ i : J,
          I i ⊆ S i ∧ G.IsIndepSet (I i : Set V) ∧
            (S i).card - 4 ≤ (I i).card := by
        intro i
        exact Classical.choose_spec
          (exists_large_indep_sdiff_of_not_hasThreeDisjointAdjPairFamily
            G (S i)
              (not_hasThreeDisjointAdjPairFamily_of_subset
                Finset.sdiff_subset i.2))
      have hIcard : ∀ i : J, σ - 4 ≤ (I i).card := by
        intro i
        exact (Nat.sub_le_sub_right (hretain i) 4).trans (hI i).2.2
      have hIdisj : ∀ i j : J, i ≠ j → Disjoint (I i) (I j) := by
        intro i j hij
        apply (hregions i.1 j.1 ?_).mono
        · exact (hI i).1.trans
            (Finset.sdiff_subset.trans
              (Finset.subset_union_left.trans Finset.subset_union_left))
        · exact (hI j).1.trans
            (Finset.sdiff_subset.trans
              (Finset.subset_union_left.trans Finset.subset_union_left))
        · intro h
          exact hij (Subtype.ext h)
      obtain haux | hcount :=
        exists_same_parity_hubInteraction_cycle_or_selected_transversal_count
          G I (n := n) (σ := σ - 4) (D := pathThreshold) (parity := k)
            hpath hfree hIcard (fun i => (hI i).2.1) hIdisj
      · obtain ⟨j, ℓ, hj, hcopyI, hlow, hupp, hparity⟩ := haux
        exfalso
        apply hcycle
        have hIS : ∀ i : J, I i ⊆ S i := fun i => (hI i).1
        have hgraph : HubInteractionGraph G I ≤ HubInteractionGraph G S := by
          intro i l hil
          obtain ⟨x, hx, y, hy, hxy⟩ :=
            exists_cross_edge_of_hubInteractionGraph_adj G I hil
          rw [HubInteractionGraph, SimpleGraph.fromRel_adj]
          exact ⟨hil.ne, Or.inl
            ⟨x, hIS i hx, y, hIS l hy, hxy⟩⟩
        have hcopyS : cycleGraph ℓ ⊑ HubInteractionGraph G S :=
          hcopyI.trans (SimpleGraph.IsContained.of_le hgraph)
        let m : ℕ := ℓ - 1
        have hm : 2 ≤ m := by
          dsimp [m]
          omega
        have hmℓ : m + 1 = ℓ := by
          dsimp [m]
          omega
        have hupp' : ℓ ≤ pathThreshold + 1 +
            2 * Nat.log 2 (Fintype.card J) := by
          exact hupp.trans (Nat.add_le_add_left
            (Nat.mul_le_mul_left 2 hj) (pathThreshold + 1))
        have hbaseℓ : 7 * ℓ ≤ k := by
          apply hbase ℓ hlow
          simpa [J] using hupp'
        have hcapℓ : (k - 7 * ℓ) / 2 ≤
            (9 * Nat.sqrt k - 4) * ℓ := by
          apply hcap ℓ hlow
          simpa [J] using hupp'
        have hpar : (k - 7 * ℓ) % 2 = 0 := by
          omega
        apply cycleGraph_isContained_of_pruned_alternatingScaffold_cycle_long_capacity
          hm hk G AJ BJ DJ R
        · intro i
          exact hscaffold i.1
        · intro i
          exact hrob i.1
        · intro i
          exact hmajorD i.1
        · have hsqrt : 1 ≤ Nat.sqrt k := Nat.sqrt_pos.mpr (by omega)
          omega
        · exact htheta
        · intro i l hil
          apply hregions i.1 l.1
          intro h
          exact hil (Subtype.ext h)
        · rw [hmℓ]
          simpa [S, R, AJ] using hcopyS
        · simpa [R, AJ] using
            (no_repeated_attachment_outside_RepeatedAttachmentFinset G AJ)
        · simpa [hmℓ] using hbaseℓ
        · simpa [hmℓ] using hpar
        · simpa [hmℓ] using hcapℓ
      · exact Or.inl hcount
    · right
      push Not at hretain
      obtain ⟨i, hi⟩ := hretain
      exact ⟨i, by simpa [S, R, AJ] using hi⟩
  · left
    have hcardJ : Fintype.card J = 0 :=
      Fintype.card_eq_zero_iff.mpr (not_nonempty_iff.mp hJ)
    simp only [show
      Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} = 0 by
        simpa [J] using hcardJ, Nat.mul_zero]
    have : 0 < 32 * (pathThreshold + 1) * n := by positivity
    exact this

/-- Retained form of the preceding dichotomy.  When every displayed core is
parity-unbroken and at least `σ` vertices of each core survive the canonical
repeated-attachment deletion, the heavy branch is impossible, so the
selected-transversal estimate holds for the whole index type. -/
theorem unbroken_alternatingScaffold_selected_count_of_full_retention
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {theta k n σ pathThreshold : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hpath : 2 ≤ pathThreshold)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hunbroken : ∀ i, ¬ HasThreeDisjointAdjPairFamily G (A i))
    (hretain : ∀ i,
      σ ≤ (A i \ RepeatedAttachmentFinset G A).card)
    (hbase : ∀ ℓ : ℕ,
      pathThreshold + 1 ≤ ℓ →
      ℓ ≤ pathThreshold + 1 + 2 * Nat.log 2 (Fintype.card ι) →
      7 * ℓ ≤ k)
    (hcap : ∀ ℓ : ℕ,
      pathThreshold + 1 ≤ ℓ →
      ℓ ≤ pathThreshold + 1 + 2 * Nat.log 2 (Fintype.card ι) →
      (k - 7 * ℓ) / 2 ≤ (9 * Nat.sqrt k - 4) * ℓ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ((σ - 4) - 4 * (pathThreshold + 1)) * Fintype.card ι <
      32 * (pathThreshold + 1) * n := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
  let e : J ≃ ι :=
    { toFun := Subtype.val
      invFun := fun i => ⟨i, hunbroken i⟩
      left_inv := fun i => by ext; rfl
      right_inv := fun _ => rfl }
  have hcardJ : Fintype.card J = Fintype.card ι :=
    Fintype.card_congr e
  obtain hcount | hheavy :=
    unbroken_alternatingScaffold_selected_count_or_heavy_repeated_attachment
      G A B D hk hn hpath hfree hscaffold hrob hmajorD hAcard htheta
        hregions
        (fun ℓ hlo hupp => hbase ℓ hlo (by simpa [J, hcardJ] using hupp))
        (fun ℓ hlo hupp => hcap ℓ hlo (by simpa [J, hcardJ] using hupp))
        hcycle
  · simpa [J, hcardJ] using hcount
  · obtain ⟨i, hi⟩ := hheavy
    have hRsub :
        RepeatedAttachmentFinset G (fun j : J => A j.1) ⊆
          RepeatedAttachmentFinset G A := by
      let e' : J ↪ ι := ⟨Subtype.val, Subtype.val_injective⟩
      simpa [e'] using
        (RepeatedAttachmentFinset_comp_embedding_subset G A e')
    have hsurvSub :
        A i.1 \ RepeatedAttachmentFinset G A ⊆
          A i.1 \ RepeatedAttachmentFinset G (fun j : J => A j.1) := by
      intro x hx
      simp only [Finset.mem_sdiff] at hx ⊢
      exact ⟨hx.1, fun h => hx.2 (hRsub h)⟩
    exfalso
    exact (not_lt_of_ge ((hretain i.1).trans
      (Finset.card_le_card hsurvSub))) hi

/-- Quantitative light/heavy decomposition of the parity-unbroken cores.
The light subtype consists of cores retaining at least `σ` vertices after
the repeated-attachment deletion for the *whole* unbroken family.  Its
selected-transversal count holds unconditionally: restricting the family
can only shrink the repeated-attachment set.  The complementary heavy
subtype is charged injectively, with `9 * sqrt k - σ + 1` vertices per core,
to that same exceptional set. -/
theorem unbroken_alternatingScaffold_light_count_and_heavy_charge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {theta k n σ pathThreshold : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hpath : 2 ≤ pathThreshold)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) theta)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hσA : σ ≤ 9 * Nat.sqrt k)
    (htheta : 3 ≤ theta)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hbase : ∀ ℓ : ℕ,
      pathThreshold + 1 ≤ ℓ →
      ℓ ≤ pathThreshold + 1 +
        2 * Nat.log 2
          (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}) →
      7 * ℓ ≤ k)
    (hcap : ∀ ℓ : ℕ,
      pathThreshold + 1 ≤ ℓ →
      ℓ ≤ pathThreshold + 1 +
        2 * Nat.log 2
          (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}) →
      (k - 7 * ℓ) / 2 ≤ (9 * Nat.sqrt k - 4) * ℓ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
    let AJ : J → Finset V := fun i => A i.1
    let R : Finset V := RepeatedAttachmentFinset G AJ
    let L := {i : J // σ ≤ (AJ i \ R).card}
    (((σ - 4) - 4 * (pathThreshold + 1)) * Fintype.card L <
        32 * (pathThreshold + 1) * n) ∧
      (9 * Nat.sqrt k - σ + 1) *
          ((Finset.univ : Finset J).filter
            (fun i => (AJ i \ R).card < σ)).card ≤ R.card := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
  let AJ : J → Finset V := fun i => A i.1
  let R : Finset V := RepeatedAttachmentFinset G AJ
  let L := {i : J // σ ≤ (AJ i \ R).card}
  let AL : L → Finset V := fun i => AJ i.1
  let BL : L → Finset V := fun i => B i.1.1
  let DL : L → Finset V := fun i => D i.1.1
  change
    (((σ - 4) - 4 * (pathThreshold + 1)) * Fintype.card L <
        32 * (pathThreshold + 1) * n) ∧
      (9 * Nat.sqrt k - σ + 1) *
          ((Finset.univ : Finset J).filter
            (fun i => (AJ i \ R).card < σ)).card ≤ R.card
  have hAJdisj : ∀ i j : J, i ≠ j → Disjoint (AJ i) (AJ j) := by
    intro i j hij
    apply (hregions i.1 j.1 ?_).mono
    · exact Finset.subset_union_left.trans Finset.subset_union_left
    · exact Finset.subset_union_left.trans Finset.subset_union_left
    · intro h
      exact hij (Subtype.ext h)
  have hRsub : RepeatedAttachmentFinset G AL ⊆ R := by
    let e : L ↪ J := ⟨Subtype.val, Subtype.val_injective⟩
    simpa [AL, R, e] using
      (RepeatedAttachmentFinset_comp_embedding_subset G AJ e)
  have hcardL : Fintype.card L ≤ Fintype.card J :=
    Fintype.card_subtype_le _
  have hlogL : Nat.log 2 (Fintype.card L) ≤
      Nat.log 2 (Fintype.card J) := Nat.log_mono_right hcardL
  constructor
  · apply unbroken_alternatingScaffold_selected_count_of_full_retention
      G AL BL DL hk hn hpath hfree
    · intro i
      exact hscaffold i.1.1
    · intro i
      exact hrob i.1.1
    · intro i
      exact hmajorD i.1.1
    · intro i
      exact hAcard i.1.1
    · exact htheta
    · intro i j hij
      apply hregions i.1.1 j.1.1
      intro h
      exact hij (Subtype.ext (Subtype.ext h))
    · intro i
      exact i.1.2
    · intro i
      have hsub : AL i \ R ⊆
          AL i \ RepeatedAttachmentFinset G AL := by
        intro x hx
        exact Finset.mem_sdiff.mpr
          ⟨(Finset.mem_sdiff.mp hx).1,
            fun hxsmall => (Finset.mem_sdiff.mp hx).2 (hRsub hxsmall)⟩
      exact i.2.trans (Finset.card_le_card hsub)
    · intro ℓ hlo hupp
      apply hbase ℓ hlo
      exact hupp.trans (Nat.add_le_add_left
        (Nat.mul_le_mul_left 2 hlogL) (pathThreshold + 1))
    · intro ℓ hlo hupp
      apply hcap ℓ hlo
      exact hupp.trans (Nat.add_le_add_left
        (Nat.mul_le_mul_left 2 hlogL) (pathThreshold + 1))
    · exact hcycle
  · exact mul_card_heavy_sdiff_lt_le_card AJ R
      (fun i => hAcard i.1) hσA hAJdisj

/-- Diagonal-scale specialization of the light/heavy unbroken-core split.
Take path threshold `floor(sqrt k / 16)` and retain threshold `8 * sqrt k`.
The preceding square-root/log lemmas discharge all fitting hypotheses from
only the extremal host-order bound on the number of labels. -/
theorem unbroken_alternatingScaffold_diagonal_light_count_and_heavy_charge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {k n : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hnk : n ≤ k)
    (hsqrt : 64 ≤ Nat.sqrt k)
    (hlabels : Fintype.card ι ≤ (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) 7)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
    let AJ : J → Finset V := fun i => A i.1
    let R : Finset V := RepeatedAttachmentFinset G AJ
    let L := {i : J // 8 * Nat.sqrt k ≤ (AJ i \ R).card}
    ((((8 * Nat.sqrt k - 4) -
          4 * (Nat.sqrt k / 16 + 1)) * Fintype.card L <
        32 * (Nat.sqrt k / 16 + 1) * n) ∧
      (9 * Nat.sqrt k - 8 * Nat.sqrt k + 1) *
          ((Finset.univ : Finset J).filter
            (fun i => (AJ i \ R).card < 8 * Nat.sqrt k)).card ≤ R.card) := by
  have hpath : 2 ≤ Nat.sqrt k / 16 := by omega
  apply unbroken_alternatingScaffold_light_count_and_heavy_charge
    G A B D hk hn hpath hfree hscaffold hrob hmajorD hAcard
      (by omega) (by omega) hregions
  · intro ℓ hlow hupp
    have hJcard :
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} ≤
          Fintype.card ι := Fintype.card_subtype_le _
    have hfit := seven_mul_sqrt_sixteenth_log_interval_le
      hsqrt hnk (hJcard.trans hlabels)
    exact (Nat.mul_le_mul_left 7 hupp).trans hfit
  · intro ℓ hlow _hupp
    exact sqrt_sixteenth_long_capacity hsqrt hlow
  · exact hcycle

/-- Direct diagonal count of all parity-unbroken cores.  The hybrid lift
removes the light/heavy repeated-attachment split: every unbroken core
contributes its full independent remainder to the selected-path count. -/
theorem unbroken_alternatingScaffold_diagonal_count_of_hybrid_lift
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {k n : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hnk : n ≤ k)
    (hsqrt : 336 ≤ Nat.sqrt k)
    (hlabels : Fintype.card ι ≤ (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) 7)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    (((9 * Nat.sqrt k - 4) -
          4 * (Nat.sqrt k / 16 + 1)) *
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} <
      32 * (Nat.sqrt k / 16 + 1) * n) := by
  have hpath : 2 ≤ Nat.sqrt k / 16 := by omega
  apply unbroken_alternatingScaffold_selected_count_of_hybrid_lift
    G A B D hk hn hpath hfree hscaffold hrob hmajorD hAcard
      (fun i => by rw [hAcard i]) (by omega) hregions
  · intro d s hdlo hdhi hs
    have hJcard :
        Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} ≤
          Fintype.card ι := Fintype.card_subtype_le _
    have hfit := seven_mul_sqrt_sixteenth_log_interval_le
      (by omega : 64 ≤ Nat.sqrt k) hnk (hJcard.trans hlabels)
    have hsmall :
        (d + s) + 6 * (d - 1) + 2 * (s + 1) ≤
          7 * (Nat.sqrt k / 16 + 1 +
            2 * Nat.log 2
              (Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)})) := by
      omega
    exact hsmall.trans hfit
  · intro d s hdlo _hdhi _hs
    calc
      (k - ((d + s) + 6 * (d - 1))) / 2 ≤ k / 2 :=
        Nat.div_le_div_right (Nat.sub_le k _)
      _ ≤ (9 * Nat.sqrt k - 4) * (d - 1) :=
        sqrt_sixteenth_internal_selected_capacity hsqrt hdlo
  · exact hcycle

/-- In particular, fewer than `n` compact cores are parity-unbroken; no
heavy repeated-attachment alternative remains. -/
theorem unbroken_alternatingScaffold_diagonal_card_lt_of_hybrid_lift
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {k n : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hnk : n ≤ k)
    (hsqrt : 336 ≤ Nat.sqrt k)
    (hlabels : Fintype.card ι ≤ (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) 7)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} < n := by
  have hcount :=
    unbroken_alternatingScaffold_diagonal_count_of_hybrid_lift
      G A B D hk hn hnk hsqrt hlabels hfree hscaffold hrob hmajorD
        hAcard hregions hcycle
  let s : ℕ := Nat.sqrt k
  let c : ℕ := (9 * s - 4) - 4 * (s / 16 + 1)
  have hc : 8 * s ≤ c := by dsimp [c]; omega
  have hr : 32 * (s / 16 + 1) ≤ 3 * s := by omega
  by_contra hnot
  have hncard : n ≤
      Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} := by
    omega
  have hlower : 8 * s * n ≤ c *
      Fintype.card {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} := by
    exact (Nat.mul_le_mul_right _ hc).trans
      (Nat.mul_le_mul_left c hncard)
  have hupper : 32 * (s / 16 + 1) * n ≤ 3 * s * n :=
    Nat.mul_le_mul_right n hr
  have hspos : 0 < s := by omega
  have hsep : 3 * s * n < 8 * s * n := by nlinarith
  simpa [s, c] using
    hlower.trans_lt ((hcount.trans_le hupper).trans hsep)

/-- All but at most `n-1` compact cores are parity-broken. -/
theorem alternatingScaffold_diagonal_broken_accounting_of_hybrid_lift
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {k n : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hnk : n ≤ k)
    (hsqrt : 336 ≤ Nat.sqrt k)
    (hlabels : Fintype.card ι ≤ (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) 7)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    Fintype.card ι ≤
      Fintype.card {i : ι // HasThreeDisjointAdjPairFamily G (A i)} + (n - 1) := by
  have hunbroken :=
    unbroken_alternatingScaffold_diagonal_card_lt_of_hybrid_lift
      G A B D hk hn hnk hsqrt hlabels hfree hscaffold hrob hmajorD
        hAcard hregions hcycle
  have hsplit := Fintype.card_subtype_compl
    (fun i : ι => HasThreeDisjointAdjPairFamily G (A i))
  omega

/-- Clean cardinal consequence of the diagonal light estimate: fewer than
`n` parity-unbroken cores can retain `8 * sqrt k` vertices.  The heavy-core
charge is preserved verbatim. -/
theorem unbroken_alternatingScaffold_diagonal_light_card_lt_and_heavy_charge
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {k n : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hnk : n ≤ k)
    (hsqrt : 64 ≤ Nat.sqrt k)
    (hlabels : Fintype.card ι ≤ (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) 7)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
    let AJ : J → Finset V := fun i => A i.1
    let R : Finset V := RepeatedAttachmentFinset G AJ
    let L := {i : J // 8 * Nat.sqrt k ≤ (AJ i \ R).card}
    Fintype.card L < n ∧
      (9 * Nat.sqrt k - 8 * Nat.sqrt k + 1) *
          ((Finset.univ : Finset J).filter
            (fun i => (AJ i \ R).card < 8 * Nat.sqrt k)).card ≤ R.card := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
  let AJ : J → Finset V := fun i => A i.1
  let R : Finset V := RepeatedAttachmentFinset G AJ
  let L := {i : J // 8 * Nat.sqrt k ≤ (AJ i \ R).card}
  change Fintype.card L < n ∧
    (9 * Nat.sqrt k - 8 * Nat.sqrt k + 1) *
        ((Finset.univ : Finset J).filter
          (fun i => (AJ i \ R).card < 8 * Nat.sqrt k)).card ≤ R.card
  obtain ⟨hcount, hcharge⟩ :=
    unbroken_alternatingScaffold_diagonal_light_count_and_heavy_charge
      G A B D hk hn hnk hsqrt hlabels hfree hscaffold hrob hmajorD
        hAcard hregions hcycle
  refine ⟨?_, hcharge⟩
  let s : ℕ := Nat.sqrt k
  let c : ℕ := (8 * s - 4) - 4 * (s / 16 + 1)
  have hspos : 0 < s := by omega
  have hc : 7 * s ≤ c := by
    dsimp [c]
    omega
  have hr : 32 * (s / 16 + 1) ≤ 4 * s := by omega
  have hsmall : 7 * s * Fintype.card L < 4 * s * n := by
    calc
      7 * s * Fintype.card L ≤ c * Fintype.card L :=
        Nat.mul_le_mul_right _ hc
      _ < 32 * (s / 16 + 1) * n := by
        simpa [s, c, J, AJ, R, L] using hcount
      _ ≤ 4 * s * n := Nat.mul_le_mul_right n hr
  have hcancel : 7 * Fintype.card L < 4 * n := by
    apply (Nat.mul_lt_mul_left hspos).mp
    simpa [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hsmall
  omega

/-
/-- Global index accounting at the diagonal scales.  Every alternating core
is either parity-broken, one of fewer than `n` light unbroken cores, or a
heavy unbroken core; every heavy core contributes at least `sqrt k + 1`
distinct vertices to the unbroken repeated-attachment set. -/
theorem alternatingScaffold_diagonal_broken_light_heavy_accounting
    {V ι : Type*} [Fintype V] [Fintype ι]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A B D : ι → Finset V) {k n : ℕ}
    (hk : 3 ≤ k) (hn : 0 < n) (hnk : n ≤ k)
    (hsqrt : 64 ≤ Nat.sqrt k)
    (hlabels : Fintype.card ι ≤ (k - 1) * (n - 1) + 1)
    (hfree : G.IndepSetFree n)
    (hscaffold : ∀ i,
      IsCyclicAlternatingScaffold G (9 * Nat.sqrt k) (A i) (B i))
    (hrob : ∀ i, RobustPairSet G (A i) (D i) 7)
    (hmajorD : ∀ i, Disjoint (A i ∪ B i) (D i))
    (hAcard : ∀ i, (A i).card = 9 * Nat.sqrt k)
    (hregions : ∀ i j, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
    let AJ : J → Finset V := fun i => A i.1
    let R : Finset V := RepeatedAttachmentFinset G AJ
    let H : Finset J := Finset.univ.filter
      (fun i => (AJ i \ R).card < 8 * Nat.sqrt k)
    Fintype.card ι ≤
        Fintype.card {i : ι // HasThreeDisjointAdjPairFamily G (A i)} +
          (n - 1) + H.card ∧
      (Nat.sqrt k + 1) * H.card ≤ R.card := by
  classical
  let J := {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)}
  let AJ : J → Finset V := fun i => A i.1
  let R : Finset V := RepeatedAttachmentFinset G AJ
  let H : Finset J := Finset.univ.filter
    (fun i => (AJ i \ R).card < 8 * Nat.sqrt k)
  change Fintype.card ι ≤
      Fintype.card {i : ι // HasThreeDisjointAdjPairFamily G (A i)} +
        (n - 1) + H.card ∧
    (Nat.sqrt k + 1) * H.card ≤ R.card
  obtain ⟨hlight, hcharge⟩ :=
    unbroken_alternatingScaffold_diagonal_light_card_lt_and_heavy_charge
      G A B D hk hn hnk hsqrt hlabels hfree hscaffold hrob hmajorD
        hAcard hregions hcycle
  constructor
  · have hlight' :
        Fintype.card
            {i : {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} //
              8 * Nat.sqrt k ≤
                (A i.1 \ RepeatedAttachmentFinset G
                  (fun j : {j : ι //
                      ¬ HasThreeDisjointAdjPairFamily G (A j)} => A j.1)).card} < n := by
      simpa only using hlight
    have haccount :=
      fintypeCard_le_subtype_add_pred_of_complement_light
        (n := n)
        (fun i : ι => HasThreeDisjointAdjPairFamily G (A i))
        (fun i : {i : ι // ¬ HasThreeDisjointAdjPairFamily G (A i)} =>
          8 * Nat.sqrt k ≤ (A i.1 \ RepeatedAttachmentFinset G
            (fun j : {j : ι // ¬ HasThreeDisjointAdjPairFamily G (A j)} =>
              A j.1)).card)
        (by simpa only using hlight')
    simpa [J, AJ, R, H, not_le] using haccount
  · have hcoef :
        9 * Nat.sqrt k - 8 * Nat.sqrt k + 1 = Nat.sqrt k + 1 := by
      omega
    simpa [J, AJ, R, H, hcoef] using hcharge
-/

/-- Select the explicit scaffold data from every compact alternating hub.
After canonical repeated-attachment pruning, the preceding capacity lift
forbids every auxiliary cycle whose displayed arithmetic data fit. -/
theorem exists_compactAlternatingHub_core_data_with_no_even_capacity_cycle
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {theta tau M m k : ℕ}
    (hhub : ∀ H ∈ F, IsCompactAlternatingHub G theta tau M H)
    (hdisj : DisjointFinsetFamily F)
    (htheta : 2 ≤ theta) (htau : 3 ≤ tau)
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (hbase : 5 * (m + 1) ≤ k)
    (hpar : (k - 5 * (m + 1)) % 2 = 0)
    (hcap : (k - 5 * (m + 1)) / 2 ≤
      (tau / 3 - 1) * (m + 1))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ A B D : F → Finset V,
      (∀ i : F,
        (A i).card = tau ∧ (B i).card = tau ∧
        Disjoint (A i) (B i) ∧ Disjoint (A i ∪ B i) (D i) ∧
        IsCyclicAlternatingScaffold G tau (A i) (B i) ∧
        RobustPairSet G (A i) (D i) theta) ∧
      (∀ i j : F, i ≠ j →
        Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j)) ∧
      ¬ cycleGraph (m + 1) ⊑ HubInteractionGraph G
        (fun i : F => A i \ RepeatedAttachmentFinset G A) := by
  classical
  have hhub' : ∀ i : F, ∃ A B D : Finset V,
      A.card = tau ∧ B.card = tau ∧ Disjoint A B ∧
      Disjoint (A ∪ B) D ∧
      (i : Finset V) = (A ∪ B) ∪ D ∧ (i : Finset V).card < M ∧
      IsCyclicAlternatingScaffold G tau A B ∧
      RobustPairSet G A D theta := by
    intro i
    simpa [IsCompactAlternatingHub] using hhub i.1 i.2
  choose A B D hdata using hhub'
  have hpoint : ∀ i : F,
      (A i).card = tau ∧ (B i).card = tau ∧
      Disjoint (A i) (B i) ∧ Disjoint (A i ∪ B i) (D i) ∧
      IsCyclicAlternatingScaffold G tau (A i) (B i) ∧
      RobustPairSet G (A i) (D i) theta := by
    intro i
    rcases hdata i with
      ⟨hA, hB, hAB, hmajor, _hH, _hcard, hscaffold, hrob⟩
    exact ⟨hA, hB, hAB, hmajor, hscaffold, hrob⟩
  have hregions : ∀ i j : F, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j) := by
    intro i j hij
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    have hi : (i : Finset V) = (A i ∪ B i) ∪ D i := by
      rcases hdata i with
        ⟨_hA, _hB, _hAB, _hmajor, hH, _hcard, _hscaffold, _hrob⟩
      exact hH
    have hj : (j : Finset V) = (A j ∪ B j) ∪ D j := by
      rcases hdata j with
        ⟨_hA, _hB, _hAB, _hmajor, hH, _hcard, _hscaffold, _hrob⟩
      exact hH
    rw [← hi, ← hj]
    exact hdisj i i.2 j j.2 hval
  refine ⟨A, B, D, hpoint, hregions, ?_⟩
  intro hcopy
  apply hcycle
  apply cycleGraph_isContained_of_pruned_alternatingScaffold_cycle_even_capacity
    hm hk G A B D (RepeatedAttachmentFinset G A)
      (fun i => (hpoint i).2.2.2.2.1)
      (fun i => (hpoint i).2.2.2.2.2)
      (fun i => (hpoint i).2.2.2.1) htheta htau hregions hcopy
      (no_repeated_attachment_outside_RepeatedAttachmentFinset G A)
      hbase hpar hcap

/-- Full-capacity compact-hub wrapper.  After selecting the alternating
scaffold data and pruning repeated attachments, an auxiliary cycle is
impossible whenever its exact residual fits the aggregate `tau - 4`
capacity of the participating hubs. -/
theorem exists_compactAlternatingHub_core_data_with_no_long_capacity_cycle
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {theta tau M m k : ℕ}
    (hhub : ∀ H ∈ F, IsCompactAlternatingHub G theta tau M H)
    (hdisj : DisjointFinsetFamily F)
    (htheta : 3 ≤ theta) (htau : 4 ≤ tau)
    (hm : 2 ≤ m) (hk : 3 ≤ k)
    (hbase : 7 * (m + 1) ≤ k)
    (hpar : (k - 7 * (m + 1)) % 2 = 0)
    (hcap : (k - 7 * (m + 1)) / 2 ≤
      (tau - 4) * (m + 1))
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ A B D : F → Finset V,
      (∀ i : F,
        (A i).card = tau ∧ (B i).card = tau ∧
        Disjoint (A i) (B i) ∧ Disjoint (A i ∪ B i) (D i) ∧
        IsCyclicAlternatingScaffold G tau (A i) (B i) ∧
        RobustPairSet G (A i) (D i) theta) ∧
      (∀ i j : F, i ≠ j →
        Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j)) ∧
      ¬ cycleGraph (m + 1) ⊑ HubInteractionGraph G
        (fun i : F => A i \ RepeatedAttachmentFinset G A) := by
  classical
  have hhub' : ∀ i : F, ∃ A B D : Finset V,
      A.card = tau ∧ B.card = tau ∧ Disjoint A B ∧
      Disjoint (A ∪ B) D ∧
      (i : Finset V) = (A ∪ B) ∪ D ∧ (i : Finset V).card < M ∧
      IsCyclicAlternatingScaffold G tau A B ∧
      RobustPairSet G A D theta := by
    intro i
    simpa [IsCompactAlternatingHub] using hhub i.1 i.2
  choose A B D hdata using hhub'
  have hpoint : ∀ i : F,
      (A i).card = tau ∧ (B i).card = tau ∧
      Disjoint (A i) (B i) ∧ Disjoint (A i ∪ B i) (D i) ∧
      IsCyclicAlternatingScaffold G tau (A i) (B i) ∧
      RobustPairSet G (A i) (D i) theta := by
    intro i
    rcases hdata i with
      ⟨hA, hB, hAB, hmajor, _hH, _hcard, hscaffold, hrob⟩
    exact ⟨hA, hB, hAB, hmajor, hscaffold, hrob⟩
  have hregions : ∀ i j : F, i ≠ j →
      Disjoint ((A i ∪ B i) ∪ D i) ((A j ∪ B j) ∪ D j) := by
    intro i j hij
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    have hi : (i : Finset V) = (A i ∪ B i) ∪ D i := (hdata i).2.2.2.2.1
    have hj : (j : Finset V) = (A j ∪ B j) ∪ D j := (hdata j).2.2.2.2.1
    rw [← hi, ← hj]
    exact hdisj i i.2 j j.2 hval
  refine ⟨A, B, D, hpoint, hregions, ?_⟩
  intro hcopy
  apply hcycle
  apply cycleGraph_isContained_of_pruned_alternatingScaffold_cycle_long_capacity
    hm hk G A B D (RepeatedAttachmentFinset G A)
      (fun i => (hpoint i).2.2.2.2.1)
      (fun i => (hpoint i).2.2.2.2.2)
      (fun i => (hpoint i).2.2.2.1) htau htheta hregions hcopy
      (no_repeated_attachment_outside_RepeatedAttachmentFinset G A)
      hbase hpar hcap

/-- Constant-capacity hubs exclude an entire interval of auxiliary cycle
lengths, not merely the single near-third length.  If `3q ≤ k ≤ 7q` and the
parities agree, distribute the residual `(k - 3q)/2` over the `q` hubs,
using internal route lengths two, four, or six. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_distributed_two
    {V ι : Type*} [Fintype V] {q k : ℕ}
    (hq : 3 ≤ q) (hqk : 3 * q ≤ k) (hkq : k ≤ 7 * q)
    (hpar : (k - 3 * q) % 2 = 0)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i, 4 ≤ (U i).card)
    (hθ : ∀ i, 7 ≤ θ i)
    (hnorep : ∀ i j s : ι, i ≠ j → i ≠ s → j ≠ s →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U s,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph q ⊑ HubInteractionGraph G (fun i => U i \ X) := by
  intro hcopy
  apply hcycle
  let z : ℕ := (k - 3 * q) / 2
  have hdiff : k - 3 * q = 2 * z := by
    dsimp [z]
    have hdivmod : 2 * ((k - 3 * q) / 2) + (k - 3 * q) % 2 = k - 3 * q :=
      Nat.div_add_mod (k - 3 * q) 2
    omega
  have hkz : k = 3 * q + 2 * z := by omega
  have hz : z ≤ 2 * q := by omega
  obtain ⟨r, hrsum, hrle⟩ := exists_fin_weights_sum_eq_le_two
    (by omega : 0 < q) hz
  let m : ℕ := q - 1
  have hm : 2 ≤ m := by dsimp [m]; omega
  have hmq : m + 1 = q := by dsimp [m]; omega
  apply cycleGraph_isContained_of_pruned_hubInteraction_cycle_even_routes
    hm (by omega) G U T θ X hrob hregions (by rw [hmq]; exact hcopy)
      hnorep (fun i : Fin (m + 1) => r (Fin.cast hmq i))
  · intro i j
    have hj := hrle (Fin.cast hmq j)
    have hi := hU i
    omega
  · intro i j
    have hj := hrle (Fin.cast hmq j)
    have hi := hθ i
    omega
  · have hsumcast :
        (∑ i : Fin (m + 1), r (Fin.cast hmq i)) = z := by
      rw [← hrsum]
      exact Fintype.sum_equiv (Fin.castOrderIso hmq).toEquiv _ _
        (fun _ => rfl)
    have hsumform :
        (∑ i : Fin (m + 1), 2 * (r (Fin.cast hmq i) + 1)) =
          2 * (∑ i : Fin (m + 1), r (Fin.cast hmq i)) + 2 * (m + 1) := by
      simp_rw [mul_add]
      rw [Finset.sum_add_distrib, ← Finset.mul_sum]
      simp
      omega
    rw [hsumform, hsumcast, hmq]
    omega

/-- Interval-form even-route exclusion.  If k = 3q + 2r, an auxiliary
q-cycle uses length two in q-1 hubs and length 2(r+1) in one distinguished
hub.  Thus any pruned q-cycle contradicts C_k-freeness whenever the robust
core and pair thresholds can pay that single even correction. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_three_mul_add_two_mul
    {V ι : Type*} [Fintype V] {q r k : ℕ}
    (hq : 3 ≤ q) (hkqr : k = 3 * q + 2 * r)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i, r + 2 ≤ (U i).card)
    (hθ : ∀ i, 2 * (r + 1) + 1 ≤ θ i)
    (hnorep : ∀ i j s : ι, i ≠ j → i ≠ s → j ≠ s →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U s,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph q ⊑ HubInteractionGraph G (fun i => U i \ X) := by
  intro hcopy
  apply hcycle
  let m : ℕ := q - 1
  have hm : 2 ≤ m := by
    dsimp [m]
    omega
  have hmq : m + 1 = q := by
    dsimp [m]
    omega
  let route : Fin (m + 1) → ℕ := fun i => if i = 0 then r else 0
  have hsum : (∑ i : Fin (m + 1), 2 * (route i + 1)) =
      2 * (r + 1) + 2 * m := by
    rw [← Finset.sum_erase_add (Finset.univ : Finset (Fin (m + 1)))
      (fun i => 2 * (route i + 1))
      (show (0 : Fin (m + 1)) ∈ Finset.univ by simp)]
    have herase :
        ∑ i ∈ (Finset.univ : Finset (Fin (m + 1))).erase 0,
            2 * (route i + 1) =
          ∑ _i ∈ (Finset.univ : Finset (Fin (m + 1))).erase 0, 2 := by
      apply Finset.sum_congr rfl
      intro i hi
      have hi0 : i ≠ 0 := (Finset.mem_erase.mp hi).1
      simp [route, hi0]
    rw [herase]
    simp [route]
    omega
  apply cycleGraph_isContained_of_pruned_hubInteraction_cycle_even_routes
    hm (by rw [hkqr]; omega) G U T θ X hrob hregions
      (by rw [hmq]; exact hcopy) hnorep route
  · intro i j
    by_cases hj : j = 0
    · subst j
      simp [route]
      exact hU i
    · simp [route, hj]
      have := hU i
      omega
  · intro i j
    by_cases hj : j = 0
    · subst j
      simp only [Order.add_one_le_iff]
      exact hθ i
    · simp [route, hj]
      have := hθ i
      omega
  · rw [hsum]
    dsimp [m]
    omega

/-- Predicate form of the forbidden interaction-cycle interval.  If q is at
most k/3 and has the parity of k, the correction r = (k-3q)/2 is integral;
the preceding theorem then excludes q whenever the uniform hub budgets cover
that correction. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_fitting_even_correction
    {V ι : Type*} [Fintype V] {q k : ℕ}
    (hq : 3 ≤ q) (hqk : 3 * q ≤ k)
    (hpar : (k - 3 * q) % 2 = 0)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i, (k - 3 * q) / 2 + 2 ≤ (U i).card)
    (hθ : ∀ i, 2 * ((k - 3 * q) / 2 + 1) + 1 ≤ θ i)
    (hnorep : ∀ i j s : ι, i ≠ j → i ≠ s → j ≠ s →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U s,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph q ⊑ HubInteractionGraph G (fun i => U i \ X) := by
  let r : ℕ := (k - 3 * q) / 2
  have hdiff : k - 3 * q = 2 * r := by
    dsimp [r]
    have hmod : (k - 3 * q) % 2 = 0 := hpar
    have hdivmod : 2 * ((k - 3 * q) / 2) + (k - 3 * q) % 2 = k - 3 * q :=
      Nat.div_add_mod (k - 3 * q) 2
    omega
  have hkqr : k = 3 * q + 2 * r := by omega
  exact not_cycleGraph_isContained_pruned_hubInteraction_of_three_mul_add_two_mul
    hq hkqr G U T θ X hrob hregions
      (by simpa [r] using hU) (by simpa [r] using hθ) hnorep hcycle

/-- Window form of the interaction-cycle exclusion.  Every same-parity q in
the interval 3q ≤ k ≤ 3q + 2R has correction at most R, so uniform core and
threshold budgets at scale R exclude all such auxiliary cycles at once. -/
theorem not_cycleGraph_isContained_pruned_hubInteraction_of_near_third_window
    {V ι : Type*} [Fintype V] {q R k : ℕ}
    (hq : 3 ≤ q) (hqk : 3 * q ≤ k) (hkq : k ≤ 3 * q + 2 * R)
    (hpar : (k - 3 * q) % 2 = 0)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i, R + 2 ≤ (U i).card)
    (hθ : ∀ i, 2 * (R + 1) + 1 ≤ θ i)
    (hnorep : ∀ i j s : ι, i ≠ j → i ≠ s → j ≠ s →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U s,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ¬ cycleGraph q ⊑ HubInteractionGraph G (fun i => U i \ X) := by
  apply not_cycleGraph_isContained_pruned_hubInteraction_of_fitting_even_correction
    hq hqk hpar G U T θ X hrob hregions
  · intro i
    have hR : (k - 3 * q) / 2 ≤ R := by omega
    exact (Nat.add_le_add_right hR 2).trans (hU i)
  · intro i
    have hR : (k - 3 * q) / 2 ≤ R := by omega
    have hstep : 2 * ((k - 3 * q) / 2 + 1) + 1 ≤
        2 * (R + 1) + 1 := by omega
    exact hstep.trans (hθ i)
  · exact hnorep
  · exact hcycle

/-- Local-hub-family form of the forbidden near-third window.  Choose one
robust core in each disjoint greedy region, prune the canonical repeated
attachments, and apply the uniform even-route exclusion to the resulting
interaction graph. -/
theorem exists_core_data_with_no_near_third_pruned_interaction_cycle
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ q R k : ℕ}
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hq : 3 ≤ q) (hqk : 3 * q ≤ k) (hkq : k ≤ 3 * q + 2 * R)
    (hpar : (k - 3 * q) % 2 = 0)
    (hτ : R + 2 ≤ τ) (hθ : 2 * (R + 1) + 1 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      (∀ i j : F, i ≠ j →
        Disjoint (U i ∪ (i : Finset V)) (U j ∪ (j : Finset V))) ∧
      ¬ cycleGraph q ⊑ HubInteractionGraph G
        (fun i : F => U i \ RepeatedAttachmentFinset G U) := by
  obtain ⟨U, hU, hregions⟩ :=
    exists_core_data_of_disjoint_localRobustHub_family G hhub hdisj
  refine ⟨U, hU, hregions, ?_⟩
  apply not_cycleGraph_isContained_pruned_hubInteraction_of_near_third_window
    hq hqk hkq hpar G U (fun i : F => (i : Finset V))
      (fun _ : F => θ) (RepeatedAttachmentFinset G U)
      (fun i => (hU i).2.2) hregions
  · intro i
    exact hτ.trans (hU i).1
  · intro i
    exact hθ
  · exact no_repeated_attachment_outside_RepeatedAttachmentFinset G U
  · exact hcycle

/-- Every large target length forbids one near-third cycle length in the
pruned interaction graph, using only four vertices and threshold seven per
hub.  The near-third decomposition puts the residual even correction r ≤ 2
into the first hub and uses length-two routes in all remaining hubs. -/
theorem exists_forbidden_near_third_pruned_hubInteraction_cycle
    {V ι : Type*} [Fintype V] {k : ℕ}
    (hk : 12 ≤ k)
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (U T : ι → Finset V) (θ : ι → ℕ) (X : Finset V)
    (hrob : ∀ i, RobustPairSet G (U i) (T i) (θ i))
    (hregions : ∀ i j, i ≠ j →
      Disjoint (U i ∪ T i) (U j ∪ T j))
    (hU : ∀ i, 4 ≤ (U i).card)
    (hθ : ∀ i, 7 ≤ θ i)
    (hnorep : ∀ i j r : ι, i ≠ j → i ≠ r → j ≠ r →
      ∀ x ∈ U i, x ∉ X → ∀ y ∈ U j, ∀ z ∈ U r,
        G.Adj x y → G.Adj x z → False)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ q : ℕ, 3 ≤ q ∧
      ¬ cycleGraph q ⊑ HubInteractionGraph G (fun i => U i \ X) := by
  obtain ⟨q, r, hq, hr, hkqr⟩ := exists_near_third_decomposition hk
  refine ⟨q, hq, ?_⟩
  intro hcopy
  apply hcycle
  let m : ℕ := q - 1
  have hm : 2 ≤ m := by
    dsimp [m]
    omega
  have hmq : m + 1 = q := by
    dsimp [m]
    omega
  let route : Fin (m + 1) → ℕ := fun i => if i = 0 then r else 0
  have hsum : (∑ i : Fin (m + 1), 2 * (route i + 1)) =
      2 * (r + 1) + 2 * m := by
    rw [← Finset.sum_erase_add (Finset.univ : Finset (Fin (m + 1)))
      (fun i => 2 * (route i + 1))
      (show (0 : Fin (m + 1)) ∈ Finset.univ by simp)]
    have herase :
        ∑ i ∈ (Finset.univ : Finset (Fin (m + 1))).erase 0,
            2 * (route i + 1) =
          ∑ _i ∈ (Finset.univ : Finset (Fin (m + 1))).erase 0, 2 := by
      apply Finset.sum_congr rfl
      intro i hi
      have hi0 : i ≠ 0 := (Finset.mem_erase.mp hi).1
      simp [route, hi0]
    rw [herase]
    simp [route]
    omega
  apply cycleGraph_isContained_of_pruned_hubInteraction_cycle_even_routes
    hm (by omega) G U T θ X hrob hregions
      (by rw [hmq]; exact hcopy) hnorep route
  · intro i j
    by_cases hj : j = 0
    · subst j
      simp [route]
      exact (by have := hU i; omega)
    · simp [route, hj]
      exact (by have := hU i; omega)
  · intro i j
    by_cases hj : j = 0
    · subst j
      simp only [Order.add_one_le_iff]
      exact (by have := hθ i; omega)
    · simp only [Order.add_one_le_iff]
      exact (by have := hθ i; omega)
  · rw [hsum]
    dsimp [m]
    omega

/-- One explicit eventual threshold simultaneously supplies the concrete
binary-log room and square-root DRC hypotheses on the diagonal range.  The
chosen threshold is deliberately coarse: if A^2 ≤ n ≤ k, then A ≤ sqrt k. -/
theorem eventually_diagonal_bfs_room_and_sqrt_drc_threshold :
    ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ k ≥ n,
      64 ≤ k ∧
      2 * 64 ^ 13 ≤ Nat.sqrt k ∧
      3 * Nat.log 2 ((k - 1) * (n - 1) + 1) + 1 ≤ k := by
  let A : ℕ := 2 * 64 ^ 13
  refine ⟨A ^ 2, ?_⟩
  intro n hn k hnk
  have hAk : A ^ 2 ≤ k := hn.trans hnk
  have hAsqrt : A ≤ Nat.sqrt k := (Nat.le_sqrt').2 hAk
  have hk64 : 64 ≤ k := by
    have hA64 : 64 ≤ A := by norm_num [A]
    exact hA64.trans (hAsqrt.trans (Nat.sqrt_le_self k))
  exact ⟨hk64, by simpa [A] using hAsqrt,
    three_mul_log_extremal_order_add_one_le_of_64_le hk64 hnk⟩

/-- Uniform numerical estimates turn failure of a long path from x into a
local robust hub on a bounded support.  This is the exact handoff from the
short Pósa piece to the greedy hub machinery. -/
theorem exists_local_robustPairSet_of_no_long_path
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (x : V) {D θ t τ : ℕ} (hD : 0 < D) (hmin : 0 < G.minDegree)
    (hno : ¬ HasPathFromAtLeast G x D)
    (ht : 0 < t) (hτpos : 0 < τ) {η : ℝ} (hη : 0 < η)
    (hθ : ∀ S : Finset V, S.Nonempty → S.card ≤ D →
      (θ : ℝ) ≤ η *
        (((G.minDegree : ℝ) / D) ^ 2) ^ 2 * Fintype.card S)
    (hτ : ∀ S : Finset V, S.Nonempty → S.card ≤ D →
      (τ : ℝ) ^ 2 ≤
        (((((G.minDegree : ℝ) / D) ^ 2) ^ t) * Fintype.card S) ^ 2 / 2)
    (hsmall : ∀ S : Finset V, S.Nonempty → S.card ≤ D →
      2 * η ^ t < (1 : ℝ) / (Fintype.card S : ℝ) ^ 2) :
    ∃ S U : Finset V, S.Nonempty ∧ S.card ≤ D ∧
      τ ≤ U.card ∧ U ⊆ S ∧ RobustPairSet G U S θ := by
  obtain ⟨S, hS, hSle, hmass⟩ :=
    exists_short_dense_support_of_no_long_path G x D hno
  obtain ⟨U, hUcard, hUS, hrob⟩ :=
    exists_local_robustPairSet_of_short_dense_support G hS hmin hD hSle hmass
      ht hτpos hη (hθ S hS hSle) (hτ S hS hSle) (hsmall S hS hSle)
  exact ⟨S, U, hS, hSle, hUcard, hUS, hrob⟩

/-- Select one robust core from each peeled local-hub region and run the
canonical repeated-attachment plus forest cleanup.  The explicit bound on the
number of peeled regions discharges the new global acyclicity hypothesis, so
the resulting second exceptional set has linear rather than quadratic size. -/
theorem exists_linear_exceptional_anticomplete_cores_after_RepeatedAttachmentFinset_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 12 ≤ k)
    (hlarge : 3 * F.card + 3 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let R : Finset V := RepeatedAttachmentFinset G U
      ∃ X : Finset V, X.card ≤ 4 * F.card ∧
        PairwiseAnticomplete G
          ((Finset.univ : Finset F).image fun i => (U i \ R) \ X) := by
  classical
  let U : F → Finset V := fun i =>
    Classical.choose (hhub i.1 i.2)
  have hU : ∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
      RobustPairSet G (U i) (i : Finset V) θ := by
    intro i
    exact Classical.choose_spec (hhub i.1 i.2)
  refine ⟨U, hU, ?_⟩
  obtain ⟨X, hX, hanti⟩ :=
    exists_linear_exceptional_set_after_RepeatedAttachmentFinset_of_cycleFree_short_second_hub_family
      G U (fun i : F => (i : Finset V)) (fun _ : F => θ) hk
      (by simpa using hlarge)
      (fun i => (hU i).2.2) hfree
      (fun i => hτn.trans (hU i).1)
      (fun i => hτk.trans (hU i).1)
      (fun _ => hθ)
      (by
        intro i j hij
        have hval : (i : Finset V) ≠ (j : Finset V) := by
          intro h
          apply hij
          exact Subtype.ext h
        have hiUnion : U i ∪ (i : Finset V) = (i : Finset V) :=
          Finset.union_eq_right.mpr (hU i).2.1
        have hjUnion : U j ∪ (j : Finset V) = (j : Finset V) :=
          Finset.union_eq_right.mpr (hU j).2.1
        rw [hiUnion, hjUnion]
        exact hdisj i i.2 j j.2 hval)
      hcycle
  refine ⟨X, ?_, hanti⟩
  simpa using hX

/-- Survival/count form of the selected linear cleanup.  Once the canonical
first deletion and the four-per-hub second deletion fit below one robust
core, every twice-trimmed selected core remains nonempty; their anticomplete
family then has fewer than n members. -/
theorem exists_linear_exceptional_anticomplete_cores_with_card_lt_of_cycleFree_localRobustHub_family
    {V : Type*} [Fintype V] [Nonempty V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {F : Finset (Finset V)} {θ τ n k : ℕ} (hk : 12 ≤ k)
    (hlarge : 3 * F.card + 3 ≤ k)
    (hhub : ∀ H ∈ F, IsLocalRobustHub G θ τ H)
    (hdisj : DisjointFinsetFamily F)
    (hfree : G.IndepSetFree n)
    (hτn : n + 2 ≤ τ) (hτk : k - 4 ≤ τ) (hθ : k - 3 ≤ θ)
    (hcycle : ¬ cycleGraph k ⊑ G) :
    ∃ U : F → Finset V,
      (∀ i : F, τ ≤ (U i).card ∧ U i ⊆ (i : Finset V) ∧
        RobustPairSet G (U i) (i : Finset V) θ) ∧
      let R : Finset V := RepeatedAttachmentFinset G U
      ∃ X : Finset V, X.card ≤ 4 * F.card ∧
        PairwiseAnticomplete G
          ((Finset.univ : Finset F).image fun i => (U i \ R) \ X) ∧
        (R.card + 4 * F.card < τ →
          ((Finset.univ : Finset F).image fun i => (U i \ R) \ X).card < n) := by
  obtain ⟨U, hU, hcleanup⟩ :=
    exists_linear_exceptional_anticomplete_cores_after_RepeatedAttachmentFinset_of_cycleFree_localRobustHub_family
      G hk hlarge hhub hdisj hfree hτn hτk hθ hcycle
  refine ⟨U, hU, ?_⟩
  let R : Finset V := RepeatedAttachmentFinset G U
  obtain ⟨X, hX, hanti⟩ := hcleanup
  refine ⟨X, hX, hanti, ?_⟩
  intro hcharge
  change R.card + 4 * F.card < τ at hcharge
  let B : F → Finset V := fun i => (U i \ R) \ X
  have hne : ∀ i : F, (B i).Nonempty := by
    intro i
    have hretR : τ - R.card ≤ (U i \ R).card :=
      sub_le_card_sdiff_of_le_card_of_card_le (hU i).1 (E := R.card) le_rfl
    have hretX : (τ - R.card) - 4 * F.card ≤ (B i).card :=
      sub_le_card_sdiff_of_le_card_of_card_le hretR hX
    apply Finset.card_pos.mp
    have hpos : 0 < (τ - R.card) - 4 * F.card := by omega
    exact hpos.trans_le hretX
  have hBdisj : DisjointFinsetFamily
      ((Finset.univ : Finset F).image B) := by
    intro A hA C hC hAC
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    rcases Finset.mem_image.mp hC with ⟨j, _hj, rfl⟩
    have hij : i ≠ j := by
      intro h
      subst j
      exact hAC rfl
    have hval : (i : Finset V) ≠ (j : Finset V) := by
      intro h
      apply hij
      exact Subtype.ext h
    exact (hdisj i i.2 j j.2 hval).mono
      (Finset.sdiff_subset.trans (Finset.sdiff_subset.trans (hU i).2.1))
      (Finset.sdiff_subset.trans (Finset.sdiff_subset.trans (hU j).2.1))
  have hBne : ∀ A ∈ (Finset.univ : Finset F).image B, A.Nonempty := by
    intro A hA
    rcases Finset.mem_image.mp hA with ⟨i, _hi, rfl⟩
    exact hne i
  exact card_lt_of_nonempty_disjoint_pairwiseAnticomplete G hfree hBne hBdisj hanti

/-
/-- Concrete stability-to-dense-exclusion bridge.  The remaining KLS
stability theorem only has to produce finitely many near-dense anticomplete
blocks, a compatible leftover assignment, and a leftover smaller than one
block.  The checked extremal near-dense endpoint then gives a complete stable
partition, so the fixed-`k` dense counterexample branch is impossible. -/
theorem denseCounterexampleExcludedAt_of_small_leftover_near_dense_stability
    {k : ℕ} (hk : 4 ≤ k)
    (hstable : ∀ n : ℕ, 3 ≤ n → n ≤ k →
      ∀ G : SimpleGraph (Fin ((k - 1) * (n - 1) + 1)),
        k - 1 ≤ G.minDegree → G.IndepSetFree n →
        ¬ cycleGraph k ⊑ G →
        ∃ s : ℕ, ∃ B : Fin s → Finset (Fin ((k - 1) * (n - 1) + 1)),
          ∃ L : Finset (Fin ((k - 1) * (n - 1) + 1)),
          ∃ assign : L → Fin s,
            0 < s ∧
            (∀ j, (B j).Nonempty) ∧
            (∀ j ℓ, j ≠ ℓ → Disjoint (B j) (B ℓ)) ∧
            (∀ j ℓ, j ≠ ℓ → ∀ a ∈ B j, ∀ b ∈ B ℓ, ¬ G.Adj a b) ∧
            (∀ j, Disjoint (B j) L) ∧
            (∀ v, v ∈ L ∨ ∃ i, v ∈ B i) ∧
            (∀ v : L, ∀ j : Fin s, j ≠ assign v →
              ∀ b ∈ B j, ¬ G.Adj v.1 b) ∧
            (∀ j, (B j).card ≤ k - 1) ∧
            (∀ j, k ≤ 2 * (B j).card) ∧
            (∀ j, ∀ v : B j, k ≤ 2 * degreeIn G (B j) v) ∧
            L.card < k - 1) :
    DenseCounterexampleExcludedAt k := by
  apply denseCounterexampleExcludedAt_of_completeStablePartitions
  intro n hn hnk G hmin hfree hcycle
  obtain ⟨s, B, L, assign, hs, hBne, hBdisj, hBanti, hBL, hcover,
      hcompat, hBcard, hBlarge, hold, hLsmall⟩ :=
    hstable n hn hnk G hmin hfree hcycle
  letI : Nonempty (Fin s) := Fin.pos_iff_nonempty.mp hs
  apply completeStablePartition_of_extremal_small_leftover_near_dense_blocks
    G B L assign hk
  · simp
  · exact hfree
  · exact hBne
  · exact hBdisj
  · exact hBanti
  · exact hBL
  · exact hcover
  · exact hcompat
  · exact hBcard
  · exact hBlarge
  · exact hold
  · exact hLsmall
  · exact hcycle
-/

/-! ## Interface for the KLS upper theorem -/

/-- A source-faithful natural-log form of the upper-bound theorem of
Keevash--Long--Skokan.  Changing the logarithm base merely changes `C`. -/
def KeevashLongSkokanUpper : Prop :=
  ∃ C : ℝ, 1 ≤ C ∧
    ∀ n k : ℕ, 3 ≤ n →
      C * Real.log (n : ℝ) / Real.log (Real.log (n : ℝ)) ≤ (k : ℝ) →
      CycleCliqueRamseyProperty k n ((k - 1) * (n - 1) + 1)

/-- The KLS logarithmic threshold is eventually below the diagonal `k = n`. -/
theorem eventually_of_log_log_threshold
    (P : ℕ → ℕ → Prop) (C : ℝ) (hC : 1 ≤ C)
    (hKLS : ∀ n k : ℕ, 3 ≤ n →
      C * Real.log (n : ℝ) / Real.log (Real.log (n : ℝ)) ≤ (k : ℝ) →
      P n k) :
    ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ k ≥ n, P n k := by
  have hCpos : 0 < C := lt_of_lt_of_le zero_lt_one hC
  have hlog : ∀ᶠ n : ℕ in atTop,
      ‖Real.log (n : ℝ)‖ ≤ (1 / C) * ‖(n : ℝ)‖ :=
    (Real.isLittleO_log_id_atTop.comp_tendsto
      (tendsto_natCast_atTop_atTop (R := ℝ))).bound (one_div_pos.mpr hCpos)
  have hlog_nonneg : ∀ᶠ n : ℕ in atTop, 0 ≤ Real.log (n : ℝ) :=
    (tendsto_natCast_atTop_atTop (R := ℝ)).eventually
      (Real.tendsto_log_atTop.eventually (eventually_ge_atTop 0))
  have hloglog : ∀ᶠ n : ℕ in atTop, 1 ≤ Real.log (Real.log (n : ℝ)) :=
    (Real.tendsto_log_atTop.comp
      (Real.tendsto_log_atTop.comp
        (tendsto_natCast_atTop_atTop (R := ℝ)))).eventually
      (eventually_ge_atTop 1)
  have hlarge : ∀ᶠ n : ℕ in atTop, 3 ≤ n := eventually_ge_atTop 3
  have hmain : ∀ᶠ n : ℕ in atTop,
      3 ≤ n ∧
        C * Real.log (n : ℝ) / Real.log (Real.log (n : ℝ)) ≤ (n : ℝ) := by
    filter_upwards [hlog, hlog_nonneg, hloglog, hlarge] with n hn hln hll hn3
    constructor
    · exact hn3
    · have hnorm : ‖(n : ℝ)‖ = (n : ℝ) := by
        rw [Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg n)]
      have hnormlog : ‖Real.log (n : ℝ)‖ = Real.log (n : ℝ) := by
        rw [Real.norm_eq_abs, abs_of_nonneg hln]
      rw [hnorm, hnormlog] at hn
      have hClog : C * Real.log (n : ℝ) ≤ (n : ℝ) := by
        calc
          C * Real.log (n : ℝ) ≤ C * ((1 / C) * (n : ℝ)) :=
            mul_le_mul_of_nonneg_left hn hCpos.le
          _ = (n : ℝ) := by field_simp
      exact (div_le_self (mul_nonneg hCpos.le hln) hll).trans hClog
  rcases eventually_atTop.1 hmain with ⟨N₀, hN₀⟩
  refine ⟨N₀, ?_⟩
  intro n hn k hnk
  exact hKLS n k (hN₀ n hn).1 <|
    (hN₀ n hn).2.trans (by exact_mod_cast hnk)

/-- Once the KLS graph-theoretic upper bound is available, minimality and
the disjoint-clique construction give the exact Ramsey number. -/
theorem erdos551_eventually_of_kls_upper (hKLS : KeevashLongSkokanUpper) :
    ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → ∀ k : ℕ, n ≤ k →
      cycleCliqueRamseyNumber k n = (k - 1) * (n - 1) + 1 := by
  obtain ⟨C, hC, hKLS⟩ := hKLS
  obtain ⟨N₀, hN₀⟩ := eventually_of_log_log_threshold
    (fun n k ↦ CycleCliqueRamseyProperty k n ((k - 1) * (n - 1) + 1))
    C hC hKLS
  refine ⟨max 3 N₀, ?_⟩
  intro n hn k hnk
  have hn3 : 3 ≤ n := (le_max_left 3 N₀).trans hn
  have hnN₀ : N₀ ≤ n := (le_max_right 3 N₀).trans hn
  apply le_antisymm
  · exact cycleCliqueRamseyNumber_le_of_property (hN₀ n hnN₀ k hnk)
  · exact cycleCliqueRamsey_lower_bound k n (by omega) (by omega)

end Erdos551
