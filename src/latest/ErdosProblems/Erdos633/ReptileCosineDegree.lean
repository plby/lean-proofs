import ErdosProblems.Erdos633.ReptileSideField
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.FieldTheory.Minpoly.Finite

/-!
# Quadratic algebraic degree of nonsquare reptiling cosines

The field generated by a similarity scale whose square is natural has
dimension at most two over the rationals. The actual boundary matrix puts
all side ratios in that field, and the cosine rule puts all angle cosines
there as well. Rational-angle classification is a separate subsequent step.
-/

namespace Erdos633

open Polynomial

theorem isIntegral_of_sq_eq_nat (x : ℝ) (N : ℕ) (hx : x ^ 2 = N) :
    IsIntegral ℚ x := by
  refine ⟨X ^ 2 - C (N : ℚ), monic_X_pow_sub_C _ (by decide), ?_⟩
  change aeval x (X ^ 2 - C (N : ℚ)) = 0
  simpa only [map_sub, map_pow, aeval_X, aeval_C, eq_ratCast, Rat.cast_natCast,
    sub_eq_zero] using hx

theorem minpoly_natDegree_le_two_of_sq_eq_nat (x : ℝ) (N : ℕ) (hx : x ^ 2 = N) :
    (minpoly ℚ x).natDegree ≤ 2 := by
  have heval : aeval x (X ^ 2 - C (N : ℚ)) = 0 := by
    simp only [map_sub, map_pow, aeval_X, aeval_C, eq_ratCast, Rat.cast_natCast, hx, sub_self]
  have h := natDegree_le_natDegree
    (minpoly.min ℚ x (monic_X_pow_sub_C (N : ℚ) (by decide : 2 ≠ 0)) heval)
  simpa only [natDegree_X_pow_sub_C] using h

theorem adjoin_scale_finrank_le_two (x : ℝ) (N : ℕ) (hx : x ^ 2 = N) :
    Module.finrank ℚ (IntermediateField.adjoin ℚ ({x} : Set ℝ)) ≤ 2 := by
  rw [IntermediateField.adjoin.finrank (isIntegral_of_sq_eq_nat x N hx)]
  exact minpoly_natDegree_le_two_of_sq_eq_nat x N hx

theorem minpoly_natDegree_le_two_of_mem_scale_field (x y : ℝ) (N : ℕ)
    (hx : x ^ 2 = N) (hy : y ∈ IntermediateField.adjoin ℚ ({x} : Set ℝ)) :
    IsIntegral ℚ y ∧ (minpoly ℚ y).natDegree ≤ 2 := by
  let K := IntermediateField.adjoin ℚ ({x} : Set ℝ)
  let z : K := ⟨y, hy⟩
  let : FiniteDimensional ℚ K :=
    IntermediateField.adjoin.finiteDimensional (isIntegral_of_sq_eq_nat x N hx)
  have hz : IsIntegral ℚ z := IsIntegral.of_finite ℚ z
  have hmap : minpoly ℚ y = minpoly ℚ z :=
    minpoly.algebraMap_eq (algebraMap K ℝ).injective z
  refine ⟨?_, ?_⟩
  · exact hz.map (IsScalarTower.toAlgHom ℚ K ℝ)
  · rw [hmap]
    exact (minpoly.natDegree_le z).trans (adjoin_scale_finrank_le_two x N hx)

theorem Triangle.cos_angleA_eq_side_ratios (R : Triangle) :
    Real.cos R.angleA =
      ((R.sideLength 1 / R.sideLength 2) ^ 2 + 1 -
        (R.sideLength 0 / R.sideLength 2) ^ 2) / (2 * (R.sideLength 1 / R.sideLength 2)) := by
  have h := EuclideanGeometry.law_cos R.b R.a R.c
  have hcos : R.sideLength 0 ^ 2 = R.sideLength 1 ^ 2 + R.sideLength 2 ^ 2 -
      2 * R.sideLength 1 * R.sideLength 2 * Real.cos R.angleA := by
    simpa [Triangle.sideLength, Triangle.edgeStart, Triangle.edgeEnd,
      Triangle.angleA, pow_two, dist_comm, mul_comm, mul_left_comm, mul_assoc, add_comm] using h
  field_simp [ne_of_gt (R.sideLength_pos 1), ne_of_gt (R.sideLength_pos 2)]
  nlinarith only [hcos]

theorem Triangle.cos_angleA_mem_field (R : Triangle) (K : Subfield ℝ)
    (hside : ∀ i j : Fin 3, R.sideLength i / R.sideLength j ∈ K) :
    Real.cos R.angleA ∈ K := by
  rw [R.cos_angleA_eq_side_ratios]
  exact K.div_mem
    (K.sub_mem (K.add_mem (K.pow_mem (hside 1 2) 2) K.one_mem)
      (K.pow_mem (hside 0 2) 2))
    (K.mul_mem (natCast_mem K 2) (hside 1 2))

theorem Triangle.cos_cornerAngle_mem_field (R : Triangle) (K : Subfield ℝ)
    (hside : ∀ i j : Fin 3, R.sideLength i / R.sideLength j ∈ K) (k : Fin 3) :
    Real.cos (R.cornerAngle k) ∈ K := by
  let e : Equiv.Perm (Fin 3) := Equiv.swap k 0
  have hside' (i j : Fin 3) :
      (R.relabel e).sideLength i / (R.relabel e).sideLength j ∈ K := by
    rw [R.sideLength_relabel, R.sideLength_relabel]
    exact hside (e i) (e j)
  have h := (R.relabel e).cos_angleA_mem_field K hside'
  have hangle : (R.relabel e).angleA = R.cornerAngle k := by
    change (R.relabel e).cornerAngle 0 = R.cornerAngle k
    simpa only [e, Equiv.swap_apply_right] using R.cornerAngle_relabel e 0
  rwa [hangle] at h

theorem CongruentTiling.nonsquare_reptile_sides_in_scale_field
    {P R : Triangle} {N : ℕ} (T : CongruentTiling P R N)
    (hN : ¬ IsSquare N) (hperm : PermutedTriple P.cornerAngle R.cornerAngle) :
    ∃ x : ℝ, 0 < x ∧ x ^ 2 = N ∧ ∀ i j : Fin 3,
      R.sideLength i / R.sideLength j ∈ IntermediateField.adjoin ℚ ({x} : Set ℝ) := by
  obtain ⟨x, hx, hsq, D, hD⟩ := T.boundary_matrix_of_permuted_angles hperm
  refine ⟨x, hx, hsq, ?_⟩
  exact natural_matrix_nonsquare_ratios_mem_field
    (IntermediateField.adjoin ℚ ({x} : Set ℝ)).toSubfield D R.sideLength x N
    R.sideLength_pos hx (IntermediateField.mem_adjoin_simple_self ℚ x) hN hsq hD

theorem CongruentTiling.nonsquare_reptile_cosines_degree_le_two
    {P R : Triangle} {N : ℕ} (T : CongruentTiling P R N)
    (hN : ¬ IsSquare N) (hperm : PermutedTriple P.cornerAngle R.cornerAngle) :
    ∀ k : Fin 3, IsIntegral ℚ (Real.cos (R.cornerAngle k)) ∧
      (minpoly ℚ (Real.cos (R.cornerAngle k))).natDegree ≤ 2 := by
  obtain ⟨x, _, hsq, hside⟩ := T.nonsquare_reptile_sides_in_scale_field hN hperm
  intro k
  apply minpoly_natDegree_le_two_of_mem_scale_field x _ N hsq
  exact R.cos_cornerAngle_mem_field
    (IntermediateField.adjoin ℚ ({x} : Set ℝ)).toSubfield hside k

end Erdos633
