    _ = H.card * H.card * 24 := by simp [HostEdgeCode]

theorem card_pointDuplicateProfile_le (H : Hypergraph V) :
    Fintype.card (PointDuplicateProfile H) ≤ H.card * 6 := by
  calc
    Fintype.card (PointDuplicateProfile H) ≤
        Fintype.card (HostEdgeCode H × Fin 6) :=
      Fintype.card_le_of_injective _ (pointDuplicateProfileCode_injective H)
    _ = H.card * 6 := by simp [HostEdgeCode]

theorem card_internalResidualProfile_le (H : Hypergraph V) :
    Fintype.card (InternalResidualProfile H) ≤ H.card * 24 := by
  calc
    Fintype.card (InternalResidualProfile H) ≤
        Fintype.card (HostEdgeCode H × (Fin 4 × Fin 6)) :=
      Fintype.card_le_of_injective _ (internalResidualProfileCode_injective H)
    _ = H.card * 24 := by simp [HostEdgeCode]

theorem card_internalOriginalGainProfile_le (H : Hypergraph V) :
    Fintype.card (InternalOriginalGainProfile H) ≤
      H.card * H.card * 4 := by
  calc
    Fintype.card (InternalOriginalGainProfile H) ≤
        Fintype.card (HostEdgeCode H × (HostEdgeCode H × Fin 4)) :=
      Fintype.card_le_of_injective _
        (internalOriginalGainProfileCode_injective H)
    _ = H.card * H.card * 4 := by simp [HostEdgeCode]; ring

theorem card_combinedTestLocalProfileIndex_le
    (H : Hypergraph V) (C : ConflictSystem V) :
    Fintype.card (CombinedTestLocalProfileIndex H C io) ≤
      (vertexFinset H).card * 6 +
      Fintype.card io * H.card + Fintype.card io * 6 +
      H.card * H.card * 24 + H.card * 6 +
      H.card * 24 + H.card * H.card * 4 +
      H.card * H.card * 2 := by
  have hv := card_vertexDuplicateProfile_le H
  have ho := card_externalOriginalProfile_le (io := io) H
  have he := card_externalResidualProfile_le (io := io)
  have hr := card_legalCCRerootProfile_le H C
  have hp := card_pointDuplicateProfile_le H
  have hir := card_internalResidualProfile_le H
  have hio := card_internalOriginalGainProfile_le H
  have hc := card_internalCommonImmediateEvictorProfile_le H
  simp only [CombinedTestLocalProfileIndex, ExternalTestLocalProfileIndex,
    Fintype.card_sum]
  omega

/-! ## Exponential cardinality of all combined root coordinates -/

theorem host_card_real_le_exp_eight
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (H.card : ℝ) ≤ Real.exp (8 * Real.rpow d (eta ^ 3)) := by
  calc
    (H.card : ℝ) ≤ (((vertexFinset H).card : ℝ) ^ (8 : ℕ)) := by
      exact_mod_cast CFMNumericAggregation.host_card_le_vertex_pow_eight H hH
    _ ≤ (Real.exp (Real.rpow d (eta ^ 3))) ^ (8 : ℕ) := by
      exact pow_le_pow_left₀ (Nat.cast_nonneg _) hvertex 8
    _ = Real.exp (8 * Real.rpow d (eta ^ 3)) := by
      rw [← Real.exp_nat_mul]
      congr 1

theorem combinedTestLocalProfileIndex_card_le_exp_twenty_four
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3)))
    (htests : (Fintype.card io : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (Fintype.card (CombinedTestLocalProfileIndex H C io) : ℝ) ≤
      Real.exp (24 * Real.rpow d (eta ^ 3)) := by
  let x := Real.rpow d (eta ^ 3)
  have hx0 : 0 ≤ x := Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have hx32 : 32 ≤ x := by simpa [x] using S.stopExponentFloor
  have hhost : (H.card : ℝ) ≤ Real.exp (8 * x) := by
    simpa [x] using host_card_real_le_exp_eight S H hH hvertex
  have hvertex16 : ((vertexFinset H).card : ℝ) ≤ Real.exp (16 * x) :=
    hvertex.trans (Real.exp_le_exp.mpr (by nlinarith))
  have htests16 : (Fintype.card io : ℝ) ≤ Real.exp (16 * x) :=
    htests.trans (Real.exp_le_exp.mpr (by nlinarith))
  have hhost16 : (H.card : ℝ) ≤ Real.exp (16 * x) :=
    hhost.trans (Real.exp_le_exp.mpr (by nlinarith))
  have hhostSq : (H.card : ℝ) * H.card ≤ Real.exp (16 * x) := by
    calc
      (H.card : ℝ) * H.card ≤ Real.exp (8 * x) * Real.exp (8 * x) := by
        gcongr
      _ = Real.exp (16 * x) := by rw [← Real.exp_add]; congr 1 <;> ring
  have htestHost : (Fintype.card io : ℝ) * H.card ≤
      Real.exp (16 * x) := by
    calc
      (Fintype.card io : ℝ) * H.card ≤
          Real.exp x * Real.exp (8 * x) := by gcongr
      _ = Real.exp (9 * x) := by rw [← Real.exp_add]; congr 1 <;> ring
      _ ≤ Real.exp (16 * x) := Real.exp_le_exp.mpr (by nlinarith)
  have hraw : (Fintype.card (CombinedTestLocalProfileIndex H C io) : ℝ) ≤
      ((vertexFinset H).card : ℝ) * 6 +
      (Fintype.card io : ℝ) * H.card + (Fintype.card io : ℝ) * 6 +
      (H.card : ℝ) * H.card * 24 + (H.card : ℝ) * 6 +
      (H.card : ℝ) * 24 + (H.card : ℝ) * H.card * 4 +
      (H.card : ℝ) * H.card * 2 := by
    exact_mod_cast card_combinedTestLocalProfileIndex_le (io := io) H C
  have hprofile :
      (Fintype.card (CombinedTestLocalProfileIndex H C io) : ℝ) ≤
        73 * Real.exp (16 * x) := by
    calc
      _ ≤ ((vertexFinset H).card : ℝ) * 6 +
          (Fintype.card io : ℝ) * H.card + (Fintype.card io : ℝ) * 6 +
          (H.card : ℝ) * H.card * 24 + (H.card : ℝ) * 6 +
          (H.card : ℝ) * 24 + (H.card : ℝ) * H.card * 4 +
          (H.card : ℝ) * H.card * 2 := hraw
      _ ≤ 73 * Real.exp (16 * x) := by
        have hexp0 : 0 ≤ Real.exp (16 * x) := Real.exp_nonneg _
        nlinarith
  have hcoeff : (73 : ℝ) ≤ Real.exp (8 * x) := by
    calc
      (73 : ℝ) ≤ 1 + 8 * x := by nlinarith
      _ ≤ Real.exp (8 * x) := by
        simpa [add_comm] using Real.add_one_le_exp (8 * x)
  calc
    (Fintype.card (CombinedTestLocalProfileIndex H C io) : ℝ) ≤
        73 * Real.exp (16 * x) := hprofile
    _ ≤ Real.exp (8 * x) * Real.exp (16 * x) := by gcongr
    _ = Real.exp (24 * x) := by rw [← Real.exp_add]; congr 1 <;> ring
    _ = Real.exp (24 * Real.rpow d (eta ^ 3)) := by rfl

theorem combinedRootChoiceCode_card_le_exp_forty
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (((∑ r : Fin 5, H.card.choose r.1) * 6 : ℕ) : ℝ) ≤
      Real.exp (40 * Real.rpow d (eta ^ 3)) := by
  let x := Real.rpow d (eta ^ 3)
  have hx0 : 0 ≤ x := Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have hx32 : 32 ≤ x := by simpa [x] using S.stopExponentFloor
  have hhost : (H.card : ℝ) ≤ Real.exp (8 * x) := by
    simpa [x] using host_card_real_le_exp_eight S H hH hvertex
  have hchoose : ∀ r : Fin 5,
      (H.card.choose r.1 : ℝ) ≤ Real.exp (32 * x) := by
    intro r
    calc
      (H.card.choose r.1 : ℝ) ≤ ((H.card : ℝ) ^ r.1) := by
        exact_mod_cast Nat.choose_le_pow H.card r.1
      _ ≤ (Real.exp (8 * x)) ^ r.1 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hhost r.1
      _ = Real.exp ((r.1 : ℝ) * (8 * x)) := by
        simpa using (Real.exp_nat_mul (8 * x) r.1).symm
      _ ≤ Real.exp (32 * x) := by
        apply Real.exp_le_exp.mpr
        have hrNat : r.1 ≤ 4 := by omega
        have hr : (r.1 : ℝ) ≤ 4 := by exact_mod_cast hrNat
        nlinarith
  have hsum : ((∑ r : Fin 5, H.card.choose r.1 : ℕ) : ℝ) ≤
      5 * Real.exp (32 * x) := by
    rw [Nat.cast_sum]
    calc
      (∑ r : Fin 5, (H.card.choose r.1 : ℝ)) ≤
          ∑ _r : Fin 5, Real.exp (32 * x) := by
        exact Finset.sum_le_sum fun r _ ↦ hchoose r
      _ = 5 * Real.exp (32 * x) := by simp
  have hcoeff : (30 : ℝ) ≤ Real.exp (8 * x) := by
    calc
      (30 : ℝ) ≤ 1 + 8 * x := by nlinarith
      _ ≤ Real.exp (8 * x) := by
        simpa [add_comm] using Real.add_one_le_exp (8 * x)
  calc
    (((∑ r : Fin 5, H.card.choose r.1) * 6 : ℕ) : ℝ) =
        ((∑ r : Fin 5, H.card.choose r.1 : ℕ) : ℝ) * 6 := by norm_num
    _ ≤ (5 * Real.exp (32 * x)) * 6 := by gcongr
    _ = 30 * Real.exp (32 * x) := by ring
    _ ≤ Real.exp (8 * x) * Real.exp (32 * x) := by gcongr
    _ = Real.exp (40 * x) := by rw [← Real.exp_add]; congr 1 <;> ring
    _ = Real.exp (40 * Real.rpow d (eta ^ 3)) := by rfl

theorem combinedTestLocalRootCoordinate_card_le_exp_sixty_four
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (j : io → ℕ) (hj3 : ∀ a, j a ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3)))
    (htests : (Fintype.card io : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (Fintype.card (CombinedTestLocalRootCoordinate H C io j) : ℝ) ≤
      Real.exp (64 * Real.rpow d (eta ^ 3)) := by
  have hrank : ∀ b : CombinedTestLocalProfileIndex H C io,
      combinedTestLocalProfileActiveRank j b ≤ 5 := fun b ↦
    (combinedTestLocalProfileActiveRank_le_familyRank H C j b).trans
      (combinedTestLocalProfileFamilyRank_le_five H C j hj3 b)
  have hnat := card_finiteWeightedRootShadowCoordinate_le H
    (combinedTestLocalProfileActiveRank j)
    (combinedTestLocalProfileSeed (H := H) (C := C) (io := io)) hrank
  have hprofile := combinedTestLocalProfileIndex_card_le_exp_twenty_four
    S H C hH hvertex htests
  have hroot := combinedRootChoiceCode_card_le_exp_forty S H hH hvertex
  have hreal0 :
      (Fintype.card (CombinedTestLocalRootCoordinate H C io j) : ℝ) ≤
        (((Fintype.card (CombinedTestLocalProfileIndex H C io) *
          (∑ r : Fin 5, H.card.choose r.1)) * 6 : ℕ) : ℝ) := by
    exact_mod_cast hnat
  have hreal :
      (Fintype.card (CombinedTestLocalRootCoordinate H C io j) : ℝ) ≤
        (Fintype.card (CombinedTestLocalProfileIndex H C io) : ℝ) *
          (((∑ r : Fin 5, H.card.choose r.1) * 6 : ℕ) : ℝ) := by
    simpa [Nat.cast_mul, mul_assoc] using hreal0
  calc
    (Fintype.card (CombinedTestLocalRootCoordinate H C io j) : ℝ) ≤
        (Fintype.card (CombinedTestLocalProfileIndex H C io) : ℝ) *
          (((∑ r : Fin 5, H.card.choose r.1) * 6 : ℕ) : ℝ) := hreal
    _ ≤ Real.exp (24 * Real.rpow d (eta ^ 3)) *
          Real.exp (40 * Real.rpow d (eta ^ 3)) := by gcongr
    _ = Real.exp (64 * Real.rpow d (eta ^ 3)) := by
      rw [← Real.exp_add]
      congr 1
      ring

theorem combinedTestLocalRootTail_sum_le_twelfth
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (j : io → ℕ) (hj3 : ∀ a, j a ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3)))
    (htests : (Fintype.card io : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (∑ c : CombinedTestLocalRootCoordinate H C io j,
      finiteWeightedRootShadowStrongTail eta d) ≤ 1 / 12 := by
  exact finiteWeightedRootShadowEnhancedLocalTail_sum_le_twelfth
    (iota := io) (j := j) (H := H)
    (Profile := CombinedTestLocalProfileIndex H C io)
    (activeRank := combinedTestLocalProfileActiveRank j)
    (seed := combinedTestLocalProfileSeed
      (H := H) (C := C) (io := io))
    S (K := 64) (by norm_num)
    (combinedTestLocalRootCoordinate_card_le_exp_sixty_four
      S H C hH j hj3 hvertex htests)

/-! ## Supported retained duplicate coordinates -/

abbrev SupportedVertexDuplicateRootShadowCoordinate (H : Hypergraph V) :=
  {z : VertexDuplicateRootShadowCoordinate H // z.root ⊆ H}

def supportedVertexDuplicateToCombinedRootCoordinate
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (z : SupportedVertexDuplicateRootShadowCoordinate H) :
    CombinedTestLocalRootCoordinate H C io j :=
  vertexDuplicateToCombinedRootCoordinate H C j z.1 z.2

theorem supportedVertexDuplicateToCombinedRootCoordinate_injective
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ) :
    Function.Injective
      (supportedVertexDuplicateToCombinedRootCoordinate H C j) := by
  intro a b h
  have hp := congrArg (fun z ↦ z.profile) h
  have hr := congrArg (fun z ↦ z.root) h
  have hs := congrArg (fun z ↦ z.selected) h
  rcases a with ⟨⟨av, al, ar, ak, hk, hleg⟩, ahost⟩
  rcases b with ⟨⟨bv, bl, br, bk, hk', hleg'⟩, bhost⟩
  simp only [supportedVertexDuplicateToCombinedRootCoordinate,
    vertexDuplicateToCombinedRootCoordinate,
    externalRootCoordinateToCombined,
    vertexDuplicateToExternalRootCoordinate,
    vertexDuplicateLocalProfile, Sum.inl.injEq] at hp hr hs
  have hv := congrArg (fun z : VertexDuplicateProfile H ↦ z.vertex) hp
  have hl := congrArg (fun z : VertexDuplicateProfile H ↦ z.layer) hp
  change av = bv at hv
  have hl' : al = bl := by
    apply Fin.ext
    exact congrArg Fin.val hl
  cases hv
  cases hl'
  cases hr
  cases hs
  rfl

theorem card_supportedVertexDuplicate_le_combinedRoot
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ) :
    Fintype.card (SupportedVertexDuplicateRootShadowCoordinate H) ≤
      Fintype.card (CombinedTestLocalRootCoordinate H C io j) :=
  Fintype.card_le_of_injective _
    (supportedVertexDuplicateToCombinedRootCoordinate_injective H C j)

noncomputable def supportedVertexDuplicateTail
    (H : Hypergraph V) (eta d : ℝ) :
    VertexDuplicateRootShadowCoordinate H → ℝ :=
  fun z ↦ if z.root ⊆ H then finiteWeightedRootShadowStrongTail eta d else 0

theorem supportedVertexDuplicateTail_sum_eq_subtype
    (H : Hypergraph V) (eta d : ℝ) :
    (∑ z : VertexDuplicateRootShadowCoordinate H,
      supportedVertexDuplicateTail H eta d z) =
    ∑ _z : SupportedVertexDuplicateRootShadowCoordinate H,
      finiteWeightedRootShadowStrongTail eta d := by
  classical
  have hsplit := Fintype.sum_subtype_add_sum_subtype
    (fun z : VertexDuplicateRootShadowCoordinate H ↦ z.root ⊆ H)
    (supportedVertexDuplicateTail H eta d)
  calc
    (∑ z : VertexDuplicateRootShadowCoordinate H,
        supportedVertexDuplicateTail H eta d z) =
        (∑ z : SupportedVertexDuplicateRootShadowCoordinate H,
          supportedVertexDuplicateTail H eta d z.1) +
        (∑ z : {z : VertexDuplicateRootShadowCoordinate H // ¬z.root ⊆ H},
          supportedVertexDuplicateTail H eta d z.1) := hsplit.symm
    _ = ∑ _z : SupportedVertexDuplicateRootShadowCoordinate H,
        finiteWeightedRootShadowStrongTail eta d := by
      have hyes :
          (∑ z : SupportedVertexDuplicateRootShadowCoordinate H,
            supportedVertexDuplicateTail H eta d z.1) =
          ∑ _z : SupportedVertexDuplicateRootShadowCoordinate H,
            finiteWeightedRootShadowStrongTail eta d := by
        apply Finset.sum_congr rfl
        intro z _hz
        simp [supportedVertexDuplicateTail, z.2]
      have hno :
          (∑ z : {z : VertexDuplicateRootShadowCoordinate H // ¬z.root ⊆ H},
            supportedVertexDuplicateTail H eta d z.1) = 0 := by
        apply Finset.sum_eq_zero
        intro z _hz
        simp [supportedVertexDuplicateTail, z.2]
      rw [hyes, hno, add_zero]

theorem supportedVertexDuplicateTail_sum_le_twelfth
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (j : io → ℕ) (hj3 : ∀ a, j a ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3)))
    (htests : (Fintype.card io : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (∑ z : VertexDuplicateRootShadowCoordinate H,
      supportedVertexDuplicateTail H eta d z) ≤ 1 / 12 := by
  rw [supportedVertexDuplicateTail_sum_eq_subtype]
  apply finiteWeightedRootShadowStrongTailFamilySum_le_twelfth S
    (fun _z : SupportedVertexDuplicateRootShadowCoordinate H ↦
      finiteWeightedRootShadowStrongTail eta d) (K := 64) (by norm_num)
  · have hcard :
        (Fintype.card (SupportedVertexDuplicateRootShadowCoordinate H) : ℝ) ≤
          (Fintype.card (CombinedTestLocalRootCoordinate H C io j) : ℝ) := by
      exact_mod_cast card_supportedVertexDuplicate_le_combinedRoot
        (io := io) H C j
    exact hcard.trans
      (combinedTestLocalRootCoordinate_card_le_exp_sixty_four
        S H C hH j hj3 hvertex htests)
  · intro z
    exact le_rfl

/-! ## Explicit flattening of the final local index and its budget -/

abbrev FinalCombinedLocalIndex
    (H : Hypergraph V) (C : ConflictSystem V) (io : Type*) (j : io → ℕ) :=
  Sum (VertexLocalThroughSpreadLocalCoordinate H)
    (Sum (VertexDuplicateRootShadowCoordinate H)
      (Sum (CombinedTestLocalRootCoordinate H C io j)
        TestReachabilityInvariantIndex))

def finalCombinedLocalCoordinateToFinal
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ) :
    FinalCombinedLocalIndex H C io j →
      FinalReachableTestEnhancedIndex H C io j
  | Sum.inl a => Sum.inl (Sum.inl (Sum.inl (Sum.inr a)))
  | Sum.inr (Sum.inl z) => Sum.inl (Sum.inl (Sum.inr z))
  | Sum.inr (Sum.inr (Sum.inl c)) => Sum.inl (Sum.inr c)
  | Sum.inr (Sum.inr (Sum.inr a)) => Sum.inr a

noncomputable def finalCombinedLocalTail
    (H : Hypergraph V) (eta d : ℝ) :
    FinalCombinedLocalIndex H C io j → ℝ
  | Sum.inl a => vertexLocalThroughSpreadEnhancedLocalTail eta d a
  | Sum.inr (Sum.inl z) => supportedVertexDuplicateTail H eta d z
  | Sum.inr (Sum.inr (Sum.inl _c)) => finiteWeightedRootShadowStrongTail eta d
  | Sum.inr (Sum.inr (Sum.inr _a)) => 0

theorem finalCombinedLocalTail_sum_le_quarter
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (j : io → ℕ) (hj3 : ∀ a, j a ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3)))
    (htests : (Fintype.card io : ℝ) ≤
      Real.exp (Real.rpow d (eta ^ 3))) :
    (∑ a : FinalCombinedLocalIndex H C io j,
      finalCombinedLocalTail (C := C) (io := io) (j := j) H eta d a) ≤
        1 / 4 := by
  have hv := vertexLocalThroughSpreadEnhancedLocalTail_sum_le_twelfth
    S H hH hvertex
  have hd := supportedVertexDuplicateTail_sum_le_twelfth
    S H C hH j hj3 hvertex htests
  have hc := combinedTestLocalRootTail_sum_le_twelfth
    S H C hH j hj3 hvertex htests
  simp only [VertexLocalThroughSpreadLocalCoordinate,
    Fintype.sum_sum_type] at hv
  simp only [FinalCombinedLocalIndex, Fintype.sum_sum_type,
    finalCombinedLocalTail]
  simp only [Finset.sum_const_zero, add_zero]
  norm_num at hv hd hc ⊢
  linarith

/-! ## The two explicit reachability coordinates have zero mass -/

theorem finalReachableMatchingFirstFailureEvent_eq_empty
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    greedyFirstFailureEvent H R.regularized ∅ T
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R)
      (Sum.inr TestReachabilityInvariantIndex.matching) = ∅ := by
  apply Finset.not_nonempty_iff_eq_empty.mp
  rintro ⟨omega, homega⟩
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_homegaUniv, k, _hk, _hprefix, hfail⟩ := homega
  apply hfail
  change IsConflictFreeMatching H R.regularized
    (greedyStateFromAt H R.regularized ∅ omega (k + 1))
  rw [← greedyStateAt_eq_stateFrom_empty]
  have hCempty : ∅ ∉ R.regularized := by
    intro hempty
    have hmin := (R.bounded.1 ∅ hempty).1
    simpa using hmin
  exact greedyStateAt_isConflictFreeMatching
    H R.regularized hCempty omega (k + 1)

theorem timeCardFirstFailureMass_eq_zero_of_available
    {I : Type*} [Fintype I]
    (H : Hypergraph V) (C : ConflictSystem V) (hCempty : ∅ ∉ C) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop) (i : I)
    (hcomponent : ∀ k M, P i k M ↔ M.card = k)
    (havailable : ∀ k, k < T → ∀ M, indexedGreedyGood P k M →
      IsConflictFreeMatching H C M → M.card = k →
      (availableEdges H C M).Nonempty) :
    Freedman.eventMass (normalizedGreedyPathMass H C)
      (greedyFirstFailureEvent H C ∅ T P i) = 0 := by
  unfold Freedman.eventMass
  apply Finset.sum_eq_zero
  intro omega homega
  have hnonneg : 0 ≤ normalizedGreedyPathMass H C omega :=
    normalizedGreedyPathMass_nonneg H C omega
  apply le_antisymm ?_ hnonneg
  by_contra hnot
  have hmass : 0 < normalizedGreedyPathMass H C omega := lt_of_not_ge hnot
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_homegaUniv, k, hk, hprefix, hfail⟩ := homega
  have hcard := card_greedyStateFromAt_empty_eq_time_of_good_available
    H C hCempty (indexedGreedyGood P) omega hmass havailable
      k (Nat.le_of_lt hk) hprefix
  have hstate : IsConflictFreeMatching H C
      (greedyStateFromAt H C ∅ omega k) := by
    rw [← greedyStateAt_eq_stateFrom_empty]
    exact greedyStateAt_isConflictFreeMatching H C hCempty omega k
  have hA := havailable k hk (greedyStateFromAt H C ∅ omega k)
    (hprefix k le_rfl) hstate hcard
  have hmassStep := greedyTransitionMass_pos_of_pathMassFrom_pos
    H C ∅ omega hmass hk
  have hstep := greedyChoiceStep_card_eq_add_one_of_mass_pos
    H C (greedyStateFromAt H C ∅ omega k)
      (greedyChoiceAt omega k) hA hmassStep
  have hnext : (greedyStateFromAt H C ∅ omega (k + 1)).card = k + 1 := by
    rw [greedyStateFromAt_succ, hstep, hcard]
  exact hfail ((hcomponent (k + 1)
    (greedyStateFromAt H C ∅ omega (k + 1))).mpr hnext)

theorem finalReachableLiteral_availableEdges_nonempty
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * (2 * (ell : ℝ) + 1)) d)
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ)) :
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let GammaCore : ℝ := 6 * (2 * (ell : ℝ) + 1)
    let N := (vertexFinset H).card
    let T := CFMNumericAggregation.targetTime eta d N
    ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (finalReachableTestEnhancedPredicate H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta N T j w R) k M →
      IsConflictFreeMatching H R.regularized M → M.card = k →
      (availableEdges H R.regularized M).Nonempty := by
  dsimp only
  intro k hk M hgood _hmatching _hcard
  have hfloor := localSpreadAvailableFloor_of_degreeEnhancedProjection
    S H C hinst.1
    (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    j w R
    (finalReachableTestEnhancedPredicate H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell
      (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (6 * (2 * (ell : ℝ) + 1)) eta (vertexFinset H).card
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card) j w R)
    (fun k M hgood ↦ finalReachableGood_degree H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell
      (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (6 * (2 * (ell : ℝ) + 1)) eta (vertexFinset H).card
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
      j w R hgood)
    (fun k hk _M _hdegree ↦ certificateLiteralDeltaStepRegistry
      H C d eta ell j w hinst R (vertexFinset H).card E S hN k hk)
    hk M hgood
  have hdpos : 0 < d := by linarith [S.degreeAtLeastTwo]
  have hNpos : 0 < ((vertexFinset H).card : ℝ) := by
    have hrpowPos : 0 < Real.rpow d eta := Real.rpow_pos_of_pos hdpos eta
    exact (div_pos hrpowPos (by norm_num)).trans_le hN
  have hfloorPos : 0 < localSpreadAvailableFloor eta d
      ((vertexFinset H).card : ℝ) := by
    rw [localSpreadAvailableFloor_eq_rpow hdpos]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hdpos _)) (by norm_num)
  have hcardPos : 0 < ((availableEdges H R.regularized M).card : ℝ) :=
    hfloorPos.trans_le hfloor
  exact Finset.card_pos.mp (by exact_mod_cast hcardPos)

theorem finalReachableTimeCardFirstFailureMass_eq_zero
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * (2 * (ell : ℝ) + 1)) d)
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ)) :
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let GammaCore : ℝ := 6 * (2 * (ell : ℝ) + 1)
    let N := (vertexFinset H).card
    let T := CFMNumericAggregation.targetTime eta d N
    Freedman.eventMass (normalizedGreedyPathMass H R.regularized)
      (greedyFirstFailureEvent H R.regularized ∅ T
        (finalReachableTestEnhancedPredicate H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta N T j w R)
        (Sum.inr TestReachabilityInvariantIndex.timeCard)) = 0 := by
  dsimp only
  have hCempty : ∅ ∉ R.regularized := by
    intro hempty
    have hmin := (R.bounded.1 ∅ hempty).1
    simpa using hmin
  apply timeCardFirstFailureMass_eq_zero_of_available
    H R.regularized hCempty
    (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
    (finalReachableTestEnhancedPredicate H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell
      (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (6 * (2 * (ell : ℝ) + 1)) eta (vertexFinset H).card
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card) j w R)
    (Sum.inr TestReachabilityInvariantIndex.timeCard)
  · intro k M
    rfl
  · exact finalReachableLiteral_availableEdges_nonempty
      H C d eta ell j w hinst R E S hN

end

/-! ## Integrated: PersistentInternalConflictLinkCore -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! ## Next-active internal conflict-link increments

The paper freezes an internal link coordinate on precisely those choices
which delete its distinguished edge.  The definitions below make this
next-state survival indicator explicit.  In particular, the deterministic
trajectory increment is multiplied by the same indicator as the raw
observable increment. -/

/-- Indicator of the event that the distinguished internal-link edge is
still available in the next state. -/
def persistentInternalConflictLinkIndicator
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (M' : Hypergraph V) : ℝ :=
  if f ∈ availableEdges H C M' then 1 else 0

/-- Exact one-step probability of retaining the distinguished edge. -/
noncomputable def persistentInternalConflictLinkProbability
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (M : Hypergraph V) : ℝ :=
  greedyStepExpectation H C M
    (persistentInternalConflictLinkIndicator H C f)

/-- The currently available choices which retain `f` after insertion. -/
def persistentInternalConflictLinkChoices
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) : Hypergraph V :=
  (availableEdges H C M).filter fun e ↦
    f ∈ availableEdges H C (insert e M)

/-- The currently available choices which delete `f` after insertion. -/
def killedInternalConflictLinkChoices
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) : Hypergraph V :=
  (availableEdges H C M).filter fun e ↦
    f ∉ availableEdges H C (insert e M)

theorem persistentInternalConflictLinkChoices_eq_sdiff_blockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    persistentInternalConflictLinkChoices H C M f =
      availableEdges H C M \ availableBlockerChoices H C M f := by
  ext e
  simp only [persistentInternalConflictLinkChoices, Finset.mem_filter,
    Finset.mem_sdiff]
  constructor
  · rintro ⟨he, hfnext⟩
    refine ⟨he, ?_⟩
    rw [availableEdges_insert_eq_sdiff_blockers] at hfnext
    exact fun hef ↦ (Finset.mem_sdiff.mp hfnext).2
      ((mem_availableBlockerChoices_comm H C M he hf).mpr hef)
  · rintro ⟨he, hef⟩
    refine ⟨he, ?_⟩
    rw [availableEdges_insert_eq_sdiff_blockers]
    exact Finset.mem_sdiff.mpr ⟨hf, fun hfe ↦ hef
      ((mem_availableBlockerChoices_comm H C M he hf).mp hfe)⟩

theorem killedInternalConflictLinkChoices_eq_blockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    killedInternalConflictLinkChoices H C M f =
      availableBlockerChoices H C M f := by
  ext e
  simp only [killedInternalConflictLinkChoices, Finset.mem_filter]
  constructor
  · rintro ⟨he, hfnext⟩
    have hfe : f ∈ availableBlockerChoices H C M e := by
      rw [availableEdges_insert_eq_sdiff_blockers] at hfnext
      simpa only [Finset.mem_sdiff, hf, true_and, not_not] using hfnext
    exact (mem_availableBlockerChoices_comm H C M he hf).mp hfe
  · intro hef
    have he : e ∈ availableEdges H C M :=
      (Finset.mem_filter.mp hef).1
    refine ⟨he, ?_⟩
    rw [availableEdges_insert_eq_sdiff_blockers]
    intro hfnext
    exact (Finset.mem_sdiff.mp hfnext).2
      ((mem_availableBlockerChoices_comm H C M he hf).mpr hef)

/-- Exact status formula: survival is one minus the blocker proportion. -/
theorem persistentInternalConflictLinkProbability_eq_one_sub_blockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    persistentInternalConflictLinkProbability H C f M =
      1 - ((availableBlockerChoices H C M f).card : ℝ) /
        ((availableEdges H C M).card : ℝ) := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  rw [persistentInternalConflictLinkProbability,
    greedyStepExpectation_eq_average H C M _ hA]
  let A := availableEdges H C M
  let B := availableBlockerChoices H C M f
  have hBsub : B ⊆ A := by
    intro e he
    exact (Finset.mem_filter.mp he).1
  have hcard : (A.card : ℝ) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr hA
  have hsum :
      ∑ e ∈ A,
          persistentInternalConflictLinkIndicator H C f (insert e M) =
        ((A \ B).card : ℝ) := by
    rw [← persistentInternalConflictLinkChoices_eq_sdiff_blockers
      H C M hf]
    simp only [persistentInternalConflictLinkChoices, Finset.card_filter,
      Nat.cast_sum]
    apply Finset.sum_congr rfl
    intro e he
    by_cases hfnext : f ∈ availableEdges H C (insert e M) <;>
      simp [persistentInternalConflictLinkIndicator, hfnext]
  rw [hsum]
  have hcardSplit : ((A \ B).card : ℝ) = (A.card : ℝ) - (B.card : ℝ) := by
    rw [Finset.card_sdiff_of_subset hBsub, Nat.cast_sub
      (Finset.card_le_card hBsub)]
  rw [hcardSplit]
  field_simp
  ring

theorem persistentInternalConflictLinkProbability_nonneg
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (M : Hypergraph V) :
    0 ≤ persistentInternalConflictLinkProbability H C f M := by
  apply greedyStepExpectation_nonneg
  intro M'
  by_cases hf : f ∈ availableEdges H C M' <;>
    simp [persistentInternalConflictLinkIndicator, hf]

/-- Any ordinary blocker-status corridor immediately becomes the exact
survival-probability window. -/
theorem persistentInternalConflictLinkProbability_bounds_of_blockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    {statusLo statusHi : ℝ}
    (hlo : statusLo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hhi : ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi) :
    1 - statusHi / ((availableEdges H C M).card : ℝ) ≤
        persistentInternalConflictLinkProbability H C f M ∧
      persistentInternalConflictLinkProbability H C f M ≤
        1 - statusLo / ((availableEdges H C M).card : ℝ) := by
  rw [persistentInternalConflictLinkProbability_eq_one_sub_blockers
    H C M hf]
  have hden : 0 < ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr ⟨f, hf⟩
  constructor
  · linarith [div_le_div_of_nonneg_right hhi hden.le]
  · linarith [div_le_div_of_nonneg_right hlo hden.le]

/-- Gain averaged only over choices on which `f` survives. -/
noncomputable def meanPersistentPartialTestGain
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ persistentInternalConflictLinkChoices H C M f,
      partialTestStepGain w H C j s M e) / (A.card : ℝ)

/-- Loss averaged only over choices on which `f` survives. -/
noncomputable def meanPersistentPartialTestLoss
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ persistentInternalConflictLinkChoices H C M f,
      partialTestStepLoss w H C j s M e) / (A.card : ℝ)

/-- Gain discarded because the same choice deletes `f`. -/
noncomputable def meanKilledPartialTestGain
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ killedInternalConflictLinkChoices H C M f,
      partialTestStepGain w H C j s M e) / (A.card : ℝ)

/-- Loss discarded because the same choice deletes `f`. -/
noncomputable def meanKilledPartialTestLoss
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ killedInternalConflictLinkChoices H C M f,
      partialTestStepLoss w H C j s M e) / (A.card : ℝ)

/-- Raw observable increment frozen when `f` is deleted. -/
noncomputable def persistentInternalConflictLinkIncrement
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (j s : ℕ) (M M' : Hypergraph V) : ℝ :=
  if f ∈ availableEdges H C M' then
    ((partialFamily (conflictLinkLayer C f j)
        (availableEdges H C M') M' s).card : ℝ) -
      ((partialFamily (conflictLinkLayer C f j)
        (availableEdges H C M) M s).card : ℝ)
  else 0

theorem greedyStepExpectation_persistentInternalConflictLinkIncrement
    {H : Hypergraph V} {C : ConflictSystem V} (hC : IsConflictSystem H C)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    greedyStepExpectation H C M
        (persistentInternalConflictLinkIncrement H C f j s M) =
      meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
          H C f j s M -
        meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
          H C f j s M := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  rw [greedyStepExpectation_eq_average H C M _ hA]
  simp only [meanPersistentPartialTestGain,
    meanPersistentPartialTestLoss,
    Finset.nonempty_iff_ne_empty.mp hA, if_false]
  rw [← sub_div, ← Finset.sum_sub_distrib]
  apply congrArg (fun z : ℝ ↦ z / ((availableEdges H C M).card : ℝ))
  rw [persistentInternalConflictLinkChoices, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro e he
  by_cases hfnext : f ∈ availableEdges H C (insert e M)
  · simp only [hfnext, if_true]
    rw [persistentInternalConflictLinkIncrement, if_pos hfnext,
      ← partialTestObservable_conflictLinkTestWeight hC f j s,
      ← partialTestObservable_conflictLinkTestWeight hC f j s,
      partialTestObservable_insert_sub_eq_gain_sub_loss]
  · simp [persistentInternalConflictLinkIncrement, hfnext]

theorem meanPersistent_add_killed_gain
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    meanPersistentPartialTestGain w H C f j s M +
        meanKilledPartialTestGain w H C f j s M =
      meanPartialTestGain w H C j s M := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  simp only [meanPersistentPartialTestGain, meanKilledPartialTestGain,
    meanPartialTestGain, Finset.nonempty_iff_ne_empty.mp hA, if_false]
  rw [← add_div, ← Finset.sum_union]
  · congr 2
    ext e
    simp only [persistentInternalConflictLinkChoices,
      killedInternalConflictLinkChoices, Finset.mem_union, Finset.mem_filter]
    tauto
  · exact Finset.disjoint_left.mpr fun e hep hek ↦
      (Finset.mem_filter.mp hek).2 (Finset.mem_filter.mp hep).2

theorem meanPersistent_add_killed_loss
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    meanPersistentPartialTestLoss w H C f j s M +
        meanKilledPartialTestLoss w H C f j s M =
      meanPartialTestLoss w H C j s M := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  simp only [meanPersistentPartialTestLoss, meanKilledPartialTestLoss,
    meanPartialTestLoss, Finset.nonempty_iff_ne_empty.mp hA, if_false]
  rw [← add_div, ← Finset.sum_union]
  · congr 2
    ext e
    simp only [persistentInternalConflictLinkChoices,
      killedInternalConflictLinkChoices, Finset.mem_union, Finset.mem_filter]
    tauto
  · exact Finset.disjoint_left.mpr fun e hep hek ↦
      (Finset.mem_filter.mp hek).2 (Finset.mem_filter.mp hep).2

theorem meanKilledPartialTestGain_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V)
    (hw : ∀ S, 0 ≤ w S) :
    0 ≤ meanKilledPartialTestGain w H C f j s M := by
  simp only [meanKilledPartialTestGain]
  by_cases hA : availableEdges H C M = ∅
  · simp [hA]
  · simp only [hA, if_false]
    exact div_nonneg
      (Finset.sum_nonneg fun e _ ↦
        partialTestStepGain_nonneg w H C M j s e hw)
      (Nat.cast_nonneg _)

theorem meanKilledPartialTestLoss_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V)
    (hw : ∀ S, 0 ≤ w S) :
    0 ≤ meanKilledPartialTestLoss w H C f j s M := by
  simp only [meanKilledPartialTestLoss]
  by_cases hA : availableEdges H C M = ∅
  · simp [hA]
  · simp only [hA, if_false]
    exact div_nonneg
      (Finset.sum_nonneg fun e _ ↦
        partialTestStepLoss_nonneg w H C M j s e hw)
      (Nat.cast_nonneg _)

/-- A pointwise cap on choices which delete `f` converts exactly into the
blocker-probability correction used by the persistent mean window. -/
theorem meanKilledPartialTestGain_le_blockerRatio_mul
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) {cap : ℝ}
    (hcap0 : 0 ≤ cap)
    (hcap : ∀ e ∈ availableBlockerChoices H C M f,
      partialTestStepGain w H C j s M e ≤ cap) :
    meanKilledPartialTestGain w H C f j s M ≤
      ((availableBlockerChoices H C M f).card : ℝ) /
        ((availableEdges H C M).card : ℝ) * cap := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp hA
  simp only [meanKilledPartialTestGain, hAne, if_false,
    killedInternalConflictLinkChoices_eq_blockers H C M hf]
  have hsum :
      ∑ e ∈ availableBlockerChoices H C M f,
          partialTestStepGain w H C j s M e ≤
        ∑ _e ∈ availableBlockerChoices H C M f, cap :=
    Finset.sum_le_sum fun e he ↦ hcap e he
  rw [Finset.sum_const, nsmul_eq_mul] at hsum
  have hden : 0 ≤ ((availableEdges H C M).card : ℝ) := by positivity
  calc
    _ ≤ (((availableBlockerChoices H C M f).card : ℝ) * cap) /
        ((availableEdges H C M).card : ℝ) :=
      div_le_div_of_nonneg_right hsum hden
    _ = _ := by ring

theorem meanKilledPartialTestLoss_le_blockerRatio_mul
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) {cap : ℝ}
    (hcap0 : 0 ≤ cap)
    (hcap : ∀ e ∈ availableBlockerChoices H C M f,
      partialTestStepLoss w H C j s M e ≤ cap) :
    meanKilledPartialTestLoss w H C f j s M ≤
      ((availableBlockerChoices H C M f).card : ℝ) /
        ((availableEdges H C M).card : ℝ) * cap := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp hA
  simp only [meanKilledPartialTestLoss, hAne, if_false,
    killedInternalConflictLinkChoices_eq_blockers H C M hf]
  have hsum :
      ∑ e ∈ availableBlockerChoices H C M f,
          partialTestStepLoss w H C j s M e ≤
        ∑ _e ∈ availableBlockerChoices H C M f, cap :=
    Finset.sum_le_sum fun e he ↦ hcap e he
  rw [Finset.sum_const, nsmul_eq_mul] at hsum
  have hden : 0 ≤ ((availableEdges H C M).card : ℝ) := by positivity
  calc
    _ ≤ (((availableBlockerChoices H C M f).card : ℝ) * cap) /
        ((availableEdges H C M).card : ℝ) :=
      div_le_div_of_nonneg_right hsum hden
    _ = _ := by ring

/-- Transfer a full mean window to its next-active restriction.  Only
killed gains hurt the lower endpoint and only killed losses hurt the upper
endpoint. -/
theorem persistentPartialTest_meanWindow_of_full
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ)
    (hw : ∀ S, 0 ≤ w S) {lo hi gainError lossError : ℝ}
    (hfull : lo ≤ meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M ∧
        meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M ≤ hi)
    (hgain : meanKilledPartialTestGain w H C f j s M ≤ gainError)
    (hloss : meanKilledPartialTestLoss w H C f j s M ≤ lossError) :
    lo - gainError ≤
        meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ≤
        hi + lossError := by
  have hg0 := meanKilledPartialTestGain_nonneg w H C f j s M hw
  have hl0 := meanKilledPartialTestLoss_nonneg w H C f j s M hw
  have hgainEq := meanPersistent_add_killed_gain w H C M hf j s
  have hlossEq := meanPersistent_add_killed_loss w H C M hf j s
  constructor <;> linarith

/-- Upper envelope increment frozen on deletion of the distinguished edge. -/
noncomputable def persistentInternalConflictLinkUpperStep
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  if f ∈ availableEdges H C M' then
    (((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M') M' s).card : ℝ) -
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1))) -
      (((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ) -
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x))
  else 0

/-- Lower envelope increment frozen on deletion of the distinguished edge. -/
noncomputable def persistentInternalConflictLinkLowerStep
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  if f ∈ availableEdges H C M' then
    (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M') M' s).card : ℝ)) -
      (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x) -
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ))
  else 0

/-- Exact conditional expectations of the two persistent envelopes.  Both
the raw increment and the deterministic trajectory increment carry the
same next-active probability. -/
theorem greedyStepExpectation_persistentInternalConflictLinkSteps
    {H : Hypergraph V} {C : ConflictSystem V} (hC : IsConflictSystem H C)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ) :
    greedyStepExpectation H C M
        (persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) =
      (meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
          H C f j s M -
        meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
          H C f j s M) -
        persistentInternalConflictLinkProbability H C f M *
          scale *
          ((CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N
                j s (x + 1)) -
            (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N
                j s x)) ∧
      greedyStepExpectation H C M
        (persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) =
      -(meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
          H C f j s M -
        meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
          H C f j s M) +
        persistentInternalConflictLinkProbability H C f M *
          scale *
          ((CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N
                j s (x + 1)) -
            (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N
                j s x)) := by
  let I := persistentInternalConflictLinkIndicator H C f
  let p := persistentInternalConflictLinkProbability H C f M
  let Y := persistentInternalConflictLinkIncrement H C f j s M
  let du := scale *
    ((CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
      (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x))
  let dl := scale *
    ((CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
      (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x))
  have hY := greedyStepExpectation_persistentInternalConflictLinkIncrement
    hC M hf j s
  have hI : greedyStepExpectation H C M I = p := rfl
  have hupper :
      persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M =
        fun M' ↦ Y M' + (-du) * I M' := by
    funext M'
    by_cases hf' : f ∈ availableEdges H C M' <;>
      simp [persistentInternalConflictLinkUpperStep,
        persistentInternalConflictLinkIncrement,
        persistentInternalConflictLinkIndicator, Y, I, du, hf'] <;> ring
  have hlower :
      persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M =
        fun M' ↦ -Y M' + dl * I M' := by
    funext M'
    by_cases hf' : f ∈ availableEdges H C M' <;>
      simp [persistentInternalConflictLinkLowerStep,
        persistentInternalConflictLinkIncrement,
        persistentInternalConflictLinkIndicator, Y, I, dl, hf'] <;> ring
  constructor
  · rw [hupper, greedyStepExpectation_add,
      greedyStepExpectation_const_mul, hY, hI]
    dsimp only [p, du]
    ring
  · rw [hlower, greedyStepExpectation_add, greedyStepExpectation_neg,
      greedyStepExpectation_const_mul, hY, hI]
    dsimp only [p, dl]
    ring

/-- Survival-weighted mean windows imply nonpositive drift for the frozen
internal-link envelopes.  This is the exact algebraic consumer required by
the paper's event `E_Z`; all combinatorial work is isolated in the two mean
window hypotheses. -/
theorem persistentInternalConflictLink_oneState_stoppedDrift
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V)
    {D₂ D₃ D₄ Gamma epsilon d N x P scale : ℝ} {j s : ℕ}
    (R : CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hscale : 0 ≤ scale) (M : Hypergraph V)
    (hf : f ∈ availableEdges H C M)
    (hmuLower :
      persistentInternalConflictLinkProbability H C f M * scale *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x -
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x +
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
        meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
            H C f j s M -
          meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
            H C f j s M)
    (hmuUpper :
      meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
            H C f j s M -
          meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
            H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * scale *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x +
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x -
            2 * (d ^ ((s : ℝ) - j - epsilon) / N))) :
    greedyStepExpectation H C M
        (persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) ≤ 0 ∧
      greedyStepExpectation H C M
        (persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) ≤ 0 := by
  let p := persistentInternalConflictLinkProbability H C f M
  let mu := meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
      H C f j s M -
    meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
      H C f j s M
  have hp0 : 0 ≤ p := persistentInternalConflictLinkProbability_nonneg
    H C f M
  have hbridge := CFMTrajectories.partialTestEnvelope_drift_of_mean_window
    R (mul_nonneg hp0 hscale) (mu := mu)
      (by simpa only [p, mu, mul_assoc] using hmuLower)
      (by simpa only [p, mu, mul_assoc] using hmuUpper)
  have hsteps := greedyStepExpectation_persistentInternalConflictLinkSteps
    hC M hf D₂ D₃ D₄ Gamma epsilon d N scale x j s
  rw [hsteps.1, hsteps.2]
  simpa only [p, mu, mul_assoc] using hbridge

end

/-! ## Integrated: PersistentInternalReachableSource -/


open Finset Real CFMTrajectories

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! ## Reachable source budgets for next-active internal links

This package deliberately does not coerce through the legacy
`ReachableInternalConflictLinkSourceBudgets`.  Its increments freeze when
the distinguished edge is absent from the *next* available set, and its
mean hypotheses are the survival-weighted windows consumed by the exact
persistent drift identity. -/

theorem persistentInternalConflictLinkUpperStep_eq_timeStep_of_nextActive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M M' : Hypergraph V) (hf' : f ∈ availableEdges H C M') :
    persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s M M' =
      greedyTimeStep
        (internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s) k M M' := by
  simp only [persistentInternalConflictLinkUpperStep, hf', if_true,
    greedyTimeStep, internalConflictLinkUpperError,
    Nat.cast_add, Nat.cast_one]

theorem persistentInternalConflictLinkLowerStep_eq_timeStep_of_nextActive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M M' : Hypergraph V) (hf' : f ∈ availableEdges H C M') :
    persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s M M' =
      greedyTimeStep
        (internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s) k M M' := by
  simp only [persistentInternalConflictLinkLowerStep, hf', if_true,
    greedyTimeStep, internalConflictLinkLowerError,
    Nat.cast_add, Nat.cast_one]

theorem persistentInternalConflictLinkSteps_eq_zero_of_nextInactive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) (hf' : f ∉ availableEdges H C M') :
    persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' = 0 ∧
      persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' = 0 := by
  simp [persistentInternalConflictLinkUpperStep,
    persistentInternalConflictLinkLowerStep, hf']

/-- Once `f` is inactive, antitonicity makes every legal or frozen next
state inactive as well, so both persistent increments vanish. -/
theorem persistentInternalConflictLinkSteps_eq_zero_of_inactive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M : Hypergraph V) (hf : f ∉ availableEdges H C M)
    (o : GreedyChoice H) :
    persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M
          (greedyChoiceStep H C M o) = 0 ∧
      persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M
          (greedyChoiceStep H C M o) = 0 := by
  rcases o with _ | e
  · simp [greedyChoiceStep, persistentInternalConflictLinkUpperStep,
      persistentInternalConflictLinkLowerStep, hf]
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · have hf' : f ∉ availableEdges H C (insert (e : Finset V) M) :=
        fun h ↦ hf (availableEdges_antitone (Finset.subset_insert _ _) h)
      simp [greedyChoiceStep, greedyStep, he,
        persistentInternalConflictLinkUpperStep,
        persistentInternalConflictLinkLowerStep, hf']
    · simp [greedyChoiceStep, greedyStep, he,
        persistentInternalConflictLinkUpperStep,
        persistentInternalConflictLinkLowerStep, hf]

theorem greedyStepExpectation_persistentInternalConflictLinkSteps_eq_zero_of_inactive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M : Hypergraph V) (hf : f ∉ availableEdges H C M) :
    greedyStepExpectation H C M
        (persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) = 0 ∧
      greedyStepExpectation H C M
        (persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) = 0 := by
  constructor <;> rw [greedyStepExpectation] <;>
    apply Finset.sum_eq_zero <;> intro o ho
  · rw [(persistentInternalConflictLinkSteps_eq_zero_of_inactive
      H C f D₂ D₃ D₄ Gamma epsilon d N scale x j s M hf o).1,
      mul_zero]
  · rw [(persistentInternalConflictLinkSteps_eq_zero_of_inactive
      H C f D₂ D₃ D₄ Gamma epsilon d N scale x j s M hf o).2,
      mul_zero]

theorem greedyStepExpectation_persistentInternalConflictLinkSteps_sq_eq_zero_of_inactive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M : Hypergraph V) (hf : f ∉ availableEdges H C M) :
    greedyStepExpectation H C M (fun M' ↦
        (persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M M') ^ 2) = 0 ∧
      greedyStepExpectation H C M (fun M' ↦
        (persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M M') ^ 2) = 0 := by
  constructor <;> rw [greedyStepExpectation] <;>
    apply Finset.sum_eq_zero <;> intro o ho
  · rw [(persistentInternalConflictLinkSteps_eq_zero_of_inactive
      H C f D₂ D₃ D₄ Gamma epsilon d N scale x j s M hf o).1,
      zero_pow (by norm_num), mul_zero]
  · rw [(persistentInternalConflictLinkSteps_eq_zero_of_inactive
      H C f D₂ D₃ D₄ Gamma epsilon d N scale x j s M hf o).2,
      zero_pow (by norm_num), mul_zero]

/-- Closed local inputs for the persistent internal source.  The two mean
fields are intentionally already multiplied by the exact survival
probability; no full-mean transport is hidden in this interface. -/
structure ReachablePersistentInternalConflictLinkSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) : Prop where
  scale_nonneg : 0 ≤ scale
  registry : ∀ k, k < T → ∀ S, Good k S →
    CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s
  meanLower : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    persistentInternalConflictLinkProbability H C f S * scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s
            (k : ℝ) +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
          H C f j s S -
        meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
          H C f j s S
  meanUpper : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
          H C f j s S -
        meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
          H C f j s S ≤
      persistentInternalConflictLinkProbability H C f S * scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s
            (k : ℝ) -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N))
  upperJump : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S → ∀ o : GreedyChoice H,
    |persistentInternalConflictLinkUpperStep H C f
      D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
        (greedyChoiceStep H C S o)| ≤ jump k
  lowerJump : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S → ∀ o : GreedyChoice H,
    |persistentInternalConflictLinkLowerStep H C f
      D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
        (greedyChoiceStep H C S o)| ≤ jump k
  upperSquare : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    greedyStepExpectation H C S (fun S' ↦
      (persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') ^ 2) ≤
      variance k
  lowerSquare : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    greedyStepExpectation H C S (fun S' ↦
      (persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') ^ 2) ≤
      variance k

theorem persistentInternalConflictLinkStoppedMomentBounds_of_reachableSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (hCempty : ∅ ∉ C) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (_hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, Good k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachablePersistentInternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C ∅) (greedyInfo H T)
        (greedyStoppedStepIncrement H C ∅ T Good
          (fun k S S' ↦ persistentInternalConflictLinkUpperStep H C f
            D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S')) variance ∧
      Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C ∅) (greedyInfo H T)
        (greedyStoppedStepIncrement H C ∅ T Good
          (fun k S S' ↦ persistentInternalConflictLinkLowerStep H C f
            D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S')) variance := by
  let Reachable : ℕ → Hypergraph V → Prop := fun k S ↦
    IsConflictFreeMatching H C S ∧ S.card = k
  have hreachable : ∀ k, k < T → ∀ omega : GreedyOutcome H T,
      0 < greedyPathMassFrom H C ∅ omega →
      greedyPrefixGood H C ∅ Good k omega →
      Reachable k (greedyStateFromAt H C ∅ omega k) := by
    intro k hk omega hmass hgood
    constructor
    · rw [← greedyStateAt_eq_stateFrom_empty]
      exact greedyStateAt_isConflictFreeMatching H C hCempty omega k
    · exact card_greedyStateFromAt_empty_eq_time_of_good_available
        H C hCempty Good omega hmass havailable k (Nat.le_of_lt hk) hgood
  constructor <;> apply greedyStoppedStepIncrement_momentBounds_reachable
  · exact hvariance
  · exact hreachable
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact (persistentInternalConflictLink_oneState_stoppedDrift hC f
        (B.registry k hk S hgood) B.scale_nonneg S hf
        (B.meanLower k hk S hgood hreach.1 hreach.2 hf)
        (B.meanUpper k hk S hgood hreach.1 hreach.2 hf)).1
    · rw [(greedyStepExpectation_persistentInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).1]
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact B.upperSquare k hk S hgood hreach.1 hreach.2 hf
    · rw [(greedyStepExpectation_persistentInternalConflictLinkSteps_sq_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).1]
      exact hvariance k
  · exact hvariance
  · exact hreachable
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact (persistentInternalConflictLink_oneState_stoppedDrift hC f
        (B.registry k hk S hgood) B.scale_nonneg S hf
        (B.meanLower k hk S hgood hreach.1 hreach.2 hf)
        (B.meanUpper k hk S hgood hreach.1 hreach.2 hf)).2
    · rw [(greedyStepExpectation_persistentInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).2]
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact B.lowerSquare k hk S hgood hreach.1 hreach.2 hf
    · rw [(greedyStepExpectation_persistentInternalConflictLinkSteps_sq_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).2]
      exact hvariance k

theorem persistentInternalConflictLinkStoppedIncrements_abs_le_of_reachableSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) {R : ℝ}
    (hR0 : 0 ≤ R) (hR : ∀ k, k < T → jump k ≤ R)
    (B : ReachablePersistentInternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    (∀ k omega,
      |greedyStoppedStepIncrement H C ∅ T Good
        (fun i S S' ↦ persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S')
        k omega| ≤ R) ∧
      (∀ k omega,
      |greedyStoppedStepIncrement H C ∅ T Good
        (fun i S S' ↦ persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S')
        k omega| ≤ R) := by
  constructor <;> apply greedyStoppedStepIncrement_abs_le_of_local <;>
    try exact hR0
  · intro k hk S hgood o
    by_cases hf : f ∈ availableEdges H C S
    · exact (B.upperJump k hk S hgood hf o).trans (hR k hk)
    · rw [(persistentInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf o).1,
        abs_zero]
      exact hR0
  · intro k hk S hgood o
    by_cases hf : f ∈ availableEdges H C S
    · exact (B.lowerJump k hk S hgood hf o).trans (hR k hk)
    · rw [(persistentInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf o).2,
        abs_zero]
      exact hR0

theorem persistentInternalConflictLinkUpperFirstFailureEvent_subset_tail
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V) (T : ℕ)
    (Pgood : iota → ℕ → Hypergraph V → Prop) (i : iota)
    (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale t : ℝ) (j s : ℕ)
    (hcomponent : ∀ k S, Pgood i k S ↔
      internalConflictLinkUpperCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k S)
    (hinitial : internalConflictLinkUpperError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s 0 ∅ ≤ -t) :
    greedyFirstFailureEvent H C ∅ T Pgood i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C ∅ T (indexedGreedyGood Pgood)
            (fun q S S' ↦ persistentInternalConflictLinkUpperStep H C f
              D₂ D₃ D₄ Gamma epsilon d N scale (q : ℝ) j s S S'))
          T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hfailCorridor : ¬ internalConflictLinkUpperCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s (k + 1)
        (greedyStateFromAt H C ∅ omega (k + 1)) := by
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hbad := (not_internalConflictLinkUpperCorridor_iff H C f
    D₂ D₃ D₄ Gamma epsilon d N scale j s (k + 1) _).mp hfailCorridor
  have hfailure : ¬ indexedGreedyGood Pgood (k + 1)
      (greedyStateFromAt H C ∅ omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    greedyStoppedStep_exit_imp_terminal_tail H C ∅ T
      (indexedGreedyGood Pgood)
      (fun q S S' ↦ persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (q : ℝ) j s S S')
      (internalConflictLinkUpperError H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s)
      omega hk hgood hfailure (by
        intro q hq
        exact persistentInternalConflictLinkUpperStep_eq_timeStep_of_nextActive
          H C f D₂ D₃ D₄ Gamma epsilon d N scale j s q _ _
          (mem_availableEdges_greedyStateFromAt_of_le H C ∅ omega
            (Nat.succ_le_succ hq) hbad.1))
      hinitial hbad.2⟩

