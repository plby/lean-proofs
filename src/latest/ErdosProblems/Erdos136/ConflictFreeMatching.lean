    intro f hf g hg hgf hfg hpair
    have hsum := sum_rerootedPartialCard_le_ceil
      H R.regularized M f g
      (fun _ _ ↦ 2 * localSpreadPrimaryMargin eta d)
      (fun _ _ ↦ mul_nonneg (by norm_num) <|
        div_nonneg (Real.rpow_nonneg (by positivity) _) (by norm_num))
      (fun q hq r hr ↦ hreroot f hf g hg hgf hfg hpair q hq r hr)
    have hqcard : (Finset.Icc (1 : ℕ) 3).card = 3 := by decide
    have hrcard : (Finset.Icc (1 : ℕ) 5).card = 5 := by decide
    have hmass :
        (∑ q ∈ Finset.Icc (1 : ℕ) 3, ∑ r ∈ Finset.Icc (1 : ℕ) 5,
          (2 : ℝ) * localSpreadPrimaryMargin eta d) =
          30 * localSpreadPrimaryMargin eta d := by
      simp only [Finset.sum_const_zero, Finset.sum_const, hqcard, hrcard,
        nsmul_eq_mul]
      ring
    rw [hmass] at hsum
    exact hsum
  have hloss : weightedPartialTestLossCollision (R.restrictedWeight a)
      H R.regularized M (j a) s.1 ≤
        lossK * partialTestObservable (R.restrictedWeight a)
          H R.regularized (j a) s.1 M := by
    dsimp only [lossK]
    exact weightedPartialTestLossCollision_le_legalPairAggregateCaps
      (R.restrictedWeight a) H R.regularized M (j a) s.1
      (Nat.ceil (d ^ (1 - eta)))
      (certificateMixedLossCapNat eta
        (CFMRegularization.rawRegularizationEps eta) d)
