theorem weightedGainCollisionResidualNonFullRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualNonFullRootMass w H C j r root ≤
      36 * testTotal w H j * Real.rpow d
        (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4) := by
  rw [weightedGainCollisionResidualNonFullRootMass_eq_empty_add_nonempty]
  have hempty := weightedGainCollisionResidualNonFullEmptySourceRootMass_le_raw
    (r := r) hw.isTestFunction.nonneg hB hd heps hj3 root
  have hmeet :=
    weightedGainCollisionResidualNonFullNonemptySourceRootMass_le_raw
      (r := r) hw hB hd heps hj3 root hrootH hroot2
  have htotal0 := testTotal_nonneg hw.isTestFunction.nonneg H j
  let E : ℝ := ((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4
  have hrpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d) E
  have hweaken : Real.rpow d (E - epsRaw / 5) ≤ Real.rpow d E := by
    apply Real.rpow_le_rpow_of_exponent_le hd
    linarith
  calc
    weightedGainCollisionResidualNonFullEmptySourceRootMass
          w H C j r root +
        weightedGainCollisionResidualNonFullNonemptySourceRootMass
          w H C j r root ≤
      12 * testTotal w H j * Real.rpow d E +
        24 * testTotal w H j * Real.rpow d (E - epsRaw / 5) := by
      exact add_le_add hempty (by simpa only [E] using hmeet)
    _ ≤ 12 * testTotal w H j * Real.rpow d E +
        24 * testTotal w H j * Real.rpow d E := by
      exact add_le_add (le_refl _)
        (mul_le_mul_of_nonneg_left hweaken
          (mul_nonneg (by norm_num) htotal0))
    _ = 36 * testTotal w H j * Real.rpow d E := by ring

