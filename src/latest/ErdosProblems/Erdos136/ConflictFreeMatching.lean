noncomputable section

namespace CFMSharpTestInternalNaturalNumeric

/-- The proper-root internal profile is built at the coefficient-free
scale `W * d^(-1-epsilon)`.  Since the certificate has `ell >= 1`, this
scale is dominated by the external original-test scale.  This is the only
conversion needed to reuse the already-closed original-test scalar
registry. -/
theorem two_internal_margin_le_two_external_margin
    {eta d W : ℝ} {ell n : ℕ}
    (hd : 0 ≤ d) (hW : 0 ≤ W) (hell : 1 ≤ ell) :
    2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta)) 0 n ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta)) 0 n := by
  have hellR : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
  have hp : 0 ≤ d ^ (-1 - CFMNumeric.coreEpsilon eta) :=
    Real.rpow_nonneg hd _
  have hbase0 : 0 ≤ W * d ^ (-1 - CFMNumeric.coreEpsilon eta) :=
    mul_nonneg hW hp
  have hbase : W * d ^ (-1 - CFMNumeric.coreEpsilon eta) ≤
      (ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta) := by
    calc
      W * d ^ (-1 - CFMNumeric.coreEpsilon eta) =
          1 * (W * d ^ (-1 - CFMNumeric.coreEpsilon eta)) := by ring
      _ ≤ (ell : ℝ) * (W * d ^ (-1 - CFMNumeric.coreEpsilon eta)) :=
        mul_le_mul_of_nonneg_right hellR hbase0
      _ = (ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta) := by ring
  unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
  simp only [pow_zero, mul_one]
  exact mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_right hbase
      (pow_nonneg (Real.rpow_nonneg hd _) n)) (by norm_num)

/-- Proper internal gain and loss roots occupy half the natural source
jump.  This is the source-faithful scalar package for statuses `s >= 2`;
the status restriction belongs to the structural cap extractor, not to
this purely numeric statement. -/
theorem properInternalRawCap_le_naturalHalf
    {D₂ D₃ D₄ eta d N W gainRootCap lossRootCap : ℝ}
    {ell k q s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) q s)
    (hell : 1 ≤ ell) (hW : 0 ≤ W) (hloss0 : 0 ≤ lossRootCap)
    (hgain : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - (s + 1)))
    (hloss : lossRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - s)) :
    max gainRootCap
        (certificateTestStatusHi D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
            d N k * lossRootCap) ≤
      testSourceJumpScale (W * d ^ ((s : ℝ) - q)) d
        (CFMNumeric.coreEpsilon eta) / 2 := by
  have hd0 : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hgain' : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - (s + 1)) :=
    hgain.trans (two_internal_margin_le_two_external_margin hd0 hW hell)
  have hloss' : lossRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - s) :=
    hloss.trans (two_internal_margin_le_two_external_margin hd0 hW hell)
  exact CFMSharpTestExternalRootNumeric.originalTestRawCap_le_naturalHalf
    E S R hW hloss0 hgain' hloss'

/-- The proper internal gain root alone occupies half the natural source
jump.  For the positive-status architecture this is exactly the scalar
piece used at `s = 1`; the missing loss root is intentionally absent. -/
theorem properInternalGainCap_le_naturalHalf
    {D₂ D₃ D₄ eta d N W gainRootCap : ℝ}
    {ell k q s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) q s)
    (hell : 1 ≤ ell) (hW : 0 ≤ W) (hgain0 : 0 ≤ gainRootCap)
    (hgain : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - (s + 1))) :
    gainRootCap ≤
      testSourceJumpScale (W * d ^ ((s : ℝ) - q)) d
        (CFMNumeric.coreEpsilon eta) / 2 := by
  have hd0 : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hzero : (0 : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta)) 0 (q - s) := by
    unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
    exact mul_nonneg (by norm_num) (mul_nonneg
      (mul_nonneg (mul_nonneg hW (Real.rpow_nonneg hd0 _))
        (pow_nonneg (inv_nonneg.mpr hd0) 0))
      (pow_nonneg (Real.rpow_nonneg hd0 _) (q - s)))
  have hcap := properInternalRawCap_le_naturalHalf
    E S R hell hW (show (0 : ℝ) ≤ 0 by norm_num) hgain hzero
  simpa only [mul_zero, max_eq_left hgain0] using hcap

/-- The sharp averaged-square contribution of a proper internal raw cap
fits the source variance once the structural proper-root caps have supplied
the half-jump bound.  This packages the complete `s >= 2` numeric step. -/
theorem properInternalRawCapAndVariance
    {D₂ D₃ D₄ eta d N W a gainRootCap lossRootCap : ℝ}
    {ell k q s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) q s)
    (hell : 1 ≤ ell) (hW : 0 ≤ W)
    (hgain0 : 0 ≤ gainRootCap) (hloss0 : 0 ≤ lossRootCap)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (1 - CFMTrajectories.xi (6 * (2 * (ell : ℝ) + 1))
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) ≤ a)
    (hgain : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - (s + 1)))
    (hloss : lossRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - s)) :
    let rawCap := max gainRootCap
      (certificateTestStatusHi D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d N k * lossRootCap)
    rawCap ≤ testSourceJumpScale (W * d ^ ((s : ℝ) - q)) d
        (CFMNumeric.coreEpsilon eta) / 2 ∧
      rawCap *
          ((((s + 1 : ℕ) : ℝ) *
              (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N q (s + 1) (k : ℝ) +
                CFMTrajectories.zeta D₂ D₃ D₄
                  (6 * (2 * (ell : ℝ) + 1))
                  (CFMNumeric.coreEpsilon eta) d N q (s + 1) (k : ℝ))) +
            ((s : ℝ) * certificateTestStatusHi D₂ D₃ D₄
              (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
                d N k) *
              (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N q s (k : ℝ) +
                CFMTrajectories.zeta D₂ D₃ D₄
                  (6 * (2 * (ell : ℝ) + 1))
                  (CFMNumeric.coreEpsilon eta) d N q s (k : ℝ)))) / a) ≤
        testSourceVarianceScale (W * d ^ ((s : ℝ) - q)) d
          (CFMNumeric.coreEpsilon eta) N := by
  dsimp only
  have hcap := properInternalRawCap_le_naturalHalf
    E S R hell hW hloss0 hgain hloss
  have hraw0 : 0 ≤ max gainRootCap
      (certificateTestStatusHi D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d N k * lossRootCap) := by
    exact hgain0.trans (le_max_left _ _)
  refine ⟨hcap, ?_⟩
  exact CFMSharpTestExternalVarianceNumeric.originalTestRawVariance_le_source
    E S R hW hraw0 haLo hcap

/-- Gain-only sharp averaged-square package for status one.  The theorem
does not assert anything about the status-one loss: that term is supplied
separately by the next-active reroot/vertex profiles from Lemma 7.24. -/
theorem properInternalGainCapAndVariance
    {D₂ D₃ D₄ eta d N W a gainRootCap : ℝ}
    {ell k q s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) q s)
    (hell : 1 ≤ ell) (hW : 0 ≤ W) (hgain0 : 0 ≤ gainRootCap)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (1 - CFMTrajectories.xi (6 * (2 * (ell : ℝ) + 1))
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) ≤ a)
    (hgain : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        (W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (q - (s + 1))) :
    gainRootCap ≤ testSourceJumpScale (W * d ^ ((s : ℝ) - q)) d
        (CFMNumeric.coreEpsilon eta) / 2 ∧
      gainRootCap *
          ((((s + 1 : ℕ) : ℝ) *
              (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N q (s + 1) (k : ℝ) +
                CFMTrajectories.zeta D₂ D₃ D₄
                  (6 * (2 * (ell : ℝ) + 1))
                  (CFMNumeric.coreEpsilon eta) d N q (s + 1) (k : ℝ))) +
            ((s : ℝ) * certificateTestStatusHi D₂ D₃ D₄
              (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
                d N k) *
              (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N q s (k : ℝ) +
                CFMTrajectories.zeta D₂ D₃ D₄
                  (6 * (2 * (ell : ℝ) + 1))
                  (CFMNumeric.coreEpsilon eta) d N q s (k : ℝ)))) / a) ≤
        testSourceVarianceScale (W * d ^ ((s : ℝ) - q)) d
          (CFMNumeric.coreEpsilon eta) N := by
  have hcap := properInternalGainCap_le_naturalHalf
    E S R hell hW hgain0 hgain
  refine ⟨hcap, ?_⟩
  exact CFMSharpTestExternalVarianceNumeric.originalTestRawVariance_le_source
    E S R hW hgain0 haLo hcap

end CFMSharpTestInternalNaturalNumeric

end

/-! ## Integrated: PersistentInternalPointwiseVariance -/


open Finset Real CFMTrajectories

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-! ## Survivor pointwise and square budgets

The persistent process only moves on choices which retain its frozen
source edge.  At status one the loss is the dedicated legal-reroot bound;
at larger statuses both gain and loss are proper original-choice roots.
The averaged square may nevertheless use the full gain/loss multiplicity,
which is an upper bound for the survivor-restricted square and retains the
sharp `1 / |A|` factor. -/

theorem persistentInternalConflictLink_survivingPointwiseAndRawVariance_of_stateCaps
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (f : {e : Finset V // e ∈ H})
    (q : Fin 3) (u : Fin (q.1 + 1))
    (M : Hypergraph V) (hM : IsConflictFreeMatching H R.regularized M)
    (hf : f.1 ∈ availableEdges H R.regularized M)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M)
    (Caps : PersistentInternalStateSourceCaps H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) eta N T k
      (CFMNumeric.trajectoryFloor eta d) j w R f q u M) :
    let qActual := q.1 + 1
    let sActual := u.1 + 1
    let scale := persistentInternalSourceScale H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R q
    let P := scale * Real.rpow d
      ((sActual : ℝ) - (qActual : ℝ))
    let rawCap := testSourceJumpScale P d (CFMNumeric.coreEpsilon eta) / 2
    (∀ e ∈ availableEdges H R.regularized M,
      f.1 ∈ availableEdges H R.regularized (insert e M) →
      partialTestStepGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M e ≤ rawCap ∧
        partialTestStepLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M e ≤ rawCap) ∧
      greedyStepExpectation H R.regularized M (fun M' ↦
        (persistentInternalConflictLinkIncrement H R.regularized f.1
          qActual sActual M M') ^ 2) ≤
        testSourceVarianceScale P d (CFMNumeric.coreEpsilon eta) (N : ℝ) := by
  dsimp only
  let qActual := q.1 + 1
  let sActual := u.1 + 1
  let scale := persistentInternalSourceScale H C d
    (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R q
  let P := scale * Real.rpow d ((sActual : ℝ) - (qActual : ℝ))
  let rawCap := testSourceJumpScale P d (CFMNumeric.coreEpsilon eta) / 2
  let statusHi := persistentInternalStatusHi
    D₂ D₃ D₄ (6 * (2 * (ell : ℝ) + 1)) eta d (N : ℝ) k
  let nextHi := scale *
    (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
        qActual (sActual + 1) (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d (N : ℝ) qActual (sActual + 1) (k : ℝ))
  let currentHi := scale *
    (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
        qActual sActual (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d (N : ℝ) qActual sActual (k : ℝ))
  let properGain := 2 * finiteWeightedRootShadowMargin eta d
    (scale * Real.rpow d
      (-1 - CFMRegularization.rawRegularizationEps eta / 5))
      0 (qActual - (sActual + 1))
  let properLoss := 2 * finiteWeightedRootShadowMargin eta d
    (scale * Real.rpow d
      (-1 - CFMRegularization.rawRegularizationEps eta / 5))
      0 (qActual - sActual)
  have hq1 : 1 ≤ qActual := by omega
  have hq3 : qActual ≤ 3 := by
    dsimp only [qActual]
    exact q.2
  have hs1 : 1 ≤ sActual := by omega
  have hsq : sActual ≤ qActual := by
    dsimp only [sActual, qActual]
    exact u.2
  have hell1 : 1 ≤ ell := by
    have hell4 : 4 ≤ ell := hinst.2.2.1
    omega
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hd0 : 0 ≤ d := zero_le_one.trans hd
  have hscale0 : 0 ≤ scale := by
    dsimp only [scale, persistentInternalSourceScale]
    exact (certificateInternalLayerScale_pos H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R (q.1 + 2) hdpos).le
  have hP0 : 0 ≤ P := by
    dsimp only [P]
    exact mul_nonneg hscale0 (Real.rpow_nonneg hd0 _)
  have hraw0 : 0 ≤ rawCap := by
    dsimp only [rawCap, testSourceJumpScale]
    exact div_nonneg (mul_nonneg hP0 (Real.rpow_nonneg hd0 _)) (by norm_num)
  have hweight : ∀ Q,
      0 ≤ conflictLinkTestWeight R.regularized f.1 qActual Q :=
    conflictLinkTestWeight_nonneg_sharp R.regularized f.1 qActual
  have hproperGain0 : 0 ≤ properGain := by
    dsimp only [properGain]
    unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
      finiteWeightedRootShadowStepFactor
    exact mul_nonneg (by norm_num) (mul_nonneg
      (mul_nonneg (mul_nonneg hscale0 (Real.rpow_nonneg hd0 _))
        (pow_nonneg (inv_nonneg.mpr hd0) 0))
      (pow_nonneg (Real.rpow_nonneg hd0 _) _))
  have hproperLoss0 : 0 ≤ properLoss := by
    dsimp only [properLoss]
    unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
      finiteWeightedRootShadowStepFactor
    exact mul_nonneg (by norm_num) (mul_nonneg
      (mul_nonneg (mul_nonneg hscale0 (Real.rpow_nonneg hd0 _))
        (pow_nonneg (inv_nonneg.mpr hd0) 0))
      (pow_nonneg (Real.rpow_nonneg hd0 _) _))
  have hpoint : ∀ e ∈ availableEdges H R.regularized M,
      f.1 ∈ availableEdges H R.regularized (insert e M) →
      partialTestStepGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M e ≤ rawCap ∧
        partialTestStepLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M e ≤ rawCap := by
    intro e he hfnext
    by_cases hsone : sActual = 1
    · have hu0 : u.1 = 0 := by omega
      have hgain : partialTestStepGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M e ≤ rawCap := by
        by_cases hqone : qActual = 1
        · calc
            partialTestStepGain
                (conflictLinkTestWeight R.regularized f.1 qActual)
                H R.regularized qActual sActual M e = 0 := by
              simpa only [hqone, hsone] using
                partialTestStepGain_conflictLink_one_one_eq_zero
                  H R.regularized M f.1 he
            _ ≤ rawCap := hraw0
        · have hq2 : 2 ≤ qActual := by omega
          have hroot := Caps.properOriginal e
            (availableEdges_subset H R.regularized M he) hq2
              (qActual - (sActual + 1)) (by omega)
          have hcap :=
            CFMSharpTestInternalNaturalNumeric.properInternalGainCap_le_naturalHalf
              (W := scale) (gainRootCap := properGain)
              E S Caps.registry hell1 hscale0 hproperGain0 (by
                change properGain ≤ properGain
                exact le_rfl)
          change properGain ≤ rawCap at hcap
          have hbase := partialTestStepGain_le_originalTestRootShadow
            (conflictLinkTestWeight R.regularized f.1 qActual)
              H R.regularized M qActual sActual he hweight
          have hroot' : testTotal
              (originalTestRootShadowWeight
                (conflictLinkTestWeight R.regularized f.1 qActual)
                  H qActual e) M (qActual - (sActual + 1)) ≤ properGain := by
            simpa only [properGain] using hroot
          exact hbase.trans (hroot'.trans hcap)
      have hloss :=
        internalConflictLink_one_surviving_loss_le_naturalHalf_of_finalGood
          H C d eta ell j w hinst R E S D₂ D₃ D₄ N T k hN hT hk
            f.1 f.2 qActual hq1 hq3 M hM hf hgood e he hfnext
      have hscaleEq : certificateInternalLayerScale H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R (qActual + 1) = scale := by
        dsimp only [qActual, scale, persistentInternalSourceScale]
      rw [hscaleEq] at hloss
      exact ⟨hgain, by
        simpa only [rawCap, P, scale, qActual, sActual, hsone,
          Nat.cast_one] using hloss⟩
    · have hs2 : 2 ≤ sActual := by omega
      have hq2 : 2 ≤ qActual := hs2.trans hsq
      have hgainRoot := Caps.properOriginal e
        (availableEdges_subset H R.regularized M he) hq2
          (qActual - (sActual + 1)) (by omega)
      have hlossRoots : ∀ g ∈ availableEdges H R.regularized M,
          testTotal
            (originalTestRootShadowWeight
              (conflictLinkTestWeight R.regularized f.1 qActual)
                H qActual g) M (qActual - sActual) ≤ properLoss := by
        intro g hg
        exact Caps.properOriginal g
          (availableEdges_subset H R.regularized M hg) hq2
            (qActual - sActual) (by omega)
      have hp := partialTestStepGain_loss_le_originalTestRootCaps_of_blockers
        (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized M qActual sActual he hweight hproperLoss0
            (by simpa only [properGain] using hgainRoot) hlossRoots
            (Caps.status e he).2
      have hnumeric :=
        CFMSharpTestInternalNaturalNumeric.properInternalRawCap_le_naturalHalf
          (W := scale) (gainRootCap := properGain)
          (lossRootCap := properLoss)
          E S Caps.registry hell1 hscale0 hproperLoss0
            (by
              change properGain ≤ properGain
              exact le_rfl)
            (by
              change properLoss ≤ properLoss
              exact le_rfl)
      change max properGain (statusHi * properLoss) ≤ rawCap at hnumeric
      have hmax : max properGain (statusHi * properLoss) ≤ rawCap := by
        exact hnumeric
      exact ⟨hp.1.trans ((le_max_left _ _).trans hmax),
        hp.2.trans ((le_max_right _ _).trans hmax)⟩
  have hmult := partialTest_aggregateMultiplicity_upper_of_status
    (conflictLinkTestWeight R.regularized f.1 qActual)
      H R.regularized M qActual sActual statusHi hweight
      (fun e he ↦ (Caps.status e he).2)
  have hmean := meanPartialTestGain_add_loss_le_of_aggregateMultiplicity
    (conflictLinkTestWeight R.regularized f.1 qActual)
      H R.regularized M qActual sActual Caps.availableNonempty hmult
  have hmean' :
      meanPartialTestGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
            H R.regularized qActual sActual M +
        meanPartialTestLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
            H R.regularized qActual sActual M ≤
      ((((sActual + 1 : ℕ) : ℝ) * nextHi +
          ((sActual : ℝ) * statusHi) * currentHi) /
        ((availableEdges H R.regularized M).card : ℝ)) := by
    apply hmean.trans
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    exact add_le_add
      (mul_le_mul_of_nonneg_left
        (by simpa only [nextHi, scale, qActual, sActual, Nat.add_assoc]
          using Caps.next.2) (by positivity))
      (mul_le_mul_of_nonneg_left
        (by simpa only [currentHi, scale, qActual, sActual]
          using Caps.current.2)
        (mul_nonneg (Nat.cast_nonneg _) Caps.statusHi_nonneg))
  have hsqRaw :=
    greedyStepExpectation_persistentInternalConflictLinkIncrement_sq_le_cap_mul_meanGain_add_meanLoss
      R.isConflictSystem M hf qActual sActual hweight hraw0
        (fun e he hnext ↦ (hpoint e he hnext).1)
        (fun e he hnext ↦ (hpoint e he hnext).2)
  have hsharp : rawCap *
        ((((sActual + 1 : ℕ) : ℝ) * nextHi +
          ((sActual : ℝ) * statusHi) * currentHi) /
            ((availableEdges H R.regularized M).card : ℝ)) ≤
      testSourceVarianceScale P d (CFMNumeric.coreEpsilon eta) (N : ℝ) := by
    exact CFMSharpTestExternalVarianceNumeric.originalTestRawVariance_le_source
      E S Caps.registry hscale0 hraw0 Caps.availableBounds.1 (by rfl)
  exact ⟨hpoint, hsqRaw.trans
    ((mul_le_mul_of_nonneg_left hmean' hraw0).trans hsharp)⟩

end

/-! ## Integrated: PersistentInternalPositivePaired -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! The persistent process has the same deterministic time-zero errors as
the ordinary internal-link envelope.  Consequently the existing initial
gap calculation promotes any closed persistent reachable source package
without changing its jump, variance, or deviation scales. -/

theorem positivePairedFirstFailureSourceBudgets_of_reachablePersistentInternalNaturalScale
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ GammaCore epsilonCore N Pfloor : ℝ)
    (f : Finset V) (q s : ℕ) (jump variance : ℕ → ℝ)
    (hf : f ∈ H) (hq1 : 1 ≤ q) (hq3 : q ≤ 3) (hsq : s ≤ q)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    (hcore : epsilonCore = epsRaw / 5) (hGammaCore : 0 < GammaCore)
    (B : ReachablePersistentInternalConflictLinkSourceBudgets
      H R.regularized f Good T
      D₂ D₃ D₄ GammaCore epsilonCore d N Pfloor
      (certificateInternalLayerScale
        H C d epsRaw GammaCert ellCert j w R (q + 1))
      q s jump variance) :
    let scale := certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (q + 1)
    let P := scale * Real.rpow d ((s : ℝ) - (q : ℝ))
    CFMNumericAggregation.PositivePairedFirstFailureSourceBudgets P
      (ReachablePersistentInternalConflictLinkSourceBudgets
        H R.regularized f Good T
        D₂ D₃ D₄ GammaCore epsilonCore d N Pfloor scale
        q s jump variance)
      (internalConflictLinkUpperError H R.regularized f
        D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅)
      (internalConflictLinkLowerError H R.regularized f
        D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅)
      (CFMNumericAggregation.testDeviation GammaCore P d epsilonCore) := by
  dsimp only
