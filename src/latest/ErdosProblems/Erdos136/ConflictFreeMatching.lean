  let surv := survivingVertexProbability H R.regularized v.1 M
  let bracket := -CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
    CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) -
    2 * (d ^ (1 - CFMNumeric.coreEpsilon eta) / N)
  have hmean0 : 0 ≤ meanMissAvailableDegreeLoss H R.regularized M v.1 := by
