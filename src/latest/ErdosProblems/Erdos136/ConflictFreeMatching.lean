/-! ## Integrated: FinalProviderFlattening -/


open Finset Real
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-! ## The exact enhanced-to-final flattening -/

/-- The old three corridor families occupy the fourfold-left branch of the
final source predicate.  The four additional local families use the map
already fixed by `FinalCombinedTailEntropy`. -/
def finalProviderEnhancedCoordinateToFinal
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ) :
    EnhancedRegularizedGreedyIndex H j (FinalCombinedLocalIndex H C io j) →
      FinalReachableTestEnhancedIndex H C io j
  | Sum.inl a => Sum.inl (Sum.inl (Sum.inl (Sum.inl a)))
  | Sum.inr a => finalCombinedLocalCoordinateToFinal H C j a

/-- The explicit inverse is useful both for the indexed-Good equivalence and
for keeping the final finite union definitionally transparent. -/
def finalCoordinateToProviderEnhanced
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ) :
    FinalReachableTestEnhancedIndex H C io j →
      EnhancedRegularizedGreedyIndex H j (FinalCombinedLocalIndex H C io j)
  | Sum.inl (Sum.inl (Sum.inl (Sum.inl a))) => Sum.inl a
  | Sum.inl (Sum.inl (Sum.inl (Sum.inr a))) => Sum.inr (Sum.inl a)
  | Sum.inl (Sum.inl (Sum.inr z)) => Sum.inr (Sum.inr (Sum.inl z))
  | Sum.inl (Sum.inr c) => Sum.inr (Sum.inr (Sum.inr (Sum.inl c)))
  | Sum.inr a => Sum.inr (Sum.inr (Sum.inr (Sum.inr a)))

@[simp] theorem finalCoordinateToProviderEnhanced_toFinal
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (a : EnhancedRegularizedGreedyIndex H j
      (FinalCombinedLocalIndex H C io j)) :
    finalCoordinateToProviderEnhanced H C j
        (finalProviderEnhancedCoordinateToFinal H C j a) = a := by
  rcases a with a | (a | (z | (c | t))) <;> rfl

@[simp] theorem finalProviderEnhancedCoordinateToFinal_toEnhanced
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (a : FinalReachableTestEnhancedIndex H C io j) :
    finalProviderEnhancedCoordinateToFinal H C j
        (finalCoordinateToProviderEnhanced H C j a) = a := by
  rcases a with (((a | a) | z) | c) | t <;> rfl

/-- Local predicate supplied to the generic enhanced extraction theorem. -/
noncomputable def finalProviderLocalPredicate
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d epsRaw
      GammaCert ellCert j w) :
    FinalCombinedLocalIndex H R.regularized io j → ℕ → Hypergraph V → Prop :=
  fun a k M ↦
    finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
      D₂ D₃ D₄ GammaCore eta N T j w R
        (finalCombinedLocalCoordinateToFinal H R.regularized j a) k M

theorem finalProviderEnhancedPredicate_component_iff
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d epsRaw
      GammaCert ellCert j w)
    (a : EnhancedRegularizedGreedyIndex H j
      (FinalCombinedLocalIndex H R.regularized io j)) (k : ℕ) (M : Hypergraph V) :
    enhancedRegularizedGreedyPredicate H R.regularized D₂ D₃ D₄
        GammaCore (CFMNumeric.coreEpsilon eta) d (N : ℝ) j R.restrictedWeight
        (finalProviderLocalPredicate H C d epsRaw GammaCert ellCert
          D₂ D₃ D₄ GammaCore eta N T j w R) a k M ↔
      finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R
          (finalProviderEnhancedCoordinateToFinal H R.regularized j a) k M := by
  rcases a with a | (a | (z | (c | t))) <;> rfl

theorem indexedFinalProviderEnhancedGood_iff_finalReachableGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d epsRaw
      GammaCert ellCert j w) (k : ℕ) (M : Hypergraph V) :
    indexedGreedyGood
        (enhancedRegularizedGreedyPredicate H R.regularized D₂ D₃ D₄
          GammaCore (CFMNumeric.coreEpsilon eta) d (N : ℝ) j R.restrictedWeight
          (finalProviderLocalPredicate H C d epsRaw GammaCert ellCert
            D₂ D₃ D₄ GammaCore eta N T j w R)) k M ↔
      indexedGreedyGood
        (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
          D₂ D₃ D₄ GammaCore eta N T j w R) k M := by
  constructor
  · intro hgood a
    have ha := hgood (finalCoordinateToProviderEnhanced H R.regularized j a)
    exact (finalProviderEnhancedPredicate_component_iff
      H C d epsRaw GammaCert ellCert D₂ D₃ D₄ GammaCore eta N T
      j w R (finalCoordinateToProviderEnhanced H R.regularized j a) k M).mp ha
      |> (by simpa using ·)
  · intro hgood a
    exact (finalProviderEnhancedPredicate_component_iff
      H C d epsRaw GammaCert ellCert D₂ D₃ D₄ GammaCore eta N T
      j w R a k M).mpr
        (hgood (finalProviderEnhancedCoordinateToFinal H R.regularized j a))

end

