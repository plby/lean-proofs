open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-- A one-edge conflict link through a vertex is already a `(C4)`
neighbour.  The map sends the singleton residual link to its unique host
edge; keeping this statement separate lets the surviving one-open bound
include link rank one without pretending it is a local-spread coordinate. -/
theorem card_localConflictLinkPartialAtVertex_one_le_C4
    (H : Hypergraph V) (C : ConflictSystem V) (A M : Hypergraph V)
    (hAH : A ⊆ H) (e : Finset V) (v : V) :
    (localConflictLinkPartialAtVertex C A M e 1 1 v).card ≤
      CFMRegularization.conditionC4Count H C e v := by
  let L := localConflictLinkPartialAtVertex C A M e 1 1 v
  let F : Hypergraph V → Finset V := fun Q ↦ Q.biUnion id
  change L.card ≤
    ((CFMRegularization.twoConflictNeighbors H C e).filter (v ∈ ·)).card
  apply Finset.card_le_card_of_injOn F
  · intro Q hQ
    have hQ' := mem_localConflictLinkPartialAtVertex.mp hQ
    obtain ⟨g, hgQ, hgA, hvg⟩ := hQ'.2
    have hQlink := (mem_partialFamily.mp hQ'.1).1
    have hQcard := (mem_conflictLinkLayer.mp hQlink).2
    obtain ⟨a, hQa⟩ := Finset.card_eq_one.mp hQcard
    have hag : a = g := by
      rw [hQa] at hgQ
      exact (Finset.mem_singleton.mp hgQ).symm
    subst a
    have hF : F Q = g := by simp [F, hQa]
    rw [hF]
    change g ∈ (CFMRegularization.twoConflictNeighbors H C e).filter (v ∈ ·)
    rw [Finset.mem_filter]
    obtain ⟨⟨c, hcC, hec, hcErase⟩, _⟩ :=
      mem_conflictLinkLayer.mp hQlink
    have hgErase : g ∈ c.erase e := by
      rw [hcErase, hQa]
      simp
    have hge : g ≠ e := (Finset.mem_erase.mp hgErase).1
    have hcEq : c = {e, g} := by
      calc
        c = insert e (c.erase e) := (Finset.insert_erase hec).symm
        _ = insert e Q := by rw [hcErase]
        _ = {e, g} := by rw [hQa]
    refine ⟨Finset.mem_filter.mpr ⟨hAH hgA, hge, ?_⟩, hvg⟩
    rw [← hcEq]
    exact mem_conflictLayer.mpr
      ⟨hcC, by rw [hcEq]; simp [Ne.symm hge]⟩
  · intro Q hQ R hR hFR
    have hQlink := (mem_partialFamily.mp
      (mem_localConflictLinkPartialAtVertex.mp hQ).1).1
    have hRlink := (mem_partialFamily.mp
      (mem_localConflictLinkPartialAtVertex.mp hR).1).1
    obtain ⟨g, hQg⟩ := Finset.card_eq_one.mp
      (mem_conflictLinkLayer.mp hQlink).2
    obtain ⟨g', hRg'⟩ := Finset.card_eq_one.mp
      (mem_conflictLinkLayer.mp hRlink).2
    have hgg' : g = g' := by
      simpa [F, hQg, hRg'] using hFR
    rw [hQg, hRg', hgg']

/-- The complete surviving one-open loss geometry costs at most fifty copies
of the common local-spread base power. -/
theorem internalConflictLink_one_surviving_loss_le_fifty_base_of_finalGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (f : Finset V) (hfH : f ∈ H) (q : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (M : Hypergraph V) (hM : IsConflictFreeMatching H R.regularized M)
    (hfA : f ∈ availableEdges H R.regularized M)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
