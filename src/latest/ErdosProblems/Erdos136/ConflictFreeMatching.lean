theorem externalTestNaturalScale_pos_of_trackable
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta : ℝ}
    (hw : IsTrackable H C j ell d eta w) (hd : 0 < d) (s : ℕ) :
    0 < externalTestNaturalScale w H d j s := by
  unfold externalTestNaturalScale
  exact mul_pos
    ((Real.rpow_pos_of_pos hd ((j : ℝ) + eta)).trans_le hw.total_lower)
    (Real.rpow_pos_of_pos hd ((s : ℝ) - (j : ℝ)))

theorem externalTest_initial_errors_le_naturalDeviation
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j s : ℕ)
    (hw : ∀ S, 0 ≤ w S) (hsj : s ≤ j)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hd : 0 < d) (hGamma : 0 < Gamma) :
    let W := testTotal w H j
    let P := externalTestNaturalScale w H d j s
    externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ ≤
        -CFMNumericAggregation.testDeviation Gamma P d epsilon ∧
      externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ ≤
        -CFMNumericAggregation.testDeviation Gamma P d epsilon := by
  dsimp only
  let W := testTotal w H j
  let correction := Real.rpow d (-epsilon / 32) *
    (d ^ s / (4 * Gamma * d ^ j))
  have hW0 : 0 ≤ W := testTotal_nonneg hw H j
  have hcorr : correction ≤
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s 0 := by
    exact zeta_zero_correction_le D₂ D₃ D₄ Gamma epsilon d N
      j s hsj hd hGamma
  have hscaled : W * correction ≤
      W * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s 0 :=
    mul_le_mul_of_nonneg_left hcorr hW0
  have hdeviation :
      CFMNumericAggregation.testDeviation Gamma
          (externalTestNaturalScale w H d j s) d epsilon =
        W * correction := by
    have hid := core_initial_correction_eq_natural_deviation
      W Gamma d epsilon j s hd
    unfold CFMNumericAggregation.testDeviation externalTestNaturalScale
    dsimp only [W, correction]
    exact hid.symm
  have herr := externalTestErrors_initial_eq_neg_margin
    w H C D₂ D₃ D₄ Gamma epsilon d N hsj hCcard
  dsimp only at herr
  rw [hdeviation]
  constructor
  · rw [herr.1]
    linarith
  · rw [herr.2]
    linarith

/-- Package any already-closed natural-scale external source budgets with
the exact deterministic time-zero gaps and scale positivity.  The final
certificate constructor supplies `B`; no initial-error hypothesis remains. -/
theorem positivePairedFirstFailureSourceBudgets_of_externalNaturalScale
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N Pfloor : ℝ) (j s ell : ℕ)
    (jump variance : ℕ → ℝ)
    (hw : IsTrackable H C j ell d epsilon w)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hsj : s ≤ j)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hd : 0 < d) (hGamma : 0 < Gamma)
    (B : ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N Pfloor (testTotal w H j)
      j s jump variance) :
    CFMNumericAggregation.PositivePairedFirstFailureSourceBudgets
      (externalTestNaturalScale w H d j s)
      (ExternalTestSourceBudgets w H C Good T
        D₂ D₃ D₄ Gamma epsilon d N Pfloor (testTotal w H j)
        j s jump variance)
      (externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) j s 0 ∅)
      (externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) j s 0 ∅)
      (CFMNumericAggregation.testDeviation Gamma
        (externalTestNaturalScale w H d j s) d epsilon) := by
  have hgaps := externalTest_initial_errors_le_naturalDeviation
    w H C D₂ D₃ D₄ Gamma epsilon d N j s
      hw.isTestFunction.nonneg hsj hCcard hd hGamma
  exact
    { sourceBudgets := B
      upperGap := hgaps.1
      lowerGap := hgaps.2
      scale_pos := externalTestNaturalScale_pos_of_trackable hw hd s }

/-- Internal-link analogue.  The literal certificate layer center supplies
both strict positivity and the exact initial discrepancy, so an active-link
source package can be promoted without any extra gap premise. -/
theorem positivePairedFirstFailureSourceBudgets_of_internalNaturalScale
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ GammaCore epsilonCore N Pfloor : ℝ)
    (f : Finset V) (q s : ℕ) (jump variance : ℕ → ℝ)
    (hf : f ∈ H) (hq1 : 1 ≤ q) (hq3 : q ≤ 3) (hsq : s ≤ q)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    (hcore : epsilonCore = epsRaw / 5) (hGammaCore : 0 < GammaCore)
    (B : InternalConflictLinkSourceBudgets H R.regularized f Good T
      D₂ D₃ D₄ GammaCore epsilonCore d N Pfloor
      (certificateInternalLayerScale
        H C d epsRaw GammaCert ellCert j w R (q + 1))
      q s jump variance) :
    let scale := certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (q + 1)
    let P := scale * Real.rpow d ((s : ℝ) - (q : ℝ))
    CFMNumericAggregation.PositivePairedFirstFailureSourceBudgets P
      (InternalConflictLinkSourceBudgets H R.regularized f Good T
        D₂ D₃ D₄ GammaCore epsilonCore d N Pfloor scale
        q s jump variance)
      (internalConflictLinkUpperError H R.regularized f
        D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅)
      (internalConflictLinkLowerError H R.regularized f
        D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅)
      (CFMNumericAggregation.testDeviation GammaCore P d epsilonCore) := by
  dsimp only
  let scale := certificateInternalLayerScale
    H C d epsRaw GammaCert ellCert j w R (q + 1)
  have hscale : 0 < scale := certificateInternalLayerScale_pos
    H C d epsRaw GammaCert ellCert j w R (q + 1)
      (lt_of_lt_of_le zero_lt_one hd)
  have hP : 0 < scale * Real.rpow d ((s : ℝ) - (q : ℝ)) :=
    mul_pos hscale (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)
  have hgaps := certificateInternalConflictLink_initial_errors_le_naturalDeviation
    H C d epsRaw GammaCert ellCert j w R
      D₂ D₃ D₄ GammaCore epsilonCore N f hf q s
      hq1 hq3 hsq hd heps hcore hGammaCore
  have hdev :
      CFMNumericAggregation.testDeviation GammaCore
          (scale * Real.rpow d ((s : ℝ) - (q : ℝ))) d epsilonCore =
        (scale * Real.rpow d ((s : ℝ) - (q : ℝ))) *
          Real.rpow d (-epsilonCore / 32) / (4 * GammaCore) := by
    rfl
  rw [hdev]
  exact
    { sourceBudgets := B
      upperGap := hgaps.1
      lowerGap := hgaps.2
      scale_pos := hP }

namespace CFMSharpTestCutoff

/-- Literal sharp-test numerical window with every source error specialized.
The available-edge cardinal `a` enters only through its certified handshake
corridor; all remaining inequalities are consequences of the cutoff package. -/
theorem literalMeanWindow_numeric_of_registry
    {D₂ D₃ D₄ Gamma eta d N P W a : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P j s)
    (hW : 0 ≤ W) (ha0 : 0 ≤ a)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
          d N (k : ℝ)) ≤ a)
    (haHi : a ≤ CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (1 + CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
          d N (k : ℝ))) :
    (W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) +
        2 * (d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N))) * a ≤
      ((s + 1 : ℕ) : ℝ) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j (s + 1) (k : ℝ))) -
        8 * W * d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 10) -
        (s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ))) ∧
      ((s + 1 : ℕ) : ℝ) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j (s + 1) (k : ℝ))) -
        ((s : ℝ) * certificateTestStatusLo D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N (d ^ (1 - eta))
              (1536 * localSpreadPrimaryMargin eta d) k *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ))) -
          (((s.choose 2 * (4 *
              (64 * Nat.ceil (d ^ (1 - eta)) +
                16 * certificateMixedLossCapNat eta
                  (CFMRegularization.rawRegularizationEps eta) d +
                Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ) *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ))))) ≤
      (W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) -
        2 * (d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N))) * a := by
  let eps := CFMNumeric.coreEpsilon eta
  let x : ℝ := k
  let h := CFMTrajectories.hHat D₂ D₃ D₄ d N x
  let Z := CFMTrajectories.zHat D₂ D₃ D₄ d N j s x
  let Zp := CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) x
  let Env := CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j s x
  let Envp := CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j (s + 1) x
  let b := CFMTrajectories.cHat D₂ D₃ D₄ d N x +
    8 * CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let internal := degreeInternalCorridorError D₂ D₃ D₄ Gamma eps d N k
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma eps d N x
  let eHi := 8 * delta + internal
  let eLo := 8 * delta + 28 * d ^ (1 - eta) + internal +
    1536 * localSpreadPrimaryMargin eta d
  let gain := 8 * d ^ ((s : ℝ) + 1 - j -
    CFMRegularization.rawRegularizationEps eta / 10)
  let K : ℝ := ((s.choose 2 * (4 *
      (64 * Nat.ceil (d ^ (1 - eta)) +
        16 * certificateMixedLossCapNat eta
          (CFMRegularization.rawRegularizationEps eta) d +
        Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ)
  let loss := K * (Z + Env)
  let rem := d ^ ((s : ℝ) - j - eps) / N
  let scale := Gamma * Env / (N * CFMTrajectories.pV N x)
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end x hx)
  have hp1 := CFMTrajectories.pV_le_one R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have heps0 : 0 ≤ eps := by
    dsimp only [eps]
    rw [coreEpsilon_eq]
    linarith [E.eta_pos]
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      hd R.delta.degree.N_pos hp
  have hD := CFMTrajectories.dHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hp
  have hZ0 : 0 ≤ Z := by
    dsimp only [Z]
    unfold CFMTrajectories.zHat
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (CFMTrajectories.q_pos hp).le _))
      (pow_nonneg hm _)
  have hEnv0 : 0 ≤ Env := by
    dsimp only [Env, eps]
    exact (CFMTrajectories.zeta_pos hd (lt_of_lt_of_le zero_lt_one E.Gamma_one)
      hp hm R.s_le_j).le
  have hscale0 : 0 ≤ scale := by
    dsimp only [scale]
    exact div_nonneg (mul_nonneg hGamma0 hEnv0)
      (mul_nonneg R.delta.degree.N_pos.le hp.le)
  have hxi := (R.delta.xi_upper x hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have haLower : (4 / 5 : ℝ) * h ≤ a := by
    have hm := mul_le_mul_of_nonneg_left hxi hh.le
    dsimp only [h, x, eps] at haLo ⊢
    nlinarith
  have haUpper : a ≤ (6 / 5 : ℝ) * h := by
    have hm := mul_le_mul_of_nonneg_left hxi hh.le
    dsimp only [h, x, eps] at haHi ⊢
    nlinarith
  have hrate : h * CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x =
      ((s + 1 : ℕ) : ℝ) * Zp - (s : ℝ) * b * Z := by
    dsimp only [h, Z, Zp, b]
    exact CFMTrajectories.zHatRate_mul_hHat (ne_of_gt hh)
  have hmismatch : |(a - h) * CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x| ≤
      2000 * h * scale := by
    dsimp only [h, scale, Env, eps, x] at haLo haHi ⊢
    exact CFMTrajectories.zHatRate_handshake_mismatch_le R haLo haHi
  have hnextRaw := CFMTrajectories.zeta_successor_div_hHat_le
    (epsilon := eps) hd R.delta.degree.N_pos R.delta.degree.Gamma_one
    (R.delta.degree.time_nonneg x hx) (R.delta.degree.before_end x hx)
    R.delta.degree.D₂_nonneg R.delta.degree.D₃_nonneg R.delta.degree.D₄_nonneg
    R.s_le_j R.j_le_four
  have hnext : ((s + 1 : ℕ) : ℝ) * Envp ≤ 1280 * h * scale := by
    have hnext' := (div_le_iff₀ hh).mp hnextRaw
    dsimp only [Envp, h, scale, Env, x, eps]
    calc
      ((s + 1 : ℕ) : ℝ) *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta)
            d N j (s + 1) (k : ℝ) ≤
        (1280 * Gamma / (N * CFMTrajectories.pV N (k : ℝ)) *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)) *
              CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) := hnext'
      _ = _ := by ring
  have hs4 : (s : ℝ) ≤ 4 := by exact_mod_cast R.s_le_j.trans R.j_le_four
  have hb := CFMTrajectories.cHat_add_eight_dHat_le_fourteen R.delta.degree
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N x :=
    (CFMTrajectories.q_pos hp).le
  have hc0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N x := by
    unfold CFMTrajectories.cHat
    exact add_nonneg
      (add_nonneg
        (mul_nonneg R.delta.degree.D₂_nonneg hq0)
        (mul_nonneg
          (mul_nonneg (mul_nonneg (by norm_num) R.delta.degree.D₃_nonneg) hq0) hm))
      (mul_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) R.delta.degree.D₄_nonneg) hq0)
        (pow_nonneg hm _))
  have hb0 : 0 ≤ b := by
    dsimp only [b]
    exact add_nonneg hc0 (mul_nonneg (by norm_num) hD.le)
  have hid : h = N * CFMTrajectories.pV N x *
      CFMTrajectories.dHat D₂ D₃ D₄ d N x / 8 := by
    dsimp only [h]
    unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
    ring
  have hcurrent : (s : ℝ) * b * Env ≤ 500 * h * scale := by
    calc
      (s : ℝ) * b * Env ≤
          4 * (14 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x) * Env := by
        have hsMul : (s : ℝ) * b ≤ 4 * b :=
          mul_le_mul_of_nonneg_right hs4 hb0
        have hbMul : 4 * b ≤
            4 * (14 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x) :=
          mul_le_mul_of_nonneg_left (by simpa only [b, x] using hb) (by norm_num)
        exact mul_le_mul_of_nonneg_right (hsMul.trans hbMul) hEnv0
      _ ≤ 500 * h * scale := by
        rw [hid]
        dsimp only [scale]
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
        nlinarith [mul_nonneg (mul_nonneg hGamma0 hD.le) hEnv0]
  have hdelta0 : 0 ≤ delta := by
    dsimp only [delta, eps]
    exact (CFMTrajectories.delta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := CFMNumeric.coreEpsilon eta) hd hp).le
  have hz11 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := eps) (j := 1) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hz21 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := eps) (j := 2) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hz31 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := eps) (j := 3) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hinternal0 : 0 ≤ internal := by
    dsimp only [internal, degreeInternalCorridorError, x]
    exact add_nonneg
      (add_nonneg (mul_nonneg R.delta.degree.D₂_nonneg hz11)
        (mul_nonneg R.delta.degree.D₃_nonneg hz21))
      (mul_nonneg R.delta.degree.D₄_nonneg hz31)
  have heHi0 : 0 ≤ eHi := by dsimp only [eHi]; positivity
  have hpowEta0 : 0 ≤ d ^ (1 - eta) := Real.rpow_nonneg hd.le _
  have hmargin0 : 0 ≤ localSpreadPrimaryMargin eta d := by
    unfold localSpreadPrimaryMargin
    exact div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num)
  have heLo0 : 0 ≤ eLo := by
    dsimp only [eLo]
    exact add_nonneg
      (add_nonneg
        (add_nonneg (mul_nonneg (by norm_num) hdelta0)
          (mul_nonneg (by norm_num) hpowEta0))
        hinternal0)
      (mul_nonneg (by norm_num) hmargin0)
  have heHiBound : eHi ≤ 16 * Gamma * delta := by
    dsimp only [eHi, delta, internal, eps, x]
    exact statusHiError_le E R.delta
  have heLoBound : eLo ≤ 70 * Gamma * delta := by
    dsimp only [eLo, delta, internal, eps, x]
    exact statusLoError_le E S R.delta
  have hstatusHiCoeff : (s : ℝ) * eHi ≤ 500 * Gamma * delta := by
    calc
      (s : ℝ) * eHi ≤ 4 * eHi := mul_le_mul_of_nonneg_right hs4 heHi0
      _ ≤ 4 * (16 * Gamma * delta) := mul_le_mul_of_nonneg_left heHiBound (by norm_num)
      _ ≤ 500 * Gamma * delta := by
        nlinarith [mul_nonneg hGamma0 hdelta0]
  have hstatusHi : (s : ℝ) * eHi * (Z + Env) ≤ 5000 * h * scale := by
    simpa only [h, Z, Env, scale, delta, eps, x] using
      corridorProduct_le_commonScale S R
        (mul_nonneg (Nat.cast_nonneg _) heHi0) hstatusHiCoeff
  have hstatusLoCoeff : (s : ℝ) * eLo ≤ 500 * Gamma * delta := by
    calc
      (s : ℝ) * eLo ≤ 4 * eLo := mul_le_mul_of_nonneg_right hs4 heLo0
      _ ≤ 4 * (70 * Gamma * delta) := mul_le_mul_of_nonneg_left heLoBound (by norm_num)
      _ ≤ 500 * Gamma * delta := by
        nlinarith [mul_nonneg hGamma0 hdelta0]
  have hstatusLoSum : (s : ℝ) * eLo * (Z + Env) ≤ 5000 * h * scale := by
    simpa only [h, Z, Env, scale, delta, eps, x] using
      corridorProduct_le_commonScale S R
        (mul_nonneg (Nat.cast_nonneg _) heLo0) hstatusLoCoeff
  have hstatusLo : (s : ℝ) * eLo * (Z - Env) ≤ 5000 * h * scale := by
    calc
      (s : ℝ) * eLo * (Z - Env) ≤ (s : ℝ) * eLo * (Z + Env) := by
        have hcoef0 : 0 ≤ (s : ℝ) * eLo :=
          mul_nonneg (Nat.cast_nonneg s) heLo0
        apply mul_le_mul_of_nonneg_left _ hcoef0
        linarith
      _ ≤ _ := hstatusLoSum
  have hDlo := R.delta.dHat_lower x hx
  have hEnvlo := (CFMTrajectories.zeta_bounds_of_registry R hx).1
  have hraw : CFMRegularization.rawRegularizationEps eta = 5 * eps := by
    dsimp only [eps, CFMNumeric.coreEpsilon, CFMRegularization.rawRegularizationEps]
    ring
  have hgainPow : d ^ ((s : ℝ) + 1 - j -
        CFMRegularization.rawRegularizationEps eta / 10) ≤
      CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env := by
    have hexp : (s : ℝ) + 1 - j -
        CFMRegularization.rawRegularizationEps eta / 10 ≤
      (1 - eps / 32) + ((s : ℝ) - j - eps / 16) := by
      rw [hraw]
      linarith
    calc
      d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 10) ≤
        d ^ ((1 - eps / 32) + ((s : ℝ) - j - eps / 16)) :=
          Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one hexp
      _ = d ^ (1 - eps / 32) * d ^ ((s : ℝ) - j - eps / 16) :=
        Real.rpow_add hd _ _
      _ ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env :=
        mul_le_mul hDlo hEnvlo (Real.rpow_nonneg hd.le _) hD.le
  have hgain : gain ≤ 1000 * h * scale := by
    have hcoef : (8 : ℝ) ≤ 125 * Gamma := by
      calc
        (8 : ℝ) ≤ 125 := by norm_num
        _ = 125 * 1 := by ring
        _ ≤ 125 * Gamma := mul_le_mul_of_nonneg_left E.Gamma_one (by norm_num)
    have hgain8 : gain ≤
        8 * (CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env) := by
      dsimp only [gain]
      exact mul_le_mul_of_nonneg_left hgainPow (by norm_num)
    calc
      gain ≤ 8 * (CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env) := hgain8
      _ ≤ 125 * Gamma * (CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env) :=
        mul_le_mul_of_nonneg_right hcoef (mul_nonneg hD.le hEnv0)
      _ = 1000 * h * scale := by
        rw [hid]
        dsimp only [scale]
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
        ring
  have hK0 : 0 ≤ K := by dsimp only [K]; positivity
  have hKdelta : K ≤ delta := by
    dsimp only [K, delta, eps, x]
    exact lossCoefficient_le_delta E S R.delta R.s_le_j R.j_le_four
  have hKbound : K ≤ 500 * Gamma * delta := by
    have hdeltaGamma : delta ≤ Gamma * delta := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right E.Gamma_one hdelta0
    have hGammaDelta0 : 0 ≤ Gamma * delta := mul_nonneg hGamma0 hdelta0
    calc
      K ≤ delta := hKdelta
      _ ≤ Gamma * delta := hdeltaGamma
      _ = 1 * (Gamma * delta) := by ring
      _ ≤ 500 * (Gamma * delta) :=
        mul_le_mul_of_nonneg_right (by norm_num) hGammaDelta0
      _ = 500 * Gamma * delta := by ring
  have hloss : loss ≤ 5000 * h * scale := by
    dsimp only [loss]
    simpa only [h, Z, Env, scale, delta, eps, x] using
      corridorProduct_le_commonScale S R hK0 hKbound
  have hpowRem : d ^ ((s : ℝ) - j - eps) ≤ Env := by
    calc
      d ^ ((s : ℝ) - j - eps) ≤
          d ^ ((s : ℝ) - j - eps / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
        linarith
      _ ≤ Env := hEnvlo
  have hremScale : rem ≤ scale := by
    have hprod : CFMTrajectories.pV N x * d ^ ((s : ℝ) - j - eps) ≤
        Gamma * Env := by
      calc
        CFMTrajectories.pV N x * d ^ ((s : ℝ) - j - eps) ≤ 1 * Env :=
          mul_le_mul hp1 hpowRem (Real.rpow_nonneg hd.le _) (by norm_num)
        _ ≤ Gamma * Env := mul_le_mul_of_nonneg_right E.Gamma_one hEnv0
    dsimp only [rem, scale]
    calc
      d ^ ((s : ℝ) - j - eps) / N =
          (CFMTrajectories.pV N x * d ^ ((s : ℝ) - j - eps)) /
            (N * CFMTrajectories.pV N x) := by
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
      _ ≤ (Gamma * Env) / (N * CFMTrajectories.pV N x) :=
        div_le_div_of_nonneg_right hprod
          (mul_nonneg R.delta.degree.N_pos.le hp.le)
  have hrem : 2 * a * rem ≤ 1000 * h * scale := by
    have hrem0 : 0 ≤ rem := by
      dsimp only [rem]
      exact div_nonneg (Real.rpow_nonneg hd.le _) R.delta.degree.N_pos.le
    have htwoUpper0 : 0 ≤ 2 * ((6 / 5 : ℝ) * h) := by positivity
    have haTwo : 2 * a ≤ 2 * ((6 / 5 : ℝ) * h) :=
      mul_le_mul_of_nonneg_left haUpper (by norm_num)
    have hhs0 : 0 ≤ h * scale := mul_nonneg hh.le hscale0
    calc
      2 * a * rem ≤ 2 * ((6 / 5 : ℝ) * h) * scale :=
        mul_le_mul haTwo hremScale hrem0 htwoUpper0
      _ = (12 / 5 : ℝ) * (h * scale) := by ring
      _ ≤ 1000 * (h * scale) :=
        mul_le_mul_of_nonneg_right (by norm_num) hhs0
      _ = 1000 * h * scale := by ring
  have henvelopeRaw := CFMTrajectories.zetaRate_lower_of_registry R
  have henvelope : 40000 * scale ≤
      CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s x := by
    have h76000 : 76000 * scale ≤
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s x := by
      dsimp only [scale]
      convert henvelopeRaw using 1 <;> ring
    exact (mul_le_mul_of_nonneg_right
      (by norm_num : (40000 : ℝ) ≤ 76000) hscale0).trans h76000
  have hwindows := CFMSharpTestNumeric.meanWindow_numeric_of_source_errors
    hW hh ha0 hscale0 hZ0 hEnv0 heHi0 heLo0 haLower hrate hmismatch
      hnext hcurrent hstatusHi hstatusLo hgain hloss hrem henvelope
  dsimp only [Z, Zp, Env, Envp, b, eHi, eLo, gain, loss, K, rem, scale,
    delta, internal, h, eps, x] at hwindows
  unfold certificateTestStatusHi certificateTestStatusLo
  convert hwindows using 1 <;> ring_nf

end CFMSharpTestCutoff

