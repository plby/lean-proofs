  dsimp only [A] at hratio ⊢
  have hratioThree :
      (degree (availableEdges H R.regularized M) v.1 : ℝ) /
          ((availableEdges H R.regularized M).card : ℝ) < 3 / 4 := by
    have hscaled := mul_lt_mul_of_pos_left hu16
      (by norm_num : (0 : ℝ) < 3 / 4)
    have h12 : (12 : ℝ) < 3 / 4 * u := by
      calc
