      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d (N : ℝ) j w) k M := by
  exact indexedEnhancedRegularizedGreedyGood_old
    H C D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d (N : ℝ)
