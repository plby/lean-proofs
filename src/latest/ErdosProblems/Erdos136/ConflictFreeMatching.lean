/-! The availability input used above is automatic whenever the outer Good
predicate projects to the already-closed degree-enhanced Good family. -/

theorem localSpreadAvailableFloor_of_degreeEnhancedProjection
    [Fintype V] {iota I : Type*} [Fintype iota] [Fintype I]
    {eta GammaCore GammaCert d : ℝ} {T ell k : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (P : I → ℕ → Hypergraph V → Prop)
    (hproject : ∀ k M, indexedGreedyGood P k M →
      indexedGreedyGood
        (degreeEnhancedGreedyPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M)
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (degreeEnhancedGreedyPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hk : k < T) (M : Hypergraph V) (hgood : indexedGreedyGood P k M) :
    localSpreadAvailableFloor eta d ((vertexFinset H).card : ℝ) ≤
      ((availableEdges H R.regularized M).card : ℝ) := by
  have hdegreeGood := hproject k M hgood
  have hstep := hregistry k hk M hdegreeGood
  have hlocal := indexedDegreeEnhancedGood_local
    H R.regularized D₂ D₃ D₄ GammaCore eta d
      (vertexFinset H).card T j R.restrictedWeight hdegreeGood
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d ((vertexFinset H).card : ℝ) T hlocal
  have hold := indexedDegreeEnhancedGood_old
    H R.regularized D₂ D₃ D₄ GammaCore eta d
      (vertexFinset H).card T j R.restrictedWeight hdegreeGood
  have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
    H R.regularized D₂ D₃ D₄ GammaCore
      (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        j R.restrictedWeight hold
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hcovered : 8 * k ≤ (vertexFinset H).card := by
    have hb := hstep.degree.before_end (k : ℝ) hx
    exact_mod_cast hb.le
  exact localSpreadAvailableFloor_le_availableEdges_card S
    H R.regularized hH M hreach.1 (vertexFinset H).card k rfl
      hreach.2 hcovered hstep.degree.N_pos D₂ D₃ D₄ hstep hdegree

/-- Closed first-failure tail for one root-shadow component of the final
degree-plus-test Good family.  Availability, mean, and jump inputs are all
derived internally; the remaining hypotheses are precisely the static
weighted-spread profile and the already-standard delta registry. -/
theorem finiteWeightedRootShadowEnhancedFirstFailureMass_le
    [Fintype V] {iota Profile : Type*} [Fintype iota] [Fintype Profile]
    {eta GammaCore GammaCert d : ℝ} {T ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ)
    (hspread : ∀ b, IsWeightedRealSpread
      (X b) (a b) (familyRank b) (d₀ b) d⁻¹)
    (hrank : ∀ b, familyRank b ≤ 5)
    (hd₀ : ∀ b, 0 < d₀ b)
    (hzero : ∀ b (root : Hypergraph V), root ⊆ H →
      seed b ⊆ root → root.card ≤ activeRank b →
      weightedCodegree (X b) (a b) root ≤
        finiteWeightedRootShadowZeroScale d (d₀ b) root.card)
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (hT : (T : ℝ) ≤ ((vertexFinset H).card : ℝ))
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (degreeEnhancedGreedyPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    let P := finiteWeightedRootShadowEnhancedPredicate H R.regularized
      D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T
        j R.restrictedWeight familyRank activeRank seed X a d₀
    Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
        (greedyFirstFailureEvent H R.regularized ∅ T P (Sum.inr c)) ≤
      finiteWeightedRootShadowStrongTail eta d := by
  dsimp only
  apply finiteWeightedRootShadowFirstFailureMass_le E S
    H R.regularized familyRank activeRank seed X a d₀
    (finiteWeightedRootShadowEnhancedPredicate H R.regularized
      D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T
        j R.restrictedWeight familyRank activeRank seed X a d₀)
    (fun c ↦ Sum.inr c) hspread hrank hd₀ hzero hN hT
  · intro k hk M hgood
    exact localSpreadAvailableFloor_of_degreeEnhancedProjection S
      H C hH D₂ D₃ D₄ j w R
      (finiteWeightedRootShadowEnhancedPredicate H R.regularized
        D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T
          j R.restrictedWeight familyRank activeRank seed X a d₀)
      (fun k M hgood ↦
        indexedFiniteWeightedRootShadowEnhancedGood_degree
          H R.regularized D₂ D₃ D₄ GammaCore eta d
            (vertexFinset H).card T j R.restrictedWeight
              familyRank activeRank seed X a d₀ hgood)
      hregistry hk M hgood
  · intro c k M
    rfl

/-- Literal-certificate specialization of the previous theorem.  The
registry, horizon bound, and availability floor are reconstructed from the
specialized instance, so the public inputs are only the concrete static
profile proofs. -/
theorem literalCertificateFiniteWeightedRootShadowFirstFailureMass_le
    [Fintype V] {iota Profile : Type*} [Fintype iota] [Fintype Profile]
    {eta d : ℝ} {ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * (2 * (ell : ℝ) + 1)) d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ)
    (hspread : ∀ b, IsWeightedRealSpread
      (X b) (a b) (familyRank b) (d₀ b) d⁻¹)
    (hrank : ∀ b, familyRank b ≤ 5)
    (hd₀ : ∀ b, 0 < d₀ b)
    (hzero : ∀ b (root : Hypergraph V), root ⊆ H →
      seed b ⊆ root → root.card ≤ activeRank b →
      weightedCodegree (X b) (a b) root ≤
        finiteWeightedRootShadowZeroScale d (d₀ b) root.card)
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let Gamma : ℝ := 6 * (2 * (ell : ℝ) + 1)
    let N := (vertexFinset H).card
    let T := CFMNumericAggregation.targetTime eta d N
    let P := finiteWeightedRootShadowEnhancedPredicate H R.regularized
      D₂ D₃ D₄ Gamma eta d N T j R.restrictedWeight
        familyRank activeRank seed X a d₀
    Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
        (greedyFirstFailureEvent H R.regularized ∅ T P (Sum.inr c)) ≤
      finiteWeightedRootShadowStrongTail eta d := by
  dsimp only
  have hH : IsUniform H 8 := hinst.1
  have hT :
      ((CFMNumericAggregation.targetTime eta d (vertexFinset H).card : ℕ) : ℝ) ≤
        ((vertexFinset H).card : ℝ) :=
    CFMNumericAggregation.targetTime_cast_le_host E.eta_pos S hN
  apply finiteWeightedRootShadowEnhancedFirstFailureMass_le E S
    H C hH
    (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    j w R familyRank activeRank seed X a d₀ hspread hrank hd₀ hzero hN hT
  · intro k hk M hgood
    exact certificateLiteralDeltaStepRegistry H C d eta ell j w hinst R
      (vertexFinset H).card E S hN k hk

noncomputable def finiteWeightedRootShadowEnhancedLocalTail
    {iota Profile : Type*} {H : Hypergraph V} {j : iota → ℕ}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (eta d : ℝ) :
    FiniteWeightedRootShadowCoordinate H Profile activeRank seed → ℝ :=
  fun _ ↦ finiteWeightedRootShadowStrongTail eta d

theorem finiteWeightedRootShadowEnhancedLocalTail_sum_le_twelfth
    [Fintype V] {iota Profile : Type*} [Fintype iota] [Fintype Profile]
    {H : Hypergraph V} {j : iota → ℕ}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    {eta Gamma d K : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hK : K ≤ 2400)
    (hcard : (Fintype.card
      (FiniteWeightedRootShadowCoordinate H Profile activeRank seed) : ℝ) ≤
        Real.exp (K * Real.rpow d (eta ^ 3))) :
    (∑ c, finiteWeightedRootShadowEnhancedLocalTail
      (H := H) (j := j) (activeRank := activeRank) (seed := seed) eta d c) ≤
        1 / 12 := by
  exact finiteWeightedRootShadowStrongTailFamilySum_le_twelfth
    S (finiteWeightedRootShadowEnhancedLocalTail
      (H := H) (j := j) (activeRank := activeRank) (seed := seed) eta d)
      hK hcard (fun _ ↦ le_rfl)

def unitTestWeight : TestWeight V := fun _ ↦ 1

@[simp] theorem weightedCodegree_unitTestWeight
    (X : ConflictSystem V) (root : Hypergraph V) :
    weightedCodegree X (unitTestWeight (V := V)) root =
      (codegree X root : ℝ) := by
  simp [weightedCodegree, codegree, unitTestWeight]

theorem IsRealSpread.isWeightedRealSpread_unitTestWeight
    {X : ConflictSystem V} {q : ℕ} {d₀ delta : ℝ}
    (hX : IsRealSpread X q d₀ delta) :
    IsWeightedRealSpread X (unitTestWeight (V := V)) q d₀ delta := by
  refine ⟨hX.1, ?_, ?_⟩
  · intro U
    simp [unitTestWeight]
  · intro root hroot
    simpa only [weightedCodegree_unitTestWeight] using hX.2 root hroot

/-! The fixed available edge in an original-test jump has to be removed
from the static family before the generic weighted root-shadow hierarchy is
applied.  Keeping the original `j`-uniform family with a filtered weight
would make the legal root `{e}` lose a second factor of `d`, which is false.
The remainder family below is `(j-1)`-uniform and its root shadows are
exactly the fixed-`e` shadows used by the sharp pointwise gain/loss bounds. -/

def originalTestChoiceRemainderFamily
    (H : Hypergraph V) (j : ℕ) (e : Finset V) : ConflictSystem V :=
  (H.erase e).powersetCard (j - 1)

def originalTestChoiceRemainderWeight
    (w : TestWeight V) (e : Finset V) : TestWeight V :=
  fun R ↦ w (insert e R)

theorem originalTestChoiceRemainderFamily_uniform
    (H : Hypergraph V) (j : ℕ) (e : Finset V) :
    IsUniform (originalTestChoiceRemainderFamily H j e) (j - 1) := by
  intro R hR
  exact (Finset.mem_powersetCard.mp hR).2

theorem originalTestChoiceRemainderWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S) (e : Finset V) :
    ∀ R, 0 ≤ originalTestChoiceRemainderWeight w e R := by
  intro R
  exact hw (insert e R)

theorem weightedCodegree_originalTestChoiceRemainder_eq
    (w : TestWeight V) (H : Hypergraph V) (j : ℕ)
    (e : Finset V) (heH : e ∈ H) (hj : 1 ≤ j)
    (root : Hypergraph V) (heroot : e ∉ root) :
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root =
      weightedCodegree (H.powersetCard j) w (insert e root) := by
  unfold weightedCodegree originalTestChoiceRemainderFamily
    originalTestChoiceRemainderWeight
  symm
  refine Finset.sum_bij (fun S _hS ↦ S.erase e) ?_ ?_ ?_ ?_
  · intro S hS
    have hdata := Finset.mem_filter.mp hS
    have hSsub : S ⊆ H := (Finset.mem_powersetCard.mp hdata.1).1
    have hScard : S.card = j := (Finset.mem_powersetCard.mp hdata.1).2
    have heS : e ∈ S := hdata.2 (Finset.mem_insert_self e root)
    apply Finset.mem_filter.mpr
    constructor
    · apply Finset.mem_powersetCard.mpr
      constructor
      · exact Finset.erase_subset_erase e hSsub
      · rw [Finset.card_erase_of_mem heS, hScard]
    · intro x hx
      exact Finset.mem_erase.mpr ⟨fun hxe ↦ heroot (hxe ▸ hx),
        hdata.2 (Finset.mem_insert_of_mem hx)⟩
  · intro S₁ hS₁ S₂ hS₂ heq
    have heS₁ : e ∈ S₁ :=
      (Finset.mem_filter.mp hS₁).2 (Finset.mem_insert_self e root)
    have heS₂ : e ∈ S₂ :=
      (Finset.mem_filter.mp hS₂).2 (Finset.mem_insert_self e root)
    rw [← Finset.insert_erase heS₁, ← Finset.insert_erase heS₂, heq]
  · intro R hR
    have hdata := Finset.mem_filter.mp hR
    have hRsub : R ⊆ H.erase e := (Finset.mem_powersetCard.mp hdata.1).1
    have hRcard : R.card = j - 1 := (Finset.mem_powersetCard.mp hdata.1).2
    have heR : e ∉ R := fun heR ↦
      (Finset.notMem_erase e H) (hRsub heR)
    refine ⟨insert e R, ?_, ?_⟩
    · apply Finset.mem_filter.mpr
      constructor
      · apply Finset.mem_powersetCard.mpr
        constructor
        · intro x hx
          rcases Finset.mem_insert.mp hx with rfl | hxR
          · exact heH
          · exact Finset.erase_subset e H (hRsub hxR)
        · rw [Finset.card_insert_of_notMem heR, hRcard]
          omega
      · intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hxroot
        · exact Finset.mem_insert_self x R
        · exact Finset.mem_insert_of_mem (hdata.2 hxroot)
    · exact Finset.erase_insert heR
  · intro S hS
    have heS : e ∈ S :=
      (Finset.mem_filter.mp hS).2 (Finset.mem_insert_self e root)
    rw [Finset.insert_erase heS]

theorem weightedCodegree_originalTestChoiceRemainder_eq_zero_of_mem
    (w : TestWeight V) (H : Hypergraph V) (j : ℕ)
    (e : Finset V) (root : Hypergraph V) (heroot : e ∈ root) :
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root = 0 := by
  unfold weightedCodegree originalTestChoiceRemainderFamily
  apply Finset.sum_eq_zero
  intro R hR
  exfalso
  have hdata := Finset.mem_filter.mp hR
  exact (Finset.notMem_erase e H)
    ((Finset.mem_powersetCard.mp hdata.1).1 (hdata.2 heroot))

theorem originalTestChoice_emptyRootShadow_eq
    (w : TestWeight V) (H : Hypergraph V) (j : ℕ)
    (e : Finset V) (heH : e ∈ H) (hj : 1 ≤ j) :
    weightedConflictFamilyRootShadowWeight
        (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) ∅ =
      originalTestRootShadowWeight w H j e := by
  funext root
  by_cases heroot : e ∈ root
  · simp [originalTestRootShadowWeight,
      weightedConflictFamilyRootShadowWeight, heroot,
      weightedCodegree_originalTestChoiceRemainder_eq_zero_of_mem]
  · simp [originalTestRootShadowWeight,
      weightedConflictFamilyRootShadowWeight, heroot,
      weightedCodegree_originalTestChoiceRemainder_eq
        w H j e heH hj root heroot]

theorem testTotal_originalTestChoice_emptyRootShadow_eq
    (w : TestWeight V) (H M : Hypergraph V) (j n : ℕ)
    (e : Finset V) (heH : e ∈ H) (hj : 1 ≤ j) :
    testTotal
        (weightedConflictFamilyRootShadowWeight
          (originalTestChoiceRemainderFamily H j e)
          (originalTestChoiceRemainderWeight w e) ∅) M n =
      testTotal (originalTestRootShadowWeight w H j e) M n := by
  rw [originalTestChoice_emptyRootShadow_eq w H j e heH hj]

theorem originalTestChoice_extension_scale_identity
    (W d eta : ℝ) (m : ℕ) (hd : 0 < d) :
    W / Real.rpow d ((m : ℝ) + 1 + eta) =
      W * Real.rpow d (-1 - eta) * (d⁻¹) ^ m := by
  calc
    W / Real.rpow d ((m : ℝ) + 1 + eta) =
        W * Real.rpow d (-((m : ℝ) + 1 + eta)) := by
      rw [div_eq_mul_inv]
      congr 1
      exact (Real.rpow_neg hd.le _).symm
    _ = W * (Real.rpow d (-1 - eta) *
          Real.rpow d (-(m : ℝ))) := by
      have hexp : -((m : ℝ) + 1 + eta) =
          (-1 - eta) + (-(m : ℝ)) := by ring
      rw [hexp]
      congr 1
      exact Real.rpow_add hd _ _
    _ = W * Real.rpow d (-1 - eta) * (d⁻¹) ^ m := by
      have hinvPow : d⁻¹ ^ m = Real.rpow d (-(m : ℝ)) := by
        calc
          d⁻¹ ^ m = (d ^ m)⁻¹ := inv_pow d m
          _ = (Real.rpow d (m : ℝ))⁻¹ := by
            exact congrArg Inv.inv (Real.rpow_natCast d m).symm
          _ = Real.rpow d (-(m : ℝ)) :=
            (Real.rpow_neg hd.le _).symm
      rw [hinvPow]
      ring

/-- Strict-root spread for a fixed original-test choice.  The scale includes
the test-weight bound `ell`, because the generic hierarchy also uses the
same scale at its selected-rank-zero full-root children. -/
theorem originalTestChoiceRemainder_isWeightedRealSpread_of_trackable
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d eta w)
    (hd : 1 ≤ d) (heta : 0 ≤ eta) (hell : 1 ≤ ell)
    (e : Finset V) (heH : e ∈ H) (hj : 1 ≤ j) :
    IsWeightedRealSpread
      (originalTestChoiceRemainderFamily H j e)
      (originalTestChoiceRemainderWeight w e) (j - 1)
      ((ell : ℝ) * testTotal w H j * Real.rpow d (-1 - eta)) d⁻¹ := by
  refine ⟨originalTestChoiceRemainderFamily_uniform H j e,
    originalTestChoiceRemainderWeight_nonneg hw.isTestFunction.nonneg e, ?_⟩
  intro root hroot
  by_cases hrootHost : root ⊆ H.erase e
  · have heroot : e ∉ root := fun heroot ↦
      (Finset.notMem_erase e H) (hrootHost heroot)
    have hrootSucc : root.card + 1 < j := by omega
    have hrootCard : (insert e root).card = root.card + 1 := by
      rw [Finset.card_insert_of_notMem heroot]
    have hrootSub : insert e root ⊆ H := by
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hxroot
      · exact heH
      · exact Finset.erase_subset e H (hrootHost hxroot)
    have hext := hw.extension_upper (Nat.succ_le_succ (Nat.zero_le root.card))
      hrootSucc (insert e root) hrootSub hrootCard
    have hbase :
        weightedCodegree (originalTestChoiceRemainderFamily H j e)
            (originalTestChoiceRemainderWeight w e) root ≤
          testTotal w H j * Real.rpow d (-1 - eta) * (d⁻¹) ^ root.card := by
      rw [weightedCodegree_originalTestChoiceRemainder_eq
        w H j e heH hj root heroot]
      exact hext.trans_eq
        (by
          simpa only [Nat.cast_succ, Nat.cast_one, add_assoc] using
            originalTestChoice_extension_scale_identity
              (testTotal w H j) d eta root.card (by linarith))
    have hbase0 : 0 ≤
        testTotal w H j * Real.rpow d (-1 - eta) * (d⁻¹) ^ root.card := by
      exact mul_nonneg
        (mul_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
          (Real.rpow_nonneg (by linarith) _))
        (pow_nonneg (inv_nonneg.mpr (by linarith)) _)
    calc
      weightedCodegree (originalTestChoiceRemainderFamily H j e)
          (originalTestChoiceRemainderWeight w e) root ≤
          testTotal w H j * Real.rpow d (-1 - eta) *
            (d⁻¹) ^ root.card := hbase
      _ ≤ ((ell : ℝ) * testTotal w H j * Real.rpow d (-1 - eta)) *
            (d⁻¹) ^ root.card := by
        have hellR : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
        nlinarith
  · have hempty :
        (originalTestChoiceRemainderFamily H j e).filter (root ⊆ ·) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro R hR hrootR
      exact hrootHost (hrootR.trans
        (Finset.mem_powersetCard.mp hR).1)
    rw [weightedCodegree, hempty]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (Nat.cast_nonneg ell)
          (testTotal_nonneg hw.isTestFunction.nonneg H j))
        (Real.rpow_nonneg (by linarith) _))
      (pow_nonneg (inv_nonneg.mpr (by linarith)) _)

theorem originalTestChoiceRemainder_fullRoot_le_ell
    {H : Hypergraph V} {j ell : ℕ} {w : TestWeight V}
    (hw : IsTestFunction H j ell w)
    (e : Finset V) (root : Hypergraph V) (hroot : root.card = j - 1) :
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root ≤ (ell : ℝ) := by
  let F := (originalTestChoiceRemainderFamily H j e).filter (root ⊆ ·)
  have hFcard : F.card ≤ 1 := by
    change codegree (originalTestChoiceRemainderFamily H j e) root ≤ 1
    exact codegree_le_one_of_uniform_of_card_eq
      (originalTestChoiceRemainderFamily_uniform H j e) root hroot
  calc
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root =
        ∑ R ∈ F, originalTestChoiceRemainderWeight w e R := by rfl
    _ ≤ ∑ _R ∈ F, (ell : ℝ) := by
      apply Finset.sum_le_sum
      intro R hR
      exact hw.2.1 (insert e R)
    _ = (F.card : ℝ) * (ell : ℝ) := by simp
    _ ≤ (1 : ℝ) * (ell : ℝ) := by
      apply mul_le_mul_of_nonneg_right
      · exact_mod_cast hFcard
      · positivity
    _ = (ell : ℝ) := one_mul _

theorem originalTestChoiceRemainder_fullRoot_le_scale
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d eta w)
    (hd : 1 ≤ d) (hell : 1 ≤ ell) (hj : 1 ≤ j)
    (e : Finset V) (root : Hypergraph V) (hroot : root.card = j - 1) :
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root ≤
      ((ell : ℝ) * testTotal w H j * Real.rpow d (-1 - eta)) *
        (d⁻¹) ^ (j - 1) := by
  have hweight := originalTestChoiceRemainder_fullRoot_le_ell
    hw.isTestFunction e root hroot
  have hscaleOne : 1 ≤
      testTotal w H j * Real.rpow d (-1 - eta) * (d⁻¹) ^ (j - 1) := by
    have hlower := hw.total_lower
    have hid : testTotal w H j / Real.rpow d ((j : ℝ) + eta) =
        testTotal w H j * Real.rpow d (-1 - eta) * (d⁻¹) ^ (j - 1) := by
      have hm : (j - 1) + 1 = j := by omega
      have hmR : ((j - 1 : ℕ) : ℝ) + 1 = (j : ℝ) := by exact_mod_cast hm
      simpa only [hmR] using originalTestChoice_extension_scale_identity
        (testTotal w H j) d eta (j - 1) (by linarith)
    rw [← hid]
    apply (le_div_iff₀ (Real.rpow_pos_of_pos (by linarith) _)).2
    simpa using hlower
  have hell0 : 0 ≤ (ell : ℝ) := by positivity
  calc
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root ≤ (ell : ℝ) := hweight
    _ ≤ (ell : ℝ) *
        (testTotal w H j * Real.rpow d (-1 - eta) * (d⁻¹) ^ (j - 1)) := by
      nlinarith
    _ = ((ell : ℝ) * testTotal w H j * Real.rpow d (-1 - eta)) *
        (d⁻¹) ^ (j - 1) := by ring

/-- The exact all-root endpoint consumed by the finite root-shadow
hierarchy.  Strict roots use trackability, and the unique full-root branch
uses the pointwise test-weight bound. -/
theorem originalTestChoiceRemainder_root_le_scale
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d eta w)
    (hd : 1 ≤ d) (heta : 0 ≤ eta) (hell : 1 ≤ ell)
    (e : Finset V) (heH : e ∈ H) (hj : 1 ≤ j)
    (root : Hypergraph V) (hroot : root.card ≤ j - 1) :
    weightedCodegree (originalTestChoiceRemainderFamily H j e)
        (originalTestChoiceRemainderWeight w e) root ≤
      ((ell : ℝ) * testTotal w H j * Real.rpow d (-1 - eta)) *
        (d⁻¹) ^ root.card := by
  by_cases hstrict : root.card < j - 1
  · exact (originalTestChoiceRemainder_isWeightedRealSpread_of_trackable
      hw hd heta hell e heH hj).2.2 root hstrict
  · have hfull : root.card = j - 1 := by omega
    simpa only [hfull] using
      originalTestChoiceRemainder_fullRoot_le_scale
        hw hd hell hj e root hfull

namespace CFMSharpTestCutoff

theorem certificateTestStatusHi_le_eighteenGamma_mul_d
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P) :
    certificateTestStatusHi D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N k ≤ 18 * Gamma * d := by
  let x : ℝ := k
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N x
  let internal := degreeInternalCorridorError D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N k
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.degree.d_one
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hp := CFMTrajectories.pV_pos R.degree.N_pos
    (R.degree.before_end x hx)
  have hp1 := CFMTrajectories.pV_le_one R.degree.N_pos
    (R.degree.time_nonneg x hx)
  have hm := CFMTrajectories.pM_nonneg hd R.degree.N_pos
    (R.degree.time_nonneg x hx)
  have hGammaHat0 : 0 ≤ CFMTrajectories.GammaHat D₂ D₃ D₄ d N x := by
    unfold CFMTrajectories.GammaHat
    exact add_nonneg
      (add_nonneg
        (mul_nonneg R.degree.D₂_nonneg hm)
        (mul_nonneg R.degree.D₃_nonneg (pow_nonneg hm _)))
      (mul_nonneg R.degree.D₄_nonneg (pow_nonneg hm _))
  have hD0 : 0 ≤ D := by
    dsimp only [D]
    exact (CFMTrajectories.dHat_pos hd hp).le
  have hDle : D ≤ d := by
    dsimp only [D]
    exact CFMTrajectories.dHat_le_d hd.le hp.le hp1 hGammaHat0
  have hxi := (R.xi_upper x hx).trans (CFMNumeric.envelopeFactor_le_fifth S)
  have hdeltaD : delta ≤ D / 5 := by
    dsimp only [delta, D]
    unfold CFMTrajectories.delta
    have hm := mul_le_mul_of_nonneg_right hxi hD0
    nlinarith
  have hb := CFMTrajectories.cHat_add_eight_dHat_le_fourteen R.degree
  have herr : 8 * delta + internal ≤ 16 * Gamma * delta := by
    dsimp only [delta, internal, x]
    exact statusHiError_le E R
  have hstatusD : certificateTestStatusHi D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N k ≤ 18 * Gamma * D := by
    unfold certificateTestStatusHi
    dsimp only [D, delta, internal, x] at hb herr hdeltaD ⊢
    have herrD :
        16 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N (k : ℝ) ≤
          (16 / 5) * Gamma *
            CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) := by
      have hm := mul_le_mul_of_nonneg_left hdeltaD
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 16) hG0)
      nlinarith
    nlinarith
  calc
    certificateTestStatusHi D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N k ≤ 18 * Gamma * D := hstatusD
    _ ≤ 18 * Gamma * d :=
      mul_le_mul_of_nonneg_left hDle (mul_nonneg (by norm_num) hG0)

/-- The literal coefficient in the residual original-test spread profile is
absorbed by the existing correction-denominator cutoff.  Squaring that cutoff
actually gives the stronger exponent `rawRegularizationEps eta / 160`; the
displayed `/ 10` is the source-facing scale used by the static profile. -/
theorem residualSpreadCoefficient_le_rawTenth
    {eta d : ℝ} (ell : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d) :
    72 * (3 * (2 * (ell : ℝ) + 1) + 1) * (ell : ℝ) ≤
      d ^ (CFMRegularization.rawRegularizationEps eta / 10) := by
  let G : ℝ := 2 * (ell : ℝ) + 1
  let epsRaw := CFMRegularization.rawRegularizationEps eta
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hG0 : 0 ≤ G := by
    dsimp only [G]
    positivity
  have hell0 : 0 ≤ (ell : ℝ) := Nat.cast_nonneg ell
  have heps0 : 0 ≤ epsRaw := by
    dsimp only [epsRaw, CFMRegularization.rawRegularizationEps]
    linarith [E.eta_pos]
  have hcorr : 24 * G ≤ d ^ (epsRaw / 320) := by
    have h := S.correctionDenominator
    change 24 * G ≤ d ^ (epsRaw / 320)
    convert h using 1
    · dsimp only [G]
      ring
    · congr 1
      dsimp only [epsRaw, CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      ring
  have hcorr0 : 0 ≤ 24 * G := mul_nonneg (by norm_num) hG0
  have hpow0 : 0 ≤ d ^ (epsRaw / 320) := Real.rpow_nonneg hd.le _
  have hsq : (24 * G) ^ 2 ≤ (d ^ (epsRaw / 320)) ^ 2 :=
    (sq_le_sq₀ hcorr0 hpow0).2 hcorr
  have hcoeff :
      72 * (3 * G + 1) * (ell : ℝ) ≤ (24 * G) ^ 2 := by
    dsimp only [G]
    nlinarith
  calc
    72 * (3 * (2 * (ell : ℝ) + 1) + 1) * (ell : ℝ) ≤
        (24 * G) ^ 2 := by simpa only [G] using hcoeff
    _ ≤ (d ^ (epsRaw / 320)) ^ 2 := hsq
    _ = d ^ (epsRaw / 160) := by
      rw [pow_two, ← Real.rpow_add hd]
      congr 1
      ring
    _ ≤ d ^ (epsRaw / 10) := by
      apply Real.rpow_le_rpow_of_exponent_le
        (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
      linarith

end CFMSharpTestCutoff

theorem weightedTestLossCCMass_le_legalRerootedCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s ccHi : ℕ)
    (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hconflictFreePos : ∀ S ∈ H.powersetCard j,
      0 < w S → ∀ c ∈ C, ¬c ⊆ S)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hreroot : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, g ≠ f → Disjoint f g →
        {f, g} ∉ conflictLayer C 2 →
        (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
            (availableEdges H C M) M 1).card) ≤ ccHi) :
    weightedTestLossCCMass w H C M j s ≤
      (((s.choose 2 * (4 * ccHi) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossCCMass testLossCCMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s ccHi (blockerPairCC H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  have hfg : Disjoint f g :=
    (hmatchingPos S hS hpos).2
      (Finset.inter_subset_left hf) (Finset.inter_subset_left hg) hgf.symm
  have hpair : {f, g} ∉ conflictLayer C 2 := by
    intro hpair
    have hpairC : ({f, g} : Hypergraph V) ∈ C :=
      (Finset.mem_filter.mp hpair).1
    apply hconflictFreePos S hS hpos {f, g} hpairC
    intro x hx
    rcases Finset.mem_insert.mp hx with rfl | hx
    · exact Finset.inter_subset_left hf
    · have hxg : x = g := Finset.mem_singleton.mp hx
      subst x
      exact Finset.inter_subset_left hg
  exact (blockerPairCC_le_rerootedPartialMass hCcard hfA hgA).trans
    (hreroot f hfA g hgA hgf hfg hpair)

theorem weightedPartialTestLossCollision_le_legalPairAggregateCaps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s codegreeHi mixedHi ccHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hconflictFreePos : ∀ S ∈ H.powersetCard j,
      0 < w S → ∀ c ∈ C, ¬c ⊆ S)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, Disjoint f g → ∀ v ∈ g,
        CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card ≤ mixedHi)
    (hreroot : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, g ≠ f → Disjoint f g →
        {f, g} ∉ conflictLayer C 2 →
        (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
            (availableEdges H C M) M 1).card) ≤ ccHi) :
    weightedPartialTestLossCollision w H C M j s ≤
      (((s.choose 2 *
          (4 * (64 * codegreeHi + 16 * mixedHi + ccHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  have hHne : ∀ e ∈ H, e.Nonempty := by
    intro e he
    exact Finset.card_pos.mp (by rw [hH8 e he]; norm_num)
  have hsplit := weightedPartialTestLossCollision_le_sharpFourParts
    (w := w) (H := H) (C := C) (M := M) (j := j) (s := s) hw hHne
  have hmm := weightedTestLossMMMass_le_codegreeCap
    w H C M j s codegreeHi hH8 hw hmatchingPos hcodegree
  have hmc := weightedTestLossMCMass_le_pairMixedCap
    w H C M j s mixedHi hH8 hw hmatchingPos hCcard hmixed
  have hcm := weightedTestLossCMMass_le_pairMixedCap
    w H C M j s mixedHi hH8 hw hmatchingPos hCcard hmixed
  have hcc := weightedTestLossCCMass_le_legalRerootedCap
    w H C M j s ccHi hw hmatchingPos hconflictFreePos hCcard hreroot
  calc
    weightedPartialTestLossCollision w H C M j s ≤
        weightedTestLossMMMass w H C M j s +
          weightedTestLossMCMass w H C M j s +
          weightedTestLossCMMass w H C M j s +
          weightedTestLossCCMass w H C M j s := hsplit
    _ ≤ (((s.choose 2 * (4 * (64 * codegreeHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * ccHi) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) := by
      exact add_le_add (add_le_add (add_le_add hmm hmc) hcm) hcc
    _ = (((s.choose 2 *
          (4 * (64 * codegreeHi + 16 * mixedHi + ccHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
      push_cast
      ring

theorem gainCollisionResidualRepresentation_exists_f0Truncated
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e f₀ : Finset V} {j s : ℕ} {w : TestWeight V}
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hf₀A : f₀ ∈ availableEdges H C M)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition
      (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    ∃ f c r,
      r ∈ Finset.Icc 2 5 ∧
      e ∈ S ∧ f ∈ S.erase e ∧
      e ∈ availableEdges H C M ∧
      f ∈ availableEdges H C M ∧
      c ∈ C ∧ e ∈ c ∧ f ∈ c ∧
      (S ∪ c).card = r ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r)
          (availableEdges H C M) M (s - 1) ∧
      IsF0TruncatedGainCollisionResidual H C f₀
        (gainCollisionResidualConflict c e f) := by
  obtain ⟨heSA, f, hfSA, hfe, heBlock⟩ :=
    mem_testGainCollisionChoiceSet.mp heCollision
  have heS : e ∈ S := Finset.inter_subset_left heSA
  have heA : e ∈ availableEdges H C M :=
    Finset.inter_subset_right heSA
  have hfS : f ∈ S := Finset.inter_subset_left hfSA
  have hfA : f ∈ availableEdges H C M :=
    Finset.inter_subset_right hfSA
  have hSMatching : IsMatching H S := hmatchingPos S hS hwS
  have hefDisjoint : Disjoint e f :=
    hSMatching.2 heS hfS (Ne.symm hfe)
  have heBlock' := Finset.mem_filter.mp heBlock
  have hnotAdmissible :
      ¬IsConflictFreeMatching H C (insert e (insert f M)) := by
    rcases heBlock'.2 with heq | hnot
    · exact False.elim (hfe heq.symm)
    · exact hnot
  have hmatchingEF : IsMatching H (insert e (insert f M)) := by
    rw [isMatching_insert_iff]
    refine ⟨(mem_availableEdges.mp heA).1,
      (mem_availableEdges.mp hfA).2.2.1, ?_⟩
    intro g hg hge
    rcases Finset.mem_insert.mp hg with rfl | hgM
    · exact hefDisjoint
    · exact (isMatching_insert_iff.mp
        (mem_availableEdges.mp heA).2.2.1).2.2 g hgM hge
  have hbad : ¬ConflictFree C (insert f (insert e M)) := by
    intro hfree
    apply hnotAdmissible
    refine ⟨hmatchingEF, ?_⟩
    simpa [Finset.insert_comm e f] using hfree
  obtain ⟨c, hcC, hec, hfc, hcsub, _hUsub⟩ :=
    gainCollisionResidualCertificate_exists
      (S := S) heA hfA (Ne.symm hfe) hbad
  let r := (S ∪ c).card
  have hpartial := gainCollisionResidualUnion_mem_partial_and_f0Truncated
    hS hcoord heS hfS heA hfA hf₀A (Ne.symm hfe)
      hcC hec hfc hcsub hMH
  have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hinterTwo : 2 ≤ (S ∩ c).card := by
    have hsub : {e, f} ⊆ S ∩ c := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact Finset.mem_inter.mpr ⟨heS, hec⟩
      · exact Finset.mem_inter.mpr ⟨hfS, hfc⟩
    have hcard := Finset.card_le_card hsub
    have hpairCard : ({e, f} : Hypergraph V).card = 2 := by
      simp [Ne.symm hfe]
    rw [hpairCard] at hcard
    exact hcard
  have hUnionCard := Finset.card_union_add_card_inter S c
  have hrTwo : 2 ≤ r := by
    have hsub : {e, f} ⊆ S ∪ c := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact Finset.mem_union.mpr (Or.inl heS)
      · exact Finset.mem_union.mpr (Or.inl hfS)
    have hcard := Finset.card_le_card hsub
    have hpairCard : ({e, f} : Hypergraph V).card = 2 := by
      simp [Ne.symm hfe]
    rw [hpairCard] at hcard
    simpa only [r] using hcard
  have hrFive : r ≤ 5 := by
    have hcFour := (hCcard c hcC).2
    dsimp only [r]
    rw [hScard] at hUnionCard
    omega
  refine ⟨f, c, r, Finset.mem_Icc.mpr ⟨hrTwo, hrFive⟩,
    heS, ?_, heA, hfA, hcC, hec, hfc, rfl, ?_, hpartial.2.2⟩
  · exact Finset.mem_erase.mpr ⟨hfe, hfS⟩
  · simpa only [r] using hpartial.2.1

def f0TruncatedGainCollisionResidualRepresentationCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) : ℝ :=
  if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      IsF0TruncatedGainCollisionResidual H C f₀
        (gainCollisionResidualConflict c e f) ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t
  then w S else 0

def f0TruncatedGainCollisionResidualRankCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) : ℝ :=
  ∑ r ∈ Finset.Icc 2 5,
    f0TruncatedGainCollisionResidualRepresentationCharge
      w H C f₀ j r A M t S e f c

def f0TruncatedGainCollisionResidualConflictCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) : ℝ :=
  ∑ c ∈ C,
    f0TruncatedGainCollisionResidualRankCharge
      w H C f₀ j A M t S e f c

def f0TruncatedGainCollisionResidualPairCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e : Finset V) : ℝ :=
  ∑ f ∈ S.erase e,
    f0TruncatedGainCollisionResidualConflictCharge
      w H C f₀ j A M t S e f

theorem f0TruncatedGainCollisionResidualRepresentationCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (j r : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) :
    0 ≤ f0TruncatedGainCollisionResidualRepresentationCharge
      w H C f₀ j r A M t S e f c := by
  unfold f0TruncatedGainCollisionResidualRepresentationCharge
  split
  · exact hw0 S
  · norm_num

theorem f0TruncatedGainCollisionResidualRankCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) :
    0 ≤ f0TruncatedGainCollisionResidualRankCharge
      w H C f₀ j A M t S e f c := by
  unfold f0TruncatedGainCollisionResidualRankCharge
  exact Finset.sum_nonneg fun r _ ↦
    f0TruncatedGainCollisionResidualRepresentationCharge_nonneg
      hw0 H C f₀ j r A M t S e f c

theorem f0TruncatedGainCollisionResidualConflictCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) :
    0 ≤ f0TruncatedGainCollisionResidualConflictCharge
      w H C f₀ j A M t S e f := by
  unfold f0TruncatedGainCollisionResidualConflictCharge
  exact Finset.sum_nonneg fun c _ ↦
    f0TruncatedGainCollisionResidualRankCharge_nonneg
      hw0 H C f₀ j A M t S e f c

theorem f0TruncatedGainCollisionResidualPairCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e : Finset V) :
    0 ≤ f0TruncatedGainCollisionResidualPairCharge
      w H C f₀ j A M t S e := by
  unfold f0TruncatedGainCollisionResidualPairCharge
  exact Finset.sum_nonneg fun f _ ↦
    f0TruncatedGainCollisionResidualConflictCharge_nonneg
      hw0 H C f₀ j A M t S e f

theorem testWeight_le_f0TruncatedGainCollisionResidualPairCharge
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) (r : ℕ)
    (hfS : f ∈ S.erase e) (hcC : c ∈ C) (hr : r ∈ Finset.Icc 2 5)
    (hrep : e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      IsF0TruncatedGainCollisionResidual H C f₀
        (gainCollisionResidualConflict c e f) ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t) :
    w S ≤ f0TruncatedGainCollisionResidualPairCharge
      w H C f₀ j A M t S e := by
  have heq : f0TruncatedGainCollisionResidualRepresentationCharge
      w H C f₀ j r A M t S e f c = w S := by
    simp [f0TruncatedGainCollisionResidualRepresentationCharge, hrep]
  have hrank : w S ≤ f0TruncatedGainCollisionResidualRankCharge
      w H C f₀ j A M t S e f c := by
    calc
      w S = f0TruncatedGainCollisionResidualRepresentationCharge
          w H C f₀ j r A M t S e f c := heq.symm
      _ ≤ f0TruncatedGainCollisionResidualRankCharge
          w H C f₀ j A M t S e f c := by
        unfold f0TruncatedGainCollisionResidualRankCharge
        exact Finset.single_le_sum
          (fun r' _ ↦
            f0TruncatedGainCollisionResidualRepresentationCharge_nonneg
              hw0 H C f₀ j r' A M t S e f c) hr
  have hconflict : w S ≤
      f0TruncatedGainCollisionResidualConflictCharge
        w H C f₀ j A M t S e f := by
    apply hrank.trans
    unfold f0TruncatedGainCollisionResidualConflictCharge
    exact Finset.single_le_sum
      (fun c' _ ↦ f0TruncatedGainCollisionResidualRankCharge_nonneg
        hw0 H C f₀ j A M t S e f c') hcC
  apply hconflict.trans
  unfold f0TruncatedGainCollisionResidualPairCharge
  exact Finset.single_le_sum
    (fun f' _ ↦ f0TruncatedGainCollisionResidualConflictCharge_nonneg
      hw0 H C f₀ j A M t S e f') hfS

theorem collisionChoice_weight_le_f0TruncatedGainCollisionResidualPairCharge
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {j s : ℕ} {w : TestWeight V} {e f₀ : Finset V}
    (hw0 : ∀ T, 0 ≤ w T)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hf₀A : f₀ ∈ availableEdges H C M)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition
      (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    w S ≤ f0TruncatedGainCollisionResidualPairCharge
      w H C f₀ j (availableEdges H C M) M (s - 1) S e := by
  obtain ⟨f, c, r, hr, heS, hfS, heA, hfA,
      hcC, hec, hfc, hrank, hpartial, htrunc⟩ :=
    gainCollisionResidualRepresentation_exists_f0Truncated
      hmatchingPos hCcard hj3 hMH hf₀A hS hwS hcoord heCollision
  exact testWeight_le_f0TruncatedGainCollisionResidualPairCharge
    hw0 H C f₀ j (availableEdges H C M) M (s - 1)
      S e f c r hfS hcC hr
      ⟨hec, hfc, hrank, htrunc, hpartial⟩

theorem weightedTestGainCollisionTerm_le_f0TruncatedResidualCharges
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {j s : ℕ} {w : TestWeight V} {f₀ : Finset V}
    (hw0 : ∀ T, 0 ≤ w T)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hf₀A : f₀ ∈ availableEdges H C M)
    (hS : S ∈ H.powersetCard j) :
    (if partialTestCondition (availableEdges H C M) M j (s + 1) S then
      w S * (testGainCollisionChoiceSet H C M S).card else 0) ≤
      ∑ e ∈ S, f0TruncatedGainCollisionResidualPairCharge
        w H C f₀ j (availableEdges H C M) M (s - 1) S e := by
  by_cases hcoord :
      partialTestCondition (availableEdges H C M) M j (s + 1) S
  · rw [if_pos hcoord]
    calc
      w S * (testGainCollisionChoiceSet H C M S).card =
          ∑ e ∈ testGainCollisionChoiceSet H C M S, w S := by
        simp [mul_comm]
      _ ≤ ∑ e ∈ testGainCollisionChoiceSet H C M S,
          f0TruncatedGainCollisionResidualPairCharge
            w H C f₀ j (availableEdges H C M) M (s - 1) S e := by
        apply Finset.sum_le_sum
        intro e heCollision
        by_cases hwS : 0 < w S
        · exact collisionChoice_weight_le_f0TruncatedGainCollisionResidualPairCharge
            hw0 hmatchingPos hCcard hj3 hMH hf₀A hS hwS hcoord heCollision
        · have hwS0 : w S = 0 := le_antisymm (not_lt.mp hwS) (hw0 S)
          rw [hwS0]
          exact f0TruncatedGainCollisionResidualPairCharge_nonneg
            hw0 H C f₀ j (availableEdges H C M) M (s - 1) S e
      _ ≤ ∑ e ∈ S, f0TruncatedGainCollisionResidualPairCharge
          w H C f₀ j (availableEdges H C M) M (s - 1) S e := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro e heCollision
          exact Finset.inter_subset_left
            (Finset.filter_subset _ _ heCollision)
        · intro e heS heNot
          exact f0TruncatedGainCollisionResidualPairCharge_nonneg
            hw0 H C f₀ j (availableEdges H C M) M (s - 1) S e
  · rw [if_neg hcoord]
    exact Finset.sum_nonneg fun e _ ↦
      f0TruncatedGainCollisionResidualPairCharge_nonneg
        hw0 H C f₀ j (availableEdges H C M) M (s - 1) S e

theorem sum_f0TruncatedGainCollisionResidualPairCharges_eq_partialMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (M : Hypergraph V) (j s : ℕ) :
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S, f0TruncatedGainCollisionResidualPairCharge
        w H C f₀ j (availableEdges H C M) M (s - 1) S e) =
      ∑ r ∈ Finset.Icc 2 5,
        weightedF0TruncatedGainCollisionResidualPartialMass
          w H C f₀ j r (availableEdges H C M) M (s - 1) := by
  have hmassExpand :
      (∑ r ∈ Finset.Icc 2 5,
        weightedF0TruncatedGainCollisionResidualPartialMass
          w H C f₀ j r (availableEdges H C M) M (s - 1)) =
        ∑ r ∈ Finset.Icc 2 5,
          ∑ S ∈ H.powersetCard j,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e,
          ∑ c ∈ C,
            if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
                IsF0TruncatedGainCollisionResidual H C f₀
                  (gainCollisionResidualConflict c e f) ∧
                gainCollisionResidualUnion S c e f ∈
                  partialFamily (gainCollisionResidualLayer H C j r)
                    (availableEdges H C M) M (s - 1)
            then w S else 0 := by
    apply Finset.sum_congr rfl
    intro r hr
    exact weightedF0TruncatedGainCollisionResidualPartialMass_eq_representationSum
      w H C f₀ j r (availableEdges H C M) M (s - 1)
  rw [hmassExpand]
  unfold f0TruncatedGainCollisionResidualPairCharge
    f0TruncatedGainCollisionResidualConflictCharge
    f0TruncatedGainCollisionResidualRankCharge
    f0TruncatedGainCollisionResidualRepresentationCharge
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e he
  calc
    (∑ f ∈ S.erase e,
      ∑ c ∈ C,
        ∑ r ∈ Finset.Icc 2 5, _) =
      ∑ f ∈ S.erase e,
        ∑ r ∈ Finset.Icc 2 5,
          ∑ c ∈ C, _ := by
      apply Finset.sum_congr rfl
      intro f hf
      rw [Finset.sum_comm]
    _ = ∑ r ∈ Finset.Icc 2 5,
        ∑ f ∈ S.erase e,
          ∑ c ∈ C, _ := by
      rw [Finset.sum_comm]

/-- Generic deterministic filtered charge.  The only extra state input is
the availability fact which itself proves the representation filter. -/
theorem weightedPartialTestGainCollision_le_f0TruncatedResidualPartialMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j s : ℕ} {w : TestWeight V} {f₀ : Finset V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hf₀A : f₀ ∈ availableEdges H C M) :
    weightedPartialTestGainCollision w H C M j s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedF0TruncatedGainCollisionResidualPartialMass
          w H C f₀ j r (availableEdges H C M) M (s - 1) := by
  rw [weightedPartialTestGainCollision_eq_weightedTestGainCollisionMass_sharp]
  calc
    weightedTestGainCollisionMass w H C M j s ≤
        ∑ S ∈ H.powersetCard j,
          ∑ e ∈ S, f0TruncatedGainCollisionResidualPairCharge
            w H C f₀ j (availableEdges H C M) M (s - 1) S e := by
      unfold weightedTestGainCollisionMass
      apply Finset.sum_le_sum
      intro S hS
      exact weightedTestGainCollisionTerm_le_f0TruncatedResidualCharges
        hw0 hmatchingPos hCcard hj3 hMH hf₀A hS
    _ = ∑ r ∈ Finset.Icc 2 5,
        weightedF0TruncatedGainCollisionResidualPartialMass
          w H C f₀ j r (availableEdges H C M) M (s - 1) :=
      sum_f0TruncatedGainCollisionResidualPairCharges_eq_partialMass
        w H C f₀ M j s

/-- Certificate-local public endpoint.  Its filter premise is discharged
solely from the live availability of the internal source edge. -/
theorem CFMRegularization.RegularizationCertificate.weightedPartialInternalTestGainCollision_le_f0TruncatedResidualPartialMass
    {io : Type*} [Fintype io]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw Gamma : ℝ} {ellCert : ℕ}
    {publicJ : io → ℕ} {publicW : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert publicJ publicW)
    {M : Hypergraph V} (hMH : M ⊆ H)
    (f₀ : Finset V) (hf₀A : f₀ ∈ availableEdges H R.regularized M)
    (q s : ℕ) (hq3 : q ≤ 3) :
    weightedPartialTestGainCollision
        (conflictLinkTestWeight R.regularized f₀ q)
        H R.regularized M q s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedF0TruncatedGainCollisionResidualPartialMass
          (conflictLinkTestWeight R.regularized f₀ q)
          H R.regularized f₀ q r
          (availableEdges H R.regularized M) M (s - 1) := by
  apply weightedPartialTestGainCollision_le_f0TruncatedResidualPartialMass
  · intro S
    by_cases hS : S ∈ conflictLinkLayer R.regularized f₀ q <;>
      simp [conflictLinkTestWeight, hS]
  · intro S hS hpos
    exact conflictLinkTestWeight_matching_of_pos_sharp
      R.conflictMatching hpos
  · intro c hc
    exact R.bounded.conflict_card hc
  · exact hq3
  · exact hMH
  · exact hf₀A

theorem CFMRegularization.RegularizationCertificate.rerootedTestConflictUnionLayer_isWeightedRealSpread
    {ι : Type*} [Fintype ι]
