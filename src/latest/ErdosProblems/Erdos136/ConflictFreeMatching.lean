theorem restrictedExternal_meanWindow_of_literalSharpCaps
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta GammaCert GammaCore : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
      GammaCert ellCert j w)
    (D₂ D₃ D₄ : ℝ) (N₀ k : ℕ) (Pfloor : ℝ)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ root, root.card = 2 →
      (codegree H root : ℝ) ≤ d ^ (1 - eta))
    (a : io) (s : Fin (j a + 1)) (hj3 : j a ≤ 3)
    (M : Hypergraph V)
    (hM : IsConflictFreeMatching H R.regularized M)
    (hNcard : (vertexFinset H).card = N₀) (hcard : M.card = k)
    (hgood : certificateIndexedGreedyGoodWithCore H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ellCert j w R
      D₂ D₃ D₄ GammaCore (CFMNumeric.coreEpsilon eta) (N₀ : ℝ) k M)
    (Rstep : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ GammaCore
      (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ) (k : ℝ) Pfloor (j a) s.1)
    (hduplicate : ∀ f ∈ availableEdges H R.regularized M,
      (internalOpenLinkMass R.regularized
          (availableEdges H R.regularized M) M f : ℝ) -
        (openConflictCount R.regularized
          (availableEdges H R.regularized M) M f : ℝ) ≤
          1536 * localSpreadPrimaryMargin eta d)
    (hmixed : ∀ f ∈ availableEdges H R.regularized M,
      ∀ g ∈ availableEdges H R.regularized M, Disjoint f g → ∀ v ∈ g,
        CFMRegularization.conditionC4Count H R.regularized f v +
            (localConflictLinkPartialAtVertex R.regularized
              (availableEdges H R.regularized M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex R.regularized
              (availableEdges H R.regularized M) M f 3 1 v).card ≤
          certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d)
    (hreroot : ∀ f ∈ availableEdges H R.regularized M,
      ∀ g ∈ availableEdges H R.regularized M, g ≠ f → Disjoint f g →
      {f, g} ∉ conflictLayer R.regularized 2 →
      ∀ q ∈ Finset.Icc 1 3, ∀ r ∈ Finset.Icc 1 5,
        ((partialFamily
          (testConflictUnionLayer
            (conflictLinkLayer R.regularized f q) R.regularized g r)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
            2 * localSpreadPrimaryMargin eta d)
    (hgain : weightedPartialTestGainCollision (R.restrictedWeight a)
      H R.regularized M (j a) s.1 ≤
        8 * testTotal (R.restrictedWeight a) H (j a) *
          d ^ ((s.1 : ℝ) + 1 - (j a : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 16)) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N₀ : ℝ)
              (j a) s.1 (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ)
              (j a) s.1 (k : ℝ) +
            2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) -
              CFMNumeric.coreEpsilon eta) / (N₀ : ℝ))) ≤
        meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ∧
      meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N₀ : ℝ)
              (j a) s.1 (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ)
              (j a) s.1 (k : ℝ) -
            2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) -
              CFMNumeric.coreEpsilon eta) / (N₀ : ℝ))) := by
  let W := testTotal (R.restrictedWeight a) H (j a)
  let statusLo := certificateTestStatusLo D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ) (d ^ (1 - eta))
      (1536 * localSpreadPrimaryMargin eta d) k
  let statusHi := certificateTestStatusHi D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ) k
  let lossK : ℝ := ((s.1.choose 2 * (4 *
      (64 * Nat.ceil (d ^ (1 - eta)) +
        16 * certificateMixedLossCapNat eta
          (CFMRegularization.rawRegularizationEps eta) d +
        Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ)
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hcovered : 8 * k ≤ N₀ := by
    have hb := Rstep.delta.degree.before_end (k : ℝ) hx
    exact_mod_cast hb.le
  have hhand := availableEdges_card_bounds_of_reachableDegreeWithin
    H R.regularized hH8 M hM N₀ k hNcard hcard hcovered
      Rstep.delta.degree.N_pos D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d
      (availableDegreeWithin_of_indexedRegularizedGreedyGood
        H R.regularized D₂ D₃ D₄ GammaCore
          (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ)
          j R.restrictedWeight hgood)
  have hxi := (Rstep.delta.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one Rstep.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos Rstep.delta.degree.N_pos
    (Rstep.delta.degree.before_end (k : ℝ) hx)
  have hh := CFMTrajectories.hHat_pos
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd Rstep.delta.degree.N_pos hp
  have hleft : 0 < CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
      (1 - CFMTrajectories.xi GammaCore (CFMNumeric.coreEpsilon eta)
        d (N₀ : ℝ) (k : ℝ)) := by
    apply mul_pos hh
    linarith
  have hAcard : 0 < ((availableEdges H R.regularized M).card : ℝ) :=
    hleft.trans_le hhand.1
  have hA : (availableEdges H R.regularized M).Nonempty :=
    Finset.card_pos.mp (by exact_mod_cast hAcard)
  have hstatus : ∀ f ∈ availableEdges H R.regularized M,
      statusLo ≤ ((availableBlockerChoices H R.regularized M f).card : ℝ) ∧
        ((availableBlockerChoices H R.regularized M f).card : ℝ) ≤ statusHi := by
    intro f hf
    simpa only [statusLo, statusHi] using
      availableBlockerChoices_bounds_of_certificateGoodWithCore
        H C d (CFMRegularization.rawRegularizationEps eta) GammaCert ellCert
          j w R D₂ D₃ D₄ GammaCore (CFMNumeric.coreEpsilon eta)
          (N₀ : ℝ) (d ^ (1 - eta))
          (1536 * localSpreadPrimaryMargin eta d)
          hH8 hcodegree hgood hf (hduplicate f hf)
  have hstatusLo0 : 0 ≤ statusLo := by
    dsimp only [statusLo]
    exact CFMSharpTestCutoff.certificateTestStatusLo_nonneg_of_registry
      E S Rstep.delta
  have hstatusHi0 : 0 ≤ statusHi := by
    obtain ⟨f, hf⟩ := hA
    exact (Nat.cast_nonneg _).trans (hstatus f hf).2
  have hcurrent :=
    restrictedExternalObservable_bounds_of_certificateGoodWithCore
      H C d (CFMRegularization.rawRegularizationEps eta) GammaCert ellCert
        j w R D₂ D₃ D₄ GammaCore (CFMNumeric.coreEpsilon eta)
        (N₀ : ℝ) hgood a s
  have hplus :=
    restrictedExternalNextObservable_bounds_of_certificateGoodWithCore
      H C d (CFMRegularization.rawRegularizationEps eta) GammaCert ellCert
        j w R D₂ D₃ D₄ GammaCore (CFMNumeric.coreEpsilon eta)
        (N₀ : ℝ) hgood a s
  have hcodegreeNat : ∀ root, root.card = 2 →
      codegree (availableEdges H R.regularized M) root ≤
        Nat.ceil (d ^ (1 - eta)) := by
    intro root hroot
    exact available_codegree_le_ceil (hcodegree root hroot)
  have hrerootSum : ∀ f ∈ availableEdges H R.regularized M,
      ∀ g ∈ availableEdges H R.regularized M, g ≠ f → Disjoint f g →
      {f, g} ∉ conflictLayer R.regularized 2 →
        (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer
              (conflictLinkLayer R.regularized f q) R.regularized g r)
