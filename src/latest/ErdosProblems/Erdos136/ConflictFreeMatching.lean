/-- The explicit floor in the certificate layer scale absorbs the full
surviving one-open geometry into one half of the natural source jump. -/
theorem fifty_base_le_internalConflictLink_naturalHalf
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (q : ℕ) :
    50 * Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) ≤
      testSourceJumpScale
        (certificateInternalLayerScale H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R (q + 1) *
            Real.rpow d (1 - (q : ℝ)))
        d (CFMNumeric.coreEpsilon eta) / 2 := by
  let eps := CFMNumeric.coreEpsilon eta
  let epsRaw := CFMRegularization.rawRegularizationEps eta
  let scale := certificateInternalLayerScale H C d epsRaw
    (2 * (ell : ℝ) + 1) ell j w R (q + 1)
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps0 : 0 ≤ eps := by
    dsimp only [eps, CFMNumeric.coreEpsilon,
      CFMRegularization.rawRegularizationEps]
    linarith [E.eta_pos]
  have hepsRaw : epsRaw = 5 * eps := by
    dsimp only [epsRaw, eps, CFMNumeric.coreEpsilon]
    ring
  have hfloorRaw := certificateInternalLayerScale_floor_le
    R hdpos.le (q + 1)
  have hfloor : Real.rpow d ((q : ℝ) - eps / 120) ≤ scale := by
    dsimp only [scale]
    change Real.rpow d
      ((((q + 1 : ℕ) : ℝ) - 1) - epsRaw / 600) ≤ _ at hfloorRaw
    rw [hepsRaw] at hfloorRaw
    convert hfloorRaw using 1 <;> push_cast <;> ring_nf
  have hconst : (100 : ℝ) ≤ Real.rpow d (3 * eps / 64) := by
    calc
      (100 : ℝ) ≤ 5 ^ (3 : ℕ) := by norm_num
      _ ≤ Real.rpow d ((3 : ℝ) * eps / 64) := by
        have h := S.envelopeFifth_pow 3
        norm_num at h ⊢
        simpa only [eps] using h
      _ = Real.rpow d (3 * eps / 64) := by ring
  have hleft :
      100 * Real.rpow d (1 - eps / 3) ≤
        Real.rpow d (1 - 55 * eps / 192) := by
    calc
      100 * Real.rpow d (1 - eps / 3) ≤
          Real.rpow d (3 * eps / 64) *
            Real.rpow d (1 - eps / 3) :=
        mul_le_mul_of_nonneg_right hconst (Real.rpow_nonneg hdpos.le _)
      _ = Real.rpow d (3 * eps / 64 + (1 - eps / 3)) :=
        (Real.rpow_add hdpos _ _).symm
      _ = Real.rpow d (1 - 55 * eps / 192) := by congr 1 <;> ring
  have hexp : 1 - 55 * eps / 192 ≤ 1 - 31 * eps / 120 := by
    linarith
  have hpow : Real.rpow d (1 - 55 * eps / 192) ≤
      Real.rpow d (1 - 31 * eps / 120) :=
    Real.rpow_le_rpow_of_exponent_le hd hexp
  have hrhs : Real.rpow d (1 - 31 * eps / 120) ≤
      scale * Real.rpow d (1 - (q : ℝ)) *
        Real.rpow d (-eps / 4) := by
    have hmul := mul_le_mul_of_nonneg_right hfloor
      (Real.rpow_nonneg hdpos.le (1 - (q : ℝ)))
    have hmul' := mul_le_mul_of_nonneg_right hmul
      (Real.rpow_nonneg hdpos.le (-eps / 4))
    calc
      Real.rpow d (1 - 31 * eps / 120) =
          Real.rpow d ((q : ℝ) - eps / 120) *
            Real.rpow d (1 - (q : ℝ)) *
              Real.rpow d (-eps / 4) := by
        calc
          Real.rpow d (1 - 31 * eps / 120) =
              Real.rpow d
                (((q : ℝ) - eps / 120) +
                  (1 - (q : ℝ)) + (-eps / 4)) := by
                    congr 1
                    ring
          _ = Real.rpow d
                (((q : ℝ) - eps / 120) + (1 - (q : ℝ))) *
                Real.rpow d (-eps / 4) := by
                  simp only [Real.rpow_eq_pow]
                  exact Real.rpow_add hdpos _ _
          _ = Real.rpow d ((q : ℝ) - eps / 120) *
                Real.rpow d (1 - (q : ℝ)) *
                  Real.rpow d (-eps / 4) := by
                    simp only [Real.rpow_eq_pow]
                    rw [Real.rpow_add hdpos]
      _ ≤ scale * Real.rpow d (1 - (q : ℝ)) *
          Real.rpow d (-eps / 4) := hmul'
  have hhundred : 100 * Real.rpow d (1 - eps / 3) ≤
      scale * Real.rpow d (1 - (q : ℝ)) *
        Real.rpow d (-eps / 4) := hleft.trans (hpow.trans hrhs)
  dsimp only [testSourceJumpScale]
  dsimp only [epsRaw, scale, eps] at hhundred ⊢
  nlinarith

/-- Closed natural pointwise loss for a surviving internal one-open
coordinate.  No status, mean, jump, or availability premise is exposed. -/
theorem internalConflictLink_one_surviving_loss_le_naturalHalf_of_finalGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (f : Finset V) (hfH : f ∈ H) (q : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (M : Hypergraph V) (hM : IsConflictFreeMatching H R.regularized M)
    (hfA : f ∈ availableEdges H R.regularized M)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M)
    (e : Finset V) (heA : e ∈ availableEdges H R.regularized M)
    (hfNext : f ∈ availableEdges H R.regularized (insert e M)) :
    partialTestStepLoss
        (conflictLinkTestWeight R.regularized f q)
        H R.regularized q 1 M e ≤
      testSourceJumpScale
        (certificateInternalLayerScale H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R (q + 1) *
            Real.rpow d (1 - (q : ℝ)))
        d (CFMNumeric.coreEpsilon eta) / 2 := by
  exact (internalConflictLink_one_surviving_loss_le_fifty_base_of_finalGood
    H C d eta ell j w hinst R E S D₂ D₃ D₄ N T k hN hT hk
      f hfH q hq1 hq3 M hM hfA hgood e heA hfNext).trans
    (fifty_base_le_internalConflictLink_naturalHalf
      H C d eta ell j w R E S q)

end

/-! ## Integrated: SharpTestInternalNaturalNumeric -/


open Finset Real Set
