theorem combinedTestLocalCap_of_enhancedGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (c : CombinedTestLocalRootCoordinate H R.regularized io j) :
    testTotal
        (finiteWeightedRootShadowWeight
          (combinedTestLocalProfileFamily H C j R)
          (combinedTestLocalProfileWeight H C j R) c)
        M c.selected.1 ≤
      finiteWeightedRootShadowCap eta d (N : ℝ)
        (combinedTestLocalProfileScale
          H C d epsRaw GammaCert ellCert j w R c.profile)
        (combinedTestLocalProfileFamilyRank j c.profile)
        c.root.card c.selected.1 k := by
  exact finiteWeightedRootShadowCap_of_enhancedGood
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (combinedTestLocalProfileFamilyRank j)
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (combinedTestLocalProfileFamily H C j R)
      (combinedTestLocalProfileWeight H C j R)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R)
      hgood c

/-- The dynamic one-open `C*` cap used by the killed part of the exact
persistent internal mean.  It is a genuine combined-Good coordinate; no
statewise static-spread premise is exposed to the source constructor. -/
theorem internalCommonImmediateEvictorPartialCard_le_two_margin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (e f : Finset V) (heH : e ∈ H) (hfH : f ∈ H)
    (r : ℕ) (hr2 : 2 ≤ r) (hr3 : r ≤ 3) :
    ((partialFamily
        (commonImmediateEvictorLinkLayer R.regularized e f r)
        (availableEdges H R.regularized M) M 1).card : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((3 * GammaCert + 1) *
          Real.rpow d ((r : ℝ) - epsRaw / 4)) 0 (r - 1) := by
  let b : CombinedTestLocalProfileIndex H R.regularized io :=
    internalCommonImmediateEvictorLocalProfile H R.regularized
      ⟨e, heH⟩ ⟨f, hfH⟩ r hr2 hr3
  let d₀ : ℝ := (3 * GammaCert + 1) *
    Real.rpow d ((r : ℝ) - epsRaw / 4)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hGamma3 : 0 ≤ 3 * GammaCert :=
    regularizedBounded_Gamma_nonneg R.bounded hdpos
  have hd₀pos : 0 < d₀ := by
    dsimp only [d₀]
    exact mul_pos (by linarith) (Real.rpow_pos_of_pos hdpos _)
  have hzero := combinedTestLocalProfile_root_le_scale
    H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
      hdegree hresidualCutoff b ∅ (by
        simp [b, internalCommonImmediateEvictorLocalProfile,
          combinedTestLocalProfileActiveRank])
  have hbound := weightedProfilePartialMass_le_two_margin_of_enhancedGood
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (combinedTestLocalProfileFamilyRank j)
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (combinedTestLocalProfileFamily H C j R)
      (combinedTestLocalProfileWeight H C j R)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R)
      E S hN hT (A := availableEdges H R.regularized M)
      hk hgood b 1
      (by simpa [b, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileFamily,
        combinedTestLocalProfileFamilyRank] using
          commonImmediateEvictorLinkLayer_uniform R.regularized e f r)
      (by intro U; norm_num [b, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileWeight, unitTestWeight])
      (by simp [b, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileFamilyRank]; omega)
      (by simp [b, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileFamilyRank]; omega)
      (by simp [b, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileFamilyRank,
        combinedTestLocalProfileActiveRank])
      (by simp [b, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileSeed])
      hd₀pos.le
      (by simpa [b, d₀, internalCommonImmediateEvictorLocalProfile,
        combinedTestLocalProfileFamily,
        combinedTestLocalProfileWeight,
        combinedTestLocalProfileScale] using hzero)
  change weightedPartialFamilyMass
      (commonImmediateEvictorLinkLayer R.regularized e f r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M 1 ≤
    2 * finiteWeightedRootShadowMargin eta d d₀ 0 (r - 1) at hbound
  have hunit : weightedPartialFamilyMass
      (commonImmediateEvictorLinkLayer R.regularized e f r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M 1 =
        ((partialFamily
          (commonImmediateEvictorLinkLayer R.regularized e f r)
          (availableEdges H R.regularized M) M 1).card : ℝ) := by
    simp [weightedPartialFamilyMass, unitTestWeight]
  rw [← hunit]
  simpa [b, d₀, internalCommonImmediateEvictorLocalProfile,
    combinedTestLocalProfileFamily, combinedTestLocalProfileWeight,
    combinedTestLocalProfileFamilyRank] using hbound

/-- Arbitrary positive selected-rank PointDuplicate cap.  The earlier
external convenience theorem fixes selected rank one; persistent killed
gain needs the same tracked family at rank `s+1`. -/
theorem internalPointDuplicatePartialCard_le_two_margin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (f : Finset V) (hfH : f ∈ H)
    (r n : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5)
    (hn1 : 1 ≤ n) (hn : n ≤ r - 1) :
    ((partialFamily
        (duplicateConflictLinkUnionLayer R.regularized f r)
        (availableEdges H R.regularized M) M n).card : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (2304 * (3 * GammaCert + 1) *
          Real.rpow d ((r : ℝ) - epsRaw / 4)) 0 (r - n) := by
  let be : ExternalTestLocalProfileIndex H R.regularized io :=
    pointDuplicateLocalProfile H R.regularized ⟨f, hfH⟩ r hr3 hr5
  let b : CombinedTestLocalProfileIndex H R.regularized io := Sum.inl be
  let d₀ : ℝ := 2304 * (3 * GammaCert + 1) *
    Real.rpow d ((r : ℝ) - epsRaw / 4)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hGamma3 : 0 ≤ 3 * GammaCert :=
    regularizedBounded_Gamma_nonneg R.bounded hdpos
  have hd₀pos : 0 < d₀ := by
    dsimp only [d₀]
    exact mul_pos (mul_pos (by norm_num) (by linarith))
      (Real.rpow_pos_of_pos hdpos _)
  have hzero := combinedTestLocalProfile_root_le_scale
    H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
      hdegree hresidualCutoff b ∅ (by
        simp [b, be, pointDuplicateLocalProfile,
          combinedTestLocalProfileActiveRank,
          externalTestLocalProfileActiveRank])
  have hbound := weightedProfilePartialMass_le_two_margin_of_enhancedGood
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (combinedTestLocalProfileFamilyRank j)
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (combinedTestLocalProfileFamily H C j R)
      (combinedTestLocalProfileWeight H C j R)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R)
      E S hN hT (A := availableEdges H R.regularized M)
      hk hgood b n
      (by simpa [b, be, pointDuplicateLocalProfile,
        combinedTestLocalProfileFamily,
        combinedTestLocalProfileFamilyRank,
        externalTestLocalProfileFamily,
        externalTestLocalProfileFamilyRank] using
          duplicateConflictLinkUnionLayer_uniform R.regularized f r)
      (by intro U; norm_num [b, be, pointDuplicateLocalProfile,
        combinedTestLocalProfileWeight,
        externalTestLocalProfileWeight, unitTestWeight])
      (by simp [b, be, pointDuplicateLocalProfile,
        combinedTestLocalProfileFamilyRank,
        externalTestLocalProfileFamilyRank]; omega)
      (by simp [b, be, pointDuplicateLocalProfile,
        combinedTestLocalProfileFamilyRank,
        externalTestLocalProfileFamilyRank]; exact hr5)
      (by simp [b, be, pointDuplicateLocalProfile,
        combinedTestLocalProfileFamilyRank,
        combinedTestLocalProfileActiveRank,
        externalTestLocalProfileFamilyRank,
        externalTestLocalProfileActiveRank]; omega)
      (by simp [b, combinedTestLocalProfileSeed])
      hd₀pos.le
      (by simpa [b, be, d₀, pointDuplicateLocalProfile,
        combinedTestLocalProfileFamily,
        combinedTestLocalProfileWeight,
        combinedTestLocalProfileScale,
        externalTestLocalProfileFamily,
        externalTestLocalProfileWeight,
        externalTestLocalProfileScale] using hzero)
  change weightedPartialFamilyMass
      (duplicateConflictLinkUnionLayer R.regularized f r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M n ≤
    2 * finiteWeightedRootShadowMargin eta d d₀ 0 (r - n) at hbound
  have hunit : weightedPartialFamilyMass
      (duplicateConflictLinkUnionLayer R.regularized f r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M n =
        ((partialFamily
          (duplicateConflictLinkUnionLayer R.regularized f r)
          (availableEdges H R.regularized M) M n).card : ℝ) := by
    simp [weightedPartialFamilyMass, unitTestWeight]
  rw [← hunit]
  simpa [b, be, d₀, pointDuplicateLocalProfile,
    combinedTestLocalProfileFamily, combinedTestLocalProfileWeight,
    combinedTestLocalProfileFamilyRank,
    externalTestLocalProfileFamily,
    externalTestLocalProfileWeight,
    externalTestLocalProfileFamilyRank] using hbound

/-- The exact availability-filtered internal residual source cap projected
from the final combined Good family. -/
theorem internalResidualPartialMass_le_profileMargin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (f₀ : Finset V) (hf₀H : f₀ ∈ H)
    (q s r : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hr2 : 2 ≤ r) (hr5 : r ≤ 5) :
    weightedF0TruncatedGainCollisionResidualPartialMass
        (conflictLinkTestWeight R.regularized f₀ q)
        H R.regularized f₀ q r
        (availableEdges H R.regularized M) M (s - 1) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (3 * certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (q + 1) *
          Real.rpow d ((r : ℝ) - (q : ℝ) - epsRaw / 10))
        0 ((r - 2) - (s - 1)) := by
  let b : CombinedTestLocalProfileIndex H R.regularized io :=
    internalResidualLocalProfile H R.regularized
      ⟨f₀, hf₀H⟩ q r hq1 hq3 hr2 hr5
  let d₀ : ℝ := 3 * certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (q + 1) *
    Real.rpow d ((r : ℝ) - (q : ℝ) - epsRaw / 10)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hd₀pos : 0 < d₀ := by
    dsimp only [d₀]
    exact mul_pos
      (mul_pos (by norm_num) (certificateInternalLayerScale_pos
        H C d epsRaw GammaCert ellCert j w R (q + 1) hdpos))
      (Real.rpow_pos_of_pos hdpos _)
  by_cases ht : s - 1 ≤ r - 2
  · have hzero := combinedTestLocalProfile_root_le_scale
      H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
        hdegree hresidualCutoff b ∅ (by
          simp [b, internalResidualLocalProfile,
            combinedTestLocalProfileActiveRank])
    have hbound := weightedProfilePartialMass_le_two_margin_of_enhancedGood
      H R.regularized D₂ D₃ D₄ GammaCore eta d N T
        j R.restrictedWeight
        (combinedTestLocalProfileFamilyRank j)
        (combinedTestLocalProfileActiveRank j)
        (combinedTestLocalProfileSeed
          (H := H) (C := R.regularized) (io := io))
        (combinedTestLocalProfileFamily H C j R)
        (combinedTestLocalProfileWeight H C j R)
        (combinedTestLocalProfileScale
          H C d epsRaw GammaCert ellCert j w R)
        E S hN hT (A := availableEdges H R.regularized M)
        hk hgood b (s - 1)
        (by simpa [b, internalResidualLocalProfile,
          combinedTestLocalProfileFamily,
          combinedTestLocalProfileFamilyRank] using
            gainCollisionResidualLayer_uniform H R.regularized q r)
        (by
          intro U
          simpa [b, internalResidualLocalProfile,
            combinedTestLocalProfileWeight] using
            f0TruncatedGainCollisionResidualRepresentationWeight_nonneg
              (conflictLinkTestWeight_nonneg_sharp R.regularized f₀ q)
                H R.regularized f₀ q r U)
        (by simpa [b, internalResidualLocalProfile,
          combinedTestLocalProfileFamilyRank] using ht)
        (by simp [b, internalResidualLocalProfile,
          combinedTestLocalProfileFamilyRank]; omega)
        (by simp [b, internalResidualLocalProfile,
          combinedTestLocalProfileFamilyRank,
          combinedTestLocalProfileActiveRank])
        rfl hd₀pos.le
        (by simpa [b, d₀, internalResidualLocalProfile,
          combinedTestLocalProfileFamily,
          combinedTestLocalProfileWeight,
          combinedTestLocalProfileScale] using hzero)
    simpa [weightedF0TruncatedGainCollisionResidualPartialMass,
      b, d₀, internalResidualLocalProfile,
      combinedTestLocalProfileFamily, combinedTestLocalProfileWeight,
      combinedTestLocalProfileFamilyRank,
      combinedTestLocalProfileScale] using hbound
  · have hempty :
        partialFamily
          (gainCollisionResidualLayer H R.regularized q r)
          (availableEdges H R.regularized M) M (s - 1) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro U hpartial
      have hU := (mem_partialFamily.mp hpartial).1
      have hcard := gainCollisionResidualLayer_uniform
        H R.regularized q r U hU
      have hinter :
          (U ∩ availableEdges H R.regularized M).card ≤ U.card :=
        Finset.card_le_card Finset.inter_subset_left
      have hopen := (mem_partialFamily.mp hpartial).2.1
      omega
    rw [weightedF0TruncatedGainCollisionResidualPartialMass,
      weightedPartialFamilyMass, hempty]
    have hmargin0 : 0 ≤ finiteWeightedRootShadowMargin eta d d₀
        0 ((r - 2) - (s - 1)) := by
      unfold finiteWeightedRootShadowMargin
      exact mul_nonneg
        (finiteWeightedRootShadowZeroScale_nonneg hdpos.le hd₀pos.le 0)
        (pow_nonneg (Real.rpow_nonneg hdpos.le _) _)
    exact mul_nonneg (by norm_num) hmargin0

/-- The proper-root internal original-choice gain observable is bounded by
the combined profile corridor.  Only `q = 2,3` occurs: rank two has the
static selected-rank-zero endpoint, while rank three has one genuine
selected-positive coordinate.  No full-root loss shadow is asserted. -/
theorem internalOriginalGainRootShadow_le_two_margin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (f₀ e : Finset V) (hf₀H : f₀ ∈ H) (heH : e ∈ H)
    (q n : ℕ) (hq2 : 2 ≤ q) (hq3 : q ≤ 3)
    (hn : n ≤ q - 2) :
    testTotal
        (originalTestRootShadowWeight
          (conflictLinkTestWeight R.regularized f₀ q) H q e)
        M n ≤
      2 * finiteWeightedRootShadowMargin eta d
        (certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (q + 1) *
          Real.rpow d (-1 - epsRaw / 5)) 0 n := by
  let bg : InternalOriginalGainProfile H :=
    ⟨⟨f₀, hf₀H⟩, ⟨e, heH⟩, ⟨q, by omega⟩, hq2⟩
  let b : CombinedTestLocalProfileIndex H R.regularized io :=
    Sum.inr (Sum.inr (Sum.inl bg))
  let d₀ : ℝ := certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (q + 1) *
    Real.rpow d (-1 - epsRaw / 5)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hd₀0 : 0 ≤ d₀ := by
    dsimp only [d₀]
    exact mul_nonneg
      (certificateInternalLayerScale_pos
        H C d epsRaw GammaCert ellCert j w R (q + 1) hdpos).le
      (Real.rpow_nonneg hdpos.le _)
  by_cases hnzero : n = 0
  · subst n
    have hzero := combinedTestLocalProfile_root_le_scale
      H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
        hdegree hresidualCutoff b ∅ (by
          simp [b, bg,
            combinedTestLocalProfileActiveRank])
    have htotal :
        testTotal
            (originalTestRootShadowWeight
              (conflictLinkTestWeight R.regularized f₀ q) H q e) M 0 =
          weightedCodegree
            (originalTestChoiceRemainderFamily H q e)
            (originalTestChoiceRemainderWeight
              (conflictLinkTestWeight R.regularized f₀ q) e) ∅ := by
      rw [← testTotal_originalTestChoice_emptyRootShadow_eq
        (conflictLinkTestWeight R.regularized f₀ q) H M q 0 e heH
          (by omega)]
      simp [testTotal, weightedConflictFamilyRootShadowWeight]
    rw [htotal]
    have hzero' : weightedCodegree
          (originalTestChoiceRemainderFamily H q e)
          (originalTestChoiceRemainderWeight
            (conflictLinkTestWeight R.regularized f₀ q) e) ∅ ≤ d₀ := by
      simpa [b, bg, d₀,
        combinedTestLocalProfileFamily, combinedTestLocalProfileWeight,
        combinedTestLocalProfileScale, InternalOriginalGainProfile.toOriginal,
        internalOriginalProfileFamily, internalOriginalProfileWeight,
        internalOriginalProfileScale] using hzero
    simpa [finiteWeightedRootShadowMargin,
      finiteWeightedRootShadowZeroScale, d₀] using
        hzero'.trans (show d₀ ≤ 2 * d₀ by linarith)
  · have hnpos : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hnzero
    have hnlt : n < 6 := by omega
    have hbActive : n ≤ combinedTestLocalProfileActiveRank j b := by
      simpa [b, bg,
        combinedTestLocalProfileActiveRank] using hn
    let c : CombinedTestLocalRootCoordinate H R.regularized io j :=
      finiteWeightedRootShadowEmptyCoordinate (H := H)
        b n hnpos hnlt hbActive (by
          simp [b, bg,
            combinedTestLocalProfileSeed])
    have hcap := combinedTestLocalCap_of_enhancedGood
      H C d epsRaw GammaCert ellCert D₂ D₃ D₄ GammaCore eta N T
        j w R hgood c
    have hweight : weightedConflictFamilyShadowWeight
          (originalTestChoiceRemainderFamily H q e)
          (originalTestChoiceRemainderWeight
            (conflictLinkTestWeight R.regularized f₀ q) e) =
        originalTestRootShadowWeight
          (conflictLinkTestWeight R.regularized f₀ q) H q e := by
      calc
        weightedConflictFamilyShadowWeight
            (originalTestChoiceRemainderFamily H q e)
            (originalTestChoiceRemainderWeight
              (conflictLinkTestWeight R.regularized f₀ q) e) =
          weightedConflictFamilyRootShadowWeight
            (originalTestChoiceRemainderFamily H q e)
            (originalTestChoiceRemainderWeight
              (conflictLinkTestWeight R.regularized f₀ q) e) ∅ :=
              (weightedConflictFamilyRootShadowWeight_empty _ _).symm
        _ = originalTestRootShadowWeight
            (conflictLinkTestWeight R.regularized f₀ q) H q e := by
          exact originalTestChoice_emptyRootShadow_eq
            (conflictLinkTestWeight R.regularized f₀ q) H q e heH
              (by omega)
    have hcap' : testTotal
          (originalTestRootShadowWeight
            (conflictLinkTestWeight R.regularized f₀ q) H q e) M n ≤
        finiteWeightedRootShadowCap eta d (N : ℝ) d₀
          (q - 1) 0 n k := by
      simpa [c, b, bg, d₀,
        finiteWeightedRootShadowEmptyCoordinate,
        finiteWeightedRootShadowWeight,
        weightedConflictFamilyRootShadowWeight_empty,
        combinedTestLocalProfileFamily,
        combinedTestLocalProfileWeight,
        combinedTestLocalProfileFamilyRank,
        combinedTestLocalProfileActiveRank,
        combinedTestLocalProfileSeed,
        combinedTestLocalProfileScale,
        InternalOriginalGainProfile.toOriginal,
        internalOriginalProfileFamily, internalOriginalProfileWeight,
        internalOriginalProfileScale, hweight] using hcap
    exact hcap'.trans (externalTestLocalCap_le_two_margin
      E S hN hT hk (by omega) hd₀0 hnpos)

end

/-! ## Integrated: PersistentInternalStateSourceCaps -/


open Finset Real CFMTrajectories

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-! ## Reusable state caps for one persistent internal link

This record is the deterministic interface shared by the sharp full mean,
the killed gain/loss corrections, and the persistent pointwise moments.
Every field is projected from the finite reachable Good family; downstream
source constructors do not receive any availability, corridor, collision,
or local-spread premise from callers. -/

noncomputable def persistentInternalSourceScale
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) (q : Fin 3) : ℝ :=
  certificateInternalLayerScale H C d epsRaw GammaCert ellCert j w R
    (q.1 + 2)

noncomputable def persistentInternalStatusLo
    (D₂ D₃ D₄ GammaCore eta d N : ℝ) (k : ℕ) : ℝ :=
  certificateTestStatusLo D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d N (d ^ (1 - eta))
      (1536 * localSpreadPrimaryMargin eta d) k

noncomputable def persistentInternalStatusHi
    (D₂ D₃ D₄ GammaCore eta d N : ℝ) (k : ℕ) : ℝ :=
  certificateTestStatusHi D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d N k

noncomputable def persistentInternalLossCollisionCoefficient
    (eta epsRaw d : ℝ) (s : ℕ) : ℝ :=
  ((s.choose 2 * (4 *
    (64 * Nat.ceil (d ^ (1 - eta)) +
      16 * certificateMixedLossCapNat eta epsRaw d +
      Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ)

structure PersistentInternalStateSourceCaps
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T k : ℕ) (Pfloor : ℝ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3)
    (u : Fin (q.1 + 1)) (M : Hypergraph V) : Prop where
  registry : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ) Pfloor
      (q.1 + 1) (u.1 + 1)
  availableNonempty : (availableEdges H R.regularized M).Nonempty
  availableBounds :
    CFMTrajectories.hHat D₂ D₃ D₄ d (N : ℝ) (k : ℝ) *
        (1 - CFMTrajectories.xi GammaCore (CFMNumeric.coreEpsilon eta)
          d (N : ℝ) (k : ℝ)) ≤
        ((availableEdges H R.regularized M).card : ℝ) ∧
      ((availableEdges H R.regularized M).card : ℝ) ≤
        CFMTrajectories.hHat D₂ D₃ D₄ d (N : ℝ) (k : ℝ) *
          (1 + CFMTrajectories.xi GammaCore (CFMNumeric.coreEpsilon eta)
            d (N : ℝ) (k : ℝ))
  statusLo_nonneg :
    0 ≤ persistentInternalStatusLo D₂ D₃ D₄ GammaCore eta d (N : ℝ) k
  statusHi_nonneg :
    0 ≤ persistentInternalStatusHi D₂ D₃ D₄ GammaCore eta d (N : ℝ) k
  status : ∀ e ∈ availableEdges H R.regularized M,
    persistentInternalStatusLo D₂ D₃ D₄ GammaCore eta d (N : ℝ) k ≤
        ((availableBlockerChoices H R.regularized M e).card : ℝ) ∧
      ((availableBlockerChoices H R.regularized M e).card : ℝ) ≤
        persistentInternalStatusHi D₂ D₃ D₄ GammaCore eta d (N : ℝ) k
  current :
    persistentInternalSourceScale H C d epsRaw GammaCert ellCert j w R q *
        (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
            (q.1 + 1) (u.1 + 1) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (q.1 + 1) (u.1 + 1) (k : ℝ)) ≤
        partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M ∧
      partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M ≤
        persistentInternalSourceScale H C d epsRaw GammaCert ellCert j w R q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
              (q.1 + 1) (u.1 + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
                (q.1 + 1) (u.1 + 1) (k : ℝ))
  next :
    persistentInternalSourceScale H C d epsRaw GammaCert ellCert j w R q *
        (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
            (q.1 + 1) (u.1 + 2) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (q.1 + 1) (u.1 + 2) (k : ℝ)) ≤
        partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 2) M ∧
      partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 2) M ≤
        persistentInternalSourceScale H C d epsRaw GammaCert ellCert j w R q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
              (q.1 + 1) (u.1 + 2) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
                (q.1 + 1) (u.1 + 2) (k : ℝ))
  codegreeNat : ∀ root, root.card = 2 →
    codegree (availableEdges H R.regularized M) root ≤
      Nat.ceil (d ^ (1 - eta))
  mixed : ∀ e ∈ availableEdges H R.regularized M,
    ∀ g ∈ availableEdges H R.regularized M, Disjoint e g → ∀ v ∈ g,
      CFMRegularization.conditionC4Count H R.regularized e v +
          (localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M e 2 1 v).card +
          (localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M e 3 1 v).card ≤
        certificateMixedLossCapNat eta epsRaw d
  reroot : ∀ e ∈ availableEdges H R.regularized M,
    ∀ g ∈ availableEdges H R.regularized M, g ≠ e → Disjoint e g →
      {e, g} ∉ conflictLayer R.regularized 2 →
      (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
        (partialFamily
          (testConflictUnionLayer
            (conflictLinkLayer R.regularized e q') R.regularized g r)
          (availableEdges H R.regularized M) M 1).card) ≤
        Nat.ceil (30 * localSpreadPrimaryMargin eta d)
  gainCollision :
    weightedPartialTestGainCollision
        (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
        H R.regularized M (q.1 + 1) (u.1 + 1) ≤
      24 * persistentInternalSourceScale
          H C d epsRaw GammaCert ellCert j w R q *
        Real.rpow d (((u.1 + 1 : ℕ) : ℝ) + 1 -
          (q.1 + 1 : ℕ) - epsRaw / 16)
  lossCollision :
    weightedPartialTestLossCollision
        (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
        H R.regularized M (q.1 + 1) (u.1 + 1) ≤
      persistentInternalLossCollisionCoefficient eta epsRaw d (u.1 + 1) *
        (persistentInternalSourceScale
            H C d epsRaw GammaCert ellCert j w R q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
              (q.1 + 1) (u.1 + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
                (q.1 + 1) (u.1 + 1) (k : ℝ)))
  properOriginal : ∀ e ∈ H, 2 ≤ q.1 + 1 → ∀ n, n ≤ q.1 + 1 - 2 →
    testTotal
        (originalTestRootShadowWeight
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
          H (q.1 + 1) e) M n ≤
      2 * finiteWeightedRootShadowMargin eta d
        (persistentInternalSourceScale
            H C d epsRaw GammaCert ellCert j w R q *
          Real.rpow d (-1 - epsRaw / 5)) 0 n
  pointDuplicate : ∀ r n, 3 ≤ r → r ≤ 5 → 1 ≤ n → n ≤ r - 1 →
    ((partialFamily
      (duplicateConflictLinkUnionLayer R.regularized f.1 r)
      (availableEdges H R.regularized M) M n).card : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (2304 * (3 * GammaCert + 1) *
          Real.rpow d ((r : ℝ) - epsRaw / 4)) 0 (r - n)
  cstar : ∀ g ∈ H, ∀ r, 2 ≤ r → r ≤ 3 →
    ((partialFamily
      (commonImmediateEvictorLinkLayer R.regularized f.1 g r)
      (availableEdges H R.regularized M) M 1).card : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((3 * GammaCert + 1) *
          Real.rpow d ((r : ℝ) - epsRaw / 4)) 0 (r - 1)

/-- Every statewise source cap used by the persistent internal process is
projected from the final reachable Good family.  Apart from the process
registry and the assertion that the frozen source edge is live, callers do
not supply an availability, corridor, collision, or local-spread premise. -/
theorem persistentInternalStateSourceCaps_of_finalReachableGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ) (Pfloor : ℝ)
    (hD₂ : D₂ = certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
    (hD₃ : D₃ = certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
    (hD₄ : D₄ = certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
    (hNcard : (vertexFinset H).card = N)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (f : {e : Finset V // e ∈ H})
    (q : Fin 3) (u : Fin (q.1 + 1)) (M : Hypergraph V)
    (hf : f.1 ∈ availableEdges H R.regularized M)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M)
    (Rstep : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) Pfloor (q.1 + 1) (u.1 + 1)) :
    PersistentInternalStateSourceCaps H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) eta N T k Pfloor j w R f q u M := by
  subst D₂
  subst D₃
  subst D₄
  rcases hinst with
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w :=
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let epsRaw := CFMRegularization.rawRegularizationEps eta
  let GammaCert : ℝ := 2 * (ell : ℝ) + 1
  let GammaCore : ℝ := 6 * GammaCert
  let D₂ := certificateD₂ H C d epsRaw GammaCert ell j w R
  let D₃ := certificateD₃ H C d epsRaw GammaCert ell j w R
  let D₄ := certificateD₄ H C d epsRaw GammaCert ell j w R
  let scale := certificateInternalLayerScale H C d epsRaw GammaCert
    ell j w R (q.1 + 2)
  let statusLo := certificateTestStatusLo D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N : ℝ) (d ^ (1 - eta))
      (1536 * localSpreadPrimaryMargin eta d) k
  let statusHi := certificateTestStatusHi D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N : ℝ) k
  let lossK : ℝ := (((u.1 + 1).choose 2 * (4 *
      (64 * Nat.ceil (d ^ (1 - eta)) +
        16 * certificateMixedLossCapNat eta epsRaw d +
        Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ)
  have hM := finalReachableGood_matching H C d epsRaw GammaCert ell
    D₂ D₃ D₄ GammaCore eta N T j w R hgood
  have hcard := finalReachableGood_card H C d epsRaw GammaCert ell
    D₂ D₃ D₄ GammaCore eta N T j w R hgood
  have hcombined := finalReachableGood_combined H C d epsRaw GammaCert ell
    D₂ D₃ D₄ GammaCore eta N T j w R hgood
  have hcert := finalReachableGood_certificateWithCore H C d epsRaw
    GammaCert ell D₂ D₃ D₄ GammaCore eta N T j w R hgood
  have hcaps := externalSharpCaps_of_combinedGood H C d eta ell j w
    hinst' R E S D₂ D₃ D₄ N T k hN hT hk M hM hcombined
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hcovered : 8 * k ≤ N := by
    have hb := Rstep.delta.degree.before_end (k : ℝ) hx
    exact_mod_cast hb.le
  have hhand := availableEdges_card_bounds_of_reachableDegreeWithin
    H R.regularized hH8 M hM N k hNcard hcard hcovered
      Rstep.delta.degree.N_pos D₂ D₃ D₄ GammaCore
      (CFMNumeric.coreEpsilon eta) d
      (availableDegreeWithin_of_indexedRegularizedGreedyGood
        H R.regularized D₂ D₃ D₄ GammaCore
          (CFMNumeric.coreEpsilon eta) d (N : ℝ)
          j R.restrictedWeight hcert)
  have hxi := (Rstep.delta.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hp := CFMTrajectories.pV_pos Rstep.delta.degree.N_pos
    (Rstep.delta.degree.before_end (k : ℝ) hx)
  have hh := CFMTrajectories.hHat_pos
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hdpos
      Rstep.delta.degree.N_pos hp
  have hleft : 0 < CFMTrajectories.hHat D₂ D₃ D₄ d (N : ℝ) (k : ℝ) *
      (1 - CFMTrajectories.xi GammaCore
        (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)) := by
    apply mul_pos hh
    linarith
  have hAcard : 0 < ((availableEdges H R.regularized M).card : ℝ) :=
    hleft.trans_le hhand.1
  have hA : (availableEdges H R.regularized M).Nonempty :=
    Finset.card_pos.mp (by exact_mod_cast hAcard)
  have hstatus : ∀ e ∈ availableEdges H R.regularized M,
      statusLo ≤ ((availableBlockerChoices H R.regularized M e).card : ℝ) ∧
        ((availableBlockerChoices H R.regularized M e).card : ℝ) ≤
          statusHi := by
    intro e he
    simpa only [statusLo, statusHi, GammaCore, epsRaw] using
      availableBlockerChoices_bounds_of_certificateGoodWithCore
        H C d epsRaw GammaCert ell j w R D₂ D₃ D₄ GammaCore
          (CFMNumeric.coreEpsilon eta) (N : ℝ) (d ^ (1 - eta))
          (1536 * localSpreadPrimaryMargin eta d)
          hH8 hcodegree hcert he (hcaps.1 e he)
  have hstatusLo0 : 0 ≤ statusLo := by
    dsimp only [statusLo, GammaCore]
    exact CFMSharpTestCutoff.certificateTestStatusLo_nonneg_of_registry
      E S Rstep.delta
  have hstatusHi0 : 0 ≤ statusHi :=
    (Nat.cast_nonneg _).trans (hstatus f.1 hf).2
  have hscaleEq : certificateInternalLayerScale H C d epsRaw GammaCert
        ell j w R (q.1 + 2) =
      internalLinkLayerScale
        (certificateD₂ H C d epsRaw GammaCert ell j w R)
        (certificateD₃ H C d epsRaw GammaCert ell j w R)
        (certificateD₄ H C d epsRaw GammaCert ell j w R) q := by
    fin_cases q <;> rfl
  have hcurrentRaw :=
    internalConflictLinkObservable_bounds_of_certificateGoodWithCore
      H C d epsRaw GammaCert ell j w R D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) (N : ℝ) hcert f q u hf
  have hplusRaw :=
    internalConflictLinkNextObservable_bounds_of_certificateGoodWithCore
      H C d epsRaw GammaCert ell j w R D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) (N : ℝ) hcert f q u hf
  have hcurrent : scale *
        (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
            (q.1 + 1) (u.1 + 1) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (q.1 + 1) (u.1 + 1) (k : ℝ)) ≤
        partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M ∧
      partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M ≤
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
            (q.1 + 1) (u.1 + 1) (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (q.1 + 1) (u.1 + 1) (k : ℝ)) := by
    simpa only [scale, hscaleEq, GammaCore, epsRaw] using hcurrentRaw
  have hplus : scale *
        (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
            (q.1 + 1) (u.1 + 2) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (q.1 + 1) (u.1 + 2) (k : ℝ)) ≤
        partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 2) M ∧
      partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 2) M ≤
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
            (q.1 + 1) (u.1 + 2) (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (q.1 + 1) (u.1 + 2) (k : ℝ)) := by
    simpa only [scale, hscaleEq, GammaCore, epsRaw, Nat.add_assoc] using hplusRaw
  have hcodegreeNat : ∀ root, root.card = 2 →
      codegree (availableEdges H R.regularized M) root ≤
        Nat.ceil (d ^ (1 - eta)) := by
    intro root hroot
    exact available_codegree_le_ceil (hcodegree root hroot)
  have hrerootSum : ∀ e ∈ availableEdges H R.regularized M,
      ∀ g ∈ availableEdges H R.regularized M, g ≠ e → Disjoint e g →
      {e, g} ∉ conflictLayer R.regularized 2 →
        (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer
              (conflictLinkLayer R.regularized e q') R.regularized g r)
            (availableEdges H R.regularized M) M 1).card) ≤
          Nat.ceil (30 * localSpreadPrimaryMargin eta d) := by
    intro e he g hg hge heg hpair
    have hsum := sum_rerootedPartialCard_le_ceil
      H R.regularized M e g
      (fun _ _ ↦ 2 * localSpreadPrimaryMargin eta d)
      (fun _ _ ↦ mul_nonneg (by norm_num) <|
        div_nonneg (Real.rpow_nonneg (by positivity) _) (by norm_num))
      (fun q' hq' r hr ↦ hcaps.2.2.1 e he g hg hge heg hpair q' hq' r hr)
    have hqcard : (Finset.Icc (1 : ℕ) 3).card = 3 := by decide
    have hrcard : (Finset.Icc (1 : ℕ) 5).card = 5 := by decide
    have hmass :
        (∑ q' ∈ Finset.Icc (1 : ℕ) 3, ∑ r ∈ Finset.Icc (1 : ℕ) 5,
          (2 : ℝ) * localSpreadPrimaryMargin eta d) =
          30 * localSpreadPrimaryMargin eta d := by
      simp only [Finset.sum_const, hqcard, hrcard,
        nsmul_eq_mul]
      ring
    rw [hmass] at hsum
    exact hsum
  have hlossRaw : weightedPartialTestLossCollision
      (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
      H R.regularized M (q.1 + 1) (u.1 + 1) ≤
        lossK * partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
          H R.regularized (q.1 + 1) (u.1 + 1) M := by
    dsimp only [lossK]
    exact weightedPartialTestLossCollision_le_legalPairAggregateCaps
      (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
      H R.regularized M (q.1 + 1) (u.1 + 1)
      (Nat.ceil (d ^ (1 - eta)))
      (certificateMixedLossCapNat eta epsRaw d)
      (Nat.ceil (30 * localSpreadPrimaryMargin eta d))
      hH8 (conflictLinkTestWeight_nonneg_sharp R.regularized f.1 (q.1 + 1))
      (fun Q _ hpos ↦ conflictLinkTestWeight_matching_of_pos_sharp
        R.conflictMatching hpos)
      (fun Q _ hpos c hc hsub ↦ by
        unfold conflictLinkTestWeight at hpos
        by_cases hQlayer : Q ∈ conflictLinkLayer R.regularized f.1 (q.1 + 1)
        · obtain ⟨⟨c', hc'C, hfc', hQeq⟩, _⟩ :=
            mem_conflictLinkLayer.mp hQlayer
          have hcerase : c ⊆ c'.erase f.1 := by
            rw [hQeq]
            exact hsub
          have hcc' : c ⊆ c' := fun _ hx ↦
            Finset.mem_of_mem_erase (hcerase hx)
          have hne : c ≠ c' := by
            intro heq
            subst c
            exact (Finset.mem_erase.mp (hcerase hfc')).1 rfl
          exact (R.antichain c hc c' hc'C hne) hcc'
        · simp only [hQlayer, ↓reduceIte] at hpos
          linarith)
      hcodegreeNat (fun c hc ↦ R.bounded.conflict_card hc)
      hcaps.2.1 hrerootSum
  have hloss : weightedPartialTestLossCollision
      (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
      H R.regularized M (q.1 + 1) (u.1 + 1) ≤
        lossK * (scale *
          (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
              (q.1 + 1) (u.1 + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
                (q.1 + 1) (u.1 + 1) (k : ℝ))) :=
    hlossRaw.trans (mul_le_mul_of_nonneg_left hcurrent.2 (by positivity))
  have hell1 : 1 ≤ ell := by omega
  have heps : 0 ≤ epsRaw := by
    dsimp only [epsRaw, CFMRegularization.rawRegularizationEps]
    positivity
  have hdegree : ∀ x, (degree H x : ℝ) ≤ d := by
    intro x
    by_cases hx : x ∈ vertexFinset H
    · exact (hdegreeOn x hx).2
    · rw [degree_eq_zero_of_not_mem_vertexFinset hx]
