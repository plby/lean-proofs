/-! ## Integrated: SharpTestRerootSumCap -/


open Finset
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V]

/-- Sum the fifteen legal rerooted partial-family caps and return the
integer ceiling needed by the four-part loss multiplicity bound. -/
theorem sum_rerootedPartialCard_le_ceil
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f g : Finset V) (ccCap : ℕ → ℕ → ℝ)
    (hcap0 : ∀ q r, 0 ≤ ccCap q r)
    (hcap : ∀ q ∈ Finset.Icc 1 3, ∀ r ∈ Finset.Icc 1 5,
      ((partialFamily
        (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
        (availableEdges H C M) M 1).card : ℝ) ≤ ccCap q r) :
    (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
      (partialFamily
        (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
        (availableEdges H C M) M 1).card) ≤
      Nat.ceil (∑ q ∈ Finset.Icc 1 3,
        ∑ r ∈ Finset.Icc 1 5, ccCap q r) := by
  have hsum :
      (((∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
        (partialFamily
          (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
          (availableEdges H C M) M 1).card) : ℕ) : ℝ) ≤
        ∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5, ccCap q r := by
    push_cast
    exact Finset.sum_le_sum fun q hq ↦
      Finset.sum_le_sum fun r hr ↦ hcap q hq r hr
  have hceil := Nat.le_ceil
    (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5, ccCap q r)
  exact_mod_cast hsum.trans hceil

end

