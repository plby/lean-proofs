private theorem zHat_nonneg_at
    {D₂ D₃ D₄ d N x : ℝ} {j s : ℕ}
    (hp : 0 < CFMTrajectories.pV N x)
    (hm : 0 ≤ CFMTrajectories.pM d N x) :
    0 ≤ CFMTrajectories.zHat D₂ D₃ D₄ d N j s x := by
  unfold CFMTrajectories.zHat
  exact mul_nonneg
    (mul_nonneg (Nat.cast_nonneg _)
      (pow_nonneg (CFMTrajectories.q_pos hp).le _))
    (pow_nonneg hm _)

private theorem testInside_nonneg_at
    {D₂ D₃ D₄ Gamma d N x : ℝ} {j s : ℕ}
    (hGamma : 0 ≤ Gamma) (hd : 0 < d)
    (hp : 0 < CFMTrajectories.pV N x)
    (hm : 0 ≤ CFMTrajectories.pM d N x) :
    0 ≤ CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x := by
  unfold CFMTrajectories.testInside
  exact add_nonneg (zHat_nonneg_at hp hm)
    (div_nonneg
      (mul_nonneg (Nat.cast_nonneg _)
        (pow_nonneg (CFMTrajectories.dHat_pos hd hp).le _))
      (mul_nonneg (mul_nonneg (by norm_num) hGamma)
        (pow_nonneg hd.le _)))

private theorem observableUpper_le_two_inside
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k j t : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P j t) :
    CFMTrajectories.zHat D₂ D₃ D₄ d N j t (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j t (k : ℝ) ≤
      2 * CFMTrajectories.testInside D₂ D₃ D₄ Gamma
        d N j t (k : ℝ) := by
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end (k : ℝ) hx)
  have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg (k : ℝ) hx)
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one R.delta.degree.Gamma_one
  have hD0 : 0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) :=
    (CFMTrajectories.dHat_pos hd hp).le
  have hZ0 : 0 ≤ CFMTrajectories.zHat D₂ D₃ D₄ d N j t (k : ℝ) := by
    exact zHat_nonneg_at hp hm
  have hI0 : 0 ≤ CFMTrajectories.testInside D₂ D₃ D₄ Gamma
      d N j t (k : ℝ) := by
    exact testInside_nonneg_at hGamma0 hd hp hm
  have hZI : CFMTrajectories.zHat D₂ D₃ D₄ d N j t (k : ℝ) ≤
      CFMTrajectories.testInside D₂ D₃ D₄ Gamma
        d N j t (k : ℝ) := by
    unfold CFMTrajectories.testInside
    apply le_add_of_nonneg_right
    exact div_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hD0 _))
      (mul_nonneg (mul_nonneg (by norm_num) hGamma0)
        (pow_nonneg hd.le _))
  have hxi := (R.delta.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hxiOne : CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) ≤ 1 := hxi.trans (by norm_num)
  change CFMTrajectories.zHat D₂ D₃ D₄ d N j t (k : ℝ) +
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) *
        CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j t (k : ℝ) ≤
    2 * CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j t (k : ℝ)
  have hEnv := mul_le_mul_of_nonneg_right hxiOne hI0
  nlinarith

private theorem certificateTestStatusHi_nonneg_of_registry
