    (by simpa only [scale, center, err, b, a, hsurvEq, hrate]
      using hcoarse.2)
    (by simpa only [scale, delta] using hdeltaRate)
    (by simpa only [scale, delta] using hrem)
  have hround := degreeRoundedEndpoints_within_error ha hb0 hlo0 hhi0 hK0
    (c := CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ))
    (err := degreeInternalCorridorError D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N k)
    (defect := vertexInternalOpenLinkDefect C (availableEdges H C M) M v)
  constructor
  · rw [hrate]
    exact hwindow.1.trans (by
      simpa only [degreeEnhancedCombLo, D, delta, b, a, center, err,
        defectOverA] using hround.1)
  · rw [hrate]
    calc
      degreeEnhancedCombHi H C v D₂ D₃ D₄ Gamma eta d N k M ≤
          (b / a) * (center + err) := by
        simpa only [degreeEnhancedCombHi, D, delta, b, a, center, err]
          using hround.2
      _ ≤ _ := hwindow.2

