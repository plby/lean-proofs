namespace CFMSharpTestNatural

theorem coreEpsilon_nonneg
    {eta Gamma : ℝ} (E : CFMNumeric.CoreExponentSpec eta Gamma) :
    0 ≤ CFMNumeric.coreEpsilon eta := by
  rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
    simp only [CFMNumeric.coreEpsilon, CFMRegularization.rawRegularizationEps]
    ring]
  linarith [E.eta_pos]

/-- The host-size cutoff absorbs the entire first-derivative coefficient
with a factor four left for the paired natural jump budget. -/
theorem rateCoefficient_le_naturalQuarter
    {eta Gamma d N : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    84800 * Gamma / (N * CFMNumeric.trajectoryFloor eta d) ≤
      d ^ (-CFMNumeric.coreEpsilon eta / 4) / 4 := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N := (by positivity : 0 < d ^ eta / 2).trans_le hN
  have hPpos : 0 < CFMNumeric.trajectoryFloor eta d := by
    unfold CFMNumeric.trajectoryFloor CFMNumeric.publicError
    positivity
  have hden : 0 < N * CFMNumeric.trajectoryFloor eta d := mul_pos hNpos hPpos
  have heps0 := coreEpsilon_nonneg E
  have hraw : 21708800 * Gamma ≤
      10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := by
    have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
    nlinarith [sq_nonneg Gamma]
  have hcoeff : 21708800 * Gamma ≤
      d ^ (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 4) := by
    calc
      21708800 * Gamma ≤
          10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := hraw
      _ ≤ d ^ (eta - 2 * eta ^ 3 -
          99 * CFMNumeric.coreEpsilon eta / 100) := S.zetaMainSecondOrder
      _ ≤ d ^ (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 4) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
        have heta30 : 0 ≤ eta ^ 3 := by positivity [E.eta_pos]
        linarith
  have hNP := CFMNumericAggregation.host_mul_floor_lower hd hN
  have hsmall : 339200 * Gamma ≤
      d ^ (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 4) / 64 := by
    rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 64)]
    nlinarith
  have hfactor : d ^ (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 4) / 64 =
      (d ^ (eta - eta ^ 3) / 64) *
        d ^ (-CFMNumeric.coreEpsilon eta / 4) := by
    rw [show eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 4 =
        (eta - eta ^ 3) + (-CFMNumeric.coreEpsilon eta / 4) by ring,
      Real.rpow_add hd]
    ring
  have hcross : 339200 * Gamma ≤
      (N * CFMNumeric.trajectoryFloor eta d) *
        d ^ (-CFMNumeric.coreEpsilon eta / 4) := by
    calc
      339200 * Gamma ≤
          d ^ (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 4) / 64 := hsmall
      _ = (d ^ (eta - eta ^ 3) / 64) *
          d ^ (-CFMNumeric.coreEpsilon eta / 4) := hfactor
      _ ≤ (N * CFMNumeric.trajectoryFloor eta d) *
          d ^ (-CFMNumeric.coreEpsilon eta / 4) :=
        mul_le_mul_of_nonneg_right hNP (Real.rpow_nonneg hd.le _)
  have hfour : 339200 * Gamma /
      (N * CFMNumeric.trajectoryFloor eta d) ≤
        d ^ (-CFMNumeric.coreEpsilon eta / 4) := by
    exact (div_le_iff₀ hden).2 (by simpa only [mul_comm] using hcross)
  calc
    84800 * Gamma / (N * CFMNumeric.trajectoryFloor eta d) =
        (339200 * Gamma / (N * CFMNumeric.trajectoryFloor eta d)) / 4 := by ring
    _ ≤ d ^ (-CFMNumeric.coreEpsilon eta / 4) / 4 :=
      div_le_div_of_nonneg_right hfour (by norm_num)

/-- The Taylor remainder uses the other quarter of the natural jump. -/
theorem inverseHost_le_naturalQuarter
    {eta Gamma d N : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    2 / N ≤ d ^ (-CFMNumeric.coreEpsilon eta / 4) / 4 := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N := (by positivity : 0 < d ^ eta / 2).trans_le hN
  have heps0 := coreEpsilon_nonneg E
  have hpow : (16 : ℝ) ≤
      d ^ (eta - CFMNumeric.coreEpsilon eta / 4) := by
    calc
      (16 : ℝ) ≤ 5 ^ (2 : ℕ) := by norm_num
      _ ≤ d ^ ((2 : ℝ) * CFMNumeric.coreEpsilon eta / 64) :=
        S.envelopeFifth_pow 2
      _ ≤ d ^ (eta - CFMNumeric.coreEpsilon eta / 4) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
        rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
          simp only [CFMNumeric.coreEpsilon, CFMRegularization.rawRegularizationEps]
          ring]
        linarith [E.eta_pos]
  have hcross : (8 : ℝ) ≤ N * d ^ (-CFMNumeric.coreEpsilon eta / 4) := by
    calc
      (8 : ℝ) ≤ d ^ (eta - CFMNumeric.coreEpsilon eta / 4) / 2 := by
        nlinarith
      _ = (d ^ eta / 2) * d ^ (-CFMNumeric.coreEpsilon eta / 4) := by
        rw [show eta - CFMNumeric.coreEpsilon eta / 4 =
            eta + (-CFMNumeric.coreEpsilon eta / 4) by ring,
          Real.rpow_add hd]
        ring
      _ ≤ N * d ^ (-CFMNumeric.coreEpsilon eta / 4) :=
        mul_le_mul_of_nonneg_right hN (Real.rpow_nonneg hd.le _)
  have hfour : 8 / N ≤ d ^ (-CFMNumeric.coreEpsilon eta / 4) :=
    (div_le_iff₀ hNpos).2 (by simpa only [mul_comm] using hcross)
  calc
    2 / N = (8 / N) / 4 := by ring
    _ ≤ d ^ (-CFMNumeric.coreEpsilon eta / 4) / 4 :=
      div_le_div_of_nonneg_right hfour (by norm_num)

theorem zetaRate_eq_product_of_registry
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ} {j s : ℕ}
    (R : CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P j s) :
    CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x =
      CFMTrajectories.zetaProductRate D₂ D₃ D₄ Gamma epsilon d N j s x := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end x hx)
  have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one
  exact (CFMTrajectories.hasDerivAt_zeta_rate hd R.delta.degree.N_pos hG hp
    R.s_le_j R.j_le_four).unique
      (CFMTrajectories.hasDerivAt_zeta_product hd R.delta.degree.N_pos hG hp
        R.s_le_j R.j_le_four)

theorem zetaRate_abs_le
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ} {j s : ℕ}
    (R : CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hepsilon : 0 ≤ epsilon) :
    |CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| ≤
      81800 * Gamma * d ^ ((s : ℝ) - j - epsilon / 100) / (N * P) := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end x hx)
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one R.delta.degree.Gamma_one
  have hNP : 0 < N * P := mul_pos R.delta.degree.N_pos R.delta.degree.P_pos
  have hNpV : 0 < N * CFMTrajectories.pV N x :=
    mul_pos R.delta.degree.N_pos hp
  have hNPle : N * P ≤ N * CFMTrajectories.pV N x :=
    mul_le_mul_of_nonneg_left (R.delta.degree.pV_floor x hx)
      R.delta.degree.N_pos.le
  have hgamma0 : 0 ≤ CFMTrajectories.gamma Gamma N x := by
    unfold CFMTrajectories.gamma
    positivity
  have hgamma : CFMTrajectories.gamma Gamma N x ≤
      76800 * Gamma / (N * P) := by
    unfold CFMTrajectories.gamma
    rw [div_le_div_iff₀ hNpV hNP]
    exact mul_le_mul_of_nonneg_left hNPle (by positivity)
  have hxi0 := (CFMTrajectories.xi_pos (Gamma := Gamma) (epsilon := epsilon) hd hp).le
  have hinside0 : 0 ≤ CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x :=
    (Real.rpow_nonneg hd.le _).trans (R.inside_lower x hx)
  have hzeta0 : 0 ≤
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x :=
    (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := epsilon) hd
    (lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one) hp
    (CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
      (R.delta.degree.time_nonneg x hx)) R.s_le_j).le
  have hzeta := (CFMTrajectories.zeta_bounds_of_registry R hx).2
  have hfirst : |CFMTrajectories.gamma Gamma N x *
        CFMTrajectories.xi Gamma epsilon d N x *
        CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x| ≤
      76800 * Gamma * d ^ ((s : ℝ) - j - epsilon / 100) / (N * P) := by
    rw [abs_of_nonneg (mul_nonneg (mul_nonneg hgamma0 hxi0) hinside0)]
    rw [mul_assoc, show
      CFMTrajectories.xi Gamma epsilon d N x *
          CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x =
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x by rfl]
    calc
      CFMTrajectories.gamma Gamma N x *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x ≤
        (76800 * Gamma / (N * P)) * d ^ ((s : ℝ) - j - epsilon / 100) :=
          mul_le_mul hgamma hzeta hzeta0
            (div_nonneg (mul_nonneg (by norm_num) hG0) hNP.le)
      _ = _ := by ring
  have hrate := CFMTrajectories.testInsideRate_bound_at_step
    R.delta.degree hx R.s_le_j R.j_le_four
  have hxi := R.delta.xi_upper x hx
  have hpow : d ^ (-epsilon / 64) * d ^ ((s : ℝ) - j) ≤
      d ^ ((s : ℝ) - j - epsilon / 100) := by
    rw [← Real.rpow_add hd]
    apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
    linarith
  have hsecond : |CFMTrajectories.xi Gamma epsilon d N x *
        CFMTrajectories.testInsideRate2 D₂ D₃ D₄ Gamma d N j s x| ≤
      5000 * Gamma * d ^ ((s : ℝ) - j - epsilon / 100) / (N * P) := by
    rw [abs_mul, abs_of_nonneg hxi0]
    calc
      CFMTrajectories.xi Gamma epsilon d N x *
          |CFMTrajectories.testInsideRate2 D₂ D₃ D₄ Gamma d N j s x| ≤
        d ^ (-epsilon / 64) *
          (5000 * Gamma * d ^ ((s : ℝ) - j) / (N * P)) :=
            mul_le_mul hxi hrate (abs_nonneg _)
              (Real.rpow_nonneg hd.le _)
      _ = 5000 * Gamma *
          (d ^ (-epsilon / 64) * d ^ ((s : ℝ) - j)) / (N * P) := by ring
      _ ≤ 5000 * Gamma * d ^ ((s : ℝ) - j - epsilon / 100) /
          (N * P) := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left hpow (mul_nonneg (by norm_num) hG0)) hNP.le
  rw [zetaRate_eq_product_of_registry R]
  unfold CFMTrajectories.zetaProductRate
  calc
    |CFMTrajectories.gamma Gamma N x * CFMTrajectories.xi Gamma epsilon d N x *
          CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x +
        CFMTrajectories.xi Gamma epsilon d N x *
          CFMTrajectories.testInsideRate2 D₂ D₃ D₄ Gamma d N j s x| ≤
      |CFMTrajectories.gamma Gamma N x * CFMTrajectories.xi Gamma epsilon d N x *
          CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x| +
        |CFMTrajectories.xi Gamma epsilon d N x *
          CFMTrajectories.testInsideRate2 D₂ D₃ D₄ Gamma d N j s x| :=
        abs_add_le _ _
    _ ≤ 76800 * Gamma * d ^ ((s : ℝ) - j - epsilon / 100) / (N * P) +
        5000 * Gamma * d ^ ((s : ℝ) - j - epsilon / 100) / (N * P) :=
      add_le_add hfirst hsecond
    _ = _ := by ring

theorem externalTestTrajectoryJump_le_naturalHalf
    {D₂ D₃ D₄ Gamma eta d N W : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hW : 0 ≤ W) :
    externalTestTrajectoryJump D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N W j s k ≤
      testSourceJumpScale (W * d ^ ((s : ℝ) - j)) d
        (CFMNumeric.coreEpsilon eta) / 2 := by
  let eps := CFMNumeric.coreEpsilon eta
  let a : ℝ := (s : ℝ) - j
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hN0 : 0 ≤ N := R.delta.degree.N_pos.le
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one R.delta.degree.Gamma_one
  have hP0 : 0 ≤ CFMNumeric.trajectoryFloor eta d :=
    R.delta.degree.P_pos.le
  have hden0 : 0 ≤ N * CFMNumeric.trajectoryFloor eta d :=
    mul_nonneg hN0 hP0
  have heps0 : 0 ≤ eps := by exact coreEpsilon_nonneg E
  have hzhat := CFMTrajectories.zHatRate_bound_at_step
    R.delta.degree hx R.s_le_j R.j_le_four
  have hscale : CFMTrajectories.testScale d j s = d ^ a := by
    dsimp only [a]
    exact CFMTrajectories.inv_pow_eq_rpow_sub hd R.s_le_j
  rw [hscale] at hzhat
  have hzeta := zetaRate_abs_le R heps0
  have hzetaPower : d ^ (a - eps / 100) ≤ d ^ a := by
    apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
    linarith
  have hrate :
      |CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ)| +
        |CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s (k : ℝ)| ≤
      84800 * Gamma * d ^ a /
        (N * CFMNumeric.trajectoryFloor eta d) := by
    calc
      _ ≤ 3000 * Gamma * d ^ a /
            (N * CFMNumeric.trajectoryFloor eta d) +
          81800 * Gamma * d ^ (a - eps / 100) /
            (N * CFMNumeric.trajectoryFloor eta d) := add_le_add hzhat hzeta
      _ ≤ 3000 * Gamma * d ^ a /
            (N * CFMNumeric.trajectoryFloor eta d) +
          81800 * Gamma * d ^ a /
            (N * CFMNumeric.trajectoryFloor eta d) := by
        apply add_le_add (le_refl _)
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left hzetaPower
            (mul_nonneg (by norm_num) hG0)) hden0
      _ = _ := by ring
  have hremPower : d ^ (a - eps) ≤ d ^ a := by
    apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
    linarith
  have hcoef := rateCoefficient_le_naturalQuarter E S hN
  have hinv := inverseHost_le_naturalQuarter E S hN
  have hinside :
      |CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ)| +
          |CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s (k : ℝ)| +
          2 * (d ^ (a - eps) / N) ≤
        d ^ a * d ^ (-eps / 4) / 2 := by
    calc
      _ ≤ (84800 * Gamma /
            (N * CFMNumeric.trajectoryFloor eta d)) * d ^ a +
          (2 / N) * d ^ a := by
        calc
          _ ≤ 84800 * Gamma * d ^ a /
                (N * CFMNumeric.trajectoryFloor eta d) +
              2 * (d ^ a / N) := add_le_add hrate (by
                exact mul_le_mul_of_nonneg_left
                  (div_le_div_of_nonneg_right hremPower hN0) (by norm_num))
          _ = _ := by ring
      _ ≤ (d ^ (-eps / 4) / 4) * d ^ a +
          (d ^ (-eps / 4) / 4) * d ^ a := by gcongr
      _ = d ^ a * d ^ (-eps / 4) / 2 := by ring
  unfold externalTestTrajectoryJump testSourceJumpScale
  dsimp only [eps, a] at hinside ⊢
  have hm := mul_le_mul_of_nonneg_left hinside hW
  calc
    _ ≤ W * (d ^ ((s : ℝ) - j) *
        d ^ (-CFMNumeric.coreEpsilon eta / 4) / 2) := hm
    _ = W * d ^ ((s : ℝ) - j) *
        d ^ (-CFMNumeric.coreEpsilon eta / 4) / 2 := by ring

/-- Once the pointwise root-shadow part occupies the other half of the
natural jump, the sharp source constructor has exactly its advertised
jump scale. -/
theorem raw_add_externalTestTrajectoryJump_le_natural
    {D₂ D₃ D₄ Gamma eta d N W raw : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hW : 0 ≤ W)
    (hraw : raw ≤ testSourceJumpScale
      (W * d ^ ((s : ℝ) - j)) d (CFMNumeric.coreEpsilon eta) / 2) :
    raw + externalTestTrajectoryJump D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N W j s k ≤
      testSourceJumpScale (W * d ^ ((s : ℝ) - j)) d
        (CFMNumeric.coreEpsilon eta) := by
  linarith [externalTestTrajectoryJump_le_naturalHalf E S hN R hW]

/-- Pure final aggregation for the sharp averaged square.  The two inputs
are proved independently at source scale: one by the original-test root
profiles and one by the trajectory registry. -/
theorem externalTestSharpVariance_le_freedman_of_source
    {D₂ D₃ D₄ Gamma epsilon d N W rawVariance : ℝ} {k j s : ℕ}
    (hraw : rawVariance ≤
      testSourceVarianceScale (W * d ^ ((s : ℝ) - j)) d epsilon N)
    (htraj : externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N W
        j s k ^ 2 ≤
      testSourceVarianceScale (W * d ^ ((s : ℝ) - j)) d epsilon N) :
    externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N W
        j s (fun _ ↦ rawVariance) k ≤
      CFMNumericAggregation.testFreedmanVarianceScale
        (W * d ^ ((s : ℝ) - j)) d epsilon N := by
  unfold externalTestSharpVariance
    CFMNumericAggregation.testFreedmanVarianceScale
  nlinarith

/-- The unscaled trajectory rate, retaining its crucial `1/N` factor.
This is stronger than the half-jump estimate and is the input used for
the variance budget. -/
theorem externalTestTrajectoryJump_le_rateScale
    {D₂ D₃ D₄ Gamma eta d N W : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hW : 0 ≤ W) :
    externalTestTrajectoryJump D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N W j s k ≤
      W * d ^ ((s : ℝ) - j) *
        (84800 * Gamma /
            (N * CFMNumeric.trajectoryFloor eta d) + 2 / N) := by
  let eps := CFMNumeric.coreEpsilon eta
  let a : ℝ := (s : ℝ) - j
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hN0 : 0 ≤ N := R.delta.degree.N_pos.le
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one R.delta.degree.Gamma_one
  have hP0 : 0 ≤ CFMNumeric.trajectoryFloor eta d :=
    R.delta.degree.P_pos.le
  have hden0 : 0 ≤ N * CFMNumeric.trajectoryFloor eta d :=
    mul_nonneg hN0 hP0
  have heps0 : 0 ≤ eps := coreEpsilon_nonneg E
  have hzhat := CFMTrajectories.zHatRate_bound_at_step
    R.delta.degree hx R.s_le_j R.j_le_four
  have hscale : CFMTrajectories.testScale d j s = d ^ a := by
    dsimp only [a]
    exact CFMTrajectories.inv_pow_eq_rpow_sub hd R.s_le_j
  rw [hscale] at hzhat
  have hzeta := zetaRate_abs_le R heps0
  have hzetaPower : d ^ (a - eps / 100) ≤ d ^ a := by
    apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
    linarith
  have hremPower : d ^ (a - eps) ≤ d ^ a := by
    apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
    linarith
  have hinside :
      |CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ)| +
          |CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s (k : ℝ)| +
          2 * (d ^ (a - eps) / N) ≤
        d ^ a * (84800 * Gamma /
          (N * CFMNumeric.trajectoryFloor eta d) + 2 / N) := by
    calc
      _ ≤ 3000 * Gamma * d ^ a /
              (N * CFMNumeric.trajectoryFloor eta d) +
            81800 * Gamma * d ^ (a - eps / 100) /
              (N * CFMNumeric.trajectoryFloor eta d) +
            2 * (d ^ a / N) := by
          exact add_le_add (add_le_add hzhat hzeta)
            (mul_le_mul_of_nonneg_left
              (div_le_div_of_nonneg_right hremPower hN0) (by norm_num))
      _ ≤ 3000 * Gamma * d ^ a /
              (N * CFMNumeric.trajectoryFloor eta d) +
            81800 * Gamma * d ^ a /
              (N * CFMNumeric.trajectoryFloor eta d) +
            2 * (d ^ a / N) := by
          apply add_le_add
          · apply add_le_add (le_refl _)
            exact div_le_div_of_nonneg_right
              (mul_le_mul_of_nonneg_left hzetaPower
                (mul_nonneg (by norm_num) hG0)) hden0
          · exact le_rfl
      _ = d ^ a * (84800 * Gamma /
          (N * CFMNumeric.trajectoryFloor eta d) + 2 / N) := by ring
  unfold externalTestTrajectoryJump
  dsimp only [eps, a] at hinside ⊢
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hinside hW

/-- The corrected trajectory scale has a source-scale square.  This is
where the host lower bound and the `zetaMainSecondOrder` cutoff are used;
replacing it by the coarser half-jump bound would lose the factor `1/N`. -/
theorem externalTestTrajectoryJump_sq_le_sourceVariance
    {D₂ D₃ D₄ Gamma eta d N W : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hW : 0 ≤ W) :
    externalTestTrajectoryJump D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N W j s k ^ 2 ≤
      testSourceVarianceScale (W * d ^ ((s : ℝ) - j)) d
        (CFMNumeric.coreEpsilon eta) N := by
  let eps := CFMNumeric.coreEpsilon eta
  let P := CFMNumeric.trajectoryFloor eta d
  let a : ℝ := (s : ℝ) - j
  let r := 84800 * Gamma / (N * P) + 2 / N
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < P := by
    dsimp only [P]
    unfold CFMNumeric.trajectoryFloor CFMNumeric.publicError
    positivity
  have heps0 : 0 ≤ eps := coreEpsilon_nonneg E
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hcoeff : 58908999680000 * Gamma ^ 2 ≤
      d ^ (eta - 2 * eta ^ 3 - 3 * eps / 16) := by
    calc
      58908999680000 * Gamma ^ 2 ≤
          10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := by
        nlinarith [E.Gamma_one, sq_nonneg Gamma]
      _ ≤ d ^ (eta - 2 * eta ^ 3 - 99 * eps / 100) := by
        simpa only [eps] using S.zetaMainSecondOrder
      _ ≤ d ^ (eta - 2 * eta ^ 3 - 3 * eps / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
        linarith
  have hNP := CFMNumeric.host_mul_floor_sq_lower hd hN
  have hfirstCross :
      4 * (84800 * Gamma) ^ 2 ≤
        (N * P ^ 2) * d ^ (-3 * eps / 16) := by
    calc
      4 * (84800 * Gamma) ^ 2 =
          (58908999680000 * Gamma ^ 2) / 2048 := by ring
      _ ≤ d ^ (eta - 2 * eta ^ 3 - 3 * eps / 16) / 2048 := by
        gcongr
      _ = (d ^ (eta - 2 * eta ^ 3) / 2048) *
          d ^ (-3 * eps / 16) := by
        rw [show eta - 2 * eta ^ 3 - 3 * eps / 16 =
            (eta - 2 * eta ^ 3) + (-3 * eps / 16) by ring,
          Real.rpow_add hd]
        ring
      _ ≤ (N * P ^ 2) * d ^ (-3 * eps / 16) := by
        apply mul_le_mul_of_nonneg_right
        · simpa only [P] using hNP
        · exact Real.rpow_nonneg hd.le _
  have hfirst :
      2 * (84800 * Gamma / (N * P)) ^ 2 ≤
        (d ^ (-3 * eps / 16) / N) / 2 := by
    have hcrossN := mul_le_mul_of_nonneg_left hfirstCross hNpos.le
    rw [div_pow]
    rw [show 2 * ((84800 * Gamma) ^ 2 / (N * P) ^ 2) =
        (2 * (84800 * Gamma) ^ 2) / (N * P) ^ 2 by ring]
    rw [show (d ^ (-3 * eps / 16) / N) / 2 =
        d ^ (-3 * eps / 16) / (2 * N) by ring]
    rw [div_le_div_iff₀ (sq_pos_of_pos (mul_pos hNpos hPpos))
      (mul_pos (by norm_num) hNpos)]
    calc
      2 * (84800 * Gamma) ^ 2 * (2 * N) =
          N * (4 * (84800 * Gamma) ^ 2) := by ring
      _ ≤ N * ((N * P ^ 2) * d ^ (-3 * eps / 16)) := hcrossN
      _ = d ^ (-3 * eps / 16) * (N * P) ^ 2 := by ring
  have hpow32 : (32 : ℝ) ≤ d ^ (eta - 3 * eps / 16) := by
    calc
      (32 : ℝ) ≤ d ^ (eta ^ 3) := S.stopExponentFloor
      _ ≤ d ^ (eta - 3 * eps / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
        rw [show eps = eta / 50000 by
          dsimp only [eps]
          simp only [CFMNumeric.coreEpsilon,
            CFMRegularization.rawRegularizationEps]
          ring]
        have hvertex := E.test_vertex_gap
        rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
          simp only [CFMNumeric.coreEpsilon,
            CFMRegularization.rawRegularizationEps]
          ring] at hvertex
        linarith [E.eta_pos]
  have hsecondCross : (16 : ℝ) ≤ N * d ^ (-3 * eps / 16) := by
    calc
      (16 : ℝ) ≤ d ^ (eta - 3 * eps / 16) / 2 := by nlinarith
      _ = (d ^ eta / 2) * d ^ (-3 * eps / 16) := by
        rw [show eta - 3 * eps / 16 = eta + (-3 * eps / 16) by ring,
          Real.rpow_add hd]
        ring
      _ ≤ N * d ^ (-3 * eps / 16) :=
        mul_le_mul_of_nonneg_right hN (Real.rpow_nonneg hd.le _)
  have hsecond : 2 * (2 / N) ^ 2 ≤
      (d ^ (-3 * eps / 16) / N) / 2 := by
    have hcrossN := mul_le_mul_of_nonneg_left hsecondCross hNpos.le
    rw [show 2 * (2 / N) ^ 2 = 8 / N ^ 2 by ring]
    rw [show (d ^ (-3 * eps / 16) / N) / 2 =
        d ^ (-3 * eps / 16) / (2 * N) by ring]
    rw [div_le_div_iff₀ (sq_pos_of_pos hNpos)
      (mul_pos (by norm_num) hNpos)]
    calc
      8 * (2 * N) = N * 16 := by ring
      _ ≤ N * (N * d ^ (-3 * eps / 16)) := hcrossN
      _ = d ^ (-3 * eps / 16) * N ^ 2 := by ring
  have hr0 : 0 ≤ r := by
    dsimp only [r]
    positivity
  have hrsq : r ^ 2 ≤ d ^ (-3 * eps / 16) / N := by
    dsimp only [r]
    nlinarith [sq_nonneg
      (84800 * Gamma / (N * P) - 2 / N)]
  have htraj := externalTestTrajectoryJump_le_rateScale E R hW
  have htraj0 : 0 ≤ externalTestTrajectoryJump D₂ D₃ D₄ Gamma eps d N W
      j s k := by
    unfold externalTestTrajectoryJump
    positivity
  have hscale0 : 0 ≤ W * d ^ a * r := by positivity
  have hsq :
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma eps d N W j s k ^ 2 ≤
        (W * d ^ a * r) ^ 2 :=
    (sq_le_sq₀ htraj0 hscale0).2 (by
      simpa only [eps, P, a, r] using htraj)
  calc
    externalTestTrajectoryJump D₂ D₃ D₄ Gamma eps d N W j s k ^ 2 ≤
        (W * d ^ a * r) ^ 2 := hsq
    _ = (W * d ^ a) ^ 2 * r ^ 2 := by ring
    _ ≤ (W * d ^ a) ^ 2 * (d ^ (-3 * eps / 16) / N) :=
      mul_le_mul_of_nonneg_left hrsq (sq_nonneg _)
    _ = testSourceVarianceScale (W * d ^ a) d eps N := by
      unfold testSourceVarianceScale
      let t : ℝ := d ^ (-3 * eps / 16)
      change (W * d ^ a) ^ 2 * (t / N) =
        (W * d ^ a) ^ 2 * t / N
      ring

end CFMSharpTestNatural

/-! ## Outer assembly of the unconditional specialized theorem -/

/-! ## Weighted residual and generic root-shadow closure -/

def gainCollisionResidualUnion
    (S c : Hypergraph V) (e f : Finset V) : Hypergraph V :=
  ((S ∪ c).erase e).erase f

/-- Raw rank-`r-2` residuals of all ordered source-pair certificates whose
unreduced union has rank `r`.  This coordinate is static: it has no process
state or availability argument. -/
def gainCollisionResidualRawLayer
    (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) : ConflictSystem V :=
  (H.powersetCard j).biUnion fun S ↦
    S.biUnion fun e ↦
      (S.erase e).biUnion fun f ↦
        (C.filter fun c ↦
          e ∈ c ∧ f ∈ c ∧
          (S ∪ c).card = r).image fun c ↦
            gainCollisionResidualUnion S c e f

/-- The static residual coordinate used by concentration.  Host support is
essential: without it an external common conflict edge gives a false rooted
spread statement even at `epsRaw/10`. -/
def gainCollisionResidualLayer
    (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) : ConflictSystem V :=
  (gainCollisionResidualRawLayer H C j r).filter (fun U ↦ U ⊆ H)

@[simp] theorem mem_gainCollisionResidualLayer
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {U : Hypergraph V} :
    U ∈ gainCollisionResidualLayer H C j r ↔
      U ⊆ H ∧
      ∃ S ∈ H.powersetCard j,
      ∃ e ∈ S,
      ∃ f ∈ S.erase e,
      ∃ c ∈ C,
        e ∈ c ∧ f ∈ c ∧
        (S ∪ c).card = r ∧
        gainCollisionResidualUnion S c e f = U := by
  simp [gainCollisionResidualLayer, gainCollisionResidualRawLayer,
    and_assoc, and_left_comm, and_comm]

theorem gainCollisionResidualLayer_uniform
    (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) :
    IsUniform (gainCollisionResidualLayer H C j r) (r - 2) := by
  intro U hU
  obtain ⟨hUH, S, hS, e, he, f, hf, c, hc, hec, hfc, hrank, rfl⟩ :=
    mem_gainCollisionResidualLayer.mp hU
  have hfe : f ≠ e := (Finset.mem_erase.mp hf).1
  have heUnion : e ∈ S ∪ c :=
    Finset.mem_union.mpr (Or.inl he)
  have hfUnion : f ∈ S ∪ c :=
    Finset.mem_union.mpr
      (Or.inl (Finset.mem_erase.mp hf).2)
  have hfErase : f ∈ (S ∪ c).erase e :=
    Finset.mem_erase.mpr ⟨hfe, hfUnion⟩
  have heCard := Finset.card_erase_add_one heUnion
  have hfCard := Finset.card_erase_add_one hfErase
  unfold gainCollisionResidualUnion
  rw [hrank] at heCard
  omega

/-- Representation multiplicity of one residual.  The source choice pair is
ordered, exactly as in the gain-collision defect. -/
def gainCollisionResidualRepresentationWeight
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) : TestWeight V :=
  fun U ↦
    ∑ S ∈ H.powersetCard j,
    ∑ e ∈ S,
    ∑ f ∈ S.erase e,
    ∑ c ∈ C,
      if U ⊆ H ∧ e ∈ c ∧ f ∈ c ∧
          (S ∪ c).card = r ∧
          gainCollisionResidualUnion S c e f = U
      then w S else 0

theorem gainCollisionResidualRepresentationWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (U : Hypergraph V) :
    0 ≤ gainCollisionResidualRepresentationWeight w H C j r U := by
  unfold gainCollisionResidualRepresentationWeight
  apply Finset.sum_nonneg
  intro S hS
  apply Finset.sum_nonneg
  intro e he
  apply Finset.sum_nonneg
  intro f hf
  apply Finset.sum_nonneg
  intro c hc
  split
  · exact hw S
  · norm_num

def weightedGainCollisionResidualRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  weightedCodegree
    (gainCollisionResidualLayer H C j r)
    (gainCollisionResidualRepresentationWeight w H C j r) root

def weightedGainCollisionResidualTotalMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) : ℝ :=
  ∑ U ∈ gainCollisionResidualLayer H C j r,
    gainCollisionResidualRepresentationWeight w H C j r U

def weightedGainCollisionResidualPartialMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (A M : Hypergraph V) (t : ℕ) : ℝ :=
  weightedPartialFamilyMass
    (gainCollisionResidualLayer H C j r)
    (gainCollisionResidualRepresentationWeight w H C j r) A M t

/-- Exact Fubini expansion of the supported residual partial mass. -/
theorem weightedGainCollisionResidualPartialMass_eq_representationSum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (A M : Hypergraph V) (t : ℕ) :
    weightedGainCollisionResidualPartialMass w H C j r A M t =
      ∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C,
        if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            gainCollisionResidualUnion S c e f ∈
              partialFamily (gainCollisionResidualLayer H C j r) A M t
        then w S else 0 := by
  unfold weightedGainCollisionResidualPartialMass
    weightedPartialFamilyMass
    gainCollisionResidualRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e heS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f hfS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro c hcC
  let U₀ := gainCollisionResidualUnion S c e f
  by_cases hrep : e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r
  · by_cases hpartial : U₀ ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t
    · have hsupport : U₀ ⊆ H :=
        (mem_gainCollisionResidualLayer.mp
          (mem_partialFamily.mp hpartial).1).1
      rw [if_pos ⟨hrep.1, hrep.2.1, hrep.2.2, hpartial⟩]
      rw [Finset.sum_eq_single U₀]
      · simp [U₀, hsupport, hrep]
      · intro U hU hUne
        simp [U₀, hsupport, hrep, hUne.symm]
      · exact fun hnot ↦ (hnot hpartial).elim
    · rw [if_neg (fun h ↦ hpartial h.2.2.2)]
      apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      apply hpartial
      change gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t
      rw [h.2.2.2.2]
      exact hU
  · rw [if_neg]
    · apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      exact hrep ⟨h.2.1, h.2.2.1, h.2.2.2.1⟩
    · intro h
      exact hrep ⟨h.1, h.2.1, h.2.2.1⟩

@[simp] theorem weightedGainCollisionResidualRootMass_empty
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) :
    weightedGainCollisionResidualRootMass w H C j r ∅ =
      weightedGainCollisionResidualTotalMass w H C j r := by
  simp [weightedGainCollisionResidualRootMass,
    weightedGainCollisionResidualTotalMass, weightedCodegree]

/-- Generic adapter from the rooted residual estimate to weighted spread.
The analytic theorem below will instantiate `B` with the original test
total and `sigma = epsRaw/10`. -/
theorem gainCollisionResidualLayer_isWeightedRealSpread_of_rootMass
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (d sigma B : ℝ) (hd : 0 < d)
    (hroot : ∀ root : Hypergraph V, root.card < r - 2 →
      weightedGainCollisionResidualRootMass w H C j r root ≤
        B * Real.rpow d
          ((r : ℝ) - (j : ℝ) - sigma - (root.card : ℝ))) :
    IsWeightedRealSpread
      (gainCollisionResidualLayer H C j r)
      (gainCollisionResidualRepresentationWeight w H C j r)
      (r - 2)
      (B * Real.rpow d ((r : ℝ) - (j : ℝ) - sigma)) d⁻¹ := by
  refine ⟨gainCollisionResidualLayer_uniform H C j r,
    gainCollisionResidualRepresentationWeight_nonneg hw H C j r, ?_⟩
  intro root hrootCard
  apply (hroot root hrootCard).trans_eq
  have hinv : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg hd.le _).symm
  rw [hinv]
  calc
    B * Real.rpow d
        ((r : ℝ) - (j : ℝ) - sigma - (root.card : ℝ)) =
      B * (Real.rpow d ((r : ℝ) - (j : ℝ) - sigma) *
        Real.rpow d (-(root.card : ℝ))) := by
          congr 1
          rw [show (r : ℝ) - (j : ℝ) - sigma - (root.card : ℝ) =
              ((r : ℝ) - (j : ℝ) - sigma) +
                (-(root.card : ℝ)) by ring]
          exact Real.rpow_add hd _ _
    _ = (B * Real.rpow d ((r : ℝ) - (j : ℝ) - sigma)) *
        Real.rpow d (-(root.card : ℝ)) := by ring

theorem gainCollisionResidualUnion_subset_erase_union
    (S c M : Hypergraph V) (e f : Finset V)
    (hcsub : c ⊆ insert f (insert e M)) :
    gainCollisionResidualUnion S c e f ⊆
      (S.erase e).erase f ∪ M := by
  intro g hg
  have hgUnion : g ∈ S ∪ c := by
    exact (Finset.mem_erase.mp (Finset.mem_erase.mp hg).2).2
  by_cases hgS : g ∈ S
  · apply Finset.mem_union.mpr
    apply Or.inl
    apply Finset.mem_erase.mpr
    refine ⟨(Finset.mem_erase.mp hg).1, ?_⟩
    exact Finset.mem_erase.mpr
      ⟨(Finset.mem_erase.mp (Finset.mem_erase.mp hg).2).1, hgS⟩
  · have hgc : g ∈ c :=
      (Finset.mem_union.mp hgUnion).resolve_left hgS
    rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
    · exact False.elim ((Finset.mem_erase.mp hg).1 hgf)
    · rcases Finset.mem_insert.mp hgrest with hge | hgM
      · exact False.elim
          ((Finset.mem_erase.mp (Finset.mem_erase.mp hg).2).1 hge)
      · exact Finset.mem_union.mpr (Or.inr hgM)

theorem erase_two_subset_gainCollisionResidualUnion
    (S c : Hypergraph V) (e f : Finset V) :
    (S.erase e).erase f ⊆ gainCollisionResidualUnion S c e f := by
  intro g hg
  apply Finset.mem_erase.mpr
  refine ⟨(Finset.mem_erase.mp hg).1, ?_⟩
  apply Finset.mem_erase.mpr
  refine ⟨(Finset.mem_erase.mp (Finset.mem_erase.mp hg).2).1, ?_⟩
  exact Finset.mem_union.mpr
    (Or.inl (Finset.mem_erase.mp (Finset.mem_erase.mp hg).2).2)

/-- A concrete conflict certificate behind one ordered available source
pair, with its dynamic residual already shown to lie in the chosen set. -/
theorem gainCollisionResidualCertificate_exists
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e f : Finset V}
    (heA : e ∈ availableEdges H C M)
    (hfA : f ∈ availableEdges H C M)
    (hef : e ≠ f)
    (hbad : ¬ConflictFree C (insert f (insert e M))) :
    ∃ c ∈ C,
      e ∈ c ∧ f ∈ c ∧
      c ⊆ insert f (insert e M) ∧
      gainCollisionResidualUnion S c e f ⊆
        (S.erase e).erase f ∪ M := by
  obtain ⟨c, hcC, hcsub⟩ := not_conflictFree_iff.mp hbad
  have hfreeE : ConflictFree C (insert e M) :=
    (mem_availableEdges.mp heA).2.2.2
  have hfreeF : ConflictFree C (insert f M) :=
    (mem_availableEdges.mp hfA).2.2.2
  have hfc : f ∈ c := by
    by_contra hfc
    apply hfreeE c hcC
    intro g hgc
    rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
    · exact False.elim (hfc (hgf ▸ hgc))
    · exact hgrest
  have hec : e ∈ c := by
    by_contra hec
    apply hfreeF c hcC
    intro g hgc
    rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
    · exact Finset.mem_insert.mpr (Or.inl hgf)
    · rcases Finset.mem_insert.mp hgrest with hge | hgM
      · exact False.elim (hec (hge ▸ hgc))
      · exact Finset.mem_insert_of_mem hgM
  exact ⟨c, hcC, hec, hfc, hcsub,
    gainCollisionResidualUnion_subset_erase_union S c M e f hcsub⟩

/-- Removing the two currently available certificate choices sends the
source `(s+1)` coordinate to the residual `(s-1)` coordinate. -/
theorem gainCollisionResidualUnion_mem_partial
    {H : Hypergraph V} {C : ConflictSystem V} {M S c : Hypergraph V}
    {e f : Finset V} {j s : ℕ}
    (hS : S ∈ H.powersetCard j)
    (hcoord : partialTestCondition (availableEdges H C M) M j (s + 1) S)
    (heS : e ∈ S) (hfS : f ∈ S)
    (heA : e ∈ availableEdges H C M)
    (hfA : f ∈ availableEdges H C M)
    (hef : e ≠ f) (hcC : c ∈ C)
    (hec : e ∈ c) (hfc : f ∈ c)
    (hcsub : c ⊆ insert f (insert e M))
    (hMH : M ⊆ H) :
    1 ≤ s ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily
          (gainCollisionResidualLayer H C j (S ∪ c).card)
          (availableEdges H C M) M (s - 1) := by
  let A := availableEdges H C M
  let S₀ := (S.erase e).erase f
  let U := gainCollisionResidualUnion S c e f
  have heSA : e ∈ S ∩ A := Finset.mem_inter.mpr ⟨heS, heA⟩
  have hfSA : f ∈ S ∩ A := Finset.mem_inter.mpr ⟨hfS, hfA⟩
  have hfEraseSA : f ∈ (S ∩ A).erase e :=
    Finset.mem_erase.mpr ⟨Ne.symm hef, hfSA⟩
  have heEraseCard := Finset.card_erase_add_one heSA
  have hfEraseCard := Finset.card_erase_add_one hfEraseSA
  have hs1 : 1 ≤ s := by
    have htwo : 2 ≤ (S ∩ A).card := by
      have hsub : {e, f} ⊆ S ∩ A := by
        intro g hg
        simp only [Finset.mem_insert, Finset.mem_singleton] at hg
        rcases hg with rfl | rfl
        · exact heSA
        · exact hfSA
      have hcard := Finset.card_le_card hsub
      simpa [hef] using hcard
    rw [show (S ∩ A).card = s + 1 from hcoord.1] at htwo
    omega
  have hS₀A : S₀ ∩ A = ((S ∩ A).erase e).erase f := by
    ext g
    simp only [S₀, Finset.mem_inter, Finset.mem_erase]
    tauto
  have hS₀ACard : (S₀ ∩ A).card = s - 1 := by
    rw [hS₀A]
    rw [Finset.card_erase_of_mem hfEraseSA,
      Finset.card_erase_of_mem heSA, hcoord.1]
    omega
  have hAM : Disjoint A M := by
    simpa only [A] using availableEdges_disjoint_selected H C M
  have hSCard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hSpart : (S ∩ A) ∪ (S ∩ M) = S := by
    apply Finset.eq_of_subset_of_card_le
    · intro g hg
      rcases Finset.mem_union.mp hg with hg | hg
      · exact Finset.inter_subset_left hg
      · exact Finset.inter_subset_left hg
    · rw [Finset.card_union_of_disjoint
          (hAM.mono Finset.inter_subset_right Finset.inter_subset_right),
        hcoord.1, hcoord.2, hSCard]
      omega
  have hScover : S ⊆ A ∪ M := by
    intro g hgS
    rw [← hSpart] at hgS
    rcases Finset.mem_union.mp hgS with hg | hg
    · exact Finset.mem_union.mpr
        (Or.inl (Finset.inter_subset_right hg))
    · exact Finset.mem_union.mpr
        (Or.inr (Finset.inter_subset_right hg))
  have hUsub : U ⊆ S₀ ∪ M := by
    exact gainCollisionResidualUnion_subset_erase_union S c M e f hcsub
  have hS₀U : S₀ ⊆ U := by
    exact erase_two_subset_gainCollisionResidualUnion S c e f
  have hUcover : U ⊆ A ∪ M := by
    intro g hgU
    rcases Finset.mem_union.mp (hUsub hgU) with hgS₀ | hgM
    · have hgS : g ∈ S :=
        (Finset.mem_erase.mp (Finset.mem_erase.mp hgS₀).2).2
      exact hScover hgS
    · exact Finset.mem_union.mpr (Or.inr hgM)
  have hUA : U ∩ A = S₀ ∩ A := by
    ext g
    constructor
    · intro hg
      have hgU := Finset.inter_subset_left hg
      have hgA := Finset.inter_subset_right hg
      rcases Finset.mem_union.mp (hUsub hgU) with hgS₀ | hgM
      · exact Finset.mem_inter.mpr ⟨hgS₀, hgA⟩
      · exact False.elim (Finset.disjoint_left.mp hAM hgA hgM)
    · intro hg
      exact Finset.mem_inter.mpr
        ⟨hS₀U (Finset.inter_subset_left hg),
          Finset.inter_subset_right hg⟩
  have hUpart : (U ∩ A) ∪ (U ∩ M) = U := by
    ext g
    constructor
    · intro hg
      rcases Finset.mem_union.mp hg with hg | hg
      · exact Finset.inter_subset_left hg
      · exact Finset.inter_subset_left hg
    · intro hgU
      rcases Finset.mem_union.mp (hUcover hgU) with hgA | hgM
      · exact Finset.mem_union.mpr
          (Or.inl (Finset.mem_inter.mpr ⟨hgU, hgA⟩))
      · exact Finset.mem_union.mpr
          (Or.inr (Finset.mem_inter.mpr ⟨hgU, hgM⟩))
  have hUACard : (U ∩ A).card = s - 1 := by rw [hUA, hS₀ACard]
  have hUMCard : (U ∩ M).card = U.card - (s - 1) := by
    have hdisjParts : Disjoint (U ∩ A) (U ∩ M) :=
      hAM.mono Finset.inter_subset_right Finset.inter_subset_right
    have hcard := Finset.card_union_of_disjoint hdisjParts
    rw [hUpart, hUACard] at hcard
    omega
  refine ⟨hs1, mem_partialFamily.mpr ⟨?_, hUACard, hUMCard⟩⟩
  apply mem_gainCollisionResidualLayer.mpr
  refine ⟨?_, S, hS, e, heS, f, ?_, c, hcC, hec, hfc, rfl, rfl⟩
  · exact hUcover.trans (Finset.union_subset
      (availableEdges_subset H C M) hMH)
  · exact Finset.mem_erase.mpr ⟨Ne.symm hef, hfS⟩

/-- A positive dynamic gain collision supplies a representation in one of
the four static residual ranks `r = 2,…,5`. -/
theorem gainCollisionResidualRepresentation_exists_of_matchingSupport
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e : Finset V} {j s : ℕ} {w : TestWeight V}
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition
      (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    ∃ f c r,
      r ∈ Finset.Icc 2 5 ∧
      e ∈ S ∧ f ∈ S.erase e ∧
      e ∈ availableEdges H C M ∧
      f ∈ availableEdges H C M ∧
      c ∈ C ∧ e ∈ c ∧ f ∈ c ∧
      (S ∪ c).card = r ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r)
          (availableEdges H C M) M (s - 1) := by
  obtain ⟨heSA, f, hfSA, hfe, heBlock⟩ :=
    mem_testGainCollisionChoiceSet.mp heCollision
  have heS : e ∈ S := Finset.inter_subset_left heSA
  have heA : e ∈ availableEdges H C M :=
    Finset.inter_subset_right heSA
  have hfS : f ∈ S := Finset.inter_subset_left hfSA
  have hfA : f ∈ availableEdges H C M :=
    Finset.inter_subset_right hfSA
  have hSMatching : IsMatching H S := hmatchingPos S hS hwS
  have hefDisjoint : Disjoint e f :=
    hSMatching.2 heS hfS (Ne.symm hfe)
  have heBlock' := Finset.mem_filter.mp heBlock
  have hnotAdmissible :
      ¬IsConflictFreeMatching H C (insert e (insert f M)) := by
    rcases heBlock'.2 with heq | hnot
    · exact False.elim (hfe heq.symm)
    · exact hnot
  have hmatchingEF : IsMatching H (insert e (insert f M)) := by
    rw [isMatching_insert_iff]
    refine ⟨(mem_availableEdges.mp heA).1,
      (mem_availableEdges.mp hfA).2.2.1, ?_⟩
    intro g hg hge
    rcases Finset.mem_insert.mp hg with rfl | hgM
    · exact hefDisjoint
    · exact (isMatching_insert_iff.mp
        (mem_availableEdges.mp heA).2.2.1).2.2 g hgM hge
  have hbad : ¬ConflictFree C (insert f (insert e M)) := by
    intro hfree
    apply hnotAdmissible
    refine ⟨hmatchingEF, ?_⟩
    simpa [Finset.insert_comm e f] using hfree
  obtain ⟨c, hcC, hec, hfc, hcsub, hUsub⟩ :=
    gainCollisionResidualCertificate_exists
      (S := S) heA hfA (Ne.symm hfe) hbad
  let r := (S ∪ c).card
  have hpartial := gainCollisionResidualUnion_mem_partial
    hS hcoord heS hfS heA hfA (Ne.symm hfe)
      hcC hec hfc hcsub hMH
  have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hinterTwo : 2 ≤ (S ∩ c).card := by
    have hsub : {e, f} ⊆ S ∩ c := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact Finset.mem_inter.mpr ⟨heS, hec⟩
      · exact Finset.mem_inter.mpr ⟨hfS, hfc⟩
    have hcard := Finset.card_le_card hsub
    have hpairCard : ({e, f} : Hypergraph V).card = 2 := by
      simp [Ne.symm hfe]
    rw [hpairCard] at hcard
    exact hcard
  have hUnionCard := Finset.card_union_add_card_inter S c
  have hrTwo : 2 ≤ r := by
    have hsub : {e, f} ⊆ S ∪ c := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact Finset.mem_union.mpr (Or.inl heS)
      · exact Finset.mem_union.mpr (Or.inl hfS)
    have hcard := Finset.card_le_card hsub
    have hpairCard : ({e, f} : Hypergraph V).card = 2 := by
      simp [Ne.symm hfe]
    rw [hpairCard] at hcard
    simpa only [r] using hcard
  have hrFive : r ≤ 5 := by
    have hcFour := (hCcard c hcC).2
    dsimp only [r]
    rw [hScard] at hUnionCard
    omega
  refine ⟨f, c, r, Finset.mem_Icc.mpr ⟨hrTwo, hrFive⟩,
    heS, ?_, heA, hfA, hcC, hec, hfc, rfl, ?_⟩
  · exact Finset.mem_erase.mpr ⟨hfe, hfS⟩
  · simpa only [r] using hpartial.2

theorem weightedTestGainCollisionMass_zero_of_source_zero
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j : ℕ) :
    weightedTestGainCollisionMass w H C M j 0 = 0 := by
  unfold weightedTestGainCollisionMass
  apply Finset.sum_eq_zero
  intro S hS
  by_cases hcoord :
      partialTestCondition (availableEdges H C M) M j 1 S
  · rw [if_pos hcoord]
    have hchoices : testGainCollisionChoiceSet H C M S = ∅ := by
      by_contra hne
      obtain ⟨e, heCollision⟩ := Finset.nonempty_iff_ne_empty.mpr hne
      obtain ⟨heSA, f, hfSA, hfe, heBlock⟩ :=
        mem_testGainCollisionChoiceSet.mp heCollision
      have hsub : {e, f} ⊆ S ∩ availableEdges H C M := by
        intro g hg
        simp only [Finset.mem_insert, Finset.mem_singleton] at hg
        rcases hg with rfl | rfl
        · exact heSA
        · exact hfSA
      have hcard := Finset.card_le_card hsub
      have htwo : 2 ≤ (S ∩ availableEdges H C M).card := by
        have hpairCard : ({e, f} : Hypergraph V).card = 2 := by
          simp [Ne.symm hfe]
        rw [hpairCard] at hcard
        exact hcard
      rw [hcoord.1] at htwo
      omega
    rw [hchoices]
    simp
  · rw [if_neg hcoord]

theorem weightedPartialTestGainCollision_zero_of_source_zero
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j : ℕ) :
    weightedPartialTestGainCollision w H C M j 0 = 0 := by
  rw [weightedPartialTestGainCollision_eq_weightedTestGainCollisionMass_sharp]
  exact weightedTestGainCollisionMass_zero_of_source_zero w H C M j

/-
/-- Superseded monolithic proof of the deterministic aggregate charge.
It is retained only as a source audit; the default-heartbeat proof below
factors each finite insertion into a small helper. -/
/- Deterministic aggregate charge of the gain-collision defect into the
four static supported residual ranks. -/
theorem weightedTestGainCollisionMass_le_residualPartialMass_of_matchingSupport
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H) :
    weightedTestGainCollisionMass w H C M j s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) := by
  let A := availableEdges H C M
  let Z := H.powersetCard j
  have hpoint : ∀ S ∈ Z,
      (if partialTestCondition A M j (s + 1) S then
        w S * (testGainCollisionChoiceSet H C M S).card else 0) ≤
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C,
      ∑ r ∈ Finset.Icc 2 5,
        if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            gainCollisionResidualUnion S c e f ∈
              partialFamily (gainCollisionResidualLayer H C j r)
                A M (s - 1)
        then w S else 0 := by
    intro S hSZ
    have hright0 : 0 ≤
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
        ∑ c ∈ C,
        ∑ r ∈ Finset.Icc 2 5,
          if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
              gainCollisionResidualUnion S c e f ∈
                partialFamily (gainCollisionResidualLayer H C j r)
                  A M (s - 1)
          then w S else 0 := by
      apply Finset.sum_nonneg
      intro e heS
      apply Finset.sum_nonneg
      intro f hfS
      apply Finset.sum_nonneg
      intro c hcC
      apply Finset.sum_nonneg
      intro r hr
      split
      · exact hw0 S
      · norm_num
    by_cases hcoord : partialTestCondition A M j (s + 1) S
    · rw [if_pos hcoord]
      calc
        w S * (testGainCollisionChoiceSet H C M S).card =
            ∑ e ∈ testGainCollisionChoiceSet H C M S, w S := by
          simp [mul_comm]
        _ ≤ ∑ e ∈ testGainCollisionChoiceSet H C M S,
            ∑ f ∈ S.erase e,
            ∑ c ∈ C,
            ∑ r ∈ Finset.Icc 2 5,
              if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
                  gainCollisionResidualUnion S c e f ∈
                    partialFamily (gainCollisionResidualLayer H C j r)
                      A M (s - 1)
              then w S else 0 := by
          apply Finset.sum_le_sum
          intro e heCollision
          by_cases hwS : 0 < w S
          · obtain ⟨f, c, r, hr, heS, hfS, heA, hfA,
                hcC, hec, hfc, hrank, hpartial⟩ :=
              gainCollisionResidualRepresentation_exists_of_matchingSupport
                hmatchingPos hCcard hj3 hMH hSZ hwS hcoord heCollision
            have hrLower : w S ≤
                ∑ r' ∈ Finset.Icc 2 5,
                  if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r' ∧
                      gainCollisionResidualUnion S c e f ∈
                        partialFamily (gainCollisionResidualLayer H C j r')
                          A M (s - 1)
                  then w S else 0 := by
              have hsingle := Finset.single_le_sum
                (s := Finset.Icc 2 5)
                (f := fun r' ↦
                  if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r' ∧
                      gainCollisionResidualUnion S c e f ∈
                        partialFamily (gainCollisionResidualLayer H C j r')
                          A M (s - 1)
                  then w S else 0)
                (fun r' _ ↦ by split <;> simp_all [hw0 S]) hr
              calc
                w S = if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
                        gainCollisionResidualUnion S c e f ∈
                          partialFamily (gainCollisionResidualLayer H C j r)
                            A M (s - 1)
                      then w S else 0 := by
                    rw [if_pos ⟨hec, hfc, hrank, hpartial⟩]
                _ ≤ _ := hsingle
            have hcLower : w S ≤
                ∑ c' ∈ C,
                ∑ r' ∈ Finset.Icc 2 5,
                  if e ∈ c' ∧ f ∈ c' ∧ (S ∪ c').card = r' ∧
                      gainCollisionResidualUnion S c' e f ∈
                        partialFamily (gainCollisionResidualLayer H C j r')
                          A M (s - 1)
                  then w S else 0 := by
              exact hrLower.trans (Finset.single_le_sum
                (s := C) (f := fun c' ↦
                  ∑ r' ∈ Finset.Icc 2 5,
                    if e ∈ c' ∧ f ∈ c' ∧ (S ∪ c').card = r' ∧
                        gainCollisionResidualUnion S c' e f ∈
                          partialFamily (gainCollisionResidualLayer H C j r')
                            A M (s - 1)
                    then w S else 0)
                (fun c' _ ↦ Finset.sum_nonneg fun r' _ ↦ by
                  split <;> simp_all [hw0 S]) hcC)
            exact hcLower.trans (Finset.single_le_sum
              (s := S.erase e) (f := fun f' ↦
                ∑ c' ∈ C,
                ∑ r' ∈ Finset.Icc 2 5,
                  if e ∈ c' ∧ f' ∈ c' ∧ (S ∪ c').card = r' ∧
                      gainCollisionResidualUnion S c' e f' ∈
                        partialFamily (gainCollisionResidualLayer H C j r')
                          A M (s - 1)
                  then w S else 0)
              (fun f' _ ↦ Finset.sum_nonneg fun c' _ ↦
                Finset.sum_nonneg fun r' _ ↦ by
                  split <;> simp_all [hw0 S]) hfS)
          · have hwS0 : w S = 0 := le_antisymm (not_lt.mp hwS) (hw0 S)
            rw [hwS0]
            exact Finset.sum_nonneg fun f _ ↦
              Finset.sum_nonneg fun c _ ↦
                Finset.sum_nonneg fun r _ ↦ by split <;> norm_num
        _ ≤ ∑ e ∈ S,
            ∑ f ∈ S.erase e,
            ∑ c ∈ C,
            ∑ r ∈ Finset.Icc 2 5,
              if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
                  gainCollisionResidualUnion S c e f ∈
                    partialFamily (gainCollisionResidualLayer H C j r)
                      A M (s - 1)
              then w S else 0 := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro e heCollision
            exact Finset.inter_subset_left
              (Finset.filter_subset _ _ heCollision)
          · intro e heS heNot
            exact Finset.sum_nonneg fun f _ ↦
              Finset.sum_nonneg fun c _ ↦
                Finset.sum_nonneg fun r _ ↦ by
                  split <;> simp_all [hw0 S]
    · rw [if_neg hcoord]
      exact hright0
  calc
    weightedTestGainCollisionMass w H C M j s ≤
        ∑ S ∈ Z,
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
        ∑ c ∈ C,
        ∑ r ∈ Finset.Icc 2 5,
          if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
              gainCollisionResidualUnion S c e f ∈
                partialFamily (gainCollisionResidualLayer H C j r)
                  A M (s - 1)
          then w S else 0 := by
      unfold weightedTestGainCollisionMass
      exact Finset.sum_le_sum hpoint
    _ = ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r A M (s - 1) := by
      simp_rw [weightedGainCollisionResidualPartialMass_eq_representationSum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro S hSZ
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro e heS
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro f hfS
      rw [Finset.sum_comm]
    _ = ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) := by rfl
-/

/-! ## Default-heartbeat deterministic aggregate charge -/

def gainCollisionResidualRepresentationCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) : ℝ :=
  if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t
  then w S else 0

def gainCollisionResidualRankCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) : ℝ :=
  ∑ r ∈ Finset.Icc 2 5,
    gainCollisionResidualRepresentationCharge
      w H C j r A M t S e f c

def gainCollisionResidualConflictCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) : ℝ :=
  ∑ c ∈ C,
    gainCollisionResidualRankCharge w H C j A M t S e f c

def gainCollisionResidualPairCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e : Finset V) : ℝ :=
  ∑ f ∈ S.erase e,
    gainCollisionResidualConflictCharge w H C j A M t S e f

theorem gainCollisionResidualRepresentationCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) :
    0 ≤ gainCollisionResidualRepresentationCharge
      w H C j r A M t S e f c := by
  unfold gainCollisionResidualRepresentationCharge
  split
  · exact hw0 S
  · norm_num

theorem gainCollisionResidualRankCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) :
    0 ≤ gainCollisionResidualRankCharge w H C j A M t S e f c := by
  unfold gainCollisionResidualRankCharge
  exact Finset.sum_nonneg fun r _ ↦
    gainCollisionResidualRepresentationCharge_nonneg
      hw0 H C j r A M t S e f c

theorem gainCollisionResidualConflictCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) :
    0 ≤ gainCollisionResidualConflictCharge w H C j A M t S e f := by
  unfold gainCollisionResidualConflictCharge
  exact Finset.sum_nonneg fun c _ ↦
    gainCollisionResidualRankCharge_nonneg hw0 H C j A M t S e f c

theorem gainCollisionResidualPairCharge_nonneg
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e : Finset V) :
    0 ≤ gainCollisionResidualPairCharge w H C j A M t S e := by
  unfold gainCollisionResidualPairCharge
  exact Finset.sum_nonneg fun f _ ↦
    gainCollisionResidualConflictCharge_nonneg hw0 H C j A M t S e f

theorem testWeight_le_gainCollisionResidualRankCharge
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) (r : ℕ)
    (hr : r ∈ Finset.Icc 2 5)
    (hrep : e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t) :
    w S ≤ gainCollisionResidualRankCharge w H C j A M t S e f c := by
  have heq : gainCollisionResidualRepresentationCharge
      w H C j r A M t S e f c = w S := by
    simp [gainCollisionResidualRepresentationCharge, hrep]
  calc
    w S = gainCollisionResidualRepresentationCharge
        w H C j r A M t S e f c := heq.symm
    _ ≤ gainCollisionResidualRankCharge w H C j A M t S e f c := by
      unfold gainCollisionResidualRankCharge
      exact Finset.single_le_sum
        (fun r' _ ↦ gainCollisionResidualRepresentationCharge_nonneg
          hw0 H C j r' A M t S e f c) hr

theorem testWeight_le_gainCollisionResidualConflictCharge
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) (r : ℕ)
    (hcC : c ∈ C) (hr : r ∈ Finset.Icc 2 5)
    (hrep : e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t) :
    w S ≤ gainCollisionResidualConflictCharge w H C j A M t S e f := by
  calc
    w S ≤ gainCollisionResidualRankCharge w H C j A M t S e f c :=
      testWeight_le_gainCollisionResidualRankCharge
        hw0 H C j A M t S e f c r hr hrep
    _ ≤ gainCollisionResidualConflictCharge w H C j A M t S e f := by
      unfold gainCollisionResidualConflictCharge
      exact Finset.single_le_sum
        (fun c' _ ↦ gainCollisionResidualRankCharge_nonneg
          hw0 H C j A M t S e f c') hcC

theorem testWeight_le_gainCollisionResidualPairCharge
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (A M : Hypergraph V) (t : ℕ)
    (S : Hypergraph V) (e f : Finset V) (c : Hypergraph V) (r : ℕ)
    (hfS : f ∈ S.erase e) (hcC : c ∈ C) (hr : r ∈ Finset.Icc 2 5)
    (hrep : e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily (gainCollisionResidualLayer H C j r) A M t) :
    w S ≤ gainCollisionResidualPairCharge w H C j A M t S e := by
  calc
    w S ≤ gainCollisionResidualConflictCharge w H C j A M t S e f :=
      testWeight_le_gainCollisionResidualConflictCharge
        hw0 H C j A M t S e f c r hcC hr hrep
    _ ≤ gainCollisionResidualPairCharge w H C j A M t S e := by
      unfold gainCollisionResidualPairCharge
      exact Finset.single_le_sum
        (fun f' _ ↦ gainCollisionResidualConflictCharge_nonneg
          hw0 H C j A M t S e f') hfS

theorem collisionChoice_weight_le_gainCollisionResidualPairCharge
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {j s : ℕ} {w : TestWeight V} {e : Finset V}
    (hw0 : ∀ T, 0 ≤ w T)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition
      (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    w S ≤ gainCollisionResidualPairCharge w H C j
      (availableEdges H C M) M (s - 1) S e := by
  obtain ⟨f, c, r, hr, heS, hfS, heA, hfA,
      hcC, hec, hfc, hrank, hpartial⟩ :=
    gainCollisionResidualRepresentation_exists_of_matchingSupport
      hmatchingPos hCcard hj3 hMH hS hwS hcoord heCollision
  exact testWeight_le_gainCollisionResidualPairCharge
    hw0 H C j (availableEdges H C M) M (s - 1)
      S e f c r hfS hcC hr ⟨hec, hfc, hrank, hpartial⟩

theorem weightedTestGainCollisionTerm_le_residualCharges
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ T, 0 ≤ w T)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H)
    (hS : S ∈ H.powersetCard j) :
    (if partialTestCondition (availableEdges H C M) M j (s + 1) S then
      w S * (testGainCollisionChoiceSet H C M S).card else 0) ≤
      ∑ e ∈ S, gainCollisionResidualPairCharge w H C j
        (availableEdges H C M) M (s - 1) S e := by
  by_cases hcoord :
      partialTestCondition (availableEdges H C M) M j (s + 1) S
  · rw [if_pos hcoord]
    calc
      w S * (testGainCollisionChoiceSet H C M S).card =
          ∑ e ∈ testGainCollisionChoiceSet H C M S, w S := by
        simp [mul_comm]
      _ ≤ ∑ e ∈ testGainCollisionChoiceSet H C M S,
          gainCollisionResidualPairCharge w H C j
            (availableEdges H C M) M (s - 1) S e := by
        apply Finset.sum_le_sum
        intro e heCollision
        by_cases hwS : 0 < w S
        · exact collisionChoice_weight_le_gainCollisionResidualPairCharge
            hw0 hmatchingPos hCcard hj3 hMH hS hwS hcoord heCollision
        · have hwS0 : w S = 0 := le_antisymm (not_lt.mp hwS) (hw0 S)
          rw [hwS0]
          exact gainCollisionResidualPairCharge_nonneg
            hw0 H C j (availableEdges H C M) M (s - 1) S e
      _ ≤ ∑ e ∈ S, gainCollisionResidualPairCharge w H C j
          (availableEdges H C M) M (s - 1) S e := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro e heCollision
          exact Finset.inter_subset_left
            (Finset.filter_subset _ _ heCollision)
        · intro e heS heNot
          exact gainCollisionResidualPairCharge_nonneg
            hw0 H C j (availableEdges H C M) M (s - 1) S e
  · rw [if_neg hcoord]
    exact Finset.sum_nonneg fun e _ ↦
      gainCollisionResidualPairCharge_nonneg
        hw0 H C j (availableEdges H C M) M (s - 1) S e

theorem sum_gainCollisionResidualPairCharges_eq_partialMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) :
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S, gainCollisionResidualPairCharge w H C j
        (availableEdges H C M) M (s - 1) S e) =
      ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) := by
  simp_rw [weightedGainCollisionResidualPartialMass_eq_representationSum]
  unfold gainCollisionResidualPairCharge
    gainCollisionResidualConflictCharge gainCollisionResidualRankCharge
    gainCollisionResidualRepresentationCharge
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e he
  calc
    (∑ f ∈ S.erase e,
      ∑ c ∈ C,
        ∑ r ∈ Finset.Icc 2 5,
          if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
              gainCollisionResidualUnion S c e f ∈
                partialFamily (gainCollisionResidualLayer H C j r)
                  (availableEdges H C M) M (s - 1)
          then w S else 0) =
        ∑ f ∈ S.erase e,
          ∑ r ∈ Finset.Icc 2 5,
            ∑ c ∈ C,
              if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
                  gainCollisionResidualUnion S c e f ∈
                    partialFamily (gainCollisionResidualLayer H C j r)
                      (availableEdges H C M) M (s - 1)
              then w S else 0 := by
      apply Finset.sum_congr rfl
      intro f hf
      rw [Finset.sum_comm]
    _ = ∑ r ∈ Finset.Icc 2 5,
          ∑ f ∈ S.erase e,
            ∑ c ∈ C,
              if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
                  gainCollisionResidualUnion S c e f ∈
                    partialFamily (gainCollisionResidualLayer H C j r)
                      (availableEdges H C M) M (s - 1)
              then w S else 0 := by
      rw [Finset.sum_comm]

/-- Deterministic aggregate charge of the gain-collision defect into the
four static supported residual ranks, factored for the default heartbeat
limit. -/
theorem weightedTestGainCollisionMass_le_residualPartialMass_of_matchingSupport
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H) :
    weightedTestGainCollisionMass w H C M j s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) := by
  calc
    weightedTestGainCollisionMass w H C M j s ≤
        ∑ S ∈ H.powersetCard j,
          ∑ e ∈ S, gainCollisionResidualPairCharge w H C j
            (availableEdges H C M) M (s - 1) S e := by
      unfold weightedTestGainCollisionMass
      apply Finset.sum_le_sum
      intro S hS
      exact weightedTestGainCollisionTerm_le_residualCharges
        hw0 hmatchingPos hCcard hj3 hMH hS
    _ = ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) :=
      sum_gainCollisionResidualPairCharges_eq_partialMass w H C M j s

/-- The exact sharp gain-collision observable used by the mean endpoint is
definitionally the collision mass charged above. -/
theorem weightedPartialTestGainCollision_le_residualPartialMass_of_matchingSupport
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj3 : j ≤ 3) (hMH : M ⊆ H) :
    weightedPartialTestGainCollision w H C M j s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) := by
  rw [weightedPartialTestGainCollision_eq_weightedTestGainCollisionMass_sharp]
  exact weightedTestGainCollisionMass_le_residualPartialMass_of_matchingSupport
    hw0 hmatchingPos hCcard hj3 hMH

theorem weightedPartialTestGainCollision_le_residualPartialMass_of_trackable
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j ell s : ℕ} {d etaW etaC Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d etaW w)
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma etaC)
    (hj3 : j ≤ 3) (hMH : M ⊆ H) :
    weightedPartialTestGainCollision w H C M j s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass w H C j r
          (availableEdges H C M) M (s - 1) := by
  apply weightedPartialTestGainCollision_le_residualPartialMass_of_matchingSupport
    hw.isTestFunction.nonneg
  · intro T hT hpos
    by_contra hnot
    have hz := hw.isTestFunction.eq_zero_of_not_matching hnot
    linarith
  · intro c hc
    exact hB.conflict_card hc
  · exact hj3
  · exact hMH

theorem CFMRegularization.RegularizationCertificate.weightedPartialInternalTestGainCollision_le_residualPartialMass
    {io : Type*} [Fintype io]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw Gamma : ℝ} {ellCert : ℕ}
    {publicJ : io → ℕ} {publicW : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert publicJ publicW)
    {M : Hypergraph V} (hMH : M ⊆ H)
    (f₀ : Finset V) (q s : ℕ) (hq3 : q ≤ 3) :
    weightedPartialTestGainCollision
        (conflictLinkTestWeight R.regularized f₀ q)
        H R.regularized M q s ≤
      ∑ r ∈ Finset.Icc 2 5,
        weightedGainCollisionResidualPartialMass
          (conflictLinkTestWeight R.regularized f₀ q)
          H R.regularized q r (availableEdges H R.regularized M) M (s - 1) := by
  apply weightedPartialTestGainCollision_le_residualPartialMass_of_matchingSupport
  · intro S
    by_cases hS : S ∈ conflictLinkLayer R.regularized f₀ q <;>
      simp [conflictLinkTestWeight, hS]
  · intro S hS hpos
    exact conflictLinkTestWeight_matching_of_pos_sharp
      R.conflictMatching hpos
  · intro c hc
    exact R.bounded.conflict_card hc
  · exact hq3
  · exact hMH

def gainCollisionResidualSource
    (S : Hypergraph V) (e f : Finset V) : Hypergraph V :=
  (S.erase e).erase f

def gainCollisionResidualConflict
    (c : Hypergraph V) (e f : Finset V) : Hypergraph V :=
  (c.erase e).erase f

theorem gainCollisionResidualUnion_eq_source_union_conflict
    (S c : Hypergraph V) (e f : Finset V) :
    gainCollisionResidualUnion S c e f =
      gainCollisionResidualSource S e f ∪
        gainCollisionResidualConflict c e f := by
  ext g
  simp [gainCollisionResidualUnion, gainCollisionResidualSource,
    gainCollisionResidualConflict]
  tauto

theorem gainCollisionResidualConflict_sdiff_source
    {S c : Hypergraph V} {e f : Finset V}
    (heS : e ∈ S) (hfS : f ∈ S) :
    gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f = c \ S := by
  ext g
  constructor
  · intro hg
    have hgConflict := Finset.mem_sdiff.mp hg
    have hgf := (Finset.mem_erase.mp hgConflict.1).1
    have hgInner := (Finset.mem_erase.mp hgConflict.1).2
    have hge := (Finset.mem_erase.mp hgInner).1
    have hgc := (Finset.mem_erase.mp hgInner).2
    refine Finset.mem_sdiff.mpr ⟨hgc, ?_⟩
    intro hgS
    apply hgConflict.2
    exact Finset.mem_erase.mpr ⟨hgf,
      Finset.mem_erase.mpr ⟨hge, hgS⟩⟩
  · intro hg
    have hgc := (Finset.mem_sdiff.mp hg).1
    have hgS := (Finset.mem_sdiff.mp hg).2
    have hge : g ≠ e := fun h ↦ hgS (h ▸ heS)
    have hgf : g ≠ f := fun h ↦ hgS (h ▸ hfS)
    apply Finset.mem_sdiff.mpr
    refine ⟨Finset.mem_erase.mpr ⟨hgf,
      Finset.mem_erase.mpr ⟨hge, hgc⟩⟩, ?_⟩
    intro hgSource
    exact hgS ((Finset.mem_erase.mp
      (Finset.mem_erase.mp hgSource).2).2)

theorem card_gainCollisionResidualSource
    {S : Hypergraph V} {e f : Finset V}
    (heS : e ∈ S) (hfS : f ∈ S) (hef : e ≠ f) :
    (gainCollisionResidualSource S e f).card = S.card - 2 := by
  have hfErase : f ∈ S.erase e :=
    Finset.mem_erase.mpr ⟨Ne.symm hef, hfS⟩
  unfold gainCollisionResidualSource
  rw [Finset.card_erase_of_mem hfErase, Finset.card_erase_of_mem heS]
  omega

theorem card_gainCollisionResidualConflict
    {c : Hypergraph V} {e f : Finset V}
    (hec : e ∈ c) (hfc : f ∈ c) (hef : e ≠ f) :
    (gainCollisionResidualConflict c e f).card = c.card - 2 := by
  have hfErase : f ∈ c.erase e :=
    Finset.mem_erase.mpr ⟨Ne.symm hef, hfc⟩
  unfold gainCollisionResidualConflict
  rw [Finset.card_erase_of_mem hfErase, Finset.card_erase_of_mem hec]
  omega

theorem card_residualConflict_sdiff_source_eq_union_sub
    {S c : Hypergraph V} {e f : Finset V}
    (heS : e ∈ S) (hfS : f ∈ S) :
    (gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f).card =
      (S ∪ c).card - S.card := by
  rw [gainCollisionResidualConflict_sdiff_source heS hfS]
  have hcard := Finset.card_union_add_card_inter S c
  have hdiff := Finset.card_sdiff_add_card_inter c S
  rw [Finset.inter_comm S c] at hcard
  omega

theorem residual_root_source_card_le_one
    {S c root : Hypergraph V} {e f : Finset V} {j r : ℕ}
    (hS : S ∈ (S ∪ c).powersetCard j)
    (heS : e ∈ S) (hfS : f ∈ S) (hef : e ≠ f)
    (hj3 : j ≤ 3)
    (hroot : root ⊆ gainCollisionResidualUnion S c e f) :
    (root ∩ gainCollisionResidualSource S e f).card ≤ 1 := by
  have hScard : S.card = j :=
    (Finset.mem_powersetCard.mp hS).2
  have hinter : root ∩ gainCollisionResidualSource S e f ⊆
      gainCollisionResidualSource S e f := Finset.inter_subset_right
  have hle := Finset.card_le_card hinter
  rw [card_gainCollisionResidualSource heS hfS hef, hScard] at hle
  omega

/-- Exact representation expansion of the supported residual root mass. -/
theorem weightedGainCollisionResidualRootMass_eq_representationSum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) :
    weightedGainCollisionResidualRootMass w H C j r root =
      ∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f
        then w S else 0 := by
  unfold weightedGainCollisionResidualRootMass weightedCodegree
    gainCollisionResidualRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hSH
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e heS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f hfS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro c hcC
  let U₀ := gainCollisionResidualUnion S c e f
  by_cases hrep : U₀ ⊆ H ∧ e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r
  · by_cases hroot : root ⊆ U₀
    · have hmem : U₀ ∈
          (gainCollisionResidualLayer H C j r).filter (root ⊆ ·) := by
        apply Finset.mem_filter.mpr
        refine ⟨mem_gainCollisionResidualLayer.mpr ?_, hroot⟩
        refine ⟨hrep.1, S, hSH, e, heS, f, hfS, c, hcC,
          hrep.2.1, hrep.2.2.1, hrep.2.2.2, rfl⟩
      rw [if_pos ⟨hrep.1, hrep.2.1, hrep.2.2.1,
        hrep.2.2.2, hroot⟩]
      rw [Finset.sum_eq_single U₀]
      · simp [U₀, hrep]
      · intro U hU hUne
        simp [U₀, hrep, hUne.symm]
      · exact fun hnot ↦ (hnot hmem).elim
    · rw [if_neg (fun h ↦ hroot h.2.2.2.2)]
      apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      apply hroot
      change root ⊆ gainCollisionResidualUnion S c e f
      rw [h.2.2.2.2]
      exact (Finset.mem_filter.mp hU).2
  · rw [if_neg]
    · apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      apply hrep
      refine ⟨?_, h.2.1, h.2.2.1, h.2.2.2.1⟩
      change gainCollisionResidualUnion S c e f ⊆ H
      rw [h.2.2.2.2]
      exact h.1
    · intro h
      exact hrep ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1⟩

/-- The part of the rooted mass for which the requested external root does
not yet contain all conflict-residual edges outside the source residual. -/
def weightedGainCollisionResidualNonFullRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
  ∑ c ∈ C,
    if gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        ¬ gainCollisionResidualConflict c e f \
            gainCollisionResidualSource S e f ⊆ root
    then w S else 0

/-- The complementary boundary mass. -/
def weightedGainCollisionResidualFullRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
  ∑ c ∈ C,
    if gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
            gainCollisionResidualSource S e f ⊆ root
    then w S else 0

theorem weightedGainCollisionResidualRootMass_eq_nonFull_add_full
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) :
    weightedGainCollisionResidualRootMass w H C j r root =
      weightedGainCollisionResidualNonFullRootMass w H C j r root +
        weightedGainCollisionResidualFullRootMass w H C j r root := by
  rw [weightedGainCollisionResidualRootMass_eq_representationSum]
  unfold weightedGainCollisionResidualNonFullRootMass
    weightedGainCollisionResidualFullRootMass
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro S hS
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e he
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro f hf
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro c hc
  by_cases hb : gainCollisionResidualUnion S c e f ⊆ H ∧
    e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      root ⊆ gainCollisionResidualUnion S c e f
  · by_cases hf' : gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f ⊆ root <;> simp [hb, hf']
  · have hn : ¬(gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        ¬(gainCollisionResidualConflict c e f \
          gainCollisionResidualSource S e f ⊆ root)) := fun h ↦
      hb ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1⟩
    have hy : ¬(gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
          gainCollisionResidualSource S e f ⊆ root) := fun h ↦
      hb ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1⟩
    rw [if_neg hb, if_neg hn, if_neg hy, zero_add]

theorem positive_residual_representation_external_nonempty
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    {S c : Hypergraph V} {e f : Finset V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcC : c ∈ C) (heS : e ∈ S) (hfS : f ∈ S)
    (hec : e ∈ c) (hfc : f ∈ c) (hef : e ≠ f) :
    (gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f).Nonempty := by
  rw [gainCollisionResidualConflict_sdiff_source heS hfS]
  by_contra hempty
  have hcS : c ⊆ S := by
    intro g hgc
    by_contra hgS
    exact hempty ⟨g, Finset.mem_sdiff.mpr ⟨hgc, hgS⟩⟩
  have hz := hw.eq_zero_of_contains_conflict hS ⟨c, hcC, hcS⟩
  linarith

theorem positive_residual_representation_rank_sub_pos
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    {S c : Hypergraph V} {e f : Finset V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcC : c ∈ C) (heS : e ∈ S) (hfS : f ∈ S)
    (hec : e ∈ c) (hfc : f ∈ c) (hef : e ≠ f)
    (hrank : (S ∪ c).card = r) :
    1 ≤ r - j := by
  have hne := positive_residual_representation_external_nonempty
    (r := r) hw hS hwS hcC heS hfS hec hfc hef
  have hcardpos : 0 <
      (gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f).card :=
    Finset.card_pos.mpr hne
  have hScard : S.card = j :=
    (Finset.mem_powersetCard.mp hS).2
  rw [card_residualConflict_sdiff_source_eq_union_sub heS hfS,
    hrank, hScard] at hcardpos
  omega

/-- In the present `j ≤ 3`, `|c| ≤ 4` application the residual has at
most two genuinely external edges. -/
theorem positive_residual_representation_rank_sub_le_two
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    {S c : Hypergraph V} {e f : Finset V}
    (hS : S ∈ H.powersetCard j) (hcC : c ∈ C)
    (heS : e ∈ S) (hfS : f ∈ S)
    (hec : e ∈ c) (hfc : f ∈ c) (hef : e ≠ f)
    (hrank : (S ∪ c).card = r) :
    r - j ≤ 2 := by
  have hScard : S.card = j :=
    (Finset.mem_powersetCard.mp hS).2
  have hdiffSub : c \ S ⊆ (c.erase e).erase f := by
    intro g hg
    have hgc := (Finset.mem_sdiff.mp hg).1
    have hgS := (Finset.mem_sdiff.mp hg).2
    exact Finset.mem_erase.mpr ⟨fun hgf ↦ hgS (hgf ▸ hfS),
      Finset.mem_erase.mpr ⟨fun hge ↦ hgS (hge ▸ heS), hgc⟩⟩
  have hcardLe := Finset.card_le_card hdiffSub
  have hc4 := (hB.conflict_card hcC).2
  have hconfCard := card_gainCollisionResidualConflict hec hfc hef
  have hunion := Finset.card_union_add_card_inter S c
  have hdiff := Finset.card_sdiff_add_card_inter c S
  rw [Finset.inter_comm S c] at hunion
  change (c \ S).card ≤ (gainCollisionResidualConflict c e f).card at hcardLe
  rw [hconfCard] at hcardLe
  rw [hrank, hScard] at hunion
  omega

/-- There are only five positive cardinality patterns.  This finite audit is
useful in the final proof because `T.card = j-2` and hence every nonempty
source part of a residual root is a singleton. -/
theorem positive_residual_representation_rank_cases
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hj3 : j ≤ 3)
    {S c : Hypergraph V} {e f : Finset V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcC : c ∈ C) (heS : e ∈ S) (hfS : f ∈ S)
    (hec : e ∈ c) (hfc : f ∈ c) (hef : e ≠ f)
    (hrank : (S ∪ c).card = r) :
    (j = 2 ∧ c.card = 3 ∧ (S ∩ c).card = 2 ∧ r = 3) ∨
    (j = 2 ∧ c.card = 4 ∧ (S ∩ c).card = 2 ∧ r = 4) ∨
    (j = 3 ∧ c.card = 3 ∧ (S ∩ c).card = 2 ∧ r = 4) ∨
    (j = 3 ∧ c.card = 4 ∧ (S ∩ c).card = 2 ∧ r = 5) ∨
    (j = 3 ∧ c.card = 4 ∧ (S ∩ c).card = 3 ∧ r = 4) := by
  have hScard : S.card = j :=
    (Finset.mem_powersetCard.mp hS).2
  have hcommon : 2 ≤ (S ∩ c).card := by
    have hsub : {e, f} ⊆ S ∩ c := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact Finset.mem_inter.mpr ⟨heS, hec⟩
      · exact Finset.mem_inter.mpr ⟨hfS, hfc⟩
    have hle := Finset.card_le_card hsub
    simpa [hef] using hle
  have hinterS : (S ∩ c).card ≤ j := by
    rw [← hScard]
    exact Finset.card_le_card Finset.inter_subset_left
  have hinterC : (S ∩ c).card ≤ c.card :=
    Finset.card_le_card Finset.inter_subset_right
  have hproper : (S ∩ c).card < c.card := by
    have hne := positive_residual_representation_external_nonempty
      (r := r) hw hS hwS hcC heS hfS hec hfc hef
    rw [gainCollisionResidualConflict_sdiff_source heS hfS] at hne
    have hdiffPos : 0 < (c \ S).card := Finset.card_pos.mpr hne
    have hdiff := Finset.card_sdiff_add_card_inter c S
    rw [Finset.inter_comm c S] at hdiff
    omega
  have hcBounds := hB.conflict_card hcC
  have hunion := Finset.card_union_add_card_inter S c
  rw [hScard, hrank] at hunion
  omega

/-- Abstract proper-root source interface shared by the external test and
the internal link test.  A separate boundary estimate is deliberately not
included: when `D.card = j`, the external adapter uses the pointwise cap and
W1, whereas the internal adapter must use the certificate conflict paired
with the represented conflict. -/
def HasGainCollisionResidualProperSourceBounds
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (d eta W K ellSrc : ℝ) : Prop :=
  (∀ S, 0 ≤ w S) ∧
  testTotal w H j ≤ W ∧
  (∀ S ∈ H.powersetCard j, 0 < w S →
    ∀ c ∈ C, ¬c ⊆ S) ∧
  (∀ D : Hypergraph V, D ⊆ H → 1 ≤ D.card → D.card < j →
    testExtension w H j D ≤
      K * W / Real.rpow d ((D.card : ℝ) + eta)) ∧
  (∀ S, w S ≤ ellSrc)

/-- Conditional boundary interface for a full-card source root, where
`testExtension` is pointwise rather than relatively small.  This field does
not follow from `HasGainCollisionResidualProperSourceBounds`.

In particular, the regularization certificate does *not* supply this
interface unconditionally for `conflictLinkTestWeight`.  At a singleton root
`{g}`, the exceptional case `{g, f₀} ∈ C²` may have many common `j`-links.
The certificate's ordinary common-link bound excludes exactly this pair, and
the C* family only covers common links containing an additional immediate
evictor.  An internal use must therefore first restrict to dynamically
relevant roots (for example, availability of `f₀` excludes such a `g`) or
assume this boundary estimate explicitly. -/
def HasGainCollisionResidualFullCardCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (d eta W K : ℝ) : Prop :=
  ∀ root : Hypergraph V, root ⊆ H → 1 ≤ root.card → root.card ≤ 2 →
    (∑ q ∈ Finset.Icc 2 4,
      ∑ c ∈ (conflictLayer C q).filter
        (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
        testExtension w H j (c \ root)) ≤
      K * W * Real.rpow d (-eta)

theorem trackable_hasGainCollisionResidualProperSourceBounds
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 0 < d) :
    HasGainCollisionResidualProperSourceBounds
      w H C j d (epsRaw / 5) (testTotal w H j) 1 ell := by
  refine ⟨hw.isTestFunction.nonneg, le_rfl, ?_, ?_, ?_⟩
  · intro S hS hwS c hcC hcS
    exact (ne_of_gt hwS) (hw.eq_zero_of_contains_conflict hS ⟨c, hcC, hcS⟩)
  · intro D hDH hD1 hDj
    have h := hw.extension_upper hD1 hDj D hDH rfl
    simpa only [one_mul] using h
  · intro S
    exact hw.isTestFunction.le S

/-- Geometry of the only C3 boundary.  If the source part of the requested
root is empty and all external conflict edges are already rooted, then the
root is exactly `c \ S`; consequently `c \ root` is a nonempty source root
containing the ordered pair. -/
theorem full_emptySourceRoot_geometry
    {H : Hypergraph V} {S c root : Hypergraph V} {e f : Finset V}
    (hsupport : gainCollisionResidualUnion S c e f ⊆ H)
    (heS : e ∈ S) (hfS : f ∈ S) (hef : e ≠ f)
    (hec : e ∈ c) (hfc : f ∈ c)
    (hroot : root ⊆ gainCollisionResidualUnion S c e f)
    (hfull : gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆ root)
    (hempty : Disjoint root (gainCollisionResidualSource S e f)) :
    root = c \ S ∧ root ⊆ H ∧ c \ root ⊆ S ∧
      e ∈ c \ root ∧ f ∈ c \ root := by
  let T := gainCollisionResidualSource S e f
  let R := gainCollisionResidualConflict c e f
  have heT : e ∉ T := by simp [T, gainCollisionResidualSource]
  have hfT : f ∉ T := by simp [T, gainCollisionResidualSource]
  have heR : e ∉ R := by simp [R, gainCollisionResidualConflict]
  have hfR : f ∉ R := by simp [R, gainCollisionResidualConflict]
  have hrootEq : root = R \ T := by
    apply Finset.Subset.antisymm
    · intro g hgroot
      have hgU := hroot hgroot
      rw [gainCollisionResidualUnion_eq_source_union_conflict] at hgU
      have hgTnot : g ∉ T := by
        exact Finset.disjoint_left.mp hempty hgroot
      have hgR : g ∈ R :=
        (Finset.mem_union.mp hgU).resolve_left hgTnot
      exact Finset.mem_sdiff.mpr ⟨hgR, hgTnot⟩
    · exact hfull
  have hrootCS : root = c \ S := by
    rw [hrootEq]
    exact gainCollisionResidualConflict_sdiff_source heS hfS
  have hrootH : root ⊆ H := hroot.trans hsupport
  have hDsub : c \ root ⊆ S := by
    intro g hg
    have hgc := (Finset.mem_sdiff.mp hg).1
    have hgroot := (Finset.mem_sdiff.mp hg).2
    by_contra hgS
    exact hgroot (hrootCS.symm ▸ Finset.mem_sdiff.mpr ⟨hgc, hgS⟩)
  refine ⟨hrootCS, hrootH, hDsub, ?_, ?_⟩
  · exact Finset.mem_sdiff.mpr ⟨hec, fun heroot ↦
      (Finset.mem_sdiff.mp (hrootCS ▸ heroot)).2 heS⟩
  · exact Finset.mem_sdiff.mpr ⟨hfc, fun hfroot ↦
      (Finset.mem_sdiff.mp (hrootCS ▸ hfroot)).2 hfS⟩

theorem full_emptySourceRoot_sourceRoot_card_bounds
    {H : Hypergraph V} {S c root : Hypergraph V} {e f : Finset V}
    {j : ℕ}
    (hS : S ∈ H.powersetCard j)
    (hsupport : gainCollisionResidualUnion S c e f ⊆ H)
    (heS : e ∈ S) (hfS : f ∈ S) (hef : e ≠ f)
    (hec : e ∈ c) (hfc : f ∈ c)
    (hroot : root ⊆ gainCollisionResidualUnion S c e f)
    (hfull : gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆ root)
    (hempty : Disjoint root (gainCollisionResidualSource S e f)) :
    2 ≤ (c \ root).card ∧ (c \ root).card ≤ j ∧
      c \ root ⊆ H := by
  have hgeom := full_emptySourceRoot_geometry hsupport heS hfS hef
    hec hfc hroot hfull hempty
  have hpair : {e, f} ⊆ c \ root := by
    intro g hg
    simp only [Finset.mem_insert, Finset.mem_singleton] at hg
    rcases hg with rfl | rfl
    · exact hgeom.2.2.2.1
    · exact hgeom.2.2.2.2
  have htwo := Finset.card_le_card hpair
  have hDcard : (c \ root).card ≤ j := by
    rw [← (Finset.mem_powersetCard.mp hS).2]
    exact Finset.card_le_card hgeom.2.2.1
  refine ⟨?_, hDcard, hgeom.2.2.1.trans
    (Finset.mem_powersetCard.mp hS).1⟩
  simpa [hef] using htwo

/-- Supported one-edge roots can use (C2), while roots of cardinality at
least two use (C3).  This is the conflict-count half of the full/empty
boundary reindexing. -/
theorem supported_conflict_root_codegree_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw Gamma : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    {q : ℕ} (hq2 : 2 ≤ q) (hq4 : q ≤ 4)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) (hrootq : root.card < q) :
    (codegree (conflictLayer C q) root : ℝ) ≤
      (Gamma + 1) * Real.rpow d
        ((q : ℝ) - (root.card : ℝ)) := by
  have hdpos : 0 < d := by linarith
  have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hdpos
  rcases hroot1.eq_or_lt with hcardOne | hcardTwo
  · obtain ⟨g, rfl⟩ := Finset.card_eq_one.mp hcardOne.symm
    have hgH : g ∈ H := hrootH (Finset.mem_singleton_self g)
    have hdegree : (codegree (conflictLayer C q) {g} : ℝ) =
        (degree (conflictLayer C q) g : ℝ) := by
      congr 1
      unfold codegree degree
      congr 1
      ext c
      simp
    rw [hdegree]
    have hC2 : (degree (conflictLayer C q) g : ℝ) ≤
        Gamma * Real.rpow d ((q : ℝ) - 1) := by
      calc
        (degree (conflictLayer C q) g : ℝ) ≤
            (CFMRegularization.layerMaxDegree H C q : ℝ) := by
          exact_mod_cast CFMRegularization.degree_layer_le_layerMaxDegree hgH
        _ ≤ Gamma * Real.rpow d ((q : ℝ) - 1) :=
          layerMaxDegree_le_Gamma_mul_rpow hB hdpos hq2 hq4
    exact hC2.trans (by
      have hcoef : Gamma ≤ Gamma + 1 := by linarith
      simpa using mul_le_mul_of_nonneg_right hcoef
        (Real.rpow_nonneg (by linarith : 0 ≤ d) ((q : ℝ) - 1)))
  · have hC3 := hB.layer_codegree hq2 hq4 hcardTwo hrootq root rfl
    have hcoef : (1 : ℝ) ≤ Gamma + 1 := by linarith
    calc
      (codegree (conflictLayer C q) root : ℝ) ≤
          Real.rpow d
            ((q : ℝ) - (root.card : ℝ) - epsRaw / 4) := hC3
      _ ≤ Real.rpow d ((q : ℝ) - (root.card : ℝ)) := by
        apply Real.rpow_le_rpow_of_exponent_le hd
        linarith
      _ ≤ (Gamma + 1) * Real.rpow d
            ((q : ℝ) - (root.card : ℝ)) := by
        exact (le_mul_iff_one_le_left
          (Real.rpow_pos_of_pos hdpos _)).2 hcoef

def weightedGainCollisionResidualFullEmptySourceRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
  ∑ c ∈ C,
    if gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
            gainCollisionResidualSource S e f ⊆ root ∧
        Disjoint root (gainCollisionResidualSource S e f)
    then w S else 0

def weightedGainCollisionResidualFullNonemptySourceRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
  ∑ c ∈ C,
    if gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
            gainCollisionResidualSource S e f ⊆ root ∧
        ¬Disjoint root (gainCollisionResidualSource S e f)
    then w S else 0

theorem weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) :
    weightedGainCollisionResidualFullRootMass w H C j r root =
      weightedGainCollisionResidualFullEmptySourceRootMass
          w H C j r root +
        weightedGainCollisionResidualFullNonemptySourceRootMass
          w H C j r root := by
  unfold weightedGainCollisionResidualFullRootMass
    weightedGainCollisionResidualFullEmptySourceRootMass
    weightedGainCollisionResidualFullNonemptySourceRootMass
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro S hS
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e he
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro f hf
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro c hc
  by_cases hb : gainCollisionResidualUnion S c e f ⊆ H ∧
    e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      root ⊆ gainCollisionResidualUnion S c e f ∧
      gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f ⊆ root
  · by_cases hm : Disjoint root (gainCollisionResidualSource S e f) <;>
      simp [hb, hm]
  · have he : ¬(gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
          gainCollisionResidualSource S e f ⊆ root ∧
        Disjoint root (gainCollisionResidualSource S e f)) := fun h ↦
      hb ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1,
        h.2.2.2.2.1, h.2.2.2.2.2.1⟩
    have hn : ¬(gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
          gainCollisionResidualSource S e f ⊆ root ∧
        ¬Disjoint root (gainCollisionResidualSource S e f)) := fun h ↦
      hb ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1,
        h.2.2.2.2.1, h.2.2.2.2.2.1⟩
    rw [if_neg hb, if_neg he, if_neg hn, zero_add]

/-- For fixed `S,c`, all full/empty-root ordered pairs charge to the single
source extension rooted at `c \ root`.  The constant twelve is deliberately
coarse (`j≤3` gives at most six ordered source pairs). -/
theorem fullEmptySourceRoot_pairSum_le_twelve_extension
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} (hj3 : j ≤ 3)
    (root S c : Hypergraph V) (hS : S ∈ H.powersetCard j) :
    (∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f ∧
            gainCollisionResidualConflict c e f \
                gainCollisionResidualSource S e f ⊆ root ∧
            Disjoint root (gainCollisionResidualSource S e f)
        then w S else 0) ≤
      if root ⊆ c ∧ c \ root ⊆ S ∧ 2 ≤ (c \ root).card then
        12 * w S else 0 := by
  by_cases hcover : root ⊆ c ∧ c \ root ⊆ S ∧ 2 ≤ (c \ root).card
  · rw [if_pos hcover]
    calc
      (∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if gainCollisionResidualUnion S c e f ⊆ H ∧
              e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
              root ⊆ gainCollisionResidualUnion S c e f ∧
              gainCollisionResidualConflict c e f \
                  gainCollisionResidualSource S e f ⊆ root ∧
              Disjoint root (gainCollisionResidualSource S e f)
          then w S else 0) ≤
          ∑ e ∈ S, ∑ _f ∈ S.erase e, w S := by
        apply Finset.sum_le_sum
        intro e heS
        apply Finset.sum_le_sum
        intro f hfS
        split
        · exact le_rfl
        · exact hw0 S
      _ ≤ 12 * w S := by
        have hScard : S.card = j :=
          (Finset.mem_powersetCard.mp hS).2
        have hpairs : ∀ e ∈ S, (S.erase e).card ≤ 3 := by
          intro e he
          rw [Finset.card_erase_of_mem he, hScard]
          omega
        calc
          (∑ e ∈ S, ∑ _f ∈ S.erase e, w S) =
              ∑ e ∈ S, ((S.erase e).card : ℝ) * w S := by simp
          _ ≤ ∑ _e ∈ S, 3 * w S := by
            apply Finset.sum_le_sum
            intro e he
            exact mul_le_mul_of_nonneg_right
              (by exact_mod_cast hpairs e he) (hw0 S)
          _ = (S.card : ℝ) * (3 * w S) := by simp
          _ ≤ 12 * w S := by
            have hcard3 : (S.card : ℝ) ≤ 3 := by
              rw [hScard]
              exact_mod_cast hj3
            nlinarith [hw0 S]
  · rw [if_neg hcover]
    apply le_of_eq
    apply Finset.sum_eq_zero
    intro e heS
    apply Finset.sum_eq_zero
    intro f hfS
    rw [if_neg]
    intro hrep
    have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
    have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
    have hgeom := full_emptySourceRoot_geometry
      hrep.1 heS hfS' (Ne.symm hfe) hrep.2.1 hrep.2.2.1
      hrep.2.2.2.2.1 hrep.2.2.2.2.2.1 hrep.2.2.2.2.2.2
    have hpair : {e, f} ⊆ c \ root := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact hgeom.2.2.2.1
      · exact hgeom.2.2.2.2
    have htwo := Finset.card_le_card hpair
    exact hcover ⟨by rw [hgeom.1]; exact Finset.sdiff_subset,
      hgeom.2.2.1, by simpa [Ne.symm hfe] using htwo⟩

/-- First Fubini reduction of the hard boundary.  After this theorem the
source pair no longer appears: every conflict is weighted by one ordinary
test extension at `c \ root`. -/
theorem weightedGainCollisionResidualFullEmptySourceRootMass_le_extensionSum
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} (hj3 : j ≤ 3) (root : Hypergraph V) :
    weightedGainCollisionResidualFullEmptySourceRootMass
        w H C j r root ≤
      12 * ∑ c ∈ C.filter
          (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
        testExtension w H j (c \ root) := by
  unfold weightedGainCollisionResidualFullEmptySourceRootMass
  calc
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f ∧
            gainCollisionResidualConflict c e f \
                gainCollisionResidualSource S e f ⊆ root ∧
            Disjoint root (gainCollisionResidualSource S e f)
        then w S else 0) =
      ∑ S ∈ H.powersetCard j,
      ∑ c ∈ C,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f ∧
            gainCollisionResidualConflict c e f \
                gainCollisionResidualSource S e f ⊆ root ∧
            Disjoint root (gainCollisionResidualSource S e f)
        then w S else 0 := by
          apply Finset.sum_congr rfl
          intro S hS
          calc
            (∑ e ∈ S, ∑ f ∈ S.erase e, ∑ c ∈ C, _) =
                ∑ e ∈ S, ∑ c ∈ C, ∑ f ∈ S.erase e, _ := by
              apply Finset.sum_congr rfl
              intro e he
              rw [Finset.sum_comm]
            _ = ∑ c ∈ C, ∑ e ∈ S, ∑ f ∈ S.erase e, _ := by
              rw [Finset.sum_comm]
    _ ≤ ∑ S ∈ H.powersetCard j,
        ∑ c ∈ C,
          if root ⊆ c ∧ c \ root ⊆ S ∧ 2 ≤ (c \ root).card
          then 12 * w S else 0 := by
      apply Finset.sum_le_sum
      intro S hS
      apply Finset.sum_le_sum
      intro c hc
      exact fullEmptySourceRoot_pairSum_le_twelve_extension
        (C := C) hw0 hj3 root S c hS
    _ = ∑ c ∈ C,
        if root ⊆ c ∧ 2 ≤ (c \ root).card then
          12 * testExtension w H j (c \ root) else 0 := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro c hc
      by_cases hrootc : root ⊆ c ∧ 2 ≤ (c \ root).card
      · rw [if_pos hrootc]
        simp only [hrootc.1, hrootc.2, true_and, and_true, if_pos]
        unfold testExtension
        rw [Finset.mul_sum, ← Finset.sum_filter]
      · rw [if_neg hrootc]
        apply Finset.sum_eq_zero
        intro S hS
        rw [if_neg]
        intro h
        exact hrootc ⟨h.1, h.2.2⟩
    _ = ∑ c ∈ C.filter
          (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
        12 * testExtension w H j (c \ root) := by
      rw [← Finset.sum_filter]
    _ = 12 * ∑ c ∈ C.filter
          (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
        testExtension w H j (c \ root) := by
      rw [Finset.mul_sum]

theorem sum_conflictLayers_eq_sum_of_card_between_two_four
    {C : ConflictSystem V}
    (hcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (P : Hypergraph V → Prop) [DecidablePred P]
    (F : Hypergraph V → ℝ) :
    (∑ q ∈ Finset.Icc 2 4,
      ∑ c ∈ (conflictLayer C q).filter P, F c) =
      ∑ c ∈ C.filter P, F c := by
  simp only [conflictLayer, Finset.filter_filter]
  calc
    (∑ q ∈ Finset.Icc 2 4,
      ∑ c ∈ C.filter (fun c ↦ c.card = q ∧ P c), F c) =
      ∑ q ∈ Finset.Icc 2 4,
      ∑ c ∈ C, if c.card = q ∧ P c then F c else 0 := by
        apply Finset.sum_congr rfl
        intro q hq
        rw [← Finset.sum_filter]
    _ = ∑ c ∈ C,
        ∑ q ∈ Finset.Icc 2 4,
          if c.card = q ∧ P c then F c else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ c ∈ C, if P c then F c else 0 := by
      apply Finset.sum_congr rfl
      intro c hc
      by_cases hPc : P c
      · have hq : c.card ∈ Finset.Icc 2 4 :=
          Finset.mem_Icc.mpr (hcard c hc)
        rw [if_pos hPc, Finset.sum_eq_single c.card]
        · simp [hPc]
        · intro q hqmem hqne
          simp [hqne.symm]
        · exact fun hnot ↦ (hnot hq).elim
      · simp [hPc]
    _ = ∑ c ∈ C.filter P, F c := by
      rw [← Finset.sum_filter]

theorem trackable_extension_supported_root_lt_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell stage : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hell : 1 ≤ ell)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hrootCard : root.card = stage) (hstage : 1 ≤ stage)
    (hlt : stage < j) :
    testExtension w H j root ≤
      (ell : ℝ) * (testTotal w H j /
        Real.rpow d ((stage : ℝ) + epsRaw / 5)) := by
  have hbase := hw.extension_upper hstage hlt root hrootH hrootCard
  have htotal0 := testTotal_nonneg hw.isTestFunction.nonneg H j
  have hden0 : 0 ≤ Real.rpow d ((stage : ℝ) + epsRaw / 5) :=
    Real.rpow_nonneg (by linarith : 0 ≤ d) _
  have hratio0 : 0 ≤ testTotal w H j /
      Real.rpow d ((stage : ℝ) + epsRaw / 5) :=
    div_nonneg htotal0 hden0
  have hellReal : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
  exact hbase.trans (by nlinarith)

theorem trackable_extension_supported_root_eq_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell stage : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hell : 1 ≤ ell)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hrootCard : root.card = stage) (heq : stage = j) :
    testExtension w H j root ≤
      (ell : ℝ) * (testTotal w H j /
        Real.rpow d ((stage : ℝ) + epsRaw / 5)) := by
  subst stage
  have hext : testExtension w H j root = w root := by
    unfold testExtension
    have hfilter :
        (H.powersetCard j).filter (root ⊆ ·) = {root} := by
      ext S
      simp only [Finset.mem_filter, Finset.mem_powersetCard,
        Finset.mem_singleton]
      constructor
      · rintro ⟨⟨hSH, hSCard⟩, hrootS⟩
        exact (Finset.eq_of_subset_of_card_le hrootS
          (by rw [heq, hSCard])).symm
      · rintro rfl
        exact ⟨⟨hrootH, heq⟩, Finset.Subset.rfl⟩
    rw [hfilter]
    simp
  have hden : 0 < Real.rpow d ((j : ℝ) + epsRaw / 5) :=
    Real.rpow_pos_of_pos (by linarith : 0 < d) _
  have hwroot : w root ≤ (ell : ℝ) := by
    simpa using hw.isTestFunction.le root
  have hratio1 : 1 ≤ testTotal w H j /
      Real.rpow d ((j : ℝ) + epsRaw / 5) := by
    rw [le_div_iff₀ hden]
    simpa using hw.total_lower
  have hscalar : w root ≤ (ell : ℝ) *
      (testTotal w H j / Real.rpow d ((j : ℝ) + epsRaw / 5)) := by
    nlinarith [mul_le_mul_of_nonneg_left hratio1
      (by positivity : (0 : ℝ) ≤ ell)]
  exact hext.le.trans (by simpa only [heq] using hscalar)

theorem trackable_extension_supported_root_gt_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell stage : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d)
    (root : Hypergraph V) (hrootCard : root.card = stage)
    (hgt : j < stage) :
    testExtension w H j root ≤
      (ell : ℝ) * (testTotal w H j /
        Real.rpow d ((stage : ℝ) + epsRaw / 5)) := by
  have hz : testExtension w H j root = 0 := by
    unfold testExtension
    apply Finset.sum_eq_zero
    intro S hS
    obtain ⟨hSpow, hrootS⟩ := Finset.mem_filter.mp hS
    have hcardLe := Finset.card_le_card hrootS
    have hSCard := (Finset.mem_powersetCard.mp hSpow).2
    rw [hSCard, hrootCard] at hcardLe
    omega
  rw [hz]
  exact mul_nonneg (Nat.cast_nonneg ell)
    (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
      (Real.rpow_nonneg (by linarith : 0 ≤ d) _))

theorem trackable_extension_sdiff_supported_root_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell q : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hell : 1 ≤ ell)
    (root c : Hypergraph V) (hcCard : c.card = q)
    (hrootc : root ⊆ c) (hDtwo : 2 ≤ (c \ root).card) :
    testExtension w H j (c \ root) ≤
      (ell : ℝ) * testTotal w H j /
        Real.rpow d
          (((q - root.card : ℕ) : ℝ) + epsRaw / 5) := by
  have hDcard : (c \ root).card = q - root.card := by
    rw [Finset.card_sdiff_of_subset hrootc, hcCard]
  by_cases hDH : c \ root ⊆ H
  · rcases lt_trichotomy (c \ root).card j with hlt | heq | hgt
    · have h := trackable_extension_supported_root_lt_le
        hw hd hell (c \ root) hDH rfl (by omega) hlt
      simpa only [hDcard, mul_div_assoc] using h
    · have h := trackable_extension_supported_root_eq_le
        hw hd hell (c \ root) hDH rfl heq
      simpa only [hDcard, mul_div_assoc] using h
    · have h := trackable_extension_supported_root_gt_le
        hw hd (c \ root) rfl hgt
      simpa only [hDcard, mul_div_assoc] using h
  · have hz : testExtension w H j (c \ root) = 0 := by
      unfold testExtension
      apply Finset.sum_eq_zero
      intro S hS
      obtain ⟨hSpow, hDS⟩ := Finset.mem_filter.mp hS
      exfalso
      apply hDH
      exact hDS.trans (Finset.mem_powersetCard.mp hSpow).1
    rw [hz]
    exact div_nonneg
      (mul_nonneg (Nat.cast_nonneg ell)
        (testTotal_nonneg hw.isTestFunction.nonneg H j))
      (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

theorem sum_trackable_extensions_over_supported_conflict_root_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell q : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hq2 : 2 ≤ q) (hq4 : q ≤ 4)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) (hrootq : root.card < q) :
    (∑ c ∈ (conflictLayer C q).filter
        (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
        testExtension w H j (c \ root)) ≤
      (Gamma + 1) * (ell : ℝ) * testTotal w H j *
        Real.rpow d (-(epsRaw / 5)) := by
  let F := (conflictLayer C q).filter
    (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card)
  let E : ℝ := ((q - root.card : ℕ) : ℝ) + epsRaw / 5
  have htotal0 : 0 ≤ testTotal w H j :=
    testTotal_nonneg hw.isTestFunction.nonneg H j
  have hell0 : 0 ≤ (ell : ℝ) := Nat.cast_nonneg ell
  have heach : ∀ c ∈ F,
      testExtension w H j (c \ root) ≤
        (ell : ℝ) * testTotal w H j / Real.rpow d E := by
    intro c hcF
    have hc := Finset.mem_filter.mp hcF
    have hcLayer := mem_conflictLayer.mp hc.1
    exact trackable_extension_sdiff_supported_root_le
      hw hd hell root c hcLayer.2 hc.2.1 hc.2.2
  have hcardF : (F.card : ℝ) ≤
      (codegree (conflictLayer C q) root : ℝ) := by
    exact_mod_cast Finset.card_le_card (by
      intro c hc
      exact Finset.mem_filter.mpr
        ⟨(Finset.mem_filter.mp hc).1, (Finset.mem_filter.mp hc).2.1⟩)
  have hcodegree := supported_conflict_root_codegree_le
    hB hd heps hq2 hq4 root hrootH hroot1 hrootq
  have hconst0 : 0 ≤
      (ell : ℝ) * testTotal w H j / Real.rpow d E := by
    exact div_nonneg (mul_nonneg hell0 htotal0)
      (Real.rpow_nonneg (by linarith : 0 ≤ d) E)
  calc
    (∑ c ∈ (conflictLayer C q).filter
        (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
        testExtension w H j (c \ root)) =
        ∑ c ∈ F, testExtension w H j (c \ root) := by rfl
    _ ≤ ∑ _c ∈ F,
        (ell : ℝ) * testTotal w H j / Real.rpow d E := by
      exact Finset.sum_le_sum heach
    _ = (F.card : ℝ) *
        ((ell : ℝ) * testTotal w H j / Real.rpow d E) := by simp
    _ ≤ (codegree (conflictLayer C q) root : ℝ) *
        ((ell : ℝ) * testTotal w H j / Real.rpow d E) :=
      mul_le_mul_of_nonneg_right hcardF hconst0
    _ ≤ ((Gamma + 1) * Real.rpow d
          ((q : ℝ) - (root.card : ℝ))) *
        ((ell : ℝ) * testTotal w H j / Real.rpow d E) :=
      mul_le_mul_of_nonneg_right hcodegree hconst0
    _ = (Gamma + 1) * (ell : ℝ) * testTotal w H j *
        Real.rpow d (-(epsRaw / 5)) := by
      have hrootqLe : root.card ≤ q := Nat.le_of_lt hrootq
      have hsubCast : ((q - root.card : ℕ) : ℝ) =
          (q : ℝ) - (root.card : ℝ) := Nat.cast_sub hrootqLe
      dsimp only [E]
      rw [hsubCast]
      have hratio : Real.rpow d ((q : ℝ) - (root.card : ℝ)) /
          Real.rpow d
            ((q : ℝ) - (root.card : ℝ) + epsRaw / 5) =
          Real.rpow d (-(epsRaw / 5)) := by
        calc
          Real.rpow d ((q : ℝ) - (root.card : ℝ)) /
              Real.rpow d
                ((q : ℝ) - (root.card : ℝ) + epsRaw / 5) =
              Real.rpow d
                (((q : ℝ) - (root.card : ℝ)) -
                  ((q : ℝ) - (root.card : ℝ) + epsRaw / 5)) :=
            (Real.rpow_sub (by linarith : 0 < d) _ _).symm
          _ = Real.rpow d (-(epsRaw / 5)) := by
            congr 1
            ring
      rw [show ((Gamma + 1) * Real.rpow d
          ((q : ℝ) - (root.card : ℝ))) *
          ((ell : ℝ) * testTotal w H j /
            Real.rpow d
              ((q : ℝ) - (root.card : ℝ) + epsRaw / 5)) =
        (Gamma + 1) * (ell : ℝ) * testTotal w H j *
          (Real.rpow d ((q : ℝ) - (root.card : ℝ)) /
            Real.rpow d
              ((q : ℝ) - (root.card : ℝ) + epsRaw / 5)) by ring]
      rw [hratio]

theorem weightedGainCollisionResidualFullEmptySourceRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) :
    weightedGainCollisionResidualFullEmptySourceRootMass
        w H C j r root ≤
      36 * (Gamma + 1) * (ell : ℝ) * testTotal w H j *
        Real.rpow d (-(epsRaw / 5)) := by
  have hFubini :=
    weightedGainCollisionResidualFullEmptySourceRootMass_le_extensionSum
      (H := H) (C := C) (r := r) hw.isTestFunction.nonneg hj3 root
  have hlayers := sum_conflictLayers_eq_sum_of_card_between_two_four
    (fun c hc ↦ hB.conflict_card hc)
    (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card)
    (fun c ↦ testExtension w H j (c \ root))
  rw [← hlayers] at hFubini
  have hterm : ∀ q ∈ Finset.Icc 2 4,
      (∑ c ∈ (conflictLayer C q).filter
          (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
          testExtension w H j (c \ root)) ≤
        (Gamma + 1) * (ell : ℝ) * testTotal w H j *
          Real.rpow d (-(epsRaw / 5)) := by
    intro q hq
    let F := (conflictLayer C q).filter
      (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card)
    by_cases hF : F = ∅
    · rw [show (conflictLayer C q).filter
          (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card) = ∅ from hF]
      simp only [Finset.sum_empty, zero_le]
      exact mul_nonneg
        (mul_nonneg
          (mul_nonneg (by
            have hGamma := regularizedBounded_Gamma_nonneg hB
              (by linarith : 0 < d)
            linarith) (Nat.cast_nonneg ell))
          (testTotal_nonneg hw.isTestFunction.nonneg H j))
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
    · obtain ⟨c, hcF⟩ := Finset.nonempty_iff_ne_empty.mpr hF
      have hc := Finset.mem_filter.mp hcF
      have hcLayer := mem_conflictLayer.mp hc.1
      have hrootq : root.card < q := by
        have hcard := Finset.card_sdiff_add_card_inter c root
        have hinter : c ∩ root = root := by
          exact Finset.inter_eq_right.mpr hc.2.1
        rw [hinter, hcLayer.2] at hcard
        omega
      exact sum_trackable_extensions_over_supported_conflict_root_le
        hw hB hd heps hell
          (Finset.mem_Icc.mp hq).1 (Finset.mem_Icc.mp hq).2
          root hrootH hroot1 hrootq
  calc
    weightedGainCollisionResidualFullEmptySourceRootMass
        w H C j r root ≤
      12 * ∑ q ∈ Finset.Icc 2 4,
        ∑ c ∈ (conflictLayer C q).filter
          (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card),
          testExtension w H j (c \ root) := hFubini
    _ ≤ 12 * ∑ _q ∈ Finset.Icc 2 4,
        ((Gamma + 1) * (ell : ℝ) * testTotal w H j *
          Real.rpow d (-(epsRaw / 5))) := by
      apply mul_le_mul_of_nonneg_left
      · exact Finset.sum_le_sum hterm
      · norm_num
    _ = 36 * (Gamma + 1) * (ell : ℝ) * testTotal w H j *
        Real.rpow d (-(epsRaw / 5)) := by
      norm_num [Finset.sum_Icc_succ_top]
      ring

theorem weightedGainCollisionResidualFullEmptySourceRootMass_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3)
    (hcutoff : 36 * (Gamma + 1) * (ell : ℝ) ≤
      Real.rpow d (epsRaw / 10))
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) (hrootRank : root.card = r - j) :
    weightedGainCollisionResidualFullEmptySourceRootMass
        w H C j r root ≤
      testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10 - (root.card : ℝ)) := by
  have hraw := weightedGainCollisionResidualFullEmptySourceRootMass_le_raw
    (r := r) hw hB hd heps hell hj3 root hrootH hroot1
  have htotal0 := testTotal_nonneg hw.isTestFunction.nonneg H j
  have hrpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d) (-(epsRaw / 5))
  apply hraw.trans
  calc
    36 * (Gamma + 1) * (ell : ℝ) * testTotal w H j *
        Real.rpow d (-(epsRaw / 5)) ≤
      Real.rpow d (epsRaw / 10) * testTotal w H j *
        Real.rpow d (-(epsRaw / 5)) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hcutoff htotal0) hrpow0
    _ = testTotal w H j * Real.rpow d (-(epsRaw / 10)) := by
      calc
        Real.rpow d (epsRaw / 10) * testTotal w H j *
            Real.rpow d (-(epsRaw / 5)) =
          testTotal w H j *
            (Real.rpow d (epsRaw / 10) *
              Real.rpow d (-(epsRaw / 5))) := by ring
        _ = testTotal w H j *
            Real.rpow d (epsRaw / 10 + (-(epsRaw / 5))) := by
          congr 1
          exact (Real.rpow_add (by linarith : 0 < d) _ _).symm
        _ = testTotal w H j * Real.rpow d (-(epsRaw / 10)) := by
          congr 1
          ring_nf
    _ = testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10 -
          (root.card : ℝ)) := by
      congr 1
      have hjr : j ≤ r := by omega
      have hcast : ((r - j : ℕ) : ℝ) = (r : ℝ) - (j : ℝ) :=
        Nat.cast_sub hjr
      rw [← hcast, ← hrootRank]
      ring_nf

def gainCollisionResidualFullConflictCandidates
    (H : Hypergraph V) (C : ConflictSystem V)
    (S : Hypergraph V) (e f : Finset V) (r : ℕ)
    (root : Hypergraph V) : ConflictSystem V :=
  C.filter fun c ↦
    gainCollisionResidualUnion S c e f ⊆ H ∧
    e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
    root ⊆ gainCollisionResidualUnion S c e f ∧
    gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆ root

@[simp] theorem mem_gainCollisionResidualFullConflictCandidates
    {H : Hypergraph V} {C : ConflictSystem V}
    {S : Hypergraph V} {e f : Finset V} {r : ℕ}
    {root c : Hypergraph V} :
    c ∈ gainCollisionResidualFullConflictCandidates H C S e f r root ↔
      c ∈ C ∧ gainCollisionResidualUnion S c e f ⊆ H ∧
      e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      root ⊆ gainCollisionResidualUnion S c e f ∧
      gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f ⊆ root := by
  simp [gainCollisionResidualFullConflictCandidates, and_assoc]

theorem residualConflict_sdiff_source_eq_root_sdiff_source_of_full
    {S c root : Hypergraph V} {e f : Finset V}
    (hroot : root ⊆ gainCollisionResidualUnion S c e f)
    (hfull : gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆ root) :
    gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f =
      root \ gainCollisionResidualSource S e f := by
  apply Finset.Subset.antisymm
  · intro g hg
    exact Finset.mem_sdiff.mpr
      ⟨hfull hg, (Finset.mem_sdiff.mp hg).2⟩
  · intro g hg
    have hgroot := (Finset.mem_sdiff.mp hg).1
    have hgT := (Finset.mem_sdiff.mp hg).2
    have hgU := hroot hgroot
    rw [gainCollisionResidualUnion_eq_source_union_conflict] at hgU
    exact Finset.mem_sdiff.mpr
      ⟨(Finset.mem_union.mp hgU).resolve_left hgT, hgT⟩

theorem gainCollisionResidualFullConflictCandidates_card_le_two
    {H : Hypergraph V} {C : ConflictSystem V}
    {S root : Hypergraph V} {e f : Finset V} {j r : ℕ}
    (hS : S ∈ H.powersetCard j) (heS : e ∈ S)
    (hfS : f ∈ S.erase e) (hj3 : j ≤ 3) :
    (gainCollisionResidualFullConflictCandidates
      H C S e f r root).card ≤ 2 := by
  let T := gainCollisionResidualSource S e f
  let F := gainCollisionResidualFullConflictCandidates H C S e f r root
  let phi : Hypergraph V → Hypergraph V := fun c ↦
    T ∩ gainCollisionResidualConflict c e f
  have hmap : F.image phi ⊆ T.powerset := by
    intro I hI
    obtain ⟨c, hcF, rfl⟩ := Finset.mem_image.mp hI
    exact Finset.mem_powerset.mpr Finset.inter_subset_left
  have hinj : Set.InjOn phi F := by
    intro c hcF c' hc'F hphi
    have hc := mem_gainCollisionResidualFullConflictCandidates.mp hcF
    have hc' := mem_gainCollisionResidualFullConflictCandidates.mp hc'F
    let R := gainCollisionResidualConflict c e f
    let R' := gainCollisionResidualConflict c' e f
    have hdiff : R \ T = root \ T :=
      residualConflict_sdiff_source_eq_root_sdiff_source_of_full
        hc.2.2.2.2.2.1 hc.2.2.2.2.2.2
    have hdiff' : R' \ T = root \ T :=
      residualConflict_sdiff_source_eq_root_sdiff_source_of_full
        hc'.2.2.2.2.2.1 hc'.2.2.2.2.2.2
    have hR : R = (T ∩ R) ∪ (R \ T) := by
      ext g
      simp
      tauto
    have hR' : R' = (T ∩ R') ∪ (R' \ T) := by
      ext g
      simp
      tauto
    have hRR' : R = R' := by
      rw [hR, hR', hdiff, hdiff']
      exact congrArg (fun I ↦ I ∪ (root \ T)) hphi
    have hec : e ∈ c := hc.2.2.1
    have hfc : f ∈ c := hc.2.2.2.1
    have hec' : e ∈ c' := hc'.2.2.1
    have hfc' : f ∈ c' := hc'.2.2.2.1
    have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
    calc
      c = insert e (insert f R) := by
        ext g
        simp only [Finset.mem_insert, R, gainCollisionResidualConflict,
          Finset.mem_erase]
        constructor
        · intro hgc
          by_cases hge : g = e
          · exact Or.inl hge
          by_cases hgf : g = f
          · exact Or.inr (Or.inl hgf)
          exact Or.inr (Or.inr ⟨hgf, hge, hgc⟩)
        · rintro (rfl | rfl | ⟨_, _, hgc⟩)
          · exact hec
          · exact hfc
          · exact hgc
      _ = insert e (insert f R') := by rw [hRR']
      _ = c' := by
        ext g
        simp only [Finset.mem_insert, R', gainCollisionResidualConflict,
          Finset.mem_erase]
        constructor
        · intro hg
          rcases hg with hge | hgf | hgR
          · exact hge ▸ hec'
          · exact hgf ▸ hfc'
          · exact hgR.2.2
        · intro hgc
          by_cases hge : g = e
          · exact Or.inl hge
          by_cases hgf : g = f
          · exact Or.inr (Or.inl hgf)
          exact Or.inr (Or.inr ⟨hgf, hge, hgc⟩)
  have hcardImage : F.card = (F.image phi).card :=
    (Finset.card_image_iff.mpr hinj).symm
  have hTcard : T.card = j - 2 := by
    dsimp only [T]
    rw [card_gainCollisionResidualSource heS
      (Finset.mem_erase.mp hfS).2 (Ne.symm (Finset.mem_erase.mp hfS).1),
      (Finset.mem_powersetCard.mp hS).2]
  calc
    F.card = (F.image phi).card := hcardImage
    _ ≤ T.powerset.card := Finset.card_le_card hmap
    _ = 2 ^ T.card := Finset.card_powerset T
    _ ≤ 2 := by
      rw [hTcard]
      interval_cases j <;> norm_num at hj3 ⊢

theorem weightedGainCollisionResidualFullNonemptySourceRootMass_eq_sum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) :
    weightedGainCollisionResidualFullNonemptySourceRootMass
        w H C j r root =
      ∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if ¬Disjoint root (gainCollisionResidualSource S e f) then
          w S * (gainCollisionResidualFullConflictCandidates
            H C S e f r root).card else 0 := by
  unfold weightedGainCollisionResidualFullNonemptySourceRootMass
  apply Finset.sum_congr rfl
  intro S hS
  apply Finset.sum_congr rfl
  intro e heS
  apply Finset.sum_congr rfl
  intro f hfS
  by_cases hmeet : ¬Disjoint root (gainCollisionResidualSource S e f)
  · rw [if_pos hmeet]
    rw [← Finset.sum_filter]
    simp [gainCollisionResidualFullConflictCandidates, hmeet,
      Finset.filter_filter, Finset.sum_const, nsmul_eq_mul, mul_comm]
  · rw [if_neg hmeet]
    apply Finset.sum_eq_zero
    intro c hc
    rw [if_neg]
    intro h
    exact hmeet h.2.2.2.2.2.2

theorem sourcePair_meetingRoot_weight_le_rootExtensionSum
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {j : ℕ} (hj3 : j ≤ 3)
    (root : Hypergraph V) :
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if ¬Disjoint root (gainCollisionResidualSource S e f)
        then w S else 0) ≤
      6 * ∑ g ∈ root, testExtension w H j {g} := by
  have hpoint : ∀ S ∈ H.powersetCard j,
      (∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f)
          then w S else 0) ≤
        ∑ g ∈ root, if g ∈ S then 6 * w S else 0 := by
    intro S hS
    calc
      (∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f)
          then w S else 0) ≤
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
        ∑ g ∈ root,
          if g ∈ gainCollisionResidualSource S e f then w S else 0 := by
        apply Finset.sum_le_sum
        intro e heS
        apply Finset.sum_le_sum
        intro f hfS
        by_cases hmeet : ¬Disjoint root
            (gainCollisionResidualSource S e f)
        · rw [if_pos hmeet]
          obtain ⟨g, hgroot, hgT⟩ := Finset.not_disjoint_iff.mp hmeet
          have hsingle :
              (if g ∈ gainCollisionResidualSource S e f then w S else 0) ≤
                ∑ g' ∈ root,
                  if g' ∈ gainCollisionResidualSource S e f then w S else 0 := by
            exact Finset.single_le_sum
              (s := root)
              (f := fun g' ↦
                if g' ∈ gainCollisionResidualSource S e f then w S else 0)
              (fun g' _ ↦ by split; exact hw0 S; norm_num) hgroot
          simpa only [if_pos hgT] using hsingle
        · rw [if_neg hmeet]
          exact Finset.sum_nonneg fun g _ ↦ by split; exact hw0 S; norm_num
      _ ≤ ∑ e ∈ S,
          ∑ f ∈ S.erase e,
          ∑ g ∈ root, if g ∈ S then w S else 0 := by
        apply Finset.sum_le_sum
        intro e heS
        apply Finset.sum_le_sum
        intro f hfS
        apply Finset.sum_le_sum
        intro g hgroot
        by_cases hgT : g ∈ gainCollisionResidualSource S e f
        · have hgS : g ∈ S := by
            exact (Finset.mem_erase.mp
              (Finset.mem_erase.mp hgT).2).2
          simp [hgT, hgS]
        · by_cases hgS : g ∈ S <;> simp [hgT, hgS, hw0 S]
      _ = ∑ g ∈ root,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e, if g ∈ S then w S else 0 := by
        calc
          (∑ e ∈ S, ∑ f ∈ S.erase e,
              ∑ g ∈ root, if g ∈ S then w S else 0) =
              ∑ e ∈ S, ∑ g ∈ root,
                ∑ f ∈ S.erase e, if g ∈ S then w S else 0 := by
            apply Finset.sum_congr rfl
            intro e he
            rw [Finset.sum_comm]
          _ = ∑ g ∈ root, ∑ e ∈ S,
                ∑ f ∈ S.erase e, if g ∈ S then w S else 0 := by
            rw [Finset.sum_comm]
      _ ≤ ∑ g ∈ root, if g ∈ S then 6 * w S else 0 := by
        apply Finset.sum_le_sum
        intro g hgroot
        by_cases hgS : g ∈ S
        · rw [if_pos hgS]
          simp only [hgS, if_true]
          have hScard : S.card = j :=
            (Finset.mem_powersetCard.mp hS).2
          have hpairs : ∑ e ∈ S, (S.erase e).card ≤ 6 := by
            have heq : (∑ e ∈ S, (S.erase e).card) =
                S.card * (S.card - 1) := by
              calc
                (∑ e ∈ S, (S.erase e).card) =
                    ∑ _e ∈ S, (S.card - 1) := by
                  apply Finset.sum_congr rfl
                  intro e he
                  rw [Finset.card_erase_of_mem he]
                _ = S.card * (S.card - 1) := by simp
            rw [heq]
            rw [hScard]
            interval_cases j <;> norm_num at hj3 ⊢
          calc
            (∑ e ∈ S, ∑ _f ∈ S.erase e, w S) =
                ((∑ e ∈ S, (S.erase e).card : ℕ) : ℝ) * w S := by
              simp only [Finset.sum_const, nsmul_eq_mul, Nat.cast_sum]
              rw [Finset.sum_mul]
            _ ≤ 6 * w S :=
              mul_le_mul_of_nonneg_right (by exact_mod_cast hpairs) (hw0 S)
        · simp [hgS]
  calc
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if ¬Disjoint root (gainCollisionResidualSource S e f)
        then w S else 0) ≤
      ∑ S ∈ H.powersetCard j,
        ∑ g ∈ root, if g ∈ S then 6 * w S else 0 :=
      Finset.sum_le_sum hpoint
    _ = ∑ g ∈ root,
        6 * testExtension w H j {g} := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro g hgroot
      unfold testExtension
      simp_rw [Finset.singleton_subset_iff]
      rw [Finset.mul_sum, ← Finset.sum_filter]
    _ = 6 * ∑ g ∈ root, testExtension w H j {g} := by
      rw [Finset.mul_sum]

theorem sum_singleton_testExtension_root_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hj2 : 2 ≤ j) :
    (∑ g ∈ root, testExtension w H j {g}) ≤
      (root.card : ℝ) *
        (testTotal w H j / Real.rpow d (1 + epsRaw / 5)) := by
  calc
    (∑ g ∈ root, testExtension w H j {g}) ≤
        ∑ _g ∈ root,
          (testTotal w H j / Real.rpow d (1 + epsRaw / 5)) := by
      apply Finset.sum_le_sum
      intro g hgroot
      have hgH : g ∈ H := hrootH hgroot
      simpa using hw.extension_upper (j' := 1)
        (by omega) (by omega) ({g} : Hypergraph V)
          (by simp [hgH]) (by simp)
    _ = (root.card : ℝ) *
        (testTotal w H j / Real.rpow d (1 + epsRaw / 5)) := by simp

theorem weightedGainCollisionResidualFullNonemptySourceRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualFullNonemptySourceRootMass
        w H C j r root ≤
      24 * testTotal w H j *
        Real.rpow d (-(1 + epsRaw / 5)) := by
  rw [weightedGainCollisionResidualFullNonemptySourceRootMass_eq_sum]
  by_cases hj2 : 2 ≤ j
  · have hcandidates : ∀ S ∈ H.powersetCard j,
        ∀ e ∈ S, ∀ f ∈ S.erase e,
        ((gainCollisionResidualFullConflictCandidates
          H C S e f r root).card : ℝ) ≤ 2 := by
      intro S hS e heS f hfS
      exact_mod_cast gainCollisionResidualFullConflictCandidates_card_le_two
        hS heS hfS hj3
    have hmeet := sourcePair_meetingRoot_weight_le_rootExtensionSum
      (H := H) hw.isTestFunction.nonneg hj3 root
    have htotal0 := testTotal_nonneg hw.isTestFunction.nonneg H j
    have hdenPos : 0 < Real.rpow d (1 + epsRaw / 5) :=
      Real.rpow_pos_of_pos (by linarith) _
    calc
      (∑ S ∈ H.powersetCard j,
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f) then
            w S * (gainCollisionResidualFullConflictCandidates
              H C S e f r root).card else 0) ≤
        2 * (∑ S ∈ H.powersetCard j,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e,
            if ¬Disjoint root (gainCollisionResidualSource S e f)
            then w S else 0) := by
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro S hS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro e heS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro f hfS
          by_cases hmeet : ¬Disjoint root
              (gainCollisionResidualSource S e f)
          · rw [if_pos hmeet, if_pos hmeet]
            have hcand := hcandidates S hS e heS f hfS
            calc
              w S * (gainCollisionResidualFullConflictCandidates
                  H C S e f r root).card ≤ w S * 2 :=
                mul_le_mul_of_nonneg_left hcand
                  (hw.isTestFunction.nonneg S)
              _ = 2 * w S := by ring
          · rw [if_neg hmeet, if_neg hmeet]
            norm_num
      _ ≤ 2 * (6 * ∑ g ∈ root, testExtension w H j {g}) :=
        mul_le_mul_of_nonneg_left hmeet (by norm_num)
      _ ≤ 12 * ((root.card : ℝ) *
          (testTotal w H j / Real.rpow d (1 + epsRaw / 5))) := by
        have hext := sum_singleton_testExtension_root_le hw root hrootH hj2
        nlinarith
      _ ≤ 24 *
          (testTotal w H j / Real.rpow d (1 + epsRaw / 5)) := by
        have hratio0 : 0 ≤
            testTotal w H j / Real.rpow d (1 + epsRaw / 5) :=
          div_nonneg htotal0 hdenPos.le
        nlinarith [show (root.card : ℝ) ≤ 2 by exact_mod_cast hroot2]
      _ = 24 * testTotal w H j *
          Real.rpow d (-(1 + epsRaw / 5)) := by
        calc
          24 * (testTotal w H j /
              Real.rpow d (1 + epsRaw / 5)) =
              24 * testTotal w H j *
                (Real.rpow d (1 + epsRaw / 5))⁻¹ := by ring
          _ = 24 * testTotal w H j *
              Real.rpow d (-(1 + epsRaw / 5)) := by
            congr 2
            exact (Real.rpow_neg (by linarith : 0 ≤ d) _).symm
  · have hj1 : j ≤ 1 := by omega
    apply le_trans (b := 0)
    · apply Finset.sum_nonpos
      intro S hS
      have hScard := (Finset.mem_powersetCard.mp hS).2
      have hSone : S.card ≤ 1 := by omega
      apply Finset.sum_nonpos
      intro e heS
      have hErase : S.erase e = ∅ := by
        apply Finset.card_eq_zero.mp
        rw [Finset.card_erase_of_mem heS]
        omega
      rw [hErase]
      simp
    · exact mul_nonneg
        (mul_nonneg (by norm_num)
          (testTotal_nonneg hw.isTestFunction.nonneg H j))
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

def gainCollisionResidualNonFullConflictCandidates
    (H : Hypergraph V) (C : ConflictSystem V)
    (S : Hypergraph V) (e f : Finset V) (r : ℕ)
    (root : Hypergraph V) : ConflictSystem V :=
  C.filter fun c ↦
    gainCollisionResidualUnion S c e f ⊆ H ∧
    e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
    root ⊆ gainCollisionResidualUnion S c e f ∧
    ¬gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆ root

@[simp] theorem mem_gainCollisionResidualNonFullConflictCandidates
    {H : Hypergraph V} {C : ConflictSystem V}
    {S : Hypergraph V} {e f : Finset V} {r : ℕ}
    {root c : Hypergraph V} :
    c ∈ gainCollisionResidualNonFullConflictCandidates H C S e f r root ↔
      c ∈ C ∧ gainCollisionResidualUnion S c e f ⊆ H ∧
      e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      root ⊆ gainCollisionResidualUnion S c e f ∧
      ¬gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f ⊆ root := by
  simp [gainCollisionResidualNonFullConflictCandidates, and_assoc]

def gainCollisionResidualNonFullConflictFiber
    (H : Hypergraph V) (C : ConflictSystem V)
    (S : Hypergraph V) (e f : Finset V) (r : ℕ)
    (root I : Hypergraph V) : ConflictSystem V :=
  (gainCollisionResidualNonFullConflictCandidates
    H C S e f r root).filter fun c ↦
      gainCollisionResidualSource S e f ∩
        gainCollisionResidualConflict c e f = I

@[simp] theorem mem_gainCollisionResidualNonFullConflictFiber
    {H : Hypergraph V} {C : ConflictSystem V}
    {S : Hypergraph V} {e f : Finset V} {r : ℕ}
    {root I c : Hypergraph V} :
    c ∈ gainCollisionResidualNonFullConflictFiber
        H C S e f r root I ↔
      c ∈ gainCollisionResidualNonFullConflictCandidates
        H C S e f r root ∧
      gainCollisionResidualSource S e f ∩
        gainCollisionResidualConflict c e f = I := by
  simp [gainCollisionResidualNonFullConflictFiber]

theorem gainCollisionResidualNonFullCandidates_eq_biUnion_fibers
    (H : Hypergraph V) (C : ConflictSystem V)
    (S : Hypergraph V) (e f : Finset V) (r : ℕ)
    (root : Hypergraph V) :
    gainCollisionResidualNonFullConflictCandidates H C S e f r root =
      (gainCollisionResidualSource S e f).powerset.biUnion fun I ↦
        gainCollisionResidualNonFullConflictFiber
          H C S e f r root I := by
  ext c
  constructor
  · intro hc
    apply Finset.mem_biUnion.mpr
    let I := gainCollisionResidualSource S e f ∩
      gainCollisionResidualConflict c e f
    exact ⟨I, Finset.mem_powerset.mpr Finset.inter_subset_left,
      mem_gainCollisionResidualNonFullConflictFiber.mpr ⟨hc, rfl⟩⟩
  · intro hc
    obtain ⟨I, hIT, hcF⟩ := Finset.mem_biUnion.mp hc
    exact (mem_gainCollisionResidualNonFullConflictFiber.mp hcF).1

def gainCollisionResidualConflictRoot
    (e f : Finset V) (I B : Hypergraph V) : Hypergraph V :=
  insert e (insert f (I ∪ B))

theorem gainCollisionResidualNonFullConflictFiber_card_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d epsRaw Gamma : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    {S root I : Hypergraph V} {e f : Finset V}
    (hS : S ∈ H.powersetCard j) (heS : e ∈ S)
    (hfS : f ∈ S.erase e)
    (hFnonempty : (gainCollisionResidualNonFullConflictFiber
      H C S e f r root I).Nonempty) :
    ((gainCollisionResidualNonFullConflictFiber
      H C S e f r root I).card : ℝ) ≤
      Real.rpow d
        (((r - j : ℕ) : ℝ) -
          ((root \ gainCollisionResidualSource S e f).card : ℝ) -
          epsRaw / 4) := by
  let T := gainCollisionResidualSource S e f
  let B := root \ T
  let m := r - j
  let q := I.card + m + 2
  let D := gainCollisionResidualConflictRoot e f I B
  let F := gainCollisionResidualNonFullConflictFiber
    H C S e f r root I
  obtain ⟨c₀, hc₀F⟩ := hFnonempty
  have hc₀Fiber := mem_gainCollisionResidualNonFullConflictFiber.mp hc₀F
  have hc₀ := mem_gainCollisionResidualNonFullConflictCandidates.mp
    hc₀Fiber.1
  have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
  have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
  have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hExtCard₀ :
      (gainCollisionResidualConflict c₀ e f \ T).card = m := by
    dsimp only [m, T]
    rw [card_residualConflict_sdiff_source_eq_union_sub heS hfS',
      hc₀.2.2.2.2.1, hScard]
  have hBsub₀ : B ⊆ gainCollisionResidualConflict c₀ e f \ T := by
    intro g hgB
    have hgroot := (Finset.mem_sdiff.mp hgB).1
    have hgT := (Finset.mem_sdiff.mp hgB).2
    have hgU := hc₀.2.2.2.2.2.1 hgroot
    rw [gainCollisionResidualUnion_eq_source_union_conflict] at hgU
    exact Finset.mem_sdiff.mpr
      ⟨(Finset.mem_union.mp hgU).resolve_left hgT, hgT⟩
  have hBlt : B.card < m := by
    have hle := Finset.card_le_card hBsub₀
    rw [hExtCard₀] at hle
    by_contra hnot
    have heqCard : B.card = m := by omega
    have heq : B = gainCollisionResidualConflict c₀ e f \ T :=
      Finset.eq_of_subset_of_card_le hBsub₀ (by rw [hExtCard₀, heqCard])
    apply hc₀.2.2.2.2.2.2
    intro g hg
    have hgB : g ∈ B := by rw [heq]; exact hg
    exact (Finset.mem_sdiff.mp hgB).1
  have hIeq : T ∩ gainCollisionResidualConflict c₀ e f = I :=
    hc₀Fiber.2
  have hICardR :
      (gainCollisionResidualConflict c₀ e f).card = I.card + m := by
    have hsplit := Finset.card_sdiff_add_card_inter
      (gainCollisionResidualConflict c₀ e f) T
    rw [Finset.inter_comm, hIeq, hExtCard₀] at hsplit
    omega
  have hc₀Card : c₀.card = q := by
    have hRCard := card_gainCollisionResidualConflict
      hc₀.2.2.1 hc₀.2.2.2.1 (Ne.symm hfe)
    rw [hICardR] at hRCard
    dsimp only [q]
    omega
  have hqBounds : 2 ≤ q ∧ q ≤ 4 := by
    rw [← hc₀Card]
    exact hB.conflict_card hc₀.1
  have hIBdisj : Disjoint I B := by
    rw [Finset.disjoint_left]
    intro g hgI hgB
    have hgT : g ∈ T := by
      rw [← hIeq] at hgI
      exact Finset.inter_subset_left hgI
    exact (Finset.mem_sdiff.mp hgB).2 hgT
  have heIB : e ∉ I ∪ B := by
    intro heIB
    rcases Finset.mem_union.mp heIB with heI | heB
    · have heT : e ∈ T := by
        rw [← hIeq] at heI
        exact Finset.inter_subset_left heI
      exact (by simpa [T, gainCollisionResidualSource] using heT)
    · have heRoot := (Finset.mem_sdiff.mp heB).1
      have heU := hc₀.2.2.2.2.2.1 heRoot
      simpa [gainCollisionResidualUnion] using heU
  have hfIB : f ∉ I ∪ B := by
    intro hfIB
    rcases Finset.mem_union.mp hfIB with hfI | hfB
    · have hfT : f ∈ T := by
        rw [← hIeq] at hfI
        exact Finset.inter_subset_left hfI
      exact (by simpa [T, gainCollisionResidualSource] using hfT)
    · have hfRoot := (Finset.mem_sdiff.mp hfB).1
      have hfU := hc₀.2.2.2.2.2.1 hfRoot
      simpa [gainCollisionResidualUnion] using hfU
  have hDcard : D.card = I.card + B.card + 2 := by
    dsimp only [D, gainCollisionResidualConflictRoot]
    have heInsert : e ∉ insert f (I ∪ B) := by
      simp [Ne.symm hfe, heIB]
    rw [Finset.card_insert_of_notMem heInsert,
      Finset.card_insert_of_notMem hfIB,
      Finset.card_union_of_disjoint hIBdisj]
  have hDtwo : 2 ≤ D.card := by rw [hDcard]; omega
  have hDlt : D.card < q := by
    rw [hDcard]
    dsimp only [q]
    omega
  have hFsub : F ⊆ (conflictLayer C q).filter (D ⊆ ·) := by
    intro c hcF
    have hcFiber := mem_gainCollisionResidualNonFullConflictFiber.mp hcF
    have hc := mem_gainCollisionResidualNonFullConflictCandidates.mp hcFiber.1
    have hExtCard :
        (gainCollisionResidualConflict c e f \ T).card = m := by
      dsimp only [m, T]
      rw [card_residualConflict_sdiff_source_eq_union_sub heS hfS',
        hc.2.2.2.2.1, hScard]
    have hICardR' :
        (gainCollisionResidualConflict c e f).card = I.card + m := by
      have hsplit := Finset.card_sdiff_add_card_inter
        (gainCollisionResidualConflict c e f) T
      rw [Finset.inter_comm, hcFiber.2, hExtCard] at hsplit
      omega
    have hcCard : c.card = q := by
      have hRCard := card_gainCollisionResidualConflict
        hc.2.2.1 hc.2.2.2.1 (Ne.symm hfe)
      rw [hICardR'] at hRCard
      dsimp only [q]
      omega
    apply Finset.mem_filter.mpr
    refine ⟨mem_conflictLayer.mpr ⟨hc.1, hcCard⟩, ?_⟩
    dsimp only [D, gainCollisionResidualConflictRoot]
    apply Finset.insert_subset hc.2.2.1
    apply Finset.insert_subset hc.2.2.2.1
    apply Finset.union_subset
    · intro g hgI
      rw [← hcFiber.2] at hgI
      exact (Finset.mem_erase.mp
        (Finset.mem_erase.mp (Finset.inter_subset_right hgI)).2).2
    · intro g hgB
      have hgroot := (Finset.mem_sdiff.mp hgB).1
      have hgT := (Finset.mem_sdiff.mp hgB).2
      have hgU := hc.2.2.2.2.2.1 hgroot
      rw [gainCollisionResidualUnion_eq_source_union_conflict] at hgU
      have hgR := (Finset.mem_union.mp hgU).resolve_left hgT
      exact (Finset.mem_erase.mp (Finset.mem_erase.mp hgR).2).2
  have hcardF : (F.card : ℝ) ≤
      (codegree (conflictLayer C q) D : ℝ) := by
    exact_mod_cast Finset.card_le_card hFsub
  have hC3 := hB.layer_codegree hqBounds.1 hqBounds.2
    hDtwo hDlt D rfl
  calc
    ((gainCollisionResidualNonFullConflictFiber
      H C S e f r root I).card : ℝ) = (F.card : ℝ) := by rfl
    _ ≤ (codegree (conflictLayer C q) D : ℝ) := hcardF
    _ ≤ Real.rpow d
        ((q : ℝ) - (D.card : ℝ) - epsRaw / 4) := hC3
    _ = Real.rpow d
        (((r - j : ℕ) : ℝ) -
          ((root \ gainCollisionResidualSource S e f).card : ℝ) -
          epsRaw / 4) := by
      congr 1
      rw [hDcard]
      dsimp only [q, m, B, T]
      push_cast
      ring

theorem gainCollisionResidualNonFullConflictCandidates_card_le_two_mul
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d epsRaw Gamma : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    {S root : Hypergraph V} {e f : Finset V}
    (hS : S ∈ H.powersetCard j) (heS : e ∈ S)
    (hfS : f ∈ S.erase e) :
    ((gainCollisionResidualNonFullConflictCandidates
      H C S e f r root).card : ℝ) ≤
      2 * Real.rpow d
        (((r - j : ℕ) : ℝ) -
          ((root \ gainCollisionResidualSource S e f).card : ℝ) -
          epsRaw / 4) := by
  let T := gainCollisionResidualSource S e f
  let E : ℝ := ((r - j : ℕ) : ℝ) -
    ((root \ gainCollisionResidualSource S e f).card : ℝ) - epsRaw / 4
  rw [gainCollisionResidualNonFullCandidates_eq_biUnion_fibers]
  calc
    ((((T.powerset.biUnion fun I ↦
        gainCollisionResidualNonFullConflictFiber
          H C S e f r root I).card : ℕ) : ℝ)) ≤
      ∑ I ∈ T.powerset,
        ((gainCollisionResidualNonFullConflictFiber
          H C S e f r root I).card : ℝ) := by
      exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ _I ∈ T.powerset, Real.rpow d E := by
      apply Finset.sum_le_sum
      intro I hIT
      by_cases hF : (gainCollisionResidualNonFullConflictFiber
          H C S e f r root I).Nonempty
      · exact gainCollisionResidualNonFullConflictFiber_card_le
          hB hd heps hS heS hfS hF
      · rw [Finset.not_nonempty_iff_eq_empty.mp hF]
        simp only [Finset.card_empty, Nat.cast_zero]
        exact Real.rpow_nonneg (by linarith : 0 ≤ d) E
    _ = (T.powerset.card : ℝ) * Real.rpow d E := by simp
    _ ≤ 2 * Real.rpow d E := by
      apply mul_le_mul_of_nonneg_right
      · rw [Finset.card_powerset]
        have hTcard : T.card = j - 2 := by
          dsimp only [T]
          rw [card_gainCollisionResidualSource heS
            (Finset.mem_erase.mp hfS).2
            (Ne.symm (Finset.mem_erase.mp hfS).1),
            (Finset.mem_powersetCard.mp hS).2]
        rw [hTcard]
        interval_cases j <;> norm_num at hj3 ⊢
      · exact Real.rpow_nonneg (by linarith : 0 ≤ d) E

theorem weightedGainCollisionResidualNonFullRootMass_eq_sum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) :
    weightedGainCollisionResidualNonFullRootMass w H C j r root =
      ∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
        w S * (gainCollisionResidualNonFullConflictCandidates
          H C S e f r root).card := by
  unfold weightedGainCollisionResidualNonFullRootMass
    gainCollisionResidualNonFullConflictCandidates
  apply Finset.sum_congr rfl
  intro S hS
  apply Finset.sum_congr rfl
  intro e heS
  apply Finset.sum_congr rfl
  intro f hfS
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, nsmul_eq_mul]
  ring

theorem sum_orderedSourcePair_weight_le_six_total
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (j : ℕ) (hj3 : j ≤ 3) :
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S, ∑ _f ∈ S.erase e, w S) ≤
      6 * testTotal w H j := by
  unfold testTotal
  calc
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S, ∑ _f ∈ S.erase e, w S) =
      ∑ S ∈ H.powersetCard j,
        (((S.card * (S.card - 1) : ℕ) : ℝ) * w S) := by
      apply Finset.sum_congr rfl
      intro S hS
      calc
        (∑ e ∈ S, ∑ _f ∈ S.erase e, w S) =
            ∑ e ∈ S, ((S.erase e).card : ℝ) * w S := by simp
        _ = ∑ _e ∈ S, ((S.card - 1 : ℕ) : ℝ) * w S := by
          apply Finset.sum_congr rfl
          intro e he
          rw [Finset.card_erase_of_mem he]
        _ = (S.card : ℝ) * (((S.card - 1 : ℕ) : ℝ) * w S) := by simp
        _ = (((S.card * (S.card - 1) : ℕ) : ℝ) * w S) := by
          push_cast
          ring
    _ ≤ ∑ S ∈ H.powersetCard j, 6 * w S := by
      apply Finset.sum_le_sum
      intro S hS
      have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
      have hcoef : S.card * (S.card - 1) ≤ 6 := by
        rw [hScard]
        interval_cases j <;> norm_num at hj3 ⊢
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcoef) (hw0 S)
    _ = 6 * ∑ S ∈ H.powersetCard j, w S := by
      rw [Finset.mul_sum]

def weightedGainCollisionResidualNonFullEmptySourceRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
    if Disjoint root (gainCollisionResidualSource S e f) then
      w S * (gainCollisionResidualNonFullConflictCandidates
        H C S e f r root).card else 0

def weightedGainCollisionResidualNonFullNonemptySourceRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
    if ¬Disjoint root (gainCollisionResidualSource S e f) then
      w S * (gainCollisionResidualNonFullConflictCandidates
        H C S e f r root).card else 0

theorem weightedGainCollisionResidualNonFullRootMass_eq_empty_add_nonempty
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) :
    weightedGainCollisionResidualNonFullRootMass w H C j r root =
      weightedGainCollisionResidualNonFullEmptySourceRootMass
          w H C j r root +
        weightedGainCollisionResidualNonFullNonemptySourceRootMass
          w H C j r root := by
  rw [weightedGainCollisionResidualNonFullRootMass_eq_sum]
  unfold weightedGainCollisionResidualNonFullEmptySourceRootMass
    weightedGainCollisionResidualNonFullNonemptySourceRootMass
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro S hS
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e heS
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro f hfS
  by_cases hdisj : Disjoint root (gainCollisionResidualSource S e f)
  · simp [hdisj]
  · simp [hdisj]

theorem card_root_sdiff_residualSource_eq_of_disjoint
    (root S : Hypergraph V) (e f : Finset V)
    (hdisj : Disjoint root (gainCollisionResidualSource S e f)) :
    (root \ gainCollisionResidualSource S e f).card = root.card := by
  rw [Finset.sdiff_eq_self_of_disjoint hdisj]

theorem card_root_sdiff_residualSource_eq_sub_one_of_meets
    {root S : Hypergraph V} {e f : Finset V} {j : ℕ}
    (hSCard : S.card = j) (heS : e ∈ S) (hfS : f ∈ S)
    (hef : e ≠ f) (hj3 : j ≤ 3)
    (hmeet : ¬Disjoint root (gainCollisionResidualSource S e f)) :
    (root \ gainCollisionResidualSource S e f).card = root.card - 1 := by
  let T := gainCollisionResidualSource S e f
  have hTcard : T.card = j - 2 := by
    dsimp only [T]
    rw [card_gainCollisionResidualSource heS hfS hef, hSCard]
  have hInterNonempty : (root ∩ T).Nonempty := by
    obtain ⟨g, hgroot, hgT⟩ := Finset.not_disjoint_iff.mp hmeet
    exact ⟨g, Finset.mem_inter.mpr ⟨hgroot, hgT⟩⟩
  have hInterPos : 1 ≤ (root ∩ T).card :=
    Finset.card_pos.mpr hInterNonempty
  have hInterLe : (root ∩ T).card ≤ 1 := by
    calc
      (root ∩ T).card ≤ T.card := Finset.card_le_card
        (Finset.inter_subset_right : root ∩ T ⊆ T)
      _ ≤ 1 := by rw [hTcard]; omega
  have hInterCard : (root ∩ T).card = 1 := by omega
  have hsplit := Finset.card_sdiff_add_card_inter root T
  have hsplit' : (root \ T).card + 1 = root.card := by
    simpa only [hInterCard] using hsplit
  exact Nat.eq_sub_of_add_eq hsplit'

theorem weightedGainCollisionResidualNonFullEmptySourceRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    (root : Hypergraph V) :
    weightedGainCollisionResidualNonFullEmptySourceRootMass
        w H C j r root ≤
      12 * testTotal w H j * Real.rpow d
        (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4) := by
  unfold weightedGainCollisionResidualNonFullEmptySourceRootMass
  let E : ℝ := ((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4
  have hpairs := sum_orderedSourcePair_weight_le_six_total hw0 H j hj3
  have hrpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d) E
  calc
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if Disjoint root (gainCollisionResidualSource S e f) then
          w S * (gainCollisionResidualNonFullConflictCandidates
            H C S e f r root).card else 0) ≤
      2 * Real.rpow d E *
        (∑ S ∈ H.powersetCard j,
          ∑ e ∈ S, ∑ f ∈ S.erase e, w S) := by
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro S hS
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro e heS
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro f hfS
      by_cases hdisj : Disjoint root
          (gainCollisionResidualSource S e f)
      · rw [if_pos hdisj]
        have hcand :=
          gainCollisionResidualNonFullConflictCandidates_card_le_two_mul
            (r := r) (root := root) hB hd heps hj3 hS heS hfS
        rw [card_root_sdiff_residualSource_eq_of_disjoint
          root S e f hdisj] at hcand
        calc
          w S * (gainCollisionResidualNonFullConflictCandidates
              H C S e f r root).card ≤
              w S * (2 * Real.rpow d E) :=
            mul_le_mul_of_nonneg_left
              (by simpa only [E] using hcand) (hw0 S)
          _ = 2 * Real.rpow d E * w S := by ring
      · rw [if_neg hdisj]
        exact mul_nonneg (mul_nonneg (by norm_num) hrpow0) (hw0 S)
    _ ≤ 2 * Real.rpow d E * (6 * testTotal w H j) :=
      mul_le_mul_of_nonneg_left hpairs
        (mul_nonneg (by norm_num) hrpow0)
    _ = 12 * testTotal w H j * Real.rpow d E := by ring

theorem weightedGainCollisionResidualNonFullNonemptySourceRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualNonFullNonemptySourceRootMass
        w H C j r root ≤
      24 * testTotal w H j * Real.rpow d
        (((r - j : ℕ) : ℝ) - (root.card : ℝ) -
          epsRaw / 4 - epsRaw / 5) := by
  unfold weightedGainCollisionResidualNonFullNonemptySourceRootMass
  by_cases hj2 : 2 ≤ j
  · let E : ℝ := ((r - j : ℕ) : ℝ) - (root.card : ℝ) + 1 - epsRaw / 4
    have hmeet := sourcePair_meetingRoot_weight_le_rootExtensionSum
      (H := H) hw.isTestFunction.nonneg hj3 root
    have hsingle := sum_singleton_testExtension_root_le hw root hrootH hj2
    have htotal0 := testTotal_nonneg hw.isTestFunction.nonneg H j
    have hdenPos : 0 < Real.rpow d (1 + epsRaw / 5) :=
      Real.rpow_pos_of_pos (by linarith) _
    have hmeetBound :
        (∑ S ∈ H.powersetCard j,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e,
            if ¬Disjoint root (gainCollisionResidualSource S e f)
            then w S else 0) ≤
          12 * (testTotal w H j /
            Real.rpow d (1 + epsRaw / 5)) := by
      calc
        _ ≤ 6 * ∑ g ∈ root, testExtension w H j {g} := hmeet
        _ ≤ 6 * ((root.card : ℝ) *
            (testTotal w H j /
              Real.rpow d (1 + epsRaw / 5))) :=
          mul_le_mul_of_nonneg_left hsingle (by norm_num)
        _ ≤ 12 * (testTotal w H j /
            Real.rpow d (1 + epsRaw / 5)) := by
          have hratio0 : 0 ≤ testTotal w H j /
              Real.rpow d (1 + epsRaw / 5) :=
            div_nonneg htotal0 hdenPos.le
          nlinarith [show (root.card : ℝ) ≤ 2 by exact_mod_cast hroot2]
    have hrpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d) E
    calc
      (∑ S ∈ H.powersetCard j,
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f) then
            w S * (gainCollisionResidualNonFullConflictCandidates
              H C S e f r root).card else 0) ≤
        2 * Real.rpow d E *
          (∑ S ∈ H.powersetCard j,
            ∑ e ∈ S,
            ∑ f ∈ S.erase e,
              if ¬Disjoint root (gainCollisionResidualSource S e f)
              then w S else 0) := by
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro S hS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro e heS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro f hfS
          by_cases hmeetSF : ¬Disjoint root
              (gainCollisionResidualSource S e f)
          · rw [if_pos hmeetSF, if_pos hmeetSF]
            have hcand :=
              gainCollisionResidualNonFullConflictCandidates_card_le_two_mul
