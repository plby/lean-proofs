noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-! ## Closed persistent internal component mean

The definitions in this file fix the exact scalar seam between the
source-faithful killed-choice geometry and the centered killed-net algebra.
The state index is positive: `q.1 + 1` is the link rank and `u.1 + 1` is
the partial status. -/

noncomputable def persistentInternalMeanCenterAbs
    (D₂ D₃ D₄ Gamma eta d N scale : ℝ) (k q s : ℕ) : ℝ :=
  scale *
    ((((s + 1 : ℕ) : ℝ) *
        CFMTrajectories.zHat D₂ D₃ D₄ d N q (s + 1) (k : ℝ) +
      (s : ℝ) *
        certificateTestStatusHi D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k *
        CFMTrajectories.zHat D₂ D₃ D₄ d N q s (k : ℝ)) /
      CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ))

noncomputable def persistentInternalMeanSurvivalError
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d N : ℝ) (k : ℕ)
    (M : Hypergraph V) : ℝ :=
  certificateTestStatusHi D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N k /
    ((availableEdges H C M).card : ℝ)

noncomputable def persistentInternalRankOneCStarBound
    (C : ConflictSystem V) (d epsRaw GammaCert eta : ℝ) : ℝ :=
  ∑ r ∈ Finset.Icc (2 : ℕ) 3,
    2 * finiteWeightedRootShadowMargin eta d
      ((3 * GammaCert + 1) * Real.rpow d ((r : ℝ) - epsRaw / 4))
      0 (r - 1)

noncomputable def persistentInternalKilledGainError
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert eta : ℝ) (s : ℕ)
    (M : Hypergraph V) : ℝ :=
  (256 * ∑ r ∈ Finset.Icc (3 : ℕ) 5,
    2 * finiteWeightedRootShadowMargin eta d
      (2304 * (3 * GammaCert + 1) *
        Real.rpow d ((r : ℝ) - epsRaw / 4))
      0 (r - (s + 1))) /
    ((availableEdges H C M).card : ℝ)

noncomputable def persistentInternalHigherKilledLossError
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw eta : ℝ) (D₂ D₃ D₄ Gamma N scale : ℝ)
    (k q s : ℕ) (M : Hypergraph V) : ℝ :=
  let statusCurrent := scale *
    (CFMTrajectories.zHat D₂ D₃ D₄ d N q s (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N q s (k : ℝ))
  (((s * (64 * Nat.ceil (d ^ (1 - eta)) +
      16 * certificateMixedLossCapNat eta epsRaw d +
      Nat.ceil (30 * localSpreadPrimaryMargin eta d)) : ℕ) : ℝ) *
    statusCurrent) / ((availableEdges H C M).card : ℝ)

noncomputable def persistentInternalRankOneKilledLossError
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert eta : ℝ)
    (D₂ D₃ D₄ Gamma N scale : ℝ)
    (k : ℕ) (M : Hypergraph V) : ℝ :=
  let statusHi := certificateTestStatusHi D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N k
  let statusCurrent := scale *
    (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ))
  let immediateHi := Nat.ceil (Real.rpow d (1 - epsRaw / 4))
  let cstarHi := Nat.ceil
    (persistentInternalRankOneCStarBound C d epsRaw GammaCert eta)
  ((((64 * Nat.ceil (d ^ (1 - eta)) +
        16 * certificateMixedLossCapNat eta epsRaw d : ℕ) : ℝ) *
      statusCurrent +
    statusHi * ((immediateHi + cstarHi : ℕ) : ℝ)) /
      ((availableEdges H C M).card : ℝ))

noncomputable def persistentInternalKilledLossError
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert eta : ℝ)
    (D₂ D₃ D₄ Gamma N scale : ℝ)
    (k : ℕ) (q : Fin 3) (u : Fin (q.1 + 1))
    (M : Hypergraph V) : ℝ :=
  if q.1 = 0 then
    persistentInternalRankOneKilledLossError H C d epsRaw GammaCert eta
      D₂ D₃ D₄ Gamma N scale k M
  else
    persistentInternalHigherKilledLossError H C d epsRaw eta
      D₂ D₃ D₄ Gamma N scale k (q.1 + 1) (u.1 + 1) M

/-- The deterministic trajectory center is bounded by the literal
nonnegative expression used in the survival-error product. -/
theorem persistentInternalMeanCenter_abs_le
    {D₂ D₃ D₄ Gamma eta d N scale P : ℝ} {k q s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P q s)
    (hscale : 0 ≤ scale) :
    |scale * CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ)| ≤
      persistentInternalMeanCenterAbs D₂ D₃ D₄ Gamma eta d N
        scale k q s := by
  let x : ℝ := k
  let h := CFMTrajectories.hHat D₂ D₃ D₄ d N x
  let Z := CFMTrajectories.zHat D₂ D₃ D₄ d N q s x
  let Zp := CFMTrajectories.zHat D₂ D₃ D₄ d N q (s + 1) x
  let b := CFMTrajectories.cHat D₂ D₃ D₄ d N x +
    8 * CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let status := certificateTestStatusHi D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N k
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end x hx)
  have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos hd R.delta.degree.N_pos hp
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N x :=
    (CFMTrajectories.q_pos hp).le
  have hZ0 : 0 ≤ Z := by
    dsimp only [Z]
    unfold CFMTrajectories.zHat
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
      (pow_nonneg hm _)
  have hZp0 : 0 ≤ Zp := by
    dsimp only [Zp]
    unfold CFMTrajectories.zHat
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
      (pow_nonneg hm _)
  have hc0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N x := by
    unfold CFMTrajectories.cHat
    exact add_nonneg
      (add_nonneg
        (mul_nonneg R.delta.degree.D₂_nonneg hq0)
        (mul_nonneg
          (mul_nonneg
            (mul_nonneg (by norm_num) R.delta.degree.D₃_nonneg) hq0) hm))
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg (by norm_num) R.delta.degree.D₄_nonneg) hq0)
        (pow_nonneg hm _))
  have hD0 : 0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N x :=
    (CFMTrajectories.dHat_pos hd hp).le
  have hb0 : 0 ≤ b := by
    dsimp only [b]
    positivity
  have hdelta0 : 0 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x :=
    (CFMTrajectories.delta_pos hd hp).le
  have hz11 := (CFMTrajectories.zeta_pos
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := Gamma)
    (epsilon := CFMNumeric.coreEpsilon eta) (j := 1) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hz21 := (CFMTrajectories.zeta_pos
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := Gamma)
    (epsilon := CFMNumeric.coreEpsilon eta) (j := 2) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hz31 := (CFMTrajectories.zeta_pos
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := Gamma)
    (epsilon := CFMNumeric.coreEpsilon eta) (j := 3) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hinternal0 : 0 ≤ degreeInternalCorridorError D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N k := by
    unfold degreeInternalCorridorError
    exact add_nonneg
      (add_nonneg (mul_nonneg R.delta.degree.D₂_nonneg hz11)
        (mul_nonneg R.delta.degree.D₃_nonneg hz21))
      (mul_nonneg R.delta.degree.D₄_nonneg hz31)
  have hbstatus : b ≤ status := by
    dsimp only [b, status, certificateTestStatusHi]
    nlinarith
  have hrate := CFMTrajectories.zHatRate_mul_hHat
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (d := d) (N := N) (j := q) (s := s) (x := x) (ne_of_gt hh)
  have hrateAbs : h *
        |CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s x| ≤
      ((s + 1 : ℕ) : ℝ) * Zp + (s : ℝ) * status * Z := by
    rw [← abs_of_pos hh, ← abs_mul, hrate]
    have hfirst0 : 0 ≤ ((s + 1 : ℕ) : ℝ) * Zp := by positivity
    have hsecond0 : 0 ≤ (s : ℝ) * b * Z := by positivity
    have habs : |((s + 1 : ℕ) : ℝ) * Zp - (s : ℝ) * b * Z| ≤
        ((s + 1 : ℕ) : ℝ) * Zp + (s : ℝ) * b * Z := by
      rw [abs_le]
      constructor <;> linarith
    have hsecond : (s : ℝ) * b * Z ≤ (s : ℝ) * status * Z :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hbstatus (Nat.cast_nonneg _)) hZ0
    exact habs.trans (by linarith [hsecond])
  have hdiv :
      |CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s x| ≤
        (((s + 1 : ℕ) : ℝ) * Zp + (s : ℝ) * status * Z) / h :=
    (le_div_iff₀ hh).2 (by simpa only [mul_comm] using hrateAbs)
  rw [abs_mul, abs_of_nonneg hscale]
  dsimp only [persistentInternalMeanCenterAbs, Z, Zp, status, h, x]
  exact mul_le_mul_of_nonneg_left hdiv hscale

/-- The sharp unrestricted mean window, before subtracting killed choices,
is already a consequence of the reusable state-cap record. -/
theorem persistentInternalConflictLink_fullCenteredWindow_of_stateCaps
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ)
    (D₂ D₃ D₄ GammaCore : ℝ) (N T k : ℕ) (Pfloor : ℝ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3)
    (u : Fin (q.1 + 1)) (M : Hypergraph V)
    (Caps : PersistentInternalStateSourceCaps H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta
      N T k Pfloor j w R f q u M) :
    let qActual := q.1 + 1
    let sActual := u.1 + 1
    let scale := persistentInternalSourceScale H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R q
    let common := GammaCore *
      CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d (N : ℝ)
          qActual sActual (k : ℝ) /
        ((N : ℝ) * CFMTrajectories.pV (N : ℝ) (k : ℝ))
    scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
          qActual sActual (k : ℝ) - 12225 * common) ≤
      meanPartialTestGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M -
        meanPartialTestLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M ∧
      meanPartialTestGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M -
        meanPartialTestLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized qActual sActual M ≤
      scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
          qActual sActual (k : ℝ) + 17225 * common) := by
  dsimp only
  let qActual := q.1 + 1
  let sActual := u.1 + 1
  let scale := persistentInternalSourceScale H C d
    (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R q
  let statusLo := persistentInternalStatusLo
    D₂ D₃ D₄ GammaCore eta d (N : ℝ) k
  let statusHi := persistentInternalStatusHi
    D₂ D₃ D₄ GammaCore eta d (N : ℝ) k
  let currentHi := scale *
    (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
        qActual sActual (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d (N : ℝ)
          qActual sActual (k : ℝ))
  let lossK := persistentInternalLossCollisionCoefficient eta
    (CFMRegularization.rawRegularizationEps eta) d sActual
  have hscale0 : 0 ≤ scale := by
    dsimp only [scale, persistentInternalSourceScale]
    exact (certificateInternalLayerScale_pos H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R (q.1 + 2)
        (lt_of_lt_of_le zero_lt_one Caps.registry.delta.degree.d_one)).le
  have hnumeric :=
    CFMSharpPersistentKilledNetNumeric.literalSharpCenteredWindow_numeric_of_registry_internalResidualSixteenth
        E S Caps.registry hscale0 (Nat.cast_nonneg _) Caps.availableBounds.1
          Caps.availableBounds.2
  let common := GammaCore *
    CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
      (CFMNumeric.coreEpsilon eta) d (N : ℝ) qActual sActual (k : ℝ) /
      ((N : ℝ) * CFMTrajectories.pV (N : ℝ) (k : ℝ))
  have hmean := partialTest_meanWindow_of_gainCollision_and_lossOverlap
    (conflictLinkTestWeight R.regularized f.1 qActual)
      H R.regularized M qActual sActual statusLo statusHi
      (24 * scale * Real.rpow d
        ((sActual : ℝ) + 1 - qActual -
          CFMRegularization.rawRegularizationEps eta / 16))
      (lossK * currentHi)
      (targetLo := scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
          qActual sActual (k : ℝ) - 12225 * common))
      (targetHi := scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
          qActual sActual (k : ℝ) + 17225 * common))
      (conflictLinkTestWeight_nonneg_sharp R.regularized f.1 qActual)
      Caps.availableNonempty Caps.statusLo_nonneg Caps.statusHi_nonneg
      (fun e he ↦ (Caps.status e he).1)
      (fun e he ↦ (Caps.status e he).2)
      (by simpa only [scale, qActual, sActual, Nat.add_assoc] using Caps.next)
      (by simpa only [scale, qActual, sActual] using Caps.current)
      (by simpa only [scale, qActual, sActual] using Caps.gainCollision)
      (by simpa only [lossK, currentHi, scale, qActual, sActual]
        using Caps.lossCollision)
      (by
        simpa only [scale, qActual, sActual, statusHi, statusLo, currentHi,
          lossK, persistentInternalStatusHi, persistentInternalStatusLo,
          persistentInternalLossCollisionCoefficient, common, Nat.add_assoc,
          Nat.cast_add, Nat.cast_one, Real.rpow_eq_pow] using hnumeric.1)
      (by
        simpa only [scale, qActual, sActual, statusHi, statusLo, currentHi,
          lossK, persistentInternalStatusHi, persistentInternalStatusLo,
          persistentInternalLossCollisionCoefficient, common, Nat.add_assoc,
          Nat.cast_add, Nat.cast_one, Real.rpow_eq_pow] using hnumeric.2)
  exact hmean

/-- The two source decompositions of Lemma 7.20, packaged against the
literal killed-loss error above.  Rank one uses C5/common-links and the
chosen-oriented C-star profile; higher ranks use legal-pair rerooting. -/
theorem persistentInternalConflictLink_killedLoss_le_error_of_stateCaps
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ) (Pfloor : ℝ)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3)
    (u : Fin (q.1 + 1)) (M : Hypergraph V)
    (hf : f.1 ∈ availableEdges H R.regularized M)
    (Caps : PersistentInternalStateSourceCaps H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) eta N T k Pfloor j w R f q u M) :
    let qActual := q.1 + 1
    let sActual := u.1 + 1
    let scale := persistentInternalSourceScale H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R q
    meanKilledPartialTestLoss
        (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized f.1 qActual sActual M ≤
      persistentInternalKilledLossError H R.regularized d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) eta D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (N : ℝ) scale k q u M := by
  dsimp only
  let qActual := q.1 + 1
  let sActual := u.1 + 1
  let epsRaw := CFMRegularization.rawRegularizationEps eta
  let GammaCert : ℝ := 2 * (ell : ℝ) + 1
  let GammaCore : ℝ := 6 * GammaCert
  let scale := persistentInternalSourceScale H C d epsRaw GammaCert
    ell j w R q
  let codegreeHi := Nat.ceil (d ^ (1 - eta))
  let mixedHi := certificateMixedLossCapNat eta epsRaw d
  let rerootHi := Nat.ceil (30 * localSpreadPrimaryMargin eta d)
  let currentHi := scale *
    (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
        qActual sActual (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d (N : ℝ)
          qActual sActual (k : ℝ))
  rcases hinst with
    ⟨hH8, _hCsys, _hell4, _hCfour, _heta0, _heta1, _hd,
      _hNupper, _hdegreeOn, _hcodegree, _hbounded, _hio, _htrack⟩
  by_cases hqzero : q.1 = 0
  · have hqActual : qActual = 1 := by omega
    have hu : u.1 = 0 := by omega
    have hsActual : sActual = 1 := by omega
    let immediateHi := Nat.ceil (Real.rpow d (1 - epsRaw / 4))
    let cstarR := persistentInternalRankOneCStarBound
      R.regularized d epsRaw GammaCert eta
    let cstarHi := Nat.ceil cstarR
    have himmediate : ∀ g ∈
        conflictBlockerChoices R.regularized M
          (availableEdges H R.regularized M) f.1,
        (conflictLinkLayer R.regularized f.1 1 ∩
          conflictLinkLayer R.regularized g 1).card ≤ immediateHi := by
      intro g hg
      have hgA : g ∈ availableEdges H R.regularized M :=
        (Finset.mem_filter.mp hg).1
      have hdisj : Disjoint g f.1 := (Finset.mem_filter.mp hg).2.1
      have hreal := R.rankOneImmediateIntersection_le f.2
        (availableEdges_subset H R.regularized M hgA) hdisj.symm
      exact_mod_cast hreal.trans (Nat.le_ceil _)
    have hcstar : ∀ g ∈
        conflictBlockerChoices R.regularized M
          (availableEdges H R.regularized M) f.1,
        ∑ r ∈ Finset.Icc 2 3,
          (partialFamily
            (commonImmediateEvictorLinkLayer R.regularized f.1 g r)
            (availableEdges H R.regularized M) M 1).card ≤ cstarHi := by
      intro g hg
      have hgA : g ∈ availableEdges H R.regularized M :=
        (Finset.mem_filter.mp hg).1
      have hsum : ((∑ r ∈ Finset.Icc (2 : ℕ) 3,
          (partialFamily
            (commonImmediateEvictorLinkLayer R.regularized f.1 g r)
            (availableEdges H R.regularized M) M 1).card : ℕ) : ℝ) ≤
          cstarR := by
        dsimp only [cstarR, persistentInternalRankOneCStarBound]
        push_cast
        apply Finset.sum_le_sum
        intro r hr
        exact Caps.cstar g (availableEdges_subset H R.regularized M hgA)
          r (Finset.mem_Icc.mp hr).1 (Finset.mem_Icc.mp hr).2
      exact_mod_cast hsum.trans (Nat.le_ceil _)
    have hvictimNat := rankOneKilledCCVictimMass_le
      H R.regularized M (fun c hc ↦ R.bounded.conflict_card hc)
        f.1 immediateHi cstarHi himmediate hcstar
    have hblockSub : conflictBlockerChoices R.regularized M
        (availableEdges H R.regularized M) f.1 ⊆
        availableBlockerChoices H R.regularized M f.1 := by
      intro g hg
      have hmem := Finset.mem_filter.mp hg
      apply Finset.mem_filter.mpr
      refine ⟨hmem.1, Or.inr (fun hcfm ↦ ?_)⟩
      apply hmem.2.2
      simpa only [Finset.insert_comm f.1 g] using hcfm.2
    have hblockCast :
        ((conflictBlockerChoices R.regularized M
          (availableEdges H R.regularized M) f.1).card : ℝ) ≤
        ((availableBlockerChoices H R.regularized M f.1).card : ℝ) := by
      exact_mod_cast Finset.card_le_card hblockSub
    have hblock :
        ((conflictBlockerChoices R.regularized M
          (availableEdges H R.regularized M) f.1).card : ℝ) ≤
        persistentInternalStatusHi D₂ D₃ D₄ GammaCore eta d (N : ℝ) k :=
      hblockCast.trans (Caps.status f.1 hf).2
    have hvictim : (rankOneKilledCCVictimMass H R.regularized M f.1 : ℝ) ≤
