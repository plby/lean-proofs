    exact CFMTrajectories.dHat_pos hd hp
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos hd R.delta.degree.N_pos hp
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hstatus0 : 0 ≤ status := by
    dsimp only [status, eps]
    exact certificateTestStatusHi_nonneg_of_registry R.delta
  have hstatusD : status ≤ 18 * Gamma * D := by
    dsimp only [status, eps, D]
    exact certificateStatusHi_le_eighteenGamma_dHat E S R.delta
  have hs3 : s ≤ 3 := R.s_le_j.trans hj3
  have hsR : (s : ℝ) ≤ 3 := by exact_mod_cast hs3
  have hm : 0 ≤ CFMTrajectories.pM d N (k : ℝ) :=
    CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
      (R.delta.degree.time_nonneg (k : ℝ) hx)
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N (k : ℝ) :=
