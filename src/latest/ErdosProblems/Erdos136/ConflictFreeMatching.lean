/-! ## Integrated: SharpFinalReachableTestGood -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-- The deterministic reachability invariants needed by the sharp source
packages.  They are components of the finite Good family so pointwise jump
bounds may use them on every Good state. -/
inductive TestReachabilityInvariantIndex
  | matching
  | timeCard
deriving DecidableEq

instance : Fintype TestReachabilityInvariantIndex where
  elems := {TestReachabilityInvariantIndex.matching,
    TestReachabilityInvariantIndex.timeCard}
  complete x := by cases x <;> simp

/-- Final finite index for all degree/test profiles plus matching and exact
time-cardinality.  There is no internal-original full-root coordinate:
internal links use the persistent next-live process.  Its one-open killed
loss is handled by legal-pair caps for ranks two and three and by the
rank-one `C5`/`commonLinks`/`C*` correction. -/
abbrev FinalReachableTestEnhancedIndex
    (H : Hypergraph V) (C : ConflictSystem V) (io : Type*)
    (j : io → ℕ) :=
  Sum
    (FiniteWeightedRootShadowEnhancedIndex H j
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := C) (io := io)))
    TestReachabilityInvariantIndex

noncomputable def finalReachableTestEnhancedPredicate
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    FinalReachableTestEnhancedIndex H R.regularized io j →
      ℕ → Hypergraph V → Prop
  | Sum.inl z, k, M =>
      combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R z k M
  | Sum.inr TestReachabilityInvariantIndex.matching, _k, M =>
      IsConflictFreeMatching H R.regularized M
  | Sum.inr TestReachabilityInvariantIndex.timeCard, k, M => M.card = k

theorem finalReachableGood_combined
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M := by
  intro z
  exact hgood (Sum.inl z)

theorem finalReachableGood_matching
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    IsConflictFreeMatching H R.regularized M := by
  exact hgood (Sum.inr TestReachabilityInvariantIndex.matching)

theorem finalReachableGood_card
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    M.card = k := by
  exact hgood (Sum.inr TestReachabilityInvariantIndex.timeCard)

theorem finalReachableGood_external
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M := by
  exact combinedGood_external H C d epsRaw GammaCert ellCert
    D₂ D₃ D₄ GammaCore eta N T j w R
      (finalReachableGood_combined H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R hgood)

theorem finalReachableGood_degree
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ GammaCore eta d N T j R.restrictedWeight) k M := by
  exact combinedGood_degree H C d epsRaw GammaCert ellCert
    D₂ D₃ D₄ GammaCore eta N T j w R
      (finalReachableGood_combined H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R hgood)

theorem finalReachableGood_certificateWithCore
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    certificateIndexedGreedyGoodWithCore H C d epsRaw GammaCert ellCert j w R
      D₂ D₃ D₄ GammaCore (CFMNumeric.coreEpsilon eta) (N : ℝ) k M := by
  exact combinedGood_certificateWithCore H C d epsRaw GammaCert ellCert
    D₂ D₃ D₄ GammaCore eta N T j w R
      (finalReachableGood_combined H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R hgood)

end

