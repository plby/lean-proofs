theorem externalTestLocalCap_le_two_margin
    {eta GammaCore d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    {N T k q rootCard selected : ℕ} {d₀ : ℝ}
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (hq : q ≤ 5) (hd₀ : 0 ≤ d₀) (hselected : 1 ≤ selected) :
    finiteWeightedRootShadowCap eta d (N : ℝ) d₀
        q rootCard selected k ≤
      2 * finiteWeightedRootShadowMargin eta d d₀
        rootCard selected := by
  have hdpos : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hrpowEta : 0 < Real.rpow d eta :=
    Real.rpow_pos_of_pos hdpos eta
  have hNpos : 0 < (N : ℝ) :=
    (div_pos hrpowEta (by norm_num)).trans_le hN
  have hfloor : 0 < localSpreadAvailableFloor eta d (N : ℝ) := by
    rw [localSpreadAvailableFloor_eq_rpow hdpos]
    exact div_pos
      (mul_pos hNpos (Real.rpow_pos_of_pos hdpos _)) (by norm_num)
  exact finiteWeightedRootShadowCap_le_two_margin hdpos hd₀ hfloor hk
    (finiteWeightedRootShadow_contract E S hN hT hq hd₀ hselected)
    (finiteWeightedRootShadow_reserve_one E S)

theorem vertexDuplicateGenericMargin_eq_rpow
    {eta d G : ℝ} {r rootCard selected : ℕ} (hd : 0 < d) :
    2 * finiteWeightedRootShadowMargin eta d
        (2304 * (3 * G + 1) * d *
          Real.rpow d
            ((r : ℝ) - CFMRegularization.rawRegularizationEps eta / 4))
        rootCard selected =
      4608 * (3 * G + 1) *
        Real.rpow d
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (rootCard : ℝ) - (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16) := by
  have hinvPow : (d⁻¹ : ℝ) ^ rootCard =
      Real.rpow d (-(rootCard : ℝ)) := by
    calc
      (d⁻¹ : ℝ) ^ rootCard = (d ^ rootCard)⁻¹ := inv_pow d rootCard
      _ = (Real.rpow d (rootCard : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d rootCard).symm
      _ = Real.rpow d (-(rootCard : ℝ)) :=
        (Real.rpow_neg hd.le _).symm
  have hstepPow :
      (Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ selected =
        Real.rpow d
          ((-1 + CFMNumeric.coreEpsilon eta / 16) * (selected : ℝ)) :=
    (Real.rpow_mul_natCast hd.le _ selected).symm
  have hcombine :
      ((Real.rpow d 1 *
          Real.rpow d
            ((r : ℝ) - CFMRegularization.rawRegularizationEps eta / 4)) *
        Real.rpow d (-(rootCard : ℝ))) *
          Real.rpow d
            ((-1 + CFMNumeric.coreEpsilon eta / 16) * (selected : ℝ)) =
        Real.rpow d
          (((1 + ((r : ℝ) -
              CFMRegularization.rawRegularizationEps eta / 4)) +
            (-(rootCard : ℝ))) +
            ((-1 + CFMNumeric.coreEpsilon eta / 16) *
              (selected : ℝ))) := by
    calc
      ((Real.rpow d 1 *
            Real.rpow d ((r : ℝ) -
              CFMRegularization.rawRegularizationEps eta / 4)) *
          Real.rpow d (-(rootCard : ℝ))) *
            Real.rpow d
              ((-1 + CFMNumeric.coreEpsilon eta / 16) * (selected : ℝ)) =
          ((Real.rpow d
              (1 + ((r : ℝ) -
                CFMRegularization.rawRegularizationEps eta / 4)) *
            Real.rpow d (-(rootCard : ℝ))) *
              Real.rpow d
                ((-1 + CFMNumeric.coreEpsilon eta / 16) *
                  (selected : ℝ))) := by
            rw [show Real.rpow d 1 *
                Real.rpow d ((r : ℝ) -
                  CFMRegularization.rawRegularizationEps eta / 4) =
              Real.rpow d
                (1 + ((r : ℝ) -
                  CFMRegularization.rawRegularizationEps eta / 4)) by
                exact (Real.rpow_add hd _ _).symm]
      _ = (Real.rpow d
              ((1 + ((r : ℝ) -
                CFMRegularization.rawRegularizationEps eta / 4)) +
                (-(rootCard : ℝ))) *
            Real.rpow d
              ((-1 + CFMNumeric.coreEpsilon eta / 16) *
                (selected : ℝ))) := by
          rw [show Real.rpow d
                (1 + ((r : ℝ) -
                  CFMRegularization.rawRegularizationEps eta / 4)) *
                Real.rpow d (-(rootCard : ℝ)) =
              Real.rpow d
                ((1 + ((r : ℝ) -
                  CFMRegularization.rawRegularizationEps eta / 4)) +
                    (-(rootCard : ℝ))) by
                exact (Real.rpow_add hd _ _).symm]
      _ = _ := by
          exact (Real.rpow_add hd _ _).symm
  unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
    finiteWeightedRootShadowStepFactor
  rw [hinvPow, hstepPow]
  calc
    2 *
        ((2304 * (3 * G + 1) * d *
              Real.rpow d
                ((r : ℝ) - CFMRegularization.rawRegularizationEps eta / 4)) *
            Real.rpow d (-(rootCard : ℝ)) *
          Real.rpow d
            ((-1 + CFMNumeric.coreEpsilon eta / 16) * (selected : ℝ))) =
        4608 * (3 * G + 1) *
          (((Real.rpow d 1 *
              Real.rpow d
                ((r : ℝ) -
                  CFMRegularization.rawRegularizationEps eta / 4)) *
            Real.rpow d (-(rootCard : ℝ))) *
              Real.rpow d
                ((-1 + CFMNumeric.coreEpsilon eta / 16) *
                  (selected : ℝ))) := by
      have hd1 : Real.rpow d 1 = d := Real.rpow_one d
      rw [hd1]
      ring
    _ = 4608 * (3 * G + 1) *
        Real.rpow d
          (((1 + ((r : ℝ) -
              CFMRegularization.rawRegularizationEps eta / 4)) +
            (-(rootCard : ℝ))) +
            ((-1 + CFMNumeric.coreEpsilon eta / 16) *
              (selected : ℝ))) := by rw [hcombine]
    _ = _ := by
      congr 2
      ring

theorem vertexDuplicateCoefficient_cube_le
    {eta G d : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) :
    4608 * (3 * G + 1) ≤
      Real.rpow d (3 * CFMNumeric.coreEpsilon eta / 64) := by
  have hd : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hG0 : 0 ≤ G := by linarith
  have hcorr : 24 * G ≤
      Real.rpow d (CFMNumeric.coreEpsilon eta / 64) := by
    calc
      24 * G = 4 * (6 * G) := by ring
      _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 64) :=
        S.correctionDenominator
  have hpow := pow_le_pow_left₀ (mul_nonneg (by norm_num) hG0) hcorr 3
  have hcoeff : 4608 * (3 * G + 1) ≤ (24 * G) ^ (3 : ℕ) := by
    have hGsq : 2 ≤ G ^ 2 := by nlinarith [sq_nonneg (G - 2)]
    have hmul := mul_le_mul_of_nonneg_left hGsq
      (mul_nonneg (by norm_num : (0 : ℝ) ≤ 13824) hG0)
    nlinarith
  calc
    4608 * (3 * G + 1) ≤ (24 * G) ^ (3 : ℕ) := hcoeff
    _ ≤ (Real.rpow d (CFMNumeric.coreEpsilon eta / 64)) ^ (3 : ℕ) := hpow
    _ = Real.rpow d (3 * CFMNumeric.coreEpsilon eta / 64) := by
      calc
        (Real.rpow d (CFMNumeric.coreEpsilon eta / 64)) ^ (3 : ℕ) =
            Real.rpow d
              ((CFMNumeric.coreEpsilon eta / 64) * (3 : ℝ)) :=
          (Real.rpow_mul_natCast hd _ _).symm
        _ = Real.rpow d (3 * CFMNumeric.coreEpsilon eta / 64) := by
          congr 1
          ring

theorem vertexDuplicatePrimaryCoefficient_six_le
    {eta G d : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 1 ≤ G) :
    768 * (4608 * (3 * G + 1)) ≤
      Real.rpow d (6 * CFMNumeric.coreEpsilon eta / 64) := by
  have hd : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hG0 : 0 ≤ G := le_trans zero_le_one hG
  have hcorr : 24 * G ≤
      Real.rpow d (CFMNumeric.coreEpsilon eta / 64) := by
    calc
      24 * G = 4 * (6 * G) := by ring
      _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 64) :=
        S.correctionDenominator
  have hpow := pow_le_pow_left₀ (mul_nonneg (by norm_num) hG0) hcorr 6
  have hGonePow : G ≤ G ^ (6 : ℕ) := by
    have hfive : (1 : ℝ) ≤ G ^ (5 : ℕ) := by
      exact one_le_pow₀ hG
    calc
      G = G * 1 := by ring
      _ ≤ G * G ^ (5 : ℕ) := mul_le_mul_of_nonneg_left hfive hG0
      _ = G ^ (6 : ℕ) := by ring
  have hcoeff :
      768 * (4608 * (3 * G + 1)) ≤ (24 * G) ^ (6 : ℕ) := by
    calc
      768 * (4608 * (3 * G + 1)) ≤ 14155776 * G := by nlinarith
      _ ≤ 191102976 * G := by
        exact mul_le_mul_of_nonneg_right (by norm_num) hG0
      _ ≤ 191102976 * G ^ (6 : ℕ) := by
        exact mul_le_mul_of_nonneg_left hGonePow (by norm_num)
      _ = (24 * G) ^ (6 : ℕ) := by ring
  calc
    768 * (4608 * (3 * G + 1)) ≤ (24 * G) ^ (6 : ℕ) := hcoeff
    _ ≤ (Real.rpow d (CFMNumeric.coreEpsilon eta / 64)) ^ (6 : ℕ) := hpow
    _ = Real.rpow d (6 * CFMNumeric.coreEpsilon eta / 64) := by
      calc
        (Real.rpow d (CFMNumeric.coreEpsilon eta / 64)) ^ (6 : ℕ) =
            Real.rpow d
              ((CFMNumeric.coreEpsilon eta / 64) * (6 : ℝ)) :=
          (Real.rpow_mul_natCast hd _ _).symm
        _ = Real.rpow d (6 * CFMNumeric.coreEpsilon eta / 64) := by
          congr 1
          ring

theorem vertexDuplicateGenericMargin_le_nonprimaryCap
    {eta G d : ℝ} {r rootCard selected : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hr5 : r ≤ 5) (hs : 1 ≤ selected) :
    2 * finiteWeightedRootShadowMargin eta d
        (2304 * (3 * G + 1) * d *
          Real.rpow d
            ((r : ℝ) - CFMRegularization.rawRegularizationEps eta / 4))
        rootCard selected ≤
      Real.rpow d
        ((r : ℝ) + 1 -
          CFMRegularization.rawRegularizationEps eta / 4 -
          (rootCard : ℝ) - (selected : ℝ) +
          (selected : ℝ) * CFMNumeric.coreEpsilon eta / 8) := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hcore : 0 ≤ CFMNumeric.coreEpsilon eta := by
    unfold CFMNumeric.coreEpsilon CFMRegularization.rawRegularizationEps
    nlinarith [E.eta_pos]
  have hcoeff := vertexDuplicateCoefficient_cube_le S hG
  rw [vertexDuplicateGenericMargin_eq_rpow hdpos]
  calc
    4608 * (3 * G + 1) *
        Real.rpow d
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (rootCard : ℝ) - (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16) ≤
      Real.rpow d (3 * CFMNumeric.coreEpsilon eta / 64) *
        Real.rpow d
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (rootCard : ℝ) - (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16) :=
      mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hdpos.le _)
    _ = Real.rpow d
        (3 * CFMNumeric.coreEpsilon eta / 64 +
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (rootCard : ℝ) - (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16)) :=
      (Real.rpow_add hdpos _ _).symm
    _ ≤ _ := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      have hsR : (1 : ℝ) ≤ (selected : ℝ) := by exact_mod_cast hs
      nlinarith

theorem vertexDuplicateGenericMargin_le_primaryCap
    {eta G d : ℝ} {r selected : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 1 ≤ G) (hr5 : r ≤ 5) (hselected : selected + 1 = r) :
    2 * finiteWeightedRootShadowMargin eta d
        (2304 * (3 * G + 1) * d *
          Real.rpow d
            ((r : ℝ) - CFMRegularization.rawRegularizationEps eta / 4))
        0 selected ≤ vertexDuplicatePrimaryMargin eta d := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hcore : 0 ≤ CFMNumeric.coreEpsilon eta := by
    unfold CFMNumeric.coreEpsilon CFMRegularization.rawRegularizationEps
    nlinarith [E.eta_pos]
  have hcoeff := vertexDuplicatePrimaryCoefficient_six_le S hG
  unfold vertexDuplicatePrimaryMargin
  apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 768)).2
  rw [vertexDuplicateGenericMargin_eq_rpow hdpos]
  simp only [Nat.cast_zero, sub_zero]
  calc
    (4608 * (3 * G + 1) *
          Real.rpow d
            ((r : ℝ) + 1 -
              CFMRegularization.rawRegularizationEps eta / 4 -
              (selected : ℝ) +
              (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16)) * 768 =
      (768 * (4608 * (3 * G + 1))) *
        Real.rpow d
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16) := by ring
    _ ≤ Real.rpow d (6 * CFMNumeric.coreEpsilon eta / 64) *
        Real.rpow d
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16) :=
      mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hdpos.le _)
    _ = Real.rpow d
        (6 * CFMNumeric.coreEpsilon eta / 64 +
          ((r : ℝ) + 1 -
            CFMRegularization.rawRegularizationEps eta / 4 -
            (selected : ℝ) +
            (selected : ℝ) * CFMNumeric.coreEpsilon eta / 16)) :=
      (Real.rpow_add hdpos _ _).symm
    _ ≤ Real.rpow d (2 - CFMNumeric.coreEpsilon eta / 2) := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      have hsR : (selected : ℝ) ≤ 4 := by exact_mod_cast (by omega : selected ≤ 4)
      have hselCast : (r : ℝ) = (selected : ℝ) + 1 := by
        exact_mod_cast hselected.symm
      have hraw : CFMRegularization.rawRegularizationEps eta =
          5 * CFMNumeric.coreEpsilon eta := by
        simp only [CFMNumeric.coreEpsilon]
        ring
      rw [hraw]
      nlinarith

theorem finiteVertexDuplicateGenericCap_le_existing
    {eta G d : ℝ} {N T k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    {H : Hypergraph V} (z : VertexDuplicateRootShadowCoordinate H) :
    finiteWeightedRootShadowCap eta d (N : ℝ)
        (2304 * (3 * G + 1) * d *
          Real.rpow d
            ((z.layer.1 : ℝ) -
              CFMRegularization.rawRegularizationEps eta / 4))
        z.layer.1 z.root.card z.rank.1 k ≤
      vertexDuplicateRootShadowCap eta d z k := by
  have hscale0 : 0 ≤
      2304 * (3 * G + 1) * d *
        Real.rpow d
          ((z.layer.1 : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4) := by
    have hcoef : 0 ≤ 3 * G + 1 := by linarith
    have hd0 : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) hcoef) hd0)
      (Real.rpow_nonneg hd0 _)
  have hgeneric := externalTestLocalCap_le_two_margin
    (q := z.layer.1) (rootCard := z.root.card)
    (selected := z.rank.1)
    (d₀ := 2304 * (3 * G + 1) * d *
      Real.rpow d ((z.layer.1 : ℝ) -
        CFMRegularization.rawRegularizationEps eta / 4))
    E S hN hT hk (by omega) hscale0 z.rank_pos
  by_cases hp : z.root = ∅ ∧ z.rank.1 + 1 = z.layer.1
  · rw [vertexDuplicateRootShadowCap, if_pos hp]
    have hroot : z.root.card = 0 := by simp [hp.1]
    rw [hroot] at hgeneric ⊢
    exact hgeneric.trans
      (vertexDuplicateGenericMargin_le_primaryCap E S (by linarith)
        (by omega) hp.2)
  · rw [vertexDuplicateRootShadowCap, if_neg hp]
    exact hgeneric.trans
      (vertexDuplicateGenericMargin_le_nonprimaryCap E S hG
        (by omega) z.rank_pos)

def vertexDuplicateToExternalRootCoordinate
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (z : VertexDuplicateRootShadowCoordinate H) (hroot : z.root ⊆ H) :
    ExternalTestLocalRootCoordinate H C io j where
  profile := vertexDuplicateLocalProfile H C z.vertex z.layer.1
    z.layer_lower (by omega)
  root := z.root
  root_subset_host := hroot
  seed_subset_root := Finset.empty_subset z.root
  selected := z.rank
  selected_pos := z.rank_pos
  legal := by
    simp only [vertexDuplicateLocalProfile,
      externalTestLocalProfileActiveRank]
    have hlegal := z.legal
    omega

@[simp] theorem vertexDuplicateToExternalRootCoordinate_weight
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (z : VertexDuplicateRootShadowCoordinate H) (hroot : z.root ⊆ H) :
    finiteWeightedRootShadowWeight
        (externalTestLocalProfileFamily H C j R)
        (externalTestLocalProfileWeight H C j R)
        (vertexDuplicateToExternalRootCoordinate
          H R.regularized j z hroot) =
      vertexDuplicateRootShadowWeight H R.regularized z := by
  rfl

/-- Every represented duplicate union is supported on the host whenever
the ambient conflict family is a conflict system on that host. -/
theorem duplicateConflictLinkUnionLayer_subset_host
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V) (r : ℕ) :
    ∀ U ∈ duplicateConflictLinkUnionLayer C f r, U ⊆ H := by
  intro U hU x hxU
  obtain ⟨p, hp, hpU⟩ := mem_duplicateConflictLinkUnions.mp
    (mem_duplicateConflictLinkUnionLayer.mp hU).1
  rw [← hpU] at hxU
  obtain ⟨Q, hQp, hxQ⟩ := Finset.mem_biUnion.mp hxU
  have hQall := (mem_duplicateConflictLinkPairs.mp hp).1 hQp
  obtain ⟨q, _hq, hQlink⟩ := mem_allNonemptyConflictLinks.mp hQall
  exact conflictLinkLayer_subset_host hC f q Q hQlink hxQ

theorem vertexDuplicateLayerFamily_subset_host
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (v : V) (r : ℕ) :
    ∀ U ∈ vertexDuplicateLayerFamily H C v r, U ⊆ H := by
  intro U hU
  obtain ⟨f, _hf, hUf⟩ := Finset.mem_biUnion.mp hU
  exact duplicateConflictLinkUnionLayer_subset_host hC f r U hUf

theorem vertexDuplicateRootShadowWeight_eq_zero_of_not_subset_host
    (H : Hypergraph V) (C : ConflictSystem V)
    (hC : IsConflictSystem H C)
    (z : VertexDuplicateRootShadowCoordinate H) (hroot : ¬z.root ⊆ H) :
    vertexDuplicateRootShadowWeight H C z = 0 := by
  funext S
  unfold vertexDuplicateRootShadowWeight
    weightedConflictFamilyRootShadowWeight
  split
  · unfold weightedCodegree
    have hempty :
        (vertexDuplicateLayerFamily H C z.vertex.1 z.layer.1).filter
            (z.root ∪ S ⊆ ·) = ∅ := by
      apply Finset.filter_eq_empty_iff.mpr
      intro U hU hUSub
      apply hroot
      exact Finset.subset_union_left.trans
        (hUSub.trans
          (vertexDuplicateLayerFamily_subset_host
            hC z.vertex.1 z.layer.1 U hU))
    rw [hempty]
    simp
  · rfl

theorem vertexDuplicateRootShadowCap_pos
    {H : Hypergraph V} {eta d : ℝ} (hd : 0 < d)
    (z : VertexDuplicateRootShadowCoordinate H) (k : ℕ) :
    0 < vertexDuplicateRootShadowCap eta d z k := by
  unfold vertexDuplicateRootShadowCap
  split
  · unfold vertexDuplicatePrimaryMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  · exact Real.rpow_pos_of_pos hd _

theorem vertexDuplicateRootShadowPredicate_of_not_subset_host
    (H : Hypergraph V) (C : ConflictSystem V)
    (hC : IsConflictSystem H C) {eta d : ℝ} (hd : 0 < d)
    (z : VertexDuplicateRootShadowCoordinate H) (hroot : ¬z.root ⊆ H)
    (k : ℕ) (M : Hypergraph V) :
    vertexDuplicateRootShadowPredicate H C eta d z k M := by
  unfold vertexDuplicateRootShadowPredicate localSpreadUpperCorridor
    localSpreadUpperError vertexDuplicateRootShadowRank
  rw [vertexDuplicateRootShadowWeight_eq_zero_of_not_subset_host
    H C hC z hroot]
  simpa [testTotal] using vertexDuplicateRootShadowCap_pos hd z k

theorem externalVertexDuplicatePredicate_implies_existing
    {eta G d : ℝ} {N T k : ℕ} {M : Hypergraph V}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta) G ellCert j w)
    (z : VertexDuplicateRootShadowCoordinate H) (hroot : z.root ⊆ H)
    (hstrong : finiteWeightedRootShadowPredicate H
      (externalTestLocalProfileFamilyRank j)
      (externalTestLocalProfileActiveRank j)
      (externalTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (externalTestLocalProfileFamily H C j R)
      (externalTestLocalProfileWeight H C j R)
      eta d (N : ℝ)
      (externalTestLocalProfileScale
        H C d (CFMRegularization.rawRegularizationEps eta) G ellCert j w R)
      (vertexDuplicateToExternalRootCoordinate H R.regularized j z hroot) k M) :
    vertexDuplicateRootShadowPredicate H R.regularized eta d z k M := by
  apply localSpreadUpperCorridor_mono_cap
    (vertexDuplicateRootShadowWeight H R.regularized z) z.rank.1
    (finiteWeightedRootShadowCap eta d (N : ℝ)
      (2304 * (3 * G + 1) * d *
        Real.rpow d ((z.layer.1 : ℝ) -
          CFMRegularization.rawRegularizationEps eta / 4))
      z.layer.1 z.root.card z.rank.1)
    (vertexDuplicateRootShadowCap eta d z)
    (finiteVertexDuplicateGenericCap_le_existing E S hG hN hT hk z)
  rw [← vertexDuplicateToExternalRootCoordinate_weight
    H C j R z hroot]
  simpa [finiteWeightedRootShadowPredicate,
    finiteWeightedRootShadowRank,
    vertexDuplicateToExternalRootCoordinate,
    vertexDuplicateRootShadowPredicate,
    vertexDuplicateRootShadowRank,
    externalTestLocalProfileScale,
    externalTestLocalProfileFamilyRank,
    vertexDuplicateLocalProfile] using hstrong

/-- Bounded-time form of component domination.  The cap comparison used by
the duplicate adapter is valid precisely through the greedy horizon. -/
theorem greedyFirstFailureEvent_subset_of_component_implication_upto
    {I : Type*} [Fintype I]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop) (weak strong : I)
    (himp : ∀ k, k ≤ T → ∀ S, P strong k S → P weak k S) :
    greedyFirstFailureEvent H C M T P weak ⊆
      greedyFirstFailureEvent H C M T P strong := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega ⊢
  obtain ⟨homegaUniv, k, hk, hprefix, hfail⟩ := homega
  exact ⟨homegaUniv, k, hk, hprefix, fun hstrong ↦
    hfail (himp (k + 1) (Nat.succ_le_of_lt hk)
      (greedyStateFromAt H C M omega (k + 1)) hstrong)⟩

theorem greedyFirstFailureEvent_eq_empty_of_component_always
    {I : Type*} [Fintype I]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop) (i : I)
    (hall : ∀ k S, P i k S) :
    greedyFirstFailureEvent H C M T P i = ∅ := by
  apply Finset.not_nonempty_iff_eq_empty.mp
  rintro ⟨omega, homega⟩
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_homegaUniv, k, _hk, _hprefix, hfail⟩ := homega
  exact hfail (hall (k + 1) (greedyStateFromAt H C M omega (k + 1)))

/-- A concrete weighted duplicate profile implies the older duplicate
corridor throughout the finite horizon.  This is the exact bridge used to
charge the retained degree-enhanced coordinate to the new shadow tail. -/
theorem externalVertexDuplicateFirstFailureEvent_subset
    {eta G d : ℝ} {N T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert j w)
    (D₂ D₃ D₄ : ℝ) (z : VertexDuplicateRootShadowCoordinate H)
    (hroot : z.root ⊆ H) :
    let P := externalTestLocalEnhancedPredicate H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert
      D₂ D₃ D₄ (6 * G) eta N T j w R
    greedyFirstFailureEvent H R.regularized ∅ T P
        (Sum.inl (Sum.inr z)) ⊆
      greedyFirstFailureEvent H R.regularized ∅ T P
        (Sum.inr
          (vertexDuplicateToExternalRootCoordinate
            H R.regularized j z hroot)) := by
  dsimp only
  apply greedyFirstFailureEvent_subset_of_component_implication_upto
  intro k hk M hstrong
  change finiteWeightedRootShadowPredicate H
    (externalTestLocalProfileFamilyRank j)
    (externalTestLocalProfileActiveRank j)
    (externalTestLocalProfileSeed
      (H := H) (C := R.regularized) (io := io))
    (externalTestLocalProfileFamily H C j R)
    (externalTestLocalProfileWeight H C j R)
    eta d (N : ℝ)
    (externalTestLocalProfileScale H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert j w R)
    (vertexDuplicateToExternalRootCoordinate
      H R.regularized j z hroot) k M at hstrong
  change vertexDuplicateRootShadowPredicate
    H R.regularized eta d z k M
  exact externalVertexDuplicatePredicate_implies_existing
    E S hG hN hT hk H C j w R z hroot hstrong

theorem externalVertexDuplicateFirstFailureEvent_eq_empty_of_not_subset_host
    {eta d : ℝ} (hd : 0 < d) {N T : ℕ}
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d epsRaw
      GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore : ℝ)
    (z : VertexDuplicateRootShadowCoordinate H) (hroot : ¬z.root ⊆ H) :
    greedyFirstFailureEvent H R.regularized ∅ T
        (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
          D₂ D₃ D₄ GammaCore eta N T j w R)
        (Sum.inl (Sum.inr z)) = ∅ := by
  apply greedyFirstFailureEvent_eq_empty_of_component_always
  intro k M
  change vertexDuplicateRootShadowPredicate H R.regularized eta d z k M
  exact vertexDuplicateRootShadowPredicate_of_not_subset_host
    H R.regularized R.isConflictSystem hd z hroot k M

theorem externalVertexDuplicateFirstFailureMass_le_profile
    {eta G d : ℝ} {N T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert j w)
    (D₂ D₃ D₄ : ℝ) (z : VertexDuplicateRootShadowCoordinate H)
    (hroot : z.root ⊆ H) :
    let P := externalTestLocalEnhancedPredicate H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert
      D₂ D₃ D₄ (6 * G) eta N T j w R
    Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
        (greedyFirstFailureEvent H R.regularized ∅ T P
          (Sum.inl (Sum.inr z))) ≤
      Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
        (greedyFirstFailureEvent H R.regularized ∅ T P
          (Sum.inr
            (vertexDuplicateToExternalRootCoordinate
              H R.regularized j z hroot))) := by
  dsimp only
  exact eventMass_mono_of_nonneg
    (greedyPathMassFrom H R.regularized ∅)
    (greedyPathMassFrom_nonneg H R.regularized ∅)
    (externalVertexDuplicateFirstFailureEvent_subset E S hG hN hT
      H C j w R D₂ D₃ D₄ z hroot)

/-- Every retained duplicate coordinate is charged to one concrete profile
tail.  Unsupported roots contribute zero, so no additional family or
availability premise appears in the final union bound. -/
theorem externalVertexDuplicateFirstFailureMass_le_of_profileTail
    {eta G d : ℝ} {N T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert j w)
    (D₂ D₃ D₄ : ℝ)
    (hprofile : ∀ c : ExternalTestLocalRootCoordinate
        H R.regularized io j,
      Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
          (greedyFirstFailureEvent H R.regularized ∅ T
            (externalTestLocalEnhancedPredicate H C d
              (CFMRegularization.rawRegularizationEps eta) G ellCert
              D₂ D₃ D₄ (6 * G) eta N T j w R)
            (Sum.inr c)) ≤
        finiteWeightedRootShadowStrongTail eta d)
    (z : VertexDuplicateRootShadowCoordinate H) :
    Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
        (greedyFirstFailureEvent H R.regularized ∅ T
          (externalTestLocalEnhancedPredicate H C d
            (CFMRegularization.rawRegularizationEps eta) G ellCert
            D₂ D₃ D₄ (6 * G) eta N T j w R)
          (Sum.inl (Sum.inr z))) ≤
      finiteWeightedRootShadowStrongTail eta d := by
  by_cases hroot : z.root ⊆ H
  · exact (externalVertexDuplicateFirstFailureMass_le_profile
      E S hG hN hT H C j w R D₂ D₃ D₄ z hroot).trans
        (hprofile (vertexDuplicateToExternalRootCoordinate
          H R.regularized j z hroot))
  · rw [externalVertexDuplicateFirstFailureEvent_eq_empty_of_not_subset_host
      (by linarith [S.degreeAtLeastTwo]) H C j w R
        D₂ D₃ D₄ (6 * G) z hroot]
    exact (Real.exp_pos _).le

/-- No-premise projection of the concrete profile component back to the
retained degree duplicate corridor, including roots outside the host. -/
theorem externalTestLocalEnhancedGood_vertexDuplicateMapped
    {eta G d : ℝ} {N T k : ℕ} {M : Hypergraph V}
    (E : CFMNumeric.CoreExponentSpec eta (6 * G))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * G) d)
    (hG : 2 ≤ G) (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) G ellCert j w)
    (D₂ D₃ D₄ : ℝ)
    (hgood : indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta) G ellCert
        D₂ D₃ D₄ (6 * G) eta N T j w R) k M)
    (z : VertexDuplicateRootShadowCoordinate H) :
    vertexDuplicateRootShadowPredicate H R.regularized eta d z k M := by
  by_cases hroot : z.root ⊆ H
  · apply externalVertexDuplicatePredicate_implies_existing
      E S hG hN hT hk H C j w R z hroot
    exact hgood (Sum.inr
      (vertexDuplicateToExternalRootCoordinate H R.regularized j z hroot))
  · exact vertexDuplicateRootShadowPredicate_of_not_subset_host
      H R.regularized R.isConflictSystem
        (by linarith [S.degreeAtLeastTwo]) z hroot k M


/-- Uniform extraction for a concrete profile partial mass.  The dynamic
corridor handles positive selected rank, while selected rank zero is
closed directly from the profile's static empty-root endpoint. -/
theorem weightedProfilePartialMass_le_two_margin_of_enhancedGood
    {Profile : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ GammaCore eta d : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (familyRank activeRank : Profile → ℕ)
    (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M A : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (finiteWeightedRootShadowEnhancedPredicate H C
        D₂ D₃ D₄ GammaCore eta d N T j w
          familyRank activeRank seed X a d₀) k M)
    (b : Profile) (t : ℕ)
    (huniform : IsUniform (X b) (familyRank b))
    (hnonneg : ∀ U, 0 ≤ a b U)
    (ht : t ≤ familyRank b)
    (hrank : familyRank b ≤ 5)
    (hactive : familyRank b - t ≤ activeRank b)
    (hseed : seed b = ∅)
    (hd₀0 : 0 ≤ d₀ b)
    (hzero : weightedCodegree (X b) (a b) ∅ ≤ d₀ b) :
    weightedPartialFamilyMass (X b) (a b) A M t ≤
      2 * finiteWeightedRootShadowMargin eta d (d₀ b)
        0 (familyRank b - t) := by
  have hpartial := weightedPartialFamilyMass_le_shadowTotal
    (X b) (a b) A M (familyRank b) t huniform hnonneg
  by_cases hnzero : familyRank b - t = 0
  · have hshadow :
        testTotal (weightedConflictFamilyShadowWeight (X b) (a b)) M 0 =
          weightedCodegree (X b) (a b) ∅ := by
      simp [testTotal, weightedConflictFamilyShadowWeight]
    rw [hnzero] at hpartial ⊢
    rw [hshadow] at hpartial
    simpa [finiteWeightedRootShadowMargin,
      finiteWeightedRootShadowZeroScale] using
        hpartial.trans (hzero.trans (by nlinarith))
  · have hnpos : 1 ≤ familyRank b - t :=
      Nat.one_le_iff_ne_zero.mpr hnzero
    have hcap := weightedPartialFamilyMass_le_cap_of_enhancedGood
      H C D₂ D₃ D₄ GammaCore eta d N T j w
        familyRank activeRank seed X a d₀ (A := A) hgood b t huniform hnonneg
        (by omega) hrank hactive hseed
    exact hcap.trans (externalTestLocalCap_le_two_margin
      E S hN hT hk hrank hd₀0 hnpos)

/-- The concrete original-test shadow bound needed by both pointwise gain
and pointwise loss.  Rank zero is discharged by the static all-root
endpoint; positive ranks are projected from the enhanced Good predicate.
Thus callers do not have to split the top coordinate `s = j`. -/
theorem externalOriginalRootShadow_le_two_margin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (a : io) (e : Finset V) (heH : e ∈ H) (n : ℕ)
    (hn : n ≤ j a - 1) :
    testTotal
        (originalTestRootShadowWeight (R.restrictedWeight a) H (j a) e)
        M n ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ellCert : ℝ) *
          testTotal (R.restrictedWeight a) H (j a) *
            Real.rpow d (-1 - epsRaw / 5)) 0 n := by
  let b : ExternalTestLocalProfileIndex H R.regularized io :=
    externalOriginalLocalProfile H R.regularized a ⟨e, heH⟩
  let d₀ : ℝ := (ellCert : ℝ) *
    testTotal (R.restrictedWeight a) H (j a) *
      Real.rpow d (-1 - epsRaw / 5)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hWpos : 0 < testTotal (R.restrictedWeight a) H (j a) :=
    (Real.rpow_pos_of_pos hdpos ((j a : ℝ) + epsRaw / 5)).trans_le
      (R.survivingTrackable a).total_lower
  have hd₀0 : 0 ≤ d₀ := by
    dsimp only [d₀]
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg ellCert) hWpos.le)
      (Real.rpow_nonneg hdpos.le _)
  by_cases hnzero : n = 0
  · subst n
    have hstatic := originalTestChoiceRemainder_root_le_scale
      (R.survivingTrackable a) hd (by positivity) hell e heH (hj1 a)
        ∅ (by simp)
    have htotal :
        testTotal
            (originalTestRootShadowWeight
              (R.restrictedWeight a) H (j a) e) M 0 =
          weightedCodegree
            (originalTestChoiceRemainderFamily H (j a) e)
            (originalTestChoiceRemainderWeight
              (R.restrictedWeight a) e) ∅ := by
      rw [← testTotal_originalTestChoice_emptyRootShadow_eq
        (R.restrictedWeight a) H M (j a) 0 e heH (hj1 a)]
      simp [testTotal, weightedConflictFamilyRootShadowWeight]
    rw [htotal]
    have hstatic' :
        weightedCodegree
            (originalTestChoiceRemainderFamily H (j a) e)
            (originalTestChoiceRemainderWeight
              (R.restrictedWeight a) e) ∅ ≤ d₀ := by
      simpa [d₀] using hstatic
    have hd₀two : d₀ ≤ 2 * d₀ := by linarith
    simpa [finiteWeightedRootShadowMargin,
      finiteWeightedRootShadowZeroScale, d₀] using hstatic'.trans hd₀two
  · have hnpos : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hnzero
    have hja := hj3 a
    have hnlt : n < 6 := by omega
    have hbActive : n ≤ externalTestLocalProfileActiveRank j b := by
      simpa [b, externalOriginalLocalProfile,
        externalTestLocalProfileActiveRank] using hn
    let c : ExternalTestLocalRootCoordinate
        H R.regularized io j :=
      finiteWeightedRootShadowEmptyCoordinate (H := H)
        b n hnpos hnlt hbActive
          (externalTestLocalProfileSeed_eq_empty H R.regularized b)
    have hcap := externalTestLocalCap_of_enhancedGood
      H C d epsRaw GammaCert ellCert D₂ D₃ D₄ GammaCore eta N T
        j w R hgood c
    have hweight :
        weightedConflictFamilyShadowWeight
            (originalTestChoiceRemainderFamily H (j a) e)
            (originalTestChoiceRemainderWeight (R.restrictedWeight a) e) =
          originalTestRootShadowWeight (R.restrictedWeight a) H (j a) e := by
      calc
        weightedConflictFamilyShadowWeight
            (originalTestChoiceRemainderFamily H (j a) e)
            (originalTestChoiceRemainderWeight (R.restrictedWeight a) e) =
          weightedConflictFamilyRootShadowWeight
            (originalTestChoiceRemainderFamily H (j a) e)
            (originalTestChoiceRemainderWeight (R.restrictedWeight a) e) ∅ :=
              (weightedConflictFamilyRootShadowWeight_empty _ _).symm
        _ = originalTestRootShadowWeight
            (R.restrictedWeight a) H (j a) e :=
          originalTestChoice_emptyRootShadow_eq
            (R.restrictedWeight a) H (j a) e heH (hj1 a)
    have hcap' :
        testTotal
            (originalTestRootShadowWeight
              (R.restrictedWeight a) H (j a) e) M n ≤
          finiteWeightedRootShadowCap eta d (N : ℝ) d₀
            (j a - 1) 0 n k := by
      simpa [c, b, d₀, externalOriginalLocalProfile,
        finiteWeightedRootShadowWeight,
        externalTestLocalProfileFamily,
        externalTestLocalProfileWeight,
        externalTestLocalProfileFamilyRank,
        externalTestLocalProfileScale,
        hweight] using hcap
    exact hcap'.trans (externalTestLocalCap_le_two_margin E S hN hT hk
      (by omega) hd₀0 hnpos)

/-- One dynamic residual layer is bounded by its concrete root-shadow
margin.  If the requested partial rank exceeds the residual's uniform
rank, the partial family is empty; this is needed for the small `r`
layers at the top test coordinates. -/
theorem externalResidualPartialMass_le_profileMargin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (a : io) (s r : ℕ) (hr2 : 2 ≤ r) (hr5 : r ≤ 5) :
    weightedGainCollisionResidualPartialMass
        (R.restrictedWeight a) H R.regularized (j a) r
        (availableEdges H R.regularized M) M (s - 1) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (testTotal (R.restrictedWeight a) H (j a) *
          Real.rpow d ((r : ℝ) - (j a : ℝ) - epsRaw / 10))
        0 ((r - 2) - (s - 1)) := by
  let b : ExternalTestLocalProfileIndex H R.regularized io :=
    externalResidualLocalProfile H R.regularized a r hr2 hr5
  let d₀ : ℝ := testTotal (R.restrictedWeight a) H (j a) *
    Real.rpow d ((r : ℝ) - (j a : ℝ) - epsRaw / 10)
  have hd₀pos : 0 < d₀ := by
    dsimp only [d₀]
    have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
    have hWpos : 0 < testTotal (R.restrictedWeight a) H (j a) :=
      (Real.rpow_pos_of_pos hdpos ((j a : ℝ) + epsRaw / 5)).trans_le
        (R.survivingTrackable a).total_lower
    exact mul_pos hWpos (Real.rpow_pos_of_pos hdpos _)
  by_cases ht : s - 1 ≤ r - 2
  · have hzero := externalTestLocalProfile_root_le_scale
      H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
        hdegree hresidualCutoff b ∅ (by
          simp [b, externalResidualLocalProfile,
            externalTestLocalProfileActiveRank])
    have hbound := weightedProfilePartialMass_le_two_margin_of_enhancedGood
      H R.regularized D₂ D₃ D₄ GammaCore eta d N T
        j R.restrictedWeight
        (externalTestLocalProfileFamilyRank j)
        (externalTestLocalProfileActiveRank j)
        (externalTestLocalProfileSeed
          (H := H) (C := R.regularized) (io := io))
        (externalTestLocalProfileFamily H C j R)
        (externalTestLocalProfileWeight H C j R)
        (externalTestLocalProfileScale
          H C d epsRaw GammaCert ellCert j w R)
        E S hN hT (A := availableEdges H R.regularized M)
        hk hgood b (s - 1)
        (by simpa [b, externalResidualLocalProfile,
          externalTestLocalProfileFamily,
          externalTestLocalProfileFamilyRank] using
            gainCollisionResidualLayer_uniform
              H R.regularized (j a) r)
        (by
          intro U
          simpa [b, externalResidualLocalProfile,
            externalTestLocalProfileWeight] using
            gainCollisionResidualRepresentationWeight_nonneg
              (R.survivingTrackable a).isTestFunction.nonneg
                H R.regularized (j a) r U)
        (by simpa [b, externalResidualLocalProfile,
          externalTestLocalProfileFamilyRank] using ht)
        (by simp [b, externalResidualLocalProfile,
          externalTestLocalProfileFamilyRank]; omega)
        (by simp [b, externalResidualLocalProfile,
          externalTestLocalProfileFamilyRank,
          externalTestLocalProfileActiveRank])
        (externalTestLocalProfileSeed_eq_empty H R.regularized b)
        hd₀pos.le
        (by simpa [b, d₀, externalResidualLocalProfile,
          externalTestLocalProfileFamily,
          externalTestLocalProfileWeight,
          externalTestLocalProfileScale] using hzero)
    change weightedPartialFamilyMass
        (gainCollisionResidualLayer H R.regularized (j a) r)
        (gainCollisionResidualRepresentationWeight
          (R.restrictedWeight a) H R.regularized (j a) r)
        (availableEdges H R.regularized M) M (s - 1) ≤
      2 * finiteWeightedRootShadowMargin eta d d₀
        0 ((r - 2) - (s - 1)) at hbound
    simpa [weightedGainCollisionResidualPartialMass, b, d₀,
      externalResidualLocalProfile, externalTestLocalProfileFamily,
      externalTestLocalProfileWeight, externalTestLocalProfileFamilyRank]
      using hbound
  · have hempty :
        partialFamily
          (gainCollisionResidualLayer H R.regularized (j a) r)
          (availableEdges H R.regularized M) M (s - 1) = ∅ := by
      rw [← Finset.card_eq_zero]
      apply Nat.eq_zero_of_not_pos
      intro hcard
      rw [Finset.card_pos] at hcard
      obtain ⟨U, hpartial⟩ := hcard
      have hU := (mem_partialFamily.mp hpartial).1
      have hcard := gainCollisionResidualLayer_uniform
        H R.regularized (j a) r U hU
      have hinter :
          (U ∩ availableEdges H R.regularized M).card ≤ U.card :=
        Finset.card_le_card Finset.inter_subset_left
      have hopen := (mem_partialFamily.mp hpartial).2.1
      omega
    rw [weightedGainCollisionResidualPartialMass,
      weightedPartialFamilyMass, hempty]
    have hmargin0 : 0 ≤ finiteWeightedRootShadowMargin eta d d₀
        0 ((r - 2) - (s - 1)) := by
      unfold finiteWeightedRootShadowMargin
      exact mul_nonneg
        (finiteWeightedRootShadowZeroScale_nonneg
          (lt_of_lt_of_le zero_lt_one hd).le hd₀pos.le 0)
        (pow_nonneg (Real.rpow_nonneg (by linarith) _) _)
    exact mul_nonneg (by norm_num) hmargin0

/-- The legal conflict-conflict reroot coordinate projected from enhanced
Good.  Its active diagonal is `r-1`, exactly matching the one-open partial
family consumed by the loss-overlap decomposition. -/
theorem externalLegalCCRerootPartialCard_le_profileMargin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (f g : Finset V) (hfH : f ∈ H) (hgH : g ∈ H)
    (hgf : g ≠ f) (hfg : Disjoint f g)
    (hpair : {f, g} ∉ conflictLayer R.regularized 2)
    (q r : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hr1 : 1 ≤ r) (hr5 : r ≤ 5) :
    ((partialFamily
        (testConflictUnionLayer
          (conflictLinkLayer R.regularized f q) R.regularized g r)
        (availableEdges H R.regularized M) M 1).card : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (768 * (3 * GammaCert + 1) *
          Real.rpow d ((r : ℝ) - epsRaw / 4)) 0 (r - 1) := by
  let b : ExternalTestLocalProfileIndex H R.regularized io :=
    externalLegalCCRerootLocalProfile H R.regularized
      ⟨f, hfH⟩ ⟨g, hgH⟩ hgf hfg hpair q r hq1 hq3 hr1 hr5
  let d₀ : ℝ := 768 * (3 * GammaCert + 1) *
    Real.rpow d ((r : ℝ) - epsRaw / 4)
  have hd₀pos : 0 < d₀ := by
    have hGamma3 : 0 ≤ 3 * GammaCert :=
      regularizedBounded_Gamma_nonneg R.bounded
        (lt_of_lt_of_le zero_lt_one hd)
    have hcoef : 0 < 3 * GammaCert + 1 := by linarith
    dsimp only [d₀]
    exact mul_pos (mul_pos (by norm_num) hcoef)
      (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)
  have hzero := externalTestLocalProfile_root_le_scale
    H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
      hdegree hresidualCutoff b ∅ (by
        simp [b, externalLegalCCRerootLocalProfile,
          externalTestLocalProfileActiveRank])
  have hbound := weightedProfilePartialMass_le_two_margin_of_enhancedGood
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (externalTestLocalProfileFamilyRank j)
      (externalTestLocalProfileActiveRank j)
      (externalTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (externalTestLocalProfileFamily H C j R)
      (externalTestLocalProfileWeight H C j R)
      (externalTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R)
      E S hN hT (A := availableEdges H R.regularized M)
      hk hgood b 1
      (by simpa [b, externalLegalCCRerootLocalProfile,
        externalTestLocalProfileFamily,
        externalTestLocalProfileFamilyRank] using
          testConflictUnionLayer_uniform
            (conflictLinkLayer R.regularized f q) R.regularized g r)
      (by intro U; norm_num [b, externalLegalCCRerootLocalProfile,
        externalTestLocalProfileWeight, unitTestWeight])
      (by
        simp only [b, externalLegalCCRerootLocalProfile,
          externalTestLocalProfileFamilyRank]
        omega)
      (by simp [b, externalLegalCCRerootLocalProfile,
        externalTestLocalProfileFamilyRank]; exact hr5)
      (by simp [b, externalLegalCCRerootLocalProfile,
        externalTestLocalProfileFamilyRank,
        externalTestLocalProfileActiveRank])
      (externalTestLocalProfileSeed_eq_empty H R.regularized b)
      hd₀pos.le
      (by simpa [b, d₀, externalLegalCCRerootLocalProfile,
        externalTestLocalProfileFamily,
        externalTestLocalProfileWeight,
        externalTestLocalProfileScale] using hzero)
  change weightedPartialFamilyMass
      (testConflictUnionLayer
        (conflictLinkLayer R.regularized f q) R.regularized g r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M 1 ≤
    2 * finiteWeightedRootShadowMargin eta d d₀ 0 (r - 1) at hbound
  have hunit : weightedPartialFamilyMass
      (testConflictUnionLayer
        (conflictLinkLayer R.regularized f q) R.regularized g r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M 1 =
        ((partialFamily
          (testConflictUnionLayer
            (conflictLinkLayer R.regularized f q) R.regularized g r)
          (availableEdges H R.regularized M) M 1).card : ℝ) := by
    simp [weightedPartialFamilyMass, unitTestWeight]
  rw [← hunit]
  simpa [b, d₀, externalLegalCCRerootLocalProfile,
    externalTestLocalProfileFamily, externalTestLocalProfileWeight,
    externalTestLocalProfileFamilyRank] using hbound

/-- One-open duplicate-family cap for the pointwise blocker-status defect. -/
theorem externalPointDuplicatePartialCard_le_profileMargin
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (f : Finset V) (hfH : f ∈ H)
    (r : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    ((partialFamily
        (duplicateConflictLinkUnionLayer R.regularized f r)
        (availableEdges H R.regularized M) M 1).card : ℝ) ≤
      2 * finiteWeightedRootShadowMargin eta d
        (2304 * (3 * GammaCert + 1) *
          Real.rpow d ((r : ℝ) - epsRaw / 4)) 0 (r - 1) := by
  let b : ExternalTestLocalProfileIndex H R.regularized io :=
    pointDuplicateLocalProfile H R.regularized ⟨f, hfH⟩ r hr3 hr5
  let d₀ : ℝ := 2304 * (3 * GammaCert + 1) *
    Real.rpow d ((r : ℝ) - epsRaw / 4)
  have hd₀pos : 0 < d₀ := by
    have hGamma3 : 0 ≤ 3 * GammaCert :=
      regularizedBounded_Gamma_nonneg R.bounded
        (lt_of_lt_of_le zero_lt_one hd)
    have hcoef : 0 < 3 * GammaCert + 1 := by linarith
    dsimp only [d₀]
    exact mul_pos (mul_pos (by norm_num) hcoef)
      (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)
  have hzero := externalTestLocalProfile_root_le_scale
    H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
      hdegree hresidualCutoff b ∅ (by
        simp [b, pointDuplicateLocalProfile,
          externalTestLocalProfileActiveRank])
  have hbound := weightedProfilePartialMass_le_two_margin_of_enhancedGood
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (externalTestLocalProfileFamilyRank j)
      (externalTestLocalProfileActiveRank j)
      (externalTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (externalTestLocalProfileFamily H C j R)
      (externalTestLocalProfileWeight H C j R)
      (externalTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R)
      E S hN hT (A := availableEdges H R.regularized M)
      hk hgood b 1
      (by simpa [b, pointDuplicateLocalProfile,
        externalTestLocalProfileFamily,
        externalTestLocalProfileFamilyRank] using
          duplicateConflictLinkUnionLayer_uniform R.regularized f r)
      (by intro U; norm_num [b, pointDuplicateLocalProfile,
        externalTestLocalProfileWeight, unitTestWeight])
      (by
        simp only [b, pointDuplicateLocalProfile,
          externalTestLocalProfileFamilyRank]
        omega)
      (by simp [b, pointDuplicateLocalProfile,
        externalTestLocalProfileFamilyRank]; exact hr5)
      (by simp [b, pointDuplicateLocalProfile,
        externalTestLocalProfileFamilyRank,
        externalTestLocalProfileActiveRank])
      (externalTestLocalProfileSeed_eq_empty H R.regularized b)
      hd₀pos.le
      (by simpa [b, d₀, pointDuplicateLocalProfile,
        externalTestLocalProfileFamily,
        externalTestLocalProfileWeight,
        externalTestLocalProfileScale] using hzero)
  change weightedPartialFamilyMass
      (duplicateConflictLinkUnionLayer R.regularized f r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M 1 ≤
    2 * finiteWeightedRootShadowMargin eta d d₀ 0 (r - 1) at hbound
  have hunit : weightedPartialFamilyMass
      (duplicateConflictLinkUnionLayer R.regularized f r)
      (unitTestWeight (V := V))
      (availableEdges H R.regularized M) M 1 =
        ((partialFamily
          (duplicateConflictLinkUnionLayer R.regularized f r)
          (availableEdges H R.regularized M) M 1).card : ℝ) := by
    simp [weightedPartialFamilyMass, unitTestWeight]
  rw [← hunit]
  simpa [b, d₀, pointDuplicateLocalProfile,
    externalTestLocalProfileFamily, externalTestLocalProfileWeight,
    externalTestLocalProfileFamilyRank] using hbound


