theorem activeInternalConflictLink_oneState_stoppedDrift
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V)
    {D₂ D₃ D₄ Gamma epsilon d N x P scale : ℝ} {j s : ℕ}
    (R : CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hscale : 0 ≤ scale) (M : Hypergraph V)
    (hf : f ∈ availableEdges H C M)
    (hmuLower :
      scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x -
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPartialTestGain (conflictLinkTestWeight C f j) H C j s M -
        meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s M)
    (hmuUpper :
      meanPartialTestGain (conflictLinkTestWeight C f j) H C j s M -
          meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s M ≤
        scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N))) :
    greedyStepExpectation H C M
        (activeInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) ≤ 0 ∧
      greedyStepExpectation H C M
        (activeInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale x j s M) ≤ 0 := by
  have hbase := internalConflictLink_envelope_drift hC f R
    hscale M hmuLower hmuUpper
  constructor
  · rw [show activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M =
        (fun M' ↦
          (((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M') M' s).card : ℝ) -
              scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
                CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1))) -
            (((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M) M s).card : ℝ) -
              scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
                CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x))) by
          funext M'
          simp [activeInternalConflictLinkUpperStep, hf]]
    exact hbase.1
  · rw [show activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M =
        (fun M' ↦
          (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
                CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
              ((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M') M' s).card : ℝ)) -
            (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
                CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x) -
              ((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M) M s).card : ℝ))) by
          funext M'
          simp [activeInternalConflictLinkLowerStep, hf]]
    exact hbase.2


theorem activeInternalConflictLinkSteps_abs_le
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) {R Q : ℝ}
    (hR0 : 0 ≤ R) (hQ0 : 0 ≤ Q)
    (hraw :
      |((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M') M' s).card : ℝ) -
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ)| ≤ R)
    (hupperTrajectory :
      |scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x)| ≤ Q)
    (hlowerTrajectory :
      |scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x)| ≤ Q) :
    |activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M'| ≤ R + Q ∧
      |activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M'| ≤ R + Q := by
  by_cases hf : f ∈ availableEdges H C M
  · simp only [activeInternalConflictLinkUpperStep,
      activeInternalConflictLinkLowerStep, hf, if_true]
    constructor
    · calc
        |_ - _| =
            |(((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M') M' s).card : ℝ) -
              ((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M) M s).card : ℝ)) -
              (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
                  CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
                scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
                  CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x))| := by
              congr 1
              ring
        _ ≤ _ := (abs_sub _ _).trans (add_le_add hraw hupperTrajectory)
    · calc
        |_ - _| =
            |(scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
                  CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
                scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
                  CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x)) -
              (((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M') M' s).card : ℝ) -
              ((partialFamily (conflictLinkLayer C f j)
                (availableEdges H C M) M s).card : ℝ))| := by
              congr 1
              ring
        _ ≤ Q + R := (abs_sub _ _).trans
          (add_le_add hlowerTrajectory hraw)
        _ = R + Q := add_comm _ _
  · simp [activeInternalConflictLinkUpperStep,
      activeInternalConflictLinkLowerStep, hf, add_nonneg hR0 hQ0]

theorem internalConflictLinkUpperFirstFailureEvent_subset_tail
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale t : ℝ) (j s : ℕ)
    (hcomponent : ∀ k S, P i k S ↔
      internalConflictLinkUpperCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k S)
    (hinitial : internalConflictLinkUpperError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s 0 M ≤ -t) :
    greedyFirstFailureEvent H C M T P i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (fun q S S' ↦ activeInternalConflictLinkUpperStep H C f
              D₂ D₃ D₄ Gamma epsilon d N scale (q : ℝ) j s S S'))
          T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hfailCorridor : ¬ internalConflictLinkUpperCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s (k + 1)
        (greedyStateFromAt H C M omega (k + 1)) := by
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hbad := (not_internalConflictLinkUpperCorridor_iff H C f
    D₂ D₃ D₄ Gamma epsilon d N scale j s (k + 1) _).mp hfailCorridor
  have hfailure : ¬ indexedGreedyGood P (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    greedyStoppedStep_exit_imp_terminal_tail H C M T
      (indexedGreedyGood P)
      (fun q S S' ↦ activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (q : ℝ) j s S S')
      (internalConflictLinkUpperError H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s)
      omega hk hgood hfailure (by
        intro q hq
        exact activeInternalConflictLinkUpperStep_eq_timeStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s q _ _
          (mem_availableEdges_greedyStateFromAt_of_le H C M omega
            (Nat.le_succ_of_le hq) hbad.1))
      hinitial hbad.2⟩

theorem internalConflictLinkLowerFirstFailureEvent_subset_tail
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι) (f : Finset V)
