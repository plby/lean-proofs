/-- Source-level external mean window with every local collision cap and
numeric absorption reconstructed from the combined Good predicate. -/
theorem restrictedExternal_meanWindow_of_combinedGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ) (Pfloor : ℝ)
    (hNcard : (vertexFinset H).card = N)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (a : io) (s : Fin (j a + 1))
    (M : Hypergraph V) (hM : IsConflictFreeMatching H R.regularized M)
    (hcard : M.card = k)
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M)
    (Rstep : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) Pfloor (j a) s.1) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
              (j a) s.1 (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄
              (6 * (2 * (ell : ℝ) + 1))
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (j a) s.1 (k : ℝ) +
            2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) -
              CFMNumeric.coreEpsilon eta) / (N : ℝ))) ≤
        meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ∧
      meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
              (j a) s.1 (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄
              (6 * (2 * (ell : ℝ) + 1))
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              (j a) s.1 (k : ℝ) -
            2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) -
              CFMNumeric.coreEpsilon eta) / (N : ℝ))) := by
  rcases hinst with
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w :=
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  have hcaps := externalSharpCaps_of_combinedGood H C d eta ell j w
    hinst' R E S D₂ D₃ D₄ N T k hN hT hk M hM hgood
  have hcert := combinedGood_certificateWithCore H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  exact restrictedExternal_meanWindow_of_literalSharpCaps
    H C d eta (2 * (ell : ℝ) + 1)
      (6 * (2 * (ell : ℝ) + 1)) ell j w R D₂ D₃ D₄ N k Pfloor
      E S hH8 hcodegree a s (htrack a).2.1 M hM hNcard hcard hcert Rstep
      hcaps.1 hcaps.2.1 hcaps.2.2.1 (hcaps.2.2.2 a s)

end

