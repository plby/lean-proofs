      57600 * Gamma ≤ 12288000000000 * Gamma ^ 2 := hcoef
      _ ≤ d ^ (eta - 2 * eta ^ 3 -
          63 * CFMNumeric.coreEpsilon eta / 64) := S.deltaSecondOrder
