  have hA : (availableEdges H R.regularized M).Nonempty := by
    have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
      H R.regularized D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d N
        j R.restrictedWeight
        (indexedDegreeEnhancedGood_old H R.regularized D₂ D₃ D₄ Gamma eta d
          (vertexFinset H).card
          (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
