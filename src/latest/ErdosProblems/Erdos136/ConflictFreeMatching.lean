theorem degreeMeanRateCoefficient_absorption
    {eta Gamma d N : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hGamma54 : 54 ≤ Gamma) (hN : 0 < N) :
    77008 * Gamma * d /
        (N * CFMNumeric.trajectoryFloor eta d) ≤
      Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) / N := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hG0 : 0 ≤ Gamma := by linarith
  have hexpLower : 38504 ≤ Real.exp (6 * Gamma) := by
    have hx : 0 ≤ 6 * Gamma := by positivity
    have hp := Real.pow_div_factorial_le_exp (6 * Gamma) hx 2
    norm_num at hp
    nlinarith [sq_nonneg (Gamma - 54)]
  have hcoef : 2464256 * Gamma ≤
      Real.rpow d (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) := by
    calc
      2464256 * Gamma ≤ 64 * Gamma * Real.exp (6 * Gamma) := by
        nlinarith
      _ = (4 * Gamma) * 16 *
          (Real.exp (3 * Gamma) * Real.exp (3 * Gamma)) := by
        rw [← Real.exp_add]
        ring_nf
      _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 64) *
          Real.rpow d (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) *
          (Real.rpow d (CFMNumeric.coreEpsilon eta / 64) *
            Real.rpow d (CFMNumeric.coreEpsilon eta / 64)) := by
        have hab : (4 * Gamma) * 16 ≤
            Real.rpow d (CFMNumeric.coreEpsilon eta / 64) *
              Real.rpow d (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) :=
          mul_le_mul S.correctionDenominator S.terminalXiFromCore
            (by norm_num) (Real.rpow_nonneg hd.le _)
        have hxx : Real.exp (3 * Gamma) * Real.exp (3 * Gamma) ≤
            Real.rpow d (CFMNumeric.coreEpsilon eta / 64) *
              Real.rpow d (CFMNumeric.coreEpsilon eta / 64) :=
          mul_le_mul S.deltaHazardExponential S.deltaHazardExponential
            (Real.exp_nonneg _) (Real.rpow_nonneg hd.le _)
        exact mul_le_mul hab hxx
          (mul_nonneg (Real.exp_nonneg _) (Real.exp_nonneg _))
          (mul_nonneg (Real.rpow_nonneg hd.le _)
            (Real.rpow_nonneg hd.le _))
      _ = Real.rpow d (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) := by
        simp only [Real.rpow_eq_pow]
        let a := CFMNumeric.coreEpsilon eta / 64
        let b := CFMNumeric.coreEpsilon eta / 64 - eta ^ 3
        have habPow : d ^ a * d ^ b = d ^ (a + b) :=
          (Real.rpow_add hd a b).symm
        have haaPow : d ^ a * d ^ a = d ^ (a + a) :=
          (Real.rpow_add hd a a).symm
        calc
          d ^ a * d ^ b * (d ^ a * d ^ a) =
              d ^ (a + b) * (d ^ a * d ^ a) :=
            congrArg (fun z : ℝ ↦ z * (d ^ a * d ^ a)) habPow
          _ = d ^ (a + b) * d ^ (a + a) :=
            congrArg (fun z : ℝ ↦ d ^ (a + b) * z) haaPow
          _ = d ^ ((a + b) + (a + a)) := by
            exact (Real.rpow_add hd (a + b) (a + a)).symm
          _ = d ^ (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) := by
            congr 1
            dsimp only [a, b]
            ring
  have hfloor : CFMNumeric.trajectoryFloor eta d =
      Real.rpow d (-eta ^ 3) / 32 := rfl
  have hfloorPos : 0 < CFMNumeric.trajectoryFloor eta d := by
    rw [hfloor]
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have hden : 0 < N * CFMNumeric.trajectoryFloor eta d :=
    mul_pos hN hfloorPos
  rw [div_le_div_iff₀ hden hN]
  have hcoefD := mul_le_mul_of_nonneg_right hcoef hd.le
  have hpowProduct :
      Real.rpow d (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) * d =
        Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) *
          Real.rpow d (-eta ^ 3) := by
    simp only [Real.rpow_eq_pow]
    calc
      d ^ (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) * d =
          d ^ (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) *
            d ^ (1 : ℝ) := by rw [Real.rpow_one]
      _ =
          d ^
            ((CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) + 1) := by
        exact (Real.rpow_add hd _ _).symm
      _ = d ^
          ((1 + CFMNumeric.coreEpsilon eta / 16) + (-eta ^ 3)) := by
        congr 1
        ring
      _ = d ^ (1 + CFMNumeric.coreEpsilon eta / 16) *
          d ^ (-eta ^ 3) := Real.rpow_add hd _ _
  have hbase : 77008 * Gamma * d ≤
      Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) *
        CFMNumeric.trajectoryFloor eta d := by
    rw [hfloor]
    calc
      77008 * Gamma * d = (2464256 * Gamma * d) / 32 := by ring
      _ ≤ (Real.rpow d (CFMNumeric.coreEpsilon eta / 16 - eta ^ 3) * d) /
          32 := div_le_div_of_nonneg_right hcoefD (by norm_num)
      _ = (Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) *
          Real.rpow d (-eta ^ 3)) / 32 := by rw [hpowProduct]
      _ = Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) *
          (Real.rpow d (-eta ^ 3) / 32) := by ring
  calc
    77008 * Gamma * d * N ≤
        (Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) *
          CFMNumeric.trajectoryFloor eta d) * N :=
      mul_le_mul_of_nonneg_right hbase hN.le
    _ = Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) *
        (N * CFMNumeric.trajectoryFloor eta d) := by ring
theorem survivingVertexProbability_quarter_of_degreeEnhancedGood
    {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} {ell k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (hH8 : IsUniform H 8)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ : ℝ) {M : Hypergraph V}
    (hk : k < CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
          (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
          j R.restrictedWeight) k M)
    (Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hNlower : d ^ eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (v : ActualHostVertex H) (hv : v.1 ∈ uncoveredVertices H M) :
