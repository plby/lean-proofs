def internalResidualProfileCode
    {H : Hypergraph V} (b : InternalResidualProfile H) :
    HostEdgeCode H × (Fin 4 × Fin 6) :=
  (b.edge, (b.linkRank, b.unionRank))

theorem internalResidualProfileCode_injective (H : Hypergraph V) :
