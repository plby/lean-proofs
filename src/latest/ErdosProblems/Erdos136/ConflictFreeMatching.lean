    unfold CFMTrajectories.pV
    field_simp [ne_of_gt hNpos]
    <;> ring
  have hhand := availableEdges_card_bounds_of_degreeWithin hH8 hdegree
  have haLo : u * (D - delta) / 8 ≤ (A.card : ℝ) := by
    rw [← huncard]
