/-- The zero-available coordinate cannot be lost by selecting another host
edge.  This is the top-boundary replacement for the nonexistent rank-`j`
original-test remainder profile. -/
theorem partialTestStepLoss_zero_of_coordinate_zero
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j : ℕ) (e : Finset V) :
    partialTestStepLoss w H C j 0 M e = 0 := by
  unfold partialTestStepLoss partialTestLossBetween
  apply Finset.sum_eq_zero
  intro S hS
  split
  next hbad =>
    exfalso
    apply hbad.2
    have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
    have hSM : S ⊆ M := by
      have hinter : S ∩ M = S := by
        apply Finset.eq_of_subset_of_card_le Finset.inter_subset_left
        simpa only [hbad.1.2, hScard, Nat.sub_zero] using
          (le_rfl : j ≤ j)
      exact Finset.inter_eq_left.mp hinter
    have hSinsert : S ⊆ insert e M := hSM.trans (Finset.subset_insert e M)
    have hdisj : Disjoint S (availableEdges H C (insert e M)) :=
      (availableEdges_disjoint_selected H C (insert e M)).symm.mono
        hSinsert (Finset.Subset.rfl)
    constructor
    · rw [Finset.disjoint_iff_inter_eq_empty.mp hdisj]
      rfl
    · rw [Finset.inter_eq_left.mpr hSinsert, hScard, Nat.sub_zero]
  next => rfl

/-- Every pointwise external-test gain and loss is bounded at the natural
half-jump scale, and the same state supplies the blocker-status upper bound
needed for the averaged square.  All local caps are projections of the
single final Good predicate. -/
theorem restrictedExternal_pointwiseCaps_of_finalReachableGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (a : io) (s : Fin (j a + 1)) (M : Hypergraph V)
    (Rstep : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) (CFMNumeric.trajectoryFloor eta d) (j a) s.1)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M) :
    let W := testTotal (R.restrictedWeight a) H (j a)
    let d₀ := (ell : ℝ) * W *
      Real.rpow d (-1 - CFMNumeric.coreEpsilon eta)
    let gainCap := 2 * finiteWeightedRootShadowMargin eta d d₀
      0 (j a - (s.1 + 1))
    let lossRootCap := if s.1 = 0 then 0 else
      2 * finiteWeightedRootShadowMargin eta d d₀ 0 (j a - s.1)
    let statusHi := certificateTestStatusHi D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
        d (N : ℝ) k
    let rawCap := max gainCap (statusHi * lossRootCap)
    0 ≤ lossRootCap ∧ 0 ≤ rawCap ∧
      (∀ e ∈ availableEdges H R.regularized M,
        partialTestStepGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M e ≤ rawCap ∧
        partialTestStepLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M e ≤ rawCap) ∧
      (∀ e ∈ availableEdges H R.regularized M,
        ((availableBlockerChoices H R.regularized M e).card : ℝ) ≤
          statusHi) ∧
      rawCap ≤ testSourceJumpScale
        (W * Real.rpow d ((s.1 : ℝ) - (j a : ℝ))) d
          (CFMNumeric.coreEpsilon eta) / 2 := by
  dsimp only
  rcases hinst with
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w :=
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let W := testTotal (R.restrictedWeight a) H (j a)
  let d₀ := (ell : ℝ) * W *
    Real.rpow d (-1 - CFMNumeric.coreEpsilon eta)
  let gainCap := 2 * finiteWeightedRootShadowMargin eta d d₀
    0 (j a - (s.1 + 1))
  let lossRootCap := if s.1 = 0 then 0 else
    2 * finiteWeightedRootShadowMargin eta d d₀ 0 (j a - s.1)
  let statusHi := certificateTestStatusHi D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) k
  let rawCap := max gainCap (statusHi * lossRootCap)
  have hell1 : 1 ≤ ell := by omega
  have heps : 0 ≤ CFMRegularization.rawRegularizationEps eta := by
    unfold CFMRegularization.rawRegularizationEps
    positivity
  have hdegree : ∀ x, (degree H x : ℝ) ≤ d := by
    intro x
    by_cases hx : x ∈ vertexFinset H
    · exact (hdegreeOn x hx).2
    · rw [degree_eq_zero_of_not_mem_vertexFinset hx]
      exact le_trans (by norm_num) hd
  have hresidualCutoff :
      72 * (3 * (2 * (ell : ℝ) + 1) + 1) * (ell : ℝ) ≤
        Real.rpow d (CFMRegularization.rawRegularizationEps eta / 10) :=
    CFMSharpTestCutoff.residualSpreadCoefficient_le_rawTenth ell E S
  have hcombined := finalReachableGood_combined H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hext := finalReachableGood_external H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hM := finalReachableGood_matching H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hcaps := externalSharpCaps_of_combinedGood H C d eta ell j w
    hinst' R E S D₂ D₃ D₄ N T k hN hT hk M hM hcombined
  have hcert := finalReachableGood_certificateWithCore H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hstatus : ∀ e ∈ availableEdges H R.regularized M,
      ((availableBlockerChoices H R.regularized M e).card : ℝ) ≤
        statusHi := by
    intro e he
    have hb := availableBlockerChoices_bounds_of_certificateGoodWithCore
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
      D₂ D₃ D₄ (6 * (2 * (ell : ℝ) + 1))
        (CFMNumeric.coreEpsilon eta) (N : ℝ)
        (d ^ (1 - eta)) (1536 * localSpreadPrimaryMargin eta d)
        hH8 hcodegree hcert he (hcaps.1 e he)
    simpa only [statusHi] using hb.2
  have hW0 : 0 ≤ W := by
    dsimp only [W]
    exact testTotal_nonneg
      (R.survivingTrackable a).isTestFunction.nonneg H (j a)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hd₀0 : 0 ≤ d₀ := by
    dsimp only [d₀]
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg ell) hW0)
      (Real.rpow_nonneg (le_trans (by norm_num) hd) _)
  have hgainRoot : ∀ e ∈ availableEdges H R.regularized M,
      testTotal
          (originalTestRootShadowWeight
            (R.restrictedWeight a) H (j a) e)
          M (j a - (s.1 + 1)) ≤ gainCap := by
    intro e he
    have hn : j a - (s.1 + 1) ≤ j a - 1 := by omega
    simpa only [gainCap, d₀, W, CFMNumeric.coreEpsilon] using
      externalOriginalRootShadow_le_two_margin
        H C d (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1)) eta N T j w R
          E S hd heps hell1 (fun x ↦ (htrack x).1)
          (fun x ↦ (htrack x).2.1) hN hT hk hext a e
          (availableEdges_subset H R.regularized M he)
          (j a - (s.1 + 1)) hn
  have hmargin0 : ∀ n : ℕ,
      0 ≤ finiteWeightedRootShadowMargin eta d d₀ 0 n := by
    intro n
    unfold finiteWeightedRootShadowMargin
    exact mul_nonneg
      (finiteWeightedRootShadowZeroScale_nonneg hdpos.le hd₀0 0)
      (pow_nonneg (Real.rpow_nonneg hdpos.le _) n)
  have hloss0 : 0 ≤ lossRootCap := by
    dsimp only [lossRootCap]
    split
    · norm_num
    · exact mul_nonneg (by norm_num) (hmargin0 _)
  have hgainCap0 : 0 ≤ gainCap := by
    dsimp only [gainCap]
    exact mul_nonneg (by norm_num) (hmargin0 _)
  have hraw0 : 0 ≤ rawCap :=
    hgainCap0.trans (by
      dsimp only [rawCap]
      exact le_max_left _ _)
  have hpoint : ∀ e ∈ availableEdges H R.regularized M,
      partialTestStepGain (R.restrictedWeight a) H R.regularized
          (j a) s.1 M e ≤ rawCap ∧
      partialTestStepLoss (R.restrictedWeight a) H R.regularized
          (j a) s.1 M e ≤ rawCap := by
    intro e he
    have hgain := (partialTestStepGain_le_originalTestRootShadow
      (R.restrictedWeight a) H R.regularized M (j a) s.1 he
        (R.survivingTrackable a).isTestFunction.nonneg).trans
          (hgainRoot e he)
    have hgainRaw : gainCap ≤ rawCap := by
      dsimp only [rawCap]
      exact le_max_left _ _
    constructor
    · exact hgain.trans hgainRaw
    · by_cases hs0 : s.1 = 0
      · rw [hs0, partialTestStepLoss_zero_of_coordinate_zero]
        exact hraw0
      · have hs1 : 1 ≤ s.1 := Nat.one_le_iff_ne_zero.mpr hs0
        have hlossRoots : ∀ f ∈ availableEdges H R.regularized M,
            testTotal
                (originalTestRootShadowWeight
                  (R.restrictedWeight a) H (j a) f)
                M (j a - s.1) ≤ lossRootCap := by
          intro f hf
          have hn : j a - s.1 ≤ j a - 1 := by omega
          have hb := externalOriginalRootShadow_le_two_margin
            H C d (CFMRegularization.rawRegularizationEps eta)
              (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
              (6 * (2 * (ell : ℝ) + 1)) eta N T j w R
              E S hd heps hell1 (fun x ↦ (htrack x).1)
              (fun x ↦ (htrack x).2.1) hN hT hk hext a f
              (availableEdges_subset H R.regularized M hf)
              (j a - s.1) hn
          simpa only [lossRootCap, if_neg hs0, d₀, W,
            CFMNumeric.coreEpsilon] using hb
        have hp := partialTestStepGain_loss_le_originalTestRootCaps_of_blockers
          (R.restrictedWeight a) H R.regularized M (j a) s.1 he
          (R.survivingTrackable a).isTestFunction.nonneg hloss0
          (hgainRoot e he) hlossRoots (hstatus e he)
        exact hp.2.trans (by
          dsimp only [rawCap]
          exact le_max_right _ _)
  have hrawNatural : rawCap ≤ testSourceJumpScale
      (W * Real.rpow d ((s.1 : ℝ) - (j a : ℝ))) d
        (CFMNumeric.coreEpsilon eta) / 2 := by
    apply CFMSharpTestExternalRootNumeric.originalTestRawCap_le_naturalHalf
      E S Rstep hW0 hloss0
    · change gainCap ≤ 2 * finiteWeightedRootShadowMargin eta d d₀
        0 (j a - (s.1 + 1))
      exact le_rfl
    · by_cases hs0 : s.1 = 0
      · change lossRootCap ≤
          2 * finiteWeightedRootShadowMargin eta d d₀ 0 (j a - s.1)
        rw [show lossRootCap = 0 by simp [lossRootCap, hs0]]
        exact mul_nonneg (by norm_num) (hmargin0 _)
      · change lossRootCap ≤
          2 * finiteWeightedRootShadowMargin eta d d₀ 0 (j a - s.1)
        rw [show lossRootCap = 2 * finiteWeightedRootShadowMargin eta d d₀
          0 (j a - s.1) by simp [lossRootCap, hs0]]
  exact ⟨hloss0, hraw0, hpoint, hstatus, hrawNatural⟩

/-- The sharp averaged square reconstructed from the same final Good state.
The available-edge denominator is supplied by the reachable handshake, so
the conclusion is already at the source `1/N` variance scale. -/
theorem restrictedExternal_meanSq_le_sourceVariance_of_finalReachableGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ)
    (hNcard : (vertexFinset H).card = N)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k < T)
    (a : io) (s : Fin (j a + 1)) (M : Hypergraph V)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M)
    (Rstep : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) (CFMNumeric.trajectoryFloor eta d) (j a) s.1) :
    meanSqPartialTestIncrement (R.restrictedWeight a) H R.regularized
        (j a) s.1 M ≤
      testSourceVarianceScale
        (testTotal (R.restrictedWeight a) H (j a) *
          Real.rpow d ((s.1 : ℝ) - (j a : ℝ))) d
        (CFMNumeric.coreEpsilon eta) (N : ℝ) := by
  rcases hinst with
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w :=
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let W := testTotal (R.restrictedWeight a) H (j a)
  let d₀ := (ell : ℝ) * W *
    Real.rpow d (-1 - CFMNumeric.coreEpsilon eta)
  let gainCap := 2 * finiteWeightedRootShadowMargin eta d d₀
    0 (j a - (s.1 + 1))
  let lossRootCap := if s.1 = 0 then 0 else
    2 * finiteWeightedRootShadowMargin eta d d₀ 0 (j a - s.1)
  let statusHi := certificateTestStatusHi D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) k
  let rawCap := max gainCap (statusHi * lossRootCap)
  have hp := restrictedExternal_pointwiseCaps_of_finalReachableGood
    H C d eta ell j w hinst' R E S D₂ D₃ D₄ N T k
      hN hT (Nat.le_of_lt hk) a s M Rstep hgood
  change 0 ≤ lossRootCap ∧ 0 ≤ rawCap ∧
      (∀ e ∈ availableEdges H R.regularized M,
        partialTestStepGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M e ≤ rawCap ∧
        partialTestStepLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M e ≤ rawCap) ∧
      (∀ e ∈ availableEdges H R.regularized M,
        ((availableBlockerChoices H R.regularized M e).card : ℝ) ≤
          statusHi) ∧
      rawCap ≤ testSourceJumpScale
        (W * Real.rpow d ((s.1 : ℝ) - (j a : ℝ))) d
          (CFMNumeric.coreEpsilon eta) / 2 at hp
  have hM := finalReachableGood_matching H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hcard := finalReachableGood_card H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hcert := finalReachableGood_certificateWithCore H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eta N T j w R hgood
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hcovered : 8 * k ≤ N := by
    have hb := Rstep.delta.degree.before_end (k : ℝ) hx
    exact_mod_cast hb.le
  have hhand := availableEdges_card_bounds_of_reachableDegreeWithin
    H R.regularized hH8 M hM N k hNcard hcard hcovered
      Rstep.delta.degree.N_pos D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta) d
      (availableDegreeWithin_of_indexedRegularizedGreedyGood
        H R.regularized D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d (N : ℝ) j R.restrictedWeight hcert)
  have hxi := (Rstep.delta.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hpV := CFMTrajectories.pV_pos Rstep.delta.degree.N_pos
    (Rstep.delta.degree.before_end (k : ℝ) hx)
  have hh := CFMTrajectories.hHat_pos
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hdpos
      Rstep.delta.degree.N_pos hpV
  have hleft : 0 < CFMTrajectories.hHat D₂ D₃ D₄ d (N : ℝ) (k : ℝ) *
      (1 - CFMTrajectories.xi (6 * (2 * (ell : ℝ) + 1))
        (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)) := by
    apply mul_pos hh
    linarith
  have hAcard : 0 < ((availableEdges H R.regularized M).card : ℝ) :=
    hleft.trans_le hhand.1
  have hA : (availableEdges H R.regularized M).Nonempty :=
    Finset.card_pos.mp (by exact_mod_cast hAcard)
  have hstatusHi0 : 0 ≤ statusHi := by
    obtain ⟨e, he⟩ := hA
    exact (Nat.cast_nonneg _).trans (hp.2.2.2.1 e he)
  have hcurrent :=
    restrictedExternalObservable_bounds_of_certificateGoodWithCore
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
        D₂ D₃ D₄ (6 * (2 * (ell : ℝ) + 1))
        (CFMNumeric.coreEpsilon eta) (N : ℝ) hcert a s
  have hplus :=
    restrictedExternalNextObservable_bounds_of_certificateGoodWithCore
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
        D₂ D₃ D₄ (6 * (2 * (ell : ℝ) + 1))
        (CFMNumeric.coreEpsilon eta) (N : ℝ) hcert a s
  have hmeanSq :=
    meanSqPartialTestIncrement_le_of_pointwise_status_observableCaps
      (R.restrictedWeight a) H R.regularized M (j a) s.1 rawCap statusHi
      (W * (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
          (j a) (s.1 + 1) (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d (N : ℝ) (j a) (s.1 + 1) (k : ℝ)))
      (W * (CFMTrajectories.zHat D₂ D₃ D₄ d (N : ℝ)
          (j a) s.1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d (N : ℝ) (j a) s.1 (k : ℝ)))
      (R.survivingTrackable a).isTestFunction.nonneg hp.2.1 hstatusHi0 hA
      hp.2.2.2.1 hplus.2 hcurrent.2
      (fun e he ↦ (hp.2.2.1 e he).1)
      (fun e he ↦ (hp.2.2.1 e he).2)
  have hW0 : 0 ≤ W := by
    dsimp only [W]
    exact testTotal_nonneg
      (R.survivingTrackable a).isTestFunction.nonneg H (j a)
  have hvariance :=
    CFMSharpTestExternalVarianceNumeric.originalTestRawVariance_le_source
      E S Rstep hW0 hp.2.1 hhand.1 hp.2.2.2.2
  change rawCap * _ ≤ testSourceVarianceScale
    (W * Real.rpow d ((s.1 : ℝ) - (j a : ℝ))) d
      (CFMNumeric.coreEpsilon eta) (N : ℝ) at hvariance
  exact hmeanSq.trans hvariance

/-- Closed reachable source budgets for one restricted external-test
coordinate.  Registry, mean transport, pointwise caps, and averaged square
all come from the certificate, cutoff, and the single final Good family. -/
theorem restrictedExternal_reachableSourceBudgets_of_finalGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (hHne : H.Nonempty)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (a : io) (s : Fin (j a + 1)) :
    let N := (vertexFinset H).card
    let T := CFMNumericAggregation.targetTime eta d N
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let GammaCore : ℝ := 6 * (2 * (ell : ℝ) + 1)
    let epsCore := CFMNumeric.coreEpsilon eta
    let W := testTotal (R.restrictedWeight a) H (j a)
    let P := externalTestNaturalScale (R.restrictedWeight a) H d (j a) s.1
    ReachableExternalTestSourceBudgets
      (R.restrictedWeight a) H R.regularized
      (indexedGreedyGood
        (finalReachableTestEnhancedPredicate H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta
          N T j w R)) T
      D₂ D₃ D₄ GammaCore epsCore d (N : ℝ)
      (CFMNumeric.trajectoryFloor eta d) W (j a) s.1
      (fun _ ↦ testSourceJumpScale P d epsCore)
      (fun _ ↦ CFMNumericAggregation.testFreedmanVarianceScale
        P d epsCore (N : ℝ)) := by
  dsimp only
  let N := (vertexFinset H).card
  let T := CFMNumericAggregation.targetTime eta d N
  let D₂ := certificateD₂ H C d
    (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
  let D₃ := certificateD₃ H C d
    (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
  let D₄ := certificateD₄ H C d
    (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
  let GammaCore : ℝ := 6 * (2 * (ell : ℝ) + 1)
  let epsCore := CFMNumeric.coreEpsilon eta
  let W := testTotal (R.restrictedWeight a) H (j a)
  let P := externalTestNaturalScale (R.restrictedWeight a) H d (j a) s.1
  have hN : Real.rpow d eta / 2 ≤ (N : ℝ) := by
    dsimp only [N]
    exact specializedHost_card_ge_half_rpow H C d eta GammaCore ell j w
      hinst hHne S
  have hT : (T : ℝ) ≤ (N : ℝ) := by
    dsimp only [T]
    exact CFMNumericAggregation.targetTime_cast_le_host E.eta_pos S hN
  rcases hinst with
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w :=
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  have hW0 : 0 ≤ W := by
    dsimp only [W]
    exact testTotal_nonneg
      (R.survivingTrackable a).isTestFunction.nonneg H (j a)
  have hP0 : 0 ≤ P := externalTestNaturalScale_nonneg
    (R.restrictedWeight a) H d (j a) s.1
      (R.survivingTrackable a).isTestFunction.nonneg
      (le_trans (by norm_num) hd)
  have hsa : s.1 ≤ j a := by omega
  have hja3 : j a ≤ 3 := (htrack a).2.1
  have hja4 : j a ≤ 4 := hja3.trans (by omega)
  let rawJump : ℕ → ℝ := fun _ ↦ testSourceJumpScale P d epsCore / 2
  let rawVariance : ℕ → ℝ := fun _ ↦
    testSourceVarianceScale P d epsCore (N : ℝ)
  apply reachableExternalTestSourceBudgets_of_sharpRaw
    (R.restrictedWeight a) H R.regularized
    (indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta
        N T j w R)) T
    D₂ D₃ D₄ GammaCore epsCore d (N : ℝ)
      (CFMNumeric.trajectoryFloor eta d) W (j a) s.1
      (fun _ ↦ testSourceJumpScale P d epsCore)
      (fun _ ↦ CFMNumericAggregation.testFreedmanVarianceScale
        P d epsCore (N : ℝ)) rawJump rawVariance
  · exact (R.survivingTrackable a).isTestFunction.nonneg
  · exact (htrack a).2.1
  · exact hW0
  · intro k hk M hgood
    exact certificateLiteralTestStepRegistry H C d eta ell j w hinst' R
      N E S hN k hk (j a) s.1 hsa hja4
  · intro k hk M hgood hM hcard
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    have hcombined := finalReachableGood_combined H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta
      N T j w R hgood
    exact (restrictedExternal_meanWindow_of_combinedGood
      H C d eta ell j w hinst' R E S D₂ D₃ D₄ N T k
      (CFMNumeric.trajectoryFloor eta d) rfl hN hT (Nat.le_of_lt hk)
      a s M hM hcard hcombined Rstep).1
  · intro k hk M hgood hM hcard
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    have hcombined := finalReachableGood_combined H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta
      N T j w R hgood
    exact (restrictedExternal_meanWindow_of_combinedGood
      H C d eta ell j w hinst' R E S D₂ D₃ D₄ N T k
      (CFMNumeric.trajectoryFloor eta d) rfl hN hT (Nat.le_of_lt hk)
      a s M hM hcard hcombined Rstep).2
  · intro k
    dsimp only [rawJump, testSourceJumpScale]
    exact div_nonneg
      (mul_nonneg hP0
        (Real.rpow_nonneg (zero_le_one.trans hd) _)) (by norm_num)
  · intro k hk M hgood e he
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    have hp := restrictedExternal_pointwiseCaps_of_finalReachableGood
      H C d eta ell j w hinst' R E S D₂ D₃ D₄ N T k hN hT
        (Nat.le_of_lt hk) a s M Rstep hgood
    dsimp only at hp
    exact (hp.2.2.1 e he).1.trans (by
      simpa only [rawJump, P, W, externalTestNaturalScale] using hp.2.2.2.2)
  · intro k hk M hgood e he
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    have hp := restrictedExternal_pointwiseCaps_of_finalReachableGood
      H C d eta ell j w hinst' R E S D₂ D₃ D₄ N T k hN hT
        (Nat.le_of_lt hk) a s M Rstep hgood
    dsimp only at hp
    exact (hp.2.2.1 e he).2.trans (by
      simpa only [rawJump, P, W, externalTestNaturalScale] using hp.2.2.2.2)
  · intro k hk M hgood hM hcard
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    simpa only [rawVariance, P, W, externalTestNaturalScale] using
      restrictedExternal_meanSq_le_sourceVariance_of_finalReachableGood
        H C d eta ell j w hinst' R E S D₂ D₃ D₄ N T k rfl hN hT hk
          a s M hgood Rstep
  · intro k hk
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    exact CFMSharpTestNatural.raw_add_externalTestTrajectoryJump_le_natural
      E S hN Rstep hW0 (by rfl)
  · intro k hk
    have Rstep := certificateLiteralTestStepRegistry
      H C d eta ell j w hinst' R N E S hN k hk
        (j a) s.1 hsa hja4
    apply CFMSharpTestNatural.externalTestSharpVariance_le_freedman_of_source
    · rfl
    · simpa only [P, W, externalTestNaturalScale, epsCore] using
        CFMSharpTestNatural.externalTestTrajectoryJump_sq_le_sourceVariance
          E S hN Rstep hW0

/-- Closed positive paired package for the same external coordinate.  Its
initial gaps and scale positivity are deterministic consequences of
trackability, so no scalar or source premise remains. -/
theorem restrictedExternal_positivePairedSourceBudgets_of_finalGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (hHne : H.Nonempty)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (a : io) (s : Fin (j a + 1)) :
    let N := (vertexFinset H).card
    let T := CFMNumericAggregation.targetTime eta d N
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R
    let GammaCore : ℝ := 6 * (2 * (ell : ℝ) + 1)
    let epsCore := CFMNumeric.coreEpsilon eta
    let W := testTotal (R.restrictedWeight a) H (j a)
    let P := externalTestNaturalScale (R.restrictedWeight a) H d (j a) s.1
    CFMNumericAggregation.PositivePairedFirstFailureSourceBudgets P
      (ReachableExternalTestSourceBudgets
        (R.restrictedWeight a) H R.regularized
        (indexedGreedyGood
          (finalReachableTestEnhancedPredicate H C d
            (CFMRegularization.rawRegularizationEps eta)
            (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄ GammaCore eta
            N T j w R)) T
        D₂ D₃ D₄ GammaCore epsCore d (N : ℝ)
        (CFMNumeric.trajectoryFloor eta d) W (j a) s.1
        (fun _ ↦ testSourceJumpScale P d epsCore)
        (fun _ ↦ CFMNumericAggregation.testFreedmanVarianceScale
          P d epsCore (N : ℝ)))
      (externalTestUpperError (R.restrictedWeight a) H R.regularized
        D₂ D₃ D₄ GammaCore epsCore d (N : ℝ) W (j a) s.1 0 ∅)
      (externalTestLowerError (R.restrictedWeight a) H R.regularized
        D₂ D₃ D₄ GammaCore epsCore d (N : ℝ) W (j a) s.1 0 ∅)
      (CFMNumericAggregation.testDeviation GammaCore P d epsCore) := by
  dsimp only
  rcases hinst with
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w :=
    ⟨hH8, hCsys, hell4, hCfour, heta0, heta1, hd,
      hNupper, hdegreeOn, hcodegree, hbounded, hio, htrack⟩
  apply positivePairedFirstFailureSourceBudgets_of_reachableExternalNaturalScale
    (R.restrictedWeight a) H R.regularized
    (indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell
        (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R)
        (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R)
        (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R)
        (6 * (2 * (ell : ℝ) + 1)) eta (vertexFinset H).card
        (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
        j w R))
    (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
    (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R)
    (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta) d
    ((vertexFinset H).card : ℝ) (CFMNumeric.trajectoryFloor eta d)
    (j a) s.1 ell
    (fun _ ↦ testSourceJumpScale
      (externalTestNaturalScale (R.restrictedWeight a) H d (j a) s.1)
      d (CFMNumeric.coreEpsilon eta))
    (fun _ ↦ CFMNumericAggregation.testFreedmanVarianceScale
      (externalTestNaturalScale (R.restrictedWeight a) H d (j a) s.1)
      d (CFMNumeric.coreEpsilon eta) ((vertexFinset H).card : ℝ))
    (R.survivingTrackable a) (htrack a).1 (htrack a).2.1 (by omega)
    (fun c hc ↦ (R.bounded.conflict_card hc).1)
    (lt_of_lt_of_le zero_lt_one hd)
    (by positivity)
  exact restrictedExternal_reachableSourceBudgets_of_finalGood
    H C d eta ell j w hinst' hHne R E S a s

end

