  have hNpV : 0 < N * pv := mul_pos R.delta.degree.N_pos hp
  have hNpVxi : 0 < N * pv * xi := mul_pos hNpV hxiPos
  have hfactor : 308160 * Gamma / (N * pv * xi) ≤ 10000 := by
