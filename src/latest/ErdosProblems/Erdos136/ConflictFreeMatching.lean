  have hcovered : 8 * k ≤ (vertexFinset H).card := hcoveredStrict.le
  have huncard : ((uncoveredVertices H M).card : ℝ) = u := by
    rw [card_uncoveredVertices_of_uniform_matching hH8 hreach.1.1,
