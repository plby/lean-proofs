        w H C f₀ j r root ≤
      weightedGainCollisionResidualRootMass w H C j r root := by
  rw [weightedF0TruncatedGainCollisionResidualRootMass_eq_representationSum,
    weightedGainCollisionResidualRootMass_eq_representationSum]
  apply Finset.sum_le_sum
  intro S hS
  apply Finset.sum_le_sum
  intro e heS
  apply Finset.sum_le_sum
  intro f hfS
  apply Finset.sum_le_sum
  intro c hcC
  by_cases hrep : gainCollisionResidualUnion S c e f ⊆ H ∧
      e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      root ⊆ gainCollisionResidualUnion S c e f ∧
      IsF0TruncatedGainCollisionResidual H C f₀
        (gainCollisionResidualConflict c e f)
  · rw [if_pos hrep, if_pos]
    exact ⟨hrep.1, hrep.2.1, hrep.2.2.1, hrep.2.2.2.1,
      hrep.2.2.2.2.1⟩
  · rw [if_neg hrep]
    split
