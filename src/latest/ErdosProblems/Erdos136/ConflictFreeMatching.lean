    have htwoUpper0 : 0 ≤ 2 * ((6 / 5 : ℝ) * h) := by positivity
    have haTwo : 2 * a ≤ 2 * ((6 / 5 : ℝ) * h) :=
      mul_le_mul_of_nonneg_left haUpper (by norm_num)
    have hhs0 : 0 ≤ h * scale := mul_nonneg hh.le hscale0
    calc
      2 * a * rem ≤ 2 * ((6 / 5 : ℝ) * h) * scale :=
        mul_le_mul haTwo hremScale hrem0 htwoUpper0
      _ = (12 / 5 : ℝ) * (h * scale) := by ring
      _ ≤ 1000 * (h * scale) :=
        mul_le_mul_of_nonneg_right (by norm_num) hhs0
      _ = 1000 * h * scale := by ring
  have henvelopeRaw := CFMTrajectories.zetaRate_lower_of_registry R
  have henvelope : 40000 * scale ≤
      CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s x := by
    have h76000 : 76000 * scale ≤
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s x := by
      dsimp only [scale]
      convert henvelopeRaw using 1 <;> ring
    exact (mul_le_mul_of_nonneg_right
      (by norm_num : (40000 : ℝ) ≤ 76000) hscale0).trans h76000
  have hwindows := CFMSharpTestNumeric.meanWindow_numeric_of_source_errors
    hW hh ha0 hscale0 hZ0 hEnv0 heHi0 heLo0 haLower hrate hmismatch
      hnext hcurrent hstatusHi hstatusLo hgain hloss hrem henvelope
  dsimp only [Z, Zp, Env, Envp, b, eHi, eLo, gain, loss, K, rem, scale,
    delta, internal, h, eps, x] at hwindows
  unfold certificateTestStatusHi certificateTestStatusLo
  convert hwindows using 1 <;> ring_nf

end CFMSharpTestCutoff

theorem availableEdges_card_bounds_of_reachableDegreeWithin
    [Fintype V]
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (M : Hypergraph V) (hM : IsConflictFreeMatching H C M)
    (N₀ k : ℕ) (hN : (vertexFinset H).card = N₀)
    (hcard : M.card = k) (hcovered : 8 * k ≤ N₀)
    (hNpos : 0 < (N₀ : ℝ))
    (D₂ D₃ D₄ Gamma epsilon d : ℝ)
    (hdegree : AvailableDegreeWithin H C M
      (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
          d (N₀ : ℝ) (k : ℝ))
      (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
          d (N₀ : ℝ) (k : ℝ))) :
    CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
          (1 - CFMTrajectories.xi Gamma epsilon d (N₀ : ℝ) (k : ℝ)) ≤
        ((availableEdges H C M).card : ℝ) ∧
      ((availableEdges H C M).card : ℝ) ≤
        CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
          (1 + CFMTrajectories.xi Gamma epsilon d (N₀ : ℝ) (k : ℝ)) := by
  have hraw := availableEdges_card_bounds_of_degreeWithin hH hdegree
  have huncardNat : (uncoveredVertices H M).card = N₀ - 8 * k := by
    rw [card_uncoveredVertices_of_uniform_matching hH hM.1, hN, hcard]
  have huncard : ((uncoveredVertices H M).card : ℝ) =
      (N₀ : ℝ) - 8 * (k : ℝ) := by
    rw [huncardNat, Nat.cast_sub hcovered]
    norm_num
  have hpVidentity : (N₀ : ℝ) *
      CFMTrajectories.pV (N₀ : ℝ) (k : ℝ) =
        (N₀ : ℝ) - 8 * (k : ℝ) := by
    unfold CFMTrajectories.pV
    field_simp
  have hloIdentity :
      ((uncoveredVertices H M).card : ℝ) *
          (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) -
            CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
              d (N₀ : ℝ) (k : ℝ)) =
        8 * (CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
          (1 - CFMTrajectories.xi Gamma epsilon d (N₀ : ℝ) (k : ℝ))) := by
    rw [huncard, ← hpVidentity]
    unfold CFMTrajectories.delta CFMTrajectories.dHat
      CFMTrajectories.hHat CFMTrajectories.q
    ring
  have hhiIdentity :
      ((uncoveredVertices H M).card : ℝ) *
          (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) +
            CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
              d (N₀ : ℝ) (k : ℝ)) =
        8 * (CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
          (1 + CFMTrajectories.xi Gamma epsilon d (N₀ : ℝ) (k : ℝ))) := by
    rw [huncard, ← hpVidentity]
    unfold CFMTrajectories.delta CFMTrajectories.dHat
      CFMTrajectories.hHat CFMTrajectories.q
    ring
  constructor
  · rw [hloIdentity] at hraw
    nlinarith [hraw.1]
  · rw [hhiIdentity] at hraw
    nlinarith [hraw.2]

theorem restrictedExternalObservable_bounds_of_certificateGoodWithCore
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M)
    (a : io) (s : Fin (j a + 1)) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore d N
              (j a) s.1 (k : ℝ)) ≤
        partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) s.1 M ∧
      partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) s.1 M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore d N
              (j a) s.1 (k : ℝ)) := by
  apply partialTestObservable_bounds_of_externalCorridors
  exact indexedRegularizedGreedyGood_external
    H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
      j R.restrictedWeight hgood a s

theorem restrictedExternalNextObservable_bounds_of_certificateGoodWithCore
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M)
    (a : io) (s : Fin (j a + 1)) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) (s.1 + 1) (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore d N
              (j a) (s.1 + 1) (k : ℝ)) ≤
        partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) (s.1 + 1) M ∧
      partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) (s.1 + 1) M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) (s.1 + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore d N
              (j a) (s.1 + 1) (k : ℝ)) := by
  by_cases hs : s.1 < j a
  · let s' : Fin (j a + 1) := ⟨s.1 + 1, by omega⟩
    exact restrictedExternalObservable_bounds_of_certificateGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N hgood a s'
  · have hjs : j a < s.1 + 1 := by omega
    rw [partialTestObservable_eq_zero_of_rank_lt_coordinate
      (R.restrictedWeight a) H R.regularized M (j a) (s.1 + 1) hjs,
      zHat_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ d N (k : ℝ)
        (j a) (s.1 + 1) hjs,
      zeta_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ GammaCore epsilonCore
        d N (k : ℝ) (j a) (s.1 + 1) hjs]
    norm_num

theorem internalConflictLinkObservable_bounds_of_certificateGoodWithCore
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
