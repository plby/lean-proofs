    (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M hf
    (indexedRegularizedGreedyGood_internal H R.regularized
      D₂ D₃ D₄ GammaCore epsilonCore d N j R.restrictedWeight
