    (Gamma := Gamma) (epsilon := epsilon) (j := 1) (s := 1)
    hd hG hp hm (by omega)).le
  have hz21 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := epsilon) (j := 2) (s := 1)
    hd hG hp hm (by omega)).le
  have hz31 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := epsilon) (j := 3) (s := 1)
    hd hG hp hm (by omega)).le
  have hinternal0 : 0 ≤ degreeInternalCorridorError D₂ D₃ D₄ Gamma
      epsilon d N k := by
    unfold degreeInternalCorridorError
    exact add_nonneg
      (add_nonneg (mul_nonneg R.degree.D₂_nonneg hz11)
        (mul_nonneg R.degree.D₃_nonneg hz21))
      (mul_nonneg R.degree.D₄_nonneg hz31)
  unfold certificateTestStatusHi
  positivity

private theorem killedLossCoefficient_le_delta
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P)
    (hs3 : s ≤ 3) :
    ((s * (64 * Nat.ceil (d ^ (1 - eta)) +
        16 * certificateMixedLossCapNat eta
          (CFMRegularization.rawRegularizationEps eta) d +
        Nat.ceil (30 * localSpreadPrimaryMargin eta d)) : ℕ) : ℝ) ≤
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
  let B := d ^ (1 - CFMNumeric.coreEpsilon eta / 3)
  have hd : 1 ≤ d := R.degree.d_one
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hsR : (s : ℝ) ≤ 3 := by exact_mod_cast hs3
  have hcode := CFMSharpTestCutoff.codegreeCeil_le_two_base E S
  have hmixed := CFMSharpTestCutoff.mixedCeil_le_three_base E S
  have hcc := CFMSharpTestCutoff.ccCeil_le_three_base E S
  have hcoef :
      ((s * (64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d +
          Nat.ceil (30 * localSpreadPrimaryMargin eta d)) : ℕ) : ℝ) ≤
        537 * B := by
    push_cast
    dsimp only [B] at hcode hmixed hcc ⊢
    have hB0 : 0 ≤ d ^
        (1 - CFMNumeric.coreEpsilon eta / 3) :=
      Real.rpow_nonneg hdpos.le _
    calc
      (s : ℝ) *
          (64 * (Nat.ceil (d ^ (1 - eta)) : ℝ) +
            16 * (certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d : ℝ) +
            (Nat.ceil (30 * localSpreadPrimaryMargin eta d) : ℝ)) ≤
        3 * (64 * (2 * d ^
              (1 - CFMNumeric.coreEpsilon eta / 3)) +
          16 * (3 * d ^
              (1 - CFMNumeric.coreEpsilon eta / 3)) +
          3 * d ^
              (1 - CFMNumeric.coreEpsilon eta / 3)) := by
            gcongr
      _ = 537 * d ^
          (1 - CFMNumeric.coreEpsilon eta / 3) := by ring
  have hconst : (537 : ℝ) ≤
      d ^ (4 * CFMNumeric.coreEpsilon eta / 64) := by
    calc
      (537 : ℝ) ≤ 5 ^ (4 : ℕ) := by norm_num
      _ ≤ d ^
          ((4 : ℝ) * CFMNumeric.coreEpsilon eta / 64) :=
        S.envelopeFifth_pow 4
      _ = _ := by norm_num
  have heps0 : 0 ≤ CFMNumeric.coreEpsilon eta := by
    rw [CFMSharpTestCutoff.coreEpsilon_eq]
    linarith [E.eta_pos]
  have habsorb : 537 * B ≤
      d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := by
    calc
      537 * B ≤ d ^
          (4 * CFMNumeric.coreEpsilon eta / 64) * B :=
        mul_le_mul_of_nonneg_right hconst (Real.rpow_nonneg hdpos.le _)
      _ = d ^ (4 * CFMNumeric.coreEpsilon eta / 64 +
          (1 - CFMNumeric.coreEpsilon eta / 3)) := by
        dsimp only [B]
        exact (Real.rpow_add hdpos _ _).symm
      _ ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le hd
        linarith
  exact hcoef.trans (habsorb.trans
    (CFMTrajectories.delta_bounds_of_registry R (by simp)).1)

private theorem thirtyTwoGamma_le_N_mul_pV_mul_xi
    {D₂ D₃ D₄ Gamma eta d N : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d)) :
    32 * Gamma ≤ N * CFMTrajectories.pV N (k : ℝ) *
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
        d N (k : ℝ) := by
  let eps := CFMNumeric.coreEpsilon eta
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.degree.d_one
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have heta3 : 0 ≤ eta ^ 3 := pow_nonneg E.eta_pos.le 3
  have heps : 0 ≤ eps := by
    dsimp only [eps]
    exact CFMNumericAggregation.coreEpsilon_nonneg E
  have hcoef : 2048 * Gamma ≤ 12288000000000 * Gamma ^ 2 := by
    have hGG : Gamma ≤ Gamma ^ 2 := by
      nlinarith [mul_nonneg hG0 (sub_nonneg.mpr E.Gamma_one)]
    nlinarith
  have hexp : eta - 2 * eta ^ 3 - 63 * eps / 64 ≤
      eta - eta ^ 3 - eps / 32 := by
    nlinarith
  have hlarge : 2048 * Gamma ≤
      d ^ (eta - eta ^ 3 - eps / 32) := by
    calc
      2048 * Gamma ≤ 12288000000000 * Gamma ^ 2 := hcoef
      _ ≤ d ^
          (eta - 2 * eta ^ 3 - 63 * eps / 64) := by
        simpa only [eps] using S.deltaSecondOrder
      _ ≤ d ^ (eta - eta ^ 3 - eps / 32) :=
        Real.rpow_le_rpow_of_exponent_le R.degree.d_one hexp
  have hhost := CFMNumericAggregation.host_mul_floor_lower hd hN
  have hpFloor := R.degree.pV_floor (k : ℝ) hx
  have hNP : d ^ (eta - eta ^ 3) / 64 ≤
      N * CFMTrajectories.pV N (k : ℝ) :=
    hhost.trans (mul_le_mul_of_nonneg_left hpFloor R.degree.N_pos.le)
  have hxi := R.xi_lower (k : ℝ) hx
  have hprod := mul_le_mul hNP hxi
    (Real.rpow_nonneg hd.le _) (mul_nonneg R.degree.N_pos.le
      (CFMTrajectories.pV_pos R.degree.N_pos
        (R.degree.before_end (k : ℝ) hx)).le)
  have hfloor : d ^ (eta - eta ^ 3 - eps / 32) / 64 ≤
      N * CFMTrajectories.pV N (k : ℝ) *
        CFMTrajectories.xi Gamma eps d N (k : ℝ) := by
    calc
      d ^ (eta - eta ^ 3 - eps / 32) / 64 =
          (d ^ (eta - eta ^ 3) / 64) * d ^ (-eps / 32) := by
        rw [show eta - eta ^ 3 - eps / 32 =
            (eta - eta ^ 3) + (-eps / 32) by ring,
          Real.rpow_add hd]
        ring
      _ ≤ _ := hprod
  calc
    32 * Gamma = (2048 * Gamma) / 64 := by ring
    _ ≤ d ^ (eta - eta ^ 3 - eps / 32) / 64 :=
      div_le_div_of_nonneg_right hlarge (by norm_num)
    _ ≤ _ := by simpa only [eps] using hfloor

private theorem statusHi_ratio_le
    {D₂ D₃ D₄ Gamma eta d N P a : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
      (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
        d N (k : ℝ)) ≤ a) :
    certificateTestStatusHi D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N k / a ≤
      180 * Gamma / (N * CFMTrajectories.pV N (k : ℝ)) := by
  let h := CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ)
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.degree.d_one
  have hp := CFMTrajectories.pV_pos R.degree.N_pos
    (R.degree.before_end (k : ℝ) hx)
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos hd R.degree.N_pos hp
  have hxi := (R.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have haLower : (4 / 5 : ℝ) * h ≤ a := by
    have hm := mul_le_mul_of_nonneg_left hxi hh.le
    dsimp only [h] at haLo ⊢
    nlinarith
  have haPos : 0 < a := (mul_pos (by norm_num) hh).trans_le haLower
  have hstatus := certificateStatusHi_le_eighteenGamma_dHat E S R
  have hid : h = N * CFMTrajectories.pV N (k : ℝ) * D / 8 := by
    dsimp only [h, D]
    unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
    ring
  apply (div_le_iff₀ haPos).2
  have hden : 0 < N * CFMTrajectories.pV N (k : ℝ) :=
    mul_pos R.degree.N_pos hp
  rw [show (180 * Gamma / (N * CFMTrajectories.pV N (k : ℝ))) * a =
      (180 * Gamma * a) / (N * CFMTrajectories.pV N (k : ℝ)) by ring]
  apply (le_div_iff₀ hden).2
  have hs := mul_le_mul_of_nonneg_right hstatus hden.le
  have h180G0 : 0 ≤ 180 * Gamma :=
    mul_nonneg (by norm_num) (le_trans zero_le_one E.Gamma_one)
  have ha := mul_le_mul_of_nonneg_left haLower
    h180G0
  dsimp only [h] at ha
  dsimp only [h, D] at hid
  rw [hid] at ha
  nlinarith

private theorem survivalCenterError_le_tenThousand_common
    {D₂ D₃ D₄ Gamma eta d N a scale : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
