abbrev VertexLocalThroughSpreadEnhancedIndex
    {iota : Type*} (H : Hypergraph V) (j : iota → ℕ) :=
  EnhancedRegularizedGreedyIndex H j
    (VertexLocalThroughSpreadLocalCoordinate H)

noncomputable def vertexLocalThroughSpreadEnhancedPredicate
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V) :
    VertexLocalThroughSpreadEnhancedIndex H j → ℕ → Hypergraph V → Prop :=
  enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d (N : ℝ) j w
    (vertexLocalThroughSpreadLocalPredicate H C eta d (N : ℝ) T)

theorem indexedVertexLocalThroughSpreadEnhancedGood_old
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
