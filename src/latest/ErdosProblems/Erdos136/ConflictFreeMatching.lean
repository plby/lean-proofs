    _ = (308160 * Gamma / (N * pv * xi)) * common := by
      dsimp only [common]
      field_simp [ne_of_gt hNpV, ne_of_gt hxiPos]
      ring
    _ ≤ 10000 * common := mul_le_mul_of_nonneg_right hfactor hcommon0
