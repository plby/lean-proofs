      Freedman.eventMass (normalizedGreedyPathMass H C)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C ∅ T Good
              (fun i S S' ↦ activeInternalConflictLinkLowerStep H C f
                D₂ D₃ D₄ Gamma epsilon d N scale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have hm := activeInternalConflictLinkStoppedMomentBounds_of_reachableSourceBudgets
    H C hC hCempty f Good T D₂ D₃ D₄ Gamma epsilon d N P scale j s
