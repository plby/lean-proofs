/-- Fully closed four-kind source package inside the enhanced Good predicate.
Availability is derived from the old paired degree corridors, the distinguished
reachable invariant, and the same numeric delta registry already used by the
old degree process. -/
theorem vertexLocalThroughSpreadEnhancedConcreteSourceBudgets
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta GammaCore GammaCert d : ℝ} {T ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    LocalSpreadUpperSourceBudgets
      (vertexLocalThroughSpreadTailBaseWeight H R.regularized a)
      H R.regularized
      (indexedGreedyGood
        (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight)) T
      (vertexLocalThroughSpreadTailRank a)
      (vertexLocalThroughSpreadConcreteCap eta d
        ((vertexFinset H).card : ℝ) T a)
      (vertexLocalThroughSpreadConcreteJump eta d
        ((vertexFinset H).card : ℝ) a) := by
  let P := vertexLocalThroughSpreadEnhancedPredicate H R.regularized
    D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
      R.restrictedWeight
  have hNpos : 0 < ((vertexFinset H).card : ℝ) := by
    have hecard : a.1.1.card = 8 := hH a.1.1 a.1.2
    have hene : a.1.1.Nonempty := Finset.card_pos.mp (by omega)
    obtain ⟨v₀, hv₀⟩ := hene
    have hvHost : v₀ ∈ vertexFinset H :=
      mem_vertexFinset.mpr ⟨a.1.1, a.1.2, hv₀⟩
    exact_mod_cast Finset.card_pos.mpr ⟨v₀, hvHost⟩
  apply vertexLocalThroughSpreadConcreteSourceBudgets_of_available
    E S H C j w R hNpos hdegreeUpper P
  · intro k M hgood
    exact indexedVertexLocalThroughSpreadEnhancedGood_local
      H R.regularized D₂ D₃ D₄ GammaCore eta d
        (vertexFinset H).card T j R.restrictedWeight hgood
  · intro k hk M hgood
    have hstep := hregistry k hk M hgood
    have hlocal := indexedVertexLocalThroughSpreadEnhancedGood_local
      H R.regularized D₂ D₃ D₄ GammaCore eta d
        (vertexFinset H).card T j R.restrictedWeight hgood
    have hreach := indexedVertexLocalThroughSpreadGood_reachable
      H R.regularized eta d ((vertexFinset H).card : ℝ) T hlocal
    have hold := indexedVertexLocalThroughSpreadEnhancedGood_old
      H R.regularized D₂ D₃ D₄ GammaCore eta d
        (vertexFinset H).card T j R.restrictedWeight hgood
    have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
      H R.regularized D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
          j R.restrictedWeight hold
    have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
    have hcovered : 8 * k ≤ (vertexFinset H).card := by
      have hb := hstep.degree.before_end (k : ℝ) hx
      exact_mod_cast hb.le
    exact localSpreadAvailableFloor_le_availableEdges_card S
      H R.regularized hH M hreach.1 (vertexFinset H).card k rfl
        hreach.2 hcovered hstep.degree.N_pos D₂ D₃ D₄ hstep hdegree


/-! Weighted shadow coordinates.  These are the arbitrary-real-weight
counterpart of `conflictFamilyShadowWeight`; keeping representation weights
is essential for the certificate's restricted public tests. -/

def weightedCodegree (X : ConflictSystem V) (a : TestWeight V)
    (root : Hypergraph V) : ℝ :=
  ∑ U ∈ X.filter (root ⊆ ·), a U

def IsWeightedRealSpread (X : ConflictSystem V) (a : TestWeight V)
    (q : ℕ) (d₀ delta : ℝ) : Prop :=
  IsUniform X q ∧ (∀ U, 0 ≤ a U) ∧
    ∀ root : Hypergraph V, root.card < q →
      weightedCodegree X a root ≤ d₀ * delta ^ root.card

def weightedConflictFamilyShadowWeight
    (X : ConflictSystem V) (a : TestWeight V) : TestWeight V :=
  fun root ↦ weightedCodegree X a root

@[simp] theorem weightedConflictFamilyShadowWeight_apply
    (X : ConflictSystem V) (a : TestWeight V) (root : Hypergraph V) :
    weightedConflictFamilyShadowWeight X a root =
      weightedCodegree X a root := by
  rfl

theorem weightedConflictFamilyShadowWeight_nonneg
    {X : ConflictSystem V} {a : TestWeight V}
    (ha : ∀ U, 0 ≤ a U) (root : Hypergraph V) :
    0 ≤ weightedConflictFamilyShadowWeight X a root := by
  unfold weightedConflictFamilyShadowWeight weightedCodegree
  exact Finset.sum_nonneg fun U _ ↦ ha U

theorem IsWeightedRealSpread.weightedShadow_le
    {X : ConflictSystem V} {a : TestWeight V}
    {q : ℕ} {d₀ delta : ℝ}
    (hX : IsWeightedRealSpread X a q d₀ delta)
    (root : Hypergraph V) (hroot : root.card < q) :
    weightedConflictFamilyShadowWeight X a root ≤
      d₀ * delta ^ root.card := by
  exact hX.2.2 root hroot

/-- Representation-weighted mass of an `s`-open partial family. -/
def weightedPartialFamilyMass
    (X : ConflictSystem V) (a : TestWeight V)
    (A M : Hypergraph V) (s : ℕ) : ℝ :=
  ∑ U ∈ partialFamily X A M s, a U

theorem weightedPartialFamilyMass_nonneg
    {X : ConflictSystem V} {a : TestWeight V}
    (ha : ∀ U, 0 ≤ a U) (A M : Hypergraph V) (s : ℕ) :
    0 ≤ weightedPartialFamilyMass X a A M s := by
  unfold weightedPartialFamilyMass
  exact Finset.sum_nonneg fun U _ ↦ ha U

/-- Every weighted `s`-open member is counted by its selected
`(q-s)`-root in the monotone chosen-set shadow. -/
theorem weightedPartialFamilyMass_le_shadowTotal
    (X : ConflictSystem V) (a : TestWeight V)
    (A M : Hypergraph V) (q s : ℕ)
    (hX : IsUniform X q) (ha : ∀ U, 0 ≤ a U) :
    weightedPartialFamilyMass X a A M s ≤
      testTotal (weightedConflictFamilyShadowWeight X a) M (q - s) := by
  let P := M.powersetCard (q - s)
  let F : Hypergraph V → ConflictSystem V := fun root ↦
    X.filter fun U ↦ root ⊆ U
  have hYX : partialFamily X A M s ⊆ X := by
    intro U hU
    exact (mem_partialFamily.mp hU).1
  have hpoint : ∀ U ∈ partialFamily X A M s,
      a U ≤ ∑ root ∈ P, if root ⊆ U then a U else 0 := by
    intro U hU
    let root := U ∩ M
    have hrootP : root ∈ P := by
      apply Finset.mem_powersetCard.mpr
      refine ⟨Finset.inter_subset_right, ?_⟩
      have hUcard : U.card = q := hX U (mem_partialFamily.mp hU).1
      dsimp only [root]
      calc
        (U ∩ M).card = U.card - s := (mem_partialFamily.mp hU).2.2
        _ = q - s := by rw [hUcard]
    have hrootU : root ⊆ U := Finset.inter_subset_left
    calc
      a U = if root ⊆ U then a U else 0 := by simp [hrootU]
      _ ≤ ∑ root ∈ P, if root ⊆ U then a U else 0 := by
        apply Finset.single_le_sum (s := P) (f := fun root ↦
          if root ⊆ U then a U else 0)
        · intro root hrootP'
          split
          · exact ha U
          · norm_num
        · exact hrootP
  calc
    weightedPartialFamilyMass X a A M s ≤
        ∑ U ∈ partialFamily X A M s,
          ∑ root ∈ P, if root ⊆ U then a U else 0 := by
      unfold weightedPartialFamilyMass
      exact Finset.sum_le_sum hpoint
    _ ≤ ∑ U ∈ X,
          ∑ root ∈ P, if root ⊆ U then a U else 0 := by
      apply Finset.sum_le_sum_of_subset_of_nonneg hYX
      intro U hUX hnot
      apply Finset.sum_nonneg
      intro root hrootP
      split
      · exact ha U
      · norm_num
    _ = ∑ root ∈ P, ∑ U ∈ X,
          if root ⊆ U then a U else 0 := by
      rw [Finset.sum_comm]
    _ = testTotal (weightedConflictFamilyShadowWeight X a) M (q - s) := by
      unfold testTotal weightedConflictFamilyShadowWeight weightedCodegree
      apply Finset.sum_congr rfl
      intro root hrootP
      rw [← Finset.sum_filter]


theorem weightedCodegree_nonneg
    {X : ConflictSystem V} {a : TestWeight V} (ha : ∀ U, 0 ≤ a U)
    (root : Hypergraph V) : 0 ≤ weightedCodegree X a root := by
  unfold weightedCodegree
  exact Finset.sum_nonneg fun U _ ↦ ha U

/-! A root-indexed formulation of iterated chosen-set derivatives.  It is
the convenient finite hierarchy for weighted interaction families of rank
at most five: the primary coordinate has empty root, and a jump in the
choice `x` is controlled by the coordinate whose root has acquired `x`. -/

def weightedConflictFamilyRootShadowWeight
    (X : ConflictSystem V) (a : TestWeight V)
    (root : Hypergraph V) : TestWeight V :=
  fun S ↦ if Disjoint root S then weightedCodegree X a (root ∪ S) else 0

theorem weightedConflictFamilyRootShadowWeight_nonneg
    {X : ConflictSystem V} {a : TestWeight V} (ha : ∀ U, 0 ≤ a U)
    (root S : Hypergraph V) :
    0 ≤ weightedConflictFamilyRootShadowWeight X a root S := by
  unfold weightedConflictFamilyRootShadowWeight
  split
  · unfold weightedCodegree
    exact Finset.sum_nonneg fun U _ ↦ ha U
  · norm_num

@[simp] theorem weightedConflictFamilyRootShadowWeight_empty
    (X : ConflictSystem V) (a : TestWeight V) :
    weightedConflictFamilyRootShadowWeight X a ∅ =
      weightedConflictFamilyShadowWeight X a := by
  funext S
  simp [weightedConflictFamilyRootShadowWeight,
    weightedConflictFamilyShadowWeight]

theorem chosenSetDerivativeWeight_rootShadow_eq_insert
    (X : ConflictSystem V) (a : TestWeight V)
    (root : Hypergraph V) (x : Finset V) (hx : x ∉ root) :
    chosenSetDerivativeWeight
        (weightedConflictFamilyRootShadowWeight X a root) x =
      weightedConflictFamilyRootShadowWeight X a (insert x root) := by
  funext S
  simp only [chosenSetDerivativeWeight,
    weightedConflictFamilyRootShadowWeight]
  by_cases hxS : x ∈ S
  · rw [if_pos hxS, if_neg]
    rw [Finset.disjoint_left]
    intro hd
    exact (hd (Finset.mem_insert_self x root)) hxS
  · rw [if_neg hxS]
    have hdisj : Disjoint root (insert x S) ↔
        Disjoint (insert x root) S := by
      rw [Finset.disjoint_left, Finset.disjoint_left]
      constructor
      · intro h y hy hS
        rcases Finset.mem_insert.mp hy with rfl | hyr
        · exact hxS hS
        · exact h hyr (Finset.mem_insert_of_mem hS)
      · intro h y hyr hy
        rcases Finset.mem_insert.mp hy with rfl | hyS
        · exact hx hyr
        · exact h (Finset.mem_insert_of_mem hyr) hyS
    by_cases hd : Disjoint root (insert x S)
    · have hd' : Disjoint (insert x root) S := hdisj.mp hd
      rw [if_pos hd, if_pos hd']
      congr 1
      ext y
      simp only [Finset.mem_union, Finset.mem_insert]
      tauto
    · have hd' : ¬ Disjoint (insert x root) S := fun h ↦ hd (hdisj.mpr h)
      rw [if_neg hd, if_neg hd']

theorem chosenSetDerivativeWeight_rootShadow_eq_zero_of_mem
    (X : ConflictSystem V) (a : TestWeight V)
    (root : Hypergraph V) (x : Finset V) (hx : x ∈ root) :
    chosenSetDerivativeWeight
        (weightedConflictFamilyRootShadowWeight X a root) x = 0 := by
  funext S
  change chosenSetDerivativeWeight
      (weightedConflictFamilyRootShadowWeight X a root) x S = 0
  unfold chosenSetDerivativeWeight weightedConflictFamilyRootShadowWeight
  by_cases hxS : x ∈ S
  · simp [hxS]
  · rw [if_neg hxS, if_neg]
    intro hd
    exact (Finset.disjoint_left.mp hd) hx (Finset.mem_insert_self x S)

/-- Weighted incidence: each `q`-set can be charged by at most its `q`
members.  This is the sharp aggregate step which retains the inverse
available-edge factor in every derivative rank. -/
theorem sum_weightedCodegree_insert_le
    (X : ConflictSystem V) (a : TestWeight V) (q : ℕ)
    (hX : IsUniform X q) (ha : ∀ U, 0 ≤ a U)
    (A root : Hypergraph V) :
    (∑ x ∈ A, weightedCodegree X a (insert x root)) ≤
      (q : ℝ) * weightedCodegree X a root := by
  unfold weightedCodegree
  simp_rw [Finset.sum_filter]
  rw [Finset.sum_comm]
  calc
    (∑ U ∈ X, ∑ x ∈ A, if insert x root ⊆ U then a U else 0) ≤
        ∑ U ∈ X, if root ⊆ U then (q : ℝ) * a U else 0 := by
      apply Finset.sum_le_sum
      intro U hUX
      by_cases hrootU : root ⊆ U
      · rw [if_pos hrootU]
        have hsum :
            (∑ x ∈ A, if insert x root ⊆ U then a U else 0) =
              ((A.filter fun x ↦ x ∈ U).card : ℝ) * a U := by
          simp only [Finset.insert_subset_iff, hrootU, and_true]
          rw [← Finset.sum_filter]
          simp [mul_comm]
        rw [hsum]
        apply mul_le_mul_of_nonneg_right _ (ha U)
        have hcard : (A.filter fun x ↦ x ∈ U).card ≤ U.card :=
          Finset.card_le_card (by
            intro x hx
            exact (Finset.mem_filter.mp hx).2)
        rw [hX U hUX] at hcard
        exact_mod_cast hcard
      · rw [if_neg hrootU]
        apply Finset.sum_nonpos
        intro x hxA
        rw [if_neg (fun hx ↦ hrootU
          (Finset.Subset.trans (Finset.subset_insert x root) hx))]
    _ = (q : ℝ) *
        (∑ U ∈ X, if root ⊆ U then a U else 0) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro U hUX
      split <;> ring

/-- Exact arbitrary-rank successor recurrence for a legal newly selected
choice.  This is the rank-generic form used by every child coordinate in the
weighted derivative hierarchy. -/
theorem localSpreadRawStep_succ_insert_eq_derivative
    (w : TestWeight V) (M : Hypergraph V) (x : Finset V)
    (hx : x ∉ M) (n : ℕ) :
    localSpreadRawStep w (n + 1) M (insert x M) =
      testTotal (chosenSetDerivativeWeight w x) M n := by
  unfold localSpreadRawStep
  rw [testTotal_succ_insert_of_notMem w M x hx n]
  rw [add_sub_cancel_left]
  unfold testTotal chosenSetDerivativeWeight
  apply Finset.sum_congr rfl
  intro S hS
  rw [if_neg]
  intro hxS
  exact hx ((Finset.mem_powersetCard.mp hS).1 hxS)

/-- One arbitrary-rank chosen-set increment is charged to the preceding
root-shadow coordinate. -/
theorem greedyStepExpectation_localSpreadRawStep_rootShadow_succ_le
    (X : ConflictSystem V) (a : TestWeight V) (q : ℕ)
    (hX : IsUniform X q) (ha : ∀ U, 0 ≤ a U)
    (H : Hypergraph V) (C : ConflictSystem V) (M root : Hypergraph V)
    (n : ℕ) (hA : (availableEdges H C M).Nonempty) :
    greedyStepExpectation H C M
        (localSpreadRawStep
          (weightedConflictFamilyRootShadowWeight X a root) (n + 1) M) ≤
      (q : ℝ) *
          testTotal (weightedConflictFamilyRootShadowWeight X a root) M n /
        ((availableEdges H C M).card : ℝ) := by
  let A := availableEdges H C M
  rw [greedyStepExpectation_eq_average H C M _ hA]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  calc
    (∑ x ∈ A,
        localSpreadRawStep
          (weightedConflictFamilyRootShadowWeight X a root) (n + 1) M
            (insert x M)) =
        ∑ x ∈ A,
          testTotal
            (chosenSetDerivativeWeight
              (weightedConflictFamilyRootShadowWeight X a root) x) M n := by
      apply Finset.sum_congr rfl
      intro x hxA
      exact localSpreadRawStep_succ_insert_eq_derivative _ M x
        (mem_availableEdges.mp (by simpa only [A] using hxA)).2.1 n
    _ = ∑ S ∈ M.powersetCard n, ∑ x ∈ A,
          chosenSetDerivativeWeight
            (weightedConflictFamilyRootShadowWeight X a root) x S := by
      unfold testTotal
      rw [Finset.sum_comm]
    _ ≤ ∑ S ∈ M.powersetCard n,
          (q : ℝ) *
            weightedConflictFamilyRootShadowWeight X a root S := by
      apply Finset.sum_le_sum
      intro S hSM
      by_cases hdisj : Disjoint root S
      · have hpoint : ∀ x ∈ A,
            chosenSetDerivativeWeight
                (weightedConflictFamilyRootShadowWeight X a root) x S ≤
              weightedCodegree X a (insert x (root ∪ S)) := by
          intro x hxA
          unfold chosenSetDerivativeWeight
          by_cases hxS : x ∈ S
          · rw [if_pos hxS]
            exact weightedCodegree_nonneg ha _
          · rw [if_neg hxS]
            unfold weightedConflictFamilyRootShadowWeight
            by_cases hxr : x ∈ root
            · rw [if_neg]
              · exact weightedCodegree_nonneg ha _
              · intro hd
                exact (Finset.disjoint_left.mp hd) hxr
                  (Finset.mem_insert_self x S)
            · rw [if_pos]
              · apply le_of_eq
                congr 1
                ext y
                simp [and_or_left, or_assoc, or_left_comm]
              · rw [Finset.disjoint_left]
                intro y hyr hyins
                rcases Finset.mem_insert.mp hyins with rfl | hyS
                · exact hxr hyr
                · exact (Finset.disjoint_left.mp hdisj) hyr hyS
        calc
          (∑ x ∈ A,
              chosenSetDerivativeWeight
                (weightedConflictFamilyRootShadowWeight X a root) x S) ≤
              ∑ x ∈ A,
                weightedCodegree X a (insert x (root ∪ S)) :=
            Finset.sum_le_sum hpoint
          _ ≤ (q : ℝ) * weightedCodegree X a (root ∪ S) :=
            sum_weightedCodegree_insert_le X a q hX ha A (root ∪ S)
          _ = (q : ℝ) *
              weightedConflictFamilyRootShadowWeight X a root S := by
            rw [weightedConflictFamilyRootShadowWeight, if_pos hdisj]
      · have hzero : ∀ x ∈ A,
            chosenSetDerivativeWeight
              (weightedConflictFamilyRootShadowWeight X a root) x S = 0 := by
          intro x hxA
          unfold chosenSetDerivativeWeight
          split
          · rfl
          · unfold weightedConflictFamilyRootShadowWeight
            rw [if_neg]
            intro hd
            apply hdisj
            exact hd.mono_right (Finset.subset_insert x S)
        rw [Finset.sum_eq_zero hzero,
          weightedConflictFamilyRootShadowWeight, if_neg hdisj]
        simp
    _ = (q : ℝ) *
          testTotal (weightedConflictFamilyRootShadowWeight X a root) M n := by
      unfold testTotal
      rw [Finset.mul_sum]

/-- Closed arbitrary-successor source constructor.  The aggregate
root-shadow corridor supplies the predictable mean; one extended-root
corridor for each legal next choice supplies the pointwise jump. -/
theorem localSpreadUpperSourceBudgets_rootShadow_succ
    (X : ConflictSystem V) (a : TestWeight V) (q : ℕ)
    (hX : IsUniform X q) (ha : ∀ U, 0 ≤ a U)
    (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T n : ℕ)
    (root : Hypergraph V)
    (cap jump availFloor aggregateCap : ℕ → ℝ)
    (hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k)
    (hjump0 : ∀ k, 0 ≤ jump k)
    (haggregate0 : ∀ k, 0 ≤ aggregateCap k)
    (hfloorPos : ∀ k, k < T → 0 < availFloor k)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      availFloor k ≤ ((availableEdges H C M).card : ℝ))
    (haggregate : ∀ k, k < T → ∀ M, Good k M →
      testTotal (weightedConflictFamilyRootShadowWeight X a root) M n ≤
        aggregateCap k)
    (hextended : ∀ k, k < T → ∀ M, Good k M →
      ∀ x ∈ availableEdges H C M,
        testTotal
          (weightedConflictFamilyRootShadowWeight X a (insert x root)) M n ≤
            jump k)
    (hmeanScalar : ∀ k, k < T →
      (q : ℝ) * aggregateCap k / availFloor k ≤
        cap (k + 1) - cap k) :
    LocalSpreadUpperSourceBudgets
      (weightedConflictFamilyRootShadowWeight X a root)
      H C Good T (n + 1) cap jump := by
  refine
    { weight_nonneg := weightedConflictFamilyRootShadowWeight_nonneg ha root
      capStep_nonneg := hcapStep
      jump_nonneg := hjump0
      mean := ?_
      rawJump := ?_ }
  · intro k hk M hgood
    have hfloor := hfloorPos k hk
    have havail := havailable k hk M hgood
    have hcardPos : 0 < ((availableEdges H C M).card : ℝ) :=
      hfloor.trans_le havail
    have hA : (availableEdges H C M).Nonempty :=
      Finset.card_pos.mp (by exact_mod_cast hcardPos)
    calc
      greedyStepExpectation H C M
          (localSpreadRawStep
            (weightedConflictFamilyRootShadowWeight X a root) (n + 1) M) ≤
          (q : ℝ) *
              testTotal
                (weightedConflictFamilyRootShadowWeight X a root) M n /
            ((availableEdges H C M).card : ℝ) :=
        greedyStepExpectation_localSpreadRawStep_rootShadow_succ_le
          X a q hX ha H C M root n hA
      _ ≤ (q : ℝ) * aggregateCap k /
            ((availableEdges H C M).card : ℝ) := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left (haggregate k hk M hgood)
            (Nat.cast_nonneg _)) hcardPos.le
      _ ≤ (q : ℝ) * aggregateCap k / availFloor k := by
        exact div_le_div_of_nonneg_left
          (mul_nonneg (Nat.cast_nonneg _) (haggregate0 k)) hfloor havail
      _ ≤ cap (k + 1) - cap k := hmeanScalar k hk
  · intro k hk M hgood o
    rcases o with _ | x
    · simp [greedyChoiceStep, localSpreadRawStep, hjump0 k]
    · by_cases hxA : (x : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert hxA]
        rw [localSpreadRawStep_succ_insert_eq_derivative _ M x.1
          (mem_availableEdges.mp hxA).2.1 n]
        by_cases hxroot : (x : Finset V) ∈ root
        · rw [chosenSetDerivativeWeight_rootShadow_eq_zero_of_mem
            X a root x.1 hxroot]
          simpa [testTotal] using hjump0 k
        · rw [chosenSetDerivativeWeight_rootShadow_eq_insert
            X a root x.1 hxroot]
          exact hextended k hk M hgood x.1 hxA
      · rw [greedyChoiceStep, greedyStep_eq_self hxA]
        simp [localSpreadRawStep, hjump0 k]

noncomputable def vertexInternalOpenLinkDefect
    (C : ConflictSystem V) (A M : Hypergraph V) (v : V) : ℝ :=
  ∑ f ∈ A.filter (v ∈ ·),
    ((internalOpenLinkMass C A M f : ℝ) -
      (openConflictCount C A M f : ℝ))

theorem vertexInternalOpenLinkDefect_nonneg
    (C : ConflictSystem V) (A M : Hypergraph V) (v : V) :
    0 ≤ vertexInternalOpenLinkDefect C A M v := by
  unfold vertexInternalOpenLinkDefect
  apply Finset.sum_nonneg
  intro f hf
  exact sub_nonneg.mpr (by
    exact_mod_cast openConflictCount_le_internalOpenLinkMass C A M f)

/-- Three internal-link windows control the conflict mean with one
vertex-aggregated multiplicity correction.  Unlike the former pointwise
`spread`, this correction is not multiplied by the available degree. -/
theorem meanConflictLostDegree_bounds_of_internalLinks_vertexDefect
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {D₂ D₃ D₄ Gamma epsilon d N x : ℝ}
    (h₁ : ∀ f ∈ availableEdges H C M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 1)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 1)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x))
    (h₂ : ∀ f ∈ availableEdges H C M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 2)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 2)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x))
    (h₃ : ∀ f ∈ availableEdges H C M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 3)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 3)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x))
    (v : V) (hA : (availableEdges H C M).Nonempty) :
    let err :=
      D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
      D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
      D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x
    (degree (availableEdges H C M) v : ℝ) *
          (CFMTrajectories.cHat D₂ D₃ D₄ d N x - err) /
        ((availableEdges H C M).card : ℝ) -
      vertexInternalOpenLinkDefect C (availableEdges H C M) M v /
        ((availableEdges H C M).card : ℝ) ≤
        meanConflictLostDegree H C M v ∧
      meanConflictLostDegree H C M v ≤
        (degree (availableEdges H C M) v : ℝ) *
          (CFMTrajectories.cHat D₂ D₃ D₄ d N x + err) /
        ((availableEdges H C M).card : ℝ) := by
  dsimp only
  let A := availableEdges H C M
  let center := CFMTrajectories.cHat D₂ D₃ D₄ d N x
  let err :=
    D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
    D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
    D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x
  have hcard : 0 < (A.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  have hwindow (f : Finset V) (hf : f ∈ A) :
      center - err ≤ (internalOpenLinkMass C A M f : ℝ) ∧
        (internalOpenLinkMass C A M f : ℝ) ≤ center + err := by
    have hcenter := CFMTrajectories.internalLinkCenters_sum_eq_cHat
      D₂ D₃ D₄ d N x
    have h1 := h₁ f hf
    have h2 := h₂ f hf
    have h3 := h₃ f hf
    simp only [internalOpenLinkMass, Nat.cast_add]
    dsimp only [center, err]
    constructor <;> linarith
  have hopen (f : Finset V) :
      (openConflictCount C A M f : ℝ) ≤
        (internalOpenLinkMass C A M f : ℝ) := by
    exact_mod_cast openConflictCount_le_internalOpenLinkMass C A M f
  have hsumLower :
      (degree A v : ℝ) * (center - err) ≤
        ∑ f ∈ A.filter (v ∈ ·),
          (internalOpenLinkMass C A M f : ℝ) := by
    calc
      (degree A v : ℝ) * (center - err) =
          ∑ _f ∈ A.filter (v ∈ ·), (center - err) := by
        simp [degree]
        ring
      _ ≤ ∑ f ∈ A.filter (v ∈ ·),
          (internalOpenLinkMass C A M f : ℝ) := by
        apply Finset.sum_le_sum
        intro f hf
        exact (hwindow f (Finset.mem_filter.mp hf).1).1
  have hsumUpper :
      ∑ f ∈ A.filter (v ∈ ·),
          (openConflictCount C A M f : ℝ) ≤
        (degree A v : ℝ) * (center + err) := by
    calc
      ∑ f ∈ A.filter (v ∈ ·),
          (openConflictCount C A M f : ℝ) ≤
          ∑ f ∈ A.filter (v ∈ ·),
            (internalOpenLinkMass C A M f : ℝ) := by
        apply Finset.sum_le_sum
        intro f hf
        exact hopen f
      _ ≤ ∑ _f ∈ A.filter (v ∈ ·), (center + err) := by
        apply Finset.sum_le_sum
        intro f hf
        exact (hwindow f (Finset.mem_filter.mp hf).1).2
      _ = (degree A v : ℝ) * (center + err) := by
        simp [degree]
        ring
  have hdefectIdentity :
      ∑ f ∈ A.filter (v ∈ ·),
          (openConflictCount C A M f : ℝ) =
        (∑ f ∈ A.filter (v ∈ ·),
          (internalOpenLinkMass C A M f : ℝ)) -
        vertexInternalOpenLinkDefect C A M v := by
    unfold vertexInternalOpenLinkDefect
    rw [Finset.sum_sub_distrib]
    ring
  rw [meanConflictLostDegree_eq_openConflictAverage hC v hA]
  change _ ∧ _
  constructor
  · rw [hdefectIdentity, sub_div]
    exact sub_le_sub_right
      (div_le_div_of_nonneg_right hsumLower hcard.le) _
  · exact div_le_div_of_nonneg_right hsumUpper hcard.le

/-- Full miss-loss window with the duplicate correction kept as one
vertex-aggregate. -/
theorem meanMissAvailableDegreeLoss_bounds_of_degree_internalLinks_vertexDefect
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hH8 : IsUniform H 8)
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hM : IsConflictFreeMatching H C M)
    {Dlo Dhi L : ℕ}
    (hdeglo : ∀ x e, e ∈ availableEdges H C M → x ∈ e →
      Dlo ≤ degree (availableEdges H C M) x)
    (hdeghi : ∀ x e, e ∈ availableEdges H C M → x ∈ e →
      degree (availableEdges H C M) x ≤ Dhi)
    (hco : MaxCodegreeLE (availableEdges H C M) 2 L)
    {D₂ D₃ D₄ Gamma epsilon d N x : ℝ}
    (h₁ : ∀ f ∈ availableEdges H C M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 1)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 1)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x))
    (h₂ : ∀ f ∈ availableEdges H C M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 2)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 2)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x))
    (h₃ : ∀ f ∈ availableEdges H C M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 3)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 3)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x))
    (v : V) (hA : (availableEdges H C M).Nonempty) :
    let err :=
      D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
      D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
      D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x
    (degree (availableEdges H C M) v : ℝ) *
          (((7 * Dlo - 28 * L : ℕ) : ℝ) +
            (CFMTrajectories.cHat D₂ D₃ D₄ d N x - err)) /
        ((availableEdges H C M).card : ℝ) -
      vertexInternalOpenLinkDefect C (availableEdges H C M) M v /
        ((availableEdges H C M).card : ℝ) ≤
        meanMissAvailableDegreeLoss H C M v ∧
      meanMissAvailableDegreeLoss H C M v ≤
        (degree (availableEdges H C M) v : ℝ) *
            (((7 * Dhi : ℕ) : ℝ) +
              (CFMTrajectories.cHat D₂ D₃ D₄ d N x + err)) /
          ((availableEdges H C M).card : ℝ) := by
  dsimp only
  have hgeom := meanMissLostDegree_bounds_eight_uniform
    (availableEdges_uniform hH8 C M) hdeglo hdeghi hco v hA
  have hconf := meanConflictLostDegree_bounds_of_internalLinks_vertexDefect
    hC h₁ h₂ h₃ v hA
  rw [meanMissAvailableDegreeLoss_eq_add hHnonempty hM v]
  constructor
  · calc
      _ =
          (degree (availableEdges H C M) v : ℝ) *
              ((7 * Dlo - 28 * L : ℕ) : ℝ) /
                ((availableEdges H C M).card : ℝ) +
            ((degree (availableEdges H C M) v : ℝ) *
                (CFMTrajectories.cHat D₂ D₃ D₄ d N x -
                  (D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
                   D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
                   D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x)) /
                ((availableEdges H C M).card : ℝ) -
              vertexInternalOpenLinkDefect C (availableEdges H C M) M v /
                ((availableEdges H C M).card : ℝ)) := by ring
      _ ≤ meanMissLostDegree (availableEdges H C M) v +
          meanConflictLostDegree H C M v := add_le_add hgeom.1 hconf.1
  · calc
      meanMissLostDegree (availableEdges H C M) v +
          meanConflictLostDegree H C M v ≤
        (degree (availableEdges H C M) v : ℝ) *
              ((7 * Dhi : ℕ) : ℝ) /
                ((availableEdges H C M).card : ℝ) +
          (degree (availableEdges H C M) v : ℝ) *
              (CFMTrajectories.cHat D₂ D₃ D₄ d N x +
                (D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
                 D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
                 D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x)) /
              ((availableEdges H C M).card : ℝ) := add_le_add hgeom.2 hconf.2
      _ = _ := by ring

noncomputable def vertexDuplicatePartialMass
    (C : ConflictSystem V) (A M : Hypergraph V) (v : V) : ℝ :=
  ∑ f ∈ A.filter (v ∈ ·),
    ∑ r ∈ Finset.Icc 3 5,
      ((partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ)

/-- The shadow weight of one static duplicate layer. -/
def duplicateLayerShadowWeight
    (C : ConflictSystem V) (f : Finset V) (r : ℕ) : TestWeight V :=
  fun S ↦ (codegree (duplicateConflictLinkUnionLayer C f r) S : ℝ)

/-- Sum the duplicate-layer shadows over the full host star of `v`.  The
live correction only sums over available roots, so this static host-star
weight is a monotone upper envelope suitable for a chosen-set tail. -/
noncomputable def vertexDuplicateLayerShadowWeight
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ) : TestWeight V :=
  fun S ↦
    ∑ f ∈ H.filter (v ∈ ·), duplicateLayerShadowWeight C f r S

/-- The three selected-set coordinates needed by the degree mean. -/
noncomputable def vertexDuplicateChosenMass
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V) : ℝ :=
  ∑ r ∈ Finset.Icc 3 5,
    testTotal (vertexDuplicateLayerShadowWeight H C v r) M (r - 1)

theorem duplicateLayerShadowWeight_nonneg
    (C : ConflictSystem V) (f : Finset V) (r : ℕ) (S : Hypergraph V) :
    0 ≤ duplicateLayerShadowWeight C f r S := by
  exact Nat.cast_nonneg _

theorem vertexDuplicateLayerShadowWeight_nonneg
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ)
    (S : Hypergraph V) :
    0 ≤ vertexDuplicateLayerShadowWeight H C v r S := by
  unfold vertexDuplicateLayerShadowWeight
  exact Finset.sum_nonneg fun _ _ ↦ duplicateLayerShadowWeight_nonneg C _ r S

/-- Zeroth aggregate bound.  Summing over the host star costs one host
degree, but it is paid only once for the whole vertex aggregate. -/
theorem vertexDuplicateLayerShadowWeight_empty_le
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (v : V) (r : ℕ) :
    vertexDuplicateLayerShadowWeight H C v r ∅ ≤
      d * (72 * Gamma * Real.rpow d ((r : ℝ) - eta)) := by
  unfold vertexDuplicateLayerShadowWeight duplicateLayerShadowWeight
  calc
    (∑ f ∈ H.filter (v ∈ ·),
        (codegree (duplicateConflictLinkUnionLayer C f r) ∅ : ℝ)) =
        ∑ f ∈ H.filter (v ∈ ·),
          ((duplicateConflictLinkUnionLayer C f r).card : ℝ) := by
      apply Finset.sum_congr rfl
      intro f hf
      rw [codegree_empty]
    _ ≤ ∑ _f ∈ H.filter (v ∈ ·),
          72 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
      apply Finset.sum_le_sum
      intro f hf
      exact card_duplicateConflictLinkUnionLayer_le_72_rpow
        hB hanti hd hd1 heta f (Finset.mem_filter.mp hf).1 r
    _ = (degree H v : ℝ) *
          (72 * Gamma * Real.rpow d ((r : ℝ) - eta)) := by
      simp [degree]
    _ ≤ d * (72 * Gamma * Real.rpow d ((r : ℝ) - eta)) := by
      apply mul_le_mul_of_nonneg_right (hdegree v)
      have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hd
      exact mul_nonneg (mul_nonneg (by norm_num) hGamma)
        (Real.rpow_nonneg hd.le _)

/-- Every positive derivative of the vertex aggregate is the sum of the
corresponding rooted duplicate degrees. -/
theorem vertexDuplicateLayerShadowWeight_root_le
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (v : V) (r : ℕ) (root : Hypergraph V)
    (hr5 : r ≤ 5) (hrootPos : 1 ≤ root.card) (hrootLt : root.card < r) :
    vertexDuplicateLayerShadowWeight H C v r root ≤
      d * (2304 * Real.rpow d
        ((r : ℝ) - (root.card : ℝ) - eta)) := by
  unfold vertexDuplicateLayerShadowWeight duplicateLayerShadowWeight
  calc
    (∑ f ∈ H.filter (v ∈ ·),
        (codegree (duplicateConflictLinkUnionLayer C f r) root : ℝ)) ≤
        ∑ _f ∈ H.filter (v ∈ ·),
          2304 * Real.rpow d
            ((r : ℝ) - (root.card : ℝ) - eta) := by
      apply Finset.sum_le_sum
      intro f hf
      exact codegree_duplicateConflictLinkUnionLayer_le_2304_rpow
        hB hanti hd hd1 heta f r root hr5 hrootPos hrootLt
    _ = (degree H v : ℝ) *
          (2304 * Real.rpow d
            ((r : ℝ) - (root.card : ℝ) - eta)) := by
      simp [degree]
    _ ≤ d * (2304 * Real.rpow d
          ((r : ℝ) - (root.card : ℝ) - eta)) := by
      exact mul_le_mul_of_nonneg_right (hdegree v)
        (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))

/-- A one-open partial family injects into the `(r-1)`-selected shadow
observable of its static family. -/
theorem partialFamily_one_card_le_shadowTestTotal
    (Z : ConflictSystem V) (r : ℕ) (hZ : IsUniform Z r)
    (A M : Hypergraph V) :
    ((partialFamily Z A M 1).card : ℝ) ≤
      testTotal (fun S ↦ (codegree Z S : ℝ)) M (r - 1) := by
  let I := M.powersetCard (r - 1)
  let F : Hypergraph V → ConflictSystem V := fun S ↦
    Z.filter fun Q ↦ S ⊆ Q
  have hsubset : partialFamily Z A M 1 ⊆ I.biUnion F := by
    intro Q hQ
    have hdata := mem_partialFamily.mp hQ
    have hQcard : Q.card = r := hZ Q hdata.1
    apply Finset.mem_biUnion.mpr
    refine ⟨Q ∩ M, ?_, ?_⟩
    · exact Finset.mem_powersetCard.mpr
        ⟨Finset.inter_subset_right, by simpa only [hQcard] using hdata.2.2⟩
    · exact Finset.mem_filter.mpr ⟨hdata.1, Finset.inter_subset_left⟩
  have hcard : (partialFamily Z A M 1).card ≤
      ∑ S ∈ I, (F S).card :=
    (Finset.card_le_card hsubset).trans Finset.card_biUnion_le
  change ((partialFamily Z A M 1).card : ℝ) ≤
    ∑ S ∈ I, ((F S).card : ℝ)
  exact_mod_cast hcard

/-- Linearity identifies the host-star shadow with the sum of the
individual root-edge shadow observables. -/
theorem testTotal_vertexDuplicateLayerShadowWeight
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (v : V) (r j : ℕ) :
    testTotal (vertexDuplicateLayerShadowWeight H C v r) M j =
      ∑ f ∈ H.filter (v ∈ ·),
        testTotal (duplicateLayerShadowWeight C f r) M j := by
  unfold testTotal vertexDuplicateLayerShadowWeight
  conv_lhs => rw [Finset.sum_comm]

/-- The exact live rank-`r` aggregate is dominated by the static host-star
chosen-set coordinate. -/
theorem vertexDuplicateLayerPartialMass_le_shadow
    {H A M : Hypergraph V} {C : ConflictSystem V} {v : V} {r : ℕ}
    (hAH : A ⊆ H) :
    (∑ f ∈ A.filter (v ∈ ·),
        ((partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ)) ≤
      testTotal (vertexDuplicateLayerShadowWeight H C v r) M (r - 1) := by
  rw [testTotal_vertexDuplicateLayerShadowWeight]
  calc
    (∑ f ∈ A.filter (v ∈ ·),
        ((partialFamily
          (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ)) ≤
        ∑ f ∈ A.filter (v ∈ ·),
          testTotal (duplicateLayerShadowWeight C f r) M (r - 1) := by
      apply Finset.sum_le_sum
      intro f hfA
      exact partialFamily_one_card_le_shadowTestTotal
        (duplicateConflictLinkUnionLayer C f r) r
        (duplicateConflictLinkUnionLayer_uniform C f r) A M
    _ ≤ ∑ f ∈ H.filter (v ∈ ·),
          testTotal (duplicateLayerShadowWeight C f r) M (r - 1) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro f hf
        have hf' := Finset.mem_filter.mp hf
        exact Finset.mem_filter.mpr ⟨hAH hf'.1, hf'.2⟩
      · intro f hfH hfA
        exact testTotal_nonneg
          (duplicateLayerShadowWeight_nonneg C f r) M (r - 1)

theorem vertexDuplicatePartialMass_le_chosenMass
    {H A M : Hypergraph V} {C : ConflictSystem V} {v : V}
    (hAH : A ⊆ H) :
    vertexDuplicatePartialMass C A M v ≤
      vertexDuplicateChosenMass H C M v := by
  unfold vertexDuplicatePartialMass vertexDuplicateChosenMass
  conv_lhs => rw [Finset.sum_comm]
  apply Finset.sum_le_sum
  intro r hr
  exact vertexDuplicateLayerPartialMass_le_shadow hAH

/-- Ranks outside `3,4,5` vanish under the conflict antichain invariant. -/
theorem duplicateConflictLinkUnionLayer_eq_empty_of_not_rank_three_five
    {C : ConflictSystem V} {f : Finset V} {r : ℕ}
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hr : r ∉ Finset.Icc 3 5) :
    duplicateConflictLinkUnionLayer C f r = ∅ := by
  ext U
  constructor
  · intro hUlayer
    exfalso
    apply hr
    have hdata := mem_duplicateConflictLinkUnionLayer.mp hUlayer
    have hrange := duplicateConflictLinkUnions_card_between_three_five
      hanti hdata.1
    exact Finset.mem_Icc.mpr (by simpa only [hdata.2] using hrange)
  · intro hUempty
    simpa using hUempty

theorem sum_duplicatePartial_zero_six_eq_three_five
    {C : ConflictSystem V} {A M : Hypergraph V} {f : Finset V}
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    (∑ r ∈ Finset.Icc 0 6,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card) =
      ∑ r ∈ Finset.Icc 3 5,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card := by
  have h0 := duplicateConflictLinkUnionLayer_eq_empty_of_not_rank_three_five
    (C := C) (f := f) (r := 0) hanti (by simp)
  have h1 := duplicateConflictLinkUnionLayer_eq_empty_of_not_rank_three_five
    (C := C) (f := f) (r := 1) hanti (by simp)
  have h2 := duplicateConflictLinkUnionLayer_eq_empty_of_not_rank_three_five
    (C := C) (f := f) (r := 2) hanti (by simp)
  have h6 := duplicateConflictLinkUnionLayer_eq_empty_of_not_rank_three_five
    (C := C) (f := f) (r := 6) hanti (by simp)
  norm_num [Finset.sum_Icc_succ_top, h0, h1, h2, h6, partialFamily]

/-- Pointwise source duplicate charging, rewritten into the genuine-rank
real aggregate consumed by the vertex sum. -/
theorem internalOpenLinkMass_sub_openConflictCount_le_duplicatePartialMass
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {f : Finset V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hAM : Disjoint A M) :
    (internalOpenLinkMass C A M f : ℝ) -
        (openConflictCount C A M f : ℝ) ≤
      256 * ∑ r ∈ Finset.Icc 3 5,
        ((partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ) := by
  have hopen : openConflictCount C A M f ≤ internalOpenLinkMass C A M f :=
    openConflictCount_le_internalOpenLinkMass C A M f
  have hdup := internalOpenLinkMass_sub_openConflictCount_le_duplicate
    (H := H) (C := C) (A := A) (M := M) (f := f) hmatching hAM
  rw [sum_duplicatePartial_zero_six_eq_three_five hanti] at hdup
  have hdupR :
      (((internalOpenLinkMass C A M f -
          openConflictCount C A M f : ℕ) : ℝ)) ≤
        256 * ∑ r ∈ Finset.Icc 3 5,
          ((partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ) := by
    exact_mod_cast hdup
  rw [Nat.cast_sub] at hdupR
  · exact hdupR
  · exact hopen

/-- The exact source-faithful correction for a degree mean. -/
theorem vertexInternalOpenLinkDefect_le_duplicatePartialMass
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {v : V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hAM : Disjoint A M) :
    vertexInternalOpenLinkDefect C A M v ≤
      256 * vertexDuplicatePartialMass C A M v := by
  unfold vertexInternalOpenLinkDefect vertexDuplicatePartialMass
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro f hf
  exact internalOpenLinkMass_sub_openConflictCount_le_duplicatePartialMass
    hmatching hanti hAM

/-- Tail-ready charging theorem: the mean correction is bounded by the
three static host-star chosen-set coordinates. -/
theorem vertexInternalOpenLinkDefect_le_duplicateChosenMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    vertexInternalOpenLinkDefect C (availableEdges H C M) M v ≤
      256 * vertexDuplicateChosenMass H C M v := by
  have hpartial := vertexInternalOpenLinkDefect_le_duplicatePartialMass
    (H := H) (C := C) (A := availableEdges H C M) (M := M) (v := v)
      hmatching hanti (availableEdges_disjoint_selected H C M)
  have hshadow := vertexDuplicatePartialMass_le_chosenMass
    (C := C) (M := M) (v := v) (availableEdges_subset H C M)
  exact hpartial.trans (mul_le_mul_of_nonneg_left hshadow (by norm_num))

def vertexDuplicateLayerFamily
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ) :
    ConflictSystem V :=
  (H.filter (v ∈ ·)).biUnion fun f ↦
    duplicateConflictLinkUnionLayer C f r

def vertexDuplicateLayerRepresentationWeight
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ) :
    TestWeight V :=
  fun U ↦
    ∑ f ∈ H.filter (v ∈ ·),
      if U ∈ duplicateConflictLinkUnionLayer C f r then 1 else 0

theorem vertexDuplicateLayerFamily_uniform
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ) :
    IsUniform (vertexDuplicateLayerFamily H C v r) r := by
  intro U hU
  obtain ⟨f, hf, hUf⟩ := Finset.mem_biUnion.mp hU
  exact duplicateConflictLinkUnionLayer_uniform C f r U hUf

theorem vertexDuplicateLayerRepresentationWeight_nonneg
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ)
    (U : Hypergraph V) :
    0 ≤ vertexDuplicateLayerRepresentationWeight H C v r U := by
  unfold vertexDuplicateLayerRepresentationWeight
  apply Finset.sum_nonneg
  intro f hf
  split <;> norm_num

/-- The weighted codegree of the union family is definitionally the sum
of the codegrees of its represented root-edge families. -/
theorem weightedCodegree_vertexDuplicateLayer_eq
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ)
    (root : Hypergraph V) :
    weightedCodegree
        (vertexDuplicateLayerFamily H C v r)
        (vertexDuplicateLayerRepresentationWeight H C v r) root =
      vertexDuplicateLayerShadowWeight H C v r root := by
  unfold weightedCodegree vertexDuplicateLayerFamily
    vertexDuplicateLayerRepresentationWeight
    vertexDuplicateLayerShadowWeight duplicateLayerShadowWeight codegree
  conv_lhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f hf
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
  norm_cast
  apply congrArg Finset.card
  ext U
  simp only [Finset.mem_filter, Finset.mem_biUnion]
  constructor
  · rintro ⟨⟨_hUunion, hrootU⟩, hUf⟩
    exact ⟨hUf, hrootU⟩
  · rintro ⟨hUf, hrootU⟩
    exact ⟨⟨⟨f, Finset.mem_filter.mp hf, hUf⟩, hrootU⟩, hUf⟩

@[simp] theorem weightedConflictFamilyShadowWeight_vertexDuplicateLayer
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (r : ℕ) :
    weightedConflictFamilyShadowWeight
        (vertexDuplicateLayerFamily H C v r)
        (vertexDuplicateLayerRepresentationWeight H C v r) =
      vertexDuplicateLayerShadowWeight H C v r := by
  funext root
  exact weightedCodegree_vertexDuplicateLayer_eq H C v r root

/-- The full-host weighted partial mass is exactly the sum of the live
partial masses for all host roots through `v`. -/
theorem weightedPartialFamilyMass_vertexDuplicateLayer_eq
    (H : Hypergraph V) (C : ConflictSystem V) (A M : Hypergraph V)
    (v : V) (r : ℕ) :
    weightedPartialFamilyMass
        (vertexDuplicateLayerFamily H C v r)
        (vertexDuplicateLayerRepresentationWeight H C v r) A M 1 =
      ∑ f ∈ H.filter (v ∈ ·),
        ((partialFamily
          (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ) := by
  unfold weightedPartialFamilyMass vertexDuplicateLayerFamily
    vertexDuplicateLayerRepresentationWeight
  conv_lhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f hf
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
  norm_cast
  apply congrArg Finset.card
  ext U
  simp only [Finset.mem_filter, mem_partialFamily, Finset.mem_biUnion]
  constructor
  · rintro ⟨⟨_hUunion, hUA, hUM⟩, hUf⟩
    exact ⟨hUf, hUA, hUM⟩
  · rintro ⟨hUf, hUA, hUM⟩
    exact ⟨⟨⟨f, Finset.mem_filter.mp hf, hUf⟩, hUA, hUM⟩, hUf⟩

/-- The exact available-star correction is bounded by the weighted
full-host partial mass. -/
theorem vertexDuplicateLayerPartialMass_le_weighted
    {H A M : Hypergraph V} {C : ConflictSystem V} {v : V} {r : ℕ}
    (hAH : A ⊆ H) :
    (∑ f ∈ A.filter (v ∈ ·),
        ((partialFamily
          (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ)) ≤
      weightedPartialFamilyMass
        (vertexDuplicateLayerFamily H C v r)
        (vertexDuplicateLayerRepresentationWeight H C v r) A M 1 := by
  rw [weightedPartialFamilyMass_vertexDuplicateLayer_eq]
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro f hf
    have hf' := Finset.mem_filter.mp hf
    exact Finset.mem_filter.mpr ⟨hAH hf'.1, hf'.2⟩
  · intro f hfH hfA
    positivity

/-- Weighted shadow tail extraction for one genuine duplicate rank. -/
theorem vertexDuplicateLayerPartialMass_le_rootShadowTotal
    {H A M : Hypergraph V} {C : ConflictSystem V} {v : V} {r : ℕ}
    (hAH : A ⊆ H) :
    (∑ f ∈ A.filter (v ∈ ·),
        ((partialFamily
          (duplicateConflictLinkUnionLayer C f r) A M 1).card : ℝ)) ≤
      testTotal
        (weightedConflictFamilyRootShadowWeight
          (vertexDuplicateLayerFamily H C v r)
          (vertexDuplicateLayerRepresentationWeight H C v r) ∅)
        M (r - 1) := by
  calc
    _ ≤ weightedPartialFamilyMass
          (vertexDuplicateLayerFamily H C v r)
          (vertexDuplicateLayerRepresentationWeight H C v r) A M 1 :=
      vertexDuplicateLayerPartialMass_le_weighted hAH
    _ ≤ testTotal
          (weightedConflictFamilyShadowWeight
            (vertexDuplicateLayerFamily H C v r)
            (vertexDuplicateLayerRepresentationWeight H C v r))
          M (r - 1) :=
      weightedPartialFamilyMass_le_shadowTotal
        (vertexDuplicateLayerFamily H C v r)
        (vertexDuplicateLayerRepresentationWeight H C v r)
        A M r 1
        (vertexDuplicateLayerFamily_uniform H C v r)
        (vertexDuplicateLayerRepresentationWeight_nonneg H C v r)
    _ = _ := by
      rw [weightedConflictFamilyRootShadowWeight_empty]

/-- Sum of the three primary weighted root-shadow coordinates. -/
noncomputable def vertexDuplicateRootShadowMass
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V) : ℝ :=
  ∑ r ∈ Finset.Icc 3 5,
    testTotal
      (weightedConflictFamilyRootShadowWeight
        (vertexDuplicateLayerFamily H C v r)
        (vertexDuplicateLayerRepresentationWeight H C v r) ∅)
      M (r - 1)

theorem vertexDuplicateRootShadowMass_eq_chosenMass
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V) :
    vertexDuplicateRootShadowMass H C M v =
      vertexDuplicateChosenMass H C M v := by
  unfold vertexDuplicateRootShadowMass vertexDuplicateChosenMass
  apply Finset.sum_congr rfl
  intro r hr
  rw [weightedConflictFamilyRootShadowWeight_empty,
    weightedConflictFamilyShadowWeight_vertexDuplicateLayer]

theorem vertexDuplicatePartialMass_le_rootShadowMass
    {H A M : Hypergraph V} {C : ConflictSystem V} {v : V}
    (hAH : A ⊆ H) :
    vertexDuplicatePartialMass C A M v ≤
      vertexDuplicateRootShadowMass H C M v := by
  rw [vertexDuplicateRootShadowMass_eq_chosenMass]
  exact vertexDuplicatePartialMass_le_chosenMass hAH

/-- Final deterministic handoff to the weighted first-failure hierarchy. -/
theorem vertexInternalOpenLinkDefect_le_duplicateRootShadowMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    vertexInternalOpenLinkDefect C (availableEdges H C M) M v ≤
      256 * vertexDuplicateRootShadowMass H C M v := by
  rw [vertexDuplicateRootShadowMass_eq_chosenMass]
  exact vertexInternalOpenLinkDefect_le_duplicateChosenMass hmatching hanti

theorem vertexInternalOpenLinkDefect_le_of_duplicatePrimaryCaps
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (cap : ℕ → ℝ)
    (hcap : ∀ r ∈ Finset.Icc 3 5,
      testTotal
          (weightedConflictFamilyRootShadowWeight
            (vertexDuplicateLayerFamily H C v r)
            (vertexDuplicateLayerRepresentationWeight H C v r) ∅)
          M (r - 1) ≤ cap r) :
    vertexInternalOpenLinkDefect C (availableEdges H C M) M v ≤
      256 * ∑ r ∈ Finset.Icc 3 5, cap r := by
  apply (vertexInternalOpenLinkDefect_le_duplicateRootShadowMass
    hmatching hanti).trans
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  unfold vertexDuplicateRootShadowMass
  exact Finset.sum_le_sum hcap

/-- Algebraic handoff used after the exact internal-link mean window: a
root-shadow cap replaces the exact defect with the correct sign. -/
theorem lower_sub_duplicateRootShadow_div_of_vertexDefect
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    {base mean : ℝ}
    (hA : (availableEdges H C M).Nonempty)
    (hbase : base -
        vertexInternalOpenLinkDefect C (availableEdges H C M) M v /
          ((availableEdges H C M).card : ℝ) ≤ mean)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    base - 256 * vertexDuplicateRootShadowMass H C M v /
        ((availableEdges H C M).card : ℝ) ≤ mean := by
  have hcard : 0 < ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  have hdefect := vertexInternalOpenLinkDefect_le_duplicateRootShadowMass
    (H := H) (C := C) (M := M) (v := v) hmatching hanti
  have hdiv := div_le_div_of_nonneg_right hdefect hcard.le
  linarith

/-- The weighted family inherits the explicit host-star spread bounds.
The primary mass and all derivative caps can therefore be discharged from
the duplicate-layer source theorem and the host degree bound. -/
theorem vertexDuplicateLayer_isWeightedRealSpread
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (v : V) (r : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    IsWeightedRealSpread
      (vertexDuplicateLayerFamily H C v r)
      (vertexDuplicateLayerRepresentationWeight H C v r) r
      (2304 * (Gamma + 1) * d * Real.rpow d ((r : ℝ) - eta)) d⁻¹ := by
  refine ⟨vertexDuplicateLayerFamily_uniform H C v r,
    vertexDuplicateLayerRepresentationWeight_nonneg H C v r, ?_⟩
  intro root hrootLt
  rw [weightedCodegree_vertexDuplicateLayer_eq]
  by_cases hrootZero : root.card = 0
  · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
    subst root
    have h := vertexDuplicateLayerShadowWeight_empty_le
      hB hanti hd hd1 heta hdegree v r
    have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hd
    have hpow : 0 ≤ Real.rpow d ((r : ℝ) - eta) :=
      Real.rpow_nonneg hd.le _
    have hcoeff : 72 * Gamma ≤ 2304 * (Gamma + 1) := by
      nlinarith
    calc
      vertexDuplicateLayerShadowWeight H C v r ∅ ≤
          d * (72 * Gamma * Real.rpow d ((r : ℝ) - eta)) := h
      _ ≤ 2304 * (Gamma + 1) * d *
          Real.rpow d ((r : ℝ) - eta) := by
        calc
          d * (72 * Gamma * Real.rpow d ((r : ℝ) - eta)) =
              (72 * Gamma) *
                (d * Real.rpow d ((r : ℝ) - eta)) := by ring
          _ ≤ (2304 * (Gamma + 1)) *
                (d * Real.rpow d ((r : ℝ) - eta)) :=
            mul_le_mul_of_nonneg_right hcoeff (mul_nonneg hd.le hpow)
          _ = 2304 * (Gamma + 1) * d *
                Real.rpow d ((r : ℝ) - eta) := by ring
      _ = (2304 * (Gamma + 1) * d *
          Real.rpow d ((r : ℝ) - eta)) * d⁻¹ ^ (∅ : Hypergraph V).card := by
        simp
  · have hrootPos : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
    have h := vertexDuplicateLayerShadowWeight_root_le
      hB hanti hd hd1 heta hdegree v r root hr5 hrootPos hrootLt
    have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hd
    have hinvPow : d⁻¹ ^ root.card =
        Real.rpow d (-(root.card : ℝ)) := by
      calc
        d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
        _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
          exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
        _ = Real.rpow d (-(root.card : ℝ)) :=
          (Real.rpow_neg hd.le _).symm
    have hrpowSplit :
        Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
          Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card := by
      rw [hinvPow]
      calc
        Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
            Real.rpow d (((r : ℝ) - eta) + (-(root.card : ℝ))) := by
          congr 1
          ring
        _ = Real.rpow d ((r : ℝ) - eta) *
            Real.rpow d (-(root.card : ℝ)) := Real.rpow_add hd _ _
    rw [hrpowSplit] at h
    have hfactor : d * 2304 ≤ 2304 * (Gamma + 1) * d := by
      nlinarith
    calc
      vertexDuplicateLayerShadowWeight H C v r root ≤
          d * (2304 *
            (Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card)) := h
      _ ≤ (2304 * (Gamma + 1) * d *
          Real.rpow d ((r : ℝ) - eta)) * d⁻¹ ^ root.card := by
        have hnonneg : 0 ≤ Real.rpow d ((r : ℝ) - eta) *
            d⁻¹ ^ root.card :=
          mul_nonneg (Real.rpow_nonneg hd.le _)
            (pow_nonneg (inv_nonneg.mpr hd.le) _)
        have hmul := mul_le_mul_of_nonneg_right hfactor hnonneg
        calc
          d * (2304 *
              (Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card)) =
              (d * 2304) *
                (Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card) := by ring
          _ ≤ (2304 * (Gamma + 1) * d) *
                (Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card) := hmul
          _ = (2304 * (Gamma + 1) * d *
              Real.rpow d ((r : ℝ) - eta)) * d⁻¹ ^ root.card := by ring

/-- Definition 6.1(i): members of a test family containing a host edge
through `v`. -/
def testInteractionAtVertex (Z : ConflictSystem V) (v : V) :
    ConflictSystem V :=
  Z.filter fun S ↦ ∃ e ∈ S, v ∈ e

/-- Definition 6.1(ii): members of a test family containing the host edge
`e`. -/
def testInteractionAtEdge (Z : ConflictSystem V) (e : Finset V) :
    ConflictSystem V :=
  Z.filter fun S ↦ e ∈ S

def testConflictUnionFamily (Z : ConflictSystem V) (C : ConflictSystem V)
    (e : Finset V) : ConflictSystem V :=
  Z.biUnion fun S ↦
    ((conflictLink C e).filter fun Q ↦ ¬Disjoint S Q).image fun Q ↦ S ∪ Q

/-- The fixed-cardinality layer of `Z_{e,2}`. -/
def testConflictUnionLayer (Z : ConflictSystem V) (C : ConflictSystem V)
    (e : Finset V) (r : ℕ) : ConflictSystem V :=
  (testConflictUnionFamily Z C e).filter fun U ↦ U.card = r

/-- A host edge immediately evicts a member of `S` when the pair is a
two-conflict.  This is the predicate used in Definition 6.1(iv). -/
def IsImmediateTestEvictor (C : ConflictSystem V) (S : Hypergraph V)
    (g : Finset V) : Prop :=
  ∃ f ∈ S, ({g, f} : Hypergraph V) ∈ conflictLayer C 2

/-- The envelope of Definition 6.1(iv), before its immediate-evictor
exclusion.  It is useful for stating the exact classification dichotomy. -/
def testDeepConflictUnionEnvelope (Z : ConflictSystem V)
    (C : ConflictSystem V) : ConflictSystem V :=
  Z.biUnion fun S ↦
    (C.filter fun c ↦ 2 ≤ (S ∩ c).card).image fun c ↦ S ∪ c

/-- Definition 6.1(iv), the source family `Z_2`. -/
def testDeepConflictUnionFamily (Z : ConflictSystem V)
    (C : ConflictSystem V) : ConflictSystem V :=
  Z.biUnion fun S ↦
    (C.filter fun c ↦
      2 ≤ (S ∩ c).card ∧
        ∀ g ∈ c \ S, ¬IsImmediateTestEvictor C S g).image fun c ↦ S ∪ c

/-- The fixed-cardinality layer of `Z_2`. -/
def testDeepConflictUnionLayer (Z : ConflictSystem V)
    (C : ConflictSystem V) (r : ℕ) : ConflictSystem V :=
  (testDeepConflictUnionFamily Z C).filter fun U ↦ U.card = r

/-- Definition 6.1(v), `C_{e,2}`.  This definition agrees with the
rank-decomposed `duplicateConflictLinkUnions` scratch development. -/
def duplicateLinkUnionFamily (C : ConflictSystem V) (e : Finset V) :
    ConflictSystem V :=
  (conflictLink C e).biUnion fun Q ↦
    ((conflictLink C e).filter fun Q' ↦
      Q' ≠ Q ∧ ¬Disjoint Q Q').image fun Q' ↦ Q ∪ Q'

@[simp] theorem mem_testInteractionAtVertex
    {Z : ConflictSystem V} {v : V} {S : Hypergraph V} :
    S ∈ testInteractionAtVertex Z v ↔ S ∈ Z ∧ ∃ e ∈ S, v ∈ e := by
  simp [testInteractionAtVertex]

@[simp] theorem mem_testInteractionAtEdge
    {Z : ConflictSystem V} {e : Finset V} {S : Hypergraph V} :
    S ∈ testInteractionAtEdge Z e ↔ S ∈ Z ∧ e ∈ S := by
  simp [testInteractionAtEdge]

@[simp] theorem mem_testConflictUnionFamily
    {Z C : ConflictSystem V} {e : Finset V} {U : Hypergraph V} :
    U ∈ testConflictUnionFamily Z C e ↔
      ∃ S ∈ Z, ∃ Q ∈ conflictLink C e,
        ¬Disjoint S Q ∧ S ∪ Q = U := by
  simp [testConflictUnionFamily, and_assoc, eq_comm]

@[simp] theorem mem_testConflictUnionLayer
    {Z C : ConflictSystem V} {e : Finset V} {r : ℕ} {U : Hypergraph V} :
    U ∈ testConflictUnionLayer Z C e r ↔
      U ∈ testConflictUnionFamily Z C e ∧ U.card = r := by
  simp [testConflictUnionLayer]

theorem testConflictUnionLayer_uniform
    (Z C : ConflictSystem V) (e : Finset V) (r : ℕ) :
    IsUniform (testConflictUnionLayer Z C e r) r := by
  intro U hU
  exact (mem_testConflictUnionLayer.mp hU).2


def testConflictUnionRepresentationWeight
    (w : TestWeight V) (Z : ConflictSystem V) (C : ConflictSystem V)
    (e : Finset V) : TestWeight V :=
  fun U ↦ ∑ S ∈ Z, ∑ Q ∈ conflictLink C e,
    if ¬Disjoint S Q ∧ S ∪ Q = U then w S else 0

theorem testConflictUnionRepresentationWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (U : Hypergraph V) :
    0 ≤ testConflictUnionRepresentationWeight w Z C e U := by
  unfold testConflictUnionRepresentationWeight
  apply Finset.sum_nonneg
  intro S hSZ
  apply Finset.sum_nonneg
  intro Q hQC
  split
  · exact hw S
  · norm_num

theorem testConflictUnionRepresentationWeight_eq_zero_of_not_mem
    {w : TestWeight V} {Z C : ConflictSystem V} {e : Finset V}
    {U : Hypergraph V} (hU : U ∉ testConflictUnionFamily Z C e) :
    testConflictUnionRepresentationWeight w Z C e U = 0 := by
  unfold testConflictUnionRepresentationWeight
  apply Finset.sum_eq_zero
  intro S hSZ
  apply Finset.sum_eq_zero
  intro Q hQC
  rw [if_neg]
  rintro ⟨hinter, hunion⟩
  exact hU (mem_testConflictUnionFamily.mpr
    ⟨S, hSZ, Q, hQC, hinter, hunion⟩)

/-- Exact natural-scale identity: total derived mass is the original test
weight times the number of intersecting conflict-link witnesses. -/
theorem sum_testConflictUnionRepresentationWeight
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V) :
    (∑ U ∈ testConflictUnionFamily Z C e,
        testConflictUnionRepresentationWeight w Z C e U) =
      ∑ S ∈ Z, w S *
        (((conflictLink C e).filter fun Q ↦ ¬Disjoint S Q).card : ℝ) := by
  unfold testConflictUnionRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hSZ
  rw [Finset.sum_comm]
  calc
    (∑ Q ∈ conflictLink C e,
        ∑ U ∈ testConflictUnionFamily Z C e,
          if ¬Disjoint S Q ∧ S ∪ Q = U then w S else 0) =
        ∑ Q ∈ conflictLink C e,
          if ¬Disjoint S Q then w S else 0 := by
      apply Finset.sum_congr rfl
      intro Q hQC
      by_cases hinter : ¬Disjoint S Q
      · have hmem : S ∪ Q ∈ testConflictUnionFamily Z C e :=
          mem_testConflictUnionFamily.mpr
            ⟨S, hSZ, Q, hQC, hinter, rfl⟩
        rw [if_pos hinter]
        rw [Finset.sum_eq_single (S ∪ Q)]
        · simp [hinter]
        · intro U hUF hUne
          simp [hinter, hUne.symm]
        · exact fun hnot ↦ (hnot hmem).elim
      · simp [hinter]
    _ = w S *
        (((conflictLink C e).filter fun Q ↦ ¬Disjoint S Q).card : ℝ) := by
      rw [← Finset.sum_filter]
      simp [mul_comm]

/-- Rooted representation mass of the rank-`r` part of `Z_{e,2}`.  This
is the weighted left side of the source counting estimate (6.1). -/
def weightedTestConflictUnionRootMass
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ Z, ∑ Q ∈ conflictLink C e,
    if ¬Disjoint S Q ∧ (S ∪ Q).card = r ∧ root ⊆ S ∪ Q
    then w S else 0

/-- Grouping representations by their union loses no weight, even when
several representations have the same union. -/
theorem weightedCodegree_testConflictUnionRepresentationWeight
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) :
    weightedCodegree (testConflictUnionLayer Z C e r)
        (testConflictUnionRepresentationWeight w Z C e) root =
      weightedTestConflictUnionRootMass w Z C e r root := by
  unfold weightedCodegree weightedTestConflictUnionRootMass
    testConflictUnionRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hSZ
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro Q hQC
  by_cases hinter : ¬Disjoint S Q
  · by_cases hrank : (S ∪ Q).card = r
    · by_cases hroot : root ⊆ S ∪ Q
      · have hmem : S ∪ Q ∈
            (testConflictUnionLayer Z C e r).filter (root ⊆ ·) := by
          apply Finset.mem_filter.mpr
          exact ⟨mem_testConflictUnionLayer.mpr
            ⟨mem_testConflictUnionFamily.mpr
              ⟨S, hSZ, Q, hQC, hinter, rfl⟩, hrank⟩, hroot⟩
        rw [if_pos ⟨hinter, hrank, hroot⟩]
        rw [Finset.sum_eq_single (S ∪ Q)]
        · simp [hinter]
        · intro U hUF hUne
          simp [hinter, hUne.symm]
        · exact fun hnot ↦ (hnot hmem).elim
      · rw [if_neg]
        · apply Finset.sum_eq_zero
          intro U hU
          rw [if_neg]
          rintro ⟨_hinter, hunion⟩
          apply hroot
          rw [hunion]
          exact (Finset.mem_filter.mp hU).2
        · exact fun h ↦ hroot h.2.2
    · rw [if_neg]
      · apply Finset.sum_eq_zero
        intro U hU
        rw [if_neg]
        rintro ⟨_hinter, hunion⟩
        apply hrank
        rw [hunion]
        exact (mem_testConflictUnionLayer.mp
          (Finset.mem_filter.mp hU).1).2
      · exact fun h ↦ hrank h.2.1
  · rw [if_neg]
    · apply Finset.sum_eq_zero
      intro U hU
      simp [hinter]
    · exact fun h ↦ hinter h.1

/-- Exact source scale for the weighted rank-`r` family.  The remaining
hypothesis is precisely the rooted pair-counting inequality of Lemma 6.3;
the grouping and arbitrary-real-weight bookkeeping are fully discharged. -/
theorem testConflictUnionLayer_isWeightedRealSpread_of_rootMass
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (r j : ℕ)
    (d eps W : ℝ) (hd : 0 < d)
    (hroot : ∀ root : Hypergraph V, root.card < r →
      weightedTestConflictUnionRootMass w Z C e r root ≤
        W * Real.rpow d
          ((r : ℝ) - (j : ℝ) - eps / 2 - (root.card : ℝ))) :
    IsWeightedRealSpread (testConflictUnionLayer Z C e r)
      (testConflictUnionRepresentationWeight w Z C e) r
      (W * Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 2)) d⁻¹ := by
  refine ⟨testConflictUnionLayer_uniform Z C e r,
    testConflictUnionRepresentationWeight_nonneg hw Z C e, ?_⟩
  intro root hrootCard
  rw [weightedCodegree_testConflictUnionRepresentationWeight]
  apply (hroot root hrootCard).trans_eq
  have hinv : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg hd.le _).symm
  rw [hinv]
  calc
    W * Real.rpow d
        ((r : ℝ) - (j : ℝ) - eps / 2 - (root.card : ℝ)) =
      W * (Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 2) *
        Real.rpow d (-(root.card : ℝ))) := by
          congr 1
          have hexp :
              (r : ℝ) - (j : ℝ) - eps / 2 - (root.card : ℝ) =
                ((r : ℝ) - (j : ℝ) - eps / 2) +
                  (-(root.card : ℝ)) := by ring
          rw [hexp]
          exact Real.rpow_add hd _ _
    _ = (W * Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 2)) *
        Real.rpow d (-(root.card : ℝ)) := by ring

/-- The state coordinate used by a local-spread tail for `Z_{e,2}`. -/
def weightedTestConflictUnionPartialMass
    (w : TestWeight V) (Z : ConflictSystem V) (C : ConflictSystem V)
    (e : Finset V) (r : ℕ) (A M : Hypergraph V) (s : ℕ) : ℝ :=
  ∑ U ∈ partialFamily (testConflictUnionLayer Z C e r) A M s,
    testConflictUnionRepresentationWeight w Z C e U

theorem weightedTestConflictUnionPartialMass_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (r : ℕ)
    (A M : Hypergraph V) (s : ℕ) :
    0 ≤ weightedTestConflictUnionPartialMass w Z C e r A M s := by
  unfold weightedTestConflictUnionPartialMass
  apply Finset.sum_nonneg
  intro U hU
  exact testConflictUnionRepresentationWeight_nonneg hw Z C e U

/-! ## Deterministic gain-collision adapter -/

/-- One conflict-only gain-collision representation lands in the correct
`(s+1)` partial coordinate of a rank layer of `Z_{e,2}`. -/
theorem gainConflictRepresentation_mem_partial
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e f : Finset V} {j s : ℕ}
    (hS : S ∈ H.powersetCard j)
    (hcoord : partialTestCondition (availableEdges H C M) M j (s + 1) S)
    (heS : e ∈ S) (hfS : f ∈ S)
    (heA : e ∈ availableEdges H C M)
    (hfA : f ∈ availableEdges H C M)
    (hef : e ≠ f) (hefDisjoint : Disjoint e f)
    (hbad : ¬ConflictFree C (insert f (insert e M))) :
    ∃ Q r,
      Q ∈ conflictLink C e ∧ f ∈ Q ∧
      S ∪ Q ∈ partialFamily
        (testConflictUnionLayer (H.powersetCard j) C e r)
        (availableEdges H C M) M (s + 1) := by
  let A := availableEdges H C M
  obtain ⟨c, hcC, hcsub⟩ := not_conflictFree_iff.mp hbad
  have hfreeE : ConflictFree C (insert e M) :=
    (mem_availableEdges.mp heA).2.2.2
  have hfreeF : ConflictFree C (insert f M) :=
    (mem_availableEdges.mp hfA).2.2.2
  have hfc : f ∈ c := by
    by_contra hfc
    apply hfreeE c hcC
    intro g hgc
    rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
    · exact False.elim (hfc (hgf ▸ hgc))
    · exact hgrest
  have hec : e ∈ c := by
    by_contra hec
    apply hfreeF c hcC
    intro g hgc
    rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
    · exact Finset.mem_insert.mpr (Or.inl hgf)
    · rcases Finset.mem_insert.mp hgrest with hge | hgM
      · exact False.elim (hec (hge ▸ hgc))
      · exact Finset.mem_insert_of_mem hgM
  let Q := c.erase e
  have hQlink : Q ∈ conflictLink C e :=
    mem_conflictLink.mpr ⟨c, hcC, hec, rfl⟩
  have hfQ : f ∈ Q := by
    exact Finset.mem_erase.mpr ⟨Ne.symm hef, hfc⟩
  have hQA : Q ∩ A = {f} := by
    ext g
    constructor
    · intro hg
      have hgQ := (Finset.mem_inter.mp hg).1
      have hgA : g ∈ availableEdges H C M := by
        exact (Finset.mem_inter.mp hg).2
      have hge : g ≠ e := (Finset.mem_erase.mp hgQ).1
      have hgc : g ∈ c := (Finset.mem_erase.mp hgQ).2
      rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
      · simpa [hgf]
      · rcases Finset.mem_insert.mp hgrest with hge' | hgM
        · exact False.elim (hge hge')
        · exact False.elim ((mem_availableEdges.mp hgA).2.1 hgM)
    · intro hg
      have hgf' : g = f := Finset.mem_singleton.mp hg
      subst g
      exact Finset.mem_inter.mpr ⟨hfQ, by simpa only [A] using hfA⟩
  have hQM : Q ∩ M = Q.erase f := by
    ext g
    constructor
    · intro hg
      have hg' := Finset.mem_inter.mp hg
      exact Finset.mem_erase.mpr
        ⟨fun hgf ↦ (mem_availableEdges.mp hfA).2.1 (hgf ▸ hg'.2), hg'.1⟩
    · intro hg
      have hg' := Finset.mem_erase.mp hg
      have hge : g ≠ e := (Finset.mem_erase.mp hg'.2).1
      have hgc : g ∈ c := (Finset.mem_erase.mp hg'.2).2
      rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hgrest
      · exact False.elim (hg'.1 hgf)
      · rcases Finset.mem_insert.mp hgrest with hge' | hgM
        · exact False.elim (hge hge')
        · exact Finset.mem_inter.mpr ⟨hg'.2, hgM⟩
  have hAM : Disjoint A M := by
    rw [Finset.disjoint_left]
    intro g hgA hgM
    exact (mem_availableEdges.mp (by simpa only [A] using hgA)).2.1 hgM
  have hSCard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hsle : s + 1 ≤ j := by
    have hle := Finset.card_le_card
      (show S ∩ A ⊆ S from Finset.inter_subset_left)
    rw [hcoord.1, hSCard] at hle
    exact hle
  have hSpart : (S ∩ A) ∪ (S ∩ M) = S := by
    apply Finset.eq_of_subset_of_card_le
    · intro g hg
      rcases Finset.mem_union.mp hg with hg | hg
      · exact Finset.inter_subset_left hg
      · exact Finset.inter_subset_left hg
    · rw [Finset.card_union_of_disjoint
          (hAM.mono Finset.inter_subset_right Finset.inter_subset_right),
        hcoord.1, hcoord.2, hSCard]
      omega
  have hQcover : Q ⊆ A ∪ M := by
    intro g hgQ
    by_cases hgf : g = f
    · subst g
      exact Finset.mem_union.mpr (Or.inl (by simpa only [A] using hfA))
    · have hgErase : g ∈ Q.erase f := Finset.mem_erase.mpr ⟨hgf, hgQ⟩
      rw [← hQM] at hgErase
      exact Finset.mem_union.mpr
        (Or.inr (Finset.inter_subset_right hgErase))
  have hScover : S ⊆ A ∪ M := by
    intro g hgS
    rw [← hSpart] at hgS
    rcases Finset.mem_union.mp hgS with hg | hg
    · exact Finset.mem_union.mpr
        (Or.inl (Finset.inter_subset_right hg))
    · exact Finset.mem_union.mpr
        (Or.inr (Finset.inter_subset_right hg))
  let U := S ∪ Q
  have hUcover : U ⊆ A ∪ M := by
    exact Finset.union_subset hScover hQcover
  have hUA : U ∩ A = S ∩ A := by
    change (S ∪ Q) ∩ A = S ∩ A
    rw [Finset.union_inter_distrib_right, hQA]
    exact Finset.union_eq_left.mpr (by
      intro g hg
      have hgf' : g = f := Finset.mem_singleton.mp hg
      subst g
      exact Finset.mem_inter.mpr ⟨hfS, by simpa only [A] using hfA⟩)
  have hUpart : (U ∩ A) ∪ (U ∩ M) = U := by
    ext g
    constructor
    · intro hg
      rcases Finset.mem_union.mp hg with hg | hg
      · exact Finset.inter_subset_left hg
      · exact Finset.inter_subset_left hg
    · intro hgU
      rcases Finset.mem_union.mp (hUcover hgU) with hgA | hgM
      · exact Finset.mem_union.mpr
          (Or.inl (Finset.mem_inter.mpr ⟨hgU, hgA⟩))
      · exact Finset.mem_union.mpr
          (Or.inr (Finset.mem_inter.mpr ⟨hgU, hgM⟩))
  have hUACard : (U ∩ A).card = s + 1 := by rw [hUA, hcoord.1]
  have hUMCard : (U ∩ M).card = U.card - (s + 1) := by
    have hdisjParts : Disjoint (U ∩ A) (U ∩ M) :=
      hAM.mono Finset.inter_subset_right Finset.inter_subset_right
    have hcard := Finset.card_union_of_disjoint hdisjParts
    rw [hUpart, hUACard] at hcard
    omega
  refine ⟨Q, U.card, hQlink, hfQ, ?_⟩
  apply mem_partialFamily.mpr
  refine ⟨mem_testConflictUnionLayer.mpr ⟨?_, rfl⟩, hUACard, hUMCard⟩
  exact mem_testConflictUnionFamily.mpr
    ⟨S, hS, Q, hQlink,
      Finset.not_disjoint_iff.mpr ⟨f, hfS, hfQ⟩, rfl⟩

def testGainCollisionChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (S : Hypergraph V) : Hypergraph V :=
  (S ∩ availableEdges H C M).filter fun e ↦
    ∃ f ∈ S ∩ availableEdges H C M, f ≠ e ∧
      e ∈ availableBlockerChoices H C M f

@[simp] theorem mem_testGainCollisionChoiceSet
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e : Finset V} :
    e ∈ testGainCollisionChoiceSet H C M S ↔
      e ∈ S ∩ availableEdges H C M ∧
        ∃ f ∈ S ∩ availableEdges H C M, f ≠ e ∧
          e ∈ availableBlockerChoices H C M f := by
  simp [testGainCollisionChoiceSet]

/-- Trackability excludes matching collisions, so every positive-weight
gain collision has a conflict-link representation in `Z_{e,2}`. -/
theorem gainCollisionRepresentation_exists_of_matchingSupport
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e : Finset V} {j s : ℕ} {w : TestWeight V}
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    ∃ Q r,
      Q ∈ conflictLink C e ∧
      ¬Disjoint S Q ∧
      S ∪ Q ∈ partialFamily
        (testConflictUnionLayer (H.powersetCard j) C e r)
        (availableEdges H C M) M (s + 1) := by
  obtain ⟨heSA, f, hfSA, hfe, heBlock⟩ :=
    mem_testGainCollisionChoiceSet.mp heCollision
  have heS : e ∈ S := Finset.inter_subset_left heSA
  have heA : e ∈ availableEdges H C M :=
    Finset.inter_subset_right heSA
  have hfS : f ∈ S := Finset.inter_subset_left hfSA
  have hfA : f ∈ availableEdges H C M :=
    Finset.inter_subset_right hfSA
  have hSMatching : IsMatching H S := hmatchingPos S hS hwS
  have hefDisjoint : Disjoint e f :=
    hSMatching.2 heS hfS (Ne.symm hfe)
  have heBlock' := Finset.mem_filter.mp heBlock
  have hnotAdmissible :
      ¬IsConflictFreeMatching H C (insert e (insert f M)) := by
    rcases heBlock'.2 with heq | hnot
    · exact False.elim (hfe heq.symm)
    · exact hnot
  have hmatchingEF : IsMatching H (insert e (insert f M)) := by
    rw [isMatching_insert_iff]
    refine ⟨(mem_availableEdges.mp heA).1,
      (mem_availableEdges.mp hfA).2.2.1, ?_⟩
    intro g hg hge
    rcases Finset.mem_insert.mp hg with rfl | hgM
    · exact hefDisjoint
    · exact (isMatching_insert_iff.mp
        (mem_availableEdges.mp heA).2.2.1).2.2 g hgM hge
  have hbad : ¬ConflictFree C (insert f (insert e M)) := by
    intro hfree
    apply hnotAdmissible
    refine ⟨hmatchingEF, ?_⟩
    simpa [Finset.insert_comm e f] using hfree
  obtain ⟨Q, r, hQlink, hfQ, hpartial⟩ :=
    gainConflictRepresentation_mem_partial hS hcoord heS hfS heA hfA
      (Ne.symm hfe) hefDisjoint hbad
  exact ⟨Q, r, hQlink,
    Finset.not_disjoint_iff.mpr ⟨f, hfS, hfQ⟩, hpartial⟩

theorem gainCollisionRepresentation_exists_of_trackable
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e : Finset V} {j ell s : ℕ} {d eta : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d eta w)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    ∃ Q r,
      Q ∈ conflictLink C e ∧ ¬Disjoint S Q ∧
      S ∪ Q ∈ partialFamily
        (testConflictUnionLayer (H.powersetCard j) C e r)
        (availableEdges H C M) M (s + 1) := by
  exact gainCollisionRepresentation_exists_of_matchingSupport
    (fun T hT hwT ↦ by
      by_contra hnot
      have hz := hw.isTestFunction.eq_zero_of_not_matching hnot
      linarith)
    hS hwS hcoord heCollision

/-- The weighted gain-collision defect before exchanging the two finite
sums.  This is definitionally the production collision mass. -/
def weightedTestGainCollisionMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j (s + 1) S then
      w S * (testGainCollisionChoiceSet H C M S).card
    else 0

/-- Collision mass with the choice `e` exposed as the outer coordinate. -/
def weightedTestGainCollisionAtChoice
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (e : Finset V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j (s + 1) S ∧
        e ∈ testGainCollisionChoiceSet H C M S
    then w S else 0

theorem weightedTestGainCollisionMass_eq_sum_atChoice
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) :
    weightedTestGainCollisionMass w H C M j s =
      ∑ e ∈ availableEdges H C M,
        weightedTestGainCollisionAtChoice w H C M j s e := by
  unfold weightedTestGainCollisionMass weightedTestGainCollisionAtChoice
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  by_cases hcoord :
      partialTestCondition (availableEdges H C M) M j (s + 1) S
  · rw [if_pos hcoord]
    calc
      w S * (testGainCollisionChoiceSet H C M S).card =
          ∑ e ∈ testGainCollisionChoiceSet H C M S, w S := by
        simp [mul_comm]
      _ = ∑ e ∈ availableEdges H C M,
          if e ∈ testGainCollisionChoiceSet H C M S then w S else 0 := by
        rw [← Finset.sum_filter]
        congr 1
        ext e
        simp only [Finset.mem_filter]
        constructor
        · intro he
          exact ⟨Finset.inter_subset_right
            (Finset.filter_subset _ _ he), he⟩
        · exact fun he ↦ he.2
      _ = ∑ e ∈ availableEdges H C M,
          if partialTestCondition (availableEdges H C M) M j (s + 1) S ∧
              e ∈ testGainCollisionChoiceSet H C M S
          then w S else 0 := by
        apply Finset.sum_congr rfl
        intro e heA
        simp [hcoord]
  · rw [if_neg hcoord]
    symm
    apply Finset.sum_eq_zero
    intro e heA
    simp [hcoord]


def choiceRestrictedTestFamily (Z : ConflictSystem V) (e : Finset V) :
    ConflictSystem V :=
  Z.filter fun S ↦ e ∈ S

@[simp] theorem mem_choiceRestrictedTestFamily
    {Z : ConflictSystem V} {e : Finset V} {S : Hypergraph V} :
    S ∈ choiceRestrictedTestFamily Z e ↔ S ∈ Z ∧ e ∈ S := by
  simp [choiceRestrictedTestFamily]

/-- Choice-restricted rank layer of `Z_{e,2}`. -/
def choiceTestConflictUnionLayer
    (Z C : ConflictSystem V) (e : Finset V) (r : ℕ) : ConflictSystem V :=
  testConflictUnionLayer (choiceRestrictedTestFamily Z e) C e r

/-- Representation weight retaining only source tests which contain `e`. -/
def choiceTestConflictUnionRepresentationWeight
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V) :
    TestWeight V :=
  testConflictUnionRepresentationWeight w
    (choiceRestrictedTestFamily Z e) C e

/-- Rooted representation mass for the choice-restricted family. -/
def weightedChoiceTestConflictUnionRootMass
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) : ℝ :=
  weightedTestConflictUnionRootMass w
    (choiceRestrictedTestFamily Z e) C e r root

/-- Dynamic partial mass for the choice-restricted family. -/
def weightedChoiceTestConflictUnionPartialMass
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (A M : Hypergraph V) (s : ℕ) : ℝ :=
  weightedTestConflictUnionPartialMass w
    (choiceRestrictedTestFamily Z e) C e r A M s

theorem choiceTestConflictUnionLayer_uniform
    (Z C : ConflictSystem V) (e : Finset V) (r : ℕ) :
    IsUniform (choiceTestConflictUnionLayer Z C e r) r :=
  testConflictUnionLayer_uniform (choiceRestrictedTestFamily Z e) C e r

theorem choiceTestConflictUnionRepresentationWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (U : Hypergraph V) :
    0 ≤ choiceTestConflictUnionRepresentationWeight w Z C e U :=
  testConflictUnionRepresentationWeight_nonneg hw
    (choiceRestrictedTestFamily Z e) C e U

theorem weightedCodegree_choiceTestConflictUnionRepresentationWeight
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) :
    weightedCodegree (choiceTestConflictUnionLayer Z C e r)
        (choiceTestConflictUnionRepresentationWeight w Z C e) root =
      weightedChoiceTestConflictUnionRootMass w Z C e r root :=
  weightedCodegree_testConflictUnionRepresentationWeight
    w (choiceRestrictedTestFamily Z e) C e r root

/-- Generic final adapter: only the source rooted counting estimate remains
to establish the choice-restricted weighted spread. -/
theorem choiceTestConflictUnionLayer_isWeightedRealSpread_of_rootMass
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (r j : ℕ)
    (d sigma W : ℝ) (hd : 0 < d)
    (hroot : ∀ root : Hypergraph V, root.card < r →
      weightedChoiceTestConflictUnionRootMass w Z C e r root ≤
        W * Real.rpow d
          ((r : ℝ) - (j : ℝ) - sigma - (root.card : ℝ))) :
    IsWeightedRealSpread (choiceTestConflictUnionLayer Z C e r)
      (choiceTestConflictUnionRepresentationWeight w Z C e) r
      (W * Real.rpow d ((r : ℝ) - (j : ℝ) - sigma)) d⁻¹ := by
  refine ⟨choiceTestConflictUnionLayer_uniform Z C e r,
    choiceTestConflictUnionRepresentationWeight_nonneg hw Z C e, ?_⟩
  intro root hrootCard
  rw [weightedCodegree_choiceTestConflictUnionRepresentationWeight]
  apply (hroot root hrootCard).trans_eq
  have hinv : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg hd.le _).symm
  rw [hinv]
  calc
    W * Real.rpow d
        ((r : ℝ) - (j : ℝ) - sigma - (root.card : ℝ)) =
      W * (Real.rpow d ((r : ℝ) - (j : ℝ) - sigma) *
        Real.rpow d (-(root.card : ℝ))) := by
          congr 1
          have hexp :
              (r : ℝ) - (j : ℝ) - sigma - (root.card : ℝ) =
                ((r : ℝ) - (j : ℝ) - sigma) +
                  (-(root.card : ℝ)) := by ring
          rw [hexp]
          exact Real.rpow_add hd _ _
    _ = (W * Real.rpow d ((r : ℝ) - (j : ℝ) - sigma)) *
        Real.rpow d (-(root.card : ℝ)) := by ring

theorem weightedChoiceTestConflictUnionPartialMass_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (r : ℕ)
    (A M : Hypergraph V) (s : ℕ) :
    0 ≤ weightedChoiceTestConflictUnionPartialMass w Z C e r A M s :=
  weightedTestConflictUnionPartialMass_nonneg hw
    (choiceRestrictedTestFamily Z e) C e r A M s

/-- Exact representation expansion of a choice-restricted dynamic
coordinate. -/
theorem weightedChoiceTestConflictUnionPartialMass_eq_representationSum
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (A M : Hypergraph V) (s : ℕ) :
    weightedChoiceTestConflictUnionPartialMass w Z C e r A M s =
      ∑ S ∈ choiceRestrictedTestFamily Z e,
        ∑ Q ∈ conflictLink C e,
          if ¬Disjoint S Q ∧
              S ∪ Q ∈ partialFamily
                (choiceTestConflictUnionLayer Z C e r) A M s
          then w S else 0 := by
  unfold weightedChoiceTestConflictUnionPartialMass
    weightedTestConflictUnionPartialMass
    choiceTestConflictUnionLayer
    testConflictUnionRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hSZ
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro Q hQ
  by_cases hinter : ¬Disjoint S Q
  · by_cases hpartial : S ∪ Q ∈ partialFamily
        (testConflictUnionLayer (choiceRestrictedTestFamily Z e) C e r) A M s
    · rw [if_pos ⟨hinter, hpartial⟩]
      rw [Finset.sum_eq_single (S ∪ Q)]
      · simp [hinter]
      · intro U hU hne
        simp [hinter, hne.symm]
      · exact fun hnot ↦ (hnot hpartial).elim
    · rw [if_neg (fun h ↦ hpartial h.2)]
      apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      rintro ⟨_hinter, hunion⟩
      apply hpartial
      rw [hunion]
      exact hU
  · rw [if_neg (fun h ↦ hinter h.1)]
    apply Finset.sum_eq_zero
    intro U hU
    simp [hinter]


theorem gainCollisionChoiceRepresentation_exists_of_matchingSupport
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    {e : Finset V} {j s : ℕ} {w : TestWeight V}
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (hcoord : partialTestCondition (availableEdges H C M) M j (s + 1) S)
    (heCollision : e ∈ testGainCollisionChoiceSet H C M S) :
    ∃ Q, ∃ r ∈ Finset.Icc 1 5,
      Q ∈ conflictLink C e ∧ ¬Disjoint S Q ∧
      S ∪ Q ∈ partialFamily
        (choiceTestConflictUnionLayer (H.powersetCard j) C e r)
        (availableEdges H C M) M (s + 1) := by
  obtain ⟨Q, r, hQ, hinter, hpartial⟩ :=
    gainCollisionRepresentation_exists_of_matchingSupport
      hmatchingPos hS hwS hcoord heCollision
  have heS : e ∈ S := Finset.inter_subset_left
    (mem_testGainCollisionChoiceSet.mp heCollision).1
  obtain ⟨hUlayer, hUA, hUM⟩ := mem_partialFamily.mp hpartial
  have hrestricted : S ∪ Q ∈ partialFamily
      (choiceTestConflictUnionLayer (H.powersetCard j) C e r)
      (availableEdges H C M) M (s + 1) := by
    apply mem_partialFamily.mpr
    refine ⟨?_, hUA, hUM⟩
    apply mem_testConflictUnionLayer.mpr
    refine ⟨?_, (mem_testConflictUnionLayer.mp hUlayer).2⟩
    exact mem_testConflictUnionFamily.mpr
      ⟨S, mem_choiceRestrictedTestFamily.mpr ⟨hS, heS⟩,
        Q, hQ, hinter, rfl⟩
  have hSCard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  obtain ⟨c, hcC, hec, hcErase⟩ := mem_conflictLink.mp hQ
  have hQCard : Q.card + 1 = c.card := by
    rw [← hcErase]
    exact Finset.card_erase_add_one hec
  have hQ3 : Q.card ≤ 3 := by
    have := (hCcard c hcC).2
    omega
  have hInterPos : 1 ≤ (S ∩ Q).card := by
    obtain ⟨g, hgS, hgQ⟩ := Finset.not_disjoint_iff.mp hinter
    exact Finset.card_pos.mpr ⟨g, Finset.mem_inter.mpr ⟨hgS, hgQ⟩⟩
  have hUnionCard := Finset.card_union_add_card_inter S Q
  have hrEq : (S ∪ Q).card = r :=
    (mem_testConflictUnionLayer.mp
      (mem_partialFamily.mp hrestricted).1).2
  have hr1 : 1 ≤ r := by
    have hsub : S ⊆ S ∪ Q := Finset.subset_union_left
    have := Finset.card_le_card hsub
    rw [hSCard, hrEq] at this
    omega
  have hr5 : r ≤ 5 := by
    rw [hSCard, hrEq] at hUnionCard
    omega
  exact ⟨Q, r, Finset.mem_Icc.mpr ⟨hr1, hr5⟩,
    hQ, hinter, hrestricted⟩

/-- The fixed-choice collision summand is supported on source tests which
contain that choice. -/
theorem weightedTestGainCollisionAtChoice_eq_choiceRestrictedSum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (e : Finset V) :
    weightedTestGainCollisionAtChoice w H C M j s e =
      ∑ S ∈ choiceRestrictedTestFamily (H.powersetCard j) e,
        if partialTestCondition (availableEdges H C M) M j (s + 1) S ∧
            e ∈ testGainCollisionChoiceSet H C M S
        then w S else 0 := by
  unfold weightedTestGainCollisionAtChoice
  symm
  apply Finset.sum_subset (Finset.filter_subset _ _)
  intro S hS hnotRestricted
  have heS : e ∉ S := by
    intro he
    exact hnotRestricted (mem_choiceRestrictedTestFamily.mpr ⟨hS, he⟩)
  rw [if_neg]
  rintro ⟨_hcoord, heCollision⟩
  exact heS (Finset.inter_subset_left
    (mem_testGainCollisionChoiceSet.mp heCollision).1)

/-- One selected choice charges only to its five choice-restricted rank
coordinates. -/
theorem weightedTestGainCollisionAtChoice_le_choicePartialMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {e : Finset V} {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) :
    weightedTestGainCollisionAtChoice w H C M j s e ≤
      ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass w
          (H.powersetCard j) C e r (availableEdges H C M) M (s + 1) := by
  rw [weightedTestGainCollisionAtChoice_eq_choiceRestrictedSum]
  simp_rw [weightedChoiceTestConflictUnionPartialMass_eq_representationSum]
  rw [Finset.sum_comm]
  apply Finset.sum_le_sum
  intro S hS
  have hSH : S ∈ H.powersetCard j :=
    (mem_choiceRestrictedTestFamily.mp hS).1
  by_cases hsource : partialTestCondition
      (availableEdges H C M) M j (s + 1) S ∧
        e ∈ testGainCollisionChoiceSet H C M S
  · rw [if_pos hsource]
    by_cases hwS : 0 < w S
    · obtain ⟨Q, r, hr, hQ, hinter, hpartial⟩ :=
        gainCollisionChoiceRepresentation_exists_of_matchingSupport
          hmatchingPos hCcard hj1 hj3 hSH hwS hsource.1 hsource.2
      have hQsum : w S ≤
          ∑ Q' ∈ conflictLink C e,
            if ¬Disjoint S Q' ∧
                S ∪ Q' ∈ partialFamily
                  (choiceTestConflictUnionLayer (H.powersetCard j) C e r)
                    (availableEdges H C M) M (s + 1)
            then w S else 0 := by
        have hsingle := Finset.single_le_sum
          (s := conflictLink C e)
          (f := fun Q' ↦
            if ¬Disjoint S Q' ∧
                S ∪ Q' ∈ partialFamily
                  (choiceTestConflictUnionLayer (H.powersetCard j) C e r)
                    (availableEdges H C M) M (s + 1)
            then w S else 0)
          (fun Q' _ ↦ by split; exact hw0 S; norm_num) hQ
        calc
          w S = if ¬Disjoint S Q ∧
                    S ∪ Q ∈ partialFamily
                      (choiceTestConflictUnionLayer (H.powersetCard j) C e r)
                        (availableEdges H C M) M (s + 1)
                then w S else 0 := by rw [if_pos ⟨hinter, hpartial⟩]
          _ ≤ _ := hsingle
      have hRsum := Finset.single_le_sum
        (s := Finset.Icc 1 5)
        (f := fun r' ↦ ∑ Q' ∈ conflictLink C e,
          if ¬Disjoint S Q' ∧
              S ∪ Q' ∈ partialFamily
                (choiceTestConflictUnionLayer (H.powersetCard j) C e r')
                  (availableEdges H C M) M (s + 1)
          then w S else 0)
        (fun r' _ ↦ Finset.sum_nonneg fun Q' _ ↦ by
          split; exact hw0 S; norm_num) hr
      have hcharged : w S ≤
          ∑ r' ∈ Finset.Icc 1 5,
            ∑ Q' ∈ conflictLink C e,
              if ¬Disjoint S Q' ∧
                  S ∪ Q' ∈ partialFamily
                    (choiceTestConflictUnionLayer (H.powersetCard j) C e r')
                      (availableEdges H C M) M (s + 1)
              then w S else 0 := hQsum.trans hRsum
      exact hcharged
    · have hwS0 : w S = 0 := le_antisymm (not_lt.mp hwS) (hw0 S)
      rw [hwS0]
      exact Finset.sum_nonneg fun r _ ↦
        Finset.sum_nonneg fun Q _ ↦ by split <;> norm_num
  · rw [if_neg hsource]
    exact Finset.sum_nonneg fun r _ ↦
      Finset.sum_nonneg fun Q _ ↦ by split; exact hw0 S; norm_num

/-- Full fixed-choice deterministic collision charge. -/
theorem weightedTestGainCollisionMass_le_choicePartialMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) :
    weightedTestGainCollisionMass w H C M j s ≤
      ∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass w
          (H.powersetCard j) C e r (availableEdges H C M) M (s + 1) := by
  rw [weightedTestGainCollisionMass_eq_sum_atChoice]
  exact Finset.sum_le_sum fun e _ ↦
    weightedTestGainCollisionAtChoice_le_choicePartialMass
      hw0 hmatchingPos hCcard hj1 hj3

/-- Representation weight for a fixed collision choice `e`, restricted to
source tests that actually contain that choice. -/
def fixedChoiceTestConflictUnionRepresentationWeight
    (w : TestWeight V) (Z C : ConflictSystem V)
    (e : Finset V) : TestWeight V :=
  fun U ↦ ∑ S ∈ Z, ∑ Q ∈ conflictLink C e,
    if e ∈ S ∧ ¬Disjoint S Q ∧ S ∪ Q = U then w S else 0

theorem fixedChoiceTestConflictUnionRepresentationWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (Z C : ConflictSystem V) (e : Finset V) (U : Hypergraph V) :
    0 ≤ fixedChoiceTestConflictUnionRepresentationWeight w Z C e U := by
  unfold fixedChoiceTestConflictUnionRepresentationWeight
  apply Finset.sum_nonneg
  intro S hSZ
  apply Finset.sum_nonneg
  intro Q hQ
  split
  · exact hw S
  · norm_num

/-- Rooted mass before grouping equal unions. -/
def weightedFixedChoiceTestConflictUnionRootMass
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ Z, ∑ Q ∈ conflictLink C e,
    if e ∈ S ∧ ¬Disjoint S Q ∧ (S ∪ Q).card = r ∧
        root ⊆ S ∪ Q
    then w S else 0

/-- The unweighted conflict-link choices represented by one source test in
one rooted rank coordinate. -/


def fixedChoiceLinkRootCandidates
    (C : ConflictSystem V) (e : Finset V) (S : Hypergraph V)
    (r : ℕ) (root : Hypergraph V) : ConflictSystem V :=
  (conflictLink C e).filter fun Q ↦
    ¬Disjoint S Q ∧ (S ∪ Q).card = r ∧ root ⊆ S ∪ Q

@[simp] theorem mem_fixedChoiceLinkRootCandidates
    {C : ConflictSystem V} {e : Finset V} {S : Hypergraph V}
    {r : ℕ} {root Q : Hypergraph V} :
    Q ∈ fixedChoiceLinkRootCandidates C e S r root ↔
      Q ∈ conflictLink C e ∧ ¬Disjoint S Q ∧
        (S ∪ Q).card = r ∧ root ⊆ S ∪ Q := by
  simp [fixedChoiceLinkRootCandidates, and_assoc]

/-- Before estimating anything, the rooted representation mass is a
weighted sum of the exact number of link choices over each source test. -/
theorem weightedFixedChoiceTestConflictUnionRootMass_eq_sum_mul_card
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) :
    weightedFixedChoiceTestConflictUnionRootMass w Z C e r root =
      ∑ S ∈ Z, if e ∈ S then
        w S * (fixedChoiceLinkRootCandidates C e S r root).card else 0 := by
  unfold weightedFixedChoiceTestConflictUnionRootMass
    fixedChoiceLinkRootCandidates
  apply Finset.sum_congr rfl
  intro S hSZ
  by_cases heS : e ∈ S
  · rw [if_pos heS]
    rw [← Finset.sum_filter]
    simp only [heS, true_and, Finset.sum_const, nsmul_eq_mul]
    ring
  · simp [heS]

/-- Structural facts used by every fibre count.  The key W4 consequence is
that a positive choice-restricted representation has a genuinely external
link edge: `Q \ S` is nonempty. -/
theorem fixedChoiceLinkRootCandidate_structure
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d eta : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d eta w)
    {e : Finset V} {S Q root : Hypergraph V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (heS : e ∈ S)
    (hQ : Q ∈ fixedChoiceLinkRootCandidates C e S r root) :
    e ∉ Q ∧ (S ∩ Q).Nonempty ∧ (Q \ S).Nonempty ∧
      j + (Q \ S).card = r ∧ root \ S ⊆ Q \ S := by
  have hQdata := mem_fixedChoiceLinkRootCandidates.mp hQ
  obtain ⟨c, hcC, hec, hcErase⟩ := mem_conflictLink.mp hQdata.1
  have heQ : e ∉ Q := by
    rw [← hcErase]
    simp
  have hInter : (S ∩ Q).Nonempty := by
    obtain ⟨f, hfS, hfQ⟩ := Finset.not_disjoint_iff.mp hQdata.2.1
    exact ⟨f, Finset.mem_inter.mpr ⟨hfS, hfQ⟩⟩
  have hExternal : (Q \ S).Nonempty := by
    by_contra hnone
    have hsub : Q ⊆ S := by
      rw [← Finset.sdiff_eq_empty_iff_subset]
      exact Finset.not_nonempty_iff_eq_empty.mp hnone
    have hcEq : c = insert e Q := by
      calc
        c = insert e (c.erase e) := (Finset.insert_erase hec).symm
        _ = insert e Q := by rw [hcErase]
    have hcS : c ⊆ S := by
      rw [hcEq]
      exact Finset.insert_subset heS hsub
    have hz := hw.eq_zero_of_contains_conflict hS ⟨c, hcC, hcS⟩
    linarith
  have hSCard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hUnion := Finset.card_union_add_card_inter S Q
  have hDiff := Finset.card_sdiff_add_card_inter Q S
  have hInterCard : (Q ∩ S).card = (S ∩ Q).card := by
    rw [Finset.inter_comm]
  have hRank : (S ∪ Q).card = r := hQdata.2.2.1
  have hCard : j + (Q \ S).card = r := by
    rw [hSCard, hRank] at hUnion
    rw [hInterCard] at hDiff
    omega
  have hRootExternal : root \ S ⊆ Q \ S := by
    intro f hf
    have hfRoot : f ∈ root := (Finset.mem_sdiff.mp hf).1
    have hfNotS : f ∉ S := (Finset.mem_sdiff.mp hf).2
    have hfUnion := hQdata.2.2.2 hfRoot
    have hfQ : f ∈ Q := (Finset.mem_union.mp hfUnion).resolve_left hfNotS
    exact Finset.mem_sdiff.mpr ⟨hfQ, hfNotS⟩
  exact ⟨heQ, hInter, hExternal, hCard, hRootExternal⟩

/-- Fibre of fixed-choice link candidates with prescribed intersection
with the source test. -/
def fixedChoiceLinkIntersectionFiber
    (C : ConflictSystem V) (e : Finset V) (S : Hypergraph V)
    (r : ℕ) (root I : Hypergraph V) : ConflictSystem V :=
  (fixedChoiceLinkRootCandidates C e S r root).filter fun Q ↦
    S ∩ Q = I

@[simp] theorem mem_fixedChoiceLinkIntersectionFiber
    {C : ConflictSystem V} {e : Finset V} {S : Hypergraph V}
    {r : ℕ} {root I Q : Hypergraph V} :
    Q ∈ fixedChoiceLinkIntersectionFiber C e S r root I ↔
      Q ∈ fixedChoiceLinkRootCandidates C e S r root ∧ S ∩ Q = I := by
  simp [fixedChoiceLinkIntersectionFiber]

theorem fixedChoiceLinkRootCandidates_eq_biUnion_intersectionFiber
    (C : ConflictSystem V) (e : Finset V) (S : Hypergraph V)
    (r : ℕ) (root : Hypergraph V) :
    fixedChoiceLinkRootCandidates C e S r root =
      S.powerset.biUnion fun I ↦
        fixedChoiceLinkIntersectionFiber C e S r root I := by
  ext Q
  constructor
  · intro hQ
    simp only [Finset.mem_biUnion,
      mem_fixedChoiceLinkIntersectionFiber]
    exact ⟨S ∩ Q, Finset.mem_powerset.mpr Finset.inter_subset_left,
      hQ, rfl⟩
  · intro hQ
    simp only [Finset.mem_biUnion,
      mem_fixedChoiceLinkIntersectionFiber] at hQ
    obtain ⟨I, hIS, hQ, hEq⟩ := hQ
    exact hQ

/-- The conflict-layer root associated with one intersection fibre. -/
def fixedChoiceConflictRoot (e : Finset V) (I B : Hypergraph V) :
    Hypergraph V :=
  insert e (I ∪ B)

/-- Local copy of the link-to-conflict rooted injection, kept in this
scratch file so the proof does not depend on the production `.olean` being
newer than the checked source. -/
theorem fixedChoice_codegree_conflictLinkLayer_le_insert
    (C : ConflictSystem V) (e : Finset V) (q : ℕ)
    (root : Hypergraph V) (heroot : e ∉ root) :
    codegree (conflictLinkLayer C e q) root ≤
      codegree (conflictLayer C (q + 1)) (insert e root) := by
  let S := (conflictLinkLayer C e q).filter (root ⊆ ·)
  let T := (conflictLayer C (q + 1)).filter (insert e root ⊆ ·)
  apply Finset.card_le_card_of_injOn (insert e)
  · intro Q hQ
    have hQ' := Finset.mem_filter.mp hQ
    obtain ⟨⟨c, hcC, hec, hcErase⟩, hQcard⟩ :=
      mem_conflictLinkLayer.mp hQ'.1
    have hcEq : c = insert e Q := by
      calc
        c = insert e (c.erase e) := (Finset.insert_erase hec).symm
        _ = insert e Q := by rw [hcErase]
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_filter.mpr ⟨?_, ?_⟩, ?_⟩
    · simpa [hcEq] using hcC
    · rw [← hcEq]
      have hcard := Finset.card_erase_add_one hec
      have hcecard : (c.erase e).card = q := by
        rw [hcErase]
        exact hQcard
      omega
    · exact Finset.insert_subset_insert e hQ'.2
  · intro Q hQ R hR hEq
    have hQlink := (Finset.mem_filter.mp hQ).1
    have hRlink := (Finset.mem_filter.mp hR).1
    have heQ : e ∉ Q := by
      obtain ⟨⟨c, _hcC, _hec, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQlink
      rw [← hcErase]
      simp
    have heR : e ∉ R := by
      obtain ⟨⟨c, _hcC, _hec, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hRlink
      rw [← hcErase]
      simp
    calc
      Q = (insert e Q).erase e := by simp [heQ]
      _ = (insert e R).erase e := by rw [hEq]
      _ = R := by simp [heR]

/-- In the full-external-root case a prescribed intersection fibre contains
at most one link member: it must be `I ∪ (root \ S)`. -/
theorem card_fixedChoiceLinkIntersectionFiber_le_one_of_full
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d eta : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d eta w)
    {e : Finset V} {S root I : Hypergraph V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (heS : e ∈ S)
    (hfull : (root \ S).card = r - j) :
    (fixedChoiceLinkIntersectionFiber C e S r root I).card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro Q hQ R hR
  have hQ' := (mem_fixedChoiceLinkIntersectionFiber.mp hQ)
  have hR' := (mem_fixedChoiceLinkIntersectionFiber.mp hR)
  have hQstruct := fixedChoiceLinkRootCandidate_structure
    hw hS hwS heS hQ'.1
  have hRstruct := fixedChoiceLinkRootCandidate_structure
    hw hS hwS heS hR'.1
  have hQdiffCard : (Q \ S).card = (root \ S).card := by
    have hle : j ≤ r := by omega
    rw [hfull]
    omega
  have hRdiffCard : (R \ S).card = (root \ S).card := by
    have hle : j ≤ r := by omega
    rw [hfull]
    omega
  have hQdiff : Q \ S = root \ S := by
    symm
    apply Finset.eq_of_subset_of_card_le hQstruct.2.2.2.2
    rw [hQdiffCard]
  have hRdiff : R \ S = root \ S := by
    symm
    apply Finset.eq_of_subset_of_card_le hRstruct.2.2.2.2
    rw [hRdiffCard]
  ext f
  constructor
  · intro hfQ
    by_cases hfS : f ∈ S
    · have hfI : f ∈ I := by
        rw [← hQ'.2]
        exact Finset.mem_inter.mpr ⟨hfS, hfQ⟩
      have hfRInter : f ∈ S ∩ R := by
        rw [hR'.2]
        exact hfI
      exact Finset.inter_subset_right hfRInter
    · have hfDiff : f ∈ Q \ S := Finset.mem_sdiff.mpr ⟨hfQ, hfS⟩
      rw [hQdiff, ← hRdiff] at hfDiff
      exact (Finset.mem_sdiff.mp hfDiff).1
  · intro hfR
    by_cases hfS : f ∈ S
    · have hfI : f ∈ I := by
        rw [← hR'.2]
        exact Finset.mem_inter.mpr ⟨hfS, hfR⟩
      have hfQInter : f ∈ S ∩ Q := by
        rw [hQ'.2]
        exact hfI
      exact Finset.inter_subset_right hfQInter
    · have hfDiff : f ∈ R \ S := Finset.mem_sdiff.mpr ⟨hfR, hfS⟩
      rw [hRdiff, ← hQdiff] at hfDiff
      exact (Finset.mem_sdiff.mp hfDiff).1

/-- Proper external-root fibres inherit the C3 saving.  The conclusion
deliberately discards that saving; W2 supplies the final `epsRaw/10`, and
keeping this bound at the integral exponent makes the later charging
algebra substantially simpler. -/
theorem cast_card_fixedChoiceLinkIntersectionFiber_le_rpow_of_not_full
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    {e : Finset V} {S root I : Hypergraph V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (heS : e ∈ S)
    (hnotFull : (root \ S).card < r - j) :
    ((fixedChoiceLinkIntersectionFiber C e S r root I).card : ℝ) ≤
      Real.rpow d
        ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
  let F := fixedChoiceLinkIntersectionFiber C e S r root I
  by_cases hF : F = ∅
  · rw [show fixedChoiceLinkIntersectionFiber C e S r root I = ∅ from hF]
    simp only [Finset.card_empty, Nat.cast_zero]
    exact Real.rpow_nonneg (by linarith) _
  · have hFnonempty : F.Nonempty := Finset.nonempty_iff_ne_empty.mpr hF
    obtain ⟨Q₀, hQ₀F⟩ := hFnonempty
    have hQ₀ := mem_fixedChoiceLinkIntersectionFiber.mp hQ₀F
    have hstruct := fixedChoiceLinkRootCandidate_structure
      hw hS hwS heS hQ₀.1
    let B : Hypergraph V := root \ S
    let u : ℕ := r - j
    let q : ℕ := I.card + u
    have hlejr : j ≤ r := by omega
    have hUCard : (Q₀ \ S).card = u := by
      dsimp only [u]
      omega
    have hICard : (S ∩ Q₀).card = I.card := by rw [hQ₀.2]
    have hQ₀Card : Q₀.card = q := by
      have hDiff := Finset.card_sdiff_add_card_inter Q₀ S
      have hInterCard : (Q₀ ∩ S).card = I.card := by
        rw [Finset.inter_comm, hQ₀.2]
      rw [hUCard, hInterCard] at hDiff
      dsimp only [q]
      omega
    obtain ⟨c₀, hc₀C, hec₀, hc₀Erase⟩ :=
      mem_conflictLink.mp
        (mem_fixedChoiceLinkRootCandidates.mp hQ₀.1).1
    have hc₀Card : c₀.card = q + 1 := by
      have hErase := Finset.card_erase_add_one hec₀
      rw [hc₀Erase, hQ₀Card] at hErase
      omega
    have hqBounds : 2 ≤ q + 1 ∧ q + 1 ≤ 4 := by
      rw [← hc₀Card]
      exact hB.conflict_card hc₀C
    have hINonempty : I.Nonempty := by
      rw [← hQ₀.2]
      exact hstruct.2.1
    have hIBDisjoint : Disjoint I B := by
      rw [Finset.disjoint_left]
      intro f hfI hfB
      have hfS : f ∈ S := by
        rw [← hQ₀.2] at hfI
        exact Finset.inter_subset_left hfI
      exact (Finset.mem_sdiff.mp hfB).2 hfS
    have heI : e ∉ I := by
      intro heI
      rw [← hQ₀.2] at heI
      exact hstruct.1 (Finset.inter_subset_right heI)
    have heB : e ∉ B := by
      exact fun heB ↦ (Finset.mem_sdiff.mp heB).2 heS
    have heIB : e ∉ I ∪ B := by simp [heI, heB]
    have hRootCard :
        (fixedChoiceConflictRoot e I B).card = I.card + B.card + 1 := by
      unfold fixedChoiceConflictRoot
      rw [Finset.card_insert_of_notMem heIB,
        Finset.card_union_of_disjoint hIBDisjoint]
    have hRootTwo : 2 ≤ (fixedChoiceConflictRoot e I B).card := by
      rw [hRootCard]
      have hIpos := Finset.card_pos.mpr hINonempty
      omega
    have hRootLt : (fixedChoiceConflictRoot e I B).card < q + 1 := by
      rw [hRootCard]
      dsimp only [q, u, B]
      omega
    have hFiberSubset : F ⊆
        (conflictLinkLayer C e q).filter (I ∪ B ⊆ ·) := by
      intro Q hQF
      have hQ := mem_fixedChoiceLinkIntersectionFiber.mp hQF
      have hQstruct := fixedChoiceLinkRootCandidate_structure
        hw hS hwS heS hQ.1
      apply Finset.mem_filter.mpr
      refine ⟨?_, ?_⟩
      · apply mem_conflictLinkLayer.mpr
        refine ⟨mem_conflictLink.mp
          (mem_fixedChoiceLinkRootCandidates.mp hQ.1).1, ?_⟩
        have hDiff := Finset.card_sdiff_add_card_inter Q S
        have hQDiffCard : (Q \ S).card = u := by
          dsimp only [u]
          omega
        have hInterCard : (Q ∩ S).card = I.card := by
          rw [Finset.inter_comm, hQ.2]
        rw [hQDiffCard, hInterCard] at hDiff
        dsimp only [q]
        omega
      · apply Finset.union_subset
        · intro f hfI
          rw [← hQ.2] at hfI
          exact Finset.inter_subset_right hfI
        · exact (show root \ S ⊆ Q \ S from hQstruct.2.2.2.2).trans
            Finset.sdiff_subset
    have hCardLink : (F.card : ℝ) ≤
        (codegree (conflictLinkLayer C e q) (I ∪ B) : ℝ) := by
      exact_mod_cast Finset.card_le_card hFiberSubset
    have hLinkLayer :
        (codegree (conflictLinkLayer C e q) (I ∪ B) : ℝ) ≤
          (codegree (conflictLayer C (q + 1))
            (fixedChoiceConflictRoot e I B) : ℝ) := by
      exact_mod_cast fixedChoice_codegree_conflictLinkLayer_le_insert
        C e q (I ∪ B) heIB
    have hC3 :
        (codegree (conflictLayer C (q + 1))
            (fixedChoiceConflictRoot e I B) : ℝ) ≤
          Real.rpow d
            (((q + 1 : ℕ) : ℝ) -
              ((fixedChoiceConflictRoot e I B).card : ℝ) -
              epsRaw / 4) := by
      exact hB.layer_codegree hqBounds.1 hqBounds.2 hRootTwo hRootLt
        (fixedChoiceConflictRoot e I B) rfl
    calc
      (F.card : ℝ) ≤
          (codegree (conflictLinkLayer C e q) (I ∪ B) : ℝ) := hCardLink
      _ ≤ (codegree (conflictLayer C (q + 1))
            (fixedChoiceConflictRoot e I B) : ℝ) := hLinkLayer
      _ ≤ Real.rpow d
          (((q + 1 : ℕ) : ℝ) -
            ((fixedChoiceConflictRoot e I B).card : ℝ) -
            epsRaw / 4) := hC3
      _ ≤ Real.rpow d
          ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
        apply Real.rpow_le_rpow_of_exponent_le hd
        rw [hRootCard]
        dsimp only [q, u, B]
        push_cast
        have hsubCast : ((r - j : ℕ) : ℝ) = (r : ℝ) - (j : ℝ) := by
          exact Nat.cast_sub hlejr
        rw [hsubCast]
        linarith

theorem cast_card_fixedChoiceLinkIntersectionFiber_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    {e : Finset V} {S root I : Hypergraph V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (heS : e ∈ S) :
    ((fixedChoiceLinkIntersectionFiber C e S r root I).card : ℝ) ≤
      Real.rpow d
        ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
  let F := fixedChoiceLinkIntersectionFiber C e S r root I
  by_cases hF : F = ∅
  · rw [show fixedChoiceLinkIntersectionFiber C e S r root I = ∅ from hF]
    simp only [Finset.card_empty, Nat.cast_zero]
    exact Real.rpow_nonneg (by linarith) _
  · obtain ⟨Q, hQF⟩ := Finset.nonempty_iff_ne_empty.mpr hF
    have hQ := (mem_fixedChoiceLinkIntersectionFiber.mp hQF).1
    have hstruct := fixedChoiceLinkRootCandidate_structure
      hw hS hwS heS hQ
    have hlejr : j ≤ r := by omega
    have hExternalLe : (root \ S).card ≤ r - j := by
      have hle := Finset.card_le_card hstruct.2.2.2.2
      omega
    rcases hExternalLe.lt_or_eq with hlt | heq
    · exact cast_card_fixedChoiceLinkIntersectionFiber_le_rpow_of_not_full
        hw hB hd heps hS hwS heS hlt
    · have hcardOne := card_fixedChoiceLinkIntersectionFiber_le_one_of_full
        (I := I) hw hS hwS heS heq
      calc
        ((fixedChoiceLinkIntersectionFiber C e S r root I).card : ℝ) ≤ 1 := by
          exact_mod_cast hcardOne
        _ = Real.rpow d
            ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
          have hsubCast : ((r - j : ℕ) : ℝ) = (r : ℝ) - (j : ℝ) :=
            Nat.cast_sub hlejr
          rw [heq, hsubCast]
          simp

/-- A positive source test has at most eight times the natural conflict
degree scale worth of fixed-choice link representations. -/
theorem cast_card_fixedChoiceLinkRootCandidates_le_eight_mul_rpow
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    {e : Finset V} {S root : Hypergraph V}
    (hS : S ∈ H.powersetCard j) (hwS : 0 < w S)
    (heS : e ∈ S) :
    ((fixedChoiceLinkRootCandidates C e S r root).card : ℝ) ≤
      8 * Real.rpow d
        ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
  rw [fixedChoiceLinkRootCandidates_eq_biUnion_intersectionFiber]
  calc
    (((S.powerset.biUnion fun I ↦
        fixedChoiceLinkIntersectionFiber C e S r root I).card : ℕ) : ℝ) ≤
        ∑ I ∈ S.powerset,
          ((fixedChoiceLinkIntersectionFiber C e S r root I).card : ℝ) := by
      exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ _I ∈ S.powerset,
          Real.rpow d
            ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
      apply Finset.sum_le_sum
      intro I hIS
      exact cast_card_fixedChoiceLinkIntersectionFiber_le_rpow
        hw hB hd heps hS hwS heS
    _ = (S.powerset.card : ℝ) * Real.rpow d
          ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
      simp
    _ ≤ 8 * Real.rpow d
          ((r : ℝ) - (j : ℝ) - ((root \ S).card : ℝ)) := by
      apply mul_le_mul_of_nonneg_right
      · rw [Finset.card_powerset,
          (Finset.mem_powersetCard.mp hS).2]
        have hjPow : (2 : ℝ) ^ j ≤ 8 :=
          CFMRegularization.two_pow_le_eight_of_le_three j hj3
        simpa only [Nat.cast_pow, Nat.cast_ofNat] using hjPow
      · exact Real.rpow_nonneg (by linarith) _

/-- Source tests with prescribed `root ∩ S`, restricted to the fixed choice. -/
def fixedChoiceSourceRootFiber
    (H : Hypergraph V) (j : ℕ) (e : Finset V)
    (root A : Hypergraph V) : ConflictSystem V :=
  (H.powersetCard j).filter fun S ↦ e ∈ S ∧ root ∩ S = A

@[simp] theorem mem_fixedChoiceSourceRootFiber
    {H : Hypergraph V} {j : ℕ} {e : Finset V}
    {root A S : Hypergraph V} :
    S ∈ fixedChoiceSourceRootFiber H j e root A ↔
      S ∈ H.powersetCard j ∧ e ∈ S ∧ root ∩ S = A := by
  simp [fixedChoiceSourceRootFiber, and_assoc]

theorem fixedChoiceSourceRootFiber_pairwiseDisjoint
    (H : Hypergraph V) (j : ℕ) (e : Finset V) (root : Hypergraph V) :
    (root.powerset : Set (Hypergraph V)).PairwiseDisjoint
      (fixedChoiceSourceRootFiber H j e root) := by
  intro A hA B hB hne
  change Disjoint
    (fixedChoiceSourceRootFiber H j e root A)
    (fixedChoiceSourceRootFiber H j e root B)
  rw [Finset.disjoint_left]
  intro S hSA hSB
  have hAeq := (mem_fixedChoiceSourceRootFiber.mp hSA).2.2
  have hBeq := (mem_fixedChoiceSourceRootFiber.mp hSB).2.2
  exact hne (hAeq.symm.trans hBeq)

theorem biUnion_fixedChoiceSourceRootFiber
    (H : Hypergraph V) (j : ℕ) (e : Finset V) (root : Hypergraph V) :
    root.powerset.biUnion (fixedChoiceSourceRootFiber H j e root) =
      (H.powersetCard j).filter fun S ↦ e ∈ S := by
  ext S
  constructor
  · intro hS
    simp only [Finset.mem_biUnion, mem_fixedChoiceSourceRootFiber] at hS
    obtain ⟨A, hAroot, hSH, heS, hEq⟩ := hS
    exact Finset.mem_filter.mpr ⟨hSH, heS⟩
  · intro hS
    have hS' := Finset.mem_filter.mp hS
    simp only [Finset.mem_biUnion, mem_fixedChoiceSourceRootFiber]
    exact ⟨root ∩ S, Finset.mem_powerset.mpr Finset.inter_subset_left,
      hS'.1, hS'.2, rfl⟩

/-- Exact regrouping of a fixed-choice sum by `root ∩ S`. -/
theorem sum_choiceRestricted_eq_sum_sourceRootFibers
    (H : Hypergraph V) (j : ℕ) (e : Finset V) (root : Hypergraph V)
    (f : Hypergraph V → ℝ) :
    (∑ S ∈ choiceRestrictedTestFamily (H.powersetCard j) e, f S) =
      ∑ A ∈ root.powerset,
        ∑ S ∈ fixedChoiceSourceRootFiber H j e root A, f S := by
  rw [choiceRestrictedTestFamily]
  rw [← biUnion_fixedChoiceSourceRootFiber H j e root]
  rw [Finset.sum_biUnion
    (fixedChoiceSourceRootFiber_pairwiseDisjoint H j e root)]

theorem weightedChoiceTestConflictUnionRootMass_eq_sum_mul_card
    (w : TestWeight V) (Z C : ConflictSystem V) (e : Finset V)
    (r : ℕ) (root : Hypergraph V) :
    weightedChoiceTestConflictUnionRootMass w Z C e r root =
      ∑ S ∈ choiceRestrictedTestFamily Z e,
        w S * (fixedChoiceLinkRootCandidates C e S r root).card := by
  unfold weightedChoiceTestConflictUnionRootMass
    weightedTestConflictUnionRootMass fixedChoiceLinkRootCandidates
  apply Finset.sum_congr rfl
  intro S hS
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, nsmul_eq_mul]
  ring

/-- The uniform trackable extension estimate specialized to the nonempty
root obtained by adjoining the fixed collision choice. -/
theorem trackable_insert_choice_extension_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hell : 1 ≤ ell)
    (e : Finset V) (A : Hypergraph V)
    (hEA : insert e A ⊆ H) :
    testExtension w H j (insert e A) ≤
      (ell : ℝ) * (testTotal w H j /
        Real.rpow d (((insert e A).card : ℝ) + epsRaw / 5)) := by
  have hdpos : 0 < d := by linarith
  have hstage : 1 ≤ (insert e A).card :=
    Finset.card_pos.mpr ⟨e, by simp⟩
  have hden : 0 < Real.rpow d
      (((insert e A).card : ℝ) + epsRaw / 5) :=
    Real.rpow_pos_of_pos hdpos _
  have htotal0 : 0 ≤ testTotal w H j :=
    testTotal_nonneg hw.isTestFunction.nonneg H j
  have hratio0 :
      0 ≤ testTotal w H j /
        Real.rpow d (((insert e A).card : ℝ) + epsRaw / 5) :=
    div_nonneg htotal0 hden.le
  have hellReal : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
  rcases lt_trichotomy (insert e A).card j with hlt | heq | hgt
  · exact (hw.extension_upper hstage hlt (insert e A) hEA rfl).trans
      (by nlinarith)
  · subst j
    have hextEq :
        testExtension w H (insert e A).card (insert e A) =
          w (insert e A) := by
      unfold testExtension
      have hfilter :
          (H.powersetCard (insert e A).card).filter
              (insert e A ⊆ ·) = {insert e A} := by
        ext S
        simp only [Finset.mem_filter, Finset.mem_powersetCard,
          Finset.mem_singleton]
        constructor
        · rintro ⟨⟨hSH, hScard⟩, hrootS⟩
          exact (Finset.eq_of_subset_of_card_le hrootS
            (by omega)).symm
        · rintro rfl
          exact ⟨⟨hEA, rfl⟩, Finset.Subset.rfl⟩
      rw [hfilter]
      simp
    rw [hextEq]
    have hwroot : w (insert e A) ≤ (ell : ℝ) := by
      simpa using hw.isTestFunction.le (insert e A)
    have hratio1 :
        1 ≤ testTotal w H (insert e A).card /
          Real.rpow d (((insert e A).card : ℝ) + epsRaw / 5) := by
      rw [le_div_iff₀ hden]
      simpa using hw.total_lower
    nlinarith [mul_le_mul_of_nonneg_left hratio1
      (by positivity : (0 : ℝ) ≤ ell)]
  · have hz : testExtension w H j (insert e A) = 0 := by
      unfold testExtension
      apply Finset.sum_eq_zero
      intro S hS
      obtain ⟨hSpow, hrootS⟩ := Finset.mem_filter.mp hS
      have hrootcard : (insert e A).card ≤ S.card :=
        Finset.card_le_card hrootS
      have hScard : S.card = j :=
        (Finset.mem_powersetCard.mp hSpow).2
      omega
    rw [hz]
    positivity

/-- Total source weight in one `root ∩ S` fibre. -/
theorem sum_fixedChoiceSourceRootFiber_weight_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hell : 1 ≤ ell)
    (e : Finset V) (root A : Hypergraph V) :
    (∑ S ∈ fixedChoiceSourceRootFiber H j e root A, w S) ≤
      (ell : ℝ) * (testTotal w H j /
        Real.rpow d (((insert e A).card : ℝ) + epsRaw / 5)) := by
  let F := fixedChoiceSourceRootFiber H j e root A
  let T : Hypergraph V := insert e A
  by_cases hF : F = ∅
  · rw [show fixedChoiceSourceRootFiber H j e root A = ∅ from hF]
    simp only [Finset.sum_empty, zero_le]
    exact mul_nonneg (Nat.cast_nonneg ell)
      (div_nonneg
        (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg (by linarith) _))
  · obtain ⟨S₀, hS₀F⟩ := Finset.nonempty_iff_ne_empty.mpr hF
    have hS₀ := mem_fixedChoiceSourceRootFiber.mp hS₀F
    have hTH : T ⊆ H := by
      have hS₀H := (Finset.mem_powersetCard.mp hS₀.1).1
      apply Finset.Subset.trans ?_ hS₀H
      apply Finset.insert_subset hS₀.2.1
      intro f hfA
      rw [← hS₀.2.2] at hfA
      exact Finset.inter_subset_right hfA
    have hfiberSubset : F ⊆
        (H.powersetCard j).filter (T ⊆ ·) := by
      intro S hSF
      have hS := mem_fixedChoiceSourceRootFiber.mp hSF
      apply Finset.mem_filter.mpr
      refine ⟨hS.1, ?_⟩
      apply Finset.insert_subset hS.2.1
      intro f hfA
      rw [← hS.2.2] at hfA
      exact Finset.inter_subset_right hfA
    have hweight : (∑ S ∈ F, w S) ≤ testExtension w H j T := by
      apply Finset.sum_le_sum_of_subset_of_nonneg hfiberSubset
      intro S hSext hSnot
      exact hw.isTestFunction.nonneg S
    have hext := trackable_insert_choice_extension_le
      hw hd hell e A (by simpa only [T] using hTH)
    calc
      (∑ S ∈ fixedChoiceSourceRootFiber H j e root A, w S) =
          ∑ S ∈ F, w S := by rfl
      _ ≤ testExtension w H j T := hweight
      _ ≤ (ell : ℝ) * (testTotal w H j /
          Real.rpow d (((insert e A).card : ℝ) + epsRaw / 5)) := by
        simpa only [T] using hext

/-- Pointwise candidate-count charge inside one source-root fibre. -/
theorem fixedChoiceSourceRootFiber_term_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    (e : Finset V) (root A S : Hypergraph V)
    (hSF : S ∈ fixedChoiceSourceRootFiber H j e root A) :
    w S * (fixedChoiceLinkRootCandidates C e S r root).card ≤
      w S * (8 * Real.rpow d
        ((r : ℝ) - (j : ℝ) - ((root.card - A.card : ℕ) : ℝ))) := by
  have hS := mem_fixedChoiceSourceRootFiber.mp hSF
  have hwS0 := hw.isTestFunction.nonneg S
  have hrootDiffCard :
      (root \ S).card = root.card - A.card := by
    have hcard := Finset.card_sdiff_add_card_inter root S
    rw [hS.2.2] at hcard
    omega
  by_cases hwS : 0 < w S
  · apply mul_le_mul_of_nonneg_left ?_ hwS0
    have hcandidates :=
      cast_card_fixedChoiceLinkRootCandidates_le_eight_mul_rpow
        (r := r) (root := root)
        hw hB hd heps hj3 hS.1 hwS hS.2.1
    simpa only [hrootDiffCard] using hcandidates
  · have hwZero : w S = 0 := le_antisymm (not_lt.mp hwS) hwS0
    simp [hwZero]

/-- Sum of the pointwise candidate charges in one source-root fibre. -/
theorem sum_fixedChoiceSourceRootFiber_mul_candidateCard_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hj3 : j ≤ 3)
    (e : Finset V) (root A : Hypergraph V) :
    (∑ S ∈ fixedChoiceSourceRootFiber H j e root A,
        w S * (fixedChoiceLinkRootCandidates C e S r root).card) ≤
      8 * Real.rpow d
          ((r : ℝ) - (j : ℝ) - ((root.card - A.card : ℕ) : ℝ)) *
        ∑ S ∈ fixedChoiceSourceRootFiber H j e root A, w S := by
  calc
    (∑ S ∈ fixedChoiceSourceRootFiber H j e root A,
        w S * (fixedChoiceLinkRootCandidates C e S r root).card) ≤
      ∑ S ∈ fixedChoiceSourceRootFiber H j e root A,
        w S * (8 * Real.rpow d
          ((r : ℝ) - (j : ℝ) - ((root.card - A.card : ℕ) : ℝ))) := by
      apply Finset.sum_le_sum
      intro S hSF
      exact fixedChoiceSourceRootFiber_term_le
        hw hB hd heps hj3 e root A S hSF
    _ = 8 * Real.rpow d
          ((r : ℝ) - (j : ℝ) - ((root.card - A.card : ℕ) : ℝ)) *
        ∑ S ∈ fixedChoiceSourceRootFiber H j e root A, w S := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro S hSF
      ring

/-- Contribution of one value of `root ∩ S`. -/
theorem sum_fixedChoiceSourceRootFiber_mul_candidateCard_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (e : Finset V) (root A : Hypergraph V)
    (hA : A ∈ root.powerset) :
    (∑ S ∈ fixedChoiceSourceRootFiber H j e root A,
        w S * (fixedChoiceLinkRootCandidates C e S r root).card) ≤
      8 * (ell : ℝ) * testTotal w H j *
        Real.rpow d
          ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
    let T : Hypergraph V := insert e A
    let E : ℝ :=
      (r : ℝ) - (j : ℝ) - ((root.card - A.card : ℕ) : ℝ)
    have hsumPoint := sum_fixedChoiceSourceRootFiber_mul_candidateCard_le_raw
      (r := r) hw hB hd heps hj3 e root A
    have hweightBound := sum_fixedChoiceSourceRootFiber_weight_le
      hw hd hell e root A
    have hEA : E - ((T.card : ℝ) + epsRaw / 5) ≤
        (r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5 := by
      have hAroot : A.card ≤ root.card :=
        Finset.card_le_card (Finset.mem_powerset.mp hA)
      have hAT : A.card ≤ T.card := by
        exact Finset.card_le_card (Finset.subset_insert e A)
      have hATReal : (A.card : ℝ) ≤ (T.card : ℝ) := by
        exact_mod_cast hAT
      have hsubCast : ((root.card - A.card : ℕ) : ℝ) =
          (root.card : ℝ) - (A.card : ℝ) := Nat.cast_sub hAroot
      dsimp only [E]
      rw [hsubCast]
      linarith
    have htotal0 : 0 ≤ testTotal w H j :=
      testTotal_nonneg hw.isTestFunction.nonneg H j
    have hconst0 : 0 ≤ 8 * (ell : ℝ) * testTotal w H j := by
      positivity
    calc
      (∑ S ∈ fixedChoiceSourceRootFiber H j e root A,
          w S * (fixedChoiceLinkRootCandidates C e S r root).card) ≤
          8 * Real.rpow d E *
            ∑ S ∈ fixedChoiceSourceRootFiber H j e root A, w S := hsumPoint
      _ ≤ 8 * Real.rpow d E *
          ((ell : ℝ) * (testTotal w H j /
            Real.rpow d ((T.card : ℝ) + epsRaw / 5))) := by
        apply mul_le_mul_of_nonneg_left hweightBound
        exact mul_nonneg (by norm_num)
          (Real.rpow_nonneg (by linarith) E)
      _ = 8 * (ell : ℝ) * testTotal w H j *
          Real.rpow d (E - ((T.card : ℝ) + epsRaw / 5)) := by
        have hrpowSub :
            Real.rpow d (E - ((T.card : ℝ) + epsRaw / 5)) =
              Real.rpow d E /
                Real.rpow d ((T.card : ℝ) + epsRaw / 5) :=
          Real.rpow_sub (by linarith : 0 < d) E
            ((T.card : ℝ) + epsRaw / 5)
        rw [hrpowSub]
        ring_nf
      _ ≤ 8 * (ell : ℝ) * testTotal w H j *
          Real.rpow d
            ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
        apply mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hd hEA) hconst0

/-- The complete fixed-choice rooted representation estimate. -/
theorem weightedChoiceTestConflictUnionRootMass_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr5 : r ≤ 5)
    (hcutoff : 128 * (ell : ℝ) ≤ Real.rpow d (epsRaw / 10))
    (e : Finset V) (root : Hypergraph V) (hroot : root.card < r) :
    weightedChoiceTestConflictUnionRootMass
        w (H.powersetCard j) C e r root ≤
      testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10 - (root.card : ℝ)) := by
  have hroot4 : root.card ≤ 4 := by omega
  have hpowCard : (root.powerset.card : ℝ) ≤ 16 := by
    rw [Finset.card_powerset]
    have hnat : 2 ^ root.card ≤ 2 ^ 4 :=
      Nat.pow_le_pow_right (by norm_num) hroot4
    norm_num at hnat ⊢
    exact_mod_cast hnat
  have htotal0 : 0 ≤ testTotal w H j :=
    testTotal_nonneg hw.isTestFunction.nonneg H j
  have hrpow0 : 0 ≤ Real.rpow d
      ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) :=
    Real.rpow_nonneg (by linarith) _
  have hcoarse :
      weightedChoiceTestConflictUnionRootMass
          w (H.powersetCard j) C e r root ≤
        128 * (ell : ℝ) * testTotal w H j *
          Real.rpow d
            ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
    rw [weightedChoiceTestConflictUnionRootMass_eq_sum_mul_card]
    rw [sum_choiceRestricted_eq_sum_sourceRootFibers]
    calc
      (∑ A ∈ root.powerset,
          ∑ S ∈ fixedChoiceSourceRootFiber H j e root A,
            w S * (fixedChoiceLinkRootCandidates C e S r root).card) ≤
          ∑ _A ∈ root.powerset,
            8 * (ell : ℝ) * testTotal w H j *
              Real.rpow d
                ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
        apply Finset.sum_le_sum
        intro A hA
        exact sum_fixedChoiceSourceRootFiber_mul_candidateCard_le
          hw hB hd heps hell hj3 e root A hA
      _ = (root.powerset.card : ℝ) *
            (8 * (ell : ℝ) * testTotal w H j *
              Real.rpow d
                ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5)) := by
        simp
      _ ≤ 16 *
            (8 * (ell : ℝ) * testTotal w H j *
              Real.rpow d
                ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5)) := by
        apply mul_le_mul_of_nonneg_right hpowCard
        positivity
      _ = 128 * (ell : ℝ) * testTotal w H j *
            Real.rpow d
              ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
        ring
  apply hcoarse.trans
  calc
    128 * (ell : ℝ) * testTotal w H j *
        Real.rpow d
          ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) ≤
      Real.rpow d (epsRaw / 10) * testTotal w H j *
        Real.rpow d
          ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
      apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hcutoff htotal0
      · exact hrpow0
    _ = testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10 - (root.card : ℝ)) := by
      calc
        Real.rpow d (epsRaw / 10) * testTotal w H j *
            Real.rpow d
              ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5) =
          testTotal w H j *
            (Real.rpow d (epsRaw / 10) *
              Real.rpow d
                ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5)) := by
          ring
        _ = testTotal w H j * Real.rpow d
            (epsRaw / 10 +
              ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5)) := by
          congr 1
          exact (Real.rpow_add (by linarith : 0 < d)
            (epsRaw / 10)
            ((r : ℝ) - (j : ℝ) - (root.card : ℝ) - epsRaw / 5)).symm
        _ = testTotal w H j * Real.rpow d
            ((r : ℝ) - (j : ℝ) - epsRaw / 10 - (root.card : ℝ)) := by
          congr 1
          ring_nf

/-- No-premise static weighted spread for one selected collision choice,
apart from the single explicit finite-multiplicity cutoff. -/
theorem choiceTestConflictUnionLayer_isWeightedRealSpread_of_trackable
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr5 : r ≤ 5)
    (hcutoff : 128 * (ell : ℝ) ≤ Real.rpow d (epsRaw / 10))
    (e : Finset V) :
    IsWeightedRealSpread
      (choiceTestConflictUnionLayer (H.powersetCard j) C e r)
      (choiceTestConflictUnionRepresentationWeight
        w (H.powersetCard j) C e) r
      (testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10)) d⁻¹ := by
  apply choiceTestConflictUnionLayer_isWeightedRealSpread_of_rootMass
    hw.isTestFunction.nonneg (H.powersetCard j) C e r j
      d (epsRaw / 10) (testTotal w H j) (by linarith)
  intro root hroot
  exact weightedChoiceTestConflictUnionRootMass_le
    hw hB hd heps hell hj3 hr5 hcutoff e root hroot


theorem ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f e : Finset V} (hf : f ∈ availableEdges H C M)
    (he : e ∈ conflictBlockerChoices C M (availableEdges H C M) f) :
    ∃ c ∈ C, c ⊆ insert f (insert e M) ∧ f ∈ c ∧ e ∈ c ∧ e ≠ f := by
  have he' := Finset.mem_filter.mp he
  obtain ⟨c, hcC, hcsub⟩ := not_conflictFree_iff.mp he'.2.2
  have heA : e ∈ availableEdges H C M := he'.1
  have hfreeE : ConflictFree C (insert e M) :=
    (mem_availableEdges.mp heA).2.2.2
  have hfreeF : ConflictFree C (insert f M) :=
    (mem_availableEdges.mp hf).2.2.2
  have hfc : f ∈ c := by
    by_contra hfc
    apply hfreeE c hcC
    intro x hxc
    rcases Finset.mem_insert.mp (hcsub hxc) with hxf | hxrest
    · exact False.elim (hfc (hxf ▸ hxc))
    · exact hxrest
  have hec : e ∈ c := by
    by_contra hec
    apply hfreeF c hcC
    intro x hxc
    rcases Finset.mem_insert.mp (hcsub hxc) with hxf | hxrest
    · exact Finset.mem_insert.mpr (Or.inl hxf)
    · rcases Finset.mem_insert.mp hxrest with hxe | hxM
      · exact False.elim (hec (hxe ▸ hxc))
      · exact Finset.mem_insert_of_mem hxM
  have hef : e ≠ f := by
    intro hef
    subst e
    apply hfreeF c hcC
    simpa using hcsub
  exact ⟨c, hcC, hcsub, hfc, hec, hef⟩

/-! The two-conflict CC residual is a pre-existing Definition 6.1(iii)
coordinate after the witness conflicts are re-rooted at the two test edges.
The common random blocker then witnesses overlap of the two re-rooted links. -/

/-- Two conflicts through `h`, rooted instead at `f` and `g`, give a member
of `Z_{g,2}` whose base test system is the appropriate layer of `C_f`. -/
theorem conflictPair_reroot_mem_testConflictUnionLayer
    {C : ConflictSystem V} {cF cG : Hypergraph V}
    {f g h : Finset V}
    (hcF : cF ∈ C) (hcG : cG ∈ C)
    (hfF : f ∈ cF) (hhF : h ∈ cF)
    (hgG : g ∈ cG) (hhG : h ∈ cG)
    (hhf : h ≠ f) (hhg : h ≠ g) :
    cF.erase f ∪ cG.erase g ∈
      testConflictUnionLayer
        (conflictLinkLayer C f (cF.erase f).card) C g
        (cF.erase f ∪ cG.erase g).card := by
  have hQF : cF.erase f ∈ conflictLinkLayer C f (cF.erase f).card :=
    mem_conflictLinkLayer.mpr ⟨⟨cF, hcF, hfF, rfl⟩, rfl⟩
  have hQG : cG.erase g ∈ conflictLink C g :=
    mem_conflictLink.mpr ⟨cG, hcG, hgG, rfl⟩
  have hhQF : h ∈ cF.erase f := Finset.mem_erase.mpr ⟨hhf, hhF⟩
  have hhQG : h ∈ cG.erase g := Finset.mem_erase.mpr ⟨hhg, hhG⟩
  have hinter : ¬Disjoint (cF.erase f) (cG.erase g) := by
    rw [Finset.not_disjoint_iff]
    exact ⟨h, hhQF, hhQG⟩
  exact mem_testConflictUnionLayer.mpr
    ⟨mem_testConflictUnionFamily.mpr
      ⟨cF.erase f, hQF, cG.erase g, hQG, hinter, rfl⟩, rfl⟩

/-- A finite set supported on `insert h M`, with `h` available and the
available/selected sets disjoint, is in the one-open partial coordinate. -/
theorem mem_partialFamily_one_of_subset_insert
    {X : ConflictSystem V} {A M U : Hypergraph V} {h : Finset V}
    (hUX : U ∈ X) (hUsub : U ⊆ insert h M) (hhU : h ∈ U)
    (hhA : h ∈ A) (hAM : Disjoint A M) :
    U ∈ partialFamily X A M 1 := by
  have hhM : h ∉ M := by
    intro hhM
    exact Finset.disjoint_left.mp hAM hhA hhM
  have hUA : U ∩ A = {h} := by
    ext x
    constructor
    · intro hx
      have hxU := Finset.inter_subset_left hx
      have hxA := Finset.inter_subset_right hx
      rcases Finset.mem_insert.mp (hUsub hxU) with hxh | hxM
      · simpa [hxh]
      · exact False.elim (Finset.disjoint_left.mp hAM hxA hxM)
    · intro hx
      have hxh : x = h := Finset.mem_singleton.mp hx
      subst x
      exact Finset.mem_inter.mpr ⟨hhU, hhA⟩
  have hUM : U ∩ M = U.erase h := by
    ext x
    constructor
    · intro hx
      exact Finset.mem_erase.mpr
        ⟨fun hxh ↦ hhM (hxh ▸ Finset.inter_subset_right hx),
          Finset.inter_subset_left hx⟩
    · intro hx
      have hx' := Finset.mem_erase.mp hx
      rcases Finset.mem_insert.mp (hUsub hx'.2) with hxh | hxM
      · exact False.elim (hx'.1 hxh)
      · exact Finset.mem_inter.mpr ⟨hx'.2, hxM⟩
  apply mem_partialFamily.mpr
  refine ⟨hUX, ?_, ?_⟩
  · rw [hUA]
    simp
  · rw [hUM, Finset.card_erase_of_mem hhU]

/-- Exact dynamic CC rerooting.  A common conflict blocker `h` of the two
available test members produces a one-open member of an existing
`Z_{g,2}` layer.  No intersection of the links rooted at `h` is required. -/
theorem commonConflictBlocker_mem_rerootedTestConflictUnionPartial
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f g h : Finset V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hfA : f ∈ availableEdges H C M)
    (hgA : g ∈ availableEdges H C M)
    (hhF : h ∈ conflictBlockerChoices C M (availableEdges H C M) f)
    (hhG : h ∈ conflictBlockerChoices C M (availableEdges H C M) g) :
    ∃ q r, q ∈ Finset.Icc 1 3 ∧ r ∈ Finset.Icc 1 5 ∧
      ∃ U ∈ partialFamily
        (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
        (availableEdges H C M) M 1, True := by
  let A := availableEdges H C M
  obtain ⟨cF, hcFC, hcFsub, hfF, hhFc, hhf⟩ :=
    ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices hfA hhF
  obtain ⟨cG, hcGC, hcGsub, hgG, hhGc, hhg⟩ :=
    ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices hgA hhG
  let QF := cF.erase f
  let QG := cG.erase g
  let U := QF ∪ QG
  let q := QF.card
  let r := U.card
  have hhA : h ∈ A := by
    exact Finset.mem_filter.mp hhF |>.1
  have hQFsub : QF ⊆ insert h M := by
    intro x hx
    have hxf : x ≠ f := (Finset.mem_erase.mp hx).1
    have hxc : x ∈ cF := (Finset.mem_erase.mp hx).2
    rcases Finset.mem_insert.mp (hcFsub hxc) with hxf' | hxrest
    · exact False.elim (hxf hxf')
    · exact hxrest
  have hQGsub : QG ⊆ insert h M := by
    intro x hx
    have hxg : x ≠ g := (Finset.mem_erase.mp hx).1
    have hxc : x ∈ cG := (Finset.mem_erase.mp hx).2
    rcases Finset.mem_insert.mp (hcGsub hxc) with hxg' | hxrest
    · exact False.elim (hxg hxg')
    · exact hxrest
  have hUsub : U ⊆ insert h M := Finset.union_subset hQFsub hQGsub
  have hhQF : h ∈ QF := Finset.mem_erase.mpr ⟨hhf, hhFc⟩
  have hhU : h ∈ U := Finset.mem_union_left QG hhQF
  have hUlayer : U ∈
      testConflictUnionLayer (conflictLinkLayer C f q) C g r := by
    simpa only [QF, QG, U, q, r] using
      conflictPair_reroot_mem_testConflictUnionLayer
        hcFC hcGC hfF hhFc hgG hhGc hhf hhg
  have hUpartial : U ∈ partialFamily
      (testConflictUnionLayer (conflictLinkLayer C f q) C g r) A M 1 :=
    mem_partialFamily_one_of_subset_insert hUlayer hUsub hhU hhA
      (by simpa only [A] using availableEdges_disjoint_selected H C M)
  have hqPos : 1 ≤ q := Finset.card_pos.mpr ⟨h, hhQF⟩
  have hq3 : q ≤ 3 := by
    have hErase := Finset.card_erase_add_one hfF
    have hc4 := (hCcard cF hcFC).2
    simpa only [q, QF] using (show (cF.erase f).card ≤ 3 by omega)
  have hqG3 : QG.card ≤ 3 := by
    have hErase := Finset.card_erase_add_one hgG
    have hc4 := (hCcard cG hcGC).2
    simpa only [QG] using (show (cG.erase g).card ≤ 3 by omega)
  have hrPos : 1 ≤ r := Finset.card_pos.mpr ⟨h, hhU⟩
  have hr5 : r ≤ 5 := by
    have hInter : 1 ≤ (QF ∩ QG).card :=
      Finset.card_pos.mpr ⟨h, Finset.mem_inter.mpr
        ⟨hhQF, Finset.mem_erase.mpr ⟨hhg, hhGc⟩⟩⟩
    have hUnionCard := Finset.card_union_add_card_inter QF QG
    dsimp only [r, U]
    omega
  exact ⟨q, r, Finset.mem_Icc.mpr ⟨hqPos, hq3⟩,
    Finset.mem_Icc.mpr ⟨hrPos, hr5⟩, U, hUpartial, trivial⟩

def crossConflictLinkOrderedPairSlice
    (C : ConflictSystem V) (f g : Finset V)
    (a b r : ℕ) (root : Hypergraph V) :
    Finset (Hypergraph V × Hypergraph V) :=
  ((conflictLinkLayer C f a).product (conflictLinkLayer C g b)).filter
    fun p ↦ ¬Disjoint p.1 p.2 ∧ (p.1 ∪ p.2).card = r ∧
      root ⊆ p.1 ∪ p.2

@[simp] theorem mem_crossConflictLinkOrderedPairSlice
    {C : ConflictSystem V} {f g : Finset V}
    {a b r : ℕ} {root : Hypergraph V}
    {p : Hypergraph V × Hypergraph V} :
    p ∈ crossConflictLinkOrderedPairSlice C f g a b r root ↔
      p.1 ∈ conflictLinkLayer C f a ∧
      p.2 ∈ conflictLinkLayer C g b ∧
      ¬Disjoint p.1 p.2 ∧ (p.1 ∪ p.2).card = r ∧
      root ⊆ p.1 ∪ p.2 := by
  simp [crossConflictLinkOrderedPairSlice, and_assoc]

def crossConflictLinkOrderedPairFirstRooted
    (C : ConflictSystem V) (f g : Finset V)
    (a b r : ℕ) (root : Hypergraph V) :
    Finset (Hypergraph V × Hypergraph V) :=
  (crossConflictLinkOrderedPairSlice C f g a b r root).filter
    fun p ↦ (root ∩ p.1).Nonempty

@[simp] theorem mem_crossConflictLinkOrderedPairFirstRooted
    {C : ConflictSystem V} {f g : Finset V}
    {a b r : ℕ} {root : Hypergraph V}
    {p : Hypergraph V × Hypergraph V} :
    p ∈ crossConflictLinkOrderedPairFirstRooted C f g a b r root ↔
      p ∈ crossConflictLinkOrderedPairSlice C f g a b r root ∧
        (root ∩ p.1).Nonempty := by
  simp [crossConflictLinkOrderedPairFirstRooted]

theorem card_crossPairSlice_le_firstRooted_add_swap
    (C : ConflictSystem V) (f g : Finset V)
    (a b r : ℕ) (root : Hypergraph V) (hroot : root.Nonempty) :
    (crossConflictLinkOrderedPairSlice C f g a b r root).card ≤
      (crossConflictLinkOrderedPairFirstRooted C f g a b r root).card +
      (crossConflictLinkOrderedPairFirstRooted C g f b a r root).card := by
  let P := crossConflictLinkOrderedPairSlice C f g a b r root
  let meets : Hypergraph V × Hypergraph V → Prop :=
    fun p ↦ (root ∩ p.1).Nonempty
  have hbad : (P.filter fun p ↦ ¬meets p).card ≤
      (crossConflictLinkOrderedPairFirstRooted C g f b a r root).card := by
    apply Finset.card_le_card_of_injOn (fun p ↦ (p.2, p.1))
    · intro p hp
      have hp' := Finset.mem_filter.mp hp
      have hpP := mem_crossConflictLinkOrderedPairSlice.mp
        (by simpa only [P] using hp'.1)
      apply mem_crossConflictLinkOrderedPairFirstRooted.mpr
      refine ⟨mem_crossConflictLinkOrderedPairSlice.mpr
        ⟨hpP.2.1, hpP.1, (fun hd ↦ hpP.2.2.1 hd.symm),
          by simpa [Finset.union_comm] using hpP.2.2.2.1,
          by simpa [Finset.union_comm] using hpP.2.2.2.2⟩, ?_⟩
      obtain ⟨x, hxroot⟩ := hroot
      have hxunion := hpP.2.2.2.2 hxroot
      rcases Finset.mem_union.mp hxunion with hxp1 | hxp2
      · exact False.elim (hp'.2 ⟨x,
          Finset.mem_inter.mpr ⟨hxroot, hxp1⟩⟩)
      · exact ⟨x, Finset.mem_inter.mpr ⟨hxroot, hxp2⟩⟩
    · intro p hp q hq hEq
      exact Prod.ext (congrArg Prod.snd hEq) (congrArg Prod.fst hEq)
  have hpartition := P.card_filter_add_card_filter_not meets
  calc
    P.card = (P.filter meets).card + (P.filter fun p ↦ ¬meets p).card :=
      hpartition.symm
    _ ≤ (P.filter meets).card +
        (crossConflictLinkOrderedPairFirstRooted C g f b a r root).card :=
      Nat.add_le_add_left hbad _
    _ = (crossConflictLinkOrderedPairFirstRooted C f g a b r root).card +
        (crossConflictLinkOrderedPairFirstRooted C g f b a r root).card := by
      rfl

/-- Exact finite root/intersection partition. -/
theorem card_crossPairFirstRooted_le_partitionSum
    (C : ConflictSystem V) (f g : Finset V)
    (a b r : ℕ) (root : Hypergraph V) :
    (crossConflictLinkOrderedPairFirstRooted C f g a b r root).card ≤
      ∑ E ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter Finset.Nonempty,
            codegree (conflictLinkLayer C g b) (I ∪ (root \ E)) := by
  let Cover : Finset (Hypergraph V × Hypergraph V) :=
    (root.powerset.filter Finset.Nonempty).biUnion fun E ↦
      ((conflictLinkLayer C f a).filter (root ∩ · = E)).biUnion fun Q₁ ↦
        ((Q₁.powersetCard (a + b - r)).filter Finset.Nonempty).biUnion fun I ↦
          ((conflictLinkLayer C g b).filter
            (I ∪ (root \ E) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)
  have hsub : crossConflictLinkOrderedPairFirstRooted C f g a b r root ⊆
      Cover := by
    intro p hp
    have hp' := mem_crossConflictLinkOrderedPairFirstRooted.mp hp
    have hpdata := mem_crossConflictLinkOrderedPairSlice.mp hp'.1
    let E := root ∩ p.1
    let I := p.1 ∩ p.2
    have hE : E ∈ root.powerset.filter Finset.Nonempty := by
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_powerset.mpr Finset.inter_subset_left, hp'.2⟩
    have hp1card : p.1.card = a :=
      (mem_conflictLinkLayer.mp hpdata.1).2
    have hp2card : p.2.card = b :=
      (mem_conflictLinkLayer.mp hpdata.2.1).2
    have hcardIdentity := Finset.card_union_add_card_inter p.1 p.2
    have hIcard : I.card = a + b - r := by
      dsimp [I]
      omega
    have hI : I ∈ (p.1.powersetCard (a + b - r)).filter
        Finset.Nonempty := by
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_powersetCard.mpr
          ⟨Finset.inter_subset_left, hIcard⟩,
          Finset.not_disjoint_iff_nonempty_inter.mp hpdata.2.2.1⟩
    have hremaining : root \ E ⊆ p.2 := by
      intro x hx
      have hx' := Finset.mem_sdiff.mp hx
      rcases Finset.mem_union.mp (hpdata.2.2.2.2 hx'.1) with hxp1 | hxp2
      · exact False.elim (hx'.2
          (Finset.mem_inter.mpr ⟨hx'.1, hxp1⟩))
      · exact hxp2
    have hroot2 : I ∪ (root \ E) ⊆ p.2 :=
      Finset.union_subset Finset.inter_subset_right hremaining
    apply Finset.mem_biUnion.mpr
    refine ⟨E, hE, Finset.mem_biUnion.mpr ⟨p.1, ?_, ?_⟩⟩
    · exact Finset.mem_filter.mpr ⟨hpdata.1, rfl⟩
    · apply Finset.mem_biUnion.mpr
      refine ⟨I, hI, Finset.mem_image.mpr ⟨p.2, ?_, rfl⟩⟩
      exact Finset.mem_filter.mpr ⟨hpdata.2.1, hroot2⟩
  calc
    (crossConflictLinkOrderedPairFirstRooted C f g a b r root).card ≤
        Cover.card := Finset.card_le_card hsub
    _ ≤ ∑ E ∈ root.powerset.filter Finset.Nonempty,
        (((conflictLinkLayer C f a).filter (root ∩ · = E)).biUnion fun Q₁ ↦
          ((Q₁.powersetCard (a + b - r)).filter Finset.Nonempty).biUnion
            fun I ↦ ((conflictLinkLayer C g b).filter
              (I ∪ (root \ E) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ E ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E),
          (((Q₁.powersetCard (a + b - r)).filter Finset.Nonempty).biUnion
            fun I ↦ ((conflictLinkLayer C g b).filter
              (I ∪ (root \ E) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro E hE
      exact Finset.card_biUnion_le
    _ ≤ ∑ E ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter Finset.Nonempty,
            (((conflictLinkLayer C g b).filter
              (I ∪ (root \ E) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro E hE
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      exact Finset.card_biUnion_le
    _ ≤ ∑ E ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter Finset.Nonempty,
            ((conflictLinkLayer C g b).filter
              (I ∪ (root \ E) ⊆ ·)).card := by
      apply Finset.sum_le_sum
      intro E hE
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      apply Finset.sum_le_sum
      intro I hI
      exact Finset.card_image_le
    _ = _ := by rfl

/-- The scalar heart of the cross-root partition.  The saving may come
from either link, including when the prescribed root fills one link. -/
theorem mul_codegrees_crossConflictLinks_le_partition_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f g : Finset V) (a b r t : ℕ) (E T : Hypergraph V)
    (ha1 : 1 ≤ a) (ha3 : a ≤ 3) (hb1 : 1 ≤ b) (hb3 : b ≤ 3)
    (hEpos : 1 ≤ E.card) (hEle : E.card ≤ a)
    (hTpos : 1 ≤ T.card) (hrootLt : t < r)
    (hbalance : E.card + T.card + r = a + b + t) :
    (codegree (conflictLinkLayer C f a) E : ℝ) *
        (codegree (conflictLinkLayer C g b) T : ℝ) ≤
      Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
  have hbalanceR :
      (E.card : ℝ) + (T.card : ℝ) + (r : ℝ) =
        (a : ℝ) + (b : ℝ) + (t : ℝ) := by exact_mod_cast hbalance
  rcases Nat.lt_or_eq_of_le hEle with hElt | hEeq
  · have hA := codegree_conflictLinkLayer_le_rpow
      hB hd f a E ha1 ha3 hEpos hElt
    have hBweak := codegree_conflictLinkLayer_le_rpow_weak_all
      hB hd hd1 heta g b T hb1 hb3 hTpos
    calc
      (codegree (conflictLinkLayer C f a) E : ℝ) *
          (codegree (conflictLinkLayer C g b) T : ℝ) ≤
        Real.rpow d ((a : ℝ) - (E.card : ℝ) - eta) *
          Real.rpow d ((b : ℝ) - (T.card : ℝ)) := by
            exact mul_le_mul hA hBweak (Nat.cast_nonneg _)
              (Real.rpow_nonneg hd.le _)
      _ = Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
        calc
          Real.rpow d ((a : ℝ) - (E.card : ℝ) - eta) *
              Real.rpow d ((b : ℝ) - (T.card : ℝ)) =
            Real.rpow d (((a : ℝ) - (E.card : ℝ) - eta) +
              ((b : ℝ) - (T.card : ℝ))) :=
                (Real.rpow_add hd _ _).symm
          _ = Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
            congr 1
            linarith
  · have hAone :
        (codegree (conflictLinkLayer C f a) E : ℝ) ≤ 1 := by
      exact_mod_cast codegree_le_one_of_uniform_of_card_eq
        (conflictLinkLayer_uniform C f a) E hEeq
    have hTlt : T.card < b := by omega
    have hBsharp := codegree_conflictLinkLayer_le_rpow
      hB hd g b T hb1 hb3 hTpos hTlt
    calc
      (codegree (conflictLinkLayer C f a) E : ℝ) *
          (codegree (conflictLinkLayer C g b) T : ℝ) ≤
        1 * Real.rpow d ((b : ℝ) - (T.card : ℝ) - eta) := by
          exact mul_le_mul hAone hBsharp (Nat.cast_nonneg _) (by norm_num)
      _ = Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
        rw [one_mul]
        congr 1
        have hEeqR : (E.card : ℝ) = (a : ℝ) := by exact_mod_cast hEeq
        linarith

theorem card_crossPairFirstRooted_le_128_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f g : Finset V) (a b r : ℕ) (root : Hypergraph V)
    (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3)
    (hr5 : r ≤ 5) (hrootPos : 1 ≤ root.card)
    (hrootLt : root.card < r) :
    ((crossConflictLinkOrderedPairFirstRooted
      C f g a b r root).card : ℝ) ≤
      128 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  have hcover := card_crossPairFirstRooted_le_partitionSum
    C f g a b r root
  let EF := root.powerset.filter Finset.Nonempty
  let QF : Hypergraph V → ConflictSystem V := fun E ↦
    (conflictLinkLayer C f a).filter (root ∩ · = E)
  let IF : Hypergraph V → ConflictSystem V := fun Q ↦
    (Q.powersetCard (a + b - r)).filter Finset.Nonempty
  let target := Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta)
  have hEterm : ∀ E ∈ EF,
      (∑ Q ∈ QF E, ∑ I ∈ IF Q,
        (codegree (conflictLinkLayer C g b)
          (I ∪ (root \ E)) : ℝ)) ≤ 8 * target := by
    intro E hEEF
    have hEdata := Finset.mem_filter.mp
      (by simpa only [EF] using hEEF)
    have hEsub : E ⊆ root := Finset.mem_powerset.mp hEdata.1
    have hEpos : 1 ≤ E.card := Finset.card_pos.mpr hEdata.2
    by_cases hQFempty : QF E = ∅
    · rw [hQFempty]
      simp only [Finset.sum_empty]
      dsimp only [target]
      exact mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)
    · have hQFcard : ((QF E).card : ℝ) ≤
          (codegree (conflictLinkLayer C f a) E : ℝ) := by
        exact_mod_cast card_conflictLinkLayer_filter_inter_eq_le_codegree
          C f a root E
      have hEle : E.card ≤ a := by
        obtain ⟨Q, hQQF⟩ := Finset.nonempty_iff_ne_empty.mpr hQFempty
        have hQdata := Finset.mem_filter.mp (by simpa only [QF] using hQQF)
        have hQcard := (mem_conflictLinkLayer.mp hQdata.1).2
        have hEQ : E ⊆ Q := by
          rw [← hQdata.2]
          exact Finset.inter_subset_right
        rw [← hQcard]
        exact Finset.card_le_card hEQ
      have hdegPosE : 0 <
          (codegree (conflictLinkLayer C f a) E : ℝ) := by
        obtain ⟨Q, hQQF⟩ := Finset.nonempty_iff_ne_empty.mpr hQFempty
        have hQdata := Finset.mem_filter.mp (by simpa only [QF] using hQQF)
        have hmem : Q ∈ (conflictLinkLayer C f a).filter (E ⊆ ·) :=
          Finset.mem_filter.mpr ⟨hQdata.1, by
            rw [← hQdata.2]
            exact Finset.inter_subset_right⟩
        exact_mod_cast Finset.card_pos.mpr ⟨Q, hmem⟩
      have hperQ : ∀ Q ∈ QF E,
          (∑ I ∈ IF Q,
            (codegree (conflictLinkLayer C g b)
              (I ∪ (root \ E)) : ℝ)) ≤
            8 * target /
              (codegree (conflictLinkLayer C f a) E : ℝ) := by
        intro Q hQQF
        have hQdata := Finset.mem_filter.mp (by simpa only [QF] using hQQF)
        have hQcard : Q.card = a := (mem_conflictLinkLayer.mp hQdata.1).2
        have hIFcard : (IF Q).card ≤ 8 := by
          simpa only [IF] using card_filtered_powersetCard_le_eight
            Q (a + b - r) (by rw [hQcard]; exact (Finset.mem_Icc.mp ha).2)
            Finset.Nonempty
        calc
          (∑ I ∈ IF Q, (codegree (conflictLinkLayer C g b)
              (I ∪ (root \ E)) : ℝ)) ≤
              ∑ _I ∈ IF Q, target /
                (codegree (conflictLinkLayer C f a) E : ℝ) := by
            apply Finset.sum_le_sum
            intro I hIIF
            have hIdata := Finset.mem_filter.mp (by simpa only [IF] using hIIF)
            have hIcard : I.card = a + b - r :=
              (Finset.mem_powersetCard.mp hIdata.1).2
            have hIpos : 1 ≤ I.card := Finset.card_pos.mpr hIdata.2
            have hIQ : I ⊆ Q := (Finset.mem_powersetCard.mp hIdata.1).1
            have hTcard := card_union_sdiff_of_inter_eq
              root E Q I hQdata.2 hIQ
            have hTpos : 1 ≤ (I ∪ (root \ E)).card :=
              le_trans hIpos
                (Finset.card_le_card Finset.subset_union_left)
            have hbalance : E.card + (I ∪ (root \ E)).card + r =
                a + b + root.card := by
              have hErootCard : E.card ≤ root.card :=
                Finset.card_le_card hEsub
              have hrab : r ≤ a + b := by omega
              have hEtotal : E.card ≤ I.card + root.card := by omega
              omega
            have hprod := mul_codegrees_crossConflictLinks_le_partition_rpow
              hB hd hd1 heta f g a b r root.card E
                (I ∪ (root \ E))
                (Finset.mem_Icc.mp ha).1 (Finset.mem_Icc.mp ha).2
                (Finset.mem_Icc.mp hb).1 (Finset.mem_Icc.mp hb).2
                hEpos hEle hTpos hrootLt hbalance
            apply (le_div_iff₀ hdegPosE).mpr
            simpa only [target, mul_comm] using hprod
          _ = ((IF Q).card : ℝ) *
              (target / (codegree (conflictLinkLayer C f a) E : ℝ)) := by simp
          _ ≤ 8 * (target /
              (codegree (conflictLinkLayer C f a) E : ℝ)) :=
            mul_le_mul_of_nonneg_right (by exact_mod_cast hIFcard)
              (div_nonneg (Real.rpow_nonneg hd.le _) hdegPosE.le)
          _ = 8 * target /
              (codegree (conflictLinkLayer C f a) E : ℝ) := by ring
      calc
        (∑ Q ∈ QF E, ∑ I ∈ IF Q,
            (codegree (conflictLinkLayer C g b)
              (I ∪ (root \ E)) : ℝ)) ≤
          ∑ _Q ∈ QF E, 8 * target /
            (codegree (conflictLinkLayer C f a) E : ℝ) := by
              apply Finset.sum_le_sum
              intro Q hQ
              exact hperQ Q hQ
        _ = ((QF E).card : ℝ) *
            (8 * target /
              (codegree (conflictLinkLayer C f a) E : ℝ)) := by simp
        _ ≤ (codegree (conflictLinkLayer C f a) E : ℝ) *
            (8 * target /
              (codegree (conflictLinkLayer C f a) E : ℝ)) :=
          mul_le_mul_of_nonneg_right hQFcard
            (div_nonneg (mul_nonneg (by norm_num)
              (Real.rpow_nonneg hd.le _)) (Nat.cast_nonneg _))
        _ = 8 * target := by
          field_simp [ne_of_gt hdegPosE]
  have hEFcard : EF.card ≤ 16 := by
    simpa only [EF] using card_nonempty_powerset_le_sixteen root (by omega)
  calc
    ((crossConflictLinkOrderedPairFirstRooted C f g a b r root).card : ℝ) ≤
        (∑ E ∈ EF, ∑ Q ∈ QF E, ∑ I ∈ IF Q,
          codegree (conflictLinkLayer C g b)
            (I ∪ (root \ E)) : ℕ) := by
      exact_mod_cast (by simpa only [EF, QF, IF] using hcover)
    _ = ∑ E ∈ EF, ∑ Q ∈ QF E, ∑ I ∈ IF Q,
        (codegree (conflictLinkLayer C g b)
          (I ∪ (root \ E)) : ℝ) := by push_cast; rfl
    _ ≤ ∑ _E ∈ EF, 8 * target := by
      apply Finset.sum_le_sum
      intro E hE
      exact hEterm E hE
    _ = (EF.card : ℝ) * (8 * target) := by simp
    _ ≤ 16 * (8 * target) :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast hEFcard)
        (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
    _ = 128 * Real.rpow d
        ((r : ℝ) - (root.card : ℝ) - eta) := by simp only [target]; ring

theorem card_crossPairSlice_le_256_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f g : Finset V) (a b r : ℕ) (root : Hypergraph V)
    (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3)
    (hr5 : r ≤ 5) (hrootPos : 1 ≤ root.card)
    (hrootLt : root.card < r) :
    ((crossConflictLinkOrderedPairSlice C f g a b r root).card : ℝ) ≤
      256 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  have horient := card_crossPairSlice_le_firstRooted_add_swap
    C f g a b r root (Finset.card_pos.mp hrootPos)
  have hfirst := card_crossPairFirstRooted_le_128_rpow
    hB hd hd1 heta f g a b r root ha hb hr5 hrootPos hrootLt
  have hsecond := card_crossPairFirstRooted_le_128_rpow
    hB hd hd1 heta g f b a r root hb ha hr5 hrootPos hrootLt
  calc
    ((crossConflictLinkOrderedPairSlice C f g a b r root).card : ℝ) ≤
      ((crossConflictLinkOrderedPairFirstRooted C f g a b r root).card : ℝ) +
      ((crossConflictLinkOrderedPairFirstRooted C g f b a r root).card : ℝ) :=
        by exact_mod_cast horient
    _ ≤ 128 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) +
        128 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) :=
      add_le_add hfirst hsecond
    _ = 256 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by ring

/-- Every rooted member of the rerooted `Z_{g,2}` layer has a link rank
`b=1,2,3` under the rank-four conflict specialization. -/
theorem codegree_testConflictUnionLayer_le_crossPairSlices
    (C : ConflictSystem V)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (f g : Finset V) (a r : ℕ) (root : Hypergraph V) :
    codegree (testConflictUnionLayer (conflictLinkLayer C f a) C g r) root ≤
      ∑ b ∈ Finset.Icc 1 3,
        (crossConflictLinkOrderedPairSlice C f g a b r root).card := by
  let T : ℕ → ConflictSystem V := fun b ↦
    (crossConflictLinkOrderedPairSlice C f g a b r root).image
      fun p ↦ p.1 ∪ p.2
  have hsub :
      (testConflictUnionLayer (conflictLinkLayer C f a) C g r).filter
          (root ⊆ ·) ⊆
        (Finset.Icc 1 3).biUnion T := by
    intro U hU
    have hU' := Finset.mem_filter.mp hU
    obtain ⟨QF, hQF, QG, hQG, hinter, hunion⟩ :=
      mem_testConflictUnionFamily.mp
        (mem_testConflictUnionLayer.mp hU'.1).1
    obtain ⟨cG, hcGC, hgG, hcGerase⟩ := mem_conflictLink.mp hQG
    let b := QG.card
    have hErase := Finset.card_erase_add_one hgG
    have hb1 : 1 ≤ b := by
      have hc2 := (hCcard cG hcGC).1
      rw [hcGerase] at hErase
      dsimp [b]
      omega
    have hb3 : b ≤ 3 := by
      have hc4 := (hCcard cG hcGC).2
      rw [hcGerase] at hErase
      dsimp [b]
      omega
    have hQGb : QG ∈ conflictLinkLayer C g b :=
      mem_conflictLinkLayer.mpr ⟨⟨cG, hcGC, hgG, hcGerase⟩, rfl⟩
    apply Finset.mem_biUnion.mpr
    refine ⟨b, Finset.mem_Icc.mpr ⟨hb1, hb3⟩, ?_⟩
    apply Finset.mem_image.mpr
    refine ⟨(QF, QG), mem_crossConflictLinkOrderedPairSlice.mpr
      ⟨hQF, hQGb, hinter, ?_, ?_⟩, hunion⟩
    · rw [hunion]
      exact (mem_testConflictUnionLayer.mp hU'.1).2
    · rw [hunion]
      exact hU'.2
  calc
    codegree (testConflictUnionLayer (conflictLinkLayer C f a) C g r) root ≤
        ((Finset.Icc 1 3).biUnion T).card := Finset.card_le_card hsub
    _ ≤ ∑ b ∈ Finset.Icc 1 3, (T b).card := Finset.card_biUnion_le
    _ ≤ ∑ b ∈ Finset.Icc 1 3,
        (crossConflictLinkOrderedPairSlice C f g a b r root).card := by
      apply Finset.sum_le_sum
      intro b hb
      exact Finset.card_image_le

theorem codegree_rerootedTestConflictUnionLayer_le_768_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f g : Finset V) (a r : ℕ) (root : Hypergraph V)
    (ha : a ∈ Finset.Icc 1 3) (hr5 : r ≤ 5)
    (hrootPos : 1 ≤ root.card) (hrootLt : root.card < r) :
    (codegree
      (testConflictUnionLayer (conflictLinkLayer C f a) C g r)
      root : ℝ) ≤
      768 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  have hcover := codegree_testConflictUnionLayer_le_crossPairSlices
    C hCcard f g a r root
  calc
    (codegree
        (testConflictUnionLayer (conflictLinkLayer C f a) C g r)
        root : ℝ) ≤
      ∑ b ∈ Finset.Icc 1 3,
        ((crossConflictLinkOrderedPairSlice C f g a b r root).card : ℝ) := by
          exact_mod_cast hcover
    _ ≤ ∑ _b ∈ Finset.Icc 1 3,
        256 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
      apply Finset.sum_le_sum
      intro b hb
      exact card_crossPairSlice_le_256_rpow
        hB hd hd1 heta f g a b r root ha hb hr5 hrootPos hrootLt
    _ = 768 * Real.rpow d
        ((r : ℝ) - (root.card : ℝ) - eta) := by
      norm_num [Finset.sum_Icc_succ_top]
      ring

/-! The empty-root estimate.  Proper intersections use one `(C3)` saving;
equal full links are exactly the certificate's `commonLinks` coordinate. -/

theorem card_crossPairSlice_empty_le_overlapSum
    (C : ConflictSystem V) (f g : Finset V) (a b r : ℕ) :
    (crossConflictLinkOrderedPairSlice C f g a b r ∅).card ≤
      ∑ QF ∈ conflictLinkLayer C f a,
        ∑ I ∈ (QF.powersetCard (a + b - r)).filter Finset.Nonempty,
          codegree (conflictLinkLayer C g b) I := by
  let Cover : Finset (Hypergraph V × Hypergraph V) :=
    (conflictLinkLayer C f a).biUnion fun QF ↦
      ((QF.powersetCard (a + b - r)).filter Finset.Nonempty).biUnion fun I ↦
        ((conflictLinkLayer C g b).filter (I ⊆ ·)).image fun QG ↦ (QF, QG)
  have hsub : crossConflictLinkOrderedPairSlice C f g a b r ∅ ⊆ Cover := by
    intro p hp
    have hp' := mem_crossConflictLinkOrderedPairSlice.mp hp
    let I := p.1 ∩ p.2
    have hp1card := (mem_conflictLinkLayer.mp hp'.1).2
    have hp2card := (mem_conflictLinkLayer.mp hp'.2.1).2
    have hcardIdentity := Finset.card_union_add_card_inter p.1 p.2
    have hIcard : I.card = a + b - r := by dsimp [I]; omega
    have hI : I ∈ (p.1.powersetCard (a + b - r)).filter
        Finset.Nonempty := Finset.mem_filter.mpr
      ⟨Finset.mem_powersetCard.mpr ⟨Finset.inter_subset_left, hIcard⟩,
        Finset.not_disjoint_iff_nonempty_inter.mp hp'.2.2.1⟩
    apply Finset.mem_biUnion.mpr
    refine ⟨p.1, hp'.1, Finset.mem_biUnion.mpr ⟨I, hI, ?_⟩⟩
    exact Finset.mem_image.mpr ⟨p.2,
      Finset.mem_filter.mpr ⟨hp'.2.1, Finset.inter_subset_right⟩, rfl⟩
  calc
    (crossConflictLinkOrderedPairSlice C f g a b r ∅).card ≤ Cover.card :=
      Finset.card_le_card hsub
    _ ≤ ∑ QF ∈ conflictLinkLayer C f a,
        (((QF.powersetCard (a + b - r)).filter Finset.Nonempty).biUnion fun I ↦
          ((conflictLinkLayer C g b).filter (I ⊆ ·)).image
            fun QG ↦ (QF, QG)).card := Finset.card_biUnion_le
    _ ≤ ∑ QF ∈ conflictLinkLayer C f a,
        ∑ I ∈ (QF.powersetCard (a + b - r)).filter Finset.Nonempty,
          (((conflictLinkLayer C g b).filter (I ⊆ ·)).image
            fun QG ↦ (QF, QG)).card := by
      apply Finset.sum_le_sum
      intro QF hQF
      exact Finset.card_biUnion_le
    _ ≤ ∑ QF ∈ conflictLinkLayer C f a,
        ∑ I ∈ (QF.powersetCard (a + b - r)).filter Finset.Nonempty,
          ((conflictLinkLayer C g b).filter (I ⊆ ·)).card := by
      apply Finset.sum_le_sum
      intro QF hQF
      apply Finset.sum_le_sum
      intro I hI
      exact Finset.card_image_le
    _ = _ := by rfl

theorem card_crossPairSlice_empty_le_8Gamma_rpow_of_proper
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (f g : Finset V) (hf : f ∈ H)
    (a b r : ℕ) (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3)
    (hkPos : 1 ≤ a + b - r) (hkProper : a + b - r < b) :
    ((crossConflictLinkOrderedPairSlice C f g a b r ∅).card : ℝ) ≤
      8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
  have hcover := card_crossPairSlice_empty_le_overlapSum C f g a b r
  let IF : Hypergraph V → ConflictSystem V := fun Q ↦
    (Q.powersetCard (a + b - r)).filter Finset.Nonempty
  let scale := Real.rpow d
    ((b : ℝ) - ((a + b - r : ℕ) : ℝ) - eta)
  have hInner : ∀ Q ∈ conflictLinkLayer C f a,
      (∑ I ∈ IF Q, (codegree (conflictLinkLayer C g b) I : ℝ)) ≤
        8 * scale := by
    intro Q hQ
    have hQcard := (mem_conflictLinkLayer.mp hQ).2
    have hIFcard : (IF Q).card ≤ 8 := by
      simpa only [IF] using card_filtered_powersetCard_le_eight
        Q (a + b - r) (by rw [hQcard]; exact (Finset.mem_Icc.mp ha).2)
        Finset.Nonempty
    calc
      (∑ I ∈ IF Q, (codegree (conflictLinkLayer C g b) I : ℝ)) ≤
          ∑ _I ∈ IF Q, scale := by
        apply Finset.sum_le_sum
        intro I hI
        have hIdata := Finset.mem_filter.mp (by simpa only [IF] using hI)
        have hIcard := (Finset.mem_powersetCard.mp hIdata.1).2
        have hIpos : 1 ≤ I.card := Finset.card_pos.mpr hIdata.2
        simpa only [scale, hIcard] using codegree_conflictLinkLayer_le_rpow
          hB hd g b I (Finset.mem_Icc.mp hb).1 (Finset.mem_Icc.mp hb).2
            hIpos (by omega)
      _ = ((IF Q).card : ℝ) * scale := by simp
      _ ≤ 8 * scale := mul_le_mul_of_nonneg_right
        (by exact_mod_cast hIFcard) (Real.rpow_nonneg hd.le _)
  have hA := card_conflictLinkLayer_le_Gamma_mul_rpow hB hd hf
    (Finset.mem_Icc.mp ha).1 (Finset.mem_Icc.mp ha).2
  have hri : r ≤ a + b := by omega
  have hkCast : ((a + b - r : ℕ) : ℝ) =
      (a : ℝ) + (b : ℝ) - (r : ℝ) := by
    rw [Nat.cast_sub hri]
    push_cast
    rfl
  calc
    ((crossConflictLinkOrderedPairSlice C f g a b r ∅).card : ℝ) ≤
        ∑ Q ∈ conflictLinkLayer C f a,
          ∑ I ∈ IF Q,
            (codegree (conflictLinkLayer C g b) I : ℝ) := by
      exact_mod_cast (by simpa only [IF] using hcover)
    _ ≤ ∑ _Q ∈ conflictLinkLayer C f a, 8 * scale := by
      apply Finset.sum_le_sum
      intro Q hQ
      exact hInner Q hQ
    _ = ((conflictLinkLayer C f a).card : ℝ) * (8 * scale) := by simp
    _ ≤ (Gamma * Real.rpow d (a : ℝ)) * (8 * scale) :=
      mul_le_mul_of_nonneg_right hA
        (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
    _ = 8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
      dsimp [scale]
      rw [hkCast]
      calc
        (Gamma * Real.rpow d (a : ℝ)) *
            (8 * Real.rpow d
              ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta)) =
          8 * Gamma * (Real.rpow d (a : ℝ) *
            Real.rpow d
              ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta)) := by ring
        _ = 8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
          congr 2
          calc
            Real.rpow d (a : ℝ) *
                Real.rpow d
                  ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta) =
              Real.rpow d ((a : ℝ) +
                ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta)) :=
                  (Real.rpow_add hd _ _).symm
            _ = Real.rpow d ((r : ℝ) - eta) := by
              congr 1
              ring

theorem card_crossPairSlice_le_swap
    (C : ConflictSystem V) (f g : Finset V) (a b r : ℕ)
    (root : Hypergraph V) :
    (crossConflictLinkOrderedPairSlice C f g a b r root).card ≤
      (crossConflictLinkOrderedPairSlice C g f b a r root).card := by
  apply Finset.card_le_card_of_injOn (fun p ↦ (p.2, p.1))
  · intro p hp
    have hp' := mem_crossConflictLinkOrderedPairSlice.mp hp
    exact mem_crossConflictLinkOrderedPairSlice.mpr
      ⟨hp'.2.1, hp'.1, (fun hd ↦ hp'.2.2.1 hd.symm),
        by simpa [Finset.union_comm] using hp'.2.2.2.1,
        by simpa [Finset.union_comm] using hp'.2.2.2.2⟩
  · intro p hp q hq heq
    exact Prod.ext (congrArg Prod.snd heq) (congrArg Prod.fst heq)

/-- Equal-rank full-overlap representations inject into the common-link
intersection recorded by the certificate. -/
theorem card_crossPairSlice_empty_le_commonLinks
    (C : ConflictSystem V) (f g : Finset V) (a r : ℕ)
    (hr : r = a) :
    (crossConflictLinkOrderedPairSlice C f g a a r ∅).card ≤
      (conflictLinkLayer C f a ∩ conflictLinkLayer C g a).card := by
  apply Finset.card_le_card_of_injOn Prod.fst
  · intro p hp
    have hp' := mem_crossConflictLinkOrderedPairSlice.mp hp
    have hcardUnion := hp'.2.2.2.1
    have hp1card := (mem_conflictLinkLayer.mp hp'.1).2
    have hp2card := (mem_conflictLinkLayer.mp hp'.2.1).2
    have hsub : p.2 ⊆ p.1 := by
      have hUnionEq : p.1 ∪ p.2 = p.1 := by
        exact (Finset.eq_of_subset_of_card_le Finset.subset_union_left
          (by rw [hcardUnion, hr, hp1card])).symm
      intro x hx
      have hxU : x ∈ p.1 ∪ p.2 := Finset.mem_union_right p.1 hx
      rw [hUnionEq] at hxU
      exact hxU
    have heq : p.2 = p.1 := by
      exact Finset.eq_of_subset_of_card_le hsub (by rw [hp1card, hp2card])
    exact Finset.mem_inter.mpr ⟨hp'.1, heq ▸ hp'.2.1⟩
  · intro p hp q hq heq
    have hp' := mem_crossConflictLinkOrderedPairSlice.mp hp
    have hq' := mem_crossConflictLinkOrderedPairSlice.mp hq
    have hpeq : p.2 = p.1 := by
      have hp1card := (mem_conflictLinkLayer.mp hp'.1).2
      have hp2card := (mem_conflictLinkLayer.mp hp'.2.1).2
      have hsub : p.2 ⊆ p.1 := by
        have hUnionEq : p.1 ∪ p.2 = p.1 := by
          exact (Finset.eq_of_subset_of_card_le Finset.subset_union_left
            (by rw [hp'.2.2.2.1, hr, hp1card])).symm
        intro x hx
        have hxU : x ∈ p.1 ∪ p.2 := Finset.mem_union_right p.1 hx
        rw [hUnionEq] at hxU
        exact hxU
      exact Finset.eq_of_subset_of_card_le hsub (by rw [hp1card, hp2card])
    have hqeq : q.2 = q.1 := by
      have hq1card := (mem_conflictLinkLayer.mp hq'.1).2
      have hq2card := (mem_conflictLinkLayer.mp hq'.2.1).2
      have hsub : q.2 ⊆ q.1 := by
        have hUnionEq : q.1 ∪ q.2 = q.1 := by
          exact (Finset.eq_of_subset_of_card_le Finset.subset_union_left
            (by rw [hq'.2.2.2.1, hr, hq1card])).symm
        intro x hx
        have hxU : x ∈ q.1 ∪ q.2 := Finset.mem_union_right q.1 hx
        rw [hUnionEq] at hxU
        exact hxU
      exact Finset.eq_of_subset_of_card_le hsub (by rw [hq1card, hq2card])
    exact Prod.ext heq (hpeq.trans (heq.trans hqeq.symm))

theorem card_crossPairSlice_empty_le_8Gamma_add_one_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d)
    (f g : Finset V) (hf : f ∈ H) (hg : g ∈ H)
    (a b r : ℕ) (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3)
    (hcommon : ((conflictLinkLayer C f a ∩
        conflictLinkLayer C g a).card : ℝ) ≤
      Real.rpow d ((a : ℝ) - eta)) :
    ((crossConflictLinkOrderedPairSlice C f g a b r ∅).card : ℝ) ≤
      8 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
  have hGamma := regularizedBounded_Gamma_nonneg hB hd
  by_cases hempty : crossConflictLinkOrderedPairSlice C f g a b r ∅ = ∅
  · rw [hempty, Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (by linarith)) (Real.rpow_nonneg hd.le _)
  · obtain ⟨p, hp⟩ := Finset.nonempty_iff_ne_empty.mpr hempty
    have hp' := mem_crossConflictLinkOrderedPairSlice.mp hp
    have hp1card := (mem_conflictLinkLayer.mp hp'.1).2
    have hp2card := (mem_conflictLinkLayer.mp hp'.2.1).2
    have hcardIdentity := Finset.card_union_add_card_inter p.1 p.2
    let k := a + b - r
    have hk : (p.1 ∩ p.2).card = k := by dsimp [k]; omega
    have hkPos : 1 ≤ k := by
      rw [← hk]
      exact Finset.card_pos.mpr
        (Finset.not_disjoint_iff_nonempty_inter.mp hp'.2.2.1)
    have hka : k ≤ a := by
      rw [← hk, ← hp1card]
      exact Finset.card_le_card Finset.inter_subset_left
    have hkb : k ≤ b := by
      rw [← hk, ← hp2card]
      exact Finset.card_le_card Finset.inter_subset_right
    by_cases hkbProper : k < b
    · have hproper := card_crossPairSlice_empty_le_8Gamma_rpow_of_proper
        hB hd hd1 f g hf a b r ha hb hkPos hkbProper
      apply hproper.trans
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hd.le _)
      nlinarith
    · have hkbEq : k = b := by omega
      by_cases hba : b < a
      · have hswap := card_crossPairSlice_le_swap C f g a b r ∅
        have hkPosSwap : 1 ≤ b + a - r := by
          dsimp only [k] at hkPos
          omega
        have hproperSwap := card_crossPairSlice_empty_le_8Gamma_rpow_of_proper
          hB hd hd1 g f hg b a r hb ha hkPosSwap (by omega)
        calc
          ((crossConflictLinkOrderedPairSlice C f g a b r ∅).card : ℝ) ≤
              ((crossConflictLinkOrderedPairSlice C g f b a r ∅).card : ℝ) :=
            by exact_mod_cast hswap
          _ ≤ 8 * Gamma * Real.rpow d ((r : ℝ) - eta) := hproperSwap
          _ ≤ 8 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
            apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hd.le _)
            nlinarith
      · have hab : a = b := by omega
        cases hab
        have hkr : r = a := by dsimp [k] at hk hkbEq ⊢; omega
        have hcard := card_crossPairSlice_empty_le_commonLinks C f g a r hkr
        calc
          ((crossConflictLinkOrderedPairSlice C f g a a r ∅).card : ℝ) ≤
              ((conflictLinkLayer C f a ∩
                conflictLinkLayer C g a).card : ℝ) := by exact_mod_cast hcard
          _ ≤ Real.rpow d ((a : ℝ) - eta) := hcommon
          _ = Real.rpow d ((r : ℝ) - eta) := by rw [hkr]
          _ ≤ 8 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
            have hfactor : 1 ≤ 8 * (Gamma + 1) := by nlinarith
            calc
              Real.rpow d ((r : ℝ) - eta) =
                  1 * Real.rpow d ((r : ℝ) - eta) := (one_mul _).symm
              _ ≤ 8 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) :=
                mul_le_mul_of_nonneg_right hfactor
                  (Real.rpow_nonneg hd.le _)

theorem card_rerootedTestConflictUnionLayer_le_24Gamma_add_one_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hd : 0 < d) (hd1 : 1 ≤ d)
    (f g : Finset V) (hf : f ∈ H) (hg : g ∈ H)
    (a r : ℕ) (ha : a ∈ Finset.Icc 1 3)
    (hcommon : ((conflictLinkLayer C f a ∩
        conflictLinkLayer C g a).card : ℝ) ≤
      Real.rpow d ((a : ℝ) - eta)) :
    ((testConflictUnionLayer (conflictLinkLayer C f a) C g r).card : ℝ) ≤
      24 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
  have hcover := codegree_testConflictUnionLayer_le_crossPairSlices
    C hCcard f g a r ∅
  rw [codegree_empty] at hcover
  calc
    ((testConflictUnionLayer (conflictLinkLayer C f a) C g r).card : ℝ) ≤
      ∑ b ∈ Finset.Icc 1 3,
        ((crossConflictLinkOrderedPairSlice C f g a b r ∅).card : ℝ) := by
          exact_mod_cast hcover
    _ ≤ ∑ _b ∈ Finset.Icc 1 3,
        8 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
      apply Finset.sum_le_sum
      intro b hb
      exact card_crossPairSlice_empty_le_8Gamma_add_one_rpow
        hB hd hd1 f g hf hg a b r ha hb hcommon
    _ = 24 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
      norm_num [Finset.sum_Icc_succ_top]
      ring

/-- Full static spread, with `commonLinks` exposed exactly as the existing
certificate field needed only at the equal-link empty-root boundary. -/
theorem rerootedTestConflictUnionLayer_isRealSpread
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f g : Finset V) (hf : f ∈ H) (hg : g ∈ H)
    (a r : ℕ) (ha : a ∈ Finset.Icc 1 3) (hr5 : r ≤ 5)
    (hcommon : ((conflictLinkLayer C f a ∩
        conflictLinkLayer C g a).card : ℝ) ≤
      Real.rpow d ((a : ℝ) - eta)) :
    IsRealSpread
      (testConflictUnionLayer (conflictLinkLayer C f a) C g r) r
      (768 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) d⁻¹ := by
  refine ⟨testConflictUnionLayer_uniform (conflictLinkLayer C f a) C g r, ?_⟩
  intro root hrootLt
  have hGamma := regularizedBounded_Gamma_nonneg hB hd
  have hinvPow : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg hd.le _).symm
  have hrpowSplit : Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
      Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card := by
    rw [hinvPow]
    calc
      Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
          Real.rpow d (((r : ℝ) - eta) + (-(root.card : ℝ))) := by
        congr 1
        ring
      _ = Real.rpow d ((r : ℝ) - eta) *
          Real.rpow d (-(root.card : ℝ)) := Real.rpow_add hd _ _
  by_cases hrootZero : root.card = 0
  · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
    subst root
    have hcard := card_rerootedTestConflictUnionLayer_le_24Gamma_add_one_rpow
      hB hCcard hd hd1 f g hf hg a r ha hcommon
    rw [codegree_empty]
    calc
      ((testConflictUnionLayer (conflictLinkLayer C f a) C g r).card : ℝ) ≤
          24 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := hcard
      _ ≤ 768 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
        apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hd.le _)
        nlinarith
      _ = (768 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) *
          d⁻¹ ^ (∅ : Hypergraph V).card := by simp
  · have hrootPos : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
    have hrootBound := codegree_rerootedTestConflictUnionLayer_le_768_rpow
      hB hCcard hd hd1 heta f g a r root ha hr5 hrootPos hrootLt
    calc
      (codegree
          (testConflictUnionLayer (conflictLinkLayer C f a) C g r)
          root : ℝ) ≤
        768 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := hrootBound
      _ = (768 * Real.rpow d ((r : ℝ) - eta)) * d⁻¹ ^ root.card := by
        rw [hrpowSplit]
        ring
      _ ≤ (768 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) *
          d⁻¹ ^ root.card := by
        apply mul_le_mul_of_nonneg_right _ (pow_nonneg (inv_nonneg.mpr hd.le) _)
        apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hd.le _)
        nlinarith

theorem RegularizationCertificate.commonLinks_natRank
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {j : ι → ℕ} {w : ι → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell j w)
    {f g : Finset V} (hf : f ∈ H) (hg : g ∈ H)
    (hfg : Disjoint f g)
    (hpair : {f, g} ∉ conflictLayer R.regularized 2)
    (a : ℕ) (ha : a ∈ Finset.Icc 1 3) :
    (((conflictLinkLayer R.regularized f a) ∩
      conflictLinkLayer R.regularized g a).card : ℝ) ≤
        Real.rpow d ((a : ℝ) - eps / 4) := by
  have ha1 := (Finset.mem_Icc.mp ha).1
  have ha3 := (Finset.mem_Icc.mp ha).2
  interval_cases a
  · simpa using R.commonLinks f hf g hg hfg hpair (0 : Fin 3)
  · simpa using R.commonLinks f hf g hg hfg hpair (1 : Fin 3)
  · simpa using R.commonLinks f hf g hg hfg hpair (2 : Fin 3)

/-- Certificate-local static spread for the internal rerooted CC family.
No public assumption is added: `bounded.conflict_card` supplies the rank
specialization and `commonLinks` supplies the unique equal-link boundary. -/
theorem RegularizationCertificate.rerootedTestConflictUnionLayer_isRealSpread
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {j : ι → ℕ} {w : ι → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell j w)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heps : 0 ≤ eps)
    {f g : Finset V} (hf : f ∈ H) (hg : g ∈ H)
    (hfg : Disjoint f g)
    (hpair : {f, g} ∉ conflictLayer R.regularized 2)
    (a r : ℕ) (ha : a ∈ Finset.Icc 1 3) (hr5 : r ≤ 5) :
    IsRealSpread
      (testConflictUnionLayer
        (conflictLinkLayer R.regularized f a) R.regularized g r) r
      (768 * (3 * Gamma + 1) *
        Real.rpow d ((r : ℝ) - eps / 4)) d⁻¹ := by
  exact Erdos136.rerootedTestConflictUnionLayer_isRealSpread
    R.bounded (fun c hc ↦ R.bounded.conflict_card hc)
      hd hd1 (by positivity) f g hf hg a r ha hr5
      (Erdos136.RegularizationCertificate.commonLinks_natRank
        R hf hg hfg hpair a ha)

variable {ι α : Type*} [DecidableEq ι] [DecidableEq α]

/-! ## Sharp source-faithful test transition and collision bounds -/

theorem card_inter_available_le_of_selected_card
    (S A M : Hypergraph V) (j r : ℕ)
    (hS : S.card = j) (hAM : Disjoint A M)
    (hM : (S ∩ M).card = j - r) :
    (S ∩ A).card ≤ r := by
  have hdisj : Disjoint (S ∩ A) (S ∩ M) :=
    hAM.mono Finset.inter_subset_right Finset.inter_subset_right
  have hsub : (S ∩ A) ∪ (S ∩ M) ⊆ S := by
    intro e he
    rcases Finset.mem_union.mp he with he | he
    · exact Finset.inter_subset_left he
    · exact Finset.inter_subset_left he
  have hcard := Finset.card_le_card hsub
  rw [Finset.card_union_of_disjoint hdisj, hS, hM] at hcard
  omega

theorem partialTestGainChoice_mem_source_succ
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j)
    {e : Finset V} (he : e ∈ partialTestGainChoiceSet H C M j s S) :
    partialTestCondition (availableEdges H C M) M j (s + 1) S ∧
      e ∈ S ∩ availableEdges H C M := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  have hedata := Finset.mem_filter.mp he
  have heA : e ∈ A := hedata.1
  have hnotold := hedata.2.1
  have hnew := hedata.2.2
  have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hAM : Disjoint A M := availableEdges_disjoint_selected H C M
  have hA'A : A' ⊆ A := availableEdges_insert_subset H C M e
  have heM : e ∉ M := (mem_availableEdges.mp heA).2.1
  have heA' : e ∉ A' := by
    intro he'
    exact (mem_availableEdges.mp he').2.1 (Finset.mem_insert_self e M)
  have heS : e ∈ S := by
    by_contra heS
    have hMint : S ∩ insert e M = S ∩ M := by
      ext f
      simp only [Finset.mem_inter, Finset.mem_insert]
      constructor
      · rintro ⟨hfS, rfl | hfM⟩
        · exact (heS hfS).elim
        · exact ⟨hfS, hfM⟩
      · rintro ⟨hfS, hfM⟩
        exact ⟨hfS, Or.inr hfM⟩
    have hMcard : (S ∩ M).card = j - s := by
      rw [← hMint]
      exact hnew.2
    have hAle : (S ∩ A).card ≤ s :=
      card_inter_available_le_of_selected_card S A M j s hScard hAM hMcard
    have hnewle : (S ∩ A').card ≤ (S ∩ A).card := by
      apply Finset.card_le_card
      intro f hf
      exact Finset.mem_inter.mpr
        ⟨(Finset.mem_inter.mp hf).1, hA'A (Finset.mem_inter.mp hf).2⟩
    have hnewA : (S ∩ A').card = s := hnew.1
    have hAcard : (S ∩ A).card = s := by omega
    exact hnotold ⟨hAcard, hMcard⟩
  have hMInsert : S ∩ insert e M = insert e (S ∩ M) := by
    ext f
    simp only [Finset.mem_inter, Finset.mem_insert]
    constructor
    · rintro ⟨hfS, rfl | hfM⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨hfS, hfM⟩
    · rintro (rfl | ⟨hfS, hfM⟩)
      · exact ⟨heS, Or.inl rfl⟩
      · exact ⟨hfS, Or.inr hfM⟩
  have heSM : e ∉ S ∩ M := by simp [heM]
  have hMplus : (S ∩ insert e M).card = (S ∩ M).card + 1 := by
    rw [hMInsert, Finset.card_insert_of_notMem heSM]
  have hMrelation : (S ∩ M).card + 1 = j - s := by
    rw [← hMplus]
    exact hnew.2
  have hslt : s < j := by
    omega
  have hMcard : (S ∩ M).card = j - (s + 1) := by
    omega
  have heSA : e ∈ S ∩ A := Finset.mem_inter.mpr ⟨heS, heA⟩
  have heSA' : e ∉ S ∩ A' := by simp [heA']
  have hsub : S ∩ A' ⊆ (S ∩ A).erase e := by
    intro f hf
    apply Finset.mem_erase.mpr
    refine ⟨?_, Finset.mem_inter.mpr
      ⟨(Finset.mem_inter.mp hf).1, hA'A (Finset.mem_inter.mp hf).2⟩⟩
    intro hfe
    subst f
    exact heSA' hf
  have hnewle : (S ∩ A').card + 1 ≤ (S ∩ A).card := by
    have hc := Finset.card_le_card hsub
    calc
      (S ∩ A').card + 1 ≤ ((S ∩ A).erase e).card + 1 :=
        Nat.add_le_add_right hc 1
      _ = (S ∩ A).card := Finset.card_erase_add_one heSA
  have hAle : (S ∩ A).card ≤ s + 1 :=
    card_inter_available_le_of_selected_card S A M j (s + 1)
      hScard hAM hMcard
  have hnewA : (S ∩ A').card = s := hnew.1
  have hAcard : (S ∩ A).card = s + 1 := by omega
  exact ⟨⟨hAcard, hMcard⟩, heSA⟩

theorem partialTestGainChoiceSet_card_le_source_succ
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j) :
    (partialTestGainChoiceSet H C M j s S).card ≤
      if partialTestCondition (availableEdges H C M) M j (s + 1) S
      then s + 1 else 0 := by
  by_cases hsource : partialTestCondition
      (availableEdges H C M) M j (s + 1) S
  · simp only [hsource, if_true]
    apply (Finset.card_le_card ?_).trans_eq hsource.1
    intro e he
    exact (partialTestGainChoice_mem_source_succ H C M j s S hS he).2
  · simp only [hsource, if_false, nonpos_iff_eq_zero]
    rw [Finset.card_eq_zero]
    apply Finset.not_nonempty_iff_eq_empty.mp
    intro hne
    obtain ⟨e, he⟩ := hne
    exact hsource
      (partialTestGainChoice_mem_source_succ H C M j s S hS he).1

theorem weightedPartialTestGainChoices_le_succ_mul_observable
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    weightedPartialTestGainChoices w H C M j s ≤
      (s + 1 : ℕ) * partialTestObservable w H C j (s + 1) M := by
  unfold weightedPartialTestGainChoices partialTestObservable partialTestTotal
  rw [Finset.mul_sum]
  rw [Finset.sum_filter]
  apply Finset.sum_le_sum
  intro S hS
  have hc := partialTestGainChoiceSet_card_le_source_succ H C M j s S hS
  by_cases hsource : partialTestCondition
      (availableEdges H C M) M j (s + 1) S
  · simp only [partialTestCondition] at hsource
    simp only [Nat.cast_add, Nat.cast_one, ge_iff_le] at hc ⊢
    have hcr : ((partialTestGainChoiceSet H C M j s S).card : ℝ) ≤
        (s + 1 : ℕ) := by exact_mod_cast hc
    calc
      w S * ((partialTestGainChoiceSet H C M j s S).card : ℝ) ≤
          w S * (s + 1 : ℕ) :=
        mul_le_mul_of_nonneg_left hcr (hw S)
      _ = ((s : ℝ) + 1) * w S := by
        rw [Nat.cast_add, Nat.cast_one]
        ring
  · simp only [partialTestCondition] at hsource
    simp [partialTestCondition, hsource] at hc ⊢
    have hz : (partialTestGainChoiceSet H C M j s S).card = 0 := by
      rw [Finset.card_eq_zero]
      apply Finset.not_nonempty_iff_eq_empty.mp
      intro hne
      obtain ⟨e, he⟩ := hne
      exact hsource
        (partialTestGainChoice_mem_source_succ H C M j s S hS he).1
    simp [hz]

theorem partialTestLossChoice_mem_has_blocked_member
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j)
    {e : Finset V} (he : e ∈ partialTestLossChoiceSet H C M j s S) :
    ∃ f ∈ S ∩ availableEdges H C M,
      e ∈ availableBlockerChoices H C M f := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  have hedata := Finset.mem_filter.mp he
  have heA : e ∈ A := hedata.1
  have hold := hedata.2.1
  have hnotnew := hedata.2.2
  have hblock : ∃ f ∈ S ∩ A, f ∉ A' := by
    by_contra hnone
    push_neg at hnone
    have hSAeq : S ∩ A' = S ∩ A := by
      apply Finset.Subset.antisymm
      · intro f hf
        exact Finset.mem_inter.mpr ⟨(Finset.mem_inter.mp hf).1,
          availableEdges_insert_subset H C M e (Finset.mem_inter.mp hf).2⟩
      · intro f hf
        exact Finset.mem_inter.mpr ⟨(Finset.mem_inter.mp hf).1,
          hnone f hf⟩
    have heS : e ∉ S := by
      intro heS
      have heSA : e ∈ S ∩ A := Finset.mem_inter.mpr ⟨heS, heA⟩
      have := hnone e heSA
      exact (mem_availableEdges.mp this).2.1 (Finset.mem_insert_self e M)
    have hSMinsert : S ∩ insert e M = S ∩ M := by
      ext f
      simp only [Finset.mem_inter, Finset.mem_insert]
      constructor
      · rintro ⟨hfS, rfl | hfM⟩
        · exact (heS hfS).elim
        · exact ⟨hfS, hfM⟩
      · rintro ⟨hfS, hfM⟩
        exact ⟨hfS, Or.inr hfM⟩
    apply hnotnew
    constructor
    · rw [hSAeq]
      exact hold.1
    · rw [hSMinsert]
      exact hold.2
  obtain ⟨f, hfSA, hfA'⟩ := hblock
  refine ⟨f, hfSA, ?_⟩
  have hfA := (Finset.mem_inter.mp hfSA).2
  have hfDel : f ∈ A \ availableEdges H C (insert e M) :=
    Finset.mem_sdiff.mpr ⟨hfA, hfA'⟩
  have heDel : e ∈ A \ availableEdges H C (insert f M) :=
    (mem_availableDeletionChoices_comm H C M heA hfA).mp hfDel
  have heB : e ∈ availableBlockerChoices H C M f := by
    by_contra heNotB
    have heStill : e ∈ availableEdges H C (insert f M) := by
      rw [availableEdges_insert_eq_sdiff_blockers]
      exact Finset.mem_sdiff.mpr ⟨heA, heNotB⟩
    exact (Finset.mem_sdiff.mp heDel).2 heStill
  exact heB

theorem partialTestLossChoiceSet_subset_biUnion_blockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j) :
    partialTestLossChoiceSet H C M j s S ⊆
      (S ∩ availableEdges H C M).biUnion
        (availableBlockerChoices H C M) := by
  intro e he
  obtain ⟨f, hf, hef⟩ :=
    partialTestLossChoice_mem_has_blocked_member H C M j s S hS he
  exact Finset.mem_biUnion.mpr ⟨f, hf, hef⟩

theorem availableBlockerChoices_eq_meeting_union_conflict
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    (hfne : f.Nonempty) :
    availableBlockerChoices H C M f =
      CFMRegularization.availableMeetingChoices
          (availableEdges H C M) f ∪
        conflictBlockerChoices C M (availableEdges H C M) f := by
  ext e
  constructor
  · intro he
    have he' := Finset.mem_filter.mp he
    by_cases hdisj : Disjoint e f
    · apply Finset.mem_union.mpr
      apply Or.inr
      apply Finset.mem_filter.mpr
      refine ⟨he'.1, hdisj, ?_⟩
      intro hfree
      apply he'.2.resolve_left
      · intro hef
        subst e
        exact hfne.ne_empty (disjoint_self.mp hdisj)
      · have heAvail := mem_availableEdges.mp he'.1
        have hfAvail := mem_availableEdges.mp hf
        have hmatch : IsMatching H (insert f (insert e M)) := by
          rw [isMatching_insert_iff]
          refine ⟨hfAvail.1, heAvail.2.2.1, ?_⟩
          intro g hg hfg
          rcases Finset.mem_insert.mp hg with rfl | hgM
          · exact hdisj.symm
          · exact hfAvail.2.2.1.2
              (Finset.mem_insert_self f M)
              (Finset.mem_insert_of_mem hgM) hfg.symm
        simpa [Finset.insert_comm e f] using
          (show IsConflictFreeMatching H C (insert f (insert e M))
            from ⟨hmatch, hfree⟩)
    · apply Finset.mem_union.mpr
      apply Or.inl
      exact Finset.mem_filter.mpr ⟨he'.1, hdisj⟩
  · intro he
    rcases Finset.mem_union.mp he with hmeet | hconf
    · have hmeet' := Finset.mem_filter.mp hmeet
      apply Finset.mem_filter.mpr
      refine ⟨hmeet'.1, ?_⟩
      by_cases hef : e = f
      · exact Or.inl hef
      · apply Or.inr
        intro hadm
        have hpair := hadm.1.2
        have hdisj := hpair (Finset.mem_insert_self e (insert f M))
          (Finset.mem_insert_of_mem (Finset.mem_insert_self f M)) hef
        exact hmeet'.2 hdisj
    · have hconf' := Finset.mem_filter.mp hconf
      apply Finset.mem_filter.mpr
      refine ⟨hconf'.1, Or.inr ?_⟩
      intro hadm
      exact hconf'.2.2 (by
        simpa [Finset.insert_comm e f] using hadm.2)

theorem disjoint_availableMeetingChoices_conflictBlockerChoices
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) :
    Disjoint
      (CFMRegularization.availableMeetingChoices
        (availableEdges H C M) f)
      (conflictBlockerChoices C M (availableEdges H C M) f) := by
  rw [Finset.disjoint_left]
  intro e hmeet hconf
  exact (Finset.mem_filter.mp hmeet).2 (Finset.mem_filter.mp hconf).2.1

/-- Two distinct members of a matching have at most the sum of the host
pair-codegrees many common meeting blockers. -/
theorem card_inter_availableMeetingChoices_le_sum_codegrees
    (A : Hypergraph V) (f g : Finset V) :
    ((CFMRegularization.availableMeetingChoices A f) ∩
      CFMRegularization.availableMeetingChoices A g).card ≤
      ∑ x ∈ f, ∑ y ∈ g, codegree A {x, y} := by
  let F : V → V → Hypergraph V := fun x y ↦
    A.filter fun e ↦ {x, y} ⊆ e
  have hsub :
      (CFMRegularization.availableMeetingChoices A f) ∩
          CFMRegularization.availableMeetingChoices A g ⊆
        f.biUnion fun x ↦ g.biUnion fun y ↦ F x y := by
    intro e he
    have he' := Finset.mem_inter.mp he
    have hef := Finset.mem_filter.mp he'.1
    have heg := Finset.mem_filter.mp he'.2
    obtain ⟨x, hxe, hxf⟩ := Finset.not_disjoint_iff.mp hef.2
    obtain ⟨y, hye, hyg⟩ := Finset.not_disjoint_iff.mp heg.2
    apply Finset.mem_biUnion.mpr
    refine ⟨x, hxf, Finset.mem_biUnion.mpr ⟨y, hyg, ?_⟩⟩
    apply Finset.mem_filter.mpr
    simp only [Finset.insert_subset_iff, Finset.singleton_subset_iff]
    exact ⟨hef.1, hxe, hye⟩
  calc
    ((CFMRegularization.availableMeetingChoices A f) ∩
        CFMRegularization.availableMeetingChoices A g).card ≤
        (f.biUnion fun x ↦ g.biUnion fun y ↦ F x y).card :=
      Finset.card_le_card hsub
    _ ≤ ∑ x ∈ f, (g.biUnion fun y ↦ F x y).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ x ∈ f, ∑ y ∈ g, (F x y).card := by
      apply Finset.sum_le_sum
      intro x hx
      exact Finset.card_biUnion_le
    _ = ∑ x ∈ f, ∑ y ∈ g, codegree A {x, y} := by rfl

theorem card_inter_availableMeetingChoices_le_card_mul_card_mul
    (A : Hypergraph V) {f g : Finset V} (hfg : Disjoint f g)
    {codegreeHi : ℕ}
    (hcodegree : ∀ root, root.card = 2 →
      codegree A root ≤ codegreeHi) :
    ((CFMRegularization.availableMeetingChoices A f) ∩
      CFMRegularization.availableMeetingChoices A g).card ≤
      f.card * g.card * codegreeHi := by
  apply (card_inter_availableMeetingChoices_le_sum_codegrees A f g).trans
  calc
    ∑ x ∈ f, ∑ y ∈ g, codegree A {x, y} ≤
        ∑ _x ∈ f, ∑ _y ∈ g, codegreeHi := by
      apply Finset.sum_le_sum
      intro x hx
      apply Finset.sum_le_sum
      intro y hy
      apply hcodegree
      have hxy : x ≠ y := by
        intro hxy
        subst y
        exact (Finset.disjoint_left.mp hfg) hx hy
      simp [hxy]
    _ = f.card * g.card * codegreeHi := by simp [Nat.mul_assoc]

/-- A meeting/conflict common blocker is charged to the source local-link
family through one vertex of the met edge.  This is the exact mixed term
in the four-part blocker-overlap decomposition. -/
theorem card_inter_meeting_conflictBlockers_le_C4_add_local
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (f : Finset V) {g : Finset V}
    (hg : g ∈ availableEdges H C M) :
    ((CFMRegularization.availableMeetingChoices
        (availableEdges H C M) f) ∩
      conflictBlockerChoices C M (availableEdges H C M) g).card ≤
      ∑ v ∈ f,
        (CFMRegularization.conditionC4Count H C g v +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M g 2 1 v).card +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M g 3 1 v).card) := by
  let A := availableEdges H C M
  let F : V → Hypergraph V := fun v ↦
    (activeConflictBlockers C A M g).filter fun e ↦ e ∈ A ∧ v ∈ e
  have hsub :
      (CFMRegularization.availableMeetingChoices A f) ∩
          conflictBlockerChoices C M A g ⊆ f.biUnion F := by
    intro e he
    have he' := Finset.mem_inter.mp he
    have hemeet := Finset.mem_filter.mp he'.1
    obtain ⟨v, hve, hvf⟩ := Finset.not_disjoint_iff.mp hemeet.2
    have heconf := Finset.mem_filter.mp he'.2
    have heactive : e ∈ activeConflictBlockers C A M g :=
      conflictBlockerChoices_subset_activeConflictBlockers hCcard hg he'.2
    exact Finset.mem_biUnion.mpr
      ⟨v, hvf, Finset.mem_filter.mpr
        ⟨heactive, heconf.1, hve⟩⟩
  calc
    ((CFMRegularization.availableMeetingChoices A f) ∩
        conflictBlockerChoices C M A g).card ≤
        (f.biUnion F).card := Finset.card_le_card hsub
    _ ≤ ∑ v ∈ f, (F v).card := Finset.card_biUnion_le
    _ ≤ ∑ v ∈ f,
        (CFMRegularization.conditionC4Count H C g v +
          (localConflictLinkPartialAtVertex C A M g 2 1 v).card +
          (localConflictLinkPartialAtVertex C A M g 3 1 v).card) := by
      apply Finset.sum_le_sum
      intro v hv
      exact card_activeConflictBlockers_available_through_le_C4_add_local
        (availableEdges_subset H C M) v

theorem card_availableBlockerChoices_eq_meeting_add_openConflictCount
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    (hfne : f.Nonempty) :
    (availableBlockerChoices H C M f).card =
      (CFMRegularization.availableMeetingChoices
        (availableEdges H C M) f).card +
      openConflictCount C (availableEdges H C M) M f := by
  rw [availableBlockerChoices_eq_meeting_union_conflict hf hfne,
    Finset.card_union_of_disjoint
      (disjoint_availableMeetingChoices_conflictBlockerChoices H C M f),
    openConflictCount,
    ← conflictBlockerChoices_eq_active_available_disjoint hCcard hf]

/-- The common-blocker defect splits into the four source interaction
types: meeting/meeting, meeting/conflict, conflict/meeting, and
conflict/conflict.  Later Def. 6.1 adapters bound the last three terms. -/
theorem card_inter_availableBlockerChoices_le_four_parts
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f g : Finset V} (hf : f ∈ availableEdges H C M) (hfne : f.Nonempty)
    (hg : g ∈ availableEdges H C M) (hgne : g.Nonempty) :
    (availableBlockerChoices H C M f ∩
        availableBlockerChoices H C M g).card ≤
      ((CFMRegularization.availableMeetingChoices
          (availableEdges H C M) f) ∩
        CFMRegularization.availableMeetingChoices
          (availableEdges H C M) g).card +
      ((CFMRegularization.availableMeetingChoices
          (availableEdges H C M) f) ∩
        conflictBlockerChoices C M (availableEdges H C M) g).card +
      ((conflictBlockerChoices C M (availableEdges H C M) f) ∩
        CFMRegularization.availableMeetingChoices
          (availableEdges H C M) g).card +
      ((conflictBlockerChoices C M (availableEdges H C M) f) ∩
        conflictBlockerChoices C M (availableEdges H C M) g).card := by
  let Mf := CFMRegularization.availableMeetingChoices
    (availableEdges H C M) f
  let Mg := CFMRegularization.availableMeetingChoices
    (availableEdges H C M) g
  let Cf := conflictBlockerChoices C M (availableEdges H C M) f
  let Cg := conflictBlockerChoices C M (availableEdges H C M) g
  have heqf : availableBlockerChoices H C M f = Mf ∪ Cf := by
    simpa only [Mf, Cf] using
      availableBlockerChoices_eq_meeting_union_conflict hf hfne
  have heqg : availableBlockerChoices H C M g = Mg ∪ Cg := by
    simpa only [Mg, Cg] using
      availableBlockerChoices_eq_meeting_union_conflict hg hgne
  have hsub : (Mf ∪ Cf) ∩ (Mg ∪ Cg) ⊆
      (Mf ∩ Mg) ∪ (Mf ∩ Cg) ∪ (Cf ∩ Mg) ∪ (Cf ∩ Cg) := by
    intro e he
    have he' := Finset.mem_inter.mp he
    rcases Finset.mem_union.mp he'.1 with hef | hef <;>
      rcases Finset.mem_union.mp he'.2 with heg | heg
    · exact Finset.mem_union.mpr (Or.inl
        (Finset.mem_union.mpr (Or.inl
          (Finset.mem_union.mpr (Or.inl (Finset.mem_inter.mpr ⟨hef, heg⟩))))))
    · exact Finset.mem_union.mpr (Or.inl
        (Finset.mem_union.mpr (Or.inl
          (Finset.mem_union.mpr (Or.inr (Finset.mem_inter.mpr ⟨hef, heg⟩))))))
    · exact Finset.mem_union.mpr (Or.inl
        (Finset.mem_union.mpr (Or.inr (Finset.mem_inter.mpr ⟨hef, heg⟩))))
    · exact Finset.mem_union.mpr (Or.inr (Finset.mem_inter.mpr ⟨hef, heg⟩))
  rw [heqf, heqg]
  apply (Finset.card_le_card hsub).trans
  have hAB := Finset.card_union_le (Mf ∩ Mg) (Mf ∩ Cg)
  have hABC := Finset.card_union_le ((Mf ∩ Mg) ∪ (Mf ∩ Cg))
    (Cf ∩ Mg)
  calc
    ((Mf ∩ Mg) ∪ (Mf ∩ Cg) ∪ (Cf ∩ Mg) ∪
        (Cf ∩ Cg)).card ≤
        (((Mf ∩ Mg) ∪ (Mf ∩ Cg) ∪ (Cf ∩ Mg)).card +
          (Cf ∩ Cg).card) := Finset.card_union_le _ _
    _ ≤ ((((Mf ∩ Mg) ∪ (Mf ∩ Cg)).card +
          (Cf ∩ Mg).card) + (Cf ∩ Cg).card) := by
      exact Nat.add_le_add_right hABC _
    _ ≤ (((Mf ∩ Mg).card + (Mf ∩ Cg).card) +
          (Cf ∩ Mg).card + (Cf ∩ Cg).card) := by
      exact Nat.add_le_add_right (Nat.add_le_add_right hAB _) _
    _ = (Mf ∩ Mg).card + (Mf ∩ Cg).card +
          (Cf ∩ Mg).card + (Cf ∩ Cg).card := by omega

/-- Bonferroni gives the sharp `8 dHat` matching-blocker center; the only
loss is the 28 unordered pairs of vertices of the selected host edge. -/
theorem availableMeetingChoices_bounds_eight
    {H A : Hypergraph V} (hH8 : IsUniform H 8) {f : Finset V}
    (hfA : f ∈ A) (hAH : A ⊆ H) {degreeLo degreeHi codegreeHi : ℝ}
    (hdegree : ∀ v ∈ f,
      degreeLo ≤ (degree A v : ℝ) ∧ (degree A v : ℝ) ≤ degreeHi)
    (hcodegree : ∀ root, root.card = 2 →
      (codegree A root : ℝ) ≤ codegreeHi) :
    8 * degreeLo - 28 * codegreeHi ≤
        ((CFMRegularization.availableMeetingChoices A f).card : ℝ) ∧
      ((CFMRegularization.availableMeetingChoices A f).card : ℝ) ≤
        8 * degreeHi := by
  let F : V → Hypergraph V := fun v ↦ A.filter (v ∈ ·)
  have hf8 : f.card = 8 := hH8 f (hAH hfA)
  have hUnion : f.biUnion F =
      CFMRegularization.availableMeetingChoices A f := by
    ext e
    constructor
    · intro he
      obtain ⟨v, hvf, hve⟩ := Finset.mem_biUnion.mp he
      have hve' := Finset.mem_filter.mp hve
      apply Finset.mem_filter.mpr
      exact ⟨hve'.1, Finset.not_disjoint_iff.mpr ⟨v, hve'.2, hvf⟩⟩
    · intro he
      have he' := Finset.mem_filter.mp he
      obtain ⟨v, hve, hvf⟩ := Finset.not_disjoint_iff.mp he'.2
      exact Finset.mem_biUnion.mpr
        ⟨v, hvf, Finset.mem_filter.mpr ⟨he'.1, hve⟩⟩
  have hpair : ∀ x ∈ f, ∀ y ∈ f, x ≠ y →
      (F x ∩ F y).card ≤ Nat.floor codegreeHi := by
    intro x hx y hy hxy
    have hsub : F x ∩ F y ⊆ A.filter (fun e ↦ {x, y} ⊆ e) := by
      intro e he
      have he' := Finset.mem_inter.mp he
      have hex := Finset.mem_filter.mp he'.1
      have hey := Finset.mem_filter.mp he'.2
      apply Finset.mem_filter.mpr
      simp only [Finset.insert_subset_iff, Finset.singleton_subset_iff]
      exact ⟨hex.1, hex.2, hey.2⟩
    have hnat : (F x ∩ F y).card ≤ codegree A {x, y} :=
      Finset.card_le_card hsub
    have hpaircard : ({x, y} : Finset V).card = 2 := by simp [hxy]
    have hreal := hcodegree {x, y} hpaircard
    exact hnat.trans (Nat.le_floor hreal)
  have hbonf := sum_card_le_card_biUnion_add_choose_two_mul
    f F (Nat.floor codegreeHi) hpair
  have hbonfR :
      (∑ v ∈ f, (degree A v : ℝ)) ≤
        ((CFMRegularization.availableMeetingChoices A f).card : ℝ) +
          28 * (Nat.floor codegreeHi : ℝ) := by
    rw [hUnion, hf8] at hbonf
    norm_num [Nat.choose] at hbonf
    exact_mod_cast hbonf
  have hcodegreeHi0 : 0 ≤ codegreeHi := by
    obtain ⟨x, hx, y, hy, hxy⟩ := Finset.one_lt_card.mp (by omega : 1 < f.card)
    have hxycard : ({x, y} : Finset V).card = 2 := by simp [hxy]
    exact (Nat.cast_nonneg (codegree A {x, y})).trans
      (hcodegree {x, y} hxycard)
  have hfloor : (Nat.floor codegreeHi : ℝ) ≤ codegreeHi :=
    Nat.floor_le hcodegreeHi0
  constructor
  · have hsumlo : 8 * degreeLo ≤ ∑ v ∈ f, (degree A v : ℝ) := by
      calc
        8 * degreeLo = ∑ _v ∈ f, degreeLo := by simp [hf8]
        _ ≤ ∑ v ∈ f, (degree A v : ℝ) := by
          apply Finset.sum_le_sum
          intro v hv
          exact (hdegree v hv).1
    linarith
  · calc
      ((CFMRegularization.availableMeetingChoices A f).card : ℝ) ≤
          ∑ v ∈ f, (degree A v : ℕ) := by
        exact_mod_cast card_availableMeetingChoices_le_sum_degrees A f
      _ = ∑ v ∈ f, (degree A v : ℝ) := by norm_cast
      _ ≤ ∑ _v ∈ f, degreeHi := by
        apply Finset.sum_le_sum
        intro v hv
        exact (hdegree v hv).2
      _ = 8 * degreeHi := by simp [hf8]

/-- Sharp status window from degree, raw one-open links, and the explicit
duplicate-completion correction. -/
theorem availableBlockerChoices_bounds_of_openCollision
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hH8 : IsUniform H 8)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    {degreeLo degreeHi codegreeHi linkLo linkHi duplicateHi : ℝ}
    (hdegree : ∀ v ∈ f,
      degreeLo ≤ (degree (availableEdges H C M) v : ℝ) ∧
        (degree (availableEdges H C M) v : ℝ) ≤ degreeHi)
    (hcodegree : ∀ root, root.card = 2 →
      (codegree (availableEdges H C M) root : ℝ) ≤ codegreeHi)
    (hlink : linkLo ≤
        (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) ∧
      (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) ≤
        linkHi)
    (hduplicate :
      (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) -
          (openConflictCount C (availableEdges H C M) M f : ℝ) ≤
        duplicateHi) :
    8 * degreeLo - 28 * codegreeHi + linkLo - duplicateHi ≤
        ((availableBlockerChoices H C M f).card : ℝ) ∧
      ((availableBlockerChoices H C M f).card : ℝ) ≤
        8 * degreeHi + linkHi := by
  have hfH : f ∈ H := availableEdges_subset H C M hf
  have hfne : f.Nonempty := by
    exact Finset.card_pos.mp (by rw [hH8 f hfH]; norm_num)
  have hmeeting := availableMeetingChoices_bounds_eight hH8 hf
    (availableEdges_subset H C M) hdegree hcodegree
  have hcard := card_availableBlockerChoices_eq_meeting_add_openConflictCount
    hCcard hf hfne
  have hopenUpper :
      (openConflictCount C (availableEdges H C M) M f : ℝ) ≤ linkHi := by
    exact (show (openConflictCount C (availableEdges H C M) M f : ℝ) ≤
        (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) by
      exact_mod_cast openConflictCount_le_internalOpenLinkMass
        C (availableEdges H C M) M f).trans hlink.2
  have hopenLower : linkLo - duplicateHi ≤
      (openConflictCount C (availableEdges H C M) M f : ℝ) := by
    linarith [hlink.1, hduplicate]
  have hcardR : ((availableBlockerChoices H C M f).card : ℝ) =
      ((CFMRegularization.availableMeetingChoices
        (availableEdges H C M) f).card : ℝ) +
        (openConflictCount C (availableEdges H C M) M f : ℝ) := by
    exact_mod_cast hcard
  constructor <;> linarith

/-- If a test is currently in coordinate `s`, every choice blocking one of
its available members makes the test leave that coordinate. -/
theorem biUnion_availableBlockers_subset_partialTestLossChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V)
    (hold : partialTestCondition (availableEdges H C M) M j s S) :
    (S ∩ availableEdges H C M).biUnion
        (availableBlockerChoices H C M) ⊆
      partialTestLossChoiceSet H C M j s S := by
  intro e he
  obtain ⟨f, hfSA, hef⟩ := Finset.mem_biUnion.mp he
  have heA : e ∈ availableEdges H C M :=
    (Finset.mem_filter.mp hef).1
  rw [partialTestLossChoiceSet, Finset.mem_filter]
  refine ⟨heA, hold, ?_⟩
  intro hnew
  have hsub : S ∩ availableEdges H C (insert e M) ⊆
      S ∩ availableEdges H C M := by
    intro g hg
    exact Finset.mem_inter.mpr
      ⟨(Finset.mem_inter.mp hg).1,
        availableEdges_insert_subset H C M e (Finset.mem_inter.mp hg).2⟩
  have heq : S ∩ availableEdges H C (insert e M) =
      S ∩ availableEdges H C M := by
    apply Finset.eq_of_subset_of_card_le hsub
    rw [hnew.1, hold.1]
  have hfnext : f ∈ availableEdges H C (insert e M) := by
    have hfOld : f ∈ S ∩ availableEdges H C M := hfSA
    rw [← heq] at hfOld
    exact Finset.inter_subset_right hfOld
  rw [availableEdges_insert_eq_sdiff_blockers] at hfnext
  have hfA : f ∈ availableEdges H C M :=
    Finset.inter_subset_right hfSA
  exact (Finset.mem_sdiff.mp hfnext).2
    ((mem_availableBlockerChoices_comm H C M heA hfA).mpr hef)

theorem partialTestLossChoiceSet_eq_biUnion_availableBlockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j)
    (hold : partialTestCondition (availableEdges H C M) M j s S) :
    partialTestLossChoiceSet H C M j s S =
      (S ∩ availableEdges H C M).biUnion
        (availableBlockerChoices H C M) := by
  apply Finset.Subset.antisymm
  · exact partialTestLossChoiceSet_subset_biUnion_blockers
      H C M j s S hS
  · exact biUnion_availableBlockers_subset_partialTestLossChoiceSet
      H C M j s S hold

/-- Source-member choices which also delete another available member of
the same test.  This is the exact gain-collision defect. -/
def partialTestGainCollisionChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (S : Hypergraph V) : Hypergraph V :=
  (S ∩ availableEdges H C M).filter fun e ↦
    ∃ f ∈ S ∩ availableEdges H C M, f ≠ e ∧
      e ∈ availableBlockerChoices H C M f

def partialTestGainSafeChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (S : Hypergraph V) : Hypergraph V :=
  (S ∩ availableEdges H C M) \
    partialTestGainCollisionChoiceSet H C M S

theorem partialTestGainSafeChoiceSet_subset_gain
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j)
    (hsource : partialTestCondition
      (availableEdges H C M) M j (s + 1) S) :
    partialTestGainSafeChoiceSet H C M S ⊆
      partialTestGainChoiceSet H C M j s S := by
  intro e he
  have he' := Finset.mem_sdiff.mp he
  have heSA : e ∈ S ∩ availableEdges H C M := he'.1
  have heS : e ∈ S := Finset.inter_subset_left heSA
  have heA : e ∈ availableEdges H C M :=
    Finset.inter_subset_right heSA
  have hsafe : ∀ f ∈ S ∩ availableEdges H C M, f ≠ e →
      e ∉ availableBlockerChoices H C M f := by
    intro f hf hfe hef
    apply he'.2
    exact Finset.mem_filter.mpr ⟨heSA, f, hf, hfe, hef⟩
  let A' := availableEdges H C (insert e M)
  have hA'eq : S ∩ A' = (S ∩ availableEdges H C M).erase e := by
    ext f
    constructor
    · intro hf
      have hf' := Finset.mem_inter.mp hf
      have hfA : f ∈ availableEdges H C M :=
        availableEdges_insert_subset H C M e hf'.2
      apply Finset.mem_erase.mpr
      refine ⟨?_, Finset.mem_inter.mpr ⟨hf'.1, hfA⟩⟩
      intro hfe
      subst f
      exact (mem_availableEdges.mp hf'.2).2.1
        (Finset.mem_insert_self e M)
    · intro hf
      have hf' := Finset.mem_erase.mp hf
      have hfSA := hf'.2
      have hfA : f ∈ availableEdges H C M :=
        Finset.inter_subset_right hfSA
      have hnotBlock : f ∉ availableBlockerChoices H C M e := by
        intro hblock
        have heBlock : e ∈ availableBlockerChoices H C M f :=
          (mem_availableBlockerChoices_comm H C M heA hfA).mp hblock
        exact hsafe f hfSA hf'.1 heBlock
      apply Finset.mem_inter.mpr
      refine ⟨Finset.inter_subset_left hfSA, ?_⟩
      change f ∈ availableEdges H C (insert e M)
      rw [availableEdges_insert_eq_sdiff_blockers]
      exact Finset.mem_sdiff.mpr ⟨hfA, hnotBlock⟩
  have heNotM : e ∉ S ∩ M := by
    intro heSM
    exact (mem_availableEdges.mp heA).2.1
      (Finset.inter_subset_right heSM)
  have hMinsert : S ∩ insert e M = insert e (S ∩ M) := by
    ext f
    simp only [Finset.mem_inter, Finset.mem_insert]
    constructor
    · rintro ⟨hfS, rfl | hfM⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨hfS, hfM⟩
    · rintro (rfl | ⟨hfS, hfM⟩)
      · exact ⟨heS, Or.inl rfl⟩
      · exact ⟨hfS, Or.inr hfM⟩
  have hslt : s < j := by
    have hcardle : (S ∩ availableEdges H C M).card ≤ S.card :=
      Finset.card_le_card Finset.inter_subset_left
    rw [hsource.1, (Finset.mem_powersetCard.mp hS).2] at hcardle
    omega
  have hnew : partialTestCondition A' (insert e M) j s S := by
    constructor
    · rw [hA'eq, Finset.card_erase_of_mem heSA, hsource.1]
      omega
    · rw [hMinsert, Finset.card_insert_of_notMem heNotM, hsource.2]
      omega
  rw [partialTestGainChoiceSet, Finset.mem_filter]
  refine ⟨heA, ?_, hnew⟩
  intro hold
  have holdCard := hold.1
  have hsourceCard := hsource.1
  omega

theorem partialTestGainChoiceSet_card_add_collision_ge_source
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) (hS : S ∈ H.powersetCard j)
    (hsource : partialTestCondition
      (availableEdges H C M) M j (s + 1) S) :
    (s + 1) ≤
      (partialTestGainChoiceSet H C M j s S).card +
        (partialTestGainCollisionChoiceSet H C M S).card := by
  have hsafe := Finset.card_le_card
    (partialTestGainSafeChoiceSet_subset_gain
      H C M j s S hS hsource)
  have hcollisionSub : partialTestGainCollisionChoiceSet H C M S ⊆
      S ∩ availableEdges H C M := Finset.filter_subset _ _
  have hcardSafe : (partialTestGainSafeChoiceSet H C M S).card =
      (S ∩ availableEdges H C M).card -
        (partialTestGainCollisionChoiceSet H C M S).card := by
    unfold partialTestGainSafeChoiceSet
    rw [Finset.card_sdiff,
      Finset.inter_eq_left.mpr hcollisionSub]
  rw [hcardSafe, hsource.1] at hsafe
  omega

noncomputable def weightedPartialTestGainCollision
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j (s + 1) S then
      w S * (partialTestGainCollisionChoiceSet H C M S).card
    else 0

theorem succ_mul_observable_le_weightedGain_add_collision
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    ((s + 1 : ℕ) : ℝ) * partialTestObservable w H C j (s + 1) M ≤
      weightedPartialTestGainChoices w H C M j s +
        weightedPartialTestGainCollision w H C M j s := by
  unfold partialTestObservable partialTestTotal
    weightedPartialTestGainChoices weightedPartialTestGainCollision
  rw [Finset.mul_sum, ← Finset.sum_add_distrib]
  rw [Finset.sum_filter]
  apply Finset.sum_le_sum
  intro S hS
  by_cases hsource : partialTestCondition
      (availableEdges H C M) M j (s + 1) S
  · simp only [partialTestCondition] at hsource
    simp only [Nat.cast_add, Nat.cast_one]
    have hc := partialTestGainChoiceSet_card_add_collision_ge_source
      H C M j s S hS hsource
    have hcR : (s : ℝ) + 1 ≤
        ((partialTestGainChoiceSet H C M j s S).card : ℝ) +
          ((partialTestGainCollisionChoiceSet H C M S).card : ℝ) := by
      exact_mod_cast hc
    calc
      ((s : ℝ) + 1) * w S ≤
          (((partialTestGainChoiceSet H C M j s S).card : ℝ) +
            ((partialTestGainCollisionChoiceSet H C M S).card : ℝ)) *
              w S := mul_le_mul_of_nonneg_right hcR (hw S)
      _ = w S * ((partialTestGainChoiceSet H C M j s S).card : ℝ) +
          w S * ((partialTestGainCollisionChoiceSet H C M S).card : ℝ) := by
        ring
  · simp only [partialTestCondition] at hsource
    simp only [Nat.cast_add, Nat.cast_one]
    exact mul_nonneg (hw S) (Nat.cast_nonneg _)

/-- The exact overcount in replacing the union of the `s` blocker
neighbourhoods by their incidence sum. -/
def partialTestLossCollisionMultiplicity
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (S : Hypergraph V) : ℕ :=
  (∑ f ∈ S ∩ availableEdges H C M,
      (availableBlockerChoices H C M f).card) -
    ((S ∩ availableEdges H C M).biUnion
      (availableBlockerChoices H C M)).card

noncomputable def weightedPartialTestBlockerIncidence
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * (∑ f ∈ S ∩ availableEdges H C M,
        (availableBlockerChoices H C M f).card)
    else 0

noncomputable def weightedPartialTestLossCollision
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * partialTestLossCollisionMultiplicity H C M S
    else 0

theorem weightedLoss_add_collision_eq_blockerIncidence
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) :
    weightedPartialTestLossChoices w H C M j s +
        weightedPartialTestLossCollision w H C M j s =
      weightedPartialTestBlockerIncidence w H C M j s := by
  unfold weightedPartialTestLossChoices weightedPartialTestLossCollision
    weightedPartialTestBlockerIncidence
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro S hS
  by_cases hold : partialTestCondition
      (availableEdges H C M) M j s S
  · simp only [hold, if_true]
    rw [partialTestLossChoiceSet_eq_biUnion_availableBlockers
      H C M j s S hS hold]
    unfold partialTestLossCollisionMultiplicity
    have hcard := Finset.card_biUnion_le
      (s := S ∩ availableEdges H C M)
      (t := availableBlockerChoices H C M)
    rw [Nat.cast_sub hcard]
    push_cast
    ring
  · simp only [hold, if_false, add_zero]
    have hempty : partialTestLossChoiceSet H C M j s S = ∅ := by
      apply Finset.not_nonempty_iff_eq_empty.mp
      intro hne
      obtain ⟨e, he⟩ := hne
      exact hold (Finset.mem_filter.mp he).2.1
    simp [hempty]

theorem weightedLoss_le_blockerIncidence
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    weightedPartialTestLossChoices w H C M j s ≤
      weightedPartialTestBlockerIncidence w H C M j s := by
  rw [← weightedLoss_add_collision_eq_blockerIncidence]
  exact le_add_of_nonneg_right (by
    unfold weightedPartialTestLossCollision
    apply Finset.sum_nonneg
    intro S hS
    split
    · exact mul_nonneg (hw S) (Nat.cast_nonneg _)
    · norm_num)

theorem weightedBlockerIncidence_bounds_of_statusWindow
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (lo hi : ℝ)
    (hw : ∀ S, 0 ≤ w S)
    (hlo : ∀ f ∈ availableEdges H C M,
      lo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hhi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ hi) :
    (s : ℝ) * lo * partialTestObservable w H C j s M ≤
        weightedPartialTestBlockerIncidence w H C M j s ∧
      weightedPartialTestBlockerIncidence w H C M j s ≤
        (s : ℝ) * hi * partialTestObservable w H C j s M := by
  unfold weightedPartialTestBlockerIncidence partialTestObservable
    partialTestTotal
  rw [Finset.mul_sum, Finset.mul_sum]
  simp only [Finset.sum_filter]
  constructor
  · apply Finset.sum_le_sum
    intro S hS
    by_cases hold : partialTestCondition
        (availableEdges H C M) M j s S
    · simp only [partialTestCondition] at hold
      simp only [Nat.cast_sum]
      have hsum : (s : ℝ) * lo ≤
          ∑ f ∈ S ∩ availableEdges H C M,
            ((availableBlockerChoices H C M f).card : ℝ) := by
        calc
          (s : ℝ) * lo =
              ∑ _f ∈ S ∩ availableEdges H C M, lo := by
                simp [hold.1]
          _ ≤ ∑ f ∈ S ∩ availableEdges H C M,
              ((availableBlockerChoices H C M f).card : ℝ) := by
                apply Finset.sum_le_sum
                intro f hf
                exact hlo f (Finset.inter_subset_right hf)
      nlinarith [mul_le_mul_of_nonneg_left hsum (hw S)]
    · simp only [partialTestCondition] at hold
      simp [partialTestCondition, hold]
  · apply Finset.sum_le_sum
    intro S hS
    by_cases hold : partialTestCondition
        (availableEdges H C M) M j s S
    · simp only [partialTestCondition] at hold
      simp only [Nat.cast_sum]
      have hsum :
          (∑ f ∈ S ∩ availableEdges H C M,
            ((availableBlockerChoices H C M f).card : ℝ)) ≤
            (s : ℝ) * hi := by
        calc
          (∑ f ∈ S ∩ availableEdges H C M,
              ((availableBlockerChoices H C M f).card : ℝ)) ≤
              ∑ _f ∈ S ∩ availableEdges H C M, hi := by
                apply Finset.sum_le_sum
                intro f hf
                exact hhi f (Finset.inter_subset_right hf)
          _ = (s : ℝ) * hi := by simp [hold.1]
      nlinarith [mul_le_mul_of_nonneg_left hsum (hw S)]
    · simp only [partialTestCondition] at hold
      simp [partialTestCondition, hold]

def commonSetForIndexPair (F : ι → Finset α) (p : Finset ι) : Finset α :=
  (p.biUnion F).filter fun z ↦ ∀ x ∈ p, z ∈ F x

@[simp] theorem commonSetForIndexPair_pair
    (F : ι → Finset α) (x y : ι) :
    commonSetForIndexPair F {x, y} = F x ∩ F y := by
  ext z
  constructor
  · intro hz
    have hz' := Finset.mem_filter.mp hz
    exact Finset.mem_inter.mpr ⟨hz'.2 x (by simp), hz'.2 y (by simp)⟩
  · intro hz
    have hz' := Finset.mem_inter.mp hz
    apply Finset.mem_filter.mpr
    refine ⟨?_, ?_⟩
    · exact Finset.mem_biUnion.mpr ⟨x, by simp, hz'.1⟩
    · intro u hu
      simp only [Finset.mem_insert, Finset.mem_singleton] at hu
      rcases hu with rfl | rfl
      · exact hz'.1
      · exact hz'.2

def exactPairOverlapMass (S : Finset ι) (F : ι → Finset α) : ℕ :=
  ∑ p ∈ S.powersetCard 2, (commonSetForIndexPair F p).card

theorem exactPairOverlapMass_insert
    (F : ι → Finset α) {a : ι} {S : Finset ι} (ha : a ∉ S) :
    exactPairOverlapMass (insert a S) F =
      exactPairOverlapMass S F + ∑ y ∈ S, (F a ∩ F y).card := by
  unfold exactPairOverlapMass
  rw [Finset.powersetCard_succ_insert ha 1]
  have hdisj : Disjoint (S.powersetCard 2)
      ((S.powersetCard 1).image (insert a)) := by
    rw [Finset.disjoint_left]
    intro p hpOld hpNew
    have hpOldData := Finset.mem_powersetCard.mp hpOld
    obtain ⟨q, hq, hqeq⟩ := Finset.mem_image.mp hpNew
    have haOld : a ∉ p := fun hap ↦ ha (hpOldData.1 hap)
    have haNew : a ∈ p := by rw [← hqeq]; simp
    exact haOld haNew
  rw [Finset.sum_union hdisj]
  congr 1
  rw [Finset.powersetCard_one]
  rw [Finset.sum_image]
  · rw [Finset.sum_map]
    apply Finset.sum_congr rfl
    intro y hy
    change (commonSetForIndexPair F {a, y}).card = (F a ∩ F y).card
    rw [commonSetForIndexPair_pair]
  · intro p hp q hq hpq
    obtain ⟨x, hx, rfl⟩ := Finset.mem_map.mp hp
    obtain ⟨y, hy, rfl⟩ := Finset.mem_map.mp hq
    have hax : a ≠ x := fun hax ↦ ha (hax ▸ hx)
    have hay : a ≠ y := fun hay ↦ ha (hay ▸ hy)
    have hErase := congrArg (fun T : Finset ι ↦ T.erase a) hpq
    simpa [hax, hay] using hErase

/-- Exact second Bonferroni inequality, retaining the individual
intersection cardinality of every unordered pair. -/
theorem sum_card_le_card_biUnion_add_exactPairOverlapMass
    (S : Finset ι) (F : ι → Finset α) :
    ∑ x ∈ S, (F x).card ≤
      (S.biUnion F).card + exactPairOverlapMass S F := by
  induction S using Finset.induction_on with
  | empty => simp [exactPairOverlapMass]
  | @insert a S ha ih =>
      let U := S.biUnion F
      have hsub : F a ∩ U ⊆ S.biUnion (fun y ↦ F a ∩ F y) := by
        intro z hz
        obtain ⟨hza, hzU⟩ := Finset.mem_inter.mp hz
        obtain ⟨y, hyS, hzy⟩ := Finset.mem_biUnion.mp hzU
        exact Finset.mem_biUnion.mpr
          ⟨y, hyS, Finset.mem_inter.mpr ⟨hza, hzy⟩⟩
      have hInter : (F a ∩ U).card ≤
          ∑ y ∈ S, (F a ∩ F y).card := by
        exact (Finset.card_le_card hsub).trans Finset.card_biUnion_le
      have hUnion : (F a ∪ U).card + (F a ∩ U).card =
          (F a).card + U.card := Finset.card_union_add_card_inter _ _
      have hFU : (F a).card + U.card ≤
          (F a ∪ U).card + ∑ y ∈ S, (F a ∩ F y).card := by
        omega
      rw [Finset.sum_insert ha, Finset.biUnion_insert,
        exactPairOverlapMass_insert F ha]
      change (F a).card + ∑ x ∈ S, (F x).card ≤
        (F a ∪ U).card +
          (exactPairOverlapMass S F + ∑ y ∈ S, (F a ∩ F y).card)
      change (∑ x ∈ S, (F x).card) ≤
        U.card + exactPairOverlapMass S F at ih
      calc
        (F a).card + ∑ x ∈ S, (F x).card ≤
            (F a).card + (U.card + exactPairOverlapMass S F) :=
          Nat.add_le_add_left ih _
        _ = ((F a).card + U.card) + exactPairOverlapMass S F := by omega
        _ ≤ ((F a ∪ U).card +
              ∑ y ∈ S, (F a ∩ F y).card) +
            exactPairOverlapMass S F :=
          Nat.add_le_add_right hFU _
        _ = (F a ∪ U).card +
            (exactPairOverlapMass S F +
              ∑ y ∈ S, (F a ∩ F y).card) := by omega
def sharpPartialTestLossCollisionMultiplicity
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (S : Hypergraph V) : ℕ :=
  (∑ f ∈ S ∩ availableEdges H C M,
      (availableBlockerChoices H C M f).card) -
    ((S ∩ availableEdges H C M).biUnion
      (availableBlockerChoices H C M)).card

noncomputable def sharpWeightedPartialTestLossCollision
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * sharpPartialTestLossCollisionMultiplicity H C M S
    else 0

def availableBlockerPairOverlapMass
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (S : Hypergraph V) : ℕ :=
  exactPairOverlapMass (S ∩ availableEdges H C M)
    (availableBlockerChoices H C M)

theorem sharpPartialTestLossCollisionMultiplicity_le_pairOverlap
    (H : Hypergraph V) (C : ConflictSystem V) (M S : Hypergraph V) :
    sharpPartialTestLossCollisionMultiplicity H C M S ≤
      availableBlockerPairOverlapMass H C M S := by
  let B := S ∩ availableEdges H C M
  let F := availableBlockerChoices H C M
  have hbonf := sum_card_le_card_biUnion_add_exactPairOverlapMass B F
  unfold sharpPartialTestLossCollisionMultiplicity availableBlockerPairOverlapMass
  change (∑ f ∈ B, (F f).card) - (B.biUnion F).card ≤
    exactPairOverlapMass B F
  omega

/-! ## Matching/conflict blocker geometry -/

/-- A legal available choice blocks `f` either by meeting it or by a
disjoint conflict completion.  The two parts are disjoint. -/
theorem sharp_availableBlockerChoices_eq_meeting_union_conflict
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    (hfne : f.Nonempty) :
    availableBlockerChoices H C M f =
      CFMRegularization.availableMeetingChoices
          (availableEdges H C M) f ∪
        conflictBlockerChoices C M (availableEdges H C M) f := by
  ext e
  constructor
  · intro he
    have he' := Finset.mem_filter.mp he
    by_cases hdisj : Disjoint e f
    · apply Finset.mem_union.mpr
      apply Or.inr
      apply Finset.mem_filter.mpr
      refine ⟨he'.1, hdisj, ?_⟩
      intro hfree
      apply he'.2.resolve_left
      · intro hef
        subst e
        obtain ⟨x, hxf⟩ := hfne
        exact (Finset.disjoint_left.mp hdisj hxf hxf)
      · have heAvail := mem_availableEdges.mp he'.1
        have hfAvail := mem_availableEdges.mp hf
        have hmatch : IsMatching H (insert f (insert e M)) := by
          rw [isMatching_insert_iff]
          refine ⟨hfAvail.1, heAvail.2.2.1, ?_⟩
          intro g hg hfg
          rcases Finset.mem_insert.mp hg with rfl | hgM
          · exact hdisj.symm
          · exact hfAvail.2.2.1.2
              (Finset.mem_insert_self f M)
              (Finset.mem_insert_of_mem hgM) hfg.symm
        simpa [Finset.insert_comm e f] using
          (show IsConflictFreeMatching H C (insert f (insert e M))
            from ⟨hmatch, hfree⟩)
    · apply Finset.mem_union.mpr
      exact Or.inl (Finset.mem_filter.mpr ⟨he'.1, hdisj⟩)
  · intro he
    rcases Finset.mem_union.mp he with hmeet | hconf
    · have hmeet' := Finset.mem_filter.mp hmeet
      apply Finset.mem_filter.mpr
      refine ⟨hmeet'.1, ?_⟩
      by_cases hef : e = f
      · exact Or.inl hef
      · apply Or.inr
        intro hadm
        have hpair := hadm.1.2
        have hdisj := hpair (Finset.mem_insert_self e (insert f M))
          (Finset.mem_insert_of_mem (Finset.mem_insert_self f M)) hef
        exact hmeet'.2 hdisj
    · have hconf' := Finset.mem_filter.mp hconf
      apply Finset.mem_filter.mpr
      refine ⟨hconf'.1, Or.inr ?_⟩
      intro hadm
      apply hconf'.2.2
      simpa [Finset.insert_comm e f] using hadm.2

theorem sharp_disjoint_meeting_conflict_parts
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) :
    Disjoint
      (CFMRegularization.availableMeetingChoices
        (availableEdges H C M) f)
      (conflictBlockerChoices C M (availableEdges H C M) f) := by
  rw [Finset.disjoint_left]
  intro e hmeet hconf
  exact (Finset.mem_filter.mp hmeet).2 (Finset.mem_filter.mp hconf).2.1

/-- The four terms for one oriented pair `(f,g)`. -/
def blockerPairMM (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f g : Finset V) : ℕ :=
  ((CFMRegularization.availableMeetingChoices
      (availableEdges H C M) f) ∩
    CFMRegularization.availableMeetingChoices
      (availableEdges H C M) g).card

def blockerPairMC (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f g : Finset V) : ℕ :=
  ((CFMRegularization.availableMeetingChoices
      (availableEdges H C M) f) ∩
    conflictBlockerChoices C M (availableEdges H C M) g).card

def blockerPairCM (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f g : Finset V) : ℕ :=
  ((conflictBlockerChoices C M (availableEdges H C M) f) ∩
    CFMRegularization.availableMeetingChoices
      (availableEdges H C M) g).card

def blockerPairCC (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f g : Finset V) : ℕ :=
  ((conflictBlockerChoices C M (availableEdges H C M) f) ∩
    conflictBlockerChoices C M (availableEdges H C M) g).card

theorem card_inter_availableBlockers_le_MM_MC_CM_CC
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f g : Finset V} (hf : f ∈ availableEdges H C M) (hfne : f.Nonempty)
    (hg : g ∈ availableEdges H C M) (hgne : g.Nonempty) :
    (availableBlockerChoices H C M f ∩
        availableBlockerChoices H C M g).card ≤
      blockerPairMM H C M f g + blockerPairMC H C M f g +
        blockerPairCM H C M f g + blockerPairCC H C M f g := by
  let Mf := CFMRegularization.availableMeetingChoices
    (availableEdges H C M) f
  let Mg := CFMRegularization.availableMeetingChoices
    (availableEdges H C M) g
  let Cf := conflictBlockerChoices C M (availableEdges H C M) f
  let Cg := conflictBlockerChoices C M (availableEdges H C M) g
  have heqf : availableBlockerChoices H C M f = Mf ∪ Cf := by
    simpa only [Mf, Cf] using
      sharp_availableBlockerChoices_eq_meeting_union_conflict hf hfne
  have heqg : availableBlockerChoices H C M g = Mg ∪ Cg := by
    simpa only [Mg, Cg] using
      sharp_availableBlockerChoices_eq_meeting_union_conflict hg hgne
  have hsub : (Mf ∪ Cf) ∩ (Mg ∪ Cg) ⊆
      (Mf ∩ Mg) ∪ (Mf ∩ Cg) ∪ (Cf ∩ Mg) ∪ (Cf ∩ Cg) := by
    intro e he
    obtain ⟨hef, heg⟩ := Finset.mem_inter.mp he
    rcases Finset.mem_union.mp hef with hef | hef <;>
      rcases Finset.mem_union.mp heg with heg | heg
    · simp only [Finset.mem_union, Finset.mem_inter]
      exact Or.inl (Or.inl (Or.inl ⟨hef, heg⟩))
    · simp only [Finset.mem_union, Finset.mem_inter]
      exact Or.inl (Or.inl (Or.inr ⟨hef, heg⟩))
    · simp only [Finset.mem_union, Finset.mem_inter]
      exact Or.inl (Or.inr ⟨hef, heg⟩)
    · simp only [Finset.mem_union, Finset.mem_inter]
      exact Or.inr ⟨hef, heg⟩
  rw [heqf, heqg]
  apply (Finset.card_le_card hsub).trans
  dsimp only [blockerPairMM, blockerPairMC, blockerPairCM, blockerPairCC]
  change ((Mf ∩ Mg) ∪ (Mf ∩ Cg) ∪ (Cf ∩ Mg) ∪
      (Cf ∩ Cg)).card ≤
    (Mf ∩ Mg).card + (Mf ∩ Cg).card +
      (Cf ∩ Mg).card + (Cf ∩ Cg).card
  calc
    _ ≤ ((Mf ∩ Mg) ∪ (Mf ∩ Cg) ∪ (Cf ∩ Mg)).card +
          (Cf ∩ Cg).card := Finset.card_union_le _ _
    _ ≤ (((Mf ∩ Mg) ∪ (Mf ∩ Cg)).card + (Cf ∩ Mg).card) +
          (Cf ∩ Cg).card := Nat.add_le_add_right (Finset.card_union_le _ _) _
    _ ≤ (((Mf ∩ Mg).card + (Mf ∩ Cg).card) + (Cf ∩ Mg).card) +
          (Cf ∩ Cg).card := Nat.add_le_add_right
            (Nat.add_le_add_right (Finset.card_union_le _ _) _) _
    _ = _ := by omega

/-! ## Pair-indexed and weighted MM/MC/CM/CC masses -/

def orientedPairCategoryMass (B : Hypergraph V)
    (K : Finset V → Finset V → ℕ) : ℕ :=
  ∑ p ∈ B.powersetCard 2,
    ∑ f ∈ p, ∑ g ∈ p.filter (fun g ↦ g ≠ f), K f g

def testLossMMMassAt (H : Hypergraph V) (C : ConflictSystem V)
    (M S : Hypergraph V) : ℕ :=
  orientedPairCategoryMass (S ∩ availableEdges H C M)
    (blockerPairMM H C M)

def testLossMCMassAt (H : Hypergraph V) (C : ConflictSystem V)
    (M S : Hypergraph V) : ℕ :=
  orientedPairCategoryMass (S ∩ availableEdges H C M)
    (blockerPairMC H C M)

def testLossCMMassAt (H : Hypergraph V) (C : ConflictSystem V)
    (M S : Hypergraph V) : ℕ :=
  orientedPairCategoryMass (S ∩ availableEdges H C M)
    (blockerPairCM H C M)

def testLossCCMassAt (H : Hypergraph V) (C : ConflictSystem V)
    (M S : Hypergraph V) : ℕ :=
  orientedPairCategoryMass (S ∩ availableEdges H C M)
    (blockerPairCC H C M)

theorem pairOverlapMass_le_MM_MC_CM_CC
    {H : Hypergraph V} {C : ConflictSystem V} {M S : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty) :
    availableBlockerPairOverlapMass H C M S ≤
      testLossMMMassAt H C M S + testLossMCMassAt H C M S +
        testLossCMMassAt H C M S + testLossCCMassAt H C M S := by
  let B := S ∩ availableEdges H C M
  unfold availableBlockerPairOverlapMass exactPairOverlapMass
  unfold testLossMMMassAt testLossMCMassAt testLossCMMassAt testLossCCMassAt
    orientedPairCategoryMass
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro p hp
  have hpdata := Finset.mem_powersetCard.mp hp
  obtain ⟨f, g, hfg, rfl⟩ := Finset.card_eq_two.mp hpdata.2
  have hfB : f ∈ B := hpdata.1 (by simp)
  have hgB : g ∈ B := hpdata.1 (by simp)
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hfB
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hgB
  have hfour := card_inter_availableBlockers_le_MM_MC_CM_CC
    hfA (hHnonempty f (availableEdges_subset H C M hfA))
    hgA (hHnonempty g (availableEdges_subset H C M hgA))
  have horiented (K : Finset V → Finset V → ℕ) :
      K f g ≤ ∑ x ∈ ({f, g} : Hypergraph V),
        ∑ y ∈ ({f, g} : Hypergraph V).filter (fun y ↦ y ≠ x), K x y := by
    calc
      K f g ≤ ∑ y ∈ ({f, g} : Hypergraph V).filter (fun y ↦ y ≠ f),
          K f y := Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _)
            (Finset.mem_filter.mpr ⟨by simp, Ne.symm hfg⟩)
      _ ≤ ∑ x ∈ ({f, g} : Hypergraph V),
          ∑ y ∈ ({f, g} : Hypergraph V).filter (fun y ↦ y ≠ x), K x y :=
        Finset.single_le_sum
          (s := ({f, g} : Hypergraph V))
          (f := fun x ↦ ∑ y ∈ ({f, g} : Hypergraph V).filter
            (fun y ↦ y ≠ x), K x y)
          (fun _ _ ↦ Finset.sum_nonneg fun _ _ ↦ Nat.zero_le _)
          (Finset.mem_insert_self f {g})
  have hmm := horiented (blockerPairMM H C M)
  have hmc := horiented (blockerPairMC H C M)
  have hcm := horiented (blockerPairCM H C M)
  have hcc := horiented (blockerPairCC H C M)
  simp only [commonSetForIndexPair_pair]
  omega

noncomputable def weightedTestLossMMMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * testLossMMMassAt H C M S else 0

noncomputable def weightedTestLossMCMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * testLossMCMassAt H C M S else 0

noncomputable def weightedTestLossCMMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * testLossCMMassAt H C M S else 0

noncomputable def weightedTestLossCCMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition (availableEdges H C M) M j s S then
      w S * testLossCCMassAt H C M S else 0

/-- The requested dynamic decomposition.  It is state-internal and has no
certificate or trajectory premise. -/
theorem sharpWeightedPartialTestLossCollision_le_MM_MC_CM_CC
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {j s : ℕ}
    (hw : ∀ S, 0 ≤ w S) (hHnonempty : ∀ f ∈ H, f.Nonempty) :
    sharpWeightedPartialTestLossCollision w H C M j s ≤
      weightedTestLossMMMass w H C M j s +
        weightedTestLossMCMass w H C M j s +
        weightedTestLossCMMass w H C M j s +
        weightedTestLossCCMass w H C M j s := by
  unfold sharpWeightedPartialTestLossCollision weightedTestLossMMMass
    weightedTestLossMCMass weightedTestLossCMMass weightedTestLossCCMass
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro S hS
  by_cases hcoord : partialTestCondition
      (availableEdges H C M) M j s S
  · simp only [hcoord, if_true]
    have hpoint := sharpPartialTestLossCollisionMultiplicity_le_pairOverlap
      H C M S
    have hsplit := pairOverlapMass_le_MM_MC_CM_CC
      (H := H) (C := C) (M := M) (S := S) hHnonempty
    have hnat : sharpPartialTestLossCollisionMultiplicity H C M S ≤
        testLossMMMassAt H C M S + testLossMCMassAt H C M S +
          testLossCMMassAt H C M S + testLossCCMassAt H C M S :=
      hpoint.trans hsplit
    have hreal :
        (sharpPartialTestLossCollisionMultiplicity H C M S : ℝ) ≤
          (testLossMMMassAt H C M S + testLossMCMassAt H C M S +
            testLossCMMassAt H C M S + testLossCCMassAt H C M S : ℕ) := by
      exact_mod_cast hnat
    push_cast at hreal
    nlinarith [mul_le_mul_of_nonneg_left hreal (hw S)]
  · simp [hcoord]
theorem conflictLinkTestWeight_nonneg_sharp
    (C : ConflictSystem V) (f : Finset V) (q : ℕ) (Q : Hypergraph V) :
    0 ≤ conflictLinkTestWeight C f q Q := by
  unfold conflictLinkTestWeight
  split <;> norm_num

theorem conflictLinkTestWeight_pos_iff_sharp
    {C : ConflictSystem V} {f : Finset V} {q : ℕ} {Q : Hypergraph V} :
    0 < conflictLinkTestWeight C f q Q ↔
      Q ∈ conflictLinkLayer C f q := by
  unfold conflictLinkTestWeight
  by_cases hQ : Q ∈ conflictLinkLayer C f q <;> simp [hQ]

theorem conflictLinkTestWeight_matching_of_pos_sharp
    {H : Hypergraph V} {C : ConflictSystem V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    {f : Finset V} {q : ℕ} {Q : Hypergraph V}
    (hQ : 0 < conflictLinkTestWeight C f q Q) :
    IsMatching H Q := by
  have hlink : Q ∈ conflictLink C f :=
    mem_conflictLink.mpr ((mem_conflictLinkLayer.mp
      (conflictLinkTestWeight_pos_iff_sharp.mp hQ)).1)
  obtain ⟨c, hcC, hfc, rfl⟩ := mem_conflictLink.mp hlink
  exact (hmatching c hcC).mono (Finset.erase_subset f c)

theorem weightedGain_sub_collision_lower_sharp
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    ((s + 1 : ℕ) : ℝ) * partialTestObservable w H C j (s + 1) M -
        weightedPartialTestGainCollision w H C M j s ≤
      weightedPartialTestGainChoices w H C M j s := by
  linarith [succ_mul_observable_le_weightedGain_add_collision
    w H C M j s hw]

theorem weightedPartialTestGainCollision_eq_weightedTestGainCollisionMass_sharp
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) :
    weightedPartialTestGainCollision w H C M j s =
      weightedTestGainCollisionMass w H C M j s := by
  rfl

/-- The gain overcount is charged to fixed-choice `Z_{e,2}` coordinates.
There is deliberately no choice-aggregated weighted family in this API. -/
theorem weightedPartialTestGainCollision_le_fixedChoicePartialMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {j s : ℕ} {w : TestWeight V}
    (hw0 : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) :
    weightedPartialTestGainCollision w H C M j s ≤
      ∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass
          w (H.powersetCard j) C e r
          (availableEdges H C M) M (s + 1) := by
  rw [weightedPartialTestGainCollision_eq_weightedTestGainCollisionMass_sharp]
  exact weightedTestGainCollisionMass_le_choicePartialMass
    hw0 hmatchingPos hCcard hj1 hj3

/-- Exact sharp drift bridge.  The full loss coefficient comes from the
per-edge blocker-status window; only the fixed-choice gain collision and
the dynamic blocker-union overlap remain to be supplied by local
coordinates. -/
theorem partialTest_meanWindow_of_fixedChoiceGain_and_lossOverlap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (statusLo statusHi gainDefect lossDefect : ℝ)
    {plusLo plusHi currentLo currentHi targetLo targetHi : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusLo0 : 0 ≤ statusLo) (hstatusHi0 : 0 ≤ statusHi)
    (hstatusLo : ∀ f ∈ availableEdges H C M,
      statusLo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi)
    (hplus : plusLo ≤ partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤ currentHi)
    (hfixedGain :
      (∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass
          w (H.powersetCard j) C e r
          (availableEdges H C M) M (s + 1)) ≤ gainDefect)
    (hlossOverlap :
      weightedPartialTestLossCollision w H C M j s ≤ lossDefect)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        ((s + 1 : ℕ) : ℝ) * plusLo - gainDefect -
          (s : ℝ) * statusHi * currentHi)
    (hnumericUpper :
      ((s + 1 : ℕ) : ℝ) * plusHi -
          ((s : ℝ) * statusLo * currentLo - lossDefect) ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ targetHi := by
  apply partialTest_meanWindow_of_choiceAbsorption w H C M j s hA
  unfold HasPartialTestChoiceAbsorption weightedPartialTestChoiceImbalance
  have hgainDefect : weightedPartialTestGainCollision w H C M j s ≤
      gainDefect :=
    (weightedPartialTestGainCollision_le_fixedChoicePartialMass
      hw hmatchingPos hCcard hj1 hj3).trans hfixedGain
  have hgainLower := weightedGain_sub_collision_lower_sharp
    w H C M j s hw
  have hgainUpper := weightedPartialTestGainChoices_le_succ_mul_observable
    w H C M j s hw
  have hincidence := weightedBlockerIncidence_bounds_of_statusWindow
    w H C M j s statusLo statusHi hw hstatusLo hstatusHi
  have hlossUpper := weightedLoss_le_blockerIncidence
    w H C M j s hw
  constructor
  · apply hnumericLower.trans
    apply sub_le_sub
    · exact (sub_le_sub
        (mul_le_mul_of_nonneg_left hplus.1 (by positivity))
        hgainDefect).trans hgainLower
    · exact hlossUpper.trans (hincidence.2.trans
        (mul_le_mul_of_nonneg_left hcurrent.2
          (mul_nonneg (Nat.cast_nonneg _) hstatusHi0)))
  · have hlossLower :
        (s : ℝ) * statusLo * currentLo - lossDefect ≤
          weightedPartialTestLossChoices w H C M j s := by
      have hintermediate :
          weightedPartialTestBlockerIncidence w H C M j s -
              weightedPartialTestLossCollision w H C M j s ≤
            weightedPartialTestLossChoices w H C M j s := by
        rw [← weightedLoss_add_collision_eq_blockerIncidence]
        ring_nf
        exact le_rfl
      calc
        (s : ℝ) * statusLo * currentLo - lossDefect ≤
            (s : ℝ) * statusLo *
                partialTestObservable w H C j s M -
              weightedPartialTestLossCollision w H C M j s := by
          apply sub_le_sub
          · apply mul_le_mul_of_nonneg_left hcurrent.1
            exact mul_nonneg (Nat.cast_nonneg _) hstatusLo0
          · exact hlossOverlap
        _ ≤ weightedPartialTestBlockerIncidence w H C M j s -
              weightedPartialTestLossCollision w H C M j s :=
          sub_le_sub_right hincidence.1 _
        _ ≤ weightedPartialTestLossChoices w H C M j s := hintermediate
    have hgainUpper' : weightedPartialTestGainChoices w H C M j s ≤
        ((s + 1 : ℕ) : ℝ) * plusHi :=
      hgainUpper.trans
        (mul_le_mul_of_nonneg_left hplus.2 (by positivity))
    exact (sub_le_sub hgainUpper' hlossLower).trans hnumericUpper

/-- Public-test specialization: trackability supplies nonnegativity and
matching support, while the local coordinates supply the two defects. -/
theorem partialTest_meanWindow_of_fixedChoiceGain_and_lossOverlap_trackable
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j ell s : ℕ) (d eta : ℝ)
    (statusLo statusHi gainDefect lossDefect : ℝ)
    {plusLo plusHi currentLo currentHi targetLo targetHi : ℝ}
    (hw : IsTrackable H C j ell d eta w)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusLo0 : 0 ≤ statusLo) (hstatusHi0 : 0 ≤ statusHi)
    (hstatusLo : ∀ f ∈ availableEdges H C M,
      statusLo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi)
    (hplus : plusLo ≤ partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤ currentHi)
    (hfixedGain :
      (∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass
          w (H.powersetCard j) C e r
          (availableEdges H C M) M (s + 1)) ≤ gainDefect)
    (hlossOverlap :
      weightedPartialTestLossCollision w H C M j s ≤ lossDefect)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        ((s + 1 : ℕ) : ℝ) * plusLo - gainDefect -
          (s : ℝ) * statusHi * currentHi)
    (hnumericUpper :
      ((s + 1 : ℕ) : ℝ) * plusHi -
          ((s : ℝ) * statusLo * currentLo - lossDefect) ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ targetHi := by
  apply partialTest_meanWindow_of_fixedChoiceGain_and_lossOverlap
    w H C M j s statusLo statusHi gainDefect lossDefect
      hw.isTestFunction.nonneg
      (fun T _ hpos ↦ by
        by_contra hnot
        have hz := hw.isTestFunction.eq_zero_of_not_matching hnot
        linarith)
      hCcard hj1 hj3 hA hstatusLo0 hstatusHi0 hstatusLo hstatusHi
      hplus hcurrent hfixedGain hlossOverlap hnumericLower hnumericUpper

/-- Internal conflict-link specialization.  Conflict matching replaces
trackability as the source of matching support. -/
theorem internalConflictLink_meanWindow_of_fixedChoiceGain_and_lossOverlap
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) (q s : ℕ)
    (statusLo statusHi gainDefect lossDefect : ℝ)
    {plusLo plusHi currentLo currentHi targetLo targetHi : ℝ}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusLo0 : 0 ≤ statusLo) (hstatusHi0 : 0 ≤ statusHi)
    (hstatusLo : ∀ e ∈ availableEdges H C M,
      statusLo ≤ ((availableBlockerChoices H C M e).card : ℝ))
    (hstatusHi : ∀ e ∈ availableEdges H C M,
      ((availableBlockerChoices H C M e).card : ℝ) ≤ statusHi)
    (hplus : plusLo ≤ partialTestObservable
        (conflictLinkTestWeight C f q) H C q (s + 1) M ∧
      partialTestObservable (conflictLinkTestWeight C f q)
        H C q (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable
        (conflictLinkTestWeight C f q) H C q s M ∧
      partialTestObservable (conflictLinkTestWeight C f q)
        H C q s M ≤ currentHi)
    (hfixedGain :
      (∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass
          (conflictLinkTestWeight C f q) (H.powersetCard q) C e r
          (availableEdges H C M) M (s + 1)) ≤ gainDefect)
    (hlossOverlap : weightedPartialTestLossCollision
      (conflictLinkTestWeight C f q) H C M q s ≤ lossDefect)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        ((s + 1 : ℕ) : ℝ) * plusLo - gainDefect -
          (s : ℝ) * statusHi * currentHi)
    (hnumericUpper :
      ((s + 1 : ℕ) : ℝ) * plusHi -
          ((s : ℝ) * statusLo * currentLo - lossDefect) ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain (conflictLinkTestWeight C f q)
          H C q s M -
        meanPartialTestLoss (conflictLinkTestWeight C f q) H C q s M ∧
      meanPartialTestGain (conflictLinkTestWeight C f q) H C q s M -
        meanPartialTestLoss (conflictLinkTestWeight C f q) H C q s M ≤
          targetHi := by
  apply partialTest_meanWindow_of_fixedChoiceGain_and_lossOverlap
    (conflictLinkTestWeight C f q) H C M q s
      statusLo statusHi gainDefect lossDefect
      (conflictLinkTestWeight_nonneg_sharp C f q)
      (fun T _ hpos ↦
        conflictLinkTestWeight_matching_of_pos_sharp hmatching hpos)
      hCcard hq1 hq3 hA hstatusLo0 hstatusHi0 hstatusLo hstatusHi
      hplus hcurrent hfixedGain hlossOverlap hnumericLower hnumericUpper
noncomputable def certificateTestStatusLo
    (D₂ D₃ D₄ GammaCore epsilonCore d N codegreeHi duplicateHi : ℝ)
    (k : ℕ) : ℝ :=
  8 * (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
      CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore
        d N (k : ℝ)) -
    28 * codegreeHi +
    CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) -
    degreeInternalCorridorError D₂ D₃ D₄ GammaCore epsilonCore d N k -
    duplicateHi

noncomputable def certificateTestStatusHi
    (D₂ D₃ D₄ GammaCore epsilonCore d N : ℝ) (k : ℕ) : ℝ :=
  8 * (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
      CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore
        d N (k : ℝ)) +
    CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
    degreeInternalCorridorError D₂ D₃ D₄ GammaCore epsilonCore d N k

/-- The certificate corridors give the exact full blocker-status window.
The only additional state coordinate is the one-open duplicate correction
`internalOpenLinkMass - openConflictCount`; it is supplied by the dynamic
`C_{f,2}` hierarchy. -/
theorem availableBlockerChoices_bounds_of_certificateGoodWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N codegreeHi duplicateHi : ℝ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ root, root.card = 2 →
      (codegree H root : ℝ) ≤ codegreeHi)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M)
    {f : Finset V} (hf : f ∈ availableEdges H R.regularized M)
    (hduplicate :
      (internalOpenLinkMass R.regularized
          (availableEdges H R.regularized M) M f : ℝ) -
        (openConflictCount R.regularized
          (availableEdges H R.regularized M) M f : ℝ) ≤ duplicateHi) :
    certificateTestStatusLo D₂ D₃ D₄ GammaCore epsilonCore
          d N codegreeHi duplicateHi k ≤
        ((availableBlockerChoices H R.regularized M f).card : ℝ) ∧
      ((availableBlockerChoices H R.regularized M f).card : ℝ) ≤
        certificateTestStatusHi D₂ D₃ D₄ GammaCore epsilonCore d N k := by
  have hdegreeWithin := availableDegreeWithin_of_indexedRegularizedGreedyGood
    H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
      j R.restrictedWeight hgood
  have hdegree : ∀ v ∈ f,
      CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
          CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore
            d N (k : ℝ) ≤
        (degree (availableEdges H R.regularized M) v : ℝ) ∧
      (degree (availableEdges H R.regularized M) v : ℝ) ≤
        CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
          CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore
            d N (k : ℝ) := by
    intro v hvf
    apply hdegreeWithin v
    apply vertexFinset_availableEdges_subset_uncovered H R.regularized M
    exact mem_vertexFinset.mpr ⟨f, hf, hvf⟩
  have hcodegreeAvailable : ∀ root, root.card = 2 →
      (codegree (availableEdges H R.regularized M) root : ℝ) ≤
        codegreeHi := by
    intro root hroot
    have hsub := codegree_mono_hypergraph
      (availableEdges_subset H R.regularized M) root
    have hsubR :
        (codegree (availableEdges H R.regularized M) root : ℝ) ≤
          (codegree H root : ℝ) := by exact_mod_cast hsub
    exact hsubR.trans (hcodegree root hroot)
  have hlinks :=
    internalOpenLink_bounds_of_certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N hgood
  have h₁ := hlinks.1 f hf
  have h₂ := hlinks.2.1 f hf
  have h₃ := hlinks.2.2 f hf
  have hcenter := CFMTrajectories.internalLinkCenters_sum_eq_cHat
    D₂ D₃ D₄ d N (k : ℝ)
  have hlink :
      CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) -
          degreeInternalCorridorError
            D₂ D₃ D₄ GammaCore epsilonCore d N k ≤
        (internalOpenLinkMass R.regularized
          (availableEdges H R.regularized M) M f : ℝ) ∧
      (internalOpenLinkMass R.regularized
          (availableEdges H R.regularized M) M f : ℝ) ≤
        CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
          degreeInternalCorridorError
            D₂ D₃ D₄ GammaCore epsilonCore d N k := by
    simp only [internalOpenLinkMass, Nat.cast_add] at h₁ h₂ h₃ ⊢
    unfold degreeInternalCorridorError
    constructor <;> linarith
  have hs := availableBlockerChoices_bounds_of_openCollision
    hH8 (fun c hc ↦ R.bounded.conflict_card hc) hf
      hdegree hcodegreeAvailable hlink hduplicate
  unfold certificateTestStatusLo certificateTestStatusHi
  constructor
  · linarith [hs.1]
  · linarith [hs.2]
theorem weightedPartialTestLossCollision_le_sharpFourParts
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {j s : ℕ}
    (hw : ∀ S, 0 ≤ w S) (hHne : ∀ e ∈ H, e.Nonempty) :
    weightedPartialTestLossCollision w H C M j s ≤
      weightedTestLossMMMass w H C M j s +
        weightedTestLossMCMass w H C M j s +
        weightedTestLossCMMass w H C M j s +
        weightedTestLossCCMass w H C M j s := by
  change sharpWeightedPartialTestLossCollision w H C M j s ≤ _
  exact sharpWeightedPartialTestLossCollision_le_MM_MC_CM_CC hw hHne

/-- The sharp external-test mean window after the loss correction has
been split into its exact MM/MC/CM/CC source terms.  The four hypotheses
are intended to be discharged by the host-codegree, local-link, and
rerooted `Z_{g,2}` coordinates; no coarse `choose 2 * maxOverlap` bound is
introduced here. -/
theorem partialTest_meanWindow_of_fixedChoiceGain_and_lossFourParts
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (statusLo statusHi gainDefect mmDefect mcDefect cmDefect ccDefect : ℝ)
    {plusLo plusHi currentLo currentHi targetLo targetHi : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ T ∈ H.powersetCard j,
      0 < w T → IsMatching H T)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hHne : ∀ e ∈ H, e.Nonempty)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusLo0 : 0 ≤ statusLo) (hstatusHi0 : 0 ≤ statusHi)
    (hstatusLo : ∀ f ∈ availableEdges H C M,
      statusLo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi)
    (hplus : plusLo ≤ partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤ currentHi)
    (hfixedGain :
      (∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass
          w (H.powersetCard j) C e r
          (availableEdges H C M) M (s + 1)) ≤ gainDefect)
    (hMM : weightedTestLossMMMass w H C M j s ≤ mmDefect)
    (hMC : weightedTestLossMCMass w H C M j s ≤ mcDefect)
    (hCM : weightedTestLossCMMass w H C M j s ≤ cmDefect)
    (hCC : weightedTestLossCCMass w H C M j s ≤ ccDefect)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        ((s + 1 : ℕ) : ℝ) * plusLo - gainDefect -
          (s : ℝ) * statusHi * currentHi)
    (hnumericUpper :
      ((s + 1 : ℕ) : ℝ) * plusHi -
          ((s : ℝ) * statusLo * currentLo -
            (mmDefect + mcDefect + cmDefect + ccDefect)) ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ targetHi := by
  apply partialTest_meanWindow_of_fixedChoiceGain_and_lossOverlap
    w H C M j s statusLo statusHi gainDefect
      (mmDefect + mcDefect + cmDefect + ccDefect)
      hw hmatchingPos hCcard hj1 hj3 hA hstatusLo0 hstatusHi0
      hstatusLo hstatusHi hplus hcurrent hfixedGain
  · calc
      weightedPartialTestLossCollision w H C M j s ≤
          weightedTestLossMMMass w H C M j s +
            weightedTestLossMCMass w H C M j s +
            weightedTestLossCMMass w H C M j s +
            weightedTestLossCCMass w H C M j s :=
        weightedPartialTestLossCollision_le_sharpFourParts hw hHne
      _ ≤ mmDefect + mcDefect + cmDefect + ccDefect := by linarith
  · exact hnumericLower
  · exact hnumericUpper

/-- Trackable public-test specialization of the four-part sharp consumer.
All geometric support and nonnegativity hypotheses come from W0. -/
theorem partialTest_meanWindow_of_fixedChoiceGain_and_lossFourParts_trackable
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j ell s : ℕ) (d eta : ℝ)
    (statusLo statusHi gainDefect mmDefect mcDefect cmDefect ccDefect : ℝ)
    {plusLo plusHi currentLo currentHi targetLo targetHi : ℝ}
    (hw : IsTrackable H C j ell d eta w)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hHne : ∀ e ∈ H, e.Nonempty)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusLo0 : 0 ≤ statusLo) (hstatusHi0 : 0 ≤ statusHi)
    (hstatusLo : ∀ f ∈ availableEdges H C M,
      statusLo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi)
    (hplus : plusLo ≤ partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤ currentHi)
    (hfixedGain :
      (∑ e ∈ availableEdges H C M, ∑ r ∈ Finset.Icc 1 5,
        weightedChoiceTestConflictUnionPartialMass
          w (H.powersetCard j) C e r
          (availableEdges H C M) M (s + 1)) ≤ gainDefect)
    (hMM : weightedTestLossMMMass w H C M j s ≤ mmDefect)
    (hMC : weightedTestLossMCMass w H C M j s ≤ mcDefect)
    (hCM : weightedTestLossCMMass w H C M j s ≤ cmDefect)
    (hCC : weightedTestLossCCMass w H C M j s ≤ ccDefect)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        ((s + 1 : ℕ) : ℝ) * plusLo - gainDefect -
          (s : ℝ) * statusHi * currentHi)
    (hnumericUpper :
      ((s + 1 : ℕ) : ℝ) * plusHi -
          ((s : ℝ) * statusLo * currentLo -
            (mmDefect + mcDefect + cmDefect + ccDefect)) ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ targetHi := by
  apply partialTest_meanWindow_of_fixedChoiceGain_and_lossFourParts
    w H C M j s statusLo statusHi gainDefect
      mmDefect mcDefect cmDefect ccDefect
      hw.isTestFunction.nonneg
      (fun T _ hpos ↦ by
        by_contra hnot
        have hz := hw.isTestFunction.eq_zero_of_not_matching hnot
        linarith)
      hCcard hj1 hj3 hHne hA hstatusLo0 hstatusHi0
      hstatusLo hstatusHi hplus hcurrent hfixedGain
      hMM hMC hCM hCC hnumericLower hnumericUpper
theorem commonConflictBlocker_mem_rerootedPartial_with_member
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f g h : Finset V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hfA : f ∈ availableEdges H C M)
    (hgA : g ∈ availableEdges H C M)
    (hhF : h ∈ conflictBlockerChoices C M (availableEdges H C M) f)
    (hhG : h ∈ conflictBlockerChoices C M (availableEdges H C M) g) :
    ∃ q ∈ Finset.Icc 1 3, ∃ r ∈ Finset.Icc 1 5,
      ∃ U ∈ partialFamily
        (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
        (availableEdges H C M) M 1, h ∈ U := by
  let A := availableEdges H C M
  obtain ⟨cF, hcFC, hcFsub, hfF, hhFc, hhf⟩ :=
    ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices hfA hhF
  obtain ⟨cG, hcGC, hcGsub, hgG, hhGc, hhg⟩ :=
    ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices hgA hhG
  let QF := cF.erase f
  let QG := cG.erase g
  let U := QF ∪ QG
  let q := QF.card
  let r := U.card
  have hhA : h ∈ A := (Finset.mem_filter.mp hhF).1
  have hQFsub : QF ⊆ insert h M := by
    intro x hx
    have hxf : x ≠ f := (Finset.mem_erase.mp hx).1
    have hxc : x ∈ cF := (Finset.mem_erase.mp hx).2
    rcases Finset.mem_insert.mp (hcFsub hxc) with hxf' | hxrest
    · exact False.elim (hxf hxf')
    · exact hxrest
  have hQGsub : QG ⊆ insert h M := by
    intro x hx
    have hxg : x ≠ g := (Finset.mem_erase.mp hx).1
    have hxc : x ∈ cG := (Finset.mem_erase.mp hx).2
    rcases Finset.mem_insert.mp (hcGsub hxc) with hxg' | hxrest
    · exact False.elim (hxg hxg')
    · exact hxrest
  have hUsub : U ⊆ insert h M := Finset.union_subset hQFsub hQGsub
  have hhQF : h ∈ QF := Finset.mem_erase.mpr ⟨hhf, hhFc⟩
  have hhQG : h ∈ QG := Finset.mem_erase.mpr ⟨hhg, hhGc⟩
  have hhU : h ∈ U := Finset.mem_union_left QG hhQF
  have hUlayer : U ∈
      testConflictUnionLayer (conflictLinkLayer C f q) C g r := by
    simpa only [QF, QG, U, q, r] using
      conflictPair_reroot_mem_testConflictUnionLayer
        hcFC hcGC hfF hhFc hgG hhGc hhf hhg
  have hUpartial : U ∈ partialFamily
      (testConflictUnionLayer (conflictLinkLayer C f q) C g r) A M 1 :=
    mem_partialFamily_one_of_subset_insert hUlayer hUsub hhU hhA
      (by simpa only [A] using availableEdges_disjoint_selected H C M)
  have hqPos : 1 ≤ q := Finset.card_pos.mpr ⟨h, hhQF⟩
  have hq3 : q ≤ 3 := by
    have hErase := Finset.card_erase_add_one hfF
    have hc4 := (hCcard cF hcFC).2
    simpa only [q, QF] using (show (cF.erase f).card ≤ 3 by omega)
  have hqG3 : QG.card ≤ 3 := by
    have hErase := Finset.card_erase_add_one hgG
    have hc4 := (hCcard cG hcGC).2
    simpa only [QG] using (show (cG.erase g).card ≤ 3 by omega)
  have hrPos : 1 ≤ r := Finset.card_pos.mpr ⟨h, hhU⟩
  have hr5 : r ≤ 5 := by
    have hInter : 1 ≤ (QF ∩ QG).card :=
      Finset.card_pos.mpr ⟨h, Finset.mem_inter.mpr ⟨hhQF, hhQG⟩⟩
    have hUnionCard := Finset.card_union_add_card_inter QF QG
    dsimp only [r, U]
    omega
  exact ⟨q, Finset.mem_Icc.mpr ⟨hqPos, hq3⟩,
    r, Finset.mem_Icc.mpr ⟨hrPos, hr5⟩, U, hUpartial, hhU⟩

/-- Fixed oriented pair version of the CC reroot charge.  The map from a
common blocker to its chosen rerooted union is injective because every
target has exactly one available member and that member is the blocker. -/
theorem blockerPairCC_le_rerootedPartialMass
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {f g : Finset V}
    (hfA : f ∈ availableEdges H C M)
    (hgA : g ∈ availableEdges H C M) :
    blockerPairCC H C M f g ≤
      ∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
        (partialFamily
          (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
          (availableEdges H C M) M 1).card := by
  let A := availableEdges H C M
  let B := conflictBlockerChoices C M A f ∩ conflictBlockerChoices C M A g
  let X := (Finset.Icc 1 3).biUnion fun q ↦
    (Finset.Icc 1 5).biUnion fun r ↦
      partialFamily (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
        A M 1
  have hwitness : ∀ h ∈ B, ∃ U ∈ X, h ∈ U := by
    intro h hhB
    have hh := Finset.mem_inter.mp hhB
    obtain ⟨q, hq, r, hr, U, hU, hhU⟩ :=
      commonConflictBlocker_mem_rerootedPartial_with_member
        hCcard hfA hgA hh.1 hh.2
    exact ⟨U, Finset.mem_biUnion.mpr
      ⟨q, hq, Finset.mem_biUnion.mpr ⟨r, hr, hU⟩⟩, hhU⟩
  let F : Finset V → Hypergraph V := fun h ↦
    if hh : h ∈ B then Classical.choose (hwitness h hh) else ∅
  have hFmem : ∀ h ∈ B, F h ∈ X := by
    intro h hh
    simp only [F, dif_pos hh]
    exact (Classical.choose_spec (hwitness h hh)).1
  have hhF : ∀ h ∈ B, h ∈ F h := by
    intro h hh
    simp only [F, dif_pos hh]
    exact (Classical.choose_spec (hwitness h hh)).2
  have hFAeq : ∀ h ∈ B, F h ∩ A = {h} := by
    intro h hh
    have hFX := hFmem h hh
    obtain ⟨q, hq, hFq⟩ := Finset.mem_biUnion.mp hFX
    obtain ⟨r, hr, hFpartial⟩ := Finset.mem_biUnion.mp hFq
    have hcard : (F h ∩ A).card = 1 :=
      (mem_partialFamily.mp hFpartial).2.1
    have hhA : h ∈ A :=
      (Finset.mem_filter.mp (Finset.mem_inter.mp hh).1).1
    have hhInter : h ∈ F h ∩ A := Finset.mem_inter.mpr ⟨hhF h hh, hhA⟩
    obtain ⟨a, ha⟩ := Finset.card_eq_one.mp hcard
    have hha : h = a := Finset.mem_singleton.mp (ha ▸ hhInter)
    simpa [hha] using ha
  have hFinj : Set.InjOn F (B : Set (Finset V)) := by
    intro h hh h' hh' heq
    have hEqInter : F h ∩ A = F h' ∩ A := by rw [heq]
    rw [hFAeq h hh, hFAeq h' hh'] at hEqInter
    simpa using hEqInter
  have hcardImage : B.card = (B.image F).card := by
    symm
    exact Finset.card_image_iff.mpr (by
      intro h hh h' hh' heq
      exact hFinj hh hh' heq)
  have himageSub : B.image F ⊆ X := by
    intro U hU
    obtain ⟨h, hhB, rfl⟩ := Finset.mem_image.mp hU
    exact hFmem h hhB
  unfold blockerPairCC
  change B.card ≤ _
  rw [hcardImage]
  calc
    (B.image F).card ≤ X.card := Finset.card_le_card himageSub
    _ ≤ ∑ q ∈ Finset.Icc 1 3,
          ((Finset.Icc 1 5).biUnion fun r ↦
            partialFamily
              (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
              A M 1).card := Finset.card_biUnion_le
    _ ≤ ∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
            A M 1).card := by
      apply Finset.sum_le_sum
      intro q hq
      exact Finset.card_biUnion_le

theorem localSpreadStrongTail_smallJump_scale
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    240 * Real.rpow d (CFMNumeric.tailPower eta) *
        localSpreadSmallJump eta d ≤
      localSpreadDerivativeMargin eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hpower := localSpread_common_tail_power E S
  unfold localSpreadSmallJump localSpreadDerivativeMargin
  apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 16)).2
  calc
    (240 * Real.rpow d (CFMNumeric.tailPower eta) *
          Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) * 16 =
        (3840 * Real.rpow d (CFMNumeric.tailPower eta)) *
          Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by ring
    _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 2) *
          Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) :=
      mul_le_mul_of_nonneg_right hpower (Real.rpow_nonneg hd.le _)
    _ = Real.rpow d
        (CFMNumeric.coreEpsilon eta / 2 +
          (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) :=
      (Real.rpow_add hd _ _).symm
    _ = Real.rpow d (1 - 3 * CFMNumeric.coreEpsilon eta / 4) := by
      congr 1
      ring

theorem localSpreadStrongTail_aggregateJump_scale
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    240 * Real.rpow d (CFMNumeric.tailPower eta) *
        localSpreadAggregateJump eta d ≤
      localSpreadAggregateMargin eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hpower := localSpread_common_tail_power E S
  unfold localSpreadAggregateJump localSpreadAggregateMargin
  apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 16)).2
  calc
    (240 * Real.rpow d (CFMNumeric.tailPower eta) *
          Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) * 16 =
        (3840 * Real.rpow d (CFMNumeric.tailPower eta)) *
          Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) := by ring
    _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 2) *
          Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) :=
      mul_le_mul_of_nonneg_right hpower (Real.rpow_nonneg hd.le _)
    _ = Real.rpow d
        (CFMNumeric.coreEpsilon eta / 2 +
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) :=
      (Real.rpow_add hd _ _).symm
    _ = Real.rpow d (2 - 3 * CFMNumeric.coreEpsilon eta / 4) := by
      congr 1
      ring

theorem localSpreadStrongTail_derivativeMargin_scale
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    360 * Real.rpow d (CFMNumeric.tailPower eta) *
        localSpreadDerivativeMargin eta d ≤
      localSpreadPrimaryMargin eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hpower := localSpread_q3_tail_power E S
  unfold localSpreadDerivativeMargin localSpreadPrimaryMargin
  calc
    360 * Real.rpow d (CFMNumeric.tailPower eta) *
          (Real.rpow d
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) =
        ((360 * Real.rpow d (CFMNumeric.tailPower eta)) *
          Real.rpow d
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16 := by ring
    _ ≤ (Real.rpow d (5 * CFMNumeric.coreEpsilon eta / 12) *
          Real.rpow d
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16 :=
      div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hpower (Real.rpow_nonneg hd.le _))
        (by norm_num)
    _ = Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) / 16 := by
      have hadd := Real.rpow_add hd
        (5 * CFMNumeric.coreEpsilon eta / 12)
        (1 - 3 * CFMNumeric.coreEpsilon eta / 4)
      calc
        (Real.rpow d (5 * CFMNumeric.coreEpsilon eta / 12) *
            Real.rpow d
              (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16 =
            Real.rpow d
              (5 * CFMNumeric.coreEpsilon eta / 12 +
                (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16 :=
          congrArg (fun x : ℝ ↦ x / 16) hadd.symm
        _ = Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) / 16 := by
          congr 2
          ring

theorem localSpreadVarianceBudget_linear_const_sum_le
    (margin drift jump timeMargin : ℝ) (T : ℕ)
    (hdrift : 0 ≤ drift) (hjump : 0 ≤ jump) (hbelow : drift ≤ jump)
    (htime : (T : ℝ) * drift ≤ timeMargin) :
    ∑ k ∈ Finset.range T,
        localSpreadVarianceBudget
          (localSpreadLinearCap margin drift) (fun _ ↦ jump) k ≤
      4 * jump * timeMargin := by
  calc
    ∑ k ∈ Finset.range T,
          localSpreadVarianceBudget
            (localSpreadLinearCap margin drift) (fun _ ↦ jump) k ≤
        ∑ _k ∈ Finset.range T, 4 * jump * drift := by
      apply Finset.sum_le_sum
      intro k hk
      unfold localSpreadVarianceBudget
      rw [localSpreadLinearCap_step]
      have hprod := mul_nonneg hdrift (sub_nonneg.mpr hbelow)
      nlinarith
    _ = 4 * jump * ((T : ℝ) * drift) := by
      simp
      ring
    _ ≤ 4 * jump * timeMargin :=
      mul_le_mul_of_nonneg_left htime
        (mul_nonneg (by norm_num) hjump)

theorem localSpreadVarianceBudget_linear_variable_sum_le
    (margin drift jumpMax timeMargin : ℝ) (jump : ℕ → ℝ) (T : ℕ)
    (hdrift : 0 ≤ drift) (hjumpMax : 0 ≤ jumpMax)
    (hjump : ∀ k, k < T → jump k ≤ jumpMax)
    (htime : (T : ℝ) * drift ≤ timeMargin) :
    ∑ k ∈ Finset.range T,
        localSpreadVarianceBudget
          (localSpreadLinearCap margin drift) jump k ≤
      2 * (jumpMax + drift) * timeMargin := by
  calc
    ∑ k ∈ Finset.range T,
          localSpreadVarianceBudget
            (localSpreadLinearCap margin drift) jump k ≤
        ∑ _k ∈ Finset.range T,
          2 * (jumpMax + drift) * drift := by
      apply Finset.sum_le_sum
      intro k hk
      unfold localSpreadVarianceBudget
      rw [localSpreadLinearCap_step]
      have hkjump := hjump k (Finset.mem_range.mp hk)
      have hmul := mul_le_mul_of_nonneg_right hkjump hdrift
      nlinarith
    _ = 2 * (jumpMax + drift) * ((T : ℝ) * drift) := by
      simp
      ring
    _ ≤ 2 * (jumpMax + drift) * timeMargin := by
      apply mul_le_mul_of_nonneg_left htime
      exact mul_nonneg (by norm_num) (add_nonneg hjumpMax hdrift)

theorem vertexLocalThroughSpreadConcreteRange_bound
    {H : Hypergraph V} {eta Gamma d N : ℝ} {T k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N)
    (hk : k < T) (a : VertexLocalThroughSpreadTailCoordinate H) :
    vertexLocalThroughSpreadConcreteJump eta d N a k +
        (vertexLocalThroughSpreadConcreteCap eta d N T a (k + 1) -
          vertexLocalThroughSpreadConcreteCap eta d N T a k) ≤
      vertexLocalThroughSpreadConcreteRange eta d N T a := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hfloor : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hsmall0 : 0 ≤ localSpreadSmallDrift eta d N := by
    unfold localSpreadSmallDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hfloor.le
  have hsmall := localSpreadSmallDrift_le_jump E S hN
  have haggregate := localSpreadAggregateDrift_le_jump E S hN
  have hq3 := localSpreadQ3PrimaryDrift_le_derivativeMargin E S hN hT
  have htime := localSpreadSmallDrift_time_le_margin
    E S hNpos (Nat.cast_nonneg T) hT
  have hderivativeCap : localSpreadDerivativeCap eta d N k ≤
      2 * localSpreadDerivativeMargin eta d := by
    have hkT : (k : ℝ) ≤ (T : ℝ) := by
      exact_mod_cast Nat.le_of_lt hk
    unfold localSpreadDerivativeCap localSpreadLinearCap
    nlinarith [mul_le_mul_of_nonneg_right hkT hsmall0]
  rcases a with ⟨e, v, kind⟩
  rcases kind with z | x
  · fin_cases z
    · norm_num [vertexLocalThroughSpreadConcreteJump,
        vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteRange]
      unfold localSpreadQ2PrimaryCap
      rw [localSpreadLinearCap_step]
      linarith
    · norm_num [vertexLocalThroughSpreadConcreteJump,
        vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteRange]
      unfold localSpreadAggregateCap
      rw [localSpreadLinearCap_step]
      linarith
    · norm_num [vertexLocalThroughSpreadConcreteJump,
        vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteRange]
      unfold localSpreadQ3PrimaryCap
      rw [localSpreadLinearCap_step]
      linarith
  · simp only [vertexLocalThroughSpreadConcreteJump,
      vertexLocalThroughSpreadConcreteCap,
      vertexLocalThroughSpreadConcreteRange]
    unfold localSpreadDerivativeCap
    rw [localSpreadLinearCap_step]
    linarith

theorem vertexLocalThroughSpreadConcreteVariance_sum_bound
    {H : Hypergraph V} {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    ∑ k ∈ Finset.range T,
        localSpreadVarianceBudget
          (vertexLocalThroughSpreadConcreteCap eta d N T a)
          (vertexLocalThroughSpreadConcreteJump eta d N a) k ≤
      vertexLocalThroughSpreadConcreteVariance eta d N T a := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hfloor : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hsmall0 : 0 ≤ localSpreadSmallDrift eta d N := by
    unfold localSpreadSmallDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hfloor.le
  have haggregate0 : 0 ≤ localSpreadAggregateDrift eta d N := by
    unfold localSpreadAggregateDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hfloor.le
  have hsmallJump0 : 0 ≤ localSpreadSmallJump eta d :=
    Real.rpow_nonneg hd.le _
  have haggregateJump0 : 0 ≤ localSpreadAggregateJump eta d :=
    Real.rpow_nonneg hd.le _
  have hderivativeMargin0 : 0 ≤ localSpreadDerivativeMargin eta d := by
    unfold localSpreadDerivativeMargin
    exact div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num)
  have hsmall := localSpreadSmallDrift_le_jump E S hN
  have haggregate := localSpreadAggregateDrift_le_jump E S hN
  have hsmallTime := localSpreadSmallDrift_time_le_margin
    E S hNpos (Nat.cast_nonneg T) hT
  have haggregateTime := localSpreadAggregateDrift_time_le_margin
    E S hNpos (Nat.cast_nonneg T) hT
  have hq3Time := localSpreadQ3PrimaryDrift_time_le_margin E S hNpos hT
  have hderivativeCap : ∀ k, k < T →
      localSpreadDerivativeCap eta d N k ≤
        2 * localSpreadDerivativeMargin eta d := by
    intro k hk
    have hkT : (k : ℝ) ≤ (T : ℝ) := by
      exact_mod_cast Nat.le_of_lt hk
    unfold localSpreadDerivativeCap localSpreadLinearCap
    nlinarith [mul_le_mul_of_nonneg_right hkT hsmall0]
  rcases a with ⟨e, v, kind⟩
  rcases kind with z | x
  · fin_cases z
    · simpa [vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteJump,
        vertexLocalThroughSpreadConcreteVariance,
        localSpreadQ2PrimaryCap] using
        localSpreadVarianceBudget_linear_const_sum_le
          (localSpreadPrimaryMargin eta d)
          (localSpreadSmallDrift eta d N)
          (localSpreadSmallJump eta d)
          (localSpreadDerivativeMargin eta d) T
          hsmall0 hsmallJump0 hsmall hsmallTime
    · simpa [vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteJump,
        vertexLocalThroughSpreadConcreteVariance,
        localSpreadAggregateCap] using
        localSpreadVarianceBudget_linear_const_sum_le
          (localSpreadAggregateMargin eta d)
          (localSpreadAggregateDrift eta d N)
          (localSpreadAggregateJump eta d)
          (localSpreadAggregateMargin eta d) T
          haggregate0 haggregateJump0 haggregate haggregateTime
    · simpa [vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteJump,
        vertexLocalThroughSpreadConcreteVariance,
        localSpreadQ3PrimaryCap] using
        localSpreadVarianceBudget_linear_variable_sum_le
          (localSpreadPrimaryMargin eta d)
          (localSpreadQ3PrimaryDrift eta d N T)
          (2 * localSpreadDerivativeMargin eta d)
          (localSpreadPrimaryMargin eta d)
          (localSpreadDerivativeCap eta d N) T
          (by
            unfold localSpreadQ3PrimaryDrift
            exact div_nonneg
              (mul_nonneg (by norm_num)
                (by
                  unfold localSpreadAggregateCap localSpreadLinearCap
                  exact add_nonneg
                    (by
                      unfold localSpreadAggregateMargin
                      exact div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
                    (mul_nonneg (Nat.cast_nonneg T) haggregate0)))
              hfloor.le)
          (mul_nonneg (by norm_num) hderivativeMargin0)
          hderivativeCap hq3Time
  · simpa only [vertexLocalThroughSpreadConcreteCap,
      vertexLocalThroughSpreadConcreteJump,
      vertexLocalThroughSpreadConcreteVariance,
      localSpreadDerivativeCap] using
      localSpreadVarianceBudget_linear_const_sum_le
        (localSpreadDerivativeMargin eta d)
        (localSpreadSmallDrift eta d N)
        (localSpreadSmallJump eta d)
        (localSpreadDerivativeMargin eta d) T
        hsmall0 hsmallJump0 hsmall hsmallTime

theorem localSpreadFreedmanRatio_two_four
    {tau jump margin timeMargin : ℝ}
    (htau : 0 ≤ tau) (hjump : 0 < jump) (hmargin : 0 < margin)
    (htime : 0 ≤ timeMargin) (htimeMargin : timeMargin ≤ margin)
    (hscale : 240 * tau * jump ≤ margin) :
    10 * tau ≤
      margin ^ 2 /
        (4 * (4 * jump * timeMargin + (2 * jump) * margin)) := by
  have hden : 0 < 4 * jump * timeMargin + (2 * jump) * margin := by
    have : 0 < (2 * jump) * margin :=
      mul_pos (mul_pos (by norm_num : (0 : ℝ) < 2) hjump) hmargin
    nlinarith [mul_nonneg
      (mul_nonneg (by norm_num : (0 : ℝ) ≤ 4) hjump.le) htime]
  apply (le_div_iff₀ (mul_pos (by norm_num) hden)).2
  have hdenUpper :
      4 * jump * timeMargin + (2 * jump) * margin ≤
        6 * jump * margin := by
    have hm := mul_le_mul_of_nonneg_left htimeMargin
      (mul_nonneg (by norm_num : (0 : ℝ) ≤ 4) hjump.le)
    nlinarith
  calc
    10 * tau *
          (4 * (4 * jump * timeMargin + (2 * jump) * margin)) ≤
        10 * tau * (4 * (6 * jump * margin)) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hdenUpper (by norm_num))
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 10) htau)
    _ = (240 * tau * jump) * margin := by ring
    _ ≤ margin * margin :=
      mul_le_mul_of_nonneg_right hscale hmargin.le
    _ = margin ^ 2 := by ring

theorem localSpreadFreedmanRatio_q3
    {tau derivativeMargin primaryMargin drift : ℝ}
    (htau : 0 ≤ tau) (hderivative : 0 < derivativeMargin)
    (hprimary : 0 < primaryMargin) (hdrift : 0 ≤ drift)
    (hdriftLe : drift ≤ derivativeMargin)
    (hscale : 360 * tau * derivativeMargin ≤ primaryMargin) :
    10 * tau ≤
      primaryMargin ^ 2 /
        (4 *
          (2 * (2 * derivativeMargin + drift) * primaryMargin +
            (2 * derivativeMargin + drift) * primaryMargin)) := by
  have hRpos : 0 < 2 * derivativeMargin + drift := by nlinarith
  have hden : 0 <
      2 * (2 * derivativeMargin + drift) * primaryMargin +
        (2 * derivativeMargin + drift) * primaryMargin := by
    nlinarith [mul_pos hRpos hprimary]
  apply (le_div_iff₀ (mul_pos (by norm_num) hden)).2
  have hRle : 2 * derivativeMargin + drift ≤ 3 * derivativeMargin := by
    linarith
  have hdenUpper :
      2 * (2 * derivativeMargin + drift) * primaryMargin +
          (2 * derivativeMargin + drift) * primaryMargin ≤
        9 * derivativeMargin * primaryMargin := by
    have hm := mul_le_mul_of_nonneg_right hRle hprimary.le
    nlinarith
  calc
    10 * tau *
          (4 *
            (2 * (2 * derivativeMargin + drift) * primaryMargin +
              (2 * derivativeMargin + drift) * primaryMargin)) ≤
        10 * tau * (4 * (9 * derivativeMargin * primaryMargin)) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hdenUpper (by norm_num))
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 10) htau)
    _ = (360 * tau * derivativeMargin) * primaryMargin := by ring
    _ ≤ primaryMargin * primaryMargin :=
      mul_le_mul_of_nonneg_right hscale hprimary.le
    _ = primaryMargin ^ 2 := by ring

theorem vertexLocalThroughSpreadConcreteFreedmanRatio
    {H : Hypergraph V} {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    10 * Real.rpow d (CFMNumeric.tailPower eta) ≤
      (vertexLocalThroughSpreadConcreteMargin eta d a) ^ 2 /
        (4 *
          (vertexLocalThroughSpreadConcreteVariance eta d N T a +
            vertexLocalThroughSpreadConcreteRange eta d N T a *
              vertexLocalThroughSpreadConcreteMargin eta d a)) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have htau : 0 ≤ Real.rpow d (CFMNumeric.tailPower eta) :=
    Real.rpow_nonneg hd.le _
  have hsmallPos : 0 < localSpreadSmallJump eta d :=
    Real.rpow_pos_of_pos hd _
  have haggregatePos : 0 < localSpreadAggregateJump eta d :=
    Real.rpow_pos_of_pos hd _
  have hderivativePos : 0 < localSpreadDerivativeMargin eta d := by
    unfold localSpreadDerivativeMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have haggregateMarginPos : 0 < localSpreadAggregateMargin eta d := by
    unfold localSpreadAggregateMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have hprimaryPos : 0 < localSpreadPrimaryMargin eta d := by
    unfold localSpreadPrimaryMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have hDP := localSpreadDerivativeMargin_le_primaryMargin E S
  have hsmallScale := localSpreadStrongTail_smallJump_scale E S
  have haggregateScale := localSpreadStrongTail_aggregateJump_scale E S
  have hq3Scale := localSpreadStrongTail_derivativeMargin_scale E S
  have hq3Drift := localSpreadQ3PrimaryDrift_le_derivativeMargin E S hN hT
  have hq3Drift0 : 0 ≤ localSpreadQ3PrimaryDrift eta d N T := by
    have hNpos : 0 < N :=
      (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
    have hfloor : 0 < localSpreadAvailableFloor eta d N := by
      rw [localSpreadAvailableFloor_eq_rpow hd]
      exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
    unfold localSpreadQ3PrimaryDrift localSpreadAggregateCap
      localSpreadLinearCap localSpreadAggregateMargin
    exact div_nonneg
      (mul_nonneg (by norm_num)
        (add_nonneg
          (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
          (mul_nonneg (Nat.cast_nonneg T)
            (by
              unfold localSpreadAggregateDrift
              exact div_nonneg
                (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
                hfloor.le))))
      hfloor.le
  rcases a with ⟨e, v, kind⟩
  rcases kind with z | x
  · fin_cases z
    · norm_num [vertexLocalThroughSpreadConcreteMargin,
        vertexLocalThroughSpreadConcreteVariance,
        vertexLocalThroughSpreadConcreteRange]
      exact localSpreadFreedmanRatio_two_four htau hsmallPos hprimaryPos
        (by unfold localSpreadDerivativeMargin; positivity) hDP
        (hsmallScale.trans hDP)
    · norm_num [vertexLocalThroughSpreadConcreteMargin,
        vertexLocalThroughSpreadConcreteVariance,
        vertexLocalThroughSpreadConcreteRange]
      exact localSpreadFreedmanRatio_two_four htau haggregatePos
        haggregateMarginPos (by exact haggregateMarginPos.le) le_rfl
        haggregateScale
    · norm_num [vertexLocalThroughSpreadConcreteMargin,
        vertexLocalThroughSpreadConcreteVariance,
        vertexLocalThroughSpreadConcreteRange]
      exact localSpreadFreedmanRatio_q3 htau hderivativePos hprimaryPos
        hq3Drift0 hq3Drift hq3Scale
  · simp only [vertexLocalThroughSpreadConcreteMargin,
      vertexLocalThroughSpreadConcreteVariance,
      vertexLocalThroughSpreadConcreteRange]
    exact localSpreadFreedmanRatio_two_four htau hsmallPos hderivativePos
      (by unfold localSpreadDerivativeMargin; positivity) le_rfl hsmallScale

theorem vertexLocalThroughSpreadConcreteInitialGap
    (H : Hypergraph V) (C : ConflictSystem V) (eta d N : ℝ) (T : ℕ)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    localSpreadUpperError
        (vertexLocalThroughSpreadTailBaseWeight H C a)
        (vertexLocalThroughSpreadTailRank a)
        (vertexLocalThroughSpreadConcreteCap eta d N T a) 0 ∅ ≤
      -vertexLocalThroughSpreadConcreteMargin eta d a := by
  rcases a with ⟨e, v, kind⟩
  rcases kind with z | x
  · fin_cases z <;>
      norm_num [localSpreadUpperError, testTotal,
        vertexLocalThroughSpreadTailRank,
        vertexLocalThroughSpreadTailBaseWeight,
        vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteMargin,
        localSpreadQ2PrimaryCap, localSpreadAggregateCap,
        localSpreadQ3PrimaryCap, localSpreadLinearCap] <;>
      rw [(powersetCard_eq_empty).2 (by norm_num)] <;> simp
  · norm_num [localSpreadUpperError, testTotal,
      vertexLocalThroughSpreadTailRank,
      vertexLocalThroughSpreadTailBaseWeight,
      vertexLocalThroughSpreadConcreteCap,
      vertexLocalThroughSpreadConcreteMargin,
      localSpreadDerivativeCap, localSpreadLinearCap]
    rw [(powersetCard_eq_empty).2 (by norm_num)]
    simp

theorem localSpreadQ3PrimaryDrift_nonneg
    {eta Gamma d N : ℝ} {T : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) :
    0 ≤ localSpreadQ3PrimaryDrift eta d N T := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hfloor : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have haggregateDrift : 0 ≤ localSpreadAggregateDrift eta d N := by
    unfold localSpreadAggregateDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hfloor.le
  unfold localSpreadQ3PrimaryDrift localSpreadAggregateCap
    localSpreadLinearCap localSpreadAggregateMargin
  exact div_nonneg
    (mul_nonneg (by norm_num)
      (add_nonneg
        (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
        (mul_nonneg (Nat.cast_nonneg T) haggregateDrift)))
    hfloor.le

theorem vertexLocalThroughSpreadConcreteParameters
    {H : Hypergraph V} {eta Gamma d N : ℝ} {T : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    0 ≤ vertexLocalThroughSpreadConcreteRange eta d N T a ∧
      0 ≤ vertexLocalThroughSpreadConcreteMargin eta d a ∧
      0 ≤ vertexLocalThroughSpreadConcreteVariance eta d N T a ∧
      0 < vertexLocalThroughSpreadConcreteVariance eta d N T a +
        vertexLocalThroughSpreadConcreteRange eta d N T a *
          vertexLocalThroughSpreadConcreteMargin eta d a := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hsmall : 0 < localSpreadSmallJump eta d :=
    Real.rpow_pos_of_pos hd _
  have haggregate : 0 < localSpreadAggregateJump eta d :=
    Real.rpow_pos_of_pos hd _
  have hderivative : 0 < localSpreadDerivativeMargin eta d := by
    unfold localSpreadDerivativeMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have haggregateMargin : 0 < localSpreadAggregateMargin eta d := by
    unfold localSpreadAggregateMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have hprimary : 0 < localSpreadPrimaryMargin eta d := by
    unfold localSpreadPrimaryMargin
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have hq3 : 0 ≤ localSpreadQ3PrimaryDrift eta d N T :=
    localSpreadQ3PrimaryDrift_nonneg S hN
  rcases a with ⟨e, v, kind⟩
  rcases kind with z | x
  · fin_cases z
    · norm_num [vertexLocalThroughSpreadConcreteRange,
        vertexLocalThroughSpreadConcreteMargin,
        vertexLocalThroughSpreadConcreteVariance]
      exact ⟨hsmall.le, hprimary.le,
        mul_nonneg (mul_nonneg (by norm_num) hsmall.le) hderivative.le,
        add_pos_of_nonneg_of_pos
          (mul_nonneg (mul_nonneg (by norm_num) hsmall.le) hderivative.le)
          (mul_pos (mul_pos (by norm_num) hsmall) hprimary)⟩
    · norm_num [vertexLocalThroughSpreadConcreteRange,
        vertexLocalThroughSpreadConcreteMargin,
        vertexLocalThroughSpreadConcreteVariance]
      exact ⟨haggregate.le, haggregateMargin.le,
        mul_nonneg (mul_nonneg (by norm_num) haggregate.le)
          haggregateMargin.le,
        add_pos_of_nonneg_of_pos
          (mul_nonneg (mul_nonneg (by norm_num) haggregate.le)
            haggregateMargin.le)
          (mul_pos (mul_pos (by norm_num) haggregate) haggregateMargin)⟩
    · norm_num [vertexLocalThroughSpreadConcreteRange,
        vertexLocalThroughSpreadConcreteMargin,
        vertexLocalThroughSpreadConcreteVariance]
      have hR : 0 < 2 * localSpreadDerivativeMargin eta d +
          localSpreadQ3PrimaryDrift eta d N T := by nlinarith
      exact ⟨hR.le, hprimary.le,
        mul_nonneg (mul_nonneg (by norm_num) hR.le) hprimary.le,
        add_pos_of_nonneg_of_pos
          (mul_nonneg (mul_nonneg (by norm_num) hR.le) hprimary.le)
          (mul_pos hR hprimary)⟩
  · simp only [vertexLocalThroughSpreadConcreteRange,
      vertexLocalThroughSpreadConcreteMargin,
      vertexLocalThroughSpreadConcreteVariance]
    exact ⟨mul_nonneg (by norm_num) hsmall.le, hderivative.le,
      mul_nonneg (mul_nonneg (by norm_num) hsmall.le) hderivative.le,
      add_pos_of_nonneg_of_pos
        (mul_nonneg (mul_nonneg (by norm_num) hsmall.le) hderivative.le)
        (mul_pos (mul_pos (by norm_num) hsmall) hderivative)⟩

theorem vertexLocalThroughSpreadEnhancedTailFirstFailureMass_le
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta GammaCore GammaCert d : ℝ} {T ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (hT : (T : ℝ) ≤ (vertexFinset H).card)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    Freedman.eventMass (normalizedGreedyPathMass H R.regularized)
        (greedyFirstFailureEvent H R.regularized ∅ T
          (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
            D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
              R.restrictedWeight)
          (Sum.inr (Sum.inr a))) ≤
      localSpreadStrongTail eta d := by
  let N : ℝ := (vertexFinset H).card
  let P := vertexLocalThroughSpreadEnhancedPredicate H R.regularized
    D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
      R.restrictedWeight
  let range := vertexLocalThroughSpreadConcreteRange eta d N T a
  let margin := vertexLocalThroughSpreadConcreteMargin eta d a
  let variance := vertexLocalThroughSpreadConcreteVariance eta d N T a
  have hparameters := vertexLocalThroughSpreadConcreteParameters
    (H := H) (T := T) S (N := N) (by simpa [N] using hN) a
  have hsource := vertexLocalThroughSpreadEnhancedConcreteSourceBudgets
    E S H C hH D₂ D₃ D₄ j w R hdegreeUpper hregistry a
  have hraw :
      Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
          (greedyFirstFailureEvent H R.regularized ∅ T P
            (Sum.inr (Sum.inr a))) ≤
        Real.exp (-(margin ^ 2) / (4 * (variance + range * margin))) := by
    apply localSpreadUpperFirstFailureMass_le_of_sourceBudgets
      (vertexLocalThroughSpreadTailBaseWeight H R.regularized a)
      H R.regularized ∅ T P (Sum.inr (Sum.inr a))
      (vertexLocalThroughSpreadTailRank a)
      (vertexLocalThroughSpreadConcreteCap eta d N T a)
      (vertexLocalThroughSpreadConcreteJump eta d N a)
      hsource hparameters.1 hparameters.2.1 hparameters.2.2.1
      hparameters.2.2.2
    · intro k hk
      exact vertexLocalThroughSpreadConcreteRange_bound E S
        (by simpa [N] using hN) (by simpa [N] using hT) hk a
    · exact vertexLocalThroughSpreadConcreteVariance_sum_bound E S
        (by simpa [N] using hN) (by simpa [N] using hT) a
    · intro k M
      rfl
    · exact vertexLocalThroughSpreadConcreteInitialGap
        H R.regularized eta d N T a
  have hratio : 10 * Real.rpow d (CFMNumeric.tailPower eta) ≤
      margin ^ 2 / (4 * (variance + range * margin)) := by
    exact vertexLocalThroughSpreadConcreteFreedmanRatio E S
      (by simpa [N] using hN) (by simpa [N] using hT) a
  have hstrong :
      Real.exp (-(margin ^ 2) / (4 * (variance + range * margin))) ≤
        localSpreadStrongTail eta d :=
    localSpreadStrongTail_of_freedman_ratio hparameters.2.2.2 hratio
  change Freedman.eventMass (greedyPathMassFrom H R.regularized ∅)
      (greedyFirstFailureEvent H R.regularized ∅ T P
        (Sum.inr (Sum.inr a))) ≤ localSpreadStrongTail eta d
  exact hraw.trans hstrong

noncomputable def vertexLocalThroughSpreadEnhancedLocalTail
    {H : Hypergraph V} (eta d : ℝ) :
    VertexLocalThroughSpreadLocalCoordinate H → ℝ
  | Sum.inl _ => 0
  | Sum.inr _ => localSpreadStrongTail eta d

theorem vertexLocalThroughSpreadEnhancedLocalTail_sum_le_twelfth
    [Fintype V] {eta Gamma d : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (d ^ (eta ^ 3))) :
    (∑ a : VertexLocalThroughSpreadLocalCoordinate H,
        vertexLocalThroughSpreadEnhancedLocalTail (H := H) eta d a) ≤
      1 / 12 := by
  have hfamily := localSpreadStrongTailFamilySum_le_sixth S
    (fun _a : VertexLocalThroughSpreadTailCoordinate H ↦
      localSpreadStrongTail eta d)
    (vertexLocalThroughSpreadTailCoordinate_card_le_entropy S H hH hvertex)
    (fun _ ↦ le_rfl)
  rw [Fintype.sum_sum_type]
  change (∑ _u : Unit, 0) +
      (∑ _a : VertexLocalThroughSpreadTailCoordinate H,
        localSpreadStrongTail eta d) ≤ 1 / 12
  simp only [Fintype.sum_unique, zero_add]
  nlinarith

theorem greedyTransitionMass_pos_of_greedyPathMassFrom_pos
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {T : ℕ} (omega : GreedyOutcome H T) {k : ℕ}
    (hk : k < T) (hmass : 0 < greedyPathMassFrom H C M omega) :
    0 < greedyTransitionMass H C
      (greedyStateFromAt H C M omega k) (greedyChoiceAt omega k) := by
  induction k generalizing M T with
  | zero =>
      cases T with
      | zero => omega
      | succ T =>
          have htail0 : 0 ≤ greedyPathMassFrom H C
              (greedyChoiceStep H C M (omega 0))
                (fun i ↦ omega i.succ) :=
            greedyPathMassFrom_nonneg H C _ _
          have hhead0 : 0 ≤ greedyTransitionMass H C M (omega 0) :=
            greedyTransitionMass_nonneg H C M _
          rw [greedyPathMassFrom_succ] at hmass
          have hhead : 0 < greedyTransitionMass H C M (omega 0) := by
            nlinarith
          simpa [greedyStateFromAt_zero, greedyChoiceAt] using hhead
  | succ k ih =>
      cases T with
      | zero => omega
      | succ T =>
          have hkT : k < T := by omega
          have htail0 : 0 ≤ greedyPathMassFrom H C
              (greedyChoiceStep H C M (omega 0))
                (fun i ↦ omega i.succ) :=
            greedyPathMassFrom_nonneg H C _ _
          have hhead0 : 0 ≤ greedyTransitionMass H C M (omega 0) :=
            greedyTransitionMass_nonneg H C M _
          rw [greedyPathMassFrom_succ] at hmass
          have htail : 0 < greedyPathMassFrom H C
              (greedyChoiceStep H C M (omega 0))
                (fun i ↦ omega i.succ) := by
            nlinarith
          have hrec := ih (M := greedyChoiceStep H C M (omega 0))
            (T := T) (fun i ↦ omega i.succ) hkT htail
          rw [← Fin.cons_self_tail omega,
            greedyStateFromAt_cons_succ, greedyChoiceAt_cons_succ]
          exact hrec

theorem vertexLocalThroughSpreadEnhancedGood_available_nonempty
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta GammaCore GammaCert d : ℝ} {T ell k : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hk : k < T) (M : Hypergraph V)
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
        D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
          R.restrictedWeight) k M) :
    (availableEdges H R.regularized M).Nonempty := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < ((vertexFinset H).card : ℝ) :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hfloorPos : 0 < localSpreadAvailableFloor eta d
      ((vertexFinset H).card : ℝ) := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hstep := hregistry k hk M hgood
  have hlocal := indexedVertexLocalThroughSpreadEnhancedGood_local
    H R.regularized D₂ D₃ D₄ GammaCore eta d
      (vertexFinset H).card T j R.restrictedWeight hgood
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d ((vertexFinset H).card : ℝ) T hlocal
  have hold := indexedVertexLocalThroughSpreadEnhancedGood_old
    H R.regularized D₂ D₃ D₄ GammaCore eta d
      (vertexFinset H).card T j R.restrictedWeight hgood
  have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
    H R.regularized D₂ D₃ D₄ GammaCore
      (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        j R.restrictedWeight hold
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hcovered : 8 * k ≤ (vertexFinset H).card := by
    have hb := hstep.degree.before_end (k : ℝ) hx
    exact_mod_cast hb.le
  have hcardFloor := localSpreadAvailableFloor_le_availableEdges_card S
    H R.regularized hH M hreach.1 (vertexFinset H).card k rfl
      hreach.2 hcovered hstep.degree.N_pos D₂ D₃ D₄ hstep hdegree
  apply Finset.card_pos.mp
  exact_mod_cast hfloorPos.trans_le hcardFloor

theorem vertexLocalThroughSpreadEnhancedReachableFirstFailureMass_eq_zero
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta GammaCore GammaCert d : ℝ} {T ell : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d)) :
    Freedman.eventMass (normalizedGreedyPathMass H R.regularized)
        (greedyFirstFailureEvent H R.regularized ∅ T
          (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
            D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
              R.restrictedWeight)
          (Sum.inr (Sum.inl ()))) = 0 := by
  let P := vertexLocalThroughSpreadEnhancedPredicate H R.regularized
    D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
      R.restrictedWeight
  unfold Freedman.eventMass
  apply Finset.sum_eq_zero
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hpref, hfail⟩ := homega
  by_contra hmassne
  have hmass0 : 0 ≤ normalizedGreedyPathMass H R.regularized omega :=
    normalizedGreedyPathMass_nonneg H R.regularized omega
  have hmass : 0 < normalizedGreedyPathMass H R.regularized omega :=
    lt_of_le_of_ne hmass0 (Ne.symm hmassne)
  have hgood := hpref k le_rfl
  have havailable := vertexLocalThroughSpreadEnhancedGood_available_nonempty
    S H C hH D₂ D₃ D₄ j w R hN hregistry hk
      (greedyStateFromAt H R.regularized ∅ omega k) hgood
  have htransition : 0 < greedyTransitionMass H R.regularized
      (greedyStateFromAt H R.regularized ∅ omega k)
      (greedyChoiceAt omega k) := by
    apply greedyTransitionMass_pos_of_greedyPathMassFrom_pos
      H R.regularized ∅ omega hk
    simpa [normalizedGreedyPathMass] using hmass
  have hlocal := indexedVertexLocalThroughSpreadEnhancedGood_local
    H R.regularized D₂ D₃ D₄ GammaCore eta d
      (vertexFinset H).card T j R.restrictedWeight hgood
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d ((vertexFinset H).card : ℝ) T hlocal
  have hnextCFM := greedyChoiceStep_preserves hreach.1 (greedyChoiceAt omega k)
  have hnextCard := greedyChoiceStep_card_eq_add_one_of_mass_pos
    H R.regularized (greedyStateFromAt H R.regularized ∅ omega k)
      (greedyChoiceAt omega k) havailable htransition
  apply hfail
  change IsConflictFreeMatching H R.regularized
      (greedyStateFromAt H R.regularized ∅ omega (k + 1)) ∧
    (greedyStateFromAt H R.regularized ∅ omega (k + 1)).card = k + 1
  rw [greedyStateFromAt_succ]
  refine ⟨hnextCFM, ?_⟩
  calc
    (greedyChoiceStep H R.regularized
        (greedyStateFromAt H R.regularized ∅ omega k)
        (greedyChoiceAt omega k)).card =
        (greedyStateFromAt H R.regularized ∅ omega k).card + 1 := hnextCard
    _ = k + 1 := by rw [hreach.2]

theorem vertexLocalThroughSpreadEnhancedLocalFirstFailureMass_le
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta GammaCore GammaCert d : ℝ} {T ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (D₂ D₃ D₄ : ℝ) (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (hregistry : ∀ k, k < T → ∀ M,
      indexedGreedyGood
        (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
          D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
            R.restrictedWeight) k M →
      CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ GammaCore
        (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hN : Real.rpow d eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (hT : (T : ℝ) ≤ (vertexFinset H).card)
    (a : VertexLocalThroughSpreadLocalCoordinate H) :
    Freedman.eventMass (normalizedGreedyPathMass H R.regularized)
        (greedyFirstFailureEvent H R.regularized ∅ T
          (vertexLocalThroughSpreadEnhancedPredicate H R.regularized
            D₂ D₃ D₄ GammaCore eta d (vertexFinset H).card T j
              R.restrictedWeight)
          (Sum.inr a)) ≤
      vertexLocalThroughSpreadEnhancedLocalTail (H := H) eta d a := by
  rcases a with u | a
  · rcases u with ⟨⟩
    have hzero :=
      vertexLocalThroughSpreadEnhancedReachableFirstFailureMass_eq_zero
        S H C hH D₂ D₃ D₄ j w R hN hregistry
    simpa [vertexLocalThroughSpreadEnhancedLocalTail] using hzero.le
  · simpa [vertexLocalThroughSpreadEnhancedLocalTail] using
      (vertexLocalThroughSpreadEnhancedTailFirstFailureMass_le
        E S H C hH D₂ D₃ D₄ j w R hdegreeUpper hregistry hN hT a)

theorem orientedPairCategoryMass_le_choose_two_mul_four
    (B : Hypergraph V) (K : Finset V → Finset V → ℕ) (cap : ℕ)
    (hK : ∀ f ∈ B, ∀ g ∈ B, g ≠ f → K f g ≤ cap) :
    orientedPairCategoryMass B K ≤ B.card.choose 2 * (4 * cap) := by
  unfold orientedPairCategoryMass
  calc
    (∑ p ∈ B.powersetCard 2,
        ∑ f ∈ p, ∑ g ∈ p.filter (fun g ↦ g ≠ f), K f g) ≤
        ∑ _p ∈ B.powersetCard 2, 4 * cap := by
      apply Finset.sum_le_sum
      intro p hp
      have hpdata := Finset.mem_powersetCard.mp hp
      calc
        (∑ f ∈ p, ∑ g ∈ p.filter (fun g ↦ g ≠ f), K f g) ≤
            ∑ _f ∈ p, 2 * cap := by
          apply Finset.sum_le_sum
          intro f hfp
          calc
            (∑ g ∈ p.filter (fun g ↦ g ≠ f), K f g) ≤
                ∑ _g ∈ p.filter (fun g ↦ g ≠ f), cap := by
              apply Finset.sum_le_sum
              intro g hgf
              have hgp := (Finset.mem_filter.mp hgf).1
              exact hK f (hpdata.1 hfp) g (hpdata.1 hgp)
                (Finset.mem_filter.mp hgf).2
            _ ≤ ∑ _g ∈ p, cap := by
              exact Finset.sum_le_sum_of_subset_of_nonneg
                (Finset.filter_subset _ _) (fun _ _ _ ↦ Nat.zero_le _)
            _ = 2 * cap := by simp [hpdata.2]
        _ = 4 * cap := by simp [hpdata.2]; omega
    _ = (B.powersetCard 2).card * (4 * cap) := by simp
    _ = B.card.choose 2 * (4 * cap) := by
      rw [Finset.card_powersetCard]

/-- Generic weighted aggregation of a uniform oriented-pair cap over one
partial-test coordinate. -/
theorem weighted_orientedPairCategoryMass_le
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s cap : ℕ)
    (K : Finset V → Finset V → ℕ)
    (hw : ∀ S, 0 ≤ w S)
    (hK : ∀ S ∈ H.powersetCard j, 0 < w S →
      partialTestCondition (availableEdges H C M) M j s S →
      ∀ f ∈ S ∩ availableEdges H C M,
        ∀ g ∈ S ∩ availableEdges H C M, g ≠ f → K f g ≤ cap) :
    (∑ S ∈ H.powersetCard j,
      if partialTestCondition (availableEdges H C M) M j s S then
        w S * orientedPairCategoryMass
          (S ∩ availableEdges H C M) K else 0) ≤
      (((s.choose 2 * (4 * cap) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold partialTestObservable partialTestTotal
  rw [Finset.mul_sum, Finset.sum_filter]
  apply Finset.sum_le_sum
  intro S hS
  by_cases hcoord : partialTestCondition
      (availableEdges H C M) M j s S
  · simp only [partialTestCondition] at hcoord
    simp only [Nat.cast_mul, Nat.cast_ofNat]
    by_cases hwzero : w S = 0
    · simp [hwzero]
    · have hwpos : 0 < w S := lt_of_le_of_ne (hw S) (Ne.symm hwzero)
      have hmass := orientedPairCategoryMass_le_choose_two_mul_four
        (S ∩ availableEdges H C M) K cap
        (hK S hS hwpos hcoord)
      rw [hcoord.1] at hmass
      have hmassR :
          (orientedPairCategoryMass
              (S ∩ availableEdges H C M) K : ℝ) ≤
            ((s.choose 2 * (4 * cap) : ℕ) : ℝ) := by
        exact_mod_cast hmass
      simpa only [Nat.cast_mul, Nat.cast_ofNat, mul_assoc, mul_comm,
        mul_left_comm] using mul_le_mul_of_nonneg_left hmassR (hw S)
  · simp only [partialTestCondition] at hcoord
    simp [partialTestCondition, hcoord]

theorem weightedTestLossMMMass_le_codegreeCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s codegreeHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi) :
    weightedTestLossMMMass w H C M j s ≤
      (((s.choose 2 * (4 * (64 * codegreeHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossMMMass testLossMMMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s (64 * codegreeHi) (blockerPairMM H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  have hfg : Disjoint f g :=
    (hmatchingPos S hS hpos).2
      (Finset.inter_subset_left hf) (Finset.inter_subset_left hg) hgf.symm
  have hbound := card_inter_availableMeetingChoices_le_card_mul_card_mul
    (availableEdges H C M) hfg hcodegree
  have hfcard : f.card = 8 := hH8 f (availableEdges_subset H C M hfA)
  have hgcard : g.card = 8 := hH8 g (availableEdges_subset H C M hgA)
  simpa [blockerPairMM, hfcard, hgcard, Nat.mul_assoc] using hbound

theorem weightedTestLossMCMass_le_mixedCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s mixedHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ g ∈ availableEdges H C M, ∀ v,
      CFMRegularization.conditionC4Count H C g v +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M g 2 1 v).card +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M g 3 1 v).card ≤ mixedHi) :
    weightedTestLossMCMass w H C M j s ≤
      (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossMCMass testLossMCMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s (8 * mixedHi) (blockerPairMC H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  have hbound := card_inter_meeting_conflictBlockers_le_C4_add_local
    hCcard f hgA
  calc
    blockerPairMC H C M f g ≤
        ∑ v ∈ f,
          (CFMRegularization.conditionC4Count H C g v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M g 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M g 3 1 v).card) := by
      simpa only [blockerPairMC] using hbound
    _ ≤ ∑ _v ∈ f, mixedHi := by
      apply Finset.sum_le_sum
      intro v hv
      exact hmixed g hgA v
    _ = 8 * mixedHi := by
      simp [hH8 f (availableEdges_subset H C M hfA)]

theorem weightedTestLossCMMass_le_mixedCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s mixedHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ f ∈ availableEdges H C M, ∀ v,
      CFMRegularization.conditionC4Count H C f v +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M f 2 1 v).card +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M f 3 1 v).card ≤ mixedHi) :
    weightedTestLossCMMass w H C M j s ≤
      (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossCMMass testLossCMMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s (8 * mixedHi) (blockerPairCM H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  have hbound := card_inter_meeting_conflictBlockers_le_C4_add_local
    hCcard g hfA
  calc
    blockerPairCM H C M f g ≤
        ∑ v ∈ g,
          (CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card) := by
      simpa only [blockerPairCM, Finset.inter_comm] using hbound
    _ ≤ ∑ _v ∈ g, mixedHi := by
      apply Finset.sum_le_sum
      intro v hv
      exact hmixed f hfA v
    _ = 8 * mixedHi := by
      simp [hH8 g (availableEdges_subset H C M hgA)]

theorem weightedTestLossCCMass_le_rerootedCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s ccHi : ℕ)
    (hw : ∀ S, 0 ≤ w S)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hreroot : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, g ≠ f →
        (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
            (availableEdges H C M) M 1).card) ≤ ccHi) :
    weightedTestLossCCMass w H C M j s ≤
      (((s.choose 2 * (4 * ccHi) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossCCMass testLossCCMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s ccHi (blockerPairCC H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  exact (blockerPairCC_le_rerootedPartialMass hCcard hfA hgA).trans
    (hreroot f hfA g hgA hgf)

/-- Closed exact-loss aggregate from the three uniform dynamic caps used by
the certificate Good event. -/
theorem weightedPartialTestLossCollision_le_aggregateCaps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s codegreeHi mixedHi ccHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ f ∈ availableEdges H C M, ∀ v,
      CFMRegularization.conditionC4Count H C f v +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M f 2 1 v).card +
          (localConflictLinkPartialAtVertex C
            (availableEdges H C M) M f 3 1 v).card ≤ mixedHi)
    (hreroot : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, g ≠ f →
        (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
            (availableEdges H C M) M 1).card) ≤ ccHi) :
    weightedPartialTestLossCollision w H C M j s ≤
      (((s.choose 2 *
          (4 * (64 * codegreeHi + 16 * mixedHi + ccHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  have hHne : ∀ e ∈ H, e.Nonempty := by
    intro e he
    exact Finset.card_pos.mp (by rw [hH8 e he]; norm_num)
  have hsplit := weightedPartialTestLossCollision_le_sharpFourParts
    (w := w) (H := H) (C := C) (M := M) (j := j) (s := s) hw hHne
  have hmm := weightedTestLossMMMass_le_codegreeCap
    w H C M j s codegreeHi hH8 hw hmatchingPos hcodegree
  have hmc := weightedTestLossMCMass_le_mixedCap
    w H C M j s mixedHi hH8 hw hCcard hmixed
  have hcm := weightedTestLossCMMass_le_mixedCap
    w H C M j s mixedHi hH8 hw hCcard hmixed
  have hcc := weightedTestLossCCMass_le_rerootedCap
    w H C M j s ccHi hw hCcard hreroot
  calc
    weightedPartialTestLossCollision w H C M j s ≤
        weightedTestLossMMMass w H C M j s +
          weightedTestLossMCMass w H C M j s +
          weightedTestLossCMMass w H C M j s +
          weightedTestLossCCMass w H C M j s := hsplit
    _ ≤ (((s.choose 2 * (4 * (64 * codegreeHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * ccHi) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) := by
      exact add_le_add (add_le_add (add_le_add hmm hmc) hcm) hcc
    _ = (((s.choose 2 *
          (4 * (64 * codegreeHi + 16 * mixedHi + ccHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
      push_cast
      ring

variable [Fintype V]

structure VertexDuplicateRootShadowCoordinate (H : Hypergraph V) where
  vertex : ActualHostVertex H
  layer : Fin 6
  layer_lower : 3 ≤ layer.1
  root : Hypergraph V
  rank : Fin 6
  rank_pos : 1 ≤ rank.1
  legal : root.card + rank.1 < layer.1
deriving Fintype

def vertexDuplicateRootShadowWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (a : VertexDuplicateRootShadowCoordinate H) : TestWeight V :=
  weightedConflictFamilyRootShadowWeight
    (vertexDuplicateLayerFamily H C a.vertex.1 a.layer.1)
    (vertexDuplicateLayerRepresentationWeight H C a.vertex.1 a.layer.1)
    a.root

def vertexDuplicateRootShadowRank
    {H : Hypergraph V} (a : VertexDuplicateRootShadowCoordinate H) : ℕ :=
  a.rank.1

/-- The primary duplicate margin.  The coefficient `768 = 3 * 256` is
chosen so that summing the three ranks and applying the deterministic
collision coefficient `256` produces exactly one copy of the displayed
power. -/
noncomputable def vertexDuplicatePrimaryMargin (eta d : ℝ) : ℝ :=
  Real.rpow d (2 - CFMNumeric.coreEpsilon eta / 2) / 768

/-- A cap family for all legal root-shadow ranks.  Only its primary branch
is consumed by the degree proof.  The other branch is deliberately a
root/rank-sensitive power, so the weighted successor hierarchy can later
prove the corresponding one-sided tails without changing this index. -/
noncomputable def vertexDuplicateRootShadowCap
    {H : Hypergraph V}
    (eta d : ℝ) (a : VertexDuplicateRootShadowCoordinate H) (k : ℕ) : ℝ :=
  if a.root = ∅ ∧ a.rank.1 + 1 = a.layer.1 then
    vertexDuplicatePrimaryMargin eta d
  else
    Real.rpow d
      ((a.layer.1 : ℝ) + 1 -
        CFMRegularization.rawRegularizationEps eta / 4 -
        (a.root.card : ℝ) - (a.rank.1 : ℝ) +
        (a.rank.1 : ℝ) * CFMNumeric.coreEpsilon eta / 8)

def vertexDuplicateRootShadowPredicate
    (H : Hypergraph V) (C : ConflictSystem V) (eta d : ℝ) :
    VertexDuplicateRootShadowCoordinate H → ℕ → Hypergraph V → Prop :=
  fun a k M ↦ localSpreadUpperCorridor
    (vertexDuplicateRootShadowWeight H C a)
    (vertexDuplicateRootShadowRank a)
    (vertexDuplicateRootShadowCap eta d a) k M

/-- The degree-local Good family: the already closed old/reachable/local
through-vertex components on the left and all duplicate root shadows on the
right.  Further endpoint families may append another `Sum` around this
index without affecting any theorem below. -/
abbrev DegreeEnhancedGreedyIndex
    {iota : Type*} (H : Hypergraph V) (j : iota → ℕ) :=
  Sum (VertexLocalThroughSpreadEnhancedIndex H j)
    (VertexDuplicateRootShadowCoordinate H)

noncomputable def degreeEnhancedGreedyPredicate
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V) :
    DegreeEnhancedGreedyIndex H j → ℕ → Hypergraph V → Prop
  | Sum.inl a => vertexLocalThroughSpreadEnhancedPredicate
      H C D₂ D₃ D₄ Gamma eta d N T j w a
  | Sum.inr a => vertexDuplicateRootShadowPredicate H C eta d a

theorem indexedDegreeEnhancedGood_localThrough
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M) :
    indexedGreedyGood
      (vertexLocalThroughSpreadEnhancedPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M := by
  intro a
  exact hgood (Sum.inl a)

theorem indexedDegreeEnhancedGood_old
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M) :
    indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d (N : ℝ) j w) k M := by
  exact indexedVertexLocalThroughSpreadEnhancedGood_old
    H C D₂ D₃ D₄ Gamma eta d N T j w
      (indexedDegreeEnhancedGood_localThrough
        H C D₂ D₃ D₄ Gamma eta d N T j w hgood)

theorem indexedDegreeEnhancedGood_local
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M) :
    indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d (N : ℝ) T) k M := by
  exact indexedVertexLocalThroughSpreadEnhancedGood_local
    H C D₂ D₃ D₄ Gamma eta d N T j w
      (indexedDegreeEnhancedGood_localThrough
        H C D₂ D₃ D₄ Gamma eta d N T j w hgood)

theorem indexedDegreeEnhancedGood_duplicate
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M) :
    indexedGreedyGood
      (vertexDuplicateRootShadowPredicate H C eta d) k M := by
  intro a
  exact hgood (Sum.inr a)

def vertexDuplicatePrimaryCoordinate
    {H : Hypergraph V}
    (v : ActualHostVertex H) (r : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    VertexDuplicateRootShadowCoordinate H where
  vertex := v
  layer := ⟨r, by omega⟩
  layer_lower := hr3
  root := ∅
  rank := ⟨r - 1, by omega⟩
  rank_pos := by
    show 1 ≤ r - 1
    exact Nat.le_sub_of_add_le (by omega)
  legal := by
    change (∅ : Hypergraph V).card + (r - 1) < r
    simp only [Finset.card_empty, zero_add]
    exact Nat.sub_lt (by omega) (by omega)

@[simp] theorem vertexDuplicatePrimaryCoordinate_weight
    (H : Hypergraph V) (C : ConflictSystem V)
    (v : ActualHostVertex H) (r : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    vertexDuplicateRootShadowWeight H C
        (vertexDuplicatePrimaryCoordinate v r hr3 hr5) =
      weightedConflictFamilyRootShadowWeight
        (vertexDuplicateLayerFamily H C v.1 r)
        (vertexDuplicateLayerRepresentationWeight H C v.1 r) ∅ := by
  rfl

@[simp] theorem vertexDuplicatePrimaryCoordinate_rank
    {H : Hypergraph V}
    (v : ActualHostVertex H) (r : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    vertexDuplicateRootShadowRank
        (vertexDuplicatePrimaryCoordinate (H := H) v r hr3 hr5) = r - 1 := by
  rfl

@[simp] theorem vertexDuplicatePrimaryCoordinate_cap
    {H : Hypergraph V}
    (eta d : ℝ) (v : ActualHostVertex H)
    (r : ℕ) (hr3 : 3 ≤ r) (hr5 : r ≤ 5) (k : ℕ) :
    vertexDuplicateRootShadowCap eta d
        (vertexDuplicatePrimaryCoordinate (H := H) v r hr3 hr5) k =
      vertexDuplicatePrimaryMargin eta d := by
  unfold vertexDuplicateRootShadowCap vertexDuplicatePrimaryCoordinate
  simp
  omega

/-- Extract the three primary collision caps from the duplicate-root part
of the enhanced Good predicate. -/
theorem vertexDuplicatePrimaryCaps_of_degreeEnhancedGood
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M)
    (v : ActualHostVertex H) :
    ∀ r ∈ Finset.Icc 3 5,
      testTotal
          (weightedConflictFamilyRootShadowWeight
            (vertexDuplicateLayerFamily H C v.1 r)
            (vertexDuplicateLayerRepresentationWeight H C v.1 r) ∅)
          M (r - 1) ≤ vertexDuplicatePrimaryMargin eta d := by
  intro r hr
  have hr3 : 3 ≤ r := (Finset.mem_Icc.mp hr).1
  have hr5 : r ≤ 5 := (Finset.mem_Icc.mp hr).2
  let a : VertexDuplicateRootShadowCoordinate H :=
    vertexDuplicatePrimaryCoordinate (H := H) v r hr3 hr5
  have hcorr := indexedDegreeEnhancedGood_duplicate
    H C D₂ D₃ D₄ Gamma eta d N T j w hgood a
  have hlt :
      testTotal
          (weightedConflictFamilyRootShadowWeight
            (vertexDuplicateLayerFamily H C v.1 r)
            (vertexDuplicateLayerRepresentationWeight H C v.1 r) ∅)
          M (r - 1) < vertexDuplicatePrimaryMargin eta d := by
    apply sub_neg.mp
    simpa [vertexDuplicateRootShadowPredicate, localSpreadUpperCorridor,
      localSpreadUpperError, a, vertexDuplicatePrimaryCoordinate_rank,
      vertexDuplicatePrimaryCoordinate_cap] using hcorr
  exact hlt.le

/-- The coefficient in `vertexDuplicatePrimaryMargin` makes the summed
duplicate correction collapse to one clean power. -/
theorem vertexInternalOpenLinkDefect_le_primaryMarginPower
    {iota : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate
        H C D₂ D₃ D₄ Gamma eta d N T j w) k M)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (v : ActualHostVertex H) :
    vertexInternalOpenLinkDefect C (availableEdges H C M) M v.1 ≤
      Real.rpow d (2 - CFMNumeric.coreEpsilon eta / 2) := by
  have hcap := vertexDuplicatePrimaryCaps_of_degreeEnhancedGood
    H C D₂ D₃ D₄ Gamma eta d N T j w hgood v
  have h := vertexInternalOpenLinkDefect_le_of_duplicatePrimaryCaps
    hmatching hanti (fun _ ↦ vertexDuplicatePrimaryMargin eta d) hcap
  calc
    vertexInternalOpenLinkDefect C (availableEdges H C M) M v.1 ≤
        256 * ∑ r ∈ Finset.Icc 3 5,
          vertexDuplicatePrimaryMargin eta d := h
    _ = Real.rpow d (2 - CFMNumeric.coreEpsilon eta / 2) := by
      norm_num [vertexDuplicatePrimaryMargin]
      ring

/-! ## Scalar absorptions for the source-faithful local degree jump -/

/-- The two localized source slices, the certificate's `C4` term, and the
host pair-codegrees all fit in the canonical degree jump.  This is the
source-faithful replacement for every former `certificateHigherLinkCap`
absorption. -/
theorem degreeLocalJump_absorption_of_cutoff
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    8 * Real.rpow d (1 - eta) +
        Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 4) +
        4 * localSpreadPrimaryMargin eta d ≤
      degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta) := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps : 0 < CFMNumeric.coreEpsilon eta := by
    rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
      simp only [CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      ring]
    linarith [E.eta_pos]
  let J := degreeSourceJumpScale d
    (CFMNumeric.coreEpsilon eta)
  have hJ0 : 0 ≤ J := by
    unfold J degreeSourceJumpScale
    exact Real.rpow_nonneg (le_trans zero_le_one hd) _
  have hgeomExp :
      1 - eta + (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) ≤
        1 - CFMNumeric.coreEpsilon eta / 4 := by
    linarith [E.degree_gap, pow_nonneg E.eta_pos.le 3]
  have hgeom16 : 16 * Real.rpow d (1 - eta) ≤ J := by
    calc
      16 * Real.rpow d (1 - eta) ≤
          Real.rpow d (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) *
            Real.rpow d (1 - eta) :=
        mul_le_mul_of_nonneg_right S.terminalXiFromCore
          (Real.rpow_nonneg (le_trans zero_le_one hd) _)
      _ = Real.rpow d
          ((CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) + (1 - eta)) := by
        exact (Real.rpow_add hdpos _ _).symm
      _ ≤ J := by
        unfold J degreeSourceJumpScale
        exact Real.rpow_le_rpow_of_exponent_le hd (by linarith [hgeomExp])
  have hgeom : 8 * Real.rpow d (1 - eta) ≤ J / 2 := by
    linarith
  have hrawCore : CFMRegularization.rawRegularizationEps eta =
      5 * CFMNumeric.coreEpsilon eta := by
    simp only [CFMNumeric.coreEpsilon,
      CFMRegularization.rawRegularizationEps]
    ring
  have hC4exp :
      1 - CFMRegularization.rawRegularizationEps eta / 4 +
          CFMNumeric.coreEpsilon eta / 64 ≤
        1 - CFMNumeric.coreEpsilon eta / 4 := by
    rw [hrawCore]
    linarith
  have hfour : (4 : ℝ) ≤
      Real.rpow d (CFMNumeric.coreEpsilon eta / 64) := by
    calc
      (4 : ℝ) ≤ 4 * Gamma := by nlinarith [E.Gamma_one]
      _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 64) :=
        S.correctionDenominator
  have hC4four :
      4 * Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 4) ≤ J := by
    calc
      4 * Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 4) ≤
          Real.rpow d (CFMNumeric.coreEpsilon eta / 64) *
            Real.rpow d
              (1 - CFMRegularization.rawRegularizationEps eta / 4) :=
        mul_le_mul_of_nonneg_right hfour
          (Real.rpow_nonneg (le_trans zero_le_one hd) _)
      _ = Real.rpow d (CFMNumeric.coreEpsilon eta / 64 +
          (1 - CFMRegularization.rawRegularizationEps eta / 4)) := by
        exact (Real.rpow_add hdpos _ _).symm
      _ ≤ J := by
        unfold J degreeSourceJumpScale
        exact Real.rpow_le_rpow_of_exponent_le hd (by linarith [hC4exp])
  have hC4 : Real.rpow d
      (1 - CFMRegularization.rawRegularizationEps eta / 4) ≤ J / 4 := by
    linarith
  have hlocal : 4 * localSpreadPrimaryMargin eta d ≤ J / 4 := by
    unfold localSpreadPrimaryMargin J degreeSourceJumpScale
    have hp := Real.rpow_le_rpow_of_exponent_le hd
      (show 1 - CFMNumeric.coreEpsilon eta / 3 ≤
        1 - CFMNumeric.coreEpsilon eta / 4 by linarith)
    norm_num at hp ⊢
    linarith
  dsimp only [J] at hgeom hC4 hlocal ⊢
  linarith

/-- The enhanced local-through component gives the canonical miss-only
degree jump directly.  In particular this proof never bounds a full
one-open conflict-link centre. -/
theorem availableDegreeLoss_miss_le_of_degreeEnhancedGood
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} {T ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ : ℝ) {k : ℕ} {M : Hypergraph V}
    (hT : (T : ℝ) ≤ ((vertexFinset H).card : ℝ))
    (hkT : k ≤ T)
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ Gamma eta d (vertexFinset H).card T
          j R.restrictedWeight) k M)
    (v : ActualHostVertex H) :
    ∀ e ∈ availableEdges H R.regularized M, v.1 ∉ e →
      (availableDegreeLoss H R.regularized M e v.1 : ℝ) ≤
        degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta) := by
  rcases hI with
    ⟨hH8, _hCsys, _hell, _hC4, _heta0, _heta1, _hd,
      _hNupper, _hdegree, hcodegree, _hbounded, _htests, _htrack⟩
  have hNpos : 0 < ((vertexFinset H).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr ⟨v.1, v.2⟩
  have hlocal := sourceConflictLinkVertexCap_of_localGood
    E S hNpos hT hkT H R.regularized
      (indexedDegreeEnhancedGood_local
        H R.regularized D₂ D₃ D₄ Gamma eta d
          (vertexFinset H).card T j R.restrictedWeight hgood) v
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d ((vertexFinset H).card : ℝ) T
      (indexedDegreeEnhancedGood_local
        H R.regularized D₂ D₃ D₄ Gamma eta d
          (vertexFinset H).card T j R.restrictedWeight hgood)
  have habsorb := degreeLocalJump_absorption_of_cutoff E S
  intro e he hve
  have hHnonempty : ∀ f ∈ H, f.Nonempty := by
    intro f hf
    exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
  have hsplit := missAvailableDegreeLoss_eq_miss_add_conflictLost
    hHnonempty hreach.1 he v.1
  have hsplitR :
      (availableDegreeLoss H R.regularized M e v.1 : ℝ) =
        (missLostDegree (availableEdges H R.regularized M) e v.1 : ℝ) +
          (conflictLostDegree R.regularized M
            (availableEdges H R.regularized M) e v.1 : ℝ) := by
    rw [missAvailableDegreeLoss, if_neg hve] at hsplit
    exact_mod_cast hsplit
  have hgeom := missLostDegree_available_real_le_eight_codegree
    hH8 hcodegree R.regularized M he hve
  have hconf := conflictLostDegree_le_C4_add_localConflictLinkPartial
    (fun c hc ↦ R.bounded.conflict_card hc) he v.1
  have hconfR :
      (conflictLostDegree R.regularized M
          (availableEdges H R.regularized M) e v.1 : ℝ) ≤
        (CFMRegularization.conditionC4Count H R.regularized e v.1 : ℝ) +
          ((localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M e 2 1 v.1).card : ℝ) +
          ((localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M e 3 1 v.1).card : ℝ) := by
    exact_mod_cast hconf
  have hC4 := R.conditionC4 e
    (availableEdges_subset H R.regularized M he) v.1
  have hq (q : ℕ) (hq2 : 2 ≤ q) (hq3 : q ≤ 3) :
      ((localConflictLinkPartialAtVertex R.regularized
        (availableEdges H R.regularized M) M e q 1 v.1).card : ℝ) ≤
          2 * localSpreadPrimaryMargin eta d := by
    have hsub := card_localConflictLinkPartialAtVertex_le_sourcePartial
      (C := R.regularized) (M := M)
      (availableEdges_subset H R.regularized M) e q 1 v.1
    have hsubR :
        ((localConflictLinkPartialAtVertex R.regularized
          (availableEdges H R.regularized M) M e q 1 v.1).card : ℝ) ≤
          ((partialFamily
            (sourceConflictLinkInteractionAtVertex H R.regularized e q v.1)
            (availableEdges H R.regularized M) M 1).card : ℝ) := by
      exact_mod_cast hsub
    exact hsubR.trans (hlocal e he hve q hq2 hq3)
  rw [hsplitR]
  calc
    _ ≤ 8 * Real.rpow d (1 - eta) +
          Real.rpow d
            (1 - CFMRegularization.rawRegularizationEps eta / 4) +
          4 * localSpreadPrimaryMargin eta d := by
      have h2 := hq 2 (by norm_num) (by norm_num)
      have h3 := hq 3 (by norm_num) (by norm_num)
      linarith
    _ ≤ degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta) := habsorb

/-! ## Time-zero degree gaps -/

/-- Both literal degree envelopes start at least one canonical deviation
inside the host-degree interval. -/
theorem specializedDegree_initial_gaps
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} {ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ N : ℝ) (v : ActualHostVertex H) :
    degreeUpperError H R.regularized v.1 D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N 0 ∅ ≤
        -CFMNumericAggregation.degreeDeviation d (CFMNumeric.coreEpsilon eta) ∧
      degreeLowerError H R.regularized v.1 D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N 0 ∅ ≤
        -CFMNumericAggregation.degreeDeviation d (CFMNumeric.coreEpsilon eta) := by
  rcases hI with
    ⟨_hH8, _hCsys, _hell, _hC4, _heta0, _heta1, hd,
      _hNupper, hdegree, _hcodegree, _hbounded, _htests, _htrack⟩
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hvdeg := hdegree v.1 v.2
  have hCcard : ∀ c ∈ R.regularized, 2 ≤ c.card := by
    intro c hc
    exact (R.bounded.conflict_card hc).1
  have hdelta0 :
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N 0 =
        Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) := by
    unfold CFMTrajectories.delta CFMTrajectories.xi
      CFMTrajectories.dHat CFMTrajectories.pV
      CFMTrajectories.GammaHat CFMTrajectories.pM
    have hd1 : Real.rpow d (1 : ℝ) = d := by
      simpa using Real.rpow_one d
    simp only [zero_div, mul_zero, zero_mul, sub_zero, one_pow, pow_zero,
      Real.exp_zero, mul_one, one_mul, Real.one_rpow, hd1]
    norm_num [hd1]
    calc
      Real.rpow d (-CFMNumeric.coreEpsilon eta / 32) * d =
          Real.rpow d (-CFMNumeric.coreEpsilon eta / 32) *
            Real.rpow d (1 : ℝ) := by rw [hd1]
      _ = Real.rpow d (-CFMNumeric.coreEpsilon eta / 32 + 1) :=
        (Real.rpow_add hdpos _ _).symm
      _ = Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) := by
        congr 1
        ring
  have hdHat0 :
      CFMTrajectories.dHat D₂ D₃ D₄ d N 0 = d := by
    unfold CFMTrajectories.dHat CFMTrajectories.pV
      CFMTrajectories.GammaHat CFMTrajectories.pM
    simp
  have hsmallExp :
      1 - eta + (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) ≤
        1 - CFMNumeric.coreEpsilon eta / 32 := by
    linarith [E.degree_gap, pow_nonneg E.eta_pos.le 3]
  have hsmall16 :
      16 * Real.rpow d (1 - eta) ≤
        Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) := by
    calc
      16 * Real.rpow d (1 - eta) ≤
          Real.rpow d (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) *
            Real.rpow d (1 - eta) :=
        mul_le_mul_of_nonneg_right S.terminalXiFromCore
          (Real.rpow_nonneg hdpos.le _)
      _ = Real.rpow d
          ((CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) + (1 - eta)) := by
        exact (Real.rpow_add hdpos _ _).symm
      _ ≤ Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) :=
        Real.rpow_le_rpow_of_exponent_le hd (by linarith [hsmallExp])
  have hsmall : Real.rpow d (1 - eta) ≤
      Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 2 := by
    have hp0 : 0 ≤ Real.rpow d (1 - eta) := Real.rpow_nonneg hdpos.le _
    linarith
  rw [degreeUpperError, degreeLowerError,
    availableEdges_empty_eq_host H R.regularized hCcard]
  norm_num only [Nat.cast_zero]
  rw [hdHat0, hdelta0]
  unfold CFMNumericAggregation.degreeDeviation
  have hdeltaPow0 : 0 ≤
      Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) :=
    Real.rpow_nonneg hdpos.le _
  constructor
  · calc
      (degree H v.1 : ℝ) -
            (d + Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32)) ≤
          d - (d + Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32)) :=
        sub_le_sub_right hvdeg.2 _
      _ = -Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) := by ring
      _ ≤ -Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 2 := by
        linarith
      _ = -(Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 2) := by
        ring
  · have hhostLower : d - Real.rpow d (1 - eta) ≤
        (degree H v.1 : ℝ) := by
      calc
        d - Real.rpow d (1 - eta) =
            (1 - Real.rpow d (-eta)) * d := by
          rw [show Real.rpow d (1 - eta) = d * Real.rpow d (-eta) by
            calc
              Real.rpow d (1 - eta) =
                  Real.rpow d ((1 : ℝ) + (-eta)) := by congr 1 <;> ring
              _ = Real.rpow d 1 * Real.rpow d (-eta) :=
                Real.rpow_add hdpos _ _
              _ = d * Real.rpow d (-eta) := by
                rw [show Real.rpow d 1 = d by simpa using Real.rpow_one d]]
          ring
        _ ≤ (degree H v.1 : ℝ) := hvdeg.1
    calc
      d - Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) -
            (degree H v.1 : ℝ) ≤
          Real.rpow d (1 - eta) -
            Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) := by
        linarith
      _ ≤ -Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 2 := by
        linarith
      _ = -(Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 2) := by
        ring

theorem certificateBaseLayerMaxDegree_le_GammaCert
    {ι : Type*} [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : ι → ℕ) (w : ι → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (r : ℕ) (hr2 : 2 ≤ r) (hr4 : r ≤ 4) :
    (CFMRegularization.layerMaxDegree H
        (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) r : ℝ) ≤
      (2 * (ell : ℝ) + 1) * Real.rpow d ((r : ℝ) - 1) := by
  rcases hinst with
    ⟨_hH8, _hCsys, hell, _hC4, heta0, _heta1, hd, _hNupper,
      _hdegree, _hcodegree, hCbounded, _hi, _htests⟩
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hell0 : (0 : ℝ) ≤ (ell : ℝ) := Nat.cast_nonneg ell
  have hGamma : (1 : ℝ) ≤ 2 * (ell : ℝ) + 1 := by
    linarith
  interval_cases r
  · let X := Real.rpow d
        (1 - CFMRegularization.rawRegularizationEps eta / 3)
    have hX0 : 0 ≤ X :=
      Real.rpow_nonneg (le_trans zero_le_one hd) _
    have hsubset :
        conflictLayer
            (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) 2 ⊆
          conflictLayer R.badPairs 2 :=
      CFMRegularization.minimalCore_union_layer_two_subset_right H hCbounded
    have hsup :
        CFMRegularization.layerMaxDegree H
            (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) 2 ≤
          Nat.floor X := by
      unfold CFMRegularization.layerMaxDegree
      apply Finset.sup_le
      intro e he
      apply Nat.le_floor
      calc
        (degree (conflictLayer
            (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) 2) e : ℝ) ≤
            (degree (conflictLayer R.badPairs 2) e : ℕ) := by
              exact_mod_cast degree_mono hsubset e
        _ = (degree R.badPairs e : ℕ) := by
          rw [CFMRegularization.conflictLayer_eq_self_of_uniform
            R.badPairs_uniform]
        _ ≤ X := R.badPairs_degree e he
    have hbase :
        (CFMRegularization.layerMaxDegree H
            (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) 2 : ℝ) ≤ X := by
      calc
        _ ≤ ((Nat.floor X : ℕ) : ℝ) := by exact_mod_cast hsup
        _ ≤ X := Nat.floor_le hX0
    have heps : 0 < CFMRegularization.rawRegularizationEps eta := by
      simp only [CFMRegularization.rawRegularizationEps]
      positivity
    have hpow : X ≤ Real.rpow d (1 : ℝ) := by
      exact Real.rpow_le_rpow_of_exponent_le hd
        (by linarith [heps])
    calc
      _ ≤ X := hbase
      _ ≤ Real.rpow d (1 : ℝ) := hpow
      _ ≤ (2 * (ell : ℝ) + 1) * Real.rpow d (1 : ℝ) := by
        exact le_mul_of_one_le_left
          (Real.rpow_nonneg (le_trans zero_le_one hd) _) hGamma
      _ = (2 * (ell : ℝ) + 1) * Real.rpow d ((2 : ℝ) - 1) := by
        norm_num
  · have hbase :=
      CFMRegularization.layerMaxDegree_minimalMatchingCore_union_two_le
        (H := H) hCbounded R.badPairs_uniform
          (by norm_num) (by omega : 3 ≤ ell)
    have hp0 : 0 ≤ Real.rpow d (((3 : ℕ) : ℝ) - 1) :=
      Real.rpow_nonneg (le_trans zero_le_one hd) _
    have hcoef : (ell : ℝ) ≤ 2 * ell + 1 := by linarith
    exact hbase.trans
      (mul_le_mul_of_nonneg_right hcoef hp0)
  · have hbase :=
      CFMRegularization.layerMaxDegree_minimalMatchingCore_union_two_le
        (H := H) hCbounded R.badPairs_uniform (by norm_num) hell
    have hp0 : 0 ≤ Real.rpow d (((4 : ℕ) : ℝ) - 1) :=
      Real.rpow_nonneg (le_trans zero_le_one hd) _
    have hcoef : (ell : ℝ) ≤ 2 * ell + 1 := by linarith
    exact hbase.trans
      (mul_le_mul_of_nonneg_right hcoef hp0)

/-- The completion factor costs at most two.  The canonical core conflict
parameter `6 * GammaCert` therefore absorbs every literal certificate
center, uniformly in layers two through four. -/
theorem certificateInternalLayerScale_le_sixGammaCert
    {ι : Type*} [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : ι → ℕ) (w : ι → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (r : ℕ) (hr2 : 2 ≤ r) (hr4 : r ≤ 4) :
    0 ≤ certificateInternalLayerScale H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R r ∧
      certificateInternalLayerScale H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w R r ≤
        (6 * (2 * (ell : ℝ) + 1)) *
          Real.rpow d ((r : ℝ) - 1) := by
  have hinst' := hinst
  rcases hinst with
    ⟨_hH8, _hCsys, _hell, _hC4, heta0, _heta1, hd, _hNupper,
      _hdegree, _hcodegree, _hCbounded, _hi, _htests⟩
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps : 0 < CFMRegularization.rawRegularizationEps eta := by
    simp only [CFMRegularization.rawRegularizationEps]
    positivity
  have ht0 : 0 ≤ Real.rpow d
      (-CFMRegularization.rawRegularizationEps eta / 4) :=
    Real.rpow_nonneg (le_trans zero_le_one hd) _
  have ht1 : Real.rpow d
      (-CFMRegularization.rawRegularizationEps eta / 4) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos hd (by linarith)
  have hp0 : 0 ≤ Real.rpow d ((r : ℝ) - 1) :=
    Real.rpow_nonneg (le_trans zero_le_one hd) _
  have hell0 : (0 : ℝ) ≤ (ell : ℝ) := Nat.cast_nonneg ell
  have hGamma : (1 : ℝ) ≤ 2 * (ell : ℝ) + 1 := by
    linarith
  have hbaseline :
      Real.rpow d ((r : ℝ) - 1 -
          CFMRegularization.rawRegularizationEps eta / 600) ≤
        (2 * (ell : ℝ) + 1) * Real.rpow d ((r : ℝ) - 1) := by
    have hpow :
        Real.rpow d ((r : ℝ) - 1 -
            CFMRegularization.rawRegularizationEps eta / 600) ≤
          Real.rpow d ((r : ℝ) - 1) :=
      Real.rpow_le_rpow_of_exponent_le hd (by linarith [heps])
    exact hpow.trans (le_mul_of_one_le_left hp0 hGamma)
  have hbase := certificateBaseLayerMaxDegree_le_GammaCert
    H C d eta ell j w hinst' R r hr2 hr4
  unfold certificateInternalLayerScale CFMRegularization.completionTarget
  constructor
  · positivity
  · have hmax :
        max (Real.rpow d ((r : ℝ) - 1 -
              CFMRegularization.rawRegularizationEps eta / 600))
            (CFMRegularization.layerMaxDegree H
              (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) r : ℝ) ≤
          (2 * (ell : ℝ) + 1) * Real.rpow d ((r : ℝ) - 1) :=
        max_le hbaseline hbase
    calc
      (1 + Real.rpow d
          (-CFMRegularization.rawRegularizationEps eta / 4)) *
          max (Real.rpow d ((r : ℝ) - 1 -
              CFMRegularization.rawRegularizationEps eta / 600))
            (CFMRegularization.layerMaxDegree H
              (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) r : ℝ) ≤
          2 * ((2 * (ell : ℝ) + 1) *
            Real.rpow d ((r : ℝ) - 1)) := by
              exact mul_le_mul (by linarith) hmax (by positivity) (by norm_num)
      _ ≤ (6 * (2 * (ell : ℝ) + 1)) *
          Real.rpow d ((r : ℝ) - 1) := by
        have hA0 : 0 ≤ 2 * (ell : ℝ) + 1 := le_trans zero_le_one hGamma
        have hcoef :
            2 * (2 * (ell : ℝ) + 1) ≤ 6 * (2 * (ell : ℝ) + 1) :=
          mul_le_mul_of_nonneg_right (by norm_num) hA0
        calc
          2 * ((2 * (ell : ℝ) + 1) *
              Real.rpow d ((r : ℝ) - 1)) =
              (2 * (2 * (ell : ℝ) + 1)) *
                Real.rpow d ((r : ℝ) - 1) := by ring
          _ ≤ (6 * (2 * (ell : ℝ) + 1)) *
                Real.rpow d ((r : ℝ) - 1) :=
            mul_le_mul_of_nonneg_right hcoef hp0

/-- Nonnegativity and the exact source-registry bounds for the three
literal certificate centers at `GammaCore = 6 * GammaCert`. -/
theorem certificateLiteralDegreeCenters_bounds
    {ι : Type*} [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : ι → ℕ) (w : ι → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w) :
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let GammaCore := 6 * (2 * (ell : ℝ) + 1)
    0 ≤ D₂ ∧ 0 ≤ D₃ ∧ 0 ≤ D₄ ∧
      D₂ ≤ GammaCore * d ∧
      D₃ ≤ GammaCore * d ^ 2 ∧
      D₄ ≤ GammaCore * d ^ 3 := by
  dsimp only
  have h2 := certificateInternalLayerScale_le_sixGammaCert
    H C d eta ell j w hinst R 2 (by norm_num) (by norm_num)
  have h3 := certificateInternalLayerScale_le_sixGammaCert
    H C d eta ell j w hinst R 3 (by norm_num) (by norm_num)
  have h4 := certificateInternalLayerScale_le_sixGammaCert
    H C d eta ell j w hinst R 4 (by norm_num) (by norm_num)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [certificateD₂] using h2.1
  · simpa only [certificateD₃] using h3.1
  · simpa only [certificateD₄] using h4.1
  · norm_num [certificateD₂, Real.rpow_one] at h2 ⊢
    exact h2.2
  · norm_num [certificateD₃, Real.rpow_natCast] at h3 ⊢
    exact h3.2
  · norm_num [certificateD₄, Real.rpow_natCast] at h4 ⊢
    exact h4.2

/- The complete delta registry for the literal certificate centers and
the exact rounded horizon.  It is state-independent once the specialized
instance, exponent hierarchy, cutoff, and host lower bound are fixed. -/
theorem certificateLiteralDeltaStepRegistry
    {ι : Type*} [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : ι → ℕ) (w : ι → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (N : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * (2 * (ell : ℝ) + 1)) d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (k : ℕ) (hk : k < CFMNumericAggregation.targetTime eta d N) :
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) (CFMNumeric.trajectoryFloor eta d) := by
  dsimp only
  have hcenters := certificateLiteralDegreeCenters_bounds
    H C d eta ell j w hinst R
  have hd : 1 ≤ d := by
    rcases hinst with
      ⟨_hH8, _hCsys, _hell, _hC4, _heta0, _heta1, hd, _hNupper,
        _hdegree, _hcodegree, _hCbounded, _hi, _htests⟩
    exact hd
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hNpos : 0 < (N : ℝ) :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hNlower
  have hPpos : 0 < CFMNumeric.trajectoryFloor eta d := by
    unfold CFMNumeric.trajectoryFloor CFMNumeric.publicError
    positivity
  have htime : ∀ y ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1), 0 ≤ y := by
    intro y hy
    exact (Nat.cast_nonneg k).trans hy.1
  have hend : ∀ y ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1),
      8 * y < (N : ℝ) := by
    intro y hy
    have hkT : k + 1 ≤ CFMNumericAggregation.targetTime eta d N := by omega
    have hyT : y ≤ (CFMNumericAggregation.targetTime eta d N : ℝ) :=
      hy.2.trans (by exact_mod_cast hkT)
    have hT := CFMNumericAggregation.targetTime_lt_host_eighth
      E.eta_pos S hNlower
    nlinarith
  have hfloor : ∀ y ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1),
      CFMNumeric.trajectoryFloor eta d ≤ CFMTrajectories.pV (N : ℝ) y := by
    intro y hy
    exact (CFMNumeric.pV_floor_on_step_before_ceil
      eta (6 * (2 * (ell : ℝ) + 1)) d N k y S E.eta_pos hNlower hk hy).le
  have hdegree : CFMTrajectories.DegreeStepRegistry
      (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) (CFMNumeric.trajectoryFloor eta d) := by
    exact CFMTrajectories.DegreeStepRegistry.of_source
      hd hNpos E.Gamma_one hcenters.1 hcenters.2.1 hcenters.2.2.1
      hcenters.2.2.2.1 hcenters.2.2.2.2.1 hcenters.2.2.2.2.2
      hPpos htime hend hfloor
      (CFMNumeric.degreeLargeDCondition_of_cutoff S hNlower)
  exact CFMNumeric.DeltaStepRegistry.of_source_stopExponent
    hdegree (by
      rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
        simp only [CFMNumeric.coreEpsilon,
          CFMRegularization.rawRegularizationEps]
        ring]
      linarith [E.eta_pos])
    (by
      intro y hy
      exact (CFMNumeric.stopExponent_floor_of_cutoff S).trans (hfloor y hy))
    E.stopExponent_relations.1 E.stopExponent_relations.2.1
    (CFMNumeric.deltaHazard_of_cutoff S)
    (CFMNumeric.deltaLargeDCondition_of_cutoff S hNlower)

/-! ## Exact trajectory-error compression -/

/-- The sum of the three one-open corridor errors is a fixed multiple of
the degree envelope itself.  Using this identity is essential: the separate
coarse `zeta` power bounds would lose the exponent needed by the degree
mean window. -/
theorem degreeInternalCorridorError_le_eight_mul_delta
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ}
    (Rstep : CFMTrajectories.DeltaStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P) :
    D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
        D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
        D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x ≤
      8 * Gamma * CFMTrajectories.delta
        D₂ D₃ D₄ Gamma epsilon d N x := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one Rstep.degree.d_one
  have hN : 0 < N := Rstep.degree.N_pos
  have hGamma : 0 < Gamma := lt_of_lt_of_le zero_lt_one Rstep.degree.Gamma_one
  have hpV := CFMTrajectories.pV_pos hN (Rstep.degree.before_end x hx)
  have hpV1 := CFMTrajectories.pV_le_one hN
    (Rstep.degree.time_nonneg x hx)
  have hpM0 := CFMTrajectories.pM_nonneg hd hN
    (Rstep.degree.time_nonneg x hx)
  have hpM1 := CFMTrajectories.pM_le_inv hd hN
    (Rstep.degree.before_end x hx).le
  have hload := CFMTrajectories.conflictLoad_le_six_mul
    hd hGamma.le hpM0 hpM1 Rstep.degree.D₂_bound
      Rstep.degree.D₃_bound Rstep.degree.D₄_bound
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N x :=
    (CFMTrajectories.q_pos hpV).le
  have hdHat0 : 0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N x :=
    (CFMTrajectories.dHat_pos hd hpV).le
  have hxi0 : 0 ≤ CFMTrajectories.xi Gamma epsilon d N x := by
    unfold CFMTrajectories.xi
    positivity
  have hcEq :
      CFMTrajectories.cHat D₂ D₃ D₄ d N x =
        CFMTrajectories.q D₂ D₃ D₄ d N x *
          CFMTrajectories.conflictLoad D₂ D₃ D₄ d N x := by
    unfold CFMTrajectories.cHat CFMTrajectories.conflictLoad
    ring
  have hc : CFMTrajectories.cHat D₂ D₃ D₄ d N x ≤
      6 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x := by
    rw [hcEq]
    calc
      CFMTrajectories.q D₂ D₃ D₄ d N x *
          CFMTrajectories.conflictLoad D₂ D₃ D₄ d N x ≤
        CFMTrajectories.q D₂ D₃ D₄ d N x * (6 * Gamma * d) :=
          mul_le_mul_of_nonneg_left hload hq0
      _ = 6 * Gamma * CFMTrajectories.pV N x *
          CFMTrajectories.dHat D₂ D₃ D₄ d N x := by
        unfold CFMTrajectories.q CFMTrajectories.dHat
        ring
      _ ≤ 6 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x := by
        have hcoef0 : 0 ≤ 6 * Gamma := by positivity
        nlinarith [mul_le_mul_of_nonneg_right hpV1
          (mul_nonneg hcoef0 hdHat0)]
  let K := D₂ / (4 * Gamma * d) +
    2 * D₃ / (4 * Gamma * d ^ 2) +
    3 * D₄ / (4 * Gamma * d ^ 3)
  have hden1 : 0 < 4 * Gamma * d := by positivity
  have hden2 : 0 < 4 * Gamma * d ^ 2 := by positivity
  have hden3 : 0 < 4 * Gamma * d ^ 3 := by positivity
  have hK : K ≤ 3 / 2 := by
    have h2 : D₂ / (4 * Gamma * d) ≤ 1 / 4 := by
      apply (div_le_iff₀ hden1).2
      nlinarith [Rstep.degree.D₂_bound]
    have h3 : 2 * D₃ / (4 * Gamma * d ^ 2) ≤ 1 / 2 := by
      apply (div_le_iff₀ hden2).2
      nlinarith [Rstep.degree.D₃_bound]
    have h4 : 3 * D₄ / (4 * Gamma * d ^ 3) ≤ 3 / 4 := by
      apply (div_le_iff₀ hden3).2
      nlinarith [Rstep.degree.D₄_bound]
    dsimp only [K]
    linarith
  have hK0 : 0 ≤ K := by
    dsimp only [K]
    exact add_nonneg
      (add_nonneg
        (div_nonneg Rstep.degree.D₂_nonneg hden1.le)
        (div_nonneg (mul_nonneg (by norm_num) Rstep.degree.D₃_nonneg)
          hden2.le))
      (div_nonneg (mul_nonneg (by norm_num) Rstep.degree.D₄_nonneg)
        hden3.le)
  have herrEq :
      D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
          D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
          D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x =
        CFMTrajectories.xi Gamma epsilon d N x *
            CFMTrajectories.cHat D₂ D₃ D₄ d N x +
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x * K := by
    rw [hcEq]
    unfold CFMTrajectories.zeta CFMTrajectories.zHat
      CFMTrajectories.conflictLoad
      CFMTrajectories.delta K
    norm_num
    field_simp [ne_of_gt hd, ne_of_gt hGamma]
    ring
  rw [herrEq]
  have hfirst := mul_le_mul_of_nonneg_left hc hxi0
  have hdelta0 : 0 ≤ CFMTrajectories.delta
      D₂ D₃ D₄ Gamma epsilon d N x := by
    unfold CFMTrajectories.delta
    positivity
  have hsecond := mul_le_mul_of_nonneg_left hK hdelta0
  calc
    CFMTrajectories.xi Gamma epsilon d N x *
          CFMTrajectories.cHat D₂ D₃ D₄ d N x +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x * K ≤
      CFMTrajectories.xi Gamma epsilon d N x *
          (6 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x * (3 / 2) :=
      add_le_add hfirst hsecond
    _ = (6 * Gamma + 3 / 2) *
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x := by
      unfold CFMTrajectories.delta
      ring
    _ ≤ 8 * Gamma *
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x := by
      exact mul_le_mul_of_nonneg_right
        (by linarith [Rstep.degree.Gamma_one]) hdelta0

/-- The error envelope has a large positive derivative margin over the
entire geometric and open-conflict degree drift. -/
theorem degreeDeltaRate_lower_of_registry
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ}
    (Rstep : CFMTrajectories.DeltaStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P) :
    76000 * Gamma *
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x /
          (N * CFMTrajectories.pV N x) ≤
      CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one Rstep.degree.d_one
  have hpV := CFMTrajectories.pV_pos Rstep.degree.N_pos
    (Rstep.degree.before_end x hx)
  have hpM0 := CFMTrajectories.pM_nonneg hd Rstep.degree.N_pos
    (Rstep.degree.time_nonneg x hx)
  have hpM1 := CFMTrajectories.pM_le_inv hd Rstep.degree.N_pos
    (Rstep.degree.before_end x hx).le
  have hmargin := CFMTrajectories.delta_logarithmic_margin
    hd Rstep.degree.N_pos Rstep.degree.Gamma_one
    (Rstep.degree.time_nonneg x hx) (Rstep.degree.before_end x hx)
    Rstep.degree.D₂_nonneg Rstep.degree.D₃_nonneg Rstep.degree.D₄_nonneg
    Rstep.degree.D₂_bound Rstep.degree.D₃_bound Rstep.degree.D₄_bound
  have hdelta0 : 0 ≤ CFMTrajectories.delta
      D₂ D₃ D₄ Gamma epsilon d N x := by
    exact (CFMTrajectories.delta_pos hd hpV).le
  have hmul := mul_le_mul_of_nonneg_right hmargin hdelta0
  have hhazard :
      CFMTrajectories.degreeHazard D₂ D₃ D₄ d N x =
        CFMTrajectories.cHat D₂ D₃ D₄ d N x /
            CFMTrajectories.hHat D₂ D₃ D₄ d N x +
          7 * CFMTrajectories.dHat D₂ D₃ D₄ d N x /
            CFMTrajectories.hHat D₂ D₃ D₄ d N x := by
    rw [CFMTrajectories.cHat_div_hHat hd Rstep.degree.N_pos hpV]
    rw [show
      7 * CFMTrajectories.dHat D₂ D₃ D₄ d N x /
          CFMTrajectories.hHat D₂ D₃ D₄ d N x =
        7 * (CFMTrajectories.dHat D₂ D₃ D₄ d N x /
          CFMTrajectories.hHat D₂ D₃ D₄ d N x) by ring,
      CFMTrajectories.dHat_div_hHat hd Rstep.degree.N_pos hpV]
    unfold CFMTrajectories.degreeHazard CFMTrajectories.conflictLoad
    ring
  unfold CFMTrajectories.deltaRate
  calc
    76000 * Gamma *
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x /
            (N * CFMTrajectories.pV N x) =
        (76000 * Gamma / (N * CFMTrajectories.pV N x)) *
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x := by
      ring
    _ ≤ (CFMTrajectories.gamma Gamma N x -
          CFMTrajectories.degreeHazard D₂ D₃ D₄ d N x) *
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x := by
      rw [hhazard]
      have hre :
          CFMTrajectories.gamma Gamma N x -
              (CFMTrajectories.cHat D₂ D₃ D₄ d N x /
                  CFMTrajectories.hHat D₂ D₃ D₄ d N x +
                7 * CFMTrajectories.dHat D₂ D₃ D₄ d N x /
                  CFMTrajectories.hHat D₂ D₃ D₄ d N x) =
            CFMTrajectories.gamma Gamma N x -
                CFMTrajectories.cHat D₂ D₃ D₄ d N x /
                  CFMTrajectories.hHat D₂ D₃ D₄ d N x -
              7 * CFMTrajectories.dHat D₂ D₃ D₄ d N x /
                CFMTrajectories.hHat D₂ D₃ D₄ d N x := by ring
      rw [hre]
      exact hmul

/-- Every rounding, codegree, and internal-link corridor error in the
degree mean fits inside a fixed fraction of the logarithmic envelope
margin. -/
theorem degreeMeanError_le_sixtyFour_mul_delta
    {D₂ D₃ D₄ Gamma eta d N x P : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x P) :
    7 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N x +
        28 * Real.rpow d (1 - eta) + 35 +
        (D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N 1 1 x +
          D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N 2 1 x +
          D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N 3 1 x) ≤
      64 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N x := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 1 ≤ d := Rstep.degree.d_one
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hdelta := (CFMTrajectories.delta_bounds_of_registry Rstep hx).1
  have hdelta0 : 0 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x :=
    (Real.rpow_nonneg (le_trans zero_le_one hd) _).trans hdelta
  have heps : CFMNumeric.coreEpsilon eta = eta / 50000 := by
    simp only [CFMNumeric.coreEpsilon,
      CFMRegularization.rawRegularizationEps]
    ring
  have hexp :
      CFMNumeric.coreEpsilon eta / 64 - eta ^ 3 + (1 - eta) ≤
        1 - CFMNumeric.coreEpsilon eta / 16 := by
    rw [heps]
    nlinarith [E.degree_gap, pow_nonneg E.eta_pos.le 3]
  have hcodegree16 : 16 * Real.rpow d (1 - eta) ≤
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N x := by
    calc
      16 * Real.rpow d (1 - eta) ≤
          Real.rpow d (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3) *
            Real.rpow d (1 - eta) :=
        mul_le_mul_of_nonneg_right S.terminalXiFromCore
          (Real.rpow_nonneg (le_trans zero_le_one hd) _)
      _ = Real.rpow d
          (CFMNumeric.coreEpsilon eta / 64 - eta ^ 3 + (1 - eta)) :=
        (Real.rpow_add hdpos _ _).symm
      _ ≤ Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 16) :=
        Real.rpow_le_rpow_of_exponent_le hd hexp
      _ ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N x := hdelta
  have hexp0 : 0 ≤ 1 - CFMNumeric.coreEpsilon eta / 16 := by
    rw [heps]
    nlinarith [E.eta_lt_one]
  have honeDelta : 1 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x := by
    calc
      (1 : ℝ) = Real.rpow d 0 := (Real.rpow_zero d).symm
      _ ≤ Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 16) :=
        Real.rpow_le_rpow_of_exponent_le hd hexp0
      _ ≤ _ := hdelta
  have herr := degreeInternalCorridorError_le_eight_mul_delta Rstep
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hseven : 7 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x ≤
      7 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N x := by
    nlinarith [mul_le_mul_of_nonneg_right E.Gamma_one hdelta0]
  have hconst : (35 : ℝ) ≤
      35 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N x := by
    nlinarith [mul_le_mul E.Gamma_one honeDelta (by norm_num) hGamma0]
  nlinarith

/-- Final linear arithmetic for the two degree mean windows.  The
preceding deterministic estimates deliberately leave a factor greater
than thirty in the logarithmic envelope margin. -/
theorem degreeMeanWindow_of_coarse_deviations
    {surv center lower upper deltaRate rem scale : ℝ}
    (hsurv : 1 / 4 ≤ surv)
    (hscale : 0 ≤ scale)
    (hlower : surv * center - lower ≤ 2000 * scale)
    (hupper : upper - surv * center ≤ 2000 * scale)
    (hdelta : 76000 * scale ≤ deltaRate)
    (hrem : rem ≤ scale) :
    surv * (center - deltaRate + 2 * rem) ≤ lower ∧
      upper ≤ surv * (center + deltaRate - 2 * rem) := by
  have hsurv0 : 0 ≤ surv := by linarith
  have hdelta0 : 0 ≤ deltaRate := by linarith
  have hmargin : 2000 * scale + 2 * surv * rem ≤
      surv * deltaRate := by
    have hsurvDelta := mul_le_mul_of_nonneg_left hdelta hsurv0
    have hsurvRem := mul_le_mul_of_nonneg_left hrem hsurv0
    nlinarith
  constructor <;> nlinarith

/-- A handshake window whose relative degree error is at most one fifth
places both combinatorial mean endpoints within `2000 * Gamma * delta / u`
of the centered trajectory drift. -/
theorem degreeMean_coarse_deviations_of_handshake
    {r z C E defectOverA Gamma delta u D : ℝ}
    (hGamma : 1 ≤ Gamma) (hu : 0 < u) (hD : 0 < D)
    (hr0 : 0 ≤ r) (hz0 : 0 ≤ z)
    (hr : r ≤ 12 / u) (hz : z = 8 / u)
    (hratio : |r - z| ≤ 20 * delta / (u * D))
    (hC0 : 0 ≤ C) (hC : C ≤ 13 * Gamma * D)
    (hE0 : 0 ≤ E) (hE : E ≤ 64 * Gamma * delta)
    (hdefect0 : 0 ≤ defectOverA)
    (hdefect : defectOverA ≤ 10 * Gamma * delta / u)
    (hhost : 5000 * Gamma * D ≤ u * delta) :
    (1 - r) * (C * z) - (r * (C - E) - defectOverA) ≤
        2000 * (Gamma * delta / u) ∧
      r * (C + E) - (1 - r) * (C * z) ≤
        2000 * (Gamma * delta / u) := by
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one hGamma
  have hdelta0 : 0 ≤ delta := by
    have hleft0 : 0 ≤ 5000 * Gamma * D := by positivity
    have hud : 0 ≤ u * delta := hleft0.trans hhost
    rw [mul_comm] at hud
    exact nonneg_of_mul_nonneg_left hud hu
  have hscale0 : 0 ≤ Gamma * delta / u := by positivity
  have habsTerm : |r - z| * C ≤ 260 * (Gamma * delta / u) := by
    calc
      |r - z| * C ≤ (20 * delta / (u * D)) * (13 * Gamma * D) :=
        mul_le_mul hratio hC hC0 (by positivity)
      _ = 260 * (Gamma * delta / u) := by field_simp; ring
  have hcross : r * C * z ≤ (1 : ℝ) * (Gamma * delta / u) := by
    rw [hz]
    calc
      r * C * (8 / u) ≤
          (12 / u) * (13 * Gamma * D) * (8 / u) := by
        gcongr
      _ ≤ 1 * (Gamma * delta / u) := by
        have hhost' : 1248 * Gamma * D ≤ u * delta := by
          linarith
        field_simp [ne_of_gt hu]
        nlinarith
  have herror : r * E ≤ 768 * (Gamma * delta / u) := by
    calc
      r * E ≤ (12 / u) * (64 * Gamma * delta) :=
        mul_le_mul hr hE hE0 (by positivity)
      _ = 768 * (Gamma * delta / u) := by ring
  have hdiffUpper : (r - z) * C ≤ |r - z| * C := by
    exact mul_le_mul_of_nonneg_right (le_abs_self _) hC0
  have hdiffLower : -(r - z) * C ≤ |r - z| * C := by
    have := neg_le_abs (r - z)
    nlinarith
  constructor
  · calc
      (1 - r) * (C * z) - (r * (C - E) - defectOverA) =
          -(r - z) * C - r * C * z + r * E + defectOverA := by ring
      _ ≤ |r - z| * C + r * E + defectOverA := by
        nlinarith [mul_nonneg (mul_nonneg hr0 hC0) hz0]
      _ ≤ 260 * (Gamma * delta / u) +
          768 * (Gamma * delta / u) +
          10 * (Gamma * delta / u) :=
        add_le_add (add_le_add habsTerm herror) (by
          have hre : 10 * (Gamma * delta / u) =
              10 * Gamma * delta / u := by ring
          rw [hre]
          exact hdefect)
      _ ≤ 2000 * (Gamma * delta / u) := by nlinarith
  · calc
      r * (C + E) - (1 - r) * (C * z) =
          (r - z) * C + r * C * z + r * E := by ring
      _ ≤ |r - z| * C + r * C * z + r * E := by
        linarith
      _ ≤ 260 * (Gamma * delta / u) +
          1 * (Gamma * delta / u) +
          768 * (Gamma * delta / u) := by
        gcongr
      _ ≤ 2000 * (Gamma * delta / u) := by nlinarith

/-- Exact algebraic conversion of the eight-uniform handshake interval
into a ratio interval for the tracked available degree. -/
theorem degreeRatio_bounds_of_handshake
    {b a u D delta : ℝ}
    (hu : 0 < u) (hD : 0 < D) (hdelta : 0 ≤ delta)
    (hsmall : 5 * delta ≤ D)
    (hbLo : D - delta ≤ b) (hbHi : b ≤ D + delta)
    (haLo : u * (D - delta) / 8 ≤ a)
    (haHi : a ≤ u * (D + delta) / 8) :
    0 ≤ b / a ∧ b / a ≤ 12 / u ∧
      |b / a - 8 / u| ≤ 20 * delta / (u * D) := by
  have hDminus : 4 * D / 5 ≤ D - delta := by linarith
  have hDminus0 : 0 < D - delta := by
    have : 0 < 4 * D / 5 := by positivity
    linarith
  have hDplus : D + delta ≤ 6 * D / 5 := by linarith
  have haLower : u * D / 10 ≤ a := by
    calc
      u * D / 10 = u * (4 * D / 5) / 8 := by ring
      _ ≤ u * (D - delta) / 8 := by gcongr
      _ ≤ a := haLo
  have ha : 0 < a := by
    have : 0 < u * D / 10 := by positivity
    linarith
  have hb0 : 0 ≤ b := by linarith
  have hr0 : 0 ≤ b / a := div_nonneg hb0 ha.le
  have hr : b / a ≤ 12 / u := by
    apply (div_le_iff₀ ha).2
    calc
      b ≤ 6 * D / 5 := hbHi.trans hDplus
      _ ≤ (12 / u) * a := by
        have hmul := mul_le_mul_of_nonneg_left haLower (by norm_num : (0 : ℝ) ≤ 12)
        field_simp [ne_of_gt hu] at hmul ⊢
        nlinarith
  have hub : u * b ≤ u * D + u * delta := by
    nlinarith [mul_le_mul_of_nonneg_left hbHi hu.le]
  have hlb : u * D - u * delta ≤ u * b := by
    nlinarith [mul_le_mul_of_nonneg_left hbLo hu.le]
  have haub : 8 * a ≤ u * D + u * delta := by
    nlinarith
  have halb : u * D - u * delta ≤ 8 * a := by
    nlinarith
  have hnum : |u * b - 8 * a| ≤ 2 * u * delta := by
    rw [abs_le]
    constructor <;> nlinarith
  have heq : b / a - 8 / u = (u * b - 8 * a) / (u * a) := by
    field_simp [ne_of_gt hu, ne_of_gt ha]
  have hden : 0 < u * a := mul_pos hu ha
  have habs : |b / a - 8 / u| ≤ 2 * delta / a := by
    rw [heq, abs_div, abs_of_pos hden]
    calc
      |u * b - 8 * a| / (u * a) ≤ (2 * u * delta) / (u * a) :=
        div_le_div_of_nonneg_right hnum hden.le
      _ = 2 * delta / a := by field_simp [ne_of_gt hu, ne_of_gt ha]
  refine ⟨hr0, hr, habs.trans ?_⟩
  apply (div_le_iff₀ ha).2
  have hmul := mul_le_mul_of_nonneg_left haLower
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 20) hdelta)
  field_simp [ne_of_gt hu, ne_of_gt hD] at hmul ⊢
  nlinarith

theorem natCast_sub_ge_sub_cast (a b : ℕ) :
    (a : ℝ) - (b : ℝ) ≤ ((a - b : ℕ) : ℝ) := by
  by_cases hba : b ≤ a
  · rw [Nat.cast_sub hba]
  · have hab : a ≤ b := Nat.le_of_not_ge hba
    have : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab
    have : (a : ℝ) - (b : ℝ) ≤ 0 := sub_nonpos.mpr this
    exact this.trans (Nat.cast_nonneg _)

/-- Remove all integer rounding from the exact degree mean endpoints while
retaining the correct lower-sign duplicate defect. -/
theorem degreeRoundedEndpoints_within_error
    {b a D delta c err K defect : ℝ}
    (ha : 0 < a) (hb : 0 ≤ b) (hlo : 0 ≤ D - delta)
    (hhi : 0 ≤ D + delta) (hK : 0 ≤ K) :
    (b / a) *
          ((c + 7 * D) - (7 * delta + 28 * K + 35 + err)) -
        defect / a ≤
      b *
          (((7 * Nat.floor (D - delta) - 28 * Nat.ceil K : ℕ) : ℝ) +
            (c - err)) / a - defect / a ∧
    b * (((7 * Nat.ceil (D + delta) : ℕ) : ℝ) + (c + err)) / a ≤
      (b / a) *
        ((c + 7 * D) + (7 * delta + 28 * K + 35 + err)) := by
  have hfloor : D - delta - 1 ≤ ((Nat.floor (D - delta) : ℕ) : ℝ) := by
    have h := Nat.lt_floor_add_one (D - delta)
    norm_num only [Nat.cast_add, Nat.cast_one] at h
    linarith
  have hceilK : ((Nat.ceil K : ℕ) : ℝ) ≤ K + 1 := by
    exact (Nat.ceil_lt_add_one hK).le
  have hceilD : ((Nat.ceil (D + delta) : ℕ) : ℝ) ≤ D + delta + 1 := by
    exact (Nat.ceil_lt_add_one hhi).le
  have hsub := natCast_sub_ge_sub_cast
    (7 * Nat.floor (D - delta)) (28 * Nat.ceil K)
  norm_num only [Nat.cast_mul] at hsub
  have hlower :
      7 * D - (7 * delta + 28 * K + 35) ≤
        ((7 * Nat.floor (D - delta) - 28 * Nat.ceil K : ℕ) : ℝ) := by
    nlinarith
  have hupper : ((7 * Nat.ceil (D + delta) : ℕ) : ℝ) ≤
      7 * D + 7 * delta + 7 := by
    norm_num only [Nat.cast_mul]
    nlinarith
  constructor
  · have hmul := mul_le_mul_of_nonneg_left hlower hb
    apply sub_le_sub_right _ (defect / a)
    rw [div_mul_eq_mul_div]
    apply (div_le_div_iff₀ ha ha).2
    field_simp [ne_of_gt ha] at hmul ⊢
    nlinarith
  · apply (div_le_iff₀ ha).2
    have hmul := mul_le_mul_of_nonneg_left hupper hb
    field_simp [ne_of_gt ha] at hmul ⊢
    nlinarith

/-! ## Exact enhanced combinatorial degree window -/

noncomputable def degreeEnhancedCombLo
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma eta d N : ℝ) (k : ℕ) (M : Hypergraph V) : ℝ :=
  let lo := CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
    CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
  (degree (availableEdges H C M) v : ℝ) *
      (((7 * Nat.floor lo - 28 * Nat.ceil (Real.rpow d (1 - eta)) : ℕ) : ℝ) +
        (CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) -
          degreeInternalCorridorError D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N k)) /
      ((availableEdges H C M).card : ℝ) -
    vertexInternalOpenLinkDefect C (availableEdges H C M) M v /
      ((availableEdges H C M).card : ℝ)

noncomputable def degreeEnhancedCombHi
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma eta d N : ℝ) (k : ℕ) (M : Hypergraph V) : ℝ :=
  let hi := CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
    CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
  (degree (availableEdges H C M) v : ℝ) *
      (((7 * Nat.ceil hi : ℕ) : ℝ) +
        (CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
          degreeInternalCorridorError D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N k)) /
      ((availableEdges H C M).card : ℝ)

/-- The old internal-link corridors and the exact reachable component of
the enhanced event give the source-faithful miss-loss interval.  The
duplicate correction is retained as the exact vertex aggregate here and
is absorbed only in the subsequent scalar theorem. -/
theorem meanMissAvailableDegreeLoss_bounds_of_degreeEnhancedGood
    {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} {T ell k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ : ℝ) {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ Gamma eta d (vertexFinset H).card T
          j R.restrictedWeight) k M)
    (Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (v : ActualHostVertex H) (hv : v.1 ∈ uncoveredVertices H M) :
    degreeEnhancedCombLo H R.regularized v.1 D₂ D₃ D₄ Gamma eta d
        ((vertexFinset H).card : ℝ) k M ≤
      meanMissAvailableDegreeLoss H R.regularized M v.1 ∧
    meanMissAvailableDegreeLoss H R.regularized M v.1 ≤
      degreeEnhancedCombHi H R.regularized v.1 D₂ D₃ D₄ Gamma eta d
        ((vertexFinset H).card : ℝ) k M := by
  rcases hI with
    ⟨hH8, _hCsys, _hell, _hC4, _heta0, _heta1, _hd,
      _hNupper, _hdegree, hcodegree, _hbounded, _htests, _htrack⟩
  have hold := indexedDegreeEnhancedGood_old
    H R.regularized D₂ D₃ D₄ Gamma eta d (vertexFinset H).card T
      j R.restrictedWeight hgood
  have hlocal := indexedDegreeEnhancedGood_local
    H R.regularized D₂ D₃ D₄ Gamma eta d (vertexFinset H).card T
      j R.restrictedWeight hgood
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d ((vertexFinset H).card : ℝ) T hlocal
  have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
    H R.regularized D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
      ((vertexFinset H).card : ℝ) j R.restrictedWeight hold
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d
    ((vertexFinset H).card : ℝ) (k : ℝ)
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ) (k : ℝ)
  have hDpos : 0 < D := by
    exact (Real.rpow_pos_of_pos
      (lt_of_lt_of_le zero_lt_one Rstep.degree.d_one)
      (1 - CFMNumeric.coreEpsilon eta / 32)).trans_le
        (by simpa only [D] using Rstep.dHat_lower (k : ℝ) hx)
  have hxi := (Rstep.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hdeltaEq : delta =
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) (k : ℝ) * D := by
    rfl
  have hlo0 : 0 ≤ D - delta := by
    rw [hdeltaEq]
    nlinarith [mul_le_mul_of_nonneg_right hxi hDpos.le]
  have hloPos : 0 < D - delta := by
    rw [hdeltaEq]
    nlinarith [mul_le_mul_of_nonneg_right hxi hDpos.le]
  have hfloorceil := availableDegreeWithin_floor_ceil_bounds
    H R.regularized M hlo0 hdegree
  have hA : (availableEdges H R.regularized M).Nonempty := by
    have hvdeg : 0 < (degree (availableEdges H R.regularized M) v.1 : ℝ) :=
      hloPos.trans_le (hdegree v.1 hv).1
    have hvdegNat : 0 < degree (availableEdges H R.regularized M) v.1 := by
      exact_mod_cast hvdeg
    unfold degree at hvdegNat
    obtain ⟨e, he⟩ := Finset.card_pos.mp hvdegNat
    exact ⟨e, (Finset.mem_filter.mp he).1⟩
  have hco := availableEdges_maxCodegreeLE_ceil_of_real
    H R.regularized M hcodegree
  have hHnonempty : ∀ f ∈ H, f.Nonempty := by
    intro f hf
    exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
  have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
    H R.regularized D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
      ((vertexFinset H).card : ℝ) j R.restrictedWeight hold
  have h₁ : ∀ f ∈ availableEdges H R.regularized M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d
          ((vertexFinset H).card : ℝ) 1 1 (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) 1 1 (k : ℝ)) ≤
        ((partialFamily (conflictLinkLayer R.regularized f 1)
          (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 1)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d
          ((vertexFinset H).card : ℝ) 1 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) 1 1 (k : ℝ)) := by
    intro f hf
    exact internalConflictLink_bounds_of_corridors H R.regularized f
      D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
      ((vertexFinset H).card : ℝ) D₂ 1 1 k M hf
      (hlinks ⟨f, availableEdges_subset H R.regularized M hf⟩).1
  have h₂ : ∀ f ∈ availableEdges H R.regularized M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d
          ((vertexFinset H).card : ℝ) 2 1 (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) 2 1 (k : ℝ)) ≤
        ((partialFamily (conflictLinkLayer R.regularized f 2)
          (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 2)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d
          ((vertexFinset H).card : ℝ) 2 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) 2 1 (k : ℝ)) := by
    intro f hf
    exact internalConflictLink_bounds_of_corridors H R.regularized f
      D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
      ((vertexFinset H).card : ℝ) D₃ 2 1 k M hf
      (hlinks ⟨f, availableEdges_subset H R.regularized M hf⟩).2.1
  have h₃ : ∀ f ∈ availableEdges H R.regularized M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d
          ((vertexFinset H).card : ℝ) 3 1 (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) 3 1 (k : ℝ)) ≤
        ((partialFamily (conflictLinkLayer R.regularized f 3)
          (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 3)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d
          ((vertexFinset H).card : ℝ) 3 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
          ((vertexFinset H).card : ℝ) 3 1 (k : ℝ)) := by
    intro f hf
    exact internalConflictLink_bounds_of_corridors H R.regularized f
      D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
      ((vertexFinset H).card : ℝ) D₄ 3 1 k M hf
      (hlinks ⟨f, availableEdges_subset H R.regularized M hf⟩).2.2
  have hbounds := meanMissAvailableDegreeLoss_bounds_of_degree_internalLinks_vertexDefect
    hHnonempty hH8 (fun c hc ↦ R.bounded.conflict_card hc) hreach.1
    hfloorceil.1 hfloorceil.2 hco h₁ h₂ h₃ v.1 hA
  simpa [degreeEnhancedCombLo, degreeEnhancedCombHi,
    degreeInternalCorridorError, D, delta] using hbounds

/-! ## Scalar closure of the exact enhanced degree window -/

/-- The exact rounded combinatorial endpoints are absorbed by the degree
envelope whenever the eight-uniform handshake, duplicate correction, and
logarithmic envelope margin satisfy their canonical scalar bounds. -/
theorem degreeEnhancedComb_numeric_of_handshake
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (D₂ D₃ D₄ Gamma eta d N : ℝ) (k : ℕ)
    (u : ℝ)
    (ha : 0 < ((availableEdges H C M).card : ℝ))
    (hGamma : 1 ≤ Gamma)
    (hd : 0 ≤ d)
    (hu : 0 < u)
    (hD : 0 < CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ))
    (hdelta0 : 0 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ))
    (hsmall : 5 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) ≤
      CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ))
    (hbLo : CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ) ≤
      (degree (availableEdges H C M) v : ℝ))
    (hbHi : (degree (availableEdges H C M) v : ℝ) ≤
      CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ))
    (haLo : u * (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) / 8 ≤
      ((availableEdges H C M).card : ℝ))
    (haHi : ((availableEdges H C M).card : ℝ) ≤
      u * (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) / 8)
    (hcenter0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
      7 * CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ))
    (hcenter : CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
        7 * CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) ≤
      13 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ))
    (herror0 : 0 ≤
      7 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ) +
        28 * Real.rpow d (1 - eta) + 35 +
          degreeInternalCorridorError D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N k)
    (herror :
      7 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ) +
        28 * Real.rpow d (1 - eta) + 35 +
          degreeInternalCorridorError D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N k ≤
      64 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ))
    (hdefect0 : 0 ≤ vertexInternalOpenLinkDefect C
      (availableEdges H C M) M v /
        ((availableEdges H C M).card : ℝ))
    (hdefect : vertexInternalOpenLinkDefect C
        (availableEdges H C M) M v /
          ((availableEdges H C M).card : ℝ) ≤
      10 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) / u)
    (hhost : 5000 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) ≤
      u * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ))
    (hsurv : 1 / 4 ≤ survivingVertexProbability H C v M)
    (hsurvEq : survivingVertexProbability H C v M =
      1 - (degree (availableEdges H C M) v : ℝ) /
        ((availableEdges H C M).card : ℝ))
    (hrate : -CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) =
      (CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
        7 * CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) * (8 / u))
    (hdeltaRate : 76000 *
        (Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ) / u) ≤
      CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ))
    (hrem : d ^ (1 - CFMNumeric.coreEpsilon eta) / N ≤
      Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) / u) :
    survivingVertexProbability H C v M *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N (k : ℝ) +
          2 * (d ^ (1 - CFMNumeric.coreEpsilon eta) / N)) ≤
      degreeEnhancedCombLo H C v D₂ D₃ D₄ Gamma eta d N k M ∧
    degreeEnhancedCombHi H C v D₂ D₃ D₄ Gamma eta d N k M ≤
      survivingVertexProbability H C v M *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N (k : ℝ) -
          2 * (d ^ (1 - CFMNumeric.coreEpsilon eta) / N)) := by
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
  let b := (degree (availableEdges H C M) v : ℝ)
  let a := ((availableEdges H C M).card : ℝ)
  let center := CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) + 7 * D
  let err := 7 * delta + 28 * Real.rpow d (1 - eta) + 35 +
    degreeInternalCorridorError D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N k
  let defectOverA := vertexInternalOpenLinkDefect C
    (availableEdges H C M) M v / a
  let scale := Gamma * delta / u
  have hb0 : 0 ≤ b := by dsimp only [b]; positivity
  have hlo0 : 0 ≤ D - delta := by dsimp only [D, delta]; linarith
  have hhi0 : 0 ≤ D + delta := by dsimp only [D, delta]; linarith
  have hK0 : 0 ≤ Real.rpow d (1 - eta) := Real.rpow_nonneg hd _
  have hratio := degreeRatio_bounds_of_handshake hu (by simpa only [D] using hD)
