/-- The internal nonfull contribution consumes one unit at the final
`eps/10` scale. -/
theorem RegularizationCertificate.internalGainCollisionResidualNonFullRootMass_le_scale
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 72 * (3 * Gamma + 1) ≤ Real.rpow d (eps / 10))
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualNonFullRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized j r root ≤
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d
          (((r - j : ℕ) : ℝ) - (root.card : ℝ) - eps / 10) := by
  let scale := certificateInternalLayerScale
    H C d eps Gamma ell testJ testW Rcert (j + 1)
  let w := conflictLinkTestWeight Rcert.regularized f₀ j
  have hP :=
    Erdos136.RegularizationCertificate.internalLink_hasGainCollisionResidualProperSourceBounds
      Rcert hd heps f₀ hf₀H j hj1 hj3
  have hscale0 : 0 ≤ scale :=
    (certificateInternalLayerScale_pos
      H C d eps Gamma ell testJ testW Rcert (j + 1)
        (by linarith)).le
  have hraw :=
    weightedGainCollisionResidualNonFullRootMass_le_raw_of_properSourceBounds
      (r := r) hP Rcert.bounded hd (by linarith : 0 ≤ eps / 5)
        heps (by norm_num)
        (mul_nonneg (by norm_num) hscale0) hj3 root hrootH hroot2
  have hGamma : 0 ≤ 3 * Gamma :=
    regularizedBounded_Gamma_nonneg Rcert.bounded (by linarith : 0 < d)
  have hcoef : 72 ≤ Real.rpow d (eps / 10) := by
    apply le_trans (b := 72 * (3 * Gamma + 1))
    · nlinarith
    · exact hcutoff
  let A : ℝ := ((r - j : ℕ) : ℝ) - (root.card : ℝ)
  have hpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d) (A - eps / 4)
  change weightedGainCollisionResidualNonFullRootMass
      w H Rcert.regularized j r root ≤
    scale * Real.rpow d (A - eps / 10)
  have hraw' : weightedGainCollisionResidualNonFullRootMass
      w H Rcert.regularized j r root ≤
      72 * scale * Real.rpow d (A - eps / 4) := by
    convert hraw using 1 <;> dsimp only [w, scale, A] <;> ring
  apply hraw'.trans
  calc
    72 * scale * Real.rpow d (A - eps / 4) ≤
        Real.rpow d (eps / 10) * scale *
          Real.rpow d (A - eps / 4) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hcoef hscale0) hpow0
    _ = scale * Real.rpow d (A - 3 * eps / 20) := by
      calc
        Real.rpow d (eps / 10) * scale * Real.rpow d (A - eps / 4) =
            scale * (Real.rpow d (eps / 10) *
              Real.rpow d (A - eps / 4)) := by ring
        _ = scale * Real.rpow d (eps / 10 + (A - eps / 4)) := by
          congr 1
          exact (Real.rpow_add (by linarith : 0 < d) _ _).symm
        _ = scale * Real.rpow d (A - 3 * eps / 20) := by
          congr 2
          ring
    _ ≤ scale * Real.rpow d (A - eps / 10) := by
      apply mul_le_mul_of_nonneg_left _ hscale0
      apply Real.rpow_le_rpow_of_exponent_le hd
      linarith

