    have h := CFMTrajectories.hHat_pos
      (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      hd R.delta.degree.N_pos hp
    have hxi := (R.delta.xi_upper (k : ℝ) hx).trans
      (CFMNumeric.envelopeFactor_le_fifth S)
    have hm := mul_le_mul_of_nonneg_left hxi h.le
    nlinarith
  have hcoeffNat :
      (64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d : ℕ) ≤
        64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d +
          Nat.ceil (30 * localSpreadPrimaryMargin eta d) := by omega
  have hordinary :
      ((((64 * Nat.ceil (d ^ (1 - eta)) +
            16 * certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d : ℕ) : ℝ) *
          currentHi) / a) ≤ 7000 * common := by
    have hfull := higherKilledLossError_le_sevenThousand_common
      (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := G)
      (N := N) (a := a) (scale := scale) (k := k) (j := 1) (s := 1)
      E S R hscale0 (by norm_num) haLo
    have hcast :
        (((64 * Nat.ceil (d ^ (1 - eta)) +
            16 * certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d : ℕ) : ℝ)) ≤
          (((64 * Nat.ceil (d ^ (1 - eta)) +
            16 * certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d +
            Nat.ceil (30 * localSpreadPrimaryMargin eta d) : ℕ) : ℝ)) := by
      exact_mod_cast hcoeffNat
    have hnum := mul_le_mul_of_nonneg_right hcast hcurrent0
    exact (div_le_div_of_nonneg_right hnum ha0).trans
      (by simpa only [currentHi, Z, Env, G, common, one_mul] using hfull)
  have hvictim : (status * victimScale) / a ≤ 1000 * common := by
    dsimp only [status, victimScale, common, scale, Env, G]
    exact rankOneVictimError_le_oneThousand_common H C Rcert E S R haLo
  have hsurvival := survivalCenterError_le_tenThousand_common
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := G)
    (N := N) (a := a) (scale := scale) (k := k) (j := 1) (s := 1)
    E S hN R hscale0 (by norm_num) haLo
  have hcommon0 : 0 ≤ common := by
    dsimp only [common]
    exact mul_nonneg hscale0
      (div_nonneg (mul_nonneg (by dsimp only [G]; positivity) hEnv0)
        (mul_nonneg R.delta.degree.N_pos.le hp.le))
  have hsplit :
      ((((64 * Nat.ceil (d ^ (1 - eta)) +
            16 * certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d : ℕ) : ℝ) *
          currentHi + status * victimScale) / a) =
        ((((64 * Nat.ceil (d ^ (1 - eta)) +
            16 * certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d : ℕ) : ℝ) *
