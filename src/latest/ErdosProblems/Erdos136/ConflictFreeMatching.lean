namespace Erdos136

open Finset Real
open scoped BigOperators

noncomputable section

variable {V : Type*} [DecidableEq V]

/-! A generic extraction layer for adjoining source-faithful local-spread
coordinates to the three regularized corridor families.  The concrete local
families and their tails are supplied later; this layer only handles the
simultaneous Good predicate and terminal projection. -/

abbrev EnhancedRegularizedGreedyIndex
    {iota : Type*} (H : Hypergraph V) (j : iota → ℕ) (L : Type*) :=
  Sum (RegularizedGreedyCorridorIndex H j) L

noncomputable def enhancedRegularizedGreedyPredicate
    {iota L : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (localPredicate : L → ℕ → Hypergraph V → Prop) :
    EnhancedRegularizedGreedyIndex H j L → ℕ → Hypergraph V → Prop
  | Sum.inl a, k, M =>
      regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N
        j w a k M
  | Sum.inr a, k, M => localPredicate a k M

noncomputable def enhancedRegularizedGreedyTail
    {iota L : Type*} {H : Hypergraph V} {j : iota → ℕ}
    (oldTail : RegularizedGreedyCorridorIndex H j → ℝ)
    (localTail : L → ℝ) : EnhancedRegularizedGreedyIndex H j L → ℝ
  | Sum.inl a => oldTail a
  | Sum.inr a => localTail a

@[simp] theorem enhancedRegularizedGreedyPredicate_old
    {iota L : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (localPredicate : L → ℕ → Hypergraph V → Prop)
    (a : RegularizedGreedyCorridorIndex H j) (k : ℕ) (M : Hypergraph V) :
    enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d N
        j w localPredicate (Sum.inl a) k M ↔
      regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N
        j w a k M := by
  rfl

@[simp] theorem enhancedRegularizedGreedyPredicate_local
    {iota L : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (localPredicate : L → ℕ → Hypergraph V → Prop)
    (a : L) (k : ℕ) (M : Hypergraph V) :
    enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d N
        j w localPredicate (Sum.inr a) k M ↔ localPredicate a k M := by
  rfl

@[simp] theorem enhancedRegularizedGreedyTail_old
    {iota L : Type*} {H : Hypergraph V} {j : iota → ℕ}
    (oldTail : RegularizedGreedyCorridorIndex H j → ℝ)
    (localTail : L → ℝ) (a : RegularizedGreedyCorridorIndex H j) :
    enhancedRegularizedGreedyTail oldTail localTail (Sum.inl a) = oldTail a := by
  rfl

@[simp] theorem enhancedRegularizedGreedyTail_local
    {iota L : Type*} {H : Hypergraph V} {j : iota → ℕ}
    (oldTail : RegularizedGreedyCorridorIndex H j → ℝ)
    (localTail : L → ℝ) (a : L) :
    enhancedRegularizedGreedyTail oldTail localTail (Sum.inr a) = localTail a := by
  rfl

theorem indexedEnhancedRegularizedGreedyGood_old
    {iota L : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (localPredicate : L → ℕ → Hypergraph V → Prop) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d N
        j w localPredicate) k M) :
    indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M := by
  intro a
  exact hgood (Sum.inl a)

theorem indexedEnhancedRegularizedGreedyGood_local
    {iota L : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (localPredicate : L → ℕ → Hypergraph V → Prop) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d N
        j w localPredicate) k M) (a : L) : localPredicate a k M := by
  exact hgood (Sum.inr a)

/-- Simultaneous extraction with an arbitrary finite family of additional
local-spread coordinates.  The old degree corridors still certify
nonfreezing, and only the old external zero-coordinates are read at the
terminal state. -/
theorem exists_regularizedGreedyCore_of_enhancedFirstFailureBounds
    {iota L : Type*} [Fintype iota] [Fintype L] [Fintype V]
    (H : Hypergraph V) (C : ConflictSystem V) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d err : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (localPredicate : L → ℕ → Hypergraph V → Prop)
    (oldTail : RegularizedGreedyCorridorIndex H j → ℝ)
    (localTail : L → ℝ)
    (hH : IsUniform H 8) (hC : ∅ ∉ C)
    (hsize : 8 * T < (vertexFinset H).card)
    (htrajectory : ∀ k, k < T →
      0 < CFMTrajectories.dHat D₂ D₃ D₄ d ((vertexFinset H).card : ℝ) k -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d
          ((vertexFinset H).card : ℝ) k)
    (hinitialOld : ∀ a : RegularizedGreedyCorridorIndex H j,
      regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
        ((vertexFinset H).card : ℝ) j w a 0 ∅)
    (hinitialLocal : ∀ a : L, localPredicate a 0 ∅)
    (hBadOld : ∀ a : RegularizedGreedyCorridorIndex H j,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w localPredicate)
            (Sum.inl a)) ≤ oldTail a)
    (hBadLocal : ∀ a : L,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w localPredicate)
            (Sum.inr a)) ≤ localTail a)
    (htotal : (∑ a, oldTail a) + ∑ a, localTail a < 1)
    (hterminal : ∀ M, IsMatching H M → M.card = T →
      (∀ i,
        externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d
            ((vertexFinset H).card : ℝ) (testTotal (w i) H (j i))
            (j i) 0 T M ∧
          externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d
            ((vertexFinset H).card : ℝ) (testTotal (w i) H (j i))
            (j i) 0 T M) →
      SatisfiesTestEstimates H M d err j w) :
    ∃ M, IsConflictFreeMatching H C M ∧ M.card = T ∧
      SatisfiesTestEstimates H M d err j w := by
  let P := enhancedRegularizedGreedyPredicate H C D₂ D₃ D₄ Gamma epsilon d
    ((vertexFinset H).card : ℝ) j w localPredicate
  let tail := enhancedRegularizedGreedyTail oldTail localTail
  have hBad : ∀ a : EnhancedRegularizedGreedyIndex H j L,
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ T P a) ≤ tail a := by
    rintro (a | a)
    · simpa [P, tail] using hBadOld a
    · simpa [P, tail] using hBadLocal a
  have hsum : (∑ a : EnhancedRegularizedGreedyIndex H j L, tail a) < 1 := by
    rw [Fintype.sum_sum_type]
    simpa [tail] using htotal
  have hinitial : ∀ a : EnhancedRegularizedGreedyIndex H j L, P a 0 ∅ := by
    rintro (a | a)
    · simpa [P] using hinitialOld a
    · simpa [P] using hinitialLocal a
  have hnonfreeze : ∀ omega : GreedyOutcome H T,
      greedyPrefixGood H C ∅ (indexedGreedyGood P) T omega →
      ∀ k, k < T →
        (availableEdges H C (greedyStateAt H C omega k)).Nonempty := by
    intro omega hpref k hk
    apply availableEdges_nonempty_of_degreeLowerCorridors
      H C hH hC omega k hk hsize D₂ D₃ D₄ Gamma epsilon d
        ((vertexFinset H).card : ℝ) (htrajectory k hk)
    intro v hv
    let v' : ActualHostVertex H := ⟨v, (mem_uncoveredVertices.mp hv).1⟩
    rw [greedyStateAt_eq_stateFrom_empty]
    exact indexedRegularizedGreedyGood_degreeLower
      H C D₂ D₃ D₄ Gamma epsilon d ((vertexFinset H).card : ℝ) j w
        (indexedEnhancedRegularizedGreedyGood_old
          H C D₂ D₃ D₄ Gamma epsilon d ((vertexFinset H).card : ℝ) j w localPredicate
          (hpref k (Nat.le_of_lt hk))) v'
  obtain ⟨omega, hpref, hmatching, hcard⟩ :=
    exists_greedy_outcome_of_firstFailureTails_reachable H C T P tail
      hBad hsum hinitial hnonfreeze hC
  let M := greedyStateAt H C omega T
  refine ⟨M, hmatching, hcard, ?_⟩
  apply hterminal M hmatching.1 hcard
  intro i
  simpa [M, greedyStateAt_eq_stateFrom_empty] using
    (indexedRegularizedGreedyGood_externalZero
      H C D₂ D₃ D₄ Gamma epsilon d ((vertexFinset H).card : ℝ) j w
      (indexedEnhancedRegularizedGreedyGood_old
        H C D₂ D₃ D₄ Gamma epsilon d ((vertexFinset H).card : ℝ) j w localPredicate
        (hpref T le_rfl)) i)

/-- The three paired corridor families consume at most one half of the
probability budget.  This sharper form leaves room for the one-sided local
spread families in the enhanced index. -/
theorem regularizedGreedyCorridorCommonTail_sum_le_half
    {iota : Type*} [Fintype iota] [Fintype V]
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (j : iota → ℕ) (hj : ∀ i, j i ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤ Real.exp (d ^ (eta ^ 3)))
    (htests : (Fintype.card iota : ℝ) ≤ Real.exp (d ^ (eta ^ 3))) :
    (∑ a : RegularizedGreedyCorridorIndex H j,
      regularizedGreedyCorridorTail
        (fun _ : ActualHostVertex H ↦ CFMNumericAggregation.commonTail eta d)
        (fun _ : ExternalTestCoordinate j ↦ CFMNumericAggregation.commonTail eta d)
        (fun _ : InternalLinkCoordinate H ↦ CFMNumericAggregation.commonTail eta d) a) ≤
      1 / 2 := by
  let x := 5 * d ^ CFMNumeric.tailPower eta
  let y := 9 * d ^ (eta ^ 3)
  have hy0 : 0 ≤ y := by
    exact mul_nonneg (by norm_num)
      (Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _)
  have hbudget := CFMNumericAggregation.CoreCutoffSpec.strongFailureBudget S
  have hlogpos : 0 < Real.log 12 := Real.log_pos (by norm_num)
  have hxpos : 0 < x := by
    dsimp only [x]
    have := hbudget.2
    nlinarith
  have hgap : y - x ≤ -Real.log 12 := by
    dsimp only [x, y]
    nlinarith [hbudget.1, hbudget.2]
  have hexp : Real.exp (y - x) ≤ 1 / 12 := by
    calc
      Real.exp (y - x) ≤ Real.exp (-Real.log 12) :=
        Real.exp_le_exp.mpr hgap
      _ = 1 / 12 := by
        rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 12)]
        norm_num
  have hdegree := CFMNumeric.pairedFamilySum_le_sixth x y
    (fun _ : ActualHostVertex H ↦ CFMNumericAggregation.commonTail eta d)
    (CFMNumericAggregation.actualHostVertex_card_le_entropy S H hvertex)
    (by intro i; rfl) hexp
  have hexternal := CFMNumeric.pairedFamilySum_le_sixth x y
    (fun _ : ExternalTestCoordinate j ↦ CFMNumericAggregation.commonTail eta d)
    (CFMNumericAggregation.externalTestCoordinate_card_le_entropy
      S j hj htests)
    (by intro i; rfl) hexp
  have hinternal := CFMNumeric.pairedFamilySum_le_sixth x y
    (fun _ : InternalLinkCoordinate H ↦ CFMNumericAggregation.commonTail eta d)
    (CFMNumericAggregation.internalLinkCoordinate_card_le_entropy
      S H hH hvertex)
    (by intro i; rfl) hexp
  simp [RegularizedGreedyCorridorIndex,
    regularizedGreedyCorridorTail,
    Fintype.sum_sum_type] at hdegree hexternal hinternal ⊢
  nlinarith

/-- A convenient arithmetic combiner for an enhanced finite union. -/
theorem enhancedFailureTail_sum_lt_one_of_half_quarter
    {iota L : Type*} [Fintype iota] [Fintype L]
    {H : Hypergraph V} {j : iota → ℕ}
    (oldTail : RegularizedGreedyCorridorIndex H j → ℝ)
    (localTail : L → ℝ)
    (hold : (∑ a, oldTail a) ≤ 1 / 2)
    (hlocal : (∑ a, localTail a) ≤ 1 / 4) :
    (∑ a : EnhancedRegularizedGreedyIndex H j L,
      enhancedRegularizedGreedyTail oldTail localTail a) < 1 := by
  rw [Fintype.sum_sum_type]
  simp only [enhancedRegularizedGreedyTail_old,
    enhancedRegularizedGreedyTail_local]
  linarith

end

end Erdos136

namespace Erdos136

open Finset Real
open scoped BigOperators

noncomputable section

/-! Scratch-only assembly helpers for the public endpoint. -/

/-- A nonempty specialized host has the cardinality floor used by every
core cutoff estimate.  The proof cancels one pair-codegree factor from a
single positive host degree. -/
theorem specializedHost_card_ge_half_rpow
    {V iota : Type*} [DecidableEq V] [Fintype V] [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V) (d eta Gamma : ℝ)
    (ell : ℕ) (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (hHne : H.Nonempty) (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    d ^ eta / 2 ≤ ((vertexFinset H).card : ℝ) := by
  rcases hI with
    ⟨hH8, _hCsys, _hell, _hCfour, _heta, _heta1, hd1, _hvertex,
      hdegree, hcodegree, _hbounded, _htests, _htrack⟩
  exact CFMRegularization.half_rpow_le_vertexFinset_card hH8 hHne
    (lt_of_lt_of_le zero_lt_one hd1) S.inverseInputSmall
    (fun v hv ↦ (hdegree v hv).1) hcodegree

theorem specializedCFMConclusion_of_not_nonempty
    {V ι : Type*} [DecidableEq V] [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (d eta : ℝ) (ell : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (hne : ¬ H.Nonempty) :
    SpecializedCFMConclusion H C d eta j w := by
  rcases hI with
    ⟨hH8, hCsys, hell, hCfour, heta0, heta1, hd, hvertex,
      hdegree, hcodegree, hbounded, htests, htrack⟩
  have hH : H = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
  have hnoIndex : ∀ i : ι, False := by
    intro i
    have hji : 0 < j i := lt_of_lt_of_le Nat.zero_lt_one (htrack i).1
    have hmass := (htrack i).2.2.2.1
    have htotal : testTotal (w i) H (j i) = 0 := by
      rw [hH]
      exact testTotal_empty_of_pos (w i) hji
    rw [htotal] at hmass
    have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
    have hp := Real.rpow_pos_of_pos hdpos ((j i : ℝ) + eta)
    exact (not_lt_of_ge hmass hp)
  unfold SpecializedCFMConclusion
  refine ⟨∅, isMatching_empty H, conflictFree_empty hbounded.empty_not_mem, ?_, ?_⟩
  · rw [hH]
    simp
  · unfold SatisfiesTestEstimates
    intro i
    exact (hnoIndex i).elim

theorem specializedCFMConclusion_of_restrictedCore
    {V ι : Type*} [DecidableEq V] [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (d eta GammaCert GammaCore : ℝ)
    (ell : ℕ) (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d) (T : ℕ)
    (heta : 0 ≤ eta) (hw : ∀ i S, 0 ≤ w i S)
    (hTlower :
      (1 - CFMNumeric.publicError eta d) *
          ((vertexFinset H).card : ℝ) / 8 ≤ (T : ℝ))
    (hcore : ∃ M,
      IsConflictFreeMatching H R.regularized M ∧ M.card = T ∧
        SatisfiesTestEstimates H M d
          (CFMNumeric.publicError eta d / 2) j R.restrictedWeight) :
    SpecializedCFMConclusion H C d eta j w := by
  obtain ⟨M, hM, hcard, htests⟩ := hcore
  have hdpos : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hd0 : 0 ≤ d := hdpos.le
  have herr0 : 0 ≤ CFMNumeric.publicError eta d := by
    unfold CFMNumeric.publicError
    positivity
  have herr1 : CFMNumeric.publicError eta d ≤ 1 :=
    CFMNumeric.publicError_le_one heta
      (by linarith [S.degreeAtLeastTwo])
  unfold SpecializedCFMConclusion
  refine ⟨M, hM.1, R.conflictFree_original hM.1 hM.2, ?_, ?_⟩
  · rw [hcard]
    exact hTlower
  · unfold SatisfiesTestEstimates
    intro i
    apply restrictedTestEstimate_transfer H M R.regularized (w i) d
      (CFMNumeric.publicError eta d) (j i)
      (hw i) hM.2 hd0 herr0 herr1
    · have hW0 : 0 ≤ testTotal (w i) H (j i) :=
        testTotal_nonneg (hw i) H (j i)
      have hdiv :
          testTotal (w i) H (j i) /
              d ^ CFMRegularization.rawRegularizationEps eta =
            testTotal (w i) H (j i) *
              d ^ (-CFMRegularization.rawRegularizationEps eta) := by
        rw [div_eq_mul_inv]
        congr 1
        exact (Real.rpow_neg hdpos.le
          (CFMRegularization.rawRegularizationEps eta)).symm
      calc
        CFMRegularization.killedWeight H R.regularized (j i) (w i) ≤
            testTotal (w i) H (j i) /
              d ^ CFMRegularization.rawRegularizationEps eta :=
          R.killedWeight_small i
        _ = testTotal (w i) H (j i) *
              d ^ (-CFMRegularization.rawRegularizationEps eta) := hdiv
        _ ≤ testTotal (w i) H (j i) *
              (CFMNumeric.publicError eta d / 4) := by
          exact mul_le_mul_of_nonneg_left
            (CFMNumeric.killedWeightDecay_le_publicError_quarter S) hW0
        _ = CFMNumeric.publicError eta d / 4 *
              testTotal (w i) H (j i) := by ring
    · rw [← R.restrictedWeight_definition i]
      exact htests i

variable {V : Type*} [DecidableEq V]

/-! The source collision family `C_{e,2}`: unions of two distinct conflict
links through `e` which share at least one host edge. -/

def allNonemptyConflictLinks (C : ConflictSystem V) (e : Finset V) :
    ConflictSystem V :=
  (Finset.Icc 1 3).biUnion fun q ↦ conflictLinkLayer C e q

def duplicateConflictLinkPairs (C : ConflictSystem V) (e : Finset V) :
    Finset (ConflictSystem V) :=
  ((allNonemptyConflictLinks C e).powersetCard 2).filter fun p ↦
    ∃ Q ∈ p, ∃ Q' ∈ p, Q ≠ Q' ∧ ¬Disjoint Q Q'

def duplicateConflictLinkUnions (C : ConflictSystem V) (e : Finset V) :
    ConflictSystem V :=
  (duplicateConflictLinkPairs C e).image fun p ↦ p.biUnion id

def duplicateConflictLinkUnionLayer
    (C : ConflictSystem V) (e : Finset V) (r : ℕ) : ConflictSystem V :=
  (duplicateConflictLinkUnions C e).filter fun U ↦ U.card = r

@[simp] theorem mem_allNonemptyConflictLinks
    {C : ConflictSystem V} {e : Finset V} {Q : Hypergraph V} :
    Q ∈ allNonemptyConflictLinks C e ↔
      ∃ q ∈ Finset.Icc 1 3, Q ∈ conflictLinkLayer C e q := by
  simp [allNonemptyConflictLinks]

@[simp] theorem mem_duplicateConflictLinkPairs
    {C : ConflictSystem V} {e : Finset V} {p : ConflictSystem V} :
    p ∈ duplicateConflictLinkPairs C e ↔
      p ⊆ allNonemptyConflictLinks C e ∧ p.card = 2 ∧
        ∃ Q ∈ p, ∃ Q' ∈ p, Q ≠ Q' ∧ ¬Disjoint Q Q' := by
  simp [duplicateConflictLinkPairs, and_assoc]

@[simp] theorem mem_duplicateConflictLinkUnions
    {C : ConflictSystem V} {e : Finset V} {U : Hypergraph V} :
    U ∈ duplicateConflictLinkUnions C e ↔
      ∃ p ∈ duplicateConflictLinkPairs C e, p.biUnion id = U := by
  simp [duplicateConflictLinkUnions, eq_comm]

@[simp] theorem mem_duplicateConflictLinkUnionLayer
    {C : ConflictSystem V} {e : Finset V} {r : ℕ} {U : Hypergraph V} :
    U ∈ duplicateConflictLinkUnionLayer C e r ↔
      U ∈ duplicateConflictLinkUnions C e ∧ U.card = r := by
  simp [duplicateConflictLinkUnionLayer]

theorem duplicateConflictLinkUnionLayer_uniform
    (C : ConflictSystem V) (e : Finset V) (r : ℕ) :
    IsUniform (duplicateConflictLinkUnionLayer C e r) r := by
  intro U hU
  exact (mem_duplicateConflictLinkUnionLayer.mp hU).2

/-- Coarse rank support sufficient for finite layer decomposition.  The
source antichain sharpens six to five, but no consumer needs that saving. -/
theorem duplicateConflictLinkUnions_card_le_six
    {C : ConflictSystem V} {e : Finset V} {U : Hypergraph V}
    (hU : U ∈ duplicateConflictLinkUnions C e) : U.card ≤ 6 := by
  obtain ⟨p, hp, rfl⟩ := mem_duplicateConflictLinkUnions.mp hU
  obtain ⟨Q, Q', hQQ', rfl⟩ := Finset.card_eq_two.mp
    (mem_duplicateConflictLinkPairs.mp hp).2.1
  have hQ := (mem_duplicateConflictLinkPairs.mp hp).1
    (Finset.mem_insert_self Q {Q'})
  have hQ' := (mem_duplicateConflictLinkPairs.mp hp).1
    (Finset.mem_insert_of_mem (Finset.mem_singleton_self Q'))
  obtain ⟨q, hq, hQlink⟩ := mem_allNonemptyConflictLinks.mp hQ
  obtain ⟨q', hq', hQ'link⟩ := mem_allNonemptyConflictLinks.mp hQ'
  have hQcard : Q.card = q :=
    (mem_conflictLinkLayer.mp hQlink).2
  have hQ'card : Q'.card = q' :=
    (mem_conflictLinkLayer.mp hQ'link).2
  have hqupper : q ≤ 3 := (Finset.mem_Icc.mp hq).2
  have hq'upper : q' ≤ 3 := (Finset.mem_Icc.mp hq').2
  calc
    ((insert Q {Q'} : ConflictSystem V).biUnion id).card ≤
        Q.card + Q'.card := by
      simpa using Finset.card_union_le Q Q'
    _ ≤ 6 := by omega

theorem duplicateConflictLinkUnions_eq_layerUnion
    (C : ConflictSystem V) (e : Finset V) :
    duplicateConflictLinkUnions C e =
      (Finset.Icc 0 6).biUnion fun r ↦
        duplicateConflictLinkUnionLayer C e r := by
  ext U
  constructor
  · intro hU
    apply Finset.mem_biUnion.mpr
    exact ⟨U.card, Finset.mem_Icc.mpr
      ⟨Nat.zero_le _, duplicateConflictLinkUnions_card_le_six hU⟩,
      mem_duplicateConflictLinkUnionLayer.mpr ⟨hU, rfl⟩⟩
  · intro hU
    obtain ⟨r, _hr, hUr⟩ := Finset.mem_biUnion.mp hU
    exact (mem_duplicateConflictLinkUnionLayer.mp hUr).1

/-- The conflict antichain invariant descends to the full nonempty link
through a fixed edge. -/
theorem allNonemptyConflictLinks_antichain
    {C : ConflictSystem V} {f : Finset V}
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    {Q Q' : Hypergraph V}
    (hQ : Q ∈ allNonemptyConflictLinks C f)
    (hQ' : Q' ∈ allNonemptyConflictLinks C f) (hQQ' : Q ≠ Q') :
    ¬Q ⊆ Q' := by
  obtain ⟨q, _hq, hQlink⟩ := mem_allNonemptyConflictLinks.mp hQ
  obtain ⟨q', _hq', hQ'link⟩ := mem_allNonemptyConflictLinks.mp hQ'
  obtain ⟨⟨c, hcC, hfc, hcErase⟩, _⟩ := mem_conflictLinkLayer.mp hQlink
  obtain ⟨⟨c', hc'C, hfc', hc'Erase⟩, _⟩ := mem_conflictLinkLayer.mp hQ'link
  have hcEq : c = insert f Q := by
    calc
      c = insert f (c.erase f) := (Finset.insert_erase hfc).symm
      _ = insert f Q := by rw [hcErase]
  have hc'Eq : c' = insert f Q' := by
    calc
      c' = insert f (c'.erase f) := (Finset.insert_erase hfc').symm
      _ = insert f Q' := by rw [hc'Erase]
  have hfQ : f ∉ Q := by
    rw [← hcErase]
    simp
  have hfQ' : f ∉ Q' := by
    rw [← hc'Erase]
    simp
  have hcc' : c ≠ c' := by
    intro hcc'
    apply hQQ'
    have := congrArg (fun X : Hypergraph V ↦ X.erase f) hcc'
    simpa [hcEq, hc'Eq, hfQ, hfQ'] using this
  intro hsub
  apply hanti c hcC c' hc'C hcc'
  rw [hcEq, hc'Eq]
  exact Finset.insert_subset_insert f hsub

/-- With conflict sizes at most four and the antichain invariant, genuine
duplicate unions have ranks `3,4,5`; ranks `0,1,2,6` are empty. -/
theorem duplicateConflictLinkUnions_card_between_three_five
    {C : ConflictSystem V} {f : Finset V}
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    {U : Hypergraph V} (hU : U ∈ duplicateConflictLinkUnions C f) :
    3 ≤ U.card ∧ U.card ≤ 5 := by
  obtain ⟨p, hp, rfl⟩ := mem_duplicateConflictLinkUnions.mp hU
  obtain ⟨Q, Q', hQQ', rfl⟩ := Finset.card_eq_two.mp
    (mem_duplicateConflictLinkPairs.mp hp).2.1
  have hpdata := mem_duplicateConflictLinkPairs.mp hp
  have hQall : Q ∈ allNonemptyConflictLinks C f :=
    hpdata.1 (Finset.mem_insert_self Q {Q'})
  have hQ'all : Q' ∈ allNonemptyConflictLinks C f :=
    hpdata.1 (Finset.mem_insert_of_mem (Finset.mem_singleton_self Q'))
  obtain ⟨q, hq, hQlink⟩ := mem_allNonemptyConflictLinks.mp hQall
  obtain ⟨q', hq', hQ'link⟩ := mem_allNonemptyConflictLinks.mp hQ'all
  have hQcard : Q.card = q := (mem_conflictLinkLayer.mp hQlink).2
  have hQ'card : Q'.card = q' := (mem_conflictLinkLayer.mp hQ'link).2
  have hnotSub : ¬Q ⊆ Q' :=
    allNonemptyConflictLinks_antichain hanti hQall hQ'all hQQ'
  have hnotSub' : ¬Q' ⊆ Q :=
    allNonemptyConflictLinks_antichain hanti hQ'all hQall hQQ'.symm
  have hq2 : 2 ≤ q := by
    have hq1 : 1 ≤ q := (Finset.mem_Icc.mp hq).1
    by_contra h
    have hqeq : q = 1 := by omega
    obtain ⟨e, hQeq⟩ := Finset.card_eq_one.mp (hQcard.trans hqeq)
    apply hnotSub
    intro g hg
    have hge : g = e := by
      rw [hQeq] at hg
      exact Finset.mem_singleton.mp hg
    subst g
    have hinter := hpdata.2.2
    obtain ⟨R, hRp, R', hR'p, _hne, hnd⟩ := hinter
    have hpairCases : (R = Q ∧ R' = Q') ∨ (R = Q' ∧ R' = Q) := by
      simp only [Finset.mem_insert, Finset.mem_singleton] at hRp hR'p
      rcases hRp with rfl | rfl <;> rcases hR'p with rfl | rfl
      · exact False.elim (_hne rfl)
      · exact Or.inl ⟨rfl, rfl⟩
      · exact Or.inr ⟨rfl, rfl⟩
      · exact False.elim (_hne rfl)
    rcases hpairCases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · obtain ⟨x, hxQ, hxQ'⟩ := Finset.not_disjoint_iff.mp hnd
      rw [hQeq] at hxQ
      simpa [Finset.mem_singleton.mp hxQ] using hxQ'
    · obtain ⟨x, hxQ', hxQ⟩ := Finset.not_disjoint_iff.mp hnd
      rw [hQeq] at hxQ
      simpa [Finset.mem_singleton.mp hxQ] using hxQ'
  have hq'2 : 2 ≤ q' := by
    have hq'1 : 1 ≤ q' := (Finset.mem_Icc.mp hq').1
    by_contra h
    have hq'eq : q' = 1 := by omega
    obtain ⟨e, hQ'eq⟩ := Finset.card_eq_one.mp (hQ'card.trans hq'eq)
    apply hnotSub'
    intro g hg
    have hge : g = e := by
      rw [hQ'eq] at hg
      exact Finset.mem_singleton.mp hg
    subst g
    have hinter := hpdata.2.2
    obtain ⟨R, hRp, R', hR'p, _hne, hnd⟩ := hinter
    have hpairCases : (R = Q ∧ R' = Q') ∨ (R = Q' ∧ R' = Q) := by
      simp only [Finset.mem_insert, Finset.mem_singleton] at hRp hR'p
      rcases hRp with rfl | rfl <;> rcases hR'p with rfl | rfl
      · exact False.elim (_hne rfl)
      · exact Or.inl ⟨rfl, rfl⟩
      · exact Or.inr ⟨rfl, rfl⟩
      · exact False.elim (_hne rfl)
    rcases hpairCases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · obtain ⟨x, hxQ, hxQ'⟩ := Finset.not_disjoint_iff.mp hnd
      rw [hQ'eq] at hxQ'
      simpa [Finset.mem_singleton.mp hxQ'] using hxQ
    · obtain ⟨x, hxQ', hxQ⟩ := Finset.not_disjoint_iff.mp hnd
      rw [hQ'eq] at hxQ'
      simpa [Finset.mem_singleton.mp hxQ'] using hxQ
  have hinterNonempty : (Q ∩ Q').Nonempty := by
    obtain ⟨R, hRp, R', hR'p, _hne, hnd⟩ := hpdata.2.2
    simp only [Finset.mem_insert, Finset.mem_singleton] at hRp hR'p
    rcases hRp with rfl | rfl <;> rcases hR'p with rfl | rfl
    · exact False.elim (_hne rfl)
    · exact Finset.not_disjoint_iff_nonempty_inter.mp hnd
    · rw [Finset.inter_comm]
      exact Finset.not_disjoint_iff_nonempty_inter.mp hnd
    · exact False.elim (_hne rfl)
  have hinterPos : 1 ≤ (Q ∩ Q').card := Finset.card_pos.mpr hinterNonempty
  have hupperQ : q ≤ 3 := (Finset.mem_Icc.mp hq).2
  have hupperQ' : q' ≤ 3 := (Finset.mem_Icc.mp hq').2
  have hcardIdentity := Finset.card_union_add_card_inter Q Q'
  have hlower : 3 ≤ (Q ∪ Q').card := by
    by_contra h
    have hQeqUnion : Q = Q ∪ Q' := by
      apply Finset.eq_of_subset_of_card_le Finset.subset_union_left
      rw [hQcard]
      omega
    have hQ'eqUnion : Q' = Q ∪ Q' := by
      apply Finset.eq_of_subset_of_card_le Finset.subset_union_right
      rw [hQ'card]
      omega
    exact hQQ' (hQeqUnion.trans hQ'eqUnion.symm)
  have hupper : (Q ∪ Q').card ≤ 5 := by omega
  simpa [Finset.biUnion_insert, id_eq] using And.intro hlower hupper

/-! ## Static input estimates for Lemma 6.3(v) -/

/-- Each normalized layer maximum is bounded by the total `(C2)` budget. -/
theorem layerMaxDegree_le_Gamma_mul_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) {r : ℕ} (hr2 : 2 ≤ r) (hr4 : r ≤ 4) :
    (CFMRegularization.layerMaxDegree H C r : ℝ) ≤
      Gamma * Real.rpow d ((r : ℝ) - 1) := by
  have hr : r ∈ Finset.Icc 2 4 := Finset.mem_Icc.mpr ⟨hr2, hr4⟩
  have htermNonneg : ∀ s ∈ Finset.Icc 2 4,
      0 ≤ (CFMRegularization.layerMaxDegree H C s : ℝ) /
        Real.rpow d ((s : ℝ) - 1) := by
    intro s _hs
    exact div_nonneg (Nat.cast_nonneg _)
      (Real.rpow_nonneg hd.le _)
  have hterm :
      (CFMRegularization.layerMaxDegree H C r : ℝ) /
          Real.rpow d ((r : ℝ) - 1) ≤ Gamma :=
    (Finset.single_le_sum htermNonneg hr).trans hB.2.1
  exact (div_le_iff₀ (Real.rpow_pos_of_pos hd _)).mp hterm

theorem regularizedBounded_Gamma_nonneg
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) : 0 ≤ Gamma := by
  have hsum : 0 ≤ ∑ r ∈ Finset.Icc 2 4,
      (CFMRegularization.layerMaxDegree H C r : ℝ) /
        Real.rpow d ((r : ℝ) - 1) := by
    apply Finset.sum_nonneg
    intro r hr
    exact div_nonneg (Nat.cast_nonneg _)
      (Real.rpow_nonneg hd.le _)
  exact hsum.trans hB.2.1

/-- The unrooted `q`-link degree is the `(C2)` layer degree through `f`. -/
theorem card_conflictLinkLayer_le_Gamma_mul_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) {f : Finset V} (hf : f ∈ H)
    {q : ℕ} (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    ((conflictLinkLayer C f q).card : ℝ) ≤
      Gamma * Real.rpow d (q : ℝ) := by
  calc
    ((conflictLinkLayer C f q).card : ℝ) =
        (degree (conflictLayer C (q + 1)) f : ℝ) := by
      exact_mod_cast
        CFMRegularization.card_conflictLinkLayer_eq_degree_layer C f q
    _ ≤ (CFMRegularization.layerMaxDegree H C (q + 1) : ℝ) := by
      exact_mod_cast CFMRegularization.degree_layer_le_layerMaxDegree hf
    _ ≤ Gamma * Real.rpow d (((q + 1 : ℕ) : ℝ) - 1) :=
      layerMaxDegree_le_Gamma_mul_rpow hB hd (by omega) (by omega)
    _ = Gamma * Real.rpow d (q : ℝ) := by
      congr 2
      push_cast
      ring

/-- Reinsert the distinguished edge to compare a rooted link degree with
the corresponding conflict-layer codegree. -/
theorem codegree_conflictLinkLayer_le_insert_root
    (C : ConflictSystem V) (f : Finset V) (q : ℕ)
    (root : Hypergraph V) (hfroot : f ∉ root) :
    codegree (conflictLinkLayer C f q) root ≤
      codegree (conflictLayer C (q + 1)) (insert f root) := by
  let S := (conflictLinkLayer C f q).filter (root ⊆ ·)
  apply Finset.card_le_card_of_injOn (insert f)
  · intro Q hQ
    have hQ' := Finset.mem_filter.mp hQ
    obtain ⟨⟨c, hcC, hfc, hcErase⟩, hQcard⟩ :=
      mem_conflictLinkLayer.mp hQ'.1
    have hcEq : c = insert f Q := by
      calc
        c = insert f (c.erase f) := (Finset.insert_erase hfc).symm
        _ = insert f Q := by rw [hcErase]
    apply Finset.mem_filter.mpr
    refine ⟨mem_conflictLayer.mpr ⟨?_, ?_⟩, ?_⟩
    · rw [← hcEq]
      exact hcC
    · have hfQ : f ∉ Q := by rw [← hcErase]; simp
      simp [hfQ, hQcard]
    · exact Finset.insert_subset_insert f hQ'.2
  · intro Q hQS Q' hQ'S hEq
    have hQlink := (Finset.mem_filter.mp hQS).1
    have hQ'link := (Finset.mem_filter.mp hQ'S).1
    have hfQ : f ∉ Q := by
      obtain ⟨⟨c, _hcC, _hfc, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQlink
      rw [← hcErase]
      simp
    have hfQ' : f ∉ Q' := by
      obtain ⟨⟨c, _hcC, _hfc, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQ'link
      rw [← hcErase]
      simp
    calc
      Q = (insert f Q).erase f := by simp [hfQ]
      _ = (insert f Q').erase f := by rw [hEq]
      _ = Q' := by simp [hfQ']

/-- Sharp positive-root `(C3)` estimate for a single link layer. -/
theorem codegree_conflictLinkLayer_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (f : Finset V) (q : ℕ) (root : Hypergraph V)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hrootPos : 1 ≤ root.card) (hrootLt : root.card < q) :
    (codegree (conflictLinkLayer C f q) root : ℝ) ≤
      Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) := by
  by_cases hfroot : f ∈ root
  · have hzero : codegree (conflictLinkLayer C f q) root = 0 := by
      rw [codegree, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro Q hQ hrootQ
      obtain ⟨⟨c, _hcC, _hfc, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQ
      have hfQ : f ∉ Q := by rw [← hcErase]; simp
      exact hfQ (hrootQ hfroot)
    rw [hzero, Nat.cast_zero]
    exact Real.rpow_nonneg hd.le _
  · have hInsertCard : (insert f root).card = root.card + 1 := by
      rw [Finset.card_insert_of_notMem hfroot]
    calc
      (codegree (conflictLinkLayer C f q) root : ℝ) ≤
          (codegree (conflictLayer C (q + 1)) (insert f root) : ℝ) := by
        exact_mod_cast codegree_conflictLinkLayer_le_insert_root
          C f q root hfroot
      _ ≤ Real.rpow d
          (((q + 1 : ℕ) : ℝ) - ((root.card + 1 : ℕ) : ℝ) - eta) :=
        hB.layer_codegree (by omega) (by omega) (by omega) (by omega)
          (insert f root) hInsertCard
      _ = Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) := by
        congr 1
        push_cast
        ring

/-- Ordered representations of rooted rank-`r` duplicate unions with link
ranks `a,b`.  This family is used only for counting; the public source
coordinate remains the representation-free image family above. -/
def duplicateConflictLinkOrderedPairSlice
    (C : ConflictSystem V) (f : Finset V)
    (a b r : ℕ) (root : Hypergraph V) :
    Finset (Hypergraph V × Hypergraph V) :=
  ((conflictLinkLayer C f a).product (conflictLinkLayer C f b)).filter
    fun p ↦ p.1 ≠ p.2 ∧ ¬Disjoint p.1 p.2 ∧
      (p.1 ∪ p.2).card = r ∧ root ⊆ p.1 ∪ p.2

@[simp] theorem mem_duplicateConflictLinkOrderedPairSlice
    {C : ConflictSystem V} {f : Finset V}
    {a b r : ℕ} {root : Hypergraph V} {p : Hypergraph V × Hypergraph V} :
    p ∈ duplicateConflictLinkOrderedPairSlice C f a b r root ↔
      p.1 ∈ conflictLinkLayer C f a ∧
      p.2 ∈ conflictLinkLayer C f b ∧
      p.1 ≠ p.2 ∧ ¬Disjoint p.1 p.2 ∧
      (p.1 ∪ p.2).card = r ∧ root ⊆ p.1 ∪ p.2 := by
  simp [duplicateConflictLinkOrderedPairSlice, and_assoc]

/-- A rooted duplicate-union layer is covered by the union images of its
four possible ordered link-rank slices. -/
theorem codegree_duplicateConflictLinkUnionLayer_le_orderedPairSlices
    (C : ConflictSystem V) (f : Finset V) (r : ℕ)
    (root : Hypergraph V) :
    codegree (duplicateConflictLinkUnionLayer C f r) root ≤
      ∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
        (duplicateConflictLinkOrderedPairSlice C f a b r root).card := by
  let T : ℕ → ℕ → ConflictSystem V := fun a b ↦
    (duplicateConflictLinkOrderedPairSlice C f a b r root).image
      fun p ↦ p.1 ∪ p.2
  have hsub :
      (duplicateConflictLinkUnionLayer C f r).filter (root ⊆ ·) ⊆
        (Finset.Icc 1 3).biUnion fun a ↦
          (Finset.Icc 1 3).biUnion fun b ↦ T a b := by
    intro U hU
    have hU' := Finset.mem_filter.mp hU
    obtain ⟨p, hp, hpU⟩ :=
      mem_duplicateConflictLinkUnions.mp
        (mem_duplicateConflictLinkUnionLayer.mp hU'.1).1
    obtain ⟨Q, Q', hQQ', hpEq⟩ := Finset.card_eq_two.mp
      (mem_duplicateConflictLinkPairs.mp hp).2.1
    subst p
    have hpdata := mem_duplicateConflictLinkPairs.mp hp
    have hQall : Q ∈ allNonemptyConflictLinks C f :=
      hpdata.1 (Finset.mem_insert_self Q {Q'})
    have hQ'all : Q' ∈ allNonemptyConflictLinks C f :=
      hpdata.1 (Finset.mem_insert_of_mem (Finset.mem_singleton_self Q'))
    obtain ⟨a, ha, hQa⟩ := mem_allNonemptyConflictLinks.mp hQall
    obtain ⟨b, hb, hQ'b⟩ := mem_allNonemptyConflictLinks.mp hQ'all
    have hnd : ¬Disjoint Q Q' := by
      obtain ⟨R, hR, R', hR', hne, hnd⟩ := hpdata.2.2
      simp only [Finset.mem_insert, Finset.mem_singleton] at hR hR'
      rcases hR with rfl | rfl <;> rcases hR' with rfl | rfl
      · exact False.elim (hne rfl)
      · exact hnd
      · intro hd
        exact hnd hd.symm
      · exact False.elim (hne rfl)
    have hUnion : Q ∪ Q' = U := by
      simpa using hpU
    apply Finset.mem_biUnion.mpr
    refine ⟨a, ha, Finset.mem_biUnion.mpr ⟨b, hb, ?_⟩⟩
    apply Finset.mem_image.mpr
    refine ⟨(Q, Q'), ?_, hUnion⟩
    apply mem_duplicateConflictLinkOrderedPairSlice.mpr
    exact ⟨hQa, hQ'b, hQQ', hnd,
      by rw [hUnion]; exact (mem_duplicateConflictLinkUnionLayer.mp hU'.1).2,
      by rw [hUnion]; exact hU'.2⟩
  calc
    codegree (duplicateConflictLinkUnionLayer C f r) root ≤
        (((Finset.Icc 1 3).biUnion fun a ↦
          (Finset.Icc 1 3).biUnion fun b ↦ T a b).card) :=
      Finset.card_le_card hsub
    _ ≤ ∑ a ∈ Finset.Icc 1 3,
          ((Finset.Icc 1 3).biUnion fun b ↦ T a b).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
          (T a b).card := by
      apply Finset.sum_le_sum
      intro a ha
      exact Finset.card_biUnion_le
    _ ≤ ∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
        (duplicateConflictLinkOrderedPairSlice C f a b r root).card := by
      apply Finset.sum_le_sum
      intro a ha
      apply Finset.sum_le_sum
      intro b hb
      exact Finset.card_image_le

/-- Exact root partition used in the proof of Lemma 6.3(v):
`E₁ = root ∩ Q₁`, `I = Q₁ ∩ Q₂`, and the remaining root members lie in
`Q₂`.  The displayed sum is ready for the `(C2)/(C3)` estimates above. -/
theorem card_duplicateConflictLinkOrderedPairSlice_le_rootPartitionSum
    (C : ConflictSystem V) (f : Finset V)
    (a b r : ℕ) (root : Hypergraph V) :
    (duplicateConflictLinkOrderedPairSlice C f a b r root).card ≤
      ∑ E₁ ∈ root.powerset,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ Q₁.powersetCard (a + b - r),
            codegree (conflictLinkLayer C f b) (I ∪ (root \ E₁)) := by
  let Cover : Finset (Hypergraph V × Hypergraph V) :=
    root.powerset.biUnion fun E₁ ↦
      ((conflictLinkLayer C f a).filter (root ∩ · = E₁)).biUnion fun Q₁ ↦
        (Q₁.powersetCard (a + b - r)).biUnion fun I ↦
          ((conflictLinkLayer C f b).filter
            (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)
  have hsub : duplicateConflictLinkOrderedPairSlice C f a b r root ⊆
      Cover := by
    intro p hp
    have hp' := mem_duplicateConflictLinkOrderedPairSlice.mp hp
    let E₁ := root ∩ p.1
    let I := p.1 ∩ p.2
    have hE₁ : E₁ ∈ root.powerset :=
      Finset.mem_powerset.mpr Finset.inter_subset_left
    have hp1card : p.1.card = a :=
      (mem_conflictLinkLayer.mp hp'.1).2
    have hp2card : p.2.card = b :=
      (mem_conflictLinkLayer.mp hp'.2.1).2
    have hcardIdentity := Finset.card_union_add_card_inter p.1 p.2
    have hIcard : I.card = a + b - r := by
      dsimp [I]
      omega
    have hI : I ∈ p.1.powersetCard (a + b - r) :=
      Finset.mem_powersetCard.mpr ⟨Finset.inter_subset_left, hIcard⟩
    have hremaining : root \ E₁ ⊆ p.2 := by
      intro e he
      have he' := Finset.mem_sdiff.mp he
      rcases Finset.mem_union.mp (hp'.2.2.2.2.2 he'.1) with hep1 | hep2
      · exact False.elim (he'.2 (Finset.mem_inter.mpr ⟨he'.1, hep1⟩))
      · exact hep2
    have hroot2 : I ∪ (root \ E₁) ⊆ p.2 :=
      Finset.union_subset Finset.inter_subset_right hremaining
    apply Finset.mem_biUnion.mpr
    refine ⟨E₁, hE₁, Finset.mem_biUnion.mpr ⟨p.1, ?_, ?_⟩⟩
    · exact Finset.mem_filter.mpr ⟨hp'.1, rfl⟩
    · apply Finset.mem_biUnion.mpr
      refine ⟨I, hI, Finset.mem_image.mpr ⟨p.2, ?_, rfl⟩⟩
      exact Finset.mem_filter.mpr ⟨hp'.2.1, hroot2⟩
  calc
    (duplicateConflictLinkOrderedPairSlice C f a b r root).card ≤
        Cover.card := Finset.card_le_card hsub
    _ ≤ ∑ E₁ ∈ root.powerset,
        (((conflictLinkLayer C f a).filter (root ∩ · = E₁)).biUnion fun Q₁ ↦
          (Q₁.powersetCard (a + b - r)).biUnion fun I ↦
            ((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      exact Finset.card_biUnion_le
    _ ≤ ∑ E₁ ∈ root.powerset,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ((Q₁.powersetCard (a + b - r)).biUnion fun I ↦
            ((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro E₁ hE₁
      exact Finset.card_biUnion_le
    _ ≤ ∑ E₁ ∈ root.powerset,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ Q₁.powersetCard (a + b - r),
            (((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro E₁ hE₁
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      exact Finset.card_biUnion_le
    _ ≤ ∑ E₁ ∈ root.powerset,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ Q₁.powersetCard (a + b - r),
            ((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).card := by
      apply Finset.sum_le_sum
      intro E₁ hE₁
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      apply Finset.sum_le_sum
      intro I hI
      exact Finset.card_image_le
    _ = ∑ E₁ ∈ root.powerset,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ Q₁.powersetCard (a + b - r),
            codegree (conflictLinkLayer C f b) (I ∪ (root \ E₁)) := by
      rfl

/-! ### Scalar ingredients for the source spread estimate -/

/-- A root of the full uniform rank determines at most one member. -/
theorem codegree_le_one_of_uniform_of_card_eq
    {X : ConflictSystem V} {q : ℕ} (hX : IsUniform X q)
    (root : Hypergraph V) (hroot : root.card = q) :
    codegree X root ≤ 1 := by
  rw [codegree]
  apply Finset.card_le_one.mpr
  intro Q hQ R hR
  have hQ' := Finset.mem_filter.mp hQ
  have hR' := Finset.mem_filter.mp hR
  have hrootQ : root = Q :=
    Finset.eq_of_subset_of_card_le hQ'.2 (by rw [hX Q hQ'.1, hroot])
  have hrootR : root = R :=
    Finset.eq_of_subset_of_card_le hR'.2 (by rw [hX R hR'.1, hroot])
  exact hrootQ.symm.trans hrootR

/-- The sharp positive-root estimate with the `eta` saving erased.  The
full-rank boundary is handled by uniformity rather than `(C3)`. -/
theorem codegree_conflictLinkLayer_le_rpow_weak
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (q : ℕ) (root : Hypergraph V)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hrootPos : 1 ≤ root.card) (hrootLe : root.card ≤ q) :
    (codegree (conflictLinkLayer C f q) root : ℝ) ≤
      Real.rpow d ((q : ℝ) - (root.card : ℝ)) := by
  rcases Nat.lt_or_eq_of_le hrootLe with hrootLt | hrootEq
  · have hsharp := codegree_conflictLinkLayer_le_rpow
      hB hd f q root hq1 hq3 hrootPos hrootLt
    exact hsharp.trans (Real.rpow_le_rpow_of_exponent_le hd1
      (by linarith :
        (q : ℝ) - (root.card : ℝ) - eta ≤
          (q : ℝ) - (root.card : ℝ)))
  · have hcard : root.card = q := hrootEq
    have hone : (codegree (conflictLinkLayer C f q) root : ℝ) ≤ 1 := by
      exact_mod_cast codegree_le_one_of_uniform_of_card_eq
        (conflictLinkLayer_uniform C f q) root hcard
    simpa [hcard] using hone

/-- The weak estimate remains valid above the uniform rank because the
rooted degree then vanishes. -/
theorem codegree_conflictLinkLayer_le_rpow_weak_all
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (q : ℕ) (root : Hypergraph V)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3) (hrootPos : 1 ≤ root.card) :
    (codegree (conflictLinkLayer C f q) root : ℝ) ≤
      Real.rpow d ((q : ℝ) - (root.card : ℝ)) := by
  by_cases hrootLe : root.card ≤ q
  · exact codegree_conflictLinkLayer_le_rpow_weak hB hd hd1 heta
      f q root hq1 hq3 hrootPos hrootLe
  · have hzero : codegree (conflictLinkLayer C f q) root = 0 :=
      codegree_eq_zero_of_uniform_of_card_lt
        (conflictLinkLayer_uniform C f q) (by omega)
    rw [hzero, Nat.cast_zero]
    exact Real.rpow_nonneg hd.le _

/-- Members whose intersection with `root` is exactly `E` are counted by
the ordinary `E`-codegree. -/
theorem card_conflictLinkLayer_filter_inter_eq_le_codegree
    (C : ConflictSystem V) (f : Finset V) (q : ℕ)
    (root E : Hypergraph V) :
    ((conflictLinkLayer C f q).filter (root ∩ · = E)).card ≤
      codegree (conflictLinkLayer C f q) E := by
  apply Finset.card_le_card
  intro Q hQ
  have hQ' := Finset.mem_filter.mp hQ
  apply Finset.mem_filter.mpr
  refine ⟨hQ'.1, ?_⟩
  rw [← hQ'.2]
  exact Finset.inter_subset_right

/-- Cardinality of the second root in the exact partition. -/
theorem card_union_sdiff_of_inter_eq
    (root E Q I : Hypergraph V) (hE : root ∩ Q = E) (hIQ : I ⊆ Q) :
    (I ∪ (root \ E)).card = I.card + root.card - E.card := by
  have hEroot : E ⊆ root := by
    rw [← hE]
    exact Finset.inter_subset_left
  have hdisj : Disjoint I (root \ E) := by
    rw [Finset.disjoint_left]
    intro x hxI hxDiff
    have hxQ := hIQ hxI
    have hxRoot := (Finset.mem_sdiff.mp hxDiff).1
    have hxE : x ∈ E := by
      rw [← hE]
      exact Finset.mem_inter.mpr ⟨hxRoot, hxQ⟩
    exact (Finset.mem_sdiff.mp hxDiff).2 hxE
  rw [Finset.card_union_of_disjoint hdisj,
    Finset.card_sdiff_of_subset hEroot]
  have := Finset.card_le_card hEroot
  omega

theorem card_filtered_powersetCard_le_eight
    (Q : Hypergraph V) (k : ℕ) (hQ : Q.card ≤ 3)
    (P : Hypergraph V → Prop) [DecidablePred P] :
    ((Q.powersetCard k).filter P).card ≤ 8 := by
  calc
    ((Q.powersetCard k).filter P).card ≤ Q.powerset.card := by
      apply Finset.card_le_card
      intro I hI
      exact Finset.mem_powerset.mpr
        (Finset.mem_powersetCard.mp (Finset.mem_filter.mp hI).1).1
    _ = 2 ^ Q.card := Finset.card_powerset Q
    _ ≤ 8 := by interval_cases Q.card <;> norm_num

theorem card_nonempty_powerset_le_sixteen
    (root : Hypergraph V) (hroot : root.card ≤ 4) :
    (root.powerset.filter Finset.Nonempty).card ≤ 16 := by
  calc
    (root.powerset.filter Finset.Nonempty).card ≤ root.powerset.card :=
      Finset.card_filter_le _ _
    _ = 2 ^ root.card := Finset.card_powerset root
    _ ≤ 16 := by interval_cases root.card <;> norm_num

/-- The exponent identity at the heart of Lemma 6.3(v).  One of the two
positive link roots is proper and supplies `(C3)`'s single `eta` saving;
the other uses the weakened rooted estimate. -/
theorem mul_codegrees_conflictLinkLayer_le_partition_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (a b r t : ℕ) (E S : Hypergraph V)
    (ha1 : 1 ≤ a) (ha3 : a ≤ 3) (hb1 : 1 ≤ b) (hb3 : b ≤ 3)
    (hEpos : 1 ≤ E.card) (hEle : E.card ≤ a)
    (hSpos : 1 ≤ S.card) (hrootLt : t < r)
    (hbalance : E.card + S.card + r = a + b + t) :
    (codegree (conflictLinkLayer C f a) E : ℝ) *
        (codegree (conflictLinkLayer C f b) S : ℝ) ≤
      Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
  have hbalanceR :
      (E.card : ℝ) + (S.card : ℝ) + (r : ℝ) =
        (a : ℝ) + (b : ℝ) + (t : ℝ) := by
    exact_mod_cast hbalance
  rcases Nat.lt_or_eq_of_le hEle with hElt | hEeq
  · have hA := codegree_conflictLinkLayer_le_rpow
      hB hd f a E ha1 ha3 hEpos hElt
    have hBweak := codegree_conflictLinkLayer_le_rpow_weak_all
      hB hd hd1 heta f b S hb1 hb3 hSpos
    calc
      (codegree (conflictLinkLayer C f a) E : ℝ) *
          (codegree (conflictLinkLayer C f b) S : ℝ) ≤
          Real.rpow d ((a : ℝ) - (E.card : ℝ) - eta) *
            Real.rpow d ((b : ℝ) - (S.card : ℝ)) := by
        exact mul_le_mul hA hBweak (Nat.cast_nonneg _)
          (Real.rpow_nonneg hd.le _)
      _ = Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
        calc
          Real.rpow d ((a : ℝ) - (E.card : ℝ) - eta) *
              Real.rpow d ((b : ℝ) - (S.card : ℝ)) =
              Real.rpow d (((a : ℝ) - (E.card : ℝ) - eta) +
                ((b : ℝ) - (S.card : ℝ))) :=
            (Real.rpow_add hd _ _).symm
          _ = Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
            congr 1
            linarith
  · have hAone :
        (codegree (conflictLinkLayer C f a) E : ℝ) ≤ 1 := by
      exact_mod_cast codegree_le_one_of_uniform_of_card_eq
        (conflictLinkLayer_uniform C f a) E hEeq
    have hSlt : S.card < b := by omega
    have hBsharp := codegree_conflictLinkLayer_le_rpow
      hB hd f b S hb1 hb3 hSpos hSlt
    calc
      (codegree (conflictLinkLayer C f a) E : ℝ) *
          (codegree (conflictLinkLayer C f b) S : ℝ) ≤
          1 * Real.rpow d ((b : ℝ) - (S.card : ℝ) - eta) := by
        exact mul_le_mul hAone hBsharp (Nat.cast_nonneg _) (by norm_num)
      _ = Real.rpow d ((r : ℝ) - (t : ℝ) - eta) := by
        rw [one_mul]
        congr 1
        have hEeqR : (E.card : ℝ) = (a : ℝ) := by
          exact_mod_cast hEeq
        linarith

/-- Distinct members of the fixed-edge link inherit strict
incomparability from the conflict antichain. -/
theorem card_inter_lt_left_of_distinct_conflictLinks
    {C : ConflictSystem V} {f : Finset V}
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    {Q Q' : Hypergraph V}
    (hQ : Q ∈ allNonemptyConflictLinks C f)
    (hQ' : Q' ∈ allNonemptyConflictLinks C f) (hne : Q ≠ Q') :
    (Q ∩ Q').card < Q.card := by
  have hle : (Q ∩ Q').card ≤ Q.card :=
    Finset.card_le_card Finset.inter_subset_left
  by_contra hnot
  have hcard : (Q ∩ Q').card = Q.card := by omega
  have heq : Q ∩ Q' = Q :=
    Finset.eq_of_subset_of_card_le Finset.inter_subset_left (by omega)
  apply allNonemptyConflictLinks_antichain hanti hQ hQ' hne
  intro x hxQ
  have hxInter : x ∈ Q ∩ Q' := by rw [heq]; exact hxQ
  exact Finset.inter_subset_right hxInter

/-- The ordered slice restricted to orientations in which the first link
meets the prescribed root. -/
def duplicateConflictLinkOrderedPairFirstRooted
    (C : ConflictSystem V) (f : Finset V)
    (a b r : ℕ) (root : Hypergraph V) :
    Finset (Hypergraph V × Hypergraph V) :=
  (duplicateConflictLinkOrderedPairSlice C f a b r root).filter
    fun p ↦ (root ∩ p.1).Nonempty

@[simp] theorem mem_duplicateConflictLinkOrderedPairFirstRooted
    {C : ConflictSystem V} {f : Finset V}
    {a b r : ℕ} {root : Hypergraph V}
    {p : Hypergraph V × Hypergraph V} :
    p ∈ duplicateConflictLinkOrderedPairFirstRooted C f a b r root ↔
      p ∈ duplicateConflictLinkOrderedPairSlice C f a b r root ∧
        (root ∩ p.1).Nonempty := by
  simp [duplicateConflictLinkOrderedPairFirstRooted]

/-- For a nonempty root, one of the two orientations has a first link
meeting the root. -/
theorem card_duplicateConflictLinkOrderedPairSlice_le_firstRooted_add_swap
    (C : ConflictSystem V) (f : Finset V)
    (a b r : ℕ) (root : Hypergraph V) (hroot : root.Nonempty) :
    (duplicateConflictLinkOrderedPairSlice C f a b r root).card ≤
      (duplicateConflictLinkOrderedPairFirstRooted C f a b r root).card +
        (duplicateConflictLinkOrderedPairFirstRooted C f b a r root).card := by
  let P := duplicateConflictLinkOrderedPairSlice C f a b r root
  let meets : Hypergraph V × Hypergraph V → Prop :=
    fun p ↦ (root ∩ p.1).Nonempty
  have hbad : (P.filter fun p ↦ ¬meets p).card ≤
      (duplicateConflictLinkOrderedPairFirstRooted C f b a r root).card := by
    apply Finset.card_le_card_of_injOn (fun p ↦ (p.2, p.1))
    · intro p hp
      have hp' := Finset.mem_filter.mp hp
      have hpP := mem_duplicateConflictLinkOrderedPairSlice.mp
        (by simpa only [P] using hp'.1)
      apply mem_duplicateConflictLinkOrderedPairFirstRooted.mpr
      refine ⟨mem_duplicateConflictLinkOrderedPairSlice.mpr
        ⟨hpP.2.1, hpP.1, hpP.2.2.1.symm, ?_, ?_, ?_⟩, ?_⟩
      · intro hd
        exact hpP.2.2.2.1 hd.symm
      · simpa [Finset.union_comm] using hpP.2.2.2.2.1
      · simpa [Finset.union_comm] using hpP.2.2.2.2.2
      · obtain ⟨x, hxroot⟩ := hroot
        have hxunion := hpP.2.2.2.2.2 hxroot
        rcases Finset.mem_union.mp hxunion with hxp1 | hxp2
        · exact False.elim (hp'.2 ⟨x,
            Finset.mem_inter.mpr ⟨hxroot, hxp1⟩⟩)
        · exact ⟨x, Finset.mem_inter.mpr ⟨hxroot, hxp2⟩⟩
    · intro p hp q hq hEq
      exact Prod.ext (congrArg Prod.snd hEq) (congrArg Prod.fst hEq)
  have hpartition := P.card_filter_add_card_filter_not meets
  calc
    P.card = (P.filter meets).card + (P.filter fun p ↦ ¬meets p).card :=
      hpartition.symm
    _ ≤ (P.filter meets).card +
        (duplicateConflictLinkOrderedPairFirstRooted C f b a r root).card :=
      Nat.add_le_add_left hbad _
    _ = (duplicateConflictLinkOrderedPairFirstRooted C f a b r root).card +
        (duplicateConflictLinkOrderedPairFirstRooted C f b a r root).card := by
      rfl

/-- Refined root partition for the useful orientation.  The intersection
root `I` is nonempty and is proper in both links; the latter is exactly
where the conflict antichain enters Lemma 6.3(v). -/
theorem card_duplicateConflictLinkOrderedPairFirstRooted_le_partitionSum
    (C : ConflictSystem V) (f : Finset V)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (a b r : ℕ) (root : Hypergraph V)
    (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3) :
    (duplicateConflictLinkOrderedPairFirstRooted C f a b r root).card ≤
      ∑ E₁ ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
            codegree (conflictLinkLayer C f b) (I ∪ (root \ E₁)) := by
  let Cover : Finset (Hypergraph V × Hypergraph V) :=
    (root.powerset.filter Finset.Nonempty).biUnion fun E₁ ↦
      ((conflictLinkLayer C f a).filter (root ∩ · = E₁)).biUnion fun Q₁ ↦
        ((Q₁.powersetCard (a + b - r)).filter
          (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)).biUnion fun I ↦
            ((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)
  have hsub :
      duplicateConflictLinkOrderedPairFirstRooted C f a b r root ⊆
        Cover := by
    intro p hp
    have hp' := mem_duplicateConflictLinkOrderedPairFirstRooted.mp hp
    have hpdata := mem_duplicateConflictLinkOrderedPairSlice.mp hp'.1
    let E₁ := root ∩ p.1
    let I := p.1 ∩ p.2
    have hE₁ : E₁ ∈ root.powerset.filter Finset.Nonempty := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_powerset.mpr Finset.inter_subset_left, hp'.2⟩
    have hp1card : p.1.card = a :=
      (mem_conflictLinkLayer.mp hpdata.1).2
    have hp2card : p.2.card = b :=
      (mem_conflictLinkLayer.mp hpdata.2.1).2
    have hcardIdentity := Finset.card_union_add_card_inter p.1 p.2
    have hIcard : I.card = a + b - r := by
      dsimp [I]
      omega
    have hQall : p.1 ∈ allNonemptyConflictLinks C f :=
      mem_allNonemptyConflictLinks.mpr ⟨a, ha, hpdata.1⟩
    have hQ'all : p.2 ∈ allNonemptyConflictLinks C f :=
      mem_allNonemptyConflictLinks.mpr ⟨b, hb, hpdata.2.1⟩
    have hIpos : I.Nonempty := by
      exact Finset.not_disjoint_iff_nonempty_inter.mp hpdata.2.2.2.1
    have hIltA : I.card < a := by
      rw [← hp1card]
      exact card_inter_lt_left_of_distinct_conflictLinks
        hanti hQall hQ'all hpdata.2.2.1
    have hIltB : I.card < b := by
      rw [← hp2card]
      simpa [I, Finset.inter_comm] using
        (card_inter_lt_left_of_distinct_conflictLinks
          hanti hQ'all hQall hpdata.2.2.1.symm)
    have hI : I ∈ (p.1.powersetCard (a + b - r)).filter
        (fun J ↦ J.Nonempty ∧ J.card < a ∧ J.card < b) := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_powersetCard.mpr
        ⟨Finset.inter_subset_left, hIcard⟩, hIpos, hIltA, hIltB⟩
    have hremaining : root \ E₁ ⊆ p.2 := by
      intro e he
      have he' := Finset.mem_sdiff.mp he
      rcases Finset.mem_union.mp (hpdata.2.2.2.2.2 he'.1) with hep1 | hep2
      · exact False.elim (he'.2 (Finset.mem_inter.mpr ⟨he'.1, hep1⟩))
      · exact hep2
    have hroot2 : I ∪ (root \ E₁) ⊆ p.2 :=
      Finset.union_subset Finset.inter_subset_right hremaining
    apply Finset.mem_biUnion.mpr
    refine ⟨E₁, hE₁, Finset.mem_biUnion.mpr ⟨p.1, ?_, ?_⟩⟩
    · exact Finset.mem_filter.mpr ⟨hpdata.1, rfl⟩
    · apply Finset.mem_biUnion.mpr
      refine ⟨I, hI, Finset.mem_image.mpr ⟨p.2, ?_, rfl⟩⟩
      exact Finset.mem_filter.mpr ⟨hpdata.2.1, hroot2⟩
  calc
    (duplicateConflictLinkOrderedPairFirstRooted C f a b r root).card ≤
        Cover.card := Finset.card_le_card hsub
    _ ≤ ∑ E₁ ∈ root.powerset.filter Finset.Nonempty,
        (((conflictLinkLayer C f a).filter (root ∩ · = E₁)).biUnion fun Q₁ ↦
          ((Q₁.powersetCard (a + b - r)).filter
            (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)).biUnion fun I ↦
              ((conflictLinkLayer C f b).filter
                (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ E₁ ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          (((Q₁.powersetCard (a + b - r)).filter
            (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)).biUnion fun I ↦
              ((conflictLinkLayer C f b).filter
                (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro E₁ hE₁
      exact Finset.card_biUnion_le
    _ ≤ ∑ E₁ ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
            (((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).image fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro E₁ hE₁
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      exact Finset.card_biUnion_le
    _ ≤ ∑ E₁ ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
            ((conflictLinkLayer C f b).filter
              (I ∪ (root \ E₁) ⊆ ·)).card := by
      apply Finset.sum_le_sum
      intro E₁ hE₁
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      apply Finset.sum_le_sum
      intro I hI
      exact Finset.card_image_le
    _ = ∑ E₁ ∈ root.powerset.filter Finset.Nonempty,
        ∑ Q₁ ∈ (conflictLinkLayer C f a).filter (root ∩ · = E₁),
          ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
            codegree (conflictLinkLayer C f b) (I ∪ (root \ E₁)) := by
      rfl

/-- One useful orientation has at most `16 * 8 = 128`
representations at the sharp rooted scale. -/
theorem card_duplicateConflictLinkOrderedPairFirstRooted_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (a b r : ℕ) (root : Hypergraph V)
    (ha2 : 2 ≤ a) (ha3 : a ≤ 3) (hb2 : 2 ≤ b) (hb3 : b ≤ 3)
    (hr5 : r ≤ 5) (hrootPos : 1 ≤ root.card)
    (hrootLt : root.card < r) :
    ((duplicateConflictLinkOrderedPairFirstRooted
        C f a b r root).card : ℝ) ≤
      128 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  have ha : a ∈ Finset.Icc 1 3 := Finset.mem_Icc.mpr ⟨by omega, ha3⟩
  have hb : b ∈ Finset.Icc 1 3 := Finset.mem_Icc.mpr ⟨by omega, hb3⟩
  have hcover :=
    card_duplicateConflictLinkOrderedPairFirstRooted_le_partitionSum
      C f hanti a b r root ha hb
  let EF : Finset (Hypergraph V) :=
    root.powerset.filter Finset.Nonempty
  let QF : Hypergraph V → ConflictSystem V := fun E ↦
    (conflictLinkLayer C f a).filter (root ∩ · = E)
  let IF : Hypergraph V → Finset (Hypergraph V) := fun Q ↦
    (Q.powersetCard (a + b - r)).filter
      (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)
  let target : ℝ :=
    Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta)
  have hEterm : ∀ E ∈ EF,
      (∑ Q ∈ QF E, ∑ I ∈ IF Q,
        (codegree (conflictLinkLayer C f b)
          (I ∪ (root \ E)) : ℝ)) ≤ 8 * target := by
    intro E hEEF
    have hEdata := Finset.mem_filter.mp (by simpa only [EF] using hEEF)
    have hEsub : E ⊆ root := Finset.mem_powerset.mp hEdata.1
    have hEpos : 1 ≤ E.card := Finset.card_pos.mpr hEdata.2
    by_cases hQempty : QF E = ∅
    · rw [hQempty]
      simp only [Finset.sum_empty, zero_le]
      exact mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)
    · obtain ⟨Q₀, hQ₀⟩ := Finset.nonempty_iff_ne_empty.mpr hQempty
      have hQ₀data := Finset.mem_filter.mp
        (by simpa only [QF] using hQ₀)
      have hQ₀card : Q₀.card = a :=
        (mem_conflictLinkLayer.mp hQ₀data.1).2
      have hEQ₀ : E ⊆ Q₀ := by
        rw [← hQ₀data.2]
        exact Finset.inter_subset_right
      have hEle : E.card ≤ a := by
        rw [← hQ₀card]
        exact Finset.card_le_card hEQ₀
      rcases Nat.lt_or_eq_of_le hEle with hElt | hEeq
      · let scaleA : ℝ :=
          Real.rpow d ((a : ℝ) - (E.card : ℝ) - eta)
        let s : ℕ := a + b - r + root.card - E.card
        let scaleB : ℝ := Real.rpow d ((b : ℝ) - (s : ℝ))
        have hA : ((QF E).card : ℝ) ≤ scaleA := by
          calc
            ((QF E).card : ℝ) ≤
                (codegree (conflictLinkLayer C f a) E : ℝ) := by
              exact_mod_cast
                card_conflictLinkLayer_filter_inter_eq_le_codegree
                  C f a root E
            _ ≤ scaleA := by
              simpa only [scaleA] using
                codegree_conflictLinkLayer_le_rpow hB hd f a E
                  (by omega) ha3 hEpos hElt
        have hInner : ∀ Q ∈ QF E,
            (∑ I ∈ IF Q, (codegree (conflictLinkLayer C f b)
              (I ∪ (root \ E)) : ℝ)) ≤ 8 * scaleB := by
          intro Q hQQF
          have hQdata := Finset.mem_filter.mp
            (by simpa only [QF] using hQQF)
          have hQcard : Q.card = a :=
            (mem_conflictLinkLayer.mp hQdata.1).2
          have hIFcard : (IF Q).card ≤ 8 := by
            simpa only [IF] using card_filtered_powersetCard_le_eight
              Q (a + b - r) (by
                rw [hQcard]
                exact (Finset.mem_Icc.mp ha).2)
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)
          calc
            (∑ I ∈ IF Q, (codegree (conflictLinkLayer C f b)
                (I ∪ (root \ E)) : ℝ)) ≤
                ∑ _I ∈ IF Q, scaleB := by
              apply Finset.sum_le_sum
              intro I hIIF
              have hIdata := Finset.mem_filter.mp
                (by simpa only [IF] using hIIF)
              have hIcard : I.card = a + b - r :=
                (Finset.mem_powersetCard.mp hIdata.1).2
              have hIQ : I ⊆ Q :=
                (Finset.mem_powersetCard.mp hIdata.1).1
              have hScard : (I ∪ (root \ E)).card = s := by
                have hcard := card_union_sdiff_of_inter_eq
                  root E Q I hQdata.2 hIQ
                dsimp [s]
                omega
              have hSpos : 1 ≤ (I ∪ (root \ E)).card := by
                exact le_trans (Finset.card_pos.mpr hIdata.2.1)
                  (Finset.card_le_card Finset.subset_union_left)
              simpa only [scaleB, hScard] using
                codegree_conflictLinkLayer_le_rpow_weak_all
                  hB hd hd1 heta f b (I ∪ (root \ E))
                    (by omega) hb3 hSpos
            _ = ((IF Q).card : ℝ) * scaleB := by simp
            _ ≤ 8 * scaleB :=
              mul_le_mul_of_nonneg_right (by exact_mod_cast hIFcard)
                (Real.rpow_nonneg hd.le _)
        have hsumQ :
            (∑ Q ∈ QF E, ∑ I ∈ IF Q,
              (codegree (conflictLinkLayer C f b)
                (I ∪ (root \ E)) : ℝ)) ≤
              ((QF E).card : ℝ) * (8 * scaleB) := by
          calc
            (∑ Q ∈ QF E, ∑ I ∈ IF Q,
                (codegree (conflictLinkLayer C f b)
                  (I ∪ (root \ E)) : ℝ)) ≤
                ∑ _Q ∈ QF E, 8 * scaleB := by
              apply Finset.sum_le_sum
              intro Q hQ
              exact hInner Q hQ
            _ = ((QF E).card : ℝ) * (8 * scaleB) := by simp
        have hscale : scaleA * scaleB ≤ target := by
          dsimp [scaleA, scaleB, target, s]
          have hErootCard : E.card ≤ root.card :=
            Finset.card_le_card hEsub
          have hEtotal : E.card ≤ a + b - r + root.card := by omega
          have hsR :
              ((a + b - r + root.card - E.card : ℕ) : ℝ) =
                ((a + b - r : ℕ) : ℝ) + (root.card : ℝ) -
                  (E.card : ℝ) := by
            rw [Nat.cast_sub hEtotal]
            push_cast
            rfl
          have hexp :
              (a : ℝ) - (E.card : ℝ) - eta +
                  ((b : ℝ) -
                    ((a + b - r + root.card - E.card : ℕ) : ℝ)) ≤
                (r : ℝ) - (root.card : ℝ) - eta := by
            rw [hsR]
            by_cases hri : r ≤ a + b
            · rw [Nat.cast_sub hri]
              push_cast
              linarith
            · have hz : a + b - r = 0 := Nat.sub_eq_zero_of_le (by omega)
              rw [hz]
              norm_num only [Nat.cast_zero, zero_add]
              have habR : (a : ℝ) + (b : ℝ) ≤ (r : ℝ) := by
                exact_mod_cast (show a + b ≤ r by omega)
              linarith
          calc
            Real.rpow d ((a : ℝ) - (E.card : ℝ) - eta) *
                Real.rpow d
                  ((b : ℝ) - ((a + b - r + root.card - E.card : ℕ) : ℝ)) =
                Real.rpow d (((a : ℝ) - (E.card : ℝ) - eta) +
                  ((b : ℝ) -
                    ((a + b - r + root.card - E.card : ℕ) : ℝ))) :=
              (Real.rpow_add hd _ _).symm
            _ ≤ Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) :=
              Real.rpow_le_rpow_of_exponent_le hd1 hexp
        calc
          (∑ Q ∈ QF E, ∑ I ∈ IF Q,
              (codegree (conflictLinkLayer C f b)
                (I ∪ (root \ E)) : ℝ)) ≤
              ((QF E).card : ℝ) * (8 * scaleB) := hsumQ
          _ ≤ scaleA * (8 * scaleB) :=
            mul_le_mul_of_nonneg_right hA
              (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
          _ = 8 * (scaleA * scaleB) := by ring
          _ ≤ 8 * target := by nlinarith
      · let scaleB : ℝ :=
          Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta)
        have hA : (QF E).card ≤ 1 := by
          calc
            (QF E).card ≤ codegree (conflictLinkLayer C f a) E :=
              card_conflictLinkLayer_filter_inter_eq_le_codegree
                C f a root E
            _ ≤ 1 := codegree_le_one_of_uniform_of_card_eq
              (conflictLinkLayer_uniform C f a) E hEeq
        have hInner : ∀ Q ∈ QF E,
            (∑ I ∈ IF Q, (codegree (conflictLinkLayer C f b)
              (I ∪ (root \ E)) : ℝ)) ≤ 8 * scaleB := by
          intro Q hQQF
          have hQdata := Finset.mem_filter.mp
            (by simpa only [QF] using hQQF)
          have hQcard : Q.card = a :=
            (mem_conflictLinkLayer.mp hQdata.1).2
          have hIFcard : (IF Q).card ≤ 8 := by
            simpa only [IF] using card_filtered_powersetCard_le_eight
              Q (a + b - r) (by
                rw [hQcard]
                exact (Finset.mem_Icc.mp ha).2)
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)
          calc
            (∑ I ∈ IF Q, (codegree (conflictLinkLayer C f b)
                (I ∪ (root \ E)) : ℝ)) ≤
                ∑ _I ∈ IF Q, scaleB := by
              apply Finset.sum_le_sum
              intro I hIIF
              have hIdata := Finset.mem_filter.mp
                (by simpa only [IF] using hIIF)
              have hIcard : I.card = a + b - r :=
                (Finset.mem_powersetCard.mp hIdata.1).2
              have hIpos : 1 ≤ I.card := Finset.card_pos.mpr hIdata.2.1
              have hIQ : I ⊆ Q :=
                (Finset.mem_powersetCard.mp hIdata.1).1
              have hScard := card_union_sdiff_of_inter_eq
                root E Q I hQdata.2 hIQ
              have hSpos : 1 ≤ (I ∪ (root \ E)).card :=
                le_trans (Finset.card_pos.mpr hIdata.2.1)
                  (Finset.card_le_card Finset.subset_union_left)
              have hri : r ≤ a + b := by omega
              have hbalance :
                  E.card + (I ∪ (root \ E)).card + r =
                    a + b + root.card := by omega
              have hSlt : (I ∪ (root \ E)).card < b := by omega
              have hsharp := codegree_conflictLinkLayer_le_rpow
                hB hd f b (I ∪ (root \ E)) (by omega) hb3 hSpos hSlt
              have hbalanceR :
                  (E.card : ℝ) + ((I ∪ (root \ E)).card : ℝ) + (r : ℝ) =
                    (a : ℝ) + (b : ℝ) + (root.card : ℝ) := by
                exact_mod_cast hbalance
              have hEeqR : (E.card : ℝ) = (a : ℝ) := by
                exact_mod_cast hEeq
              calc
                (codegree (conflictLinkLayer C f b)
                    (I ∪ (root \ E)) : ℝ) ≤
                    Real.rpow d ((b : ℝ) -
                      ((I ∪ (root \ E)).card : ℝ) - eta) := hsharp
                _ = scaleB := by
                  dsimp [scaleB]
                  congr 1
                  linarith
            _ = ((IF Q).card : ℝ) * scaleB := by simp
            _ ≤ 8 * scaleB :=
              mul_le_mul_of_nonneg_right (by exact_mod_cast hIFcard)
                (Real.rpow_nonneg hd.le _)
        calc
          (∑ Q ∈ QF E, ∑ I ∈ IF Q,
              (codegree (conflictLinkLayer C f b)
                (I ∪ (root \ E)) : ℝ)) ≤
              ∑ _Q ∈ QF E, 8 * scaleB := by
            apply Finset.sum_le_sum
            intro Q hQ
            exact hInner Q hQ
          _ = ((QF E).card : ℝ) * (8 * scaleB) := by simp
          _ ≤ 1 * (8 * scaleB) := by
            exact mul_le_mul_of_nonneg_right (by exact_mod_cast hA)
              (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
          _ = 8 * target := by simp [scaleB, target]
  have hEFcard : EF.card ≤ 16 := by
    simpa only [EF] using card_nonempty_powerset_le_sixteen root (by omega)
  calc
    ((duplicateConflictLinkOrderedPairFirstRooted
        C f a b r root).card : ℝ) ≤
        (∑ E ∈ EF, ∑ Q ∈ QF E, ∑ I ∈ IF Q,
          codegree (conflictLinkLayer C f b)
            (I ∪ (root \ E)) : ℕ) := by
      exact_mod_cast (by simpa only [EF, QF, IF] using hcover)
    _ = ∑ E ∈ EF, ∑ Q ∈ QF E, ∑ I ∈ IF Q,
          (codegree (conflictLinkLayer C f b)
            (I ∪ (root \ E)) : ℝ) := by
      push_cast
      rfl
    _ ≤ ∑ _E ∈ EF, 8 * target := by
      apply Finset.sum_le_sum
      intro E hE
      exact hEterm E hE
    _ = (EF.card : ℝ) * (8 * target) := by simp
    _ ≤ 16 * (8 * target) :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast hEFcard)
        (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
    _ = 128 * Real.rpow d
        ((r : ℝ) - (root.card : ℝ) - eta) := by
      simp only [target]
      ring

/-- An overlapping distinct pair cannot have a singleton member. -/
theorem duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_left
    (C : ConflictSystem V) (f : Finset V)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (a b r : ℕ) (root : Hypergraph V) (ha : a = 1)
    (hb : b ∈ Finset.Icc 1 3) :
    duplicateConflictLinkOrderedPairSlice C f a b r root = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro p hp
  have hp' := mem_duplicateConflictLinkOrderedPairSlice.mp hp
  have hp1card : p.1.card = 1 := by
    rw [← ha]
    exact (mem_conflictLinkLayer.mp hp'.1).2
  obtain ⟨x, hx1, hx2⟩ := Finset.not_disjoint_iff.mp hp'.2.2.2.1
  obtain ⟨y, hp1eq⟩ := Finset.card_eq_one.mp hp1card
  have hxy : x = y := by
    rw [hp1eq] at hx1
    exact Finset.mem_singleton.mp hx1
  have hsub : p.1 ⊆ p.2 := by
    intro z hz
    rw [hp1eq] at hz
    have hzy : z = y := Finset.mem_singleton.mp hz
    simpa [hzy, hxy] using hx2
  have hp1all : p.1 ∈ allNonemptyConflictLinks C f :=
    mem_allNonemptyConflictLinks.mpr
      ⟨a, Finset.mem_Icc.mpr ⟨by omega, by omega⟩, hp'.1⟩
  have hp2all : p.2 ∈ allNonemptyConflictLinks C f :=
    mem_allNonemptyConflictLinks.mpr ⟨b, hb, hp'.2.1⟩
  exact allNonemptyConflictLinks_antichain
    hanti hp1all hp2all hp'.2.2.1 hsub

/-- Symmetric singleton exclusion. -/
theorem duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_right
    (C : ConflictSystem V) (f : Finset V)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (a b r : ℕ) (root : Hypergraph V)
    (ha : a ∈ Finset.Icc 1 3) (hb : b = 1) :
    duplicateConflictLinkOrderedPairSlice C f a b r root = ∅ := by
  have hleft := duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_left
    C f hanti b a r root hb ha
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro p hp
  have hp' := mem_duplicateConflictLinkOrderedPairSlice.mp hp
  have hswap : (p.2, p.1) ∈
      duplicateConflictLinkOrderedPairSlice C f b a r root := by
    apply mem_duplicateConflictLinkOrderedPairSlice.mpr
    exact ⟨hp'.2.1, hp'.1, hp'.2.2.1.symm,
      fun hd ↦ hp'.2.2.2.1 hd.symm,
      by simpa [Finset.union_comm] using hp'.2.2.2.2.1,
      by simpa [Finset.union_comm] using hp'.2.2.2.2.2⟩
  rw [hleft] at hswap
  simpa using hswap

theorem card_duplicateConflictLinkOrderedPairSlice_le_256_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (a b r : ℕ) (root : Hypergraph V)
    (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3)
    (hr5 : r ≤ 5) (hrootPos : 1 ≤ root.card)
    (hrootLt : root.card < r) :
    ((duplicateConflictLinkOrderedPairSlice C f a b r root).card : ℝ) ≤
      256 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  by_cases ha2 : 2 ≤ a
  · by_cases hb2 : 2 ≤ b
    · have hroot : root.Nonempty := Finset.card_pos.mp hrootPos
      have horient :=
        card_duplicateConflictLinkOrderedPairSlice_le_firstRooted_add_swap
          C f a b r root hroot
      have hfirst := card_duplicateConflictLinkOrderedPairFirstRooted_le_rpow
        hB hanti hd hd1 heta f a b r root ha2
          (Finset.mem_Icc.mp ha).2 hb2 (Finset.mem_Icc.mp hb).2
          hr5 hrootPos hrootLt
      have hsecond := card_duplicateConflictLinkOrderedPairFirstRooted_le_rpow
        hB hanti hd hd1 heta f b a r root hb2
          (Finset.mem_Icc.mp hb).2 ha2 (Finset.mem_Icc.mp ha).2
          hr5 hrootPos hrootLt
      calc
        ((duplicateConflictLinkOrderedPairSlice C f a b r root).card : ℝ) ≤
            ((duplicateConflictLinkOrderedPairFirstRooted
              C f a b r root).card : ℕ) +
              (duplicateConflictLinkOrderedPairFirstRooted
                C f b a r root).card := by exact_mod_cast horient
        _ = ((duplicateConflictLinkOrderedPairFirstRooted
              C f a b r root).card : ℝ) +
              ((duplicateConflictLinkOrderedPairFirstRooted
                C f b a r root).card : ℝ) := by push_cast; rfl
        _ ≤ 128 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) +
              128 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) :=
          add_le_add hfirst hsecond
        _ = 256 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by ring
    · have hb1 : b = 1 := by
        have := (Finset.mem_Icc.mp hb).1
        omega
      rw [duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_right
        C f hanti a b r root ha hb1, Finset.card_empty, Nat.cast_zero]
      exact mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)
  · have ha1 : a = 1 := by
      have := (Finset.mem_Icc.mp ha).1
      omega
    rw [duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_left
      C f hanti a b r root ha1 hb, Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)

/-- Positive rooted degrees of the representation-free duplicate-union
layer.  There are nine ordered rank pairs and each costs at most 256
representations. -/
theorem codegree_duplicateConflictLinkUnionLayer_le_2304_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (r : ℕ) (root : Hypergraph V)
    (hr5 : r ≤ 5) (hrootPos : 1 ≤ root.card)
    (hrootLt : root.card < r) :
    (codegree (duplicateConflictLinkUnionLayer C f r) root : ℝ) ≤
      2304 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  have hcover := codegree_duplicateConflictLinkUnionLayer_le_orderedPairSlices
    C f r root
  calc
    (codegree (duplicateConflictLinkUnionLayer C f r) root : ℝ) ≤
        (∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
          (duplicateConflictLinkOrderedPairSlice C f a b r root).card : ℕ) := by
      exact_mod_cast hcover
    _ = ∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
        ((duplicateConflictLinkOrderedPairSlice C f a b r root).card : ℝ) := by
      push_cast
      rfl
    _ ≤ ∑ _a ∈ Finset.Icc 1 3, ∑ _b ∈ Finset.Icc 1 3,
        256 * Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
      apply Finset.sum_le_sum
      intro a ha
      apply Finset.sum_le_sum
      intro b hb
      exact card_duplicateConflictLinkOrderedPairSlice_le_256_rpow
        hB hanti hd hd1 heta f a b r root ha hb hr5 hrootPos hrootLt
    _ = 2304 * Real.rpow d
        ((r : ℝ) - (root.card : ℝ) - eta) := by
      norm_num [Finset.sum_Icc_succ_top]
      ring

/-- Empty-root form of the exact pair partition. -/
theorem card_duplicateConflictLinkOrderedPairSlice_le_overlapSum
    (C : ConflictSystem V) (f : Finset V)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (a b r : ℕ)
    (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3) :
    (duplicateConflictLinkOrderedPairSlice C f a b r ∅).card ≤
      ∑ Q₁ ∈ conflictLinkLayer C f a,
        ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
            (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
          codegree (conflictLinkLayer C f b) I := by
  let Cover : Finset (Hypergraph V × Hypergraph V) :=
    (conflictLinkLayer C f a).biUnion fun Q₁ ↦
      ((Q₁.powersetCard (a + b - r)).filter
        (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)).biUnion fun I ↦
          ((conflictLinkLayer C f b).filter (I ⊆ ·)).image
            fun Q₂ ↦ (Q₁, Q₂)
  have hsub : duplicateConflictLinkOrderedPairSlice C f a b r ∅ ⊆
      Cover := by
    intro p hp
    have hpdata := mem_duplicateConflictLinkOrderedPairSlice.mp hp
    let I := p.1 ∩ p.2
    have hp1card : p.1.card = a :=
      (mem_conflictLinkLayer.mp hpdata.1).2
    have hp2card : p.2.card = b :=
      (mem_conflictLinkLayer.mp hpdata.2.1).2
    have hcardIdentity := Finset.card_union_add_card_inter p.1 p.2
    have hIcard : I.card = a + b - r := by
      dsimp [I]
      omega
    have hQall : p.1 ∈ allNonemptyConflictLinks C f :=
      mem_allNonemptyConflictLinks.mpr ⟨a, ha, hpdata.1⟩
    have hQ'all : p.2 ∈ allNonemptyConflictLinks C f :=
      mem_allNonemptyConflictLinks.mpr ⟨b, hb, hpdata.2.1⟩
    have hIpos : I.Nonempty :=
      Finset.not_disjoint_iff_nonempty_inter.mp hpdata.2.2.2.1
    have hIltA : I.card < a := by
      rw [← hp1card]
      exact card_inter_lt_left_of_distinct_conflictLinks
        hanti hQall hQ'all hpdata.2.2.1
    have hIltB : I.card < b := by
      rw [← hp2card]
      simpa [I, Finset.inter_comm] using
        (card_inter_lt_left_of_distinct_conflictLinks
          hanti hQ'all hQall hpdata.2.2.1.symm)
    have hI : I ∈ (p.1.powersetCard (a + b - r)).filter
        (fun J ↦ J.Nonempty ∧ J.card < a ∧ J.card < b) := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_powersetCard.mpr
        ⟨Finset.inter_subset_left, hIcard⟩, hIpos, hIltA, hIltB⟩
    apply Finset.mem_biUnion.mpr
    refine ⟨p.1, hpdata.1, Finset.mem_biUnion.mpr ⟨I, hI, ?_⟩⟩
    exact Finset.mem_image.mpr ⟨p.2,
      Finset.mem_filter.mpr ⟨hpdata.2.1, Finset.inter_subset_right⟩, rfl⟩
  calc
    (duplicateConflictLinkOrderedPairSlice C f a b r ∅).card ≤
        Cover.card := Finset.card_le_card hsub
    _ ≤ ∑ Q₁ ∈ conflictLinkLayer C f a,
        (((Q₁.powersetCard (a + b - r)).filter
          (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)).biUnion fun I ↦
            ((conflictLinkLayer C f b).filter (I ⊆ ·)).image
              fun Q₂ ↦ (Q₁, Q₂)).card := Finset.card_biUnion_le
    _ ≤ ∑ Q₁ ∈ conflictLinkLayer C f a,
        ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
            (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
          (((conflictLinkLayer C f b).filter (I ⊆ ·)).image
            fun Q₂ ↦ (Q₁, Q₂)).card := by
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      exact Finset.card_biUnion_le
    _ ≤ ∑ Q₁ ∈ conflictLinkLayer C f a,
        ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
            (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
          ((conflictLinkLayer C f b).filter (I ⊆ ·)).card := by
      apply Finset.sum_le_sum
      intro Q₁ hQ₁
      apply Finset.sum_le_sum
      intro I hI
      exact Finset.card_image_le
    _ = ∑ Q₁ ∈ conflictLinkLayer C f a,
        ∑ I ∈ (Q₁.powersetCard (a + b - r)).filter
            (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b),
          codegree (conflictLinkLayer C f b) I := by rfl

theorem card_duplicateConflictLinkOrderedPairSlice_empty_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (hf : f ∈ H) (a b r : ℕ)
    (ha : a ∈ Finset.Icc 1 3) (hb : b ∈ Finset.Icc 1 3) :
    ((duplicateConflictLinkOrderedPairSlice C f a b r ∅).card : ℝ) ≤
      8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
  have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hd
  by_cases ha2 : 2 ≤ a
  · by_cases hb2 : 2 ≤ b
    · have hcover := card_duplicateConflictLinkOrderedPairSlice_le_overlapSum
        C f hanti a b r ha hb
      let IF : Hypergraph V → Finset (Hypergraph V) := fun Q ↦
        (Q.powersetCard (a + b - r)).filter
          (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)
      by_cases hi : 1 ≤ a + b - r
      · have hri : r ≤ a + b := by omega
        let scaleB : ℝ :=
          Real.rpow d ((b : ℝ) - ((a + b - r : ℕ) : ℝ) - eta)
        have hInner : ∀ Q ∈ conflictLinkLayer C f a,
            (∑ I ∈ IF Q,
              (codegree (conflictLinkLayer C f b) I : ℝ)) ≤
                8 * scaleB := by
          intro Q hQ
          have hQcard : Q.card = a :=
            (mem_conflictLinkLayer.mp hQ).2
          have hIFcard : (IF Q).card ≤ 8 := by
            simpa only [IF] using card_filtered_powersetCard_le_eight
              Q (a + b - r) (by
                rw [hQcard]
                exact (Finset.mem_Icc.mp ha).2)
              (fun I ↦ I.Nonempty ∧ I.card < a ∧ I.card < b)
          calc
            (∑ I ∈ IF Q,
                (codegree (conflictLinkLayer C f b) I : ℝ)) ≤
                ∑ _I ∈ IF Q, scaleB := by
              apply Finset.sum_le_sum
              intro I hIIF
              have hIdata := Finset.mem_filter.mp
                (by simpa only [IF] using hIIF)
              have hIcard : I.card = a + b - r :=
                (Finset.mem_powersetCard.mp hIdata.1).2
              have hIpos : 1 ≤ I.card := Finset.card_pos.mpr hIdata.2.1
              have hIlt : I.card < b := hIdata.2.2.2
              simpa only [scaleB, hIcard] using
                codegree_conflictLinkLayer_le_rpow hB hd f b I
                  (by omega) (Finset.mem_Icc.mp hb).2 hIpos hIlt
            _ = ((IF Q).card : ℝ) * scaleB := by simp
            _ ≤ 8 * scaleB :=
              mul_le_mul_of_nonneg_right (by exact_mod_cast hIFcard)
                (Real.rpow_nonneg hd.le _)
        have hA := card_conflictLinkLayer_le_Gamma_mul_rpow
          hB hd hf (by omega : 1 ≤ a) (Finset.mem_Icc.mp ha).2
        have hscale :
            (Gamma * Real.rpow d (a : ℝ)) * (8 * scaleB) =
              8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
          dsimp [scaleB]
          have hiCast : ((a + b - r : ℕ) : ℝ) =
              (a : ℝ) + (b : ℝ) - (r : ℝ) := by
            rw [Nat.cast_sub hri]
            push_cast
            rfl
          rw [hiCast]
          calc
            (Gamma * Real.rpow d (a : ℝ)) *
                (8 * Real.rpow d
                  ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta)) =
                8 * Gamma *
                  (Real.rpow d (a : ℝ) *
                    Real.rpow d
                      ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta)) := by
              ring
            _ = 8 * Gamma * Real.rpow d
                ((a : ℝ) +
                  ((b : ℝ) - ((a : ℝ) + (b : ℝ) - (r : ℝ)) - eta)) := by
              congr 2
              exact (Real.rpow_add hd _ _).symm
            _ = 8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
              congr 2
              ring
        calc
          ((duplicateConflictLinkOrderedPairSlice C f a b r ∅).card : ℝ) ≤
              (∑ Q ∈ conflictLinkLayer C f a,
                ∑ I ∈ IF Q,
                  codegree (conflictLinkLayer C f b) I : ℕ) := by
            exact_mod_cast (by simpa only [IF] using hcover)
          _ = ∑ Q ∈ conflictLinkLayer C f a,
              ∑ I ∈ IF Q,
                (codegree (conflictLinkLayer C f b) I : ℝ) := by
            push_cast
            rfl
          _ ≤ ∑ _Q ∈ conflictLinkLayer C f a, 8 * scaleB := by
            apply Finset.sum_le_sum
            intro Q hQ
            exact hInner Q hQ
          _ = ((conflictLinkLayer C f a).card : ℝ) *
              (8 * scaleB) := by simp
          _ ≤ (Gamma * Real.rpow d (a : ℝ)) * (8 * scaleB) :=
            mul_le_mul_of_nonneg_right hA
              (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _))
          _ = 8 * Gamma * Real.rpow d ((r : ℝ) - eta) := hscale
      · have hi0 : a + b - r = 0 := by omega
        have hIFempty : ∀ Q, IF Q = ∅ := by
          intro Q
          apply Finset.eq_empty_iff_forall_notMem.mpr
          intro I hI
          have hIdata := Finset.mem_filter.mp
            (by simpa only [IF] using hI)
          have hIcard : I.card = 0 := by
            simpa only [hi0] using (Finset.mem_powersetCard.mp hIdata.1).2
          exact (Finset.not_nonempty_iff_eq_empty.mpr
            (Finset.card_eq_zero.mp hIcard)) hIdata.2.1
        have hzero :
            duplicateConflictLinkOrderedPairSlice C f a b r ∅ = ∅ := by
          apply Finset.card_eq_zero.mp
          apply Nat.eq_zero_of_le_zero
          calc
            (duplicateConflictLinkOrderedPairSlice C f a b r ∅).card ≤
                ∑ Q ∈ conflictLinkLayer C f a,
                  ∑ I ∈ IF Q,
                    codegree (conflictLinkLayer C f b) I := by
              simpa only [IF] using hcover
            _ = 0 := by simp [hIFempty]
        rw [hzero, Finset.card_empty, Nat.cast_zero]
        exact mul_nonneg
          (mul_nonneg (by norm_num) hGamma) (Real.rpow_nonneg hd.le _)
    · have hb1 : b = 1 := by
        have := (Finset.mem_Icc.mp hb).1
        omega
      rw [duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_right
        C f hanti a b r ∅ ha hb1, Finset.card_empty, Nat.cast_zero]
      exact mul_nonneg
        (mul_nonneg (by norm_num) hGamma) (Real.rpow_nonneg hd.le _)
  · have ha1 : a = 1 := by
      have := (Finset.mem_Icc.mp ha).1
      omega
    rw [duplicateConflictLinkOrderedPairSlice_eq_empty_of_rank_one_left
      C f hanti a b r ∅ ha1 hb, Finset.card_empty, Nat.cast_zero]
    exact mul_nonneg
      (mul_nonneg (by norm_num) hGamma) (Real.rpow_nonneg hd.le _)

theorem card_duplicateConflictLinkUnionLayer_le_72_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (hf : f ∈ H) (r : ℕ) :
    ((duplicateConflictLinkUnionLayer C f r).card : ℝ) ≤
      72 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
  have hcover := codegree_duplicateConflictLinkUnionLayer_le_orderedPairSlices
    C f r ∅
  rw [codegree_empty] at hcover
  calc
    ((duplicateConflictLinkUnionLayer C f r).card : ℝ) ≤
        (∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
          (duplicateConflictLinkOrderedPairSlice C f a b r ∅).card : ℕ) := by
      exact_mod_cast hcover
    _ = ∑ a ∈ Finset.Icc 1 3, ∑ b ∈ Finset.Icc 1 3,
        ((duplicateConflictLinkOrderedPairSlice C f a b r ∅).card : ℝ) := by
      push_cast
      rfl
    _ ≤ ∑ _a ∈ Finset.Icc 1 3, ∑ _b ∈ Finset.Icc 1 3,
        8 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
      apply Finset.sum_le_sum
      intro a ha
      apply Finset.sum_le_sum
      intro b hb
      exact card_duplicateConflictLinkOrderedPairSlice_empty_le_rpow
        hB hanti hd hd1 heta f hf a b r ha hb
    _ = 72 * Gamma * Real.rpow d ((r : ℝ) - eta) := by
      norm_num [Finset.sum_Icc_succ_top]
      ring

/-- Complete static form of source Lemma 6.3(v), with an explicit coarse
representation constant.  It uses only the existing `(C2)/(C3)` fields
and the conflict antichain. -/
theorem duplicateConflictLinkUnionLayer_isRealSpread
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hd : 0 < d) (hd1 : 1 ≤ d) (heta : 0 ≤ eta)
    (f : Finset V) (hf : f ∈ H) (r : ℕ)
    (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    IsRealSpread (duplicateConflictLinkUnionLayer C f r) r
      (2304 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) d⁻¹ := by
  refine ⟨duplicateConflictLinkUnionLayer_uniform C f r, ?_⟩
  intro root hrootLt
  have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hd
  have hscaleNonneg :
      0 ≤ Real.rpow d ((r : ℝ) - eta) := Real.rpow_nonneg hd.le _
  by_cases hrootZero : root.card = 0
  · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
    subst root
    have hcard := card_duplicateConflictLinkUnionLayer_le_72_rpow
      hB hanti hd hd1 heta f hf r
    have hcoef : 72 * Gamma ≤ 2304 * (Gamma + 1) := by nlinarith
    calc
      (codegree (duplicateConflictLinkUnionLayer C f r) ∅ : ℝ) =
          ((duplicateConflictLinkUnionLayer C f r).card : ℝ) := by
        rw [codegree_empty]
      _ ≤ 72 * Gamma * Real.rpow d ((r : ℝ) - eta) := hcard
      _ ≤ (2304 * (Gamma + 1)) *
          Real.rpow d ((r : ℝ) - eta) :=
        mul_le_mul_of_nonneg_right hcoef hscaleNonneg
      _ = (2304 * (Gamma + 1) *
          Real.rpow d ((r : ℝ) - eta)) * d⁻¹ ^ (∅ : Hypergraph V).card := by
        simp
  · have hrootPos : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
    have hrootBound := codegree_duplicateConflictLinkUnionLayer_le_2304_rpow
      hB hanti hd hd1 heta f r root hr5 hrootPos hrootLt
    have hinvPow : d⁻¹ ^ root.card =
        Real.rpow d (-(root.card : ℝ)) := by
      calc
        d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
        _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
          exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
        _ = Real.rpow d (-(root.card : ℝ)) :=
          (Real.rpow_neg hd.le _).symm
    have hrpowSplit :
        Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
          Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card := by
      rw [hinvPow]
      calc
        Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
            Real.rpow d
              (((r : ℝ) - eta) + (-(root.card : ℝ))) := by
          congr 1
          ring
        _ = Real.rpow d ((r : ℝ) - eta) *
            Real.rpow d (-(root.card : ℝ)) :=
          Real.rpow_add hd _ _
    have hinvNonneg : 0 ≤ d⁻¹ ^ root.card :=
      pow_nonneg (inv_nonneg.mpr hd.le) _
    have hbase :
        2304 * Real.rpow d ((r : ℝ) - eta) ≤
          2304 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
      nlinarith
    calc
      (codegree (duplicateConflictLinkUnionLayer C f r) root : ℝ) ≤
          2304 * Real.rpow d
            ((r : ℝ) - (root.card : ℝ) - eta) := hrootBound
      _ = (2304 * Real.rpow d ((r : ℝ) - eta)) *
          d⁻¹ ^ root.card := by
        rw [hrpowSplit]
        ring
      _ ≤ (2304 * (Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) *
          d⁻¹ ^ root.card :=
        mul_le_mul_of_nonneg_right hbase hinvNonneg

theorem duplicateConflictLinkUnions_eq_layerUnion_three_five
    (C : ConflictSystem V) (f : Finset V)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    duplicateConflictLinkUnions C f =
      (Finset.Icc 3 5).biUnion fun r ↦
        duplicateConflictLinkUnionLayer C f r := by
  ext U
  constructor
  · intro hU
    have hrange := duplicateConflictLinkUnions_card_between_three_five
      hanti hU
    exact Finset.mem_biUnion.mpr
      ⟨U.card, Finset.mem_Icc.mpr hrange,
        mem_duplicateConflictLinkUnionLayer.mpr ⟨hU, rfl⟩⟩
  · intro hU
    obtain ⟨r, _hr, hUr⟩ := Finset.mem_biUnion.mp hU
    exact (mem_duplicateConflictLinkUnionLayer.mp hUr).1

/-! ## The deterministic collision charge

The next three finite families isolate the exact map whose multiplicity is
the gap between `internalOpenLinkMass` and `openConflictCount`.
-/

def oneOpenConflictLinkFamily (C : ConflictSystem V)
    (A M : Hypergraph V) (f : Finset V) : ConflictSystem V :=
  (Finset.Icc 1 3).biUnion fun q ↦
    partialFamily (conflictLinkLayer C f q) A M 1

def oneOpenConflictLinkChoices (C : ConflictSystem V)
    (A M : Hypergraph V) (f : Finset V) : Hypergraph V :=
  (oneOpenConflictLinkFamily C A M f).biUnion fun Q ↦ Q ∩ A

def collidingOneOpenConflictLinks (C : ConflictSystem V)
    (A M : Hypergraph V) (f : Finset V) : ConflictSystem V :=
  (oneOpenConflictLinkFamily C A M f).filter fun Q ↦
    ∃ Q' ∈ oneOpenConflictLinkFamily C A M f,
      Q' ≠ Q ∧ Q' ∩ A = Q ∩ A

@[simp] theorem mem_oneOpenConflictLinkFamily
    {C : ConflictSystem V} {A M : Hypergraph V}
    {f : Finset V} {Q : Hypergraph V} :
    Q ∈ oneOpenConflictLinkFamily C A M f ↔
      ∃ q ∈ Finset.Icc 1 3,
        Q ∈ partialFamily (conflictLinkLayer C f q) A M 1 := by
  simp [oneOpenConflictLinkFamily]

@[simp] theorem mem_collidingOneOpenConflictLinks
    {C : ConflictSystem V} {A M : Hypergraph V}
    {f : Finset V} {Q : Hypergraph V} :
    Q ∈ collidingOneOpenConflictLinks C A M f ↔
      Q ∈ oneOpenConflictLinkFamily C A M f ∧
        ∃ Q' ∈ oneOpenConflictLinkFamily C A M f,
          Q' ≠ Q ∧ Q' ∩ A = Q ∩ A := by
  simp [collidingOneOpenConflictLinks]

theorem card_oneOpenConflictLinkFamily_eq_internalOpenLinkMass
    (C : ConflictSystem V) (A M : Hypergraph V) (f : Finset V) :
    (oneOpenConflictLinkFamily C A M f).card =
      internalOpenLinkMass C A M f := by
  have hpair :
      (↑(Finset.Icc 1 3) : Set ℕ).PairwiseDisjoint
        (fun q ↦ partialFamily (conflictLinkLayer C f q) A M 1) := by
    intro q hq q' hq' hne
    change Disjoint
      (partialFamily (conflictLinkLayer C f q) A M 1)
      (partialFamily (conflictLinkLayer C f q') A M 1)
    rw [Finset.disjoint_left]
    intro Q hQ hQ'
    have hQcard : Q.card = q :=
      (mem_conflictLinkLayer.mp (mem_partialFamily.mp hQ).1).2
    have hQcard' : Q.card = q' :=
      (mem_conflictLinkLayer.mp (mem_partialFamily.mp hQ').1).2
    exact hne (hQcard.symm.trans hQcard')
  rw [oneOpenConflictLinkFamily, Finset.card_biUnion hpair]
  norm_num [internalOpenLinkMass, Finset.sum_Icc_succ_top]

/-- Under the source matching invariant, the image of the one-open links
under their unique available member is exactly the set of legal conflict
evictors counted by `openConflictCount`. -/
theorem card_oneOpenConflictLinkChoices_eq_openConflictCount
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {f : Finset V}
    (hmatching : ∀ c ∈ C, IsMatching H c) :
    (oneOpenConflictLinkChoices C A M f).card =
      openConflictCount C A M f := by
  apply congrArg Finset.card
  ext e
  constructor
  · intro he
    obtain ⟨Q, hQF, heQA⟩ := Finset.mem_biUnion.mp he
    obtain ⟨q, hq, hQpartial⟩ := mem_oneOpenConflictLinkFamily.mp hQF
    have heQ : e ∈ Q := (Finset.mem_inter.mp heQA).1
    have heA : e ∈ A := (Finset.mem_inter.mp heQA).2
    have hQlink := (mem_partialFamily.mp hQpartial).1
    obtain ⟨⟨c, hcC, hfc, hcErase⟩, _hQcard⟩ :=
      mem_conflictLinkLayer.mp hQlink
    have heErase : e ∈ c.erase f := by
      rw [hcErase]
      exact heQ
    have hef : e ≠ f := (Finset.mem_erase.mp heErase).1
    have hec : e ∈ c := (Finset.mem_erase.mp heErase).2
    have hedisj : Disjoint e f := (hmatching c hcC).2 hec hfc hef
    apply Finset.mem_filter.mpr
    refine ⟨?_, heA, hedisj⟩
    unfold activeConflictBlockers
    exact Finset.mem_biUnion.mpr
      ⟨q, hq, Finset.mem_biUnion.mpr ⟨Q, hQpartial, heQ⟩⟩
  · intro he
    have he' := Finset.mem_filter.mp he
    unfold activeConflictBlockers at he'
    obtain ⟨q, hq, hqmem⟩ := Finset.mem_biUnion.mp he'.1
    obtain ⟨Q, hQpartial, heQ⟩ := Finset.mem_biUnion.mp hqmem
    apply Finset.mem_biUnion.mpr
    refine ⟨Q, mem_oneOpenConflictLinkFamily.mpr ⟨q, hq, hQpartial⟩, ?_⟩
    exact Finset.mem_inter.mpr ⟨by simpa only [id_eq] using heQ, he'.2.1⟩

/-- For any finite family whose `A`-sections are singletons, the deficit
between the family and the union of those sections is at most the number
of members which share their section with another member. -/
theorem card_oneOpenConflictLinkFamily_sub_choices_le_colliding
    (C : ConflictSystem V) (A M : Hypergraph V) (f : Finset V) :
    (oneOpenConflictLinkFamily C A M f).card -
        (oneOpenConflictLinkChoices C A M f).card ≤
      (collidingOneOpenConflictLinks C A M f).card := by
  let F := oneOpenConflictLinkFamily C A M f
  let K := collidingOneOpenConflictLinks C A M f
  let S := F \ K
  have hKsub : K ⊆ F := by
    exact Finset.filter_subset _ _
  have hcardA : ∀ Q ∈ F, (Q ∩ A).card = 1 := by
    intro Q hQ
    obtain ⟨q, _hq, hQpartial⟩ :=
      mem_oneOpenConflictLinkFamily.mp (by simpa only [F] using hQ)
    exact (mem_partialFamily.mp hQpartial).2.1
  have hpair : (↑S : Set (Hypergraph V)).PairwiseDisjoint
      (fun Q ↦ Q ∩ A) := by
    intro Q hQS Q' hQ'S hne
    have hQdata := Finset.mem_sdiff.mp hQS
    have hQ'data := Finset.mem_sdiff.mp hQ'S
    have hQF : Q ∈ F := hQdata.1
    have hQ'F : Q' ∈ F := hQ'data.1
    change Disjoint (Q ∩ A) (Q' ∩ A)
    rw [Finset.disjoint_left]
    intro e heQ heQ'
    apply hQdata.2
    apply mem_collidingOneOpenConflictLinks.mpr
    refine ⟨by simpa only [F] using hQF, Q',
      by simpa only [F] using hQ'F, hne.symm, ?_⟩
    have hQsingle : Q ∩ A = {e} := by
      obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q hQF)
      have hea : e = a := by
        rw [ha] at heQ
        exact Finset.mem_singleton.mp heQ
      simpa [hea] using ha
    have hQ'single : Q' ∩ A = {e} := by
      obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q' hQ'F)
      have hea : e = a := by
        rw [ha] at heQ'
        exact Finset.mem_singleton.mp heQ'
      simpa [hea] using ha
    exact hQ'single.trans hQsingle.symm
  have hcardSUnion :
      (S.biUnion (fun Q ↦ Q ∩ A)).card = S.card := by
    rw [Finset.card_biUnion hpair]
    calc
      (∑ Q ∈ S, (Q ∩ A).card) = ∑ _Q ∈ S, 1 := by
        apply Finset.sum_congr rfl
        intro Q hQS
        exact hcardA Q (Finset.mem_sdiff.mp hQS).1
      _ = S.card := by simp
  have hSUnionSub : S.biUnion (fun Q ↦ Q ∩ A) ⊆
      oneOpenConflictLinkChoices C A M f := by
    intro e he
    obtain ⟨Q, hQS, heQA⟩ := Finset.mem_biUnion.mp he
    apply Finset.mem_biUnion.mpr
    exact ⟨Q, by
      simpa only [F] using (Finset.mem_sdiff.mp hQS).1, heQA⟩
  have hScardLe : S.card ≤
      (oneOpenConflictLinkChoices C A M f).card := by
    rw [← hcardSUnion]
    exact Finset.card_le_card hSUnionSub
  have hpartition : S.card + K.card = F.card := by
    exact Finset.card_sdiff_add_card_eq_card hKsub
  change F.card - (oneOpenConflictLinkChoices C A M f).card ≤ K.card
  omega

/-- A one-open partial member is entirely accounted for by `A ∪ M` as
soon as these two state sets are disjoint. -/
theorem oneOpenPartial_subset_available_union_selected
    {X : ConflictSystem V} {A M : Hypergraph V} {Q : Hypergraph V}
    (hAM : Disjoint A M) (hQ : Q ∈ partialFamily X A M 1) :
    Q ⊆ A ∪ M := by
  have hQA : (Q ∩ A).card = 1 := (mem_partialFamily.mp hQ).2.1
  have hQM : (Q ∩ M).card = Q.card - 1 :=
    (mem_partialFamily.mp hQ).2.2
  have hpos : 1 ≤ Q.card := by
    calc
      1 = (Q ∩ A).card := hQA.symm
      _ ≤ Q.card := Finset.card_le_card Finset.inter_subset_left
  have hdisj : Disjoint (Q ∩ A) (Q ∩ M) :=
    hAM.mono Finset.inter_subset_right Finset.inter_subset_right
  have hsubQ : (Q ∩ A) ∪ (Q ∩ M) ⊆ Q :=
    Finset.union_subset Finset.inter_subset_left Finset.inter_subset_left
  have hcardUnion : ((Q ∩ A) ∪ (Q ∩ M)).card = Q.card := by
    rw [Finset.card_union_of_disjoint hdisj, hQA, hQM]
    omega
  have heq : (Q ∩ A) ∪ (Q ∩ M) = Q :=
    Finset.eq_of_subset_of_card_le hsubQ (by omega)
  intro e heQ
  rw [← heq] at heQ
  rcases Finset.mem_union.mp heQ with heA | heM
  · exact Finset.mem_union.mpr (Or.inl (Finset.inter_subset_right heA))
  · exact Finset.mem_union.mpr (Or.inr (Finset.inter_subset_right heM))

/-- Every colliding one-open link is a subset of a one-open member of the
source duplicate-union family `C_{f,2}`. -/
theorem collidingOneOpenConflictLinks_subset_duplicatePartialPowersets
    {C : ConflictSystem V} {A M : Hypergraph V} {f : Finset V}
    (hAM : Disjoint A M) :
    collidingOneOpenConflictLinks C A M f ⊆
      (Finset.Icc 0 6).biUnion fun r ↦
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).biUnion
          Finset.powerset := by
  intro Q hQcollision
  obtain ⟨hQF, Q', hQ'F, hQ'Q, hsections⟩ :=
    mem_collidingOneOpenConflictLinks.mp hQcollision
  obtain ⟨q, hq, hQpartial⟩ := mem_oneOpenConflictLinkFamily.mp hQF
  obtain ⟨q', hq', hQ'partial⟩ := mem_oneOpenConflictLinkFamily.mp hQ'F
  have hQlink := (mem_partialFamily.mp hQpartial).1
  have hQ'link := (mem_partialFamily.mp hQ'partial).1
  have hQall : Q ∈ allNonemptyConflictLinks C f :=
    mem_allNonemptyConflictLinks.mpr ⟨q, hq, hQlink⟩
  have hQ'all : Q' ∈ allNonemptyConflictLinks C f :=
    mem_allNonemptyConflictLinks.mpr ⟨q', hq', hQ'link⟩
  have hQcardA : (Q ∩ A).card = 1 :=
    (mem_partialFamily.mp hQpartial).2.1
  obtain ⟨e, hQsection⟩ := Finset.card_eq_one.mp hQcardA
  have heQsection : e ∈ Q ∩ A := by simp [hQsection]
  have heQ'section : e ∈ Q' ∩ A := by
    rw [hsections, hQsection]
    simp
  have hnotdisj : ¬Disjoint Q Q' :=
    Finset.not_disjoint_iff.mpr
      ⟨e, Finset.inter_subset_left heQsection,
        Finset.inter_subset_left heQ'section⟩
  let p : ConflictSystem V := {Q, Q'}
  have hp : p ∈ duplicateConflictLinkPairs C f := by
    apply mem_duplicateConflictLinkPairs.mpr
    refine ⟨?_, ?_, Q, by simp [p], Q', by simp [p], hQ'Q.symm, hnotdisj⟩
    · intro R hR
      simp only [p, Finset.mem_insert, Finset.mem_singleton] at hR
      rcases hR with rfl | rfl
      · exact hQall
      · exact hQ'all
    · simp [p, Ne.symm hQ'Q]
  let U := Q ∪ Q'
  have hUduplicate : U ∈ duplicateConflictLinkUnions C f := by
    apply mem_duplicateConflictLinkUnions.mpr
    refine ⟨p, hp, ?_⟩
    simp [p, U]
  have hUA : U ∩ A = Q ∩ A := by
    change (Q ∪ Q') ∩ A = Q ∩ A
    rw [Finset.union_inter_distrib_right, hsections, Finset.union_self]
  have hQcover := oneOpenPartial_subset_available_union_selected hAM hQpartial
  have hQ'cover := oneOpenPartial_subset_available_union_selected hAM hQ'partial
  have hUcover : U ⊆ A ∪ M := by
    change Q ∪ Q' ⊆ A ∪ M
    exact Finset.union_subset hQcover hQ'cover
  have hpartition : (U ∩ A) ∪ (U ∩ M) = U := by
    ext g
    simp only [Finset.mem_union, Finset.mem_inter]
    constructor
    · rintro (⟨hgU, _hgA⟩ | ⟨hgU, _hgM⟩) <;> exact hgU
    · intro hgU
      rcases Finset.mem_union.mp (hUcover hgU) with hgA | hgM
      · exact Or.inl ⟨hgU, hgA⟩
      · exact Or.inr ⟨hgU, hgM⟩
  have hdisjParts : Disjoint (U ∩ A) (U ∩ M) :=
    hAM.mono Finset.inter_subset_right Finset.inter_subset_right
  have hUcardParts : U.card = (U ∩ A).card + (U ∩ M).card := by
    rw [← Finset.card_union_of_disjoint hdisjParts, hpartition]
  have hUAcard : (U ∩ A).card = 1 := by rw [hUA, hQcardA]
  have hUMcard : (U ∩ M).card = U.card - 1 := by omega
  have hUpartial : U ∈ partialFamily
      (duplicateConflictLinkUnionLayer C f U.card) A M 1 := by
    apply mem_partialFamily.mpr
    exact ⟨mem_duplicateConflictLinkUnionLayer.mpr ⟨hUduplicate, rfl⟩,
      hUAcard, hUMcard⟩
  apply Finset.mem_biUnion.mpr
  refine ⟨U.card, Finset.mem_Icc.mpr
    ⟨Nat.zero_le _, duplicateConflictLinkUnions_card_le_six hUduplicate⟩, ?_⟩
  apply Finset.mem_biUnion.mpr
  exact ⟨U, hUpartial, Finset.mem_powerset.mpr (by
    exact Finset.subset_union_left)⟩

/-- The representation loss is at most `2^6 = 64`: after charging a
colliding link `Q` to a duplicate union `U`, remembering `Q ⊆ U` leaves at
most all subsets of a six-element set. -/
theorem card_collidingOneOpenConflictLinks_le_duplicatePartial
    {C : ConflictSystem V} {A M : Hypergraph V} {f : Finset V}
    (hAM : Disjoint A M) :
    (collidingOneOpenConflictLinks C A M f).card ≤
      64 * ∑ r ∈ Finset.Icc 0 6,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card := by
  let G : ℕ → ConflictSystem V := fun r ↦
    partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1
  have hsub := collidingOneOpenConflictLinks_subset_duplicatePartialPowersets
    (C := C) (A := A) (M := M) (f := f) hAM
  have hinner (r : ℕ) (hr : r ∈ Finset.Icc 0 6) :
      ((G r).biUnion Finset.powerset).card ≤ 64 * (G r).card := by
    calc
      ((G r).biUnion Finset.powerset).card ≤
          ∑ U ∈ G r, U.powerset.card := Finset.card_biUnion_le
      _ ≤ ∑ _U ∈ G r, 64 := by
        apply Finset.sum_le_sum
        intro U hU
        have hUduplicate : U ∈ duplicateConflictLinkUnions C f :=
          (mem_duplicateConflictLinkUnionLayer.mp
            (mem_partialFamily.mp hU).1).1
        have hUcard := duplicateConflictLinkUnions_card_le_six hUduplicate
        rw [Finset.card_powerset]
        interval_cases U.card <;> norm_num
      _ = 64 * (G r).card := by simp [Nat.mul_comm]
  calc
    (collidingOneOpenConflictLinks C A M f).card ≤
        ((Finset.Icc 0 6).biUnion fun r ↦
          (G r).biUnion Finset.powerset).card := by
      exact Finset.card_le_card (by simpa only [G] using hsub)
    _ ≤ ∑ r ∈ Finset.Icc 0 6,
          ((G r).biUnion Finset.powerset).card := Finset.card_biUnion_le
    _ ≤ ∑ r ∈ Finset.Icc 0 6, 64 * (G r).card := by
      apply Finset.sum_le_sum
      intro r hr
      exact hinner r hr
    _ = 64 * ∑ r ∈ Finset.Icc 0 6, (G r).card := by
      rw [Finset.mul_sum]
    _ = 64 * ∑ r ∈ Finset.Icc 0 6,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card := by
      rfl

/-- Source-faithful deterministic form of GJKKL Lemma 7.17.  The paper
uses the looser representation factor `4^ell`; at `ell=4` this is 256.
Our explicit rank-six encoding proves the sharper constant 64 first. -/
theorem internalOpenLinkMass_sub_openConflictCount_le_duplicate
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {f : Finset V}
    (hmatching : ∀ c ∈ C, IsMatching H c) (hAM : Disjoint A M) :
    internalOpenLinkMass C A M f - openConflictCount C A M f ≤
      256 * ∑ r ∈ Finset.Icc 0 6,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card := by
  have hdefect := card_oneOpenConflictLinkFamily_sub_choices_le_colliding
    C A M f
  have hcollision := card_collidingOneOpenConflictLinks_le_duplicatePartial
    (C := C) (A := A) (M := M) (f := f) hAM
  have hF := card_oneOpenConflictLinkFamily_eq_internalOpenLinkMass C A M f
  have hchoices := card_oneOpenConflictLinkChoices_eq_openConflictCount
    (C := C) (A := A) (M := M) (f := f) hmatching
  rw [hF, hchoices] at hdefect
  calc
    internalOpenLinkMass C A M f - openConflictCount C A M f ≤
        (collidingOneOpenConflictLinks C A M f).card := hdefect
    _ ≤ 64 * ∑ r ∈ Finset.Icc 0 6,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card :=
      hcollision
    _ ≤ 256 * ∑ r ∈ Finset.Icc 0 6,
        (partialFamily (duplicateConflictLinkUnionLayer C f r) A M 1).card := by
      omega

/-!
The source family `C^*_{e,f,2}` from GJKKL Definition 6.1(vi).

A member is a conflict link through `f`, of rank at least two, which
contains an edge immediately conflicting with `e`.  Since the regularized
conflicts have size at most four, only its rank-two and rank-three layers
are nonempty.
-/

def commonImmediateEvictorLinkFamily (C : ConflictSystem V)
    (e f : Finset V) : ConflictSystem V :=
  (conflictLink C f).filter fun Q ↦
    2 ≤ Q.card ∧
      ∃ g ∈ Q, ({g} : Hypergraph V) ∈ conflictLinkLayer C e 1

def commonImmediateEvictorLinkLayer (C : ConflictSystem V)
    (e f : Finset V) (r : ℕ) : ConflictSystem V :=
  (commonImmediateEvictorLinkFamily C e f).filter fun Q ↦ Q.card = r

@[simp] theorem mem_commonImmediateEvictorLinkFamily
    {C : ConflictSystem V} {e f : Finset V} {Q : Hypergraph V} :
    Q ∈ commonImmediateEvictorLinkFamily C e f ↔
      Q ∈ conflictLink C f ∧ 2 ≤ Q.card ∧
        ∃ g ∈ Q, ({g} : Hypergraph V) ∈ conflictLinkLayer C e 1 := by
  simp [commonImmediateEvictorLinkFamily]

@[simp] theorem mem_commonImmediateEvictorLinkLayer
    {C : ConflictSystem V} {e f : Finset V} {r : ℕ} {Q : Hypergraph V} :
    Q ∈ commonImmediateEvictorLinkLayer C e f r ↔
      Q ∈ commonImmediateEvictorLinkFamily C e f ∧ Q.card = r := by
  simp [commonImmediateEvictorLinkLayer]

theorem commonImmediateEvictorLinkLayer_uniform
    (C : ConflictSystem V) (e f : Finset V) (r : ℕ) :
    IsUniform (commonImmediateEvictorLinkLayer C e f r) r := by
  intro Q hQ
  exact (mem_commonImmediateEvictorLinkLayer.mp hQ).2

theorem commonImmediateEvictorLinkLayer_subset_conflictLinkLayer
    (C : ConflictSystem V) (e f : Finset V) (r : ℕ) :
    commonImmediateEvictorLinkLayer C e f r ⊆
      conflictLinkLayer C f r := by
  intro Q hQ
  obtain ⟨hQfamily, hQcard⟩ :=
    mem_commonImmediateEvictorLinkLayer.mp hQ
  obtain ⟨hQlink, _hr2, _g, _hgQ, _hg⟩ :=
    mem_commonImmediateEvictorLinkFamily.mp hQfamily
  exact mem_conflictLinkLayer.mpr ⟨(mem_conflictLink.mp hQlink), hQcard⟩

theorem commonImmediateEvictorLinkLayer_eq_empty_of_rank_lt_two
    (C : ConflictSystem V) (e f : Finset V) (r : ℕ) (hr : r < 2) :
    commonImmediateEvictorLinkLayer C e f r = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro Q hQ
  obtain ⟨hQfamily, hQcard⟩ :=
    mem_commonImmediateEvictorLinkLayer.mp hQ
  have hr2 := (mem_commonImmediateEvictorLinkFamily.mp hQfamily).2.1
  omega

theorem commonImmediateEvictorLinkLayer_eq_empty_of_rank_gt_three
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (e f : Finset V) (r : ℕ) (hr : 3 < r) :
    commonImmediateEvictorLinkLayer C e f r = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro Q hQ
  obtain ⟨hQfamily, hQcard⟩ :=
    mem_commonImmediateEvictorLinkLayer.mp hQ
  obtain ⟨hQlink, _hr2, _g, _hgQ, _hg⟩ :=
    mem_commonImmediateEvictorLinkFamily.mp hQfamily
  obtain ⟨c, hcC, hfc, hcErase⟩ := mem_conflictLink.mp hQlink
  have hcCard := (hB.conflict_card hcC).2
  have hEraseCard := Finset.card_erase_add_one hfc
  rw [hcErase, hQcard] at hEraseCard
  omega

/-- Under the four-conflict specialization, the full source coordinate is
exactly the disjoint-by-rank union of its two live layers. -/
theorem commonImmediateEvictorLinkFamily_eq_layerUnion_two_three
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (e f : Finset V) :
    commonImmediateEvictorLinkFamily C e f =
      (Finset.Icc 2 3).biUnion fun r ↦
        commonImmediateEvictorLinkLayer C e f r := by
  ext Q
  constructor
  · intro hQ
    obtain ⟨hQlink, hQ2, _g, _hgQ, _hg⟩ :=
      mem_commonImmediateEvictorLinkFamily.mp hQ
    obtain ⟨c, hcC, hfc, hcErase⟩ := mem_conflictLink.mp hQlink
    have hc4 := (hB.conflict_card hcC).2
    have hEraseCard := Finset.card_erase_add_one hfc
    have hQ3 : Q.card ≤ 3 := by
      rw [hcErase] at hEraseCard
      omega
    exact Finset.mem_biUnion.mpr
      ⟨Q.card, Finset.mem_Icc.mpr ⟨hQ2, hQ3⟩,
        mem_commonImmediateEvictorLinkLayer.mpr ⟨hQ, rfl⟩⟩
  · intro hQ
    obtain ⟨r, _hr, hQr⟩ := Finset.mem_biUnion.mp hQ
    exact (mem_commonImmediateEvictorLinkLayer.mp hQr).1

/-- A two-conflict `{e,g}` is equivalently an immediate singleton link
through `e`.  This supplies the orientation used by the internal gain
collision: the collision choice is `g`, while `e` is the source edge
whose insertion immediately evicts it. -/
theorem singleton_mem_conflictLinkLayer_one_of_twoConflict
    {C : ConflictSystem V} {e g : Finset V}
    (heg : ({e, g} : Hypergraph V) ∈ conflictLayer C 2) :
    ({g} : Hypergraph V) ∈ conflictLinkLayer C e 1 := by
  obtain ⟨hegC, hcard⟩ := mem_conflictLayer.mp heg
  have hne : e ≠ g := by
    intro h
    subst g
    simp at hcard
  apply mem_conflictLinkLayer.mpr
  refine ⟨⟨{e, g}, hegC, by simp, ?_⟩, by simp⟩
  simp [hne]

/-- Direct source classification for the immediate subcase in the fixed
choice `Z_{e,2}` root partition. -/
theorem mem_commonImmediateEvictorLinkLayer_of_twoConflict
    {C : ConflictSystem V} {e f g : Finset V} {r : ℕ}
    {Q : Hypergraph V} (hQ : Q ∈ conflictLinkLayer C f r)
    (hr2 : 2 ≤ r) (hgQ : g ∈ Q)
    (heg : ({e, g} : Hypergraph V) ∈ conflictLayer C 2) :
    Q ∈ commonImmediateEvictorLinkLayer C e f r := by
  obtain ⟨hQlink, hQcard⟩ := mem_conflictLinkLayer.mp hQ
  apply mem_commonImmediateEvictorLinkLayer.mpr
  refine ⟨mem_commonImmediateEvictorLinkFamily.mpr ⟨?_, ?_, g, hgQ, ?_⟩,
    hQcard⟩
  · exact mem_conflictLink.mpr hQlink
  · omega
  · exact singleton_mem_conflictLinkLayer_one_of_twoConflict heg

/-- Partial-family form of the same direct immediate-collision adapter. -/
theorem mem_partial_commonImmediateEvictorLinkLayer_of_twoConflict
    {C : ConflictSystem V} {e f g : Finset V} {r s : ℕ}
    {A M Q : Hypergraph V}
    (hQ : Q ∈ partialFamily (conflictLinkLayer C f r) A M s)
    (hr2 : 2 ≤ r) (hgQ : g ∈ Q)
    (heg : ({e, g} : Hypergraph V) ∈ conflictLayer C 2) :
    Q ∈ partialFamily (commonImmediateEvictorLinkLayer C e f r) A M s := by
  obtain ⟨hQsource, hQA, hQM⟩ := mem_partialFamily.mp hQ
  exact mem_partialFamily.mpr
    ⟨mem_commonImmediateEvictorLinkLayer_of_twoConflict
      hQsource hr2 hgQ heg, hQA, hQM⟩

/-! ## Deterministic gain-collision adapter -/

/-- Internal completion links which contain an edge immediately evicted by
`e`.  This is the unweighted collision coordinate needed when the
completion-link weight itself is not registered as trackable. -/
def internalImmediateGainCollisionFamily (C : ConflictSystem V)
    (e f : Finset V) (r : ℕ) (A M : Hypergraph V) (s : ℕ) :
    ConflictSystem V :=
  (partialFamily (conflictLinkLayer C f r) A M s).filter fun Q ↦
    ∃ g ∈ Q, ({g} : Hypergraph V) ∈ conflictLinkLayer C e 1

@[simp] theorem mem_internalImmediateGainCollisionFamily
    {C : ConflictSystem V} {e f : Finset V} {r : ℕ}
    {A M : Hypergraph V} {s : ℕ} {Q : Hypergraph V} :
    Q ∈ internalImmediateGainCollisionFamily C e f r A M s ↔
      Q ∈ partialFamily (conflictLinkLayer C f r) A M s ∧
        ∃ g ∈ Q, ({g} : Hypergraph V) ∈ conflictLinkLayer C e 1 := by
  simp [internalImmediateGainCollisionFamily]

/-- Exact source classification: every immediate internal gain collision
is already a partial member of `C^*_{e,f,2}`. -/
theorem internalImmediateGainCollisionFamily_subset_commonPartial
    {C : ConflictSystem V} {e f : Finset V} {r : ℕ}
    {A M : Hypergraph V} {s : ℕ} (hr2 : 2 ≤ r) :
    internalImmediateGainCollisionFamily C e f r A M s ⊆
      partialFamily (commonImmediateEvictorLinkLayer C e f r) A M s := by
  intro Q hQ
  obtain ⟨hQpartial, g, hgQ, hg⟩ :=
    mem_internalImmediateGainCollisionFamily.mp hQ
  obtain ⟨hQlinkLayer, hQA, hQM⟩ := mem_partialFamily.mp hQpartial
  obtain ⟨hQlink, hQcard⟩ := mem_conflictLinkLayer.mp hQlinkLayer
  apply mem_partialFamily.mpr
  refine ⟨mem_commonImmediateEvictorLinkLayer.mpr ⟨?_, hQcard⟩, hQA, hQM⟩
  exact mem_commonImmediateEvictorLinkFamily.mpr
    ⟨mem_conflictLink.mpr hQlink, by omega, g, hgQ, hg⟩

theorem card_internalImmediateGainCollisionFamily_le_commonPartial
    {C : ConflictSystem V} {e f : Finset V} {r : ℕ}
    {A M : Hypergraph V} {s : ℕ} (hr2 : 2 ≤ r) :
    (internalImmediateGainCollisionFamily C e f r A M s).card ≤
      (partialFamily (commonImmediateEvictorLinkLayer C e f r) A M s).card :=
  Finset.card_le_card
    (internalImmediateGainCollisionFamily_subset_commonPartial hr2)

/-! ## Static C2/C3 bounds -/

theorem common_layerMaxDegree_le_Gamma_mul_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) {j : ℕ} (hj2 : 2 ≤ j) (hj4 : j ≤ 4) :
    (CFMRegularization.layerMaxDegree H C j : ℝ) ≤
      Gamma * Real.rpow d ((j : ℝ) - 1) := by
  have hj : j ∈ Finset.Icc 2 4 := Finset.mem_Icc.mpr ⟨hj2, hj4⟩
  have hnonneg : ∀ k ∈ Finset.Icc 2 4,
      0 ≤ (CFMRegularization.layerMaxDegree H C k : ℝ) /
        Real.rpow d ((k : ℝ) - 1) := by
    intro k _hk
    exact div_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg hd.le _)
  have hterm :
      (CFMRegularization.layerMaxDegree H C j : ℝ) /
          Real.rpow d ((j : ℝ) - 1) ≤ Gamma :=
    (Finset.single_le_sum hnonneg hj).trans hB.2.1
  exact (div_le_iff₀ (Real.rpow_pos_of_pos hd _)).mp hterm

theorem common_regularizedBounded_Gamma_nonneg
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) : 0 ≤ Gamma := by
  have hsum : 0 ≤ ∑ j ∈ Finset.Icc 2 4,
      (CFMRegularization.layerMaxDegree H C j : ℝ) /
        Real.rpow d ((j : ℝ) - 1) := by
    apply Finset.sum_nonneg
    intro j hj
    exact div_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg hd.le _)
  exact hsum.trans hB.2.1

theorem common_card_conflictLinkLayer_le_Gamma_mul_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) {e : Finset V} (he : e ∈ H)
    {q : ℕ} (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    ((conflictLinkLayer C e q).card : ℝ) ≤
      Gamma * Real.rpow d (q : ℝ) := by
  calc
    ((conflictLinkLayer C e q).card : ℝ) =
        (degree (conflictLayer C (q + 1)) e : ℝ) := by
      exact_mod_cast
        CFMRegularization.card_conflictLinkLayer_eq_degree_layer C e q
    _ ≤ (CFMRegularization.layerMaxDegree H C (q + 1) : ℝ) := by
      exact_mod_cast CFMRegularization.degree_layer_le_layerMaxDegree he
    _ ≤ Gamma * Real.rpow d (((q + 1 : ℕ) : ℝ) - 1) :=
      common_layerMaxDegree_le_Gamma_mul_rpow hB hd (by omega) (by omega)
    _ = Gamma * Real.rpow d (q : ℝ) := by
      congr 2
      push_cast
      ring

theorem common_codegree_conflictLinkLayer_le_insert
    (C : ConflictSystem V) (f : Finset V) (q : ℕ)
    (root : Hypergraph V) (_hfroot : f ∉ root) :
    codegree (conflictLinkLayer C f q) root ≤
      codegree (conflictLayer C (q + 1)) (insert f root) := by
  apply Finset.card_le_card_of_injOn (insert f)
  · intro Q hQ
    have hQ' := Finset.mem_filter.mp hQ
    obtain ⟨⟨c, hcC, hfc, hcErase⟩, hQcard⟩ :=
      mem_conflictLinkLayer.mp hQ'.1
    have hcEq : c = insert f Q := by
      calc
        c = insert f (c.erase f) := (Finset.insert_erase hfc).symm
        _ = insert f Q := by rw [hcErase]
    apply Finset.mem_filter.mpr
    refine ⟨mem_conflictLayer.mpr ⟨?_, ?_⟩, ?_⟩
    · rw [← hcEq]
      exact hcC
    · have hfQ : f ∉ Q := by rw [← hcErase]; simp
      simp [hfQ, hQcard]
    · exact Finset.insert_subset_insert f hQ'.2
  · intro Q hQ Q' hQ' hEq
    have hQlink := (Finset.mem_filter.mp hQ).1
    have hQ'link := (Finset.mem_filter.mp hQ').1
    have hfQ : f ∉ Q := by
      obtain ⟨⟨c, _hcC, _hfc, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQlink
      rw [← hcErase]
      simp
    have hfQ' : f ∉ Q' := by
      obtain ⟨⟨c, _hcC, _hfc, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQ'link
      rw [← hcErase]
      simp
    calc
      Q = (insert f Q).erase f := by simp [hfQ]
      _ = (insert f Q').erase f := by rw [hEq]
      _ = Q' := by simp [hfQ']

theorem common_codegree_conflictLinkLayer_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (f : Finset V) (q : ℕ) (root : Hypergraph V)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hrootPos : 1 ≤ root.card) (hrootLt : root.card < q) :
    (codegree (conflictLinkLayer C f q) root : ℝ) ≤
      Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) := by
  by_cases hfroot : f ∈ root
  · have hzero : codegree (conflictLinkLayer C f q) root = 0 := by
      rw [codegree, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro Q hQ hrootQ
      obtain ⟨⟨c, _hcC, _hfc, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQ
      have hfQ : f ∉ Q := by rw [← hcErase]; simp
      exact hfQ (hrootQ hfroot)
    rw [hzero, Nat.cast_zero]
    exact Real.rpow_nonneg hd.le _
  · have hInsertCard : (insert f root).card = root.card + 1 := by
      rw [Finset.card_insert_of_notMem hfroot]
    calc
      (codegree (conflictLinkLayer C f q) root : ℝ) ≤
          (codegree (conflictLayer C (q + 1)) (insert f root) : ℝ) := by
        exact_mod_cast common_codegree_conflictLinkLayer_le_insert
          C f q root hfroot
      _ ≤ Real.rpow d
          (((q + 1 : ℕ) : ℝ) - ((root.card + 1 : ℕ) : ℝ) - eta) :=
        hB.layer_codegree (by omega) (by omega) (by omega) (by omega)
          (insert f root) hInsertCard
      _ = Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) := by
        congr 1
        push_cast
        ring

theorem card_commonImmediateEvictorLinkLayer_le_sum_codegrees
    (C : ConflictSystem V) (e f : Finset V) (r : ℕ) :
    (commonImmediateEvictorLinkLayer C e f r).card ≤
      ∑ G ∈ conflictLinkLayer C e 1,
        codegree (conflictLinkLayer C f r) G := by
  let X := commonImmediateEvictorLinkLayer C e f r
  let F : Hypergraph V → ConflictSystem V := fun G ↦
    (conflictLinkLayer C f r).filter (G ⊆ ·)
  have hsub : X ⊆ (conflictLinkLayer C e 1).biUnion F := by
    intro Q hQ
    obtain ⟨hQfamily, hQcard⟩ :=
      mem_commonImmediateEvictorLinkLayer.mp (by simpa only [X] using hQ)
    obtain ⟨hQlink, _hr2, g, hgQ, hgLink⟩ :=
      mem_commonImmediateEvictorLinkFamily.mp hQfamily
    apply Finset.mem_biUnion.mpr
    refine ⟨{g}, hgLink, Finset.mem_filter.mpr ⟨?_, ?_⟩⟩
    · exact mem_conflictLinkLayer.mpr
        ⟨mem_conflictLink.mp hQlink, hQcard⟩
    · simpa using hgQ
  calc
    (commonImmediateEvictorLinkLayer C e f r).card = X.card := rfl
    _ ≤ ((conflictLinkLayer C e 1).biUnion F).card :=
      Finset.card_le_card hsub
    _ ≤ ∑ G ∈ conflictLinkLayer C e 1, (F G).card :=
      Finset.card_biUnion_le
    _ = ∑ G ∈ conflictLinkLayer C e 1,
        codegree (conflictLinkLayer C f r) G := by rfl

theorem codegree_conflictLinkLayer_rank_one_root_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (f : Finset V) (r : ℕ)
    (hr2 : 2 ≤ r) (hr3 : r ≤ 3)
    (G : Hypergraph V) (hGcard : G.card = 1) :
    (codegree (conflictLinkLayer C f r) G : ℝ) ≤
      Real.rpow d ((r : ℝ) - 1 - eta) := by
  have h := common_codegree_conflictLinkLayer_le_rpow hB hd f r G
    (by omega) hr3 (by omega) (by omega)
  simpa [hGcard] using h

theorem card_commonImmediateEvictorLinkLayer_le_Gamma_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (e : Finset V) (he : e ∈ H) (f : Finset V)
    (r : ℕ) (hr2 : 2 ≤ r) (hr3 : r ≤ 3) :
    ((commonImmediateEvictorLinkLayer C e f r).card : ℝ) ≤
      Gamma * Real.rpow d ((r : ℝ) - eta) := by
  have hcover := card_commonImmediateEvictorLinkLayer_le_sum_codegrees
    C e f r
  have hG : ∀ G ∈ conflictLinkLayer C e 1,
      (codegree (conflictLinkLayer C f r) G : ℝ) ≤
        Real.rpow d ((r : ℝ) - 1 - eta) := by
    intro G hG
    exact codegree_conflictLinkLayer_rank_one_root_le_rpow
      hB hd f r hr2 hr3 G (mem_conflictLinkLayer.mp hG).2
  have heLink := common_card_conflictLinkLayer_le_Gamma_mul_rpow
    hB hd he (q := 1) (by omega) (by omega)
  norm_num at heLink
  have hscaleNonneg : 0 ≤ Real.rpow d ((r : ℝ) - 1 - eta) :=
    Real.rpow_nonneg hd.le _
  have hprod :
      d * Real.rpow d ((r : ℝ) - 1 - eta) =
        Real.rpow d ((1 : ℝ) + ((r : ℝ) - 1 - eta)) := by
    calc
      d * Real.rpow d ((r : ℝ) - 1 - eta) =
          Real.rpow d (1 : ℝ) *
            Real.rpow d ((r : ℝ) - 1 - eta) := by
        exact congrArg
          (fun z : ℝ ↦ z * Real.rpow d ((r : ℝ) - 1 - eta))
          (Real.rpow_one d).symm
      _ = Real.rpow d ((1 : ℝ) + ((r : ℝ) - 1 - eta)) :=
        (Real.rpow_add hd _ _).symm
  calc
    ((commonImmediateEvictorLinkLayer C e f r).card : ℝ) ≤
        (∑ G ∈ conflictLinkLayer C e 1,
          codegree (conflictLinkLayer C f r) G : ℕ) := by
      exact_mod_cast hcover
    _ = ∑ G ∈ conflictLinkLayer C e 1,
        (codegree (conflictLinkLayer C f r) G : ℝ) := by
      push_cast
      rfl
    _ ≤ ∑ _G ∈ conflictLinkLayer C e 1,
        Real.rpow d ((r : ℝ) - 1 - eta) := by
      apply Finset.sum_le_sum
      intro G hGmem
      exact hG G hGmem
    _ = ((conflictLinkLayer C e 1).card : ℝ) *
        Real.rpow d ((r : ℝ) - 1 - eta) := by simp
    _ ≤ (Gamma * d) *
        Real.rpow d ((r : ℝ) - 1 - eta) :=
      mul_le_mul_of_nonneg_right heLink hscaleNonneg
    _ = Gamma * Real.rpow d
        ((1 : ℝ) + ((r : ℝ) - 1 - eta)) := by
      rw [mul_assoc, hprod]
    _ = Gamma * Real.rpow d ((r : ℝ) - eta) := by
      congr 2
      ring

theorem codegree_commonImmediateEvictorLinkLayer_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (e f : Finset V) (r : ℕ)
    (hr2 : 2 ≤ r) (hr3 : r ≤ 3) (root : Hypergraph V)
    (hrootPos : 1 ≤ root.card) (hrootLt : root.card < r) :
    (codegree (commonImmediateEvictorLinkLayer C e f r) root : ℝ) ≤
      Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := by
  calc
    (codegree (commonImmediateEvictorLinkLayer C e f r) root : ℝ) ≤
        (codegree (conflictLinkLayer C f r) root : ℝ) := by
      exact_mod_cast codegree_mono_hypergraph
        (commonImmediateEvictorLinkLayer_subset_conflictLinkLayer C e f r)
        root
    _ ≤ Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) :=
      common_codegree_conflictLinkLayer_le_rpow hB hd f r root
        (by omega) hr3 hrootPos hrootLt

/-- Exact finite-parameter spread statement behind Lemma 6.3(vi).
The source's asymptotic `d^(r-eps/2)` scale follows by absorbing the
fixed `Gamma + 1`; no additional certificate field is used. -/
theorem commonImmediateEvictorLinkLayer_isRealSpread
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d) (e : Finset V) (he : e ∈ H) (f : Finset V)
    (r : ℕ) (hr2 : 2 ≤ r) (hr3 : r ≤ 3) :
    IsRealSpread (commonImmediateEvictorLinkLayer C e f r) r
      ((Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) d⁻¹ := by
  refine ⟨commonImmediateEvictorLinkLayer_uniform C e f r, ?_⟩
  intro root hrootLt
  have hGamma : 0 ≤ Gamma := common_regularizedBounded_Gamma_nonneg hB hd
  have hscaleNonneg : 0 ≤ Real.rpow d ((r : ℝ) - eta) :=
    Real.rpow_nonneg hd.le _
  by_cases hrootZero : root.card = 0
  · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
    subst root
    have hcard := card_commonImmediateEvictorLinkLayer_le_Gamma_rpow
      hB hd e he f r hr2 hr3
    calc
      (codegree (commonImmediateEvictorLinkLayer C e f r) ∅ : ℝ) =
          ((commonImmediateEvictorLinkLayer C e f r).card : ℝ) := by
        rw [codegree_empty]
      _ ≤ Gamma * Real.rpow d ((r : ℝ) - eta) := hcard
      _ ≤ (Gamma + 1) * Real.rpow d ((r : ℝ) - eta) := by
        nlinarith
      _ = ((Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) *
          d⁻¹ ^ (∅ : Hypergraph V).card := by simp
  · have hrootPos : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
    have hrootBound := codegree_commonImmediateEvictorLinkLayer_le_rpow
      hB hd e f r hr2 hr3 root hrootPos hrootLt
    have hinvPow : d⁻¹ ^ root.card =
        Real.rpow d (-(root.card : ℝ)) := by
      calc
        d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
        _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
          exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
        _ = Real.rpow d (-(root.card : ℝ)) :=
          (Real.rpow_neg hd.le _).symm
    have hrpowSplit :
        Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
          Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card := by
      rw [hinvPow]
      calc
        Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) =
            Real.rpow d (((r : ℝ) - eta) + (-(root.card : ℝ))) := by
          congr 1
          ring
        _ = Real.rpow d ((r : ℝ) - eta) *
            Real.rpow d (-(root.card : ℝ)) := Real.rpow_add hd _ _
    have hinvNonneg : 0 ≤ d⁻¹ ^ root.card :=
      pow_nonneg (inv_nonneg.mpr hd.le) _
    calc
      (codegree (commonImmediateEvictorLinkLayer C e f r) root : ℝ) ≤
          Real.rpow d ((r : ℝ) - (root.card : ℝ) - eta) := hrootBound
      _ = Real.rpow d ((r : ℝ) - eta) * d⁻¹ ^ root.card :=
        hrpowSplit
      _ ≤ ((Gamma + 1) * Real.rpow d ((r : ℝ) - eta)) *
          d⁻¹ ^ root.card := by
        apply mul_le_mul_of_nonneg_right _ hinvNonneg
        nlinarith

/-- Certificate-specialized public shape: the regularized system has
`Gamma' = 3*Gamma` and `eta = epsRaw/4`. -/
theorem commonImmediateEvictorLinkLayer_isRealSpread_of_certificate
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ) (publicJ : io → ℕ)
    (publicW : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert publicJ publicW)
    (hd : 0 < d) (e : Finset V) (he : e ∈ H) (f : Finset V)
    (r : ℕ) (hr2 : 2 ≤ r) (hr3 : r ≤ 3) :
    IsRealSpread
      (commonImmediateEvictorLinkLayer R.regularized e f r) r
      (((3 * Gamma) + 1) * Real.rpow d ((r : ℝ) - epsRaw / 4)) d⁻¹ := by
  exact commonImmediateEvictorLinkLayer_isRealSpread
    R.bounded hd e he f r hr2 hr3

attribute [local instance] Classical.propDecidable

/-! ## The source-exact vertex-local spread family

For a fixed root edge `e`, host vertex `v`, and link rank `q`, this is the
static family `Z_v` of source Definition 6.1(i): a link belongs to `Z_v` when
at least one of its host edges passes through `v`.  Crucially, that star edge
need not be the unique currently available member of the link.

For a selected `(q-1)`-set `S`, the chosen-set weight counts every member of
`Z_v` extending `S`.  Its selected-set total is monotone and dominates the
dynamic partial family `(Z_v)^[1]` without making the incorrect assumption
that the unique available member itself passes through `v`.
-/

def conflictFamilyShadowWeight
    (Z : ConflictSystem V) : TestWeight V :=
  fun S ↦ (Z.filter fun Q ↦ S ⊆ Q).card

@[simp] theorem conflictFamilyShadowWeight_eq_codegree
    (Z : ConflictSystem V) (S : Hypergraph V) :
    conflictFamilyShadowWeight Z S = (codegree Z S : ℝ) := by
  rfl

theorem conflictFamilyShadowWeight_nonneg
    (Z : ConflictSystem V) (S : Hypergraph V) :
    0 ≤ conflictFamilyShadowWeight Z S := by
  exact Nat.cast_nonneg _

theorem IsRealSpread.shadowWeight_le
    {Z : ConflictSystem V} {q : ℕ} {d₀ delta : ℝ}
    (hZ : IsRealSpread Z q d₀ delta)
    (S : Hypergraph V) (hS : S.card < q) :
    conflictFamilyShadowWeight Z S ≤ d₀ * delta ^ S.card := by
  exact hZ.2 S hS

theorem sum_shadow_singletons_eq
    [Fintype V] (Z : ConflictSystem V) (H : Hypergraph V) (q : ℕ)
    (hZ : IsUniform Z q) (hZH : ∀ Q ∈ Z, Q ⊆ H) :
    (∑ x ∈ H, conflictFamilyShadowWeight Z {x}) =
      (q : ℝ) * (Z.card : ℝ) := by
  have hNat : ∑ x ∈ H, degree Z x = q * Z.card := by
    rw [sum_degree_on_eq_sum_card_inter]
    calc
      (∑ Q ∈ Z, (H ∩ Q).card) = ∑ _Q ∈ Z, q := by
        apply Finset.sum_congr rfl
        intro Q hQ
        rw [Finset.inter_eq_right.mpr (hZH Q hQ), hZ Q hQ]
      _ = q * Z.card := by simp [Nat.mul_comm]
  calc
    (∑ x ∈ H, conflictFamilyShadowWeight Z {x}) =
        ∑ x ∈ H, (degree Z x : ℝ) := by
      apply Finset.sum_congr rfl
      intro x hx
      unfold conflictFamilyShadowWeight degree
      norm_cast
      apply congrArg Finset.card
      ext Q
      simp
    _ = (q : ℝ) * (Z.card : ℝ) := by exact_mod_cast hNat

def sourceConflictLinkInteractionExtensions
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) (v : V)
    (S : Hypergraph V) : ConflictSystem V :=
  (sourceConflictLinkInteractionAtVertex H C e q v).filter fun Q ↦ S ⊆ Q

def vertexLocalThroughSpreadWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) : TestWeight V :=
  conflictFamilyShadowWeight
    (sourceConflictLinkInteractionAtVertex H C e q v)

def normalizedVertexLocalThroughSpreadWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) (scale : ℝ) : TestWeight V :=
  fun S ↦
    (sourceConflictLinkInteractionExtensions H C e q v S).card / scale

def vertexLocalThroughSpreadMass
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) (M : Hypergraph V) : ℝ :=
  ∑ S ∈ M.powersetCard (q - 1),
    ((sourceConflictLinkInteractionExtensions H C e q v S).card : ℝ)

def vertexLocalThroughSpreadPartialFamily
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ)
    (A M : Hypergraph V) : ConflictSystem V :=
  partialFamily (sourceConflictLinkInteractionAtVertex H C e q v) A M 1

def vertexLocalThroughSpreadPartialMass
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ)
    (A M : Hypergraph V) : ℝ :=
  (vertexLocalThroughSpreadPartialFamily H C e v q A M).card

@[simp] theorem testTotal_vertexLocalThroughSpreadWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) (M : Hypergraph V) :
    testTotal (vertexLocalThroughSpreadWeight H C e v q) M (q - 1) =
      vertexLocalThroughSpreadMass H C e v q M := by
  rfl

theorem testTotal_normalizedVertexLocalThroughSpreadWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) (scale : ℝ)
    (M : Hypergraph V) :
    testTotal (normalizedVertexLocalThroughSpreadWeight
        H C e v q scale) M (q - 1) =
      vertexLocalThroughSpreadMass H C e v q M / scale := by
  unfold testTotal normalizedVertexLocalThroughSpreadWeight
    vertexLocalThroughSpreadMass
  rw [Finset.sum_div]

theorem vertexLocalThroughSpreadWeight_nonneg
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) (S : Hypergraph V) :
    0 ≤ vertexLocalThroughSpreadWeight H C e v q S := by
  unfold vertexLocalThroughSpreadWeight
  unfold conflictFamilyShadowWeight
  exact Nat.cast_nonneg _

theorem normalizedVertexLocalThroughSpreadWeight_nonneg
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ) {scale : ℝ}
    (hscale : 0 ≤ scale) (S : Hypergraph V) :
    0 ≤ normalizedVertexLocalThroughSpreadWeight H C e v q scale S := by
  exact div_nonneg (by positivity) hscale

/-- The source partial family `(Z_v)^[1]` injects into the incidence union
counted by the monotone chosen-set observable.  No partition assumption on
`A` and `M` is needed: its selected intersection already has cardinality
`q-1` by the definition of `partialFamily`. -/
theorem vertexLocalThroughSpreadPartialMass_le_mass
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (q : ℕ)
    (A M : Hypergraph V) :
    vertexLocalThroughSpreadPartialMass H C e v q A M ≤
      vertexLocalThroughSpreadMass H C e v q M := by
  let Z := sourceConflictLinkInteractionAtVertex H C e q v
  let I := M.powersetCard (q - 1)
  let F : Hypergraph V → ConflictSystem V := fun S ↦
    Z.filter fun Q ↦ S ⊆ Q
  have hsubset : partialFamily Z A M 1 ⊆ I.biUnion F := by
    intro Q hQ
    have hdata := mem_partialFamily.mp hQ
    have hQlink : Q ∈ conflictLinkLayer C e q := by
      exact (Finset.mem_filter.mp hdata.1).1
    have hQcard : Q.card = q := conflictLinkLayer_uniform C e q Q hQlink
    apply Finset.mem_biUnion.mpr
    refine ⟨Q ∩ M, ?_, ?_⟩
    · exact Finset.mem_powersetCard.mpr ⟨Finset.inter_subset_right,
        by simpa only [hQcard] using hdata.2.2⟩
    · exact Finset.mem_filter.mpr ⟨hdata.1, Finset.inter_subset_left⟩
  have hcard : (partialFamily Z A M 1).card ≤
      ∑ S ∈ I, (F S).card :=
    (Finset.card_le_card hsubset).trans Finset.card_biUnion_le
  change ((partialFamily Z A M 1).card : ℝ) ≤
    ∑ S ∈ I, ((F S).card : ℝ)
  exact_mod_cast hcard

/-- Tail-to-degree extractor: primary chosen-set upper corridors for q=2,3
give exactly the fixed-vertex source-partial cap consumed by the degree
bridge. -/
theorem sourceConflictLinkVertexCap_of_primaryChosenSetCaps
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (v : V) (cap : ℝ)
    (hprimary : ∀ e ∈ availableEdges H C M, v ∉ e →
      ∀ q, 2 ≤ q → q ≤ 3 →
        testTotal (vertexLocalThroughSpreadWeight H C e v q) M (q - 1) ≤
          cap) :
    ∀ e ∈ availableEdges H C M, v ∉ e →
      ∀ q, 2 ≤ q → q ≤ 3 →
        ((partialFamily
          (sourceConflictLinkInteractionAtVertex H C e q v)
          (availableEdges H C M) M 1).card : ℝ) ≤ cap := by
  intro e he hve q hq2 hq3
  exact (vertexLocalThroughSpreadPartialMass_le_mass
    H C e v q (availableEdges H C M) M).trans
      (by simpa only [testTotal_vertexLocalThroughSpreadWeight] using
        hprimary e he hve q hq2 hq3)

/-! ## Exact chosen-set derivatives in ranks one and two -/

def chosenSetDerivativeWeight (w : TestWeight V)
    (x : Finset V) : TestWeight V :=
  fun S ↦ if x ∈ S then 0 else w (insert x S)

def vertexLocalThroughSpreadDerivativeWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (x : Finset V) : TestWeight V :=
  chosenSetDerivativeWeight
    (vertexLocalThroughSpreadWeight H C e v 3) x

/-- Incidence bound for a uniform static family.  Once `y` is outside
`A`, a `q`-set containing `y` has at most `q-1` members in `A`. -/
theorem sum_shadow_pair_le
    [Fintype V]
    (Z : ConflictSystem V) (A : Hypergraph V)
    (q : ℕ) (hZ : IsUniform Z q) (y : Finset V) (hyA : y ∉ A) :
    (∑ x ∈ A, conflictFamilyShadowWeight Z (insert x {y})) ≤
      (q - 1 : ℕ) * conflictFamilyShadowWeight Z {y} := by
  let F : ConflictSystem V := Z.filter fun Q ↦ ({y} : Hypergraph V) ⊆ Q
  have hleft :
      (∑ x ∈ A, conflictFamilyShadowWeight Z (insert x {y})) =
        ∑ x ∈ A, (degree F x : ℝ) := by
    apply Finset.sum_congr rfl
    intro x hx
    unfold conflictFamilyShadowWeight degree
    norm_cast
    apply congrArg Finset.card
    ext Q
    simp only [Finset.mem_filter, F, Finset.singleton_subset_iff,
      Finset.insert_subset_iff]
    tauto
  have hright : conflictFamilyShadowWeight Z {y} = (F.card : ℝ) := by
    unfold conflictFamilyShadowWeight
    rfl
  have hincidence : (∑ x ∈ A, (degree F x : ℝ)) =
      ∑ Q ∈ F, ((A ∩ Q).card : ℝ) := by
    exact_mod_cast sum_degree_on_eq_sum_card_inter F A
  rw [hleft, hincidence, hright]
  calc
    (∑ Q ∈ F, ((A ∩ Q).card : ℝ)) ≤
        ∑ _Q ∈ F, ((q - 1 : ℕ) : ℝ) := by
      apply Finset.sum_le_sum
      intro Q hQ
      have hQZ : Q ∈ Z := (Finset.mem_filter.mp hQ).1
      have hyQ : y ∈ Q := by
        exact (Finset.mem_filter.mp hQ).2 (Finset.mem_singleton_self y)
      have hcard : (A ∩ Q).card ≤ q - 1 := by
        have hsub : A ∩ Q ⊆ Q.erase y := by
          intro z hz
          exact Finset.mem_erase.mpr
            ⟨fun hzy ↦ hyA (hzy ▸ (Finset.mem_inter.mp hz).1),
              (Finset.mem_inter.mp hz).2⟩
        have hle := Finset.card_le_card hsub
        rw [Finset.card_erase_of_mem hyQ, hZ Q hQZ] at hle
        omega
      exact_mod_cast hcard
    _ = ((q - 1 : ℕ) : ℝ) * (F.card : ℝ) := by
      simp [mul_comm]
    _ = ((q - 1 : ℕ) : ℝ) * conflictFamilyShadowWeight Z {y} := by
      rw [hright]

theorem sum_derivative_singletons_le
    [Fintype V]
    (Z : ConflictSystem V) (H : Hypergraph V)
    (q : ℕ) (hZ : IsUniform Z q) (x : Finset V) (hxH : x ∈ H) :
    (∑ y ∈ H,
        chosenSetDerivativeWeight (conflictFamilyShadowWeight Z) x {y}) ≤
      ((q - 1 : ℕ) : ℝ) * conflictFamilyShadowWeight Z {x} := by
  have hself :
      chosenSetDerivativeWeight (conflictFamilyShadowWeight Z) x {x} = 0 := by
    simp [chosenSetDerivativeWeight]
  have herase :
      (∑ y ∈ H.erase x,
          chosenSetDerivativeWeight
            (conflictFamilyShadowWeight Z) x {y}) =
        ∑ y ∈ H.erase x,
          conflictFamilyShadowWeight Z (insert y {x}) := by
    apply Finset.sum_congr rfl
    intro y hy
    have hyx : y ≠ x := (Finset.mem_erase.mp hy).1
    have hxy : x ∉ ({y} : Hypergraph V) := by
      simpa using hyx.symm
    simp [chosenSetDerivativeWeight, hxy, Finset.pair_comm]
  calc
    (∑ y ∈ H,
        chosenSetDerivativeWeight (conflictFamilyShadowWeight Z) x {y}) =
        (∑ y ∈ H.erase x,
          chosenSetDerivativeWeight
            (conflictFamilyShadowWeight Z) x {y}) +
          chosenSetDerivativeWeight
            (conflictFamilyShadowWeight Z) x {x} := by
      exact (Finset.sum_erase_add _ _ hxH).symm
    _ = ∑ y ∈ H.erase x,
          conflictFamilyShadowWeight Z (insert y {x}) := by
      rw [hself, add_zero, herase]
    _ ≤ ((q - 1 : ℕ) : ℝ) * conflictFamilyShadowWeight Z {x} :=
      sum_shadow_pair_le Z (H.erase x) q hZ x (by simp)

theorem testTotal_succ_insert_of_notMem
    (w : TestWeight V) (M : Hypergraph V) (x : Finset V)
    (hx : x ∉ M) (r : ℕ) :
    testTotal w (insert x M) (r + 1) =
      testTotal w M (r + 1) +
        ∑ S ∈ M.powersetCard r, w (insert x S) := by
  rw [testTotal, testTotal, show r + 1 = r.succ by omega,
    Finset.powersetCard_succ_insert hx]
  have hdisj : Disjoint (M.powersetCard r.succ)
      ((M.powersetCard r).image (insert x)) := by
    rw [Finset.disjoint_left]
    intro T hT hTi
    have hTM : T ⊆ M := (Finset.mem_powersetCard.mp hT).1
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hTi
    exact hx (hTM (Finset.mem_insert_self x S))
  rw [Finset.sum_union hdisj, Finset.sum_image]
  intro S hS T hT hST
  have hxS : x ∉ S := fun hxS ↦
    hx ((Finset.mem_powersetCard.mp hS).1 hxS)
  have hxT : x ∉ T := fun hxT ↦
    hx ((Finset.mem_powersetCard.mp hT).1 hxT)
  have := congrArg (Finset.erase · x) hST
  simpa [hxS, hxT] using this

theorem testTotal_one_eq_sum_singletons
    (w : TestWeight V) (M : Hypergraph V) :
    testTotal w M 1 = ∑ x ∈ M, w {x} := by
  rw [testTotal, Finset.powersetCard_one, Finset.sum_map]
  apply Finset.sum_congr rfl
  intro x hx
  rfl

/-! ## A one-sided chosen-set Freedman coordinate

Unlike a public trackable test, a local spread family may have small or even
zero total mass.  Thus only an upper corridor is introduced.  Its source
premises are the exact one-step chosen-set probability bound and a local
jump bound.  The raw second moment is then derived, rather than assumed,
from `E[X^2] ≤ J E[X]`.
-/

theorem testTotal_mono_of_nonneg
    (w : TestWeight V) {M M' : Hypergraph V} (j : ℕ)
    (hw : ∀ S, 0 ≤ w S) (hMM' : M ⊆ M') :
    testTotal w M j ≤ testTotal w M' j := by
  unfold testTotal
  exact Finset.sum_le_sum_of_subset_of_nonneg
    (Finset.powersetCard_mono hMM')
    (fun S _ _ ↦ hw S)

noncomputable def localSpreadRawStep
    (w : TestWeight V) (j : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  testTotal w M' j - testTotal w M j

theorem localSpreadRawStep_rank_one_insert
    (w : TestWeight V) (M : Hypergraph V) (x : Finset V)
    (hx : x ∉ M) :
    localSpreadRawStep w 1 M (insert x M) = w {x} := by
  unfold localSpreadRawStep
  rw [show 1 = 0 + 1 by omega,
    testTotal_succ_insert_of_notMem w M x hx 0]
  simp

theorem localSpreadRawStep_rank_two_insert
    (w : TestWeight V) (M : Hypergraph V) (x : Finset V)
    (hx : x ∉ M) :
    localSpreadRawStep w 2 M (insert x M) =
      testTotal (chosenSetDerivativeWeight w x) M 1 := by
  unfold localSpreadRawStep
  rw [show 2 = 1 + 1 by omega,
    testTotal_succ_insert_of_notMem w M x hx 1]
  simp only [add_sub_cancel_left]
  have hleft : (∑ S ∈ M.powersetCard 1, w (insert x S)) =
      ∑ y ∈ M, w (insert x {y}) := by
    simpa only [testTotal] using
      testTotal_one_eq_sum_singletons (fun S ↦ w (insert x S)) M
  rw [hleft, testTotal_one_eq_sum_singletons]
  apply Finset.sum_congr rfl
  intro y hy
  have hxy : x ∉ ({y} : Hypergraph V) := by
    simpa using fun hxy : x = y ↦ hx (hxy ▸ hy)
  simp [chosenSetDerivativeWeight, hxy]

theorem localSpreadRawStep_vertexLocal_rank_two_insert
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) (M : Hypergraph V) (x : Finset V)
    (hx : x ∉ M) :
    localSpreadRawStep
        (vertexLocalThroughSpreadWeight H C e v 3) 2 M (insert x M) =
      testTotal
        (vertexLocalThroughSpreadDerivativeWeight H C e v x) M 1 := by
  exact localSpreadRawStep_rank_two_insert
    (vertexLocalThroughSpreadWeight H C e v 3) M x hx

/-- The sharp rank-two mean uses the aggregate rank-one shadow.  It does
not replace the average by the maximum derivative, so it retains the
essential inverse-availability factor. -/
theorem greedyStepExpectation_localSpreadRawStep_rank_two_le_shadow
    [Fintype V]
    (Z : ConflictSystem V) (q : ℕ) (hZ : IsUniform Z q)
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (hA : (availableEdges H C M).Nonempty) :
    greedyStepExpectation H C M
        (localSpreadRawStep (conflictFamilyShadowWeight Z) 2 M) ≤
      ((q - 1 : ℕ) : ℝ) *
          testTotal (conflictFamilyShadowWeight Z) M 1 /
        ((availableEdges H C M).card : ℝ) := by
  let A := availableEdges H C M
  rw [greedyStepExpectation_eq_average H C M _ hA]
  have hnum :
      (∑ x ∈ A,
          localSpreadRawStep (conflictFamilyShadowWeight Z) 2 M
            (insert x M)) ≤
        ((q - 1 : ℕ) : ℝ) *
          testTotal (conflictFamilyShadowWeight Z) M 1 := by
    calc
      (∑ x ∈ A,
          localSpreadRawStep (conflictFamilyShadowWeight Z) 2 M
            (insert x M)) =
          ∑ x ∈ A, ∑ y ∈ M,
            conflictFamilyShadowWeight Z (insert x {y}) := by
        apply Finset.sum_congr rfl
        intro x hx
        have hxM : x ∉ M := (mem_availableEdges.mp hx).2.1
        rw [localSpreadRawStep_rank_two_insert _ M x hxM,
          testTotal_one_eq_sum_singletons]
        apply Finset.sum_congr rfl
        intro y hy
        have hxy : x ∉ ({y} : Hypergraph V) := by
          simpa using fun hxy : x = y ↦ hxM (hxy ▸ hy)
        simp [chosenSetDerivativeWeight, hxy]
      _ = ∑ y ∈ M, ∑ x ∈ A,
          conflictFamilyShadowWeight Z (insert x {y}) := by
        rw [Finset.sum_comm]
      _ ≤ ∑ y ∈ M, ((q - 1 : ℕ) : ℝ) *
          conflictFamilyShadowWeight Z {y} := by
        apply Finset.sum_le_sum
        intro y hy
        have hyA : y ∉ A := by
          intro hyA
          exact (mem_availableEdges.mp hyA).2.1 hy
        exact sum_shadow_pair_le Z A q hZ y hyA
      _ = ((q - 1 : ℕ) : ℝ) *
          testTotal (conflictFamilyShadowWeight Z) M 1 := by
        rw [testTotal_one_eq_sum_singletons, Finset.mul_sum]
  exact div_le_div_of_nonneg_right hnum (by positivity)

theorem greedyStepExpectation_localSpreadRawStep_rank_one_eq
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (hA : (availableEdges H C M).Nonempty) :
    greedyStepExpectation H C M (localSpreadRawStep w 1 M) =
      (∑ x ∈ availableEdges H C M, w {x}) /
        ((availableEdges H C M).card : ℝ) := by
  rw [greedyStepExpectation_eq_average H C M _ hA]
  congr 1
  apply Finset.sum_congr rfl
  intro x hx
  exact localSpreadRawStep_rank_one_insert w M x
    (mem_availableEdges.mp hx).2.1

theorem localSpreadRawStep_choice_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j : ℕ) (M : Hypergraph V) (hw : ∀ S, 0 ≤ w S)
    (o : GreedyChoice H) :
    0 ≤ localSpreadRawStep w j M (greedyChoiceStep H C M o) := by
  unfold localSpreadRawStep
  exact sub_nonneg.mpr (testTotal_mono_of_nonneg w j hw
    (subset_greedyChoiceStep H C M o))

/-- The Bernoulli/selected-set second-moment principle in the exact greedy
transition kernel.  Only states actually reached by a raw greedy choice need
lie in `[0,J]`. -/
theorem greedyStepExpectation_sq_le_jump_mul_mean_of_choice_window
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) {J mu : ℝ} (hJ : 0 ≤ J)
    (hwindow : ∀ o : GreedyChoice H,
      0 ≤ X (greedyChoiceStep H C M o) ∧
        X (greedyChoiceStep H C M o) ≤ J)
    (hmean : greedyStepExpectation H C M X ≤ mu) :
    greedyStepExpectation H C M (fun M' ↦ (X M') ^ 2) ≤ J * mu := by
  calc
    greedyStepExpectation H C M (fun M' ↦ (X M') ^ 2) ≤
        greedyStepExpectation H C M (fun M' ↦ J * X M') := by
      rw [greedyStepExpectation, greedyStepExpectation]
      apply Finset.sum_le_sum
      intro o _
      apply mul_le_mul_of_nonneg_left _
        (greedyTransitionMass_nonneg H C M o)
      have h := hwindow o
      nlinarith
    _ = J * greedyStepExpectation H C M X := by
      exact greedyStepExpectation_const_mul H C M J X
    _ ≤ J * mu := mul_le_mul_of_nonneg_left hmean hJ

noncomputable def localSpreadUpperError
    (w : TestWeight V) (j : ℕ) (cap : ℕ → ℝ)
    (k : ℕ) (M : Hypergraph V) : ℝ :=
  testTotal w M j - cap k

def localSpreadUpperCorridor
    (w : TestWeight V) (j : ℕ) (cap : ℕ → ℝ)
    (k : ℕ) (M : Hypergraph V) : Prop :=
  localSpreadUpperError w j cap k M < 0

noncomputable def localSpreadUpperStep
    (w : TestWeight V) (j : ℕ) (cap : ℕ → ℝ)
    (k : ℕ) (M M' : Hypergraph V) : ℝ :=
  localSpreadUpperError w j cap (k + 1) M' -
    localSpreadUpperError w j cap k M

theorem localSpreadUpperStep_eq_timeStep
    (w : TestWeight V) (j : ℕ) (cap : ℕ → ℝ)
    (k : ℕ) (M M' : Hypergraph V) :
    localSpreadUpperStep w j cap k M M' =
      greedyTimeStep (localSpreadUpperError w j cap) k M M' := by
  rfl

theorem not_localSpreadUpperCorridor_iff
    (w : TestWeight V) (j : ℕ) (cap : ℕ → ℝ)
    (k : ℕ) (M : Hypergraph V) :
    ¬ localSpreadUpperCorridor w j cap k M ↔
      0 ≤ localSpreadUpperError w j cap k M := by
  simp only [localSpreadUpperCorridor, not_lt]

/-- The complete local source obligations for a chosen-set upper corridor.
The predictable cap increment is both the drift allowance and the quantity
which enters the derived variance. -/
structure LocalSpreadUpperSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T j : ℕ)
    (cap jump : ℕ → ℝ) : Prop where
  weight_nonneg : ∀ S, 0 ≤ w S
  capStep_nonneg : ∀ k, 0 ≤ cap (k + 1) - cap k
  jump_nonneg : ∀ k, 0 ≤ jump k
  mean : ∀ k, k < T → ∀ M, Good k M →
    greedyStepExpectation H C M (localSpreadRawStep w j M) ≤
      cap (k + 1) - cap k
  rawJump : ∀ k, k < T → ∀ M, Good k M →
    ∀ o : GreedyChoice H,
      localSpreadRawStep w j M (greedyChoiceStep H C M o) ≤ jump k

/-- Closed rank-one constructor.  Its inputs are static host totals and
singleton caps, an availability floor, and scalar cap inequalities; the
conditional chosen-set mean and every raw choice jump are derived here. -/
theorem localSpreadUpperSourceBudgets_rank_one
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (cap jump availFloor : ℕ → ℝ) (total : ℝ)
    (hw : ∀ S, 0 ≤ w S)
    (hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k)
    (hjump0 : ∀ k, 0 ≤ jump k) (htotal0 : 0 ≤ total)
    (hfloorPos : ∀ k, k < T → 0 < availFloor k)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      availFloor k ≤ ((availableEdges H C M).card : ℝ))
    (hhostTotal : (∑ x ∈ H, w {x}) ≤ total)
    (hsingleton : ∀ k, k < T → ∀ x ∈ H, w {x} ≤ jump k)
    (hmeanScalar : ∀ k, k < T →
      total / availFloor k ≤ cap (k + 1) - cap k) :
    LocalSpreadUpperSourceBudgets w H C Good T 1 cap jump := by
  refine
    { weight_nonneg := hw
      capStep_nonneg := hcapStep
      jump_nonneg := hjump0
      mean := ?_
      rawJump := ?_ }
  · intro k hk M hgood
    have hfloor := hfloorPos k hk
    have havail := havailable k hk M hgood
    have hcardPos : 0 < ((availableEdges H C M).card : ℝ) :=
      hfloor.trans_le havail
    have hA : (availableEdges H C M).Nonempty := by
      exact Finset.card_pos.mp (by exact_mod_cast hcardPos)
    rw [greedyStepExpectation_localSpreadRawStep_rank_one_eq
      w H C M hA]
    have hsum : (∑ x ∈ availableEdges H C M, w {x}) ≤ total := by
      exact (Finset.sum_le_sum_of_subset_of_nonneg
        (availableEdges_subset H C M)
        (fun x _ _ ↦ hw {x})).trans hhostTotal
    calc
      (∑ x ∈ availableEdges H C M, w {x}) /
          ((availableEdges H C M).card : ℝ) ≤
          total / ((availableEdges H C M).card : ℝ) :=
        div_le_div_of_nonneg_right hsum hcardPos.le
      _ ≤ total / availFloor k := by
        exact div_le_div_of_nonneg_left htotal0 hfloor havail
      _ ≤ cap (k + 1) - cap k := hmeanScalar k hk
  · intro k hk M hgood o
    rcases o with _ | x
    · simp [greedyChoiceStep, localSpreadRawStep, hjump0 k]
    · by_cases hx : (x : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert hx,
          localSpreadRawStep_rank_one_insert]
        · exact hsingleton k hk x.1 (mem_availableEdges.mp hx).1
        · exact (mem_availableEdges.mp hx).2.1
      · rw [greedyChoiceStep, greedyStep_eq_self hx]
        simp [localSpreadRawStep, hjump0 k]

/-- Rank-one chosen-set budgets obtained directly from a static real-spread
family and an availability floor. -/
theorem localSpreadUpperSourceBudgets_rank_one_of_realSpread
    [Fintype V]
    (Z : ConflictSystem V) (q : ℕ) {d₀ delta : ℝ}
    (hZ : IsRealSpread Z q d₀ delta)
    (H : Hypergraph V) (hZH : ∀ Q ∈ Z, Q ⊆ H)
    (C : ConflictSystem V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (cap availFloor : ℕ → ℝ)
    (hq : 2 ≤ q) (hd₀ : 0 ≤ d₀) (hdelta : 0 ≤ delta)
    (hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k)
    (hfloorPos : ∀ k, k < T → 0 < availFloor k)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      availFloor k ≤ ((availableEdges H C M).card : ℝ))
    (hmeanScalar : ∀ k, k < T →
      ((q : ℝ) * d₀) / availFloor k ≤ cap (k + 1) - cap k) :
    LocalSpreadUpperSourceBudgets
      (conflictFamilyShadowWeight Z) H C Good T 1 cap
        (fun _ ↦ d₀ * delta) := by
  have hcard : (Z.card : ℝ) ≤ d₀ := by
    have hroot := hZ.shadowWeight_le (∅ : Hypergraph V)
      (by simpa using (lt_of_lt_of_le (by omega : 0 < 2) hq))
    simpa [conflictFamilyShadowWeight, codegree] using hroot
  apply localSpreadUpperSourceBudgets_rank_one
    (conflictFamilyShadowWeight Z) H C Good T cap
      (fun _ ↦ d₀ * delta) availFloor ((q : ℝ) * d₀)
  · exact conflictFamilyShadowWeight_nonneg Z
  · exact hcapStep
  · intro k
    exact mul_nonneg hd₀ hdelta
  · exact mul_nonneg (by positivity) hd₀
  · exact hfloorPos
  · exact havailable
  · rw [sum_shadow_singletons_eq Z H q hZ.1 hZH]
    exact mul_le_mul_of_nonneg_left hcard (by positivity)
  · intro k hk x hx
    have hsingle := hZ.shadowWeight_le ({x} : Hypergraph V) (by simp; omega)
    simpa using hsingle
  · exact hmeanScalar

/-- Fixed-choice q=3 derivative budgets obtained from the same static
spread family.  The derivative is zero on the self-singleton, so every
remaining jump is genuinely a two-root codegree. -/
theorem localSpreadUpperSourceBudgets_derivative_of_realSpread
    [Fintype V]
    (Z : ConflictSystem V) (q : ℕ) {d₀ delta : ℝ}
    (hZ : IsRealSpread Z q d₀ delta)
    (H : Hypergraph V) (x : Finset V) (hxH : x ∈ H)
    (C : ConflictSystem V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (cap availFloor : ℕ → ℝ)
    (hq : 3 ≤ q) (hd₀ : 0 ≤ d₀) (hdelta : 0 ≤ delta)
    (hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k)
    (hfloorPos : ∀ k, k < T → 0 < availFloor k)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      availFloor k ≤ ((availableEdges H C M).card : ℝ))
    (hmeanScalar : ∀ k, k < T →
      (((q - 1 : ℕ) : ℝ) * d₀ * delta) / availFloor k ≤
        cap (k + 1) - cap k) :
    LocalSpreadUpperSourceBudgets
      (chosenSetDerivativeWeight (conflictFamilyShadowWeight Z) x)
      H C Good T 1 cap (fun _ ↦ d₀ * delta ^ 2) := by
  apply localSpreadUpperSourceBudgets_rank_one
    (chosenSetDerivativeWeight (conflictFamilyShadowWeight Z) x)
      H C Good T cap (fun _ ↦ d₀ * delta ^ 2) availFloor
      (((q - 1 : ℕ) : ℝ) * d₀ * delta)
  · intro S
    unfold chosenSetDerivativeWeight
    split
    · norm_num
    · exact conflictFamilyShadowWeight_nonneg Z _
  · exact hcapStep
  · intro k
    exact mul_nonneg hd₀ (sq_nonneg delta)
  · exact mul_nonneg
      (mul_nonneg (by positivity) hd₀) hdelta
  · exact hfloorPos
  · exact havailable
  · calc
      (∑ y ∈ H,
          chosenSetDerivativeWeight
            (conflictFamilyShadowWeight Z) x {y}) ≤
          ((q - 1 : ℕ) : ℝ) * conflictFamilyShadowWeight Z {x} :=
        sum_derivative_singletons_le Z H q hZ.1 x hxH
      _ ≤ ((q - 1 : ℕ) : ℝ) * (d₀ * delta) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        have hsingle := hZ.shadowWeight_le ({x} : Hypergraph V) (by simp; omega)
        simpa using hsingle
      _ = ((q - 1 : ℕ) : ℝ) * d₀ * delta := by ring
  · intro k hk y hyH
    unfold chosenSetDerivativeWeight
    by_cases hxy : x ∈ ({y} : Hypergraph V)
    · simp only [mem_singleton, conflictFamilyShadowWeight_eq_codegree]
      exact mul_nonneg hd₀ (sq_nonneg delta)
    · rw [if_neg hxy]
      have hpairCard : (insert x ({y} : Hypergraph V)).card = 2 := by
        simp only [Finset.card_insert_of_notMem hxy, Finset.card_singleton]
      have hpair := hZ.shadowWeight_le
        (insert x ({y} : Hypergraph V)) (by rw [hpairCard]; omega)
      simpa [hpairCard, pow_two] using hpair
  · exact hmeanScalar

/-- Closed rank-two constructor.  The sharp mean is charged to the
aggregate rank-one shadow, while the choicewise jump is charged to the
fixed-choice derivative corridor.  These are the two auxiliary q=3
families required to avoid losing the inverse-availability factor. -/
theorem localSpreadUpperSourceBudgets_rank_two_shadow
    [Fintype V]
    (Z : ConflictSystem V) (q : ℕ) (hZ : IsUniform Z q)
    (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (cap jump availFloor aggregateCap : ℕ → ℝ)
    (hw : ∀ S, 0 ≤ conflictFamilyShadowWeight Z S)
    (hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k)
    (hjump0 : ∀ k, 0 ≤ jump k)
    (haggregate0 : ∀ k, 0 ≤ aggregateCap k)
    (hfloorPos : ∀ k, k < T → 0 < availFloor k)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      availFloor k ≤ ((availableEdges H C M).card : ℝ))
    (haggregate : ∀ k, k < T → ∀ M, Good k M →
      testTotal (conflictFamilyShadowWeight Z) M 1 ≤ aggregateCap k)
    (hderivative : ∀ k, k < T → ∀ M, Good k M →
      ∀ x ∈ availableEdges H C M,
        testTotal (chosenSetDerivativeWeight
          (conflictFamilyShadowWeight Z) x) M 1 ≤ jump k)
    (hmeanScalar : ∀ k, k < T →
      ((q - 1 : ℕ) : ℝ) * aggregateCap k / availFloor k ≤
        cap (k + 1) - cap k) :
    LocalSpreadUpperSourceBudgets
      (conflictFamilyShadowWeight Z) H C Good T 2 cap jump := by
  refine
    { weight_nonneg := hw
      capStep_nonneg := hcapStep
      jump_nonneg := hjump0
      mean := ?_
      rawJump := ?_ }
  · intro k hk M hgood
    have hfloor := hfloorPos k hk
    have havail := havailable k hk M hgood
    have hcardPos : 0 < ((availableEdges H C M).card : ℝ) :=
      hfloor.trans_le havail
    have hA : (availableEdges H C M).Nonempty := by
      exact Finset.card_pos.mp (by exact_mod_cast hcardPos)
    have hmean := greedyStepExpectation_localSpreadRawStep_rank_two_le_shadow
      Z q hZ H C M hA
    have hfactor : 0 ≤ ((q - 1 : ℕ) : ℝ) := by positivity
    have hagg := haggregate k hk M hgood
    calc
      greedyStepExpectation H C M
          (localSpreadRawStep (conflictFamilyShadowWeight Z) 2 M) ≤
          ((q - 1 : ℕ) : ℝ) *
              testTotal (conflictFamilyShadowWeight Z) M 1 /
            ((availableEdges H C M).card : ℝ) := hmean
      _ ≤ ((q - 1 : ℕ) : ℝ) * aggregateCap k /
            ((availableEdges H C M).card : ℝ) := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left hagg hfactor) hcardPos.le
      _ ≤ ((q - 1 : ℕ) : ℝ) * aggregateCap k / availFloor k := by
        exact div_le_div_of_nonneg_left
          (mul_nonneg hfactor (haggregate0 k)) hfloor havail
      _ ≤ cap (k + 1) - cap k := hmeanScalar k hk
  · intro k hk M hgood o
    rcases o with _ | x
    · simp [greedyChoiceStep, localSpreadRawStep, hjump0 k]
    · by_cases hx : (x : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert hx,
          localSpreadRawStep_rank_two_insert]
        · exact hderivative k hk M hgood x.1 hx
        · exact (mem_availableEdges.mp hx).2.1
      · rw [greedyChoiceStep, greedyStep_eq_self hx]
        simp [localSpreadRawStep, hjump0 k]

noncomputable def localSpreadVarianceBudget
    (cap jump : ℕ → ℝ) (k : ℕ) : ℝ :=
  2 * jump k * (cap (k + 1) - cap k) +
    2 * (cap (k + 1) - cap k) ^ 2

theorem localSpreadUpper_oneState_of_sourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T j : ℕ)
    (cap jump : ℕ → ℝ)
    (B : LocalSpreadUpperSourceBudgets w H C Good T j cap jump)
    {k : ℕ} (hk : k < T) {M : Hypergraph V} (hgood : Good k M) :
    greedyStepExpectation H C M (localSpreadUpperStep w j cap k M) ≤ 0 ∧
      greedyStepExpectation H C M (fun M' ↦
        (localSpreadUpperStep w j cap k M M') ^ 2) ≤
          localSpreadVarianceBudget cap jump k ∧
      (∀ o : GreedyChoice H,
        |localSpreadUpperStep w j cap k M
          (greedyChoiceStep H C M o)| ≤
            jump k + (cap (k + 1) - cap k)) := by
  let b := cap (k + 1) - cap k
  let X := localSpreadRawStep w j M
  have hb : 0 ≤ b := B.capStep_nonneg k
  have hJ : 0 ≤ jump k := B.jump_nonneg k
  have hwindow : ∀ o : GreedyChoice H,
      0 ≤ X (greedyChoiceStep H C M o) ∧
        X (greedyChoiceStep H C M o) ≤ jump k := by
    intro o
    exact ⟨localSpreadRawStep_choice_nonneg w H C j M
      B.weight_nonneg o, B.rawJump k hk M hgood o⟩
  have hmean : greedyStepExpectation H C M X ≤ b :=
    B.mean k hk M hgood
  have hrawSquare :
      greedyStepExpectation H C M (fun M' ↦ (X M') ^ 2) ≤
        jump k * b :=
    greedyStepExpectation_sq_le_jump_mul_mean_of_choice_window
      H C M X hJ hwindow hmean
  have hstep : localSpreadUpperStep w j cap k M =
      fun M' ↦ X M' - b := by
    funext M'
    dsimp [localSpreadUpperStep, localSpreadUpperError,
      localSpreadRawStep, X, b]
    ring
  rw [hstep]
  constructor
  · rw [show (fun M' ↦ X M' - b) =
        (fun M' ↦ X M' + (-b)) by funext M'; ring,
      greedyStepExpectation_affine]
    linarith
  · constructor
    · calc
        greedyStepExpectation H C M (fun M' ↦ (X M' - b) ^ 2) ≤
            greedyStepExpectation H C M
              (fun M' ↦ 2 * (X M') ^ 2 + 2 * b ^ 2) := by
          rw [greedyStepExpectation, greedyStepExpectation]
          apply Finset.sum_le_sum
          intro o _
          apply mul_le_mul_of_nonneg_left _
            (greedyTransitionMass_nonneg H C M o)
          nlinarith [sq_nonneg (X (greedyChoiceStep H C M o) + b)]
        _ = 2 * greedyStepExpectation H C M (fun M' ↦ (X M') ^ 2) +
              2 * b ^ 2 := by
          rw [greedyStepExpectation_add,
            greedyStepExpectation_const_mul, greedyStepExpectation_const]
        _ ≤ 2 * (jump k * b) + 2 * b ^ 2 := by linarith
        _ = localSpreadVarianceBudget cap jump k := by
          unfold localSpreadVarianceBudget
          dsimp only [b]
          ring
    · intro o
      have h := hwindow o
      rw [abs_le]
      constructor <;> nlinarith

theorem localSpreadVarianceBudget_nonneg_of_sourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T j : ℕ)
    (cap jump : ℕ → ℝ)
    (B : LocalSpreadUpperSourceBudgets w H C Good T j cap jump)
    (k : ℕ) : 0 ≤ localSpreadVarianceBudget cap jump k := by
  unfold localSpreadVarianceBudget
  exact add_nonneg
    (mul_nonneg (mul_nonneg (by norm_num) (B.jump_nonneg k))
      (B.capStep_nonneg k))
    (mul_nonneg (by norm_num) (sq_nonneg _))

theorem localSpreadUpperFirstFailureEvent_subset_tail
    {ι : Type*} [Fintype ι]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι)
    (j : ℕ) (cap : ℕ → ℝ) (t : ℝ)
    (hcomponent : ∀ k S, P i k S ↔
      localSpreadUpperCorridor w j cap k S)
    (hinitial : localSpreadUpperError w j cap 0 M ≤ -t) :
    greedyFirstFailureEvent H C M T P i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (localSpreadUpperStep w j cap)) T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hbad : 0 ≤ localSpreadUpperError w j cap (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    rw [← not_localSpreadUpperCorridor_iff]
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hfailure : ¬ indexedGreedyGood P (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    greedyStoppedStep_exit_imp_terminal_tail H C M T
      (indexedGreedyGood P) (localSpreadUpperStep w j cap)
      (localSpreadUpperError w j cap) omega hk hgood hfailure
      (fun _ _ ↦ rfl) hinitial hbad⟩

/-- Reusable one-coordinate tail.  Its only genuinely local inputs are the
chosen-set mean and jump fields bundled in `B`; all filtration, moment and
first-failure bookkeeping is discharged here. -/
theorem localSpreadUpperFirstFailureMass_le_of_sourceBudgets
    {ι : Type*} [Fintype ι]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι)
    (j : ℕ) (cap jump : ℕ → ℝ)
    (B : LocalSpreadUpperSourceBudgets
      w H C (indexedGreedyGood P) T j cap jump)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k, k < T → jump k + (cap (k + 1) - cap k) ≤ R)
    (hW : ∑ k ∈ Finset.range T,
        localSpreadVarianceBudget cap jump k ≤ W)
    (hcomponent : ∀ k S, P i k S ↔
      localSpreadUpperCorridor w j cap k S)
    (hinitial : localSpreadUpperError w j cap 0 M ≤ -t) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T P i) ≤
      Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  have htail : Freedman.eventMass (greedyPathMassFrom H C M)
      (Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (localSpreadUpperStep w j cap)) T omega)) ≤
      Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
    apply greedyStoppedStepIncrement_freedman H C M T
      (indexedGreedyGood P) (localSpreadUpperStep w j cap)
      (localSpreadVarianceBudget cap jump)
      (localSpreadVarianceBudget_nonneg_of_sourceBudgets
        w H C (indexedGreedyGood P) T j cap jump B)
    · intro k hk S hgood
      exact (localSpreadUpper_oneState_of_sourceBudgets
        w H C (indexedGreedyGood P) T j cap jump B hk hgood).1
    · intro k hk S hgood
      exact (localSpreadUpper_oneState_of_sourceBudgets
        w H C (indexedGreedyGood P) T j cap jump B hk hgood).2.1
    · exact hR0
    · exact ht
    · exact hW0
    · exact hden
    · apply greedyStoppedStepIncrement_abs_le_of_local
      · exact hR0
      · intro k hk S hgood o
        exact (localSpreadUpper_oneState_of_sourceBudgets
          w H C (indexedGreedyGood P) T j cap jump B hk hgood).2.2 o |>.trans
            (hR k hk)
    · exact hW
  exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
    (greedyPathMassFrom_nonneg H C M)
    (localSpreadUpperFirstFailureEvent_subset_tail
      w H C M T P i j cap t hcomponent hinitial)).trans htail

noncomputable def localSpreadStrongTail (eta d : ℝ) : ℝ :=
  Real.exp (-(10 * d ^ CFMNumeric.tailPower eta))

/-- Coefficient-ten conversion used for the larger local coordinate family.
The remaining scalar task for a concrete cap choice is exactly `hratio`. -/
theorem localSpreadStrongTail_of_freedman_ratio
    {eta d t denominator : ℝ}
    (_hden : 0 < denominator)
    (hratio : 10 * d ^ CFMNumeric.tailPower eta ≤
      t ^ 2 / (4 * denominator)) :
    Real.exp (-(t ^ 2) / (4 * denominator)) ≤
      localSpreadStrongTail eta d := by
  unfold localSpreadStrongTail
  apply Real.exp_le_exp.mpr
  rw [show -t ^ 2 / (4 * denominator) =
    -(t ^ 2 / (4 * denominator)) by ring]
  exact neg_le_neg hratio

/-! ## Finite coordinate-family aggregation

The two primary degree coordinates are retained separately below.  The
closed tail family also includes the q=3 aggregate rank-one shadow and one
fixed-choice derivative for every host edge.
-/

abbrev VertexLocalThroughSpreadTailKind (H : Hypergraph V) :=
  Fin 3 ⊕ {x : Finset V // x ∈ H}

abbrev VertexLocalThroughSpreadTailCoordinate (H : Hypergraph V) :=
  {e : Finset V // e ∈ H} × ActualHostVertex H ×
    VertexLocalThroughSpreadTailKind H

def vertexLocalThroughSpreadTailRank
    {H : Hypergraph V} (a : VertexLocalThroughSpreadTailCoordinate H) : ℕ :=
  match a.2.2 with
  | Sum.inl z => if z.1 = 2 then 2 else 1
  | Sum.inr _ => 1

noncomputable def vertexLocalThroughSpreadTailBaseWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (a : VertexLocalThroughSpreadTailCoordinate H) : TestWeight V :=
  match a.2.2 with
  | Sum.inl z =>
      if z.1 = 0 then
        vertexLocalThroughSpreadWeight H C a.1.1 a.2.1.1 2
      else
        vertexLocalThroughSpreadWeight H C a.1.1 a.2.1.1 3
  | Sum.inr x =>
      vertexLocalThroughSpreadDerivativeWeight
        H C a.1.1 a.2.1.1 x.1

noncomputable def vertexLocalThroughSpreadTailWeight
    (H : Hypergraph V) (C : ConflictSystem V)
    (scale : VertexLocalThroughSpreadTailCoordinate H → ℝ)
    (a : VertexLocalThroughSpreadTailCoordinate H) : TestWeight V :=
  fun S ↦ vertexLocalThroughSpreadTailBaseWeight H C a S / scale a

theorem card_vertexLocalThroughSpreadTailCoordinate [Fintype V]
    (H : Hypergraph V) :
    Fintype.card (VertexLocalThroughSpreadTailCoordinate H) =
      H.card * (vertexFinset H).card * (3 + H.card) := by
  change Fintype.card ({e : Finset V // e ∈ H} ×
      ({v : V // v ∈ vertexFinset H} ×
        (Fin 3 ⊕ {x : Finset V // x ∈ H}))) =
    H.card * (vertexFinset H).card * (3 + H.card)
  simp only [Fintype.card_prod, Fintype.card_coe, Fintype.card_sum,
    Fintype.card_fin]
  exact (Nat.mul_assoc _ _ _).symm

/-- The primary/aggregate/fixed-choice derivative family has entropy
exponent eighteen.  This is the degree-through-vertex family only. -/
theorem vertexLocalThroughSpreadTailCoordinate_card_le_entropy
    [Fintype V] {eta Gamma d : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (hvertex : ((vertexFinset H).card : ℝ) ≤
      Real.exp (d ^ (eta ^ 3))) :
    (Fintype.card (VertexLocalThroughSpreadTailCoordinate H) : ℝ) ≤
      Real.exp (18 * d ^ (eta ^ 3)) := by
  let a := d ^ (eta ^ 3)
  have ha0 : 0 ≤ a :=
    Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have hhost : (H.card : ℝ) ≤ Real.exp (8 * a) := by
    calc
      (H.card : ℝ) ≤ (((vertexFinset H).card : ℝ) ^ (8 : ℕ)) := by
        exact_mod_cast
          CFMNumericAggregation.host_card_le_vertex_pow_eight H hH
      _ ≤ (Real.exp a) ^ (8 : ℕ) := by
        exact pow_le_pow_left₀ (Nat.cast_nonneg _) hvertex 8
      _ = Real.exp (8 * a) := by
        rw [← Real.exp_nat_mul]
        norm_num
  by_cases hHempty : H = ∅
  · rw [card_vertexLocalThroughSpreadTailCoordinate, hHempty]
    simp only [Finset.card_empty, Nat.cast_zero, zero_mul]
    exact Real.exp_nonneg _
  · have hHoneNat : 1 ≤ H.card := Finset.one_le_card.mpr (Finset.nonempty_iff_ne_empty.mpr hHempty)
    have hfactorNat : 3 + H.card ≤ 4 * H.card := by omega
    have hfactor : 3 + (H.card : ℝ) ≤ Real.exp (9 * a) := by
      calc
        3 + (H.card : ℝ) ≤ (4 * H.card : ℕ) := by
          exact_mod_cast hfactorNat
        _ = 4 * (H.card : ℝ) := by norm_num
        _ ≤ 4 * Real.exp (8 * a) := by gcongr
        _ ≤ 9 * Real.exp (8 * a) := by
          gcongr
          norm_num
        _ ≤ Real.exp (9 * a) :=
          CFMNumericAggregation.nine_mul_exp_eight_le_exp_nine
            S.stopExponentFloor
    rw [card_vertexLocalThroughSpreadTailCoordinate]
    push_cast
    calc
      (H.card : ℝ) * ((vertexFinset H).card : ℝ) *
          (3 + (H.card : ℝ)) ≤
          Real.exp (8 * a) * Real.exp a * Real.exp (9 * a) := by
        gcongr
      _ = Real.exp (18 * a) := by
        rw [← Real.exp_add, ← Real.exp_add]
        congr 1
        ring

theorem CFMNumeric.CoreCutoffSpec.localSpreadStrongFailureBudget
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    24 * (18 * d ^ (eta ^ 3)) ≤
        10 * d ^ CFMNumeric.tailPower eta ∧
      4 * Real.log 12 ≤ 10 * d ^ CFMNumeric.tailPower eta := by
  have htail0 : 0 ≤ d ^ CFMNumeric.tailPower eta :=
    Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  constructor
  · calc
      24 * (18 * d ^ (eta ^ 3)) =
          9 * (48 * d ^ (eta ^ 3)) := by ring
      _ ≤ 9 * d ^ CFMNumeric.tailPower eta := by
        gcongr
        exact S.entropyPower
      _ ≤ 10 * d ^ CFMNumeric.tailPower eta := by nlinarith
  · exact S.entropyLog.trans (by nlinarith)

/-- A coefficient-ten pointwise tail absorbs the exponent-eighteen local
family, even after overcounting the one-sided family by a factor two. -/
theorem localSpreadStrongTailFamilySum_le_sixth
    {I : Type*} [Fintype I] {eta Gamma d : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (t : I → ℝ)
    (hcard : (Fintype.card I : ℝ) ≤
      Real.exp (18 * d ^ (eta ^ 3)))
    (ht : ∀ i, t i ≤ localSpreadStrongTail eta d) :
    2 * (∑ i, t i) ≤ 1 / 6 := by
  let x := 10 * d ^ CFMNumeric.tailPower eta
  let y := 18 * d ^ (eta ^ 3)
  have hy0 : 0 ≤ y := by
    exact mul_nonneg (by norm_num)
      (Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _)
  have hbudget := S.localSpreadStrongFailureBudget
  have hlogpos : 0 < Real.log 12 := Real.log_pos (by norm_num)
  have hxpos : 0 < x := by
    have := hbudget.2
    nlinarith
  have hgap : y - x ≤ -Real.log 12 := by
    dsimp only [x, y]
    nlinarith [hbudget.1, hbudget.2]
  have hexp : Real.exp (y - x) ≤ 1 / 12 := by
    calc
      Real.exp (y - x) ≤ Real.exp (-Real.log 12) :=
        Real.exp_le_exp.mpr hgap
      _ = 1 / 12 := by
        rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 12)]
        norm_num
  apply CFMNumeric.pairedFamilySum_le_sixth x y t hcard
  · intro i
    simpa only [localSpreadStrongTail, x] using ht i
  · exact hexp

/-- Pointwise first-failure tail for the closed primary/aggregate/derivative
coordinate family.  A later finite union bound only needs its exact card,
proved above. -/
theorem vertexLocalThroughSpreadTailFamily_firstFailureMass_le
    [Fintype V] {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop)
    (coordinate : VertexLocalThroughSpreadTailCoordinate H → ι)
    (scale : VertexLocalThroughSpreadTailCoordinate H → ℝ)
    (cap jump : VertexLocalThroughSpreadTailCoordinate H → ℕ → ℝ)
    (R t W : VertexLocalThroughSpreadTailCoordinate H → ℝ)
    (hsource : ∀ a, LocalSpreadUpperSourceBudgets
      (vertexLocalThroughSpreadTailWeight H C scale a)
      H C (indexedGreedyGood P) T
      (vertexLocalThroughSpreadTailRank a) (cap a) (jump a))
    (hR0 : ∀ a, 0 ≤ R a) (ht : ∀ a, 0 ≤ t a)
    (hW0 : ∀ a, 0 ≤ W a)
    (hden : ∀ a, 0 < W a + R a * t a)
    (hR : ∀ a k, k < T →
      jump a k + (cap a (k + 1) - cap a k) ≤ R a)
    (hW : ∀ a, ∑ k ∈ Finset.range T,
      localSpreadVarianceBudget (cap a) (jump a) k ≤ W a)
    (hcomponent : ∀ a k S, P (coordinate a) k S ↔
      localSpreadUpperCorridor
        (vertexLocalThroughSpreadTailWeight H C scale a)
        (vertexLocalThroughSpreadTailRank a) (cap a) k S)
    (hinitial : ∀ a, localSpreadUpperError
      (vertexLocalThroughSpreadTailWeight H C scale a)
      (vertexLocalThroughSpreadTailRank a) (cap a) 0 M ≤ -t a) :
    ∀ a, Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T P (coordinate a)) ≤
      Real.exp (-((t a) ^ 2) / (4 * (W a + R a * t a))) := by
  intro a
  exact localSpreadUpperFirstFailureMass_le_of_sourceBudgets
    (vertexLocalThroughSpreadTailWeight H C scale a)
    H C M T P (coordinate a)
    (vertexLocalThroughSpreadTailRank a) (cap a) (jump a)
    (hsource a) (hR0 a) (ht a) (hW0 a) (hden a)
    (hR a) (hW a) (hcomponent a) (hinitial a)

end

end Erdos136

namespace Erdos136

open Finset Real
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V]

/-! ## Concrete degree-through-vertex scales

The static source family has spread scale `d^(q-5*epsilon/4)`, where
`epsilon = coreEpsilon eta`.  The two auxiliary margins deliberately use
the stronger exponent `3*epsilon/4`; this leaves enough room both for the
inverse-availability drift and for the primary rank-two coordinate.
-/

noncomputable def localSpreadAvailableFloor
    (eta d N : ℝ) : ℝ :=
  N * CFMNumeric.trajectoryFloor eta d *
      Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 16

noncomputable def localSpreadSmallJump (eta d : ℝ) : ℝ :=
  Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4)

noncomputable def localSpreadAggregateJump (eta d : ℝ) : ℝ :=
  Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4)

noncomputable def localSpreadDerivativeMargin (eta d : ℝ) : ℝ :=
  Real.rpow d (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16

noncomputable def localSpreadAggregateMargin (eta d : ℝ) : ℝ :=
  Real.rpow d (2 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16

noncomputable def localSpreadPrimaryMargin (eta d : ℝ) : ℝ :=
  Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) / 16

noncomputable def localSpreadSmallDrift
    (eta d N : ℝ) : ℝ :=
  3 * Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) /
    localSpreadAvailableFloor eta d N

noncomputable def localSpreadAggregateDrift
    (eta d N : ℝ) : ℝ :=
  3 * Real.rpow d (3 - 5 * CFMNumeric.coreEpsilon eta / 4) /
    localSpreadAvailableFloor eta d N

noncomputable def localSpreadLinearCap
    (margin drift : ℝ) (k : ℕ) : ℝ :=
  margin + (k : ℝ) * drift

noncomputable def localSpreadDerivativeCap
    (eta d N : ℝ) : ℕ → ℝ :=
  localSpreadLinearCap (localSpreadDerivativeMargin eta d)
    (localSpreadSmallDrift eta d N)

noncomputable def localSpreadAggregateCap
    (eta d N : ℝ) : ℕ → ℝ :=
  localSpreadLinearCap (localSpreadAggregateMargin eta d)
    (localSpreadAggregateDrift eta d N)

noncomputable def localSpreadQ2PrimaryCap
    (eta d N : ℝ) : ℕ → ℝ :=
  localSpreadLinearCap (localSpreadPrimaryMargin eta d)
    (localSpreadSmallDrift eta d N)

noncomputable def localSpreadQ3PrimaryDrift
    (eta d N : ℝ) (T : ℕ) : ℝ :=
  2 * localSpreadAggregateCap eta d N T /
    localSpreadAvailableFloor eta d N

noncomputable def localSpreadQ3PrimaryCap
    (eta d N : ℝ) (T : ℕ) : ℕ → ℝ :=
  localSpreadLinearCap (localSpreadPrimaryMargin eta d)
    (localSpreadQ3PrimaryDrift eta d N T)

theorem localSpreadLinearCap_step
    (margin drift : ℝ) (k : ℕ) :
    localSpreadLinearCap margin drift (k + 1) -
        localSpreadLinearCap margin drift k = drift := by
  unfold localSpreadLinearCap
  push_cast
  ring

theorem CFMNumeric.CoreCutoffSpec.envelopeFifth_pow
    {eta Gamma d : ℝ} (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (n : ℕ) :
    (5 : ℝ) ^ n ≤
      Real.rpow d ((n : ℝ) * CFMNumeric.coreEpsilon eta / 64) := by
  have hd0 : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hpow := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 5)
    S.envelopeFifth n
  calc
    (5 : ℝ) ^ n ≤ (Real.rpow d
        (CFMNumeric.coreEpsilon eta / 64)) ^ n := hpow
    _ = Real.rpow d
        ((n : ℝ) * CFMNumeric.coreEpsilon eta / 64) := by
      calc
        (Real.rpow d (CFMNumeric.coreEpsilon eta / 64)) ^ n =
            Real.rpow (Real.rpow d
              (CFMNumeric.coreEpsilon eta / 64)) (n : ℝ) := by
          exact (Real.rpow_natCast _ n).symm
        _ = Real.rpow d
            ((CFMNumeric.coreEpsilon eta / 64) * (n : ℝ)) := by
