    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot3 : root.card ≤ 3) :
    weightedGainCollisionResidualFullNonemptySourceRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized j r root ≤
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (-(1 + eps / 10)) := by
  let scale := certificateInternalLayerScale
    H C d eps Gamma ell testJ testW Rcert (j + 1)
  let w := conflictLinkTestWeight Rcert.regularized f₀ j
  have hP :=
    Erdos136.RegularizationCertificate.internalLink_hasGainCollisionResidualProperSourceBounds
      Rcert hd heps f₀ hf₀H j hj1 hj3
  have hscale0 : 0 ≤ scale :=
    (certificateInternalLayerScale_pos
      H C d eps Gamma ell testJ testW Rcert (j + 1)
        (by linarith)).le
  have hraw :=
    weightedGainCollisionResidualFullNonemptySourceRootMass_le_raw_three_of_properSourceBounds
      (r := r) hP hd (by norm_num)
        (mul_nonneg (by norm_num) hscale0) hj3 root hrootH hroot3
  have hGamma : 0 ≤ 3 * Gamma :=
    regularizedBounded_Gamma_nonneg Rcert.bounded (by linarith : 0 < d)
  have hcoef : 72 ≤ Real.rpow d (eps / 10) := by
    apply le_trans (b := 72 * (3 * Gamma + 1))
    · nlinarith
    · exact hcutoff
  have hpow0 := Real.rpow_nonneg
    (by linarith : 0 ≤ d) (-(1 + eps / 5))
  change weightedGainCollisionResidualFullNonemptySourceRootMass
      w H Rcert.regularized j r root ≤
    scale * Real.rpow d (-(1 + eps / 10))
  have hraw' : weightedGainCollisionResidualFullNonemptySourceRootMass
      w H Rcert.regularized j r root ≤
      72 * scale * Real.rpow d (-(1 + eps / 5)) := by
    convert hraw using 1 <;> dsimp only [w, scale] <;> ring
  apply hraw'.trans
  calc
    72 * scale * Real.rpow d (-(1 + eps / 5)) ≤
        Real.rpow d (eps / 10) * scale *
          Real.rpow d (-(1 + eps / 5)) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hcoef hscale0) hpow0
    _ = scale * Real.rpow d (-(1 + eps / 10)) := by
      calc
        Real.rpow d (eps / 10) * scale *
            Real.rpow d (-(1 + eps / 5)) =
          scale * (Real.rpow d (eps / 10) *
            Real.rpow d (-(1 + eps / 5))) := by ring
        _ = scale * Real.rpow d (eps / 10 + (-(1 + eps / 5))) := by
          congr 1
          exact (Real.rpow_add (by linarith : 0 < d) _ _).symm
        _ = scale * Real.rpow d (-(1 + eps / 10)) := by
          congr 2
          ring

/-- Whole truncated rooted estimate for proper roots.  The coefficient
three is one nonfull unit plus at most two units from the full boundary. -/
theorem RegularizationCertificate.weightedF0TruncatedGainCollisionResidualRootMass_le
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 72 * (3 * Gamma + 1) ≤ Real.rpow d (eps / 10))
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hr5 : r ≤ 5)
    (root : Hypergraph V) (hrootCard : root.card < r - 2) :
    weightedF0TruncatedGainCollisionResidualRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      3 * certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d
          ((r : ℝ) - (j : ℝ) - eps / 10 - (root.card : ℝ)) := by
  let scale := certificateInternalLayerScale
    H C d eps Gamma ell testJ testW Rcert (j + 1)
  let w := conflictLinkTestWeight Rcert.regularized f₀ j
  have hP :=
    Erdos136.RegularizationCertificate.internalLink_hasGainCollisionResidualProperSourceBounds
      Rcert hd heps f₀ hf₀H j hj1 hj3
  have hscale0 : 0 ≤ scale :=
    (certificateInternalLayerScale_pos
      H C d eps Gamma ell testJ testW Rcert (j + 1)
        (by linarith)).le
  have hweight0 := conflictLinkTestWeight_nonneg_sharp
    Rcert.regularized f₀ j
  let E : ℝ := (r : ℝ) - (j : ℝ) - eps / 10 - (root.card : ℝ)
  have htarget0 : 0 ≤ scale * Real.rpow d E :=
    mul_nonneg hscale0 (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
  by_cases hrootH : root ⊆ H
  · by_cases hjr : j ≤ r
    · have hroot2 : root.card ≤ 2 := by omega
      have hdecomp :=
        weightedF0TruncatedGainCollisionResidualRootMass_le_fourParts
          hweight0 H Rcert.regularized f₀ j r root
      have hnonNat :=
        Erdos136.RegularizationCertificate.internalGainCollisionResidualNonFullRootMass_le_scale
          Rcert (r := r) hd heps hcutoff hf₀H hj1 hj3 root hrootH hroot2
      have hnon : weightedGainCollisionResidualNonFullRootMass
          w H Rcert.regularized j r root ≤ scale * Real.rpow d E := by
        have hexp :
            (r : ℝ) - (j : ℝ) - (root.card : ℝ) - eps / 10 = E := by
          dsimp only [E]
          ring
        simpa only [w, scale, Nat.cast_sub hjr, hexp] using hnonNat
      by_cases hrootZero : root.card = 0
      · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
        subst root
        have hfullZero :=
          weightedGainCollisionResidualFullRootMass_empty_eq_zero_of_properSourceBounds
            (r := r) hP
        have hnonemptyZero :
            weightedGainCollisionResidualFullNonemptySourceRootMass
              w H Rcert.regularized j r ∅ = 0 := by
          apply weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
            w H Rcert.regularized j r hj3 ∅
          simp
        have hemptyZero :
            weightedGainCollisionResidualFullEmptySourceRootMass
              w H Rcert.regularized j r ∅ = 0 := by
          rw [weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty,
            hnonemptyZero, add_zero] at hfullZero
          exact hfullZero
        have hproper0 :=
          (weightedF0TruncatedFullEmptyProperSourceRootMass_le_unfiltered
            hweight0 H Rcert.regularized f₀ j r ∅).trans_eq hemptyZero
        have hcard0 :=
          (weightedF0TruncatedFullCardRootMass_le_unfilteredFullEmpty
            hweight0 H Rcert.regularized f₀ j r ∅).trans_eq hemptyZero
        change weightedF0TruncatedGainCollisionResidualRootMass
            w H Rcert.regularized f₀ j r ∅ ≤ 3 * scale * Real.rpow d E
        apply hdecomp.trans
        nlinarith
      · have hroot1 : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
        by_cases hemptyRank : root.card = r - j
        · have hnonemptyZero :
              weightedGainCollisionResidualFullNonemptySourceRootMass
                w H Rcert.regularized j r root = 0 := by
            apply weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
              w H Rcert.regularized j r hj3 root
            omega
          have hproperRaw :=
            Erdos136.RegularizationCertificate.internalF0TruncatedFullEmptyProperSourceRootMass_le_scale
              Rcert (r := r) hd heps hcutoff hf₀H hj1 hj3 root hrootH hroot1
          have hproper :
              weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
                  w H Rcert.regularized f₀ j r root ≤
                scale * Real.rpow d E := by
            apply hproperRaw.trans_eq
            congr 1
            dsimp only [E]
            rw [hemptyRank, Nat.cast_sub hjr]
            ring_nf
          have hcutoff12 : 12 ≤ Real.rpow d (eps / 10) := by
            have hGamma : 0 ≤ 3 * Gamma :=
              regularizedBounded_Gamma_nonneg Rcert.bounded
                (by linarith : 0 < d)
            exact (by nlinarith : 12 ≤ 72 * (3 * Gamma + 1)).trans hcutoff
          have hcardRaw :=
            Erdos136.RegularizationCertificate.weightedF0TruncatedFullCardRootMass_le_scale
              Rcert (r := r) hd heps hcutoff12 hf₀H
                (Finset.mem_Icc.mpr ⟨hj1, hj3⟩)
                root hrootH hroot1 hroot2
          have hcard :
              weightedF0TruncatedGainCollisionResidualFullCardRootMass
                  w H Rcert.regularized f₀ j r root ≤
                scale * Real.rpow d E := by
            apply hcardRaw.trans_eq
            congr 1
            dsimp only [E]
            rw [hemptyRank, Nat.cast_sub hjr]
            ring_nf
          change weightedF0TruncatedGainCollisionResidualRootMass
              w H Rcert.regularized f₀ j r root ≤
            3 * scale * Real.rpow d E
          apply hdecomp.trans
          rw [hnonemptyZero]
          nlinarith
        · by_cases hnonemptyRank : root.card = r - j + 1
          · have hemptyZero :=
              weightedGainCollisionResidualFullEmptySourceRootMass_eq_zero_of_card_ne
                w H Rcert.regularized j r root hemptyRank
            have hproper0 :=
              (weightedF0TruncatedFullEmptyProperSourceRootMass_le_unfiltered
                hweight0 H Rcert.regularized f₀ j r root).trans_eq hemptyZero
            have hcard0 :=
              (weightedF0TruncatedFullCardRootMass_le_unfilteredFullEmpty
                hweight0 H Rcert.regularized f₀ j r root).trans_eq hemptyZero
            have hfullRaw :=
              Erdos136.RegularizationCertificate.internalGainCollisionResidualFullNonemptySourceRootMass_le_scale
                Rcert (r := r) hd heps hcutoff hf₀H hj1 hj3 root hrootH hroot2
            have hfull :
                weightedGainCollisionResidualFullNonemptySourceRootMass
                    w H Rcert.regularized j r root ≤
                  scale * Real.rpow d E := by
              apply hfullRaw.trans_eq
              congr 1
              dsimp only [E]
              rw [hnonemptyRank, Nat.cast_add, Nat.cast_one,
                Nat.cast_sub hjr]
              ring_nf
            change weightedF0TruncatedGainCollisionResidualRootMass
                w H Rcert.regularized f₀ j r root ≤
              3 * scale * Real.rpow d E
            apply hdecomp.trans
            nlinarith
          · have hemptyZero :=
              weightedGainCollisionResidualFullEmptySourceRootMass_eq_zero_of_card_ne
                w H Rcert.regularized j r root hemptyRank
            have hnonemptyZero :=
              weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
                w H Rcert.regularized j r hj3 root hnonemptyRank
            have hproper0 :=
              (weightedF0TruncatedFullEmptyProperSourceRootMass_le_unfiltered
                hweight0 H Rcert.regularized f₀ j r root).trans_eq hemptyZero
            have hcard0 :=
              (weightedF0TruncatedFullCardRootMass_le_unfilteredFullEmpty
                hweight0 H Rcert.regularized f₀ j r root).trans_eq hemptyZero
            change weightedF0TruncatedGainCollisionResidualRootMass
                w H Rcert.regularized f₀ j r root ≤
              3 * scale * Real.rpow d E
            apply hdecomp.trans
            rw [hnonemptyZero]
            nlinarith
    · have hrj : r < j := by omega
      have hmono := weightedF0TruncatedGainCollisionResidualRootMass_le_unfiltered
        hweight0 H Rcert.regularized f₀ j r root
      rw [weightedGainCollisionResidualRootMass_eq_zero_of_rank_lt_source
        w H Rcert.regularized j r root hrj] at hmono
      change weightedF0TruncatedGainCollisionResidualRootMass
          w H Rcert.regularized f₀ j r root ≤
        3 * scale * Real.rpow d E
      exact hmono.trans (by nlinarith)
  · have hmono := weightedF0TruncatedGainCollisionResidualRootMass_le_unfiltered
      hweight0 H Rcert.regularized f₀ j r root
    rw [weightedGainCollisionResidualRootMass_eq_zero_of_not_subset_host
      w H Rcert.regularized j r root hrootH] at hmono
    change weightedF0TruncatedGainCollisionResidualRootMass
        w H Rcert.regularized f₀ j r root ≤
      3 * scale * Real.rpow d E
    exact hmono.trans (by nlinarith)

/-- Exact constant-one endpoint at the full active residual rank. -/
theorem RegularizationCertificate.weightedF0TruncatedGainCollisionResidualRootMass_le_of_fullRank
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 72 * (3 * Gamma + 1) ≤ Real.rpow d (eps / 10))
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hr2 : 2 ≤ r) (hr5 : r ≤ 5)
    (root : Hypergraph V) (hrootCard : root.card = r - 2) :
    weightedF0TruncatedGainCollisionResidualRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (2 - (j : ℝ) - eps / 10) := by
  let scale := certificateInternalLayerScale
    H C d eps Gamma ell testJ testW Rcert (j + 1)
  let w := conflictLinkTestWeight Rcert.regularized f₀ j
  have hP :=
    Erdos136.RegularizationCertificate.internalLink_hasGainCollisionResidualProperSourceBounds
      Rcert hd heps f₀ hf₀H j hj1 hj3
  have hscale0 : 0 ≤ scale :=
    (certificateInternalLayerScale_pos
      H C d eps Gamma ell testJ testW Rcert (j + 1)
        (by linarith)).le
  have htarget0 : 0 ≤ scale * Real.rpow d (2 - (j : ℝ) - eps / 10) :=
    mul_nonneg hscale0 (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
  have hweight0 := conflictLinkTestWeight_nonneg_sharp
    Rcert.regularized f₀ j
  by_cases hrootH : root ⊆ H
  · by_cases hjr : j ≤ r
    · have hdecomp :=
        weightedF0TruncatedGainCollisionResidualRootMass_le_fourParts
          hweight0 H Rcert.regularized f₀ j r root
      have hnonZero :=
        weightedGainCollisionResidualNonFullRootMass_eq_zero_of_fullRank
          w H Rcert.regularized j r root hrootCard
      have hjCases : j = 1 ∨ j = 2 ∨ j = 3 := by omega
      rcases hjCases with rfl | rfl | rfl
      · have hmono :=
          weightedF0TruncatedGainCollisionResidualRootMass_le_unfiltered
            hweight0 H Rcert.regularized f₀ 1 r root
        rw [weightedGainCollisionResidualRootMass_eq_zero_of_source_card_lt_two
          w H Rcert.regularized 1 r root (by omega)] at hmono
        exact hmono.trans htarget0
      · have hnonemptyZero :
            weightedGainCollisionResidualFullNonemptySourceRootMass
              w H Rcert.regularized 2 r root = 0 := by
          apply weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
            w H Rcert.regularized 2 r (by omega) root
          rw [hrootCard]
          omega
        have hproperZero :=
          weightedF0TruncatedFullEmptyProperSourceRootMass_eq_zero_of_j_le_two
            (w := w) H Rcert.regularized f₀ (j := 2) (r := r)
              (by omega) root
        have hfullCard :
            weightedF0TruncatedGainCollisionResidualFullCardRootMass
                w H Rcert.regularized f₀ 2 r root ≤
              scale * Real.rpow d (-eps / 10) := by
          by_cases hrootZero : root.card = 0
          · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
            subst root
            have hfullZero :=
              weightedGainCollisionResidualFullRootMass_empty_eq_zero_of_properSourceBounds
                (r := r) hP
            have hnonemptyEmpty :
                weightedGainCollisionResidualFullNonemptySourceRootMass
                  w H Rcert.regularized 2 r ∅ = 0 := by simp [
                    weightedGainCollisionResidualFullNonemptySourceRootMass]
            have hemptyZero :
                weightedGainCollisionResidualFullEmptySourceRootMass
                  w H Rcert.regularized 2 r ∅ = 0 := by
              rw [weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty,
                hnonemptyEmpty, add_zero] at hfullZero
              exact hfullZero
            exact (weightedF0TruncatedFullCardRootMass_le_unfilteredFullEmpty
              hweight0 H Rcert.regularized f₀ 2 r ∅).trans
                (hemptyZero.le.trans
                  (mul_nonneg hscale0
                    (Real.rpow_nonneg (by linarith : 0 ≤ d) _)))
          · have hroot1 : 1 ≤ root.card :=
              Nat.one_le_iff_ne_zero.mpr hrootZero
            by_cases hroot2 : root.card ≤ 2
            · have hcutoff12 : 12 ≤ Real.rpow d (eps / 10) := by
                have hGamma : 0 ≤ 3 * Gamma :=
                  regularizedBounded_Gamma_nonneg Rcert.bounded
                    (by linarith : 0 < d)
                exact (by nlinarith : 12 ≤ 72 * (3 * Gamma + 1)).trans
                  hcutoff
              exact Erdos136.RegularizationCertificate.weightedF0TruncatedFullCardRootMass_le_scale
                Rcert hd heps hcutoff12 hf₀H
                  (show 2 ∈ Finset.Icc 1 3 by simp)
                  root hrootH hroot1 hroot2
            · have hroot3 : 3 ≤ root.card := by omega
              rw [Erdos136.RegularizationCertificate.weightedF0TruncatedFullCardRootMass_eq_zero_of_root_card_three
                Rcert (f₀ := f₀) (j := 2) (r := r) (by omega) root hroot3]
              exact mul_nonneg hscale0
                (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
        have hfullCardTarget :
            weightedF0TruncatedGainCollisionResidualFullCardRootMass
                w H Rcert.regularized f₀ 2 r root ≤
              scale * Real.rpow d (2 - (2 : ℝ) - eps / 10) := by
          apply hfullCard.trans_eq
          congr 1
          ring_nf
        change weightedF0TruncatedGainCollisionResidualRootMass
            w H Rcert.regularized f₀ 2 r root ≤
          scale * Real.rpow d (2 - (2 : ℝ) - eps / 10)
        apply hdecomp.trans
        rw [hnonZero, hnonemptyZero, hproperZero]
        simpa only [zero_add] using hfullCardTarget
      · have hemptyZero :=
          weightedGainCollisionResidualFullEmptySourceRootMass_eq_zero_of_card_ne
            w H Rcert.regularized 3 r root (by
              rw [hrootCard]
              omega)
        have hproper0 :=
          (weightedF0TruncatedFullEmptyProperSourceRootMass_le_unfiltered
            hweight0 H Rcert.regularized f₀ 3 r root).trans_eq hemptyZero
        have hcard0 :=
          (weightedF0TruncatedFullCardRootMass_le_unfilteredFullEmpty
            hweight0 H Rcert.regularized f₀ 3 r root).trans_eq hemptyZero
        have hroot3 : root.card ≤ 3 := by rw [hrootCard]; omega
        have hfull :=
          Erdos136.RegularizationCertificate.internalGainCollisionResidualFullNonemptySourceRootMass_le_scale_three
            Rcert (r := r) hd heps hcutoff hf₀H (by omega) (by omega)
              root hrootH hroot3
        have hfullTarget :
            weightedGainCollisionResidualFullNonemptySourceRootMass
                w H Rcert.regularized 3 r root ≤
              scale * Real.rpow d (2 - (3 : ℝ) - eps / 10) := by
          apply hfull.trans_eq
          congr 1
          ring_nf
        change weightedF0TruncatedGainCollisionResidualRootMass
            w H Rcert.regularized f₀ 3 r root ≤
          scale * Real.rpow d (2 - (3 : ℝ) - eps / 10)
        apply hdecomp.trans
        rw [hnonZero]
        nlinarith [hfullTarget]
    · have hrj : r < j := by omega
      have hmono := weightedF0TruncatedGainCollisionResidualRootMass_le_unfiltered
        hweight0 H Rcert.regularized f₀ j r root
      rw [weightedGainCollisionResidualRootMass_eq_zero_of_rank_lt_source
        w H Rcert.regularized j r root hrj] at hmono
      exact hmono.trans htarget0
  · have hmono := weightedF0TruncatedGainCollisionResidualRootMass_le_unfiltered
      hweight0 H Rcert.regularized f₀ j r root
    rw [weightedGainCollisionResidualRootMass_eq_zero_of_not_subset_host
      w H Rcert.regularized j r root hrootH] at hmono
    exact hmono.trans htarget0

/-- The endpoint in the literal `d₀ * delta^|root|` form. -/
theorem RegularizationCertificate.weightedF0TruncatedGainCollisionResidualRootMass_le_of_fullRank_spreadForm
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 72 * (3 * Gamma + 1) ≤ Real.rpow d (eps / 10))
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hr2 : 2 ≤ r) (hr5 : r ≤ 5)
    (root : Hypergraph V) (hrootCard : root.card = r - 2) :
    weightedF0TruncatedGainCollisionResidualRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      (certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10)) *
          d⁻¹ ^ root.card := by
  have hendpoint :=
    Erdos136.RegularizationCertificate.weightedF0TruncatedGainCollisionResidualRootMass_le_of_fullRank
      Rcert hd heps hcutoff hf₀H hj1 hj3 hr2 hr5 root hrootCard
  apply hendpoint.trans_eq
  have hinv : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg (by linarith : 0 ≤ d) _).symm
  rw [hinv]
  have hrpow :
    Real.rpow d (2 - (j : ℝ) - eps / 10) =
        Real.rpow d (((r : ℝ) - (j : ℝ) - eps / 10) +
          (-(root.card : ℝ))) := by
      congr 1
      rw [hrootCard, Nat.cast_sub hr2]
      ring
  calc
    certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (2 - (j : ℝ) - eps / 10) =
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (((r : ℝ) - (j : ℝ) - eps / 10) +
          (-(root.card : ℝ))) := by rw [hrpow]
    _ = certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        (Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10) *
          Real.rpow d (-(root.card : ℝ))) :=
          congrArg (fun x : ℝ ↦ certificateInternalLayerScale
            H C d eps Gamma ell testJ testW Rcert (j + 1) * x)
            (Real.rpow_add (by linarith : 0 < d) _ _)
    _ = (certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10)) *
          Real.rpow d (-(root.card : ℝ)) := by ring

/-- Static weighted spread for the availability-truncated internal
residual coordinate. -/
theorem RegularizationCertificate.f0TruncatedGainCollisionResidualLayer_isWeightedRealSpread
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 72 * (3 * Gamma + 1) ≤ Real.rpow d (eps / 10))
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hr2 : 2 ≤ r) (hr5 : r ≤ 5) :
    IsWeightedRealSpread
      (gainCollisionResidualLayer H Rcert.regularized j r)
      (f0TruncatedGainCollisionResidualRepresentationWeight
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r)
      (r - 2)
      (3 * certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10))
      d⁻¹ := by
  refine ⟨gainCollisionResidualLayer_uniform H Rcert.regularized j r,
    f0TruncatedGainCollisionResidualRepresentationWeight_nonneg
      (conflictLinkTestWeight_nonneg_sharp Rcert.regularized f₀ j)
      H Rcert.regularized f₀ j r, ?_⟩
  intro root hrootCard
  have hroot :=
    Erdos136.RegularizationCertificate.weightedF0TruncatedGainCollisionResidualRootMass_le
      Rcert hd heps hcutoff hf₀H hj1 hj3 hr5 root hrootCard
  apply hroot.trans_eq
  have hinv : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg (by linarith : 0 ≤ d) _).symm
  rw [hinv]
  calc
    3 * certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d
          ((r : ℝ) - (j : ℝ) - eps / 10 - (root.card : ℝ)) =
      (3 * certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1)) *
        (Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10) *
          Real.rpow d (-(root.card : ℝ))) := by
            congr 1
            calc
              Real.rpow d
                  ((r : ℝ) - (j : ℝ) - eps / 10 -
                    (root.card : ℝ)) =
                Real.rpow d (((r : ℝ) - (j : ℝ) - eps / 10) +
                  (-(root.card : ℝ))) := by
                    congr 1
              _ = Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10) *
                    Real.rpow d (-(root.card : ℝ)) :=
                Real.rpow_add (by linarith : 0 < d) _ _
    _ = (3 * certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d ((r : ℝ) - (j : ℝ) - eps / 10)) *
          Real.rpow d (-(root.card : ℝ)) := by ring

structure VertexDuplicateProfile (H : Hypergraph V) where
  vertex : ActualHostVertex H
  layer : Fin 6
  layer_lower : 3 ≤ layer.1
deriving Fintype

structure ExternalOriginalProfile (H : Hypergraph V) (io : Type*) where
  source : io
  choice : {e : Finset V // e ∈ H}
deriving Fintype

structure ExternalResidualProfile (io : Type*) where
  source : io
  unionRank : Fin 6
  rank_two : 2 ≤ unionRank.1
deriving Fintype

structure LegalCCRerootProfile
    (H : Hypergraph V) (C : ConflictSystem V) where
  first : {e : Finset V // e ∈ H}
  second : {e : Finset V // e ∈ H}
  distinct : second.1 ≠ first.1
  disjoint : Disjoint first.1 second.1
  pair_free : {first.1, second.1} ∉ conflictLayer C 2
  linkRank : Fin 4
  linkRank_pos : 1 ≤ linkRank.1
  unionRank : Fin 6
  unionRank_pos : 1 ≤ unionRank.1

noncomputable instance legalCCRerootProfileFintype
    (H : Hypergraph V) (C : ConflictSystem V) :
    Fintype (LegalCCRerootProfile H C) := by
  apply Fintype.ofInjective
    (fun b : LegalCCRerootProfile H C =>
      ((b.first, b.second), (b.linkRank, b.unionRank)))
  intro a b hab
  have hfirst := congrArg (fun z => z.1.1) hab
  have hsecond := congrArg (fun z => z.1.2) hab
  have hlink := congrArg (fun z => z.2.1) hab
  have hunion := congrArg (fun z => z.2.2) hab
  rcases a with ⟨aFirst, aSecond, _, _, _, aLink, _, aUnion, _⟩
  rcases b with ⟨bFirst, bSecond, _, _, _, bLink, _, bUnion, _⟩
  simp_all

/-- The unweighted duplicate family rooted at one available edge.  This
is distinct from `VertexDuplicateProfile`: it closes the pointwise status
defect, while the vertex-weighted family closes the existing degree Good
component's first-failure event. -/
structure PointDuplicateProfile (H : Hypergraph V) where
  edge : {e : Finset V // e ∈ H}
  layer : Fin 6
  layer_lower : 3 ≤ layer.1
deriving Fintype

abbrev ExternalTestLocalProfileIndex
    (H : Hypergraph V) (C : ConflictSystem V) (io : Type*) :=
  Sum (VertexDuplicateProfile H)
    (Sum (ExternalOriginalProfile H io)
      (Sum (ExternalResidualProfile io)
        (Sum (LegalCCRerootProfile H C) (PointDuplicateProfile H))))

def externalTestLocalProfileFamily
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
  (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    ExternalTestLocalProfileIndex H R.regularized io → ConflictSystem V
  | Sum.inl b =>
      vertexDuplicateLayerFamily H R.regularized b.vertex.1 b.layer.1
  | Sum.inr (Sum.inl b) =>
      originalTestChoiceRemainderFamily H (j b.source) b.choice.1
  | Sum.inr (Sum.inr (Sum.inl b)) =>
      gainCollisionResidualLayer H R.regularized
        (j b.source) b.unionRank.1
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl b))) =>
      testConflictUnionLayer
        (conflictLinkLayer R.regularized b.first.1 b.linkRank.1)
        R.regularized b.second.1 b.unionRank.1
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr b))) =>
      duplicateConflictLinkUnionLayer R.regularized b.edge.1 b.layer.1

def externalTestLocalProfileWeight
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
  (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    ExternalTestLocalProfileIndex H R.regularized io → TestWeight V
  | Sum.inl b =>
      vertexDuplicateLayerRepresentationWeight
        H R.regularized b.vertex.1 b.layer.1
  | Sum.inr (Sum.inl b) =>
      originalTestChoiceRemainderWeight
        (R.restrictedWeight b.source) b.choice.1
  | Sum.inr (Sum.inr (Sum.inl b)) =>
      gainCollisionResidualRepresentationWeight
        (R.restrictedWeight b.source) H R.regularized
          (j b.source) b.unionRank.1
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl _))) => unitTestWeight
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr _))) => unitTestWeight

def externalTestLocalProfileFamilyRank
    {H : Hypergraph V} {C : ConflictSystem V} (j : io → ℕ) :
    ExternalTestLocalProfileIndex H C io → ℕ
  | Sum.inl b => b.layer.1
  | Sum.inr (Sum.inl b) => j b.source - 1
  | Sum.inr (Sum.inr (Sum.inl b)) => b.unionRank.1 - 2
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl b))) => b.unionRank.1
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr b))) => b.layer.1

def externalTestLocalProfileActiveRank
    {H : Hypergraph V} {C : ConflictSystem V} (j : io → ℕ) :
    ExternalTestLocalProfileIndex H C io → ℕ
  | Sum.inl b => b.layer.1 - 1
  | Sum.inr (Sum.inl b) => j b.source - 1
  | Sum.inr (Sum.inr (Sum.inl b)) => b.unionRank.1 - 2
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl b))) => b.unionRank.1 - 1
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr b))) => b.layer.1 - 1

def externalTestLocalProfileSeed
    {H : Hypergraph V} {C : ConflictSystem V}
    (b : ExternalTestLocalProfileIndex H C io) : Hypergraph V := ∅

def externalTestLocalProfileScale
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
  (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    ExternalTestLocalProfileIndex H R.regularized io → ℝ
  | Sum.inl b =>
      2304 * (3 * GammaCert + 1) * d *
        Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)
  | Sum.inr (Sum.inl b) =>
      (ellCert : ℝ) * testTotal (R.restrictedWeight b.source) H
        (j b.source) * Real.rpow d (-1 - epsRaw / 5)
  | Sum.inr (Sum.inr (Sum.inl b)) =>
      testTotal (R.restrictedWeight b.source) H (j b.source) *
        Real.rpow d
          ((b.unionRank.1 : ℝ) - (j b.source : ℝ) - epsRaw / 10)
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl b))) =>
      768 * (3 * GammaCert + 1) *
        Real.rpow d ((b.unionRank.1 : ℝ) - epsRaw / 4)
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr b))) =>
      2304 * (3 * GammaCert + 1) *
        Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)

@[simp] theorem externalTestLocalProfileFamily_original
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : ExternalOriginalProfile H io) :
    externalTestLocalProfileFamily H C j R (Sum.inr (Sum.inl b)) =
      originalTestChoiceRemainderFamily H (j b.source) b.choice.1 := rfl

@[simp] theorem externalTestLocalProfileWeight_original
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : ExternalOriginalProfile H io) :
    externalTestLocalProfileWeight H C j R (Sum.inr (Sum.inl b)) =
      originalTestChoiceRemainderWeight
        (R.restrictedWeight b.source) b.choice.1 := rfl

@[simp] theorem externalTestLocalProfileFamilyRank_original
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : io → ℕ) (b : ExternalOriginalProfile H io) :
    externalTestLocalProfileFamilyRank
      (H := H) (C := C) (io := io) j (Sum.inr (Sum.inl b)) =
      j b.source - 1 := rfl

@[simp] theorem externalTestLocalProfileActiveRank_original
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : io → ℕ) (b : ExternalOriginalProfile H io) :
    externalTestLocalProfileActiveRank
      (H := H) (C := C) (io := io) j (Sum.inr (Sum.inl b)) =
      j b.source - 1 := rfl

@[simp] theorem externalTestLocalProfileSeed_eq_empty
    (H : Hypergraph V) (C : ConflictSystem V)
    (b : ExternalTestLocalProfileIndex H C io) :
    externalTestLocalProfileSeed
      (H := H) (C := C) (io := io) b = ∅ := rfl

theorem externalTestLocalProfileFamilyRank_le_five
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : io → ℕ) (hj3 : ∀ a, j a ≤ 3)
    (b : ExternalTestLocalProfileIndex H C io) :
    externalTestLocalProfileFamilyRank
      (H := H) (C := C) (io := io) j b ≤ 5 := by
  rcases b with b | b
  · simp only [externalTestLocalProfileFamilyRank]
    omega
  · rcases b with b | b
    · simp only [externalTestLocalProfileFamilyRank]
      have hjb := hj3 b.source
      omega
    · rcases b with b | b
      · simp only [externalTestLocalProfileFamilyRank]
        omega
      · rcases b with b | b
        · simp only [externalTestLocalProfileFamilyRank]
          omega
        · simp only [externalTestLocalProfileFamilyRank]
          omega

theorem externalTestLocalProfileActiveRank_le_familyRank
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : io → ℕ) (b : ExternalTestLocalProfileIndex H C io) :
    externalTestLocalProfileActiveRank
        (H := H) (C := C) (io := io) j b ≤
      externalTestLocalProfileFamilyRank
        (H := H) (C := C) (io := io) j b := by
  rcases b with b | b
  · simp only [externalTestLocalProfileActiveRank,
      externalTestLocalProfileFamilyRank]
    omega
  · rcases b with b | b
    · rfl
    · rcases b with b | b
      · rfl
      · rcases b with b | b
        · simp only [externalTestLocalProfileActiveRank,
            externalTestLocalProfileFamilyRank]
          omega
        · simp only [externalTestLocalProfileActiveRank,
            externalTestLocalProfileFamilyRank]
          omega

/-- Every concrete external/degree profile is a weighted real-spread
family at its literal certificate scale.  The only non-structural
hypothesis is the certificate-level residual cutoff; the final specialized
constructor derives it from `CoreCutoffSpec`. -/
theorem externalTestLocalProfile_isWeightedRealSpread
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (b : ExternalTestLocalProfileIndex H R.regularized io) :
    IsWeightedRealSpread
      (externalTestLocalProfileFamily H C j R b)
      (externalTestLocalProfileWeight H C j R b)
      (externalTestLocalProfileFamilyRank j b)
      (externalTestLocalProfileScale H C d epsRaw GammaCert ellCert j w R b)
      d⁻¹ := by
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  rcases b with b | b
  · change IsWeightedRealSpread
      (vertexDuplicateLayerFamily H R.regularized b.vertex.1 b.layer.1)
      (vertexDuplicateLayerRepresentationWeight
        H R.regularized b.vertex.1 b.layer.1)
      b.layer.1
      (2304 * (3 * GammaCert + 1) * d *
        Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)) d⁻¹
    exact vertexDuplicateLayer_isWeightedRealSpread R.bounded R.antichain
      hdpos hd (by positivity) hdegree b.vertex.1 b.layer.1
        b.layer_lower (by omega)
  · rcases b with b | b
    · change IsWeightedRealSpread
        (originalTestChoiceRemainderFamily H (j b.source) b.choice.1)
        (originalTestChoiceRemainderWeight
          (R.restrictedWeight b.source) b.choice.1)
        (j b.source - 1)
        ((ellCert : ℝ) * testTotal (R.restrictedWeight b.source) H
          (j b.source) * Real.rpow d (-1 - epsRaw / 5)) d⁻¹
      exact originalTestChoiceRemainder_isWeightedRealSpread_of_trackable
        (R.survivingTrackable b.source) hd (by positivity) hell
          b.choice.1 b.choice.2 (hj1 b.source)
    · rcases b with b | b
      · change IsWeightedRealSpread
          (gainCollisionResidualLayer H R.regularized
            (j b.source) b.unionRank.1)
          (gainCollisionResidualRepresentationWeight
            (R.restrictedWeight b.source) H R.regularized
              (j b.source) b.unionRank.1)
          (b.unionRank.1 - 2)
          (testTotal (R.restrictedWeight b.source) H (j b.source) *
            Real.rpow d ((b.unionRank.1 : ℝ) -
              (j b.source : ℝ) - epsRaw / 10)) d⁻¹
        exact gainCollisionResidualLayer_isWeightedRealSpread_of_trackable
          (R.survivingTrackable b.source) R.bounded hd heps hell
            (hj3 b.source) b.rank_two (by omega)
              hresidualCutoff
      · rcases b with b | b
        · change IsWeightedRealSpread
            (testConflictUnionLayer
              (conflictLinkLayer R.regularized b.first.1 b.linkRank.1)
              R.regularized b.second.1 b.unionRank.1)
            (unitTestWeight (V := V)) b.unionRank.1
            (768 * (3 * GammaCert + 1) *
              Real.rpow d ((b.unionRank.1 : ℝ) - epsRaw / 4)) d⁻¹
          exact R.rerootedTestConflictUnionLayer_isWeightedRealSpread
            hdpos hd heps b.first.2 b.second.2 b.disjoint b.pair_free
            b.linkRank.1 b.unionRank.1
            (Finset.mem_Icc.mpr
              ⟨b.linkRank_pos, by omega⟩)
            (by omega)
        · change IsWeightedRealSpread
            (duplicateConflictLinkUnionLayer
              R.regularized b.edge.1 b.layer.1)
            (unitTestWeight (V := V)) b.layer.1
            (2304 * (3 * GammaCert + 1) *
              Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)) d⁻¹
          exact (duplicateConflictLinkUnionLayer_isRealSpread
            R.bounded R.antichain hdpos hd (by positivity)
              b.edge.1 b.edge.2 b.layer.1 b.layer_lower
                (by omega)).isWeightedRealSpread_unitTestWeight

theorem externalTestLocalProfileScale_pos
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (hell : 1 ≤ ellCert)
    (b : ExternalTestLocalProfileIndex H R.regularized io) :
    0 < externalTestLocalProfileScale
      H C d epsRaw GammaCert ellCert j w R b := by
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hGamma3 : 0 ≤ 3 * GammaCert :=
    regularizedBounded_Gamma_nonneg R.bounded hdpos
  have hcoef : 0 < 3 * GammaCert + 1 := by linarith
  rcases b with b | b
  · dsimp only [externalTestLocalProfileScale]
    exact mul_pos (mul_pos (mul_pos (by positivity) hcoef) hdpos)
      (Real.rpow_pos_of_pos hdpos _)
  · rcases b with b | b
    · dsimp only [externalTestLocalProfileScale]
      have hW : 0 < testTotal (R.restrictedWeight b.source) H (j b.source) :=
        (Real.rpow_pos_of_pos hdpos ((j b.source : ℝ) + epsRaw / 5)).trans_le
          (R.survivingTrackable b.source).total_lower
      exact mul_pos (mul_pos (Nat.cast_pos.mpr hell) hW)
        (Real.rpow_pos_of_pos hdpos _)
    · rcases b with b | b
      · dsimp only [externalTestLocalProfileScale]
        have hW : 0 < testTotal (R.restrictedWeight b.source) H (j b.source) :=
          (Real.rpow_pos_of_pos hdpos ((j b.source : ℝ) + epsRaw / 5)).trans_le
            (R.survivingTrackable b.source).total_lower
        exact mul_pos hW (Real.rpow_pos_of_pos hdpos _)
      · rcases b with b | b
        · dsimp only [externalTestLocalProfileScale]
          exact mul_pos (mul_pos (by positivity) hcoef)
            (Real.rpow_pos_of_pos hdpos _)
        · dsimp only [externalTestLocalProfileScale]
          exact mul_pos (mul_pos (by positivity) hcoef)
            (Real.rpow_pos_of_pos hdpos _)

/-- Closed-root endpoint for every profile.  `activeRank` deliberately
omits the false full-rank diagonal for the one-open duplicate and reroot
families.  The residual branch uses the separate full-rank endpoint. -/
theorem externalTestLocalProfile_root_le_scale
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (b : ExternalTestLocalProfileIndex H R.regularized io)
    (root : Hypergraph V)
    (hroot : root.card ≤ externalTestLocalProfileActiveRank
      (H := H) (C := R.regularized) (io := io) j b) :
    weightedCodegree
        (externalTestLocalProfileFamily H C j R b)
        (externalTestLocalProfileWeight H C j R b) root ≤
      externalTestLocalProfileScale
          H C d epsRaw GammaCert ellCert j w R b *
        d⁻¹ ^ root.card := by
  rcases b with b | b
  · have hspread := externalTestLocalProfile_isWeightedRealSpread
      H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
        hdegree hresidualCutoff (Sum.inl b)
    have hroot' : root.card ≤ b.layer.1 - 1 := by
      simpa only [externalTestLocalProfileActiveRank] using hroot
    apply hspread.weightedShadow_le root
    change root.card < b.layer.1
    exact lt_of_le_of_lt hroot' (by
      have hlayer := b.layer_lower
      omega)
  · rcases b with b | b
    · simpa only [externalTestLocalProfileFamily,
          externalTestLocalProfileWeight, externalTestLocalProfileScale,
          externalTestLocalProfileActiveRank] using
        originalTestChoiceRemainder_root_le_scale
          (R.survivingTrackable b.source) hd (by positivity) hell
            b.choice.1 b.choice.2 (hj1 b.source) root hroot
    · rcases b with b | b
      · change weightedGainCollisionResidualRootMass
            (R.restrictedWeight b.source) H R.regularized
              (j b.source) b.unionRank.1 root ≤
          (testTotal (R.restrictedWeight b.source) H (j b.source) *
            Real.rpow d ((b.unionRank.1 : ℝ) -
              (j b.source : ℝ) - epsRaw / 10)) * d⁻¹ ^ root.card
        by_cases hfull : root.card = b.unionRank.1 - 2
        · exact weightedGainCollisionResidualRootMass_le_of_fullRank_spreadForm
            (R.survivingTrackable b.source) R.bounded hd heps hell
              (hj3 b.source) b.rank_two (by omega)
                hresidualCutoff root hfull
        · have hspread := externalTestLocalProfile_isWeightedRealSpread
            H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
              hdegree hresidualCutoff
                (Sum.inr (Sum.inr (Sum.inl b)))
          exact hspread.weightedShadow_le root (by
            change root.card < b.unionRank.1 - 2
            change root.card ≤ b.unionRank.1 - 2 at hroot
            omega)
      · rcases b with b | b
        · simpa only [externalTestLocalProfileFamily,
              externalTestLocalProfileWeight, externalTestLocalProfileScale,
              externalTestLocalProfileActiveRank] using
            R.rerootedTestConflictUnionLayer_root_le_scale
              (lt_of_lt_of_le zero_lt_one hd) hd heps
                b.first.2 b.second.2 b.disjoint b.pair_free
                b.linkRank.1 b.unionRank.1
                (Finset.mem_Icc.mpr
                  ⟨b.linkRank_pos, by omega⟩)
                (by omega) root hroot
        · have hspread := externalTestLocalProfile_isWeightedRealSpread
            H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
              hdegree hresidualCutoff
                (Sum.inr (Sum.inr (Sum.inr (Sum.inr b))))
          have hroot' : root.card ≤ b.layer.1 - 1 := by
            simpa only [externalTestLocalProfileActiveRank] using hroot
          exact hspread.weightedShadow_le root (by
            change root.card < b.layer.1
            exact lt_of_le_of_lt hroot' (by
              have hlayer := b.layer_lower
              omega))

