theorem degreeEnhancedComb_numeric_of_degreeEnhancedGood
    {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} {ell k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ : ℝ) {M : Hypergraph V}
    (hk : k < CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
          (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
          j R.restrictedWeight) k M)
    (Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d ((vertexFinset H).card : ℝ)
        (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hNlower : d ^ eta / 2 ≤ ((vertexFinset H).card : ℝ))
    (v : ActualHostVertex H) (hv : v.1 ∈ uncoveredVertices H M) :
    survivingVertexProbability H R.regularized v.1 M *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d
            ((vertexFinset H).card : ℝ) (k : ℝ) -
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d
              ((vertexFinset H).card : ℝ) (k : ℝ) +
          2 * (d ^ (1 - CFMNumeric.coreEpsilon eta) /
            ((vertexFinset H).card : ℝ))) ≤
      degreeEnhancedCombLo H R.regularized v.1 D₂ D₃ D₄ Gamma eta d
        ((vertexFinset H).card : ℝ) k M ∧
    degreeEnhancedCombHi H R.regularized v.1 D₂ D₃ D₄ Gamma eta d
        ((vertexFinset H).card : ℝ) k M ≤
      survivingVertexProbability H R.regularized v.1 M *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d
            ((vertexFinset H).card : ℝ) (k : ℝ) +
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d
              ((vertexFinset H).card : ℝ) (k : ℝ) -
          2 * (d ^ (1 - CFMNumeric.coreEpsilon eta) /
            ((vertexFinset H).card : ℝ))) := by
  rcases hI with
    ⟨hH8, _hCsys, _hell, _hC4, _heta0, _heta1, _hd,
      _hNupper, _hdegreeHost, _hcodegree, _hbounded, _htests, _htrack⟩
  let N : ℝ := ((vertexFinset H).card : ℝ)
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
  let u := N * CFMTrajectories.pV N (k : ℝ)
  let A := availableEdges H R.regularized M
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 1 ≤ d := Rstep.degree.d_one
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hNpos : 0 < N := by simpa only [N] using Rstep.degree.N_pos
  have hpV : 0 < CFMTrajectories.pV N (k : ℝ) :=
    CFMTrajectories.pV_pos hNpos (Rstep.degree.before_end _ hx)
  have hpV1 : CFMTrajectories.pV N (k : ℝ) ≤ 1 :=
    CFMTrajectories.pV_le_one hNpos (Rstep.degree.time_nonneg _ hx)
  have hu : 0 < u := mul_pos hNpos hpV
  have hlocal := indexedDegreeEnhancedGood_local
    H R.regularized D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
      j R.restrictedWeight hgood
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d N
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card) hlocal
  have hold := indexedDegreeEnhancedGood_old
    H R.regularized D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
      j R.restrictedWeight hgood
  have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
    H R.regularized D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d N
      j R.restrictedWeight hold
  have hDlo := Rstep.dHat_lower (k : ℝ) hx
  have hD : 0 < D :=
    (Real.rpow_pos_of_pos hdpos _).trans_le (by simpa only [D] using hDlo)
  have hdeltaBounds := CFMTrajectories.delta_bounds_of_registry Rstep hx
  have hdelta0 : 0 ≤ delta :=
    (Real.rpow_nonneg hdpos.le _).trans
      (by simpa only [delta] using hdeltaBounds.1)
  have hxi := (Rstep.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hdeltaEq : delta =
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) * D := by
    rfl
  have hsmall : 5 * delta ≤ D := by
    rw [hdeltaEq]
    nlinarith [mul_le_mul_of_nonneg_right hxi hD.le]
  have hcoveredStrict : 8 * k < (vertexFinset H).card := by
    have hb := Rstep.degree.before_end (k : ℝ) hx
    exact_mod_cast hb
  have hcovered : 8 * k ≤ (vertexFinset H).card := hcoveredStrict.le
  have huncard : ((uncoveredVertices H M).card : ℝ) = u := by
    rw [card_uncoveredVertices_of_uniform_matching hH8 hreach.1.1,
      hreach.2, Nat.cast_sub hcovered]
    norm_num [Nat.cast_mul]
    change N - 8 * (k : ℝ) = u
    dsimp only [u]
    unfold CFMTrajectories.pV
    field_simp [ne_of_gt hNpos]
    <;> ring
  have hhand := availableEdges_card_bounds_of_degreeWithin hH8 hdegree
  have haLo : u * (D - delta) / 8 ≤ (A.card : ℝ) := by
    rw [← huncard]
    have := hhand.1
    dsimp only [A, D, delta] at this ⊢
    nlinarith
  have haHi : (A.card : ℝ) ≤ u * (D + delta) / 8 := by
    rw [← huncard]
    have := hhand.2
    dsimp only [A, D, delta] at this ⊢
    nlinarith
  have haLower : u * D / 10 ≤ (A.card : ℝ) := by
    have hDm : 4 * D / 5 ≤ D - delta := by linarith
    calc
      u * D / 10 = u * (4 * D / 5) / 8 := by ring
      _ ≤ u * (D - delta) / 8 := by gcongr
      _ ≤ (A.card : ℝ) := haLo
  have ha : 0 < (A.card : ℝ) :=
    (by positivity : 0 < u * D / 10).trans_le haLower
  have hA : A.Nonempty := Finset.card_pos.mp (by exact_mod_cast ha)
  have hb := hdegree v.1 hv
  have hpM0 := CFMTrajectories.pM_nonneg hdpos hNpos
    (Rstep.degree.time_nonneg (k : ℝ) hx)
  have hpM1 := CFMTrajectories.pM_le_inv hdpos hNpos
    (Rstep.degree.before_end (k : ℝ) hx).le
  have hload := CFMTrajectories.conflictLoad_le_six_mul
    hdpos (by linarith [E.Gamma_one]) hpM0 hpM1
      Rstep.degree.D₂_bound Rstep.degree.D₃_bound Rstep.degree.D₄_bound
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N (k : ℝ) :=
    (CFMTrajectories.q_pos hpV).le
  have hDEq : CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) =
      CFMTrajectories.q D₂ D₃ D₄ d N (k : ℝ) *
        CFMTrajectories.conflictLoad D₂ D₃ D₄ d N (k : ℝ) := by
    unfold CFMTrajectories.cHat CFMTrajectories.conflictLoad
    ring
  have hc0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) := by
    rw [hDEq]
    have hload0 : 0 ≤
        CFMTrajectories.conflictLoad D₂ D₃ D₄ d N (k : ℝ) := by
      exact CFMTrajectories.conflictLoad_nonneg
        Rstep.degree.D₂_nonneg Rstep.degree.D₃_nonneg
          Rstep.degree.D₄_nonneg hpM0
    exact mul_nonneg hq0 hload0
  have hc : CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) ≤ 6 * Gamma * D := by
    rw [hDEq]
    calc
      _ ≤ CFMTrajectories.q D₂ D₃ D₄ d N (k : ℝ) * (6 * Gamma * d) :=
        mul_le_mul_of_nonneg_left hload hq0
      _ = 6 * Gamma * CFMTrajectories.pV N (k : ℝ) * D := by
        dsimp only [D]
        unfold CFMTrajectories.q CFMTrajectories.dHat
        ring
      _ ≤ 6 * Gamma * D := by
        have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
        have hGD0 : 0 ≤ 6 * Gamma * D :=
          mul_nonneg (mul_nonneg (by norm_num) hGamma0) hD.le
        nlinarith [mul_le_mul_of_nonneg_right hpV1 hGD0]
  have hcenter0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) + 7 * D := by
    exact add_nonneg hc0 (mul_nonneg (by norm_num) hD.le)
  have hcenter : CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) + 7 * D ≤
      13 * Gamma * D := by
    nlinarith [mul_le_mul_of_nonneg_right E.Gamma_one hD.le]
  have herror := degreeMeanError_le_sixtyFour_mul_delta E S Rstep
  have herror0 : 0 ≤ 7 * delta + 28 * Real.rpow d (1 - eta) + 35 +
      degreeInternalCorridorError D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N k := by
    have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
    have hzeta0 (q s : ℕ) : 0 ≤ CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N q s (k : ℝ) := by
      unfold CFMTrajectories.zeta CFMTrajectories.xi
      have hpV0 : 0 ≤ CFMTrajectories.pV N (k : ℝ) := hpV.le
      have hpM0' : 0 ≤ CFMTrajectories.pM d N (k : ℝ) := hpM0
      unfold CFMTrajectories.zHat CFMTrajectories.q
      positivity
    unfold degreeInternalCorridorError
    have hinter : 0 ≤
        D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ) +
          D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N 2 1 (k : ℝ) +
          D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N 3 1 (k : ℝ) := by
      exact add_nonneg
        (add_nonneg
          (mul_nonneg Rstep.degree.D₂_nonneg (hzeta0 1 1))
          (mul_nonneg Rstep.degree.D₃_nonneg (hzeta0 2 1)))
        (mul_nonneg Rstep.degree.D₄_nonneg (hzeta0 3 1))
    exact add_nonneg
      (add_nonneg
        (add_nonneg
          (mul_nonneg (by norm_num) hdelta0)
          (mul_nonneg (by norm_num) (Real.rpow_nonneg hdpos.le _)))
        (by norm_num))
      hinter
  have hdefectCap := vertexInternalOpenLinkDefect_le_primaryMarginPower
    H R.regularized D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
      (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
      j R.restrictedWeight hgood R.conflictMatching R.antichain v
  have heps0 : 0 ≤ CFMNumeric.coreEpsilon eta :=
    CFMNumericAggregation.coreEpsilon_nonneg E
  have hdefectProduct : Real.rpow d
        (2 - CFMNumeric.coreEpsilon eta / 2) ≤ Gamma * delta * D := by
    have hp := Real.rpow_le_rpow_of_exponent_le hd
      (show 2 - CFMNumeric.coreEpsilon eta / 2 ≤
        (1 - CFMNumeric.coreEpsilon eta / 16) +
          (1 - CFMNumeric.coreEpsilon eta / 32) by linarith)
    have hdeltaLo : d ^
        (1 - CFMNumeric.coreEpsilon eta / 16) ≤ delta := by
      simpa only [delta, N] using hdeltaBounds.1
    have hDlo' : d ^
        (1 - CFMNumeric.coreEpsilon eta / 32) ≤ D := by
      simpa only [D, N] using hDlo
    have hprod := mul_le_mul hdeltaLo hDlo'
      (Real.rpow_nonneg hdpos.le _) hdelta0
    have hpow : Real.rpow d
          ((1 - CFMNumeric.coreEpsilon eta / 16) +
            (1 - CFMNumeric.coreEpsilon eta / 32)) =
        Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 16) *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) :=
      Real.rpow_add hdpos _ _
    calc
      _ ≤ Real.rpow d
          ((1 - CFMNumeric.coreEpsilon eta / 16) +
            (1 - CFMNumeric.coreEpsilon eta / 32)) := hp
      _ = _ := hpow
      _ ≤ delta * D := hprod
      _ ≤ Gamma * delta * D := by
        calc
          delta * D ≤ Gamma * (delta * D) :=
            by simpa only [one_mul] using
              (mul_le_mul_of_nonneg_right E.Gamma_one
                (mul_nonneg hdelta0 hD.le))
          _ = Gamma * delta * D := by ring
  have hdefect0 : 0 ≤ vertexInternalOpenLinkDefect R.regularized A M v.1 /
      (A.card : ℝ) := div_nonneg
    (vertexInternalOpenLinkDefect_nonneg _ _ _ _) ha.le
  have hdefect : vertexInternalOpenLinkDefect R.regularized A M v.1 /
        (A.card : ℝ) ≤ 10 * Gamma * delta / u := by
    apply (div_le_iff₀ ha).2
    have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
    have hfac0 : 0 ≤ 10 * Gamma * delta / u :=
      div_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) hGamma0) hdelta0) hu.le
    have had := mul_le_mul_of_nonneg_left haLower hfac0
    calc
      vertexInternalOpenLinkDefect R.regularized A M v.1 ≤
          Gamma * delta * D := hdefectCap.trans hdefectProduct
      _ = (10 * Gamma * delta / u) * (u * D / 10) := by
        field_simp [ne_of_gt hu]
        <;> ring
      _ ≤ (10 * Gamma * delta / u) * (A.card : ℝ) := had
      _ = 10 * Gamma * delta / u * (A.card : ℝ) := rfl
  have hcoef : 320000 * Gamma ≤
      Real.rpow d (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 16) := by
    have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
    have hGammaSq : Gamma ≤ Gamma ^ 2 := by
      calc
        Gamma = 1 * Gamma := by ring
        _ ≤ Gamma * Gamma :=
          mul_le_mul_of_nonneg_right E.Gamma_one hGamma0
        _ = Gamma ^ 2 := by ring
    calc
      320000 * Gamma ≤ 4096000000 * Gamma ^ 2 := by
        calc
          320000 * Gamma ≤ 4096000000 * Gamma :=
            mul_le_mul_of_nonneg_right (by norm_num) hGamma0
          _ ≤ 4096000000 * Gamma ^ 2 :=
            mul_le_mul_of_nonneg_left hGammaSq (by norm_num)
      _ ≤ Real.rpow d (eta - 2 * eta ^ 3 - CFMNumeric.coreEpsilon eta) :=
        S.degreeSecondOrder
      _ ≤ Real.rpow d (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 16) := by
        have heta3 : 0 ≤ eta ^ 3 := pow_nonneg E.eta_pos.le 3
        have hepsPart : 0 ≤ 15 / 16 * CFMNumeric.coreEpsilon eta :=
          mul_nonneg (by norm_num) heps0
        apply Real.rpow_le_rpow_of_exponent_le hd
        linarith
  have hNP := CFMNumericAggregation.host_mul_floor_lower hdpos hNlower
  have hhost : 5000 * Gamma * D ≤ u * delta := by
    have hDupper := CFMTrajectories.dHat_le_d hdpos.le hpV.le hpV1
      (CFMTrajectories.GammaHat_nonneg Rstep.degree.D₂_nonneg
        Rstep.degree.D₃_nonneg Rstep.degree.D₄_nonneg hpM0)
    have hcoefD := mul_le_mul_of_nonneg_right hcoef hdpos.le
    have hpowEq : Real.rpow d
          (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 16) * d =
        (Real.rpow d (eta - eta ^ 3) / 64) *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 16) * 64 := by
      simp only [Real.rpow_eq_pow]
      let a := eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 16
      let b := eta - eta ^ 3
      let c := 1 - CFMNumeric.coreEpsilon eta / 16
      calc
        d ^ a * d = d ^ a * d ^ (1 : ℝ) := by
          exact congrArg (fun z : ℝ ↦ d ^ a * z) (Real.rpow_one d).symm
        _ = d ^ (a + 1) := (Real.rpow_add hdpos a 1).symm
        _ = d ^ (b + c) := by
          congr 1
          dsimp only [a, b, c]
          ring
        _ = d ^ b * d ^ c := Real.rpow_add hdpos b c
        _ = (d ^ b / 64) * d ^ c * 64 := by ring
    have hfloor0 : 0 ≤ CFMNumeric.trajectoryFloor eta d := by
      unfold CFMNumeric.trajectoryFloor
      exact div_nonneg (Real.rpow_nonneg hdpos.le _) (by norm_num)
    have hNP0 : 0 ≤ N * CFMNumeric.trajectoryFloor eta d :=
      mul_nonneg hNpos.le hfloor0
    have hlowerProd := mul_le_mul hNP hdeltaBounds.1
      (Real.rpow_nonneg hdpos.le _) hNP0
    have hpFloor := Rstep.degree.pV_floor (k : ℝ) hx
    have huFloor : N * CFMNumeric.trajectoryFloor eta d ≤ u := by
      dsimp only [u]
      exact mul_le_mul_of_nonneg_left hpFloor hNpos.le
    calc
      5000 * Gamma * D ≤ 5000 * Gamma * d := by
        exact mul_le_mul_of_nonneg_left hDupper
          (mul_nonneg (by norm_num) (le_trans zero_le_one E.Gamma_one))
      _ ≤ (Real.rpow d (eta - eta ^ 3) / 64) *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 16) := by
        calc
          5000 * Gamma * d = (320000 * Gamma * d) / 64 := by ring
          _ ≤ (Real.rpow d
              (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 16) * d) / 64 :=
            div_le_div_of_nonneg_right hcoefD (by norm_num)
          _ = _ := by rw [hpowEq]; ring
      _ ≤ (N * CFMNumeric.trajectoryFloor eta d) * delta := hlowerProd
      _ ≤ u * delta := by
        exact mul_le_mul_of_nonneg_right huFloor hdelta0
  have hkReal : (k : ℝ) <
      (1 - CFMNumeric.stoppingMargin eta d) * N / 8 := by
    exact Nat.lt_ceil.mp (by simpa only [CFMNumericAggregation.targetTime, N] using hk)
  have huMargin : CFMNumeric.stoppingMargin eta d * N < u := by
    have huEq : u = N - (k : ℝ) * 8 := by
      dsimp only [u]
      unfold CFMTrajectories.pV
      field_simp [ne_of_gt hNpos]
      <;> ring
    rw [huEq]
    have hk8 : (k : ℝ) * 8 <
        (1 - CFMNumeric.stoppingMargin eta d) * N :=
      (lt_div_iff₀ (by norm_num : (0 : ℝ) < 8)).mp hkReal
    calc
      CFMNumeric.stoppingMargin eta d * N =
          N - (1 - CFMNumeric.stoppingMargin eta d) * N := by ring
      _ < N - (k : ℝ) * 8 := sub_lt_sub_left hk8 N
  have hu16 : 16 < u :=
    (CFMNumeric.stoppingMargin_mul_host_gt_sixteen S hNlower).trans huMargin
  have hsurvEq := survivingVertexProbability_eq_one_sub_degree_div
    H R.regularized M v.1 hv hA
  have hratio := degreeRatio_bounds_of_handshake hu hD hdelta0 hsmall
    (by simpa only [D, delta] using hb.1)
    (by simpa only [D, delta] using hb.2) haLo haHi
