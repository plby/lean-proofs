theorem seventyGamma_mul_envelope64_le_one
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    70 * Gamma * d ^ (-CFMNumeric.coreEpsilon eta / 64) ≤ 1 := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hGpos : 0 < Gamma := lt_of_lt_of_le zero_lt_one E.Gamma_one
  have hpow := pow_le_pow_left₀ (Real.exp_nonneg _) S.testHazardExponential 8
  have hexp : Real.exp (24 * Gamma) ≤
      d ^ (CFMNumeric.coreEpsilon eta / 64) := by
    calc
      Real.exp (24 * Gamma) = Real.exp (3 * Gamma) ^ (8 : ℕ) := by
        rw [← Real.exp_nat_mul]
        congr 1
        ring
      _ ≤ (d ^ (CFMNumeric.coreEpsilon eta / 512)) ^ (8 : ℕ) := hpow
      _ = d ^ (CFMNumeric.coreEpsilon eta / 64) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hd.le]
        congr 1
        ring
  have hdecay : d ^ (-CFMNumeric.coreEpsilon eta / 64) ≤
      Real.exp (-(24 * Gamma)) := by
    rw [show -CFMNumeric.coreEpsilon eta / 64 =
        -(CFMNumeric.coreEpsilon eta / 64) by ring,
      Real.rpow_neg hd.le, Real.exp_neg]
    exact (inv_le_inv₀ (Real.rpow_pos_of_pos hd _) (Real.exp_pos _)).2 hexp
  have hx0 : 0 ≤ 24 * Gamma := by positivity
  have hquad := Real.pow_div_factorial_le_exp (24 * Gamma) hx0 2
  have h70 : 70 * Gamma ≤ Real.exp (24 * Gamma) := by
    norm_num at hquad
    nlinarith [E.Gamma_one, sq_nonneg Gamma]
  have hprod : 70 * Gamma * Real.exp (-(24 * Gamma)) ≤ 1 := by
    rw [Real.exp_neg]
    exact (div_le_one (Real.exp_pos _)).2 h70
  calc
    70 * Gamma * d ^ (-CFMNumeric.coreEpsilon eta / 64) ≤
        70 * Gamma * Real.exp (-(24 * Gamma)) :=
      mul_le_mul_of_nonneg_left hdecay (by positivity)
    _ ≤ 1 := hprod

/-- The literal lower endpoint used by the certificate blocker window is
nonnegative.  Thus the sharp mean consumer needs no `max 0` workaround. -/
theorem certificateTestStatusLo_nonneg_of_registry
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P) :
    0 ≤ certificateTestStatusLo D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (d ^ (1 - eta))
        (1536 * localSpreadPrimaryMargin eta d) k := by
  let x : ℝ := k
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N x
  let internal := degreeInternalCorridorError D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N k
  let eLo := 8 * delta + 28 * d ^ (1 - eta) + internal +
    1536 * localSpreadPrimaryMargin eta d
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.degree.d_one
  have hp := CFMTrajectories.pV_pos R.degree.N_pos
    (R.degree.before_end x hx)
  have hm := CFMTrajectories.pM_nonneg hd R.degree.N_pos
    (R.degree.time_nonneg x hx)
  have hD : 0 < D := by
    dsimp only [D]
    exact CFMTrajectories.dHat_pos hd hp
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hdelta0 : 0 ≤ delta := by
    dsimp only [delta]
    exact (CFMTrajectories.delta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := CFMNumeric.coreEpsilon eta) hd hp).le
  have heLoBound : eLo ≤ 70 * Gamma * delta := by
    dsimp only [eLo, delta, internal, x]
    exact statusLoError_le E S R
  have hxi := R.xi_upper x hx
  have hfactor : 70 * Gamma *
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N x ≤ 1 := by
    calc
      70 * Gamma * CFMTrajectories.xi Gamma
          (CFMNumeric.coreEpsilon eta) d N x ≤
        70 * Gamma * d ^ (-CFMNumeric.coreEpsilon eta / 64) :=
          mul_le_mul_of_nonneg_left hxi (by positivity)
      _ ≤ 1 := seventyGamma_mul_envelope64_le_one E S
  have herrorD : eLo ≤ D := by
    calc
      eLo ≤ 70 * Gamma * delta := heLoBound
      _ = (70 * Gamma * CFMTrajectories.xi Gamma
          (CFMNumeric.coreEpsilon eta) d N x) * D := by
        dsimp only [delta, D]
        unfold CFMTrajectories.delta
        ring
      _ ≤ 1 * D := mul_le_mul_of_nonneg_right hfactor hD.le
      _ = D := one_mul D
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N x :=
    (CFMTrajectories.q_pos hp).le
  have hc0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N x := by
    unfold CFMTrajectories.cHat
    exact add_nonneg
      (add_nonneg
        (mul_nonneg R.degree.D₂_nonneg hq0)
        (mul_nonneg
          (mul_nonneg (mul_nonneg (by norm_num) R.degree.D₃_nonneg) hq0) hm))
      (mul_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) R.degree.D₄_nonneg) hq0)
        (pow_nonneg hm _))
  unfold certificateTestStatusLo
  dsimp only [eLo, delta, internal, D, x] at herrorD ⊢
  nlinarith

end CFMSharpTestCutoff

theorem greedyTransitionMass_pos_of_pathMassFrom_pos
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {T : ℕ} (omega : GreedyOutcome H T)
    (hmass : 0 < greedyPathMassFrom H C M omega)
    {k : ℕ} (hk : k < T) :
    0 < greedyTransitionMass H C
      (greedyStateFromAt H C M omega k) (greedyChoiceAt omega k) := by
  induction T generalizing M k with
  | zero => omega
  | succ T ih =>
      let o : GreedyChoice H := omega 0
      let tail : GreedyOutcome H T := fun i ↦ omega i.succ
      have htail0 : 0 ≤ greedyPathMassFrom H C
          (greedyChoiceStep H C M o) tail :=
        greedyPathMassFrom_nonneg H C _ _
      have hhead0 : 0 ≤ greedyTransitionMass H C M o :=
        greedyTransitionMass_nonneg H C M o
      have hsplit : 0 < greedyTransitionMass H C M o *
          greedyPathMassFrom H C (greedyChoiceStep H C M o) tail := by
        simpa [o, tail] using hmass
      have hhead : 0 < greedyTransitionMass H C M o := by nlinarith
      have htail : 0 < greedyPathMassFrom H C
          (greedyChoiceStep H C M o) tail := by nlinarith
      have homega : Fin.cons o tail = omega := by
        funext i
        refine Fin.cases ?_ (fun j ↦ ?_) i
        · simp [o]
        · simp [tail]
      cases k with
      | zero =>
          rw [← homega]
          simpa [o]
      | succ k =>
          have hk' : k < T := by omega
          have h := ih (greedyChoiceStep H C M o) tail htail hk'
          rw [← homega]
          simpa only [greedyStateFromAt_cons_succ,
            greedyChoiceAt_cons_succ] using h

/-- A positive-mass prefix which has not frozen has selected exactly one
new edge at every preceding step. -/
theorem card_greedyStateFromAt_eq_add_of_pos_mass_prefix_nonfreeze
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {T : ℕ} (omega : GreedyOutcome H T)
    (hmass : 0 < greedyPathMassFrom H C M omega)
    {k : ℕ} (hkT : k ≤ T)
    (hnonfreeze : ∀ i, i < k →
      (availableEdges H C (greedyStateFromAt H C M omega i)).Nonempty) :
    (greedyStateFromAt H C M omega k).card = M.card + k := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hk : k < T := by omega
      have hA := hnonfreeze k (Nat.lt_succ_self k)
      have hmassStep := greedyTransitionMass_pos_of_pathMassFrom_pos
        H C M omega hmass hk
      have hcardStep := greedyChoiceStep_card_eq_add_one_of_mass_pos
        H C (greedyStateFromAt H C M omega k)
          (greedyChoiceAt omega k) hA hmassStep
      rw [greedyStateFromAt_succ, hcardStep]
      have hprefix : ∀ i, i < k →
          (availableEdges H C
            (greedyStateFromAt H C M omega i)).Nonempty := by
        intro i hi
        exact hnonfreeze i (hi.trans (Nat.lt_succ_self k))
      rw [ih (Nat.le_of_lt hk) hprefix]
      omega

/-- Conditional moments for a stopped process whose local drift and square
bounds are valid only on states reached by positive-mass prefix-good tapes.
Zero-mass tapes vanish from every conditional expectation. -/
theorem greedyStoppedStepIncrement_momentBounds_reachable
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (Reachable : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hreachable : ∀ k, k < T → ∀ omega : GreedyOutcome H T,
      0 < greedyPathMassFrom H C M omega →
      greedyPrefixGood H C M Good k omega →
      Reachable k (greedyStateFromAt H C M omega k))
    (hmean : ∀ k, k < T → ∀ S, Good k S → Reachable k S →
      greedyStepExpectation H C S (step k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S, Good k S → Reachable k S →
      greedyStepExpectation H C S
        (fun S' ↦ (step k S S') ^ 2) ≤ varianceBudget k) :
    Freedman.ConditionalMomentBounds
      (greedyPathMassFrom H C M) (greedyInfo H T)
      (greedyStoppedStepIncrement H C M T Good step) varianceBudget := by
  constructor
  · intro k Z hZnonneg hZknown
    by_cases hk : k < T
    · let I : GreedyOutcome H T → ℝ :=
          greedyStopIndicator H C M Good k
      let ZI : GreedyOutcome H T → ℝ := fun omega ↦ Z omega * I omega
      have hInonneg : ∀ omega, 0 ≤ I omega := by
        intro omega
        exact greedyStopIndicator_nonneg H C M Good k omega
      have hZI_nonneg : ∀ omega, 0 ≤ ZI omega := by
        intro omega
        exact mul_nonneg (hZnonneg omega) (hInonneg omega)
      have hZI_known : Freedman.KnownAt (greedyInfo H T) k ZI :=
        hZknown.mul (greedyStopIndicator_known H C M T Good k)
      have htower := greedyPath_conditional_step₂ H C hk M ZI
        (fun S S' ↦ step k S S') hZI_known
      calc
        Freedman.expectation (greedyPathMassFrom H C M)
            (fun omega ↦ Z omega *
              greedyStoppedStepIncrement H C M T Good step k omega) =
            Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                step k (greedyStateFromAt H C M omega k)
                  (greedyStateFromAt H C M omega (k + 1))) := by
              rw [Freedman.expectation, Freedman.expectation]
              apply Finset.sum_congr rfl
              intro omega _
              simp only [greedyStoppedStepIncrement, hk, if_true, ZI, I]
              ring
        _ = Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                greedyStepExpectation H C (greedyStateFromAt H C M omega k)
                  (fun S' ↦ step k
                    (greedyStateFromAt H C M omega k) S')) := htower
        _ ≤ 0 := by
          rw [Freedman.expectation]
          apply Finset.sum_nonpos
          intro omega _
          by_cases hmass : 0 < greedyPathMassFrom H C M omega
          · by_cases hgood : greedyPrefixGood H C M Good k omega
            · have hcurrent : Good k (greedyStateFromAt H C M omega k) :=
                hgood k le_rfl
              have hreach := hreachable k hk omega hmass hgood
              exact mul_nonpos_of_nonneg_of_nonpos hmass.le
                (mul_nonpos_of_nonneg_of_nonpos (hZI_nonneg omega)
                  (hmean k hk _ hcurrent hreach))
            · have hZIzero : ZI omega = 0 := by
                simp [ZI, I, greedyStopIndicator, hgood]
              simp [hZIzero]
          · have hm0 : greedyPathMassFrom H C M omega = 0 := by
              exact le_antisymm (not_lt.mp hmass)
                (greedyPathMassFrom_nonneg H C M omega)
            simp [hm0]
    · simp [Freedman.expectation, greedyStoppedStepIncrement, hk]
  · intro k Z hZnonneg hZknown
    by_cases hk : k < T
    · let I : GreedyOutcome H T → ℝ :=
          greedyStopIndicator H C M Good k
      let ZI : GreedyOutcome H T → ℝ := fun omega ↦ Z omega * I omega
      have hInonneg : ∀ omega, 0 ≤ I omega := by
        intro omega
        exact greedyStopIndicator_nonneg H C M Good k omega
      have hIle : ∀ omega, I omega ≤ 1 := by
        intro omega
        exact greedyStopIndicator_le_one H C M Good k omega
      have hZI_nonneg : ∀ omega, 0 ≤ ZI omega := by
        intro omega
        exact mul_nonneg (hZnonneg omega) (hInonneg omega)
      have hZI_le : ∀ omega, ZI omega ≤ Z omega := by
        intro omega
        dsimp only [ZI]
        nlinarith [hZnonneg omega, hInonneg omega, hIle omega]
      have hZI_known : Freedman.KnownAt (greedyInfo H T) k ZI :=
        hZknown.mul (greedyStopIndicator_known H C M T Good k)
      have htower := greedyPath_conditional_step₂ H C hk M ZI
        (fun S S' ↦ (step k S S') ^ 2) hZI_known
      calc
        Freedman.expectation (greedyPathMassFrom H C M)
            (fun omega ↦ Z omega *
              (greedyStoppedStepIncrement H C M T Good step k omega) ^ 2) =
            Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                (step k (greedyStateFromAt H C M omega k)
                  (greedyStateFromAt H C M omega (k + 1))) ^ 2) := by
              rw [Freedman.expectation, Freedman.expectation]
              apply Finset.sum_congr rfl
              intro omega _
              by_cases hgood : greedyPrefixGood H C M Good k omega <;>
                simp [greedyStoppedStepIncrement, hk, ZI, I,
                  greedyStopIndicator, hgood]
        _ = Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                greedyStepExpectation H C (greedyStateFromAt H C M omega k)
                  (fun S' ↦ (step k
                    (greedyStateFromAt H C M omega k) S') ^ 2)) := htower
        _ ≤ Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega * varianceBudget k) := by
          rw [Freedman.expectation, Freedman.expectation]
          apply Finset.sum_le_sum
          intro omega _
          by_cases hmass : 0 < greedyPathMassFrom H C M omega
          · by_cases hgood : greedyPrefixGood H C M Good k omega
            · have hcurrent : Good k (greedyStateFromAt H C M omega k) :=
                hgood k le_rfl
              have hreach := hreachable k hk omega hmass hgood
              exact mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left
                  (hvariance k hk _ hcurrent hreach) (hZI_nonneg omega))
                hmass.le
            · have hZIzero : ZI omega = 0 := by
                simp [ZI, I, greedyStopIndicator, hgood]
              simp [hZIzero]
          · have hm0 : greedyPathMassFrom H C M omega = 0 := by
              exact le_antisymm (not_lt.mp hmass)
                (greedyPathMassFrom_nonneg H C M omega)
            simp [hm0]
        _ ≤ Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ Z omega * varianceBudget k) := by
          rw [Freedman.expectation, Freedman.expectation]
          apply Finset.sum_le_sum
          intro omega _
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_right (hZI_le omega)
              (hvariance_nonneg k))
            (greedyPathMassFrom_nonneg H C M omega)
        _ = varianceBudget k *
              Freedman.expectation (greedyPathMassFrom H C M) Z := by
          rw [Freedman.expectation, Freedman.expectation, Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro omega _
          ring
    · have hEZ :
          0 ≤ Freedman.expectation (greedyPathMassFrom H C M) Z := by
        rw [Freedman.expectation]
        apply Finset.sum_nonneg
        intro omega _
        exact mul_nonneg (greedyPathMassFrom_nonneg H C M omega)
          (hZnonneg omega)
      have hprod := mul_nonneg (hvariance_nonneg k) hEZ
      simpa [Freedman.expectation, greedyStoppedStepIncrement, hk] using hprod

/-! ## Reachable source budgets

The source estimates below deliberately quantify the mean and conditional
square fields only over genuine greedy states.  Pointwise jumps remain
unconditional on reachability, as required by Freedman's bounded-increment
hypothesis. -/

/-- Statewise form of the usual degree-corridor nonfreezing lemma.  The
matching invariant and exact time-cardinality are supplied by reachability
instead of being reconstructed from a concrete tape. -/
theorem availableEdges_nonempty_of_degreeLowerCorridors_reachable
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (M : Hypergraph V) (hM : IsConflictFreeMatching H C M)
    (T k : ℕ) (hk : k < T) (hcard : M.card = k)
    (hsize : 8 * T < (vertexFinset H).card)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (htrajectory : 0 <
      CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))
    (hcorridor : ∀ v ∈ uncoveredVertices H M,
      degreeLowerCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k M) :
    (availableEdges H C M).Nonempty := by
  have hcovered : 8 * M.card < (vertexFinset H).card := by omega
  have huncovered : (uncoveredVertices H M).Nonempty := by
    apply Finset.card_pos.mp
    rw [card_uncoveredVertices_of_uniform_matching hH hM.1]
    omega
  obtain ⟨v, hv⟩ := huncovered
  have herr : degreeLowerError H C v
      D₂ D₃ D₄ Gamma epsilon d N k M < 0 := by
    rcases hcorridor v hv with hnot | herr
    · exact False.elim (hnot hv)
    · exact herr
  by_contra hnonempty
  have hempty : availableEdges H C M = ∅ := by
    rw [← not_ne_iff]
    simpa only [Finset.nonempty_iff_ne_empty] using hnonempty
  rw [degreeLowerError, hempty] at herr
  simp only [degree, Finset.filter_empty, Finset.card_empty, Nat.cast_zero,
    sub_zero] at herr
  linarith

/-- If every good reachable state before the horizon has a legal next
choice, then a positive-mass good prefix starting from the empty matching
has selected exactly `k` edges at time `k`. -/
theorem card_greedyStateFromAt_empty_eq_time_of_good_available
    (H : Hypergraph V) (C : ConflictSystem V) (hCempty : ∅ ∉ C)
    (Good : ℕ → Hypergraph V → Prop) {T : ℕ}
    (omega : GreedyOutcome H T)
    (hmass : 0 < greedyPathMassFrom H C ∅ omega)
    (havailable : ∀ k, k < T → ∀ S, Good k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty) :
    ∀ k, k ≤ T → greedyPrefixGood H C ∅ Good k omega →
      (greedyStateFromAt H C ∅ omega k).card = k := by
  intro k hkT hgood
  induction k with
  | zero => simp
  | succ k ih =>
      have hk : k < T := by omega
      have hprefix : greedyPrefixGood H C ∅ Good k omega := by
        intro i hi
        exact hgood i (hi.trans (Nat.le_succ k))
      have hcard := ih (Nat.le_of_lt hk) hprefix
      have hstate : IsConflictFreeMatching H C
          (greedyStateFromAt H C ∅ omega k) := by
        rw [← greedyStateAt_eq_stateFrom_empty]
        exact greedyStateAt_isConflictFreeMatching H C hCempty omega k
      have hA := havailable k hk
        (greedyStateFromAt H C ∅ omega k) (hgood k (by omega))
        hstate hcard
      have hmassStep := greedyTransitionMass_pos_of_pathMassFrom_pos
        H C ∅ omega hmass hk
      have hstep := greedyChoiceStep_card_eq_add_one_of_mass_pos
        H C (greedyStateFromAt H C ∅ omega k)
          (greedyChoiceAt omega k) hA hmassStep
      rw [greedyStateFromAt_succ, hstep, hcard]

/-- External test source budgets whose drift and square estimates are needed
only on conflict-free matching states with the exact time-cardinality. -/
structure ReachableExternalTestSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) : Prop where
  arity : j ≤ 3
  weight_nonneg : 0 ≤ W
  registry : ∀ k, k < T → ∀ S, Good k S →
    CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s
  meanLower : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPartialTestGain w H C j s S - meanPartialTestLoss w H C j s S
  meanUpper : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    meanPartialTestGain w H C j s S - meanPartialTestLoss w H C j s S ≤
      W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) -
        2 * (d ^ ((s : ℝ) - j - epsilon) / N))
  upperJump : ∀ k, k < T → ∀ S, Good k S → ∀ o : GreedyChoice H,
    |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
      (k : ℝ) j s S (greedyChoiceStep H C S o)| ≤ jump k
  lowerJump : ∀ k, k < T → ∀ S, Good k S → ∀ o : GreedyChoice H,
    |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
      (k : ℝ) j s S (greedyChoiceStep H C S o)| ≤ jump k
  upperSquare : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    greedyStepExpectation H C S (fun S' ↦
      (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s S S') ^ 2) ≤ variance k
  lowerSquare : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    greedyStepExpectation H C S (fun S' ↦
      (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s S S') ^ 2) ≤ variance k

theorem externalTestStoppedMomentBounds_of_reachableSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (hCempty : ∅ ∉ C) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (_hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, Good k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachableExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P W j s jump variance) :
    Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C ∅) (greedyInfo H T)
        (greedyStoppedStepIncrement H C ∅ T Good
          (fun k S S' ↦ externalTestUpperStep w H C
            D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s S S')) variance ∧
      Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C ∅) (greedyInfo H T)
        (greedyStoppedStepIncrement H C ∅ T Good
          (fun k S S' ↦ externalTestLowerStep w H C
            D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s S S')) variance := by
  let Reachable : ℕ → Hypergraph V → Prop := fun k S ↦
    IsConflictFreeMatching H C S ∧ S.card = k
  have hreachable : ∀ k, k < T → ∀ omega : GreedyOutcome H T,
      0 < greedyPathMassFrom H C ∅ omega →
      greedyPrefixGood H C ∅ Good k omega →
      Reachable k (greedyStateFromAt H C ∅ omega k) := by
    intro k hk omega hmass hgood
    constructor
    · rw [← greedyStateAt_eq_stateFrom_empty]
      exact greedyStateAt_isConflictFreeMatching H C hCempty omega k
    · exact card_greedyStateFromAt_empty_eq_time_of_good_available
        H C hCempty Good omega hmass havailable k (Nat.le_of_lt hk) hgood
  constructor <;> apply greedyStoppedStepIncrement_momentBounds_reachable
  · exact hvariance
  · exact hreachable
  · intro k hk S hgood hreach
    exact (externalTest_oneState_stoppedDrift
      (B.registry k hk S hgood) B.arity S B.weight_nonneg
      (B.meanLower k hk S hgood hreach.1 hreach.2)
      (B.meanUpper k hk S hgood hreach.1 hreach.2)).1
  · intro k hk S hgood hreach
    exact B.upperSquare k hk S hgood hreach.1 hreach.2
  · exact hvariance
  · exact hreachable
  · intro k hk S hgood hreach
    exact (externalTest_oneState_stoppedDrift
      (B.registry k hk S hgood) B.arity S B.weight_nonneg
      (B.meanLower k hk S hgood hreach.1 hreach.2)
      (B.meanUpper k hk S hgood hreach.1 hreach.2)).2
  · intro k hk S hgood hreach
    exact B.lowerSquare k hk S hgood hreach.1 hreach.2

/-- Internal-link counterpart of the reachable external source package. -/
structure ReachableInternalConflictLinkSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) : Prop where
  scale_nonneg : 0 ≤ scale
  registry : ∀ k, k < T → ∀ S, Good k S →
    CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s
  meanLower : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPartialTestGain (conflictLinkTestWeight C f j) H C j s S -
        meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s S
  meanUpper : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    meanPartialTestGain (conflictLinkTestWeight C f j) H C j s S -
        meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s S ≤
      scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) -
        2 * (d ^ ((s : ℝ) - j - epsilon) / N))
  upperJump : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S → ∀ o : GreedyChoice H,
    |activeInternalConflictLinkUpperStep H C f
      D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
        (greedyChoiceStep H C S o)| ≤ jump k
  lowerJump : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S → ∀ o : GreedyChoice H,
    |activeInternalConflictLinkLowerStep H C f
      D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
        (greedyChoiceStep H C S o)| ≤ jump k
  upperSquare : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    greedyStepExpectation H C S (fun S' ↦
      (activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') ^ 2) ≤
      variance k
  lowerSquare : ∀ k, k < T → ∀ S, Good k S →
    IsConflictFreeMatching H C S → S.card = k →
    f ∈ availableEdges H C S →
    greedyStepExpectation H C S (fun S' ↦
      (activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') ^ 2) ≤
      variance k

theorem activeInternalConflictLinkStoppedMomentBounds_of_reachableSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (hCempty : ∅ ∉ C) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (_hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, Good k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachableInternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C ∅) (greedyInfo H T)
        (greedyStoppedStepIncrement H C ∅ T Good
          (fun k S S' ↦ activeInternalConflictLinkUpperStep H C f
            D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S')) variance ∧
      Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C ∅) (greedyInfo H T)
        (greedyStoppedStepIncrement H C ∅ T Good
          (fun k S S' ↦ activeInternalConflictLinkLowerStep H C f
            D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S')) variance := by
  let Reachable : ℕ → Hypergraph V → Prop := fun k S ↦
    IsConflictFreeMatching H C S ∧ S.card = k
  have hreachable : ∀ k, k < T → ∀ omega : GreedyOutcome H T,
      0 < greedyPathMassFrom H C ∅ omega →
      greedyPrefixGood H C ∅ Good k omega →
      Reachable k (greedyStateFromAt H C ∅ omega k) := by
    intro k hk omega hmass hgood
    constructor
    · rw [← greedyStateAt_eq_stateFrom_empty]
      exact greedyStateAt_isConflictFreeMatching H C hCempty omega k
    · exact card_greedyStateFromAt_empty_eq_time_of_good_available
        H C hCempty Good omega hmass havailable k (Nat.le_of_lt hk) hgood
  constructor <;> apply greedyStoppedStepIncrement_momentBounds_reachable
  · exact hvariance
  · exact hreachable
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact (activeInternalConflictLink_oneState_stoppedDrift hC f
        (B.registry k hk S hgood) B.scale_nonneg S hf
        (B.meanLower k hk S hgood hreach.1 hreach.2 hf)
        (B.meanUpper k hk S hgood hreach.1 hreach.2 hf)).1
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).1]
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact B.upperSquare k hk S hgood hreach.1 hreach.2 hf
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_sq_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).1]
      exact hvariance k
  · exact hvariance
  · exact hreachable
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact (activeInternalConflictLink_oneState_stoppedDrift hC f
        (B.registry k hk S hgood) B.scale_nonneg S hf
        (B.meanLower k hk S hgood hreach.1 hreach.2 hf)
        (B.meanUpper k hk S hgood hreach.1 hreach.2 hf)).2
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).2]
  · intro k hk S hgood hreach
    by_cases hf : f ∈ availableEdges H C S
    · exact B.lowerSquare k hk S hgood hreach.1 hreach.2 hf
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_sq_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).2]
      exact hvariance k

theorem externalTestStoppedIncrements_abs_le_of_reachableSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) {R : ℝ}
    (hR0 : 0 ≤ R) (hR : ∀ k, k < T → jump k ≤ R)
    (B : ReachableExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P W j s jump variance) :
    (∀ k omega,
      |greedyStoppedStepIncrement H C ∅ T Good
        (fun i S S' ↦ externalTestUpperStep w H C
          D₂ D₃ D₄ Gamma epsilon d N W (i : ℝ) j s S S')
        k omega| ≤ R) ∧
      (∀ k omega,
      |greedyStoppedStepIncrement H C ∅ T Good
        (fun i S S' ↦ externalTestLowerStep w H C
          D₂ D₃ D₄ Gamma epsilon d N W (i : ℝ) j s S S')
        k omega| ≤ R) := by
  constructor <;> apply greedyStoppedStepIncrement_abs_le_of_local <;>
    try exact hR0
  · intro k hk S hgood o
    exact (B.upperJump k hk S hgood o).trans (hR k hk)
  · intro k hk S hgood o
    exact (B.lowerJump k hk S hgood o).trans (hR k hk)

theorem externalTestFreedman_of_reachableSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (hCempty : ∅ ∉ C) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P Wscale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, Good k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachableExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P Wscale j s jump variance)
    {R t Wvar : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ Wvar)
    (hden : 0 < Wvar + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ Wvar) :
    Freedman.eventMass (greedyPathMassFrom H C ∅)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C ∅ T Good
              (fun i S S' ↦ externalTestUpperStep w H C
                D₂ D₃ D₄ Gamma epsilon d N Wscale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C ∅)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C ∅ T Good
              (fun i S S' ↦ externalTestLowerStep w H C
                D₂ D₃ D₄ Gamma epsilon d N Wscale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have hm := externalTestStoppedMomentBounds_of_reachableSourceBudgets
    w H C hCempty Good T D₂ D₃ D₄ Gamma epsilon d N P Wscale j s
      jump variance hjump hvariance havailable B
  have hinc := externalTestStoppedIncrements_abs_le_of_reachableSourceBudgets
    w H C Good T D₂ D₃ D₄ Gamma epsilon d N P Wscale j s
      jump variance hR0 hR B
  constructor
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C ∅)
      (sum_greedyPathMassFrom H C ∅ T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C ∅ T Good
        (fun i S S' ↦ externalTestUpperStep w H C
          D₂ D₃ D₄ Gamma epsilon d N Wscale (i : ℝ) j s S S') k)
      hm.1 hR0 ht hW0 hden hinc.1 hW
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C ∅)
      (sum_greedyPathMassFrom H C ∅ T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C ∅ T Good
        (fun i S S' ↦ externalTestLowerStep w H C
          D₂ D₃ D₄ Gamma epsilon d N Wscale (i : ℝ) j s S S') k)
      hm.2 hR0 ht hW0 hden hinc.2 hW

theorem externalTestFirstFailureMass_le_of_reachableSourceBudgets
    {ι : Type*} [Fintype ι]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (hCempty : ∅ ∉ C) (T : ℕ)
    (Pgood : ι → ℕ → Hypergraph V → Prop)
    (iUpper iLower : ι)
    (D₂ D₃ D₄ Gamma epsilon d N P Wscale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, indexedGreedyGood Pgood k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachableExternalTestSourceBudgets w H C
      (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P Wscale j s jump variance)
    {R t Wvar : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ Wvar)
    (hden : 0 < Wvar + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ Wvar)
    (hUpperComponent : ∀ k S, Pgood iUpper k S ↔
      externalTestUpperCorridor w H C
        D₂ D₃ D₄ Gamma epsilon d N Wscale j s k S)
    (hLowerComponent : ∀ k S, Pgood iLower k S ↔
      externalTestLowerCorridor w H C
        D₂ D₃ D₄ Gamma epsilon d N Wscale j s k S)
    (hUpperInitial : externalTestUpperError w H C
      D₂ D₃ D₄ Gamma epsilon d N Wscale j s 0 ∅ ≤ -t)
    (hLowerInitial : externalTestLowerError w H C
      D₂ D₃ D₄ Gamma epsilon d N Wscale j s 0 ∅ ≤ -t) :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ T Pgood iUpper) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ T Pgood iLower) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have htail := externalTestFreedman_of_reachableSourceBudgets
    w H C hCempty (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P Wscale j s
      jump variance hjump hvariance havailable B hR0 ht hW0 hden hR hW
  constructor
  · exact (eventMass_mono_of_nonneg (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (externalTestUpperFirstFailureEvent_subset_tail w H C ∅ T
        Pgood iUpper D₂ D₃ D₄ Gamma epsilon d N Wscale t j s
        hUpperComponent hUpperInitial)).trans htail.1
  · exact (eventMass_mono_of_nonneg (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (externalTestLowerFirstFailureEvent_subset_tail w H C ∅ T
        Pgood iLower D₂ D₃ D₄ Gamma epsilon d N Wscale t j s
        hLowerComponent hLowerInitial)).trans htail.2

theorem activeInternalConflictLinkStoppedIncrements_abs_le_of_reachableSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) {R : ℝ}
    (hR0 : 0 ≤ R) (hR : ∀ k, k < T → jump k ≤ R)
    (B : ReachableInternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    (∀ k omega,
      |greedyStoppedStepIncrement H C ∅ T Good
        (fun i S S' ↦ activeInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S')
        k omega| ≤ R) ∧
      (∀ k omega,
      |greedyStoppedStepIncrement H C ∅ T Good
        (fun i S S' ↦ activeInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S')
        k omega| ≤ R) := by
  constructor <;> apply greedyStoppedStepIncrement_abs_le_of_local <;>
