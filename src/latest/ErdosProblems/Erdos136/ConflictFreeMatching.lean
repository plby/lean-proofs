    exact hratio.2.1.trans_lt ((div_lt_iff₀ hu).2 h12)
  calc
    (1 : ℝ) / 4 = 1 - 3 / 4 := by norm_num
    _ ≤ 1 - (degree (availableEdges H R.regularized M) v.1 : ℝ) /
        ((availableEdges H R.regularized M).card : ℝ) :=
      sub_le_sub_left hratioThree.le 1
theorem meanSqMissAvailableDegreeLoss_le_sourceVariance_of_degreeEnhancedGood
    {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} {ell k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hGamma54 : 54 ≤ Gamma)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
