      ((s + 1 : ℕ) : ℝ) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j (s + 1) (k : ℝ))) -
        24 * W * d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 16) -
        (s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ))) ∧
      ((s + 1 : ℕ) : ℝ) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j (s + 1) (k : ℝ))) -
        ((s : ℝ) * certificateTestStatusLo D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N (d ^ (1 - eta))
              (1536 * localSpreadPrimaryMargin eta d) k *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ))) -
          (((s.choose 2 * (4 *
              (64 * Nat.ceil (d ^ (1 - eta)) +
                16 * certificateMixedLossCapNat eta
                  (CFMRegularization.rawRegularizationEps eta) d +
                Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ) *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ))))) ≤
      (W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) -
        2 * (d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N))) * a := by
  let eps := CFMNumeric.coreEpsilon eta
  let x : ℝ := k
  let h := CFMTrajectories.hHat D₂ D₃ D₄ d N x
  let Z := CFMTrajectories.zHat D₂ D₃ D₄ d N j s x
  let Zp := CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) x
  let Env := CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j s x
  let Envp := CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j (s + 1) x
  let b := CFMTrajectories.cHat D₂ D₃ D₄ d N x +
    8 * CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let internal := degreeInternalCorridorError D₂ D₃ D₄ Gamma eps d N k
  let delta := CFMTrajectories.delta D₂ D₃ D₄ Gamma eps d N x
  let eHi := 8 * delta + internal
  let eLo := 8 * delta + 28 * d ^ (1 - eta) + internal +
    1536 * localSpreadPrimaryMargin eta d
  let gain := 24 * d ^ ((s : ℝ) + 1 - j -
    CFMRegularization.rawRegularizationEps eta / 16)
  let K : ℝ := ((s.choose 2 * (4 *
      (64 * Nat.ceil (d ^ (1 - eta)) +
        16 * certificateMixedLossCapNat eta
          (CFMRegularization.rawRegularizationEps eta) d +
        Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ)
  let loss := K * (Z + Env)
  let rem := d ^ ((s : ℝ) - j - eps) / N
  let scale := Gamma * Env / (N * CFMTrajectories.pV N x)
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end x hx)
  have hp1 := CFMTrajectories.pV_le_one R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have heps0 : 0 ≤ eps := by
    dsimp only [eps]
    rw [coreEpsilon_eq]
    linarith [E.eta_pos]
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      hd R.delta.degree.N_pos hp
  have hD := CFMTrajectories.dHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hp
  have hZ0 : 0 ≤ Z := by
    dsimp only [Z]
    unfold CFMTrajectories.zHat
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (CFMTrajectories.q_pos hp).le _))
      (pow_nonneg hm _)
  have hEnv0 : 0 ≤ Env := by
    dsimp only [Env, eps]
    exact (CFMTrajectories.zeta_pos hd (lt_of_lt_of_le zero_lt_one E.Gamma_one)
      hp hm R.s_le_j).le
  have hscale0 : 0 ≤ scale := by
    dsimp only [scale]
    exact div_nonneg (mul_nonneg hGamma0 hEnv0)
      (mul_nonneg R.delta.degree.N_pos.le hp.le)
  have hxi := (R.delta.xi_upper x hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have haLower : (4 / 5 : ℝ) * h ≤ a := by
    have hm := mul_le_mul_of_nonneg_left hxi hh.le
    dsimp only [h, x, eps] at haLo ⊢
    nlinarith
  have haUpper : a ≤ (6 / 5 : ℝ) * h := by
    have hm := mul_le_mul_of_nonneg_left hxi hh.le
    dsimp only [h, x, eps] at haHi ⊢
    nlinarith
  have hrate : h * CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x =
      ((s + 1 : ℕ) : ℝ) * Zp - (s : ℝ) * b * Z := by
    dsimp only [h, Z, Zp, b]
    exact CFMTrajectories.zHatRate_mul_hHat (ne_of_gt hh)
  have hmismatch : |(a - h) * CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s x| ≤
      2000 * h * scale := by
    dsimp only [h, scale, Env, eps, x] at haLo haHi ⊢
    exact CFMTrajectories.zHatRate_handshake_mismatch_le R haLo haHi
  have hnextRaw := CFMTrajectories.zeta_successor_div_hHat_le
    (epsilon := eps) hd R.delta.degree.N_pos R.delta.degree.Gamma_one
    (R.delta.degree.time_nonneg x hx) (R.delta.degree.before_end x hx)
    R.delta.degree.D₂_nonneg R.delta.degree.D₃_nonneg R.delta.degree.D₄_nonneg
    R.s_le_j R.j_le_four
  have hnext : ((s + 1 : ℕ) : ℝ) * Envp ≤ 1280 * h * scale := by
    have hnext' := (div_le_iff₀ hh).mp hnextRaw
    dsimp only [Envp, h, scale, Env, x, eps]
    calc
      ((s + 1 : ℕ) : ℝ) *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta)
            d N j (s + 1) (k : ℝ) ≤
        (1280 * Gamma / (N * CFMTrajectories.pV N (k : ℝ)) *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)) *
              CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) := hnext'
      _ = _ := by ring
  have hs4 : (s : ℝ) ≤ 4 := by exact_mod_cast R.s_le_j.trans R.j_le_four
  have hb := CFMTrajectories.cHat_add_eight_dHat_le_fourteen R.delta.degree
  have hq0 : 0 ≤ CFMTrajectories.q D₂ D₃ D₄ d N x :=
    (CFMTrajectories.q_pos hp).le
  have hc0 : 0 ≤ CFMTrajectories.cHat D₂ D₃ D₄ d N x := by
    unfold CFMTrajectories.cHat
    exact add_nonneg
      (add_nonneg
        (mul_nonneg R.delta.degree.D₂_nonneg hq0)
        (mul_nonneg
          (mul_nonneg (mul_nonneg (by norm_num) R.delta.degree.D₃_nonneg) hq0) hm))
      (mul_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) R.delta.degree.D₄_nonneg) hq0)
        (pow_nonneg hm _))
  have hb0 : 0 ≤ b := by
    dsimp only [b]
    exact add_nonneg hc0 (mul_nonneg (by norm_num) hD.le)
  have hid : h = N * CFMTrajectories.pV N x *
      CFMTrajectories.dHat D₂ D₃ D₄ d N x / 8 := by
    dsimp only [h]
    unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
    ring
  have hcurrent : (s : ℝ) * b * Env ≤ 500 * h * scale := by
    calc
      (s : ℝ) * b * Env ≤
          4 * (14 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x) * Env := by
        have hsMul : (s : ℝ) * b ≤ 4 * b :=
          mul_le_mul_of_nonneg_right hs4 hb0
        have hbMul : 4 * b ≤
            4 * (14 * Gamma * CFMTrajectories.dHat D₂ D₃ D₄ d N x) :=
          mul_le_mul_of_nonneg_left (by simpa only [b, x] using hb) (by norm_num)
        exact mul_le_mul_of_nonneg_right (hsMul.trans hbMul) hEnv0
      _ ≤ 500 * h * scale := by
        rw [hid]
        dsimp only [scale]
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
        nlinarith [mul_nonneg (mul_nonneg hGamma0 hD.le) hEnv0]
  have hdelta0 : 0 ≤ delta := by
    dsimp only [delta, eps]
    exact (CFMTrajectories.delta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := CFMNumeric.coreEpsilon eta) hd hp).le
  have hz11 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := eps) (j := 1) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hz21 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := eps) (j := 2) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hz31 := (CFMTrajectories.zeta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := eps) (j := 3) (s := 1)
    hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm (by omega)).le
  have hinternal0 : 0 ≤ internal := by
    dsimp only [internal, degreeInternalCorridorError, x]
    exact add_nonneg
      (add_nonneg (mul_nonneg R.delta.degree.D₂_nonneg hz11)
        (mul_nonneg R.delta.degree.D₃_nonneg hz21))
      (mul_nonneg R.delta.degree.D₄_nonneg hz31)
  have heHi0 : 0 ≤ eHi := by dsimp only [eHi]; positivity
  have hpowEta0 : 0 ≤ d ^ (1 - eta) := Real.rpow_nonneg hd.le _
  have hmargin0 : 0 ≤ localSpreadPrimaryMargin eta d := by
    unfold localSpreadPrimaryMargin
    exact div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num)
  have heLo0 : 0 ≤ eLo := by
    dsimp only [eLo]
    exact add_nonneg
      (add_nonneg
        (add_nonneg (mul_nonneg (by norm_num) hdelta0)
          (mul_nonneg (by norm_num) hpowEta0))
        hinternal0)
      (mul_nonneg (by norm_num) hmargin0)
  have heHiBound : eHi ≤ 16 * Gamma * delta := by
    dsimp only [eHi, delta, internal, eps, x]
    exact statusHiError_le E R.delta
  have heLoBound : eLo ≤ 70 * Gamma * delta := by
    dsimp only [eLo, delta, internal, eps, x]
    exact statusLoError_le E S R.delta
  have hstatusHiCoeff : (s : ℝ) * eHi ≤ 500 * Gamma * delta := by
    calc
      (s : ℝ) * eHi ≤ 4 * eHi := mul_le_mul_of_nonneg_right hs4 heHi0
      _ ≤ 4 * (16 * Gamma * delta) := mul_le_mul_of_nonneg_left heHiBound (by norm_num)
      _ ≤ 500 * Gamma * delta := by
        nlinarith [mul_nonneg hGamma0 hdelta0]
  have hstatusHi : (s : ℝ) * eHi * (Z + Env) ≤ 5000 * h * scale := by
    simpa only [h, Z, Env, scale, delta, eps, x] using
      corridorProduct_le_commonScale S R
        (mul_nonneg (Nat.cast_nonneg _) heHi0) hstatusHiCoeff
  have hstatusLoCoeff : (s : ℝ) * eLo ≤ 500 * Gamma * delta := by
    calc
      (s : ℝ) * eLo ≤ 4 * eLo := mul_le_mul_of_nonneg_right hs4 heLo0
      _ ≤ 4 * (70 * Gamma * delta) := mul_le_mul_of_nonneg_left heLoBound (by norm_num)
      _ ≤ 500 * Gamma * delta := by
        nlinarith [mul_nonneg hGamma0 hdelta0]
  have hstatusLoSum : (s : ℝ) * eLo * (Z + Env) ≤ 5000 * h * scale := by
    simpa only [h, Z, Env, scale, delta, eps, x] using
      corridorProduct_le_commonScale S R
        (mul_nonneg (Nat.cast_nonneg _) heLo0) hstatusLoCoeff
  have hstatusLo : (s : ℝ) * eLo * (Z - Env) ≤ 5000 * h * scale := by
    calc
      (s : ℝ) * eLo * (Z - Env) ≤ (s : ℝ) * eLo * (Z + Env) := by
        have hcoef0 : 0 ≤ (s : ℝ) * eLo :=
          mul_nonneg (Nat.cast_nonneg s) heLo0
        apply mul_le_mul_of_nonneg_left _ hcoef0
        linarith
      _ ≤ _ := hstatusLoSum
  have hDlo := R.delta.dHat_lower x hx
  have hEnvlo := (CFMTrajectories.zeta_bounds_of_registry R hx).1
  have hraw : CFMRegularization.rawRegularizationEps eta = 5 * eps := by
    dsimp only [eps, CFMNumeric.coreEpsilon, CFMRegularization.rawRegularizationEps]
    ring
  have hgainPow : d ^ ((s : ℝ) + 1 - j -
        CFMRegularization.rawRegularizationEps eta / 16) ≤
      CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env := by
    have hexp : (s : ℝ) + 1 - j -
        CFMRegularization.rawRegularizationEps eta / 16 ≤
      (1 - eps / 32) + ((s : ℝ) - j - eps / 16) := by
      rw [hraw]
      linarith
    calc
      d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 16) ≤
        d ^ ((1 - eps / 32) + ((s : ℝ) - j - eps / 16)) :=
          Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one hexp
      _ = d ^ (1 - eps / 32) * d ^ ((s : ℝ) - j - eps / 16) :=
        Real.rpow_add hd _ _
      _ ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env :=
        mul_le_mul hDlo hEnvlo (Real.rpow_nonneg hd.le _) hD.le
  have hgain : gain ≤ 1000 * h * scale := by
    have hcoef : (24 : ℝ) ≤ 125 * Gamma := by
      calc
        (24 : ℝ) ≤ 125 := by norm_num
        _ = 125 * 1 := by ring
        _ ≤ 125 * Gamma := mul_le_mul_of_nonneg_left E.Gamma_one (by norm_num)
    have hgain24 : gain ≤
        24 * (CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env) := by
      dsimp only [gain]
      exact mul_le_mul_of_nonneg_left hgainPow (by norm_num)
    calc
      gain ≤ 24 * (CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env) := hgain24
      _ ≤ 125 * Gamma * (CFMTrajectories.dHat D₂ D₃ D₄ d N x * Env) :=
        mul_le_mul_of_nonneg_right hcoef (mul_nonneg hD.le hEnv0)
      _ = 1000 * h * scale := by
        rw [hid]
        dsimp only [scale]
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
        ring
  have hK0 : 0 ≤ K := by dsimp only [K]; positivity
  have hKdelta : K ≤ delta := by
    dsimp only [K, delta, eps, x]
    exact lossCoefficient_le_delta E S R.delta R.s_le_j R.j_le_four
  have hKbound : K ≤ 500 * Gamma * delta := by
    have hdeltaGamma : delta ≤ Gamma * delta := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right E.Gamma_one hdelta0
    have hGammaDelta0 : 0 ≤ Gamma * delta := mul_nonneg hGamma0 hdelta0
    calc
      K ≤ delta := hKdelta
      _ ≤ Gamma * delta := hdeltaGamma
      _ = 1 * (Gamma * delta) := by ring
      _ ≤ 500 * (Gamma * delta) :=
        mul_le_mul_of_nonneg_right (by norm_num) hGammaDelta0
      _ = 500 * Gamma * delta := by ring
  have hloss : loss ≤ 5000 * h * scale := by
    dsimp only [loss]
    simpa only [h, Z, Env, scale, delta, eps, x] using
      corridorProduct_le_commonScale S R hK0 hKbound
  have hpowRem : d ^ ((s : ℝ) - j - eps) ≤ Env := by
    calc
      d ^ ((s : ℝ) - j - eps) ≤
          d ^ ((s : ℝ) - j - eps / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
        linarith
      _ ≤ Env := hEnvlo
  have hremScale : rem ≤ scale := by
    have hprod : CFMTrajectories.pV N x * d ^ ((s : ℝ) - j - eps) ≤
        Gamma * Env := by
      calc
        CFMTrajectories.pV N x * d ^ ((s : ℝ) - j - eps) ≤ 1 * Env :=
          mul_le_mul hp1 hpowRem (Real.rpow_nonneg hd.le _) (by norm_num)
        _ ≤ Gamma * Env := mul_le_mul_of_nonneg_right E.Gamma_one hEnv0
    dsimp only [rem, scale]
    calc
      d ^ ((s : ℝ) - j - eps) / N =
          (CFMTrajectories.pV N x * d ^ ((s : ℝ) - j - eps)) /
            (N * CFMTrajectories.pV N x) := by
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
      _ ≤ (Gamma * Env) / (N * CFMTrajectories.pV N x) :=
        div_le_div_of_nonneg_right hprod
          (mul_nonneg R.delta.degree.N_pos.le hp.le)
  have hrem : 2 * a * rem ≤ 1000 * h * scale := by
    have hrem0 : 0 ≤ rem := by
      dsimp only [rem]
      exact div_nonneg (Real.rpow_nonneg hd.le _) R.delta.degree.N_pos.le
    have htwoUpper0 : 0 ≤ 2 * ((6 / 5 : ℝ) * h) := by positivity
    have haTwo : 2 * a ≤ 2 * ((6 / 5 : ℝ) * h) :=
      mul_le_mul_of_nonneg_left haUpper (by norm_num)
    have hhs0 : 0 ≤ h * scale := mul_nonneg hh.le hscale0
    calc
      2 * a * rem ≤ 2 * ((6 / 5 : ℝ) * h) * scale :=
        mul_le_mul haTwo hremScale hrem0 htwoUpper0
      _ = (12 / 5 : ℝ) * (h * scale) := by ring
      _ ≤ 1000 * (h * scale) :=
        mul_le_mul_of_nonneg_right (by norm_num) hhs0
      _ = 1000 * h * scale := by ring
  have henvelopeRaw := CFMTrajectories.zetaRate_lower_of_registry R
  have henvelope : 40000 * scale ≤
      CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s x := by
    have h76000 : 76000 * scale ≤
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma eps d N j s x := by
      dsimp only [scale]
      convert henvelopeRaw using 1 <;> ring
    exact (mul_le_mul_of_nonneg_right
      (by norm_num : (40000 : ℝ) ≤ 76000) hscale0).trans h76000
  have hwindows := CFMSharpTestNumeric.meanWindow_numeric_of_source_errors
    hW hh ha0 hscale0 hZ0 hEnv0 heHi0 heLo0 haLower hrate hmismatch
      hnext hcurrent hstatusHi hstatusLo hgain hloss hrem henvelope
  dsimp only [Z, Zp, Env, Envp, b, eHi, eLo, gain, loss, K, rem, scale,
    delta, internal, h, eps, x] at hwindows
  unfold certificateTestStatusHi certificateTestStatusLo
  convert hwindows using 1 <;> ring_nf

end CFMSharpTestCutoff

namespace CFMSharpTestExternalRootNumeric

private theorem two_margin_eq_rpow
    {eta d W : ℝ} (ell n : ℕ) (hd : 0 < d) :
    2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta)) 0 n =
      (2 * (ell : ℝ)) * W *
        d ^ ((-1 - CFMNumeric.coreEpsilon eta) +
          (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
  unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
    finiteWeightedRootShadowStepFactor
  simp only [pow_zero, mul_one]
  have hstep :
      (d ^ (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ n =
        d ^ ((-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ)) := by
    calc
      (d ^ (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ n =
          (d ^ (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ (n : ℝ) :=
        (Real.rpow_natCast _ n).symm
      _ = d ^ ((-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ)) :=
        (Real.rpow_mul hd.le _ _).symm
  let b : ℝ := -1 - CFMNumeric.coreEpsilon eta
  let q : ℝ := (-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ)
  have hadd : d ^ b * d ^ q = d ^ (b + q) :=
    (Real.rpow_add hd b q).symm
  calc
    2 * ((ell : ℝ) * W * d ^ b *
        Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16) ^ n) =
      (2 * (ell : ℝ)) * W * (d ^ b *
        Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16) ^ n) := by ring
    _ = (2 * (ell : ℝ)) * W * (d ^ b * d ^ q) :=
      congrArg (fun z : ℝ ↦ (2 * (ell : ℝ)) * W * (d ^ b * z)) hstep
    _ = (2 * (ell : ℝ)) * W * d ^ (b + q) :=
      congrArg (fun z : ℝ ↦ (2 * (ell : ℝ)) * W * z) hadd
    _ = (2 * (ell : ℝ)) * W *
        d ^ ((-1 - CFMNumeric.coreEpsilon eta) +
          (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
      dsimp only [b, q]
      congr 2
      ring

/-- A uniform post-profile original-test gain cap, including the top
coordinate `s=j`, fits below the source scale with a half-epsilon saving. -/
theorem gainRootCap_le_halfEpsilon
    {eta d W gainRootCap : ℝ} {ell j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (hW : 0 ≤ W) (hsj : s ≤ j) (hj : j ≤ 4)
    (hcap : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (j - (s + 1))) :
    gainRootCap ≤
      W * d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta / 2) := by
  let eps := CFMNumeric.coreEpsilon eta
  let G : ℝ := 6 * (2 * (ell : ℝ) + 1)
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hell0 : 0 ≤ (ell : ℝ) := Nat.cast_nonneg ell
  have hcoeff : 2 * (ell : ℝ) ≤ d ^ (eps / 64) := by
    calc
      2 * (ell : ℝ) ≤ 4 * G := by
        dsimp only [G]
        nlinarith
      _ ≤ d ^ (eps / 64) := by
        simpa only [G, eps] using S.correctionDenominator
  have hexp :
      (-1 - eps) + ((j - (s + 1) : ℕ) : ℝ) * (-1 + eps / 16) ≤
        (s : ℝ) - j - 33 * eps / 64 := by
    -- The exponent argument uses only the eta fields of `E`; its Gamma
    -- parameter is definitionally irrelevant.
    have heps : eps = eta / 50000 := by
      dsimp only [eps, CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      ring
    by_cases htop : s = j
    · subst s
      simp only [Nat.sub_eq_zero_of_le (Nat.le_succ j), Nat.cast_zero,
        zero_mul]
      rw [heps]
      linarith [E.eta_pos, E.eta_lt_one]
    · have hslt : s < j := lt_of_le_of_ne hsj htop
      have hsnext : s + 1 ≤ j := by omega
      have hsub : j - (s + 1) + (s + 1) = j := Nat.sub_add_cancel hsnext
      have hn : j - (s + 1) ≤ 3 := by omega
      have hcast : ((j - (s + 1) : ℕ) : ℝ) + (s : ℝ) + 1 = j := by
        exact_mod_cast hsub
      have hn' : ((j - (s + 1) : ℕ) : ℝ) ≤ 3 := by exact_mod_cast hn
      have hneta : ((j - (s + 1) : ℕ) : ℝ) * eta ≤ 3 * eta :=
        mul_le_mul_of_nonneg_right hn' E.eta_pos.le
      rw [heps]
      linarith [E.eta_pos]
  have hpow := Real.rpow_le_rpow_of_exponent_le
    (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d) hexp
  calc
    gainRootCap ≤ 2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - eps)) 0 (j - (s + 1)) := hcap
    _ = (2 * (ell : ℝ)) * W *
        d ^ ((-1 - eps) + ((j - (s + 1) : ℕ) : ℝ) *
          (-1 + eps / 16)) := by
      simpa only [eps] using two_margin_eq_rpow
        (eta := eta) (d := d) (W := W) ell (j - (s + 1)) hd
    _ ≤ d ^ (eps / 64) * W *
        d ^ ((s : ℝ) - j - 33 * eps / 64) := by
      exact mul_le_mul (mul_le_mul_of_nonneg_right hcoeff hW)
        hpow (Real.rpow_nonneg hd.le _)
        (mul_nonneg (Real.rpow_nonneg hd.le _) hW)
    _ = W * d ^ ((s : ℝ) - j - eps / 2) := by
      calc
        d ^ (eps / 64) * W * d ^ ((s : ℝ) - j - 33 * eps / 64) =
            W * (d ^ (eps / 64) *
              d ^ ((s : ℝ) - j - 33 * eps / 64)) := by ring
        _ = W * d ^ (eps / 64 +
              ((s : ℝ) - j - 33 * eps / 64)) :=
          congrArg (fun z : ℝ ↦ W * z)
            (Real.rpow_add hd (eps / 64)
              ((s : ℝ) - j - 33 * eps / 64)).symm
        _ = W * d ^ ((s : ℝ) - j - eps / 2) := by
          congr 2
          ring

/-- After the certificate blocker-status factor, the original-test loss
root cap retains a half-epsilon saving at every coordinate, including
`s=j`. -/
theorem status_mul_lossRootCap_le_halfEpsilon
    {D₂ D₃ D₄ eta d N P W lossRootCap : ℝ}
    {ell k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) P j s)
    (hW : 0 ≤ W) (hloss0 : 0 ≤ lossRootCap)
    (hcap : lossRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (j - s)) :
    certificateTestStatusHi D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d N k * lossRootCap ≤
      W * d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta / 2) := by
  let eps := CFMNumeric.coreEpsilon eta
  let G : ℝ := 6 * (2 * (ell : ℝ) + 1)
  let status := certificateTestStatusHi D₂ D₃ D₄ G eps d N k
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hG0 : 0 ≤ G := by dsimp only [G]; positivity
  have hell0 : 0 ≤ (ell : ℝ) := Nat.cast_nonneg ell
  have hstatus : status ≤ 18 * G * d := by
    dsimp only [status, G, eps]
    exact CFMSharpTestCutoff.certificateTestStatusHi_le_eighteenGamma_mul_d
      E S R.delta
  have hmargin0 : 0 ≤ 2 * finiteWeightedRootShadowMargin eta d
      ((ell : ℝ) * W * d ^ (-1 - eps)) 0 (j - s) := by
    rw [two_margin_eq_rpow
      (eta := eta) (d := d) (W := W) ell (j - s) hd]
    positivity
  have hcoeff : 36 * G * (ell : ℝ) ≤ d ^ (eps / 32) := by
    have hcorr : 4 * G ≤ d ^ (eps / 64) := by
      simpa only [G, eps] using S.correctionDenominator
    have hcorr0 : 0 ≤ 4 * G := mul_nonneg (by norm_num) hG0
    have hpow0 : 0 ≤ d ^ (eps / 64) := Real.rpow_nonneg hd.le _
    have hsq : (4 * G) ^ 2 ≤ (d ^ (eps / 64)) ^ 2 :=
      (sq_le_sq₀ hcorr0 hpow0).2 hcorr
    calc
      36 * G * (ell : ℝ) ≤ (4 * G) ^ 2 := by
        dsimp only [G]
        nlinarith
      _ ≤ (d ^ (eps / 64)) ^ 2 := hsq
      _ = d ^ (eps / 32) := by
        rw [pow_two, ← Real.rpow_add hd]
        congr 1
        ring
  have hexp :
      (-1 - eps) + 1 + ((j - s : ℕ) : ℝ) * (-1 + eps / 16) ≤
        (s : ℝ) - j - 3 * eps / 4 := by
    have hsub : j - s + s = j := Nat.sub_add_cancel R.s_le_j
    have hn : j - s ≤ 4 := (Nat.sub_le j s).trans R.j_le_four
    have hcast : ((j - s : ℕ) : ℝ) + (s : ℝ) = j := by
      exact_mod_cast hsub
    have hn' : ((j - s : ℕ) : ℝ) ≤ 4 := by exact_mod_cast hn
    have hneta : ((j - s : ℕ) : ℝ) * eta ≤ 4 * eta :=
      mul_le_mul_of_nonneg_right hn' E.eta_pos.le
    have heps0 : 0 ≤ eps := by
      dsimp only [eps, CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      linarith [E.eta_pos]
    have heps : eps = eta / 50000 := by
      dsimp only [eps, CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      ring
    rw [heps]
    linarith
  have hpow := Real.rpow_le_rpow_of_exponent_le
    (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d) hexp
  have hproduct : status * lossRootCap ≤
      (18 * G * d) *
        (2 * finiteWeightedRootShadowMargin eta d
          ((ell : ℝ) * W * d ^ (-1 - eps)) 0 (j - s)) :=
    mul_le_mul hstatus hcap hloss0 (by positivity)
  calc
    certificateTestStatusHi D₂ D₃ D₄ G eps d N k * lossRootCap =
        status * lossRootCap := rfl
    _ ≤ (18 * G * d) *
        (2 * finiteWeightedRootShadowMargin eta d
          ((ell : ℝ) * W * d ^ (-1 - eps)) 0 (j - s)) := hproduct
    _ = (36 * G * (ell : ℝ)) * W *
        d ^ ((-1 - eps) + 1 + ((j - s : ℕ) : ℝ) *
          (-1 + eps / 16)) := by
      rw [two_margin_eq_rpow
        (eta := eta) (d := d) (W := W) ell (j - s) hd]
      dsimp only [eps]
      have hdb : d * d ^ ((-1 - eps) + ((j - s : ℕ) : ℝ) *
          (-1 + eps / 16)) =
          d ^ (1 + ((-1 - eps) + ((j - s : ℕ) : ℝ) *
            (-1 + eps / 16))) := by
        calc
          d * d ^ ((-1 - eps) + ((j - s : ℕ) : ℝ) *
              (-1 + eps / 16)) =
              d ^ (1 : ℝ) * d ^ ((-1 - eps) + ((j - s : ℕ) : ℝ) *
                (-1 + eps / 16)) := by rw [Real.rpow_one]
          _ = d ^ (1 + ((-1 - eps) + ((j - s : ℕ) : ℝ) *
                (-1 + eps / 16))) :=
            (Real.rpow_add hd (1 : ℝ)
              ((-1 - eps) + ((j - s : ℕ) : ℝ) *
                (-1 + eps / 16))).symm
      calc
        (18 * G * d) * ((2 * (ell : ℝ)) * W *
            d ^ ((-1 - eps) + ((j - s : ℕ) : ℝ) *
              (-1 + eps / 16))) =
            (36 * G * (ell : ℝ)) * W *
              (d * d ^ ((-1 - eps) + ((j - s : ℕ) : ℝ) *
                (-1 + eps / 16))) := by ring
        _ = (36 * G * (ell : ℝ)) * W *
              d ^ (1 + ((-1 - eps) + ((j - s : ℕ) : ℝ) *
                (-1 + eps / 16))) :=
          congrArg (fun z : ℝ ↦ (36 * G * (ell : ℝ)) * W * z) hdb
        _ = (36 * G * (ell : ℝ)) * W *
              d ^ ((-1 - eps) + 1 + ((j - s : ℕ) : ℝ) *
                (-1 + eps / 16)) := by
          congr 2
          ring
    _ ≤ d ^ (eps / 32) * W *
        d ^ ((s : ℝ) - j - 3 * eps / 4) := by
      exact mul_le_mul (mul_le_mul_of_nonneg_right hcoeff hW)
        hpow (Real.rpow_nonneg hd.le _)
        (mul_nonneg (Real.rpow_nonneg hd.le _) hW)
    _ ≤ W * d ^ ((s : ℝ) - j - eps / 2) := by
      calc
        d ^ (eps / 32) * W * d ^ ((s : ℝ) - j - 3 * eps / 4) =
            W * (d ^ (eps / 32) *
              d ^ ((s : ℝ) - j - 3 * eps / 4)) := by ring
        _ = W * d ^ (eps / 32 +
              ((s : ℝ) - j - 3 * eps / 4)) :=
          congrArg (fun z : ℝ ↦ W * z)
            (Real.rpow_add hd (eps / 32)
              ((s : ℝ) - j - 3 * eps / 4)).symm
        _ ≤ W * d ^ ((s : ℝ) - j - eps / 2) := by
          apply mul_le_mul_of_nonneg_left _ hW
          apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
          have heps0 : 0 ≤ eps := by
            dsimp only [eps, CFMNumeric.coreEpsilon,
              CFMRegularization.rawRegularizationEps]
            linarith [E.eta_pos]
          linarith

/-- The two original-test pointwise caps occupy one half of the canonical
source jump.  Its premises are precisely the structural post-profile caps;
all scalar absorption is internal. -/
theorem originalTestRawCap_le_naturalHalf
    {D₂ D₃ D₄ eta d N P W gainRootCap lossRootCap : ℝ}
    {ell k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) P j s)
    (hW : 0 ≤ W) (hloss0 : 0 ≤ lossRootCap)
    (hgain : gainRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (j - (s + 1)))
    (hloss : lossRootCap ≤
      2 * finiteWeightedRootShadowMargin eta d
        ((ell : ℝ) * W * d ^ (-1 - CFMNumeric.coreEpsilon eta))
          0 (j - s)) :
    max gainRootCap
        (certificateTestStatusHi D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
            d N k * lossRootCap) ≤
      testSourceJumpScale (W * d ^ ((s : ℝ) - j)) d
        (CFMNumeric.coreEpsilon eta) / 2 := by
  let eps := CFMNumeric.coreEpsilon eta
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have heps0 : 0 ≤ eps := by
    dsimp only [eps, CFMNumeric.coreEpsilon,
      CFMRegularization.rawRegularizationEps]
    linarith [E.eta_pos]
  have hgainHalf := gainRootCap_le_halfEpsilon E S hW R.s_le_j R.j_le_four hgain
  have hlossHalf := status_mul_lossRootCap_le_halfEpsilon
    E S R hW hloss0 hloss
  have htwo : (2 : ℝ) ≤ d ^ (eps / 4) := by
    calc
      (2 : ℝ) ≤ 5 := by norm_num
      _ ≤ d ^ (eps / 64) := by simpa only [eps] using S.envelopeFifth
      _ ≤ d ^ (eps / 4) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
        linarith
  have hscale :
      W * d ^ ((s : ℝ) - j - eps / 2) ≤
        testSourceJumpScale (W * d ^ ((s : ℝ) - j)) d eps / 2 := by
    unfold testSourceJumpScale
    have hpow0 : 0 ≤ d ^ ((s : ℝ) - j - eps / 2) :=
      Real.rpow_nonneg hd.le _
    have hcross :
        2 * d ^ ((s : ℝ) - j - eps / 2) ≤
          d ^ ((s : ℝ) - j) * d ^ (-eps / 4) := by
      calc
        2 * d ^ ((s : ℝ) - j - eps / 2) ≤
          d ^ (eps / 4) * d ^ ((s : ℝ) - j - eps / 2) :=
            mul_le_mul_of_nonneg_right htwo hpow0
        _ = d ^ ((s : ℝ) - j) * d ^ (-eps / 4) := by
          rw [← Real.rpow_add hd, ← Real.rpow_add hd]
          congr 1
          ring
    have hm := mul_le_mul_of_nonneg_left hcross hW
    calc
      W * d ^ ((s : ℝ) - j - eps / 2) =
          (W * (2 * d ^ ((s : ℝ) - j - eps / 2))) / 2 := by ring
      _ ≤ (W * (d ^ ((s : ℝ) - j) * d ^ (-eps / 4))) / 2 :=
        div_le_div_of_nonneg_right hm (by norm_num)
      _ = (W * d ^ ((s : ℝ) - j)) * d ^ (-eps / 4) / 2 := by ring
  exact (max_le (hgainHalf.trans hscale) (hlossHalf.trans hscale))

end CFMSharpTestExternalRootNumeric


def oneOpenConflictLinkFamilyOnChoices
    (C : ConflictSystem V) (A M D : Hypergraph V) (f : Finset V) :
    ConflictSystem V :=
  (oneOpenConflictLinkFamily C A M f).filter fun Q ↦ (Q ∩ D).Nonempty

@[simp] theorem mem_oneOpenConflictLinkFamilyOnChoices
    {C : ConflictSystem V} {A M D : Hypergraph V} {f : Finset V}
    {Q : Hypergraph V} :
    Q ∈ oneOpenConflictLinkFamilyOnChoices C A M D f ↔
      Q ∈ oneOpenConflictLinkFamily C A M f ∧ (Q ∩ D).Nonempty := by
  simp [oneOpenConflictLinkFamilyOnChoices]

/-- Outside the colliding subfamily, the unique available-member map is
injective.  Restricting its image to `D` therefore costs at most `|D|`,
with all multiplicity charged to `collidingOneOpenConflictLinks`. -/
theorem card_oneOpenConflictLinkFamilyOnChoices_le_status_add_colliding
    (C : ConflictSystem V) (A M D : Hypergraph V) (f : Finset V)
    (hDA : D ⊆ A) :
    (oneOpenConflictLinkFamilyOnChoices C A M D f).card ≤
      D.card + (collidingOneOpenConflictLinks C A M f).card := by
  let F := oneOpenConflictLinkFamily C A M f
  let G := oneOpenConflictLinkFamilyOnChoices C A M D f
  let K := collidingOneOpenConflictLinks C A M f
  let S := G \ K
  have hcardA : ∀ Q ∈ F, (Q ∩ A).card = 1 := by
    intro Q hQ
    obtain ⟨q, _hq, hQpartial⟩ :=
      mem_oneOpenConflictLinkFamily.mp (by simpa only [F] using hQ)
    exact (mem_partialFamily.mp hQpartial).2.1
  have hpair : (↑S : Set (Hypergraph V)).PairwiseDisjoint
      (fun Q ↦ Q ∩ A) := by
    intro Q hQS Q' hQ'S hne
    have hQdata := Finset.mem_sdiff.mp hQS
    have hQ'data := Finset.mem_sdiff.mp hQ'S
    have hQG : Q ∈ G := hQdata.1
    have hQ'G : Q' ∈ G := hQ'data.1
    have hQF : Q ∈ F := by
      exact (Finset.mem_filter.mp (by simpa only [G,
        oneOpenConflictLinkFamilyOnChoices] using hQG)).1
    have hQ'F : Q' ∈ F := by
      exact (Finset.mem_filter.mp (by simpa only [G,
        oneOpenConflictLinkFamilyOnChoices] using hQ'G)).1
    change Disjoint (Q ∩ A) (Q' ∩ A)
    rw [Finset.disjoint_left]
    intro e heQ heQ'
    apply hQdata.2
    apply mem_collidingOneOpenConflictLinks.mpr
    refine ⟨by simpa only [F] using hQF, Q',
      by simpa only [F] using hQ'F, hne.symm, ?_⟩
    have hQsingle : Q ∩ A = {e} := by
      obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q hQF)
      have hea : e = a := by
        rw [ha] at heQ
        exact Finset.mem_singleton.mp heQ
      simpa [hea] using ha
    have hQ'single : Q' ∩ A = {e} := by
      obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q' hQ'F)
      have hea : e = a := by
        rw [ha] at heQ'
        exact Finset.mem_singleton.mp heQ'
      simpa [hea] using ha
    exact hQ'single.trans hQsingle.symm
  have hcardSUnion :
      (S.biUnion (fun Q ↦ Q ∩ A)).card = S.card := by
    rw [Finset.card_biUnion hpair]
    calc
      (∑ Q ∈ S, (Q ∩ A).card) = ∑ _Q ∈ S, 1 := by
        apply Finset.sum_congr rfl
        intro Q hQS
        have hQG : Q ∈ G := (Finset.mem_sdiff.mp hQS).1
        have hQF : Q ∈ F := by
          exact (Finset.mem_filter.mp (by simpa only [G,
            oneOpenConflictLinkFamilyOnChoices] using hQG)).1
        exact hcardA Q hQF
      _ = S.card := by simp
  have hSUnionSub : S.biUnion (fun Q ↦ Q ∩ A) ⊆ D := by
    intro e he
    obtain ⟨Q, hQS, heQA⟩ := Finset.mem_biUnion.mp he
    have hQG : Q ∈ G := (Finset.mem_sdiff.mp hQS).1
    have hQG' : Q ∈ F ∧ (Q ∩ D).Nonempty := by
      simpa only [G, F, oneOpenConflictLinkFamilyOnChoices,
        Finset.mem_filter] using hQG
    obtain ⟨d, hdQD⟩ := hQG'.2
    have hdQA : d ∈ Q ∩ A :=
      Finset.mem_inter.mpr
        ⟨Finset.inter_subset_left hdQD, hDA (Finset.inter_subset_right hdQD)⟩
    obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q hQG'.1)
    have hea : e = a := by
      rw [ha] at heQA
      exact Finset.mem_singleton.mp heQA
    have hda : d = a := by
      rw [ha] at hdQA
      exact Finset.mem_singleton.mp hdQA
    exact hea.symm ▸ hda.symm ▸ Finset.inter_subset_right hdQD
  have hScardLe : S.card ≤ D.card := by
    rw [← hcardSUnion]
    exact Finset.card_le_card hSUnionSub
  have hsplit : S.card + (G ∩ K).card = G.card := by
    simpa only [S] using Finset.card_sdiff_add_card_inter G K
  have hinterLe : (G ∩ K).card ≤ K.card :=
    Finset.card_le_card Finset.inter_subset_right
  change G.card ≤ D.card + K.card
  omega

/-- Pointwise loss is bounded by the incidence of tests with the available
members deleted by the chosen edge.  This is the reusable intermediate
form hidden inside the original-root-shadow bound. -/
theorem partialTestStepLoss_le_selectedTestIncidenceCharge
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S) :
    partialTestStepLoss w H C j s M e ≤
      selectedTestIncidenceCharge w H M j (j - s)
        (availableEdges H C M \ availableEdges H C (insert e M)) := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  let D := A \ A'
  unfold partialTestStepLoss partialTestLossBetween
    selectedTestIncidenceCharge
  apply Finset.sum_le_sum
  intro S hS
  by_cases hloss :
      partialTestCondition A M j s S ∧
        ¬ partialTestCondition A' (insert e M) j s S
  · rw [if_pos hloss, if_pos hloss.1.2]
    have heChoice : e ∈ partialTestLossChoiceSet H C M j s S := by
      rw [partialTestLossChoiceSet, Finset.mem_filter]
      exact ⟨he, hloss⟩
    obtain ⟨f, hfSA, hef⟩ :=
      partialTestLossChoice_mem_has_blocked_member
        H C M j s S hS heChoice
    have hfA : f ∈ A := Finset.inter_subset_right hfSA
    have heA : e ∈ A := he
    have hfe := (mem_availableBlockerChoices_comm H C M heA hfA).mpr hef
    have hfNotA' : f ∉ A' := by
      dsimp only [A']
      rw [availableEdges_insert_eq_sdiff_blockers]
      exact fun hf' ↦ (Finset.mem_sdiff.mp hf').2 hfe
    have hfD : f ∈ D := Finset.mem_sdiff.mpr ⟨hfA, hfNotA'⟩
    have hpos : 1 ≤ (S ∩ D).card := by
      exact Finset.one_le_card.mpr
        ⟨f, Finset.mem_inter.mpr
          ⟨Finset.inter_subset_left hfSA, hfD⟩⟩
    have hposR : (1 : ℝ) ≤ ((S ∩ D).card : ℕ) := by
      exact_mod_cast hpos
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left hposR (hw S)
  · rw [if_neg hloss]
    split
    · exact mul_nonneg (hw S) (Nat.cast_nonneg _)
    · rfl

/-- For the unit conflict-link weight at status `s = 1`, the incidence
charge is exactly supported on one-open links whose available member lies
in `D`. -/
theorem selectedTestIncidenceCharge_conflictLink_one_le_restricted
    {H : Hypergraph V} {C : ConflictSystem V}
    (M D : Hypergraph V) (f : Finset V) (q : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hDA : D ⊆ availableEdges H C M) (hD : Disjoint D M) :
    selectedTestIncidenceCharge (conflictLinkTestWeight C f q)
        H M q (q - 1) D ≤
      ((oneOpenConflictLinkFamilyOnChoices C
        (availableEdges H C M) M D f).card : ℝ) := by
  let A := availableEdges H C M
  let G := oneOpenConflictLinkFamilyOnChoices C A M D f
  let L := (H.powersetCard q).filter fun Q ↦
    Q ∈ conflictLinkLayer C f q ∧
      (Q ∩ M).card = q - 1 ∧ (Q ∩ D).Nonempty
  have hcharge :
      selectedTestIncidenceCharge (conflictLinkTestWeight C f q)
          H M q (q - 1) D = (L.card : ℝ) := by
    unfold selectedTestIncidenceCharge
    calc
      (∑ S ∈ H.powersetCard q,
        if (S ∩ M).card = q - 1 then
          conflictLinkTestWeight C f q S * (S ∩ D).card else 0) =
          ∑ _S ∈ L, (1 : ℝ) := by
        rw [Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro S hS
        by_cases hlink : S ∈ conflictLinkLayer C f q
        · by_cases hsel : (S ∩ M).card = q - 1
          · by_cases hmeet : (S ∩ D).Nonempty
            · have hcardS : S.card = q :=
                (Finset.mem_powersetCard.mp hS).2
              have hdisj : Disjoint (S ∩ M) (S ∩ D) :=
                hD.symm.mono Finset.inter_subset_right
                  Finset.inter_subset_right
              have hDMcard :
                  (S ∩ M).card + (S ∩ D).card ≤ S.card := by
                rw [← Finset.card_union_of_disjoint hdisj]
                exact Finset.card_le_card
                  (Finset.union_subset Finset.inter_subset_left
                    Finset.inter_subset_left)
              have hDcard : (S ∩ D).card = 1 := by
                have hpos := Finset.card_pos.mpr hmeet
                omega
              simp [hlink, hsel, hmeet, hDcard]
            · have hDzero : (S ∩ D).card = 0 :=
                Finset.card_eq_zero.mpr
                  (Finset.not_nonempty_iff_eq_empty.mp hmeet)
              simp [hlink, hsel, hmeet, hDzero]
          · simp [hlink, hsel]
        · simp [hlink]
      _ = (L.card : ℝ) := by simp
  rw [hcharge]
  exact_mod_cast Finset.card_le_card (by
    intro Q hQL
    have hQL' := Finset.mem_filter.mp hQL
    have hQH := (Finset.mem_powersetCard.mp hQL'.1).1
    have hQcard := (Finset.mem_powersetCard.mp hQL'.1).2
    have hQlink := hQL'.2.1
    have hQM := hQL'.2.2.1
    have hQD := hQL'.2.2.2
    apply mem_oneOpenConflictLinkFamilyOnChoices.mpr
    refine ⟨mem_oneOpenConflictLinkFamily.mpr
      ⟨q, ?_, mem_partialFamily.mpr ⟨hQlink, ?_, ?_⟩⟩, hQD⟩
    · exact Finset.mem_Icc.mpr ⟨hq1, hq3⟩
    · have hAM : Disjoint (availableEdges H C M) M :=
        availableEdges_disjoint_selected H C M
      have hdisj : Disjoint
          (Q ∩ availableEdges H C M) (Q ∩ M) :=
        hAM.mono Finset.inter_subset_right Finset.inter_subset_right
      have hcardUnion :
          (Q ∩ availableEdges H C M).card + (Q ∩ M).card ≤ Q.card := by
        rw [← Finset.card_union_of_disjoint hdisj]
        exact Finset.card_le_card
          (Finset.union_subset Finset.inter_subset_left
            Finset.inter_subset_left)
      have hpos : 1 ≤ (Q ∩ availableEdges H C M).card := by
        obtain ⟨d, hdQD⟩ := hQD
        exact Finset.one_le_card.mpr
          ⟨d, Finset.mem_inter.mpr
            ⟨Finset.inter_subset_left hdQD,
              hDA (Finset.inter_subset_right hdQD)⟩⟩
      omega
    · simpa [hQcard] using hQM)

/-- Source-faithful pointwise `s = 1` loss cap.  The first link over each
deleted available member costs one status change; every further link is
charged to the point-duplicate family. -/
theorem partialTestStepLoss_conflictLink_one_le_status_add_pointDuplicate
    {H : Hypergraph V} {C : ConflictSystem V}
    (M : Hypergraph V) (f : Finset V) (q : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3) {e : Finset V}
    (he : e ∈ availableEdges H C M) :
    partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q 1 M e ≤
      ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) +
        256 * ∑ r ∈ Finset.Icc 0 6,
          ((partialFamily (duplicateConflictLinkUnionLayer C f r)
            (availableEdges H C M) M 1).card : ℝ) := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  let D := A \ A'
  have hDsubA : D ⊆ A := Finset.sdiff_subset
  have hDM : Disjoint D M :=
    (availableEdges_disjoint_selected H C M).mono_left hDsubA
  have hloss := partialTestStepLoss_le_selectedTestIncidenceCharge
    (conflictLinkTestWeight C f q) H C M q 1 he
    (by
      intro S
      by_cases hS : S ∈ conflictLinkLayer C f q <;>
        simp [conflictLinkTestWeight, hS])
  have hinc := selectedTestIncidenceCharge_conflictLink_one_le_restricted
    M D f q hq1 hq3 hDsubA hDM
  have hrestricted :=
    card_oneOpenConflictLinkFamilyOnChoices_le_status_add_colliding
      C A M D f hDsubA
  have hcollision := card_collidingOneOpenConflictLinks_le_duplicatePartial
    (C := C) (A := A) (M := M) (f := f)
      (availableEdges_disjoint_selected H C M)
  have hnat :
      (oneOpenConflictLinkFamilyOnChoices C A M D f).card ≤
        D.card + 256 * ∑ r ∈ Finset.Icc 0 6,
          (partialFamily (duplicateConflictLinkUnionLayer C f r)
            A M 1).card := by
    omega
  calc
    partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q 1 M e ≤
        selectedTestIncidenceCharge (conflictLinkTestWeight C f q)
          H M q (q - 1) D := by simpa only [D, A, A'] using hloss
    _ ≤ ((oneOpenConflictLinkFamilyOnChoices C A M D f).card : ℝ) := hinc
    _ ≤ (D.card : ℝ) +
        256 * ∑ r ∈ Finset.Icc 0 6,
          ((partialFamily (duplicateConflictLinkUnionLayer C f r)
            A M 1).card : ℝ) := by
      exact_mod_cast hnat
    _ = ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) +
        256 * ∑ r ∈ Finset.Icc 0 6,
          ((partialFamily (duplicateConflictLinkUnionLayer C f r)
            (availableEdges H C M) M 1).card : ℝ) := by rfl

/-- Corridor-facing form: the ordinary status cap and the already tracked
point-duplicate cap close the internal `s = 1` loss, with no full-root
first-appearance coordinate. -/
theorem partialTestStepLoss_conflictLink_one_le_of_status_pointDuplicateCaps
    {H : Hypergraph V} {C : ConflictSystem V}
    (M : Hypergraph V) (f : Finset V) (q : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3) {e : Finset V}
    (he : e ∈ availableEdges H C M) {statusHi duplicateHi : ℝ}
    (hstatus : ((availableBlockerChoices H C M e).card : ℝ) ≤ statusHi)
    (hduplicate :
      (∑ r ∈ Finset.Icc 0 6,
        ((partialFamily (duplicateConflictLinkUnionLayer C f r)
          (availableEdges H C M) M 1).card : ℝ)) ≤ duplicateHi) :
    partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q 1 M e ≤ statusHi + 256 * duplicateHi := by
  have hbase := partialTestStepLoss_conflictLink_one_le_status_add_pointDuplicate
    M f q hq1 hq3 he
  have hblockSubset : availableBlockerChoices H C M e ⊆
      availableEdges H C M := by
    intro g hg
    exact (Finset.mem_filter.mp hg).1
  have hstatus' :
      ((availableEdges H C M \
        availableEdges H C (insert e M)).card : ℝ) ≤ statusHi := by
    rw [availableEdges_insert_eq_sdiff_blockers,
      Finset.sdiff_sdiff_eq_self hblockSubset]
    exact hstatus
  calc
    partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q 1 M e ≤
      ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) +
        256 * ∑ r ∈ Finset.Icc 0 6,
          ((partialFamily (duplicateConflictLinkUnionLayer C f r)
            (availableEdges H C M) M 1).card : ℝ) := hbase
    _ ≤ statusHi + 256 * duplicateHi := by
      exact add_le_add hstatus'
        (mul_le_mul_of_nonneg_left hduplicate (by norm_num))
/-- The remaining nonempty regularized core input to the outer parameter
assembly.  Keeping it packaged as one proposition lets the final theorem
reuse the raw regularization endpoint and all cutoff bookkeeping verbatim. -/
def SpecializedRegularizedCoreProvider (ell : ℕ) : Prop :=
  ∀ (eta d : ℝ) (V ι : Type) [DecidableEq V] [Fintype V] [Fintype ι],
    ∀ (H : Hypergraph V) (C : ConflictSystem V)
      (j : ι → ℕ) (w : ι → TestWeight V),
      IsSpecializedCFMInstance H C d eta ell j w → H.Nonempty →
      ∀ (E : CFMNumeric.CoreExponentSpec eta
          (6 * (2 * (ell : ℝ) + 1)))
        (S : CFMNumeric.CoreCutoffSpec eta
          (6 * (2 * (ell : ℝ) + 1)) d)
        (R : CFMRegularization.RegularizationCertificate H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell j w),
        ∃ M, IsConflictFreeMatching H R.regularized M ∧
          M.card = CFMNumericAggregation.targetTime eta d
            (vertexFinset H).card ∧
          SatisfiesTestEstimates H M d
            (CFMNumeric.publicError eta d / 2) j R.restrictedWeight

/-- A source-faithful regularized core closes all outer quantifiers, cutoff
maxima, the empty-host case, integer rounding, and restricted-weight transfer
without any further hypothesis. -/
theorem specializedCFMTheorem_of_coreProvider
    (ell : ℕ) (hell : 4 ≤ ell)
    (hcoreProvider : SpecializedRegularizedCoreProvider ell) :
    SpecializedCFMTheorem ell := by
  obtain ⟨etaRaw, hetaRaw, hraw⟩ :=
    CFMRegularization.exists_regularizationCertificate_of_raw ell hell
  let GammaCore : ℝ := 6 * (2 * (ell : ℝ) + 1)
  have hGammaCore : 1 ≤ GammaCore := by
    dsimp only [GammaCore]
    have hell0 : (0 : ℝ) ≤ (ell : ℝ) := Nat.cast_nonneg ell
    nlinarith
  let etaCore : ℝ := 1 / (1000000000000 * GammaCore)
  have hetaCore : 0 < etaCore := by
    dsimp only [etaCore]
    positivity
  refine ⟨min etaRaw etaCore, lt_min hetaRaw hetaCore, ?_⟩
  intro eta heta hetaSmall
  have hetaRawSmall : eta < etaRaw :=
    hetaSmall.trans_le (min_le_left etaRaw etaCore)
  have hetaCoreSmall : eta < 1 / (1000000000000 * GammaCore) := by
    simpa only [etaCore] using
      hetaSmall.trans_le (min_le_right etaRaw etaCore)
  let E : CFMNumeric.CoreExponentSpec eta GammaCore :=
    CFMNumeric.coreExponentSpec_of_small hGammaCore heta hetaCoreSmall
  obtain ⟨dRaw, hdRaw⟩ := hraw eta heta hetaRawSmall
  obtain ⟨dCore, hdCore⟩ := CFMNumeric.exists_coreCutoff eta GammaCore E
  refine ⟨max dRaw dCore, ?_⟩
  intro d hd V ι _ _ _ H C j w hI
  have hdRaw' : dRaw ≤ d := (le_max_left dRaw dCore).trans hd
  have hdCore' : dCore ≤ d := (le_max_right dRaw dCore).trans hd
  let S : CFMNumeric.CoreCutoffSpec eta GammaCore d := hdCore d hdCore'
  by_cases hHne : H.Nonempty
  · have hIraw := hI
    rcases hIraw with
      ⟨hH8, hCsys, _hell, hCfour, _heta, heta1, hd1, hvertex,
        hdegree, hcodegree, hbounded, htests, htrack⟩
    obtain ⟨R⟩ := hdRaw d hdRaw' V ι H C j w
      hH8 hCsys hCfour heta1 hd1 hvertex hdegree hcodegree
        hbounded htests htrack
    have hNlower : d ^ eta / 2 ≤ ((vertexFinset H).card : ℝ) :=
      specializedHost_card_ge_half_rpow H C d eta GammaCore ell j w
        hI hHne S
    let T := CFMNumericAggregation.targetTime eta d (vertexFinset H).card
    have hcore : ∃ M, IsConflictFreeMatching H R.regularized M ∧
        M.card = T ∧
          SatisfiesTestEstimates H M d
            (CFMNumeric.publicError eta d / 2) j R.restrictedWeight := by
      simpa only [GammaCore, T] using
        hcoreProvider eta d V ι H C j w hI hHne E S R
    have herr0 : 0 ≤ CFMNumeric.publicError eta d := by
      unfold CFMNumeric.publicError
      exact Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
    have hmargin :
        CFMNumeric.stoppingMargin eta d ≤ CFMNumeric.publicError eta d := by
      unfold CFMNumeric.stoppingMargin
      linarith
    have hcoeff :
        1 - CFMNumeric.publicError eta d ≤
          1 - CFMNumeric.stoppingMargin eta d :=
      sub_le_sub_left hmargin 1
    have hmul := mul_le_mul_of_nonneg_right hcoeff
      (Nat.cast_nonneg (vertexFinset H).card)
    have hreal :
        (1 - CFMNumeric.publicError eta d) *
              ((vertexFinset H).card : ℝ) / 8 ≤
          (1 - CFMNumeric.stoppingMargin eta d) *
              ((vertexFinset H).card : ℝ) / 8 :=
      div_le_div_of_nonneg_right hmul (by norm_num)
    have hceil :
        (1 - CFMNumeric.stoppingMargin eta d) *
              ((vertexFinset H).card : ℝ) / 8 ≤ (T : ℝ) := by
      exact Nat.le_ceil _
    have hw : ∀ i S, 0 ≤ w i S := fun i S' ↦ (htrack i).2.2.1.1 S'
    exact specializedCFMConclusion_of_restrictedCore
      H C d eta (2 * (ell : ℝ) + 1) GammaCore ell j w R S T
        heta.le hw (hreal.trans hceil) hcore
  · exact specializedCFMConclusion_of_not_nonempty
      H C d eta ell j w hI hHne

end

/-! ## Integrated: SharpInternalOriginalProfiles -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-- A fixed available internal link and a fixed available choice.  The
remainder family has rank `q - 1`; its proper roots inherit C3's saving,
while its full root has the separate unit endpoint used by the specialized
selected-positive root-shadow hierarchy. -/
structure InternalOriginalProfile (H : Hypergraph V) where
  base : {f₀ : Finset V // f₀ ∈ H}
  choice : {e : Finset V // e ∈ H}
  linkRank : Fin 4
  linkRank_pos : 1 ≤ linkRank.1
deriving Fintype

def internalOriginalProfileFamily
    (H : Hypergraph V) (b : InternalOriginalProfile H) : ConflictSystem V :=
  originalTestChoiceRemainderFamily H b.linkRank.1 b.choice.1

def internalOriginalProfileWeight
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : InternalOriginalProfile H) : TestWeight V :=
  originalTestChoiceRemainderWeight
    (conflictLinkTestWeight R.regularized b.base.1 b.linkRank.1)
    b.choice.1

def internalOriginalProfileRank
    {H : Hypergraph V}
    (b : InternalOriginalProfile H) : ℕ := b.linkRank.1 - 1

def internalOriginalProfileScale
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : InternalOriginalProfile H) : ℝ :=
  certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
    Real.rpow d (-1 - epsRaw / 5)

def internalOriginalLocalProfile
    (H : Hypergraph V)
    (f₀ : Finset V) (hf₀H : f₀ ∈ H)
    (e : Finset V) (heH : e ∈ H)
    (q : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    InternalOriginalProfile H :=
  ⟨⟨f₀, hf₀H⟩, ⟨e, heH⟩, ⟨q, by omega⟩, hq1⟩

theorem internalOriginalProfileFamily_uniform
    (H : Hypergraph V) (b : InternalOriginalProfile H) :
    IsUniform (internalOriginalProfileFamily H b)
      (internalOriginalProfileRank b) := by
  exact originalTestChoiceRemainderFamily_uniform
    H b.linkRank.1 b.choice.1

theorem internalOriginalProfileWeight_nonneg
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : InternalOriginalProfile H) :
    ∀ U, 0 ≤ internalOriginalProfileWeight R b U := by
  exact originalTestChoiceRemainderWeight_nonneg
    (conflictLinkTestWeight_nonneg_sharp
      R.regularized b.base.1 b.linkRank.1) b.choice.1

/-- Proper-root spread for the internal original-choice remainder.  This
is the sharp part of the source: inserting the fixed choice turns a root
of size `t < q-1` into a proper nonempty link-test extension of size
`t+1 < q`. -/
theorem RegularizationCertificate.internalOriginalProfile_isWeightedRealSpread
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    (b : InternalOriginalProfile H) :
    IsWeightedRealSpread
      (internalOriginalProfileFamily H b)
      (internalOriginalProfileWeight R b)
      (internalOriginalProfileRank b)
      (internalOriginalProfileScale
        H C d epsRaw GammaCert ellCert j w R b) d⁻¹ := by
  refine ⟨internalOriginalProfileFamily_uniform H b,
    internalOriginalProfileWeight_nonneg R b, ?_⟩
  intro root hroot
  by_cases hrootHost : root ⊆ H.erase b.choice.1
  · have heroot : b.choice.1 ∉ root := fun he ↦
      (Finset.notMem_erase b.choice.1 H) (hrootHost he)
    have hrootSub : insert b.choice.1 root ⊆ H := by
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hxroot
      · exact b.choice.2
      · exact Finset.erase_subset b.choice.1 H (hrootHost hxroot)
    have hrootCard : (insert b.choice.1 root).card = root.card + 1 := by
      rw [Finset.card_insert_of_notMem heroot]
    have hroot1 : 1 ≤ (insert b.choice.1 root).card := by
      rw [hrootCard]
      omega
    have hrootq : (insert b.choice.1 root).card < b.linkRank.1 := by
      rw [hrootCard]
      change root.card < b.linkRank.1 - 1 at hroot
      omega
    have hproper :=
      Erdos136.RegularizationCertificate.internalLinkTestExtension_proper_le_scale
        R hd heps b.base.1 b.linkRank.1 b.linkRank_pos (by omega)
          (insert b.choice.1 root) hroot1 hrootq
    rw [internalOriginalProfileFamily, internalOriginalProfileWeight,
      weightedCodegree_originalTestChoiceRemainder_eq
        (conflictLinkTestWeight R.regularized b.base.1 b.linkRank.1)
        H b.linkRank.1 b.choice.1 b.choice.2 b.linkRank_pos root heroot]
    apply hproper.trans_eq
    unfold internalOriginalProfileScale
    have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
    have hinvPow : d⁻¹ ^ root.card =
        Real.rpow d (-(root.card : ℝ)) := by
      calc
        d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
        _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
          exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
        _ = Real.rpow d (-(root.card : ℝ)) :=
          (Real.rpow_neg hdpos.le _).symm
    rw [hinvPow]
    have hcast : ((insert b.choice.1 root).card : ℝ) =
        (root.card : ℝ) + 1 := by exact_mod_cast hrootCard
    rw [hcast]
    calc
      certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
          Real.rpow d (-((root.card : ℝ) + 1 + epsRaw / 5)) =
        certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
          Real.rpow d ((-1 - epsRaw / 5) + (-(root.card : ℝ))) := by
            congr 2
            ring
      _ = certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
          (Real.rpow d (-1 - epsRaw / 5) *
            Real.rpow d (-(root.card : ℝ))) := by
              exact congrArg
                (fun z : ℝ ↦ certificateInternalLayerScale
                  H C d epsRaw GammaCert ellCert j w R
                    (b.linkRank.1 + 1) * z)
                (Real.rpow_add hdpos (-1 - epsRaw / 5)
                  (-(root.card : ℝ)))
      _ = (certificateInternalLayerScale
              H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
            Real.rpow d (-1 - epsRaw / 5)) *
          Real.rpow d (-(root.card : ℝ)) := by ring
  · have hempty :
        (internalOriginalProfileFamily H b).filter (root ⊆ ·) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro U hU hrootU
      apply hrootHost
      exact hrootU.trans (Finset.mem_powersetCard.mp hU).1
    rw [weightedCodegree, hempty]
    exact mul_nonneg
      (mul_nonneg
        (certificateInternalLayerScale_pos
          H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1)
            (lt_of_lt_of_le zero_lt_one hd)).le
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _))
      (pow_nonneg (inv_nonneg.mpr (by linarith : 0 ≤ d)) _)

/-- The deliberately separate full-active-root endpoint.  It is exactly
one, rather than the false `d₀ * d^{-(q-1)}` demanded by the generic
all-root closure. -/
theorem RegularizationCertificate.internalOriginalProfile_fullRoot_le_one
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : InternalOriginalProfile H)
    (root : Hypergraph V)
    (hroot : root.card = internalOriginalProfileRank b) :
    weightedCodegree
        (internalOriginalProfileFamily H b)
        (internalOriginalProfileWeight R b) root ≤ 1 := by
  let F := (internalOriginalProfileFamily H b).filter (root ⊆ ·)
  have hFcard : F.card ≤ 1 := by
    change codegree (internalOriginalProfileFamily H b) root ≤ 1
    exact codegree_le_one_of_uniform_of_card_eq
      (internalOriginalProfileFamily_uniform H b) root hroot
  calc
    weightedCodegree (internalOriginalProfileFamily H b)
        (internalOriginalProfileWeight R b) root =
        ∑ U ∈ F, internalOriginalProfileWeight R b U := by rfl
    _ ≤ ∑ _U ∈ F, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro U hU
      exact conflictLinkTestWeight_le_one R.regularized b.base.1
        b.linkRank.1 (insert b.choice.1 U)
    _ = (F.card : ℝ) := by simp
    _ ≤ 1 := by exact_mod_cast hFcard

/-- The empty-root shadow is definitionally the original fixed-choice
root observable used by the pointwise gain/loss adapter. -/
theorem internalOriginalProfile_emptyRootShadow_eq
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (b : InternalOriginalProfile H) :
    weightedConflictFamilyRootShadowWeight
        (internalOriginalProfileFamily H b)
        (internalOriginalProfileWeight R b) ∅ =
      originalTestRootShadowWeight
        (conflictLinkTestWeight R.regularized b.base.1 b.linkRank.1)
        H b.linkRank.1 b.choice.1 := by
  exact originalTestChoice_emptyRootShadow_eq
    (conflictLinkTestWeight R.regularized b.base.1 b.linkRank.1)
    H b.linkRank.1 b.choice.1 b.choice.2 b.linkRank_pos

end

/-! ## Integrated: SharpCombinedTestProfiles -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

variable {epsRaw GammaCert : ℝ} {ellCert : ℕ}

/-- The availability-truncated residual source for one internal conflict-link
test.  Its static family rank is `r-2`, including the genuine rank-three
boundary when `r=5`. -/
structure InternalResidualProfile (H : Hypergraph V) where
  edge : {f : Finset V // f ∈ H}
  linkRank : Fin 4
  linkRank_pos : 1 ≤ linkRank.1
  unionRank : Fin 6
  unionRank_two : 2 ≤ unionRank.1
deriving Fintype

/-- Fixed-choice internal gain roots.  Only link ranks two and three are
retained: rank one has identically zero gain, rank two is static rank zero,
and rank three has the single selected-positive child needed by pointwise
gain. -/
structure InternalOriginalGainProfile (H : Hypergraph V) where
  base : {f₀ : Finset V // f₀ ∈ H}
  choice : {e : Finset V // e ∈ H}
  linkRank : Fin 4
  linkRank_two : 2 ≤ linkRank.1
deriving Fintype

/-- The source `C*` auxiliary family used only for the killed/deactivation
part of the persistent internal mean.  Both distinguished edges are kept
in the finite profile so the dynamic `s=1` cap is a component of the same
final Good predicate. -/
structure InternalCommonImmediateEvictorProfile (H : Hypergraph V) where
  first : {e : Finset V // e ∈ H}
  second : {f : Finset V // f ∈ H}
  layer : Fin 4
  layer_two : 2 ≤ layer.1
deriving Fintype

def InternalOriginalGainProfile.toOriginal
    {H : Hypergraph V}
    (b : InternalOriginalGainProfile H) : InternalOriginalProfile H :=
  ⟨b.base, b.choice, b.linkRank,
    le_trans (by norm_num) b.linkRank_two⟩

/-- The single finite profile family used by the final endpoint.  External
test, degree-duplicate, reroot, and point-duplicate coordinates live on the
left.  The right side contains the availability-filtered internal gain
residuals and the proper-root internal original-choice gain coordinates.
There is deliberately no internal full-root loss coordinate. -/
abbrev CombinedTestLocalProfileIndex
    (H : Hypergraph V) (C : ConflictSystem V) (io : Type*) :=
  Sum (ExternalTestLocalProfileIndex H C io)
    (Sum (InternalResidualProfile H)
      (Sum (InternalOriginalGainProfile H)
        (InternalCommonImmediateEvictorProfile H)))

def combinedTestLocalProfileFamily
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    CombinedTestLocalProfileIndex H R.regularized io → ConflictSystem V
  | Sum.inl b => externalTestLocalProfileFamily H C j R b
  | Sum.inr (Sum.inl b) => gainCollisionResidualLayer H R.regularized
      b.linkRank.1 b.unionRank.1
  | Sum.inr (Sum.inr (Sum.inl b)) =>
      internalOriginalProfileFamily H b.toOriginal
  | Sum.inr (Sum.inr (Sum.inr b)) =>
      commonImmediateEvictorLinkLayer R.regularized
        b.first.1 b.second.1 b.layer.1

def combinedTestLocalProfileWeight
    (H : Hypergraph V) (C : ConflictSystem V) (j : io → ℕ)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    CombinedTestLocalProfileIndex H R.regularized io → TestWeight V
  | Sum.inl b => externalTestLocalProfileWeight H C j R b
  | Sum.inr (Sum.inl b) => f0TruncatedGainCollisionResidualRepresentationWeight
      (conflictLinkTestWeight R.regularized b.edge.1 b.linkRank.1)
      H R.regularized b.edge.1 b.linkRank.1 b.unionRank.1
  | Sum.inr (Sum.inr (Sum.inl b)) =>
      internalOriginalProfileWeight R b.toOriginal
  | Sum.inr (Sum.inr (Sum.inr _)) => unitTestWeight

def combinedTestLocalProfileFamilyRank
    {H : Hypergraph V} {C : ConflictSystem V} (j : io → ℕ) :
    CombinedTestLocalProfileIndex H C io → ℕ
  | Sum.inl b => externalTestLocalProfileFamilyRank j b
  | Sum.inr (Sum.inl b) => b.unionRank.1 - 2
  | Sum.inr (Sum.inr (Sum.inl b)) => b.linkRank.1 - 1
  | Sum.inr (Sum.inr (Sum.inr b)) => b.layer.1

def combinedTestLocalProfileActiveRank
    {H : Hypergraph V} {C : ConflictSystem V} (j : io → ℕ) :
    CombinedTestLocalProfileIndex H C io → ℕ
  | Sum.inl b => externalTestLocalProfileActiveRank j b
  | Sum.inr (Sum.inl b) => b.unionRank.1 - 2
  | Sum.inr (Sum.inr (Sum.inl b)) => b.linkRank.1 - 2
  | Sum.inr (Sum.inr (Sum.inr b)) => b.layer.1 - 1

def combinedTestLocalProfileSeed
    {H : Hypergraph V} {C : ConflictSystem V}
    (b : CombinedTestLocalProfileIndex H C io) : Hypergraph V :=
  match b with
  | Sum.inl b => externalTestLocalProfileSeed b
  | Sum.inr _ => ∅

def combinedTestLocalProfileScale
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    CombinedTestLocalProfileIndex H R.regularized io → ℝ
  | Sum.inl b =>
      externalTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R b
  | Sum.inr (Sum.inl b) =>
      3 * certificateInternalLayerScale
          H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
        Real.rpow d ((b.unionRank.1 : ℝ) - (b.linkRank.1 : ℝ) - epsRaw / 10)
  | Sum.inr (Sum.inr (Sum.inl b)) =>
      internalOriginalProfileScale
        H C d epsRaw GammaCert ellCert j w R b.toOriginal
  | Sum.inr (Sum.inr (Sum.inr b)) =>
      (3 * GammaCert + 1) *
        Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)

def internalResidualLocalProfile
    (H : Hypergraph V) (C : ConflictSystem V)
    (f : {e : Finset V // e ∈ H})
    (q r : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hr2 : 2 ≤ r) (hr5 : r ≤ 5) :
    CombinedTestLocalProfileIndex H C io :=
  Sum.inr (Sum.inl ⟨f, ⟨q, by omega⟩, hq1, ⟨r, by omega⟩, hr2⟩)

def internalOriginalGainLocalProfile
    (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : {e : Finset V // e ∈ H})
    (e : {e : Finset V // e ∈ H})
    (q : ℕ) (hq2 : 2 ≤ q) (hq3 : q ≤ 3) :
    CombinedTestLocalProfileIndex H C io :=
  Sum.inr (Sum.inr (Sum.inl ⟨f₀, e, ⟨q, by omega⟩, hq2⟩))

def internalCommonImmediateEvictorLocalProfile
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : {g : Finset V // g ∈ H})
    (f : {g : Finset V // g ∈ H})
    (r : ℕ) (hr2 : 2 ≤ r) (hr3 : r ≤ 3) :
    CombinedTestLocalProfileIndex H C io :=
  Sum.inr (Sum.inr (Sum.inr ⟨e, f, ⟨r, by omega⟩, hr2⟩))

abbrev CombinedTestLocalRootCoordinate
    (H : Hypergraph V) (C : ConflictSystem V) (io : Type*)
    (j : io → ℕ) :=
  FiniteWeightedRootShadowCoordinate H
    (CombinedTestLocalProfileIndex H C io)
    (combinedTestLocalProfileActiveRank j)
    combinedTestLocalProfileSeed

noncomputable def combinedTestLocalEnhancedPredicate
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) :
    FiniteWeightedRootShadowEnhancedIndex H j
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io)) →
        ℕ → Hypergraph V → Prop :=
  finiteWeightedRootShadowEnhancedPredicate
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (combinedTestLocalProfileFamilyRank j)
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (combinedTestLocalProfileFamily H C j R)
      (combinedTestLocalProfileWeight H C j R)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R)

def externalRootCoordinateToCombined
    {H : Hypergraph V} {C : ConflictSystem V} {j : io → ℕ}
    (c : ExternalTestLocalRootCoordinate H C io j) :
    CombinedTestLocalRootCoordinate H C io j where
  profile := Sum.inl c.profile
  root := c.root
  root_subset_host := c.root_subset_host
  seed_subset_root := c.seed_subset_root
  selected := c.selected
  selected_pos := c.selected_pos
  legal := c.legal

/-- The final combined Good predicate projects to the already-green external
five-profile Good family, without exposing a new premise to any consumer. -/
theorem combinedGood_external
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    indexedGreedyGood
      (externalTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M := by
  intro z
  rcases z with z | c
  · exact hgood (Sum.inl z)
  · have hc := hgood (Sum.inr (externalRootCoordinateToCombined c))
    simpa [combinedTestLocalEnhancedPredicate,
      externalTestLocalEnhancedPredicate,
      finiteWeightedRootShadowEnhancedPredicate,
      finiteWeightedRootShadowPredicate,
      finiteWeightedRootShadowWeight,
      finiteWeightedRootShadowRank,
      externalRootCoordinateToCombined,
      combinedTestLocalProfileFamilyRank,
      combinedTestLocalProfileActiveRank,
      combinedTestLocalProfileSeed,
      combinedTestLocalProfileFamily,
      combinedTestLocalProfileWeight,
      combinedTestLocalProfileScale] using hc

/-- The combined local family retains the canonical degree-enhanced
projection.  This is the only projection needed by the mixed-loss adapter
and by the reachable availability argument. -/
theorem combinedGood_degree
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ GammaCore eta d N T j R.restrictedWeight) k M := by
  exact indexedFiniteWeightedRootShadowEnhancedGood_degree
    H R.regularized D₂ D₃ D₄ GammaCore eta d N T
      j R.restrictedWeight
      (combinedTestLocalProfileFamilyRank j)
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (combinedTestLocalProfileFamily H C j R)
      (combinedTestLocalProfileWeight H C j R)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R) hgood

/-- The Gamma-separated certificate corridor projection used by every
external and internal observable consumer. -/
theorem combinedGood_certificateWithCore
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M) :
    certificateIndexedGreedyGoodWithCore H C d epsRaw GammaCert ellCert j w R
      D₂ D₃ D₄ GammaCore (CFMNumeric.coreEpsilon eta) (N : ℝ) k M := by
  exact indexedFiniteWeightedRootShadowEnhancedGood_certificateWithCore
    H C d epsRaw GammaCert ellCert j w R D₂ D₃ D₄ GammaCore eta N T
      (combinedTestLocalProfileFamilyRank j)
      (combinedTestLocalProfileActiveRank j)
      (combinedTestLocalProfileSeed
        (H := H) (C := R.regularized) (io := io))
      (combinedTestLocalProfileFamily H C j R)
      (combinedTestLocalProfileWeight H C j R)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R) hgood

theorem combinedTestLocalProfileFamilyRank_le_five
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : io → ℕ) (hj3 : ∀ a, j a ≤ 3)
    (b : CombinedTestLocalProfileIndex H C io) :
    combinedTestLocalProfileFamilyRank j b ≤ 5 := by
  rcases b with b | b
  · exact externalTestLocalProfileFamilyRank_le_five H C j hj3 b
  · rcases b with b | b
    · simp only [combinedTestLocalProfileFamilyRank]
      omega
    · rcases b with b | b
      · simp only [combinedTestLocalProfileFamilyRank]
        omega
      · simp only [combinedTestLocalProfileFamilyRank]
        omega

theorem combinedTestLocalProfileActiveRank_le_familyRank
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : io → ℕ) (b : CombinedTestLocalProfileIndex H C io) :
    combinedTestLocalProfileActiveRank j b ≤
      combinedTestLocalProfileFamilyRank j b := by
  rcases b with b | b
  · exact externalTestLocalProfileActiveRank_le_familyRank H C j b
  · rcases b with b | b
    · rfl
    · rcases b with b | b
      · simp only [combinedTestLocalProfileActiveRank,
          combinedTestLocalProfileFamilyRank]
        omega
      · simp only [combinedTestLocalProfileActiveRank,
          combinedTestLocalProfileFamilyRank]
        omega

theorem combinedTestLocalProfile_isWeightedRealSpread
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (b : CombinedTestLocalProfileIndex H R.regularized io) :
    IsWeightedRealSpread
      (combinedTestLocalProfileFamily H C j R b)
      (combinedTestLocalProfileWeight H C j R b)
      (combinedTestLocalProfileFamilyRank j b)
      (combinedTestLocalProfileScale
        H C d epsRaw GammaCert ellCert j w R b) d⁻¹ := by
  rcases b with b | b
  · exact externalTestLocalProfile_isWeightedRealSpread
      H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
        hdegree hresidualCutoff b
  · rcases b with b | b
    · have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
      have hGamma3 : 0 ≤ 3 * GammaCert :=
        regularizedBounded_Gamma_nonneg R.bounded hdpos
      have hbase0 : 0 ≤ 72 * (3 * GammaCert + 1) := by positivity
      have hellR : 1 ≤ (ellCert : ℝ) := by exact_mod_cast hell
      have hcutoff : 72 * (3 * GammaCert + 1) ≤
          Real.rpow d (epsRaw / 10) := by
        have hmul : 72 * (3 * GammaCert + 1) ≤
            72 * (3 * GammaCert + 1) * (ellCert : ℝ) := by
          nlinarith
        exact hmul.trans hresidualCutoff
      change IsWeightedRealSpread
        (gainCollisionResidualLayer H R.regularized
          b.linkRank.1 b.unionRank.1)
        (f0TruncatedGainCollisionResidualRepresentationWeight
          (conflictLinkTestWeight R.regularized b.edge.1 b.linkRank.1)
          H R.regularized b.edge.1 b.linkRank.1 b.unionRank.1)
        (b.unionRank.1 - 2)
        (3 * certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
          Real.rpow d ((b.unionRank.1 : ℝ) -
            (b.linkRank.1 : ℝ) - epsRaw / 10)) d⁻¹
      exact
        Erdos136.RegularizationCertificate.f0TruncatedGainCollisionResidualLayer_isWeightedRealSpread
          R hd heps hcutoff b.edge.2 b.linkRank_pos (by omega)
          b.unionRank_two (by omega)
    · rcases b with b | b
      · change IsWeightedRealSpread
          (internalOriginalProfileFamily H b.toOriginal)
          (internalOriginalProfileWeight R b.toOriginal)
          (b.linkRank.1 - 1)
          (internalOriginalProfileScale
            H C d epsRaw GammaCert ellCert j w R b.toOriginal) d⁻¹
        exact
          Erdos136.RegularizationCertificate.internalOriginalProfile_isWeightedRealSpread
            R hd heps b.toOriginal
      · change IsWeightedRealSpread
          (commonImmediateEvictorLinkLayer R.regularized
            b.first.1 b.second.1 b.layer.1)
          (unitTestWeight (V := V)) b.layer.1
          ((3 * GammaCert + 1) *
            Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)) d⁻¹
        exact
          (commonImmediateEvictorLinkLayer_isRealSpread_of_certificate
            H C d epsRaw GammaCert ellCert j w R
              (lt_of_lt_of_le zero_lt_one hd)
              b.first.1 b.first.2 b.second.1 b.layer.1
              b.layer_two (by omega)).isWeightedRealSpread_unitTestWeight

theorem combinedTestLocalProfileScale_pos
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (hell : 1 ≤ ellCert)
    (b : CombinedTestLocalProfileIndex H R.regularized io) :
    0 < combinedTestLocalProfileScale
      H C d epsRaw GammaCert ellCert j w R b := by
  rcases b with b | b
  · exact externalTestLocalProfileScale_pos
      H C d epsRaw GammaCert ellCert j w R hd hell b
  · rcases b with b | b
    · change 0 < 3 * certificateInternalLayerScale
          H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
        Real.rpow d ((b.unionRank.1 : ℝ) -
          (b.linkRank.1 : ℝ) - epsRaw / 10)
      exact mul_pos
        (mul_pos (by norm_num) (certificateInternalLayerScale_pos
          H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1)
            (lt_of_lt_of_le zero_lt_one hd)))
        (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)
    · rcases b with b | b
      · change 0 < internalOriginalProfileScale
            H C d epsRaw GammaCert ellCert j w R b.toOriginal
        unfold internalOriginalProfileScale
        exact mul_pos
          (certificateInternalLayerScale_pos
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1)
              (lt_of_lt_of_le zero_lt_one hd))
          (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)
      · have hGamma3 : 0 ≤ 3 * GammaCert :=
          regularizedBounded_Gamma_nonneg R.bounded
            (lt_of_lt_of_le zero_lt_one hd)
        change 0 < (3 * GammaCert + 1) *
          Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)
        exact mul_pos (by linarith)
          (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)

theorem combinedTestLocalProfile_root_le_scale
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ) (j : io → ℕ)
    (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (b : CombinedTestLocalProfileIndex H R.regularized io)
    (root : Hypergraph V)
    (hroot : root.card ≤ combinedTestLocalProfileActiveRank j b) :
    weightedCodegree
        (combinedTestLocalProfileFamily H C j R b)
        (combinedTestLocalProfileWeight H C j R b) root ≤
      combinedTestLocalProfileScale
          H C d epsRaw GammaCert ellCert j w R b * d⁻¹ ^ root.card := by
  rcases b with b | b
  · exact externalTestLocalProfile_root_le_scale
      H C d epsRaw GammaCert ellCert j w R hd heps hell hj1 hj3
        hdegree hresidualCutoff b root hroot
  · rcases b with b | b
    · have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
      have hGamma3 : 0 ≤ 3 * GammaCert :=
        regularizedBounded_Gamma_nonneg R.bounded hdpos
      have hbase0 : 0 ≤ 72 * (3 * GammaCert + 1) := by positivity
      have hellR : 1 ≤ (ellCert : ℝ) := by exact_mod_cast hell
      have hcutoff : 72 * (3 * GammaCert + 1) ≤
          Real.rpow d (epsRaw / 10) := by
        have hmul : 72 * (3 * GammaCert + 1) ≤
            72 * (3 * GammaCert + 1) * (ellCert : ℝ) := by
          nlinarith
        exact hmul.trans hresidualCutoff
      have hspread :=
        Erdos136.RegularizationCertificate.f0TruncatedGainCollisionResidualLayer_isWeightedRealSpread
          R hd heps hcutoff b.edge.2 b.linkRank_pos (by omega)
          b.unionRank_two (by omega)
      change weightedF0TruncatedGainCollisionResidualRootMass
          (conflictLinkTestWeight R.regularized b.edge.1 b.linkRank.1)
          H R.regularized b.edge.1 b.linkRank.1 b.unionRank.1 root ≤
        (3 * certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
          Real.rpow d ((b.unionRank.1 : ℝ) -
            (b.linkRank.1 : ℝ) - epsRaw / 10)) * d⁻¹ ^ root.card
      by_cases hfull : root.card = b.unionRank.1 - 2
      · have hendpoint :=
          Erdos136.RegularizationCertificate.weightedF0TruncatedGainCollisionResidualRootMass_le_of_fullRank_spreadForm
            R hd heps hcutoff b.edge.2 b.linkRank_pos (by omega)
              b.unionRank_two (by omega) root hfull
        have hscale0 : 0 ≤ certificateInternalLayerScale
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) :=
          (certificateInternalLayerScale_pos
            H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1)
              hdpos).le
        have hrpow0 : 0 ≤ Real.rpow d ((b.unionRank.1 : ℝ) -
            (b.linkRank.1 : ℝ) - epsRaw / 10) :=
          Real.rpow_nonneg hdpos.le _
        have hinv0 : 0 ≤ d⁻¹ ^ root.card :=
          pow_nonneg (inv_nonneg.mpr hdpos.le) _
        have hprod0 : 0 ≤
            (certificateInternalLayerScale
                H C d epsRaw GammaCert ellCert j w R (b.linkRank.1 + 1) *
              Real.rpow d ((b.unionRank.1 : ℝ) -
                (b.linkRank.1 : ℝ) - epsRaw / 10)) *
              d⁻¹ ^ root.card :=
          mul_nonneg (mul_nonneg hscale0 hrpow0) hinv0
        exact hendpoint.trans (by nlinarith)
      · apply hspread.weightedShadow_le root
        change root.card < b.unionRank.1 - 2
        change root.card ≤ b.unionRank.1 - 2 at hroot
        omega
    · rcases b with b | b
      · have hspread :=
          Erdos136.RegularizationCertificate.internalOriginalProfile_isWeightedRealSpread
            R hd heps b.toOriginal
        change weightedCodegree
            (internalOriginalProfileFamily H b.toOriginal)
            (internalOriginalProfileWeight R b.toOriginal) root ≤
          internalOriginalProfileScale
            H C d epsRaw GammaCert ellCert j w R b.toOriginal *
              d⁻¹ ^ root.card
        apply hspread.weightedShadow_le root
        change root.card < b.linkRank.1 - 1
        change root.card ≤ b.linkRank.1 - 2 at hroot
        have hq2 := b.linkRank_two
        omega
      · have hspread :=
          (commonImmediateEvictorLinkLayer_isRealSpread_of_certificate
            H C d epsRaw GammaCert ellCert j w R
              (lt_of_lt_of_le zero_lt_one hd)
              b.first.1 b.first.2 b.second.1 b.layer.1
              b.layer_two (by omega)).isWeightedRealSpread_unitTestWeight
        change weightedCodegree
            (commonImmediateEvictorLinkLayer R.regularized
              b.first.1 b.second.1 b.layer.1)
            (unitTestWeight (V := V)) root ≤
          ((3 * GammaCert + 1) *
            Real.rpow d ((b.layer.1 : ℝ) - epsRaw / 4)) *
              d⁻¹ ^ root.card
        apply hspread.weightedShadow_le root
        change root.card < b.layer.1
        change root.card ≤ b.layer.1 - 1 at hroot
        have hr2 := b.layer_two
        omega

end

/-! ## Integrated: SharpCombinedTestEntropy -/


open Finset

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! The ordered-pair `C*` payload added to the combined profile contributes
exactly two possible ranks for every ordered pair of host edges.  This is
kept separate from the analytic tail bound so the eventual combined-index
entropy proof cannot silently omit the new branch. -/

abbrev InternalCommonImmediateEvictorProfileCode (H : Hypergraph V) :=
  ({e : Finset V // e ∈ H} × {f : Finset V // f ∈ H}) × Fin 2

def internalCommonImmediateEvictorProfileCode
    {H : Hypergraph V} (b : InternalCommonImmediateEvictorProfile H) :
    InternalCommonImmediateEvictorProfileCode H :=
  ((b.first, b.second), ⟨b.layer.1 - 2, by omega⟩)

theorem internalCommonImmediateEvictorProfileCode_injective
    (H : Hypergraph V) :
    Function.Injective
      (internalCommonImmediateEvictorProfileCode
        (H := H)) := by
  intro a b hab
  rcases a with ⟨aFirst, aSecond, aLayer, haTwo⟩
  rcases b with ⟨bFirst, bSecond, bLayer, hbTwo⟩
  simp only [internalCommonImmediateEvictorProfileCode,
    Prod.mk.injEq, Subtype.mk.injEq, Fin.mk.injEq] at hab
  rcases hab with ⟨⟨hFirst, hSecond⟩, hLayerSub⟩
  have hLayerVal : aLayer.1 = bLayer.1 := by omega
  cases hFirst
  cases hSecond
  have hLayer : aLayer = bLayer := Fin.ext hLayerVal
  cases hLayer
  rfl

theorem card_internalCommonImmediateEvictorProfile_le
    (H : Hypergraph V) :
    Fintype.card (InternalCommonImmediateEvictorProfile H) ≤
      H.card * H.card * 2 := by
  calc
    Fintype.card (InternalCommonImmediateEvictorProfile H) ≤
        Fintype.card (InternalCommonImmediateEvictorProfileCode H) :=
      Fintype.card_le_of_injective
        (internalCommonImmediateEvictorProfileCode (H := H))
        (internalCommonImmediateEvictorProfileCode_injective H)
    _ = H.card * H.card * 2 := by
      simp [InternalCommonImmediateEvictorProfileCode]

end

