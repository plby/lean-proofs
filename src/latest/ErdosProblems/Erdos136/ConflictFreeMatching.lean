/-! ## Integrated: PersistentInternalComponentMean -/


open Finset Real CFMTrajectories

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! ## Exact survivor-restricted component means

The source proof of Lemma 7.22 estimates the gain and loss components
separately after restricting to choices which leave the distinguished
internal-link edge active.  This file exposes those exact finite
double-count numerators.  In particular, it does not transport an
unrestricted net window through one-sided bounds on killed choices.
-/

/-- Gain choices for one test set, restricted to choices on which the
distinguished internal-link edge remains available. -/
def persistentPartialTestGainChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) (j s : ℕ) (S : Hypergraph V) : Hypergraph V :=
  (partialTestGainChoiceSet H C M j s S).filter fun e ↦
    f ∈ availableEdges H C (insert e M)

/-- Loss choices for one test set, restricted to choices on which the
distinguished internal-link edge remains available. -/
def persistentPartialTestLossChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) (j s : ℕ) (S : Hypergraph V) : Hypergraph V :=
  (partialTestLossChoiceSet H C M j s S).filter fun e ↦
    f ∈ availableEdges H C (insert e M)

noncomputable def weightedPersistentPartialTestGainChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    w S * (persistentPartialTestGainChoiceSet H C M f j s S).card

noncomputable def weightedPersistentPartialTestLossChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    w S * (persistentPartialTestLossChoiceSet H C M f j s S).card

theorem sum_persistentPartialTestStepGain_eq_weightedChoiceCount
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) :
    ∑ e ∈ persistentInternalConflictLinkChoices H C M f,
        partialTestStepGain w H C j s M e =
      weightedPersistentPartialTestGainChoices w H C M f j s := by
  unfold partialTestStepGain partialTestGainBetween
    weightedPersistentPartialTestGainChoices
    persistentPartialTestGainChoiceSet
    persistentInternalConflictLinkChoices partialTestGainChoiceSet
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.filter_filter]
  calc
    (∑ e ∈ (availableEdges H C M).filter (fun e ↦
          f ∈ availableEdges H C (insert e M)),
        if ¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S then w S else 0) =
        ∑ e ∈ (availableEdges H C M).filter (fun e ↦
          f ∈ availableEdges H C (insert e M) ∧
          (¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S)), w S := by
      rw [Finset.sum_filter]
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro e he
      by_cases hsurv : f ∈ availableEdges H C (insert e M) <;>
        by_cases hstep :
          ¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S <;>
        simp [hsurv, hstep]
    _ = w S * ((availableEdges H C M).filter (fun e ↦
          (¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S) ∧
          f ∈ availableEdges H C (insert e M))).card := by
      rw [show (availableEdges H C M).filter (fun e ↦
          f ∈ availableEdges H C (insert e M) ∧
          (¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S)) =
          (availableEdges H C M).filter (fun e ↦
          (¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S) ∧
          f ∈ availableEdges H C (insert e M)) by
        ext e
        simp only [Finset.mem_filter]
        tauto]
      simp [mul_comm]

theorem sum_persistentPartialTestStepLoss_eq_weightedChoiceCount
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) :
    ∑ e ∈ persistentInternalConflictLinkChoices H C M f,
        partialTestStepLoss w H C j s M e =
      weightedPersistentPartialTestLossChoices w H C M f j s := by
  unfold partialTestStepLoss partialTestLossBetween
    weightedPersistentPartialTestLossChoices
    persistentPartialTestLossChoiceSet
    persistentInternalConflictLinkChoices partialTestLossChoiceSet
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.filter_filter]
  calc
    (∑ e ∈ (availableEdges H C M).filter (fun e ↦
          f ∈ availableEdges H C (insert e M)),
        if partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S then w S else 0) =
        ∑ e ∈ (availableEdges H C M).filter (fun e ↦
          f ∈ availableEdges H C (insert e M) ∧
          (partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S)), w S := by
      rw [Finset.sum_filter]
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro e he
      by_cases hsurv : f ∈ availableEdges H C (insert e M) <;>
        by_cases hstep :
          partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S <;>
        simp [hsurv, hstep]
    _ = w S * ((availableEdges H C M).filter (fun e ↦
          (partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S) ∧
          f ∈ availableEdges H C (insert e M))).card := by
      rw [show (availableEdges H C M).filter (fun e ↦
          f ∈ availableEdges H C (insert e M) ∧
          (partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S)) =
          (availableEdges H C M).filter (fun e ↦
          (partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S) ∧
          f ∈ availableEdges H C (insert e M)) by
        ext e
        simp only [Finset.mem_filter]
        tauto]
      simp [mul_comm]

theorem meanPersistentPartialTestGain_eq_weightedChoiceCount_div
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    meanPersistentPartialTestGain w H C f j s M =
      weightedPersistentPartialTestGainChoices w H C M f j s /
        ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp ⟨f, hf⟩
  simp only [meanPersistentPartialTestGain, hAne, if_false]
  rw [sum_persistentPartialTestStepGain_eq_weightedChoiceCount]

theorem meanPersistentPartialTestLoss_eq_weightedChoiceCount_div
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    meanPersistentPartialTestLoss w H C f j s M =
      weightedPersistentPartialTestLossChoices w H C M f j s /
        ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp ⟨f, hf⟩
  simp only [meanPersistentPartialTestLoss, hAne, if_false]
  rw [sum_persistentPartialTestStepLoss_eq_weightedChoiceCount]

/-- The exact finite identity behind the survival factor: `p` times the
number of current choices is the number of next-active choices. -/
theorem persistentInternalConflictLinkProbability_mul_card
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    persistentInternalConflictLinkProbability H C f M *
        ((availableEdges H C M).card : ℝ) =
      ((persistentInternalConflictLinkChoices H C M f).card : ℝ) := by
  have hBsub : availableBlockerChoices H C M f ⊆
      availableEdges H C M := by
    intro e he
    exact (Finset.mem_filter.mp he).1
  have hA0 : (((availableEdges H C M).card : ℝ)) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr ⟨f, hf⟩
  have hcardSplit :
      (((availableEdges H C M \ availableBlockerChoices H C M f).card : ℕ) : ℝ) =
        ((availableEdges H C M).card : ℝ) -
          ((availableBlockerChoices H C M f).card : ℝ) := by
    rw [Finset.card_sdiff_of_subset hBsub,
      Nat.cast_sub (Finset.card_le_card hBsub)]
  rw [persistentInternalConflictLinkProbability_eq_one_sub_blockers
    H C M hf, persistentInternalConflictLinkChoices_eq_sdiff_blockers
      H C M hf, hcardSplit]
  field_simp

/-! The unrestricted component estimates used before imposing the survival
indicator.  These retain gain collision and loss overlap as separate
finite errors, so the later Lemma 7.20 correction can be applied to the
loss component without first collapsing to a net window. -/

theorem meanPartialTestGain_component_bounds
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S)
    (hA : (availableEdges H C M).Nonempty) :
    ((((s + 1 : ℕ) : ℝ) *
          partialTestObservable w H C j (s + 1) M) -
        weightedPartialTestGainCollision w H C M j s) /
          ((availableEdges H C M).card : ℝ) ≤
        meanPartialTestGain w H C j s M ∧
      meanPartialTestGain w H C j s M ≤
        (((s + 1 : ℕ) : ℝ) *
          partialTestObservable w H C j (s + 1) M) /
            ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ := hA.ne_empty
  have hden0 : 0 ≤ ((availableEdges H C M).card : ℝ) := by positivity
  have hlower := succ_mul_observable_le_weightedGain_add_collision
    w H C M j s hw
  have hupper := weightedPartialTestGainChoices_le_succ_mul_observable
    w H C M j s hw
  simp only [meanPartialTestGain, hAne, if_false,
    sum_partialTestStepGain_eq_weightedChoiceCount]
  constructor
  · apply div_le_div_of_nonneg_right _ hden0
    linarith
  · exact div_le_div_of_nonneg_right hupper hden0

theorem meanPartialTestLoss_eq_incidence_sub_collision_div
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (hA : (availableEdges H C M).Nonempty) :
    meanPartialTestLoss w H C j s M =
      (weightedPartialTestBlockerIncidence w H C M j s -
        weightedPartialTestLossCollision w H C M j s) /
          ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ := hA.ne_empty
  simp only [meanPartialTestLoss, hAne, if_false,
    sum_partialTestStepLoss_eq_weightedChoiceCount]
  rw [← weightedLoss_add_collision_eq_blockerIncidence]
  ring

theorem meanPartialTestLoss_component_bounds
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    {incidenceLo incidenceHi collisionHi : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hA : (availableEdges H C M).Nonempty)
    (hincidence : incidenceLo ≤
          weightedPartialTestBlockerIncidence w H C M j s ∧
        weightedPartialTestBlockerIncidence w H C M j s ≤ incidenceHi)
    (hcollision :
      weightedPartialTestLossCollision w H C M j s ≤ collisionHi) :
    (incidenceLo - collisionHi) /
          ((availableEdges H C M).card : ℝ) ≤
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestLoss w H C j s M ≤
        incidenceHi / ((availableEdges H C M).card : ℝ) := by
  have hden0 : 0 ≤ ((availableEdges H C M).card : ℝ) := by positivity
  have hcollision0 : 0 ≤ weightedPartialTestLossCollision w H C M j s := by
    unfold weightedPartialTestLossCollision
    apply Finset.sum_nonneg
    intro S hS
    split
    · exact mul_nonneg (hw S) (Nat.cast_nonneg _)
    · norm_num
  rw [meanPartialTestLoss_eq_incidence_sub_collision_div
    w H C M j s hA]
  constructor
  · apply div_le_div_of_nonneg_right _ hden0
    linarith
  · apply div_le_div_of_nonneg_right _ hden0
    linarith

/-- Direct source-facing component absorption.  Each component is centered
against the number of surviving choices, not against all available choices.
-/
def HasPersistentPartialTestComponentAbsorption
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ)
    (gainLo gainHi lossLo lossHi : ℝ) : Prop :=
  gainLo * ((persistentInternalConflictLinkChoices H C M f).card : ℝ) ≤
      weightedPersistentPartialTestGainChoices w H C M f j s ∧
    weightedPersistentPartialTestGainChoices w H C M f j s ≤
      gainHi * ((persistentInternalConflictLinkChoices H C M f).card : ℝ) ∧
    lossLo * ((persistentInternalConflictLinkChoices H C M f).card : ℝ) ≤
      weightedPersistentPartialTestLossChoices w H C M f j s ∧
    weightedPersistentPartialTestLossChoices w H C M f j s ≤
      lossHi * ((persistentInternalConflictLinkChoices H C M f).card : ℝ)

theorem persistentPartialTest_componentMeanWindow_of_absorption
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ)
    {gainLo gainHi lossLo lossHi : ℝ}
    (habsorb : HasPersistentPartialTestComponentAbsorption
      w H C M f j s gainLo gainHi lossLo lossHi) :
    persistentInternalConflictLinkProbability H C f M * gainLo ≤
        meanPersistentPartialTestGain w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * gainHi ∧
      persistentInternalConflictLinkProbability H C f M * lossLo ≤
        meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * lossHi := by
  have hApos : 0 < ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr ⟨f, hf⟩
  have hpCard := persistentInternalConflictLinkProbability_mul_card
    H C M hf
  rw [meanPersistentPartialTestGain_eq_weightedChoiceCount_div
      w H C M hf j s,
    meanPersistentPartialTestLoss_eq_weightedChoiceCount_div
      w H C M hf j s]
  constructor
  · apply (le_div_iff₀ hApos).2
    calc
      (persistentInternalConflictLinkProbability H C f M * gainLo) *
          ((availableEdges H C M).card : ℝ) =
          gainLo * (persistentInternalConflictLinkProbability H C f M *
            ((availableEdges H C M).card : ℝ)) := by ring
      _ = gainLo *
          ((persistentInternalConflictLinkChoices H C M f).card : ℝ) := by
            rw [hpCard]
      _ ≤ _ := habsorb.1
  constructor
  · apply (div_le_iff₀ hApos).2
    calc
      _ ≤ gainHi *
          ((persistentInternalConflictLinkChoices H C M f).card : ℝ) :=
            habsorb.2.1
      _ = (persistentInternalConflictLinkProbability H C f M * gainHi) *
          ((availableEdges H C M).card : ℝ) := by
            rw [← hpCard]
            ring
  constructor
  · apply (le_div_iff₀ hApos).2
    calc
      (persistentInternalConflictLinkProbability H C f M * lossLo) *
          ((availableEdges H C M).card : ℝ) =
          lossLo * (persistentInternalConflictLinkProbability H C f M *
            ((availableEdges H C M).card : ℝ)) := by ring
      _ = lossLo *
          ((persistentInternalConflictLinkChoices H C M f).card : ℝ) := by
            rw [hpCard]
      _ ≤ _ := habsorb.2.2.1
  · apply (div_le_iff₀ hApos).2
    calc
      _ ≤ lossHi *
          ((persistentInternalConflictLinkChoices H C M f).card : ℝ) :=
            habsorb.2.2.2
      _ = (persistentInternalConflictLinkProbability H C f M * lossHi) *
          ((availableEdges H C M).card : ℝ) := by
            rw [← hpCard]
            ring

/-! ## Trajectory component centers and exact E+/E- algebra -/

noncomputable def persistentInternalConflictLinkGainCenter
    (D₂ D₃ D₄ d N scale : ℝ) (j s : ℕ) (x : ℝ) : ℝ :=
  scale * (((s + 1 : ℕ) : ℝ) *
    zHat D₂ D₃ D₄ d N j (s + 1) x /
      hHat D₂ D₃ D₄ d N x)

noncomputable def persistentInternalConflictLinkLossCenter
    (D₂ D₃ D₄ d N scale : ℝ) (j s : ℕ) (x : ℝ) : ℝ :=
  scale * ((s : ℝ) *
    (cHat D₂ D₃ D₄ d N x + 8 * dHat D₂ D₃ D₄ d N x) *
      zHat D₂ D₃ D₄ d N j s x /
        hHat D₂ D₃ D₄ d N x)

noncomputable def persistentInternalConflictLinkComponentError
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ)
    (j s : ℕ) (x : ℝ) : ℝ :=
  scale * zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x

theorem persistentInternalConflictLink_gainCenter_sub_lossCenter
    (D₂ D₃ D₄ d N scale : ℝ) (j s : ℕ) (x : ℝ) :
    persistentInternalConflictLinkGainCenter
        D₂ D₃ D₄ d N scale j s x -
      persistentInternalConflictLinkLossCenter
        D₂ D₃ D₄ d N scale j s x =
      scale * zHatRate D₂ D₃ D₄ d N j s x := by
  unfold persistentInternalConflictLinkGainCenter
    persistentInternalConflictLinkLossCenter zHatRate
  ring

/-- Pure component algebra: two quarter-error survivor windows combine to
the half-error survivor net window. -/
theorem persistentInternalConflictLink_componentWindows_to_net
    {p gain loss gainCenter lossCenter componentError : ℝ}
    (hgain : p * (gainCenter - componentError / 4) ≤ gain ∧
      gain ≤ p * (gainCenter + componentError / 4))
    (hloss : p * (lossCenter - componentError / 4) ≤ loss ∧
      loss ≤ p * (lossCenter + componentError / 4)) :
    p * ((gainCenter - lossCenter) - componentError / 2) ≤
        gain - loss ∧
      gain - loss ≤
        p * ((gainCenter - lossCenter) + componentError / 2) := by
  constructor <;> nlinarith [hgain.1, hgain.2, hloss.1, hloss.2]

/-- Componentwise gain transfer with all centering arithmetic explicit.
The source proof supplies the killed-gain cap and the two displayed scalar
inequalities; merely having a one-sided cap without those inequalities is
not enough to create the survival factor. -/
theorem persistentPartialTestGain_componentWindow_of_full_killed
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ)
    {center componentError fullLowerError fullUpperError killedError : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hfull : center - fullLowerError ≤
          meanPartialTestGain w H C j s M ∧
        meanPartialTestGain w H C j s M ≤ center + fullUpperError)
    (hkilled : meanKilledPartialTestGain w H C f j s M ≤ killedError)
    (hnumericLower :
      fullLowerError + killedError ≤
        (1 - persistentInternalConflictLinkProbability H C f M) * center +
          persistentInternalConflictLinkProbability H C f M *
            componentError / 4)
    (hnumericUpper :
      (1 - persistentInternalConflictLinkProbability H C f M) * center +
          fullUpperError ≤
        persistentInternalConflictLinkProbability H C f M *
          componentError / 4) :
    persistentInternalConflictLinkProbability H C f M *
          (center - componentError / 4) ≤
        meanPersistentPartialTestGain w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M *
          (center + componentError / 4) := by
  have hkilled0 := meanKilledPartialTestGain_nonneg
    w H C f j s M hw
  have hsplit := meanPersistent_add_killed_gain w H C M hf j s
  constructor <;> nlinarith

/-- Componentwise loss transfer.  `hkilled` is precisely the joint
freeze-and-loss term of Lemma 7.20.  For internal link rank one its proof
uses C5/common-links and the frozen-source/chosen-blocker C* partial-family cap. -/
theorem persistentPartialTestLoss_componentWindow_of_full_killed
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ)
    {center componentError fullLowerError fullUpperError killedError : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hfull : center - fullLowerError ≤
          meanPartialTestLoss w H C j s M ∧
        meanPartialTestLoss w H C j s M ≤ center + fullUpperError)
    (hkilled : meanKilledPartialTestLoss w H C f j s M ≤ killedError)
    (hnumericLower :
      fullLowerError + killedError ≤
        (1 - persistentInternalConflictLinkProbability H C f M) * center +
          persistentInternalConflictLinkProbability H C f M *
            componentError / 4)
    (hnumericUpper :
      (1 - persistentInternalConflictLinkProbability H C f M) * center +
          fullUpperError ≤
        persistentInternalConflictLinkProbability H C f M *
          componentError / 4) :
    persistentInternalConflictLinkProbability H C f M *
          (center - componentError / 4) ≤
        meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M *
          (center + componentError / 4) := by
  have hkilled0 := meanKilledPartialTestLoss_nonneg
    w H C f j s M hw
  have hsplit := meanPersistent_add_killed_loss w H C M hf j s
  constructor <;> nlinarith

/-- Source-faithful Lemma 7.22 interface.  The two hypotheses are exactly
the restricted `E+` and `E-` estimates.  Their conclusion is centered at
`p * scale * zHatRate`; no unrestricted mean or one-sided killed bound is
used. -/
theorem persistentInternalConflictLink_componentMeanWindow
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (hgain :
      persistentInternalConflictLinkProbability H C f M *
          (persistentInternalConflictLinkGainCenter
              D₂ D₃ D₄ d N scale j s x -
            persistentInternalConflictLinkComponentError
              D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4) ≤
        meanPersistentPartialTestGain w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M *
          (persistentInternalConflictLinkGainCenter
              D₂ D₃ D₄ d N scale j s x +
            persistentInternalConflictLinkComponentError
              D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4))
    (hloss :
      persistentInternalConflictLinkProbability H C f M *
          (persistentInternalConflictLinkLossCenter
              D₂ D₃ D₄ d N scale j s x -
            persistentInternalConflictLinkComponentError
              D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4) ≤
        meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M *
          (persistentInternalConflictLinkLossCenter
              D₂ D₃ D₄ d N scale j s x +
            persistentInternalConflictLinkComponentError
              D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4)) :
    persistentInternalConflictLinkProbability H C f M * scale *
          (zHatRate D₂ D₃ D₄ d N j s x -
            zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x / 2) ≤
        meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * scale *
          (zHatRate D₂ D₃ D₄ d N j s x +
            zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x / 2) := by
  have hnet := persistentInternalConflictLink_componentWindows_to_net
    hgain hloss
  rw [persistentInternalConflictLink_gainCenter_sub_lossCenter] at hnet
  unfold persistentInternalConflictLinkComponentError at hnet
  constructor
  · calc
      _ = persistentInternalConflictLinkProbability H C f M *
          ((scale * zHatRate D₂ D₃ D₄ d N j s x) -
            (scale * zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x) / 2) := by
            ring
      _ ≤ _ := hnet.1
  · calc
      _ ≤ persistentInternalConflictLinkProbability H C f M *
          ((scale * zHatRate D₂ D₃ D₄ d N j s x) +
            (scale * zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x) / 2) :=
            hnet.2
      _ = _ := by ring

/-- Finite source endpoint: it is enough to prove the four survivor-choice
numerator inequalities at the two trajectory component centres. -/
theorem persistentInternalConflictLink_componentMeanWindow_of_absorption
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (habsorb : HasPersistentPartialTestComponentAbsorption
      w H C M f j s
      (persistentInternalConflictLinkGainCenter
          D₂ D₃ D₄ d N scale j s x -
        persistentInternalConflictLinkComponentError
          D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4)
      (persistentInternalConflictLinkGainCenter
          D₂ D₃ D₄ d N scale j s x +
        persistentInternalConflictLinkComponentError
          D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4)
      (persistentInternalConflictLinkLossCenter
          D₂ D₃ D₄ d N scale j s x -
        persistentInternalConflictLinkComponentError
          D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4)
      (persistentInternalConflictLinkLossCenter
          D₂ D₃ D₄ d N scale j s x +
        persistentInternalConflictLinkComponentError
          D₂ D₃ D₄ Gamma epsilon d N scale j s x / 4)) :
    persistentInternalConflictLinkProbability H C f M * scale *
          (zHatRate D₂ D₃ D₄ d N j s x -
            zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x / 2) ≤
        meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * scale *
          (zHatRate D₂ D₃ D₄ d N j s x +
            zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x / 2) := by
  have hcomponents := persistentPartialTest_componentMeanWindow_of_absorption
    w H C M hf j s habsorb
  exact persistentInternalConflictLink_componentMeanWindow
    w H C M D₂ D₃ D₄ Gamma epsilon d N scale x j s
      ⟨hcomponents.1, hcomponents.2.1⟩
      ⟨hcomponents.2.2.1, hcomponents.2.2.2⟩

end

/-! ## Integrated: PersistentInternalConflictLinkKilledNet -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! Lemma 7.22 needs a survival-weighted centre.  These statements isolate
the exact algebra: the killed net mean is compared with the missing
trajectory mass `(1-p) * center`. -/

/-- Exact full/persistent/killed net decomposition. -/
theorem meanPartialTestNet_eq_persistent_add_killed
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M =
      (meanPersistentPartialTestGain w H C f j s M -
        meanPersistentPartialTestLoss w H C f j s M) +
      (meanKilledPartialTestGain w H C f j s M -
        meanKilledPartialTestLoss w H C f j s M) := by
  have hgain := meanPersistent_add_killed_gain w H C M hf j s
  have hloss := meanPersistent_add_killed_loss w H C M hf j s
  linarith

/-- A small survival deficit together with one-sided killed gain/loss caps
gives the precise two-sided killed-net window around the missing trajectory
mass.  In the source proof the gain cap is `C_{f,2}` and the loss cap is the
Lemma 7.20 joint-deactivation term. -/
theorem killedPartialTestNet_window_of_caps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f : Finset V) (j s : ℕ) (M : Hypergraph V)
    (hw : ∀ S, 0 ≤ w S) {center centerAbs survivalError gainError lossError : ℝ}
    (hpUpper : persistentInternalConflictLinkProbability H C f M ≤ 1)
    (hdefect : 1 - persistentInternalConflictLinkProbability H C f M ≤
      survivalError)
    (hcenter : |center| ≤ centerAbs)
    (hgain : meanKilledPartialTestGain w H C f j s M ≤ gainError)
    (hloss : meanKilledPartialTestLoss w H C f j s M ≤ lossError) :
    (1 - persistentInternalConflictLinkProbability H C f M) * center -
          (lossError + survivalError * centerAbs) ≤
        meanKilledPartialTestGain w H C f j s M -
          meanKilledPartialTestLoss w H C f j s M ∧
      meanKilledPartialTestGain w H C f j s M -
          meanKilledPartialTestLoss w H C f j s M ≤
        (1 - persistentInternalConflictLinkProbability H C f M) * center +
          (gainError + survivalError * centerAbs) := by
  let p := persistentInternalConflictLinkProbability H C f M
  have hp0 : 0 ≤ p :=
    persistentInternalConflictLinkProbability_nonneg H C f M
  have hmiss0 : 0 ≤ 1 - p := by
    dsimp only [p] at hpUpper ⊢
    linarith
  have hsurv0 : 0 ≤ survivalError := hmiss0.trans hdefect
  have hcenter0 : 0 ≤ centerAbs :=
    (abs_nonneg center).trans hcenter
  have hcenterUpper : center ≤ centerAbs :=
    (le_abs_self center).trans hcenter
  have hcenterLower : -centerAbs ≤ center :=
    (neg_le_neg hcenter).trans (neg_abs_le center)
  have hmissingUpper : (1 - p) * center ≤ survivalError * centerAbs := by
    calc
      (1 - p) * center ≤ (1 - p) * centerAbs :=
        mul_le_mul_of_nonneg_left hcenterUpper hmiss0
      _ ≤ survivalError * centerAbs :=
        mul_le_mul_of_nonneg_right hdefect hcenter0
  have hmissingLower : -(survivalError * centerAbs) ≤
      (1 - p) * center := by
    have hneg : (1 - p) * (-centerAbs) ≤ (1 - p) * center :=
      mul_le_mul_of_nonneg_left hcenterLower hmiss0
    have hprod : (1 - p) * centerAbs ≤ survivalError * centerAbs :=
      mul_le_mul_of_nonneg_right hdefect hcenter0
    nlinarith
  have hg0 := meanKilledPartialTestGain_nonneg w H C f j s M hw
  have hl0 := meanKilledPartialTestLoss_nonneg w H C f j s M hw
  dsimp only [p] at hmissingUpper hmissingLower ⊢
  constructor <;> linarith

/-- Source-shaped Lemma 7.22 transfer.  A full mean window and a
two-sided killed-net window yield the persistent window centred at exactly
`p * center`, rather than at the unconditional centre. -/
theorem persistentPartialTest_meanWindow_of_killedNet
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ)
    {center fullLowerError fullUpperError
      killedLowerError killedUpperError : ℝ}
    (hfull : center - fullLowerError ≤
          meanPartialTestGain w H C j s M -
            meanPartialTestLoss w H C j s M ∧
        meanPartialTestGain w H C j s M -
            meanPartialTestLoss w H C j s M ≤
          center + fullUpperError)
    (hkilled :
      (1 - persistentInternalConflictLinkProbability H C f M) * center -
            killedLowerError ≤
          meanKilledPartialTestGain w H C f j s M -
            meanKilledPartialTestLoss w H C f j s M ∧
        meanKilledPartialTestGain w H C f j s M -
            meanKilledPartialTestLoss w H C f j s M ≤
          (1 - persistentInternalConflictLinkProbability H C f M) * center +
            killedUpperError) :
    persistentInternalConflictLinkProbability H C f M * center -
          (fullLowerError + killedUpperError) ≤
        meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * center +
          (fullUpperError + killedLowerError) := by
  have hsplit := meanPartialTestNet_eq_persistent_add_killed
    w H C M hf j s
  constructor <;> nlinarith

end

/-! ## Integrated: SharpPersistentKilledNetNumeric -/


open Finset Real CFMTrajectories

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

namespace CFMSharpPersistentKilledNetNumeric

/-! The cutoff already contains considerably more host-size room than is
needed to make one fixed certificate link survive with probability `4/5`.
This is the scalar comparison used below; it is kept independent of any
survivor-filtered mean estimate. -/

/-- The deterministic test remainder is below the common logarithmic
scale.  This is the small scalar step needed after the source-faithful
component window gives an error of `zetaRate / 2`. -/
theorem testRemainder_le_commonScale_of_registry
    {eta Gamma D₂ D₃ D₄ d N x P : ℝ} {j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x P j s) :
    d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N ≤
      Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s x /
        (N * CFMTrajectories.pV N x) := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end x hx)
  have hp1 := CFMTrajectories.pV_le_one R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hEnv0 : 0 ≤ CFMTrajectories.zeta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N j s x :=
    (CFMTrajectories.zeta_pos hd
      (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm R.s_le_j).le
  have hEnvlo := (CFMTrajectories.zeta_bounds_of_registry R hx).1
  have hpowRem : d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) ≤
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s x := by
    calc
      d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) ≤
          d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
        have heps : 0 ≤ CFMNumeric.coreEpsilon eta := by
          rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
            simp only [CFMNumeric.coreEpsilon,
              CFMRegularization.rawRegularizationEps]
            ring]
          exact div_nonneg E.eta_pos.le (by norm_num)
        nlinarith
      _ ≤ _ := hEnvlo
  have hprod : CFMTrajectories.pV N x *
        d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) ≤
      Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s x := by
    calc
      CFMTrajectories.pV N x *
          d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) ≤
          1 * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N j s x :=
        mul_le_mul hp1 hpowRem (Real.rpow_nonneg hd.le _) (by norm_num)
      _ ≤ Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s x :=
        mul_le_mul_of_nonneg_right E.Gamma_one hEnv0
  calc
    d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N =
        (CFMTrajectories.pV N x *
          d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta)) /
            (N * CFMTrajectories.pV N x) := by
      field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
    _ ≤ _ := div_le_div_of_nonneg_right hprod
      (mul_nonneg R.delta.degree.N_pos.le hp.le)

/-- The componentwise `zetaRate / 2` window has ample room for the final
two-remainder correction. -/
theorem four_testRemainder_le_zetaRate_of_registry
    {eta Gamma D₂ D₃ D₄ d N x P : ℝ} {j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N x P j s) :
    4 * (d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N) ≤
      CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s x := by
  let common := Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N j s x /
      (N * CFMTrajectories.pV N x)
  have hcommon0 : 0 ≤ common := by
    have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
    have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
    have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
      (R.delta.degree.before_end x hx)
    have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
      (R.delta.degree.time_nonneg x hx)
    have hEnv0 : 0 ≤ CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s x :=
      (CFMTrajectories.zeta_pos hd
        (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp hm R.s_le_j).le
    dsimp only [common]
    exact div_nonneg
      (mul_nonneg (le_trans zero_le_one E.Gamma_one) hEnv0)
      (mul_nonneg R.delta.degree.N_pos.le hp.le)
  have hrem : d ^ ((s : ℝ) - j - CFMNumeric.coreEpsilon eta) / N ≤
      common := by
    simpa only [common] using testRemainder_le_commonScale_of_registry E R
  have hrateRaw := CFMTrajectories.zetaRate_lower_of_registry R
  have hrate : 76000 * common ≤
      CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s x := by
    calc
      76000 * common =
          76000 * Gamma / (N * CFMTrajectories.pV N x) *
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j s x := by
        dsimp only [common]
        ring
      _ ≤ _ := hrateRaw
  have hfour : 4 * common ≤ 76000 * common :=
    mul_le_mul_of_nonneg_right (by norm_num) hcommon0
  exact (mul_le_mul_of_nonneg_left hrem (by norm_num)).trans
    (hfour.trans hrate)

theorem ninetyGamma_mul_d_le_localSpreadAvailableFloor
    {eta Gamma d N : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    90 * Gamma * d ≤ localSpreadAvailableFloor eta d N := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hd1 : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have heta3 : 0 ≤ eta ^ 3 := pow_nonneg E.eta_pos.le 3
  have heps : 0 ≤ CFMNumeric.coreEpsilon eta := by
    rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
      simp only [CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      ring]
    exact div_nonneg E.eta_pos.le (by norm_num)
  have hGammaSq : Gamma ≤ Gamma ^ 2 := by
    have hprod := mul_nonneg hGamma0 (sub_nonneg.mpr E.Gamma_one)
    nlinarith
  have hcoeff : 92160 * Gamma ≤ 12288000000000 * Gamma ^ 2 := by
    nlinarith [hGammaSq]
  have hexponent :
      eta - 2 * eta ^ 3 - 63 * CFMNumeric.coreEpsilon eta / 64 ≤
        eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3 := by
    nlinarith
  have hpower : 92160 * Gamma ≤
      d ^ (eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := by
    calc
      92160 * Gamma ≤ 12288000000000 * Gamma ^ 2 := hcoeff
      _ ≤ d ^
          (eta - 2 * eta ^ 3 - 63 * CFMNumeric.coreEpsilon eta / 64) :=
        S.deltaSecondOrder
      _ ≤ d ^ (eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) :=
        Real.rpow_le_rpow_of_exponent_le hd1 hexponent
  rw [localSpreadAvailableFloor_eq_rpow hd]
  have hhost := mul_le_mul_of_nonneg_right hN
    (Real.rpow_nonneg hd.le
      (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3))
  calc
    90 * Gamma * d =
        d * (92160 * Gamma) / 1024 := by ring
    _ ≤ d * d ^
        (eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 1024 := by
      exact div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left hpower hd.le) (by norm_num)
    _ = (d ^ eta / 2) *
        d ^ (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 := by
      calc
        d * d ^ (eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) /
              1024 =
            (d ^ (1 : ℝ) *
              d ^ (eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) /
                1024 := by rw [Real.rpow_one]
        _ = d ^ ((1 : ℝ) +
              (eta - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) /
                1024 := by rw [Real.rpow_add hd]
        _ = d ^ (eta +
              (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) /
                1024 := by
          congr 2
          ring
        _ = (d ^ eta *
              d ^ (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) /
                1024 := by rw [Real.rpow_add hd]
        _ = (d ^ eta / 2) *
              d ^ (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) /
                512 := by ring
    _ ≤ N * d ^
        (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 := by
      exact div_le_div_of_nonneg_right hhost (by norm_num)

/-- The literal certificate status is at most one fifth of the available
choice set.  The hypotheses are all structural: the status corridor and
available-edge floor are the conclusions supplied by final Good. -/
theorem certificateTestStatusHi_le_availableEdges_fifth
    {eta Gamma d N D₂ D₃ D₄ P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P)
    {a : ℝ} (ha : localSpreadAvailableFloor eta d N ≤ a) :
    5 * certificateTestStatusHi D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N k ≤ a := by
  have hstatus := CFMSharpTestCutoff.certificateTestStatusHi_le_eighteenGamma_mul_d
    E S R
  have hfloor := ninetyGamma_mul_d_le_localSpreadAvailableFloor E S hN
  nlinarith

/-- Registry-derived `p ≥ 4/5` for a fixed available internal link.  No
mean estimate is used here. -/
theorem persistentInternalConflictLinkProbability_ge_four_fifths
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    {eta Gamma d N D₂ D₃ D₄ P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P)
    (havailable : localSpreadAvailableFloor eta d N ≤
      ((availableEdges H C M).card : ℝ))
    (hstatus : ((availableBlockerChoices H C M f).card : ℝ) ≤
      certificateTestStatusHi D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N k) :
    (4 / 5 : ℝ) ≤
      persistentInternalConflictLinkProbability H C f M := by
  let a : ℝ := ((availableEdges H C M).card : ℝ)
  let status := certificateTestStatusHi D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N k
  have ha : 0 < a := by
    dsimp only [a]
    exact_mod_cast Finset.card_pos.mpr ⟨f, hf⟩
  have hfive : 5 * status ≤ a := by
    dsimp only [status, a]
    exact certificateTestStatusHi_le_availableEdges_fifth E S hN R havailable
  have hratio : status / a ≤ (1 / 5 : ℝ) := by
    apply (div_le_iff₀ ha).2
    nlinarith
  have hp := persistentInternalConflictLinkProbability_bounds_of_blockers
    H C M hf (statusLo := 0) (statusHi := status)
      (Nat.cast_nonneg _) (by simpa only [status] using hstatus)
  nlinarith [hp.1]

/-- The sharp unconditional mean window before the envelope reserve is
spent on the ordinary test corridor.  This is the full-mean input required
by the centered killed-net transfer.  The two constants are exactly
`(2000 + 1280 + 500 + 5000 + 1000) * 5/4 = 12225` and
`(2000 + 1280 + 500 + 5000 + 5000) * 5/4 = 17225`.

The conclusion is kept in numerator form so that either the external or
internal mean-combinatorics bridge can consume it directly. -/
theorem sharpCenteredMean_numeric_of_source_errors
    {h a W Z Zp Env Envp b eHi eLo gain loss zRate scale : ℝ}
    {s : ℕ}
    (hW : 0 ≤ W) (hh : 0 < h) (hscale : 0 ≤ scale)
    (haLower : (4 / 5 : ℝ) * h ≤ a)
    (hrate : h * zRate =
      ((s + 1 : ℕ) : ℝ) * Zp - (s : ℝ) * b * Z)
    (hmismatch : |(a - h) * zRate| ≤ 2000 * h * scale)
    (hnext : ((s + 1 : ℕ) : ℝ) * Envp ≤ 1280 * h * scale)
    (hcurrent : (s : ℝ) * b * Env ≤ 500 * h * scale)
    (hstatusHi : (s : ℝ) * eHi * (Z + Env) ≤ 5000 * h * scale)
    (hstatusLo : (s : ℝ) * eLo * (Z - Env) ≤ 5000 * h * scale)
    (hgain : gain ≤ 1000 * h * scale)
    (hloss : loss ≤ 5000 * h * scale) :
    (W * (zRate - 12225 * scale)) * a ≤
        ((s + 1 : ℕ) : ℝ) * (W * (Zp - Envp)) - W * gain -
          (s : ℝ) * (b + eHi) * (W * (Z + Env)) ∧
      ((s + 1 : ℕ) : ℝ) * (W * (Zp + Envp)) -
          ((s : ℝ) * (b - eLo) * (W * (Z - Env)) - W * loss) ≤
        (W * (zRate + 17225 * scale)) * a := by
  have hhscale0 : 0 ≤ h * scale := mul_nonneg hh.le hscale
  have hmisUpper : (a - h) * zRate ≤ 2000 * h * scale :=
    (le_abs_self _).trans hmismatch
  have hmisLower : -(2000 * h * scale) ≤ (a - h) * zRate :=
    neg_le_of_abs_le hmismatch
  have hzLower : a * zRate - 2000 * h * scale ≤ h * zRate := by
    nlinarith
  have hzUpper : h * zRate ≤ a * zRate + 2000 * h * scale := by
    nlinarith
  have hhandshakeLower : 9780 * h * scale ≤
      12225 * a * scale := by
    have hm := mul_le_mul_of_nonneg_right haLower hscale
    nlinarith
  have hhandshakeUpper : 13780 * h * scale ≤
      17225 * a * scale := by
    have hm := mul_le_mul_of_nonneg_right haLower hscale
    nlinarith
  have hlowerCore : a * zRate - 9780 * h * scale ≤
      ((s + 1 : ℕ) : ℝ) * (Zp - Envp) - gain -
        (s : ℝ) * (b + eHi) * (Z + Env) := by
    calc
      a * zRate - 9780 * h * scale ≤
          h * zRate - 7780 * h * scale := by linarith
      _ = ((s + 1 : ℕ) : ℝ) * (Zp - Envp) - gain -
          (s : ℝ) * (b + eHi) * (Z + Env) -
          (((1280 + 500 + 5000 + 1000 : ℝ) * h * scale) -
            (((s + 1 : ℕ) : ℝ) * Envp +
              (s : ℝ) * b * Env +
              (s : ℝ) * eHi * (Z + Env) + gain)) := by
        rw [hrate]
        ring
      _ ≤ ((s + 1 : ℕ) : ℝ) * (Zp - Envp) - gain -
          (s : ℝ) * (b + eHi) * (Z + Env) := by
        have herr : ((s + 1 : ℕ) : ℝ) * Envp +
            (s : ℝ) * b * Env +
            (s : ℝ) * eHi * (Z + Env) + gain ≤
              (1280 + 500 + 5000 + 1000 : ℝ) * h * scale := by
          linarith
        linarith
  have hupperCore :
      ((s + 1 : ℕ) : ℝ) * (Zp + Envp) -
          ((s : ℝ) * (b - eLo) * (Z - Env) - loss) ≤
        a * zRate + 13780 * h * scale := by
    calc
      ((s + 1 : ℕ) : ℝ) * (Zp + Envp) -
            ((s : ℝ) * (b - eLo) * (Z - Env) - loss) =
          h * zRate + ((s + 1 : ℕ) : ℝ) * Envp +
            (s : ℝ) * b * Env +
            (s : ℝ) * eLo * (Z - Env) + loss := by
        rw [hrate]
        ring
      _ ≤ h * zRate + 11780 * h * scale := by linarith
      _ ≤ a * zRate + 13780 * h * scale := by linarith
  constructor
  · have htarget : a * (zRate - 12225 * scale) ≤
        a * zRate - 9780 * h * scale := by
      nlinarith
    have hcore := htarget.trans hlowerCore
    have hmul := mul_le_mul_of_nonneg_left hcore hW
    calc
      (W * (zRate - 12225 * scale)) * a =
          W * (a * (zRate - 12225 * scale)) := by ring
      _ ≤ W * (((s + 1 : ℕ) : ℝ) * (Zp - Envp) - gain -
          (s : ℝ) * (b + eHi) * (Z + Env)) := hmul
      _ = ((s + 1 : ℕ) : ℝ) * (W * (Zp - Envp)) - W * gain -
          (s : ℝ) * (b + eHi) * (W * (Z + Env)) := by ring
  · have htarget : a * zRate + 13780 * h * scale ≤
        a * (zRate + 17225 * scale) := by
      nlinarith
    have hcore := hupperCore.trans htarget
    have hmul := mul_le_mul_of_nonneg_left hcore hW
    calc
      ((s + 1 : ℕ) : ℝ) * (W * (Zp + Envp)) -
          ((s : ℝ) * (b - eLo) * (W * (Z - Env)) - W * loss) =
          W * (((s + 1 : ℕ) : ℝ) * (Zp + Envp) -
            ((s : ℝ) * (b - eLo) * (Z - Env) - loss)) := by ring
      _ ≤ W * (a * (zRate + 17225 * scale)) := hmul
      _ = (W * (zRate + 17225 * scale)) * a := by ring

/-- Exact two scalar inequalities consumed by the centered killed-net
transfer.  They deliberately do not assume the missing componentwise
Lemma 7.22 estimates: those estimates must construct the centered killed
interval separately.

Here `u = W * Gamma * zeta / (N*pV)`, `E = W*zetaRate`, and
`r = W*d^(s-j-epsilon)/N`.  The constants are the two sharp unconditional
errors after the `4/5` handshake conversion. -/
theorem centeredKilledNet_combined_reserves
    {p u E r fullLowerError fullUpperError : ℝ}
    (hu : 0 ≤ u)
    (hp : (4 / 5 : ℝ) ≤ p)
    (hfullLower : fullLowerError ≤ 12225 * u)
    (hfullUpper : fullUpperError ≤ 17225 * u)
    (henvelope : 76000 * u ≤ E)
    (hremainder : r ≤ u) :
    fullLowerError + (fullUpperError + p * E / 2) ≤
        p * (E - 2 * r) ∧
      fullUpperError + (fullLowerError + p * E / 2) ≤
        p * (E - 2 * r) := by
  have hfull : fullLowerError + fullUpperError ≤ 29450 * u := by
    nlinarith
  have hgap : 37998 * u ≤ E / 2 - 2 * r := by
    nlinarith
  have hgap0 : 0 ≤ E / 2 - 2 * r := by
    exact (mul_nonneg (by norm_num) hu).trans hgap
  have hpGap : (4 / 5 : ℝ) * (E / 2 - 2 * r) ≤
      p * (E / 2 - 2 * r) :=
    mul_le_mul_of_nonneg_right hp hgap0
  have hconst : 29450 * u ≤
      (4 / 5 : ℝ) * (37998 * u) := by
    nlinarith
  have hscaledGap : (4 / 5 : ℝ) * (37998 * u) ≤
      (4 / 5 : ℝ) * (E / 2 - 2 * r) :=
    mul_le_mul_of_nonneg_left hgap (by norm_num)
  have hreserve : fullLowerError + fullUpperError ≤
      p * (E / 2 - 2 * r) :=
    hfull.trans (hconst.trans (hscaledGap.trans hpGap))
  constructor
  · calc
      fullLowerError + (fullUpperError + p * E / 2) =
          (fullLowerError + fullUpperError) + p * E / 2 := by ring
      _ ≤ p * (E / 2 - 2 * r) + p * E / 2 :=
        add_le_add_left hreserve _
      _ = p * (E - 2 * r) := by ring
  · calc
      fullUpperError + (fullLowerError + p * E / 2) =
          (fullLowerError + fullUpperError) + p * E / 2 := by ring
      _ ≤ p * (E / 2 - 2 * r) + p * E / 2 :=
        add_le_add_left hreserve _
      _ = p * (E - 2 * r) := by ring

end CFMSharpPersistentKilledNetNumeric

end

/-! ## Integrated: PersistentInternalComponentMeanFinalGood -/


open Finset Real CFMTrajectories

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! ## Centered full-minus-killed component transfer

The final internal-link source obtains its survivor mean by subtracting the
joint freeze-and-change term from the sharp unrestricted mean.  This lemma
is the exact algebraic junction: the source geometry only has to bound the
killed gain and killed loss errors, while the cutoff supplies the remaining
centered reserve.  In particular, neither killed component is treated as a
survivor mean estimate by itself. -/

theorem persistentInternalConflictLink_meanWindow_of_full_killed_caps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ)
    {center centerAbs survivalError killedGainError killedLossError
      u envelope remainder fullLowerError fullUpperError : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hfull : center - fullLowerError ≤
          meanPartialTestGain w H C j s M -
            meanPartialTestLoss w H C j s M ∧
        meanPartialTestGain w H C j s M -
            meanPartialTestLoss w H C j s M ≤
          center + fullUpperError)
    (hpUpper : persistentInternalConflictLinkProbability H C f M ≤ 1)
    (hdefect : 1 - persistentInternalConflictLinkProbability H C f M ≤
      survivalError)
    (hcenter : |center| ≤ centerAbs)
    (hkilledGain :
      meanKilledPartialTestGain w H C f j s M ≤ killedGainError)
    (hkilledLoss :
      meanKilledPartialTestLoss w H C f j s M ≤ killedLossError)
    (hkilledGainReserve :
      killedGainError + survivalError * centerAbs ≤
        fullUpperError +
          persistentInternalConflictLinkProbability H C f M * envelope / 2)
    (hkilledLossReserve :
      killedLossError + survivalError * centerAbs ≤
        fullLowerError +
          persistentInternalConflictLinkProbability H C f M * envelope / 2)
    (hu : 0 ≤ u)
    (hpLower : (4 / 5 : ℝ) ≤
      persistentInternalConflictLinkProbability H C f M)
    (hfullLower : fullLowerError ≤ 12225 * u)
    (hfullUpper : fullUpperError ≤ 17225 * u)
    (henvelope : 76000 * u ≤ envelope)
    (hremainder : remainder ≤ u) :
    persistentInternalConflictLinkProbability H C f M * center -
          persistentInternalConflictLinkProbability H C f M *
            (envelope - 2 * remainder) ≤
        meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ∧
      meanPersistentPartialTestGain w H C f j s M -
          meanPersistentPartialTestLoss w H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * center +
          persistentInternalConflictLinkProbability H C f M *
            (envelope - 2 * remainder) := by
  let p := persistentInternalConflictLinkProbability H C f M
  have hkilledRaw := killedPartialTestNet_window_of_caps
    w H C f j s M hw hpUpper hdefect hcenter hkilledGain hkilledLoss
  have hkilled :
      (1 - p) * center -
            (fullLowerError + p * envelope / 2) ≤
          meanKilledPartialTestGain w H C f j s M -
            meanKilledPartialTestLoss w H C f j s M ∧
        meanKilledPartialTestGain w H C f j s M -
            meanKilledPartialTestLoss w H C f j s M ≤
          (1 - p) * center +
            (fullUpperError + p * envelope / 2) := by
    dsimp only [p]
    constructor
    · exact le_trans (by linarith [hkilledLossReserve]) hkilledRaw.1
    · exact hkilledRaw.2.trans (by linarith [hkilledGainReserve])
  have htransfer := persistentPartialTest_meanWindow_of_killedNet
    w H C M hf j s hfull hkilled
  have hreserve :=
    CFMSharpPersistentKilledNetNumeric.centeredKilledNet_combined_reserves
      hu hpLower hfullLower hfullUpper henvelope hremainder
  dsimp only [p] at htransfer hreserve ⊢
  constructor
  · have hlowerReserve :
        persistentInternalConflictLinkProbability H C f M * center -
              persistentInternalConflictLinkProbability H C f M *
                (envelope - 2 * remainder) ≤
            persistentInternalConflictLinkProbability H C f M * center -
              (fullLowerError +
                (fullUpperError +
                  persistentInternalConflictLinkProbability H C f M *
                    envelope / 2)) := by
          linarith [hreserve.1]
    exact hlowerReserve.trans htransfer.1
  · exact htransfer.2.trans (by linarith [hreserve.2])

end

/-! ## Integrated: PersistentInternalConflictLinkKilledGain -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-! ## The killed-gain term of the persistent internal coordinate

For a conflict-link test rooted at `f₀`, a gained source member `Q` and a
choice `e ∈ Q` which deletes `f₀` give two distinct conflicts through
`{f₀,e}`: the source conflict and the conflict witnessing the deletion.
Thus the exact source family is the point-duplicate family `C_{f₀,2}`.
The availability-filtered gain-collision residual has a different
orientation (two available members of `Q`) and is not used here.
-/

/-- Gain choices for one test member which simultaneously delete the
distinguished internal source edge. -/
def killedPartialTestGainChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f₀ : Finset V) (j s : ℕ) (Q : Hypergraph V) : Hypergraph V :=
  (partialTestGainChoiceSet H C M j s Q).filter fun e ↦
    f₀ ∉ availableEdges H C (insert e M)

noncomputable def weightedKilledPartialTestGainChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f₀ : Finset V) (j s : ℕ) : ℝ :=
  ∑ Q ∈ H.powersetCard j,
    w Q * (killedPartialTestGainChoiceSet H C M f₀ j s Q).card

theorem sum_killedPartialTestStepGain_eq_weightedChoiceCount
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f₀ : Finset V) (j s : ℕ) :
    ∑ e ∈ killedInternalConflictLinkChoices H C M f₀,
        partialTestStepGain w H C j s M e =
      weightedKilledPartialTestGainChoices w H C M f₀ j s := by
  unfold partialTestStepGain partialTestGainBetween
    weightedKilledPartialTestGainChoices killedPartialTestGainChoiceSet
    killedInternalConflictLinkChoices partialTestGainChoiceSet
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro Q hQ
  rw [Finset.filter_filter]
  calc
    (∑ e ∈ (availableEdges H C M).filter (fun e ↦
          f₀ ∉ availableEdges H C (insert e M)),
        if ¬partialTestCondition (availableEdges H C M) M j s Q ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s Q then w Q else 0) =
        ∑ e ∈ (availableEdges H C M).filter (fun e ↦
          (¬partialTestCondition (availableEdges H C M) M j s Q ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s Q) ∧
          f₀ ∉ availableEdges H C (insert e M)), w Q := by
      rw [Finset.sum_filter, Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro e he
      by_cases hkill : f₀ ∉ availableEdges H C (insert e M) <;>
        by_cases hstep :
          ¬partialTestCondition (availableEdges H C M) M j s Q ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s Q <;>
        simp [hkill, hstep]
    _ = w Q * ((availableEdges H C M).filter (fun e ↦
          (¬partialTestCondition (availableEdges H C M) M j s Q ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s Q) ∧
          f₀ ∉ availableEdges H C (insert e M))).card := by
      simp [mul_comm]

theorem meanKilledPartialTestGain_eq_weightedChoiceCount_div
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f₀ : Finset V}
    (hf₀ : f₀ ∈ availableEdges H C M) (j s : ℕ) :
    meanKilledPartialTestGain w H C f₀ j s M =
      weightedKilledPartialTestGainChoices w H C M f₀ j s /
        ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp ⟨f₀, hf₀⟩
  simp only [meanKilledPartialTestGain, hAne, if_false]
  rw [sum_killedPartialTestStepGain_eq_weightedChoiceCount]

/-- Source links which have at least one gain choice deleting the root.
Only the current-state source coordinate and blocker relation are retained;
this is the finite family charged to `C_{f₀,2}`. -/
def killedGainConflictLinkSources
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f₀ : Finset V) (q s : ℕ) : ConflictSystem V :=
  (partialFamily (conflictLinkLayer C f₀ q)
      (availableEdges H C M) M (s + 1)).filter fun Q ↦
    ∃ e ∈ Q ∩ availableEdges H C M,
      e ∈ availableBlockerChoices H C M f₀

theorem weightedKilledConflictLinkGainChoices_le_sourceCard
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f₀ : Finset V} (hC : IsConflictSystem H C)
    (hf₀ : f₀ ∈ availableEdges H C M)
    (q s : ℕ) :
    weightedKilledPartialTestGainChoices
        (conflictLinkTestWeight C f₀ q) H C M f₀ q s ≤
      ((s + 1) * (killedGainConflictLinkSources H C M f₀ q s).card : ℕ) := by
  unfold weightedKilledPartialTestGainChoices
  let K := killedGainConflictLinkSources H C M f₀ q s
  calc
    (∑ Q ∈ H.powersetCard q,
        conflictLinkTestWeight C f₀ q Q *
          (killedPartialTestGainChoiceSet H C M f₀ q s Q).card) ≤
      ∑ Q ∈ H.powersetCard q,
        if Q ∈ K then ((s + 1 : ℕ) : ℝ) else 0 := by
      apply Finset.sum_le_sum
      intro Q hQ
      by_cases hlink : Q ∈ conflictLinkLayer C f₀ q
      · by_cases hchoices :
            (killedPartialTestGainChoiceSet H C M f₀ q s Q).Nonempty
        · obtain ⟨e, he⟩ := hchoices
          have he' := Finset.mem_filter.mp he
          have hsource :=
            partialTestGainChoice_mem_source_succ H C M q s Q hQ he'.1
          have heSA : e ∈ Q ∩ availableEdges H C M := hsource.2
          have heA : e ∈ availableEdges H C M :=
            Finset.inter_subset_right heSA
          have hef : e ∈ availableBlockerChoices H C M f₀ := by
            have heBlockF : f₀ ∈ availableBlockerChoices H C M e := by
              rw [availableEdges_insert_eq_sdiff_blockers] at he'
              simpa only [Finset.mem_sdiff, hf₀, true_and, not_not]
                using he'.2
            exact (mem_availableBlockerChoices_comm H C M heA hf₀).mp
              heBlockF
          have hQK : Q ∈ K := by
            rw [show K = killedGainConflictLinkSources H C M f₀ q s by rfl,
              killedGainConflictLinkSources, Finset.mem_filter]
            refine ⟨mem_partialFamily.mpr ⟨hlink, hsource.1.1,
              ?_⟩, e, heSA, hef⟩
            simpa [(Finset.mem_powersetCard.mp hQ).2] using hsource.1.2
          have hcard := partialTestGainChoiceSet_card_le_source_succ
            H C M q s Q hQ
          have hsub : killedPartialTestGainChoiceSet H C M f₀ q s Q ⊆
              partialTestGainChoiceSet H C M q s Q :=
            Finset.filter_subset _ _
          have hle :
              (killedPartialTestGainChoiceSet H C M f₀ q s Q).card ≤
                s + 1 := by
            apply (Finset.card_le_card hsub).trans
            simpa [hsource.1] using hcard
          simp only [conflictLinkTestWeight_apply, ite_mul, one_mul, zero_mul, Nat.cast_add, Nat.cast_one, ge_iff_le]
          exact_mod_cast hle
        · have hempty :
              killedPartialTestGainChoiceSet H C M f₀ q s Q = ∅ :=
            Finset.not_nonempty_iff_eq_empty.mp hchoices
          simp only [conflictLinkTestWeight_apply, ite_mul, one_mul, zero_mul, Nat.cast_add, Nat.cast_one, ge_iff_le]
          split <;> positivity
      · simp only [conflictLinkTestWeight_apply, ite_mul, one_mul, zero_mul, Nat.cast_add, Nat.cast_one]
        split <;> positivity
    _ = ((s + 1 : ℕ) : ℝ) * K.card := by
      rw [← Finset.sum_filter]
      have hKsub : K ⊆ H.powersetCard q := by
        intro Q hQ
        have hQlink := (mem_partialFamily.mp
          (Finset.mem_filter.mp hQ).1).1
        exact Finset.mem_powersetCard.mpr
          ⟨conflictLinkLayer_subset_host hC f₀ q Q hQlink,
            (mem_conflictLinkLayer.mp hQlink).2⟩
      have hfilter : (H.powersetCard q).filter (fun Q ↦ Q ∈ K) = K := by
        ext Q
        simp only [Finset.mem_filter]
        exact and_iff_right_of_imp (fun h ↦ hKsub h)
      rw [hfilter]
      simp
      ring
    _ = _ := by push_cast; ring

/-- Any partial member is covered by its available and selected sections.
This all-rank variant is used below for the `s+1` duplicate coordinate. -/
theorem partialFamily_subset_available_union_selected
    {X : ConflictSystem V} {A M : Hypergraph V} {Q : Hypergraph V}
    {t : ℕ} (hAM : Disjoint A M) (hQ : Q ∈ partialFamily X A M t) :
    Q ⊆ A ∪ M := by
  have hQA : (Q ∩ A).card = t := (mem_partialFamily.mp hQ).2.1
  have hQM : (Q ∩ M).card = Q.card - t :=
    (mem_partialFamily.mp hQ).2.2
  have htQ : t ≤ Q.card := by
    rw [← hQA]
    exact Finset.card_le_card Finset.inter_subset_left
  have hdisj : Disjoint (Q ∩ A) (Q ∩ M) :=
    hAM.mono Finset.inter_subset_right Finset.inter_subset_right
  have hsubQ : (Q ∩ A) ∪ (Q ∩ M) ⊆ Q :=
    Finset.union_subset Finset.inter_subset_left Finset.inter_subset_left
  have hcardUnion : ((Q ∩ A) ∪ (Q ∩ M)).card = Q.card := by
    rw [Finset.card_union_of_disjoint hdisj, hQA, hQM]
    omega
  have heq : (Q ∩ A) ∪ (Q ∩ M) = Q :=
    Finset.eq_of_subset_of_card_le hsubQ (by omega)
  intro e heQ
  rw [← heq] at heQ
  rcases Finset.mem_union.mp heQ with heA | heM
  · exact Finset.mem_union.mpr
      (Or.inl (Finset.inter_subset_right heA))
  · exact Finset.mem_union.mpr
      (Or.inr (Finset.inter_subset_right heM))

/-- Every killed-gain source link is a subset of a point-duplicate member
in the same `s+1` partial coordinate. -/
theorem killedGainConflictLinkSources_subset_duplicatePartialPowersets
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f₀ : Finset V} {q s : ℕ}
    (hf₀ : f₀ ∈ availableEdges H C M) (hs1 : 1 ≤ s)
    (hf₀ne : f₀.Nonempty)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    killedGainConflictLinkSources H C M f₀ q s ⊆
      (Finset.Icc (s + 2) 5).biUnion fun r ↦
        (partialFamily (duplicateConflictLinkUnionLayer C f₀ r)
          (availableEdges H C M) M (s + 1)).biUnion Finset.powerset := by
  let A := availableEdges H C M
  intro Q hQ
  have hQ' := Finset.mem_filter.mp hQ
  have hQpartial := hQ'.1
  have hQlink := (mem_partialFamily.mp hQpartial).1
  obtain ⟨e, heQA, heBlock⟩ := hQ'.2
  have heQ : e ∈ Q := Finset.inter_subset_left heQA
  have heA : e ∈ A := Finset.inter_subset_right heQA
  obtain ⟨⟨c₀, hc₀C, hf₀c₀, hc₀erase⟩, _hQcard⟩ :=
    mem_conflictLinkLayer.mp hQlink
  have hec₀ : e ∈ c₀ := by
    have : e ∈ c₀.erase f₀ := by rw [hc₀erase]; exact heQ
    exact (Finset.mem_erase.mp this).2
  have hef₀ : e ≠ f₀ := by
    have : e ∈ c₀.erase f₀ := by rw [hc₀erase]; exact heQ
    exact (Finset.mem_erase.mp this).1
  have hedisj : Disjoint e f₀ :=
    (hmatching c₀ hc₀C).2 hec₀ hf₀c₀ hef₀
  have heConflict :
      e ∈ conflictBlockerChoices C M A f₀ := by
    have hsplit := Finset.mem_union.mp
      (show e ∈
          CFMRegularization.availableMeetingChoices A f₀ ∪
            conflictBlockerChoices C M A f₀ by
        rw [← availableBlockerChoices_eq_meeting_union_conflict
          hf₀ hf₀ne]
        exact heBlock)
    rcases hsplit with hmeet | hconf
    · exact False.elim ((Finset.mem_filter.mp hmeet).2 hedisj)
    · exact hconf
  obtain ⟨c, hcC, hcsub, hf₀c, hec, hef₀'⟩ :=
    ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices
      hf₀ heConflict
  let Q' : Hypergraph V := c.erase f₀
  let q' : ℕ := Q'.card
  have hQ'link : Q' ∈ conflictLinkLayer C f₀ q' := by
    exact mem_conflictLinkLayer.mpr ⟨⟨c, hcC, hf₀c, rfl⟩, rfl⟩
  have heQ' : e ∈ Q' := Finset.mem_erase.mpr ⟨hef₀', hec⟩
  have hq'1 : 1 ≤ q' := Finset.card_pos.mpr ⟨e, heQ'⟩
  have hq'3 : q' ≤ 3 := by
    have herase := Finset.card_erase_add_one hf₀c
    have hc4 := (hCcard c hcC).2
    dsimp only [q', Q']
    omega
  have hQ'all : Q' ∈ allNonemptyConflictLinks C f₀ :=
    mem_allNonemptyConflictLinks.mpr
      ⟨q', Finset.mem_Icc.mpr ⟨hq'1, hq'3⟩, hQ'link⟩
  have hQall : Q ∈ allNonemptyConflictLinks C f₀ := by
    have hq1 : 1 ≤ q := by
      have hpos : 0 < Q.card := by
        have hAcard := (mem_partialFamily.mp hQpartial).2.1
        have hposA : 0 < (Q ∩ A).card := by rw [hAcard]; omega
        exact lt_of_lt_of_le hposA
          (Finset.card_le_card Finset.inter_subset_left)
      rw [(mem_conflictLinkLayer.mp hQlink).2] at hpos
      omega
    have hq3 : q ≤ 3 := by
      obtain ⟨⟨cQ, hcQC, hfQ, hQerase⟩, hQcard⟩ :=
        mem_conflictLinkLayer.mp hQlink
      have herase := Finset.card_erase_add_one hfQ
      have hc4 := (hCcard cQ hcQC).2
      rw [hQerase, hQcard] at herase
      omega
    exact mem_allNonemptyConflictLinks.mpr
      ⟨q, Finset.mem_Icc.mpr ⟨hq1, hq3⟩, hQlink⟩
  have hQ'sub : Q' ⊆ insert e M := by
    intro x hx
    have hx' := Finset.mem_erase.mp hx
    rcases Finset.mem_insert.mp (hcsub hx'.2) with hxf₀ | hxrest
    · exact False.elim (hx'.1 hxf₀)
    · exact hxrest
  have hAM : Disjoint A M := availableEdges_disjoint_selected H C M
  have hQ'A : Q' ∩ A = {e} := by
    ext x
    constructor
    · intro hx
      have hxQ' := Finset.inter_subset_left hx
      have hxA := Finset.inter_subset_right hx
      rcases Finset.mem_insert.mp (hQ'sub hxQ') with hxe | hxM
      · simpa [hxe]
      · exact False.elim (Finset.disjoint_left.mp hAM hxA hxM)
    · intro hx
      have hxe : x = e := Finset.mem_singleton.mp hx
      subst x
      exact Finset.mem_inter.mpr ⟨heQ', heA⟩
  have hQQ' : Q' ≠ Q := by
    intro heq
    have hcardA := (mem_partialFamily.mp hQpartial).2.1
    rw [← heq, hQ'A] at hcardA
    simp at hcardA
    omega
  have hnotdisj : ¬Disjoint Q Q' :=
    Finset.not_disjoint_iff.mpr ⟨e, heQ, heQ'⟩
  let p : ConflictSystem V := {Q, Q'}
  have hp : p ∈ duplicateConflictLinkPairs C f₀ := by
    apply mem_duplicateConflictLinkPairs.mpr
    refine ⟨?_, ?_, Q, by simp [p], Q', by simp [p], hQQ'.symm,
      hnotdisj⟩
    · intro R hR
      simp only [p, Finset.mem_insert, Finset.mem_singleton] at hR
      rcases hR with rfl | rfl
      · exact hQall
      · exact hQ'all
    · exact Finset.card_pair hQQ'.symm
  let U := Q ∪ Q'
  have hUduplicate : U ∈ duplicateConflictLinkUnions C f₀ := by
    apply mem_duplicateConflictLinkUnions.mpr
    refine ⟨p, hp, ?_⟩
    simp [p, U]
  have heQsection : e ∈ Q ∩ A := heQA
  have hUA : U ∩ A = Q ∩ A := by
    change (Q ∪ Q') ∩ A = Q ∩ A
    rw [Finset.union_inter_distrib_right, hQ'A]
    exact Finset.union_eq_left.mpr (by simpa using heQsection)
  have hQcover := partialFamily_subset_available_union_selected hAM hQpartial
  have hQ'cover : Q' ⊆ A ∪ M := by
    intro x hx
    rcases Finset.mem_insert.mp (hQ'sub hx) with hxe | hxM
    · exact Finset.mem_union.mpr (Or.inl (hxe ▸ heA))
    · exact Finset.mem_union.mpr (Or.inr hxM)
  have hUcover : U ⊆ A ∪ M :=
    Finset.union_subset hQcover hQ'cover
  have hpartition : (U ∩ A) ∪ (U ∩ M) = U := by
    ext x
    simp only [Finset.mem_union, Finset.mem_inter]
    constructor
    · rintro (⟨hxU, _⟩ | ⟨hxU, _⟩) <;> exact hxU
    · intro hxU
      rcases Finset.mem_union.mp (hUcover hxU) with hxA | hxM
      · exact Or.inl ⟨hxU, hxA⟩
      · exact Or.inr ⟨hxU, hxM⟩
  have hdisjParts : Disjoint (U ∩ A) (U ∩ M) :=
    hAM.mono Finset.inter_subset_right Finset.inter_subset_right
  have hUcardParts : U.card = (U ∩ A).card + (U ∩ M).card := by
    rw [← Finset.card_union_of_disjoint hdisjParts, hpartition]
  have hUAcard : (U ∩ A).card = s + 1 := by
    rw [hUA]
    exact (mem_partialFamily.mp hQpartial).2.1
  have hQ'notSubQ : ¬Q' ⊆ Q :=
    allNonemptyConflictLinks_antichain hanti hQ'all hQall hQQ'
  obtain ⟨x, hxQ', hxQ⟩ := Finset.not_subset.mp hQ'notSubQ
  have hxM : x ∈ M := by
    rcases Finset.mem_insert.mp (hQ'sub hxQ') with hxe | hxM
    · exact False.elim (hxQ (hxe ▸ heQ))
    · exact hxM
  have hxUM : x ∈ U ∩ M :=
    Finset.mem_inter.mpr
      ⟨Finset.mem_union.mpr (Or.inr hxQ'), hxM⟩
  have hUMpos : 1 ≤ (U ∩ M).card := Finset.card_pos.mpr ⟨x, hxUM⟩
  have hUlower : s + 2 ≤ U.card := by omega
  have hUMcard : (U ∩ M).card = U.card - (s + 1) := by omega
  have hUpartial : U ∈ partialFamily
      (duplicateConflictLinkUnionLayer C f₀ U.card) A M (s + 1) := by
    exact mem_partialFamily.mpr
      ⟨mem_duplicateConflictLinkUnionLayer.mpr ⟨hUduplicate, rfl⟩,
        hUAcard, hUMcard⟩
  apply Finset.mem_biUnion.mpr
  refine ⟨U.card, Finset.mem_Icc.mpr
    ⟨hUlower,
      (duplicateConflictLinkUnions_card_between_three_five hanti
        hUduplicate).2⟩,
      ?_⟩
  apply Finset.mem_biUnion.mpr
  exact ⟨U, hUpartial, Finset.mem_powerset.mpr Finset.subset_union_left⟩

/-- Powerset encoding of the preceding charge.  The factor is at most
`4 · 2⁶ = 256`: at most four source choices and at most 64 subsets of a
rank-six duplicate union. -/
theorem weightedKilledConflictLinkGainChoices_le_duplicatePartial
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f₀ : Finset V} (hC : IsConflictSystem H C)
    (hf₀ : f₀ ∈ availableEdges H C M)
    (q s : ℕ) (hs1 : 1 ≤ s) (hq3 : q ≤ 3) (hsq : s ≤ q)
    (hf₀ne : f₀.Nonempty)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    weightedKilledPartialTestGainChoices
        (conflictLinkTestWeight C f₀ q) H C M f₀ q s ≤
      256 * ∑ r ∈ Finset.Icc (s + 2) 5,
        ((partialFamily (duplicateConflictLinkUnionLayer C f₀ r)
          (availableEdges H C M) M (s + 1)).card : ℝ) := by
  let K := killedGainConflictLinkSources H C M f₀ q s
  let G : ℕ → ConflictSystem V := fun r ↦
    partialFamily (duplicateConflictLinkUnionLayer C f₀ r)
      (availableEdges H C M) M (s + 1)
  have hsub : K ⊆ (Finset.Icc (s + 2) 5).biUnion fun r ↦
      (G r).biUnion Finset.powerset := by
    simpa only [K, G] using
      killedGainConflictLinkSources_subset_duplicatePartialPowersets
        hf₀ hs1 hf₀ne hmatching hCcard hanti
  have hinner (r : ℕ) (hr : r ∈ Finset.Icc (s + 2) 5) :
      ((G r).biUnion Finset.powerset).card ≤ 64 * (G r).card := by
    calc
      ((G r).biUnion Finset.powerset).card ≤
          ∑ U ∈ G r, U.powerset.card := Finset.card_biUnion_le
      _ ≤ ∑ _U ∈ G r, 64 := by
        apply Finset.sum_le_sum
        intro U hU
        have hUduplicate : U ∈ duplicateConflictLinkUnions C f₀ :=
          (mem_duplicateConflictLinkUnionLayer.mp
            (mem_partialFamily.mp hU).1).1
        have hUcard := duplicateConflictLinkUnions_card_le_six hUduplicate
        rw [Finset.card_powerset]
        interval_cases U.card <;> norm_num
      _ = 64 * (G r).card := by simp [Nat.mul_comm]
  have hKcard : K.card ≤
      64 * ∑ r ∈ Finset.Icc (s + 2) 5, (G r).card := by
    calc
      K.card ≤ ((Finset.Icc (s + 2) 5).biUnion fun r ↦
          (G r).biUnion Finset.powerset).card := Finset.card_le_card hsub
      _ ≤ ∑ r ∈ Finset.Icc (s + 2) 5,
          ((G r).biUnion Finset.powerset).card := Finset.card_biUnion_le
      _ ≤ ∑ r ∈ Finset.Icc (s + 2) 5, 64 * (G r).card := by
        apply Finset.sum_le_sum
        intro r hr
        exact hinner r hr
      _ = 64 * ∑ r ∈ Finset.Icc (s + 2) 5, (G r).card := by
        rw [Finset.mul_sum]
  have hsource := weightedKilledConflictLinkGainChoices_le_sourceCard
    hC hf₀ q s
  have hsq4 : s + 1 ≤ 4 := by omega
  have hnat : (s + 1) * K.card ≤
      256 * ∑ r ∈ Finset.Icc (s + 2) 5, (G r).card := by
    calc
      (s + 1) * K.card ≤ 4 * K.card :=
        Nat.mul_le_mul_right K.card hsq4
      _ ≤ 4 * (64 * ∑ r ∈ Finset.Icc (s + 2) 5, (G r).card) :=
        Nat.mul_le_mul_left 4 hKcard
      _ = 256 * ∑ r ∈ Finset.Icc (s + 2) 5, (G r).card := by ring
  calc
    weightedKilledPartialTestGainChoices
        (conflictLinkTestWeight C f₀ q) H C M f₀ q s ≤
      (((s + 1) * K.card : ℕ) : ℝ) := hsource
    _ ≤ ((256 * ∑ r ∈ Finset.Icc (s + 2) 5,
        (G r).card : ℕ) : ℝ) := by exact_mod_cast hnat
    _ = 256 * ∑ r ∈ Finset.Icc (s + 2) 5,
        ((partialFamily (duplicateConflictLinkUnionLayer C f₀ r)
          (availableEdges H C M) M (s + 1)).card : ℝ) := by
      push_cast
      rfl

theorem meanKilledConflictLinkGain_le_duplicatePartial
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f₀ : Finset V} (hC : IsConflictSystem H C)
    (hf₀ : f₀ ∈ availableEdges H C M)
    (q s : ℕ) (hs1 : 1 ≤ s) (hq3 : q ≤ 3) (hsq : s ≤ q)
    (hf₀ne : f₀.Nonempty)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c') :
    meanKilledPartialTestGain (conflictLinkTestWeight C f₀ q)
        H C f₀ q s M ≤
      (256 * ∑ r ∈ Finset.Icc (s + 2) 5,
        ((partialFamily (duplicateConflictLinkUnionLayer C f₀ r)
          (availableEdges H C M) M (s + 1)).card : ℝ)) /
        ((availableEdges H C M).card : ℝ) := by
  rw [meanKilledPartialTestGain_eq_weightedChoiceCount_div
    (conflictLinkTestWeight C f₀ q) H C M hf₀ q s]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  have hbound := weightedKilledConflictLinkGainChoices_le_duplicatePartial
    hC hf₀ q s hs1 hq3 hsq hf₀ne hmatching hCcard hanti
  simpa only [Nat.cast_sum] using hbound

theorem meanKilledConflictLinkGain_le_pointDuplicateMargins_of_combinedGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (D₂ D₃ D₄ GammaCore eta : ℝ) (N T : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ellCert)
    (hj1 : ∀ a, 1 ≤ j a) (hj3 : ∀ a, j a ≤ 3)
    (hH8 : IsUniform H 8)
    (hdegree : ∀ x, (degree H x : ℝ) ≤ d)
    (hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ellCert : ℝ) ≤
        Real.rpow d (epsRaw / 10))
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ))
    {k : ℕ} {M : Hypergraph V} (hk : k ≤ T)
    (hgood : indexedGreedyGood
      (combinedTestLocalEnhancedPredicate H C d epsRaw GammaCert ellCert
        D₂ D₃ D₄ GammaCore eta N T j w R) k M)
    (f₀ : Finset V) (hf₀A : f₀ ∈ availableEdges H R.regularized M)
    (q s : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hs1 : 1 ≤ s) (hsq : s ≤ q) :
    meanKilledPartialTestGain
        (conflictLinkTestWeight R.regularized f₀ q)
        H R.regularized f₀ q s M ≤
      (256 * ∑ r ∈ Finset.Icc (3 : ℕ) 5,
        2 * finiteWeightedRootShadowMargin eta d
          (2304 * (3 * GammaCert + 1) *
            Real.rpow d ((r : ℝ) - epsRaw / 4))
          0 (r - (s + 1))) /
        ((availableEdges H R.regularized M).card : ℝ) := by
  have hf₀H := availableEdges_subset H R.regularized M hf₀A
  have hf₀ne : f₀.Nonempty :=
    Finset.card_pos.mp (by rw [hH8 f₀ hf₀H]; norm_num)
  have hdet := meanKilledConflictLinkGain_le_duplicatePartial
    R.isConflictSystem hf₀A q s hs1 hq3 hsq hf₀ne R.conflictMatching
      (fun c hc ↦ R.bounded.conflict_card hc) R.antichain
  apply hdet.trans
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  calc
    (∑ r ∈ Finset.Icc (s + 2) 5,
        ((partialFamily
          (duplicateConflictLinkUnionLayer R.regularized f₀ r)
          (availableEdges H R.regularized M) M (s + 1)).card : ℝ)) ≤
      ∑ r ∈ Finset.Icc (s + 2) 5,
        2 * finiteWeightedRootShadowMargin eta d
          (2304 * (3 * GammaCert + 1) *
            Real.rpow d ((r : ℝ) - epsRaw / 4))
          0 (r - (s + 1)) := by
      apply Finset.sum_le_sum
      intro r hr
      have hrange := Finset.mem_Icc.mp hr
      exact internalPointDuplicatePartialCard_le_two_margin
        H C d epsRaw GammaCert ellCert D₂ D₃ D₄ GammaCore eta
        N T j w R E S hd heps hell hj1 hj3 hdegree hresidualCutoff
        hN hT hk hgood f₀ hf₀H r (s + 1)
        (by omega) hrange.2 (by omega) (by omega)
    _ ≤ ∑ r ∈ Finset.Icc (3 : ℕ) 5,
        2 * finiteWeightedRootShadowMargin eta d
          (2304 * (3 * GammaCert + 1) *
            Real.rpow d ((r : ℝ) - epsRaw / 4))
          0 (r - (s + 1)) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro r hr
        have hrange := Finset.mem_Icc.mp hr
        exact Finset.mem_Icc.mpr
          ⟨by omega, hrange.2⟩
      · intro r hr _hrnot
        have hGamma3 : 0 ≤ 3 * GammaCert :=
          regularizedBounded_Gamma_nonneg R.bounded
            (lt_of_lt_of_le zero_lt_one hd)
        have hd0 : 0 ≤ d := by linarith
        have hscale : 0 ≤ 2304 * (3 * GammaCert + 1) *
            Real.rpow d ((r : ℝ) - epsRaw / 4) :=
          mul_nonneg (mul_nonneg (by norm_num) (by linarith))
            (Real.rpow_nonneg hd0 _)
        have hstep : 0 ≤ Real.rpow d
            (-1 + CFMNumeric.coreEpsilon eta / 16) :=
          Real.rpow_nonneg hd0 _
        unfold finiteWeightedRootShadowMargin
          finiteWeightedRootShadowZeroScale
          finiteWeightedRootShadowStepFactor
        simp only [pow_zero, mul_one]
        exact mul_nonneg (by norm_num)
          (mul_nonneg hscale (pow_nonneg hstep _))

end

/-! ## Integrated: PersistentInternalConflictLinkDeactivation -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! ## Fixed-root joint deactivation (GJKKL Lemma 7.20)

For an internal conflict-link test the event that the test family itself
dies is exactly deletion of its distinguished root `f`.  The loss
correction is therefore the intersection of the loss-choice set of a test
with the blocker set of `f`. -/

noncomputable def weightedKilledPartialTestLossChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    w S * (((partialTestLossChoiceSet H C M j s S) ∩
      availableBlockerChoices H C M f).card : ℝ)

theorem sum_blockingRoot_partialTestStepLoss_eq_weightedKilledChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) :
    ∑ e ∈ availableBlockerChoices H C M f,
        partialTestStepLoss w H C j s M e =
      weightedKilledPartialTestLossChoices w H C M f j s := by
  unfold partialTestStepLoss partialTestLossBetween
    weightedKilledPartialTestLossChoices
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  let P : Finset V → Prop := fun e ↦
    partialTestCondition (availableEdges H C M) M j s S ∧
      ¬partialTestCondition (availableEdges H C (insert e M))
        (insert e M) j s S
  calc
    (∑ e ∈ availableBlockerChoices H C M f,
        if P e then w S else 0) =
        ∑ e ∈ (availableBlockerChoices H C M f).filter P, w S := by
          rw [Finset.sum_filter]
    _ = w S * ((availableBlockerChoices H C M f).filter P).card := by
      simp [mul_comm]
    _ = w S * (((partialTestLossChoiceSet H C M j s S) ∩
        availableBlockerChoices H C M f).card : ℝ) := by
      have hset : (availableBlockerChoices H C M f).filter P =
          partialTestLossChoiceSet H C M j s S ∩
            availableBlockerChoices H C M f := by
        ext e
        simp only [Finset.mem_filter, Finset.mem_inter]
        constructor
        · intro he
          exact ⟨Finset.mem_filter.mpr
            ⟨(Finset.mem_filter.mp he.1).1, he.2⟩, he.1⟩
        · intro he
          exact ⟨he.2, (Finset.mem_filter.mp he.1).2⟩
      rw [hset]

theorem meanKilledPartialTestLoss_eq_weightedKilledChoices_div
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) :
    meanKilledPartialTestLoss w H C f j s M =
      weightedKilledPartialTestLossChoices w H C M f j s /
        ((availableEdges H C M).card : ℝ) := by
  have hA : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp ⟨f, hf⟩
  simp only [meanKilledPartialTestLoss, hA, if_false,
    killedInternalConflictLinkChoices_eq_blockers H C M hf]
  rw [sum_blockingRoot_partialTestStepLoss_eq_weightedKilledChoices]

/-- The joint-deactivation multiplicity of one current test is bounded by
the sum of common-blocker multiplicities between the root and each current
available member. -/
theorem card_lossChoices_inter_rootBlockers_le_sum_commonBlockers
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) (j s : ℕ) (S : Hypergraph V)
    (hS : S ∈ H.powersetCard j) :
    ((partialTestLossChoiceSet H C M j s S) ∩
        availableBlockerChoices H C M f).card ≤
      ∑ g ∈ S ∩ availableEdges H C M,
        (availableBlockerChoices H C M f ∩
          availableBlockerChoices H C M g).card := by
  by_cases hold : partialTestCondition (availableEdges H C M) M j s S
  · rw [partialTestLossChoiceSet_eq_biUnion_availableBlockers
      H C M j s S hS hold]
    let F : Finset V → Hypergraph V := fun g ↦
      availableBlockerChoices H C M f ∩
        availableBlockerChoices H C M g
    have hsub :
        ((S ∩ availableEdges H C M).biUnion
            (availableBlockerChoices H C M) ∩
          availableBlockerChoices H C M f) ⊆
        (S ∩ availableEdges H C M).biUnion F := by
      intro e he
      have he' := Finset.mem_inter.mp he
      obtain ⟨g, hg, heg⟩ := Finset.mem_biUnion.mp he'.1
      exact Finset.mem_biUnion.mpr
        ⟨g, hg, Finset.mem_inter.mpr ⟨he'.2, heg⟩⟩
    calc
      _ ≤ ((S ∩ availableEdges H C M).biUnion F).card :=
        Finset.card_le_card hsub
      _ ≤ ∑ g ∈ S ∩ availableEdges H C M, (F g).card :=
        Finset.card_biUnion_le
      _ = _ := rfl
  · have hempty : partialTestLossChoiceSet H C M j s S = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro e he
      exact hold (Finset.mem_filter.mp he).2.1
    rw [hempty]
    simp

theorem weightedKilledPartialTestLossChoices_le_commonCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (f : Finset V) (j s : ℕ) (commonHi : ℕ)
    (hw : ∀ S, 0 ≤ w S)
    (hcommon : ∀ S ∈ H.powersetCard j,
      0 < w S →
      partialTestCondition (availableEdges H C M) M j s S →
      ∀ g ∈ S ∩ availableEdges H C M,
        (availableBlockerChoices H C M f ∩
          availableBlockerChoices H C M g).card ≤ commonHi) :
    weightedKilledPartialTestLossChoices w H C M f j s ≤
      (s * commonHi : ℕ) * partialTestObservable w H C j s M := by
  unfold weightedKilledPartialTestLossChoices partialTestObservable
    partialTestTotal
  rw [Finset.sum_filter, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro S hS
  by_cases hold : partialTestCondition (availableEdges H C M) M j s S
  · simp only [partialTestCondition] at hold
    simp only [hold, if_true]
    by_cases hpos : 0 < w S
    · have hcard := card_lossChoices_inter_rootBlockers_le_sum_commonBlockers
        H C M f j s S hS
      have hsum :
          ∑ g ∈ S ∩ availableEdges H C M,
              (availableBlockerChoices H C M f ∩
                availableBlockerChoices H C M g).card ≤
            ∑ _g ∈ S ∩ availableEdges H C M, commonHi :=
        Finset.sum_le_sum fun g hg ↦ hcommon S hS hpos hold g hg
      have hnat :
          ((partialTestLossChoiceSet H C M j s S) ∩
              availableBlockerChoices H C M f).card ≤ s * commonHi := by
        calc
          _ ≤ ∑ g ∈ S ∩ availableEdges H C M,
              (availableBlockerChoices H C M f ∩
                availableBlockerChoices H C M g).card := hcard
          _ ≤ ∑ _g ∈ S ∩ availableEdges H C M, commonHi := hsum
          _ = s * commonHi := by simp [hold.1]
      have hreal :
          ((((partialTestLossChoiceSet H C M j s S) ∩
              availableBlockerChoices H C M f).card : ℕ) : ℝ) ≤
            ((s * commonHi : ℕ) : ℝ) := by exact_mod_cast hnat
      simpa [hold, mul_comm] using
        mul_le_mul_of_nonneg_left hreal (hw S)
    · have hwzero : w S = 0 := le_antisymm (not_lt.mp hpos) (hw S)
      simp [hwzero]
  · simp only [partialTestCondition] at hold
    have hempty : partialTestLossChoiceSet H C M j s S = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro e he
      exact hold (Finset.mem_filter.mp he).2.1
    simp [hold, hempty]

theorem meanKilledPartialTestLoss_le_commonCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s commonHi : ℕ)
    (hw : ∀ S, 0 ≤ w S)
    (hcommon : ∀ S ∈ H.powersetCard j,
      0 < w S →
      partialTestCondition (availableEdges H C M) M j s S →
      ∀ g ∈ S ∩ availableEdges H C M,
        (availableBlockerChoices H C M f ∩
          availableBlockerChoices H C M g).card ≤ commonHi) :
    meanKilledPartialTestLoss w H C f j s M ≤
      ((s * commonHi : ℕ) : ℝ) *
        partialTestObservable w H C j s M /
          ((availableEdges H C M).card : ℝ) := by
  rw [meanKilledPartialTestLoss_eq_weightedKilledChoices_div
    w H C M hf j s]
  exact div_le_div_of_nonneg_right
    (weightedKilledPartialTestLossChoices_le_commonCap
      w H C M f j s commonHi hw hcommon) (Nat.cast_nonneg _)

/-! ## Rank-at-least-two conflict links

For a positive conflict-link test of rank at least two, the distinguished
edge and each current available member form a legal pair: they are distinct
and disjoint, and antichainness excludes a two-conflict between them.  This
is exactly the source split in Lemma 7.20 before the exceptional rank-one
case. -/

theorem conflictLink_member_legalPair_of_rank_ge_two
    {H : Hypergraph V} {C : ConflictSystem V}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    {f g : Finset V} {q : ℕ} {Q : Hypergraph V}
    (hq2 : 2 ≤ q) (hQ : Q ∈ conflictLinkLayer C f q) (hgQ : g ∈ Q) :
    g ≠ f ∧ Disjoint f g ∧ {f, g} ∉ conflictLayer C 2 := by
  obtain ⟨⟨c, hcC, hfc, hcErase⟩, hQcard⟩ :=
    mem_conflictLinkLayer.mp hQ
  have hgc : g ∈ c := by
    have hgerase : g ∈ c.erase f := by
      rw [hcErase]
      exact hgQ
    exact (Finset.mem_erase.mp hgerase).2
  have hgf : g ≠ f := by
    intro hgf
    subst g
    exact distinguished_not_mem_conflictLinkLayer hQ hgQ
  have hfg : Disjoint f g :=
    (hmatching c hcC).2 hfc hgc hgf.symm
  have hcCard : c.card = q + 1 := by
    have herase := Finset.card_erase_add_one hfc
    rw [hcErase, hQcard] at herase
    omega
  have hpair : {f, g} ∉ conflictLayer C 2 := by
    intro hp
    have hpC : ({f, g} : Hypergraph V) ∈ C := (Finset.mem_filter.mp hp).1
    have hpCard : ({f, g} : Hypergraph V).card = 2 :=
      (Finset.mem_filter.mp hp).2
    have hpne : ({f, g} : Hypergraph V) ≠ c := by
      intro heq
      rw [heq, hcCard] at hpCard
      omega
    apply hanti {f, g} hpC c hcC hpne
    intro x hx
    rcases Finset.mem_insert.mp hx with rfl | hx
    · exact hfc
    · have hxg : x = g := Finset.mem_singleton.mp hx
      subst x
      exact hgc
  exact ⟨hgf, hfg, hpair⟩

/-- The four blocker geometries for one legal pair, with the constants
specialised to the 8-uniform host. -/
theorem card_inter_availableBlockerChoices_le_legalPairCaps
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f g : Finset V} (hf : f ∈ availableEdges H C M)
    (hg : g ∈ availableEdges H C M) (hgf : g ≠ f)
    (hfg : Disjoint f g) (hpair : {f, g} ∉ conflictLayer C 2)
    (codegreeHi mixedHi rerootHi : ℕ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ e ∈ availableEdges H C M,
      ∀ e' ∈ availableEdges H C M, Disjoint e e' → ∀ v ∈ e',
        CFMRegularization.conditionC4Count H C e v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M e 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M e 3 1 v).card ≤ mixedHi)
    (hreroot : ∀ e ∈ availableEdges H C M,
      ∀ e' ∈ availableEdges H C M, e' ≠ e → Disjoint e e' →
        {e, e'} ∉ conflictLayer C 2 →
        (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C e q') C e' r)
            (availableEdges H C M) M 1).card) ≤ rerootHi) :
    (availableBlockerChoices H C M f ∩
        availableBlockerChoices H C M g).card ≤
      64 * codegreeHi + 16 * mixedHi + rerootHi := by
  have hfH : f ∈ H := availableEdges_subset H C M hf
  have hgH : g ∈ H := availableEdges_subset H C M hg
  have hfne : f.Nonempty := Finset.card_pos.mp (by rw [hH8 f hfH]; norm_num)
  have hgne : g.Nonempty := Finset.card_pos.mp (by rw [hH8 g hgH]; norm_num)
  have hsplit := card_inter_availableBlockers_le_MM_MC_CM_CC
    hf hfne hg hgne
  have hmm : blockerPairMM H C M f g ≤ 64 * codegreeHi := by
    have h := card_inter_availableMeetingChoices_le_card_mul_card_mul
      (availableEdges H C M) hfg hcodegree
    simpa [blockerPairMM, hH8 f hfH, hH8 g hgH, Nat.mul_assoc] using h
  have hmc : blockerPairMC H C M f g ≤ 8 * mixedHi := by
    have h := card_inter_meeting_conflictBlockers_le_C4_add_local
      hCcard f hg
    calc
      blockerPairMC H C M f g ≤
          ∑ v ∈ f,
            (CFMRegularization.conditionC4Count H C g v +
              (localConflictLinkPartialAtVertex C
                (availableEdges H C M) M g 2 1 v).card +
              (localConflictLinkPartialAtVertex C
                (availableEdges H C M) M g 3 1 v).card) := by
            simpa only [blockerPairMC] using h
      _ ≤ ∑ _v ∈ f, mixedHi := by
        apply Finset.sum_le_sum
        intro v hv
        exact hmixed g hg f hf hfg.symm v hv
      _ = 8 * mixedHi := by simp [hH8 f hfH]
  have hcm : blockerPairCM H C M f g ≤ 8 * mixedHi := by
    have h := card_inter_meeting_conflictBlockers_le_C4_add_local
      hCcard g hf
    calc
      blockerPairCM H C M f g ≤
          ∑ v ∈ g,
            (CFMRegularization.conditionC4Count H C f v +
              (localConflictLinkPartialAtVertex C
                (availableEdges H C M) M f 2 1 v).card +
              (localConflictLinkPartialAtVertex C
                (availableEdges H C M) M f 3 1 v).card) := by
            simpa only [blockerPairCM, Finset.inter_comm] using h
      _ ≤ ∑ _v ∈ g, mixedHi := by
        apply Finset.sum_le_sum
        intro v hv
        exact hmixed f hf g hg hfg v hv
      _ = 8 * mixedHi := by simp [hH8 g hgH]
  have hcc : blockerPairCC H C M f g ≤ rerootHi :=
    (blockerPairCC_le_rerootedPartialMass hCcard hf hg).trans
      (hreroot f hf g hg hgf hfg hpair)
  omega

/-- Lemma 7.19/7.20 killed-loss aggregate for conflict-link ranks at least
two.  The only dynamic inputs are the already registered legal-pair caps. -/
theorem meanKilledPartialTestLoss_conflictLink_rank_ge_two_le_legalPairCap
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {f : Finset V} (hf : f ∈ availableEdges H C M)
    (q s codegreeHi mixedHi rerootHi : ℕ) (hq2 : 2 ≤ q)
    (hH8 : IsUniform H 8)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hanti : ∀ c ∈ C, ∀ c' ∈ C, c ≠ c' → ¬c ⊆ c')
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ e ∈ availableEdges H C M,
      ∀ e' ∈ availableEdges H C M, Disjoint e e' → ∀ v ∈ e',
        CFMRegularization.conditionC4Count H C e v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M e 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M e 3 1 v).card ≤ mixedHi)
    (hreroot : ∀ e ∈ availableEdges H C M,
      ∀ e' ∈ availableEdges H C M, e' ≠ e → Disjoint e e' →
        {e, e'} ∉ conflictLayer C 2 →
        (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C e q') C e' r)
            (availableEdges H C M) M 1).card) ≤ rerootHi) :
    meanKilledPartialTestLoss (conflictLinkTestWeight C f q)
        H C f q s M ≤
      (((s * (64 * codegreeHi + 16 * mixedHi + rerootHi) : ℕ) : ℝ) *
        partialTestObservable (conflictLinkTestWeight C f q)
          H C q s M) /
        ((availableEdges H C M).card : ℝ) := by
  apply meanKilledPartialTestLoss_le_commonCap
    (conflictLinkTestWeight C f q) H C M hf q s
      (64 * codegreeHi + 16 * mixedHi + rerootHi)
      (conflictLinkTestWeight_nonneg_sharp C f q)
  intro Q hQpowerset hQpos hcoord g hg
  have hQlink : Q ∈ conflictLinkLayer C f q :=
    conflictLinkTestWeight_pos_iff_sharp.mp hQpos
  have hgQ : g ∈ Q := Finset.inter_subset_left hg
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  obtain ⟨hgf, hfg, hpair⟩ :=
    conflictLink_member_legalPair_of_rank_ge_two
      hmatching hanti hq2 hQlink hgQ
  exact card_inter_availableBlockerChoices_le_legalPairCaps
    H C M hf hgA hgf hfg hpair codegreeHi mixedHi rerootHi
      hH8 hcodegree hCcard hmixed hreroot

end

/-! ## Integrated: PersistentInternalConflictLinkRankOneDeactivation -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-! ## The exceptional rank-one deactivation coordinate

Fix the frozen source edge `e` and the chosen common blocker `g`.  The
victims below are the currently available one-link neighbours of `e` which
are conflict-blocked by `g`.  This is the orientation used in GJKKL Lemma
7.20: the *test member*, rather than the chosen blocker, is the unique open
member of the `C*_{e,g,2}` semiconflict. -/

def rankOneKilledConflictVictims
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (e g : Finset V) : Hypergraph V :=
  (((partialFamily (conflictLinkLayer C e 1)
      (availableEdges H C M) M 1).biUnion id).filter fun f ↦
    f ∈ availableEdges H C M ∧
      g ∈ conflictBlockerChoices C M (availableEdges H C M) f)

/-- Every rank-one CC victim is either an immediate common link of the
source and the chosen blocker, or the unique open member of a rank-two or
rank-three `C*` link rooted at the chosen blocker. -/
theorem rankOneKilledConflictVictims_subset_immediate_union_CStar
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (e g : Finset V) :
    rankOneKilledConflictVictims H C M e g ⊆
      ((conflictLinkLayer C e 1 ∩ conflictLinkLayer C g 1).biUnion id) ∪
        (Finset.Icc 2 3).biUnion fun r ↦
          (((partialFamily (commonImmediateEvictorLinkLayer C e g r)
            (availableEdges H C M) M 1).biUnion id).filter fun f ↦
              f ∈ availableEdges H C M) := by
  intro f hf
  have hf' := Finset.mem_filter.mp hf
  obtain ⟨Q, hQpartial, hfQ⟩ := Finset.mem_biUnion.mp hf'.1
  have hQsource := (mem_partialFamily.mp hQpartial).1
  have hQcard : Q.card = 1 := (mem_conflictLinkLayer.mp hQsource).2
  have hsingleQ : ({f} : Hypergraph V) = Q := by
    apply Finset.eq_of_subset_of_card_le
    · simp [show f ∈ Q by simpa only [id_eq] using hfQ]
    · rw [hQcard]
      simp
  have hefLink : ({f} : Hypergraph V) ∈ conflictLinkLayer C e 1 := by
    rw [hsingleQ]
    exact hQsource
  have hfA : f ∈ availableEdges H C M := hf'.2.1
  have hgBlock :
      g ∈ conflictBlockerChoices C M (availableEdges H C M) f :=
    hf'.2.2
  obtain ⟨c, hcC, hcsub, hfc, hgc, hgf⟩ :=
    ccReroot_exists_conflict_witness_of_mem_conflictBlockerChoices
      hfA hgBlock
  let R : Hypergraph V := c.erase g
  let r : ℕ := R.card
  have hRlink : R ∈ conflictLinkLayer C g r := by
    exact mem_conflictLinkLayer.mpr ⟨⟨c, hcC, hgc, rfl⟩, rfl⟩
  have hfR : f ∈ R := by
    exact Finset.mem_erase.mpr ⟨hgf.symm, hfc⟩
  have hRsub : R ⊆ insert f M := by
    intro x hx
    have hx' := Finset.mem_erase.mp hx
    rcases Finset.mem_insert.mp (hcsub hx'.2) with hxf | hxrest
    · exact Finset.mem_insert.mpr (Or.inl hxf)
    · rcases Finset.mem_insert.mp hxrest with hxg | hxM
      · exact False.elim (hx'.1 hxg)
      · exact Finset.mem_insert_of_mem hxM
  have hgA : g ∈ availableEdges H C M :=
    (Finset.mem_filter.mp hgBlock).1
  have hAM : Disjoint (availableEdges H C M) M :=
    availableEdges_disjoint_selected H C M
  have hr1 : 1 ≤ r := Finset.card_pos.mpr ⟨f, hfR⟩
  have hr3 : r ≤ 3 := by
    have herase := Finset.card_erase_add_one hgc
    have hc4 := (hCcard c hcC).2
    dsimp only [r, R]
    omega
  by_cases hr : r = 1
  · apply Finset.mem_union.mpr
    apply Or.inl
    have hsingleR : ({f} : Hypergraph V) = R := by
      apply Finset.eq_of_subset_of_card_le
      · simp [hfR]
      · rw [show R.card = 1 by simpa only [r] using hr]
        simp
    apply Finset.mem_biUnion.mpr
    refine ⟨{f}, Finset.mem_inter.mpr ⟨hefLink, ?_⟩, by simp⟩
    rw [hsingleR]
    simpa only [r, hr] using hRlink
  · have hr2 : 2 ≤ r := by omega
    have hRcommon : R ∈ commonImmediateEvictorLinkLayer C e g r := by
      apply mem_commonImmediateEvictorLinkLayer.mpr
      refine ⟨mem_commonImmediateEvictorLinkFamily.mpr ⟨?_, hr2,
        f, hfR, hefLink⟩, rfl⟩
      exact mem_conflictLink.mpr ⟨c, hcC, hgc, rfl⟩
    have hRpartial : R ∈ partialFamily
        (commonImmediateEvictorLinkLayer C e g r)
        (availableEdges H C M) M 1 :=
      mem_partialFamily_one_of_subset_insert
        hRcommon hRsub hfR hfA hAM
    apply Finset.mem_union.mpr
    apply Or.inr
    apply Finset.mem_biUnion.mpr
    refine ⟨r, Finset.mem_Icc.mpr ⟨hr2, hr3⟩, ?_⟩
    apply Finset.mem_filter.mpr
    exact ⟨Finset.mem_biUnion.mpr ⟨R, hRpartial, hfR⟩, hfA⟩

/-- Cardinal form of the preceding classifier.  Filtering the union of a
one-open partial family back to available edges removes representation
multiplicity without paying the link rank. -/
theorem card_rankOneKilledConflictVictims_le_immediate_add_CStar
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (e g : Finset V) :
    (rankOneKilledConflictVictims H C M e g).card ≤
      (conflictLinkLayer C e 1 ∩ conflictLinkLayer C g 1).card +
        ∑ r ∈ Finset.Icc 2 3,
          (partialFamily (commonImmediateEvictorLinkLayer C e g r)
            (availableEdges H C M) M 1).card := by
  let F₀ := conflictLinkLayer C e 1 ∩ conflictLinkLayer C g 1
  let G : ℕ → Hypergraph V := fun r ↦
    ((partialFamily (commonImmediateEvictorLinkLayer C e g r)
      (availableEdges H C M) M 1).biUnion id).filter fun f ↦
        f ∈ availableEdges H C M
  have hsub : rankOneKilledConflictVictims H C M e g ⊆
      F₀.biUnion id ∪ (Finset.Icc 2 3).biUnion G := by
    simpa only [F₀, G] using
      rankOneKilledConflictVictims_subset_immediate_union_CStar
        H C M hCcard e g
  have hF₀ : (F₀.biUnion id).card ≤ F₀.card := by
    calc
      (F₀.biUnion id).card ≤ ∑ Q ∈ F₀, Q.card :=
        Finset.card_biUnion_le
      _ = ∑ _Q ∈ F₀, 1 := by
        apply Finset.sum_congr rfl
        intro Q hQ
        exact (mem_conflictLinkLayer.mp
          (Finset.inter_subset_left hQ)).2
      _ = F₀.card := by simp
  have hG : ((Finset.Icc 2 3).biUnion G).card ≤
      ∑ r ∈ Finset.Icc 2 3,
        (partialFamily (commonImmediateEvictorLinkLayer C e g r)
          (availableEdges H C M) M 1).card := by
    calc
      ((Finset.Icc 2 3).biUnion G).card ≤
          ∑ r ∈ Finset.Icc 2 3, (G r).card :=
        Finset.card_biUnion_le
      _ ≤ ∑ r ∈ Finset.Icc 2 3,
          (partialFamily (commonImmediateEvictorLinkLayer C e g r)
            (availableEdges H C M) M 1).card := by
        apply Finset.sum_le_sum
        intro r hr
        simpa only [G, and_true] using
          card_partialFamily_union_filter_le
            (commonImmediateEvictorLinkLayer C e g r)
            (availableEdges H C M) M (fun _ ↦ True)
  calc
    (rankOneKilledConflictVictims H C M e g).card ≤
        (F₀.biUnion id ∪ (Finset.Icc 2 3).biUnion G).card :=
      Finset.card_le_card hsub
    _ ≤ (F₀.biUnion id).card +
        ((Finset.Icc 2 3).biUnion G).card := Finset.card_union_le _ _
    _ ≤ F₀.card + ∑ r ∈ Finset.Icc 2 3,
        (partialFamily (commonImmediateEvictorLinkLayer C e g r)
          (availableEdges H C M) M 1).card := Nat.add_le_add hF₀ hG
    _ = _ := rfl

/-- The immediate branch is C5 when the source and chosen blocker form a
two-conflict, and is the certificate `commonLinks` coordinate otherwise.
Both branches have the same sharp exponent. -/
theorem CFMRegularization.RegularizationCertificate.rankOneImmediateIntersection_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    {e g : Finset V} (heH : e ∈ H) (hgH : g ∈ H)
    (heg : Disjoint e g) :
    (((conflictLinkLayer R.regularized e 1 ∩
        conflictLinkLayer R.regularized g 1).card : ℕ) : ℝ) ≤
      Real.rpow d (1 - epsRaw / 4) := by
  by_cases hpair : {e, g} ∈ conflictLayer R.regularized 2
  · rw [← CFMRegularization.conditionC5Count_eq_commonOneLinks
        H R.regularized R.isConflictSystem e g]
    exact R.bounded.conditionC5_upper heH hgH heg
  · simpa using Erdos136.RegularizationCertificate.commonLinks_natRank
      R heH hgH heg hpair 1 (by norm_num)

/-- Sum the hard CC victims in the source orientation (frozen source,
chosen blocker).  This is the finite numerator to be divided by the number
of available choices in the persistent mean. -/
def rankOneKilledCCVictimMass
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (e : Finset V) : ℕ :=
  ∑ g ∈ conflictBlockerChoices C M (availableEdges H C M) e,
    (rankOneKilledConflictVictims H C M e g).card

theorem rankOneKilledCCVictimMass_le
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (e : Finset V) (immediateHi cstarHi : ℕ)
    (himmediate : ∀ g ∈
      conflictBlockerChoices C M (availableEdges H C M) e,
      (conflictLinkLayer C e 1 ∩ conflictLinkLayer C g 1).card ≤
        immediateHi)
    (hcstar : ∀ g ∈
      conflictBlockerChoices C M (availableEdges H C M) e,
      ∑ r ∈ Finset.Icc 2 3,
        (partialFamily (commonImmediateEvictorLinkLayer C e g r)
          (availableEdges H C M) M 1).card ≤ cstarHi) :
    rankOneKilledCCVictimMass H C M e ≤
      (conflictBlockerChoices C M (availableEdges H C M) e).card *
        (immediateHi + cstarHi) := by
  unfold rankOneKilledCCVictimMass
  calc
    (∑ g ∈ conflictBlockerChoices C M (availableEdges H C M) e,
        (rankOneKilledConflictVictims H C M e g).card) ≤
      ∑ g ∈ conflictBlockerChoices C M (availableEdges H C M) e,
        (immediateHi + cstarHi) := by
          apply Finset.sum_le_sum
          intro g hg
          exact (card_rankOneKilledConflictVictims_le_immediate_add_CStar
            H C M hCcard e g).trans
              (Nat.add_le_add (himmediate g hg) (hcstar g hg))
    _ = _ := by simp

end

/-! ## Integrated: PersistentInternalConflictLinkRankOneMean -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

def rankOneOpenConflictLinkMembers
    (C : ConflictSystem V) (A : Hypergraph V) (e : Finset V) :
    Hypergraph V :=
  A.filter fun f ↦ ({f} : Hypergraph V) ∈ conflictLinkLayer C e 1

theorem partialFamily_conflictLink_one_eq_singletonImage
    (C : ConflictSystem V) (A M : Hypergraph V) (e : Finset V)
    (hAM : Disjoint A M) :
    partialFamily (conflictLinkLayer C e 1) A M 1 =
      (rankOneOpenConflictLinkMembers C A e).image fun f ↦ {f} := by
  ext Q
  constructor
  · intro hQ
    have hQ' := mem_partialFamily.mp hQ
    have hQcard : Q.card = 1 := (mem_conflictLinkLayer.mp hQ'.1).2
    obtain ⟨f, rfl⟩ := Finset.card_eq_one.mp hQcard
    have hfA : f ∈ A := by
      by_contra hfA
      simp [hfA] at hQ'
    exact Finset.mem_image.mpr
      ⟨f, Finset.mem_filter.mpr ⟨hfA, hQ'.1⟩, rfl⟩
  · intro hQ
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hQ
    have hf' := Finset.mem_filter.mp hf
    have hfM : f ∉ M := fun hfM ↦
      Finset.disjoint_left.mp hAM hf'.1 hfM
    apply mem_partialFamily.mpr
    refine ⟨hf'.2, ?_, ?_⟩ <;> simp [hf'.1, hfM]

theorem card_rankOneOpenConflictLinkMembers_eq_observable
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (M : Hypergraph V) (e : Finset V) :
    ((rankOneOpenConflictLinkMembers C (availableEdges H C M) e).card : ℝ) =
      partialTestObservable (conflictLinkTestWeight C e 1)
        H C 1 1 M := by
  rw [partialTestObservable_conflictLinkTestWeight hC]
  have himage := congrArg Finset.card
    (partialFamily_conflictLink_one_eq_singletonImage
      C (availableEdges H C M) M e
      (availableEdges_disjoint_selected H C M))
  rw [Finset.card_image_of_injective _
    (fun _ _ h ↦ Finset.singleton_injective h)] at himage
  exact_mod_cast himage.symm

/-- At rank one and status one, the killed-loss numerator is exactly the
sum of common blocker multiplicities over the currently open one-link
members. -/
theorem weightedKilledPartialTestLossChoices_conflictLink_one_eq_sum_common
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (M : Hypergraph V) (e : Finset V) :
    weightedKilledPartialTestLossChoices
        (conflictLinkTestWeight C e 1) H C M e 1 1 =
      ∑ f ∈ rankOneOpenConflictLinkMembers C (availableEdges H C M) e,
        ((availableBlockerChoices H C M e ∩
          availableBlockerChoices H C M f).card : ℝ) := by
  let A := availableEdges H C M
  let F := rankOneOpenConflictLinkMembers C A e
  let P := partialFamily (conflictLinkLayer C e 1) A M 1
  have hPsub : P ⊆ H.powersetCard 1 := by
    intro Q hQ
    have hQ' := mem_partialFamily.mp hQ
    exact Finset.mem_powersetCard.mpr
      ⟨conflictLinkLayer_subset_host hC e 1 Q hQ'.1,
        (mem_conflictLinkLayer.mp hQ'.1).2⟩
  have hfilter : (H.powersetCard 1).filter (fun Q ↦ Q ∈ P) = P := by
    ext Q
    simp only [Finset.mem_filter]
    constructor
    · exact fun h ↦ h.2
    · exact fun h ↦ ⟨hPsub h, h⟩
  unfold weightedKilledPartialTestLossChoices
  calc
    (∑ Q ∈ H.powersetCard 1,
        conflictLinkTestWeight C e 1 Q *
          (((partialTestLossChoiceSet H C M 1 1 Q) ∩
            availableBlockerChoices H C M e).card : ℝ)) =
      ∑ Q ∈ (H.powersetCard 1).filter (fun Q ↦ Q ∈ P),
          (((partialTestLossChoiceSet H C M 1 1 Q) ∩
            availableBlockerChoices H C M e).card : ℝ) := by
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro Q hQhost
      by_cases hQP : Q ∈ P
      · have hQsource := (mem_partialFamily.mp hQP).1
        simp [hQP, conflictLinkTestWeight, hQsource]
      · by_cases hQsource : Q ∈ conflictLinkLayer C e 1
        · have hnotcond :
            ¬partialTestCondition A M 1 1 Q := by
            intro hcond
            apply hQP
            apply mem_partialFamily.mpr
            refine ⟨hQsource, hcond.1, ?_⟩
            have hQcard := (Finset.mem_powersetCard.mp hQhost).2
            simpa [hQcard] using hcond.2
          have hempty : partialTestLossChoiceSet H C M 1 1 Q = ∅ := by
            apply Finset.eq_empty_iff_forall_notMem.mpr
            intro g hg
            exact hnotcond (Finset.mem_filter.mp hg).2.1
          simp [hQP, hempty]
        · simp [hQP, conflictLinkTestWeight, hQsource]
    _ = ∑ Q ∈ P,
          (((partialTestLossChoiceSet H C M 1 1 Q) ∩
            availableBlockerChoices H C M e).card : ℝ) := by rw [hfilter]
    _ = ∑ f ∈ F,
        ((availableBlockerChoices H C M e ∩
          availableBlockerChoices H C M f).card : ℝ) := by
      have hPimage := partialFamily_conflictLink_one_eq_singletonImage
        C A M e (by simpa only [A] using availableEdges_disjoint_selected H C M)
      have hPF : P = F.image fun f ↦ {f} := by
        simpa only [P, F] using hPimage
      rw [hPF, Finset.sum_image]
      · apply Finset.sum_congr rfl
        intro f hf
        have hf' := Finset.mem_filter.mp (show f ∈ F by simpa only [F] using hf)
        have hpart : ({f} : Hypergraph V) ∈ P := by
          rw [hPF]
          exact Finset.mem_image.mpr ⟨f, by simpa only [F] using hf, rfl⟩
        have hold : partialTestCondition A M 1 1 ({f} : Hypergraph V) := by
          have hp := (mem_partialFamily.mp hpart).2
          exact ⟨hp.1, by simpa using hp.2⟩
        have hloss := partialTestLossChoiceSet_eq_biUnion_availableBlockers
          H C M 1 1 ({f} : Hypergraph V)
          (Finset.mem_powersetCard.mpr ⟨by
            simpa using availableEdges_subset H C M hf'.1, by simp⟩) hold
        have hsingle : ({f} : Hypergraph V) ∩ A = {f} := by simp [hf'.1]
        rw [hloss, hsingle]
        simp [Finset.inter_comm]
      · intro f hf g hg hfg
        exact Finset.singleton_injective hfg

/-- Fubini in the chosen-blocker orientation.  Each CC pair on the left
is counted by the victim set attached to its chosen common blocker on the
right. -/
theorem sum_rankOne_blockerPairCC_le_victimMass
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (e : Finset V) :
    (∑ f ∈ rankOneOpenConflictLinkMembers C (availableEdges H C M) e,
        blockerPairCC H C M e f) ≤
      rankOneKilledCCVictimMass H C M e := by
  let A := availableEdges H C M
  let F := rankOneOpenConflictLinkMembers C A e
  let Ce := conflictBlockerChoices C M A e
  unfold rankOneKilledCCVictimMass
  calc
    (∑ f ∈ F, blockerPairCC H C M e f) =
        ∑ f ∈ F, ∑ g ∈ Ce,
          if g ∈ conflictBlockerChoices C M A f then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro f hf
      simp [blockerPairCC, Ce, A]
    _ = ∑ g ∈ Ce, ∑ f ∈ F,
          if g ∈ conflictBlockerChoices C M A f then 1 else 0 := by
      rw [Finset.sum_comm]
    _ ≤ ∑ g ∈ Ce, (rankOneKilledConflictVictims H C M e g).card := by
      apply Finset.sum_le_sum
      intro g hg
      have hsub : F.filter (fun f ↦
          g ∈ conflictBlockerChoices C M A f) ⊆
          rankOneKilledConflictVictims H C M e g := by
        intro f hf
        have hf' := Finset.mem_filter.mp hf
        have hfF := Finset.mem_filter.mp
          (show f ∈ rankOneOpenConflictLinkMembers C A e by
            simpa only [F] using hf'.1)
        rw [rankOneKilledConflictVictims, Finset.mem_filter]
        refine ⟨?_, hfF.1, by simpa only [A] using hf'.2⟩
        apply Finset.mem_biUnion.mpr
        refine ⟨{f}, ?_, by simp⟩
        exact mem_partialFamily_one_of_subset_insert
          hfF.2 (by simp) (by simp) hfF.1
          (availableEdges_disjoint_selected H C M)
      calc
        (∑ f ∈ F,
            if g ∈ conflictBlockerChoices C M A f then 1 else 0) =
            (F.filter (fun f ↦
              g ∈ conflictBlockerChoices C M A f)).card := by
                simp
        _ ≤ (rankOneKilledConflictVictims H C M e g).card :=
          Finset.card_le_card hsub
    _ = _ := by rfl

/-- MM+MC+CM for the exceptional rank-one source.  The CC term is kept
unbounded so it can be routed through the chosen-blocker victim mass. -/
theorem card_inter_availableBlockers_rankOne_le_nonCC_add_CC
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {e f : Finset V} (he : e ∈ availableEdges H C M)
    (hf : f ∈ availableEdges H C M) (hef : e ≠ f)
    (hdisj : Disjoint e f) (codegreeHi mixedHi : ℕ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ a ∈ availableEdges H C M,
      ∀ b ∈ availableEdges H C M, Disjoint a b → ∀ v ∈ b,
        CFMRegularization.conditionC4Count H C a v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M a 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M a 3 1 v).card ≤ mixedHi) :
    (availableBlockerChoices H C M e ∩
        availableBlockerChoices H C M f).card ≤
      64 * codegreeHi + 16 * mixedHi + blockerPairCC H C M e f := by
  have heH := availableEdges_subset H C M he
  have hfH := availableEdges_subset H C M hf
  have hene : e.Nonempty := Finset.card_pos.mp (by rw [hH8 e heH]; norm_num)
  have hfne : f.Nonempty := Finset.card_pos.mp (by rw [hH8 f hfH]; norm_num)
  have hsplit := card_inter_availableBlockers_le_MM_MC_CM_CC
    he hene hf hfne
  have hmm : blockerPairMM H C M e f ≤ 64 * codegreeHi := by
    have h := card_inter_availableMeetingChoices_le_card_mul_card_mul
      (availableEdges H C M) hdisj hcodegree
    simpa [blockerPairMM, hH8 e heH, hH8 f hfH, Nat.mul_assoc] using h
  have hmc : blockerPairMC H C M e f ≤ 8 * mixedHi := by
    have h := card_inter_meeting_conflictBlockers_le_C4_add_local
      hCcard e hf
    calc
      blockerPairMC H C M e f ≤ ∑ v ∈ e,
          (CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card) := by
              simpa only [blockerPairMC] using h
      _ ≤ ∑ _v ∈ e, mixedHi := by
        apply Finset.sum_le_sum
        intro v hv
        exact hmixed f hf e he hdisj.symm v hv
      _ = 8 * mixedHi := by simp [hH8 e heH]
  have hcm : blockerPairCM H C M e f ≤ 8 * mixedHi := by
    have h := card_inter_meeting_conflictBlockers_le_C4_add_local
      hCcard f he
    calc
      blockerPairCM H C M e f ≤ ∑ v ∈ f,
          (CFMRegularization.conditionC4Count H C e v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M e 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M e 3 1 v).card) := by
              simpa only [blockerPairCM, Finset.inter_comm] using h
      _ ≤ ∑ _v ∈ f, mixedHi := by
        apply Finset.sum_le_sum
        intro v hv
        exact hmixed e he f hf hdisj v hv
      _ = 8 * mixedHi := by simp [hH8 f hfH]
  omega

/-- Complete q=1 killed-loss numerator: ordinary pair geometry pays the
observable-scaled MM/MC/CM cap, while CC pays the chosen-oriented C5 /
commonLinks / C* victim mass exactly once. -/
theorem weightedKilledPartialTestLossChoices_conflictLink_one_le
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (M : Hypergraph V) {e : Finset V}
    (he : e ∈ availableEdges H C M) (codegreeHi mixedHi : ℕ)
    (hH8 : IsUniform H 8)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ a ∈ availableEdges H C M,
      ∀ b ∈ availableEdges H C M, Disjoint a b → ∀ v ∈ b,
        CFMRegularization.conditionC4Count H C a v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M a 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M a 3 1 v).card ≤ mixedHi) :
    weightedKilledPartialTestLossChoices
        (conflictLinkTestWeight C e 1) H C M e 1 1 ≤
      (64 * codegreeHi + 16 * mixedHi : ℕ) *
          partialTestObservable (conflictLinkTestWeight C e 1)
            H C 1 1 M +
        rankOneKilledCCVictimMass H C M e := by
  rw [weightedKilledPartialTestLossChoices_conflictLink_one_eq_sum_common
    hC M e]
  let F := rankOneOpenConflictLinkMembers C (availableEdges H C M) e
  have hpoint : ∀ f ∈ F,
      (availableBlockerChoices H C M e ∩
          availableBlockerChoices H C M f).card ≤
        64 * codegreeHi + 16 * mixedHi + blockerPairCC H C M e f := by
    intro f hf
    have hf' := Finset.mem_filter.mp
      (show f ∈ rankOneOpenConflictLinkMembers C
          (availableEdges H C M) e by simpa only [F] using hf)
    have hlink := hf'.2
    obtain ⟨⟨c, hcC, hec, hcErase⟩, hcard⟩ :=
      mem_conflictLinkLayer.mp hlink
    have hfc : f ∈ c := by
      have hfsingle : f ∈ ({f} : Hypergraph V) := by simp
      have hferase : f ∈ c.erase e := by rw [hcErase]; exact hfsingle
      exact (Finset.mem_erase.mp hferase).2
    have hfe : f ≠ e := by
      intro hfe
      subst f
      exact distinguished_not_mem_conflictLinkLayer hlink (by simp)
    have hdisj : Disjoint e f :=
      (hmatching c hcC).2 hec hfc hfe.symm
    exact card_inter_availableBlockers_rankOne_le_nonCC_add_CC
      H C M he hf'.1 hfe.symm hdisj codegreeHi mixedHi
        hH8 hcodegree hCcard hmixed
  have hsum :
      (∑ f ∈ F,
          ((availableBlockerChoices H C M e ∩
            availableBlockerChoices H C M f).card : ℝ)) ≤
        ((F.card * (64 * codegreeHi + 16 * mixedHi) : ℕ) : ℝ) +
          ∑ f ∈ F, (blockerPairCC H C M e f : ℝ) := by
    calc
      _ ≤ ∑ f ∈ F,
          ((64 * codegreeHi + 16 * mixedHi +
            blockerPairCC H C M e f : ℕ) : ℝ) := by
              apply Finset.sum_le_sum
              intro f hf
              exact_mod_cast hpoint f hf
      _ = ((F.card * (64 * codegreeHi + 16 * mixedHi) : ℕ) : ℝ) +
          ∑ f ∈ F, (blockerPairCC H C M e f : ℝ) := by
            push_cast
            simp [Finset.sum_add_distrib]
            ring
  have hccNat := sum_rankOne_blockerPairCC_le_victimMass H C M e
  have hcc : (∑ f ∈ F, (blockerPairCC H C M e f : ℝ)) ≤
      (rankOneKilledCCVictimMass H C M e : ℝ) := by exact_mod_cast hccNat
  have hF := card_rankOneOpenConflictLinkMembers_eq_observable hC M e
  calc
    _ ≤ ((F.card * (64 * codegreeHi + 16 * mixedHi) : ℕ) : ℝ) +
        ∑ f ∈ F, (blockerPairCC H C M e f : ℝ) := hsum
    _ ≤ ((F.card : ℝ) *
          ((64 * codegreeHi + 16 * mixedHi : ℕ) : ℝ)) +
        (rankOneKilledCCVictimMass H C M e : ℝ) := by
          push_cast
          exact add_le_add_right hcc _
    _ = _ := by
      rw [hF]
      ring

theorem meanKilledPartialTestLoss_conflictLink_one_le
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (M : Hypergraph V) {e : Finset V}
    (he : e ∈ availableEdges H C M) (codegreeHi mixedHi : ℕ)
    (hH8 : IsUniform H 8)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ a ∈ availableEdges H C M,
      ∀ b ∈ availableEdges H C M, Disjoint a b → ∀ v ∈ b,
        CFMRegularization.conditionC4Count H C a v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M a 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M a 3 1 v).card ≤ mixedHi) :
