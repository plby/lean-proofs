    (hf' : f ∈ availableEdges H C M') :
    persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' =
      externalTestLowerStep (conflictLinkTestWeight C f j) H C
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' := by
  rw [persistentInternalConflictLinkLowerStep, if_pos hf',
    externalTestLowerStep,
    partialTestObservable_conflictLinkTestWeight hC f j s M,
    partialTestObservable_conflictLinkTestWeight hC f j s M']
  rfl

/-- The survivor-restricted raw square has the same sharp cap-times-mean
bound as the ordinary test increment.  Killed choices contribute zero,
while the right side may harmlessly retain the full gain/loss means. -/
theorem greedyStepExpectation_persistentInternalConflictLinkIncrement_sq_le_cap_mul_meanGain_add_meanLoss
    {H : Hypergraph V} {C : ConflictSystem V} (hC : IsConflictSystem H C)
    (M : Hypergraph V) {f : Finset V}
    (hf : f ∈ availableEdges H C M) (j s : ℕ) {cap : ℝ}
    (hw : ∀ Q, 0 ≤ conflictLinkTestWeight C f j Q)
    (hcap0 : 0 ≤ cap)
    (hgainCap : ∀ e ∈ availableEdges H C M,
      f ∈ availableEdges H C (insert e M) →
      partialTestStepGain (conflictLinkTestWeight C f j)
        H C j s M e ≤ cap)
    (hlossCap : ∀ e ∈ availableEdges H C M,
      f ∈ availableEdges H C (insert e M) →
      partialTestStepLoss (conflictLinkTestWeight C f j)
        H C j s M e ≤ cap) :
    greedyStepExpectation H C M (fun M' ↦
        (persistentInternalConflictLinkIncrement H C f j s M M') ^ 2) ≤
      cap *
        (meanPartialTestGain (conflictLinkTestWeight C f j)
            H C j s M +
          meanPartialTestLoss (conflictLinkTestWeight C f j)
            H C j s M) := by
  have hA : (availableEdges H C M).Nonempty := ⟨f, hf⟩
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp hA
  rw [greedyStepExpectation_eq_average H C M _ hA]
  simp only [meanPartialTestGain, meanPartialTestLoss, hAne, if_false]
  rw [show cap *
      ((∑ e ∈ availableEdges H C M,
          partialTestStepGain (conflictLinkTestWeight C f j)
            H C j s M e) /
            ((availableEdges H C M).card : ℝ) +
        (∑ e ∈ availableEdges H C M,
          partialTestStepLoss (conflictLinkTestWeight C f j)
            H C j s M e) /
            ((availableEdges H C M).card : ℝ)) =
      (cap * ((∑ e ∈ availableEdges H C M,
          partialTestStepGain (conflictLinkTestWeight C f j)
            H C j s M e) +
        ∑ e ∈ availableEdges H C M,
          partialTestStepLoss (conflictLinkTestWeight C f j)
            H C j s M e)) /
            ((availableEdges H C M).card : ℝ) by ring]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  calc
    ∑ e ∈ availableEdges H C M,
        (persistentInternalConflictLinkIncrement H C f j s M
          (insert e M)) ^ 2 ≤
      ∑ e ∈ availableEdges H C M,
        cap * (partialTestStepGain (conflictLinkTestWeight C f j)
            H C j s M e +
          partialTestStepLoss (conflictLinkTestWeight C f j)
            H C j s M e) := by
      apply Finset.sum_le_sum
      intro e he
      have hg0 := partialTestStepGain_nonneg
        (conflictLinkTestWeight C f j) H C M j s e hw
      have hl0 := partialTestStepLoss_nonneg
        (conflictLinkTestWeight C f j) H C M j s e hw
      by_cases hfnext : f ∈ availableEdges H C (insert e M)
      · rw [persistentInternalConflictLinkIncrement, if_pos hfnext,
          ← partialTestObservable_conflictLinkTestWeight hC f j s,
          ← partialTestObservable_conflictLinkTestWeight hC f j s,
          partialTestObservable_insert_sub_eq_gain_sub_loss]
        have hg := hgainCap e he hfnext
        have hl := hlossCap e he hfnext
        have hgg := mul_le_mul_of_nonneg_left hg hg0
        have hll := mul_le_mul_of_nonneg_left hl hl0
        nlinarith
      · rw [persistentInternalConflictLinkIncrement, if_neg hfnext,
          zero_pow (by norm_num)]
        exact mul_nonneg hcap0 (add_nonneg hg0 hl0)
    _ = cap * ((∑ e ∈ availableEdges H C M,
          partialTestStepGain (conflictLinkTestWeight C f j)
            H C j s M e) +
        ∑ e ∈ availableEdges H C M,
          partialTestStepLoss (conflictLinkTestWeight C f j)
            H C j s M e) := by
      simp_rw [mul_add]
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]

/-- Persistent envelope squares use only the survivor-restricted raw
second moment; killed choices contribute zero to both raw and trajectory
increments. -/
theorem persistentInternalConflictLinkEnvelopeStep_squareExpectation_le_sharpVariance
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) {P Q : ℝ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N
      (k : ℝ) P j s)
    (hscale : 0 ≤ scale)
    (hraw : greedyStepExpectation H C M (fun M' ↦
      (persistentInternalConflictLinkIncrement H C f j s M M') ^ 2) ≤ Q) :
    greedyStepExpectation H C M (fun M' ↦
      (persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale
          (k : ℝ) j s M M') ^ 2) ≤
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N scale
        j s (fun _ ↦ Q) k ∧
    greedyStepExpectation H C M (fun M' ↦
      (persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale
          (k : ℝ) j s M M') ^ 2) ≤
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N scale
        j s (fun _ ↦ Q) k := by
  let Y := persistentInternalConflictLinkIncrement H C f j s M
  let du := externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N scale
    j s ((k : ℝ) + 1) -
      externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N scale
        j s (k : ℝ)
  let dl := externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N scale
    j s ((k : ℝ) + 1) -
      externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N scale
        j s (k : ℝ)
  have hupperPoint : ∀ M',
      (persistentInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale
          (k : ℝ) j s M M') ^ 2 ≤
        2 * (Y M') ^ 2 + 2 * du ^ 2 := by
    intro M'
    by_cases hf' : f ∈ availableEdges H C M'
    · have hstep :
          persistentInternalConflictLinkUpperStep H C f
              D₂ D₃ D₄ Gamma epsilon d N scale
                (k : ℝ) j s M M' = Y M' - du := by
          simp only [persistentInternalConflictLinkUpperStep,
            persistentInternalConflictLinkIncrement,
            externalTestUpperTrajectory, hf', if_true, Y, du]
          ring
      rw [hstep]
      nlinarith [sq_nonneg (Y M' + du)]
    · rw [persistentInternalConflictLinkUpperStep, if_neg hf',
        zero_pow (by norm_num)]
      positivity
  have hlowerPoint : ∀ M',
      (persistentInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale
          (k : ℝ) j s M M') ^ 2 ≤
        2 * (Y M') ^ 2 + 2 * dl ^ 2 := by
    intro M'
    by_cases hf' : f ∈ availableEdges H C M'
    · have hstep :
          persistentInternalConflictLinkLowerStep H C f
              D₂ D₃ D₄ Gamma epsilon d N scale
                (k : ℝ) j s M M' = -Y M' + dl := by
          simp only [persistentInternalConflictLinkLowerStep,
            persistentInternalConflictLinkIncrement,
            externalTestLowerTrajectory, hf', if_true, Y, dl]
          ring
      rw [hstep]
      nlinarith [sq_nonneg (Y M' + dl)]
    · rw [persistentInternalConflictLinkLowerStep, if_neg hf',
        zero_pow (by norm_num)]
      positivity
  have hupperRaw : greedyStepExpectation H C M (fun M' ↦
        (persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale
            (k : ℝ) j s M M') ^ 2) ≤
      2 * Q + 2 * du ^ 2 := by
    calc
      _ ≤ greedyStepExpectation H C M
          (fun M' ↦ 2 * (Y M') ^ 2 + 2 * du ^ 2) :=
        greedyStepExpectation_mono H C M hupperPoint
      _ = 2 * greedyStepExpectation H C M (fun M' ↦ (Y M') ^ 2) +
          2 * du ^ 2 := by
        rw [greedyStepExpectation_add,
          greedyStepExpectation_const_mul,
          greedyStepExpectation_const]
      _ ≤ 2 * Q + 2 * du ^ 2 := by linarith
  have hlowerRaw : greedyStepExpectation H C M (fun M' ↦
        (persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale
            (k : ℝ) j s M M') ^ 2) ≤
      2 * Q + 2 * dl ^ 2 := by
    calc
      _ ≤ greedyStepExpectation H C M
          (fun M' ↦ 2 * (Y M') ^ 2 + 2 * dl ^ 2) :=
        greedyStepExpectation_mono H C M hlowerPoint
      _ = 2 * greedyStepExpectation H C M (fun M' ↦ (Y M') ^ 2) +
          2 * dl ^ 2 := by
        rw [greedyStepExpectation_add,
          greedyStepExpectation_const_mul,
          greedyStepExpectation_const]
      _ ≤ 2 * Q + 2 * dl ^ 2 := by linarith
  have htraj := externalTestTrajectory_step_abs_le R hscale
  let Tj := externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N scale
    j s k
  have hT0 : 0 ≤ Tj :=
    (abs_nonneg _).trans (by
      simpa only [Tj, externalTestTrajectoryJump] using htraj.1)
  have huSq : du ^ 2 ≤ Tj ^ 2 := by
    simpa only [sq_abs, du] using
      (sq_le_sq₀ (abs_nonneg _) hT0).2
        (by simpa only [Tj, externalTestTrajectoryJump] using htraj.1)
  have hlSq : dl ^ 2 ≤ Tj ^ 2 := by
    simpa only [sq_abs, dl] using
      (sq_le_sq₀ (abs_nonneg _) hT0).2
        (by simpa only [Tj, externalTestTrajectoryJump] using htraj.2)
  constructor
  · exact hupperRaw.trans (by
      unfold externalTestSharpVariance
      dsimp only
      nlinarith)
  · exact hlowerRaw.trans (by
      unfold externalTestSharpVariance
      dsimp only
      nlinarith)

/-! The reachable constructor below is the persistent analogue of
`reachableExternalTestSourceBudgets_of_sharpRaw`.  Pointwise raw caps are
required only when `f` survives the choice; the killed branch is exactly
zero by definition. -/

theorem reachablePersistentInternalConflictLinkSourceBudgets_of_sharpRaw
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (f : Finset V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N Pfloor scale : ℝ) (j s : ℕ)
    (jump variance rawJump rawVariance : ℕ → ℝ)
    (hscale : 0 ≤ scale)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) Pfloor j s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      IsConflictFreeMatching H C M → M.card = k →
      f ∈ availableEdges H C M →
      persistentInternalConflictLinkProbability H C f M * scale *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon
              d N j s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
        meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
            H C f j s M -
          meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
            H C f j s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      IsConflictFreeMatching H C M → M.card = k →
      f ∈ availableEdges H C M →
      meanPersistentPartialTestGain (conflictLinkTestWeight C f j)
            H C f j s M -
          meanPersistentPartialTestLoss (conflictLinkTestWeight C f j)
            H C f j s M ≤
        persistentInternalConflictLinkProbability H C f M * scale *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon
              d N j s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)))
    (hraw0 : ∀ k, 0 ≤ rawJump k)
    (hgain : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H C M → ∀ e ∈ availableEdges H C M,
      f ∈ availableEdges H C (insert e M) →
      partialTestStepGain (conflictLinkTestWeight C f j)
        H C j s M e ≤ rawJump k)
    (hloss : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H C M → ∀ e ∈ availableEdges H C M,
      f ∈ availableEdges H C (insert e M) →
      partialTestStepLoss (conflictLinkTestWeight C f j)
        H C j s M e ≤ rawJump k)
    (hrawSquare : ∀ k, k < T → ∀ M, Good k M →
      IsConflictFreeMatching H C M → M.card = k →
      f ∈ availableEdges H C M →
      greedyStepExpectation H C M (fun M' ↦
        (persistentInternalConflictLinkIncrement H C f j s M M') ^ 2) ≤
          rawVariance k)
    (hjump : ∀ k, k < T →
      rawJump k + externalTestTrajectoryJump
        D₂ D₃ D₄ Gamma epsilon d N scale j s k ≤ jump k)
    (hvariance : ∀ k, k < T →
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N scale
        j s rawVariance k ≤ variance k) :
    ReachablePersistentInternalConflictLinkSourceBudgets
      H C f Good T D₂ D₃ D₄ Gamma epsilon d N Pfloor scale
        j s jump variance := by
  have hweight : ∀ Q, 0 ≤ conflictLinkTestWeight C f j Q := by
    intro Q
    unfold conflictLinkTestWeight
    positivity
  have hrawChoice : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H C M → ∀ o : GreedyChoice H,
      f ∈ availableEdges H C (greedyChoiceStep H C M o) →
      |partialTestObservable (conflictLinkTestWeight C f j)
          H C j s (greedyChoiceStep H C M o) -
        partialTestObservable (conflictLinkTestWeight C f j)
          H C j s M| ≤ rawJump k := by
    intro k hk M hgood hf o hfnext
    rcases o with _ | e
    · simpa [greedyChoiceStep] using hraw0 k
    · by_cases he : (e : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert he,
          partialTestObservable_insert_sub_eq_gain_sub_loss]
        have hfnext' : f ∈ availableEdges H C (insert (e : Finset V) M) := by
          simpa [greedyChoiceStep, greedyStep_eq_insert he] using hfnext
        rw [abs_le]
        constructor <;>
          linarith [hgain k hk M hgood hf e.1 he hfnext',
            hloss k hk M hgood hf e.1 he hfnext',
            partialTestStepGain_nonneg (conflictLinkTestWeight C f j)
              H C M j s e.1 hweight,
            partialTestStepLoss_nonneg (conflictLinkTestWeight C f j)
              H C M j s e.1 hweight]
      · simpa [greedyChoiceStep, greedyStep_eq_self he] using hraw0 k
  have htrajectory0 : ∀ k, k < T → ∀ M, Good k M →
      0 ≤ externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N scale
        j s k := by
    intro k hk M hgood
    have htraj := externalTestTrajectory_step_abs_le
      (hregistry k hk M hgood) hscale
    exact (abs_nonneg _).trans (by
      simpa only [externalTestTrajectoryJump] using htraj.1)
  refine
    { scale_nonneg := hscale
      registry := hregistry
      meanLower := hmeanLower
      meanUpper := hmeanUpper
      upperJump := ?_
      lowerJump := ?_
      upperSquare := ?_
      lowerSquare := ?_ }
  · intro k hk M hgood hf o
    by_cases hf' : f ∈ availableEdges H C (greedyChoiceStep H C M o)
    · rw [persistentInternalConflictLinkUpperStep_eq_externalTestUpperStep_of_nextActive
        hC f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ)
          j s M (greedyChoiceStep H C M o) hf']
      exact ((externalTestEnvelopeStep_abs_le_of_observableJump
        (conflictLinkTestWeight C f j) H C D₂ D₃ D₄ Gamma epsilon
          d N scale (k : ℝ) j s M (greedyChoiceStep H C M o)
          (hregistry k hk M hgood) hscale
          (hrawChoice k hk M hgood hf o hf')).1).trans (hjump k hk)
    · rw [(persistentInternalConflictLinkSteps_eq_zero_of_nextInactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s M
          (greedyChoiceStep H C M o) hf').1, abs_zero]
      exact (hraw0 k).trans
        ((le_add_of_nonneg_right (htrajectory0 k hk M hgood)).trans
            (hjump k hk))
  · intro k hk M hgood hf o
    by_cases hf' : f ∈ availableEdges H C (greedyChoiceStep H C M o)
    · rw [persistentInternalConflictLinkLowerStep_eq_externalTestLowerStep_of_nextActive
        hC f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ)
          j s M (greedyChoiceStep H C M o) hf']
      exact ((externalTestEnvelopeStep_abs_le_of_observableJump
        (conflictLinkTestWeight C f j) H C D₂ D₃ D₄ Gamma epsilon
          d N scale (k : ℝ) j s M (greedyChoiceStep H C M o)
          (hregistry k hk M hgood) hscale
          (hrawChoice k hk M hgood hf o hf')).2).trans (hjump k hk)
    · rw [(persistentInternalConflictLinkSteps_eq_zero_of_nextInactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s M
          (greedyChoiceStep H C M o) hf').2, abs_zero]
      exact (hraw0 k).trans
        ((le_add_of_nonneg_right (htrajectory0 k hk M hgood)).trans
            (hjump k hk))
  · intro k hk M hgood hM hcard hf
    exact ((persistentInternalConflictLinkEnvelopeStep_squareExpectation_le_sharpVariance
      H C f D₂ D₃ D₄ Gamma epsilon d N scale j s k M
        (hregistry k hk M hgood) hscale
        (hrawSquare k hk M hgood hM hcard hf)).1).trans
          (hvariance k hk)
  · intro k hk M hgood hM hcard hf
    exact ((persistentInternalConflictLinkEnvelopeStep_squareExpectation_le_sharpVariance
      H C f D₂ D₃ D₄ Gamma epsilon d N scale j s k M
        (hregistry k hk M hgood) hscale
        (hrawSquare k hk M hgood hM hcard hf)).2).trans
          (hvariance k hk)

end

/-! ## Integrated: InternalOneOpenGainProperBridge -/


open Finset

variable {V : Type*} [DecidableEq V]

attribute [local instance] Classical.propDecidable

noncomputable section

/-!
The internal `s = 1` gain never needs the full fixed-choice remainder
rank.  At link rank one it vanishes, and at ranks two and three its source
root has selected rank `q - 2`.  Thus the generic weighted root-shadow
profile should use family rank `q - 1` but active rank `q - 2`.
-/

/-- A partial coordinate cannot gain when its requested available status
is already at least the test rank. -/
theorem partialTestStepGain_eq_zero_of_rank_le_status
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    (he : e ∈ availableEdges H C M) (hjs : j ≤ s) :
    partialTestStepGain w H C j s M e = 0 := by
  unfold partialTestStepGain partialTestGainBetween
  apply Finset.sum_eq_zero
  intro S hS
  by_cases hgain :
      ¬ partialTestCondition (availableEdges H C M) M j s S ∧
        partialTestCondition (availableEdges H C (insert e M))
          (insert e M) j s S
  · have heChoice : e ∈ partialTestGainChoiceSet H C M j s S := by
      rw [partialTestGainChoiceSet, Finset.mem_filter]
      exact ⟨he, hgain⟩
    have hsource := partialTestGainChoice_mem_source_succ
      H C M j s S hS heChoice
    have hcardS : S.card = j := (Finset.mem_powersetCard.mp hS).2
    have hcardInter : (S ∩ availableEdges H C M).card ≤ S.card :=
      Finset.card_le_card Finset.inter_subset_left
    have hstatus : (S ∩ availableEdges H C M).card = s + 1 :=
      hsource.1.1
    omega
  · rw [if_neg hgain]

/-- In particular, a singleton internal link has no gain at status one. -/
theorem partialTestStepGain_conflictLink_one_one_eq_zero
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) {e : Finset V}
    (he : e ∈ availableEdges H C M) :
    partialTestStepGain (conflictLinkTestWeight C f 1)
        H C 1 1 M e = 0 := by
  exact partialTestStepGain_eq_zero_of_rank_le_status
    (conflictLinkTestWeight C f 1) H C M 1 1 he (by omega)

end

/-! ## Integrated: InternalOneOpenLossSurvivingBridge -/


open Finset Real

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-- The fixed-rank one-open links whose unique available member belongs to
`D`.  Unlike `oneOpenConflictLinkFamilyOnChoices`, this remembers the link
rank needed by the vertex-local charge. -/
def oneOpenConflictLinkLayerOnChoices
    (C : ConflictSystem V) (A M D : Hypergraph V)
    (f : Finset V) (q : ℕ) : ConflictSystem V :=
  (partialFamily (conflictLinkLayer C f q) A M 1).filter
    fun Q ↦ (Q ∩ D).Nonempty

/-- The actual available members represented by the restricted fixed-rank
one-open family. -/
def oneOpenConflictLinkLayerChoicesOnChoices
    (C : ConflictSystem V) (A M D : Hypergraph V)
    (f : Finset V) (q : ℕ) : Hypergraph V :=
  (oneOpenConflictLinkLayerOnChoices C A M D f q).biUnion
    fun Q ↦ Q ∩ A

@[simp] theorem mem_oneOpenConflictLinkLayerOnChoices
    {C : ConflictSystem V} {A M D : Hypergraph V}
    {f : Finset V} {q : ℕ} {Q : Hypergraph V} :
    Q ∈ oneOpenConflictLinkLayerOnChoices C A M D f q ↔
      Q ∈ partialFamily (conflictLinkLayer C f q) A M 1 ∧
        (Q ∩ D).Nonempty := by
  simp [oneOpenConflictLinkLayerOnChoices]

/-- The selected incidence charge for a fixed conflict-link layer is exactly
supported on its restricted one-open family. -/
theorem selectedTestIncidenceCharge_conflictLink_one_le_layerRestricted
    {H : Hypergraph V} {C : ConflictSystem V}
    (M D : Hypergraph V) (f : Finset V) (q : ℕ)
    (hDA : D ⊆ availableEdges H C M) (hD : Disjoint D M) :
    selectedTestIncidenceCharge (conflictLinkTestWeight C f q)
        H M q (q - 1) D ≤
      ((oneOpenConflictLinkLayerOnChoices C
        (availableEdges H C M) M D f q).card : ℝ) := by
  let A := availableEdges H C M
  let G := oneOpenConflictLinkLayerOnChoices C A M D f q
  let L := (H.powersetCard q).filter fun Q ↦
    Q ∈ conflictLinkLayer C f q ∧
      (Q ∩ M).card = q - 1 ∧ (Q ∩ D).Nonempty
  have hcharge :
      selectedTestIncidenceCharge (conflictLinkTestWeight C f q)
          H M q (q - 1) D = (L.card : ℝ) := by
    unfold selectedTestIncidenceCharge
    calc
      (∑ S ∈ H.powersetCard q,
        if (S ∩ M).card = q - 1 then
          conflictLinkTestWeight C f q S * (S ∩ D).card else 0) =
          ∑ _S ∈ L, (1 : ℝ) := by
        rw [Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro S hS
        by_cases hlink : S ∈ conflictLinkLayer C f q
        · by_cases hsel : (S ∩ M).card = q - 1
          · by_cases hmeet : (S ∩ D).Nonempty
            · have hcardS : S.card = q :=
                (Finset.mem_powersetCard.mp hS).2
              have hdisj : Disjoint (S ∩ M) (S ∩ D) :=
                hD.symm.mono Finset.inter_subset_right
                  Finset.inter_subset_right
              have hDMcard :
                  (S ∩ M).card + (S ∩ D).card ≤ S.card := by
                rw [← Finset.card_union_of_disjoint hdisj]
                exact Finset.card_le_card
                  (Finset.union_subset Finset.inter_subset_left
                    Finset.inter_subset_left)
              have hDcard : (S ∩ D).card = 1 := by
                have hpos := Finset.card_pos.mpr hmeet
                omega
              simp [hlink, hsel, hmeet, hDcard]
            · have hDzero : (S ∩ D).card = 0 :=
                Finset.card_eq_zero.mpr
                  (Finset.not_nonempty_iff_eq_empty.mp hmeet)
              simp [hlink, hsel, hmeet, hDzero]
          · simp [hlink, hsel]
        · simp [hlink]
      _ = (L.card : ℝ) := by simp
  rw [hcharge]
  exact_mod_cast Finset.card_le_card (by
    intro Q hQL
    have hQL' := Finset.mem_filter.mp hQL
    have hQcard := (Finset.mem_powersetCard.mp hQL'.1).2
    have hQlink := hQL'.2.1
    have hQM := hQL'.2.2.1
    have hQD := hQL'.2.2.2
    apply mem_oneOpenConflictLinkLayerOnChoices.mpr
    refine ⟨mem_partialFamily.mpr ⟨hQlink, ?_, ?_⟩, hQD⟩
    · have hAM : Disjoint (availableEdges H C M) M :=
        availableEdges_disjoint_selected H C M
      have hdisj : Disjoint
          (Q ∩ availableEdges H C M) (Q ∩ M) :=
        hAM.mono Finset.inter_subset_right Finset.inter_subset_right
      have hcardUnion :
          (Q ∩ availableEdges H C M).card + (Q ∩ M).card ≤ Q.card := by
        rw [← Finset.card_union_of_disjoint hdisj]
        exact Finset.card_le_card
          (Finset.union_subset Finset.inter_subset_left
            Finset.inter_subset_left)
      have hpos : 1 ≤ (Q ∩ availableEdges H C M).card := by
        obtain ⟨d, hdQD⟩ := hQD
        exact Finset.one_le_card.mpr
          ⟨d, Finset.mem_inter.mpr
            ⟨Finset.inter_subset_left hdQD,
              hDA (Finset.inter_subset_right hdQD)⟩⟩
      omega
    · simpa [hQcard] using hQM)

/-- Outside the global duplicate family, the available-member sections of
the restricted fixed-rank family are disjoint.  Hence only their actual
union, rather than all deleted host edges, is charged. -/
theorem card_oneOpenConflictLinkLayerOnChoices_le_choices_add_colliding
    (C : ConflictSystem V) (A M D : Hypergraph V)
    (f : Finset V) (q : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    (oneOpenConflictLinkLayerOnChoices C A M D f q).card ≤
      (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card +
        (collidingOneOpenConflictLinks C A M f).card := by
  let G := oneOpenConflictLinkLayerOnChoices C A M D f q
  let K := collidingOneOpenConflictLinks C A M f
  let S := G \ K
  have hcardA : ∀ Q ∈ G, (Q ∩ A).card = 1 := by
    intro Q hQ
    exact (mem_partialFamily.mp
      (mem_oneOpenConflictLinkLayerOnChoices.mp
        (by simpa only [G] using hQ)).1).2.1
  have hpair : (↑S : Set (Hypergraph V)).PairwiseDisjoint
      (fun Q ↦ Q ∩ A) := by
    intro Q hQS Q' hQ'S hne
    have hQdata := Finset.mem_sdiff.mp hQS
    have hQ'data := Finset.mem_sdiff.mp hQ'S
    have hQG : Q ∈ G := hQdata.1
    have hQ'G : Q' ∈ G := hQ'data.1
    have hQpartial := (mem_oneOpenConflictLinkLayerOnChoices.mp
      (by simpa only [G] using hQG)).1
    have hQ'partial := (mem_oneOpenConflictLinkLayerOnChoices.mp
      (by simpa only [G] using hQ'G)).1
    change Disjoint (Q ∩ A) (Q' ∩ A)
    rw [Finset.disjoint_left]
    intro e heQ heQ'
    apply hQdata.2
    apply mem_collidingOneOpenConflictLinks.mpr
    refine ⟨mem_oneOpenConflictLinkFamily.mpr
        ⟨q, Finset.mem_Icc.mpr ⟨hq1, hq3⟩, hQpartial⟩,
      Q', mem_oneOpenConflictLinkFamily.mpr
        ⟨q, Finset.mem_Icc.mpr ⟨hq1, hq3⟩, hQ'partial⟩,
      hne.symm, ?_⟩
    have hQsingle : Q ∩ A = {e} := by
      obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q hQG)
      have hea : e = a := by
        rw [ha] at heQ
        exact Finset.mem_singleton.mp heQ
      simpa [hea] using ha
    have hQ'single : Q' ∩ A = {e} := by
      obtain ⟨a, ha⟩ := Finset.card_eq_one.mp (hcardA Q' hQ'G)
      have hea : e = a := by
        rw [ha] at heQ'
        exact Finset.mem_singleton.mp heQ'
      simpa [hea] using ha
    exact hQ'single.trans hQsingle.symm
  have hcardSUnion :
      (S.biUnion (fun Q ↦ Q ∩ A)).card = S.card := by
    rw [Finset.card_biUnion hpair]
    calc
      (∑ Q ∈ S, (Q ∩ A).card) = ∑ _Q ∈ S, 1 := by
        apply Finset.sum_congr rfl
        intro Q hQS
        exact hcardA Q (Finset.mem_sdiff.mp hQS).1
      _ = S.card := by simp
  have hSUnionSub : S.biUnion (fun Q ↦ Q ∩ A) ⊆
      oneOpenConflictLinkLayerChoicesOnChoices C A M D f q := by
    intro e he
    obtain ⟨Q, hQS, heQA⟩ := Finset.mem_biUnion.mp he
    exact Finset.mem_biUnion.mpr
      ⟨Q, Finset.mem_sdiff.mp hQS |>.1, heQA⟩
  have hScardLe : S.card ≤
      (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card := by
    rw [← hcardSUnion]
    exact Finset.card_le_card hSUnionSub
  have hsplit : S.card + (G ∩ K).card = G.card := by
    simpa only [S] using Finset.card_sdiff_add_card_inter G K
  have hinterLe : (G ∩ K).card ≤ K.card :=
    Finset.card_le_card Finset.inter_subset_right
  change G.card ≤
    (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card + K.card
  calc
    G.card = S.card + (G ∩ K).card := hsplit.symm
    _ ≤ (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card +
          K.card := Nat.add_le_add hScardLe hinterLe

/-- A choice represented by a restricted one-open link is itself in the
deleted set.  This uses the singleton available section. -/
theorem mem_deleted_of_mem_oneOpenConflictLinkLayerChoicesOnChoices
    {C : ConflictSystem V} {A M D : Hypergraph V}
    {f g : Finset V} {q : ℕ} (hDA : D ⊆ A)
    (hg : g ∈ oneOpenConflictLinkLayerChoicesOnChoices C A M D f q) :
    g ∈ D := by
  obtain ⟨Q, hQG, hgQA⟩ := Finset.mem_biUnion.mp hg
  have hQdata := mem_oneOpenConflictLinkLayerOnChoices.mp hQG
  obtain ⟨d, hdQD⟩ := hQdata.2
  have hdQA : d ∈ Q ∩ A := Finset.mem_inter.mpr
    ⟨Finset.inter_subset_left hdQD, hDA (Finset.inter_subset_right hdQD)⟩
  have hcard : (Q ∩ A).card = 1 :=
    (mem_partialFamily.mp hQdata.1).2.1
  obtain ⟨a, ha⟩ := Finset.card_eq_one.mp hcard
  have hga : g = a := Finset.mem_singleton.mp (ha ▸ hgQA)
  have hda : d = a := Finset.mem_singleton.mp (ha ▸ hdQA)
  exact hga.symm ▸ hda ▸ Finset.inter_subset_right hdQD

/-- The actual restricted available members split sharply into a
vertex-local meeting part and a conflict-conflict common-blocker part. -/
theorem card_oneOpenConflictLinkLayerChoicesOnChoices_le_local_add_CC
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f e : Finset V} {q : ℕ}
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (heA : e ∈ availableEdges H C M) (hene : e.Nonempty)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    let A := availableEdges H C M
    let D := A \ availableEdges H C (insert e M)
    (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card ≤
      (∑ v ∈ e,
        (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
        blockerPairCC H C M f e := by
  dsimp only
  let A := availableEdges H C M
  let D := A \ availableEdges H C (insert e M)
  let P := oneOpenConflictLinkLayerChoicesOnChoices C A M D f q
  let PC := P.filter fun g ↦ Disjoint g e
  let PM := P.filter fun g ↦ ¬Disjoint g e
  have hmeetSub : PM ⊆ e.biUnion fun v ↦
      localConflictLinkAvailableMembers C A M f q 1 v := by
    intro g hg
    have hg' := Finset.mem_filter.mp hg
    obtain ⟨Q, hQG, hgQA⟩ := Finset.mem_biUnion.mp hg'.1
    have hQpartial :=
      (mem_oneOpenConflictLinkLayerOnChoices.mp hQG).1
    obtain ⟨v, hvg, hve⟩ := Finset.not_disjoint_iff.mp hg'.2
    apply Finset.mem_biUnion.mpr
    refine ⟨v, hve, ?_⟩
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_biUnion.mpr ⟨Q, hQpartial, ?_⟩, ?_⟩
    · exact Finset.inter_subset_left hgQA
    · exact ⟨Finset.inter_subset_right hgQA, hvg⟩
  have hmeetCard : PM.card ≤ ∑ v ∈ e,
      (localConflictLinkPartialAtVertex C A M f q 1 v).card := by
    calc
      PM.card ≤ (e.biUnion fun v ↦
          localConflictLinkAvailableMembers C A M f q 1 v).card :=
        Finset.card_le_card hmeetSub
      _ ≤ ∑ v ∈ e,
          (localConflictLinkAvailableMembers C A M f q 1 v).card :=
        Finset.card_biUnion_le
      _ ≤ ∑ v ∈ e,
          (localConflictLinkPartialAtVertex C A M f q 1 v).card := by
        apply Finset.sum_le_sum
        intro v hv
        exact card_localConflictLinkAvailableMembers_one_le C A M f q v
  have hconfSub : PC ⊆
      conflictBlockerChoices C M A f ∩ conflictBlockerChoices C M A e := by
    intro g hg
    have hg' := Finset.mem_filter.mp hg
    obtain ⟨Q, hQG, hgQA⟩ := Finset.mem_biUnion.mp hg'.1
    have hQdata := mem_oneOpenConflictLinkLayerOnChoices.mp hQG
    have hgA : g ∈ A := Finset.inter_subset_right hgQA
    have hgQ : g ∈ Q := Finset.inter_subset_left hgQA
    have hgD : g ∈ D :=
      mem_deleted_of_mem_oneOpenConflictLinkLayerChoicesOnChoices
        Finset.sdiff_subset hg'.1
    have hgActive : g ∈ activeConflictBlockers C A M f := by
      unfold activeConflictBlockers
      exact Finset.mem_biUnion.mpr
        ⟨q, Finset.mem_Icc.mpr ⟨hq1, hq3⟩,
          Finset.mem_biUnion.mpr ⟨Q, hQdata.1, hgQ⟩⟩
    have hQlink := (mem_partialFamily.mp hQdata.1).1
    obtain ⟨⟨c, hcC, hfc, hcErase⟩, _⟩ :=
      mem_conflictLinkLayer.mp hQlink
    have hgc : g ∈ c := by
      have hgErase : g ∈ c.erase f := by simpa only [hcErase] using hgQ
      exact (Finset.mem_erase.mp hgErase).2
    have hgf : g ≠ f := by
      have hgErase : g ∈ c.erase f := by simpa only [hcErase] using hgQ
      exact (Finset.mem_erase.mp hgErase).1
    have hdisjGF : Disjoint g f := (hmatching c hcC).2 hgc hfc hgf
    have hconfF : g ∈ conflictBlockerChoices C M A f := by
      apply activeConflictBlockers_available_disjoint_subset
      exact Finset.mem_filter.mpr ⟨hgActive, hgA, hdisjGF⟩
    have hblockE : g ∈ availableBlockerChoices H C M e := by
      have hgNotNext : g ∉ availableEdges H C (insert e M) :=
        (Finset.mem_sdiff.mp (by simpa only [D, A] using hgD)).2
      rw [availableEdges_insert_eq_sdiff_blockers] at hgNotNext
      by_contra hgNotBlock
      exact hgNotNext (Finset.mem_sdiff.mpr ⟨by simpa only [A] using hgA,
        hgNotBlock⟩)
    have hsplit' : g ∈ CFMRegularization.availableMeetingChoices A e ∨
        g ∈ conflictBlockerChoices C M A e := by
      rw [sharp_availableBlockerChoices_eq_meeting_union_conflict
        heA hene] at hblockE
      exact Finset.mem_union.mp hblockE
    have hconfE : g ∈ conflictBlockerChoices C M A e := by
      rcases hsplit' with hmeet | hconf
      · exact False.elim ((Finset.mem_filter.mp hmeet).2 hg'.2)
      · exact hconf
    exact Finset.mem_inter.mpr ⟨hconfF, hconfE⟩
  have hconfCard : PC.card ≤ blockerPairCC H C M f e := by
    exact Finset.card_le_card hconfSub
  have hpartition : PC.card + PM.card = P.card := by
    simpa only [PC, PM] using
      P.card_filter_add_card_filter_not (fun g ↦ Disjoint g e)
  change P.card ≤
    (∑ v ∈ e, (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
      blockerPairCC H C M f e
  calc
    P.card = PC.card + PM.card := hpartition.symm
    _ ≤ blockerPairCC H C M f e +
        (∑ v ∈ e,
          (localConflictLinkPartialAtVertex C A M f q 1 v).card) :=
      Nat.add_le_add hconfCard hmeetCard
    _ = _ := Nat.add_comm _ _

/-- A surviving distinguished edge and the chosen edge form exactly a
legal reroot pair. -/
theorem nextAvailable_legalReroot_pair
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f e : Finset V}
    (hfNext : f ∈ availableEdges H C (insert e M)) :
    e ≠ f ∧ Disjoint f e ∧ {f, e} ∉ conflictLayer C 2 := by
  have hfData := mem_availableEdges.mp hfNext
  have hef : e ≠ f := by
    intro hef
    apply hfData.2.1
    simpa [hef]
  have hfe : f ≠ e := Ne.symm hef
  have hdisj : Disjoint f e := by
    exact hfData.2.2.1.2
      (Finset.mem_insert_self f (insert e M))
      (Finset.mem_insert_of_mem (Finset.mem_insert_self e M)) hfe
  have hpair : {f, e} ∉ conflictLayer C 2 := by
    intro hp
    have hpC : ({f, e} : Hypergraph V) ∈ C := (Finset.mem_filter.mp hp).1
    apply hfData.2.2.2 {f, e} hpC
    intro g hg
    rcases Finset.mem_insert.mp hg with hgf | hg
    · simpa only [hgf] using Finset.mem_insert_self f (insert e M)
    · have hge : g = e := Finset.mem_singleton.mp hg
      subst g
      exact Finset.mem_insert_of_mem (Finset.mem_insert_self e M)
  exact ⟨hef, hdisj, hpair⟩

/-- Source-faithful pointwise one-open loss for a surviving internal edge.
Meeting deletions are vertex-local, conflict deletions are legal reroots,
and only duplicate representations pay the point-duplicate correction. -/
theorem partialTestStepLoss_conflictLink_one_surviving_le_local_reroot_duplicate
    {H : Hypergraph V} {C : ConflictSystem V}
    (M : Hypergraph V) (f : Finset V) (q : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hmatching : ∀ c ∈ C, IsMatching H c)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {e : Finset V} (he : e ∈ availableEdges H C M)
    (hene : e.Nonempty)
    (hfNext : f ∈ availableEdges H C (insert e M)) :
    partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q 1 M e ≤
      (∑ v ∈ e,
        ((localConflictLinkPartialAtVertex C
          (availableEdges H C M) M f q 1 v).card : ℝ)) +
      (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
        ((partialFamily
          (testConflictUnionLayer (conflictLinkLayer C f q') C e r)
          (availableEdges H C M) M 1).card : ℝ)) +
      64 * ∑ r ∈ Finset.Icc 0 6,
        ((partialFamily (duplicateConflictLinkUnionLayer C f r)
          (availableEdges H C M) M 1).card : ℝ) := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  let D := A \ A'
  have hDsubA : D ⊆ A := Finset.sdiff_subset
  have hDM : Disjoint D M :=
    (availableEdges_disjoint_selected H C M).mono_left hDsubA
  have hloss := partialTestStepLoss_le_selectedTestIncidenceCharge
    (conflictLinkTestWeight C f q) H C M q 1 he
    (conflictLinkTestWeight_nonneg_sharp C f q)
  have hinc :=
    selectedTestIncidenceCharge_conflictLink_one_le_layerRestricted
      M D f q hDsubA hDM
  have hsections :=
    card_oneOpenConflictLinkLayerOnChoices_le_choices_add_colliding
      C A M D f q hq1 hq3
  have hchoice :=
    card_oneOpenConflictLinkLayerChoicesOnChoices_le_local_add_CC
      (f := f) (e := e) (q := q) hmatching he hene hq1 hq3
  have hfA : f ∈ A := by
    exact availableEdges_insert_subset H C M e hfNext
  have hreroot := blockerPairCC_le_rerootedPartialMass
    hCcard hfA (by simpa only [A] using he)
  have hcollision := card_collidingOneOpenConflictLinks_le_duplicatePartial
    (C := C) (A := A) (M := M) (f := f)
      (availableEdges_disjoint_selected H C M)
  have hnat :
      (oneOpenConflictLinkLayerOnChoices C A M D f q).card ≤
        (∑ v ∈ e,
          (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
        (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q') C e r)
            A M 1).card) +
        64 * ∑ r ∈ Finset.Icc 0 6,
          (partialFamily (duplicateConflictLinkUnionLayer C f r)
            A M 1).card := by
    have hchoice' :
        (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card ≤
          (∑ v ∈ e,
            (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
          blockerPairCC H C M f e := by
      simpa only [A, D, A'] using hchoice
    have hreroot' : blockerPairCC H C M f e ≤
        ∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q') C e r)
            A M 1).card := by
      simpa only [A] using hreroot
    have hcollision' :
        (collidingOneOpenConflictLinks C A M f).card ≤
          64 * ∑ r ∈ Finset.Icc 0 6,
            (partialFamily (duplicateConflictLinkUnionLayer C f r)
              A M 1).card := hcollision
    calc
      (oneOpenConflictLinkLayerOnChoices C A M D f q).card ≤
          (oneOpenConflictLinkLayerChoicesOnChoices C A M D f q).card +
            (collidingOneOpenConflictLinks C A M f).card := hsections
      _ ≤ ((∑ v ∈ e,
              (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
            blockerPairCC H C M f e) +
          (collidingOneOpenConflictLinks C A M f).card :=
        Nat.add_le_add_right hchoice' _
      _ ≤ ((∑ v ∈ e,
              (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
            (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
              (partialFamily
                (testConflictUnionLayer
                  (conflictLinkLayer C f q') C e r) A M 1).card)) +
          (collidingOneOpenConflictLinks C A M f).card :=
        Nat.add_le_add_right (Nat.add_le_add_left hreroot' _) _
      _ ≤ ((∑ v ∈ e,
              (localConflictLinkPartialAtVertex C A M f q 1 v).card) +
            (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
              (partialFamily
                (testConflictUnionLayer
                  (conflictLinkLayer C f q') C e r) A M 1).card)) +
          64 * ∑ r ∈ Finset.Icc 0 6,
            (partialFamily (duplicateConflictLinkUnionLayer C f r)
              A M 1).card := Nat.add_le_add_left hcollision' _
      _ = _ := by omega
  calc
    partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q 1 M e ≤
        selectedTestIncidenceCharge (conflictLinkTestWeight C f q)
          H M q (q - 1) D := by simpa only [D, A, A'] using hloss
    _ ≤ ((oneOpenConflictLinkLayerOnChoices C A M D f q).card : ℝ) := hinc
    _ ≤
      (∑ v ∈ e,
        ((localConflictLinkPartialAtVertex C A M f q 1 v).card : ℝ)) +
      (∑ q' ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
        ((partialFamily
          (testConflictUnionLayer (conflictLinkLayer C f q') C e r)
          A M 1).card : ℝ)) +
      64 * ∑ r ∈ Finset.Icc 0 6,
        ((partialFamily (duplicateConflictLinkUnionLayer C f r)
          A M 1).card : ℝ) := by exact_mod_cast hnat
    _ = _ := by rfl

end

