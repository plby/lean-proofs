variable {V io : Type*} [DecidableEq V] [Fintype V] [Fintype io]

/-- State-independent literal test registry for every external or internal
coordinate.  All large-degree and stopping-time inequalities are discharged
from the core cutoff; consumers only choose the source rank and coordinate. -/
theorem certificateLiteralTestStepRegistry
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate
      H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (N : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (k : ℕ) (hk : k < CFMNumericAggregation.targetTime eta d N)
    (q s : ℕ) (hsq : s ≤ q) (hq4 : q ≤ 4) :
    CFMTrajectories.TestStepRegistry
      (certificateD₂ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₃ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (certificateD₄ H C d (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R)
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d (N : ℝ) (k : ℝ) (CFMNumeric.trajectoryFloor eta d) q s := by
  have Rdelta := certificateLiteralDeltaStepRegistry
    H C d eta ell j w hinst R N E S hN k hk
  exact CFMNumeric.TestStepRegistry.of_source_stopExponent
    Rdelta (CFMNumeric.testLargeDCondition_of_cutoff S hN hsq)
    (CFMNumericAggregation.coreEpsilon_nonneg E)
    (fun y hy ↦ (CFMNumeric.stopExponent_floor_of_cutoff S).trans
      (Rdelta.degree.pV_floor y hy))
    E.stopExponent_relations.2.2 (CFMNumeric.testHazard_of_cutoff S)
    hsq hq4

end

