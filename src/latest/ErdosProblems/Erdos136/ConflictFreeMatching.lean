/-- Nonfull/source-meeting mass under the abstract proper-source package. -/
theorem weightedGainCollisionResidualNonFullNonemptySourceRootMass_le_raw_of_properSourceBounds
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d eta W K ellSrc GammaB epsRaw : ℝ}
    {w : TestWeight V}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d GammaB (epsRaw / 4))
    (hd : 1 ≤ d) (hepsRaw : 0 ≤ epsRaw)
    (hK0 : 0 ≤ K) (hW0 : 0 ≤ W) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualNonFullNonemptySourceRootMass
        w H C j r root ≤
      24 * K * W * Real.rpow d
        (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4 - eta) := by
  unfold weightedGainCollisionResidualNonFullNonemptySourceRootMass
  by_cases hj2 : 2 ≤ j
  · let E : ℝ :=
      ((r - j : ℕ) : ℝ) - (root.card : ℝ) + 1 - epsRaw / 4
    have hmeet := sourcePair_meetingRoot_weight_le_rootExtensionSum
      (H := H) hP.1 hj3 root
    have hsingle :=
      sum_singleton_testExtension_root_le_of_properSourceBounds
        hP hj2 root hrootH
    have hdenPos : 0 < Real.rpow d (1 + eta) :=
      Real.rpow_pos_of_pos (by linarith) _
    have hratio0 : 0 ≤ K * W / Real.rpow d (1 + eta) :=
      div_nonneg (mul_nonneg hK0 hW0) hdenPos.le
    have hmeetBound :
        (∑ S ∈ H.powersetCard j,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e,
            if ¬Disjoint root (gainCollisionResidualSource S e f)
            then w S else 0) ≤
          12 * (K * W / Real.rpow d (1 + eta)) := by
      calc
        _ ≤ 6 * ∑ g ∈ root, testExtension w H j {g} := hmeet
        _ ≤ 6 * ((root.card : ℝ) *
            (K * W / Real.rpow d (1 + eta))) :=
          mul_le_mul_of_nonneg_left hsingle (by norm_num)
        _ ≤ 12 * (K * W / Real.rpow d (1 + eta)) := by
          nlinarith [show (root.card : ℝ) ≤ 2 by exact_mod_cast hroot2]
    have hrpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d) E
    calc
      (∑ S ∈ H.powersetCard j,
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f) then
            w S * (gainCollisionResidualNonFullConflictCandidates
              H C S e f r root).card else 0) ≤
        2 * Real.rpow d E *
          (∑ S ∈ H.powersetCard j,
            ∑ e ∈ S,
            ∑ f ∈ S.erase e,
              if ¬Disjoint root (gainCollisionResidualSource S e f)
              then w S else 0) := by
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro S hS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro e heS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro f hfS
          by_cases hmeetSF : ¬Disjoint root
              (gainCollisionResidualSource S e f)
          · rw [if_pos hmeetSF, if_pos hmeetSF]
            have hcand :=
              gainCollisionResidualNonFullConflictCandidates_card_le_two_mul
                (r := r) (root := root) hB hd hepsRaw hj3 hS heS hfS
            have hBcard :=
              card_root_sdiff_residualSource_eq_sub_one_of_meets
                (Finset.mem_powersetCard.mp hS).2 heS
                (Finset.mem_erase.mp hfS).2
                (Ne.symm (Finset.mem_erase.mp hfS).1) hj3 hmeetSF
            rw [hBcard] at hcand
            have hroot1 : 1 ≤ root.card := by
              obtain ⟨g, hgroot, hgT⟩ :=
                Finset.not_disjoint_iff.mp hmeetSF
              exact Finset.card_pos.mpr ⟨g, hgroot⟩
            have hcast : ((root.card - 1 : ℕ) : ℝ) =
                (root.card : ℝ) - 1 := by
              rw [Nat.cast_sub hroot1]
              norm_num
            rw [hcast] at hcand
            have hExp : ((r - j : ℕ) : ℝ) -
                ((root.card : ℝ) - 1) - epsRaw / 4 = E := by
              dsimp only [E]
              ring
            rw [hExp] at hcand
            calc
              w S * (gainCollisionResidualNonFullConflictCandidates
                  H C S e f r root).card ≤
                  w S * (2 * Real.rpow d E) :=
                mul_le_mul_of_nonneg_left hcand (hP.1 S)
              _ = 2 * Real.rpow d E * w S := by ring
          · rw [if_neg hmeetSF, if_neg hmeetSF]
            norm_num
      _ ≤ 2 * Real.rpow d E *
          (12 * (K * W / Real.rpow d (1 + eta))) :=
        mul_le_mul_of_nonneg_left hmeetBound
          (mul_nonneg (by norm_num) hrpow0)
      _ = 24 * K * W * Real.rpow d
          (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4 - eta) := by
        have hratio : Real.rpow d E / Real.rpow d (1 + eta) =
            Real.rpow d
              (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4 - eta) := by
          calc
            Real.rpow d E / Real.rpow d (1 + eta) =
                Real.rpow d (E - (1 + eta)) :=
              (Real.rpow_sub (by linarith : 0 < d) _ _).symm
            _ = Real.rpow d
                (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4 - eta) := by
              congr 1
              dsimp only [E]
              ring
        rw [show 2 * Real.rpow d E *
            (12 * (K * W / Real.rpow d (1 + eta))) =
            24 * K * W *
              (Real.rpow d E / Real.rpow d (1 + eta)) by ring,
          hratio]
  · have hj1 : j ≤ 1 := by omega
    apply le_trans (b := 0)
    · apply Finset.sum_nonpos
      intro S hS
      have hScard := (Finset.mem_powersetCard.mp hS).2
      apply Finset.sum_nonpos
      intro e heS
      have hErase : S.erase e = ∅ := by
        apply Finset.card_eq_zero.mp
        rw [Finset.card_erase_of_mem heS, hScard]
        omega
      rw [hErase]
      simp
    · exact mul_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) hK0) hW0)
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

/-- Unified nonfull estimate under the proper-source package. -/
theorem weightedGainCollisionResidualNonFullRootMass_le_raw_of_properSourceBounds
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d eta W K ellSrc GammaB epsRaw : ℝ}
    {w : TestWeight V}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d GammaB (epsRaw / 4))
    (hd : 1 ≤ d) (heta : 0 ≤ eta) (hepsRaw : 0 ≤ epsRaw)
    (hK0 : 0 ≤ K) (hW0 : 0 ≤ W) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualNonFullRootMass w H C j r root ≤
      (12 + 24 * K) * W * Real.rpow d
        (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4) := by
  rw [weightedGainCollisionResidualNonFullRootMass_eq_empty_add_nonempty]
  have hempty := weightedGainCollisionResidualNonFullEmptySourceRootMass_le_raw
    (r := r) hP.1 hB hd hepsRaw hj3 root
  have hemptyW :
      weightedGainCollisionResidualNonFullEmptySourceRootMass
          w H C j r root ≤
        12 * W * Real.rpow d
          (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4) := by
    apply hempty.trans
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hP.2.1 (by norm_num))
      (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
  have hmeet :=
    weightedGainCollisionResidualNonFullNonemptySourceRootMass_le_raw_of_properSourceBounds
      (r := r) hP hB hd hepsRaw hK0 hW0 hj3 root hrootH hroot2
  let E : ℝ :=
    ((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 4
  have hweaken : Real.rpow d (E - eta) ≤ Real.rpow d E := by
    apply Real.rpow_le_rpow_of_exponent_le hd
    linarith
  calc
    weightedGainCollisionResidualNonFullEmptySourceRootMass
          w H C j r root +
        weightedGainCollisionResidualNonFullNonemptySourceRootMass
          w H C j r root ≤
      12 * W * Real.rpow d E +
        24 * K * W * Real.rpow d (E - eta) := by
      exact add_le_add (by simpa only [E] using hemptyW)
        (by simpa only [E] using hmeet)
    _ ≤ 12 * W * Real.rpow d E +
        24 * K * W * Real.rpow d E := by
      exact add_le_add le_rfl
        (mul_le_mul_of_nonneg_left hweaken
          (mul_nonneg (mul_nonneg (by norm_num) hK0) hW0))
    _ = (12 + 24 * K) * W * Real.rpow d E := by ring

/-- One conflict layer in the proper full/empty-source charge.  Conflict
codegree and source extension have complementary powers of `d`. -/
theorem sum_properSource_extensions_over_supported_conflict_root_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j q : ℕ} {d eta W K ellSrc GammaB epsRaw : ℝ}
    {w : TestWeight V}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d GammaB (epsRaw / 4))
    (hd : 1 ≤ d) (hepsRaw : 0 ≤ epsRaw)
    (hK0 : 0 ≤ K) (hW0 : 0 ≤ W)
    (hq2 : 2 ≤ q) (hq4 : q ≤ 4)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) :
    (∑ c ∈ (conflictLayer C q).filter (fun c ↦
        root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j),
      testExtension w H j (c \ root)) ≤
      (GammaB + 1) * K * W * Real.rpow d (-eta) := by
  let F := (conflictLayer C q).filter (fun c ↦
    root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j)
  by_cases hF : F = ∅
  · rw [show (conflictLayer C q).filter (fun c ↦
        root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j) = ∅
      from hF]
    simp only [Finset.sum_empty]
    have hGammaB : 0 ≤ GammaB :=
      regularizedBounded_Gamma_nonneg hB (by linarith : 0 < d)
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by linarith) hK0) hW0)
      (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
  · obtain ⟨c₀, hc₀F⟩ := Finset.nonempty_iff_ne_empty.mpr hF
    have hc₀ := Finset.mem_filter.mp hc₀F
    have hc₀Layer := mem_conflictLayer.mp hc₀.1
    have hrootq : root.card < q := by
      have hcard := Finset.card_sdiff_add_card_inter c₀ root
      have hinter : c₀ ∩ root = root :=
        Finset.inter_eq_right.mpr hc₀.2.1
      rw [hinter, hc₀Layer.2] at hcard
      omega
    let E : ℝ := ((q - root.card : ℕ) : ℝ) + eta
    have hconst0 : 0 ≤ K * W / Real.rpow d E :=
      div_nonneg (mul_nonneg hK0 hW0)
        (Real.rpow_nonneg (by linarith : 0 ≤ d) E)
    have heach : ∀ c ∈ F,
        testExtension w H j (c \ root) ≤
          K * W / Real.rpow d E := by
      intro c hcF
      have hc := Finset.mem_filter.mp hcF
      have hcLayer := mem_conflictLayer.mp hc.1
      have hDcard : (c \ root).card = q - root.card := by
        rw [Finset.card_sdiff_of_subset hc.2.1, hcLayer.2]
      by_cases hDH : c \ root ⊆ H
      · have hext := hP.2.2.2.1 (c \ root) hDH
          (Nat.one_le_of_lt hc.2.2.1) hc.2.2.2
        simpa only [E, hDcard] using hext
      · have hz : testExtension w H j (c \ root) = 0 := by
          unfold testExtension
          apply Finset.sum_eq_zero
          intro S hS
          obtain ⟨hSpow, hDS⟩ := Finset.mem_filter.mp hS
          exfalso
          apply hDH
          exact hDS.trans (Finset.mem_powersetCard.mp hSpow).1
        rw [hz]
        exact hconst0
    have hcardF : (F.card : ℝ) ≤
        (codegree (conflictLayer C q) root : ℝ) := by
      exact_mod_cast Finset.card_le_card (by
        intro c hc
        exact Finset.mem_filter.mpr
          ⟨(Finset.mem_filter.mp hc).1, (Finset.mem_filter.mp hc).2.1⟩)
    have hcodegree := supported_conflict_root_codegree_le
      hB hd hepsRaw hq2 hq4 root hrootH hroot1 hrootq
    calc
      (∑ c ∈ (conflictLayer C q).filter (fun c ↦
          root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j),
        testExtension w H j (c \ root)) =
          ∑ c ∈ F, testExtension w H j (c \ root) := by rfl
      _ ≤ ∑ _c ∈ F, K * W / Real.rpow d E :=
        Finset.sum_le_sum heach
      _ = (F.card : ℝ) * (K * W / Real.rpow d E) := by simp
      _ ≤ (codegree (conflictLayer C q) root : ℝ) *
          (K * W / Real.rpow d E) :=
        mul_le_mul_of_nonneg_right hcardF hconst0
      _ ≤ ((GammaB + 1) * Real.rpow d
            ((q : ℝ) - (root.card : ℝ))) *
          (K * W / Real.rpow d E) :=
        mul_le_mul_of_nonneg_right hcodegree hconst0
      _ = (GammaB + 1) * K * W * Real.rpow d (-eta) := by
        have hrootqLe : root.card ≤ q := Nat.le_of_lt hrootq
        have hsubCast : ((q - root.card : ℕ) : ℝ) =
            (q : ℝ) - (root.card : ℝ) := Nat.cast_sub hrootqLe
        dsimp only [E]
        rw [hsubCast]
        have hratio : Real.rpow d ((q : ℝ) - (root.card : ℝ)) /
            Real.rpow d ((q : ℝ) - (root.card : ℝ) + eta) =
            Real.rpow d (-eta) := by
          calc
            Real.rpow d ((q : ℝ) - (root.card : ℝ)) /
                Real.rpow d ((q : ℝ) - (root.card : ℝ) + eta) =
              Real.rpow d (((q : ℝ) - (root.card : ℝ)) -
                ((q : ℝ) - (root.card : ℝ) + eta)) :=
                (Real.rpow_sub (by linarith : 0 < d) _ _).symm
            _ = Real.rpow d (-eta) := by
              congr 1
              ring
        rw [show ((GammaB + 1) * Real.rpow d
            ((q : ℝ) - (root.card : ℝ))) *
            (K * W / Real.rpow d
              ((q : ℝ) - (root.card : ℝ) + eta)) =
          (GammaB + 1) * K * W *
            (Real.rpow d ((q : ℝ) - (root.card : ℝ)) /
              Real.rpow d
                ((q : ℝ) - (root.card : ℝ) + eta)) by ring]
        rw [hratio]

/-- Raw proper-source full/empty boundary estimate. -/
theorem weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {f₀ : Finset V} {j r : ℕ}
    {d eta W K ellSrc GammaB epsRaw : ℝ} {w : TestWeight V}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d GammaB (epsRaw / 4))
    (hd : 1 ≤ d) (hepsRaw : 0 ≤ epsRaw)
    (hK0 : 0 ≤ K) (hW0 : 0 ≤ W) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) :
    weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
        w H C f₀ j r root ≤
      36 * (GammaB + 1) * K * W * Real.rpow d (-eta) := by
  have hFubini :=
    weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass_le_extensionSum
      (H := H) (C := C) (f₀ := f₀) (r := r) hP.1 hj3 root
  have hlayers := sum_conflictLayers_eq_sum_of_card_between_two_four
    (fun c hc ↦ hB.conflict_card hc)
    (fun c ↦ root ⊆ c ∧ 2 ≤ (c \ root).card ∧
      (c \ root).card < j)
    (fun c ↦ testExtension w H j (c \ root))
  rw [← hlayers] at hFubini
  have hterm : ∀ q ∈ Finset.Icc 2 4,
      (∑ c ∈ (conflictLayer C q).filter (fun c ↦
          root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j),
        testExtension w H j (c \ root)) ≤
        (GammaB + 1) * K * W * Real.rpow d (-eta) := by
    intro q hq
    exact sum_properSource_extensions_over_supported_conflict_root_le
      hP hB hd hepsRaw hK0 hW0
        (Finset.mem_Icc.mp hq).1 (Finset.mem_Icc.mp hq).2
        root hrootH hroot1
  calc
    weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
        w H C f₀ j r root ≤
      12 * ∑ q ∈ Finset.Icc 2 4,
        ∑ c ∈ (conflictLayer C q).filter (fun c ↦
          root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j),
          testExtension w H j (c \ root) := hFubini
    _ ≤ 12 * ∑ _q ∈ Finset.Icc 2 4,
        ((GammaB + 1) * K * W * Real.rpow d (-eta)) := by
      apply mul_le_mul_of_nonneg_left
      · exact Finset.sum_le_sum hterm
      · norm_num
    _ = 36 * (GammaB + 1) * K * W * Real.rpow d (-eta) := by
      norm_num [Finset.sum_Icc_succ_top]
      ring

