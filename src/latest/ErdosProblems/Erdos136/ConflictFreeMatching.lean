import ErdosProblems.Erdos136.Hypergraph
import ErdosProblems.Erdos136.Freedman
import ErdosProblems.Erdos136.CFMTrajectories
import ErdosProblems.Erdos136.CFMRegularization

/-!
# Conflict-free finite matching extraction

This module records the deterministic core of the conflict-free random-greedy
matching argument.  The genuinely probabilistic part of that argument has to
produce an extension invariant.  Once such an invariant has been produced,
the theorems below extract a conflict-free matching of the requested size,
without any choice of an infinite object and without any unproved principle.

The formulation with an arbitrary invariant `P` is useful for the test
functions in the Glock--Joos--Kim--Kühn--Lichev theorem: `P M` can assert all
simultaneous trajectory estimates for the prefix `M`.
-/

namespace Erdos136

open Finset

variable {V : Type*} [DecidableEq V]

attribute [local instance] Classical.propDecidable

/-- The two deterministic conditions maintained by a conflict-free matching
process. -/
def IsConflictFreeMatching (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) : Prop :=
  IsMatching H M ∧ ConflictFree C M

/-- Below `target`, every admissible family satisfying `P` has a one-edge
extension which is still admissible and still satisfies `P`.

This is deliberately phrased as a one-step property.  A probabilistic greedy
argument may establish it only for the prefixes of one successful outcome;
such an outcome immediately supplies the witnesses quantified here. -/
def ExtendableWithInvariant (H : Hypergraph V) (C : ConflictSystem V)
    (target : ℕ) (P : Hypergraph V → Prop) : Prop :=
  P ∅ ∧
    ∀ M, IsConflictFreeMatching H C M → P M → M.card < target →
      ∃ e ∈ H, e ∉ M ∧
        IsConflictFreeMatching H C (insert e M) ∧ P (insert e M)

/-- The invariant-free special case of `ExtendableWithInvariant`. -/
def Extendable (H : Hypergraph V) (C : ConflictSystem V) (target : ℕ) : Prop :=
  ExtendableWithInvariant H C target (fun _ => True)

theorem IsConflictFreeMatching.mono {H : Hypergraph V}
    {C : ConflictSystem V} {M N : Hypergraph V}
    (hM : IsConflictFreeMatching H C M) (hNM : N ⊆ M) :
    IsConflictFreeMatching H C N := by
  exact ⟨hM.1.mono hNM, hM.2.mono_family hNM⟩

theorem isConflictFreeMatching_empty (H : Hypergraph V)
    {C : ConflictSystem V} (hC : ∅ ∉ C) :
    IsConflictFreeMatching H C ∅ := by
  exact ⟨isMatching_empty H, conflictFree_empty hC⟩

/-! ## The finite conflict-free greedy process -/

/-- The edges which may legally be appended to the current family.  Keeping
the complete matching and conflict predicates in this definition makes the
state transition executable and avoids a separate informal notion of an
edge being deleted by the process. -/
noncomputable def availableEdges (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) : Hypergraph V := by
  classical
  exact H.filter fun e => e ∉ M ∧ IsConflictFreeMatching H C (insert e M)

@[simp] theorem mem_availableEdges {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {e : Finset V} :
    e ∈ availableEdges H C M ↔
      e ∈ H ∧ e ∉ M ∧ IsConflictFreeMatching H C (insert e M) := by
  classical
  simp [availableEdges]

theorem availableEdges_subset (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) : availableEdges H C M ⊆ H := by
  intro e he
  exact (mem_availableEdges.mp he).1

theorem availableEdges_uniform {H : Hypergraph V} {r : ℕ}
    (hH : IsUniform H r) (C : ConflictSystem V) (M : Hypergraph V) :
    IsUniform (availableEdges H C M) r :=
  hH.mono (availableEdges_subset H C M)

theorem availableEdges_maxCodegreeLE {H : Hypergraph V} {j D : ℕ}
    (hH : MaxCodegreeLE H j D) (C : ConflictSystem V) (M : Hypergraph V) :
    MaxCodegreeLE (availableEdges H C M) j D := by
  intro s hs
  exact (codegree_mono_hypergraph (availableEdges_subset H C M) s).trans
    (hH s hs)

/-- One deterministic transition of the greedy process.  An illegal choice
freezes the state; a legal choice is inserted.  Random greedy paths are
obtained later by assigning positive mass only to legal choices. -/
noncomputable def greedyStep (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (e : Finset V) : Hypergraph V :=
  if e ∈ availableEdges H C M then insert e M else M

theorem greedyStep_eq_insert {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {e : Finset V} (he : e ∈ availableEdges H C M) :
    greedyStep H C M e = insert e M := by
  simp [greedyStep, he]

theorem greedyStep_eq_self {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {e : Finset V} (he : e ∉ availableEdges H C M) :
    greedyStep H C M e = M := by
  simp [greedyStep, he]

/-- Every transition preserves an already established conflict-free
matching, including the frozen transition used after the available set is
empty. -/
theorem greedyStep_preserves {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} (hM : IsConflictFreeMatching H C M)
    (e : Finset V) :
    IsConflictFreeMatching H C (greedyStep H C M e) := by
  by_cases he : e ∈ availableEdges H C M
  · rw [greedyStep_eq_insert he]
    exact (mem_availableEdges.mp he).2.2
  · rw [greedyStep_eq_self he]
    exact hM

theorem card_greedyStep_of_mem {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {e : Finset V} (he : e ∈ availableEdges H C M) :
    (greedyStep H C M e).card = M.card + 1 := by
  rw [greedyStep_eq_insert he]
  exact Finset.card_insert_of_notMem (mem_availableEdges.mp he).2.1

/-- No selected edge remains in the executable available family. -/
theorem availableEdges_disjoint_selected (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) :
    Disjoint (availableEdges H C M) M := by
  apply Finset.disjoint_left.mpr
  intro e heA heM
  exact (mem_availableEdges.mp heA).2.1 heM

/-- If conflicts have at least two members, every host edge is available at
the empty initial state.  This is the process-side reason that all degree
and test trajectories start at their host totals. -/
theorem availableEdges_empty_eq_host (H : Hypergraph V)
    (C : ConflictSystem V) (hCcard : ∀ c ∈ C, 2 ≤ c.card) :
    availableEdges H C ∅ = H := by
  ext e
  rw [mem_availableEdges]
  constructor
  · exact fun he ↦ he.1
  · intro heH
    refine ⟨heH, by simp, isMatching_singleton_iff.mpr heH, ?_⟩
    intro c hc hcsub
    have hcle : c.card ≤ 1 := by
      simpa using Finset.card_le_card hcsub
    have htwo := hCcard c hc
    omega

/-- Run the deterministic transition along a finite list of proposed edges.
This is the state map used by a finite path probability space. -/
noncomputable def runGreedy (H : Hypergraph V) (C : ConflictSystem V) :
    List (Finset V) → Hypergraph V
  | [] => ∅
  | e :: es => greedyStep H C (runGreedy H C es) e

@[simp] theorem runGreedy_nil (H : Hypergraph V) (C : ConflictSystem V) :
    runGreedy H C [] = ∅ := rfl

@[simp] theorem runGreedy_cons (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (es : List (Finset V)) :
    runGreedy H C (e :: es) = greedyStep H C (runGreedy H C es) e := rfl

/-- Every finite run is a conflict-free matching.  The list is processed
from its tail so that prepending an edge represents the next transition;
this orientation makes induction and finite path extension immediate. -/
theorem runGreedy_isConflictFreeMatching (H : Hypergraph V)
    (C : ConflictSystem V) (hC : ∅ ∉ C) (es : List (Finset V)) :
    IsConflictFreeMatching H C (runGreedy H C es) := by
  induction es with
  | nil => exact isConflictFreeMatching_empty H hC
  | cons e es ih => exact greedyStep_preserves ih e

/-- A list is a successful path when every proposed edge is legal at the
moment it is proposed. -/
def IsSuccessfulGreedyPath (H : Hypergraph V) (C : ConflictSystem V) :
    List (Finset V) → Prop
  | [] => True
  | e :: es =>
      IsSuccessfulGreedyPath H C es ∧ e ∈ availableEdges H C (runGreedy H C es)

theorem card_runGreedy_of_successful {H : Hypergraph V}
    {C : ConflictSystem V} {es : List (Finset V)}
    (hes : IsSuccessfulGreedyPath H C es) :
    (runGreedy H C es).card = es.length := by
  induction es with
  | nil => simp
  | cons e es ih =>
      rw [runGreedy_cons, card_greedyStep_of_mem hes.2, ih hes.1]
      simp

/-- The available set strictly decreases along a legal greedy transition.
This finiteness fact is independent of all degree estimates. -/
theorem availableEdges_card_lt_of_step {H : Hypergraph V}
    {C : ConflictSystem V} {M : Hypergraph V} {e : Finset V}
    (he : e ∈ availableEdges H C M) :
    (availableEdges H C (insert e M)).card <
      (availableEdges H C M).card := by
  apply Finset.card_lt_card
  refine ⟨?_, ?_⟩
  · intro f hf
    have hf' := mem_availableEdges.mp hf
    have hfM : f ∉ M := by
      intro hfm
      exact hf'.2.1 (Finset.mem_insert_of_mem hfm)
    have hsubset : insert f M ⊆ insert f (insert e M) := by
      exact Finset.insert_subset_insert f (Finset.subset_insert e M)
    have hadm : IsConflictFreeMatching H C (insert f M) :=
      hf'.2.2.mono hsubset
    exact mem_availableEdges.mpr ⟨hf'.1, hfM, hadm⟩
  · intro hreverse
    have he' := mem_availableEdges.mp (hreverse he)
    exact he'.2.1 (Finset.mem_insert_self e M)

/-- Inserting a proposed edge can only remove available edges.  This holds
even when the proposal itself is not assumed legal and is the exact
monotonicity used by the regularized conflict process. -/
theorem availableEdges_insert_subset (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (e : Finset V) :
    availableEdges H C (insert e M) ⊆ availableEdges H C M := by
  intro f hf
  have hf' := mem_availableEdges.mp hf
  have hfM : f ∉ M := by
    intro hfm
    exact hf'.2.1 (Finset.mem_insert_of_mem hfm)
  have hsubset : insert f M ⊆ insert f (insert e M) :=
    Finset.insert_subset_insert f (Finset.subset_insert e M)
  exact mem_availableEdges.mpr
    ⟨hf'.1, hfM, hf'.2.2.mono hsubset⟩

/-- Exact update rule: after selecting `e`, the surviving available edges
are precisely the previously available `f ≠ e` for which the two-edge
extension remains a conflict-free matching. -/
theorem availableEdges_insert_eq_filter (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (e : Finset V) :
    availableEdges H C (insert e M) =
      (availableEdges H C M).filter (fun f ↦
        f ≠ e ∧ IsConflictFreeMatching H C (insert f (insert e M))) := by
  ext f
  simp only [Finset.mem_filter]
  constructor
  · intro hf
    have hf' := mem_availableEdges.mp hf
    refine ⟨availableEdges_insert_subset H C M e hf, ?_, hf'.2.2⟩
    intro hfe
    subst f
    exact hf'.2.1 (Finset.mem_insert_self e M)
  · rintro ⟨hfA, hfe, hadm⟩
    have hf' := mem_availableEdges.mp hfA
    refine mem_availableEdges.mpr ⟨hf'.1, ?_, hadm⟩
    simp only [Finset.mem_insert]
    rintro (rfl | hfM)
    · exact hfe rfl
    · exact hf'.2.1 hfM

/-- Choices deleted in one legal update, including the selected edge
itself.  Later lemmas split this exact family into matching blockers,
two-conflict blockers, and partially completed three/four-conflicts. -/
noncomputable def availableBlockerChoices (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (e : Finset V) : Hypergraph V :=
  (availableEdges H C M).filter (fun f ↦
    f = e ∨ ¬IsConflictFreeMatching H C (insert f (insert e M)))

theorem availableEdges_insert_eq_sdiff_blockers (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (e : Finset V) :
    availableEdges H C (insert e M) =
      availableEdges H C M \ availableBlockerChoices H C M e := by
  rw [availableEdges_insert_eq_filter]
  ext f
  simp only [Finset.mem_filter, Finset.mem_sdiff, availableBlockerChoices]
  tauto

/-- Number of currently available edges through `v` destroyed by the legal
insertion of `e`.  Defining it as an exact degree difference lets the
regularized process split this loss later into intersection and conflict
blocker contributions without changing the probability layer. -/
noncomputable def availableDegreeLoss (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (e : Finset V) (v : V) : ℕ :=
  degree (availableEdges H C M) v -
    degree (availableEdges H C (insert e M)) v

theorem degree_insert_available_add_loss (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (e : Finset V) (v : V) :
    degree (availableEdges H C (insert e M)) v +
        availableDegreeLoss H C M e v =
      degree (availableEdges H C M) v := by
  rw [availableDegreeLoss, Nat.add_sub_of_le]
  exact degree_mono (availableEdges_insert_subset H C M e) v

theorem availableDegreeLoss_le (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (e : Finset V) (v : V) :
    availableDegreeLoss H C M e v ≤ degree (availableEdges H C M) v :=
  Nat.sub_le _ _

namespace CFMRegularization

attribute [local instance] Classical.propDecidable

noncomputable section

/-- Currently available two-conflict neighbours of `e`. -/
def availableTwoConflictBlockers (A H : Hypergraph V)
    (C : ConflictSystem V) (e : Finset V) : Hypergraph V :=
  A ∩ twoConflictNeighbors H C e

def availableMeetingChoices (A : Hypergraph V) (S : Finset V) : Hypergraph V :=
  A.filter fun g ↦ ¬Disjoint g S

def firstOrderBlockerChoices (A H : Hypergraph V)
    (C : ConflictSystem V) (e : Finset V) : Hypergraph V :=
  availableMeetingChoices A e ∪ availableTwoConflictBlockers A H C e

@[simp] theorem mem_availableTwoConflictBlockers
    {A H : Hypergraph V} {C : ConflictSystem V} {e g : Finset V} :
    g ∈ availableTwoConflictBlockers A H C e ↔
      g ∈ A ∧ g ∈ H ∧ g ≠ e ∧ {e, g} ∈ conflictLayer C 2 := by
  simp [availableTwoConflictBlockers, twoConflictNeighbors]

theorem IsRegularizedBounded.conditionC4_upper
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hC : IsRegularizedBounded H C d Gamma eta)
    {e : Finset V} (he : e ∈ H) (v : V) :
    (conditionC4Count H C e v : ℝ) ≤ Real.rpow d (1 - eta) :=
  hC.2.2.2.2.1 e he v

theorem IsRegularizedBounded.conditionC5_upper
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hC : IsRegularizedBounded H C d Gamma eta)
    {e f : Finset V} (he : e ∈ H) (hf : f ∈ H)
    (hef : Disjoint e f) :
    (conditionC5Count H C e f : ℝ) ≤ Real.rpow d (1 - eta) :=
  hC.2.2.2.2.2 e he f hf hef

theorem card_availableTwoConflictBlockers_through_vertex_le_C4
    (A H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (v : V) :
    ((availableTwoConflictBlockers A H C e).filter fun g ↦ v ∈ g).card ≤
      conditionC4Count H C e v := by
  apply Finset.card_le_card
  intro g hg
  simp only [Finset.mem_filter] at hg ⊢
  exact ⟨Finset.inter_subset_right hg.1, hg.2⟩

/-- Charge every two-conflict blocker meeting `S` to one common vertex. -/
theorem card_availableTwoConflictBlockers_meeting_le_sum_C4
    (A H : Hypergraph V) (C : ConflictSystem V)
    (e S : Finset V) :
    ((availableTwoConflictBlockers A H C e).filter
        fun g ↦ ¬Disjoint g S).card ≤
      ∑ v ∈ S, conditionC4Count H C e v := by
  let F : Hypergraph V :=
    (availableTwoConflictBlockers A H C e).filter fun g ↦ ¬Disjoint g S
  let star : V → Hypergraph V := fun v ↦
    (twoConflictNeighbors H C e).filter fun g ↦ v ∈ g
  have hsubset : F ⊆ S.biUnion star := by
    intro g hg
    have hg' := Finset.mem_filter.mp hg
    obtain ⟨v, hvg, hvS⟩ := Finset.not_disjoint_iff.mp hg'.2
    exact Finset.mem_biUnion.mpr
      ⟨v, hvS, Finset.mem_filter.mpr
        ⟨Finset.inter_subset_right hg'.1, hvg⟩⟩
  calc
    F.card ≤ (S.biUnion star).card := Finset.card_le_card hsubset
    _ ≤ ∑ v ∈ S, (star v).card := Finset.card_biUnion_le
    _ = ∑ v ∈ S, conditionC4Count H C e v := by rfl

/-- Inclusion--exclusion with the exact C4 overlap error. -/
theorem sum_card_le_card_firstOrderBlockerChoices_add_sum_C4
    (A H : Hypergraph V) (C : ConflictSystem V) (e : Finset V) :
    (availableMeetingChoices A e).card +
        (availableTwoConflictBlockers A H C e).card ≤
      (firstOrderBlockerChoices A H C e).card +
        ∑ v ∈ e, conditionC4Count H C e v := by
  have hinter :
      ((availableMeetingChoices A e) ∩
        availableTwoConflictBlockers A H C e).card ≤
          ∑ v ∈ e, conditionC4Count H C e v := by
    rw [show
      (availableMeetingChoices A e) ∩
          availableTwoConflictBlockers A H C e =
        (availableTwoConflictBlockers A H C e).filter
          (fun g ↦ ¬Disjoint g e) by
      ext g
      simp [availableMeetingChoices, availableTwoConflictBlockers,
        and_left_comm, and_assoc, and_comm]]
    exact card_availableTwoConflictBlockers_meeting_le_sum_C4 A H C e e
  have hIE := Finset.card_union_add_card_inter
    (availableMeetingChoices A e) (availableTwoConflictBlockers A H C e)
  change
    (firstOrderBlockerChoices A H C e).card +
        ((availableMeetingChoices A e) ∩
          availableTwoConflictBlockers A H C e).card =
      (availableMeetingChoices A e).card +
        (availableTwoConflictBlockers A H C e).card at hIE
  omega

theorem card_firstOrderBlockerChoices_le_sum_card
    (A H : Hypergraph V) (C : ConflictSystem V) (e : Finset V) :
    (firstOrderBlockerChoices A H C e).card ≤
      (availableMeetingChoices A e).card +
        (availableTwoConflictBlockers A H C e).card :=
  Finset.card_union_le _ _

theorem IsRegularizedBounded.availableTwoConflictBlockers_meeting_upper
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hC : IsRegularizedBounded H C d Gamma eta)
    (A : Hypergraph V) {e : Finset V} (he : e ∈ H) (S : Finset V) :
    (((availableTwoConflictBlockers A H C e).filter
        fun g ↦ ¬Disjoint g S).card : ℝ) ≤
      (S.card : ℝ) * Real.rpow d (1 - eta) := by
  calc
    (((availableTwoConflictBlockers A H C e).filter
        fun g ↦ ¬Disjoint g S).card : ℝ) ≤
        (∑ v ∈ S, conditionC4Count H C e v : ℕ) := by
      exact_mod_cast
        card_availableTwoConflictBlockers_meeting_le_sum_C4 A H C e S
    _ = ∑ v ∈ S, (conditionC4Count H C e v : ℝ) := by norm_cast
    _ ≤ ∑ _v ∈ S, Real.rpow d (1 - eta) := by
      apply Finset.sum_le_sum
      intro v hv
      exact hC.conditionC4_upper he v
    _ = (S.card : ℝ) * Real.rpow d (1 - eta) := by simp

theorem card_common_availableTwoConflictBlockers_le_C5
    (A H : Hypergraph V) (C : ConflictSystem V) (e f : Finset V) :
    ((availableTwoConflictBlockers A H C e) ∩
      availableTwoConflictBlockers A H C f).card ≤
      conditionC5Count H C e f := by
  apply Finset.card_le_card
  intro g hg
  rw [Finset.mem_inter] at hg ⊢
  exact ⟨Finset.inter_subset_right hg.1, Finset.inter_subset_right hg.2⟩

theorem IsRegularizedBounded.common_availableTwoConflictBlockers_upper
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hC : IsRegularizedBounded H C d Gamma eta)
    (A : Hypergraph V) {e f : Finset V}
    (he : e ∈ H) (hf : f ∈ H) (hef : Disjoint e f) :
    (((availableTwoConflictBlockers A H C e) ∩
      availableTwoConflictBlockers A H C f).card : ℝ) ≤
      Real.rpow d (1 - eta) := by
  calc
    (((availableTwoConflictBlockers A H C e) ∩
      availableTwoConflictBlockers A H C f).card : ℝ) ≤
        conditionC5Count H C e f := by
      exact_mod_cast card_common_availableTwoConflictBlockers_le_C5 A H C e f
    _ ≤ Real.rpow d (1 - eta) := hC.conditionC5_upper he hf hef

end

end CFMRegularization

/-! ## Incidence identities for the conflict-free core -/

/-- Double-count incidences between a finite vertex set and the edges of a
finite hypergraph. -/
theorem sum_degree_on_eq_sum_card_inter [Fintype V]
    (H : Hypergraph V) (S : Finset V) :
    ∑ v ∈ S, degree H v = ∑ e ∈ H, (S ∩ e).card := by
  classical
  calc
    ∑ v ∈ S, degree H v =
        ∑ v ∈ S, ∑ e ∈ H, if v ∈ e then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro v hv
      rw [degree, Finset.card_filter]
    _ = ∑ e ∈ H, ∑ v ∈ S, if v ∈ e then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ e ∈ H, (S ∩ e).card := by
      apply Finset.sum_congr rfl
      intro e he
      rw [show S ∩ e = S.filter (fun v => v ∈ e) by
        ext v
        simp]
      rw [Finset.card_filter]

/-- The hypergraph handshake identity. -/
theorem sum_degree_eq_sum_edge_card [Fintype V] (H : Hypergraph V) :
    ∑ v, degree H v = ∑ e ∈ H, e.card := by
  simpa using sum_degree_on_eq_sum_card_inter H (Finset.univ : Finset V)

theorem sum_degree_eq_uniform_mul_card [Fintype V]
    {H : Hypergraph V} {r : ℕ} (hH : IsUniform H r) :
    ∑ v, degree H v = r * H.card := by
  rw [sum_degree_eq_sum_edge_card]
  calc
    ∑ e ∈ H, e.card = ∑ _e ∈ H, r := by
      apply Finset.sum_congr rfl
      intro e he
      exact hH e he
    _ = r * H.card := by simp [mul_comm]

/-- Handshake identity over the actual vertex set rather than an ambient
finite type which may contain isolated labels. -/
theorem sum_degree_vertexFinset_eq_sum_edge_card [Fintype V]
    (H : Hypergraph V) :
    ∑ v ∈ vertexFinset H, degree H v = ∑ e ∈ H, e.card := by
  rw [sum_degree_on_eq_sum_card_inter]
  apply Finset.sum_congr rfl
  intro e he
  congr 1
  apply Finset.inter_eq_right.mpr
  exact edge_subset_vertexFinset he

theorem sum_degree_vertexFinset_eq_uniform_mul_card [Fintype V]
    {H : Hypergraph V} {r : ℕ} (hH : IsUniform H r) :
    ∑ v ∈ vertexFinset H, degree H v = r * H.card := by
  rw [sum_degree_vertexFinset_eq_sum_edge_card]
  calc
    ∑ e ∈ H, e.card = ∑ _e ∈ H, r := by
      apply Finset.sum_congr rfl
      intro e he
      exact hH e he
    _ = r * H.card := by simp [mul_comm]

/-- Host vertices not yet covered by the selected matching. -/
def uncoveredVertices (H M : Hypergraph V) : Finset V :=
  vertexFinset H \ vertexFinset M

@[simp] theorem mem_uncoveredVertices {H M : Hypergraph V} {v : V} :
    v ∈ uncoveredVertices H M ↔ v ∈ vertexFinset H ∧ v ∉ vertexFinset M := by
  simp [uncoveredVertices]

theorem mem_uncoveredVertices_insert_iff
    {H M : Hypergraph V} {e : Finset V} {v : V}
    (hv : v ∈ uncoveredVertices H M) :
    v ∈ uncoveredVertices H (insert e M) ↔ v ∉ e := by
  rw [mem_uncoveredVertices] at hv ⊢
  simp only [vertexFinset, Finset.biUnion_insert, Finset.mem_union,
    not_or]
  exact ⟨fun h ↦ h.2.1, fun hve ↦ ⟨hv.1, hve, hv.2⟩⟩

theorem not_mem_uncoveredVertices_insert
    {H M : Hypergraph V} {e : Finset V} {v : V}
    (hv : v ∉ uncoveredVertices H M) :
    v ∉ uncoveredVertices H (insert e M) := by
  rw [mem_uncoveredVertices] at hv ⊢
  intro hnext
  apply hv
  refine ⟨hnext.1, ?_⟩
  intro hvM
  apply hnext.2
  exact mem_vertexFinset.mpr
    (let ⟨f, hfM, hvf⟩ := mem_vertexFinset.mp hvM
     ⟨f, Finset.mem_insert_of_mem hfM, hvf⟩)

/-- Every vertex of a currently available edge is uncovered. -/
theorem vertexFinset_availableEdges_subset_uncovered
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) :
    vertexFinset (availableEdges H C M) ⊆ uncoveredVertices H M := by
  intro v hv
  obtain ⟨e, heA, hve⟩ := mem_vertexFinset.mp hv
  apply mem_uncoveredVertices.mpr
  refine ⟨mem_vertexFinset.mpr
    ⟨e, (mem_availableEdges.mp heA).1, hve⟩, ?_⟩
  intro hvM
  obtain ⟨f, hfM, hvf⟩ := mem_vertexFinset.mp hvM
  have heData := mem_availableEdges.mp heA
  have hef : e ≠ f := by
    intro hef
    subst e
    exact heData.2.1 hfM
  have hdisj := heData.2.2.1.2
    (Finset.mem_insert_self e M) (Finset.mem_insert_of_mem hfM) hef
  exact Finset.disjoint_left.mp hdisj hve hvf

/-- An eight-uniform matching covers exactly eight vertices per selected
edge, so the executable process has the expected number of uncovered host
vertices at every state. -/
theorem card_uncoveredVertices_of_uniform_matching
    {H M : Hypergraph V} {r : ℕ}
    (hH : IsUniform H r) (hM : IsMatching H M) :
    (uncoveredVertices H M).card = (vertexFinset H).card - r * M.card := by
  rw [uncoveredVertices, Finset.card_sdiff_of_subset
    (vertexFinset_mono hM.1),
    card_vertexFinset_eq_of_pairwiseDisjoint_uniform hM.2 (hH.mono hM.1)]

/-- Handshake over precisely the uncovered host vertices. -/
theorem sum_degree_uncoveredVertices_eq_uniform_mul_card [Fintype V]
    {H A M : Hypergraph V} {r : ℕ}
    (hA : A ⊆ H) (hdisj : vertexFinset A ⊆ uncoveredVertices H M)
    (hunif : IsUniform A r) :
    ∑ v ∈ uncoveredVertices H M, degree A v = r * A.card := by
  rw [sum_degree_on_eq_sum_card_inter]
  calc
    ∑ e ∈ A, (uncoveredVertices H M ∩ e).card =
        ∑ _e ∈ A, r := by
      apply Finset.sum_congr rfl
      intro e he
      rw [Finset.inter_eq_right.mpr]
      · exact hunif e he
      · intro v hve
        exact hdisj (mem_vertexFinset.mpr ⟨e, he, hve⟩)
    _ = r * A.card := by simp [mul_comm]

/-- Simultaneous degree corridor on the uncovered host vertices. -/
def AvailableDegreeWithin (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (lo hi : ℝ) : Prop :=
  ∀ v ∈ uncoveredVertices H M,
    lo ≤ (degree (availableEdges H C M) v : ℝ) ∧
      (degree (availableEdges H C M) v : ℝ) ≤ hi

/-- The degree corridor determines the available-edge count up to the same
relative error, using the exact eight-uniform handshake identity. -/
theorem availableEdges_card_bounds_of_degreeWithin [Fintype V]
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {lo hi : ℝ}
    (hH : IsUniform H 8) (htrack : AvailableDegreeWithin H C M lo hi) :
    ((uncoveredVertices H M).card : ℝ) * lo ≤
        8 * ((availableEdges H C M).card : ℝ) ∧
      8 * ((availableEdges H C M).card : ℝ) ≤
        ((uncoveredVertices H M).card : ℝ) * hi := by
  let A := availableEdges H C M
  have hsumNat : ∑ v ∈ uncoveredVertices H M, degree A v =
      8 * A.card :=
    sum_degree_uncoveredVertices_eq_uniform_mul_card
      (availableEdges_subset H C M)
      (vertexFinset_availableEdges_subset_uncovered H C M)
      (availableEdges_uniform hH C M)
  have hsum : ∑ v ∈ uncoveredVertices H M, (degree A v : ℝ) =
      8 * (A.card : ℝ) := by
    exact_mod_cast hsumNat
  constructor
  · rw [← hsum]
    calc
      ((uncoveredVertices H M).card : ℝ) * lo =
          ∑ _v ∈ uncoveredVertices H M, lo := by simp
      _ ≤ ∑ v ∈ uncoveredVertices H M, (degree A v : ℝ) := by
        apply Finset.sum_le_sum
        intro v hv
        exact (htrack v hv).1
  · rw [← hsum]
    calc
      (∑ v ∈ uncoveredVertices H M, (degree A v : ℝ)) ≤
          ∑ _v ∈ uncoveredVertices H M, hi := by
        apply Finset.sum_le_sum
        intro v hv
        exact (htrack v hv).2
      _ = ((uncoveredVertices H M).card : ℝ) * hi := by simp

/-- Available edges remaining after deleting every edge which meets `e`. -/
def disjointResidual (A : Hypergraph V) (e : Finset V) : Hypergraph V :=
  A.filter fun f => Disjoint f e

/-- Number of edges through `v` deleted when `e` is chosen. -/
def lostDegree (A : Hypergraph V) (e : Finset V) (v : V) : ℕ :=
  ((A.filter fun f => v ∈ f).filter fun f => ¬Disjoint f e).card

/-- Choosing `e` partitions the old `v`-degree into the residual degree and
the deleted degree. -/
theorem degree_disjointResidual_add_lostDegree
    (A : Hypergraph V) (e : Finset V) (v : V) :
    degree (disjointResidual A e) v + lostDegree A e v = degree A v := by
  classical
  rw [degree, disjointResidual, lostDegree, degree]
  rw [Finset.filter_filter]
  have hcomm :
      (A.filter fun a => Disjoint a e ∧ v ∈ a) =
        (A.filter fun a => v ∈ a).filter fun a => Disjoint a e := by
    ext a
    simp [and_comm, and_assoc]
  rw [hcomm]
  exact Finset.card_filter_add_card_filter_not
    (s := A.filter fun a => v ∈ a) (fun a => Disjoint a e)

theorem lostDegree_le_degree (A : Hypergraph V) (e : Finset V) (v : V) :
    lostDegree A e v ≤ degree A v := by
  have h := degree_disjointResidual_add_lostDegree A e v
  omega

theorem degree_disjointResidual_le (A : Hypergraph V)
    (e : Finset V) (v : V) :
    degree (disjointResidual A e) v ≤ degree A v := by
  have h := degree_disjointResidual_add_lostDegree A e v
  omega

/-- An edge selected from `A` deletes every `A`-edge through each one of its
own vertices. -/
theorem degree_le_lostDegree_of_mem
    {A : Hypergraph V} {e : Finset V} {v : V}
    (hv : v ∈ e) :
    degree A v ≤ lostDegree A e v := by
  rw [degree, lostDegree]
  apply Finset.card_le_card
  intro f hf
  simp only [Finset.mem_filter] at hf ⊢
  refine ⟨hf, ?_⟩
  intro hdisj
  exact Finset.disjoint_left.mp hdisj hf.2 hv

theorem lostDegree_eq_degree_of_mem
    {A : Hypergraph V} {e : Finset V} {v : V}
    (hv : v ∈ e) :
    lostDegree A e v = degree A v :=
  Nat.le_antisymm (lostDegree_le_degree A e v)
    (degree_le_lostDegree_of_mem hv)

/-- Loss through `v` on the event that the selected edge misses `v`.  This
is the `Q_e` count in the source random-greedy proof. -/
def missLostDegree (A : Hypergraph V) (e : Finset V) (v : V) : ℕ :=
  if v ∈ e then 0 else lostDegree A e v

@[simp] theorem missLostDegree_eq_zero_of_mem
    (A : Hypergraph V) {e : Finset V} {v : V} (hv : v ∈ e) :
    missLostDegree A e v = 0 := by
  simp [missLostDegree, hv]

theorem missLostDegree_eq_lostDegree_of_notMem
    (A : Hypergraph V) {e : Finset V} {v : V} (hv : v ∉ e) :
    missLostDegree A e v = lostDegree A e v := by
  simp [missLostDegree, hv]

/-- Split total deletion at `v` into direct hits of `v` and losses on the
event that `v` survives. -/
theorem sum_lostDegree_eq_sq_add_sum_miss
    (A : Hypergraph V) (v : V) :
    ∑ e ∈ A, lostDegree A e v =
      degree A v ^ 2 + ∑ e ∈ A.filter (v ∉ ·), missLostDegree A e v := by
  classical
  calc
    ∑ e ∈ A, lostDegree A e v =
        (∑ e ∈ A.filter (v ∈ ·), lostDegree A e v) +
          ∑ e ∈ A.filter (v ∉ ·), lostDegree A e v :=
      (Finset.sum_filter_add_sum_filter_not A (fun e => v ∈ e)
        (fun e => lostDegree A e v)).symm
    _ = degree A v ^ 2 +
          ∑ e ∈ A.filter (v ∉ ·), missLostDegree A e v := by
      congr 1
      · calc
          ∑ e ∈ A.filter (v ∈ ·), lostDegree A e v =
              (A.filter (v ∈ ·)).card * degree A v := by
            apply Finset.sum_const_nat
            intro e he
            exact lostDegree_eq_degree_of_mem (Finset.mem_filter.mp he).2
          _ = degree A v ^ 2 := by
            rw [show (A.filter (v ∈ ·)).card = degree A v by rfl]
            simp [pow_two]
      · apply Finset.sum_congr rfl
        intro e he
        exact (missLostDegree_eq_lostDegree_of_notMem A
          (Finset.mem_filter.mp he).2).symm

/-- A miss-loss is covered by the union of the pair-codegree families
through the vertices of the selected edge. -/
theorem missLostDegree_le_sum_codegree
    (A : Hypergraph V) {e : Finset V} {v : V} (hve : v ∉ e) :
    missLostDegree A e v ≤ ∑ x ∈ e, codegree A {v, x} := by
  classical
  rw [missLostDegree_eq_lostDegree_of_notMem A hve, lostDegree]
  let pairFamily : V → Hypergraph V := fun x =>
    A.filter fun f => {v, x} ⊆ f
  calc
    ((A.filter fun f => v ∈ f).filter fun f => ¬Disjoint f e).card ≤
        (e.biUnion pairFamily).card := by
      apply Finset.card_le_card
      intro f hf
      simp only [Finset.mem_filter] at hf
      obtain ⟨x, hxf, hxe⟩ := Finset.not_disjoint_iff.mp hf.2
      apply Finset.mem_biUnion.mpr
      refine ⟨x, hxe, ?_⟩
      simp only [pairFamily, Finset.mem_filter]
      refine ⟨hf.1.1, ?_⟩
      simp only [Finset.insert_subset_iff, Finset.singleton_subset_iff]
      exact ⟨hf.1.2, hxf⟩
    _ ≤ ∑ x ∈ e, (pairFamily x).card := Finset.card_biUnion_le
    _ = ∑ x ∈ e, codegree A {v, x} := by
      apply Finset.sum_congr rfl
      intro x hx
      rfl

theorem missLostDegree_le_card_mul
    (A : Hypergraph V) {e : Finset V} {v : V} {D : ℕ}
    (hve : v ∉ e) (hco : ∀ x ∈ e, codegree A {v, x} ≤ D) :
    missLostDegree A e v ≤ e.card * D := by
  calc
    missLostDegree A e v ≤ ∑ x ∈ e, codegree A {v, x} :=
      missLostDegree_le_sum_codegree A hve
    _ ≤ ∑ _x ∈ e, D := Finset.sum_le_sum hco
    _ = e.card * D := by simp

/-- In an `r`-uniform hypergraph with pair codegree at most `D`, a selected
edge missing `v` destroys at most `rD` edges through `v`. -/
theorem missLostDegree_le_of_uniform_codegree
    {A : Hypergraph V} {r D : ℕ} (hA : IsUniform A r)
    (hco : MaxCodegreeLE A 2 D) {e : Finset V} (he : e ∈ A)
    {v : V} (hve : v ∉ e) :
    missLostDegree A e v ≤ r * D := by
  rw [← hA e he]
  apply missLostDegree_le_card_mul A hve
  intro x hxe
  apply hco {v, x}
  have hxv : x ≠ v := by
    intro hx
    exact hve (hx ▸ hxe)
  simp [hxv.symm]

theorem missLostDegree_available_le
    {H : Hypergraph V} {r D : ℕ} (hH : IsUniform H r)
    (hco : MaxCodegreeLE H 2 D) (C : ConflictSystem V)
    (M : Hypergraph V) {e : Finset V}
    (he : e ∈ availableEdges H C M) {v : V} (hve : v ∉ e) :
    missLostDegree (availableEdges H C M) e v ≤ r * D := by
  apply missLostDegree_le_of_uniform_codegree
    (availableEdges_uniform hH C M)
    (availableEdges_maxCodegreeLE hco C M) he hve

/-- Swap the two incidences in the total miss-loss. -/
theorem sum_missLostDegree_swap (A : Hypergraph V) (v : V) :
    ∑ e ∈ A, missLostDegree A e v =
      ∑ f ∈ A.filter (v ∈ ·),
        ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card := by
  let g : Finset V → Finset V → ℕ := fun e f ↦
    if v ∈ e then 0 else if v ∈ f then
      if ¬Disjoint f e then 1 else 0 else 0
  have hmiss (e : Finset V) :
      missLostDegree A e v = ∑ f ∈ A, g e f := by
    simp [g, missLostDegree, lostDegree, Finset.card_filter,
      Finset.sum_filter]
  have hfiber (f : Finset V) :
      ∑ e ∈ A, g e f =
        if v ∈ f then
          ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card
        else 0 := by
    by_cases hvf : v ∈ f
    · simp [g, hvf, Finset.card_filter, Finset.sum_filter]
    · simp [g, hvf]
  calc
    ∑ e ∈ A, missLostDegree A e v =
        ∑ e ∈ A, ∑ f ∈ A, g e f := by
          apply Finset.sum_congr rfl
          intro e _
          exact hmiss e
    _ = ∑ f ∈ A, ∑ e ∈ A, g e f := Finset.sum_comm
    _ = ∑ f ∈ A, if v ∈ f then
          ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card
        else 0 := by
          apply Finset.sum_congr rfl
          intro f _
          exact hfiber f
    _ = ∑ f ∈ A.filter (v ∈ ·),
          ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card := by
          rw [Finset.sum_filter]

/-- Second Bonferroni inequality for a finite union, in the uniform
pair-overlap form used by the eight-uniform degree drift. -/
theorem sum_card_le_card_biUnion_add_choose_two_mul
    {iota alpha : Type*} [DecidableEq iota] [DecidableEq alpha]
    (S : Finset iota) (F : iota → Finset alpha) (L : ℕ)
    (hpair : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → (F x ∩ F y).card ≤ L) :
    ∑ x ∈ S, (F x).card ≤
      (S.biUnion F).card + S.card.choose 2 * L := by
  induction S using Finset.induction_on with
  | empty => simp
  | @insert a S ha ih =>
      have hpairS : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → (F x ∩ F y).card ≤ L := by
        intro x hx y hy hxy
        exact hpair x (Finset.mem_insert_of_mem hx) y
          (Finset.mem_insert_of_mem hy) hxy
      have hIH := ih hpairS
      let U := S.biUnion F
      have hsub : F a ∩ U ⊆ S.biUnion (fun y ↦ F a ∩ F y) := by
        intro z hz
        obtain ⟨hza, hzU⟩ := Finset.mem_inter.mp hz
        obtain ⟨y, hyS, hzy⟩ := Finset.mem_biUnion.mp hzU
        exact Finset.mem_biUnion.mpr
          ⟨y, hyS, Finset.mem_inter.mpr ⟨hza, hzy⟩⟩
      have hInter : (F a ∩ U).card ≤ S.card * L := by
        calc
          (F a ∩ U).card ≤ (S.biUnion (fun y ↦ F a ∩ F y)).card :=
            Finset.card_le_card hsub
          _ ≤ ∑ y ∈ S, (F a ∩ F y).card := Finset.card_biUnion_le
          _ ≤ ∑ _y ∈ S, L := by
            apply Finset.sum_le_sum
            intro y hy
            apply hpair a (Finset.mem_insert_self a S) y
              (Finset.mem_insert_of_mem hy)
            intro hay
            subst y
            exact ha hy
          _ = S.card * L := by simp
      have hUnion : (F a ∪ U).card + (F a ∩ U).card =
          (F a).card + U.card := Finset.card_union_add_card_inter _ _
      have hFU : (F a).card + U.card ≤ (F a ∪ U).card + S.card * L := by
        omega
      have hchoose : (S.card + 1).choose 2 = S.card.choose 2 + S.card := by
        simpa [Nat.choose_succ_succ, Nat.choose_one_right, Nat.add_comm]
          using Nat.choose_succ_succ S.card 1
      simp only [Finset.sum_insert ha, Finset.biUnion_insert,
        Finset.card_insert_of_notMem ha, hchoose, Nat.add_mul]
      change (F a).card + ∑ x ∈ S, (F x).card ≤
        (F a ∪ U).card + (S.card.choose 2 * L + S.card * L)
      change (∑ x ∈ S, (F x).card) ≤
        U.card + S.card.choose 2 * L at hIH
      calc
        (F a).card + ∑ x ∈ S, (F x).card ≤
            (F a).card + (U.card + S.card.choose 2 * L) :=
          Nat.add_le_add_left hIH _
        _ = ((F a).card + U.card) + S.card.choose 2 * L := by omega
        _ ≤ ((F a ∪ U).card + S.card * L) + S.card.choose 2 * L :=
          Nat.add_le_add_right hFU _
        _ = (F a ∪ U).card +
            (S.card.choose 2 * L + S.card * L) := by omega

theorem missLossFiber_bounds_eight_uniform
    {A : Hypergraph V} (hA : IsUniform A 8)
    {Dlo Dhi L : ℕ}
    (hdeglo : ∀ x e, e ∈ A → x ∈ e → Dlo ≤ degree A x)
    (hdeghi : ∀ x e, e ∈ A → x ∈ e → degree A x ≤ Dhi)
    (hco : MaxCodegreeLE A 2 L)
    {f : Finset V} (hfA : f ∈ A) {v : V} (hvf : v ∈ f) :
    7 * Dlo - 28 * L ≤
        ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card ∧
      ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card ≤
        7 * Dhi := by
  let S := f.erase v
  let F : V → Hypergraph V := fun x ↦
    (A.filter (x ∈ ·)).filter (v ∉ ·)
  let B : Hypergraph V :=
    (A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)
  have hScard : S.card = 7 := by
    rw [Finset.card_erase_of_mem hvf, hA f hfA]
  have hUnion : S.biUnion F = B := by
    ext e
    constructor
    · intro he
      obtain ⟨x, hxS, hxe⟩ := Finset.mem_biUnion.mp he
      have hxS' := Finset.mem_erase.mp hxS
      have hxe' := Finset.mem_filter.mp hxe
      have hxe'' := Finset.mem_filter.mp hxe'.1
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_filter.mpr ⟨hxe''.1, hxe'.2⟩, ?_⟩
      exact Finset.not_disjoint_iff.mpr ⟨x, hxS'.2, hxe''.2⟩
    · intro he
      have he' := Finset.mem_filter.mp he
      have heA : e ∈ A := (Finset.mem_filter.mp he'.1).1
      have hve : v ∉ e := (Finset.mem_filter.mp he'.1).2
      obtain ⟨x, hxf, hxe⟩ := Finset.not_disjoint_iff.mp he'.2
      have hxv : x ≠ v := by
        intro hxv
        exact hve (hxv ▸ hxe)
      apply Finset.mem_biUnion.mpr
      refine ⟨x, Finset.mem_erase.mpr ⟨hxv, hxf⟩, ?_⟩
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_filter.mpr ⟨heA, hxe⟩, hve⟩
  have hFdegree (x : V) (hxS : x ∈ S) : Dlo ≤ (F x).card + L := by
    have hxS' := Finset.mem_erase.mp hxS
    have hxv : x ≠ v := hxS'.1
    have hpos :
        ((A.filter (x ∈ ·)).filter (v ∈ ·)).card = codegree A {v, x} := by
      congr 1
      ext e
      simp only [Finset.mem_filter, Finset.insert_subset_iff,
        Finset.singleton_subset_iff]
      aesop
    have hpart := Finset.card_filter_add_card_filter_not
      (s := A.filter (x ∈ ·)) (fun e ↦ v ∈ e)
    have hdegree : codegree A {v, x} + (F x).card = degree A x := by
      simpa only [hpos, F, degree] using hpart
    have hpaircard : ({v, x} : Finset V).card = 2 := by
      simp [hxv.symm]
    have hcodeg : codegree A {v, x} ≤ L := hco {v, x} hpaircard
    have hlow : Dlo ≤ degree A x := hdeglo x f hfA hxS'.2
    omega
  have hpairF : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → (F x ∩ F y).card ≤ L := by
    intro x hxS y hyS hxy
    calc
      (F x ∩ F y).card ≤ codegree A {x, y} := by
        apply Finset.card_le_card
        intro e he
        have he' := Finset.mem_inter.mp he
        have hex := Finset.mem_filter.mp he'.1
        have hey := Finset.mem_filter.mp he'.2
        have hex' := Finset.mem_filter.mp hex.1
        have hey' := Finset.mem_filter.mp hey.1
        simp only [codegree, Finset.mem_filter, Finset.insert_subset_iff,
          Finset.singleton_subset_iff]
        exact ⟨hex'.1, hex'.2, hey'.2⟩
      _ ≤ L := by
        apply hco {x, y}
        simp [hxy]
  have hsumF : 7 * Dlo ≤ ∑ x ∈ S, (F x).card + 7 * L := by
    calc
      7 * Dlo = ∑ _x ∈ S, Dlo := by simp [hScard]
      _ ≤ ∑ x ∈ S, ((F x).card + L) := by
        apply Finset.sum_le_sum
        intro x hxS
        exact hFdegree x hxS
      _ = (∑ x ∈ S, (F x).card) + 7 * L := by
        rw [Finset.sum_add_distrib]
        simp [hScard]
  have hbonf := sum_card_le_card_biUnion_add_choose_two_mul S F L hpairF
  have hchoose : S.card.choose 2 = 21 := by
    rw [hScard]
    norm_num [Nat.choose]
  rw [hUnion, hchoose] at hbonf
  have hlower : 7 * Dlo - 28 * L ≤ B.card := by
    omega
  have hFupper (x : V) (hxS : x ∈ S) : (F x).card ≤ Dhi := by
    have hxS' := Finset.mem_erase.mp hxS
    calc
      (F x).card ≤ degree A x := by
        apply Finset.card_le_card
        intro e he
        exact (Finset.mem_filter.mp he).1
      _ ≤ Dhi := hdeghi x f hfA hxS'.2
  have hupper : B.card ≤ 7 * Dhi := by
    rw [← hUnion]
    calc
      (S.biUnion F).card ≤ ∑ x ∈ S, (F x).card := Finset.card_biUnion_le
      _ ≤ ∑ _x ∈ S, Dhi := by
        apply Finset.sum_le_sum
        intro x hxS
        exact hFupper x hxS
      _ = 7 * Dhi := by simp [hScard]
  exact ⟨hlower, hupper⟩

/-- Exact geometric part of the source degree-drift window. -/
theorem sum_missLostDegree_bounds_eight_uniform
    {A : Hypergraph V} (hA : IsUniform A 8)
    {Dlo Dhi L : ℕ}
    (hdeglo : ∀ x e, e ∈ A → x ∈ e → Dlo ≤ degree A x)
    (hdeghi : ∀ x e, e ∈ A → x ∈ e → degree A x ≤ Dhi)
    (hco : MaxCodegreeLE A 2 L) (v : V) :
    degree A v * (7 * Dlo - 28 * L) ≤
        ∑ e ∈ A, missLostDegree A e v ∧
      (∑ e ∈ A, missLostDegree A e v) ≤ degree A v * (7 * Dhi) := by
  rw [sum_missLostDegree_swap A v]
  constructor
  · calc
      degree A v * (7 * Dlo - 28 * L) =
          ∑ _f ∈ A.filter (v ∈ ·), (7 * Dlo - 28 * L) := by
        simp [degree]
      _ ≤ ∑ f ∈ A.filter (v ∈ ·),
          ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card := by
        apply Finset.sum_le_sum
        intro f hf
        exact (missLossFiber_bounds_eight_uniform hA hdeglo hdeghi hco
          (Finset.mem_filter.mp hf).1 (Finset.mem_filter.mp hf).2).1
  · calc
      (∑ f ∈ A.filter (v ∈ ·),
          ((A.filter (v ∉ ·)).filter (fun e ↦ ¬Disjoint f e)).card) ≤
          ∑ _f ∈ A.filter (v ∈ ·), (7 * Dhi) := by
        apply Finset.sum_le_sum
        intro f hf
        exact (missLossFiber_bounds_eight_uniform hA hdeglo hdeghi hco
          (Finset.mem_filter.mp hf).1 (Finset.mem_filter.mp hf).2).2
      _ = degree A v * (7 * Dhi) := by simp [degree]

/-! ## A normalized finite transition kernel -/

/-- A raw greedy choice is either a host edge or the distinguished frozen
choice `none`. -/
abbrev GreedyChoice (H : Hypergraph V) := Option {e // e ∈ H}

/-- Sum a function over a subfamily `A` by viewing it as a supported
function on the host-edge subtype. -/
theorem sum_hostEdgeSubtype_ite {H A : Hypergraph V} (hAH : A ⊆ H)
    (f : Finset V → ℝ) :
    (∑ e : {e // e ∈ H}, if (e : Finset V) ∈ A then f e else 0) =
      ∑ e ∈ A, f e := by
  classical
  calc
    (∑ e : {e // e ∈ H}, if (e : Finset V) ∈ A then f e else 0) =
        ∑ e ∈ H, if e ∈ A then f e else 0 := by
      symm
      exact Finset.sum_subtype H (fun _ => by rfl)
        (fun e => if e ∈ A then f e else 0)
    _ = ∑ e ∈ H.filter (· ∈ A), f e := by
      exact (Finset.sum_filter (fun e => e ∈ A) f).symm
    _ = ∑ e ∈ A, f e := by
      congr 1
      ext e
      simp only [Finset.mem_filter]
      constructor
      · exact fun he => he.2
      · exact fun he => ⟨hAH he, he⟩

/-- The transition mass is uniform on the currently available edges.  If
none remain, all mass is assigned to the frozen `none` transition. -/
noncomputable def greedyTransitionMass (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (o : GreedyChoice H) : ℝ := by
  classical
  let A := availableEdges H C M
  exact if A = ∅ then
    if o = none then 1 else 0
  else
    match o with
    | none => 0
    | some e => if (e : Finset V) ∈ A then (A.card : ℝ)⁻¹ else 0

theorem greedyTransitionMass_nonneg (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (o : GreedyChoice H) :
    0 ≤ greedyTransitionMass H C M o := by
  classical
  rcases o with _ | e
  · unfold greedyTransitionMass
    split_ifs <;> positivity
  · unfold greedyTransitionMass
    split_ifs <;> positivity

/-- Every state has a probability-one next-step distribution. -/
theorem sum_greedyTransitionMass (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) :
    ∑ o : GreedyChoice H, greedyTransitionMass H C M o = 1 := by
  classical
  let A := availableEdges H C M
  have hAH : A ⊆ H := by
    intro e he
    exact (mem_availableEdges.mp he).1
  rw [Fintype.sum_option]
  by_cases hA : A = ∅
  · simp [greedyTransitionMass, A, hA]
  · have hApos : 0 < (A.card : ℝ) := by
      exact_mod_cast Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hA)
    have hsum :
        (∑ e : {e // e ∈ H},
          if (e : Finset V) ∈ A then (A.card : ℝ)⁻¹ else 0) = 1 := by
      calc
        (∑ e : {e // e ∈ H},
            if (e : Finset V) ∈ A then (A.card : ℝ)⁻¹ else 0) =
            ∑ e ∈ A, (A.card : ℝ)⁻¹ := by
              exact sum_hostEdgeSubtype_ite hAH
                (fun _ => (A.card : ℝ)⁻¹)
        _ = (A.card : ℝ) * (A.card : ℝ)⁻¹ := by simp
        _ = 1 := mul_inv_cancel₀ hApos.ne'
    simpa [greedyTransitionMass, A, hA] using hsum

/-- The ordinary matching available set, with no conflict deletions. -/
def matchingAvailable (H M : Hypergraph V) : Hypergraph V :=
  H.filter fun e => ∀ f ∈ M, Disjoint e f

@[simp] theorem mem_matchingAvailable {H M : Hypergraph V} {e : Finset V} :
    e ∈ matchingAvailable H M ↔
      e ∈ H ∧ ∀ f ∈ M, Disjoint e f := by
  simp [matchingAvailable]

theorem matchingAvailable_insert (H M : Hypergraph V) (e : Finset V) :
    matchingAvailable H (insert e M) =
      disjointResidual (matchingAvailable H M) e := by
  ext f
  simp only [mem_matchingAvailable, Finset.mem_insert, disjointResidual,
    Finset.mem_filter]
  constructor
  · rintro ⟨hfH, hdisj⟩
    exact ⟨⟨hfH, fun g hg => hdisj g (Or.inr hg)⟩, hdisj e (Or.inl rfl)⟩
  · rintro ⟨⟨hfH, hdisj⟩, hfe⟩
    refine ⟨hfH, ?_⟩
    intro g hg
    rcases hg with rfl | hg
    · exact hfe
    · exact hdisj g hg

/-- In the empty-conflict process, the executable available set agrees with
the usual set of host edges disjoint from the current matching. -/
theorem availableEdges_empty_eq_matchingAvailable
    {H M : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hM : IsMatching H M) :
    availableEdges H (∅ : ConflictSystem V) M = matchingAvailable H M := by
  ext e
  rw [mem_availableEdges, mem_matchingAvailable]
  constructor
  · rintro ⟨heH, heM, hins⟩
    refine ⟨heH, ?_⟩
    intro f hf
    have hne : f ≠ e := by
      intro hfe
      exact heM (hfe ▸ hf)
    exact (isMatching_insert_iff.mp hins.1).2.2 f hf hne
  · rintro ⟨heH, hdisj⟩
    have heM : e ∉ M := by
      intro hem
      obtain ⟨v, hv⟩ := hHnonempty e heH
      exact Finset.disjoint_left.mp (hdisj e hem) hv hv
    refine ⟨heH, heM, ?_, ?_⟩
    · exact isMatching_insert_iff.mpr
        ⟨heH, hM, fun f hf _hne => hdisj f hf⟩
    · simp [ConflictFree]

theorem availableEdges_empty_insert
    {H M : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hM : IsMatching H M) {e : Finset V}
    (he : e ∈ matchingAvailable H M) :
    availableEdges H (∅ : ConflictSystem V) (insert e M) =
      disjointResidual (availableEdges H (∅ : ConflictSystem V) M) e := by
  have hMe : IsMatching H (insert e M) := by
    apply isMatching_insert_iff.mpr
    exact ⟨(mem_matchingAvailable.mp he).1, hM,
      fun f hf _ => (mem_matchingAvailable.mp he).2 f hf⟩
  rw [availableEdges_empty_eq_matchingAvailable hHnonempty hMe,
    availableEdges_empty_eq_matchingAvailable hHnonempty hM,
    matchingAvailable_insert]

/-- Apply a raw kernel choice to a matching state. -/
noncomputable def greedyChoiceStep (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) : GreedyChoice H → Hypergraph V
  | none => M
  | some e => greedyStep H C M e

theorem greedyChoiceStep_preserves {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} (hM : IsConflictFreeMatching H C M)
    (o : GreedyChoice H) :
    IsConflictFreeMatching H C (greedyChoiceStep H C M o) := by
  rcases o with _ | e
  · exact hM
  · exact greedyStep_preserves hM e

/-- Conditional one-step expectation under the uniform available-edge
kernel. -/
noncomputable def greedyStepExpectation (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) : ℝ :=
  ∑ o : GreedyChoice H,
    greedyTransitionMass H C M o * X (greedyChoiceStep H C M o)

theorem greedyStepExpectation_const (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (x : ℝ) :
    greedyStepExpectation H C M (fun _ => x) = x := by
  rw [greedyStepExpectation]
  calc
    (∑ o : GreedyChoice H, greedyTransitionMass H C M o * x) =
        (∑ o : GreedyChoice H, greedyTransitionMass H C M o) * x := by
      rw [Finset.sum_mul]
    _ = 1 * x := by rw [sum_greedyTransitionMass]
    _ = x := one_mul x

theorem greedyStepExpectation_nonneg (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    {X : Hypergraph V → ℝ} (hX : ∀ N, 0 ≤ X N) :
    0 ≤ greedyStepExpectation H C M X := by
  apply Finset.sum_nonneg
  intro o ho
  exact mul_nonneg (greedyTransitionMass_nonneg H C M o)
    (hX (greedyChoiceStep H C M o))

theorem greedyStepExpectation_mono (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    {X Y : Hypergraph V → ℝ} (hXY : ∀ N, X N ≤ Y N) :
    greedyStepExpectation H C M X ≤ greedyStepExpectation H C M Y := by
  rw [greedyStepExpectation, greedyStepExpectation]
  apply Finset.sum_le_sum
  intro o ho
  exact mul_le_mul_of_nonneg_left
    (hXY (greedyChoiceStep H C M o))
    (greedyTransitionMass_nonneg H C M o)

theorem greedyStepExpectation_le_const_of_choices (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) (b : ℝ)
    (hX : ∀ o : GreedyChoice H, X (greedyChoiceStep H C M o) ≤ b) :
    greedyStepExpectation H C M X ≤ b := by
  calc
    greedyStepExpectation H C M X ≤
        greedyStepExpectation H C M (fun _ ↦ b) := by
      rw [greedyStepExpectation, greedyStepExpectation]
      apply Finset.sum_le_sum
      intro o ho
      exact mul_le_mul_of_nonneg_left (hX o)
        (greedyTransitionMass_nonneg H C M o)
    _ = b := greedyStepExpectation_const H C M b

/-- A length-`T` finite tape of raw greedy choices. -/
abbrev GreedyOutcome (H : Hypergraph V) (T : ℕ) :=
  Fin T → GreedyChoice H

/-- Read a tape coordinate, using the frozen choice past the end. -/
def greedyChoiceAt {H : Hypergraph V} {T : ℕ}
    (ω : GreedyOutcome H T) (k : ℕ) : GreedyChoice H :=
  if hk : k < T then ω ⟨k, hk⟩ else none

/-- State after the first `k` coordinates of a finite tape. -/
noncomputable def greedyStateAt (H : Hypergraph V) (C : ConflictSystem V)
    {T : ℕ} (ω : GreedyOutcome H T) : ℕ → Hypergraph V
  | 0 => ∅
  | k + 1 => greedyChoiceStep H C (greedyStateAt H C ω k) (greedyChoiceAt ω k)

@[simp] theorem greedyStateAt_zero (H : Hypergraph V) (C : ConflictSystem V)
    {T : ℕ} (ω : GreedyOutcome H T) :
    greedyStateAt H C ω 0 = ∅ := rfl

theorem greedyStateAt_succ (H : Hypergraph V) (C : ConflictSystem V)
    {T : ℕ} (ω : GreedyOutcome H T) (k : ℕ) :
    greedyStateAt H C ω (k + 1) =
      greedyChoiceStep H C (greedyStateAt H C ω k) (greedyChoiceAt ω k) := rfl

/-- All states on every tape satisfy the deterministic matching and conflict
invariants.  Invalid choices and exhausted tapes simply freeze. -/
theorem greedyStateAt_isConflictFreeMatching
    (H : Hypergraph V) (C : ConflictSystem V) (hC : ∅ ∉ C)
    {T : ℕ} (ω : GreedyOutcome H T) (k : ℕ) :
    IsConflictFreeMatching H C (greedyStateAt H C ω k) := by
  induction k with
  | zero => exact isConflictFreeMatching_empty H hC
  | succ k ih =>
      rw [greedyStateAt_succ]
      exact greedyChoiceStep_preserves ih _

/-- Product mass of a finite adaptive path.  The factor at time `k` uses
the state exposed by the preceding coordinates. -/
noncomputable def greedyPathMass (H : Hypergraph V) (C : ConflictSystem V)
    {T : ℕ} (ω : GreedyOutcome H T) : ℝ :=
  ∏ k : Fin T,
    greedyTransitionMass H C (greedyStateAt H C ω k) (ω k)

theorem greedyPathMass_nonneg (H : Hypergraph V) (C : ConflictSystem V)
    {T : ℕ} (ω : GreedyOutcome H T) :
    0 ≤ greedyPathMass H C ω := by
  apply Finset.prod_nonneg
  intro k hk
  exact greedyTransitionMass_nonneg H C _ _

/-- Recursive form of the adaptive path mass, starting from an arbitrary
state.  At a successor time it exposes the first choice and then uses the
kernel at the resulting state for the continuation. -/
noncomputable def greedyPathMassFrom (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) :
    {T : ℕ} → GreedyOutcome H T → ℝ
  | 0, _ => 1
  | T + 1, ω =>
      greedyTransitionMass H C M (ω 0) *
        greedyPathMassFrom H C (greedyChoiceStep H C M (ω 0))
          (fun i : Fin T => ω i.succ)

@[simp] theorem greedyPathMassFrom_zero (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (ω : GreedyOutcome H 0) :
    greedyPathMassFrom H C M ω = 1 := rfl

@[simp] theorem greedyPathMassFrom_succ (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (ω : GreedyOutcome H (T + 1)) :
    greedyPathMassFrom H C M ω =
      greedyTransitionMass H C M (ω 0) *
        greedyPathMassFrom H C (greedyChoiceStep H C M (ω 0))
          (fun i : Fin T => ω i.succ) := rfl

theorem greedyPathMassFrom_nonneg (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (ω : GreedyOutcome H T) :
    0 ≤ greedyPathMassFrom H C M ω := by
  induction T generalizing M with
  | zero => simp
  | succ T ih =>
      rw [greedyPathMassFrom_succ]
      exact mul_nonneg (greedyTransitionMass_nonneg H C M (ω 0))
        (ih (greedyChoiceStep H C M (ω 0)) (fun i => ω i.succ))

/-- The adaptive finite path law has total mass one from every starting
state.  This is the finite-tree normalization used by all later stopped
martingales. -/
theorem sum_greedyPathMassFrom (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ) :
    ∑ ω : GreedyOutcome H T, greedyPathMassFrom H C M ω = 1 := by
  induction T generalizing M with
  | zero => simp
  | succ T ih =>
      rw [← Equiv.sum_comp
        (Fin.consEquiv (fun _ : Fin (T + 1) => GreedyChoice H))
        (fun ω : GreedyOutcome H (T + 1) =>
          greedyPathMassFrom H C M ω)]
      rw [Fintype.sum_prod_type]
      calc
        (∑ o : GreedyChoice H, ∑ tail : GreedyOutcome H T,
            greedyPathMassFrom H C M
              ((Fin.consEquiv (fun _ : Fin (T + 1) => GreedyChoice H))
                (o, tail))) =
            ∑ o : GreedyChoice H,
              greedyTransitionMass H C M o *
                (∑ tail : GreedyOutcome H T,
                  greedyPathMassFrom H C (greedyChoiceStep H C M o) tail) := by
              apply Finset.sum_congr rfl
              intro o ho
              calc
                (∑ tail : GreedyOutcome H T,
                    greedyPathMassFrom H C M
                      ((Fin.consEquiv
                        (fun _ : Fin (T + 1) => GreedyChoice H))
                        (o, tail))) =
                    ∑ tail : GreedyOutcome H T,
                      greedyTransitionMass H C M o *
                        greedyPathMassFrom H C
                          (greedyChoiceStep H C M o) tail := by
                      apply Finset.sum_congr rfl
                      intro tail htail
                      rfl
                _ = greedyTransitionMass H C M o *
                      (∑ tail : GreedyOutcome H T,
                        greedyPathMassFrom H C
                          (greedyChoiceStep H C M o) tail) := by
                      rw [Finset.mul_sum]
        _ = ∑ o : GreedyChoice H,
              greedyTransitionMass H C M o * 1 := by
            apply Finset.sum_congr rfl
            intro o ho
            rw [ih]
        _ = 1 := by
            simpa using sum_greedyTransitionMass H C M

/-- The normalized law of a path started from the empty matching. -/
noncomputable def normalizedGreedyPathMass (H : Hypergraph V)
    (C : ConflictSystem V) {T : ℕ} (ω : GreedyOutcome H T) : ℝ :=
  greedyPathMassFrom H C ∅ ω

theorem normalizedGreedyPathMass_nonneg (H : Hypergraph V)
    (C : ConflictSystem V) {T : ℕ} (ω : GreedyOutcome H T) :
    0 ≤ normalizedGreedyPathMass H C ω :=
  greedyPathMassFrom_nonneg H C ∅ ω

theorem sum_normalizedGreedyPathMass (H : Hypergraph V)
    (C : ConflictSystem V) (T : ℕ) :
    ∑ ω : GreedyOutcome H T, normalizedGreedyPathMass H C ω = 1 :=
  sum_greedyPathMassFrom H C ∅ T

/-- State after `k` coordinates when the process starts from an arbitrary
matching state. -/
noncomputable def greedyStateFromAt (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (ω : GreedyOutcome H T) : ℕ → Hypergraph V
  | 0 => M
  | k + 1 =>
      greedyChoiceStep H C (greedyStateFromAt H C M ω k)
        (greedyChoiceAt ω k)

@[simp] theorem greedyStateFromAt_zero (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (ω : GreedyOutcome H T) :
    greedyStateFromAt H C M ω 0 = M := rfl

theorem greedyStateFromAt_succ (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (ω : GreedyOutcome H T) (k : ℕ) :
    greedyStateFromAt H C M ω (k + 1) =
      greedyChoiceStep H C (greedyStateFromAt H C M ω k)
        (greedyChoiceAt ω k) := rfl

theorem subset_greedyChoiceStep (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (o : GreedyChoice H) :
    M ⊆ greedyChoiceStep H C M o := by
  rcases o with _ | e
  · exact Finset.Subset.rfl
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · rw [greedyChoiceStep, greedyStep_eq_insert he]
      exact Finset.subset_insert (e : Finset V) M
    · rw [greedyChoiceStep, greedyStep_eq_self he]

theorem card_greedyChoiceStep_le_add_one
    (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (o : GreedyChoice H) :
    (greedyChoiceStep H C M o).card ≤ M.card + 1 := by
  rcases o with _ | e
  · simp [greedyChoiceStep]
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · rw [greedyChoiceStep, greedyStep_eq_insert he,
        Finset.card_insert_of_notMem (mem_availableEdges.mp he).2.1]
    · rw [greedyChoiceStep, greedyStep_eq_self he]
      omega

theorem card_greedyStateFromAt_le_add
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {T : ℕ} (omega : GreedyOutcome H T) (k : ℕ) :
    (greedyStateFromAt H C M omega k).card ≤ M.card + k := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [greedyStateFromAt_succ]
      calc
        (greedyChoiceStep H C (greedyStateFromAt H C M omega k)
            (greedyChoiceAt omega k)).card ≤
            (greedyStateFromAt H C M omega k).card + 1 :=
          card_greedyChoiceStep_le_add_one H C _ _
        _ ≤ M.card + k + 1 := Nat.add_le_add_right ih 1
        _ = M.card + (k + 1) := by omega

theorem card_greedyStateAt_le
    (H : Hypergraph V) (C : ConflictSystem V)
    {T : ℕ} (omega : GreedyOutcome H T) (k : ℕ) :
    (greedyStateAt H C omega k).card ≤ k := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [greedyStateAt_succ]
      exact (card_greedyChoiceStep_le_add_one H C _ _).trans (by omega)

theorem greedyStateFromAt_mono (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (omega : GreedyOutcome H T) {i k : ℕ} (hik : i ≤ k) :
    greedyStateFromAt H C M omega i ⊆ greedyStateFromAt H C M omega k := by
  induction k with
  | zero =>
      have hi : i = 0 := Nat.eq_zero_of_le_zero hik
      subst i
      exact Finset.Subset.rfl
  | succ k ih =>
      rcases Nat.lt_or_eq_of_le hik with hlt | rfl
      · exact (ih (Nat.le_of_lt_succ hlt)).trans
          (subset_greedyChoiceStep H C _ _)
      · exact Finset.Subset.rfl

theorem mem_uncoveredVertices_greedyStateFromAt_of_le
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (omega : GreedyOutcome H T) {i k : ℕ} (hik : i ≤ k) {v : V}
    (hv : v ∈ uncoveredVertices H (greedyStateFromAt H C M omega k)) :
    v ∈ uncoveredVertices H (greedyStateFromAt H C M omega i) := by
  rw [mem_uncoveredVertices] at hv ⊢
  refine ⟨hv.1, ?_⟩
  intro hvi
  exact hv.2 (vertexFinset_mono (greedyStateFromAt_mono H C M omega hik) hvi)

theorem greedyStateAt_eq_stateFrom_empty (H : Hypergraph V)
    (C : ConflictSystem V) {T : ℕ} (ω : GreedyOutcome H T) (k : ℕ) :
    greedyStateAt H C ω k = greedyStateFromAt H C ∅ ω k := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [greedyStateAt_succ, greedyStateFromAt_succ, ih]

/-- The first coordinate under the adaptive path law has exactly the
one-step transition distribution.  The future coordinates disappear by
finite-tree normalization. -/
theorem sum_greedyPathMassFrom_mul_head (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (F : GreedyChoice H → ℝ) :
    (∑ ω : GreedyOutcome H (T + 1),
      greedyPathMassFrom H C M ω * F (ω 0)) =
      ∑ o : GreedyChoice H, greedyTransitionMass H C M o * F o := by
  rw [← Equiv.sum_comp
    (Fin.consEquiv (fun _ : Fin (T + 1) => GreedyChoice H))
    (fun ω : GreedyOutcome H (T + 1) =>
      greedyPathMassFrom H C M ω * F (ω 0))]
  rw [Fintype.sum_prod_type]
  calc
    (∑ o : GreedyChoice H, ∑ tail : GreedyOutcome H T,
        greedyPathMassFrom H C M
            ((Fin.consEquiv (fun _ : Fin (T + 1) => GreedyChoice H))
              (o, tail)) *
          F (((Fin.consEquiv
            (fun _ : Fin (T + 1) => GreedyChoice H)) (o, tail)) 0)) =
        ∑ o : GreedyChoice H,
          (greedyTransitionMass H C M o * F o) *
            (∑ tail : GreedyOutcome H T,
              greedyPathMassFrom H C (greedyChoiceStep H C M o) tail) := by
      apply Finset.sum_congr rfl
      intro o ho
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro tail htail
      simp [Fin.consEquiv, greedyPathMassFrom, mul_left_comm, mul_comm]
    _ = ∑ o : GreedyChoice H,
          (greedyTransitionMass H C M o * F o) * 1 := by
      apply Finset.sum_congr rfl
      intro o ho
      rw [sum_greedyPathMassFrom]
    _ = ∑ o : GreedyChoice H,
          greedyTransitionMass H C M o * F o := by simp

/-- One-step expectations are the head marginals of every positive-length
adaptive path law. -/
theorem expectation_greedyStateFromAt_one (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (X : Hypergraph V → ℝ) :
    Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω : GreedyOutcome H (T + 1) =>
          X (greedyStateFromAt H C M ω 1)) =
      greedyStepExpectation H C M X := by
  rw [Freedman.expectation, greedyStepExpectation]
  calc
    (∑ ω : GreedyOutcome H (T + 1),
        greedyPathMassFrom H C M ω *
          X (greedyStateFromAt H C M ω 1)) =
        ∑ ω : GreedyOutcome H (T + 1),
          greedyPathMassFrom H C M ω *
            X (greedyChoiceStep H C M (ω 0)) := by
      apply Finset.sum_congr rfl
      intro ω hω
      simp [greedyStateFromAt_succ, greedyChoiceAt]
    _ = ∑ o : GreedyChoice H,
        greedyTransitionMass H C M o *
          X (greedyChoiceStep H C M o) :=
      sum_greedyPathMassFrom_mul_head H C M T
        (fun o => X (greedyChoiceStep H C M o))

@[simp] theorem greedyChoiceAt_cons_zero {H : Hypergraph V} {T : ℕ}
    (o : GreedyChoice H) (tail : GreedyOutcome H T) :
    greedyChoiceAt (Fin.cons o tail) 0 = o := by
  simp [greedyChoiceAt]

theorem greedyChoiceAt_cons_succ {H : Hypergraph V} {T : ℕ}
    (o : GreedyChoice H) (tail : GreedyOutcome H T) (k : ℕ) :
    greedyChoiceAt (Fin.cons o tail) (k + 1) = greedyChoiceAt tail k := by
  by_cases hk : k < T
  · rw [greedyChoiceAt, dif_pos (Nat.succ_lt_succ hk),
      greedyChoiceAt, dif_pos hk]
    simpa using
      (Fin.cons_succ
        (α := fun _ : Fin (T + 1) => GreedyChoice H) o tail ⟨k, hk⟩)
  · have hk' : ¬k + 1 < T + 1 := by omega
    simp [greedyChoiceAt, hk, hk']

/-- After exposing the head choice, the state process is the process on the
tail started from the head successor state. -/
theorem greedyStateFromAt_cons_succ (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (o : GreedyChoice H) (tail : GreedyOutcome H T) (k : ℕ) :
    greedyStateFromAt H C M (Fin.cons o tail) (k + 1) =
      greedyStateFromAt H C (greedyChoiceStep H C M o) tail k := by
  induction k with
  | zero => simp [greedyStateFromAt_succ]
  | succ k ih =>
      change
        greedyChoiceStep H C
            (greedyStateFromAt H C M (Fin.cons o tail) (k + 1))
            (greedyChoiceAt (Fin.cons o tail) (k + 1)) =
          greedyStateFromAt H C (greedyChoiceStep H C M o) tail (k + 1)
      rw [ih, greedyChoiceAt_cons_succ, greedyStateFromAt_succ]

/-- Split a path expectation into its first transition and the conditional
expectation on its tail. -/
theorem expectation_greedyPathMassFrom_succ (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (G : GreedyOutcome H (T + 1) → ℝ) :
    Freedman.expectation (greedyPathMassFrom H C M) G =
      ∑ o : GreedyChoice H,
        greedyTransitionMass H C M o *
          Freedman.expectation
            (greedyPathMassFrom H C (greedyChoiceStep H C M o))
            (fun tail : GreedyOutcome H T => G (Fin.cons o tail)) := by
  rw [Freedman.expectation]
  rw [← Equiv.sum_comp
    (Fin.consEquiv (fun _ : Fin (T + 1) => GreedyChoice H))
    (fun ω : GreedyOutcome H (T + 1) =>
      greedyPathMassFrom H C M ω * G ω)]
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro o ho
  rw [Freedman.expectation, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro tail htail
  simp [Fin.consEquiv, greedyPathMassFrom, mul_assoc, mul_left_comm, mul_comm]

/-- Information revealed by the first `k` coordinates of a finite greedy
tape.  Unrevealed coordinates are replaced by the frozen choice. -/
def greedyInfo (H : Hypergraph V) (T : ℕ) (k : ℕ)
    (ω : GreedyOutcome H T) : GreedyOutcome H T :=
  fun i => if (i : ℕ) < k then ω i else none

/-- At time zero every known real function is constant on the whole finite
path space. -/
theorem knownAt_greedyInfo_zero_const {H : Hypergraph V} {T : ℕ}
    {Z : GreedyOutcome H T → ℝ}
    (hZ : Freedman.KnownAt (greedyInfo H T) 0 Z)
    (ω ω' : GreedyOutcome H T) : Z ω = Z ω' := by
  apply hZ
  funext i
  simp [greedyInfo]

/-- Pull a time-zero-known factor outside an expectation. -/
theorem expectation_mul_of_knownAt_greedyInfo_zero
    {H : Hypergraph V} {T : ℕ} (C : ConflictSystem V)
    (M : Hypergraph V) (Z Y : GreedyOutcome H T → ℝ)
    (hZ : Freedman.KnownAt (greedyInfo H T) 0 Z) :
    Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω * Y ω) =
      Z default * Freedman.expectation (greedyPathMassFrom H C M) Y := by
  rw [Freedman.expectation, Freedman.expectation, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro ω hω
  rw [knownAt_greedyInfo_zero_const hZ ω default]
  ring

/-- The integrated tower identity at the first transition. -/
theorem greedyPath_conditional_step_zero (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Z : GreedyOutcome H (T + 1) → ℝ) (X : Hypergraph V → ℝ)
    (hZ : Freedman.KnownAt (greedyInfo H (T + 1)) 0 Z) :
    Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω * X (greedyStateFromAt H C M ω 1)) =
      Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω * greedyStepExpectation H C M X) := by
  rw [expectation_mul_of_knownAt_greedyInfo_zero C M Z _ hZ,
    expectation_mul_of_knownAt_greedyInfo_zero C M Z _ hZ,
    expectation_greedyStateFromAt_one]
  congr 1
  symm
  rw [Freedman.expectation]
  calc
    (∑ ω : GreedyOutcome H (T + 1),
        greedyPathMassFrom H C M ω * greedyStepExpectation H C M X) =
        (∑ ω : GreedyOutcome H (T + 1),
          greedyPathMassFrom H C M ω) *
            greedyStepExpectation H C M X := by
          rw [Finset.sum_mul]
    _ = greedyStepExpectation H C M X := by
          rw [sum_greedyPathMassFrom]
          simp

@[simp] theorem greedyInfo_apply_of_lt (H : Hypergraph V) {T k : ℕ}
    (ω : GreedyOutcome H T) (i : Fin T) (hi : (i : ℕ) < k) :
    greedyInfo H T k ω i = ω i := by
  simp [greedyInfo, hi]

@[simp] theorem greedyInfo_apply_of_le (H : Hypergraph V) {T k : ℕ}
    (ω : GreedyOutcome H T) (i : Fin T) (hi : k ≤ (i : ℕ)) :
    greedyInfo H T k ω i = none := by
  simp [greedyInfo, Nat.not_lt.mpr hi]

/-- Prefix masking is an increasing finite filtration. -/
theorem greedyInfo_isFiltration (H : Hypergraph V) (T : ℕ) :
    Freedman.IsFiltration (greedyInfo H T) := by
  intro i j hij ω ω' hinfo
  funext a
  by_cases hai : (a : ℕ) < i
  · have haj : (a : ℕ) < j := lt_of_lt_of_le hai hij
    have ha := congrFun hinfo a
    simpa [greedyInfo, hai, haj] using ha
  · simp [greedyInfo, hai]

/-- Equality of time-`k` information implies equality of every raw choice
strictly before `k`, including the past-end frozen convention. -/
theorem greedyChoiceAt_eq_of_info_eq {H : Hypergraph V} {T k a : ℕ}
    {ω ω' : GreedyOutcome H T}
    (hinfo : greedyInfo H T k ω = greedyInfo H T k ω') (ha : a < k) :
    greedyChoiceAt ω a = greedyChoiceAt ω' a := by
  by_cases haT : a < T
  · have hcoord := congrFun hinfo (⟨a, haT⟩ : Fin T)
    simpa [greedyChoiceAt, greedyInfo, ha, haT] using hcoord
  · simp [greedyChoiceAt, haT]

/-- The state after `k` steps depends only on the first `k` tape
coordinates. -/
theorem greedyStateAt_eq_of_info_eq (H : Hypergraph V)
    (C : ConflictSystem V) {T k : ℕ} {ω ω' : GreedyOutcome H T}
    (hinfo : greedyInfo H T k ω = greedyInfo H T k ω') :
    greedyStateAt H C ω k = greedyStateAt H C ω' k := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [greedyStateAt_succ, greedyStateAt_succ]
      have hprevInfo : greedyInfo H T k ω = greedyInfo H T k ω' :=
        greedyInfo_isFiltration H T (Nat.le_succ k) hinfo
      rw [ih hprevInfo]
      rw [greedyChoiceAt_eq_of_info_eq hinfo (Nat.lt_succ_self k)]

/-- Every real observable of the current state is known at the current
time in the sense required by the finite Freedman inequality. -/
theorem greedyStateObservable_known (H : Hypergraph V)
    (C : ConflictSystem V) (T k : ℕ) (X : Hypergraph V → ℝ) :
    Freedman.KnownAt (greedyInfo H T) k
      (fun ω : GreedyOutcome H T => X (greedyStateAt H C ω k)) := by
  intro ω ω' hinfo
  change X (greedyStateAt H C ω k) = X (greedyStateAt H C ω' k)
  rw [greedyStateAt_eq_of_info_eq H C hinfo]

/-- Equal time-`k` tail information gives equal time-`k+1` information after
the same head choice is prepended. -/
theorem greedyInfo_cons_eq_of_tail_info_eq {H : Hypergraph V}
    {T k : ℕ} (o : GreedyChoice H)
    {tail tail' : GreedyOutcome H T}
    (hinfo : greedyInfo H T k tail = greedyInfo H T k tail') :
    greedyInfo H (T + 1) (k + 1) (Fin.cons o tail) =
      greedyInfo H (T + 1) (k + 1) (Fin.cons o tail') := by
  funext i
  refine Fin.cases ?_ (fun a => ?_) i
  · simp [greedyInfo]
  · have haInfo := congrFun hinfo a
    by_cases ha : (a : ℕ) < k
    · simpa [greedyInfo, ha] using haInfo
    · simp [greedyInfo, ha]

/-- Integrated conditional-step identity for the normalized finite greedy
path law.  This is the exact finite tower property needed to turn a
fibrewise one-step drift or second-moment estimate into the hypotheses of
`Freedman.ConditionalMomentBounds`. -/
theorem greedyPath_conditional_step (H : Hypergraph V)
    (C : ConflictSystem V) {T k : ℕ} (hk : k < T)
    (M : Hypergraph V) (Z : GreedyOutcome H T → ℝ)
    (X : Hypergraph V → ℝ)
    (hZ : Freedman.KnownAt (greedyInfo H T) k Z) :
    Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω * X (greedyStateFromAt H C M ω (k + 1))) =
      Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω *
          greedyStepExpectation H C (greedyStateFromAt H C M ω k) X) := by
  induction k generalizing T M Z with
  | zero =>
      cases T with
      | zero => omega
      | succ T =>
          exact greedyPath_conditional_step_zero H C M T Z X hZ
  | succ k ih =>
      cases T with
      | zero => omega
      | succ T =>
          have hkTail : k < T := by omega
          rw [expectation_greedyPathMassFrom_succ H C M T
              (fun ω => Z ω *
                X (greedyStateFromAt H C M ω (k + 1 + 1))),
            expectation_greedyPathMassFrom_succ H C M T
              (fun ω => Z ω *
                greedyStepExpectation H C
                  (greedyStateFromAt H C M ω (k + 1)) X)]
          apply Finset.sum_congr rfl
          intro o ho
          congr 1
          have hZtail :
              Freedman.KnownAt (greedyInfo H T) k
                (fun tail : GreedyOutcome H T => Z (Fin.cons o tail)) := by
            intro tail tail' htail
            exact hZ (greedyInfo_cons_eq_of_tail_info_eq o htail)
          have hstep := ih hkTail (greedyChoiceStep H C M o)
            (fun tail : GreedyOutcome H T => Z (Fin.cons o tail)) hZtail
          simpa only [greedyStateFromAt_cons_succ] using hstep

/-- Two-state form of the conditional-step identity.  It permits the
one-step observable to depend on the known current state as well as on the
next state, which is the form used for centered increments and their
squares. -/
theorem greedyPath_conditional_step₂ (H : Hypergraph V)
    (C : ConflictSystem V) {T k : ℕ} (hk : k < T)
    (M : Hypergraph V) (Z : GreedyOutcome H T → ℝ)
    (F : Hypergraph V → Hypergraph V → ℝ)
    (hZ : Freedman.KnownAt (greedyInfo H T) k Z) :
    Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω *
          F (greedyStateFromAt H C M ω k)
            (greedyStateFromAt H C M ω (k + 1))) =
      Freedman.expectation (greedyPathMassFrom H C M)
        (fun ω => Z ω *
          greedyStepExpectation H C (greedyStateFromAt H C M ω k)
            (F (greedyStateFromAt H C M ω k))) := by
  induction k generalizing T M Z with
  | zero =>
      cases T with
      | zero => omega
      | succ T =>
          simpa only [greedyStateFromAt_zero] using
            (greedyPath_conditional_step_zero H C M T Z (F M) hZ)
  | succ k ih =>
      cases T with
      | zero => omega
      | succ T =>
          have hkTail : k < T := by omega
          rw [expectation_greedyPathMassFrom_succ H C M T
              (fun ω => Z ω *
                F (greedyStateFromAt H C M ω (k + 1))
                  (greedyStateFromAt H C M ω (k + 1 + 1))),
            expectation_greedyPathMassFrom_succ H C M T
              (fun ω => Z ω *
                greedyStepExpectation H C
                  (greedyStateFromAt H C M ω (k + 1))
                  (F (greedyStateFromAt H C M ω (k + 1))))]
          apply Finset.sum_congr rfl
          intro o ho
          congr 1
          have hZtail :
              Freedman.KnownAt (greedyInfo H T) k
                (fun tail : GreedyOutcome H T => Z (Fin.cons o tail)) := by
            intro tail tail' htail
            exact hZ (greedyInfo_cons_eq_of_tail_info_eq o htail)
          have hstep := ih hkTail (greedyChoiceStep H C M o)
            (fun tail : GreedyOutcome H T => Z (Fin.cons o tail)) hZtail
          simpa only [greedyStateFromAt_cons_succ] using hstep

/-- Arbitrary-start analogue of `greedyStateAt_eq_of_info_eq`. -/
theorem greedyStateFromAt_eq_of_info_eq (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T k : ℕ}
    {ω ω' : GreedyOutcome H T}
    (hinfo : greedyInfo H T k ω = greedyInfo H T k ω') :
    greedyStateFromAt H C M ω k = greedyStateFromAt H C M ω' k := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [greedyStateFromAt_succ, greedyStateFromAt_succ]
      have hprevInfo : greedyInfo H T k ω = greedyInfo H T k ω' :=
        greedyInfo_isFiltration H T (Nat.le_succ k) hinfo
      rw [ih hprevInfo]
      rw [greedyChoiceAt_eq_of_info_eq hinfo (Nat.lt_succ_self k)]

/-- A local centered increment specified by a state observable `X` and a
predictable compensation `a`. -/
def greedyLocalIncrement (X : Hypergraph V → ℝ)
    (a : ℕ → Hypergraph V → ℝ) (k : ℕ)
    (S S' : Hypergraph V) : ℝ :=
  X S' - X S + a k S

/-- The corresponding path increment, frozen to zero outside the finite
tape. -/
noncomputable def greedyStateIncrement (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ)
    (k : ℕ) (ω : GreedyOutcome H T) : ℝ :=
  if k < T then
    greedyLocalIncrement X a k (greedyStateFromAt H C M ω k)
      (greedyStateFromAt H C M ω (k + 1))
  else 0

/-- A path has remained in the tracked corridor through time `k`.  This is
the genuine stopped-process memory absent from a state-only increment. -/
def greedyPrefixGood (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {T : ℕ} (Good : ℕ → Hypergraph V → Prop)
    (k : ℕ) (omega : GreedyOutcome H T) : Prop :=
  ∀ i, i ≤ k → Good i (greedyStateFromAt H C M omega i)

theorem greedyPrefixGood_congr_info (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T k : ℕ}
    (Good : ℕ → Hypergraph V → Prop) {omega omega' : GreedyOutcome H T}
    (hinfo : greedyInfo H T k omega = greedyInfo H T k omega') :
    greedyPrefixGood H C M Good k omega ↔
      greedyPrefixGood H C M Good k omega' := by
  constructor <;> intro h i hi
  · have hstate := greedyStateFromAt_eq_of_info_eq H C M
      (greedyInfo_isFiltration H T hi hinfo)
    rw [← hstate]
    exact h i hi
  · have hstate := greedyStateFromAt_eq_of_info_eq H C M
      (greedyInfo_isFiltration H T hi hinfo)
    rw [hstate]
    exact h i hi

/-- Zero-one predictable multiplier for the stopped process. -/
noncomputable def greedyStopIndicator (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (Good : ℕ → Hypergraph V → Prop) (k : ℕ)
    (omega : GreedyOutcome H T) : ℝ :=
  if greedyPrefixGood H C M Good k omega then 1 else 0

theorem greedyStopIndicator_known (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop) (k : ℕ) :
    Freedman.KnownAt (greedyInfo H T) k
      (greedyStopIndicator H C M Good k) := by
  intro omega omega' hinfo
  unfold greedyStopIndicator
  rw [greedyPrefixGood_congr_info H C M Good hinfo]

theorem greedyStopIndicator_nonneg (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (Good : ℕ → Hypergraph V → Prop) (k : ℕ)
    (omega : GreedyOutcome H T) :
    0 ≤ greedyStopIndicator H C M Good k omega := by
  by_cases h : greedyPrefixGood H C M Good k omega <;>
    simp [greedyStopIndicator, h]

theorem greedyStopIndicator_le_one (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) {T : ℕ}
    (Good : ℕ → Hypergraph V → Prop) (k : ℕ)
    (omega : GreedyOutcome H T) :
    greedyStopIndicator H C M Good k omega ≤ 1 := by
  by_cases h : greedyPrefixGood H C M Good k omega <;>
    simp [greedyStopIndicator, h]

/-- Path increment frozen permanently at the first failure of `Good`. -/
noncomputable def greedyStoppedStateIncrement (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ)
    (k : ℕ) (omega : GreedyOutcome H T) : ℝ :=
  if k < T then
    greedyStopIndicator H C M Good k omega *
      greedyLocalIncrement X a k (greedyStateFromAt H C M omega k)
        (greedyStateFromAt H C M omega (k + 1))
  else 0

/-- Fully general local-step form of the stopped increment.  The local step
may inspect the next state, which is essential for freezing a vertex or an
internal test on the very step where it becomes inactive. -/
noncomputable def greedyStoppedStepIncrement (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (k : ℕ) (omega : GreedyOutcome H T) : ℝ :=
  if k < T then
    greedyStopIndicator H C M Good k omega *
      step k (greedyStateFromAt H C M omega k)
        (greedyStateFromAt H C M omega (k + 1))
  else 0

def greedyTimeStep (Y : ℕ → Hypergraph V → ℝ)
    (k : ℕ) (S S' : Hypergraph V) : ℝ :=
  Y (k + 1) S' - Y k S

/-- Before the first corridor failure, the stopped increments of a literal
time-dependent error observable telescope exactly. -/
theorem greedyStoppedTimeStep_partialSum_eq
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (Y : ℕ → Hypergraph V → ℝ) (omega : GreedyOutcome H T)
    {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega) :
    Freedman.partialSum
        (greedyStoppedStepIncrement H C M T Good (greedyTimeStep Y))
        (k + 1) omega =
      Y (k + 1) (greedyStateFromAt H C M omega (k + 1)) - Y 0 M := by
  rw [Freedman.partialSum]
  calc
    (∑ i ∈ Finset.range (k + 1),
        greedyStoppedStepIncrement H C M T Good (greedyTimeStep Y) i omega) =
        ∑ i ∈ Finset.range (k + 1),
          (Y (i + 1) (greedyStateFromAt H C M omega (i + 1)) -
            Y i (greedyStateFromAt H C M omega i)) := by
      apply Finset.sum_congr rfl
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hiT : i < T := lt_of_le_of_lt hik hk
      have hpref : greedyPrefixGood H C M Good i omega := by
        intro j hj
        exact hgood j (hj.trans hik)
      simp [greedyStoppedStepIncrement, hiT, greedyStopIndicator,
        hpref, greedyTimeStep]
    _ = Y (k + 1) (greedyStateFromAt H C M omega (k + 1)) -
        Y 0 (greedyStateFromAt H C M omega 0) := by
      let f : ℕ → ℝ := fun i ↦ Y i (greedyStateFromAt H C M omega i)
      calc
        (∑ i ∈ Finset.range (k + 1), (f (i + 1) - f i)) =
            -(∑ i ∈ Finset.range (k + 1), (f i - f (i + 1))) := by
          rw [← Finset.sum_neg_distrib]
          apply Finset.sum_congr rfl
          intro i hi
          ring
        _ = -(f 0 - f (k + 1)) := by rw [Finset.sum_range_sub']
        _ = f (k + 1) - f 0 := by ring
    _ = Y (k + 1) (greedyStateFromAt H C M omega (k + 1)) - Y 0 M := by
      rw [greedyStateFromAt_zero]

/-- A stopped local step telescopes whenever it agrees, along the prefix in
question, with the increment of a time-dependent error observable.  This is
the form used for degree variables, whose covering transition is frozen by a
next-state survival indicator. -/
theorem greedyStoppedStep_partialSum_eq_of_eq_timeStep
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (Y : ℕ → Hypergraph V → ℝ) (omega : GreedyOutcome H T)
    {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hstep : ∀ i, i ≤ k →
      step i (greedyStateFromAt H C M omega i)
          (greedyStateFromAt H C M omega (i + 1)) =
        greedyTimeStep Y i (greedyStateFromAt H C M omega i)
          (greedyStateFromAt H C M omega (i + 1))) :
    Freedman.partialSum
        (greedyStoppedStepIncrement H C M T Good step) (k + 1) omega =
      Y (k + 1) (greedyStateFromAt H C M omega (k + 1)) - Y 0 M := by
  calc
    Freedman.partialSum
        (greedyStoppedStepIncrement H C M T Good step) (k + 1) omega =
      Freedman.partialSum
        (greedyStoppedStepIncrement H C M T Good (greedyTimeStep Y))
          (k + 1) omega := by
      rw [Freedman.partialSum, Freedman.partialSum]
      apply Finset.sum_congr rfl
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hiT : i < T := lt_of_le_of_lt hik hk
      have hpref : greedyPrefixGood H C M Good i omega := by
        intro j hj
        exact hgood j (hj.trans hik)
      simp only [greedyStoppedStepIncrement, hiT, if_true,
        greedyStopIndicator, hpref, one_mul]
      exact hstep i hik
    _ = Y (k + 1) (greedyStateFromAt H C M omega (k + 1)) - Y 0 M :=
      greedyStoppedTimeStep_partialSum_eq H C M T Good Y omega hk hgood

/-- Crossing the upper envelope from an initial negative margin forces the
corresponding stopped partial sum above that margin. -/
theorem greedyStoppedStep_exit_imp_tail
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (Y : ℕ → Hypergraph V → ℝ) (omega : GreedyOutcome H T)
    {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hstep : ∀ i, i ≤ k →
      step i (greedyStateFromAt H C M omega i)
          (greedyStateFromAt H C M omega (i + 1)) =
        greedyTimeStep Y i (greedyStateFromAt H C M omega i)
          (greedyStateFromAt H C M omega (i + 1)))
    {t : ℝ} (hinitial : Y 0 M ≤ -t)
    (hexit : 0 ≤ Y (k + 1) (greedyStateFromAt H C M omega (k + 1))) :
    t ≤ Freedman.partialSum
      (greedyStoppedStepIncrement H C M T Good step) (k + 1) omega := by
  rw [greedyStoppedStep_partialSum_eq_of_eq_timeStep
    H C M T Good step Y omega hk hgood hstep]
  linarith

/-- After the first failure of the stopping predicate every later stopped
increment vanishes, so a prefix tail event is the same tail event at the
fixed terminal horizon required by `Freedman.freedman`. -/
theorem greedyStoppedStep_partialSum_eq_of_failure
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (omega : GreedyOutcome H T) {k : ℕ} (hk : k < T)
    (hfailure : ¬ Good (k + 1)
      (greedyStateFromAt H C M omega (k + 1))) :
    Freedman.partialSum
        (greedyStoppedStepIncrement H C M T Good step) T omega =
      Freedman.partialSum
        (greedyStoppedStepIncrement H C M T Good step) (k + 1) omega := by
  rw [Freedman.partialSum, Freedman.partialSum]
  rw [← Finset.sum_range_add_sum_Ico _ (Nat.succ_le_of_lt hk)]
  suffices (∑ i ∈ Finset.Ico (k + 1) T,
      greedyStoppedStepIncrement H C M T Good step i omega) = 0 by
    rw [this, add_zero]
  apply Finset.sum_eq_zero
  intro i hi
  have hiT : i < T := (Finset.mem_Ico.mp hi).2
  have hki : k + 1 ≤ i := (Finset.mem_Ico.mp hi).1
  have hprefix : ¬ greedyPrefixGood H C M Good i omega := by
    intro hp
    exact hfailure (hp (k + 1) hki)
  simp [greedyStoppedStepIncrement, hiT, greedyStopIndicator, hprefix]

theorem greedyStoppedStep_exit_imp_terminal_tail
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (Y : ℕ → Hypergraph V → ℝ) (omega : GreedyOutcome H T)
    {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hfailure : ¬ Good (k + 1)
      (greedyStateFromAt H C M omega (k + 1)))
    (hstep : ∀ i, i ≤ k →
      step i (greedyStateFromAt H C M omega i)
          (greedyStateFromAt H C M omega (i + 1)) =
        greedyTimeStep Y i (greedyStateFromAt H C M omega i)
          (greedyStateFromAt H C M omega (i + 1)))
    {t : ℝ} (hinitial : Y 0 M ≤ -t)
    (hexit : 0 ≤ Y (k + 1) (greedyStateFromAt H C M omega (k + 1))) :
    t ≤ Freedman.partialSum
      (greedyStoppedStepIncrement H C M T Good step) T omega := by
  rw [greedyStoppedStep_partialSum_eq_of_failure
    H C M T Good step omega hk hfailure]
  exact greedyStoppedStep_exit_imp_tail
    H C M T Good step Y omega hk hgood hstep hinitial hexit

/-- Conjunction of a finite family of time-dependent corridor predicates. -/
def indexedGreedyGood {ι : Type*}
    (P : ι → ℕ → Hypergraph V → Prop) (k : ℕ) (M : Hypergraph V) : Prop :=
  ∀ i, P i k M

/-- Outcomes on which component `i` is the first (possibly tied) component
to leave its corridor after a prefix on which every component was good. -/
noncomputable def greedyFirstFailureEvent {ι : Type*}
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι) :
    Finset (GreedyOutcome H T) :=
  Finset.univ.filter fun omega ↦ ∃ k, k < T ∧
    greedyPrefixGood H C M (indexedGreedyGood P) k omega ∧
    ¬P i (k + 1) (greedyStateFromAt H C M omega (k + 1))

/-- Avoiding every component's first-failure event forces the simultaneous
corridor to persist through the whole finite run. -/
theorem greedyPrefixGood_of_avoids_firstFailureEvents
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (omega : GreedyOutcome H T)
    (hinitial : ∀ i, P i 0 M)
    (havoid : ∀ i, omega ∉ greedyFirstFailureEvent H C M T P i) :
    greedyPrefixGood H C M (indexedGreedyGood P) T omega := by
  have hprefix : ∀ n, n ≤ T →
      greedyPrefixGood H C M (indexedGreedyGood P) n omega := by
    intro n hn
    induction n with
    | zero =>
        intro k hk
        have hk0 : k = 0 := Nat.eq_zero_of_le_zero hk
        subst k
        simpa [indexedGreedyGood, greedyStateFromAt_zero] using hinitial
    | succ k ih =>
        have hkT : k ≤ T := le_trans (Nat.le_succ k) hn
        have hpref := ih hkT
        intro q hq
        rcases Nat.lt_or_eq_of_le hq with hlt | rfl
        · exact hpref q (Nat.le_of_lt_succ hlt)
        · intro i
          by_contra hPi
          apply havoid i
          rw [greedyFirstFailureEvent, Finset.mem_filter]
          exact ⟨Finset.mem_univ omega,
            ⟨k, Nat.lt_of_succ_le hn, hpref, hPi⟩⟩
  exact hprefix T le_rfl

theorem greedyStoppedStateIncrement_known (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ) (k : ℕ) :
    Freedman.KnownAt (greedyInfo H T) (k + 1)
      (greedyStoppedStateIncrement H C M T Good X a k) := by
  by_cases hk : k < T
  · have hstop := (greedyStopIndicator_known H C M T Good k).mono
      (greedyInfo_isFiltration H T) (Nat.le_succ k)
    have hlocal : Freedman.KnownAt (greedyInfo H T) (k + 1)
        (fun omega ↦ greedyLocalIncrement X a k
          (greedyStateFromAt H C M omega k)
          (greedyStateFromAt H C M omega (k + 1))) := by
      intro omega omega' hinfo
      have hnow := greedyStateFromAt_eq_of_info_eq H C M
        (greedyInfo_isFiltration H T (Nat.le_succ k) hinfo)
      have hnext := greedyStateFromAt_eq_of_info_eq H C M hinfo
      simp only [greedyLocalIncrement]
      rw [hnow, hnext]
    rw [show greedyStoppedStateIncrement H C M T Good X a k =
        fun omega ↦ greedyStopIndicator H C M Good k omega *
          greedyLocalIncrement X a k
            (greedyStateFromAt H C M omega k)
            (greedyStateFromAt H C M omega (k + 1)) by
      funext omega
      simp [greedyStoppedStateIncrement, hk]]
    exact hstop.mul hlocal
  · intro omega omega' _hinfo
    simp [greedyStoppedStateIncrement, hk]

theorem greedyStoppedStepIncrement_known (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ) (k : ℕ) :
    Freedman.KnownAt (greedyInfo H T) (k + 1)
      (greedyStoppedStepIncrement H C M T Good step k) := by
  by_cases hk : k < T
  · have hstop := (greedyStopIndicator_known H C M T Good k).mono
      (greedyInfo_isFiltration H T) (Nat.le_succ k)
    have hlocal : Freedman.KnownAt (greedyInfo H T) (k + 1)
        (fun omega ↦ step k (greedyStateFromAt H C M omega k)
          (greedyStateFromAt H C M omega (k + 1))) := by
      intro omega omega' hinfo
      have hnow := greedyStateFromAt_eq_of_info_eq H C M
        (greedyInfo_isFiltration H T (Nat.le_succ k) hinfo)
      have hnext := greedyStateFromAt_eq_of_info_eq H C M hinfo
      change step k (greedyStateFromAt H C M omega k)
          (greedyStateFromAt H C M omega (k + 1)) =
        step k (greedyStateFromAt H C M omega' k)
          (greedyStateFromAt H C M omega' (k + 1))
      rw [hnow, hnext]
    rw [show greedyStoppedStepIncrement H C M T Good step k =
        fun omega ↦ greedyStopIndicator H C M Good k omega *
          step k (greedyStateFromAt H C M omega k)
            (greedyStateFromAt H C M omega (k + 1)) by
      funext omega
      simp [greedyStoppedStepIncrement, hk]]
    exact hstop.mul hlocal
  · intro omega omega' _hinfo
    simp [greedyStoppedStepIncrement, hk]

/-- State increments are adapted to the prefix filtration. -/
theorem greedyStateIncrement_known (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ) (k : ℕ) :
    Freedman.KnownAt (greedyInfo H T) (k + 1)
      (greedyStateIncrement H C M T X a k) := by
  intro ω ω' hinfo
  by_cases hk : k < T
  · have hnowInfo : greedyInfo H T k ω = greedyInfo H T k ω' :=
      greedyInfo_isFiltration H T (Nat.le_succ k) hinfo
    have hnow := greedyStateFromAt_eq_of_info_eq H C M hnowInfo
    have hnext := greedyStateFromAt_eq_of_info_eq H C M hinfo
    simp only [greedyStateIncrement, hk, if_true]
    rw [hnow, hnext]
  · simp [greedyStateIncrement, hk]

/-- Pointwise one-step drift and square bounds transfer to the integrated
conditional-moment hypotheses of the finite Freedman theorem. -/
theorem greedyStateIncrement_momentBounds (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hmean : ∀ k, k < T → ∀ S,
      greedyStepExpectation H C S
        (greedyLocalIncrement X a k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S,
      greedyStepExpectation H C S
        (fun S' => (greedyLocalIncrement X a k S S') ^ 2) ≤
          varianceBudget k) :
    Freedman.ConditionalMomentBounds
      (greedyPathMassFrom H C M) (greedyInfo H T)
      (greedyStateIncrement H C M T X a) varianceBudget := by
  constructor
  · intro k Z hZnonneg hZknown
    by_cases hk : k < T
    · have htower := greedyPath_conditional_step₂ H C hk M Z
          (fun S S' => greedyLocalIncrement X a k S S') hZknown
      rw [show
        Freedman.expectation (greedyPathMassFrom H C M)
            (fun ω => Z ω * greedyStateIncrement H C M T X a k ω) =
          Freedman.expectation (greedyPathMassFrom H C M)
            (fun ω => Z ω *
              greedyLocalIncrement X a k
                (greedyStateFromAt H C M ω k)
                (greedyStateFromAt H C M ω (k + 1))) by
            apply Finset.sum_congr rfl
            intro ω hω
            simp [greedyStateIncrement, hk]]
      rw [htower]
      rw [Freedman.expectation]
      apply Finset.sum_nonpos
      intro ω hω
      rw [← mul_assoc]
      exact mul_nonpos_of_nonneg_of_nonpos
        (mul_nonneg (greedyPathMassFrom_nonneg H C M ω) (hZnonneg ω))
        (hmean k hk (greedyStateFromAt H C M ω k))
    · simp [Freedman.expectation, greedyStateIncrement, hk]
  · intro k Z hZnonneg hZknown
    by_cases hk : k < T
    · have htower := greedyPath_conditional_step₂ H C hk M Z
          (fun S S' => (greedyLocalIncrement X a k S S') ^ 2) hZknown
      calc
        Freedman.expectation (greedyPathMassFrom H C M)
            (fun ω => Z ω *
              (greedyStateIncrement H C M T X a k ω) ^ 2) =
            Freedman.expectation (greedyPathMassFrom H C M)
              (fun ω => Z ω *
                (greedyLocalIncrement X a k
                  (greedyStateFromAt H C M ω k)
                  (greedyStateFromAt H C M ω (k + 1))) ^ 2) := by
              apply Finset.sum_congr rfl
              intro ω hω
              simp [greedyStateIncrement, hk]
        _ = Freedman.expectation (greedyPathMassFrom H C M)
              (fun ω => Z ω *
                greedyStepExpectation H C (greedyStateFromAt H C M ω k)
                  (fun S' =>
                    (greedyLocalIncrement X a k
                      (greedyStateFromAt H C M ω k) S') ^ 2)) := htower
        _ ≤ Freedman.expectation (greedyPathMassFrom H C M)
              (fun ω => Z ω * varianceBudget k) := by
              rw [Freedman.expectation, Freedman.expectation]
              apply Finset.sum_le_sum
              intro ω hω
              apply mul_le_mul_of_nonneg_left
              · exact mul_le_mul_of_nonneg_left
                  (hvariance k hk (greedyStateFromAt H C M ω k))
                  (hZnonneg ω)
              · exact greedyPathMassFrom_nonneg H C M ω
        _ = varianceBudget k *
              Freedman.expectation (greedyPathMassFrom H C M) Z := by
              rw [Freedman.expectation, Freedman.expectation,
                Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro ω hω
              ring
    · have hEZ :
          0 ≤ Freedman.expectation (greedyPathMassFrom H C M) Z := by
        rw [Freedman.expectation]
        apply Finset.sum_nonneg
        intro ω hω
        exact mul_nonneg (greedyPathMassFrom_nonneg H C M ω) (hZnonneg ω)
      have hprod := mul_nonneg (hvariance_nonneg k) hEZ
      simpa [Freedman.expectation, greedyStateIncrement, hk] using hprod

/-- Conditional moments for the genuine stopped process.  Unlike the
state-only wrapper, the drift and square hypotheses are required only while
the tracked prefix has remained good. -/
theorem greedyStoppedStepIncrement_momentBounds (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hmean : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (step k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (fun S' ↦ (step k S S') ^ 2) ≤
          varianceBudget k) :
    Freedman.ConditionalMomentBounds
      (greedyPathMassFrom H C M) (greedyInfo H T)
      (greedyStoppedStepIncrement H C M T Good step) varianceBudget := by
  constructor
  · intro k Z hZnonneg hZknown
    by_cases hk : k < T
    · let I : GreedyOutcome H T → ℝ :=
        greedyStopIndicator H C M Good k
      let ZI : GreedyOutcome H T → ℝ := fun omega ↦ Z omega * I omega
      have hInonneg : ∀ omega, 0 ≤ I omega := by
        intro omega
        exact greedyStopIndicator_nonneg H C M Good k omega
      have hZI_nonneg : ∀ omega, 0 ≤ ZI omega := by
        intro omega
        exact mul_nonneg (hZnonneg omega) (hInonneg omega)
      have hZI_known : Freedman.KnownAt (greedyInfo H T) k ZI := by
        exact hZknown.mul (greedyStopIndicator_known H C M T Good k)
      have htower := greedyPath_conditional_step₂ H C hk M ZI
        (fun S S' ↦ step k S S') hZI_known
      calc
        Freedman.expectation (greedyPathMassFrom H C M)
            (fun omega ↦ Z omega *
              greedyStoppedStepIncrement H C M T Good step k omega) =
            Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                step k (greedyStateFromAt H C M omega k)
                  (greedyStateFromAt H C M omega (k + 1))) := by
              rw [Freedman.expectation, Freedman.expectation]
              apply Finset.sum_congr rfl
              intro omega _
              simp only [greedyStoppedStepIncrement, hk, if_true, ZI, I]
              ring
        _ = Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                greedyStepExpectation H C (greedyStateFromAt H C M omega k)
                  (fun S' ↦ step k
                    (greedyStateFromAt H C M omega k) S')) := htower
        _ ≤ 0 := by
          rw [Freedman.expectation]
          apply Finset.sum_nonpos
          intro omega _
          by_cases hgood : greedyPrefixGood H C M Good k omega
          · have hcurrent : Good k (greedyStateFromAt H C M omega k) :=
              hgood k le_rfl
            exact mul_nonpos_of_nonneg_of_nonpos
              (greedyPathMassFrom_nonneg H C M omega)
              (mul_nonpos_of_nonneg_of_nonpos (hZI_nonneg omega)
                (hmean k hk _ hcurrent))
          · have hZIzero : ZI omega = 0 := by
              simp [ZI, I, greedyStopIndicator, hgood]
            simp [hZIzero]
    · simp [Freedman.expectation, greedyStoppedStepIncrement, hk]
  · intro k Z hZnonneg hZknown
    by_cases hk : k < T
    · let I : GreedyOutcome H T → ℝ :=
        greedyStopIndicator H C M Good k
      let ZI : GreedyOutcome H T → ℝ := fun omega ↦ Z omega * I omega
      have hInonneg : ∀ omega, 0 ≤ I omega := by
        intro omega
        exact greedyStopIndicator_nonneg H C M Good k omega
      have hIle : ∀ omega, I omega ≤ 1 := by
        intro omega
        exact greedyStopIndicator_le_one H C M Good k omega
      have hZI_nonneg : ∀ omega, 0 ≤ ZI omega := by
        intro omega
        exact mul_nonneg (hZnonneg omega) (hInonneg omega)
      have hZI_le : ∀ omega, ZI omega ≤ Z omega := by
        intro omega
        dsimp only [ZI]
        nlinarith [hZnonneg omega, hInonneg omega, hIle omega]
      have hZI_known : Freedman.KnownAt (greedyInfo H T) k ZI := by
        exact hZknown.mul (greedyStopIndicator_known H C M T Good k)
      have htower := greedyPath_conditional_step₂ H C hk M ZI
        (fun S S' ↦ (step k S S') ^ 2) hZI_known
      calc
        Freedman.expectation (greedyPathMassFrom H C M)
            (fun omega ↦ Z omega *
              (greedyStoppedStepIncrement H C M T Good step k omega) ^ 2) =
            Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                (step k (greedyStateFromAt H C M omega k)
                  (greedyStateFromAt H C M omega (k + 1))) ^ 2) := by
              rw [Freedman.expectation, Freedman.expectation]
              apply Finset.sum_congr rfl
              intro omega _
              by_cases hgood : greedyPrefixGood H C M Good k omega <;>
                simp [greedyStoppedStepIncrement, hk, ZI, I,
                  greedyStopIndicator, hgood]
        _ = Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega *
                greedyStepExpectation H C (greedyStateFromAt H C M omega k)
                  (fun S' ↦ (step k
                    (greedyStateFromAt H C M omega k) S') ^ 2)) := htower
        _ ≤ Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ ZI omega * varianceBudget k) := by
          rw [Freedman.expectation, Freedman.expectation]
          apply Finset.sum_le_sum
          intro omega _
          by_cases hgood : greedyPrefixGood H C M Good k omega
          · have hcurrent : Good k (greedyStateFromAt H C M omega k) :=
              hgood k le_rfl
            exact mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left (hvariance k hk _ hcurrent)
                (hZI_nonneg omega))
              (greedyPathMassFrom_nonneg H C M omega)
          · have hZIzero : ZI omega = 0 := by
              simp [ZI, I, greedyStopIndicator, hgood]
            simp [hZIzero]
        _ ≤ Freedman.expectation (greedyPathMassFrom H C M)
              (fun omega ↦ Z omega * varianceBudget k) := by
          rw [Freedman.expectation, Freedman.expectation]
          apply Finset.sum_le_sum
          intro omega _
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_right (hZI_le omega)
              (hvariance_nonneg k))
            (greedyPathMassFrom_nonneg H C M omega)
        _ = varianceBudget k *
              Freedman.expectation (greedyPathMassFrom H C M) Z := by
          rw [Freedman.expectation, Freedman.expectation, Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro omega _
          ring
    · have hEZ :
          0 ≤ Freedman.expectation (greedyPathMassFrom H C M) Z := by
        rw [Freedman.expectation]
        apply Finset.sum_nonneg
        intro omega _
        exact mul_nonneg (greedyPathMassFrom_nonneg H C M omega)
          (hZnonneg omega)
      have hprod := mul_nonneg (hvariance_nonneg k) hEZ
      simpa [Freedman.expectation, greedyStoppedStepIncrement, hk] using hprod

theorem greedyStoppedStateIncrement_momentBounds (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hmean : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (greedyLocalIncrement X a k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (fun S' ↦ (greedyLocalIncrement X a k S S') ^ 2) ≤
          varianceBudget k) :
    Freedman.ConditionalMomentBounds
      (greedyPathMassFrom H C M) (greedyInfo H T)
      (greedyStoppedStateIncrement H C M T Good X a) varianceBudget := by
  have h := greedyStoppedStepIncrement_momentBounds H C M T Good
    (fun k S S' ↦ greedyLocalIncrement X a k S S') varianceBudget
    hvariance_nonneg hmean hvariance
  have heq : greedyStoppedStateIncrement H C M T Good X a =
      greedyStoppedStepIncrement H C M T Good
        (fun k S S' ↦ greedyLocalIncrement X a k S S') := by
    funext k omega
    rfl
  rw [heq]
  exact h

/-- A directly consumable Freedman bound for a state observable of the
adaptive conflict-free greedy process.  All probabilistic bookkeeping
(normalization, filtration, adaptedness, and conditional moments) is
discharged by the finite transition-tree lemmas above; consumers only have
to prove the one-state drift, square, increment, and total-variance bounds. -/
theorem greedyStateIncrement_freedman (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hmean : ∀ k, k < T → ∀ S,
      greedyStepExpectation H C S
        (greedyLocalIncrement X a k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S,
      greedyStepExpectation H C S
        (fun S' ↦ (greedyLocalIncrement X a k S S') ^ 2) ≤
          varianceBudget k)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k ω,
      |greedyStateIncrement H C M T X a k ω| ≤ R)
    (hW : ∑ k ∈ Finset.range T, varianceBudget k ≤ W) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun ω ↦
          t ≤ Freedman.partialSum
            (greedyStateIncrement H C M T X a) T ω)) ≤
      Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  apply Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStateIncrement_known H C M T X a k)
      (greedyStateIncrement_momentBounds H C M T X a varianceBudget
        hvariance_nonneg hmean hvariance)
      hR0 ht hW0 hden hR hW

/-- Freedman's inequality for an arbitrary next-state-dependent local step,
stopped permanently at the first failure of the tracked corridor.  This is
the form used for observables which become inactive in the next state: the
local step can return zero on that very transition. -/
theorem greedyStoppedStepIncrement_freedman (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hmean : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S (step k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (fun S' ↦ (step k S S') ^ 2) ≤ varianceBudget k)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k omega,
      |greedyStoppedStepIncrement H C M T Good step k omega| ≤ R)
    (hW : ∑ k ∈ Finset.range T, varianceBudget k ≤ W) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good step) T omega)) ≤
      Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  apply Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good step k)
      (greedyStoppedStepIncrement_momentBounds H C M T Good step
        varianceBudget hvariance_nonneg hmean hvariance)
      hR0 ht hW0 hden hR hW

/-- Freedman bound for the path-dependent process stopped at the first
failure of the tracked corridor. -/
theorem greedyStoppedStateIncrement_freedman (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ)
    (varianceBudget : ℕ → ℝ)
    (hvariance_nonneg : ∀ k, 0 ≤ varianceBudget k)
    (hmean : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (greedyLocalIncrement X a k S) ≤ 0)
    (hvariance : ∀ k, k < T → ∀ S, Good k S →
      greedyStepExpectation H C S
        (fun S' ↦ (greedyLocalIncrement X a k S S') ^ 2) ≤
          varianceBudget k)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k omega,
      |greedyStoppedStateIncrement H C M T Good X a k omega| ≤ R)
    (hW : ∑ k ∈ Finset.range T, varianceBudget k ≤ W) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStateIncrement H C M T Good X a) T omega)) ≤
      Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  apply Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStateIncrement_known H C M T Good X a k)
      (greedyStoppedStateIncrement_momentBounds H C M T Good X a
        varianceBudget hvariance_nonneg hmean hvariance)
      hR0 ht hW0 hden hR hW

theorem greedyStepExpectation_add (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (X Y : Hypergraph V → ℝ) :
    greedyStepExpectation H C M (fun N => X N + Y N) =
      greedyStepExpectation H C M X + greedyStepExpectation H C M Y := by
  rw [greedyStepExpectation, greedyStepExpectation, greedyStepExpectation,
    ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro o ho
  ring

theorem greedyStepExpectation_const_mul (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (c : ℝ)
    (X : Hypergraph V → ℝ) :
    greedyStepExpectation H C M (fun N ↦ c * X N) =
      c * greedyStepExpectation H C M X := by
  rw [greedyStepExpectation, greedyStepExpectation, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro o ho
  ring

theorem greedyStepExpectation_neg (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) :
    greedyStepExpectation H C M (fun N => -X N) =
      -greedyStepExpectation H C M X := by
  rw [greedyStepExpectation, greedyStepExpectation, ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro o ho
  ring

theorem greedyStepExpectation_affine (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) (b : ℝ) :
    greedyStepExpectation H C M (fun N => X N + b) =
      greedyStepExpectation H C M X + b := by
  rw [greedyStepExpectation_add]
  rw [greedyStepExpectation_const]

theorem greedyStepExpectation_sub_current_add (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) (b : ℝ) :
    greedyStepExpectation H C M (fun N => X N - X M + b) =
      greedyStepExpectation H C M X - X M + b := by
  have hfun : (fun N => X N - X M + b) =
      (fun N => X N + (-X M + b)) := by
    funext N
    ring
  rw [hfun, greedyStepExpectation_affine]
  ring

/-- At a frozen state, the one-step expectation is evaluation at that
state. -/
theorem greedyStepExpectation_of_availableEdges_eq_empty
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) (hA : availableEdges H C M = ∅) :
    greedyStepExpectation H C M X = X M := by
  classical
  rw [greedyStepExpectation, Fintype.sum_option]
  simp [greedyTransitionMass, hA, greedyChoiceStep]

/-- Mean one-step deletion of the `v`-degree under a uniform choice from
`A`, with value zero when `A` is empty. -/
noncomputable def meanLostDegree (A : Hypergraph V) (v : V) : ℝ :=
  if A = ∅ then 0 else
    (∑ e ∈ A, (lostDegree A e v : ℝ)) / (A.card : ℝ)

/-- Mean square one-step degree deletion under a uniform edge of `A`. -/
noncomputable def meanSqLostDegree (A : Hypergraph V) (v : V) : ℝ :=
  if A = ∅ then 0 else
    (∑ e ∈ A, (lostDegree A e v : ℝ) ^ 2) / (A.card : ℝ)

/-- Literal mean degree loss for the full conflict process.  Unlike
`meanLostDegree`, this includes both intersections with the selected edge
and deletions forced by newly completed conflicts. -/
noncomputable def meanAvailableDegreeLoss (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (v : V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ A, (availableDegreeLoss H C M e v : ℝ)) / (A.card : ℝ)

/-- Corresponding raw conditional second moment. -/
noncomputable def meanSqAvailableDegreeLoss (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (v : V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ A, (availableDegreeLoss H C M e v : ℝ) ^ 2) /
      (A.card : ℝ)

theorem meanAvailableDegreeLoss_eq_of_nonempty
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    (hA : (availableEdges H C M).Nonempty) :
    meanAvailableDegreeLoss H C M v =
      (∑ e ∈ availableEdges H C M,
        (availableDegreeLoss H C M e v : ℝ)) /
        ((availableEdges H C M).card : ℝ) := by
  simp [meanAvailableDegreeLoss, Finset.nonempty_iff_ne_empty.mp hA]

theorem meanSqAvailableDegreeLoss_eq_of_nonempty
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    (hA : (availableEdges H C M).Nonempty) :
    meanSqAvailableDegreeLoss H C M v =
      (∑ e ∈ availableEdges H C M,
        (availableDegreeLoss H C M e v : ℝ) ^ 2) /
        ((availableEdges H C M).card : ℝ) := by
  simp [meanSqAvailableDegreeLoss, Finset.nonempty_iff_ne_empty.mp hA]

theorem meanLostDegree_eq_of_nonempty {A : Hypergraph V} {v : V}
    (hA : A.Nonempty) :
    meanLostDegree A v =
      (∑ e ∈ A, (lostDegree A e v : ℝ)) / (A.card : ℝ) := by
  simp [meanLostDegree, Finset.nonempty_iff_ne_empty.mp hA]

@[simp] theorem meanLostDegree_empty (v : V) :
    meanLostDegree (∅ : Hypergraph V) v = 0 := by
  simp [meanLostDegree]

theorem meanSqLostDegree_eq_of_nonempty {A : Hypergraph V} {v : V}
    (hA : A.Nonempty) :
    meanSqLostDegree A v =
      (∑ e ∈ A, (lostDegree A e v : ℝ) ^ 2) / (A.card : ℝ) := by
  simp [meanSqLostDegree, Finset.nonempty_iff_ne_empty.mp hA]

@[simp] theorem meanSqLostDegree_empty (v : V) :
    meanSqLostDegree (∅ : Hypergraph V) v = 0 := by
  simp [meanSqLostDegree]

theorem meanLostDegree_nonneg (A : Hypergraph V) (v : V) :
    0 ≤ meanLostDegree A v := by
  by_cases hA : A = ∅
  · subst A
    simp
  · rw [meanLostDegree, if_neg hA]
    positivity

theorem meanSqLostDegree_nonneg (A : Hypergraph V) (v : V) :
    0 ≤ meanSqLostDegree A v := by
  by_cases hA : A = ∅
  · subst A
    simp
  · rw [meanSqLostDegree, if_neg hA]
    positivity

theorem meanLostDegree_le_degree (A : Hypergraph V) (v : V) :
    meanLostDegree A v ≤ degree A v := by
  by_cases hA : A = ∅
  · subst A
    simp
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [meanLostDegree_eq_of_nonempty hAne]
    have hcard : 0 < (A.card : ℝ) := by positivity
    rw [div_le_iff₀ hcard]
    calc
      (∑ e ∈ A, (lostDegree A e v : ℝ)) ≤
          ∑ _e ∈ A, (degree A v : ℝ) := by
        apply Finset.sum_le_sum
        intro e he
        exact_mod_cast lostDegree_le_degree A e v
      _ = (degree A v : ℝ) * (A.card : ℝ) := by
        simp [mul_comm]

/-- The elementary predictable-variance estimate `E[L²] ≤ D E[L]`.
It uses only that a one-step deletion cannot exceed the current degree. -/
theorem meanSqLostDegree_le_degree_mul_meanLostDegree
    (A : Hypergraph V) (v : V) :
    meanSqLostDegree A v ≤
      (degree A v : ℝ) * meanLostDegree A v := by
  by_cases hA : A = ∅
  · subst A
    simp
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [meanSqLostDegree_eq_of_nonempty hAne,
      meanLostDegree_eq_of_nonempty hAne]
    have hcard : 0 ≤ (A.card : ℝ) := by positivity
    calc
      (∑ e ∈ A, (lostDegree A e v : ℝ) ^ 2) / (A.card : ℝ) ≤
          ((degree A v : ℝ) *
            ∑ e ∈ A, (lostDegree A e v : ℝ)) / (A.card : ℝ) := by
        apply div_le_div_of_nonneg_right _ hcard
        rw [Finset.mul_sum]
        apply Finset.sum_le_sum
        intro e he
        have hle : (lostDegree A e v : ℝ) ≤ degree A v := by
          exact_mod_cast lostDegree_le_degree A e v
        have hnonneg : 0 ≤ (lostDegree A e v : ℝ) := by positivity
        nlinarith
      _ = (degree A v : ℝ) *
          ((∑ e ∈ A, (lostDegree A e v : ℝ)) / (A.card : ℝ)) := by
        ring

theorem meanSqLostDegree_available_le_sq (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (v : V) (d : ℝ)
    (hdeg : (degree H v : ℝ) ≤ d) :
    meanSqLostDegree (availableEdges H C M) v ≤ d ^ 2 := by
  let A := availableEdges H C M
  have hAH : A ⊆ H := availableEdges_subset H C M
  have hDA : (degree A v : ℝ) ≤ degree H v := by
    exact_mod_cast degree_mono hAH v
  have hmean := meanLostDegree_le_degree A v
  have hsq := meanSqLostDegree_le_degree_mul_meanLostDegree A v
  have hD0 : 0 ≤ (degree A v : ℝ) := by positivity
  have hm0 := meanLostDegree_nonneg A v
  nlinarith

noncomputable def availableDegreeObservable (H : Hypergraph V)
    (C : ConflictSystem V)
    (v : V) (M : Hypergraph V) : ℝ :=
  degree (availableEdges H C M) v

/-- At a nonterminal state, one-step expectation is the literal uniform
average over the currently available edges. -/
theorem greedyStepExpectation_eq_average
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ)
    (hA : (availableEdges H C M).Nonempty) :
    greedyStepExpectation H C M X =
      (∑ e ∈ availableEdges H C M, X (insert e M)) /
        (availableEdges H C M).card := by
  classical
  let A := availableEdges H C M
  have hAne : A ≠ ∅ := Finset.nonempty_iff_ne_empty.mp hA
  have hAH : A ⊆ H := by
    intro e he
    exact (mem_availableEdges.mp he).1
  rw [greedyStepExpectation, Fintype.sum_option]
  have hnone : greedyTransitionMass H C M none = 0 := by
    simp [greedyTransitionMass, A, hAne]
  rw [hnone, zero_mul, zero_add]
  calc
    (∑ e : {e // e ∈ H},
        greedyTransitionMass H C M (some e) *
          X (greedyChoiceStep H C M (some e))) =
        ∑ e : {e // e ∈ H},
          if (e : Finset V) ∈ A then
            (A.card : ℝ)⁻¹ * X (insert (e : Finset V) M) else 0 := by
      apply Finset.sum_congr rfl
      intro e he
      by_cases heA : (e : Finset V) ∈ A
      · have hstep : greedyStep H C M e = insert (e : Finset V) M :=
          greedyStep_eq_insert heA
        simp [greedyChoiceStep, greedyTransitionMass, A, hAne, heA, hstep]
      · simp [greedyChoiceStep, greedyTransitionMass, A, hAne, heA]
    _ = ∑ e ∈ A, (A.card : ℝ)⁻¹ * X (insert e M) := by
      exact sum_hostEdgeSubtype_ite hAH
        (fun e => (A.card : ℝ)⁻¹ * X (insert e M))
    _ = (∑ e ∈ A, X (insert e M)) / A.card := by
      rw [← Finset.mul_sum]
      simp only [div_eq_mul_inv]
      ring

/-- Exact one-step degree drift for the full conflict process.  All of the
hard regularized-core combinatorics is now isolated in estimating
`meanAvailableDegreeLoss`; the probability identity itself is exact. -/
theorem greedyStepExpectation_degree_available
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V) :
    greedyStepExpectation H C M
        (availableDegreeObservable H C v) =
      availableDegreeObservable H C v M -
        meanAvailableDegreeLoss H C M v := by
  classical
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty H C M _ hA]
    simp [availableDegreeObservable, meanAvailableDegreeLoss, A, hA]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    have hcardNat : A.card ≠ 0 := Finset.card_ne_zero.mpr hAne
    have hcardReal : (A.card : ℝ) ≠ 0 := by exact_mod_cast hcardNat
    rw [greedyStepExpectation_eq_average H C M _ hAne,
      meanAvailableDegreeLoss_eq_of_nonempty hAne]
    change
      (∑ e ∈ A,
        (degree (availableEdges H C (insert e M)) v : ℝ)) / (A.card : ℝ) =
      (degree A v : ℝ) -
        (∑ e ∈ A, (availableDegreeLoss H C M e v : ℝ)) /
          (A.card : ℝ)
    calc
      (∑ e ∈ A,
          (degree (availableEdges H C (insert e M)) v : ℝ)) /
            (A.card : ℝ) =
          (∑ e ∈ A,
            ((degree A v : ℝ) -
              (availableDegreeLoss H C M e v : ℝ))) / (A.card : ℝ) := by
        congr 1
        apply Finset.sum_congr rfl
        intro e he
        have hpart := degree_insert_available_add_loss H C M e v
        have hpartR :
            (degree (availableEdges H C (insert e M)) v : ℝ) +
                (availableDegreeLoss H C M e v : ℝ) =
              (degree A v : ℝ) := by
          exact_mod_cast hpart
        linarith
      _ = (degree A v : ℝ) -
          (∑ e ∈ A, (availableDegreeLoss H C M e v : ℝ)) /
            (A.card : ℝ) := by
        rw [Finset.sum_sub_distrib]
        simp only [Finset.sum_const, nsmul_eq_mul]
        field_simp

/-- The literal full-conflict degree increment centered by its exact mean is
a one-step martingale difference at every state. -/
theorem greedyStepExpectation_centeredDegree
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (v : V) (k : ℕ) :
    greedyStepExpectation H C M
        (greedyLocalIncrement (availableDegreeObservable H C v)
          (fun _ S ↦ meanAvailableDegreeLoss H C S v) k M) = 0 := by
  unfold greedyLocalIncrement
  rw [greedyStepExpectation_sub_current_add,
    greedyStepExpectation_degree_available]
  ring

/-- Exact raw conditional second moment for the full conflict process. -/
theorem greedyStepExpectation_degree_increment_sq
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V) :
    greedyStepExpectation H C M
        (fun N ↦
          (availableDegreeObservable H C v N -
            availableDegreeObservable H C v M) ^ 2) =
      meanSqAvailableDegreeLoss H C M v := by
  classical
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty H C M _ hA]
    simp [availableDegreeObservable, meanSqAvailableDegreeLoss, A, hA]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [greedyStepExpectation_eq_average H C M _ hAne,
      meanSqAvailableDegreeLoss_eq_of_nonempty hAne]
    congr 1
    apply Finset.sum_congr rfl
    intro e he
    have hpart := degree_insert_available_add_loss H C M e v
    have hpartR :
        (degree (availableEdges H C (insert e M)) v : ℝ) +
            (availableDegreeLoss H C M e v : ℝ) =
          (degree A v : ℝ) := by
      exact_mod_cast hpart
    change
      ((degree (availableEdges H C (insert e M)) v : ℝ) -
        (degree A v : ℝ)) ^ 2 =
      (availableDegreeLoss H C M e v : ℝ) ^ 2
    have hdiff :
        (degree (availableEdges H C (insert e M)) v : ℝ) -
            (degree A v : ℝ) =
          -(availableDegreeLoss H C M e v : ℝ) := by
      linarith
    rw [hdiff]
    ring

/-- Centering can only decrease the conditional second moment. -/
theorem greedyStepExpectation_centeredDegree_sq
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (v : V) (k : ℕ) :
    greedyStepExpectation H C M
        (fun N ↦
          (greedyLocalIncrement (availableDegreeObservable H C v)
            (fun _ S ↦ meanAvailableDegreeLoss H C S v) k M N) ^ 2) ≤
      meanSqAvailableDegreeLoss H C M v := by
  let X := availableDegreeObservable H C v
  let mu := meanAvailableDegreeLoss H C M v
  have hcenter := greedyStepExpectation_centeredDegree H C M v k
  unfold greedyLocalIncrement at hcenter
  change greedyStepExpectation H C M
    (fun N ↦ X N - X M + mu) = 0 at hcenter
  rw [greedyStepExpectation_sub_current_add] at hcenter
  have hdelta :
      greedyStepExpectation H C M (fun N ↦ X N - X M) = -mu := by
    calc
      greedyStepExpectation H C M (fun N ↦ X N - X M) =
          greedyStepExpectation H C M X - X M := by
        simpa only [add_zero] using
          greedyStepExpectation_sub_current_add H C M X 0
      _ = -mu := by linarith
  have hraw := greedyStepExpectation_degree_increment_sq H C M v
  have hraw' :
      greedyStepExpectation H C M (fun N ↦ (X N - X M) ^ 2) =
        meanSqAvailableDegreeLoss H C M v := by
    simpa [X, availableDegreeObservable] using hraw
  change greedyStepExpectation H C M
      (fun N ↦ (X N - X M + mu) ^ 2) ≤
    meanSqAvailableDegreeLoss H C M v
  have hfun : (fun N ↦ (X N - X M + mu) ^ 2) =
      (fun N ↦
        ((X N - X M) ^ 2 + (2 * mu) * (X N - X M)) + mu ^ 2) := by
    funext N
    ring
  rw [hfun, greedyStepExpectation_affine, greedyStepExpectation_add,
    greedyStepExpectation_const_mul, hraw', hdelta]
  nlinarith [sq_nonneg mu]

/-! ### Source stopped degree split -/

/-- Available degree lost specifically to newly completed conflicts, after
ordinary matching deletions have been removed. -/
noncomputable def conflictLostDegree (C : ConflictSystem V)
    (M A : Hypergraph V) (e : Finset V) (v : V) : ℕ :=
  ((disjointResidual A e).filter fun f ↦
    v ∈ f ∧ ¬ConflictFree C (insert f (insert e M))).card

/-- Choices which would make the currently available edge `f` unavailable
by completing a conflict. -/
noncomputable def conflictBlockerChoices (C : ConflictSystem V)
    (M A : Hypergraph V) (f : Finset V) : Hypergraph V :=
  A.filter fun e ↦
    Disjoint e f ∧ ¬ConflictFree C (insert f (insert e M))

noncomputable def missAvailableDegreeLoss (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (e : Finset V) (v : V) : ℕ :=
  if v ∈ e then 0 else availableDegreeLoss H C M e v

noncomputable def meanMissAvailableDegreeLoss (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (v : V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ A, (missAvailableDegreeLoss H C M e v : ℝ)) / A.card

/-- Degree change charged only on transitions on which `v` remains
uncovered in the next state.  A covering transition is frozen immediately. -/
noncomputable def survivingAvailableDegreeIncrement
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (M M' : Hypergraph V) : ℝ :=
  if v ∈ uncoveredVertices H M' then
    (degree (availableEdges H C M') v : ℝ) -
      (degree (availableEdges H C M) v : ℝ)
  else 0

def survivingVertexIndicator (H : Hypergraph V) (v : V)
    (M : Hypergraph V) : ℝ :=
  if v ∈ uncoveredVertices H M then 1 else 0

noncomputable def survivingVertexProbability
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (M : Hypergraph V) : ℝ :=
  greedyStepExpectation H C M (survivingVertexIndicator H v)

theorem survivingVertexProbability_nonneg
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (M : Hypergraph V) :
    0 ≤ survivingVertexProbability H C v M := by
  apply greedyStepExpectation_nonneg
  intro S
  by_cases h : v ∈ uncoveredVertices H S <;>
    simp [survivingVertexIndicator, h]

theorem survivingVertexProbability_eq
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (hv : v ∈ uncoveredVertices H M)
    (hA : (availableEdges H C M).Nonempty) :
    survivingVertexProbability H C v M =
      (((availableEdges H C M).filter (v ∉ ·)).card : ℝ) /
        ((availableEdges H C M).card : ℝ) := by
  rw [survivingVertexProbability,
    greedyStepExpectation_eq_average H C M _ hA]
  congr 1
  rw [Finset.card_filter, Nat.cast_sum]
  apply Finset.sum_congr rfl
  intro e he
  unfold survivingVertexIndicator
  simp [mem_uncoveredVertices_insert_iff hv]

theorem survivingVertexProbability_eq_one_sub_degree_div
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (hv : v ∈ uncoveredVertices H M)
    (hA : (availableEdges H C M).Nonempty) :
    survivingVertexProbability H C v M =
      1 - (degree (availableEdges H C M) v : ℝ) /
        ((availableEdges H C M).card : ℝ) := by
  rw [survivingVertexProbability_eq H C M v hv hA]
  let A := availableEdges H C M
  have hcard : (A.card : ℝ) ≠ 0 := by
    exact_mod_cast Finset.card_ne_zero.mpr hA
  have hpartition :
      (A.filter (v ∉ ·)).card + degree A v = A.card := by
    rw [degree, add_comm]
    exact Finset.card_filter_add_card_filter_not _
  have hpartitionR :
      ((A.filter (v ∉ ·)).card : ℝ) + (degree A v : ℝ) = (A.card : ℝ) := by
    exact_mod_cast hpartition
  field_simp
  linarith

/-- Exact conditional drift of the next-state-survival degree increment. -/
theorem greedyStepExpectation_survivingAvailableDegreeIncrement
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (hv : v ∈ uncoveredVertices H M) :
    greedyStepExpectation H C M
        (survivingAvailableDegreeIncrement H C v M) =
      -meanMissAvailableDegreeLoss H C M v := by
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty H C M _ hA]
    simp [survivingAvailableDegreeIncrement, meanMissAvailableDegreeLoss,
      A, hA, hv]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [greedyStepExpectation_eq_average H C M _ hAne]
    rw [meanMissAvailableDegreeLoss]
    simp only [A, hA, if_false]
    rw [← neg_div, ← Finset.sum_neg_distrib]
    congr 1
    apply Finset.sum_congr rfl
    intro e he
    by_cases hve : v ∈ e
    · have hvnext : v ∉ uncoveredVertices H (insert e M) := by
        simpa [mem_uncoveredVertices_insert_iff hv] using hve
      simp [survivingAvailableDegreeIncrement, hvnext,
        missAvailableDegreeLoss, hve]
    · have hvnext : v ∈ uncoveredVertices H (insert e M) :=
        (mem_uncoveredVertices_insert_iff hv).2 hve
      have hpart := degree_insert_available_add_loss H C M e v
      have hpartR :
          (degree (availableEdges H C (insert e M)) v : ℝ) +
              (availableDegreeLoss H C M e v : ℝ) =
            (degree A v : ℝ) := by
        exact_mod_cast hpart
      simp only [survivingAvailableDegreeIncrement, hvnext, if_true,
        missAvailableDegreeLoss, hve, if_false]
      change (degree (availableEdges H C (insert e M)) v : ℝ) -
          (degree A v : ℝ) = -(availableDegreeLoss H C M e v : ℝ)
      linarith

/-- Upper and lower degree-envelope increments frozen on a covering step. -/
noncomputable def survivingDegreeUpperStep
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (M M' : Hypergraph V) : ℝ :=
  if v ∈ uncoveredVertices H M' then
    ((degree (availableEdges H C M') v : ℝ) -
        (CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) +
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1))) -
      ((degree (availableEdges H C M) v : ℝ) -
        (CFMTrajectories.dHat D₂ D₃ D₄ d N x +
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x))
  else 0

noncomputable def survivingDegreeLowerStep
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (M M' : Hypergraph V) : ℝ :=
  if v ∈ uncoveredVertices H M' then
    ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1)) -
        (degree (availableEdges H C M') v : ℝ)) -
      ((CFMTrajectories.dHat D₂ D₃ D₄ d N x -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x) -
        (degree (availableEdges H C M) v : ℝ))
  else 0

theorem survivingDegreeSteps_eq_zero_of_not_uncovered
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (hv : v ∉ uncoveredVertices H M) (o : GreedyChoice H) :
    survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N x M
        (greedyChoiceStep H C M o) = 0 ∧
      survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N x M
        (greedyChoiceStep H C M o) = 0 := by
  have hvnext : v ∉ uncoveredVertices H (greedyChoiceStep H C M o) := by
    rcases o with _ | e
    · simpa [greedyChoiceStep] using hv
    · by_cases he : (e : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert he]
        exact not_mem_uncoveredVertices_insert hv
      · simpa [greedyChoiceStep, greedyStep_eq_self he] using hv
  simp [survivingDegreeUpperStep, survivingDegreeLowerStep, hvnext]

theorem greedyStepExpectation_survivingDegreeSteps_eq_zero_of_not_uncovered
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (hv : v ∉ uncoveredVertices H M) :
    greedyStepExpectation H C M
        (survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N x M) = 0 ∧
      greedyStepExpectation H C M
        (survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N x M) = 0 := by
  constructor <;> rw [greedyStepExpectation] <;>
    apply Finset.sum_eq_zero <;> intro o ho
  · rw [(survivingDegreeSteps_eq_zero_of_not_uncovered
      H C M v D₂ D₃ D₄ Gamma epsilon d N x hv o).1, mul_zero]
  · rw [(survivingDegreeSteps_eq_zero_of_not_uncovered
      H C M v D₂ D₃ D₄ Gamma epsilon d N x hv o).2, mul_zero]

theorem greedyStepExpectation_survivingDegreeSteps_sq_eq_zero_of_not_uncovered
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (hv : v ∉ uncoveredVertices H M) :
    greedyStepExpectation H C M (fun M' ↦
        (survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N x M M') ^ 2) = 0 ∧
      greedyStepExpectation H C M (fun M' ↦
        (survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N x M M') ^ 2) = 0 := by
  constructor <;> rw [greedyStepExpectation] <;>
    apply Finset.sum_eq_zero <;> intro o ho
  · rw [(survivingDegreeSteps_eq_zero_of_not_uncovered
      H C M v D₂ D₃ D₄ Gamma epsilon d N x hv o).1, zero_pow (by norm_num), mul_zero]
  · rw [(survivingDegreeSteps_eq_zero_of_not_uncovered
      H C M v D₂ D₃ D₄ Gamma epsilon d N x hv o).2, zero_pow (by norm_num), mul_zero]

theorem survivingDegreeSteps_abs_le
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (M M' : Hypergraph V) {R S : ℝ} (hR0 : 0 ≤ R) (hS0 : 0 ≤ S)
    (hraw : |(degree (availableEdges H C M') v : ℝ) -
        (degree (availableEdges H C M) v : ℝ)| ≤ R)
    (hupperTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ S)
    (hlowerTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ S) :
    |survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N x M M'| ≤
        R + S ∧
      |survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N x M M'| ≤
        R + S := by
  by_cases hv : v ∈ uncoveredVertices H M'
  · constructor
    · rw [survivingDegreeUpperStep, if_pos hv]
      have hrearrange :
          ((degree (availableEdges H C M') v : ℝ) -
              (CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) +
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1))) -
            ((degree (availableEdges H C M) v : ℝ) -
              (CFMTrajectories.dHat D₂ D₃ D₄ d N x +
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)) =
            ((degree (availableEdges H C M') v : ℝ) -
              (degree (availableEdges H C M) v : ℝ)) -
            ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
                CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
              (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)) := by ring
      rw [hrearrange]
      calc
        |((degree (availableEdges H C M') v : ℝ) -
              (degree (availableEdges H C M) v : ℝ)) -
            ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
                CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
              (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x))| ≤
            |(degree (availableEdges H C M') v : ℝ) -
                (degree (availableEdges H C M) v : ℝ)| +
              |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
                  CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
                (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
                  CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| :=
              abs_sub _ _
        _ ≤ R + S := add_le_add hraw hupperTrajectory
    · rw [survivingDegreeLowerStep, if_pos hv]
      have hrearrange :
          ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1)) -
              (degree (availableEdges H C M') v : ℝ)) -
            ((CFMTrajectories.dHat D₂ D₃ D₄ d N x -
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x) -
              (degree (availableEdges H C M) v : ℝ)) =
            ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
                CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
              (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)) -
            ((degree (availableEdges H C M') v : ℝ) -
              (degree (availableEdges H C M) v : ℝ)) := by ring
      rw [hrearrange]
      calc
        |_ - _| ≤
            |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
                CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
              (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
                CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| +
              |(degree (availableEdges H C M') v : ℝ) -
                (degree (availableEdges H C M) v : ℝ)| := abs_sub _ _
        _ ≤ S + R := add_le_add hlowerTrajectory hraw
        _ = R + S := add_comm _ _
  · simp [survivingDegreeUpperStep, survivingDegreeLowerStep, hv,
      add_nonneg hR0 hS0]

/-- Upper degree-envelope error at an integer greedy time. -/
noncomputable def degreeUpperError
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (k : ℕ) (M : Hypergraph V) : ℝ :=
  (degree (availableEdges H C M) v : ℝ) -
    (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
      CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))

/-- Lower degree-envelope error at an integer greedy time. -/
noncomputable def degreeLowerError
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (k : ℕ) (M : Hypergraph V) : ℝ :=
  (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
      CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)) -
    (degree (availableEdges H C M) v : ℝ)

def degreeUpperCorridor
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (k : ℕ) (M : Hypergraph V) : Prop :=
  v ∉ uncoveredVertices H M ∨
    degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N k M < 0

def degreeLowerCorridor
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (k : ℕ) (M : Hypergraph V) : Prop :=
  v ∉ uncoveredVertices H M ∨
    degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N k M < 0

theorem not_degreeUpperCorridor_iff
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (k : ℕ) (M : Hypergraph V) :
    ¬degreeUpperCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k M ↔
      v ∈ uncoveredVertices H M ∧
        0 ≤ degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N k M := by
  simp only [degreeUpperCorridor, not_or, not_not, not_lt]

theorem not_degreeLowerCorridor_iff
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (k : ℕ) (M : Hypergraph V) :
    ¬degreeLowerCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k M ↔
      v ∈ uncoveredVertices H M ∧
        0 ≤ degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N k M := by
  simp only [degreeLowerCorridor, not_or, not_not, not_lt]

/-- The lower degree corridors prevent the greedy process from freezing
before a stopping time which leaves at least one host vertex uncovered. -/
theorem availableEdges_nonempty_of_degreeLowerCorridors
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (hC : ∅ ∉ C) {T : ℕ} (omega : GreedyOutcome H T) (k : ℕ)
    (hk : k < T) (hsize : 8 * T < (vertexFinset H).card)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (htrajectory : 0 <
      CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))
    (hcorridor : ∀ v ∈ uncoveredVertices H (greedyStateAt H C omega k),
      degreeLowerCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k
        (greedyStateAt H C omega k)) :
    (availableEdges H C (greedyStateAt H C omega k)).Nonempty := by
  let S := greedyStateAt H C omega k
  have hmatch : IsMatching H S :=
    (greedyStateAt_isConflictFreeMatching H C hC omega k).1
  have hScard : S.card ≤ k := card_greedyStateAt_le H C omega k
  have hcovered : 8 * S.card < (vertexFinset H).card := by
    omega
  have huncovered : (uncoveredVertices H S).Nonempty := by
    apply Finset.card_pos.mp
    rw [card_uncoveredVertices_of_uniform_matching hH hmatch]
    omega
  obtain ⟨v, hv⟩ := huncovered
  have herr : degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N k S < 0 := by
    rcases hcorridor v hv with hnot | herr
    · exact False.elim (hnot hv)
    · exact herr
  by_contra hnonempty
  have hempty : availableEdges H C S = ∅ := by
    rw [← not_ne_iff]
    simpa only [Finset.nonempty_iff_ne_empty] using hnonempty
  rw [degreeLowerError, hempty] at herr
  simp only [degree, Finset.filter_empty, Finset.card_empty, Nat.cast_zero,
    sub_zero] at herr
  linarith

theorem survivingDegreeUpperStep_eq_timeStep
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (k : ℕ)
    (M M' : Hypergraph V) (hv : v ∈ uncoveredVertices H M') :
    survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) M M' =
      greedyTimeStep
        (degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N) k M M' := by
  simp only [survivingDegreeUpperStep, hv, if_true, greedyTimeStep,
    degreeUpperError, Nat.cast_add, Nat.cast_one]

theorem survivingDegreeLowerStep_eq_timeStep
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (k : ℕ)
    (M M' : Hypergraph V) (hv : v ∈ uncoveredVertices H M') :
    survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) M M' =
      greedyTimeStep
        (degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N) k M M' := by
  simp only [survivingDegreeLowerStep, hv, if_true, greedyTimeStep,
    degreeLowerError, Nat.cast_add, Nat.cast_one]

theorem survivingDegreeUpperExit_imp_tail
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (omega : GreedyOutcome H T) {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hactive : ∀ i, i ≤ k + 1 →
      v ∈ uncoveredVertices H (greedyStateFromAt H C M omega i))
    {t : ℝ}
    (hinitial : degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t)
    (hexit : 0 ≤ degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N
      (k + 1) (greedyStateFromAt H C M omega (k + 1))) :
    t ≤ Freedman.partialSum
      (greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S'))
      (k + 1) omega := by
  apply greedyStoppedStep_exit_imp_tail H C M T Good
    (fun i S S' ↦ survivingDegreeUpperStep H C v
      D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S')
    (degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N)
    omega hk hgood
  · intro i hi
    exact survivingDegreeUpperStep_eq_timeStep H C v
      D₂ D₃ D₄ Gamma epsilon d N i _ _
        (hactive (i + 1) (Nat.succ_le_succ hi))
  · exact hinitial
  · exact hexit

theorem survivingDegreeLowerExit_imp_tail
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (omega : GreedyOutcome H T) {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hactive : ∀ i, i ≤ k + 1 →
      v ∈ uncoveredVertices H (greedyStateFromAt H C M omega i))
    {t : ℝ}
    (hinitial : degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t)
    (hexit : 0 ≤ degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N
      (k + 1) (greedyStateFromAt H C M omega (k + 1))) :
    t ≤ Freedman.partialSum
      (greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S'))
      (k + 1) omega := by
  apply greedyStoppedStep_exit_imp_tail H C M T Good
    (fun i S S' ↦ survivingDegreeLowerStep H C v
      D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S')
    (degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N)
    omega hk hgood
  · intro i hi
    exact survivingDegreeLowerStep_eq_timeStep H C v
      D₂ D₃ D₄ Gamma epsilon d N i _ _
        (hactive (i + 1) (Nat.succ_le_succ hi))
  · exact hinitial
  · exact hexit

theorem survivingDegreeUpperExit_imp_terminalTail
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (omega : GreedyOutcome H T) {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hfailure : ¬ Good (k + 1)
      (greedyStateFromAt H C M omega (k + 1)))
    (hactive : ∀ i, i ≤ k + 1 →
      v ∈ uncoveredVertices H (greedyStateFromAt H C M omega i))
    {t : ℝ}
    (hinitial : degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t)
    (hexit : 0 ≤ degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N
      (k + 1) (greedyStateFromAt H C M omega (k + 1))) :
    t ≤ Freedman.partialSum
      (greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S')) T omega := by
  rw [greedyStoppedStep_partialSum_eq_of_failure H C M T Good _ omega hk hfailure]
  exact survivingDegreeUpperExit_imp_tail H C M T Good v
    D₂ D₃ D₄ Gamma epsilon d N omega hk hgood hactive hinitial hexit

theorem survivingDegreeLowerExit_imp_terminalTail
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (omega : GreedyOutcome H T) {k : ℕ} (hk : k < T)
    (hgood : greedyPrefixGood H C M Good k omega)
    (hfailure : ¬ Good (k + 1)
      (greedyStateFromAt H C M omega (k + 1)))
    (hactive : ∀ i, i ≤ k + 1 →
      v ∈ uncoveredVertices H (greedyStateFromAt H C M omega i))
    {t : ℝ}
    (hinitial : degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t)
    (hexit : 0 ≤ degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N
      (k + 1) (greedyStateFromAt H C M omega (k + 1))) :
    t ≤ Freedman.partialSum
      (greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S')) T omega := by
  rw [greedyStoppedStep_partialSum_eq_of_failure H C M T Good _ omega hk hfailure]
  exact survivingDegreeLowerExit_imp_tail H C M T Good v
    D₂ D₃ D₄ Gamma epsilon d N omega hk hgood hactive hinitial hexit

theorem degreeUpperFirstFailureEvent_subset_tail
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N t : ℝ)
    (hcomponent : ∀ k S, P i k S ↔
      degreeUpperCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k S)
    (hinitial : degreeUpperError H C v
      D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t) :
    greedyFirstFailureEvent H C M T P i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (fun q S S' ↦ survivingDegreeUpperStep H C v
              D₂ D₃ D₄ Gamma epsilon d N (q : ℝ) S S')) T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hfailCorridor : ¬degreeUpperCorridor H C v
      D₂ D₃ D₄ Gamma epsilon d N (k + 1)
        (greedyStateFromAt H C M omega (k + 1)) := by
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hbad := (not_degreeUpperCorridor_iff H C v
    D₂ D₃ D₄ Gamma epsilon d N (k + 1) _).mp hfailCorridor
  have hfailure : ¬indexedGreedyGood P (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  have hactive : ∀ q, q ≤ k + 1 →
      v ∈ uncoveredVertices H (greedyStateFromAt H C M omega q) := by
    intro q hq
    exact mem_uncoveredVertices_greedyStateFromAt_of_le
      H C M omega hq hbad.1
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    survivingDegreeUpperExit_imp_terminalTail H C M T
      (indexedGreedyGood P) v D₂ D₃ D₄ Gamma epsilon d N
      omega hk hgood hfailure hactive hinitial hbad.2⟩

theorem degreeLowerFirstFailureEvent_subset_tail
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (i : ι) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N t : ℝ)
    (hcomponent : ∀ k S, P i k S ↔
      degreeLowerCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k S)
    (hinitial : degreeLowerError H C v
      D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t) :
    greedyFirstFailureEvent H C M T P i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (fun q S S' ↦ survivingDegreeLowerStep H C v
              D₂ D₃ D₄ Gamma epsilon d N (q : ℝ) S S')) T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hfailCorridor : ¬degreeLowerCorridor H C v
      D₂ D₃ D₄ Gamma epsilon d N (k + 1)
        (greedyStateFromAt H C M omega (k + 1)) := by
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hbad := (not_degreeLowerCorridor_iff H C v
    D₂ D₃ D₄ Gamma epsilon d N (k + 1) _).mp hfailCorridor
  have hfailure : ¬indexedGreedyGood P (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  have hactive : ∀ q, q ≤ k + 1 →
      v ∈ uncoveredVertices H (greedyStateFromAt H C M omega q) := by
    intro q hq
    exact mem_uncoveredVertices_greedyStateFromAt_of_le
      H C M omega hq hbad.1
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    survivingDegreeLowerExit_imp_terminalTail H C M T
      (indexedGreedyGood P) v D₂ D₃ D₄ Gamma epsilon d N
      omega hk hgood hfailure hactive hinitial hbad.2⟩

theorem greedyStepExpectation_survivingDegreeSteps
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    (hv : v ∈ uncoveredVertices H M) :
    greedyStepExpectation H C M
        (survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N x M) =
      -meanMissAvailableDegreeLoss H C M v -
        survivingVertexProbability H C v M *
          ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
              CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
            (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
              CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)) ∧
    greedyStepExpectation H C M
        (survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N x M) =
      meanMissAvailableDegreeLoss H C M v +
        survivingVertexProbability H C v M *
          ((CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
              CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
            (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
              CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)) := by
  let I := survivingVertexIndicator H v
  let p := survivingVertexProbability H C v M
  let Y := survivingAvailableDegreeIncrement H C v M
  let du :=
    (CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
        CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
      (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)
  let dl :=
    (CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
        CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
      (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)
  have hY := greedyStepExpectation_survivingAvailableDegreeIncrement
    H C M v hv
  have hI : greedyStepExpectation H C M I = p := rfl
  have hupper :
      survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N x M =
        fun M' ↦ Y M' + (-du) * I M' := by
    funext M'
    by_cases hv' : v ∈ uncoveredVertices H M' <;>
      simp [survivingDegreeUpperStep, Y, I,
        survivingAvailableDegreeIncrement, survivingVertexIndicator,
        hv', du]
    ring
  have hlower :
      survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N x M =
        fun M' ↦ -Y M' + dl * I M' := by
    funext M'
    by_cases hv' : v ∈ uncoveredVertices H M' <;>
      simp [survivingDegreeLowerStep, Y, I,
        survivingAvailableDegreeIncrement, survivingVertexIndicator,
        hv', dl]
    ring
  constructor
  · rw [hupper, greedyStepExpectation_add,
      greedyStepExpectation_const_mul, hY, hI]
    dsimp only [p, du]
    ring
  · rw [hlower, greedyStepExpectation_add, greedyStepExpectation_neg,
      greedyStepExpectation_const_mul, hY, hI]
    dsimp only [p, dl]
    ring

/-- The exact source mean-loss window gives nonpositive one-state drift for
both degree envelopes, with the covering transition correctly frozen. -/
theorem survivingDegree_oneState_stoppedDrift
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ}
    (R : CFMTrajectories.DeltaStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N x P)
    (hv : v ∈ uncoveredVertices H M)
    (hmuLower :
      survivingVertexProbability H C v M *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N x -
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x +
          2 * (d ^ (1 - epsilon) / N)) ≤
        meanMissAvailableDegreeLoss H C M v)
    (hmuUpper :
      meanMissAvailableDegreeLoss H C M v ≤
        survivingVertexProbability H C v M *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N x +
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x -
            2 * (d ^ (1 - epsilon) / N))) :
    greedyStepExpectation H C M
        (survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N x M) ≤ 0 ∧
      greedyStepExpectation H C M
        (survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N x M) ≤ 0 := by
  have hsteps := greedyStepExpectation_survivingDegreeSteps
    H C M v D₂ D₃ D₄ Gamma epsilon d N x hv
  have hsurv := survivingVertexProbability_nonneg H C v M
  have hdHat := CFMTrajectories.dHat_oneStepTaylor_of_registry R.degree
  have hdelta := CFMTrajectories.delta_oneStepTaylor_of_registry R
  rw [abs_le] at hdHat hdelta
  let B := d ^ (1 - epsilon) / N
  let dh := CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
    CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let de := CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
    CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x
  let rh := CFMTrajectories.degreeRate D₂ D₃ D₄ d N x
  let re := CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x
  have hsum : rh + re - 2 * B ≤ dh + de := by
    dsimp only [B, dh, de, rh, re]
    linarith
  have hdiff : dh - de ≤ rh - re + 2 * B := by
    dsimp only [B, dh, de, rh, re]
    linarith
  have hsumMul := mul_le_mul_of_nonneg_left hsum hsurv
  have hdiffMul := mul_le_mul_of_nonneg_left hdiff hsurv
  have hnegLower :
      -meanMissAvailableDegreeLoss H C M v ≤
        survivingVertexProbability H C v M * (rh + re - 2 * B) := by
    calc
      -meanMissAvailableDegreeLoss H C M v ≤
          -(survivingVertexProbability H C v M * (-rh - re + 2 * B)) :=
        neg_le_neg hmuLower
      _ = survivingVertexProbability H C v M * (rh + re - 2 * B) := by ring
  have hanalytic :
      -meanMissAvailableDegreeLoss H C M v -
          survivingVertexProbability H C v M * (dh + de) ≤ 0 ∧
        meanMissAvailableDegreeLoss H C M v +
          survivingVertexProbability H C v M * (dh - de) ≤ 0 := by
    constructor
    · calc
        -meanMissAvailableDegreeLoss H C M v -
              survivingVertexProbability H C v M * (dh + de) ≤
            survivingVertexProbability H C v M * (rh + re - 2 * B) -
              survivingVertexProbability H C v M * (dh + de) :=
          sub_le_sub_right hnegLower _
        _ ≤ 0 := sub_nonpos.mpr hsumMul
    · calc
        meanMissAvailableDegreeLoss H C M v +
              survivingVertexProbability H C v M * (dh - de) ≤
            survivingVertexProbability H C v M * (-rh + re - 2 * B) +
              survivingVertexProbability H C v M * (rh - re + 2 * B) :=
          add_le_add hmuUpper hdiffMul
        _ = 0 := by ring
  rw [hsteps.1, hsteps.2]
  simpa only [dh, de] using hanalytic

noncomputable def meanMissLostDegree (A : Hypergraph V) (v : V) : ℝ :=
  if A = ∅ then 0 else
    (∑ e ∈ A, (missLostDegree A e v : ℝ)) / A.card

theorem meanMissLostDegree_bounds_eight_uniform
    {A : Hypergraph V} (hA8 : IsUniform A 8)
    {Dlo Dhi L : ℕ}
    (hdeglo : ∀ x e, e ∈ A → x ∈ e → Dlo ≤ degree A x)
    (hdeghi : ∀ x e, e ∈ A → x ∈ e → degree A x ≤ Dhi)
    (hco : MaxCodegreeLE A 2 L) (v : V) (hA : A.Nonempty) :
    (degree A v : ℝ) * (7 * Dlo - 28 * L : ℕ) / (A.card : ℝ) ≤
        meanMissLostDegree A v ∧
      meanMissLostDegree A v ≤
        (degree A v : ℝ) * (7 * Dhi : ℕ) / (A.card : ℝ) := by
  have hcard : 0 < (A.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  have hb := sum_missLostDegree_bounds_eight_uniform
    hA8 hdeglo hdeghi hco v
  rw [meanMissLostDegree, if_neg (Finset.nonempty_iff_ne_empty.mp hA)]
  constructor
  · apply div_le_div_of_nonneg_right _ hcard.le
    exact_mod_cast hb.1
  · apply div_le_div_of_nonneg_right _ hcard.le
    exact_mod_cast hb.2

noncomputable def meanConflictLostDegree (H : Hypergraph V)
    (C : ConflictSystem V) (M : Hypergraph V) (v : V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ A,
      (conflictLostDegree C M A e v : ℝ)) / A.card

@[simp] theorem conflictLostDegree_eq_zero_of_mem
    (C : ConflictSystem V) (M A : Hypergraph V)
    {e : Finset V} {v : V} (hve : v ∈ e) :
    conflictLostDegree C M A e v = 0 := by
  rw [conflictLostDegree, Finset.card_eq_zero,
    Finset.filter_eq_empty_iff]
  intro f hf hfv
  have hfres := Finset.mem_filter.mp hf
  exact Finset.disjoint_left.mp hfres.2 hfv.1 hve

/-- Exact matching-then-conflict update after a legal selection. -/
theorem availableEdges_insert_eq_conflictResidual
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (_hM : IsConflictFreeMatching H C M)
    {e : Finset V} (he : e ∈ availableEdges H C M) :
    availableEdges H C (insert e M) =
      (disjointResidual (availableEdges H C M) e).filter fun f ↦
        ConflictFree C (insert f (insert e M)) := by
  let A := availableEdges H C M
  ext f
  constructor
  · intro hfnext
    have hfnext' := mem_availableEdges.mp hfnext
    have hfA : f ∈ A := by
      apply mem_availableEdges.mpr
      refine ⟨hfnext'.1, ?_, ?_⟩
      · intro hfM
        exact hfnext'.2.1 (Finset.mem_insert_of_mem hfM)
      · exact hfnext'.2.2.mono
          (Finset.insert_subset_insert f (Finset.subset_insert e M))
    have hdisj : Disjoint f e := by
      have hpair := hfnext'.2.2.1.2
      exact hpair (Finset.mem_insert_self f (insert e M))
        (Finset.mem_insert_of_mem (Finset.mem_insert_self e M))
        (by
          intro hfe
          subst f
          exact hfnext'.2.1 (Finset.mem_insert_self e M))
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_filter.mpr ⟨hfA, hdisj⟩, hfnext'.2.2.2⟩
  · intro hf
    have hf' := Finset.mem_filter.mp hf
    have hfres := Finset.mem_filter.mp hf'.1
    have hfA' := mem_availableEdges.mp hfres.1
    have hfe : f ≠ e := by
      intro h
      subst f
      obtain ⟨x, hxe⟩ := hHnonempty e (mem_availableEdges.mp he).1
      exact Finset.disjoint_left.mp hfres.2 hxe hxe
    have hfnot : f ∉ insert e M := by
      simp only [Finset.mem_insert, not_or]
      exact ⟨hfe, hfA'.2.1⟩
    have hmatch : IsMatching H (insert f (insert e M)) := by
      rw [isMatching_insert_iff]
      refine ⟨hfA'.1, (mem_availableEdges.mp he).2.2.1, ?_⟩
      intro g hg hgf
      rcases Finset.mem_insert.mp hg with rfl | hgM
      · exact hfres.2
      · have hpair := hfA'.2.2.1.2
        exact hpair (Finset.mem_insert_self f M)
          (Finset.mem_insert_of_mem hgM) hgf.symm
    exact mem_availableEdges.mpr ⟨hfA'.1, hfnot, hmatch, hf'.2⟩

theorem degree_availableEdges_insert_add_losses
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hM : IsConflictFreeMatching H C M)
    {e : Finset V} (he : e ∈ availableEdges H C M) (v : V) :
    degree (availableEdges H C (insert e M)) v +
          conflictLostDegree C M (availableEdges H C M) e v +
        lostDegree (availableEdges H C M) e v =
      degree (availableEdges H C M) v := by
  let A := availableEdges H C M
  let R := disjointResidual A e
  let P : Finset V → Prop := fun f ↦
    ConflictFree C (insert f (insert e M))
  have hnext : availableEdges H C (insert e M) = R.filter P := by
    simpa only [A, R, P] using
      availableEdges_insert_eq_conflictResidual hHnonempty hM he
  have hpartition :
      degree (R.filter P) v + conflictLostDegree C M A e v = degree R v := by
    rw [degree, degree, conflictLostDegree]
    change ((R.filter P).filter fun f ↦ v ∈ f).card +
        (R.filter fun f ↦ v ∈ f ∧ ¬P f).card =
      (R.filter fun f ↦ v ∈ f).card
    have hcomm :
        (R.filter P).filter (fun f ↦ v ∈ f) =
          (R.filter fun f ↦ v ∈ f).filter P := by
      ext f
      simp only [Finset.mem_filter]
      tauto
    rw [hcomm]
    have hnot :
        R.filter (fun f ↦ v ∈ f ∧ ¬P f) =
          (R.filter fun f ↦ v ∈ f).filter fun f ↦ ¬P f := by
      ext f
      simp only [Finset.mem_filter]
      tauto
    rw [hnot]
    exact Finset.card_filter_add_card_filter_not
      (s := R.filter fun f ↦ v ∈ f) P
  rw [hnext]
  have hgeom := degree_disjointResidual_add_lostDegree A e v
  calc
    degree (R.filter P) v + conflictLostDegree C M A e v +
          lostDegree A e v =
        degree R v + lostDegree A e v := by rw [hpartition]
    _ = degree A v := hgeom

theorem missAvailableDegreeLoss_eq_miss_add_conflictLost
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hM : IsConflictFreeMatching H C M)
    {e : Finset V} (he : e ∈ availableEdges H C M) (v : V) :
    missAvailableDegreeLoss H C M e v =
      missLostDegree (availableEdges H C M) e v +
        conflictLostDegree C M (availableEdges H C M) e v := by
  by_cases hve : v ∈ e
  · simp [missAvailableDegreeLoss, hve]
  · rw [missAvailableDegreeLoss, if_neg hve,
      missLostDegree_eq_lostDegree_of_notMem _ hve]
    have hfull := degree_insert_available_add_loss H C M e v
    have hsplit := degree_availableEdges_insert_add_losses
      hHnonempty hM he v
    omega

theorem meanMissAvailableDegreeLoss_eq_add
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hM : IsConflictFreeMatching H C M) (v : V) :
    meanMissAvailableDegreeLoss H C M v =
      meanMissLostDegree (availableEdges H C M) v +
        meanConflictLostDegree H C M v := by
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · simp [meanMissAvailableDegreeLoss, meanMissLostDegree,
      meanConflictLostDegree, A, hA]
  · rw [meanMissAvailableDegreeLoss, meanMissLostDegree,
      meanConflictLostDegree]
    simp only [A, hA, if_false]
    rw [← add_div, ← Finset.sum_add_distrib]
    congr 1
    apply Finset.sum_congr rfl
    intro e he
    exact_mod_cast missAvailableDegreeLoss_eq_miss_add_conflictLost
      hHnonempty hM he v

/-- Double-count conflict deletions by the selected edge and by the killed
edge.  This exposes the per-edge open-conflict count tracked by the source
trajectory `cHat`. -/
theorem sum_conflictLostDegree_eq_sum_blockerChoices
    (C : ConflictSystem V) (M A : Hypergraph V) (v : V) :
    ∑ e ∈ A, conflictLostDegree C M A e v =
      ∑ f ∈ A.filter (v ∈ ·), (conflictBlockerChoices C M A f).card := by
  let r : Finset V → Finset V → Prop := fun e f ↦
    Disjoint f e ∧ ¬ConflictFree C (insert f (insert e M))
  have hdc := Finset.sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
    (r := r) (s := A) (t := A.filter (v ∈ ·))
  simpa only [conflictLostDegree, conflictBlockerChoices, disjointResidual,
    Finset.bipartiteAbove, Finset.bipartiteBelow, r,
    Finset.filter_filter, and_assoc, and_left_comm, disjoint_comm] using hdc

namespace CFMTrajectories

/-- Taylor bridge from a source mean-loss window to both stopped degree
envelope supermartingale drifts. -/
theorem degreeEnvelope_drift_of_meanLoss_window
    {D₂ D₃ D₄ Gamma epsilon d N x P mu : ℝ}
    (R : DeltaStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (hmuLower :
      -degreeRate D₂ D₃ D₄ d N x -
          deltaRate D₂ D₃ D₄ Gamma epsilon d N x +
            2 * (d ^ (1 - epsilon) / N) ≤ mu)
    (hmuUpper :
      mu ≤ -degreeRate D₂ D₃ D₄ d N x +
          deltaRate D₂ D₃ D₄ Gamma epsilon d N x -
            2 * (d ^ (1 - epsilon) / N)) :
    -mu -
        (dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x) -
        (delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          delta D₂ D₃ D₄ Gamma epsilon d N x) ≤ 0 ∧
      mu +
        (dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x) -
        (delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          delta D₂ D₃ D₄ Gamma epsilon d N x) ≤ 0 := by
  have hdHat := dHat_oneStepTaylor_of_registry R.degree
  have hdelta := delta_oneStepTaylor_of_registry R
  rw [abs_le] at hdHat hdelta
  constructor <;> linarith

/-- Source-faithful degree bridge when the stopped process freezes on the
transition that covers the tracked vertex.  Both the random degree loss and
the deterministic trajectory compensation are multiplied by the next-state
survival probability. -/
theorem degreeEnvelope_drift_of_surviving_meanLoss_window
    {D₂ D₃ D₄ Gamma epsilon d N x P mu surv : ℝ}
    (R : DeltaStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (hsurv : 0 ≤ surv)
    (hmuLower :
      surv * (-degreeRate D₂ D₃ D₄ d N x -
          deltaRate D₂ D₃ D₄ Gamma epsilon d N x +
            2 * (d ^ (1 - epsilon) / N)) ≤ mu)
    (hmuUpper :
      mu ≤ surv * (-degreeRate D₂ D₃ D₄ d N x +
          deltaRate D₂ D₃ D₄ Gamma epsilon d N x -
            2 * (d ^ (1 - epsilon) / N))) :
    -mu - surv *
        ((dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x) +
          (delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
            delta D₂ D₃ D₄ Gamma epsilon d N x)) ≤ 0 ∧
      mu + surv *
        ((dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x) -
          (delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
            delta D₂ D₃ D₄ Gamma epsilon d N x)) ≤ 0 := by
  have hdHat := dHat_oneStepTaylor_of_registry R.degree
  have hdelta := delta_oneStepTaylor_of_registry R
  rw [abs_le] at hdHat hdelta
  let B := d ^ (1 - epsilon) / N
  let dh := dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x
  let de := delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
    delta D₂ D₃ D₄ Gamma epsilon d N x
  let rh := degreeRate D₂ D₃ D₄ d N x
  let re := deltaRate D₂ D₃ D₄ Gamma epsilon d N x
  have hsum : rh + re - 2 * B ≤ dh + de := by
    dsimp only [B, dh, de, rh, re]
    linarith
  have hdiff : dh - de ≤ rh - re + 2 * B := by
    dsimp only [B, dh, de, rh, re]
    linarith
  have hsumMul := mul_le_mul_of_nonneg_left hsum hsurv
  have hdiffMul := mul_le_mul_of_nonneg_left hdiff hsurv
  have hnegLower : -mu ≤ surv * (rh + re - 2 * B) := by
    calc
      -mu ≤ -(surv * (-rh - re + 2 * B)) := neg_le_neg hmuLower
      _ = surv * (rh + re - 2 * B) := by ring
  constructor
  · change -mu - surv * (dh + de) ≤ 0
    calc
      -mu - surv * (dh + de) ≤
          surv * (rh + re - 2 * B) - surv * (dh + de) :=
        sub_le_sub_right hnegLower _
      _ ≤ 0 := sub_nonpos.mpr hsumMul
  · change mu + surv * (dh - de) ≤ 0
    calc
      mu + surv * (dh - de) ≤
          surv * (-rh + re - 2 * B) +
            surv * (rh - re + 2 * B) := add_le_add hmuUpper hdiffMul
      _ = 0 := by ring

end CFMTrajectories

namespace CFMRegularization

theorem IsRegularizedBounded.layerMaxDegree_upper
    {H : Hypergraph V} {C : ConflictSystem V} {d Gamma eta : ℝ}
    (hC : IsRegularizedBounded H C d Gamma eta) (hd : 1 ≤ d)
    {r : ℕ} (hr2 : 2 ≤ r) (hr4 : r ≤ 4) :
    (layerMaxDegree H C r : ℝ) ≤
      Gamma * Real.rpow d ((r : ℝ) - 1) := by
  have hdpow : 0 < Real.rpow d ((r : ℝ) - 1) :=
    Real.rpow_pos_of_pos (lt_of_lt_of_le (by norm_num) hd) _
  have hrmem : r ∈ Finset.Icc 2 4 := Finset.mem_Icc.mpr ⟨hr2, hr4⟩
  have hterm :
      (layerMaxDegree H C r : ℝ) / Real.rpow d ((r : ℝ) - 1) ≤
        ∑ s ∈ Finset.Icc 2 4,
          (layerMaxDegree H C s : ℝ) /
            Real.rpow d ((s : ℝ) - 1) := by
    exact Finset.single_le_sum
      (fun s _hs ↦
        show 0 ≤ (layerMaxDegree H C s : ℝ) /
            Real.rpow d ((s : ℝ) - 1) from
          div_nonneg (by positivity) (Real.rpow_nonneg (by positivity) _)) hrmem
  have hle := hterm.trans hC.2.1
  exact (div_le_iff₀ hdpow).mp hle

end CFMRegularization

/-- Exact drift identity for a vertex degree in the empty-conflict greedy
process.  It is the finite double-counting starting point for the stopped
degree supermartingales. -/
theorem greedyStepExpectation_degree_available_empty
    {H M : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hM : IsMatching H M) (v : V)
    (hA : (availableEdges H (∅ : ConflictSystem V) M).Nonempty) :
    greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N => (degree (availableEdges H (∅ : ConflictSystem V) N) v : ℝ)) =
      (degree (availableEdges H (∅ : ConflictSystem V) M) v : ℝ) -
        (∑ e ∈ availableEdges H (∅ : ConflictSystem V) M,
          (lostDegree (availableEdges H (∅ : ConflictSystem V) M) e v : ℝ)) /
          (availableEdges H (∅ : ConflictSystem V) M).card := by
  classical
  let A := availableEdges H (∅ : ConflictSystem V) M
  have hAneNat : A.card ≠ 0 := Finset.card_ne_zero.mpr hA
  have hAneReal : (A.card : ℝ) ≠ 0 := by exact_mod_cast hAneNat
  rw [greedyStepExpectation_eq_average H (∅ : ConflictSystem V) M _ hA]
  have hAvail : A = matchingAvailable H M :=
    availableEdges_empty_eq_matchingAvailable hHnonempty hM
  calc
    (∑ e ∈ A,
        (degree (availableEdges H (∅ : ConflictSystem V) (insert e M)) v : ℝ)) /
          A.card =
        (∑ e ∈ A,
          ((degree A v : ℝ) - (lostDegree A e v : ℝ))) / A.card := by
      congr 1
      apply Finset.sum_congr rfl
      intro e he
      have heMatch : e ∈ matchingAvailable H M := by
        rw [← hAvail]
        exact he
      have hnext := availableEdges_empty_insert hHnonempty hM heMatch
      rw [hnext]
      have hpart := degree_disjointResidual_add_lostDegree A e v
      have hpartR :
          (degree (disjointResidual A e) v : ℝ) +
            (lostDegree A e v : ℝ) = (degree A v : ℝ) := by
        exact_mod_cast hpart
      linarith
    _ = (degree A v : ℝ) -
          (∑ e ∈ A, (lostDegree A e v : ℝ)) / A.card := by
      rw [Finset.sum_sub_distrib]
      simp only [Finset.sum_const, nsmul_eq_mul]
      field_simp

/-- Exact conditional second moment of the raw degree decrement in the
empty-conflict process. -/
theorem greedyStepExpectation_degree_increment_sq_empty
    {H M : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hM : IsMatching H M) (v : V) :
    greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N ↦
          ((degree (availableEdges H (∅ : ConflictSystem V) N) v : ℝ) -
            (degree (availableEdges H (∅ : ConflictSystem V) M) v : ℝ)) ^ 2) =
      meanSqLostDegree
        (availableEdges H (∅ : ConflictSystem V) M) v := by
  classical
  let A := availableEdges H (∅ : ConflictSystem V) M
  by_cases hA : A = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty
      H (∅ : ConflictSystem V) M _ hA]
    simp [A, hA, meanSqLostDegree]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [greedyStepExpectation_eq_average
      H (∅ : ConflictSystem V) M _ hAne,
      meanSqLostDegree_eq_of_nonempty hAne]
    congr 1
    apply Finset.sum_congr rfl
    intro e he
    have hAvail : A = matchingAvailable H M :=
      availableEdges_empty_eq_matchingAvailable hHnonempty hM
    have heMatch : e ∈ matchingAvailable H M := by
      rw [← hAvail]
      exact he
    have hnext := availableEdges_empty_insert hHnonempty hM heMatch
    rw [hnext]
    have hpart := degree_disjointResidual_add_lostDegree A e v
    have hpartR :
        (degree (disjointResidual A e) v : ℝ) +
          (lostDegree A e v : ℝ) = (degree A v : ℝ) := by
      exact_mod_cast hpart
    have hdiff :
        (degree (disjointResidual A e) v : ℝ) - (degree A v : ℝ) =
          -(lostDegree A e v : ℝ) := by
      linarith
    rw [hdiff]
    ring

/-- The exact one-step degree drift, centered by its literal mean deletion,
is zero in the empty-conflict process. -/
theorem greedyStepExpectation_centeredDegree_empty
    {H M : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hM : IsMatching H M) (v : V) (k : ℕ) :
    greedyStepExpectation H (∅ : ConflictSystem V) M
        (greedyLocalIncrement
          (availableDegreeObservable H (∅ : ConflictSystem V) v)
          (fun _ S => meanLostDegree
            (availableEdges H (∅ : ConflictSystem V) S) v) k M) = 0 := by
  let A := availableEdges H (∅ : ConflictSystem V) M
  let X := availableDegreeObservable H (∅ : ConflictSystem V) v
  by_cases hA : A = ∅
  · have hstep := greedyStepExpectation_of_availableEdges_eq_empty
      H (∅ : ConflictSystem V) M
      (greedyLocalIncrement X
        (fun _ S => meanLostDegree
          (availableEdges H (∅ : ConflictSystem V) S) v) k M) hA
    rw [hstep]
    simp [greedyLocalIncrement, X, A, hA, meanLostDegree]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    unfold greedyLocalIncrement
    rw [greedyStepExpectation_sub_current_add]
    have hdrift := greedyStepExpectation_degree_available_empty
      hHnonempty hM v hAne
    change greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N => (degree (availableEdges H (∅ : ConflictSystem V) N) v : ℝ)) -
      (degree (availableEdges H (∅ : ConflictSystem V) M) v : ℝ) +
        meanLostDegree A v = 0
    rw [hdrift, meanLostDegree_eq_of_nonempty hAne]
    dsimp [A]
    ring

/-- Conditional second moment of the centered degree increment.  Centering
subtracts the square of the mean, so the raw mean-square deletion is a
valid predictable variance budget. -/
theorem greedyStepExpectation_centeredDegree_sq_empty
    {H M : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hM : IsMatching H M) (v : V) (k : ℕ) :
    greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N ↦
          (greedyLocalIncrement
            (availableDegreeObservable H (∅ : ConflictSystem V) v)
            (fun _ S ↦ meanLostDegree
              (availableEdges H (∅ : ConflictSystem V) S) v) k M N) ^ 2) ≤
      meanSqLostDegree
        (availableEdges H (∅ : ConflictSystem V) M) v := by
  let A := availableEdges H (∅ : ConflictSystem V) M
  let X := availableDegreeObservable H (∅ : ConflictSystem V) v
  let mu := meanLostDegree A v
  have hcenter := greedyStepExpectation_centeredDegree_empty
    hHnonempty hM v k
  have hcenter' :
      greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N ↦ X N - X M + mu) = 0 := by
    unfold greedyLocalIncrement at hcenter
    change greedyStepExpectation H (∅ : ConflictSystem V) M
      (fun N ↦ X N - X M + mu) = 0 at hcenter
    exact hcenter
  have hdelta :
      greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N ↦ X N - X M) = -mu := by
    rw [greedyStepExpectation_sub_current_add] at hcenter'
    calc
      greedyStepExpectation H (∅ : ConflictSystem V) M
          (fun N ↦ X N - X M) =
          greedyStepExpectation H (∅ : ConflictSystem V) M X - X M := by
            simpa only [add_zero] using
              greedyStepExpectation_sub_current_add
                H (∅ : ConflictSystem V) M X 0
      _ = -mu := by linarith
  have hraw := greedyStepExpectation_degree_increment_sq_empty
    hHnonempty hM v
  have hraw' :
      greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N ↦ (X N - X M) ^ 2) = meanSqLostDegree A v := by
    simpa [X, A, availableDegreeObservable] using hraw
  change greedyStepExpectation H (∅ : ConflictSystem V) M
      (fun N ↦ (X N - X M + mu) ^ 2) ≤ meanSqLostDegree A v
  have hfun : (fun N ↦ (X N - X M + mu) ^ 2) =
      (fun N ↦
        ((X N - X M) ^ 2 + (2 * mu) * (X N - X M)) + mu ^ 2) := by
    funext N
    ring
  rw [hfun, greedyStepExpectation_affine, greedyStepExpectation_add,
    greedyStepExpectation_const_mul, hraw', hdelta]
  nlinarith [sq_nonneg mu]

/-- The centered empty-conflict degree drift identity for every syntactic
state.  If a state has an available extension, admissibility of that
extension implies that the current state is already a matching; if it has
none, the transition is frozen and the identity is immediate.  This form
matches the state-uniform hypotheses of `greedyStateIncrement_momentBounds`. -/
theorem greedyStepExpectation_centeredDegree_empty_allStates
    {H : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (M : Hypergraph V) (v : V) (k : ℕ) :
    greedyStepExpectation H (∅ : ConflictSystem V) M
        (greedyLocalIncrement
          (availableDegreeObservable H (∅ : ConflictSystem V) v)
          (fun _ S ↦ meanLostDegree
            (availableEdges H (∅ : ConflictSystem V) S) v) k M) = 0 := by
  by_cases hA : availableEdges H (∅ : ConflictSystem V) M = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty
      H (∅ : ConflictSystem V) M _ hA]
    simp [greedyLocalIncrement, hA, meanLostDegree]
  · obtain ⟨e, he⟩ := Finset.nonempty_iff_ne_empty.mpr hA
    have hM : IsMatching H M :=
      (mem_availableEdges.mp he).2.2.1.mono (Finset.subset_insert e M)
    exact greedyStepExpectation_centeredDegree_empty hHnonempty hM v k

/-- State-uniform predictable second-moment bound for the same centered
degree increment. -/
theorem greedyStepExpectation_centeredDegree_sq_empty_allStates
    {H : Hypergraph V} (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (M : Hypergraph V) (v : V) (k : ℕ) :
    greedyStepExpectation H (∅ : ConflictSystem V) M
        (fun N ↦
          (greedyLocalIncrement
            (availableDegreeObservable H (∅ : ConflictSystem V) v)
            (fun _ S ↦ meanLostDegree
              (availableEdges H (∅ : ConflictSystem V) S) v) k M N) ^ 2) ≤
      meanSqLostDegree
        (availableEdges H (∅ : ConflictSystem V) M) v := by
  by_cases hA : availableEdges H (∅ : ConflictSystem V) M = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty
      H (∅ : ConflictSystem V) M _ hA]
    simp [greedyLocalIncrement, hA, meanSqLostDegree, meanLostDegree]
  · obtain ⟨e, he⟩ := Finset.nonempty_iff_ne_empty.mpr hA
    have hM : IsMatching H M :=
      (mem_availableEdges.mp he).2.2.1.mono (Finset.subset_insert e M)
    exact greedyStepExpectation_centeredDegree_sq_empty hHnonempty hM v k

/-- The exact finite conditional-moment package for an available-degree
martingale in the empty-conflict random greedy process.  The deterministic
budget `d²` is deliberately coarse; stopped trajectory arguments replace it
by the sharper envelope budget, while reusing the same drift identities. -/
theorem emptyDegree_momentBounds (H : Hypergraph V) (M : Hypergraph V)
    (T : ℕ) (v : V) (d : ℝ) (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hdeg : (degree H v : ℝ) ≤ d) :
    Freedman.ConditionalMomentBounds
      (greedyPathMassFrom H (∅ : ConflictSystem V) M) (greedyInfo H T)
      (greedyStateIncrement H (∅ : ConflictSystem V) M T
        (availableDegreeObservable H (∅ : ConflictSystem V) v)
        (fun _ S ↦ meanLostDegree
          (availableEdges H (∅ : ConflictSystem V) S) v))
      (fun _ ↦ d ^ 2) := by
  apply greedyStateIncrement_momentBounds
  · intro k
    positivity
  · intro k hk S
    rw [greedyStepExpectation_centeredDegree_empty_allStates
      hHnonempty S v k]
  · intro k hk S
    exact (greedyStepExpectation_centeredDegree_sq_empty_allStates
      hHnonempty S v k).trans
        (meanSqLostDegree_available_le_sq
          H (∅ : ConflictSystem V) S v d hdeg)

/-- A coarse but state-uniform increment bound.  Both endpoint degrees and
the mean deletion lie in `[0,d]`, so the centered increment has magnitude at
most `2d`. -/
theorem availableDegree_centeredIncrement_abs_le_two_mul
    (H : Hypergraph V) (C : ConflictSystem V) (v : V) (d : ℝ)
    (hdeg : (degree H v : ℝ) ≤ d) (S S' : Hypergraph V) :
    |availableDegreeObservable H C v S' -
        availableDegreeObservable H C v S +
        meanLostDegree (availableEdges H C S) v| ≤ 2 * d := by
  let A := availableEdges H C S
  let A' := availableEdges H C S'
  have hA : A ⊆ H := availableEdges_subset H C S
  have hA' : A' ⊆ H := availableEdges_subset H C S'
  have hD : (degree A v : ℝ) ≤ d := by
    exact (by exact_mod_cast degree_mono hA v :
      (degree A v : ℝ) ≤ degree H v).trans hdeg
  have hD' : (degree A' v : ℝ) ≤ d := by
    exact (by exact_mod_cast degree_mono hA' v :
      (degree A' v : ℝ) ≤ degree H v).trans hdeg
  have hmu := meanLostDegree_le_degree A v
  have hmu0 := meanLostDegree_nonneg A v
  have hD0 : 0 ≤ (degree A v : ℝ) := by positivity
  have hD'0 : 0 ≤ (degree A' v : ℝ) := by positivity
  change |(degree A' v : ℝ) - (degree A v : ℝ) +
    meanLostDegree A v| ≤ 2 * d
  rw [abs_le]
  constructor <;> nlinarith

theorem emptyDegree_increment_abs_le_two_mul (H : Hypergraph V)
    (M : Hypergraph V) (T : ℕ) (v : V) (d : ℝ)
    (hdeg : (degree H v : ℝ) ≤ d) :
    ∀ k ω,
      |greedyStateIncrement H (∅ : ConflictSystem V) M T
        (availableDegreeObservable H (∅ : ConflictSystem V) v)
        (fun _ S ↦ meanLostDegree
          (availableEdges H (∅ : ConflictSystem V) S) v) k ω| ≤ 2 * d := by
  intro k ω
  by_cases hk : k < T
  · simp only [greedyStateIncrement, hk, if_true, greedyLocalIncrement]
    exact availableDegree_centeredIncrement_abs_le_two_mul
      H (∅ : ConflictSystem V) v d hdeg
        (greedyStateFromAt H (∅ : ConflictSystem V) M ω k)
        (greedyStateFromAt H (∅ : ConflictSystem V) M ω (k + 1))
  · simp [greedyStateIncrement, hk]
    have hd0 : 0 ≤ d := (show (0 : ℝ) ≤ degree H v by positivity).trans hdeg
    linarith

/-- A complete finite Freedman tail for the centered available-degree
martingale in the empty-conflict process. -/
theorem emptyDegree_freedman (H : Hypergraph V) (M : Hypergraph V)
    (T : ℕ) (v : V) (d t : ℝ)
    (hHnonempty : ∀ e ∈ H, e.Nonempty)
    (hdeg : (degree H v : ℝ) ≤ d) (ht : 0 ≤ t)
    (hden : 0 < (T : ℝ) * d ^ 2 + (2 * d) * t) :
    Freedman.eventMass (greedyPathMassFrom H (∅ : ConflictSystem V) M)
        (Finset.univ.filter (fun ω ↦
          t ≤ Freedman.partialSum
            (greedyStateIncrement H (∅ : ConflictSystem V) M T
              (availableDegreeObservable H (∅ : ConflictSystem V) v)
              (fun _ S ↦ meanLostDegree
                (availableEdges H (∅ : ConflictSystem V) S) v)) T ω)) ≤
      Real.exp (-(t ^ 2) /
        (4 * ((T : ℝ) * d ^ 2 + (2 * d) * t))) := by
  have hd0 : 0 ≤ d := (show (0 : ℝ) ≤ degree H v by positivity).trans hdeg
  apply Freedman.freedman
      (greedyPathMassFrom_nonneg H (∅ : ConflictSystem V) M)
      (sum_greedyPathMassFrom H (∅ : ConflictSystem V) M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStateIncrement_known H (∅ : ConflictSystem V) M T
        (availableDegreeObservable H (∅ : ConflictSystem V) v)
        (fun _ S ↦ meanLostDegree
          (availableEdges H (∅ : ConflictSystem V) S) v) k)
      (emptyDegree_momentBounds H M T v d hHnonempty hdeg)
      (mul_nonneg (by norm_num) hd0) ht
      (mul_nonneg (Nat.cast_nonneg T) (sq_nonneg d)) hden
      (emptyDegree_increment_abs_le_two_mul H M T v d hdeg)
  simp

/-! ## Simultaneous good-outcome extraction -/

theorem eventMass_mono_of_nonneg {Omega : Type*} [Fintype Omega]
    (p : Omega → ℝ) (hp : ∀ omega, 0 ≤ p omega)
    {A B : Finset Omega} (hAB : A ⊆ B) :
    Freedman.eventMass p A ≤ Freedman.eventMass p B := by
  unfold Freedman.eventMass
  exact Finset.sum_le_sum_of_subset_of_nonneg hAB (fun omega _ _ ↦ hp omega)

theorem exists_positive_avoiding_of_eventMass_sum_lt_one
    {Omega iota : Type*} [Fintype Omega] [DecidableEq Omega] [Fintype iota]
    (p : Omega → ℝ) (hp : ∀ omega, 0 ≤ p omega)
    (hp_one : ∑ omega, p omega = 1)
    (Bad : iota → Finset Omega) (bound : iota → ℝ)
    (hBad : ∀ i, Freedman.eventMass p (Bad i) ≤ bound i)
    (hbound : (∑ i, bound i) < 1) :
    ∃ omega, 0 < p omega ∧ ∀ i, omega ∉ Bad i := by
  classical
  by_contra hnone
  push Not at hnone
  have hpoint : ∀ omega, p omega ≤
      ∑ i, if omega ∈ Bad i then p omega else 0 := by
    intro omega
    by_cases hpos : 0 < p omega
    · obtain ⟨i, hi⟩ := hnone omega hpos
      calc
        p omega = (if omega ∈ Bad i then p omega else 0) := by simp [hi]
        _ ≤ ∑ j, if omega ∈ Bad j then p omega else 0 := by
          have hsingle :
              (if omega ∈ Bad i then p omega else 0) ≤
                (Finset.univ : Finset iota).sum
                  (fun j ↦ if omega ∈ Bad j then p omega else 0) := by
            refine Finset.single_le_sum
              (s := (Finset.univ : Finset iota))
              (f := fun j : iota ↦ if omega ∈ Bad j then p omega else 0) ?_ ?_
            · intro j hj
              split_ifs
              · exact hp omega
              · exact le_rfl
            · exact Finset.mem_univ i
          simpa using hsingle
    · have hpzero : p omega = 0 :=
        le_antisymm (not_lt.mp hpos) (hp omega)
      simp [hpzero]
  have htotal : (∑ omega, p omega) ≤
      ∑ i, Freedman.eventMass p (Bad i) := by
    calc
      (∑ omega, p omega) ≤
          ∑ omega, ∑ i, if omega ∈ Bad i then p omega else 0 :=
        Finset.sum_le_sum fun omega _ ↦ hpoint omega
      _ = ∑ i, ∑ omega, if omega ∈ Bad i then p omega else 0 := by
        rw [Finset.sum_comm]
      _ = ∑ i, Freedman.eventMass p (Bad i) := by
        apply Finset.sum_congr rfl
        intro i hi
        simp [Freedman.eventMass]
  have hone_le : (1 : ℝ) ≤ ∑ i, bound i := by
    rw [← hp_one]
    exact htotal.trans (Finset.sum_le_sum fun i _ ↦ hBad i)
  exact (not_lt_of_ge hone_le) hbound

theorem greedyChoiceStep_card_eq_add_one_of_mass_pos
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (o : GreedyChoice H) (hA : (availableEdges H C M).Nonempty)
    (hmass : 0 < greedyTransitionMass H C M o) :
    (greedyChoiceStep H C M o).card = M.card + 1 := by
  classical
  have hAne : availableEdges H C M ≠ ∅ :=
    Finset.nonempty_iff_ne_empty.mp hA
  rcases o with _ | e
  · simp [greedyTransitionMass, hAne] at hmass
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · simp only [greedyChoiceStep]
      exact card_greedyStep_of_mem he
    · simp [greedyTransitionMass, hAne, he] at hmass

theorem card_greedyStateFromAt_eq_add_of_pos_mass_nonfreeze
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {T : ℕ} (omega : GreedyOutcome H T)
    (hmass : 0 < greedyPathMassFrom H C M omega)
    (hnonfreeze : ∀ k, k < T →
      (availableEdges H C (greedyStateFromAt H C M omega k)).Nonempty) :
    (greedyStateFromAt H C M omega T).card = M.card + T := by
  induction T generalizing M with
  | zero => simp
  | succ T ih =>
      let o : GreedyChoice H := omega 0
      let tail : GreedyOutcome H T := fun i ↦ omega i.succ
      have htail0 : 0 ≤ greedyPathMassFrom H C
          (greedyChoiceStep H C M o) tail :=
        greedyPathMassFrom_nonneg H C _ _
      have hhead0 : 0 ≤ greedyTransitionMass H C M o :=
        greedyTransitionMass_nonneg H C M o
      have hsplit : 0 < greedyTransitionMass H C M o *
          greedyPathMassFrom H C (greedyChoiceStep H C M o) tail := by
        simpa [o, tail] using hmass
      have hhead : 0 < greedyTransitionMass H C M o := by nlinarith
      have htail : 0 < greedyPathMassFrom H C
          (greedyChoiceStep H C M o) tail := by nlinarith
      have homega : Fin.cons o tail = omega := by
        funext i
        refine Fin.cases ?_ (fun j ↦ ?_) i
        · simp [o]
        · simp [tail]
      have hA0 : (availableEdges H C M).Nonempty := by
        have := hnonfreeze 0 (Nat.zero_lt_succ T)
        simpa using this
      have hcardStep : (greedyChoiceStep H C M o).card = M.card + 1 :=
        greedyChoiceStep_card_eq_add_one_of_mass_pos H C M o hA0 hhead
      have hnonfreezeTail : ∀ k, k < T →
          (availableEdges H C
            (greedyStateFromAt H C (greedyChoiceStep H C M o) tail k)).Nonempty := by
        intro k hk
        have hprefix := hnonfreeze (k + 1) (by omega)
        rw [← homega] at hprefix
        simpa only [greedyStateFromAt_cons_succ] using hprefix
      have hcardTail := ih (greedyChoiceStep H C M o) tail htail hnonfreezeTail
      rw [← homega, greedyStateFromAt_cons_succ]
      rw [hcardTail, hcardStep]
      omega

/-- Union-bound extraction after the stopped degree and test tails have
been proved.  The nonfreeze implication then certifies an actual length-`m`
conflict-free matching rather than a frozen path. -/
theorem exists_good_greedy_outcome_card_eq_of_degree_test_tails
    {iotaDegree iotaTest : Type*} [Fintype iotaDegree] [Fintype iotaTest]
    (H : Hypergraph V) (C : ConflictSystem V) (m : ℕ)
    (degreeBad : iotaDegree → Finset (GreedyOutcome H m))
    (testBad : iotaTest → Finset (GreedyOutcome H m))
    (degreeTail : iotaDegree → ℝ) (testTail : iotaTest → ℝ)
    (hdegree : ∀ i,
      Freedman.eventMass (normalizedGreedyPathMass H C) (degreeBad i) ≤
        degreeTail i)
    (htest : ∀ i,
      Freedman.eventMass (normalizedGreedyPathMass H C) (testBad i) ≤
        testTail i)
    (htotal : (∑ i, degreeTail i) + (∑ i, testTail i) < 1)
    (hnonfreeze : ∀ omega : GreedyOutcome H m,
      (∀ i, omega ∉ degreeBad i) → (∀ i, omega ∉ testBad i) →
      ∀ k, k < m →
        (availableEdges H C (greedyStateAt H C omega k)).Nonempty)
    (hC : ∅ ∉ C) :
    ∃ omega : GreedyOutcome H m,
      (∀ i, omega ∉ degreeBad i) ∧ (∀ i, omega ∉ testBad i) ∧
      IsConflictFreeMatching H C (greedyStateAt H C omega m) ∧
      (greedyStateAt H C omega m).card = m := by
  let Bad : Sum iotaDegree iotaTest → Finset (GreedyOutcome H m)
    | Sum.inl i => degreeBad i
    | Sum.inr i => testBad i
  let tail : Sum iotaDegree iotaTest → ℝ
    | Sum.inl i => degreeTail i
    | Sum.inr i => testTail i
  have hBad : ∀ a,
      Freedman.eventMass (normalizedGreedyPathMass H C) (Bad a) ≤ tail a := by
    rintro (i | i)
    · exact hdegree i
    · exact htest i
  have htail : (∑ a, tail a) < 1 := by
    rw [Fintype.sum_sum_type]
    exact htotal
  obtain ⟨omega, hmass, hgood⟩ :=
    exists_positive_avoiding_of_eventMass_sum_lt_one
      (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (sum_normalizedGreedyPathMass H C m)
      Bad tail hBad htail
  have hdegreeGood : ∀ i, omega ∉ degreeBad i :=
    fun i ↦ hgood (Sum.inl i)
  have htestGood : ∀ i, omega ∉ testBad i :=
    fun i ↦ hgood (Sum.inr i)
  refine ⟨omega, hdegreeGood, htestGood,
    greedyStateAt_isConflictFreeMatching H C hC omega m, ?_⟩
  rw [greedyStateAt_eq_stateFrom_empty]
  simpa using card_greedyStateFromAt_eq_add_of_pos_mass_nonfreeze
    H C ∅ omega hmass (by
      intro k hk
      rw [← greedyStateAt_eq_stateFrom_empty]
      exact hnonfreeze omega hdegreeGood htestGood k hk)

/-- Simultaneous first-failure union bound.  Avoiding the stopped tail for
every indexed corridor forces the full good predicate, keeps the process
unfrozen, and therefore produces a conflict-free matching of the prescribed
integer size. -/
theorem exists_greedy_outcome_of_firstFailureTails
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (tail : ι → ℝ)
    (hBad : ∀ i,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T P i) ≤ tail i)
    (htotal : (∑ i, tail i) < 1)
    (hinitial : ∀ i, P i 0 ∅)
    (hnonfreeze : ∀ k, k < T → ∀ S,
      indexedGreedyGood P k S → (availableEdges H C S).Nonempty)
    (hC : ∅ ∉ C) :
    ∃ omega : GreedyOutcome H T,
      greedyPrefixGood H C ∅ (indexedGreedyGood P) T omega ∧
      IsConflictFreeMatching H C (greedyStateAt H C omega T) ∧
      (greedyStateAt H C omega T).card = T := by
  obtain ⟨omega, hmass, havoid⟩ :=
    exists_positive_avoiding_of_eventMass_sum_lt_one
      (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (sum_normalizedGreedyPathMass H C T)
      (greedyFirstFailureEvent H C ∅ T P) tail hBad htotal
  have hpref := greedyPrefixGood_of_avoids_firstFailureEvents
    H C ∅ T P omega hinitial havoid
  have hrun : ∀ k, k < T →
      (availableEdges H C (greedyStateFromAt H C ∅ omega k)).Nonempty := by
    intro k hk
    exact hnonfreeze k hk _ (hpref k (Nat.le_of_lt hk))
  refine ⟨omega, hpref, greedyStateAt_isConflictFreeMatching H C hC omega T, ?_⟩
  rw [greedyStateAt_eq_stateFrom_empty]
  simpa using card_greedyStateFromAt_eq_add_of_pos_mass_nonfreeze
    H C ∅ omega hmass hrun

/-- Reachable-state version of the simultaneous first-failure extraction.
Only states on a prefix-good tape need to be shown nonterminal. -/
theorem exists_greedy_outcome_of_firstFailureTails_reachable
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V) (T : ℕ)
    (P : iota → ℕ → Hypergraph V → Prop) (tail : iota → ℝ)
    (hBad : ∀ i,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T P i) ≤ tail i)
    (htotal : (∑ i, tail i) < 1)
    (hinitial : ∀ i, P i 0 ∅)
    (hnonfreeze : ∀ omega : GreedyOutcome H T,
      greedyPrefixGood H C ∅ (indexedGreedyGood P) T omega →
      ∀ k, k < T →
        (availableEdges H C (greedyStateAt H C omega k)).Nonempty)
    (hC : ∅ ∉ C) :
    ∃ omega : GreedyOutcome H T,
      greedyPrefixGood H C ∅ (indexedGreedyGood P) T omega ∧
      IsConflictFreeMatching H C (greedyStateAt H C omega T) ∧
      (greedyStateAt H C omega T).card = T := by
  obtain ⟨omega, hmass, havoid⟩ :=
    exists_positive_avoiding_of_eventMass_sum_lt_one
      (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (sum_normalizedGreedyPathMass H C T)
      (greedyFirstFailureEvent H C ∅ T P) tail hBad htotal
  have hpref := greedyPrefixGood_of_avoids_firstFailureEvents
    H C ∅ T P omega hinitial havoid
  have hrun : ∀ k, k < T →
      (availableEdges H C (greedyStateFromAt H C ∅ omega k)).Nonempty := by
    intro k hk
    rw [← greedyStateAt_eq_stateFrom_empty]
    exact hnonfreeze omega hpref k hk
  refine ⟨omega, hpref, greedyStateAt_isConflictFreeMatching H C hC omega T, ?_⟩
  rw [greedyStateAt_eq_stateFrom_empty]
  simpa using card_greedyStateFromAt_eq_add_of_pos_mass_nonfreeze
    H C ∅ omega hmass hrun

/-- Finite dependent choice for a conflict-free greedy process.  The proof is
ordinary induction on the requested cardinality. -/
theorem exists_conflictFree_matching_card_eq_of_extendableWithInvariant
    (H : Hypergraph V) (C : ConflictSystem V) (P : Hypergraph V → Prop)
    {target : ℕ} (hC : ∅ ∉ C)
    (hext : ExtendableWithInvariant H C target P) :
    ∃ M, IsConflictFreeMatching H C M ∧ P M ∧ M.card = target := by
  have step : ∀ k, k ≤ target →
      ∃ M, IsConflictFreeMatching H C M ∧ P M ∧ M.card = k := by
    intro k hk
    induction k with
    | zero =>
        exact ⟨∅, isConflictFreeMatching_empty H hC, hext.1, rfl⟩
    | succ k ih =>
        have hk' : k ≤ target := Nat.le_trans (Nat.le_succ k) hk
        obtain ⟨M, hM, hPM, hcard⟩ := ih hk'
        have hlt : M.card < target := by
          rw [hcard]
          exact Nat.lt_of_succ_le hk
        obtain ⟨e, heH, heM, hins, hPins⟩ := hext.2 M hM hPM hlt
        refine ⟨insert e M, hins, hPins, ?_⟩
        simp [heM, hcard]
  exact step target le_rfl

/-- A conflict-free matching of exactly `target` edges follows from the
invariant-free extension property. -/
theorem exists_conflictFree_matching_card_eq_of_extendable
    (H : Hypergraph V) (C : ConflictSystem V) {target : ℕ}
    (hC : ∅ ∉ C) (hext : Extendable H C target) :
    ∃ M, IsMatching H M ∧ ConflictFree C M ∧ M.card = target := by
  obtain ⟨M, hM, -, hcard⟩ :=
    exists_conflictFree_matching_card_eq_of_extendableWithInvariant
      H C (fun _ => True) hC hext
  exact ⟨M, hM.1, hM.2, hcard⟩

/-- A terminal relative-error condition for a finite family of test
functions.  This is the symmetric `(1 ± err)` notation written as two
inequalities. -/
def partialTestTotal (w : TestWeight V) (H A M : Hypergraph V)
    (j s : ℕ) : ℝ :=
  ∑ S ∈ (H.powersetCard j).filter (fun S ↦
    (S ∩ A).card = s ∧ (S ∩ M).card = j - s), w S

/-- Unweighted source partial family: `s` members remain available and all
other members have already been selected. -/
def partialFamily (X : ConflictSystem V) (A M : Hypergraph V)
    (s : ℕ) : ConflictSystem V :=
  X.filter fun Q ↦
    (Q ∩ A).card = s ∧ (Q ∩ M).card = Q.card - s

@[simp] theorem mem_partialFamily
    {X : ConflictSystem V} {A M : Hypergraph V} {s : ℕ}
    {Q : Hypergraph V} :
    Q ∈ partialFamily X A M s ↔
      Q ∈ X ∧ (Q ∩ A).card = s ∧
        (Q ∩ M).card = Q.card - s := by
  simp [partialFamily]

/-- At time zero, a `q`-uniform family supported on the host lies entirely
in its all-available partial component. -/
theorem partialFamily_initial_of_uniform_subset
    {X : ConflictSystem V} {H : Hypergraph V} {q : ℕ}
    (hX : IsUniform X q) (hXH : ∀ Q ∈ X, Q ⊆ H) :
    partialFamily X H ∅ q = X := by
  ext Q
  constructor
  · exact fun hQ ↦ (mem_partialFamily.mp hQ).1
  · intro hQ
    apply mem_partialFamily.mpr
    refine ⟨hQ, ?_, ?_⟩
    · rw [Finset.inter_eq_left.mpr (hXH Q hQ), hX Q hQ]
    · simp [hX Q hQ]

theorem conflictLinkLayer_subset_host
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (e : Finset V) (q : ℕ) :
    ∀ Q ∈ conflictLinkLayer C e q, Q ⊆ H := by
  intro Q hQ
  obtain ⟨⟨c, hcC, _hec, rfl⟩, _⟩ := mem_conflictLinkLayer.mp hQ
  exact (Finset.erase_subset e c).trans (hC c hcC)

theorem conflictLinkLayer_uniform (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) :
    IsUniform (conflictLinkLayer C e q) q := by
  intro Q hQ
  exact (mem_conflictLinkLayer.mp hQ).2

@[simp] theorem partialConflictLink_initial
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (e : Finset V) (q : ℕ) :
    partialFamily (conflictLinkLayer C e q) H ∅ q =
      conflictLinkLayer C e q :=
  partialFamily_initial_of_uniform_subset
    (conflictLinkLayer_uniform C e q)
    (conflictLinkLayer_subset_host hC e q)

/-- Available edges which complete a conflict through `e`, represented by
the one-available partial layers of the three possible link sizes. -/
def activeConflictBlockers (C : ConflictSystem V) (A M : Hypergraph V)
    (e : Finset V) : Hypergraph V :=
  (Finset.Icc 1 3).biUnion fun q ↦
    (partialFamily (conflictLinkLayer C e q) A M 1).biUnion id

/-- Every genuinely conflict-deleting legal choice occurs in a one-available
partial link through the deleted edge.  The right-hand side deliberately
keeps all members of the partial link; this mild overcount is what the
source spread estimates subsequently control. -/
theorem conflictBlockerChoices_subset_activeConflictBlockers
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    conflictBlockerChoices C M (availableEdges H C M) f ⊆
      activeConflictBlockers C (availableEdges H C M) M f := by
  intro e he
  have he' := Finset.mem_filter.mp he
  let A := availableEdges H C M
  have heA : e ∈ A := he'.1
  obtain ⟨c, hcC, hcsub⟩ := not_conflictFree_iff.mp he'.2.2
  have hfreeE : ConflictFree C (insert e M) :=
    (mem_availableEdges.mp heA).2.2.2
  have hfreeF : ConflictFree C (insert f M) :=
    (mem_availableEdges.mp hf).2.2.2
  have hfc : f ∈ c := by
    by_contra hfc
    apply hfreeE c hcC
    intro g hgc
    rcases Finset.mem_insert.mp (hcsub hgc) with rfl | hg
    · exact False.elim (hfc hgc)
    · exact hg
  have hec : e ∈ c := by
    by_contra hec
    apply hfreeF c hcC
    intro g hgc
    rcases Finset.mem_insert.mp (hcsub hgc) with hgf | hg
    · exact Finset.mem_insert.mpr (Or.inl hgf)
    · rcases Finset.mem_insert.mp hg with hge | hgM
      · exact False.elim (hec (hge ▸ hgc))
      · exact Finset.mem_insert_of_mem hgM
  have hef : e ≠ f := by
    intro hef
    subst e
    apply hfreeF c hcC
    simpa using hcsub
  let Q := c.erase f
  let q := Q.card
  have hQlink : Q ∈ conflictLinkLayer C f q := by
    exact mem_conflictLinkLayer.mpr ⟨⟨c, hcC, hfc, rfl⟩, rfl⟩
  have hq : q ∈ Finset.Icc 1 3 := by
    have hcard := hC c hcC
    have hqcard : q + 1 = c.card := by
      simpa only [Q, q] using (Finset.card_erase_add_one hfc)
    exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  have heQ : e ∈ Q := by
    simp only [Q, Finset.mem_erase]
    exact ⟨hef, hec⟩
  have hQA : Q ∩ A = {e} := by
    ext g
    constructor
    · intro hg
      have hgQ := (Finset.mem_inter.mp hg).1
      have hgA := (Finset.mem_inter.mp hg).2
      have hgC : g ∈ c := (Finset.mem_erase.mp hgQ).2
      have hgf : g ≠ f := (Finset.mem_erase.mp hgQ).1
      rcases Finset.mem_insert.mp (hcsub hgC) with hgf' | hgrest
      · exact False.elim (hgf hgf')
      · rcases Finset.mem_insert.mp hgrest with hge | hgM
        · simpa [hge]
        · exact False.elim ((mem_availableEdges.mp hgA).2.1 hgM)
    · intro hg
      have hge : g = e := Finset.mem_singleton.mp hg
      subst g
      exact Finset.mem_inter.mpr ⟨heQ, heA⟩
  have hQM : Q ∩ M = Q.erase e := by
    ext g
    constructor
    · intro hg
      have hgQ := (Finset.mem_inter.mp hg).1
      have hgM := (Finset.mem_inter.mp hg).2
      exact Finset.mem_erase.mpr
        ⟨by
          intro hge
          subst g
          exact (mem_availableEdges.mp heA).2.1 hgM,
        hgQ⟩
    · intro hg
      have hg' := Finset.mem_erase.mp hg
      have hgQ := hg'.2
      have hgC : g ∈ c := (Finset.mem_erase.mp hgQ).2
      have hgf : g ≠ f := (Finset.mem_erase.mp hgQ).1
      rcases Finset.mem_insert.mp (hcsub hgC) with hgf' | hgrest
      · exact False.elim (hgf hgf')
      · rcases Finset.mem_insert.mp hgrest with hge | hgM
        · exact False.elim (hg'.1 hge)
        · exact Finset.mem_inter.mpr ⟨hgQ, hgM⟩
  have hQpartial :
      Q ∈ partialFamily (conflictLinkLayer C f q) A M 1 := by
    rw [mem_partialFamily]
    refine ⟨hQlink, ?_, ?_⟩
    · rw [hQA]
      simp
    · rw [hQM, Finset.card_erase_of_mem heQ]
  unfold activeConflictBlockers
  exact Finset.mem_biUnion.mpr ⟨q, hq,
    Finset.mem_biUnion.mpr ⟨Q, hQpartial, heQ⟩⟩

theorem card_conflictBlockerChoices_le_activeConflictBlockers
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    (conflictBlockerChoices C M (availableEdges H C M) f).card ≤
      (activeConflictBlockers C (availableEdges H C M) M f).card :=
  Finset.card_le_card
    (conflictBlockerChoices_subset_activeConflictBlockers hC hf)

/-- Conversely, an active partial-link member which is still available and
disjoint from the distinguished edge is a genuine conflict-deleting
choice.  No conflict-size hypothesis is needed in this direction. -/
theorem activeConflictBlockers_available_disjoint_subset
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {f : Finset V} :
    (activeConflictBlockers C (availableEdges H C M) M f).filter
        (fun e ↦ e ∈ availableEdges H C M ∧ Disjoint e f) ⊆
      conflictBlockerChoices C M (availableEdges H C M) f := by
  let A := availableEdges H C M
  intro e he
  have he' : e ∈ activeConflictBlockers C A M f ∧
      e ∈ A ∧ Disjoint e f := by
    simpa only [Finset.mem_filter, A] using he
  obtain ⟨heActive, heA, hefDisjoint⟩ := he'
  unfold activeConflictBlockers at heActive
  obtain ⟨q, _hq, heActive⟩ := Finset.mem_biUnion.mp heActive
  obtain ⟨Q, hQpartial, heQ⟩ := Finset.mem_biUnion.mp heActive
  have heQ' : e ∈ Q := by simpa only [id_eq] using heQ
  obtain ⟨hQlink, _hQAcard, hQMcard⟩ := mem_partialFamily.mp hQpartial
  obtain ⟨⟨c, hcC, hfc, hcErase⟩, _hQcard⟩ :=
    mem_conflictLinkLayer.mp hQlink
  have heNotM : e ∉ M :=
    (mem_availableEdges.mp (by simpa only [A] using heA)).2.1
  have hQMsub : Q ∩ M ⊆ Q.erase e := by
    intro g hg
    have hg' := Finset.mem_inter.mp hg
    exact Finset.mem_erase.mpr
      ⟨fun hge ↦ heNotM (hge ▸ hg'.2), hg'.1⟩
  have hQMcard' : (Q ∩ M).card = (Q.erase e).card := by
    rw [hQMcard, Finset.card_erase_of_mem heQ']
  have hQMeq : Q ∩ M = Q.erase e :=
    Finset.eq_of_subset_of_card_le hQMsub (by omega)
  have hQcover : Q ⊆ insert e M := by
    intro g hgQ
    by_cases hge : g = e
    · exact Finset.mem_insert.mpr (Or.inl hge)
    · apply Finset.mem_insert.mpr
      apply Or.inr
      have hgerase : g ∈ Q.erase e := Finset.mem_erase.mpr ⟨hge, hgQ⟩
      rw [← hQMeq] at hgerase
      exact (Finset.mem_inter.mp hgerase).2
  have hcsub : c ⊆ insert f (insert e M) := by
    rw [← Finset.insert_erase hfc]
    rw [hcErase]
    exact Finset.insert_subset_insert f hQcover
  apply Finset.mem_filter.mpr
  refine ⟨by simpa only [A] using heA, hefDisjoint, ?_⟩
  exact not_conflictFree_iff.mpr ⟨c, hcC, hcsub⟩

/-- Exact state-level characterization of the newly completed-conflict
choices by the one-available partial links. -/
theorem conflictBlockerChoices_eq_active_available_disjoint
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {f : Finset V} (hf : f ∈ availableEdges H C M) :
    conflictBlockerChoices C M (availableEdges H C M) f =
      (activeConflictBlockers C (availableEdges H C M) M f).filter
        (fun e ↦ e ∈ availableEdges H C M ∧ Disjoint e f) := by
  apply Finset.Subset.antisymm
  · intro e he
    apply Finset.mem_filter.mpr
    exact ⟨conflictBlockerChoices_subset_activeConflictBlockers hC hf he,
      (Finset.mem_filter.mp he).1, (Finset.mem_filter.mp he).2.1⟩
  · exact activeConflictBlockers_available_disjoint_subset

/-- The exact number of currently legal, matching-disjoint choices which
complete a conflict through `f`. -/
def openConflictCount (C : ConflictSystem V) (A M : Hypergraph V)
    (f : Finset V) : ℕ :=
  ((activeConflictBlockers C A M f).filter
    (fun e ↦ e ∈ A ∧ Disjoint e f)).card

theorem sum_conflictLostDegree_eq_sum_openConflictCount
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4) (v : V) :
    ∑ e ∈ availableEdges H C M,
        conflictLostDegree C M (availableEdges H C M) e v =
      ∑ f ∈ (availableEdges H C M).filter (v ∈ ·),
        openConflictCount C (availableEdges H C M) M f := by
  rw [sum_conflictLostDegree_eq_sum_blockerChoices]
  apply Finset.sum_congr rfl
  intro f hf
  have hfA : f ∈ availableEdges H C M := (Finset.mem_filter.mp hf).1
  exact congrArg Finset.card
    (conflictBlockerChoices_eq_active_available_disjoint hC hfA)

/-- The predictable conflict part of the stopped degree loss is exactly the
average open-conflict count over the available edges through `v`. -/
theorem meanConflictLostDegree_eq_openConflictAverage
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4) (v : V)
    (hA : (availableEdges H C M).Nonempty) :
    meanConflictLostDegree H C M v =
      (∑ f ∈ (availableEdges H C M).filter (v ∈ ·),
        (openConflictCount C (availableEdges H C M) M f : ℝ)) /
        ((availableEdges H C M).card : ℝ) := by
  rw [meanConflictLostDegree]
  simp only [Finset.nonempty_iff_ne_empty.mp hA, if_false]
  congr 1
  exact_mod_cast sum_conflictLostDegree_eq_sum_openConflictCount hC v

/-- State-level tracking predicate for the one-open-edge conflict links. -/
def OpenConflictCountWithin (C : ConflictSystem V) (A M : Hypergraph V)
    (lo hi : ℝ) : Prop :=
  ∀ f ∈ A, lo ≤ (openConflictCount C A M f : ℝ) ∧
    (openConflictCount C A M f : ℝ) ≤ hi

/-- Per-edge open-conflict tracking gives the precise predictable
conflict-loss window after averaging over the available edges through a
vertex. -/
theorem meanConflictLostDegree_bounds_of_openConflictCountWithin
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {lo hi : ℝ}
    (htrack : OpenConflictCountWithin C (availableEdges H C M) M lo hi)
    (v : V) (hA : (availableEdges H C M).Nonempty) :
    (degree (availableEdges H C M) v : ℝ) * lo /
        ((availableEdges H C M).card : ℝ) ≤
      meanConflictLostDegree H C M v ∧
    meanConflictLostDegree H C M v ≤
      (degree (availableEdges H C M) v : ℝ) * hi /
        ((availableEdges H C M).card : ℝ) := by
  let A := availableEdges H C M
  have hcard : 0 < (A.card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  rw [meanConflictLostDegree_eq_openConflictAverage hC v hA]
  constructor
  · rw [div_le_div_iff_of_pos_right hcard]
    calc
      (degree A v : ℝ) * lo = ∑ _f ∈ A.filter (v ∈ ·), lo := by
        simp [degree]
      _ ≤ ∑ f ∈ A.filter (v ∈ ·),
          (openConflictCount C A M f : ℝ) := by
        apply Finset.sum_le_sum
        intro f hf
        exact (htrack f (Finset.mem_filter.mp hf).1).1
  · rw [div_le_div_iff_of_pos_right hcard]
    calc
      (∑ f ∈ A.filter (v ∈ ·),
          (openConflictCount C A M f : ℝ)) ≤
          ∑ _f ∈ A.filter (v ∈ ·), hi := by
        apply Finset.sum_le_sum
        intro f hf
        exact (htrack f (Finset.mem_filter.mp hf).1).2
      _ = (degree A v : ℝ) * hi := by
        simp [degree]

/-- The union of active conflict blockers is controlled by the sum of the
tracked one-available conflict-link partial counts. -/
theorem card_activeConflictBlockers_le
    (C : ConflictSystem V) (A M : Hypergraph V) (e : Finset V) :
    (activeConflictBlockers C A M e).card ≤
      ∑ q ∈ Finset.Icc 1 3,
        q * (partialFamily (conflictLinkLayer C e q) A M 1).card := by
  unfold activeConflictBlockers
  calc
    ((Finset.Icc 1 3).biUnion fun q ↦
        (partialFamily (conflictLinkLayer C e q) A M 1).biUnion id).card ≤
        ∑ q ∈ Finset.Icc 1 3,
          ((partialFamily (conflictLinkLayer C e q) A M 1).biUnion id).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ q ∈ Finset.Icc 1 3,
          ∑ Q ∈ partialFamily (conflictLinkLayer C e q) A M 1,
            Q.card := by
      apply Finset.sum_le_sum
      intro q hq
      exact Finset.card_biUnion_le
    _ = ∑ q ∈ Finset.Icc 1 3,
          q * (partialFamily (conflictLinkLayer C e q) A M 1).card := by
      apply Finset.sum_congr rfl
      intro q hq
      calc
        (∑ Q ∈ partialFamily (conflictLinkLayer C e q) A M 1,
            Q.card) =
            ∑ _Q ∈ partialFamily (conflictLinkLayer C e q) A M 1, q := by
          apply Finset.sum_congr rfl
          intro Q hQ
          exact (mem_conflictLinkLayer.mp
            (mem_partialFamily.mp hQ).1).2
        _ = q * (partialFamily
            (conflictLinkLayer C e q) A M 1).card := by
          simp [mul_comm]

/-- The exact open-conflict count is at most the tracked sum of the three
one-available link layers. -/
theorem openConflictCount_le_partialLinks
    (C : ConflictSystem V) (A M : Hypergraph V) (f : Finset V) :
    openConflictCount C A M f ≤
      ∑ q ∈ Finset.Icc 1 3,
        q * (partialFamily (conflictLinkLayer C f q) A M 1).card := by
  exact (Finset.card_filter_le _ _).trans
    (card_activeConflictBlockers_le C A M f)

/-- Source family `(C_e^(q))_v^[s]`: partial conflict links through `e`
whose still-available part meets the current available star at `v`.

For the degree-jump application `s = 1`, so every member has a unique
available edge and that edge contains `v`. -/
def localConflictLinkPartialAtVertex
    (C : ConflictSystem V) (A M : Hypergraph V)
    (e : Finset V) (q s : ℕ) (v : V) : ConflictSystem V :=
  (partialFamily (conflictLinkLayer C e q) A M s).filter fun Q ↦
    ∃ f ∈ Q, f ∈ A ∧ v ∈ f

/-- GJKKL Definition 6.1(i), specialised to the link test
`Z = C_e^(q)`: this is the *static* interaction hypergraph `Z_v`, formed
using the initial host star.  Lemmas 6.3--6.7 apply to this family. -/
def sourceConflictLinkInteractionAtVertex
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) (v : V) : ConflictSystem V :=
  (conflictLinkLayer C e q).filter fun Q ↦
    ∃ f ∈ Q, f ∈ H ∧ v ∈ f

@[simp] theorem mem_localConflictLinkPartialAtVertex
    {C : ConflictSystem V} {A M : Hypergraph V}
    {e : Finset V} {q s : ℕ} {v : V} {Q : Hypergraph V} :
    Q ∈ localConflictLinkPartialAtVertex C A M e q s v ↔
      Q ∈ partialFamily (conflictLinkLayer C e q) A M s ∧
        ∃ f ∈ Q, f ∈ A ∧ v ∈ f := by
  simp [localConflictLinkPartialAtVertex]

/-- Available members through `v` in one partial link layer. -/
def localConflictLinkAvailableMembers
    (C : ConflictSystem V) (A M : Hypergraph V)
    (e : Finset V) (q s : ℕ) (v : V) : Hypergraph V :=
  ((partialFamily (conflictLinkLayer C e q) A M s).biUnion id).filter
    fun f ↦ f ∈ A ∧ v ∈ f

/-- When `s = 1`, a source local family member contributes at most its one
available edge.  Thus the union of all available members through `v` has
cardinality at most the number of local partial configurations, with no
spurious factor `q`. -/
theorem card_localConflictLinkAvailableMembers_one_le
    (C : ConflictSystem V) (A M : Hypergraph V)
    (e : Finset V) (q : ℕ) (v : V) :
    (localConflictLinkAvailableMembers C A M e q 1 v).card ≤
      (localConflictLinkPartialAtVertex C A M e q 1 v).card := by
  let L := partialFamily (conflictLinkLayer C e q) A M 1
  let Lloc := localConflictLinkPartialAtVertex C A M e q 1 v
  let P : Finset V → Prop := fun f ↦ f ∈ A ∧ v ∈ f
  let F : Hypergraph V → Hypergraph V := fun Q ↦ Q.filter P
  have hsub : localConflictLinkAvailableMembers C A M e q 1 v ⊆
      Lloc.biUnion F := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    obtain ⟨Q, hQL, hfQ⟩ := Finset.mem_biUnion.mp hf'.1
    have hQloc : Q ∈ Lloc := by
      apply Finset.mem_filter.mpr
      exact ⟨hQL, ⟨f, by simpa only [id_eq] using hfQ, hf'.2⟩⟩
    exact Finset.mem_biUnion.mpr
      ⟨Q, hQloc, Finset.mem_filter.mpr
        ⟨by simpa only [id_eq] using hfQ, hf'.2⟩⟩
  calc
    (localConflictLinkAvailableMembers C A M e q 1 v).card ≤
        (Lloc.biUnion F).card := Finset.card_le_card hsub
    _ ≤ ∑ Q ∈ Lloc, (F Q).card := Finset.card_biUnion_le
    _ ≤ ∑ _Q ∈ Lloc, 1 := by
      apply Finset.sum_le_sum
      intro Q hQloc
      have hQL : Q ∈ L := (Finset.mem_filter.mp hQloc).1
      have hQA : (Q ∩ A).card = 1 :=
        (mem_partialFamily.mp hQL).2.1
      have hFA : F Q ⊆ Q ∩ A := by
        intro f hf
        have hf' := Finset.mem_filter.mp hf
        exact Finset.mem_inter.mpr ⟨hf'.1, hf'.2.1⟩
      exact (Finset.card_le_card hFA).trans_eq hQA
    _ = Lloc.card := by simp

/-- The smaller exact blocker family embeds in the source's static
interaction coordinate.  This is the adapter needed to consume the moment
tail of Lemmas 6.3--6.7 without strengthening the certificate. -/
theorem localConflictLinkPartialAtVertex_subset_sourcePartial
    {H : Hypergraph V} {C : ConflictSystem V} {A M : Hypergraph V}
    (hAH : A ⊆ H) (e : Finset V) (q s : ℕ) (v : V) :
    localConflictLinkPartialAtVertex C A M e q s v ⊆
      partialFamily
        (sourceConflictLinkInteractionAtVertex H C e q v) A M s := by
  intro Q hQ
  obtain ⟨hQpartial, f, hfQ, hfA, hvf⟩ :=
    mem_localConflictLinkPartialAtVertex.mp hQ
  obtain ⟨hQlink, hQA, hQM⟩ := mem_partialFamily.mp hQpartial
  apply mem_partialFamily.mpr
  exact ⟨Finset.mem_filter.mpr
      ⟨hQlink, ⟨f, hfQ, hAH hfA, hvf⟩⟩,
    hQA, hQM⟩

/-- Cardinal version of the source-coordinate adapter. -/
theorem card_localConflictLinkPartialAtVertex_le_sourcePartial
    {H : Hypergraph V} {C : ConflictSystem V} {A M : Hypergraph V}
    (hAH : A ⊆ H) (e : Finset V) (q s : ℕ) (v : V) :
    (localConflictLinkPartialAtVertex C A M e q s v).card ≤
      (partialFamily
        (sourceConflictLinkInteractionAtVertex H C e q v) A M s).card :=
  Finset.card_le_card
    (localConflictLinkPartialAtVertex_subset_sourcePartial
      hAH e q s v)

/-- For the only missing ranks `q = 2,3`, the source `s = 1`
coordinate starts at zero.  Thus its initial corridor is free; the real
obligation is precisely the persistence/moment tail of Lemmas 6.5--6.7. -/
theorem sourceConflictLinkPartial_one_initial_eq_empty_of_two_le
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) (v : V) (hq : 2 ≤ q) :
    partialFamily
      (sourceConflictLinkInteractionAtVertex H C e q v) H ∅ 1 = ∅ := by
  ext Q
  constructor
  · intro hQ
    obtain ⟨hQsource, _hQH, hQM⟩ := mem_partialFamily.mp hQ
    have hQcard : Q.card = q :=
      (mem_conflictLinkLayer.mp (Finset.mem_filter.mp hQsource).1).2
    simp only [Finset.inter_empty, Finset.card_empty] at hQM
    rw [hQcard] at hQM
    omega
  · simp

/-- Deterministic source charging, before any probabilistic estimate:
all active conflict blockers through a fixed vertex are charged to the
finite family of local one-available link configurations of ranks `1..3`.
This is the conflict part of GJKKL (7.20). -/
theorem card_activeConflictBlockers_available_through_le_local
    (C : ConflictSystem V) (A M : Hypergraph V)
    (e : Finset V) (v : V) :
    ((activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f)).card ≤
      ∑ q ∈ Finset.Icc 1 3,
        (localConflictLinkPartialAtVertex C A M e q 1 v).card := by
  let G : ℕ → Hypergraph V := fun q ↦
    localConflictLinkAvailableMembers C A M e q 1 v
  have hsub : (activeConflictBlockers C A M e).filter
      (fun f ↦ f ∈ A ∧ v ∈ f) ⊆
      (Finset.Icc 1 3).biUnion G := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    unfold activeConflictBlockers at hf'
    obtain ⟨q, hq, hfq⟩ := Finset.mem_biUnion.mp hf'.1
    apply Finset.mem_biUnion.mpr
    refine ⟨q, hq, ?_⟩
    exact Finset.mem_filter.mpr ⟨hfq, hf'.2⟩
  calc
    ((activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f)).card ≤
        ((Finset.Icc 1 3).biUnion G).card :=
      Finset.card_le_card hsub
    _ ≤ ∑ q ∈ Finset.Icc 1 3, (G q).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ q ∈ Finset.Icc 1 3,
        (localConflictLinkPartialAtVertex C A M e q 1 v).card := by
      apply Finset.sum_le_sum
      intro q hq
      exact card_localConflictLinkAvailableMembers_one_le C A M e q v

/-- Exact one-step conflict loss through `v`, charged to the three source
local-spread coordinates. -/
theorem conflictLostDegree_le_sum_localConflictLinkPartial
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {e : Finset V} (he : e ∈ availableEdges H C M) (v : V) :
    conflictLostDegree C M (availableEdges H C M) e v ≤
      ∑ q ∈ Finset.Icc 1 3,
        (localConflictLinkPartialAtVertex C
          (availableEdges H C M) M e q 1 v).card := by
  let A := availableEdges H C M
  have hsub : (disjointResidual A e).filter
      (fun f ↦ v ∈ f ∧ ¬ConflictFree C (insert f (insert e M))) ⊆
      (activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f) := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    have hfres := Finset.mem_filter.mp hf'.1
    have hblock : f ∈ conflictBlockerChoices C M A e :=
      Finset.mem_filter.mpr
        ⟨hfres.1, hfres.2,
          by simpa [Finset.insert_comm] using hf'.2.2⟩
    exact Finset.mem_filter.mpr
      ⟨conflictBlockerChoices_subset_activeConflictBlockers hCcard he hblock,
        hfres.1, hf'.2.1⟩
  calc
    conflictLostDegree C M A e v ≤
        ((activeConflictBlockers C A M e).filter
          (fun f ↦ f ∈ A ∧ v ∈ f)).card :=
      Finset.card_le_card hsub
    _ ≤ ∑ q ∈ Finset.Icc 1 3,
        (localConflictLinkPartialAtVertex C A M e q 1 v).card :=
      card_activeConflictBlockers_available_through_le_local C A M e v

/-- The source-faithful specialised split: rank one is already controlled
deterministically by (C4), while only ranks two and three require the
probabilistic local-spread event. -/
theorem card_activeConflictBlockers_available_through_le_C4_add_local
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {e : Finset V} (hAH : A ⊆ H) (v : V) :
    ((activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f)).card ≤
      CFMRegularization.conditionC4Count H C e v +
        (localConflictLinkPartialAtVertex C A M e 2 1 v).card +
        (localConflictLinkPartialAtVertex C A M e 3 1 v).card := by
  let B : ℕ → Hypergraph V := fun q ↦
    localConflictLinkAvailableMembers C A M e q 1 v
  have hsub : (activeConflictBlockers C A M e).filter
      (fun f ↦ f ∈ A ∧ v ∈ f) ⊆ B 1 ∪ B 2 ∪ B 3 := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    unfold activeConflictBlockers at hf'
    obtain ⟨q, hq, hfq⟩ := Finset.mem_biUnion.mp hf'.1
    have hqcases : q = 1 ∨ q = 2 ∨ q = 3 := by
      simp only [Finset.mem_Icc] at hq
      omega
    rcases hqcases with rfl | rfl | rfl
    · exact Finset.mem_union.mpr (Or.inl (Finset.mem_union.mpr
        (Or.inl (Finset.mem_filter.mpr ⟨hfq, hf'.2⟩))))
    · exact Finset.mem_union.mpr (Or.inl (Finset.mem_union.mpr
        (Or.inr (Finset.mem_filter.mpr ⟨hfq, hf'.2⟩))))
    · exact Finset.mem_union.mpr
        (Or.inr (Finset.mem_filter.mpr ⟨hfq, hf'.2⟩))
  have hB₁ : B 1 ⊆
      (CFMRegularization.twoConflictNeighbors H C e).filter (v ∈ ·) := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    obtain ⟨Q, hQpartial, hfQ⟩ := Finset.mem_biUnion.mp hf'.1
    have hQlink := (mem_partialFamily.mp hQpartial).1
    have hQcard := (mem_conflictLinkLayer.mp hQlink).2
    obtain ⟨a, hQa⟩ := Finset.card_eq_one.mp hQcard
    have haf : a = f := by
      rw [hQa] at hfQ
      exact (Finset.mem_singleton.mp hfQ).symm
    subst a
    obtain ⟨⟨c, hcC, hec, hcErase⟩, _⟩ :=
      mem_conflictLinkLayer.mp hQlink
    have hfErase : f ∈ c.erase e := by
      rw [hcErase]
      simpa [hQa]
    have hfe : f ≠ e := (Finset.mem_erase.mp hfErase).1
    have hcEq : c = {e, f} := by
      calc
        c = insert e (c.erase e) := (Finset.insert_erase hec).symm
        _ = insert e Q := by rw [hcErase]
        _ = {e, f} := by rw [hQa]
    apply Finset.mem_filter.mpr
    refine ⟨?_, hf'.2.2⟩
    apply Finset.mem_filter.mpr
    exact ⟨hAH hf'.2.1, hfe, by
      rw [← hcEq]
      exact mem_conflictLayer.mpr
        ⟨hcC, by rw [hcEq]; simp [Ne.symm hfe]⟩⟩
  have hcard₁ : (B 1).card ≤
      CFMRegularization.conditionC4Count H C e v := by
    exact Finset.card_le_card hB₁
  have hcard₂ : (B 2).card ≤
      (localConflictLinkPartialAtVertex C A M e 2 1 v).card :=
    card_localConflictLinkAvailableMembers_one_le C A M e 2 v
  have hcard₃ : (B 3).card ≤
      (localConflictLinkPartialAtVertex C A M e 3 1 v).card :=
    card_localConflictLinkAvailableMembers_one_le C A M e 3 v
  calc
    ((activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f)).card ≤
        (B 1 ∪ B 2 ∪ B 3).card := Finset.card_le_card hsub
    _ ≤ (B 1).card + (B 2).card + (B 3).card := by
      calc
        (B 1 ∪ B 2 ∪ B 3).card ≤
            (B 1 ∪ B 2).card + (B 3).card :=
          Finset.card_union_le (B 1 ∪ B 2) (B 3)
        _ ≤ ((B 1).card + (B 2).card) + (B 3).card :=
          Nat.add_le_add_right (Finset.card_union_le (B 1) (B 2)) _
    _ ≤ CFMRegularization.conditionC4Count H C e v +
        (localConflictLinkPartialAtVertex C A M e 2 1 v).card +
        (localConflictLinkPartialAtVertex C A M e 3 1 v).card := by
      omega

/-- Degree-loss form of the specialised `(C4) + q=2 + q=3` source split. -/
theorem conflictLostDegree_le_C4_add_localConflictLinkPartial
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {e : Finset V} (he : e ∈ availableEdges H C M) (v : V) :
    conflictLostDegree C M (availableEdges H C M) e v ≤
      CFMRegularization.conditionC4Count H C e v +
        (localConflictLinkPartialAtVertex C
          (availableEdges H C M) M e 2 1 v).card +
        (localConflictLinkPartialAtVertex C
          (availableEdges H C M) M e 3 1 v).card := by
  let A := availableEdges H C M
  have hsub : (disjointResidual A e).filter
      (fun f ↦ v ∈ f ∧ ¬ConflictFree C (insert f (insert e M))) ⊆
      (activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f) := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    have hfres := Finset.mem_filter.mp hf'.1
    have hblock : f ∈ conflictBlockerChoices C M A e :=
      Finset.mem_filter.mpr
        ⟨hfres.1, hfres.2,
          by simpa [Finset.insert_comm] using hf'.2.2⟩
    exact Finset.mem_filter.mpr
      ⟨conflictBlockerChoices_subset_activeConflictBlockers hCcard he hblock,
        hfres.1, hf'.2.1⟩
  calc
    conflictLostDegree C M A e v ≤
        ((activeConflictBlockers C A M e).filter
          (fun f ↦ f ∈ A ∧ v ∈ f)).card :=
      Finset.card_le_card hsub
    _ ≤ CFMRegularization.conditionC4Count H C e v +
        (localConflictLinkPartialAtVertex C A M e 2 1 v).card +
        (localConflictLinkPartialAtVertex C A M e 3 1 v).card :=
      card_activeConflictBlockers_available_through_le_C4_add_local
        (availableEdges_subset H C M) v

/-- Real-valued form of source `(d₀, δ)`-spreadness. -/
def IsRealSpread (X : ConflictSystem V) (q : ℕ)
    (d₀ delta : ℝ) : Prop :=
  IsUniform X q ∧
    ∀ root : Hypergraph V, root.card < q →
      (codegree X root : ℝ) ≤ d₀ * delta ^ root.card

theorem sourceConflictLinkInteractionAtVertex_uniform
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) (v : V) :
    IsUniform (sourceConflictLinkInteractionAtVertex H C e q v) q :=
  (conflictLinkLayer_uniform C e q).mono (Finset.filter_subset _ _)

/-- A rooted link family injects into the corresponding rooted conflict
layer by reinserting the distinguished edge. -/
theorem codegree_conflictLinkLayer_le_insert
    (C : ConflictSystem V) (e : Finset V) (q : ℕ)
    (root : Hypergraph V) (heroot : e ∉ root) :
    codegree (conflictLinkLayer C e q) root ≤
      codegree (conflictLayer C (q + 1)) (insert e root) := by
  let S := (conflictLinkLayer C e q).filter (root ⊆ ·)
  let T := (conflictLayer C (q + 1)).filter (insert e root ⊆ ·)
  apply Finset.card_le_card_of_injOn (insert e)
  · intro Q hQ
    have hQ' := Finset.mem_filter.mp hQ
    obtain ⟨⟨c, hcC, hec, hcErase⟩, hQcard⟩ :=
      mem_conflictLinkLayer.mp hQ'.1
    have hcEq : c = insert e Q := by
      calc
        c = insert e (c.erase e) := (Finset.insert_erase hec).symm
        _ = insert e Q := by rw [hcErase]
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_filter.mpr ⟨?_, ?_⟩, ?_⟩
    · simpa [hcEq] using hcC
    · rw [← hcEq]
      have hcard := Finset.card_erase_add_one hec
      have hcecard : (c.erase e).card = q := by
        rw [hcErase]
        exact hQcard
      omega
    · exact Finset.insert_subset_insert e hQ'.2
  · intro Q hQS R hRS hEq
    have hQlink := (Finset.mem_filter.mp hQS).1
    have hRlink := (Finset.mem_filter.mp hRS).1
    have heQ : e ∉ Q := by
      obtain ⟨⟨c, _hcC, _hec, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hQlink
      rw [← hcErase]
      simp
    have heR : e ∉ R := by
      obtain ⟨⟨c, _hcC, _hec, hcErase⟩, _⟩ :=
        mem_conflictLinkLayer.mp hRlink
      rw [← hcErase]
      simp
    calc
      Q = (insert e Q).erase e := by simp [heQ]
      _ = (insert e R).erase e := by rw [hEq]
      _ = R := by simp [heR]

/-- Zeroth-degree charging for the static source family: choose one host
edge through `v` contained in the interaction and sum its rooted link
degree. -/
theorem card_sourceConflictLinkInteractionAtVertex_le_sum_codegrees
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) (v : V) :
    (sourceConflictLinkInteractionAtVertex H C e q v).card ≤
      ∑ f ∈ H.filter (v ∈ ·),
        codegree (conflictLinkLayer C e q) {f} := by
  let D := H.filter (v ∈ ·)
  let F : Finset V → ConflictSystem V := fun f ↦
    (conflictLinkLayer C e q).filter ({f} ⊆ ·)
  have hsub : sourceConflictLinkInteractionAtVertex H C e q v ⊆
      D.biUnion F := by
    intro Q hQ
    obtain ⟨hQlink, f, hfQ, hfH, hvf⟩ := Finset.mem_filter.mp hQ
    apply Finset.mem_biUnion.mpr
    refine ⟨f, Finset.mem_filter.mpr ⟨hfH, hvf⟩, ?_⟩
    exact Finset.mem_filter.mpr ⟨hQlink, by simpa using hfQ⟩
  calc
    (sourceConflictLinkInteractionAtVertex H C e q v).card ≤
        (D.biUnion F).card := Finset.card_le_card hsub
    _ ≤ ∑ f ∈ D, (F f).card := Finset.card_biUnion_le
    _ = ∑ f ∈ H.filter (v ∈ ·),
        codegree (conflictLinkLayer C e q) {f} := by rfl

/-- Every positive rooted degree of the static interaction is inherited
from the corresponding conflict link. -/
theorem codegree_sourceConflictLinkInteractionAtVertex_le_link
    (H : Hypergraph V) (C : ConflictSystem V)
    (e : Finset V) (q : ℕ) (v : V) (root : Hypergraph V) :
    codegree (sourceConflictLinkInteractionAtVertex H C e q v) root ≤
      codegree (conflictLinkLayer C e q) root :=
  codegree_mono_hypergraph (Finset.filter_subset _ _) root
/-! ## Static source spread from (C3)

The following is the exact initial-spread calculation behind source
Lemma 6.3(i).  The zeroth degree uses one sum over the host star, but each
summand is a *two-root* conflict-layer codegree.  This is what removes the
otherwise spurious extra factor `d` that would arise from `commonLinks`.
-/

/-- Link members never contain the distinguished edge that was erased. -/
theorem distinguished_not_mem_conflictLinkLayer
    {C : ConflictSystem V} {e : Finset V} {Q : Hypergraph V} {q : ℕ}
    (hQ : Q ∈ conflictLinkLayer C e q) : e ∉ Q := by
  obtain ⟨⟨c, _hcC, _hec, hcErase⟩, _hQcard⟩ :=
    mem_conflictLinkLayer.mp hQ
  rw [← hcErase]
  simp

/-- Any rooted link degree whose root contains `e` is zero. -/
theorem codegree_conflictLinkLayer_eq_zero_of_distinguished_mem
    (C : ConflictSystem V) (e : Finset V) (q : ℕ)
    (root : Hypergraph V) (heroot : e ∈ root) :
    codegree (conflictLinkLayer C e q) root = 0 := by
  rw [codegree, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro Q hQ hrootQ
  exact distinguished_not_mem_conflictLinkLayer hQ (hrootQ heroot)

/-- Positive rooted degrees of the static interaction inherit the sharp
`(C3)` exponent after reinserting `e`.  No summation over the star occurs
for a nonempty root. -/
theorem codegree_sourceConflictLinkInteractionAtVertex_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V}
    {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d)
    (e : Finset V) (q : ℕ) (v : V) (root : Hypergraph V)
    (hq2 : 2 ≤ q) (hq3 : q ≤ 3)
    (hrootPos : 1 ≤ root.card) (hrootLt : root.card < q) :
    (codegree (sourceConflictLinkInteractionAtVertex H C e q v) root : ℝ) ≤
      Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) := by
  by_cases heroot : e ∈ root
  · have hzero :
        codegree (sourceConflictLinkInteractionAtVertex H C e q v) root = 0 := by
      apply Nat.eq_zero_of_le_zero
      exact (codegree_sourceConflictLinkInteractionAtVertex_le_link
        H C e q v root).trans
          (Nat.le_of_eq
            (codegree_conflictLinkLayer_eq_zero_of_distinguished_mem
              C e q root heroot))
    rw [hzero, Nat.cast_zero]
    exact Real.rpow_nonneg hd.le _
  · have hInsertCard : (insert e root).card = root.card + 1 := by
      rw [Finset.card_insert_of_notMem heroot]
    have hLayer := hB.layer_codegree
      (r := q + 1) (q := root.card + 1)
      (by omega) (by omega) (by omega) (by omega)
      (insert e root) hInsertCard
    calc
      (codegree
          (sourceConflictLinkInteractionAtVertex H C e q v) root : ℝ) ≤
          (codegree (conflictLinkLayer C e q) root : ℝ) := by
        exact_mod_cast
          codegree_sourceConflictLinkInteractionAtVertex_le_link
            H C e q v root
      _ ≤ (codegree (conflictLayer C (q + 1)) (insert e root) : ℝ) := by
        exact_mod_cast codegree_conflictLinkLayer_le_insert C e q root heroot
      _ ≤ Real.rpow d
          (((q + 1 : ℕ) : ℝ) - ((root.card + 1 : ℕ) : ℝ) - eta) :=
        hLayer
      _ = Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) := by
        congr 1
        push_cast
        ring

/-- A fixed host edge `f` through `v` costs a two-root `(C3)` degree.
The exceptional summand `f=e` is zero because `e` was erased from the
link. -/
theorem codegree_conflictLinkLayer_singleton_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V}
    {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hd : 0 < d)
    (e : Finset V) (q : ℕ) (f : Finset V)
    (hq2 : 2 ≤ q) (hq3 : q ≤ 3) :
    (codegree (conflictLinkLayer C e q) {f} : ℝ) ≤
      Real.rpow d ((q : ℝ) - 1 - eta) := by
  by_cases hfe : f = e
  · subst f
    rw [codegree_conflictLinkLayer_eq_zero_of_distinguished_mem
      C e q {e} (by simp), Nat.cast_zero]
    exact Real.rpow_nonneg hd.le _
  · have heSingleton : e ∉ ({f} : Hypergraph V) := by
      simpa [Ne.symm hfe]
    have hInsertCard : (insert e ({f} : Hypergraph V)).card = 2 := by
      simp [hfe, Ne.symm hfe]
    have hLayer := hB.layer_codegree
      (r := q + 1) (q := 2)
      (by omega) (by omega) (by omega) (by omega)
      (insert e ({f} : Hypergraph V)) hInsertCard
    calc
      (codegree (conflictLinkLayer C e q) {f} : ℝ) ≤
          (codegree (conflictLayer C (q + 1))
            (insert e ({f} : Hypergraph V)) : ℝ) := by
        exact_mod_cast
          codegree_conflictLinkLayer_le_insert C e q {f} heSingleton
      _ ≤ Real.rpow d (((q + 1 : ℕ) : ℝ) - (2 : ℝ) - eta) :=
        hLayer
      _ = Real.rpow d ((q : ℝ) - 1 - eta) := by
        congr 1
        push_cast
        ring

/-- Zeroth-degree bound for the static interaction.  Charging each member
to one host edge through `v`, (C3) gives `d^(q-1-eta)` per edge and the
host degree upper bound supplies the final factor `d`. -/
theorem card_sourceConflictLinkInteractionAtVertex_le_rpow
    {H : Hypergraph V} {C : ConflictSystem V}
    {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (hd : 0 < d) (e : Finset V) (q : ℕ) (v : V)
    (hq2 : 2 ≤ q) (hq3 : q ≤ 3) :
    ((sourceConflictLinkInteractionAtVertex H C e q v).card : ℝ) ≤
      Real.rpow d ((q : ℝ) - eta) := by
  have hcard := card_sourceConflictLinkInteractionAtVertex_le_sum_codegrees
    H C e q v
  have hsummand : ∀ f ∈ H.filter (v ∈ ·),
      (codegree (conflictLinkLayer C e q) {f} : ℝ) ≤
        Real.rpow d ((q : ℝ) - 1 - eta) := by
    intro f _hf
    exact codegree_conflictLinkLayer_singleton_le_rpow
      hB hd e q f hq2 hq3
  have hfactor :
      d * Real.rpow d ((q : ℝ) - 1 - eta) =
        Real.rpow d ((q : ℝ) - eta) := by
    calc
      d * Real.rpow d ((q : ℝ) - 1 - eta) =
          Real.rpow d 1 * Real.rpow d ((q : ℝ) - 1 - eta) := by
        exact congrArg (fun x : ℝ =>
          x * Real.rpow d ((q : ℝ) - 1 - eta))
            (Real.rpow_one d).symm
      _ = Real.rpow d (1 + ((q : ℝ) - 1 - eta)) :=
        (Real.rpow_add hd _ _).symm
      _ = Real.rpow d ((q : ℝ) - eta) := by
        congr 1
        ring
  calc
    ((sourceConflictLinkInteractionAtVertex H C e q v).card : ℝ) ≤
        (∑ f ∈ H.filter (v ∈ ·),
          codegree (conflictLinkLayer C e q) {f} : ℕ) := by
      exact_mod_cast hcard
    _ = ∑ f ∈ H.filter (v ∈ ·),
          (codegree (conflictLinkLayer C e q) {f} : ℝ) := by
      push_cast
      rfl
    _ ≤ ∑ _f ∈ H.filter (v ∈ ·),
          Real.rpow d ((q : ℝ) - 1 - eta) := by
      apply Finset.sum_le_sum
      intro f hf
      exact hsummand f hf
    _ = (degree H v : ℝ) *
          Real.rpow d ((q : ℝ) - 1 - eta) := by
      simp [degree]
    _ ≤ d * Real.rpow d ((q : ℝ) - 1 - eta) :=
      mul_le_mul_of_nonneg_right (hdegreeUpper v)
        (Real.rpow_nonneg hd.le _)
    _ = Real.rpow d ((q : ℝ) - eta) := hfactor

/-- Exact static `(d^(q-eta), 1/d)`-spreadness for the two nontrivial
link ranks `q=2,3`.  This is the Lean-ready source layer needed by the
one-open moment tail. -/
theorem sourceConflictLinkInteractionAtVertex_isRealSpread
    {H : Hypergraph V} {C : ConflictSystem V}
    {d Gamma eta : ℝ}
    (hB : CFMRegularization.IsRegularizedBounded H C d Gamma eta)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (hd : 0 < d) (e : Finset V) (q : ℕ) (v : V)
    (hq2 : 2 ≤ q) (hq3 : q ≤ 3) :
    IsRealSpread (sourceConflictLinkInteractionAtVertex H C e q v) q
      (Real.rpow d ((q : ℝ) - eta)) d⁻¹ := by
  refine ⟨sourceConflictLinkInteractionAtVertex_uniform H C e q v, ?_⟩
  intro root hrootLt
  by_cases hrootZero : root.card = 0
  · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
    subst root
    simpa [codegree] using
      card_sourceConflictLinkInteractionAtVertex_le_rpow
        hB hdegreeUpper hd e q v hq2 hq3
  · have hrootPos : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
    have hrootBound := codegree_sourceConflictLinkInteractionAtVertex_le_rpow
      hB hd e q v root hq2 hq3 hrootPos hrootLt
    have hinvPow : d⁻¹ ^ root.card =
        Real.rpow d (-(root.card : ℝ)) := by
      calc
        d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
        _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
          exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
        _ = Real.rpow d (-(root.card : ℝ)) :=
          (Real.rpow_neg hd.le _).symm
    calc
      (codegree
          (sourceConflictLinkInteractionAtVertex H C e q v) root : ℝ) ≤
          Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) :=
        hrootBound
      _ = Real.rpow d ((q : ℝ) - eta) * d⁻¹ ^ root.card := by
        rw [hinvPow]
        calc
          Real.rpow d ((q : ℝ) - (root.card : ℝ) - eta) =
              Real.rpow d
                (((q : ℝ) - eta) + (-(root.card : ℝ))) := by
            congr 1
            ring
          _ = Real.rpow d ((q : ℝ) - eta) *
              Real.rpow d (-(root.card : ℝ)) :=
            Real.rpow_add hd _ _

/-- The path-state observable tracked for the `s`-available coordinate of
a weighted `j`-test. -/
noncomputable def partialTestObservable (w : TestWeight V) (H : Hypergraph V)
    (C : ConflictSystem V) (j s : ℕ) (M : Hypergraph V) : ℝ :=
  partialTestTotal w H (availableEdges H C M) M j s

/-- At time zero every `j`-set of the host lies in the all-available
component of the test trajectory. -/
@[simp] theorem partialTestTotal_initial (w : TestWeight V)
    (H : Hypergraph V) (j : ℕ) :
    partialTestTotal w H H ∅ j j = testTotal w H j := by
  rw [partialTestTotal, testTotal]
  congr 1
  ext S
  simp only [Finset.mem_filter, Finset.mem_powersetCard]
  constructor
  · rintro ⟨⟨hSH, hcard⟩, -⟩
    exact ⟨hSH, hcard⟩
  · rintro ⟨hSH, hcard⟩
    refine ⟨⟨hSH, hcard⟩, ?_⟩
    rw [Finset.inter_eq_left.mpr hSH]
    simp [hcard]

/-- Initial value of the full-available coordinate for conflicts of size at
least two. -/
theorem partialTestObservable_initial (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (j : ℕ)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card) :
    partialTestObservable w H C j j ∅ = testTotal w H j := by
  simp [partialTestObservable, availableEdges_empty_eq_host H C hCcard]

/-- If available and selected host edges are disjoint, the zero-available
component of the partial-test trajectory is exactly the terminal test
weight of the selected matching. -/
theorem partialTestTotal_zero_eq_testTotal (w : TestWeight V)
    (H A M : Hypergraph V) (j : ℕ) (hMH : M ⊆ H)
    (hAM : Disjoint A M) :
    partialTestTotal w H A M j 0 = testTotal w M j := by
  rw [partialTestTotal, testTotal]
  congr 1
  ext S
  simp only [Finset.mem_filter, Finset.mem_powersetCard, Nat.sub_zero]
  constructor
  · rintro ⟨⟨hSH, hcard⟩, hSA, hSMcard⟩
    have hinter : S ∩ M = S := by
      apply Finset.eq_of_subset_of_card_le Finset.inter_subset_left
      rw [hSMcard, hcard]
    exact ⟨Finset.inter_eq_left.mp hinter, hcard⟩
  · rintro ⟨hSM, hcard⟩
    have hSH : S ⊆ H := hSM.trans hMH
    have hdisj : Disjoint S A := hAM.symm.mono hSM (Subset.rfl)
    refine ⟨⟨hSH, hcard⟩, ?_, ?_⟩
    · rw [Finset.disjoint_iff_inter_eq_empty.mp hdisj]
      rfl
    · rw [Finset.inter_eq_left.mpr hSM, hcard]

/-- The zero-available test coordinate of every reachable matching state is
the desired terminal statistic. -/
theorem partialTestTotal_available_zero (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j : ℕ) (hM : IsMatching H M) :
    partialTestTotal w H (availableEdges H C M) M j 0 =
      testTotal w M j :=
  partialTestTotal_zero_eq_testTotal w H (availableEdges H C M) M j
    hM.1 (availableEdges_disjoint_selected H C M)

theorem partialTestObservable_zero (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j : ℕ) (hM : IsMatching H M) :
    partialTestObservable w H C j 0 M = testTotal w M j :=
  partialTestTotal_available_zero w H C M j hM

/-! ### Exact partial-test drift -/

def partialTestCondition (A M : Hypergraph V) (j s : ℕ)
    (S : Hypergraph V) : Prop :=
  (S ∩ A).card = s ∧ (S ∩ M).card = j - s

noncomputable def partialTestGainBetween (w : TestWeight V)
    (H : Hypergraph V) (A M A' M' : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if ¬partialTestCondition A M j s S ∧
      partialTestCondition A' M' j s S then w S else 0

noncomputable def partialTestLossBetween (w : TestWeight V)
    (H : Hypergraph V) (A M A' M' : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if partialTestCondition A M j s S ∧
      ¬partialTestCondition A' M' j s S then w S else 0

theorem partialTestTotal_sub_eq_gain_sub_loss
    (w : TestWeight V) (H A M A' M' : Hypergraph V) (j s : ℕ) :
    partialTestTotal w H A' M' j s - partialTestTotal w H A M j s =
      partialTestGainBetween w H A M A' M' j s -
        partialTestLossBetween w H A M A' M' j s := by
  simp only [partialTestTotal, partialTestGainBetween,
    partialTestLossBetween, Finset.sum_filter]
  rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro S hS
  by_cases hOld : partialTestCondition A M j s S <;>
    by_cases hNew : partialTestCondition A' M' j s S <;>
    simp only [partialTestCondition] at hOld hNew <;>
    simp [partialTestCondition, hOld, hNew]

noncomputable def partialTestStepGain (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (j s : ℕ)
    (M : Hypergraph V) (e : Finset V) : ℝ :=
  partialTestGainBetween w H (availableEdges H C M) M
    (availableEdges H C (insert e M)) (insert e M) j s

noncomputable def partialTestStepLoss (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (j s : ℕ)
    (M : Hypergraph V) (e : Finset V) : ℝ :=
  partialTestLossBetween w H (availableEdges H C M) M
    (availableEdges H C (insert e M)) (insert e M) j s

theorem partialTestObservable_insert_sub_eq_gain_sub_loss
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V) (e : Finset V) :
    partialTestObservable w H C j s (insert e M) -
        partialTestObservable w H C j s M =
      partialTestStepGain w H C j s M e -
        partialTestStepLoss w H C j s M e := by
  simpa only [partialTestObservable, partialTestStepGain,
    partialTestStepLoss] using
    partialTestTotal_sub_eq_gain_sub_loss w H
      (availableEdges H C M) M
      (availableEdges H C (insert e M)) (insert e M) j s

theorem greedyStepExpectation_partialTest_increment_eq_gain_sub_loss
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V)
    (hA : (availableEdges H C M).Nonempty) :
    greedyStepExpectation H C M (fun N ↦
        partialTestObservable w H C j s N -
          partialTestObservable w H C j s M) =
      ((∑ e ∈ availableEdges H C M,
          partialTestStepGain w H C j s M e) -
        ∑ e ∈ availableEdges H C M,
          partialTestStepLoss w H C j s M e) /
        (availableEdges H C M).card := by
  rw [greedyStepExpectation_eq_average H C M _ hA]
  apply congrArg (fun x : ℝ ↦ x / (availableEdges H C M).card)
  calc
    ∑ e ∈ availableEdges H C M,
        (partialTestObservable w H C j s (insert e M) -
          partialTestObservable w H C j s M) =
      ∑ e ∈ availableEdges H C M,
        (partialTestStepGain w H C j s M e -
          partialTestStepLoss w H C j s M e) := by
      apply Finset.sum_congr rfl
      intro e he
      exact partialTestObservable_insert_sub_eq_gain_sub_loss
        w H C j s M e
    _ = (∑ e ∈ availableEdges H C M,
          partialTestStepGain w H C j s M e) -
        ∑ e ∈ availableEdges H C M,
          partialTestStepLoss w H C j s M e := by
      rw [Finset.sum_sub_distrib]

noncomputable def meanPartialTestGain (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (j s : ℕ)
    (M : Hypergraph V) : ℝ :=
  if availableEdges H C M = ∅ then 0 else
    (∑ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e) /
      (availableEdges H C M).card

noncomputable def meanPartialTestLoss (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (j s : ℕ)
    (M : Hypergraph V) : ℝ :=
  if availableEdges H C M = ∅ then 0 else
    (∑ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e) /
      (availableEdges H C M).card

theorem greedyStepExpectation_partialTest_increment
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V) :
    greedyStepExpectation H C M (fun N ↦
        partialTestObservable w H C j s N -
          partialTestObservable w H C j s M) =
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M := by
  by_cases hA : availableEdges H C M = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty H C M _ hA]
    simp [meanPartialTestGain, meanPartialTestLoss, hA]
  · have hAne : (availableEdges H C M).Nonempty :=
      Finset.nonempty_iff_ne_empty.mpr hA
    rw [greedyStepExpectation_partialTest_increment_eq_gain_sub_loss
      w H C j s M hAne]
    simp only [meanPartialTestGain, meanPartialTestLoss, hA, if_false]
    ring

/-- Edges whose available/selected status changes between two states. -/
def partialTestStatusChanges (A M A' M' : Hypergraph V) : Hypergraph V :=
  (((A \ A') ∪ (A' \ A)) ∪ (M \ M')) ∪ (M' \ M)

theorem availableEdges_antitone {H : Hypergraph V} {C : ConflictSystem V}
    {M N : Hypergraph V} (hMN : M ⊆ N) :
    availableEdges H C N ⊆ availableEdges H C M := by
  intro e heN
  have he := mem_availableEdges.mp heN
  apply mem_availableEdges.mpr
  refine ⟨he.1, ?_, ?_⟩
  · exact fun heM ↦ he.2.1 (hMN heM)
  · exact he.2.2.mono (by
      intro f hf
      simp only [Finset.mem_insert] at hf ⊢
      exact hf.elim Or.inl (fun hfM ↦ Or.inr (hMN hfM)))

theorem partialTestStatusChanges_available_insert
    {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {e : Finset V}
    (he : e ∈ availableEdges H C M) :
    partialTestStatusChanges
        (availableEdges H C M) M
        (availableEdges H C (insert e M)) (insert e M) =
      availableEdges H C M \ availableEdges H C (insert e M) := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  have hA'A : A' ⊆ A := availableEdges_antitone (Finset.subset_insert e M)
  have heA : e ∈ A := he
  have heA' : e ∉ A' := by
    intro he'
    exact (mem_availableEdges.mp he').2.1 (Finset.mem_insert_self e M)
  have heM : e ∉ M := (mem_availableEdges.mp he).2.1
  ext f
  simp only [partialTestStatusChanges, Finset.mem_union, Finset.mem_sdiff,
    Finset.mem_insert]
  constructor
  · intro hf
    rcases hf with hf | hf
    · rcases hf with hf | hf
      · rcases hf with ⟨hfA, hfA'⟩ | ⟨hfA', hfA⟩
        · exact ⟨hfA, hfA'⟩
        · exact (hfA (hA'A hfA')).elim
      · rcases hf with ⟨hfM, hfeM⟩
        exact (hfeM (Or.inr hfM)).elim
    · rcases hf with ⟨hins, hfnotM⟩
      rcases hins with rfl | hfM
      · exact ⟨heA, heA'⟩
      · exact (hfnotM hfM).elim
  · rintro ⟨hfA, hfA'⟩
    exact Or.inl (Or.inl (Or.inl ⟨hfA, hfA'⟩))

def partialTestIncidenceCharge (w : TestWeight V) (H : Hypergraph V)
    (j : ℕ) (D : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j, w S * ((S ∩ D).card : ℝ)

theorem cast_card_inter_eq_sum_indicator (S D : Hypergraph V) :
    ((S ∩ D).card : ℝ) =
      ∑ e ∈ D, if e ∈ S then (1 : ℝ) else 0 := by
  simp only [Finset.sum_boole, Finset.filter_mem_eq_inter]
  rw [Finset.inter_comm]

theorem partialTestIncidenceCharge_eq_sum_testExtension
    (w : TestWeight V) (H D : Hypergraph V) (j : ℕ) :
    partialTestIncidenceCharge w H j D =
      ∑ e ∈ D, testExtension w H j {e} := by
  simp only [partialTestIncidenceCharge, testExtension,
    Finset.sum_filter, Finset.singleton_subset_iff]
  calc
    ∑ S ∈ H.powersetCard j, w S * ((S ∩ D).card : ℝ) =
        ∑ S ∈ H.powersetCard j,
          ∑ e ∈ D, if e ∈ S then w S else 0 := by
      apply Finset.sum_congr rfl
      intro S hS
      rw [cast_card_inter_eq_sum_indicator, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro e he
      by_cases heS : e ∈ S <;> simp [heS]
    _ = ∑ e ∈ D, ∑ S ∈ H.powersetCard j,
          if e ∈ S then w S else 0 := by
      rw [Finset.sum_comm]

theorem partialTestCondition_eq_of_disjoint_statusChanges
    (A M A' M' S : Hypergraph V) (j s : ℕ)
    (hdisj : Disjoint S (partialTestStatusChanges A M A' M')) :
    partialTestCondition A M j s S =
      partialTestCondition A' M' j s S := by
  have hA : S ∩ A = S ∩ A' := by
    ext e
    simp only [Finset.mem_inter]
    constructor
    · rintro ⟨heS, heA⟩
      refine ⟨heS, ?_⟩
      by_contra heA'
      have heD : e ∈ partialTestStatusChanges A M A' M' := by
        simp [partialTestStatusChanges, heA, heA']
      exact Finset.disjoint_left.mp hdisj heS heD
    · rintro ⟨heS, heA'⟩
      refine ⟨heS, ?_⟩
      by_contra heA
      have heD : e ∈ partialTestStatusChanges A M A' M' := by
        simp [partialTestStatusChanges, heA, heA']
      exact Finset.disjoint_left.mp hdisj heS heD
  have hM : S ∩ M = S ∩ M' := by
    ext e
    simp only [Finset.mem_inter]
    constructor
    · rintro ⟨heS, heM⟩
      refine ⟨heS, ?_⟩
      by_contra heM'
      have heD : e ∈ partialTestStatusChanges A M A' M' := by
        simp [partialTestStatusChanges, heM, heM']
      exact Finset.disjoint_left.mp hdisj heS heD
    · rintro ⟨heS, heM'⟩
      refine ⟨heS, ?_⟩
      by_contra heM
      have heD : e ∈ partialTestStatusChanges A M A' M' := by
        simp [partialTestStatusChanges, heM, heM']
      exact Finset.disjoint_left.mp hdisj heS heD
  simp only [partialTestCondition, hA, hM]

theorem abs_partialTestTotal_sub_le_incidenceCharge
    (w : TestWeight V) (H A M A' M' : Hypergraph V) (j s : ℕ)
    (hw : ∀ S, 0 ≤ w S) :
    |partialTestTotal w H A' M' j s -
        partialTestTotal w H A M j s| ≤
      partialTestIncidenceCharge w H j
        (partialTestStatusChanges A M A' M') := by
  simp only [partialTestTotal, partialTestIncidenceCharge,
    Finset.sum_filter]
  rw [← Finset.sum_sub_distrib]
  calc
    |∑ S ∈ H.powersetCard j,
        ((if (S ∩ A').card = s ∧ (S ∩ M').card = j - s
            then w S else 0) -
          if (S ∩ A).card = s ∧ (S ∩ M).card = j - s
            then w S else 0)| ≤
      ∑ S ∈ H.powersetCard j,
        |((if (S ∩ A').card = s ∧ (S ∩ M').card = j - s
            then w S else 0) -
          if (S ∩ A).card = s ∧ (S ∩ M).card = j - s
            then w S else 0)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ S ∈ H.powersetCard j,
        w S * ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) := by
      apply Finset.sum_le_sum
      intro S hS
      by_cases hOld : (S ∩ A).card = s ∧ (S ∩ M).card = j - s <;>
        by_cases hNew : (S ∩ A').card = s ∧ (S ∩ M').card = j - s
      · rw [if_pos hNew, if_pos hOld, sub_self, abs_zero]
        apply mul_nonneg (hw S)
        exact Nat.cast_nonneg _
      · have hne : (S ∩ partialTestStatusChanges A M A' M').Nonempty := by
          by_contra hnone
          have hinter :
              S ∩ partialTestStatusChanges A M A' M' = ∅ :=
            Finset.not_nonempty_iff_eq_empty.mp hnone
          have hcond := partialTestCondition_eq_of_disjoint_statusChanges
            A M A' M' S j s (Finset.disjoint_iff_inter_eq_empty.mpr hinter)
          change ((S ∩ A).card = s ∧ (S ∩ M).card = j - s) =
            ((S ∩ A').card = s ∧ (S ∩ M').card = j - s) at hcond
          exact hNew (hcond ▸ hOld)
        have hcard : (1 : ℝ) ≤
            ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) := by
          exact_mod_cast Finset.card_pos.mpr hne
        simp only [ge_iff_le]
        calc
          w S = w S * 1 := by ring
          _ ≤ w S * ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) :=
            mul_le_mul_of_nonneg_left hcard (hw S)
      · have hne : (S ∩ partialTestStatusChanges A M A' M').Nonempty := by
          by_contra hnone
          have hinter :
              S ∩ partialTestStatusChanges A M A' M' = ∅ :=
            Finset.not_nonempty_iff_eq_empty.mp hnone
          have hcond := partialTestCondition_eq_of_disjoint_statusChanges
            A M A' M' S j s (Finset.disjoint_iff_inter_eq_empty.mpr hinter)
          change ((S ∩ A).card = s ∧ (S ∩ M).card = j - s) =
            ((S ∩ A').card = s ∧ (S ∩ M').card = j - s) at hcond
          exact hOld (hcond.symm ▸ hNew)
        have hcard : (1 : ℝ) ≤
            ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) := by
          exact_mod_cast Finset.card_pos.mpr hne
        simp only [ge_iff_le]
        calc
          w S = w S * 1 := by ring
          _ ≤ w S * ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) :=
            mul_le_mul_of_nonneg_left hcard (hw S)
      · rw [if_neg hNew, if_neg hOld, sub_self, abs_zero]
        apply mul_nonneg (hw S)
        exact Nat.cast_nonneg _

theorem abs_partialTestObservable_insert_sub_le_sum_extensions
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V) {e : Finset V}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S) :
    |partialTestObservable w H C j s (insert e M) -
        partialTestObservable w H C j s M| ≤
      ∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M),
        testExtension w H j {f} := by
  calc
    |partialTestObservable w H C j s (insert e M) -
        partialTestObservable w H C j s M| ≤
      partialTestIncidenceCharge w H j
        (partialTestStatusChanges
          (availableEdges H C M) M
          (availableEdges H C (insert e M)) (insert e M)) :=
      abs_partialTestTotal_sub_le_incidenceCharge w H
        (availableEdges H C M) M
        (availableEdges H C (insert e M)) (insert e M) j s hw
    _ = partialTestIncidenceCharge w H j
        (availableEdges H C M \
          availableEdges H C (insert e M)) := by
      rw [partialTestStatusChanges_available_insert he]
    _ = ∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M),
        testExtension w H j {f} :=
      partialTestIncidenceCharge_eq_sum_testExtension w H _ j

theorem sum_testExtension_le_card_mul_trackable
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta : ℝ} (D : Hypergraph V)
    (hw : IsTrackable H C j ell d eta w) (hj : 2 ≤ j)
    (hDH : D ⊆ H) :
    (∑ f ∈ D, testExtension w H j {f}) ≤
      (D.card : ℝ) *
        (testTotal w H j / Real.rpow d (1 + eta)) := by
  calc
    (∑ f ∈ D, testExtension w H j {f}) ≤
        ∑ _f ∈ D,
          (testTotal w H j / Real.rpow d (1 + eta)) := by
      apply Finset.sum_le_sum
      intro f hf
      have hsingleton : ({f} : Hypergraph V) ⊆ H := by
        simpa using hDH hf
      simpa using hw.extension_upper (j' := 1) (by omega) (by omega)
        ({f} : Hypergraph V) hsingleton (by simp)
    _ = (D.card : ℝ) *
        (testTotal w H j / Real.rpow d (1 + eta)) := by
      simp

theorem abs_partialTestObservable_insert_sub_le_trackableSpread
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta : ℝ} (s : ℕ) (M : Hypergraph V)
    {e : Finset V} (he : e ∈ availableEdges H C M)
    (hw : IsTrackable H C j ell d eta w) (hj : 2 ≤ j) :
    |partialTestObservable w H C j s (insert e M) -
        partialTestObservable w H C j s M| ≤
      ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) *
        (testTotal w H j / Real.rpow d (1 + eta)) := by
  apply (abs_partialTestObservable_insert_sub_le_sum_extensions
    w H C j s M he hw.isTestFunction.nonneg).trans
  apply sum_testExtension_le_card_mul_trackable _ hw hj
  exact Finset.sdiff_subset.trans (availableEdges_subset H C M)

/-- Unweighted test supported on the `q`-link of `f`. -/
def conflictLinkTestWeight (C : ConflictSystem V) (f : Finset V) (q : ℕ) :
    TestWeight V :=
  fun Q => if Q ∈ conflictLinkLayer C f q then 1 else 0

@[simp] theorem conflictLinkTestWeight_apply
    (C : ConflictSystem V) (f : Finset V) (Q : Hypergraph V) (q : ℕ) :
    conflictLinkTestWeight C f q Q =
      if Q ∈ conflictLinkLayer C f q then 1 else 0 := rfl

theorem partialTestTotal_conflictLinkTestWeight
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V) (q s : ℕ)
    (A M : Hypergraph V) :
    partialTestTotal (conflictLinkTestWeight C f q) H A M q s =
      ((partialFamily (conflictLinkLayer C f q) A M s).card : ℝ) := by
  rw [partialTestTotal]
  simp only [conflictLinkTestWeight_apply]
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
  norm_cast
  apply congrArg Finset.card
  ext Q
  simp only [Finset.mem_filter, Finset.mem_powersetCard, mem_partialFamily]
  constructor
  · rintro ⟨⟨⟨hQH, hQcard⟩, hQA, hQM⟩, hQlink⟩
    exact ⟨hQlink, hQA, by simpa [hQcard] using hQM⟩
  · rintro ⟨hQlink, hQA, hQM⟩
    have hQcard : Q.card = q :=
      (mem_conflictLinkLayer.mp hQlink).2
    exact ⟨⟨⟨conflictLinkLayer_subset_host hC f q Q hQlink, hQcard⟩,
      hQA, by simpa [hQcard] using hQM⟩, hQlink⟩

theorem partialTestObservable_conflictLinkTestWeight
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V) (q s : ℕ)
    (M : Hypergraph V) :
    partialTestObservable (conflictLinkTestWeight C f q) H C q s M =
      ((partialFamily (conflictLinkLayer C f q)
        (availableEdges H C M) M s).card : ℝ) := by
  exact partialTestTotal_conflictLinkTestWeight hC f q s
    (availableEdges H C M) M

/-- Multiplicity-counted mass of one-available members of the three internal
link layers through `f`. -/
def internalOpenLinkMass (C : ConflictSystem V) (A M : Hypergraph V)
    (f : Finset V) : ℕ :=
  (partialFamily (conflictLinkLayer C f 1) A M 1).card +
    (partialFamily (conflictLinkLayer C f 2) A M 1).card +
    (partialFamily (conflictLinkLayer C f 3) A M 1).card

theorem card_partialFamily_union_filter_le
    (X : ConflictSystem V) (A M : Hypergraph V) (P : Finset V → Prop)
    [DecidablePred P] :
    (((partialFamily X A M 1).biUnion id).filter
      (fun e ↦ e ∈ A ∧ P e)).card ≤ (partialFamily X A M 1).card := by
  let F := partialFamily X A M 1
  have hsub : ((F.biUnion id).filter (fun e ↦ e ∈ A ∧ P e)) ⊆
      F.biUnion (fun Q ↦ Q ∩ A) := by
    intro e he
    have he' := Finset.mem_filter.mp he
    obtain ⟨Q, hQF, heQ⟩ := Finset.mem_biUnion.mp he'.1
    exact Finset.mem_biUnion.mpr
      ⟨Q, hQF, Finset.mem_inter.mpr
        ⟨by simpa only [id_eq] using heQ, he'.2.1⟩⟩
  calc
    (((F.biUnion id).filter (fun e ↦ e ∈ A ∧ P e)).card) ≤
        (F.biUnion (fun Q ↦ Q ∩ A)).card := Finset.card_le_card hsub
    _ ≤ ∑ Q ∈ F, (Q ∩ A).card := Finset.card_biUnion_le
    _ = ∑ _Q ∈ F, 1 := by
      apply Finset.sum_congr rfl
      intro Q hQ
      exact (mem_partialFamily.mp hQ).2.1
    _ = F.card := by simp

theorem openConflictCount_le_internalOpenLinkMass
    (C : ConflictSystem V) (A M : Hypergraph V) (f : Finset V) :
    openConflictCount C A M f ≤ internalOpenLinkMass C A M f := by
  have heq :
      ((activeConflictBlockers C A M f).filter
          (fun e ↦ e ∈ A ∧ Disjoint e f)) =
        (Finset.Icc 1 3).biUnion (fun q ↦
          (((partialFamily (conflictLinkLayer C f q) A M 1).biUnion id).filter
            (fun e ↦ e ∈ A ∧ Disjoint e f))) := by
    ext e
    simp only [activeConflictBlockers, Finset.mem_filter,
      Finset.mem_biUnion, id_eq]
    aesop
  rw [openConflictCount, heq]
  calc
    ((Finset.Icc 1 3).biUnion (fun q ↦
        ((partialFamily (conflictLinkLayer C f q) A M 1).biUnion id).filter
          (fun e ↦ e ∈ A ∧ Disjoint e f))).card ≤
        ∑ q ∈ Finset.Icc 1 3,
          (((partialFamily (conflictLinkLayer C f q) A M 1).biUnion id).filter
            (fun e ↦ e ∈ A ∧ Disjoint e f)).card := Finset.card_biUnion_le
    _ ≤ ∑ q ∈ Finset.Icc 1 3,
          (partialFamily (conflictLinkLayer C f q) A M 1).card := by
      apply Finset.sum_le_sum
      intro q hq
      exact card_partialFamily_union_filter_le
        (conflictLinkLayer C f q) A M (fun e ↦ Disjoint e f)
    _ = internalOpenLinkMass C A M f := by
      norm_num [internalOpenLinkMass, Finset.sum_Icc_succ_top]

namespace CFMTrajectories

/-- The three source centres of the one-available internal link layers add
exactly to the conflict-hazard trajectory. -/
theorem internalLinkCenters_sum_eq_cHat
    (D₂ D₃ D₄ d N x : ℝ) :
    D₂ * zHat D₂ D₃ D₄ d N 1 1 x +
        D₃ * zHat D₂ D₃ D₄ d N 2 1 x +
        D₄ * zHat D₂ D₃ D₄ d N 3 1 x =
      cHat D₂ D₃ D₄ d N x := by
  norm_num [zHat, cHat, Nat.choose]
  ring

/-- Three tracked internal-link coordinates control the actual open blocker
count, including the explicit multiplicity/filtering spread loss. -/
theorem openConflictCount_bounds_of_internalLinks
    {C : ConflictSystem V} {A M : Hypergraph V} {f : Finset V}
    {D₂ D₃ D₄ Gamma epsilon d N x spread : ℝ}
    (h₁ :
      D₂ * (zHat D₂ D₃ D₄ d N 1 1 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 1) A M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 1) A M 1).card : ℝ) ≤
        D₂ * (zHat D₂ D₃ D₄ d N 1 1 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x))
    (h₂ :
      D₃ * (zHat D₂ D₃ D₄ d N 2 1 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 2) A M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 2) A M 1).card : ℝ) ≤
        D₃ * (zHat D₂ D₃ D₄ d N 2 1 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x))
    (h₃ :
      D₄ * (zHat D₂ D₃ D₄ d N 3 1 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 3) A M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 3) A M 1).card : ℝ) ≤
        D₄ * (zHat D₂ D₃ D₄ d N 3 1 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x))
    (hspreadLower :
      0 ≤ (internalOpenLinkMass C A M f : ℝ) -
        (openConflictCount C A M f : ℝ))
    (hspreadUpper :
      (internalOpenLinkMass C A M f : ℝ) -
          (openConflictCount C A M f : ℝ) ≤ spread) :
    cHat D₂ D₃ D₄ d N x -
        (D₂ * zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
          D₃ * zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
          D₄ * zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x + spread) ≤
        (openConflictCount C A M f : ℝ) ∧
      (openConflictCount C A M f : ℝ) ≤
        cHat D₂ D₃ D₄ d N x +
          (D₂ * zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
            D₃ * zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
            D₄ * zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) := by
  have hcenter := internalLinkCenters_sum_eq_cHat D₂ D₃ D₄ d N x
  simp only [internalOpenLinkMass, Nat.cast_add] at hspreadLower hspreadUpper
  constructor <;> linarith

theorem openConflictCount_bounds_of_internalLinks_of_spread
    {C : ConflictSystem V} {A M : Hypergraph V} {f : Finset V}
    {D₂ D₃ D₄ Gamma epsilon d N x spread : ℝ}
    (h₁ :
      D₂ * (zHat D₂ D₃ D₄ d N 1 1 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 1) A M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 1) A M 1).card : ℝ) ≤
        D₂ * (zHat D₂ D₃ D₄ d N 1 1 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x))
    (h₂ :
      D₃ * (zHat D₂ D₃ D₄ d N 2 1 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 2) A M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 2) A M 1).card : ℝ) ≤
        D₃ * (zHat D₂ D₃ D₄ d N 2 1 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x))
    (h₃ :
      D₄ * (zHat D₂ D₃ D₄ d N 3 1 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 3) A M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 3) A M 1).card : ℝ) ≤
        D₄ * (zHat D₂ D₃ D₄ d N 3 1 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x))
    (hspread :
      (internalOpenLinkMass C A M f : ℝ) -
          (openConflictCount C A M f : ℝ) ≤ spread) :
    cHat D₂ D₃ D₄ d N x -
        (D₂ * zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
          D₃ * zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
          D₄ * zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x + spread) ≤
        (openConflictCount C A M f : ℝ) ∧
      (openConflictCount C A M f : ℝ) ≤
        cHat D₂ D₃ D₄ d N x +
          (D₂ * zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
            D₃ * zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
            D₄ * zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) := by
  apply openConflictCount_bounds_of_internalLinks h₁ h₂ h₃
  · exact sub_nonneg.mpr (by
      exact_mod_cast openConflictCount_le_internalOpenLinkMass C A M f)
  · exact hspread

/-- Taylor bridge from an exact partial-test mean increment to the two
envelopes around `scale * zHat`. -/
theorem partialTestEnvelope_drift_of_mean_window
    {D₂ D₃ D₄ Gamma epsilon d N x P scale mu : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hscale : 0 ≤ scale)
    (hmuLower :
      scale * (zHatRate D₂ D₃ D₄ d N j s x -
        zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤ mu)
    (hmuUpper :
      mu ≤ scale * (zHatRate D₂ D₃ D₄ d N j s x +
        zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x -
        2 * (d ^ ((s : ℝ) - j - epsilon) / N))) :
    mu - scale *
        ((zHat D₂ D₃ D₄ d N j s (x + 1) +
            zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
          (zHat D₂ D₃ D₄ d N j s x +
            zeta D₂ D₃ D₄ Gamma epsilon d N j s x)) ≤ 0 ∧
      -mu + scale *
        ((zHat D₂ D₃ D₄ d N j s (x + 1) -
            zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
          (zHat D₂ D₃ D₄ d N j s x -
            zeta D₂ D₃ D₄ Gamma epsilon d N j s x)) ≤ 0 := by
  have hz := zHat_oneStepTaylor_of_registry R
  have he := zeta_oneStepTaylor_of_registry R
  rw [abs_le] at hz he
  constructor <;> nlinarith

/-- Upper deterministic trajectory for an external weighted test, with its
initial total weight retained as the explicit scale `W`. -/
noncomputable def externalTestUpperTrajectory
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s : ℕ) (x : ℝ) : ℝ :=
  W * (zHat D₂ D₃ D₄ d N j s x +
    zeta D₂ D₃ D₄ Gamma epsilon d N j s x)

/-- Lower deterministic trajectory for an external weighted test. -/
noncomputable def externalTestLowerTrajectory
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s : ℕ) (x : ℝ) : ℝ :=
  W * (zHat D₂ D₃ D₄ d N j s x -
    zeta D₂ D₃ D₄ Gamma epsilon d N j s x)

/-- The source mean window implies nonpositive drift for both external-test
error envelopes. -/
theorem externalTestEnvelope_drift_of_mean_window
    {D₂ D₃ D₄ Gamma epsilon d N x P W mu : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hW : 0 ≤ W)
    (hmuLower :
      W * (zHatRate D₂ D₃ D₄ d N j s x -
          zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤ mu)
    (hmuUpper :
      mu ≤ W * (zHatRate D₂ D₃ D₄ d N j s x +
          zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N))) :
    mu - (externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
        externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x) ≤ 0 ∧
      (externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
        externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x) - mu ≤ 0 := by
  have hz := zHat_oneStepTaylor_of_registry R
  have he := zeta_oneStepTaylor_of_registry R
  rw [abs_le] at hz he
  unfold externalTestUpperTrajectory externalTestLowerTrajectory
  constructor <;> nlinarith

/-- The source Taylor estimates also bound the deterministic trajectory
part of a single external-test jump. -/
theorem externalTestTrajectory_step_abs_le
    {D₂ D₃ D₄ Gamma epsilon d N x P W : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hW : 0 ≤ W) :
    |externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
        externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x| ≤
      W * (|zHatRate D₂ D₃ D₄ d N j s x| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ∧
    |externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
        externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x| ≤
      W * (|zHatRate D₂ D₃ D₄ d N j s x| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by
  let dz := zHat D₂ D₃ D₄ d N j s (x + 1) -
    zHat D₂ D₃ D₄ d N j s x
  let de := zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1) -
    zeta D₂ D₃ D₄ Gamma epsilon d N j s x
  let rz := zHatRate D₂ D₃ D₄ d N j s x
  let re := zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x
  let B := d ^ ((s : ℝ) - j - epsilon) / N
  have hz : |dz - rz| ≤ B := by
    simpa only [dz, rz, B] using zHat_oneStepTaylor_of_registry R
  have he : |de - re| ≤ B := by
    simpa only [de, re, B] using zeta_oneStepTaylor_of_registry R
  have hdz : |dz| ≤ |rz| + B := by
    calc
      |dz| = |(dz - rz) + rz| := by congr 1; ring
      _ ≤ |dz - rz| + |rz| := abs_add_le _ _
      _ ≤ |rz| + B := by linarith
  have hde : |de| ≤ |re| + B := by
    calc
      |de| = |(de - re) + re| := by congr 1; ring
      _ ≤ |de - re| + |re| := abs_add_le _ _
      _ ≤ |re| + B := by linarith
  have hplus : |dz + de| ≤ |rz| + |re| + 2 * B :=
    (abs_add_le dz de).trans (by linarith)
  have hminus : |dz - de| ≤ |rz| + |re| + 2 * B :=
    (abs_sub dz de).trans (by linarith)
  constructor
  · calc
      |externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
            j s (x + 1) -
          externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
            j s x| = |W * (dz + de)| := by
              unfold externalTestUpperTrajectory
              congr 1
              dsimp only [dz, de]
              ring
      _ = W * |dz + de| := by rw [abs_mul, abs_of_nonneg hW]
      _ ≤ W * (|rz| + |re| + 2 * B) :=
        mul_le_mul_of_nonneg_left hplus hW
      _ = W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by rfl
  · calc
      |externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
            j s (x + 1) -
          externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
            j s x| = |W * (dz - de)| := by
              unfold externalTestLowerTrajectory
              congr 1
              dsimp only [dz, de]
              ring
      _ = W * |dz - de| := by rw [abs_mul, abs_of_nonneg hW]
      _ ≤ W * (|rz| + |re| + 2 * B) :=
        mul_le_mul_of_nonneg_left hminus hW
      _ = W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by rfl

end CFMTrajectories

open CFMTrajectories

/-- Literal upper-envelope error increment for an external weighted test. -/
noncomputable def externalTestUpperStep
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  (partialTestObservable w H C j s M' -
      externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
        j s (x + 1)) -
    (partialTestObservable w H C j s M -
      externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
        j s x)

/-- Literal lower-envelope error increment for an external weighted test. -/
noncomputable def externalTestLowerStep
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  (externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
      j s (x + 1) - partialTestObservable w H C j s M') -
    (externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
      j s x - partialTestObservable w H C j s M)

/-- Upper external-test envelope error at an integer greedy time. -/
noncomputable def externalTestUpperError
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : ℝ :=
  partialTestObservable w H C j s M -
    externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
      j s (k : ℝ)

/-- Lower external-test envelope error at an integer greedy time. -/
noncomputable def externalTestLowerError
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : ℝ :=
  externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
      j s (k : ℝ) -
    partialTestObservable w H C j s M

def externalTestUpperCorridor
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : Prop :=
  externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
    j s k M < 0

def externalTestLowerCorridor
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : Prop :=
  externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
    j s k M < 0

theorem externalTestUpperStep_eq_timeStep
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M M' : Hypergraph V) :
    externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s M M' =
      greedyTimeStep
        (externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s) k M M' := by
  simp only [externalTestUpperStep, greedyTimeStep, externalTestUpperError,
    Nat.cast_add, Nat.cast_one]

theorem externalTestLowerStep_eq_timeStep
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M M' : Hypergraph V) :
    externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s M M' =
      greedyTimeStep
        (externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s) k M M' := by
  simp only [externalTestLowerStep, greedyTimeStep, externalTestLowerError,
    Nat.cast_add, Nat.cast_one]

theorem not_externalTestUpperCorridor_iff
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) :
    ¬ externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
        j s k M ↔
      0 ≤ externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
        j s k M := by
  simp only [externalTestUpperCorridor, not_lt]

theorem not_externalTestLowerCorridor_iff
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) :
    ¬ externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
        j s k M ↔
      0 ≤ externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
        j s k M := by
  simp only [externalTestLowerCorridor, not_lt]

/-- At the terminal zero-available coordinate, the two external-test
corridors are exactly deterministic lower and upper bounds for the selected
matching's test weight. -/
theorem externalTestCorridors_terminal_bounds
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j k : ℕ)
    (M : Hypergraph V) (hM : IsMatching H M)
    (hupper : externalTestUpperCorridor w H C
      D₂ D₃ D₄ Gamma epsilon d N W j 0 k M)
    (hlower : externalTestLowerCorridor w H C
      D₂ D₃ D₄ Gamma epsilon d N W j 0 k M) :
    externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
        j 0 (k : ℝ) ≤ testTotal w M j ∧
      testTotal w M j ≤
        externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j 0 (k : ℝ) := by
  rw [externalTestUpperCorridor, externalTestUpperError,
    partialTestObservable_zero w H C M j hM] at hupper
  rw [externalTestLowerCorridor, externalTestLowerError,
    partialTestObservable_zero w H C M j hM] at hlower
  constructor <;> linarith

theorem externalTestUpperFirstFailureEvent_subset_tail
    {iota : Type*} [Fintype iota]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (T : ℕ)
    (P : iota → ℕ → Hypergraph V → Prop) (i : iota)
    (D₂ D₃ D₄ Gamma epsilon d N W t : ℝ) (j s : ℕ)
    (hcomponent : ∀ k S, P i k S ↔
      externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
        j s k S)
    (hinitial : externalTestUpperError w H C
      D₂ D₃ D₄ Gamma epsilon d N W j s 0 M ≤ -t) :
    greedyFirstFailureEvent H C M T P i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (fun q S S' ↦ externalTestUpperStep w H C
              D₂ D₃ D₄ Gamma epsilon d N W (q : ℝ) j s S S'))
          T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hfailCorridor : ¬ externalTestUpperCorridor w H C
      D₂ D₃ D₄ Gamma epsilon d N W j s (k + 1)
        (greedyStateFromAt H C M omega (k + 1)) := by
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hbad := (not_externalTestUpperCorridor_iff w H C
    D₂ D₃ D₄ Gamma epsilon d N W j s (k + 1) _).mp hfailCorridor
  have hfailure : ¬ indexedGreedyGood P (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    greedyStoppedStep_exit_imp_terminal_tail H C M T
      (indexedGreedyGood P)
      (fun q S S' ↦ externalTestUpperStep w H C
        D₂ D₃ D₄ Gamma epsilon d N W (q : ℝ) j s S S')
      (externalTestUpperError w H C
        D₂ D₃ D₄ Gamma epsilon d N W j s)
      omega hk hgood hfailure (by
        intro q hq
        exact externalTestUpperStep_eq_timeStep w H C
          D₂ D₃ D₄ Gamma epsilon d N W j s q _ _)
      hinitial hbad⟩

theorem externalTestLowerFirstFailureEvent_subset_tail
    {iota : Type*} [Fintype iota]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (T : ℕ)
    (P : iota → ℕ → Hypergraph V → Prop) (i : iota)
    (D₂ D₃ D₄ Gamma epsilon d N W t : ℝ) (j s : ℕ)
    (hcomponent : ∀ k S, P i k S ↔
      externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
        j s k S)
    (hinitial : externalTestLowerError w H C
      D₂ D₃ D₄ Gamma epsilon d N W j s 0 M ≤ -t) :
    greedyFirstFailureEvent H C M T P i ⊆
      Finset.univ.filter (fun omega ↦
        t ≤ Freedman.partialSum
          (greedyStoppedStepIncrement H C M T (indexedGreedyGood P)
            (fun q S S' ↦ externalTestLowerStep w H C
              D₂ D₃ D₄ Gamma epsilon d N W (q : ℝ) j s S S'))
          T omega) := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega
  obtain ⟨_, k, hk, hgood, hfail⟩ := homega
  have hfailCorridor : ¬ externalTestLowerCorridor w H C
      D₂ D₃ D₄ Gamma epsilon d N W j s (k + 1)
        (greedyStateFromAt H C M omega (k + 1)) := by
    intro hc
    exact hfail ((hcomponent (k + 1) _).2 hc)
  have hbad := (not_externalTestLowerCorridor_iff w H C
    D₂ D₃ D₄ Gamma epsilon d N W j s (k + 1) _).mp hfailCorridor
  have hfailure : ¬ indexedGreedyGood P (k + 1)
      (greedyStateFromAt H C M omega (k + 1)) := by
    intro hall
    exact hfail (hall i)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ omega,
    greedyStoppedStep_exit_imp_terminal_tail H C M T
      (indexedGreedyGood P)
      (fun q S S' ↦ externalTestLowerStep w H C
        D₂ D₃ D₄ Gamma epsilon d N W (q : ℝ) j s S S')
      (externalTestLowerError w H C
        D₂ D₃ D₄ Gamma epsilon d N W j s)
      omega hk hgood hfailure (by
        intro q hq
        exact externalTestLowerStep_eq_timeStep w H C
          D₂ D₃ D₄ Gamma epsilon d N W j s q _ _)
      hinitial hbad⟩

theorem greedyStepExpectation_externalTestUpperStep
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M : Hypergraph V) :
    greedyStepExpectation H C M
        (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W x j s M) =
      (meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M) -
        (externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
            j s (x + 1) -
          externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
            j s x) := by
  let Z : Hypergraph V → ℝ := partialTestObservable w H C j s
  let b : ℝ := -(externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
      j s (x + 1) -
    externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W j s x)
  have hfun :
      externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W x j s M =
        fun M' ↦ Z M' - Z M + b := by
    funext M'
    simp only [externalTestUpperStep, Z, b]
    ring
  rw [hfun, greedyStepExpectation_affine,
    greedyStepExpectation_partialTest_increment]
  simp only [b]
  ring

theorem greedyStepExpectation_externalTestLowerStep
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M : Hypergraph V) :
    greedyStepExpectation H C M
        (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W x j s M) =
      (externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
        externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x) -
      (meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M) := by
  let Z : Hypergraph V → ℝ := partialTestObservable w H C j s
  let b : ℝ := externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
      j s (x + 1) -
    externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W j s x
  have hfun :
      externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W x j s M =
        fun M' ↦ -(Z M' - Z M) + b := by
    funext M'
    simp only [externalTestLowerStep, Z, b]
    ring
  rw [hfun, greedyStepExpectation_affine, greedyStepExpectation_neg,
    greedyStepExpectation_partialTest_increment]
  simp only [b]
  ring

/-- One-state drift input for both stopped external-test envelopes.  The
remaining combinatorial obligation is exactly the displayed mean window. -/
theorem externalTest_oneState_stoppedDrift
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {D₂ D₃ D₄ Gamma epsilon d N x P W : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (_hj : j ≤ 3) (M : Hypergraph V)
    (hW : 0 ≤ W)
    (hmeanLower :
      W * (zHatRate D₂ D₃ D₄ d N j s x -
          zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
        meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M)
    (hmeanUpper :
      meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M ≤
        W * (zHatRate D₂ D₃ D₄ d N j s x +
          zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N))) :
    greedyStepExpectation H C M
        (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W x j s M) ≤ 0 ∧
      greedyStepExpectation H C M
        (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W x j s M) ≤ 0 := by
  have hbridge := externalTestEnvelope_drift_of_mean_window R hW
    hmeanLower hmeanUpper
  rw [greedyStepExpectation_externalTestUpperStep,
    greedyStepExpectation_externalTestLowerStep]
  exact hbridge

/-- One-state supermartingale drift for an unweighted internal conflict-link
test, reduced to its exact gain-minus-loss window. -/
theorem internalConflictLink_envelope_drift
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V)
    {D₂ D₃ D₄ Gamma epsilon d N x P scale : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hscale : 0 ≤ scale) (M : Hypergraph V)
    (hmuLower :
      scale * (zHatRate D₂ D₃ D₄ d N j s x -
        zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPartialTestGain (conflictLinkTestWeight C f j) H C j s M -
        meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s M)
    (hmuUpper :
      meanPartialTestGain (conflictLinkTestWeight C f j) H C j s M -
          meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s M ≤
        scale * (zHatRate D₂ D₃ D₄ d N j s x +
          zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N))) :
    greedyStepExpectation H C M (fun M' ↦
        (((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M') M' s).card : ℝ) -
            scale * (zHat D₂ D₃ D₄ d N j s (x + 1) +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1))) -
          (((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M) M s).card : ℝ) -
            scale * (zHat D₂ D₃ D₄ d N j s x +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x))) ≤ 0 ∧
      greedyStepExpectation H C M (fun M' ↦
        (scale * (zHat D₂ D₃ D₄ d N j s (x + 1) -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
            ((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M') M' s).card : ℝ)) -
          (scale * (zHat D₂ D₃ D₄ d N j s x -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x) -
            ((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M) M s).card : ℝ))) ≤ 0 := by
  let w := conflictLinkTestWeight C f j
  let X : Hypergraph V → ℝ := partialTestObservable w H C j s
  let mu := meanPartialTestGain w H C j s M -
    meanPartialTestLoss w H C j s M
  have hbase := partialTestEnvelope_drift_of_mean_window R hscale
    (mu := mu) hmuLower hmuUpper
  have hX (S : Hypergraph V) :
      X S = ((partialFamily (conflictLinkLayer C f j)
        (availableEdges H C S) S s).card : ℝ) := by
    exact partialTestObservable_conflictLinkTestWeight hC f j s S
  have hmean :
      greedyStepExpectation H C M (fun S ↦ X S - X M) = mu := by
    exact greedyStepExpectation_partialTest_increment w H C j s M
  have hupper :
      greedyStepExpectation H C M (fun M' ↦
        (((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M') M' s).card : ℝ) -
            scale * (zHat D₂ D₃ D₄ d N j s (x + 1) +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1))) -
          (((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M) M s).card : ℝ) -
            scale * (zHat D₂ D₃ D₄ d N j s x +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x))) =
        mu - scale *
          ((zHat D₂ D₃ D₄ d N j s (x + 1) +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
            (zHat D₂ D₃ D₄ d N j s x +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x)) := by
    have hfun : (fun M' ↦
        (((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M') M' s).card : ℝ) -
            scale * (zHat D₂ D₃ D₄ d N j s (x + 1) +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1))) -
          (((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M) M s).card : ℝ) -
            scale * (zHat D₂ D₃ D₄ d N j s x +
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x))) =
        (fun M' ↦ X M' - X M +
          (-scale *
            ((zHat D₂ D₃ D₄ d N j s (x + 1) +
                zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
              (zHat D₂ D₃ D₄ d N j s x +
                zeta D₂ D₃ D₄ Gamma epsilon d N j s x)))) := by
      funext M'
      rw [hX M', hX M]
      ring
    rw [hfun, greedyStepExpectation_affine, hmean]
    ring
  have hlower :
      greedyStepExpectation H C M (fun M' ↦
        (scale * (zHat D₂ D₃ D₄ d N j s (x + 1) -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
            ((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M') M' s).card : ℝ)) -
          (scale * (zHat D₂ D₃ D₄ d N j s x -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x) -
            ((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M) M s).card : ℝ))) =
        -mu + scale *
          ((zHat D₂ D₃ D₄ d N j s (x + 1) -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
            (zHat D₂ D₃ D₄ d N j s x -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x)) := by
    have hfun : (fun M' ↦
        (scale * (zHat D₂ D₃ D₄ d N j s (x + 1) -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
            ((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M') M' s).card : ℝ)) -
          (scale * (zHat D₂ D₃ D₄ d N j s x -
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x) -
            ((partialFamily (conflictLinkLayer C f j)
              (availableEdges H C M) M s).card : ℝ))) =
        (fun M' ↦ -(X M' - X M) +
          scale *
            ((zHat D₂ D₃ D₄ d N j s (x + 1) -
                zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
              (zHat D₂ D₃ D₄ d N j s x -
                zeta D₂ D₃ D₄ Gamma epsilon d N j s x))) := by
      funext M'
      rw [hX M', hX M]
      ring
    rw [hfun, greedyStepExpectation_affine,
      greedyStepExpectation_neg, hmean]
  constructor
  · rw [hupper]
    exact hbase.1
  · rw [hlower]
    exact hbase.2

/-- Local cap on the number of available edges whose status changes in one
legal transition. -/
def HasExternalTestStatusSpread (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (L : ℝ) : Prop :=
  ∀ e ∈ availableEdges H C M,
    (((availableEdges H C M \
      availableEdges H C (insert e M)).card : ℕ) : ℝ) ≤ L

theorem externalTestObservable_jump_le_of_trackable
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta L : ℝ} {M : Hypergraph V}
    (hw : IsTrackable H C j ell d eta w) (hd : 0 ≤ d)
    (hj2 : 2 ≤ j) (_hj3 : j ≤ 3)
    (hspread : HasExternalTestStatusSpread H C M L)
    (s : ℕ) {e : Finset V} (he : e ∈ availableEdges H C M) :
    |partialTestObservable w H C j s (insert e M) -
        partialTestObservable w H C j s M| ≤
      L * (testTotal w H j / Real.rpow d (1 + eta)) := by
  exact (abs_partialTestObservable_insert_sub_le_trackableSpread
    s M he hw hj2).trans
      (mul_le_mul_of_nonneg_right (hspread e he)
        (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
          (Real.rpow_nonneg hd _)))

/-- Singleton tests need a literal killed-weight cap because their W2
rooted-spread condition is vacuous. -/
def HasExternalSingletonWeightSpread (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (B : ℝ) : Prop :=
  ∀ e ∈ availableEdges H C M,
    (∑ f ∈ availableEdges H C M \
      availableEdges H C (insert e M), testExtension w H 1 {f}) ≤ B

theorem externalSingletonTestObservable_jump_le
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {ell : ℕ} {d eta B : ℝ} {M : Hypergraph V}
    (hw : IsTrackable H C 1 ell d eta w)
    (hspread : HasExternalSingletonWeightSpread w H C M B)
    (s : ℕ) {e : Finset V} (he : e ∈ availableEdges H C M) :
    |partialTestObservable w H C 1 s (insert e M) -
        partialTestObservable w H C 1 s M| ≤ B := by
  exact (abs_partialTestObservable_insert_sub_le_sum_extensions
    w H C 1 s M he hw.isTestFunction.nonneg).trans (hspread e he)

/-- Complete legal-transition jump bound for both external test envelopes
in the trackable range `2 ≤ j ≤ 3`. -/
theorem externalTestEnvelopeStep_abs_le_of_trackable
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {D₂ D₃ D₄ Gamma epsilon d N x P L : ℝ}
    {j ell s : ℕ} {M : Hypergraph V}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hw : IsTrackable H C j ell d epsilon w) (hd : 0 ≤ d)
    (hj2 : 2 ≤ j) (hj3 : j ≤ 3)
    (hspread : HasExternalTestStatusSpread H C M L)
    {e : Finset V} (he : e ∈ availableEdges H C M) :
    |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) x j s M (insert e M)| ≤
      L * (testTotal w H j / Real.rpow d (1 + epsilon)) +
        testTotal w H j *
          (|zHatRate D₂ D₃ D₄ d N j s x| +
            |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ∧
    |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) x j s M (insert e M)| ≤
      L * (testTotal w H j / Real.rpow d (1 + epsilon)) +
        testTotal w H j *
          (|zHatRate D₂ D₃ D₄ d N j s x| +
            |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by
  let W := testTotal w H j
  let Z : Hypergraph V → ℝ := partialTestObservable w H C j s
  let U := externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W j s
  let Q := externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W j s
  let J := L * (W / Real.rpow d (1 + epsilon))
  let T := W *
    (|zHatRate D₂ D₃ D₄ d N j s x| +
      |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
      2 * (d ^ ((s : ℝ) - j - epsilon) / N))
  have hW : 0 ≤ W := testTotal_nonneg hw.isTestFunction.nonneg H j
  have hZ : |Z (insert e M) - Z M| ≤ J := by
    simpa only [Z, W, J] using externalTestObservable_jump_le_of_trackable
      hw hd hj2 hj3 hspread s he
  have htraj := externalTestTrajectory_step_abs_le R hW
  have hU : |U (x + 1) - U x| ≤ T := by
    simpa only [U, W, T] using htraj.1
  have hQ : |Q (x + 1) - Q x| ≤ T := by
    simpa only [Q, W, T] using htraj.2
  constructor
  · change |(Z (insert e M) - U (x + 1)) - (Z M - U x)| ≤ J + T
    calc
      |(Z (insert e M) - U (x + 1)) - (Z M - U x)| =
          |(Z (insert e M) - Z M) - (U (x + 1) - U x)| := by
            congr 1
            ring
      _ ≤ |Z (insert e M) - Z M| + |U (x + 1) - U x| := abs_sub _ _
      _ ≤ J + T := add_le_add hZ hU
  · change |(Q (x + 1) - Z (insert e M)) - (Q x - Z M)| ≤ J + T
    calc
      |(Q (x + 1) - Z (insert e M)) - (Q x - Z M)| =
          |(Q (x + 1) - Q x) - (Z (insert e M) - Z M)| := by
            congr 1
            ring
      _ ≤ |Q (x + 1) - Q x| + |Z (insert e M) - Z M| := abs_sub _ _
      _ ≤ T + J := add_le_add hQ hZ
      _ = J + T := by ring

/-- A pointwise local bound lifts to the path process stopped at the first
failure of `Good`. -/
theorem greedyStoppedStateIncrement_abs_le_of_local
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (X : Hypergraph V → ℝ) (a : ℕ → Hypergraph V → ℝ) {R : ℝ}
    (hR0 : 0 ≤ R)
    (hlocal : ∀ k, k < T → ∀ S, Good k S → ∀ o : GreedyChoice H,
      |greedyLocalIncrement X a k S (greedyChoiceStep H C S o)| ≤ R) :
    ∀ k omega,
      |greedyStoppedStateIncrement H C M T Good X a k omega| ≤ R := by
  intro k omega
  by_cases hk : k < T
  · simp only [greedyStoppedStateIncrement, hk, if_true]
    by_cases hgood : greedyPrefixGood H C M Good k omega
    · rw [greedyStopIndicator]
      simp only [hgood, if_true, one_mul]
      rw [greedyStateFromAt_succ]
      exact hlocal k hk _ (hgood k le_rfl) _
    · simp [greedyStopIndicator, hgood, hR0]
  · simp [greedyStoppedStateIncrement, hk, hR0]

noncomputable def degreeSourceJumpScale (d epsilon : ℝ) : ℝ :=
  Real.rpow d (1 - epsilon / 4)

noncomputable def degreeSourceVarianceScale (d epsilon N : ℝ) : ℝ :=
  Real.rpow d (2 - 3 * epsilon / 16) / N

/-- A simultaneous real degree corridor supplies the integer bounds used by
the exact eight-uniform miss-loss double count. -/
theorem availableDegreeWithin_floor_ceil_bounds
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {lo hi : ℝ} (hlo : 0 ≤ lo)
    (htrack : AvailableDegreeWithin H C M lo hi) :
    (∀ x e, e ∈ availableEdges H C M → x ∈ e →
      Nat.floor lo ≤ degree (availableEdges H C M) x) ∧
    (∀ x e, e ∈ availableEdges H C M → x ∈ e →
      degree (availableEdges H C M) x ≤ Nat.ceil hi) := by
  constructor
  · intro x e heA hxe
    have hxU : x ∈ uncoveredVertices H M :=
      vertexFinset_availableEdges_subset_uncovered H C M
        (mem_vertexFinset.mpr ⟨e, heA, hxe⟩)
    have hr : ((Nat.floor lo : ℕ) : ℝ) ≤
        (degree (availableEdges H C M) x : ℝ) :=
      (Nat.floor_le hlo).trans (htrack x hxU).1
    exact_mod_cast hr
  · intro x e heA hxe
    have hxU : x ∈ uncoveredVertices H M :=
      vertexFinset_availableEdges_subset_uncovered H C M
        (mem_vertexFinset.mpr ⟨e, heA, hxe⟩)
    have hr : (degree (availableEdges H C M) x : ℝ) ≤
        ((Nat.ceil hi : ℕ) : ℝ) :=
      (htrack x hxU).2.trans (Nat.le_ceil hi)
    exact_mod_cast hr

/-- A real host pair-codegree bound passes to the available hypergraph,
with the sole integer rounding loss `ceil`. -/
theorem availableEdges_maxCodegreeLE_ceil_of_real
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {L : ℝ}
    (hco : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ L) :
    MaxCodegreeLE (availableEdges H C M) 2 (Nat.ceil L) := by
  intro s hs
  have hsub := codegree_mono_hypergraph (availableEdges_subset H C M) s
  have hr : (codegree (availableEdges H C M) s : ℝ) ≤
      ((Nat.ceil L : ℕ) : ℝ) := by
    calc
      (codegree (availableEdges H C M) s : ℝ) ≤ (codegree H s : ℕ) := by
        exact_mod_cast hsub
      _ ≤ L := hco s hs
      _ ≤ (Nat.ceil L : ℕ) := Nat.le_ceil L
  exact_mod_cast hr

/-- Combining the exact matching and conflict decompositions gives a
state-level window for the surviving-degree mean loss. -/
theorem meanMissAvailableDegreeLoss_bounds_of_degree_openConflict
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hH8 : IsUniform H 8)
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hM : IsConflictFreeMatching H C M)
    {Dlo Dhi L : ℕ}
    (hdeglo : ∀ x e, e ∈ availableEdges H C M → x ∈ e →
      Dlo ≤ degree (availableEdges H C M) x)
    (hdeghi : ∀ x e, e ∈ availableEdges H C M → x ∈ e →
      degree (availableEdges H C M) x ≤ Dhi)
    (hco : MaxCodegreeLE (availableEdges H C M) 2 L)
    {lo hi : ℝ}
    (hopen : OpenConflictCountWithin C (availableEdges H C M) M lo hi)
    (v : V) (hA : (availableEdges H C M).Nonempty) :
    (degree (availableEdges H C M) v : ℝ) *
          (((7 * Dlo - 28 * L : ℕ) : ℝ) + lo) /
        ((availableEdges H C M).card : ℝ) ≤
        meanMissAvailableDegreeLoss H C M v ∧
      meanMissAvailableDegreeLoss H C M v ≤
        (degree (availableEdges H C M) v : ℝ) *
            (((7 * Dhi : ℕ) : ℝ) + hi) /
          ((availableEdges H C M).card : ℝ) := by
  have hgeom := meanMissLostDegree_bounds_eight_uniform
    (availableEdges_uniform hH8 C M) hdeglo hdeghi hco v hA
  have hconf := meanConflictLostDegree_bounds_of_openConflictCountWithin
    hC hopen v hA
  rw [meanMissAvailableDegreeLoss_eq_add hHnonempty hM v]
  constructor
  · calc
      (degree (availableEdges H C M) v : ℝ) *
            (((7 * Dlo - 28 * L : ℕ) : ℝ) + lo) /
          ((availableEdges H C M).card : ℝ) =
          (degree (availableEdges H C M) v : ℝ) *
                ((7 * Dlo - 28 * L : ℕ) : ℝ) /
              ((availableEdges H C M).card : ℝ) +
            (degree (availableEdges H C M) v : ℝ) * lo /
              ((availableEdges H C M).card : ℝ) := by ring
      _ ≤ meanMissLostDegree (availableEdges H C M) v +
            meanConflictLostDegree H C M v := add_le_add hgeom.1 hconf.1
  · calc
      meanMissLostDegree (availableEdges H C M) v +
            meanConflictLostDegree H C M v ≤
          (degree (availableEdges H C M) v : ℝ) *
                ((7 * Dhi : ℕ) : ℝ) /
              ((availableEdges H C M).card : ℝ) +
            (degree (availableEdges H C M) v : ℝ) * hi /
              ((availableEdges H C M).card : ℝ) :=
        add_le_add hgeom.2 hconf.2
      _ = (degree (availableEdges H C M) v : ℝ) *
            (((7 * Dhi : ℕ) : ℝ) + hi) /
          ((availableEdges H C M).card : ℝ) := by ring

/-- The three internal-link corridors and their spread loss instantiate the
open-conflict hypothesis in the preceding theorem. -/
theorem meanMissAvailableDegreeLoss_bounds_of_degree_internalLinks
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hH8 : IsUniform H 8)
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hM : IsConflictFreeMatching H C M)
    {Dlo Dhi L : ℕ}
    (hdeglo : ∀ x e, e ∈ availableEdges H C M → x ∈ e →
      Dlo ≤ degree (availableEdges H C M) x)
    (hdeghi : ∀ x e, e ∈ availableEdges H C M → x ∈ e →
      degree (availableEdges H C M) x ≤ Dhi)
    (hco : MaxCodegreeLE (availableEdges H C M) 2 L)
    {D₂ D₃ D₄ Gamma epsilon d N x spread : ℝ}
    (h₁ : ∀ f ∈ availableEdges H C M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 1)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 1)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x))
    (h₂ : ∀ f ∈ availableEdges H C M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 2)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 2)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x))
    (h₃ : ∀ f ∈ availableEdges H C M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 3)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 3)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x))
    (hspread : ∀ f ∈ availableEdges H C M,
      (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) -
        (openConflictCount C (availableEdges H C M) M f : ℝ) ≤ spread)
    (v : V) (hA : (availableEdges H C M).Nonempty) :
    let err :=
      D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
      D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
      D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x
    (degree (availableEdges H C M) v : ℝ) *
          (((7 * Dlo - 28 * L : ℕ) : ℝ) +
            (CFMTrajectories.cHat D₂ D₃ D₄ d N x - (err + spread))) /
        ((availableEdges H C M).card : ℝ) ≤
        meanMissAvailableDegreeLoss H C M v ∧
      meanMissAvailableDegreeLoss H C M v ≤
        (degree (availableEdges H C M) v : ℝ) *
            (((7 * Dhi : ℕ) : ℝ) +
              (CFMTrajectories.cHat D₂ D₃ D₄ d N x + err)) /
          ((availableEdges H C M).card : ℝ) := by
  dsimp only
  apply meanMissAvailableDegreeLoss_bounds_of_degree_openConflict
    hHnonempty hH8 hC hM hdeglo hdeghi hco
  · intro f hf
    simpa only [add_assoc] using
      CFMTrajectories.openConflictCount_bounds_of_internalLinks_of_spread
        (h₁ f hf) (h₂ f hf) (h₃ f hf) (hspread f hf)
  · exact hA

/-- Rounded state-level bridge from degree and internal-link corridors to
the explicit combinatorial surviving-degree mean window. -/
theorem meanMissAvailableDegreeLoss_bounds_of_corridors_internalLinks
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hHnonempty : ∀ f ∈ H, f.Nonempty)
    (hH8 : IsUniform H 8)
    (hC : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hM : IsConflictFreeMatching H C M)
    {degreeLo degreeHi codegreeHi : ℝ}
    (hdegreeLo0 : 0 ≤ degreeLo)
    (hdegree : AvailableDegreeWithin H C M degreeLo degreeHi)
    (hcodegree : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ codegreeHi)
    {D₂ D₃ D₄ Gamma epsilon d N x spread : ℝ}
    (h₁ : ∀ f ∈ availableEdges H C M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 1)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 1)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x))
    (h₂ : ∀ f ∈ availableEdges H C M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 2)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 2)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x))
    (h₃ : ∀ f ∈ availableEdges H C M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x) ≤
          ((partialFamily (conflictLinkLayer C f 3)
            (availableEdges H C M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f 3)
          (availableEdges H C M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x))
    (hspread : ∀ f ∈ availableEdges H C M,
      (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) -
        (openConflictCount C (availableEdges H C M) M f : ℝ) ≤ spread)
    (v : V) (hA : (availableEdges H C M).Nonempty) :
    let err :=
      D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 x +
      D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 x +
      D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 x
    (degree (availableEdges H C M) v : ℝ) *
          (((7 * Nat.floor degreeLo - 28 * Nat.ceil codegreeHi : ℕ) : ℝ) +
            (CFMTrajectories.cHat D₂ D₃ D₄ d N x - (err + spread))) /
        ((availableEdges H C M).card : ℝ) ≤
        meanMissAvailableDegreeLoss H C M v ∧
      meanMissAvailableDegreeLoss H C M v ≤
        (degree (availableEdges H C M) v : ℝ) *
            (((7 * Nat.ceil degreeHi : ℕ) : ℝ) +
              (CFMTrajectories.cHat D₂ D₃ D₄ d N x + err)) /
          ((availableEdges H C M).card : ℝ) := by
  exact meanMissAvailableDegreeLoss_bounds_of_degree_internalLinks
    hHnonempty hH8 hC hM
    (availableDegreeWithin_floor_ceil_bounds H C M hdegreeLo0 hdegree).1
    (availableDegreeWithin_floor_ceil_bounds H C M hdegreeLo0 hdegree).2
    (availableEdges_maxCodegreeLE_ceil_of_real H C M hcodegree)
    h₁ h₂ h₃ hspread v hA

/-- Concrete combinatorial lower and upper bounds reduce the two source
mean-field obligations to scalar absorptions. -/
theorem survivingDegree_meanWindow_of_combinatorial_bounds
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V} {v : V}
    {D₂ D₃ D₄ Gamma epsilon d N x combLo combHi : ℝ}
    (hcomb : combLo ≤ meanMissAvailableDegreeLoss H C M v ∧
      meanMissAvailableDegreeLoss H C M v ≤ combHi)
    (hnumericLower :
      survivingVertexProbability H C v M *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N x -
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x +
            2 * (d ^ (1 - epsilon) / N)) ≤ combLo)
    (hnumericUpper :
      combHi ≤ survivingVertexProbability H C v M *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N x +
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x -
            2 * (d ^ (1 - epsilon) / N))) :
    survivingVertexProbability H C v M *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N x -
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x +
            2 * (d ^ (1 - epsilon) / N)) ≤
        meanMissAvailableDegreeLoss H C M v ∧
      meanMissAvailableDegreeLoss H C M v ≤
        survivingVertexProbability H C v M *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N x +
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N x -
            2 * (d ^ (1 - epsilon) / N)) :=
  ⟨hnumericLower.trans hcomb.1, hcomb.2.trans hnumericUpper⟩

/-- The centre of the matching-plus-open-conflict window is literally the
negative degree trajectory derivative. -/
theorem neg_degreeRate_eq_degree_openConflict_center
    {D₂ D₃ D₄ d N x : ℝ}
    (hd : 0 < d) (hN : 0 < N)
    (hpV : 0 < CFMTrajectories.pV N x) :
    -CFMTrajectories.degreeRate D₂ D₃ D₄ d N x =
      (CFMTrajectories.cHat D₂ D₃ D₄ d N x +
          7 * CFMTrajectories.dHat D₂ D₃ D₄ d N x) *
        CFMTrajectories.dHat D₂ D₃ D₄ d N x /
          CFMTrajectories.hHat D₂ D₃ D₄ d N x := by
  have h := (CFMTrajectories.hasDerivAt_dHat_degreeRate
    (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hN hpV).unique
      (CFMTrajectories.hasDerivAt_dHat_eq
        (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hN hpV)
  linarith

/-- Constructor for the full stopped-degree budget which replaces its two
mean fields by concrete combinatorial bounds and scalar absorptions. -/
theorem greedyStoppedStepIncrement_abs_le_of_local
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (Good : ℕ → Hypergraph V → Prop)
    (step : ℕ → Hypergraph V → Hypergraph V → ℝ) {R : ℝ}
    (hR : 0 ≤ R)
    (hlocal : ∀ k, k < T → ∀ S, Good k S → ∀ o : GreedyChoice H,
      |step k S (greedyChoiceStep H C S o)| ≤ R) :
    ∀ k omega,
      |greedyStoppedStepIncrement H C M T Good step k omega| ≤ R := by
  intro k omega
  by_cases hk : k < T
  · simp only [greedyStoppedStepIncrement, hk, if_true]
    by_cases hgood : greedyPrefixGood H C M Good k omega
    · rw [greedyStopIndicator]
      simp only [hgood, if_true, one_mul]
      rw [greedyStateFromAt_succ]
      exact hlocal k hk _ (hgood k le_rfl) _
    · simp [greedyStopIndicator, hgood, hR]
  · simp [greedyStoppedStepIncrement, hk, hR]

/-- All one-state estimates needed for the two external-test envelope
supermartingales.  The local jump fields are stated for raw greedy choices,
which covers both legal insertions and the frozen choice uniformly. -/
structure ExternalTestSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) : Prop where
  arity : j ≤ 3
  weight_nonneg : 0 ≤ W
  registry : ∀ k, k < T → ∀ S, Good k S →
    CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s
  meanLower : ∀ k, k < T → ∀ S, Good k S →
    W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPartialTestGain w H C j s S - meanPartialTestLoss w H C j s S
  meanUpper : ∀ k, k < T → ∀ S, Good k S →
    meanPartialTestGain w H C j s S - meanPartialTestLoss w H C j s S ≤
      W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) -
        2 * (d ^ ((s : ℝ) - j - epsilon) / N))
  upperJump : ∀ k, k < T → ∀ S, Good k S → ∀ o : GreedyChoice H,
    |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
      (k : ℝ) j s S (greedyChoiceStep H C S o)| ≤ jump k
  lowerJump : ∀ k, k < T → ∀ S, Good k S → ∀ o : GreedyChoice H,
    |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
      (k : ℝ) j s S (greedyChoiceStep H C S o)| ≤ jump k
  upperSquare : ∀ k, k < T → ∀ S, Good k S →
    greedyStepExpectation H C S (fun S' ↦
      (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s S S') ^ 2) ≤ variance k
  lowerSquare : ∀ k, k < T → ∀ S, Good k S →
    greedyStepExpectation H C S (fun S' ↦
      (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s S S') ^ 2) ≤ variance k

theorem externalTestStoppedMomentBounds_of_sourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (_hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (B : ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P W j s jump variance) :
    Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C M) (greedyInfo H T)
        (greedyStoppedStepIncrement H C M T Good
          (fun k S S' ↦ externalTestUpperStep w H C
            D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s S S')) variance ∧
      Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C M) (greedyInfo H T)
        (greedyStoppedStepIncrement H C M T Good
          (fun k S S' ↦ externalTestLowerStep w H C
            D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s S S')) variance := by
  constructor <;> apply greedyStoppedStepIncrement_momentBounds
  · exact hvariance
  · intro k hk S hgood
    exact (externalTest_oneState_stoppedDrift
      (B.registry k hk S hgood) B.arity S B.weight_nonneg
      (B.meanLower k hk S hgood) (B.meanUpper k hk S hgood)).1
  · intro k hk S hgood
    exact B.upperSquare k hk S hgood
  · exact hvariance
  · intro k hk S hgood
    exact (externalTest_oneState_stoppedDrift
      (B.registry k hk S hgood) B.arity S B.weight_nonneg
      (B.meanLower k hk S hgood) (B.meanUpper k hk S hgood)).2
  · intro k hk S hgood
    exact B.lowerSquare k hk S hgood

theorem externalTestStoppedIncrements_abs_le_of_sourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) {R : ℝ}
    (hR0 : 0 ≤ R) (hR : ∀ k, k < T → jump k ≤ R)
    (B : ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P W j s jump variance) :
    (∀ k omega,
      |greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ externalTestUpperStep w H C
          D₂ D₃ D₄ Gamma epsilon d N W (i : ℝ) j s S S')
        k omega| ≤ R) ∧
      (∀ k omega,
      |greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ externalTestLowerStep w H C
          D₂ D₃ D₄ Gamma epsilon d N W (i : ℝ) j s S S')
        k omega| ≤ R) := by
  constructor <;> apply greedyStoppedStepIncrement_abs_le_of_local <;>
    try exact hR0
  · intro k hk S hgood o
    exact (B.upperJump k hk S hgood o).trans (hR k hk)
  · intro k hk S hgood o
    exact (B.lowerJump k hk S hgood o).trans (hR k hk)

theorem externalTestFreedman_of_sourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P Wscale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (B : ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P Wscale j s jump variance)
    {R t Wvar : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ Wvar)
    (hden : 0 < Wvar + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ Wvar) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good
              (fun i S S' ↦ externalTestUpperStep w H C
                D₂ D₃ D₄ Gamma epsilon d N Wscale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good
              (fun i S S' ↦ externalTestLowerStep w H C
                D₂ D₃ D₄ Gamma epsilon d N Wscale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have hm := externalTestStoppedMomentBounds_of_sourceBudgets
    w H C M Good T D₂ D₃ D₄ Gamma epsilon d N P Wscale j s
      jump variance hjump hvariance B
  have hinc := externalTestStoppedIncrements_abs_le_of_sourceBudgets
    w H C M Good T D₂ D₃ D₄ Gamma epsilon d N P Wscale j s
      jump variance hR0 hR B
  constructor
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good
        (fun i S S' ↦ externalTestUpperStep w H C
          D₂ D₃ D₄ Gamma epsilon d N Wscale (i : ℝ) j s S S') k)
      hm.1 hR0 ht hW0 hden hinc.1 hW
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good
        (fun i S S' ↦ externalTestLowerStep w H C
          D₂ D₃ D₄ Gamma epsilon d N Wscale (i : ℝ) j s S S') k)
      hm.2 hR0 ht hW0 hden hinc.2 hW

theorem externalTestFirstFailureMass_le_of_sourceBudgets
    {iota : Type*} [Fintype iota]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (T : ℕ)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota)
    (D₂ D₃ D₄ Gamma epsilon d N P Wscale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (B : ExternalTestSourceBudgets w H C (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P Wscale j s jump variance)
    {R t Wvar : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ Wvar)
    (hden : 0 < Wvar + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ Wvar)
    (hUpperComponent : ∀ k S, Pgood iUpper k S ↔
      externalTestUpperCorridor w H C
        D₂ D₃ D₄ Gamma epsilon d N Wscale j s k S)
    (hLowerComponent : ∀ k S, Pgood iLower k S ↔
      externalTestLowerCorridor w H C
        D₂ D₃ D₄ Gamma epsilon d N Wscale j s k S)
    (hUpperInitial : externalTestUpperError w H C
      D₂ D₃ D₄ Gamma epsilon d N Wscale j s 0 M ≤ -t)
    (hLowerInitial : externalTestLowerError w H C
      D₂ D₃ D₄ Gamma epsilon d N Wscale j s 0 M ≤ -t) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T Pgood iUpper) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T Pgood iLower) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have htail := externalTestFreedman_of_sourceBudgets
    w H C M (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P Wscale j s
      jump variance hjump hvariance B hR0 ht hW0 hden hR hW
  constructor
  · exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
      (greedyPathMassFrom_nonneg H C M)
      (externalTestUpperFirstFailureEvent_subset_tail w H C M T
        Pgood iUpper D₂ D₃ D₄ Gamma epsilon d N Wscale t j s
        hUpperComponent hUpperInitial)).trans htail.1
  · exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
      (greedyPathMassFrom_nonneg H C M)
      (externalTestLowerFirstFailureEvent_subset_tail w H C M T
        Pgood iLower D₂ D₃ D₄ Gamma epsilon d N Wscale t j s
        hLowerComponent hLowerInitial)).trans htail.2

noncomputable def partialTestDrift (w : TestWeight V) (H : Hypergraph V)
    (C : ConflictSystem V) (j s : ℕ) (M : Hypergraph V) : ℝ :=
  meanPartialTestGain w H C j s M - meanPartialTestLoss w H C j s M

noncomputable def meanSqPartialTestIncrement (w : TestWeight V)
    (H : Hypergraph V) (C : ConflictSystem V) (j s : ℕ)
    (M : Hypergraph V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ A,
      (partialTestObservable w H C j s (insert e M) -
        partialTestObservable w H C j s M) ^ 2) / (A.card : ℝ)

theorem greedyStepExpectation_partialTest_increment_sq
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V) :
    greedyStepExpectation H C M (fun N ↦
        (partialTestObservable w H C j s N -
          partialTestObservable w H C j s M) ^ 2) =
      meanSqPartialTestIncrement w H C j s M := by
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty H C M _ hA]
    simp [meanSqPartialTestIncrement, A, hA]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [greedyStepExpectation_eq_average H C M _ hAne]
    simp only [meanSqPartialTestIncrement, A, hA, if_false]

theorem greedyStepExpectation_centered_sq_le_raw_sq
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) (mu : ℝ)
    (hmean : greedyStepExpectation H C M (fun N ↦ X N - X M) = mu) :
    greedyStepExpectation H C M
        (fun N ↦ (X N - X M - mu) ^ 2) ≤
      greedyStepExpectation H C M
        (fun N ↦ (X N - X M) ^ 2) := by
  have hfun : (fun N ↦ (X N - X M - mu) ^ 2) =
      (fun N ↦
        ((X N - X M) ^ 2 + (-2 * mu) * (X N - X M)) + mu ^ 2) := by
    funext N
    ring
  rw [hfun, greedyStepExpectation_affine, greedyStepExpectation_add,
    greedyStepExpectation_const_mul, hmean]
  nlinarith [sq_nonneg mu]

theorem greedyStepExpectation_centeredPartialTest
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s k : ℕ) (M : Hypergraph V) :
    greedyStepExpectation H C M
        (greedyLocalIncrement (partialTestObservable w H C j s)
          (fun _ U ↦ -partialTestDrift w H C j s U) k M) = 0 := by
  have hraw := greedyStepExpectation_partialTest_increment w H C j s M
  have hraw' :
      greedyStepExpectation H C M (partialTestObservable w H C j s) -
          partialTestObservable w H C j s M =
        partialTestDrift w H C j s M := by
    calc
      greedyStepExpectation H C M (partialTestObservable w H C j s) -
          partialTestObservable w H C j s M =
          greedyStepExpectation H C M (fun N ↦
            partialTestObservable w H C j s N -
              partialTestObservable w H C j s M) := by
        simpa only [add_zero] using
          (greedyStepExpectation_sub_current_add H C M
            (partialTestObservable w H C j s) 0).symm
      _ = partialTestDrift w H C j s M := by
        simpa only [partialTestDrift] using hraw
  unfold greedyLocalIncrement
  rw [greedyStepExpectation_sub_current_add, hraw']
  ring

theorem greedyStepExpectation_centeredPartialTest_sq
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s k : ℕ) (M : Hypergraph V) :
    greedyStepExpectation H C M
        (fun N ↦
          (greedyLocalIncrement (partialTestObservable w H C j s)
            (fun _ U ↦ -partialTestDrift w H C j s U) k M N) ^ 2) ≤
      meanSqPartialTestIncrement w H C j s M := by
  let X := partialTestObservable w H C j s
  let mu := partialTestDrift w H C j s M
  have hmean : greedyStepExpectation H C M (fun N ↦ X N - X M) = mu := by
    simpa [X, mu, partialTestDrift] using
      greedyStepExpectation_partialTest_increment w H C j s M
  have hcenter := greedyStepExpectation_centered_sq_le_raw_sq
    H C M X mu hmean
  have hraw := greedyStepExpectation_partialTest_increment_sq w H C j s M
  change greedyStepExpectation H C M
      (fun N ↦ (X N - X M + -mu) ^ 2) ≤
    meanSqPartialTestIncrement w H C j s M
  have hsame : (fun N ↦ (X N - X M + -mu) ^ 2) =
      (fun N ↦ (X N - X M - mu) ^ 2) := by
    funext N
    ring
  rw [hsame]
  exact hcenter.trans_eq hraw

noncomputable def testSourceJumpScale (P d epsilon : ℝ) : ℝ :=
  P * Real.rpow d (-epsilon / 4)

noncomputable def testSourceVarianceScale (P d epsilon N : ℝ) : ℝ :=
  P ^ 2 * Real.rpow d (-3 * epsilon / 16) / N

/-- Explicit source-scale hypotheses for a tracked test of arity two or
three.  They separate the local spread, drift and raw-square obligations. -/
def PartialTestSourceBudgets (w : TestWeight V) (H : Hypergraph V)
    (C : ConflictSystem V) (Good : ℕ → Hypergraph V → Prop) (T j s ell : ℕ)
    (d eta epsilon N P : ℝ) : Prop :=
  IsTrackable H C j ell d eta w ∧ 2 ≤ j ∧ j ≤ 3 ∧
  ∀ k, k < T → ∀ M, Good k M →
    (∀ e ∈ availableEdges H C M,
      ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) *
          (testTotal w H j / Real.rpow d (1 + eta)) ≤
        testSourceJumpScale P d epsilon / 2) ∧
    |partialTestDrift w H C j s M| ≤
      testSourceJumpScale P d epsilon / 2 ∧
    meanSqPartialTestIncrement w H C j s M ≤
      testSourceVarianceScale P d epsilon N

theorem partialTestChoice_raw_abs_le_of_spread
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta B : ℝ} (s : ℕ) (M : Hypergraph V)
    (hw : IsTrackable H C j ell d eta w) (hj : 2 ≤ j) (hB0 : 0 ≤ B)
    (hspread : ∀ e ∈ availableEdges H C M,
      ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) *
          (testTotal w H j / Real.rpow d (1 + eta)) ≤ B) :
    ∀ o : GreedyChoice H,
      |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
        partialTestObservable w H C j s M| ≤ B := by
  intro o
  rcases o with _ | e
  · simp [greedyChoiceStep, hB0]
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · rw [greedyChoiceStep, greedyStep_eq_insert he]
      exact (abs_partialTestObservable_insert_sub_le_trackableSpread
        s M he hw hj).trans (hspread (e : Finset V) he)
    · rw [greedyChoiceStep, greedyStep_eq_self he]
      simp [hB0]

theorem partialTest_centeredLocalIncrement_abs_le
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta B : ℝ} (s k : ℕ) (M : Hypergraph V)
    (hw : IsTrackable H C j ell d eta w) (hj : 2 ≤ j) (hB0 : 0 ≤ B)
    (hspread : ∀ e ∈ availableEdges H C M,
      ((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℝ) *
          (testTotal w H j / Real.rpow d (1 + eta)) ≤ B)
    (hdrift : |partialTestDrift w H C j s M| ≤ B) :
    ∀ o : GreedyChoice H,
      |greedyLocalIncrement (partialTestObservable w H C j s)
          (fun _ U ↦ -partialTestDrift w H C j s U) k M
          (greedyChoiceStep H C M o)| ≤ 2 * B := by
  intro o
  have hraw := partialTestChoice_raw_abs_le_of_spread
    s M hw hj hB0 hspread o
  unfold greedyLocalIncrement
  calc
    |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
          partialTestObservable w H C j s M +
          -partialTestDrift w H C j s M| ≤
        |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
          partialTestObservable w H C j s M| +
          |-partialTestDrift w H C j s M| := abs_add_le _ _
    _ ≤ B + B := add_le_add hraw (by simpa using hdrift)
    _ = 2 * B := by ring

theorem partialTestStoppedIncrement_abs_le_sourceScale
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (Good : ℕ → Hypergraph V → Prop)
    (T j s ell : ℕ) (d eta epsilon N P : ℝ)
    (hd : 0 ≤ d) (hP : 0 ≤ P)
    (hbudget : PartialTestSourceBudgets
      w H C Good T j s ell d eta epsilon N P) :
    ∀ k omega,
      |greedyStoppedStateIncrement H C M T Good
          (partialTestObservable w H C j s)
          (fun _ U ↦ -partialTestDrift w H C j s U) k omega| ≤
        testSourceJumpScale P d epsilon := by
  have hR0 : 0 ≤ testSourceJumpScale P d epsilon :=
    mul_nonneg hP (Real.rpow_nonneg hd _)
  apply greedyStoppedStateIncrement_abs_le_of_local H C M T Good _ _ hR0
  intro k hk S hgood
  have hb := hbudget.2.2.2 k hk S hgood
  have hhalf0 : 0 ≤ testSourceJumpScale P d epsilon / 2 := by
    positivity
  have hlocal := partialTest_centeredLocalIncrement_abs_le
    s k S hbudget.1 hbudget.2.1 hhalf0 hb.1 hb.2.1
  intro o
  exact (hlocal o).trans_eq (by ring)

theorem partialTestStoppedMomentBounds_sourceScale
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (Good : ℕ → Hypergraph V → Prop)
    (T j s ell : ℕ) (d eta epsilon N P : ℝ)
    (hd : 0 ≤ d) (hN : 0 < N)
    (hbudget : PartialTestSourceBudgets
      w H C Good T j s ell d eta epsilon N P) :
    Freedman.ConditionalMomentBounds
      (greedyPathMassFrom H C M) (greedyInfo H T)
      (greedyStoppedStateIncrement H C M T Good
        (partialTestObservable w H C j s)
        (fun _ U ↦ -partialTestDrift w H C j s U))
      (fun _ ↦ testSourceVarianceScale P d epsilon N) := by
  apply greedyStoppedStateIncrement_momentBounds
  · intro k
    exact div_nonneg
      (mul_nonneg (sq_nonneg P) (Real.rpow_nonneg hd _)) (le_of_lt hN)
  · intro k hk S hgood
    rw [greedyStepExpectation_centeredPartialTest w H C j s k S]
  · intro k hk S hgood
    exact (greedyStepExpectation_centeredPartialTest_sq w H C j s k S).trans
      (hbudget.2.2.2 k hk S hgood).2.2

def SatisfiesTestEstimates {ι : Type*} (H M : Hypergraph V) (d err : ℝ)
    (j : ι → ℕ) (w : ι → TestWeight V) : Prop :=
  ∀ i,
    (1 - err) * Real.rpow d (-(j i : ℝ)) * testTotal (w i) H (j i) ≤
        testTotal (w i) M (j i) ∧
    testTotal (w i) M (j i) ≤
      (1 + err) * Real.rpow d (-(j i : ℝ)) * testTotal (w i) H (j i)

/-- The exact finite hypotheses of the specialization needed for Erdős 136:
the host is 8-uniform, conflicts are 4-uniform, and tests have uniformity at
most 3.  The constant `ell` is retained because it also absorbs the constant
in the maximum conflict-degree estimate; it need not equal four. -/
def IsSpecializedCFMInstance {ι : Type*} [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (d eta : ℝ) (ell : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V) : Prop :=
  IsUniform H 8 ∧
  IsConflictSystem H C ∧
  4 ≤ ell ∧
  (∀ c ∈ C, c.card = 4) ∧
  0 < eta ∧ eta < 1 ∧ 1 ≤ d ∧
  ((vertexFinset H).card : ℝ) ≤ Real.exp (Real.rpow d (eta ^ 3)) ∧
  (∀ v ∈ vertexFinset H,
    (1 - Real.rpow d (-eta)) * d ≤ (degree H v : ℝ) ∧
    (degree H v : ℝ) ≤ d) ∧
  (∀ s, s.card = 2 →
    (codegree H s : ℝ) ≤ Real.rpow d (1 - eta)) ∧
  IsBounded C d ell eta ∧
  ((Fintype.card ι : ℕ) : ℝ) ≤ Real.exp (Real.rpow d (eta ^ 3)) ∧
  (∀ i, 1 ≤ j i ∧ j i ≤ 3 ∧ IsTrackable H C (j i) ell d eta (w i))

/-- The quantitative conclusion of the specialized conflict-free matching
theorem. -/
def SpecializedCFMConclusion {ι : Type*} [Fintype V]
    (H : Hypergraph V) (C : ConflictSystem V) (d eta : ℝ)
    (j : ι → ℕ) (w : ι → TestWeight V) : Prop :=
  ∃ M, IsMatching H M ∧ ConflictFree C M ∧
    (1 - Real.rpow d (-(eta ^ 3))) * ((vertexFinset H).card : ℝ) / 8 ≤
      (M.card : ℝ) ∧
    SatisfiesTestEstimates H M d (Real.rpow d (-(eta ^ 3))) j w

/-- The specialized Glock--Joos--Kim--Kühn--Lichev assertion required by
the Joos--Mubayi construction, recorded as a closed proposition.  Here
`ell` is fixed, host uniformity is eight, conflict uniformity is encoded by
`IsBounded`, and all test uniformities have already been restricted to
`1, 2, 3` by `IsSpecializedCFMInstance`.

Separating the closed assertion from its hypotheses prevents accidental
weakening of the target while the finite random-greedy proof is developed. -/
def SpecializedCFMTheorem (ell : ℕ) : Prop :=
  ∃ eta0 : ℝ, 0 < eta0 ∧
    ∀ eta : ℝ, 0 < eta → eta < eta0 →
      ∃ d0 : ℝ, ∀ d : ℝ, d0 ≤ d →
        ∀ (V ι : Type) [DecidableEq V] [Fintype V] [Fintype ι],
          ∀ (H : Hypergraph V) (C : ConflictSystem V)
            (j : ι → ℕ) (w : ι → TestWeight V),
            IsSpecializedCFMInstance H C d eta ell j w →
              SpecializedCFMConclusion H C d eta j w

/-- The ceiling choice needed by the random-greedy stopping time.  A floor
would lose one edge and would not imply the real lower bound in
`SpecializedCFMConclusion`.  If the desired uncovered proportion leaves
more than one edge of slack, the ceiling is still strictly below `N / 8`,
so it is a legitimate pre-terminal stopping time. -/
theorem ceil_almostPerfect_target (N : ℕ) (err : ℝ)
    (herr1 : err ≤ 1)
    (hslack : 1 < err * (N : ℝ) / 8) :
    let target := Nat.ceil ((1 - err) * (N : ℝ) / 8)
    (1 - err) * (N : ℝ) / 8 ≤ (target : ℝ) ∧
      (target : ℝ) < (N : ℝ) / 8 := by
  dsimp
  have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg N
  have hx0 : 0 ≤ (1 - err) * (N : ℝ) / 8 := by positivity
  constructor
  · exact Nat.le_ceil _
  · refine (Nat.ceil_lt_add_one hx0).trans ?_
    nlinarith

/-- Quantitative extraction once a prefix invariant has been certified.

The first hypothesis rounds the desired real lower bound down to an integer
target.  The second is the one-step invariant supplied by the successful
finite greedy outcome. -/
theorem conflictFreeAlmostPerfect_of_extendable
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (P : Hypergraph V → Prop) (j : ι → ℕ) (w : ι → TestWeight V)
    (d eta : ℝ) (N target : ℕ) (hC : ∅ ∉ C)
    (hround :
      (1 - Real.rpow d (-(eta ^ 3))) * (N : ℝ) / 8 ≤ (target : ℝ))
    (hext : ExtendableWithInvariant H C target P)
    (hterminal : ∀ M, P M → M.card = target →
      SatisfiesTestEstimates H M d (Real.rpow d (-(eta ^ 3))) j w) :
    ∃ M, IsMatching H M ∧ ConflictFree C M ∧
      (1 - Real.rpow d (-(eta ^ 3))) * (N : ℝ) / 8 ≤ (M.card : ℝ) ∧
      SatisfiesTestEstimates H M d (Real.rpow d (-(eta ^ 3))) j w := by
  obtain ⟨M, hM, hPM, hcard⟩ :=
    exists_conflictFree_matching_card_eq_of_extendableWithInvariant
      H C P hC hext
  refine ⟨M, hM.1, hM.2, ?_, hterminal M hPM hcard⟩
  simpa [hcard] using hround

/-- Exact extraction form of the specialized theorem.  It isolates the two
facts which a stopped random-greedy/Freedman argument must certify: an
integer rounding of the target, and a prefix invariant whose terminal state
obeys all test estimates. -/
theorem specializedCFMConclusion_of_greedyCertificate
    {ι : Type*} [Fintype V] [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (d eta : ℝ) (ell : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V) (P : Hypergraph V → Prop)
    (target : ℕ)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (hround :
      (1 - Real.rpow d (-(eta ^ 3))) * ((vertexFinset H).card : ℝ) / 8 ≤
        (target : ℝ))
    (hext : ExtendableWithInvariant H C target P)
    (hterminal : ∀ M, P M → M.card = target →
      SatisfiesTestEstimates H M d (Real.rpow d (-(eta ^ 3))) j w) :
    SpecializedCFMConclusion H C d eta j w := by
  rcases hinst with
    ⟨_, _, _, _, _, _, _, _, _, _, hbounded, _, _⟩
  have hCempty : ∅ ∉ C := hbounded.empty_not_mem
  exact conflictFreeAlmostPerfect_of_extendable
    H C P j w d eta (vertexFinset H).card target hCempty hround hext hterminal

/-! ## Maximal conflict-free matchings -/

/-- Every finite hypergraph has a maximum-cardinality conflict-free
matching, provided that the empty family is not itself declared a conflict.
This elementary result is useful as the terminal fallback for a greedy
process, but (unlike the random-greedy theorem) makes no near-perfectness
claim. -/
theorem exists_max_card_conflictFree_matching
    (H : Hypergraph V) (C : ConflictSystem V) (hC : ∅ ∉ C) :
    ∃ M, IsConflictFreeMatching H C M ∧
      ∀ N, IsConflictFreeMatching H C N → N.card ≤ M.card := by
  classical
  let candidates :=
    H.powerset.filter (fun M => IsConflictFreeMatching H C M)
  have hempty : (∅ : Hypergraph V) ∈ candidates := by
    simp only [candidates, Finset.mem_filter, Finset.empty_mem_powerset, true_and]
    exact isConflictFreeMatching_empty H hC
  obtain ⟨M, hMcand, hmax⟩ :=
    Finset.exists_max_image candidates Finset.card ⟨∅, hempty⟩
  refine ⟨M, (Finset.mem_filter.mp hMcand).2, ?_⟩
  intro N hN
  apply hmax N
  exact Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hN.1.1, hN⟩

/-- A maximum-cardinality conflict-free matching cannot be extended by one
new edge while retaining both constraints. -/
theorem max_card_conflictFree_matching_not_extendable
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (_hM : IsConflictFreeMatching H C M)
    (hmax : ∀ N, IsConflictFreeMatching H C N → N.card ≤ M.card) :
    ∀ e ∈ H, e ∉ M →
      ¬IsConflictFreeMatching H C (insert e M) := by
  intro e heH heM hins
  have hle := hmax (insert e M) hins
  simp [heM] at hle

/-! ## Activity-aware internal conflict-link corridors -/

noncomputable def internalConflictLinkUpperError
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : ℝ :=
  ((partialFamily (conflictLinkLayer C f j)
      (availableEdges H C M) M s).card : ℝ) -
    scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ))

noncomputable def internalConflictLinkLowerError
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : ℝ :=
  scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)) -
    ((partialFamily (conflictLinkLayer C f j)
      (availableEdges H C M) M s).card : ℝ)

noncomputable def activeInternalConflictLinkUpperStep
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  if f ∈ availableEdges H C M then
    (((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M') M' s).card : ℝ) -
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1))) -
      (((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ) -
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x))
  else 0

noncomputable def activeInternalConflictLinkLowerStep
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) : ℝ :=
  if f ∈ availableEdges H C M then
    (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (x + 1) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (x + 1)) -
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M') M' s).card : ℝ)) -
      (scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s x) -
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ))
  else 0

def internalConflictLinkUpperCorridor
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : Prop :=
  f ∉ availableEdges H C M ∨
    internalConflictLinkUpperError H C f D₂ D₃ D₄ Gamma epsilon d N
      scale j s k M < 0

def internalConflictLinkLowerCorridor
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) : Prop :=
  f ∉ availableEdges H C M ∨
    internalConflictLinkLowerError H C f D₂ D₃ D₄ Gamma epsilon d N
      scale j s k M < 0

theorem not_internalConflictLinkUpperCorridor_iff
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) :
    ¬ internalConflictLinkUpperCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k M ↔
      f ∈ availableEdges H C M ∧
        0 ≤ internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s k M := by
  simp only [internalConflictLinkUpperCorridor, not_or, not_not, not_lt]

theorem not_internalConflictLinkLowerCorridor_iff
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) :
    ¬ internalConflictLinkLowerCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k M ↔
      f ∈ availableEdges H C M ∧
        0 ≤ internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s k M := by
  simp only [internalConflictLinkLowerCorridor, not_or, not_not, not_lt]

theorem activeInternalConflictLinkUpperStep_eq_timeStep
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M M' : Hypergraph V) (hf : f ∈ availableEdges H C M) :
    activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s M M' =
      greedyTimeStep
        (internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s) k M M' := by
  simp only [activeInternalConflictLinkUpperStep, hf, if_true,
    greedyTimeStep, internalConflictLinkUpperError, Nat.cast_add, Nat.cast_one]

theorem activeInternalConflictLinkLowerStep_eq_timeStep
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M M' : Hypergraph V) (hf : f ∈ availableEdges H C M) :
    activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s M M' =
      greedyTimeStep
        (internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s) k M M' := by
  simp only [activeInternalConflictLinkLowerStep, hf, if_true,
    greedyTimeStep, internalConflictLinkLowerError, Nat.cast_add, Nat.cast_one]

theorem activeInternalConflictLinkUpperStep_eq_externalTestUpperStep
    {H : Hypergraph V} {C : ConflictSystem V} (hC : IsConflictSystem H C)
    (f : Finset V) (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ)
    (j s : ℕ) (M M' : Hypergraph V)
    (hf : f ∈ availableEdges H C M) :
    activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' =
      externalTestUpperStep (conflictLinkTestWeight C f j) H C
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' := by
  rw [activeInternalConflictLinkUpperStep, if_pos hf, externalTestUpperStep,
    partialTestObservable_conflictLinkTestWeight hC f j s M,
    partialTestObservable_conflictLinkTestWeight hC f j s M']
  rfl

theorem activeInternalConflictLinkLowerStep_eq_externalTestLowerStep
    {H : Hypergraph V} {C : ConflictSystem V} (hC : IsConflictSystem H C)
    (f : Finset V) (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ)
    (j s : ℕ) (M M' : Hypergraph V)
    (hf : f ∈ availableEdges H C M) :
    activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' =
      externalTestLowerStep (conflictLinkTestWeight C f j) H C
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M M' := by
  rw [activeInternalConflictLinkLowerStep, if_pos hf, externalTestLowerStep,
    partialTestObservable_conflictLinkTestWeight hC f j s M,
    partialTestObservable_conflictLinkTestWeight hC f j s M']
  rfl

theorem mem_availableEdges_greedyStateFromAt_of_le
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {T i k : ℕ} (omega : GreedyOutcome H T) (hik : i ≤ k)
    {f : Finset V}
    (hf : f ∈ availableEdges H C (greedyStateFromAt H C M omega k)) :
    f ∈ availableEdges H C (greedyStateFromAt H C M omega i) := by
  exact availableEdges_antitone
    (greedyStateFromAt_mono H C M omega hik) hf

theorem activeInternalConflictLinkSteps_eq_zero_of_inactive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale x : ℝ) (j s : ℕ)
    (M : Hypergraph V) (hf : f ∉ availableEdges H C M)
    (o : GreedyChoice H) :
    activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M
          (greedyChoiceStep H C M o) = 0 ∧
      activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale x j s M
          (greedyChoiceStep H C M o) = 0 := by
  simp [activeInternalConflictLinkUpperStep,
    activeInternalConflictLinkLowerStep, hf]

theorem greedyStepExpectation_activeInternalConflictLinkSteps_eq_zero_of_inactive
