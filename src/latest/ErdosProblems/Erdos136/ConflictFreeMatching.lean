            (availableEdges H R.regularized M) M ((u.1 + 1) - 1) ≤
          2 * finiteWeightedRootShadowMargin eta d
            (3 * scale * Real.rpow d
              ((r : ℝ) - (q.1 + 1 : ℕ) - epsRaw / 10))
            0 ((r - 2) - ((u.1 + 1) - 1)) := by
      intro r hr
      exact internalResidualPartialMass_le_profileMargin
        H C d epsRaw GammaCert ell D₂ D₃ D₄ GammaCore eta N T j w R E S
          hd heps hell1 (fun a ↦ (htrack a).1)
          (fun a ↦ (htrack a).2.1) hdegree hresidualCutoff
          hN hT hk hcombined f.1 f.2 (q.1 + 1) (u.1 + 1) r
