    (by simpa only [D, delta] using hb.2) haLo haHi
  have hkReal : (k : ℝ) <
      (1 - CFMNumeric.stoppingMargin eta d) * N / 8 :=
    Nat.lt_ceil.mp (by
      simpa only [CFMNumericAggregation.targetTime, N] using hk)
  have huMargin : CFMNumeric.stoppingMargin eta d * N < u := by
