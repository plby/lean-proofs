open Finset
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V]

theorem mem_availableBlockerChoices_comm
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {e f : Finset V} (he : e ∈ availableEdges H C M)
    (hf : f ∈ availableEdges H C M) :
    f ∈ availableBlockerChoices H C M e ↔
      e ∈ availableBlockerChoices H C M f := by
  simp only [availableBlockerChoices, Finset.mem_filter, he, hf, true_and]
  constructor
  · rintro (rfl | hbad)
    · exact Or.inl rfl
    · refine Or.inr ?_
      simpa [Finset.insert_comm e f] using hbad
  · rintro (rfl | hbad)
    · exact Or.inl rfl
    · refine Or.inr ?_
      simpa [Finset.insert_comm e f] using hbad

theorem mem_availableDeletionChoices_comm
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    {e f : Finset V} (he : e ∈ availableEdges H C M)
    (hf : f ∈ availableEdges H C M) :
    f ∈ availableEdges H C M \ availableEdges H C (insert e M) ↔
      e ∈ availableEdges H C M \ availableEdges H C (insert f M) := by
  rw [availableEdges_insert_eq_sdiff_blockers,
    availableEdges_insert_eq_sdiff_blockers]
  simp only [Finset.mem_sdiff, he, hf, true_and, not_not]
  exact mem_availableBlockerChoices_comm H C M he hf

theorem partialTestIncidenceCharge_le_rank_mul_testTotal
    (w : TestWeight V) (H A : Hypergraph V) (j : ℕ)
    (hw : ∀ S, 0 ≤ w S) :
    partialTestIncidenceCharge w H j A ≤
      (j : ℝ) * testTotal w H j := by
  unfold partialTestIncidenceCharge testTotal
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro S hS
  have hScard : S.card = j := (Finset.mem_powersetCard.mp hS).2
  have hcardNat : (S ∩ A).card ≤ j := by
    rw [← hScard]
    exact Finset.card_le_card Finset.inter_subset_left
  have hcard : (((S ∩ A).card : ℕ) : ℝ) ≤ j := by
    exact_mod_cast hcardNat
  nlinarith [mul_le_mul_of_nonneg_left hcard (hw S)]

theorem partialTestStepGain_loss_le_statusSpread_extensionCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (L E : ℝ)
    (hw : ∀ S, 0 ≤ w S) (hE0 : 0 ≤ E)
    (hspread : HasExternalTestStatusSpread H C M L)
    (hextension : ∀ f ∈ availableEdges H C M,
      testExtension w H j {f} ≤ E) :
    (∀ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e ≤ L * E) ∧
    (∀ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e ≤ L * E) := by
  have hsum (e : Finset V) (he : e ∈ availableEdges H C M) :
      partialTestStepGain w H C j s M e +
          partialTestStepLoss w H C j s M e ≤ L * E := by
    have hbase := partialTestStepGain_add_loss_le_sum_extensions
      w H C M j s he hw
    apply hbase.trans
    calc
      ∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M), testExtension w H j {f} ≤
          ∑ _f ∈ availableEdges H C M \
            availableEdges H C (insert e M), E := by
        apply Finset.sum_le_sum
        intro f hf
        exact hextension f (Finset.sdiff_subset hf)
      _ = (((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℕ) : ℝ) * E := by
        simp
      _ ≤ L * E :=
        mul_le_mul_of_nonneg_right (hspread e he) hE0
  constructor <;> intro e he
  · have hl0 := partialTestStepLoss_nonneg w H C M j s e hw
    linarith [hsum e he]
  · have hg0 := partialTestStepGain_nonneg w H C M j s e hw
    linarith [hsum e he]

/-! Summing the gain/loss incidence charge over every available choice and
using symmetry of the deletion relation exposes the missing factor
`1 / |A|`: each available edge is charged by at most its own deletion
neighbourhood size. -/

theorem sum_partialTestGain_add_loss_le_statusSpread_rank_total
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (L : ℝ)
    (hw : ∀ S, 0 ≤ w S) (hL0 : 0 ≤ L)
    (hspread : HasExternalTestStatusSpread H C M L) :
    ∑ e ∈ availableEdges H C M,
        (partialTestStepGain w H C j s M e +
          partialTestStepLoss w H C j s M e) ≤
      L * (j : ℝ) * testTotal w H j := by
  let A := availableEdges H C M
  let D : Finset V → Hypergraph V := fun e ↦
    A \ availableEdges H C (insert e M)
  let g : Finset V → ℝ := fun f ↦ testExtension w H j {f}
  have hstep :
      ∑ e ∈ A,
          (partialTestStepGain w H C j s M e +
            partialTestStepLoss w H C j s M e) ≤
        ∑ e ∈ A, ∑ f ∈ D e, g f := by
    apply Finset.sum_le_sum
    intro e he
    exact partialTestStepGain_add_loss_le_sum_extensions
      w H C M j s he hw
  have hDsub (e : Finset V) : D e ⊆ A := Finset.sdiff_subset
  have hswap :
      (∑ e ∈ A, ∑ f ∈ D e, g f) =
        ∑ f ∈ A,
          (((A.filter fun e ↦ f ∈ D e).card : ℕ) : ℝ) * g f := by
    calc
      (∑ e ∈ A, ∑ f ∈ D e, g f) =
          ∑ e ∈ A, ∑ f ∈ A, if f ∈ D e then g f else 0 := by
        apply Finset.sum_congr rfl
        intro e he
        rw [← Finset.sum_filter]
        congr 1
        ext f
        simp only [Finset.mem_filter]
        constructor
        · exact fun h ↦ ⟨hDsub e h, h⟩
        · exact fun h ↦ h.2
      _ = ∑ f ∈ A, ∑ e ∈ A, if f ∈ D e then g f else 0 := by
        rw [Finset.sum_comm]
      _ = ∑ f ∈ A,
          (((A.filter fun e ↦ f ∈ D e).card : ℕ) : ℝ) * g f := by
        apply Finset.sum_congr rfl
        intro f hf
        rw [← Finset.sum_filter]
        simp [mul_comm]
  have hfilter (f : Finset V) (hf : f ∈ A) :
      A.filter (fun e ↦ f ∈ D e) = D f := by
    ext e
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨he, hfe⟩
      exact (mem_availableDeletionChoices_comm H C M
        (show e ∈ availableEdges H C M from he)
        (show f ∈ availableEdges H C M from hf)).mp hfe
    · intro hef
      have he : e ∈ A := hDsub f hef
      exact ⟨he, (mem_availableDeletionChoices_comm H C M
        (show e ∈ availableEdges H C M from he)
        (show f ∈ availableEdges H C M from hf)).mpr hef⟩
  have hweighted :
      ∑ f ∈ A,
          (((A.filter fun e ↦ f ∈ D e).card : ℕ) : ℝ) * g f ≤
        L * ∑ f ∈ A, g f := by
    calc
      ∑ f ∈ A,
          (((A.filter fun e ↦ f ∈ D e).card : ℕ) : ℝ) * g f ≤
          ∑ f ∈ A, L * g f := by
        apply Finset.sum_le_sum
        intro f hf
        have hcard : (((D f).card : ℕ) : ℝ) ≤ L := by
          simpa only [A, D] using hspread f hf
        rw [hfilter f hf]
        exact mul_le_mul_of_nonneg_right hcard
          (testExtension_nonneg hw H j {f})
      _ = L * ∑ f ∈ A, g f := by rw [Finset.mul_sum]
  calc
    ∑ e ∈ availableEdges H C M,
        (partialTestStepGain w H C j s M e +
          partialTestStepLoss w H C j s M e) ≤
        ∑ e ∈ A, ∑ f ∈ D e, g f := hstep
    _ = ∑ f ∈ A,
          (((A.filter fun e ↦ f ∈ D e).card : ℕ) : ℝ) * g f := hswap
    _ ≤ L * ∑ f ∈ A, g f := hweighted
    _ = L * partialTestIncidenceCharge w H j A := by
      rw [partialTestIncidenceCharge_eq_sum_testExtension]
    _ ≤ L * ((j : ℝ) * testTotal w H j) :=
      mul_le_mul_of_nonneg_left
        (partialTestIncidenceCharge_le_rank_mul_testTotal w H A j hw) hL0
    _ = L * (j : ℝ) * testTotal w H j := by ring

theorem meanPartialTestGain_add_loss_le_statusSpread_rank_total
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (L : ℝ)
    (hw : ∀ S, 0 ≤ w S) (hL0 : 0 ≤ L)
    (hA : (availableEdges H C M).Nonempty)
    (hspread : HasExternalTestStatusSpread H C M L) :
    meanPartialTestGain w H C j s M +
        meanPartialTestLoss w H C j s M ≤
      (L * (j : ℝ) * testTotal w H j) /
        ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ := hA.ne_empty
  have hcard : 0 < ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  simp only [meanPartialTestGain, meanPartialTestLoss, hAne, if_false]
  rw [← add_div]
  exact (div_le_div_iff_of_pos_right hcard).2 (by
    rw [← Finset.sum_add_distrib]
    exact sum_partialTestGain_add_loss_le_statusSpread_rank_total
      w H C M j s L hw hL0 hspread)

theorem meanSqPartialTestIncrement_le_statusSpread_rank_total
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (L cap : ℝ)
    (hw : ∀ S, 0 ≤ w S) (hL0 : 0 ≤ L) (hcap0 : 0 ≤ cap)
    (hA : (availableEdges H C M).Nonempty)
    (hspread : HasExternalTestStatusSpread H C M L)
    (hgainCap : ∀ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e ≤ cap)
    (hlossCap : ∀ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e ≤ cap) :
    meanSqPartialTestIncrement w H C j s M ≤
      cap * ((L * (j : ℝ) * testTotal w H j) /
        ((availableEdges H C M).card : ℝ)) := by
  exact (meanSqPartialTestIncrement_le_cap_mul_meanGain_add_meanLoss
      w H C M j s hw hgainCap hlossCap).trans
    (mul_le_mul_of_nonneg_left
      (meanPartialTestGain_add_loss_le_statusSpread_rank_total
        w H C M j s L hw hL0 hA hspread) hcap0)

theorem testTotal_conflictLinkTestWeight_eq_card
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V) (q : ℕ) :
    testTotal (conflictLinkTestWeight C f q) H q =
      ((conflictLinkLayer C f q).card : ℝ) := by
  have h := partialTestTotal_conflictLinkTestWeight hC f q q H ∅
  rw [partialTestTotal_initial,
    partialConflictLink_initial hC f q] at h
  exact h

theorem meanSqInternalConflictLinkIncrement_le_statusSpread
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V)
    (M : Hypergraph V) (q s : ℕ) (L cap : ℝ)
    (hL0 : 0 ≤ L) (hcap0 : 0 ≤ cap)
    (hA : (availableEdges H C M).Nonempty)
    (hspread : HasExternalTestStatusSpread H C M L)
    (hgainCap : ∀ e ∈ availableEdges H C M,
      partialTestStepGain (conflictLinkTestWeight C f q)
        H C q s M e ≤ cap)
    (hlossCap : ∀ e ∈ availableEdges H C M,
      partialTestStepLoss (conflictLinkTestWeight C f q)
        H C q s M e ≤ cap) :
    meanSqPartialTestIncrement (conflictLinkTestWeight C f q)
        H C q s M ≤
      cap * ((L * (q : ℝ) * ((conflictLinkLayer C f q).card : ℝ)) /
        ((availableEdges H C M).card : ℝ)) := by
  have h := meanSqPartialTestIncrement_le_statusSpread_rank_total
    (conflictLinkTestWeight C f q) H C M q s L cap
    (by intro S; unfold conflictLinkTestWeight; split <;> norm_num)
    hL0 hcap0 hA hspread
    hgainCap hlossCap
  simpa only [testTotal_conflictLinkTestWeight_eq_card hC f q] using h

end

