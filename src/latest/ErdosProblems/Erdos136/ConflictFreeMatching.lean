        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M) :
    (∀ f ∈ availableEdges H R.regularized M,
      (internalOpenLinkMass R.regularized
          (availableEdges H R.regularized M) M f : ℝ) -
        (openConflictCount R.regularized
          (availableEdges H R.regularized M) M f : ℝ) ≤
          1536 * localSpreadPrimaryMargin eta d) ∧
    (∀ f ∈ availableEdges H R.regularized M,
      ∀ g ∈ availableEdges H R.regularized M, Disjoint f g → ∀ v ∈ g,
        CFMRegularization.conditionC4Count H R.regularized f v +
            (localConflictLinkPartialAtVertex R.regularized
              (availableEdges H R.regularized M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex R.regularized
              (availableEdges H R.regularized M) M f 3 1 v).card ≤
          certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d) ∧
    (∀ f ∈ availableEdges H R.regularized M,
      ∀ g ∈ availableEdges H R.regularized M, g ≠ f → Disjoint f g →
      {f, g} ∉ conflictLayer R.regularized 2 →
      ∀ q ∈ Finset.Icc 1 3, ∀ r ∈ Finset.Icc 1 5,
        ((partialFamily
          (testConflictUnionLayer
            (conflictLinkLayer R.regularized f q) R.regularized g r)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
            2 * localSpreadPrimaryMargin eta d) ∧
    (∀ a : io, ∀ s : Fin (j a + 1),
