  let inside := CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s (k : ℝ)
  let insidep := CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j (s + 1) (k : ℝ)
  let numerator := ((s + 1 : ℕ) : ℝ) * Zp + (s : ℝ) * status * Z
  let common := scale * (Gamma * Env / (N * pv))
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp : 0 < pv := by
    dsimp only [pv]
    exact CFMTrajectories.pV_pos R.delta.degree.N_pos
