theorem externalTestEnvelopeStep_abs_le_self
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M : Hypergraph V)
    {P J : ℝ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hW : 0 ≤ W) (hJ : 0 ≤ J) :
    |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M| ≤
      J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ∧
    |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M| ≤
      J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by
  have htraj := externalTestTrajectory_step_abs_le R hW
  constructor
  · calc
      |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
          x j s M M| =
          |-(externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x)| := by
            unfold externalTestUpperStep
            congr 1
            ring
      _ = |externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x| := abs_neg _
      _ ≤ W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := htraj.1
      _ ≤ J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := le_add_of_nonneg_left hJ
  · calc
      |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
          x j s M M| =
          |externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x| := by
            unfold externalTestLowerStep
            congr 1
            ring
      _ ≤ W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := htraj.2
      _ ≤ J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := le_add_of_nonneg_left hJ

noncomputable def externalTrackableTestJump
    (w : TestWeight V) (H : Hypergraph V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j s : ℕ)
    (L : ℕ → ℝ) (k : ℕ) : ℝ :=
  L k * (testTotal w H j / Real.rpow d (1 + epsilon)) +
    testTotal w H j *
      (|zHatRate D₂ D₃ D₄ d N j s (k : ℝ)| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N))

noncomputable def externalTrackableTestVariance
    (w : TestWeight V) (H : Hypergraph V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j s : ℕ)
    (L : ℕ → ℝ) (k : ℕ) : ℝ :=
  (externalTrackableTestJump w H D₂ D₃ D₄ Gamma epsilon d N
    j s L k) ^ 2

theorem greedyStepExpectation_sq_le_sq_of_choice_abs_le
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (X : Hypergraph V → ℝ) (R : ℝ)
    (hR : ∀ o : GreedyChoice H,
      |X (greedyChoiceStep H C M o)| ≤ R) :
    greedyStepExpectation H C M (fun M' ↦ (X M') ^ 2) ≤ R ^ 2 := by
  have hR0 : 0 ≤ R :=
    (abs_nonneg (X (greedyChoiceStep H C M none))).trans (hR none)
  apply greedyStepExpectation_le_const_of_choices
  intro o
  simpa only [sq_abs] using
    (sq_le_sq₀ (abs_nonneg _) hR0).2 (hR o)

theorem externalTestEnvelopeChoiceStep_abs_le_of_trackable
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {D₂ D₃ D₄ Gamma epsilon d N P L : ℝ}
    {j ell s k : ℕ} {M : Hypergraph V}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s)
    (hw : IsTrackable H C j ell d epsilon w) (hd : 0 ≤ d)
    (hj2 : 2 ≤ j) (hj3 : j ≤ 3) (hL0 : 0 ≤ L)
    (hspread : HasExternalTestStatusSpread H C M L) :
    ∀ o : GreedyChoice H,
      |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N
          (testTotal w H j) (k : ℝ) j s M
          (greedyChoiceStep H C M o)| ≤
        externalTrackableTestJump w H D₂ D₃ D₄ Gamma epsilon d N
          j s (fun _ ↦ L) k ∧
      |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N
          (testTotal w H j) (k : ℝ) j s M
          (greedyChoiceStep H C M o)| ≤
        externalTrackableTestJump w H D₂ D₃ D₄ Gamma epsilon d N
          j s (fun _ ↦ L) k := by
  have hW : 0 ≤ testTotal w H j :=
    testTotal_nonneg hw.isTestFunction.nonneg H j
  have hJ : 0 ≤ L * (testTotal w H j / Real.rpow d (1 + epsilon)) :=
    mul_nonneg hL0
      (div_nonneg hW (Real.rpow_nonneg hd _))
  intro o
  rcases o with _ | e
  · simpa only [greedyChoiceStep, externalTrackableTestJump] using
      externalTestEnvelopeStep_abs_le_self w H C
        D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j) (k : ℝ)
        j s M R hW hJ
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · rw [greedyChoiceStep, greedyStep_eq_insert he]
      simpa only [externalTrackableTestJump] using
        externalTestEnvelopeStep_abs_le_of_trackable R hw hd hj2 hj3
          hspread he
    · rw [greedyChoiceStep, greedyStep_eq_self he]
      simpa only [externalTrackableTestJump] using
        externalTestEnvelopeStep_abs_le_self w H C
          D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j) (k : ℝ)
          j s M R hW hJ

theorem ExternalTestSourceBudgets.mono_jump
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P W : ℝ) (j s : ℕ)
    (jump jump' variance : ℕ → ℝ)
    (B : ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P W j s jump variance)
    (hjump : ∀ k, k < T → jump k ≤ jump' k) :
    ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P W j s jump' variance := by
  refine {
    arity := B.arity
    weight_nonneg := B.weight_nonneg
    registry := B.registry
    meanLower := B.meanLower
    meanUpper := B.meanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := B.upperSquare
    lowerSquare := B.lowerSquare }
  · intro k hk S hgood o
    exact (B.upperJump k hk S hgood o).trans (hjump k hk)
  · intro k hk S hgood o
    exact (B.lowerJump k hk S hgood o).trans (hjump k hk)


theorem externalTestEnvelopeStep_abs_le_of_observableJump
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M M' : Hypergraph V) {P J : ℝ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (hW : 0 ≤ W)
    (hobservable :
      |partialTestObservable w H C j s M' -
        partialTestObservable w H C j s M| ≤ J) :
    |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M'| ≤
      J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ∧
    |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M'| ≤
      J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
        |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by
  have htraj := externalTestTrajectory_step_abs_le R hW
  constructor
  · calc
      |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
          x j s M M'| =
          |(partialTestObservable w H C j s M' -
              partialTestObservable w H C j s M) -
            (externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x)| := by
            unfold externalTestUpperStep
            congr 1
            ring
      _ ≤ |partialTestObservable w H C j s M' -
              partialTestObservable w H C j s M| +
            |externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x| := abs_sub _ _
      _ ≤ J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) :=
        add_le_add hobservable htraj.1
  · calc
      |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
          x j s M M'| =
          |(externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x) -
            (partialTestObservable w H C j s M' -
              partialTestObservable w H C j s M)| := by
            unfold externalTestLowerStep
            congr 1
            ring
      _ ≤ |externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s (x + 1) -
            externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
              j s x| +
            |partialTestObservable w H C j s M' -
              partialTestObservable w H C j s M| := abs_sub _ _
      _ ≤ W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) + J :=
        add_le_add htraj.2 hobservable
      _ = J + W * (|zHatRate D₂ D₃ D₄ d N j s x| +
          |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x| +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) := by ring

noncomputable def externalTestTrajectoryJump
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s : ℕ)
    (k : ℕ) : ℝ :=
  W * (|zHatRate D₂ D₃ D₄ d N j s (k : ℝ)| +
    |zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)| +
    2 * (d ^ ((s : ℝ) - j - epsilon) / N))

noncomputable def externalTestSharpVariance
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s : ℕ)
    (rawVariance : ℕ → ℝ) (k : ℕ) : ℝ :=
  2 * rawVariance k +
    2 * (externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N W
      j s k) ^ 2

theorem externalTestEnvelopeStep_squareExpectation_le
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W x : ℝ) (j s : ℕ)
    (M : Hypergraph V) :
    greedyStepExpectation H C M (fun M' ↦
      (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M') ^ 2) ≤
      2 * meanSqPartialTestIncrement w H C j s M +
        2 * (externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
          externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x) ^ 2 ∧
    greedyStepExpectation H C M (fun M' ↦
      (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M') ^ 2) ≤
      2 * meanSqPartialTestIncrement w H C j s M +
        2 * (externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (x + 1) -
          externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s x) ^ 2 := by
  let Z : Hypergraph V → ℝ := partialTestObservable w H C j s
  let du := externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
    j s (x + 1) - externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
    j s x
  let dl := externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
    j s (x + 1) - externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
    j s x
  have hupperPoint : ∀ M',
      (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M') ^ 2 ≤ 2 * (Z M' - Z M) ^ 2 + 2 * du ^ 2 := by
    intro M'
    have hs := sq_nonneg ((Z M' - Z M) + du)
    simp only [externalTestUpperStep, Z, du]
    nlinarith
  have hlowerPoint : ∀ M',
      (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        x j s M M') ^ 2 ≤ 2 * (Z M' - Z M) ^ 2 + 2 * dl ^ 2 := by
    intro M'
    have hs := sq_nonneg ((Z M' - Z M) + dl)
    simp only [externalTestLowerStep, Z, dl]
    nlinarith
  constructor
  · apply (greedyStepExpectation_mono H C M hupperPoint).trans_eq
    rw [greedyStepExpectation_add,
      greedyStepExpectation_const_mul,
      greedyStepExpectation_partialTest_increment_sq,
      greedyStepExpectation_const]
  · apply (greedyStepExpectation_mono H C M hlowerPoint).trans_eq
    rw [greedyStepExpectation_add,
      greedyStepExpectation_const_mul,
      greedyStepExpectation_partialTest_increment_sq,
      greedyStepExpectation_const]

theorem externalTestEnvelopeStep_squareExpectation_le_sharpVariance
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N W : ℝ) (j s k : ℕ)
    (M : Hypergraph V) {P Q : ℝ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s)
    (hW : 0 ≤ W)
    (hraw : meanSqPartialTestIncrement w H C j s M ≤ Q) :
    greedyStepExpectation H C M (fun M' ↦
      (externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s M M') ^ 2) ≤
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N W
        j s (fun _ ↦ Q) k ∧
    greedyStepExpectation H C M (fun M' ↦
      (externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N W
        (k : ℝ) j s M M') ^ 2) ≤
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N W
        j s (fun _ ↦ Q) k := by
  have hbase := externalTestEnvelopeStep_squareExpectation_le
    w H C D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s M
  have htraj := externalTestTrajectory_step_abs_le R hW
  let Tj := externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N W j s k
  have hT0 : 0 ≤ Tj :=
    (abs_nonneg _).trans (by simpa only [Tj, externalTestTrajectoryJump] using htraj.1)
  have huSq :
      (externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s ((k : ℝ) + 1) -
        externalTestUpperTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (k : ℝ)) ^ 2 ≤ Tj ^ 2 := by
    simpa only [sq_abs] using
      (sq_le_sq₀ (abs_nonneg _) hT0).2
        (by simpa only [Tj, externalTestTrajectoryJump] using htraj.1)
  have hlSq :
      (externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s ((k : ℝ) + 1) -
        externalTestLowerTrajectory D₂ D₃ D₄ Gamma epsilon d N W
          j s (k : ℝ)) ^ 2 ≤ Tj ^ 2 := by
    simpa only [sq_abs] using
      (sq_le_sq₀ (abs_nonneg _) hT0).2
        (by simpa only [Tj, externalTestTrajectoryJump] using htraj.2)
  constructor
  · apply hbase.1.trans
    unfold externalTestSharpVariance
    dsimp only
    nlinarith
  · apply hbase.2.trans
    unfold externalTestSharpVariance
    dsimp only
    nlinarith

theorem externalTestSourceBudgets_of_partialTestSourceBudgets
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma d eta epsilon N P : ℝ) (j s ell : ℕ)
    (hd : 0 ≤ d) (hP : 0 ≤ P)
    (hbudget : PartialTestSourceBudgets
      w H C Good T j s ell d eta epsilon N P)
    (hregistry : ∀ k, k < T → ∀ S, Good k S →
      TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s)
    (hmeanLower : ∀ k, k < T → ∀ S, Good k S →
      testTotal w H j *
          (zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
            zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
        meanPartialTestGain w H C j s S - meanPartialTestLoss w H C j s S)
    (hmeanUpper : ∀ k, k < T → ∀ S, Good k S →
      meanPartialTestGain w H C j s S - meanPartialTestLoss w H C j s S ≤
        testTotal w H j *
          (zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
            zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - j - epsilon) / N)))
    (htrajectoryPart : ∀ k, k < T →
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N
          (testTotal w H j) j s k ≤
        testSourceJumpScale P d epsilon / 2) :
    ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P (testTotal w H j) j s
      (fun _ ↦ testSourceJumpScale P d epsilon)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) j s
        (fun _ ↦ testSourceVarianceScale P d epsilon N)) := by
  have hW : 0 ≤ testTotal w H j :=
    testTotal_nonneg hbudget.1.isTestFunction.nonneg H j
  have hhalf0 : 0 ≤ testSourceJumpScale P d epsilon / 2 := by
    exact div_nonneg (mul_nonneg hP (Real.rpow_nonneg hd _)) (by norm_num)
  refine {
    arity := hbudget.2.2.1
    weight_nonneg := hW
    registry := hregistry
    meanLower := hmeanLower
    meanUpper := hmeanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · intro k hk S hgood o
    have hb := hbudget.2.2.2 k hk S hgood
    have hraw := partialTestChoice_raw_abs_le_of_spread
      s S hbudget.1 hbudget.2.1 hhalf0 hb.1 o
    apply (externalTestEnvelopeStep_abs_le_of_observableJump w H C
      D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j) (k : ℝ)
      j s S (greedyChoiceStep H C S o) (hregistry k hk S hgood)
      hW hraw).1.trans
    simpa only [externalTestTrajectoryJump] using
      (show testSourceJumpScale P d epsilon / 2 +
          externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N
            (testTotal w H j) j s k ≤ testSourceJumpScale P d epsilon by
        linarith [htrajectoryPart k hk])
  · intro k hk S hgood o
    have hb := hbudget.2.2.2 k hk S hgood
    have hraw := partialTestChoice_raw_abs_le_of_spread
      s S hbudget.1 hbudget.2.1 hhalf0 hb.1 o
    apply (externalTestEnvelopeStep_abs_le_of_observableJump w H C
      D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j) (k : ℝ)
      j s S (greedyChoiceStep H C S o) (hregistry k hk S hgood)
      hW hraw).2.trans
    simpa only [externalTestTrajectoryJump] using
      (show testSourceJumpScale P d epsilon / 2 +
          externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N
            (testTotal w H j) j s k ≤ testSourceJumpScale P d epsilon by
        linarith [htrajectoryPart k hk])
  · intro k hk S hgood
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j)
      j s k S (hregistry k hk S hgood) hW
      (hbudget.2.2.2 k hk S hgood).2.2).1
  · intro k hk S hgood
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j)
      j s k S (hregistry k hk S hgood) hW
      (hbudget.2.2.2 k hk S hgood).2.2).2


noncomputable def externalSingletonTestJump
    (w : TestWeight V) (H : Hypergraph V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (s : ℕ)
    (B : ℕ → ℝ) (k : ℕ) : ℝ :=
  B k + testTotal w H 1 *
    (|zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ)| +
      |zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ)| +
      2 * (d ^ ((s : ℝ) - 1 - epsilon) / N))

noncomputable def externalSingletonTestVariance
    (w : TestWeight V) (H : Hypergraph V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (s : ℕ)
    (B : ℕ → ℝ) (k : ℕ) : ℝ :=
  (externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N s B k) ^ 2

theorem externalSingletonEnvelopeChoiceStep_abs_le
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {D₂ D₃ D₄ Gamma epsilon d N P B : ℝ}
    {ell s k : ℕ} {M : Hypergraph V}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P 1 s)
    (hw : IsTrackable H C 1 ell d epsilon w) (hB0 : 0 ≤ B)
    (hspread : HasExternalSingletonWeightSpread w H C M B) :
    ∀ o : GreedyChoice H,
      |externalTestUpperStep w H C D₂ D₃ D₄ Gamma epsilon d N
          (testTotal w H 1) (k : ℝ) 1 s M
          (greedyChoiceStep H C M o)| ≤
        externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N
          s (fun _ ↦ B) k ∧
      |externalTestLowerStep w H C D₂ D₃ D₄ Gamma epsilon d N
          (testTotal w H 1) (k : ℝ) 1 s M
          (greedyChoiceStep H C M o)| ≤
        externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N
          s (fun _ ↦ B) k := by
  have hW : 0 ≤ testTotal w H 1 :=
    testTotal_nonneg hw.isTestFunction.nonneg H 1
  intro o
  have hobservable :
      |partialTestObservable w H C 1 s (greedyChoiceStep H C M o) -
        partialTestObservable w H C 1 s M| ≤ B := by
    rcases o with _ | e
    · simp [greedyChoiceStep, hB0]
    · by_cases he : (e : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert he]
        exact externalSingletonTestObservable_jump_le hw hspread s he
      · rw [greedyChoiceStep, greedyStep_eq_self he]
        simp [hB0]
  simpa only [externalSingletonTestJump, Nat.cast_one] using
    externalTestEnvelopeStep_abs_le_of_observableJump w H C
      D₂ D₃ D₄ Gamma epsilon d N (testTotal w H 1) (k : ℝ)
      1 s M (greedyChoiceStep H C M o) R hW hobservable

theorem externalTestSourceBudgets_of_singletonWeightSpread
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ) (s ell : ℕ)
    (B : ℕ → ℝ)
    (hw : IsTrackable H C 1 ell d epsilon w) (hB0 : ∀ k, 0 ≤ B k)
    (hregistry : ∀ k, k < T → ∀ S, Good k S →
      TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P 1 s)
    (hmeanLower : ∀ k, k < T → ∀ S, Good k S →
      testTotal w H 1 *
          (zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) -
            zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - 1 - epsilon) / N)) ≤
        meanPartialTestGain w H C 1 s S - meanPartialTestLoss w H C 1 s S)
    (hmeanUpper : ∀ k, k < T → ∀ S, Good k S →
      meanPartialTestGain w H C 1 s S - meanPartialTestLoss w H C 1 s S ≤
        testTotal w H 1 *
          (zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) +
            zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - 1 - epsilon) / N)))
    (hspread : ∀ k, k < T → ∀ S, Good k S →
      HasExternalSingletonWeightSpread w H C S (B k)) :
    ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P (testTotal w H 1) 1 s
      (externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N s B)
      (externalSingletonTestVariance w H D₂ D₃ D₄ Gamma epsilon d N s B) := by
  refine {
    arity := by norm_num
    weight_nonneg := testTotal_nonneg hw.isTestFunction.nonneg H 1
    registry := hregistry
    meanLower := by simpa only [Nat.cast_one] using hmeanLower
    meanUpper := by simpa only [Nat.cast_one] using hmeanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · intro k hk S hgood o
    exact (externalSingletonEnvelopeChoiceStep_abs_le
      (hregistry k hk S hgood) hw (hB0 k) (hspread k hk S hgood) o).1
  · intro k hk S hgood o
    exact (externalSingletonEnvelopeChoiceStep_abs_le
      (hregistry k hk S hgood) hw (hB0 k) (hspread k hk S hgood) o).2
  · intro k hk S hgood
    simpa only [externalSingletonTestVariance] using
      greedyStepExpectation_sq_le_sq_of_choice_abs_le H C S
        (fun S' ↦ externalTestUpperStep w H C
          D₂ D₃ D₄ Gamma epsilon d N (testTotal w H 1)
            (k : ℝ) 1 s S S')
        (externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N
          s B k)
        (fun o ↦ (externalSingletonEnvelopeChoiceStep_abs_le
          (hregistry k hk S hgood) hw (hB0 k)
          (hspread k hk S hgood) o).1)
  · intro k hk S hgood
    simpa only [externalSingletonTestVariance] using
      greedyStepExpectation_sq_le_sq_of_choice_abs_le H C S
        (fun S' ↦ externalTestLowerStep w H C
          D₂ D₃ D₄ Gamma epsilon d N (testTotal w H 1)
            (k : ℝ) 1 s S S')
        (externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N
          s B k)
        (fun o ↦ (externalSingletonEnvelopeChoiceStep_abs_le
          (hregistry k hk S hgood) hw (hB0 k)
          (hspread k hk S hgood) o).2)

theorem externalTestSourceBudgets_sharp_of_singletonWeightSpread
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ) (s ell : ℕ)
    (B Q : ℕ → ℝ)
    (hw : IsTrackable H C 1 ell d epsilon w) (hB0 : ∀ k, 0 ≤ B k)
    (hregistry : ∀ k, k < T → ∀ S, Good k S →
      TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P 1 s)
    (hmeanLower : ∀ k, k < T → ∀ S, Good k S →
      testTotal w H 1 *
          (zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) -
            zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - 1 - epsilon) / N)) ≤
        meanPartialTestGain w H C 1 s S - meanPartialTestLoss w H C 1 s S)
    (hmeanUpper : ∀ k, k < T → ∀ S, Good k S →
      meanPartialTestGain w H C 1 s S - meanPartialTestLoss w H C 1 s S ≤
        testTotal w H 1 *
          (zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) +
            zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - 1 - epsilon) / N)))
    (hspread : ∀ k, k < T → ∀ S, Good k S →
      HasExternalSingletonWeightSpread w H C S (B k))
    (hrawSquare : ∀ k, k < T → ∀ S, Good k S →
      meanSqPartialTestIncrement w H C 1 s S ≤ Q k) :
    ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P (testTotal w H 1) 1 s
      (externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N s B)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H 1) 1 s Q) := by
  have hW : 0 ≤ testTotal w H 1 :=
    testTotal_nonneg hw.isTestFunction.nonneg H 1
  refine {
    arity := by norm_num
    weight_nonneg := hW
    registry := hregistry
    meanLower := by simpa only [Nat.cast_one] using hmeanLower
    meanUpper := by simpa only [Nat.cast_one] using hmeanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · intro k hk S hgood o
    exact (externalSingletonEnvelopeChoiceStep_abs_le
      (hregistry k hk S hgood) hw (hB0 k) (hspread k hk S hgood) o).1
  · intro k hk S hgood o
    exact (externalSingletonEnvelopeChoiceStep_abs_le
      (hregistry k hk S hgood) hw (hB0 k) (hspread k hk S hgood) o).2
  · intro k hk S hgood
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N (testTotal w H 1)
      1 s k S (hregistry k hk S hgood) hW
      (hrawSquare k hk S hgood)).1
  · intro k hk S hgood
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N (testTotal w H 1)
      1 s k S (hregistry k hk S hgood) hW
      (hrawSquare k hk S hgood)).2

theorem externalTestSourceBudgets_sourceScaleSharp_of_singletonWeightSpread
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ) (s ell : ℕ)
    (B : ℕ → ℝ)
    (hw : IsTrackable H C 1 ell d epsilon w) (hB0 : ∀ k, 0 ≤ B k)
    (hregistry : ∀ k, k < T → ∀ S, Good k S →
      TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P 1 s)
    (hmeanLower : ∀ k, k < T → ∀ S, Good k S →
      testTotal w H 1 *
          (zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) -
            zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - 1 - epsilon) / N)) ≤
        meanPartialTestGain w H C 1 s S - meanPartialTestLoss w H C 1 s S)
    (hmeanUpper : ∀ k, k < T → ∀ S, Good k S →
      meanPartialTestGain w H C 1 s S - meanPartialTestLoss w H C 1 s S ≤
        testTotal w H 1 *
          (zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) +
            zetaRate D₂ D₃ D₄ Gamma epsilon d N 1 s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - 1 - epsilon) / N)))
    (hspread : ∀ k, k < T → ∀ S, Good k S →
      HasExternalSingletonWeightSpread w H C S (B k))
    (hrawSquare : ∀ k, k < T → ∀ S, Good k S →
      meanSqPartialTestIncrement w H C 1 s S ≤
        testSourceVarianceScale P d epsilon N)
    (hstatusPart : ∀ k, k < T →
      B k ≤ testSourceJumpScale P d epsilon / 2)
    (htrajectoryPart : ∀ k, k < T →
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilon d N
          (testTotal w H 1) 1 s k ≤
        testSourceJumpScale P d epsilon / 2) :
    ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N P (testTotal w H 1) 1 s
      (fun _ ↦ testSourceJumpScale P d epsilon)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H 1) 1 s
        (fun _ ↦ testSourceVarianceScale P d epsilon N)) := by
  apply ExternalTestSourceBudgets.mono_jump w H C Good T
    D₂ D₃ D₄ Gamma epsilon d N P (testTotal w H 1) 1 s
    (externalSingletonTestJump w H D₂ D₃ D₄ Gamma epsilon d N s B)
    (fun _ ↦ testSourceJumpScale P d epsilon)
    (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N
      (testTotal w H 1) 1 s
      (fun _ ↦ testSourceVarianceScale P d epsilon N))
    (externalTestSourceBudgets_sharp_of_singletonWeightSpread
      w H C Good T D₂ D₃ D₄ Gamma epsilon d N P s ell B
      (fun _ ↦ testSourceVarianceScale P d epsilon N)
      hw hB0 hregistry hmeanLower hmeanUpper hspread hrawSquare)
  intro k hk
  unfold externalSingletonTestJump
  simpa only [Nat.cast_one, externalTestTrajectoryJump] using
    (show B k + externalTestTrajectoryJump
        D₂ D₃ D₄ Gamma epsilon d N (testTotal w H 1) 1 s k ≤
        testSourceJumpScale P d epsilon by
      linarith [hstatusPart k hk, htrajectoryPart k hk])


structure InternalConflictLinkSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) : Prop where
  scale_nonneg : 0 ≤ scale
  registry : ∀ k, k < T → ∀ S, Good k S →
    CFMTrajectories.TestStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P j s
  meanLower : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S →
    scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) +
        2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
      meanPartialTestGain (conflictLinkTestWeight C f j) H C j s S -
        meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s S
  meanUpper : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S →
    meanPartialTestGain (conflictLinkTestWeight C f j) H C j s S -
        meanPartialTestLoss (conflictLinkTestWeight C f j) H C j s S ≤
      scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ) -
        2 * (d ^ ((s : ℝ) - j - epsilon) / N))
  upperJump : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S → ∀ o : GreedyChoice H,
    |activeInternalConflictLinkUpperStep H C f
      D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
        (greedyChoiceStep H C S o)| ≤ jump k
  lowerJump : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S → ∀ o : GreedyChoice H,
    |activeInternalConflictLinkLowerStep H C f
      D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
        (greedyChoiceStep H C S o)| ≤ jump k
  upperSquare : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S →
    greedyStepExpectation H C S (fun S' ↦
      (activeInternalConflictLinkUpperStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') ^ 2) ≤
      variance k
  lowerSquare : ∀ k, k < T → ∀ S, Good k S →
    f ∈ availableEdges H C S →
    greedyStepExpectation H C S (fun S' ↦
      (activeInternalConflictLinkLowerStep H C f
        D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') ^ 2) ≤
      variance k

theorem InternalConflictLinkSourceBudgets.of_external
    {H : Hypergraph V} {C : ConflictSystem V} (hC : IsConflictSystem H C)
    (f : Finset V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (B : ExternalTestSourceBudgets (conflictLinkTestWeight C f j)
      H C Good T D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    InternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance := by
  constructor
  · exact B.weight_nonneg
  · exact B.registry
  · intro k hk S hgood hf
    exact B.meanLower k hk S hgood
  · intro k hk S hgood hf
    exact B.meanUpper k hk S hgood
  · intro k hk S hgood hf o
    rw [activeInternalConflictLinkUpperStep_eq_externalTestUpperStep
      hC f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
      (greedyChoiceStep H C S o) hf]
    exact B.upperJump k hk S hgood o
  · intro k hk S hgood hf o
    rw [activeInternalConflictLinkLowerStep_eq_externalTestLowerStep
      hC f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S
      (greedyChoiceStep H C S o) hf]
    exact B.lowerJump k hk S hgood o
  · intro k hk S hgood hf
    have heq :
        (fun S' ↦ activeInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') =
        (fun S' ↦ externalTestUpperStep (conflictLinkTestWeight C f j) H C
          D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') := by
      funext S'
      exact activeInternalConflictLinkUpperStep_eq_externalTestUpperStep
        hC f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S' hf
    simpa only [heq] using B.upperSquare k hk S hgood
  · intro k hk S hgood hf
    have heq :
        (fun S' ↦ activeInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') =
        (fun S' ↦ externalTestLowerStep (conflictLinkTestWeight C f j) H C
          D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S') := by
      funext S'
      exact activeInternalConflictLinkLowerStep_eq_externalTestLowerStep
        hC f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S' hf
    simpa only [heq] using B.lowerSquare k hk S hgood

theorem activeInternalConflictLinkStoppedMomentBounds_of_sourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (M : Hypergraph V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (_hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (B : InternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C M) (greedyInfo H T)
        (greedyStoppedStepIncrement H C M T Good
          (fun k S S' ↦ activeInternalConflictLinkUpperStep H C f
            D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S')) variance ∧
      Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C M) (greedyInfo H T)
        (greedyStoppedStepIncrement H C M T Good
          (fun k S S' ↦ activeInternalConflictLinkLowerStep H C f
            D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S S')) variance := by
  constructor <;> apply greedyStoppedStepIncrement_momentBounds
  · exact hvariance
  · intro k hk S hgood
    by_cases hf : f ∈ availableEdges H C S
    · exact (activeInternalConflictLink_oneState_stoppedDrift hC f
        (B.registry k hk S hgood) B.scale_nonneg S hf
        (B.meanLower k hk S hgood hf) (B.meanUpper k hk S hgood hf)).1
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).1]
  · intro k hk S hgood
    by_cases hf : f ∈ availableEdges H C S
    · exact B.upperSquare k hk S hgood hf
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_sq_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).1]
      exact hvariance k
  · exact hvariance
  · intro k hk S hgood
    by_cases hf : f ∈ availableEdges H C S
    · exact (activeInternalConflictLink_oneState_stoppedDrift hC f
        (B.registry k hk S hgood) B.scale_nonneg S hf
        (B.meanLower k hk S hgood hf) (B.meanUpper k hk S hgood hf)).2
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).2]
  · intro k hk S hgood
    by_cases hf : f ∈ availableEdges H C S
    · exact B.lowerSquare k hk S hgood hf
    · rw [(greedyStepExpectation_activeInternalConflictLinkSteps_sq_eq_zero_of_inactive
        H C f D₂ D₃ D₄ Gamma epsilon d N scale (k : ℝ) j s S hf).2]
      exact hvariance k

theorem activeInternalConflictLinkStoppedIncrements_abs_le_of_sourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (f : Finset V) (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ) {R : ℝ}
    (hR0 : 0 ≤ R) (hR : ∀ k, k < T → jump k ≤ R)
    (B : InternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance) :
    (∀ k omega,
      |greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ activeInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S')
        k omega| ≤ R) ∧
      (∀ k omega,
      |greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ activeInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S')
        k omega| ≤ R) := by
  constructor <;> apply greedyStoppedStepIncrement_abs_le_of_local <;>
    try exact hR0
  · intro k hk S hgood o
    by_cases hf : f ∈ availableEdges H C S
    · exact (B.upperJump k hk S hgood hf o).trans (hR k hk)
    · simp [activeInternalConflictLinkUpperStep, hf, hR0]
  · intro k hk S hgood o
    by_cases hf : f ∈ availableEdges H C S
    · exact (B.lowerJump k hk S hgood hf o).trans (hR k hk)
    · simp [activeInternalConflictLinkLowerStep, hf, hR0]

theorem activeInternalConflictLinkFreedman_of_sourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (M : Hypergraph V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (B : InternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ W) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good
              (fun i S S' ↦ activeInternalConflictLinkUpperStep H C f
                D₂ D₃ D₄ Gamma epsilon d N scale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good
              (fun i S S' ↦ activeInternalConflictLinkLowerStep H C f
                D₂ D₃ D₄ Gamma epsilon d N scale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  have hm := activeInternalConflictLinkStoppedMomentBounds_of_sourceBudgets
    H C hC M f Good T D₂ D₃ D₄ Gamma epsilon d N P scale j s
      jump variance hjump hvariance B
  have hinc := activeInternalConflictLinkStoppedIncrements_abs_le_of_sourceBudgets
    H C M f Good T D₂ D₃ D₄ Gamma epsilon d N P scale j s
      jump variance hR0 hR B
  constructor
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good
        (fun i S S' ↦ activeInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S') k)
      hm.1 hR0 ht hW0 hden hinc.1 hW
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good
        (fun i S S' ↦ activeInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S') k)
      hm.2 hR0 ht hW0 hden hinc.2 hW

theorem internalConflictLinkFirstFailureMass_le_of_sourceBudgets
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (M : Hypergraph V) (T : ℕ)
    (Pgood : ι → ℕ → Hypergraph V → Prop)
    (iUpper iLower : ι) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (B : InternalConflictLinkSourceBudgets H C f
      (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ W)
    (hUpperComponent : ∀ k S, Pgood iUpper k S ↔
      internalConflictLinkUpperCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k S)
    (hLowerComponent : ∀ k S, Pgood iLower k S ↔
      internalConflictLinkLowerCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k S)
    (hUpperInitial : internalConflictLinkUpperError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s 0 M ≤ -t)
    (hLowerInitial : internalConflictLinkLowerError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s 0 M ≤ -t) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T Pgood iUpper) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T Pgood iLower) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  have htail := activeInternalConflictLinkFreedman_of_sourceBudgets
    H C hC M f (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s
      jump variance hjump hvariance B hR0 ht hW0 hden hR hW
  constructor
  · exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
      (greedyPathMassFrom_nonneg H C M)
      (internalConflictLinkUpperFirstFailureEvent_subset_tail H C M T
        Pgood iUpper f D₂ D₃ D₄ Gamma epsilon d N scale t j s
        hUpperComponent hUpperInitial)).trans htail.1
  · exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
      (greedyPathMassFrom_nonneg H C M)
      (internalConflictLinkLowerFirstFailureEvent_subset_tail H C M T
        Pgood iLower f D₂ D₃ D₄ Gamma epsilon d N scale t j s
        hLowerComponent hLowerInitial)).trans htail.2

theorem internalConflictLinkCorridors_bounds
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (j s k : ℕ)
    (M : Hypergraph V) (hf : f ∈ availableEdges H C M)
    (hupper : internalConflictLinkUpperCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s k M)
    (hlower : internalConflictLinkLowerCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s k M) :
    scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)) ≤
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ) ≤
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)) := by
  have hu : internalConflictLinkUpperError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s k M < 0 :=
    hupper.resolve_left (fun h ↦ h hf)
  have hl : internalConflictLinkLowerError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s k M < 0 :=
    hlower.resolve_left (fun h ↦ h hf)
  unfold internalConflictLinkUpperError at hu
  unfold internalConflictLinkLowerError at hl
  constructor <;> linarith

theorem openConflictCount_bounds_of_internalConflictLinkCorridors
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N spread : ℝ) (k : ℕ)
    (M : Hypergraph V) (hf : f ∈ availableEdges H C M)
    (h₁Upper : internalConflictLinkUpperCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N D₂ 1 1 k M)
    (h₁Lower : internalConflictLinkLowerCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N D₂ 1 1 k M)
    (h₂Upper : internalConflictLinkUpperCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N D₃ 2 1 k M)
    (h₂Lower : internalConflictLinkLowerCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N D₃ 2 1 k M)
    (h₃Upper : internalConflictLinkUpperCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N D₄ 3 1 k M)
    (h₃Lower : internalConflictLinkLowerCorridor H C f
      D₂ D₃ D₄ Gamma epsilon d N D₄ 3 1 k M)
    (hspread :
      (internalOpenLinkMass C (availableEdges H C M) M f : ℝ) -
          (openConflictCount C (availableEdges H C M) M f : ℝ) ≤ spread) :
    CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) -
        (D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ) +
          D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ) +
          D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ) +
          spread) ≤
        (openConflictCount C (availableEdges H C M) M f : ℝ) ∧
      (openConflictCount C (availableEdges H C M) M f : ℝ) ≤
        CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
          (D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ) +
            D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ) +
            D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ)) := by
  exact CFMTrajectories.openConflictCount_bounds_of_internalLinks_of_spread
    (internalConflictLinkCorridors_bounds H C f
      D₂ D₃ D₄ Gamma epsilon d N D₂ 1 1 k M hf h₁Upper h₁Lower)
    (internalConflictLinkCorridors_bounds H C f
      D₂ D₃ D₄ Gamma epsilon d N D₃ 2 1 k M hf h₂Upper h₂Lower)
    (internalConflictLinkCorridors_bounds H C f
      D₂ D₃ D₄ Gamma epsilon d N D₄ 3 1 k M hf h₃Upper h₃Lower)
    hspread


theorem ceil_almostPerfect_normalized_time
    (N : ℕ) (mu : ℝ) (hmu1 : mu ≤ 1)
    (hslack : 1 < mu * (N : ℝ) / 8) :
    let T := Nat.ceil ((1 - mu) * (N : ℝ) / 8)
    0 ≤ 8 * (T : ℝ) / (N : ℝ) ∧
      8 * (T : ℝ) / (N : ℝ) ≤ 1 ∧
      1 - 8 * (T : ℝ) / (N : ℝ) ≤ mu := by
  dsimp only
  have hNne : N ≠ 0 := by
    intro hN
    subst N
    norm_num at hslack
  have hNnat : 0 < N := Nat.pos_of_ne_zero hNne
  have hN : 0 < (N : ℝ) := by exact_mod_cast hNnat
  have hceil := ceil_almostPerfect_target N mu hmu1 hslack
  have hT0 : 0 ≤ (Nat.ceil ((1 - mu) * (N : ℝ) / 8) : ℝ) :=
    Nat.cast_nonneg _
  refine ⟨by positivity, ?_, ?_⟩
  · have hscaled :
        8 * (Nat.ceil ((1 - mu) * (N : ℝ) / 8) : ℝ) < (N : ℝ) := by
      nlinarith [hceil.2]
    exact le_of_lt ((div_lt_iff₀ hN).2 (by simpa using hscaled))
  · have hscaled :
        (1 - mu) * (N : ℝ) ≤
          8 * (Nat.ceil ((1 - mu) * (N : ℝ) / 8) : ℝ) := by
      nlinarith [hceil.1]
    have hnormalized :
        1 - mu ≤
          8 * (Nat.ceil ((1 - mu) * (N : ℝ) / 8) : ℝ) / (N : ℝ) :=
      (le_div_iff₀ hN).2 (by nlinarith)
    linarith

/-- Conditional second moment of the available-degree loss after deleting
covering choices, on which the surviving process freezes. -/
noncomputable def meanSqMissAvailableDegreeLoss
    (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (v : V) : ℝ :=
  let A := availableEdges H C M
  if A = ∅ then 0 else
    (∑ e ∈ A, (missAvailableDegreeLoss H C M e v : ℝ) ^ 2) /
      (A.card : ℝ)

theorem meanSqMissAvailableDegreeLoss_eq_of_nonempty
    {H : Hypergraph V} {C : ConflictSystem V}
    {M : Hypergraph V} {v : V}
    (hA : (availableEdges H C M).Nonempty) :
    meanSqMissAvailableDegreeLoss H C M v =
      (∑ e ∈ availableEdges H C M,
        (missAvailableDegreeLoss H C M e v : ℝ) ^ 2) /
        ((availableEdges H C M).card : ℝ) := by
  simp [meanSqMissAvailableDegreeLoss,
    Finset.nonempty_iff_ne_empty.mp hA]

/-- Exact raw second moment of the next-state-surviving degree increment. -/
theorem greedyStepExpectation_survivingAvailableDegreeIncrement_sq
    (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (v : V)
    (hv : v ∈ uncoveredVertices H M) :
    greedyStepExpectation H C M (fun M' ↦
        (survivingAvailableDegreeIncrement H C v M M') ^ 2) =
      meanSqMissAvailableDegreeLoss H C M v := by
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · rw [greedyStepExpectation_of_availableEdges_eq_empty H C M _ hA]
    simp [survivingAvailableDegreeIncrement,
      meanSqMissAvailableDegreeLoss, A, hA, hv]
  · have hAne : A.Nonempty := Finset.nonempty_iff_ne_empty.mpr hA
    rw [greedyStepExpectation_eq_average H C M _ hAne]
    rw [meanSqMissAvailableDegreeLoss]
    simp only [A, hA, if_false]
    congr 1
    apply Finset.sum_congr rfl
    intro e he
    by_cases hve : v ∈ e
    · have hvnext : v ∉ uncoveredVertices H (insert e M) := by
        simpa [mem_uncoveredVertices_insert_iff hv] using hve
      simp [survivingAvailableDegreeIncrement, hvnext,
        missAvailableDegreeLoss, hve]
    · have hvnext : v ∈ uncoveredVertices H (insert e M) :=
        (mem_uncoveredVertices_insert_iff hv).2 hve
      have hpart := degree_insert_available_add_loss H C M e v
      have hpartR :
          (degree (availableEdges H C (insert e M)) v : ℝ) +
              (availableDegreeLoss H C M e v : ℝ) =
            (degree A v : ℝ) := by
        exact_mod_cast hpart
      have hdiff :
          (degree (availableEdges H C (insert e M)) v : ℝ) -
              (degree A v : ℝ) =
            -(availableDegreeLoss H C M e v : ℝ) := by
        linarith
      simp only [survivingAvailableDegreeIncrement, hvnext, if_true,
        missAvailableDegreeLoss, hve, if_false]
      rw [hdiff]
      ring

/-- The raw available-degree change only needs a local estimate when the
next state still leaves `v` uncovered.  Thus a covering edge, whose raw
loss can be the full degree, is excluded from the small source jump. -/
theorem availableDegreeChoice_raw_abs_le_of_missPointwise_of_next_uncovered
    (H : Hypergraph V) (C : ConflictSystem V) (S : Hypergraph V)
    (v : V) {R : ℝ} (hR0 : 0 ≤ R)
    (hloss : ∀ e ∈ availableEdges H C S, v ∉ e →
      (availableDegreeLoss H C S e v : ℝ) ≤ R)
    (o : GreedyChoice H)
    (hnext : v ∈ uncoveredVertices H (greedyChoiceStep H C S o)) :
    |(degree (availableEdges H C (greedyChoiceStep H C S o)) v : ℝ) -
      (degree (availableEdges H C S) v : ℝ)| ≤ R := by
  rcases o with _ | e
  · simpa [greedyChoiceStep] using hR0
  · by_cases he : (e : Finset V) ∈ availableEdges H C S
    · have hvS : v ∈ uncoveredVertices H S := by
        by_contra hvS
        exact (not_mem_uncoveredVertices_insert hvS) (by
          simpa [greedyChoiceStep, greedyStep_eq_insert he] using hnext)
      have hve : v ∉ (e : Finset V) :=
        (mem_uncoveredVertices_insert_iff hvS).mp (by
          simpa [greedyChoiceStep, greedyStep_eq_insert he] using hnext)
      rw [greedyChoiceStep, greedyStep_eq_insert he]
      have hpart := degree_insert_available_add_loss
        H C S (e : Finset V) v
      have hpartR :
          (degree (availableEdges H C (insert (e : Finset V) S)) v : ℝ) +
              (availableDegreeLoss H C S (e : Finset V) v : ℝ) =
            (degree (availableEdges H C S) v : ℝ) := by
        exact_mod_cast hpart
      have hdiff :
          (degree (availableEdges H C (insert (e : Finset V) S)) v : ℝ) -
              (degree (availableEdges H C S) v : ℝ) =
            -(availableDegreeLoss H C S (e : Finset V) v : ℝ) := by
        linarith
      rw [hdiff, abs_neg, abs_of_nonneg (by positivity)]
      exact hloss (e : Finset V) he hve
    · rw [greedyChoiceStep, greedyStep_eq_self he]
      simpa using hR0

/-- Correct small-jump version of `survivingDegreeChoiceSteps_abs_le_of_pointwise`.
Only non-covering choices need satisfy the source loss estimate, because both
surviving envelope increments are definitionally zero on a covering choice. -/
theorem survivingDegreeChoiceSteps_abs_le_of_missPointwise
    (H : Hypergraph V) (C : ConflictSystem V) (S : Hypergraph V)
    (v : V) (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    {R Q : ℝ} (hR0 : 0 ≤ R) (hQ0 : 0 ≤ Q)
    (hloss : ∀ e ∈ availableEdges H C S, v ∉ e →
      (availableDegreeLoss H C S e v : ℝ) ≤ R)
    (hupperTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ Q)
    (hlowerTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ Q) :
    ∀ o : GreedyChoice H,
      |survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N x S
          (greedyChoiceStep H C S o)| ≤ R + Q ∧
      |survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N x S
          (greedyChoiceStep H C S o)| ≤ R + Q := by
  intro o
  by_cases hnext : v ∈ uncoveredVertices H (greedyChoiceStep H C S o)
  · exact survivingDegreeSteps_abs_le H C v
      D₂ D₃ D₄ Gamma epsilon d N x S _ hR0 hQ0
        (availableDegreeChoice_raw_abs_le_of_missPointwise_of_next_uncovered
          H C S v hR0 hloss o hnext)
        hupperTrajectory hlowerTrajectory
  · simp [survivingDegreeUpperStep, survivingDegreeLowerStep, hnext,
      add_nonneg hR0 hQ0]

/-- Pointwise quadratic comparison between each envelope increment and the
raw next-state-surviving degree increment. -/
theorem survivingDegreeSteps_sq_le_two_raw_add_trajectory
    (H : Hypergraph V) (C : ConflictSystem V) (S S' : Hypergraph V)
    (v : V) (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    {Q : ℝ} (hQ0 : 0 ≤ Q)
    (hupperTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ Q)
    (hlowerTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ Q) :
    (survivingDegreeUpperStep H C v
        D₂ D₃ D₄ Gamma epsilon d N x S S') ^ 2 ≤
        2 * (survivingAvailableDegreeIncrement H C v S S') ^ 2 + 2 * Q ^ 2 ∧
      (survivingDegreeLowerStep H C v
        D₂ D₃ D₄ Gamma epsilon d N x S S') ^ 2 ≤
        2 * (survivingAvailableDegreeIncrement H C v S S') ^ 2 + 2 * Q ^ 2 := by
  by_cases hnext : v ∈ uncoveredVertices H S'
  · let a := (degree (availableEdges H C S') v : ℝ) -
        (degree (availableEdges H C S) v : ℝ)
    let b :=
      (CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
        CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
      (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)
    let c :=
      (CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
        CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
      (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)
    have hb : b ^ 2 ≤ Q ^ 2 := by
      simpa only [sq_abs] using
        (sq_le_sq₀ (abs_nonneg b) hQ0).2
          (by simpa [b] using hupperTrajectory)
    have hc : c ^ 2 ≤ Q ^ 2 := by
      simpa only [sq_abs] using
        (sq_le_sq₀ (abs_nonneg c) hQ0).2
          (by simpa [c] using hlowerTrajectory)
    have hupper : survivingDegreeUpperStep H C v
        D₂ D₃ D₄ Gamma epsilon d N x S S' = a - b := by
      simp only [survivingDegreeUpperStep, hnext, if_true]
      simp [a, b]
      ring
    have hlower : survivingDegreeLowerStep H C v
        D₂ D₃ D₄ Gamma epsilon d N x S S' = c - a := by
      simp only [survivingDegreeLowerStep, hnext, if_true]
      simp [a, c]
      ring
    have hraw : survivingAvailableDegreeIncrement H C v S S' = a := by
      simp [survivingAvailableDegreeIncrement, hnext, a]
    rw [hupper, hlower, hraw]
    constructor
    · nlinarith [sq_nonneg (a + b)]
    · nlinarith [sq_nonneg (a + c)]
  · simp [survivingDegreeUpperStep, survivingDegreeLowerStep,
      survivingAvailableDegreeIncrement, hnext, sq_nonneg Q]

/-- Sharp conditional square bound.  Unlike the pointwise `(jump+Q)^2`
estimate, this retains the `1/N` gain in the raw miss variance. -/
theorem greedyStepExpectation_survivingDegreeSteps_sq_le_of_meanSqMiss
    (H : Hypergraph V) (C : ConflictSystem V) (S : Hypergraph V)
    (v : V) (D₂ D₃ D₄ Gamma epsilon d N x : ℝ)
    {rawVariance Q : ℝ} (hQ0 : 0 ≤ Q)
    (hv : v ∈ uncoveredVertices H S)
    (hrawVariance : meanSqMissAvailableDegreeLoss H C S v ≤ rawVariance)
    (hupperTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ Q)
    (hlowerTrajectory :
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N (x + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N x) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤ Q) :
    greedyStepExpectation H C S (fun S' ↦
        (survivingDegreeUpperStep H C v D₂ D₃ D₄ Gamma epsilon d N x S S') ^ 2) ≤
        2 * rawVariance + 2 * Q ^ 2 ∧
      greedyStepExpectation H C S (fun S' ↦
        (survivingDegreeLowerStep H C v D₂ D₃ D₄ Gamma epsilon d N x S S') ^ 2) ≤
        2 * rawVariance + 2 * Q ^ 2 := by
  have hraw := greedyStepExpectation_survivingAvailableDegreeIncrement_sq
    H C S v hv
  constructor
  · calc
      greedyStepExpectation H C S (fun S' ↦
          (survivingDegreeUpperStep H C v
            D₂ D₃ D₄ Gamma epsilon d N x S S') ^ 2) ≤
          greedyStepExpectation H C S (fun S' ↦
            2 * (survivingAvailableDegreeIncrement H C v S S') ^ 2 +
              2 * Q ^ 2) := greedyStepExpectation_mono H C S
                (fun S' ↦ (survivingDegreeSteps_sq_le_two_raw_add_trajectory
                  H C S S' v D₂ D₃ D₄ Gamma epsilon d N x hQ0
                    hupperTrajectory hlowerTrajectory).1)
      _ = 2 * meanSqMissAvailableDegreeLoss H C S v + 2 * Q ^ 2 := by
        rw [greedyStepExpectation_add,
          greedyStepExpectation_const_mul, hraw,
          greedyStepExpectation_const]
      _ ≤ 2 * rawVariance + 2 * Q ^ 2 := by linarith
  · calc
      greedyStepExpectation H C S (fun S' ↦
          (survivingDegreeLowerStep H C v
            D₂ D₃ D₄ Gamma epsilon d N x S S') ^ 2) ≤
          greedyStepExpectation H C S (fun S' ↦
            2 * (survivingAvailableDegreeIncrement H C v S S') ^ 2 +
              2 * Q ^ 2) := greedyStepExpectation_mono H C S
                (fun S' ↦ (survivingDegreeSteps_sq_le_two_raw_add_trajectory
                  H C S S' v D₂ D₃ D₄ Gamma epsilon d N x hQ0
                    hupperTrajectory hlowerTrajectory).2)
      _ = 2 * meanSqMissAvailableDegreeLoss H C S v + 2 * Q ^ 2 := by
        rw [greedyStepExpectation_add,
          greedyStepExpectation_const_mul, hraw,
          greedyStepExpectation_const]
      _ ≤ 2 * rawVariance + 2 * Q ^ 2 := by linarith

/-- Corrected source interface: the small loss hypothesis is only imposed
on choices that miss `v`. -/
structure SurvivingDegreeSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ) : Prop where
  registry : ∀ k, k < T → ∀ S, Good k S →
    CFMTrajectories.DeltaStepRegistry
      D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P
  meanLower : ∀ k, k < T → ∀ S, Good k S →
    v ∈ uncoveredVertices H S →
    survivingVertexProbability H C v S *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) +
          2 * (d ^ (1 - epsilon) / N)) ≤
      meanMissAvailableDegreeLoss H C S v
  meanUpper : ∀ k, k < T → ∀ S, Good k S →
    v ∈ uncoveredVertices H S →
    meanMissAvailableDegreeLoss H C S v ≤
      survivingVertexProbability H C v S *
        (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
          CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) -
          2 * (d ^ (1 - epsilon) / N))
  loss : ∀ k, k < T → ∀ S, Good k S → ∀ e ∈ availableEdges H C S,
    v ∉ e → (availableDegreeLoss H C S e v : ℝ) ≤ jump k
  rawSquare : ∀ k, k < T → ∀ S, Good k S →
    v ∈ uncoveredVertices H S →
    meanSqMissAvailableDegreeLoss H C S v ≤ rawVariance k
  upperTrajectory : ∀ k, k < T → ∀ S, Good k S →
    |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
        CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) +
      (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤ trajectory k
  lowerTrajectory : ∀ k, k < T → ∀ S, Good k S →
    |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
        CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) -
      (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤ trajectory k
  squareBudget : ∀ k, k < T → ∀ S, Good k S →
    2 * rawVariance k + 2 * (trajectory k) ^ 2 ≤ variance k

/-- Constructor replacing the two mean fields by combinatorial windows and
scalar absorptions, with the corrected miss-only loss field. -/
theorem survivingDegreeSourceBudgets_of_combinatorialMeanBounds
    (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (combLo combHi : ℕ → Hypergraph V → ℝ)
    (hregistry : ∀ k, k < T → ∀ S, Good k S →
      CFMTrajectories.DeltaStepRegistry
        D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P)
    (hcomb : ∀ k, k < T → ∀ S, Good k S →
      v ∈ uncoveredVertices H S →
      combLo k S ≤ meanMissAvailableDegreeLoss H C S v ∧
        meanMissAvailableDegreeLoss H C S v ≤ combHi k S)
    (hnumericLower : ∀ k, k < T → ∀ S, Good k S →
      v ∈ uncoveredVertices H S →
      survivingVertexProbability H C v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) +
            2 * (d ^ (1 - epsilon) / N)) ≤ combLo k S)
    (hnumericUpper : ∀ k, k < T → ∀ S, Good k S →
      v ∈ uncoveredVertices H S →
      combHi k S ≤ survivingVertexProbability H C v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) -
            2 * (d ^ (1 - epsilon) / N)))
    (hloss : ∀ k, k < T → ∀ S, Good k S →
      ∀ e ∈ availableEdges H C S, v ∉ e →
        (availableDegreeLoss H C S e v : ℝ) ≤ jump k)
    (hrawSquare : ∀ k, k < T → ∀ S, Good k S →
      v ∈ uncoveredVertices H S →
      meanSqMissAvailableDegreeLoss H C S v ≤ rawVariance k)
    (hupperTrajectory : ∀ k, k < T → ∀ S, Good k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤
        trajectory k)
    (hlowerTrajectory : ∀ k, k < T → ∀ S, Good k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤
        trajectory k)
    (hsquare : ∀ k, k < T → ∀ S, Good k S →
      2 * rawVariance k + 2 * (trajectory k) ^ 2 ≤ variance k) :
    SurvivingDegreeSourceBudgets H C Good T v
      D₂ D₃ D₄ Gamma epsilon d N P
        jump trajectory rawVariance variance := by
  refine
    { registry := hregistry
      meanLower := ?_
      meanUpper := ?_
      loss := hloss
      rawSquare := hrawSquare
      upperTrajectory := hupperTrajectory
      lowerTrajectory := hlowerTrajectory
      squareBudget := hsquare }
  · intro k hk S hgood hv
    exact (survivingDegree_meanWindow_of_combinatorial_bounds
      (hcomb k hk S hgood hv)
      (hnumericLower k hk S hgood hv)
      (hnumericUpper k hk S hgood hv)).1
  · intro k hk S hgood hv
    exact (survivingDegree_meanWindow_of_combinatorial_bounds
      (hcomb k hk S hgood hv)
      (hnumericLower k hk S hgood hv)
      (hnumericUpper k hk S hgood hv)).2

/-- The stopped second-moment consumer is unchanged except for calling the
miss-only square lemma. -/
theorem survivingDegreeStoppedMomentBounds_of_sourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (htrajectory : ∀ k, 0 ≤ trajectory k)
    (hvariance : ∀ k, 0 ≤ variance k)
    (B : SurvivingDegreeSourceBudgets H C Good T v
      D₂ D₃ D₄ Gamma epsilon d N P
        jump trajectory rawVariance variance) :
    Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C M) (greedyInfo H T)
        (greedyStoppedStepIncrement H C M T Good
          (fun k S S' ↦ survivingDegreeUpperStep H C v
            D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) S S')) variance ∧
      Freedman.ConditionalMomentBounds
        (greedyPathMassFrom H C M) (greedyInfo H T)
        (greedyStoppedStepIncrement H C M T Good
          (fun k S S' ↦ survivingDegreeLowerStep H C v
            D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) S S')) variance := by
  constructor <;> apply greedyStoppedStepIncrement_momentBounds
  · exact hvariance
  · intro k hk S hgood
    by_cases hv : v ∈ uncoveredVertices H S
    · exact (survivingDegree_oneState_stoppedDrift
        (B.registry k hk S hgood) hv
        (B.meanLower k hk S hgood hv) (B.meanUpper k hk S hgood hv)).1
    · rw [(greedyStepExpectation_survivingDegreeSteps_eq_zero_of_not_uncovered
        H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) hv).1]
  · intro k hk S hgood
    by_cases hv : v ∈ uncoveredVertices H S
    · exact (greedyStepExpectation_survivingDegreeSteps_sq_le_of_meanSqMiss
        H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
        (htrajectory k) hv (B.rawSquare k hk S hgood hv)
        (B.upperTrajectory k hk S hgood)
        (B.lowerTrajectory k hk S hgood)).1.trans
          (B.squareBudget k hk S hgood)
    · rw [(greedyStepExpectation_survivingDegreeSteps_sq_eq_zero_of_not_uncovered
        H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) hv).1]
      exact hvariance k
  · exact hvariance
  · intro k hk S hgood
    by_cases hv : v ∈ uncoveredVertices H S
    · exact (survivingDegree_oneState_stoppedDrift
        (B.registry k hk S hgood) hv
        (B.meanLower k hk S hgood hv) (B.meanUpper k hk S hgood hv)).2
    · rw [(greedyStepExpectation_survivingDegreeSteps_eq_zero_of_not_uncovered
        H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) hv).2]
  · intro k hk S hgood
    by_cases hv : v ∈ uncoveredVertices H S
    · exact (greedyStepExpectation_survivingDegreeSteps_sq_le_of_meanSqMiss
        H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
        (htrajectory k) hv (B.rawSquare k hk S hgood hv)
        (B.upperTrajectory k hk S hgood)
        (B.lowerTrajectory k hk S hgood)).2.trans
          (B.squareBudget k hk S hgood)
    · rw [(greedyStepExpectation_survivingDegreeSteps_sq_eq_zero_of_not_uncovered
        H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) hv).2]
      exact hvariance k

/-- Absolute stopped increments from the miss-only budget. -/
theorem survivingDegreeStoppedIncrements_abs_le_of_sourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ) {R : ℝ}
    (hjump : ∀ k, 0 ≤ jump k) (htrajectory : ∀ k, 0 ≤ trajectory k)
    (hR0 : 0 ≤ R) (hR : ∀ k, k < T → jump k + trajectory k ≤ R)
    (B : SurvivingDegreeSourceBudgets H C Good T v
      D₂ D₃ D₄ Gamma epsilon d N P
        jump trajectory rawVariance variance) :
    (∀ k omega,
      |greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S') k omega| ≤ R) ∧
    (∀ k omega,
      |greedyStoppedStepIncrement H C M T Good
        (fun i S S' ↦ survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S') k omega| ≤ R) := by
  constructor <;> apply greedyStoppedStepIncrement_abs_le_of_local <;>
    try exact hR0
  · intro k hk S hgood o
    exact (survivingDegreeChoiceSteps_abs_le_of_missPointwise
      H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
      (hjump k) (htrajectory k) (B.loss k hk S hgood)
      (B.upperTrajectory k hk S hgood)
      (B.lowerTrajectory k hk S hgood) o).1.trans (hR k hk)
  · intro k hk S hgood o
    exact (survivingDegreeChoiceSteps_abs_le_of_missPointwise
      H C S v D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
      (hjump k) (htrajectory k) (B.loss k hk S hgood)
      (B.upperTrajectory k hk S hgood)
      (B.lowerTrajectory k hk S hgood) o).2.trans (hR k hk)

/-- Freedman's inequality for the two corrected surviving-degree envelopes. -/
theorem survivingDegreeFreedman_of_sourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N P : ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (htrajectory : ∀ k, 0 ≤ trajectory k)
    (hvariance : ∀ k, 0 ≤ variance k)
    (B : SurvivingDegreeSourceBudgets H C Good T v
      D₂ D₃ D₄ Gamma epsilon d N P
        jump trajectory rawVariance variance)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k, k < T → jump k + trajectory k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ W) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good
              (fun i S S' ↦ survivingDegreeUpperStep H C v
                D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C M)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C M T Good
              (fun i S S' ↦ survivingDegreeLowerStep H C v
                D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  have hm := survivingDegreeStoppedMomentBounds_of_sourceBudgets
    H C M Good T v D₂ D₃ D₄ Gamma epsilon d N P
      jump trajectory rawVariance variance htrajectory hvariance B
  have hinc := survivingDegreeStoppedIncrements_abs_le_of_sourceBudgets
    H C M Good T v D₂ D₃ D₄ Gamma epsilon d N P
      jump trajectory rawVariance variance hjump htrajectory hR0 hR B
  constructor
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good
        (fun i S S' ↦ survivingDegreeUpperStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S') k)
      hm.1 hR0 ht hW0 hden hinc.1 hW
  · exact Freedman.freedman
      (greedyPathMassFrom_nonneg H C M)
      (sum_greedyPathMassFrom H C M T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C M T Good
        (fun i S S' ↦ survivingDegreeLowerStep H C v
          D₂ D₃ D₄ Gamma epsilon d N (i : ℝ) S S') k)
      hm.2 hR0 ht hW0 hden hinc.2 hW

/-- First-failure tails for the corrected surviving-degree source budget. -/
theorem degreeFirstFailureMass_le_of_sourceBudgets
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : ι → ℕ → Hypergraph V → Prop) (iUpper iLower : ι) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N Pscale : ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (htrajectory : ∀ k, 0 ≤ trajectory k)
    (hvariance : ∀ k, 0 ≤ variance k)
    (B : SurvivingDegreeSourceBudgets H C (indexedGreedyGood P) T v
      D₂ D₃ D₄ Gamma epsilon d N Pscale
        jump trajectory rawVariance variance)
    {R t W : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ W)
    (hden : 0 < W + R * t)
    (hR : ∀ k, k < T → jump k + trajectory k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ W)
    (hUpperComponent : ∀ k S, P iUpper k S ↔
      degreeUpperCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k S)
    (hLowerComponent : ∀ k S, P iLower k S ↔
      degreeLowerCorridor H C v D₂ D₃ D₄ Gamma epsilon d N k S)
    (hUpperInitial : degreeUpperError H C v
      D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t)
    (hLowerInitial : degreeLowerError H C v
      D₂ D₃ D₄ Gamma epsilon d N 0 M ≤ -t) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T P iUpper) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) ∧
      Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T P iLower) ≤
        Real.exp (-(t ^ 2) / (4 * (W + R * t))) := by
  have htail := survivingDegreeFreedman_of_sourceBudgets
    H C M (indexedGreedyGood P) T v D₂ D₃ D₄ Gamma epsilon d N Pscale
    jump trajectory rawVariance variance hjump htrajectory hvariance B
    hR0 ht hW0 hden hR hW
  constructor
  · exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
      (greedyPathMassFrom_nonneg H C M)
      (degreeUpperFirstFailureEvent_subset_tail H C M T P iUpper v
        D₂ D₃ D₄ Gamma epsilon d N t hUpperComponent hUpperInitial)).trans
        htail.1
  · exact (eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
      (greedyPathMassFrom_nonneg H C M)
      (degreeLowerFirstFailureEvent_subset_tail H C M T P iLower v
        D₂ D₃ D₄ Gamma epsilon d N t hLowerComponent hLowerInitial)).trans
        htail.2


end Erdos136


namespace Erdos136

open Finset CFMTrajectories

variable {V : Type*} [DecidableEq V]

/-- At time zero, the only nonzero partial-test coordinate is `s = j`. -/
theorem partialTestObservable_initial_all
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    {j s : ℕ} (hsj : s ≤ j) (hCcard : ∀ c ∈ C, 2 ≤ c.card) :
    partialTestObservable w H C j s ∅ =
      if s = j then testTotal w H j else 0 := by
  rw [partialTestObservable, availableEdges_empty_eq_host H C hCcard]
  by_cases hsj' : s = j
  · subst s
    simp
  · have hlt : s < j := lt_of_le_of_ne hsj hsj'
    have hsub : j - s ≠ 0 := by omega
    simp [partialTestTotal, hsj', hsub, hsub.symm]

/-- The normalized `(j,s)` trajectory is the Kronecker delta at time zero. -/
theorem zHat_zero_eq_indicator
    (D₂ D₃ D₄ d N : ℝ) {j s : ℕ} (hsj : s ≤ j) :
    zHat D₂ D₃ D₄ d N j s 0 = if s = j then 1 else 0 := by
  by_cases hsj' : s = j
  · subst s
    simp [zHat, q, pV, pM, GammaHat]
  · have hlt : s < j := lt_of_le_of_ne hsj hsj'
    have hsub : 0 < j - s := Nat.sub_pos_iff_lt.mpr hlt
    simp [zHat, q, pV, pM, GammaHat, hsj', zero_pow hsub.ne']

/-- At the empty state, both external-test errors are exactly the negative
of the common deterministic error margin `W * zeta(0)`. -/
theorem externalTestErrors_initial_eq_neg_margin
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) {j s : ℕ}
    (hsj : s ≤ j) (hCcard : ∀ c ∈ C, 2 ≤ c.card) :
    let W := testTotal w H j
    externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ =
        -(W * zeta D₂ D₃ D₄ Gamma epsilon d N j s 0) ∧
      externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ =
        -(W * zeta D₂ D₃ D₄ Gamma epsilon d N j s 0) := by
  dsimp only
  have hobs := partialTestObservable_initial_all w H C hsj hCcard
  have hz := zHat_zero_eq_indicator D₂ D₃ D₄ d N hsj
  unfold externalTestUpperError externalTestLowerError
    externalTestUpperTrajectory externalTestLowerTrajectory
  simp only [Nat.cast_zero]
  rw [hobs, hz]
  constructor <;> split_ifs <;> ring

/-- Strict initial upper and lower corridors, with their shared explicit
positive margin.  The bounds on `j` record the specialized test range. -/
theorem externalTestCorridors_initial
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) {j s : ℕ}
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hsj : s ≤ j)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hW : 0 < testTotal w H j) (hd : 0 < d) (hGamma : 0 < Gamma) :
    let W := testTotal w H j
    let margin := W * zeta D₂ D₃ D₄ Gamma epsilon d N j s 0
    0 < margin ∧
      externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ = -margin ∧
      externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ = -margin ∧
      externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ ∧
      externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ := by
  dsimp only
  have hpV : 0 < pV N 0 := by simp [pV]
  have hpM : 0 ≤ pM d N 0 := by simp [pM]
  have hzeta : 0 < zeta D₂ D₃ D₄ Gamma epsilon d N j s 0 :=
    zeta_pos hd hGamma hpV hpM hsj
  have herr := externalTestErrors_initial_eq_neg_margin
    w H C D₂ D₃ D₄ Gamma epsilon d N hsj hCcard
  have hmargin : 0 < testTotal w H j *
      zeta D₂ D₃ D₄ Gamma epsilon d N j s 0 := mul_pos hW hzeta
  refine ⟨hmargin, herr.1, herr.2, ?_, ?_⟩
  · unfold externalTestUpperCorridor
    rw [herr.1]
    linarith
  · unfold externalTestLowerCorridor
    rw [herr.2]
    linarith

/-- The `s = 0` test trajectory is the public inverse-degree scale times
the `j`-th power of the normalized elapsed time `8x/N`. -/
theorem zHat_zero_available_eq_scale_mul
    (D₂ D₃ D₄ d N x : ℝ) (j : ℕ) (hd : 0 < d) (hN : 0 < N) :
    zHat D₂ D₃ D₄ d N j 0 x =
      Real.rpow d (-(j : ℝ)) * (8 * x / N) ^ j := by
  have hpM : pM d N x = d⁻¹ * (8 * x / N) := by
    unfold pM
    field_simp [hd.ne', hN.ne']
    <;> ring
  have hinv : (d⁻¹ : ℝ) ^ j = Real.rpow d (-(j : ℝ)) := by
    rw [Real.rpow_eq_pow, Real.rpow_neg hd.le, Real.rpow_natCast, inv_pow]
  unfold zHat
  simp only [Nat.choose_zero_right, Nat.cast_one, pow_zero, one_mul,
    Nat.sub_zero, hpM, mul_pow, hinv]

/-- Exact factored form of the `s = 0` external-test envelope. -/
theorem zeta_zero_available_eq_scale_mul
    (D₂ D₃ D₄ Gamma epsilon d N x : ℝ) (j : ℕ)
    (hd : 0 < d) (hN : 0 < N) (hGamma : 0 < Gamma) :
    zeta D₂ D₃ D₄ Gamma epsilon d N j 0 x =
      xi Gamma epsilon d N x * Real.rpow d (-(j : ℝ)) *
        ((8 * x / N) ^ j + 1 / (4 * Gamma)) := by
  have hz := zHat_zero_available_eq_scale_mul D₂ D₃ D₄ d N x j hd hN
  have hinv : Real.rpow d (-(j : ℝ)) = (d ^ j)⁻¹ := by
    rw [Real.rpow_eq_pow, Real.rpow_neg hd.le, Real.rpow_natCast]
  have hterm : 1 / (4 * Gamma * d ^ j) =
      Real.rpow d (-(j : ℝ)) * (1 / (4 * Gamma)) := by
    rw [hinv]
    field_simp [hd.ne', hGamma.ne']
    <;> ring
  unfold zeta
  simp only [Nat.choose_zero_right, Nat.cast_one, pow_zero, one_mul]
  rw [hz, hterm]
  ring

/-- Once the two time-`T` `s=0` corridors hold and the deterministic
trajectories fit inside the public relative-error interval, the terminal
matching satisfies the corresponding test estimate. -/
theorem externalTestCorridors_terminal_absorb
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N err : ℝ) (j T : ℕ)
    (M : Hypergraph V) (hM : IsMatching H M)
    (hW : 0 ≤ testTotal w H j)
    (hupper : externalTestUpperCorridor w H C
      D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j) j 0 T M)
    (hlower : externalTestLowerCorridor w H C
      D₂ D₃ D₄ Gamma epsilon d N (testTotal w H j) j 0 T M)
    (htrajectoryLower :
      (1 - err) * Real.rpow d (-(j : ℝ)) ≤
        zHat D₂ D₃ D₄ d N j 0 (T : ℝ) -
          zeta D₂ D₃ D₄ Gamma epsilon d N j 0 (T : ℝ))
    (htrajectoryUpper :
      zHat D₂ D₃ D₄ d N j 0 (T : ℝ) +
          zeta D₂ D₃ D₄ Gamma epsilon d N j 0 (T : ℝ) ≤
        (1 + err) * Real.rpow d (-(j : ℝ))) :
    (1 - err) * Real.rpow d (-(j : ℝ)) * testTotal w H j ≤
        testTotal w M j ∧
      testTotal w M j ≤
        (1 + err) * Real.rpow d (-(j : ℝ)) * testTotal w H j := by
  have hobs := partialTestObservable_zero w H C M j hM
  unfold externalTestUpperCorridor at hupper
  unfold externalTestLowerCorridor at hlower
  unfold externalTestUpperError at hupper
  unfold externalTestLowerError at hlower
  simp only [externalTestUpperTrajectory, externalTestLowerTrajectory] at hupper hlower
  constructor
  · have hstrict :
        (1 - err) * Real.rpow d (-(j : ℝ)) * testTotal w H j <
          testTotal w M j := by
      calc
      (1 - err) * Real.rpow d (-(j : ℝ)) * testTotal w H j ≤
          testTotal w H j *
            (zHat D₂ D₃ D₄ d N j 0 (T : ℝ) -
              zeta D₂ D₃ D₄ Gamma epsilon d N j 0 (T : ℝ)) := by
            simpa [mul_assoc, mul_comm, mul_left_comm] using
              mul_le_mul_of_nonneg_left htrajectoryLower hW
      _ < partialTestObservable w H C j 0 M := by linarith
      _ = testTotal w M j := hobs
    exact hstrict.le

  · have hstrict : testTotal w M j <
        (1 + err) * Real.rpow d (-(j : ℝ)) * testTotal w H j := by
      calc
      testTotal w M j = partialTestObservable w H C j 0 M := hobs.symm
      _ < testTotal w H j *
          (zHat D₂ D₃ D₄ d N j 0 (T : ℝ) +
            zeta D₂ D₃ D₄ Gamma epsilon d N j 0 (T : ℝ)) := by
          linarith
      _ ≤ (1 + err) * Real.rpow d (-(j : ℝ)) * testTotal w H j := by
          simpa [mul_assoc, mul_comm, mul_left_comm] using
            mul_le_mul_of_nonneg_left htrajectoryUpper hW
    exact hstrict.le

/-- Uniform elementary power control for the only public test sizes
`j = 1,2,3`. -/
theorem pow_close_to_one_of_one_le_le_three
    {r rho : ℝ} {j : ℕ} (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (hr0 : 0 ≤ r) (hr1 : r ≤ 1) (hrho : 1 - r ≤ rho) :
    1 - 3 * rho ≤ r ^ j ∧ r ^ j ≤ 1 := by
  have hpowUpper : r ^ j ≤ 1 := pow_le_one₀ hr0 hr1
  refine ⟨?_, hpowUpper⟩
  interval_cases j
  · norm_num
    linarith
  · have hsquare : 0 ≤ (1 - r) ^ 2 := sq_nonneg (1 - r)
    norm_num
    nlinarith
  · have hfactor : 0 ≤ (1 - r) ^ 2 * (r + 2) :=
      mul_nonneg (sq_nonneg (1 - r)) (by linarith)
    norm_num
    nlinarith

/-- A concrete scalar budget which places both `s=0` trajectories inside
the public `(1 ± err)d^{-j}` interval.  It is enough that the uncovered-time
loss `rho` and the envelope factor `xi` are each at most `err/16`. -/
theorem externalTestTrajectories_fit_public_of_small
    (D₂ D₃ D₄ Gamma epsilon d N x err rho : ℝ) {j : ℕ}
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hd : 0 < d) (hN : 0 < N)
    (hGamma : 1 ≤ Gamma) (herr : 0 ≤ err)
    (hr0 : 0 ≤ 8 * x / N) (hr1 : 8 * x / N ≤ 1)
    (hrho : 1 - 8 * x / N ≤ rho) (hrhoSmall : rho ≤ err / 16)
    (hxiSmall : xi Gamma epsilon d N x ≤ err / 16) :
    (1 - err) * Real.rpow d (-(j : ℝ)) ≤
        zHat D₂ D₃ D₄ d N j 0 x -
          zeta D₂ D₃ D₄ Gamma epsilon d N j 0 x ∧
      zHat D₂ D₃ D₄ d N j 0 x +
          zeta D₂ D₃ D₄ Gamma epsilon d N j 0 x ≤
        (1 + err) * Real.rpow d (-(j : ℝ)) := by
  let r : ℝ := 8 * x / N
  let u : ℝ := r ^ j
  let envelope : ℝ := xi Gamma epsilon d N x * (u + 1 / (4 * Gamma))
  have hGammaPos : 0 < Gamma := lt_of_lt_of_le zero_lt_one hGamma
  have hxi0 : 0 ≤ xi Gamma epsilon d N x := by
    have hpV0 : 0 ≤ pV N x := by
      unfold pV
      linarith
    unfold xi
    exact mul_nonneg (Real.rpow_nonneg hpV0 _) (Real.rpow_nonneg hd.le _)
  have hr0' : 0 ≤ r := by simpa only [r] using hr0
  have hr1' : r ≤ 1 := by simpa only [r] using hr1
  have hrho' : 1 - r ≤ rho := by simpa only [r] using hrho
  have hu := pow_close_to_one_of_one_le_le_three hj1 hj3 hr0' hr1' hrho'
  have hu0 : 0 ≤ u := pow_nonneg hr0' j
  have huLower : 1 - 3 * (err / 16) ≤ u := by
    dsimp only [u]
    exact hu.1.trans' (by linarith)
  have huUpper : u ≤ 1 := by simpa only [u] using hu.2
  have hg0 : 0 ≤ 1 / (4 * Gamma) := by positivity
  have hgUpper : 1 / (4 * Gamma) ≤ 1 / 4 := by
    rw [div_le_iff₀ (by positivity : 0 < 4 * Gamma)]
    nlinarith
  have hsum0 : 0 ≤ u + 1 / (4 * Gamma) := add_nonneg hu0 hg0
  have hsumUpper : u + 1 / (4 * Gamma) ≤ 5 / 4 := by linarith
  have henvelope0 : 0 ≤ envelope := by
    exact mul_nonneg hxi0 hsum0
  have henvelopeUpper : envelope ≤ 5 * err / 64 := by
    calc
      envelope ≤ (err / 16) * (u + 1 / (4 * Gamma)) := by
        exact mul_le_mul_of_nonneg_right hxiSmall hsum0
      _ ≤ (err / 16) * (5 / 4) := by
        exact mul_le_mul_of_nonneg_left hsumUpper (by positivity)
      _ = 5 * err / 64 := by ring
  have hnormalizedLower : 1 - err ≤ u - envelope := by linarith
  have hnormalizedUpper : u + envelope ≤ 1 + err := by linarith
  dsimp only [envelope] at hnormalizedLower hnormalizedUpper
  have hscale0 : 0 ≤ Real.rpow d (-(j : ℝ)) := by
    rw [Real.rpow_eq_pow]
    exact Real.rpow_nonneg hd.le _
  have hz := zHat_zero_available_eq_scale_mul D₂ D₃ D₄ d N x j hd hN
  have he := zeta_zero_available_eq_scale_mul
    D₂ D₃ D₄ Gamma epsilon d N x j hd hN hGammaPos
  constructor
  · rw [hz, he]
    have hmul := mul_le_mul_of_nonneg_left hnormalizedLower hscale0
    dsimp only [u, r] at hmul
    calc
      (1 - err) * Real.rpow d (-(j : ℝ)) =
          Real.rpow d (-(j : ℝ)) * (1 - err) := by ring
      _ ≤ Real.rpow d (-(j : ℝ)) *
          ((8 * x / N) ^ j -
            xi Gamma epsilon d N x * ((8 * x / N) ^ j + 1 / (4 * Gamma))) := hmul
      _ = Real.rpow d (-(j : ℝ)) * (8 * x / N) ^ j -
          xi Gamma epsilon d N x * Real.rpow d (-(j : ℝ)) *
            ((8 * x / N) ^ j + 1 / (4 * Gamma)) := by ring
  · rw [hz, he]
    have hmul := mul_le_mul_of_nonneg_left hnormalizedUpper hscale0
    dsimp only [u, r] at hmul
    calc
      Real.rpow d (-(j : ℝ)) * (8 * x / N) ^ j +
          xi Gamma epsilon d N x * Real.rpow d (-(j : ℝ)) *
            ((8 * x / N) ^ j + 1 / (4 * Gamma)) =
          Real.rpow d (-(j : ℝ)) *
            ((8 * x / N) ^ j +
              xi Gamma epsilon d N x * ((8 * x / N) ^ j + 1 / (4 * Gamma))) := by ring
      _ ≤ Real.rpow d (-(j : ℝ)) * (1 + err) := hmul
      _ = (1 + err) * Real.rpow d (-(j : ℝ)) := by ring

/-- Full terminal bridge at the rounded stopping time.  The only remaining
large-degree input is the explicit pointwise inequality
`xi Gamma epsilon d N T ≤ err/16`. -/
theorem externalTestCorridors_at_ceil_target
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d err mu : ℝ) (N : ℕ) {j : ℕ}
    (M : Hypergraph V) (hM : IsMatching H M)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hd : 0 < d)
    (hGamma : 1 ≤ Gamma) (herr : 0 ≤ err)
    (hmu1 : mu ≤ 1) (hmuSmall : mu ≤ err / 16)
    (hslack : 1 < mu * (N : ℝ) / 8)
    (hxiSmall :
      xi Gamma epsilon d (N : ℝ)
          (Nat.ceil ((1 - mu) * (N : ℝ) / 8) : ℝ) ≤ err / 16)
    (hW : 0 ≤ testTotal w H j)
    (hupper : externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilon d
      (N : ℝ) (testTotal w H j) j 0
      (Nat.ceil ((1 - mu) * (N : ℝ) / 8)) M)
    (hlower : externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilon d
      (N : ℝ) (testTotal w H j) j 0
      (Nat.ceil ((1 - mu) * (N : ℝ) / 8)) M) :
    (1 - err) * Real.rpow d (-(j : ℝ)) * testTotal w H j ≤
        testTotal w M j ∧
      testTotal w M j ≤
        (1 + err) * Real.rpow d (-(j : ℝ)) * testTotal w H j := by
  let T := Nat.ceil ((1 - mu) * (N : ℝ) / 8)
  have hNne : N ≠ 0 := by
    intro hN
    subst N
    norm_num at hslack
  have hNnat : 0 < N := Nat.pos_of_ne_zero hNne
  have hN : 0 < (N : ℝ) := by exact_mod_cast hNnat
  have htime := ceil_almostPerfect_normalized_time N mu hmu1 hslack
  have htraj := externalTestTrajectories_fit_public_of_small
    D₂ D₃ D₄ Gamma epsilon d (N : ℝ) (T : ℝ) err mu
    hj1 hj3 hd hN hGamma herr htime.1 htime.2.1 htime.2.2 hmuSmall
    (by simpa only [T] using hxiSmall)
  exact externalTestCorridors_terminal_absorb w H C D₂ D₃ D₄ Gamma epsilon d
    (N : ℝ) err j T M hM hW
    (by simpa only [T] using hupper) (by simpa only [T] using hlower)
    htraj.1 htraj.2

/-- Trackability supplies the positive initial weight needed by the strict
initial-corridor lemma. -/
theorem externalTestCorridors_initial_of_trackable
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N eta : ℝ) (ell : ℕ) {j s : ℕ}
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hsj : s ≤ j)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hw : IsTrackable H C j ell d eta w)
    (hd : 0 < d) (hGamma : 0 < Gamma) :
    let W := testTotal w H j
    let margin := W * zeta D₂ D₃ D₄ Gamma epsilon d N j s 0
    0 < margin ∧
      externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ = -margin ∧
      externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ = -margin ∧
      externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ ∧
      externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilon d N W
          j s 0 ∅ := by
  have hW : 0 < testTotal w H j :=
    (Real.rpow_pos_of_pos hd ((j : ℝ) + eta)).trans_le hw.total_lower
  exact externalTestCorridors_initial w H C D₂ D₃ D₄ Gamma epsilon d N
    hj1 hj3 hsj hCcard hW hd hGamma

/-- A convenient eventual-large-degree interface for the pointwise `xi`
condition: separately bound the uncovered-proportion amplification by `A`
and make the degree-decay factor at most `err/(16A)`. -/
theorem xi_le_sixteenth_of_amplification_decay
    (Gamma epsilon d N x err A : ℝ) (hd : 0 ≤ d)
    (hA : 0 < A)
    (hamplification :
      (pV N x) ^ (-9600 * Gamma) ≤ A)
    (hdecay : d ^ (-epsilon / 32) ≤ err / (16 * A)) :
    xi Gamma epsilon d N x ≤ err / 16 := by
  unfold xi
  calc
    (pV N x) ^ (-9600 * Gamma) * d ^ (-epsilon / 32) ≤
        A * d ^ (-epsilon / 32) :=
      mul_le_mul_of_nonneg_right hamplification (Real.rpow_nonneg hd _)
    _ ≤ A * (err / (16 * A)) :=
      mul_le_mul_of_nonneg_left hdecay hA.le
    _ = err / 16 := by field_simp [hA.ne']

/-! ## Simultaneous regularised greedy corridors -/

/-- The actual host vertices are the only degree coordinates that enter the
random-greedy union bound. -/
abbrev ActualHostVertex (H : Hypergraph V) :=
  {v : V // v ∈ vertexFinset H}

/-- An external test together with one of its coordinates `0, ..., j`. -/
abbrev ExternalTestCoordinate {ι : Type*} (j : ι → ℕ) :=
  (i : ι) ×' Fin (j i + 1)

/-- A host edge, a link rank `1,2,3`, and one of its positive partial
coordinates.  The stored coordinate `u : Fin q` represents the actual
partial status `u + 1`, so the impossible internal status-zero corridor is
not part of the simultaneous Good event. -/
abbrev InternalLinkCoordinate (H : Hypergraph V) :=
  (f : {e : Finset V // e ∈ H}) ×'
    (q : Fin 3) ×' Fin (q.1 + 1)

/-- One upper or lower corridor for every degree, external-test, and internal
link coordinate.  `false` denotes the upper corridor and `true` the lower
corridor. -/
abbrev RegularizedGreedyCorridorIndex {ι : Type*}
    (H : Hypergraph V) (j : ι → ℕ) :=
  Sum (Bool × ActualHostVertex H)
    (Sum (Bool × ExternalTestCoordinate j)
      (Bool × InternalLinkCoordinate H))

/-- The regularised layer degree belonging to a link rank in `Fin 3`. -/
def internalLinkLayerScale (D₂ D₃ D₄ : ℝ) (q : Fin 3) : ℝ :=
  if q.1 = 0 then D₂ else if q.1 = 1 then D₃ else D₄

@[simp] theorem internalLinkLayerScale_zero (D₂ D₃ D₄ : ℝ) :
    internalLinkLayerScale D₂ D₃ D₄ (0 : Fin 3) = D₂ := by
  simp [internalLinkLayerScale]

@[simp] theorem internalLinkLayerScale_one (D₂ D₃ D₄ : ℝ) :
    internalLinkLayerScale D₂ D₃ D₄ (1 : Fin 3) = D₃ := by
  simp [internalLinkLayerScale]

@[simp] theorem internalLinkLayerScale_two (D₂ D₃ D₄ : ℝ) :
    internalLinkLayerScale D₂ D₃ D₄ (2 : Fin 3) = D₄ := by
  simp [internalLinkLayerScale]

/-- The single indexed good predicate used to stop every source
supermartingale simultaneously. -/
noncomputable def regularizedGreedyCorridorPredicate {ι : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : ι → ℕ) (w : ι → TestWeight V) :
    RegularizedGreedyCorridorIndex H j → ℕ → Hypergraph V → Prop
  | Sum.inl (lower, v), k, M =>
      if lower then
        degreeLowerCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M
      else
        degreeUpperCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M
  | Sum.inr (Sum.inl (lower, ⟨i, s⟩)), k, M =>
      if lower then
        externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
          (testTotal (w i) H (j i)) (j i) s.1 k M
      else
        externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
          (testTotal (w i) H (j i)) (j i) s.1 k M
  | Sum.inr (Sum.inr (lower, ⟨f, q, u⟩)), k, M =>
      if lower then
        internalConflictLinkLowerCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
          (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M
      else
        internalConflictLinkUpperCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
          (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M

@[simp] theorem regularizedGreedyCorridorPredicate_degreeUpper
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) (v : ActualHostVertex H) (k : ℕ)
    (M : Hypergraph V) :
    regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w
        (Sum.inl (false, v)) k M ↔
      degreeUpperCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M := by
  simp [regularizedGreedyCorridorPredicate]

@[simp] theorem regularizedGreedyCorridorPredicate_degreeLower
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) (v : ActualHostVertex H) (k : ℕ)
    (M : Hypergraph V) :
    regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w
        (Sum.inl (true, v)) k M ↔
      degreeLowerCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M := by
  simp [regularizedGreedyCorridorPredicate]

@[simp] theorem regularizedGreedyCorridorPredicate_externalUpper
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) (i : ι) (s : Fin (j i + 1)) (k : ℕ)
    (M : Hypergraph V) :
    regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w
        (Sum.inr (Sum.inl (false, ⟨i, s⟩))) k M ↔
      externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal (w i) H (j i)) (j i) s.1 k M := by
  simp [regularizedGreedyCorridorPredicate]

@[simp] theorem regularizedGreedyCorridorPredicate_externalLower
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) (i : ι) (s : Fin (j i + 1)) (k : ℕ)
    (M : Hypergraph V) :
    regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w
        (Sum.inr (Sum.inl (true, ⟨i, s⟩))) k M ↔
      externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal (w i) H (j i)) (j i) s.1 k M := by
  simp [regularizedGreedyCorridorPredicate]

@[simp] theorem regularizedGreedyCorridorPredicate_internalUpper
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) (f : {e : Finset V // e ∈ H})
    (q : Fin 3) (u : Fin (q.1 + 1)) (k : ℕ) (M : Hypergraph V) :
    regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w
        (Sum.inr (Sum.inr (false, ⟨f, q, u⟩))) k M ↔
      internalConflictLinkUpperCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M := by
  simp [regularizedGreedyCorridorPredicate]

@[simp] theorem regularizedGreedyCorridorPredicate_internalLower
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) (f : {e : Finset V // e ∈ H})
    (q : Fin 3) (u : Fin (q.1 + 1)) (k : ℕ) (M : Hypergraph V) :
    regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w
        (Sum.inr (Sum.inr (true, ⟨f, q, u⟩))) k M ↔
      internalConflictLinkLowerCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M := by
  simp [regularizedGreedyCorridorPredicate]

/-- A paired upper/lower tail is charged once to its underlying observable
coordinate. -/
def regularizedGreedyCorridorTail {ι : Type*} {H : Hypergraph V}
    {j : ι → ℕ}
    (degreeTail : ActualHostVertex H → ℝ)
    (externalTail : ExternalTestCoordinate j → ℝ)
    (internalTail : InternalLinkCoordinate H → ℝ) :
    RegularizedGreedyCorridorIndex H j → ℝ
  | Sum.inl (_, v) => degreeTail v
  | Sum.inr (Sum.inl (_, a)) => externalTail a
  | Sum.inr (Sum.inr (_, a)) => internalTail a

/-- The indexed good predicate exposes every lower degree corridor. -/
theorem indexedRegularizedGreedyGood_degreeLower
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) (v : ActualHostVertex H) :
    degreeLowerCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M := by
  exact (regularizedGreedyCorridorPredicate_degreeLower
    H C D₂ D₃ D₄ Gamma epsilon d N j w v k M).mp
      (hgood (Sum.inl (true, v)))

/-- The indexed good predicate exposes both degree corridors. -/
theorem indexedRegularizedGreedyGood_degree
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) (v : ActualHostVertex H) :
    degreeUpperCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M ∧
      degreeLowerCorridor H C v.1 D₂ D₃ D₄ Gamma epsilon d N k M := by
  constructor
  · exact (regularizedGreedyCorridorPredicate_degreeUpper
      H C D₂ D₃ D₄ Gamma epsilon d N j w v k M).mp
        (hgood (Sum.inl (false, v)))
  · exact indexedRegularizedGreedyGood_degreeLower
      H C D₂ D₃ D₄ Gamma epsilon d N j w hgood v

/-- Simultaneous degree corridors give the real interval used by the exact
handshake and rounded miss-loss lemmas. -/
theorem availableDegreeWithin_of_indexedRegularizedGreedyGood
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) :
    AvailableDegreeWithin H C M
      (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))
      (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)) := by
  intro v hv
  let v' : ActualHostVertex H := ⟨v, (mem_uncoveredVertices.mp hv).1⟩
  have hc := indexedRegularizedGreedyGood_degree
    H C D₂ D₃ D₄ Gamma epsilon d N j w hgood v'
  have hu : degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N k M < 0 :=
    hc.1.resolve_left (fun h ↦ h hv)
  have hl : degreeLowerError H C v D₂ D₃ D₄ Gamma epsilon d N k M < 0 :=
    hc.2.resolve_left (fun h ↦ h hv)
  unfold degreeUpperError at hu
  unfold degreeLowerError at hl
  constructor <;> linarith

/-- The indexed good predicate exposes both terminal corridors of the
zero-available coordinate of every external test. -/
theorem indexedRegularizedGreedyGood_externalZero
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) (i : ι) :
    externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal (w i) H (j i)) (j i) 0 k M ∧
      externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal (w i) H (j i)) (j i) 0 k M := by
  let s : Fin (j i + 1) := ⟨0, Nat.zero_lt_succ _⟩
  constructor
  · exact (regularizedGreedyCorridorPredicate_externalUpper
      H C D₂ D₃ D₄ Gamma epsilon d N j w i s k M).mp
        (hgood (Sum.inr (Sum.inl (false, ⟨i, s⟩))))
  · exact (regularizedGreedyCorridorPredicate_externalLower
      H C D₂ D₃ D₄ Gamma epsilon d N j w i s k M).mp
        (hgood (Sum.inr (Sum.inl (true, ⟨i, s⟩))))

/-- The indexed good predicate exposes both corridors of an arbitrary
external coordinate. -/
theorem indexedRegularizedGreedyGood_external
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) (i : ι) (s : Fin (j i + 1)) :
    externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal (w i) H (j i)) (j i) s.1 k M ∧
      externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal (w i) H (j i)) (j i) s.1 k M := by
  constructor
  · exact (regularizedGreedyCorridorPredicate_externalUpper
      H C D₂ D₃ D₄ Gamma epsilon d N j w i s k M).mp
        (hgood (Sum.inr (Sum.inl (false, ⟨i, s⟩))))
  · exact (regularizedGreedyCorridorPredicate_externalLower
      H C D₂ D₃ D₄ Gamma epsilon d N j w i s k M).mp
        (hgood (Sum.inr (Sum.inl (true, ⟨i, s⟩))))

/-- The indexed good predicate exposes both corridors of an arbitrary
internal link coordinate. -/
theorem indexedRegularizedGreedyGood_internal
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) (f : {e : Finset V // e ∈ H})
    (q : Fin 3) (u : Fin (q.1 + 1)) :
    internalConflictLinkUpperCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M ∧
      internalConflictLinkLowerCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M := by
  constructor
  · exact (regularizedGreedyCorridorPredicate_internalUpper
      H C D₂ D₃ D₄ Gamma epsilon d N j w f q u k M).mp
        (hgood (Sum.inr (Sum.inr (false, ⟨f, q, u⟩))))
  · exact (regularizedGreedyCorridorPredicate_internalLower
      H C D₂ D₃ D₄ Gamma epsilon d N j w f q u k M).mp
        (hgood (Sum.inr (Sum.inr (true, ⟨f, q, u⟩))))

/-- The three one-available internal link windows extracted from the indexed
good predicate. -/
theorem indexedRegularizedGreedyGood_internalOpenLinks
    {ι : Type*} (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ι → ℕ)
    (w : ι → TestWeight V) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d N j w)
      k M) (f : {e : Finset V // e ∈ H}) :
    (internalConflictLinkUpperCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        D₂ 1 1 k M ∧
      internalConflictLinkLowerCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        D₂ 1 1 k M) ∧
    (internalConflictLinkUpperCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        D₃ 2 1 k M ∧
      internalConflictLinkLowerCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        D₃ 2 1 k M) ∧
    (internalConflictLinkUpperCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        D₄ 3 1 k M ∧
      internalConflictLinkLowerCorridor H C f.1 D₂ D₃ D₄ Gamma epsilon d N
        D₄ 3 1 k M) := by
  have h₁ := indexedRegularizedGreedyGood_internal
    H C D₂ D₃ D₄ Gamma epsilon d N j w hgood f (0 : Fin 3)
      (⟨0, by norm_num⟩ : Fin 1)
  have h₂ := indexedRegularizedGreedyGood_internal
    H C D₂ D₃ D₄ Gamma epsilon d N j w hgood f (1 : Fin 3)
      (⟨0, by norm_num⟩ : Fin 2)
  have h₃ := indexedRegularizedGreedyGood_internal
    H C D₂ D₃ D₄ Gamma epsilon d N j w hgood f (2 : Fin 3)
      (⟨0, by norm_num⟩ : Fin 3)
  simpa using ⟨h₁, h₂, h₃⟩

/-- A simultaneous first-failure union bound for the concrete regularised
corridor index.  The only non-freezing input is positivity of the lower
degree trajectory; all test conclusions are read from the terminal
zero-available corridors. -/
theorem exists_regularizedGreedyCore_of_componentFirstFailureBounds
    {ι : Type*} [Fintype ι] [Fintype V]
    (H : Hypergraph V) (C : ConflictSystem V) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d err : ℝ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (degreeTail : ActualHostVertex H → ℝ)
    (externalTail : ExternalTestCoordinate j → ℝ)
    (internalTail : InternalLinkCoordinate H → ℝ)
    (hH : IsUniform H 8) (hC : ∅ ∉ C)
    (hsize : 8 * T < (vertexFinset H).card)
    (htrajectory : ∀ k, k < T →
      0 < CFMTrajectories.dHat D₂ D₃ D₄ d ((vertexFinset H).card : ℝ) k -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d
          ((vertexFinset H).card : ℝ) k)
    (hinitial : ∀ a : RegularizedGreedyCorridorIndex H j,
      regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
        ((vertexFinset H).card : ℝ) j w a 0 ∅)
    (hdegreeBad : ∀ v : ActualHostVertex H,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inl (false, v))) ≤ degreeTail v ∧
        Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inl (true, v))) ≤ degreeTail v)
    (hexternalBad : ∀ a : ExternalTestCoordinate j,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inl (false, a)))) ≤ externalTail a ∧
        Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inl (true, a)))) ≤ externalTail a)
    (hinternalBad : ∀ a : InternalLinkCoordinate H,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inr (false, a)))) ≤ internalTail a ∧
        Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inr (true, a)))) ≤ internalTail a)
    (htotal :
      (∑ a : RegularizedGreedyCorridorIndex H j,
        regularizedGreedyCorridorTail degreeTail externalTail internalTail a) < 1)
    (hterminal : ∀ M, IsMatching H M → M.card = T →
      (∀ i,
        externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d
            ((vertexFinset H).card : ℝ) (testTotal (w i) H (j i))
            (j i) 0 T M ∧
          externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d
            ((vertexFinset H).card : ℝ) (testTotal (w i) H (j i))
            (j i) 0 T M) →
      SatisfiesTestEstimates H M d err j w) :
    ∃ M, IsConflictFreeMatching H C M ∧ M.card = T ∧
      SatisfiesTestEstimates H M d err j w := by
  let P := regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
    ((vertexFinset H).card : ℝ) j w
  let tail := regularizedGreedyCorridorTail degreeTail externalTail internalTail
  have hBad : ∀ a : RegularizedGreedyCorridorIndex H j,
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ T P a) ≤ tail a := by
    rintro (⟨lower, v⟩ | (⟨lower, a⟩ | ⟨lower, a⟩))
    · cases lower
      · simpa [P, tail, regularizedGreedyCorridorTail] using (hdegreeBad v).1
      · simpa [P, tail, regularizedGreedyCorridorTail] using (hdegreeBad v).2
    · cases lower
      · simpa [P, tail, regularizedGreedyCorridorTail] using (hexternalBad a).1
      · simpa [P, tail, regularizedGreedyCorridorTail] using (hexternalBad a).2
    · cases lower
      · simpa [P, tail, regularizedGreedyCorridorTail] using (hinternalBad a).1
      · simpa [P, tail, regularizedGreedyCorridorTail] using (hinternalBad a).2
  have hnonfreeze : ∀ omega : GreedyOutcome H T,
      greedyPrefixGood H C ∅ (indexedGreedyGood P) T omega →
      ∀ k, k < T →
        (availableEdges H C (greedyStateAt H C omega k)).Nonempty := by
    intro omega hpref k hk
    apply availableEdges_nonempty_of_degreeLowerCorridors
      H C hH hC omega k hk hsize D₂ D₃ D₄ Gamma epsilon d
        ((vertexFinset H).card : ℝ) (htrajectory k hk)
    intro v hv
    let v' : ActualHostVertex H := ⟨v, (mem_uncoveredVertices.mp hv).1⟩
    rw [greedyStateAt_eq_stateFrom_empty]
    exact indexedRegularizedGreedyGood_degreeLower
      H C D₂ D₃ D₄ Gamma epsilon d ((vertexFinset H).card : ℝ) j w
        (hpref k (Nat.le_of_lt hk)) v'
  obtain ⟨omega, hpref, hmatching, hcard⟩ :=
    exists_greedy_outcome_of_firstFailureTails_reachable H C T P tail
      hBad (by simpa [tail] using htotal) (by simpa [P] using hinitial)
      hnonfreeze hC
  let M := greedyStateAt H C omega T
  refine ⟨M, hmatching, hcard, ?_⟩
  apply hterminal M hmatching.1 hcard
  intro i
  simpa [M, greedyStateAt_eq_stateFrom_empty] using
    (indexedRegularizedGreedyGood_externalZero
      H C D₂ D₃ D₄ Gamma epsilon d ((vertexFinset H).card : ℝ) j w
        (hpref T le_rfl) i)

attribute [local instance] Classical.propDecidable

/-! ## Certificate/corridor absorption bridge -/

noncomputable def degreeInternalCorridorError
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (k : ℕ) : ℝ :=
  D₂ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ) +
  D₃ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ) +
  D₄ * CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ)

noncomputable def certificateDegreeCombLo
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N codegreeHi : ℝ)
    (spread : ℕ → Hypergraph V → ℝ)
    (k : ℕ) (S : Hypergraph V) : ℝ :=
  let degreeLo :=
    CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
      CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
  (degree (availableEdges H C S) v : ℝ) *
      (((7 * Nat.floor degreeLo - 28 * Nat.ceil codegreeHi : ℕ) : ℝ) +
        (CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) -
          (degreeInternalCorridorError D₂ D₃ D₄ Gamma epsilon d N k +
            spread k S))) /
    ((availableEdges H C S).card : ℝ)

noncomputable def certificateDegreeCombHi
    (H : Hypergraph V) (C : ConflictSystem V) (v : V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (k : ℕ) (S : Hypergraph V) : ℝ :=
  let degreeHi :=
    CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
      CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
  (degree (availableEdges H C S) v : ℝ) *
      (((7 * Nat.ceil degreeHi : ℕ) : ℝ) +
        (CFMTrajectories.cHat D₂ D₃ D₄ d N (k : ℝ) +
          degreeInternalCorridorError D₂ D₃ D₄ Gamma epsilon d N k)) /
    ((availableEdges H C S).card : ℝ)

abbrev certificateIndexedGreedyGood
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsilon Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsilon Gamma ellCert j w)
    (D₂ D₃ D₄ N : ℝ) : ℕ → Hypergraph V → Prop :=
  indexedGreedyGood
    (regularizedGreedyCorridorPredicate H R.regularized
      D₂ D₃ D₄ Gamma epsilon d N j R.restrictedWeight)

/-- Turn one upper/lower internal-link corridor pair into the closed window
needed by the combinatorial miss-loss estimate. -/
theorem internalConflictLink_bounds_of_corridors
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ)
    (j s k : ℕ) (M : Hypergraph V)
    (hf : f ∈ availableEdges H C M)
    (hcorr :
      internalConflictLinkUpperCorridor H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s k M ∧
        internalConflictLinkLowerCorridor H C f
          D₂ D₃ D₄ Gamma epsilon d N scale j s k M) :
    scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)) ≤
        ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer C f j)
          (availableEdges H C M) M s).card : ℝ) ≤
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s (k : ℝ)) := by
  have hu := hcorr.1.resolve_left (fun h ↦ h hf)
  have hl := hcorr.2.resolve_left (fun h ↦ h hf)
  unfold internalConflictLinkUpperError at hu
  unfold internalConflictLinkLowerError at hl
  constructor <;> linarith

/-- The indexed good event supplies all three one-available internal-link
windows in the exact shape consumed by the mean-loss bridge. -/
theorem internalOpenLink_bounds_of_certificateIndexedGreedyGood
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsilon Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsilon Gamma ellCert j w)
    (D₂ D₃ D₄ N : ℝ) {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w R
      D₂ D₃ D₄ N k M) :
    (∀ f ∈ availableEdges H R.regularized M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ)) ≤
          ((partialFamily (conflictLinkLayer R.regularized f 1)
            (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 1)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ))) ∧
    (∀ f ∈ availableEdges H R.regularized M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ)) ≤
          ((partialFamily (conflictLinkLayer R.regularized f 2)
            (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 2)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ))) ∧
    (∀ f ∈ availableEdges H R.regularized M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ)) ≤
          ((partialFamily (conflictLinkLayer R.regularized f 3)
            (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 3)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ))) := by
  constructor
  · intro f hf
    have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
      H R.regularized D₂ D₃ D₄ Gamma epsilon d N j R.restrictedWeight
        hgood ⟨f, (mem_availableEdges.mp hf).1⟩
    exact internalConflictLink_bounds_of_corridors
      H R.regularized f D₂ D₃ D₄ Gamma epsilon d N D₂ 1 1 k M hf hlinks.1
  · constructor
    · intro f hf
      have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
        H R.regularized D₂ D₃ D₄ Gamma epsilon d N j R.restrictedWeight
          hgood ⟨f, (mem_availableEdges.mp hf).1⟩
      exact internalConflictLink_bounds_of_corridors
        H R.regularized f D₂ D₃ D₄ Gamma epsilon d N D₃ 2 1 k M hf hlinks.2.1
    · intro f hf
      have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
        H R.regularized D₂ D₃ D₄ Gamma epsilon d N j R.restrictedWeight
          hgood ⟨f, (mem_availableEdges.mp hf).1⟩
      exact internalConflictLink_bounds_of_corridors
        H R.regularized f D₂ D₃ D₄ Gamma epsilon d N D₄ 3 1 k M hf hlinks.2.2

/-- Internal certificate-to-degree-budget bridge.  Corridors and certificate
boundedness discharge all combinatorial mean-loss hypotheses.  The remaining
inputs are genuinely scalar/one-state source estimates: the two mean
absorptions, the miss-only jump and raw second moment, trajectory increments,
and their final variance absorption. -/
theorem survivingDegreeSourceBudgets_of_regularizationCertificate
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsilon Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d epsilon Gamma ellCert j w)
    (D₂ D₃ D₄ N P codegreeHi : ℝ)
    (T : ℕ) (v : V)
    (spread : ℕ → Hypergraph V → ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (hH8 : IsUniform H 8)
    (hstate : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      IsConflictFreeMatching H Rcert.regularized S)
    (hdegreeLo0 : ∀ k, k < T →
      0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))
    (havailable : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      (availableEdges H Rcert.regularized S).Nonempty)
    (hcodegree : ∀ s, s.card = 2 →
      (codegree H s : ℝ) ≤ codegreeHi)
    (hspread : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      ∀ f ∈ availableEdges H Rcert.regularized S,
        (internalOpenLinkMass Rcert.regularized
            (availableEdges H Rcert.regularized S) S f : ℝ) -
          (openConflictCount Rcert.regularized
            (availableEdges H Rcert.regularized S) S f : ℝ) ≤ spread k S)
    (hregistry : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      CFMTrajectories.DeltaStepRegistry
        D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P)
    (hnumericLower : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) +
            2 * (d ^ (1 - epsilon) / N)) ≤
        certificateDegreeCombLo H Rcert.regularized v
          D₂ D₃ D₄ Gamma epsilon d N codegreeHi spread k S)
    (hnumericUpper : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ Gamma epsilon d N k S ≤
        survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) -
            2 * (d ^ (1 - epsilon) / N)))
    (hloss : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      ∀ e ∈ availableEdges H Rcert.regularized S, v ∉ e →
        (availableDegreeLoss H Rcert.regularized S e v : ℝ) ≤ jump k)
    (hrawSquare : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      meanSqMissAvailableDegreeLoss H Rcert.regularized S v ≤ rawVariance k)
    (hupperTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤
        trajectory k)
    (hlowerTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤
        trajectory k)
    (hsquare : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      2 * rawVariance k + 2 * (trajectory k) ^ 2 ≤ variance k) :
    SurvivingDegreeSourceBudgets H Rcert.regularized
      (certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
        D₂ D₃ D₄ N) T v D₂ D₃ D₄ Gamma epsilon d N P
      jump trajectory rawVariance variance := by
  apply survivingDegreeSourceBudgets_of_combinatorialMeanBounds
    H Rcert.regularized
      (certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
      D₂ D₃ D₄ N) T v D₂ D₃ D₄ Gamma epsilon d N P
    jump trajectory rawVariance variance
    (certificateDegreeCombLo H Rcert.regularized v
      D₂ D₃ D₄ Gamma epsilon d N codegreeHi spread)
    (certificateDegreeCombHi H Rcert.regularized v
      D₂ D₃ D₄ Gamma epsilon d N)
    hregistry
  · intro k hk S hgood hv
    have hHnonempty : ∀ f ∈ H, f.Nonempty := by
      intro f hf
      exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
    have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
      H Rcert.regularized D₂ D₃ D₄ Gamma epsilon d N
        j Rcert.restrictedWeight hgood
    have hlinks := internalOpenLink_bounds_of_certificateIndexedGreedyGood
      H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ N hgood
    have hbounds := meanMissAvailableDegreeLoss_bounds_of_corridors_internalLinks
      hHnonempty hH8 (fun c hc ↦ Rcert.bounded.conflict_card hc)
      (hstate k hk S hgood) (hdegreeLo0 k hk) hdegree hcodegree
      hlinks.1 hlinks.2.1 hlinks.2.2 (hspread k hk S hgood)
      v (havailable k hk S hgood hv)
    simpa [certificateDegreeCombLo, certificateDegreeCombHi,
      degreeInternalCorridorError] using hbounds
  · exact hnumericLower
  · exact hnumericUpper
  · exact hloss
  · exact hrawSquare
  · exact hupperTrajectory
  · exact hlowerTrajectory
  · exact hsquare

open scoped BigOperators

noncomputable def externalTestNaturalScale
    (w : TestWeight V) (H : Hypergraph V) (d : ℝ) (j s : ℕ) : ℝ :=
  testTotal w H j * Real.rpow d ((s : ℝ) - (j : ℝ))

theorem externalTestNaturalScale_nonneg
    (w : TestWeight V) (H : Hypergraph V) (d : ℝ) (j s : ℕ)
    (hw : ∀ S, 0 ≤ w S) (hd : 0 ≤ d) :
    0 ≤ externalTestNaturalScale w H d j s := by
  exact mul_nonneg (testTotal_nonneg hw H j) (Real.rpow_nonneg hd _)

theorem testSourceJumpScale_externalTestNaturalScale
    (w : TestWeight V) (H : Hypergraph V) (d epsilon : ℝ) (j s : ℕ)
    (hd : 0 < d) :
    testSourceJumpScale (externalTestNaturalScale w H d j s) d epsilon =
      testTotal w H j *
        Real.rpow d ((s : ℝ) - (j : ℝ) - epsilon / 4) := by
  unfold testSourceJumpScale externalTestNaturalScale
  change
    (testTotal w H j * d ^ ((s : ℝ) - (j : ℝ))) *
        d ^ (-epsilon / 4) =
      testTotal w H j *
        d ^ ((s : ℝ) - (j : ℝ) - epsilon / 4)
  rw [mul_assoc, ← Real.rpow_add hd]
  congr 2
  ring

theorem testSourceVarianceScale_externalTestNaturalScale
    (w : TestWeight V) (H : Hypergraph V) (d epsilon N : ℝ) (j s : ℕ)
    (hd : 0 < d) :
    testSourceVarianceScale (externalTestNaturalScale w H d j s)
        d epsilon N =
      testTotal w H j ^ 2 *
          Real.rpow d
            (2 * ((s : ℝ) - (j : ℝ)) - 3 * epsilon / 16) / N := by
  unfold testSourceVarianceScale externalTestNaturalScale
  change
    (testTotal w H j * d ^ ((s : ℝ) - (j : ℝ))) ^ 2 *
          d ^ (-3 * epsilon / 16) / N =
      testTotal w H j ^ 2 *
          d ^ (2 * ((s : ℝ) - (j : ℝ)) - 3 * epsilon / 16) / N
  rw [mul_pow, pow_two (d ^ ((s : ℝ) - (j : ℝ))),
    ← Real.rpow_add hd]
  rw [mul_assoc, ← Real.rpow_add hd]
  congr 2
  ring_nf

/-! Elementary consequences of a pointwise observable jump bound. -/

theorem partialTestDrift_abs_le_of_choice_abs_le
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V) {B : ℝ} (hB0 : 0 ≤ B)
    (hchoice : ∀ o : GreedyChoice H,
      |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
        partialTestObservable w H C j s M| ≤ B) :
    |partialTestDrift w H C j s M| ≤ B := by
  let X : Hypergraph V → ℝ := fun M' ↦
    partialTestObservable w H C j s M' -
      partialTestObservable w H C j s M
  have hmean : greedyStepExpectation H C M X =
      partialTestDrift w H C j s M := by
    simpa only [X, partialTestDrift] using
      greedyStepExpectation_partialTest_increment w H C j s M
  have hu : greedyStepExpectation H C M X ≤ B := by
    apply greedyStepExpectation_le_const_of_choices
    intro o
    exact (le_abs_self (X (greedyChoiceStep H C M o))).trans
      (by simpa only [X] using hchoice o)
  have hl : greedyStepExpectation H C M (fun M' ↦ -X M') ≤ B := by
    apply greedyStepExpectation_le_const_of_choices
    intro o
    exact (neg_le_abs (X (greedyChoiceStep H C M o))).trans
      (by simpa only [X] using hchoice o)
  rw [greedyStepExpectation_neg] at hl
  rw [← hmean]
  exact abs_le.mpr ⟨by linarith, hu⟩

theorem meanSqPartialTestIncrement_le_sq_of_choice_abs_le
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j s : ℕ) (M : Hypergraph V) {B : ℝ}
    (hchoice : ∀ o : GreedyChoice H,
      |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
        partialTestObservable w H C j s M| ≤ B) :
    meanSqPartialTestIncrement w H C j s M ≤ B ^ 2 := by
  rw [← greedyStepExpectation_partialTest_increment_sq]
  exact greedyStepExpectation_sq_le_sq_of_choice_abs_le H C M
    (fun M' ↦ partialTestObservable w H C j s M' -
      partialTestObservable w H C j s M) B hchoice

/-! A status-count cap supplies every non-mean part of a rank-two or
rank-three `PartialTestSourceBudgets`. -/

theorem partialTestSourceBudgets_of_statusSpread
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T j s ell : ℕ)
    (d eta epsilon N P : ℝ) (L : ℕ → ℝ)
    (hw : IsTrackable H C j ell d eta w) (hj2 : 2 ≤ j) (hj3 : j ≤ 3)
    (hd : 0 ≤ d) (hL0 : ∀ k, 0 ≤ L k)
    (hspread : ∀ k, k < T → ∀ M, Good k M →
      HasExternalTestStatusSpread H C M (L k))
    (hlocal : ∀ k, k < T →
      L k * (testTotal w H j / Real.rpow d (1 + eta)) ≤
        testSourceJumpScale P d epsilon / 2)
    (hrawSquare : ∀ k, k < T →
      (L k * (testTotal w H j / Real.rpow d (1 + eta))) ^ 2 ≤
        testSourceVarianceScale P d epsilon N) :
    PartialTestSourceBudgets w H C Good T j s ell
      d eta epsilon N P := by
  refine ⟨hw, hj2, hj3, ?_⟩
  intro k hk M hgood
  let B := L k * (testTotal w H j / Real.rpow d (1 + eta))
  have hB0 : 0 ≤ B := by
    dsimp only [B]
    exact mul_nonneg (hL0 k)
      (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg hd _))
  have hchoice : ∀ o : GreedyChoice H,
      |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
        partialTestObservable w H C j s M| ≤ B := by
    apply partialTestChoice_raw_abs_le_of_spread s M hw hj2 hB0
    intro e he
    exact mul_le_mul_of_nonneg_right
      ((hspread k hk M hgood) e he)
      (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg hd _))
  refine ⟨?_, ?_, ?_⟩
  · intro e he
    exact (mul_le_mul_of_nonneg_right
      ((hspread k hk M hgood) e he)
      (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg hd _))).trans (hlocal k hk)
  · exact (partialTestDrift_abs_le_of_choice_abs_le
      w H C j s M hB0 hchoice).trans (hlocal k hk)
  · exact (meanSqPartialTestIncrement_le_sq_of_choice_abs_le
      w H C j s M hchoice).trans (hrawSquare k hk)

/-! Restricted public tests of rank two or three.  The mean window is kept
explicit: it is analytic input, not a consequence of corridor membership. -/

theorem restrictedExternalTestSourceBudgets_of_statusSpread
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (a : io) (Good : ℕ → Hypergraph V → Prop) (T s : ℕ)
    (D₂ D₃ D₄ epsilonCore N Pfloor testScale : ℝ)
    (L : ℕ → ℝ)
    (hj2 : 2 ≤ j a) (hj3 : j a ≤ 3) (hd : 0 ≤ d)
    (htestScale : 0 ≤ testScale)
    (hL0 : ∀ k, 0 ≤ L k)
    (hspread : ∀ k, k < T → ∀ M, Good k M →
      HasExternalTestStatusSpread H R.regularized M (L k))
    (hlocal : ∀ k, k < T →
      L k * (testTotal (R.restrictedWeight a) H (j a) /
        Real.rpow d (1 + epsRaw / 5)) ≤
          testSourceJumpScale testScale d epsilonCore / 2)
    (hrawSquare : ∀ k, k < T →
      (L k * (testTotal (R.restrictedWeight a) H (j a) /
        Real.rpow d (1 + epsRaw / 5))) ^ 2 ≤
          testSourceVarianceScale testScale d epsilonCore N)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilonCore d N (k : ℝ) Pfloor (j a) s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N (j a) s (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - (j a : ℝ) - epsilonCore) / N)) ≤
        meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N (j a) s (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - (j a : ℝ) - epsilonCore) / N)))
    (htrajectory : ∀ k, k < T →
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H (j a)) (j a) s k ≤
        testSourceJumpScale testScale d epsilonCore / 2) :
    ExternalTestSourceBudgets (R.restrictedWeight a) H R.regularized Good T
      D₂ D₃ D₄ Gamma epsilonCore d N Pfloor
      (testTotal (R.restrictedWeight a) H (j a)) (j a) s
      (fun _ ↦ testSourceJumpScale testScale d epsilonCore)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
        (testTotal (R.restrictedWeight a) H (j a)) (j a) s
        (fun _ ↦ testSourceVarianceScale testScale d epsilonCore N)) := by
  have hbudget := partialTestSourceBudgets_of_statusSpread
      (R.restrictedWeight a) H R.regularized Good T (j a) s ellCert
      d (epsRaw / 5) epsilonCore N testScale L
      (R.survivingTrackable a) hj2 hj3 hd
      hL0 hspread hlocal hrawSquare
  have hW0 : 0 ≤ testTotal (R.restrictedWeight a) H (j a) :=
    testTotal_nonneg (R.survivingTrackable a).isTestFunction.nonneg H (j a)
  have hhalf0 : 0 ≤ testSourceJumpScale testScale d epsilonCore / 2 := by
    exact div_nonneg (mul_nonneg htestScale (Real.rpow_nonneg hd _)) (by norm_num)
  refine {
    arity := hbudget.2.2.1
    weight_nonneg := hW0
    registry := hregistry
    meanLower := hmeanLower
    meanUpper := hmeanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · intro k hk M hgood o
    have hb := hbudget.2.2.2 k hk M hgood
    have hraw := partialTestChoice_raw_abs_le_of_spread
      s M hbudget.1 hbudget.2.1 hhalf0 hb.1 o
    apply (externalTestEnvelopeStep_abs_le_of_observableJump
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H (j a)) (k : ℝ) (j a) s M
      (greedyChoiceStep H R.regularized M o) (hregistry k hk M hgood)
      hW0 hraw).1.trans
    simpa only [externalTestTrajectoryJump] using
      (show testSourceJumpScale testScale d epsilonCore / 2 +
          externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
            (testTotal (R.restrictedWeight a) H (j a)) (j a) s k ≤
          testSourceJumpScale testScale d epsilonCore by
        linarith [htrajectory k hk])
  · intro k hk M hgood o
    have hb := hbudget.2.2.2 k hk M hgood
    have hraw := partialTestChoice_raw_abs_le_of_spread
      s M hbudget.1 hbudget.2.1 hhalf0 hb.1 o
    apply (externalTestEnvelopeStep_abs_le_of_observableJump
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H (j a)) (k : ℝ) (j a) s M
      (greedyChoiceStep H R.regularized M o) (hregistry k hk M hgood)
      hW0 hraw).2.trans
    simpa only [externalTestTrajectoryJump] using
      (show testSourceJumpScale testScale d epsilonCore / 2 +
          externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
            (testTotal (R.restrictedWeight a) H (j a)) (j a) s k ≤
          testSourceJumpScale testScale d epsilonCore by
        linarith [htrajectory k hk])
  · intro k hk M hgood
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H (j a)) (j a) s k M
      (hregistry k hk M hgood) hW0
      (hbudget.2.2.2 k hk M hgood).2.2).1
  · intro k hk M hgood
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H (j a)) (j a) s k M
      (hregistry k hk M hgood) hW0
      (hbudget.2.2.2 k hk M hgood).2.2).2

/-! Rank-one tests use the literal test-function bound `w ≤ ell`, since the
rooted extension clause of trackability starts strictly below the test rank. -/

theorem testExtension_singleton_le_four
    (w : TestWeight V) (H : Hypergraph V)
    (ell : ℕ) (hw : IsTestFunction H 1 ell w)
    {f : Finset V} (hf : f ∈ H) :
    testExtension w H 1 {f} ≤ ell := by
  unfold testExtension
  have hfilter :
      (H.powersetCard 1).filter (({f} : Hypergraph V) ⊆ ·) =
        {{f}} := by
    ext S
    simp only [Finset.mem_filter, Finset.mem_powersetCard,
      Finset.mem_singleton]
    constructor
    · rintro ⟨⟨hSH, hScard⟩, hfS⟩
      have hcardRoot : ({f} : Hypergraph V).card = 1 := by simp
      exact (Finset.eq_of_subset_of_card_le hfS
        (by rw [hcardRoot, hScard])).symm
    · rintro rfl
      exact ⟨⟨by simpa, by simp⟩, Finset.Subset.rfl⟩
  rw [hfilter]
  simpa using hw.2.1 ({f} : Hypergraph V)

theorem externalSingletonWeightSpread_of_statusSpread
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) {L : ℝ}
    (ell : ℕ) (hw : IsTestFunction H 1 ell w)
    (hspread : HasExternalTestStatusSpread H C M L) :
    HasExternalSingletonWeightSpread w H C M ((ell : ℝ) * L) := by
  intro e he
  let D := availableEdges H C M \ availableEdges H C (insert e M)
  have hDH : D ⊆ H :=
    Finset.sdiff_subset.trans (availableEdges_subset H C M)
  calc
    (∑ f ∈ D, testExtension w H 1 {f}) ≤ ∑ _f ∈ D, (ell : ℝ) := by
      apply Finset.sum_le_sum
      intro f hf
      exact testExtension_singleton_le_four w H ell hw (hDH hf)
    _ = (D.card : ℝ) * ell := by simp
    _ ≤ L * ell :=
      mul_le_mul_of_nonneg_right (hspread e he) (Nat.cast_nonneg ell)
    _ = (ell : ℝ) * L := by ring

theorem singletonPartialTestChoice_abs_le_of_weightSpread
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {ell : ℕ} {d eta B : ℝ} (s : ℕ) (M : Hypergraph V)
    (hw : IsTrackable H C 1 ell d eta w) (hB0 : 0 ≤ B)
    (hspread : HasExternalSingletonWeightSpread w H C M B) :
    ∀ o : GreedyChoice H,
      |partialTestObservable w H C 1 s (greedyChoiceStep H C M o) -
        partialTestObservable w H C 1 s M| ≤ B := by
  intro o
  rcases o with _ | e
  · simp [greedyChoiceStep, hB0]
  · by_cases he : (e : Finset V) ∈ availableEdges H C M
    · rw [greedyChoiceStep, greedyStep_eq_insert he]
      exact externalSingletonTestObservable_jump_le hw hspread s he
    · rw [greedyChoiceStep, greedyStep_eq_self he]
      simp [hB0]

theorem restrictedExternalSingletonSourceBudgets_of_statusSpread
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (a : io) (hja : j a = 1)
    (Good : ℕ → Hypergraph V → Prop) (T s : ℕ)
    (D₂ D₃ D₄ epsilonCore N Pfloor testScale : ℝ) (L : ℕ → ℝ)
    (hd : 0 ≤ d) (htestScale : 0 ≤ testScale)
    (hL0 : ∀ k, 0 ≤ L k)
    (hspread : ∀ k, k < T → ∀ M, Good k M →
      HasExternalTestStatusSpread H R.regularized M (L k))
    (hstatusPart : ∀ k, k < T →
      (ellCert : ℝ) * L k ≤ testSourceJumpScale testScale d epsilonCore / 2)
    (hrawSquare : ∀ k, k < T →
      ((ellCert : ℝ) * L k) ^ 2 ≤
        testSourceVarianceScale testScale d epsilonCore N)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilonCore d N (k : ℝ) Pfloor 1 s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      testTotal (R.restrictedWeight a) H 1 *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
              1 s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - 1 - epsilonCore) / N)) ≤
        meanPartialTestGain (R.restrictedWeight a) H R.regularized 1 s M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized 1 s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      meanPartialTestGain (R.restrictedWeight a) H R.regularized 1 s M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized 1 s M ≤
        testTotal (R.restrictedWeight a) H 1 *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N 1 s (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
              1 s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - 1 - epsilonCore) / N)))
    (htrajectoryPart : ∀ k, k < T →
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H 1) 1 s k ≤
        testSourceJumpScale testScale d epsilonCore / 2) :
    ExternalTestSourceBudgets (R.restrictedWeight a) H R.regularized Good T
      D₂ D₃ D₄ Gamma epsilonCore d N Pfloor
      (testTotal (R.restrictedWeight a) H 1) 1 s
      (fun _ ↦ testSourceJumpScale testScale d epsilonCore)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
        (testTotal (R.restrictedWeight a) H 1) 1 s
        (fun _ ↦ testSourceVarianceScale testScale d epsilonCore N)) := by
  have hw : IsTrackable H R.regularized 1 ellCert d (epsRaw / 5)
      (R.restrictedWeight a) := by
    simpa only [hja] using R.survivingTrackable a
  have hW0 : 0 ≤ testTotal (R.restrictedWeight a) H 1 :=
    testTotal_nonneg hw.isTestFunction.nonneg H 1
  refine {
    arity := by norm_num
    weight_nonneg := hW0
    registry := hregistry
    meanLower := by simpa only [Nat.cast_one] using hmeanLower
    meanUpper := by simpa only [Nat.cast_one] using hmeanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · intro k hk M hgood o
    let B := (ellCert : ℝ) * L k
    have hB0 : 0 ≤ B := mul_nonneg (Nat.cast_nonneg _) (hL0 k)
    have hs := externalSingletonWeightSpread_of_statusSpread
      (R.restrictedWeight a) H R.regularized M
      ellCert hw.isTestFunction (hspread k hk M hgood)
    have hraw := singletonPartialTestChoice_abs_le_of_weightSpread
      s M hw hB0 hs o
    apply (externalTestEnvelopeStep_abs_le_of_observableJump
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H 1)
      (k : ℝ) 1 s M (greedyChoiceStep H R.regularized M o)
      (hregistry k hk M hgood) hW0 hraw).1.trans
    simpa only [B, externalTestTrajectoryJump] using
      (show B + externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H 1) 1 s k ≤
          testSourceJumpScale testScale d epsilonCore by
        linarith [hstatusPart k hk, htrajectoryPart k hk])
  · intro k hk M hgood o
    let B := (ellCert : ℝ) * L k
    have hB0 : 0 ≤ B := mul_nonneg (Nat.cast_nonneg _) (hL0 k)
    have hs := externalSingletonWeightSpread_of_statusSpread
      (R.restrictedWeight a) H R.regularized M
      ellCert hw.isTestFunction (hspread k hk M hgood)
    have hraw := singletonPartialTestChoice_abs_le_of_weightSpread
      s M hw hB0 hs o
    apply (externalTestEnvelopeStep_abs_le_of_observableJump
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H 1)
      (k : ℝ) 1 s M (greedyChoiceStep H R.regularized M o)
      (hregistry k hk M hgood) hW0 hraw).2.trans
    simpa only [B, externalTestTrajectoryJump] using
      (show B + externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H 1) 1 s k ≤
          testSourceJumpScale testScale d epsilonCore by
        linarith [hstatusPart k hk, htrajectoryPart k hk])
  · intro k hk M hgood
    let B := (ellCert : ℝ) * L k
    have hB0 : 0 ≤ B := mul_nonneg (Nat.cast_nonneg _) (hL0 k)
    have hs := externalSingletonWeightSpread_of_statusSpread
      (R.restrictedWeight a) H R.regularized M
      ellCert hw.isTestFunction (hspread k hk M hgood)
    have hchoice := singletonPartialTestChoice_abs_le_of_weightSpread
      s M hw hB0 hs
    have hraw := (meanSqPartialTestIncrement_le_sq_of_choice_abs_le
      (R.restrictedWeight a) H R.regularized 1 s M hchoice).trans
        (hrawSquare k hk)
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H 1)
      1 s k M (hregistry k hk M hgood) hW0 hraw).1
  · intro k hk M hgood
    let B := (ellCert : ℝ) * L k
    have hB0 : 0 ≤ B := mul_nonneg (Nat.cast_nonneg _) (hL0 k)
    have hs := externalSingletonWeightSpread_of_statusSpread
      (R.restrictedWeight a) H R.regularized M
      ellCert hw.isTestFunction (hspread k hk M hgood)
    have hchoice := singletonPartialTestChoice_abs_le_of_weightSpread
      s M hw hB0 hs
    have hraw := (meanSqPartialTestIncrement_le_sq_of_choice_abs_le
      (R.restrictedWeight a) H R.regularized 1 s M hchoice).trans
        (hrawSquare k hk)
    exact (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      (R.restrictedWeight a) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N
      (testTotal (R.restrictedWeight a) H 1)
      1 s k M (hregistry k hk M hgood) hW0 hraw).2

/-! The deterministic status cap exposed by the simultaneous degree and
internal-link corridors. -/

theorem availableBlockerChoices_subset_meeting_union_active
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {e : Finset V} (he : e ∈ availableEdges H C M) :
    availableBlockerChoices H C M e ⊆
      insert e
        (CFMRegularization.availableMeetingChoices
            (availableEdges H C M) e ∪
          activeConflictBlockers C (availableEdges H C M) M e) := by
  intro g hg
  have hg' := Finset.mem_filter.mp hg
  rcases hg' with ⟨hgA, hge | hbad⟩
  · exact Finset.mem_insert.mpr (Or.inl hge)
  · by_cases hdisj : Disjoint g e
    · have he' := mem_availableEdges.mp he
      have hgA' := mem_availableEdges.mp hgA
      have hmatch : IsMatching H (insert g (insert e M)) := by
        rw [isMatching_insert_iff]
        refine ⟨hgA'.1, he'.2.2.1, ?_⟩
        intro f hf hfg
        rcases Finset.mem_insert.mp hf with rfl | hfM
        · exact hdisj
        · exact (isMatching_insert_iff.mp hgA'.2.2.1).2.2 f hfM hfg
      have hnotfree : ¬ConflictFree C (insert g (insert e M)) := by
        intro hfree
        exact hbad ⟨hmatch, hfree⟩
      have hnotfree' : ¬ConflictFree C (insert e (insert g M)) := by
        simpa [Finset.insert_comm] using hnotfree
      have hconflict : g ∈ conflictBlockerChoices C M
          (availableEdges H C M) e := by
        exact Finset.mem_filter.mpr ⟨hgA, hdisj, hnotfree'⟩
      have hactive := conflictBlockerChoices_subset_activeConflictBlockers
        hCcard he hconflict
      exact Finset.mem_insert.mpr
        (Or.inr (Finset.mem_union.mpr (Or.inr hactive)))
    · exact Finset.mem_insert.mpr (Or.inr
        (Finset.mem_union.mpr (Or.inl
          (Finset.mem_filter.mpr ⟨hgA, hdisj⟩))))

theorem card_availableMeetingChoices_le_sum_degrees
    (A : Hypergraph V) (e : Finset V) :
    (CFMRegularization.availableMeetingChoices A e).card ≤
      ∑ v ∈ e, degree A v := by
  let star : V → Hypergraph V := fun v ↦ A.filter (v ∈ ·)
  have hsubset : CFMRegularization.availableMeetingChoices A e ⊆
      e.biUnion star := by
    intro g hg
    have hg' := Finset.mem_filter.mp hg
    obtain ⟨v, hvg, hve⟩ := Finset.not_disjoint_iff.mp hg'.2
    exact Finset.mem_biUnion.mpr
      ⟨v, hve, Finset.mem_filter.mpr ⟨hg'.1, hvg⟩⟩
  calc
    (CFMRegularization.availableMeetingChoices A e).card ≤
        (e.biUnion star).card := Finset.card_le_card hsubset
    _ ≤ ∑ v ∈ e, (star v).card := Finset.card_biUnion_le
    _ = ∑ v ∈ e, degree A v := by rfl

theorem card_availableMeetingChoices_le_eight_mul
    (A : Hypergraph V) {e : Finset V} (he8 : e.card = 8) {D : ℝ}
    (hdeg : ∀ v ∈ e, (degree A v : ℝ) ≤ D) :
    ((CFMRegularization.availableMeetingChoices A e).card : ℝ) ≤
      8 * D := by
  calc
    ((CFMRegularization.availableMeetingChoices A e).card : ℝ) ≤
        ((∑ v ∈ e, degree A v : ℕ) : ℝ) := by
      exact_mod_cast card_availableMeetingChoices_le_sum_degrees A e
    _ = ∑ v ∈ e, (degree A v : ℝ) := by norm_cast
    _ ≤ ∑ _v ∈ e, D := by
      apply Finset.sum_le_sum
      intro v hv
      exact hdeg v hv
    _ = 8 * D := by simp [he8]

theorem card_activeConflictBlockers_le_three_caps
    (C : ConflictSystem V) (A M : Hypergraph V) (e : Finset V)
    {U₁ U₂ U₃ : ℝ}
    (h₁ : ((partialFamily (conflictLinkLayer C e 1) A M 1).card : ℝ) ≤ U₁)
    (h₂ : ((partialFamily (conflictLinkLayer C e 2) A M 1).card : ℝ) ≤ U₂)
    (h₃ : ((partialFamily (conflictLinkLayer C e 3) A M 1).card : ℝ) ≤ U₃) :
    ((activeConflictBlockers C A M e).card : ℝ) ≤
      U₁ + 2 * U₂ + 3 * U₃ := by
  calc
    ((activeConflictBlockers C A M e).card : ℝ) ≤
        ((∑ q ∈ Finset.Icc 1 3,
          q * (partialFamily (conflictLinkLayer C e q) A M 1).card : ℕ) : ℝ) := by
      exact_mod_cast card_activeConflictBlockers_le C A M e
    _ = ((partialFamily (conflictLinkLayer C e 1) A M 1).card : ℝ) +
        2 * ((partialFamily (conflictLinkLayer C e 2) A M 1).card : ℝ) +
        3 * ((partialFamily (conflictLinkLayer C e 3) A M 1).card : ℝ) := by
      norm_num [Finset.sum_Icc_succ_top]
    _ ≤ U₁ + 2 * U₂ + 3 * U₃ := by linarith

theorem hasExternalTestStatusSpread_of_degree_internalCaps
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hH8 : IsUniform H 8)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {D U₁ U₂ U₃ : ℝ}
    (hdegree : ∀ e ∈ availableEdges H C M, ∀ v ∈ e,
      (degree (availableEdges H C M) v : ℝ) ≤ D)
    (h₁ : ∀ e ∈ availableEdges H C M,
      ((partialFamily (conflictLinkLayer C e 1)
        (availableEdges H C M) M 1).card : ℝ) ≤ U₁)
    (h₂ : ∀ e ∈ availableEdges H C M,
      ((partialFamily (conflictLinkLayer C e 2)
        (availableEdges H C M) M 1).card : ℝ) ≤ U₂)
    (h₃ : ∀ e ∈ availableEdges H C M,
      ((partialFamily (conflictLinkLayer C e 3)
        (availableEdges H C M) M 1).card : ℝ) ≤ U₃) :
    HasExternalTestStatusSpread H C M
      (1 + 8 * D + (U₁ + 2 * U₂ + 3 * U₃)) := by
  intro e he
  have hblockSub := availableBlockerChoices_subset_meeting_union_active
    hCcard he
  have hblockCard :
      ((availableBlockerChoices H C M e).card : ℝ) ≤
        1 + 8 * D + (U₁ + 2 * U₂ + 3 * U₃) := by
    calc
      ((availableBlockerChoices H C M e).card : ℝ) ≤
          ((insert e
            (CFMRegularization.availableMeetingChoices
                (availableEdges H C M) e ∪
              activeConflictBlockers C (availableEdges H C M) M e)).card : ℕ) := by
        exact_mod_cast Finset.card_le_card hblockSub
      _ ≤ 1 +
          ((CFMRegularization.availableMeetingChoices
              (availableEdges H C M) e).card : ℝ) +
          ((activeConflictBlockers C (availableEdges H C M) M e).card : ℝ) := by
        have hi := Finset.card_insert_le e
          (CFMRegularization.availableMeetingChoices
              (availableEdges H C M) e ∪
            activeConflictBlockers C (availableEdges H C M) M e)
        have hu := Finset.card_union_le
          (CFMRegularization.availableMeetingChoices
            (availableEdges H C M) e)
          (activeConflictBlockers C (availableEdges H C M) M e)
        norm_cast
        omega
      _ ≤ 1 + 8 * D + (U₁ + 2 * U₂ + 3 * U₃) := by
        have hm := card_availableMeetingChoices_le_eight_mul
          (availableEdges H C M) (hH8 e (availableEdges_subset H C M he))
          (hdegree e he)
        have hc := card_activeConflictBlockers_le_three_caps
          C (availableEdges H C M) M e (h₁ e he) (h₂ e he) (h₃ e he)
        linarith
  have hblockSubset : availableBlockerChoices H C M e ⊆
      availableEdges H C M := by
    intro f hf
    exact (Finset.mem_filter.mp hf).1
  rw [availableEdges_insert_eq_sdiff_blockers,
    Finset.sdiff_sdiff_eq_self hblockSubset]
  exact hblockCard

noncomputable def indexedRegularizedStatusCap
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (k : ℕ) : ℝ :=
  1 + 8 * (CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
      CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)) +
    (D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ)) +
      2 * (D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ))) +
      3 * (D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ))))

theorem indexedRegularizedGreedyGood_statusSpread
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ)
    (j : io → ℕ) (w : io → TestWeight V)
    (hH8 : IsUniform H 8)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H C
        D₂ D₃ D₄ Gamma epsilon d N j w) k M) :
    HasExternalTestStatusSpread H C M
      (indexedRegularizedStatusCap D₂ D₃ D₄ Gamma epsilon d N k) := by
  let degreeCap :=
    CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) +
      CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ)
  let U₁ := D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) +
    CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 1 1 (k : ℝ))
  let U₂ := D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) +
    CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 2 1 (k : ℝ))
  let U₃ := D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) +
    CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N 3 1 (k : ℝ))
  change HasExternalTestStatusSpread H C M
    (1 + 8 * degreeCap + (U₁ + 2 * U₂ + 3 * U₃))
  apply hasExternalTestStatusSpread_of_degree_internalCaps
    (M := M) hH8 hCcard
  · intro e he v hve
    have hvU : v ∈ uncoveredVertices H M :=
      vertexFinset_availableEdges_subset_uncovered H C M
        (mem_vertexFinset.mpr ⟨e, he, hve⟩)
    let v' : ActualHostVertex H :=
      ⟨v, mem_vertexFinset.mpr ⟨e, availableEdges_subset H C M he, hve⟩⟩
    have hv := (indexedRegularizedGreedyGood_degree
      H C D₂ D₃ D₄ Gamma epsilon d N j w hgood v').1
    have hv' : degreeUpperError H C v D₂ D₃ D₄ Gamma epsilon d N k M < 0 :=
      hv.resolve_left (fun h ↦ h hvU)
    unfold degreeUpperError at hv'
    dsimp only [degreeCap]
    linarith
  · intro e he
    let f : {e : Finset V // e ∈ H} := ⟨e, availableEdges_subset H C M he⟩
    have hs := indexedRegularizedGreedyGood_internalOpenLinks
      H C D₂ D₃ D₄ Gamma epsilon d N j w hgood f
    exact (internalConflictLinkCorridors_bounds H C e
      D₂ D₃ D₄ Gamma epsilon d N D₂ 1 1 k M he hs.1.1 hs.1.2).2
  · intro e he
    let f : {e : Finset V // e ∈ H} := ⟨e, availableEdges_subset H C M he⟩
    have hs := indexedRegularizedGreedyGood_internalOpenLinks
      H C D₂ D₃ D₄ Gamma epsilon d N j w hgood f
    exact (internalConflictLinkCorridors_bounds H C e
      D₂ D₃ D₄ Gamma epsilon d N D₃ 2 1 k M he hs.2.1.1 hs.2.1.2).2
  · intro e he
    let f : {e : Finset V // e ∈ H} := ⟨e, availableEdges_subset H C M he⟩
    have hs := indexedRegularizedGreedyGood_internalOpenLinks
      H C D₂ D₃ D₄ Gamma epsilon d N j w hgood f
    exact (internalConflictLinkCorridors_bounds H C e
      D₂ D₃ D₄ Gamma epsilon d N D₄ 3 1 k M he hs.2.2.1 hs.2.2.2).2

theorem CFMRegularization.RegularizationCertificate.indexedGood_statusSpread
    {io : Type*} [Fintype io]
    {H : Hypergraph V} {C : ConflictSystem V} {d epsRaw Gamma : ℝ}
    {ellCert : ℕ}
    {j : io → ℕ} {w : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (hH8 : IsUniform H 8)
    (D₂ D₃ D₄ epsilonCore N : ℝ) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H R.regularized
        D₂ D₃ D₄ Gamma epsilonCore d N j R.restrictedWeight) k M) :
    HasExternalTestStatusSpread H R.regularized M
      (indexedRegularizedStatusCap
        D₂ D₃ D₄ Gamma epsilonCore d N k) := by
  exact indexedRegularizedGreedyGood_statusSpread
    H R.regularized D₂ D₃ D₄ Gamma epsilonCore d N
      j R.restrictedWeight
    hH8 (fun c hc ↦ R.bounded.conflict_card hc) hgood

/-! Crude but unconditional internal-link raw budgets.  They use the whole
link layer as a cap; no trackability claim for link-indicator weights is
needed. -/

theorem partialFamily_card_le_family_card
    (X : ConflictSystem V) (A M : Hypergraph V) (s : ℕ) :
    (partialFamily X A M s).card ≤ X.card := by
  apply Finset.card_le_card
  intro Q hQ
  exact (mem_partialFamily.mp hQ).1

theorem conflictLinkObservable_sub_abs_le_card
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f : Finset V) (q s : ℕ)
    (M M' : Hypergraph V) :
    |partialTestObservable (conflictLinkTestWeight C f q) H C q s M' -
        partialTestObservable (conflictLinkTestWeight C f q) H C q s M| ≤
      (conflictLinkLayer C f q).card := by
  rw [partialTestObservable_conflictLinkTestWeight hC,
    partialTestObservable_conflictLinkTestWeight hC]
  have hM := partialFamily_card_le_family_card
    (conflictLinkLayer C f q) (availableEdges H C M) M s
  have hM' := partialFamily_card_le_family_card
    (conflictLinkLayer C f q) (availableEdges H C M') M' s
  have hMreal :
      ((partialFamily (conflictLinkLayer C f q)
        (availableEdges H C M) M s).card : ℝ) ≤
          (conflictLinkLayer C f q).card := by
    exact_mod_cast hM
  have hM'real :
      ((partialFamily (conflictLinkLayer C f q)
        (availableEdges H C M') M' s).card : ℝ) ≤
          (conflictLinkLayer C f q).card := by
    exact_mod_cast hM'
  have hM0 : 0 ≤
      ((partialFamily (conflictLinkLayer C f q)
        (availableEdges H C M) M s).card : ℝ) := by positivity
  have hM'0 : 0 ≤
      ((partialFamily (conflictLinkLayer C f q)
        (availableEdges H C M') M' s).card : ℝ) := by positivity
  rw [abs_le]
  constructor <;> linarith

theorem conflictLinkLayer_card_le_layerMaxDegree
    {H : Hypergraph V} {C : ConflictSystem V}
    (f : Finset V) (hf : f ∈ H) (q : ℕ) :
    ((conflictLinkLayer C f q).card : ℝ) ≤
      (CFMRegularization.layerMaxDegree H C (q + 1) : ℝ) := by
  rw [CFMRegularization.card_conflictLinkLayer_eq_degree_layer]
  exact_mod_cast CFMRegularization.degree_layer_le_layerMaxDegree
    (j := q + 1) hf

theorem CFMRegularization.RegularizationCertificate.linkLayer_card_upper
    {io : Type*} [Fintype io]
    {H : Hypergraph V} {C : ConflictSystem V} {d eps Gamma : ℝ}
    {ellCert : ℕ}
    {publicJ : io → ℕ} {publicW : io → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ellCert publicJ publicW)
    (hd : 1 ≤ d) {f : Finset V} (hf : f ∈ H)
    {q : ℕ} (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    ((conflictLinkLayer R.regularized f q).card : ℝ) ≤
      (3 * Gamma) * Real.rpow d (q : ℝ) := by
  apply (conflictLinkLayer_card_le_layerMaxDegree f hf q).trans
  have h := R.bounded.layerMaxDegree_upper hd
    (r := q + 1) (by omega) (by omega)
  simpa only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right] using h

theorem InternalConflictLinkSourceBudgets.mono
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N Pfloor scale : ℝ) (q s : ℕ)
    (jump jump' variance variance' : ℕ → ℝ)
    (B : InternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N Pfloor scale q s jump variance)
    (hjump : ∀ k, k < T → jump k ≤ jump' k)
    (hvariance : ∀ k, k < T → variance k ≤ variance' k) :
    InternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N Pfloor scale q s jump' variance' := by
  refine {
    scale_nonneg := B.scale_nonneg
    registry := B.registry
    meanLower := B.meanLower
    meanUpper := B.meanUpper
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · intro k hk M hgood hfactive o
    exact (B.upperJump k hk M hgood hfactive o).trans (hjump k hk)
  · intro k hk M hgood hfactive o
    exact (B.lowerJump k hk M hgood hfactive o).trans (hjump k hk)
  · intro k hk M hgood hfactive
    exact (B.upperSquare k hk M hgood hfactive).trans (hvariance k hk)
  · intro k hk M hgood hfactive
    exact (B.lowerSquare k hk M hgood hfactive).trans (hvariance k hk)

theorem internalConflictLinkSourceBudgets_of_certificateLinkCap
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ) (publicJ : io → ℕ)
    (publicW : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert publicJ publicW)
    (f : Finset V) (hf : f ∈ H)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ epsilonCore N Pfloor scale : ℝ) (q s : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3) (hscale : 0 ≤ scale)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilonCore d N (k : ℝ) Pfloor q s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H R.regularized M →
      scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) +
          2 * (d ^ ((s : ℝ) - q - epsilonCore) / N)) ≤
        meanPartialTestGain (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M -
          meanPartialTestLoss (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H R.regularized M →
      meanPartialTestGain (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M -
          meanPartialTestLoss (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M ≤
        scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) -
          2 * (d ^ ((s : ℝ) - q - epsilonCore) / N))) :
    let linkCap :=
      (CFMRegularization.layerMaxDegree H R.regularized (q + 1) : ℝ)
    InternalConflictLinkSourceBudgets H R.regularized f Good T
      D₂ D₃ D₄ Gamma epsilonCore d N Pfloor scale q s
      (fun k ↦ linkCap +
        externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          scale q s k)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
        scale q s (fun _ ↦ linkCap ^ 2)) := by
  dsimp only
  let linkCap :=
    (CFMRegularization.layerMaxDegree H R.regularized (q + 1) : ℝ)
  have hcap0 : 0 ≤ linkCap := Nat.cast_nonneg _
  have hlink : ((conflictLinkLayer R.regularized f q).card : ℝ) ≤
      linkCap := conflictLinkLayer_card_le_layerMaxDegree f hf q
  refine {
    scale_nonneg := hscale
    registry := hregistry
    meanLower := ?_
    meanUpper := ?_
    upperJump := ?_
    lowerJump := ?_
    upperSquare := ?_
    lowerSquare := ?_ }
  · exact hmeanLower
  · exact hmeanUpper
  · intro k hk M hgood hfactive o
    have hraw := (conflictLinkObservable_sub_abs_le_card
      R.isConflictSystem f q s M (greedyChoiceStep H R.regularized M o)).trans hlink
    rw [activeInternalConflictLinkUpperStep_eq_externalTestUpperStep
      R.isConflictSystem f D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ)
        q s M (greedyChoiceStep H R.regularized M o) hfactive]
    simpa only [externalTestTrajectoryJump] using
      (externalTestEnvelopeStep_abs_le_of_observableJump
      (conflictLinkTestWeight R.regularized f q) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ) q s M
      (greedyChoiceStep H R.regularized M o) (hregistry k hk M hgood)
      hscale hraw).1
  · intro k hk M hgood hfactive o
    have hraw := (conflictLinkObservable_sub_abs_le_card
      R.isConflictSystem f q s M (greedyChoiceStep H R.regularized M o)).trans hlink
    rw [activeInternalConflictLinkLowerStep_eq_externalTestLowerStep
      R.isConflictSystem f D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ)
        q s M (greedyChoiceStep H R.regularized M o) hfactive]
    simpa only [externalTestTrajectoryJump] using
      (externalTestEnvelopeStep_abs_le_of_observableJump
      (conflictLinkTestWeight R.regularized f q) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ) q s M
      (greedyChoiceStep H R.regularized M o) (hregistry k hk M hgood)
      hscale hraw).2
  · intro k hk M hgood hfactive
    have hchoice : ∀ o : GreedyChoice H,
        |partialTestObservable (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s (greedyChoiceStep H R.regularized M o) -
          partialTestObservable (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M| ≤ linkCap := by
      intro o
      exact (conflictLinkObservable_sub_abs_le_card R.isConflictSystem
        f q s M (greedyChoiceStep H R.regularized M o)).trans hlink
    have hrawSq := meanSqPartialTestIncrement_le_sq_of_choice_abs_le
      (conflictLinkTestWeight R.regularized f q) H R.regularized
      q s M hchoice
    have hext := (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      (conflictLinkTestWeight R.regularized f q) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N scale q s k M
      (hregistry k hk M hgood) hscale hrawSq).1
    have heq :
        (fun M' ↦ activeInternalConflictLinkUpperStep H R.regularized f
          D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ) q s M M') =
        (fun M' ↦ externalTestUpperStep
          (conflictLinkTestWeight R.regularized f q) H R.regularized
          D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ) q s M M') := by
      funext M'
      exact activeInternalConflictLinkUpperStep_eq_externalTestUpperStep
        R.isConflictSystem f D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ)
          q s M M' hfactive
    simpa only [heq] using hext
  · intro k hk M hgood hfactive
    have hchoice : ∀ o : GreedyChoice H,
        |partialTestObservable (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s (greedyChoiceStep H R.regularized M o) -
          partialTestObservable (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M| ≤ linkCap := by
      intro o
      exact (conflictLinkObservable_sub_abs_le_card R.isConflictSystem
        f q s M (greedyChoiceStep H R.regularized M o)).trans hlink
    have hrawSq := meanSqPartialTestIncrement_le_sq_of_choice_abs_le
      (conflictLinkTestWeight R.regularized f q) H R.regularized
      q s M hchoice
    have hext := (externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      (conflictLinkTestWeight R.regularized f q) H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N scale q s k M
      (hregistry k hk M hgood) hscale hrawSq).2
    have heq :
        (fun M' ↦ activeInternalConflictLinkLowerStep H R.regularized f
          D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ) q s M M') =
        (fun M' ↦ externalTestLowerStep
          (conflictLinkTestWeight R.regularized f q) H R.regularized
          D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ) q s M M') := by
      funext M'
      exact activeInternalConflictLinkLowerStep_eq_externalTestLowerStep
        R.isConflictSystem f D₂ D₃ D₄ Gamma epsilonCore d N scale (k : ℝ)
          q s M M' hfactive
    simpa only [heq] using hext

theorem internalConflictLinkSourceBudgets_of_regularizedBound
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ) (publicJ : io → ℕ)
    (publicW : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert publicJ publicW)
    (f : Finset V) (hf : f ∈ H)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ epsilonCore N Pfloor scale : ℝ) (q s : ℕ)
    (hd : 1 ≤ d) (hq1 : 1 ≤ q) (hq3 : q ≤ 3)
    (hscale : 0 ≤ scale)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilonCore d N (k : ℝ) Pfloor q s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H R.regularized M →
      scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) +
          2 * (d ^ ((s : ℝ) - q - epsilonCore) / N)) ≤
        meanPartialTestGain (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M -
          meanPartialTestLoss (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      f ∈ availableEdges H R.regularized M →
      meanPartialTestGain (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M -
          meanPartialTestLoss (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M ≤
        scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) -
          2 * (d ^ ((s : ℝ) - q - epsilonCore) / N))) :
    let linkCap := (3 * Gamma) * Real.rpow d (q : ℝ)
    InternalConflictLinkSourceBudgets H R.regularized f Good T
      D₂ D₃ D₄ Gamma epsilonCore d N Pfloor scale q s
      (fun k ↦ linkCap +
        externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          scale q s k)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
        scale q s (fun _ ↦ linkCap ^ 2)) := by
  dsimp only
  let exactCap :=
    (CFMRegularization.layerMaxDegree H R.regularized (q + 1) : ℝ)
  let linkCap := (3 * Gamma) * Real.rpow d (q : ℝ)
  have hcap : exactCap ≤ linkCap := by
    have h := R.bounded.layerMaxDegree_upper hd
      (r := q + 1) (by omega) (by omega)
    dsimp only [exactCap, linkCap]
    simpa only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right] using h
  have hexact0 : 0 ≤ exactCap := by
    exact Nat.cast_nonneg _
  have hlink0 : 0 ≤ linkCap := hexact0.trans hcap
  have hsquare : exactCap ^ 2 ≤ linkCap ^ 2 :=
    (sq_le_sq₀ hexact0 hlink0).2 hcap
  have B : InternalConflictLinkSourceBudgets H R.regularized f Good T
      D₂ D₃ D₄ Gamma epsilonCore d N Pfloor scale q s
      (fun k ↦ exactCap +
        externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          scale q s k)
      (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
        scale q s (fun _ ↦ exactCap ^ 2)) := by
    simpa only [exactCap] using
      internalConflictLinkSourceBudgets_of_certificateLinkCap
        H C d epsRaw Gamma ellCert publicJ publicW R f hf Good T
        D₂ D₃ D₄ epsilonCore N Pfloor scale q s hq1 hq3 hscale
        hregistry hmeanLower hmeanUpper
  apply InternalConflictLinkSourceBudgets.mono
    H R.regularized f Good T
    D₂ D₃ D₄ Gamma epsilonCore d N Pfloor scale q s
    (fun k ↦ exactCap +
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
        scale q s k)
    (fun k ↦ linkCap +
      externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
        scale q s k)
    (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
      scale q s (fun _ ↦ exactCap ^ 2))
    (externalTestSharpVariance D₂ D₃ D₄ Gamma epsilonCore d N
      scale q s (fun _ ↦ linkCap ^ 2)) B
  · intro k hk
    simpa only [add_comm] using
      (add_le_add_right hcap
        (externalTestTrajectoryJump D₂ D₃ D₄ Gamma epsilonCore d N
          scale q s k))
  · intro k hk
    dsimp only [externalTestSharpVariance]
    linarith


/-! ## Deterministic degree source estimates from the certificate -/

/-- The one-link partial family injects into the exact open blocker set.
The only structural input is that each conflict itself is a matching. -/
theorem partialLinkOne_card_le_openConflictCount
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {f : Finset V}
    (hmatching : ∀ c ∈ C, IsMatching H c) :
    (partialFamily (conflictLinkLayer C f 1) A M 1).card ≤
      openConflictCount C A M f := by
  let F := partialFamily (conflictLinkLayer C f 1) A M 1
  have hcard : ∀ Q ∈ F, Q.card = 1 := by
    intro Q hQ
    exact (mem_conflictLinkLayer.mp (mem_partialFamily.mp hQ).1).2
  have hpair : (↑F : Set (Hypergraph V)).PairwiseDisjoint id := by
    intro Q hQ Q' hQ' hne
    obtain ⟨a, rfl⟩ := Finset.card_eq_one.mp (hcard Q hQ)
    obtain ⟨b, rfl⟩ := Finset.card_eq_one.mp (hcard Q' hQ')
    have hab : a ≠ b := by
      intro hab
      apply hne
      simp [hab]
    change Disjoint {a} {b}
    exact Finset.disjoint_singleton_left.mpr (by simpa using hab)
  have hcardUnion : (F.biUnion id).card = F.card := by
    rw [Finset.card_biUnion hpair]
    calc
      ∑ Q ∈ F, Q.card = ∑ _Q ∈ F, 1 := by
        apply Finset.sum_congr rfl
        intro Q hQ
        exact hcard Q hQ
      _ = F.card := by simp
  have hsub : F.biUnion id ⊆
      (activeConflictBlockers C A M f).filter
        (fun e ↦ e ∈ A ∧ Disjoint e f) := by
    intro e he
    obtain ⟨Q, hQF, heQ⟩ := Finset.mem_biUnion.mp he
    have hQcard := hcard Q hQF
    obtain ⟨a, hQa⟩ := Finset.card_eq_one.mp hQcard
    have hae : a = e := by
      rw [hQa] at heQ
      exact (Finset.mem_singleton.mp heQ).symm
    subst a
    have heA : e ∈ A := by
      have hQA := (mem_partialFamily.mp hQF).2.1
      rw [hQa] at hQA
      by_contra heA
      have hempty : {e} ∩ A = ∅ := by simp [heA]
      rw [hempty] at hQA
      simp at hQA
    have hQlink := (mem_partialFamily.mp hQF).1
    obtain ⟨⟨c, hcC, hfc, hcErase⟩, _⟩ :=
      mem_conflictLinkLayer.mp hQlink
    have heErase : e ∈ c.erase f := by
      rw [hcErase]
      simpa [hQa]
    have hef : e ≠ f := (Finset.mem_erase.mp heErase).1
    have hec : e ∈ c := (Finset.mem_erase.mp heErase).2
    have hedisj : Disjoint e f :=
      (hmatching c hcC).2 hec hfc hef
    have hactive : e ∈ activeConflictBlockers C A M f := by
      unfold activeConflictBlockers
      exact Finset.mem_biUnion.mpr
        ⟨1, by norm_num,
          Finset.mem_biUnion.mpr ⟨Q, hQF, by simpa [hQa]⟩⟩
    exact Finset.mem_filter.mpr ⟨hactive, heA, hedisj⟩
  rw [openConflictCount, ← hcardUnion]
  exact Finset.card_le_card hsub

/-- Dropping all rank-two-or-higher partial links gives a deterministic
spread cap: the rank-one family already injects into the exact open set. -/
theorem internalOpenLinkMass_sub_openConflictCount_le_higherLinks
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {f : Finset V}
    (hmatching : ∀ c ∈ C, IsMatching H c) :
    (internalOpenLinkMass C A M f : ℝ) -
        (openConflictCount C A M f : ℝ) ≤
      ((partialFamily (conflictLinkLayer C f 2) A M 1).card : ℝ) +
        ((partialFamily (conflictLinkLayer C f 3) A M 1).card : ℝ) := by
  have h₁ := partialLinkOne_card_le_openConflictCount
    (H := H) (A := A) (M := M) (f := f) hmatching
  have h₁R :
      ((partialFamily (conflictLinkLayer C f 1) A M 1).card : ℝ) ≤
        (openConflictCount C A M f : ℝ) := by
    exact_mod_cast h₁
  unfold internalOpenLinkMass
  norm_num only [Nat.cast_add]
  linarith

/-- Active conflict blockers through a fixed host vertex split into the C4
rank-two term and the two higher one-open partial-link families. -/
theorem card_activeConflictBlockers_available_through_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {A M : Hypergraph V} {e : Finset V} (hAH : A ⊆ H) (v : V) :
    (((activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f)).card : ℝ) ≤
      (CFMRegularization.conditionC4Count H C e v : ℝ) +
        ((partialFamily (conflictLinkLayer C e 2) A M 1).card : ℝ) +
        ((partialFamily (conflictLinkLayer C e 3) A M 1).card : ℝ) := by
  let B : ℕ → Hypergraph V := fun q ↦
    ((partialFamily (conflictLinkLayer C e q) A M 1).biUnion id).filter
      (fun f ↦ f ∈ A ∧ v ∈ f)
  have hsub : (activeConflictBlockers C A M e).filter
      (fun f ↦ f ∈ A ∧ v ∈ f) ⊆ B 1 ∪ B 2 ∪ B 3 := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    unfold activeConflictBlockers at hf'
    obtain ⟨q, hq, hfq⟩ := Finset.mem_biUnion.mp hf'.1
    have hqcases : q = 1 ∨ q = 2 ∨ q = 3 := by
      simp only [Finset.mem_Icc] at hq
      omega
    rcases hqcases with rfl | rfl | rfl
    · exact Finset.mem_union.mpr (Or.inl (Finset.mem_union.mpr (Or.inl
        (Finset.mem_filter.mpr ⟨by simpa only [id_eq] using hfq, hf'.2⟩))))
    · exact Finset.mem_union.mpr (Or.inl (Finset.mem_union.mpr (Or.inr
        (Finset.mem_filter.mpr ⟨by simpa only [id_eq] using hfq, hf'.2⟩))))
    · exact Finset.mem_union.mpr (Or.inr
        (Finset.mem_filter.mpr ⟨by simpa only [id_eq] using hfq, hf'.2⟩))
  have hB₁ : B 1 ⊆
      (CFMRegularization.twoConflictNeighbors H C e).filter (v ∈ ·) := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    obtain ⟨Q, hQpartial, hfQ⟩ := Finset.mem_biUnion.mp hf'.1
    have hQlink := (mem_partialFamily.mp hQpartial).1
    have hQcard := (mem_conflictLinkLayer.mp hQlink).2
    obtain ⟨a, hQa⟩ := Finset.card_eq_one.mp hQcard
    have haf : a = f := by
      rw [hQa] at hfQ
      exact (Finset.mem_singleton.mp hfQ).symm
    subst a
    obtain ⟨⟨c, hcC, hec, hcErase⟩, _⟩ :=
      mem_conflictLinkLayer.mp hQlink
    have hfErase : f ∈ c.erase e := by
      rw [hcErase]
      simpa [hQa]
    have hfe : f ≠ e := (Finset.mem_erase.mp hfErase).1
    have hfc : f ∈ c := (Finset.mem_erase.mp hfErase).2
    have hcEq : c = {e, f} := by
      calc
        c = insert e (c.erase e) := (Finset.insert_erase hec).symm
        _ = insert e Q := by rw [hcErase]
        _ = {e, f} := by rw [hQa]
    have htwo : f ∈ CFMRegularization.twoConflictNeighbors H C e := by
      apply Finset.mem_filter.mpr
      exact ⟨hAH hf'.2.1, hfe, by
        rw [← hcEq]
        exact mem_conflictLayer.mpr
          ⟨hcC, by rw [hcEq]; simp [Ne.symm hfe]⟩⟩
    exact Finset.mem_filter.mpr ⟨htwo, hf'.2.2⟩
  have hcard₁ : ((B 1).card : ℝ) ≤
      CFMRegularization.conditionC4Count H C e v := by
    exact_mod_cast Finset.card_le_card hB₁
  have hcard₂ : ((B 2).card : ℝ) ≤
      (partialFamily (conflictLinkLayer C e 2) A M 1).card := by
    exact_mod_cast card_partialFamily_union_filter_le
      (conflictLinkLayer C e 2) A M (v ∈ ·)
  have hcard₃ : ((B 3).card : ℝ) ≤
      (partialFamily (conflictLinkLayer C e 3) A M 1).card := by
    exact_mod_cast card_partialFamily_union_filter_le
      (conflictLinkLayer C e 3) A M (v ∈ ·)
  calc
    (((activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f)).card : ℝ) ≤
        ((B 1 ∪ B 2 ∪ B 3).card : ℕ) := by
      exact_mod_cast Finset.card_le_card hsub
    _ ≤ ((B 1).card : ℝ) + (B 2).card + (B 3).card := by
      exact_mod_cast
        calc
          (B 1 ∪ B 2 ∪ B 3).card ≤
              (B 1 ∪ B 2).card + (B 3).card :=
            Finset.card_union_le (B 1 ∪ B 2) (B 3)
          _ ≤ ((B 1).card + (B 2).card) + (B 3).card :=
            Nat.add_le_add_right (Finset.card_union_le (B 1) (B 2)) _
    _ ≤ (CFMRegularization.conditionC4Count H C e v : ℝ) +
        ((partialFamily (conflictLinkLayer C e 2) A M 1).card : ℝ) +
        ((partialFamily (conflictLinkLayer C e 3) A M 1).card : ℝ) := by
      linarith

/-- Conflict-induced loss at `v` is a subfamily of the active blockers
which are both available and pass through `v`. -/
theorem conflictLostDegree_le_C4_add_higherLinks
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    {e : Finset V} (he : e ∈ availableEdges H C M) (v : V) :
    (conflictLostDegree C M (availableEdges H C M) e v : ℝ) ≤
      (CFMRegularization.conditionC4Count H C e v : ℝ) +
        ((partialFamily (conflictLinkLayer C e 2)
          (availableEdges H C M) M 1).card : ℝ) +
        ((partialFamily (conflictLinkLayer C e 3)
          (availableEdges H C M) M 1).card : ℝ) := by
  let A := availableEdges H C M
  have hsub : (disjointResidual A e).filter
      (fun f ↦ v ∈ f ∧ ¬ConflictFree C (insert f (insert e M))) ⊆
      (activeConflictBlockers C A M e).filter
        (fun f ↦ f ∈ A ∧ v ∈ f) := by
    intro f hf
    have hf' := Finset.mem_filter.mp hf
    have hfres := Finset.mem_filter.mp hf'.1
    have hblock : f ∈ conflictBlockerChoices C M A e :=
      Finset.mem_filter.mpr
        ⟨hfres.1, hfres.2,
          by simpa [Finset.insert_comm] using hf'.2.2⟩
    exact Finset.mem_filter.mpr
      ⟨conflictBlockerChoices_subset_activeConflictBlockers hCcard he hblock,
        hfres.1, hf'.2.1⟩
  calc
    (conflictLostDegree C M A e v : ℝ) ≤
        (((activeConflictBlockers C A M e).filter
          (fun f ↦ f ∈ A ∧ v ∈ f)).card : ℕ) := by
      exact_mod_cast Finset.card_le_card hsub
    _ ≤ (CFMRegularization.conditionC4Count H C e v : ℝ) +
        ((partialFamily (conflictLinkLayer C e 2) A M 1).card : ℝ) +
        ((partialFamily (conflictLinkLayer C e 3) A M 1).card : ℝ) :=
      card_activeConflictBlockers_available_through_le
        (availableEdges_subset H C M) v

theorem missLostDegree_available_real_le_eight_codegree
    {H : Hypergraph V} (hH8 : IsUniform H 8)
    {codegreeHi : ℝ}
    (hcodegree : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ codegreeHi)
    (C : ConflictSystem V) (M : Hypergraph V)
    {e : Finset V} (he : e ∈ availableEdges H C M)
    {v : V} (hve : v ∉ e) :
    (missLostDegree (availableEdges H C M) e v : ℝ) ≤
      8 * codegreeHi := by
  let A := availableEdges H C M
  have hmiss := missLostDegree_le_sum_codegree A hve
  calc
    (missLostDegree A e v : ℝ) ≤
        (∑ x ∈ e, codegree A {v, x} : ℕ) := by
      exact_mod_cast hmiss
    _ = ∑ x ∈ e, (codegree A {v, x} : ℝ) := by norm_cast
    _ ≤ ∑ _x ∈ e, codegreeHi := by
      apply Finset.sum_le_sum
      intro x hx
      have hxv : x ≠ v := by
        intro hxv
        exact hve (hxv ▸ hx)
      calc
        (codegree A {v, x} : ℝ) ≤ (codegree H {v, x} : ℕ) := by
          exact_mod_cast codegree_mono_hypergraph
            (availableEdges_subset H C M) {v, x}
        _ ≤ codegreeHi := hcodegree {v, x} (by simp [hxv.symm])
    _ = 8 * codegreeHi := by
      simp [hH8 e (availableEdges_subset H C M he)]

noncomputable def certificateHigherLinkCap
    (D₂ D₃ D₄ Gamma epsilonCore d N : ℝ) (k : ℕ) : ℝ :=
  D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N 2 1 (k : ℝ)) +
    D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N 3 1 (k : ℝ))

noncomputable def certificateDegreeMissJumpCap
    (D₂ D₃ D₄ Gamma epsRaw epsilonCore d N codegreeHi : ℝ)
    (k : ℕ) : ℝ :=
  8 * codegreeHi + Real.rpow d (1 - epsRaw / 4) +
    certificateHigherLinkCap D₂ D₃ D₄ Gamma epsilonCore d N k

/-- The certificate's C4 estimate controls rank-two conflict loss, while
the indexed rank-three/four one-open corridors control the remaining loss. -/
theorem availableDegreeLoss_miss_le_certificateCap
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N codegreeHi : ℝ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ codegreeHi)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H R.regularized
        D₂ D₃ D₄ Gamma epsilonCore d N j R.restrictedWeight) k M)
    (hM : IsConflictFreeMatching H R.regularized M)
    {e : Finset V} (he : e ∈ availableEdges H R.regularized M)
    (v : V) (hve : v ∉ e) :
    (availableDegreeLoss H R.regularized M e v : ℝ) ≤
      certificateDegreeMissJumpCap
        D₂ D₃ D₄ Gamma epsRaw epsilonCore d N codegreeHi k := by
  have hHnonempty : ∀ f ∈ H, f.Nonempty := by
    intro f hf
    exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
  have hsplit := missAvailableDegreeLoss_eq_miss_add_conflictLost
    hHnonempty hM he v
  have hsplitR :
      (availableDegreeLoss H R.regularized M e v : ℝ) =
        (missLostDegree (availableEdges H R.regularized M) e v : ℝ) +
          (conflictLostDegree R.regularized M
            (availableEdges H R.regularized M) e v : ℝ) := by
    rw [missAvailableDegreeLoss, if_neg hve] at hsplit
    exact_mod_cast hsplit
  have hgeom := missLostDegree_available_real_le_eight_codegree
    hH8 hcodegree R.regularized M he hve
  have hconf := conflictLostDegree_le_C4_add_higherLinks
    (fun c hc ↦ R.bounded.conflict_card hc) he v
  let f : {e : Finset V // e ∈ H} :=
    ⟨e, availableEdges_subset H R.regularized M he⟩
  have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
    H R.regularized D₂ D₃ D₄ Gamma epsilonCore d N
      j R.restrictedWeight hgood f
  have h₂ := (internalConflictLinkCorridors_bounds
    H R.regularized e D₂ D₃ D₄ Gamma epsilonCore d N
      D₃ 2 1 k M he hlinks.2.1.1 hlinks.2.1.2).2
  have h₃ := (internalConflictLinkCorridors_bounds
    H R.regularized e D₂ D₃ D₄ Gamma epsilonCore d N
      D₄ 3 1 k M he hlinks.2.2.1 hlinks.2.2.2).2
  have hC4 := R.bounded.conditionC4_upper
    (availableEdges_subset H R.regularized M he) v
  rw [hsplitR]
  unfold certificateDegreeMissJumpCap certificateHigherLinkCap
  linarith

/-- The same rank-one injection removes the only order-`d` term from the
internal-open-link spread. -/
theorem internalOpenLinkSpread_le_certificateHigherLinkCap
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H R.regularized
        D₂ D₃ D₄ Gamma epsilonCore d N j R.restrictedWeight) k M)
    {f : Finset V} (hf : f ∈ availableEdges H R.regularized M) :
    (internalOpenLinkMass R.regularized
        (availableEdges H R.regularized M) M f : ℝ) -
      (openConflictCount R.regularized
        (availableEdges H R.regularized M) M f : ℝ) ≤
      certificateHigherLinkCap D₂ D₃ D₄ Gamma epsilonCore d N k := by
  have hbase := internalOpenLinkMass_sub_openConflictCount_le_higherLinks
    (A := availableEdges H R.regularized M) (M := M) (f := f)
      R.conflictMatching
  let f' : {e : Finset V // e ∈ H} :=
    ⟨f, availableEdges_subset H R.regularized M hf⟩
  have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
    H R.regularized D₂ D₃ D₄ Gamma epsilonCore d N
      j R.restrictedWeight hgood f'
  have h₂ := (internalConflictLinkCorridors_bounds
    H R.regularized f D₂ D₃ D₄ Gamma epsilonCore d N
      D₃ 2 1 k M hf hlinks.2.1.1 hlinks.2.1.2).2
  have h₃ := (internalConflictLinkCorridors_bounds
    H R.regularized f D₂ D₃ D₄ Gamma epsilonCore d N
      D₄ 3 1 k M hf hlinks.2.2.1 hlinks.2.2.2).2
  unfold certificateHigherLinkCap
  linarith

/-- The predictable miss square is bounded by local miss jump times its
first moment.  This is the sharp route which preserves the `1/N` factor. -/
theorem meanSqMissAvailableDegreeLoss_le_jump_mul_mean
    (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (v : V) {J : ℝ} (hJ : 0 ≤ J)
    (hloss : ∀ e ∈ availableEdges H C M, v ∉ e →
      (availableDegreeLoss H C M e v : ℝ) ≤ J) :
    meanSqMissAvailableDegreeLoss H C M v ≤
      J * meanMissAvailableDegreeLoss H C M v := by
  let A := availableEdges H C M
  by_cases hA : A = ∅
  · simp [meanSqMissAvailableDegreeLoss,
      meanMissAvailableDegreeLoss, A, hA]
  · have hcard : 0 ≤ (A.card : ℝ) := by positivity
    rw [meanSqMissAvailableDegreeLoss, meanMissAvailableDegreeLoss]
    simp only [A, hA, if_false]
    rw [← mul_div_assoc]
    apply div_le_div_of_nonneg_right _ hcard
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro e he
    have hL0 : 0 ≤ (missAvailableDegreeLoss H C M e v : ℝ) := by
      positivity
    have hLJ : (missAvailableDegreeLoss H C M e v : ℝ) ≤ J := by
      by_cases hve : v ∈ e
      · simp [missAvailableDegreeLoss, hve, hJ]
      · simpa [missAvailableDegreeLoss, hve] using hloss e he hve
    nlinarith

/-- Certificate-level raw-square estimate obtained from the deterministic
miss cap and any already established first-moment upper window. -/
theorem meanSqMissAvailableDegreeLoss_le_certificateCap_mul
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N codegreeHi combHi : ℝ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ codegreeHi)
    {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (regularizedGreedyCorridorPredicate H R.regularized
        D₂ D₃ D₄ Gamma epsilonCore d N j R.restrictedWeight) k M)
    (hM : IsConflictFreeMatching H R.regularized M)
    (hcap0 : 0 ≤ certificateDegreeMissJumpCap
      D₂ D₃ D₄ Gamma epsRaw epsilonCore d N codegreeHi k)
    (hmean : meanMissAvailableDegreeLoss H R.regularized M v ≤ combHi) :
    meanSqMissAvailableDegreeLoss H R.regularized M v ≤
      certificateDegreeMissJumpCap
        D₂ D₃ D₄ Gamma epsRaw epsilonCore d N codegreeHi k * combHi := by
  have hlocal : ∀ e ∈ availableEdges H R.regularized M, v ∉ e →
      (availableDegreeLoss H R.regularized M e v : ℝ) ≤
        certificateDegreeMissJumpCap
          D₂ D₃ D₄ Gamma epsRaw epsilonCore d N codegreeHi k := by
    intro e he hve
    exact availableDegreeLoss_miss_le_certificateCap
      H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N codegreeHi
        hH8 hcodegree hgood hM he v hve
  exact (meanSqMissAvailableDegreeLoss_le_jump_mul_mean
    H R.regularized M v hcap0 hlocal).trans
      (mul_le_mul_of_nonneg_left hmean hcap0)

/-- Strong certificate constructor.  All state-dependent combinatorial
source obligations (spread, miss jump, and raw miss square) are discharged;
callers retain only scalar absorptions, trajectory registries, and the
state/non-freezing hypotheses. -/
theorem survivingDegreeSourceBudgets_of_regularizationCertificate_scalar
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsilon Gamma : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d epsilon Gamma ellCert j w)
    (D₂ D₃ D₄ N P codegreeHi : ℝ)
    (T : ℕ) (v : V)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (hH8 : IsUniform H 8)
    (hstate : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      IsConflictFreeMatching H Rcert.regularized S)
    (hdegreeLo0 : ∀ k, k < T →
      0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))
    (havailable : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      (availableEdges H Rcert.regularized S).Nonempty)
    (hcodegree : ∀ s, s.card = 2 →
      (codegree H s : ℝ) ≤ codegreeHi)
    (hregistry : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      CFMTrajectories.DeltaStepRegistry
        D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) P)
    (hnumericLower : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) +
            2 * (d ^ (1 - epsilon) / N)) ≤
        certificateDegreeCombLo H Rcert.regularized v
          D₂ D₃ D₄ Gamma epsilon d N codegreeHi
          (fun i _ ↦ certificateHigherLinkCap
            D₂ D₃ D₄ Gamma epsilon d N i) k S)
    (hnumericUpper : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ Gamma epsilon d N k S ≤
        survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
            CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) -
            2 * (d ^ (1 - epsilon) / N)))
    (hcap0 : ∀ k, k < T →
      0 ≤ certificateDegreeMissJumpCap
        D₂ D₃ D₄ Gamma epsilon epsilon d N codegreeHi k)
    (hjumpAbsorb : ∀ k, k < T →
      certificateDegreeMissJumpCap
        D₂ D₃ D₄ Gamma epsilon epsilon d N codegreeHi k ≤ jump k)
    (hrawAbsorb : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      v ∈ uncoveredVertices H S →
      certificateDegreeMissJumpCap
          D₂ D₃ D₄ Gamma epsilon epsilon d N codegreeHi k *
        certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ Gamma epsilon d N k S ≤ rawVariance k)
    (hupperTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) +
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤
        trajectory k)
    (hlowerTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) -
        (CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d N (k : ℝ))| ≤
        trajectory k)
    (hsquare : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
          D₂ D₃ D₄ N k S →
      2 * rawVariance k + 2 * (trajectory k) ^ 2 ≤ variance k) :
    SurvivingDegreeSourceBudgets H Rcert.regularized
      (certificateIndexedGreedyGood H C d epsilon Gamma ellCert j w Rcert
        D₂ D₃ D₄ N) T v D₂ D₃ D₄ Gamma epsilon d N P
      jump trajectory rawVariance variance := by
  let spread : ℕ → Hypergraph V → ℝ := fun k _ ↦
    certificateHigherLinkCap D₂ D₃ D₄ Gamma epsilon d N k
  apply survivingDegreeSourceBudgets_of_regularizationCertificate
    H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ N P codegreeHi
      T v spread jump trajectory rawVariance variance hH8 hstate
      hdegreeLo0 havailable hcodegree
      (hregistry := hregistry)
      (hnumericLower := hnumericLower)
      (hnumericUpper := hnumericUpper)
      (hupperTrajectory := hupperTrajectory)
      (hlowerTrajectory := hlowerTrajectory)
      (hsquare := hsquare)
  · intro k hk S hgood f hf
    exact internalOpenLinkSpread_le_certificateHigherLinkCap
      H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ epsilon N hgood hf
  · intro k hk S hgood e he hve
    exact (availableDegreeLoss_miss_le_certificateCap
      H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ epsilon N codegreeHi
        hH8 hcodegree hgood (hstate k hk S hgood) he v hve).trans
          (hjumpAbsorb k hk)
  · intro k hk S hgood hv
    have hHnonempty : ∀ f ∈ H, f.Nonempty := by
      intro f hf
      exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
    have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
      H Rcert.regularized D₂ D₃ D₄ Gamma epsilon d N
        j Rcert.restrictedWeight hgood
    have hlinks := internalOpenLink_bounds_of_certificateIndexedGreedyGood
      H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ N hgood
    have hbounds := meanMissAvailableDegreeLoss_bounds_of_corridors_internalLinks
      hHnonempty hH8 (fun c hc ↦ Rcert.bounded.conflict_card hc)
      (hstate k hk S hgood) (hdegreeLo0 k hk) hdegree hcodegree
      hlinks.1 hlinks.2.1 hlinks.2.2
      (by
        intro f hf
        exact internalOpenLinkSpread_le_certificateHigherLinkCap
          H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ epsilon N hgood hf)
      v (havailable k hk S hgood hv)
    have hmean : meanMissAvailableDegreeLoss H Rcert.regularized S v ≤
        certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ Gamma epsilon d N k S := by
      simpa [certificateDegreeCombHi, degreeInternalCorridorError] using hbounds.2
    exact (meanSqMissAvailableDegreeLoss_le_certificateCap_mul
      H C d epsilon Gamma ellCert j w Rcert D₂ D₃ D₄ epsilon N
        codegreeHi _ hH8 hcodegree hgood (hstate k hk S hgood)
        (hcap0 k hk) hmean).trans (hrawAbsorb k hk S hgood hv)

/-! ## Raw-certificate versus core-process parameter split -/

/-- The certificate is built with `(epsRaw, GammaCert)`, while the greedy
core is run with the independent `(epsilonCore, GammaCore)` parameters. -/
abbrev certificateIndexedGreedyGoodWithCore
    { ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N : ℝ) :
    ℕ → Hypergraph V → Prop :=
  indexedGreedyGood
    (regularizedGreedyCorridorPredicate H R.regularized
      D₂ D₃ D₄ GammaCore epsilonCore d N j R.restrictedWeight)

/-- All three one-open internal-link windows extracted from the core good
event, without identifying its parameters with the certificate parameters. -/
theorem internalOpenLink_bounds_of_certificateIndexedGreedyGoodWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M) :
    (∀ f ∈ availableEdges H R.regularized M,
      D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore
            d N 1 1 (k : ℝ)) ≤
          ((partialFamily (conflictLinkLayer R.regularized f 1)
            (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 1)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₂ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore
            d N 1 1 (k : ℝ))) ∧
    (∀ f ∈ availableEdges H R.regularized M,
      D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore
            d N 2 1 (k : ℝ)) ≤
          ((partialFamily (conflictLinkLayer R.regularized f 2)
            (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 2)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₃ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 2 1 (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore
            d N 2 1 (k : ℝ))) ∧
    (∀ f ∈ availableEdges H R.regularized M,
      D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore
            d N 3 1 (k : ℝ)) ≤
          ((partialFamily (conflictLinkLayer R.regularized f 3)
            (availableEdges H R.regularized M) M 1).card : ℝ) ∧
      ((partialFamily (conflictLinkLayer R.regularized f 3)
          (availableEdges H R.regularized M) M 1).card : ℝ) ≤
        D₄ * (CFMTrajectories.zHat D₂ D₃ D₄ d N 3 1 (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ GammaCore epsilonCore
            d N 3 1 (k : ℝ))) := by
  constructor
  · intro f hf
    have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
      H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
        j R.restrictedWeight hgood ⟨f, (mem_availableEdges.mp hf).1⟩
    exact internalConflictLink_bounds_of_corridors
      H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
        D₂ 1 1 k M hf hlinks.1
  · constructor
    · intro f hf
      have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
        H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
          j R.restrictedWeight hgood ⟨f, (mem_availableEdges.mp hf).1⟩
      exact internalConflictLink_bounds_of_corridors
        H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
          D₃ 2 1 k M hf hlinks.2.1
    · intro f hf
      have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
        H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
          j R.restrictedWeight hgood ⟨f, (mem_availableEdges.mp hf).1⟩
      exact internalConflictLink_bounds_of_corridors
        H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
          D₄ 3 1 k M hf hlinks.2.2

/-- Certificate-to-degree-budget bridge with raw regularization parameters
fully separated from all core process parameters. -/
theorem survivingDegreeSourceBudgets_of_regularizationCertificateWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N P codegreeHi : ℝ)
    (T : ℕ) (v : V)
    (spread : ℕ → Hypergraph V → ℝ)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (hH8 : IsUniform H 8)
    (hstate : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      IsConflictFreeMatching H Rcert.regularized S)
    (hdegreeLo0 : ∀ k, k < T →
      0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore
          d N (k : ℝ))
    (havailable : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      (availableEdges H Rcert.regularized S).Nonempty)
    (hcodegree : ∀ s, s.card = 2 →
      (codegree H s : ℝ) ≤ codegreeHi)
    (hspread : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      ∀ f ∈ availableEdges H Rcert.regularized S,
        (internalOpenLinkMass Rcert.regularized
            (availableEdges H Rcert.regularized S) S f : ℝ) -
          (openConflictCount Rcert.regularized
            (availableEdges H Rcert.regularized S) S f : ℝ) ≤ spread k S)
    (hregistry : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      CFMTrajectories.DeltaStepRegistry
        D₂ D₃ D₄ GammaCore epsilonCore d N (k : ℝ) P)
    (hnumericLower : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
            CFMTrajectories.deltaRate D₂ D₃ D₄ GammaCore epsilonCore
              d N (k : ℝ) +
            2 * (d ^ (1 - epsilonCore) / N)) ≤
        certificateDegreeCombLo H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N codegreeHi spread k S)
    (hnumericUpper : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N k S ≤
        survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
            CFMTrajectories.deltaRate D₂ D₃ D₄ GammaCore epsilonCore
              d N (k : ℝ) -
            2 * (d ^ (1 - epsilonCore) / N)))
    (hloss : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      ∀ e ∈ availableEdges H Rcert.regularized S, v ∉ e →
        (availableDegreeLoss H Rcert.regularized S e v : ℝ) ≤ jump k)
    (hrawSquare : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      meanSqMissAvailableDegreeLoss H Rcert.regularized S v ≤ rawVariance k)
    (hupperTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) +
        (CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            (k : ℝ))| ≤ trajectory k)
    (hlowerTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) -
        (CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            (k : ℝ))| ≤ trajectory k)
    (hsquare : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      2 * rawVariance k + 2 * (trajectory k) ^ 2 ≤ variance k) :
    SurvivingDegreeSourceBudgets H Rcert.regularized
      (certificateIndexedGreedyGoodWithCore
        H C d epsRaw GammaCert ellCert j w Rcert
          D₂ D₃ D₄ GammaCore epsilonCore N)
      T v D₂ D₃ D₄ GammaCore epsilonCore d N P
      jump trajectory rawVariance variance := by
  apply survivingDegreeSourceBudgets_of_combinatorialMeanBounds
    H Rcert.regularized
    (certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w Rcert
        D₂ D₃ D₄ GammaCore epsilonCore N)
    T v D₂ D₃ D₄ GammaCore epsilonCore d N P
    jump trajectory rawVariance variance
    (certificateDegreeCombLo H Rcert.regularized v
      D₂ D₃ D₄ GammaCore epsilonCore d N codegreeHi spread)
    (certificateDegreeCombHi H Rcert.regularized v
      D₂ D₃ D₄ GammaCore epsilonCore d N)
    hregistry
  · intro k hk S hgood hv
    have hHnonempty : ∀ f ∈ H, f.Nonempty := by
      intro f hf
      exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
    have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
      H Rcert.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
        j Rcert.restrictedWeight hgood
    have hlinks :=
      internalOpenLink_bounds_of_certificateIndexedGreedyGoodWithCore
        H C d epsRaw GammaCert ellCert j w Rcert
          D₂ D₃ D₄ GammaCore epsilonCore N hgood
    have hbounds := meanMissAvailableDegreeLoss_bounds_of_corridors_internalLinks
      hHnonempty hH8 (fun c hc ↦ Rcert.bounded.conflict_card hc)
      (hstate k hk S hgood) (hdegreeLo0 k hk) hdegree hcodegree
      hlinks.1 hlinks.2.1 hlinks.2.2 (hspread k hk S hgood)
      v (havailable k hk S hgood hv)
    simpa [certificateDegreeCombLo, certificateDegreeCombHi,
      degreeInternalCorridorError] using hbounds
  · exact hnumericLower
  · exact hnumericUpper
  · exact hloss
  · exact hrawSquare
  · exact hupperTrajectory
  · exact hlowerTrajectory
  · exact hsquare

/-- Miss-only local degree loss with raw certificate and core corridor
parameters kept independent. -/
theorem availableDegreeLoss_miss_le_certificateCapWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N codegreeHi : ℝ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ codegreeHi)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M)
    (hM : IsConflictFreeMatching H R.regularized M)
    {e : Finset V} (he : e ∈ availableEdges H R.regularized M)
    (v : V) (hve : v ∉ e) :
    (availableDegreeLoss H R.regularized M e v : ℝ) ≤
      certificateDegreeMissJumpCap
        D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k := by
  have hHnonempty : ∀ f ∈ H, f.Nonempty := by
    intro f hf
    exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
  have hsplit := missAvailableDegreeLoss_eq_miss_add_conflictLost
    hHnonempty hM he v
  have hsplitR :
      (availableDegreeLoss H R.regularized M e v : ℝ) =
        (missLostDegree (availableEdges H R.regularized M) e v : ℝ) +
          (conflictLostDegree R.regularized M
            (availableEdges H R.regularized M) e v : ℝ) := by
    rw [missAvailableDegreeLoss, if_neg hve] at hsplit
    exact_mod_cast hsplit
  have hgeom := missLostDegree_available_real_le_eight_codegree
    hH8 hcodegree R.regularized M he hve
  have hconf := conflictLostDegree_le_C4_add_higherLinks
    (fun c hc ↦ R.bounded.conflict_card hc) he v
  let f : {e : Finset V // e ∈ H} :=
    ⟨e, availableEdges_subset H R.regularized M he⟩
  have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
    H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
      j R.restrictedWeight hgood f
  have h₂ := (internalConflictLinkCorridors_bounds
    H R.regularized e D₂ D₃ D₄ GammaCore epsilonCore d N
      D₃ 2 1 k M he hlinks.2.1.1 hlinks.2.1.2).2
  have h₃ := (internalConflictLinkCorridors_bounds
    H R.regularized e D₂ D₃ D₄ GammaCore epsilonCore d N
      D₄ 3 1 k M he hlinks.2.2.1 hlinks.2.2.2).2
  have hC4 := R.bounded.conditionC4_upper
    (availableEdges_subset H R.regularized M he) v
  rw [hsplitR]
  unfold certificateDegreeMissJumpCap certificateHigherLinkCap
  linarith

/-- Internal-open-link spread with core corridor parameters, independent of
the parameters used to construct the regularization certificate. -/
theorem internalOpenLinkSpread_le_certificateHigherLinkCapWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M)
    {f : Finset V} (hf : f ∈ availableEdges H R.regularized M) :
    (internalOpenLinkMass R.regularized
        (availableEdges H R.regularized M) M f : ℝ) -
      (openConflictCount R.regularized
        (availableEdges H R.regularized M) M f : ℝ) ≤
      certificateHigherLinkCap D₂ D₃ D₄ GammaCore epsilonCore d N k := by
  have hbase := internalOpenLinkMass_sub_openConflictCount_le_higherLinks
    (A := availableEdges H R.regularized M) (M := M) (f := f)
      R.conflictMatching
  let f' : {e : Finset V // e ∈ H} :=
    ⟨f, availableEdges_subset H R.regularized M hf⟩
  have hlinks := indexedRegularizedGreedyGood_internalOpenLinks
    H R.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
      j R.restrictedWeight hgood f'
  have h₂ := (internalConflictLinkCorridors_bounds
    H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
      D₃ 2 1 k M hf hlinks.2.1.1 hlinks.2.1.2).2
  have h₃ := (internalConflictLinkCorridors_bounds
    H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
      D₄ 3 1 k M hf hlinks.2.2.1 hlinks.2.2.2).2
  unfold certificateHigherLinkCap
  linarith

/-- Raw miss-square estimate with the certificate/core parameter split. -/
theorem meanSqMissAvailableDegreeLoss_le_certificateCap_mulWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N codegreeHi combHi : ℝ)
    (hH8 : IsUniform H 8)
    (hcodegree : ∀ s, s.card = 2 → (codegree H s : ℝ) ≤ codegreeHi)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateIndexedGreedyGoodWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N k M)
    (hM : IsConflictFreeMatching H R.regularized M)
    (hcap0 : 0 ≤ certificateDegreeMissJumpCap
      D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k)
    (hmean : meanMissAvailableDegreeLoss H R.regularized M v ≤ combHi) :
    meanSqMissAvailableDegreeLoss H R.regularized M v ≤
      certificateDegreeMissJumpCap
        D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k *
          combHi := by
  have hlocal : ∀ e ∈ availableEdges H R.regularized M, v ∉ e →
      (availableDegreeLoss H R.regularized M e v : ℝ) ≤
        certificateDegreeMissJumpCap
          D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k := by
    intro e he hve
    exact availableDegreeLoss_miss_le_certificateCapWithCore
      H C d epsRaw GammaCert ellCert j w R
        D₂ D₃ D₄ GammaCore epsilonCore N codegreeHi
        hH8 hcodegree hgood hM he v hve
  exact (meanSqMissAvailableDegreeLoss_le_jump_mul_mean
    H R.regularized M v hcap0 hlocal).trans
      (mul_le_mul_of_nonneg_left hmean hcap0)

/-- Strong scalar constructor with no raw/core parameter identification. -/
theorem survivingDegreeSourceBudgets_of_regularizationCertificate_scalarWithCore
    {ι : Type*} [Fintype ι]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N P codegreeHi : ℝ)
    (T : ℕ) (v : V)
    (jump trajectory rawVariance variance : ℕ → ℝ)
    (hH8 : IsUniform H 8)
    (hstate : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      IsConflictFreeMatching H Rcert.regularized S)
    (hdegreeLo0 : ∀ k, k < T →
      0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore
          d N (k : ℝ))
    (havailable : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      (availableEdges H Rcert.regularized S).Nonempty)
    (hcodegree : ∀ s, s.card = 2 →
      (codegree H s : ℝ) ≤ codegreeHi)
    (hregistry : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      CFMTrajectories.DeltaStepRegistry
        D₂ D₃ D₄ GammaCore epsilonCore d N (k : ℝ) P)
    (hnumericLower : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) -
            CFMTrajectories.deltaRate D₂ D₃ D₄ GammaCore epsilonCore
              d N (k : ℝ) +
            2 * (d ^ (1 - epsilonCore) / N)) ≤
        certificateDegreeCombLo H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N codegreeHi
          (fun i _ ↦ certificateHigherLinkCap
            D₂ D₃ D₄ GammaCore epsilonCore d N i) k S)
    (hnumericUpper : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N k S ≤
        survivingVertexProbability H Rcert.regularized v S *
          (-CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ) +
            CFMTrajectories.deltaRate D₂ D₃ D₄ GammaCore epsilonCore
              d N (k : ℝ) -
            2 * (d ^ (1 - epsilonCore) / N)))
    (hcap0 : ∀ k, k < T →
      0 ≤ certificateDegreeMissJumpCap
        D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k)
    (hjumpAbsorb : ∀ k, k < T →
      certificateDegreeMissJumpCap
        D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k ≤ jump k)
    (hrawAbsorb : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      v ∈ uncoveredVertices H S →
      certificateDegreeMissJumpCap
          D₂ D₃ D₄ GammaCore epsRaw epsilonCore d N codegreeHi k *
        certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N k S ≤ rawVariance k)
    (hupperTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) +
        (CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            (k : ℝ))| ≤ trajectory k)
    (hlowerTrajectory : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      |(CFMTrajectories.dHat D₂ D₃ D₄ d N ((k : ℝ) + 1) -
          CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ)) -
        (CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            ((k : ℝ) + 1) -
          CFMTrajectories.delta D₂ D₃ D₄ GammaCore epsilonCore d N
            (k : ℝ))| ≤ trajectory k)
    (hsquare : ∀ k, k < T → ∀ S,
      certificateIndexedGreedyGoodWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N k S →
      2 * rawVariance k + 2 * (trajectory k) ^ 2 ≤ variance k) :
    SurvivingDegreeSourceBudgets H Rcert.regularized
      (certificateIndexedGreedyGoodWithCore
        H C d epsRaw GammaCert ellCert j w Rcert
          D₂ D₃ D₄ GammaCore epsilonCore N)
      T v D₂ D₃ D₄ GammaCore epsilonCore d N P
      jump trajectory rawVariance variance := by
  let spread : ℕ → Hypergraph V → ℝ := fun k _ ↦
    certificateHigherLinkCap D₂ D₃ D₄ GammaCore epsilonCore d N k
  apply survivingDegreeSourceBudgets_of_regularizationCertificateWithCore
    H C d epsRaw GammaCert ellCert j w Rcert
      D₂ D₃ D₄ GammaCore epsilonCore N P codegreeHi
      T v spread jump trajectory rawVariance variance hH8 hstate
      hdegreeLo0 havailable hcodegree
      (hregistry := hregistry)
      (hnumericLower := hnumericLower)
      (hnumericUpper := hnumericUpper)
      (hupperTrajectory := hupperTrajectory)
      (hlowerTrajectory := hlowerTrajectory)
      (hsquare := hsquare)
  · intro k hk S hgood f hf
    exact internalOpenLinkSpread_le_certificateHigherLinkCapWithCore
      H C d epsRaw GammaCert ellCert j w Rcert
        D₂ D₃ D₄ GammaCore epsilonCore N hgood hf
  · intro k hk S hgood e he hve
    exact (availableDegreeLoss_miss_le_certificateCapWithCore
      H C d epsRaw GammaCert ellCert j w Rcert
        D₂ D₃ D₄ GammaCore epsilonCore N codegreeHi
        hH8 hcodegree hgood (hstate k hk S hgood) he v hve).trans
          (hjumpAbsorb k hk)
  · intro k hk S hgood hv
    have hHnonempty : ∀ f ∈ H, f.Nonempty := by
      intro f hf
      exact Finset.card_pos.mp (by rw [hH8 f hf]; norm_num)
    have hdegree := availableDegreeWithin_of_indexedRegularizedGreedyGood
      H Rcert.regularized D₂ D₃ D₄ GammaCore epsilonCore d N
        j Rcert.restrictedWeight hgood
    have hlinks :=
      internalOpenLink_bounds_of_certificateIndexedGreedyGoodWithCore
        H C d epsRaw GammaCert ellCert j w Rcert
          D₂ D₃ D₄ GammaCore epsilonCore N hgood
    have hbounds := meanMissAvailableDegreeLoss_bounds_of_corridors_internalLinks
      hHnonempty hH8 (fun c hc ↦ Rcert.bounded.conflict_card hc)
      (hstate k hk S hgood) (hdegreeLo0 k hk) hdegree hcodegree
      hlinks.1 hlinks.2.1 hlinks.2.2
      (by
        intro f hf
        exact internalOpenLinkSpread_le_certificateHigherLinkCapWithCore
          H C d epsRaw GammaCert ellCert j w Rcert
            D₂ D₃ D₄ GammaCore epsilonCore N hgood hf)
      v (havailable k hk S hgood hv)
    have hmean : meanMissAvailableDegreeLoss H Rcert.regularized S v ≤
        certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N k S := by
      simpa [certificateDegreeCombHi, degreeInternalCorridorError] using hbounds.2
    exact (meanSqMissAvailableDegreeLoss_le_certificateCap_mulWithCore
      H C d epsRaw GammaCert ellCert j w Rcert
        D₂ D₃ D₄ GammaCore epsilonCore N codegreeHi
        (certificateDegreeCombHi H Rcert.regularized v
          D₂ D₃ D₄ GammaCore epsilonCore d N k S)
        hH8 hcodegree hgood (hstate k hk S hgood)
        (hcap0 k hk) hmean).trans (hrawAbsorb k hk S hgood hv)

noncomputable section

/-! Exact choice multiplicities for a weighted partial-test coordinate. -/

def partialTestGainChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) : Hypergraph V :=
  (availableEdges H C M).filter fun e =>
    ¬partialTestCondition (availableEdges H C M) M j s S ∧
      partialTestCondition (availableEdges H C (insert e M))
        (insert e M) j s S

def partialTestLossChoiceSet
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V)
    (j s : ℕ) (S : Hypergraph V) : Hypergraph V :=
  (availableEdges H C M).filter fun e =>
    partialTestCondition (availableEdges H C M) M j s S ∧
      ¬partialTestCondition (availableEdges H C (insert e M))
        (insert e M) j s S

noncomputable def weightedPartialTestGainChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    w S * (partialTestGainChoiceSet H C M j s S).card

noncomputable def weightedPartialTestLossChoices
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    w S * (partialTestLossChoiceSet H C M j s S).card

noncomputable def weightedPartialTestChoiceImbalance
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) : ℝ :=
  weightedPartialTestGainChoices w H C M j s -
    weightedPartialTestLossChoices w H C M j s

theorem sum_partialTestStepGain_eq_weightedChoiceCount
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) :
    ∑ e ∈ availableEdges H C M, partialTestStepGain w H C j s M e =
      weightedPartialTestGainChoices w H C M j s := by
  unfold partialTestStepGain partialTestGainBetween
    weightedPartialTestGainChoices partialTestGainChoiceSet
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  calc
    (∑ e ∈ availableEdges H C M,
        if ¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S then w S else 0) =
        ∑ e ∈ (availableEdges H C M).filter (fun e =>
          ¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S), w S := by
      rw [Finset.sum_filter]
    _ = w S * ((availableEdges H C M).filter (fun e =>
          ¬partialTestCondition (availableEdges H C M) M j s S ∧
            partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S)).card := by
      simp [mul_comm]

theorem sum_partialTestStepLoss_eq_weightedChoiceCount
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) :
    ∑ e ∈ availableEdges H C M, partialTestStepLoss w H C j s M e =
      weightedPartialTestLossChoices w H C M j s := by
  unfold partialTestStepLoss partialTestLossBetween
    weightedPartialTestLossChoices partialTestLossChoiceSet
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  calc
    (∑ e ∈ availableEdges H C M,
        if partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S then w S else 0) =
        ∑ e ∈ (availableEdges H C M).filter (fun e =>
          partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S), w S := by
      rw [Finset.sum_filter]
    _ = w S * ((availableEdges H C M).filter (fun e =>
          partialTestCondition (availableEdges H C M) M j s S ∧
            ¬partialTestCondition (availableEdges H C (insert e M))
              (insert e M) j s S)).card := by
      simp [mul_comm]

/-! Completely unconditional (but deliberately crude) bounds on the two
double-count numerators.  They are useful sanity checks on the exact
orientation of the sums; the sharp endpoint still needs the multiplicity
estimates packaged below. -/

theorem weightedPartialTestGainChoices_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    0 ≤ weightedPartialTestGainChoices w H C M j s := by
  unfold weightedPartialTestGainChoices
  apply Finset.sum_nonneg
  intro S hS
  exact mul_nonneg (hw S) (Nat.cast_nonneg _)

theorem weightedPartialTestLossChoices_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    0 ≤ weightedPartialTestLossChoices w H C M j s := by
  unfold weightedPartialTestLossChoices
  apply Finset.sum_nonneg
  intro S hS
  exact mul_nonneg (hw S) (Nat.cast_nonneg _)

theorem weightedPartialTestGainChoices_le_card_mul_testTotal
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    weightedPartialTestGainChoices w H C M j s ≤
      ((availableEdges H C M).card : ℝ) * testTotal w H j := by
  unfold weightedPartialTestGainChoices
  rw [testTotal, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro S hS
  have hcard : ((partialTestGainChoiceSet H C M j s S).card : ℝ) ≤
      ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)
  simpa [mul_comm] using mul_le_mul_of_nonneg_left hcard (hw S)

theorem weightedPartialTestLossChoices_le_card_mul_testTotal
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    weightedPartialTestLossChoices w H C M j s ≤
      ((availableEdges H C M).card : ℝ) * testTotal w H j := by
  unfold weightedPartialTestLossChoices
  rw [testTotal, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro S hS
  have hcard : ((partialTestLossChoiceSet H C M j s S).card : ℝ) ≤
      ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_le_card (Finset.filter_subset _ _)
  simpa [mul_comm] using mul_le_mul_of_nonneg_left hcard (hw S)

theorem meanPartialTestGain_sub_loss_eq_choiceImbalance_div
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (hA : (availableEdges H C M).Nonempty) :
    meanPartialTestGain w H C j s M - meanPartialTestLoss w H C j s M =
      weightedPartialTestChoiceImbalance w H C M j s /
        (availableEdges H C M).card := by
  have hAne : availableEdges H C M ≠ ∅ := hA.ne_empty
  simp only [meanPartialTestGain, meanPartialTestLoss, hAne, if_false]
  rw [sum_partialTestStepGain_eq_weightedChoiceCount,
    sum_partialTestStepLoss_eq_weightedChoiceCount]
  unfold weightedPartialTestChoiceImbalance
  ring

/-! These are scalar absorption inequalities on the exact finite
double-count numerator, not restatements of the mean fields. -/

def HasPartialTestChoiceAbsorption
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (lo hi : ℝ) : Prop :=
  lo * ((availableEdges H C M).card : ℝ) ≤
      weightedPartialTestChoiceImbalance w H C M j s ∧
    weightedPartialTestChoiceImbalance w H C M j s ≤
      hi * ((availableEdges H C M).card : ℝ)

theorem partialTest_meanWindow_of_choiceAbsorption
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {lo hi : ℝ}
    (hA : (availableEdges H C M).Nonempty)
    (habsorb : HasPartialTestChoiceAbsorption w H C M j s lo hi) :
    lo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ hi := by
  rw [meanPartialTestGain_sub_loss_eq_choiceImbalance_div w H C M j s hA]
  have hcard : 0 < ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  exact ⟨(le_div_iff₀ hcard).2 habsorb.1,
    (div_le_iff₀ hcard).2 habsorb.2⟩

/-! A source-facing decomposition of the residual combinatorics.  `gainLo`
and `gainHi` bound the total multiplicity with which test sets in coordinate
`s+1` enter coordinate `s`; `lossLo` and `lossHi` analogously bound exits
from coordinate `s`.  These statements mention only explicit finite
double-count sums and current observables. -/

def HasPartialTestAggregateMultiplicityBounds
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (gainLo gainHi lossLo lossHi : ℝ) : Prop :=
  gainLo * partialTestObservable w H C j (s + 1) M ≤
      weightedPartialTestGainChoices w H C M j s ∧
    weightedPartialTestGainChoices w H C M j s ≤
      gainHi * partialTestObservable w H C j (s + 1) M ∧
    lossLo * partialTestObservable w H C j s M ≤
      weightedPartialTestLossChoices w H C M j s ∧
    weightedPartialTestLossChoices w H C M j s ≤
      lossHi * partialTestObservable w H C j s M

theorem partialTest_meanWindow_of_observableBounds_multiplicity
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    {gainLo gainHi lossLo lossHi plusLo plusHi currentLo currentHi
      targetLo targetHi : ℝ}
    (hA : (availableEdges H C M).Nonempty)
    (hgainLo0 : 0 ≤ gainLo) (hgainHi0 : 0 ≤ gainHi)
    (hlossLo0 : 0 ≤ lossLo) (hlossHi0 : 0 ≤ lossHi)
    (hplus : plusLo ≤ partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤ currentHi)
    (hmult : HasPartialTestAggregateMultiplicityBounds
      w H C M j s gainLo gainHi lossLo lossHi)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        gainLo * plusLo - lossHi * currentHi)
    (hnumericUpper :
      gainHi * plusHi - lossLo * currentLo ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ targetHi := by
  apply partialTest_meanWindow_of_choiceAbsorption w H C M j s hA
  unfold HasPartialTestChoiceAbsorption weightedPartialTestChoiceImbalance
  constructor
  · apply hnumericLower.trans
    apply sub_le_sub
    · exact (mul_le_mul_of_nonneg_left hplus.1 hgainLo0).trans hmult.1
    · exact hmult.2.2.2.trans
        (mul_le_mul_of_nonneg_left hcurrent.2 hlossHi0)
  · apply (sub_le_sub hmult.2.1 hmult.2.2.1).trans
    apply le_trans _ hnumericUpper
    exact sub_le_sub
      (mul_le_mul_of_nonneg_left hplus.2 hgainHi0)
      (mul_le_mul_of_nonneg_left hcurrent.1 hlossLo0)

noncomputable def partialTestMeanWindowLower
    (D₂ D₃ D₄ Gamma epsilonCore d N scale : ℝ)
    (j s k : ℕ) : ℝ :=
  scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
    CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N j s (k : ℝ) +
    2 * (d ^ ((s : ℝ) - j - epsilonCore) / N))

noncomputable def partialTestMeanWindowUpper
    (D₂ D₃ D₄ Gamma epsilonCore d N scale : ℝ)
    (j s k : ℕ) : ℝ :=
  scale * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
    CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N j s (k : ℝ) -
    2 * (d ^ ((s : ℝ) - j - epsilonCore) / N))

noncomputable def partialTestMultiplicityCorridorLower
    (D₂ D₃ D₄ Gamma epsilonCore d N scale : ℝ)
    (j s k : ℕ) (gainLo lossHi : ℝ) : ℝ :=
  gainLo * (scale *
      (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
          j (s + 1) (k : ℝ))) -
    lossHi * (scale *
      (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
          j s (k : ℝ)))

noncomputable def partialTestMultiplicityCorridorUpper
    (D₂ D₃ D₄ Gamma epsilonCore d N scale : ℝ)
    (j s k : ℕ) (gainHi lossLo : ℝ) : ℝ :=
  gainHi * (scale *
      (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
          j (s + 1) (k : ℝ))) -
    lossLo * (scale *
      (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
          j s (k : ℝ)))

theorem partialTest_meanWindow_of_trajectoryCorridors_multiplicity
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V)
    (D₂ D₃ D₄ Gamma epsilonCore d N scale : ℝ)
    (j s k : ℕ) {gainLo gainHi lossLo lossHi : ℝ}
    (hA : (availableEdges H C M).Nonempty)
    (hgainLo0 : 0 ≤ gainLo) (hgainHi0 : 0 ≤ gainHi)
    (hlossLo0 : 0 ≤ lossLo) (hlossHi0 : 0 ≤ lossHi)
    (hplus :
      scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
            j (s + 1) (k : ℝ)) ≤
        partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
            j (s + 1) (k : ℝ)))
    (hcurrent :
      scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
            j s (k : ℝ)) ≤
        partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤
        scale * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
            j s (k : ℝ)))
    (hmult : HasPartialTestAggregateMultiplicityBounds
      w H C M j s gainLo gainHi lossLo lossHi)
    (hnumericLower :
      partialTestMeanWindowLower D₂ D₃ D₄ Gamma epsilonCore d N scale
          j s k * ((availableEdges H C M).card : ℝ) ≤
        partialTestMultiplicityCorridorLower
          D₂ D₃ D₄ Gamma epsilonCore d N scale j s k gainLo lossHi)
    (hnumericUpper :
      partialTestMultiplicityCorridorUpper
          D₂ D₃ D₄ Gamma epsilonCore d N scale j s k gainHi lossLo ≤
        partialTestMeanWindowUpper D₂ D₃ D₄ Gamma epsilonCore d N scale
          j s k * ((availableEdges H C M).card : ℝ)) :
    partialTestMeanWindowLower D₂ D₃ D₄ Gamma epsilonCore d N scale
          j s k ≤
        meanPartialTestGain w H C j s M - meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M - meanPartialTestLoss w H C j s M ≤
        partialTestMeanWindowUpper D₂ D₃ D₄ Gamma epsilonCore d N scale
          j s k := by
  apply partialTest_meanWindow_of_observableBounds_multiplicity
    w H C M j s hA hgainLo0 hgainHi0 hlossLo0 hlossHi0
    hplus hcurrent hmult
  · simpa only [partialTestMeanWindowLower,
      partialTestMultiplicityCorridorLower] using hnumericLower
  · simpa only [partialTestMeanWindowUpper,
      partialTestMultiplicityCorridorUpper] using hnumericUpper

/-! Numerical content of upper/lower external corridors. -/

theorem partialTestObservable_bounds_of_externalCorridors
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilonCore d N W : ℝ)
    (j s k : ℕ) (M : Hypergraph V)
    (hcorr :
      externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilonCore d N W
          j s k M ∧
        externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilonCore d N W
          j s k M) :
    W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N j s (k : ℝ)) ≤
        partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤
        W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N j s (k : ℝ)) := by
  unfold externalTestUpperCorridor externalTestLowerCorridor at hcorr
  unfold externalTestUpperError externalTestLowerError at hcorr
  unfold CFMTrajectories.externalTestUpperTrajectory
    CFMTrajectories.externalTestLowerTrajectory at hcorr
  constructor <;> linarith

abbrev certificateCoreIndexedGreedyGood
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ) : ℕ → Hypergraph V → Prop :=
  indexedGreedyGood
    (regularizedGreedyCorridorPredicate H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N j R.restrictedWeight)

theorem restrictedExternalObservable_bounds_of_certificateCoreGood
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (a : io) (s : Fin (j a + 1)) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) s.1 (k : ℝ)) ≤
        partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) s.1 M ∧
      partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) s.1 M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) s.1 (k : ℝ)) := by
  apply partialTestObservable_bounds_of_externalCorridors
  exact indexedRegularizedGreedyGood_external
    H R.regularized D₂ D₃ D₄ Gamma epsilonCore d N
      j R.restrictedWeight hgood a s

theorem partialTestObservable_eq_zero_of_availableEdges_eq_empty
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hs : 0 < s)
    (hA : availableEdges H C M = ∅) :
    partialTestObservable w H C j s M = 0 := by
  unfold partialTestObservable partialTestTotal
  apply Finset.sum_eq_zero
  intro S hS
  have hdata := Finset.mem_filter.mp hS
  rw [hA] at hdata
  simp only [Finset.inter_empty, Finset.card_empty] at hdata
  omega

theorem availableEdges_nonempty_of_externalLowerCorridor
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilonCore d N W : ℝ)
    (j s k : ℕ) (M : Hypergraph V) (hs : 0 < s)
    (hpositive :
      0 < W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) -
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N j s (k : ℝ)))
    (hlower :
      externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilonCore d N W
        j s k M) :
    (availableEdges H C M).Nonempty := by
  rw [Finset.nonempty_iff_ne_empty]
  intro hA
  have hzero := partialTestObservable_eq_zero_of_availableEdges_eq_empty
    w H C M j s hs hA
  unfold externalTestLowerCorridor externalTestLowerError at hlower
  unfold CFMTrajectories.externalTestLowerTrajectory at hlower
  rw [hzero] at hlower
  linarith

/-! Coordinates strictly above the rank are identically zero.  This closes
the terminal `s = j` next-coordinate window without adding an artificial
`j + 1` coordinate to the indexed good event. -/

theorem partialTestObservable_eq_zero_of_rank_lt_coordinate
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (hjs : j < s) :
    partialTestObservable w H C j s M = 0 := by
  unfold partialTestObservable partialTestTotal
  apply Finset.sum_eq_zero
  intro S hS
  have hdata := Finset.mem_filter.mp hS
  have hScard : S.card = j := (Finset.mem_powersetCard.mp hdata.1).2
  have hsEq : (S ∩ availableEdges H C M).card = s := hdata.2.1
  have hinter : (S ∩ availableEdges H C M).card ≤ S.card :=
    Finset.card_le_card Finset.inter_subset_left
  omega

theorem zHat_eq_zero_of_rank_lt_coordinate
    (D₂ D₃ D₄ d N x : ℝ) (j s : ℕ) (hjs : j < s) :
    CFMTrajectories.zHat D₂ D₃ D₄ d N j s x = 0 := by
  simp [CFMTrajectories.zHat, Nat.choose_eq_zero_of_lt hjs]

theorem zeta_eq_zero_of_rank_lt_coordinate
    (D₂ D₃ D₄ Gamma epsilonCore d N x : ℝ)
    (j s : ℕ) (hjs : j < s) :
    CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N j s x = 0 := by
  simp [CFMTrajectories.zeta,
    zHat_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ d N x j s hjs,
    Nat.choose_eq_zero_of_lt hjs]

theorem restrictedExternalNextObservable_bounds_of_certificateCoreGood
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (a : io) (s : Fin (j a + 1)) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) (s.1 + 1) (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) (s.1 + 1) (k : ℝ)) ≤
        partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) (s.1 + 1) M ∧
      partialTestObservable (R.restrictedWeight a) H R.regularized
          (j a) (s.1 + 1) M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) (s.1 + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) (s.1 + 1) (k : ℝ)) := by
  by_cases hs : s.1 < j a
  · let s' : Fin (j a + 1) := ⟨s.1 + 1, by omega⟩
    exact restrictedExternalObservable_bounds_of_certificateCoreGood
      H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N hgood a s'
  · have hjs : j a < s.1 + 1 := by omega
    rw [partialTestObservable_eq_zero_of_rank_lt_coordinate
      (R.restrictedWeight a) H R.regularized M (j a) (s.1 + 1) hjs,
      zHat_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ d N (k : ℝ)
        (j a) (s.1 + 1) hjs,
      zeta_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ Gamma epsilonCore
        d N (k : ℝ) (j a) (s.1 + 1) hjs]
    norm_num

theorem internalConflictLinkObservable_bounds_of_certificateCoreGood
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3) (u : Fin (q.1 + 1))
    (hf : f.1 ∈ availableEdges H R.regularized M) :
    internalLinkLayerScale D₂ D₃ D₄ q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (q.1 + 1) (u.1 + 1) (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (q.1 + 1) (u.1 + 1) (k : ℝ)) ≤
        partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
          H R.regularized (q.1 + 1) (u.1 + 1) M ∧
      partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
          H R.regularized (q.1 + 1) (u.1 + 1) M ≤
        internalLinkLayerScale D₂ D₃ D₄ q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (q.1 + 1) (u.1 + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (q.1 + 1) (u.1 + 1) (k : ℝ)) := by
  rw [partialTestObservable_conflictLinkTestWeight R.isConflictSystem]
  exact internalConflictLink_bounds_of_corridors H R.regularized f.1
    D₂ D₃ D₄ Gamma epsilonCore d N
    (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k M hf
    (indexedRegularizedGreedyGood_internal H R.regularized
      D₂ D₃ D₄ Gamma epsilonCore d N j R.restrictedWeight
      hgood f q u)

theorem internalConflictLinkNextObservable_bounds_of_certificateCoreGood
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3) (u : Fin (q.1 + 1))
    (hf : f.1 ∈ availableEdges H R.regularized M) :
    internalLinkLayerScale D₂ D₃ D₄ q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (q.1 + 1) (u.1 + 2) (k : ℝ) -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (q.1 + 1) (u.1 + 2) (k : ℝ)) ≤
        partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
          H R.regularized (q.1 + 1) (u.1 + 2) M ∧
      partialTestObservable
          (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
          H R.regularized (q.1 + 1) (u.1 + 2) M ≤
        internalLinkLayerScale D₂ D₃ D₄ q *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N (q.1 + 1) (u.1 + 2) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
              (q.1 + 1) (u.1 + 2) (k : ℝ)) := by
  by_cases hs : u.1 < q.1
  · let u' : Fin (q.1 + 1) := ⟨u.1 + 1, by omega⟩
    exact internalConflictLinkObservable_bounds_of_certificateCoreGood
      H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N hgood f q u' hf
  · have hjs : q.1 + 1 < u.1 + 2 := by omega
    rw [partialTestObservable_eq_zero_of_rank_lt_coordinate
      (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
      H R.regularized M (q.1 + 1) (u.1 + 2) hjs,
      zHat_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ d N (k : ℝ)
        (q.1 + 1) (u.1 + 2) hjs,
      zeta_eq_zero_of_rank_lt_coordinate D₂ D₃ D₄ Gamma epsilonCore
        d N (k : ℝ) (q.1 + 1) (u.1 + 2) hjs]
    norm_num

/-! The corridor-to-mean bridge for every public external coordinate.  The
four `hmult` inequalities are the remaining finite combinatorial estimates;
the two `hnumeric` hypotheses are scalar absorptions after substituting the
already-certified trajectory corridors. -/

theorem restrictedExternal_meanWindow_of_certificateCoreGood_multiplicity
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (a : io) (hj1 : 1 ≤ j a) (s : Fin (j a + 1))
    (hpositiveTop :
      0 < testTotal (R.restrictedWeight a) H (j a) *
        (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) (j a) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
            (j a) (j a) (k : ℝ)))
    {gainLo gainHi lossLo lossHi : ℝ}
    (hgainLo0 : 0 ≤ gainLo) (hgainHi0 : 0 ≤ gainHi)
    (hlossLo0 : 0 ≤ lossLo) (hlossHi0 : 0 ≤ lossHi)
    (hmult : HasPartialTestAggregateMultiplicityBounds
      (R.restrictedWeight a) H R.regularized M (j a) s.1
      gainLo gainHi lossLo lossHi)
    (hnumericLower :
      partialTestMeanWindowLower D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H (j a)) (j a) s.1 k *
          ((availableEdges H R.regularized M).card : ℝ) ≤
        partialTestMultiplicityCorridorLower D₂ D₃ D₄ Gamma epsilonCore
          d N (testTotal (R.restrictedWeight a) H (j a))
          (j a) s.1 k gainLo lossHi)
    (hnumericUpper :
      partialTestMultiplicityCorridorUpper D₂ D₃ D₄ Gamma epsilonCore
          d N (testTotal (R.restrictedWeight a) H (j a))
          (j a) s.1 k gainHi lossLo ≤
        partialTestMeanWindowUpper D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H (j a)) (j a) s.1 k *
          ((availableEdges H R.regularized M).card : ℝ)) :
    partialTestMeanWindowLower D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H (j a)) (j a) s.1 k ≤
        meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ∧
      meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ≤
        partialTestMeanWindowUpper D₂ D₃ D₄ Gamma epsilonCore d N
          (testTotal (R.restrictedWeight a) H (j a)) (j a) s.1 k := by
  let top : Fin (j a + 1) := ⟨j a, Nat.lt_succ_self _⟩
  have htop := indexedRegularizedGreedyGood_external
    H R.regularized D₂ D₃ D₄ Gamma epsilonCore d N
      j R.restrictedWeight hgood a top
  have hA := availableEdges_nonempty_of_externalLowerCorridor
    (R.restrictedWeight a) H R.regularized
    D₂ D₃ D₄ Gamma epsilonCore d N
    (testTotal (R.restrictedWeight a) H (j a)) (j a) (j a) k M
    hj1 hpositiveTop htop.2
  have hcurrent := restrictedExternalObservable_bounds_of_certificateCoreGood
    H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N hgood a s
  have hplus := restrictedExternalNextObservable_bounds_of_certificateCoreGood
    H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N hgood a s
  exact partialTest_meanWindow_of_trajectoryCorridors_multiplicity
    (R.restrictedWeight a) H R.regularized M
    D₂ D₃ D₄ Gamma epsilonCore d N
    (testTotal (R.restrictedWeight a) H (j a)) (j a) s.1 k
    hA hgainLo0 hgainHi0 hlossLo0 hlossHi0 hplus hcurrent hmult
    hnumericLower hnumericUpper

/-! The analogous bridge for every internal link rank `q = 1,2,3` and all
of its coordinates.  Activity of `f` supplies the nonempty choice set and
also opens the internal-link corridors. -/

theorem internalConflictLink_meanWindow_of_certificateCoreGood_multiplicity
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3) (u : Fin (q.1 + 1))
    (hf : f.1 ∈ availableEdges H R.regularized M)
    {gainLo gainHi lossLo lossHi : ℝ}
    (hgainLo0 : 0 ≤ gainLo) (hgainHi0 : 0 ≤ gainHi)
    (hlossLo0 : 0 ≤ lossLo) (hlossHi0 : 0 ≤ lossHi)
    (hmult : HasPartialTestAggregateMultiplicityBounds
      (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
      H R.regularized M (q.1 + 1) (u.1 + 1) gainLo gainHi lossLo lossHi)
    (hnumericLower :
      partialTestMeanWindowLower D₂ D₃ D₄ Gamma epsilonCore d N
          (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k *
          ((availableEdges H R.regularized M).card : ℝ) ≤
        partialTestMultiplicityCorridorLower D₂ D₃ D₄ Gamma epsilonCore
          d N (internalLinkLayerScale D₂ D₃ D₄ q)
          (q.1 + 1) (u.1 + 1) k gainLo lossHi)
    (hnumericUpper :
      partialTestMultiplicityCorridorUpper D₂ D₃ D₄ Gamma epsilonCore
          d N (internalLinkLayerScale D₂ D₃ D₄ q)
          (q.1 + 1) (u.1 + 1) k gainHi lossLo ≤
        partialTestMeanWindowUpper D₂ D₃ D₄ Gamma epsilonCore d N
          (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k *
          ((availableEdges H R.regularized M).card : ℝ)) :
    partialTestMeanWindowLower D₂ D₃ D₄ Gamma epsilonCore d N
          (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k ≤
        meanPartialTestGain
            (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M -
          meanPartialTestLoss
            (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M ∧
      meanPartialTestGain
            (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M -
          meanPartialTestLoss
            (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
            H R.regularized (q.1 + 1) (u.1 + 1) M ≤
        partialTestMeanWindowUpper D₂ D₃ D₄ Gamma epsilonCore d N
          (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k := by
  have hA : (availableEdges H R.regularized M).Nonempty := ⟨f.1, hf⟩
  have hcurrent := internalConflictLinkObservable_bounds_of_certificateCoreGood
    H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N
    hgood f q u hf
  have hplus := internalConflictLinkNextObservable_bounds_of_certificateCoreGood
    H C d epsRaw Gamma ellCert j w R D₂ D₃ D₄ epsilonCore N
    hgood f q u hf
  exact partialTest_meanWindow_of_trajectoryCorridors_multiplicity
    (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
    H R.regularized M D₂ D₃ D₄ Gamma epsilonCore d N
    (internalLinkLayerScale D₂ D₃ D₄ q) (q.1 + 1) (u.1 + 1) k
    hA hgainLo0 hgainHi0 hlossLo0 hlossHi0 hplus hcurrent hmult
    hnumericLower hnumericUpper

/-! Certificate wrappers.  Their only unclosed mean input is the displayed
finite choice-imbalance absorption. -/

theorem restrictedExternal_meanWindow_of_certificateCoreGood
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N : ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hgood : certificateCoreIndexedGreedyGood H C d epsRaw Gamma ellCert j w R
      D₂ D₃ D₄ epsilonCore N k M)
    (a : io) (hj1 : 1 ≤ j a) (s : Fin (j a + 1))
    (hpositiveTop :
      0 < testTotal (R.restrictedWeight a) H (j a) *
        (CFMTrajectories.zHat D₂ D₃ D₄ d N (j a) (j a) (k : ℝ) -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilonCore d N
            (j a) (j a) (k : ℝ)))
    (habsorb : HasPartialTestChoiceAbsorption
      (R.restrictedWeight a) H R.regularized M (j a) s.1
      (testTotal (R.restrictedWeight a) H (j a) *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
            (j a) s.1 (k : ℝ) +
          2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) - epsilonCore) / N)))
      (testTotal (R.restrictedWeight a) H (j a) *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
            (j a) s.1 (k : ℝ) -
          2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) - epsilonCore) / N)))) :
    testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) s.1 (k : ℝ) +
            2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) - epsilonCore) / N)) ≤
        meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ∧
      meanPartialTestGain (R.restrictedWeight a) H R.regularized
            (j a) s.1 M -
          meanPartialTestLoss (R.restrictedWeight a) H R.regularized
            (j a) s.1 M ≤
        testTotal (R.restrictedWeight a) H (j a) *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N (j a) s.1 (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N
              (j a) s.1 (k : ℝ) -
            2 * (d ^ ((s.1 : ℝ) - (j a : ℝ) - epsilonCore) / N)) := by
  let top : Fin (j a + 1) := ⟨j a, Nat.lt_succ_self _⟩
  have htop := indexedRegularizedGreedyGood_external
    H R.regularized D₂ D₃ D₄ Gamma epsilonCore d N
      j R.restrictedWeight hgood a top
  have hA := availableEdges_nonempty_of_externalLowerCorridor
    (R.restrictedWeight a) H R.regularized
    D₂ D₃ D₄ Gamma epsilonCore d N
    (testTotal (R.restrictedWeight a) H (j a)) (j a) (j a) k M
    hj1 hpositiveTop htop.2
  exact partialTest_meanWindow_of_choiceAbsorption
    (R.restrictedWeight a) H R.regularized M (j a) s.1 hA habsorb

theorem internalConflictLink_meanWindow_of_choiceAbsorption
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw Gamma : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw Gamma ellCert j w)
    (D₂ D₃ D₄ epsilonCore N scale : ℝ)
    {k : ℕ} {M : Hypergraph V} (f : Finset V)
    (q s : ℕ) (hf : f ∈ availableEdges H R.regularized M)
    (habsorb : HasPartialTestChoiceAbsorption
      (conflictLinkTestWeight R.regularized f q)
      H R.regularized M q s
      (scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) +
          2 * (d ^ ((s : ℝ) - q - epsilonCore) / N)))
      (scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) -
          2 * (d ^ ((s : ℝ) - q - epsilonCore) / N)))) :
    scale *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) -
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) +
            2 * (d ^ ((s : ℝ) - q - epsilonCore) / N)) ≤
        meanPartialTestGain (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M -
          meanPartialTestLoss (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M ∧
      meanPartialTestGain (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M -
          meanPartialTestLoss (conflictLinkTestWeight R.regularized f q)
            H R.regularized q s M ≤
        scale *
          (CFMTrajectories.zHatRate D₂ D₃ D₄ d N q s (k : ℝ) +
            CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilonCore d N q s (k : ℝ) -
            2 * (d ^ ((s : ℝ) - q - epsilonCore) / N)) := by
  have hA : (availableEdges H R.regularized M).Nonempty := ⟨f, hf⟩
  exact partialTest_meanWindow_of_choiceAbsorption
    (conflictLinkTestWeight R.regularized f q)
    H R.regularized M q s hA habsorb

end

/-- Restricting a test to a conflict system does not change its value on a
conflict-free family. -/
theorem testTotal_restrictWeight_eq_of_conflictFree
    (D : ConflictSystem V) (w : TestWeight V) (M : Hypergraph V) (j : ℕ)
    (hM : ConflictFree D M) :
    testTotal (CFMRegularization.restrictWeight D w) M j =
      testTotal w M j := by
  unfold testTotal
  apply Finset.sum_congr rfl
  intro S hS
  apply CFMRegularization.restrictWeight_apply_free
  exact hM.mono_family (Finset.mem_powersetCard.mp hS).1

/-- A half-public-error estimate for the restricted test, together with a
quarter-public-error killed-weight budget, transfers to the original test.
The matching value itself is unchanged because the terminal matching is
conflict-free for the regularized system. -/
theorem restrictedTestEstimate_transfer
    (H M : Hypergraph V) (D : ConflictSystem V)
    (w : TestWeight V) (d err : ℝ) (j : ℕ)
    (hw : ∀ S, 0 ≤ w S) (hM : ConflictFree D M) (hd : 0 ≤ d)
    (herr0 : 0 ≤ err) (herr1 : err ≤ 1)
    (hkill : CFMRegularization.killedWeight H D j w ≤
      err / 4 * testTotal w H j)
    (hrestricted :
      (1 - err / 2) * Real.rpow d (-(j : ℝ)) *
          testTotal (CFMRegularization.restrictWeight D w) H j ≤
        testTotal (CFMRegularization.restrictWeight D w) M j ∧
      testTotal (CFMRegularization.restrictWeight D w) M j ≤
        (1 + err / 2) * Real.rpow d (-(j : ℝ)) *
          testTotal (CFMRegularization.restrictWeight D w) H j) :
    (1 - err) * Real.rpow d (-(j : ℝ)) * testTotal w H j ≤
        testTotal w M j ∧
      testTotal w M j ≤
        (1 + err) * Real.rpow d (-(j : ℝ)) * testTotal w H j := by
  let W := testTotal w H j
  let W' := testTotal (CFMRegularization.restrictWeight D w) H j
  let K := CFMRegularization.killedWeight H D j w
  let Z := Real.rpow d (-(j : ℝ))
  have hW0 : 0 ≤ W := testTotal_nonneg hw H j
  have hW'0 : 0 ≤ W' :=
    testTotal_nonneg (CFMRegularization.restrictWeight_nonneg hw) H j
  have hZ0 : 0 ≤ Z := Real.rpow_nonneg hd _
  have hdecomp : W' + K = W := by
    exact CFMRegularization.testTotal_restrictWeight_add_killedWeight
      H D j w hw
  have hK0 : 0 ≤ K := by
    unfold K CFMRegularization.killedWeight
    exact Finset.sum_nonneg fun S _ ↦ hw S
  have hW'le : W' ≤ W := by linarith
  have hK : K ≤ err / 4 * W := by simpa only [K, W] using hkill
  have hfactor : (1 - err) * W ≤ (1 - err / 2) * W' := by
    have hcoef0 : 0 ≤ 1 - err / 2 := by linarith
    have hmul := mul_le_mul_of_nonneg_left hK hcoef0
    rw [← hdecomp]
    nlinarith [mul_nonneg herr0 hW0]
  have hlowerScaled :
      (1 - err) * Z * W ≤ (1 - err / 2) * Z * W' := by
    nlinarith [mul_le_mul_of_nonneg_left hfactor hZ0]
  have hupperScaled :
      (1 + err / 2) * Z * W' ≤ (1 + err) * Z * W := by
    have hcoef : 0 ≤ (1 + err / 2) * Z :=
      mul_nonneg (by linarith) hZ0
    have hm := mul_le_mul_of_nonneg_left hW'le hcoef
    nlinarith [mul_nonneg hZ0 hW0]
  rw [testTotal_restrictWeight_eq_of_conflictFree D w M j hM] at hrestricted
  constructor
  · exact hlowerScaled.trans hrestricted.1
  · exact hrestricted.2.trans hupperScaled

/-- The same terminal trajectory calculation with the slack retained: the
`err/16` stopping and envelope inputs fit inside a half-public-error window. -/
theorem externalTestTrajectories_fit_half_public_of_small
    (D₂ D₃ D₄ Gamma epsilon d N x err rho : ℝ) {j : ℕ}
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hd : 0 < d) (hN : 0 < N)
    (hGamma : 1 ≤ Gamma) (herr : 0 ≤ err)
    (hr0 : 0 ≤ 8 * x / N) (hr1 : 8 * x / N ≤ 1)
    (hrho : 1 - 8 * x / N ≤ rho) (hrhoSmall : rho ≤ err / 16)
    (hxiSmall : CFMTrajectories.xi Gamma epsilon d N x ≤ err / 16) :
    (1 - err / 2) * Real.rpow d (-(j : ℝ)) ≤
        CFMTrajectories.zHat D₂ D₃ D₄ d N j 0 x -
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j 0 x ∧
      CFMTrajectories.zHat D₂ D₃ D₄ d N j 0 x +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j 0 x ≤
        (1 + err / 2) * Real.rpow d (-(j : ℝ)) := by
  let r : ℝ := 8 * x / N
  let u : ℝ := r ^ j
  let envelope : ℝ := xi Gamma epsilon d N x * (u + 1 / (4 * Gamma))
  have hGammaPos : 0 < Gamma := lt_of_lt_of_le zero_lt_one hGamma
  have hxi0 : 0 ≤ xi Gamma epsilon d N x := by
    have hpV0 : 0 ≤ pV N x := by
      unfold pV
      linarith
    unfold xi
    exact mul_nonneg (Real.rpow_nonneg hpV0 _) (Real.rpow_nonneg hd.le _)
  have hr0' : 0 ≤ r := by simpa only [r] using hr0
  have hr1' : r ≤ 1 := by simpa only [r] using hr1
  have hrho' : 1 - r ≤ rho := by simpa only [r] using hrho
  have hu := pow_close_to_one_of_one_le_le_three hj1 hj3 hr0' hr1' hrho'
  have hu0 : 0 ≤ u := pow_nonneg hr0' j
  have huLower : 1 - 3 * (err / 16) ≤ u := by
    dsimp only [u]
    exact hu.1.trans' (by linarith)
  have huUpper : u ≤ 1 := by simpa only [u] using hu.2
  have hg0 : 0 ≤ 1 / (4 * Gamma) := by positivity
  have hgUpper : 1 / (4 * Gamma) ≤ 1 / 4 := by
    rw [div_le_iff₀ (by positivity : 0 < 4 * Gamma)]
    nlinarith
  have hsum0 : 0 ≤ u + 1 / (4 * Gamma) := add_nonneg hu0 hg0
  have hsumUpper : u + 1 / (4 * Gamma) ≤ 5 / 4 := by linarith
  have henvelope0 : 0 ≤ envelope := mul_nonneg hxi0 hsum0
  have henvelopeUpper : envelope ≤ 5 * err / 64 := by
    calc
      envelope ≤ (err / 16) * (u + 1 / (4 * Gamma)) :=
        mul_le_mul_of_nonneg_right hxiSmall hsum0
      _ ≤ (err / 16) * (5 / 4) :=
        mul_le_mul_of_nonneg_left hsumUpper (by positivity)
      _ = 5 * err / 64 := by ring
  have hnormalizedLower : 1 - err / 2 ≤ u - envelope := by linarith
  have hnormalizedUpper : u + envelope ≤ 1 + err / 2 := by linarith
  dsimp only [envelope] at hnormalizedLower hnormalizedUpper
  have hscale0 : 0 ≤ Real.rpow d (-(j : ℝ)) := Real.rpow_nonneg hd.le _
  have hz := zHat_zero_available_eq_scale_mul D₂ D₃ D₄ d N x j hd hN
  have he := zeta_zero_available_eq_scale_mul
    D₂ D₃ D₄ Gamma epsilon d N x j hd hN hGammaPos
  constructor
  · rw [hz, he]
    have hmul := mul_le_mul_of_nonneg_left hnormalizedLower hscale0
    dsimp only [u, r] at hmul
    calc
      (1 - err / 2) * Real.rpow d (-(j : ℝ)) =
          Real.rpow d (-(j : ℝ)) * (1 - err / 2) := by ring
      _ ≤ Real.rpow d (-(j : ℝ)) *
          ((8 * x / N) ^ j -
            xi Gamma epsilon d N x * ((8 * x / N) ^ j + 1 / (4 * Gamma))) := hmul
      _ = Real.rpow d (-(j : ℝ)) * (8 * x / N) ^ j -
          xi Gamma epsilon d N x * Real.rpow d (-(j : ℝ)) *
            ((8 * x / N) ^ j + 1 / (4 * Gamma)) := by ring
  · rw [hz, he]
    have hmul := mul_le_mul_of_nonneg_left hnormalizedUpper hscale0
    dsimp only [u, r] at hmul
    calc
      Real.rpow d (-(j : ℝ)) * (8 * x / N) ^ j +
          xi Gamma epsilon d N x * Real.rpow d (-(j : ℝ)) *
            ((8 * x / N) ^ j + 1 / (4 * Gamma)) =
          Real.rpow d (-(j : ℝ)) *
            ((8 * x / N) ^ j +
              xi Gamma epsilon d N x * ((8 * x / N) ^ j + 1 / (4 * Gamma))) := by ring
      _ ≤ Real.rpow d (-(j : ℝ)) * (1 + err / 2) := hmul
      _ = (1 + err / 2) * Real.rpow d (-(j : ℝ)) := by ring

/-- Half-public-error terminal estimate at the strengthened rounded stop. -/
theorem externalTestCorridors_at_ceil_target_half_public
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma epsilon d err mu : ℝ) (N : ℕ) {j : ℕ}
    (M : Hypergraph V) (hM : IsMatching H M)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hd : 0 < d)
    (hGamma : 1 ≤ Gamma) (herr : 0 ≤ err)
    (hmu1 : mu ≤ 1) (hmuSmall : mu ≤ err / 16)
    (hslack : 1 < mu * (N : ℝ) / 8)
    (hxiSmall :
      CFMTrajectories.xi Gamma epsilon d (N : ℝ)
          (Nat.ceil ((1 - mu) * (N : ℝ) / 8) : ℝ) ≤ err / 16)
    (hW : 0 ≤ testTotal w H j)
    (hupper : externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma epsilon d
      (N : ℝ) (testTotal w H j) j 0
      (Nat.ceil ((1 - mu) * (N : ℝ) / 8)) M)
    (hlower : externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma epsilon d
      (N : ℝ) (testTotal w H j) j 0
      (Nat.ceil ((1 - mu) * (N : ℝ) / 8)) M) :
    (1 - err / 2) * Real.rpow d (-(j : ℝ)) * testTotal w H j ≤
        testTotal w M j ∧
      testTotal w M j ≤
        (1 + err / 2) * Real.rpow d (-(j : ℝ)) * testTotal w H j := by
  let T := Nat.ceil ((1 - mu) * (N : ℝ) / 8)
  have hNne : N ≠ 0 := by
    intro hzero
    subst N
    norm_num at hslack
  have hNnat : 0 < N := Nat.pos_of_ne_zero hNne
  have hN : 0 < (N : ℝ) := by exact_mod_cast hNnat
  have htime := ceil_almostPerfect_normalized_time N mu hmu1 hslack
  have htraj := externalTestTrajectories_fit_half_public_of_small
    D₂ D₃ D₄ Gamma epsilon d (N : ℝ) (T : ℝ) err mu
    hj1 hj3 hd hN hGamma herr htime.1 htime.2.1 htime.2.2 hmuSmall
    (by simpa only [T] using hxiSmall)
  exact externalTestCorridors_terminal_absorb w H C D₂ D₃ D₄ Gamma epsilon d
    (N : ℝ) (err / 2) j T M hM hW
    (by simpa only [T] using hupper) (by simpa only [T] using hlower)
    htraj.1 htraj.2

theorem partialTestStepGain_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (e : Finset V)
    (hw : ∀ S, 0 ≤ w S) :
    0 ≤ partialTestStepGain w H C j s M e := by
  unfold partialTestStepGain partialTestGainBetween
  apply Finset.sum_nonneg
  intro S hS
  split <;> simp_all

theorem partialTestStepLoss_nonneg
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (e : Finset V)
    (hw : ∀ S, 0 ≤ w S) :
    0 ≤ partialTestStepLoss w H C j s M e := by
  unfold partialTestStepLoss partialTestLossBetween
  apply Finset.sum_nonneg
  intro S hS
  split <;> simp_all

/-! A sharp choice-averaged second moment.  In contrast to the crude
pointwise-square bound, this retains the small mean transition
multiplicity (and hence the essential `1/N`). -/

theorem meanSqPartialTestIncrement_le_cap_mul_meanGain_add_meanLoss
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {cap : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hgainCap : ∀ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e ≤ cap)
    (hlossCap : ∀ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e ≤ cap) :
    meanSqPartialTestIncrement w H C j s M ≤
      cap * (meanPartialTestGain w H C j s M +
        meanPartialTestLoss w H C j s M) := by
  by_cases hA : availableEdges H C M = ∅
  · simp [meanSqPartialTestIncrement, meanPartialTestGain,
      meanPartialTestLoss, hA]
  · have hcard : 0 < ((availableEdges H C M).card : ℝ) := by
      exact_mod_cast Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hA)
    have hnum :
        ∑ e ∈ availableEdges H C M,
            (partialTestObservable w H C j s (insert e M) -
              partialTestObservable w H C j s M) ^ 2 ≤
          cap * ((∑ e ∈ availableEdges H C M,
              partialTestStepGain w H C j s M e) +
            ∑ e ∈ availableEdges H C M,
              partialTestStepLoss w H C j s M e) := by
      calc
        ∑ e ∈ availableEdges H C M,
            (partialTestObservable w H C j s (insert e M) -
              partialTestObservable w H C j s M) ^ 2 ≤
            ∑ e ∈ availableEdges H C M,
              cap * (partialTestStepGain w H C j s M e +
                partialTestStepLoss w H C j s M e) := by
          apply Finset.sum_le_sum
          intro e he
          rw [partialTestObservable_insert_sub_eq_gain_sub_loss]
          have hg0 := partialTestStepGain_nonneg w H C M j s e hw
          have hl0 := partialTestStepLoss_nonneg w H C M j s e hw
          have hg := hgainCap e he
          have hl := hlossCap e he
          have hgg := mul_le_mul_of_nonneg_left hg hg0
          have hll := mul_le_mul_of_nonneg_left hl hl0
          nlinarith
        _ = cap * ((∑ e ∈ availableEdges H C M,
              partialTestStepGain w H C j s M e) +
            ∑ e ∈ availableEdges H C M,
              partialTestStepLoss w H C j s M e) := by
          simp_rw [mul_add]
          rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    simp only [meanSqPartialTestIncrement, meanPartialTestGain,
      meanPartialTestLoss, hA, if_false]
    rw [show cap *
        ((∑ e ∈ availableEdges H C M,
            partialTestStepGain w H C j s M e) /
              ((availableEdges H C M).card : ℝ) +
          (∑ e ∈ availableEdges H C M,
            partialTestStepLoss w H C j s M e) /
              ((availableEdges H C M).card : ℝ)) =
        cap * ((∑ e ∈ availableEdges H C M,
            partialTestStepGain w H C j s M e) +
          ∑ e ∈ availableEdges H C M,
            partialTestStepLoss w H C j s M e) /
              ((availableEdges H C M).card : ℝ) by ring]
    exact (div_le_div_iff_of_pos_right hcard).2 hnum

theorem partialTestStepGain_add_loss_le_incidenceCharge
    (w : TestWeight V) (H A M A' M' : Hypergraph V)
    (j s : ℕ) (hw : ∀ S, 0 ≤ w S) :
    partialTestGainBetween w H A M A' M' j s +
        partialTestLossBetween w H A M A' M' j s ≤
      partialTestIncidenceCharge w H j
        (partialTestStatusChanges A M A' M') := by
  simp only [partialTestGainBetween, partialTestLossBetween,
    partialTestIncidenceCharge]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro S hS
  by_cases hOld : partialTestCondition A M j s S <;>
    by_cases hNew : partialTestCondition A' M' j s S
  · simp [hOld, hNew]
    exact mul_nonneg (hw S) (Nat.cast_nonneg _)
  · have hne : (S ∩ partialTestStatusChanges A M A' M').Nonempty := by
      by_contra hnone
      have hinter : S ∩ partialTestStatusChanges A M A' M' = ∅ :=
        Finset.not_nonempty_iff_eq_empty.mp hnone
      have hcond := partialTestCondition_eq_of_disjoint_statusChanges
        A M A' M' S j s (Finset.disjoint_iff_inter_eq_empty.mpr hinter)
      exact hNew (hcond ▸ hOld)
    have hcard : (1 : ℝ) ≤
        ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) := by
      exact_mod_cast Finset.card_pos.mpr hne
    simp [hOld, hNew]
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hcard (hw S)
  · have hne : (S ∩ partialTestStatusChanges A M A' M').Nonempty := by
      by_contra hnone
      have hinter : S ∩ partialTestStatusChanges A M A' M' = ∅ :=
        Finset.not_nonempty_iff_eq_empty.mp hnone
      have hcond := partialTestCondition_eq_of_disjoint_statusChanges
        A M A' M' S j s (Finset.disjoint_iff_inter_eq_empty.mpr hinter)
      exact hOld (hcond.symm ▸ hNew)
    have hcard : (1 : ℝ) ≤
        ((S ∩ partialTestStatusChanges A M A' M').card : ℝ) := by
      exact_mod_cast Finset.card_pos.mpr hne
    simp [hOld, hNew]
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hcard (hw S)
  · simp [hOld, hNew]
    exact mul_nonneg (hw S) (Nat.cast_nonneg _)

theorem partialTestStepGain_add_loss_le_sum_extensions
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S) :
    partialTestStepGain w H C j s M e +
        partialTestStepLoss w H C j s M e ≤
      ∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M),
        testExtension w H j {f} := by
  calc
    partialTestStepGain w H C j s M e +
        partialTestStepLoss w H C j s M e ≤
      partialTestIncidenceCharge w H j
        (partialTestStatusChanges
          (availableEdges H C M) M
          (availableEdges H C (insert e M)) (insert e M)) :=
      partialTestStepGain_add_loss_le_incidenceCharge
        w H (availableEdges H C M) M
        (availableEdges H C (insert e M)) (insert e M) j s hw
    _ = partialTestIncidenceCharge w H j
        (availableEdges H C M \
          availableEdges H C (insert e M)) := by
      rw [partialTestStatusChanges_available_insert he]
    _ = ∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M),
        testExtension w H j {f} :=
      partialTestIncidenceCharge_eq_sum_testExtension w H _ j

theorem partialTestStepGain_loss_le_trackableStatusCap
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j ell : ℕ} {d eta L : ℝ} (s : ℕ) (M : Hypergraph V)
    (hw : IsTrackable H C j ell d eta w) (hj : 2 ≤ j) (hd : 0 ≤ d)
    (hspread : HasExternalTestStatusSpread H C M L) :
    (∀ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e ≤
        L * (testTotal w H j / Real.rpow d (1 + eta))) ∧
    (∀ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e ≤
        L * (testTotal w H j / Real.rpow d (1 + eta))) := by
  constructor <;> intro e he
  · have hsum := partialTestStepGain_add_loss_le_sum_extensions
      w H C M j s he hw.isTestFunction.nonneg
    have hl0 := partialTestStepLoss_nonneg w H C M j s e
      hw.isTestFunction.nonneg
    apply (show partialTestStepGain w H C j s M e ≤
        partialTestStepGain w H C j s M e +
          partialTestStepLoss w H C j s M e by linarith).trans
    apply hsum.trans
    apply (sum_testExtension_le_card_mul_trackable _ hw hj
      (Finset.sdiff_subset.trans (availableEdges_subset H C M))).trans
    exact mul_le_mul_of_nonneg_right (hspread e he)
      (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg hd _))
  · have hsum := partialTestStepGain_add_loss_le_sum_extensions
      w H C M j s he hw.isTestFunction.nonneg
    have hg0 := partialTestStepGain_nonneg w H C M j s e
      hw.isTestFunction.nonneg
    apply (show partialTestStepLoss w H C j s M e ≤
        partialTestStepGain w H C j s M e +
          partialTestStepLoss w H C j s M e by linarith).trans
    apply hsum.trans
    apply (sum_testExtension_le_card_mul_trackable _ hw hj
      (Finset.sdiff_subset.trans (availableEdges_subset H C M))).trans
    exact mul_le_mul_of_nonneg_right (hspread e he)
      (div_nonneg (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg hd _))

/-! A sharp choice-averaged second moment.  In contrast to the crude
pointwise-square bound, this retains the small mean transition
multiplicity (and hence the essential `1/N`). -/

theorem meanPartialTestGain_add_loss_le_of_aggregateMultiplicity
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    {gainLo gainHi lossLo lossHi : ℝ}
    (hA : (availableEdges H C M).Nonempty)
    (hmult : HasPartialTestAggregateMultiplicityBounds
      w H C M j s gainLo gainHi lossLo lossHi) :
    meanPartialTestGain w H C j s M +
        meanPartialTestLoss w H C j s M ≤
      (gainHi * partialTestObservable w H C j (s + 1) M +
        lossHi * partialTestObservable w H C j s M) /
          ((availableEdges H C M).card : ℝ) := by
  have hAne : availableEdges H C M ≠ ∅ := hA.ne_empty
  have hcard : 0 < ((availableEdges H C M).card : ℝ) := by
    exact_mod_cast Finset.card_pos.mpr hA
  simp only [meanPartialTestGain, meanPartialTestLoss, hAne, if_false]
  rw [sum_partialTestStepGain_eq_weightedChoiceCount,
    sum_partialTestStepLoss_eq_weightedChoiceCount]
  rw [← add_div]
  exact (div_le_div_iff_of_pos_right hcard).2
    (add_le_add hmult.2.1 hmult.2.2.2)

theorem meanSqPartialTestIncrement_le_of_aggregateMultiplicity
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    {gainLo gainHi lossLo lossHi cap : ℝ}
    (hw : ∀ S, 0 ≤ w S) (hcap0 : 0 ≤ cap)
    (hA : (availableEdges H C M).Nonempty)
    (hmult : HasPartialTestAggregateMultiplicityBounds
      w H C M j s gainLo gainHi lossLo lossHi)
    (hgainCap : ∀ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e ≤ cap)
    (hlossCap : ∀ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e ≤ cap) :
    meanSqPartialTestIncrement w H C j s M ≤
      cap *
        ((gainHi * partialTestObservable w H C j (s + 1) M +
          lossHi * partialTestObservable w H C j s M) /
            ((availableEdges H C M).card : ℝ)) := by
  exact (meanSqPartialTestIncrement_le_cap_mul_meanGain_add_meanLoss
      w H C M j s hw hgainCap hlossCap).trans
    (mul_le_mul_of_nonneg_left
      (meanPartialTestGain_add_loss_le_of_aggregateMultiplicity
        w H C M j s hA hmult) hcap0)

end Erdos136

namespace Erdos136.CFMNumeric

open Filter Finset Real Set
open CFMTrajectories CFMRegularization
open scoped BigOperators Topology

noncomputable section

/-! Numeric package for the regularized random-greedy core. -/

def coreEpsilon (eta : ℝ) : ℝ := rawRegularizationEps eta / 5

def publicError (eta d : ℝ) : ℝ := d ^ (-(eta ^ 3))

/-- Stopping with `publicError / 16`, rather than `publicError`, is needed
for all public test ranks `1,2,3` to fit in the same relative-error window. -/
def stoppingMargin (eta d : ℝ) : ℝ := publicError eta d / 16

/-- The factor two is the loss from rounding the real stopping time up. -/
def trajectoryFloor (eta d : ℝ) : ℝ := publicError eta d / 32

/-- A conservative common power for the three Freedman tail families. -/
def tailPower (eta : ℝ) : ℝ := coreEpsilon eta / 1000

/-- These are precisely the strict exponent gaps used by the finite cutoff. -/
structure CoreExponentSpec (eta Gamma : ℝ) : Prop where
  eta_pos : 0 < eta
  eta_lt_one : eta < 1
  Gamma_one : 1 ≤ Gamma
  xi_gap : 0 < coreEpsilon eta / 64 - 19200 * Gamma * eta ^ 3
  terminal_gap :
    0 < coreEpsilon eta / 32 - (9600 * Gamma + 1) * eta ^ 3
  test_vertex_gap : 0 < coreEpsilon eta / 512 - 14 * eta ^ 3
  degree_gap : 0 < eta - 2 * eta ^ 3 - coreEpsilon eta
  delta_gap : 0 < eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64
  zeta_gap : 0 < eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100
  entropy_gap : eta ^ 3 < tailPower eta

/-- An explicit (deliberately very small) eta range makes every exponent
gap positive.  The dependence on `Gamma` is harmless because `Gamma` is a
fixed certificate constant before the outer eta cutoff is selected. -/
theorem coreExponentSpec_of_small
    {eta Gamma : ℝ} (hGamma : 1 ≤ Gamma) (heta : 0 < eta)
    (hsmall : eta < 1 / (1000000000000 * Gamma)) :
    CoreExponentSpec eta Gamma := by
  have hGamma0 : 0 < Gamma := lt_of_lt_of_le zero_lt_one hGamma
  have hden : 0 < 1000000000000 * Gamma := mul_pos (by norm_num) hGamma0
  have hmul : eta * (1000000000000 * Gamma) < 1 :=
    (lt_div_iff₀ hden).mp hsmall
  have heta1 : eta < 1 := by
    have hdenOne : 1 ≤ 1000000000000 * Gamma := by nlinarith
    nlinarith
  have heta2 : eta ^ 2 < eta := by nlinarith [sq_nonneg eta]
  have hGeta2 : Gamma * eta ^ 2 < 1 / 1000000000000 := by
    have hGeta : Gamma * eta < 1 / 1000000000000 := by
      apply (lt_div_iff₀ (by norm_num : (0 : ℝ) < 1000000000000)).2
      nlinarith [hmul]
    nlinarith [mul_lt_mul_of_pos_left heta2 hGamma0]
  have heta2small : eta ^ 2 < 1 / 1000000000000 :=
    lt_of_le_of_lt (by nlinarith [hGamma]) hGeta2
  have hcore : coreEpsilon eta = eta / 50000 := by
    simp only [coreEpsilon, rawRegularizationEps]
    ring
  have htail : tailPower eta = eta / 50000000 := by
    rw [tailPower, hcore]
    ring
  refine
    { eta_pos := heta
      eta_lt_one := heta1
      Gamma_one := hGamma
      xi_gap := ?_
      terminal_gap := ?_
      test_vertex_gap := ?_
      degree_gap := ?_
      delta_gap := ?_
      zeta_gap := ?_
      entropy_gap := ?_ }
  · rw [hcore]
    nlinarith
  · rw [hcore]
    nlinarith
  · rw [hcore]
    nlinarith
  · rw [hcore]
    nlinarith
  · rw [hcore]
    nlinarith
  · rw [hcore]
    nlinarith
  · rw [htail]
    nlinarith

inductive CoreRequirement
  | degreeAtLeastTwo
  | inverseInputSmall
  | roundingSlack
  | stopExponentFloor
  | correctionDenominator
  | xiUpperAbsorption
  | xiTerminalAbsorption
  | deltaHazardAbsorption
  | testHazardAbsorption
  | deltaHazardExponential
  | testHazardExponential
  | degreeSecondOrder
  | deltaSecondOrder
  | testInsideUpper
  | zetaMainSecondOrder
  | zetaMixedSecondOrder
  | envelopeFifth
  | terminalXiFromCore
  | killedWeightAbsorption
  | entropyPower
  | entropyLog
  deriving DecidableEq

/-- The scalar entries are chosen so that `N ≥ d^eta/2` and
`P = d^(-eta^3)/32` imply the actual degree/delta/test curvature bounds. -/
def coreRegistry (eta Gamma : ℝ) (h : CoreExponentSpec eta Gamma) :
    LargeDRegistry CoreRequirement where
  active := { .degreeAtLeastTwo, .inverseInputSmall, .roundingSlack, .stopExponentFloor,
    .correctionDenominator, .xiUpperAbsorption, .xiTerminalAbsorption,
    .deltaHazardAbsorption, .testHazardAbsorption, .deltaHazardExponential,
    .testHazardExponential, .degreeSecondOrder,
    .deltaSecondOrder, .testInsideUpper, .zetaMainSecondOrder, .zetaMixedSecondOrder,
    .envelopeFifth, .terminalXiFromCore, .killedWeightAbsorption,
    .entropyPower, .entropyLog }
  condition r d := match r with
    | .degreeAtLeastTwo => 2 ≤ d
    | .inverseInputSmall => d ^ (-eta) ≤ 1 / 2
    | .roundingSlack => 512 < d ^ (eta - eta ^ 3)
    | .stopExponentFloor => 32 ≤ d ^ (eta ^ 3)
    | .correctionDenominator =>
        4 * Gamma ≤ d ^ (coreEpsilon eta / 64)
    | .xiUpperAbsorption =>
        32 ^ (9600 * Gamma) ≤
          d ^ (coreEpsilon eta / 64 - 9600 * Gamma * eta ^ 3)
    | .xiTerminalAbsorption =>
        16 * 32 ^ (9600 * Gamma) ≤
          d ^ (coreEpsilon eta / 32 - (9600 * Gamma + 1) * eta ^ 3)
    | .deltaHazardAbsorption =>
        32 ^ 7 * Real.exp (3 * Gamma) ≤
          d ^ (coreEpsilon eta / 64 - 7 * eta ^ 3)
    | .testHazardAbsorption =>
        32 ^ 7 * Real.exp (3 * Gamma) ≤
          d ^ (coreEpsilon eta / 512 - 7 * eta ^ 3)
    | .deltaHazardExponential =>
        Real.exp (3 * Gamma) ≤ d ^ (coreEpsilon eta / 64)
    | .testHazardExponential =>
        Real.exp (3 * Gamma) ≤ d ^ (coreEpsilon eta / 512)
    | .degreeSecondOrder =>
        4096000000 * Gamma ^ 2 ≤
          d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta)
    | .deltaSecondOrder =>
        12288000000000 * Gamma ^ 2 ≤
          d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64)
    | .testInsideUpper =>
        12 ≤ d ^ (9 * coreEpsilon eta / 1600)
    | .zetaMainSecondOrder =>
        10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) ≤
          d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100)
    | .zetaMixedSecondOrder =>
        10240 * (2 * 76800 * 5000 * Gamma ^ 2 + 1000000 * Gamma ^ 2) ≤
          d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64)
    | .envelopeFifth => 5 ≤ d ^ (coreEpsilon eta / 64)
    | .terminalXiFromCore =>
        16 ≤ d ^ (coreEpsilon eta / 64 - eta ^ 3)
    | .killedWeightAbsorption =>
        4 ≤ d ^ (rawRegularizationEps eta - eta ^ 3)
    | .entropyPower =>
        48 * d ^ (eta ^ 3) ≤ d ^ (tailPower eta)
    | .entropyLog =>
        4 * Real.log 12 ≤ d ^ (tailPower eta)
  eventually_condition := by
    intro r _hr
    cases r with
    | degreeAtLeastTwo => exact eventually_ge_atTop 2
    | inverseInputSmall =>
        have hg : -eta < 0 := by linarith [h.eta_pos]
        have ha := eventually_const_mul_rpow_le_rpow_real 2 (-eta) 0 hg
        filter_upwards [ha] with d hd
        have hd' : 2 * Real.rpow d (-eta) ≤ 1 :=
          hd.trans_eq (Real.rpow_zero d)
        change Real.rpow d (-eta) ≤ 1 / 2
        nlinarith
    | roundingSlack =>
        have heta2 : eta ^ 2 < 1 := by
          have hp : 0 < (1 - eta) * (1 + eta) :=
            mul_pos (by linarith [h.eta_lt_one]) (by linarith [h.eta_pos])
          nlinarith
        have heta3 : eta ^ 3 < eta := by
          have hm := mul_lt_mul_of_pos_left heta2 h.eta_pos
          nlinarith
        filter_upwards [eventually_const_le_rpow_real 513
          (eta - eta ^ 3) (by linarith)] with d hd
        exact lt_of_lt_of_le (by norm_num) hd
    | stopExponentFloor =>
        exact eventually_const_le_rpow_real _ _ (by
          have heta := h.eta_pos
          positivity)
    | correctionDenominator =>
        exact eventually_const_le_rpow_real (4 * Gamma)
          (coreEpsilon eta / 64) (by
            dsimp [coreEpsilon, rawRegularizationEps]
            linarith [h.eta_pos])
    | xiUpperAbsorption =>
        exact eventually_const_le_rpow_real _ _ (by
          have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one h.Gamma_one
          have heta0 : 0 ≤ eta := h.eta_pos.le
          have hnonneg : 0 ≤ 9600 * Gamma * eta ^ 3 := by positivity
          linarith [h.xi_gap])
    | xiTerminalAbsorption =>
        exact eventually_const_le_rpow_real _ _ h.terminal_gap
    | deltaHazardAbsorption =>
        exact eventually_const_le_rpow_real _ _ (by
          have heps : 0 < coreEpsilon eta := by
            rw [show coreEpsilon eta = eta / 50000 by
              simp only [coreEpsilon, rawRegularizationEps]; ring]
            linarith [h.eta_pos]
          have heta0 : 0 ≤ eta := h.eta_pos.le
          have hnonneg : 0 ≤ 7 * eta ^ 3 := by positivity
          linarith [h.test_vertex_gap])
    | testHazardAbsorption =>
        exact eventually_const_le_rpow_real _ _ (by
          have heta0 : 0 ≤ eta := h.eta_pos.le
          have hnonneg : 0 ≤ 7 * eta ^ 3 := by positivity
          linarith [h.test_vertex_gap])
    | deltaHazardExponential =>
        exact eventually_const_le_rpow_real _ _ (by
          have heps : 0 < coreEpsilon eta := by
            rw [show coreEpsilon eta = eta / 50000 by
              simp only [coreEpsilon, rawRegularizationEps]; ring]
            linarith [h.eta_pos]
          positivity)
    | testHazardExponential =>
        exact eventually_const_le_rpow_real _ _ (by
          have heps : 0 < coreEpsilon eta := by
            rw [show coreEpsilon eta = eta / 50000 by
              simp only [coreEpsilon, rawRegularizationEps]; ring]
            linarith [h.eta_pos]
          positivity)
    | degreeSecondOrder =>
        exact eventually_const_le_rpow_real _ _ h.degree_gap
    | deltaSecondOrder =>
        exact eventually_const_le_rpow_real _ _ h.delta_gap
    | testInsideUpper =>
        exact eventually_const_le_rpow_real _ _ (by
          have heps : 0 < coreEpsilon eta := by
            rw [show coreEpsilon eta = eta / 50000 by
              simp only [coreEpsilon, rawRegularizationEps]; ring]
            linarith [h.eta_pos]
          positivity)
    | zetaMainSecondOrder =>
        exact eventually_const_le_rpow_real _ _ h.zeta_gap
    | zetaMixedSecondOrder =>
        exact eventually_const_le_rpow_real _ _ h.delta_gap
    | envelopeFifth =>
        exact eventually_const_le_rpow_real _ _ (by
          rw [show coreEpsilon eta = eta / 50000 by
            simp only [coreEpsilon, rawRegularizationEps]; ring]
          linarith [h.eta_pos])
    | terminalXiFromCore =>
        exact eventually_const_le_rpow_real _ _ (by
          have heps : 0 < coreEpsilon eta := by
            rw [show coreEpsilon eta = eta / 50000 by
              simp only [coreEpsilon, rawRegularizationEps]; ring]
            linarith [h.eta_pos]
          have ht : tailPower eta < coreEpsilon eta / 64 := by
            unfold tailPower
            nlinarith
          linarith [h.entropy_gap])
    | killedWeightAbsorption =>
        exact eventually_const_le_rpow_real _ _ (by
          have hraw : coreEpsilon eta < rawRegularizationEps eta := by
            simp only [coreEpsilon, rawRegularizationEps]
            nlinarith [h.eta_pos]
          have ht : tailPower eta < coreEpsilon eta := by
            unfold tailPower
            have heps : 0 < coreEpsilon eta := by
              rw [show coreEpsilon eta = eta / 50000 by
                simp only [coreEpsilon, rawRegularizationEps]; ring]
              linarith [h.eta_pos]
            nlinarith
          linarith [h.entropy_gap])
    | entropyPower =>
        exact eventually_const_mul_rpow_le_rpow_real 48 (eta ^ 3)
          (tailPower eta) h.entropy_gap
    | entropyLog =>
        exact eventually_const_le_rpow_real _ _ (by
          rw [show tailPower eta = eta / 50000000 by
            simp only [tailPower, coreEpsilon, rawRegularizationEps]; ring]
          linarith [h.eta_pos])

structure CoreCutoffSpec (eta Gamma d : ℝ) : Prop where
  degreeAtLeastTwo : 2 ≤ d
  inverseInputSmall : d ^ (-eta) ≤ 1 / 2
  roundingSlack : 512 < d ^ (eta - eta ^ 3)
  stopExponentFloor : 32 ≤ d ^ (eta ^ 3)
  correctionDenominator : 4 * Gamma ≤ d ^ (coreEpsilon eta / 64)
  xiUpperAbsorption :
    32 ^ (9600 * Gamma) ≤
      d ^ (coreEpsilon eta / 64 - 9600 * Gamma * eta ^ 3)
  xiTerminalAbsorption :
    16 * 32 ^ (9600 * Gamma) ≤
      d ^ (coreEpsilon eta / 32 - (9600 * Gamma + 1) * eta ^ 3)
  deltaHazardAbsorption :
    32 ^ 7 * Real.exp (3 * Gamma) ≤
      d ^ (coreEpsilon eta / 64 - 7 * eta ^ 3)
  testHazardAbsorption :
    32 ^ 7 * Real.exp (3 * Gamma) ≤
      d ^ (coreEpsilon eta / 512 - 7 * eta ^ 3)
  deltaHazardExponential :
    Real.exp (3 * Gamma) ≤ d ^ (coreEpsilon eta / 64)
  testHazardExponential :
    Real.exp (3 * Gamma) ≤ d ^ (coreEpsilon eta / 512)
  degreeSecondOrder :
    4096000000 * Gamma ^ 2 ≤
      d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta)
  deltaSecondOrder :
    12288000000000 * Gamma ^ 2 ≤
      d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64)
  testInsideUpper : 12 ≤ d ^ (9 * coreEpsilon eta / 1600)
  zetaMainSecondOrder :
    10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) ≤
      d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100)
  zetaMixedSecondOrder :
    10240 * (2 * 76800 * 5000 * Gamma ^ 2 + 1000000 * Gamma ^ 2) ≤
      d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64)
  envelopeFifth : 5 ≤ d ^ (coreEpsilon eta / 64)
  terminalXiFromCore : 16 ≤ d ^ (coreEpsilon eta / 64 - eta ^ 3)
  killedWeightAbsorption :
    4 ≤ d ^ (rawRegularizationEps eta - eta ^ 3)
  entropyPower : 48 * d ^ (eta ^ 3) ≤ d ^ (tailPower eta)
  entropyLog : 4 * Real.log 12 ≤ d ^ (tailPower eta)

theorem exists_coreCutoff (eta Gamma : ℝ) (h : CoreExponentSpec eta Gamma) :
    ∃ d0 : ℝ, ∀ d, d0 ≤ d → CoreCutoffSpec eta Gamma d := by
  let R := coreRegistry eta Gamma h
  obtain ⟨d0, hd0⟩ := R.exists_cutoff
  refine ⟨d0, fun d hd ↦ ?_⟩
  have hreq (r : CoreRequirement) : R.condition r d := by
    exact hd0 d hd r (by cases r <;> simp [R, coreRegistry])
  exact {
    degreeAtLeastTwo := hreq .degreeAtLeastTwo
    inverseInputSmall := hreq .inverseInputSmall
    roundingSlack := hreq .roundingSlack
    stopExponentFloor := hreq .stopExponentFloor
    correctionDenominator := hreq .correctionDenominator
    xiUpperAbsorption := hreq .xiUpperAbsorption
    xiTerminalAbsorption := hreq .xiTerminalAbsorption
    deltaHazardAbsorption := hreq .deltaHazardAbsorption
    testHazardAbsorption := hreq .testHazardAbsorption
    deltaHazardExponential := hreq .deltaHazardExponential
    testHazardExponential := hreq .testHazardExponential
    degreeSecondOrder := hreq .degreeSecondOrder
    deltaSecondOrder := hreq .deltaSecondOrder
    testInsideUpper := hreq .testInsideUpper
    zetaMainSecondOrder := hreq .zetaMainSecondOrder
    zetaMixedSecondOrder := hreq .zetaMixedSecondOrder
    envelopeFifth := hreq .envelopeFifth
    terminalXiFromCore := hreq .terminalXiFromCore
    killedWeightAbsorption := hreq .killedWeightAbsorption
    entropyPower := hreq .entropyPower
    entropyLog := hreq .entropyLog }

theorem publicError_mul_rpow_eta
    {eta d : ℝ} (hd : 0 < d) :
    publicError eta d * d ^ eta = d ^ (eta - eta ^ 3) := by
  rw [publicError, ← Real.rpow_add hd]
  congr 1
  ring

/-- The host-size lower bound forced by host degrees and pair codegrees
turns the cutoff entry into enough room for both ceiling and a factor-two
trajectory floor. -/
theorem stoppingMargin_mul_host_gt_sixteen
    {eta Gamma d N : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    16 < stoppingMargin eta d * N := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have herr0 : 0 ≤ publicError eta d := Real.rpow_nonneg hd.le _
  have hmu0 : 0 ≤ stoppingMargin eta d := by
    exact div_nonneg herr0 (by norm_num)
  have hmul := mul_le_mul_of_nonneg_left hN hmu0
  calc
    16 < d ^ (eta - eta ^ 3) / 32 := by nlinarith [S.roundingSlack]
    _ = stoppingMargin eta d * (d ^ eta / 2) := by
      rw [stoppingMargin, ← publicError_mul_rpow_eta hd]
      ring
    _ ≤ stoppingMargin eta d * N := by
      simpa [stoppingMargin] using hmul

theorem publicError_le_one
    {eta d : ℝ} (heta : 0 ≤ eta) (hd : 1 ≤ d) :
    publicError eta d ≤ 1 := by
  apply Real.rpow_le_one_of_one_le_of_nonpos hd
  have : 0 ≤ eta ^ 3 := by positivity
  linarith

/-- Exact floor at the rounded, strengthened stopping time. -/
theorem pV_at_ceil_stoppingMargin_gt_floor
    (eta Gamma d : ℝ) (N : ℕ)
    (S : CoreCutoffSpec eta Gamma d) (heta : 0 < eta)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ)) :
    trajectoryFloor eta d <
      pV (N : ℝ)
        (Nat.ceil ((1 - stoppingMargin eta d) * (N : ℝ) / 8) : ℝ) := by
  let mu := stoppingMargin eta d
  let T := Nat.ceil ((1 - mu) * (N : ℝ) / 8)
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNprod : 16 < mu * (N : ℝ) := by
    simpa only [mu] using stoppingMargin_mul_host_gt_sixteen S hNlower
  have hNpos : 0 < (N : ℝ) := by
    have hp : 0 < d ^ eta / 2 := by positivity
    exact hp.trans_le hNlower
  have hmu0 : 0 ≤ mu := by
    dsimp [mu, stoppingMargin, publicError]
    positivity
  have hmu1 : mu ≤ 1 := by
    have he := publicError_le_one (eta := eta) (d := d) heta.le
      (by linarith [S.degreeAtLeastTwo])
    dsimp [mu, stoppingMargin]
    linarith
  have hx0 : 0 ≤ (1 - mu) * (N : ℝ) / 8 := by positivity
  have hceil : (T : ℝ) < (1 - mu) * (N : ℝ) / 8 + 1 := by
    dsimp only [T]
    exact Nat.ceil_lt_add_one hx0
  have hscaled : 8 * (T : ℝ) < (1 - mu) * (N : ℝ) + 8 := by
    nlinarith
  have hnormalized :
      8 * (T : ℝ) / (N : ℝ) < 1 - mu + 8 / (N : ℝ) := by
    apply (div_lt_iff₀ hNpos).2
    calc
      8 * (T : ℝ) < (1 - mu) * (N : ℝ) + 8 := hscaled
      _ = (1 - mu + 8 / (N : ℝ)) * (N : ℝ) := by
        field_simp
  have hover : 8 / (N : ℝ) < mu / 2 := by
    apply (div_lt_iff₀ hNpos).2
    nlinarith
  have hpV : mu / 2 < pV (N : ℝ) (T : ℝ) := by
    unfold pV
    linarith
  have hfloor : trajectoryFloor eta d = mu / 2 := by
    simp only [trajectoryFloor, mu, stoppingMargin]
    ring
  rw [hfloor]
  simpa only [T] using hpV

/-- The same floor is uniform on every unit step preceding the target. -/
theorem pV_floor_on_step_before_ceil
    (eta Gamma d : ℝ) (N k : ℕ) (x : ℝ)
    (S : CoreCutoffSpec eta Gamma d) (heta : 0 < eta)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (hk : k < Nat.ceil ((1 - stoppingMargin eta d) * (N : ℝ) / 8))
    (hx : x ∈ Icc (k : ℝ) ((k : ℝ) + 1)) :
    trajectoryFloor eta d < pV (N : ℝ) x := by
  let T := Nat.ceil ((1 - stoppingMargin eta d) * (N : ℝ) / 8)
  have hNpos : 0 < (N : ℝ) := by
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
    exact (show 0 < d ^ eta / 2 by positivity).trans_le hNlower
  have hxT : x ≤ (T : ℝ) := by
    have hkT : k + 1 ≤ T := by omega
    exact hx.2.trans (by exact_mod_cast hkT)
  have hmono : pV (N : ℝ) (T : ℝ) ≤ pV (N : ℝ) x := by
    unfold pV
    have hdiv : 8 * x / (N : ℝ) ≤ 8 * (T : ℝ) / (N : ℝ) :=
      div_le_div_of_nonneg_right (by nlinarith) hNpos.le
    linarith
  exact (pV_at_ceil_stoppingMargin_gt_floor eta Gamma d N S heta hNlower).trans_le
    (by simpa only [T] using hmono)

theorem trajectoryFloor_sq
    {eta d : ℝ} (hd : 0 < d) :
    trajectoryFloor eta d ^ 2 = d ^ (-2 * eta ^ 3) / 1024 := by
  unfold trajectoryFloor publicError
  rw [div_pow, pow_two, ← Real.rpow_add hd]
  congr 1
  · ring_nf
  · norm_num

/-- The common denominator lower bound behind every curvature estimate. -/
theorem host_mul_floor_sq_lower
    {eta d N : ℝ} (hd : 0 < d)
    (hN : d ^ eta / 2 ≤ N) :
    d ^ (eta - 2 * eta ^ 3) / 2048 ≤
      N * trajectoryFloor eta d ^ 2 := by
  have hP0 : 0 ≤ trajectoryFloor eta d ^ 2 := sq_nonneg _
  have hm := mul_le_mul_of_nonneg_right hN hP0
  calc
    d ^ (eta - 2 * eta ^ 3) / 2048 =
        (d ^ eta / 2) * trajectoryFloor eta d ^ 2 := by
      rw [trajectoryFloor_sq hd]
      have hp : d ^ (eta - 2 * eta ^ 3) =
          d ^ eta * d ^ (-2 * eta ^ 3) := by
        rw [← Real.rpow_add hd]
        congr 1
        ring
      rw [hp]
      ring
    _ ≤ N * trajectoryFloor eta d ^ 2 := hm

theorem degreeLargeDCondition_of_cutoff
    {eta Gamma d N : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    degreeLargeDCondition Gamma (coreEpsilon eta) d N
      (trajectoryFloor eta d) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hNP := host_mul_floor_sq_lower hd hN
  have hconst : 24576000 * Gamma ^ 2 ≤
      d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) := by
    calc
      24576000 * Gamma ^ 2 ≤ 4096000000 * Gamma ^ 2 := by
        gcongr
        norm_num
      _ ≤ _ := S.degreeSecondOrder
  have hcross : 12000 * Gamma ^ 2 * d ≤
      d ^ (1 - coreEpsilon eta) *
        (N * trajectoryFloor eta d ^ 2) := by
    calc
      12000 * Gamma ^ 2 * d = (24576000 * Gamma ^ 2) * d / 2048 := by ring
      _ ≤ d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) * d / 2048 := by
        gcongr
      _ = d ^ (1 - coreEpsilon eta) *
          (d ^ (eta - 2 * eta ^ 3) / 2048) := by
        calc
          d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) * d / 2048 =
              d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) *
                d ^ (1 : ℝ) / 2048 := by rw [Real.rpow_one]
          _ =
              d ^ ((eta - 2 * eta ^ 3 - coreEpsilon eta) + 1) / 2048 := by
            rw [← Real.rpow_add hd]
          _ = d ^ ((1 - coreEpsilon eta) + (eta - 2 * eta ^ 3)) / 2048 := by
            congr 2
            ring
          _ = (d ^ (1 - coreEpsilon eta) *
              d ^ (eta - 2 * eta ^ 3)) / 2048 := by
            rw [Real.rpow_add hd]
          _ = d ^ (1 - coreEpsilon eta) *
              (d ^ (eta - 2 * eta ^ 3) / 2048) := by ring
      _ ≤ d ^ (1 - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) :=
        mul_le_mul_of_nonneg_left hNP (Real.rpow_nonneg hd.le _)
  unfold degreeLargeDCondition
  rw [div_le_div_iff₀
    (mul_pos (sq_pos_of_pos hNpos) (sq_pos_of_pos hPpos)) hNpos]
  calc
    12000 * Gamma ^ 2 * d * N ≤
        (d ^ (1 - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2)) * N :=
      mul_le_mul_of_nonneg_right hcross hNpos.le
    _ = d ^ (1 - coreEpsilon eta) *
        (N ^ 2 * trajectoryFloor eta d ^ 2) := by ring

theorem deltaLargeDCondition_of_cutoff
    {eta Gamma d N : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    deltaLargeDCondition Gamma (coreEpsilon eta) d N
      (trajectoryFloor eta d) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hNP := host_mul_floor_sq_lower hd hN
  have hcross :
      6000000000 * Gamma ^ 2 * d ^ (1 - coreEpsilon eta / 64) ≤
        d ^ (1 - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) := by
    calc
      6000000000 * Gamma ^ 2 * d ^ (1 - coreEpsilon eta / 64) =
          (12288000000000 * Gamma ^ 2) *
            d ^ (1 - coreEpsilon eta / 64) / 2048 := by ring
      _ ≤ d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) *
            d ^ (1 - coreEpsilon eta / 64) / 2048 := by
        gcongr
        exact S.deltaSecondOrder
      _ = d ^ (1 - coreEpsilon eta) *
          (d ^ (eta - 2 * eta ^ 3) / 2048) := by
        calc
          d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) *
                d ^ (1 - coreEpsilon eta / 64) / 2048 =
              d ^ ((eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) +
                (1 - coreEpsilon eta / 64)) / 2048 := by
            rw [← Real.rpow_add hd]
          _ = d ^ ((1 - coreEpsilon eta) + (eta - 2 * eta ^ 3)) / 2048 := by
            congr 2
            ring
          _ = (d ^ (1 - coreEpsilon eta) *
              d ^ (eta - 2 * eta ^ 3)) / 2048 := by
            rw [Real.rpow_add hd]
          _ = d ^ (1 - coreEpsilon eta) *
              (d ^ (eta - 2 * eta ^ 3) / 2048) := by ring
      _ ≤ d ^ (1 - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) :=
        mul_le_mul_of_nonneg_left hNP (Real.rpow_nonneg hd.le _)
  unfold deltaLargeDCondition
  rw [div_le_div_iff₀
    (mul_pos (sq_pos_of_pos hNpos) (sq_pos_of_pos hPpos)) hNpos]
  calc
    6000000000 * Gamma ^ 2 * d ^ (1 - coreEpsilon eta / 64) * N ≤
        (d ^ (1 - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2)) * N :=
      mul_le_mul_of_nonneg_right hcross hNpos.le
    _ = d ^ (1 - coreEpsilon eta) *
        (N ^ 2 * trajectoryFloor eta d ^ 2) := by ring

theorem testInsideUpper_of_cutoff
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (j s : ℕ) :
    12 * d ^ ((s : ℝ) - j) ≤
      d ^ ((s : ℝ) - j + 9 * coreEpsilon eta / 1600) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  calc
    12 * d ^ ((s : ℝ) - j) ≤
        d ^ (9 * coreEpsilon eta / 1600) * d ^ ((s : ℝ) - j) :=
      mul_le_mul_of_nonneg_right S.testInsideUpper (Real.rpow_nonneg hd.le _)
    _ = d ^ ((s : ℝ) - j + 9 * coreEpsilon eta / 1600) := by
      rw [← Real.rpow_add hd]
      congr 1
      ring

theorem zHatSecondOrder_of_cutoff
    {eta Gamma d N : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) {j s : ℕ} (hsj : s ≤ j) :
    2000000 * (Gamma / (N * trajectoryFloor eta d)) ^ 2 *
        (d⁻¹) ^ (j - s) ≤
      d ^ ((s : ℝ) - j - coreEpsilon eta) / N := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hNP := host_mul_floor_sq_lower hd hN
  have hcoeff : 2000000 * Gamma ^ 2 ≤
      d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) / 2048 := by
    rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 2048)]
    calc
      2000000 * Gamma ^ 2 * 2048 = 4096000000 * Gamma ^ 2 := by ring
      _ ≤ _ := S.degreeSecondOrder
  have hcross :
      2000000 * Gamma ^ 2 * d ^ ((s : ℝ) - j) ≤
        d ^ ((s : ℝ) - j - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) := by
    calc
      2000000 * Gamma ^ 2 * d ^ ((s : ℝ) - j) ≤
          (d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) / 2048) *
            d ^ ((s : ℝ) - j) :=
        mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hd.le _)
      _ = d ^ ((s : ℝ) - j - coreEpsilon eta) *
          (d ^ (eta - 2 * eta ^ 3) / 2048) := by
        calc
          d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) / 2048 *
                d ^ ((s : ℝ) - j) =
              (d ^ (eta - 2 * eta ^ 3 - coreEpsilon eta) *
                d ^ ((s : ℝ) - j)) / 2048 := by ring
          _ = d ^ ((eta - 2 * eta ^ 3) +
                ((s : ℝ) - j - coreEpsilon eta)) / 2048 := by
            rw [← Real.rpow_add hd]
            congr 2
            ring
          _ = (d ^ ((s : ℝ) - j - coreEpsilon eta) *
                d ^ (eta - 2 * eta ^ 3)) / 2048 := by
            rw [← Real.rpow_add hd]
            congr 2
            ring
          _ = d ^ ((s : ℝ) - j - coreEpsilon eta) *
              (d ^ (eta - 2 * eta ^ 3) / 2048) := by ring
      _ ≤ d ^ ((s : ℝ) - j - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) :=
        mul_le_mul_of_nonneg_left hNP (Real.rpow_nonneg hd.le _)
  rw [inv_pow_eq_rpow_sub hd hsj]
  have hrewrite :
      2000000 * (Gamma / (N * trajectoryFloor eta d)) ^ 2 *
          d ^ ((s : ℝ) - j) =
        (2000000 * Gamma ^ 2 * d ^ ((s : ℝ) - j)) /
          (N ^ 2 * trajectoryFloor eta d ^ 2) := by
    field_simp
  rw [hrewrite, div_le_div_iff₀
    (mul_pos (sq_pos_of_pos hNpos) (sq_pos_of_pos hPpos)) hNpos]
  calc
    2000000 * Gamma ^ 2 * d ^ ((s : ℝ) - j) * N ≤
        (d ^ ((s : ℝ) - j - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2)) * N :=
      mul_le_mul_of_nonneg_right hcross hNpos.le
    _ = d ^ ((s : ℝ) - j - coreEpsilon eta) *
        (N ^ 2 * trajectoryFloor eta d ^ 2) := by ring

/-! ## Source constructors with an independent stopping exponent -/

theorem xi_source_bounds_stopExponent
    {Gamma epsilon sigma d N y : ℝ}
    (hd : 1 ≤ d) (hGamma : 1 ≤ Gamma) (hepsilon : 0 ≤ epsilon)
    (hpV : 0 < pV N y) (hpV1 : pV N y ≤ 1)
    (hpVfloor : d ^ (-sigma) ≤ pV N y)
    (hamp : 9600 * Gamma * sigma ≤ epsilon / 64) :
    d ^ (-epsilon / 32) ≤ xi Gamma epsilon d N y ∧
      xi Gamma epsilon d N y ≤ d ^ (-epsilon / 64) := by
  have hdpos : 0 < d := lt_of_lt_of_le (by norm_num) hd
  have hfacLower : 1 ≤ pV N y ^ (-9600 * Gamma) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos hpV hpV1 (by nlinarith)
  have hbasepos : 0 < d ^ (-sigma) := Real.rpow_pos_of_pos hdpos _
  have hfacUpper : pV N y ^ (-9600 * Gamma) ≤
      (d ^ (-sigma)) ^ (-9600 * Gamma) :=
    Real.rpow_le_rpow_of_nonpos hbasepos hpVfloor (by nlinarith)
  constructor
  · unfold xi
    calc
      d ^ (-epsilon / 32) = 1 * d ^ (-epsilon / 32) := by ring
      _ ≤ pV N y ^ (-9600 * Gamma) * d ^ (-epsilon / 32) :=
        mul_le_mul_of_nonneg_right hfacLower (Real.rpow_nonneg hdpos.le _)
  · unfold xi
    calc
      pV N y ^ (-9600 * Gamma) * d ^ (-epsilon / 32) ≤
          (d ^ (-sigma)) ^ (-9600 * Gamma) * d ^ (-epsilon / 32) :=
        mul_le_mul_of_nonneg_right hfacUpper (Real.rpow_nonneg hdpos.le _)
      _ = d ^ (9600 * Gamma * sigma - epsilon / 32) := by
        rw [← Real.rpow_mul hdpos.le, ← Real.rpow_add hdpos]
        congr 1
        ring
      _ ≤ d ^ (-epsilon / 64) :=
        Real.rpow_le_rpow_of_exponent_le hd (by nlinarith)

theorem dHat_source_lower_stopExponent
    {D₂ D₃ D₄ Gamma epsilon sigma d N y : ℝ}
    (hd : 1 ≤ d) (hGamma : 1 ≤ Gamma)
    (hpV : 0 < pV N y) (hpVfloor : d ^ (-sigma) ≤ pV N y)
    (hpM0 : 0 ≤ pM d N y) (hpM1 : pM d N y ≤ d⁻¹)
    (hD₂0 : 0 ≤ D₂) (hD₃0 : 0 ≤ D₃) (hD₄0 : 0 ≤ D₄)
    (hD₂ : D₂ ≤ Gamma * d) (hD₃ : D₃ ≤ Gamma * d ^ 2)
    (hD₄ : D₄ ≤ Gamma * d ^ 3)
    (hvertex : 7 * sigma ≤ epsilon / 64)
    (hexp : d ^ (-epsilon / 64) ≤ exp (-3 * Gamma)) :
    d ^ (1 - epsilon / 32) ≤ dHat D₂ D₃ D₄ d N y := by
  have hdpos : 0 < d := lt_of_lt_of_le (by norm_num) hd
  have hGH := GammaHat_le_three_mul hdpos (by linarith) hpM0 hpM1
    hD₂0 hD₃0 hD₄0 hD₂ hD₃ hD₄
  have hexp' : exp (-3 * Gamma) ≤ exp (-GammaHat D₂ D₃ D₄ d N y) := by
    rw [Real.exp_le_exp]
    linarith
  have hbase0 : 0 ≤ d ^ (-sigma) := Real.rpow_nonneg hdpos.le _
  have hpVpow : (d ^ (-sigma)) ^ 7 ≤ pV N y ^ 7 :=
    pow_le_pow_left₀ hbase0 hpVfloor 7
  have hpower : d ^ (1 - epsilon / 32) ≤
      d ^ (1 - 7 * sigma - epsilon / 64) :=
    Real.rpow_le_rpow_of_exponent_le hd (by nlinarith)
  have hid : d ^ (1 - 7 * sigma - epsilon / 64) =
      d * (d ^ (-sigma)) ^ 7 * d ^ (-epsilon / 64) := by
    calc
      _ = d ^ (1 : ℝ) * d ^ ((-sigma) * (7 : ℝ)) *
          d ^ (-epsilon / 64) := by
        rw [← Real.rpow_add hdpos, ← Real.rpow_add hdpos]
        congr 1
        ring
      _ = d * (d ^ (-sigma)) ^ 7 * d ^ (-epsilon / 64) := by
        rw [Real.rpow_one, Real.rpow_mul hdpos.le]
        exact congrArg (fun z : ℝ ↦ d * z * d ^ (-epsilon / 64))
          (Real.rpow_natCast (d ^ (-sigma)) 7)
  unfold dHat
  calc
    d ^ (1 - epsilon / 32) ≤ d ^ (1 - 7 * sigma - epsilon / 64) := hpower
    _ = d * (d ^ (-sigma)) ^ 7 * d ^ (-epsilon / 64) := hid
    _ ≤ d * pV N y ^ 7 * d ^ (-epsilon / 64) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpVpow hdpos.le)
        (Real.rpow_nonneg hdpos.le _)
    _ ≤ d * pV N y ^ 7 * exp (-3 * Gamma) :=
      mul_le_mul_of_nonneg_left hexp (mul_nonneg hdpos.le (pow_nonneg hpV.le _))
    _ ≤ d * pV N y ^ 7 * exp (-GammaHat D₂ D₃ D₄ d N y) :=
      mul_le_mul_of_nonneg_left hexp'
        (mul_nonneg hdpos.le (pow_nonneg hpV.le _))

theorem dHat_source_lower_strong_stopExponent
    {D₂ D₃ D₄ Gamma epsilon sigma d N y : ℝ}
    (hd : 1 ≤ d) (hGamma : 1 ≤ Gamma)
    (hpV : 0 < pV N y) (hpVfloor : d ^ (-sigma) ≤ pV N y)
    (hpM0 : 0 ≤ pM d N y) (hpM1 : pM d N y ≤ d⁻¹)
    (hD₂0 : 0 ≤ D₂) (hD₃0 : 0 ≤ D₃) (hD₄0 : 0 ≤ D₄)
    (hD₂ : D₂ ≤ Gamma * d) (hD₃ : D₃ ≤ Gamma * d ^ 2)
    (hD₄ : D₄ ≤ Gamma * d ^ 3)
    (hvertex : 7 * sigma ≤ epsilon / 512)
    (hexp : d ^ (-epsilon / 512) ≤ exp (-3 * Gamma)) :
    d ^ (1 - epsilon / 256) ≤ dHat D₂ D₃ D₄ d N y := by
  have hdpos : 0 < d := lt_of_lt_of_le (by norm_num) hd
  have hGH := GammaHat_le_three_mul hdpos (by linarith) hpM0 hpM1
    hD₂0 hD₃0 hD₄0 hD₂ hD₃ hD₄
  have hexp' : exp (-3 * Gamma) ≤ exp (-GammaHat D₂ D₃ D₄ d N y) := by
    rw [Real.exp_le_exp]
    linarith
  have hbase0 : 0 ≤ d ^ (-sigma) := Real.rpow_nonneg hdpos.le _
  have hpVpow : (d ^ (-sigma)) ^ 7 ≤ pV N y ^ 7 :=
    pow_le_pow_left₀ hbase0 hpVfloor 7
  have hpower : d ^ (1 - epsilon / 256) ≤
      d ^ (1 - 7 * sigma - epsilon / 512) :=
    Real.rpow_le_rpow_of_exponent_le hd (by nlinarith)
  have hid : d ^ (1 - 7 * sigma - epsilon / 512) =
      d * (d ^ (-sigma)) ^ 7 * d ^ (-epsilon / 512) := by
    calc
      _ = d ^ (1 : ℝ) * d ^ ((-sigma) * (7 : ℝ)) *
          d ^ (-epsilon / 512) := by
        rw [← Real.rpow_add hdpos, ← Real.rpow_add hdpos]
        congr 1
        ring
      _ = d * (d ^ (-sigma)) ^ 7 * d ^ (-epsilon / 512) := by
        rw [Real.rpow_one, Real.rpow_mul hdpos.le]
        exact congrArg (fun z : ℝ ↦ d * z * d ^ (-epsilon / 512))
          (Real.rpow_natCast (d ^ (-sigma)) 7)
  unfold dHat
  calc
    d ^ (1 - epsilon / 256) ≤ d ^ (1 - 7 * sigma - epsilon / 512) := hpower
    _ = d * (d ^ (-sigma)) ^ 7 * d ^ (-epsilon / 512) := hid
    _ ≤ d * pV N y ^ 7 * d ^ (-epsilon / 512) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpVpow hdpos.le)
        (Real.rpow_nonneg hdpos.le _)
    _ ≤ d * pV N y ^ 7 * exp (-3 * Gamma) :=
      mul_le_mul_of_nonneg_left hexp (mul_nonneg hdpos.le (pow_nonneg hpV.le _))
    _ ≤ d * pV N y ^ 7 * exp (-GammaHat D₂ D₃ D₄ d N y) :=
      mul_le_mul_of_nonneg_left hexp'
        (mul_nonneg hdpos.le (pow_nonneg hpV.le _))

theorem DeltaStepRegistry.of_source_stopExponent
    {D₂ D₃ D₄ Gamma epsilon sigma d N x P : ℝ}
    (R : DegreeStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (hepsilon : 0 ≤ epsilon)
    (hstop : ∀ y ∈ Icc x (x + 1), d ^ (-sigma) ≤ pV N y)
    (hamp : 9600 * Gamma * sigma ≤ epsilon / 64)
    (hvertex : 7 * sigma ≤ epsilon / 64)
    (hexp : d ^ (-epsilon / 64) ≤ exp (-3 * Gamma))
    (hlarge : deltaLargeDCondition Gamma epsilon d N P) :
    DeltaStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P := by
  refine ⟨R, ?_, ?_, ?_, hlarge⟩
  · intro y hy
    exact (xi_source_bounds_stopExponent R.d_one R.Gamma_one hepsilon
      (pV_pos R.N_pos (R.before_end y hy))
      (pV_le_one R.N_pos (R.time_nonneg y hy)) (hstop y hy) hamp).1
  · intro y hy
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.d_one
    exact dHat_source_lower_stopExponent R.d_one R.Gamma_one
      (pV_pos R.N_pos (R.before_end y hy)) (hstop y hy)
      (pM_nonneg hd R.N_pos (R.time_nonneg y hy))
      (pM_le_inv hd R.N_pos (R.before_end y hy).le)
      R.D₂_nonneg R.D₃_nonneg R.D₄_nonneg R.D₂_bound R.D₃_bound R.D₄_bound
      hvertex hexp
  · intro y hy
    exact (xi_source_bounds_stopExponent R.d_one R.Gamma_one hepsilon
      (pV_pos R.N_pos (R.before_end y hy))
      (pV_le_one R.N_pos (R.time_nonneg y hy)) (hstop y hy) hamp).2

theorem TestStepRegistry.of_source_stopExponent
    {D₂ D₃ D₄ Gamma epsilon sigma d N x P : ℝ} {j s : ℕ}
    (R : DeltaStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (L : TestLargeDCondition Gamma epsilon d N P j s)
    (hepsilon : 0 ≤ epsilon)
    (hstop : ∀ y ∈ Icc x (x + 1), d ^ (-sigma) ≤ pV N y)
    (hvertex : 7 * sigma ≤ epsilon / 512)
    (hexp : d ^ (-epsilon / 512) ≤ exp (-3 * Gamma))
    (hsj : s ≤ j) (hj : j ≤ 4) :
    TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s := by
  refine ⟨R, hsj, hj, ?_, ?_, ?_, ?_⟩
  · intro y hy
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.degree.d_one
    have hpV := pV_pos R.degree.N_pos (R.degree.before_end y hy)
    have hpM0 := pM_nonneg hd R.degree.N_pos (R.degree.time_nonneg y hy)
    have hpM1 := pM_le_inv hd R.degree.N_pos (R.degree.before_end y hy).le
    have hdHatStrong := dHat_source_lower_strong_stopExponent
      R.degree.d_one R.degree.Gamma_one hpV (hstop y hy) hpM0 hpM1
      R.degree.D₂_nonneg R.degree.D₃_nonneg R.degree.D₄_nonneg
      R.degree.D₂_bound R.degree.D₃_bound R.degree.D₄_bound hvertex hexp
    exact testInside_source_lower R.degree.d_one R.degree.Gamma_one hepsilon
      hpV hpM0 hsj hj hdHatStrong L.correction_denominator
  · intro y hy
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.degree.d_one
    have hpV := pV_pos R.degree.N_pos (R.degree.before_end y hy)
    have hpV1 := pV_le_one R.degree.N_pos (R.degree.time_nonneg y hy)
    have hpM0 := pM_nonneg hd R.degree.N_pos (R.degree.time_nonneg y hy)
    have hpM1 := pM_le_inv hd R.degree.N_pos (R.degree.before_end y hy).le
    exact (testInside_source_upper R.degree.d_one R.degree.Gamma_one hpV hpV1
      hpM0 hpM1 R.degree.D₂_nonneg R.degree.D₃_nonneg R.degree.D₄_nonneg
      hsj hj).trans L.inside_upper
  · intro y hy
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.degree.d_one
    exact zHatCurvature_largeD R.degree.d_one R.degree.N_pos
      R.degree.Gamma_one R.degree.P_pos (R.degree.pV_floor y hy)
      (pV_le_one R.degree.N_pos (R.degree.time_nonneg y hy))
      (pM_nonneg hd R.degree.N_pos (R.degree.time_nonneg y hy))
      (pM_le_inv hd R.degree.N_pos (R.degree.before_end y hy).le)
      R.degree.D₂_nonneg R.degree.D₃_nonneg R.degree.D₄_nonneg
      R.degree.D₂_bound R.degree.D₃_bound R.degree.D₄_bound hsj hj
      L.zHat_second_order
  · intro y hy
    exact zetaCurvature_bound_at_step R L hy hsj hj

theorem TestStepRegistry.of_degree_source_stopExponent
    {D₂ D₃ D₄ Gamma epsilon sigma d N x P : ℝ} {j s : ℕ}
    (R : DegreeStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (L : TestLargeDCondition Gamma epsilon d N P j s)
    (hepsilon : 0 ≤ epsilon)
    (hstop : ∀ y ∈ Icc x (x + 1), d ^ (-sigma) ≤ pV N y)
    (hamp : 9600 * Gamma * sigma ≤ epsilon / 64)
    (hvertexDelta : 7 * sigma ≤ epsilon / 64)
    (hexpDelta : d ^ (-epsilon / 64) ≤ exp (-3 * Gamma))
    (hlargeDelta : deltaLargeDCondition Gamma epsilon d N P)
    (hvertexTest : 7 * sigma ≤ epsilon / 512)
    (hexpTest : d ^ (-epsilon / 512) ≤ exp (-3 * Gamma))
    (hsj : s ≤ j) (hj : j ≤ 4) :
    TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s := by
  exact TestStepRegistry.of_source_stopExponent
    (DeltaStepRegistry.of_source_stopExponent R hepsilon hstop hamp hvertexDelta
      hexpDelta hlargeDelta)
    L hepsilon hstop hvertexTest hexpTest hsj hj

/-! ## Closing the exact finite-test curvature budget -/

theorem zetaMainTerm_le_fifth
    {eta Gamma d N a : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    ((76800 * Gamma / (N * trajectoryFloor eta d)) ^ 2 +
        614400 * Gamma / (N ^ 2 * trajectoryFloor eta d ^ 2)) *
          d ^ (-coreEpsilon eta / 64) *
          d ^ (a + 9 * coreEpsilon eta / 1600) ≤
      (d ^ (a - coreEpsilon eta) / N) / 5 := by
  let A := (76800 * Gamma) ^ 2 + 614400 * Gamma
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hNP := host_mul_floor_sq_lower hd hN
  have hcoeff : 5 * A ≤
      d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100) / 2048 := by
    rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 2048)]
    calc
      5 * A * 2048 =
          10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := by
        simp only [A]
        ring
      _ ≤ _ := S.zetaMainSecondOrder
  have hcross : 5 * A * d ^ (a - coreEpsilon eta / 100) ≤
      d ^ (a - coreEpsilon eta) *
        (N * trajectoryFloor eta d ^ 2) := by
    calc
      5 * A * d ^ (a - coreEpsilon eta / 100) ≤
          (d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100) / 2048) *
            d ^ (a - coreEpsilon eta / 100) :=
        mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hd.le _)
      _ = d ^ (a - coreEpsilon eta) *
          (d ^ (eta - 2 * eta ^ 3) / 2048) := by
        calc
          d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100) / 2048 *
                d ^ (a - coreEpsilon eta / 100) =
              (d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100) *
                d ^ (a - coreEpsilon eta / 100)) / 2048 := by ring
          _ = (d ^ (a - coreEpsilon eta) *
                d ^ (eta - 2 * eta ^ 3)) / 2048 := by
            rw [← Real.rpow_add hd, ← Real.rpow_add hd]
            congr 2
            ring
          _ = d ^ (a - coreEpsilon eta) *
              (d ^ (eta - 2 * eta ^ 3) / 2048) := by ring
      _ ≤ d ^ (a - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) :=
        mul_le_mul_of_nonneg_left hNP (Real.rpow_nonneg hd.le _)
  have hp : d ^ (-coreEpsilon eta / 64) *
      d ^ (a + 9 * coreEpsilon eta / 1600) =
        d ^ (a - coreEpsilon eta / 100) := by
    rw [← Real.rpow_add hd]
    congr 1
    ring
  have hrewrite :
      ((76800 * Gamma / (N * trajectoryFloor eta d)) ^ 2 +
          614400 * Gamma / (N ^ 2 * trajectoryFloor eta d ^ 2)) *
            d ^ (-coreEpsilon eta / 64) *
            d ^ (a + 9 * coreEpsilon eta / 1600) =
        A * d ^ (a - coreEpsilon eta / 100) /
          (N ^ 2 * trajectoryFloor eta d ^ 2) := by
    rw [show
      ((76800 * Gamma / (N * trajectoryFloor eta d)) ^ 2 +
          614400 * Gamma / (N ^ 2 * trajectoryFloor eta d ^ 2)) *
            d ^ (-coreEpsilon eta / 64) *
            d ^ (a + 9 * coreEpsilon eta / 1600) =
        ((76800 * Gamma / (N * trajectoryFloor eta d)) ^ 2 +
          614400 * Gamma / (N ^ 2 * trajectoryFloor eta d ^ 2)) *
          (d ^ (-coreEpsilon eta / 64) *
            d ^ (a + 9 * coreEpsilon eta / 1600)) by ring, hp]
    dsimp only [A]
    field_simp
  rw [hrewrite]
  apply (div_le_iff₀
    (mul_pos (sq_pos_of_pos hNpos) (sq_pos_of_pos hPpos))).2
  have hscaled := div_le_div_of_nonneg_right hcross (by norm_num : (0 : ℝ) ≤ 5)
  calc
    A * d ^ (a - coreEpsilon eta / 100) ≤
        (d ^ (a - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2)) / 5 := by
      nlinarith
    _ = (d ^ (a - coreEpsilon eta) / N / 5) *
        (N ^ 2 * trajectoryFloor eta d ^ 2) := by
      field_simp

theorem zetaMixedTerm_le_fifth
    {eta Gamma d N a : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    2 * (76800 * Gamma / (N * trajectoryFloor eta d)) *
          d ^ (-coreEpsilon eta / 64) *
          (5000 * Gamma * d ^ a / (N * trajectoryFloor eta d)) +
        d ^ (-coreEpsilon eta / 64) *
          (1000000 * Gamma ^ 2 * d ^ a /
            (N ^ 2 * trajectoryFloor eta d ^ 2)) ≤
      (d ^ (a - coreEpsilon eta) / N) / 5 := by
  let A := 2 * 76800 * 5000 * Gamma ^ 2 + 1000000 * Gamma ^ 2
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hNP := host_mul_floor_sq_lower hd hN
  have hcoeff : 5 * A ≤
      d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) / 2048 := by
    rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 2048)]
    calc
      5 * A * 2048 = 10240 *
          (2 * 76800 * 5000 * Gamma ^ 2 + 1000000 * Gamma ^ 2) := by
        simp only [A]
        ring
      _ ≤ _ := S.zetaMixedSecondOrder
  have hcross : 5 * A * d ^ (a - coreEpsilon eta / 64) ≤
      d ^ (a - coreEpsilon eta) *
        (N * trajectoryFloor eta d ^ 2) := by
    calc
      5 * A * d ^ (a - coreEpsilon eta / 64) ≤
          (d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) / 2048) *
            d ^ (a - coreEpsilon eta / 64) :=
        mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hd.le _)
      _ = d ^ (a - coreEpsilon eta) *
          (d ^ (eta - 2 * eta ^ 3) / 2048) := by
        calc
          d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) / 2048 *
                d ^ (a - coreEpsilon eta / 64) =
              (d ^ (eta - 2 * eta ^ 3 - 63 * coreEpsilon eta / 64) *
                d ^ (a - coreEpsilon eta / 64)) / 2048 := by ring
          _ = (d ^ (a - coreEpsilon eta) *
                d ^ (eta - 2 * eta ^ 3)) / 2048 := by
            rw [← Real.rpow_add hd, ← Real.rpow_add hd]
            congr 2
            ring
          _ = d ^ (a - coreEpsilon eta) *
              (d ^ (eta - 2 * eta ^ 3) / 2048) := by ring
      _ ≤ d ^ (a - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2) :=
        mul_le_mul_of_nonneg_left hNP (Real.rpow_nonneg hd.le _)
  have hp : d ^ (-coreEpsilon eta / 64) * d ^ a =
      d ^ (a - coreEpsilon eta / 64) := by
    rw [← Real.rpow_add hd]
    congr 1
    ring
  have hrewrite :
      2 * (76800 * Gamma / (N * trajectoryFloor eta d)) *
            d ^ (-coreEpsilon eta / 64) *
            (5000 * Gamma * d ^ a / (N * trajectoryFloor eta d)) +
          d ^ (-coreEpsilon eta / 64) *
            (1000000 * Gamma ^ 2 * d ^ a /
              (N ^ 2 * trajectoryFloor eta d ^ 2)) =
        A * d ^ (a - coreEpsilon eta / 64) /
          (N ^ 2 * trajectoryFloor eta d ^ 2) := by
    dsimp only [A]
    field_simp
    rw [show -(coreEpsilon eta / 64) = -coreEpsilon eta / 64 by ring,
      show (64 * a - coreEpsilon eta) / 64 =
        a - coreEpsilon eta / 64 by ring,
      show Gamma ^ 2 * d ^ (-coreEpsilon eta / 64) * d ^ a =
        Gamma ^ 2 * (d ^ (-coreEpsilon eta / 64) * d ^ a) by ring,
      hp]
  rw [hrewrite]
  apply (div_le_iff₀
    (mul_pos (sq_pos_of_pos hNpos) (sq_pos_of_pos hPpos))).2
  calc
    A * d ^ (a - coreEpsilon eta / 64) ≤
        (d ^ (a - coreEpsilon eta) *
          (N * trajectoryFloor eta d ^ 2)) / 5 := by
      nlinarith [hcross]
    _ = (d ^ (a - coreEpsilon eta) / N / 5) *
        (N ^ 2 * trajectoryFloor eta d ^ 2) := by
      field_simp

theorem envelopeFactor_le_fifth
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    d ^ (-coreEpsilon eta / 64) ≤ 1 / 5 := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hm := mul_le_mul_of_nonneg_right S.envelopeFifth
    (Real.rpow_nonneg hd.le (-coreEpsilon eta / 64))
  have hid : d ^ (coreEpsilon eta / 64) *
      d ^ (-coreEpsilon eta / 64) = 1 := by
    rw [← Real.rpow_add hd]
    have hz : coreEpsilon eta / 64 + -coreEpsilon eta / 64 = 0 := by ring
    rw [hz, Real.rpow_zero]
  rw [hid] at hm
  nlinarith

theorem zetaSecondOrder_of_cutoff
    {eta Gamma d N : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) (j s : ℕ) :
    zetaSourceCurvatureBudget Gamma (coreEpsilon eta) d N
        (trajectoryFloor eta d) j s ≤
      d ^ ((s : ℝ) - j - coreEpsilon eta) / N := by
  let B := d ^ ((s : ℝ) - j - coreEpsilon eta) / N
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hB0 : 0 ≤ B := div_nonneg (Real.rpow_nonneg hd.le _) hNpos.le
  have hmain := zetaMainTerm_le_fifth
    (S := S) hN (a := (s : ℝ) - j)
  have hmixed := zetaMixedTerm_le_fifth
    (S := S) hN (a := (s : ℝ) - j)
  have henvelope : d ^ (-coreEpsilon eta / 64) * B ≤ B / 5 := by
    simpa [div_eq_mul_inv, mul_comm] using
      (mul_le_mul_of_nonneg_right (envelopeFactor_le_fifth S) hB0)
  dsimp only [zetaSourceCurvatureBudget]
  dsimp only [B] at hmain hmixed henvelope ⊢
  calc
    ((76800 * Gamma / (N * trajectoryFloor eta d)) ^ 2 +
          614400 * Gamma / (N ^ 2 * trajectoryFloor eta d ^ 2)) *
        d ^ (-coreEpsilon eta / 64) *
          d ^ ((s : ℝ) - j + 9 * coreEpsilon eta / 1600) +
      2 * (76800 * Gamma / (N * trajectoryFloor eta d)) *
        d ^ (-coreEpsilon eta / 64) *
          (5000 * Gamma * d ^ ((s : ℝ) - j) /
            (N * trajectoryFloor eta d)) +
      d ^ (-coreEpsilon eta / 64) *
        (d ^ ((s : ℝ) - j - coreEpsilon eta) / N +
          1000000 * Gamma ^ 2 * d ^ ((s : ℝ) - j) /
            (N ^ 2 * trajectoryFloor eta d ^ 2)) ≤
        (d ^ ((s : ℝ) - j - coreEpsilon eta) / N) / 5 +
          (d ^ ((s : ℝ) - j - coreEpsilon eta) / N) / 5 +
          (d ^ ((s : ℝ) - j - coreEpsilon eta) / N) / 5 := by
      nlinarith
    _ ≤ d ^ ((s : ℝ) - j - coreEpsilon eta) / N := by
      nlinarith

theorem testLargeDCondition_of_cutoff
    {eta Gamma d N : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) {j s : ℕ} (hsj : s ≤ j) :
    TestLargeDCondition Gamma (coreEpsilon eta) d N
      (trajectoryFloor eta d) j s := by
  exact
    { correction_denominator := S.correctionDenominator
      inside_upper := testInsideUpper_of_cutoff S j s
      zHat_second_order := zHatSecondOrder_of_cutoff S hN hsj
      zeta_second_order := zetaSecondOrder_of_cutoff S hN j s }

/-! ## Instantiating `sigma = 2 * eta^3` and terminal absorptions -/

theorem CoreExponentSpec.stopExponent_relations
    {eta Gamma : ℝ} (h : CoreExponentSpec eta Gamma) :
    9600 * Gamma * (2 * eta ^ 3) ≤ coreEpsilon eta / 64 ∧
      7 * (2 * eta ^ 3) ≤ coreEpsilon eta / 64 ∧
      7 * (2 * eta ^ 3) ≤ coreEpsilon eta / 512 := by
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one h.Gamma_one
  have heta0 : 0 ≤ eta := h.eta_pos.le
  constructor
  · linarith [h.xi_gap]
  constructor
  · have heps : 0 < coreEpsilon eta := by
      rw [show coreEpsilon eta = eta / 50000 by
        simp only [coreEpsilon, rawRegularizationEps]; ring]
      linarith [h.eta_pos]
    linarith [h.test_vertex_gap]
  · linarith [h.test_vertex_gap]

theorem stopExponent_floor_of_cutoff
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    d ^ (-(2 * eta ^ 3)) ≤ trajectoryFloor eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hm := mul_le_mul_of_nonneg_right S.stopExponentFloor
    (Real.rpow_nonneg hd.le (-(2 * eta ^ 3)))
  have hid : d ^ (eta ^ 3) * d ^ (-(2 * eta ^ 3)) =
      d ^ (-(eta ^ 3)) := by
    rw [← Real.rpow_add hd]
    congr 1
    ring
  rw [hid] at hm
  unfold trajectoryFloor publicError
  rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 32)]
  simpa [mul_comm] using hm

theorem deltaHazard_of_cutoff
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    d ^ (-coreEpsilon eta / 64) ≤ exp (-3 * Gamma) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  rw [show -coreEpsilon eta / 64 = -(coreEpsilon eta / 64) by ring,
    Real.rpow_neg hd.le,
    show -3 * Gamma = -(3 * Gamma) by ring, Real.exp_neg]
  exact (inv_le_inv₀ (Real.rpow_pos_of_pos hd _) (Real.exp_pos _)).2
    S.deltaHazardExponential

theorem testHazard_of_cutoff
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    d ^ (-coreEpsilon eta / 512) ≤ exp (-3 * Gamma) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  rw [show -coreEpsilon eta / 512 = -(coreEpsilon eta / 512) by ring,
    Real.rpow_neg hd.le,
    show -3 * Gamma = -(3 * Gamma) by ring, Real.exp_neg]
  exact (inv_le_inv₀ (Real.rpow_pos_of_pos hd _) (Real.exp_pos _)).2
    S.testHazardExponential

theorem coreDecay_le_publicError_sixteenth
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    d ^ (-coreEpsilon eta / 64) ≤ publicError eta d / 16 := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hm := mul_le_mul_of_nonneg_right S.terminalXiFromCore
    (Real.rpow_nonneg hd.le (-coreEpsilon eta / 64))
  have hid : d ^ (coreEpsilon eta / 64 - eta ^ 3) *
      d ^ (-coreEpsilon eta / 64) = d ^ (-(eta ^ 3)) := by
    rw [← Real.rpow_add hd]
    congr 1
    ring
  rw [hid] at hm
  unfold publicError
  rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 16)]
  simpa [mul_comm] using hm

theorem killedWeightDecay_le_publicError_quarter
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    d ^ (-rawRegularizationEps eta) ≤ publicError eta d / 4 := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hm := mul_le_mul_of_nonneg_right S.killedWeightAbsorption
    (Real.rpow_nonneg hd.le (-rawRegularizationEps eta))
  have hid : d ^ (rawRegularizationEps eta - eta ^ 3) *
      d ^ (-rawRegularizationEps eta) = d ^ (-(eta ^ 3)) := by
    rw [← Real.rpow_add hd]
    congr 1
    ring
  rw [hid] at hm
  unfold publicError
  rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 4)]
  simpa [mul_comm] using hm

theorem xi_le_publicError_sixteenth
    {Gamma eta d N y : ℝ}
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hpV : 0 < pV N y) (hpV1 : pV N y ≤ 1)
    (hstop : d ^ (-(2 * eta ^ 3)) ≤ pV N y) :
    xi Gamma (coreEpsilon eta) d N y ≤ publicError eta d / 16 := by
  have heps : 0 ≤ coreEpsilon eta := by
    rw [show coreEpsilon eta = eta / 50000 by
      simp only [coreEpsilon, rawRegularizationEps]; ring]
    linarith [E.eta_pos]
  exact (xi_source_bounds_stopExponent (by linarith [S.degreeAtLeastTwo])
    E.Gamma_one heps hpV hpV1
    hstop E.stopExponent_relations.1).2.trans
      (coreDecay_le_publicError_sixteenth S)

/-! ## A finite three-family paired first-failure union bound -/

theorem pairedFamilySum_le_sixth
    {I : Type*} [Fintype I] (x y : ℝ) (t : I → ℝ)
    (hc : (Fintype.card I : ℝ) ≤ exp y)
    (ht : ∀ i, t i ≤ exp (-x))
    (hexp : exp (y - x) ≤ 1 / 12) :
    2 * (∑ i, t i) ≤ 1 / 6 := by
  calc
    2 * (∑ i, t i) ≤ 2 * (∑ _i : I, exp (-x)) := by
      apply mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun i _ ↦ ht i)
      norm_num
    _ = 2 * (Fintype.card I : ℝ) * exp (-x) := by
      simp [nsmul_eq_mul]
      ring
    _ ≤ 2 * exp y * exp (-x) := by
      gcongr
    _ = 2 * exp (y - x) := by
      rw [show 2 * exp y * exp (-x) = 2 * (exp y * exp (-x)) by ring,
        ← Real.exp_add]
      congr 2 <;> ring
    _ ≤ 2 * (1 / 12) := by gcongr
    _ = 1 / 6 := by norm_num

theorem pairedThreeFamilyFailureSum_lt_one
    {I₁ I₂ I₃ : Type*} [Fintype I₁] [Fintype I₂] [Fintype I₃]
    (x y : ℝ) (t₁ : I₁ → ℝ) (t₂ : I₂ → ℝ) (t₃ : I₃ → ℝ)
    (hy : 0 ≤ y) (hpower : 24 * y ≤ x) (hlog : 4 * Real.log 12 ≤ x)
    (hc₁ : (Fintype.card I₁ : ℝ) ≤ exp y)
    (hc₂ : (Fintype.card I₂ : ℝ) ≤ exp y)
    (hc₃ : (Fintype.card I₃ : ℝ) ≤ exp y)
    (ht₁ : ∀ i, t₁ i ≤ exp (-x))
    (ht₂ : ∀ i, t₂ i ≤ exp (-x))
    (ht₃ : ∀ i, t₃ i ≤ exp (-x)) :
    2 * (∑ i, t₁ i) + 2 * (∑ i, t₂ i) + 2 * (∑ i, t₃ i) < 1 := by
  have hlogpos : 0 < Real.log 12 := Real.log_pos (by norm_num)
  have hx : 0 < x := by nlinarith
  have hxy : y - x ≤ -Real.log 12 := by nlinarith
  have hexp : exp (y - x) ≤ 1 / 12 := by
    calc
      exp (y - x) ≤ exp (-Real.log 12) := Real.exp_le_exp.mpr hxy
      _ = 1 / 12 := by
        rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 12)]
        norm_num
  have h₁ := pairedFamilySum_le_sixth x y t₁ hc₁ ht₁ hexp
  have h₂ := pairedFamilySum_le_sixth x y t₂ hc₂ ht₂ hexp
  have h₃ := pairedFamilySum_le_sixth x y t₃ hc₃ ht₃ hexp
  nlinarith

theorem CoreCutoffSpec.failureBudget
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    24 * (2 * d ^ (eta ^ 3)) ≤ d ^ (tailPower eta) ∧
      4 * Real.log 12 ≤ d ^ (tailPower eta) := by
  constructor
  · calc
      24 * (2 * d ^ (eta ^ 3)) = 48 * d ^ (eta ^ 3) := by ring
      _ ≤ d ^ (tailPower eta) := S.entropyPower
  · exact S.entropyLog

end

