    (by simpa only [D, delta] using hsmall)
    (by simpa only [b, D, delta] using hbLo)
    (by simpa only [b, D, delta] using hbHi)
    (by simpa only [a, D, delta] using haLo)
    (by simpa only [a, D, delta] using haHi)
  have hcoarse := degreeMean_coarse_deviations_of_handshake hGamma hu
    (by simpa only [D] using hD) hratio.1 (by positivity)
    hratio.2.1 rfl hratio.2.2
    (by simpa only [center, D] using hcenter0)
    (by simpa only [center, D] using hcenter)
    (by simpa only [err, delta] using herror0)
    (by simpa only [err, delta] using herror)
    (by simpa only [defectOverA, a] using hdefect0)
    (by simpa only [defectOverA, a, delta] using hdefect)
    (by simpa only [D, delta] using hhost)
  have hwindow := degreeMeanWindow_of_coarse_deviations hsurv
    (div_nonneg (mul_nonneg (le_trans zero_le_one hGamma) hdelta0) hu.le)
    (by simpa only [scale, center, err, defectOverA, b, a, hsurvEq, hrate]
