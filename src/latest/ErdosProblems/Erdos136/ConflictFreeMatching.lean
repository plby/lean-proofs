    have hbase0 : 0 ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 16) :=
      Real.rpow_nonneg (by linarith [Rstep.degree.d_one]) _
    have hlower : d ^ (1 - CFMNumeric.coreEpsilon eta / 16) ≤ delta := by
      simpa only [delta, N] using
        (CFMTrajectories.delta_bounds_of_registry Rstep hx).1
    exact hbase0.trans hlower
  have hxi := (Rstep.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hsmall : 5 * delta ≤ D := by
    have heq : delta = CFMTrajectories.xi Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) * D := rfl
    rw [heq]
    nlinarith [mul_le_mul_of_nonneg_right hxi hD.le]
  have hlocal := indexedDegreeEnhancedGood_local H R.regularized
    D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
    (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
    j R.restrictedWeight hgood
  have hreach := indexedVertexLocalThroughSpreadGood_reachable
    H R.regularized eta d N
    (CFMNumericAggregation.targetTime eta d (vertexFinset H).card) hlocal
  have hold := indexedDegreeEnhancedGood_old H R.regularized
    D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
    (CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
