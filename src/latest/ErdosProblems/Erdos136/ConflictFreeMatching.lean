    convert hraw using 1 <;> dsimp only [w, scale] <;> ring
  apply hraw'.trans
  calc
    48 * scale * Real.rpow d (-(1 + eps / 5)) ≤
        Real.rpow d (eps / 10) * scale *
          Real.rpow d (-(1 + eps / 5)) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hcoef hscale0) hpow0
    _ = scale * Real.rpow d (-(1 + eps / 10)) := by
      calc
        Real.rpow d (eps / 10) * scale *
            Real.rpow d (-(1 + eps / 5)) =
          scale * (Real.rpow d (eps / 10) *
            Real.rpow d (-(1 + eps / 5))) := by ring
        _ = scale * Real.rpow d (eps / 10 + (-(1 + eps / 5))) := by
          congr 1
          exact (Real.rpow_add (by linarith : 0 < d) _ _).symm
        _ = scale * Real.rpow d (-(1 + eps / 10)) := by
          congr 2
          ring

/-- Endpoint source-meeting estimate for a three-edge requested root. -/
theorem RegularizationCertificate.internalGainCollisionResidualFullNonemptySourceRootMass_le_scale_three
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
