theorem localSpread_host_power
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    (4096 : ℝ) ≤ Real.rpow d
      (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) := by
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hGammaSq : 1 ≤ Gamma ^ 2 := by
    nlinarith [E.Gamma_one, sq_nonneg Gamma]
  calc
    (4096 : ℝ) ≤ 4096000000 * Gamma ^ 2 := by nlinarith
    _ ≤ Real.rpow d
        (eta - 2 * eta ^ 3 - CFMNumeric.coreEpsilon eta) :=
      S.degreeSecondOrder
    _ ≤ Real.rpow d
        (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      have heta3 : 0 ≤ eta ^ 3 := pow_nonneg E.eta_pos.le 3
      have heps : 0 ≤ CFMNumeric.coreEpsilon eta := by
        rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
          simp only [CFMNumeric.coreEpsilon,
            CFMRegularization.rawRegularizationEps]
          ring]
        exact div_nonneg E.eta_pos.le (by norm_num)
      nlinarith

theorem localSpreadSmallDrift_le_jump
    {eta Gamma d N : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) :
    localSpreadSmallDrift eta d N ≤ localSpreadSmallJump eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hApos : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hhost := localSpread_host_power E S
  have hcross :
      3 * Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) ≤
        localSpreadAvailableFloor eta d N *
          Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    have hbase :
        3 * Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) ≤
          (Real.rpow d eta / 2) *
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
            Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
      have hmul := mul_le_mul_of_nonneg_right hhost
        (Real.rpow_nonneg hd.le
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4))
      calc
        3 * Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) ≤
            4 * Real.rpow d
              (2 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
          exact mul_le_mul_of_nonneg_right (by norm_num)
            (Real.rpow_nonneg hd.le _)
        _ = 4096 * Real.rpow d
              (2 - 5 * CFMNumeric.coreEpsilon eta / 4) / 1024 := by
          ring
        _ ≤ (Real.rpow d
              (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) *
            Real.rpow d
              (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 := by
          exact div_le_div_of_nonneg_right hmul (by norm_num)
        _ = (Real.rpow d eta / 2) *
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
            Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
          calc
            (Real.rpow d
                  (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) *
                Real.rpow d
                  (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 =
                Real.rpow d
                  ((eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) +
                    (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 := by
              congr 1
              exact (Real.rpow_add hd _ _).symm
            _ = Real.rpow d
                  (eta +
                    (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
                    (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 := by
              congr 2
              ring
            _ = (Real.rpow d eta / 2) *
                  Real.rpow d
                    (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
                Real.rpow d
                  (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
              have houter := Real.rpow_add hd
                (eta + (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3))
                (1 - 5 * CFMNumeric.coreEpsilon eta / 4)
              have hinner := Real.rpow_add hd eta
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)
              calc
                Real.rpow d
                    (eta +
                      (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
                      (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 =
                    (Real.rpow d
                        (eta +
                          (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) *
                      Real.rpow d
                        (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 :=
                  congrArg (fun x : ℝ ↦ x / 1024) houter
                _ = ((Real.rpow d eta *
                        Real.rpow d
                          (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) *
                      Real.rpow d
                        (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024 :=
                  congrArg
                    (fun x : ℝ ↦
                      (x * Real.rpow d
                        (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) / 1024)
                    hinner
                _ = (Real.rpow d eta / 2) *
                      Real.rpow d
                        (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
                    Real.rpow d
                      (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
                  ring
    have hfactor0 : 0 ≤
        Real.rpow d
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
          Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) :=
      mul_nonneg
        (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
        (Real.rpow_nonneg hd.le _)
    have hm := mul_le_mul_of_nonneg_right hN hfactor0
    apply hbase.trans
    calc
      (Real.rpow d eta / 2) *
            Real.rpow d
              (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
          Real.rpow d (1 - 5 * CFMNumeric.coreEpsilon eta / 4) =
          (Real.rpow d eta / 2) *
            (Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
              Real.rpow d
                (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) := by ring
      _ ≤ N *
            (Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
              Real.rpow d
                (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) := hm
      _ = N * Real.rpow d
              (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
            Real.rpow d
              (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by ring
  unfold localSpreadSmallDrift localSpreadSmallJump
  exact (div_le_iff₀ hApos).2 (by simpa [mul_comm] using hcross)

theorem localSpreadAggregateDrift_le_jump
    {eta Gamma d N : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) :
    localSpreadAggregateDrift eta d N ≤
      localSpreadAggregateJump eta d := by
  have hsmall := localSpreadSmallDrift_le_jump E S hN
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  unfold localSpreadSmallDrift localSpreadSmallJump at hsmall
  unfold localSpreadAggregateDrift localSpreadAggregateJump
  have hApos : 0 < localSpreadAvailableFloor eta d N := by
    have hNpos : 0 < N :=
      (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hmul :
      Real.rpow d (3 - 5 * CFMNumeric.coreEpsilon eta / 4) =
        d * Real.rpow d
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
    calc
      Real.rpow d (3 - 5 * CFMNumeric.coreEpsilon eta / 4) =
          Real.rpow d
            (1 + (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) := by
        congr 1
        ring
      _ = Real.rpow d 1 * Real.rpow d
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4) :=
        Real.rpow_add hd _ _
      _ = d * Real.rpow d
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
        exact congrArg
          (fun x : ℝ ↦ x * Real.rpow d
            (2 - 5 * CFMNumeric.coreEpsilon eta / 4))
          (Real.rpow_one d)
  have hjmul :
      Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) =
        d * Real.rpow d
          (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
    calc
      Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) =
          Real.rpow d
            (1 + (1 - 5 * CFMNumeric.coreEpsilon eta / 4)) := by
        congr 1
        ring
      _ = Real.rpow d 1 * Real.rpow d
          (1 - 5 * CFMNumeric.coreEpsilon eta / 4) :=
        Real.rpow_add hd _ _
      _ = d * Real.rpow d
          (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := by
        exact congrArg
          (fun x : ℝ ↦ x * Real.rpow d
            (1 - 5 * CFMNumeric.coreEpsilon eta / 4))
          (Real.rpow_one d)
  have hm := mul_le_mul_of_nonneg_left hsmall hd.le
  calc
    3 * Real.rpow d (3 - 5 * CFMNumeric.coreEpsilon eta / 4) /
        localSpreadAvailableFloor eta d N =
        3 * (d * Real.rpow d
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4)) /
            localSpreadAvailableFloor eta d N := by rw [hmul]
    _ =
        d * (3 * Real.rpow d
          (2 - 5 * CFMNumeric.coreEpsilon eta / 4) /
            localSpreadAvailableFloor eta d N) := by ring
    _ ≤ d * Real.rpow d
        (1 - 5 * CFMNumeric.coreEpsilon eta / 4) := hm
    _ = Real.rpow d
        (2 - 5 * CFMNumeric.coreEpsilon eta / 4) := hjmul.symm

theorem localSpreadDerivativeMargin_le_primaryMargin
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    localSpreadDerivativeMargin eta d ≤
      localSpreadPrimaryMargin eta d := by
  unfold localSpreadDerivativeMargin localSpreadPrimaryMargin
  apply div_le_div_of_nonneg_right _ (by norm_num)
  apply Real.rpow_le_rpow_of_exponent_le
    (by linarith [S.degreeAtLeastTwo])
  have heps : 0 ≤ CFMNumeric.coreEpsilon eta := by
    rw [show CFMNumeric.coreEpsilon eta = eta / 50000 by
      simp only [CFMNumeric.coreEpsilon,
        CFMRegularization.rawRegularizationEps]
      ring]
    exact div_nonneg E.eta_pos.le (by norm_num)
  linarith

theorem localSpreadDerivativeCap_terminal_le
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) :
    localSpreadDerivativeCap eta d N T ≤
      2 * localSpreadDerivativeMargin eta d := by
  have hgrowth := localSpreadSmallDrift_time_le_margin
    E S hNpos (Nat.cast_nonneg T) hT
  unfold localSpreadDerivativeCap localSpreadLinearCap
  linarith

theorem localSpreadAggregateCap_terminal_le
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) :
    localSpreadAggregateCap eta d N T ≤
      2 * localSpreadAggregateMargin eta d := by
  have hgrowth := localSpreadAggregateDrift_time_le_margin
    E S hNpos (Nat.cast_nonneg T) hT
  unfold localSpreadAggregateCap localSpreadLinearCap
  linarith

theorem localSpreadQ2PrimaryCap_terminal_le
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) :
    localSpreadQ2PrimaryCap eta d N T ≤
      2 * localSpreadPrimaryMargin eta d := by
  have hgrowth := localSpreadSmallDrift_time_le_margin
    E S hNpos (Nat.cast_nonneg T) hT
  have hm := localSpreadDerivativeMargin_le_primaryMargin E S
  unfold localSpreadQ2PrimaryCap localSpreadLinearCap
  linarith

theorem localSpreadQ3PrimaryDrift_time_le_margin
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) :
    (T : ℝ) * localSpreadQ3PrimaryDrift eta d N T ≤
      localSpreadPrimaryMargin eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hA : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hcap := localSpreadAggregateCap_terminal_le E S hNpos hT
  have hnonneg : 0 ≤ localSpreadAggregateCap eta d N T := by
    unfold localSpreadAggregateCap localSpreadLinearCap
    exact add_nonneg
      (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
      (mul_nonneg (Nat.cast_nonneg T)
        (div_nonneg
          (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hA.le))
  have hdrift : 0 ≤ localSpreadQ3PrimaryDrift eta d N T := by
    unfold localSpreadQ3PrimaryDrift
    positivity
  have hfirst :
      (T : ℝ) * localSpreadQ3PrimaryDrift eta d N T ≤
        N * (4 * localSpreadAggregateMargin eta d /
          localSpreadAvailableFloor eta d N) := by
    calc
      (T : ℝ) * localSpreadQ3PrimaryDrift eta d N T ≤
          N * localSpreadQ3PrimaryDrift eta d N T :=
        mul_le_mul_of_nonneg_right hT hdrift
      _ ≤ N * (4 * localSpreadAggregateMargin eta d /
          localSpreadAvailableFloor eta d N) := by
        apply mul_le_mul_of_nonneg_left _ hNpos.le
        unfold localSpreadQ3PrimaryDrift
        exact div_le_div_of_nonneg_right (by nlinarith) hA.le
  have hidentity :
      N * (4 * localSpreadAggregateMargin eta d /
          localSpreadAvailableFloor eta d N) =
        128 * Real.rpow d
          (1 - 23 * CFMNumeric.coreEpsilon eta / 32 + eta ^ 3) := by
    rw [localSpreadAggregateMargin,
      localSpreadAvailableFloor_eq_rpow hd]
    calc
      N * (4 * (Real.rpow d
              (2 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) /
          (N * Real.rpow d
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512)) =
          128 *
            (Real.rpow d (2 - 3 * CFMNumeric.coreEpsilon eta / 4) /
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) := by
        field_simp [ne_of_gt hNpos,
          ne_of_gt (Real.rpow_pos_of_pos hd _)]
        <;> ring
      _ = 128 * Real.rpow d
          ((2 - 3 * CFMNumeric.coreEpsilon eta / 4) -
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) := by
        congr 1
        exact (Real.rpow_sub hd _ _).symm
      _ = 128 * Real.rpow d
          (1 - 23 * CFMNumeric.coreEpsilon eta / 32 + eta ^ 3) := by
        congr 2
        ring
  calc
    (T : ℝ) * localSpreadQ3PrimaryDrift eta d N T ≤
        N * (4 * localSpreadAggregateMargin eta d /
          localSpreadAvailableFloor eta d N) := hfirst
    _ = 128 * Real.rpow d
        (1 - 23 * CFMNumeric.coreEpsilon eta / 32 + eta ^ 3) := hidentity
    _ ≤ localSpreadPrimaryMargin eta d := by
      unfold localSpreadPrimaryMargin
      apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 16)).2
      have h := localSpread_primary_growth_power_absorption E S
      nlinarith

theorem localSpreadQ3PrimaryCap_terminal_le
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) :
    localSpreadQ3PrimaryCap eta d N T T ≤
      2 * localSpreadPrimaryMargin eta d := by
  have hgrowth := localSpreadQ3PrimaryDrift_time_le_margin E S hNpos hT
  unfold localSpreadQ3PrimaryCap localSpreadLinearCap
  linarith

/-- The one-step drift of the q=3 primary coordinate is still on the
derivative scale.  The missing inverse host-size factor is supplied by the
same `d^eta / 2` lower bound used by the old global trajectories. -/
theorem localSpreadQ3PrimaryDrift_le_derivativeMargin
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N) :
    localSpreadQ3PrimaryDrift eta d N T ≤
      localSpreadDerivativeMargin eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hfloor : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hcap := localSpreadAggregateCap_terminal_le E S hNpos hT
  have hhost := localSpread_host_power E S
  have hpower :
      4096 * Real.rpow d
          (2 - 3 * CFMNumeric.coreEpsilon eta / 4) ≤
        Real.rpow d
          (eta +
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) := by
    calc
      4096 * Real.rpow d
            (2 - 3 * CFMNumeric.coreEpsilon eta / 4) ≤
          Real.rpow d
              (eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) *
            Real.rpow d
              (2 - 3 * CFMNumeric.coreEpsilon eta / 4) :=
        mul_le_mul_of_nonneg_right hhost (Real.rpow_nonneg hd.le _)
      _ = Real.rpow d
          ((eta - eta ^ 3 - CFMNumeric.coreEpsilon eta / 32) +
            (2 - 3 * CFMNumeric.coreEpsilon eta / 4)) :=
        (Real.rpow_add hd _ _).symm
      _ = Real.rpow d
          (eta +
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) := by
        congr 1
        ring
  have hcross :
      4 * localSpreadAggregateMargin eta d ≤
        localSpreadAvailableFloor eta d N *
          localSpreadDerivativeMargin eta d := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    unfold localSpreadAggregateMargin localSpreadDerivativeMargin
    have hbase :
        4 *
            (Real.rpow d
              (2 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) ≤
          (Real.rpow d eta / 2) *
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
            (Real.rpow d
              (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) := by
      calc
        4 *
              (Real.rpow d
                (2 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) =
            (4096 * Real.rpow d
              (2 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16384 := by
          ring
        _ ≤ Real.rpow d
              (eta +
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
                (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16384 :=
          div_le_div_of_nonneg_right hpower (by norm_num)
        _ = (Real.rpow d eta / 2) *
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
            (Real.rpow d
              (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) := by
          have houter := Real.rpow_add hd
            (eta +
              (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3))
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4)
          have hinner := Real.rpow_add hd eta
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)
          calc
            Real.rpow d
                (eta +
                  (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
                  (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16384 =
                (Real.rpow d
                    (eta +
                      (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) *
                  Real.rpow d
                    (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16384 :=
              congrArg (fun x : ℝ ↦ x / 16384) houter
            _ = ((Real.rpow d eta *
                    Real.rpow d
                      (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) *
                  Real.rpow d
                    (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16384 :=
              congrArg
                (fun x : ℝ ↦
                  (x * Real.rpow d
                    (1 - 3 * CFMNumeric.coreEpsilon eta / 4)) / 16384)
                hinner
            _ = (Real.rpow d eta / 2) *
                  Real.rpow d
                    (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
                (Real.rpow d
                  (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) := by
              ring
    have hfactor0 : 0 ≤
        Real.rpow d
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
          (Real.rpow d
            (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) :=
      mul_nonneg
        (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
        (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
    exact hbase.trans (by
      calc
        (Real.rpow d eta / 2) *
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
            (Real.rpow d
              (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) =
            (Real.rpow d eta / 2) *
              (Real.rpow d
                  (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
                (Real.rpow d
                  (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16)) := by ring
        _ ≤ N *
              (Real.rpow d
                  (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 *
                (Real.rpow d
                  (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16)) :=
          mul_le_mul_of_nonneg_right hN hfactor0
        _ = (N * Real.rpow d
              (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512) *
            (Real.rpow d
              (1 - 3 * CFMNumeric.coreEpsilon eta / 4) / 16) := by ring)
  unfold localSpreadQ3PrimaryDrift
  apply (div_le_iff₀ hfloor).2
  exact (by nlinarith [hcap, hcross])

/-! ## Enhanced-core local predicate and degree-cap extraction -/

abbrev VertexLocalThroughSpreadLocalCoordinate (H : Hypergraph V) :=
  Unit ⊕ VertexLocalThroughSpreadTailCoordinate H

noncomputable def vertexLocalThroughSpreadConcreteCap
    {H : Hypergraph V}
    (eta d N : ℝ) (T : ℕ)
    (a : VertexLocalThroughSpreadTailCoordinate H) : ℕ → ℝ :=
  match a.2.2 with
  | Sum.inl z =>
      if z.1 = 0 then localSpreadQ2PrimaryCap eta d N
      else if z.1 = 1 then localSpreadAggregateCap eta d N
      else localSpreadQ3PrimaryCap eta d N T
  | Sum.inr _ => localSpreadDerivativeCap eta d N

noncomputable def vertexLocalThroughSpreadConcreteJump
    {H : Hypergraph V}
    (eta d N : ℝ)
    (a : VertexLocalThroughSpreadTailCoordinate H) : ℕ → ℝ :=
  match a.2.2 with
  | Sum.inl z =>
      if z.1 = 0 then fun _ ↦ localSpreadSmallJump eta d
      else if z.1 = 1 then fun _ ↦ localSpreadAggregateJump eta d
      else localSpreadDerivativeCap eta d N
  | Sum.inr _ => fun _ ↦ localSpreadSmallJump eta d

noncomputable def vertexLocalThroughSpreadConcreteMargin
    {H : Hypergraph V} (eta d : ℝ)
    (a : VertexLocalThroughSpreadTailCoordinate H) : ℝ :=
  match a.2.2 with
  | Sum.inl z =>
      if z.1 = 1 then localSpreadAggregateMargin eta d
      else localSpreadPrimaryMargin eta d
  | Sum.inr _ => localSpreadDerivativeMargin eta d

noncomputable def vertexLocalThroughSpreadConcreteRange
    {H : Hypergraph V} (eta d N : ℝ) (T : ℕ)
    (a : VertexLocalThroughSpreadTailCoordinate H) : ℝ :=
  match a.2.2 with
  | Sum.inl z =>
      if z.1 = 0 then 2 * localSpreadSmallJump eta d
      else if z.1 = 1 then 2 * localSpreadAggregateJump eta d
      else 2 * localSpreadDerivativeMargin eta d +
        localSpreadQ3PrimaryDrift eta d N T
  | Sum.inr _ => 2 * localSpreadSmallJump eta d

noncomputable def vertexLocalThroughSpreadConcreteVariance
    {H : Hypergraph V} (eta d N : ℝ) (T : ℕ)
    (a : VertexLocalThroughSpreadTailCoordinate H) : ℝ :=
  match a.2.2 with
  | Sum.inl z =>
      if z.1 = 0 then
        4 * localSpreadSmallJump eta d * localSpreadDerivativeMargin eta d
      else if z.1 = 1 then
        4 * localSpreadAggregateJump eta d * localSpreadAggregateMargin eta d
      else
        2 * (2 * localSpreadDerivativeMargin eta d +
          localSpreadQ3PrimaryDrift eta d N T) *
            localSpreadPrimaryMargin eta d
  | Sum.inr _ =>
      4 * localSpreadSmallJump eta d * localSpreadDerivativeMargin eta d

noncomputable def vertexLocalThroughSpreadLocalPredicate
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T : ℕ) :
    VertexLocalThroughSpreadLocalCoordinate H →
      ℕ → Hypergraph V → Prop
  | Sum.inl _, k, M => IsConflictFreeMatching H C M ∧ M.card = k
  | Sum.inr a, k, M =>
      localSpreadUpperCorridor
        (vertexLocalThroughSpreadTailBaseWeight H C a)
        (vertexLocalThroughSpreadTailRank a)
        (vertexLocalThroughSpreadConcreteCap eta d N T a) k M

@[simp] theorem vertexLocalThroughSpreadLocalPredicate_reachable
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T k : ℕ) (M : Hypergraph V) :
    vertexLocalThroughSpreadLocalPredicate H C eta d N T
        (Sum.inl ()) k M ↔
      IsConflictFreeMatching H C M ∧ M.card = k := by
  rfl

@[simp] theorem vertexLocalThroughSpreadLocalPredicate_tail
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T k : ℕ) (M : Hypergraph V)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    vertexLocalThroughSpreadLocalPredicate H C eta d N T
        (Sum.inr a) k M ↔
      localSpreadUpperCorridor
        (vertexLocalThroughSpreadTailBaseWeight H C a)
        (vertexLocalThroughSpreadTailRank a)
        (vertexLocalThroughSpreadConcreteCap eta d N T a) k M := by
  rfl

theorem indexedVertexLocalThroughSpreadGood_reachable
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T : ℕ) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d N T) k M) :
    IsConflictFreeMatching H C M ∧ M.card = k := by
  exact hgood (Sum.inl ())

theorem indexedVertexLocalThroughSpreadGood_tail
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T : ℕ) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d N T) k M)
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    localSpreadUpperCorridor
      (vertexLocalThroughSpreadTailBaseWeight H C a)
      (vertexLocalThroughSpreadTailRank a)
      (vertexLocalThroughSpreadConcreteCap eta d N T a) k M := by
  exact hgood (Sum.inr a)

theorem vertexLocalThroughSpreadPrimaryCaps_of_localGood
    {eta Gamma d N : ℝ} {T k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) (hkT : k ≤ T)
    (H : Hypergraph V) (C : ConflictSystem V) {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d N T) k M)
    (v : ActualHostVertex H) :
    ∀ e ∈ availableEdges H C M, v.1 ∉ e →
      ∀ q, 2 ≤ q → q ≤ 3 →
        testTotal (vertexLocalThroughSpreadWeight H C e v.1 q)
            M (q - 1) ≤
          2 * localSpreadPrimaryMargin eta d := by
  intro e he hve q hq2 hq3
  have heH : e ∈ H := availableEdges_subset H C M he
  let eroot : {f : Finset V // f ∈ H} := ⟨e, heH⟩
  have hkcast : (k : ℝ) ≤ (T : ℝ) := by exact_mod_cast hkT
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hApos : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hsmall0 : 0 ≤ localSpreadSmallDrift eta d N := by
    unfold localSpreadSmallDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hApos.le
  have haggregate0 : 0 ≤ localSpreadAggregateDrift eta d N := by
    unfold localSpreadAggregateDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hApos.le
  have haggregateCap0 : 0 ≤ localSpreadAggregateCap eta d N T := by
    unfold localSpreadAggregateCap localSpreadLinearCap
    exact add_nonneg
      (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
      (mul_nonneg (Nat.cast_nonneg T) haggregate0)
  have hprimary0 : 0 ≤ localSpreadQ3PrimaryDrift eta d N T := by
    unfold localSpreadQ3PrimaryDrift
    exact div_nonneg (mul_nonneg (by norm_num) haggregateCap0) hApos.le
  rcases (by omega : q = 2 ∨ q = 3) with rfl | rfl
  · let a : VertexLocalThroughSpreadTailCoordinate H :=
      (eroot, v, Sum.inl (0 : Fin 3))
    have hcorr := indexedVertexLocalThroughSpreadGood_tail
      H C eta d N T hgood a
    have hvalue :
        testTotal (vertexLocalThroughSpreadWeight H C e v.1 2) M 1 <
          localSpreadQ2PrimaryCap eta d N k := by
      apply sub_neg.mp
      simpa [localSpreadUpperCorridor, localSpreadUpperError,
        a, eroot, vertexLocalThroughSpreadTailBaseWeight,
        vertexLocalThroughSpreadTailRank,
        vertexLocalThroughSpreadConcreteCap] using hcorr
    have hmono : localSpreadQ2PrimaryCap eta d N k ≤
        localSpreadQ2PrimaryCap eta d N T := by
      unfold localSpreadQ2PrimaryCap localSpreadLinearCap
      simpa [add_comm] using add_le_add_left
        (mul_le_mul_of_nonneg_right hkcast hsmall0)
        (localSpreadPrimaryMargin eta d)
    exact hvalue.le.trans (hmono.trans
      (localSpreadQ2PrimaryCap_terminal_le E S hNpos hT))
  · let a : VertexLocalThroughSpreadTailCoordinate H :=
      (eroot, v, Sum.inl (2 : Fin 3))
    have hcorr := indexedVertexLocalThroughSpreadGood_tail
      H C eta d N T hgood a
    have hvalue :
        testTotal (vertexLocalThroughSpreadWeight H C e v.1 3) M 2 <
          localSpreadQ3PrimaryCap eta d N T k := by
      apply sub_neg.mp
      simpa [localSpreadUpperCorridor, localSpreadUpperError,
        a, eroot, vertexLocalThroughSpreadTailBaseWeight,
        vertexLocalThroughSpreadTailRank,
        vertexLocalThroughSpreadConcreteCap] using hcorr
    have hmono : localSpreadQ3PrimaryCap eta d N T k ≤
        localSpreadQ3PrimaryCap eta d N T T := by
      unfold localSpreadQ3PrimaryCap localSpreadLinearCap
      simpa [add_comm] using add_le_add_left
        (mul_le_mul_of_nonneg_right hkcast hprimary0)
        (localSpreadPrimaryMargin eta d)
    exact hvalue.le.trans (hmono.trans
      (localSpreadQ3PrimaryCap_terminal_le E S hNpos hT))

theorem sourceConflictLinkVertexCap_of_localGood
    {eta Gamma d N : ℝ} {T k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) (hkT : k ≤ T)
    (H : Hypergraph V) (C : ConflictSystem V) {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d N T) k M)
    (v : ActualHostVertex H) :
    ∀ e ∈ availableEdges H C M, v.1 ∉ e →
      ∀ q, 2 ≤ q → q ≤ 3 →
        ((partialFamily
          (sourceConflictLinkInteractionAtVertex H C e q v.1)
          (availableEdges H C M) M 1).card : ℝ) ≤
        2 * localSpreadPrimaryMargin eta d := by
  apply sourceConflictLinkVertexCap_of_primaryChosenSetCaps
  exact vertexLocalThroughSpreadPrimaryCaps_of_localGood
    E S hNpos hT hkT H C hgood v

/-! ## Reachable availability floor from the enhanced old degree corridors -/

/-- One-sided exact handshake conversion used by the local spread source
budgets.  The matching/cardinality invariant is supplied by the distinguished
local reachable coordinate, while `hdegree` comes from the old paired degree
corridors in the enhanced Good predicate. -/
theorem availableEdges_card_lower_hHat_of_reachableDegreeWithin
    [Fintype V]
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (M : Hypergraph V) (hM : IsConflictFreeMatching H C M)
    (N₀ k : ℕ) (hN : (vertexFinset H).card = N₀)
    (hcard : M.card = k) (hcovered : 8 * k ≤ N₀)
    (hNpos : 0 < (N₀ : ℝ))
    (D₂ D₃ D₄ Gamma epsilon d : ℝ)
    (hdegree : AvailableDegreeWithin H C M
      (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
          d (N₀ : ℝ) (k : ℝ))
      (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
          d (N₀ : ℝ) (k : ℝ))) :
    CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
        (1 - CFMTrajectories.xi Gamma epsilon d (N₀ : ℝ) (k : ℝ)) ≤
      ((availableEdges H C M).card : ℝ) := by
  have hraw := (availableEdges_card_bounds_of_degreeWithin hH hdegree).1
  have huncardNat : (uncoveredVertices H M).card = N₀ - 8 * k := by
    rw [card_uncoveredVertices_of_uniform_matching hH hM.1, hN, hcard]
  have huncard : ((uncoveredVertices H M).card : ℝ) =
      (N₀ : ℝ) - 8 * (k : ℝ) := by
    rw [huncardNat, Nat.cast_sub hcovered]
    norm_num
  have hpVidentity : (N₀ : ℝ) *
      CFMTrajectories.pV (N₀ : ℝ) (k : ℝ) =
        (N₀ : ℝ) - 8 * (k : ℝ) := by
    unfold CFMTrajectories.pV
    field_simp
  have hloIdentity :
      ((uncoveredVertices H M).card : ℝ) *
          (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) -
            CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon
              d (N₀ : ℝ) (k : ℝ)) =
        8 * (CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
          (1 - CFMTrajectories.xi Gamma epsilon d
            (N₀ : ℝ) (k : ℝ))) := by
    rw [huncard, ← hpVidentity]
    unfold CFMTrajectories.delta CFMTrajectories.dHat
      CFMTrajectories.hHat CFMTrajectories.q
    ring
  rw [hloIdentity] at hraw
  nlinarith

/-- The old degree corridors plus the exact reachable invariant imply the
constant availability floor used by every concrete local source budget. -/
theorem localSpreadAvailableFloor_le_availableEdges_card
    [Fintype V]
    {eta Gamma d : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (hH : IsUniform H 8)
    (M : Hypergraph V) (hM : IsConflictFreeMatching H C M)
    (N₀ k : ℕ) (hN : (vertexFinset H).card = N₀)
    (hcard : M.card = k) (hcovered : 8 * k ≤ N₀)
    (hNpos : 0 < (N₀ : ℝ))
    (D₂ D₃ D₄ : ℝ)
    (Rstep : CFMTrajectories.DeltaStepRegistry
      D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d
      (N₀ : ℝ) (k : ℝ) (CFMNumeric.trajectoryFloor eta d))
    (hdegree : AvailableDegreeWithin H C M
      (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ) (k : ℝ))
      (CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) +
        CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N₀ : ℝ) (k : ℝ))) :
    localSpreadAvailableFloor eta d (N₀ : ℝ) ≤
      ((availableEdges H C M).card : ℝ) := by
  let x : ℝ := k
  have hx : x ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by
    simp [x]
  have hlo := availableEdges_card_lower_hHat_of_reachableDegreeWithin
    H C hH M hM N₀ k hN hcard hcovered hNpos
      D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d hdegree
  have hpV := Rstep.degree.pV_floor x hx
  have hdHat := Rstep.dHat_lower x hx
  have hxi : CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d
      (N₀ : ℝ) x ≤ 1 / 5 :=
    (Rstep.xi_upper x hx).trans (CFMNumeric.envelopeFactor_le_fifth S)
  have hfloor0 : 0 ≤ CFMNumeric.trajectoryFloor eta d := by
    unfold CFMNumeric.trajectoryFloor CFMNumeric.publicError
    exact div_nonneg
      (Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _)
      (by norm_num)
  have hpV0 : 0 ≤ CFMTrajectories.pV (N₀ : ℝ) x :=
    hfloor0.trans hpV
  have hbase0 : 0 ≤ Real.rpow d
      (1 - CFMNumeric.coreEpsilon eta / 32) :=
    Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have hdHat0 : 0 ≤ CFMTrajectories.dHat D₂ D₃ D₄ d
      (N₀ : ℝ) x := hbase0.trans hdHat
  have hprod :
      (N₀ : ℝ) * CFMNumeric.trajectoryFloor eta d *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) ≤
        (N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
          CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x := by
    calc
      (N₀ : ℝ) * CFMNumeric.trajectoryFloor eta d *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) ≤
          (N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
            Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) := by
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hpV (Nat.cast_nonneg N₀)) hbase0
      _ ≤ (N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
          CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x :=
        mul_le_mul_of_nonneg_left hdHat
          (mul_nonneg (Nat.cast_nonneg N₀) hpV0)
  have hhHat : CFMTrajectories.hHat D₂ D₃ D₄ d
      (N₀ : ℝ) x =
      ((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
        CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 8 := by
    unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
    ring
  rw [localSpreadAvailableFloor]
  calc
    (N₀ : ℝ) * CFMNumeric.trajectoryFloor eta d *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 16 ≤
        ((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
          CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 16 :=
      div_le_div_of_nonneg_right hprod (by norm_num)
    _ ≤ (((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
          CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 8) *
          (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d
            (N₀ : ℝ) x) := by
      have hone : (4 / 5 : ℝ) ≤ 1 -
          CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d
            (N₀ : ℝ) x := by linarith
      have hP : 0 ≤ ((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
          CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 8 := by
        positivity
      calc
        ((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
            CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 16 ≤
            (((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
              CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 8) *
                (4 / 5 : ℝ) := by nlinarith
        _ ≤ (((N₀ : ℝ) * CFMTrajectories.pV (N₀ : ℝ) x *
              CFMTrajectories.dHat D₂ D₃ D₄ d (N₀ : ℝ) x) / 8) *
                (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d
                  (N₀ : ℝ) x) :=
          mul_le_mul_of_nonneg_left hone hP
    _ = CFMTrajectories.hHat D₂ D₃ D₄ d (N₀ : ℝ) (k : ℝ) *
          (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d
            (N₀ : ℝ) (k : ℝ)) := by simp [x, hhHat]
    _ ≤ ((availableEdges H C M).card : ℝ) := hlo

theorem localSpread_rpow_mul_inv
    {d a : ℝ} (hd : 0 < d) :
    Real.rpow d a * d⁻¹ = Real.rpow d (a - 1) := by
  calc
    Real.rpow d a * d⁻¹ = Real.rpow d a / d :=
      (div_eq_mul_inv _ _).symm
    _ = Real.rpow d a / Real.rpow d 1 := by
      congr 1
      exact (Real.rpow_one d).symm
    _ = Real.rpow d (a - 1) := (Real.rpow_sub hd _ _).symm

theorem localSpread_rpow_mul_inv_sq
    {d a : ℝ} (hd : 0 < d) :
    Real.rpow d a * (d⁻¹) ^ 2 = Real.rpow d (a - 2) := by
  calc
    Real.rpow d a * (d⁻¹) ^ 2 =
        (Real.rpow d a * d⁻¹) * d⁻¹ := by ring
    _ = Real.rpow d (a - 1) * d⁻¹ := by
      rw [localSpread_rpow_mul_inv hd]
    _ = Real.rpow d ((a - 1) - 1) := localSpread_rpow_mul_inv hd
    _ = Real.rpow d (a - 2) := by congr 1 <;> ring

theorem localSpread_q2_spread_jump_eq
    {eta d : ℝ} (hd : 0 < d) :
    Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) * d⁻¹ =
      localSpreadSmallJump eta d := by
  rw [localSpread_rpow_mul_inv hd]
  unfold localSpreadSmallJump
  congr 1
  ring

theorem localSpread_q3_spread_jump_eq
    {eta d : ℝ} (hd : 0 < d) :
    Real.rpow d (3 - 5 * CFMNumeric.coreEpsilon eta / 4) * d⁻¹ =
      localSpreadAggregateJump eta d := by
  rw [localSpread_rpow_mul_inv hd]
  unfold localSpreadAggregateJump
  congr 1
  ring

theorem localSpread_q3_derivative_jump_eq
    {eta d : ℝ} (hd : 0 < d) :
    Real.rpow d (3 - 5 * CFMNumeric.coreEpsilon eta / 4) * (d⁻¹) ^ 2 =
      localSpreadSmallJump eta d := by
  rw [localSpread_rpow_mul_inv_sq hd]
  unfold localSpreadSmallJump
  congr 1
  ring

theorem vertexLocalThroughSpreadAggregateCap_of_localGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T : ℕ) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d N T) k M)
    (e : {f : Finset V // f ∈ H}) (v : ActualHostVertex H) :
    testTotal (vertexLocalThroughSpreadWeight H C e.1 v.1 3) M 1 ≤
      localSpreadAggregateCap eta d N k := by
  let a : VertexLocalThroughSpreadTailCoordinate H :=
    (e, v, Sum.inl (1 : Fin 3))
  have hcorr := indexedVertexLocalThroughSpreadGood_tail
    H C eta d N T hgood a
  have hlt : testTotal (vertexLocalThroughSpreadWeight H C e.1 v.1 3) M 1 <
      localSpreadAggregateCap eta d N k := by
    apply sub_neg.mp
    simpa [localSpreadUpperCorridor, localSpreadUpperError,
      a, vertexLocalThroughSpreadTailBaseWeight,
      vertexLocalThroughSpreadTailRank,
      vertexLocalThroughSpreadConcreteCap] using hcorr
  exact hlt.le

theorem vertexLocalThroughSpreadDerivativeCap_of_localGood
    (H : Hypergraph V) (C : ConflictSystem V)
    (eta d N : ℝ) (T : ℕ) {k : ℕ} {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate H C eta d N T) k M)
    (e : {f : Finset V // f ∈ H}) (v : ActualHostVertex H)
    (x : {f : Finset V // f ∈ H}) :
    testTotal (vertexLocalThroughSpreadDerivativeWeight
