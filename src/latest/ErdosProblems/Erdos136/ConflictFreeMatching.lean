/-- W4 from the abstract source package kills the full branch at the
empty root. -/
theorem weightedGainCollisionResidualFullRootMass_empty_eq_zero_of_properSourceBounds
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d eta W K ellSrc : ℝ} {w : TestWeight V}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc) :
    weightedGainCollisionResidualFullRootMass w H C j r ∅ = 0 := by
  unfold weightedGainCollisionResidualFullRootMass
  apply Finset.sum_eq_zero
  intro S hS
  apply Finset.sum_eq_zero
  intro e heS
  apply Finset.sum_eq_zero
  intro f hfS
  apply Finset.sum_eq_zero
  intro c hcC
  by_cases hrep : gainCollisionResidualUnion S c e f ⊆ H ∧
      e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      (∅ : Hypergraph V) ⊆ gainCollisionResidualUnion S c e f ∧
      gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f ⊆ (∅ : Hypergraph V)
  · rw [if_pos hrep]
    have hextEmpty : gainCollisionResidualConflict c e f \
        gainCollisionResidualSource S e f = ∅ :=
      Finset.eq_empty_iff_forall_notMem.mpr (fun g hg ↦ by
        have hgEmpty : g ∈ (∅ : Hypergraph V) := hrep.2.2.2.2.2 hg
        simpa using hgEmpty)
    have hfS' := (Finset.mem_erase.mp hfS).2
    have hcS : c ⊆ S := by
      intro g hgc
      by_contra hgS
