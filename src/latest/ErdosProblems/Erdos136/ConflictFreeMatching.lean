    exact (certificateInternalLayerScale_pos H C d epsRaw GammaCert
      ell j w R (q.1 + 2) hdpos).le
  have hgain : weightedPartialTestGainCollision
      (conflictLinkTestWeight R.regularized f.1 (q.1 + 1))
      H R.regularized M (q.1 + 1) (u.1 + 1) ≤
        24 * scale * Real.rpow d
          (((u.1 + 1 : ℕ) : ℝ) + 1 - (q.1 + 1 : ℕ) - epsRaw / 16) := by
    have hs1 : 1 ≤ u.1 + 1 := by omega
    have hcharge :=
