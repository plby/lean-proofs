private theorem higherKilledLossError_le_sevenThousand_common
    {D₂ D₃ D₄ Gamma eta d N a scale : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hscale : 0 ≤ scale) (hj3 : j ≤ 3)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
      (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
        d N (k : ℝ)) ≤ a) :
    ((((s * (64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d +
          Nat.ceil (30 * localSpreadPrimaryMargin eta d)) : ℕ) : ℝ) *
        (scale *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)))) / a) ≤
      7000 * (scale *
        (Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) /
            (N * CFMTrajectories.pV N (k : ℝ)))) := by
  let K : ℝ := ((s * (64 * Nat.ceil (d ^ (1 - eta)) +
    16 * certificateMixedLossCapNat eta
      (CFMRegularization.rawRegularizationEps eta) d +
    Nat.ceil (30 * localSpreadPrimaryMargin eta d)) : ℕ) : ℝ)
  let Z := CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ)
  let Env := CFMTrajectories.zeta D₂ D₃ D₄ Gamma
    (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)
  let h := CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ)
  let b := Gamma * Env / (N * CFMTrajectories.pV N (k : ℝ))
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end (k : ℝ) hx)
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos hd R.delta.degree.N_pos hp
  have hxi := (R.delta.xi_upper (k : ℝ) hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have haLower : (4 / 5 : ℝ) * h ≤ a := by
    have hm := mul_le_mul_of_nonneg_left hxi hh.le
    dsimp only [h] at haLo ⊢
    nlinarith
  have haPos : 0 < a := (mul_pos (by norm_num) hh).trans_le haLower
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hEnv0 : 0 ≤ Env := by
    dsimp only [Env]
    exact (CFMTrajectories.zeta_pos hd
      (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp
      (CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
        (R.delta.degree.time_nonneg (k : ℝ) hx)) R.s_le_j).le
  have hb0 : 0 ≤ b := by
    dsimp only [b]
    exact div_nonneg (mul_nonneg hG0 hEnv0)
      (mul_nonneg R.delta.degree.N_pos.le hp.le)
  have hK0 : 0 ≤ K := by dsimp only [K]; positivity
  have hKdelta : K ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
    dsimp only [K]
    exact killedLossCoefficient_le_delta E S R.delta (R.s_le_j.trans hj3)
  have hdelta0 : 0 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
    unfold CFMTrajectories.delta
    exact mul_nonneg
      (CFMTrajectories.xi_pos hd hp).le
      (CFMTrajectories.dHat_pos hd hp).le
  have hKbound : K ≤ 500 * Gamma *
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
    have hdeltaGamma := mul_le_mul_of_nonneg_right E.Gamma_one hdelta0
    calc
      K ≤ _ := hKdelta
      _ ≤ Gamma * _ := by simpa only [one_mul] using hdeltaGamma
      _ ≤ 500 * Gamma * _ := by
        have hm := mul_le_mul_of_nonneg_right
          (show (1 : ℝ) ≤ 500 by norm_num)
          (mul_nonneg hG0 hdelta0)
        nlinarith
  have hcorr : K * (Z + Env) ≤ 5000 * h * b := by
    dsimp only [Z, Env, h, b]
    exact CFMSharpTestCutoff.corridorProduct_le_commonScale
      S R hK0 hKbound
  apply (div_le_iff₀ haPos).2
  have hnum : K * (scale * (Z + Env)) ≤
      5000 * h * (scale * b) := by
    have hm := mul_le_mul_of_nonneg_left hcorr hscale
    nlinarith
  calc
    K * (scale * (Z + Env)) ≤ 5000 * h * (scale * b) := hnum
    _ ≤ a * (7000 * (scale * b)) := by
      have hsb0 : 0 ≤ scale * b := mul_nonneg hscale hb0
      calc
        5000 * h * (scale * b) =
            ((4 / 5 : ℝ) * h) * (6250 * (scale * b)) := by ring
        _ ≤ a * (6250 * (scale * b)) :=
          mul_le_mul_of_nonneg_right haLower
            (mul_nonneg (by norm_num) hsb0)
        _ ≤ a * (7000 * (scale * b)) := by
          apply mul_le_mul_of_nonneg_left _ haPos.le
          exact mul_le_mul_of_nonneg_right (by norm_num) hsb0
    _ = 7000 * (scale *
        (Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) /
            (N * CFMTrajectories.pV N (k : ℝ)))) * a := by
      dsimp only [b, Env]
      ring

/-- Exact higher-rank killed-loss plus survival-center reserve used by the
closed persistent component mean. -/
theorem persistentHigherKilledLoss_add_survivalCenter_le_reserve
    {D₂ D₃ D₄ Gamma eta d N a scale : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hscale : 0 ≤ scale) (hj3 : j ≤ 3)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
      (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
        d N (k : ℝ)) ≤ a) :
    ((((s * (64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d +
          Nat.ceil (30 * localSpreadPrimaryMargin eta d)) : ℕ) : ℝ) *
        (scale *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)))) / a) +
      (certificateTestStatusHi D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k / a) *
        (scale *
          ((((s + 1 : ℕ) : ℝ) *
              CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
            (s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N k *
              CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ)) /
            CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ))) ≤
      30400 * (scale *
        (Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) /
            (N * CFMTrajectories.pV N (k : ℝ)))) := by
  have hloss := higherKilledLossError_le_sevenThousand_common
    E S R hscale hj3 haLo
  have hsurvival := survivalCenterError_le_tenThousand_common
    E S hN R hscale hj3 haLo
  have hcommon0 : 0 ≤ scale *
      (Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) /
          (N * CFMTrajectories.pV N (k : ℝ))) := by
    have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
    have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
    have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
      (R.delta.degree.before_end (k : ℝ) hx)
    have hEnv0 := (CFMTrajectories.zeta_pos
      (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := Gamma)
      (epsilon := CFMNumeric.coreEpsilon eta) (j := j) (s := s)
      hd (lt_of_lt_of_le zero_lt_one E.Gamma_one) hp
      (CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
        (R.delta.degree.time_nonneg (k : ℝ) hx)) R.s_le_j).le
    exact mul_nonneg hscale (div_nonneg
      (mul_nonneg (le_trans zero_le_one E.Gamma_one) hEnv0)
      (mul_nonneg R.delta.degree.N_pos.le hp.le))
  nlinarith

private theorem rankOneCStarBound_le_base
    {eta d : ℝ} (ell : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d) :
    (∑ r ∈ Finset.Icc (2 : ℕ) 3,
      2 * finiteWeightedRootShadowMargin eta d
        ((3 * (2 * (ell : ℝ) + 1) + 1) *
          Real.rpow d ((r : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4))
        0 (r - 1)) ≤
      Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) := by
  let B := Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3)
  have hd0 : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hfactor0 : ∀ r, 0 ≤
      finiteWeightedRootShadowStepFactor eta d ^ (r - 1) := by
    intro r
    exact pow_nonneg (Real.rpow_nonneg hd0 _) _
  have hpoint : ∀ r ∈ Finset.Icc (2 : ℕ) 3,
      finiteWeightedRootShadowMargin eta d
        ((3 * (2 * (ell : ℝ) + 1) + 1) *
          Real.rpow d ((r : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4))
        0 (r - 1) ≤ localSpreadPrimaryMargin eta d := by
    intro r hr
    have hr2 : 2 ≤ r := (Finset.mem_Icc.mp hr).1
    have hr3 : r ≤ 3 := (Finset.mem_Icc.mp hr).2
    have hell0 : (0 : ℝ) ≤ (ell : ℝ) := Nat.cast_nonneg ell
    have hbase0 : 0 ≤ (3 * (2 * (ell : ℝ) + 1) + 1) *
        Real.rpow d ((r : ℝ) -
          CFMRegularization.rawRegularizationEps eta / 4) := by
      exact mul_nonneg (by nlinarith) (Real.rpow_nonneg hd0 _)
    have hmono :
        finiteWeightedRootShadowMargin eta d
            ((3 * (2 * (ell : ℝ) + 1) + 1) *
              Real.rpow d ((r : ℝ) -
                CFMRegularization.rawRegularizationEps eta / 4))
            0 (r - 1) ≤
          finiteWeightedRootShadowMargin eta d
            (768 * (3 * (2 * (ell : ℝ) + 1) + 1) *
              Real.rpow d ((r : ℝ) -
                CFMRegularization.rawRegularizationEps eta / 4))
            0 (r - 1) := by
      unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
      simp only [pow_zero, mul_one]
      apply mul_le_mul_of_nonneg_right _ (hfactor0 r)
      nlinarith
    exact hmono.trans
      (CFMSharpTestCutoff.legalRerootMargin_le_localSpreadPrimary
        ell r E S (by omega) (by omega))
  calc
    (∑ r ∈ Finset.Icc (2 : ℕ) 3,
      2 * finiteWeightedRootShadowMargin eta d
        ((3 * (2 * (ell : ℝ) + 1) + 1) *
          Real.rpow d ((r : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4))
        0 (r - 1)) ≤
      ∑ _r ∈ Finset.Icc (2 : ℕ) 3,
        2 * localSpreadPrimaryMargin eta d := by
          apply Finset.sum_le_sum
          intro r hr
          exact mul_le_mul_of_nonneg_left (hpoint r hr) (by norm_num)
    _ = 4 * localSpreadPrimaryMargin eta d := by
      norm_num [Finset.sum_Icc_succ_top] <;> ring
    _ = B / 4 := by
      dsimp only [B, localSpreadPrimaryMargin]
      ring
    _ ≤ B := by
      have hB0 : 0 ≤ B := Real.rpow_nonneg hd0 _
      nlinarith

private theorem rankOneImmediate_add_cstar_ceils_le_four_base
    {eta d : ℝ} (ell : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d) :
    ((Nat.ceil (Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 4)) +
        Nat.ceil (∑ r ∈ Finset.Icc (2 : ℕ) 3,
          2 * finiteWeightedRootShadowMargin eta d
            ((3 * (2 * (ell : ℝ) + 1) + 1) *
              Real.rpow d ((r : ℝ) -
                CFMRegularization.rawRegularizationEps eta / 4))
            0 (r - 1)) : ℕ) : ℝ) ≤
      4 * Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) := by
  let B := Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3)
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hd0 : 0 ≤ d := le_trans zero_le_one hd
  have hB0 : 0 ≤ B := Real.rpow_nonneg hd0 _
  have hB1 : 1 ≤ B := CFMSharpTestCutoff.basePower_one_le E S
  have hraw0 : 0 ≤ CFMRegularization.rawRegularizationEps eta := by
    unfold CFMRegularization.rawRegularizationEps
    linarith [E.eta_pos]
  have himmPow : Real.rpow d
      (1 - CFMRegularization.rawRegularizationEps eta / 4) ≤ B := by
    dsimp only [B]
    apply Real.rpow_le_rpow_of_exponent_le hd
    rw [CFMSharpTestCutoff.coreEpsilon_eq]
    unfold CFMRegularization.rawRegularizationEps
    linarith [E.eta_pos]
  have himmCeil : ((Nat.ceil (Real.rpow d
      (1 - CFMRegularization.rawRegularizationEps eta / 4)) : ℕ) : ℝ) ≤
      2 * B := by
    have hceil := Nat.ceil_lt_add_one (Real.rpow_nonneg hd0
      (1 - CFMRegularization.rawRegularizationEps eta / 4))
    calc
      ((Nat.ceil (Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 4)) : ℕ) : ℝ) ≤
          Real.rpow d
            (1 - CFMRegularization.rawRegularizationEps eta / 4) + 1 :=
        hceil.le
      _ ≤ B + 1 := by nlinarith [himmPow]
      _ ≤ 2 * B := by linarith
  let cstarR := ∑ r ∈ Finset.Icc (2 : ℕ) 3,
    2 * finiteWeightedRootShadowMargin eta d
      ((3 * (2 * (ell : ℝ) + 1) + 1) *
        Real.rpow d ((r : ℝ) -
          CFMRegularization.rawRegularizationEps eta / 4))
      0 (r - 1)
  have hcstar0 : 0 ≤ cstarR := by
    dsimp only [cstarR]
    apply Finset.sum_nonneg
    intro r hr
    apply mul_nonneg (by norm_num)
    unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
    have hell0 : (0 : ℝ) ≤ (ell : ℝ) := Nat.cast_nonneg ell
    have hcoeff0 : 0 ≤ 3 * (2 * (ell : ℝ) + 1) + 1 := by nlinarith
    have hd0r : 0 ≤ (3 * (2 * (ell : ℝ) + 1) + 1) *
        Real.rpow d ((r : ℝ) -
          CFMRegularization.rawRegularizationEps eta / 4) :=
      mul_nonneg hcoeff0 (Real.rpow_nonneg hd0 _)
    exact mul_nonneg
      (mul_nonneg hd0r (pow_nonneg (inv_nonneg.mpr hd0) _))
      (pow_nonneg (Real.rpow_nonneg hd0 _) _)
  have hcstar : cstarR ≤ B := by
    simpa only [cstarR] using rankOneCStarBound_le_base ell E S
  have hcstarCeil : ((Nat.ceil cstarR : ℕ) : ℝ) ≤ 2 * B := by
    have hceil := Nat.ceil_lt_add_one hcstar0
    linarith
  push_cast
  dsimp only [cstarR] at hcstarCeil ⊢
  linarith

private theorem rankOneBase_le_scale_mul_zeta
    (H : Hypergraph V) (C : ConflictSystem V)
    {d eta : ℝ} {ell : ℕ}
    {testJ : io → ℕ} {testW : io → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell testJ testW)
    {D₂ D₃ D₄ N : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) 1 1) :
    Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3) ≤
      certificateInternalLayerScale H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2 *
      CFMTrajectories.zeta D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
          d N 1 1 (k : ℝ) := by
  let eps := CFMNumeric.coreEpsilon eta
  let scale := certificateInternalLayerScale H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2
  let Env := CFMTrajectories.zeta D₂ D₃ D₄
    (6 * (2 * (ell : ℝ) + 1)) eps d N 1 1 (k : ℝ)
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hscaleFloorRaw := certificateInternalLayerScale_floor_le
    Rcert hd.le 2
  have hscaleFloor : Real.rpow d
      (1 - CFMRegularization.rawRegularizationEps eta / 600) ≤ scale := by
    dsimp only [scale]
    convert hscaleFloorRaw using 1 <;> norm_num
  have hscale0 : 0 ≤ scale := by
    dsimp only [scale]
    exact (certificateInternalLayerScale_pos H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2 hd).le
  have hEnvFloor := (CFMTrajectories.zeta_bounds_of_registry R hx).1
  have hraw : CFMRegularization.rawRegularizationEps eta = 5 * eps := by
    dsimp only [eps, CFMNumeric.coreEpsilon,
      CFMRegularization.rawRegularizationEps]
    ring
  have heps : 0 ≤ eps := by
    dsimp only [eps]
    exact CFMNumericAggregation.coreEpsilon_nonneg E
  have hexp : 1 - eps / 3 ≤
      (1 - CFMRegularization.rawRegularizationEps eta / 600) +
        (((1 : ℕ) : ℝ) - (1 : ℕ) - eps / 16) := by
    rw [hraw]
    linarith
  calc
    Real.rpow d (1 - eps / 3) ≤
        Real.rpow d
          ((1 - CFMRegularization.rawRegularizationEps eta / 600) +
            (((1 : ℕ) : ℝ) - (1 : ℕ) - eps / 16)) :=
      Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one hexp
    _ = Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 600) *
        Real.rpow d (((1 : ℕ) : ℝ) - (1 : ℕ) - eps / 16) :=
      Real.rpow_add hd _ _
    _ ≤ scale * Env :=
      mul_le_mul hscaleFloor hEnvFloor (Real.rpow_nonneg hd.le _) hscale0
    _ = _ := by dsimp only [scale, Env, eps]

private theorem rankOneVictimError_le_oneThousand_common
    (H : Hypergraph V) (C : ConflictSystem V)
    {d eta : ℝ} {ell : ℕ}
    {testJ : io → ℕ} {testW : io → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell testJ testW)
    {D₂ D₃ D₄ N a : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) 1 1)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
      (1 - CFMTrajectories.xi (6 * (2 * (ell : ℝ) + 1))
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) ≤ a) :
    (certificateTestStatusHi D₂ D₃ D₄
          (6 * (2 * (ell : ℝ) + 1))
          (CFMNumeric.coreEpsilon eta) d N k *
        ((Nat.ceil (Real.rpow d
              (1 - CFMRegularization.rawRegularizationEps eta / 4)) +
            Nat.ceil (∑ r ∈ Finset.Icc (2 : ℕ) 3,
              2 * finiteWeightedRootShadowMargin eta d
                ((3 * (2 * (ell : ℝ) + 1) + 1) *
                  Real.rpow d ((r : ℝ) -
                    CFMRegularization.rawRegularizationEps eta / 4))
                0 (r - 1)) : ℕ) : ℝ)) / a ≤
      1000 *
        (certificateInternalLayerScale H C d
          (CFMRegularization.rawRegularizationEps eta)
          (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2 *
        ((6 * (2 * (ell : ℝ) + 1)) *
          CFMTrajectories.zeta D₂ D₃ D₄
            (6 * (2 * (ell : ℝ) + 1))
            (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ) /
              (N * CFMTrajectories.pV N (k : ℝ)))) := by
  let G : ℝ := 6 * (2 * (ell : ℝ) + 1)
  let scale := certificateInternalLayerScale H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2
  let Env := CFMTrajectories.zeta D₂ D₃ D₄ G
    (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ)
  let B := Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 3)
