theorem localSpreadAvailableFloor_eq_rpow
    {eta d N : ℝ} (hd : 0 < d) :
    localSpreadAvailableFloor eta d N =
      N * Real.rpow d
        (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 := by
  unfold localSpreadAvailableFloor CFMNumeric.trajectoryFloor
    CFMNumeric.publicError
  calc
    N * (Real.rpow d (-(eta ^ 3)) / 32) *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32) / 16 =
        N * (Real.rpow d (-(eta ^ 3)) *
          Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 32)) / 512 := by
      ring
    _ = N * Real.rpow d
          (-(eta ^ 3) + (1 - CFMNumeric.coreEpsilon eta / 32)) / 512 := by
      exact congrArg (fun x : ℝ ↦ N * x / 512)
        (Real.rpow_add hd _ _).symm
    _ = N * Real.rpow d
          (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512 := by
      exact congrArg (fun x : ℝ ↦ N * Real.rpow d x / 512) (by ring)

theorem localSpreadSmallDrift_time_le_margin
    {eta Gamma d N T : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : 0 < N) (hT0 : 0 ≤ T) (hT : T ≤ N) :
    T * localSpreadSmallDrift eta d N ≤
      localSpreadDerivativeMargin eta d := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hA : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hN (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hdrift : 0 ≤ localSpreadSmallDrift eta d N := by
    unfold localSpreadSmallDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hA.le
  have hidentity :
      N * localSpreadSmallDrift eta d N =
        1536 * Real.rpow d
          (1 - 39 * CFMNumeric.coreEpsilon eta / 32 + eta ^ 3) := by
    rw [localSpreadSmallDrift, localSpreadAvailableFloor_eq_rpow hd]
    calc
      N * (3 * Real.rpow d
            (2 - 5 * CFMNumeric.coreEpsilon eta / 4) /
          (N * Real.rpow d
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512)) =
          1536 *
            (Real.rpow d (2 - 5 * CFMNumeric.coreEpsilon eta / 4) /
              Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) := by
        field_simp [ne_of_gt hN, ne_of_gt (Real.rpow_pos_of_pos hd _)]
        <;> ring
      _ = 1536 * Real.rpow d
          ((2 - 5 * CFMNumeric.coreEpsilon eta / 4) -
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)) := by
        congr 1
        exact (Real.rpow_sub hd _ _).symm
      _ = 1536 * Real.rpow d
          (1 - 39 * CFMNumeric.coreEpsilon eta / 32 + eta ^ 3) := by
        congr 2
        ring
  calc
    T * localSpreadSmallDrift eta d N ≤
        N * localSpreadSmallDrift eta d N :=
      mul_le_mul_of_nonneg_right hT hdrift
    _ = 1536 * Real.rpow d
        (1 - 39 * CFMNumeric.coreEpsilon eta / 32 + eta ^ 3) := hidentity
    _ ≤ localSpreadDerivativeMargin eta d := by
      unfold localSpreadDerivativeMargin
      apply (le_div_iff₀ (by norm_num : (0 : ℝ) < 16)).2
      have h := localSpread_growth_power_absorption
        (a := 1) E S
      nlinarith

