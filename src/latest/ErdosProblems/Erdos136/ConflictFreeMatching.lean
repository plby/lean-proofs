/-- Rank zero cannot occur in the reroot family: its source link has
positive rank. -/
theorem testConflictUnionLayer_conflictLinkLayer_zero_eq_empty
    (C : ConflictSystem V) (f g : Finset V) (a : ℕ) (ha : 1 ≤ a) :
    testConflictUnionLayer (conflictLinkLayer C f a) C g 0 = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro U hU
  have hUdata := mem_testConflictUnionLayer.mp hU
  obtain ⟨S, hS, Q, hQ, hinter, hunion⟩ :=
    mem_testConflictUnionFamily.mp hUdata.1
  have hScard : S.card = a := (mem_conflictLinkLayer.mp hS).2
  have hSnonempty : S.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨x, hxS⟩ := hSnonempty
  have hxU : x ∈ U := by
    rw [← hunion]
    exact Finset.mem_union_left Q hxS
  have hUpos : 1 ≤ U.card := Finset.card_pos.mpr ⟨x, hxU⟩
  omega

/-- Closed-root endpoint consumed by `SharpExternalProfiles`.  The active
rank is `r-1`; the impossible `r=0` boundary is discharged structurally. -/
theorem CFMRegularization.RegularizationCertificate.rerootedTestConflictUnionLayer_root_le_scale
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d epsRaw GammaCert : ℝ} {ellCert : ℕ}
    {j : ι → ℕ} {w : ι → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hdpos : 0 < d) (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    {f g : Finset V} (hf : f ∈ H) (hg : g ∈ H)
    (hfg : Disjoint f g)
    (hpair : {f, g} ∉ conflictLayer R.regularized 2)
    (a r : ℕ) (ha : a ∈ Finset.Icc 1 3) (hr5 : r ≤ 5)
    (root : Hypergraph V) (hroot : root.card ≤ r - 1) :
    weightedCodegree
        (testConflictUnionLayer
          (conflictLinkLayer R.regularized f a) R.regularized g r)
        (unitTestWeight (V := V)) root ≤
      (768 * (3 * GammaCert + 1) *
        Real.rpow d ((r : ℝ) - epsRaw / 4)) * d⁻¹ ^ root.card := by
  by_cases hr0 : r = 0
  · subst r
    have hGamma3 : 0 ≤ 3 * GammaCert :=
      regularizedBounded_Gamma_nonneg R.bounded hdpos
    have hroot0 : root = ∅ := Finset.card_eq_zero.mp (by omega)
    subst root
    rw [testConflictUnionLayer_conflictLinkLayer_zero_eq_empty
      R.regularized f g a (Finset.mem_Icc.mp ha).1]
    simp only [weightedCodegree, Finset.filter_empty, Finset.sum_empty,
      Nat.cast_zero, Finset.card_empty, pow_zero, mul_one]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (by linarith))
      (Real.rpow_nonneg hdpos.le _)
  · exact (R.rerootedTestConflictUnionLayer_isWeightedRealSpread
      hdpos hd heps hf hg hfg hpair a r ha hr5).2.2 root (by omega)

namespace CFMSharpTestCutoff

private theorem two_residual_margin_eq_rpow
    {eta d W b : ℝ} (n : ℕ) (hd : 0 < d) :
    2 * finiteWeightedRootShadowMargin eta d (W * d ^ b) 0 n =
      2 * W * d ^ (b +
        (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
  unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
    finiteWeightedRootShadowStepFactor
  simp only [pow_zero, mul_one]
  have hstep :
      (d ^ (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ n =
        d ^ ((-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ)) := by
    calc
      (d ^ (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ n =
          (d ^ (-1 + CFMNumeric.coreEpsilon eta / 16)) ^ (n : ℝ) :=
        (Real.rpow_natCast _ n).symm
      _ = d ^ ((-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ)) :=
        (Real.rpow_mul hd.le _ _).symm
  calc
    2 * (W * d ^ b *
        Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16) ^ n) =
      2 * (W * d ^ b *
        d ^ ((-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ))) :=
        congrArg (fun z : ℝ ↦ 2 * (W * d ^ b * z)) hstep
    _ = 2 * W * d ^ (b +
        (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
      let q : ℝ := (-1 + CFMNumeric.coreEpsilon eta / 16) * (n : ℝ)
      have hadd : d ^ b * d ^ q = d ^ (b + q) :=
        (Real.rpow_add hd b q).symm
      calc
        2 * (W * d ^ b * d ^ q) = 2 * W * (d ^ b * d ^ q) := by ring
        _ = 2 * W * d ^ (b + q) :=
          congrArg (fun z : ℝ ↦ 2 * W * z) hadd
        _ = 2 * W * d ^ (b +
            (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
          dsimp only [q]
          congr 2
          ring

/-- The four residual conflict ranks lose at most three root-shadow steps.
The static `/10` saving therefore leaves the honest `/16` gain-collision
saving used by the sharp mean adapter.  The `s=0` branch is handled
separately by `weightedPartialTestGainCollision_zero_of_source_zero`. -/
theorem residualRootMarginSum_le_rawSixteenth
    {eta Gamma d W : ℝ} {j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hW : 0 ≤ W) (hs : 1 ≤ s) :
    ∑ r ∈ Finset.Icc (2 : ℕ) 5,
        2 * finiteWeightedRootShadowMargin eta d
          (W * d ^ ((r : ℝ) - j -
            CFMRegularization.rawRegularizationEps eta / 10))
          0 ((r - 2) - (s - 1)) ≤
      8 * W * d ^ ((s : ℝ) + 1 - j -
        CFMRegularization.rawRegularizationEps eta / 16) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hraw0 : 0 ≤ CFMRegularization.rawRegularizationEps eta := by
    unfold CFMRegularization.rawRegularizationEps
    linarith [E.eta_pos]
  have hpoint : ∀ r ∈ Finset.Icc (2 : ℕ) 5,
      2 * finiteWeightedRootShadowMargin eta d
          (W * d ^ ((r : ℝ) - j -
            CFMRegularization.rawRegularizationEps eta / 10))
          0 ((r - 2) - (s - 1)) ≤
        2 * W * d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 16) := by
    intro r hr
    have hr2 : 2 ≤ r := (Finset.mem_Icc.mp hr).1
    have hr5 : r ≤ 5 := (Finset.mem_Icc.mp hr).2
    let n := (r - 2) - (s - 1)
    have hexp :
        (r : ℝ) - j - CFMRegularization.rawRegularizationEps eta / 10 +
            (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16) ≤
          (s : ℝ) + 1 - j -
            CFMRegularization.rawRegularizationEps eta / 16 := by
      have hcore : CFMNumeric.coreEpsilon eta =
          CFMRegularization.rawRegularizationEps eta / 5 := rfl
      by_cases hrs : r ≤ s + 1
      · have hn0 : n = 0 := by dsimp only [n]; omega
        have hrs' : (r : ℝ) ≤ (s : ℝ) + 1 := by exact_mod_cast hrs
        rw [hn0, Nat.cast_zero, zero_mul]
        linarith
      · have hrs' : s + 1 < r := by omega
        have hn3 : n ≤ 3 := by dsimp only [n]; omega
        have hcast : (n : ℝ) + (s : ℝ) + 1 = r := by
          exact_mod_cast (show n + s + 1 = r by omega)
        have hn3' : (n : ℝ) ≤ 3 := by exact_mod_cast hn3
        have hnraw : (n : ℝ) *
            CFMRegularization.rawRegularizationEps eta ≤
          3 * CFMRegularization.rawRegularizationEps eta :=
            mul_le_mul_of_nonneg_right hn3' hraw0
        rw [hcore]
        linarith
    have hpow := Real.rpow_le_rpow_of_exponent_le
      (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d) hexp
    calc
      2 * finiteWeightedRootShadowMargin eta d
          (W * d ^ ((r : ℝ) - j -
            CFMRegularization.rawRegularizationEps eta / 10))
          0 ((r - 2) - (s - 1)) =
        2 * W * d ^ ((r : ℝ) - j -
          CFMRegularization.rawRegularizationEps eta / 10 +
          (n : ℝ) * (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
            simpa only [n] using two_residual_margin_eq_rpow
              (eta := eta) (d := d) (W := W)
              (b := (r : ℝ) - j -
                CFMRegularization.rawRegularizationEps eta / 10)
              ((r - 2) - (s - 1)) hd
      _ ≤ 2 * W * d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 16) :=
        mul_le_mul_of_nonneg_left hpow
          (mul_nonneg (by norm_num) hW)
  calc
    ∑ r ∈ Finset.Icc (2 : ℕ) 5,
        2 * finiteWeightedRootShadowMargin eta d
          (W * d ^ ((r : ℝ) - j -
            CFMRegularization.rawRegularizationEps eta / 10))
          0 ((r - 2) - (s - 1)) ≤
      ∑ _r ∈ Finset.Icc (2 : ℕ) 5,
        2 * W * d ^ ((s : ℝ) + 1 - j -
          CFMRegularization.rawRegularizationEps eta / 16) :=
        Finset.sum_le_sum fun r hr ↦ hpoint r hr
    _ = 8 * W * d ^ ((s : ℝ) + 1 - j -
        CFMRegularization.rawRegularizationEps eta / 16) := by
      norm_num [Finset.sum_Icc_succ_top] <;> ring

end CFMSharpTestCutoff

