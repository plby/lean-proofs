private theorem rerootMargin_le_localSpreadPrimary_of_coefficient
    {eta d C : ℝ} (ell r : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (hC0 : 0 ≤ C) (hC : C ≤ 2304)
    (hr1 : 1 ≤ r) (hr5 : r ≤ 5) :
    finiteWeightedRootShadowMargin eta d
        (C * (3 * (2 * (ell : ℝ) + 1) + 1) *
          d ^ ((r : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4))
        0 (r - 1) ≤
      localSpreadPrimaryMargin eta d := by
  let eps := CFMNumeric.coreEpsilon eta
  let epsRaw := CFMRegularization.rawRegularizationEps eta
  let Gcert : ℝ := 2 * (ell : ℝ) + 1
  let Gcore : ℝ := 6 * Gcert
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hGcert1 : 1 ≤ Gcert := by
    dsimp only [Gcert]
    nlinarith [(Nat.cast_nonneg ell : (0 : ℝ) ≤ (ell : ℝ))]
  have hepsRaw0 : 0 ≤ epsRaw := by
    dsimp only [epsRaw, CFMRegularization.rawRegularizationEps]
    linarith [E.eta_pos]
  have hepsEq : eps = epsRaw / 5 := rfl
  have hcorr : 4 * Gcore ≤ d ^ (eps / 64) := by
    simpa only [Gcore, Gcert, eps] using S.correctionDenominator
  have hfive := S.envelopeFifth_pow 6
  have hcoeff0 :
      16 * C * (3 * Gcert + 1) ≤ (4 * Gcore) * (5 : ℝ) ^ 6 := by
    have hCmul : 16 * C * (3 * Gcert + 1) ≤
        16 * 2304 * (3 * Gcert + 1) := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hC (by norm_num)) (by positivity)
    dsimp only [Gcore]
    norm_num
    nlinarith [hCmul]
  have hcoeff :
      16 * C * (3 * Gcert + 1) ≤ d ^ (2 * epsRaw / 15) := by
    have hprod : (4 * Gcore) * (5 : ℝ) ^ 6 ≤
        d ^ (eps / 64) * d ^ ((6 : ℝ) * eps / 64) := by
      exact mul_le_mul hcorr hfive (by positivity) (by positivity)
    calc
      16 * C * (3 * Gcert + 1) ≤ (4 * Gcore) * (5 : ℝ) ^ 6 := hcoeff0
      _ ≤ d ^ (eps / 64) * d ^ ((6 : ℝ) * eps / 64) := hprod
      _ = d ^ (7 * epsRaw / 320) := by
        rw [← Real.rpow_add hd, hepsEq]
        congr 1
        ring
      _ ≤ d ^ (2 * epsRaw / 15) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
        linarith
  have hselected :
      ((r : ℝ) - epsRaw / 4) +
          ((r - 1 : ℕ) : ℝ) * (-1 + eps / 16) ≤
        1 - epsRaw / 5 := by
    have hsub : r - 1 + 1 = r := Nat.sub_add_cancel hr1
    have hcast : ((r - 1 : ℕ) : ℝ) + 1 = r := by exact_mod_cast hsub
    have hn : r - 1 ≤ 4 := by omega
    have hn' : ((r - 1 : ℕ) : ℝ) ≤ 4 := by exact_mod_cast hn
    have hnraw : ((r - 1 : ℕ) : ℝ) * epsRaw ≤ 4 * epsRaw :=
      mul_le_mul_of_nonneg_right hn' hepsRaw0
    rw [hepsEq]
    linarith
  have hpow := Real.rpow_le_rpow_of_exponent_le
    (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d) hselected
  unfold finiteWeightedRootShadowMargin finiteWeightedRootShadowZeroScale
    finiteWeightedRootShadowStepFactor localSpreadPrimaryMargin
  simp only [pow_zero, mul_one]
  have hstep :
      (d ^ (-1 + eps / 16)) ^ (r - 1) =
        d ^ ((-1 + eps / 16) * ((r - 1 : ℕ) : ℝ)) := by
    calc
      (d ^ (-1 + eps / 16)) ^ (r - 1) =
          (d ^ (-1 + eps / 16)) ^ (((r - 1 : ℕ) : ℝ)) :=
        (Real.rpow_natCast _ (r - 1)).symm
      _ = d ^ ((-1 + eps / 16) * ((r - 1 : ℕ) : ℝ)) :=
        (Real.rpow_mul hd.le _ _).symm
  let b : ℝ := (r : ℝ) - epsRaw / 4
  let q : ℝ := (-1 + eps / 16) * ((r - 1 : ℕ) : ℝ)
  have hadd : d ^ b * d ^ q = d ^ (b + q) :=
    (Real.rpow_add hd b q).symm
  have hpowerCombine :
      d ^ b * Real.rpow d (-1 + eps / 16) ^ (r - 1) =
        d ^ (b + ((r - 1 : ℕ) : ℝ) * (-1 + eps / 16)) := by
    calc
      d ^ b * Real.rpow d (-1 + eps / 16) ^ (r - 1) =
          d ^ b * d ^ q :=
        congrArg (fun z : ℝ ↦ d ^ b * z) hstep
      _ = d ^ (b + q) := hadd
      _ = d ^ (b + ((r - 1 : ℕ) : ℝ) * (-1 + eps / 16)) := by
        dsimp only [q]
        congr 1
        ring
  calc
    C * (3 * (2 * (ell : ℝ) + 1) + 1) * d ^ b *
          Real.rpow d (-1 + eps / 16) ^ (r - 1) =
        C * (3 * (2 * (ell : ℝ) + 1) + 1) *
          d ^ (b + ((r - 1 : ℕ) : ℝ) * (-1 + eps / 16)) := by
      calc
        _ = C * (3 * (2 * (ell : ℝ) + 1) + 1) *
            (d ^ b * Real.rpow d (-1 + eps / 16) ^ (r - 1)) := by ring
        _ = _ := congrArg
          (fun z : ℝ ↦ C * (3 * (2 * (ell : ℝ) + 1) + 1) * z)
          hpowerCombine
    _ = C * (3 * (2 * (ell : ℝ) + 1) + 1) *
          d ^ ((r : ℝ) - epsRaw / 4 +
            ((r - 1 : ℕ) : ℝ) * (-1 + eps / 16)) := by
      rfl
    _ =
        (16 * C * (3 * (2 * (ell : ℝ) + 1) + 1) *
          d ^ ((r : ℝ) - epsRaw / 4 +
            ((r - 1 : ℕ) : ℝ) * (-1 + eps / 16))) / 16 := by ring
    _ ≤ (d ^ (2 * epsRaw / 15) * d ^ (1 - epsRaw / 5)) / 16 := by
      apply div_le_div_of_nonneg_right _ (by norm_num)
      dsimp only [Gcert] at hcoeff
      exact mul_le_mul hcoeff hpow (Real.rpow_nonneg hd.le _) (by positivity)
    _ = d ^ (1 - eps / 3) / 16 := by
      rw [← Real.rpow_add hd, hepsEq]
      congr 1
      ring_nf

/-- The legal-reroot weighted shadow profile is absorbed by the existing
primary local-spread margin. -/
theorem legalRerootMargin_le_localSpreadPrimary
    {eta d : ℝ} (ell r : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (hr1 : 1 ≤ r) (hr5 : r ≤ 5) :
    finiteWeightedRootShadowMargin eta d
        (768 * (3 * (2 * (ell : ℝ) + 1) + 1) *
          d ^ ((r : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4))
        0 (r - 1) ≤ localSpreadPrimaryMargin eta d := by
  exact rerootMargin_le_localSpreadPrimary_of_coefficient ell r E S
    (by norm_num) (by norm_num) hr1 hr5

/-- The point-duplicate profile differs only by a factor three in its base
scale and is absorbed by the same primary margin. -/
theorem pointDuplicateMargin_le_localSpreadPrimary
    {eta d : ℝ} (ell r : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (hr3 : 3 ≤ r) (hr5 : r ≤ 5) :
    finiteWeightedRootShadowMargin eta d
        (2304 * (3 * (2 * (ell : ℝ) + 1) + 1) *
          d ^ ((r : ℝ) -
            CFMRegularization.rawRegularizationEps eta / 4))
        0 (r - 1) ≤ localSpreadPrimaryMargin eta d := by
  exact rerootMargin_le_localSpreadPrimary_of_coefficient ell r E S
    (by norm_num) (by norm_num) (by omega) hr5

end CFMSharpTestCutoff

section SharpExternalProfileClosure

variable {epsRaw GammaCert : ℝ} {ellCert : ℕ}

variable {io : Type*} [Fintype io]

theorem weightedF0TruncatedGainCollisionResidualRootMass_eq_representationSum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) (root : Hypergraph V) :
    weightedF0TruncatedGainCollisionResidualRootMass
        w H C f₀ j r root =
      ∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f ∧
            IsF0TruncatedGainCollisionResidual H C f₀
              (gainCollisionResidualConflict c e f)
        then w S else 0 := by
  unfold weightedF0TruncatedGainCollisionResidualRootMass weightedCodegree
    f0TruncatedGainCollisionResidualRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e heS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f hfS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro c hcC
  let U₀ := gainCollisionResidualUnion S c e f
  let htrunc := IsF0TruncatedGainCollisionResidual H C f₀
    (gainCollisionResidualConflict c e f)
  by_cases hrep : U₀ ⊆ H ∧ e ∈ c ∧ f ∈ c ∧
      (S ∪ c).card = r ∧ htrunc
  · by_cases hroot : root ⊆ U₀
    · have hmem : U₀ ∈
          (gainCollisionResidualLayer H C j r).filter (root ⊆ ·) := by
        apply Finset.mem_filter.mpr
        refine ⟨mem_gainCollisionResidualLayer.mpr ?_, hroot⟩
        refine ⟨hrep.1, S, hS, e, heS, f, hfS, c, hcC,
          hrep.2.1, hrep.2.2.1, hrep.2.2.2.1, rfl⟩
      rw [if_pos ⟨hrep.1, hrep.2.1, hrep.2.2.1,
        hrep.2.2.2.1, hroot, hrep.2.2.2.2⟩]
      rw [Finset.sum_eq_single U₀]
      · simp [U₀, htrunc, hrep]
      · intro U hU hUne
        simp [U₀, htrunc, hrep, hUne.symm]
      · exact fun hnot ↦ (hnot hmem).elim
    · rw [if_neg (fun h ↦ hroot h.2.2.2.2.1)]
      apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      apply hroot
      change root ⊆ gainCollisionResidualUnion S c e f
      rw [h.2.2.2.2.1]
      exact (Finset.mem_filter.mp hU).2
  · rw [if_neg]
    · apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      apply hrep
      refine ⟨?_, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.2⟩
      change gainCollisionResidualUnion S c e f ⊆ H
      rw [h.2.2.2.2.1]
      exact (mem_gainCollisionResidualLayer.mp
        (Finset.mem_filter.mp hU).1).1
    · intro h
      exact hrep ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1,
        h.2.2.2.2.2⟩

/-- The truncated full/empty-source boundary with a proper re-rooted
source.  The complementary equality case is exactly
`weightedF0TruncatedGainCollisionResidualFullCardRootMass`. -/
def weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
  ∑ c ∈ C,
    if gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
            gainCollisionResidualSource S e f ⊆ root ∧
        Disjoint root (gainCollisionResidualSource S e f) ∧
        IsF0TruncatedGainCollisionResidual H C f₀
          (gainCollisionResidualConflict c e f) ∧
        (c \ root).card < j
    then w S else 0

/-- The only place where truncation must be retained.  All other branches
are dominated by their unfiltered analogues; the full/empty boundary is
partitioned according to whether `c \ root` is a proper or full source
root. -/
theorem weightedF0TruncatedGainCollisionResidualRootMass_le_fourParts
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) (root : Hypergraph V) :
    weightedF0TruncatedGainCollisionResidualRootMass
        w H C f₀ j r root ≤
      weightedGainCollisionResidualNonFullRootMass w H C j r root +
      weightedGainCollisionResidualFullNonemptySourceRootMass
        w H C j r root +
      weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
        w H C f₀ j r root +
      weightedF0TruncatedGainCollisionResidualFullCardRootMass
        w H C f₀ j r root := by
  rw [weightedF0TruncatedGainCollisionResidualRootMass_eq_representationSum]
  unfold weightedGainCollisionResidualNonFullRootMass
    weightedGainCollisionResidualFullNonemptySourceRootMass
    weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
  repeat' rw [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro S hS
  repeat' rw [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro e heS
  repeat' rw [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro f hfS
  repeat' rw [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro c hcC
  have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
  have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
  let base : Prop := gainCollisionResidualUnion S c e f ⊆ H ∧
    e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
      root ⊆ gainCollisionResidualUnion S c e f
  let full : Prop := gainCollisionResidualConflict c e f \
    gainCollisionResidualSource S e f ⊆ root
  let emptySource : Prop :=
    Disjoint root (gainCollisionResidualSource S e f)
  let trunc : Prop := IsF0TruncatedGainCollisionResidual H C f₀
    (gainCollisionResidualConflict c e f)
  by_cases hb : base
  · by_cases ht : trunc
    · by_cases hfull : full
      · by_cases hempty : emptySource
        · have hbounds := full_emptySourceRoot_sourceRoot_card_bounds
            hS hb.1 heS hfS' (Ne.symm hfe) hb.2.1 hb.2.2.1
              hb.2.2.2.2 hfull hempty
          by_cases hcard : (c \ root).card = j
          · simp [base, full, emptySource, trunc, hb, ht, hfull,
              hempty, hcard, hw0 S]
          · have hlt : (c \ root).card < j := by omega
            simp [base, full, emptySource, trunc, hb, ht, hfull,
              hempty, hcard, hlt, hw0 S]
        · simp [base, full, emptySource, trunc, hb, ht, hfull,
            hempty, hw0 S]
      · simp [base, full, emptySource, trunc, hb, ht, hfull,
          hw0 S]
    · simp only [sdiff_le_iff, sup_eq_union', ge_iff_le]
      exact add_nonneg
        (by split <;> simp [hw0 S])
        (by split <;> simp [hw0 S])
  · have hleft : ¬(gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        IsF0TruncatedGainCollisionResidual H C f₀
          (gainCollisionResidualConflict c e f)) := by
      intro h
      exact hb ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1,
        h.2.2.2.2.1⟩
    rw [if_neg hleft]
    apply add_nonneg
    · apply add_nonneg
      · apply add_nonneg
        · split <;> simp [hw0 S]
        · split <;> simp [hw0 S]
      · split <;> simp [hw0 S]
    · split <;> simp [hw0 S]

/-- Per-source-pair Fubini bound for the proper part of the truncated
full/empty-source boundary. -/
theorem f0TruncatedFullEmptyProper_pairSum_le_twelve_extension
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {C : ConflictSystem V} {f₀ : Finset V}
    {j r : ℕ} (hj3 : j ≤ 3)
    (root S c : Hypergraph V) (hS : S ∈ H.powersetCard j) :
    (∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f ∧
            gainCollisionResidualConflict c e f \
                gainCollisionResidualSource S e f ⊆ root ∧
            Disjoint root (gainCollisionResidualSource S e f) ∧
            IsF0TruncatedGainCollisionResidual H C f₀
              (gainCollisionResidualConflict c e f) ∧
            (c \ root).card < j
        then w S else 0) ≤
      if root ⊆ c ∧ c \ root ⊆ S ∧
          2 ≤ (c \ root).card ∧ (c \ root).card < j
      then 12 * w S else 0 := by
  by_cases hcover : root ⊆ c ∧ c \ root ⊆ S ∧
      2 ≤ (c \ root).card ∧ (c \ root).card < j
  · rw [if_pos hcover]
    calc
      (∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if gainCollisionResidualUnion S c e f ⊆ H ∧
              e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
              root ⊆ gainCollisionResidualUnion S c e f ∧
              gainCollisionResidualConflict c e f \
                  gainCollisionResidualSource S e f ⊆ root ∧
              Disjoint root (gainCollisionResidualSource S e f) ∧
              IsF0TruncatedGainCollisionResidual H C f₀
                (gainCollisionResidualConflict c e f) ∧
              (c \ root).card < j
          then w S else 0) ≤
          ∑ e ∈ S, ∑ _f ∈ S.erase e, w S := by
        apply Finset.sum_le_sum
        intro e heS
        apply Finset.sum_le_sum
        intro f hfS
        split
        · exact le_rfl
        · exact hw0 S
      _ ≤ 12 * w S := by
        have hScard : S.card = j :=
          (Finset.mem_powersetCard.mp hS).2
        have hpairs : ∀ e ∈ S, (S.erase e).card ≤ 3 := by
          intro e he
          rw [Finset.card_erase_of_mem he, hScard]
          omega
        calc
          (∑ e ∈ S, ∑ _f ∈ S.erase e, w S) =
              ∑ e ∈ S, ((S.erase e).card : ℝ) * w S := by simp
          _ ≤ ∑ _e ∈ S, 3 * w S := by
            apply Finset.sum_le_sum
            intro e he
            exact mul_le_mul_of_nonneg_right
              (by exact_mod_cast hpairs e he) (hw0 S)
          _ = (S.card : ℝ) * (3 * w S) := by simp
          _ ≤ 12 * w S := by
            have hcard3 : (S.card : ℝ) ≤ 3 := by
              rw [hScard]
              exact_mod_cast hj3
            nlinarith [hw0 S]
  · rw [if_neg hcover]
    apply le_of_eq
    apply Finset.sum_eq_zero
    intro e heS
    apply Finset.sum_eq_zero
    intro f hfS
    rw [if_neg]
    intro hrep
    have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
    have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
    have hgeom := full_emptySourceRoot_geometry
      hrep.1 heS hfS' (Ne.symm hfe) hrep.2.1 hrep.2.2.1
      hrep.2.2.2.2.1 hrep.2.2.2.2.2.1
      hrep.2.2.2.2.2.2.1
    have hpair : {e, f} ⊆ c \ root := by
      intro g hg
      simp only [Finset.mem_insert, Finset.mem_singleton] at hg
      rcases hg with rfl | rfl
      · exact hgeom.2.2.2.1
      · exact hgeom.2.2.2.2
    have htwo := Finset.card_le_card hpair
    exact hcover ⟨by rw [hgeom.1]; exact Finset.sdiff_subset,
      hgeom.2.2.1, by simpa [Ne.symm hfe] using htwo,
      hrep.2.2.2.2.2.2.2.2⟩

/-- Fubini reduction of the proper-source truncated boundary. -/
theorem weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass_le_extensionSum
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {C : ConflictSystem V} {f₀ : Finset V}
    {j r : ℕ} (hj3 : j ≤ 3) (root : Hypergraph V) :
    weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
        w H C f₀ j r root ≤
      12 * ∑ c ∈ C.filter (fun c ↦ root ⊆ c ∧
          2 ≤ (c \ root).card ∧ (c \ root).card < j),
        testExtension w H j (c \ root) := by
  unfold weightedF0TruncatedGainCollisionResidualFullEmptyProperSourceRootMass
  calc
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C, _) =
      ∑ S ∈ H.powersetCard j,
      ∑ c ∈ C,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e, _ := by
        apply Finset.sum_congr rfl
        intro S hS
        calc
          (∑ e ∈ S, ∑ f ∈ S.erase e, ∑ c ∈ C, _) =
              ∑ e ∈ S, ∑ c ∈ C, ∑ f ∈ S.erase e, _ := by
                apply Finset.sum_congr rfl
                intro e he
                rw [Finset.sum_comm]
          _ = ∑ c ∈ C, ∑ e ∈ S, ∑ f ∈ S.erase e, _ := by
                rw [Finset.sum_comm]
    _ ≤ ∑ S ∈ H.powersetCard j,
        ∑ c ∈ C,
          if root ⊆ c ∧ c \ root ⊆ S ∧
              2 ≤ (c \ root).card ∧ (c \ root).card < j
          then 12 * w S else 0 := by
      apply Finset.sum_le_sum
      intro S hS
      apply Finset.sum_le_sum
      intro c hc
      exact f0TruncatedFullEmptyProper_pairSum_le_twelve_extension
        hw0 hj3 root S c hS
    _ = ∑ c ∈ C,
        if root ⊆ c ∧ 2 ≤ (c \ root).card ∧ (c \ root).card < j
        then 12 * testExtension w H j (c \ root) else 0 := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro c hc
      by_cases hrootc : root ⊆ c ∧ 2 ≤ (c \ root).card ∧
          (c \ root).card < j
      · rw [if_pos hrootc]
        simp only [hrootc.1, hrootc.2.1, hrootc.2.2,
          true_and, and_true, if_pos]
        unfold testExtension
        rw [Finset.mul_sum, ← Finset.sum_filter]
      · rw [if_neg hrootc]
        apply Finset.sum_eq_zero
        intro S hS
        rw [if_neg]
        intro h
        exact hrootc ⟨h.1, h.2.2.1, h.2.2.2⟩
    _ = ∑ c ∈ C.filter (fun c ↦ root ⊆ c ∧
          2 ≤ (c \ root).card ∧ (c \ root).card < j),
        12 * testExtension w H j (c \ root) := by
      rw [← Finset.sum_filter]
    _ = 12 * ∑ c ∈ C.filter (fun c ↦ root ⊆ c ∧
          2 ≤ (c \ root).card ∧ (c \ root).card < j),
        testExtension w H j (c \ root) := by
      rw [Finset.mul_sum]

/-- Singleton extensions summed over a supported root, using only the
proper-source package. -/
theorem sum_singleton_testExtension_root_le_of_properSourceBounds
    {w : TestWeight V} {H : Hypergraph V} {C : ConflictSystem V}
    {j : ℕ} {d eta W K ellSrc : ℝ}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc)
    (hj2 : 2 ≤ j) (root : Hypergraph V) (hrootH : root ⊆ H) :
    (∑ g ∈ root, testExtension w H j {g}) ≤
      (root.card : ℝ) *
        (K * W / Real.rpow d (1 + eta)) := by
  calc
    (∑ g ∈ root, testExtension w H j {g}) ≤
        ∑ _g ∈ root, K * W / Real.rpow d (1 + eta) := by
      apply Finset.sum_le_sum
      intro g hgroot
      have hgH : g ∈ H := hrootH hgroot
      have hext := hP.2.2.2.1 ({g} : Hypergraph V)
        (by simp [hgH]) (by simp) (by simpa using (show 1 < j by omega))
      simpa using hext
    _ = (root.card : ℝ) *
        (K * W / Real.rpow d (1 + eta)) := by simp

/-- Full/source-meeting mass under the abstract proper-source package. -/
theorem weightedGainCollisionResidualFullNonemptySourceRootMass_le_raw_of_properSourceBounds
    {H : Hypergraph V} {C : ConflictSystem V}
    {j r : ℕ} {d eta W K ellSrc : ℝ} {w : TestWeight V}
    (hP : HasGainCollisionResidualProperSourceBounds
      w H C j d eta W K ellSrc)
    (hd : 1 ≤ d) (hK0 : 0 ≤ K) (hW0 : 0 ≤ W)
    (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualFullNonemptySourceRootMass
        w H C j r root ≤
      24 * K * W * Real.rpow d (-(1 + eta)) := by
  rw [weightedGainCollisionResidualFullNonemptySourceRootMass_eq_sum]
  by_cases hj2 : 2 ≤ j
  · have hcandidates : ∀ S ∈ H.powersetCard j,
        ∀ e ∈ S, ∀ f ∈ S.erase e,
        ((gainCollisionResidualFullConflictCandidates
          H C S e f r root).card : ℝ) ≤ 2 := by
      intro S hS e heS f hfS
      exact_mod_cast gainCollisionResidualFullConflictCandidates_card_le_two
        hS heS hfS hj3
    have hmeet := sourcePair_meetingRoot_weight_le_rootExtensionSum
      (H := H) hP.1 hj3 root
    have hsingle :=
      sum_singleton_testExtension_root_le_of_properSourceBounds
        hP hj2 root hrootH
    have hdenPos : 0 < Real.rpow d (1 + eta) :=
      Real.rpow_pos_of_pos (by linarith) _
    have hratio0 : 0 ≤ K * W / Real.rpow d (1 + eta) :=
      div_nonneg (mul_nonneg hK0 hW0) hdenPos.le
    calc
      (∑ S ∈ H.powersetCard j,
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f) then
            w S * (gainCollisionResidualFullConflictCandidates
              H C S e f r root).card else 0) ≤
        2 * (∑ S ∈ H.powersetCard j,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e,
            if ¬Disjoint root (gainCollisionResidualSource S e f)
            then w S else 0) := by
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro S hS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro e heS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro f hfS
          by_cases hmeetSF : ¬Disjoint root
              (gainCollisionResidualSource S e f)
          · rw [if_pos hmeetSF, if_pos hmeetSF]
            have hcand := hcandidates S hS e heS f hfS
            calc
              w S * (gainCollisionResidualFullConflictCandidates
                  H C S e f r root).card ≤ w S * 2 :=
                mul_le_mul_of_nonneg_left hcand (hP.1 S)
              _ = 2 * w S := by ring
          · rw [if_neg hmeetSF, if_neg hmeetSF]
            norm_num
      _ ≤ 2 * (6 * ∑ g ∈ root, testExtension w H j {g}) :=
        mul_le_mul_of_nonneg_left hmeet (by norm_num)
      _ ≤ 12 * ((root.card : ℝ) *
          (K * W / Real.rpow d (1 + eta))) := by
        nlinarith
      _ ≤ 24 * (K * W / Real.rpow d (1 + eta)) := by
        nlinarith [show (root.card : ℝ) ≤ 2 by exact_mod_cast hroot2]
      _ = 24 * K * W * Real.rpow d (-(1 + eta)) := by
        calc
          24 * (K * W / Real.rpow d (1 + eta)) =
              24 * K * W * (Real.rpow d (1 + eta))⁻¹ := by ring
          _ = 24 * K * W * Real.rpow d (-(1 + eta)) := by
            congr 2
            exact (Real.rpow_neg (by linarith : 0 ≤ d) _).symm
  · have hj1 : j ≤ 1 := by omega
    apply le_trans (b := 0)
    · apply Finset.sum_nonpos
      intro S hS
      have hScard := (Finset.mem_powersetCard.mp hS).2
      have hSone : S.card ≤ 1 := by omega
      apply Finset.sum_nonpos
      intro e heS
      have hErase : S.erase e = ∅ := by
        apply Finset.card_eq_zero.mp
        rw [Finset.card_erase_of_mem heS]
        omega
      rw [hErase]
      simp
    · exact mul_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) hK0) hW0)
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

/-- Endpoint version of the source-meeting estimate for a root of
