theorem weightedGainCollisionResidualRootMass_le_raw
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hjr : j ≤ r)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot2 : root.card ≤ 2) :
    weightedGainCollisionResidualRootMass w H C j r root ≤
      72 * (Gamma + 1) * (ell : ℝ) * testTotal w H j *
        Real.rpow d
          (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
  let W := testTotal w H j
  let A : ℝ := (Gamma + 1) * (ell : ℝ)
  let E : ℝ := ((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5
  have hdpos : 0 < d := by linarith
  have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hdpos
  have hA1 : 1 ≤ A := by
    dsimp only [A]
    have hellReal : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
    nlinarith
  have hW0 : 0 ≤ W := testTotal_nonneg hw.isTestFunction.nonneg H j
  have hE0 : 0 ≤ Real.rpow d E :=
    Real.rpow_nonneg (by linarith : 0 ≤ d) E
  suffices weightedGainCollisionResidualRootMass w H C j r root ≤
      72 * A * W * Real.rpow d E by
    simpa only [A, W, E, mul_assoc] using this
  have hnonRaw := weightedGainCollisionResidualNonFullRootMass_le_raw
    (r := r) hw hB hd heps hj3 root hrootH hroot2
  have hnon : weightedGainCollisionResidualNonFullRootMass
      w H C j r root ≤ 36 * W * Real.rpow d E := by
    apply hnonRaw.trans
    apply mul_le_mul_of_nonneg_left _
      (mul_nonneg (by norm_num) hW0)
    apply Real.rpow_le_rpow_of_exponent_le hd
    dsimp only [E]
    linarith
  have hcoefNon : 36 ≤ 72 * A := by nlinarith
  rw [weightedGainCollisionResidualRootMass_eq_nonFull_add_full]
  by_cases hrootZero : root.card = 0
  · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
    subst root
    rw [weightedGainCollisionResidualFullRootMass_empty_eq_zero hw, add_zero]
    exact hnon.trans (by
      apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hcoefNon hW0
      · exact hE0)
  · have hroot1 : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
    rw [weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty]
    by_cases hemptyRank : root.card = r - j
    · have hnonemptyZero :
          weightedGainCollisionResidualFullNonemptySourceRootMass
            w H C j r root = 0 := by
        apply weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
          w H C j r hj3 root
        omega
      rw [hnonemptyZero, add_zero]
      have hfull := weightedGainCollisionResidualFullEmptySourceRootMass_le_raw
        (r := r) hw hB hd heps hell hj3 root hrootH hroot1
      have hfull' : weightedGainCollisionResidualFullEmptySourceRootMass
          w H C j r root ≤
          36 * A * W * Real.rpow d (-(epsRaw / 5)) := by
        simpa only [A, W, mul_assoc] using hfull
      have hEeq : E = -(epsRaw / 5) := by
        dsimp only [E]
        rw [hemptyRank]
        ring
      have hsum := add_le_add hnon hfull'
      apply hsum.trans
      rw [hEeq]
      have hcoef : 36 + 36 * A ≤ 72 * A := by nlinarith
      calc
        36 * W * Real.rpow d (-(epsRaw / 5)) +
            36 * A * W * Real.rpow d (-(epsRaw / 5)) =
          (36 + 36 * A) * W * Real.rpow d (-(epsRaw / 5)) := by ring
        _ ≤ 72 * A * W * Real.rpow d (-(epsRaw / 5)) := by
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hcoef hW0)
            (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
    · by_cases hnonemptyRank : root.card = r - j + 1
      · have hemptyZero :
            weightedGainCollisionResidualFullEmptySourceRootMass
              w H C j r root = 0 :=
          weightedGainCollisionResidualFullEmptySourceRootMass_eq_zero_of_card_ne
            w H C j r root hemptyRank
        rw [hemptyZero, zero_add]
        have hfull :=
          weightedGainCollisionResidualFullNonemptySourceRootMass_le_raw
            (r := r) hw hd hj3 root hrootH hroot2
        have hfull' :
            weightedGainCollisionResidualFullNonemptySourceRootMass
              w H C j r root ≤
              24 * W * Real.rpow d (-(1 + epsRaw / 5)) := by
          simpa only [W] using hfull
        have hEeq : E = -(1 + epsRaw / 5) := by
          dsimp only [E]
          rw [hnonemptyRank]
          push_cast
          ring
        have hsum := add_le_add hnon hfull'
        apply hsum.trans
        rw [hEeq]
        have hcoef : 36 + 24 ≤ 72 * A := by nlinarith
        calc
          36 * W * Real.rpow d (-(1 + epsRaw / 5)) +
              24 * W * Real.rpow d (-(1 + epsRaw / 5)) =
            (36 + 24) * W * Real.rpow d (-(1 + epsRaw / 5)) := by ring
          _ ≤ 72 * A * W * Real.rpow d (-(1 + epsRaw / 5)) := by
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right hcoef hW0)
              (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
      · have hemptyZero :
            weightedGainCollisionResidualFullEmptySourceRootMass
              w H C j r root = 0 :=
          weightedGainCollisionResidualFullEmptySourceRootMass_eq_zero_of_card_ne
            w H C j r root hemptyRank
        have hnonemptyZero :
            weightedGainCollisionResidualFullNonemptySourceRootMass
              w H C j r root = 0 :=
          weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
            w H C j r hj3 root hnonemptyRank
        rw [hemptyZero, hnonemptyZero, add_zero, add_zero]
        exact hnon.trans (by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hcoefNon hW0
          · exact hE0)

theorem weightedGainCollisionResidualRootMass_le
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr5 : r ≤ 5)
    (hcutoff : 72 * (Gamma + 1) * (ell : ℝ) ≤
      Real.rpow d (epsRaw / 10))
    (root : Hypergraph V) (hrootCard : root.card < r - 2) :
    weightedGainCollisionResidualRootMass w H C j r root ≤
      testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10 - (root.card : ℝ)) := by
  by_cases hrootH : root ⊆ H
  · by_cases hjr : j ≤ r
    · have hroot2 : root.card ≤ 2 := by omega
      have hraw := weightedGainCollisionResidualRootMass_le_raw
        (r := r) hw hB hd heps hell hj3 hjr root hrootH hroot2
      have hW0 := testTotal_nonneg hw.isTestFunction.nonneg H j
      have hrpow0 := Real.rpow_nonneg (by linarith : 0 ≤ d)
        (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5)
      apply hraw.trans
      calc
        72 * (Gamma + 1) * (ell : ℝ) * testTotal w H j *
            Real.rpow d
              (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5) ≤
          Real.rpow d (epsRaw / 10) * testTotal w H j *
            Real.rpow d
              (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5) := by
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hcutoff hW0) hrpow0
        _ = testTotal w H j * Real.rpow d
            (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 10) := by
          calc
            Real.rpow d (epsRaw / 10) * testTotal w H j *
                Real.rpow d
                  (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5) =
              testTotal w H j *
                (Real.rpow d (epsRaw / 10) *
                  Real.rpow d
                    (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5)) := by
                ring
            _ = testTotal w H j * Real.rpow d
                (epsRaw / 10 +
                  (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 5)) := by
              congr 1
              exact (Real.rpow_add (by linarith : 0 < d) _ _).symm
            _ = testTotal w H j * Real.rpow d
                (((r - j : ℕ) : ℝ) - (root.card : ℝ) - epsRaw / 10) := by
              congr 1
              ring_nf
        _ = testTotal w H j * Real.rpow d
            ((r : ℝ) - (j : ℝ) - epsRaw / 10 -
              (root.card : ℝ)) := by
          congr 1
          rw [Nat.cast_sub hjr]
          ring_nf
    · have hrj : r < j := by omega
      rw [weightedGainCollisionResidualRootMass_eq_zero_of_rank_lt_source
        w H C j r root hrj]
      exact mul_nonneg
        (testTotal_nonneg hw.isTestFunction.nonneg H j)
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
  · rw [weightedGainCollisionResidualRootMass_eq_zero_of_not_subset_host
      w H C j r root hrootH]
    exact mul_nonneg
      (testTotal_nonneg hw.isTestFunction.nonneg H j)
      (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

/-- External static spread theorem for every supported gain-collision
residual rank `r-2`, `2≤r≤5`. -/
theorem gainCollisionResidualLayer_isWeightedRealSpread_of_trackable
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr2 : 2 ≤ r) (hr5 : r ≤ 5)
    (hcutoff : 72 * (Gamma + 1) * (ell : ℝ) ≤
      Real.rpow d (epsRaw / 10)) :
    IsWeightedRealSpread
      (gainCollisionResidualLayer H C j r)
      (gainCollisionResidualRepresentationWeight w H C j r)
      (r - 2)
      (testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10)) d⁻¹ := by
  apply gainCollisionResidualLayer_isWeightedRealSpread_of_rootMass
    hw.isTestFunction.nonneg H C j r d (epsRaw / 10)
      (testTotal w H j) (by linarith)
  intro root hroot
  exact weightedGainCollisionResidualRootMass_le
    hw hB hd heps hell hj3 hr5 hcutoff root hroot


theorem weightedGainCollisionResidualRootMass_eq_zero_of_source_card_lt_two
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V) (hj : j < 2) :
    weightedGainCollisionResidualRootMass w H C j r root = 0 := by
  rw [weightedGainCollisionResidualRootMass_eq_representationSum]
  apply Finset.sum_eq_zero
  intro S hS
  apply Finset.sum_eq_zero
  intro e heS
  apply Finset.sum_eq_zero
  intro f hfS
  have hfS' := (Finset.mem_erase.mp hfS).2
  have hfe := (Finset.mem_erase.mp hfS).1
  have hpair : {e, f} ⊆ S := by
    intro g hg
    simp only [Finset.mem_insert, Finset.mem_singleton] at hg
    rcases hg with rfl | rfl
    · exact heS
    · exact hfS'
  have htwo := Finset.card_le_card hpair
  have hScard := (Finset.mem_powersetCard.mp hS).2
  apply Finset.sum_eq_zero
  intro c hc
  rw [if_neg]
  intro _hrep
  rw [hScard] at htwo
  have : 2 ≤ j := by simpa [Ne.symm hfe] using htwo
  omega

/-- At the full residual rank, every rooted representation already contains
all of its conflict residual outside the source residual. -/
theorem weightedGainCollisionResidualNonFullRootMass_eq_zero_of_fullRank
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (j r : ℕ) (root : Hypergraph V)
    (hrootCard : root.card = r - 2) :
    weightedGainCollisionResidualNonFullRootMass
      w H C j r root = 0 := by
  unfold weightedGainCollisionResidualNonFullRootMass
  apply Finset.sum_eq_zero
  intro S hS
  apply Finset.sum_eq_zero
  intro e heS
  apply Finset.sum_eq_zero
  intro f hfS
  apply Finset.sum_eq_zero
  intro c hcC
  rw [if_neg]
  intro hrep
  let U := gainCollisionResidualUnion S c e f
  have hUmem : U ∈ gainCollisionResidualLayer H C j r := by
    apply mem_gainCollisionResidualLayer.mpr
    exact ⟨hrep.1, S, hS, e, heS, f, hfS, c, hcC,
      hrep.2.1, hrep.2.2.1, hrep.2.2.2.1, rfl⟩
  have hUcard : U.card = r - 2 :=
    gainCollisionResidualLayer_uniform H C j r U hUmem
  have hrootEq : root = U :=
    Finset.eq_of_subset_of_card_le hrep.2.2.2.2.1
      (by rw [hrootCard, hUcard])
  apply hrep.2.2.2.2.2
  rw [hrootEq]
  change gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆
    gainCollisionResidualUnion S c e f
  rw [gainCollisionResidualUnion_eq_source_union_conflict]
  intro g hg
  exact Finset.mem_union_right _ (Finset.mem_sdiff.mp hg).1

/-- The full/nonempty-source estimate with the endpoint root cap three.
Only the final finite-cardinality arithmetic differs from the existing
`...le_raw` theorem. -/
theorem weightedGainCollisionResidualFullNonemptySourceRootMass_le_raw_three
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hd : 1 ≤ d) (hj3 : j ≤ 3)
    (root : Hypergraph V) (hrootH : root ⊆ H) (hroot3 : root.card ≤ 3) :
    weightedGainCollisionResidualFullNonemptySourceRootMass
        w H C j r root ≤
      36 * testTotal w H j *
        Real.rpow d (-(1 + epsRaw / 5)) := by
  rw [weightedGainCollisionResidualFullNonemptySourceRootMass_eq_sum]
  by_cases hj2 : 2 ≤ j
  · have hcandidates : ∀ S ∈ H.powersetCard j,
        ∀ e ∈ S, ∀ f ∈ S.erase e,
        ((gainCollisionResidualFullConflictCandidates
          H C S e f r root).card : ℝ) ≤ 2 := by
      intro S hS e heS f hfS
      exact_mod_cast gainCollisionResidualFullConflictCandidates_card_le_two
        hS heS hfS hj3
    have hmeet := sourcePair_meetingRoot_weight_le_rootExtensionSum
      (H := H) hw.isTestFunction.nonneg hj3 root
    have htotal0 := testTotal_nonneg hw.isTestFunction.nonneg H j
    have hdenPos : 0 < Real.rpow d (1 + epsRaw / 5) :=
      Real.rpow_pos_of_pos (by linarith) _
    calc
      (∑ S ∈ H.powersetCard j,
        ∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if ¬Disjoint root (gainCollisionResidualSource S e f) then
            w S * (gainCollisionResidualFullConflictCandidates
              H C S e f r root).card else 0) ≤
        2 * (∑ S ∈ H.powersetCard j,
          ∑ e ∈ S,
          ∑ f ∈ S.erase e,
            if ¬Disjoint root (gainCollisionResidualSource S e f)
            then w S else 0) := by
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro S hS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro e heS
          rw [Finset.mul_sum]
          apply Finset.sum_le_sum
          intro f hfS
          by_cases hmeet : ¬Disjoint root
              (gainCollisionResidualSource S e f)
          · rw [if_pos hmeet, if_pos hmeet]
            have hcand := hcandidates S hS e heS f hfS
            calc
              w S * (gainCollisionResidualFullConflictCandidates
                  H C S e f r root).card ≤ w S * 2 :=
                mul_le_mul_of_nonneg_left hcand
                  (hw.isTestFunction.nonneg S)
              _ = 2 * w S := by ring
          · rw [if_neg hmeet, if_neg hmeet]
            norm_num
      _ ≤ 2 * (6 * ∑ g ∈ root, testExtension w H j {g}) :=
        mul_le_mul_of_nonneg_left hmeet (by norm_num)
      _ ≤ 12 * ((root.card : ℝ) *
          (testTotal w H j / Real.rpow d (1 + epsRaw / 5))) := by
        have hext := sum_singleton_testExtension_root_le hw root hrootH hj2
        nlinarith
      _ ≤ 36 *
          (testTotal w H j / Real.rpow d (1 + epsRaw / 5)) := by
        have hratio0 : 0 ≤
            testTotal w H j / Real.rpow d (1 + epsRaw / 5) :=
          div_nonneg htotal0 hdenPos.le
        nlinarith [show (root.card : ℝ) ≤ 3 by exact_mod_cast hroot3]
      _ = 36 * testTotal w H j *
          Real.rpow d (-(1 + epsRaw / 5)) := by
        calc
          36 * (testTotal w H j /
              Real.rpow d (1 + epsRaw / 5)) =
              36 * testTotal w H j *
                (Real.rpow d (1 + epsRaw / 5))⁻¹ := by ring
          _ = 36 * testTotal w H j *
              Real.rpow d (-(1 + epsRaw / 5)) := by
            congr 2
            exact (Real.rpow_neg (by linarith : 0 ≤ d) _).symm
  · have hj1 : j ≤ 1 := by omega
    apply le_trans (b := 0)
    · apply Finset.sum_nonpos
      intro S hS
      have hScard := (Finset.mem_powersetCard.mp hS).2
      have hSone : S.card ≤ 1 := by omega
      apply Finset.sum_nonpos
      intro e heS
      have hErase : S.erase e = ∅ := by
        apply Finset.card_eq_zero.mp
        rw [Finset.card_erase_of_mem heS]
        omega
      rw [hErase]
      simp
    · exact mul_nonneg
        (mul_nonneg (by norm_num)
          (testTotal_nonneg hw.isTestFunction.nonneg H j))
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

/-- Exact full-root endpoint at the natural spread scale. -/
theorem weightedGainCollisionResidualRootMass_le_of_fullRank
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr2 : 2 ≤ r) (hr5 : r ≤ 5)
    (hcutoff : 72 * (Gamma + 1) * (ell : ℝ) ≤
      Real.rpow d (epsRaw / 10))
    (root : Hypergraph V) (hrootCard : root.card = r - 2) :
    weightedGainCollisionResidualRootMass w H C j r root ≤
      testTotal w H j *
        Real.rpow d (2 - (j : ℝ) - epsRaw / 10) := by
  have hW0 := testTotal_nonneg hw.isTestFunction.nonneg H j
  have hnonfull := weightedGainCollisionResidualNonFullRootMass_eq_zero_of_fullRank
    w H C j r root hrootCard
  rw [weightedGainCollisionResidualRootMass_eq_nonFull_add_full,
    hnonfull, zero_add]
  by_cases hrootH : root ⊆ H
  · by_cases hrootZero : root.card = 0
    · have hrootEmpty : root = ∅ := Finset.card_eq_zero.mp hrootZero
      subst root
      rw [weightedGainCollisionResidualFullRootMass_empty_eq_zero hw]
      exact mul_nonneg hW0
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
    · have hroot1 : 1 ≤ root.card := Nat.one_le_iff_ne_zero.mpr hrootZero
      rw [weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty]
      interval_cases j
      · have hzero := weightedGainCollisionResidualRootMass_eq_zero_of_source_card_lt_two
          w H C 0 r root (by omega)
        rw [weightedGainCollisionResidualRootMass_eq_nonFull_add_full,
          hnonfull, zero_add] at hzero
        rw [← weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty]
        rw [hzero]
        exact mul_nonneg hW0
          (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
      · have hzero := weightedGainCollisionResidualRootMass_eq_zero_of_source_card_lt_two
          w H C 1 r root (by omega)
        rw [weightedGainCollisionResidualRootMass_eq_nonFull_add_full,
          hnonfull, zero_add] at hzero
        rw [← weightedGainCollisionResidualFullRootMass_eq_empty_add_nonempty]
        rw [hzero]
        exact mul_nonneg hW0
          (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
      · have hnonemptyZero :
            weightedGainCollisionResidualFullNonemptySourceRootMass
              w H C 2 r root = 0 := by
          apply weightedGainCollisionResidualFullNonemptySourceRootMass_eq_zero_of_card_ne
            w H C 2 r (by omega) root
          rw [hrootCard]
          omega
        rw [hnonemptyZero, add_zero]
        have hfull := weightedGainCollisionResidualFullEmptySourceRootMass_le_raw
          (r := r) hw hB hd heps hell (by omega) root hrootH hroot1
        have hdpos : 0 < d := by linarith
        have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hdpos
        have hellReal : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
        have hcoef : 36 * (Gamma + 1) * (ell : ℝ) ≤
            Real.rpow d (epsRaw / 10) := by
          apply le_trans _ hcutoff
          nlinarith
        have hpow0 := Real.rpow_nonneg
          (by linarith : 0 ≤ d) (-(epsRaw / 5))
        apply hfull.trans
        calc
          36 * (Gamma + 1) * (ell : ℝ) * testTotal w H 2 *
              Real.rpow d (-(epsRaw / 5)) ≤
            Real.rpow d (epsRaw / 10) * testTotal w H 2 *
              Real.rpow d (-(epsRaw / 5)) := by
                exact mul_le_mul_of_nonneg_right
                  (mul_le_mul_of_nonneg_right hcoef hW0) hpow0
          _ = testTotal w H 2 * Real.rpow d (-(epsRaw / 10)) := by
            calc
              _ = testTotal w H 2 *
                  (Real.rpow d (epsRaw / 10) *
                    Real.rpow d (-(epsRaw / 5))) := by ring
              _ = testTotal w H 2 *
                  Real.rpow d (epsRaw / 10 + (-(epsRaw / 5))) := by
                    congr 1
                    exact (Real.rpow_add hdpos _ _).symm
              _ = testTotal w H 2 * Real.rpow d (-(epsRaw / 10)) := by
                    congr 1
                    ring_nf
          _ = testTotal w H 2 *
              Real.rpow d (2 - (2 : ℝ) - epsRaw / 10) := by
                congr 1
                ring_nf
      · have hemptyZero :
            weightedGainCollisionResidualFullEmptySourceRootMass
              w H C 3 r root = 0 := by
          apply weightedGainCollisionResidualFullEmptySourceRootMass_eq_zero_of_card_ne
            w H C 3 r root
          rw [hrootCard]
          omega
        rw [hemptyZero, zero_add]
        have hroot3 : root.card ≤ 3 := by rw [hrootCard]; omega
        have hfull := weightedGainCollisionResidualFullNonemptySourceRootMass_le_raw_three
          (r := r) hw hd (by omega) root hrootH hroot3
        have hcoefBase : 36 ≤ Real.rpow d (epsRaw / 10) := by
          have hdpos : 0 < d := by linarith
          have hGamma : 0 ≤ Gamma := regularizedBounded_Gamma_nonneg hB hdpos
          have hellReal : (1 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
          apply le_trans (b := 72 * (Gamma + 1) * (ell : ℝ))
          · nlinarith
          · exact hcutoff
        have hpow0 := Real.rpow_nonneg
          (by linarith : 0 ≤ d) (-(1 + epsRaw / 5))
        apply hfull.trans
        calc
          36 * testTotal w H 3 * Real.rpow d (-(1 + epsRaw / 5)) ≤
              Real.rpow d (epsRaw / 10) * testTotal w H 3 *
                Real.rpow d (-(1 + epsRaw / 5)) := by
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right hcoefBase hW0) hpow0
          _ = testTotal w H 3 * Real.rpow d (-(1 + epsRaw / 10)) := by
            calc
              _ = testTotal w H 3 *
                  (Real.rpow d (epsRaw / 10) *
                    Real.rpow d (-(1 + epsRaw / 5))) := by ring
              _ = testTotal w H 3 *
                  Real.rpow d (epsRaw / 10 + (-(1 + epsRaw / 5))) := by
                    congr 1
                    exact (Real.rpow_add (by linarith : 0 < d) _ _).symm
              _ = testTotal w H 3 *
                  Real.rpow d (-(1 + epsRaw / 10)) := by
                    congr 1
                    ring_nf
          _ = testTotal w H 3 *
              Real.rpow d (2 - (3 : ℝ) - epsRaw / 10) := by
                congr 1
                ring_nf
  · have hrootMassZero :=
      weightedGainCollisionResidualRootMass_eq_zero_of_not_subset_host
        w H C j r root hrootH
    rw [weightedGainCollisionResidualRootMass_eq_nonFull_add_full,
      hnonfull, zero_add] at hrootMassZero
    rw [hrootMassZero]
    exact mul_nonneg hW0
      (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

/-- The same endpoint in the literal `d₀ * delta^|root|` form consumed by
the weighted shadow hierarchy. -/
theorem weightedGainCollisionResidualRootMass_le_of_fullRank_spreadForm
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr2 : 2 ≤ r) (hr5 : r ≤ 5)
    (hcutoff : 72 * (Gamma + 1) * (ell : ℝ) ≤
      Real.rpow d (epsRaw / 10))
    (root : Hypergraph V) (hrootCard : root.card = r - 2) :
    weightedGainCollisionResidualRootMass w H C j r root ≤
      (testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10)) *
          d⁻¹ ^ root.card := by
  have hendpoint := weightedGainCollisionResidualRootMass_le_of_fullRank
    hw hB hd heps hell hj3 hr2 hr5 hcutoff root hrootCard
  apply hendpoint.trans_eq
  have hinv : d⁻¹ ^ root.card =
      Real.rpow d (-(root.card : ℝ)) := by
    calc
      d⁻¹ ^ root.card = (d ^ root.card)⁻¹ := inv_pow d root.card
      _ = (Real.rpow d (root.card : ℝ))⁻¹ := by
        exact congrArg Inv.inv (Real.rpow_natCast d root.card).symm
      _ = Real.rpow d (-(root.card : ℝ)) :=
        (Real.rpow_neg (by linarith : 0 ≤ d) _).symm
  rw [hinv]
  calc
    testTotal w H j * Real.rpow d
        (2 - (j : ℝ) - epsRaw / 10) =
      testTotal w H j *
        (Real.rpow d ((r : ℝ) - (j : ℝ) - epsRaw / 10) *
          Real.rpow d (-(root.card : ℝ))) := by
            congr 1
            calc
              Real.rpow d (2 - (j : ℝ) - epsRaw / 10) =
                  Real.rpow d
                    (((r : ℝ) - (j : ℝ) - epsRaw / 10) +
                      (-(root.card : ℝ))) := by
                congr 1
                rw [hrootCard, Nat.cast_sub hr2]
                ring
              _ = Real.rpow d ((r : ℝ) - (j : ℝ) - epsRaw / 10) *
                    Real.rpow d (-(root.card : ℝ)) :=
                Real.rpow_add (by linarith : 0 < d) _ _
    _ = (testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10)) *
          Real.rpow d (-(root.card : ℝ)) := by ring

/-- Closed-root form used by the custom tail: it includes the full residual
root, unlike `IsWeightedRealSpread`. -/
theorem weightedGainCollisionResidualRootMass_le_closed
    {H : Hypergraph V} {C : ConflictSystem V}
    {j ell r : ℕ} {d epsRaw Gamma : ℝ} {w : TestWeight V}
    (hw : IsTrackable H C j ell d (epsRaw / 5) w)
    (hB : CFMRegularization.IsRegularizedBounded
      H C d Gamma (epsRaw / 4))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hell : 1 ≤ ell)
    (hj3 : j ≤ 3) (hr2 : 2 ≤ r) (hr5 : r ≤ 5)
    (hcutoff : 72 * (Gamma + 1) * (ell : ℝ) ≤
      Real.rpow d (epsRaw / 10))
    (root : Hypergraph V) (hrootCard : root.card ≤ r - 2) :
    weightedGainCollisionResidualRootMass w H C j r root ≤
      testTotal w H j * Real.rpow d
        ((r : ℝ) - (j : ℝ) - epsRaw / 10 - (root.card : ℝ)) := by
  rcases hrootCard.eq_or_lt with hfull | hproper
  · have hendpoint := weightedGainCollisionResidualRootMass_le_of_fullRank
      hw hB hd heps hell hj3 hr2 hr5 hcutoff root hfull
    apply hendpoint.trans_eq
    congr 1
    rw [hfull]
    have hr2' : 2 ≤ r := hr2
    rw [Nat.cast_sub hr2']
    ring_nf
  · exact weightedGainCollisionResidualRootMass_le
      hw hB hd heps hell hj3 hr5 hcutoff root hproper

def IsF0TruncatedGainCollisionResidual
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (R : Hypergraph V) : Prop :=
  (∀ g ∈ R, Disjoint f₀ g) ∧
    Disjoint R (CFMRegularization.twoConflictNeighbors H C f₀)

/-- Internal-only representation weight.  Its underlying family is still
the host-supported static residual layer; only representations whose
conflict residual satisfies both availability consequences are charged. -/
def f0TruncatedGainCollisionResidualRepresentationWeight
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) : TestWeight V :=
  fun U ↦
    ∑ S ∈ H.powersetCard j,
    ∑ e ∈ S,
    ∑ f ∈ S.erase e,
    ∑ c ∈ C,
      if U ⊆ H ∧ e ∈ c ∧ f ∈ c ∧
          (S ∪ c).card = r ∧
          gainCollisionResidualUnion S c e f = U ∧
          IsF0TruncatedGainCollisionResidual H C f₀
            (gainCollisionResidualConflict c e f)
      then w S else 0

theorem f0TruncatedGainCollisionResidualRepresentationWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (C : ConflictSystem V) (f₀ : Finset V)
    (j r : ℕ) (U : Hypergraph V) :
    0 ≤ f0TruncatedGainCollisionResidualRepresentationWeight
      w H C f₀ j r U := by
  unfold f0TruncatedGainCollisionResidualRepresentationWeight
  apply Finset.sum_nonneg
  intro S hS
  apply Finset.sum_nonneg
  intro e he
  apply Finset.sum_nonneg
  intro f hf
  apply Finset.sum_nonneg
  intro c hc
  split
  · exact hw S
  · norm_num

def weightedF0TruncatedGainCollisionResidualRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) (root : Hypergraph V) : ℝ :=
  weightedCodegree
    (gainCollisionResidualLayer H C j r)
    (f0TruncatedGainCollisionResidualRepresentationWeight
      w H C f₀ j r) root

def weightedF0TruncatedGainCollisionResidualPartialMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ)
    (A M : Hypergraph V) (t : ℕ) : ℝ :=
  weightedPartialFamilyMass
    (gainCollisionResidualLayer H C j r)
    (f0TruncatedGainCollisionResidualRepresentationWeight
      w H C f₀ j r) A M t

/-- Exact representation expansion of the truncated partial mass. -/
theorem weightedF0TruncatedGainCollisionResidualPartialMass_eq_representationSum
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ)
    (A M : Hypergraph V) (t : ℕ) :
    weightedF0TruncatedGainCollisionResidualPartialMass
        w H C f₀ j r A M t =
      ∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C,
        if e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            IsF0TruncatedGainCollisionResidual H C f₀
              (gainCollisionResidualConflict c e f) ∧
            gainCollisionResidualUnion S c e f ∈
              partialFamily (gainCollisionResidualLayer H C j r) A M t
        then w S else 0 := by
  unfold weightedF0TruncatedGainCollisionResidualPartialMass
    weightedPartialFamilyMass
    f0TruncatedGainCollisionResidualRepresentationWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e heS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f hfS
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro c hcC
  let U₀ := gainCollisionResidualUnion S c e f
  let htrunc := IsF0TruncatedGainCollisionResidual H C f₀
    (gainCollisionResidualConflict c e f)
  by_cases hrep : e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r
  · by_cases ht : htrunc
    · by_cases hpartial : U₀ ∈
          partialFamily (gainCollisionResidualLayer H C j r) A M t
      · have hsupport : U₀ ⊆ H :=
          (mem_gainCollisionResidualLayer.mp
            (mem_partialFamily.mp hpartial).1).1
        rw [if_pos ⟨hrep.1, hrep.2.1, hrep.2.2, ht, hpartial⟩]
        rw [Finset.sum_eq_single U₀]
        · simp [U₀, htrunc, hsupport, hrep, ht]
        · intro U hU hUne
          simp [U₀, htrunc, hsupport, hrep, ht, hUne.symm]
        · exact fun hnot ↦ (hnot hpartial).elim
      · rw [if_neg (fun h ↦ hpartial h.2.2.2.2)]
        apply Finset.sum_eq_zero
        intro U hU
        rw [if_neg]
        intro h
        apply hpartial
        change gainCollisionResidualUnion S c e f ∈
          partialFamily (gainCollisionResidualLayer H C j r) A M t
        rw [h.2.2.2.2.1]
        exact hU
    · rw [if_neg (fun h ↦ ht h.2.2.2.1)]
      apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      exact ht h.2.2.2.2.2
  · rw [if_neg]
    · apply Finset.sum_eq_zero
      intro U hU
      rw [if_neg]
      intro h
      exact hrep ⟨h.2.1, h.2.2.1, h.2.2.2.1⟩
    · intro h
      exact hrep ⟨h.1, h.2.1, h.2.2.1⟩

/-- The conflict residual contains none of the two erased choices. -/
theorem gainCollisionResidualConflict_subset_selected
    {M c : Hypergraph V} {e f : Finset V}
    (hcsub : c ⊆ insert f (insert e M)) :
    gainCollisionResidualConflict c e f ⊆ M := by
  intro g hgR
  have hgOuter := Finset.mem_erase.mp hgR
  have hgInner := Finset.mem_erase.mp hgOuter.2
  rcases Finset.mem_insert.mp (hcsub hgInner.2) with hgf | hrest
  · exact False.elim (hgOuter.1 hgf)
  · rcases Finset.mem_insert.mp hrest with hge | hgM
    · exact False.elim (hgInner.1 hge)
    · exact hgM

/-- Availability of `f₀` proves both truncation clauses for every
certificate conflict lying in `insert f (insert e M)`. -/
theorem isF0TruncatedGainCollisionResidual_of_available
    {H : Hypergraph V} {C : ConflictSystem V}
    {M c : Hypergraph V} {e f f₀ : Finset V}
    (hf₀A : f₀ ∈ availableEdges H C M)
    (hcsub : c ⊆ insert f (insert e M)) :
    IsF0TruncatedGainCollisionResidual H C f₀
      (gainCollisionResidualConflict c e f) := by
  have hRsubM : gainCollisionResidualConflict c e f ⊆ M :=
    gainCollisionResidualConflict_subset_selected hcsub
  have hf₀M : f₀ ∉ M := (mem_availableEdges.mp hf₀A).2.1
  have hmatching : IsMatching H (insert f₀ M) :=
    (mem_availableEdges.mp hf₀A).2.2.1
  have hfree : ConflictFree C (insert f₀ M) :=
    (mem_availableEdges.mp hf₀A).2.2.2
  have hmatchData := isMatching_insert_iff.mp hmatching
  refine ⟨?_, ?_⟩
  · intro g hgR
    have hgM := hRsubM hgR
    exact hmatchData.2.2 g hgM (fun hgf₀ ↦ hf₀M (hgf₀ ▸ hgM))
  · rw [Finset.disjoint_left]
    intro g hgR hgNeighbor
    have hgM := hRsubM hgR
    have hneighbor := Finset.mem_filter.mp hgNeighbor
    have hpairLayer := hneighbor.2.2
    have hpairC : ({f₀, g} : Hypergraph V) ∈ C :=
      (mem_conflictLayer.mp hpairLayer).1
    apply hfree {f₀, g} hpairC
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact Finset.mem_insert_self _ M
    · exact Finset.mem_insert_of_mem hgM

/-- A dynamically generated residual representation therefore satisfies
the static internal filter. -/
theorem gainCollisionResidualUnion_mem_partial_and_f0Truncated
    {H : Hypergraph V} {C : ConflictSystem V}
    {M S c : Hypergraph V} {e f f₀ : Finset V} {j s : ℕ}
    (hS : S ∈ H.powersetCard j)
    (hcoord : partialTestCondition (availableEdges H C M) M j (s + 1) S)
    (heS : e ∈ S) (hfS : f ∈ S)
    (heA : e ∈ availableEdges H C M)
    (hfA : f ∈ availableEdges H C M)
    (hf₀A : f₀ ∈ availableEdges H C M)
    (hef : e ≠ f) (hcC : c ∈ C)
    (hec : e ∈ c) (hfc : f ∈ c)
    (hcsub : c ⊆ insert f (insert e M))
    (hMH : M ⊆ H) :
    1 ≤ s ∧
      gainCollisionResidualUnion S c e f ∈
        partialFamily
          (gainCollisionResidualLayer H C j (S ∪ c).card)
          (availableEdges H C M) M (s - 1) ∧
      IsF0TruncatedGainCollisionResidual H C f₀
        (gainCollisionResidualConflict c e f) := by
  have hpartial := gainCollisionResidualUnion_mem_partial
    hS hcoord heS hfS heA hfA hef hcC hec hfc hcsub hMH
  exact ⟨hpartial.1, hpartial.2,
    isF0TruncatedGainCollisionResidual_of_available hf₀A hcsub⟩

/-- A member of a truncated conflict residual is disjoint from `f₀` and
cannot form a two-conflict with it.  These are exactly the two hypotheses
needed by the certificate common-link estimate. -/
theorem f0Truncated_member_commonLinks_conditions
    {H : Hypergraph V} {C : ConflictSystem V}
    {f₀ g : Finset V} {R : Hypergraph V}
    (htrunc : IsF0TruncatedGainCollisionResidual H C f₀ R)
    (hgH : g ∈ H) (hgR : g ∈ R) :
    Disjoint f₀ g ∧ {f₀, g} ∉ conflictLayer C 2 := by
  refine ⟨htrunc.1 g hgR, ?_⟩
  intro hpair
  have hne : g ≠ f₀ := by
    intro hgf₀
    subst g
    have hcard := (mem_conflictLayer.mp hpair).2
    simpa using hcard
  have hgNeighbor :
      g ∈ CFMRegularization.twoConflictNeighbors H C f₀ := by
    exact Finset.mem_filter.mpr ⟨hgH, hne, hpair⟩
  exact Finset.disjoint_left.mp htrunc.2 hgR hgNeighbor

/-- In the full/empty-source boundary geometry, a singleton requested root
is a member of the residual conflict part.  Hence every contributing
truncated representation supplies the two certificate common-link
hypotheses for that singleton. -/
theorem fullEmptySource_singleton_commonLinks_conditions_of_f0Truncated
    {H : Hypergraph V} {C : ConflictSystem V}
    {S c root : Hypergraph V} {e f f₀ : Finset V}
    (hrootCard : root.card = 1)
    (hsupport : gainCollisionResidualUnion S c e f ⊆ H)
    (heS : e ∈ S) (hfS : f ∈ S) (hef : e ≠ f)
    (hec : e ∈ c) (hfc : f ∈ c)
    (hroot : root ⊆ gainCollisionResidualUnion S c e f)
    (hfull : gainCollisionResidualConflict c e f \
      gainCollisionResidualSource S e f ⊆ root)
    (hempty : Disjoint root (gainCollisionResidualSource S e f))
    (htrunc : IsF0TruncatedGainCollisionResidual H C f₀
      (gainCollisionResidualConflict c e f)) :
    ∃ g, root = {g} ∧ Disjoint f₀ g ∧
      {f₀, g} ∉ conflictLayer C 2 := by
  obtain ⟨g, hrootEq⟩ := Finset.card_eq_one.mp hrootCard
  have hgeom := full_emptySourceRoot_geometry
    hsupport heS hfS hef hec hfc hroot hfull hempty
  have hgCS : g ∈ c \ S := by
    rw [← hgeom.1, hrootEq]
    exact Finset.mem_singleton_self g
  have hgCS' := Finset.mem_sdiff.mp hgCS
  have hge : g ≠ e := by
    intro hge
    exact hgCS'.2 (hge ▸ heS)
  have hgf : g ≠ f := by
    intro hgf
    exact hgCS'.2 (hgf ▸ hfS)
  have hgR : g ∈ gainCollisionResidualConflict c e f := by
    simp only [gainCollisionResidualConflict, Finset.mem_erase]
    exact ⟨hgf, hge, hgCS'.1⟩
  have hgH : g ∈ H := by
    exact hgeom.2.1 (by rw [hrootEq]; exact Finset.mem_singleton_self g)
  have hconditions := f0Truncated_member_commonLinks_conditions
    htrunc hgH hgR
  exact ⟨g, hrootEq, hconditions⟩

/-- The internal boundary submass for which the re-rooted source has its
full test cardinality.  Proper source roots are handled by the separate
proper-extension package. -/
def weightedF0TruncatedGainCollisionResidualFullCardRootMass
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (f₀ : Finset V) (j r : ℕ) (root : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
  ∑ e ∈ S,
  ∑ f ∈ S.erase e,
  ∑ c ∈ C,
    if gainCollisionResidualUnion S c e f ⊆ H ∧
        e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
        root ⊆ gainCollisionResidualUnion S c e f ∧
        gainCollisionResidualConflict c e f \
            gainCollisionResidualSource S e f ⊆ root ∧
        Disjoint root (gainCollisionResidualSource S e f) ∧
        IsF0TruncatedGainCollisionResidual H C f₀
          (gainCollisionResidualConflict c e f) ∧
        (c \ root).card = j
    then w S else 0

theorem f0TruncatedFullCard_pairSum_le_twelve_extension
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {C : ConflictSystem V} {f₀ : Finset V}
    {j r : ℕ} (hj3 : j ≤ 3)
    (root S c : Hypergraph V) (hS : S ∈ H.powersetCard j) :
    (∑ e ∈ S,
      ∑ f ∈ S.erase e,
        if gainCollisionResidualUnion S c e f ⊆ H ∧
            e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
            root ⊆ gainCollisionResidualUnion S c e f ∧
            gainCollisionResidualConflict c e f \
                gainCollisionResidualSource S e f ⊆ root ∧
            Disjoint root (gainCollisionResidualSource S e f) ∧
            IsF0TruncatedGainCollisionResidual H C f₀
              (gainCollisionResidualConflict c e f) ∧
            (c \ root).card = j
        then w S else 0) ≤
      if root ⊆ c ∧ c \ root ⊆ S ∧ (c \ root).card = j
      then 12 * w S else 0 := by
  by_cases hcover : root ⊆ c ∧ c \ root ⊆ S ∧
      (c \ root).card = j
  · rw [if_pos hcover]
    calc
      (∑ e ∈ S,
        ∑ f ∈ S.erase e,
          if gainCollisionResidualUnion S c e f ⊆ H ∧
              e ∈ c ∧ f ∈ c ∧ (S ∪ c).card = r ∧
              root ⊆ gainCollisionResidualUnion S c e f ∧
              gainCollisionResidualConflict c e f \
                  gainCollisionResidualSource S e f ⊆ root ∧
              Disjoint root (gainCollisionResidualSource S e f) ∧
              IsF0TruncatedGainCollisionResidual H C f₀
                (gainCollisionResidualConflict c e f) ∧
              (c \ root).card = j
          then w S else 0) ≤
          ∑ e ∈ S, ∑ _f ∈ S.erase e, w S := by
        apply Finset.sum_le_sum
        intro e heS
        apply Finset.sum_le_sum
        intro f hfS
        split
        · exact le_rfl
        · exact hw0 S
      _ ≤ 12 * w S := by
        have hScard : S.card = j :=
          (Finset.mem_powersetCard.mp hS).2
        have hpairs : ∀ e ∈ S, (S.erase e).card ≤ 3 := by
          intro e he
          rw [Finset.card_erase_of_mem he, hScard]
          omega
        calc
          (∑ e ∈ S, ∑ _f ∈ S.erase e, w S) =
              ∑ e ∈ S, ((S.erase e).card : ℝ) * w S := by simp
          _ ≤ ∑ _e ∈ S, 3 * w S := by
            apply Finset.sum_le_sum
            intro e he
            exact mul_le_mul_of_nonneg_right
              (by exact_mod_cast hpairs e he) (hw0 S)
          _ = (S.card : ℝ) * (3 * w S) := by simp
          _ ≤ 12 * w S := by
            have hcard3 : (S.card : ℝ) ≤ 3 := by
              rw [hScard]
              exact_mod_cast hj3
            nlinarith [hw0 S]
  · rw [if_neg hcover]
    apply le_of_eq
    apply Finset.sum_eq_zero
    intro e heS
    apply Finset.sum_eq_zero
    intro f hfS
    rw [if_neg]
    intro hrep
    have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
    have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
    have hgeom := full_emptySourceRoot_geometry
      hrep.1 heS hfS' (Ne.symm hfe) hrep.2.1 hrep.2.2.1
      hrep.2.2.2.2.1 hrep.2.2.2.2.2.1
      hrep.2.2.2.2.2.2.1
    exact hcover ⟨by rw [hgeom.1]; exact Finset.sdiff_subset,
      hgeom.2.2.1, hrep.2.2.2.2.2.2.2.2⟩

/-- Fubini reduction of the truncated full-card boundary.  The source pair
disappears, leaving precisely the certificate-local extension charge. -/
theorem weightedF0TruncatedGainCollisionResidualFullCardRootMass_le_extensionSum
    {w : TestWeight V} (hw0 : ∀ S, 0 ≤ w S)
    {H : Hypergraph V} {C : ConflictSystem V} {f₀ : Finset V}
    {j r : ℕ} (hj3 : j ≤ 3) (root : Hypergraph V) :
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
        w H C f₀ j r root ≤
      12 * ∑ c ∈ C.filter
          (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
        testExtension w H j (c \ root) := by
  unfold weightedF0TruncatedGainCollisionResidualFullCardRootMass
  calc
    (∑ S ∈ H.powersetCard j,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e,
      ∑ c ∈ C, _) =
      ∑ S ∈ H.powersetCard j,
      ∑ c ∈ C,
      ∑ e ∈ S,
      ∑ f ∈ S.erase e, _ := by
        apply Finset.sum_congr rfl
        intro S hS
        calc
          (∑ e ∈ S, ∑ f ∈ S.erase e, ∑ c ∈ C, _) =
              ∑ e ∈ S, ∑ c ∈ C, ∑ f ∈ S.erase e, _ := by
                apply Finset.sum_congr rfl
                intro e he
                rw [Finset.sum_comm]
          _ = ∑ c ∈ C, ∑ e ∈ S, ∑ f ∈ S.erase e, _ := by
                rw [Finset.sum_comm]
    _ ≤ ∑ S ∈ H.powersetCard j,
        ∑ c ∈ C,
          if root ⊆ c ∧ c \ root ⊆ S ∧ (c \ root).card = j
          then 12 * w S else 0 := by
      apply Finset.sum_le_sum
      intro S hS
      apply Finset.sum_le_sum
      intro c hc
      exact f0TruncatedFullCard_pairSum_le_twelve_extension
        hw0 hj3 root S c hS
    _ = ∑ c ∈ C,
        if root ⊆ c ∧ (c \ root).card = j then
          12 * testExtension w H j (c \ root) else 0 := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro c hc
      by_cases hrootc : root ⊆ c ∧ (c \ root).card = j
      · rw [if_pos hrootc]
        simp only [hrootc.1, hrootc.2, true_and, and_true, if_pos]
        unfold testExtension
        rw [Finset.mul_sum, ← Finset.sum_filter]
      · rw [if_neg hrootc]
        apply Finset.sum_eq_zero
        intro S hS
        rw [if_neg]
        intro h
        exact hrootc ⟨h.1, h.2.2⟩
    _ = ∑ c ∈ C.filter
          (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
        12 * testExtension w H j (c \ root) := by
      rw [← Finset.sum_filter]
    _ = 12 * ∑ c ∈ C.filter
          (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
        testExtension w H j (c \ root) := by
      rw [Finset.mul_sum]

/-- Certificate wrapper for the ordinary singleton full-root branch after
the static truncation has supplied both exceptional-pair exclusions. -/
theorem RegularizationCertificate.commonLinks_natRank_of_f0Truncated
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    {f₀ g : Finset V} {R : Hypergraph V}
    (hf₀H : f₀ ∈ H) (hgH : g ∈ H)
    (htrunc : IsF0TruncatedGainCollisionResidual
      H Rcert.regularized f₀ R)
    (hgR : g ∈ R)
    (a : ℕ) (ha : a ∈ Finset.Icc 1 3) :
    (((conflictLinkLayer Rcert.regularized f₀ a) ∩
      conflictLinkLayer Rcert.regularized g a).card : ℝ) ≤
        Real.rpow d ((a : ℝ) - eps / 4) := by
  have hconditions := f0Truncated_member_commonLinks_conditions
    htrunc hgH hgR
  exact Erdos136.RegularizationCertificate.commonLinks_natRank
    Rcert hf₀H hgH hconditions.1 hconditions.2 a ha

/-- The explicit floor built into every certificate internal layer scale. -/
theorem certificateInternalLayerScale_floor_le
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 0 ≤ d) (rank : ℕ) :
    Real.rpow d ((rank : ℝ) - 1 - eps / 600) ≤
      certificateInternalLayerScale
        H C d eps Gamma ell testJ testW Rcert rank := by
  unfold certificateInternalLayerScale CFMRegularization.completionTarget
  let p := Real.rpow d ((rank : ℝ) - 1 - eps / 600)
  let x := Real.rpow d (-eps / 4)
  let m := max p
    (CFMRegularization.layerMaxDegree H
      (CFMRegularization.minimalMatchingCore H (C ∪ Rcert.badPairs)) rank : ℝ)
  have hp0 : 0 ≤ p := Real.rpow_nonneg hd _
  have hx0 : 0 ≤ x := Real.rpow_nonneg hd _
  have hpm : p ≤ m := le_max_left _ _
  have hm0 : 0 ≤ m := hp0.trans hpm
  change p ≤ (1 + x) * m
  nlinarith [mul_nonneg hx0 hm0]

/-- The common-link/C3 saving `eps/4`, together with the scale floor at
`eps/600`, absorbs the requested relative `eps/10` loss. -/
theorem twelve_rpow_quarter_le_certificateScale_mul_rpow_tenth
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 12 ≤ Real.rpow d (eps / 10))
    (j : ℕ) :
    12 * Real.rpow d ((j : ℝ) - eps / 4) ≤
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (-eps / 10) := by
  have hdpos : 0 < d := by linarith
  have hfloorRaw := certificateInternalLayerScale_floor_le
    Rcert (by linarith : 0 ≤ d) (j + 1)
  have hfloor : Real.rpow d ((j : ℝ) - eps / 600) ≤
      certificateInternalLayerScale
        H C d eps Gamma ell testJ testW Rcert (j + 1) := by
    convert hfloorRaw using 1 <;> push_cast <;> ring_nf
  have hquarter0 : 0 ≤ Real.rpow d ((j : ℝ) - eps / 4) :=
    Real.rpow_nonneg (by linarith : 0 ≤ d) _
  have htenth0 : 0 ≤ Real.rpow d (-eps / 10) :=
    Real.rpow_nonneg (by linarith : 0 ≤ d) _
  calc
    12 * Real.rpow d ((j : ℝ) - eps / 4) ≤
        Real.rpow d (eps / 10) *
          Real.rpow d ((j : ℝ) - eps / 4) :=
      mul_le_mul_of_nonneg_right hcutoff hquarter0
    _ = Real.rpow d ((j : ℝ) - 3 * eps / 20) := by
      calc
        Real.rpow d (eps / 10) * Real.rpow d ((j : ℝ) - eps / 4) =
            Real.rpow d (eps / 10 + ((j : ℝ) - eps / 4)) :=
          (Real.rpow_add hdpos _ _).symm
        _ = Real.rpow d ((j : ℝ) - 3 * eps / 20) := by
          congr 1
          ring
    _ ≤ Real.rpow d ((j : ℝ) - 61 * eps / 600) := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      linarith
    _ = Real.rpow d ((j : ℝ) - eps / 600) *
          Real.rpow d (-eps / 10) := by
      calc
        Real.rpow d ((j : ℝ) - 61 * eps / 600) =
            Real.rpow d (((j : ℝ) - eps / 600) + (-eps / 10)) := by
          congr 1
          ring
        _ = Real.rpow d ((j : ℝ) - eps / 600) *
            Real.rpow d (-eps / 10) := Real.rpow_add hdpos _ _
    _ ≤ certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (-eps / 10) :=
      mul_le_mul_of_nonneg_right hfloor htenth0

/-- An extension of the unweighted certificate link test is exactly the
corresponding link-layer codegree. -/
theorem testExtension_conflictLinkTestWeight_eq_codegree
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C) (f₀ : Finset V) (j : ℕ)
    (root : Hypergraph V) :
    testExtension (conflictLinkTestWeight C f₀ j) H j root =
      (codegree (conflictLinkLayer C f₀ j) root : ℝ) := by
  unfold testExtension conflictLinkTestWeight
  calc
    (∑ Q ∈ (H.powersetCard j).filter (root ⊆ ·),
        if Q ∈ conflictLinkLayer C f₀ j then 1 else 0) =
      ∑ _Q ∈ ((H.powersetCard j).filter (root ⊆ ·)).filter
          (· ∈ conflictLinkLayer C f₀ j), (1 : ℝ) := by
        rw [← Finset.sum_filter]
    _ = ((((H.powersetCard j).filter (root ⊆ ·)).filter
          (· ∈ conflictLinkLayer C f₀ j)).card : ℝ) := by
        simp
    _ = (codegree (conflictLinkLayer C f₀ j) root : ℝ) := by
      congr 1
      unfold codegree
      congr 1
      ext Q
      simp only [Finset.mem_filter, Finset.mem_powersetCard]
      constructor
      · rintro ⟨⟨⟨hQH, hQcard⟩, hrootQ⟩, hQlink⟩
        exact ⟨hQlink, hrootQ⟩
      · rintro ⟨hQlink, hrootQ⟩
        obtain ⟨⟨c, hcC, hf₀c, hcErase⟩, hQcard⟩ :=
          mem_conflictLinkLayer.mp hQlink
        have hQH : Q ⊆ H := by
          rw [← hcErase]
          exact (Finset.erase_subset f₀ c).trans (hC c hcC)
        exact ⟨⟨⟨hQH, hQcard⟩, hrootQ⟩, hQlink⟩

/-- Proper nonempty roots of the internal link test receive C3's saving,
which is stronger than the requested relative `eps/5` bound against the
certificate scale floor. -/
theorem RegularizationCertificate.internalLinkTestExtension_proper_le_scale
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (f₀ : Finset V) (j : ℕ) (hj1 : 1 ≤ j) (hj3 : j ≤ 3)
    (root : Hypergraph V)
    (hroot1 : 1 ≤ root.card) (hrootj : root.card < j) :
    testExtension
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H j root ≤
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (-((root.card : ℝ) + eps / 5)) := by
  have hdpos : 0 < d := by linarith
  rw [testExtension_conflictLinkTestWeight_eq_codegree
    Rcert.isConflictSystem]
  have hcode := common_codegree_conflictLinkLayer_le_rpow
    Rcert.bounded hdpos f₀ j root hj1 hj3 hroot1 hrootj
  have hfloorRaw := certificateInternalLayerScale_floor_le
    Rcert (by linarith : 0 ≤ d) (j + 1)
  have hfloor : Real.rpow d ((j : ℝ) - eps / 600) ≤
      certificateInternalLayerScale
        H C d eps Gamma ell testJ testW Rcert (j + 1) := by
    convert hfloorRaw using 1 <;> push_cast <;> ring_nf
  have htail0 : 0 ≤
      Real.rpow d (-((root.card : ℝ) + eps / 5)) :=
    Real.rpow_nonneg (by linarith : 0 ≤ d) _
  calc
    (codegree (conflictLinkLayer Rcert.regularized f₀ j) root : ℝ) ≤
        Real.rpow d
          ((j : ℝ) - (root.card : ℝ) - eps / 4) := hcode
    _ ≤ Real.rpow d
          ((j : ℝ) - (root.card : ℝ) - 121 * eps / 600) := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      linarith
    _ = Real.rpow d ((j : ℝ) - eps / 600) *
          Real.rpow d (-((root.card : ℝ) + eps / 5)) := by
      calc
        Real.rpow d
            ((j : ℝ) - (root.card : ℝ) - 121 * eps / 600) =
            Real.rpow d (((j : ℝ) - eps / 600) +
              (-((root.card : ℝ) + eps / 5))) := by
          congr 1
          ring
        _ = Real.rpow d ((j : ℝ) - eps / 600) *
              Real.rpow d (-((root.card : ℝ) + eps / 5)) :=
          Real.rpow_add hdpos _ _
    _ ≤ certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (-((root.card : ℝ) + eps / 5)) :=
      mul_le_mul_of_nonneg_right hfloor htail0

/-- The total mass of an internal link test is at most twice its literal
certificate center. -/
theorem RegularizationCertificate.internalLinkTestTotal_le_two_scale
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (f₀ : Finset V) (hf₀H : f₀ ∈ H)
    (j : ℕ) (hj1 : 1 ≤ j) (hj3 : j ≤ 3) :
    testTotal (conflictLinkTestWeight Rcert.regularized f₀ j) H j ≤
      2 * certificateInternalLayerScale
        H C d eps Gamma ell testJ testW Rcert (j + 1) := by
  have htotalEq := testExtension_conflictLinkTestWeight_eq_codegree
    Rcert.isConflictSystem f₀ j (∅ : Hypergraph V)
  rw [testExtension_empty_root, codegree_empty] at htotalEq
  rw [htotalEq]
  have hinterval := certificateInternalLink_initial_interval
    H C d eps Gamma ell testJ testW Rcert f₀ hf₀H j hj1 hj3
  have herr : Real.rpow d (-eps) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos hd (by linarith)
  have hscale0 := (certificateInternalLayerScale_pos
    H C d eps Gamma ell testJ testW Rcert (j + 1) (by linarith)).le
  calc
    ((conflictLinkLayer Rcert.regularized f₀ j).card : ℝ) ≤
        (1 + Real.rpow d (-eps)) *
          certificateInternalLayerScale
            H C d eps Gamma ell testJ testW Rcert (j + 1) := hinterval.2
    _ ≤ 2 * certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) := by
      exact mul_le_mul_of_nonneg_right (by linarith) hscale0

/-- Antichainness gives the W4-style support property for the certificate
link test: a positive link cannot itself contain a regularized conflict. -/
theorem RegularizationCertificate.conflictLinkTestWeight_eq_zero_of_contains_conflict
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (f₀ : Finset V) (j : ℕ) (S : Hypergraph V)
    (hcontains : ∃ c' ∈ Rcert.regularized, c' ⊆ S) :
    conflictLinkTestWeight Rcert.regularized f₀ j S = 0 := by
  obtain ⟨c', hc'C, hc'S⟩ := hcontains
  by_cases hSlink : S ∈ conflictLinkLayer Rcert.regularized f₀ j
  · obtain ⟨⟨c, hcC, hf₀c, hcErase⟩, _hScard⟩ :=
      mem_conflictLinkLayer.mp hSlink
    have hf₀S : f₀ ∉ S := by
      rw [← hcErase]
      simp
    have hne : c' ≠ c := by
      intro heq
      apply hf₀S
      exact hc'S (heq ▸ hf₀c)
    exact False.elim
      (Rcert.antichain c' hc'C c hcC hne
        (hc'S.trans (by rw [← hcErase]; exact Finset.erase_subset f₀ c)))
  · simp [conflictLinkTestWeight, hSlink]

theorem conflictLinkTestWeight_le_one
    (C : ConflictSystem V) (f₀ : Finset V) (j : ℕ)
    (S : Hypergraph V) :
    conflictLinkTestWeight C f₀ j S ≤ 1 := by
  by_cases hS : S ∈ conflictLinkLayer C f₀ j <;>
    simp [conflictLinkTestWeight, hS]

/-- Complete proper-source package for the internal certificate link test.
The factor two only records the upper side of the certificate's relative
degree interval. -/
theorem RegularizationCertificate.internalLink_hasGainCollisionResidualProperSourceBounds
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (f₀ : Finset V) (hf₀H : f₀ ∈ H)
    (j : ℕ) (hj1 : 1 ≤ j) (hj3 : j ≤ 3) :
    HasGainCollisionResidualProperSourceBounds
      (conflictLinkTestWeight Rcert.regularized f₀ j)
      H Rcert.regularized j d (eps / 5)
      (2 * certificateInternalLayerScale
        H C d eps Gamma ell testJ testW Rcert (j + 1)) 1 1 := by
  let scale := certificateInternalLayerScale
    H C d eps Gamma ell testJ testW Rcert (j + 1)
  have hscale0 : 0 ≤ scale :=
    (certificateInternalLayerScale_pos
      H C d eps Gamma ell testJ testW Rcert (j + 1)
        (by linarith)).le
  refine ⟨conflictLinkTestWeight_nonneg_sharp
      Rcert.regularized f₀ j,
    ?_, ?_, ?_, ?_⟩
  · simpa only [scale] using
      Erdos136.RegularizationCertificate.internalLinkTestTotal_le_two_scale
        Rcert hd heps f₀ hf₀H j hj1 hj3
  · intro S hS hpos c hcC hcS
    have hz :=
      Erdos136.RegularizationCertificate.conflictLinkTestWeight_eq_zero_of_contains_conflict
        Rcert f₀ j S ⟨c, hcC, hcS⟩
    linarith
  · intro root hrootH hroot1 hrootj
    have hproper :=
      Erdos136.RegularizationCertificate.internalLinkTestExtension_proper_le_scale
        Rcert hd heps f₀ j hj1 hj3 root hroot1 hrootj
    have htail0 : 0 ≤
        (Real.rpow d ((root.card : ℝ) + eps / 5))⁻¹ :=
      inv_nonneg.mpr (Real.rpow_nonneg (by linarith : 0 ≤ d) _)
    have hscaleTwo : scale ≤ 2 * scale := by linarith
    apply hproper.trans
    change scale * (Real.rpow d
        (-((root.card : ℝ) + eps / 5))) ≤
      1 * (2 * scale) /
        Real.rpow d ((root.card : ℝ) + eps / 5)
    calc
      scale * Real.rpow d (-((root.card : ℝ) + eps / 5)) =
          scale * (Real.rpow d
            ((root.card : ℝ) + eps / 5))⁻¹ := by
        congr 1
        exact Real.rpow_neg (by linarith : 0 ≤ d) _
      _ ≤ (2 * scale) *
          (Real.rpow d ((root.card : ℝ) + eps / 5))⁻¹ :=
        mul_le_mul_of_nonneg_right hscaleTwo htail0
      _ = 1 * (2 * scale) /
          Real.rpow d ((root.card : ℝ) + eps / 5) := by
        rw [one_mul]
        exact (div_eq_mul_inv _ _).symm
  · intro S
    exact conflictLinkTestWeight_le_one Rcert.regularized f₀ j S

/-- At a singleton root, the full-card internal extension charge injects
into the common `j`-link of `f₀` and the root edge.  This is the exact
Fubini endpoint needed after the ordered source pair has been summed out. -/
theorem sum_conflictLinkTestExtensions_singleton_le_commonLinksCard
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C)
    {f₀ g : Finset V} (j : ℕ) :
    (∑ c ∈ C.filter (fun c ↦
        ({g} : Hypergraph V) ⊆ c ∧ (c \ ({g} : Hypergraph V)).card = j),
      testExtension (conflictLinkTestWeight C f₀ j)
        H j (c \ ({g} : Hypergraph V))) ≤
      (((conflictLinkLayer C f₀ j) ∩
        conflictLinkLayer C g j).card : ℝ) := by
  let F := C.filter (fun c ↦
    ({g} : Hypergraph V) ⊆ c ∧ (c \ ({g} : Hypergraph V)).card = j)
  let X := F.filter (fun c ↦
    c \ ({g} : Hypergraph V) ∈ conflictLinkLayer C f₀ j)
  have hext : ∀ c ∈ F,
      testExtension (conflictLinkTestWeight C f₀ j)
          H j (c \ ({g} : Hypergraph V)) =
        if c \ ({g} : Hypergraph V) ∈ conflictLinkLayer C f₀ j
        then 1 else 0 := by
    intro c hcF
    have hc := Finset.mem_filter.mp (by simpa only [F] using hcF)
    have hDH : c \ ({g} : Hypergraph V) ⊆ H :=
      Finset.sdiff_subset.trans (hC c hc.1)
    have hfilter :
        (H.powersetCard j).filter
            (c \ ({g} : Hypergraph V) ⊆ ·) =
          {c \ ({g} : Hypergraph V)} := by
      ext Q
      simp only [Finset.mem_filter, Finset.mem_powersetCard,
        Finset.mem_singleton]
      constructor
      · rintro ⟨⟨hQH, hQcard⟩, hsub⟩
        exact (Finset.eq_of_subset_of_card_le hsub
          (by rw [hc.2.2, hQcard])).symm
      · rintro rfl
        exact ⟨⟨hDH, hc.2.2⟩, Finset.Subset.rfl⟩
    unfold testExtension
    rw [hfilter]
    by_cases hlink : c \ ({g} : Hypergraph V) ∈
        conflictLinkLayer C f₀ j <;>
      simp [conflictLinkTestWeight, hlink]
  have hcard : X.card ≤
      ((conflictLinkLayer C f₀ j) ∩
        conflictLinkLayer C g j).card := by
    apply Finset.card_le_card_of_injOn
      (fun c ↦ c \ ({g} : Hypergraph V))
    · intro c hcX
      change c ∈ X at hcX
      have hcX' := Finset.mem_filter.mp hcX
      have hcF := Finset.mem_filter.mp
        (by simpa only [F] using hcX'.1)
      have hgc : g ∈ c := hcF.2.1 (Finset.mem_singleton_self g)
      have herase : c.erase g = c \ ({g} : Hypergraph V) := by
        ext x
        simp only [Finset.mem_erase, Finset.mem_sdiff,
          Finset.mem_singleton]
        exact and_comm
      apply Finset.mem_inter.mpr
      refine ⟨hcX'.2, mem_conflictLinkLayer.mpr ⟨?_, hcF.2.2⟩⟩
      exact ⟨c, hcF.1, hgc, herase⟩
    · intro c₁ hc₁ c₂ hc₂ heq
      change c₁ ∈ X at hc₁
      change c₂ ∈ X at hc₂
      have hc₁X := Finset.mem_filter.mp hc₁
      have hc₂X := Finset.mem_filter.mp hc₂
      have hc₁F := Finset.mem_filter.mp
        (by simpa only [F] using hc₁X.1)
      have hc₂F := Finset.mem_filter.mp
        (by simpa only [F] using hc₂X.1)
      have hg₁ : g ∈ c₁ := hc₁F.2.1 (Finset.mem_singleton_self g)
      have hg₂ : g ∈ c₂ := hc₂F.2.1 (Finset.mem_singleton_self g)
      have herase₁ : c₁.erase g = c₁ \ ({g} : Hypergraph V) := by
        ext x
        simp only [Finset.mem_erase, Finset.mem_sdiff,
          Finset.mem_singleton]
        exact and_comm
      have herase₂ : c₂.erase g = c₂ \ ({g} : Hypergraph V) := by
        ext x
        simp only [Finset.mem_erase, Finset.mem_sdiff,
          Finset.mem_singleton]
        exact and_comm
      change c₁ \ ({g} : Hypergraph V) =
        c₂ \ ({g} : Hypergraph V) at heq
      calc
        c₁ = insert g (c₁.erase g) := (Finset.insert_erase hg₁).symm
        _ = insert g (c₁ \ ({g} : Hypergraph V)) := by rw [herase₁]
        _ = insert g (c₂ \ ({g} : Hypergraph V)) := by rw [heq]
        _ = insert g (c₂.erase g) := by rw [herase₂]
        _ = c₂ := Finset.insert_erase hg₂
  calc
    (∑ c ∈ C.filter (fun c ↦
        ({g} : Hypergraph V) ⊆ c ∧ (c \ ({g} : Hypergraph V)).card = j),
      testExtension (conflictLinkTestWeight C f₀ j)
        H j (c \ ({g} : Hypergraph V))) =
        ∑ c ∈ F,
          if c \ ({g} : Hypergraph V) ∈ conflictLinkLayer C f₀ j
          then 1 else 0 := by
            apply Finset.sum_congr rfl
            intro c hc
            exact hext c hc
    _ = ∑ _c ∈ X, (1 : ℝ) := by
      rw [show X = F.filter (fun c ↦
          c \ ({g} : Hypergraph V) ∈ conflictLinkLayer C f₀ j) from rfl]
      rw [← Finset.sum_filter]
    _ = (X.card : ℝ) := by simp
    _ ≤ (((conflictLinkLayer C f₀ j) ∩
        conflictLinkLayer C g j).card : ℝ) := by
      exact_mod_cast hcard

/-- Certificate-specialized singleton full-card charge.  The truncation
supplies both the disjoint host-pair hypothesis and exclusion from the
two-conflict layer, so the ordinary certificate common-link field applies. -/
theorem RegularizationCertificate.singleton_fullCardCharge_le_of_f0Truncated
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    {f₀ g : Finset V} {R : Hypergraph V}
    (hf₀H : f₀ ∈ H) (hgH : g ∈ H)
    (htrunc : IsF0TruncatedGainCollisionResidual
      H Rcert.regularized f₀ R)
    (hgR : g ∈ R)
    (j : ℕ) (hj : j ∈ Finset.Icc 1 3) :
    (∑ q ∈ Finset.Icc 2 4,
      ∑ c ∈ (conflictLayer Rcert.regularized q).filter
          (fun c ↦ ({g} : Hypergraph V) ⊆ c ∧
            (c \ ({g} : Hypergraph V)).card = j),
        testExtension
          (conflictLinkTestWeight Rcert.regularized f₀ j)
          H j (c \ ({g} : Hypergraph V))) ≤
      Real.rpow d ((j : ℝ) - eps / 4) := by
  have hlayers := sum_conflictLayers_eq_sum_of_card_between_two_four
    (fun c hc ↦ Rcert.bounded.conflict_card hc)
    (fun c ↦ ({g} : Hypergraph V) ⊆ c ∧
      (c \ ({g} : Hypergraph V)).card = j)
    (fun c ↦ testExtension
      (conflictLinkTestWeight Rcert.regularized f₀ j)
      H j (c \ ({g} : Hypergraph V)))
  rw [hlayers]
  exact (sum_conflictLinkTestExtensions_singleton_le_commonLinksCard
      Rcert.isConflictSystem j).trans
    (Erdos136.RegularizationCertificate.commonLinks_natRank_of_f0Truncated
      Rcert hf₀H hgH htrunc hgR j hj)

/-- The actual truncated singleton full-card submass.  If the root pair is
ordinary, Fubini and `commonLinks` bound it.  If it is not ordinary, every
putative summand contradicts its own truncation predicate, so the mass is
zero. -/
theorem RegularizationCertificate.weightedF0TruncatedFullCardRootMass_singleton_le
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 0 ≤ d)
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj : j ∈ Finset.Icc 1 3)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hrootCard : root.card = 1) :
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      12 * Real.rpow d ((j : ℝ) - eps / 4) := by
  obtain ⟨g, hrootEq⟩ := Finset.card_eq_one.mp hrootCard
  have hgH : g ∈ H := hrootH (by rw [hrootEq]; simp)
  by_cases hsafe : Disjoint f₀ g ∧
      {f₀, g} ∉ conflictLayer Rcert.regularized 2
  · have hFubini :=
      weightedF0TruncatedGainCollisionResidualFullCardRootMass_le_extensionSum
        (H := H) (C := Rcert.regularized) (f₀ := f₀)
        (j := j) (r := r)
        (w := conflictLinkTestWeight Rcert.regularized f₀ j)
        (fun S ↦ by
          by_cases hS : S ∈ conflictLinkLayer Rcert.regularized f₀ j <;>
            simp [conflictLinkTestWeight, hS])
        (Finset.mem_Icc.mp hj).2 root
    have hcharge :=
      sum_conflictLinkTestExtensions_singleton_le_commonLinksCard
        Rcert.isConflictSystem j (f₀ := f₀) (g := g)
    rw [hrootEq] at hFubini
    calc
      weightedF0TruncatedGainCollisionResidualFullCardRootMass
          (conflictLinkTestWeight Rcert.regularized f₀ j)
          H Rcert.regularized f₀ j r root =
          weightedF0TruncatedGainCollisionResidualFullCardRootMass
            (conflictLinkTestWeight Rcert.regularized f₀ j)
            H Rcert.regularized f₀ j r {g} := by rw [hrootEq]
      _ ≤ 12 * ∑ c ∈ Rcert.regularized.filter
            (fun c ↦ ({g} : Hypergraph V) ⊆ c ∧
              (c \ ({g} : Hypergraph V)).card = j),
          testExtension
            (conflictLinkTestWeight Rcert.regularized f₀ j)
            H j (c \ ({g} : Hypergraph V)) := hFubini
      _ ≤ 12 * (((conflictLinkLayer Rcert.regularized f₀ j) ∩
            conflictLinkLayer Rcert.regularized g j).card : ℝ) := by
          exact mul_le_mul_of_nonneg_left hcharge (by norm_num)
      _ ≤ 12 * Real.rpow d ((j : ℝ) - eps / 4) := by
          apply mul_le_mul_of_nonneg_left _ (by norm_num)
          exact Erdos136.RegularizationCertificate.commonLinks_natRank
            Rcert hf₀H hgH hsafe.1 hsafe.2 j hj
  · have hzero :
        weightedF0TruncatedGainCollisionResidualFullCardRootMass
          (conflictLinkTestWeight Rcert.regularized f₀ j)
          H Rcert.regularized f₀ j r root = 0 := by
      unfold weightedF0TruncatedGainCollisionResidualFullCardRootMass
      apply Finset.sum_eq_zero
      intro S hS
      apply Finset.sum_eq_zero
      intro e heS
      apply Finset.sum_eq_zero
      intro f hfS
      apply Finset.sum_eq_zero
      intro c hcC
      rw [if_neg]
      intro hrep
      have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
      have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
      obtain ⟨g', hrootEq', hdisj, hpair⟩ :=
        fullEmptySource_singleton_commonLinks_conditions_of_f0Truncated
          hrootCard hrep.1 heS hfS' (Ne.symm hfe)
          hrep.2.1 hrep.2.2.1 hrep.2.2.2.2.1
          hrep.2.2.2.2.2.1 hrep.2.2.2.2.2.2.1
          hrep.2.2.2.2.2.2.2.1
      have hgg' : g = g' := Finset.singleton_inj.mp
        (hrootEq.symm.trans hrootEq')
      subst g'
      exact hsafe ⟨hdisj, hpair⟩
    rw [hzero]
    exact mul_nonneg (by norm_num) (Real.rpow_nonneg hd _)

/-- A two-edge full root needs no common-link input: every full-card link
weight is at most one, and the represented conflicts form a subfamily of
the `(j+2)`-layer codegree at the root. -/
theorem sum_conflictLinkTestExtensions_cardTwo_le_layerCodegree
    {H : Hypergraph V} {C : ConflictSystem V}
    (hC : IsConflictSystem H C)
    {f₀ : Finset V} {root : Hypergraph V}
    (hrootCard : root.card = 2) (j : ℕ) :
    (∑ c ∈ C.filter
        (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
      testExtension (conflictLinkTestWeight C f₀ j)
        H j (c \ root)) ≤
      (codegree (conflictLayer C (j + 2)) root : ℝ) := by
  let F := C.filter (fun c ↦ root ⊆ c ∧ (c \ root).card = j)
  have heach : ∀ c ∈ F,
      testExtension (conflictLinkTestWeight C f₀ j)
        H j (c \ root) ≤ 1 := by
    intro c hcF
    have hc := Finset.mem_filter.mp (by simpa only [F] using hcF)
    have hDH : c \ root ⊆ H := Finset.sdiff_subset.trans (hC c hc.1)
    have hfilter :
        (H.powersetCard j).filter (c \ root ⊆ ·) = {c \ root} := by
      ext Q
      simp only [Finset.mem_filter, Finset.mem_powersetCard,
        Finset.mem_singleton]
      constructor
      · rintro ⟨⟨hQH, hQcard⟩, hsub⟩
        exact (Finset.eq_of_subset_of_card_le hsub
          (by rw [hc.2.2, hQcard])).symm
      · rintro rfl
        exact ⟨⟨hDH, hc.2.2⟩, Finset.Subset.rfl⟩
    unfold testExtension
    rw [hfilter]
    by_cases hlink : c \ root ∈ conflictLinkLayer C f₀ j <;>
      simp [hlink]
  have hFsub : F ⊆ (conflictLayer C (j + 2)).filter (root ⊆ ·) := by
    intro c hcF
    have hc := Finset.mem_filter.mp (by simpa only [F] using hcF)
    have hcardSdiff := Finset.card_sdiff_of_subset hc.2.1
    have hrootLe := Finset.card_le_card hc.2.1
    apply Finset.mem_filter.mpr
    refine ⟨mem_conflictLayer.mpr ⟨hc.1, ?_⟩, hc.2.1⟩
    omega
  calc
    (∑ c ∈ C.filter
        (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
      testExtension (conflictLinkTestWeight C f₀ j)
        H j (c \ root)) =
        ∑ c ∈ F,
          testExtension (conflictLinkTestWeight C f₀ j)
            H j (c \ root) := by rfl
    _ ≤ ∑ _c ∈ F, (1 : ℝ) := Finset.sum_le_sum heach
    _ = (F.card : ℝ) := by simp
    _ ≤ (codegree (conflictLayer C (j + 2)) root : ℝ) := by
      exact_mod_cast Finset.card_le_card hFsub

/-- Certificate C3 bound for a two-edge full-card root. -/
theorem RegularizationCertificate.cardTwo_fullCardCharge_le
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    {f₀ : Finset V} {root : Hypergraph V}
    (hrootCard : root.card = 2)
    (j : ℕ) (hj1 : 1 ≤ j) (hj2 : j ≤ 2) :
    (∑ q ∈ Finset.Icc 2 4,
      ∑ c ∈ (conflictLayer Rcert.regularized q).filter
          (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
        testExtension
          (conflictLinkTestWeight Rcert.regularized f₀ j)
          H j (c \ root)) ≤
      Real.rpow d ((j : ℝ) - eps / 4) := by
  have hlayers := sum_conflictLayers_eq_sum_of_card_between_two_four
    (fun c hc ↦ Rcert.bounded.conflict_card hc)
    (fun c ↦ root ⊆ c ∧ (c \ root).card = j)
    (fun c ↦ testExtension
      (conflictLinkTestWeight Rcert.regularized f₀ j)
      H j (c \ root))
  rw [hlayers]
  have hcount := sum_conflictLinkTestExtensions_cardTwo_le_layerCodegree
    (f₀ := f₀) Rcert.isConflictSystem hrootCard j
  apply hcount.trans
  have hC3 := Rcert.bounded.layer_codegree
    (r := j + 2) (q := 2) (by omega) (by omega)
      (by omega) (by omega) root hrootCard
  simpa [hrootCard, Nat.cast_add] using hC3

/-- The actual truncated two-edge full-card submass, obtained by composing
the ordered-pair Fubini reduction with certificate C3. -/
theorem RegularizationCertificate.weightedF0TruncatedFullCardRootMass_cardTwo_le
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    {f₀ : Finset V} {j r : ℕ}
    (hj1 : 1 ≤ j) (hj2 : j ≤ 2)
    (root : Hypergraph V) (hrootCard : root.card = 2) :
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      12 * Real.rpow d ((j : ℝ) - eps / 4) := by
  have hFubini :=
    weightedF0TruncatedGainCollisionResidualFullCardRootMass_le_extensionSum
      (H := H) (C := Rcert.regularized) (f₀ := f₀)
      (j := j) (r := r)
      (w := conflictLinkTestWeight Rcert.regularized f₀ j)
      (fun S ↦ by
        by_cases hS : S ∈ conflictLinkLayer Rcert.regularized f₀ j <;>
          simp [conflictLinkTestWeight, hS])
      (by omega : j ≤ 3) root
  have hcount := sum_conflictLinkTestExtensions_cardTwo_le_layerCodegree
    (f₀ := f₀) Rcert.isConflictSystem hrootCard j
  have hC3 := Rcert.bounded.layer_codegree
    (r := j + 2) (q := 2) (by omega) (by omega)
      (by omega) (by omega) root hrootCard
  calc
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      12 * ∑ c ∈ Rcert.regularized.filter
          (fun c ↦ root ⊆ c ∧ (c \ root).card = j),
        testExtension
          (conflictLinkTestWeight Rcert.regularized f₀ j)
          H j (c \ root) := hFubini
    _ ≤ 12 * (codegree
          (conflictLayer Rcert.regularized (j + 2)) root : ℝ) := by
      exact mul_le_mul_of_nonneg_left hcount (by norm_num)
    _ ≤ 12 * Real.rpow d ((j : ℝ) - eps / 4) := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      simpa [hrootCard, Nat.cast_add] using hC3

/-- A two-edge root and a full three-edge source would force a conflict of
cardinality five, so this boundary submass is empty in the four-conflict
certificate. -/
theorem RegularizationCertificate.weightedF0TruncatedFullCardRootMass_cardTwo_jThree
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    {f₀ : Finset V} {r : ℕ}
    (root : Hypergraph V) (hrootCard : root.card = 2) :
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ 3)
        H Rcert.regularized f₀ 3 r root = 0 := by
  unfold weightedF0TruncatedGainCollisionResidualFullCardRootMass
  apply Finset.sum_eq_zero
  intro S hS
  apply Finset.sum_eq_zero
  intro e heS
  apply Finset.sum_eq_zero
  intro f hfS
  apply Finset.sum_eq_zero
  intro c hcC
  rw [if_neg]
  intro hrep
  have hfe : f ≠ e := (Finset.mem_erase.mp hfS).1
  have hfS' : f ∈ S := (Finset.mem_erase.mp hfS).2
  have hgeom := full_emptySourceRoot_geometry
    hrep.1 heS hfS' (Ne.symm hfe) hrep.2.1 hrep.2.2.1
    hrep.2.2.2.2.1 hrep.2.2.2.2.2.1
    hrep.2.2.2.2.2.2.1
  have hrootc : root ⊆ c := by
    rw [hgeom.1]
    exact Finset.sdiff_subset
  have hcardSdiff := Finset.card_sdiff_of_subset hrootc
  have hc4 := (Rcert.bounded.conflict_card hcC).2
  have hDcard : (c \ root).card = 3 :=
    hrep.2.2.2.2.2.2.2.2
  omega

/-- Unified relative full-card boundary estimate for the internal truncated
representation.  These are the only possible positive root sizes. -/
theorem RegularizationCertificate.weightedF0TruncatedFullCardRootMass_le_scale
    {ι : Type*} [Fintype ι]
    {H : Hypergraph V} {C : ConflictSystem V}
    {d eps Gamma : ℝ} {ell : ℕ}
    {testJ : ι → ℕ} {testW : ι → TestWeight V}
    (Rcert : CFMRegularization.RegularizationCertificate
      H C d eps Gamma ell testJ testW)
    (hd : 1 ≤ d) (heps : 0 ≤ eps)
    (hcutoff : 12 ≤ Real.rpow d (eps / 10))
    {f₀ : Finset V} (hf₀H : f₀ ∈ H)
    {j r : ℕ} (hj : j ∈ Finset.Icc 1 3)
    (root : Hypergraph V) (hrootH : root ⊆ H)
    (hroot1 : 1 ≤ root.card) (hroot2 : root.card ≤ 2) :
    weightedF0TruncatedGainCollisionResidualFullCardRootMass
        (conflictLinkTestWeight Rcert.regularized f₀ j)
        H Rcert.regularized f₀ j r root ≤
      certificateInternalLayerScale
          H C d eps Gamma ell testJ testW Rcert (j + 1) *
        Real.rpow d (-eps / 10) := by
  have habsorb := twelve_rpow_quarter_le_certificateScale_mul_rpow_tenth
    Rcert hd heps hcutoff j
  rcases hroot1.eq_or_lt with hcardOne | hcardTwo
  · have hmass :=
      Erdos136.RegularizationCertificate.weightedF0TruncatedFullCardRootMass_singleton_le
        Rcert (by linarith : 0 ≤ d) hf₀H (r := r) hj root hrootH
          hcardOne.symm
    exact hmass.trans habsorb
  · have hrootCard : root.card = 2 := by omega
    by_cases hj2 : j ≤ 2
    · have hmass :=
        Erdos136.RegularizationCertificate.weightedF0TruncatedFullCardRootMass_cardTwo_le
          Rcert (f₀ := f₀) (r := r) (Finset.mem_Icc.mp hj).1 hj2 root
            hrootCard
      exact hmass.trans habsorb
    · have hj3 : j = 3 := by
        have := (Finset.mem_Icc.mp hj).2
        omega
      subst j
      rw [Erdos136.RegularizationCertificate.weightedF0TruncatedFullCardRootMass_cardTwo_jThree
        Rcert root hrootCard]
      exact mul_nonneg
        (certificateInternalLayerScale_pos
          H C d eps Gamma ell testJ testW Rcert 4 (by linarith)).le
        (Real.rpow_nonneg (by linarith : 0 ≤ d) _)

structure FiniteWeightedRootShadowCoordinate
    (H : Hypergraph V) (Profile : Type*)
    (activeRank : Profile → ℕ) (seed : Profile → Hypergraph V) where
  profile : Profile
  root : Hypergraph V
  root_subset_host : root ⊆ H
  seed_subset_root : seed profile ⊆ root
  selected : Fin 6
  selected_pos : 1 ≤ selected.1
  legal : root.card + selected.1 ≤ activeRank profile
deriving Fintype

def finiteWeightedRootShadowEmptyCoordinate
    {Profile : Type*} {H : Hypergraph V}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (b : Profile) (n : ℕ) (hnpos : 1 ≤ n) (hnlt : n < 6)
    (hnlegal : n ≤ activeRank b) (hseed : seed b = ∅) :
    FiniteWeightedRootShadowCoordinate H Profile activeRank seed where
  profile := b
  root := ∅
  root_subset_host := Finset.empty_subset H
  seed_subset_root := by simp [hseed]
  selected := ⟨n, hnlt⟩
  selected_pos := hnpos
  legal := by simpa using hnlegal

@[simp] theorem finiteWeightedRootShadowEmptyCoordinate_profile
    {Profile : Type*} {H : Hypergraph V}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (b : Profile) (n : ℕ) (hnpos : 1 ≤ n) (hnlt : n < 6)
    (hnlegal : n ≤ activeRank b) (hseed : seed b = ∅) :
    (finiteWeightedRootShadowEmptyCoordinate (H := H)
      b n hnpos hnlt hnlegal hseed).profile = b := rfl

@[simp] theorem finiteWeightedRootShadowEmptyCoordinate_root
    {Profile : Type*} {H : Hypergraph V}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (b : Profile) (n : ℕ) (hnpos : 1 ≤ n) (hnlt : n < 6)
    (hnlegal : n ≤ activeRank b) (hseed : seed b = ∅) :
    (finiteWeightedRootShadowEmptyCoordinate (H := H)
      b n hnpos hnlt hnlegal hseed).root = ∅ := rfl

@[simp] theorem finiteWeightedRootShadowEmptyCoordinate_selected
    {Profile : Type*} {H : Hypergraph V}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (b : Profile) (n : ℕ) (hnpos : 1 ≤ n) (hnlt : n < 6)
    (hnlegal : n ≤ activeRank b) (hseed : seed b = ∅) :
    (finiteWeightedRootShadowEmptyCoordinate (H := H)
      b n hnpos hnlt hnlegal hseed).selected.1 = n := rfl

abbrev FiniteWeightedRootShadowCoordinateCode
    (H : Hypergraph V) (Profile : Type*) :=
  Profile ×
    ((Σ r : Fin 5, {root : Hypergraph V // root ∈ H.powersetCard r.1}) × Fin 6)

def finiteWeightedRootShadowCoordinateCode
    {Profile : Type*} {H : Hypergraph V}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (hrank : ∀ b, activeRank b ≤ 5)
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    FiniteWeightedRootShadowCoordinateCode H Profile :=
  (c.profile,
    (⟨⟨c.root.card, by
        have hlegal := c.legal
        have hrank' := hrank c.profile
        have hselected := c.selected_pos
        omega⟩,
      ⟨c.root, Finset.mem_powersetCard.mpr ⟨c.root_subset_host, rfl⟩⟩⟩,
    c.selected))

theorem finiteWeightedRootShadowCoordinateCode_injective
    {Profile : Type*} {H : Hypergraph V}
    {activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    (hrank : ∀ b, activeRank b ≤ 5) :
    Function.Injective
      (finiteWeightedRootShadowCoordinateCode
        (H := H) (activeRank := activeRank) (seed := seed) hrank) := by
  intro c c' h
  have hp := congrArg (fun z ↦ z.1) h
  have hroot := congrArg (fun z ↦ z.2.1.2.1) h
  have hselected := congrArg (fun z ↦ z.2.2) h
  cases c
  cases c'
  simp only [finiteWeightedRootShadowCoordinateCode] at hp hroot hselected
  cases hp
  cases hroot
  cases hselected
  rfl

theorem card_finiteWeightedRootShadowCoordinate_le
    [Fintype V] {Profile : Type*} [Fintype Profile]
    (H : Hypergraph V) (activeRank : Profile → ℕ)
    (seed : Profile → Hypergraph V)
    (hrank : ∀ b, activeRank b ≤ 5) :
    Fintype.card
        (FiniteWeightedRootShadowCoordinate H Profile activeRank seed) ≤
      Fintype.card Profile *
        (∑ r : Fin 5, H.card.choose r.1) * 6 := by
  calc
    Fintype.card
        (FiniteWeightedRootShadowCoordinate H Profile activeRank seed) ≤
        Fintype.card (FiniteWeightedRootShadowCoordinateCode H Profile) :=
      Fintype.card_le_of_injective
        (finiteWeightedRootShadowCoordinateCode
          (H := H) (activeRank := activeRank) (seed := seed) hrank)
        (finiteWeightedRootShadowCoordinateCode_injective hrank)
    _ = Fintype.card Profile *
        (∑ r : Fin 5, H.card.choose r.1) * 6 := by
      simp only [FiniteWeightedRootShadowCoordinateCode,
        Fintype.card_prod, Fintype.card_sigma, Fintype.card_coe,
        Finset.card_powersetCard, Fintype.card_fin, Nat.mul_assoc]

def finiteWeightedRootShadowWeight
    {Profile : Type*} {activeRank : Profile → ℕ}
    {seed : Profile → Hypergraph V}
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    {H : Hypergraph V}
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    TestWeight V :=
  weightedConflictFamilyRootShadowWeight (X c.profile) (a c.profile) c.root

def finiteWeightedRootShadowRank
    {Profile : Type*} {activeRank : Profile → ℕ}
    {seed : Profile → Hypergraph V} {H : Hypergraph V}
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) : ℕ :=
  c.selected.1

noncomputable def finiteWeightedRootShadowStepFactor (eta d : ℝ) : ℝ :=
  Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16)

noncomputable def finiteWeightedRootShadowTailReserve (eta d : ℝ) : ℝ :=
  Real.rpow d (CFMNumeric.coreEpsilon eta / 64)

noncomputable def finiteWeightedRootShadowZeroScale
    (d d₀ : ℝ) (rootCard : ℕ) : ℝ :=
  d₀ * (d⁻¹) ^ rootCard

noncomputable def finiteWeightedRootShadowMargin
    (eta d d₀ : ℝ) (rootCard selected : ℕ) : ℝ :=
  finiteWeightedRootShadowZeroScale d d₀ rootCard *
    finiteWeightedRootShadowStepFactor eta d ^ selected

noncomputable def finiteWeightedRootShadowAggregateBudget
    (eta d d₀ : ℝ) (rootCard selected : ℕ) : ℝ :=
  2 * finiteWeightedRootShadowZeroScale d d₀ rootCard *
    finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)

noncomputable def finiteWeightedRootShadowJump
    (eta d d₀ : ℝ) (rootCard selected : ℕ) : ℝ :=
  2 * finiteWeightedRootShadowZeroScale d d₀ (rootCard + 1) *
    finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)

noncomputable def finiteWeightedRootShadowDrift
    (eta d N d₀ : ℝ) (q rootCard selected : ℕ) : ℝ :=
  (q : ℝ) *
      finiteWeightedRootShadowAggregateBudget eta d d₀ rootCard selected /
    localSpreadAvailableFloor eta d N

noncomputable def finiteWeightedRootShadowCap
    (eta d N d₀ : ℝ) (q rootCard selected : ℕ) (k : ℕ) : ℝ :=
  finiteWeightedRootShadowMargin eta d d₀ rootCard selected +
    (k : ℝ) *
      finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected

noncomputable def finiteWeightedRootShadowRange
    (eta d N d₀ : ℝ) (q rootCard selected : ℕ) : ℝ :=
  finiteWeightedRootShadowJump eta d d₀ rootCard selected +
    finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected

noncomputable def finiteWeightedRootShadowVariance
    (eta d N d₀ : ℝ) (q rootCard selected : ℕ) : ℝ :=
  2 * finiteWeightedRootShadowRange eta d N d₀ q rootCard selected *
    finiteWeightedRootShadowMargin eta d d₀ rootCard selected

noncomputable def finiteWeightedRootShadowStrongTail (eta d : ℝ) : ℝ :=
  Real.exp (-(100 * Real.rpow d (CFMNumeric.tailPower eta)))

noncomputable def finiteWeightedRootShadowPredicate
    {Profile : Type*} (H : Hypergraph V)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (eta d N : ℝ) (d₀ : Profile → ℝ) :
    FiniteWeightedRootShadowCoordinate H Profile activeRank seed →
      ℕ → Hypergraph V → Prop :=
  fun c k M ↦ localSpreadUpperCorridor
    (finiteWeightedRootShadowWeight X a c)
    (finiteWeightedRootShadowRank c)
    (finiteWeightedRootShadowCap eta d N (d₀ c.profile)
      (familyRank c.profile) c.root.card c.selected.1) k M

theorem finiteWeightedRootShadowCap_of_predicate
    {Profile : Type*} {H : Hypergraph V}
    {familyRank activeRank : Profile → ℕ} {seed : Profile → Hypergraph V}
    {X : Profile → ConflictSystem V} {a : Profile → TestWeight V}
    {eta d N : ℝ} {d₀ : Profile → ℝ}
    {c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed}
    {k : ℕ} {M : Hypergraph V}
    (hcorr : finiteWeightedRootShadowPredicate
      H familyRank activeRank seed X a eta d N d₀ c k M) :
    testTotal (finiteWeightedRootShadowWeight X a c) M c.selected.1 ≤
      finiteWeightedRootShadowCap eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1 k := by
  unfold finiteWeightedRootShadowPredicate localSpreadUpperCorridor
    localSpreadUpperError finiteWeightedRootShadowRank at hcorr
  exact (sub_neg.mp hcorr).le

theorem finiteWeightedRootShadowZeroScale_nonneg
    {d d₀ : ℝ} (hd : 0 ≤ d) (hd₀ : 0 ≤ d₀) (r : ℕ) :
    0 ≤ finiteWeightedRootShadowZeroScale d d₀ r := by
  unfold finiteWeightedRootShadowZeroScale
  exact mul_nonneg hd₀ (pow_nonneg (inv_nonneg.mpr hd) _)

theorem weightedCodegree_le_zeroScale_of_spread_or_full
    {X : ConflictSystem V} {a : TestWeight V} {q : ℕ}
    {d d₀ : ℝ}
    (hspread : IsWeightedRealSpread X a q d₀ d⁻¹)
    (hfull : ∀ root : Hypergraph V, root.card = q →
      weightedCodegree X a root ≤ finiteWeightedRootShadowZeroScale d d₀ q)
    (root : Hypergraph V) (hroot : root.card ≤ q) :
    weightedCodegree X a root ≤
      finiteWeightedRootShadowZeroScale d d₀ root.card := by
  by_cases hlt : root.card < q
  · exact hspread.weightedShadow_le root hlt
  · have heq : root.card = q := by omega
    simpa [heq] using hfull root heq

theorem finiteWeightedRootShadowCap_step
    (eta d N d₀ : ℝ) (q rootCard selected k : ℕ) :
    finiteWeightedRootShadowCap eta d N d₀ q rootCard selected (k + 1) -
        finiteWeightedRootShadowCap eta d N d₀ q rootCard selected k =
      finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected := by
  unfold finiteWeightedRootShadowCap
  push_cast
  ring

theorem finiteWeightedRootShadowMargin_eq_step_mul_parent
    {eta d d₀ : ℝ} {rootCard selected : ℕ}
    (hselected : 1 ≤ selected) :
    finiteWeightedRootShadowMargin eta d d₀ rootCard selected =
      finiteWeightedRootShadowZeroScale d d₀ rootCard *
        finiteWeightedRootShadowStepFactor eta d ^ (selected - 1) *
          finiteWeightedRootShadowStepFactor eta d := by
  unfold finiteWeightedRootShadowMargin
  have hpow : finiteWeightedRootShadowStepFactor eta d ^ selected =
      finiteWeightedRootShadowStepFactor eta d ^ (selected - 1) *
        finiteWeightedRootShadowStepFactor eta d := by
    calc
      finiteWeightedRootShadowStepFactor eta d ^ selected =
          finiteWeightedRootShadowStepFactor eta d ^ ((selected - 1) + 1) := by
            congr 1
            omega
      _ = finiteWeightedRootShadowStepFactor eta d ^ (selected - 1) *
          finiteWeightedRootShadowStepFactor eta d := by
            rw [pow_succ]
  rw [hpow]
  ring

theorem finiteWeightedRootShadowJump_mul_reserve_le_two_margin
    {eta d d₀ : ℝ} {rootCard selected : ℕ}
    (hd : 1 ≤ d) (heps : 0 ≤ CFMNumeric.coreEpsilon eta)
    (hd₀ : 0 ≤ d₀) (hselected : 1 ≤ selected) :
    finiteWeightedRootShadowJump eta d d₀ rootCard selected *
        finiteWeightedRootShadowTailReserve eta d ≤
      2 * finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hreserve : finiteWeightedRootShadowTailReserve eta d ≤
      Real.rpow d (CFMNumeric.coreEpsilon eta / 16) := by
    unfold finiteWeightedRootShadowTailReserve
    apply Real.rpow_le_rpow_of_exponent_le hd
    linarith
  have hstep : d⁻¹ * Real.rpow d (CFMNumeric.coreEpsilon eta / 16) =
      finiteWeightedRootShadowStepFactor eta d := by
    unfold finiteWeightedRootShadowStepFactor
    rw [show d⁻¹ = Real.rpow d (-1) by
      exact (Real.rpow_neg_one d).symm]
    exact (Real.rpow_add hdpos (-1)
      (CFMNumeric.coreEpsilon eta / 16)).symm
  have hzeroSucc : finiteWeightedRootShadowZeroScale d d₀ (rootCard + 1) =
      finiteWeightedRootShadowZeroScale d d₀ rootCard * d⁻¹ := by
    unfold finiteWeightedRootShadowZeroScale
    rw [pow_succ]
    ring
  have hcommon0 : 0 ≤
      2 * finiteWeightedRootShadowZeroScale d d₀ rootCard *
        finiteWeightedRootShadowStepFactor eta d ^ (selected - 1) := by
    exact mul_nonneg
      (mul_nonneg (by norm_num)
        (finiteWeightedRootShadowZeroScale_nonneg hdpos.le hd₀ rootCard))
      (pow_nonneg (Real.rpow_nonneg hdpos.le _) _)
  unfold finiteWeightedRootShadowJump
  rw [hzeroSucc]
  calc
    (2 * (finiteWeightedRootShadowZeroScale d d₀ rootCard * d⁻¹) *
          finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) *
        finiteWeightedRootShadowTailReserve eta d =
      (2 * finiteWeightedRootShadowZeroScale d d₀ rootCard *
          finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) *
        (d⁻¹ * finiteWeightedRootShadowTailReserve eta d) := by ring
    _ ≤ (2 * finiteWeightedRootShadowZeroScale d d₀ rootCard *
          finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) *
        (d⁻¹ * Real.rpow d (CFMNumeric.coreEpsilon eta / 16)) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hreserve (inv_nonneg.mpr hdpos.le)) hcommon0
    _ = 2 * finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
      rw [hstep, finiteWeightedRootShadowMargin_eq_step_mul_parent hselected]
      ring

def FiniteWeightedRootShadowCoordinate.parent
    {Profile : Type*} {activeRank : Profile → ℕ}
    {seed : Profile → Hypergraph V} {H : Hypergraph V}
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed)
    (hselected : 2 ≤ c.selected.1) :
    FiniteWeightedRootShadowCoordinate H Profile activeRank seed where
  profile := c.profile
  root := c.root
  root_subset_host := c.root_subset_host
  seed_subset_root := c.seed_subset_root
  selected := ⟨c.selected.1 - 1, by
    have hlt := c.selected.2
    omega⟩
  selected_pos := by
    change 1 ≤ c.selected.1 - 1
    omega
  legal := by
    change c.root.card + (c.selected.1 - 1) ≤ activeRank c.profile
    have hlegal := c.legal
    omega

def FiniteWeightedRootShadowCoordinate.insertParent
    {Profile : Type*} {activeRank : Profile → ℕ}
    {seed : Profile → Hypergraph V} {H : Hypergraph V}
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed)
    (hselected : 2 ≤ c.selected.1) (x : Finset V)
    (hxH : x ∈ H) (hxroot : x ∉ c.root) :
    FiniteWeightedRootShadowCoordinate H Profile activeRank seed where
  profile := c.profile
  root := insert x c.root
  root_subset_host := by
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact hxH
    · exact c.root_subset_host hy
  seed_subset_root := c.seed_subset_root.trans (Finset.subset_insert x c.root)
  selected := ⟨c.selected.1 - 1, by
    have hlt := c.selected.2
    omega⟩
  selected_pos := by
    change 1 ≤ c.selected.1 - 1
    omega
  legal := by
    rw [Finset.card_insert_of_notMem hxroot]
    change c.root.card + 1 + (c.selected.1 - 1) ≤ activeRank c.profile
    have hlegal := c.legal
    omega

/-! This version of the generic successor constructor asks for an extended
root bound only when the newly selected edge is not already in the root.
The derivative is identically zero in the omitted case. -/

theorem localSpreadUpperSourceBudgets_rootShadow_succ_of_notMem
    (X : ConflictSystem V) (a : TestWeight V) (q : ℕ)
    (hX : IsUniform X q) (ha : ∀ U, 0 ≤ a U)
    (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T n : ℕ)
    (root : Hypergraph V)
    (cap jump availFloor aggregateCap : ℕ → ℝ)
    (hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k)
    (hjump0 : ∀ k, 0 ≤ jump k)
    (haggregate0 : ∀ k, 0 ≤ aggregateCap k)
    (hfloorPos : ∀ k, k < T → 0 < availFloor k)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      availFloor k ≤ ((availableEdges H C M).card : ℝ))
    (haggregate : ∀ k, k < T → ∀ M, Good k M →
      testTotal (weightedConflictFamilyRootShadowWeight X a root) M n ≤
        aggregateCap k)
    (hextended : ∀ k, k < T → ∀ M, Good k M →
      ∀ x ∈ availableEdges H C M, x ∉ root →
        testTotal
          (weightedConflictFamilyRootShadowWeight X a (insert x root)) M n ≤
            jump k)
    (hmeanScalar : ∀ k, k < T →
      (q : ℝ) * aggregateCap k / availFloor k ≤
        cap (k + 1) - cap k) :
    LocalSpreadUpperSourceBudgets
      (weightedConflictFamilyRootShadowWeight X a root)
      H C Good T (n + 1) cap jump := by
  refine
    { weight_nonneg := weightedConflictFamilyRootShadowWeight_nonneg ha root
      capStep_nonneg := hcapStep
      jump_nonneg := hjump0
      mean := ?_
      rawJump := ?_ }
  · intro k hk M hgood
    have hfloor := hfloorPos k hk
    have havail := havailable k hk M hgood
    have hcardPos : 0 < ((availableEdges H C M).card : ℝ) :=
      hfloor.trans_le havail
    have hA : (availableEdges H C M).Nonempty :=
      Finset.card_pos.mp (by exact_mod_cast hcardPos)
    calc
      greedyStepExpectation H C M
          (localSpreadRawStep
            (weightedConflictFamilyRootShadowWeight X a root) (n + 1) M) ≤
          (q : ℝ) *
              testTotal
                (weightedConflictFamilyRootShadowWeight X a root) M n /
            ((availableEdges H C M).card : ℝ) :=
        greedyStepExpectation_localSpreadRawStep_rootShadow_succ_le
          X a q hX ha H C M root n hA
      _ ≤ (q : ℝ) * aggregateCap k /
            ((availableEdges H C M).card : ℝ) := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left (haggregate k hk M hgood)
            (Nat.cast_nonneg _)) hcardPos.le
      _ ≤ (q : ℝ) * aggregateCap k / availFloor k := by
        exact div_le_div_of_nonneg_left
          (mul_nonneg (Nat.cast_nonneg _) (haggregate0 k)) hfloor havail
      _ ≤ cap (k + 1) - cap k := hmeanScalar k hk
  · intro k hk M hgood o
    rcases o with _ | x
    · simp [greedyChoiceStep, localSpreadRawStep, hjump0 k]
    · by_cases hxA : (x : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert hxA]
        rw [localSpreadRawStep_succ_insert_eq_derivative _ M x.1
          (mem_availableEdges.mp hxA).2.1 n]
        by_cases hxroot : (x : Finset V) ∈ root
        · rw [chosenSetDerivativeWeight_rootShadow_eq_zero_of_mem
            X a root x.1 hxroot]
          simpa [testTotal] using hjump0 k
        · rw [chosenSetDerivativeWeight_rootShadow_eq_insert
            X a root x.1 hxroot]
          exact hextended k hk M hgood x.1 hxA hxroot
      · rw [greedyChoiceStep, greedyStep_eq_self hxA]
        simp [localSpreadRawStep, hjump0 k]

theorem finiteWeightedRootShadowCap_le_two_margin
    {eta d N d₀ : ℝ} {q rootCard selected T k : ℕ}
    (hd : 0 < d) (hd₀ : 0 ≤ d₀)
    (hfloor : 0 < localSpreadAvailableFloor eta d N)
    (hk : k ≤ T)
    (hcontract : (T : ℝ) *
        finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected *
          finiteWeightedRootShadowTailReserve eta d ≤
        finiteWeightedRootShadowMargin eta d d₀ rootCard selected)
    (hreserve : 1 ≤ finiteWeightedRootShadowTailReserve eta d) :
    finiteWeightedRootShadowCap eta d N d₀ q rootCard selected k ≤
      2 * finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
  have hdrift : 0 ≤
      finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected := by
    unfold finiteWeightedRootShadowDrift
    exact div_nonneg
      (mul_nonneg (Nat.cast_nonneg _)
        (by
          unfold finiteWeightedRootShadowAggregateBudget
          exact mul_nonneg
            (mul_nonneg (by norm_num)
              (finiteWeightedRootShadowZeroScale_nonneg hd.le hd₀ rootCard))
            (pow_nonneg (Real.rpow_nonneg hd.le _) _))) hfloor.le
  have hkT : (k : ℝ) ≤ (T : ℝ) := by exact_mod_cast hk
  have htime : (T : ℝ) *
      finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected ≤
        finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
    calc
      (T : ℝ) *
          finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected ≤
        ((T : ℝ) *
          finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected) *
            finiteWeightedRootShadowTailReserve eta d := by
          exact le_mul_of_one_le_right
            (mul_nonneg (Nat.cast_nonneg _) hdrift) hreserve
      _ ≤ finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
        simpa [mul_assoc] using hcontract
  unfold finiteWeightedRootShadowCap
  have hkmul := mul_le_mul_of_nonneg_right hkT hdrift
  nlinarith

theorem finiteWeightedRootShadowDrift_mul_reserve_le_margin_of_contract
    {eta d N d₀ : ℝ} {q rootCard selected T : ℕ}
    (hd : 0 ≤ d)
    (hdrift : 0 ≤
      finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected)
    (hT : 1 ≤ T)
    (hcontract : (T : ℝ) *
        finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected *
          finiteWeightedRootShadowTailReserve eta d ≤
        finiteWeightedRootShadowMargin eta d d₀ rootCard selected) :
    finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected *
        finiteWeightedRootShadowTailReserve eta d ≤
      finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
  have hTone : (1 : ℝ) ≤ (T : ℝ) := by exact_mod_cast hT
  calc
    finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected *
        finiteWeightedRootShadowTailReserve eta d =
      1 * (finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected *
        finiteWeightedRootShadowTailReserve eta d) := by ring
    _ ≤ (T : ℝ) *
        (finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected *
          finiteWeightedRootShadowTailReserve eta d) := by
      exact mul_le_mul_of_nonneg_right hTone
        (mul_nonneg hdrift (Real.rpow_nonneg hd _))
    _ ≤ finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
      simpa [mul_assoc] using hcontract

theorem finiteWeightedRootShadowConcreteSourceBudgets
    [Fintype V] {Profile : Type*} [Fintype Profile]
    (H : Hypergraph V) (C : ConflictSystem V)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ) (eta d N : ℝ)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (hspread : ∀ b, IsWeightedRealSpread
      (X b) (a b) (familyRank b) (d₀ b) d⁻¹)
    (hd : 1 ≤ d) (hd₀ : ∀ b, 0 ≤ d₀ b)
    (hzero : ∀ b (root : Hypergraph V), root ⊆ H →
      seed b ⊆ root → root.card ≤ activeRank b →
      weightedCodegree (X b) (a b) root ≤
        finiteWeightedRootShadowZeroScale d (d₀ b) root.card)
    (hfloor : 0 < localSpreadAvailableFloor eta d N)
    (havailable : ∀ k, k < T → ∀ M, Good k M →
      localSpreadAvailableFloor eta d N ≤
        ((availableEdges H C M).card : ℝ))
    (hcorr : ∀ k M, Good k M →
      ∀ c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed,
        finiteWeightedRootShadowPredicate H familyRank activeRank seed X a eta d N d₀
          c k M)
    (hcontract : ∀ c :
      FiniteWeightedRootShadowCoordinate H Profile activeRank seed,
      (T : ℝ) * finiteWeightedRootShadowDrift eta d N (d₀ c.profile)
          (familyRank c.profile) c.root.card c.selected.1 *
          finiteWeightedRootShadowTailReserve eta d ≤
        finiteWeightedRootShadowMargin eta d (d₀ c.profile)
          c.root.card c.selected.1)
    (hreserve : 1 ≤ finiteWeightedRootShadowTailReserve eta d)
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    LocalSpreadUpperSourceBudgets
      (finiteWeightedRootShadowWeight X a c) H C Good T c.selected.1
      (finiteWeightedRootShadowCap eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1)
      (fun _ ↦ finiteWeightedRootShadowJump eta d (d₀ c.profile)
        c.root.card c.selected.1) := by
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  let n := c.selected.1 - 1
  let cap := finiteWeightedRootShadowCap eta d N (d₀ c.profile)
    (familyRank c.profile) c.root.card c.selected.1
  let jump : ℕ → ℝ := fun _ ↦
    finiteWeightedRootShadowJump eta d (d₀ c.profile)
      c.root.card c.selected.1
  let aggregate : ℕ → ℝ := fun _ ↦
    finiteWeightedRootShadowAggregateBudget eta d (d₀ c.profile)
      c.root.card c.selected.1
  let floor : ℕ → ℝ := fun _ ↦ localSpreadAvailableFloor eta d N
  have hstep0 : 0 ≤ finiteWeightedRootShadowStepFactor eta d :=
    Real.rpow_nonneg hdpos.le _
  have hzero0 : ∀ r, 0 ≤
      finiteWeightedRootShadowZeroScale d (d₀ c.profile) r :=
    fun r ↦ finiteWeightedRootShadowZeroScale_nonneg hdpos.le
      (hd₀ c.profile) r
  have hmargin0 : ∀ r s, 0 ≤
      finiteWeightedRootShadowMargin eta d (d₀ c.profile) r s := by
    intro r s
    unfold finiteWeightedRootShadowMargin
    exact mul_nonneg (hzero0 r) (pow_nonneg hstep0 _)
  have haggregate0 : ∀ k, 0 ≤ aggregate k := by
    intro k
    exact mul_nonneg (mul_nonneg (by norm_num) (hzero0 c.root.card))
      (pow_nonneg hstep0 _)
  have hjump0 : ∀ k, 0 ≤ jump k := by
    intro k
    exact mul_nonneg (mul_nonneg (by norm_num) (hzero0 (c.root.card + 1)))
      (pow_nonneg hstep0 _)
  have hdrift0 : 0 ≤ finiteWeightedRootShadowDrift eta d N
      (d₀ c.profile) (familyRank c.profile) c.root.card c.selected.1 := by
    unfold finiteWeightedRootShadowDrift
    exact div_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (haggregate0 0)) hfloor.le
  have hcapStep : ∀ k, 0 ≤ cap (k + 1) - cap k := by
    intro k
    rw [show cap (k + 1) - cap k =
      finiteWeightedRootShadowDrift eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1 by
          exact finiteWeightedRootShadowCap_step _ _ _ _ _ _ _ _]
    exact hdrift0
  have hcapUpper : ∀
      (c' : FiniteWeightedRootShadowCoordinate H Profile activeRank seed)
      (k : ℕ), k ≤ T →
      finiteWeightedRootShadowCap eta d N (d₀ c'.profile)
          (familyRank c'.profile) c'.root.card c'.selected.1 k ≤
        2 * finiteWeightedRootShadowMargin eta d (d₀ c'.profile)
          c'.root.card c'.selected.1 := by
    intro c' k hk
    exact finiteWeightedRootShadowCap_le_two_margin hdpos
      (hd₀ c'.profile) hfloor hk (hcontract c') hreserve
  have haggregate : ∀ k, k < T → ∀ M, Good k M →
      testTotal (weightedConflictFamilyRootShadowWeight
        (X c.profile) (a c.profile) c.root) M n ≤ aggregate k := by
    intro k hk M hgood
    by_cases hone : c.selected.1 = 1
    · have hn : n = 0 := by simp [n, hone]
      rw [hn]
      have hlegal := c.legal
      have hselectedPos := c.selected_pos
      have hstatic := hzero c.profile c.root c.root_subset_host
        c.seed_subset_root (by omega)
      have htotal : testTotal
          (weightedConflictFamilyRootShadowWeight
            (X c.profile) (a c.profile) c.root) M 0 =
          weightedCodegree (X c.profile) (a c.profile) c.root := by
        simp [testTotal, weightedConflictFamilyRootShadowWeight]
      rw [htotal]
      dsimp only [aggregate]
      simpa [hone, finiteWeightedRootShadowAggregateBudget] using
        hstatic.trans (by nlinarith [hzero0 c.root.card])
    · have hselectedPos := c.selected_pos
      have htwo : 2 ≤ c.selected.1 := by omega
      let cp := c.parent htwo
      have hcorr' := hcorr k M hgood cp
      have hlt : testTotal
          (weightedConflictFamilyRootShadowWeight
            (X c.profile) (a c.profile) c.root) M n <
          finiteWeightedRootShadowCap eta d N (d₀ c.profile)
            (familyRank c.profile) c.root.card n k := by
        apply sub_neg.mp
        simpa [finiteWeightedRootShadowPredicate,
          finiteWeightedRootShadowWeight, finiteWeightedRootShadowRank,
          localSpreadUpperCorridor, localSpreadUpperError, cp,
          FiniteWeightedRootShadowCoordinate.parent, n] using hcorr'
      exact hlt.le.trans (by
        have hu := hcapUpper cp k (Nat.le_of_lt hk)
        simpa [aggregate, finiteWeightedRootShadowAggregateBudget,
          finiteWeightedRootShadowMargin, cp,
          FiniteWeightedRootShadowCoordinate.parent, n, mul_assoc] using hu)
  have hextended : ∀ k, k < T → ∀ M, Good k M →
      ∀ x ∈ availableEdges H C M, x ∉ c.root →
        testTotal (weightedConflictFamilyRootShadowWeight
          (X c.profile) (a c.profile) (insert x c.root)) M n ≤ jump k := by
    intro k hk M hgood x hxA hxroot
    have hxH : x ∈ H := availableEdges_subset H C M hxA
    by_cases hone : c.selected.1 = 1
    · have hn : n = 0 := by simp [n, hone]
      rw [hn]
      have hrootCard : (insert x c.root).card = c.root.card + 1 :=
        Finset.card_insert_of_notMem hxroot
      have hlegal := c.legal
      have hselectedPos := c.selected_pos
      have hstatic := hzero c.profile (insert x c.root)
        (by
          intro y hy
          rcases Finset.mem_insert.mp hy with rfl | hy
          · exact hxH
          · exact c.root_subset_host hy)
        (c.seed_subset_root.trans (Finset.subset_insert x c.root))
        (by rw [hrootCard]; omega)
      have htotal : testTotal
          (weightedConflictFamilyRootShadowWeight
            (X c.profile) (a c.profile) (insert x c.root)) M 0 =
          weightedCodegree (X c.profile) (a c.profile) (insert x c.root) := by
        simp [testTotal, weightedConflictFamilyRootShadowWeight]
      rw [htotal]
      dsimp only [jump]
      rw [hrootCard] at hstatic
      simpa [hone, finiteWeightedRootShadowJump] using
        hstatic.trans (by nlinarith [hzero0 (c.root.card + 1)])
    · have hselectedPos := c.selected_pos
      have htwo : 2 ≤ c.selected.1 := by omega
      let ci := c.insertParent htwo x hxH hxroot
      have hcorr' := hcorr k M hgood ci
      have hlt : testTotal
          (weightedConflictFamilyRootShadowWeight
            (X c.profile) (a c.profile) (insert x c.root)) M n <
          finiteWeightedRootShadowCap eta d N (d₀ c.profile)
            (familyRank c.profile) (c.root.card + 1) n k := by
        apply sub_neg.mp
        simpa [finiteWeightedRootShadowPredicate,
          finiteWeightedRootShadowWeight, finiteWeightedRootShadowRank,
          localSpreadUpperCorridor, localSpreadUpperError, ci,
          FiniteWeightedRootShadowCoordinate.insertParent, n,
          Finset.card_insert_of_notMem hxroot] using hcorr'
      exact hlt.le.trans (by
        have hu := hcapUpper ci k (Nat.le_of_lt hk)
        simpa [jump, finiteWeightedRootShadowJump,
          finiteWeightedRootShadowMargin, ci,
          FiniteWeightedRootShadowCoordinate.insertParent, n,
          Finset.card_insert_of_notMem hxroot, mul_assoc] using hu)
  have hmean : ∀ k, k < T →
      ((familyRank c.profile : ℕ) : ℝ) * aggregate k / floor k ≤
        cap (k + 1) - cap k := by
    intro k hk
    rw [show cap (k + 1) - cap k =
      finiteWeightedRootShadowDrift eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1 by
          exact finiteWeightedRootShadowCap_step _ _ _ _ _ _ _ _]
    rfl
  have hsrc := localSpreadUpperSourceBudgets_rootShadow_succ_of_notMem
    (X c.profile) (a c.profile) (familyRank c.profile)
    (hspread c.profile).1 (hspread c.profile).2.1
    H C Good T n c.root cap jump floor aggregate
    hcapStep hjump0 haggregate0 (fun _ _ ↦ hfloor)
    (fun k hk M hgood ↦ havailable k hk M hgood)
    haggregate hextended hmean
  simpa [finiteWeightedRootShadowWeight, n,
    Nat.sub_add_cancel c.selected_pos, cap, jump] using hsrc

theorem finiteWeightedRootShadowContract_of_scale
    {eta d N d₀ : ℝ} {q rootCard selected T : ℕ}
    (hd : 0 < d) (hd₀ : 0 ≤ d₀) (hselected : 1 ≤ selected)
    (hfloor : 0 < localSpreadAvailableFloor eta d N)
    (hscale : 2 * (q : ℝ) * (T : ℝ) *
        finiteWeightedRootShadowTailReserve eta d ≤
      localSpreadAvailableFloor eta d N *
        finiteWeightedRootShadowStepFactor eta d) :
    (T : ℝ) * finiteWeightedRootShadowDrift eta d N d₀
        q rootCard selected * finiteWeightedRootShadowTailReserve eta d ≤
      finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
  have hbase0 : 0 ≤ finiteWeightedRootShadowZeroScale d d₀ rootCard *
      finiteWeightedRootShadowStepFactor eta d ^ (selected - 1) :=
    mul_nonneg
      (finiteWeightedRootShadowZeroScale_nonneg hd.le hd₀ rootCard)
      (pow_nonneg (Real.rpow_nonneg hd.le _) _)
  rw [finiteWeightedRootShadowMargin_eq_step_mul_parent hselected]
  unfold finiteWeightedRootShadowDrift
    finiteWeightedRootShadowAggregateBudget
  calc
    (T : ℝ) *
          ((q : ℝ) *
              (2 * finiteWeightedRootShadowZeroScale d d₀ rootCard *
                finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) /
            localSpreadAvailableFloor eta d N) *
        finiteWeightedRootShadowTailReserve eta d =
        (finiteWeightedRootShadowZeroScale d d₀ rootCard *
            finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) *
          (2 * (q : ℝ) * (T : ℝ) *
            finiteWeightedRootShadowTailReserve eta d) /
          localSpreadAvailableFloor eta d N := by ring
    _ ≤ (finiteWeightedRootShadowZeroScale d d₀ rootCard *
            finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) *
          (localSpreadAvailableFloor eta d N *
            finiteWeightedRootShadowStepFactor eta d) /
          localSpreadAvailableFloor eta d N := by
      exact div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left hscale hbase0) hfloor.le
    _ = (finiteWeightedRootShadowZeroScale d d₀ rootCard *
            finiteWeightedRootShadowStepFactor eta d ^ (selected - 1)) *
          finiteWeightedRootShadowStepFactor eta d := by
      field_simp [ne_of_gt hfloor]

theorem finiteWeightedRootShadowVariance_sum_le
    {eta d N d₀ : ℝ} {q rootCard selected T : ℕ}
    (hdrift : 0 ≤ finiteWeightedRootShadowDrift eta d N d₀
      q rootCard selected)
    (hjump : 0 ≤ finiteWeightedRootShadowJump eta d d₀ rootCard selected)
    (htime : (T : ℝ) * finiteWeightedRootShadowDrift eta d N d₀
      q rootCard selected ≤
        finiteWeightedRootShadowMargin eta d d₀ rootCard selected) :
    ∑ k ∈ Finset.range T,
        localSpreadVarianceBudget
          (finiteWeightedRootShadowCap eta d N d₀ q rootCard selected)
          (fun _ ↦ finiteWeightedRootShadowJump eta d d₀ rootCard selected) k ≤
      finiteWeightedRootShadowVariance eta d N d₀ q rootCard selected := by
  let drift := finiteWeightedRootShadowDrift eta d N d₀ q rootCard selected
  let jump := finiteWeightedRootShadowJump eta d d₀ rootCard selected
  let margin := finiteWeightedRootShadowMargin eta d d₀ rootCard selected
  let range := finiteWeightedRootShadowRange eta d N d₀ q rootCard selected
  have hpoint : ∀ k, localSpreadVarianceBudget
      (finiteWeightedRootShadowCap eta d N d₀ q rootCard selected)
      (fun _ ↦ jump) k = 2 * range * drift := by
    intro k
    unfold localSpreadVarianceBudget
    rw [finiteWeightedRootShadowCap_step]
    dsimp only [range, drift, jump]
    unfold finiteWeightedRootShadowRange
    ring
  calc
    ∑ k ∈ Finset.range T,
          localSpreadVarianceBudget
            (finiteWeightedRootShadowCap eta d N d₀ q rootCard selected)
            (fun _ ↦ finiteWeightedRootShadowJump eta d d₀ rootCard selected) k =
        ∑ _k ∈ Finset.range T, 2 * range * drift := by
      apply Finset.sum_congr rfl
      intro k hk
      exact hpoint k
    _ = 2 * range * ((T : ℝ) * drift) := by
      simp
      ring
    _ ≤ 2 * range * margin := by
      apply mul_le_mul_of_nonneg_left htime
      dsimp only [range]
      unfold finiteWeightedRootShadowRange
      exact mul_nonneg (by norm_num) (add_nonneg hjump hdrift)
    _ = finiteWeightedRootShadowVariance eta d N d₀ q rootCard selected := by
      unfold finiteWeightedRootShadowVariance
      rfl

theorem finiteWeightedRootShadowFreedmanRatio
    {tau reserve margin jump drift : ℝ}
    (htau : 0 ≤ tau) (hreserve : 0 < reserve)
    (hmargin : 0 < margin) (hjump : 0 ≤ jump) (hdrift : 0 ≤ drift)
    (hRpos : 0 < jump + drift)
    (hjumpReserve : jump * reserve ≤ 2 * margin)
    (hdriftReserve : drift * reserve ≤ margin)
    (hscale : 3600 * tau ≤ reserve) :
    100 * tau ≤
      margin ^ 2 /
        (4 * (2 * (jump + drift) * margin + (jump + drift) * margin)) := by
  have hR0 : 0 ≤ jump + drift := add_nonneg hjump hdrift
  have hRreserve : (jump + drift) * reserve ≤ 3 * margin := by
    nlinarith
  have hden : 0 <
      2 * (jump + drift) * margin + (jump + drift) * margin := by
    nlinarith [mul_pos hRpos hmargin]
  apply (le_div_iff₀ (mul_pos (by norm_num) hden)).2
  have hratioScale : 3600 * tau * (jump + drift) ≤ 3 * margin := by
    calc
      3600 * tau * (jump + drift) ≤
          reserve * (jump + drift) :=
        mul_le_mul_of_nonneg_right hscale hR0
      _ = (jump + drift) * reserve := by ring
      _ ≤ 3 * margin := hRreserve
  have hratioScale' : 1200 * tau * (jump + drift) ≤ margin := by
    nlinarith
  calc
    100 * tau *
          (4 * (2 * (jump + drift) * margin + (jump + drift) * margin)) =
        (1200 * tau * (jump + drift)) * margin := by ring
    _ ≤ margin * margin :=
      mul_le_mul_of_nonneg_right hratioScale' hmargin.le
    _ = margin ^ 2 := by ring

theorem finiteWeightedRootShadow_hazard_base
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    5120 ≤ Real.rpow d
      (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3) := by
  have hexp : (1 : ℝ) ≤ Real.exp (3 * Gamma) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by nlinarith [E.Gamma_one])
  calc
    (5120 : ℝ) ≤ 32 ^ 7 * 1 := by norm_num
    _ ≤ 32 ^ 7 * Real.exp (3 * Gamma) := by gcongr
    _ ≤ Real.rpow d
        (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3) :=
      S.testHazardAbsorption

theorem finiteWeightedRootShadow_tail_reserve_scale
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    3600 * Real.rpow d (CFMNumeric.tailPower eta) ≤
      finiteWeightedRootShadowTailReserve eta d := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps : 0 < CFMNumeric.coreEpsilon eta := by
    unfold CFMNumeric.coreEpsilon CFMRegularization.rawRegularizationEps
    nlinarith [E.eta_pos]
  have hbase := finiteWeightedRootShadow_hazard_base E S
  have htail0 : 0 ≤ Real.rpow d (CFMNumeric.tailPower eta) :=
    Real.rpow_nonneg hdpos.le _
  calc
    3600 * Real.rpow d (CFMNumeric.tailPower eta) ≤
        5120 * Real.rpow d (CFMNumeric.tailPower eta) := by
      gcongr
      norm_num
    _ ≤ Real.rpow d
          (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3) *
        Real.rpow d (CFMNumeric.tailPower eta) :=
      mul_le_mul_of_nonneg_right hbase htail0
    _ = Real.rpow d
        (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3 +
          CFMNumeric.tailPower eta) := by
      exact (Real.rpow_add hdpos
        (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3)
        (CFMNumeric.tailPower eta)).symm
    _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 64) := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      unfold CFMNumeric.tailPower
      nlinarith [pow_nonneg E.eta_pos.le 3]
    _ = finiteWeightedRootShadowTailReserve eta d := rfl

theorem finiteWeightedRootShadow_contraction_reserve_scale
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    5120 * finiteWeightedRootShadowTailReserve eta d ≤
      Real.rpow d (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps : 0 < CFMNumeric.coreEpsilon eta := by
    unfold CFMNumeric.coreEpsilon CFMRegularization.rawRegularizationEps
    nlinarith [E.eta_pos]
  have hbase := finiteWeightedRootShadow_hazard_base E S
  have hreserve0 : 0 ≤ finiteWeightedRootShadowTailReserve eta d :=
    Real.rpow_nonneg hdpos.le _
  calc
    5120 * finiteWeightedRootShadowTailReserve eta d ≤
        Real.rpow d
            (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3) *
          finiteWeightedRootShadowTailReserve eta d :=
      mul_le_mul_of_nonneg_right hbase hreserve0
    _ = Real.rpow d
        (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3 +
          CFMNumeric.coreEpsilon eta / 64) := by
      unfold finiteWeightedRootShadowTailReserve
      exact (Real.rpow_add hdpos
        (CFMNumeric.coreEpsilon eta / 512 - 7 * eta ^ 3)
        (CFMNumeric.coreEpsilon eta / 64)).symm
    _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := by
      apply Real.rpow_le_rpow_of_exponent_le hd
      nlinarith [pow_nonneg E.eta_pos.le 3]

theorem finiteWeightedRootShadow_available_scale
    {eta Gamma d N : ℝ} {T q : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N)
    (hq : q ≤ 5) :
    2 * (q : ℝ) * (T : ℝ) *
        finiteWeightedRootShadowTailReserve eta d ≤
      localSpreadAvailableFloor eta d N *
        finiteWeightedRootShadowStepFactor eta d := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hdpos eta) (by norm_num)).trans_le hN
  have hqcast : (q : ℝ) ≤ 5 := by exact_mod_cast hq
  have hreserve0 : 0 ≤ finiteWeightedRootShadowTailReserve eta d :=
    Real.rpow_nonneg hdpos.le _
  have hleft : 2 * (q : ℝ) * (T : ℝ) *
      finiteWeightedRootShadowTailReserve eta d ≤
        10 * N * finiteWeightedRootShadowTailReserve eta d := by
    have hT0 : 0 ≤ (T : ℝ) := Nat.cast_nonneg T
    have hqt : 2 * (q : ℝ) * (T : ℝ) ≤ 10 * N := by
      nlinarith
    exact mul_le_mul_of_nonneg_right hqt hreserve0
  have hcontract := finiteWeightedRootShadow_contraction_reserve_scale E S
  have hscaled : 10 * N * finiteWeightedRootShadowTailReserve eta d ≤
      N / 512 * Real.rpow d
        (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := by
    have hNdiv0 : 0 ≤ N / 512 := div_nonneg hNpos.le (by norm_num)
    have hmul := mul_le_mul_of_nonneg_left hcontract hNdiv0
    calc
      10 * N * finiteWeightedRootShadowTailReserve eta d =
          (N / 512) *
            (5120 * finiteWeightedRootShadowTailReserve eta d) := by ring
      _ ≤ (N / 512) *
          Real.rpow d (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := hmul
      _ = N / 512 * Real.rpow d
          (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := rfl
  have hidentity :
      localSpreadAvailableFloor eta d N *
          finiteWeightedRootShadowStepFactor eta d =
        N / 512 * Real.rpow d
          (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := by
    rw [localSpreadAvailableFloor_eq_rpow hdpos]
    unfold finiteWeightedRootShadowStepFactor
    calc
      (N * Real.rpow d
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) / 512) *
          Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16) =
          N / 512 *
            (Real.rpow d
                (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) *
              Real.rpow d (-1 + CFMNumeric.coreEpsilon eta / 16)) := by ring
      _ = N / 512 * Real.rpow d
          ((1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) +
            (-1 + CFMNumeric.coreEpsilon eta / 16)) := by
        exact congrArg (fun z : ℝ ↦ N / 512 * z)
          (Real.rpow_add hdpos
            (1 - CFMNumeric.coreEpsilon eta / 32 - eta ^ 3)
            (-1 + CFMNumeric.coreEpsilon eta / 16)).symm
      _ = N / 512 * Real.rpow d
          (CFMNumeric.coreEpsilon eta / 32 - eta ^ 3) := by
        congr 2
        ring
  rw [hidentity]
  exact hleft.trans hscaled

theorem finiteWeightedRootShadow_contract
    {eta Gamma d N d₀ : ℝ} {T q rootCard selected : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N)
    (hq : q ≤ 5) (hd₀ : 0 ≤ d₀) (hselected : 1 ≤ selected) :
    (T : ℝ) * finiteWeightedRootShadowDrift eta d N d₀
        q rootCard selected * finiteWeightedRootShadowTailReserve eta d ≤
      finiteWeightedRootShadowMargin eta d d₀ rootCard selected := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (div_pos (Real.rpow_pos_of_pos hd eta) (by norm_num)).trans_le hN
  have hfloor : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  exact finiteWeightedRootShadowContract_of_scale hd hd₀ hselected hfloor
    (finiteWeightedRootShadow_available_scale E S hN hT hq)

theorem finiteWeightedRootShadow_reserve_one
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    1 ≤ finiteWeightedRootShadowTailReserve eta d := by
  have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
  have heps : 0 ≤ CFMNumeric.coreEpsilon eta / 64 := by
    unfold CFMNumeric.coreEpsilon CFMRegularization.rawRegularizationEps
    nlinarith [E.eta_pos]
  calc
    (1 : ℝ) = Real.rpow d 0 := (Real.rpow_zero d).symm
    _ ≤ Real.rpow d (CFMNumeric.coreEpsilon eta / 64) :=
      Real.rpow_le_rpow_of_exponent_le hd heps
    _ = finiteWeightedRootShadowTailReserve eta d := rfl

theorem finiteWeightedRootShadowInitialGap
    {Profile : Type*} {familyRank activeRank : Profile → ℕ}
    {seed : Profile → Hypergraph V}
    (H : Hypergraph V) (X : Profile → ConflictSystem V)
    (a : Profile → TestWeight V) (d₀ : Profile → ℝ)
    (eta d N : ℝ)
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    localSpreadUpperError (finiteWeightedRootShadowWeight X a c)
        c.selected.1
        (finiteWeightedRootShadowCap eta d N (d₀ c.profile)
          (familyRank c.profile) c.root.card c.selected.1) 0 ∅ ≤
      -finiteWeightedRootShadowMargin eta d (d₀ c.profile)
        c.root.card c.selected.1 := by
  unfold localSpreadUpperError finiteWeightedRootShadowCap
  have htotal : testTotal (finiteWeightedRootShadowWeight X a c) ∅
      c.selected.1 = 0 := by
    unfold testTotal
    have hselectedNat : 0 < c.selected.1 := by
      have hselectedPos := c.selected_pos
      omega
    have hempty : (∅ : Hypergraph V).powersetCard c.selected.1 = ∅ :=
      (powersetCard_eq_empty).2 (by simpa using hselectedNat)
    rw [hempty]
    simp
  rw [htotal]
  norm_num

theorem finiteWeightedRootShadowStrongTail_of_ratio
    {eta d t denominator : ℝ}
    (hratio : 100 * Real.rpow d (CFMNumeric.tailPower eta) ≤
      t ^ 2 / (4 * denominator)) :
    Real.exp (-(t ^ 2) / (4 * denominator)) ≤
      finiteWeightedRootShadowStrongTail eta d := by
  unfold finiteWeightedRootShadowStrongTail
  apply Real.exp_le_exp.mpr
  rw [show -t ^ 2 / (4 * denominator) =
    -(t ^ 2 / (4 * denominator)) by ring]
  exact neg_le_neg hratio

theorem finiteWeightedRootShadowFirstFailureMass_le
    [Fintype V] {Profile I : Type*} [Fintype Profile] [Fintype I]
    {eta Gamma d N : ℝ} {T : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ)
    (P : I → ℕ → Hypergraph V → Prop)
    (coordinate : FiniteWeightedRootShadowCoordinate H Profile activeRank seed → I)
    (hspread : ∀ b, IsWeightedRealSpread
      (X b) (a b) (familyRank b) (d₀ b) d⁻¹)
    (hrank : ∀ b, familyRank b ≤ 5)
    (hd₀ : ∀ b, 0 < d₀ b)
    (hzero : ∀ b (root : Hypergraph V), root ⊆ H →
      seed b ⊆ root → root.card ≤ activeRank b →
      weightedCodegree (X b) (a b) root ≤
        finiteWeightedRootShadowZeroScale d (d₀ b) root.card)
    (hN : Real.rpow d eta / 2 ≤ N) (hT : (T : ℝ) ≤ N)
    (havailable : ∀ k, k < T → ∀ M, indexedGreedyGood P k M →
      localSpreadAvailableFloor eta d N ≤
        ((availableEdges H C M).card : ℝ))
    (hcomponent : ∀ c k M, P (coordinate c) k M ↔
      finiteWeightedRootShadowPredicate H familyRank activeRank seed X a eta d N d₀ c k M)
    (c : FiniteWeightedRootShadowCoordinate H Profile activeRank seed) :
    Freedman.eventMass (greedyPathMassFrom H C ∅)
        (greedyFirstFailureEvent H C ∅ T P (coordinate c)) ≤
      finiteWeightedRootShadowStrongTail eta d := by
  cases T with
  | zero =>
      have htail0 : 0 ≤ finiteWeightedRootShadowStrongTail eta d := by
        unfold finiteWeightedRootShadowStrongTail
        exact Real.exp_nonneg _
      simpa [greedyFirstFailureEvent, Freedman.eventMass] using htail0
  | succ T =>
      have hTone : 1 ≤ T + 1 := by omega
      have hd : 1 ≤ d := le_trans (by norm_num) S.degreeAtLeastTwo
      have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
      have hNpos : 0 < N :=
        (div_pos (Real.rpow_pos_of_pos hdpos eta) (by norm_num)).trans_le hN
      have hfloor : 0 < localSpreadAvailableFloor eta d N := by
        rw [localSpreadAvailableFloor_eq_rpow hdpos]
        exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hdpos _)) (by norm_num)
      let margin := finiteWeightedRootShadowMargin eta d (d₀ c.profile)
        c.root.card c.selected.1
      let jump := finiteWeightedRootShadowJump eta d (d₀ c.profile)
        c.root.card c.selected.1
      let drift := finiteWeightedRootShadowDrift eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1
      let range := finiteWeightedRootShadowRange eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1
      let variance := finiteWeightedRootShadowVariance eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1
      let cap := finiteWeightedRootShadowCap eta d N (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1
      have hreserve := finiteWeightedRootShadow_reserve_one E S
      have hcontract : ∀ c' :
          FiniteWeightedRootShadowCoordinate H Profile activeRank seed,
          ((T + 1 : ℕ) : ℝ) *
              finiteWeightedRootShadowDrift eta d N (d₀ c'.profile)
                (familyRank c'.profile) c'.root.card c'.selected.1 *
              finiteWeightedRootShadowTailReserve eta d ≤
            finiteWeightedRootShadowMargin eta d (d₀ c'.profile)
              c'.root.card c'.selected.1 := by
        intro c'
        exact finiteWeightedRootShadow_contract E S hN hT
          (hrank c'.profile) (hd₀ c'.profile).le c'.selected_pos
      have hcorr : ∀ k M, indexedGreedyGood P k M →
          ∀ c' : FiniteWeightedRootShadowCoordinate H Profile activeRank seed,
            finiteWeightedRootShadowPredicate H familyRank activeRank seed X a eta d N d₀
              c' k M := by
        intro k M hgood c'
        exact (hcomponent c' k M).mp (hgood (coordinate c'))
      have hsource := finiteWeightedRootShadowConcreteSourceBudgets
        H C familyRank activeRank seed X a d₀ eta d N (indexedGreedyGood P) (T + 1)
        hspread hd (fun b ↦ (hd₀ b).le) hzero hfloor havailable
          hcorr hcontract hreserve c
      have hzeroScalePos : 0 < finiteWeightedRootShadowZeroScale d
          (d₀ c.profile) c.root.card := by
        unfold finiteWeightedRootShadowZeroScale
        exact mul_pos (hd₀ c.profile) (pow_pos (inv_pos.mpr hdpos) _)
      have hstepPos : 0 < finiteWeightedRootShadowStepFactor eta d :=
        Real.rpow_pos_of_pos hdpos _
      have hmargin : 0 < margin := by
        dsimp only [margin]
        unfold finiteWeightedRootShadowMargin
        exact mul_pos hzeroScalePos (pow_pos hstepPos _)
      have hjump : 0 < jump := by
        dsimp only [jump]
        unfold finiteWeightedRootShadowJump finiteWeightedRootShadowZeroScale
        exact mul_pos
          (mul_pos (by norm_num)
            (mul_pos (hd₀ c.profile) (pow_pos (inv_pos.mpr hdpos) _)))
          (pow_pos hstepPos _)
      have hdrift : 0 ≤ drift := by
        dsimp only [drift]
        unfold finiteWeightedRootShadowDrift finiteWeightedRootShadowAggregateBudget
        positivity
      have hrange : 0 < range := by
        dsimp only [range]
        unfold finiteWeightedRootShadowRange
        linarith
      have hvariance : 0 ≤ variance := by
        dsimp only [variance]
        unfold finiteWeightedRootShadowVariance
        exact mul_nonneg (mul_nonneg (by norm_num) hrange.le) hmargin.le
      have hden : 0 < variance + range * margin := by
        nlinarith [mul_pos hrange hmargin]
      have htime : ((T + 1 : ℕ) : ℝ) * drift ≤ margin := by
        have hc := hcontract c
        calc
          ((T + 1 : ℕ) : ℝ) * drift ≤
              (((T + 1 : ℕ) : ℝ) * drift) *
                finiteWeightedRootShadowTailReserve eta d := by
            apply le_mul_of_one_le_right
            · exact mul_nonneg (Nat.cast_nonneg _) hdrift
            · exact hreserve
          _ ≤ margin := by simpa [margin, drift, mul_assoc] using hc
      have hdriftReserve : drift * finiteWeightedRootShadowTailReserve eta d ≤
          margin := by
        exact finiteWeightedRootShadowDrift_mul_reserve_le_margin_of_contract
          hdpos.le (by simpa [drift] using hdrift) hTone
            (by simpa [margin, drift] using hcontract c)
      have hjumpReserve : jump * finiteWeightedRootShadowTailReserve eta d ≤
          2 * margin := by
        exact finiteWeightedRootShadowJump_mul_reserve_le_two_margin hd
          (by
            unfold CFMNumeric.coreEpsilon CFMRegularization.rawRegularizationEps
            nlinarith [E.eta_pos])
          (hd₀ c.profile).le c.selected_pos
      have hratio : 100 * Real.rpow d (CFMNumeric.tailPower eta) ≤
          margin ^ 2 / (4 * (variance + range * margin)) := by
        have hratio' := finiteWeightedRootShadowFreedmanRatio
          (tau := Real.rpow d (CFMNumeric.tailPower eta))
          (reserve := finiteWeightedRootShadowTailReserve eta d)
          (margin := margin) (jump := jump) (drift := drift)
          (Real.rpow_nonneg hdpos.le _)
          (Real.rpow_pos_of_pos hdpos _) hmargin hjump.le hdrift
          (by simpa [range, finiteWeightedRootShadowRange] using hrange)
          hjumpReserve hdriftReserve
          (finiteWeightedRootShadow_tail_reserve_scale E S)
        simpa [variance, range, finiteWeightedRootShadowVariance,
          finiteWeightedRootShadowRange] using hratio'
      have hraw : Freedman.eventMass (greedyPathMassFrom H C ∅)
          (greedyFirstFailureEvent H C ∅ (T + 1) P (coordinate c)) ≤
          Real.exp (-(margin ^ 2) / (4 * (variance + range * margin))) := by
        apply localSpreadUpperFirstFailureMass_le_of_sourceBudgets
          (finiteWeightedRootShadowWeight X a c) H C ∅ (T + 1) P
          (coordinate c) c.selected.1 cap (fun _ ↦ jump) hsource
          hrange.le hmargin.le hvariance hden
        · intro k hk
          rw [show cap (k + 1) - cap k = drift by
            exact finiteWeightedRootShadowCap_step _ _ _ _ _ _ _ _]
          rfl
        · simpa [variance, cap, jump, drift, margin, range] using
            (finiteWeightedRootShadowVariance_sum_le
              (T := T + 1) (eta := eta) (d := d) (N := N)
              (d₀ := d₀ c.profile) (q := familyRank c.profile)
              (rootCard := c.root.card) (selected := c.selected.1)
              hdrift hjump.le htime)
        · intro k M
          exact hcomponent c k M
        · simpa [cap, margin] using
            (finiteWeightedRootShadowInitialGap H X a d₀ eta d N c)
      exact hraw.trans (finiteWeightedRootShadowStrongTail_of_ratio hratio)

theorem finiteWeightedRootShadowStrongTailFamilySum_le_twelfth
    {I : Type*} [Fintype I] {eta Gamma d K : ℝ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (t : I → ℝ)
    (hK : K ≤ 2400)
    (hcard : (Fintype.card I : ℝ) ≤
      Real.exp (K * Real.rpow d (eta ^ 3)))
    (ht : ∀ i, t i ≤ finiteWeightedRootShadowStrongTail eta d) :
    (∑ i, t i) ≤ 1 / 12 := by
  let tau := Real.rpow d (CFMNumeric.tailPower eta)
  let y := K * Real.rpow d (eta ^ 3)
  have hbase0 : 0 ≤ Real.rpow d (eta ^ 3) :=
    Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have htau0 : 0 ≤ tau :=
    Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have hy : y ≤ 50 * tau := by
    dsimp only [y, tau]
    calc
      K * Real.rpow d (eta ^ 3) ≤
          2400 * Real.rpow d (eta ^ 3) :=
        mul_le_mul_of_nonneg_right hK hbase0
      _ = 50 * (48 * Real.rpow d (eta ^ 3)) := by ring
      _ ≤ 50 * Real.rpow d (CFMNumeric.tailPower eta) := by
        gcongr
        exact S.entropyPower
  have hlog : Real.log 12 ≤ 50 * tau := by
    have hlog' : 4 * Real.log 12 ≤ tau := by
      simpa [tau] using S.entropyLog
    nlinarith [htau0]
  have hexp : Real.exp (y - 100 * tau) ≤ 1 / 12 := by
    calc
      Real.exp (y - 100 * tau) ≤ Real.exp (-Real.log 12) := by
        apply Real.exp_le_exp.mpr
        nlinarith
      _ = 1 / 12 := by
        rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 12)]
        norm_num
  calc
    (∑ i, t i) ≤ ∑ _i : I, finiteWeightedRootShadowStrongTail eta d :=
      Finset.sum_le_sum fun i _ ↦ ht i
    _ = (Fintype.card I : ℝ) * Real.exp (-(100 * tau)) := by
      simp [finiteWeightedRootShadowStrongTail, tau]
    _ ≤ Real.exp y * Real.exp (-(100 * tau)) := by
      gcongr
    _ = Real.exp (y - 100 * tau) := by
      rw [← Real.exp_add]
      congr 1
    _ ≤ 1 / 12 := hexp

/-- A component whose corridor is implied by another component cannot fail
without the stronger component failing at the same first-failure time.  This
is the adapter needed when an older endpoint coordinate is retained in the
outer `Sum` but is dominated by a new weighted root-shadow profile. -/
theorem greedyFirstFailureEvent_subset_of_component_implication
    {I : Type*} [Fintype I]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop) (weak strong : I)
    (himp : ∀ k S, P strong k S → P weak k S) :
    greedyFirstFailureEvent H C M T P weak ⊆
      greedyFirstFailureEvent H C M T P strong := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega ⊢
  obtain ⟨homegaUniv, k, hk, hprefix, hfail⟩ := homega
  exact ⟨homegaUniv, k, hk, hprefix, fun hstrong ↦
    hfail (himp (k + 1) (greedyStateFromAt H C M omega (k + 1)) hstrong)⟩

theorem localSpreadUpperCorridor_mono_cap
    (w : TestWeight V) (n : ℕ) (capStrong capWeak : ℕ → ℝ)
    {k : ℕ} {M : Hypergraph V}
    (hcap : capStrong k ≤ capWeak k)
    (hstrong : localSpreadUpperCorridor w n capStrong k M) :
    localSpreadUpperCorridor w n capWeak k M := by
  unfold localSpreadUpperCorridor localSpreadUpperError at hstrong ⊢
  linarith

theorem firstFailureMass_le_of_component_implication
    {I : Type*} [Fintype I]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop) (weak strong : I)
    (himp : ∀ k S, P strong k S → P weak k S) :
    Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T P weak) ≤
      Freedman.eventMass (greedyPathMassFrom H C M)
        (greedyFirstFailureEvent H C M T P strong) := by
  exact eventMass_mono_of_nonneg (greedyPathMassFrom H C M)
    (greedyPathMassFrom_nonneg H C M)
    (greedyFirstFailureEvent_subset_of_component_implication
      H C M T P weak strong himp)

/-! ## No-premise projections from the final degree-plus-test Good family

The concrete test-profile enumeration is deliberately kept outside this
generic file.  Once its five data functions are supplied, this is the
canonical outer `Sum`: the already-closed degree-enhanced family is on the
left and every legal weighted root shadow is on the right. -/

abbrev FiniteWeightedRootShadowEnhancedIndex
    {iota Profile : Type*} (H : Hypergraph V) (j : iota → ℕ)
    (activeRank : Profile → ℕ) (seed : Profile → Hypergraph V) :=
  Sum (DegreeEnhancedGreedyIndex H j)
    (FiniteWeightedRootShadowCoordinate H Profile activeRank seed)

noncomputable def finiteWeightedRootShadowEnhancedPredicate
    {iota Profile : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ) :
    FiniteWeightedRootShadowEnhancedIndex H j activeRank seed →
      ℕ → Hypergraph V → Prop
  | Sum.inl z, k, M => degreeEnhancedGreedyPredicate H C
      D₂ D₃ D₄ Gamma eta d N T j w z k M
  | Sum.inr c, k, M => finiteWeightedRootShadowPredicate
      H familyRank activeRank seed X a eta d (N : ℝ) d₀ c k M

