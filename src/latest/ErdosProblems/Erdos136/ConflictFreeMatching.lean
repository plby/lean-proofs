/-- The exact sharp mean-multiplicity expression is at most its source
`1/N` scale.  The only non-scalar input is the available-edge handshake
lower bound supplied by the reachable degree corridor. -/
theorem originalTestMeanMultiplicity_le_source
    {D₂ D₃ D₄ Gamma eta d N W a : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hW : 0 ≤ W)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
          d N (k : ℝ)) ≤ a) :
    ((((s + 1 : ℕ) : ℝ) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j (s + 1) (k : ℝ))) +
        ((s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k) *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)))) / a) ≤
      160000 * Gamma * W *
        d ^ ((s : ℝ) - j +
          59 * CFMNumeric.coreEpsilon eta / 1600 + eta ^ 3) / N := by
  let eps := CFMNumeric.coreEpsilon eta
  let x : ℝ := k
  let I := CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s x
  let Ip := CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j (s + 1) x
  let Z := CFMTrajectories.zHat D₂ D₃ D₄ d N j s x
  let Zp := CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) x
  let Env := CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j s x
  let Envp := CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j (s + 1) x
  let status := certificateTestStatusHi D₂ D₃ D₄ Gamma eps d N k
  let D := CFMTrajectories.dHat D₂ D₃ D₄ d N x
  let p := CFMTrajectories.pV N x
  let h := CFMTrajectories.hHat D₂ D₃ D₄ d N x
  let b : ℝ := (s : ℝ) - j
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hN := R.delta.degree.N_pos
  have hp : 0 < p := by
    dsimp only [p]
    exact CFMTrajectories.pV_pos hN (R.delta.degree.before_end x hx)
  have hm := CFMTrajectories.pM_nonneg hd hN
    (R.delta.degree.time_nonneg x hx)
  have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
  have hD : 0 < D := by
    dsimp only [D]
    exact CFMTrajectories.dHat_pos hd hp
  have hI0 : 0 ≤ I := by
    dsimp only [I]
    exact testInside_nonneg_at hG0 hd hp hm
  have hIp0 : 0 ≤ Ip := by
    dsimp only [Ip]
    exact testInside_nonneg_at hG0 hd hp hm
  have hsum : Z + Env ≤ 2 * I := by
    dsimp only [Z, Env, I, eps, x]
    exact observableUpper_le_two_inside S R
  have hsumP : Zp + Envp ≤ 2 * Ip := by
    have hxi := (R.delta.xi_upper x hx).trans
      (CFMNumeric.envelopeFactor_le_fifth S)
    have hxiOne : CFMTrajectories.xi Gamma eps d N x ≤ 1 :=
      hxi.trans (by norm_num)
    have hZp0 : 0 ≤ Zp := by
      dsimp only [Zp]
      exact zHat_nonneg_at hp hm
    have hZpIp : Zp ≤ Ip := by
      dsimp only [Zp, Ip]
      unfold CFMTrajectories.testInside
      apply le_add_of_nonneg_right
      exact div_nonneg
        (mul_nonneg (Nat.cast_nonneg _)
          (pow_nonneg (CFMTrajectories.dHat_pos hd hp).le _))
        (mul_nonneg (mul_nonneg (by norm_num) hG0)
          (pow_nonneg hd.le _))
    have hEnvp : Envp ≤ Ip := by
      change CFMTrajectories.xi Gamma eps d N x * Ip ≤ Ip
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hxiOne hIp0
    linarith
  have hDle : D ≤ d := by
    dsimp only [D, p] at hD ⊢
    exact CFMTrajectories.dHat_le_d hd.le hp.le
      (CFMTrajectories.pV_le_one hN (R.delta.degree.time_nonneg x hx)) (by
        exact CFMTrajectories.GammaHat_nonneg
          R.delta.degree.D₂_nonneg R.delta.degree.D₃_nonneg
          R.delta.degree.D₄_nonneg hm)
  have hsucc : ((s + 1 : ℕ) : ℝ) * Ip ≤ 160 * Gamma * D * I := by
    dsimp only [Ip, I, D]
    exact CFMTrajectories.testInside_successor_le hd hN E.Gamma_one
      (R.delta.degree.time_nonneg x hx) (R.delta.degree.before_end x hx)
      R.delta.degree.D₂_nonneg R.delta.degree.D₃_nonneg R.delta.degree.D₄_nonneg
      R.s_le_j R.j_le_four
  have hplus : ((s + 1 : ℕ) : ℝ) * (W * (Zp + Envp)) ≤
      320 * Gamma * d * W * I := by
    have hmul : (((s + 1 : ℕ) : ℝ) * W) * (Zp + Envp) ≤
        (((s + 1 : ℕ) : ℝ) * W) * (2 * Ip) :=
      mul_le_mul_of_nonneg_left hsumP
        (mul_nonneg (Nat.cast_nonneg (s + 1)) hW)
    have hsuccW := mul_le_mul_of_nonneg_left hsucc hW
    have hDmul : Gamma * D * W * I ≤ Gamma * d * W * I := by
      gcongr
    calc
      ((s + 1 : ℕ) : ℝ) * (W * (Zp + Envp)) ≤
          ((s + 1 : ℕ) : ℝ) * (W * (2 * Ip)) := by
            simpa only [mul_assoc] using hmul
      _ = 2 * W * (((s + 1 : ℕ) : ℝ) * Ip) := by ring
      _ ≤ 2 * W * (160 * Gamma * D * I) := by gcongr
      _ = 320 * (Gamma * D * W * I) := by ring
      _ ≤ 320 * (Gamma * d * W * I) := by gcongr
      _ = 320 * Gamma * d * W * I := by ring
  have hs4 : (s : ℝ) ≤ 4 := by exact_mod_cast R.s_le_j.trans R.j_le_four
  have hstatus : status ≤ 18 * Gamma * d := by
    dsimp only [status, eps]
    exact CFMSharpTestCutoff.certificateTestStatusHi_le_eighteenGamma_mul_d
      E S R.delta
  have hstatus0 : 0 ≤ status := by
    dsimp only [status, eps]
    exact certificateTestStatusHi_nonneg_of_registry R.delta
  have hcur : ((s : ℝ) * status) * (W * (Z + Env)) ≤
      144 * Gamma * d * W * I := by
    have hsstatus : (s : ℝ) * status ≤ 72 * Gamma * d := by
      calc
        (s : ℝ) * status ≤ 4 * status :=
          mul_le_mul_of_nonneg_right hs4 hstatus0
        _ ≤ 4 * (18 * Gamma * d) :=
          mul_le_mul_of_nonneg_left hstatus (by norm_num)
        _ = 72 * Gamma * d := by ring
    have hmul := mul_le_mul hsstatus hsum
      (add_nonneg (by
        dsimp only [Z]
        exact zHat_nonneg_at hp hm) (by
          dsimp only [Env]
          exact (CFMTrajectories.zeta_pos
            (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
            (Gamma := Gamma) (epsilon := eps)
            hd (lt_of_lt_of_le zero_lt_one E.Gamma_one)
            hp hm R.s_le_j).le))
      (mul_nonneg (mul_nonneg (by norm_num) hG0) hd.le)
    have hmulW := mul_le_mul_of_nonneg_left hmul hW
    calc
      ((s : ℝ) * status) * (W * (Z + Env)) =
          W * (((s : ℝ) * status) * (Z + Env)) := by ring
      _ ≤ W * ((72 * Gamma * d) * (2 * I)) := hmulW
      _ = 144 * Gamma * d * W * I := by ring
  have hnum : ((s + 1 : ℕ) : ℝ) * (W * (Zp + Envp)) +
        ((s : ℝ) * status) * (W * (Z + Env)) ≤
      500 * Gamma * d * W * I := by
    have hbase0 : 0 ≤ Gamma * d * W * I := by positivity
    nlinarith
  have hI : I ≤ d ^ (b + 9 * eps / 1600) := by
    dsimp only [I, b, eps, x]
    exact R.inside_upper x hx
  have hnumPow : ((s + 1 : ℕ) : ℝ) * (W * (Zp + Envp)) +
        ((s : ℝ) * status) * (W * (Z + Env)) ≤
      500 * Gamma * d * W * d ^ (b + 9 * eps / 1600) := by
    exact hnum.trans (mul_le_mul_of_nonneg_left hI (by positivity))
  have hxi := (R.delta.xi_upper x hx).trans
    (CFMNumeric.envelopeFactor_le_fifth S)
  have hh : 0 < h := by
    dsimp only [h]
    exact CFMTrajectories.hHat_pos hd hN hp
  have ha : N * p * D / 10 ≤ a := by
    have hfour : (4 / 5 : ℝ) * h ≤ a := by
      have hm := mul_le_mul_of_nonneg_left hxi hh.le
      dsimp only [h, p, eps, x] at haLo ⊢
      nlinarith
    have hid : h = N * p * D / 8 := by
      dsimp only [h, p, D]
      unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
      ring
    rw [hid] at hfour
    nlinarith
  have haPos : 0 < a := (div_pos (mul_pos (mul_pos hN hp) hD) (by norm_num)).trans_le ha
  have hpFloor : d ^ (-eta ^ 3) / 32 ≤ p := by
    have hpF := R.delta.degree.pV_floor x hx
    dsimp only [p, CFMNumeric.trajectoryFloor, CFMNumeric.publicError] at hpF ⊢
    exact hpF
  have hDlo : d ^ (1 - eps / 32) ≤ D := by
    dsimp only [D, eps]
    exact R.delta.dHat_lower x hx
  have hpd : (d ^ (-eta ^ 3) / 32) * d ^ (1 - eps / 32) ≤ p * D :=
    mul_le_mul hpFloor hDlo (Real.rpow_nonneg hd.le _) hp.le
  have hcross : 500 * Gamma * d * W * d ^ (b + 9 * eps / 1600) ≤
      (160000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) / N) *
        (N * p * D / 10) := by
    have hcoef0 : 0 ≤ 16000 * Gamma * W *
        d ^ (b + 59 * eps / 1600 + eta ^ 3) := by positivity
    have hm := mul_le_mul_of_nonneg_left hpd hcoef0
    have hdcombine : d * d ^ (b + 9 * eps / 1600) =
        d ^ (1 + (b + 9 * eps / 1600)) := by
      calc
        d * d ^ (b + 9 * eps / 1600) =
            d ^ (1 : ℝ) * d ^ (b + 9 * eps / 1600) := by
          rw [Real.rpow_one]
        _ = d ^ (1 + (b + 9 * eps / 1600)) :=
          (Real.rpow_add hd (1 : ℝ) (b + 9 * eps / 1600)).symm
    calc
      500 * Gamma * d * W * d ^ (b + 9 * eps / 1600) =
          500 * Gamma * W * d ^ (1 + (b + 9 * eps / 1600)) := by
            calc
              500 * Gamma * d * W * d ^ (b + 9 * eps / 1600) =
                  500 * Gamma * W * (d * d ^ (b + 9 * eps / 1600)) := by ring
              _ = 500 * Gamma * W * d ^ (1 + (b + 9 * eps / 1600)) :=
                congrArg (fun z : ℝ ↦ 500 * Gamma * W * z) hdcombine
      _ = 500 * Gamma * W * d ^
          ((b + 59 * eps / 1600 + eta ^ 3) + (-eta ^ 3) +
            (1 - eps / 32)) := by
              congr 1
              ring_nf
      _ = 500 * Gamma * W *
          (d ^ (b + 59 * eps / 1600 + eta ^ 3) * d ^ (-eta ^ 3) *
            d ^ (1 - eps / 32)) := by
              rw [Real.rpow_add hd, Real.rpow_add hd]
      _ = 16000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) *
          ((d ^ (-eta ^ 3) / 32) * d ^ (1 - eps / 32)) := by ring
      _ ≤ 16000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) *
          (p * D) := hm
      _ = (160000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) / N) *
          (N * p * D / 10) := by
            field_simp [ne_of_gt hN]
            ring
  apply (div_le_iff₀ haPos).2
  calc
    ((s + 1 : ℕ) : ℝ) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j (s + 1) (k : ℝ))) +
        ((s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma eps d N k) *
          (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j s (k : ℝ))) ≤
      500 * Gamma * d * W * d ^ (b + 9 * eps / 1600) := by
        simpa only [Z, Zp, Env, Envp, status, x] using hnumPow
    _ ≤ (160000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) / N) *
        (N * p * D / 10) := hcross
    _ ≤ (160000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) / N) * a := by
      apply mul_le_mul_of_nonneg_left ha
      positivity

/-- Multiplying the natural half-jump point cap by the sharp averaged
multiplicity remains within the canonical source variance. -/
theorem originalTestRawVariance_le_source
    {D₂ D₃ D₄ Gamma eta d N W a rawCap : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ)
        (CFMNumeric.trajectoryFloor eta d) j s)
    (hW : 0 ≤ W) (hraw0 : 0 ≤ rawCap)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (1 - CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta)
          d N (k : ℝ)) ≤ a)
    (hraw : rawCap ≤ testSourceJumpScale
      (W * d ^ ((s : ℝ) - j)) d (CFMNumeric.coreEpsilon eta) / 2) :
    rawCap *
        ((((s + 1 : ℕ) : ℝ) *
            (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
              CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                (CFMNumeric.coreEpsilon eta) d N j (s + 1) (k : ℝ))) +
          ((s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N k) *
              (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
                CFMTrajectories.zeta D₂ D₃ D₄ Gamma
                  (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)))) / a) ≤
      testSourceVarianceScale (W * d ^ ((s : ℝ) - j)) d
        (CFMNumeric.coreEpsilon eta) N := by
  let eps := CFMNumeric.coreEpsilon eta
  let b : ℝ := (s : ℝ) - j
  let base : ℝ := W * d ^ ((s : ℝ) - j)
  let extra : ℝ := 59 * eps / 1600 + eta ^ 3
  let meanTerm : ℝ :=
    ((((s + 1 : ℕ) : ℝ) *
        (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j (s + 1) (k : ℝ))) +
      ((s : ℝ) * certificateTestStatusHi D₂ D₃ D₄ Gamma eps d N k) *
        (W * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps d N j s (k : ℝ)))) / a)
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hN := R.delta.degree.N_pos
  have hmean : meanTerm ≤
      160000 * Gamma * W * d ^ (b + 59 * eps / 1600 + eta ^ 3) / N := by
    dsimp only [meanTerm, b, eps]
    exact originalTestMeanMultiplicity_le_source E S R hW haLo
  have hmeanBase : meanTerm ≤
      160000 * Gamma * base * d ^ extra / N := by
    calc
      meanTerm ≤ 160000 * Gamma * W *
          d ^ (b + 59 * eps / 1600 + eta ^ 3) / N := hmean
      _ = 160000 * Gamma * base * Real.rpow d extra / N := by
        have hexp : b + 59 * eps / 1600 + eta ^ 3 = b + extra := by
          dsimp only [extra]
          ring
        rw [hexp, Real.rpow_add hd]
        simp only [Real.rpow_eq_pow]
        dsimp only [base, b]
        ring
  have hmean0 : 0 ≤ meanTerm := by
    dsimp only [meanTerm]
    have haPos : 0 < a := by
      have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
      have hp := CFMTrajectories.pV_pos hN
        (R.delta.degree.before_end (k : ℝ) hx)
      have hh := CFMTrajectories.hHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
        hd hN hp
      have hxi := (R.delta.xi_upper (k : ℝ) hx).trans
        (CFMNumeric.envelopeFactor_le_fifth S)
      have hfour : (4 / 5 : ℝ) *
          CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) ≤ a := by
        have hm := mul_le_mul_of_nonneg_left hxi hh.le
        nlinarith
      exact (mul_pos (by norm_num) hh).trans_le hfour
    apply div_nonneg _ haPos.le
    have hm := CFMTrajectories.pM_nonneg hd hN (by
      exact R.delta.degree.time_nonneg (k : ℝ) (by simp))
    have hp := CFMTrajectories.pV_pos hN (by
      exact R.delta.degree.before_end (k : ℝ) (by simp))
    have hstatus0 : 0 ≤ certificateTestStatusHi D₂ D₃ D₄ Gamma eps d N k := by
      exact certificateTestStatusHi_nonneg_of_registry R.delta
    have hZ0 : 0 ≤ CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) := by
      exact zHat_nonneg_at hp hm
    have hZp0 : 0 ≤ CFMTrajectories.zHat D₂ D₃ D₄ d N j (s + 1) (k : ℝ) := by
      exact zHat_nonneg_at hp hm
    have hE0 := (CFMTrajectories.zeta_pos
      (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := eps)
      hd (lt_of_lt_of_le zero_lt_one E.Gamma_one)
      hp hm R.s_le_j).le
    have hEp0 : 0 ≤ CFMTrajectories.zeta D₂ D₃ D₄ Gamma eps
        d N j (s + 1) (k : ℝ) := by
      change 0 ≤ CFMTrajectories.xi Gamma eps d N (k : ℝ) *
        CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j (s + 1) (k : ℝ)
      exact mul_nonneg (CFMTrajectories.xi_pos hd hp).le
        (testInside_nonneg_at
          (le_trans zero_le_one E.Gamma_one) hd hp hm)
    positivity
  have hrawBound : rawCap ≤
      base * d ^ (-eps / 4) / 2 := by
    dsimp only [base, eps]
    simpa only [testSourceJumpScale, Real.rpow_eq_pow] using hraw
  have hrawBound0 : 0 ≤
      base * d ^ (-eps / 4) / 2 := by
    have hbase0 : 0 ≤ base := by
      dsimp only [base]
      exact mul_nonneg hW (Real.rpow_nonneg hd.le _)
    exact div_nonneg (mul_nonneg hbase0 (Real.rpow_nonneg hd.le _)) (by norm_num)
  have hprod := mul_le_mul hrawBound hmeanBase hmean0 hrawBound0
  have hcoefExp : 80000 * Gamma ≤
      d ^ (eps / 512 - 7 * eta ^ 3) := by
    have hG0 : 0 ≤ Gamma := le_trans zero_le_one E.Gamma_one
    have hGammaExp : Gamma ≤ Real.exp (3 * Gamma) := by
      have h1 := Real.add_one_le_exp Gamma
      have hExpMono : Real.exp Gamma ≤ Real.exp (3 * Gamma) := by
        apply Real.exp_le_exp.mpr
        nlinarith [E.Gamma_one]
      linarith
    calc
      80000 * Gamma ≤ (32 : ℝ) ^ (7 : ℕ) * Gamma :=
        mul_le_mul_of_nonneg_right (by norm_num) hG0
      _ ≤ (32 : ℝ) ^ (7 : ℕ) * Real.exp (3 * Gamma) :=
        mul_le_mul_of_nonneg_left hGammaExp (by positivity)
      _ ≤ d ^ (eps / 512 - 7 * eta ^ 3) := by
        simpa only [eps] using S.testHazardAbsorption
  have hfactor : 80000 * Gamma *
        d ^ (-eps / 4 + 59 * eps / 1600 + eta ^ 3) ≤
      d ^ (-3 * eps / 16) := by
    have hpow0 : 0 ≤ d ^
        (-eps / 4 + 59 * eps / 1600 + eta ^ 3) :=
      Real.rpow_nonneg hd.le _
    calc
      80000 * Gamma * d ^ (-eps / 4 + 59 * eps / 1600 + eta ^ 3) ≤
          d ^ (eps / 512 - 7 * eta ^ 3) *
            d ^ (-eps / 4 + 59 * eps / 1600 + eta ^ 3) :=
        mul_le_mul_of_nonneg_right hcoefExp hpow0
      _ = d ^ ((eps / 512 - 7 * eta ^ 3) +
          (-eps / 4 + 59 * eps / 1600 + eta ^ 3)) :=
        (Real.rpow_add hd _ _).symm
      _ ≤ d ^ (-3 * eps / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le R.delta.degree.d_one
        have heps0 : 0 ≤ eps := by
          dsimp only [eps, CFMNumeric.coreEpsilon,
            CFMRegularization.rawRegularizationEps]
          linarith [E.eta_pos]
        nlinarith [pow_nonneg E.eta_pos.le 3]
  have herrExtra : d ^ (-eps / 4) * d ^ extra =
      d ^ (-eps / 4 + 59 * eps / 1600 + eta ^ 3) := by
    calc
      d ^ (-eps / 4) * d ^ extra = d ^ (-eps / 4 + extra) :=
        (Real.rpow_add hd (-eps / 4) extra).symm
      _ = d ^ (-eps / 4 + 59 * eps / 1600 + eta ^ 3) := by
        have hexp : -eps / 4 + extra =
            -eps / 4 + 59 * eps / 1600 + eta ^ 3 := by
          dsimp only [extra]
          ring
        exact congrArg (fun z : ℝ ↦ d ^ z) hexp
  calc
    rawCap * meanTerm ≤
        (base * d ^ (-eps / 4) / 2) *
          (160000 * Gamma * base * d ^ extra / N) := hprod
    _ = base ^ 2 / N *
        (80000 * Gamma *
          d ^ (-eps / 4 + 59 * eps / 1600 + eta ^ 3)) := by
      calc
        (base * d ^ (-eps / 4) / 2) *
            (160000 * Gamma * base * d ^ extra / N) =
            base ^ 2 / N * (80000 * Gamma *
              (d ^ (-eps / 4) * d ^ extra)) := by ring
        _ = _ := congrArg
          (fun z : ℝ ↦ base ^ 2 / N * (80000 * Gamma * z)) herrExtra
    _ ≤ base ^ 2 / N *
        d ^ (-3 * eps / 16) := by
      apply mul_le_mul_of_nonneg_left hfactor
      positivity
    _ = testSourceVarianceScale (W * d ^ ((s : ℝ) - j)) d eps N := by
      unfold testSourceVarianceScale
      simp only [Real.rpow_eq_pow]
      dsimp only [base]
      ring

end CFMSharpTestExternalVarianceNumeric

end

/-! ## Integrated: SharpReachableSource -/


open Finset

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V] [Fintype V]

/-! The sharp raw-observable constructor with the exact reachability
boundary.  Pointwise jumps remain valid on every `Good` state, while the
mean and conditional square are required only on genuine time-`k`
conflict-free matchings. -/

theorem reachableExternalTestSourceBudgets_of_sharpRaw
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N Pfloor W : ℝ) (j s : ℕ)
    (jump variance rawJump rawVariance : ℕ → ℝ)
    (hw : ∀ S, 0 ≤ w S) (hj3 : j ≤ 3) (hW0 : 0 ≤ W)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) Pfloor j s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      IsConflictFreeMatching H C M → M.card = k →
      W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon
            d N j s (k : ℝ) +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
        meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      IsConflictFreeMatching H C M → M.card = k →
      meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M ≤
        W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon
            d N j s (k : ℝ) -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)))
    (hraw0 : ∀ k, 0 ≤ rawJump k)
    (hgain : ∀ k, k < T → ∀ M, Good k M →
      ∀ e ∈ availableEdges H C M,
        partialTestStepGain w H C j s M e ≤ rawJump k)
    (hloss : ∀ k, k < T → ∀ M, Good k M →
      ∀ e ∈ availableEdges H C M,
        partialTestStepLoss w H C j s M e ≤ rawJump k)
    (hrawSquare : ∀ k, k < T → ∀ M, Good k M →
      IsConflictFreeMatching H C M → M.card = k →
      meanSqPartialTestIncrement w H C j s M ≤ rawVariance k)
    (hjump : ∀ k, k < T →
      rawJump k + externalTestTrajectoryJump
        D₂ D₃ D₄ Gamma epsilon d N W j s k ≤ jump k)
    (hvariance : ∀ k, k < T →
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N W
        j s rawVariance k ≤ variance k) :
    ReachableExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N Pfloor W j s jump variance := by
  have hrawChoice : ∀ k, k < T → ∀ M, Good k M →
      ∀ o : GreedyChoice H,
        |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
          partialTestObservable w H C j s M| ≤ rawJump k := by
    intro k hk M hgood o
    rcases o with _ | e
    · simpa [greedyChoiceStep] using hraw0 k
    · by_cases he : (e : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert he,
          partialTestObservable_insert_sub_eq_gain_sub_loss w H C j s M e.1]
        rw [abs_le]
        constructor <;>
          linarith [hgain k hk M hgood e.1 he,
            hloss k hk M hgood e.1 he,
            partialTestStepGain_nonneg w H C M j s e.1 hw,
            partialTestStepLoss_nonneg w H C M j s e.1 hw]
      · simpa [greedyChoiceStep, greedyStep_eq_self he] using hraw0 k
  refine
    { arity := hj3
      weight_nonneg := hW0
      registry := hregistry
      meanLower := hmeanLower
      meanUpper := hmeanUpper
      upperJump := ?_
      lowerJump := ?_
      upperSquare := ?_
      lowerSquare := ?_ }
  · intro k hk M hgood o
    exact ((externalTestEnvelopeStep_abs_le_of_observableJump
      w H C D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s M
      (greedyChoiceStep H C M o) (hregistry k hk M hgood) hW0
      (hrawChoice k hk M hgood o)).1).trans (hjump k hk)
  · intro k hk M hgood o
    exact ((externalTestEnvelopeStep_abs_le_of_observableJump
      w H C D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s M
      (greedyChoiceStep H C M o) (hregistry k hk M hgood) hW0
      (hrawChoice k hk M hgood o)).2).trans (hjump k hk)
  · intro k hk M hgood hM hcard
    exact ((externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N W j s k M
      (hregistry k hk M hgood) hW0
      (hrawSquare k hk M hgood hM hcard)).1).trans (hvariance k hk)
  · intro k hk M hgood hM hcard
    exact ((externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N W j s k M
      (hregistry k hk M hgood) hW0
      (hrawSquare k hk M hgood hM hcard)).2).trans (hvariance k hk)

/-! Initial-gap promotions are source-polymorphic.  These reachable forms
reuse the exact deterministic empty-state identities without converting
back to the legacy all-state source structures. -/

theorem positivePairedFirstFailureSourceBudgets_of_reachableExternalNaturalScale
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N Pfloor : ℝ) (j s ell : ℕ)
    (jump variance : ℕ → ℝ)
    (hw : IsTrackable H C j ell d epsilon w)
    (hj1 : 1 ≤ j) (hj3 : j ≤ 3) (hsj : s ≤ j)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hd : 0 < d) (hGamma : 0 < Gamma)
    (B : ReachableExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N Pfloor (testTotal w H j)
      j s jump variance) :
    CFMNumericAggregation.PositivePairedFirstFailureSourceBudgets
      (externalTestNaturalScale w H d j s)
      (ReachableExternalTestSourceBudgets w H C Good T
        D₂ D₃ D₄ Gamma epsilon d N Pfloor (testTotal w H j)
        j s jump variance)
      (externalTestUpperError w H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) j s 0 ∅)
      (externalTestLowerError w H C D₂ D₃ D₄ Gamma epsilon d N
        (testTotal w H j) j s 0 ∅)
      (CFMNumericAggregation.testDeviation Gamma
        (externalTestNaturalScale w H d j s) d epsilon) := by
  have hgaps := externalTest_initial_errors_le_naturalDeviation
    w H C D₂ D₃ D₄ Gamma epsilon d N j s
      hw.isTestFunction.nonneg hsj hCcard hd hGamma
  exact
    { sourceBudgets := B
      upperGap := hgaps.1
      lowerGap := hgaps.2
      scale_pos := externalTestNaturalScale_pos_of_trackable hw hd s }

theorem positivePairedFirstFailureSourceBudgets_of_reachableInternalNaturalScale
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ GammaCore epsilonCore N Pfloor : ℝ)
    (f : Finset V) (q s : ℕ) (jump variance : ℕ → ℝ)
    (hf : f ∈ H) (hq1 : 1 ≤ q) (hq3 : q ≤ 3) (hsq : s ≤ q)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    (hcore : epsilonCore = epsRaw / 5) (hGammaCore : 0 < GammaCore)
    (B : ReachableInternalConflictLinkSourceBudgets H R.regularized f Good T
      D₂ D₃ D₄ GammaCore epsilonCore d N Pfloor
      (certificateInternalLayerScale
        H C d epsRaw GammaCert ellCert j w R (q + 1))
      q s jump variance) :
    let scale := certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (q + 1)
    let P := scale * Real.rpow d ((s : ℝ) - (q : ℝ))
    CFMNumericAggregation.PositivePairedFirstFailureSourceBudgets P
      (ReachableInternalConflictLinkSourceBudgets H R.regularized f Good T
        D₂ D₃ D₄ GammaCore epsilonCore d N Pfloor scale
        q s jump variance)
      (internalConflictLinkUpperError H R.regularized f
        D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅)
      (internalConflictLinkLowerError H R.regularized f
        D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅)
      (CFMNumericAggregation.testDeviation GammaCore P d epsilonCore) := by
  dsimp only
  let scale := certificateInternalLayerScale
    H C d epsRaw GammaCert ellCert j w R (q + 1)
  have hscale : 0 < scale := certificateInternalLayerScale_pos
    H C d epsRaw GammaCert ellCert j w R (q + 1)
      (lt_of_lt_of_le zero_lt_one hd)
  have hP : 0 < scale * Real.rpow d ((s : ℝ) - (q : ℝ)) :=
    mul_pos hscale (Real.rpow_pos_of_pos (lt_of_lt_of_le zero_lt_one hd) _)
  have hgaps := certificateInternalConflictLink_initial_errors_le_naturalDeviation
    H C d epsRaw GammaCert ellCert j w R
      D₂ D₃ D₄ GammaCore epsilonCore N f hf q s
      hq1 hq3 hsq hd heps hcore hGammaCore
  have hdev :
      CFMNumericAggregation.testDeviation GammaCore
          (scale * Real.rpow d ((s : ℝ) - (q : ℝ))) d epsilonCore =
        (scale * Real.rpow d ((s : ℝ) - (q : ℝ))) *
          Real.rpow d (-epsilonCore / 32) / (4 * GammaCore) := by
    rfl
  rw [hdev]
  exact
    { sourceBudgets := B
      upperGap := hgaps.1
      lowerGap := hgaps.2
      scale_pos := hP }

end

