        2 * finiteWeightedRootShadowMargin eta d
          (scale * Real.rpow d (-1 - epsRaw / 5)) 0 n := by
    intro e he hq2 n hn
    exact internalOriginalGainRootShadow_le_two_margin
      H C d epsRaw GammaCert ell D₂ D₃ D₄ GammaCore eta N T j w R
