/-- The internal filtered residual profile is the external residual profile
at weight `3 * scale`.  Consequently its four rank layers have the honest
coefficient `24` and the same `/16` saving. -/
theorem internalResidualRootMarginSum_le_rawSixteenth
    {eta Gamma d scale : ℝ} {q s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hscale : 0 ≤ scale) (hs : 1 ≤ s) :
    ∑ r ∈ Finset.Icc (2 : ℕ) 5,
        2 * finiteWeightedRootShadowMargin eta d
          (3 * scale * d ^ ((r : ℝ) - q -
            CFMRegularization.rawRegularizationEps eta / 10))
          0 ((r - 2) - (s - 1)) ≤
      24 * scale * d ^ ((s : ℝ) + 1 - q -
        CFMRegularization.rawRegularizationEps eta / 16) := by
  have h := residualRootMarginSum_le_rawSixteenth
    (W := 3 * scale) (j := q) E S
    (mul_nonneg (by norm_num) hscale) hs
  calc
    _ ≤ 8 * (3 * scale) * d ^ ((s : ℝ) + 1 - q -
          CFMRegularization.rawRegularizationEps eta / 16) := h
    _ = 24 * scale * d ^ ((s : ℝ) + 1 - q -
          CFMRegularization.rawRegularizationEps eta / 16) := by ring

/-- Literal sharp-test numerical window with every source error specialized.
The available-edge cardinal `a` enters only through its certified handshake
corridor; all remaining inequalities are consequences of the cutoff package. -/
theorem literalMeanWindow_numeric_of_registry_internalResidualSixteenth
    {D₂ D₃ D₄ Gamma eta d N P W a : ℝ} {k j s : ℕ}
