    hhost.trans (mul_le_mul_of_nonneg_left hpFloor R.degree.N_pos.le)
  calc
    900 * Gamma = (57600 * Gamma) / 64 := by ring
    _ ≤ d ^ (eta - eta ^ 3) / 64 :=
      div_le_div_of_nonneg_right hlarge (by norm_num)
    _ ≤ _ := hNP

/-- The certificate status occupies at most one fifth of any available-edge
set satisfying the final handshake corridor. -/
theorem certificateTestStatusHi_le_availableEdges_fifth_of_handshake
