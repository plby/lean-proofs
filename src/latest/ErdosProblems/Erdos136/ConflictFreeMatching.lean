/-- The closed positive-status persistent component window.  All source
geometry is obtained from final reachable Good through `Caps`; the only
remaining inputs are the structural cutoff and time bounds already carried
by the final source constructor. -/
theorem persistentInternalConflictLink_meanWindow_of_stateCaps
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : io → ℕ) (w : io → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta
      (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta
      (6 * (2 * (ell : ℝ) + 1)) d)
    (D₂ D₃ D₄ : ℝ) (N T k : ℕ)
    (hN : Real.rpow d eta / 2 ≤ (N : ℝ))
    (hT : (T : ℝ) ≤ (N : ℝ)) (hk : k ≤ T)
    (f : {e : Finset V // e ∈ H}) (q : Fin 3)
    (u : Fin (q.1 + 1)) (M : Hypergraph V)
    (_hM : IsConflictFreeMatching H R.regularized M)
    (hf : f.1 ∈ availableEdges H R.regularized M)
    (hgood : indexedGreedyGood
      (finalReachableTestEnhancedPredicate H C d
        (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
        (6 * (2 * (ell : ℝ) + 1)) eta N T j w R) k M)
    (Caps : PersistentInternalStateSourceCaps H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) eta N T k
      (CFMNumeric.trajectoryFloor eta d) j w R f q u M) :
    let qActual := q.1 + 1
    let sActual := u.1 + 1
    let scale := persistentInternalSourceScale H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w R q
    persistentInternalConflictLinkProbability H R.regularized f.1 M * scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
            qActual sActual (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄
            (6 * (2 * (ell : ℝ) + 1))
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              qActual sActual (k : ℝ) +
          2 * (Real.rpow d
            ((sActual : ℝ) - qActual - CFMNumeric.coreEpsilon eta) /
              (N : ℝ))) ≤
      meanPersistentPartialTestGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized f.1 qActual sActual M -
        meanPersistentPartialTestLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized f.1 qActual sActual M ∧
      meanPersistentPartialTestGain
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized f.1 qActual sActual M -
        meanPersistentPartialTestLoss
          (conflictLinkTestWeight R.regularized f.1 qActual)
          H R.regularized f.1 qActual sActual M ≤
      persistentInternalConflictLinkProbability H R.regularized f.1 M * scale *
        (CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
            qActual sActual (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄
            (6 * (2 * (ell : ℝ) + 1))
            (CFMNumeric.coreEpsilon eta) d (N : ℝ)
              qActual sActual (k : ℝ) -
          2 * (Real.rpow d
            ((sActual : ℝ) - qActual - CFMNumeric.coreEpsilon eta) /
              (N : ℝ))) := by
  dsimp only
  let epsRaw := CFMRegularization.rawRegularizationEps eta
  let GammaCert : ℝ := 2 * (ell : ℝ) + 1
  let GammaCore : ℝ := 6 * GammaCert
  let qActual := q.1 + 1
  let sActual := u.1 + 1
  let scale := persistentInternalSourceScale H C d epsRaw GammaCert
    ell j w R q
  let statusHi := certificateTestStatusHi D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N : ℝ) k
  let p := persistentInternalConflictLinkProbability
    H R.regularized f.1 M
  let center := scale * CFMTrajectories.zHatRate D₂ D₃ D₄ d (N : ℝ)
    qActual sActual (k : ℝ)
  let centerAbs := persistentInternalMeanCenterAbs
    D₂ D₃ D₄ GammaCore eta d (N : ℝ) scale k qActual sActual
  let survivalError := persistentInternalMeanSurvivalError
    H R.regularized D₂ D₃ D₄ GammaCore eta d (N : ℝ) k M
  let killedGainError := persistentInternalKilledGainError
    H R.regularized d epsRaw GammaCert eta sActual M
  let killedLossError := persistentInternalKilledLossError
    H R.regularized d epsRaw GammaCert eta D₂ D₃ D₄ GammaCore
      (N : ℝ) scale k q u M
  let common := scale *
    (GammaCore * CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
      (CFMNumeric.coreEpsilon eta) d (N : ℝ)
        qActual sActual (k : ℝ) /
      ((N : ℝ) * CFMTrajectories.pV (N : ℝ) (k : ℝ)))
  let envelope := scale * CFMTrajectories.zetaRate D₂ D₃ D₄ GammaCore
    (CFMNumeric.coreEpsilon eta) d (N : ℝ)
      qActual sActual (k : ℝ)
  let remainder := scale *
    (Real.rpow d ((sActual : ℝ) - qActual - CFMNumeric.coreEpsilon eta) /
      (N : ℝ))
  have hdpos : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hscale0 : 0 ≤ scale := by
    dsimp only [scale, persistentInternalSourceScale, epsRaw, GammaCert]
    exact (certificateInternalLayerScale_pos H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R (q.1 + 2) hdpos).le
  have hfullRaw := persistentInternalConflictLink_fullCenteredWindow_of_stateCaps
    H C d eta ell D₂ D₃ D₄ GammaCore N T k
      (CFMNumeric.trajectoryFloor eta d) j w R E S f q u M Caps
  have hfull : center - 12225 * common ≤
        meanPartialTestGain
            (conflictLinkTestWeight R.regularized f.1 qActual)
            H R.regularized qActual sActual M -
          meanPartialTestLoss
            (conflictLinkTestWeight R.regularized f.1 qActual)
            H R.regularized qActual sActual M ∧
      meanPartialTestGain
            (conflictLinkTestWeight R.regularized f.1 qActual)
            H R.regularized qActual sActual M -
          meanPartialTestLoss
            (conflictLinkTestWeight R.regularized f.1 qActual)
            H R.regularized qActual sActual M ≤
        center + 17225 * common := by
    dsimp only [center, common, scale, qActual, sActual, GammaCore,
      epsRaw, GammaCert] at hfullRaw ⊢
    constructor <;> nlinarith [hfullRaw.1, hfullRaw.2]
  have hpBounds := persistentInternalConflictLinkProbability_bounds_of_blockers
    H R.regularized M hf (statusLo := 0) (statusHi := statusHi)
      (Nat.cast_nonneg _) (by
        simpa only [statusHi, GammaCore, persistentInternalStatusHi]
          using (Caps.status f.1 hf).2)
  have hpUpper : p ≤ 1 := by
    dsimp only [p]
    simpa using hpBounds.2
  have hdefect : 1 - p ≤ survivalError := by
    dsimp only [p, survivalError, persistentInternalMeanSurvivalError,
      statusHi, GammaCore]
    nlinarith [hpBounds.1]
  have hcenter : |center| ≤ centerAbs := by
    dsimp only [center, centerAbs, qActual, sActual, GammaCore]
    exact persistentInternalMeanCenter_abs_le E Caps.registry hscale0
  let hinst' : IsSpecializedCFMInstance H C d eta ell j w := hinst
  rcases hinst with
    ⟨hH8, _hCsys, hell4, _hCfour, _heta0, _heta1, hd,
      _hNupper, hdegreeOn, _hcodegree, _hbounded, _hio, htrack⟩
  have hell1 : 1 ≤ ell := by omega
  have heps : 0 ≤ epsRaw := by
    dsimp only [epsRaw, CFMRegularization.rawRegularizationEps]
    positivity
  have hdegree : ∀ x, (degree H x : ℝ) ≤ d := by
    intro x
    by_cases hx : x ∈ vertexFinset H
    · exact (hdegreeOn x hx).2
    · rw [degree_eq_zero_of_not_mem_vertexFinset hx]
      exact le_trans (by norm_num) hd
  have hresidualCutoff :
      72 * (3 * GammaCert + 1) * (ell : ℝ) ≤
        Real.rpow d (epsRaw / 10) := by
    simpa only [GammaCert, epsRaw, Real.rpow_eq_pow] using
      CFMSharpTestCutoff.residualSpreadCoefficient_le_rawTenth ell E S
  have hcombined := finalReachableGood_combined H C d epsRaw GammaCert ell
    D₂ D₃ D₄ GammaCore eta N T j w R hgood
  have hkilledGain : meanKilledPartialTestGain
        (conflictLinkTestWeight R.regularized f.1 qActual)
        H R.regularized f.1 qActual sActual M ≤ killedGainError := by
    have h := meanKilledConflictLinkGain_le_pointDuplicateMargins_of_combinedGood
      H C d epsRaw GammaCert ell D₂ D₃ D₄ GammaCore eta N T j w R
        E S hd heps hell1 (fun a ↦ (htrack a).1)
        (fun a ↦ (htrack a).2.1) hH8 hdegree hresidualCutoff
        hN hT hk hcombined f.1 hf qActual sActual
        (by omega) (by omega) (by omega) (by omega)
    simpa only [killedGainError, persistentInternalKilledGainError,
      epsRaw, GammaCert, qActual, sActual] using h
  have hkilledLoss : meanKilledPartialTestLoss
        (conflictLinkTestWeight R.regularized f.1 qActual)
        H R.regularized f.1 qActual sActual M ≤ killedLossError := by
    simpa only [killedLossError, qActual, sActual, scale, epsRaw, GammaCert,
      GammaCore] using
      persistentInternalConflictLink_killedLoss_le_error_of_stateCaps
        H C d eta ell j w hinst' R D₂ D₃ D₄ N T k
          (CFMNumeric.trajectoryFloor eta d) f q u M hf Caps
  have hkilledGainNumeric : killedGainError ≤ 1000 * common := by
    have h :=
      CFMSharpPersistentKilledNetNumeric.pointDuplicateKilledGainError_le_thousand_commonScale
        H C R E S Caps.registry (by omega) (by omega) Caps.availableBounds.1
    simpa only [killedGainError, persistentInternalKilledGainError,
      common, scale, persistentInternalSourceScale, epsRaw, GammaCert,
      GammaCore, qActual, sActual, Nat.add_assoc, Real.rpow_eq_pow]
      using h
  have hkilledLossReserveRaw :
      killedLossError + survivalError * centerAbs ≤ 30400 * common := by
    by_cases hqzero : q.1 = 0
    · have hu : u.1 = 0 := by omega
      have hlossEq : killedLossError =
          persistentInternalRankOneKilledLossError H R.regularized d
            epsRaw GammaCert eta D₂ D₃ D₄ GammaCore (N : ℝ)
              scale k M := by
        dsimp only [killedLossError]
        rw [persistentInternalKilledLossError, if_pos hqzero]
      rw [hlossEq]
      have h :=
        CFMSharpPersistentKilledNetNumeric.persistentRankOneKilledLoss_add_survivalCenter_le_reserve
          H C R E S hN (by
            simpa only [hqzero, hu, GammaCore] using Caps.registry)
            Caps.availableBounds.1
      simpa [persistentInternalRankOneKilledLossError,
        survivalError, persistentInternalMeanSurvivalError,
        centerAbs, persistentInternalMeanCenterAbs,
        persistentInternalRankOneCStarBound, common, scale,
        persistentInternalSourceScale, epsRaw, GammaCert, GammaCore,
        qActual, sActual, hqzero, hu, Nat.add_assoc] using h
    · have h :=
        CFMSharpPersistentKilledNetNumeric.persistentHigherKilledLoss_add_survivalCenter_le_reserve
          E S hN Caps.registry hscale0 (by omega) Caps.availableBounds.1
      have hlossEq : killedLossError =
          persistentInternalHigherKilledLossError H R.regularized d
            epsRaw eta D₂ D₃ D₄ GammaCore (N : ℝ) scale k
              qActual sActual M := by
        dsimp only [killedLossError]
        rw [persistentInternalKilledLossError, if_neg hqzero]
      rw [hlossEq]
      simpa only [persistentInternalHigherKilledLossError,
        survivalError, persistentInternalMeanSurvivalError,
        centerAbs, persistentInternalMeanCenterAbs, common, scale,
        epsRaw, GammaCert, GammaCore, qActual, sActual,
        Nat.add_assoc, Nat.cast_add, Nat.cast_one] using h
  have hweight : ∀ Q, 0 ≤
      conflictLinkTestWeight R.regularized f.1 qActual Q :=
    conflictLinkTestWeight_nonneg_sharp R.regularized f.1 qActual
  have hkilledLoss0 : 0 ≤ killedLossError :=
    (meanKilledPartialTestLoss_nonneg
      (conflictLinkTestWeight R.regularized f.1 qActual)
      H R.regularized f.1 qActual sActual M hweight).trans hkilledLoss
  have hsurvivalReserve : survivalError * centerAbs ≤ 30400 * common := by
    linarith [hkilledLossReserveRaw]
  have hcommon0 : 0 ≤ common := by
    let x : ℝ := k
    have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
    have hpv := CFMTrajectories.pV_pos Caps.registry.delta.degree.N_pos
      (Caps.registry.delta.degree.before_end x hx)
    have hm := CFMTrajectories.pM_nonneg hdpos
      Caps.registry.delta.degree.N_pos
      (Caps.registry.delta.degree.time_nonneg x hx)
    have hzeta := (CFMTrajectories.zeta_pos
      (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) (Gamma := GammaCore)
      (epsilon := CFMNumeric.coreEpsilon eta)
      (j := qActual) (s := sActual) hdpos
      (lt_of_lt_of_le zero_lt_one E.Gamma_one) hpv hm
      Caps.registry.s_le_j).le
    dsimp only [common, GammaCore, qActual, sActual, x]
    exact mul_nonneg hscale0 (div_nonneg
      (mul_nonneg (le_trans zero_le_one E.Gamma_one) hzeta)
      (mul_nonneg Caps.registry.delta.degree.N_pos.le hpv.le))
  have hpLower : (4 / 5 : ℝ) ≤ p := by
    dsimp only [p]
    exact
      CFMSharpPersistentKilledNetNumeric.persistentInternalConflictLinkProbability_ge_four_fifths_of_handshake
        H R.regularized M hf E S hN Caps.registry.delta Caps.availableBounds.1
          (by simpa only [GammaCore, persistentInternalStatusHi]
            using (Caps.status f.1 hf).2)
  have hp0 : 0 ≤ p :=
    persistentInternalConflictLinkProbability_nonneg
      H R.regularized f.1 M
  have henvelope : 76000 * common ≤ envelope := by
    have hrate := CFMTrajectories.zetaRate_lower_of_registry Caps.registry
    have hm := mul_le_mul_of_nonneg_left hrate hscale0
    calc
      76000 * common = scale *
          (76000 * GammaCore /
            ((N : ℝ) * CFMTrajectories.pV (N : ℝ) (k : ℝ)) *
            CFMTrajectories.zeta D₂ D₃ D₄ GammaCore
              (CFMNumeric.coreEpsilon eta) d (N : ℝ)
                qActual sActual (k : ℝ)) := by
          dsimp only [common]
          ring
      _ ≤ envelope := by
        simpa only [envelope, GammaCore, qActual, sActual] using hm
  have hpEnvelope : 30400 * common ≤ p * envelope / 2 := by
    have hm := mul_le_mul hpLower henvelope
      (mul_nonneg (by norm_num) hcommon0) hp0
    nlinarith
  have hkilledGainReserve :
      killedGainError + survivalError * centerAbs ≤
        17225 * common + p * envelope / 2 := by
    nlinarith [hkilledGainNumeric, hsurvivalReserve]
  have hkilledLossReserve :
      killedLossError + survivalError * centerAbs ≤
        12225 * common + p * envelope / 2 := by
    nlinarith [hkilledLossReserveRaw]
  have hremainder : remainder ≤ common := by
    have h :=
      CFMSharpPersistentKilledNetNumeric.testRemainder_le_commonScale_of_registry
        E Caps.registry
    have hm := mul_le_mul_of_nonneg_left h hscale0
    simpa only [remainder, common, GammaCore, qActual, sActual,
      Real.rpow_eq_pow] using hm
  have hresult := persistentInternalConflictLink_meanWindow_of_full_killed_caps
