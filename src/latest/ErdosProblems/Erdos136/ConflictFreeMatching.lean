/-! ## Coarse finite codes for every combined profile branch -/

abbrev HostEdgeCode (H : Hypergraph V) := {e : Finset V // e ∈ H}

def vertexDuplicateProfileCode
    {H : Hypergraph V} (b : VertexDuplicateProfile H) :
