      exact_mod_cast hpositive.trans_le hvdeg
    unfold degree at this
    obtain ⟨e, he⟩ := Finset.card_pos.mp this
    exact ⟨e, (Finset.mem_filter.mp he).1⟩
  have hsurvEq := survivingVertexProbability_eq_one_sub_degree_div
    H R.regularized M v.1 hv hA
  have hsurv0 : 0 ≤ surv := by
    dsimp only [surv]
    exact survivingVertexProbability_nonneg H R.regularized v.1 M
  have hsurv1 : surv ≤ 1 := by
    dsimp only [surv]
    rw [hsurvEq]
    have hratio0 : 0 ≤ (degree (availableEdges H R.regularized M) v.1 : ℝ) /
        ((availableEdges H R.regularized M).card : ℝ) := by positivity
    linarith
  have hsurvQuarter := survivingVertexProbability_quarter_of_degreeEnhancedGood
    E S H C hI.1 j w R D₂ D₃ D₄ hk hgood Rstep hNlower v hv
  have hsurvPos : 0 < surv := by
    dsimp only [surv]
    linarith
  have hbracket0 : 0 ≤ bracket := by
    have hp : 0 ≤ surv * bracket := hmean0.trans hmean
    exact nonneg_of_mul_nonneg_right hp hsurvPos
  have hsurvBracket : surv * bracket ≤ bracket := by
    nlinarith
  have hNpos : 0 < N := by simpa only [N] using Rstep.degree.N_pos
  have hrem0 : 0 ≤ d ^ (1 - CFMNumeric.coreEpsilon eta) / N :=
    div_nonneg (Real.rpow_nonneg (by linarith [Rstep.degree.d_one]) _) hNpos.le
  have hbracketRate : bracket ≤
      |CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ)| +
        |CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ)| := by
    dsimp only [bracket]
    nlinarith [neg_le_abs (CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ)),
      le_abs_self (CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ))]
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hrate := CFMTrajectories.degreeRate_bound_at_step Rstep.degree hx
  have hdeltaRate := CFMNumericAggregation.deltaRate_bound_at_step
    Rstep (CFMNumericAggregation.coreEpsilon_nonneg E) hx
  have hrate' :
      |CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ)| ≤
        104 * Gamma * d / (N * CFMNumeric.trajectoryFloor eta d) := by
    simpa only [N] using hrate
  have hdeltaRate' :
      |CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ)| ≤
        76904 * Gamma * d / (N * CFMNumeric.trajectoryFloor eta d) := by
    simpa only [N] using hdeltaRate
  have hcoeff := degreeMeanRateCoefficient_absorption E S hGamma54
    (by simpa only [N] using Rstep.degree.N_pos)
  have hmeanPow : meanMissAvailableDegreeLoss H R.regularized M v.1 ≤
      Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) / N := by
    calc
      _ ≤ surv * bracket := hmean
      _ ≤ bracket := hsurvBracket
      _ ≤ |CFMTrajectories.degreeRate D₂ D₃ D₄ d N (k : ℝ)| +
          |CFMTrajectories.deltaRate D₂ D₃ D₄ Gamma
            (CFMNumeric.coreEpsilon eta) d N (k : ℝ)| := hbracketRate
      _ ≤ 77008 * Gamma * d /
          (N * CFMNumeric.trajectoryFloor eta d) := by
        calc
          _ ≤ 104 * Gamma * d / (N * CFMNumeric.trajectoryFloor eta d) +
              76904 * Gamma * d /
                (N * CFMNumeric.trajectoryFloor eta d) :=
            add_le_add hrate' hdeltaRate'
          _ = _ := by ring
      _ ≤ Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) / N := hcoeff
  have hJ0 : 0 ≤ degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta) := by
    unfold degreeSourceJumpScale
    exact Real.rpow_nonneg (by linarith [Rstep.degree.d_one]) _
  have hsq := meanSqMissAvailableDegreeLoss_le_jump_mul_mean
    H R.regularized M v.1 hJ0 hloss
  calc
    meanSqMissAvailableDegreeLoss H R.regularized M v.1 ≤
        degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta) *
          meanMissAvailableDegreeLoss H R.regularized M v.1 := hsq
    _ ≤ degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta) *
        (Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) / N) :=
      mul_le_mul_of_nonneg_left hmeanPow hJ0
    _ = degreeSourceVarianceScale d (CFMNumeric.coreEpsilon eta) N := by
      unfold degreeSourceJumpScale degreeSourceVarianceScale
      calc
        Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 4) *
            (Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16) / N) =
          (Real.rpow d (1 - CFMNumeric.coreEpsilon eta / 4) *
            Real.rpow d (1 + CFMNumeric.coreEpsilon eta / 16)) / N := by ring
        _ = Real.rpow d
            ((1 - CFMNumeric.coreEpsilon eta / 4) +
              (1 + CFMNumeric.coreEpsilon eta / 16)) / N := by
          exact congrArg (fun z : ℝ ↦ z / N)
            (Real.rpow_add
              (lt_of_lt_of_le zero_lt_one Rstep.degree.d_one) _ _).symm
        _ = Real.rpow d (2 - 3 * CFMNumeric.coreEpsilon eta / 16) / N := by
          congr 2
          ring
theorem literalCertificateDegreePairedFirstFailureSourceBudgets
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d eta : ℝ) (ell : ℕ) (j : iota → ℕ) (w : iota → TestWeight V)
    (hI : IsSpecializedCFMInstance H C d eta ell j w)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta)
        (2 * (ell : ℝ) + 1) ell j w)
    (E : CFMNumeric.CoreExponentSpec eta (6 * (2 * (ell : ℝ) + 1)))
    (S : CFMNumeric.CoreCutoffSpec eta (6 * (2 * (ell : ℝ) + 1)) d)
    (v : ActualHostVertex H) :
    let D₂ := certificateD₂ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let D₃ := certificateD₃ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let D₄ := certificateD₄ H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell j w R
    let Gamma := 6 * (2 * (ell : ℝ) + 1)
    let N := (vertexFinset H).card
    let T := CFMNumericAggregation.targetTime eta d N
    let Good := indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ Gamma eta d N T j R.restrictedWeight)
    CFMNumericAggregation.PairedFirstFailureSourceBudgets
      (SurvivingDegreeSourceBudgets H R.regularized Good T v.1
        D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d (N : ℝ)
          (CFMNumeric.trajectoryFloor eta d)
          (fun _ ↦ degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta))
          (fun _ ↦ CFMNumericAggregation.degreeTrajectoryScale Gamma eta d (N : ℝ))
          (fun _ ↦ degreeSourceVarianceScale d (CFMNumeric.coreEpsilon eta) (N : ℝ))
          (fun _ ↦ CFMNumericAggregation.degreeFreedmanVarianceScale
            d (CFMNumeric.coreEpsilon eta) (N : ℝ)))
      (degreeUpperError H R.regularized v.1 D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d (N : ℝ) 0 ∅)
      (degreeLowerError H R.regularized v.1 D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d (N : ℝ) 0 ∅)
      (CFMNumericAggregation.degreeDeviation d (CFMNumeric.coreEpsilon eta)) := by
  dsimp only
  let D₂ := certificateD₂ H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell j w R
  let D₃ := certificateD₃ H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell j w R
  let D₄ := certificateD₄ H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell j w R
  let Gamma : ℝ := 6 * (2 * (ell : ℝ) + 1)
  let N := (vertexFinset H).card
  let T := CFMNumericAggregation.targetTime eta d N
  let Good := indexedGreedyGood
    (degreeEnhancedGreedyPredicate H R.regularized
      D₂ D₃ D₄ Gamma eta d N T j R.restrictedWeight)
  have hHne : H.Nonempty := by
    obtain ⟨e, he, hve⟩ := mem_vertexFinset.mp v.2
    exact ⟨e, he⟩
  have hNlower : d ^ eta / 2 ≤ (N : ℝ) := by
    dsimp only [N]
    exact specializedHost_card_ge_half_rpow H C d eta Gamma ell j w hI hHne S
  have hTcast : (T : ℝ) ≤ (N : ℝ) := by
    dsimp only [T]
    exact CFMNumericAggregation.targetTime_cast_le_host E.eta_pos S hNlower
  have hGamma54 : (54 : ℝ) ≤ Gamma := by
    rcases hI with ⟨_hH8, _hCsys, hell, _hC4, _heta0, _heta1, _hd,
      _hNupper, _hdegree, _hcodegree, _hbounded, _htests, _htrack⟩
    dsimp only [Gamma]
    have hellR : (4 : ℝ) ≤ (ell : ℝ) := by exact_mod_cast hell
    nlinarith
  have hsource : SurvivingDegreeSourceBudgets H R.regularized Good T v.1
      D₂ D₃ D₄ Gamma (CFMNumeric.coreEpsilon eta) d (N : ℝ)
        (CFMNumeric.trajectoryFloor eta d)
        (fun _ ↦ degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta))
        (fun _ ↦ CFMNumericAggregation.degreeTrajectoryScale Gamma eta d (N : ℝ))
        (fun _ ↦ degreeSourceVarianceScale d (CFMNumeric.coreEpsilon eta) (N : ℝ))
        (fun _ ↦ CFMNumericAggregation.degreeFreedmanVarianceScale
          d (CFMNumeric.coreEpsilon eta) (N : ℝ)) := by
    apply survivingDegreeSourceBudgets_of_combinatorialMeanBounds
      H R.regularized Good T v.1 D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d (N : ℝ)
      (CFMNumeric.trajectoryFloor eta d)
      (fun _ ↦ degreeSourceJumpScale d (CFMNumeric.coreEpsilon eta))
      (fun _ ↦ CFMNumericAggregation.degreeTrajectoryScale Gamma eta d (N : ℝ))
      (fun _ ↦ degreeSourceVarianceScale d (CFMNumeric.coreEpsilon eta) (N : ℝ))
      (fun _ ↦ CFMNumericAggregation.degreeFreedmanVarianceScale
        d (CFMNumeric.coreEpsilon eta) (N : ℝ))
      (degreeEnhancedCombLo H R.regularized v.1
        D₂ D₃ D₄ Gamma eta d (N : ℝ))
      (degreeEnhancedCombHi H R.regularized v.1
        D₂ D₃ D₄ Gamma eta d (N : ℝ))
    · intro k hk M hgood
      dsimp only [D₂, D₃, D₄, Gamma, N, T]
      exact certificateLiteralDeltaStepRegistry
        H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
    · intro k hk M hgood hv
      have Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)
            (CFMNumeric.trajectoryFloor eta d) := by
        dsimp only [D₂, D₃, D₄, Gamma, N, T] at hk ⊢
        exact certificateLiteralDeltaStepRegistry
          H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
      exact meanMissAvailableDegreeLoss_bounds_of_degreeEnhancedGood
        E S H C j w hI R D₂ D₃ D₄ hgood Rstep v hv
    · intro k hk M hgood hv
      have Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)
            (CFMNumeric.trajectoryFloor eta d) := by
        dsimp only [D₂, D₃, D₄, Gamma, N, T] at hk ⊢
        exact certificateLiteralDeltaStepRegistry
          H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
      exact (degreeEnhancedComb_numeric_of_degreeEnhancedGood
        E S H C j w hI R D₂ D₃ D₄ hk hgood Rstep hNlower v hv).1
    · intro k hk M hgood hv
      have Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)
            (CFMNumeric.trajectoryFloor eta d) := by
        dsimp only [D₂, D₃, D₄, Gamma, N, T] at hk ⊢
        exact certificateLiteralDeltaStepRegistry
          H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
      exact (degreeEnhancedComb_numeric_of_degreeEnhancedGood
        E S H C j w hI R D₂ D₃ D₄ hk hgood Rstep hNlower v hv).2
    · intro k hk M hgood e he hve
      exact availableDegreeLoss_miss_le_of_degreeEnhancedGood
        E S H C j w hI R D₂ D₃ D₄ hTcast hk.le hgood v e he hve
    · intro k hk M hgood hv
      have Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)
            (CFMNumeric.trajectoryFloor eta d) := by
        dsimp only [D₂, D₃, D₄, Gamma, N, T] at hk ⊢
        exact certificateLiteralDeltaStepRegistry
          H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
      exact meanSqMissAvailableDegreeLoss_le_sourceVariance_of_degreeEnhancedGood
        E S hGamma54 H C j w hI R D₂ D₃ D₄ hk hgood Rstep hNlower v hv
    · intro k hk M hgood
      have Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)
            (CFMNumeric.trajectoryFloor eta d) := by
        dsimp only [D₂, D₃, D₄, Gamma, N, T] at hk ⊢
        exact certificateLiteralDeltaStepRegistry
          H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
      exact (CFMNumericAggregation.degreeEnvelopeTrajectory_step_abs_le
        Rstep (CFMNumericAggregation.coreEpsilon_nonneg E) le_rfl).1
    · intro k hk M hgood
      have Rstep : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d (N : ℝ) (k : ℝ)
            (CFMNumeric.trajectoryFloor eta d) := by
        dsimp only [D₂, D₃, D₄, Gamma, N, T] at hk ⊢
        exact certificateLiteralDeltaStepRegistry
          H C d eta ell j w hI R (vertexFinset H).card E S hNlower k hk
      exact (CFMNumericAggregation.degreeEnvelopeTrajectory_step_abs_le
        Rstep (CFMNumericAggregation.coreEpsilon_nonneg E) le_rfl).2
    · intro k hk M hgood
      exact CFMNumericAggregation.degreeCorrectedSquareBudget E S hNlower
  have hgaps := specializedDegree_initial_gaps
    E S H C j w hI R D₂ D₃ D₄ (N : ℝ) v
  exact
    { sourceBudgets := hsource
      upperGap := hgaps.1
      lowerGap := hgaps.2 }

/-! ## Pair-supported sharp test collision caps -/

noncomputable def certificateMixedLossCapNat
    (eta epsRaw d : ℝ) : ℕ :=
  Nat.ceil (Real.rpow d (1 - epsRaw / 4) +
    4 * localSpreadPrimaryMargin eta d)

theorem certificate_mixedLossCap_of_localGood
    {ι : Type*} [Fintype ι]
    {eta GammaCore d N epsRaw GammaCert : ℝ} {T k ellCert : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : ι → ℕ) (w : ι → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) (hkT : k ≤ T)
    {M : Hypergraph V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate
        H R.regularized eta d N T) k M)
    (v : ActualHostVertex H) {f : Finset V}
    (hf : f ∈ availableEdges H R.regularized M) (hvf : v.1 ∉ f) :
    CFMRegularization.conditionC4Count H R.regularized f v.1 +
        (localConflictLinkPartialAtVertex R.regularized
          (availableEdges H R.regularized M) M f 2 1 v.1).card +
        (localConflictLinkPartialAtVertex R.regularized
          (availableEdges H R.regularized M) M f 3 1 v.1).card ≤
      certificateMixedLossCapNat eta epsRaw d := by
  have hC4 := R.bounded.conditionC4_upper
    (availableEdges_subset H R.regularized M hf) v.1
  have hsource := sourceConflictLinkVertexCap_of_localGood
    E S hNpos hT hkT H R.regularized hgood v
  have h2source := hsource f hf hvf 2 (by norm_num) (by norm_num)
  have h3source := hsource f hf hvf 3 (by norm_num) (by norm_num)
  have h2nat := card_localConflictLinkPartialAtVertex_le_sourcePartial
    (C := R.regularized) (M := M)
    (availableEdges_subset H R.regularized M) f 2 1 v.1
  have h3nat := card_localConflictLinkPartialAtVertex_le_sourcePartial
    (C := R.regularized) (M := M)
    (availableEdges_subset H R.regularized M) f 3 1 v.1
  have h2 :
      ((localConflictLinkPartialAtVertex R.regularized
        (availableEdges H R.regularized M) M f 2 1 v.1).card : ℝ) ≤
        2 * localSpreadPrimaryMargin eta d := by
    exact (by exact_mod_cast h2nat :
      ((localConflictLinkPartialAtVertex R.regularized
        (availableEdges H R.regularized M) M f 2 1 v.1).card : ℝ) ≤
      ((partialFamily
        (sourceConflictLinkInteractionAtVertex
          H R.regularized f 2 v.1)
        (availableEdges H R.regularized M) M 1).card : ℝ)).trans h2source
  have h3 :
      ((localConflictLinkPartialAtVertex R.regularized
        (availableEdges H R.regularized M) M f 3 1 v.1).card : ℝ) ≤
        2 * localSpreadPrimaryMargin eta d := by
    exact (by exact_mod_cast h3nat :
      ((localConflictLinkPartialAtVertex R.regularized
        (availableEdges H R.regularized M) M f 3 1 v.1).card : ℝ) ≤
      ((partialFamily
        (sourceConflictLinkInteractionAtVertex
          H R.regularized f 3 v.1)
        (availableEdges H R.regularized M) M 1).card : ℝ)).trans h3source
  unfold certificateMixedLossCapNat
  have hsum :
      ((CFMRegularization.conditionC4Count H R.regularized f v.1 +
        (localConflictLinkPartialAtVertex R.regularized
          (availableEdges H R.regularized M) M f 2 1 v.1).card +
        (localConflictLinkPartialAtVertex R.regularized
          (availableEdges H R.regularized M) M f 3 1 v.1).card : ℕ) : ℝ) ≤
        Real.rpow d (1 - epsRaw / 4) +
          4 * localSpreadPrimaryMargin eta d := by
    push_cast
    linarith
  exact_mod_cast hsum.trans (Nat.le_ceil
    (Real.rpow d (1 - epsRaw / 4) +
      4 * localSpreadPrimaryMargin eta d))

/-- The local-through certificate cap in the exact pair-supported form
needed by the MC/CM loss terms.  The distinguished vertex lies on the
opposite positive-weight test edge, so disjointness supplies the off-root
hypothesis of `sourceConflictLinkVertexCap_of_localGood`. -/
theorem certificate_pairMixedLossCap_of_localGood
    {iota : Type*} [Fintype iota]
    {eta GammaCore d N epsRaw GammaCert : ℝ} {T k ellCert : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hNpos : 0 < N) (hT : (T : ℝ) ≤ N) (hkT : k ≤ T)
    {M : Hypergraph V} {f g : Finset V}
    (hgood : indexedGreedyGood
      (vertexLocalThroughSpreadLocalPredicate
        H R.regularized eta d N T) k M)
    (hf : f ∈ availableEdges H R.regularized M)
    (hg : g ∈ availableEdges H R.regularized M)
    (hfg : Disjoint f g) :
    ∀ v ∈ g,
      CFMRegularization.conditionC4Count H R.regularized f v +
          (localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M f 2 1 v).card +
          (localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M f 3 1 v).card ≤
        certificateMixedLossCapNat eta epsRaw d := by
  intro v hvg
  let v' : ActualHostVertex H :=
    ⟨v, mem_vertexFinset.mpr
      ⟨g, availableEdges_subset H R.regularized M hg, hvg⟩⟩
  have hvf : v ∉ f := by
    intro hvf
    exact Finset.disjoint_left.mp hfg hvf hvg
  exact certificate_mixedLossCap_of_localGood
    E S H C j w R hNpos hT hkT hgood v' hf hvf

/-- Pair-supported MC/CM cap projected from the canonical degree-enhanced
Good predicate.  This is the form consumed by the final test package, whose
index may append further `Sum` components outside the degree family. -/
theorem certificate_pairMixedLossCap_of_degreeEnhancedGood
    [Fintype V] {iota : Type*} [Fintype iota]
    {eta GammaCore d epsRaw GammaCert D₂ D₃ D₄ : ℝ}
    {N T k ellCert : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (hNpos : 0 < (N : ℝ)) (hT : (T : ℝ) ≤ (N : ℝ))
    (hkT : k ≤ T) {M : Hypergraph V} {f g : Finset V}
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ GammaCore eta d N T j R.restrictedWeight) k M)
    (hf : f ∈ availableEdges H R.regularized M)
    (hg : g ∈ availableEdges H R.regularized M)
    (hfg : Disjoint f g) :
    ∀ v ∈ g,
      CFMRegularization.conditionC4Count H R.regularized f v +
          (localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M f 2 1 v).card +
          (localConflictLinkPartialAtVertex R.regularized
            (availableEdges H R.regularized M) M f 3 1 v).card ≤
        certificateMixedLossCapNat eta epsRaw d := by
  apply certificate_pairMixedLossCap_of_localGood
    E S H C j w R hNpos hT hkT
  · exact indexedDegreeEnhancedGood_local
      H R.regularized D₂ D₃ D₄ GammaCore eta d N T
        j R.restrictedWeight hgood
  · exact hf
  · exact hg
  · exact hfg

theorem available_codegree_le_ceil
    {H : Hypergraph V} {C : ConflictSystem V} {M : Hypergraph V}
    {root : Finset V}
    {codegreeHi : ℝ}
    (hcodegree : (codegree H root : ℝ) ≤ codegreeHi) :
    codegree (availableEdges H C M) root ≤ Nat.ceil codegreeHi := by
  have hsub := codegree_mono_hypergraph
    (availableEdges_subset H C M) root
  have hreal := (by exact_mod_cast hsub :
    (codegree (availableEdges H C M) root : ℝ) ≤
      (codegree H root : ℝ)).trans hcodegree
  exact_mod_cast hreal.trans (Nat.le_ceil codegreeHi)

/-! The production aggregate deliberately exposes a convenient all-vertex
mixed cap.  The certificate's local-through hierarchy gives the sharper
and source-faithful statement only off the root edge.  In the MC/CM terms
the vertex is on the other positive-weight test edge, so matching support
supplies exactly that missing disjointness. -/

theorem weightedTestLossMCMass_le_pairMixedCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s mixedHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, Disjoint f g → ∀ v ∈ g,
        CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card ≤ mixedHi) :
    weightedTestLossMCMass w H C M j s ≤
      (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossMCMass testLossMCMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s (8 * mixedHi) (blockerPairMC H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  have hfg : Disjoint f g :=
    (hmatchingPos S hS hpos).2
      (Finset.inter_subset_left hf) (Finset.inter_subset_left hg) hgf.symm
  have hbound := card_inter_meeting_conflictBlockers_le_C4_add_local
    hCcard f hgA
  calc
    blockerPairMC H C M f g ≤
        ∑ v ∈ f,
          (CFMRegularization.conditionC4Count H C g v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M g 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M g 3 1 v).card) := by
      simpa only [blockerPairMC] using hbound
    _ ≤ ∑ _v ∈ f, mixedHi := by
      apply Finset.sum_le_sum
      intro v hv
      exact hmixed g hgA f hfA hfg.symm v hv
    _ = 8 * mixedHi := by
      simp [hH8 f (availableEdges_subset H C M hfA)]

theorem weightedTestLossCMMass_le_pairMixedCap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s mixedHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, Disjoint f g → ∀ v ∈ g,
        CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card ≤ mixedHi) :
    weightedTestLossCMMass w H C M j s ≤
      (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  unfold weightedTestLossCMMass testLossCMMassAt
  apply weighted_orientedPairCategoryMass_le
    w H C M j s (8 * mixedHi) (blockerPairCM H C M) hw
  intro S hS hpos hcoord f hf g hg hgf
  have hfA : f ∈ availableEdges H C M := Finset.inter_subset_right hf
  have hgA : g ∈ availableEdges H C M := Finset.inter_subset_right hg
  have hfg : Disjoint f g :=
    (hmatchingPos S hS hpos).2
      (Finset.inter_subset_left hf) (Finset.inter_subset_left hg) hgf.symm
  have hbound := card_inter_meeting_conflictBlockers_le_C4_add_local
    hCcard g hfA
  calc
    blockerPairCM H C M f g ≤
        ∑ v ∈ g,
          (CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card) := by
      simpa only [blockerPairCM, Finset.inter_comm] using hbound
    _ ≤ ∑ _v ∈ g, mixedHi := by
      apply Finset.sum_le_sum
      intro v hv
      exact hmixed f hfA g hgA hfg v hv
    _ = 8 * mixedHi := by
      simp [hH8 g (availableEdges_subset H C M hgA)]

theorem weightedPartialTestLossCollision_le_pairAggregateCaps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s codegreeHi mixedHi ccHi : ℕ)
    (hH8 : IsUniform H 8) (hw : ∀ S, 0 ≤ w S)
    (hmatchingPos : ∀ S ∈ H.powersetCard j,
      0 < w S → IsMatching H S)
    (hcodegree : ∀ root, root.card = 2 →
      codegree (availableEdges H C M) root ≤ codegreeHi)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card ∧ c.card ≤ 4)
    (hmixed : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, Disjoint f g → ∀ v ∈ g,
        CFMRegularization.conditionC4Count H C f v +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 2 1 v).card +
            (localConflictLinkPartialAtVertex C
              (availableEdges H C M) M f 3 1 v).card ≤ mixedHi)
    (hreroot : ∀ f ∈ availableEdges H C M,
      ∀ g ∈ availableEdges H C M, g ≠ f →
        (∑ q ∈ Finset.Icc 1 3, ∑ r ∈ Finset.Icc 1 5,
          (partialFamily
            (testConflictUnionLayer (conflictLinkLayer C f q) C g r)
            (availableEdges H C M) M 1).card) ≤ ccHi) :
    weightedPartialTestLossCollision w H C M j s ≤
      (((s.choose 2 *
          (4 * (64 * codegreeHi + 16 * mixedHi + ccHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
  have hHne : ∀ e ∈ H, e.Nonempty := by
    intro e he
    exact Finset.card_pos.mp (by rw [hH8 e he]; norm_num)
  have hsplit := weightedPartialTestLossCollision_le_sharpFourParts
    (w := w) (H := H) (C := C) (M := M) (j := j) (s := s) hw hHne
  have hmm := weightedTestLossMMMass_le_codegreeCap
    w H C M j s codegreeHi hH8 hw hmatchingPos hcodegree
  have hmc := weightedTestLossMCMass_le_pairMixedCap
    w H C M j s mixedHi hH8 hw hmatchingPos hCcard hmixed
  have hcm := weightedTestLossCMMass_le_pairMixedCap
    w H C M j s mixedHi hH8 hw hmatchingPos hCcard hmixed
  have hcc := weightedTestLossCCMass_le_rerootedCap
    w H C M j s ccHi hw hCcard hreroot
  calc
    weightedPartialTestLossCollision w H C M j s ≤
        weightedTestLossMMMass w H C M j s +
          weightedTestLossMCMass w H C M j s +
          weightedTestLossCMMass w H C M j s +
          weightedTestLossCCMass w H C M j s := hsplit
    _ ≤ (((s.choose 2 * (4 * (64 * codegreeHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * (8 * mixedHi)) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) +
          (((s.choose 2 * (4 * ccHi) : ℕ) : ℝ) *
            partialTestObservable w H C j s M) := by
      exact add_le_add (add_le_add (add_le_add hmm hmc) hcm) hcc
    _ = (((s.choose 2 *
          (4 * (64 * codegreeHi + 16 * mixedHi + ccHi)) : ℕ) : ℝ) *
        partialTestObservable w H C j s M) := by
      push_cast
      ring


def originalTestRootShadowWeight
    (w : TestWeight V) (H : Hypergraph V) (j : ℕ)
    (f : Finset V) : TestWeight V :=
  weightedConflictFamilyRootShadowWeight (H.powersetCard j) w {f}

theorem originalTestRootShadowWeight_nonneg
    {w : TestWeight V} (hw : ∀ S, 0 ≤ w S)
    (H : Hypergraph V) (j : ℕ) (f : Finset V) (S : Hypergraph V) :
    0 ≤ originalTestRootShadowWeight w H j f S := by
  exact weightedConflictFamilyRootShadowWeight_nonneg hw {f} S

/-- Tests containing a fixed unselected edge and having exactly `n`
selected members inject into the rank-`n` root-shadow mass. -/
theorem sum_tests_containing_with_selectedCard_le_rootShadow
    (w : TestWeight V) (H M : Hypergraph V) (j n : ℕ)
    (f : Finset V) (hw : ∀ S, 0 ≤ w S) (hfM : f ∉ M) :
    (∑ S ∈ H.powersetCard j,
        if f ∈ S ∧ (S ∩ M).card = n then w S else 0) ≤
      testTotal (originalTestRootShadowWeight w H j f) M n := by
  change (∑ S ∈ H.powersetCard j,
      if f ∈ S ∧ (S ∩ M).card = n then w S else 0) ≤
    ∑ R ∈ M.powersetCard n,
      if Disjoint {f} R then
        weightedCodegree (H.powersetCard j) w ({f} ∪ R)
      else 0
  calc
    (∑ S ∈ H.powersetCard j,
        if f ∈ S ∧ (S ∩ M).card = n then w S else 0) ≤
      ∑ S ∈ H.powersetCard j, ∑ R ∈ M.powersetCard n,
        if Disjoint {f} R then
          if {f} ∪ R ⊆ S then w S else 0
        else 0 := by
      apply Finset.sum_le_sum
      intro S hS
      by_cases hsource : f ∈ S ∧ (S ∩ M).card = n
      · rw [if_pos hsource]
        let R : Hypergraph V := S ∩ M
        have hR : R ∈ M.powersetCard n := by
          apply Finset.mem_powersetCard.mpr
          exact ⟨Finset.inter_subset_right, hsource.2⟩
        have hdisj : Disjoint {f} R := by
          rw [Finset.disjoint_left]
          intro g hgroot hgR
          simp only [Finset.mem_singleton] at hgroot
          subst g
          exact hfM (Finset.inter_subset_right hgR)
        have hroot : {f} ∪ R ⊆ S := by
          intro g hg
          rcases Finset.mem_union.mp hg with hg | hg
          · simp only [Finset.mem_singleton] at hg
            subst g
            exact hsource.1
          · exact Finset.inter_subset_left hg
        have hterm :
            (if Disjoint {f} R then
                if {f} ∪ R ⊆ S then w S else 0
              else 0) = w S := by
          rw [if_pos hdisj, if_pos hroot]
        calc
          w S = if Disjoint {f} R then
              if {f} ∪ R ⊆ S then w S else 0
            else 0 := hterm.symm
          _ ≤ ∑ R ∈ M.powersetCard n,
              if Disjoint {f} R then
                if {f} ∪ R ⊆ S then w S else 0
              else 0 := by
            apply Finset.single_le_sum (s := M.powersetCard n)
                (f := fun R ↦ if Disjoint {f} R then
                  if {f} ∪ R ⊆ S then w S else 0 else 0)
            · intro R' hR'
              split
              · split
                · exact hw S
                · norm_num
              · norm_num
            · exact hR
      · rw [if_neg hsource]
        apply Finset.sum_nonneg
        intro R hR
        split
        · split
          · exact hw S
          · norm_num
        · norm_num
    _ = ∑ R ∈ M.powersetCard n, ∑ S ∈ H.powersetCard j,
        if Disjoint {f} R then
          if {f} ∪ R ⊆ S then w S else 0
        else 0 := by rw [Finset.sum_comm]
    _ = ∑ R ∈ M.powersetCard n,
        if Disjoint {f} R then
          weightedCodegree (H.powersetCard j) w ({f} ∪ R)
        else 0 := by
      apply Finset.sum_congr rfl
      intro R hR
      by_cases hdisj : Disjoint {f} R
      · simp only [hdisj, if_true]
        unfold weightedCodegree
        rw [Finset.sum_filter]
      · have hRsub : R ⊆ M := (Finset.mem_powersetCard.mp hR).1
        have hfR : f ∉ R := fun hfR ↦ hfM (hRsub hfR)
        have : Disjoint {f} R := by
          refine Finset.disjoint_left.2 ?_
          intro x hxf hxR
          have hxf' : x = f := Finset.mem_singleton.mp hxf
          subst x
          exact hfR hxR
        exact (hdisj this).elim

def selectedTestIncidenceCharge
    (w : TestWeight V) (H M : Hypergraph V)
    (j n : ℕ) (D : Hypergraph V) : ℝ :=
  ∑ S ∈ H.powersetCard j,
    if (S ∩ M).card = n then w S * (S ∩ D).card else 0

theorem selectedTestIncidenceCharge_eq_sum_roots
    (w : TestWeight V) (H M : Hypergraph V)
    (j n : ℕ) (D : Hypergraph V) :
    selectedTestIncidenceCharge w H M j n D =
      ∑ f ∈ D, ∑ S ∈ H.powersetCard j,
        if f ∈ S ∧ (S ∩ M).card = n then w S else 0 := by
  unfold selectedTestIncidenceCharge
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro S hS
  by_cases hselected : (S ∩ M).card = n
  · rw [if_pos hselected]
    calc
      w S * ((S ∩ D).card : ℝ) =
          ∑ f ∈ D, if f ∈ S then w S else 0 := by
        rw [← Finset.sum_filter]
        have hfilter : D.filter (fun f ↦ f ∈ S) = S ∩ D := by
          ext f
          simp [and_comm]
        rw [hfilter]
        simp [mul_comm]
      _ = ∑ f ∈ D,
          if f ∈ S ∧ (S ∩ M).card = n then w S else 0 := by
        apply Finset.sum_congr rfl
        intro f hf
        simp only [hselected, and_true]
  · rw [if_neg hselected]
    simp [hselected]

theorem selectedTestIncidenceCharge_le_sum_rootShadows
    (w : TestWeight V) (H M : Hypergraph V)
    (j n : ℕ) (D : Hypergraph V)
    (hw : ∀ S, 0 ≤ w S) (hDM : Disjoint D M) :
    selectedTestIncidenceCharge w H M j n D ≤
      ∑ f ∈ D, testTotal (originalTestRootShadowWeight w H j f) M n := by
  rw [selectedTestIncidenceCharge_eq_sum_roots]
  apply Finset.sum_le_sum
  intro f hfD
  apply sum_tests_containing_with_selectedCard_le_rootShadow w H M j n f hw
  exact Finset.disjoint_left.mp hDM hfD

/-- Pointwise gain is a single original-test root-shadow coordinate. -/
theorem partialTestStepGain_le_originalTestRootShadow
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S) :
    partialTestStepGain w H C j s M e ≤
      testTotal (originalTestRootShadowWeight w H j e) M (j - (s + 1)) := by
  unfold partialTestStepGain partialTestGainBetween
  apply (Finset.sum_le_sum (fun S hS ↦ ?_)).trans
    (sum_tests_containing_with_selectedCard_le_rootShadow
      w H M j (j - (s + 1)) e hw (mem_availableEdges.mp he).2.1)
  by_cases hgain :
      ¬ partialTestCondition (availableEdges H C M) M j s S ∧
        partialTestCondition (availableEdges H C (insert e M))
          (insert e M) j s S
  · rw [if_pos hgain, if_pos]
    have heChoice : e ∈ partialTestGainChoiceSet H C M j s S := by
      rw [partialTestGainChoiceSet, Finset.mem_filter]
      exact ⟨he, hgain⟩
    have hsource := partialTestGainChoice_mem_source_succ
      H C M j s S hS heChoice
    exact ⟨Finset.inter_subset_left hsource.2, hsource.1.2⟩
  · rw [if_neg hgain]
    split
    · exact hw S
    · rfl

/-- Pointwise loss is charged to the original-test root shadows of the
available members actually deleted by the chosen edge. -/
theorem partialTestStepLoss_le_sum_deletedRootShadows
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S) :
    partialTestStepLoss w H C j s M e ≤
      ∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M),
        testTotal (originalTestRootShadowWeight w H j f) M (j - s) := by
  let A := availableEdges H C M
  let A' := availableEdges H C (insert e M)
  let D := A \ A'
  have hDM : Disjoint D M :=
    (availableEdges_disjoint_selected H C M).mono_left Finset.sdiff_subset
  have hlossIncidence :
      partialTestStepLoss w H C j s M e ≤
        selectedTestIncidenceCharge w H M j (j - s) D := by
    unfold partialTestStepLoss partialTestLossBetween
      selectedTestIncidenceCharge
    apply Finset.sum_le_sum
    intro S hS
    by_cases hloss :
        partialTestCondition A M j s S ∧
          ¬ partialTestCondition A' (insert e M) j s S
    · rw [if_pos hloss, if_pos hloss.1.2]
      have heChoice : e ∈ partialTestLossChoiceSet H C M j s S := by
        rw [partialTestLossChoiceSet, Finset.mem_filter]
        exact ⟨he, hloss⟩
      obtain ⟨f, hfSA, hef⟩ :=
        partialTestLossChoice_mem_has_blocked_member
          H C M j s S hS heChoice
      have hfA : f ∈ A := Finset.inter_subset_right hfSA
      have heA : e ∈ A := he
      have hfe := (mem_availableBlockerChoices_comm H C M heA hfA).mpr hef
      have hfNotA' : f ∉ A' := by
        dsimp only [A']
        rw [availableEdges_insert_eq_sdiff_blockers]
        exact fun hf' ↦ (Finset.mem_sdiff.mp hf').2 hfe
      have hfD : f ∈ D := Finset.mem_sdiff.mpr ⟨hfA, hfNotA'⟩
      have hpos : 1 ≤ (S ∩ D).card := by
        exact Finset.one_le_card.mpr
          ⟨f, Finset.mem_inter.mpr
            ⟨Finset.inter_subset_left hfSA, hfD⟩⟩
      have hposR : (1 : ℝ) ≤ ((S ∩ D).card : ℕ) := by exact_mod_cast hpos
      simpa only [mul_one] using
        mul_le_mul_of_nonneg_left hposR (hw S)
    · rw [if_neg hloss]
      split
      · exact mul_nonneg (hw S) (Nat.cast_nonneg _)
      · rfl
  exact hlossIncidence.trans
    (by
      simpa only [D, A, A'] using
        selectedTestIncidenceCharge_le_sum_rootShadows
          w H M j (j - s) D hw hDM)

/-- Corridor-ready pointwise cap: one source-root bound controls gain, and
one deleted-member root bound times the sharp status cap controls loss. -/
theorem partialTestStepGain_loss_le_originalTestRootCaps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    {gainCap lossRootCap statusHi : ℝ}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S)
    (hlossRootCap0 : 0 ≤ lossRootCap)
    (hgainRoot :
      testTotal (originalTestRootShadowWeight w H j e) M
          (j - (s + 1)) ≤ gainCap)
    (hlossRoots : ∀ f ∈ availableEdges H C M,
      testTotal (originalTestRootShadowWeight w H j f) M
          (j - s) ≤ lossRootCap)
    (hstatus :
      (((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℕ) : ℝ) ≤ statusHi) :
    partialTestStepGain w H C j s M e ≤ gainCap ∧
      partialTestStepLoss w H C j s M e ≤ statusHi * lossRootCap := by
  constructor
  · exact (partialTestStepGain_le_originalTestRootShadow
      w H C M j s he hw).trans hgainRoot
  · apply (partialTestStepLoss_le_sum_deletedRootShadows
      w H C M j s he hw).trans
    calc
      (∑ f ∈ availableEdges H C M \
          availableEdges H C (insert e M),
          testTotal (originalTestRootShadowWeight w H j f) M (j - s)) ≤
          ∑ _f ∈ availableEdges H C M \
            availableEdges H C (insert e M), lossRootCap := by
        apply Finset.sum_le_sum
        intro f hf
        exact hlossRoots f (Finset.sdiff_subset hf)
      _ = (((availableEdges H C M \
          availableEdges H C (insert e M)).card : ℕ) : ℝ) *
            lossRootCap := by simp
      _ ≤ statusHi * lossRootCap :=
        mul_le_mul_of_nonneg_right hstatus hlossRootCap0

/-- The form used by the certificate status window, whose upper endpoint
is stated directly for `availableBlockerChoices`. -/
theorem partialTestStepGain_loss_le_originalTestRootCaps_of_blockers
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) {e : Finset V}
    {gainCap lossRootCap statusHi : ℝ}
    (he : e ∈ availableEdges H C M) (hw : ∀ S, 0 ≤ w S)
    (hlossRootCap0 : 0 ≤ lossRootCap)
    (hgainRoot :
      testTotal (originalTestRootShadowWeight w H j e) M
          (j - (s + 1)) ≤ gainCap)
    (hlossRoots : ∀ f ∈ availableEdges H C M,
      testTotal (originalTestRootShadowWeight w H j f) M
          (j - s) ≤ lossRootCap)
    (hstatus :
      (((availableBlockerChoices H C M e).card : ℕ) : ℝ) ≤ statusHi) :
    partialTestStepGain w H C j s M e ≤ gainCap ∧
      partialTestStepLoss w H C j s M e ≤ statusHi * lossRootCap := by
  apply partialTestStepGain_loss_le_originalTestRootCaps
    w H C M j s he hw hlossRootCap0 hgainRoot hlossRoots
  have hblockSubset : availableBlockerChoices H C M e ⊆
      availableEdges H C M := by
    intro f hf
    exact (Finset.mem_filter.mp hf).1
  rw [availableEdges_insert_eq_sdiff_blockers,
    Finset.sdiff_sdiff_eq_self hblockSubset]
  exact hstatus

namespace CFMTrajectories

/-- Exact source normalization of the parenthesized test envelope. -/
theorem testInside_eq_normalized
    {D₂ D₃ D₄ Gamma d N x : ℝ} {j s : ℕ}
    (hd : 0 < d) (hGamma : 0 < Gamma) (hsj : s ≤ j) (hj : j ≤ 4) :
    testInside D₂ D₃ D₄ Gamma d N j s x =
      (j.choose s : ℝ) * dHat D₂ D₃ D₄ d N x ^ s / d ^ j *
        (pV N x ^ s * (1 - pV N x) ^ (j - s) + 1 / (4 * Gamma)) := by
  have hd0 : d ≠ 0 := ne_of_gt hd
  have hqId : dHat D₂ D₃ D₄ d N x * pV N x =
      d * q D₂ D₃ D₄ d N x := by
    unfold dHat q
    ring
  have hmId : 1 - pV N x = d * pM d N x := by
    unfold pV pM
    field_simp [hd0]
    ring
  have hmain :
      dHat D₂ D₃ D₄ d N x ^ s / d ^ j *
          (pV N x ^ s * (1 - pV N x) ^ (j - s)) =
        q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s) := by
    rw [div_mul_eq_mul_div]
    apply (div_eq_iff (pow_ne_zero j hd0)).2
    calc
      dHat D₂ D₃ D₄ d N x ^ s *
            (pV N x ^ s * (1 - pV N x) ^ (j - s)) =
          (dHat D₂ D₃ D₄ d N x * pV N x) ^ s *
            (1 - pV N x) ^ (j - s) := by rw [mul_pow]; ring
      _ = (d * q D₂ D₃ D₄ d N x) ^ s *
            (d * pM d N x) ^ (j - s) := by rw [hqId, hmId]
      _ = d ^ j *
          (q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s)) := by
        rw [mul_pow, mul_pow]
        calc
          d ^ s * q D₂ D₃ D₄ d N x ^ s *
                (d ^ (j - s) * pM d N x ^ (j - s)) =
              (d ^ s * d ^ (j - s)) *
                (q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s)) := by ring
          _ = d ^ j *
                (q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s)) := by
            rw [← pow_add, Nat.add_sub_of_le hsj]
      _ = (q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s)) * d ^ j := by
        ring
  have hweighted :
      (j.choose s : ℝ) * q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s) =
        (j.choose s : ℝ) *
          (dHat D₂ D₃ D₄ d N x ^ s / d ^ j *
            (pV N x ^ s * (1 - pV N x) ^ (j - s))) := by
    calc
      (j.choose s : ℝ) * q D₂ D₃ D₄ d N x ^ s *
          pM d N x ^ (j - s) =
          (j.choose s : ℝ) *
            (q D₂ D₃ D₄ d N x ^ s * pM d N x ^ (j - s)) := by ring
      _ = _ := by rw [← hmain]
  unfold testInside zHat
  rw [mul_add, hweighted]
  ring

/-- Coarse finite-rank form of the source successor-envelope recurrence.
The source constant is much smaller; `160` is chosen to make the finite
rank proof depend only on each normalized factor being at most one. -/
theorem testInside_successor_le
    {D₂ D₃ D₄ Gamma d N x : ℝ} {j s : ℕ}
    (hd : 0 < d) (hN : 0 < N) (hGamma : 1 ≤ Gamma)
    (hx0 : 0 ≤ x) (hx1 : 8 * x < N)
    (hD₂0 : 0 ≤ D₂) (hD₃0 : 0 ≤ D₃) (hD₄0 : 0 ≤ D₄)
    (hsj : s ≤ j) (hj : j ≤ 4) :
    ((s + 1 : ℕ) : ℝ) * testInside D₂ D₃ D₄ Gamma d N j (s + 1) x ≤
      160 * Gamma * dHat D₂ D₃ D₄ d N x *
        testInside D₂ D₃ D₄ Gamma d N j s x := by
  have hp : 0 < pV N x := pV_pos hN hx1
  have hp0 : 0 ≤ pV N x := hp.le
  have hp1 : pV N x ≤ 1 := pV_le_one hN hx0
  have hmp0 : 0 ≤ 1 - pV N x := by
    unfold pV
    positivity
  have hmp1 : 1 - pV N x ≤ 1 := by linarith
  have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one hGamma
  have hD : 0 < dHat D₂ D₃ D₄ d N x := dHat_pos hd hp
  by_cases htop : s = j
  · subst s
    have hz : j.choose (j + 1) = 0 :=
      Nat.choose_eq_zero_of_lt (Nat.lt_succ_self j)
    have hcur := testInside_eq_normalized (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (d := d) (N := N) (x := x) (j := j) (s := j)
      hd hG le_rfl hj
    have hcur0 : 0 ≤ testInside D₂ D₃ D₄ Gamma d N j j x := by
      rw [hcur]
      positivity
    have hzero : testInside D₂ D₃ D₄ Gamma d N j (j + 1) x = 0 := by
      simp [testInside, zHat, hz]
    rw [hzero, mul_zero]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) hG.le) hD.le) hcur0
  have hsnext : s + 1 ≤ j := by omega
  have hchoose : (j.choose (s + 1) : ℝ) ≤ 6 := by
    exact_mod_cast choose_le_six hsnext hj
  have hsucc : ((s + 1 : ℕ) : ℝ) ≤ 5 := by
    have hs5 : s + 1 ≤ 5 := by omega
    exact_mod_cast hs5
  have hpowp : pV N x ^ (s + 1) ≤ 1 := pow_le_one₀ hp0 hp1
  have hpowm : (1 - pV N x) ^ (j - (s + 1)) ≤ 1 :=
    pow_le_one₀ hmp0 hmp1
  have hprod0 : 0 ≤ pV N x ^ (s + 1) *
      (1 - pV N x) ^ (j - (s + 1)) :=
    mul_nonneg (pow_nonneg hp0 _) (pow_nonneg hmp0 _)
  have hprod : pV N x ^ (s + 1) *
      (1 - pV N x) ^ (j - (s + 1)) ≤ 1 := by
    calc
      _ ≤ 1 * 1 := mul_le_mul hpowp hpowm (pow_nonneg hmp0 _) (by norm_num)
      _ = 1 := by ring
  have hquarter : 1 / (4 * Gamma) ≤ (1 : ℝ) / 4 := by
    rw [div_le_div_iff₀ (by positivity : (0 : ℝ) < 4 * Gamma) (by norm_num)]
    nlinarith
  have hbracket : pV N x ^ (s + 1) *
        (1 - pV N x) ^ (j - (s + 1)) + 1 / (4 * Gamma) ≤ 5 / 4 := by
    linarith
  have hbase0 : 0 ≤ (j.choose (s + 1) : ℝ) *
      dHat D₂ D₃ D₄ d N x ^ (s + 1) / d ^ j := by positivity
  have hnext := testInside_eq_normalized (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (d := d) (N := N) (x := x) (j := j) (s := s + 1)
    hd hG hsnext hj
  have hcur := testInside_eq_normalized (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (d := d) (N := N) (x := x) (j := j) (s := s)
    hd hG hsj hj
  have hnextBound :
      testInside D₂ D₃ D₄ Gamma d N j (s + 1) x ≤
        (15 / 2 : ℝ) * dHat D₂ D₃ D₄ d N x ^ (s + 1) / d ^ j := by
    rw [hnext]
    calc
      (j.choose (s + 1) : ℝ) * dHat D₂ D₃ D₄ d N x ^ (s + 1) /
            d ^ j * (pV N x ^ (s + 1) *
              (1 - pV N x) ^ (j - (s + 1)) + 1 / (4 * Gamma)) ≤
          ((j.choose (s + 1) : ℝ) * dHat D₂ D₃ D₄ d N x ^ (s + 1) /
            d ^ j) * (5 / 4) := mul_le_mul_of_nonneg_left hbracket hbase0
      _ ≤ (6 * dHat D₂ D₃ D₄ d N x ^ (s + 1) / d ^ j) * (5 / 4) := by
        gcongr
      _ = (15 / 2 : ℝ) * dHat D₂ D₃ D₄ d N x ^ (s + 1) / d ^ j := by ring
  have hcurLower :
      dHat D₂ D₃ D₄ d N x ^ s / (4 * Gamma * d ^ j) ≤
        testInside D₂ D₃ D₄ Gamma d N j s x := by
    rw [hcur]
    have hchooseOne : (1 : ℝ) ≤ (j.choose s : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.choose_ne_zero hsj)
    have hpow0 : 0 ≤ dHat D₂ D₃ D₄ d N x ^ s / d ^ j := by positivity
    have hbracketLower : 1 / (4 * Gamma) ≤
        pV N x ^ s * (1 - pV N x) ^ (j - s) + 1 / (4 * Gamma) := by
      exact le_add_of_nonneg_left
        (mul_nonneg (pow_nonneg hp0 _) (pow_nonneg hmp0 _))
    calc
      dHat D₂ D₃ D₄ d N x ^ s / (4 * Gamma * d ^ j) =
          (1 * (dHat D₂ D₃ D₄ d N x ^ s / d ^ j)) *
            (1 / (4 * Gamma)) := by field_simp
      _ ≤ ((j.choose s : ℝ) * (dHat D₂ D₃ D₄ d N x ^ s / d ^ j)) *
            (pV N x ^ s * (1 - pV N x) ^ (j - s) + 1 / (4 * Gamma)) := by
        gcongr
      _ = (j.choose s : ℝ) * dHat D₂ D₃ D₄ d N x ^ s / d ^ j *
            (pV N x ^ s * (1 - pV N x) ^ (j - s) + 1 / (4 * Gamma)) := by ring
  calc
    ((s + 1 : ℕ) : ℝ) * testInside D₂ D₃ D₄ Gamma d N j (s + 1) x ≤
        5 * ((15 / 2 : ℝ) * dHat D₂ D₃ D₄ d N x ^ (s + 1) / d ^ j) :=
      mul_le_mul hsucc hnextBound (by rw [hnext]; positivity) (by norm_num)
    _ ≤ 160 * Gamma * dHat D₂ D₃ D₄ d N x *
          (dHat D₂ D₃ D₄ d N x ^ s / (4 * Gamma * d ^ j)) := by
      rw [pow_succ]
      field_simp [ne_of_gt hG, ne_of_gt hd]
      nlinarith [pow_nonneg hD.le s]
    _ ≤ 160 * Gamma * dHat D₂ D₃ D₄ d N x *
          testInside D₂ D₃ D₄ Gamma d N j s x := by
      gcongr

/-- Source Lemma 7.9 in a deliberately coarse finite-rank specialization. -/
theorem zeta_successor_div_hHat_le
    {D₂ D₃ D₄ Gamma epsilon d N x : ℝ} {j s : ℕ}
    (hd : 0 < d) (hN : 0 < N) (hGamma : 1 ≤ Gamma)
    (hx0 : 0 ≤ x) (hx1 : 8 * x < N)
    (hD₂0 : 0 ≤ D₂) (hD₃0 : 0 ≤ D₃) (hD₄0 : 0 ≤ D₄)
    (hsj : s ≤ j) (hj : j ≤ 4) :
    ((s + 1 : ℕ) : ℝ) * zeta D₂ D₃ D₄ Gamma epsilon d N j (s + 1) x /
        hHat D₂ D₃ D₄ d N x ≤
      1280 * Gamma / (N * pV N x) *
        zeta D₂ D₃ D₄ Gamma epsilon d N j s x := by
  have hp := pV_pos hN hx1
  have hh := hHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hN hp
  have hxi0 : 0 ≤ xi Gamma epsilon d N x := (xi_pos hd hp).le
  have hinside := testInside_successor_le hd hN hGamma hx0 hx1
    hD₂0 hD₃0 hD₄0 hsj hj
  have hid : hHat D₂ D₃ D₄ d N x =
      N * pV N x * dHat D₂ D₃ D₄ d N x / 8 := by
    unfold hHat dHat q
    ring
  change ((s + 1 : ℕ) : ℝ) *
      (xi Gamma epsilon d N x * testInside D₂ D₃ D₄ Gamma d N j (s + 1) x) /
        hHat D₂ D₃ D₄ d N x ≤
      1280 * Gamma / (N * pV N x) *
        (xi Gamma epsilon d N x * testInside D₂ D₃ D₄ Gamma d N j s x)
  rw [hid]
  have hden : 0 < N * pV N x * dHat D₂ D₃ D₄ d N x / 8 := by
    exact div_pos (mul_pos (mul_pos hN hp) (dHat_pos hd hp)) (by norm_num)
  apply (div_le_iff₀ hden).2
  have hmul := mul_le_mul_of_nonneg_left hinside hxi0
  field_simp [ne_of_gt hN, ne_of_gt hp, ne_of_gt (dHat_pos hd hp)] at hmul ⊢
  nlinarith

/-- The multiplicative part of `zetaRate` alone carries the full
`76000` logarithmic reserve; the two source-coupling terms are nonnegative. -/
theorem zetaRate_lower_of_registry
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s) :
    76000 * Gamma / (N * pV N x) *
        zeta D₂ D₃ D₄ Gamma epsilon d N j s x ≤
      zetaRate D₂ D₃ D₄ Gamma epsilon d N j s x := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := pV_pos R.delta.degree.N_pos (R.delta.degree.before_end x hx)
  have hm := pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hmargin := zeta_logarithmic_margin hd R.delta.degree.N_pos
    R.delta.degree.Gamma_one (R.delta.degree.time_nonneg x hx)
    (R.delta.degree.before_end x hx) (R.s_le_j.trans R.j_le_four)
    R.delta.degree.D₂_nonneg R.delta.degree.D₃_nonneg R.delta.degree.D₄_nonneg
    R.delta.degree.D₂_bound R.delta.degree.D₃_bound R.delta.degree.D₄_bound
  have hz0 : 0 ≤ zeta D₂ D₃ D₄ Gamma epsilon d N j s x :=
    (zeta_pos hd (lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one)
      hp hm R.s_le_j).le
  have hmul := mul_le_mul_of_nonneg_right hmargin hz0
  have hxi0 : 0 ≤ xi Gamma epsilon d N x := (xi_pos hd hp).le
  have hzp0 : 0 ≤ zHat D₂ D₃ D₄ d N j (s + 1) x := by
    unfold zHat
    exact mul_nonneg (mul_nonneg (by positivity) (pow_nonneg (q_pos hp).le _))
      (pow_nonneg hm _)
  have hD0 : 0 ≤ dHat D₂ D₃ D₄ d N x := (dHat_pos hd hp).le
  have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one
  have hh : 0 < hHat D₂ D₃ D₄ d N x :=
    hHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      hd R.delta.degree.N_pos hp
  unfold zetaRate
  calc
    76000 * Gamma / (N * pV N x) *
          zeta D₂ D₃ D₄ Gamma epsilon d N j s x ≤
        (gamma Gamma N x -
            (s : ℝ) * cHat D₂ D₃ D₄ d N x / hHat D₂ D₃ D₄ d N x -
            8 * (s : ℝ) * dHat D₂ D₃ D₄ d N x /
              hHat D₂ D₃ D₄ d N x) *
          zeta D₂ D₃ D₄ Gamma epsilon d N j s x := hmul
    _ ≤ _ := by
      have hfirst : 0 ≤ ((s + 1 : ℕ) : ℝ) * xi Gamma epsilon d N x *
          zHat D₂ D₃ D₄ d N j (s + 1) x /
            hHat D₂ D₃ D₄ d N x := by positivity
      have hsecond : 0 ≤ (s : ℝ) * (Nat.choose j s : ℝ) *
          xi Gamma epsilon d N x * dHat D₂ D₃ D₄ d N x ^ (s + 1) /
            (4 * Gamma * d ^ j * hHat D₂ D₃ D₄ d N x) := by
        apply div_nonneg <;> positivity
      linarith

theorem zHatRate_mul_hHat
    {D₂ D₃ D₄ d N x : ℝ} {j s : ℕ}
    (hh : hHat D₂ D₃ D₄ d N x ≠ 0) :
    hHat D₂ D₃ D₄ d N x * zHatRate D₂ D₃ D₄ d N j s x =
      ((s + 1 : ℕ) : ℝ) * zHat D₂ D₃ D₄ d N j (s + 1) x -
        (s : ℝ) * (cHat D₂ D₃ D₄ d N x +
          8 * dHat D₂ D₃ D₄ d N x) *
            zHat D₂ D₃ D₄ d N j s x := by
  unfold zHatRate
  field_simp

theorem xi_mul_zHat_le_zeta
    {D₂ D₃ D₄ Gamma epsilon d N x : ℝ} {j s : ℕ}
    (hd : 0 < d) (hGamma : 0 < Gamma) (hN : 0 < N)
    (hx0 : 0 ≤ x) (hx1 : 8 * x < N) :
    xi Gamma epsilon d N x * zHat D₂ D₃ D₄ d N j s x ≤
      zeta D₂ D₃ D₄ Gamma epsilon d N j s x := by
  have hp := pV_pos hN hx1
  have hm := pM_nonneg hd hN hx0
  have hxi0 : 0 ≤ xi Gamma epsilon d N x := (xi_pos hd hp).le
  change xi Gamma epsilon d N x * zHat D₂ D₃ D₄ d N j s x ≤
    xi Gamma epsilon d N x * testInside D₂ D₃ D₄ Gamma d N j s x
  unfold testInside
  apply mul_le_mul_of_nonneg_left _ hxi0
  apply le_add_of_nonneg_right
  apply div_nonneg
  · exact mul_nonneg (Nat.cast_nonneg _)
      (pow_nonneg (dHat_pos hd hp).le _)
  · exact mul_nonneg
      (mul_nonneg (by norm_num) hGamma.le) (pow_nonneg hd.le _)

theorem cHat_add_eight_dHat_le_fourteen
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ}
    (R : DegreeStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P) :
    cHat D₂ D₃ D₄ d N x + 8 * dHat D₂ D₃ D₄ d N x ≤
      14 * Gamma * dHat D₂ D₃ D₄ d N x := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.d_one
  have hp := pV_pos R.N_pos (R.before_end x hx)
  have hp1 := pV_le_one R.N_pos (R.time_nonneg x hx)
  have hm0 := pM_nonneg hd R.N_pos (R.time_nonneg x hx)
  have hm1 := pM_le_inv hd R.N_pos (R.before_end x hx).le
  have hload := conflictLoad_le_six_mul hd (le_trans zero_le_one R.Gamma_one)
    hm0 hm1 R.D₂_bound R.D₃_bound R.D₄_bound
  have hq0 : 0 ≤ q D₂ D₃ D₄ d N x := (q_pos hp).le
  have hD0 : 0 ≤ dHat D₂ D₃ D₄ d N x := (dHat_pos hd hp).le
  have hc : cHat D₂ D₃ D₄ d N x ≤
      6 * Gamma * dHat D₂ D₃ D₄ d N x := by
    have hcEq : cHat D₂ D₃ D₄ d N x =
        q D₂ D₃ D₄ d N x * conflictLoad D₂ D₃ D₄ d N x := by
      unfold cHat conflictLoad
      ring
    have hmul := mul_le_mul_of_nonneg_left hload hq0
    rw [hcEq]
    calc
      q D₂ D₃ D₄ d N x * conflictLoad D₂ D₃ D₄ d N x ≤
          q D₂ D₃ D₄ d N x * (6 * Gamma * d) := hmul
      _ = 6 * Gamma * pV N x * dHat D₂ D₃ D₄ d N x := by
        unfold q dHat
        ring
      _ ≤ 6 * Gamma * 1 * dHat D₂ D₃ D₄ d N x := by
        have hcoef0 : 0 ≤ 6 * Gamma := by
          positivity [R.Gamma_one]
        nlinarith [mul_le_mul_of_nonneg_right hp1
          (mul_nonneg hcoef0 hD0)]
      _ = 6 * Gamma * dHat D₂ D₃ D₄ d N x := by ring
  nlinarith [mul_le_mul_of_nonneg_right R.Gamma_one hD0]

/-- The old handshake error in the centered `zHatRate` costs less than
two thousand units of the logarithmic `zeta` scale. -/
theorem zHatRate_handshake_mismatch_le
    {D₂ D₃ D₄ Gamma epsilon d N x P a : ℝ} {j s : ℕ}
    (R : TestStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P j s)
    (haLo : hHat D₂ D₃ D₄ d N x * (1 - xi Gamma epsilon d N x) ≤ a)
    (haHi : a ≤ hHat D₂ D₃ D₄ d N x * (1 + xi Gamma epsilon d N x)) :
    |(a - hHat D₂ D₃ D₄ d N x) *
        zHatRate D₂ D₃ D₄ d N j s x| ≤
      2000 * hHat D₂ D₃ D₄ d N x *
        (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
          (N * pV N x)) := by
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := pV_pos R.delta.degree.N_pos (R.delta.degree.before_end x hx)
  have hh := hHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    hd R.delta.degree.N_pos hp
  have hxi0 : 0 ≤ xi Gamma epsilon d N x := (xi_pos hd hp).le
  have hm0 : 0 ≤ pM d N x := pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg x hx)
  have hq0 : 0 ≤ q D₂ D₃ D₄ d N x := (q_pos hp).le
  have hZ0 : 0 ≤ zHat D₂ D₃ D₄ d N j s x := by
    unfold zHat
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
      (pow_nonneg hm0 _)
  have hZp0 : 0 ≤ zHat D₂ D₃ D₄ d N j (s + 1) x := by
    unfold zHat
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
      (pow_nonneg hm0 _)
  have hE0 : 0 ≤ zeta D₂ D₃ D₄ Gamma epsilon d N j s x := by
    exact (zeta_pos hd
      (lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one) hp
      (pM_nonneg hd R.delta.degree.N_pos
        (R.delta.degree.time_nonneg x hx)) R.s_le_j).le
  have hb0 : 0 ≤ cHat D₂ D₃ D₄ d N x +
      8 * dHat D₂ D₃ D₄ d N x := by
    have hc0 : 0 ≤ cHat D₂ D₃ D₄ d N x := by
      unfold cHat
      exact add_nonneg
        (add_nonneg
          (mul_nonneg R.delta.degree.D₂_nonneg hq0)
          (mul_nonneg
            (mul_nonneg
              (mul_nonneg (by norm_num) R.delta.degree.D₃_nonneg) hq0) hm0))
        (mul_nonneg
          (mul_nonneg
            (mul_nonneg (by norm_num) R.delta.degree.D₄_nonneg) hq0)
          (pow_nonneg hm0 _))
    exact add_nonneg hc0
      (mul_nonneg (by norm_num) (dHat_pos hd hp).le)
  have haAbs : |a - hHat D₂ D₃ D₄ d N x| ≤
      hHat D₂ D₃ D₄ d N x * xi Gamma epsilon d N x := by
    rw [abs_le]
    constructor <;> nlinarith
  have hrateAbs : hHat D₂ D₃ D₄ d N x *
        |zHatRate D₂ D₃ D₄ d N j s x| ≤
      ((s + 1 : ℕ) : ℝ) * zHat D₂ D₃ D₄ d N j (s + 1) x +
        (s : ℝ) * (cHat D₂ D₃ D₄ d N x +
          8 * dHat D₂ D₃ D₄ d N x) *
            zHat D₂ D₃ D₄ d N j s x := by
    rw [← abs_of_pos hh, ← abs_mul, zHatRate_mul_hHat (ne_of_gt hh)]
    have hfirst0 : 0 ≤ ((s + 1 : ℕ) : ℝ) *
        zHat D₂ D₃ D₄ d N j (s + 1) x := by positivity
    have hsecond0 : 0 ≤ (s : ℝ) *
        (cHat D₂ D₃ D₄ d N x + 8 * dHat D₂ D₃ D₄ d N x) *
          zHat D₂ D₃ D₄ d N j s x := by positivity
    rw [abs_le]
    constructor <;> linarith
  have hraw : |(a - hHat D₂ D₃ D₄ d N x) *
        zHatRate D₂ D₃ D₄ d N j s x| ≤
      xi Gamma epsilon d N x *
        (((s + 1 : ℕ) : ℝ) * zHat D₂ D₃ D₄ d N j (s + 1) x +
          (s : ℝ) * (cHat D₂ D₃ D₄ d N x +
            8 * dHat D₂ D₃ D₄ d N x) *
              zHat D₂ D₃ D₄ d N j s x) := by
    rw [abs_mul]
    calc
      |a - hHat D₂ D₃ D₄ d N x| *
          |zHatRate D₂ D₃ D₄ d N j s x| ≤
        (hHat D₂ D₃ D₄ d N x * xi Gamma epsilon d N x) *
          |zHatRate D₂ D₃ D₄ d N j s x| := by gcongr
      _ = xi Gamma epsilon d N x *
          (hHat D₂ D₃ D₄ d N x *
            |zHatRate D₂ D₃ D₄ d N j s x|) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hrateAbs hxi0
  have hnext := zeta_successor_div_hHat_le (epsilon := epsilon)
    hd R.delta.degree.N_pos
    R.delta.degree.Gamma_one (R.delta.degree.time_nonneg x hx)
    (R.delta.degree.before_end x hx) R.delta.degree.D₂_nonneg
    R.delta.degree.D₃_nonneg R.delta.degree.D₄_nonneg R.s_le_j R.j_le_four
  have hxiZp := xi_mul_zHat_le_zeta (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
    (Gamma := Gamma) (epsilon := epsilon) (d := d) (N := N) (x := x)
    (j := j) (s := s + 1) hd (lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one)
    R.delta.degree.N_pos (R.delta.degree.time_nonneg x hx)
    (R.delta.degree.before_end x hx)
  have hb := cHat_add_eight_dHat_le_fourteen
    R.delta.degree
  have hnextMul : ((s + 1 : ℕ) : ℝ) *
        zeta D₂ D₃ D₄ Gamma epsilon d N j (s + 1) x ≤
      1280 * hHat D₂ D₃ D₄ d N x *
        (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
          (N * pV N x)) := by
    have hnext' := (div_le_iff₀ hh).mp hnext
    calc
      ((s + 1 : ℕ) : ℝ) *
          zeta D₂ D₃ D₄ Gamma epsilon d N j (s + 1) x ≤
        (1280 * Gamma / (N * pV N x) *
          zeta D₂ D₃ D₄ Gamma epsilon d N j s x) *
            hHat D₂ D₃ D₄ d N x := hnext'
      _ = 1280 * hHat D₂ D₃ D₄ d N x *
          (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
            (N * pV N x)) := by ring
  have hnextTerm : xi Gamma epsilon d N x * ((s + 1 : ℕ) : ℝ) *
        zHat D₂ D₃ D₄ d N j (s + 1) x ≤
      1280 * hHat D₂ D₃ D₄ d N x *
        (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
          (N * pV N x)) := by
    calc
      xi Gamma epsilon d N x * ((s + 1 : ℕ) : ℝ) *
          zHat D₂ D₃ D₄ d N j (s + 1) x =
          ((s + 1 : ℕ) : ℝ) *
            (xi Gamma epsilon d N x *
              zHat D₂ D₃ D₄ d N j (s + 1) x) := by ring
      _ ≤ ((s + 1 : ℕ) : ℝ) *
          zeta D₂ D₃ D₄ Gamma epsilon d N j (s + 1) x := by gcongr
      _ ≤ _ := hnextMul
  have hcurMul : xi Gamma epsilon d N x * (s : ℝ) *
        (cHat D₂ D₃ D₄ d N x + 8 * dHat D₂ D₃ D₄ d N x) *
          zHat D₂ D₃ D₄ d N j s x ≤
      448 * hHat D₂ D₃ D₄ d N x *
        (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
          (N * pV N x)) := by
    have hs : (s : ℝ) ≤ 4 := by exact_mod_cast R.s_le_j.trans R.j_le_four
    have hxiZ : xi Gamma epsilon d N x *
        zHat D₂ D₃ D₄ d N j s x ≤
      zeta D₂ D₃ D₄ Gamma epsilon d N j s x :=
      xi_mul_zHat_le_zeta hd
        (lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one)
        R.delta.degree.N_pos (R.delta.degree.time_nonneg x hx)
        (R.delta.degree.before_end x hx)
    have hD := dHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hp
    have hid : hHat D₂ D₃ D₄ d N x =
        N * pV N x * dHat D₂ D₃ D₄ d N x / 8 := by
      unfold hHat dHat q
      ring
    calc
      xi Gamma epsilon d N x * (s : ℝ) *
          (cHat D₂ D₃ D₄ d N x + 8 * dHat D₂ D₃ D₄ d N x) *
            zHat D₂ D₃ D₄ d N j s x =
          (s : ℝ) * (cHat D₂ D₃ D₄ d N x +
            8 * dHat D₂ D₃ D₄ d N x) *
              (xi Gamma epsilon d N x *
                zHat D₂ D₃ D₄ d N j s x) := by ring
      _ ≤ (s : ℝ) * (cHat D₂ D₃ D₄ d N x +
            8 * dHat D₂ D₃ D₄ d N x) *
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x := by gcongr
      _ ≤ 4 * (14 * Gamma * dHat D₂ D₃ D₄ d N x) *
              zeta D₂ D₃ D₄ Gamma epsilon d N j s x := by gcongr
      _ = 448 * hHat D₂ D₃ D₄ d N x *
          (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
            (N * pV N x)) := by
        rw [hid]
        field_simp [ne_of_gt R.delta.degree.N_pos, ne_of_gt hp]
        ring
  calc
    |(a - hHat D₂ D₃ D₄ d N x) *
          zHatRate D₂ D₃ D₄ d N j s x| ≤
        xi Gamma epsilon d N x *
          (((s + 1 : ℕ) : ℝ) * zHat D₂ D₃ D₄ d N j (s + 1) x +
            (s : ℝ) * (cHat D₂ D₃ D₄ d N x +
              8 * dHat D₂ D₃ D₄ d N x) *
                zHat D₂ D₃ D₄ d N j s x) := hraw
    _ ≤ 1280 * hHat D₂ D₃ D₄ d N x *
          (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
            (N * pV N x)) +
        448 * hHat D₂ D₃ D₄ d N x *
          (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
            (N * pV N x)) := by
      rw [mul_add]
      exact add_le_add
        (by simpa only [mul_assoc] using hnextTerm)
        (by simpa only [mul_assoc] using hcurMul)
    _ ≤ 2000 * hHat D₂ D₃ D₄ d N x *
          (Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
            (N * pV N x)) := by
      have hs0 : 0 ≤ Gamma * zeta D₂ D₃ D₄ Gamma epsilon d N j s x /
          (N * pV N x) := by
        exact div_nonneg
          (mul_nonneg (le_trans zero_le_one R.delta.degree.Gamma_one) hE0)
          (mul_nonneg R.delta.degree.N_pos.le hp.le)
      nlinarith [mul_nonneg hh.le hs0]

end CFMTrajectories

namespace CFMSharpTestNumeric

/-- Final linear transport behind both sharp mean-window inequalities.
All inputs are one-sided source estimates, not the desired numeric
inequalities in disguise. -/
theorem meanWindow_numeric_of_source_errors
    {h a W Z Zp E Ep b eHi eLo gain loss zRate eRate rem scale : ℝ}
    {s : ℕ}
    (hW : 0 ≤ W) (hh : 0 < h) (ha : 0 ≤ a) (hscale : 0 ≤ scale)
    (hZ : 0 ≤ Z) (hE : 0 ≤ E) (heHi : 0 ≤ eHi) (heLo : 0 ≤ eLo)
    (haLower : (4 / 5 : ℝ) * h ≤ a)
    (hrate : h * zRate = ((s + 1 : ℕ) : ℝ) * Zp - (s : ℝ) * b * Z)
    (hmismatch : |(a - h) * zRate| ≤ 2000 * h * scale)
    (hnext : ((s + 1 : ℕ) : ℝ) * Ep ≤ 1280 * h * scale)
    (hcurrent : (s : ℝ) * b * E ≤ 500 * h * scale)
    (hstatusHi : (s : ℝ) * eHi * (Z + E) ≤ 5000 * h * scale)
    (hstatusLo : (s : ℝ) * eLo * (Z - E) ≤ 5000 * h * scale)
    (hgain : gain ≤ 1000 * h * scale)
    (hloss : loss ≤ 5000 * h * scale)
    (hrem : 2 * a * rem ≤ 1000 * h * scale)
    (henvelope : 40000 * scale ≤ eRate) :
    (W * (zRate - eRate + 2 * rem)) * a ≤
        ((s + 1 : ℕ) : ℝ) * (W * (Zp - Ep)) - W * gain -
          (s : ℝ) * (b + eHi) * (W * (Z + E)) ∧
      ((s + 1 : ℕ) : ℝ) * (W * (Zp + Ep)) -
          ((s : ℝ) * (b - eLo) * (W * (Z - E)) - W * loss) ≤
        (W * (zRate + eRate - 2 * rem)) * a := by
  have hh0 : 0 ≤ h := hh.le
  have haEnv : 32000 * h * scale ≤ a * eRate := by
    have hmul := mul_le_mul haLower henvelope (by positivity) ha
    nlinarith
  have hmisUpper : (a - h) * zRate ≤ 2000 * h * scale :=
    (le_abs_self _).trans hmismatch
  have hmisLower : -(2000 * h * scale) ≤ (a - h) * zRate :=
    neg_le_of_abs_le hmismatch
  have hzUpper : a * zRate ≤ h * zRate + 2000 * h * scale := by
    nlinarith
  have hzLower : h * zRate - 2000 * h * scale ≤ a * zRate := by
    nlinarith
  constructor
  · have hcore : (zRate - eRate + 2 * rem) * a ≤
        ((s + 1 : ℕ) : ℝ) * (Zp - Ep) - gain -
          (s : ℝ) * (b + eHi) * (Z + E) := by
      calc
      (zRate - eRate + 2 * rem) * a =
          a * zRate - a * eRate + 2 * a * rem := by ring
      _ ≤ h * zRate + 2000 * h * scale - 32000 * h * scale +
          1000 * h * scale := by linarith
      _ ≤ h * zRate -
          (((s + 1 : ℕ) : ℝ) * Ep + (s : ℝ) * b * E +
            (s : ℝ) * eHi * (Z + E) + gain) := by
        linarith
      _ = ((s + 1 : ℕ) : ℝ) * (Zp - Ep) - gain -
          (s : ℝ) * (b + eHi) * (Z + E) := by
        rw [hrate]
        ring
    have hmul := mul_le_mul_of_nonneg_left hcore hW
    calc
      (W * (zRate - eRate + 2 * rem)) * a =
          W * ((zRate - eRate + 2 * rem) * a) := by ring
      _ ≤ W * (((s + 1 : ℕ) : ℝ) * (Zp - Ep) - gain -
          (s : ℝ) * (b + eHi) * (Z + E)) := hmul
      _ = ((s + 1 : ℕ) : ℝ) * (W * (Zp - Ep)) - W * gain -
          (s : ℝ) * (b + eHi) * (W * (Z + E)) := by ring
  · have hcore : ((s + 1 : ℕ) : ℝ) * (Zp + Ep) -
          ((s : ℝ) * (b - eLo) * (Z - E) - loss) ≤
        (zRate + eRate - 2 * rem) * a := by
      calc
      ((s + 1 : ℕ) : ℝ) * (Zp + Ep) -
            ((s : ℝ) * (b - eLo) * (Z - E) - loss) =
          h * zRate + ((s + 1 : ℕ) : ℝ) * Ep +
            (s : ℝ) * b * E + (s : ℝ) * eLo * (Z - E) + loss := by
        rw [hrate]
        ring
      _ ≤ h * zRate + 1280 * h * scale + 500 * h * scale +
          5000 * h * scale + 5000 * h * scale := by linarith
      _ ≤ a * zRate + a * eRate - 2 * a * rem := by linarith
      _ = (zRate + eRate - 2 * rem) * a := by ring
    have hmul := mul_le_mul_of_nonneg_left hcore hW
    calc
      ((s + 1 : ℕ) : ℝ) * (W * (Zp + Ep)) -
          ((s : ℝ) * (b - eLo) * (W * (Z - E)) - W * loss) =
        W * (((s + 1 : ℕ) : ℝ) * (Zp + Ep) -
          ((s : ℝ) * (b - eLo) * (Z - E) - loss)) := by ring
      _ ≤ W * ((zRate + eRate - 2 * rem) * a) := hmul
      _ = (W * (zRate + eRate - 2 * rem)) * a := by ring

end CFMSharpTestNumeric

theorem partialTest_meanWindow_of_gainCollision_and_lossOverlap
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (statusLo statusHi gainDefect lossDefect : ℝ)
    {plusLo plusHi currentLo currentHi targetLo targetHi : ℝ}
    (hw : ∀ S, 0 ≤ w S)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusLo0 : 0 ≤ statusLo) (hstatusHi0 : 0 ≤ statusHi)
    (hstatusLo : ∀ f ∈ availableEdges H C M,
      statusLo ≤ ((availableBlockerChoices H C M f).card : ℝ))
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi)
    (hplus : plusLo ≤ partialTestObservable w H C j (s + 1) M ∧
      partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : currentLo ≤ partialTestObservable w H C j s M ∧
      partialTestObservable w H C j s M ≤ currentHi)
    (hgainCollision :
      weightedPartialTestGainCollision w H C M j s ≤ gainDefect)
    (hlossOverlap :
      weightedPartialTestLossCollision w H C M j s ≤ lossDefect)
    (hnumericLower :
      targetLo * ((availableEdges H C M).card : ℝ) ≤
        ((s + 1 : ℕ) : ℝ) * plusLo - gainDefect -
          (s : ℝ) * statusHi * currentHi)
    (hnumericUpper :
      ((s + 1 : ℕ) : ℝ) * plusHi -
          ((s : ℝ) * statusLo * currentLo - lossDefect) ≤
        targetHi * ((availableEdges H C M).card : ℝ)) :
    targetLo ≤ meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ∧
      meanPartialTestGain w H C j s M -
        meanPartialTestLoss w H C j s M ≤ targetHi := by
  apply partialTest_meanWindow_of_choiceAbsorption w H C M j s hA
  unfold HasPartialTestChoiceAbsorption weightedPartialTestChoiceImbalance
  have hgainLower := weightedGain_sub_collision_lower_sharp
    w H C M j s hw
  have hgainUpper := weightedPartialTestGainChoices_le_succ_mul_observable
    w H C M j s hw
  have hincidence := weightedBlockerIncidence_bounds_of_statusWindow
    w H C M j s statusLo statusHi hw hstatusLo hstatusHi
  have hlossUpper := weightedLoss_le_blockerIncidence
    w H C M j s hw
  constructor
  · apply hnumericLower.trans
    apply sub_le_sub
    · exact (sub_le_sub
        (mul_le_mul_of_nonneg_left hplus.1 (by positivity))
        hgainCollision).trans hgainLower
    · exact hlossUpper.trans (hincidence.2.trans
        (mul_le_mul_of_nonneg_left hcurrent.2
          (mul_nonneg (Nat.cast_nonneg _) hstatusHi0)))
  · have hlossLower :
        (s : ℝ) * statusLo * currentLo - lossDefect ≤
          weightedPartialTestLossChoices w H C M j s := by
      have hintermediate :
          weightedPartialTestBlockerIncidence w H C M j s -
              weightedPartialTestLossCollision w H C M j s ≤
            weightedPartialTestLossChoices w H C M j s := by
        rw [← weightedLoss_add_collision_eq_blockerIncidence]
        ring_nf
        exact le_rfl
      calc
        (s : ℝ) * statusLo * currentLo - lossDefect ≤
            (s : ℝ) * statusLo *
                partialTestObservable w H C j s M -
              weightedPartialTestLossCollision w H C M j s := by
          apply sub_le_sub
          · apply mul_le_mul_of_nonneg_left hcurrent.1
            exact mul_nonneg (Nat.cast_nonneg _) hstatusLo0
          · exact hlossOverlap
        _ ≤ weightedPartialTestBlockerIncidence w H C M j s -
              weightedPartialTestLossCollision w H C M j s :=
          sub_le_sub_right hincidence.1 _
        _ ≤ weightedPartialTestLossChoices w H C M j s := hintermediate
    have hgainUpper' : weightedPartialTestGainChoices w H C M j s ≤
        ((s + 1 : ℕ) : ℝ) * plusHi :=
      hgainUpper.trans
        (mul_le_mul_of_nonneg_left hplus.2 (by positivity))
    exact (sub_le_sub hgainUpper' hlossLower).trans hnumericUpper

/-- Upper multiplicities used by the sharp averaged second moment.  The
gain/loss defect coordinates are unnecessary here: the source incidence
and the status upper window already give the exact one-sided bounds. -/
theorem partialTest_aggregateMultiplicity_upper_of_status
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ) (statusHi : ℝ)
    (hw : ∀ S, 0 ≤ w S)
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi) :
    HasPartialTestAggregateMultiplicityBounds w H C M j s
      0 ((s + 1 : ℕ) : ℝ) 0 ((s : ℝ) * statusHi) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa using weightedPartialTestGainChoices_nonneg w H C M j s hw
  · exact weightedPartialTestGainChoices_le_succ_mul_observable
      w H C M j s hw
  · simpa using weightedPartialTestLossChoices_nonneg w H C M j s hw
  · exact (weightedLoss_le_blockerIncidence w H C M j s hw).trans
      (weightedBlockerIncidence_bounds_of_statusWindow
        w H C M j s 0 statusHi hw
        (by intro f hf; exact Nat.cast_nonneg _)
        hstatusHi).2

/-- The statewise sharp second moment after substituting only the upper
trajectory corridors.  This is the exact input to the final cutoff
absorption; in particular the available-edge denominator is retained. -/
theorem meanSqPartialTestIncrement_le_of_pointwise_status_observableCaps
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (M : Hypergraph V) (j s : ℕ)
    (cap statusHi plusHi currentHi : ℝ)
    (hw : ∀ S, 0 ≤ w S) (hcap0 : 0 ≤ cap)
    (hstatusHi0 : 0 ≤ statusHi)
    (hA : (availableEdges H C M).Nonempty)
    (hstatusHi : ∀ f ∈ availableEdges H C M,
      ((availableBlockerChoices H C M f).card : ℝ) ≤ statusHi)
    (hplus : partialTestObservable w H C j (s + 1) M ≤ plusHi)
    (hcurrent : partialTestObservable w H C j s M ≤ currentHi)
    (hgainCap : ∀ e ∈ availableEdges H C M,
      partialTestStepGain w H C j s M e ≤ cap)
    (hlossCap : ∀ e ∈ availableEdges H C M,
      partialTestStepLoss w H C j s M e ≤ cap) :
    meanSqPartialTestIncrement w H C j s M ≤
      cap * ((((s + 1 : ℕ) : ℝ) * plusHi +
        ((s : ℝ) * statusHi) * currentHi) /
          ((availableEdges H C M).card : ℝ)) := by
  have hmult := partialTest_aggregateMultiplicity_upper_of_status
    w H C M j s statusHi hw hstatusHi
  apply (meanSqPartialTestIncrement_le_of_aggregateMultiplicity
    w H C M j s hw hcap0 hA hmult hgainCap hlossCap).trans
  apply mul_le_mul_of_nonneg_left _ hcap0
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact add_le_add
    (mul_le_mul_of_nonneg_left hplus (by positivity))
    (mul_le_mul_of_nonneg_left hcurrent
      (mul_nonneg (Nat.cast_nonneg _) hstatusHi0))

/-- Direct source-budget constructor for the sharp root-shadow route.  It
does not pass through `PartialTestSourceBudgets` (whose trackable singleton
cap loses the coordinate factor): raw pointwise gain/loss and the averaged
square are supplied at their natural coordinate scale. -/
theorem externalTestSourceBudgets_of_sharpRaw
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N Pfloor W : ℝ) (j s : ℕ)
    (jump variance rawJump rawVariance : ℕ → ℝ)
    (hw : ∀ S, 0 ≤ w S) (hj3 : j ≤ 3) (hW0 : 0 ≤ W)
    (hregistry : ∀ k, k < T → ∀ M, Good k M →
      CFMTrajectories.TestStepRegistry
        D₂ D₃ D₄ Gamma epsilon d N (k : ℝ) Pfloor j s)
    (hmeanLower : ∀ k, k < T → ∀ M, Good k M →
      W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) -
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon
            d N j s (k : ℝ) +
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)) ≤
        meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M)
    (hmeanUpper : ∀ k, k < T → ∀ M, Good k M →
      meanPartialTestGain w H C j s M -
          meanPartialTestLoss w H C j s M ≤
        W * (CFMTrajectories.zHatRate D₂ D₃ D₄ d N j s (k : ℝ) +
          CFMTrajectories.zetaRate D₂ D₃ D₄ Gamma epsilon
            d N j s (k : ℝ) -
          2 * (d ^ ((s : ℝ) - j - epsilon) / N)))
    (hraw0 : ∀ k, 0 ≤ rawJump k)
    (hgain : ∀ k, k < T → ∀ M, Good k M →
      ∀ e ∈ availableEdges H C M,
        partialTestStepGain w H C j s M e ≤ rawJump k)
    (hloss : ∀ k, k < T → ∀ M, Good k M →
      ∀ e ∈ availableEdges H C M,
        partialTestStepLoss w H C j s M e ≤ rawJump k)
    (hrawSquare : ∀ k, k < T → ∀ M, Good k M →
      meanSqPartialTestIncrement w H C j s M ≤ rawVariance k)
    (hjump : ∀ k, k < T →
      rawJump k + externalTestTrajectoryJump
        D₂ D₃ D₄ Gamma epsilon d N W j s k ≤ jump k)
    (hvariance : ∀ k, k < T →
      externalTestSharpVariance D₂ D₃ D₄ Gamma epsilon d N W
        j s rawVariance k ≤ variance k) :
    ExternalTestSourceBudgets w H C Good T
      D₂ D₃ D₄ Gamma epsilon d N Pfloor W j s jump variance := by
  have hrawChoice : ∀ k, k < T → ∀ M, Good k M →
      ∀ o : GreedyChoice H,
        |partialTestObservable w H C j s (greedyChoiceStep H C M o) -
          partialTestObservable w H C j s M| ≤ rawJump k := by
    intro k hk M hgood o
    rcases o with _ | e
    · simpa [greedyChoiceStep] using hraw0 k
    · by_cases he : (e : Finset V) ∈ availableEdges H C M
      · rw [greedyChoiceStep, greedyStep_eq_insert he,
          partialTestObservable_insert_sub_eq_gain_sub_loss w H C j s M e.1]
        rw [abs_le]
        constructor <;>
          linarith [hgain k hk M hgood e.1 he,
            hloss k hk M hgood e.1 he,
            partialTestStepGain_nonneg w H C M j s e.1 hw,
            partialTestStepLoss_nonneg w H C M j s e.1 hw]
      · simpa [greedyChoiceStep, greedyStep_eq_self he] using hraw0 k
  refine
    { arity := hj3
      weight_nonneg := hW0
      registry := hregistry
      meanLower := hmeanLower
      meanUpper := hmeanUpper
      upperJump := ?_
      lowerJump := ?_
      upperSquare := ?_
      lowerSquare := ?_ }
  · intro k hk M hgood o
    exact ((externalTestEnvelopeStep_abs_le_of_observableJump
      w H C D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s M
      (greedyChoiceStep H C M o) (hregistry k hk M hgood) hW0
      (hrawChoice k hk M hgood o)).1).trans (hjump k hk)
  · intro k hk M hgood o
    exact ((externalTestEnvelopeStep_abs_le_of_observableJump
      w H C D₂ D₃ D₄ Gamma epsilon d N W (k : ℝ) j s M
      (greedyChoiceStep H C M o) (hregistry k hk M hgood) hW0
      (hrawChoice k hk M hgood o)).2).trans (hjump k hk)
  · intro k hk M hgood
    exact ((externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N W j s k M
      (hregistry k hk M hgood) hW0 (hrawSquare k hk M hgood)).1).trans
        (hvariance k hk)
  · intro k hk M hgood
    exact ((externalTestEnvelopeStep_squareExpectation_le_sharpVariance
      w H C D₂ D₃ D₄ Gamma epsilon d N W j s k M
      (hregistry k hk M hgood) hW0 (hrawSquare k hk M hgood)).2).trans
        (hvariance k hk)

namespace CFMSharpTestCutoff

theorem coreEpsilon_eq (eta : ℝ) :
    CFMNumeric.coreEpsilon eta = eta / 50000 := by
  simp only [CFMNumeric.coreEpsilon, CFMRegularization.rawRegularizationEps]
  ring

theorem duplicateMargin_le_delta
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P) :
    1536 * localSpreadPrimaryMargin eta d ≤
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 1 ≤ d := R.degree.d_one
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps0 : 0 ≤ CFMNumeric.coreEpsilon eta := by
    rw [coreEpsilon_eq]
    linarith [E.eta_pos]
  have hconst : (96 : ℝ) ≤
      d ^ (3 * CFMNumeric.coreEpsilon eta / 64) := by
    calc
      (96 : ℝ) ≤ 5 ^ (3 : ℕ) := by norm_num
      _ ≤ d ^ ((3 : ℝ) * CFMNumeric.coreEpsilon eta / 64) :=
        S.envelopeFifth_pow 3
      _ = d ^ (3 * CFMNumeric.coreEpsilon eta / 64) := by norm_num
  have hpower : 96 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) ≤
      d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := by
    calc
      96 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) ≤
          d ^ (3 * CFMNumeric.coreEpsilon eta / 64) *
            d ^ (1 - CFMNumeric.coreEpsilon eta / 3) :=
        mul_le_mul_of_nonneg_right hconst (Real.rpow_nonneg hdpos.le _)
      _ = d ^ (3 * CFMNumeric.coreEpsilon eta / 64 +
          (1 - CFMNumeric.coreEpsilon eta / 3)) :=
        (Real.rpow_add hdpos _ _).symm
      _ ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le hd
        linarith
  unfold localSpreadPrimaryMargin
  calc
    1536 * (d ^ (1 - CFMNumeric.coreEpsilon eta / 3) / 16) =
        96 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) := by ring
    _ ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := hpower
    _ ≤ _ := (CFMTrajectories.delta_bounds_of_registry R hx).1

theorem statusHiError_le
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P) :
    8 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ) +
        degreeInternalCorridorError D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k ≤
      16 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.degree.d_one
  have hp := CFMTrajectories.pV_pos R.degree.N_pos
    (R.degree.before_end (k : ℝ) hx)
  have hdelta0 : 0 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) :=
    (CFMTrajectories.delta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := CFMNumeric.coreEpsilon eta) hd hp).le
  have herr := degreeInternalCorridorError_le_eight_mul_delta R
  dsimp only [degreeInternalCorridorError] at herr ⊢
  have hsmall : 8 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) ≤
      8 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
    exact mul_le_mul_of_nonneg_right (by nlinarith [E.Gamma_one]) hdelta0
  linarith

theorem statusLoError_le
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P) :
    8 * CFMTrajectories.delta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N (k : ℝ) +
        28 * d ^ (1 - eta) +
        degreeInternalCorridorError D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N k +
        1536 * localSpreadPrimaryMargin eta d ≤
      70 * Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.degree.d_one
  have hp := CFMTrajectories.pV_pos R.degree.N_pos
    (R.degree.before_end (k : ℝ) hx)
  have hdelta0 : 0 ≤ CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) :=
    (CFMTrajectories.delta_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄)
      (Gamma := Gamma) (epsilon := CFMNumeric.coreEpsilon eta) hd hp).le
  have hmean := degreeMeanError_le_sixtyFour_mul_delta E S R
  have hdup := duplicateMargin_le_delta E S R
  dsimp only [degreeInternalCorridorError] at hmean ⊢
  have hsmall : CFMTrajectories.delta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) ≤
      Gamma * CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
    simpa only [one_mul] using
      (mul_le_mul_of_nonneg_right E.Gamma_one hdelta0)
  have hrpow : d ^ (1 - eta) = Real.rpow d (1 - eta) := rfl
  rw [hrpow]
  nlinarith

theorem basePower_one_le
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    1 ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 3) := by
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hexp : 0 ≤ 1 - CFMNumeric.coreEpsilon eta / 3 := by
    rw [coreEpsilon_eq]
    nlinarith [E.eta_lt_one]
  simpa only [Real.rpow_zero] using
    (Real.rpow_le_rpow_of_exponent_le hd hexp :
      d ^ (0 : ℝ) ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 3))

theorem codegreeCeil_le_two_base
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    ((Nat.ceil (d ^ (1 - eta)) : ℕ) : ℝ) ≤
      2 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) := by
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hbase0 := Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo])
    (1 - CFMNumeric.coreEpsilon eta / 3)
  have hexp : 1 - eta ≤ 1 - CFMNumeric.coreEpsilon eta / 3 := by
    rw [coreEpsilon_eq]
    linarith [E.eta_pos]
  have hpow := Real.rpow_le_rpow_of_exponent_le hd hexp
  have hceil : ((Nat.ceil (d ^ (1 - eta)) : ℕ) : ℝ) <
      d ^ (1 - eta) + 1 :=
    Nat.ceil_lt_add_one
      (Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) (1 - eta))
  have hone := basePower_one_le E S
  linarith

theorem mixedCeil_le_three_base
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    ((certificateMixedLossCapNat eta
        (CFMRegularization.rawRegularizationEps eta) d : ℕ) : ℝ) ≤
      3 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) := by
  have hd : 1 ≤ d := by linarith [S.degreeAtLeastTwo]
  have hd0 : 0 ≤ d := le_trans zero_le_one hd
  let B := d ^ (1 - CFMNumeric.coreEpsilon eta / 3)
  have hB0 : 0 ≤ B := Real.rpow_nonneg hd0 _
  have hB1 : 1 ≤ B := by simpa only [B] using basePower_one_le E S
  have hraw : CFMRegularization.rawRegularizationEps eta / 4 =
      5 * CFMNumeric.coreEpsilon eta / 4 :=
    localSpread_raw_core_saving eta
  have hexp : 1 - CFMRegularization.rawRegularizationEps eta / 4 ≤
      1 - CFMNumeric.coreEpsilon eta / 3 := by
    rw [hraw]
    have heps0 : 0 ≤ CFMNumeric.coreEpsilon eta := by
      rw [coreEpsilon_eq]
      linarith [E.eta_pos]
    linarith
  have hpow : d ^ (1 - CFMRegularization.rawRegularizationEps eta / 4) ≤ B :=
    Real.rpow_le_rpow_of_exponent_le hd hexp
  have hmargin : 4 * localSpreadPrimaryMargin eta d = B / 4 := by
    change 4 * (d ^ (1 - CFMNumeric.coreEpsilon eta / 3) / 16) = B / 4
    dsimp only [B]
    ring
  have harg0 : 0 ≤ d ^ (1 - CFMRegularization.rawRegularizationEps eta / 4) +
      4 * localSpreadPrimaryMargin eta d := by
    exact add_nonneg (Real.rpow_nonneg hd0 _) (by rw [hmargin]; positivity)
  have hceil :
      ((Nat.ceil (d ^ (1 - CFMRegularization.rawRegularizationEps eta / 4) +
        4 * localSpreadPrimaryMargin eta d) : ℕ) : ℝ) <
      d ^ (1 - CFMRegularization.rawRegularizationEps eta / 4) +
        4 * localSpreadPrimaryMargin eta d + 1 := Nat.ceil_lt_add_one harg0
  change ((Nat.ceil (d ^ (1 - CFMRegularization.rawRegularizationEps eta / 4) +
      4 * localSpreadPrimaryMargin eta d) : ℕ) : ℝ) ≤ _
  rw [hmargin] at hceil ⊢
  dsimp only [B] at hceil ⊢
  nlinarith

theorem ccCeil_le_three_base
    {eta Gamma d : ℝ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d) :
    ((Nat.ceil (30 * localSpreadPrimaryMargin eta d) : ℕ) : ℝ) ≤
      3 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) := by
  let B := d ^ (1 - CFMNumeric.coreEpsilon eta / 3)
  have hB0 : 0 ≤ B := Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  have hB1 : 1 ≤ B := by simpa only [B] using basePower_one_le E S
  have hmargin : 30 * localSpreadPrimaryMargin eta d = 15 * B / 8 := by
    change 30 * (d ^ (1 - CFMNumeric.coreEpsilon eta / 3) / 16) = 15 * B / 8
    dsimp only [B]
    ring
  have harg0 : 0 ≤ 30 * localSpreadPrimaryMargin eta d := by
    rw [hmargin]
    positivity
  have hceil : ((Nat.ceil (30 * localSpreadPrimaryMargin eta d) : ℕ) : ℝ) <
      30 * localSpreadPrimaryMargin eta d + 1 := Nat.ceil_lt_add_one harg0
  rw [hmargin] at hceil ⊢
  dsimp only [B] at hceil ⊢
  nlinarith

theorem lossCoefficient_le_delta
    {D₂ D₃ D₄ Gamma eta d N P : ℝ} {k j s : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.DeltaStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P)
    (hsj : s ≤ j) (hj : j ≤ 4) :
    ((s.choose 2 * (4 *
        (64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d +
          Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ) ≤
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ) := by
  let B := d ^ (1 - CFMNumeric.coreEpsilon eta / 3)
  have hd : 1 ≤ d := R.degree.d_one
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have heps0 : 0 ≤ CFMNumeric.coreEpsilon eta := by
    rw [coreEpsilon_eq]
    linarith [E.eta_pos]
  have hchoose : (s.choose 2 : ℝ) ≤ 6 := by
    have hs4 : s ≤ 4 := hsj.trans hj
    interval_cases s <;> norm_num [Nat.choose]
  have hcode := codegreeCeil_le_two_base E S
  have hmixed := mixedCeil_le_three_base E S
  have hcc := ccCeil_le_three_base E S
  have hcoef :
      ((s.choose 2 * (4 *
          (64 * Nat.ceil (d ^ (1 - eta)) +
            16 * certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d +
            Nat.ceil (30 * localSpreadPrimaryMargin eta d))) : ℕ) : ℝ) ≤
        4296 * B := by
    push_cast
    dsimp only [B] at hcode hmixed hcc ⊢
    have hB0 : 0 ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 3) :=
      Real.rpow_nonneg hdpos.le _
    calc
      (s.choose 2 : ℝ) * (4 *
          (64 * (Nat.ceil (d ^ (1 - eta)) : ℝ) +
            16 * (certificateMixedLossCapNat eta
              (CFMRegularization.rawRegularizationEps eta) d : ℝ) +
            (Nat.ceil (30 * localSpreadPrimaryMargin eta d) : ℝ))) ≤
        6 * (4 *
          (64 * (2 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3)) +
            16 * (3 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3)) +
            3 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3))) := by
          gcongr
      _ = 4296 * d ^ (1 - CFMNumeric.coreEpsilon eta / 3) := by ring
  have hconst : (4296 : ℝ) ≤
      d ^ (6 * CFMNumeric.coreEpsilon eta / 64) := by
    calc
      (4296 : ℝ) ≤ 5 ^ (6 : ℕ) := by norm_num
      _ ≤ d ^ ((6 : ℝ) * CFMNumeric.coreEpsilon eta / 64) :=
        S.envelopeFifth_pow 6
      _ = d ^ (6 * CFMNumeric.coreEpsilon eta / 64) := by norm_num
  have habsorb : 4296 * B ≤
      d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := by
    calc
      4296 * B ≤ d ^ (6 * CFMNumeric.coreEpsilon eta / 64) * B :=
        mul_le_mul_of_nonneg_right hconst (Real.rpow_nonneg hdpos.le _)
      _ = d ^ (6 * CFMNumeric.coreEpsilon eta / 64 +
          (1 - CFMNumeric.coreEpsilon eta / 3)) := by
        dsimp only [B]
        exact (Real.rpow_add hdpos _ _).symm
      _ ≤ d ^ (1 - CFMNumeric.coreEpsilon eta / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le hd
        linarith
  exact hcoef.trans (habsorb.trans
    (CFMTrajectories.delta_bounds_of_registry R (by simp)).1)

/-- Any nonnegative coefficient below `500 Γ δ`, multiplied by the whole
test corridor, fits in the common sharp-mean scale. -/
theorem corridorProduct_le_commonScale
    {D₂ D₃ D₄ Gamma eta d N P e : ℝ} {k j s : ℕ}
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (R : CFMTrajectories.TestStepRegistry D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) P j s)
    (he0 : 0 ≤ e)
    (he : e ≤ 500 * Gamma *
      CFMTrajectories.delta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) :
    e * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)) ≤
      5000 * CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
        (Gamma * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) /
            (N * CFMTrajectories.pV N (k : ℝ))) := by
  have hx : (k : ℝ) ∈ Set.Icc (k : ℝ) ((k : ℝ) + 1) := by simp
  have hd : 0 < d := lt_of_lt_of_le zero_lt_one R.delta.degree.d_one
  have hp := CFMTrajectories.pV_pos R.delta.degree.N_pos
    (R.delta.degree.before_end (k : ℝ) hx)
  have hm := CFMTrajectories.pM_nonneg hd R.delta.degree.N_pos
    (R.delta.degree.time_nonneg (k : ℝ) hx)
  have hxi0 : 0 ≤ CFMTrajectories.xi Gamma
      (CFMNumeric.coreEpsilon eta) d N (k : ℝ) :=
    (CFMTrajectories.xi_pos (Gamma := Gamma)
      (epsilon := CFMNumeric.coreEpsilon eta) hd hp).le
  have hD := CFMTrajectories.dHat_pos (D₂ := D₂) (D₃ := D₃) (D₄ := D₄) hd hp
  have hZ0 : 0 ≤ CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) := by
    unfold CFMTrajectories.zHat
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (CFMTrajectories.q_pos hp).le _))
      (pow_nonneg hm _)
  have hE0 : 0 ≤ CFMTrajectories.zeta D₂ D₃ D₄ Gamma
      (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) :=
    (CFMTrajectories.zeta_pos hd
      (lt_of_lt_of_le zero_lt_one R.delta.degree.Gamma_one) hp hm R.s_le_j).le
  have hxi : CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) ≤
      1 / 5 :=
    (R.delta.xi_upper (k : ℝ) hx).trans (CFMNumeric.envelopeFactor_le_fifth S)
  have hxiZ : CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) *
        CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) ≤
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) := by
    change CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) *
        CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) ≤
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) *
        CFMTrajectories.testInside D₂ D₃ D₄ Gamma d N j s (k : ℝ)
    unfold CFMTrajectories.testInside
    apply mul_le_mul_of_nonneg_left _ hxi0
    apply le_add_of_nonneg_right
    apply div_nonneg
    · exact mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hD.le _)
    · exact mul_nonneg
        (mul_nonneg (by norm_num)
          (le_trans zero_le_one R.delta.degree.Gamma_one))
        (pow_nonneg hd.le _)
  have hxiE : CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) *
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) ≤
      (1 / 5) * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) :=
    mul_le_mul_of_nonneg_right hxi hE0
  have hxiSum :
      CFMTrajectories.xi Gamma (CFMNumeric.coreEpsilon eta) d N (k : ℝ) *
          (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma
              (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)) ≤
        (6 / 5) * CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) := by
    rw [mul_add]
    linarith
  have hsum0 : 0 ≤ CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma
        (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ) := add_nonneg hZ0 hE0
  have hGamma0 : 0 ≤ Gamma := le_trans zero_le_one R.delta.degree.Gamma_one
  have hid : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) =
      N * CFMTrajectories.pV N (k : ℝ) *
        CFMTrajectories.dHat D₂ D₃ D₄ d N (k : ℝ) / 8 := by
    unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
    ring
  calc
    e * (CFMTrajectories.zHat D₂ D₃ D₄ d N j s (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ Gamma
          (CFMNumeric.coreEpsilon eta) d N j s (k : ℝ)) ≤
