    apply Finset.sum_eq_zero <;> intro o ho
  · rw [(activeInternalConflictLinkSteps_eq_zero_of_inactive
      H C f D₂ D₃ D₄ Gamma epsilon d N scale x j s M hf o).1, mul_zero]
  · rw [(activeInternalConflictLinkSteps_eq_zero_of_inactive
      H C f D₂ D₃ D₄ Gamma epsilon d N scale x j s M hf o).2, mul_zero]

theorem greedyStepExpectation_activeInternalConflictLinkSteps_sq_eq_zero_of_inactive
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
