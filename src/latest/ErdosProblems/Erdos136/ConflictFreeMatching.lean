    dsimp only [Zp]
    unfold CFMTrajectories.zHat
    exact mul_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
      (pow_nonneg hm _)
  have hinside0 : 0 ≤ inside := by
    dsimp only [inside]
    unfold CFMTrajectories.testInside
