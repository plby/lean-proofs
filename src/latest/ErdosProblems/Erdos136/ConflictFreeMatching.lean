theorem persistentInternalConflictLinkFreedman_of_reachableSourceBudgets
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (hCempty : ∅ ∉ C) (f : Finset V)
    (Good : ℕ → Hypergraph V → Prop) (T : ℕ)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, Good k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachablePersistentInternalConflictLinkSourceBudgets H C f Good T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance)
    {R t Wvar : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ Wvar)
    (hden : 0 < Wvar + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ Wvar) :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C ∅ T Good
              (fun i S S' ↦ persistentInternalConflictLinkUpperStep H C f
                D₂ D₃ D₄ Gamma epsilon d N scale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (Finset.univ.filter (fun omega ↦
          t ≤ Freedman.partialSum
            (greedyStoppedStepIncrement H C ∅ T Good
              (fun i S S' ↦ persistentInternalConflictLinkLowerStep H C f
                D₂ D₃ D₄ Gamma epsilon d N scale
                  (i : ℝ) j s S S')) T omega)) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have hm := persistentInternalConflictLinkStoppedMomentBounds_of_reachableSourceBudgets
    H C hC hCempty f Good T D₂ D₃ D₄ Gamma epsilon d N P scale j s
      jump variance hjump hvariance havailable B
  have hinc :=
    persistentInternalConflictLinkStoppedIncrements_abs_le_of_reachableSourceBudgets
      H C f Good T D₂ D₃ D₄ Gamma epsilon d N P scale j s
        jump variance hR0 hR B
  constructor
  · exact Freedman.freedman
      (normalizedGreedyPathMass_nonneg H C)
      (sum_normalizedGreedyPathMass H C T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C ∅ T Good
        (fun i S S' ↦ persistentInternalConflictLinkUpperStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S') k)
      hm.1 hR0 ht hW0 hden hinc.1 hW
  · exact Freedman.freedman
      (normalizedGreedyPathMass_nonneg H C)
      (sum_normalizedGreedyPathMass H C T)
      (greedyInfo_isFiltration H T)
      (fun k ↦ greedyStoppedStepIncrement_known H C ∅ T Good
        (fun i S S' ↦ persistentInternalConflictLinkLowerStep H C f
          D₂ D₃ D₄ Gamma epsilon d N scale (i : ℝ) j s S S') k)
      hm.2 hR0 ht hW0 hden hinc.2 hW

theorem persistentInternalConflictLinkFirstFailureMass_le_of_reachableSourceBudgets
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (hCempty : ∅ ∉ C) (T : ℕ)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N P scale : ℝ) (j s : ℕ)
    (jump variance : ℕ → ℝ)
    (hjump : ∀ k, 0 ≤ jump k) (hvariance : ∀ k, 0 ≤ variance k)
    (havailable : ∀ k, k < T → ∀ S, indexedGreedyGood Pgood k S →
      IsConflictFreeMatching H C S → S.card = k →
      (availableEdges H C S).Nonempty)
    (B : ReachablePersistentInternalConflictLinkSourceBudgets H C f
      (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s jump variance)
    {R t Wvar : ℝ} (hR0 : 0 ≤ R) (ht : 0 ≤ t) (hW0 : 0 ≤ Wvar)
    (hden : 0 < Wvar + R * t)
    (hR : ∀ k, k < T → jump k ≤ R)
    (hW : ∑ k ∈ Finset.range T, variance k ≤ Wvar)
    (hUpperComponent : ∀ k S, Pgood iUpper k S ↔
      internalConflictLinkUpperCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k S)
    (hLowerComponent : ∀ k S, Pgood iLower k S ↔
      internalConflictLinkLowerCorridor H C f
        D₂ D₃ D₄ Gamma epsilon d N scale j s k S)
    (hUpperInitial : internalConflictLinkUpperError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s 0 ∅ ≤ -t)
    (hLowerInitial : internalConflictLinkLowerError H C f
      D₂ D₃ D₄ Gamma epsilon d N scale j s 0 ∅ ≤ -t) :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ T Pgood iUpper) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ T Pgood iLower) ≤
        Real.exp (-(t ^ 2) / (4 * (Wvar + R * t))) := by
  have htail := persistentInternalConflictLinkFreedman_of_reachableSourceBudgets
    H C hC hCempty f (indexedGreedyGood Pgood) T
      D₂ D₃ D₄ Gamma epsilon d N P scale j s
      jump variance hjump hvariance havailable B hR0 ht hW0 hden hR hW
  constructor
  · exact (eventMass_mono_of_nonneg (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (persistentInternalConflictLinkUpperFirstFailureEvent_subset_tail
        H C T Pgood iUpper f D₂ D₃ D₄ Gamma epsilon d N scale t j s
        hUpperComponent hUpperInitial)).trans htail.1
  · exact (eventMass_mono_of_nonneg (normalizedGreedyPathMass H C)
      (normalizedGreedyPathMass_nonneg H C)
      (persistentInternalConflictLinkLowerFirstFailureEvent_subset_tail
        H C T Pgood iLower f D₂ D₃ D₄ Gamma epsilon d N scale t j s
        hLowerComponent hLowerInitial)).trans htail.2

end

/-! ## Integrated: FinalFirstFailureProjectionAndCommonTail -/


open Finset Real
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V]

/-! ## First-failure projection between two stopping predicates -/

/-- If the simultaneous `P`-predicate implies the simultaneous `Q`-predicate
at every state, and the selected components agree, then first failure of the
selected `P`-component forces first failure of the selected `Q`-component.

This is deliberately a cross-predicate statement: the existing component
implication lemma only compares two coordinates of one indexed predicate. -/
theorem greedyFirstFailureEvent_subset_of_crossPredicateProjection
    {I J : Type*} [Fintype I] [Fintype J]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop)
    (Q : J → ℕ → Hypergraph V → Prop) (i : I) (j : J)
    (hgood : ∀ k S, indexedGreedyGood P k S → indexedGreedyGood Q k S)
    (hcomponent : ∀ k S, P i k S ↔ Q j k S) :
    greedyFirstFailureEvent H C M T P i ⊆
      greedyFirstFailureEvent H C M T Q j := by
  intro omega homega
  rw [greedyFirstFailureEvent, Finset.mem_filter] at homega ⊢
  obtain ⟨homegaUniv, k, hk, hprefix, hfail⟩ := homega
  refine ⟨homegaUniv, k, hk, ?_, ?_⟩
  · intro m hm
    exact hgood m (greedyStateFromAt H C M omega m) (hprefix m hm)
  · intro hq
    exact hfail ((hcomponent (k + 1)
      (greedyStateFromAt H C M omega (k + 1))).mpr hq)

/-- Event-mass form of
`greedyFirstFailureEvent_subset_of_crossPredicateProjection`. -/
theorem firstFailureMass_le_of_crossPredicateProjection
    {I J : Type*} [Fintype I] [Fintype J]
    (H : Hypergraph V) (C : ConflictSystem V) (M : Hypergraph V) (T : ℕ)
    (P : I → ℕ → Hypergraph V → Prop)
    (Q : J → ℕ → Hypergraph V → Prop) (i : I) (j : J)
    (p : GreedyOutcome H T → ℝ) (hp : ∀ omega, 0 ≤ p omega)
    (hgood : ∀ k S, indexedGreedyGood P k S → indexedGreedyGood Q k S)
    (hcomponent : ∀ k S, P i k S ↔ Q j k S) :
    Freedman.eventMass p (greedyFirstFailureEvent H C M T P i) ≤
      Freedman.eventMass p (greedyFirstFailureEvent H C M T Q j) := by
  exact eventMass_mono_of_nonneg p hp
    (greedyFirstFailureEvent_subset_of_crossPredicateProjection
      H C M T P Q i j hgood hcomponent)

namespace CFMNumericAggregation

open CFMNumeric

variable [Fintype V]

/-! ## Reachable source packages imply the common test tail -/

/-- The reachable external source package has exactly the same scalar
Freedman parameters as the older state-uniform source package. -/
theorem reachableExternalPairFirstFailure_le_common
    {iota : Type*} [Fintype iota]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (hCempty : ∅ ∉ C)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota)
    (D₂ D₃ D₄ Gamma eta d Pfloor Wscale P : ℝ) (N : ℕ) (j s : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (havailable : ∀ k, k < targetTime eta d N → ∀ M,
      indexedGreedyGood Pgood k M → IsConflictFreeMatching H C M →
      M.card = k → (availableEdges H C M).Nonempty)
    (B : PositivePairedFirstFailureSourceBudgets P
      (ReachableExternalTestSourceBudgets w H C (indexedGreedyGood Pgood)
        (targetTime eta d N) D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ)
        Pfloor Wscale j s
        (fun _ ↦ testSourceJumpScale P d (coreEpsilon eta))
        (fun _ ↦ testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)))
      (externalTestUpperError w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s 0 ∅)
      (externalTestLowerError w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s 0 ∅)
      (testDeviation Gamma P d (coreEpsilon eta)))
    (hUpperComponent : ∀ k M, Pgood iUpper k M ↔
      externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s k M)
    (hLowerComponent : ∀ k M, Pgood iLower k M ↔
      externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s k M) :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iUpper) ≤
          commonTail eta d ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iLower) ≤
          commonTail eta d := by
  let T := targetTime eta d N
  let J := testSourceJumpScale P d (coreEpsilon eta)
  let Vvar := testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)
  let t := testDeviation Gamma P d (coreEpsilon eta)
  let Wvar := (T : ℝ) * Vvar
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < (N : ℝ) :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hNlower
  have hJ : 0 < J := by
    unfold J testSourceJumpScale
    exact mul_pos B.scale_pos (Real.rpow_pos_of_pos hd _)
  have hV : 0 ≤ Vvar := by
    unfold Vvar testFreedmanVarianceScale testSourceVarianceScale
    exact mul_nonneg (by norm_num)
      (div_nonneg (mul_nonneg (sq_nonneg P) (Real.rpow_nonneg hd.le _)) hNpos.le)
  have ht : 0 < t := by
    unfold t testDeviation
    have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one E.Gamma_one
    exact div_pos (mul_pos B.scale_pos (Real.rpow_pos_of_pos hd _))
      (mul_pos (by norm_num) hG)
  have hW0 : 0 ≤ Wvar := by unfold Wvar; positivity
  have hden : 0 < Wvar + J * t := by positivity
  have hW : ∑ k ∈ Finset.range T, Vvar ≤ Wvar := by simp [Wvar]
  have htail := externalTestFirstFailureMass_le_of_reachableSourceBudgets
    w H C hCempty T Pgood iUpper iLower
    D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ) Pfloor Wscale j s
    (fun _ ↦ J) (fun _ ↦ Vvar)
    (fun _ ↦ hJ.le) (fun _ ↦ hV)
    (by simpa only [T] using havailable)
    (by simpa only [T, J, Vvar] using B.sourceBudgets)
    hJ.le ht.le hW0 hden (fun k hk ↦ le_rfl) hW
    hUpperComponent hLowerComponent B.upperGap B.lowerGap
  have hcommon := test_freedmanTail_le_common S E.Gamma_one
    (by
      rw [show coreEpsilon eta = eta / 50000 by
        simp only [coreEpsilon, CFMRegularization.rawRegularizationEps]
        ring]
      linarith [E.eta_pos]) B.scale_pos hNpos (Nat.cast_nonneg T) (by
      simpa only [T] using targetTime_cast_le_host E.eta_pos S hNlower)
  constructor
  · exact htail.1.trans (by simpa only [T, t, Wvar, Vvar, J] using hcommon)
  · exact htail.2.trans (by simpa only [T, t, Wvar, Vvar, J] using hcommon)

/-- Persistent internal-link sources use the same test-family scalar tail.
The concrete persistent mean construction remains entirely outside this
adapter and is represented only by the generic source package `B`. -/
theorem persistentInternalPairFirstFailure_le_common
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (hCempty : ∅ ∉ C)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota) (f : Finset V)
    (D₂ D₃ D₄ Gamma eta d Pfloor scale P : ℝ) (N : ℕ) (j s : ℕ)
    (E : CFMNumeric.CoreExponentSpec eta Gamma)
    (S : CFMNumeric.CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (havailable : ∀ k, k < targetTime eta d N → ∀ M,
      indexedGreedyGood Pgood k M → IsConflictFreeMatching H C M →
      M.card = k → (availableEdges H C M).Nonempty)
    (B : PositivePairedFirstFailureSourceBudgets P
      (ReachablePersistentInternalConflictLinkSourceBudgets H C f
        (indexedGreedyGood Pgood) (targetTime eta d N)
        D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ) Pfloor scale j s
        (fun _ ↦ testSourceJumpScale P d (coreEpsilon eta))
        (fun _ ↦ testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)))
      (internalConflictLinkUpperError H C f D₂ D₃ D₄ Gamma
