  let a : VertexLocalThroughSpreadTailCoordinate H :=
    (e, v, Sum.inr x)
  have hcorr := indexedVertexLocalThroughSpreadGood_tail
    H C eta d N T hgood a
  have hlt : testTotal (vertexLocalThroughSpreadDerivativeWeight
      H C e.1 v.1 x.1) M 1 < localSpreadDerivativeCap eta d N k := by
    apply sub_neg.mp
    simpa [localSpreadUpperCorridor, localSpreadUpperError,
      a, vertexLocalThroughSpreadTailBaseWeight,
      vertexLocalThroughSpreadTailRank,
      vertexLocalThroughSpreadConcreteCap] using hcorr
  exact hlt.le

theorem sourceConflictLinkInteractionAtVertex_isRealSpread_core
    {iota : Type*} [Fintype iota]
    {eta d GammaCert : ℝ} {ell : ℕ}
    {H : Hypergraph V} {C : ConflictSystem V}
    {j : iota → ℕ} {w : iota → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (hd : 0 < d) (e : Finset V) (q : ℕ) (v : V)
    (hq2 : 2 ≤ q) (hq3 : q ≤ 3) :
    IsRealSpread
      (sourceConflictLinkInteractionAtVertex H R.regularized e q v) q
      (Real.rpow d ((q : ℝ) - 5 * CFMNumeric.coreEpsilon eta / 4)) d⁻¹ := by
  have h := sourceConflictLinkInteractionAtVertex_isRealSpread
    R.bounded hdegreeUpper hd e q v hq2 hq3
  simpa only [localSpread_raw_core_saving eta] using h

theorem sourceConflictLinkInteractionAtVertex_subset_host_certificate
    {iota : Type*} [Fintype iota]
    {eta d GammaCert : ℝ} {ell : ℕ}
    {H : Hypergraph V} {C : ConflictSystem V}
    {j : iota → ℕ} {w : iota → TestWeight V}
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (e : Finset V) (q : ℕ) (v : V) :
    ∀ Q ∈ sourceConflictLinkInteractionAtVertex H R.regularized e q v,
      Q ⊆ H := by
  intro Q hQ
  exact conflictLinkLayer_subset_host R.isConflictSystem e q Q
    (Finset.mem_filter.mp hQ).1

/-- Closed concrete source budgets for every degree-through-vertex tail
coordinate, assuming only the common availability floor and projection of
the ambient Good predicate to the local coordinate family. -/
theorem vertexLocalThroughSpreadConcreteSourceBudgets_of_available
    [Fintype V] {iota ι : Type*} [Fintype iota] [Fintype ι]
    {eta GammaCore GammaCert d N : ℝ} {T ell : ℕ}
    (E : CFMNumeric.CoreExponentSpec eta GammaCore)
    (S : CFMNumeric.CoreCutoffSpec eta GammaCore d)
    (H : Hypergraph V) (C : ConflictSystem V)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate H C d
      (CFMRegularization.rawRegularizationEps eta) GammaCert ell j w)
    (hNpos : 0 < N)
    (hdegreeUpper : ∀ v, (degree H v : ℝ) ≤ d)
    (P : ι → ℕ → Hypergraph V → Prop)
    (hlocal : ∀ k M, indexedGreedyGood P k M →
      indexedGreedyGood
        (vertexLocalThroughSpreadLocalPredicate
          H R.regularized eta d N T) k M)
    (havailable : ∀ k, k < T → ∀ M, indexedGreedyGood P k M →
      localSpreadAvailableFloor eta d N ≤
        ((availableEdges H R.regularized M).card : ℝ))
    (a : VertexLocalThroughSpreadTailCoordinate H) :
    LocalSpreadUpperSourceBudgets
      (vertexLocalThroughSpreadTailBaseWeight H R.regularized a)
      H R.regularized (indexedGreedyGood P) T
      (vertexLocalThroughSpreadTailRank a)
      (vertexLocalThroughSpreadConcreteCap eta d N T a)
      (vertexLocalThroughSpreadConcreteJump eta d N a) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hfloor : 0 < localSpreadAvailableFloor eta d N := by
    rw [localSpreadAvailableFloor_eq_rpow hd]
    exact div_pos (mul_pos hNpos (Real.rpow_pos_of_pos hd _)) (by norm_num)
  have hsmall0 : 0 ≤ localSpreadSmallDrift eta d N := by
    unfold localSpreadSmallDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hfloor.le
  have haggregate0 : 0 ≤ localSpreadAggregateDrift eta d N := by
    unfold localSpreadAggregateDrift
    exact div_nonneg
      (mul_nonneg (by norm_num) (Real.rpow_nonneg hd.le _)) hfloor.le
  have hderivativeCap0 : ∀ k, 0 ≤ localSpreadDerivativeCap eta d N k := by
    intro k
    unfold localSpreadDerivativeCap localSpreadLinearCap
      localSpreadDerivativeMargin
    exact add_nonneg
      (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
      (mul_nonneg (Nat.cast_nonneg k) hsmall0)
  have haggregateCap0 : ∀ k, 0 ≤ localSpreadAggregateCap eta d N k := by
    intro k
    unfold localSpreadAggregateCap localSpreadLinearCap
      localSpreadAggregateMargin
    exact add_nonneg
      (div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num))
      (mul_nonneg (Nat.cast_nonneg k) haggregate0)
  rcases a with ⟨e, v, kind⟩
  rcases kind with z | x
  · fin_cases z
    · have hZ := sourceConflictLinkInteractionAtVertex_isRealSpread_core
        R hdegreeUpper hd e.1 2 v.1 (by omega) (by omega)
      have hsrc := localSpreadUpperSourceBudgets_rank_one_of_realSpread
        (sourceConflictLinkInteractionAtVertex H R.regularized e.1 2 v.1)
        2 hZ H
        (sourceConflictLinkInteractionAtVertex_subset_host_certificate
          R e.1 2 v.1)
        R.regularized (indexedGreedyGood P) T
        (localSpreadQ2PrimaryCap eta d N)
        (fun _ ↦ localSpreadAvailableFloor eta d N)
        (by omega) (Real.rpow_nonneg hd.le _) (inv_nonneg.mpr hd.le)
        (by
          intro k
          unfold localSpreadQ2PrimaryCap
          rw [localSpreadLinearCap_step]
          exact hsmall0)
        (by intro k hk; exact hfloor)
        havailable
        (by
          intro k hk
          unfold localSpreadQ2PrimaryCap
          rw [localSpreadLinearCap_step]
          unfold localSpreadSmallDrift
          exact div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_right (by norm_num)
              (Real.rpow_nonneg hd.le _)) hfloor.le)
      have hjump :
          (fun _ : ℕ ↦
            Real.rpow d (((2 : ℕ) : ℝ) -
              5 * CFMNumeric.coreEpsilon eta / 4) * d⁻¹) =
            (fun _ ↦ localSpreadSmallJump eta d) := by
        funext k
        norm_num
        exact localSpread_q2_spread_jump_eq hd
      rw [hjump] at hsrc
      simpa [vertexLocalThroughSpreadTailBaseWeight,
        vertexLocalThroughSpreadWeight,
        vertexLocalThroughSpreadTailRank,
        vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteJump] using hsrc
    · have hZ := sourceConflictLinkInteractionAtVertex_isRealSpread_core
        R hdegreeUpper hd e.1 3 v.1 (by omega) (by omega)
      have hsrc := localSpreadUpperSourceBudgets_rank_one_of_realSpread
        (sourceConflictLinkInteractionAtVertex H R.regularized e.1 3 v.1)
        3 hZ H
        (sourceConflictLinkInteractionAtVertex_subset_host_certificate
          R e.1 3 v.1)
        R.regularized (indexedGreedyGood P) T
        (localSpreadAggregateCap eta d N)
        (fun _ ↦ localSpreadAvailableFloor eta d N)
        (by omega) (Real.rpow_nonneg hd.le _) (inv_nonneg.mpr hd.le)
        (by
          intro k
          unfold localSpreadAggregateCap
          rw [localSpreadLinearCap_step]
          exact haggregate0)
        (by intro k hk; exact hfloor)
        havailable
        (by
          intro k hk
          unfold localSpreadAggregateCap
          rw [localSpreadLinearCap_step]
          unfold localSpreadAggregateDrift
          rfl)
      have hjump :
          (fun _ : ℕ ↦
            Real.rpow d (((3 : ℕ) : ℝ) -
              5 * CFMNumeric.coreEpsilon eta / 4) * d⁻¹) =
            (fun _ ↦ localSpreadAggregateJump eta d) := by
        funext k
        norm_num
        exact localSpread_q3_spread_jump_eq hd
      rw [hjump] at hsrc
      simpa [vertexLocalThroughSpreadTailBaseWeight,
        vertexLocalThroughSpreadWeight,
        vertexLocalThroughSpreadTailRank,
        vertexLocalThroughSpreadConcreteCap,
        vertexLocalThroughSpreadConcreteJump] using hsrc
    · have hZ := sourceConflictLinkInteractionAtVertex_isRealSpread_core
        R hdegreeUpper hd e.1 3 v.1 (by omega) (by omega)
      apply localSpreadUpperSourceBudgets_rank_two_shadow
        (sourceConflictLinkInteractionAtVertex H R.regularized e.1 3 v.1)
        3 hZ.1 H R.regularized (indexedGreedyGood P) T
        (localSpreadQ3PrimaryCap eta d N T)
        (localSpreadDerivativeCap eta d N)
        (fun _ ↦ localSpreadAvailableFloor eta d N)
        (localSpreadAggregateCap eta d N)
      · exact conflictFamilyShadowWeight_nonneg _
      · intro k
        unfold localSpreadQ3PrimaryCap
        rw [localSpreadLinearCap_step]
        unfold localSpreadQ3PrimaryDrift
        exact div_nonneg
          (mul_nonneg (by norm_num) (haggregateCap0 T)) hfloor.le
      · exact hderivativeCap0
      · exact haggregateCap0
      · intro k hk
        exact hfloor
      · exact havailable
      · intro k hk M hgood
        exact vertexLocalThroughSpreadAggregateCap_of_localGood
          H R.regularized eta d N T (hlocal k M hgood) e v
      · intro k hk M hgood y hy
        let y' : {f : Finset V // f ∈ H} :=
