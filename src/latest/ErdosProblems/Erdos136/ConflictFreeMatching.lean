      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta)
      d N (k : ℝ) (CFMNumeric.trajectoryFloor eta d) 1 1)
    (haLo : CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ) *
      (1 - CFMTrajectories.xi (6 * (2 * (ell : ℝ) + 1))
        (CFMNumeric.coreEpsilon eta) d N (k : ℝ)) ≤ a) :
    let scale := certificateInternalLayerScale H C d
      (CFMRegularization.rawRegularizationEps eta)
      (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2
    let status := certificateTestStatusHi D₂ D₃ D₄
      (6 * (2 * (ell : ℝ) + 1)) (CFMNumeric.coreEpsilon eta) d N k
    let currentHi := scale *
      (CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ) +
        CFMTrajectories.zeta D₂ D₃ D₄ (6 * (2 * (ell : ℝ) + 1))
          (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ))
    let victimScale : ℝ :=
      ((Nat.ceil (Real.rpow d
            (1 - CFMRegularization.rawRegularizationEps eta / 4)) +
        Nat.ceil (∑ r ∈ Finset.Icc (2 : ℕ) 3,
          2 * finiteWeightedRootShadowMargin eta d
            ((3 * (2 * (ell : ℝ) + 1) + 1) *
              Real.rpow d ((r : ℝ) -
                CFMRegularization.rawRegularizationEps eta / 4))
            0 (r - 1)) : ℕ) : ℝ)
    ((((64 * Nat.ceil (d ^ (1 - eta)) +
          16 * certificateMixedLossCapNat eta
            (CFMRegularization.rawRegularizationEps eta) d : ℕ) : ℝ) *
        currentHi + status * victimScale) / a) +
      (status / a) *
        (scale *
          ((2 * CFMTrajectories.zHat D₂ D₃ D₄ d N 1 2 (k : ℝ) +
            status * CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ)) /
            CFMTrajectories.hHat D₂ D₃ D₄ d N (k : ℝ))) ≤
      30400 * (scale *
        ((6 * (2 * (ell : ℝ) + 1)) *
          CFMTrajectories.zeta D₂ D₃ D₄
            (6 * (2 * (ell : ℝ) + 1))
            (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ) /
              (N * CFMTrajectories.pV N (k : ℝ)))) := by
  dsimp only
  let G : ℝ := 6 * (2 * (ell : ℝ) + 1)
  let scale := certificateInternalLayerScale H C d
    (CFMRegularization.rawRegularizationEps eta)
    (2 * (ell : ℝ) + 1) ell testJ testW Rcert 2
  let status := certificateTestStatusHi D₂ D₃ D₄ G
    (CFMNumeric.coreEpsilon eta) d N k
  let Z := CFMTrajectories.zHat D₂ D₃ D₄ d N 1 1 (k : ℝ)
  let Env := CFMTrajectories.zeta D₂ D₃ D₄ G
    (CFMNumeric.coreEpsilon eta) d N 1 1 (k : ℝ)
  let currentHi := scale * (Z + Env)
  let victimScale : ℝ :=
    ((Nat.ceil (Real.rpow d
          (1 - CFMRegularization.rawRegularizationEps eta / 4)) +
      Nat.ceil (∑ r ∈ Finset.Icc (2 : ℕ) 3,
        2 * finiteWeightedRootShadowMargin eta d
          ((3 * (2 * (ell : ℝ) + 1) + 1) *
            Real.rpow d ((r : ℝ) -
              CFMRegularization.rawRegularizationEps eta / 4))
          0 (r - 1)) : ℕ) : ℝ)
