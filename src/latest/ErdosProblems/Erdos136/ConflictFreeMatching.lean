open scoped BigOperators Topology

noncomputable section

/-! ## Sharp common Freedman scales -/

def degreeTrajectoryScale (Gamma eta d N : ℝ) : ℝ :=
  80000 * Gamma * d / (N * trajectoryFloor eta d)

def degreeFreedmanVarianceScale (d epsilon N : ℝ) : ℝ :=
  4 * degreeSourceVarianceScale d epsilon N

def degreeDeviation (d epsilon : ℝ) : ℝ :=
  d ^ (1 - epsilon / 32) / 2

def testFreedmanVarianceScale (P d epsilon N : ℝ) : ℝ :=
  4 * testSourceVarianceScale P d epsilon N

def testDeviation (Gamma P d epsilon : ℝ) : ℝ :=
  P * d ^ (-epsilon / 32) / (4 * Gamma)

def commonTail (eta d : ℝ) : ℝ :=
  exp (-(5 * d ^ tailPower eta))

/-! ## The actual deterministic degree-envelope movement -/

theorem coreEpsilon_nonneg
    {eta Gamma : ℝ} (E : CoreExponentSpec eta Gamma) :
    0 ≤ coreEpsilon eta := by
  rw [show coreEpsilon eta = eta / 50000 by
    simp only [coreEpsilon, CFMRegularization.rawRegularizationEps]
    ring]
  linarith [E.eta_pos]

theorem host_mul_floor_lower
    {eta d N : ℝ} (hd : 0 < d)
    (hN : d ^ eta / 2 ≤ N) :
    d ^ (eta - eta ^ 3) / 64 ≤ N * trajectoryFloor eta d := by
  have hP0 : 0 ≤ trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hm := mul_le_mul_of_nonneg_right hN hP0
  calc
    d ^ (eta - eta ^ 3) / 64 =
        (d ^ eta / 2) * trajectoryFloor eta d := by
      unfold trajectoryFloor publicError
      rw [show d ^ (eta - eta ^ 3) = d ^ eta * d ^ (-eta ^ 3) by
        simpa only [sub_eq_add_neg] using
          (Real.rpow_add hd eta (-eta ^ 3))]
      ring
    _ ≤ N * trajectoryFloor eta d := hm

theorem degreeTrajectoryCoefficient_cutoff
    {eta Gamma d : ℝ}
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d) :
    13107200000000 * Gamma ^ 2 ≤
      d ^ (eta - 2 * eta ^ 3 - 3 * coreEpsilon eta / 16) := by
  have hcoef : 13107200000000 * Gamma ^ 2 ≤
      10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := by
    have hG0 : 0 ≤ Gamma := by linarith [E.Gamma_one]
    nlinarith [sq_nonneg Gamma]
  calc
    13107200000000 * Gamma ^ 2 ≤
        10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := hcoef
    _ ≤ d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100) :=
      S.zetaMainSecondOrder
    _ ≤ d ^ (eta - 2 * eta ^ 3 - 3 * coreEpsilon eta / 16) := by
      apply Real.rpow_le_rpow_of_exponent_le
        (by linarith [S.degreeAtLeastTwo])
      linarith [coreEpsilon_nonneg E]

theorem degreeTrajectoryJumpCoefficient_cutoff
    {eta Gamma d : ℝ}
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d) :
    26214400000000 * Gamma ^ 2 ≤
      d ^ (2 * eta - 2 * eta ^ 3 - coreEpsilon eta / 2) := by
  have hcoef : 26214400000000 * Gamma ^ 2 ≤
      10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := by
    have hG0 : 0 ≤ Gamma := by linarith [E.Gamma_one]
    nlinarith [sq_nonneg Gamma]
  calc
    26214400000000 * Gamma ^ 2 ≤
        10240 * ((76800 * Gamma) ^ 2 + 614400 * Gamma) := hcoef
    _ ≤ d ^ (eta - 2 * eta ^ 3 - 99 * coreEpsilon eta / 100) :=
      S.zetaMainSecondOrder
    _ ≤ d ^ (2 * eta - 2 * eta ^ 3 - coreEpsilon eta / 2) := by
      apply Real.rpow_le_rpow_of_exponent_le
        (by linarith [S.degreeAtLeastTwo])
      linarith [E.eta_pos, coreEpsilon_nonneg E]

theorem deltaRate_bound_at_step
    {D₂ D₃ D₄ Gamma epsilon d N x P y : ℝ}
    (R : DeltaStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (hepsilon : 0 ≤ epsilon) (hy : y ∈ Icc x (x + 1)) :
    |deltaRate D₂ D₃ D₄ Gamma epsilon d N y| ≤
      76904 * Gamma * d / (N * P) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.degree.d_one
  have hG0 : 0 ≤ Gamma := by linarith [R.degree.Gamma_one]
  have hpV := pV_pos R.degree.N_pos (R.degree.before_end y hy)
  have hpV1 := pV_le_one R.degree.N_pos (R.degree.time_nonneg y hy)
  have hpM0 := pM_nonneg hd R.degree.N_pos (R.degree.time_nonneg y hy)
  have hpM1 := pM_le_inv hd R.degree.N_pos (R.degree.before_end y hy).le
  have hNP : 0 < N * P := mul_pos R.degree.N_pos R.degree.P_pos
  have hNpV : 0 < N * pV N y := mul_pos R.degree.N_pos hpV
  have hNPle : N * P ≤ N * pV N y :=
    mul_le_mul_of_nonneg_left (R.degree.pV_floor y hy) R.degree.N_pos.le
  have hgamma0 : 0 ≤ gamma Gamma N y := by
    unfold gamma
    positivity
  have hgamma : gamma Gamma N y ≤ 76800 * Gamma / (N * P) := by
    unfold gamma
    rw [div_le_div_iff₀ hNpV hNP]
    exact mul_le_mul_of_nonneg_left hNPle (by positivity)
  have hA0 := degreeHazard_nonneg hd R.degree.N_pos hpV
    R.degree.D₂_nonneg R.degree.D₃_nonneg R.degree.D₄_nonneg hpM0
  have hA := degreeHazard_le hd R.degree.N_pos R.degree.Gamma_one hpV hpV1
    hpM0 hpM1 R.degree.D₂_bound R.degree.D₃_bound R.degree.D₄_bound
  have hA' : degreeHazard D₂ D₃ D₄ d N y ≤ 104 * Gamma / (N * P) := by
    apply hA.trans
    rw [div_le_div_iff₀ hNpV hNP]
    exact mul_le_mul_of_nonneg_left hNPle
      (mul_nonneg (by norm_num) hG0)
  have hrate : |gamma Gamma N y - degreeHazard D₂ D₃ D₄ d N y| ≤
      76904 * Gamma / (N * P) := by
    calc
      |gamma Gamma N y - degreeHazard D₂ D₃ D₄ d N y| ≤
          |gamma Gamma N y| + |degreeHazard D₂ D₃ D₄ d N y| :=
        abs_sub _ _
      _ = gamma Gamma N y + degreeHazard D₂ D₃ D₄ d N y := by
        rw [abs_of_nonneg hgamma0, abs_of_nonneg hA0]
      _ ≤ 76800 * Gamma / (N * P) + 104 * Gamma / (N * P) :=
        add_le_add hgamma hA'
      _ = 76904 * Gamma / (N * P) := by ring
  have hdelta0 : 0 ≤ delta D₂ D₃ D₄ Gamma epsilon d N y :=
    (Real.rpow_nonneg hd.le _).trans (delta_bounds_of_registry R hy).1
  have hdelta : delta D₂ D₃ D₄ Gamma epsilon d N y ≤ d := by
    calc
      delta D₂ D₃ D₄ Gamma epsilon d N y ≤ d ^ (1 - epsilon / 64) :=
        (delta_bounds_of_registry R hy).2
      _ ≤ d ^ (1 : ℝ) := by
        apply Real.rpow_le_rpow_of_exponent_le R.degree.d_one
        linarith
      _ = d := Real.rpow_one d
  unfold deltaRate
  rw [abs_mul, abs_of_nonneg hdelta0]
  calc
    |gamma Gamma N y - degreeHazard D₂ D₃ D₄ d N y| *
          delta D₂ D₃ D₄ Gamma epsilon d N y ≤
        (76904 * Gamma / (N * P)) * d :=
      mul_le_mul hrate hdelta hdelta0
        (div_nonneg (mul_nonneg (by norm_num) hG0) hNP.le)
    _ = 76904 * Gamma * d / (N * P) := by ring

theorem degreeTaylorRemainder_le_rateScale
    {D₂ D₃ D₄ Gamma epsilon d N x P : ℝ}
    (R : DegreeStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (hepsilon : 0 ≤ epsilon) :
    d ^ (1 - epsilon) / N ≤ Gamma * d / (N * P) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.d_one
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hpV1 := pV_le_one R.N_pos (R.time_nonneg x hx)
  have hP1 : P ≤ 1 := (R.pV_floor x hx).trans hpV1
  have hNP : 0 < N * P := mul_pos R.N_pos R.P_pos
  have hone : 1 / N ≤ Gamma / (N * P) := by
    calc
      1 / N = P / (N * P) := by
        field_simp [ne_of_gt R.N_pos, ne_of_gt R.P_pos]
      _ ≤ Gamma / (N * P) :=
        div_le_div_of_nonneg_right (hP1.trans R.Gamma_one) hNP.le
  have hpow : d ^ (1 - epsilon) ≤ d := by
    calc
      d ^ (1 - epsilon) ≤ d ^ (1 : ℝ) := by
        apply Real.rpow_le_rpow_of_exponent_le R.d_one
        linarith
      _ = d := Real.rpow_one d
  calc
    d ^ (1 - epsilon) / N = d ^ (1 - epsilon) * (1 / N) := by ring
    _ ≤ d * (Gamma / (N * P)) :=
      mul_le_mul hpow hone (one_div_nonneg.mpr R.N_pos.le) hd.le
    _ = Gamma * d / (N * P) := by ring

theorem degreeEnvelopeTrajectory_step_abs_le
    {D₂ D₃ D₄ Gamma epsilon eta d N x P : ℝ}
    (R : DeltaStepRegistry D₂ D₃ D₄ Gamma epsilon d N x P)
    (hepsilon : 0 ≤ epsilon) (hfloor : trajectoryFloor eta d ≤ P) :
    |(dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x) +
        (delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤
        degreeTrajectoryScale Gamma eta d N ∧
      |(dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x) -
        (delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
          delta D₂ D₃ D₄ Gamma epsilon d N x)| ≤
        degreeTrajectoryScale Gamma eta d N := by
  let A := dHat D₂ D₃ D₄ d N (x + 1) - dHat D₂ D₃ D₄ d N x
  let B := delta D₂ D₃ D₄ Gamma epsilon d N (x + 1) -
    delta D₂ D₃ D₄ Gamma epsilon d N x
  let rA := degreeRate D₂ D₃ D₄ d N x
  let rB := deltaRate D₂ D₃ D₄ Gamma epsilon d N x
  let rem := d ^ (1 - epsilon) / N
  let base := Gamma * d / (N * P)
  have hx : x ∈ Set.Icc x (x + 1) := ⟨le_rfl, by linarith⟩
  have hAtaylor := dHat_oneStepTaylor_of_registry R.degree
  have hBtaylor := delta_oneStepTaylor_of_registry R
  have hrA := degreeRate_bound_at_step R.degree hx
  have hrB := deltaRate_bound_at_step R hepsilon hx
  have hrem := degreeTaylorRemainder_le_rateScale R.degree hepsilon
  have hA : |A| ≤ 104 * base + rem := by
    calc
      |A| = |(A - rA) + rA| := by congr 1 <;> ring
      _ ≤ |A - rA| + |rA| := abs_add_le _ _
      _ ≤ rem + 104 * Gamma * d / (N * P) := add_le_add hAtaylor hrA
      _ = 104 * base + rem := by ring
  have hB : |B| ≤ 76904 * base + rem := by
    calc
      |B| = |(B - rB) + rB| := by congr 1 <;> ring
      _ ≤ |B - rB| + |rB| := abs_add_le _ _
      _ ≤ rem + 76904 * Gamma * d / (N * P) := add_le_add hBtaylor hrB
      _ = 76904 * base + rem := by ring
  have hraw : |A| + |B| ≤ 77010 * base := by
    calc
      |A| + |B| ≤ (104 * base + rem) + (76904 * base + rem) :=
        add_le_add hA hB
      _ ≤ 77010 * base := by
        dsimp only [rem, base] at hrem ⊢
        linarith
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) R.degree.d_one
  have hG0 : 0 ≤ Gamma := by linarith [R.degree.Gamma_one]
  have hfloor0 : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    exact div_pos (Real.rpow_pos_of_pos hd _) (by norm_num)
  have hdenF : 0 < N * trajectoryFloor eta d :=
    mul_pos R.degree.N_pos hfloor0
  have hbaseFloor : base ≤ Gamma * d / (N * trajectoryFloor eta d) := by
    dsimp only [base]
    apply div_le_div_of_nonneg_left (mul_nonneg hG0 hd.le) hdenF
    exact mul_le_mul_of_nonneg_left hfloor R.degree.N_pos.le
  have hQ : 77010 * base ≤ degreeTrajectoryScale Gamma eta d N := by
    unfold degreeTrajectoryScale
    calc
      77010 * base ≤ 77010 * (Gamma * d / (N * trajectoryFloor eta d)) :=
        mul_le_mul_of_nonneg_left hbaseFloor (by norm_num)
      _ ≤ 80000 * (Gamma * d / (N * trajectoryFloor eta d)) := by
        have hscale0 : 0 ≤ Gamma * d / (N * trajectoryFloor eta d) := by
          exact div_nonneg (mul_nonneg hG0 hd.le) hdenF.le
        nlinarith
      _ = 80000 * Gamma * d / (N * trajectoryFloor eta d) := by ring
  constructor
  · exact (abs_add_le A B).trans (hraw.trans hQ)
  · exact (abs_sub A B).trans (hraw.trans hQ)

theorem degreeTrajectoryScale_sq_le_sourceVariance
    {eta Gamma d N : ℝ}
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    degreeTrajectoryScale Gamma eta d N ^ 2 ≤
      degreeSourceVarianceScale d (coreEpsilon eta) N := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hden : 0 < N * trajectoryFloor eta d := mul_pos hNpos hPpos
  have hcoeff := degreeTrajectoryCoefficient_cutoff E S
  have hNP := host_mul_floor_sq_lower hd hN
  have hcross :
      6400000000 * Gamma ^ 2 * d ^ (2 : ℕ) ≤
        d ^ (2 - 3 * coreEpsilon eta / 16) *
          (N * trajectoryFloor eta d ^ 2) := by
    calc
      6400000000 * Gamma ^ 2 * d ^ (2 : ℕ) =
          (13107200000000 * Gamma ^ 2) * d ^ (2 : ℕ) / 2048 := by ring
      _ ≤ d ^ (eta - 2 * eta ^ 3 - 3 * coreEpsilon eta / 16) *
            d ^ (2 : ℕ) / 2048 := by
        gcongr
      _ = d ^ (2 - 3 * coreEpsilon eta / 16) *
          (d ^ (eta - 2 * eta ^ 3) / 2048) := by
        rw [show d ^ (2 : ℕ) = d ^ (2 : ℝ) by
          exact (Real.rpow_natCast d 2).symm]
        rw [← Real.rpow_add hd]
        calc
          d ^ (eta - 2 * eta ^ 3 - 3 * coreEpsilon eta / 16 + 2) / 2048 =
              d ^ ((2 - 3 * coreEpsilon eta / 16) +
                (eta - 2 * eta ^ 3)) / 2048 := by congr 2 <;> ring
          _ = (d ^ (2 - 3 * coreEpsilon eta / 16) *
                d ^ (eta - 2 * eta ^ 3)) / 2048 := by
            rw [Real.rpow_add hd]
          _ = d ^ (2 - 3 * coreEpsilon eta / 16) *
                (d ^ (eta - 2 * eta ^ 3) / 2048) := by ring
      _ ≤ d ^ (2 - 3 * coreEpsilon eta / 16) *
          (N * trajectoryFloor eta d ^ 2) :=
        mul_le_mul_of_nonneg_left hNP (Real.rpow_nonneg hd.le _)
  unfold degreeTrajectoryScale degreeSourceVarianceScale
  rw [div_pow, div_le_div_iff₀ (sq_pos_of_pos hden) hNpos]
  have hs := mul_le_mul_of_nonneg_right hcross hNpos.le
  calc
    (80000 * Gamma * d) ^ 2 * N =
        (6400000000 * Gamma ^ 2 * d ^ (2 : ℕ)) * N := by ring
    _ ≤ (d ^ (2 - 3 * coreEpsilon eta / 16) *
          (N * trajectoryFloor eta d ^ 2)) * N := hs
    _ = d ^ (2 - 3 * coreEpsilon eta / 16) *
          (N * trajectoryFloor eta d) ^ 2 := by ring

theorem degreeTrajectoryScale_le_sourceJump
    {eta Gamma d N : ℝ}
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    degreeTrajectoryScale Gamma eta d N ≤
      degreeSourceJumpScale d (coreEpsilon eta) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < N :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hN
  have hPpos : 0 < trajectoryFloor eta d := by
    unfold trajectoryFloor publicError
    positivity
  have hden : 0 < N * trajectoryFloor eta d := mul_pos hNpos hPpos
  have hcoeff := degreeTrajectoryJumpCoefficient_cutoff E S
  have hNP := host_mul_floor_lower hd hN
  have hNPsq :
      d ^ (2 * eta - 2 * eta ^ 3) / 4096 ≤
        (N * trajectoryFloor eta d) ^ 2 := by
    have hm := mul_self_le_mul_self
      (by positivity : 0 ≤ d ^ (eta - eta ^ 3) / 64) hNP
    calc
      d ^ (2 * eta - 2 * eta ^ 3) / 4096 =
          (d ^ (eta - eta ^ 3) / 64) ^ 2 := by
        rw [div_pow]
        calc
          d ^ (2 * eta - 2 * eta ^ 3) / 4096 =
              (d ^ (eta - eta ^ 3) * d ^ (eta - eta ^ 3)) / 64 ^ 2 := by
            rw [← Real.rpow_add hd]
            congr 2 <;> ring
          _ = (d ^ (eta - eta ^ 3)) ^ 2 / 64 ^ 2 := by ring
      _ ≤ (N * trajectoryFloor eta d) ^ 2 := by
        simpa only [pow_two] using hm
  have hcross :
      6400000000 * Gamma ^ 2 * d ^ (2 : ℕ) ≤
        d ^ (2 - coreEpsilon eta / 2) *
          (N * trajectoryFloor eta d) ^ 2 := by
    calc
      6400000000 * Gamma ^ 2 * d ^ (2 : ℕ) =
          (26214400000000 * Gamma ^ 2) * d ^ (2 : ℕ) / 4096 := by ring
      _ ≤ d ^ (2 * eta - 2 * eta ^ 3 - coreEpsilon eta / 2) *
            d ^ (2 : ℕ) / 4096 := by
        gcongr
      _ = d ^ (2 - coreEpsilon eta / 2) *
          (d ^ (2 * eta - 2 * eta ^ 3) / 4096) := by
        rw [show d ^ (2 : ℕ) = d ^ (2 : ℝ) by
          exact (Real.rpow_natCast d 2).symm]
        rw [← Real.rpow_add hd]
        calc
          d ^ (2 * eta - 2 * eta ^ 3 - coreEpsilon eta / 2 + 2) / 4096 =
              d ^ ((2 - coreEpsilon eta / 2) +
                (2 * eta - 2 * eta ^ 3)) / 4096 := by congr 2 <;> ring
          _ = (d ^ (2 - coreEpsilon eta / 2) *
                d ^ (2 * eta - 2 * eta ^ 3)) / 4096 := by
            rw [Real.rpow_add hd]
          _ = d ^ (2 - coreEpsilon eta / 2) *
                (d ^ (2 * eta - 2 * eta ^ 3) / 4096) := by ring
      _ ≤ d ^ (2 - coreEpsilon eta / 2) *
          (N * trajectoryFloor eta d) ^ 2 :=
        mul_le_mul_of_nonneg_left hNPsq (Real.rpow_nonneg hd.le _)
  have hQ0 : 0 ≤ degreeTrajectoryScale Gamma eta d N := by
    unfold degreeTrajectoryScale
    exact div_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) (by linarith [E.Gamma_one])) hd.le)
      hden.le
  have hJ0 : 0 ≤ degreeSourceJumpScale d (coreEpsilon eta) := by
    unfold degreeSourceJumpScale
    exact Real.rpow_nonneg hd.le _
  have hJsq : degreeSourceJumpScale d (coreEpsilon eta) ^ 2 =
      d ^ (2 - coreEpsilon eta / 2) := by
    unfold degreeSourceJumpScale
    calc
      (d ^ (1 - coreEpsilon eta / 4)) ^ 2 =
          d ^ (1 - coreEpsilon eta / 4) *
            d ^ (1 - coreEpsilon eta / 4) := by ring
      _ = d ^ ((1 - coreEpsilon eta / 4) +
          (1 - coreEpsilon eta / 4)) := (Real.rpow_add hd _ _).symm
      _ = d ^ (2 - coreEpsilon eta / 2) := by congr 1 <;> ring
  have hsq : degreeTrajectoryScale Gamma eta d N ^ 2 ≤
      degreeSourceJumpScale d (coreEpsilon eta) ^ 2 := by
    unfold degreeTrajectoryScale
    rw [div_pow, hJsq, div_le_iff₀ (sq_pos_of_pos hden)]
    calc
      (80000 * Gamma * d) ^ 2 =
          6400000000 * Gamma ^ 2 * d ^ (2 : ℕ) := by ring
      _ ≤ d ^ (2 - coreEpsilon eta / 2) *
          (N * trajectoryFloor eta d) ^ 2 := hcross
  nlinarith [sq_nonneg
    (degreeTrajectoryScale Gamma eta d N -
      degreeSourceJumpScale d (coreEpsilon eta))]

theorem degreeCorrectedSquareBudget
    {eta Gamma d N : ℝ}
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hN : d ^ eta / 2 ≤ N) :
    2 * degreeSourceVarianceScale d (coreEpsilon eta) N +
        2 * degreeTrajectoryScale Gamma eta d N ^ 2 ≤
      degreeFreedmanVarianceScale d (coreEpsilon eta) N := by
  unfold degreeFreedmanVarianceScale
  nlinarith [degreeTrajectoryScale_sq_le_sourceVariance E S hN]

/-! The existing exponential hazard cutoff is much stronger than the
polynomial constant needed by Freedman.  Raising it to the 62nd power
still leaves room for `tailPower = epsilon / 1000`. -/

theorem freedmanExponent_of_core
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hGamma : 1 ≤ Gamma) (hepsilon : 0 ≤ coreEpsilon eta) :
    1600 * Gamma ^ 2 ≤
      d ^ (coreEpsilon eta / 8 - tailPower eta) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hx0 : 0 ≤ 186 * Gamma := by positivity
  have hpoly : 1600 * Gamma ^ 2 ≤ exp (186 * Gamma) := by
    have hs := Real.pow_div_factorial_le_exp (186 * Gamma) hx0 2
    norm_num at hs
    nlinarith
  have hp := pow_le_pow_left₀ (Real.exp_nonneg _) S.testHazardExponential 62
  have hexp : exp (186 * Gamma) ≤
      d ^ (coreEpsilon eta / 8 - tailPower eta) := by
    calc
      exp (186 * Gamma) = exp (3 * Gamma) ^ (62 : ℕ) := by
        rw [← Real.exp_nat_mul]
        congr 1
        ring
      _ ≤ (d ^ (coreEpsilon eta / 512)) ^ (62 : ℕ) := hp
      _ = d ^ (62 * coreEpsilon eta / 512) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hd.le]
        congr 1
        ring
      _ ≤ d ^ (coreEpsilon eta / 8 - tailPower eta) := by
        apply Real.rpow_le_rpow_of_exponent_le
          (by linarith [S.degreeAtLeastTwo])
        unfold tailPower
        nlinarith
  exact hpoly.trans hexp

/-! ## Normalized scalar bounds for the three Freedman calls -/

theorem rpow_mul_rpow_sub
    {d a b : ℝ} (hd : 0 < d) :
    d ^ a * d ^ (b - a) = d ^ b := by
  rw [← Real.rpow_add hd]
  congr 1
  ring

theorem commonTail_of_freedman_ratio
    {eta d t denominator : ℝ}
    (hden : 0 < denominator)
    (hratio : 5 * d ^ tailPower eta ≤ t ^ 2 / (4 * denominator)) :
    exp (-(t ^ 2) / (4 * denominator)) ≤ commonTail eta d := by
  unfold commonTail
  apply Real.exp_le_exp.mpr
  rw [show -t ^ 2 / (4 * denominator) =
    -(t ^ 2 / (4 * denominator)) by ring]
  exact neg_le_neg hratio

theorem degree_denominator_upper
    {d epsilon N T : ℝ} (hd : 1 ≤ d) (hN : 0 < N)
    (hepsilon : 0 ≤ epsilon) (hT0 : 0 ≤ T) (hT : T ≤ N) :
    T * degreeFreedmanVarianceScale d epsilon N +
        (2 * degreeSourceJumpScale d epsilon) * degreeDeviation d epsilon ≤
      5 * d ^ (2 - 3 * epsilon / 16) := by
  have hdp : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hbase0 : 0 ≤ d ^ (2 - 3 * epsilon / 16) :=
    Real.rpow_nonneg hdp.le _
  have hvar :
      T * degreeFreedmanVarianceScale d epsilon N ≤
        4 * d ^ (2 - 3 * epsilon / 16) := by
    unfold degreeFreedmanVarianceScale degreeSourceVarianceScale
    rw [show T * (4 * (Real.rpow d (2 - 3 * epsilon / 16) / N)) =
      (T / N) * (4 * Real.rpow d (2 - 3 * epsilon / 16)) by ring]
    apply mul_le_of_le_one_left (mul_nonneg (by norm_num) hbase0)
    exact (div_le_one hN).2 hT
  have hrt :
      (2 * degreeSourceJumpScale d epsilon) * degreeDeviation d epsilon ≤
        d ^ (2 - 3 * epsilon / 16) := by
    unfold degreeSourceJumpScale degreeDeviation
    calc
      (2 * Real.rpow d (1 - epsilon / 4)) *
          (Real.rpow d (1 - epsilon / 32) / 2) =
          Real.rpow d (1 - epsilon / 4) *
            Real.rpow d (1 - epsilon / 32) := by ring
      _ = Real.rpow d ((1 - epsilon / 4) + (1 - epsilon / 32)) := by
        exact (Real.rpow_add hdp _ _).symm
      _ ≤ Real.rpow d (2 - 3 * epsilon / 16) := by
        apply Real.rpow_le_rpow_of_exponent_le hd
        linarith
  linarith

theorem degree_freedman_ratio
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hGamma : 1 ≤ Gamma) (hepsilon : 0 ≤ coreEpsilon eta) :
    5 * d ^ tailPower eta ≤
      degreeDeviation d (coreEpsilon eta) ^ 2 /
        (4 * (5 * d ^ (2 - 3 * coreEpsilon eta / 16))) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hGammaSq : 1 ≤ Gamma ^ 2 := by nlinarith [sq_nonneg Gamma]
  have hconst : 400 ≤ 1600 * Gamma ^ 2 := by
    nlinarith
  have h400 : 400 ≤ d ^ (coreEpsilon eta / 8 - tailPower eta) :=
    hconst.trans (freedmanExponent_of_core S hGamma hepsilon)
  have hmul := mul_le_mul_of_nonneg_right h400
    (Real.rpow_nonneg hd.le
      (tailPower eta + 2 - 3 * coreEpsilon eta / 16))
  have hpow :
      400 * d ^ tailPower eta * d ^ (2 - 3 * coreEpsilon eta / 16) ≤
        d ^ (2 - coreEpsilon eta / 16) := by
    calc
      400 * d ^ tailPower eta * d ^ (2 - 3 * coreEpsilon eta / 16) =
          400 * d ^ (tailPower eta + 2 - 3 * coreEpsilon eta / 16) := by
            rw [mul_assoc]
            congr 1
            calc
              d ^ tailPower eta * d ^ (2 - 3 * coreEpsilon eta / 16) =
                  d ^ (tailPower eta + (2 - 3 * coreEpsilon eta / 16)) :=
                (Real.rpow_add hd _ _).symm
              _ = d ^ (tailPower eta + 2 - 3 * coreEpsilon eta / 16) := by
                congr 1
                ring
      _ ≤ d ^ (coreEpsilon eta / 8 - tailPower eta) *
          d ^ (tailPower eta + 2 - 3 * coreEpsilon eta / 16) := hmul
      _ = d ^ (2 - coreEpsilon eta / 16) := by
        rw [← Real.rpow_add hd]
        congr 1
        ring
  unfold degreeDeviation
  have hbaseSq : (Real.rpow d (1 - coreEpsilon eta / 32)) ^ (2 : ℕ) =
      Real.rpow d (2 - coreEpsilon eta / 16) := by
    calc
      (Real.rpow d (1 - coreEpsilon eta / 32)) ^ (2 : ℕ) =
          Real.rpow d (1 - coreEpsilon eta / 32) *
            Real.rpow d (1 - coreEpsilon eta / 32) := by ring
      _ = Real.rpow d
          ((1 - coreEpsilon eta / 32) + (1 - coreEpsilon eta / 32)) := by
        exact (Real.rpow_add hd _ _).symm
      _ = Real.rpow d (2 - coreEpsilon eta / 16) := by
        congr 1
        ring
  apply (le_div_iff₀ (by positivity :
    0 < 4 * (5 * d ^ (2 - 3 * coreEpsilon eta / 16)))).2
  change 5 * d ^ tailPower eta *
      (4 * (5 * d ^ (2 - 3 * coreEpsilon eta / 16))) ≤
    (Real.rpow d (1 - coreEpsilon eta / 32) / 2) ^ (2 : ℕ)
  rw [div_pow, hbaseSq]
  norm_num
  nlinarith

theorem test_denominator_upper
    {Gamma P d epsilon N T : ℝ}
    (hGamma : 1 ≤ Gamma) (hP : 0 ≤ P) (hd : 1 ≤ d)
    (hN : 0 < N) (hepsilon : 0 ≤ epsilon)
    (hT0 : 0 ≤ T) (hT : T ≤ N) :
    T * testFreedmanVarianceScale P d epsilon N +
        testSourceJumpScale P d epsilon * testDeviation Gamma P d epsilon ≤
      5 * (P ^ 2 * d ^ (-3 * epsilon / 16)) := by
  have hdp : 0 < d := lt_of_lt_of_le zero_lt_one hd
  have hbase0 : 0 ≤ P ^ 2 * d ^ (-3 * epsilon / 16) :=
    mul_nonneg (sq_nonneg P) (Real.rpow_nonneg hdp.le _)
  have hvar :
      T * testFreedmanVarianceScale P d epsilon N ≤
        4 * (P ^ 2 * d ^ (-3 * epsilon / 16)) := by
    unfold testFreedmanVarianceScale testSourceVarianceScale
    rw [show T * (4 * (P ^ 2 * Real.rpow d (-3 * epsilon / 16) / N)) =
      (T / N) * (4 * (P ^ 2 * Real.rpow d (-3 * epsilon / 16))) by ring]
    apply mul_le_of_le_one_left (mul_nonneg (by norm_num) hbase0)
    exact (div_le_one hN).2 hT
  have hrt :
      testSourceJumpScale P d epsilon * testDeviation Gamma P d epsilon ≤
        P ^ 2 * d ^ (-3 * epsilon / 16) := by
    unfold testSourceJumpScale testDeviation
    have hden : 0 < 4 * Gamma := by positivity
    change (P * Real.rpow d (-epsilon / 4)) *
        (P * Real.rpow d (-epsilon / 32) / (4 * Gamma)) ≤
      P ^ 2 * Real.rpow d (-3 * epsilon / 16)
    calc
      (P * Real.rpow d (-epsilon / 4)) *
          (P * Real.rpow d (-epsilon / 32) / (4 * Gamma)) =
          (P ^ 2 * Real.rpow d (-epsilon / 4 - epsilon / 32)) /
            (4 * Gamma) := by
        have hpadd : Real.rpow d (-epsilon / 4) *
            Real.rpow d (-epsilon / 32) =
              Real.rpow d (-epsilon / 4 - epsilon / 32) := by
          calc
            Real.rpow d (-epsilon / 4) * Real.rpow d (-epsilon / 32) =
                Real.rpow d ((-epsilon / 4) + (-epsilon / 32)) :=
              (Real.rpow_add hdp _ _).symm
            _ = Real.rpow d (-epsilon / 4 - epsilon / 32) := by
              congr 1
              ring
        rw [show (P * Real.rpow d (-epsilon / 4)) *
            (P * Real.rpow d (-epsilon / 32) / (4 * Gamma)) =
              P ^ 2 * (Real.rpow d (-epsilon / 4) *
                Real.rpow d (-epsilon / 32)) / (4 * Gamma) by ring,
          hpadd]
      _ ≤ P ^ 2 * Real.rpow d (-3 * epsilon / 16) := by
        apply (div_le_iff₀ hden).2
        have hpowers : d ^ (-epsilon / 4 - epsilon / 32) ≤
        d ^ (-3 * epsilon / 16) := by
          apply Real.rpow_le_rpow_of_exponent_le hd
          linarith
        have hm := mul_le_mul_of_nonneg_left hpowers (sq_nonneg P)
        exact hm.trans (by
          have htarget : 0 ≤ P ^ 2 * d ^ (-3 * epsilon / 16) := hbase0
          have hfourG : (1 : ℝ) ≤ 4 * Gamma := by nlinarith
          calc
            P ^ 2 * d ^ (-3 * epsilon / 16) =
                (P ^ 2 * d ^ (-3 * epsilon / 16)) * 1 := by ring
            _ ≤ (P ^ 2 * d ^ (-3 * epsilon / 16)) * (4 * Gamma) :=
              mul_le_mul_of_nonneg_left hfourG htarget)
  linarith

theorem test_freedman_ratio
    {eta Gamma P d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hGamma : 1 ≤ Gamma) (hepsilon : 0 ≤ coreEpsilon eta)
    (hP : 0 < P) :
    5 * d ^ tailPower eta ≤
      testDeviation Gamma P d (coreEpsilon eta) ^ 2 /
        (4 * (5 * (P ^ 2 * d ^ (-3 * coreEpsilon eta / 16)))) := by
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one hGamma
  have hmul := mul_le_mul_of_nonneg_right
    (freedmanExponent_of_core S hGamma hepsilon)
    (Real.rpow_nonneg hd.le
      (tailPower eta - 3 * coreEpsilon eta / 16))
  have hpow :
      1600 * Gamma ^ 2 * d ^ tailPower eta *
          d ^ (-3 * coreEpsilon eta / 16) ≤
        d ^ (-coreEpsilon eta / 16) := by
    calc
      1600 * Gamma ^ 2 * d ^ tailPower eta *
            d ^ (-3 * coreEpsilon eta / 16) =
          (1600 * Gamma ^ 2) *
            d ^ (tailPower eta - 3 * coreEpsilon eta / 16) := by
              rw [mul_assoc]
              congr 1
              calc
                d ^ tailPower eta * d ^ (-3 * coreEpsilon eta / 16) =
                    d ^ (tailPower eta + (-3 * coreEpsilon eta / 16)) :=
                  (Real.rpow_add hd _ _).symm
                _ = d ^ (tailPower eta - 3 * coreEpsilon eta / 16) := by
                  congr 1
                  ring
      _ ≤ d ^ (coreEpsilon eta / 8 - tailPower eta) *
          d ^ (tailPower eta - 3 * coreEpsilon eta / 16) := hmul
      _ = d ^ (-coreEpsilon eta / 16) := by
        rw [← Real.rpow_add hd]
        congr 1
        ring
  have hP2 : 0 < P ^ 2 := sq_pos_of_pos hP
  have hden : 0 < 4 * (5 * (P ^ 2 * d ^ (-3 * coreEpsilon eta / 16))) := by
    positivity
  unfold testDeviation
  apply (le_div_iff₀ hden).2
  have hsquare :
      (P * d ^ (-coreEpsilon eta / 32) / (4 * Gamma)) ^ 2 =
        P ^ 2 * d ^ (-coreEpsilon eta / 16) /
          (16 * Gamma ^ 2) := by
    rw [div_pow, mul_pow]
    rw [show (d ^ (-coreEpsilon eta / 32)) ^ (2 : ℕ) =
      d ^ (-coreEpsilon eta / 16) by
        rw [← Real.rpow_mul_natCast hd.le]
        congr 1
        norm_num
        ring]
    ring
  rw [hsquare]
  apply (le_div_iff₀ (by positivity : 0 < 16 * Gamma ^ 2)).2
  have hm := mul_le_mul_of_nonneg_left hpow hP2.le
  nlinarith

theorem degree_freedmanTail_le_common
    {eta Gamma d N T : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hGamma : 1 ≤ Gamma) (hepsilon : 0 ≤ coreEpsilon eta)
    (hN : 0 < N) (hT0 : 0 ≤ T) (hT : T ≤ N) :
    exp (-(degreeDeviation d (coreEpsilon eta) ^ 2) /
        (4 * (T * degreeFreedmanVarianceScale d (coreEpsilon eta) N +
          (2 * degreeSourceJumpScale d (coreEpsilon eta)) *
            degreeDeviation d (coreEpsilon eta)))) ≤
      commonTail eta d := by
  let D := T * degreeFreedmanVarianceScale d (coreEpsilon eta) N +
    (2 * degreeSourceJumpScale d (coreEpsilon eta)) *
      degreeDeviation d (coreEpsilon eta)
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have ht : 0 < degreeDeviation d (coreEpsilon eta) := by
    unfold degreeDeviation
    positivity
  have hD0 : 0 < D := by
    dsimp only [D]
    have hJ : 0 < degreeSourceJumpScale d (coreEpsilon eta) := by
      unfold degreeSourceJumpScale
      exact Real.rpow_pos_of_pos hd _
    have hV0 : 0 ≤ degreeFreedmanVarianceScale d (coreEpsilon eta) N := by
      unfold degreeFreedmanVarianceScale degreeSourceVarianceScale
      exact mul_nonneg (by norm_num)
        (div_nonneg (Real.rpow_nonneg hd.le _) hN.le)
    have hfirst : 0 ≤ T * degreeFreedmanVarianceScale d (coreEpsilon eta) N :=
      mul_nonneg hT0 hV0
    have hsecond : 0 < (2 * degreeSourceJumpScale d (coreEpsilon eta)) *
        degreeDeviation d (coreEpsilon eta) := by positivity
    linarith
  have hD : D ≤ 5 * d ^ (2 - 3 * coreEpsilon eta / 16) :=
    degree_denominator_upper (by linarith [S.degreeAtLeastTwo]) hN
      hepsilon hT0 hT
  have hbasePos : 0 < 5 * d ^ (2 - 3 * coreEpsilon eta / 16) := by
    positivity
  have hratio0 := degree_freedman_ratio S hGamma hepsilon
  have hratio : 5 * d ^ tailPower eta ≤
      degreeDeviation d (coreEpsilon eta) ^ 2 / (4 * D) := by
    calc
      5 * d ^ tailPower eta ≤
          degreeDeviation d (coreEpsilon eta) ^ 2 /
            (4 * (5 * d ^ (2 - 3 * coreEpsilon eta / 16))) := hratio0
      _ ≤ degreeDeviation d (coreEpsilon eta) ^ 2 / (4 * D) := by
        exact div_le_div_of_nonneg_left (sq_nonneg _)
          (by positivity) (by nlinarith)
  simpa only [D] using commonTail_of_freedman_ratio hD0 hratio

theorem test_freedmanTail_le_common
    {eta Gamma P d N T : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hGamma : 1 ≤ Gamma) (hepsilon : 0 ≤ coreEpsilon eta)
    (hP : 0 < P) (hN : 0 < N) (hT0 : 0 ≤ T) (hT : T ≤ N) :
    exp (-(testDeviation Gamma P d (coreEpsilon eta) ^ 2) /
        (4 * (T * testFreedmanVarianceScale P d (coreEpsilon eta) N +
          testSourceJumpScale P d (coreEpsilon eta) *
            testDeviation Gamma P d (coreEpsilon eta)))) ≤
      commonTail eta d := by
  let D := T * testFreedmanVarianceScale P d (coreEpsilon eta) N +
    testSourceJumpScale P d (coreEpsilon eta) *
      testDeviation Gamma P d (coreEpsilon eta)
  have ht : 0 < testDeviation Gamma P d (coreEpsilon eta) := by
    unfold testDeviation
    have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one hGamma
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
    positivity
  have hD0 : 0 < D := by
    dsimp only [D]
    have hJ : 0 < testSourceJumpScale P d (coreEpsilon eta) := by
      unfold testSourceJumpScale
      have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
      exact mul_pos hP (Real.rpow_pos_of_pos hd _)
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
    have hV0 : 0 ≤ testFreedmanVarianceScale P d (coreEpsilon eta) N := by
      unfold testFreedmanVarianceScale testSourceVarianceScale
      exact mul_nonneg (by norm_num)
        (div_nonneg (mul_nonneg (sq_nonneg P) (Real.rpow_nonneg hd.le _)) hN.le)
    have hfirst : 0 ≤ T * testFreedmanVarianceScale P d (coreEpsilon eta) N :=
      mul_nonneg hT0 hV0
    have hsecond : 0 < testSourceJumpScale P d (coreEpsilon eta) *
        testDeviation Gamma P d (coreEpsilon eta) := mul_pos hJ ht
    linarith
  have hD : D ≤
      5 * (P ^ 2 * d ^ (-3 * coreEpsilon eta / 16)) :=
    test_denominator_upper hGamma hP.le
      (by linarith [S.degreeAtLeastTwo]) hN hepsilon hT0 hT
  have hbasePos :
      0 < 5 * (P ^ 2 * d ^ (-3 * coreEpsilon eta / 16)) := by
    have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
    positivity
  have hratio0 := test_freedman_ratio S hGamma hepsilon hP
  have hratio : 5 * d ^ tailPower eta ≤
      testDeviation Gamma P d (coreEpsilon eta) ^ 2 / (4 * D) := by
    calc
      5 * d ^ tailPower eta ≤
          testDeviation Gamma P d (coreEpsilon eta) ^ 2 /
            (4 * (5 * (P ^ 2 * d ^ (-3 * coreEpsilon eta / 16)))) := hratio0
      _ ≤ testDeviation Gamma P d (coreEpsilon eta) ^ 2 / (4 * D) := by
        exact div_le_div_of_nonneg_left (sq_nonneg _)
          (by positivity) (by nlinarith)
  simpa only [D] using commonTail_of_freedman_ratio hD0 hratio

/-! ## The exact rounded horizon -/

def targetTime (eta d : ℝ) (N : ℕ) : ℕ :=
  Nat.ceil ((1 - stoppingMargin eta d) * (N : ℝ) / 8)

theorem targetTime_lt_host_eighth
    {eta Gamma d : ℝ} {N : ℕ} (heta : 0 < eta)
    (S : CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ)) :
    (targetTime eta d N : ℝ) < (N : ℝ) / 8 := by
  have hmu1 : stoppingMargin eta d ≤ 1 := by
    have h := publicError_le_one heta.le
      (by linarith [S.degreeAtLeastTwo] : (1 : ℝ) ≤ d)
    unfold stoppingMargin
    linarith
  have hslack : 1 < stoppingMargin eta d * (N : ℝ) / 8 := by
    have h := stoppingMargin_mul_host_gt_sixteen S hNlower
    nlinarith
  have h := (ceil_almostPerfect_target N (stoppingMargin eta d) hmu1 hslack).2
  simpa only [targetTime] using h

theorem targetTime_cast_le_host
    {eta Gamma d : ℝ} {N : ℕ} (heta : 0 < eta)
    (S : CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ)) :
    (targetTime eta d N : ℝ) ≤ (N : ℝ) := by
  have hN0 : 0 ≤ (N : ℝ) := Nat.cast_nonneg _
  have h := targetTime_lt_host_eighth heta S hNlower
  nlinarith

/-! ## Source-budget structures discharge complete paired family tails -/

variable {V : Type*} [DecidableEq V]

/-- The source estimates and the two deterministic time-zero gaps are one
family-level input.  This keeps all scalar Freedman choices out of the
aggregation API. -/
structure PairedFirstFailureSourceBudgets
    (source : Prop) (upperInitial lowerInitial deviation : ℝ) : Prop where
  sourceBudgets : source
  upperGap : upperInitial ≤ -deviation
  lowerGap : lowerInitial ≤ -deviation

/-- Test and internal-link families additionally record positivity of their
natural observable scale in the same source package. -/
structure PositivePairedFirstFailureSourceBudgets
    (P : ℝ) (source : Prop)
    (upperInitial lowerInitial deviation : ℝ) : Prop
    extends PairedFirstFailureSourceBudgets
      source upperInitial lowerInitial deviation where
  scale_pos : 0 < P

theorem degreePairFirstFailure_le_common
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota) (v : V)
    (D₂ D₃ D₄ Gamma eta d Pscale : ℝ) (N : ℕ)
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (B : PairedFirstFailureSourceBudgets
      (SurvivingDegreeSourceBudgets H C (indexedGreedyGood Pgood)
        (targetTime eta d N) v D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ) Pscale
        (fun _ ↦ degreeSourceJumpScale d (coreEpsilon eta))
        (fun _ ↦ degreeTrajectoryScale Gamma eta d (N : ℝ))
        (fun _ ↦ degreeSourceVarianceScale d (coreEpsilon eta) (N : ℝ))
        (fun _ ↦ degreeFreedmanVarianceScale d (coreEpsilon eta) (N : ℝ)))
      (degreeUpperError H C v D₂ D₃ D₄ Gamma (coreEpsilon eta) d
        (N : ℝ) 0 ∅)
      (degreeLowerError H C v D₂ D₃ D₄ Gamma (coreEpsilon eta) d
        (N : ℝ) 0 ∅)
      (degreeDeviation d (coreEpsilon eta)))
    (hUpperComponent : ∀ k M, Pgood iUpper k M ↔
      degreeUpperCorridor H C v D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ) k M)
    (hLowerComponent : ∀ k M, Pgood iLower k M ↔
      degreeLowerCorridor H C v D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ) k M)
    :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iUpper) ≤
          commonTail eta d ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iLower) ≤
          commonTail eta d := by
  let T := targetTime eta d N
  let J := degreeSourceJumpScale d (coreEpsilon eta)
  let Q := degreeTrajectoryScale Gamma eta d (N : ℝ)
  let Vvar := degreeFreedmanVarianceScale d (coreEpsilon eta) (N : ℝ)
  let t := degreeDeviation d (coreEpsilon eta)
  let R := 2 * J
  let Wvar := (T : ℝ) * Vvar
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < (N : ℝ) :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hNlower
  have hJ : 0 < J := by
    unfold J degreeSourceJumpScale
    exact Real.rpow_pos_of_pos hd _
  have hQ : 0 ≤ Q := by
    unfold Q degreeTrajectoryScale
    exact div_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) (by linarith [E.Gamma_one])) hd.le)
      (mul_nonneg hNpos.le (by
        unfold trajectoryFloor publicError
        exact div_nonneg (Real.rpow_nonneg hd.le _) (by norm_num)))
  have hV : 0 ≤ Vvar := by
    unfold Vvar degreeFreedmanVarianceScale degreeSourceVarianceScale
    exact mul_nonneg (by norm_num)
      (div_nonneg (Real.rpow_nonneg hd.le _) hNpos.le)
  have ht : 0 < t := by unfold t degreeDeviation; positivity
  have hR0 : 0 ≤ R := by unfold R; positivity
  have hW0 : 0 ≤ Wvar := by unfold Wvar; positivity
  have hden : 0 < Wvar + R * t := by positivity
  have hQle : Q ≤ J := by
    simpa only [Q, J] using
      degreeTrajectoryScale_le_sourceJump E S hNlower
  have hR : ∀ k, k < T → J + Q ≤ R := by
    intro k hk
    dsimp only [R]
    linarith
  have hW : ∑ k ∈ Finset.range T, Vvar ≤ Wvar := by
    simp [Wvar]
  have htail := degreeFirstFailureMass_le_of_sourceBudgets
    H C ∅ T Pgood iUpper iLower v
    D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ) Pscale
    (fun _ ↦ J) (fun _ ↦ Q)
    (fun _ ↦ degreeSourceVarianceScale d (coreEpsilon eta) (N : ℝ))
    (fun _ ↦ Vvar)
    (fun _ ↦ hJ.le) (fun _ ↦ hQ) (fun _ ↦ hV)
    (by simpa only [T, J, Q, Vvar] using B.sourceBudgets)
    hR0 ht.le hW0 hden hR hW hUpperComponent hLowerComponent
    B.upperGap B.lowerGap
  have hcommon := degree_freedmanTail_le_common S E.Gamma_one
    (coreEpsilon_nonneg E)
    hNpos (Nat.cast_nonneg T) (by
      simpa only [T] using targetTime_cast_le_host E.eta_pos S hNlower)
  constructor
  · exact htail.1.trans (by simpa only [T, t, Wvar, R, Vvar, J] using hcommon)
  · exact htail.2.trans (by simpa only [T, t, Wvar, R, Vvar, J] using hcommon)

theorem externalPairFirstFailure_le_common
    {iota : Type*} [Fintype iota]
    (w : TestWeight V) (H : Hypergraph V) (C : ConflictSystem V)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota)
    (D₂ D₃ D₄ Gamma eta d Pfloor Wscale P : ℝ) (N : ℕ) (j s : ℕ)
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (B : PositivePairedFirstFailureSourceBudgets P
      (ExternalTestSourceBudgets w H C (indexedGreedyGood Pgood)
        (targetTime eta d N) D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ)
        Pfloor Wscale j s
        (fun _ ↦ testSourceJumpScale P d (coreEpsilon eta))
        (fun _ ↦ testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)))
      (externalTestUpperError w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s 0 ∅)
      (externalTestLowerError w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s 0 ∅)
      (testDeviation Gamma P d (coreEpsilon eta)))
    (hUpperComponent : ∀ k M, Pgood iUpper k M ↔
      externalTestUpperCorridor w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s k M)
    (hLowerComponent : ∀ k M, Pgood iLower k M ↔
      externalTestLowerCorridor w H C D₂ D₃ D₄ Gamma (coreEpsilon eta)
        d (N : ℝ) Wscale j s k M)
    :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iUpper) ≤
          commonTail eta d ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iLower) ≤
          commonTail eta d := by
  let T := targetTime eta d N
  let J := testSourceJumpScale P d (coreEpsilon eta)
  let Vvar := testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)
  let t := testDeviation Gamma P d (coreEpsilon eta)
  let Wvar := (T : ℝ) * Vvar
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < (N : ℝ) :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hNlower
  have hJ : 0 < J := by
    unfold J testSourceJumpScale
    exact mul_pos B.scale_pos (Real.rpow_pos_of_pos hd _)
  have hV : 0 ≤ Vvar := by
    unfold Vvar testFreedmanVarianceScale testSourceVarianceScale
    exact mul_nonneg (by norm_num)
      (div_nonneg (mul_nonneg (sq_nonneg P) (Real.rpow_nonneg hd.le _)) hNpos.le)
  have ht : 0 < t := by
    unfold t testDeviation
    have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one E.Gamma_one
    exact div_pos (mul_pos B.scale_pos (Real.rpow_pos_of_pos hd _))
      (mul_pos (by norm_num) hG)
  have hW0 : 0 ≤ Wvar := by unfold Wvar; positivity
  have hden : 0 < Wvar + J * t := by positivity
  have hW : ∑ k ∈ Finset.range T, Vvar ≤ Wvar := by simp [Wvar]
  have htail := externalTestFirstFailureMass_le_of_sourceBudgets
    w H C ∅ T Pgood iUpper iLower D₂ D₃ D₄ Gamma (coreEpsilon eta)
    d (N : ℝ) Pfloor Wscale j s (fun _ ↦ J) (fun _ ↦ Vvar)
    (fun _ ↦ hJ.le) (fun _ ↦ hV)
    (by simpa only [T, J, Vvar] using B.sourceBudgets)
    hJ.le ht.le hW0 hden (fun k hk ↦ le_rfl) hW
    hUpperComponent hLowerComponent B.upperGap B.lowerGap
  have hcommon := test_freedmanTail_le_common S E.Gamma_one
    (by
      rw [show coreEpsilon eta = eta / 50000 by
        simp only [coreEpsilon, CFMRegularization.rawRegularizationEps]
        ring]
      linarith [E.eta_pos]) B.scale_pos hNpos (Nat.cast_nonneg T) (by
      simpa only [T] using targetTime_cast_le_host E.eta_pos S hNlower)
  constructor
  · exact htail.1.trans (by simpa only [T, t, Wvar, Vvar, J] using hcommon)
  · exact htail.2.trans (by simpa only [T, t, Wvar, Vvar, J] using hcommon)

theorem internalPairFirstFailure_le_common
    {iota : Type*} [Fintype iota]
    (H : Hypergraph V) (C : ConflictSystem V) (hC : IsConflictSystem H C)
    (Pgood : iota → ℕ → Hypergraph V → Prop)
    (iUpper iLower : iota) (f : Finset V)
    (D₂ D₃ D₄ Gamma eta d Pfloor scale P : ℝ) (N : ℕ) (j s : ℕ)
    (E : CoreExponentSpec eta Gamma) (S : CoreCutoffSpec eta Gamma d)
    (hNlower : d ^ eta / 2 ≤ (N : ℝ))
    (B : PositivePairedFirstFailureSourceBudgets P
      (InternalConflictLinkSourceBudgets H C f (indexedGreedyGood Pgood)
        (targetTime eta d N) D₂ D₃ D₄ Gamma (coreEpsilon eta) d (N : ℝ)
        Pfloor scale j s
        (fun _ ↦ testSourceJumpScale P d (coreEpsilon eta))
        (fun _ ↦ testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)))
      (internalConflictLinkUpperError H C f D₂ D₃ D₄ Gamma
        (coreEpsilon eta) d (N : ℝ) scale j s 0 ∅)
      (internalConflictLinkLowerError H C f D₂ D₃ D₄ Gamma
        (coreEpsilon eta) d (N : ℝ) scale j s 0 ∅)
      (testDeviation Gamma P d (coreEpsilon eta)))
    (hUpperComponent : ∀ k M, Pgood iUpper k M ↔
      internalConflictLinkUpperCorridor H C f D₂ D₃ D₄ Gamma
        (coreEpsilon eta) d (N : ℝ) scale j s k M)
    (hLowerComponent : ∀ k M, Pgood iLower k M ↔
      internalConflictLinkLowerCorridor H C f D₂ D₃ D₄ Gamma
        (coreEpsilon eta) d (N : ℝ) scale j s k M)
    :
    Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iUpper) ≤
          commonTail eta d ∧
      Freedman.eventMass (normalizedGreedyPathMass H C)
        (greedyFirstFailureEvent H C ∅ (targetTime eta d N) Pgood iLower) ≤
          commonTail eta d := by
  let T := targetTime eta d N
  let J := testSourceJumpScale P d (coreEpsilon eta)
  let Vvar := testFreedmanVarianceScale P d (coreEpsilon eta) (N : ℝ)
  let t := testDeviation Gamma P d (coreEpsilon eta)
  let Wvar := (T : ℝ) * Vvar
  have hd : 0 < d := lt_of_lt_of_le (by norm_num) S.degreeAtLeastTwo
  have hNpos : 0 < (N : ℝ) :=
    (show 0 < d ^ eta / 2 by positivity).trans_le hNlower
  have hJ : 0 < J := by
    unfold J testSourceJumpScale
    exact mul_pos B.scale_pos (Real.rpow_pos_of_pos hd _)
  have hV : 0 ≤ Vvar := by
    unfold Vvar testFreedmanVarianceScale testSourceVarianceScale
    exact mul_nonneg (by norm_num)
      (div_nonneg (mul_nonneg (sq_nonneg P) (Real.rpow_nonneg hd.le _)) hNpos.le)
  have ht : 0 < t := by
    unfold t testDeviation
    have hG : 0 < Gamma := lt_of_lt_of_le zero_lt_one E.Gamma_one
    exact div_pos (mul_pos B.scale_pos (Real.rpow_pos_of_pos hd _))
      (mul_pos (by norm_num) hG)
  have hW0 : 0 ≤ Wvar := by unfold Wvar; positivity
  have hden : 0 < Wvar + J * t := by positivity
  have hW : ∑ k ∈ Finset.range T, Vvar ≤ Wvar := by simp [Wvar]
  have htail := internalConflictLinkFirstFailureMass_le_of_sourceBudgets
    H C hC ∅ T Pgood iUpper iLower f D₂ D₃ D₄ Gamma (coreEpsilon eta)
    d (N : ℝ) Pfloor scale j s (fun _ ↦ J) (fun _ ↦ Vvar)
    (fun _ ↦ hJ.le) (fun _ ↦ hV)
    (by simpa only [T, J, Vvar] using B.sourceBudgets)
    hJ.le ht.le hW0 hden (fun k hk ↦ le_rfl) hW
    hUpperComponent hLowerComponent B.upperGap B.lowerGap
  have hcommon := test_freedmanTail_le_common S E.Gamma_one
    (by
      rw [show coreEpsilon eta = eta / 50000 by
        simp only [coreEpsilon, CFMRegularization.rawRegularizationEps]
        ring]
      linarith [E.eta_pos]) B.scale_pos hNpos (Nat.cast_nonneg T) (by
      simpa only [T] using targetTime_cast_le_host E.eta_pos S hNlower)
  constructor
  · exact htail.1.trans (by simpa only [T, t, Wvar, Vvar, J] using hcommon)
  · exact htail.2.trans (by simpa only [T, t, Wvar, Vvar, J] using hcommon)

/-! ## Entropy and the finite paired three-family sum -/

theorem host_card_le_vertex_pow_eight
    (H : Hypergraph V) (hH : IsUniform H 8) :
    H.card ≤ (vertexFinset H).card ^ 8 := by
  calc
    H.card ≤ ((vertexFinset H).powersetCard 8).card := by
      apply Finset.card_le_card
      intro e he
      exact Finset.mem_powersetCard.mpr
        ⟨edge_subset_vertexFinset he, hH e he⟩
    _ = (vertexFinset H).card.choose 8 :=
      Finset.card_powersetCard 8 (vertexFinset H)
    _ ≤ (vertexFinset H).card ^ 8 :=
      Nat.choose_le_pow _ _

@[simp] theorem card_actualHostVertex (H : Hypergraph V) :
    Fintype.card (ActualHostVertex H) = (vertexFinset H).card := by
  exact Fintype.card_coe _

theorem card_externalTestCoordinate_le
    {iota : Type*} [Fintype iota] (j : iota → ℕ)
    (hj : ∀ i, j i ≤ 3) :
    Fintype.card (ExternalTestCoordinate j) ≤ 4 * Fintype.card iota := by
  rw [show Fintype.card (ExternalTestCoordinate j) =
      ∑ i, (j i + 1) by
    rw [Fintype.card_congr (Equiv.psigmaEquivSigma _)]
    simp only [Fintype.card_sigma, Fintype.card_fin]]
  calc
    (∑ i, (j i + 1)) ≤ ∑ _i : iota, 4 := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' := hj i
      omega
    _ = 4 * Fintype.card iota := by
      simp [nsmul_eq_mul, mul_comm]

@[simp] theorem card_internalLinkCoordinate (H : Hypergraph V) :
    Fintype.card (InternalLinkCoordinate H) = 6 * H.card := by
  change Fintype.card
    ((f : {e : Finset V // e ∈ H}) ×' (q : Fin 3) ×' Fin (q.1 + 1)) = _
  rw [Fintype.card_congr (Equiv.psigmaEquivSigma _), Fintype.card_sigma]
  have hinner : Fintype.card ((q : Fin 3) ×' Fin (q.1 + 1)) = 6 := by
    rw [Fintype.card_congr (Equiv.psigmaEquivSigma _), Fintype.card_sigma]
    norm_num [Fin.sum_univ_succ]
  simp [hinner, Fintype.card_coe, nsmul_eq_mul, mul_comm]

theorem four_mul_exp_le_exp_nine
    {a : ℝ} (ha : 32 ≤ a) :
    4 * exp a ≤ exp (9 * a) := by
  have hfour : (4 : ℝ) ≤ exp (8 * a) := by
    calc
      (4 : ℝ) ≤ 1 + 8 * a := by linarith
      _ ≤ exp (8 * a) := by
        simpa [add_comm] using Real.add_one_le_exp (8 * a)
  calc
    4 * exp a ≤ exp (8 * a) * exp a :=
      mul_le_mul_of_nonneg_right hfour (Real.exp_nonneg _)
    _ = exp (9 * a) := by
      rw [← Real.exp_add]
      congr 1
      ring

theorem nine_mul_exp_eight_le_exp_nine
    {a : ℝ} (ha : 32 ≤ a) :
    9 * exp (8 * a) ≤ exp (9 * a) := by
  have hnine : (9 : ℝ) ≤ exp a := by
    calc
      (9 : ℝ) ≤ 1 + a := by linarith
      _ ≤ exp a := by
        simpa [add_comm] using Real.add_one_le_exp a
  calc
    9 * exp (8 * a) ≤ exp a * exp (8 * a) :=
      mul_le_mul_of_nonneg_right hnine (Real.exp_nonneg _)
    _ = exp (9 * a) := by
      rw [← Real.exp_add]
      congr 1
      ring

theorem actualHostVertex_card_le_entropy
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V)
    (hvertex : ((vertexFinset H).card : ℝ) ≤ exp (d ^ (eta ^ 3))) :
    (Fintype.card (ActualHostVertex H) : ℝ) ≤
      exp (9 * d ^ (eta ^ 3)) := by
  have ha0 : 0 ≤ d ^ (eta ^ 3) := by
    exact Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _
  calc
    (Fintype.card (ActualHostVertex H) : ℝ) =
        ((vertexFinset H).card : ℝ) := by simp
    _ ≤ exp (d ^ (eta ^ 3)) := hvertex
    _ ≤ exp (9 * d ^ (eta ^ 3)) := by
      apply Real.exp_le_exp.mpr
      nlinarith

theorem externalTestCoordinate_card_le_entropy
    {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (j : iota → ℕ) (hj : ∀ i, j i ≤ 3)
    (htests : (Fintype.card iota : ℝ) ≤ exp (d ^ (eta ^ 3))) :
    (Fintype.card (ExternalTestCoordinate j) : ℝ) ≤
      exp (9 * d ^ (eta ^ 3)) := by
  calc
    (Fintype.card (ExternalTestCoordinate j) : ℝ) ≤
        4 * (Fintype.card iota : ℝ) := by
      exact_mod_cast card_externalTestCoordinate_le j hj
    _ ≤ 4 * exp (d ^ (eta ^ 3)) := by gcongr
    _ ≤ exp (9 * d ^ (eta ^ 3)) :=
      four_mul_exp_le_exp_nine S.stopExponentFloor

theorem internalLinkCoordinate_card_le_entropy
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (hvertex : ((vertexFinset H).card : ℝ) ≤ exp (d ^ (eta ^ 3))) :
    (Fintype.card (InternalLinkCoordinate H) : ℝ) ≤
      exp (9 * d ^ (eta ^ 3)) := by
  have hhost : (H.card : ℝ) ≤
      exp (8 * d ^ (eta ^ 3)) := by
    calc
      (H.card : ℝ) ≤ (((vertexFinset H).card : ℝ) ^ (8 : ℕ)) := by
        exact_mod_cast host_card_le_vertex_pow_eight H hH
      _ ≤ (exp (d ^ (eta ^ 3))) ^ (8 : ℕ) := by
        exact pow_le_pow_left₀ (Nat.cast_nonneg _) hvertex 8
      _ = exp (8 * d ^ (eta ^ 3)) := by
        rw [← Real.exp_nat_mul]
        congr 1
  calc
    (Fintype.card (InternalLinkCoordinate H) : ℝ) =
        6 * (H.card : ℝ) := by simp
    _ ≤ 6 * exp (8 * d ^ (eta ^ 3)) := by gcongr
    _ ≤ 9 * exp (8 * d ^ (eta ^ 3)) := by
      gcongr <;> norm_num
    _ ≤ exp (9 * d ^ (eta ^ 3)) :=
      nine_mul_exp_eight_le_exp_nine S.stopExponentFloor

theorem CoreCutoffSpec.strongFailureBudget
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d) :
    24 * (9 * d ^ (eta ^ 3)) ≤ 5 * d ^ tailPower eta ∧
      4 * Real.log 12 ≤ 5 * d ^ tailPower eta := by
  have hpow0 : 0 ≤ d ^ (eta ^ 3) := by
    have hd : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
    exact Real.rpow_nonneg hd _
  have htail0 : 0 ≤ d ^ tailPower eta := by
    have hd : 0 ≤ d := by linarith [S.degreeAtLeastTwo]
    exact Real.rpow_nonneg hd _
  constructor
  · nlinarith [S.entropyPower]
  · nlinarith [S.entropyLog]

theorem threeFamilyCommonTailSum_lt_one
    {I₁ I₂ I₃ : Type*} [Fintype I₁] [Fintype I₂] [Fintype I₃]
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (hc₁ : (Fintype.card I₁ : ℝ) ≤ exp (9 * d ^ (eta ^ 3)))
    (hc₂ : (Fintype.card I₂ : ℝ) ≤ exp (9 * d ^ (eta ^ 3)))
    (hc₃ : (Fintype.card I₃ : ℝ) ≤ exp (9 * d ^ (eta ^ 3))) :
    2 * (∑ _i : I₁, commonTail eta d) +
        2 * (∑ _i : I₂, commonTail eta d) +
        2 * (∑ _i : I₃, commonTail eta d) < 1 := by
  apply pairedThreeFamilyFailureSum_lt_one
    (5 * d ^ tailPower eta) (9 * d ^ (eta ^ 3))
    (fun _ : I₁ ↦ commonTail eta d)
    (fun _ : I₂ ↦ commonTail eta d)
    (fun _ : I₃ ↦ commonTail eta d)
  · exact mul_nonneg (by norm_num)
      (Real.rpow_nonneg (by linarith [S.degreeAtLeastTwo]) _)
  · exact (CoreCutoffSpec.strongFailureBudget S).1
  · exact (CoreCutoffSpec.strongFailureBudget S).2
  · exact hc₁
  · exact hc₂
  · exact hc₃
  · intro i
    rfl
  · intro i
    rfl
  · intro i
    rfl

theorem regularizedGreedyCorridorCommonTail_sum_lt_one
    {iota : Type*} [Fintype iota]
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (hH : IsUniform H 8)
    (j : iota → ℕ) (hj : ∀ i, j i ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤ exp (d ^ (eta ^ 3)))
    (htests : (Fintype.card iota : ℝ) ≤ exp (d ^ (eta ^ 3))) :
    (∑ a : RegularizedGreedyCorridorIndex H j,
      regularizedGreedyCorridorTail
        (fun _ : ActualHostVertex H ↦ commonTail eta d)
        (fun _ : ExternalTestCoordinate j ↦ commonTail eta d)
        (fun _ : InternalLinkCoordinate H ↦ commonTail eta d) a) < 1 := by
  have hsum := threeFamilyCommonTailSum_lt_one S
    (actualHostVertex_card_le_entropy S H hvertex)
    (externalTestCoordinate_card_le_entropy S j hj htests)
    (internalLinkCoordinate_card_le_entropy S H hH hvertex)
  simp [RegularizedGreedyCorridorIndex, regularizedGreedyCorridorTail,
    Fintype.sum_sum_type, Fintype.sum_prod_type] at hsum ⊢
  nlinarith

theorem regularizedGreedyCorridorCommonTail_sum_lt_one_of_specialized
    {iota : Type*} [Fintype V] [Fintype iota]
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (ell : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hinst : IsSpecializedCFMInstance H C d eta ell j w) :
    (∑ a : RegularizedGreedyCorridorIndex H j,
      regularizedGreedyCorridorTail
        (fun _ : ActualHostVertex H ↦ commonTail eta d)
        (fun _ : ExternalTestCoordinate j ↦ commonTail eta d)
        (fun _ : InternalLinkCoordinate H ↦ commonTail eta d) a) < 1 := by
  rcases hinst with
    ⟨hH, hC, hell, hCfour, heta, heta1, hd, hvertex,
      hdegree, hcodegree, hbounded, htests, htrack⟩
  exact regularizedGreedyCorridorCommonTail_sum_lt_one S H hH j
    (fun i ↦ (htrack i).2.1) hvertex htests

theorem exists_regularizedGreedyCore_of_commonFirstFailureBounds
    {iota : Type*} [Fintype V] [Fintype iota]
    {eta Gamma d : ℝ} (S : CoreCutoffSpec eta Gamma d)
    (H : Hypergraph V) (C : ConflictSystem V) (T : ℕ)
    (D₂ D₃ D₄ epsilon err : ℝ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (hH : IsUniform H 8) (hC : ∅ ∉ C)
    (hsize : 8 * T < (vertexFinset H).card)
    (htrajectory : ∀ k, k < T →
      0 < CFMTrajectories.dHat D₂ D₃ D₄ d ((vertexFinset H).card : ℝ) k -
        CFMTrajectories.delta D₂ D₃ D₄ Gamma epsilon d
          ((vertexFinset H).card : ℝ) k)
    (hinitial : ∀ a : RegularizedGreedyCorridorIndex H j,
      regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
        ((vertexFinset H).card : ℝ) j w a 0 ∅)
    (hdegreeBad : ∀ v : ActualHostVertex H,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inl (false, v))) ≤ commonTail eta d ∧
        Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inl (true, v))) ≤ commonTail eta d)
    (hexternalBad : ∀ a : ExternalTestCoordinate j,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inl (false, a)))) ≤ commonTail eta d ∧
        Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inl (true, a)))) ≤ commonTail eta d)
    (hinternalBad : ∀ a : InternalLinkCoordinate H,
      Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inr (false, a)))) ≤ commonTail eta d ∧
        Freedman.eventMass (normalizedGreedyPathMass H C)
          (greedyFirstFailureEvent H C ∅ T
            (regularizedGreedyCorridorPredicate H C D₂ D₃ D₄ Gamma epsilon d
              ((vertexFinset H).card : ℝ) j w)
            (Sum.inr (Sum.inr (true, a)))) ≤ commonTail eta d)
    (hj : ∀ i, j i ≤ 3)
    (hvertex : ((vertexFinset H).card : ℝ) ≤ exp (d ^ (eta ^ 3)))
    (htests : (Fintype.card iota : ℝ) ≤ exp (d ^ (eta ^ 3)))
    (hterminal : ∀ M, IsMatching H M → M.card = T →
      (∀ i,
        externalTestUpperCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d
            ((vertexFinset H).card : ℝ) (testTotal (w i) H (j i))
            (j i) 0 T M ∧
          externalTestLowerCorridor (w i) H C D₂ D₃ D₄ Gamma epsilon d
            ((vertexFinset H).card : ℝ) (testTotal (w i) H (j i))
            (j i) 0 T M) →
      SatisfiesTestEstimates H M d err j w) :
    ∃ M, IsConflictFreeMatching H C M ∧ M.card = T ∧
      SatisfiesTestEstimates H M d err j w := by
  apply exists_regularizedGreedyCore_of_componentFirstFailureBounds
    H C T D₂ D₃ D₄ Gamma epsilon d err j w
    (fun _ : ActualHostVertex H ↦ commonTail eta d)
    (fun _ : ExternalTestCoordinate j ↦ commonTail eta d)
    (fun _ : InternalLinkCoordinate H ↦ commonTail eta d)
    hH hC hsize htrajectory hinitial hdegreeBad hexternalBad hinternalBad
    (regularizedGreedyCorridorCommonTail_sum_lt_one
      S H hH j hj hvertex htests) hterminal

end

end Erdos136.CFMNumericAggregation

namespace Erdos136

open Finset
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

variable {V : Type*} [DecidableEq V]

/-! Exact time-zero identities for the activity-aware internal link
corridors.  These are independent of the certificate parameterization. -/

theorem internalConflictLinkErrors_initial_top
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (q : ℕ)
    (hC : IsConflictSystem H C)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card) :
    internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q q 0 ∅ =
        ((conflictLinkLayer C f q).card : ℝ) -
          scale * (1 +
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N q q 0) ∧
      internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q q 0 ∅ =
        scale * (1 -
            CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N q q 0) -
          ((conflictLinkLayer C f q).card : ℝ) := by
  have hA : availableEdges H C ∅ = H :=
    availableEdges_empty_eq_host H C hCcard
  have hz := zHat_zero_eq_indicator D₂ D₃ D₄ d N
    (j := q) (s := q) le_rfl
  unfold internalConflictLinkUpperError internalConflictLinkLowerError
  rw [hA, partialConflictLink_initial hC f q]
  simp only [Nat.cast_zero]
  rw [hz]
  simp

theorem internalConflictLinkErrors_initial_below
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale : ℝ) (q s : ℕ)
    (hC : IsConflictSystem H C) (hsq : s < q)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card) :
    internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q s 0 ∅ =
        -(scale *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N q s 0) ∧
      internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q s 0 ∅ =
        -(scale *
          CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N q s 0) := by
  have hzero :
      (((partialFamily (conflictLinkLayer C f q)
        (availableEdges H C ∅) ∅ s).card : ℕ) : ℝ) = 0 := by
    rw [← partialTestObservable_conflictLinkTestWeight hC f q s ∅]
    simpa [hsq.ne] using
      (partialTestObservable_initial_all
        (conflictLinkTestWeight C f q) H C (s := s) hsq.le hCcard)
  have hz := zHat_zero_eq_indicator D₂ D₃ D₄ d N
    (j := q) (s := s) hsq.le
  unfold internalConflictLinkUpperError internalConflictLinkLowerError
  rw [hzero]
  simp only [Nat.cast_zero]
  rw [hz]
  simp [hsq.ne]

theorem internalConflictLinkErrors_initial_top_le_margin
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale err t : ℝ) (q : ℕ)
    (hC : IsConflictSystem H C)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hinterval : CFMRegularization.InRelativeInterval
      ((conflictLinkLayer C f q).card : ℝ) scale err)
    (hmargin : t ≤ scale *
      (CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N q q 0 - err)) :
    internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q q 0 ∅ ≤ -t ∧
      internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q q 0 ∅ ≤ -t := by
  have herr := internalConflictLinkErrors_initial_top
    H C f D₂ D₃ D₄ Gamma epsilon d N scale q hC hCcard
  unfold CFMRegularization.InRelativeInterval at hinterval
  constructor
  · rw [herr.1]
    nlinarith [hinterval.2]
  · rw [herr.2]
    nlinarith [hinterval.1]

theorem internalConflictLinkErrors_initial_below_le_margin
    (H : Hypergraph V) (C : ConflictSystem V) (f : Finset V)
    (D₂ D₃ D₄ Gamma epsilon d N scale t : ℝ) (q s : ℕ)
    (hC : IsConflictSystem H C) (hsq : s < q)
    (hCcard : ∀ c ∈ C, 2 ≤ c.card)
    (hmargin : t ≤ scale *
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N q s 0) :
    internalConflictLinkUpperError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q s 0 ∅ ≤ -t ∧
      internalConflictLinkLowerError H C f
          D₂ D₃ D₄ Gamma epsilon d N scale q s 0 ∅ ≤ -t := by
  have herr := internalConflictLinkErrors_initial_below
    H C f D₂ D₃ D₄ Gamma epsilon d N scale q s hC hsq hCcard
  constructor
  · rw [herr.1]
    linarith
  · rw [herr.2]
    linarith

/-! The regularization error is much smaller than the core error's main
time-zero term.  The remaining correction term is exactly the deviation
used by the internal-link Freedman bound. -/

theorem raw_error_le_core_initial_factor
    {d epsRaw epsilonCore : ℝ} (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    (hcore : epsilonCore = epsRaw / 5) :
    Real.rpow d (-epsRaw) ≤ Real.rpow d (-epsilonCore / 32) := by
  apply Real.rpow_le_rpow_of_exponent_le hd
  rw [hcore]
  linarith

theorem zeta_zero_eq_indicator_plus_correction
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j s : ℕ)
    (hsj : s ≤ j) :
    CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s 0 =
      Real.rpow d (-epsilon / 32) *
        ((if s = j then 1 else 0) +
          (Nat.choose j s : ℝ) * d ^ s / (4 * Gamma * d ^ j)) := by
  unfold CFMTrajectories.zeta CFMTrajectories.xi CFMTrajectories.dHat
  rw [zHat_zero_eq_indicator D₂ D₃ D₄ d N hsj]
  simp [CFMTrajectories.pV, CFMTrajectories.q,
    CFMTrajectories.GammaHat, CFMTrajectories.pM]

theorem zeta_zero_correction_le
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j s : ℕ)
    (hsj : s ≤ j) (hd : 0 < d) (hGamma : 0 < Gamma) :
    Real.rpow d (-epsilon / 32) *
        (d ^ s / (4 * Gamma * d ^ j)) ≤
      CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j s 0 := by
  rw [zeta_zero_eq_indicator_plus_correction
    D₂ D₃ D₄ Gamma epsilon d N j s hsj]
  have hchoose : (1 : ℝ) ≤ Nat.choose j s := by
    exact_mod_cast Nat.choose_pos hsj
  have hpow : 0 ≤ d ^ s / (4 * Gamma * d ^ j) := by positivity
  have hindicator : 0 ≤ (if s = j then (1 : ℝ) else 0) := by positivity
  have hinside :
      d ^ s / (4 * Gamma * d ^ j) ≤
        (if s = j then (1 : ℝ) else 0) +
          (Nat.choose j s : ℝ) * d ^ s / (4 * Gamma * d ^ j) := by
    have hm := mul_le_mul_of_nonneg_right hchoose hpow
    have hreassoc :
        (Nat.choose j s : ℝ) * (d ^ s / (4 * Gamma * d ^ j)) =
          (Nat.choose j s : ℝ) * d ^ s / (4 * Gamma * d ^ j) := by
      ring
    rw [← hreassoc]
    nlinarith
  exact mul_le_mul_of_nonneg_left hinside (Real.rpow_nonneg hd.le _)

theorem zeta_zero_top_eq_main_add_correction
    (D₂ D₃ D₄ Gamma epsilon d N : ℝ) (j : ℕ) :
    CFMTrajectories.zeta D₂ D₃ D₄ Gamma epsilon d N j j 0 =
      Real.rpow d (-epsilon / 32) +
        Real.rpow d (-epsilon / 32) *
          (d ^ j / (4 * Gamma * d ^ j)) := by
  rw [zeta_zero_eq_indicator_plus_correction
    D₂ D₃ D₄ Gamma epsilon d N j j le_rfl]
  simp
  ring

theorem core_initial_correction_eq_natural_deviation
    (scale Gamma d epsilon : ℝ) (j s : ℕ)
    (hd : 0 < d) :
    scale * (Real.rpow d (-epsilon / 32) *
        (d ^ s / (4 * Gamma * d ^ j))) =
      (scale * Real.rpow d ((s : ℝ) - (j : ℝ))) *
        Real.rpow d (-epsilon / 32) / (4 * Gamma) := by
  rw [show (d ^ s : ℝ) = Real.rpow d (s : ℝ) by
      symm; exact Real.rpow_natCast d s,
    show (d ^ j : ℝ) = Real.rpow d (j : ℝ) by
      symm; exact Real.rpow_natCast d j]
  have hratio :
      Real.rpow d (s : ℝ) / Real.rpow d (j : ℝ) =
        Real.rpow d ((s : ℝ) - (j : ℝ)) := by
    exact (Real.rpow_sub hd (s : ℝ) (j : ℝ)).symm
  rw [show Real.rpow d (s : ℝ) / (4 * Gamma * Real.rpow d (j : ℝ)) =
      (Real.rpow d (s : ℝ) / Real.rpow d (j : ℝ)) / (4 * Gamma) by
        ring,
    hratio]
  ring

/-! Literal certificate centers.  The certificate's conflict parameter
and the core corridor's conflict parameter are deliberately independent. -/

def certificateInternalLayerScale
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) (r : ℕ) : ℝ :=
  CFMRegularization.completionTarget d epsRaw
    (CFMRegularization.layerMaxDegree H
      (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) r : ℝ) r

def certificateD₂
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) : ℝ :=
  certificateInternalLayerScale H C d epsRaw GammaCert ellCert j w R 2

def certificateD₃
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) : ℝ :=
  certificateInternalLayerScale H C d epsRaw GammaCert ellCert j w R 3

def certificateD₄
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) : ℝ :=
  certificateInternalLayerScale H C d epsRaw GammaCert ellCert j w R 4

@[simp] theorem certificate_internalLinkLayerScale
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) (q : Fin 3) :
    internalLinkLayerScale
        (certificateD₂ H C d epsRaw GammaCert ellCert j w R)
        (certificateD₃ H C d epsRaw GammaCert ellCert j w R)
        (certificateD₄ H C d epsRaw GammaCert ellCert j w R) q =
      certificateInternalLayerScale
        H C d epsRaw GammaCert ellCert j w R (q.1 + 2) := by
  fin_cases q <;>
    simp [certificateD₂, certificateD₃, certificateD₄]

theorem certificateInternalLayerScale_pos
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w) (r : ℕ) (hd : 0 < d) :
    0 < certificateInternalLayerScale H C d epsRaw GammaCert ellCert j w R r := by
  unfold certificateInternalLayerScale CFMRegularization.completionTarget
  have hpow : 0 < Real.rpow d ((r : ℝ) - 1 - epsRaw / 600) :=
    Real.rpow_pos_of_pos hd _
  have hmax : 0 < max (Real.rpow d ((r : ℝ) - 1 - epsRaw / 600))
      (CFMRegularization.layerMaxDegree H
        (CFMRegularization.minimalMatchingCore H (C ∪ R.badPairs)) r : ℝ) :=
    hpow.trans_le (le_max_left _ _)
  have hfactor : 0 < 1 + Real.rpow d (-epsRaw / 4) := by
    have hr : 0 < d.rpow (-epsRaw / 4) :=
      Real.rpow_pos_of_pos hd (-epsRaw / 4)
    linarith
  exact mul_pos hfactor hmax

theorem certificateInternalLink_initial_interval
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (f : Finset V) (hf : f ∈ H) (q : ℕ) (hq1 : 1 ≤ q) (hq3 : q ≤ 3) :
    CFMRegularization.InRelativeInterval
      ((conflictLinkLayer R.regularized f q).card : ℝ)
      (certificateInternalLayerScale
        H C d epsRaw GammaCert ellCert j w R (q + 1))
      (Real.rpow d (-epsRaw)) := by
  rw [CFMRegularization.card_conflictLinkLayer_eq_degree_layer]
  simpa only [certificateInternalLayerScale] using
    (R.layerDegree (q + 1) (by omega) (by omega) f hf)

/-! The exact first-failure initial margin for every internal coordinate.
The right side is the natural coordinate scale times the common
`d^(-epsilonCore/32)/(4 GammaCore)` deviation. -/

theorem certificateInternalConflictLink_initial_errors_le_naturalDeviation
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (D₂ D₃ D₄ GammaCore epsilonCore N : ℝ)
    (f : Finset V) (hf : f ∈ H) (q s : ℕ)
    (hq1 : 1 ≤ q) (hq3 : q ≤ 3) (hsq : s ≤ q)
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw)
    (hcore : epsilonCore = epsRaw / 5) (hGammaCore : 0 < GammaCore) :
    let scale := certificateInternalLayerScale
      H C d epsRaw GammaCert ellCert j w R (q + 1)
    let deviation :=
      (scale * Real.rpow d ((s : ℝ) - (q : ℝ))) *
        Real.rpow d (-epsilonCore / 32) / (4 * GammaCore)
    internalConflictLinkUpperError H R.regularized f
          D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅ ≤
        -deviation ∧
      internalConflictLinkLowerError H R.regularized f
          D₂ D₃ D₄ GammaCore epsilonCore d N scale q s 0 ∅ ≤
        -deviation := by
  dsimp only
  have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
  let scale := certificateInternalLayerScale
    H C d epsRaw GammaCert ellCert j w R (q + 1)
  let correction := Real.rpow d (-epsilonCore / 32) *
    (d ^ s / (4 * GammaCore * d ^ q))
  have hscale : 0 < scale := by
    exact certificateInternalLayerScale_pos
      H C d epsRaw GammaCert ellCert j w R (q + 1) hdpos
  have hCcard : ∀ c ∈ R.regularized, 2 ≤ c.card := by
    intro c hc
    exact (R.bounded.conflict_card hc).1
  have hcorrection :
      correction ≤ CFMTrajectories.zeta
        D₂ D₃ D₄ GammaCore epsilonCore d N q s 0 := by
    exact zeta_zero_correction_le
      D₂ D₃ D₄ GammaCore epsilonCore d N q s hsq hdpos hGammaCore
  have hdeviation :
      scale * correction =
        (scale * Real.rpow d ((s : ℝ) - (q : ℝ))) *
          Real.rpow d (-epsilonCore / 32) / (4 * GammaCore) := by
    exact core_initial_correction_eq_natural_deviation
      scale GammaCore d epsilonCore q s hdpos
  by_cases htop : s = q
  · subst s
    have hinterval := certificateInternalLink_initial_interval
      H C d epsRaw GammaCert ellCert j w R f hf q hq1 hq3
    have hraw := raw_error_le_core_initial_factor hd heps hcore
    have hztop := zeta_zero_top_eq_main_add_correction
      D₂ D₃ D₄ GammaCore epsilonCore d N q
    have hgap : correction ≤
        CFMTrajectories.zeta
            D₂ D₃ D₄ GammaCore epsilonCore d N q q 0 -
          Real.rpow d (-epsRaw) := by
      dsimp only [correction]
      rw [hztop]
      linarith
    have hmargin : scale * correction ≤ scale *
        (CFMTrajectories.zeta
            D₂ D₃ D₄ GammaCore epsilonCore d N q q 0 -
          Real.rpow d (-epsRaw)) :=
      mul_le_mul_of_nonneg_left hgap hscale.le
    have herrors := internalConflictLinkErrors_initial_top_le_margin
      H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
      scale (Real.rpow d (-epsRaw)) (scale * correction) q
      R.isConflictSystem hCcard hinterval hmargin
    simpa only [hdeviation] using herrors
  · have hslt : s < q := lt_of_le_of_ne hsq htop
    have hmargin : scale * correction ≤ scale *
        CFMTrajectories.zeta
          D₂ D₃ D₄ GammaCore epsilonCore d N q s 0 :=
      mul_le_mul_of_nonneg_left hcorrection hscale.le
    have herrors := internalConflictLinkErrors_initial_below_le_margin
      H R.regularized f D₂ D₃ D₄ GammaCore epsilonCore d N
      scale (scale * correction) q s R.isConflictSystem hslt hCcard hmargin
    simpa only [hdeviation] using herrors

theorem certificateInternalConflictLink_initial_errors_fin
    {io : Type*} [Fintype io]
    (H : Hypergraph V) (C : ConflictSystem V)
    (d epsRaw GammaCert : ℝ) (ellCert : ℕ)
    (j : io → ℕ) (w : io → TestWeight V)
    (R : CFMRegularization.RegularizationCertificate
      H C d epsRaw GammaCert ellCert j w)
    (N : ℝ) (f : {e : Finset V // e ∈ H})
    (q : Fin 3) (u : Fin (q.1 + 1))
    (hd : 1 ≤ d) (heps : 0 ≤ epsRaw) (hGammaCert : 0 < GammaCert) :
    let D₂ := certificateD₂ H C d epsRaw GammaCert ellCert j w R
    let D₃ := certificateD₃ H C d epsRaw GammaCert ellCert j w R
    let D₄ := certificateD₄ H C d epsRaw GammaCert ellCert j w R
    let GammaCore := 3 * GammaCert
    let epsilonCore := epsRaw / 5
    let scale := internalLinkLayerScale D₂ D₃ D₄ q
    let deviation :=
      (scale * Real.rpow d (((u.1 + 1 : ℕ) : ℝ) - (q.1 + 1 : ℕ))) *
        Real.rpow d (-epsilonCore / 32) / (4 * GammaCore)
    internalConflictLinkUpperError H R.regularized f.1
          D₂ D₃ D₄ GammaCore epsilonCore d N scale
          (q.1 + 1) (u.1 + 1) 0 ∅ ≤ -deviation ∧
      internalConflictLinkLowerError H R.regularized f.1
          D₂ D₃ D₄ GammaCore epsilonCore d N scale
          (q.1 + 1) (u.1 + 1) 0 ∅ ≤ -deviation := by
  dsimp only
  let D₂ := certificateD₂ H C d epsRaw GammaCert ellCert j w R
  let D₃ := certificateD₃ H C d epsRaw GammaCert ellCert j w R
  let D₄ := certificateD₄ H C d epsRaw GammaCert ellCert j w R
  have hq1 : 1 ≤ q.1 + 1 := by omega
  have hq3 : q.1 + 1 ≤ 3 := by omega
  have hsq : u.1 + 1 ≤ q.1 + 1 := by omega
  have hbase :=
    certificateInternalConflictLink_initial_errors_le_naturalDeviation
      H C d epsRaw GammaCert ellCert j w R
      D₂ D₃ D₄ (3 * GammaCert) (epsRaw / 5) N
      f.1 f.2 (q.1 + 1) (u.1 + 1) hq1 hq3 hsq hd heps rfl
      (mul_pos (by norm_num) hGammaCert)
  have hscale := certificate_internalLinkLayerScale
    H C d epsRaw GammaCert ellCert j w R q
  simpa only [D₂, D₃, D₄, hscale] using hbase

end

end Erdos136

