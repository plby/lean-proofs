    testTotal (finiteWeightedRootShadowWeight X a c) M c.selected.1 ≤
      finiteWeightedRootShadowCap eta d (N : ℝ) (d₀ c.profile)
        (familyRank c.profile) c.root.card c.selected.1 k := by
  exact finiteWeightedRootShadowCap_of_predicate
    (indexedFiniteWeightedRootShadowEnhancedGood_shadow
      H C D₂ D₃ D₄ Gamma eta d N T j w familyRank activeRank seed X a d₀ hgood c)

/-- Empty-root partial mass extraction.  This is the common projection used
by the duplicate, conflict-conflict reroot, and gain-residual profiles. -/
theorem weightedPartialFamilyMass_le_cap_of_enhancedGood
    {iota Profile : Type*}
    (H : Hypergraph V) (C : ConflictSystem V)
    (D₂ D₃ D₄ Gamma eta d : ℝ) (N T : ℕ)
    (j : iota → ℕ) (w : iota → TestWeight V)
    (familyRank activeRank : Profile → ℕ) (seed : Profile → Hypergraph V)
    (X : Profile → ConflictSystem V) (a : Profile → TestWeight V)
    (d₀ : Profile → ℝ) {k : ℕ} {M A : Hypergraph V}
    (hgood : indexedGreedyGood
      (finiteWeightedRootShadowEnhancedPredicate H C
        D₂ D₃ D₄ Gamma eta d N T j w familyRank activeRank seed X a d₀) k M)
    (b : Profile) (s : ℕ)
    (huniform : IsUniform (X b) (familyRank b))
    (hnonneg : ∀ U, 0 ≤ a b U)
    (hs : s < familyRank b) (hrank : familyRank b ≤ 5)
    (hactive : familyRank b - s ≤ activeRank b)
    (hseed : seed b = ∅) :
    weightedPartialFamilyMass (X b) (a b) A M s ≤
      finiteWeightedRootShadowCap eta d (N : ℝ) (d₀ b)
        (familyRank b) 0 (familyRank b - s) k := by
  let c := finiteWeightedRootShadowEmptyCoordinate (H := H)
    b (familyRank b - s) (by omega) (by omega) hactive hseed
  have hpartial := weightedPartialFamilyMass_le_shadowTotal
    (X b) (a b) A M (familyRank b) s huniform hnonneg
  have hcap := finiteWeightedRootShadowCap_of_enhancedGood
    H C D₂ D₃ D₄ Gamma eta d N T j w familyRank activeRank seed X a d₀ hgood c
  have hcap' :
      testTotal (weightedConflictFamilyShadowWeight (X b) (a b)) M
          (familyRank b - s) ≤
        finiteWeightedRootShadowCap eta d (N : ℝ) (d₀ b)
          (familyRank b) 0 (familyRank b - s) k := by
    simpa [finiteWeightedRootShadowWeight, c,
      finiteWeightedRootShadowEmptyCoordinate,
      weightedConflictFamilyRootShadowWeight_empty] using hcap
  exact hpartial.trans hcap'

