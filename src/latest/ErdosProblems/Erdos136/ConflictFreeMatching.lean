      _ ≤ (54 * Gamma * D) * Env := hmul
      _ = 54 * Gamma * D * Env := by ring
  have hxiNumerator : xi * numerator ≤ 214 * Gamma * D * Env := by
    dsimp only [numerator]
    nlinarith [hsucc, hcurrent]
  have hid : h = N * pv * D / 8 := by
    dsimp only [h, pv, D]
    unfold CFMTrajectories.hHat CFMTrajectories.dHat CFMTrajectories.q
    ring
  have hnumeratorRatio : numerator / h ≤
