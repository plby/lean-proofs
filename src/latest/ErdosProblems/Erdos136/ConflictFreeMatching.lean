        (2 * (ell : ℝ) + 1) ell j w)
    (D₂ D₃ D₄ : ℝ) {M : Hypergraph V}
    (hk : k < CFMNumericAggregation.targetTime eta d (vertexFinset H).card)
    (hgood : indexedGreedyGood
      (degreeEnhancedGreedyPredicate H R.regularized
        D₂ D₃ D₄ Gamma eta d (vertexFinset H).card
