/- leanprover/lean4:v4.33.0 mathlib v4.33.0 -/
import ErdosProblems.Erdos1165.AnnularRecursiveProfileCodeAssembly
import ErdosProblems.Erdos1165.AnnularRecursiveProfileShape

/-!
# Physical depth of gap-chain refinement trees

The refinement tree associated with a profile segment has one internal
level for every remaining scale transition.  Consequently the usual
segment-length bound is exactly the `Fits` premise required by the literal
recursive word assembler.
-/

namespace Erdos1165.AnnularRecursiveProfileShapeFits

open AnnularRecursiveDecoratedProfileCode
open AnnularRecursiveProfileCodeAssembly AnnularRecursiveProfileShape
open AnnularProfileNestedEdge
open ProfileGapChain

noncomputable section

/-- An ordinary list of child trees fits at a parent level when every child
fits one level deeper. -/
theorem profileRefinementForestFits_ofList
    {n k : ℕ} {children : List ProfileRefinementTree}
    (hchildren : ∀ child ∈ children,
      profileRefinementTreeFits n (k + 1) child) :
    profileRefinementForestFits n k
      (ProfileRefinementForest.ofList children) := by
  induction children with
  | nil => trivial
  | cons child tail ih =>
      exact ⟨hchildren child (by simp), ih (fun tree htree ↦
        hchildren tree (by simp [htree]))⟩

/-- Every tree canonically generated by a fixed gap chain fits in the
available profile depth. -/
theorem profileRefinementTreeFits_profileRefinementTrees :
    ∀ {n k a : ℕ} (rest : List ℕ) (chain : GapChain (a :: rest))
      (i : Fin a),
      k + rest.length ≤ n →
      profileRefinementTreeFits n k
        (profileRefinementTrees a rest chain i) := by
  intro n k a rest
  induction rest generalizing k a with
  | nil =>
      intro chain i _hdepth
      trivial
  | cons b rest ih =>
      intro chain i hdepth
      refine ⟨by simp only [List.length_cons] at hdepth; omega, ?_⟩
      apply profileRefinementForestFits_ofList
      intro child hchild
      rw [List.mem_ofFn] at hchild
      obtain ⟨j, rfl⟩ := hchild
      apply ih chain.2 (gapChildIndexEquiv chain.1 ⟨i, j⟩)
      simp only [List.length_cons] at hdepth
      omega

end

end Erdos1165.AnnularRecursiveProfileShapeFits
