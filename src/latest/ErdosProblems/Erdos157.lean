                (by rw [Category.assoc, hf, ← Category.assoc, he,
                  Category.assoc])).hom) := by
    rfl
  rw [had, Equiv.apply_symm_apply]
  dsimp only [ai]
  rw [CategoryTheory.conjugateEquiv_mateEquiv_vcomp]
  rw [baseChangeSheafPullbackCompNormalizedMateIsoBetween_conjugate_hom]
  rw [CategoryTheory.mateEquiv_conjugateEquiv_vcomp]
  rw [baseChangeSheafPullbackCompNormalizedMateIsoBetween_conjugate_inv]
  rw [CategoryTheory.mateEquiv_hcomp]
  have hae : ae =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIsoUnitNormalized ebar)
        (baseChangeSheafAdjunctionOfIsoUnitNormalized e)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIsoBetween
              jX jY e ebar he).hom) := by
    rfl
  have haf : af =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIsoUnitNormalized fbar)
        (baseChangeSheafAdjunctionOfIsoUnitNormalized f)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIsoBetween
              jY jZ f fbar hf).hom) := by
    rfl
  rw [hae, haf]
  rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  apply CategoryTheory.TwoSquare.ext
  intro Q
  exact congr_app
    (equivariantBaseChangeRightAdjointIsoBetween_hom_comp_actual
      jX jY jZ e f ebar fbar he hf) Q

/-- Unit-normalized lower-shriek transport around an arbitrary isomorphism
square. -/
noncomputable def lowerShriekEquivariantIsoBetweenUnitNormalized
    {X Y Xbar Ybar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (e : X ⟶ Y) [IsIso e]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (h : e ≫ jY = jX ≫ ebar) :
    lowerShriek jX ⋙ baseChangeSheafPushforward ebar ≅
      baseChangeSheafPushforward e ⋙ lowerShriek jY := by
  let aLeft :=
    (lowerShriekAdjunction jX).comp
      (baseChangeSheafAdjunctionOfIsoUnitNormalized ebar)
  let aRight :=
    (baseChangeSheafAdjunctionOfIsoUnitNormalized e).comp
      (lowerShriekAdjunction jY)
  exact Adjunction.leftAdjointUniq
    (aLeft.ofNatIsoRight
      (equivariantBaseChangeRightAdjointIsoBetween jX jY e ebar h))
    aRight

noncomputable def lowerShriekEquivariantIsoBetweenIteratedUnitNormalized
    {X Y Z Xbar Ybar Zbar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (jZ : Z ⟶ Zbar) [WeaklyEtale jZ]
    (e : X ⟶ Y) [IsIso e] (f : Y ⟶ Z) [IsIso f]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (fbar : Ybar ⟶ Zbar) [IsIso fbar]
    (he : e ≫ jY = jX ≫ ebar) (hf : f ≫ jZ = jY ≫ fbar) :
    lowerShriek jX ⋙ baseChangeSheafPushforward (ebar ≫ fbar) ≅
      baseChangeSheafPushforward (e ≫ f) ⋙ lowerShriek jZ :=
  Functor.isoWhiskerLeft (lowerShriek jX)
      (baseChangeSheafPullbackCompNormalizedMateIsoBetween
        ebar fbar).symm ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        jX jY e ebar he)
      (baseChangeSheafPushforward fbar) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (baseChangeSheafPushforward e)
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        jY jZ f fbar hf) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (baseChangeSheafPullbackCompNormalizedMateIsoBetween e f)
      (lowerShriek jZ)

theorem lowerShriekEquivariantIsoBetweenUnitNormalized_inv_eq_mate
    {X Y Xbar Ybar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (e : X ⟶ Y) [IsIso e]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (h : e ≫ jY = jX ≫ ebar) :
    (lowerShriekEquivariantIsoBetweenUnitNormalized
      jX jY e ebar h).inv =
      ((CategoryTheory.mateEquiv
        (lowerShriekAdjunction jX) (lowerShriekAdjunction jY)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeForwardRightAdjointBetweenUnitNormalized
              jX jY e ebar h))).natTrans := by
  let aLeft :=
    (lowerShriekAdjunction jX).comp
      (baseChangeSheafAdjunctionOfIsoUnitNormalized ebar)
  let aRight :=
    (baseChangeSheafAdjunctionOfIsoUnitNormalized e).comp
      (lowerShriekAdjunction jY)
  let theta := equivariantBaseChangeRightAdjointIsoBetween
    jX jY e ebar h
  have hconj :
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        jX jY e ebar h).inv =
        (CategoryTheory.conjugateEquiv aLeft aRight).symm theta.hom := by
    unfold lowerShriekEquivariantIsoBetweenUnitNormalized
    dsimp only [aLeft, aRight, theta]
    ext Q
    simp [CategoryTheory.Adjunction.leftAdjointUniq,
      CategoryTheory.conjugateEquiv, CategoryTheory.mateEquiv]
  rw [hconj]
  have hi := CategoryTheory.iterated_mateEquiv_conjugateEquiv_symm
    (lowerShriekAdjunction jX) (lowerShriekAdjunction jY)
    (baseChangeSheafAdjunctionOfIsoUnitNormalized e)
    (baseChangeSheafAdjunctionOfIsoUnitNormalized ebar)
    (.mk _ _ _ _ theta.hom)
  exact hi.symm

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem lowerShriekEquivariantIsoBetweenUnitNormalized_comp
    {X Y Z Xbar Ybar Zbar : Scheme.{u}}
    (jX : X ⟶ Xbar) [WeaklyEtale jX]
    (jY : Y ⟶ Ybar) [WeaklyEtale jY]
    (jZ : Z ⟶ Zbar) [WeaklyEtale jZ]
    (e : X ⟶ Y) [IsIso e] (f : Y ⟶ Z) [IsIso f]
    (ebar : Xbar ⟶ Ybar) [IsIso ebar]
    (fbar : Ybar ⟶ Zbar) [IsIso fbar]
    (he : e ≫ jY = jX ≫ ebar) (hf : f ≫ jZ = jY ≫ fbar) :
    lowerShriekEquivariantIsoBetweenUnitNormalized
        jX jZ (e ≫ f) (ebar ≫ fbar)
          (by rw [Category.assoc, hf, ← Category.assoc, he,
            Category.assoc]) =
      lowerShriekEquivariantIsoBetweenIteratedUnitNormalized
        jX jY jZ e f ebar fbar he hf := by
  apply Iso.ext
  apply (Iso.inv_eq_inv _ _).mp
  let ae := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointBetweenUnitNormalized
      jX jY e ebar he)
  let af := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointBetweenUnitNormalized
      jY jZ f fbar hf)
  let ai := (CategoryTheory.TwoSquare.vComp ae af).whiskerRight
      (baseChangeSheafPullbackCompNormalizedMateIsoBetween e f).inv
        |>.whiskerLeft
      (baseChangeSheafPullbackCompNormalizedMateIsoBetween
        ebar fbar).hom
  have hai : ai.natTrans =
      equivariantBaseChangeForwardRightAdjointBetweenIteratedUnitNormalized
        jX jY jZ e f ebar fbar he hf := by
    rfl
  let adjX := lowerShriekAdjunction jX
  let adjY := lowerShriekAdjunction jY
  let adjZ := lowerShriekAdjunction jZ
  let be := (CategoryTheory.mateEquiv adjX adjY).symm ae
  let bf := (CategoryTheory.mateEquiv adjY adjZ).symm af
  let bi := (CategoryTheory.TwoSquare.hComp be bf).whiskerTop
      (baseChangeSheafPullbackCompNormalizedMateIsoBetween e f).inv
        |>.whiskerBottom
      (baseChangeSheafPullbackCompNormalizedMateIsoBetween
        ebar fbar).hom
  let bd := (CategoryTheory.mateEquiv adjX adjZ).symm ai
  have hbe : be.natTrans =
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        jX jY e ebar he).inv := by
    exact (lowerShriekEquivariantIsoBetweenUnitNormalized_inv_eq_mate
      jX jY e ebar he).symm
  have hbf : bf.natTrans =
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        jY jZ f fbar hf).inv := by
    exact (lowerShriekEquivariantIsoBetweenUnitNormalized_inv_eq_mate
      jY jZ f fbar hf).symm
  have hbi : bi.natTrans =
      (lowerShriekEquivariantIsoBetweenIteratedUnitNormalized
        jX jY jZ e f ebar fbar he hf).inv := by
    dsimp only [bi]
    apply NatTrans.ext
    funext Q
    simp only [CategoryTheory.TwoSquare.whiskerBottom_app,
      CategoryTheory.TwoSquare.whiskerTop_app,
      CategoryTheory.TwoSquare.hComp_app]
    rw [congr_app hbf ((baseChangeSheafPushforward e).obj Q),
      congr_app hbe Q]
    rfl
  have hm : (CategoryTheory.mateEquiv adjX adjZ) bi = ai := by
    dsimp only [bi, ai]
    rw [CategoryTheory.mateEquiv_whiskerBottom]
    rw [CategoryTheory.mateEquiv_whiskerTop]
    rw [CategoryTheory.mateEquiv_vcomp]
    dsimp only [be, bf]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  have hbd : bd = bi := by
    apply (CategoryTheory.mateEquiv adjX adjZ).injective
    rw [hm]
    dsimp only [bd]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  calc
    (lowerShriekEquivariantIsoBetweenUnitNormalized
        jX jZ (e ≫ f) (ebar ≫ fbar)
          (by rw [Category.assoc, hf, ← Category.assoc, he,
            Category.assoc])).inv = bd.natTrans := by
      rw [lowerShriekEquivariantIsoBetweenUnitNormalized_inv_eq_mate]
      rw [
        equivariantBaseChangeForwardRightAdjointBetweenUnitNormalized_comp
          jX jY jZ e f ebar fbar he hf]
      have hsq : CategoryTheory.TwoSquare.mk _ _ _ _
          (equivariantBaseChangeForwardRightAdjointBetweenIteratedUnitNormalized
            jX jY jZ e f ebar fbar he hf) = ai := by
        exact hai.symm
      exact congrArg (fun z =>
        ((CategoryTheory.mateEquiv adjX adjZ).symm z).natTrans) hsq
    _ = bi.natTrans := congrArg CategoryTheory.TwoSquare.natTrans hbd
    _ = (lowerShriekEquivariantIsoBetweenIteratedUnitNormalized
        jX jY jZ e f ebar fbar he hf).inv := hbi

/-- Compact-support coefficient transport along an open isomorphism, defined
directly from the normalized four-corner Beck--Chevalley square. -/
noncomputable def
    qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j] (ell : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportSheaf (e.hom ≫ j) ell ≅
      qEllAdicCompactSupportSheaf j ell := by
  let B := lowerShriekEquivariantIsoBetweenUnitNormalized
    (e.hom ≫ j) j e.hom (𝟙 Z) (by simp)
  let C : qEllAdicSheafAbULift Y ell ≅
      (baseChangeSheafPushforward e.hom).obj
        (qEllAdicSheafAbULift X ell) :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
        (baseChangeIsHomeomorph_of_isIso e.hom))
  exact (baseChangeSheafPushforwardId Z).symm.app _ ≪≫
    B.app (qEllAdicSheafAbULift X ell) ≪≫
    (lowerShriek j).mapIso C.symm

theorem
    qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized_hom_scalar
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j] (ell : ℕ) [Fact ell.Prime] (r : ℚ_[ell]) :
    qEllAdicCompactSupportScalar (e.hom ≫ j) ell r ≫
        (qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
          e j ell).hom =
      (qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
          e j ell).hom ≫
        qEllAdicCompactSupportScalar j ell r := by
  let B := lowerShriekEquivariantIsoBetweenUnitNormalized
    (e.hom ≫ j) j e.hom (𝟙 Z) (by simp)
  let C : qEllAdicSheafAbULift Y ell ≅
      (baseChangeSheafPushforward e.hom).obj
        (qEllAdicSheafAbULift X ell) :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
        (baseChangeIsHomeomorph_of_isIso e.hom))
  have hC_hom :
      qEllAdicSheafAbScalarULift Y ell r ≫ C.hom =
        C.hom ≫
          (baseChangeSheafPushforward e.hom).map
            (qEllAdicSheafAbScalarULift X ell r) := by
    change qEllAdicSheafAbScalarULift Y ell r ≫
        qEllAdicCoefficientPullbackULift e.hom ell = _
    exact qEllAdicCoefficientPullbackULift_scalar e.hom ell r
  have hC :
      (baseChangeSheafPushforward e.hom).map
          (qEllAdicSheafAbScalarULift X ell r) ≫ C.inv =
        C.inv ≫ qEllAdicSheafAbScalarULift Y ell r := by
    apply (cancel_epi C.hom).1
    rw [← Category.assoc, ← hC_hom]
    simp
  change (lowerShriek (e.hom ≫ j)).map
      (qEllAdicSheafAbScalarULift X ell r) ≫
        (baseChangeSheafPushforwardId Z).inv.app _ ≫
          B.hom.app (qEllAdicSheafAbULift X ell) ≫
            (lowerShriek j).map C.inv =
      (baseChangeSheafPushforwardId Z).inv.app _ ≫
        B.hom.app (qEllAdicSheafAbULift X ell) ≫
          (lowerShriek j).map C.inv ≫
            (lowerShriek j).map (qEllAdicSheafAbScalarULift Y ell r)
  have hId := (baseChangeSheafPushforwardId Z).inv.naturality
    ((lowerShriek (e.hom ≫ j)).map
      (qEllAdicSheafAbScalarULift X ell r))
  simp only [Functor.id_map] at hId
  rw [← Category.assoc, hId]
  have hB := B.hom.naturality
    (qEllAdicSheafAbScalarULift X ell r)
  simp only [Functor.comp_map] at hB
  simp only [Functor.id_obj, Functor.comp_obj, Category.assoc]
  slice_lhs 2 3 => exact hB
  have hmap :
      (lowerShriek j).map
          ((baseChangeSheafPushforward e.hom).map
            (qEllAdicSheafAbScalarULift X ell r)) ≫
        (lowerShriek j).map C.inv =
      (lowerShriek j).map C.inv ≫
        (lowerShriek j).map (qEllAdicSheafAbScalarULift Y ell r) := by
    rw [← (lowerShriek j).map_comp, hC, (lowerShriek j).map_comp]
  slice_lhs 3 4 => exact hmap

/-- The four-corner normalized transport is linear on compact-support
cohomology. -/
noncomputable def
    qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized
    {S X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    (p : Z ⟶ S) [IsOpenImmersion j] [IsProper p]
    (ell degree : ℕ) [Fact ell.Prime] :
    CompactlySupportedQEllAdicCohomology (e.hom ≫ j) p ell degree ≃ₗ[ℚ_[ell]]
      CompactlySupportedQEllAdicCohomology j p ell degree := by
  let E := qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
    e j ell
  exact
    { toFun := Sheaf.H.map E.hom degree
      invFun := Sheaf.H.map E.inv degree
      left_inv := by
        intro x
        dsimp only [CompactlySupportedQEllAdicCohomology] at x ⊢
        rw [← Sheaf.H.map_comp_apply]
        simp [E]
      right_inv := by
        intro x
        dsimp only [CompactlySupportedQEllAdicCohomology] at x ⊢
        rw [← Sheaf.H.map_comp_apply]
        simp [E]
      map_add' := (Sheaf.H.map E.hom degree).map_add
      map_smul' := by
        intro r x
        change (qEllAdicCompactSupportSheaf (e.hom ≫ j) ell).H degree at x
        change Sheaf.H.map E.hom degree
              (Sheaf.H.map
                (qEllAdicCompactSupportScalar (e.hom ≫ j) ell r)
                degree x) =
            Sheaf.H.map (qEllAdicCompactSupportScalar j ell r) degree
              (Sheaf.H.map E.hom degree x)
        rw [← Sheaf.H.map_comp_apply,
          qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized_hom_scalar,
          Sheaf.H.map_comp_apply] }

theorem baseChangeSheafAdjunctionOfIsoCounitNormalized_counit_app_hom_app
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f]
    (Q : Sheaf (topology X) Ab) (U : X.ProEtᵒᵖ) :
    ((baseChangeSheafAdjunctionOfIsoCounitNormalized f).unit.app Q).hom.app U =
      Q.obj.map (((baseChangeCounitIsoForNormalized f).hom.app U.unop).op) := by
  rfl

theorem baseChangeUnitSection_comp
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g]
    (U : X.ProEt) :
    baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫
        ((baseChangeComp f g).inv.app U).left =
      baseChangeUnitSection (f ≫ g) U := by
  apply Limits.pullback.hom_ext
  · change baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫
        ((baseChangeComp f g).inv.app U).left ≫
        pullback.fst U.hom (f ≫ g) =
      baseChangeUnitSection (f ≫ g) U ≫
        pullback.fst U.hom (f ≫ g)
    have hcomp : ((baseChangeComp f g).inv.app U).left ≫
          pullback.fst U.hom (f ≫ g) =
        pullback.fst (pullback.snd U.hom g) f ≫
          pullback.fst U.hom g := by
      have he : baseChangeCompOfEq f g (f ≫ g) rfl =
          baseChangeComp f g := by rfl
      rw [← he]
      exact baseChangeCompOfEq_inv_app_left_fst f g (f ≫ g) rfl U
    refine (congrArg (fun z =>
      baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫ z) hcomp).trans ?_
    have hf := baseChangeUnitSection_fst f ((baseChange g).obj U)
    change baseChangeUnitSection f ((baseChange g).obj U) ≫
      pullback.fst (pullback.snd U.hom g) f = 𝟙 _ at hf
    have hg := baseChangeUnitSection_fst g U
    have hfg := baseChangeUnitSection_fst (f ≫ g) U
    have htail : baseChangeUnitSection f ((baseChange g).obj U) ≫
        pullback.fst (pullback.snd U.hom g) f ≫
        pullback.fst U.hom g = pullback.fst U.hom g := by
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (fun z => z ≫ pullback.fst U.hom g) hf).trans
          (Category.id_comp _))
    exact ((congrArg (fun z => baseChangeUnitSection g U ≫ z) htail).trans hg).trans
      hfg.symm
  · change baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫
        ((baseChangeComp f g).inv.app U).left ≫
        pullback.snd U.hom (f ≫ g) =
      baseChangeUnitSection (f ≫ g) U ≫
        pullback.snd U.hom (f ≫ g)
    have hcomp : ((baseChangeComp f g).inv.app U).left ≫
          pullback.snd U.hom (f ≫ g) =
        pullback.snd (pullback.snd U.hom g) f := by
      have he : baseChangeCompOfEq f g (f ≫ g) rfl =
          baseChangeComp f g := by rfl
      rw [← he]
      exact baseChangeCompOfEq_inv_app_left_snd f g (f ≫ g) rfl U
    refine (congrArg (fun z =>
      baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫ z) hcomp).trans ?_
    have hf := baseChangeUnitSection_snd f ((baseChange g).obj U)
    change baseChangeUnitSection f ((baseChange g).obj U) ≫
      pullback.snd (pullback.snd U.hom g) f =
        pullback.snd U.hom g ≫ inv f at hf
    have hg := baseChangeUnitSection_snd g U
    have hfg := baseChangeUnitSection_snd (f ≫ g) U
    calc
      baseChangeUnitSection g U ≫
          baseChangeUnitSection f ((baseChange g).obj U) ≫
          pullback.snd (pullback.snd U.hom g) f =
        baseChangeUnitSection g U ≫
          (pullback.snd U.hom g ≫ inv f) :=
            congrArg (fun z => baseChangeUnitSection g U ≫ z) hf
      _ = (baseChangeUnitSection g U ≫ pullback.snd U.hom g) ≫ inv f :=
        (Category.assoc _ _ _).symm
      _ = (U.hom ≫ inv g) ≫ inv f := congrArg (fun z => z ≫ inv f) hg
      _ = U.hom ≫ inv (f ≫ g) := by rw [IsIso.inv_comp, Category.assoc]
      _ = baseChangeUnitSection (f ≫ g) U ≫
          pullback.snd U.hom (f ≫ g) := hfg.symm

theorem baseChangeUnitSection_comp_between
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
    [IsIso f] [IsIso g] (U : Z.ProEt) :
    baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫
        ((baseChangeComp f g).inv.app U).left =
      baseChangeUnitSection (f ≫ g) U := by
  apply Limits.pullback.hom_ext
  · change baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫
        ((baseChangeComp f g).inv.app U).left ≫
        pullback.fst U.hom (f ≫ g) =
      baseChangeUnitSection (f ≫ g) U ≫
        pullback.fst U.hom (f ≫ g)
    have hcomp : ((baseChangeComp f g).inv.app U).left ≫
          pullback.fst U.hom (f ≫ g) =
        pullback.fst (pullback.snd U.hom g) f ≫
          pullback.fst U.hom g := by
      have he : baseChangeCompOfEq f g (f ≫ g) rfl =
          baseChangeComp f g := by rfl
      rw [← he]
      exact baseChangeCompOfEq_inv_app_left_fst f g (f ≫ g) rfl U
    refine (congrArg (fun z =>
      baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫ z) hcomp).trans ?_
    have hf := baseChangeUnitSection_fst f ((baseChange g).obj U)
    change baseChangeUnitSection f ((baseChange g).obj U) ≫
      pullback.fst (pullback.snd U.hom g) f = 𝟙 _ at hf
    have hg := baseChangeUnitSection_fst g U
    have hfg := baseChangeUnitSection_fst (f ≫ g) U
    have htail : baseChangeUnitSection f ((baseChange g).obj U) ≫
        pullback.fst (pullback.snd U.hom g) f ≫
        pullback.fst U.hom g = pullback.fst U.hom g := by
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (fun z => z ≫ pullback.fst U.hom g) hf).trans
          (Category.id_comp _))
    exact ((congrArg (fun z => baseChangeUnitSection g U ≫ z) htail).trans hg).trans
      hfg.symm
  · change baseChangeUnitSection g U ≫
        baseChangeUnitSection f ((baseChange g).obj U) ≫
        ((baseChangeComp f g).inv.app U).left ≫
        pullback.snd U.hom (f ≫ g) =
      baseChangeUnitSection (f ≫ g) U ≫
        pullback.snd U.hom (f ≫ g)
    have hcomp : ((baseChangeComp f g).inv.app U).left ≫
          pullback.snd U.hom (f ≫ g) =
        pullback.snd (pullback.snd U.hom g) f := by
      have he : baseChangeCompOfEq f g (f ≫ g) rfl =
          baseChangeComp f g := by rfl
      rw [← he]
