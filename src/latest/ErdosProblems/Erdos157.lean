/-! ### Complex realization of the actual compact-support Frobenius action -/

namespace AlgebraicGeometry.Scheme.ProEt

universe u

/-- Matrix of a finite-dimensional compact-support endomorphism after a
chosen characteristic-zero realization. -/
noncomputable def compactlySupportedQEllAdicCohomologyRealizationMatrix
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime]
    [FiniteDimensional ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ degree)]
    (σ : ℚ_[ℓ] →+* ℂ)
    (f : qEllAdicCompactSupportSheaf j ℓ ⟶
      qEllAdicCompactSupportSheaf j ℓ)
    (hf : ∀ r : ℚ_[ℓ],
      qEllAdicCompactSupportScalar j ℓ r ≫ f =
        f ≫ qEllAdicCompactSupportScalar j ℓ r) :
    Matrix
      (Fin (Module.finrank ℚ_[ℓ]
        (CompactlySupportedQEllAdicCohomology j pbar ℓ degree)))
      (Fin (Module.finrank ℚ_[ℓ]
        (CompactlySupportedQEllAdicCohomology j pbar ℓ degree))) ℂ :=
  (LinearMap.toMatrix
    (Module.finBasis ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ degree))
    (Module.finBasis ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ degree))
    (compactlySupportedQEllAdicCohomologyLinearMap
      j pbar ℓ degree f hf)).map σ

/-- Realization commutes with the basis-independent cohomological trace. -/
theorem compactlySupportedQEllAdicCohomologyRealizationMatrix_trace
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (ℓ degree : ℕ) [Fact ℓ.Prime]
    [FiniteDimensional ℚ_[ℓ]
      (CompactlySupportedQEllAdicCohomology j pbar ℓ degree)]
    (σ : ℚ_[ℓ] →+* ℂ)
    (f : qEllAdicCompactSupportSheaf j ℓ ⟶
      qEllAdicCompactSupportSheaf j ℓ)
    (hf : ∀ r : ℚ_[ℓ],
      qEllAdicCompactSupportScalar j ℓ r ≫ f =
        f ≫ qEllAdicCompactSupportScalar j ℓ r) :
    (compactlySupportedQEllAdicCohomologyRealizationMatrix
      j pbar ℓ degree σ f hf).trace =
      σ (compactlySupportedQEllAdicCohomologyTrace
        j pbar ℓ degree f hf) := by
  rw [compactlySupportedQEllAdicCohomologyTrace,
    LinearMap.trace_eq_matrix_trace ℚ_[ℓ]
      (Module.finBasis ℚ_[ℓ]
        (CompactlySupportedQEllAdicCohomology j pbar ℓ degree))]
  exact (AddMonoidHom.map_trace σ _).symm

end AlgebraicGeometry.Scheme.ProEt

namespace Erdos157
namespace SawinGeometry

open AlgebraicGeometry
open AlgebraicGeometry.Scheme

/-- Complex realization matrix of Frobenius on one cohomological degree of
the literal full residue-unit fiber. -/
noncomputable def fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree)]
    (σ : ℚ_[ℓ] →+* ℂ) :
    Matrix
      (Fin (Module.finrank ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ degree)))
      (Fin (Module.finrank ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ degree))) ℂ :=
  AlgebraicGeometry.Scheme.ProEt.compactlySupportedQEllAdicCohomologyRealizationMatrix
    j pbar ℓ degree σ
    (qEllAdicCompactSupportFrobeniusEndomorphism j q
      (fullResidueUnitFiberProjection
        (ZMod q) n m g hg hdeg hm hmn t) ℓ)
    (qEllAdicCompactSupportFrobeniusEndomorphism_scalar j q
      (fullResidueUnitFiberProjection
        (ZMod q) n m g hg hdeg hm hmn t) ℓ)

theorem fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix_trace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree)]
    (σ : ℚ_[ℓ] →+* ℂ) :
    (fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix
      q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar σ).trace =
      σ (fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar) := by
  exact AlgebraicGeometry.Scheme.ProEt.compactlySupportedQEllAdicCohomologyRealizationMatrix_trace
    j pbar ℓ degree σ _ _

/-- Once Grothendieck--Lefschetz, the two weight bounds, and the two-degree
concentration statement have been supplied, the actual `Q_ℓ` cohomology of
the full fiber gives exactly the matrix certificate used by the analytic
part of the proof. -/
noncomputable def fullResidueUnitFiberTwoDegreeFrobeniusMatrices
    (q n m ℓ lower upper : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ lower)]
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ upper)]
    (σ : ℚ_[ℓ] →+* ℂ) (error : ℂ) (radius : ℝ)
    (htrace : error =
      σ (fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ lower g hg hdeg hm hmn t Xbar S j pbar) -
      σ (fullResidueUnitFiberQEllAdicCompactSupportFrobeniusTrace
        q n m ℓ upper g hg hdeg hm hmn t Xbar S j pbar))
    (hlower : ∀ z, z ∈
      (fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix
        q n m ℓ lower g hg hdeg hm hmn t Xbar S j pbar σ).charpoly.roots →
        ‖z‖ ≤ radius)
    (hupper : ∀ z, z ∈
      (fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix
        q n m ℓ upper g hg hdeg hm hmn t Xbar S j pbar σ).charpoly.roots →
        ‖z‖ ≤ radius) :
    SawinSpecialization.TwoDegreeFrobeniusMatrices error
      (Module.finrank ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ lower))
      (Module.finrank ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          j pbar ℓ upper)) radius radius where
  lowerFrobenius :=
    fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix
      q n m ℓ lower g hg hdeg hm hmn t Xbar S j pbar σ
  upperFrobenius :=
    -fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix
      q n m ℓ upper g hg hdeg hm hmn t Xbar S j pbar σ
  error_eq_trace := by
    rw [Matrix.trace_neg,
      fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix_trace,
      fullResidueUnitFiberQEllAdicFrobeniusRealizationMatrix_trace]
    exact htrace
  lower_root_norm_le := hlower
  upper_root_norm_le :=
    SawinSpecialization.matrix_neg_root_norm_le _ radius hupper

open CategoryTheory Limits AlgebraicGeometry
open AlgebraicGeometry.Scheme
open scoped AlgebraicGeometry

universe u

variable (K : Type u) [Field K]

/-- Coordinate permutation of ordered affine root space. -/
noncomputable def affineRootPermutation (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    AffineRootSpace K n ⟶ AffineRootSpace K n :=
  AffineSpace.homOfVector (AffineRootSpace K n ↘ Spec (.of K))
    (fun j => AffineSpace.coord (Spec (.of K))
      (ULift.up (σ j.down)))

@[simp]
theorem affineRootPermutation_appTop_coord
    (n : ℕ) (σ : Equiv.Perm (Fin n)) (i : Fin n) :
    (affineRootPermutation K n σ).appTop
        (AffineSpace.coord (Spec (.of K)) (ULift.up i)) =
      AffineSpace.coord (Spec (.of K)) (ULift.up (σ i)) := by
  exact AffineSpace.homOfVector_appTop_coord _ _ _

@[reassoc (attr := simp)]
theorem affineRootPermutation_over
    (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    affineRootPermutation K n σ ≫
        (AffineRootSpace K n ↘ Spec (.of K)) =
      (AffineRootSpace K n ↘ Spec (.of K)) := by
  exact AffineSpace.homOfVector_over _ _

theorem affineRootPermutation_comp
    (n : ℕ) (σ τ : Equiv.Perm (Fin n)) :
    affineRootPermutation K n σ ≫ affineRootPermutation K n τ =
      affineRootPermutation K n (σ * τ) := by
  apply AffineSpace.hom_ext
  · simp
  · intro i
    rcases i with ⟨i⟩
    rw [Scheme.Hom.comp_appTop]
    simp only [CommRingCat.comp_apply]
    rw [affineRootPermutation_appTop_coord,
      affineRootPermutation_appTop_coord,
      affineRootPermutation_appTop_coord]
    rfl

theorem affineRootPermutation_symm_comp
    (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    affineRootPermutation K n σ.symm ≫ affineRootPermutation K n σ =
      𝟙 _ := by
  rw [affineRootPermutation_comp]
  apply AffineSpace.hom_ext
  · simp
  · intro i
    simp [affineRootPermutation]

theorem affineRootPermutation_comp_symm
    (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    affineRootPermutation K n σ ≫ affineRootPermutation K n σ.symm =
      𝟙 _ := by
  rw [affineRootPermutation_comp]
  apply AffineSpace.hom_ext
  · simp
  · intro i
    simp [affineRootPermutation]

theorem affineRootPermutation_appTop_rootEvaluationSection
    (n : ℕ) (g : Polynomial K) (σ : Equiv.Perm (Fin n)) (i : Fin n) :
    (affineRootPermutation K n σ).appTop
        (rootEvaluationSection K n g i) =
      rootEvaluationSection K n g (σ i) := by
  unfold rootEvaluationSection
  have hcoeff : (affineRootPermutation K n σ).appTop.hom.comp
      (rootCoefficientMap K n) = rootCoefficientMap K n := by
    ext a
    unfold rootCoefficientMap
    change (affineRootPermutation K n σ).appTop
      ((AffineRootSpace K n ↘ Spec (.of K)).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
    change (((AffineRootSpace K n ↘ Spec (.of K)).appTop ≫
      (affineRootPermutation K n σ).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
    have h := congrArg Scheme.Hom.appTop
      (affineRootPermutation_over K n σ)
    rw [Scheme.Hom.comp_appTop] at h
    rw [h]
    rfl
  rw [map_eval₂, hcoeff, affineRootPermutation_appTop_coord]

theorem affineRootPermutation_appTop_rootAvoidanceSection
    (n : ℕ) (g : Polynomial K) (σ : Equiv.Perm (Fin n)) :
    (affineRootPermutation K n σ).appTop
        (rootAvoidanceSection K n g) =
      rootAvoidanceSection K n g := by
  unfold rootAvoidanceSection
  rw [map_prod]
  simp_rw [affineRootPermutation_appTop_rootEvaluationSection]
  exact Equiv.prod_comp σ (fun i => rootEvaluationSection K n g i)

theorem affineRootPermutation_preimage_rootSpaceOpen
    (n : ℕ) (g : Polynomial K) (σ : Equiv.Perm (Fin n)) :
    affineRootPermutation K n σ ⁻¹ᵁ RootSpaceOpen K n g =
      RootSpaceOpen K n g := by
  unfold RootSpaceOpen
  rw [Scheme.preimage_basicOpen_top,
    affineRootPermutation_appTop_rootAvoidanceSection]

/-- Coordinate permutation restricted to the root-avoidance open. -/
noncomputable def rootPermutation
    (n : ℕ) (g : Polynomial K) (σ : Equiv.Perm (Fin n)) :
    RootSpace K n g ⟶ RootSpace K n g :=
  (Scheme.isoOfEq (AffineRootSpace K n)
      (affineRootPermutation_preimage_rootSpaceOpen K n g σ).symm).hom ≫
    affineRootPermutation K n σ ∣_ RootSpaceOpen K n g

@[reassoc]
theorem rootPermutation_ι
    (n : ℕ) (g : Polynomial K) (σ : Equiv.Perm (Fin n)) :
    rootPermutation K n g σ ≫ (RootSpaceOpen K n g).ι =
      (RootSpaceOpen K n g).ι ≫ affineRootPermutation K n σ := by
  unfold rootPermutation
  rw [Category.assoc, morphismRestrict_ι, ← Category.assoc,
    Scheme.isoOfEq_hom_ι]

theorem affineRootPermutation_universalRootPolynomial
    (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    (universalRootPolynomial K n).map
        (affineRootPermutation K n σ).appTop.hom =
      universalRootPolynomial K n := by
  unfold universalRootPolynomial
  rw [Polynomial.map_prod]
  simp_rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
    affineRootPermutation_appTop_coord]
  exact Equiv.prod_comp σ
    (fun i => Polynomial.X - Polynomial.C
      (AffineSpace.coord (Spec (.of K)) (ULift.up i)))

theorem affineRootPermutation_universalRootRemainder
    (n : ℕ) (g : Polynomial K) (hg : g.Monic)
    (σ : Equiv.Perm (Fin n)) :
    (universalRootRemainder K n g hg).map
        (affineRootPermutation K n σ).appTop.hom =
      universalRootRemainder K n g hg := by
  let A := Γ(AffineRootSpace K n, ⊤)
  let φ := (affineRootPermutation K n σ).appTop.hom
  let G := g.map (rootCoefficientMap K n)
  let P := universalRootPolynomial K n
  have hG : G.map φ = G := by
    dsimp only [G]
    rw [Polynomial.map_map]
    congr 1
    ext a
    unfold rootCoefficientMap
    change (affineRootPermutation K n σ).appTop
      ((AffineRootSpace K n ↘ Spec (.of K)).appTop
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
    change (((AffineRootSpace K n ↘ Spec (.of K)).appTop ≫
      (affineRootPermutation K n σ).appTop)
        ((Scheme.ΓSpecIso (.of K)).inv a)) = _
    have h := congrArg Scheme.Hom.appTop
      (affineRootPermutation_over K n σ)
    rw [Scheme.Hom.comp_appTop] at h
    rw [h]
    rfl
  have hP : P.map φ = P :=
    affineRootPermutation_universalRootPolynomial K n σ
  unfold universalRootRemainder
  change (P %ₘ G).map φ = P %ₘ G
  rw [Polynomial.map_modByMonic φ (hg.map _), hG, hP]

theorem affineRootPermutation_affineResidueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (σ : Equiv.Perm (Fin n)) :
    affineRootPermutation K n σ ≫
        affineResidueMultiplication K n m g hg =
      affineResidueMultiplication K n m g hg := by
  apply AffineSpace.hom_ext
  · simp
  · intro i
    change (affineRootPermutation K n σ).appTop
        ((affineResidueMultiplication K n m g hg).appTop
          (AffineSpace.coord (Spec (.of K)) i)) =
      (affineResidueMultiplication K n m g hg).appTop
        (AffineSpace.coord (Spec (.of K)) i)
    rw [affineResidueMultiplication_appTop_coord]
    have h := congrArg (fun p => p.coeff i.down)
      (affineRootPermutation_universalRootRemainder K n g hg σ)
    simpa only [Polynomial.coeff_map] using h

theorem rootPermutation_residueMultiplication
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (σ : Equiv.Perm (Fin n)) :
    rootPermutation K n g σ ≫ residueMultiplication K n m g hg =
      residueMultiplication K n m g hg := by
  unfold residueMultiplication
  rw [← Category.assoc, rootPermutation_ι, Category.assoc,
    affineRootPermutation_affineResidueMultiplication]

theorem rootPermutation_fullResidueMultiplicationToUnit
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (σ : Equiv.Perm (Fin n)) :
    rootPermutation K n g σ ≫
        fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn =
      fullResidueMultiplicationToUnit K n m g hg hdeg hm hmn := by
  let : IsOpenImmersion (residueUnitImmersion K m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion K m g)).1
  simpa only [Category.assoc, fullResidueMultiplicationToUnit_fac] using
    rootPermutation_residueMultiplication K n m g hg σ

/-- Coordinate permutation on the full residue-unit fiber. -/
noncomputable def fullResidueUnitFiberPermutation
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ : Equiv.Perm (Fin n)) :
    FullResidueUnitFiber K n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiber K n m g hg hdeg hm hmn t :=
  pullback.lift
    (fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
      rootPermutation K n g σ)
    (fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t)
    (by
      rw [Category.assoc,
        rootPermutation_fullResidueMultiplicationToUnit]
      exact fullResidueUnitFiber_condition K n m g hg hdeg hm hmn t)

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberPermutation_toRootSpace
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ ≫
        fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t =
      fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
        rootPermutation K n g σ := by
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberPermutation_over
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ ≫
        fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t =
      fullResidueUnitFiberProjection K n m g hg hdeg hm hmn t := by
  exact pullback.lift_snd _ _ _

/-- Frobenius followed on coordinates by a prescribed label permutation. -/
noncomputable def fullResidueUnitFiberTwistedFrobenius
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t :=
  fullResidueUnitFiberPermutation
      (ZMod q) n m g hg hdeg hm hmn t σ ≫
    fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberTwistedFrobenius_toRootSpace_ι
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ ≫
        fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫
        (RootSpaceOpen (ZMod q) n g).ι =
      fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫
        (RootSpaceOpen (ZMod q) n g).ι ≫
        affineRootPermutation (ZMod q) n σ ≫
        affineRootFrobenius q n := by
  unfold fullResidueUnitFiberTwistedFrobenius
  simp only [Category.assoc]
  rw [fullResidueUnitFiberFrobenius_toRootSpace_assoc,
    fullResidueUnitFiberPermutation_toRootSpace_assoc,
    rootFrobenius_ι, rootPermutation_ι_assoc]

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberTwistedFrobenius_over
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ ≫
        fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t =
      fullResidueUnitFiberProjection
          (ZMod q) n m g hg hdeg hm hmn t := by
  unfold fullResidueUnitFiberTwistedFrobenius
  simp

/-- Ordered affine coordinates of a geometric point. -/
noncomputable def affineRootPointCoordinates
    (n : ℕ) {F : Type u} [Field F]
    (x : Spec (.of F) ⟶ AffineRootSpace K n) : Fin n → F :=
  fun i => (Scheme.ΓSpecIso (.of F)).hom
    (x.appTop (AffineSpace.coord (Spec (.of K)) (ULift.up i)))

theorem affineRootPointCoordinates_comp_permutation
    (n : ℕ) {F : Type u} [Field F]
    (x : Spec (.of F) ⟶ AffineRootSpace K n)
    (σ : Equiv.Perm (Fin n)) (i : Fin n) :
    affineRootPointCoordinates K n (x ≫ affineRootPermutation K n σ) i =
      affineRootPointCoordinates K n x (σ i) := by
  unfold affineRootPointCoordinates
  rw [Scheme.Hom.comp_appTop]
  change (Scheme.ΓSpecIso (.of F)).hom
    (x.appTop ((affineRootPermutation K n σ).appTop
      (AffineSpace.coord (Spec (.of K)) (ULift.up i)))) = _
  rw [affineRootPermutation_appTop_coord]

theorem affineRootPointCoordinates_comp_frobenius
    (q n : ℕ) [Fact q.Prime]
    {F : Type} [Field F] [CharP F q]
    (x : Spec (.of F) ⟶ AffineRootSpace (ZMod q) n)
    (i : Fin n) :
    affineRootPointCoordinates (ZMod q) n
        (x ≫ affineRootFrobenius q n) i =
      (affineRootPointCoordinates (ZMod q) n x i) ^ q := by
  unfold affineRootPointCoordinates
  rw [Scheme.Hom.comp_appTop]
  change (Scheme.ΓSpecIso (.of F)).hom
    (x.appTop ((affineRootFrobenius q n).appTop
      (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up i)))) = _
  rw [affineRootFrobenius_coord, map_pow, map_pow]

/-! ### Twisted Frobenius on ordered roots

Sawin's trace-function identity uses Frobenius composed with a permutation of
the ordered roots.  The following coefficientwise calculation is the
arithmetic core: a twisted fixed tuple has a root polynomial defined over the
prime field. -/

open Polynomial

/-- The prime field is exactly the fixed field of arithmetic Frobenius inside
any characteristic-`q` field. -/
noncomputable def zmodEquivFrobeniusFixed
    (q : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] :
    ZMod q ≃ {x : F // x ^ q = x} := by
  let ι : ZMod q →+* F := ZMod.castHom (m := q) dvd_rfl F
  have hrange : ι.fieldRange = (⊥ : Subfield F) :=
    ZMod.fieldRange_castHom_eq_bot q
  let e : ZMod q ≃+* ι.fieldRange := ι.rangeRestrictFieldEquiv
  refine
    { toFun := fun z => ⟨ι z, by rw [← map_pow, ZMod.pow_card]⟩
      invFun := fun x => e.symm ⟨x.1, by
        rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
        exact x.2⟩
      left_inv := ?_
      right_inv := ?_ }
  · intro z
    apply e.injective
    rw [e.apply_symm_apply]
    rfl
  · intro x
    apply Subtype.ext
    change ι (e.symm ⟨x.1, _⟩) = x.1
    exact congrArg Subtype.val (e.apply_symm_apply ⟨x.1, by
      rw [hrange, Subfield.mem_bot_iff_pow_eq_self F q]
      exact x.2⟩)

@[simp]
theorem zmodEquivFrobeniusFixed_apply
    (q : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] (z : ZMod q) :
    (zmodEquivFrobeniusFixed q F z).1 =
      ZMod.castHom (m := q) dvd_rfl F z := by
  rfl

theorem zmodEquivFrobeniusFixed_apply_symm
    (q : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q]
    (x : {x : F // x ^ q = x}) :
    ZMod.castHom (m := q) dvd_rfl F
        ((zmodEquivFrobeniusFixed q F).symm x) = x.1 := by
  have h := congrArg Subtype.val
    ((zmodEquivFrobeniusFixed q F).apply_symm_apply x)
  exact h

/-- Coordinatewise arithmetic Frobenius, twisted by a permutation of the
ordered roots. -/
noncomputable def twistedTupleFrobenius
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) : Equiv.Perm (Fin n → F) where
  toFun x i := frobeniusEquiv F q (x (σ i))
  invFun x i := (frobeniusEquiv F q).symm (x (σ.symm i))
  left_inv x := by
    funext i
    simp
  right_inv x := by
    funext i
    simp

@[simp]
theorem twistedTupleFrobenius_apply
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) (x : Fin n → F) (i : Fin n) :
    twistedTupleFrobenius q n F σ x i = (x (σ i)) ^ q :=
  rfl

theorem twistedTupleFrobenius_fixed_iff
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) (x : Fin n → F) :
    twistedTupleFrobenius q n F σ x = x ↔
      ∀ i, (x (σ i)) ^ q = x i := by
  constructor
  · intro h i
    exact congrFun h i
  · intro h
    funext i
    exact h i

/-- Ordered root coordinates of a geometric point of a full unit fiber. -/
noncomputable def fullResidueUnitFiberRootCoordinates
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) :
    Fin n → F :=
  affineRootPointCoordinates (ZMod q) n
    (x ≫ fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t ≫
      (RootSpaceOpen (ZMod q) n g).ι)

theorem fullResidueUnitFiberRootCoordinates_comp_twistedFrobenius
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t) :
    fullResidueUnitFiberRootCoordinates q n m F g hg hdeg hm hmn t
        (x ≫ fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ) =
      twistedTupleFrobenius q n F σ
        (fullResidueUnitFiberRootCoordinates
          q n m F g hg hdeg hm hmn t x) := by
  funext i
  unfold fullResidueUnitFiberRootCoordinates
  have hmor :
      (x ≫ fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ) ≫
          fullResidueUnitFiberToRootSpace
            (ZMod q) n m g hg hdeg hm hmn t ≫
          (RootSpaceOpen (ZMod q) n g).ι =
        (x ≫ fullResidueUnitFiberToRootSpace
            (ZMod q) n m g hg hdeg hm hmn t ≫
          (RootSpaceOpen (ZMod q) n g).ι) ≫
          affineRootPermutation (ZMod q) n σ ≫
          affineRootFrobenius q n := by
    simp only [Category.assoc]
    rw [fullResidueUnitFiberTwistedFrobenius_toRootSpace_ι]
  rw [hmor]
  rw [← Category.assoc]
  rw [affineRootPointCoordinates_comp_frobenius,
    affineRootPointCoordinates_comp_permutation]
  rfl

/-- A twisted-Frobenius fixed geometric point yields the literal fixed
ordered-root tuple used in the cycle classification. -/
noncomputable def fullResidueUnitFiberFixedPointToFixedRootTuple
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x}) :
    {y : Fin n → F // twistedTupleFrobenius q n F σ y = y} := by
  refine ⟨fullResidueUnitFiberRootCoordinates
    q n m F g hg hdeg hm hmn t x.1, ?_⟩
  rw [← fullResidueUnitFiberRootCoordinates_comp_twistedFrobenius]
  rw [x.2]

theorem specToZMod_hom_ext
    (q : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (f h : Spec (.of F) ⟶ Spec (.of (ZMod q))) : f = h := by
  rw [← Spec.map_preimage f, ← Spec.map_preimage h]
  congr 1
  apply CommRingCat.hom_ext
  exact RingHom.ext_zmod _ _

theorem fullResidueUnitFiberRootCoordinates_injective
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Function.Injective (fullResidueUnitFiberRootCoordinates
      q n m F g hg hdeg hm hmn t) := by
  intro x y hxy
  apply pullback.hom_ext
  · apply (cancel_mono (RootSpaceOpen (ZMod q) n g).ι).1
    apply AffineSpace.hom_ext
    · exact specToZMod_hom_ext q F _ _
    · intro i
      rcases i with ⟨i⟩
      apply (Scheme.ΓSpecIso (.of F)).commRingCatIsoToRingEquiv.injective
      exact congrFun hxy i
  · exact specToZMod_hom_ext q F _ _

theorem fullResidueUnitFiberFixedPointToFixedRootTuple_injective
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    Function.Injective (fullResidueUnitFiberFixedPointToFixedRootTuple
      q n m F g hg hdeg hm hmn t σ) := by
  intro x y hxy
  apply Subtype.ext
  apply fullResidueUnitFiberRootCoordinates_injective q n m F
    g hg hdeg hm hmn t
  exact congrArg Subtype.val hxy

/-- Exact equivalence with the coordinate tuples realized by fixed geometric
points of the residue fiber. -/
noncomputable def fullResidueUnitFiberFixedPointEquivRootTupleRange
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} ≃
      Set.range (fullResidueUnitFiberFixedPointToFixedRootTuple
        q n m F g hg hdeg hm hmn t σ) :=
  Equiv.ofInjective _
    (fullResidueUnitFiberFixedPointToFixedRootTuple_injective
      q n m F g hg hdeg hm hmn t σ)

theorem fullResidueUnitFiber_fixedPoint_natCard_eq_rootTupleRange
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    Nat.card {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} =
      Nat.card (Set.range (fullResidueUnitFiberFixedPointToFixedRootTuple
        q n m F g hg hdeg hm hmn t σ)) :=
  Nat.card_congr (fullResidueUnitFiberFixedPointEquivRootTupleRange
    q n m F g hg hdeg hm hmn t σ)

/-- The affine-space point with a prescribed ordered tuple of coordinates. -/
noncomputable def rootTupleAffinePoint
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] (y : Fin n → F) :
    Spec (.of F) ⟶ AffineRootSpace (ZMod q) n :=
  AffineSpace.homOfVector
    (Spec.map (CommRingCat.ofHom
      (ZMod.castHom (m := q) dvd_rfl F)))
    (fun i => (Scheme.ΓSpecIso (.of F)).inv (y i.down))

@[simp]
theorem rootTupleAffinePoint_coordinates
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] (y : Fin n → F) :
    affineRootPointCoordinates (ZMod q) n
      (rootTupleAffinePoint q n F y) = y := by
  funext i
  unfold affineRootPointCoordinates rootTupleAffinePoint
  rw [AffineSpace.homOfVector_appTop_coord]
  exact (Scheme.ΓSpecIso (.of F)).inv_hom_id_apply (y i)

theorem rootTupleAffinePoint_rootCoefficient
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] (y : Fin n → F) (a : ZMod q) :
    (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          (rootCoefficientMap (ZMod q) n a)) =
      ZMod.castHom (m := q) dvd_rfl F a := by
  unfold rootCoefficientMap
  change (Scheme.ΓSpecIso (.of F)).hom
    ((rootTupleAffinePoint q n F y).appTop
      ((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))).appTop
        ((Scheme.ΓSpecIso (.of (ZMod q))).inv a))) = _
  change (Scheme.ΓSpecIso (.of F)).hom
    ((((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))).appTop ≫
      (rootTupleAffinePoint q n F y).appTop)
        ((Scheme.ΓSpecIso (.of (ZMod q))).inv a))) = _
  have h := congrArg Scheme.Hom.appTop
    (AffineSpace.homOfVector_over
      (Spec.map (CommRingCat.ofHom
        (ZMod.castHom (m := q) dvd_rfl F)))
      (fun i : RootIndex n => (Scheme.ΓSpecIso (.of F)).inv (y i.down)))
  rw [Scheme.Hom.comp_appTop] at h
  unfold rootTupleAffinePoint
  rw [h]
  change ((Spec.map (CommRingCat.ofHom
      (ZMod.castHom (m := q) dvd_rfl F))).appTop ≫
      (Scheme.ΓSpecIso (.of F)).hom)
        ((Scheme.ΓSpecIso (.of (ZMod q))).inv a) = _
  rw [Scheme.ΓSpecIso_naturality]
  simp

theorem rootTupleAffinePoint_rootEvaluation
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q)) (i : Fin n) :
    (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          (rootEvaluationSection (ZMod q) n g i)) =
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g := by
  unfold rootEvaluationSection
  rw [map_eval₂, map_eval₂]
  congr 1
  · ext a
    exact rootTupleAffinePoint_rootCoefficient q n F y a
  · change affineRootPointCoordinates (ZMod q) n
      (rootTupleAffinePoint q n F y) i = y i
    rw [rootTupleAffinePoint_coordinates]

theorem rootTupleAffinePoint_rootAvoidance
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q)) :
    (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          (rootAvoidanceSection (ZMod q) n g)) =
      ∏ i : Fin n,
        Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g := by
  unfold rootAvoidanceSection
  rw [map_prod, map_prod]
  apply Finset.prod_congr rfl
  intro i _hi
  exact rootTupleAffinePoint_rootEvaluation q n F y g i

theorem rootTupleAffinePoint_preimage_rootSpaceOpen_eq_top
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0) :
    rootTupleAffinePoint q n F y ⁻¹ᵁ RootSpaceOpen (ZMod q) n g = ⊤ := by
  have hprod : (∏ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g) ≠ 0 := by
    exact Finset.prod_ne_zero_iff.mpr (fun i _ => havoid i)
  let s := (rootTupleAffinePoint q n F y).appTop
    (rootAvoidanceSection (ZMod q) n g)
  have hsimage : (Scheme.ΓSpecIso (.of F)).hom s ≠ 0 := by
    rw [show (Scheme.ΓSpecIso (.of F)).hom s =
        ∏ i : Fin n,
          Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g by
      exact rootTupleAffinePoint_rootAvoidance q n F y g]
    exact hprod
  have hsunit : IsUnit s := by
    have hu : IsUnit ((Scheme.ΓSpecIso (.of F)).hom s) :=
      isUnit_iff_ne_zero.mpr hsimage
    have humap := hu.map (Scheme.ΓSpecIso (.of F)).inv.hom
    simpa using humap
  unfold RootSpaceOpen
  rw [Scheme.preimage_basicOpen_top]
  exact Scheme.basicOpen_of_isUnit (Spec (.of F)) hsunit

/-- A tuple avoiding the modulus divisor gives a point of the ordered-root
open with exactly those coordinates. -/
noncomputable def rootTupleRootSpacePoint
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0) :
    Spec (.of F) ⟶ RootSpace (ZMod q) n g := by
  let a := rootTupleAffinePoint q n F y
  apply IsOpenImmersion.lift (RootSpaceOpen (ZMod q) n g).ι a
  intro z hz
  obtain ⟨w, rfl⟩ := hz
  rw [Scheme.Opens.range_ι]
  apply a.mem_preimage.mp
  rw [rootTupleAffinePoint_preimage_rootSpaceOpen_eq_top
    q n F y g havoid]
  trivial

@[reassoc (attr := simp)]
theorem rootTupleRootSpacePoint_ι
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0) :
    rootTupleRootSpacePoint q n F y g havoid ≫
        (RootSpaceOpen (ZMod q) n g).ι =
      rootTupleAffinePoint q n F y := by
  unfold rootTupleRootSpacePoint
  exact IsOpenImmersion.lift_fac
    (f := (RootSpaceOpen (ZMod q) n g).ι)
    (g := rootTupleAffinePoint q n F y) _

/-- Root-space data satisfying the residue-fiber equation and the twisted
fixed-coordinate equation.  This is the intrinsic point-level stratum in
the Grothendieck--Lefschetz trace. -/
structure FullResidueUnitFiberFixedRootData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) where
  rootPoint : Spec (.of F) ⟶ RootSpace (ZMod q) n g
  residue_condition :
    rootPoint ≫ fullResidueMultiplicationToUnit
        (ZMod q) n m g hg hdeg hm hmn =
      Spec.map (CommRingCat.ofHom
        (ZMod.castHom (m := q) dvd_rfl F)) ≫ t
  twisted_fixed :
    twistedTupleFrobenius q n F σ
        (affineRootPointCoordinates (ZMod q) n
          (rootPoint ≫ (RootSpaceOpen (ZMod q) n g).ι)) =
      affineRootPointCoordinates (ZMod q) n
        (rootPoint ≫ (RootSpaceOpen (ZMod q) n g).ι)

namespace FullResidueUnitFiberFixedRootData

@[ext]
theorem ext
    {q n m : ℕ} [Fact q.Prime]
    {F : Type} [Field F] [CharP F q] [PerfectRing F q]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {hdeg : g.natDegree = m} {hm : 0 < m} {hmn : m ≤ n}
    {t : ResidueUnitPoint (ZMod q) m g} {σ : Equiv.Perm (Fin n)}
    {x y : FullResidueUnitFiberFixedRootData
      q n m F g hg hdeg hm hmn t σ}
    (h : x.rootPoint = y.rootPoint) : x = y := by
  cases x
  cases y
  cases h
  rfl

end FullResidueUnitFiberFixedRootData

/-- Forget a fixed point of the cartesian fiber to its root-space point. -/
noncomputable def fullResidueUnitFiberFixedPointToRootData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x}) :
    FullResidueUnitFiberFixedRootData
      q n m F g hg hdeg hm hmn t σ where
  rootPoint := x.1 ≫ fullResidueUnitFiberToRootSpace
    (ZMod q) n m g hg hdeg hm hmn t
  residue_condition := by
    rw [Category.assoc, fullResidueUnitFiber_condition]
    rw [← Category.assoc]
    congr 1
    exact specToZMod_hom_ext q F _ _
  twisted_fixed := by
    change twistedTupleFrobenius q n F σ
        (fullResidueUnitFiberRootCoordinates
          q n m F g hg hdeg hm hmn t x.1) =
      fullResidueUnitFiberRootCoordinates
        q n m F g hg hdeg hm hmn t x.1
    rw [← fullResidueUnitFiberRootCoordinates_comp_twistedFrobenius]
    rw [x.2]

/-- Reassemble a point of the cartesian residue fiber from intrinsic root
data. -/
noncomputable def fullResidueUnitFiberRootDataToPoint
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedRootData
      q n m F g hg hdeg hm hmn t σ) :
    {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} := by
  let base : Spec (.of F) ⟶ Spec (.of (ZMod q)) :=
    Spec.map (CommRingCat.ofHom
      (ZMod.castHom (m := q) dvd_rfl F))
  let p : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t :=
    pullback.lift x.rootPoint base x.residue_condition
  refine ⟨p, ?_⟩
  apply fullResidueUnitFiberRootCoordinates_injective
    q n m F g hg hdeg hm hmn t
  rw [fullResidueUnitFiberRootCoordinates_comp_twistedFrobenius]
  have hp_fst : p ≫ fullResidueUnitFiberToRootSpace
      (ZMod q) n m g hg hdeg hm hmn t = x.rootPoint := by
    change (pullback.lift x.rootPoint base x.residue_condition ≫
      pullback.fst _ _) = x.rootPoint
    exact pullback.lift_fst _ _ _
  have hpcoords : fullResidueUnitFiberRootCoordinates
      q n m F g hg hdeg hm hmn t p =
      affineRootPointCoordinates (ZMod q) n
        (x.rootPoint ≫ (RootSpaceOpen (ZMod q) n g).ι) := by
    unfold fullResidueUnitFiberRootCoordinates
    rw [← Category.assoc, hp_fst]
  rw [hpcoords]
  exact x.twisted_fixed

/-- Fixed geometric points of the twisted full fiber are exactly the
intrinsic fixed root-space data satisfying its cartesian equation. -/
noncomputable def fullResidueUnitFiberFixedPointEquivRootData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} ≃
      FullResidueUnitFiberFixedRootData
        q n m F g hg hdeg hm hmn t σ where
  toFun := fullResidueUnitFiberFixedPointToRootData
    q n m F g hg hdeg hm hmn t σ
  invFun := fullResidueUnitFiberRootDataToPoint
    q n m F g hg hdeg hm hmn t σ
  left_inv x := by
    apply Subtype.ext
    apply pullback.hom_ext
    · change (pullback.lift _ _ _ ≫
        fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t) = _
      exact pullback.lift_fst _ _ _
    · exact specToZMod_hom_ext q F _ _
  right_inv x := by
    apply FullResidueUnitFiberFixedRootData.ext
    change (pullback.lift _ _ _ ≫
      fullResidueUnitFiberToRootSpace
        (ZMod q) n m g hg hdeg hm hmn t) = _
    exact pullback.lift_fst _ _ _

theorem rootSpacePoint_avoids
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q))
    (z : Spec (.of F) ⟶ RootSpace (ZMod q) n g) :
    ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F)
        (affineRootPointCoordinates (ZMod q) n
          (z ≫ (RootSpaceOpen (ZMod q) n g).ι) i) g ≠ 0 := by
  let a := z ≫ (RootSpaceOpen (ZMod q) n g).ι
  have hopen : a ⁻¹ᵁ RootSpaceOpen (ZMod q) n g = ⊤ := by
    dsimp only [a]
    rw [Scheme.Hom.comp_preimage,
      Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top]
  have hsection :
      a.appTop (rootAvoidanceSection (ZMod q) n g) ≠ 0 := by
    intro hzero
    have hbasic : (Spec (.of F)).basicOpen
        (a.appTop (rootAvoidanceSection (ZMod q) n g)) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top]
      exact hopen
    rw [hzero, Scheme.basicOpen_zero] at hbasic
    have hne : (⊥ : (Spec (.of F)).Opens) ≠ ⊤ := by
      exact bot_ne_top
    exact hne hbasic
  have hprod : (∏ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F)
        (affineRootPointCoordinates (ZMod q) n a i) g) ≠ 0 := by
    have himage : (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (rootAvoidanceSection (ZMod q) n g)) ≠ 0 := by
      intro h
      apply hsection
      have hinv := congrArg
        (fun x ↦ (Scheme.ΓSpecIso (.of F)).inv x) h
      simpa using hinv
    rw [show (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (rootAvoidanceSection (ZMod q) n g)) =
          ∏ i : Fin n,
            Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F)
              (affineRootPointCoordinates (ZMod q) n a i) g by
      unfold rootAvoidanceSection
      rw [map_prod, map_prod]
      apply Finset.prod_congr rfl
      intro i _hi
      unfold rootEvaluationSection affineRootPointCoordinates
      rw [map_eval₂, map_eval₂]
      congr 1
      · ext c
        unfold rootCoefficientMap
        change (Scheme.ΓSpecIso (.of F)).hom
          (a.appTop
            ((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))).appTop
              ((Scheme.ΓSpecIso (.of (ZMod q))).inv c))) = _
        change (Scheme.ΓSpecIso (.of F)).hom
          ((((AffineRootSpace (ZMod q) n ↘ Spec (.of (ZMod q))).appTop ≫
            a.appTop) ((Scheme.ΓSpecIso (.of (ZMod q))).inv c))) = _
        have hover : a ≫ (AffineRootSpace (ZMod q) n ↘
            Spec (.of (ZMod q))) =
            Spec.map (CommRingCat.ofHom
              (ZMod.castHom (m := q) dvd_rfl F)) := by
          apply specToZMod_hom_ext q F
        have happ := congrArg Scheme.Hom.appTop hover
        rw [Scheme.Hom.comp_appTop] at happ
        rw [happ]
        change ((Spec.map (CommRingCat.ofHom
            (ZMod.castHom (m := q) dvd_rfl F))).appTop ≫
            (Scheme.ΓSpecIso (.of F)).hom)
              ((Scheme.ΓSpecIso (.of (ZMod q))).inv c) = _
        rw [Scheme.ΓSpecIso_naturality]
        simp] at himage
    exact himage
  exact fun i hi ↦ hprod (Finset.prod_eq_zero (Finset.mem_univ i) hi)

@[simp]
theorem rootTupleRootSpacePoint_coordinates
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0) :
    affineRootPointCoordinates (ZMod q) n
        (rootTupleRootSpacePoint q n F y g havoid ≫
          (RootSpaceOpen (ZMod q) n g).ι) = y := by
  rw [rootTupleRootSpacePoint_ι,
    rootTupleAffinePoint_coordinates]

theorem rootSpacePoint_eq_rootTupleRootSpacePoint
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q))
    (z : Spec (.of F) ⟶ RootSpace (ZMod q) n g) :
    z = rootTupleRootSpacePoint q n F
      (affineRootPointCoordinates (ZMod q) n
        (z ≫ (RootSpaceOpen (ZMod q) n g).ι)) g
      (rootSpacePoint_avoids q n F g z) := by
  apply (cancel_mono (RootSpaceOpen (ZMod q) n g).ι).1
  apply AffineSpace.hom_ext
  · exact specToZMod_hom_ext q F _ _
  · intro i
    rcases i with ⟨i⟩
    apply (Scheme.ΓSpecIso (.of F)).commRingCatIsoToRingEquiv.injective
    change affineRootPointCoordinates (ZMod q) n
        (z ≫ (RootSpaceOpen (ZMod q) n g).ι) i =
      affineRootPointCoordinates (ZMod q) n
        (rootTupleRootSpacePoint q n F
          (affineRootPointCoordinates (ZMod q) n
            (z ≫ (RootSpaceOpen (ZMod q) n g).ι)) g
          (rootSpacePoint_avoids q n F g z) ≫
            (RootSpaceOpen (ZMod q) n g).ι) i
    rw [rootTupleRootSpacePoint_coordinates]

/-- Literal tuples satisfying root avoidance, the residue-fiber equation,
and the twisted Frobenius equation. -/
structure FullResidueUnitFiberFixedTupleData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) where
  coords : Fin n → F
  avoids : ∀ i : Fin n,
    Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (coords i) g ≠ 0
  residue_condition :
    rootTupleRootSpacePoint q n F coords g avoids ≫
        fullResidueMultiplicationToUnit
          (ZMod q) n m g hg hdeg hm hmn =
      Spec.map (CommRingCat.ofHom
        (ZMod.castHom (m := q) dvd_rfl F)) ≫ t
  twisted_fixed : twistedTupleFrobenius q n F σ coords = coords

namespace FullResidueUnitFiberFixedTupleData

@[ext]
theorem ext
    {q n m : ℕ} [Fact q.Prime]
    {F : Type} [Field F] [CharP F q] [PerfectRing F q]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {hdeg : g.natDegree = m} {hm : 0 < m} {hmn : m ≤ n}
    {t : ResidueUnitPoint (ZMod q) m g} {σ : Equiv.Perm (Fin n)}
    {x y : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ}
    (h : x.coords = y.coords) : x = y := by
  cases x
  cases y
  cases h
  rfl

end FullResidueUnitFiberFixedTupleData

noncomputable def fullResidueUnitFiberRootDataToTupleData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedRootData
      q n m F g hg hdeg hm hmn t σ) :
    FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ where
  coords := affineRootPointCoordinates (ZMod q) n
    (x.rootPoint ≫ (RootSpaceOpen (ZMod q) n g).ι)
  avoids := rootSpacePoint_avoids q n F g x.rootPoint
  residue_condition := by
    rw [← rootSpacePoint_eq_rootTupleRootSpacePoint q n F g x.rootPoint]
    exact x.residue_condition
  twisted_fixed := x.twisted_fixed

noncomputable def fullResidueUnitFiberTupleDataToRootData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) :
    FullResidueUnitFiberFixedRootData
      q n m F g hg hdeg hm hmn t σ where
  rootPoint := rootTupleRootSpacePoint q n F x.coords g x.avoids
  residue_condition := x.residue_condition
  twisted_fixed := by
    simpa only [rootTupleRootSpacePoint_coordinates] using x.twisted_fixed

/-- Intrinsic fixed root data are exactly literal tuples satisfying the
open and cartesian equations. -/
noncomputable def fullResidueUnitFiberFixedRootDataEquivTupleData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    FullResidueUnitFiberFixedRootData
        q n m F g hg hdeg hm hmn t σ ≃
      FullResidueUnitFiberFixedTupleData
        q n m F g hg hdeg hm hmn t σ where
  toFun := fullResidueUnitFiberRootDataToTupleData
    q n m F g hg hdeg hm hmn t σ
  invFun := fullResidueUnitFiberTupleDataToRootData
    q n m F g hg hdeg hm hmn t σ
  left_inv x := by
    apply FullResidueUnitFiberFixedRootData.ext
    exact (rootSpacePoint_eq_rootTupleRootSpacePoint
      q n F g x.rootPoint).symm
  right_inv x := by
    apply FullResidueUnitFiberFixedTupleData.ext
    exact rootTupleRootSpacePoint_coordinates q n F x.coords g x.avoids

/-- Exact fixed-point classification by literal root tuples. -/
noncomputable def fullResidueUnitFiberFixedPointEquivTupleData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} ≃
      FullResidueUnitFiberFixedTupleData
        q n m F g hg hdeg hm hmn t σ :=
  (fullResidueUnitFiberFixedPointEquivRootData
    q n m F g hg hdeg hm hmn t σ).trans
    (fullResidueUnitFiberFixedRootDataEquivTupleData
      q n m F g hg hdeg hm hmn t σ)

/-- The monic polynomial with a prescribed ordered root tuple. -/
noncomputable def tupleRootPolynomial
    (n : ℕ) (F : Type*) [CommRing F] (x : Fin n → F) : Polynomial F :=
  ∏ i, (X - C (x i))

theorem tupleRootPolynomial_monic
    (n : ℕ) (F : Type*) [CommRing F] (x : Fin n → F) :
    (tupleRootPolynomial n F x).Monic := by
  unfold tupleRootPolynomial
  exact monic_prod_of_monic Finset.univ (fun i => X - C (x i))
    (fun i _ => monic_X_sub_C (x i))

theorem tupleRootPolynomial_natDegree
    (n : ℕ) (F : Type*) [Field F] (x : Fin n → F) :
    (tupleRootPolynomial n F x).natDegree = n := by
  unfold tupleRootPolynomial
  rw [natDegree_prod_of_monic]
  · simp
  · intro i _
    exact monic_X_sub_C (x i)

theorem tupleRootPolynomial_map_frobenius
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : Fin n → F) :
    (tupleRootPolynomial n F x).map (frobenius F q) =
      tupleRootPolynomial n F (fun i => (x i) ^ q) := by
  simp [tupleRootPolynomial, Polynomial.map_prod, frobenius_def]

theorem tupleRootPolynomial_comp_perm
    (n : ℕ) (F : Type*) [CommRing F]
    (σ : Equiv.Perm (Fin n)) (x : Fin n → F) :
    tupleRootPolynomial n F (fun i => x (σ i)) =
      tupleRootPolynomial n F x := by
  unfold tupleRootPolynomial
  exact Equiv.prod_comp σ (fun i => X - C (x i))

theorem tupleRootPolynomial_map_frobenius_eq_self_of_twisted_fixed
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) (x : Fin n → F)
    (hx : twistedTupleFrobenius q n F σ x = x) :
    (tupleRootPolynomial n F x).map (frobenius F q) =
      tupleRootPolynomial n F x := by
  rw [tupleRootPolynomial_map_frobenius]
  have hfix := (twistedTupleFrobenius_fixed_iff q n F σ x).mp hx
  calc
    tupleRootPolynomial n F (fun i => (x i) ^ q) =
        tupleRootPolynomial n F (fun i => x (σ.symm i)) := by
          congr 1
          funext i
          simpa using hfix (σ.symm i)
    _ = tupleRootPolynomial n F x :=
      tupleRootPolynomial_comp_perm n F σ.symm x

theorem tupleRootPolynomial_coeff_pow_eq_self_of_twisted_fixed
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) (x : Fin n → F)
    (hx : twistedTupleFrobenius q n F σ x = x) (j : ℕ) :
    (tupleRootPolynomial n F x).coeff j ^ q =
      (tupleRootPolynomial n F x).coeff j := by
  have h := congrArg (fun p : Polynomial F => p.coeff j)
    (tupleRootPolynomial_map_frobenius_eq_self_of_twisted_fixed
      q n F σ x hx)
  simpa [frobenius_def] using h

/-- The root polynomial of a twisted Frobenius-fixed tuple, descended
coefficientwise to the prime field. -/
noncomputable def descendedTupleRootPolynomial
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n))
    (x : {x : Fin n → F // twistedTupleFrobenius q n F σ x = x}) :
    Polynomial (ZMod q) :=
  (tupleRootPolynomial n F x.1).sum fun j _a =>
    C ((zmodEquivFrobeniusFixed q F).symm
      ⟨(tupleRootPolynomial n F x.1).coeff j,
        tupleRootPolynomial_coeff_pow_eq_self_of_twisted_fixed
          q n F σ x.1 x.2 j⟩) * X ^ j

/-- Scalar extension of the descended polynomial recovers exactly the
original root polynomial. -/
theorem descendedTupleRootPolynomial_map
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n))
    (x : {x : Fin n → F // twistedTupleFrobenius q n F σ x = x}) :
    (descendedTupleRootPolynomial q n F σ x).map
        (ZMod.castHom (m := q) dvd_rfl F) =
      tupleRootPolynomial n F x.1 := by
  unfold descendedTupleRootPolynomial
  rw [Polynomial.sum_def]
  rw [Polynomial.map_sum (ZMod.castHom (m := q) dvd_rfl F)]
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
    Polynomial.map_pow, zmodEquivFrobeniusFixed_apply_symm]
  exact (Polynomial.as_sum_support_C_mul_X_pow
    (tupleRootPolynomial n F x.1)).symm

theorem descendedTupleRootPolynomial_monic
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n))
    (x : {x : Fin n → F // twistedTupleFrobenius q n F σ x = x}) :
    (descendedTupleRootPolynomial q n F σ x).Monic := by
  apply (ZMod.castHom (m := q) dvd_rfl F).injective.monic_map_iff.mpr
  rw [descendedTupleRootPolynomial_map]
  exact tupleRootPolynomial_monic n F x.1

theorem descendedTupleRootPolynomial_natDegree
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n))
    (x : {x : Fin n → F // twistedTupleFrobenius q n F σ x = x}) :
    (descendedTupleRootPolynomial q n F σ x).natDegree = n := by
  rw [← Polynomial.natDegree_map_eq_of_injective
    (ZMod.castHom (m := q) dvd_rfl F).injective,
    descendedTupleRootPolynomial_map,
    tupleRootPolynomial_natDegree]

/-! ### A full Frobenius orbit gives an irreducible factor

This is the converse arithmetic ingredient in the twisted-root trace
calculation.  If the roots of a degree-`d` polynomial form one orbit of
length `d`, its minimal polynomial already has `d` distinct roots; hence it
is the whole polynomial. -/

private theorem frobenius_comp_zmodCast
    (q : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] :
    (frobenius F q).comp (ZMod.castHom (m := q) dvd_rfl F) =
      ZMod.castHom (m := q) dvd_rfl F := by
  ext z
  change (ZMod.castHom (m := q) dvd_rfl F z) ^ q = _
  rw [← map_pow, ZMod.pow_card]

theorem minpoly_map_isRoot_iterateFrobenius
    (q : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    [Algebra.IsAlgebraic (ZMod q) F]
    (α : F) (i : ℕ) :
    ((minpoly (ZMod q) α).map
      (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
        ((frobeniusEquiv F q)^[i] α) := by
  have hι : ZMod.castHom (m := q) dvd_rfl F =
      algebraMap (ZMod q) F := Subsingleton.elim _ _
  induction i with
  | zero =>
      change ((minpoly (ZMod q) α).map
        (ZMod.castHom (m := q) dvd_rfl F)).IsRoot α
      simpa [hι, Polynomial.IsRoot, Polynomial.eval_map,
        Polynomial.aeval_def] using minpoly.aeval (ZMod q) α
  | succ i ih =>
      have hmap := Polynomial.IsRoot.map (f := frobenius F q) ih
      rw [Polynomial.map_map, frobenius_comp_zmodCast q F] at hmap
      simpa [Function.iterate_succ_apply', frobeniusEquiv_def] using hmap

/-- A degree-`d` irreducible polynomial over the prime field divides
`X^(q^d)-X`. -/
theorem irreducible_dvd_X_pow_q_pow_natDegree_sub_X
    (q d : ℕ) [Fact q.Prime]
    (p : Polynomial (ZMod q)) (hp : Irreducible p)
    (hdeg : p.natDegree = d) :
    p ∣ Polynomial.X ^ q ^ d - Polynomial.X := by
  have h :=
    (hp.natDegree_dvd_iff_dvd_X_pow_card_pow_sub_X (n := d)).mp
      (show p.natDegree ∣ d by rw [hdeg])
  simpa [ZMod.card q] using h

/-- Every root of a degree-`d` irreducible polynomial over `ZMod q` is
fixed by the `d`th iterate of arithmetic Frobenius. -/
theorem irreducibleRoot_frobenius_iterate_natDegree
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (p : Polynomial (ZMod q)) (hp : Irreducible p)
    (hdeg : p.natDegree = d) (a : p.rootSet F) :
    (frobeniusEquiv F q)^[d] a.1 = a.1 := by
  have hroot : Polynomial.aeval a.1 p = 0 :=
    (Polynomial.mem_rootSet.mp a.2).2
  obtain ⟨r, hr⟩ :=
    irreducible_dvd_X_pow_q_pow_natDegree_sub_X q d p hp hdeg
  have heval := congrArg (Polynomial.aeval a.1) hr
  simp only [map_mul, hroot, zero_mul, map_sub, map_pow,
    Polynomial.aeval_X] at heval
  rw [sub_eq_zero] at heval
  simpa [frobeniusEquiv_def, iterate_frobenius] using heval

/-- The first `d` Frobenius iterates of a root of a degree-`d`
irreducible are pairwise distinct. -/
theorem irreducibleRoot_frobeniusOrbit_injective
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (p : Polynomial (ZMod q)) (hp : Irreducible p)
    (hdeg : p.natDegree = d) (a : p.rootSet F) :
    Function.Injective (fun i : Fin d =>
      (frobeniusEquiv F q)^[i.1] a.1) := by
  intro i j hij
  apply Fin.ext
  have aux : ∀ (i j : Fin d), i.1 ≤ j.1 →
      (frobeniusEquiv F q)^[i.1] a.1 =
        (frobeniusEquiv F q)^[j.1] a.1 → i.1 = j.1 := by
    intro i j hijle hij'
    let e := j.1 - i.1
    have hiter :
        (frobeniusEquiv F q)^[i.1]
            ((frobeniusEquiv F q)^[e] a.1) =
          (frobeniusEquiv F q)^[i.1] a.1 := by
      calc
        _ = (frobeniusEquiv F q)^[i.1 + e] a.1 :=
          (Function.iterate_add_apply _ _ _ _).symm
        _ = (frobeniusEquiv F q)^[j.1] a.1 := by
          congr 2
          dsimp only [e]
          omega
        _ = _ := hij'.symm
    have heq : (frobeniusEquiv F q)^[e] a.1 = a.1 :=
      (Function.Injective.iterate
        (frobeniusEquiv F q).injective i.1) hiter
    have hroot : Polynomial.aeval a.1 p = 0 :=
      (Polynomial.mem_rootSet.mp a.2).2
    have heval : Polynomial.aeval a.1
        (Polynomial.X ^ q ^ e - Polynomial.X :
          Polynomial (ZMod q)) = 0 := by
      simp only [map_sub, map_pow, Polynomial.aeval_X, sub_eq_zero]
      simpa [frobeniusEquiv_def, iterate_frobenius] using heq
    have hdvd : p ∣ Polynomial.X ^ q ^ e - Polynomial.X :=
      (hp.dvd_iff_aeval_eq_zero hroot).mp heval
    have hde : d ∣ e := by
      rw [← hdeg]
      exact hp.natDegree_dvd_of_dvd_X_pow_card_pow_sub_X
        (by simpa [ZMod.card q] using hdvd)
    have he_lt : e < d := by
      dsimp only [e]
      omega
    have he0 : e = 0 := Nat.eq_zero_of_dvd_of_lt hde he_lt
    dsimp only [e] at he0
    omega
  rcases le_total i.1 j.1 with hijle | hjile
  · exact aux i j hijle hij
  · exact (aux j i hjile hij.symm).symm

/-- Over an algebraically closed coefficient field, a monic irreducible
polynomial is the product of the linear factors in the Frobenius orbit of
any one of its roots. -/
theorem irreducible_map_eq_prod_frobeniusOrbit
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (p : Polynomial (ZMod q)) (hpmonic : p.Monic)
    (hp : Irreducible p) (hdeg : p.natDegree = d)
    (a : p.rootSet F) :
    p.map (ZMod.castHom (m := q) dvd_rfl F) =
      ∏ i : Fin d,
        (Polynomial.X - Polynomial.C
          ((frobeniusEquiv F q)^[i.1] a.1)) := by
  classical
  let ι : ZMod q →+* F := ZMod.castHom (m := q) dvd_rfl F
  have hι : ι = algebraMap (ZMod q) F := Subsingleton.elim _ _
  have hsep : p.Separable := PerfectField.separable_of_irreducible hp
  have hsplits : (p.map ι).Splits := IsAlgClosed.splits _
  let orbit : Fin d → F :=
    fun i => (frobeniusEquiv F q)^[i.1] a.1
  have horbitInj : Function.Injective orbit :=
    irreducibleRoot_frobeniusOrbit_injective q d F p hp hdeg a
  have hbase : (p.map ι).IsRoot a.1 := by
    have haeval : Polynomial.aeval a.1 p = 0 :=
      (Polynomial.mem_rootSet.mp a.2).2
    simpa [Polynomial.IsRoot, Polynomial.eval_map, hι,
      Polynomial.aeval_def] using haeval
  have hfixedPoly : (p.map ι).map (frobenius F q) = p.map ι := by
    rw [Polynomial.map_map]
    have hcomp : (frobenius F q).comp ι = ι := by
      simpa [ι] using frobenius_comp_zmodCast q F
    rw [hcomp]
  have hiterRoot : ∀ n : ℕ,
      (p.map ι).IsRoot ((frobeniusEquiv F q)^[n] a.1) := by
    intro n
    induction n with
    | zero => simpa using hbase
    | succ n ih =>
        have hmap := Polynomial.IsRoot.map (f := frobenius F q) ih
        rw [hfixedPoly] at hmap
        simpa [Function.iterate_succ_apply', frobeniusEquiv_def] using hmap
  have horbitRoot : ∀ i, (p.map ι).IsRoot (orbit i) :=
    fun i => hiterRoot i.1
  have hfinset : Finset.univ.image orbit = (p.map ι).roots.toFinset := by
    apply Finset.eq_of_subset_of_card_le
    · intro z hz
      rw [Finset.mem_image] at hz
      obtain ⟨i, _hi, rfl⟩ := hz
      rw [Multiset.mem_toFinset]
      exact (Polynomial.mem_roots
        (Polynomial.map_monic_ne_zero hpmonic)).mpr (horbitRoot i)
    · rw [Finset.card_image_of_injective _ horbitInj,
        Finset.card_univ, Fintype.card_fin]
      rw [Multiset.toFinset_card_of_nodup
          (Polynomial.nodup_roots hsep.map),
        ← hsplits.natDegree_eq_card_roots,
        Polynomial.natDegree_map_eq_of_injective ι.injective, hdeg]
  calc
    p.map (ZMod.castHom (m := q) dvd_rfl F) = p.map ι := by rfl
    _ = (Multiset.map
        (fun x => Polynomial.X - Polynomial.C x)
        (p.map ι).roots).prod :=
      hsplits.eq_prod_roots_of_monic (hpmonic.map ι)
    _ = (∏ i : Fin d,
        (Polynomial.X - Polynomial.C (orbit i))) := by
      have hroots : (p.map ι).roots =
          (Finset.univ.image orbit).val := by
        have hn1 : (p.map ι).roots.Nodup :=
          Polynomial.nodup_roots hsep.map
        have hn2 : (Finset.univ.image orbit).val.Nodup :=
          (Finset.univ.image orbit).nodup
        apply (Multiset.Nodup.ext hn1 hn2).2
        intro z
        rw [← Multiset.mem_toFinset, ← Multiset.mem_toFinset]
        simpa [hfinset]
      rw [hroots]
      change (∏ z ∈ Finset.univ.image orbit,
        (Polynomial.X - Polynomial.C z)) = _
      rw [Finset.prod_image]
      exact horbitInj.injOn

theorem irreducible_of_distinct_frobenius_orbit
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    [Algebra.IsAlgebraic (ZMod q) F]
    (α : F) (p : Polynomial (ZMod q))
    (hd : 0 < d) (hpmonic : p.Monic) (hpdeg : p.natDegree = d)
    (hmap : p.map (ZMod.castHom (m := q) dvd_rfl F) =
      ∏ i : Fin d,
        (Polynomial.X - Polynomial.C ((frobeniusEquiv F q)^[i.1] α)))
    (horbit : Function.Injective
      (fun i : Fin d => (frobeniusEquiv F q)^[i.1] α)) :
    Irreducible p := by
  classical
  let ι : ZMod q →+* F := ZMod.castHom (m := q) dvd_rfl F
  have hι : ι = algebraMap (ZMod q) F := Subsingleton.elim _ _
  let m := minpoly (ZMod q) α
  have hmmonic : m.Monic := minpoly.monic
    (Algebra.IsIntegral.isIntegral α)
  have hpRoot : (p.map ι).IsRoot α := by
    rw [hmap]
    rw [Polynomial.IsRoot, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (i := ⟨0, hd⟩)
    · exact Finset.mem_univ _
    · simp
  have hpEval : Polynomial.aeval α p = 0 := by
    simpa [hι, Polynomial.IsRoot, Polynomial.eval_map,
      Polynomial.aeval_def] using hpRoot
  have hdiv : m ∣ p := minpoly.dvd (ZMod q) α hpEval
  have hmapm0 : m.map ι ≠ 0 :=
    Polynomial.map_monic_ne_zero hmmonic
  have hroots : ∀ i : Fin d,
      (fun i : Fin d => (frobeniusEquiv F q)^[i.1] α) i ∈
        (m.map ι).roots.toFinset := by
    intro i
    rw [Multiset.mem_toFinset]
    exact (Polynomial.mem_roots hmapm0).2
      (minpoly_map_isRoot_iterateFrobenius q F α i.1)
  have himage : (Finset.univ.image
      (fun i : Fin d => (frobeniusEquiv F q)^[i.1] α)).card = d := by
    rw [Finset.card_image_of_injective _ horbit, Finset.card_univ,
      Fintype.card_fin]
  have hdle : d ≤ (m.map ι).natDegree := by
    calc
      d = (Finset.univ.image
          (fun i : Fin d => (frobeniusEquiv F q)^[i.1] α)).card :=
        himage.symm
      _ ≤ (m.map ι).roots.toFinset.card := by
        apply Finset.card_le_card
        intro z hz
        rw [Finset.mem_image] at hz
        obtain ⟨i, _hi, rfl⟩ := hz
        exact hroots i
      _ ≤ (m.map ι).roots.card := Multiset.toFinset_card_le _
      _ ≤ (m.map ι).natDegree := Polynomial.card_roots' _
  have hmdeg : d ≤ m.natDegree := by
    rw [Polynomial.natDegree_map_eq_of_injective ι.injective] at hdle
    exact hdle
  have heq : p = m := by
    apply Polynomial.eq_of_monic_of_dvd_of_natDegree_le hmmonic hpmonic hdiv
    rw [hpdeg]
    exact hmdeg
  rw [heq]
  exact minpoly.irreducible (Algebra.IsIntegral.isIntegral α)

open Polynomial

/-- Three disjoint cycles, one for each of the three degree-`d` factors. -/
noncomputable def threeBlockCyclePermutation (d : ℕ) :
    Equiv.Perm (Fin (3 * d)) :=
  (finProdFinEquiv (m := 3) (n := d)).symm |>.trans
    (Equiv.prodCongr (Equiv.refl (Fin 3)) (finRotate d).symm) |>.trans
    (finProdFinEquiv (m := 3) (n := d))

@[simp]
theorem threeBlockCyclePermutation_apply (d : ℕ) (b : Fin 3) (j : Fin d) :
    threeBlockCyclePermutation d (finProdFinEquiv (b, j)) =
      finProdFinEquiv (b, (finRotate d).symm j) := by
  simp [threeBlockCyclePermutation]

/-- Restriction of a fixed ordered-root tuple to one of its three cycles. -/
noncomputable def threeBlockFixedBlock
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) :
    {y : Fin d → F //
      twistedTupleFrobenius q d F (finRotate d).symm y = y} := by
  refine ⟨fun j => x.1 (finProdFinEquiv (b, j)), ?_⟩
  apply (twistedTupleFrobenius_fixed_iff q d F (finRotate d).symm _).2
  intro j
  have h := (twistedTupleFrobenius_fixed_iff q (3 * d) F
    (threeBlockCyclePermutation d) x.1).1 x.2 (finProdFinEquiv (b, j))
  simpa using h

theorem threeBlockFixedBlock_eq_frobenius_iterate
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) (j : Fin d) :
    (threeBlockFixedBlock q d F x b).1 j =
      (frobeniusEquiv F q)^[j.1]
        ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩) := by
  have hrec : ∀ n : ℕ, ∀ hn : n < d,
      (threeBlockFixedBlock q d F x b).1 ⟨n, hn⟩ =
        (frobeniusEquiv F q)^[n]
          ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩) := by
    intro n
    induction n with
    | zero =>
        intro hn
        rfl
    | succ n ih =>
        intro hn
        have hfix := (twistedTupleFrobenius_fixed_iff q d F
          (finRotate d).symm (threeBlockFixedBlock q d F x b)).1
          (threeBlockFixedBlock q d F x b).2 ⟨n + 1, hn⟩
        have hprev : (finRotate d).symm (⟨n + 1, hn⟩ : Fin d) =
            ⟨n, by omega⟩ := by
          apply (finRotate d).injective
          simp only [Equiv.apply_symm_apply]
          rw [finRotate_apply]
          apply Fin.ext
          simp [Fin.add_def, Nat.mod_eq_of_lt hn]
        rw [hprev] at hfix
        calc
          (threeBlockFixedBlock q d F x b).1 ⟨n + 1, hn⟩ =
              frobeniusEquiv F q
                ((threeBlockFixedBlock q d F x b).1 ⟨n, by omega⟩) := hfix.symm
          _ = frobeniusEquiv F q
                ((frobeniusEquiv F q)^[n]
                  ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩)) :=
              congrArg (frobeniusEquiv F q) (ih (by omega))
          _ = (frobeniusEquiv F q)^[n + 1]
                ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩) :=
              (Function.iterate_succ_apply' (frobeniusEquiv F q) n _).symm
  exact hrec j.1 j.2

theorem threeBlockFixedBlock_injective
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (hxinj : Function.Injective x.1) (b : Fin 3) :
    Function.Injective (threeBlockFixedBlock q d F x b).1 := by
  intro i j hij
  have := hxinj (show
    x.1 (finProdFinEquiv (b, i)) =
      x.1 (finProdFinEquiv (b, j)) from hij)
  simpa using congrArg
    (fun z : Fin (3 * d) => (finProdFinEquiv.symm z).2) this

/-- The descended degree-`d` factor contributed by one of the three cycles. -/
noncomputable def threeBlockDescendedFactor
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) : Polynomial (ZMod q) :=
  descendedTupleRootPolynomial q d F (finRotate d).symm
    (threeBlockFixedBlock q d F x b)

theorem threeBlockDescendedFactor_map
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) :
    (threeBlockDescendedFactor q d F x b).map
        (ZMod.castHom (m := q) dvd_rfl F) =
      tupleRootPolynomial d F (threeBlockFixedBlock q d F x b).1 := by
  exact descendedTupleRootPolynomial_map q d F (finRotate d).symm _

theorem threeBlockDescendedFactor_monic
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) : (threeBlockDescendedFactor q d F x b).Monic :=
  descendedTupleRootPolynomial_monic q d F (finRotate d).symm _

theorem threeBlockDescendedFactor_natDegree
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) :
    (threeBlockDescendedFactor q d F x b).natDegree = d :=
  descendedTupleRootPolynomial_natDegree q d F (finRotate d).symm _

theorem threeBlockDescendedFactor_map_eq_frobenius_orbit
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (b : Fin 3) :
    (threeBlockDescendedFactor q d F x b).map
        (ZMod.castHom (m := q) dvd_rfl F) =
      ∏ j : Fin d, (X - C ((frobeniusEquiv F q)^[j.1]
        ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩))) := by
  rw [threeBlockDescendedFactor_map]
  unfold tupleRootPolynomial
  apply Finset.prod_congr rfl
  intro j _hj
  rw [threeBlockFixedBlock_eq_frobenius_iterate q d hd]

theorem threeBlockDescendedFactor_irreducible
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (hxinj : Function.Injective x.1) (b : Fin 3) :
    Irreducible (threeBlockDescendedFactor q d F x b) := by
  apply irreducible_of_distinct_frobenius_orbit q d F
    ((threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩)
  · exact hd
  · exact threeBlockDescendedFactor_monic q d F x b
  · exact threeBlockDescendedFactor_natDegree q d F x b
  · exact threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd F x b
  · intro i j hij
    have hblock := threeBlockFixedBlock_injective q d F x hxinj b
    apply hblock
    have hi := threeBlockFixedBlock_eq_frobenius_iterate
      q d hd F x b i
    have hj := threeBlockFixedBlock_eq_frobenius_iterate
      q d hd F x b j
    exact hi.trans (hij.trans hj.symm)

theorem descendedTupleRootPolynomial_threeBlock_factorization
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x}) :
    descendedTupleRootPolynomial q (3 * d) F
        (threeBlockCyclePermutation d) x =
      ∏ b : Fin 3, threeBlockDescendedFactor q d F x b := by
  apply Polynomial.map_injective
    (ZMod.castHom (m := q) dvd_rfl F)
    (ZMod.castHom (m := q) dvd_rfl F).injective
  rw [descendedTupleRootPolynomial_map]
  simp only [Polynomial.map_prod, threeBlockDescendedFactor_map]
  unfold tupleRootPolynomial
  change (∏ i : Fin (3 * d), (X - C (x.1 i))) =
    ∏ b : Fin 3, ∏ j : Fin d,
      (X - C (x.1 (finProdFinEquiv (b, j))))
  rw [← Finset.prod_product' Finset.univ Finset.univ]
  rw [Finset.univ_product_univ]
  exact (Equiv.prod_comp (finProdFinEquiv (m := 3) (n := d))
    (fun i => X - C (x.1 i))).symm

theorem threeBlockDescendedFactor_ne
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (hxinj : Function.Injective x.1) {b c : Fin 3} (hbc : b ≠ c) :
    threeBlockDescendedFactor q d F x b ≠
      threeBlockDescendedFactor q d F x c := by
  classical
  intro heq
  let αb := (threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩
  have hbroot :
      ((threeBlockDescendedFactor q d F x b).map
        (ZMod.castHom (m := q) dvd_rfl F)).IsRoot αb := by
    rw [threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd]
    rw [Polynomial.IsRoot, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (i := ⟨0, hd⟩)
    · exact Finset.mem_univ _
    · simp [αb]
  have hcroot :
      ((threeBlockDescendedFactor q d F x c).map
        (ZMod.castHom (m := q) dvd_rfl F)).IsRoot αb := by
    simpa only [heq] using hbroot
  rw [threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd,
    Polynomial.IsRoot, Polynomial.eval_prod,
    Finset.prod_eq_zero_iff] at hcroot
  obtain ⟨j, _hjmem, hj⟩ := hcroot
  have hα : (threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩ =
      (threeBlockFixedBlock q d F x c).1 j := by
    have hj' : (threeBlockFixedBlock q d F x b).1 ⟨0, hd⟩ =
        (frobeniusEquiv F q)^[j.1]
          ((threeBlockFixedBlock q d F x c).1 ⟨0, hd⟩) := by
      apply sub_eq_zero.mp
      simpa [αb, frobeniusEquiv_def] using hj
    exact hj'.trans
      (threeBlockFixedBlock_eq_frobenius_iterate q d hd F x c j).symm
  have hidx := hxinj (show
    x.1 (finProdFinEquiv (b, ⟨0, hd⟩)) =
      x.1 (finProdFinEquiv (c, j)) from hα)
  have hpair := congrArg
    (fun z : Fin (3 * d) => finProdFinEquiv.symm z) hidx
  have : b = c := by
    simpa using congrArg Prod.fst hpair
  exact hbc this

theorem threeBlockDescendedFactor_isCoprime
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (hxinj : Function.Injective x.1) {b c : Fin 3} (hbc : b ≠ c) :
    IsCoprime (threeBlockDescendedFactor q d F x b)
      (threeBlockDescendedFactor q d F x c) := by
  let fb := threeBlockDescendedFactor q d F x b
  let fc := threeBlockDescendedFactor q d F x c
  have hib := threeBlockDescendedFactor_irreducible q d hd F x hxinj b
  have hic := threeBlockDescendedFactor_irreducible q d hd F x hxinj c
  rw [hib.coprime_iff_not_dvd]
  intro hdvd
  have hassoc := hib.associated_of_dvd hic hdvd
  have heq : fb = fc := Polynomial.eq_of_monic_of_associated
    (threeBlockDescendedFactor_monic q d F x b)
    (threeBlockDescendedFactor_monic q d F x c) hassoc
  exact threeBlockDescendedFactor_ne q d hd F x hxinj hbc heq

/-- A distinct fixed ordered-root tuple with the three-cycle twist gives a
literal ordered irreducible triple over the prime field. -/
noncomputable def threeBlockCongruentIrreducibleTriple
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g t : Polynomial (ZMod q))
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (hxinj : Function.Injective x.1)
    (hmod : descendedTupleRootPolynomial q (3 * d) F
        (threeBlockCyclePermutation d) x %ₘ g = t) :
    CongruentIrreducibleTriple q d g t := by
  let f (b : Fin 3) := threeBlockDescendedFactor q d F x b
  let F₁ : Polynomial.MonicDegreeEq (ZMod q) d :=
    Polynomial.MonicDegreeEq.mk (f 0)
      (threeBlockDescendedFactor_monic q d F x 0)
      (threeBlockDescendedFactor_natDegree q d F x 0)
  let F₂ : Polynomial.MonicDegreeEq (ZMod q) d :=
    Polynomial.MonicDegreeEq.mk (f 1)
      (threeBlockDescendedFactor_monic q d F x 1)
      (threeBlockDescendedFactor_natDegree q d F x 1)
  let F₃ : Polynomial.MonicDegreeEq (ZMod q) d :=
    Polynomial.MonicDegreeEq.mk (f 2)
      (threeBlockDescendedFactor_monic q d F x 2)
      (threeBlockDescendedFactor_natDegree q d F x 2)
  have hproduct : F₁.1 * F₂.1 * F₃.1 =
      descendedTupleRootPolynomial q (3 * d) F
        (threeBlockCyclePermutation d) x := by
    rw [descendedTupleRootPolynomial_threeBlock_factorization]
    simp [F₁, F₂, F₃, f, Fin.prod_univ_succ, mul_assoc]
  refine ⟨⟨F₁, F₂, F₃, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · rw [hproduct]
    simpa using hmod
  · exact threeBlockDescendedFactor_isCoprime q d hd F x hxinj (by decide)
  · exact threeBlockDescendedFactor_isCoprime q d hd F x hxinj (by decide)
  · exact threeBlockDescendedFactor_isCoprime q d hd F x hxinj (by decide)
  · exact threeBlockDescendedFactor_irreducible q d hd F x hxinj 0
  · exact threeBlockDescendedFactor_irreducible q d hd F x hxinj 1
  · exact threeBlockDescendedFactor_irreducible q d hd F x hxinj 2

/-! ### From fixed geometric tuples to the literal residue congruence

The fixed-point fiber equation is scheme-theoretic.  The next lemmas
evaluate it on the universal residue polynomial and identify it with the
literal polynomial congruence required by the arithmetic factorization.
-/

/-- The polynomial represented by a rational point of the unit-valued
coefficient space. -/
noncomputable def residueUnitPointPolynomial
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) : Polynomial (ZMod q) :=
  ∑ j : Fin m,
    C ((Scheme.ΓSpecIso (.of (ZMod q))).hom
      ((t ≫ residueUnitImmersion (ZMod q) m g).appTop
        (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) * X ^ j.1

theorem residueUnitPointPolynomial_coeff
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) (j : Fin m) :
    (residueUnitPointPolynomial q m g t).coeff j =
      (Scheme.ΓSpecIso (.of (ZMod q))).hom
        ((t ≫ residueUnitImmersion (ZMod q) m g).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j))) := by
  classical
  simp only [residueUnitPointPolynomial, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_eq_single j]
  · simp
  · intro b _hb hbj
    rw [if_neg]
    intro hnat
    exact hbj (Fin.ext hnat.symm)
  · simp

/-- Evaluation of global functions on an affine-root-space point. -/
noncomputable def affineRootPointEvaluationHom
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (a : Spec (.of F) ⟶ AffineRootSpace (ZMod q) n) :
    Γ(AffineRootSpace (ZMod q) n, ⊤) →+* F :=
  (Scheme.ΓSpecIso (.of F)).hom.hom.comp a.appTop.hom

theorem rootTupleAffinePoint_universalRootPolynomial
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] (y : Fin n → F) :
    (universalRootPolynomial (ZMod q) n).map
        (affineRootPointEvaluationHom q n F
          (rootTupleAffinePoint q n F y)) =
      tupleRootPolynomial n F y := by
  unfold universalRootPolynomial tupleRootPolynomial
  rw [Polynomial.map_prod]
  apply Finset.prod_congr rfl
  intro i _hi
  simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  congr 2
  change (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q n F y).appTop
        (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up i))) = y i
  exact congrFun (rootTupleAffinePoint_coordinates q n F y) i

theorem rootTupleAffinePoint_universalRootRemainder
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q)) (hg : g.Monic) :
    (universalRootRemainder (ZMod q) n g hg).map
        (affineRootPointEvaluationHom q n F
          (rootTupleAffinePoint q n F y)) =
      tupleRootPolynomial n F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) := by
  unfold universalRootRemainder
  rw [Polynomial.map_modByMonic _ (hg.map _),
    rootTupleAffinePoint_universalRootPolynomial]
  congr 1
  rw [Polynomial.map_map]
  congr 1
  ext a
  exact rootTupleAffinePoint_rootCoefficient q n F y a

/-- Composing the cartesian unit-fiber equation with its open immersion
recovers the literal affine coefficient equation. -/
theorem fullResidueUnitFiberFixedTupleData_affine_residue_condition
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) :
    rootTupleAffinePoint q n F x.coords ≫
        affineResidueMultiplication (ZMod q) n m g hg =
      Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F)) ≫ t ≫
        residueUnitImmersion (ZMod q) m g := by
  have h := congrArg (fun f => f ≫ residueUnitImmersion (ZMod q) m g)
    x.residue_condition
  simpa only [Category.assoc, fullResidueMultiplicationToUnit_fac,
    residueMultiplication, rootTupleRootSpacePoint_ι_assoc] using h

theorem zmodBaseChange_evaluate
    (q : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (u : Γ(Spec (.of (ZMod q)), ⊤)) :
    (Scheme.ΓSpecIso (.of F)).hom
        ((Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F))).appTop u) =
      ZMod.castHom (m := q) dvd_rfl F
        ((Scheme.ΓSpecIso (.of (ZMod q))).hom u) := by
  change ((Spec.map (CommRingCat.ofHom
      (ZMod.castHom (m := q) dvd_rfl F))).appTop ≫
      (Scheme.ΓSpecIso (.of F)).hom) u = _
  rw [Scheme.ΓSpecIso_naturality]
  simp

theorem fullResidueUnitFiberFixedTupleData_residue_coeff
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) (j : Fin m) :
    (tupleRootPolynomial n F x.coords %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff j =
      ZMod.castHom (m := q) dvd_rfl F
        ((residueUnitPointPolynomial q m g t).coeff j) := by
  have hmor := fullResidueUnitFiberFixedTupleData_affine_residue_condition
    q n m F g hg hdeg hm hmn t σ x
  have happ := congrArg Scheme.Hom.appTop hmor
  have hc := congrArg (fun f =>
      (Scheme.ΓSpecIso (.of F)).hom
        (f (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) happ
  have hleft := congrArg (fun p : Polynomial F => p.coeff j)
    (rootTupleAffinePoint_universalRootRemainder
      q n m F x.coords g hg)
  rw [Polynomial.coeff_map] at hleft
  rw [residueUnitPointPolynomial_coeff]
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at hc
  change (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q n F x.coords).appTop
        ((affineResidueMultiplication (ZMod q) n m g hg).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) =
    (Scheme.ΓSpecIso (.of F)).hom
      ((Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F))).appTop
        ((t ≫ residueUnitImmersion (ZMod q) m g).appTop
          (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) at hc
  rw [affineResidueMultiplication_appTop_coord] at hc
  have hleft' : (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q n F x.coords).appTop
        ((universalRootRemainder (ZMod q) n g hg).coeff j)) =
      (tupleRootPolynomial n F x.coords %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff j := by
    change (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F x.coords).appTop
          ((universalRootRemainder (ZMod q) n g hg).coeff j)) = _ at hleft
    exact hleft
  calc
    _ = (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F x.coords).appTop
          ((universalRootRemainder (ZMod q) n g hg).coeff j)) := hleft'.symm
    _ = (Scheme.ΓSpecIso (.of F)).hom
        ((Spec.map (CommRingCat.ofHom
            (ZMod.castHom (m := q) dvd_rfl F))).appTop
          ((t ≫ residueUnitImmersion (ZMod q) m g).appTop
            (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) := hc
    _ = _ := zmodBaseChange_evaluate q F _

theorem residueUnitPointPolynomial_coeff_eq_zero_of_le
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) (k : ℕ) (hk : m ≤ k) :
    (residueUnitPointPolynomial q m g t).coeff k = 0 := by
  classical
  simp only [residueUnitPointPolynomial, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow]
  apply Finset.sum_eq_zero
  intro j _hj
  rw [if_neg]
  omega

/-- A rational point of the residue-unit coefficient space has nonzero
padded resultant with the modulus. -/
theorem residueUnitPointPolynomial_resultant_padded_ne_zero
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q))
    (t : ResidueUnitPoint (ZMod q) m g) :
    g.resultant (residueUnitPointPolynomial q m g t) m m ≠ 0 := by
  let a := t ≫ residueUnitImmersion (ZMod q) m g
  have hopen : a ⁻¹ᵁ ResidueUnitOpen (ZMod q) m g = ⊤ := by
    dsimp only [a]
    rw [Scheme.Hom.comp_preimage]
    unfold residueUnitImmersion
    rw [Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top]
  have hsection : a.appTop (residueUnitSection (ZMod q) m g) ≠ 0 := by
    intro hzero
    have hbasic : (Spec (.of (ZMod q))).basicOpen
        (a.appTop (residueUnitSection (ZMod q) m g)) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top]
      exact hopen
    rw [hzero, Scheme.basicOpen_zero] at hbasic
    exact bot_ne_top hbasic
  have himage : (Scheme.ΓSpecIso (.of (ZMod q))).hom
      (a.appTop (residueUnitSection (ZMod q) m g)) ≠ 0 := by
    intro h
    apply hsection
    have hinv := congrArg
      (fun x => (Scheme.ΓSpecIso (.of (ZMod q))).inv x) h
    simpa using hinv
  let ev := affineRootPointEvaluationHom q m (ZMod q) a
  have hevCoeff : ev.comp (rootCoefficientMap (ZMod q) m) =
      RingHom.id _ := by
    apply RingHom.ext
    intro c
    unfold ev affineRootPointEvaluationHom rootCoefficientMap
    change (Scheme.ΓSpecIso (.of (ZMod q))).hom
        (a.appTop
          ((AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))).appTop
            ((Scheme.ΓSpecIso (.of (ZMod q))).inv c))) = c
    change (Scheme.ΓSpecIso (.of (ZMod q))).hom
        ((((AffineRootSpace (ZMod q) m ↘ Spec (.of (ZMod q))).appTop ≫
          a.appTop) ((Scheme.ΓSpecIso (.of (ZMod q))).inv c))) = c
    have hover : a ≫ (AffineRootSpace (ZMod q) m ↘
        Spec (.of (ZMod q))) = 𝟙 _ := specZMod_hom_ext q _ _
    have happ := congrArg Scheme.Hom.appTop hover
    rw [Scheme.Hom.comp_appTop] at happ
    rw [happ]
    simp
  have hevg : (g.map (rootCoefficientMap (ZMod q) m)).map ev = g := by
    rw [Polynomial.map_map, hevCoeff]
    simp
  have hevResidue :
      (universalResiduePolynomial (ZMod q) m).map ev =
        residueUnitPointPolynomial q m g t := by
    unfold universalResiduePolynomial residueUnitPointPolynomial
    rw [Polynomial.map_sum]
    apply Finset.sum_congr rfl
    intro j _hj
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
      Polynomial.map_X]
    congr 2
  have heq : (Scheme.ΓSpecIso (.of (ZMod q))).hom
      (a.appTop (residueUnitSection (ZMod q) m g)) =
      g.resultant (residueUnitPointPolynomial q m g t) m m := by
    change ev (residueUnitSection (ZMod q) m g) = _
    unfold residueUnitSection
    rw [← Polynomial.resultant_map_map, hevg, hevResidue]
  rw [heq] at himage
  exact himage

/-- Removing the padding identifies the preceding determinant with the
ordinary resultant. -/
theorem residueUnitPointPolynomial_resultant_ne_zero
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m)
    (t : ResidueUnitPoint (ZMod q) m g) :
    g.resultant (residueUnitPointPolynomial q m g t) ≠ 0 := by
  let a := residueUnitPointPolynomial q m g t
  have ha : a.natDegree ≤ m := by
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro k hmk
    exact residueUnitPointPolynomial_coeff_eq_zero_of_le
      q m g t k (Nat.le_of_lt hmk)
  have hpad := Polynomial.resultant_add_right_deg
    (f := g) (g := a) (m := m) (n := a.natDegree)
    (k := m - a.natDegree) le_rfl
  have hmadd : a.natDegree + (m - a.natDegree) = m :=
    Nat.add_sub_of_le ha
  rw [hmadd] at hpad
  have hgcoeff : g.coeff m = 1 := by
    rw [← hdeg]
    exact hg.coeff_natDegree
  rw [hgcoeff, one_pow, one_mul] at hpad
  have hnonzero := residueUnitPointPolynomial_resultant_padded_ne_zero
    q m g t
  rw [hpad] at hnonzero
  change g.resultant a g.natDegree a.natDegree ≠ 0
  rw [hdeg]
  exact hnonzero

/-- Consequently every point of the residue-unit space literally
represents a polynomial coprime to the modulus. -/
theorem residueUnitPointPolynomial_isCoprime
    (q m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsCoprime g (residueUnitPointPolynomial q m g t) := by
  apply (isUnit_polynomialResidueClass_iff_isCoprime
    (ZMod q) g (residueUnitPointPolynomial q m g t)).mp
  apply (isUnit_polynomialResidueClass_iff_resultant_ne_zero
    (ZMod q) g (residueUnitPointPolynomial q m g t) hg).mpr
  exact residueUnitPointPolynomial_resultant_ne_zero q m g hg hdeg t

/-- Scalar extension of the scheme-theoretic fiber equation is exactly
the required polynomial congruence. -/
theorem fullResidueUnitFiberFixedTupleData_residue_polynomial_map
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) :
    tupleRootPolynomial n F x.coords %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      (residueUnitPointPolynomial q m g t).map
        (ZMod.castHom (m := q) dvd_rfl F) := by
  apply Polynomial.ext
  intro k
  by_cases hk : k < m
  · let j : Fin m := ⟨k, hk⟩
    simpa only [j, Polynomial.coeff_map] using
      fullResidueUnitFiberFixedTupleData_residue_coeff
        q n m F g hg hdeg hm hmn t σ x j
  · have hmk : m ≤ k := Nat.le_of_not_gt hk
    have hgmapdeg :
        (g.map (ZMod.castHom (m := q) dvd_rfl F)).degree =
          (m : WithBot ℕ) := by
      rw [Polynomial.degree_eq_natDegree (hg.map _).ne_zero,
        Polynomial.natDegree_map_eq_of_injective
          (ZMod.castHom (m := q) dvd_rfl F).injective, hdeg]
    have hleft : (tupleRootPolynomial n F x.coords %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff k = 0 := by
      apply Polynomial.coeff_eq_zero_of_degree_lt
      exact (Polynomial.degree_modByMonic_lt _ (hg.map _)).trans_le <| by
        rw [hgmapdeg]
        exact_mod_cast hmk
    rw [hleft, Polynomial.coeff_map,
      residueUnitPointPolynomial_coeff_eq_zero_of_le q m g t k hmk, map_zero]

/-- Descent through the injective prime-field embedding recovers the
congruence over `ZMod q` itself. -/
theorem fullResidueUnitFiberFixedTupleData_descended_mod_eq
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n))
    (x : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) :
    descendedTupleRootPolynomial q n F σ ⟨x.coords, x.twisted_fixed⟩ %ₘ g =
      residueUnitPointPolynomial q m g t := by
  apply Polynomial.map_injective
    (ZMod.castHom (m := q) dvd_rfl F)
    (ZMod.castHom (m := q) dvd_rfl F).injective
  rw [Polynomial.map_modByMonic _ hg,
    descendedTupleRootPolynomial_map]
  exact fullResidueUnitFiberFixedTupleData_residue_polynomial_map
    q n m F g hg hdeg hm hmn t σ x

/-- An injective fixed tuple for the three-cycle twist gives the exact
irreducible triple represented by the coefficient-space point. -/
noncomputable def FullResidueUnitFiberFixedTupleData.toCongruentIrreducibleTriple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d))
    (hxinj : Function.Injective x.coords) :
    CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t) :=
  threeBlockCongruentIrreducibleTriple q d hd F g
    (residueUnitPointPolynomial q m g t)
    ⟨x.coords, x.twisted_fixed⟩ hxinj
    (fullResidueUnitFiberFixedTupleData_descended_mod_eq
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d) x)

/-! ### The distinct-root configuration open -/

/-- Vandermonde section cutting out pairwise-distinct ordered roots. -/
noncomputable def rootDistinctSection
    (K : Type*) [CommRing K] (n : ℕ) :
    Γ(AffineRootSpace K n, ⊤) :=
  ∏ p ∈ (Finset.univ.filter (fun p : Fin n × Fin n => p.1 < p.2)),
    (AffineSpace.coord (Spec (.of K)) (ULift.up p.1) -
      AffineSpace.coord (Spec (.of K)) (ULift.up p.2))

/-- The configuration-space open of pairwise-distinct ordered roots. -/
noncomputable def DistinctRootOpen
    (K : Type*) [CommRing K] (n : ℕ) :
    (AffineRootSpace K n).Opens :=
  (AffineRootSpace K n).basicOpen (rootDistinctSection K n)

/-- Evaluation of the Vandermonde section on a literal tuple. -/
theorem rootTupleAffinePoint_rootDistinctSection
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] (y : Fin n → F) :
    (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          (rootDistinctSection (ZMod q) n)) =
      ∏ p ∈ (Finset.univ.filter (fun p : Fin n × Fin n => p.1 < p.2)),
        (y p.1 - y p.2) := by
  unfold rootDistinctSection
  simp only [map_prod, map_sub]
  apply Finset.prod_congr rfl
  intro p _hp
  congr 1
  · exact congrFun (rootTupleAffinePoint_coordinates q n F y) p.1
  · exact congrFun (rootTupleAffinePoint_coordinates q n F y) p.2

theorem rootDistinctProduct_ne_zero_iff_injective
    {F : Type*} [Field F] {n : ℕ} (y : Fin n → F) :
    (∏ p ∈ (Finset.univ.filter (fun p : Fin n × Fin n => p.1 < p.2)),
      (y p.1 - y p.2)) ≠ 0 ↔ Function.Injective y := by
  classical
  rw [Finset.prod_ne_zero_iff]
  constructor
  · intro h i j hij
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · have hp := h (i, j) (by simp [hlt])
      exact hp (sub_eq_zero.mpr hij)
    · have hp := h (j, i) (by simp [hgt])
      exact hp (sub_eq_zero.mpr hij.symm)
  · intro hinj p hp
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp
    exact sub_ne_zero.mpr (fun h => hp.ne (hinj h))

theorem rootTupleAffinePoint_rootDistinctSection_ne_zero_iff
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] (y : Fin n → F) :
    (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          (rootDistinctSection (ZMod q) n)) ≠ 0 ↔
      Function.Injective y := by
  rw [rootTupleAffinePoint_rootDistinctSection,
    rootDistinctProduct_ne_zero_iff_injective]

/-- An injective tuple factors through the distinct-root configuration open. -/
theorem rootTupleAffinePoint_preimage_distinctRootOpen_eq_top
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (hy : Function.Injective y) :
    rootTupleAffinePoint q n F y ⁻¹ᵁ DistinctRootOpen (ZMod q) n = ⊤ := by
  have hsimage : (Scheme.ΓSpecIso (.of F)).hom
      ((rootTupleAffinePoint q n F y).appTop
        (rootDistinctSection (ZMod q) n)) ≠ 0 :=
    (rootTupleAffinePoint_rootDistinctSection_ne_zero_iff q n F y).2 hy
  have hsunit : IsUnit ((rootTupleAffinePoint q n F y).appTop
      (rootDistinctSection (ZMod q) n)) := by
    have hu : IsUnit ((Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          (rootDistinctSection (ZMod q) n))) :=
      isUnit_iff_ne_zero.mpr hsimage
    have humap := hu.map (Scheme.ΓSpecIso (.of F)).inv.hom
    simpa using humap
  unfold DistinctRootOpen
  rw [Scheme.preimage_basicOpen_top]
  exact Scheme.basicOpen_of_isUnit (Spec (.of F)) hsunit

/-- The distinct-root configuration scheme. -/
noncomputable abbrev DistinctRootSpace
    (K : Type*) [CommRing K] (n : ℕ) : Scheme :=
  (DistinctRootOpen K n).toScheme

theorem affineRootPoint_rootDistinctSection
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (a : Spec (.of F) ⟶ AffineRootSpace (ZMod q) n) :
    (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (rootDistinctSection (ZMod q) n)) =
      ∏ p ∈ (Finset.univ.filter (fun p : Fin n × Fin n => p.1 < p.2)),
        (affineRootPointCoordinates (ZMod q) n a p.1 -
          affineRootPointCoordinates (ZMod q) n a p.2) := by
  unfold rootDistinctSection
  simp only [map_prod, map_sub]
  apply Finset.prod_congr rfl
  intro p _hp
  rfl

/-- Every geometric point of the configuration open has injective
coordinate tuple. -/
theorem distinctRootSpacePoint_coordinates_injective
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (z : Spec (.of F) ⟶ DistinctRootSpace (ZMod q) n) :
    Function.Injective
      (affineRootPointCoordinates (ZMod q) n
        (z ≫ (DistinctRootOpen (ZMod q) n).ι)) := by
  let a := z ≫ (DistinctRootOpen (ZMod q) n).ι
  have hopen : a ⁻¹ᵁ DistinctRootOpen (ZMod q) n = ⊤ := by
    dsimp only [a]
    rw [Scheme.Hom.comp_preimage,
      Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top]
  have hsection : a.appTop (rootDistinctSection (ZMod q) n) ≠ 0 := by
    intro hzero
    have hbasic : (Spec (.of F)).basicOpen
        (a.appTop (rootDistinctSection (ZMod q) n)) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top]
      exact hopen
    rw [hzero, Scheme.basicOpen_zero] at hbasic
    exact bot_ne_top hbasic
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootDistinctSection (ZMod q) n)) ≠ 0 := by
    intro h
    apply hsection
    have hinv := congrArg
      (fun x ↦ (Scheme.ΓSpecIso (.of F)).inv x) h
    simpa using hinv
  rw [affineRootPoint_rootDistinctSection,
    rootDistinctProduct_ne_zero_iff_injective] at himage
  exact himage

/-- A literal injective tuple gives a point of the distinct-root open. -/
noncomputable def rootTupleDistinctRootSpacePoint
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (hy : Function.Injective y) :
    Spec (.of F) ⟶ DistinctRootSpace (ZMod q) n := by
  apply IsOpenImmersion.lift (DistinctRootOpen (ZMod q) n).ι
    (rootTupleAffinePoint q n F y)
  intro z hz
  obtain ⟨w, rfl⟩ := hz
  rw [Scheme.Opens.range_ι]
  apply (rootTupleAffinePoint q n F y).mem_preimage.mp
  rw [rootTupleAffinePoint_preimage_distinctRootOpen_eq_top q n F y hy]
  trivial

@[reassoc (attr := simp)]
theorem rootTupleDistinctRootSpacePoint_ι
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (hy : Function.Injective y) :
    rootTupleDistinctRootSpacePoint q n F y hy ≫
        (DistinctRootOpen (ZMod q) n).ι =
      rootTupleAffinePoint q n F y := by
  unfold rootTupleDistinctRootSpacePoint
  exact IsOpenImmersion.lift_fac _ _ _

@[simp]
theorem rootTupleDistinctRootSpacePoint_coordinates
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (hy : Function.Injective y) :
    affineRootPointCoordinates (ZMod q) n
      (rootTupleDistinctRootSpacePoint q n F y hy ≫
        (DistinctRootOpen (ZMod q) n).ι) = y := by
  rw [rootTupleDistinctRootSpacePoint_ι,
    rootTupleAffinePoint_coordinates]

/-- Pairwise-distinct locus inside the root-avoidance space. -/
noncomputable def DistinctAvoidingRootOpen
    (K : Type*) [Field K] (n : ℕ) (g : Polynomial K) :
    (RootSpace K n g).Opens :=
  (RootSpaceOpen K n g).ι ⁻¹ᵁ DistinctRootOpen K n

noncomputable abbrev DistinctAvoidingRootSpace
    (K : Type*) [Field K] (n : ℕ) (g : Polynomial K) : Scheme :=
  (DistinctAvoidingRootOpen K n g).toScheme

/-- A literal avoiding injective tuple gives a point of the intersection
of the root-avoidance and distinct-root opens. -/
noncomputable def rootTupleDistinctAvoidingRootSpacePoint
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hy : Function.Injective y) :
    Spec (.of F) ⟶ DistinctAvoidingRootSpace (ZMod q) n g := by
  let z := rootTupleRootSpacePoint q n F y g havoid
  apply IsOpenImmersion.lift (DistinctAvoidingRootOpen (ZMod q) n g).ι z
  intro a ha
  obtain ⟨b, rfl⟩ := ha
  rw [Scheme.Opens.range_ι]
  apply z.mem_preimage.mp
  unfold DistinctAvoidingRootOpen
  rw [← Scheme.Hom.comp_preimage, rootTupleRootSpacePoint_ι,
    rootTupleAffinePoint_preimage_distinctRootOpen_eq_top q n F y hy]
  trivial

@[reassoc (attr := simp)]
theorem rootTupleDistinctAvoidingRootSpacePoint_ι
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hy : Function.Injective y) :
    rootTupleDistinctAvoidingRootSpacePoint
        q n F y g havoid hy ≫
        (DistinctAvoidingRootOpen (ZMod q) n g).ι =
      rootTupleRootSpacePoint q n F y g havoid := by
  unfold rootTupleDistinctAvoidingRootSpacePoint
  exact IsOpenImmersion.lift_fac _ _ _

@[simp]
theorem rootTupleDistinctAvoidingRootSpacePoint_coordinates
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (y : Fin n → F) (g : Polynomial (ZMod q))
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hy : Function.Injective y) :
    affineRootPointCoordinates (ZMod q) n
      (rootTupleDistinctAvoidingRootSpacePoint q n F y g havoid hy ≫
        (DistinctAvoidingRootOpen (ZMod q) n g).ι ≫
        (RootSpaceOpen (ZMod q) n g).ι) = y := by
  rw [← Category.assoc, rootTupleDistinctAvoidingRootSpacePoint_ι,
    rootTupleRootSpacePoint_coordinates]

/-! ### Universal-homeomorphism structure of twisted Frobenius -/

noncomputable instance affineRootPermutation_isIso
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    IsIso (affineRootPermutation K n σ) :=
  ⟨⟨affineRootPermutation K n σ.symm,
    affineRootPermutation_comp_symm K n σ,
    affineRootPermutation_symm_comp K n σ⟩⟩

theorem rootPermutation_comp_symm
    (K : Type u) [Field K] (n : ℕ) (g : Polynomial K)
    (σ : Equiv.Perm (Fin n)) :
    rootPermutation K n g σ ≫ rootPermutation K n g σ.symm = 𝟙 _ := by
  apply (cancel_mono (RootSpaceOpen K n g).ι).1
  rw [Category.assoc, rootPermutation_ι, ← Category.assoc,
    rootPermutation_ι, Category.assoc,
    affineRootPermutation_comp_symm, Category.comp_id,
    Category.id_comp]

theorem rootPermutation_symm_comp
    (K : Type u) [Field K] (n : ℕ) (g : Polynomial K)
    (σ : Equiv.Perm (Fin n)) :
    rootPermutation K n g σ.symm ≫ rootPermutation K n g σ = 𝟙 _ := by
  simpa only [Equiv.symm_symm] using
    rootPermutation_comp_symm K n g σ.symm

noncomputable instance rootPermutation_isIso
    (K : Type u) [Field K] (n : ℕ) (g : Polynomial K)
    (σ : Equiv.Perm (Fin n)) : IsIso (rootPermutation K n g σ) :=
  ⟨⟨rootPermutation K n g σ.symm,
    rootPermutation_comp_symm K n g σ,
    rootPermutation_symm_comp K n g σ⟩⟩

theorem fullResidueUnitFiberPermutation_comp_symm
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ ≫
        fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ.symm =
      𝟙 _ := by
  apply pullback.hom_ext
  · change (fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t σ.symm) ≫
      fullResidueUnitFiberToRootSpace
        K n m g hg hdeg hm hmn t =
      𝟙 _ ≫ fullResidueUnitFiberToRootSpace
        K n m g hg hdeg hm hmn t
    rw [Category.assoc,
      fullResidueUnitFiberPermutation_toRootSpace,
      ← Category.assoc,
      fullResidueUnitFiberPermutation_toRootSpace,
      Category.assoc, rootPermutation_comp_symm,
      Category.comp_id, Category.id_comp]
  · change (fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t σ.symm) ≫
      fullResidueUnitFiberProjection
        K n m g hg hdeg hm hmn t =
      𝟙 _ ≫ fullResidueUnitFiberProjection
        K n m g hg hdeg hm hmn t
    rw [Category.assoc,
      fullResidueUnitFiberPermutation_over,
      fullResidueUnitFiberPermutation_over,
      Category.id_comp]

theorem fullResidueUnitFiberPermutation_symm_comp
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ.symm ≫
        fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ =
      𝟙 _ := by
  simpa only [Equiv.symm_symm] using
    fullResidueUnitFiberPermutation_comp_symm
      K n m g hg hdeg hm hmn t σ.symm

noncomputable instance fullResidueUnitFiberPermutation_isIso
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ : Equiv.Perm (Fin n)) :
    IsIso (fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ) :=
  ⟨⟨fullResidueUnitFiberPermutation
      K n m g hg hdeg hm hmn t σ.symm,
    fullResidueUnitFiberPermutation_comp_symm
      K n m g hg hdeg hm hmn t σ,
    fullResidueUnitFiberPermutation_symm_comp
      K n m g hg hdeg hm hmn t σ⟩⟩

/-- The genuine action of a coordinate permutation on rational pro-étale
cohomology of the literal residue-unit fiber.  Unlike a coefficient
comparison, this action retains the geometric permutation through the
equivalence of small pro-étale sites. -/
noncomputable def fullResidueUnitFiberPermutationQEllAdicCohomologyAction
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n)) :
    (AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbULift
        (FullResidueUnitFiber
          (ZMod q) n m g hg hdeg hm hmn t) ℓ).H degree →+
      (AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbULift
        (FullResidueUnitFiber
          (ZMod q) n m g hg hdeg hm hmn t) ℓ).H degree :=
  AlgebraicGeometry.Scheme.ProEt.qEllAdicCohomologyPullbackEndomorphismOfIso
    (FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberPermutation
      (ZMod q) n m g hg hdeg hm hmn t σ) ℓ degree

theorem fullResidueUnitFiberPermutationQEllAdicCohomologyAction_scalar
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n)) (r : ℚ_[ℓ])
    (x : (AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbULift
      (FullResidueUnitFiber
        (ZMod q) n m g hg hdeg hm hmn t) ℓ).H degree) :
    fullResidueUnitFiberPermutationQEllAdicCohomologyAction
        q n m ℓ degree g hg hdeg hm hmn t σ
        (Sheaf.H.map
          (AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbScalarULift
            (FullResidueUnitFiber
              (ZMod q) n m g hg hdeg hm hmn t) ℓ r) degree x) =
      Sheaf.H.map
        (AlgebraicGeometry.Scheme.ProEt.qEllAdicSheafAbScalarULift
          (FullResidueUnitFiber
            (ZMod q) n m g hg hdeg hm hmn t) ℓ r) degree
        (fullResidueUnitFiberPermutationQEllAdicCohomologyAction
          q n m ℓ degree g hg hdeg hm hmn t σ x) := by
  exact
    AlgebraicGeometry.Scheme.ProEt.qEllAdicCohomologyPullbackEndomorphismOfIso_scalar
      (FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t)
      (fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ) ℓ degree r x

/-- The scalar-linear compact-support action of a coordinate permutation on
the literal residue-unit fiber, whenever the permutation extends across the
chosen proper compactification. -/
noncomputable def
    fullResidueUnitFiberPermutationQEllAdicCompactSupportLinearMap
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n))
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (hbar : fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ ≫ j = j ≫ fbar) :
    AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree :=
  AlgebraicGeometry.Scheme.ProEt.qEllAdicCompactSupportCohomologyLinearMapOfEquivariantIso
    j pbar
    (fullResidueUnitFiberPermutation
      (ZMod q) n m g hg hdeg hm hmn t σ)
    fbar hbar ℓ degree

/-- Basis-independent trace of the coordinate-permutation action on
compactly supported rational `ℓ`-adic cohomology. -/
noncomputable def
    fullResidueUnitFiberPermutationQEllAdicCompactSupportTrace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n))
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (hbar : fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ ≫ j = j ≫ fbar)
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree)] : ℚ_[ℓ] :=
  LinearMap.trace ℚ_[ℓ]
    (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
      j pbar ℓ degree)
    (fullResidueUnitFiberPermutationQEllAdicCompactSupportLinearMap
      q n m ℓ degree g hg hdeg hm hmn t σ Xbar S j pbar fbar hbar)

/-- The compact-support action of permutation-twisted Frobenius.  Pullback
is contravariant, so for the geometric composite `permutation ≫ Frobenius`
the Frobenius pullback is applied first and the permutation pullback second. -/
noncomputable def
    fullResidueUnitFiberTwistedQEllAdicCompactSupportLinearMap
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n))
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (hbar : fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ ≫ j = j ≫ fbar) :
    AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree :=
  (fullResidueUnitFiberPermutationQEllAdicCompactSupportLinearMap
      q n m ℓ degree g hg hdeg hm hmn t σ Xbar S j pbar fbar hbar).comp
    (fullResidueUnitFiberQEllAdicCompactSupportFrobeniusLinearMap
      q n m ℓ degree g hg hdeg hm hmn t Xbar S j pbar)

/-- Basis-independent trace of permutation-twisted Frobenius on the actual
compactly supported rational `ℓ`-adic cohomology of the residue fiber. -/
noncomputable def
    fullResidueUnitFiberTwistedQEllAdicCompactSupportTrace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n))
    (Xbar S : Scheme)
    (j : FullResidueUnitFiber
      (ZMod q) n m g hg hdeg hm hmn t ⟶ Xbar)
    (pbar : Xbar ⟶ S) [IsOpenImmersion j] [IsProper pbar]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (hbar : fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ ≫ j = j ≫ fbar)
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        j pbar ℓ degree)] : ℚ_[ℓ] :=
  LinearMap.trace ℚ_[ℓ]
    (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
      j pbar ℓ degree)
    (fullResidueUnitFiberTwistedQEllAdicCompactSupportLinearMap
      q n m ℓ degree g hg hdeg hm hmn t σ Xbar S j pbar fbar hbar)

theorem fullResidueUnitFiberFrobenius_integral
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    IsIntegralHom
      (fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t) := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affineSchemeFrobeniusOver_integral _ q _

theorem fullResidueUnitFiberFrobenius_surjective
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Surjective
      (fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t) := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affineSchemeFrobeniusOver_surjective _ q _

theorem fullResidueUnitFiberFrobenius_universallyInjective
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    UniversallyInjective
      (fullResidueUnitFiberFrobenius q n m g hg hdeg hm hmn t) := by
  rw [← affineSchemeFrobeniusOver_fullResidueUnitFiber_eq]
  exact affineSchemeFrobeniusOver_universallyInjective _ q _

theorem fullResidueUnitFiberTwistedFrobenius_integral
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    IsIntegralHom (fullResidueUnitFiberTwistedFrobenius
      q n m g hg hdeg hm hmn t σ) := by
  unfold fullResidueUnitFiberTwistedFrobenius
  let : IsIntegralHom (fullResidueUnitFiberFrobenius
      q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberFrobenius_integral q n m g hg hdeg hm hmn t
  infer_instance

theorem fullResidueUnitFiberTwistedFrobenius_surjective
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    Surjective (fullResidueUnitFiberTwistedFrobenius
      q n m g hg hdeg hm hmn t σ) := by
  unfold fullResidueUnitFiberTwistedFrobenius
  let : Surjective (fullResidueUnitFiberFrobenius
      q n m g hg hdeg hm hmn t) :=
    fullResidueUnitFiberFrobenius_surjective q n m g hg hdeg hm hmn t
  infer_instance

theorem fullResidueUnitFiberTwistedFrobenius_universallyInjective
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    UniversallyInjective (fullResidueUnitFiberTwistedFrobenius
      q n m g hg hdeg hm hmn t σ) := by
  unfold fullResidueUnitFiberTwistedFrobenius
  let : MorphismProperty.RespectsIso (@UniversallyInjective) :=
    UniversallyInjective.respectsIso
  rw [MorphismProperty.cancel_left_of_respectsIso @UniversallyInjective]
  exact fullResidueUnitFiberFrobenius_universallyInjective
    q n m g hg hdeg hm hmn t

/-- A permutation-twisted Frobenius is a universal homeomorphism on every
pro-étale base change. -/
theorem fullResidueUnitFiberTwistedFrobeniusBaseChangeIsHomeomorph
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    ∀ U : (FullResidueUnitFiber
        (ZMod q) n m g hg hdeg hm hmn t).ProEt,
      IsHomeomorph (pullback.fst U.hom
        (fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ)).base := by
  let := fullResidueUnitFiberTwistedFrobenius_integral
    q n m g hg hdeg hm hmn t σ
  let := fullResidueUnitFiberTwistedFrobenius_surjective
    q n m g hg hdeg hm hmn t σ
  let := fullResidueUnitFiberTwistedFrobenius_universallyInjective
    q n m g hg hdeg hm hmn t σ
  exact baseChangeIsHomeomorph_of_integral_surjective_universallyInjective _

/-! ### Injective fixed geometric points -/

/-- Twisted fixed geometric points whose ordered root coordinates are
pairwise distinct. -/
abbrev FullResidueUnitFiberInjectiveFixedPointData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :=
  {x : {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} //
    Function.Injective (fullResidueUnitFiberRootCoordinates
      q n m F g hg hdeg hm hmn t x.1)}

/-- Restricting the fixed-point/tuple equivalence to the distinct-root
locus gives exactly the injective tuple data used in the arithmetic map. -/
noncomputable def
    fullResidueUnitFiberInjectiveFixedPointEquivInjectiveTupleData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    FullResidueUnitFiberInjectiveFixedPointData
        q n m F g hg hdeg hm hmn t σ ≃
      {x : FullResidueUnitFiberFixedTupleData
          q n m F g hg hdeg hm hmn t σ //
        Function.Injective x.coords} := by
  let e := fullResidueUnitFiberFixedPointEquivTupleData
    q n m F g hg hdeg hm hmn t σ
  refine
    { toFun := fun x => ⟨e x.1, ?_⟩
      invFun := fun y => ⟨e.symm y.1, ?_⟩
      left_inv := ?_
      right_inv := ?_ }
  · exact x.2
  · change Function.Injective (e (e.symm y.1)).coords
    rw [e.apply_symm_apply]
    exact y.2
  · intro x
    apply Subtype.ext
    exact e.symm_apply_apply x.1
  · intro y
    apply Subtype.ext
    exact e.apply_symm_apply y.1

/-! ### Multiplicity of the fixed-tuple-to-prime-triple map -/

/-- The three initial coordinates of the Frobenius orbits in a fixed tuple. -/
noncomputable def threeBlockFixedTupleInitial
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d)) : Fin 3 → F :=
  fun b => x.coords (finProdFinEquiv (b, ⟨0, hd⟩))

/-- A fixed tuple is determined by the initial coordinate of each of its
three Frobenius orbits. -/
theorem threeBlockFixedTupleInitial_injective
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Function.Injective
      (threeBlockFixedTupleInitial q d m hd F g hg hdeg hm hmn t) := by
  intro x y hxy
  apply FullResidueUnitFiberFixedTupleData.ext
  funext i
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  let xf : {z : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) z = z} :=
    ⟨x.coords, x.twisted_fixed⟩
  let yf : {z : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) z = z} :=
    ⟨y.coords, y.twisted_fixed⟩
  have hx := threeBlockFixedBlock_eq_frobenius_iterate
    q d hd F xf b j
  have hy := threeBlockFixedBlock_eq_frobenius_iterate
    q d hd F yf b j
  change x.coords (finProdFinEquiv (b, j)) =
    (frobeniusEquiv F q)^[j.1]
      (x.coords (finProdFinEquiv (b, ⟨0, hd⟩))) at hx
  change y.coords (finProdFinEquiv (b, j)) =
    (frobeniusEquiv F q)^[j.1]
      (y.coords (finProdFinEquiv (b, ⟨0, hd⟩))) at hy
  rw [hx, hy]
  exact congrArg ((frobeniusEquiv F q)^[j.1]) (congrFun hxy b)

/-- Select one of the three irreducible factors in a represented triple. -/
noncomputable def congruentIrreducibleTripleFactor
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t) (b : Fin 3) :
    Polynomial (ZMod q) :=
  Fin.cases T.1.factor₁.1
    (Fin.cases T.1.factor₂.1 (fun _ => T.1.factor₃.1)) b

theorem threeBlockCongruentIrreducibleTriple_factor
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g t : Polynomial (ZMod q))
    (x : {x : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) x = x})
    (hxinj : Function.Injective x.1)
    (hmod : descendedTupleRootPolynomial q (3 * d) F
        (threeBlockCyclePermutation d) x %ₘ g = t)
    (b : Fin 3) :
    congruentIrreducibleTripleFactor q d g t
        (threeBlockCongruentIrreducibleTriple
          q d hd F g t x hxinj hmod) b =
      threeBlockDescendedFactor q d F x b := by
  fin_cases b <;> rfl

/-- Each initial Frobenius-orbit coordinate is a root of its represented
irreducible factor. -/
theorem threeBlockFixedTupleInitial_isRoot_factor
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d))
    (hxinj : Function.Injective x.coords) (b : Fin 3) :
    ((congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t)
      (x.toCongruentIrreducibleTriple q d m hd F g hg
        hdeg hm hmn t hxinj) b).map
        (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
      (threeBlockFixedTupleInitial q d m hd F g hg hdeg hm hmn t x b) := by
  let xf : {z : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) z = z} :=
    ⟨x.coords, x.twisted_fixed⟩
  unfold FullResidueUnitFiberFixedTupleData.toCongruentIrreducibleTriple
  rw [threeBlockCongruentIrreducibleTriple_factor]
  rw [threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd]
  rw [Polynomial.IsRoot, Polynomial.eval_prod]
  apply Finset.prod_eq_zero (i := ⟨0, hd⟩)
  · exact Finset.mem_univ _
  · simp [threeBlockFixedTupleInitial, threeBlockFixedBlock]

theorem congruentIrreducibleTripleFactor_monic
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t) (b : Fin 3) :
    (congruentIrreducibleTripleFactor q d g t T b).Monic := by
  fin_cases b
  · exact T.1.factor₁.monic
  · exact T.1.factor₂.monic
  · exact T.1.factor₃.monic

theorem congruentIrreducibleTripleFactor_natDegree
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t) (b : Fin 3) :
    (congruentIrreducibleTripleFactor q d g t T b).natDegree = d := by
  fin_cases b
  · exact T.1.factor₁.natDegree
  · exact T.1.factor₂.natDegree
  · exact T.1.factor₃.natDegree

abbrev ThreeBlockInjectiveFixedTupleData
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :=
  {x : FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d) //
    Function.Injective x.coords}

/-- The arithmetic triple represented by an injective fixed tuple. -/
noncomputable def threeBlockInjectiveFixedTupleToTriple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    ThreeBlockInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t →
      CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t) :=
  fun x => x.1.toCongruentIrreducibleTriple
    q d m hd F g hg hdeg hm hmn t x.2

/-- The three chosen roots attached to a point in a fiber of the
fixed-tuple-to-triple map. -/
noncomputable def threeBlockFixedTupleFiberInitialRoots
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (x : {x : ThreeBlockInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T}) :
    ∀ b : Fin 3,
      (congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet F := by
  intro b
  refine ⟨threeBlockFixedTupleInitial
    q d m hd F g hg hdeg hm hmn t x.1.1 b, ?_⟩
  rw [(congruentIrreducibleTripleFactor_monic q d g
    (residueUnitPointPolynomial q m g t) T b).mem_rootSet]
  have hroot := threeBlockFixedTupleInitial_isRoot_factor
    q d m hd F g hg hdeg hm hmn t x.1.1 x.1.2 b
  have hT := x.2
  unfold threeBlockInjectiveFixedTupleToTriple at hT
  rw [hT] at hroot
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

theorem threeBlockFixedTupleFiberInitialRoots_injective
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    Function.Injective
      (threeBlockFixedTupleFiberInitialRoots
        q d m hd F g hg hdeg hm hmn t T) := by
  intro x y hxy
  apply Subtype.ext
  apply Subtype.ext
  apply threeBlockFixedTupleInitial_injective
    q d m hd F g hg hdeg hm hmn t
  funext b
  exact congrArg Subtype.val (congrFun hxy b)

/-! ### Exact multiplicity of the fixed-tuple parametrization -/

noncomputable def threeBlockRootChoiceCoords
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (roots : Fin 3 → F) : Fin (3 * d) → F :=
  fun i =>
    let bj := finProdFinEquiv.symm i
    (frobeniusEquiv F q)^[bj.2.1] (roots bj.1)

@[simp]
theorem threeBlockRootChoiceCoords_apply
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (roots : Fin 3 → F) (b : Fin 3) (j : Fin d) :
    threeBlockRootChoiceCoords q d F roots (finProdFinEquiv (b, j)) =
      (frobeniusEquiv F q)^[j.1] (roots b) := by
  simp [threeBlockRootChoiceCoords]

theorem threeBlockRootChoiceCoords_twisted_fixed
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (T : Fin 3 → Polynomial (ZMod q))
    (hTirr : ∀ b, Irreducible (T b))
    (hTdeg : ∀ b, (T b).natDegree = d)
    (roots : ∀ b, (T b).rootSet F) :
    twistedTupleFrobenius q (3 * d) F (threeBlockCyclePermutation d)
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)) =
      threeBlockRootChoiceCoords q d F (fun b => (roots b).1) := by
  obtain ⟨e, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hd)
  apply (twistedTupleFrobenius_fixed_iff q (3 * (e + 1)) F
    (threeBlockCyclePermutation (e + 1)) _).2
  intro i
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  rw [threeBlockCyclePermutation_apply]
  simp only [threeBlockRootChoiceCoords_apply, frobeniusEquiv_def]
  by_cases hj : j = 0
  · subst j
    have hpred : ((finRotate (e + 1)).symm (0 : Fin (e + 1))).1 = e := by
      rw [finRotate_symm_apply]
      exact Fin.coe_neg_one
    change frobeniusEquiv F q
        ((frobeniusEquiv F q)^[((finRotate (e + 1)).symm
          (0 : Fin (e + 1))).1] (roots b).1) = (roots b).1
    rw [← Function.iterate_succ_apply' (frobeniusEquiv F q), hpred]
    exact irreducibleRoot_frobenius_iterate_natDegree
      q (e + 1) F (T b) (hTirr b) (hTdeg b) (roots b)
  · have hpred : ((finRotate (e + 1)).symm j).1 = j.1 - 1 :=
      coe_finRotate_symm_of_ne_zero hj
    have hjpos : 0 < j.1 := Fin.pos_iff_ne_zero.mpr hj
    change frobeniusEquiv F q
        ((frobeniusEquiv F q)^[((finRotate (e + 1)).symm j).1]
          (roots b).1) =
      (frobeniusEquiv F q)^[j.1] (roots b).1
    rw [← Function.iterate_succ_apply' (frobeniusEquiv F q), hpred]
    congr 2
    omega

theorem congruentIrreducibleTripleFactor_isCoprime
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t)
    {b c : Fin 3} (hbc : b ≠ c) :
    IsCoprime
      (congruentIrreducibleTripleFactor q d g t T b)
      (congruentIrreducibleTripleFactor q d g t T c) := by
  fin_cases b <;> fin_cases c <;> simp at hbc
  · exact T.1.coprime₁₂
  · exact T.1.coprime₁₃
  · exact T.1.coprime₁₂.symm
  · exact T.1.coprime₂₃
  · exact T.1.coprime₁₃.symm
  · exact T.1.coprime₂₃.symm

theorem threeBlockRootChoiceCoords_factor_aeval
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t)
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g t T b).rootSet F)
    (b : Fin 3) (j : Fin d) :
    Polynomial.aeval
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)
          (finProdFinEquiv (b, j)))
        (congruentIrreducibleTripleFactor q d g t T b) = 0 := by
  let p := congruentIrreducibleTripleFactor q d g t T b
  have hfac := irreducible_map_eq_prod_frobeniusOrbit q d F p
    (congruentIrreducibleTripleFactor_monic q d g t T b)
    (by
      dsimp only [p]
      fin_cases b
      · exact T.2.1
      · exact T.2.2.1
      · exact T.2.2.2)
    (congruentIrreducibleTripleFactor_natDegree q d g t T b)
    (roots b)
  have hroot : (p.map (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
      ((frobeniusEquiv F q)^[j.1] (roots b).1) := by
    rw [hfac, Polynomial.IsRoot, Polynomial.eval_prod]
    apply Finset.prod_eq_zero (i := j)
    · exact Finset.mem_univ j
    · simp
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  rw [threeBlockRootChoiceCoords_apply]
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

theorem threeBlockRootChoiceCoords_injective
    (q d : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t)
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g t T b).rootSet F) :
    Function.Injective
      (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)) := by
  intro i k hik
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  obtain ⟨⟨c, l⟩, rfl⟩ := finProdFinEquiv.surjective k
  suffices (b, j) = (c, l) by exact congrArg finProdFinEquiv this
  by_cases hbc : b = c
  · subst c
    congr 1
    apply (irreducibleRoot_frobeniusOrbit_injective q d F
      (congruentIrreducibleTripleFactor q d g t T b)
      (by
        fin_cases b
        · exact T.2.1
        · exact T.2.2.1
        · exact T.2.2.2)
      (congruentIrreducibleTripleFactor_natDegree q d g t T b)
      (roots b))
    simpa only [threeBlockRootChoiceCoords_apply] using hik
  · exfalso
    have hbzero := threeBlockRootChoiceCoords_factor_aeval
      q d F g t T roots b j
    have hczero := threeBlockRootChoiceCoords_factor_aeval
      q d F g t T roots c l
    have hcop := aeval_ne_zero_of_isCoprime
      (congruentIrreducibleTripleFactor_isCoprime q d g t T hbc)
      (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)
        (finProdFinEquiv (b, j)))
    have hczero' : Polynomial.aeval
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)
          (finProdFinEquiv (b, j)))
        (congruentIrreducibleTripleFactor q d g t T c) = 0 := by
      rw [hik]
      exact hczero
    exact hcop.elim (fun h => h hbzero) (fun h => h hczero')

theorem congruentIrreducibleTriple_prod_factor
    (q d : ℕ) [Fact q.Prime] (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t) :
    (∏ b : Fin 3, congruentIrreducibleTripleFactor q d g t T b) =
      T.1.factor₁.1 * T.1.factor₂.1 * T.1.factor₃.1 := by
  simp [congruentIrreducibleTripleFactor, Fin.prod_univ_succ, mul_assoc]

theorem threeBlockRootChoiceCoords_avoids
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (_hg : g.Monic)
    (hgt : IsCoprime g t)
    (T : CongruentIrreducibleTriple q d g t)
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g t T b).rootSet F) :
    ∀ i : Fin (3 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F)
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1) i) g ≠ 0 := by
  intro i hgeval
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  let z := threeBlockRootChoiceCoords q d F
    (fun b => (roots b).1) (finProdFinEquiv (b, j))
  let P := ∏ c : Fin 3, congruentIrreducibleTripleFactor q d g t T c
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  have hgzero : Polynomial.aeval z g = 0 := by
    simpa [Polynomial.aeval_def, hι, z] using hgeval
  have hbzero := threeBlockRootChoiceCoords_factor_aeval
    q d F g t T roots b j
  have hPzero : Polynomial.aeval z P = 0 := by
    dsimp only [P]
    rw [map_prod]
    apply Finset.prod_eq_zero (i := b)
    · exact Finset.mem_univ b
    · exact hbzero
  have hremzero : Polynomial.aeval z (P %ₘ g) = 0 := by
    have hdiv := congrArg (Polynomial.aeval z)
      (Polynomial.modByMonic_add_div P g)
    simp only [map_add, map_mul, hgzero, zero_mul, add_zero, hPzero] at hdiv
    exact hdiv
  have hprodmod : P %ₘ g = t := by
    dsimp only [P]
    rw [congruentIrreducibleTriple_prod_factor q d g t T]
    simpa using T.1.product_mod
  have htzero : Polynomial.aeval z t = 0 := by
    rw [← hprodmod]
    exact hremzero
  exact (aeval_ne_zero_of_isCoprime hgt z).elim
    (fun h => h hgzero) (fun h => h htzero)

theorem fullResidueUnitFiber_residue_condition_of_mod_eq
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (y : Fin n → F)
    (havoid : ∀ i : Fin n,
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hmod : tupleRootPolynomial n F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      (residueUnitPointPolynomial q m g t).map
        (ZMod.castHom (m := q) dvd_rfl F)) :
    rootTupleRootSpacePoint q n F y g havoid ≫
        fullResidueMultiplicationToUnit
          (ZMod q) n m g hg hdeg hm hmn =
      Spec.map (CommRingCat.ofHom
        (ZMod.castHom (m := q) dvd_rfl F)) ≫ t := by
  let : IsOpenImmersion (residueUnitImmersion (ZMod q) m g) := by
    unfold residueUnitImmersion
    infer_instance
  apply (cancel_mono (residueUnitImmersion (ZMod q) m g)).1
  simp only [Category.assoc]
  rw [fullResidueMultiplicationToUnit_fac]
  unfold residueMultiplication
  rw [← Category.assoc, rootTupleRootSpacePoint_ι]
  apply AffineSpace.hom_ext
  · exact specToZMod_hom_ext q F _ _
  · intro i
    rcases i with ⟨j⟩
    apply (Scheme.ΓSpecIso (.of F)).commRingCatIsoToRingEquiv.injective
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop,
      Scheme.Hom.comp_appTop]
    change (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q n F y).appTop
          ((affineResidueMultiplication (ZMod q) n m g hg).appTop
            (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) =
      (Scheme.ΓSpecIso (.of F)).hom
        ((Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F))).appTop
          ((t ≫ residueUnitImmersion (ZMod q) m g).appTop
            (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j))))
    rw [affineResidueMultiplication_appTop_coord]
    have hleft := congrArg (fun p : Polynomial F => p.coeff j)
      (rootTupleAffinePoint_universalRootRemainder q n m F y g hg)
    rw [Polynomial.coeff_map] at hleft
    have hcoeff := congrArg (fun p : Polynomial F => p.coeff j) hmod
    rw [Polynomial.coeff_map] at hcoeff
    rw [residueUnitPointPolynomial_coeff] at hcoeff
    rw [zmodBaseChange_evaluate q F]
    exact hleft.trans hcoeff

theorem threeBlockRootChoiceCoords_rootPolynomial
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q))
    (T : CongruentIrreducibleTriple q d g t)
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g t T b).rootSet F) :
    tupleRootPolynomial (3 * d) F
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)) =
      (∏ b : Fin 3,
        congruentIrreducibleTripleFactor q d g t T b).map
          (ZMod.castHom (m := q) dvd_rfl F) := by
  classical
  have hirr : ∀ b : Fin 3, Irreducible
      (congruentIrreducibleTripleFactor q d g t T b) := by
    intro b
    fin_cases b
    · exact T.2.1
    · exact T.2.2.1
    · exact T.2.2.2
  have hfactor : ∀ b : Fin 3,
      (congruentIrreducibleTripleFactor q d g t T b).map
          (ZMod.castHom (m := q) dvd_rfl F) =
        ∏ j : Fin d, (Polynomial.X - Polynomial.C
          ((frobeniusEquiv F q)^[j.1] (roots b).1)) := by
    intro b
    exact irreducible_map_eq_prod_frobeniusOrbit q d F
      (congruentIrreducibleTripleFactor q d g t T b)
      (congruentIrreducibleTripleFactor_monic q d g t T b)
      (hirr b)
      (congruentIrreducibleTripleFactor_natDegree q d g t T b)
      (roots b)
  rw [Polynomial.map_prod]
  simp_rw [hfactor]
  unfold tupleRootPolynomial
  change (∏ i : Fin (3 * d),
      (Polynomial.X - Polynomial.C
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1) i))) =
    ∏ b : Fin 3, ∏ j : Fin d,
      (Polynomial.X - Polynomial.C
        ((frobeniusEquiv F q)^[j.1] (roots b).1))
  rw [← Finset.prod_product' Finset.univ Finset.univ]
  rw [Finset.univ_product_univ]
  calc
    _ = ∏ p : Fin 3 × Fin d,
        (Polynomial.X - Polynomial.C
          (threeBlockRootChoiceCoords q d F
            (fun b => (roots b).1) (finProdFinEquiv p))) :=
      (Equiv.prod_comp (finProdFinEquiv (m := 3) (n := d))
        (fun i => Polynomial.X - Polynomial.C
          (threeBlockRootChoiceCoords q d F
            (fun b => (roots b).1) i))).symm
    _ = _ := by
      apply Finset.prod_congr rfl
      intro p _hp
      rcases p with ⟨b, j⟩
      rw [threeBlockRootChoiceCoords_apply]

theorem threeBlockRootChoiceCoords_mod
    (q d : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (T : CongruentIrreducibleTriple q d g t)
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g t T b).rootSet F) :
    tupleRootPolynomial (3 * d) F
        (threeBlockRootChoiceCoords q d F (fun b => (roots b).1)) %ₘ
          g.map (ZMod.castHom (m := q) dvd_rfl F) =
      t.map (ZMod.castHom (m := q) dvd_rfl F) := by
  rw [threeBlockRootChoiceCoords_rootPolynomial q d F g t T roots]
  rw [← Polynomial.map_modByMonic _ hg]
  rw [congruentIrreducibleTriple_prod_factor q d g t T]
  simpa using congrArg
    (Polynomial.map (ZMod.castHom (m := q) dvd_rfl F)) T.1.product_mod

noncomputable def threeBlockRootChoicesToFixedTuple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet F) :
    ThreeBlockInjectiveFixedTupleData
      q d m F g hg hdeg hm hmn t := by
  let r := residueUnitPointPolynomial q m g t
  let y := threeBlockRootChoiceCoords q d F (fun b => (roots b).1)
  have hirr : ∀ b : Fin 3, Irreducible
      (congruentIrreducibleTripleFactor q d g r T b) := by
    intro b
    fin_cases b
    · exact T.2.1
    · exact T.2.2.1
    · exact T.2.2.2
  have hyavoid : ∀ i : Fin (3 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0 := by
    exact threeBlockRootChoiceCoords_avoids q d F g r hg
      (residueUnitPointPolynomial_isCoprime q m g hg hdeg t) T roots
  have hymod : tupleRootPolynomial (3 * d) F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      r.map (ZMod.castHom (m := q) dvd_rfl F) := by
    exact threeBlockRootChoiceCoords_mod q d F g r hg T roots
  have hytwist : twistedTupleFrobenius q (3 * d) F
      (threeBlockCyclePermutation d) y = y := by
    exact threeBlockRootChoiceCoords_twisted_fixed q d hd F
      (fun b => congruentIrreducibleTripleFactor q d g r T b)
      hirr
      (fun b => congruentIrreducibleTripleFactor_natDegree q d g r T b)
      roots
  have hyinj : Function.Injective y := by
    exact threeBlockRootChoiceCoords_injective q d hd F g r T roots
  refine ⟨{
    coords := y
    avoids := hyavoid
    residue_condition := ?_
    twisted_fixed := hytwist }, hyinj⟩
  exact fullResidueUnitFiber_residue_condition_of_mod_eq
    q (3 * d) m F g hg hdeg hm hmn t y hyavoid hymod

theorem threeBlockRootChoicesToFixedTuple_factor
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet F)
    (b : Fin 3) :
    congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t)
        (threeBlockInjectiveFixedTupleToTriple
          q d m hd F g hg hdeg hm hmn t
          (threeBlockRootChoicesToFixedTuple
            q d m hd F g hg hdeg hm hmn t T roots)) b =
      congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b := by
  apply Polynomial.map_injective
    (ZMod.castHom (m := q) dvd_rfl F)
    (ZMod.castHom (m := q) dvd_rfl F).injective
  unfold threeBlockInjectiveFixedTupleToTriple
  unfold FullResidueUnitFiberFixedTupleData.toCongruentIrreducibleTriple
  rw [threeBlockCongruentIrreducibleTriple_factor]
  rw [threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd]
  rw [irreducible_map_eq_prod_frobeniusOrbit q d F
    (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b)
    (congruentIrreducibleTripleFactor_monic q d g
      (residueUnitPointPolynomial q m g t) T b)
    (show Irreducible (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b) by
        fin_cases b
        · exact T.2.1
        · exact T.2.2.1
        · exact T.2.2.2)
    (congruentIrreducibleTripleFactor_natDegree q d g
      (residueUnitPointPolynomial q m g t) T b)
    (roots b)]
  apply Finset.prod_congr rfl
  intro j _hj
  congr 3
  unfold threeBlockFixedBlock threeBlockRootChoicesToFixedTuple
  simp only [threeBlockRootChoiceCoords_apply, coe_frobeniusEquiv, Function.iterate_zero, id_eq]
  rw [Equiv.symm_apply_apply]

theorem threeBlockRootChoicesToFixedTuple_toTriple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t))
    (roots : ∀ b, (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet F) :
    threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t
        (threeBlockRootChoicesToFixedTuple
          q d m hd F g hg hdeg hm hmn t T roots) = T := by
  apply Subtype.ext
  apply CongruentPairwiseCoprimeTriple.ext
  · apply Subtype.ext
    exact threeBlockRootChoicesToFixedTuple_factor
      q d m hd F g hg hdeg hm hmn t T roots 0
  · apply Subtype.ext
    exact threeBlockRootChoicesToFixedTuple_factor
      q d m hd F g hg hdeg hm hmn t T roots 1
  · apply Subtype.ext
    exact threeBlockRootChoicesToFixedTuple_factor
      q d m hd F g hg hdeg hm hmn t T roots 2

noncomputable def threeBlockFixedTupleFiberEquivRoots
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    {x : ThreeBlockInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} ≃
      ∀ b : Fin 3, (congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet F where
  toFun := threeBlockFixedTupleFiberInitialRoots
    q d m hd F g hg hdeg hm hmn t T
  invFun roots :=
    ⟨threeBlockRootChoicesToFixedTuple
      q d m hd F g hg hdeg hm hmn t T roots,
      threeBlockRootChoicesToFixedTuple_toTriple
        q d m hd F g hg hdeg hm hmn t T roots⟩
  left_inv x := by
    apply Subtype.ext
    apply Subtype.ext
    apply threeBlockFixedTupleInitial_injective
      q d m hd F g hg hdeg hm hmn t
    funext b
    simp [threeBlockFixedTupleInitial,
      threeBlockFixedTupleFiberInitialRoots,
      threeBlockRootChoicesToFixedTuple,
      threeBlockRootChoiceCoords]
  right_inv roots := by
    funext b
    apply Subtype.ext
    simp [threeBlockFixedTupleFiberInitialRoots,
      threeBlockFixedTupleInitial,
      threeBlockRootChoicesToFixedTuple,
      threeBlockRootChoiceCoords]
    rw [Equiv.symm_apply_apply]

theorem threeBlockInjectiveFixedTupleToTriple_fiber_card_eq
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    Nat.card {x : ThreeBlockInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} = d ^ 3 := by
  classical
  let P : Fin 3 → Type := fun b =>
    (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet F
  let (b : Fin 3) : Finite (P b) :=
    ((congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet_finite F).to_subtype
  have hP : ∀ b, Nat.card (P b) = d := by
    intro b
    let p := congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b
    have hpirr : Irreducible p := by
      dsimp only [p]
      fin_cases b
      · exact T.2.1
      · exact T.2.2.1
      · exact T.2.2.2
    change Nat.card (p.rootSet F) = d
    calc
      Nat.card (p.rootSet F) = (p.rootSet F).ncard :=
        Nat.card_coe_set_eq _
      _ = Fintype.card (p.rootSet F) :=
        (Set.fintypeCard_eq_ncard (p.rootSet F)).symm
      _ = p.natDegree := Polynomial.card_rootSet_eq_natDegree
        (F := ZMod q) (K := F)
        (PerfectField.separable_of_irreducible hpirr)
        (IsAlgClosed.splits _)
      _ = d := congruentIrreducibleTripleFactor_natDegree q d g
        (residueUnitPointPolynomial q m g t) T b
  calc
    Nat.card {x : ThreeBlockInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} =
        Nat.card (∀ b, P b) := Nat.card_congr
          (threeBlockFixedTupleFiberEquivRoots
            q d m hd F g hg hdeg hm hmn t T)
    _ = ∏ b, Nat.card (P b) := Nat.card_pi
    _ = ∏ _ : Fin 3, d := by
      apply Finset.prod_congr rfl
      intro b _hb
      exact hP b
    _ = d ^ 3 := by simp [pow_succ]

theorem threeBlockInjectiveFixedTuple_card_eq_triple_card
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Nat.card (ThreeBlockInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) =
      d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
  classical
  let f := threeBlockInjectiveFixedTupleToTriple
    q d m hd F g hg hdeg hm hmn t
  let : Finite (CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  let : Fintype (CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) := Fintype.ofFinite _
  let (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
      Finite {x // f x = T} := by
    let P : Fin 3 → Type := fun b =>
      (congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet F
    let (b : Fin 3) : Finite (P b) :=
      ((congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet_finite F).to_subtype
    exact Finite.of_equiv (∀ b, P b)
      (threeBlockFixedTupleFiberEquivRoots
        q d m hd F g hg hdeg hm hmn t T).symm
  calc
    Nat.card (ThreeBlockInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) =
        Nat.card (Σ T, {x // f x = T}) :=
      (Nat.card_congr (Equiv.sigmaFiberEquiv f)).symm
    _ = ∑ T, Nat.card {x // f x = T} := Nat.card_sigma
    _ = ∑ _ : CongruentIrreducibleTriple q d g
          (residueUnitPointPolynomial q m g t), d ^ 3 := by
      apply Finset.sum_congr rfl
      intro T _hT
      exact threeBlockInjectiveFixedTupleToTriple_fiber_card_eq
        q d m hd F g hg hdeg hm hmn t T
    _ = d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
      simp [Nat.card_eq_fintype_card, Nat.mul_comm]

/-- Every represented irreducible triple has at most `d ^ 3` preimages,
one choice of a root in each of its three degree-`d` factors. -/
theorem threeBlockInjectiveFixedTupleToTriple_fiber_card_le
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
    Nat.card {x : ThreeBlockInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} ≤ d ^ 3 := by
  classical
  let P : Fin 3 → Type := fun b =>
    (congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet F
  have hPfinite : ∀ b, Finite (P b) := by
    intro b
    exact ((congruentIrreducibleTripleFactor q d g
      (residueUnitPointPolynomial q m g t) T b).rootSet_finite F).to_subtype
  let (b : Fin 3) : Finite (P b) := hPfinite b
  calc
    Nat.card {x : ThreeBlockInjectiveFixedTupleData
          q d m F g hg hdeg hm hmn t //
      threeBlockInjectiveFixedTupleToTriple
        q d m hd F g hg hdeg hm hmn t x = T} ≤
        Nat.card (∀ b, P b) :=
      Nat.card_le_card_of_injective
        (threeBlockFixedTupleFiberInitialRoots
          q d m hd F g hg hdeg hm hmn t T)
        (threeBlockFixedTupleFiberInitialRoots_injective
          q d m hd F g hg hdeg hm hmn t T)
    _ = ∏ b, Nat.card (P b) := Nat.card_pi
    _ ≤ ∏ _ : Fin 3, d := by
      apply Finset.prod_le_prod
      · intro b hb
        exact Nat.zero_le _
      · intro b hb
        rw [Nat.card_coe_set_eq]
        exact (Polynomial.ncard_rootSet_le
          (congruentIrreducibleTripleFactor q d g
            (residueUnitPointPolynomial q m g t) T b) F).trans_eq
          (congruentIrreducibleTripleFactor_natDegree q d g
            (residueUnitPointPolynomial q m g t) T b)
    _ = d ^ 3 := by simp [pow_succ]

/-- Globally, injective fixed tuples are at most `d ^ 3` times as numerous
as the represented ordered irreducible triples. -/
theorem threeBlockInjectiveFixedTuple_card_le_triple_card
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Nat.card (ThreeBlockInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) ≤
      d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
  classical
  let f := threeBlockInjectiveFixedTupleToTriple
    q d m hd F g hg hdeg hm hmn t
  let : Finite (CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  let : Fintype (CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) := Fintype.ofFinite _
  let (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
      Finite {x // f x = T} := by
    let P : Fin 3 → Type := fun b =>
      (congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet F
    let (b : Fin 3) : Finite (P b) :=
      ((congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet_finite F).to_subtype
    exact Finite.of_injective
      (threeBlockFixedTupleFiberInitialRoots
        q d m hd F g hg hdeg hm hmn t T)
      (threeBlockFixedTupleFiberInitialRoots_injective
        q d m hd F g hg hdeg hm hmn t T)
  calc
    Nat.card (ThreeBlockInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) =
        Nat.card (Σ T, {x // f x = T}) :=
      (Nat.card_congr (Equiv.sigmaFiberEquiv f)).symm
    _ = ∑ T, Nat.card {x // f x = T} := Nat.card_sigma
    _ ≤ ∑ _ : CongruentIrreducibleTriple q d g
          (residueUnitPointPolynomial q m g t), d ^ 3 := by
      apply Finset.sum_le_sum
      intro T hT
      exact threeBlockInjectiveFixedTupleToTriple_fiber_card_le
        q d m hd F g hg hdeg hm hmn t T
    _ = d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
      simp [Nat.card_eq_fintype_card, Nat.mul_comm]

/-- In the three-cycle specialization, the distinct geometric fixed points
and the injective fixed tuples have the same cardinality. -/
theorem threeBlockInjectiveFixedPoint_natCard_eq_fixedTuple
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Nat.card (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) =
      Nat.card (ThreeBlockInjectiveFixedTupleData
        q d m F g hg hdeg hm hmn t) :=
  Nat.card_congr
    (fullResidueUnitFiberInjectiveFixedPointEquivInjectiveTupleData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d))

/-- Over an algebraic closure, the distinct fixed-point locus has exactly
`d ^ 3` geometric points above every represented ordered irreducible
triple.  This is the literal fixed-point multiplicity occurring in the
three-cycle Grothendieck--Lefschetz trace. -/
theorem threeBlockInjectiveFixedPoint_card_eq_triple_card
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Nat.card (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) =
      d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
  rw [threeBlockInjectiveFixedPoint_natCard_eq_fixedTuple
    q d m hd F g hg hdeg hm hmn t]
  exact threeBlockInjectiveFixedTuple_card_eq_triple_card
    q d m hd F g hg hdeg hm hmn t

/-- The fixed-point side of the distinct-root trace is at most `d ^ 3`
times the represented ordered irreducible-triple count. -/
theorem threeBlockInjectiveFixedPoint_card_le_triple_card
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Nat.card (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) ≤
      d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) := by
  rw [threeBlockInjectiveFixedPoint_natCard_eq_fixedTuple
    q d m hd F g hg hdeg hm hmn t]
  exact threeBlockInjectiveFixedTuple_card_le_triple_card
    q d m hd F g hg hdeg hm hmn t

/-- The injective fixed-tuple type is finite even when the ambient
geometric field is infinite: decompose it into the finite arithmetic
triple type and the finite fibers bounded above. -/
theorem finiteThreeBlockInjectiveFixedTupleData
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Finite (ThreeBlockInjectiveFixedTupleData
      q d m F g hg hdeg hm hmn t) := by
  let f := threeBlockInjectiveFixedTupleToTriple
    q d m hd F g hg hdeg hm hmn t
  let : Finite (CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  let (T : CongruentIrreducibleTriple q d g
      (residueUnitPointPolynomial q m g t)) :
      Finite {x // f x = T} := by
    let P : Fin 3 → Type := fun b =>
      (congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet F
    let (b : Fin 3) : Finite (P b) :=
      ((congruentIrreducibleTripleFactor q d g
        (residueUnitPointPolynomial q m g t) T b).rootSet_finite F).to_subtype
    exact Finite.of_injective
      (threeBlockFixedTupleFiberInitialRoots
        q d m hd F g hg hdeg hm hmn t T)
      (threeBlockFixedTupleFiberInitialRoots_injective
        q d m hd F g hg hdeg hm hmn t T)
  exact Finite.of_equiv (Σ T, {x // f x = T})
    (Equiv.sigmaFiberEquiv f)

/-- The corresponding distinct geometric fixed-point type is finite. -/
theorem finiteThreeBlockInjectiveFixedPointData
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Finite (FullResidueUnitFiberInjectiveFixedPointData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)) := by
  let : Finite (ThreeBlockInjectiveFixedTupleData
      q d m F g hg hdeg hm hmn t) :=
    finiteThreeBlockInjectiveFixedTupleData
      q d m hd F g hg hdeg hm hmn t
  exact Finite.of_injective
    (fullResidueUnitFiberInjectiveFixedPointEquivInjectiveTupleData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d))
    (fullResidueUnitFiberInjectiveFixedPointEquivInjectiveTupleData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)).injective

/-- The initial coordinate of every fixed Frobenius block is a root of its
degree-`d` descended factor, without any distinctness hypothesis. -/
theorem threeBlockFixedTupleInitial_isRoot_descendedFactor
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d)) (b : Fin 3) :
    ((threeBlockDescendedFactor q d F
      ⟨x.coords, x.twisted_fixed⟩ b).map
        (ZMod.castHom (m := q) dvd_rfl F)).IsRoot
      (threeBlockFixedTupleInitial q d m hd F g hg hdeg hm hmn t x b) := by
  rw [threeBlockDescendedFactor_map_eq_frobenius_orbit q d hd]
  rw [Polynomial.IsRoot, Polynomial.eval_prod]
  apply Finset.prod_eq_zero (i := ⟨0, hd⟩)
  · exact Finset.mem_univ _
  · simp [threeBlockFixedTupleInitial, threeBlockFixedBlock]

/-- A finite code for a fixed tuple: in each block, record its descended
degree-`d` polynomial and the selected initial root. -/
noncomputable def threeBlockFixedTupleFiniteCode
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
        hdeg hm hmn t (threeBlockCyclePermutation d) →
      (∀ b : Fin 3, Σ p : Polynomial.degreeLT (ZMod q) (d + 1),
        p.1.rootSet F) := by
  intro x b
  let xf : {z : Fin (3 * d) → F //
      twistedTupleFrobenius q (3 * d) F
        (threeBlockCyclePermutation d) z = z} :=
    ⟨x.coords, x.twisted_fixed⟩
  let p := threeBlockDescendedFactor q d F xf b
  have hpdeg : p.natDegree = d :=
    threeBlockDescendedFactor_natDegree q d F xf b
  have hpmonic : p.Monic := threeBlockDescendedFactor_monic q d F xf b
  have hpLT : p ∈ Polynomial.degreeLT (ZMod q) (d + 1) := by
    rw [Polynomial.mem_degreeLT,
      Polynomial.degree_eq_natDegree hpmonic.ne_zero, hpdeg]
    exact_mod_cast Nat.lt_succ_self d
  refine ⟨⟨p, hpLT⟩,
    ⟨threeBlockFixedTupleInitial
      q d m hd F g hg hdeg hm hmn t x b, ?_⟩⟩
  rw [hpmonic.mem_rootSet]
  have hroot := threeBlockFixedTupleInitial_isRoot_descendedFactor
    q d m hd F g hg hdeg hm hmn t x b
  have hι : algebraMap (ZMod q) F =
      ZMod.castHom (m := q) dvd_rfl F := Subsingleton.elim _ _
  simpa [Polynomial.aeval_def, Polynomial.eval_map, hι,
    Polynomial.IsRoot] using hroot

theorem threeBlockFixedTupleFiniteCode_injective
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Function.Injective
      (threeBlockFixedTupleFiniteCode
        q d m hd F g hg hdeg hm hmn t) := by
  intro x y hxy
  apply threeBlockFixedTupleInitial_injective
    q d m hd F g hg hdeg hm hmn t
  funext b
  have hb := congrFun hxy b
  exact congrArg (fun z => z.2.1) hb

/-- All three-block twisted fixed tuples form a finite type, even over an
infinite algebraic closure. -/
theorem finiteThreeBlockFixedTupleData
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Finite (FullResidueUnitFiberFixedTupleData q (3 * d) m F g hg
      hdeg hm hmn t (threeBlockCyclePermutation d)) := by
  let : Finite (Polynomial.degreeLT (ZMod q) (d + 1)) :=
    Finite.of_injective
      (Polynomial.degreeLTEquiv (ZMod q) (d + 1))
      (Polynomial.degreeLTEquiv (ZMod q) (d + 1)).injective
  let (p : Polynomial.degreeLT (ZMod q) (d + 1)) :
      Finite (p.1.rootSet F) := p.1.rootSet_finite F |>.to_subtype
  exact Finite.of_injective
    (threeBlockFixedTupleFiniteCode
      q d m hd F g hg hdeg hm hmn t)
    (threeBlockFixedTupleFiniteCode_injective
      q d m hd F g hg hdeg hm hmn t)

/-- Hence the full twisted fixed-point type on the residue fiber is finite. -/
theorem finiteThreeBlockFixedPointData
    (q d m : ℕ) [Fact q.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Finite {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q (3 * d) m g hg hdeg hm hmn t
          (threeBlockCyclePermutation d) = x} := by
  let : Finite (FullResidueUnitFiberFixedTupleData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)) :=
    finiteThreeBlockFixedTupleData
      q d m hd F g hg hdeg hm hmn t
  exact Finite.of_equiv _
    (fullResidueUnitFiberFixedPointEquivTupleData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)).symm

/-- Identity trace matrix on the complete three-block twisted fixed locus. -/
noncomputable def threeBlockFixedPointTraceMatrix
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Matrix
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q (3 * d) m g hg hdeg hm hmn t
            (threeBlockCyclePermutation d) = x}
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q (3 * d) m g hg hdeg hm hmn t
            (threeBlockCyclePermutation d) = x} ℚ_[ℓ] := by
  classical
  exact 1

/-- The full fixed-point trace is exactly the full finite fixed-point count. -/
theorem threeBlockFixedPointTraceMatrix_trace
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    letI : Fintype
        {x : Spec (.of F) ⟶
            FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
          x ≫ fullResidueUnitFiberTwistedFrobenius
            q (3 * d) m g hg hdeg hm hmn t
              (threeBlockCyclePermutation d) = x} :=
      @Fintype.ofFinite _
        (finiteThreeBlockFixedPointData
          q d m hd F g hg hdeg hm hmn t)
    (threeBlockFixedPointTraceMatrix
      q d m ℓ hd F g hg hdeg hm hmn t).trace =
      (Nat.card
        {x : Spec (.of F) ⟶
            FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
          x ≫ fullResidueUnitFiberTwistedFrobenius
            q (3 * d) m g hg hdeg hm hmn t
              (threeBlockCyclePermutation d) = x} : ℚ_[ℓ]) := by
  let : Finite
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q (3 * d) m g hg hdeg hm hmn t
            (threeBlockCyclePermutation d) = x} :=
    finiteThreeBlockFixedPointData
      q d m hd F g hg hdeg hm hmn t
  let : Fintype
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) (3 * d) m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q (3 * d) m g hg hdeg hm hmn t
            (threeBlockCyclePermutation d) = x} := Fintype.ofFinite _
  unfold threeBlockFixedPointTraceMatrix Matrix.trace
  rw [Nat.card_eq_fintype_card]
  simp

/-- The identity matrix on the finite distinct fixed-point locus of the
three-block twisted Frobenius. -/
noncomputable def threeBlockInjectiveFixedPointTraceMatrix
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    Matrix
      (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d))
      (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) ℚ_[ℓ] := by
  classical
  exact 1

/-- The distinct fixed-point trace is its literal finite cardinality. -/
theorem threeBlockInjectiveFixedPointTraceMatrix_trace
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    letI : Fintype (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) :=
      @Fintype.ofFinite _
        (finiteThreeBlockInjectiveFixedPointData
          q d m hd F g hg hdeg hm hmn t)
    (threeBlockInjectiveFixedPointTraceMatrix
      q d m ℓ hd F g hg hdeg hm hmn t).trace =
      (Nat.card (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) : ℚ_[ℓ]) := by
  let : Finite (FullResidueUnitFiberInjectiveFixedPointData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)) :=
    finiteThreeBlockInjectiveFixedPointData
      q d m hd F g hg hdeg hm hmn t
  let : Fintype (FullResidueUnitFiberInjectiveFixedPointData
      q (3 * d) m F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)) := Fintype.ofFinite _
  unfold threeBlockInjectiveFixedPointTraceMatrix Matrix.trace
  rw [Nat.card_eq_fintype_card]
  simp

/-- The trace of the identity on the distinct three-cycle fixed locus is
exactly `d ^ 3` times the number of represented ordered irreducible
triples.  This puts the arithmetic multiplicity theorem in the coefficient
field used by the forthcoming Lefschetz comparison. -/
theorem threeBlockInjectiveFixedPointTraceMatrix_trace_eq_triple_card
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime] (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    letI : Fintype (FullResidueUnitFiberInjectiveFixedPointData
        q (3 * d) m F g hg hdeg hm hmn t
          (threeBlockCyclePermutation d)) :=
      @Fintype.ofFinite _
        (finiteThreeBlockInjectiveFixedPointData
          q d m hd F g hg hdeg hm hmn t)
    (threeBlockInjectiveFixedPointTraceMatrix
      q d m ℓ hd F g hg hdeg hm hmn t).trace =
      (d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) : ℚ_[ℓ]) := by
  rw [threeBlockInjectiveFixedPointTraceMatrix_trace,
    threeBlockInjectiveFixedPoint_card_eq_triple_card
      q d m hd F g hg hdeg hm hmn t]
  norm_cast

/-! ### Finiteness for arbitrary permutation-twisted Frobenius -/

theorem twistedTupleFrobenius_iterate_apply
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) (x : Fin n → F) (e : ℕ) (i : Fin n) :
    ((twistedTupleFrobenius q n F σ : (Fin n → F) → (Fin n → F))^[e] x) i =
      (frobeniusEquiv F q)^[e] (x ((σ ^ e) i)) := by
  induction e generalizing i with
  | zero => simp
  | succ e ih =>
      rw [Function.iterate_succ_apply']
      change ((((twistedTupleFrobenius q n F σ :
        (Fin n → F) → (Fin n → F))^[e] x) (σ i)) ^ q) = _
      rw [ih (σ i)]
      rw [Function.iterate_succ_apply']
      congr 1

theorem twistedTupleFrobenius_fixed_iterate_order
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n))
    (x : {x : Fin n → F // twistedTupleFrobenius q n F σ x = x})
    (i : Fin n) :
    (frobeniusEquiv F q)^[orderOf σ] (x.1 i) = x.1 i := by
  have hiter := congrFun (Function.IsFixedPt.iterate x.2 (orderOf σ)) i
  rw [twistedTupleFrobenius_iterate_apply] at hiter
  rw [pow_orderOf_eq_one] at hiter
  simpa using hiter

noncomputable def permutationFrobeniusFixedPolynomial
    (q : ℕ) (F : Type*) [Field F] (σOrder : ℕ) : Polynomial F :=
  Polynomial.X ^ (q ^ σOrder) - Polynomial.X

theorem permutationFrobeniusFixedPolynomial_monic
    (q : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] (e : ℕ) (he : 0 < e) :
    (permutationFrobeniusFixedPolynomial q F e).Monic := by
  unfold permutationFrobeniusFixedPolynomial
  apply Polynomial.monic_X_pow_sub
  rw [Polynomial.degree_X]
  exact_mod_cast (Nat.one_lt_pow he.ne' (Fact.out : q.Prime).one_lt)

theorem twistedTupleFrobenius_fixed_mem_rootSet
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n))
    (x : {x : Fin n → F // twistedTupleFrobenius q n F σ x = x})
    (i : Fin n) :
    x.1 i ∈ (permutationFrobeniusFixedPolynomial
      q F (orderOf σ)).rootSet F := by
  have he : 0 < orderOf σ := orderOf_pos σ
  rw [(permutationFrobeniusFixedPolynomial_monic q F (orderOf σ) he).mem_rootSet]
  simp only [permutationFrobeniusFixedPolynomial, map_sub, map_pow,
    Polynomial.aeval_X, sub_eq_zero]
  have hfix := twistedTupleFrobenius_fixed_iterate_order q n F σ x i
  simpa [frobeniusEquiv_def, iterate_frobenius] using hfix

noncomputable def twistedTupleFixedFiniteCode
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) :
    {x : Fin n → F // twistedTupleFrobenius q n F σ x = x} →
      (Fin n →
        (permutationFrobeniusFixedPolynomial q F (orderOf σ)).rootSet F) :=
  fun x i => ⟨x.1 i, twistedTupleFrobenius_fixed_mem_rootSet q n F σ x i⟩

theorem twistedTupleFixedFiniteCode_injective
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) :
    Function.Injective (twistedTupleFixedFiniteCode q n F σ) := by
  intro x y hxy
  apply Subtype.ext
  funext i
  exact congrArg Subtype.val (congrFun hxy i)

/-- The fixed tuples of arithmetic Frobenius twisted by any finite
coordinate permutation form a finite type over an arbitrary perfect field. -/
theorem finiteTwistedTupleFixedData
    (q n : ℕ) [Fact q.Prime]
    (F : Type*) [Field F] [CharP F q] [PerfectRing F q]
    (σ : Equiv.Perm (Fin n)) :
    Finite {x : Fin n → F // twistedTupleFrobenius q n F σ x = x} := by
  let : Finite
      ((permutationFrobeniusFixedPolynomial
        q F (orderOf σ)).rootSet F) :=
    (permutationFrobeniusFixedPolynomial
      q F (orderOf σ)).rootSet_finite F |>.to_subtype
  exact Finite.of_injective
    (twistedTupleFixedFiniteCode q n F σ)
    (twistedTupleFixedFiniteCode_injective q n F σ)

theorem finiteFullResidueUnitFiberFixedTupleData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    Finite (FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) := by
  let : Finite
      {x : Fin n → F // twistedTupleFrobenius q n F σ x = x} :=
    finiteTwistedTupleFixedData q n F σ
  exact Finite.of_injective
    (fun x : FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ =>
        (⟨x.coords, x.twisted_fixed⟩ :
          {x : Fin n → F // twistedTupleFrobenius q n F σ x = x}))
    (by
      intro x y hxy
      apply FullResidueUnitFiberFixedTupleData.ext
      exact congrArg Subtype.val hxy)

/-- Fixed geometric points of every permutation-twisted Frobenius on the
literal residue fiber form a finite type. -/
theorem finiteFullResidueUnitFiberTwistedFixedPointData
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    Finite {x : Spec (.of F) ⟶
        FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberTwistedFrobenius
        q n m g hg hdeg hm hmn t σ = x} := by
  let : Finite (FullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ) :=
    finiteFullResidueUnitFiberFixedTupleData
      q n m F g hg hdeg hm hmn t σ
  exact Finite.of_equiv _
    (fullResidueUnitFiberFixedPointEquivTupleData
      q n m F g hg hdeg hm hmn t σ).symm

/-- Identity matrix on the finite fixed locus of an arbitrary coordinate-
permutation-twisted Frobenius. -/
noncomputable def fullResidueUnitFiberTwistedFixedPointTraceMatrix
    (q n m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    Matrix
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ = x}
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ = x} ℚ_[ℓ] := by
  classical
  exact 1

/-- Its trace is exactly the geometric fixed-point cardinality. -/
theorem fullResidueUnitFiberTwistedFixedPointTraceMatrix_trace
    (q n m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    letI : Fintype
        {x : Spec (.of F) ⟶
            FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
          x ≫ fullResidueUnitFiberTwistedFrobenius
            q n m g hg hdeg hm hmn t σ = x} :=
      @Fintype.ofFinite _
        (finiteFullResidueUnitFiberTwistedFixedPointData
          q n m F g hg hdeg hm hmn t σ)
    (fullResidueUnitFiberTwistedFixedPointTraceMatrix
      q n m ℓ F g hg hdeg hm hmn t σ).trace =
      (Nat.card
        {x : Spec (.of F) ⟶
            FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
          x ≫ fullResidueUnitFiberTwistedFrobenius
            q n m g hg hdeg hm hmn t σ = x} : ℚ_[ℓ]) := by
  let : Finite
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ = x} :=
    finiteFullResidueUnitFiberTwistedFixedPointData
      q n m F g hg hdeg hm hmn t σ
  let : Fintype
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberTwistedFrobenius
          q n m g hg hdeg hm hmn t σ = x} := Fintype.ofFinite _
  unfold fullResidueUnitFiberTwistedFixedPointTraceMatrix Matrix.trace
  rw [Nat.card_eq_fintype_card]
  simp

/-! ### Projective extension of coordinate permutations -/

attribute [local instance] MvPolynomial.gradedAlgebra

abbrev RI (n : ℕ) : Type u := ULift.{u} (Fin n)

abbrev HC (K : Type u) [Field K] (n d : ℕ) :=
  MvPolynomial.homogeneousSubmodule (Option (RI n)) K d

noncomputable abbrev PS (K : Type u) [Field K] (n : ℕ) : Scheme.{u} := Proj (HC K n)

def rootIndexPermutation (n : ℕ) (σ : Equiv.Perm (Fin n)) : RI n ≃ RI n where
  toFun i := ULift.up (σ i.down)
  invFun i := ULift.up (σ.symm i.down)
  left_inv i := by simp
  right_inv i := by simp

noncomputable def homogeneousCoordinatePermutation
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    MvPolynomial (Option (RI n)) K →+*
      MvPolynomial (Option (RI n)) K :=
  (MvPolynomial.rename
    (Equiv.optionCongr (rootIndexPermutation n σ))).toRingHom

@[simp] theorem homogeneousCoordinatePermutation_X_none
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    homogeneousCoordinatePermutation K n σ (MvPolynomial.X none) =
      MvPolynomial.X none := by
  simp [homogeneousCoordinatePermutation]

@[simp] theorem homogeneousCoordinatePermutation_X_some
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n))
    (i : RI n) :
    homogeneousCoordinatePermutation K n σ (MvPolynomial.X (some i)) =
      MvPolynomial.X (some (ULift.up (σ i.down))) := by
  unfold homogeneousCoordinatePermutation
  change (MvPolynomial.rename
    (Equiv.optionCongr (rootIndexPermutation n σ)))
      (MvPolynomial.X (some i)) = _
  rw [MvPolynomial.rename_X]
  rfl

noncomputable def homogeneousCoordinatePermutationGraded
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    HC K n →+*ᵍ HC K n where
  toRingHom := homogeneousCoordinatePermutation K n σ
  map_mem h := h.rename_isHomogeneous

theorem homogeneousCoordinatePermutationGraded_bijective
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    Function.Bijective (homogeneousCoordinatePermutationGraded K n σ) := by
  change Function.Bijective
    (MvPolynomial.rename
      (Equiv.optionCongr (rootIndexPermutation n σ)))
  exact (MvPolynomial.renameEquiv K
    (Equiv.optionCongr (rootIndexPermutation n σ))).bijective

theorem projectivePermutation_irrelevant_le_map
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    HomogeneousIdeal.irrelevant (HC K n) ≤
      (HomogeneousIdeal.irrelevant (HC K n)).map
        (homogeneousCoordinatePermutationGraded K n σ) := by
  intro x hx
  obtain ⟨y, rfl⟩ :=
    (homogeneousCoordinatePermutationGraded_bijective K n σ).2 x
  apply Ideal.mem_map_of_mem
  change y ∈ HomogeneousIdeal.irrelevant (HC K n)
  rw [HomogeneousIdeal.mem_irrelevant_iff] at hx ⊢
  apply (homogeneousCoordinatePermutationGraded_bijective K n σ).1
  simpa using hx

noncomputable def projectiveRootPermutation
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    PS K n ⟶ PS K n :=
  Proj.map
    (homogeneousCoordinatePermutationGraded K n σ)
    (projectivePermutation_irrelevant_le_map K n σ)

open AlgebraicGeometry.ProjectiveCompactification

theorem dehomogenize_homogeneousCoordinatePermutation
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n))
    (p : MvPolynomial (Option (RI n)) K) :
    dehomogenize K (RI n)
        (homogeneousCoordinatePermutation K n σ p) =
      MvPolynomial.rename (rootIndexPermutation n σ)
        (dehomogenize K (RI n) p) := by
  let left : MvPolynomial (Option (RI n)) K →+* MvPolynomial (RI n) K :=
    (dehomogenize K (RI n)).comp
      (homogeneousCoordinatePermutation K n σ)
  let right : MvPolynomial (Option (RI n)) K →+* MvPolynomial (RI n) K :=
    (MvPolynomial.rename (rootIndexPermutation n σ)).toRingHom.comp
      (dehomogenize K (RI n))
  have h : left = right := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [left, right, homogeneousCoordinatePermutation]
    · intro i
      cases i with
      | none =>
          simp only [left, right, RingHom.comp_apply]
          rw [homogeneousCoordinatePermutation_X_none]
          change dehomogenize K (RI n) (xZero K (RI n)) =
            MvPolynomial.rename (rootIndexPermutation n σ)
              (dehomogenize K (RI n) (xZero K (RI n)))
          rw [dehomogenize_xZero]
          simpa only using
            (map_one (MvPolynomial.rename (rootIndexPermutation n σ) :
              MvPolynomial (RI n) K →ₐ[K] MvPolynomial (RI n) K)).symm
      | some i =>
          simp [left, right, homogeneousCoordinatePermutation,
            rootIndexPermutation]
  exact DFunLike.congr_fun h p

@[simp] theorem homogeneousCoordinatePermutationGraded_xZero
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    homogeneousCoordinatePermutationGraded K n σ (xZero K (RI n)) =
      xZero K (RI n) := by
  exact homogeneousCoordinatePermutation_X_none K n σ

noncomputable def affineChartPermutation
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    AffineChartRing K (RI n) →+* AffineChartRing K (RI n) :=
  (affineToChart K (RI n)).comp
    ((MvPolynomial.rename (rootIndexPermutation n σ)).toRingHom.comp
      (chartToAffine K (RI n)))

noncomputable def affineChartPermutationFromAway
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    AffineChartRing K (RI n) →+* AffineChartRing K (RI n) :=
  (RingEquiv.cast
      (R := HomogeneousLocalization.Away (H K (RI n)))
      (homogeneousCoordinatePermutationGraded_xZero K n σ)).toRingHom.comp
    (HomogeneousLocalization.Away.map
      (homogeneousCoordinatePermutationGraded K n σ)
      (xZero K (RI n)))

theorem affineChartPermutationFromAway_apply_heq
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n))
    (z : AffineChartRing K (RI n)) :
    affineChartPermutationFromAway K n σ z ≍
      (HomogeneousLocalization.Away.map
        (homogeneousCoordinatePermutationGraded K n σ)
        (xZero K (RI n))) z := by
  unfold affineChartPermutationFromAway
  rw [RingHom.comp_apply]
  change (RingEquiv.cast
      (R := HomogeneousLocalization.Away (H K (RI n)))
      (homogeneousCoordinatePermutationGraded_xZero K n σ))
        ((HomogeneousLocalization.Away.map
          (homogeneousCoordinatePermutationGraded K n σ)
          (xZero K (RI n))) z) ≍ _
  rw [RingEquiv.cast_apply]
  exact cast_heq _ _

theorem chartToAffine_awayMap_homogeneousCoordinatePermutation
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n))
    (z : AffineChartRing K (RI n)) :
    chartToAffine K (RI n)
        (affineChartPermutation K n σ z) =
      MvPolynomial.rename (rootIndexPermutation n σ)
        (chartToAffine K (RI n) z) := by
  have h := DFunLike.congr_fun
    (chartToAffine_comp_affineToChart K (RI n))
    (MvPolynomial.rename (rootIndexPermutation n σ)
      (chartToAffine K (RI n) z))
  simpa [affineChartPermutation, RingHom.comp_apply] using h

theorem affineChartRingEquiv_symm_apply
    (K : Type u) [Field K] (n : ℕ)
    (w : AffineChartRing K (RI n)) :
    (affineChartRingEquiv K (RI n)).symm w =
      chartToAffine K (RI n) w := by
  rw [RingEquiv.symm_apply_eq]
  unfold affineChartRingEquiv
  change w = affineToChart K (RI n) (chartToAffine K (RI n) w)
  have h := DFunLike.congr_fun
    (affineToChart_comp_chartToAffine K (RI n)) w
  simpa [RingHom.comp_apply] using h.symm

theorem affineChartPermutationFromAway_eq
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    affineChartPermutationFromAway K n σ =
      affineChartPermutation K n σ := by
  apply RingHom.ext
  intro z
  apply (affineChartRingEquiv K (RI n)).symm.injective
  rw [affineChartRingEquiv_symm_apply,
    affineChartRingEquiv_symm_apply]
  change chartToAffine K (RI n)
      (affineChartPermutationFromAway K n σ z) =
    chartToAffine K (RI n) (affineChartPermutation K n σ z)
  obtain ⟨degree, p, hp, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective
      (H K (RI n)) (xZero_mem K (RI n)) z
  let f := homogeneousCoordinatePermutationGraded K n σ
  have hp' : p ∈ H K (RI n) degree := by simpa using hp
  have hfp' : f p ∈ H K (RI n) degree := Graded.map_mem f hp'
  have happ := affineChartPermutationFromAway_apply_heq K n σ
    (HomogeneousLocalization.Away.mk
      (H K (RI n)) (xZero_mem K (RI n)) degree p hp)
  rw [HomogeneousLocalization.Away.map_mk] at happ
  have hmk :
      HomogeneousLocalization.Away.mk (H K (RI n))
          (Graded.map_mem f (xZero_mem K (RI n))) degree (f p)
          (Graded.map_mem f hp) ≍
        HomogeneousLocalization.Away.mk (H K (RI n))
          (xZero_mem K (RI n)) degree (f p) (by
            simpa [f] using Graded.map_mem f hp) := by
    congr 1
    · exact homogeneousCoordinatePermutationGraded_xZero K n σ
    · exact proof_irrel_heq _ _
  have hvalue := eq_of_heq (happ.trans hmk)
  rw [hvalue]
  rw [chartToAffine_mk K (RI n) degree (f p) hfp']
  rw [chartToAffine_awayMap_homogeneousCoordinatePermutation]
  rw [chartToAffine_mk K (RI n) degree p hp']
  exact dehomogenize_homogeneousCoordinatePermutation K n σ p

noncomputable def affineRootPermutationSpec
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    AffineRootSpace K n ⟶ AffineRootSpace K n :=
  (AffineSpace.SpecIso (RootIndex n) (.of K)).hom ≫
    Spec.map (CommRingCat.ofHom
      (MvPolynomial.rename (rootIndexPermutation n σ)).toRingHom) ≫
    (AffineSpace.SpecIso (RootIndex n) (.of K)).inv

theorem affineRootPermutationSpec_eq
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    affineRootPermutationSpec K n σ = affineRootPermutation K n σ := by
  apply AffineSpace.hom_ext
  · rw [affineRootPermutation_over]
    unfold affineRootPermutationSpec
    simp only [Category.assoc, AffineSpace.SpecIso_inv_over]
    rw [← Spec.map_comp]
    have hC : (CommRingCat.ofHom MvPolynomial.C :
        CommRingCat.of K ⟶
          CommRingCat.of (MvPolynomial (RootIndex n) K)) ≫
          CommRingCat.ofHom
            (MvPolynomial.rename (rootIndexPermutation n σ)).toRingHom =
        CommRingCat.ofHom MvPolynomial.C := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact MvPolynomial.rename_C _ _
    rw [hC]
    apply (cancel_epi
      (AffineSpace.SpecIso (RootIndex n) (.of K)).inv).1
    simp
  · intro i
    rcases i with ⟨i⟩
    unfold affineRootPermutationSpec
    change (AffineSpace.SpecIso (RootIndex n) (.of K)).hom.appTop
      ((Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename
          (rootIndexPermutation n σ)).toRingHom)).appTop
        ((AffineSpace.SpecIso (RootIndex n) (.of K)).inv.appTop
          (AffineSpace.coord (Spec (.of K)) (ULift.up i)))) = _
    rw [AffineSpace.SpecIso_inv_appTop_coord,
      affineRootPermutation_appTop_coord]
    change ((Scheme.ΓSpecIso (.of
          (MvPolynomial (RootIndex n) K))).inv ≫
        (Spec.map (CommRingCat.ofHom
          (MvPolynomial.rename
            (rootIndexPermutation n σ)).toRingHom)).appTop ≫
        (AffineSpace.SpecIso (RootIndex n) (.of K)).hom.appTop)
          (MvPolynomial.X (ULift.up i)) = _
    rw [← Scheme.ΓSpecIso_inv_naturality_assoc]
    change (AffineSpace.SpecIso (RootIndex n) (.of K)).hom.appTop
      ((Scheme.ΓSpecIso (.of
        (MvPolynomial (RootIndex n) K))).inv
          (MvPolynomial.rename (rootIndexPermutation n σ)
              (MvPolynomial.X (ULift.up i)))) = _
    rw [MvPolynomial.rename_X]
    change (AffineSpace.SpecIso (RootIndex n) (.of K)).hom.appTop
      ((Scheme.ΓSpecIso (.of
        (MvPolynomial (RootIndex n) K))).inv
          (MvPolynomial.X (ULift.up (σ i)))) = _
    have hcoord := AffineSpace.SpecIso_inv_appTop_coord
      (n := RootIndex n) (.of K) (ULift.up (σ i))
    rw [← hcoord, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop]
    simp

theorem specMap_ringEquivCast_comp_awayι
    (K : Type u) [Field K] (n : ℕ)
    (s t : MvPolynomial (Option (RI n)) K) (hst : s = t)
    (hs : s ∈ H K (RI n) 1) (ht : t ∈ H K (RI n) 1) :
    Spec.map (CommRingCat.ofHom
        (RingEquiv.cast
          (R := HomogeneousLocalization.Away (H K (RI n))) hst).toRingHom) ≫
      Proj.awayι (H K (RI n)) s hs (by omega) =
        Proj.awayι (H K (RI n)) t ht (by omega) := by
  cases hst
  have hmem : hs = ht := Subsingleton.elim _ _
  subst ht
  have hring :
      (RingEquiv.cast
        (R := HomogeneousLocalization.Away (H K (RI n)))
        (rfl : s = s)).toRingHom = RingHom.id _ := by
    ext z
    rfl
  rw [hring]
  simp

theorem affineSpaceToProjective_projectiveRootPermutation
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    affineSpaceToProjective K (RootIndex n) ≫
        projectiveRootPermutation K n σ =
      affineRootPermutation K n σ ≫
        affineSpaceToProjective K (RootIndex n) := by
  rw [← affineRootPermutationSpec_eq]
  unfold affineSpaceToProjective projectiveRootPermutation
    affineRootPermutationSpec
  simp only [Category.assoc]
  have haw := Proj.awayι_comp_map
    (homogeneousCoordinatePermutationGraded K n σ)
    (projectivePermutation_irrelevant_le_map K n σ)
    (by omega) (xZero K (RootIndex n))
    (xZero_mem K (RootIndex n))
  have haw' :
      Proj.awayι (H K (RootIndex n)) (xZero K (RootIndex n))
          (xZero_mem K (RootIndex n)) (by omega) ≫
          Proj.map (homogeneousCoordinatePermutationGraded K n σ)
            (projectivePermutation_irrelevant_le_map K n σ) =
        Spec.map (CommRingCat.ofHom
          (affineChartPermutationFromAway K n σ)) ≫
          Proj.awayι (H K (RootIndex n)) (xZero K (RootIndex n))
            (xZero_mem K (RootIndex n)) (by omega) := by
    let hcast := specMap_ringEquivCast_comp_awayι K n
      ((homogeneousCoordinatePermutationGraded K n σ)
        (xZero K (RootIndex n)))
      (xZero K (RootIndex n))
      (homogeneousCoordinatePermutationGraded_xZero K n σ)
      (Graded.map_mem (homogeneousCoordinatePermutationGraded K n σ)
        (xZero_mem K (RootIndex n)))
      (xZero_mem K (RootIndex n))
    have hpre := congrArg
      (fun e => Spec.map (CommRingCat.ofHom
          (RingEquiv.cast
            (R := HomogeneousLocalization.Away (H K (RootIndex n)))
            (homogeneousCoordinatePermutationGraded_xZero K n σ)).toRingHom) ≫ e)
      haw
    simp only [← Category.assoc] at hpre
    rw [hcast] at hpre
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp] at hpre
    simpa only [affineChartPermutationFromAway] using hpre
  rw [haw']
  rw [affineChartPermutationFromAway_eq]
  rw [Iso.inv_hom_id_assoc]
  apply (cancel_epi
    (AffineSpace.SpecIso (RootIndex n) (.of K)).hom).2
  simp only [← Category.assoc]
  apply (cancel_mono
    (Proj.awayι (H K (RootIndex n)) (xZero K (RootIndex n))
      (xZero_mem K (RootIndex n)) (by omega))).2
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro z
  simp only [CommRingCat.comp_apply, CommRingCat.hom_ofHom]
  change (affineChartRingEquiv K (RI n)).symm
      (affineChartPermutation K n σ z) =
    MvPolynomial.rename (rootIndexPermutation n σ)
      ((affineChartRingEquiv K (RI n)).symm z)
  rw [affineChartRingEquiv_symm_apply,
    affineChartRingEquiv_symm_apply]
  exact chartToAffine_awayMap_homogeneousCoordinatePermutation K n σ z

theorem homogeneousCoordinatePermutationGraded_comp_symm
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    (homogeneousCoordinatePermutationGraded K n σ).comp
        (homogeneousCoordinatePermutationGraded K n σ.symm) =
      GradedRingHom.id (HC K n) := by
  apply GradedRingHom.ext
  intro p
  change MvPolynomial.rename
      (Equiv.optionCongr (rootIndexPermutation n σ))
        (MvPolynomial.rename
          (Equiv.optionCongr (rootIndexPermutation n σ.symm)) p) = p
  exact (MvPolynomial.renameEquiv K
    (Equiv.optionCongr (rootIndexPermutation n σ))).apply_symm_apply p

theorem homogeneousCoordinatePermutationGraded_symm_comp
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    (homogeneousCoordinatePermutationGraded K n σ.symm).comp
        (homogeneousCoordinatePermutationGraded K n σ) =
      GradedRingHom.id (HC K n) := by
  simpa only [Equiv.symm_symm] using
    homogeneousCoordinatePermutationGraded_comp_symm K n σ.symm

theorem projMap_congr
    (K : Type u) [Field K] (n : ℕ)
    {f g : HC K n →+*ᵍ HC K n} (hfg : f = g)
    (hf : HomogeneousIdeal.irrelevant (HC K n) ≤
      (HomogeneousIdeal.irrelevant (HC K n)).map f)
    (hg : HomogeneousIdeal.irrelevant (HC K n) ≤
      (HomogeneousIdeal.irrelevant (HC K n)).map g) :
    Proj.map f hf = Proj.map g hg := by
  subst g
  congr

theorem projectiveRootPermutation_comp_symm
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    projectiveRootPermutation K n σ ≫
        projectiveRootPermutation K n σ.symm = 𝟙 _ := by
  unfold projectiveRootPermutation
  rw [← Proj.map_comp]
  exact (projMap_congr K n
    (homogeneousCoordinatePermutationGraded_comp_symm K n σ) _ _).trans
      (Proj.map_id (𝒜 := HC K n))

theorem projectiveRootPermutation_symm_comp
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    projectiveRootPermutation K n σ.symm ≫
        projectiveRootPermutation K n σ = 𝟙 _ := by
  simpa only [Equiv.symm_symm] using
    projectiveRootPermutation_comp_symm K n σ.symm

noncomputable instance projectiveRootPermutation_isIso
    (K : Type u) [Field K] (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    IsIso (projectiveRootPermutation K n σ) :=
  ⟨⟨projectiveRootPermutation K n σ.symm,
    projectiveRootPermutation_comp_symm K n σ,
    projectiveRootPermutation_symm_comp K n σ⟩⟩

theorem eqToHom_subscheme_comp_subschemeι
    {P : Scheme.{u}} (I J : P.IdealSheafData) (hJI : J = I) :
    eqToHom (congrArg Scheme.IdealSheafData.subscheme hJI) ≫
        I.subschemeι =
      J.subschemeι := by
  subst I
  simp

noncomputable def invariantSubschemeMap
    {P : Scheme.{u}} (I : P.IdealSheafData) (e : P ⟶ P)
    (hI : I.map e = I) : I.subscheme ⟶ I.subscheme :=
  let hI' : (I.subschemeι ≫ e).ker = I := hI
  (I.subschemeι ≫ e).toImage ≫
    eqToHom (congrArg Scheme.IdealSheafData.subscheme hI')

@[reassoc]
theorem invariantSubschemeMap_subschemeι
    {P : Scheme.{u}} (I : P.IdealSheafData) (e : P ⟶ P)
    (hI : I.map e = I) :
    invariantSubschemeMap I e hI ≫ I.subschemeι =
      I.subschemeι ≫ e := by
  let hI' : (I.subschemeι ≫ e).ker = I := hI
  change ((I.subschemeι ≫ e).toImage ≫
      eqToHom (congrArg Scheme.IdealSheafData.subscheme hI')) ≫
        I.subschemeι = I.subschemeι ≫ e
  calc
    _ = (I.subschemeι ≫ e).toImage ≫
        (eqToHom (congrArg Scheme.IdealSheafData.subscheme hI') ≫
          I.subschemeι) := Category.assoc _ _ _
    _ = (I.subschemeι ≫ e).toImage ≫
        (I.subschemeι ≫ e).ker.subschemeι := by
      rw [eqToHom_subscheme_comp_subschemeι I
        (I.subschemeι ≫ e).ker hI']
    _ = _ := Scheme.Hom.toImage_imageι _

@[reassoc]
theorem fullResidueUnitFiberPermutation_toProjectiveRootSpace
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberToProjectiveRootSpace
        q n m g hg hdeg hm hmn t =
    fullResidueUnitFiberToProjectiveRootSpace
        q n m g hg hdeg hm hmn t ≫
      projectiveRootPermutation (ZMod q) n σ := by
  unfold fullResidueUnitFiberToProjectiveRootSpace
  simp only [Category.assoc]
  rw [fullResidueUnitFiberPermutation_toRootSpace_assoc,
    rootPermutation_ι_assoc,
    ← affineSpaceToProjective_projectiveRootPermutation]

theorem fullResidueUnitFiberProjectiveClosureIdeal_map
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    (fullResidueUnitFiberToProjectiveRootSpace
        q n m g hg hdeg hm hmn t).ker.map
      (projectiveRootPermutation (ZMod q) n σ) =
    (fullResidueUnitFiberToProjectiveRootSpace
        q n m g hg hdeg hm hmn t).ker := by
  rw [Scheme.IdealSheafData.map_ker]
  rw [← fullResidueUnitFiberPermutation_toProjectiveRootSpace]
  exact Scheme.Hom.ker_comp_of_isIso _ _

noncomputable def fullResidueUnitFiberProjectiveClosurePermutation
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    FullResidueUnitFiberProjectiveClosure
        q n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiberProjectiveClosure
        q n m g hg hdeg hm hmn t :=
  invariantSubschemeMap
    (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t).ker
    (projectiveRootPermutation (ZMod q) n σ)
    (fullResidueUnitFiberProjectiveClosureIdeal_map
      q n m g hg hdeg hm hmn t σ)

@[reassoc]
theorem fullResidueUnitFiberProjectiveClosurePermutation_imageι
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ ≫
      (fullResidueUnitFiberToProjectiveRootSpace
        q n m g hg hdeg hm hmn t).imageι =
    (fullResidueUnitFiberToProjectiveRootSpace
        q n m g hg hdeg hm hmn t).imageι ≫
      projectiveRootPermutation (ZMod q) n σ := by
  exact invariantSubschemeMap_subschemeι _ _ _

theorem fullResidueUnitFiberProjectiveClosurePermutation_comp_symm
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ.symm = 𝟙 _ := by
  apply (cancel_mono
    (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t).imageι).1
  rw [Category.assoc,
    fullResidueUnitFiberProjectiveClosurePermutation_imageι,
    ← Category.assoc,
    fullResidueUnitFiberProjectiveClosurePermutation_imageι,
    Category.assoc, projectiveRootPermutation_comp_symm,
    Category.comp_id, Category.id_comp]

theorem fullResidueUnitFiberProjectiveClosurePermutation_symm_comp
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ.symm ≫
      fullResidueUnitFiberProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ = 𝟙 _ := by
  simpa only [Equiv.symm_symm] using
    fullResidueUnitFiberProjectiveClosurePermutation_comp_symm
      q n m g hg hdeg hm hmn t σ.symm

noncomputable instance
    fullResidueUnitFiberProjectiveClosurePermutation_isIso
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    IsIso (fullResidueUnitFiberProjectiveClosurePermutation
      q n m g hg hdeg hm hmn t σ) :=
  ⟨⟨fullResidueUnitFiberProjectiveClosurePermutation
      q n m g hg hdeg hm hmn t σ.symm,
    fullResidueUnitFiberProjectiveClosurePermutation_comp_symm
      q n m g hg hdeg hm hmn t σ,
    fullResidueUnitFiberProjectiveClosurePermutation_symm_comp
      q n m g hg hdeg hm hmn t σ⟩⟩

theorem fullResidueUnitFiberPermutation_projectiveClosureOpen
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation
        (ZMod q) n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberProjectiveClosureOpen
        q n m g hg hdeg hm hmn t =
    fullResidueUnitFiberProjectiveClosureOpen
        q n m g hg hdeg hm hmn t ≫
      fullResidueUnitFiberProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ := by
  apply (cancel_mono
    (fullResidueUnitFiberToProjectiveRootSpace
      q n m g hg hdeg hm hmn t).imageι).1
  unfold fullResidueUnitFiberProjectiveClosureOpen
    AlgebraicGeometry.properClosureOpen
  simp only [Category.assoc, Scheme.Hom.toImage_imageι,
    Scheme.Hom.toImage_imageι_assoc,
    fullResidueUnitFiberProjectiveClosurePermutation_imageι]
  exact fullResidueUnitFiberPermutation_toProjectiveRootSpace
    q n m g hg hdeg hm hmn t σ


/-! The canonical projective closure now supplies the previously abstract
compact-support action of every permutation-twisted Frobenius. -/

noncomputable def
    fullResidueUnitFiberCanonicalTwistedQEllAdicCompactSupportLinearMap
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n)) :
    AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree →ₗ[ℚ_[ℓ]]
      AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree :=
  fullResidueUnitFiberTwistedQEllAdicCompactSupportLinearMap
    q n m ℓ degree g hg hdeg hm hmn t σ
    (FullResidueUnitFiberProjectiveClosure
      q n m g hg hdeg hm hmn t)
    (Spec (.of (ZMod q)))
    (fullResidueUnitFiberProjectiveClosureOpen
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberProjectiveClosurePermutation
      q n m g hg hdeg hm hmn t σ)
    (fullResidueUnitFiberPermutation_projectiveClosureOpen
      q n m g hg hdeg hm hmn t σ)

noncomputable def
    fullResidueUnitFiberCanonicalTwistedQEllAdicCompactSupportTrace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (σ : Equiv.Perm (Fin n))
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree)] : ℚ_[ℓ] :=
  LinearMap.trace ℚ_[ℓ]
    (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
      (fullResidueUnitFiberProjectiveClosureOpen
        q n m g hg hdeg hm hmn t)
      (fullResidueUnitFiberProjectiveClosureProjection
        q n m g hg hdeg hm hmn t) ℓ degree)
    (fullResidueUnitFiberCanonicalTwistedQEllAdicCompactSupportLinearMap
      q n m ℓ degree g hg hdeg hm hmn t σ)

noncomputable def
    fullResidueUnitFiberCanonicalTwistedQEllAdicRealizationMatrix
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π : Equiv.Perm (Fin n))
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree)]
    (σ : ℚ_[ℓ] →+* ℂ) :
    Matrix
      (Fin (Module.finrank ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          (fullResidueUnitFiberProjectiveClosureOpen
            q n m g hg hdeg hm hmn t)
          (fullResidueUnitFiberProjectiveClosureProjection
            q n m g hg hdeg hm hmn t) ℓ degree)))
      (Fin (Module.finrank ℚ_[ℓ]
        (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
          (fullResidueUnitFiberProjectiveClosureOpen
            q n m g hg hdeg hm hmn t)
          (fullResidueUnitFiberProjectiveClosureProjection
            q n m g hg hdeg hm hmn t) ℓ degree))) ℂ :=
  (LinearMap.toMatrix
    (Module.finBasis ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree))
    (Module.finBasis ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree))
    (fullResidueUnitFiberCanonicalTwistedQEllAdicCompactSupportLinearMap
      q n m ℓ degree g hg hdeg hm hmn t π)).map σ

theorem fullResidueUnitFiberCanonicalTwistedQEllAdicRealizationMatrix_trace
    (q n m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π : Equiv.Perm (Fin n))
    [FiniteDimensional ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree)]
    (σ : ℚ_[ℓ] →+* ℂ) :
    (fullResidueUnitFiberCanonicalTwistedQEllAdicRealizationMatrix
      q n m ℓ degree g hg hdeg hm hmn t π σ).trace =
    σ (fullResidueUnitFiberCanonicalTwistedQEllAdicCompactSupportTrace
      q n m ℓ degree g hg hdeg hm hmn t π) := by
  unfold fullResidueUnitFiberCanonicalTwistedQEllAdicRealizationMatrix
    fullResidueUnitFiberCanonicalTwistedQEllAdicCompactSupportTrace
  rw [LinearMap.trace_eq_matrix_trace ℚ_[ℓ]
    (Module.finBasis ℚ_[ℓ]
      (AlgebraicGeometry.Scheme.ProEt.CompactlySupportedQEllAdicCohomology
        (fullResidueUnitFiberProjectiveClosureOpen
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberProjectiveClosureProjection
          q n m g hg hdeg hm hmn t) ℓ degree))]
  exact (AddMonoidHom.map_trace σ _).symm

/-! ### The pairwise-distinct residue fiber

The irreducible-triple trace is supported on the Vandermonde basic open,
not on the full residue fiber: this removes every repeated-root
factorization before Grothendieck--Lefschetz is applied. -/

noncomputable def rootVandermondeSection
    (K : Type u) [CommRing K] (n : ℕ) :
    Γ(AffineRootSpace K n, ⊤) :=
  (Matrix.vandermonde (fun i : Fin n =>
    AffineSpace.coord (Spec (.of K)) (ULift.up i))).det

theorem affineRootPermutation_appTop_rootVandermondeSection
    (K : Type u) [Field K] (n : ℕ) (π : Equiv.Perm (Fin n)) :
    (affineRootPermutation K n π).appTop
        (rootVandermondeSection K n) =
      ((π.sign : ℤ) : Γ(AffineRootSpace K n, ⊤)) *
        rootVandermondeSection K n := by
  rw [rootVandermondeSection, RingHom.map_det]
  rw [show (affineRootPermutation K n π).appTop.hom.mapMatrix
      (Matrix.vandermonde (fun i : Fin n =>
        AffineSpace.coord (Spec (.of K)) (ULift.up i))) =
      (Matrix.vandermonde (fun i : Fin n =>
        AffineSpace.coord (Spec (.of K)) (ULift.up i))).submatrix π id by
    rw [RingHom.mapMatrix_apply]
    ext i j
    simp only [Matrix.map_apply, Matrix.vandermonde_apply,
      map_pow, Matrix.submatrix_apply, Function.comp_apply, id_eq]
    rw [affineRootPermutation_appTop_coord]]
  exact Matrix.det_permute π _

theorem affineRootPoint_rootVandermondeSection
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (a : Spec (.of F) ⟶ AffineRootSpace (ZMod q) n) :
    (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (rootVandermondeSection (ZMod q) n)) =
      (Matrix.vandermonde
        (affineRootPointCoordinates (ZMod q) n a)).det := by
  unfold rootVandermondeSection affineRootPointCoordinates
  rw [RingHom.map_det, RingHom.map_det]
  apply congrArg Matrix.det
  ext i j
  simp [Matrix.vandermonde_apply]

theorem affineRootPoint_rootVandermondeSection_ne_zero_iff
    (q n : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (a : Spec (.of F) ⟶ AffineRootSpace (ZMod q) n) :
    (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (rootVandermondeSection (ZMod q) n)) ≠ 0 ↔
      Function.Injective
        (affineRootPointCoordinates (ZMod q) n a) := by
  rw [affineRootPoint_rootVandermondeSection,
    Matrix.det_vandermonde_ne_zero_iff]

noncomputable def FullResidueUnitFiberDistinctOpen
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    (FullResidueUnitFiber K n m g hg hdeg hm hmn t).Opens :=
  (FullResidueUnitFiber K n m g hg hdeg hm hmn t).basicOpen
    ((fullResidueUnitFiberToRootSpace K n m g hg hdeg hm hmn t ≫
      (RootSpaceOpen K n g).ι).appTop
        (rootVandermondeSection K n))

noncomputable abbrev FullResidueUnitFiberDistinct
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) : Scheme.{u} :=
  (FullResidueUnitFiberDistinctOpen K n m g hg hdeg hm hmn t).toScheme

noncomputable def fullResidueUnitFiberDistinctι
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    FullResidueUnitFiberDistinct K n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiber K n m g hg hdeg hm hmn t :=
  (FullResidueUnitFiberDistinctOpen K n m g hg hdeg hm hmn t).ι

instance fullResidueUnitFiberDistinctι_isOpenImmersion
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsOpenImmersion
      (fullResidueUnitFiberDistinctι K n m g hg hdeg hm hmn t) := by
  unfold fullResidueUnitFiberDistinctι
  infer_instance

instance fullResidueUnitFiberDistinct_isAffine
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    IsAffine (FullResidueUnitFiberDistinct K n m g hg hdeg hm hmn t) := by
  let : IsAffine (FullResidueUnitFiber K n m g hg hdeg hm hmn t) :=
    isAffine_fullResidueUnitFiber K n m g hg hdeg hm hmn t
  change IsAffine ((FullResidueUnitFiber K n m g hg hdeg hm hmn t).basicOpen _)
  infer_instance

theorem fullResidueUnitFiberPermutation_appTop_distinctSection
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    (fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t π).appTop
      ((fullResidueUnitFiberToRootSpace
          K n m g hg hdeg hm hmn t ≫
        (RootSpaceOpen K n g).ι).appTop
          (rootVandermondeSection K n)) =
      ((π.sign : ℤ) :
          Γ(FullResidueUnitFiber K n m g hg hdeg hm hmn t, ⊤)) *
        (fullResidueUnitFiberToRootSpace
            K n m g hg hdeg hm hmn t ≫
          (RootSpaceOpen K n g).ι).appTop
            (rootVandermondeSection K n) := by
  let f := fullResidueUnitFiberPermutation
    K n m g hg hdeg hm hmn t π
  let a := fullResidueUnitFiberToRootSpace
      K n m g hg hdeg hm hmn t ≫
    (RootSpaceOpen K n g).ι
  calc
    f.appTop (a.appTop (rootVandermondeSection K n)) =
        (f ≫ a).appTop (rootVandermondeSection K n) := by rfl
    _ = (a ≫ affineRootPermutation K n π).appTop
        (rootVandermondeSection K n) := by
      rw [show f ≫ a = a ≫ affineRootPermutation K n π by
        dsimp only [f, a]
        simp only [Category.assoc]
        rw [fullResidueUnitFiberPermutation_toRootSpace_assoc,
          rootPermutation_ι]]
    _ = a.appTop ((affineRootPermutation K n π).appTop
        (rootVandermondeSection K n)) := by rfl
    _ = a.appTop (((π.sign : ℤ) :
          Γ(AffineRootSpace K n, ⊤)) *
        rootVandermondeSection K n) := by
      rw [affineRootPermutation_appTop_rootVandermondeSection]
    _ = _ := by
      rw [map_mul]
      congr 1
      simp

theorem fullResidueUnitFiberPermutation_preimage_distinctOpen
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t π ⁻¹ᵁ
        FullResidueUnitFiberDistinctOpen K n m g hg hdeg hm hmn t =
      FullResidueUnitFiberDistinctOpen K n m g hg hdeg hm hmn t := by
  unfold FullResidueUnitFiberDistinctOpen
  rw [Scheme.preimage_basicOpen_top,
    fullResidueUnitFiberPermutation_appTop_distinctSection,
    Scheme.basicOpen_mul]
  have hunit : IsUnit (((π.sign : ℤ) :
      Γ(FullResidueUnitFiber K n m g hg hdeg hm hmn t, ⊤))) :=
    π.sign.isUnit.map (Int.castRingHom _)
  rw [Scheme.basicOpen_of_isUnit _ hunit, top_inf_eq]

noncomputable def fullResidueUnitFiberDistinctPermutation
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    FullResidueUnitFiberDistinct K n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiberDistinct K n m g hg hdeg hm hmn t :=
  (Scheme.isoOfEq
      (FullResidueUnitFiber K n m g hg hdeg hm hmn t)
      (fullResidueUnitFiberPermutation_preimage_distinctOpen
        K n m g hg hdeg hm hmn t π).symm).hom ≫
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t π ∣_
      FullResidueUnitFiberDistinctOpen K n m g hg hdeg hm hmn t

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberDistinctPermutation_ι
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t π ≫
      fullResidueUnitFiberDistinctι K n m g hg hdeg hm hmn t =
    fullResidueUnitFiberDistinctι K n m g hg hdeg hm hmn t ≫
      fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t π := by
  unfold fullResidueUnitFiberDistinctPermutation
    fullResidueUnitFiberDistinctι
  rw [Category.assoc, morphismRestrict_ι, ← Category.assoc,
    Scheme.isoOfEq_hom_ι]

theorem fullResidueUnitFiberDistinctPermutation_comp_symm
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t π ≫
      fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t π.symm = 𝟙 _ := by
  apply (cancel_mono
    (fullResidueUnitFiberDistinctι K n m g hg hdeg hm hmn t)).1
  rw [Category.assoc, fullResidueUnitFiberDistinctPermutation_ι,
    ← Category.assoc, fullResidueUnitFiberDistinctPermutation_ι,
    Category.assoc, fullResidueUnitFiberPermutation_comp_symm,
    Category.comp_id, Category.id_comp]

theorem fullResidueUnitFiberDistinctPermutation_symm_comp
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t π.symm ≫
      fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t π = 𝟙 _ := by
  simpa only [Equiv.symm_symm] using
    fullResidueUnitFiberDistinctPermutation_comp_symm
      K n m g hg hdeg hm hmn t π.symm

noncomputable instance fullResidueUnitFiberDistinctPermutation_isIso
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (π : Equiv.Perm (Fin n)) :
    IsIso (fullResidueUnitFiberDistinctPermutation
      K n m g hg hdeg hm hmn t π) :=
  ⟨⟨fullResidueUnitFiberDistinctPermutation
      K n m g hg hdeg hm hmn t π.symm,
    fullResidueUnitFiberDistinctPermutation_comp_symm
      K n m g hg hdeg hm hmn t π,
    fullResidueUnitFiberDistinctPermutation_symm_comp
      K n m g hg hdeg hm hmn t π⟩⟩

theorem fullResidueUnitFiberDistinctPoint_coordinates_injective
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (z : Spec (.of F) ⟶
      FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t) :
    Function.Injective
      (fullResidueUnitFiberRootCoordinates q n m F g hg hdeg hm hmn t
        (z ≫ fullResidueUnitFiberDistinctι
          (ZMod q) n m g hg hdeg hm hmn t)) := by
  let x := z ≫ fullResidueUnitFiberDistinctι
    (ZMod q) n m g hg hdeg hm hmn t
  let a := x ≫ fullResidueUnitFiberToRootSpace
      (ZMod q) n m g hg hdeg hm hmn t ≫
    (RootSpaceOpen (ZMod q) n g).ι
  have hopen : x ⁻¹ᵁ FullResidueUnitFiberDistinctOpen
      (ZMod q) n m g hg hdeg hm hmn t = ⊤ := by
    dsimp only [x, fullResidueUnitFiberDistinctι]
    rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self,
      Scheme.Hom.preimage_top]
  have hsection : x.appTop
      ((fullResidueUnitFiberToRootSpace
          (ZMod q) n m g hg hdeg hm hmn t ≫
        (RootSpaceOpen (ZMod q) n g).ι).appTop
          (rootVandermondeSection (ZMod q) n)) ≠ 0 := by
    intro hzero
    have hbasic : (Spec (.of F)).basicOpen
        (x.appTop
          ((fullResidueUnitFiberToRootSpace
              (ZMod q) n m g hg hdeg hm hmn t ≫
            (RootSpaceOpen (ZMod q) n g).ι).appTop
              (rootVandermondeSection (ZMod q) n))) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top]
      exact hopen
    rw [hzero, Scheme.basicOpen_zero] at hbasic
    exact bot_ne_top hbasic
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootVandermondeSection (ZMod q) n)) ≠ 0 := by
    intro hzero
    change a.appTop (rootVandermondeSection (ZMod q) n) ≠ 0 at hsection
    apply hsection
    have hinv := congrArg
      (fun y => (Scheme.ΓSpecIso (.of F)).inv y) hzero
    simpa using hinv
  exact (affineRootPoint_rootVandermondeSection_ne_zero_iff
    q n F a).mp himage

noncomputable def fullResidueUnitFiberPointToDistinct
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t)
    (hx : Function.Injective
      (fullResidueUnitFiberRootCoordinates q n m F g hg hdeg hm hmn t x)) :
    Spec (.of F) ⟶ FullResidueUnitFiberDistinct
      (ZMod q) n m g hg hdeg hm hmn t := by
  apply IsOpenImmersion.lift
    (fullResidueUnitFiberDistinctι
      (ZMod q) n m g hg hdeg hm hmn t) x
  intro z hz
  obtain ⟨w, rfl⟩ := hz
  unfold fullResidueUnitFiberDistinctι
  rw [Scheme.Opens.range_ι]
  apply x.mem_preimage.mp
  unfold FullResidueUnitFiberDistinctOpen
  rw [Scheme.preimage_basicOpen_top]
  let a := x ≫ fullResidueUnitFiberToRootSpace
      (ZMod q) n m g hg hdeg hm hmn t ≫
    (RootSpaceOpen (ZMod q) n g).ι
  have himage : (Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootVandermondeSection (ZMod q) n)) ≠ 0 :=
    (affineRootPoint_rootVandermondeSection_ne_zero_iff q n F a).mpr hx
  have hu : IsUnit ((Scheme.ΓSpecIso (.of F)).hom
      (a.appTop (rootVandermondeSection (ZMod q) n))) :=
    isUnit_iff_ne_zero.mpr himage
  have humap := hu.map (Scheme.ΓSpecIso (.of F)).inv.hom
  have hu' : IsUnit (a.appTop (rootVandermondeSection (ZMod q) n)) := by
    simpa using humap
  change w ∈ (Spec (.of F)).basicOpen
    (a.appTop (rootVandermondeSection (ZMod q) n))
  rw [Scheme.basicOpen_of_isUnit _ hu']
  trivial

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberPointToDistinct_ι
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (x : Spec (.of F) ⟶
      FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t)
    (hx : Function.Injective
      (fullResidueUnitFiberRootCoordinates q n m F g hg hdeg hm hmn t x)) :
    fullResidueUnitFiberPointToDistinct
        q n m F g hg hdeg hm hmn t x hx ≫
      fullResidueUnitFiberDistinctι
        (ZMod q) n m g hg hdeg hm hmn t = x := by
  unfold fullResidueUnitFiberPointToDistinct
  exact IsOpenImmersion.lift_fac _ _ _

noncomputable def fullResidueUnitFiberDistinctPointEquivInjectivePoint
    (q n m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (Spec (.of F) ⟶ FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t) ≃
      {x : Spec (.of F) ⟶
          FullResidueUnitFiber (ZMod q) n m g hg hdeg hm hmn t //
        Function.Injective (fullResidueUnitFiberRootCoordinates
          q n m F g hg hdeg hm hmn t x)} where
  toFun z := ⟨z ≫ fullResidueUnitFiberDistinctι
      (ZMod q) n m g hg hdeg hm hmn t,
    fullResidueUnitFiberDistinctPoint_coordinates_injective
      q n m F g hg hdeg hm hmn t z⟩
  invFun x := fullResidueUnitFiberPointToDistinct
    q n m F g hg hdeg hm hmn t x.1 x.2
  left_inv z := by
    apply (cancel_mono (fullResidueUnitFiberDistinctι
      (ZMod q) n m g hg hdeg hm hmn t)).1
    rw [fullResidueUnitFiberPointToDistinct_ι]
  right_inv x := by
    apply Subtype.ext
    exact fullResidueUnitFiberPointToDistinct_ι
      q n m F g hg hdeg hm hmn t x.1 x.2

noncomputable def fullResidueUnitFiberDistinctProjection
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t ⟶
      Spec (.of (ZMod q)) :=
  fullResidueUnitFiberDistinctι
      (ZMod q) n m g hg hdeg hm hmn t ≫
    fullResidueUnitFiberProjection
      (ZMod q) n m g hg hdeg hm hmn t

noncomputable def fullResidueUnitFiberDistinctFrobenius
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t :=
  affineSchemeFrobeniusOver
    (FullResidueUnitFiberDistinct
      (ZMod q) n m g hg hdeg hm hmn t) q
    (fullResidueUnitFiberDistinctProjection
      q n m g hg hdeg hm hmn t)

@[reassoc (attr := simp)]
theorem fullResidueUnitFiberDistinctFrobenius_ι
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
