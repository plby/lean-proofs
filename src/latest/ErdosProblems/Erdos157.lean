/-- Adding the elementary `3^k` diagonal estimate to the four genuinely
non-diagonal estimates gives the complete proper-partition bound. -/
theorem hasSawinLemma914ProperPartitionAverageBounds_of_nonDiagonal
    (hnonDiagonal : HasSawinLemma914NonDiagonalPartitionAverageBounds q) :
    HasSawinLemma914ProperPartitionAverageBounds q := by
  intro k hk
