theorem properPairResidue_condition_of_mod_eq
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (y : Fin (2 * d) → F)
    (havoid : ∀ i : Fin (2 * d),
      Polynomial.eval₂ (ZMod.castHom (m := q) dvd_rfl F) (y i) g ≠ 0)
    (hmod : properPairTuplePolynomial d F y %ₘ
        g.map (ZMod.castHom (m := q) dvd_rfl F) =
      t.map (ZMod.castHom (m := q) dvd_rfl F)) :
    rootTupleRootSpacePoint q (2 * d) F y g havoid ≫
        properPairResidueMultiplication (ZMod q) d m g hg =
      Spec.map (CommRingCat.ofHom
        (ZMod.castHom (m := q) dvd_rfl F)) ≫
        residuePoint (ZMod q) m t := by
  unfold properPairResidueMultiplication
  rw [← Category.assoc, rootTupleRootSpacePoint_ι]
  apply AffineSpace.hom_ext
  · exact specToZMod_hom_ext q F _ _
  · intro i
    rcases i with ⟨j⟩
    apply (Scheme.ΓSpecIso (.of F)).commRingCatIsoToRingEquiv.injective
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
    change (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q (2 * d) F y).appTop
          ((affineProperPairResidueMultiplication
              (ZMod q) d m g hg).appTop
            (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j)))) =
      (Scheme.ΓSpecIso (.of F)).hom
        ((Spec.map (CommRingCat.ofHom
          (ZMod.castHom (m := q) dvd_rfl F))).appTop
          ((residuePoint (ZMod q) m t).appTop
            (AffineSpace.coord (Spec (.of (ZMod q))) (ULift.up j))))
    rw [affineProperPairResidueMultiplication_appTop_coord]
    have hleft := congrArg (fun p : Polynomial F => p.coeff j)
      (rootTupleAffinePoint_universalProperPairRemainder
        q d m F y g hg)
    rw [Polynomial.coeff_map] at hleft
    have hleft' : (Scheme.ΓSpecIso (.of F)).hom
        ((rootTupleAffinePoint q (2 * d) F y).appTop
          ((universalProperPairRemainder (ZMod q) d g hg).coeff j)) =
        (properPairTuplePolynomial d F y %ₘ
          g.map (ZMod.castHom (m := q) dvd_rfl F)).coeff j := by
      change (Scheme.ΓSpecIso (.of F)).hom
          ((rootTupleAffinePoint q (2 * d) F y).appTop
            ((universalProperPairRemainder (ZMod q) d g hg).coeff j)) = _
        at hleft
      exact hleft
    have hcoeff := congrArg (fun p : Polynomial F => p.coeff j) hmod
    rw [Polynomial.coeff_map] at hcoeff
    rw [zmodBaseChange_evaluate q F]
    simpa [residuePoint] using hleft'.trans hcoeff

theorem affineRootPermutation_universalTwoBlockPolynomial
    (K : Type*) [Field K] (d : ℕ)
    (π : Fin 2 → Equiv.Perm (Fin d)) (b : Fin 2) :
