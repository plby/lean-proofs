/-- Source-geometric target before discarding the common summand.  For each
canonical progression modulus it asks for one common Frobenius family and a
reduced family over every residue unit, with the literal raw point-count
Lefschetz formula and Sawin's representation-specific weight/rank bounds. -/
def HasProgressionThreeBlockCommonSummandCohomology
    (q : ℕ) [Fact q.Prime] : Prop :=
  ∀ k : ℕ, ∀ hk : 1000 ≤ k,
    let r := Construction.canonicalDegreeIndex k
    let d := 2 * r
    let m := k ^ 2
    let radius := SawinSpecialization.sawinLemma914FrobeniusRadius q d m
    ∃ topDegree : ℕ,
      Nonempty (ThreeBlockCommonSummandCohomologyData.{0}
        ℚ_[2] ((ProgressionQuotient q k)ˣ) topDegree d
        (fun u => progressionFullDistinctThreeBlockPointTrace
          q k r 2 (by omega) (by
            have hrange := Construction.modulus_degree_in_sawin_range
              (by omega : 3 ≤ k)
            omega) u)
        (padicToComplex 2) radius
        (SawinSpecialization.sawinLemma914AverageTraceRank d m))

/-- The concrete canonical splitting supplies the source-geometric package
used by the arithmetic reduction. -/
theorem hasProgressionThreeBlockCommonSummandCohomology_of_canonicalSplit
    (q : ℕ) [Fact q.Prime]
    (hgeom : HasCanonicalProgressionThreeBlockSplitCohomology q) :
    HasProgressionThreeBlockCommonSummandCohomology q := by
  intro k hk
  dsimp only
  obtain ⟨topDegree, hfinite, data, _hraw⟩ := hgeom k hk
  exact ⟨topDegree, ⟨data.toCommonSummand⟩⟩

/-- The degreewise common/reduced splitting produces the exact common-main
virtual-character package consumed by the centered progression estimate. -/
theorem hasCommonMainThreeBlockVirtualCohomology_of_progressionDecomposition
    (q : ℕ) [Fact q.Prime]
    (hgeom : HasProgressionThreeBlockCommonSummandCohomology q) :
    HasCommonMainThreeBlockVirtualCohomology q := by
  intro k hk
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let m := k ^ 2
  let radius := SawinSpecialization.sawinLemma914FrobeniusRadius q d m
  have hkm : k ^ 2 ≤ 3 * (2 * r) := by
    have hrange := Construction.modulus_degree_in_sawin_range
      (by omega : 3 ≤ k)
    dsimp only [r]
    omega
  obtain ⟨topDegree, ⟨data⟩⟩ := hgeom k hk
  refine ⟨topDegree, data.mainTrace, ?_⟩
  intro u
  refine ⟨?_⟩
  change ThreeBlockVirtualCharacterCohomologyData.{0}
    ℚ_[2] topDegree d
      (fun pi => progressionFullDistinctThreeBlockPointTrace
        q k r 2 (by omega) hkm u pi - data.mainTrace pi)
      (padicToComplex 2) radius
      (SawinSpecialization.sawinLemma914AverageTraceRank d m)
  exact data.reducedVirtualCharacterCohomologyData u

