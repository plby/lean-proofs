    FullResidueUnitFiberBlockwiseDistinct
        K d m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiber K (3 * d) m g hg hdeg hm hmn t :=
  (FullResidueUnitFiberBlockwiseDistinctOpen
    K d m g hg hdeg hm hmn t).ι

instance fullResidueUnitFiberBlockwiseDistinctι_isOpenImmersion
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) :
    IsOpenImmersion (fullResidueUnitFiberBlockwiseDistinctι
