  rw [unitProgressionEqualDegreeDistinctThreePrimeWeightSum_progressionUnit
      q k r a ha,
    average_unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r]
    at hbound
  have hbound' :
      ‖(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℂ) -
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
            (progressionTotient q k : ℂ)‖ ≤
        (((6 * d ^ 3) * sawinLemma914EqualDegreeError q d m : ℕ) : ℝ) := by
    calc
      ‖(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℂ) -
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
            (progressionTotient q k : ℂ)‖ ≤
          2 * ((sawinLemma914AverageTraceRank d m : ℝ) *
            (sawinLemma914FrobeniusRadius q d m : ℝ) +
            (0 : ℝ) * (sawinLemma914FrobeniusRadius q d m : ℝ)) := by
        simpa only [r, d, m, Nat.cast_zero] using hbound
      _ = 2 * (sawinLemma914AverageTraceRank d m : ℝ) *
          (sawinLemma914FrobeniusRadius q d m : ℝ) := by ring
      _ = (((6 * d ^ 3) * sawinLemma914EqualDegreeError q d m : ℕ) : ℝ) :=
        two_mul_sawinLemma914AverageTraceRank_mul_radius q d m
  calc
    |(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℝ) -
        (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℝ) /
          (progressionTotient q k : ℝ)| =
        ‖(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℂ) -
          (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
            (progressionTotient q k : ℂ)‖ := by
      have heq :
          (progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℂ) -
              (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
                (progressionTotient q k : ℂ) =
            (((progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℝ) -
              (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℝ) /
                (progressionTotient q k : ℝ) : ℝ) : ℂ) := by
        simp only [Complex.ofReal_sub, Complex.ofReal_div,
          Complex.ofReal_natCast]
      rw [heq]
      exact (Complex.norm_real _).symm
    _ ≤ (((6 * d ^ 3) * sawinLemma914EqualDegreeError q d m : ℕ) : ℝ) :=
      hbound'
    _ = ((6 * (2 * Construction.canonicalDegreeIndex k) ^ 3) *
        sawinLemma914EqualDegreeError q
          (2 * Construction.canonicalDegreeIndex k) (k ^ 2) : ℕ) := by
      rfl

/-- The coefficient of the Frobenius radius in the ordered, weighted
Lemma 9.14 envelope, including the sum over all progression characters.
Thus `rankBudget * frobeniusRadius` is definitionally the natural-number
right side of `HasSawinLemma914OrderedWeightedFourierCancellation`. -/
def sawinLemma914TraceRankBudget (k d m : ℕ) : ℕ :=
  progressionTotient q k *
    ((6 * d ^ 3) *
      (2 ^ (m + 1) * equalDegreeMultinomial d *
        2 ^ (28 * (3 * d - m))))

theorem sawinLemma914_rankBudget_mul_radius (k d m : ℕ) :
    sawinLemma914TraceRankBudget q k d m *
        sawinLemma914FrobeniusRadius q d m =
      progressionTotient q k *
        ((6 * d ^ 3) * sawinLemma914EqualDegreeError q d m) := by
  unfold sawinLemma914TraceRankBudget sawinLemma914FrobeniusRadius
    sawinLemma914EqualDegreeError
  ring

/-- Exact certificate interface delivered by the geometric part of Sawin's
argument.  For every canonical progression, the ordered Fourier error must
be a sum of eigenvalues in the two adjacent cohomological degrees; every
eigenvalue obeys the upward-rounded Deligne radius, and the sum of the two
ranks obeys the characteristic-cycle budget.  Unlike a bare norm bound,
this records separately the trace formula, the weight estimate, and the
Betti-number estimate which the geometric formalization has to construct. -/
def HasSawinLemma914TwoDegreeTraceCertificates : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let radius := sawinLemma914FrobeniusRadius q d (k ^ 2)
      let rankBudget := sawinLemma914TraceRankBudget q k d (k ^ 2)
      ∃ lowerRank upperRank : ℕ,
        lowerRank + upperRank ≤ rankBudget ∧
          Nonempty (TwoDegreeTraceCertificate
              (orderedWeightedPrimeTripleFourierError q k r a ha)
              lowerRank upperRank radius radius)

/-- Once the trace formula, Deligne radii, and characteristic-cycle rank
budget have been supplied, the literal Lemma 9.14 Fourier estimate is a
finite triangle inequality. -/
theorem hasSawinLemma914OrderedWeightedFourierCancellation_of_twoDegreeTrace
    (htrace : HasSawinLemma914TwoDegreeTraceCertificates q) :
    HasSawinLemma914OrderedWeightedFourierCancellation q := by
  intro k hk a ha
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let radius := sawinLemma914FrobeniusRadius q d (k ^ 2)
  let rankBudget := sawinLemma914TraceRankBudget q k d (k ^ 2)
  obtain ⟨lowerRank, upperRank, hrank, ⟨certificate⟩⟩ := htrace k hk a ha
  have hnorm := certificate.norm_error_le_nat
  have hmul :
      (lowerRank * radius + upperRank * radius : ℕ) ≤
        rankBudget * radius := by
    rw [← Nat.add_mul]
    exact Nat.mul_le_mul_right radius hrank
  calc
    ‖orderedWeightedPrimeTripleFourierError q k r a ha‖ ≤
        ((lowerRank * radius + upperRank * radius : ℕ) : ℝ) := hnorm
    _ ≤ ((rankBudget * radius : ℕ) : ℝ) := by exact_mod_cast hmul
    _ = ((progressionTotient q k *
          ((6 * d ^ 3) *
            sawinLemma914EqualDegreeError q d (k ^ 2)) : ℕ) : ℝ) := by
      rw [sawinLemma914_rankBudget_mul_radius]
    _ = ((progressionTotient q k *
          ((6 * (2 * Construction.canonicalDegreeIndex k) ^ 3) *
            sawinLemma914EqualDegreeError q
              (2 * Construction.canonicalDegreeIndex k) (k ^ 2)) : ℕ) : ℝ) := by
      rfl

/-- Matrix-level geometric interface for the same specialization.  It asks
for actual Frobenius endomorphism matrices rather than pre-enumerated
eigenvalues.  Their characteristic-polynomial root bounds are the literal
form of the weight input used in Proposition 7.1. -/
def HasSawinLemma914TwoDegreeFrobeniusMatrices : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      let r := Construction.canonicalDegreeIndex k
      let d := 2 * r
      let radius := sawinLemma914FrobeniusRadius q d (k ^ 2)
      let rankBudget := sawinLemma914TraceRankBudget q k d (k ^ 2)
      ∃ lowerRank upperRank : ℕ,
        lowerRank + upperRank ≤ rankBudget ∧
          Nonempty (TwoDegreeFrobeniusMatrices
              (orderedWeightedPrimeTripleFourierError q k r a ha)
              lowerRank upperRank radius radius)

/-- Actual two-degree Frobenius matrices with the trace, weight, and rank
properties imply the source Fourier cancellation estimate. -/
theorem hasSawinLemma914OrderedWeightedFourierCancellation_of_frobeniusMatrices
    (hgeom : HasSawinLemma914TwoDegreeFrobeniusMatrices q) :
    HasSawinLemma914OrderedWeightedFourierCancellation q := by
  intro k hk a ha
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let radius := sawinLemma914FrobeniusRadius q d (k ^ 2)
  let rankBudget := sawinLemma914TraceRankBudget q k d (k ^ 2)
  obtain ⟨lowerRank, upperRank, hrank, ⟨data⟩⟩ := hgeom k hk a ha
  have hnorm := data.norm_error_le
  have hmul :
      (lowerRank * radius + upperRank * radius : ℕ) ≤
        rankBudget * radius := by
    rw [← Nat.add_mul]
    exact Nat.mul_le_mul_right radius hrank
  calc
    ‖orderedWeightedPrimeTripleFourierError q k r a ha‖ ≤
        ((lowerRank * radius + upperRank * radius : ℕ) : ℝ) := by
      simpa only [Nat.cast_add, Nat.cast_mul] using hnorm
    _ ≤ ((rankBudget * radius : ℕ) : ℝ) := by exact_mod_cast hmul
    _ = ((progressionTotient q k *
          ((6 * d ^ 3) *
            sawinLemma914EqualDegreeError q d (k ^ 2)) : ℕ) : ℝ) := by
      rw [sawinLemma914_rankBudget_mul_radius]
    _ = ((progressionTotient q k *
          ((6 * (2 * Construction.canonicalDegreeIndex k) ^ 3) *
            sawinLemma914EqualDegreeError q
              (2 * Construction.canonicalDegreeIndex k) (k ^ 2)) : ℕ) : ℝ) := by
      rfl

/-- The exact norm/distance identity converts the literal character-sum
cancellation theorem into the source's ordered factorization-sum form. -/
theorem hasSawinLemma914SourceFactorizationSumDeviation_of_orderedWeightedFourier
    (hfourier : HasSawinLemma914OrderedWeightedFourierCancellation q) :
    HasSawinLemma914SourceFactorizationSumDeviation q := by
  intro k hk a ha
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let W := 6 * d ^ 3
  have h := hfourier k hk a ha
  dsimp only at h
  have hnorm :=
    norm_orderedWeightedPrimeTripleFourierError_eq_dist q k r a ha
  change Nat.dist
      (∑ _T : RepresentationFamilies.PrimeTripleOrdering q r,
        RepresentationFamilies.primeTripleOrderingWeight r)
      (progressionTotient q k *
        ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k r a,
          RepresentationFamilies.primeTripleOrderingWeight r) ≤
    progressionTotient q k *
      (W * sawinLemma914EqualDegreeError q d (k ^ 2))
  rw [hnorm] at h
  exact_mod_cast h

/-- The checked global and progression mass identities turn the literal
factorization-function sum into the ordered weighted cardinality form. -/
theorem hasSawinLemma914OrderedWeighted_of_sourceFactorizationSum
    (hsource : HasSawinLemma914SourceFactorizationSumDeviation q) :
    HasSawinLemma914OrderedWeightedDeviation q := by
  intro k hk a ha
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let W := 6 * d ^ 3
  let N := Nat.choose (primePolynomialCount q d) 3
  let C := (RepresentationFamilies.congruentPrimeTriples q k r a).card
  have h := hsource k hk a ha
  have hglobal := sum_primeTripleOrderingWeight q r
  have hprogression :=
    RepresentationFamilies.sum_congruentPrimeTripleOrderingWeight q k r a
  change Nat.dist (W * N)
      (progressionTotient q k * (W * C)) ≤
    progressionTotient q k *
      (W * sawinLemma914EqualDegreeError q d (k ^ 2))
  rw [show W * N =
      ∑ _T : RepresentationFamilies.PrimeTripleOrdering q r,
        RepresentationFamilies.primeTripleOrderingWeight r by
        simpa only [W, N, d] using hglobal.symm,
    show W * C =
      ∑ _T : RepresentationFamilies.CongruentPrimeTripleOrdering q k r a,
        RepresentationFamilies.primeTripleOrderingWeight r by
        simpa only [W, C, d] using hprogression.symm]
  simpa only [r, d, W] using h

/-- Cancellation of the positive common factor `6 * (2d)^3` converts
Sawin's ordered factorization-function estimate to the unweighted
prime-triple deviation. -/
theorem hasSawinLemma914NatDeviation_of_orderedWeighted
    (hordered : HasSawinLemma914OrderedWeightedDeviation q) :
    HasSawinLemma914NatDeviation q := by
  intro k hk a ha
  let d := 2 * Construction.canonicalDegreeIndex k
  let W := 6 * d ^ 3
  let N := Nat.choose (primePolynomialCount q d) 3
  let C := (RepresentationFamilies.congruentPrimeTriples q k
    (Construction.canonicalDegreeIndex k) a).card
  let φ := progressionTotient q k
  let E := sawinLemma914EqualDegreeError q d (k ^ 2)
  have hW : 0 < W := by
    dsimp only [W, d, Construction.canonicalDegreeIndex]
    positivity
  have h := hordered k hk a ha
  have hleft : Nat.dist (W * N) (φ * (W * C)) =
      W * Nat.dist N (φ * C) := by
    rw [show φ * (W * C) = W * (φ * C) by ring,
      Nat.dist_mul_left]
  have hright : φ * (W * E) = W * (φ * E) := by ring
  rw [show 2 * Construction.canonicalDegreeIndex k = d by rfl]
  change Nat.dist N (φ * C) ≤ φ * E
  apply Nat.le_of_mul_le_mul_left _ hW
  rw [← hleft, ← hright]
  simpa only [d, W, N, C, φ, E] using h

/-- The remaining analytic kernel, stated directly on the nontrivial part
of the exact Fourier expansion.  Its proof is the equal-degree specialization
of Sawin's Theorem 1.7 followed by the repeated-factor analysis in
Lemmas 9.12--9.14; Lemma 9.9 alone concerns the von-Mangoldt convolution and
does not yet give this distinct-prime statement. -/
def HasEqualDegreeFourierCancellation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      ‖primeTripleFourierError q k
          (Construction.canonicalDegreeIndex k) a ha‖ ≤
        ((progressionTotient q k *
          sievedEqualDegreeError q (2 * Construction.canonicalDegreeIndex k)
            (k ^ 2) : ℕ) : ℝ)

/-- The direct closed-form specialization of Sawin's Lemma 9.14, before
replacing its θ = 20/21 coefficient by the simpler binary sieve envelope. -/
def HasSawinLemma914Specialization : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      ‖primeTripleFourierError q k
          (Construction.canonicalDegreeIndex k) a ha‖ ≤
        ((progressionTotient q k *
          sawinLemma914EqualDegreeError q
            (2 * Construction.canonicalDegreeIndex k) (k ^ 2) : ℕ) : ℝ)

/-- The source's natural counting deviation is exactly the norm of the
nontrivial Fourier contribution, with no loss in constants. -/
theorem hasSawinLemma914Specialization_of_natDeviation
    (hnat : HasSawinLemma914NatDeviation q) :
    HasSawinLemma914Specialization q := by
  intro k hk a ha
  let d := Construction.canonicalDegreeIndex k
  let N := Nat.choose (primePolynomialCount q (2 * d)) 3
  let C := (RepresentationFamilies.congruentPrimeTriples q k d a).card
  let φ := progressionTotient q k
  let E := sawinLemma914EqualDegreeError q (2 * d) (k ^ 2)
  let e := primeTripleFourierError q k d a ha
  have hid := primeTriple_main_add_fourierError q k d a ha
  have hid' : (N : ℂ) + e = ((φ * C : ℕ) : ℂ) := by
    simpa only [N, e, φ, C, Nat.cast_mul] using hid
  have he : e = -((N : ℂ) - (φ * C : ℕ)) := by
    rw [neg_sub]
    exact eq_sub_of_add_eq (by simpa only [add_comm] using hid')
  have hdist : Nat.dist N (φ * C) ≤ φ * E := by
    simpa only [N, C, φ, E, d] using hnat k hk a ha
  rw [show primeTripleFourierError q k
      (Construction.canonicalDegreeIndex k) a ha = e by rfl,
    he, norm_neg, norm_natCast_sub_natCast_eq_dist]
  exact_mod_cast hdist

/-- The checked coefficient comparison turns the literal Lemma 9.14
specialization into the cancellation interface used downstream. -/
theorem hasEqualDegreeFourierCancellation_of_sawinLemma914
    (hsawin : HasSawinLemma914Specialization q) :
    HasEqualDegreeFourierCancellation q := by
  intro k hk a ha
  have hsource := hsawin k hk a ha
  have henvelope :=
    canonical_sawinLemma914EqualDegreeError_le_sieved q hk
  calc
    ‖primeTripleFourierError q k
        (Construction.canonicalDegreeIndex k) a ha‖ ≤
        ((progressionTotient q k *
          sawinLemma914EqualDegreeError q
            (2 * Construction.canonicalDegreeIndex k) (k ^ 2) : ℕ) : ℝ) :=
      hsource
    _ ≤ ((progressionTotient q k *
          sievedEqualDegreeError q
            (2 * Construction.canonicalDegreeIndex k) (k ^ 2) : ℕ) : ℝ) := by
      exact_mod_cast Nat.mul_le_mul_left (progressionTotient q k) henvelope

/-- Source-facing form of the same target estimate: the distinct-prime
progression count differs from its global binomial main term by at most the
cross-multiplied error envelope.  This is the form obtained after carrying
Sawin's repeated-factor sieve through Lemmas 9.12--9.14. -/
def HasEqualDegreePrimeTripleDeviation : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    ∀ ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a,
      ‖((Nat.choose
            (primePolynomialCount q
              (2 * Construction.canonicalDegreeIndex k)) 3 : ℕ) : ℂ) -
          ((progressionTotient q k *
            (RepresentationFamilies.congruentPrimeTriples q k
              (Construction.canonicalDegreeIndex k) a).card : ℕ) : ℂ)‖ ≤
        ((progressionTotient q k *
          sievedEqualDegreeError q (2 * Construction.canonicalDegreeIndex k)
            (k ^ 2) : ℕ) : ℝ)

/-- The source-facing progression deviation is exactly the norm of the
nontrivial-character contribution, by the checked finite Fourier identity. -/
theorem hasEqualDegreeFourierCancellation_of_primeTripleDeviation
    (hdev : HasEqualDegreePrimeTripleDeviation q) :
    HasEqualDegreeFourierCancellation q := by
  intro k hk a ha
  let d := Construction.canonicalDegreeIndex k
  let N := Nat.choose (primePolynomialCount q (2 * d)) 3
  let C := (RepresentationFamilies.congruentPrimeTriples q k d a).card
  let φ := progressionTotient q k
  let e := primeTripleFourierError q k d a ha
  have hid := primeTriple_main_add_fourierError q k d a ha
  have hid' : (N : ℂ) + e = ((φ * C : ℕ) : ℂ) := by
    simpa only [N, e, φ, C, Nat.cast_mul] using hid
  have he : e = -((N : ℂ) - (φ * C : ℕ)) := by
    rw [neg_sub]
    exact eq_sub_of_add_eq (by simpa only [add_comm] using hid')
  rw [show primeTripleFourierError q k
      (Construction.canonicalDegreeIndex k) a ha = e by rfl, he, norm_neg]
  simpa only [d, N, C, φ] using hdev k hk a ha

/-- Cross-multiplied, one-sided form of the precise equal-degree
progression estimate.  This is strictly more informative than the final
abundance condition: it compares the residue-class count with the global
binomial main term and exposes Sawin's published error term. -/
def HasEqualDegreeSawinBound : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    (∀ i < k, ¬ auxiliaryIrreducible q i ∣ a) →
    Nat.choose (primePolynomialCount q (2 * Construction.canonicalDegreeIndex k)) 3 ≤
      progressionTotient q k *
        ((RepresentationFamilies.congruentPrimeTriples q k
          (Construction.canonicalDegreeIndex k) a).card +
            sievedEqualDegreeError q
              (2 * Construction.canonicalDegreeIndex k) (k ^ 2))

/-- The nontrivial-character cancellation estimate implies the exact
cross-multiplied cardinality bound used downstream. -/
theorem hasEqualDegreeSawinBound_of_fourierCancellation
    (hcancel : HasEqualDegreeFourierCancellation q) :
    HasEqualDegreeSawinBound q := by
  intro k hk a ha
  let d := Construction.canonicalDegreeIndex k
  let N := Nat.choose (primePolynomialCount q (2 * d)) 3
  let C := (RepresentationFamilies.congruentPrimeTriples q k d a).card
  let φ := progressionTotient q k
  let E := sievedEqualDegreeError q (2 * d) (k ^ 2)
  let e := primeTripleFourierError q k d a ha
  have hid := primeTriple_main_add_fourierError q k d a ha
  have hre := congrArg Complex.re hid
  have hre' : (N : ℝ) + e.re = (φ * C : ℕ) := by
    simpa only [N, C, φ, e, Complex.add_re, Complex.natCast_re,
      Complex.mul_re, Complex.natCast_im, mul_zero, zero_mul, sub_zero,
      Nat.cast_mul] using hre
  have he : ‖e‖ ≤ ((φ * E : ℕ) : ℝ) := by
    simpa only [e, φ, E, d] using hcancel k hk a ha
  have here : |e.re| ≤ ‖e‖ := Complex.abs_re_le_norm e
  have hreal : (N : ℝ) ≤ ((φ * (C + E) : ℕ) : ℝ) := by
    calc
      (N : ℝ) = (φ * C : ℕ) - e.re := by linarith
      _ ≤ (φ * C : ℕ) + |e.re| := by
        linarith [neg_le_abs e.re]
      _ ≤ (φ * C : ℕ) + ‖e‖ := by gcongr
      _ ≤ (φ * C : ℕ) + (φ * E : ℕ) := by gcongr
      _ = ((φ * (C + E) : ℕ) : ℝ) := by push_cast; ring
  exact_mod_cast hreal

/-- The purely elementary comparison left after Sawin's estimate: its global
binomial main term dominates both the explicit error and the number of trials
needed by the probability argument. -/
def MainTermDominates (required : ℕ → ℕ) : Prop :=
  ∀ k : ℕ, 1000 ≤ k →
    progressionTotient q k *
        (required k +
          sievedEqualDegreeError q
            (2 * Construction.canonicalDegreeIndex k) (k ^ 2)) <
      Nat.choose (primePolynomialCount q
        (2 * Construction.canonicalDegreeIndex k)) 3

/-- Once the explicit main term exceeds the Sawin error plus a requested
reserve `L`, the residue class contains at least `L` unordered triples. -/
theorem count_le_of_equalDegreeSawinBound
    (hSawin : HasEqualDegreeSawinBound q) {k L : ℕ} (hk : 1000 ≤ k)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k, ¬ auxiliaryIrreducible q i ∣ a)
    (hmain : progressionTotient q k *
        (L + sievedEqualDegreeError q
          (2 * Construction.canonicalDegreeIndex k) (k ^ 2)) <
      Nat.choose (primePolynomialCount q
        (2 * Construction.canonicalDegreeIndex k)) 3) :
    L ≤ (RepresentationFamilies.congruentPrimeTriples q k
      (Construction.canonicalDegreeIndex k) a).card := by
  let C := (RepresentationFamilies.congruentPrimeTriples q k
    (Construction.canonicalDegreeIndex k) a).card
  let E := sievedEqualDegreeError q
    (2 * Construction.canonicalDegreeIndex k) (k ^ 2)
  let φ := progressionTotient q k
  have hbound : Nat.choose (primePolynomialCount q
      (2 * Construction.canonicalDegreeIndex k)) 3 ≤ φ * (C + E) := by
    simpa only [φ, C, E] using hSawin k hk a ha
  have hφ : 0 < φ := by
    simpa only [φ] using progressionTotient_pos q k
  by_contra hnot
  have hCL : C < L := by omega
  have hmul : φ * (C + E) < φ * (L + E) :=
    Nat.mul_lt_mul_of_pos_left (Nat.add_lt_add_right hCL E) hφ
  have hmain' : φ * (L + E) < Nat.choose (primePolynomialCount q
      (2 * Construction.canonicalDegreeIndex k)) 3 := by
    simpa only [φ, E] using hmain
  have himpossible := hbound.trans_lt (hmul.trans hmain')
  exact (Nat.lt_irrefl _ himpossible)

/-! ### Realizing the two Frobenius matrices as an honest cochain complex -/

/-- The zero-differential three-term complex whose first two terms have the
prescribed finite dimensions.  This is the algebraic model used to package
the two adjacent compact-support cohomology groups of a residue fiber. -/
noncomputable def matrixCohomologyComplex (lowerRank upperRank : ℕ) :
    ThreeTermCochainComplex ℂ
      (Fin lowerRank → ℂ) (Fin upperRank → ℂ) (Fin 0 → ℂ) where
  d₀ := 0
  d₁ := 0
  d_comp := by simp

/-- The cochain endomorphism induced by the lower Frobenius matrix and the
negative of the upper Frobenius matrix. -/
noncomputable def matrixCohomologyFrobenius
    {lowerRank upperRank : ℕ}
    (lower : Matrix (Fin lowerRank) (Fin lowerRank) ℂ)
    (upper : Matrix (Fin upperRank) (Fin upperRank) ℂ) :
    ThreeTermCochainEndomorphism
      (matrixCohomologyComplex lowerRank upperRank) where
  f₀ := lower.toLin'
  f₁ := (-upper).toLin'
  f₂ := 0
  comm₀ := by simp [matrixCohomologyComplex]
  comm₁ := by simp [matrixCohomologyComplex]

noncomputable def matrixCohomologyH₀Equiv (lowerRank upperRank : ℕ) :
    (matrixCohomologyComplex lowerRank upperRank).homology₀ ≃ₗ[ℂ]
      (Fin lowerRank → ℂ) where
  toFun x := x.1
  invFun x := ⟨x, by simp [matrixCohomologyComplex]⟩
  left_inv x := by ext; rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem matrixCohomologyH₀Equiv_conj
    {lowerRank upperRank : ℕ}
    (lower : Matrix (Fin lowerRank) (Fin lowerRank) ℂ)
    (upper : Matrix (Fin upperRank) (Fin upperRank) ℂ) :
    (matrixCohomologyH₀Equiv lowerRank upperRank).conj
        ((matrixCohomologyComplex lowerRank upperRank).homology₀End
          (matrixCohomologyFrobenius lower upper)) = lower.toLin' := by
  apply LinearMap.ext
  intro x
  rfl

noncomputable def matrixCohomologyCycle₁Equiv (lowerRank upperRank : ℕ) :
    LinearMap.ker (matrixCohomologyComplex lowerRank upperRank).d₁ ≃ₗ[ℂ]
      (Fin upperRank → ℂ) where
  toFun x := x.1
  invFun x := ⟨x, by simp [matrixCohomologyComplex]⟩
  left_inv x := by ext; rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem matrixCohomology_middleBoundary_eq_bot (lowerRank upperRank : ℕ) :
    (matrixCohomologyComplex lowerRank upperRank).middleBoundary = ⊥ := by
  unfold ThreeTermCochainComplex.middleBoundary
  change (LinearMap.range
      (0 : (Fin lowerRank → ℂ) →ₗ[ℂ] (Fin upperRank → ℂ))).comap
        (LinearMap.ker
          (0 : (Fin upperRank → ℂ) →ₗ[ℂ] (Fin 0 → ℂ))).subtype = ⊥
  rw [LinearMap.range_zero]
  ext x
  constructor
  · intro hx
    change (x : Fin upperRank → ℂ) = 0 at hx
    apply Subtype.ext
    exact hx
  · intro hx
    rw [Submodule.mem_bot] at hx
    subst x
    exact Submodule.zero_mem _

noncomputable def matrixCohomologyH₁Equiv (lowerRank upperRank : ℕ) :
    (matrixCohomologyComplex lowerRank upperRank).homology₁ ≃ₗ[ℂ]
      (Fin upperRank → ℂ) :=
  ((matrixCohomologyComplex lowerRank upperRank).middleBoundary.quotEquivOfEqBot
      (matrixCohomology_middleBoundary_eq_bot lowerRank upperRank)).trans
    (matrixCohomologyCycle₁Equiv lowerRank upperRank)

theorem matrixCohomologyH₁Equiv_conj
    {lowerRank upperRank : ℕ}
    (lower : Matrix (Fin lowerRank) (Fin lowerRank) ℂ)
    (upper : Matrix (Fin upperRank) (Fin upperRank) ℂ) :
    (matrixCohomologyH₁Equiv lowerRank upperRank).conj
        ((matrixCohomologyComplex lowerRank upperRank).homology₁End
          (matrixCohomologyFrobenius lower upper)) = (-upper).toLin' := by
  apply LinearMap.ext
  intro x
  rfl

theorem matrixCohomology_homology₀_finrank
    (lowerRank upperRank : ℕ) :
    Module.finrank ℂ
      (matrixCohomologyComplex lowerRank upperRank).homology₀ = lowerRank := by
  change Module.finrank ℂ
    (LinearMap.ker (0 : (Fin lowerRank → ℂ) →ₗ[ℂ] (Fin upperRank → ℂ))) = _
  rw [LinearMap.ker_zero]
  simp

theorem matrixCohomology_homology₁_finrank
    (lowerRank upperRank : ℕ) :
    Module.finrank ℂ
      (matrixCohomologyComplex lowerRank upperRank).homology₁ = upperRank := by
  change Module.finrank ℂ
    ((LinearMap.ker (0 : (Fin upperRank → ℂ) →ₗ[ℂ] (Fin 0 → ℂ))) ⧸
      ((LinearMap.range (0 : (Fin lowerRank → ℂ) →ₗ[ℂ]
        (Fin upperRank → ℂ))).comap
          (LinearMap.ker (0 : (Fin upperRank → ℂ) →ₗ[ℂ]
            (Fin 0 → ℂ))).subtype)) = _
  let d₀ : (Fin lowerRank → ℂ) →ₗ[ℂ] (Fin upperRank → ℂ) := 0
  let d₁ : (Fin upperRank → ℂ) →ₗ[ℂ] (Fin 0 → ℂ) := 0
  let B : Submodule ℂ (LinearMap.ker d₁) :=
    (LinearMap.range d₀).comap (LinearMap.ker d₁).subtype
  change Module.finrank ℂ ((LinearMap.ker d₁) ⧸ B) = upperRank
  have hB : B = ⊥ := by
    ext x
    simp [B, d₀]
  rw [B.finrank_quotient, hB]
  have hker : LinearMap.ker d₁ = ⊤ := LinearMap.ker_zero
  rw [hker]
  simp

theorem matrixCohomology_homology₂_finrank
    (lowerRank upperRank : ℕ) :
    Module.finrank ℂ
      (matrixCohomologyComplex lowerRank upperRank).homology₂ = 0 := by
  change Module.finrank ℂ
    ((Fin 0 → ℂ) ⧸
      LinearMap.range (0 : (Fin upperRank → ℂ) →ₗ[ℂ] (Fin 0 → ℂ))) = 0
  let d₁ : (Fin upperRank → ℂ) →ₗ[ℂ] (Fin 0 → ℂ) := 0
  change Module.finrank ℂ ((Fin 0 → ℂ) ⧸ LinearMap.range d₁) = 0
  rw [(LinearMap.range d₁).finrank_quotient]
  simp

/-- Any two finite-dimensional Frobenius matrices can be realized as the two
nonzero homology actions of a three-term cochain complex, without losing trace
or spectral information. -/
noncomputable def TwoDegreeFrobeniusMatrices.toThreeTermFrobeniusModel
    {error : ℂ} {lowerRank upperRank : ℕ} {radius : ℝ}
    (data : TwoDegreeFrobeniusMatrices error lowerRank upperRank radius radius) :
    ThreeTermFrobeniusModel error radius where
  C₀ := Fin lowerRank → ℂ
  C₁ := Fin upperRank → ℂ
  C₂ := Fin 0 → ℂ
  complex := matrixCohomologyComplex lowerRank upperRank
  frobenius := matrixCohomologyFrobenius
    data.lowerFrobenius data.upperFrobenius
  error_eq_alternating_trace := by
    dsimp only [matrixCohomologyFrobenius]
    simp only [Matrix.trace_toLin'_eq, Matrix.trace_neg,
      map_zero, sub_neg_eq_add, add_zero]
    exact data.error_eq_trace
  top_finrank_eq_zero :=
    matrixCohomology_homology₂_finrank lowerRank upperRank
  lower_root_norm_le := by
    intro z hz
    rw [endomorphismMatrixOfFinrankEq_charpoly] at hz
    rw [← (matrixCohomologyH₀Equiv lowerRank upperRank).charpoly_conj] at hz
    rw [matrixCohomologyH₀Equiv_conj, Matrix.charpoly_toLin'] at hz
    exact data.lower_root_norm_le z hz
  upper_root_norm_le := by
    intro z hz
    rw [endomorphismMatrixOfFinrankEq_charpoly] at hz
    rw [← (matrixCohomologyH₁Equiv lowerRank upperRank).charpoly_conj] at hz
    rw [matrixCohomologyH₁Equiv_conj, Matrix.charpoly_toLin'] at hz
    exact matrix_neg_root_norm_le data.upperFrobenius radius
      data.upper_root_norm_le z hz

theorem TwoDegreeFrobeniusMatrices.toThreeTermFrobeniusModel_cohomologyRank
    {error : ℂ} {lowerRank upperRank : ℕ} {radius : ℝ}
    (data : TwoDegreeFrobeniusMatrices error lowerRank upperRank radius radius) :
    data.toThreeTermFrobeniusModel.cohomologyRank = lowerRank + upperRank := by
  unfold ThreeTermFrobeniusModel.cohomologyRank
  change Module.finrank ℂ
      (matrixCohomologyComplex lowerRank upperRank).homology₀ +
    Module.finrank ℂ
      (matrixCohomologyComplex lowerRank upperRank).homology₁ = _
  rw [matrixCohomology_homology₀_finrank,
    matrixCohomology_homology₁_finrank]

end SawinSpecialization

namespace SawinGeometry

/-- The exact finite-dimensional output needed from compactly-supported
cohomology of one actual residue-unit fiber.  The two matrices represent the
two adjacent nonzero compact-support cohomology groups.  A common parity shift
has been absorbed into both actions, so Grothendieck--Lefschetz has the
displayed `lower - upper` form. -/
structure ResidueUnitFiberCompactSupportData
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (t : ResidueUnitPoint (ZMod q) m g)
    (traceValue : ℂ) (radius : ℝ)
    (lowerRank upperRank : ℕ) where
  /-- The geometric Frobenius endomorphism of this particular fiber. -/
  geometricFrobenius :
    ResidueUnitFiber (ZMod q) n m g hg t ⟶
      ResidueUnitFiber (ZMod q) n m g hg t
  /-- Frobenius on the lower compact-support cohomology group, after a basis
  has been chosen. -/
  lowerFrobenius : Matrix (Fin lowerRank) (Fin lowerRank) ℂ
  /-- Frobenius on the adjacent upper compact-support cohomology group. -/
  upperFrobenius : Matrix (Fin upperRank) (Fin upperRank) ℂ
  /-- Specialized Grothendieck--Lefschetz trace formula. -/
  grothendieckLefschetz :
    traceValue = lowerFrobenius.trace - upperFrobenius.trace
  /-- Deligne's weight bound in the lower degree. -/
  lower_weil_bound :
    ∀ z, z ∈ lowerFrobenius.charpoly.roots → ‖z‖ ≤ radius
  /-- Deligne's weight bound in the upper degree. -/
  upper_weil_bound :
    ∀ z, z ∈ upperFrobenius.charpoly.roots → ‖z‖ ≤ radius

namespace ResidueUnitFiberCompactSupportData

/-- Compact-support data on an actual residue-unit fiber gives exactly the
two-degree matrix certificate consumed by the analytic reduction. -/
noncomputable def toTwoDegreeFrobeniusMatrices
    {q n m : ℕ} [Fact q.Prime]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {t : ResidueUnitPoint (ZMod q) m g}
    {traceValue : ℂ} {radius : ℝ} {lowerRank upperRank : ℕ}
    (data : ResidueUnitFiberCompactSupportData q n m g hg t traceValue radius
      lowerRank upperRank) :
    SawinSpecialization.TwoDegreeFrobeniusMatrices traceValue
      lowerRank upperRank radius radius where
  lowerFrobenius := data.lowerFrobenius
  upperFrobenius := -data.upperFrobenius
  error_eq_trace := by
    rw [Matrix.trace_neg]
    exact data.grothendieckLefschetz
  lower_root_norm_le := data.lower_weil_bound
  upper_root_norm_le :=
    SawinSpecialization.matrix_neg_root_norm_le data.upperFrobenius radius
      data.upper_weil_bound

/-- Equivalently, the fiber data produces the bundled three-term model used
by the final character-sum interface. -/
noncomputable def toThreeTermFrobeniusModel
    {q n m : ℕ} [Fact q.Prime]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {t : ResidueUnitPoint (ZMod q) m g}
    {traceValue : ℂ} {radius : ℝ} {lowerRank upperRank : ℕ}
    (data : ResidueUnitFiberCompactSupportData q n m g hg t traceValue radius
      lowerRank upperRank) :
    SawinSpecialization.ThreeTermFrobeniusModel traceValue radius :=
  data.toTwoDegreeFrobeniusMatrices.toThreeTermFrobeniusModel

theorem toThreeTermFrobeniusModel_cohomologyRank
    {q n m : ℕ} [Fact q.Prime]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {t : ResidueUnitPoint (ZMod q) m g}
    {traceValue : ℂ} {radius : ℝ} {lowerRank upperRank : ℕ}
    (data : ResidueUnitFiberCompactSupportData q n m g hg t traceValue radius
      lowerRank upperRank) :
    data.toThreeTermFrobeniusModel.cohomologyRank = lowerRank + upperRank :=
  data.toTwoDegreeFrobeniusMatrices.toThreeTermFrobeniusModel_cohomologyRank

/-- Two source fibers with the specialized combined Betti budget produce the
pair of three-term models expected by the final Sawin character interface. -/
theorem exists_threeTerm_models_of_pair
    {q n m : ℕ} [Fact q.Prime]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {t : ResidueUnitPoint (ZMod q) m g}
    {allTrace pairTrace : ℂ} {radius : ℝ}
    {lowerAll upperAll lowerPair upperPair budget : ℕ}
    (allData : ResidueUnitFiberCompactSupportData q n m g hg t allTrace radius
      lowerAll upperAll)
    (pairData : ResidueUnitFiberCompactSupportData q n m g hg t pairTrace radius
      lowerPair upperPair)
    (hrank : lowerAll + upperAll + 3 * (lowerPair + upperPair) ≤ budget) :
    ∃ allModel : SawinSpecialization.ThreeTermFrobeniusModel allTrace radius,
      ∃ pairModel : SawinSpecialization.ThreeTermFrobeniusModel pairTrace radius,
        allModel.cohomologyRank + 3 * pairModel.cohomologyRank ≤ budget := by
  refine ⟨allData.toThreeTermFrobeniusModel,
    pairData.toThreeTermFrobeniusModel, ?_⟩
  rw [allData.toThreeTermFrobeniusModel_cohomologyRank,
    pairData.toThreeTermFrobeniusModel_cohomologyRank]
  exact hrank

end ResidueUnitFiberCompactSupportData

end SawinGeometry

/-! ## Elementary large supports and good residue fibers -/

namespace LargeSupport

variable {α β : Type*} [Fintype α] [DecidableEq β]

/-- The finite fiber of a map from a finite type. -/
def fiber (f : α → β) (b : β) : Finset α :=
  Finset.univ.filter fun a => f a = b

/-- The finite support (image) of a map from a finite type. -/
def support (f : α → β) : Finset β :=
  Finset.univ.image f

/-- Supported fibers containing at least `threshold` points. -/
def goodFibers (f : α → β) (threshold : ℕ) : Finset β :=
  (support f).filter fun b => threshold ≤ (fiber f b).card

@[simp]
theorem mem_fiber (f : α → β) (b : β) (a : α) :
    a ∈ fiber f b ↔ f a = b := by
  simp [fiber]

@[simp]
theorem mem_support (f : α → β) (b : β) :
    b ∈ support f ↔ ∃ a, f a = b := by
  simp [support]

@[simp]
theorem mem_goodFibers (f : α → β) (threshold : ℕ) (b : β) :
    b ∈ goodFibers f threshold ↔
      (∃ a, f a = b) ∧ threshold ≤ (fiber f b).card := by
  simp [goodFibers]

/-- A finite type is the disjoint sum of the nonempty fibers of any map. -/
theorem card_eq_sum_fiber_card (f : α → β) :
    Fintype.card α = ∑ b ∈ support f, (fiber f b).card := by
  classical
  simpa only [Fintype.card, support, fiber] using
    (Finset.card_eq_sum_card_fiberwise
      (s := (Finset.univ : Finset α))
      (t := Finset.univ.image f)
      (f := f) (fun a _ha => Finset.mem_image_of_mem f (Finset.mem_univ a)))

/-- A uniform fiber ceiling forces the image support to be large. -/
theorem card_le_cap_mul_support (f : α → β) (cap : ℕ)
    (hcap : ∀ b ∈ support f, (fiber f b).card ≤ cap) :
    Fintype.card α ≤ cap * (support f).card := by
  classical
  rw [card_eq_sum_fiber_card f]
  calc
    (∑ b ∈ support f, (fiber f b).card) ≤
        ∑ _b ∈ support f, cap := by
      exact Finset.sum_le_sum fun b hb => hcap b hb
    _ = cap * (support f).card := by
      simp [Nat.mul_comm]

/-- Quantitative support pigeonhole principle. -/
theorem lt_card_support_of_cap_mul_lt_card
    (f : α → β) (cap requested : ℕ)
    (hcap : ∀ b ∈ support f, (fiber f b).card ≤ cap)
    (hlarge : cap * requested < Fintype.card α) :
    requested < (support f).card := by
  have hupper := card_le_cap_mul_support f cap hcap
  by_contra hnot
  have hmul : cap * (support f).card ≤ cap * requested :=
    Nat.mul_le_mul_left cap (by omega)
  omega

/-- Split the total mass into small fibers and uniformly bounded good fibers. -/
theorem card_le_small_mul_support_add_cap_mul_good
    (f : α → β) (threshold cap : ℕ) (hthreshold : 1 ≤ threshold)
    (hcap : ∀ b ∈ support f, (fiber f b).card ≤ cap) :
    Fintype.card α ≤
      (threshold - 1) * (support f).card +
        cap * (goodFibers f threshold).card := by
  classical
  rw [card_eq_sum_fiber_card f]
  calc
    (∑ b ∈ support f, (fiber f b).card) ≤
        ∑ b ∈ support f,
          ((threshold - 1) +
            if b ∈ goodFibers f threshold then cap else 0) := by
      apply Finset.sum_le_sum
      intro b hb
      by_cases hgood : b ∈ goodFibers f threshold
      · simp only [hgood, if_true]
        exact (hcap b hb).trans (Nat.le_add_left cap (threshold - 1))
      · simp only [hgood, if_false, add_zero]
        have hb' : ∃ a, f a = b := (mem_support f b).mp hb
        have hnle : ¬threshold ≤ (fiber f b).card := by
          intro hle
          exact hgood ((mem_goodFibers f threshold b).2 ⟨hb', hle⟩)
        have hsmall : (fiber f b).card < threshold := by omega
        omega
    _ = (threshold - 1) * (support f).card +
        cap * (goodFibers f threshold).card := by
      rw [Finset.sum_add_distrib]
      simp only [Finset.sum_const_nat]
      have hsubset : goodFibers f threshold ⊆ support f :=
        Finset.filter_subset _ _
      calc
        (support f).card * (threshold - 1) +
              ∑ x ∈ support f, (if x ∈ goodFibers f threshold then cap else 0) =
            (support f).card * (threshold - 1) +
              cap * ∑ x ∈ support f,
                (if x ∈ goodFibers f threshold then 1 else 0) := by
          congr 1
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro x _hx
          split_ifs <;> simp
        _ = (support f).card * (threshold - 1) +
              cap * (goodFibers f threshold).card := by
          rw [Finset.sum_boole, Finset.filter_mem_eq_inter,
            Finset.inter_eq_right.mpr hsubset]
          simp
        _ = (threshold - 1) * (support f).card +
              cap * (goodFibers f threshold).card := by
          rw [Nat.mul_comm (support f).card (threshold - 1)]

/-- Enough mass forces a requested number of good fibers. -/
theorem requested_le_card_goodFibers
    (f : α → β) (threshold cap supportBound requested lower : ℕ)
    (hthreshold : 1 ≤ threshold)
    (hcap : ∀ b ∈ support f, (fiber f b).card ≤ cap)
    (hsupport : (support f).card ≤ supportBound)
    (hlower : lower ≤ Fintype.card α)
    (hpressure :
      (threshold - 1) * supportBound + cap * (requested - 1) < lower) :
    requested ≤ (goodFibers f threshold).card := by
  have hupper := card_le_small_mul_support_add_cap_mul_good
    f threshold cap hthreshold hcap
  by_contra hnot
  have hgood : (goodFibers f threshold).card ≤ requested - 1 := by omega
  have hs := Nat.mul_le_mul_left (threshold - 1) hsupport
  have hg := Nat.mul_le_mul_left cap hgood
  have : Fintype.card α ≤
      (threshold - 1) * supportBound + cap * (requested - 1) :=
    hupper.trans (Nat.add_le_add hs hg)
  omega

end LargeSupport

namespace PrimeTripleFibers

open PolynomialInfrastructure RepresentationFamilies SawinSpecialization

variable (q : ℕ) [Fact q.Prime]

/-- Product residue of a prime triple in the unit group modulo `G_k`. -/
noncomputable abbrev residueUnit (k d : ℕ) :
    PrimeTriple q d → (ProgressionQuotient q k)ˣ :=
  primeTripleUnit q k d

/-- Every product-residue fiber has the monic-quotient ceiling. -/
theorem residueUnit_fiber_card_le_pow_excess (k d : ℕ)
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 6 * d)
    (u : (ProgressionQuotient q k)ˣ) :
    (LargeSupport.fiber (residueUnit q k d) u).card ≤
      q ^ (6 * d - k ^ 2) := by
  classical
  by_cases hne : (LargeSupport.fiber (residueUnit q k d) u).Nonempty
  · obtain ⟨T₀, hT₀⟩ := hne
    have hT₀u : residueUnit q k d T₀ = u :=
      (LargeSupport.mem_fiber (residueUnit q k d) u T₀).mp hT₀
    let a := normalizedResidue q k (T₀.product q)
    have haK : a.natDegree < k ^ 2 :=
      normalizedResidue_natDegree_lt q k hk (T₀.product q)
    have ha : a.natDegree < 6 * d := haK.trans_le hkm
    have hsubset : LargeSupport.fiber (residueUnit q k d) u ⊆
        congruentPrimeTriples q k d a := by
      intro T hT
      have hTu : residueUnit q k d T = u :=
        (LargeSupport.mem_fiber (residueUnit q k d) u T).mp hT
      have hunit : primeTripleUnit q k d T = primeTripleUnit q k d T₀ :=
        hTu.trans hT₀u.symm
      have hquot :
          AdjoinRoot.mk (modulusProduct q k) (T.product q) =
            AdjoinRoot.mk (modulusProduct q k) (T₀.product q) := by
        simpa only [residueUnit, primeTripleUnit_val] using
          congrArg Units.val hunit
      have hdiv : modulusProduct q k ∣ T.product q - T₀.product q :=
        AdjoinRoot.mk_eq_mk.mp hquot
      rw [mem_congruentPrimeTriples]
      exact (modulusProduct_dvd_sub_normalizedResidue_iff
        q k (T.product q) (T₀.product q)).2 hdiv
    exact (Finset.card_le_card hsubset).trans
      (congruentPrimeTriples_card_le_pow_excess q k d a ha hkm)
  · simp [Finset.not_nonempty_iff_eq_empty.mp hne]

/-- A fixed residue fiber is a matching when `4d < k²`. -/
theorem residueUnit_fiber_pairwise_disjoint (k d : ℕ)
    (hdeg : 4 * d < k ^ 2) (u : (ProgressionQuotient q k)ˣ) :
    Set.Pairwise
      {T : PrimeTriple q d | residueUnit q k d T = u}
      (fun U V => Disjoint U.1 V.1) := by
  intro U hU V hV hne
  rw [Finset.disjoint_left]
  intro f hfU hfV
  apply hne
  have hunit : primeTripleUnit q k d U = primeTripleUnit q k d V :=
    hU.trans hV.symm
  have hquot :
      AdjoinRoot.mk (modulusProduct q k) (U.product q) =
        AdjoinRoot.mk (modulusProduct q k) (V.product q) := by
    simpa only [residueUnit, primeTripleUnit_val] using
      congrArg Units.val hunit
  have hUV : modulusProduct q k ∣ U.product q - V.product q :=
    AdjoinRoot.mk_eq_mk.mp hquot
  exact primeTriple_eq_of_shared_common_residue q k d (V.product q)
    U V f hfU hfV hdeg hUV (by simp)

/-- Residue classes containing at least `threshold` prime triples. -/
noncomputable def goodResidueUnits (k d threshold : ℕ) :
    Finset (ProgressionQuotient q k)ˣ :=
  LargeSupport.goodFibers (residueUnit q k d) threshold

/-- Elementary many-good-fibers consequence for the product-residue map. -/
theorem requested_le_card_goodResidueUnits
    (k d threshold requested : ℕ)
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 6 * d) (hthreshold : 1 ≤ threshold)
    (hpressure :
      (threshold - 1) * progressionTotient q k +
          q ^ (6 * d - k ^ 2) * (requested - 1) <
        Nat.choose (primePolynomialCount q (2 * d)) 3) :
    requested ≤ (goodResidueUnits q k d threshold).card := by
  classical
  apply LargeSupport.requested_le_card_goodFibers
    (f := residueUnit q k d)
    (threshold := threshold)
    (cap := q ^ (6 * d - k ^ 2))
    (supportBound := progressionTotient q k)
    (requested := requested)
    (lower := Nat.choose (primePolynomialCount q (2 * d)) 3)
  · exact hthreshold
  · intro u _hu
    exact residueUnit_fiber_card_le_pow_excess q k d hk hkm u
  · calc
      (LargeSupport.support (residueUnit q k d)).card ≤
          Fintype.card (ProgressionQuotient q k)ˣ := Finset.card_le_univ _
      _ = progressionTotient q k := by
        simpa only [Nat.card_eq_fintype_card] using
          (progressionTotient_eq_modulusQuotient_units_natCard q k).symm
  · rw [primeTriple_card]
  · exact hpressure

/-- Gauss-count version of the good-fiber lower bound. -/
theorem requested_le_card_goodResidueUnits_of_gauss
    (k d threshold requested : ℕ)
    (hq : 2 ^ 500 ≤ q) (hk : 1 ≤ k) (hd : 1 ≤ d)
    (hkm : k ^ 2 ≤ 6 * d) (hthreshold : 1 ≤ threshold)
    (hpressure :
      192 * (2 * d) ^ 3 *
          ((threshold - 1) * progressionTotient q k +
            q ^ (6 * d - k ^ 2) * (requested - 1)) <
        q ^ (6 * d)) :
    requested ≤ (goodResidueUnits q k d threshold).card := by
  let X := (threshold - 1) * progressionTotient q k +
    q ^ (6 * d - k ^ 2) * (requested - 1)
  let C := 192 * (2 * d) ^ 3
  let N := Nat.choose (primePolynomialCount q (2 * d)) 3
  have hd2 : 2 ≤ 2 * d := by omega
  have hP : 4 ≤ primePolynomialCount q (2 * d) :=
    four_le_primePolynomialCount q hq hd2
  have hcount := primePolynomialCount_cube_bound q hq hd2 hP
  have hcount' : q ^ (6 * d) ≤ C * N := by
    simpa only [C, N, show 3 * (2 * d) = 6 * d by omega] using hcount
  have hp : C * X < q ^ (6 * d) := by
    simpa only [C, X] using hpressure
  have hscaled : C * X < C * N := hp.trans_le hcount'
  have hXN : X < N := Nat.lt_of_mul_lt_mul_left hscaled
  apply requested_le_card_goodResidueUnits q k d threshold requested
    hk hkm hthreshold
  simpa only [X, N] using hXN

/-- Good fibers inherit the matching property. -/
theorem goodResidueUnit_pairwise_disjoint
    (k d threshold : ℕ) (hdeg : 4 * d < k ^ 2)
    {u : (ProgressionQuotient q k)ˣ}
    (_hu : u ∈ goodResidueUnits q k d threshold) :
    Set.Pairwise
      (LargeSupport.fiber (residueUnit q k d) u : Set (PrimeTriple q d))
      (fun U V => Disjoint U.1 V.1) := by
  intro U hU V hV hne
  apply residueUnit_fiber_pairwise_disjoint q k d hdeg u
  · exact (LargeSupport.mem_fiber (residueUnit q k d) u U).mp hU
  · exact (LargeSupport.mem_fiber (residueUnit q k d) u V).mp hV
  · exact hne

end PrimeTripleFibers

/-! ## Deterministic success of one representation triple -/

namespace Construction

open AuxiliaryDigits TargetExpansion FiniteFieldEncoding

variable (q : ℕ) [Fact q.Prime]

/-- The mixed-radix value of `n` target digit pairs followed by the
unnormalized top coefficient `z`. -/
def targetBlock (q : ℕ) :
    (i n : ℕ) → (Fin n → ℕ) → (Fin n → ℕ) → ℕ → ℕ
  | _, 0, _, _, z => z
  | i, n + 1, x, y, z =>
      x 0 + oddRadix q i *
        (y 0 + 103 * targetBlock q (i + 1) n
          (fun j => x j.succ) (fun j => y j.succ) z)

/-- A carry-compatible auxiliary target digit is at most `150`, because it
is already a sum of three members of the explicit auxiliary set when the
incoming carry is zero. -/
theorem carryCovered_targetDigit_le {y : ℕ}
    (hy : CarryCovered auxiliaryDigitSet y) : y ≤ 150 := by
  obtain ⟨a, ha, b, hb, c, hc, habc⟩ := hy 0 (by omega)
  have ha' := explicitAuxiliarySet.1 ha
  have hb' := explicitAuxiliarySet.1 hb
  have hc' := explicitAuxiliarySet.1 hc
  simp only [Set.mem_Ico] at ha' hb' hc'
  omega

/-- Crude but uniform upper bound for a target block.  Each nonnormalized
auxiliary target digit costs at most three units in the next paired place. -/
theorem targetBlock_le_blockPlace_mul {i k : ℕ}
    (x y : Fin k → ℕ) (z : ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q (i + j))
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j)) :
    targetBlock q i k x y z ≤ blockPlace q i k * (z + 3 * k) := by
  induction k generalizing i with
  | zero => simp [targetBlock, blockPlace]
  | succ k ih =>
      let xt : Fin k → ℕ := fun j => x j.succ
      let yt : Fin k → ℕ := fun j => y j.succ
      have hxt : ∀ j : Fin k, xt j < oddRadix q (i + 1 + j) := by
        intro j
        have hidx : i + (j.succ : ℕ) = i + 1 + (j : ℕ) := by
          simp only [Fin.val_succ]
          omega
        change x j.succ < oddRadix q (i + 1 + (j : ℕ))
        rw [← hidx]
        exact hx j.succ
      have hyt : ∀ j : Fin k,
          CarryCovered auxiliaryDigitSet (yt j) := by
        intro j
        exact hy j.succ
      have htail := ih (i := i + 1) xt yt hxt hyt
      have hx0 : x 0 < oddRadix q i := by simpa using hx 0
      have hy0 : y 0 ≤ 150 := carryCovered_targetDigit_le (hy 0)
      have hP : 1 ≤ blockPlace q (i + 1) k :=
        blockPlace_pos q (i + 1) k
      have hinner :
          151 + 103 * (blockPlace q (i + 1) k * (z + 3 * k)) ≤
            103 * blockPlace q (i + 1) k * (z + 3 * (k + 1)) := by
        calc
          151 + 103 * (blockPlace q (i + 1) k * (z + 3 * k)) ≤
              103 * blockPlace q (i + 1) k * 3 +
                103 * (blockPlace q (i + 1) k * (z + 3 * k)) := by
            nlinarith
          _ = 103 * blockPlace q (i + 1) k * (z + 3 * (k + 1)) := by
            ring
      simp only [targetBlock, blockPlace]
      calc
        x 0 + oddRadix q i *
              (y 0 + 103 * targetBlock q (i + 1) k xt yt z) ≤
            oddRadix q i + oddRadix q i *
              (150 + 103 *
                (blockPlace q (i + 1) k * (z + 3 * k))) := by
          apply Nat.add_le_add
          · omega
          · exact Nat.mul_le_mul_left _
              (Nat.add_le_add hy0 (Nat.mul_le_mul_left 103 htail))
        _ = oddRadix q i *
              (151 + 103 *
                (blockPlace q (i + 1) k * (z + 3 * k))) := by ring
        _ ≤ oddRadix q i *
              (103 * blockPlace q (i + 1) k *
                (z + 3 * (k + 1))) :=
          Nat.mul_le_mul_left _ hinner
        _ = oddRadix q i * 103 * blockPlace q (i + 1) k *
              (z + 3 * (k + 1)) := by ring

/-- On the large levels used in the probabilistic argument, the complete
target block has a convenient pure-power upper bound. -/
theorem targetBlock_le_levelPower (hq : 103 ≤ q) {k z : ℕ}
    (hk : 1000 ≤ k) (x y : Fin k → ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q j)
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j))
    (hz : z ≤ 6 * 103 * q ^ (2 * k + 1)) :
    targetBlock q 0 k x y z ≤ q ^ (k ^ 2 + 3 * k + 4) := by
  have hqpos : 0 < q := by omega
  have hqthree : 3 ≤ q := by omega
  have hconst : 6 * 103 ≤ q ^ 2 := by nlinarith
  have hterm₁ : 6 * 103 * q ^ (2 * k + 1) ≤ q ^ (2 * k + 3) := by
    calc
      6 * 103 * q ^ (2 * k + 1) ≤ q ^ 2 * q ^ (2 * k + 1) :=
        Nat.mul_le_mul_right _ hconst
      _ = q ^ (2 * k + 3) := by rw [← pow_add]; congr 1 <;> omega
  have hk_two : k ≤ 2 ^ k := Nat.lt_two_pow_self.le
  have htwoq : 2 ^ k ≤ q ^ k :=
    Nat.pow_le_pow_left (by omega) k
  have hkq : k ≤ q ^ k := hk_two.trans htwoq
  have hterm₂ : 3 * k ≤ q ^ (2 * k + 3) := by
    calc
      3 * k ≤ q * q ^ k := Nat.mul_le_mul hqthree hkq
      _ = q ^ (k + 1) := by rw [pow_succ]; ring
      _ ≤ q ^ (2 * k + 3) := Nat.pow_le_pow_right hqpos (by omega)
  have hfactor :
      z + 3 * k ≤ q ^ (2 * k + 4) := by
    calc
      z + 3 * k ≤ q ^ (2 * k + 3) + q ^ (2 * k + 3) :=
        Nat.add_le_add (hz.trans hterm₁) hterm₂
      _ = 2 * q ^ (2 * k + 3) := by ring
      _ ≤ q * q ^ (2 * k + 3) := Nat.mul_le_mul_right _ (by omega)
      _ = q ^ (2 * k + 4) := by rw [pow_succ]; ring
  have hblock := targetBlock_le_blockPlace_mul q (i := 0) x y z (by
    simpa only [zero_add] using hx) hy
  have hplace := blockPlace_le_pow q hq 0 k
  have hplace' : blockPlace q 0 k ≤ q ^ (k * (k + 1)) := by
    simpa only [Nat.mul_zero, Nat.zero_add] using hplace
  calc
    targetBlock q 0 k x y z ≤ blockPlace q 0 k * (z + 3 * k) := hblock
    _ ≤ q ^ (k * (k + 1)) * q ^ (2 * k + 4) :=
      Nat.mul_le_mul hplace' hfactor
    _ = q ^ (k ^ 2 + 3 * k + 4) := by
      rw [← pow_add]
      congr 1
      ring

/-- The dyadic exponent used to turn the one-point exponential estimate
into the inverse-square bound required for summability. -/
def dyadicExponent (q k : ℕ) : ℕ :=
  q * (2 * (k ^ 2 + 3 * k + 5))

theorem square_succ_le_two_pow_dyadicExponent (hq : 103 ≤ q)
    {k m : ℕ} (hm : m ≤ q ^ (k ^ 2 + 3 * k + 4)) :
    (m + 1) ^ 2 ≤ 2 ^ dyadicExponent q k := by
  let E := k ^ 2 + 3 * k + 4
  have hqpos : 0 < q := by omega
  have hpowpos : 1 ≤ q ^ E := Nat.one_le_pow _ _ (by omega)
  have hm₁ : m + 1 ≤ q ^ (E + 1) := by
    calc
      m + 1 ≤ q ^ E + 1 := Nat.add_le_add_right hm 1
      _ ≤ q ^ E + q ^ E := Nat.add_le_add_left hpowpos _
      _ = 2 * q ^ E := by ring
      _ ≤ q * q ^ E := Nat.mul_le_mul_right _ (by omega)
      _ = q ^ (E + 1) := by rw [pow_succ]; ring
  have hsquare : (m + 1) ^ 2 ≤ q ^ (2 * (E + 1)) := by
    calc
      (m + 1) ^ 2 ≤ (q ^ (E + 1)) ^ 2 := Nat.pow_le_pow_left hm₁ 2
      _ = q ^ (2 * (E + 1)) := by rw [← pow_mul]; congr 1 <;> omega
  have hq_two : q ≤ 2 ^ q := Nat.lt_two_pow_self.le
  have hpower : q ^ (2 * (E + 1)) ≤ 2 ^ dyadicExponent q k := by
    calc
      q ^ (2 * (E + 1)) ≤ (2 ^ q) ^ (2 * (E + 1)) :=
        Nat.pow_le_pow_left hq_two _
      _ = 2 ^ dyadicExponent q k := by
        rw [← pow_mul]
        simp only [dyadicExponent, E]
  exact hsquare.trans hpower

/-- An explicit threshold absorbing every target expansion with fewer than
`K` complete digit pairs.  This parameterized form is needed because the
published Sawin estimate is eventual: its implicit constant is absorbed by
starting the construction at a sufficiently large level. -/
def largeTargetThresholdFrom (q K : ℕ) : ℕ :=
  q ^ (K * (K + 1)) *
    (6 * 103 * q ^ (2 * K + 1) + 3 * K)

/-- A target above `largeTargetThresholdFrom q K` cannot have a valid
expansion with fewer than `K` complete digit pairs. -/
theorem targetBlock_level_ge_of_large (hq : 103 ≤ q)
    {K m k z : ℕ} (x y : Fin k → ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q j)
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j))
    (hm : m = targetBlock q 0 k x y z)
    (hz : z ≤ 6 * 103 * q ^ (2 * k + 1))
    (hlarge : largeTargetThresholdFrom q K < m) :
    K ≤ k := by
  by_contra hk
  have hklt : k < K := by omega
  have htarget := targetBlock_le_blockPlace_mul q (i := 0) x y z (by
    simpa only [zero_add] using hx) hy
  have hplace₁ := blockPlace_le_pow q hq 0 k
  have hexp : k * (k + 1) ≤ K * (K + 1) := by nlinarith
  have hplace₂ : q ^ (k * (k + 1)) ≤ q ^ (K * (K + 1)) :=
    Nat.pow_le_pow_right (by omega : 0 < q) hexp
  have hplace : blockPlace q 0 k ≤ q ^ (K * (K + 1)) := by
    exact hplace₁.trans (by
      simpa only [Nat.mul_zero, Nat.zero_add] using hplace₂)
  have htopExp : 2 * k + 1 ≤ 2 * K + 1 := by omega
  have htopPow : q ^ (2 * k + 1) ≤ q ^ (2 * K + 1) :=
    Nat.pow_le_pow_right (by omega : 0 < q) htopExp
  have htop : z + 3 * k ≤
      6 * 103 * q ^ (2 * K + 1) + 3 * K := by
    exact Nat.add_le_add
      (hz.trans (Nat.mul_le_mul_left (6 * 103) htopPow)) (by omega)
  have hbound := Nat.mul_le_mul hplace htop
  rw [hm] at hlarge
  exact (not_lt_of_ge (htarget.trans hbound)) hlarge

/-- A single explicit threshold absorbing every target expansion with fewer
than `1000` complete digit pairs. -/
def largeTargetThreshold (q : ℕ) : ℕ :=
  q ^ (1000 * 1001) *
    (6 * 103 * q ^ (2 * 1000 + 1) + 3 * 1000)

@[simp]
theorem largeTargetThresholdFrom_1000 :
    largeTargetThresholdFrom q 1000 = largeTargetThreshold q := by
  rfl

theorem targetBlock_level_ge_1000_of_large (hq : 103 ≤ q)
    {m k z : ℕ} (x y : Fin k → ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q j)
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j))
    (hm : m = targetBlock q 0 k x y z)
    (hz : z ≤ 6 * 103 * q ^ (2 * k + 1))
    (hlarge : largeTargetThreshold q < m) :
    1000 ≤ k := by
  by_contra hk
  have hklt : k < 1000 := by omega
  have htarget := targetBlock_le_blockPlace_mul q (i := 0) x y z (by
    simpa only [zero_add] using hx) hy
  have hplace₁ := blockPlace_le_pow q hq 0 k
  have hexp : k * (k + 1) ≤ 1000 * 1001 := by nlinarith
  have hplace₂ : q ^ (k * (k + 1)) ≤ q ^ (1000 * 1001) :=
    Nat.pow_le_pow_right (by omega : 0 < q) hexp
  have hplace : blockPlace q 0 k ≤ q ^ (1000 * 1001) := by
    exact hplace₁.trans (by
      simpa only [Nat.mul_zero, Nat.zero_add] using hplace₂)
  have htopExp : 2 * k + 1 ≤ 2 * 1000 + 1 := by omega
  have htopPow : q ^ (2 * k + 1) ≤ q ^ (2 * 1000 + 1) :=
    Nat.pow_le_pow_right (by omega : 0 < q) htopExp
  have htop : z + 3 * k ≤
      6 * 103 * q ^ (2 * 1000 + 1) + 3 * 1000 := by
    exact Nat.add_le_add
      (hz.trans (Nat.mul_le_mul_left (6 * 103) htopPow)) (by omega)
  have hbound := Nat.mul_le_mul hplace htop
  rw [hm] at hlarge
  exact (not_lt_of_ge (htarget.trans hbound)) hlarge

/-- A valid list-form target expansion is exactly a `targetBlock`.  This
bridges the terminating Euclidean-division construction above to the
function-indexed form used by one representation triple. -/
theorem ValidDigits.exists_targetBlock {q i : ℕ} {ds : List (ℕ × ℕ)}
    (hds : ValidDigits q i ds) :
    ∃ (x y : Fin (levelCount ds) → ℕ),
      (∀ j : Fin (levelCount ds), x j < oddRadix q (i + j)) ∧
      (∀ j : Fin (levelCount ds),
        CarryCovered auxiliaryDigitSet (y j)) ∧
      ∀ z : ℕ,
        MixedRadix.encode ds + MixedRadix.place ds * z =
          targetBlock q i (levelCount ds) x y z := by
  induction ds using List.twoStepInduction generalizing i with
  | nil =>
      refine ⟨Fin.elim0, Fin.elim0, ?_, ?_, ?_⟩
      · intro j
        exact Fin.elim0 j
      · intro j
        exact Fin.elim0 j
      · intro z
        simp [levelCount, MixedRadix.encode, MixedRadix.place, targetBlock]
  | singleton a =>
      rcases a with ⟨b, x⟩
      simp [ValidDigits] at hds
  | cons_cons a b ds ih =>
      rcases a with ⟨B, x₀⟩
      rcases b with ⟨P, y₀⟩
      simp only [ValidDigits] at hds
      obtain ⟨hB, hP, hx₀, _hylt, hy₀, htail⟩ := hds
      subst B
      subst P
      obtain ⟨x, y, hx, hy, hrepr⟩ := ih htail
      have hcount : levelCount
          ((oddRadix q i, x₀) :: (103, y₀) :: ds) = levelCount ds + 1 := by
        unfold levelCount
        simp only [List.length_cons]
        omega
      rw [hcount]
      let x' : Fin (levelCount ds + 1) → ℕ := Fin.cases x₀ x
      let y' : Fin (levelCount ds + 1) → ℕ := Fin.cases y₀ y
      refine ⟨x', y', ?_, ?_, ?_⟩
      · intro j
        refine Fin.cases ?_ (fun j => ?_) j
        · simpa [x'] using hx₀
        · have hj := hx j
          change x j < oddRadix q (i + (j.succ : ℕ))
          simpa only [Fin.val_succ, Nat.add_assoc, Nat.add_left_comm,
            Nat.add_comm] using hj
      · intro j
        refine Fin.cases ?_ (fun j => ?_) j
        · simpa [y'] using hy₀
        · simpa [y'] using hy j
      · intro z
        simp only [MixedRadix.encode_cons, MixedRadix.place_cons,
          targetBlock]
        change x₀ + oddRadix q i *
              (y₀ + 103 * MixedRadix.encode ds) +
            (oddRadix q i * (103 * MixedRadix.place ds)) * z = _
        simp only [x', y', Fin.cases_zero, Fin.cases_succ]
        calc
          x₀ + oddRadix q i * (y₀ + 103 * MixedRadix.encode ds) +
                oddRadix q i * (103 * MixedRadix.place ds) * z =
              x₀ + oddRadix q i *
                (y₀ + 103 * (MixedRadix.encode ds +
                  MixedRadix.place ds * z)) := by ring
          _ = x₀ + oddRadix q i *
                (y₀ + 103 * targetBlock q (i + 1)
                  (levelCount ds) x y z) := by rw [hrepr z]

/-- Every target at least three has function-indexed target data, with the
same explicit top bound as the list-form expansion. -/
theorem exists_targetBlock_data {q m : ℕ} (hq : 2 ≤ q) (hm : 3 ≤ m) :
    ∃ (k : ℕ) (x y : Fin k → ℕ) (z : ℕ),
      (∀ j : Fin k, x j < oddRadix q j) ∧
      (∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j)) ∧
      m = targetBlock q 0 k x y z ∧
      3 ≤ z ∧ z ≤ 6 * 103 * q ^ (2 * k + 1) := by
  obtain ⟨ds, z, hvalid, hmrepr, hz, hzupper⟩ :=
    TargetExpansion.exists_carryCompatible_encoding hq hm
  obtain ⟨x, y, hx, hy, hblock⟩ :=
    Construction.ValidDigits.exists_targetBlock hvalid
  refine ⟨levelCount ds, x, y, z, ?_, hy, ?_, hz, hzupper⟩
  · intro j
    simpa using hx j
  · calc
      m = MixedRadix.encode ds + MixedRadix.place ds * z := hmrepr
      _ = targetBlock q 0 (levelCount ds) x y z := hblock z

/-- Targets beyond a parameterized threshold have an exact expansion at a
level at least `K`. -/
theorem exists_large_targetBlock_data_from {K m : ℕ}
    (hq : 103 ≤ q) (hlarge : largeTargetThresholdFrom q K < m) :
    ∃ (k : ℕ) (x y : Fin k → ℕ) (z : ℕ),
      K ≤ k ∧
      (∀ j : Fin k, x j < oddRadix q j) ∧
      (∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j)) ∧
      m = targetBlock q 0 k x y z ∧
      3 ≤ z ∧ z ≤ 6 * 103 * q ^ (2 * k + 1) := by
  have hpow : 1 ≤ q ^ (K * (K + 1)) :=
    Nat.one_le_pow _ _ (by omega)
  have hqpow : 1 ≤ q ^ (2 * K + 1) :=
    Nat.one_le_pow _ _ (by omega)
  have hfactor : 2 ≤
      6 * 103 * q ^ (2 * K + 1) + 3 * K := by omega
  have hthreshold : 2 ≤ largeTargetThresholdFrom q K := by
    unfold largeTargetThresholdFrom
    have hmul := Nat.mul_le_mul hpow hfactor
    simpa only [one_mul] using hmul
  have hm : 3 ≤ m := by omega
  obtain ⟨k, x, y, z, hx, hy, hmblock, hzlow, hzhigh⟩ :=
    exists_targetBlock_data (q := q) (by omega) hm
  have hk := targetBlock_level_ge_of_large q hq
    x y hx hy hmblock hzhigh hlarge
  exact ⟨k, x, y, z, hk, hx, hy, hmblock, hzlow, hzhigh⟩

/-- Large targets have the same exact expansion at a construction level
surviving the finite Sidon cutoff. -/
theorem exists_large_targetBlock_data {m : ℕ}
    (hq : 103 ≤ q) (hlarge : largeTargetThreshold q < m) :
    ∃ (k : ℕ) (x y : Fin k → ℕ) (z : ℕ),
      1000 ≤ k ∧
      (∀ j : Fin k, x j < oddRadix q j) ∧
      (∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j)) ∧
      m = targetBlock q 0 k x y z ∧
      3 ≤ z ∧ z ≤ 6 * 103 * q ^ (2 * k + 1) := by
  have hpow : 1 ≤ q ^ (1000 * 1001) :=
    Nat.one_le_pow _ _ (by omega)
  have hfactor : 2 ≤
      6 * 103 * q ^ (2 * 1000 + 1) + 3 * 1000 := by omega
  have hthreshold : 2 ≤ largeTargetThreshold q := by
    unfold largeTargetThreshold
    have hmul := Nat.mul_le_mul hpow hfactor
    simpa only [one_mul] using hmul
  have hm : 3 ≤ m := by
    omega
  obtain ⟨k, x, y, z, hx, hy, hmblock, hzlow, hzhigh⟩ :=
    exists_targetBlock_data (q := q) (by omega) hm
  have hk := targetBlock_level_ge_1000_of_large q hq
    x y hx hy hmblock hzhigh hlarge
  exact ⟨k, x, y, z, hk, hx, hy, hmblock, hzlow, hzhigh⟩

/-- Regard a fixed degree-`2d` prime polynomial as a member of construction
level `k` once `d` is certified to lie in that level's degree window. -/
def levelPolynomialOfDegreeIndex {k d : ℕ} (hd : d ∈ degreeIndices k)
    (f : PrimePolynomials.OfDegree q (2 * d)) : LevelPolynomial q k :=
  ⟨⟨d, hd⟩, f⟩

@[simp]
theorem levelPolynomialOfDegreeIndex_val {k d : ℕ}
    (hd : d ∈ degreeIndices k) (f : PrimePolynomials.OfDegree q (2 * d)) :
    (levelPolynomialOfDegreeIndex q hd f).val = f := rfl

theorem levelPolynomialOfDegreeIndex_injective {k d : ℕ}
    (hd : d ∈ degreeIndices k) :
    Function.Injective (levelPolynomialOfDegreeIndex q hd) := by
  intro f g hfg
  exact Subtype.ext (congrArg LevelPolynomial.val hfg)

/-- Package three objects as a function on `Fin 3`. -/
def tripleFunction {α : Type*} (a b c : α) (u : Fin 3) : α :=
  if u.val = 0 then a else if u.val = 1 then b else c

@[simp] theorem tripleFunction_zero {α : Type*} (a b c : α) :
    tripleFunction a b c 0 = a := by simp [tripleFunction]

@[simp] theorem tripleFunction_one {α : Type*} (a b c : α) :
    tripleFunction a b c 1 = b := by simp [tripleFunction]

@[simp] theorem tripleFunction_two {α : Type*} (a b c : α) :
    tripleFunction a b c 2 = c := by simp [tripleFunction]

theorem tripleFunction_injective {α : Type*} {a b c : α}
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    Function.Injective (tripleFunction a b c) := by
  intro u v huv
  apply Fin.ext
  have huBound := u.isLt
  have hvBound := v.isLt
  interval_cases hu : u.val <;> interval_cases hv : v.val <;>
    simp_all [tripleFunction]

/-- Every integer in `[3,3N]` is the sum of three integers in `[1,N]`. -/
theorem exists_three_bounded_positive_sum {N z : ℕ} (hN : 1 ≤ N)
    (hzlower : 3 ≤ z) (hzupper : z ≤ 3 * N) :
    ∃ t₁ t₂ t₃ : ℕ,
      1 ≤ t₁ ∧ t₁ ≤ N ∧ 1 ≤ t₂ ∧ t₂ ≤ N ∧
      1 ≤ t₃ ∧ t₃ ≤ N ∧ t₁ + t₂ + t₃ = z := by
  by_cases hfirst : z ≤ N + 2
  · exact ⟨z - 2, 1, 1, by omega, by omega, by omega, by omega,
      by omega, by omega, by omega⟩
  by_cases hsecond : z ≤ 2 * N + 1
  · exact ⟨N, z - N - 1, 1, hN, le_rfl, by omega, by omega,
      by omega, by omega, by omega⟩
  · exact ⟨N, N, z - 2 * N, hN, le_rfl, hN, le_rfl,
      by omega, by omega, by omega⟩

/-- Fin-valued form of `exists_three_bounded_positive_sum`, matching the
stored top parameters (which are shifted upward by one in `encoded`). -/
theorem exists_three_topDigits_sum {N z : ℕ} (hN : 1 ≤ N)
    (hzlower : 3 ≤ z) (hzupper : z ≤ 3 * N) :
    ∃ t₁ t₂ t₃ : Fin N, t₁.val + 1 + (t₂.val + 1) + (t₃.val + 1) = z := by
  obtain ⟨a, b, c, ha1, haN, hb1, hbN, hc1, hcN, habc⟩ :=
    exists_three_bounded_positive_sum hN hzlower hzupper
  refine ⟨⟨a - 1, by omega⟩, ⟨b - 1, by omega⟩,
    ⟨c - 1, by omega⟩, ?_⟩
  change (a - 1) + 1 + ((b - 1) + 1) + ((c - 1) + 1) = z
  omega

/-- For the construction's range of top coefficients, the three stored
top digits have enough room as soon as `q ≥ 103` and `k ≥ 3`. -/
theorem targetTop_le_three_topRange (hq : 103 ≤ q) {k z : ℕ}
    (hk : 3 ≤ k) (hz : z ≤ 6 * 103 * q ^ (2 * k + 1)) :
    z ≤ 3 * q ^ (3 * k) := by
  have hqpos : 0 < q := by omega
  have hqpow : 206 ≤ q ^ 2 := by nlinarith
  have hexp : 2 ≤ k - 1 := by omega
  have hpmono : q ^ 2 ≤ q ^ (k - 1) :=
    Nat.pow_le_pow_right hqpos hexp
  have hfactor : 206 ≤ q ^ (k - 1) := hqpow.trans hpmono
  calc
    z ≤ 6 * 103 * q ^ (2 * k + 1) := hz
    _ = 3 * 206 * q ^ (2 * k + 1) := by ring
    _ ≤ 3 * q ^ (k - 1) * q ^ (2 * k + 1) := by
      exact Nat.mul_le_mul_right (q ^ (2 * k + 1))
        (Nat.mul_le_mul_left 3 hfactor)
    _ = 3 * (q ^ (k - 1) * q ^ (2 * k + 1)) := by ring
    _ = 3 * q ^ ((k - 1) + (2 * k + 1)) := by
      congr 1
      exact (pow_add q (k - 1) (2 * k + 1)).symm
    _ = 3 * q ^ (3 * k) := by congr 2 <;> omega

/-- The recursive block expression for an embedded degree-`2d` polynomial
is exactly its construction-level encoding. -/
theorem blockWithTopValue_levelPolynomialOfDegreeIndex
    {k d : ℕ} (hd : d ∈ degreeIndices k)
    (f : PrimePolynomials.OfDegree q (2 * d)) (ω : Parameters q) :
    blockWithTopValue q f 0 k
        (ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f))
        ((ω.top k (levelPolynomialOfDegreeIndex q hd f)).val + 1) =
      encoded q ω (levelPolynomialOfDegreeIndex q hd f) := by
  change blockWithTopValue q f 0 k
      (ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f))
      ((ω.top k (levelPolynomialOfDegreeIndex q hd f)).val + 1) =
    MixedRadix.encode
        (digitBlock q f 0 k
          (ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f))) +
      MixedRadix.place
        (digitBlock q f 0 k
          (ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f))) *
        ((ω.top k (levelPolynomialOfDegreeIndex q hd f)).val + 1)
  rw [blockWithTopValue_eq_encode_add_place_mul, digitBlock_place]

/-- If the three logarithm sums give the target odd digits, the three
auxiliary sums absorb the resulting carries, and the top coefficients sum
to the target top coefficient, then the three encoded blocks sum exactly to
the target block. -/
theorem three_blocks_eq_targetBlock (hq : 3 ≤ q) {d i n : ℕ}
    (f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d))
    (r₁ r₂ r₃ : Fin n → AuxiliaryDigit)
    (t₁ t₂ t₃ z : ℕ) (x y : Fin n → ℕ)
    (hx : ∀ j : Fin n, x j < oddRadix q (i + j))
    (hlog : ∀ j : Fin n,
      Nat.ModEq (oddRadix q (i + j))
        (primePolynomialLogarithm q (i + j) f₁ +
          primePolynomialLogarithm q (i + j) f₂ +
          primePolynomialLogarithm q (i + j) f₃) (x j))
    (haux : ∀ j : Fin n,
      (r₁ j : ℕ) + (r₂ j : ℕ) + (r₃ j : ℕ) +
          (primePolynomialLogarithm q (i + j) f₁ +
            primePolynomialLogarithm q (i + j) f₂ +
            primePolynomialLogarithm q (i + j) f₃) /
              oddRadix q (i + j) = y j)
    (htop : t₁ + t₂ + t₃ = z) :
    blockWithTopValue q f₁ i n r₁ t₁ +
        blockWithTopValue q f₂ i n r₂ t₂ +
        blockWithTopValue q f₃ i n r₃ t₃ =
      targetBlock q i n x y z := by
  induction n generalizing i with
  | zero =>
      simpa [blockWithTopValue, targetBlock] using htop
  | succ n ih =>
      let B := oddRadix q i
      let e₁ := primePolynomialLogarithm q i f₁
      let e₂ := primePolynomialLogarithm q i f₂
      let e₃ := primePolynomialLogarithm q i f₃
      let E := e₁ + e₂ + e₃
      have hB : 0 < B := oddRadix_pos (by omega)
      have hx0 : x 0 < B := by
        simpa [B] using hx 0
      have hmod : E % B = x 0 := by
        have hm := hlog 0
        change E % B = x 0 % B at hm
        simpa only [Nat.mod_eq_of_lt hx0] using hm
      have hE : E = x 0 + B * (E / B) := by
        calc
          E = E % B + B * (E / B) := MixedRadix.digit_decomposition B E
          _ = x 0 + B * (E / B) := by rw [hmod]
      have ha0 :
          (r₁ 0 : ℕ) + (r₂ 0 : ℕ) + (r₃ 0 : ℕ) + E / B = y 0 := by
        simpa [E, e₁, e₂, e₃, B] using haux 0
      have htail := ih (i := i + 1)
        (r₁ := fun j => r₁ j.succ) (r₂ := fun j => r₂ j.succ)
        (r₃ := fun j => r₃ j.succ) (x := fun j => x j.succ)
        (y := fun j => y j.succ) (fun j => by
          have hj := hx j.succ
          have hidx : i + (j.succ : ℕ) = i + 1 + (j : ℕ) := by
            simp only [Fin.val_succ]
            omega
          simpa only [hidx] using hj) (fun j => by
          have hj := hlog j.succ
          have hidx : i + (j.succ : ℕ) = i + 1 + (j : ℕ) := by
            simp only [Fin.val_succ]
            omega
          simpa only [hidx] using hj) (fun j => by
          have hj := haux j.succ
          have hidx : i + (j.succ : ℕ) = i + 1 + (j : ℕ) := by
            simp only [Fin.val_succ]
            omega
          simpa only [hidx] using hj)
      simp only [blockWithTopValue, targetBlock]
      change e₁ + B * ((r₁ 0 : ℕ) + 103 *
          blockWithTopValue q f₁ (i + 1) n (fun j => r₁ j.succ) t₁) +
        (e₂ + B * ((r₂ 0 : ℕ) + 103 *
          blockWithTopValue q f₂ (i + 1) n (fun j => r₂ j.succ) t₂)) +
        (e₃ + B * ((r₃ 0 : ℕ) + 103 *
          blockWithTopValue q f₃ (i + 1) n (fun j => r₃ j.succ) t₃)) = _
      rw [show e₁ + B * ((r₁ 0 : ℕ) + 103 *
            blockWithTopValue q f₁ (i + 1) n (fun j => r₁ j.succ) t₁) +
          (e₂ + B * ((r₂ 0 : ℕ) + 103 *
            blockWithTopValue q f₂ (i + 1) n (fun j => r₂ j.succ) t₂)) +
          (e₃ + B * ((r₃ 0 : ℕ) + 103 *
            blockWithTopValue q f₃ (i + 1) n (fun j => r₃ j.succ) t₃)) =
          E + B * ((r₁ 0 : ℕ) + (r₂ 0 : ℕ) + (r₃ 0 : ℕ) +
            103 * (blockWithTopValue q f₁ (i + 1) n
              (fun j => r₁ j.succ) t₁ +
              blockWithTopValue q f₂ (i + 1) n
                (fun j => r₂ j.succ) t₂ +
              blockWithTopValue q f₃ (i + 1) n
                (fun j => r₃ j.succ) t₃)) by ring]
      calc
        E + B * ((r₁ 0 : ℕ) + (r₂ 0 : ℕ) + (r₃ 0 : ℕ) +
            103 * (blockWithTopValue q f₁ (i + 1) n
              (fun j => r₁ j.succ) t₁ +
              blockWithTopValue q f₂ (i + 1) n
                (fun j => r₂ j.succ) t₂ +
              blockWithTopValue q f₃ (i + 1) n
                (fun j => r₃ j.succ) t₃)) =
            x 0 + B * (((r₁ 0 : ℕ) + (r₂ 0 : ℕ) + (r₃ 0 : ℕ) +
              E / B) + 103 *
                (blockWithTopValue q f₁ (i + 1) n
                    (fun j => r₁ j.succ) t₁ +
                  blockWithTopValue q f₂ (i + 1) n
                    (fun j => r₂ j.succ) t₂ +
                  blockWithTopValue q f₃ (i + 1) n
                    (fun j => r₃ j.succ) t₃)) := by
              nth_rewrite 1 [hE]
              ring
        _ = x 0 + B * (y 0 + 103 *
              (blockWithTopValue q f₁ (i + 1) n
                  (fun j => r₁ j.succ) t₁ +
                blockWithTopValue q f₂ (i + 1) n
                  (fun j => r₂ j.succ) t₂ +
                blockWithTopValue q f₃ (i + 1) n
                  (fun j => r₃ j.succ) t₃)) := by rw [ha0]
        _ = x 0 + B * (y 0 + 103 *
              targetBlock q (i + 1) n (fun j => x j.succ)
                (fun j => y j.succ) z) := by rw [htail]

/-- Carry coverage supplies actual auxiliary digits for all positions of a
fixed polynomial triple. -/
theorem exists_auxiliary_digits_for_target (hq : 3 ≤ q) {d i n : ℕ}
    (f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d))
    (y : Fin n → ℕ)
    (hy : ∀ j : Fin n, AuxiliaryDigits.CarryCovered auxiliaryDigitSet (y j)) :
    ∃ r₁ r₂ r₃ : Fin n → AuxiliaryDigit,
      ∀ j : Fin n,
        (r₁ j : ℕ) + (r₂ j : ℕ) + (r₃ j : ℕ) +
            (primePolynomialLogarithm q (i + j) f₁ +
              primePolynomialLogarithm q (i + j) f₂ +
              primePolynomialLogarithm q (i + j) f₃) /
                oddRadix q (i + j) = y j := by
  have hex : ∀ j : Fin n, ∃ a b c : AuxiliaryDigit,
      (a : ℕ) + (b : ℕ) + (c : ℕ) +
          (primePolynomialLogarithm q (i + j) f₁ +
            primePolynomialLogarithm q (i + j) f₂ +
            primePolynomialLogarithm q (i + j) f₃) /
              oddRadix q (i + j) = y j := by
    intro j
    let B := oddRadix q (i + j)
    let e₁ := primePolynomialLogarithm q (i + j) f₁
    let e₂ := primePolynomialLogarithm q (i + j) f₂
    let e₃ := primePolynomialLogarithm q (i + j) f₃
    let κ := (e₁ + e₂ + e₃) / B
    have hκ : κ ≤ 2 := by
      exact MixedRadix.three_digit_carry_le_two
        (oddRadix_pos (by omega))
        (primePolynomialLogarithm_lt_radix q (i + j) f₁)
        (primePolynomialLogarithm_lt_radix q (i + j) f₂)
        (primePolynomialLogarithm_lt_radix q (i + j) f₃)
        (by omega : 0 ≤ 2)
    obtain ⟨a, ha, b, hb, c, hc, habc⟩ := hy j κ hκ
    refine ⟨⟨a, ?_⟩, ⟨b, ?_⟩, ⟨c, ?_⟩, ?_⟩
    · simpa [auxiliaryDigitSet] using ha
    · simpa [auxiliaryDigitSet] using hb
    · simpa [auxiliaryDigitSet] using hc
    · simpa only [κ, B, e₁, e₂, e₃] using habc
  choose r₁ r₂ r₃ hr using hex
  exact ⟨r₁, r₂, r₃, hr⟩

/-- One prime triple in the target residue class can be assigned auxiliary
digits so that its three blocks give the target block exactly.  This is the
deterministic content of one probabilistic trial. -/
theorem exists_three_blocks_eq_targetBlock_of_congruentPrimeTriple
    (hq : 3 ≤ q) {d k : ℕ}
    (x y : Fin k → ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q j)
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j))
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (halog : ∀ (i : ℕ) (hi : i < k),
      FiniteFieldEncoding.logarithm q i
          (FiniteFieldEncoding.polynomialUnitOfNotDvd q i a (ha i hi)) =
        x ⟨i, hi⟩)
    (T : RepresentationFamilies.PrimeTriple q d)
    (hT : PolynomialInfrastructure.modulusProduct q k ∣
      T.product q - a)
    (t₁ t₂ t₃ z : ℕ) (htop : t₁ + t₂ + t₃ = z) :
    ∃ f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d),
      f₁ ≠ f₂ ∧ f₁ ≠ f₃ ∧ f₂ ≠ f₃ ∧
      T.1 = {f₁, f₂, f₃} ∧
      ∃ r₁ r₂ r₃ : Fin k → AuxiliaryDigit,
        blockWithTopValue q f₁ 0 k r₁ t₁ +
            blockWithTopValue q f₂ 0 k r₂ t₂ +
            blockWithTopValue q f₃ 0 k r₃ t₃ =
          targetBlock q 0 k x y z := by
  obtain ⟨f₁, f₂, f₃, h12, h13, h23, hset⟩ :=
    Finset.card_eq_three.mp T.property
  have hlog : ∀ j : Fin k,
      Nat.ModEq (oddRadix q j)
        (primePolynomialLogarithm q j f₁ +
          primePolynomialLogarithm q j f₂ +
          primePolynomialLogarithm q j f₃) (x j) := by
    intro j
    have hj := RepresentationFamilies.primeTriple_log_sum_modEq_of_common_residue
      q k d a T ha hT j j.isLt
    rw [halog j j.isLt] at hj
    simpa [oddRadix, hset, h12, h13, h23, add_assoc] using hj
  obtain ⟨r₁, r₂, r₃, haux⟩ :=
    exists_auxiliary_digits_for_target q hq (i := 0) f₁ f₂ f₃ y hy
  have hx' : ∀ j : Fin k, x j < oddRadix q (0 + j) := by
    intro j
    simpa only [Nat.zero_add] using hx j
  have hlog' : ∀ j : Fin k,
      Nat.ModEq (oddRadix q (0 + j))
        (primePolynomialLogarithm q (0 + j) f₁ +
          primePolynomialLogarithm q (0 + j) f₂ +
          primePolynomialLogarithm q (0 + j) f₃) (x j) := by
    intro j
    simpa only [Nat.zero_add] using hlog j
  refine ⟨f₁, f₂, f₃, h12, h13, h23, hset, r₁, r₂, r₃, ?_⟩
  exact three_blocks_eq_targetBlock q hq f₁ f₂ f₃ r₁ r₂ r₃
    t₁ t₂ t₃ z x y hx' hlog' haux htop

end Construction

/-! ## The product probability space of digit parameters -/

namespace RandomParameters

open Construction
open AuxiliaryDigits TargetExpansion

variable (q : ℕ) [Fact q.Prime]

/-- One independent coordinate in Pilatte's random construction. -/
inductive Coordinate (q : ℕ)
  | auxiliary (k : ℕ) (f : LevelPolynomial q k) (i : Fin k)
  | top (k : ℕ) (f : LevelPolynomial q k)

/-- The finite value type attached to a random coordinate. -/
def Coordinate.Value : Coordinate q → Type
  | .auxiliary _ _ _ => AuxiliaryDigit
  | .top k _ => Fin (q ^ (3 * k))

instance coordinateValueMeasurableSpace (c : Coordinate q) :
    MeasurableSpace c.Value := ⊤

instance coordinateValueFinite (c : Coordinate q) : Finite c.Value := by
  cases c <;> simp only [Coordinate.Value] <;> infer_instance

noncomputable instance coordinateValueFintype (c : Coordinate q) : Fintype c.Value :=
  Fintype.ofFinite c.Value

instance coordinateValueNonempty (c : Coordinate q) : Nonempty c.Value := by
  cases c with
  | auxiliary => exact auxiliaryDigitNonempty
  | top k f =>
      exact Fin.pos_iff_nonempty.mp
        (Nat.pow_pos (Nat.Prime.pos (Fact.out : q.Prime)))

/-- The raw dependent product on which Mathlib's infinite product measure is
defined. -/
abbrev Raw (q : ℕ) := ∀ c : Coordinate q, c.Value

def toRaw (ω : Parameters q) : Raw q
  | .auxiliary k f i => ω.auxiliary k f i
  | .top k f => ω.top k f

def ofRaw (u : Raw q) : Parameters q where
  auxiliary k f i := u (.auxiliary k f i)
  top k f := u (.top k f)

@[simp]
theorem toRaw_ofRaw (u : Raw q) : toRaw q (ofRaw q u) = u := by
  funext c
  cases c <;> rfl

@[simp]
theorem ofRaw_toRaw (ω : Parameters q) : ofRaw q (toRaw q ω) = ω := by
  cases ω
  rfl

def parameterEquiv : Parameters q ≃ Raw q where
  toFun := toRaw q
  invFun := ofRaw q
  left_inv := ofRaw_toRaw q
  right_inv := toRaw_ofRaw q

/-- Transport the product measurable space along the exact parameter
equivalence. -/
noncomputable instance parametersMeasurableSpace : MeasurableSpace (Parameters q) :=
  MeasurableSpace.comap (parameterEquiv q) inferInstance

theorem parameterEquiv_measurable : Measurable (parameterEquiv q) := by
  exact measurable_iff_comap_le.mpr le_rfl

theorem parameterEquiv_symm_measurable : Measurable (parameterEquiv q).symm := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap (ofRaw q)
      (MeasurableSpace.comap (toRaw q)
        (inferInstance : MeasurableSpace (Raw q))) ≤
      (inferInstance : MeasurableSpace (Raw q))
  rw [MeasurableSpace.comap_comp]
  have heq : toRaw q ∘ ofRaw q = id := by
    funext u
    exact toRaw_ofRaw q u
  rw [heq, MeasurableSpace.comap_id]

noncomputable def parameterMeasurableEquiv : Parameters q ≃ᵐ Raw q where
  toEquiv := parameterEquiv q
  measurable_toFun := parameterEquiv_measurable q
  measurable_invFun := parameterEquiv_symm_measurable q

/-- Every coordinate is uniform on its finite value type. -/
noncomputable def coordinateMeasure (c : Coordinate q) : MeasureTheory.Measure c.Value :=
  ProbabilityTheory.uniformOn Set.univ

instance coordinateMeasure_isProbability (c : Coordinate q) :
    MeasureTheory.IsProbabilityMeasure (coordinateMeasure q c) := by
  unfold coordinateMeasure
  infer_instance

/-- The independent product distribution on all auxiliary and top digits. -/
noncomputable def rawMeasure : MeasureTheory.Measure (Raw q) :=
  MeasureTheory.Measure.infinitePi (coordinateMeasure q)

instance rawMeasure_isProbability :
    MeasureTheory.IsProbabilityMeasure (rawMeasure q) := by
  unfold rawMeasure
  infer_instance

/-- Pilatte's probability measure on structured parameter realizations. -/
noncomputable def parameterMeasure : MeasureTheory.Measure (Parameters q) :=
  (rawMeasure q).comap (parameterMeasurableEquiv q)

instance parameterMeasure_isProbability :
    MeasureTheory.IsProbabilityMeasure (parameterMeasure q) := by
  unfold parameterMeasure
  infer_instance

theorem parameterMeasure_map_toRaw :
    (parameterMeasure q).map (toRaw q) = rawMeasure q := by
  change ((rawMeasure q).comap (parameterMeasurableEquiv q)).map
      (parameterMeasurableEquiv q) = rawMeasure q
  rw [(parameterMeasurableEquiv q).measurableEmbedding.map_comap]
  simp

theorem parameterMeasure_map_coordinate (c : Coordinate q) :
    (parameterMeasure q).map (fun ω => toRaw q ω c) = coordinateMeasure q c := by
  have hraw : Measurable (toRaw q) := parameterEquiv_measurable q
  calc
    (parameterMeasure q).map (fun ω => toRaw q ω c) =
        ((parameterMeasure q).map (toRaw q)).map (fun u : Raw q => u c) := by
      exact (MeasureTheory.Measure.map_map (measurable_pi_apply c) hraw).symm
    _ = (rawMeasure q).map (fun u : Raw q => u c) := by
      rw [parameterMeasure_map_toRaw q]
    _ = coordinateMeasure q c :=
      MeasureTheory.Measure.infinitePi_map_eval (coordinateMeasure q) c

theorem parameterCoordinates_independent :
    ProbabilityTheory.iIndepFun (fun c (ω : Parameters q) => toRaw q ω c)
      (parameterMeasure q) := by
  let X := fun c (ω : Parameters q) => toRaw q ω c
  have hX : Measurable (fun ω c => X c ω) := parameterEquiv_measurable q
  apply (ProbabilityTheory.iIndepFun_iff_map_fun_eq_infinitePi_map₀
    (P := parameterMeasure q) hX.aemeasurable).2
  rw [show (fun ω c => X c ω) = toRaw q by rfl, parameterMeasure_map_toRaw q]
  rw [show (fun c => (parameterMeasure q).map (X c)) = coordinateMeasure q by
    funext c
    exact parameterMeasure_map_coordinate q c]
  rfl

/-- The probability that one coordinate takes one prescribed value is the
reciprocal of the cardinality of its finite value type. -/
theorem parameterMeasure_coordinate_singleton (c : Coordinate q) (v : c.Value) :
    parameterMeasure q {ω | toRaw q ω c = v} =
      (Nat.card c.Value : ENNReal)⁻¹ := by
  have hc : Measurable (fun ω : Parameters q => toRaw q ω c) :=
    (measurable_pi_apply c).comp (parameterEquiv_measurable q)
  have hsingle : MeasurableSet ({v} : Set c.Value) := by
    exact MeasurableSet.singleton v
  have hpre : {ω : Parameters q | toRaw q ω c = v} =
      (fun ω : Parameters q => toRaw q ω c) ⁻¹' ({v} : Set c.Value) := by
    ext ω
    simp
  rw [hpre, ← MeasureTheory.Measure.map_apply_of_aemeasurable
    hc.aemeasurable hsingle, parameterMeasure_map_coordinate]
  unfold coordinateMeasure
  rw [ProbabilityTheory.uniformOn_univ]
  rw [← Nat.card_eq_fintype_card]
  simp

/-- Exact mass of a finite cylinder of distinct independent coordinates. -/
theorem parameterMeasure_finite_cylinder
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (e : ι → Coordinate q) (he : Function.Injective e)
    (v : ∀ j : ι, (e j).Value) :
    parameterMeasure q {ω | ∀ j : ι, toRaw q ω (e j) = v j} =
      ∏ j : ι, (Nat.card (e j).Value : ENNReal)⁻¹ := by
  have hind := (parameterCoordinates_independent q).precomp he
  have hmass := hind.measure_inter_preimage_eq_mul Finset.univ
    (sets := fun j : ι => ({v j} : Set (e j).Value)) (by
      intro j _hj
      exact MeasurableSet.singleton (v j))
  have hleft :
      (⋂ j ∈ (Finset.univ : Finset ι),
          (fun ω : Parameters q => toRaw q ω (e j)) ⁻¹' ({v j} : Set (e j).Value)) =
        {ω | ∀ j : ι, toRaw q ω (e j) = v j} := by
    ext ω
    simp
  rw [hleft] at hmass
  calc
    parameterMeasure q {ω | ∀ j : ι, toRaw q ω (e j) = v j} =
        ∏ j ∈ (Finset.univ : Finset ι),
          parameterMeasure q
            ((fun ω : Parameters q => toRaw q ω (e j)) ⁻¹'
              ({v j} : Set (e j).Value)) := hmass
    _ = ∏ j : ι, (Nat.card (e j).Value : ENNReal)⁻¹ := by
      apply Finset.prod_congr rfl
      intro j _hj
      rw [show (fun ω : Parameters q => toRaw q ω (e j)) ⁻¹'
          ({v j} : Set (e j).Value) =
          {ω | toRaw q ω (e j) = v j} by ext ω; simp]
      exact parameterMeasure_coordinate_singleton q (e j) (v j)

theorem measurableSet_finite_cylinder
    {ι : Type*} [Fintype ι]
    (e : ι → Coordinate q) (v : ∀ j : ι, (e j).Value) :
    MeasurableSet {ω : Parameters q | ∀ j : ι, toRaw q ω (e j) = v j} := by
  rw [show {ω : Parameters q | ∀ j : ι, toRaw q ω (e j) = v j} =
      ⋂ j : ι, (fun ω : Parameters q => toRaw q ω (e j)) ⁻¹'
        ({v j} : Set (e j).Value) by ext ω; simp]
  exact MeasurableSet.iInter fun j =>
    ((measurable_pi_apply (e j)).comp (parameterEquiv_measurable q))
      (MeasurableSet.singleton (v j))

/-- Cylinders supported on disjoint finite sets of product coordinates are
independent. -/
theorem finite_cylinders_indepSet
    {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ]
    (e : ι → Coordinate q) (he : Function.Injective e)
    (f : κ → Coordinate q) (hf : Function.Injective f)
    (hdisj : Disjoint (Set.range e) (Set.range f))
    (v : ∀ j : ι, (e j).Value) (w : ∀ j : κ, (f j).Value) :
    ProbabilityTheory.IndepSet
      {ω : Parameters q | ∀ j : ι, toRaw q ω (e j) = v j}
      {ω : Parameters q | ∀ j : κ, toRaw q ω (f j) = w j}
      (parameterMeasure q) := by
  let E : ι ⊕ κ → Coordinate q
    | .inl i => e i
    | .inr j => f j
  have hE : Function.Injective E := by
    intro a b hab
    rcases a with i | j <;> rcases b with i' | j'
    · exact congrArg Sum.inl (he hab)
    · exfalso
      exact Set.disjoint_left.1 hdisj ⟨i, rfl⟩ ⟨j', hab.symm⟩
    · exfalso
      exact Set.disjoint_left.1 hdisj ⟨i', rfl⟩ ⟨j, hab⟩
    · exact congrArg Sum.inr (hf hab)
  let V : ∀ s : ι ⊕ κ, (E s).Value
    | .inl i => v i
    | .inr j => w j
  have hmeasE := measurableSet_finite_cylinder q e v
  have hmeasF := measurableSet_finite_cylinder q f w
  apply (ProbabilityTheory.indepSet_iff_measure_inter_eq_mul
    hmeasE hmeasF (parameterMeasure q)).2
  have hset :
      {ω : Parameters q | ∀ s : ι ⊕ κ, toRaw q ω (E s) = V s} =
        {ω : Parameters q | ∀ i : ι, toRaw q ω (e i) = v i} ∩
          {ω : Parameters q | ∀ j : κ, toRaw q ω (f j) = w j} := by
    ext ω
    simp only [Set.mem_setOf_eq, Set.mem_inter_iff]
    constructor
    · intro h
      exact ⟨fun i => h (.inl i), fun j => h (.inr j)⟩
    · rintro ⟨hι, hκ⟩ (i | j)
      · exact hι i
      · exact hκ j
  rw [← hset, parameterMeasure_finite_cylinder q E hE V,
    parameterMeasure_finite_cylinder q e he v,
    parameterMeasure_finite_cylinder q f hf w,
    Fintype.prod_sum_type]

/-- Three top coordinates and the three strings of `k` auxiliary
coordinates used by one unordered representation triple. -/
abbrev TrialSlot (k : ℕ) := Fin 3 ⊕ (Fin 3 × Fin k)

/-- Natural-number denominator of one successful trial probability. -/
def trialDenominator (q k : ℕ) : ℕ :=
  (q ^ (3 * k)) ^ 3 * 15 ^ (3 * k)

theorem fifteen_pow_le_two_pow (k : ℕ) :
    15 ^ (3 * k) ≤ 2 ^ (12 * k) := by
  calc
    15 ^ (3 * k) ≤ (2 ^ 4) ^ (3 * k) :=
      Nat.pow_le_pow_left (by norm_num) _
    _ = 2 ^ (12 * k) := by rw [← pow_mul]; congr 1 <;> omega

theorem dyadicCoefficient_le_two_pow {k : ℕ} (hk : 1000 ≤ k) :
    2 * (k ^ 2 + 3 * k + 5) ≤ 2 ^ (k ^ 2 + 2) := by
  have hpoly : k ^ 2 + 3 * k + 5 ≤ 2 * k ^ 2 := by nlinarith
  have hpow : k ^ 2 ≤ 2 ^ (k ^ 2) := Nat.lt_two_pow_self.le
  calc
    2 * (k ^ 2 + 3 * k + 5) ≤ 2 * (2 * k ^ 2) :=
      Nat.mul_le_mul_left 2 hpoly
    _ = 4 * k ^ 2 := by ring
    _ ≤ 4 * 2 ^ (k ^ 2) := Nat.mul_le_mul_left 4 hpow
    _ = 2 ^ (k ^ 2 + 2) := by rw [pow_add]; norm_num; ring

/-- A pure power envelope for the requested number of independent trials. -/
theorem requiredTrials_le (k : ℕ) (hk : 1000 ≤ k) :
    trialDenominator q k * dyadicExponent q k ≤
      2 ^ (k ^ 2 + 12 * k + 2) * q ^ (9 * k + 1) := by
  have h15 := fifteen_pow_le_two_pow k
  have hcoefficient := dyadicCoefficient_le_two_pow hk
  unfold trialDenominator dyadicExponent
  calc
    ((q ^ (3 * k)) ^ 3 * 15 ^ (3 * k)) *
        (q * (2 * (k ^ 2 + 3 * k + 5))) ≤
      ((q ^ (3 * k)) ^ 3 * 2 ^ (12 * k)) *
        (q * 2 ^ (k ^ 2 + 2)) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left _ h15)
        (Nat.mul_le_mul_left q hcoefficient)
    _ = 2 ^ (k ^ 2 + 12 * k + 2) * q ^ (9 * k + 1) := by
      rw [show 9 * k + 1 = 3 * k * 3 + 1 by omega,
        pow_add, ← pow_mul, ← pow_add]
      ring

/-- The requested number of trials, after the same harmless main-term
denominator and totient factors, fits below the preceding global-field
power. -/
theorem scaled_requiredTrials_le_predecessor (hq : 2 ^ 500 ≤ q)
    {k d : ℕ} (hk : 1000 ≤ k) (hrange : 21 * k ^ 2 ≤ 60 * d) :
    192 * d ^ 3 * SawinSpecialization.progressionTotient q k *
        (trialDenominator q k * dyadicExponent q k) ≤ q ^ (3 * d - 1) := by
  let m := k ^ 2
  let B := 3 * d + m + 12 * k + 10
  have hm : 1000000 ≤ m := by
    dsimp only [m]
    nlinarith
  have hklinear : 1000 * k ≤ m := by
    dsimp only [m]
    nlinarith
  have hrange' : 21 * m ≤ 60 * d := by simpa only [m] using hrange
  have hexp : m + 9 * k + 1 + (B / 500 + 1) < 3 * d := by
    dsimp only [B]
    omega
  have hφ := SawinSpecialization.progressionTotient_le_pow_sq q k
  have hrequired := requiredTrials_le q k hk
  have hC := SawinSpecialization.mainCoefficient_le_two_pow d
  have hbinary := SawinSpecialization.two_pow_le_largeField_pow q hq B
  calc
    192 * d ^ 3 * SawinSpecialization.progressionTotient q k *
        (trialDenominator q k * dyadicExponent q k) ≤
      2 ^ (3 * d + 8) * q ^ m *
        (2 ^ (m + 12 * k + 2) * q ^ (9 * k + 1)) := by
      exact Nat.mul_le_mul (Nat.mul_le_mul hC hφ) hrequired
    _ = 2 ^ B * q ^ (m + 9 * k + 1) := by
      dsimp only [B, m]
      rw [pow_add, pow_add]
      ring
    _ ≤ q ^ (B / 500 + 1) * q ^ (m + 9 * k + 1) :=
      Nat.mul_le_mul_right _ hbinary
    _ = q ^ (m + 9 * k + 1 + (B / 500 + 1)) := by
      rw [← pow_add]
      congr 1
      omega
    _ ≤ q ^ (3 * d - 1) :=
      Nat.pow_le_pow_right ((Fact.out : q.Prime).pos) (by omega)

theorem two_le_trialDenominator (hq : 2 ≤ q) {k : ℕ} (hk : 1 ≤ k) :
    2 ≤ trialDenominator q k := by
  have hqpos : 0 < q := by omega
  have hqpow : q ≤ q ^ (3 * k) := by
    simpa only [pow_one] using
      (Nat.pow_le_pow_right hqpos (show 1 ≤ 3 * k by omega))
  have hpowone : 1 ≤ (q ^ (3 * k)) ^ 3 := Nat.one_le_pow _ _ (by omega)
  have hfifteen : 1 ≤ 15 ^ (3 * k) := Nat.one_le_pow _ _ (by omega)
  unfold trialDenominator
  have hfirst : q ≤ (q ^ (3 * k)) ^ 3 := by
    exact hqpow.trans (by
      simpa only [pow_one] using
        (Nat.pow_le_pow_right (Nat.pow_pos hqpos) (show 1 ≤ 3 by omega)))
  exact hq.trans (hfirst.trans (by
    simpa only [mul_one] using Nat.mul_le_mul_left ((q ^ (3 * k)) ^ 3) hfifteen))

theorem trialProbability_eq_inv (k : ℕ) :
    ((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k) =
      ((trialDenominator q k : ℕ) : ENNReal)⁻¹ := by
  simp only [trialDenominator, Nat.cast_mul, Nat.cast_pow]
  rw [← ENNReal.inv_pow, ← ENNReal.inv_pow,
    ENNReal.mul_inv (Or.inr (by simp)) (Or.inl (by simp))]
  norm_num

/-- A Bernoulli-inequality estimate for one block of `D` independent
trials, each succeeding with probability `D⁻¹`. -/
theorem real_one_sub_inv_pow_le_half (D : ℕ) (hD : 2 ≤ D) :
    (1 - ((D : ℝ))⁻¹) ^ D ≤ (2 : ℝ)⁻¹ := by
  have hDcast : (2 : ℝ) ≤ D := by exact_mod_cast hD
  have hDm1 : 0 < (D : ℝ) - 1 := by linarith
  have hDpos : 0 < (D : ℝ) := by positivity
  have hbern := one_add_mul_le_pow
    (a := ((D : ℝ) - 1)⁻¹)
      (le_trans (by norm_num : (-2 : ℝ) ≤ 0) (inv_nonneg.mpr hDm1.le))
    (D - 1)
  have hncast : ((D - 1 : ℕ) : ℝ) = (D : ℝ) - 1 := by
    rw [Nat.cast_sub (by omega)]
    norm_num
  have htwo : (2 : ℝ) ≤
      (1 + ((D : ℝ) - 1)⁻¹) ^ (D - 1) := by
    calc
      (2 : ℝ) = 1 + ((D : ℝ) - 1) * ((D : ℝ) - 1)⁻¹ := by
        rw [mul_inv_cancel₀ hDm1.ne']
        norm_num
      _ = 1 + ((D - 1 : ℕ) : ℝ) * ((D : ℝ) - 1)⁻¹ := by
        rw [hncast]
      _ ≤ (1 + ((D : ℝ) - 1)⁻¹) ^ (D - 1) := hbern
  have hbase : 0 ≤ 1 - ((D : ℝ))⁻¹ := by
    rw [sub_nonneg, inv_le_one₀ (by positivity : (0 : ℝ) < D)]
    exact_mod_cast hD.trans' (by omega : 1 ≤ 2)
  have hbase1 : 1 - ((D : ℝ))⁻¹ ≤ 1 :=
    sub_le_self _ (inv_nonneg.mpr hDpos.le)
  have hid : 1 + ((D : ℝ) - 1)⁻¹ =
      (1 - ((D : ℝ))⁻¹)⁻¹ := by
    field_simp
    ring
  rw [hid] at htwo
  have hpowpos : 0 < (1 - ((D : ℝ))⁻¹) ^ (D - 1) := by
    apply pow_pos
    rw [sub_pos, inv_lt_one₀ (by positivity : (0 : ℝ) < D)]
    exact_mod_cast (show 1 < D by omega)
  have hinvle :
      (1 - ((D : ℝ))⁻¹) ^ (D - 1) ≤ (2 : ℝ)⁻¹ := by
    rw [inv_pow] at htwo
    have hi :=
      (inv_le_inv₀ (inv_pos.mpr hpowpos) (by norm_num : (0 : ℝ) < 2)).2 htwo
    simpa using hi
  calc
    (1 - ((D : ℝ))⁻¹) ^ D =
        (1 - ((D : ℝ))⁻¹) ^ (D - 1) *
          (1 - ((D : ℝ))⁻¹) := by
      have he : D - 1 + 1 = D := by omega
      simpa only [he] using
        (pow_succ (1 - ((D : ℝ))⁻¹) (D - 1))
    _ ≤ (1 - ((D : ℝ))⁻¹) ^ (D - 1) * 1 := by gcongr
    _ ≤ (2 : ℝ)⁻¹ := by simpa using hinvle

theorem ennreal_one_sub_inv_pow_le_half (D : ℕ) (hD : 2 ≤ D) :
    (1 - (((D : ℕ) : ENNReal))⁻¹) ^ D ≤ (2 : ENNReal)⁻¹ := by
  have hle : (((D : ℕ) : ENNReal))⁻¹ ≤ 1 := by
    rw [ENNReal.inv_le_one]
    exact_mod_cast (show 1 ≤ D by omega)
  rw [← ENNReal.toReal_le_toReal]
  · rw [ENNReal.toReal_pow, ENNReal.toReal_sub_of_le hle (by simp)]
    simpa using real_one_sub_inv_pow_le_half D hD
  · finiteness
  · finiteness

/-- If at least `D * L` independent trials of success probability `D⁻¹`
are available, their joint failure probability is at most `2⁻ˡ`. -/
theorem ennreal_failure_pow_le_half_pow (D R L : ℕ) (hD : 2 ≤ D)
    (hR : D * L ≤ R) :
    (1 - (((D : ℕ) : ENNReal))⁻¹) ^ R ≤
      ((2 : ENNReal)⁻¹) ^ L := by
  have hbase : 1 - (((D : ℕ) : ENNReal))⁻¹ ≤ 1 :=
    tsub_le_self
  calc
    (1 - (((D : ℕ) : ENNReal))⁻¹) ^ R ≤
        (1 - (((D : ℕ) : ENNReal))⁻¹) ^ (D * L) :=
      pow_le_pow_right_of_le_one' hbase hR
    _ = ((1 - (((D : ℕ) : ENNReal))⁻¹) ^ D) ^ L := by rw [pow_mul]
    _ ≤ ((2 : ENNReal)⁻¹) ^ L :=
      pow_le_pow_left' (ennreal_one_sub_inv_pow_le_half D hD) L

/-- A dyadic estimate with exponent `L` dominates the inverse-square target
as soon as `2ˡ` dominates the square of the target. -/
theorem ennreal_half_pow_le_invSquare {m L : ℕ}
    (h : (m + 1) ^ 2 ≤ 2 ^ L) :
    ((2 : ENNReal)⁻¹) ^ L ≤
      ENNReal.ofReal (1 / |(m : ℝ) + 1| ^ (2 : ℝ)) := by
  have hmpos : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  have hcast : (((m + 1) ^ 2 : ℕ) : ENNReal) ≤
      ((2 ^ L : ℕ) : ENNReal) := by exact_mod_cast h
  calc
    ((2 : ENNReal)⁻¹) ^ L = (((2 ^ L : ℕ) : ENNReal))⁻¹ := by
      rw [← ENNReal.inv_pow]
      norm_num
    _ ≤ ((((m + 1) ^ 2 : ℕ) : ENNReal))⁻¹ := by
      exact ENNReal.inv_le_inv.mpr hcast
    _ = ENNReal.ofReal (1 / |(m : ℝ) + 1| ^ (2 : ℝ)) := by
      rw [abs_of_pos hmpos, one_div,
        ENNReal.ofReal_inv_of_pos (Real.rpow_pos_of_pos hmpos 2),
        ← ENNReal.ofReal_rpow_of_pos hmpos, ENNReal.rpow_two]
      congr 2
      rw [ENNReal.ofReal_add (by positivity : (0 : ℝ) ≤ (m : ℝ))] <;>
        norm_num

/-- Embed the finite coordinates of a trial into the global product. -/
def trialCoordinate {k : ℕ} (F : Fin 3 → LevelPolynomial q k) :
    TrialSlot k → Coordinate q
  | .inl u => .top k (F u)
  | .inr uj => .auxiliary k (F uj.1) uj.2

theorem trialCoordinate_injective {k : ℕ} {F : Fin 3 → LevelPolynomial q k}
    (hF : Function.Injective F) : Function.Injective (trialCoordinate q F) := by
  intro s t hst
  rcases s with u | ⟨u, i⟩ <;> rcases t with v | ⟨v, j⟩
  · simp only [trialCoordinate, Coordinate.top.injEq] at hst
    have hfv : F u = F v := eq_of_heq hst.2
    have huv : u = v := hF hfv
    subst v
    rfl
  · change Coordinate.top k (F u) = Coordinate.auxiliary k (F v) j at hst
    cases hst
  · change Coordinate.auxiliary k (F u) i = Coordinate.top k (F v) at hst
    cases hst
  · simp only [trialCoordinate, Coordinate.auxiliary.injEq] at hst
    have hfv : F u = F v := eq_of_heq hst.2.1
    have huv : u = v := hF hfv
    have hij : i = j := eq_of_heq hst.2.2
    subst v
    subst j
    rfl

/-- The prescribed values attached to the finite coordinates of a trial. -/
def trialValue {k : ℕ} (F : Fin 3 → LevelPolynomial q k)
    (r : Fin 3 → Fin k → AuxiliaryDigit)
    (t : Fin 3 → Fin (q ^ (3 * k))) :
    ∀ s : TrialSlot k, (trialCoordinate q F s).Value
  | .inl u => t u
  | .inr uj => r uj.1 uj.2

/-- Exact product formula for the probability of prescribing all digits of
one trial. -/
theorem trialCylinder_mass {k : ℕ} (F : Fin 3 → LevelPolynomial q k)
    (hF : Function.Injective F)
    (r : Fin 3 → Fin k → AuxiliaryDigit)
    (t : Fin 3 → Fin (q ^ (3 * k))) :
    parameterMeasure q
        {ω | ∀ s : TrialSlot k,
          toRaw q ω (trialCoordinate q F s) = trialValue q F r t s} =
      ∏ s : TrialSlot k,
        (Nat.card (trialCoordinate q F s).Value : ENNReal)⁻¹ := by
  exact parameterMeasure_finite_cylinder q (trialCoordinate q F)
    (trialCoordinate_injective q hF) (trialValue q F r t)

/-- The preceding product consists of three top coordinates and `3k`
auxiliary coordinates. -/
theorem trialCylinder_mass_eq {k : ℕ} (F : Fin 3 → LevelPolynomial q k)
    (hF : Function.Injective F)
    (r : Fin 3 → Fin k → AuxiliaryDigit)
    (t : Fin 3 → Fin (q ^ (3 * k))) :
    parameterMeasure q
        {ω | ∀ s : TrialSlot k,
          toRaw q ω (trialCoordinate q F s) = trialValue q F r t s} =
      ((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k) := by
  rw [trialCylinder_mass q F hF r t, Fintype.prod_sum_type,
    Fintype.prod_prod_type]
  simp only [trialCoordinate, Coordinate.Value]
  rw [Nat.card_fin, auxiliaryDigit_natCard]
  simp only [Nat.cast_pow, Finset.prod_const, Finset.card_univ, Fintype.card_fin, Nat.cast_ofNat]
  have hp : ((15 : ENNReal)⁻¹ ^ k) ^ 3 =
      (15 : ENNReal)⁻¹ ^ (3 * k) := by
    rw [show 3 * k = k * 3 by omega, pow_mul]
  rw [hp]

/-- Embed an ordered enumeration of one prime triple into a construction
level. -/
def embeddedTriple {k d : ℕ} (hd : d ∈ degreeIndices k)
    (f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d)) :
    Fin 3 → LevelPolynomial q k :=
  tripleFunction (levelPolynomialOfDegreeIndex q hd f₁)
    (levelPolynomialOfDegreeIndex q hd f₂)
    (levelPolynomialOfDegreeIndex q hd f₃)

theorem embeddedTriple_injective {k d : ℕ} (hd : d ∈ degreeIndices k)
    {f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d)}
    (h12 : f₁ ≠ f₂) (h13 : f₁ ≠ f₃) (h23 : f₂ ≠ f₃) :
    Function.Injective (embeddedTriple q hd f₁ f₂ f₃) := by
  apply tripleFunction_injective
  · exact fun h => h12 (levelPolynomialOfDegreeIndex_injective q hd h)
  · exact fun h => h13 (levelPolynomialOfDegreeIndex_injective q hd h)
  · exact fun h => h23 (levelPolynomialOfDegreeIndex_injective q hd h)

theorem embeddedTriple_apply {k d : ℕ} (hd : d ∈ degreeIndices k)
    (f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d)) (u : Fin 3) :
    embeddedTriple q hd f₁ f₂ f₃ u =
      levelPolynomialOfDegreeIndex q hd (tripleFunction f₁ f₂ f₃ u) := by
  have hu := u.isLt
  interval_cases huv : u.val <;> simp_all [embeddedTriple, tripleFunction]

/-- A successful trial cylinder really supplies three members of the
deterministic Sidon candidate set whose sum is the target. -/
theorem trialCylinder_subset_tripleSumset (hq : 103 ≤ q)
    {k d m : ℕ} (hk : 1000 ≤ k) (hd : d ∈ degreeIndices k)
    (f₁ f₂ f₃ : PrimePolynomials.OfDegree q (2 * d))
    (h12 : f₁ ≠ f₂) (h13 : f₁ ≠ f₃) (h23 : f₂ ≠ f₃)
    (r₁ r₂ r₃ : Fin k → AuxiliaryDigit)
    (t₁ t₂ t₃ : Fin (q ^ (3 * k)))
    (hblock :
      blockWithTopValue q f₁ 0 k r₁ (t₁.val + 1) +
          blockWithTopValue q f₂ 0 k r₂ (t₂.val + 1) +
          blockWithTopValue q f₃ 0 k r₃ (t₃.val + 1) = m) :
    {ω | ∀ s : TrialSlot k,
        toRaw q ω
            (trialCoordinate q (embeddedTriple q hd f₁ f₂ f₃) s) =
          trialValue q (embeddedTriple q hd f₁ f₂ f₃)
            (tripleFunction r₁ r₂ r₃) (tripleFunction t₁ t₂ t₃) s} ⊆
      {ω | m ∈ TripleSumset (sidonCandidateSet q ω)} := by
  intro ω hω
  let F := embeddedTriple q hd f₁ f₂ f₃
  have hr₁ :
      ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f₁) = r₁ := by
    funext j
    have hj := hω (Sum.inr (0, j))
    simpa only [toRaw, trialCoordinate, trialValue, Coordinate.Value,
      F, embeddedTriple,
      tripleFunction_zero] using hj
  have hr₂ :
      ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f₂) = r₂ := by
    funext j
    have hj := hω (Sum.inr (1, j))
    simpa only [toRaw, trialCoordinate, trialValue, Coordinate.Value,
      F, embeddedTriple,
      tripleFunction_one] using hj
  have hr₃ :
      ω.auxiliary k (levelPolynomialOfDegreeIndex q hd f₃) = r₃ := by
    funext j
    have hj := hω (Sum.inr (2, j))
    simpa only [toRaw, trialCoordinate, trialValue, Coordinate.Value,
      F, embeddedTriple,
      tripleFunction_two] using hj
  have ht₁ : ω.top k (levelPolynomialOfDegreeIndex q hd f₁) = t₁ := by
    have hj := hω (Sum.inl 0)
    simpa only [toRaw, trialCoordinate, trialValue, Coordinate.Value,
      F, embeddedTriple,
      tripleFunction_zero] using hj
  have ht₂ : ω.top k (levelPolynomialOfDegreeIndex q hd f₂) = t₂ := by
    have hj := hω (Sum.inl 1)
    simpa only [toRaw, trialCoordinate, trialValue, Coordinate.Value,
      F, embeddedTriple,
      tripleFunction_one] using hj
  have ht₃ : ω.top k (levelPolynomialOfDegreeIndex q hd f₃) = t₃ := by
    have hj := hω (Sum.inl 2)
    simpa only [toRaw, trialCoordinate, trialValue, Coordinate.Value,
      F, embeddedTriple,
      tripleFunction_two] using hj
  have he₁ : encoded q ω (F 0) =
      blockWithTopValue q f₁ 0 k r₁ (t₁.val + 1) := by
    have hb := blockWithTopValue_levelPolynomialOfDegreeIndex q hd f₁ ω
    rw [hr₁, ht₁] at hb
    simpa only [F, embeddedTriple, tripleFunction_zero] using hb.symm
  have he₂ : encoded q ω (F 1) =
      blockWithTopValue q f₂ 0 k r₂ (t₂.val + 1) := by
    have hb := blockWithTopValue_levelPolynomialOfDegreeIndex q hd f₂ ω
    rw [hr₂, ht₂] at hb
    simpa only [F, embeddedTriple, tripleFunction_one] using hb.symm
  have he₃ : encoded q ω (F 2) =
      blockWithTopValue q f₃ 0 k r₃ (t₃.val + 1) := by
    have hb := blockWithTopValue_levelPolynomialOfDegreeIndex q hd f₃ ω
    rw [hr₃, ht₃] at hb
    simpa only [F, embeddedTriple, tripleFunction_two] using hb.symm
  let x₁ : SidonCandidate q := ⟨⟨k, hk⟩, F 0⟩
  let x₂ : SidonCandidate q := ⟨⟨k, hk⟩, F 1⟩
  let x₃ : SidonCandidate q := ⟨⟨k, hk⟩, F 2⟩
  refine ⟨sidonCandidateValue q ω x₁, ⟨x₁, rfl⟩,
    sidonCandidateValue q ω x₂, ⟨x₂, rfl⟩,
    sidonCandidateValue q ω x₃, ⟨x₃, rfl⟩, ?_⟩
  change m = encoded q ω (F 0) + encoded q ω (F 1) + encoded q ω (F 2)
  rw [he₁, he₂, he₃]
  exact hblock.symm

/-- All concrete data of one successful cylinder, tied to the unordered
prime triple from which it was obtained. -/
structure SuccessfulTrial {k d m : ℕ}
    (T : RepresentationFamilies.PrimeTriple q d) where
  f₁ : PrimePolynomials.OfDegree q (2 * d)
  f₂ : PrimePolynomials.OfDegree q (2 * d)
  f₃ : PrimePolynomials.OfDegree q (2 * d)
  ne₁₂ : f₁ ≠ f₂
  ne₁₃ : f₁ ≠ f₃
  ne₂₃ : f₂ ≠ f₃
  triple_eq : T.1 = {f₁, f₂, f₃}
  r₁ : Fin k → AuxiliaryDigit
  r₂ : Fin k → AuxiliaryDigit
  r₃ : Fin k → AuxiliaryDigit
  t₁ : Fin (q ^ (3 * k))
  t₂ : Fin (q ^ (3 * k))
  t₃ : Fin (q ^ (3 * k))
  block_sum :
    blockWithTopValue q f₁ 0 k r₁ (t₁.val + 1) +
        blockWithTopValue q f₂ 0 k r₂ (t₂.val + 1) +
        blockWithTopValue q f₃ 0 k r₃ (t₃.val + 1) = m

theorem SuccessfulTrial.prime_mem {k d m : ℕ}
    {T : RepresentationFamilies.PrimeTriple q d}
    (τ : SuccessfulTrial q (k := k) (m := m) T) (u : Fin 3) :
    tripleFunction τ.f₁ τ.f₂ τ.f₃ u ∈ T.1 := by
  rw [τ.triple_eq]
  have hu := u.isLt
  interval_cases huv : u.val <;>
    simp_all [tripleFunction, τ.ne₁₂, τ.ne₁₃, τ.ne₂₃]

/-- Disjoint prime triples use disjoint sets of global random
coordinates. -/
theorem SuccessfulTrial.coordinate_ranges_disjoint {k d m : ℕ}
    {U V : RepresentationFamilies.PrimeTriple q d}
    (hd : d ∈ degreeIndices k)
    (τU : SuccessfulTrial q (k := k) (m := m) U)
    (τV : SuccessfulTrial q (k := k) (m := m) V)
    (hUV : Disjoint U.1 V.1) :
    Disjoint
      (Set.range (trialCoordinate q
        (embeddedTriple q hd τU.f₁ τU.f₂ τU.f₃)))
      (Set.range (trialCoordinate q
        (embeddedTriple q hd τV.f₁ τV.f₂ τV.f₃))) := by
  rw [Set.disjoint_left]
  rintro c ⟨s, rfl⟩ ⟨t, hst⟩
  rcases s with u | ⟨u, i⟩ <;> rcases t with v | ⟨v, j⟩
  · simp only [trialCoordinate, Coordinate.top.injEq] at hst
    have hlevel :
        embeddedTriple q hd τU.f₁ τU.f₂ τU.f₃ u =
          embeddedTriple q hd τV.f₁ τV.f₂ τV.f₃ v :=
      (eq_of_heq hst.2).symm
    rw [embeddedTriple_apply, embeddedTriple_apply] at hlevel
    have hprime := levelPolynomialOfDegreeIndex_injective q hd hlevel
    have hmV : tripleFunction τU.f₁ τU.f₂ τU.f₃ u ∈ V.1 := by
      rw [hprime]
      exact τV.prime_mem q v
    exact Finset.disjoint_left.1 hUV (τU.prime_mem q u) hmV
  · change Coordinate.auxiliary k _ j = Coordinate.top k _ at hst
    cases hst
  · change Coordinate.top k _ = Coordinate.auxiliary k _ i at hst
    cases hst
  · simp only [trialCoordinate, Coordinate.auxiliary.injEq] at hst
    have hlevel :
        embeddedTriple q hd τU.f₁ τU.f₂ τU.f₃ u =
          embeddedTriple q hd τV.f₁ τV.f₂ τV.f₃ v :=
      (eq_of_heq hst.2.1).symm
    rw [embeddedTriple_apply, embeddedTriple_apply] at hlevel
    have hprime := levelPolynomialOfDegreeIndex_injective q hd hlevel
    have hmV : tripleFunction τU.f₁ τU.f₂ τU.f₃ u ∈ V.1 := by
      rw [hprime]
      exact τV.prime_mem q v
    exact Finset.disjoint_left.1 hUV (τU.prime_mem q u) hmV

/-- The finite cylinder event associated to successful trial data. -/
def SuccessfulTrial.event {k d m : ℕ}
    {T : RepresentationFamilies.PrimeTriple q d}
    (hd : d ∈ degreeIndices k)
    (τ : SuccessfulTrial q (k := k) (m := m) T) :
    Set (Parameters q) :=
  {ω | ∀ s : TrialSlot k,
    toRaw q ω
        (trialCoordinate q (embeddedTriple q hd τ.f₁ τ.f₂ τ.f₃) s) =
      trialValue q (embeddedTriple q hd τ.f₁ τ.f₂ τ.f₃)
        (tripleFunction τ.r₁ τ.r₂ τ.r₃)
        (tripleFunction τ.t₁ τ.t₂ τ.t₃) s}

theorem SuccessfulTrial.events_indep {k d m : ℕ}
    {U V : RepresentationFamilies.PrimeTriple q d}
    (hd : d ∈ degreeIndices k)
    (τU : SuccessfulTrial q (k := k) (m := m) U)
    (τV : SuccessfulTrial q (k := k) (m := m) V)
    (hUV : Disjoint U.1 V.1) :
    ProbabilityTheory.IndepSet (τU.event q hd) (τV.event q hd)
      (parameterMeasure q) := by
  exact finite_cylinders_indepSet q
    (trialCoordinate q (embeddedTriple q hd τU.f₁ τU.f₂ τU.f₃))
    (trialCoordinate_injective q
      (embeddedTriple_injective q hd τU.ne₁₂ τU.ne₁₃ τU.ne₂₃))
    (trialCoordinate q (embeddedTriple q hd τV.f₁ τV.f₂ τV.f₃))
    (trialCoordinate_injective q
      (embeddedTriple_injective q hd τV.ne₁₂ τV.ne₁₃ τV.ne₂₃))
    (τU.coordinate_ranges_disjoint q hd τV hUV)
    (trialValue q (embeddedTriple q hd τU.f₁ τU.f₂ τU.f₃)
      (tripleFunction τU.r₁ τU.r₂ τU.r₃)
      (tripleFunction τU.t₁ τU.t₂ τU.t₃))
    (trialValue q (embeddedTriple q hd τV.f₁ τV.f₂ τV.f₃)
      (tripleFunction τV.r₁ τV.r₂ τV.r₃)
      (tripleFunction τV.t₁ τV.t₂ τV.t₃))

theorem SuccessfulTrial.measurableSet_event {k d m : ℕ}
    {T : RepresentationFamilies.PrimeTriple q d}
    (hd : d ∈ degreeIndices k)
    (τ : SuccessfulTrial q (k := k) (m := m) T) :
    MeasurableSet (τ.event q hd) := by
  exact measurableSet_finite_cylinder q
    (trialCoordinate q (embeddedTriple q hd τ.f₁ τ.f₂ τ.f₃))
    (trialValue q (embeddedTriple q hd τ.f₁ τ.f₂ τ.f₃)
      (tripleFunction τ.r₁ τ.r₂ τ.r₃)
      (tripleFunction τ.t₁ τ.t₂ τ.t₃))

/-- A family of successful trials indexed by pairwise disjoint prime
triples is mutually independent, not merely pairwise independent.  The
proof joins all coordinates occurring in an arbitrary finite subfamily into
one sigma-indexed cylinder. -/
theorem SuccessfulTrial.events_iIndep
    {ι : Type*} [DecidableEq ι]
    {k d m : ℕ}
    (hd : d ∈ degreeIndices k)
    (T : ι → RepresentationFamilies.PrimeTriple q d)
    (τ : ∀ i, SuccessfulTrial q (k := k) (m := m) (T i))
    (hdisj : ∀ i j, i ≠ j → Disjoint (T i).1 (T j).1) :
    ProbabilityTheory.iIndepSet (fun i => (τ i).event q hd)
      (parameterMeasure q) := by
  apply (ProbabilityTheory.iIndepSet_iff_meas_biInter
    (fun i => (τ i).measurableSet_event q hd)).2
  intro s
  let E : (Σ _i : (↥s), TrialSlot k) → Coordinate q := fun x =>
    trialCoordinate q
      (embeddedTriple q hd (τ x.1).f₁ (τ x.1).f₂ (τ x.1).f₃) x.2
  let V : ∀ x : (Σ _i : (↥s), TrialSlot k), (E x).Value := fun x =>
    trialValue q
      (embeddedTriple q hd (τ x.1).f₁ (τ x.1).f₂ (τ x.1).f₃)
      (tripleFunction (τ x.1).r₁ (τ x.1).r₂ (τ x.1).r₃)
      (tripleFunction (τ x.1).t₁ (τ x.1).t₂ (τ x.1).t₃) x.2
  have hE : Function.Injective E := by
    rintro ⟨i, u⟩ ⟨j, v⟩ huv
    by_cases hij : (i : ι) = j
    · have hij' : i = j := Subtype.ext hij
      subst j
      have huv' : u = v := trialCoordinate_injective q
        (embeddedTriple_injective q hd (τ i).ne₁₂ (τ i).ne₁₃
          (τ i).ne₂₃) huv
      subst v
      rfl
    · have hrange := (τ i).coordinate_ranges_disjoint q hd (τ j)
        (hdisj i j hij)
      exfalso
      exact Set.disjoint_left.1 hrange ⟨u, rfl⟩ ⟨v, huv.symm⟩
  have hset :
      (⋂ i ∈ s, (τ i).event q hd) =
        {ω | ∀ x : (Σ _i : (↥s), TrialSlot k),
          toRaw q ω (E x) = V x} := by
    ext ω
    simp only [Set.mem_iInter, Set.mem_setOf_eq]
    constructor
    · intro h x
      exact h x.1 x.1.property x.2
    · intro h i hi u
      exact h ⟨⟨i, hi⟩, u⟩
  rw [hset, parameterMeasure_finite_cylinder q E hE V,
    Fintype.prod_sigma]
  calc
    (∏ i : ↥s, ∏ u : TrialSlot k,
        (Nat.card (E ⟨i, u⟩).Value : ENNReal)⁻¹) =
        ∏ i : ↥s, parameterMeasure q ((τ i).event q hd) := by
      apply Fintype.prod_congr
      intro i
      symm
      exact trialCylinder_mass q
        (embeddedTriple q hd (τ i).f₁ (τ i).f₂ (τ i).f₃)
        (embeddedTriple_injective q hd (τ i).ne₁₂ (τ i).ne₁₃
          (τ i).ne₂₃)
        (tripleFunction (τ i).r₁ (τ i).r₂ (τ i).r₃)
        (tripleFunction (τ i).t₁ (τ i).t₂ (τ i).t₃)
    _ = ∏ i ∈ s, parameterMeasure q ((τ i).event q hd) := by
      exact Finset.prod_attach s (fun i =>
        parameterMeasure q ((τ i).event q hd))

theorem SuccessfulTrial.event_mass {k d m : ℕ}
    {T : RepresentationFamilies.PrimeTriple q d}
    (hd : d ∈ degreeIndices k)
    (τ : SuccessfulTrial q (k := k) (m := m) T) :
    parameterMeasure q (τ.event q hd) =
      ((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k) := by
  exact trialCylinder_mass_eq q
    (embeddedTriple q hd τ.f₁ τ.f₂ τ.f₃)
    (embeddedTriple_injective q hd τ.ne₁₂ τ.ne₁₃ τ.ne₂₃)
    (tripleFunction τ.r₁ τ.r₂ τ.r₃)
    (tripleFunction τ.t₁ τ.t₂ τ.t₃)

/-- Exact failure probability for a finite mutually disjoint family of
successful trials. -/
theorem SuccessfulTrial.all_events_fail_mass
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {k d m : ℕ}
    (hd : d ∈ degreeIndices k)
    (T : ι → RepresentationFamilies.PrimeTriple q d)
    (τ : ∀ i, SuccessfulTrial q (k := k) (m := m) (T i))
    (hdisj : ∀ i j, i ≠ j → Disjoint (T i).1 (T j).1) :
    parameterMeasure q {ω | ∀ i, ω ∉ (τ i).event q hd} =
      (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k))) ^ Fintype.card ι := by
  let E : ι → Set (Parameters q) := fun i => (τ i).event q hd
  have hInd : ProbabilityTheory.iIndepSet E (parameterMeasure q) :=
    SuccessfulTrial.events_iIndep q hd T τ hdisj
  have hprod := (ProbabilityTheory.iIndepSet_iff E (parameterMeasure q)).1
    hInd Finset.univ (f := fun i => (E i)ᶜ) (by
      intro i _hi
      exact (MeasurableSpace.GenerateMeasurable.basic (E i) (by simp)).compl)
  have hset : {ω : Parameters q | ∀ i, ω ∉ E i} = ⋂ i, (E i)ᶜ := by
    ext ω
    simp
  rw [hset]
  calc
    parameterMeasure q (⋂ i, (E i)ᶜ) =
        ∏ i, parameterMeasure q ((E i)ᶜ) := by
      simpa using hprod
    _ = ∏ _i : ι,
        (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
          (15 : ENNReal)⁻¹ ^ (3 * k))) := by
      apply Fintype.prod_congr
      intro i
      rw [MeasureTheory.measure_compl
        ((τ i).measurableSet_event q hd)
        (MeasureTheory.measure_ne_top (parameterMeasure q) _),
        MeasureTheory.measure_univ, (τ i).event_mass q hd]
    _ = (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k))) ^ Fintype.card ι := by
      simp

theorem SuccessfulTrial.event_subset_tripleSumset (hq : 103 ≤ q)
    {k d m : ℕ} (hk : 1000 ≤ k)
    {T : RepresentationFamilies.PrimeTriple q d}
    (hd : d ∈ degreeIndices k)
    (τ : SuccessfulTrial q (k := k) (m := m) T) :
    τ.event q hd ⊆ {ω | m ∈ TripleSumset (sidonCandidateSet q ω)} := by
  exact trialCylinder_subset_tripleSumset q hq hk hd
    τ.f₁ τ.f₂ τ.f₃ τ.ne₁₂ τ.ne₁₃ τ.ne₂₃
    τ.r₁ τ.r₂ τ.r₃ τ.t₁ τ.t₂ τ.t₃ τ.block_sum

/-- Target digits, one congruent prime triple, and three available top
digits produce concrete successful trial data. -/
theorem exists_successfulTrial_of_congruentPrimeTriple (hq : 103 ≤ q)
    {k d m : ℕ} (hk : 1000 ≤ k) (hd : d ∈ degreeIndices k)
    (x y : Fin k → ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q j)
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j))
    (z : ℕ) (hzlower : 3 ≤ z)
    (hzupper : z ≤ 6 * 103 * q ^ (2 * k + 1))
    (hm : m = targetBlock q 0 k x y z)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (halog : ∀ (i : ℕ) (hi : i < k),
      FiniteFieldEncoding.logarithm q i
          (FiniteFieldEncoding.polynomialUnitOfNotDvd q i a (ha i hi)) =
        x ⟨i, hi⟩)
    (T : RepresentationFamilies.PrimeTriple q d)
    (hT : PolynomialInfrastructure.modulusProduct q k ∣ T.product q - a) :
    Nonempty (SuccessfulTrial q (k := k) (m := m) T) := by
  have hpow : 1 ≤ q ^ (3 * k) := Nat.one_le_pow _ _ (by omega)
  have hzrange : z ≤ 3 * q ^ (3 * k) :=
    targetTop_le_three_topRange q hq (by omega) hzupper
  obtain ⟨t₁, t₂, t₃, htop⟩ :=
    exists_three_topDigits_sum hpow hzlower hzrange
  obtain ⟨f₁, f₂, f₃, h12, h13, h23, hset,
      r₁, r₂, r₃, hblocks⟩ :=
    exists_three_blocks_eq_targetBlock_of_congruentPrimeTriple q
      (by omega) x y hx hy a ha halog T hT
      (t₁.val + 1) (t₂.val + 1) (t₃.val + 1) z htop
  exact ⟨{
    f₁ := f₁
    f₂ := f₂
    f₃ := f₃
    ne₁₂ := h12
    ne₁₃ := h13
    ne₂₃ := h23
    triple_eq := hset
    r₁ := r₁
    r₂ := r₂
    r₃ := r₃
    t₁ := t₁
    t₂ := t₂
    t₃ := t₃
    block_sum := by rw [hblocks, ← hm] }⟩

/-- Once a congruent-prime-triple family is available, its exact cardinality
feeds directly into the independent-trial failure bound.  This theorem is
the probability-theoretic interface consumed by the quantitative
prime-polynomial estimate. -/
theorem failure_measure_le_congruentPrimeTriples_pow (hq : 103 ≤ q)
    {k d m : ℕ} (hk : 1000 ≤ k) (hd : d ∈ degreeIndices k)
    (hdeg : 4 * d < k ^ 2)
    (x y : Fin k → ℕ)
    (hx : ∀ j : Fin k, x j < oddRadix q j)
    (hy : ∀ j : Fin k, CarryCovered auxiliaryDigitSet (y j))
    (z : ℕ) (hzlower : 3 ≤ z)
    (hzupper : z ≤ 6 * 103 * q ^ (2 * k + 1))
    (hm : m = targetBlock q 0 k x y z)
    (a : Polynomial (ZMod q))
    (ha : ∀ i < k,
      ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a)
    (halog : ∀ (i : ℕ) (hi : i < k),
      FiniteFieldEncoding.logarithm q i
          (FiniteFieldEncoding.polynomialUnitOfNotDvd q i a (ha i hi)) =
        x ⟨i, hi⟩) :
    parameterMeasure q
        {ω | m ∉ TripleSumset (sidonCandidateSet q ω)} ≤
      (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k))) ^
        (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
  classical
  let F := RepresentationFamilies.congruentPrimeTriples q k d a
  let T : (↥F) → RepresentationFamilies.PrimeTriple q d := fun U => U
  let τ : ∀ U : ↥F, SuccessfulTrial q (k := k) (m := m) (T U) := fun U =>
    Classical.choice (exists_successfulTrial_of_congruentPrimeTriple q hq hk hd
      x y hx hy z hzlower hzupper hm a ha halog U
      ((RepresentationFamilies.mem_congruentPrimeTriples (q := q)).mp
        U.property))
  have hdisj : ∀ U V : ↥F, U ≠ V → Disjoint (T U).1 (T V).1 := by
    intro U V hUV
    exact RepresentationFamilies.congruentPrimeTriples_pairwise_disjoint_finset
      q k d a hdeg U.property V.property (by
        intro huv
        exact hUV (Subtype.ext huv))
  calc
    parameterMeasure q {ω | m ∉ TripleSumset (sidonCandidateSet q ω)} ≤
        parameterMeasure q {ω | ∀ U : ↥F, ω ∉ (τ U).event q hd} := by
      apply MeasureTheory.measure_mono
      intro ω hmiss U hsuccess
      exact hmiss ((τ U).event_subset_tripleSumset q hq hk hd hsuccess)
    _ = (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k))) ^ Fintype.card (↥F) :=
      SuccessfulTrial.all_events_fail_mass q hd T τ hdisj
    _ = (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k))) ^
          (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
      simp only [F, Fintype.card_coe]

/-- A quantitative prime-triple count immediately converts the exact
failure term into a dyadic bound.  This isolates the sole arithmetic input
needed after the independent-trial calculation. -/
theorem congruentPrimeTriple_failure_term_le_half_pow
    {k d L : ℕ} (a : Polynomial (ZMod q))
    (hD : 2 ≤ trialDenominator q k)
    (hcount : trialDenominator q k * L ≤
      (RepresentationFamilies.congruentPrimeTriples q k d a).card) :
    (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
        (15 : ENNReal)⁻¹ ^ (3 * k))) ^
        (RepresentationFamilies.congruentPrimeTriples q k d a).card ≤
      ((2 : ENNReal)⁻¹) ^ L := by
  rw [trialProbability_eq_inv]
  exact ennreal_failure_pow_le_half_pow
    (trialDenominator q k)
    (RepresentationFamilies.congruentPrimeTriples q k d a).card L hD hcount

/-- The concrete quantitative specialization of Pilatte's use of Sawin's
square-root-cancellation theorem.  Its deliberately modest lower bound is
already far weaker than the published asymptotic
`q^((1 / 20 + o(1)) * k²)`, but is exactly what the formal probability
argument consumes. -/
def HasPrimeTripleAbundance : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    (∀ i < k, ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) →
    trialDenominator q k * dyadicExponent q k ≤
      (RepresentationFamilies.congruentPrimeTriples q k
        (canonicalDegreeIndex k) a).card

/-- Source-faithful eventual form of the quantitative prime-triple input.
Sawin's published estimate has an implicit constant, so Pilatte's argument
only asserts this property after an unspecified finite level. -/
def HasEventuallyPrimeTripleAbundance : Prop :=
  ∀ᶠ k : ℕ in atTop, ∀ a : Polynomial (ZMod q),
    (∀ i < k, ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) →
    trialDenominator q k * dyadicExponent q k ≤
      (RepresentationFamilies.congruentPrimeTriples q k
        (canonicalDegreeIndex k) a).card

/-- The previous explicit-threshold package is stronger than the eventual
package consumed by the final probabilistic argument. -/
theorem hasEventuallyPrimeTripleAbundance_of_primeTripleAbundance
    (habundance : HasPrimeTripleAbundance q) :
    HasEventuallyPrimeTripleAbundance q := by
  unfold HasEventuallyPrimeTripleAbundance
  rw [eventually_atTop]
  exact ⟨1000, fun k hk => habundance k hk⟩

/-- Ordered form of the same estimate.  The factor 6 = 3! is the exact
number of orderings of each unordered distinct triple.  This is the form
directly produced after removing repeated factors from Sawin's
factorization-function estimate. -/
def HasOrderedPrimeTripleAbundance : Prop :=
  ∀ k : ℕ, 1000 ≤ k → ∀ a : Polynomial (ZMod q),
    (∀ i < k, ¬ PolynomialInfrastructure.auxiliaryIrreducible q i ∣ a) →
    6 * (trialDenominator q k * dyadicExponent q k) ≤
      Fintype.card (RepresentationFamilies.CongruentPrimeTripleOrdering q k
        (canonicalDegreeIndex k) a)

/-- All elementary estimates needed after the Sawin progression theorem.
For the certified large coefficient field, the global binomial main term
strictly dominates both Sawin's error and the trial reserve. -/
theorem mainTermDominates_for_requiredTrials (hq : 2 ^ 500 ≤ q) :
    SawinSpecialization.MainTermDominates q
      (fun k => trialDenominator q k * dyadicExponent q k) := by
  intro k hk
  let i := canonicalDegreeIndex k
  let d := 2 * i
  let φ := SawinSpecialization.progressionTotient q k
  let L := trialDenominator q k * dyadicExponent q k
  let E := SawinSpecialization.sievedEqualDegreeError q d (k ^ 2)
  let F := 192 * d ^ 3
  have hd : 2 ≤ d := by
    dsimp only [d, i, canonicalDegreeIndex]
    omega
  have hrange : 21 * k ^ 2 ≤ 60 * d := by
    have hsawin := Construction.modulus_degree_in_sawin_range (by omega : 3 ≤ k)
    dsimp only [d, i]
    omega
  have hL : F * φ * L ≤ q ^ (3 * d - 1) := by
    simpa only [F, φ, L] using
      scaled_requiredTrials_le_predecessor q hq hk hrange
  have hE : F * φ * E ≤ q ^ (3 * d - 1) := by
    simpa only [F, φ, E] using
      SawinSpecialization.scaled_sievedEqualDegreeError_le_predecessor
        q hq hk hrange
  have hq_two : 2 < q := by
    have hsmall : 2 ^ 3 ≤ 2 ^ 500 :=
      Nat.pow_le_pow_right (by omega) (by omega)
    norm_num at hsmall
    omega
  have hpower_pos : 0 < q ^ (3 * d - 1) :=
    Nat.pow_pos ((Fact.out : q.Prime).pos)
  have hscaled : F * φ * (L + E) < q ^ (3 * d) := by
    calc
      F * φ * (L + E) = F * φ * L + F * φ * E := by ring
      _ ≤ q ^ (3 * d - 1) + q ^ (3 * d - 1) := Nat.add_le_add hL hE
      _ = 2 * q ^ (3 * d - 1) := by ring
      _ < q * q ^ (3 * d - 1) :=
        Nat.mul_lt_mul_of_pos_right hq_two hpower_pos
      _ = q ^ (3 * d) := by
        calc
          q * q ^ (3 * d - 1) = q ^ (3 * d - 1) * q := Nat.mul_comm _ _
          _ = q ^ ((3 * d - 1) + 1) := (pow_succ _ _).symm
          _ = q ^ (3 * d) := by congr 1 <;> omega
  have hP : 4 ≤ SawinSpecialization.primePolynomialCount q d :=
    SawinSpecialization.four_le_primePolynomialCount q hq hd
  have hmainPower : q ^ (3 * d) ≤
      F * Nat.choose (SawinSpecialization.primePolynomialCount q d) 3 := by
    simpa only [F] using
      SawinSpecialization.primePolynomialCount_cube_bound q hq hd hP
  have hF : 0 < F := by
    dsimp only [F]
    positivity
  have hmul : F * (φ * (L + E)) <
      F * Nat.choose (SawinSpecialization.primePolynomialCount q d) 3 := by
    simpa only [Nat.mul_assoc] using hscaled.trans_le hmainPower
  have hcancel := (Nat.mul_lt_mul_left hF).mp hmul
  simpa only [φ, L, E, d, i] using hcancel

theorem hasPrimeTripleAbundance_of_ordered
    (hordered : HasOrderedPrimeTripleAbundance q) :
    HasPrimeTripleAbundance q := by
  intro k hk a ha
  have hcard :=
    RepresentationFamilies.congruentPrimeTripleOrdering_card q k
      (canonicalDegreeIndex k) a
  have h := hordered k hk a ha
  rw [hcard] at h
  omega

/-- The exact Sawin progression estimate plus the explicit elementary main
term comparison imply the sole cardinality input of the probability layer. -/
theorem hasPrimeTripleAbundance_of_sawin
    (hSawin : SawinSpecialization.HasEqualDegreeSawinBound q)
    (hmain : SawinSpecialization.MainTermDominates q
      (fun k => trialDenominator q k * dyadicExponent q k)) :
    HasPrimeTripleAbundance q := by
  intro k hk a ha
  exact SawinSpecialization.count_le_of_equalDegreeSawinBound q hSawin hk a ha
    (hmain k hk)

/-- An eventual prime-triple estimate suffices: enlarge its level threshold,
then absorb all targets represented below that level into a finite prefix. -/
theorem eventually_failure_invSquare_of_eventuallyPrimeTripleAbundance
    (hq : 103 ≤ q) (habundance : HasEventuallyPrimeTripleAbundance q) :
    ∀ᶠ m : ℕ in atTop,
      parameterMeasure q
          {ω | m ∉ TripleSumset (sidonCandidateSet q ω)} ≤
        ENNReal.ofReal (1 / |(m : ℝ) + 1| ^ (2 : ℝ)) := by
  unfold HasEventuallyPrimeTripleAbundance at habundance
  rw [eventually_atTop] at habundance
  obtain ⟨K, hK⟩ := habundance
  let K₀ := max 1000 K
  rw [eventually_atTop]
  refine ⟨largeTargetThresholdFrom q K₀ + 1, ?_⟩
  intro m hm
  have hlarge : largeTargetThresholdFrom q K₀ < m := by omega
  obtain ⟨k, x, y, z, hk₀, hx, hy, hmblock, hzlower, hzupper⟩ :=
    exists_large_targetBlock_data_from (q := q) hq hlarge
  have hk : 1000 ≤ k := (le_max_left 1000 K).trans hk₀
  have hkK : K ≤ k := (le_max_right 1000 K).trans hk₀
  obtain ⟨a, ha, halog⟩ :=
    FiniteFieldEncoding.exists_polynomial_with_logarithms q k x hx
  let d := canonicalDegreeIndex k
  have hd : d ∈ degreeIndices k := canonicalDegreeIndex_mem (by omega)
  have hdeg : 4 * d < k ^ 2 := by
    exact four_mul_canonicalDegreeIndex_lt_sq (by omega)
  have hfailure := failure_measure_le_congruentPrimeTriples_pow q hq hk hd hdeg
    x y hx hy z hzlower hzupper hmblock a ha halog
  have hD : 2 ≤ trialDenominator q k :=
    two_le_trialDenominator q (by omega) (by omega)
  have hcount : trialDenominator q k * dyadicExponent q k ≤
      (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
    simpa only [d] using hK k hkK a ha
  have hdyadic := congruentPrimeTriple_failure_term_le_half_pow q a hD hcount
  have hmupper : m ≤ q ^ (k ^ 2 + 3 * k + 4) := by
    rw [hmblock]
    exact targetBlock_le_levelPower q hq hk x y hx hy hzupper
  have hsquare : (m + 1) ^ 2 ≤ 2 ^ dyadicExponent q k :=
    square_succ_le_two_pow_dyadicExponent q hq hmupper
  calc
    parameterMeasure q
        {ω | m ∉ TripleSumset (sidonCandidateSet q ω)} ≤
        (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
          (15 : ENNReal)⁻¹ ^ (3 * k))) ^
          (RepresentationFamilies.congruentPrimeTriples q k d a).card :=
      hfailure
    _ ≤ ((2 : ENNReal)⁻¹) ^ dyadicExponent q k := hdyadic
    _ ≤ ENNReal.ofReal (1 / |(m : ℝ) + 1| ^ (2 : ℝ)) :=
      ennreal_half_pow_le_invSquare hsquare

/-- Once the specialized Sawin estimate is available, all remaining
arithmetic, independence, and size comparisons yield Pilatte's precise
eventual inverse-square one-point estimate. -/
theorem eventually_failure_invSquare_of_primeTripleAbundance
    (hq : 103 ≤ q) (habundance : HasPrimeTripleAbundance q) :
    ∀ᶠ m : ℕ in atTop,
      parameterMeasure q
          {ω | m ∉ TripleSumset (sidonCandidateSet q ω)} ≤
        ENNReal.ofReal (1 / |(m : ℝ) + 1| ^ (2 : ℝ)) := by
  rw [eventually_atTop]
  refine ⟨largeTargetThreshold q + 1, ?_⟩
  intro m hm
  have hlarge : largeTargetThreshold q < m := by omega
  obtain ⟨k, x, y, z, hk, hx, hy, hmblock, hzlower, hzupper⟩ :=
    exists_large_targetBlock_data (q := q) hq hlarge
  obtain ⟨a, ha, halog⟩ :=
    FiniteFieldEncoding.exists_polynomial_with_logarithms q k x hx
  let d := canonicalDegreeIndex k
  have hd : d ∈ degreeIndices k := canonicalDegreeIndex_mem (by omega)
  have hdeg : 4 * d < k ^ 2 := by
    exact four_mul_canonicalDegreeIndex_lt_sq (by omega)
  have hfailure := failure_measure_le_congruentPrimeTriples_pow q hq hk hd hdeg
    x y hx hy z hzlower hzupper hmblock a ha halog
  have hD : 2 ≤ trialDenominator q k :=
    two_le_trialDenominator q (by omega) (by omega)
  have hcount : trialDenominator q k * dyadicExponent q k ≤
      (RepresentationFamilies.congruentPrimeTriples q k d a).card := by
    simpa only [d] using habundance k hk a ha
  have hdyadic := congruentPrimeTriple_failure_term_le_half_pow q a hD hcount
  have hmupper : m ≤ q ^ (k ^ 2 + 3 * k + 4) := by
    rw [hmblock]
    exact targetBlock_le_levelPower q hq hk x y hx hy hzupper
  have hsquare : (m + 1) ^ 2 ≤ 2 ^ dyadicExponent q k :=
    square_succ_le_two_pow_dyadicExponent q hq hmupper
  calc
    parameterMeasure q
        {ω | m ∉ TripleSumset (sidonCandidateSet q ω)} ≤
        (1 - (((q ^ (3 * k) : ℕ) : ENNReal)⁻¹ ^ 3 *
          (15 : ENNReal)⁻¹ ^ (3 * k))) ^
          (RepresentationFamilies.congruentPrimeTriples q k d a).card :=
      hfailure
    _ ≤ ((2 : ENNReal)⁻¹) ^ dyadicExponent q k := hdyadic
    _ ≤ ENNReal.ofReal (1 / |(m : ℝ) + 1| ^ (2 : ℝ)) :=
      ennreal_half_pow_le_invSquare hsquare

end RandomParameters

/-! ## The Borel--Cantelli extraction step -/

section BorelCantelli

variable {Ω : Type*} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ]

/-- If the probabilities that `n` is missed by a random set's three-fold
sumset are summable, some outcome is an asymptotic basis of order three.

This is the exact final probabilistic step in Pilatte's proof. The first
Borel--Cantelli lemma used here does not require independence. -/
theorem exists_isAsymptoticBasisOfOrderThree_of_summable_failure
    (randomSet : Ω → Set ℕ)
    (hsum : (∑' n : ℕ,
      μ {ω | n ∉ TripleSumset (randomSet ω)}) ≠ ⊤) :
    ∃ ω : Ω, IsAsymptoticBasisOfOrderThree (randomSet ω) := by
  have hAE := MeasureTheory.ae_eventually_notMem
    (μ := μ) (s := fun n : ℕ => {ω | n ∉ TripleSumset (randomSet ω)}) hsum
  obtain ⟨ω, hω⟩ := hAE.exists
  refine ⟨ω, (isAsymptoticBasisOfOrderThree_iff_eventually _).2 ?_⟩
  filter_upwards [hω] with n hn
  simpa only [Set.mem_ofPred_eq, not_not] using hn

/-- Packaging the deterministic Sidon property with the Borel--Cantelli
extraction gives the exact conclusion of Erdős Problem 157. Infinitude does
not need to be carried as a separate probabilistic invariant. -/
theorem exists_infinite_sidon_basis_of_summable_failure
    (randomSet : Ω → Set ℕ)
    (hSidon : ∀ ω, IsSidon (randomSet ω))
    (hsum : (∑' n : ℕ,
      μ {ω | n ∉ TripleSumset (randomSet ω)}) ≠ ⊤) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  obtain ⟨ω, hBasis⟩ :=
    exists_isAsymptoticBasisOfOrderThree_of_summable_failure μ randomSet hsum
  exact ⟨randomSet ω, infinite_of_isAsymptoticBasisOfOrderThree hBasis,
    hSidon ω, hBasis⟩

omit [MeasureTheory.IsProbabilityMeasure μ] in
/-- A uniform inverse-square upper bound is enough for the summability
hypothesis in the first Borel--Cantelli lemma.  The constant permits the
finitely many small targets to be absorbed into the same estimate. -/
theorem summable_failure_of_invSquare_bound
    (randomSet : Ω → Set ℕ) (C : NNReal)
    (hbound : ∀ n : ℕ,
      μ {ω | n ∉ TripleSumset (randomSet ω)} ≤
        (C : ENNReal) * ENNReal.ofReal
          (1 / |(n : ℝ) + 1| ^ (2 : ℝ))) :
    (∑' n : ℕ, μ {ω | n ∉ TripleSumset (randomSet ω)}) ≠ ⊤ := by
  have hu : Summable (fun n : ℕ => 1 / |(n : ℝ) + 1| ^ (2 : ℝ)) :=
    (Real.summable_one_div_nat_add_rpow 1 2).2 (by norm_num)
  have hmajor :
      (∑' n : ℕ, (C : ENNReal) * ENNReal.ofReal
        (1 / |(n : ℝ) + 1| ^ (2 : ℝ))) ≠ ⊤ := by
    rw [ENNReal.tsum_mul_left]
    exact ENNReal.mul_ne_top ENNReal.coe_ne_top hu.tsum_ofReal_ne_top
  exact ne_top_of_le_ne_top hmajor (ENNReal.tsum_le_tsum hbound)

/-- Pilatte's estimate is only asserted for sufficiently large targets.
This tail version shows directly that such an eventual inverse-square bound
still gives a finite total failure mass; the finite prefix is handled using
finiteness of a probability measure. -/
theorem summable_failure_of_eventually_invSquare_bound
    (randomSet : Ω → Set ℕ)
    (hbound : ∀ᶠ n : ℕ in atTop,
      μ {ω | n ∉ TripleSumset (randomSet ω)} ≤
        ENNReal.ofReal (1 / |(n : ℝ) + 1| ^ (2 : ℝ))) :
    (∑' n : ℕ, μ {ω | n ∉ TripleSumset (randomSet ω)}) ≠ ⊤ := by
  have hu : Summable (fun n : ℕ => 1 / |(n : ℝ) + 1| ^ (2 : ℝ)) :=
    (Real.summable_one_div_nat_add_rpow 1 2).2 (by norm_num)
  have hreal : Summable (fun n : ℕ =>
      (μ {ω | n ∉ TripleSumset (randomSet ω)}).toReal) := by
    apply hu.of_norm_bounded_eventually_nat
    filter_upwards [hbound] with n hn
    rw [Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    have hu0 : 0 ≤ 1 / |(n : ℝ) + 1| ^ (2 : ℝ) := by positivity
    calc
      (μ {ω | n ∉ TripleSumset (randomSet ω)}).toReal ≤
          (ENNReal.ofReal (1 / |(n : ℝ) + 1| ^ (2 : ℝ))).toReal :=
        ENNReal.toReal_mono ENNReal.ofReal_ne_top hn
      _ = 1 / |(n : ℝ) + 1| ^ (2 : ℝ) := ENNReal.toReal_ofReal hu0
  have hnn : Summable (fun n : ℕ =>
      (μ {ω | n ∉ TripleSumset (randomSet ω)}).toNNReal) := by
    apply (NNReal.summable_coe).1
    change Summable (fun n : ℕ =>
      (μ {ω | n ∉ TripleSumset (randomSet ω)}).toReal)
    exact hreal
  have hcoe : ∀ n : ℕ,
      ((μ {ω | n ∉ TripleSumset (randomSet ω)}).toNNReal : ENNReal) =
        μ {ω | n ∉ TripleSumset (randomSet ω)} := by
    intro n
    exact ENNReal.coe_toNNReal (MeasureTheory.measure_ne_top μ _)
  rw [← tsum_congr hcoe]
  exact ENNReal.tsum_coe_ne_top_iff_summable.2 hnn

/-- The exact downstream package needed from Pilatte's construction: a
deterministically Sidon random set and a uniform inverse-square failure
bound produce an infinite Sidon asymptotic basis. -/
theorem exists_infinite_sidon_basis_of_invSquare_bound
    (randomSet : Ω → Set ℕ) (C : NNReal)
    (hSidon : ∀ ω, IsSidon (randomSet ω))
    (hbound : ∀ n : ℕ,
      μ {ω | n ∉ TripleSumset (randomSet ω)} ≤
        (C : ENNReal) * ENNReal.ofReal
          (1 / |(n : ℝ) + 1| ^ (2 : ℝ))) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  exact exists_infinite_sidon_basis_of_summable_failure μ randomSet hSidon
    (summable_failure_of_invSquare_bound μ randomSet C hbound)

/-- Final extraction in the exact asymptotic form delivered by Pilatte's
one-point estimate. -/
theorem exists_infinite_sidon_basis_of_eventually_invSquare_bound
    (randomSet : Ω → Set ℕ)
    (hSidon : ∀ ω, IsSidon (randomSet ω))
    (hbound : ∀ᶠ n : ℕ in atTop,
      μ {ω | n ∉ TripleSumset (randomSet ω)} ≤
        ENNReal.ofReal (1 / |(n : ℝ) + 1| ^ (2 : ℝ))) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  exact exists_infinite_sidon_basis_of_summable_failure μ randomSet hSidon
    (summable_failure_of_eventually_invSquare_bound μ randomSet hbound)

end BorelCantelli

/-! ## Assembly after the finite-field counting estimate -/

/-- Pilatte's probabilistic construction only consumes an eventual
prime-triple estimate.  Any unspecified finite threshold in Sawin's
asymptotic theorem is absorbed into the finite exceptional prefix. -/
theorem erdos_157_of_eventuallyPrimeTripleAbundance
    (q : ℕ) [Fact q.Prime] (hq : 103 ≤ q)
    (abundance : RandomParameters.HasEventuallyPrimeTripleAbundance q) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  exact exists_infinite_sidon_basis_of_eventually_invSquare_bound
    (RandomParameters.parameterMeasure q)
    (Construction.sidonCandidateSet q)
    (Construction.sidonCandidateSet_isSidon q hq)
    (RandomParameters.eventually_failure_invSquare_of_eventuallyPrimeTripleAbundance
      q hq abundance)

/-- Every part of Problem 157 after the specialized Pilatte--Sawin
prime-triple estimate is now formal: the estimate supplies the summable
failure probabilities, while the construction is Sidon for every value of
the random parameters. -/
theorem erdos_157_of_primeTripleAbundance (q : ℕ) [Fact q.Prime]
    (hq : 103 ≤ q) (habundance : RandomParameters.HasPrimeTripleAbundance q) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  exact exists_infinite_sidon_basis_of_eventually_invSquare_bound
    (RandomParameters.parameterMeasure q)
    (Construction.sidonCandidateSet q)
    (Construction.sidonCandidateSet_isSidon q hq)
    (RandomParameters.eventually_failure_invSquare_of_primeTripleAbundance
