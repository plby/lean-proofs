  · simp
  · intro i
    change (affineRootPermutation K (2 * d)
        (twoBlockPermutationFamily d π)).appTop
          ((affineProperPairResidueMultiplication K d m g hg).appTop
            (AffineSpace.coord (Spec (.of K)) i)) =
      (affineProperPairResidueMultiplication K d m g hg).appTop
        (AffineSpace.coord (Spec (.of K)) i)
    rw [affineProperPairResidueMultiplication_appTop_coord]
    have h := congrArg (fun p => p.coeff i.down)
      (affineRootPermutation_universalProperPairRemainder K d g hg π)
    simpa only [Polynomial.coeff_map] using h

