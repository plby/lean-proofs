/-- Product of the three within-block Vandermonde determinants. It removes
collisions inside each Frobenius block but permits collisions across blocks. -/
noncomputable def threeBlockVandermondeSection
    (K : Type u) [CommRing K] (d : ℕ) :
    Γ(AffineRootSpace K (3 * d), ⊤) :=
  ∏ b : Fin 3, (Matrix.vandermonde (fun j : Fin d =>
    AffineSpace.coord (Spec (.of K))
      (ULift.up (finProdFinEquiv (b, j))))).det

theorem affineRootPoint_threeBlockVandermondeSection
    (q d : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (a : Spec (.of F) ⟶ AffineRootSpace (ZMod q) (3 * d)) :
    (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (threeBlockVandermondeSection (ZMod q) d)) =
      ∏ b : Fin 3, (Matrix.vandermonde (fun j : Fin d =>
        affineRootPointCoordinates (ZMod q) (3 * d) a
          (finProdFinEquiv (b, j)))).det := by
  unfold threeBlockVandermondeSection affineRootPointCoordinates
  rw [map_prod, map_prod]
  apply Finset.prod_congr rfl
  intro b _hb
  rw [RingHom.map_det, RingHom.map_det]
  apply congrArg Matrix.det
  ext i j
  simp [Matrix.vandermonde_apply]

theorem affineRootPoint_threeBlockVandermondeSection_ne_zero_iff
    (q d : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q]
    (a : Spec (.of F) ⟶ AffineRootSpace (ZMod q) (3 * d)) :
    (Scheme.ΓSpecIso (.of F)).hom
        (a.appTop (threeBlockVandermondeSection (ZMod q) d)) ≠ 0 ↔
      ∀ b : Fin 3, Function.Injective (fun j : Fin d =>
        affineRootPointCoordinates (ZMod q) (3 * d) a
          (finProdFinEquiv (b, j))) := by
  rw [affineRootPoint_threeBlockVandermondeSection]
  rw [Finset.prod_ne_zero_iff]
  constructor
  · intro h b
    exact (Matrix.det_vandermonde_ne_zero_iff).mp (h b (Finset.mem_univ b))
  · intro h b _hb
    exact (Matrix.det_vandermonde_ne_zero_iff).mpr (h b)

noncomputable def threeBlockCycleSignScalar
    (K : Type u) [Field K] (d : ℕ) :
    Γ(AffineRootSpace K (3 * d), ⊤) :=
  ((Equiv.Perm.sign (finRotate d).symm : ℤ) :
    Γ(AffineRootSpace K (3 * d), ⊤))

theorem affineRootPermutation_appTop_threeBlockVandermondeSection
    (K : Type u) [Field K] (d : ℕ) :
    (affineRootPermutation K (3 * d) (threeBlockCyclePermutation d)).appTop
        (threeBlockVandermondeSection K d) =
      (threeBlockCycleSignScalar K d) ^ 3 *
        threeBlockVandermondeSection K d := by
  unfold threeBlockVandermondeSection
  rw [map_prod]
  have hmatrix : ∀ b : Fin 3,
      (affineRootPermutation K (3 * d)
        (threeBlockCyclePermutation d)).appTop.hom.mapMatrix
          (Matrix.vandermonde (fun j : Fin d =>
            AffineSpace.coord (Spec (.of K))
              (ULift.up (finProdFinEquiv (b, j))))) =
        (Matrix.vandermonde (fun j : Fin d =>
          AffineSpace.coord (Spec (.of K))
            (ULift.up (finProdFinEquiv (b, j))))).submatrix
              (finRotate d).symm id := by
    intro b
    rw [RingHom.mapMatrix_apply]
    ext i j
    simp only [Matrix.map_apply, Matrix.vandermonde_apply,
      map_pow, Matrix.submatrix_apply, Function.comp_apply, id_eq]
    rw [affineRootPermutation_appTop_coord]
    rw [threeBlockCyclePermutation_apply]
  simp_rw [RingHom.map_det, hmatrix, Matrix.det_permute]
  change (∏ b : Fin 3,
      (threeBlockCycleSignScalar K d *
       (Matrix.vandermonde (fun j : Fin d =>
          AffineSpace.coord (Spec (.of K))
            (ULift.up (finProdFinEquiv (b, j))))).det)) = _
  rw [Finset.prod_mul_distrib]
  simp

noncomputable def FullResidueUnitFiberBlockwiseDistinctOpen
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) :
    (FullResidueUnitFiber K (3 * d) m g hg hdeg hm hmn t).Opens :=
  (FullResidueUnitFiber K (3 * d) m g hg hdeg hm hmn t).basicOpen
    (((fullResidueUnitFiberToRootSpace K (3 * d) m g hg hdeg hm hmn t) ≫
      (RootSpaceOpen K (3 * d) g).ι).appTop
        (threeBlockVandermondeSection K d))

noncomputable abbrev FullResidueUnitFiberBlockwiseDistinct
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint K m g) : Scheme.{u} :=
  (FullResidueUnitFiberBlockwiseDistinctOpen
    K d m g hg hdeg hm hmn t).toScheme

noncomputable def fullResidueUnitFiberBlockwiseDistinctι
