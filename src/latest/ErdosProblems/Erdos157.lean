namespace FrobeniusRepresentation

variable {K G V H : Type*} [Field K] [Group G] [Group H]
  [AddCommGroup V] [Module K V]

/-- Restrict a commuting Frobenius representation along a group homomorphism. -/
def restrict (data : FrobeniusRepresentation K G V) (phi : H →* G) :
    FrobeniusRepresentation K H V where
  representation := data.representation.comp phi
  frobenius := data.frobenius
  commutes h := data.commutes (phi h)

@[simp]
theorem restrict_twistedTrace [FiniteDimensional K V]
    (data : FrobeniusRepresentation K G V) (phi : H →* G) (h : H) :
    (data.restrict phi).twistedTrace h = data.twistedTrace (phi h) := by
  rfl

end FrobeniusRepresentation

namespace FiniteFrobeniusRepresentation

variable {K G H : Type*} [Field K] [Group G] [Group H]

/-- Restrict a packaged finite Frobenius representation along a group homomorphism. -/
noncomputable def restrict (P : FiniteFrobeniusRepresentation K G)
    (phi : H →* G) : FiniteFrobeniusRepresentation K H := by
  letI := P.addCommGroup
  letI := P.module
  letI := P.finiteDimensional
  exact
    { V := P.V
      addCommGroup := P.addCommGroup
      module := P.module
      finiteDimensional := P.finiteDimensional
      data := P.data.restrict phi }

@[simp]
theorem restrict_twistedTrace (P : FiniteFrobeniusRepresentation K G)
    (phi : H →* G) (h : H) :
    (P.restrict phi).twistedTrace h = P.twistedTrace (phi h) := by
  rfl

end FiniteFrobeniusRepresentation

/-- The blockwise inclusion of three symmetric groups into the symmetric
group on their disjoint union. -/
noncomputable def threeBlockPermutationFamilyHom (d : ℕ) :
    (Fin 3 → Equiv.Perm (Fin d)) →* Equiv.Perm (Fin (3 * d)) where
  toFun := threeBlockPermutationFamily d
  map_one' := by
    ext x
    obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective x
    simp
  map_mul' pi rho := by
    ext x
    obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective x
    simp

@[simp]
theorem threeBlockPermutationFamilyHom_apply
    (d : ℕ) (pi : Fin 3 → Equiv.Perm (Fin d)) :
    threeBlockPermutationFamilyHom d pi =
      threeBlockPermutationFamily d pi := rfl

/-- The normalized full-distinct Frobenius package restricted to the three
block permutation group used by the von-Mangoldt character expansion. -/
