theorem properPairResidueFiberDistinctTwistedFixedPointTraceMatrix_trace
    (q d m ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (π₀ π₁ : Equiv.Perm (Fin d)) :
    letI : Fintype
        {z : Spec (.of F) ⟶
            ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
          z ≫ properPairResidueFiberDistinctTwistedFrobenius
            q d m g t hg ![π₀, π₁] = z} :=
      @Fintype.ofFinite _
        (finiteProperPairResidueFiberDistinctTwistedFixedPointData
          q d m F g t hg hdeg ht π₀ π₁)
    (properPairResidueFiberDistinctTwistedFixedPointTraceMatrix
      q d m ℓ F g t hg hdeg ht π₀ π₁).trace =
      (Nat.card {z : Spec (.of F) ⟶
          ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        z ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg ![π₀, π₁] = z} : ℚ_[ℓ]) := by
  let : Finite
      {z : Spec (.of F) ⟶
          ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        z ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg ![π₀, π₁] = z} :=
    finiteProperPairResidueFiberDistinctTwistedFixedPointData
      q d m F g t hg hdeg ht π₀ π₁
  let : Fintype
      {z : Spec (.of F) ⟶
          ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        z ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg ![π₀, π₁] = z} := Fintype.ofFinite _
  unfold properPairResidueFiberDistinctTwistedFixedPointTraceMatrix
    Matrix.trace
  rw [Nat.card_eq_fintype_card]
  simp

theorem twoBlockPermutationFamily_mul
    (d : ℕ) (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    twoBlockPermutationFamily d (π * ρ) =
      twoBlockPermutationFamily d π * twoBlockPermutationFamily d ρ := by
  apply Equiv.ext
  intro i
  obtain ⟨⟨b, j⟩, rfl⟩ := finProdFinEquiv.surjective i
  simp

theorem properPairResidueFiberPermutation_comp
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberPermutation K d m g t hg π ≫
      properPairResidueFiberPermutation K d m g t hg ρ =
    properPairResidueFiberPermutation K d m g t hg (π * ρ) := by
  apply pullback.hom_ext
  · change (properPairResidueFiberPermutation K d m g t hg π ≫
        properPairResidueFiberPermutation K d m g t hg ρ) ≫
        properPairResidueFiberToRootSpace K d m g t hg =
      properPairResidueFiberPermutation K d m g t hg (π * ρ) ≫
        properPairResidueFiberToRootSpace K d m g t hg
    rw [Category.assoc,
      properPairResidueFiberPermutation_toRootSpace,
      ← Category.assoc,
      properPairResidueFiberPermutation_toRootSpace,
      Category.assoc, rootPermutation_comp,
      ← twoBlockPermutationFamily_mul,
      properPairResidueFiberPermutation_toRootSpace]
  · change (properPairResidueFiberPermutation K d m g t hg π ≫
        properPairResidueFiberPermutation K d m g t hg ρ) ≫
        properPairResidueFiberProjection K d m g t hg =
      properPairResidueFiberPermutation K d m g t hg (π * ρ) ≫
        properPairResidueFiberProjection K d m g t hg
    rw [Category.assoc, properPairResidueFiberPermutation_over,
      properPairResidueFiberPermutation_over,
      properPairResidueFiberPermutation_over]

theorem properPairResidueFiberDistinctPermutation_comp
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctPermutation K d m g t hg π ≫
      properPairResidueFiberDistinctPermutation K d m g t hg ρ =
    properPairResidueFiberDistinctPermutation K d m g t hg (π * ρ) := by
  apply (cancel_mono
    (properPairResidueFiberDistinctι K d m g t hg)).1
  rw [Category.assoc, properPairResidueFiberDistinctPermutation_ι,
    ← Category.assoc, properPairResidueFiberDistinctPermutation_ι,
    Category.assoc, properPairResidueFiberPermutation_comp,
    properPairResidueFiberDistinctPermutation_ι]

theorem properPairResidueFiberDistinctProjectiveClosurePermutation_comp
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctProjectiveClosurePermutation
        q d m g t hg π ≫
      properPairResidueFiberDistinctProjectiveClosurePermutation
        q d m g t hg ρ =
    properPairResidueFiberDistinctProjectiveClosurePermutation
        q d m g t hg (π * ρ) := by
  apply (cancel_mono
    (properPairResidueFiberDistinctToProjectiveRootSpace
      q d m g t hg).imageι).1
  rw [Category.assoc,
    properPairResidueFiberDistinctProjectiveClosurePermutation_imageι,
    ← Category.assoc,
    properPairResidueFiberDistinctProjectiveClosurePermutation_imageι,
    Category.assoc, projectiveRootPermutation_comp,
    ← twoBlockPermutationFamily_mul,
    properPairResidueFiberDistinctProjectiveClosurePermutation_imageι]

theorem properPairResidueFiberDistinctPermutation_one
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    properPairResidueFiberDistinctPermutation K d m g t hg 1 = 𝟙 _ := by
  let f := properPairResidueFiberDistinctPermutation K d m g t hg 1
  apply (cancel_epi f).1
  change f ≫ f = f ≫ 𝟙 _
  rw [Category.comp_id]
  simpa only [one_mul] using
    properPairResidueFiberDistinctPermutation_comp
      K d m g t hg 1 1

theorem properPairResidueFiberDistinctProjectiveClosurePermutation_one
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    properPairResidueFiberDistinctProjectiveClosurePermutation
      q d m g t hg 1 = 𝟙 _ := by
  let f := properPairResidueFiberDistinctProjectiveClosurePermutation
    q d m g t hg 1
  apply (cancel_epi f).1
  change f ≫ f = f ≫ 𝟙 _
  rw [Category.comp_id]
  simpa only [one_mul] using
    properPairResidueFiberDistinctProjectiveClosurePermutation_comp
      q d m g t hg 1 1

noncomputable def properPairResidueFiberDistinctPermutationAction
    (K : Type*) [Field K] (d m : ℕ)
    (g t : Polynomial K) (hg : g.Monic) :
    (Fin 2 → Equiv.Perm (Fin d)) →*
      End (ProperPairResidueFiberDistinct K d m g t hg) where
  toFun π := properPairResidueFiberDistinctPermutation
    K d m g t hg (fun b ↦ (π b).symm)
  map_one' := by
    apply End.ext
    have hone : (fun b : Fin 2 ↦ ((1 : Fin 2 → Equiv.Perm (Fin d)) b).symm) = 1 := by
      funext b
      rfl
    rw [hone]
    exact properPairResidueFiberDistinctPermutation_one K d m g t hg
  map_mul' π ρ := by
    apply End.ext
    have hmul : (fun b ↦ ((π * ρ) b).symm) =
        (fun b ↦ (ρ b).symm) * (fun b ↦ (π b).symm) := by
      funext b
      rfl
    rw [hmul]
    exact (properPairResidueFiberDistinctPermutation_comp
      K d m g t hg (fun b ↦ (ρ b).symm)
        (fun b ↦ (π b).symm)).symm

/-- The same two-block action on the canonical proper projective closure. -/
noncomputable def
    properPairResidueFiberDistinctProjectiveClosurePermutationAction
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    (Fin 2 → Equiv.Perm (Fin d)) →*
      End (ProperPairResidueFiberDistinctProjectiveClosure
        q d m g t hg) where
  toFun π := properPairResidueFiberDistinctProjectiveClosurePermutation
    q d m g t hg (fun b ↦ (π b).symm)
  map_one' := by
    apply End.ext
    have hone :
        (fun b : Fin 2 ↦ ((1 : Fin 2 → Equiv.Perm (Fin d)) b).symm) = 1 := by
      funext b
      rfl
    rw [hone]
    exact properPairResidueFiberDistinctProjectiveClosurePermutation_one
      q d m g t hg
  map_mul' π ρ := by
    apply End.ext
    have hmul : (fun b ↦ ((π * ρ) b).symm) =
        (fun b ↦ (ρ b).symm) * (fun b ↦ (π b).symm) := by
      funext b
      rfl
    rw [hmul]
    exact (properPairResidueFiberDistinctProjectiveClosurePermutation_comp
      q d m g t hg (fun b ↦ (ρ b).symm)
        (fun b ↦ (π b).symm)).symm

@[reassoc (attr := simp)]
theorem properPairResidueFiberDistinctPermutation_over
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctPermutation
        (ZMod q) d m g t hg π ≫
      properPairResidueFiberDistinctProjection q d m g t hg =
    properPairResidueFiberDistinctProjection q d m g t hg := by
  unfold properPairResidueFiberDistinctProjection
  rw [← Category.assoc, properPairResidueFiberDistinctPermutation_ι,
    Category.assoc, properPairResidueFiberPermutation_over]

/-- The block-permutation action is defined over the prime field and hence
commutes with relative Frobenius on the proper-pair fiber. -/
theorem properPairResidueFiberDistinctFrobenius_permutation
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctFrobenius q d m g t hg ≫
        properPairResidueFiberDistinctPermutation
          (ZMod q) d m g t hg π =
      properPairResidueFiberDistinctPermutation
          (ZMod q) d m g t hg π ≫
        properPairResidueFiberDistinctFrobenius q d m g t hg := by
  unfold properPairResidueFiberDistinctFrobenius
  exact affineSchemeFrobeniusOver_naturality
    (properPairResidueFiberDistinctPermutation
      (ZMod q) d m g t hg π) q
    (properPairResidueFiberDistinctProjection q d m g t hg)
    (properPairResidueFiberDistinctProjection q d m g t hg)

/-- Conjugating a two-block permutation conjugates its twisted Frobenius
endomorphism. -/
theorem properPairResidueFiberDistinctPermutation_twistedFrobenius_conj
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctPermutation
          (ZMod q) d m g t hg ρ ≫
        properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg (ρ⁻¹ * π * ρ) =
      properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg π ≫
        properPairResidueFiberDistinctPermutation
          (ZMod q) d m g t hg ρ := by
  unfold properPairResidueFiberDistinctTwistedFrobenius
  simp only [Category.assoc]
  rw [← Category.assoc,
    properPairResidueFiberDistinctPermutation_comp]
  rw [properPairResidueFiberDistinctFrobenius_permutation]
  rw [← Category.assoc,
    properPairResidueFiberDistinctPermutation_comp]
  congr 2
  group

noncomputable def
    properPairResidueFiberDistinctFixedPointConjugationEquiv
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [CommRing F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    {z : Spec (.of F) ⟶ ProperPairResidueFiberDistinct
          (ZMod q) d m g t hg //
      z ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg π = z} ≃
    {z : Spec (.of F) ⟶ ProperPairResidueFiberDistinct
          (ZMod q) d m g t hg //
      z ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg (ρ⁻¹ * π * ρ) = z} where
  toFun z := ⟨z.1 ≫ properPairResidueFiberDistinctPermutation
      (ZMod q) d m g t hg ρ, by
    rw [Category.assoc,
      properPairResidueFiberDistinctPermutation_twistedFrobenius_conj,
      ← Category.assoc, z.2]⟩
  invFun z := ⟨z.1 ≫ properPairResidueFiberDistinctPermutation
      (ZMod q) d m g t hg ρ⁻¹, by
    have hconj :=
      properPairResidueFiberDistinctPermutation_twistedFrobenius_conj
        q d m g t hg (ρ⁻¹ * π * ρ) ρ⁻¹
    have hperm : (ρ⁻¹)⁻¹ * (ρ⁻¹ * π * ρ) * ρ⁻¹ = π := by
      group
    rw [hperm] at hconj
    rw [Category.assoc, hconj, ← Category.assoc, z.2]⟩
  left_inv z := by
    apply Subtype.ext
    simp only [Category.assoc]
    rw [properPairResidueFiberDistinctPermutation_comp]
    simp [properPairResidueFiberDistinctPermutation_one]
  right_inv z := by
    apply Subtype.ext
    simp only [Category.assoc]
    rw [properPairResidueFiberDistinctPermutation_comp]
    simp [properPairResidueFiberDistinctPermutation_one]

/-- The fixed-point count of the repeated-pair scheme is a class function
of the two-block permutation. -/
theorem properPairResidueFiberDistinctFixedPoint_natCard_conj
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [CommRing F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π ρ : Fin 2 → Equiv.Perm (Fin d)) :
    Nat.card {z : Spec (.of F) ⟶ ProperPairResidueFiberDistinct
          (ZMod q) d m g t hg //
      z ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg (ρ * π * ρ⁻¹) = z} =
    Nat.card {z : Spec (.of F) ⟶ ProperPairResidueFiberDistinct
          (ZMod q) d m g t hg //
      z ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg π = z} := by
  exact Nat.card_congr
    (properPairResidueFiberDistinctFixedPointConjugationEquiv
      q d m F g t hg π ρ⁻¹).symm

/-- Exact progression specialization of the two-block fixed-point formula.
The degree parameter is the genuine modulus degree `k²`, and the residue
point is the canonical remainder of the chosen unit representative. -/
theorem
    sum_two_permutationVirtualMangoldt_mul_properPairFixedPointCount_eq_fiber
    (q k r : ℕ) [Fact q.Prime] (hk : 1 ≤ k) (hr : 1 ≤ r)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (u : (ProgressionQuotient q k)ˣ) :
    (∑ π₀ : Equiv.Perm (Fin (2 * r)),
      ∑ π₁ : Equiv.Perm (Fin (2 * r)),
        permutationVirtualMangoldt ℚ (Fin (2 * r)) π₀ *
          permutationVirtualMangoldt ℚ (Fin (2 * r)) π₁ *
          (Nat.card {z : (Spec (.of F) ⟶
              ProperPairResidueFiberDistinct (ZMod q) (2 * r) (k ^ 2)
                (modulusProduct q k)
                (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
                (modulusProduct_monic q k)) //
            z ≫ properPairResidueFiberDistinctTwistedFrobenius
              q (2 * r) (k ^ 2) (modulusProduct q k)
              (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
              (modulusProduct_monic q k) ![π₀, π₁] = z} : ℚ)) =
      ((2 * r).factorial : ℚ) ^ 2 *
        ((2 * r) ^ 2 * Nat.card {x : ProperPrimePair q r //
          properPrimePairProgressionUnit q k r x = u} : ℕ) := by
  rw [sum_two_permutationVirtualMangoldt_mul_properPairFixedPointCount_eq_pair
    q (2 * r) (k ^ 2) (by omega) F
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_natDegree q k)
    (by
      simpa only [normalizedResidue] using
        normalizedResidue_natDegree_lt q k hk
          (progressionUnitRepresentative q k u))
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)]
  rw [congruentIrreducibleProperPair_natCard_eq_fiber q k r u]

/-- Grothendieck--Lefschetz turns the canonical compact-support trace for the
actual progression fiber into the exact repeated-prime-pair mass.  This is
the cohomological counterpart of
`sum_two_permutationVirtualMangoldt_mul_properPairFixedPointCount_eq_fiber`. -/
theorem
    sum_two_permutationVirtualMangoldt_mul_properPairAlternatingTrace_eq_fiber
    (q k r ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (u : (ProgressionQuotient q k)ˣ)
    [hfinite : ∀ degree : ℕ, FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q (2 * r) (k ^ 2) ℓ degree (modulusProduct q k)
        (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
        (modulusProduct_monic q k))]
    (hGL : ∀ π₀ π₁ : Equiv.Perm (Fin (2 * r)),
      HasProperPairDistinctCanonicalTwistedGrothendieckLefschetz
        q (2 * r) (k ^ 2) ℓ topDegree F (modulusProduct q k)
        (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
        (modulusProduct_monic q k) ![π₀, π₁]) :
    (∑ π₀ : Equiv.Perm (Fin (2 * r)),
      ∑ π₁ : Equiv.Perm (Fin (2 * r)),
        (permutationVirtualMangoldt ℚ (Fin (2 * r)) π₀ : ℚ_[ℓ]) *
          (permutationVirtualMangoldt ℚ (Fin (2 * r)) π₁ : ℚ_[ℓ]) *
          properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace
            q (2 * r) (k ^ 2) ℓ topDegree (modulusProduct q k)
            (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
            (modulusProduct_monic q k) ![π₀, π₁]) =
      ((2 * r).factorial : ℚ_[ℓ]) ^ 2 *
        (((2 * r) ^ 2 * Nat.card {x : ProperPrimePair q r //
          properPrimePairProgressionUnit q k r x = u} : ℕ) : ℚ_[ℓ]) := by
  rw [sum_two_permutationVirtualMangoldt_mul_properPairAlternatingTrace_eq_pair
    q (2 * r) (k ^ 2) ℓ topDegree (by omega) F
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k)
    (modulusProduct_natDegree q k)
    (by
      simpa only [normalizedResidue] using
        normalizedResidue_natDegree_lt q k hk
          (progressionUnitRepresentative q k u))
    (modulusProduct_isCoprime_normalizedUnitRepresentative q k u)
    hGL]
  rw [congruentIrreducibleProperPair_natCard_eq_fiber q k r u]

/-- Frobenius on the canonical projective closure of the proper-pair
fiber, obtained from the globally glued scheme Frobenius. -/
noncomputable def properPairResidueFiberDistinctProjectiveClosureFrobenius
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    ProperPairResidueFiberDistinctProjectiveClosure q d m g t hg ⟶
      ProperPairResidueFiberDistinctProjectiveClosure q d m g t hg :=
  schemeFrobeniusOver
    (ProperPairResidueFiberDistinctProjectiveClosure q d m g t hg) q
    (properPairResidueFiberDistinctProjectiveClosureProjection
      q d m g t hg)

@[reassoc]
theorem properPairResidueFiberDistinctProjectiveClosureOpen_frobenius
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    properPairResidueFiberDistinctFrobenius q d m g t hg ≫
        properPairResidueFiberDistinctProjectiveClosureOpen q d m g t hg =
      properPairResidueFiberDistinctProjectiveClosureOpen q d m g t hg ≫
        properPairResidueFiberDistinctProjectiveClosureFrobenius
          q d m g t hg := by
  unfold properPairResidueFiberDistinctFrobenius
    properPairResidueFiberDistinctProjectiveClosureFrobenius
  rw [← schemeFrobeniusOver_eq_affine]
  exact schemeFrobeniusOver_naturality
    (properPairResidueFiberDistinctProjectiveClosureOpen q d m g t hg) q
    (properPairResidueFiberDistinctProjection q d m g t hg)
    (properPairResidueFiberDistinctProjectiveClosureProjection
      q d m g t hg)

/-- Frobenius commutes with the complete two-block action on the canonical
projective closure. -/
theorem
    properPairResidueFiberDistinctProjectiveClosureFrobenius_permutation
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctProjectiveClosureFrobenius q d m g t hg ≫
        properPairResidueFiberDistinctProjectiveClosurePermutation
          q d m g t hg π =
      properPairResidueFiberDistinctProjectiveClosurePermutation
          q d m g t hg π ≫
        properPairResidueFiberDistinctProjectiveClosureFrobenius
          q d m g t hg := by
  exact schemeFrobeniusOver_naturality
    (properPairResidueFiberDistinctProjectiveClosurePermutation
      q d m g t hg π) q
    (properPairResidueFiberDistinctProjectiveClosureProjection
      q d m g t hg)
    (properPairResidueFiberDistinctProjectiveClosureProjection
      q d m g t hg)

/-- Frobenius on the canonical projective closure of the full distinct
residue-unit fiber. -/
noncomputable def fullResidueUnitFiberDistinctProjectiveClosureFrobenius
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    FullResidueUnitFiberDistinctProjectiveClosure
        q n m g hg hdeg hm hmn t ⟶
      FullResidueUnitFiberDistinctProjectiveClosure
        q n m g hg hdeg hm hmn t :=
  schemeFrobeniusOver
    (FullResidueUnitFiberDistinctProjectiveClosure
      q n m g hg hdeg hm hmn t) q
    (fullResidueUnitFiberDistinctProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)

@[reassoc]
theorem fullResidueUnitFiberDistinctProjectiveClosureOpen_frobenius
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberDistinctFrobenius
          q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberDistinctProjectiveClosureOpen
          q n m g hg hdeg hm hmn t =
      fullResidueUnitFiberDistinctProjectiveClosureOpen
          q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberDistinctProjectiveClosureFrobenius
          q n m g hg hdeg hm hmn t := by
  unfold fullResidueUnitFiberDistinctFrobenius
    fullResidueUnitFiberDistinctProjectiveClosureFrobenius
  rw [← schemeFrobeniusOver_eq_affine]
  exact schemeFrobeniusOver_naturality
    (fullResidueUnitFiberDistinctProjectiveClosureOpen
      q n m g hg hdeg hm hmn t) q
    (fullResidueUnitFiberDistinctProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)

/-- Frobenius commutes with every coordinate permutation on the full
projective closure. -/
theorem
    fullResidueUnitFiberDistinctProjectiveClosureFrobenius_permutation
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g)
    (π : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctProjectiveClosureFrobenius
          q n m g hg hdeg hm hmn t ≫
        fullResidueUnitFiberDistinctProjectiveClosurePermutation
          q n m g hg hdeg hm hmn t π =
      fullResidueUnitFiberDistinctProjectiveClosurePermutation
          q n m g hg hdeg hm hmn t π ≫
        fullResidueUnitFiberDistinctProjectiveClosureFrobenius
          q n m g hg hdeg hm hmn t := by
  exact schemeFrobeniusOver_naturality
    (fullResidueUnitFiberDistinctProjectiveClosurePermutation
      q n m g hg hdeg hm hmn t π) q
    (fullResidueUnitFiberDistinctProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)
    (fullResidueUnitFiberDistinctProjectiveClosureProjection
      q n m g hg hdeg hm hmn t)

/-! The fixed-point types in the arithmetic identities are now compared
directly with the semilinear geometric fixed-point types attached to the
cohomological Galois action. -/

theorem schemeFrobeniusOver_fullResidueUnitFiberDistinct_eq
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    schemeFrobeniusOver
        (FullResidueUnitFiberDistinct
          (ZMod q) n m g hg hdeg hm hmn t) q
        (fullResidueUnitFiberDistinctProjection
          q n m g hg hdeg hm hmn t) =
      fullResidueUnitFiberDistinctFrobenius
        q n m g hg hdeg hm hmn t := by
  exact schemeFrobeniusOver_eq_affine _ q _

/-- Arithmetic twisted fixed points of the full distinct fiber are exactly
relative fixed geometric points for the Galois Frobenius action used on
compactly supported cohomology. -/
noncomputable def
    fullResidueUnitFiberDistinctGeometricTwistedFixedPointEquiv
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n)) :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          FullResidueUnitFiberDistinct
            (ZMod q) n m g hg hdeg hm hmn t //
      x ≫ fullResidueUnitFiberDistinctTwistedFrobenius
        q n m g hg hdeg hm hmn t π = x} ≃
    {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q
            (fullResidueUnitFiberDistinctProjection
              q n m g hg hdeg hm hmn t) //
        y ≫ pullback.snd
          (fullResidueUnitFiberDistinctProjection
            q n m g hg hdeg hm hmn t)
          (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
      Scheme.ProEt.geometricRelativePointSemilinearAction
        (FullResidueUnitFiberDistinct
          (ZMod q) n m g hg hdeg hm hmn t) q
        (fullResidueUnitFiberDistinctProjection
          q n m g hg hdeg hm hmn t)
        (fullResidueUnitFiberDistinctPermutation
          (ZMod q) n m g hg hdeg hm hmn t π)
        (schemeToSpecZMod_hom_ext q _ _)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y} := by
  let e₀ :
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            FullResidueUnitFiberDistinct
              (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberDistinctTwistedFrobenius
          q n m g hg hdeg hm hmn t π = x} ≃
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            FullResidueUnitFiberDistinct
              (ZMod q) n m g hg hdeg hm hmn t //
        x ≫ fullResidueUnitFiberDistinctPermutation
              (ZMod q) n m g hg hdeg hm hmn t π ≫
            schemeFrobeniusOver
              (FullResidueUnitFiberDistinct
                (ZMod q) n m g hg hdeg hm hmn t) q
              (fullResidueUnitFiberDistinctProjection
                q n m g hg hdeg hm hmn t) = x} :=
    { toFun := fun x => ⟨x.1, by
        simpa only [fullResidueUnitFiberDistinctTwistedFrobenius,
          schemeFrobeniusOver_fullResidueUnitFiberDistinct_eq] using x.2⟩
      invFun := fun x => ⟨x.1, by
        simpa only [fullResidueUnitFiberDistinctTwistedFrobenius,
          schemeFrobeniusOver_fullResidueUnitFiberDistinct_eq] using x.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  exact e₀.trans
    (geometricFrobeniusTwistedFixedPointEquiv
      (FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t) q
      (fullResidueUnitFiberDistinctProjection
        q n m g hg hdeg hm hmn t)
      (fullResidueUnitFiberDistinctPermutation
        (ZMod q) n m g hg hdeg hm hmn t π)
      (schemeToSpecZMod_hom_ext q _ _))

theorem schemeFrobeniusOver_properPairResidueFiberDistinct_eq
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic) :
    schemeFrobeniusOver
        (ProperPairResidueFiberDistinct (ZMod q) d m g t hg) q
        (properPairResidueFiberDistinctProjection q d m g t hg) =
      properPairResidueFiberDistinctFrobenius q d m g t hg := by
  exact schemeFrobeniusOver_eq_affine _ q _

/-- Arithmetic twisted fixed points of the proper repeated-pair fiber are
the corresponding semilinear geometric fixed points. -/
noncomputable def
    properPairResidueFiberDistinctGeometricTwistedFixedPointEquiv
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
      x ≫ properPairResidueFiberDistinctTwistedFrobenius
        q d m g t hg π = x} ≃
    {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          Scheme.ProEt.GeometricFiber q
            (properPairResidueFiberDistinctProjection q d m g t hg) //
        y ≫ pullback.snd
          (properPairResidueFiberDistinctProjection q d m g t hg)
          (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
      Scheme.ProEt.geometricRelativePointSemilinearAction
        (ProperPairResidueFiberDistinct (ZMod q) d m g t hg) q
        (properPairResidueFiberDistinctProjection q d m g t hg)
        (properPairResidueFiberDistinctPermutation
          (ZMod q) d m g t hg π)
        (schemeToSpecZMod_hom_ext q _ _)
        (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y} := by
  let e₀ :
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        x ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg π = x} ≃
      {x : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
            ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        x ≫ properPairResidueFiberDistinctPermutation
              (ZMod q) d m g t hg π ≫
            schemeFrobeniusOver
              (ProperPairResidueFiberDistinct (ZMod q) d m g t hg) q
              (properPairResidueFiberDistinctProjection
                q d m g t hg) = x} :=
    { toFun := fun x => ⟨x.1, by
        simpa only [properPairResidueFiberDistinctTwistedFrobenius,
          schemeFrobeniusOver_properPairResidueFiberDistinct_eq] using x.2⟩
      invFun := fun x => ⟨x.1, by
        simpa only [properPairResidueFiberDistinctTwistedFrobenius,
          schemeFrobeniusOver_properPairResidueFiberDistinct_eq] using x.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  exact e₀.trans
    (geometricFrobeniusTwistedFixedPointEquiv
      (ProperPairResidueFiberDistinct (ZMod q) d m g t hg) q
      (properPairResidueFiberDistinctProjection q d m g t hg)
      (properPairResidueFiberDistinctPermutation
        (ZMod q) d m g t hg π)
      (schemeToSpecZMod_hom_ext q _ _))

/-! The geometric fixed-point versions of the two Grothendieck--Lefschetz
identities.  The following equivalences show that these are exactly the
arithmetic identities used by the counting argument. -/

/-- Relative geometric points fixed by a coordinate permutation followed by
geometric Frobenius on the full distinct fiber. -/
abbrev FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n)) :=
  {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
        Scheme.ProEt.GeometricFiber q
          (fullResidueUnitFiberDistinctProjection
            q n m g hg hdeg hm hmn t) //
      y ≫ pullback.snd
        (fullResidueUnitFiberDistinctProjection
          q n m g hg hdeg hm hmn t)
        (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
    Scheme.ProEt.geometricRelativePointSemilinearAction
      (FullResidueUnitFiberDistinct
        (ZMod q) n m g hg hdeg hm hmn t) q
      (fullResidueUnitFiberDistinctProjection
        q n m g hg hdeg hm hmn t)
      (fullResidueUnitFiberDistinctPermutation
        (ZMod q) n m g hg hdeg hm hmn t π)
      (schemeToSpecZMod_hom_ext q _ _)
      (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y}

/-- Grothendieck--Lefschetz stated directly on the semilinear geometric
Frobenius fixed locus of the full distinct fiber. -/
def HasDistinctCanonicalTwistedGeometricGrothendieckLefschetz
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n))
    [∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ degree g hg hdeg hm hmn t)] : Prop :=
  fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
      q n m ℓ topDegree g hg hdeg hm hmn t π =
    (Nat.card (FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
      q n m g hg hdeg hm hmn t π) : ℚ_[ℓ])

theorem hasDistinctCanonicalTwistedGrothendieckLefschetz_iff_geometric
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n))
    [∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ degree g hg hdeg hm hmn t)] :
    HasDistinctCanonicalTwistedGrothendieckLefschetz
        q n m ℓ topDegree (AlgebraicClosure (ZMod q))
        g hg hdeg hm hmn t π ↔
      HasDistinctCanonicalTwistedGeometricGrothendieckLefschetz
        q n m ℓ topDegree g hg hdeg hm hmn t π := by
  unfold HasDistinctCanonicalTwistedGrothendieckLefschetz
    HasDistinctCanonicalTwistedGeometricGrothendieckLefschetz
  rw [Nat.card_congr
    (fullResidueUnitFiberDistinctGeometricTwistedFixedPointEquiv
      q n m g hg hdeg hm hmn t π)]

/-- Relative geometric points fixed by a two-block permutation followed by
geometric Frobenius on the proper repeated-pair fiber. -/
abbrev ProperPairResidueFiberDistinctGeometricTwistedFixedPoint
    (q d m : ℕ) [Fact q.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :=
  {y : {y : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
        Scheme.ProEt.GeometricFiber q
          (properPairResidueFiberDistinctProjection q d m g t hg) //
      y ≫ pullback.snd
        (properPairResidueFiberDistinctProjection q d m g t hg)
        (Scheme.ProEt.geometricPoint q) = 𝟙 _} //
    Scheme.ProEt.geometricRelativePointSemilinearAction
      (ProperPairResidueFiberDistinct (ZMod q) d m g t hg) q
      (properPairResidueFiberDistinctProjection q d m g t hg)
      (properPairResidueFiberDistinctPermutation
        (ZMod q) d m g t hg π)
      (schemeToSpecZMod_hom_ext q _ _)
      (geometricBaseFrobenius q) (geometricBaseFrobenius_over q) y = y}

/-- Grothendieck--Lefschetz on the semilinear geometric Frobenius fixed locus
of the proper repeated-pair fiber. -/
def HasProperPairDistinctCanonicalTwistedGeometricGrothendieckLefschetz
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    [∀ degree : ℕ, FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)] : Prop :=
  properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace
      q d m ℓ topDegree g t hg π =
    (Nat.card (ProperPairResidueFiberDistinctGeometricTwistedFixedPoint
      q d m g t hg π) : ℚ_[ℓ])

theorem
    hasProperPairDistinctCanonicalTwistedGrothendieckLefschetz_iff_geometric
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    [∀ degree : ℕ, FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)] :
    HasProperPairDistinctCanonicalTwistedGrothendieckLefschetz
        q d m ℓ topDegree (AlgebraicClosure (ZMod q)) g t hg π ↔
      HasProperPairDistinctCanonicalTwistedGeometricGrothendieckLefschetz
        q d m ℓ topDegree g t hg π := by
  unfold HasProperPairDistinctCanonicalTwistedGrothendieckLefschetz
    HasProperPairDistinctCanonicalTwistedGeometricGrothendieckLefschetz
  rw [Nat.card_congr
    (properPairResidueFiberDistinctGeometricTwistedFixedPointEquiv
      q d m g t hg π)]

/-! The alternating cohomological signs are absorbed into the two complex
matrices used by the analytic trace estimate. -/

/-- Apply the cohomological sign of one degree to a complex realization of
Frobenius. -/
noncomputable def cohomologicalSignMatrix {r : ℕ}
    (degree : ℕ) (A : Matrix (Fin r) (Fin r) ℂ) :
    Matrix (Fin r) (Fin r) ℂ :=
  if Even degree then A else -A

theorem cohomologicalSignMatrix_trace {r : ℕ}
    (degree : ℕ) (A : Matrix (Fin r) (Fin r) ℂ) :
    (cohomologicalSignMatrix degree A).trace =
      (-1 : ℂ) ^ degree * A.trace := by
  by_cases h : Even degree
  · rw [cohomologicalSignMatrix, if_pos h, h.neg_one_pow]
    simp
  · have hodd : Odd degree := Nat.not_even_iff_odd.mp h
    rw [cohomologicalSignMatrix, if_neg h, hodd.neg_one_pow,
      Matrix.trace_neg]
    ring

theorem cohomologicalSignMatrix_root_norm_le {r : ℕ}
    (degree : ℕ) (A : Matrix (Fin r) (Fin r) ℂ) (radius : ℝ)
    (hroot : ∀ z, z ∈ A.charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ (cohomologicalSignMatrix degree A).charpoly.roots →
      ‖z‖ ≤ radius := by
  by_cases h : Even degree
  · simp only [cohomologicalSignMatrix, h, if_true]
    exact hroot
  · simp only [cohomologicalSignMatrix, h, if_false]
    exact SawinSpecialization.matrix_neg_root_norm_le A radius hroot

/-- Two adjacent realized cohomology matrices, with their alternating signs,
give exactly the matrix certificate used in the Sawin trace estimate. -/
noncomputable def twoDegreeFrobeniusMatricesOfCohomologicalMatrices
    {error : ℂ} {lowerRank upperRank : ℕ} {radius : ℝ}
    (lowerDegree upperDegree : ℕ)
    (lower : Matrix (Fin lowerRank) (Fin lowerRank) ℂ)
    (upper : Matrix (Fin upperRank) (Fin upperRank) ℂ)
    (htrace : error =
      (-1 : ℂ) ^ lowerDegree * lower.trace +
        (-1 : ℂ) ^ upperDegree * upper.trace)
    (hlower : ∀ z, z ∈ lower.charpoly.roots → ‖z‖ ≤ radius)
    (hupper : ∀ z, z ∈ upper.charpoly.roots → ‖z‖ ≤ radius) :
    SawinSpecialization.TwoDegreeFrobeniusMatrices
      error lowerRank upperRank radius radius where
  lowerFrobenius := cohomologicalSignMatrix lowerDegree lower
  upperFrobenius := cohomologicalSignMatrix upperDegree upper
  error_eq_trace := by
    rw [cohomologicalSignMatrix_trace, cohomologicalSignMatrix_trace]
    exact htrace
  lower_root_norm_le :=
    cohomologicalSignMatrix_root_norm_le lowerDegree lower radius hlower
  upper_root_norm_le :=
    cohomologicalSignMatrix_root_norm_le upperDegree upper radius hupper

/-! Canonical two-degree geometric certificates.  These structures state the
four source theorems directly on the compact-support objects constructed in
this file, rather than on detached matrices. -/

/-- Finite-dimensionality, geometric Lefschetz, concentration, and Deligne
weights for one full distinct residue fiber. -/
structure FullDistinctCanonicalTwoDegreeGeometricData
    (q n m ℓ topDegree lowerDegree upperDegree : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n))
    (σ : ℚ_[ℓ] →+* ℂ) (radius : ℝ) where
  finite : ∀ degree : ℕ,
    FiniteDimensional ℚ_[ℓ]
      (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q n m ℓ degree g hg hdeg hm hmn t)
  lefschetz :
    letI := finite
    HasDistinctCanonicalTwistedGeometricGrothendieckLefschetz
      q n m ℓ topDegree g hg hdeg hm hmn t π
  lower_le : lowerDegree ≤ topDegree
  upper_le : upperDegree ≤ topDegree
  degrees_ne : lowerDegree ≠ upperDegree
  concentration :
    letI := finite
    ∀ degree ≤ topDegree, degree ≠ lowerDegree → degree ≠ upperDegree →
      fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
        q n m ℓ degree g hg hdeg hm hmn t π = 0
  lower_root_bound :
    letI := finite lowerDegree
    ∀ z, z ∈ (fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix
      q n m ℓ lowerDegree g hg hdeg hm hmn t π σ).charpoly.roots →
      ‖z‖ ≤ radius
  upper_root_bound :
    letI := finite upperDegree
    ∀ z, z ∈ (fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix
      q n m ℓ upperDegree g hg hdeg hm hmn t π σ).charpoly.roots →
      ‖z‖ ≤ radius

/-- The canonical full-fiber geometric data produce the exact signed
two-degree matrix certificate, with no change of trace or spectrum. -/
noncomputable def FullDistinctCanonicalTwoDegreeGeometricData.toMatrices
    {q n m ℓ topDegree lowerDegree upperDegree : ℕ}
    [Fact q.Prime] [Fact ℓ.Prime]
    {g : Polynomial (ZMod q)} {hg : g.Monic}
    {hdeg : g.natDegree = m} {hm : 0 < m} {hmn : m ≤ n}
    {t : ResidueUnitPoint (ZMod q) m g} {π : Equiv.Perm (Fin n)}
    {σ : ℚ_[ℓ] →+* ℂ} {radius : ℝ}
    (data : FullDistinctCanonicalTwoDegreeGeometricData
      q n m ℓ topDegree lowerDegree upperDegree
      g hg hdeg hm hmn t π σ radius) :
    letI := data.finite lowerDegree
    let lower := fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix
      q n m ℓ lowerDegree g hg hdeg hm hmn t π σ
    letI := data.finite upperDegree
    let upper := fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix
      q n m ℓ upperDegree g hg hdeg hm hmn t π σ
    SawinSpecialization.TwoDegreeFrobeniusMatrices
      (Nat.card (FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
        q n m g hg hdeg hm hmn t π) : ℂ)
      (Module.finrank ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ lowerDegree g hg hdeg hm hmn t))
      (Module.finrank ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ upperDegree g hg hdeg hm hmn t)) radius radius := by
  letI := data.finite
  let lower := fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix
    q n m ℓ lowerDegree g hg hdeg hm hmn t π σ
  let upper := fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix
    q n m ℓ upperDegree g hg hdeg hm hmn t π σ
  apply twoDegreeFrobeniusMatricesOfCohomologicalMatrices
    lowerDegree upperDegree lower upper
  · have halt :=
      fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace_eq_two_degrees
        q n m ℓ topDegree lowerDegree upperDegree g hg hdeg hm hmn t π
        data.lower_le data.upper_le data.degrees_ne data.concentration
    have hqell :
        (Nat.card (FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
          q n m g hg hdeg hm hmn t π) : ℚ_[ℓ]) =
          (-1 : ℚ_[ℓ]) ^ lowerDegree *
              fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
                q n m ℓ lowerDegree g hg hdeg hm hmn t π +
            (-1 : ℚ_[ℓ]) ^ upperDegree *
              fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
                q n m ℓ upperDegree g hg hdeg hm hmn t π := by
      rw [← halt]
      exact data.lefschetz.symm
    have hc := congrArg σ hqell
    simpa only [map_natCast, map_add, map_mul, map_pow, map_neg, map_one,
      fullResidueUnitFiberDistinctCanonicalTwistedRealizationMatrix_trace,
      lower, upper] using hc
  · exact data.lower_root_bound
  · exact data.upper_root_bound

/-- Complex realization of the canonical twisted Frobenius action on one
proper-pair compact-support cohomology group. -/
noncomputable def
    properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
    (q d m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    [FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)]
    (σ : ℚ_[ℓ] →+* ℂ) :
    Matrix
      (Fin (Module.finrank ℚ_[ℓ]
        (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ degree g t hg)))
      (Fin (Module.finrank ℚ_[ℓ]
        (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ℓ degree g t hg))) ℂ :=
  (LinearMap.toMatrix
    (Module.finBasis ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg))
    (Module.finBasis ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg))
    (properPairResidueFiberDistinctCanonicalTwistedCompactSupportLinearMap
      q d m ℓ degree g t hg π)).map σ

theorem
    properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix_trace
    (q d m ℓ degree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    [FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)]
    (σ : ℚ_[ℓ] →+* ℂ) :
    (properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
      q d m ℓ degree g t hg π σ).trace =
    σ (properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
      q d m ℓ degree g t hg π) := by
  unfold properPairResidueFiberDistinctCanonicalTwistedRealizationMatrix
    properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
  rw [LinearMap.trace_eq_matrix_trace ℚ_[ℓ]
    (Module.finBasis ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg))]
  exact (AddMonoidHom.map_trace σ _).symm

/-- Concentration of the proper-pair alternating trace in two degrees. -/
theorem
    properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace_eq_two_degrees
    (q d m ℓ topDegree lower upper : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    [hfinite : ∀ degree : ℕ, FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)]
    (hlower : lower ≤ topDegree) (hupper : upper ≤ topDegree)
    (hne : lower ≠ upper)
    (hzero : ∀ degree ≤ topDegree, degree ≠ lower → degree ≠ upper →
      properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
        q d m ℓ degree g t hg π = 0) :
    properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace
        q d m ℓ topDegree g t hg π =
      (-1 : ℚ_[ℓ]) ^ lower *
          properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
            q d m ℓ lower g t hg π +
        (-1 : ℚ_[ℓ]) ^ upper *
          properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
            q d m ℓ upper g t hg π := by
  unfold properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace
  exact alternating_sum_eq_two_degrees
    (fun degree =>
      properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
        q d m ℓ degree g t hg π)
    topDegree lower upper hlower hupper hne hzero

/-- Finite-dimensionality, geometric Lefschetz, concentration, and Deligne
weights for one proper repeated-pair residue fiber. -/
structure ProperPairDistinctCanonicalTwoDegreeGeometricData
    (q d m ℓ topDegree lowerDegree upperDegree : ℕ)
