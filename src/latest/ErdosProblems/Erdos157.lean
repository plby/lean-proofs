/-- Concrete source formulation of the remaining theorem: the raw family is
not an arbitrary trace model, but exactly the coordinate realization of the
canonical compact-support cohomology constructed above.  The `split` field of
`ThreeBlockSplitCohomologyData` is the constant/nonconstant isotypic
decomposition in Sawin's Theorem 7.2. -/
def HasCanonicalProgressionThreeBlockSplitCohomology
    (q : ℕ) [Fact q.Prime] : Prop :=
  ∀ k : ℕ, ∀ hk : 1000 ≤ k,
    let r := Construction.canonicalDegreeIndex k
    let d := 2 * r
    let m := k ^ 2
    let hkm := canonicalThreeBlockDegreeRange (by omega : 3 ≤ k)
    let radius := SawinSpecialization.sawinLemma914FrobeniusRadius q d m
    ∃ topDegree : ℕ,
      ∃ hfinite : ∀ u : (ProgressionQuotient q k)ˣ,
        ∀ degree : Fin (topDegree + 1),
          FiniteDimensional ℚ_[2]
            (ProgressionFullDistinctCanonicalCohomology
              q k r 2 degree (by omega) hkm u),
      ∃ data : ThreeBlockSplitCohomologyData.{0}
        ℚ_[2] ((ProgressionQuotient q k)ˣ) topDegree d
        (fun u => progressionFullDistinctThreeBlockPointTrace
          q k r 2 (by omega) hkm u)
        (padicToComplex 2) radius
        (SawinSpecialization.sawinLemma914AverageTraceRank d m),
        data.rawFamily = progressionCanonicalCoordinateFamily
          q k r 2 topDegree (by omega) hkm hfinite

