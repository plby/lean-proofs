noncomputable def
    fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n))
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ degree g hg hdeg hm hmn t)] : ℚ_[ℓ] :=
  ∑ degree : Fin (topDegree + 1),
    (-1 : ℚ_[ℓ]) ^ (degree : ℕ) *
      letI := hfinite degree
      fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
        q n m ℓ degree g hg hdeg hm hmn t π

theorem
    fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace_eq_two_degrees
    (q n m ℓ topDegree lower upper : ℕ)
    [Fact q.Prime] [Fact ℓ.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n))
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ degree g hg hdeg hm hmn t)]
    (hlower : lower ≤ topDegree) (hupper : upper ≤ topDegree)
    (hne : lower ≠ upper)
    (hzero : ∀ degree ≤ topDegree, degree ≠ lower → degree ≠ upper →
      fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
        q n m ℓ degree g hg hdeg hm hmn t π = 0) :
    fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
        q n m ℓ topDegree g hg hdeg hm hmn t π =
      (-1 : ℚ_[ℓ]) ^ lower *
          fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
            q n m ℓ lower g hg hdeg hm hmn t π +
        (-1 : ℚ_[ℓ]) ^ upper *
          fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
            q n m ℓ upper g hg hdeg hm hmn t π := by
  unfold fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
  exact alternating_sum_eq_two_degrees
    (fun degree =>
      fullResidueUnitFiberDistinctCanonicalTwistedCompactSupportTrace
        q n m ℓ degree g hg hdeg hm hmn t π)
    topDegree lower upper hlower hupper hne hzero

def HasDistinctCanonicalTwistedGrothendieckLefschetz
    (q n m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (π : Equiv.Perm (Fin n))
    [∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q n m ℓ degree g hg hdeg hm hmn t)] : Prop :=
  fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
      q n m ℓ topDegree g hg hdeg hm hmn t π =
    (Nat.card {z : Spec (.of F) ⟶ FullResidueUnitFiberDistinct
          (ZMod q) n m g hg hdeg hm hmn t //
      z ≫ fullResidueUnitFiberDistinctTwistedFrobenius
        q n m g hg hdeg hm hmn t π = z} : ℚ_[ℓ])

theorem threeBlockDistinctCanonicalTwistedAlternatingTrace_eq_triple_card
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hd : 0 < d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [hfinite : ∀ degree : ℕ,
      FiniteDimensional ℚ_[ℓ]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q (3 * d) m ℓ degree g hg hdeg hm hmn t)]
    (hGL : HasDistinctCanonicalTwistedGrothendieckLefschetz
      q (3 * d) m ℓ topDegree F g hg hdeg hm hmn t
        (threeBlockCyclePermutation d)) :
    fullResidueUnitFiberDistinctCanonicalTwistedAlternatingTrace
        q (3 * d) m ℓ topDegree g hg hdeg hm hmn t
          (threeBlockCyclePermutation d) =
      ((d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
        (residueUnitPointPolynomial q m g t)) : ℕ) : ℚ_[ℓ]) := by
  rw [hGL, threeBlockDistinctFixedPoint_card_eq_triple_card
    q d m hd F g hg hdeg hm hmn t]


/-! Composition laws for the symmetric-group action. -/

theorem rootPermutation_comp
    (K : Type u) [Field K] (n : ℕ) (g : Polynomial K)
    (σ τ : Equiv.Perm (Fin n)) :
    rootPermutation K n g σ ≫ rootPermutation K n g τ =
      rootPermutation K n g (σ * τ) := by
  apply (cancel_mono (RootSpaceOpen K n g).ι).1
  rw [Category.assoc, rootPermutation_ι,
    ← Category.assoc, rootPermutation_ι,
    Category.assoc, affineRootPermutation_comp,
    rootPermutation_ι]

theorem fullResidueUnitFiberPermutation_comp
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ τ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t σ ≫
        fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t τ =
      fullResidueUnitFiberPermutation K n m g hg hdeg hm hmn t (σ * τ) := by
  apply pullback.hom_ext
  · change (fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t τ) ≫
      fullResidueUnitFiberToRootSpace
        K n m g hg hdeg hm hmn t =
      fullResidueUnitFiberPermutation
          K n m g hg hdeg hm hmn t (σ * τ) ≫
        fullResidueUnitFiberToRootSpace
          K n m g hg hdeg hm hmn t
    rw [Category.assoc,
      fullResidueUnitFiberPermutation_toRootSpace,
      ← Category.assoc,
      fullResidueUnitFiberPermutation_toRootSpace,
      Category.assoc, rootPermutation_comp,
      fullResidueUnitFiberPermutation_toRootSpace]
  · change (fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberPermutation
        K n m g hg hdeg hm hmn t τ) ≫
      fullResidueUnitFiberProjection
        K n m g hg hdeg hm hmn t =
      fullResidueUnitFiberPermutation
          K n m g hg hdeg hm hmn t (σ * τ) ≫
        fullResidueUnitFiberProjection
          K n m g hg hdeg hm hmn t
    rw [Category.assoc,
      fullResidueUnitFiberPermutation_over,
      fullResidueUnitFiberPermutation_over,
      fullResidueUnitFiberPermutation_over]

theorem fullResidueUnitFiberDistinctPermutation_comp
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) (σ τ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t τ =
    fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t (σ * τ) := by
  apply (cancel_mono
    (fullResidueUnitFiberDistinctι K n m g hg hdeg hm hmn t)).1
  rw [Category.assoc, fullResidueUnitFiberDistinctPermutation_ι,
    ← Category.assoc, fullResidueUnitFiberDistinctPermutation_ι,
    Category.assoc, fullResidueUnitFiberPermutation_comp,
    fullResidueUnitFiberDistinctPermutation_ι]

theorem homogeneousCoordinatePermutationGraded_comp
    (K : Type u) [Field K] (n : ℕ) (σ τ : Equiv.Perm (Fin n)) :
    (homogeneousCoordinatePermutationGraded K n σ).comp
        (homogeneousCoordinatePermutationGraded K n τ) =
      homogeneousCoordinatePermutationGraded K n (σ * τ) := by
  apply GradedRingHom.ext
  intro p
  change MvPolynomial.rename
      (Equiv.optionCongr (rootIndexPermutation n σ))
        (MvPolynomial.rename
          (Equiv.optionCongr (rootIndexPermutation n τ)) p) =
    MvPolynomial.rename
      (Equiv.optionCongr (rootIndexPermutation n (σ * τ))) p
  rw [MvPolynomial.rename_rename]
  have hfun :
      (⇑(Equiv.optionCongr (rootIndexPermutation n σ)) ∘
          ⇑(Equiv.optionCongr (rootIndexPermutation n τ))) =
        ⇑(Equiv.optionCongr (rootIndexPermutation n (σ * τ))) := by
    funext i
    cases i with
    | none => rfl
    | some i =>
        change some (ULift.up (σ (τ i.down))) =
          some (ULift.up ((σ * τ) i.down))
        congr 1
  exact congrArg (fun f => MvPolynomial.rename f p) hfun

theorem projectiveRootPermutation_comp
    (K : Type u) [Field K] (n : ℕ) (σ τ : Equiv.Perm (Fin n)) :
    projectiveRootPermutation K n σ ≫
        projectiveRootPermutation K n τ =
      projectiveRootPermutation K n (σ * τ) := by
  unfold projectiveRootPermutation
  rw [← Proj.map_comp]
  exact projMap_congr K n
    (homogeneousCoordinatePermutationGraded_comp K n σ τ) _ _

theorem fullResidueUnitFiberDistinctProjectiveClosurePermutation_comp
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) (σ τ : Equiv.Perm (Fin n)) :
    fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t σ ≫
      fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t τ =
    fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t (σ * τ) := by
  apply (cancel_mono
    (fullResidueUnitFiberDistinctToProjectiveRootSpace
      q n m g hg hdeg hm hmn t).imageι).1
  rw [Category.assoc,
    fullResidueUnitFiberDistinctProjectiveClosurePermutation_imageι,
    ← Category.assoc,
    fullResidueUnitFiberDistinctProjectiveClosurePermutation_imageι,
    Category.assoc, projectiveRootPermutation_comp,
    fullResidueUnitFiberDistinctProjectiveClosurePermutation_imageι]

theorem fullResidueUnitFiberDistinctPermutation_one
    (K : Type u) [Field K]
    (n m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint K m g) :
    fullResidueUnitFiberDistinctPermutation
        K n m g hg hdeg hm hmn t 1 = 𝟙 _ := by
  let f := fullResidueUnitFiberDistinctPermutation
    K n m g hg hdeg hm hmn t 1
  apply (cancel_epi f).1
  change f ≫ f = f ≫ 𝟙 _
  rw [Category.comp_id]
  exact fullResidueUnitFiberDistinctPermutation_comp
    K n m g hg hdeg hm hmn t 1 1

theorem fullResidueUnitFiberDistinctProjectiveClosurePermutation_one
    (q n m : ℕ) [Fact q.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ n)
    (t : ResidueUnitPoint (ZMod q) m g) :
    fullResidueUnitFiberDistinctProjectiveClosurePermutation
        q n m g hg hdeg hm hmn t 1 = 𝟙 _ := by
  let f := fullResidueUnitFiberDistinctProjectiveClosurePermutation
    q n m g hg hdeg hm hmn t 1
  apply (cancel_epi f).1
  change f ≫ f = f ≫ 𝟙 _
  rw [Category.comp_id]
  exact fullResidueUnitFiberDistinctProjectiveClosurePermutation_comp
