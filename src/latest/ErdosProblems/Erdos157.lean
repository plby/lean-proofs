    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d))
    [∀ degree : ℕ, FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)]
    (hGL : HasProperPairDistinctCanonicalTwistedGrothendieckLefschetz
      q d m ℓ topDegree F g t hg π) :
    properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace
        q d m ℓ topDegree g t hg π =
      (Nat.card {z : Spec (.of F) ⟶
          ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        z ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg π = z} : ℚ_[ℓ]) :=
  hGL

/-- After Grothendieck--Lefschetz, the two-block character average of the
actual compact-support alternating traces is exactly the arithmetic
repeated-pair mass, including both root-ordering factorials. -/
theorem
    sum_two_permutationVirtualMangoldt_mul_properPairAlternatingTrace_eq_pair
    (q d m ℓ topDegree : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hd : 2 ≤ d)
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    [Algebra (ZMod q) F] [Algebra.IsAlgebraic (ZMod q) F]
    [IsAlgClosed F]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (hgt : IsCoprime g t)
    [hfinite : ∀ degree : ℕ, FiniteDimensional ℚ_[ℓ]
      (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
        q d m ℓ degree g t hg)]
    (hGL : ∀ π₀ π₁ : Equiv.Perm (Fin d),
      HasProperPairDistinctCanonicalTwistedGrothendieckLefschetz
        q d m ℓ topDegree F g t hg ![π₀, π₁]) :
    (∑ π₀ : Equiv.Perm (Fin d),
      ∑ π₁ : Equiv.Perm (Fin d),
        (permutationVirtualMangoldt ℚ (Fin d) π₀ : ℚ_[ℓ]) *
          (permutationVirtualMangoldt ℚ (Fin d) π₁ : ℚ_[ℓ]) *
          properPairResidueFiberDistinctCanonicalTwistedAlternatingTrace
            q d m ℓ topDegree g t hg ![π₀, π₁]) =
      (d.factorial : ℚ_[ℓ]) ^ 2 *
        ((d ^ 2 * Nat.card
          (CongruentIrreducibleProperPair q d g t) : ℕ) : ℚ_[ℓ]) := by
  unfold HasProperPairDistinctCanonicalTwistedGrothendieckLefschetz at hGL
  simp_rw [hGL]
  exact_mod_cast
    sum_two_permutationVirtualMangoldt_mul_properPairFixedPointCount_eq_pair
      q d m hd F g t hg hdeg ht hgt

theorem finiteProperPairTwistedTupleData
    (q d : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q))
    (π₀ π₁ : Equiv.Perm (Fin d)) :
    Finite (ProperPairTwistedTupleData q d F g t π₀ π₁) := by
  let : Finite
      {x : Fin (2 * d) → F //
        twistedTupleFrobenius q (2 * d) F
          (twoBlockPermutationPair d π₀ π₁) x = x} :=
    finiteTwistedTupleFixedData q (2 * d) F
      (twoBlockPermutationPair d π₀ π₁)
  exact Finite.of_injective
    (fun x : ProperPairTwistedTupleData q d F g t π₀ π₁ ↦
      (⟨x.coords, x.twisted_fixed⟩ :
        {y : Fin (2 * d) → F //
          twistedTupleFrobenius q (2 * d) F
            (twoBlockPermutationPair d π₀ π₁) y = y}))
    (by
      intro x y hxy
      apply ProperPairTwistedTupleData.ext
      exact congrArg Subtype.val hxy)

theorem finiteProperPairResidueFiberDistinctTwistedFixedPointData
    (q d m : ℕ) [Fact q.Prime]
    (F : Type) [Field F] [CharP F q] [PerfectRing F q]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
