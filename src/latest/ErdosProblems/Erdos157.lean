/-- The centered unit-group form is exactly strong enough for the published
progression-average estimate; all changes of coordinates are equalities. -/
theorem hasSawinTheorem17Average_of_distinctUnitAverage
    (hdistinct : HasSawinLemma914DistinctUnitAverageBound q) :
    HasSawinTheorem17AverageFactorizationDeviation q := by
  intro k hk a ha
  dsimp only
  let r := Construction.canonicalDegreeIndex k
  let d := 2 * r
  let u : (ProgressionQuotient q k)ˣ := progressionUnit q k a ha
  have hkm : k ^ 2 ≤ 6 * r := by
    have hrange := Construction.modulus_degree_in_sawin_range
      (by omega : 3 ≤ k)
    dsimp only [r]
    omega
  have hsum :
      (∑ v : (ProgressionQuotient q k)ˣ,
          unitDistinctOrderedPrimeTripleWeight q k r v) =
        ∑ v : (ProgressionQuotient q k)ˣ,
          (unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r v : ℂ) := by
    apply Finset.sum_congr rfl
    intro v _hv
    exact unitDistinctOrderedPrimeTripleWeight_eq_unitProgression
      q k r v (by omega) hkm
  have hbound := hdistinct k hk u
  rw [unitDistinctOrderedPrimeTripleWeight_eq_unitProgression
      q k r u (by omega) hkm, hsum] at hbound
  dsimp only [u] at hbound
  rw [unitProgressionEqualDegreeDistinctThreePrimeWeightSum_progressionUnit
      q k r a ha,
    average_unitProgressionEqualDegreeDistinctThreePrimeWeightSum q k r]
    at hbound
  calc
    |(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℝ) -
        (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℝ) /
          (progressionTotient q k : ℝ)| =
      ‖(progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℂ) -
        (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
          (progressionTotient q k : ℂ)‖ := by
      have heq :
          (progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℂ) -
              (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℂ) /
                (progressionTotient q k : ℂ) =
            (((progressionEqualDegreeDistinctThreePrimeWeightSum q k r a : ℝ) -
              (coprimeEqualDegreeDistinctThreePrimeWeightSum q k r : ℝ) /
                (progressionTotient q k : ℝ) : ℝ) : ℂ) := by
        simp only [Complex.ofReal_sub, Complex.ofReal_div,
          Complex.ofReal_natCast]
      rw [heq]
      exact (Complex.norm_real _).symm
    _ ≤ ((6 * d ^ 3 *
          sawinLemma914EqualDegreeError q d (k ^ 2) : ℕ) : ℝ) := hbound
    _ = ((6 * (2 * Construction.canonicalDegreeIndex k) ^ 3) *
        sawinLemma914EqualDegreeError q
          (2 * Construction.canonicalDegreeIndex k) (k ^ 2) : ℕ) := by
      rfl

