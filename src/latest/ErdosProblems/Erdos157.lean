          (-1 : ℚ_[ℓ]) ^ lowerDegree *
              properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
                q d m ℓ lowerDegree g t hg π +
            (-1 : ℚ_[ℓ]) ^ upperDegree *
              properPairResidueFiberDistinctCanonicalTwistedCompactSupportTrace
                q d m ℓ upperDegree g t hg π := by
      rw [← halt]
      exact data.lefschetz.symm
