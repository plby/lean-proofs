theorem affineRootPermutation_universalProperPairPolynomial
    (K : Type*) [Field K] (d : ℕ)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    (universalProperPairPolynomial K d).map
        (affineRootPermutation K (2 * d)
          (twoBlockPermutationFamily d π)).appTop.hom =
      universalProperPairPolynomial K d := by
