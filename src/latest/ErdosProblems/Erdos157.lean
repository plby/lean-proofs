    affineRootPermutation_universalTwoBlockPolynomial,
    affineRootPermutation_universalTwoBlockPolynomial]

theorem affineRootPermutation_universalProperPairRemainder
    (K : Type*) [Field K] (d : ℕ)
    (g : Polynomial K) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    (universalProperPairRemainder K d g hg).map
        (affineRootPermutation K (2 * d)
          (twoBlockPermutationFamily d π)).appTop.hom =
      universalProperPairRemainder K d g hg := by
  let φ := (affineRootPermutation K (2 * d)
    (twoBlockPermutationFamily d π)).appTop.hom
  let G := g.map (rootCoefficientMap K (2 * d))
  have hG : G.map φ = G := by
    dsimp only [G]
    rw [Polynomial.map_map]
    congr 1
    ext a
    unfold rootCoefficientMap
    change (affineRootPermutation K (2 * d)
      (twoBlockPermutationFamily d π)).appTop
        ((AffineRootSpace K (2 * d) ↘ Spec (.of K)).appTop
          ((Scheme.ΓSpecIso (.of K)).inv a)) = _
    change (((AffineRootSpace K (2 * d) ↘ Spec (.of K)).appTop ≫
      (affineRootPermutation K (2 * d)
        (twoBlockPermutationFamily d π)).appTop)
          ((Scheme.ΓSpecIso (.of K)).inv a)) = _
    have h := congrArg Scheme.Hom.appTop
      (affineRootPermutation_over K (2 * d)
        (twoBlockPermutationFamily d π))
    rw [Scheme.Hom.comp_appTop] at h
    rw [h]
    rfl
  unfold universalProperPairRemainder
  change (universalProperPairPolynomial K d %ₘ G).map φ =
    universalProperPairPolynomial K d %ₘ G
  rw [Polynomial.map_modByMonic φ (hg.map _), hG,
    affineRootPermutation_universalProperPairPolynomial]

theorem affineRootPermutation_affineProperPairResidueMultiplication
    (K : Type*) [Field K] (d m : ℕ)
    (g : Polynomial K) (hg : g.Monic)
    (π : Fin 2 → Equiv.Perm (Fin d)) :
    affineRootPermutation K (2 * d) (twoBlockPermutationFamily d π) ≫
        affineProperPairResidueMultiplication K d m g hg =
