/-! Exterior-power characters for the block permutation groups.  These
identities connect the literal virtual von-Mangoldt weights to the
representation-theoretic projector used in the Frobenius estimate. -/

open Set Set.powersetCard

noncomputable def blockExteriorRepresentation
    (K : Type*) [Field K] (blocks d : ℕ) (b : Fin blocks)
    (degree : ℕ) :
    Representation K (Fin blocks → Equiv.Perm (Fin d))
      (⋀[K]^degree (MonoidAlgebra K (Fin d))) :=
  (Representation.exteriorPower
    (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d)) degree).comp
      (Pi.evalMonoidHom (fun _ : Fin blocks => Equiv.Perm (Fin d)) b)

@[simp]
theorem blockExteriorRepresentation_character
    (K : Type*) [Field K] (blocks d : ℕ) (b : Fin blocks)
    (degree : ℕ) (pi : Fin blocks → Equiv.Perm (Fin d)) :
    (blockExteriorRepresentation K blocks d b degree).character pi =
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d))
        degree).character (pi b) := by
  rfl

noncomputable def threeBlockExteriorCharacter
    (K : Type*) [Field K] (d a b c : ℕ)
    (pi : Fin 3 → Equiv.Perm (Fin d)) : K :=
  (blockExteriorRepresentation K 3 d 0 a).character pi *
    (blockExteriorRepresentation K 3 d 1 b).character pi *
      (blockExteriorRepresentation K 3 d 2 c).character pi

theorem threeBlockExteriorCharacter_eq
    (K : Type*) [Field K] (d a b c : ℕ)
    (pi : Fin 3 → Equiv.Perm (Fin d)) :
    threeBlockExteriorCharacter K d a b c pi =
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d)) a).character
          (pi 0) *
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d)) b).character
          (pi 1) *
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d)) c).character
          (pi 2) := by
  unfold threeBlockExteriorCharacter
  rfl

theorem three_permutationVirtualMangoldt_eq_sum_exteriorCharacters
    (K : Type*) [Field K] (d : ℕ)
    (pi : Fin 3 → Equiv.Perm (Fin d)) :
    permutationVirtualMangoldt K (Fin d) (pi 0) *
        permutationVirtualMangoldt K (Fin d) (pi 1) *
        permutationVirtualMangoldt K (Fin d) (pi 2) =
      ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          ∑ c : Fin (Fintype.card (Fin d) + 1),
        (((-1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
          ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ)) *
          ((-1 : K) ^ ((c : ℕ) + 1) * (c : ℕ))) *
            threeBlockExteriorCharacter K d a b c pi := by
  unfold permutationVirtualMangoldt
  rw [mul_assoc, Fintype.sum_mul_sum, Fintype.sum_mul_sum]
  simp_rw [Finset.mul_sum]
  simp only [threeBlockExteriorCharacter,
    blockExteriorRepresentation_character]
  congr 1
  funext a
  congr 1
  funext b
  congr 1
  funext c
  ring

noncomputable def twoBlockExteriorCharacter
    (K : Type*) [Field K] (d a b : ℕ)
    (pi : Fin 2 → Equiv.Perm (Fin d)) : K :=
  (blockExteriorRepresentation K 2 d 0 a).character pi *
    (blockExteriorRepresentation K 2 d 1 b).character pi

theorem twoBlockExteriorCharacter_eq
    (K : Type*) [Field K] (d a b : ℕ)
    (pi : Fin 2 → Equiv.Perm (Fin d)) :
    twoBlockExteriorCharacter K d a b pi =
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d)) a).character
          (pi 0) *
      (Representation.exteriorPower
        (Representation.ofMulAction K (Equiv.Perm (Fin d)) (Fin d)) b).character
          (pi 1) := by
  rfl

theorem two_permutationVirtualMangoldt_eq_sum_exteriorCharacters
    (K : Type*) [Field K] (d : ℕ)
    (pi : Fin 2 → Equiv.Perm (Fin d)) :
    permutationVirtualMangoldt K (Fin d) (pi 0) *
        permutationVirtualMangoldt K (Fin d) (pi 1) =
      ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          (((-1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
            ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ))) *
              twoBlockExteriorCharacter K d a b pi := by
  unfold permutationVirtualMangoldt
  rw [Fintype.sum_mul_sum]
  simp only [twoBlockExteriorCharacter,
    blockExteriorRepresentation_character]
  congr 1
  funext a
  congr 1
  funext b
  ring

/-! Tensor-product character representations are transported to explicit
finitely supported free modules.  This avoids the non-definitional diamond
between the additive-monoid structures inherited from `TensorProduct` and
from its additive group. -/

/-- Trace invariance under a basis transport, stated with only additive
monoids so it is insensitive to inherited tensor-product instances. -/
theorem trace_conj_of_finite_basis
    {R M N I : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M]
    [AddCommMonoid N] [Module R N]
    [Fintype I] [DecidableEq I]
    (b : Module.Basis I R M) (f : M →ₗ[R] M) (e : M ≃ₗ[R] N) :
    LinearMap.trace R N (e.conj f) = LinearMap.trace R M f := by
  rw [LinearMap.trace_eq_matrix_trace R (b.map e),
    LinearMap.trace_eq_matrix_trace R b]
  congr 1
  ext i j
  simp [LinearMap.toMatrix]

open scoped Kronecker in
/-- Tensor-product trace multiplicativity with explicit bases and only
additive-monoid hypotheses, avoiding inherited-instance diamonds. -/
theorem trace_tensorProduct_of_finite_basis
    {R M N I J : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M]
    [AddCommMonoid N] [Module R N]
    [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
    (bM : Module.Basis I R M) (bN : Module.Basis J R N)
    (f : M →ₗ[R] M) (g : N →ₗ[R] N) :
    LinearMap.trace R (TensorProduct R M N) (TensorProduct.map f g) =
      LinearMap.trace R M f * LinearMap.trace R N g := by
  rw [LinearMap.trace_eq_matrix_trace R (bM.tensorProduct bN),
    LinearMap.trace_eq_matrix_trace R bM,
    LinearMap.trace_eq_matrix_trace R bN]
  rw [show LinearMap.toMatrix (bM.tensorProduct bN) (bM.tensorProduct bN)
      (TensorProduct.map f g) =
        LinearMap.toMatrix bM bM f ⊗ₖ LinearMap.toMatrix bN bN g by
    ext ⟨i, j⟩ ⟨i', j'⟩
    simp_rw [Matrix.kroneckerMap_apply, LinearMap.toMatrix_apply,
      Module.Basis.tensorProduct_apply, TensorProduct.map_tmul,
      Module.Basis.tensorProduct_repr_tmul_apply]
    exact mul_comm _ _]
  exact Matrix.trace_kronecker _ _

noncomputable def threeBlockExteriorTensorBasis
    (K : Type*) [Field K] (d a b c : ℕ) :=
  ((MonoidAlgebra.basis (Fin d) K).exteriorPower a).tensorProduct
    (((MonoidAlgebra.basis (Fin d) K).exteriorPower b).tensorProduct
      ((MonoidAlgebra.basis (Fin d) K).exteriorPower c))

/-- An actual representation whose character is the product of the three
exterior-power characters.  Its underlying free module has the tensor
exterior basis as its Finsupp basis. -/
noncomputable def threeBlockExteriorFreeRepresentation
    (K : Type*) [Field K] (d a b c : ℕ) :
    Representation K (Fin 3 → Equiv.Perm (Fin d))
      ((powersetCard (Fin d) a ×
        (powersetCard (Fin d) b × powersetCard (Fin d) c)) →₀ K) :=
  ((threeBlockExteriorTensorBasis K d a b c).repr.conjRingEquiv).toMonoidHom.comp
    ((blockExteriorRepresentation K 3 d 0 a).tprod
      ((blockExteriorRepresentation K 3 d 1 b).tprod
        (blockExteriorRepresentation K 3 d 2 c)))

theorem threeBlockExteriorFreeRepresentation_character
    (K : Type*) [Field K] (d a b c : ℕ)
    (pi : Fin 3 → Equiv.Perm (Fin d)) :
    (threeBlockExteriorFreeRepresentation K d a b c).character pi =
      threeBlockExteriorCharacter K d a b c pi := by
  unfold threeBlockExteriorFreeRepresentation threeBlockExteriorCharacter
  unfold Representation.character
  change LinearMap.trace K _
      ((threeBlockExteriorTensorBasis K d a b c).repr.conj
        (((blockExteriorRepresentation K 3 d 0 a).tprod
          ((blockExteriorRepresentation K 3 d 1 b).tprod
            (blockExteriorRepresentation K 3 d 2 c))) pi)) = _
  calc
    _ = LinearMap.trace K _
        (((blockExteriorRepresentation K 3 d 0 a).tprod
          ((blockExteriorRepresentation K 3 d 1 b).tprod
            (blockExteriorRepresentation K 3 d 2 c))) pi) := by
      exact trace_conj_of_finite_basis
        (threeBlockExteriorTensorBasis K d a b c) _
        (threeBlockExteriorTensorBasis K d a b c).repr
    _ = _ := by
      rw [Representation.tprod_apply]
      rw [trace_tensorProduct_of_finite_basis
        ((MonoidAlgebra.basis (Fin d) K).exteriorPower a)
        (((MonoidAlgebra.basis (Fin d) K).exteriorPower b).tensorProduct
          ((MonoidAlgebra.basis (Fin d) K).exteriorPower c))]
      rw [Representation.tprod_apply]
      rw [trace_tensorProduct_of_finite_basis
        ((MonoidAlgebra.basis (Fin d) K).exteriorPower b)
        ((MonoidAlgebra.basis (Fin d) K).exteriorPower c)]
      ring

noncomputable def twoBlockExteriorTensorBasis
    (K : Type*) [Field K] (d a b : ℕ) :=
  ((MonoidAlgebra.basis (Fin d) K).exteriorPower a).tensorProduct
    ((MonoidAlgebra.basis (Fin d) K).exteriorPower b)

/-- The corresponding actual free representation for a proper-pair
two-block exterior character. -/
noncomputable def twoBlockExteriorFreeRepresentation
    (K : Type*) [Field K] (d a b : ℕ) :
    Representation K (Fin 2 → Equiv.Perm (Fin d))
      ((powersetCard (Fin d) a × powersetCard (Fin d) b) →₀ K) :=
  ((twoBlockExteriorTensorBasis K d a b).repr.conjRingEquiv).toMonoidHom.comp
    ((blockExteriorRepresentation K 2 d 0 a).tprod
      (blockExteriorRepresentation K 2 d 1 b))

theorem twoBlockExteriorFreeRepresentation_character
    (K : Type*) [Field K] (d a b : ℕ)
    (pi : Fin 2 → Equiv.Perm (Fin d)) :
    (twoBlockExteriorFreeRepresentation K d a b).character pi =
      twoBlockExteriorCharacter K d a b pi := by
  unfold twoBlockExteriorFreeRepresentation twoBlockExteriorCharacter
  unfold Representation.character
  change LinearMap.trace K _
      ((twoBlockExteriorTensorBasis K d a b).repr.conj
        (((blockExteriorRepresentation K 2 d 0 a).tprod
          (blockExteriorRepresentation K 2 d 1 b)) pi)) = _
  calc
    _ = LinearMap.trace K _
        (((blockExteriorRepresentation K 2 d 0 a).tprod
          (blockExteriorRepresentation K 2 d 1 b)) pi) := by
      exact trace_conj_of_finite_basis
        (twoBlockExteriorTensorBasis K d a b) _
        (twoBlockExteriorTensorBasis K d a b).repr
    _ = _ := by
      rw [Representation.tprod_apply]
      rw [trace_tensorProduct_of_finite_basis
        ((MonoidAlgebra.basis (Fin d) K).exteriorPower a)
        ((MonoidAlgebra.basis (Fin d) K).exteriorPower b)]

/-- The cubic virtual-Mangoldt average is the finite alternating sum of the
character averages attached to actual dual exterior-power representations.
This is the representation-theoretic expansion used by the trace formula. -/
theorem threeBlockVirtualCharacterAverage_eq_sum
    (K : Type*) [Field K] (d : ℕ)
    (pointTrace : (Fin 3 → Equiv.Perm (Fin d)) → K) :
    (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
        ∑ pi : Fin 3 → Equiv.Perm (Fin d),
          permutationVirtualMangoldt K (Fin d) (pi 0) *
            permutationVirtualMangoldt K (Fin d) (pi 1) *
            permutationVirtualMangoldt K (Fin d) (pi 2) * pointTrace pi =
      ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          ∑ c : Fin (Fintype.card (Fin d) + 1),
            (((-1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
              ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ)) *
              ((-1 : K) ^ ((c : ℕ) + 1) * (c : ℕ))) *
              ((Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
                ∑ pi : Fin 3 → Equiv.Perm (Fin d),
                  (threeBlockExteriorFreeRepresentation K d a b c).dual.character
                    pi⁻¹ * pointTrace pi) := by
  simp_rw [three_permutationVirtualMangoldt_eq_sum_exteriorCharacters]
  simp_rw [Representation.char_dual, inv_inv,
    threeBlockExteriorFreeRepresentation_character]
  rw [Finset.mul_sum]
  simp_rw [Finset.sum_mul, Finset.mul_sum]
  calc
    (∑ pi : Fin 3 → Equiv.Perm (Fin d),
        ∑ a : Fin (Fintype.card (Fin d) + 1),
          ∑ b : Fin (Fintype.card (Fin d) + 1),
            ∑ c : Fin (Fintype.card (Fin d) + 1),
              (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
                (((( -1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
                  ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ)) *
                  ((-1 : K) ^ ((c : ℕ) + 1) * (c : ℕ))) *
                    threeBlockExteriorCharacter K d a b c pi * pointTrace pi)) =
      ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          ∑ c : Fin (Fintype.card (Fin d) + 1),
            ∑ pi : Fin 3 → Equiv.Perm (Fin d),
              (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
                (((( -1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
                  ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ)) *
                  ((-1 : K) ^ ((c : ℕ) + 1) * (c : ℕ))) *
                    threeBlockExteriorCharacter K d a b c pi * pointTrace pi) := by
      rw [Finset.sum_comm]
      apply Fintype.sum_congr
      intro a
      rw [Finset.sum_comm]
      apply Fintype.sum_congr
      intro b
      rw [Finset.sum_comm]
    _ = _ := by
      apply Fintype.sum_congr
      intro a
      apply Fintype.sum_congr
      intro b
      apply Fintype.sum_congr
      intro c
      apply Fintype.sum_congr
      intro pi
      ring

/-- The corresponding two-block expansion for the proper-pair collision
correction. -/
theorem twoBlockVirtualCharacterAverage_eq_sum
    (K : Type*) [Field K] (d : ℕ)
    (pointTrace : (Fin 2 → Equiv.Perm (Fin d)) → K) :
    (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
        ∑ pi : Fin 2 → Equiv.Perm (Fin d),
          permutationVirtualMangoldt K (Fin d) (pi 0) *
            permutationVirtualMangoldt K (Fin d) (pi 1) * pointTrace pi =
      ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          (((-1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
            ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ))) *
            ((Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
              ∑ pi : Fin 2 → Equiv.Perm (Fin d),
                (twoBlockExteriorFreeRepresentation K d a b).dual.character
                  pi⁻¹ * pointTrace pi) := by
  simp_rw [two_permutationVirtualMangoldt_eq_sum_exteriorCharacters]
  simp_rw [Representation.char_dual, inv_inv,
    twoBlockExteriorFreeRepresentation_character]
  rw [Finset.mul_sum]
  simp_rw [Finset.sum_mul, Finset.mul_sum]
  calc
    (∑ pi : Fin 2 → Equiv.Perm (Fin d),
        ∑ a : Fin (Fintype.card (Fin d) + 1),
          ∑ b : Fin (Fintype.card (Fin d) + 1),
            (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
              (((( -1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
                ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ))) *
                  twoBlockExteriorCharacter K d a b pi * pointTrace pi)) =
      ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          ∑ pi : Fin 2 → Equiv.Perm (Fin d),
            (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
              (((( -1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
                ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ))) *
                  twoBlockExteriorCharacter K d a b pi * pointTrace pi) := by
      rw [Finset.sum_comm]
      apply Fintype.sum_congr
      intro a
      rw [Finset.sum_comm]
    _ = _ := by
      apply Fintype.sum_congr
      intro a
      apply Fintype.sum_congr
      intro b
      apply Fintype.sum_congr
      intro pi
      ring

/-! Source-specific cohomological packages.  They record the Lefschetz,
weight, and invariant-rank inputs for every honest exterior representation
appearing in the two virtual-character expansions above. -/

universe w

structure ThreeBlockVirtualCharacterCohomologyData
    (K : Type*) [Field K] (topDegree d : ℕ)
    (pointTrace : (Fin 3 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (rankBudget : ℕ)
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)] where
  rankBudgetAt : Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) → ℕ
  data : ∀ a b c : Fin (Fintype.card (Fin d) + 1),
    FrobeniusRepresentationFamily.CharacterCohomologyData.{w}
      topDegree pointTrace
        (threeBlockExteriorFreeRepresentation K d
          (a : ℕ) (b : ℕ) (c : ℕ)).dual
        sigma radius (rankBudgetAt a b c)
  weightedRankBound :
    (∑ a : Fin (Fintype.card (Fin d) + 1),
      ∑ b : Fin (Fintype.card (Fin d) + 1),
        ∑ c : Fin (Fintype.card (Fin d) + 1),
          (a : ℕ) * (b : ℕ) * (c : ℕ) * rankBudgetAt a b c) ≤ rankBudget

structure TwoBlockVirtualCharacterCohomologyData
    (K : Type*) [Field K] (topDegree d : ℕ)
    (pointTrace : (Fin 2 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (rankBudget : ℕ)
    [Invertible (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)] where
  rankBudgetAt : Fin (Fintype.card (Fin d) + 1) →
    Fin (Fintype.card (Fin d) + 1) → ℕ
  data : ∀ a b : Fin (Fintype.card (Fin d) + 1),
    FrobeniusRepresentationFamily.CharacterCohomologyData.{w}
      topDegree pointTrace
        (twoBlockExteriorFreeRepresentation K d (a : ℕ) (b : ℕ)).dual
        sigma radius (rankBudgetAt a b)
  weightedRankBound :
    (∑ a : Fin (Fintype.card (Fin d) + 1),
      ∑ b : Fin (Fintype.card (Fin d) + 1),
        (a : ℕ) * (b : ℕ) * rankBudgetAt a b) ≤ rankBudget

/-- Construct the cubic virtual-character package from a single ambient
cohomological family.  Tensor stability and invariant restriction transfer
the ambient weight bound to every exterior character. -/
noncomputable def ThreeBlockVirtualCharacterCohomologyData.ofAmbientRootBounds
    {K : Type*} [Field K] (topDegree d : ℕ)
    (pointTrace : (Fin 3 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (rankBudget : ℕ)
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)]
    (rankBudgetAt : Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) → ℕ)
    (family : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 3 → Equiv.Perm (Fin d)))
    (lefschetz : ∀ pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace family pi =
        pointTrace pi)
    (ambientRootBound : ∀ degree z,
      z ∈ ((family degree).frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius)
    (rankBound : ∀ a b c : Fin (Fintype.card (Fin d) + 1),
      (∑ degree : Fin (topDegree + 1),
        (family degree).characterInvariantRank
          (threeBlockExteriorFreeRepresentation K d
            (a : ℕ) (b : ℕ) (c : ℕ)).dual) ≤ rankBudgetAt a b c)
    (weightedRankBound :
      (∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          ∑ c : Fin (Fintype.card (Fin d) + 1),
            (a : ℕ) * (b : ℕ) * (c : ℕ) * rankBudgetAt a b c) ≤ rankBudget) :
    ThreeBlockVirtualCharacterCohomologyData.{w}
      K topDegree d pointTrace sigma radius rankBudget where
  rankBudgetAt := rankBudgetAt
  data a b c :=
    FrobeniusRepresentationFamily.CharacterCohomologyData.ofAmbientRootBounds
      topDegree pointTrace
      (threeBlockExteriorFreeRepresentation K d
        (a : ℕ) (b : ℕ) (c : ℕ)).dual
      sigma radius (rankBudgetAt a b c) family lefschetz ambientRootBound
      (rankBound a b c)
  weightedRankBound := weightedRankBound

/-- Ambient-root constructor for the proper-pair virtual-character package. -/
noncomputable def TwoBlockVirtualCharacterCohomologyData.ofAmbientRootBounds
    {K : Type*} [Field K] (topDegree d : ℕ)
    (pointTrace : (Fin 2 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (rankBudget : ℕ)
    [Invertible (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)]
    (rankBudgetAt : Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) → ℕ)
    (family : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 2 → Equiv.Perm (Fin d)))
    (lefschetz : ∀ pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace family pi =
        pointTrace pi)
    (ambientRootBound : ∀ degree z,
      z ∈ ((family degree).frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius)
    (rankBound : ∀ a b : Fin (Fintype.card (Fin d) + 1),
      (∑ degree : Fin (topDegree + 1),
        (family degree).characterInvariantRank
          (twoBlockExteriorFreeRepresentation K d (a : ℕ) (b : ℕ)).dual) ≤
            rankBudgetAt a b)
    (weightedRankBound :
      (∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          (a : ℕ) * (b : ℕ) * rankBudgetAt a b) ≤ rankBudget) :
    TwoBlockVirtualCharacterCohomologyData.{w}
      K topDegree d pointTrace sigma radius rankBudget where
  rankBudgetAt := rankBudgetAt
  data a b :=
    FrobeniusRepresentationFamily.CharacterCohomologyData.ofAmbientRootBounds
      topDegree pointTrace
      (twoBlockExteriorFreeRepresentation K d (a : ℕ) (b : ℕ)).dual
      sigma radius (rankBudgetAt a b) family lefschetz ambientRootBound
      (rankBound a b)
  weightedRankBound := weightedRankBound

theorem norm_map_threeBlockExteriorCoefficient
    {K : Type*} [Field K] (sigma : K →+* ℂ) (a b c : ℕ) :
    ‖sigma ((((-1 : K) ^ (a + 1) * (a : K)) *
      ((-1 : K) ^ (b + 1) * (b : K)) *
      ((-1 : K) ^ (c + 1) * (c : K))))‖ =
      (a : ℝ) * b * c := by
  simp only [map_mul, map_pow, map_neg, map_one, norm_mul, norm_pow,
    norm_neg, norm_one, map_natCast, norm_natCast]
  ring

theorem norm_map_twoBlockExteriorCoefficient
    {K : Type*} [Field K] (sigma : K →+* ℂ) (a b : ℕ) :
    ‖sigma ((((-1 : K) ^ (a + 1) * (a : K)) *
      ((-1 : K) ^ (b + 1) * (b : K))))‖ =
      (a : ℝ) * b := by
  simp only [map_mul, map_pow, map_neg, map_one, norm_mul, norm_pow,
    norm_neg, norm_one, map_natCast, norm_natCast]
  ring

theorem card_powersetCard_fin (d a : ℕ) :
    Fintype.card (powersetCard (Fin d) a) = d.choose a := by
  calc
    Fintype.card (powersetCard (Fin d) a) =
        Fintype.card ↥((Finset.univ : Finset (Fin d)).powersetCard a) :=
      Fintype.card_congr (powersetCardEquivFinsetPowerset (Fin d) a)
    _ = ((Finset.univ : Finset (Fin d)).powersetCard a).card :=
      Fintype.card_coe _
    _ = (Finset.univ : Finset (Fin d)).card.choose a :=
      Finset.card_powersetCard a Finset.univ
    _ = d.choose a := by simp

theorem threeBlockExteriorFreeRepresentation_finrank
    (K : Type*) [Field K] (d a b c : ℕ) :
    Module.finrank K
      ((powersetCard (Fin d) a ×
        (powersetCard (Fin d) b × powersetCard (Fin d) c)) →₀ K) =
      d.choose a * (d.choose b * d.choose c) := by
  calc
    Module.finrank K
        ((powersetCard (Fin d) a ×
          (powersetCard (Fin d) b × powersetCard (Fin d) c)) →₀ K) =
      Fintype.card (powersetCard (Fin d) a ×
          (powersetCard (Fin d) b × powersetCard (Fin d) c)) :=
        Module.finrank_eq_card_basis Finsupp.basisSingleOne
    _ = _ := by
      rw [Fintype.card_prod, Fintype.card_prod]
      rw [card_powersetCard_fin, card_powersetCard_fin,
        card_powersetCard_fin]

theorem twoBlockExteriorFreeRepresentation_finrank
    (K : Type*) [Field K] (d a b : ℕ) :
    Module.finrank K
      ((powersetCard (Fin d) a × powersetCard (Fin d) b) →₀ K) =
      d.choose a * d.choose b := by
  calc
    Module.finrank K
        ((powersetCard (Fin d) a × powersetCard (Fin d) b) →₀ K) =
      Fintype.card (powersetCard (Fin d) a × powersetCard (Fin d) b) :=
        Module.finrank_eq_card_basis Finsupp.basisSingleOne
    _ = _ := by
      rw [Fintype.card_prod]
      rw [card_powersetCard_fin, card_powersetCard_fin]

/-- The total exterior degree, weighted by the corresponding binomial
representation degree. -/
def exteriorWeightedDegreeSum (d : ℕ) : ℕ :=
  ∑ a : Fin (Fintype.card (Fin d) + 1), (a : ℕ) * d.choose a

theorem threeBlock_weighted_finrank_sum
    (d ambientRank : ℕ) :
    (∑ a : Fin (Fintype.card (Fin d) + 1),
      ∑ b : Fin (Fintype.card (Fin d) + 1),
        ∑ c : Fin (Fintype.card (Fin d) + 1),
          (a : ℕ) * (b : ℕ) * (c : ℕ) *
            (d.choose a * (d.choose b * d.choose c) * ambientRank)) =
      exteriorWeightedDegreeSum d ^ 3 * ambientRank := by
  let f : Fin (Fintype.card (Fin d) + 1) → ℕ :=
    fun a => (a : ℕ) * d.choose a
  calc
    _ = ∑ a, ∑ b, ∑ c, f a * (f b * (f c * ambientRank)) := by
      apply Fintype.sum_congr
      intro a
      apply Fintype.sum_congr
      intro b
      apply Fintype.sum_congr
      intro c
      dsimp only [f]
      ring
    _ = (∑ a, f a) * ((∑ b, f b) * ((∑ c, f c) * ambientRank)) := by
      symm
      rw [← mul_assoc, Fintype.sum_mul_sum]
      rw [← mul_assoc, Fintype.sum_mul_sum, Finset.sum_mul]
      apply Fintype.sum_congr
      intro a
      rw [Finset.sum_mul Finset.univ
        (fun b => (∑ c, f a * f c) * f b) ambientRank]
      apply Fintype.sum_congr
      intro b
      rw [Finset.sum_mul Finset.univ (fun c => f a * f c) (f b)]
      rw [Finset.sum_mul Finset.univ
        (fun c => f a * f c * f b) ambientRank]
      apply Fintype.sum_congr
      intro c
      ring
    _ = exteriorWeightedDegreeSum d ^ 3 * ambientRank := by
      dsimp only [f, exteriorWeightedDegreeSum]
      ring

theorem twoBlock_weighted_finrank_sum
    (d ambientRank : ℕ) :
    (∑ a : Fin (Fintype.card (Fin d) + 1),
      ∑ b : Fin (Fintype.card (Fin d) + 1),
        (a : ℕ) * (b : ℕ) *
          (d.choose a * d.choose b * ambientRank)) =
      exteriorWeightedDegreeSum d ^ 2 * ambientRank := by
  let f : Fin (Fintype.card (Fin d) + 1) → ℕ :=
    fun a => (a : ℕ) * d.choose a
  calc
    _ = ∑ a, ∑ b, f a * (f b * ambientRank) := by
      apply Fintype.sum_congr
      intro a
      apply Fintype.sum_congr
      intro b
      dsimp only [f]
      ring
    _ = (∑ a, f a) * ((∑ b, f b) * ambientRank) := by
      symm
      rw [← mul_assoc, Fintype.sum_mul_sum, Finset.sum_mul]
      apply Fintype.sum_congr
      intro a
      rw [Finset.sum_mul]
      apply Fintype.sum_congr
      intro b
      ring
    _ = exteriorWeightedDegreeSum d ^ 2 * ambientRank := by
      dsimp only [f, exteriorWeightedDegreeSum]
      ring

/-- A single ambient total-cohomology rank bound automatically supplies every
three-block isotypic rank budget. -/
noncomputable def
    ThreeBlockVirtualCharacterCohomologyData.ofAmbientCohomologyRank
    {K : Type*} [Field K] (topDegree d : ℕ)
    (pointTrace : (Fin 3 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (ambientRankBudget : ℕ)
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)]
    (family : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 3 → Equiv.Perm (Fin d)))
    (lefschetz : ∀ pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace family pi =
        pointTrace pi)
    (ambientRootBound : ∀ degree z,
      z ∈ ((family degree).frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius)
    (ambientRankBound : (∑ degree : Fin (topDegree + 1),
      (family degree).rank) ≤ ambientRankBudget) :
    ThreeBlockVirtualCharacterCohomologyData.{w}
      K topDegree d pointTrace sigma radius
        (exteriorWeightedDegreeSum d ^ 3 * ambientRankBudget) := by
  apply ThreeBlockVirtualCharacterCohomologyData.ofAmbientRootBounds
    topDegree d pointTrace sigma radius
    (exteriorWeightedDegreeSum d ^ 3 * ambientRankBudget)
    (fun a b c =>
      d.choose a * (d.choose b * d.choose c) * ambientRankBudget)
    family lefschetz ambientRootBound
  · intro a b c
    have h := FrobeniusRepresentationFamily.sum_characterInvariantRank_le_mul_finrank
      family
      (threeBlockExteriorFreeRepresentation K d
        (a : ℕ) (b : ℕ) (c : ℕ)).dual ambientRankBound
    rw [Subspace.dual_finrank_eq,
      threeBlockExteriorFreeRepresentation_finrank] at h
    exact h
  · exact threeBlock_weighted_finrank_sum d ambientRankBudget |>.le

/-- Ambient total rank likewise supplies every proper-pair isotypic budget. -/
noncomputable def
    TwoBlockVirtualCharacterCohomologyData.ofAmbientCohomologyRank
    {K : Type*} [Field K] (topDegree d : ℕ)
    (pointTrace : (Fin 2 → Equiv.Perm (Fin d)) → K)
    (sigma : K →+* ℂ) (radius : ℝ) (ambientRankBudget : ℕ)
    [Invertible (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)]
    (family : Fin (topDegree + 1) →
      FiniteFrobeniusRepresentation.{_, _, w} K
        (Fin 2 → Equiv.Perm (Fin d)))
    (lefschetz : ∀ pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace family pi =
        pointTrace pi)
    (ambientRootBound : ∀ degree z,
      z ∈ ((family degree).frobeniusRealizationMatrix sigma).charpoly.roots →
        ‖z‖ ≤ radius)
    (ambientRankBound : (∑ degree : Fin (topDegree + 1),
      (family degree).rank) ≤ ambientRankBudget) :
    TwoBlockVirtualCharacterCohomologyData.{w}
      K topDegree d pointTrace sigma radius
        (exteriorWeightedDegreeSum d ^ 2 * ambientRankBudget) := by
  apply TwoBlockVirtualCharacterCohomologyData.ofAmbientRootBounds
    topDegree d pointTrace sigma radius
    (exteriorWeightedDegreeSum d ^ 2 * ambientRankBudget)
    (fun a b => d.choose a * d.choose b * ambientRankBudget)
    family lefschetz ambientRootBound
  · intro a b
    have h := FrobeniusRepresentationFamily.sum_characterInvariantRank_le_mul_finrank
      family
      (twoBlockExteriorFreeRepresentation K d (a : ℕ) (b : ℕ)).dual
      ambientRankBound
    rw [Subspace.dual_finrank_eq,
      twoBlockExteriorFreeRepresentation_finrank] at h
    exact h
  · exact twoBlock_weighted_finrank_sum d ambientRankBudget |>.le

/-! The ambient packages specialized to the two residue-fiber families. -/

noncomputable def
    fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentationFamily
    (q d m ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [hfinite : ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q (3 * d) m ell degree g hg hdeg hm hmn t)] :
    Fin (topDegree + 1) → FiniteFrobeniusRepresentation ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin d)) := fun degree =>
  letI := hfinite degree
  fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentation
    q d m ell degree g hg hdeg hm hmn t

noncomputable def fullResidueUnitFiberDistinctThreeBlockPointTrace
    (q d m ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (pi : Fin 3 → Equiv.Perm (Fin d)) : ℚ_[ell] :=
  Nat.card (FullResidueUnitFiberDistinctGeometricTwistedFixedPoint
    q (3 * d) m g hg hdeg hm hmn t (threeBlockPermutationFamily d pi))

/-- The geometric three-block point trace is the arithmetic fixed-point count
used in the irreducible-triple identity. -/
theorem fullResidueUnitFiberDistinctThreeBlockPointTrace_eq_arithmetic
    (q d m ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    (pi : Fin 3 → Equiv.Perm (Fin d)) :
    fullResidueUnitFiberDistinctThreeBlockPointTrace
        q d m ell g hg hdeg hm hmn t pi =
      (fullResidueUnitFiberDistinctFixedPointCount q (3 * d) m
        (AlgebraicClosure (ZMod q)) g hg hdeg hm hmn t
        (threeBlockPermutationFamily d pi) : ℕ) := by
  unfold fullResidueUnitFiberDistinctThreeBlockPointTrace
    fullResidueUnitFiberDistinctFixedPointCount
  exact_mod_cast (Nat.card_congr
    (fullResidueUnitFiberDistinctGeometricTwistedFixedPointEquiv
      q (3 * d) m g hg hdeg hm hmn t
        (threeBlockPermutationFamily d pi))).symm

/-- The normalized cubic virtual-character point-trace average is exactly the
ordered irreducible-triple mass. -/
theorem fullResidueUnitFiberDistinctThreeBlockPointTrace_virtualAverage_eq
    (q d m ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hd : 2 ≤ d)
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g) :
    (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : ℚ_[ell])⁻¹ *
      ∑ pi : Fin 3 → Equiv.Perm (Fin d),
        permutationVirtualMangoldt ℚ_[ell] (Fin d) (pi 0) *
          permutationVirtualMangoldt ℚ_[ell] (Fin d) (pi 1) *
          permutationVirtualMangoldt ℚ_[ell] (Fin d) (pi 2) *
          fullResidueUnitFiberDistinctThreeBlockPointTrace
            q d m ell g hg hdeg hm hmn t pi =
      ((d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
          (residueUnitPointPolynomial q m g t)) : ℕ) : ℚ_[ell]) := by
  rw [sum_fin_three_arrow]
  simp_rw [fullResidueUnitFiberDistinctThreeBlockPointTrace_eq_arithmetic]
  have hsum :
      (∑ g₀ : Equiv.Perm (Fin d),
        ∑ g₁ : Equiv.Perm (Fin d),
          ∑ g₂ : Equiv.Perm (Fin d),
            permutationVirtualMangoldt ℚ_[ell] (Fin d) g₀ *
              permutationVirtualMangoldt ℚ_[ell] (Fin d) g₁ *
              permutationVirtualMangoldt ℚ_[ell] (Fin d) g₂ *
              (fullResidueUnitFiberDistinctFixedPointCount q (3 * d) m
                (AlgebraicClosure (ZMod q)) g hg hdeg hm hmn t
                (threeBlockPermutationTriple d g₀ g₁ g₂) : ℚ_[ell])) =
        (d.factorial : ℚ_[ell]) ^ 3 *
          ((d ^ 3 * Nat.card (CongruentIrreducibleTriple q d g
            (residueUnitPointPolynomial q m g t)) : ℕ) : ℚ_[ell]) := by
    have hq :=
      sum_three_permutationVirtualMangoldt_mul_distinctFixedPointCount_eq_triple
        q d m hd (AlgebraicClosure (ZMod q)) g hg hdeg hm hmn t
    simp_rw [permutationVirtualMangoldt_eq_ite_cycleType ℚ d hd] at hq
    simp_rw [permutationVirtualMangoldt_eq_ite_cycleType ℚ_[ell] d hd]
    exact_mod_cast hq
  have hvec (a b c : Equiv.Perm (Fin d)) :
      (![a, b, c] : Fin 3 → Equiv.Perm (Fin d)) 2 = c := rfl
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, hvec,
    threeBlockPermutationTriple] at hsum ⊢
  rw [hsum]
  have hcard :
      (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : ℚ_[ell]) =
        (d.factorial : ℚ_[ell]) ^ 3 := by
    norm_cast
    simp [Fintype.card_congr (finThreeArrowEquiv (Equiv.Perm (Fin d))),
      Fintype.card_perm, pow_three]
  rw [hcard]
  have hfac : (d.factorial : ℚ_[ell]) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero d
  field_simp [hfac]

noncomputable def
    fullResidueUnitFiberDistinctCanonicalThreeBlockVirtualCharacterCohomologyData
    (q d m ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
    (t : ResidueUnitPoint (ZMod q) m g)
    [hfinite : ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (FullResidueUnitFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q (3 * d) m ell degree g hg hdeg hm hmn t)]
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (ambientRankBudget : ℕ)
    (lefschetz : ∀ pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace
        (fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentationFamily
          q d m ell topDegree g hg hdeg hm hmn t) pi =
        fullResidueUnitFiberDistinctThreeBlockPointTrace
          q d m ell g hg hdeg hm hmn t pi)
    (rootBound : ∀ degree z,
      z ∈ (((fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentationFamily
        q d m ell topDegree g hg hdeg hm hmn t) degree).frobeniusRealizationMatrix
          sigma).charpoly.roots → ‖z‖ ≤ radius)
    (rankBound : (∑ degree : Fin (topDegree + 1),
      ((fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentationFamily
        q d m ell topDegree g hg hdeg hm hmn t) degree).rank) ≤ ambientRankBudget) :
    ThreeBlockVirtualCharacterCohomologyData
      ℚ_[ell] topDegree d
      (fullResidueUnitFiberDistinctThreeBlockPointTrace
        q d m ell g hg hdeg hm hmn t)
      sigma radius (exteriorWeightedDegreeSum d ^ 3 * ambientRankBudget) :=
  ThreeBlockVirtualCharacterCohomologyData.ofAmbientCohomologyRank
    topDegree d
    (fullResidueUnitFiberDistinctThreeBlockPointTrace
      q d m ell g hg hdeg hm hmn t)
    sigma radius ambientRankBudget
    (fullResidueUnitFiberDistinctCanonicalThreeBlockFiniteFrobeniusRepresentationFamily
      q d m ell topDegree g hg hdeg hm hmn t)
    lefschetz rootBound rankBound

noncomputable def properPairResidueFiberDistinctPointTrace
    (q d m ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (pi : Fin 2 → Equiv.Perm (Fin d)) : ℚ_[ell] :=
  Nat.card (ProperPairResidueFiberDistinctGeometricTwistedFixedPoint
    q d m g t hg pi)

/-- The geometric proper-pair point trace is the arithmetic fixed locus used
in the proper-pair counting identity. -/
theorem properPairResidueFiberDistinctPointTrace_eq_arithmetic
    (q d m ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (pi : Fin 2 → Equiv.Perm (Fin d)) :
    properPairResidueFiberDistinctPointTrace q d m ell g t hg pi =
      (Nat.card ({z : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
          ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
        z ≫ properPairResidueFiberDistinctTwistedFrobenius
          q d m g t hg pi = z}) : ℕ) := by
  unfold properPairResidueFiberDistinctPointTrace
  exact_mod_cast (Nat.card_congr
    (properPairResidueFiberDistinctGeometricTwistedFixedPointEquiv
      q d m g t hg pi)).symm

/-- The normalized proper-pair virtual-character point-trace average is the
ordered irreducible proper-pair mass. -/
theorem properPairResidueFiberDistinctPointTrace_virtualAverage_eq
    (q d m ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hd : 2 ≤ d)
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    (hdeg : g.natDegree = m) (ht : t.natDegree < m)
    (hgt : IsCoprime g t) :
    (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : ℚ_[ell])⁻¹ *
      ∑ pi : Fin 2 → Equiv.Perm (Fin d),
        permutationVirtualMangoldt ℚ_[ell] (Fin d) (pi 0) *
          permutationVirtualMangoldt ℚ_[ell] (Fin d) (pi 1) *
          properPairResidueFiberDistinctPointTrace q d m ell g t hg pi =
      ((d ^ 2 * Nat.card
        (CongruentIrreducibleProperPair q d g t) : ℕ) : ℚ_[ell]) := by
  rw [sum_fin_two_arrow]
  simp_rw [properPairResidueFiberDistinctPointTrace_eq_arithmetic]
  have hsum :
      (∑ pi0 : Equiv.Perm (Fin d),
        ∑ pi1 : Equiv.Perm (Fin d),
          permutationVirtualMangoldt ℚ_[ell] (Fin d) pi0 *
            permutationVirtualMangoldt ℚ_[ell] (Fin d) pi1 *
            (Nat.card ({z : Spec (.of (AlgebraicClosure (ZMod q))) ⟶
                ProperPairResidueFiberDistinct (ZMod q) d m g t hg //
              z ≫ properPairResidueFiberDistinctTwistedFrobenius
                q d m g t hg ![pi0, pi1] = z}) : ℚ_[ell])) =
        (d.factorial : ℚ_[ell]) ^ 2 *
          ((d ^ 2 * Nat.card
            (CongruentIrreducibleProperPair q d g t) : ℕ) : ℚ_[ell]) := by
    have hq :=
      sum_two_permutationVirtualMangoldt_mul_properPairFixedPointCount_eq_pair
        q d m hd (AlgebraicClosure (ZMod q)) g t hg hdeg ht hgt
    simp_rw [permutationVirtualMangoldt_eq_ite_cycleType ℚ d hd] at hq
    simp_rw [permutationVirtualMangoldt_eq_ite_cycleType ℚ_[ell] d hd]
    exact_mod_cast hq
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hsum ⊢
  rw [hsum]
  have hcard :
      (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : ℚ_[ell]) =
        (d.factorial : ℚ_[ell]) ^ 2 := by
    norm_cast
    simp [Fintype.card_congr (finTwoArrowEquiv (Equiv.Perm (Fin d))),
      Fintype.card_perm, pow_two]
  rw [hcard]
  have hfac : (d.factorial : ℚ_[ell]) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero d
  field_simp [hfac]

noncomputable def
    properPairResidueFiberDistinctCanonicalVirtualCharacterCohomologyData
    (q d m ell topDegree : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (g t : Polynomial (ZMod q)) (hg : g.Monic)
    [hfinite : ∀ degree : Fin (topDegree + 1),
      FiniteDimensional ℚ_[ell]
        (ProperPairResidueFiberDistinctCanonicalQEllAdicCompactSupportCohomology
          q d m ell degree g t hg)]
    (sigma : ℚ_[ell] →+* ℂ) (radius : ℝ) (ambientRankBudget : ℕ)
    (lefschetz : ∀ pi,
      FrobeniusRepresentationFamily.alternatingTwistedTrace
        (properPairResidueFiberDistinctCanonicalFiniteFrobeniusRepresentationFamily
          q d m ell topDegree g t hg) pi =
        properPairResidueFiberDistinctPointTrace q d m ell g t hg pi)
    (rootBound : ∀ degree z,
      z ∈ (((properPairResidueFiberDistinctCanonicalFiniteFrobeniusRepresentationFamily
        q d m ell topDegree g t hg) degree).frobeniusRealizationMatrix
          sigma).charpoly.roots → ‖z‖ ≤ radius)
    (rankBound : (∑ degree : Fin (topDegree + 1),
      ((properPairResidueFiberDistinctCanonicalFiniteFrobeniusRepresentationFamily
        q d m ell topDegree g t hg) degree).rank) ≤ ambientRankBudget) :
    TwoBlockVirtualCharacterCohomologyData
      ℚ_[ell] topDegree d
      (properPairResidueFiberDistinctPointTrace q d m ell g t hg)
      sigma radius (exteriorWeightedDegreeSum d ^ 2 * ambientRankBudget) :=
  TwoBlockVirtualCharacterCohomologyData.ofAmbientCohomologyRank
    topDegree d
    (properPairResidueFiberDistinctPointTrace q d m ell g t hg)
    sigma radius ambientRankBudget
    (properPairResidueFiberDistinctCanonicalFiniteFrobeniusRepresentationFamily
      q d m ell topDegree g t hg)
    lefschetz rootBound rankBound

/-- The three-block geometric inputs imply the required norm bound for the
cubic virtual-Mangoldt average. -/
theorem ThreeBlockVirtualCharacterCohomologyData.norm_virtualAverage_le
    {K : Type*} [Field K] {topDegree d : ℕ}
    {pointTrace : (Fin 3 → Equiv.Perm (Fin d)) → K}
    {sigma : K →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    [Invertible (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)]
    (data : ThreeBlockVirtualCharacterCohomologyData.{w}
      K topDegree d pointTrace sigma radius rankBudget)
    (hradius : 0 ≤ radius) :
    ‖sigma ((Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
      ∑ pi : Fin 3 → Equiv.Perm (Fin d),
        permutationVirtualMangoldt K (Fin d) (pi 0) *
          permutationVirtualMangoldt K (Fin d) (pi 1) *
          permutationVirtualMangoldt K (Fin d) (pi 2) * pointTrace pi)‖ ≤
        rankBudget * radius := by
  rw [threeBlockVirtualCharacterAverage_eq_sum]
  let coefficient : Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) → K := fun a b c =>
    ((-1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
      ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ)) *
      ((-1 : K) ^ ((c : ℕ) + 1) * (c : ℕ))
  let average : Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) → K := fun a b c =>
    (Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
      ∑ pi : Fin 3 → Equiv.Perm (Fin d),
        (threeBlockExteriorFreeRepresentation K d a b c).dual.character
          pi⁻¹ * pointTrace pi
  change ‖sigma (∑ a, ∑ b, ∑ c, coefficient a b c * average a b c)‖ ≤ _
  have hmap :
      sigma (∑ a, ∑ b, ∑ c, coefficient a b c * average a b c) =
        ∑ a, ∑ b, ∑ c, sigma (coefficient a b c) * sigma (average a b c) := by
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro a _
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro b _
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro c _
    rw [map_mul]
  rw [hmap]
  calc
    ‖∑ a, ∑ b, ∑ c, sigma (coefficient a b c) * sigma (average a b c)‖ ≤
        ∑ a, ‖∑ b, ∑ c,
          sigma (coefficient a b c) * sigma (average a b c)‖ := norm_sum_le _ _
    _ ≤ ∑ a, ∑ b, ‖∑ c,
          sigma (coefficient a b c) * sigma (average a b c)‖ := by
      apply Finset.sum_le_sum
      intro a _
      exact norm_sum_le _ _
    _ ≤ ∑ a, ∑ b, ∑ c,
          ‖sigma (coefficient a b c) * sigma (average a b c)‖ := by
      apply Finset.sum_le_sum
      intro a _
      apply Finset.sum_le_sum
      intro b _
      exact norm_sum_le _ _
    _ ≤ ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          ∑ c : Fin (Fintype.card (Fin d) + 1),
            (((a : ℕ) * (b : ℕ) * (c : ℕ) * data.rankBudgetAt a b c : ℕ) : ℝ) *
              radius := by
      apply Finset.sum_le_sum
      intro a _
      apply Finset.sum_le_sum
      intro b _
      apply Finset.sum_le_sum
      intro c _
      dsimp only [coefficient, average]
      rw [norm_mul, norm_map_threeBlockExteriorCoefficient]
      calc
        (a : ℝ) * b * c *
            ‖sigma ((Fintype.card (Fin 3 → Equiv.Perm (Fin d)) : K)⁻¹ *
              ∑ pi : Fin 3 → Equiv.Perm (Fin d),
                (threeBlockExteriorFreeRepresentation K d a b c).dual.character
                  pi⁻¹ * pointTrace pi)‖ ≤
          (a : ℝ) * b * c * (data.rankBudgetAt a b c * radius) := by
            gcongr
            exact (data.data a b c).norm_characterAverage_pointTrace_le hradius
        _ = (((a : ℕ) * (b : ℕ) * (c : ℕ) * data.rankBudgetAt a b c : ℕ) : ℝ) *
              radius := by push_cast; ring
    _ = ((∑ a : Fin (Fintype.card (Fin d) + 1),
          ∑ b : Fin (Fintype.card (Fin d) + 1),
            ∑ c : Fin (Fintype.card (Fin d) + 1),
              (a : ℕ) * (b : ℕ) * (c : ℕ) * data.rankBudgetAt a b c : ℕ) : ℝ) *
          radius := by
      simp_rw [Nat.cast_sum, Nat.cast_mul, Finset.sum_mul]
    _ ≤ rankBudget * radius := by
      gcongr
      exact_mod_cast data.weightedRankBound

/-- The two-block geometric inputs imply the collision-term norm bound. -/
theorem TwoBlockVirtualCharacterCohomologyData.norm_virtualAverage_le
    {K : Type*} [Field K] {topDegree d : ℕ}
    {pointTrace : (Fin 2 → Equiv.Perm (Fin d)) → K}
    {sigma : K →+* ℂ} {radius : ℝ} {rankBudget : ℕ}
    [Invertible (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)]
    (data : TwoBlockVirtualCharacterCohomologyData.{w}
      K topDegree d pointTrace sigma radius rankBudget)
    (hradius : 0 ≤ radius) :
    ‖sigma ((Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
      ∑ pi : Fin 2 → Equiv.Perm (Fin d),
        permutationVirtualMangoldt K (Fin d) (pi 0) *
          permutationVirtualMangoldt K (Fin d) (pi 1) * pointTrace pi)‖ ≤
        rankBudget * radius := by
  rw [twoBlockVirtualCharacterAverage_eq_sum]
  let coefficient : Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) → K := fun a b =>
    ((-1 : K) ^ ((a : ℕ) + 1) * (a : ℕ)) *
      ((-1 : K) ^ ((b : ℕ) + 1) * (b : ℕ))
  let average : Fin (Fintype.card (Fin d) + 1) →
      Fin (Fintype.card (Fin d) + 1) → K := fun a b =>
    (Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
      ∑ pi : Fin 2 → Equiv.Perm (Fin d),
        (twoBlockExteriorFreeRepresentation K d a b).dual.character
          pi⁻¹ * pointTrace pi
  change ‖sigma (∑ a, ∑ b, coefficient a b * average a b)‖ ≤ _
  have hmap : sigma (∑ a, ∑ b, coefficient a b * average a b) =
      ∑ a, ∑ b, sigma (coefficient a b) * sigma (average a b) := by
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro a _
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro b _
    rw [map_mul]
  rw [hmap]
  calc
    ‖∑ a, ∑ b, sigma (coefficient a b) * sigma (average a b)‖ ≤
        ∑ a, ‖∑ b, sigma (coefficient a b) * sigma (average a b)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ a, ∑ b, ‖sigma (coefficient a b) * sigma (average a b)‖ := by
      apply Finset.sum_le_sum
      intro a _
      exact norm_sum_le _ _
    _ ≤ ∑ a : Fin (Fintype.card (Fin d) + 1),
        ∑ b : Fin (Fintype.card (Fin d) + 1),
          (((a : ℕ) * (b : ℕ) * data.rankBudgetAt a b : ℕ) : ℝ) * radius := by
      apply Finset.sum_le_sum
      intro a _
      apply Finset.sum_le_sum
      intro b _
      dsimp only [coefficient, average]
      rw [norm_mul, norm_map_twoBlockExteriorCoefficient]
      calc
        (a : ℝ) * b *
            ‖sigma ((Fintype.card (Fin 2 → Equiv.Perm (Fin d)) : K)⁻¹ *
              ∑ pi : Fin 2 → Equiv.Perm (Fin d),
                (twoBlockExteriorFreeRepresentation K d a b).dual.character
                  pi⁻¹ * pointTrace pi)‖ ≤
          (a : ℝ) * b * (data.rankBudgetAt a b * radius) := by
            gcongr
            exact (data.data a b).norm_characterAverage_pointTrace_le hradius
        _ = (((a : ℕ) * (b : ℕ) * data.rankBudgetAt a b : ℕ) : ℝ) * radius := by
          push_cast
          ring
    _ = ((∑ a : Fin (Fintype.card (Fin d) + 1),
          ∑ b : Fin (Fintype.card (Fin d) + 1),
            (a : ℕ) * (b : ℕ) * data.rankBudgetAt a b : ℕ) : ℝ) * radius := by
      simp_rw [Nat.cast_sum, Nat.cast_mul, Finset.sum_mul]
    _ ≤ rankBudget * radius := by
      gcongr
      exact_mod_cast data.weightedRankBound

/-! Centering must be performed before applying a square-root Frobenius
bound: the raw point trace contains a common top-cohomology contribution.
The following linear identities isolate that normalization independently of
the later geometric construction. -/

noncomputable def normalizedWeightedAverage
    (K G : Type*) [Field K] [Fintype G]
    (weight trace : G → K) : K :=
  (Fintype.card G : K)⁻¹ * ∑ g : G, weight g * trace g

theorem normalizedWeightedAverage_sub
    (K G : Type*) [Field K] [Fintype G]
    (weight f h : G → K) :
    normalizedWeightedAverage K G weight (fun g => f g - h g) =
      normalizedWeightedAverage K G weight f -
        normalizedWeightedAverage K G weight h := by
  unfold normalizedWeightedAverage
  simp_rw [mul_sub, Finset.sum_sub_distrib]
  ring

theorem normalizedWeightedAverage_sum
    (K G I : Type*) [Field K] [Fintype G] [Fintype I]
    (weight : G → K) (f : I → G → K) :
    normalizedWeightedAverage K G weight (fun g => ∑ i, f i g) =
      ∑ i, normalizedWeightedAverage K G weight (f i) := by
  unfold normalizedWeightedAverage
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]

noncomputable def centeredTraceFamily
    (K G I : Type*) [Field K] [Fintype I]
    (trace : I → G → K) (i : I) (g : G) : K :=
  trace i g - (Fintype.card I : K)⁻¹ * ∑ j : I, trace j g

theorem normalizedWeightedAverage_centeredTraceFamily
    (K G I : Type*) [Field K] [Fintype G] [Fintype I]
    (weight : G → K) (trace : I → G → K) (i : I) :
    normalizedWeightedAverage K G weight
        (centeredTraceFamily K G I trace i) =
      normalizedWeightedAverage K G weight (trace i) -
        (Fintype.card I : K)⁻¹ *
          ∑ j : I, normalizedWeightedAverage K G weight (trace j) := by
  unfold centeredTraceFamily
  rw [normalizedWeightedAverage_sub]
  change normalizedWeightedAverage K G weight (trace i) -
      normalizedWeightedAverage K G weight
        (fun g => (Fintype.card I : K)⁻¹ * ∑ j, trace j g) = _
  unfold normalizedWeightedAverage
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  congr 1
  apply Finset.sum_congr rfl
  intro j _hj
  apply Finset.sum_congr rfl
  intro g _hg
  ring

/-! The abstract centering identity is now specialized back to the two
progression strata used by the arithmetic argument. -/

noncomputable def progressionFullDistinctThreeBlockPointTrace
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ)
    (pi : Fin 3 → Equiv.Perm (Fin (2 * r))) : ℚ_[ell] :=
  fullResidueUnitFiberDistinctThreeBlockPointTrace
    q (2 * r) (k ^ 2) ell
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u) pi

theorem progressionFullDistinctThreeBlockPointTrace_virtualAverage_eq
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (u : (ProgressionQuotient q k)ˣ) :
    normalizedWeightedAverage ℚ_[ell]
        (Fin 3 → Equiv.Perm (Fin (2 * r)))
        (fun pi =>
          permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 0) *
            permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 1) *
            permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 2))
        (progressionFullDistinctThreeBlockPointTrace
          q k r ell hk hkm u) =
      (((2 * r) ^ 3 * Fintype.card
        (CongruentDistinctOrderedPrimeTriple q k r
          (progressionUnitRepresentative q k u)) : ℕ) : ℚ_[ell]) := by
  unfold normalizedWeightedAverage progressionFullDistinctThreeBlockPointTrace
  rw [fullResidueUnitFiberDistinctThreeBlockPointTrace_virtualAverage_eq
    q (2 * r) (k ^ 2) ell (by omega)
    (modulusProduct q k) (modulusProduct_monic q k)
    (modulusProduct_natDegree q k) (by positivity) hkm
    (progressionResidueUnitPoint q k hk u)]
  rw [progressionResidueUnitPoint_polynomial q k hk u]
  rw [← congruentDistinctOrderedPrimeTriple_natCard_eq_irreducible q k r
    (progressionUnitRepresentative q k u)]
  rw [Nat.card_eq_fintype_card]

theorem map_progressionFullDistinctThreeBlockPointTrace_centeredAverage
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (hkm : k ^ 2 ≤ 3 * (2 * r))
    (sigma : ℚ_[ell] →+* ℂ)
    (u : (ProgressionQuotient q k)ˣ) :
    sigma (normalizedWeightedAverage ℚ_[ell]
      (Fin 3 → Equiv.Perm (Fin (2 * r)))
      (fun pi =>
        permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 0) *
          permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 1) *
          permutationVirtualMangoldt ℚ_[ell] (Fin (2 * r)) (pi 2))
      (centeredTraceFamily ℚ_[ell]
        (Fin 3 → Equiv.Perm (Fin (2 * r)))
        ((ProgressionQuotient q k)ˣ)
        (fun v => progressionFullDistinctThreeBlockPointTrace
          q k r ell hk hkm v) u)) =
      unitDistinctOrderedPrimeTripleWeight q k r u -
        (∑ v, unitDistinctOrderedPrimeTripleWeight q k r v) /
          (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) := by
  rw [normalizedWeightedAverage_centeredTraceFamily]
  simp_rw [progressionFullDistinctThreeBlockPointTrace_virtualAverage_eq
    q k r ell hk hr hkm]
  rw [map_sub, map_mul, map_sum, map_inv₀, map_natCast]
  have hcardmap :
      sigma (Fintype.card (ProgressionQuotient q k)ˣ : ℚ_[ell]) =
        (Fintype.card (ProgressionQuotient q k)ˣ : ℂ) := by
    exact map_natCast sigma _
  rw [hcardmap]
  unfold unitDistinctOrderedPrimeTripleWeight
  push_cast
  have hsum :
      (∑ v : (ProgressionQuotient q k)ˣ,
        sigma (((2 * r) ^ 3 * Fintype.card
          (CongruentDistinctOrderedPrimeTriple q k r
            (progressionUnitRepresentative q k v)) : ℕ) : ℚ_[ell])) =
      ∑ v : (ProgressionQuotient q k)ˣ,
        (((2 * r) ^ 3 * Fintype.card
          (CongruentDistinctOrderedPrimeTriple q k r
            (progressionUnitRepresentative q k v)) : ℕ) : ℂ) := by
    apply Finset.sum_congr rfl
    intro v _hv
    exact map_natCast sigma _
  simp only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at hsum
  rw [hsum]
  ring

noncomputable def progressionProperPairPointTrace
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (u : (ProgressionQuotient q k)ˣ)
    (pi : Fin 2 → Equiv.Perm (Fin (2 * r))) : ℚ_[ell] :=
  properPairResidueFiberDistinctPointTrace
    q (2 * r) (k ^ 2) ell
    (modulusProduct q k)
    (progressionUnitRepresentative q k u %ₘ modulusProduct q k)
    (modulusProduct_monic q k) pi

theorem progressionProperPairPointTrace_virtualAverage_eq
    (q k r ell : ℕ) [Fact q.Prime] [Fact ell.Prime]
    (hk : 1 ≤ k) (hr : 1 ≤ r) (u : (ProgressionQuotient q k)ˣ) :
    normalizedWeightedAverage ℚ_[ell]
        (Fin 2 → Equiv.Perm (Fin (2 * r)))
        (fun pi =>
