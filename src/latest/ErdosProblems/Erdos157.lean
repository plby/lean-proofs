instance fullResidueUnitFiberBlockwiseDistinct_isAffine
    (K : Type u) [Field K]
    (d m : ℕ) (g : Polynomial K) (hg : g.Monic)
    (hdeg : g.natDegree = m) (hm : 0 < m) (hmn : m ≤ 3 * d)
