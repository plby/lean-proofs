other pair strata follow by permutation and the diagonal follows by CRT. -/
theorem erdos_157_of_sawinPrime_allAndOnePair
    (hsawin :
      SawinSpecialization.HasSawinLemma914AllAndOnePairAverageBounds
        sawinPrime) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  apply erdos_157_of_sawinPrime_theorem17AverageFactorizationDeviation
  exact SawinSpecialization.hasSawinTheorem17Average_of_allAndOnePair
    sawinPrime hsawin

/-- Assembly from the two explicit nontrivial-character expressions
`S₁³` and `S₂S₁-S₃`. -/
theorem erdos_157_of_sawinPrime_allAndOnePairCharacterCancellation
    (hsawin :
      SawinSpecialization.HasSawinLemma914AllAndOnePairCharacterCancellation
        sawinPrime) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  apply erdos_157_of_sawinPrime_allAndOnePair
  exact
    SawinSpecialization.hasSawinLemma914AllAndOnePairAverageBounds_of_characterCancellation
      sawinPrime hsawin

/-- Assembly from Frobenius matrices for the two literal character errors.
At this point the only remaining input is the geometric trace/weight/rank
construction itself; all arithmetic and probabilistic consequences are
kernel checked. -/
theorem erdos_157_of_sawinPrime_allAndOnePairCharacterFrobenius
    (hgeom :
      SawinSpecialization.HasSawinLemma914AllAndOnePairCharacterFrobeniusData
        sawinPrime) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  apply erdos_157_of_sawinPrime_allAndOnePairCharacterCancellation
  exact
    SawinSpecialization.hasSawinLemma914AllAndOnePairCharacterCancellation_of_frobeniusData
      sawinPrime hgeom

/-- Assembly before choosing cohomology bases: two explicit three-term
Frobenius complexes, their trace identities, Deligne root bounds, top-degree
vanishing, and the characteristic-cycle rank estimate imply Problem 157. -/
theorem erdos_157_of_sawinPrime_allAndOnePairCharacterCochain
    (hgeom :
      SawinSpecialization.HasSawinLemma914AllAndOnePairCharacterCochainData
        sawinPrime) :
    ∃ S : Set ℕ,
      S.Infinite ∧ IsSidon S ∧ IsAsymptoticBasisOfOrderThree S := by
  apply erdos_157_of_sawinPrime_allAndOnePairCharacterFrobenius
  exact
    SawinSpecialization.hasSawinLemma914AllAndOnePairCharacterFrobeniusData_of_cochainData
      sawinPrime hgeom

/-- Shortest remaining geometric entry point: centered Frobenius trace data
for only the unsieved family and one representative proper-pair family. -/
theorem erdos_157_of_sawinPrime_allAndOnePairFrobenius
    (hgeom :
      SawinSpecialization.HasSawinLemma914AllAndOnePairFrobeniusData
        sawinPrime) :
    ∃ S : Set ℕ,
