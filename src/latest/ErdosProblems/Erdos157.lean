  convert congrArg (fun k => (Q.obj.map k.op).hom y)
    (baseChangeUnitComponentIsoExplicit_comp_between f g U.unop) using 1
  · simp [Functor.map_comp]
    rfl
  · simp [Functor.map_comp]
/-- The normalized forward pullback composition comparison conjugates to the
already established right-adjoint comparison. -/
theorem baseChangeSheafPullbackCompNormalizedMateIso_conjugate_inv
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    CategoryTheory.conjugateEquiv
      ((baseChangeSheafAdjunctionOfIsoUnitNormalized f).comp
        (baseChangeSheafAdjunctionOfIsoUnitNormalized g))
      (baseChangeSheafAdjunctionOfIsoUnitNormalized (f ≫ g))
      (baseChangeSheafPullbackCompNormalizedMateIso f g).inv =
        (baseChangeSheafPushforwardCompInv f g).inv := by
  exact Adjunction.conjugateEquiv_leftAdjointCompIso_inv _ _ _ _

theorem baseChangeSheafPullbackCompNormalizedMateIso_conjugate_hom
    {X : Scheme.{u}} (f g : X ⟶ X) [IsIso f] [IsIso g] :
    CategoryTheory.conjugateEquiv
      (baseChangeSheafAdjunctionOfIsoUnitNormalized (f ≫ g))
      ((baseChangeSheafAdjunctionOfIsoUnitNormalized f).comp
        (baseChangeSheafAdjunctionOfIsoUnitNormalized g))
      (baseChangeSheafPullbackCompNormalizedMateIso f g).hom =
        (baseChangeSheafPushforwardCompInv f g).hom := by
  apply (cancel_epi (baseChangeSheafPushforwardCompInv f g).inv).1
  rw [← baseChangeSheafPullbackCompNormalizedMateIso_conjugate_inv f g]
  rw [CategoryTheory.conjugateEquiv_comp]
  simp only [Iso.hom_inv_id, CategoryTheory.conjugateEquiv_id]
  rw [baseChangeSheafPullbackCompNormalizedMateIso_conjugate_inv]
  simp

/-- Forward right-adjoint Beck--Chevalley, now formed with the explicitly
unit-normalized base-change adjunction. -/
noncomputable def equivariantBaseChangeForwardRightAdjointUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward f ⟶
      baseChangeSheafPushforward fbar ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) :=
  ((CategoryTheory.mateEquiv
    (baseChangeSheafAdjunctionOfIsoUnitNormalized fbar)
    (baseChangeSheafAdjunctionOfIsoUnitNormalized f)).symm
      (.mk _ _ _ _
        (equivariantBaseChangeRightAdjointIso j f fbar h).hom)).natTrans

noncomputable def equivariantBaseChangeForwardRightAdjointIteratedUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) ⋙
        baseChangeSheafPushforward (f ≫ g) ⟶
      baseChangeSheafPushforward (fbar ≫ gbar) ⋙
        (map j).sheafPushforwardContinuous Ab.{u + 1}
          (topology X) (topology Xbar) := by
  let J := (map j).sheafPushforwardContinuous Ab.{u + 1}
    (topology X) (topology Xbar)
  exact Functor.whiskerLeft J
          (baseChangeSheafPullbackCompNormalizedMateIso f g).inv ≫
        (Functor.associator _ _ _).inv ≫
        Functor.whiskerRight
          (equivariantBaseChangeForwardRightAdjointUnitNormalized
            j f fbar hf)
          (baseChangeSheafPushforward g) ≫
        (Functor.associator _ _ _).hom ≫
        Functor.whiskerLeft (baseChangeSheafPushforward fbar)
          (equivariantBaseChangeForwardRightAdjointUnitNormalized
            j g gbar hg) ≫
        (Functor.associator _ _ _).inv ≫
        Functor.whiskerRight
          (baseChangeSheafPullbackCompNormalizedMateIso fbar gbar).hom J

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem equivariantBaseChangeForwardRightAdjointUnitNormalized_comp
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    equivariantBaseChangeForwardRightAdjointUnitNormalized
        j (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) =
      equivariantBaseChangeForwardRightAdjointIteratedUnitNormalized
        j f g fbar gbar hf hg := by
  let af := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointUnitNormalized j f fbar hf)
  let ag := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointUnitNormalized j g gbar hg)
  let ai := (CategoryTheory.TwoSquare.vComp af ag).whiskerRight
      (baseChangeSheafPullbackCompNormalizedMateIso f g).inv |>.whiskerLeft
      (baseChangeSheafPullbackCompNormalizedMateIso fbar gbar).hom
  let ad := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointUnitNormalized
      j (f ≫ g) (fbar ≫ gbar)
        (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]))
  have hai : ai.natTrans =
      equivariantBaseChangeForwardRightAdjointIteratedUnitNormalized
        j f g fbar gbar hf hg := by
    rfl
  rw [← hai]
  change ad.natTrans = ai.natTrans
  apply (CategoryTheory.mateEquiv
    (baseChangeSheafAdjunctionOfIsoUnitNormalized (fbar ≫ gbar))
    (baseChangeSheafAdjunctionOfIsoUnitNormalized (f ≫ g))).injective
  change (CategoryTheory.mateEquiv
      (baseChangeSheafAdjunctionOfIsoUnitNormalized (fbar ≫ gbar))
      (baseChangeSheafAdjunctionOfIsoUnitNormalized (f ≫ g))) ad = _
  have had : ad =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIsoUnitNormalized (fbar ≫ gbar))
        (baseChangeSheafAdjunctionOfIsoUnitNormalized (f ≫ g))).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIso
              j (f ≫ g) (fbar ≫ gbar)
                (by rw [Category.assoc, hg, ← Category.assoc, hf,
                  Category.assoc])).hom) := by
    rfl
  rw [had, Equiv.apply_symm_apply]
  dsimp only [ai]
  rw [CategoryTheory.conjugateEquiv_mateEquiv_vcomp]
  rw [baseChangeSheafPullbackCompNormalizedMateIso_conjugate_hom]
  rw [CategoryTheory.mateEquiv_conjugateEquiv_vcomp]
  rw [baseChangeSheafPullbackCompNormalizedMateIso_conjugate_inv]
  rw [CategoryTheory.mateEquiv_hcomp]
  have haf : af =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIsoUnitNormalized fbar)
        (baseChangeSheafAdjunctionOfIsoUnitNormalized f)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIso j f fbar hf).hom) := by
    rfl
  have hag : ag =
      (CategoryTheory.mateEquiv
        (baseChangeSheafAdjunctionOfIsoUnitNormalized gbar)
        (baseChangeSheafAdjunctionOfIsoUnitNormalized g)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeRightAdjointIso j g gbar hg).hom) := by
    rfl
  rw [haf, hag]
  rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  apply CategoryTheory.TwoSquare.ext
  intro Q
  exact congr_app
    (equivariantBaseChangeRightAdjointIso_hom_comp_actual
      j f g fbar gbar hf hg) Q

/-- Extension by zero formed with the same unit-normalized base-change
adjunction as literal coefficient pullback. -/
noncomputable def lowerShriekEquivariantIsoUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    lowerShriek j ⋙ baseChangeSheafPushforward fbar ≅
      baseChangeSheafPushforward f ⋙ lowerShriek j := by
  let aLeft :=
    (lowerShriekAdjunction j).comp
      (baseChangeSheafAdjunctionOfIsoUnitNormalized fbar)
  let aRight :=
    (baseChangeSheafAdjunctionOfIsoUnitNormalized f).comp
      (lowerShriekAdjunction j)
  exact Adjunction.leftAdjointUniq
    (aLeft.ofNatIsoRight
      (equivariantBaseChangeRightAdjointIso j f fbar h))
    aRight

noncomputable def lowerShriekEquivariantIsoIteratedUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    lowerShriek j ⋙ baseChangeSheafPushforward (fbar ≫ gbar) ≅
      baseChangeSheafPushforward (f ≫ g) ⋙ lowerShriek j :=
  Functor.isoWhiskerLeft (lowerShriek j)
      (baseChangeSheafPullbackCompNormalizedMateIso fbar gbar).symm ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (lowerShriekEquivariantIsoUnitNormalized j f fbar hf)
      (baseChangeSheafPushforward gbar) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (baseChangeSheafPushforward f)
      (lowerShriekEquivariantIsoUnitNormalized j g gbar hg) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight
      (baseChangeSheafPullbackCompNormalizedMateIso f g)
      (lowerShriek j)

theorem lowerShriekEquivariantIsoUnitNormalized_inv_eq_mate
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    (lowerShriekEquivariantIsoUnitNormalized j f fbar h).inv =
      ((CategoryTheory.mateEquiv
        (lowerShriekAdjunction j) (lowerShriekAdjunction j)).symm
          (.mk _ _ _ _
            (equivariantBaseChangeForwardRightAdjointUnitNormalized
              j f fbar h))).natTrans := by
  let aLeft :=
    (lowerShriekAdjunction j).comp
      (baseChangeSheafAdjunctionOfIsoUnitNormalized fbar)
  let aRight :=
    (baseChangeSheafAdjunctionOfIsoUnitNormalized f).comp
      (lowerShriekAdjunction j)
  let theta := equivariantBaseChangeRightAdjointIso j f fbar h
  have hconj :
      (lowerShriekEquivariantIsoUnitNormalized j f fbar h).inv =
        (CategoryTheory.conjugateEquiv aLeft aRight).symm theta.hom := by
    unfold lowerShriekEquivariantIsoUnitNormalized
    dsimp only [aLeft, aRight, theta]
    ext Q
    simp [CategoryTheory.Adjunction.leftAdjointUniq,
      CategoryTheory.conjugateEquiv, CategoryTheory.mateEquiv]
  rw [hconj]
  have hi := CategoryTheory.iterated_mateEquiv_conjugateEquiv_symm
    (lowerShriekAdjunction j) (lowerShriekAdjunction j)
    (baseChangeSheafAdjunctionOfIsoUnitNormalized f)
    (baseChangeSheafAdjunctionOfIsoUnitNormalized fbar)
    (.mk _ _ _ _ theta.hom)
  exact hi.symm

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem lowerShriekEquivariantIsoUnitNormalized_comp
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar) :
    lowerShriekEquivariantIsoUnitNormalized
        j (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) =
      lowerShriekEquivariantIsoIteratedUnitNormalized
        j f g fbar gbar hf hg := by
  apply Iso.ext
  apply (Iso.inv_eq_inv _ _).mp
  let af := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointUnitNormalized j f fbar hf)
  let ag := CategoryTheory.TwoSquare.mk _ _ _ _
    (equivariantBaseChangeForwardRightAdjointUnitNormalized j g gbar hg)
  let ai := (CategoryTheory.TwoSquare.vComp af ag).whiskerRight
      (baseChangeSheafPullbackCompNormalizedMateIso f g).inv |>.whiskerLeft
      (baseChangeSheafPullbackCompNormalizedMateIso fbar gbar).hom
  have hai : ai.natTrans =
      equivariantBaseChangeForwardRightAdjointIteratedUnitNormalized
        j f g fbar gbar hf hg := by
    rfl
  let adjj := lowerShriekAdjunction j
  let bf := (CategoryTheory.mateEquiv adjj adjj).symm af
  let bg := (CategoryTheory.mateEquiv adjj adjj).symm ag
  let bi := (CategoryTheory.TwoSquare.hComp bf bg).whiskerTop
      (baseChangeSheafPullbackCompNormalizedMateIso f g).inv |>.whiskerBottom
      (baseChangeSheafPullbackCompNormalizedMateIso fbar gbar).hom
  let bd := (CategoryTheory.mateEquiv adjj adjj).symm ai
  have hbf : bf.natTrans =
      (lowerShriekEquivariantIsoUnitNormalized j f fbar hf).inv := by
    exact (lowerShriekEquivariantIsoUnitNormalized_inv_eq_mate
      j f fbar hf).symm
  have hbg : bg.natTrans =
      (lowerShriekEquivariantIsoUnitNormalized j g gbar hg).inv := by
    exact (lowerShriekEquivariantIsoUnitNormalized_inv_eq_mate
      j g gbar hg).symm
  have hbi : bi.natTrans =
      (lowerShriekEquivariantIsoIteratedUnitNormalized
        j f g fbar gbar hf hg).inv := by
    dsimp only [bi]
    apply NatTrans.ext
    funext Q
    simp only [CategoryTheory.TwoSquare.whiskerBottom_app,
      CategoryTheory.TwoSquare.whiskerTop_app,
      CategoryTheory.TwoSquare.hComp_app]
    rw [congr_app hbg ((baseChangeSheafPushforward f).obj Q),
      congr_app hbf Q]
    rfl
  have hm : (CategoryTheory.mateEquiv adjj adjj) bi = ai := by
    dsimp only [bi, ai]
    rw [CategoryTheory.mateEquiv_whiskerBottom]
    rw [CategoryTheory.mateEquiv_whiskerTop]
    rw [CategoryTheory.mateEquiv_vcomp]
    dsimp only [bf, bg]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  have hbd : bd = bi := by
    apply (CategoryTheory.mateEquiv adjj adjj).injective
    rw [hm]
    dsimp only [bd]
    rw [(CategoryTheory.mateEquiv _ _).apply_symm_apply]
  calc
    (lowerShriekEquivariantIsoUnitNormalized
        j (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf,
            Category.assoc])).inv = bd.natTrans := by
      rw [lowerShriekEquivariantIsoUnitNormalized_inv_eq_mate]
      rw [equivariantBaseChangeForwardRightAdjointUnitNormalized_comp
        j f g fbar gbar hf hg]
      have hsq : CategoryTheory.TwoSquare.mk _ _ _ _
          (equivariantBaseChangeForwardRightAdjointIteratedUnitNormalized
            j f g fbar gbar hf hg) = ai := by
        exact hai.symm
      exact congrArg (fun z =>
        ((CategoryTheory.mateEquiv adjj adjj).symm z).natTrans) hsq
    _ = bi.natTrans := congrArg CategoryTheory.TwoSquare.natTrans hbd
    _ = (lowerShriekEquivariantIsoIteratedUnitNormalized
        j f g fbar gbar hf hg).inv := hbi

/-- Coefficient pullback extended by zero, using the unit-normalized
Beck--Chevalley comparison. -/
noncomputable def lowerShriekEquivariantPullbackUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q) :
    (lowerShriek j).obj Q ⟶
      (baseChangeSheafPushforward fbar).obj ((lowerShriek j).obj Q) :=
  (lowerShriek j).map pullback ≫
    (lowerShriekEquivariantIsoUnitNormalized j f fbar h).inv.app Q

set_option backward.isDefEq.respectTransparency.types false in
set_option backward.defeqAttrib.useBackward true in
theorem lowerShriekEquivariantPullbackUnitNormalized_comp
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullbackF : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (pullbackG : Q ⟶ (baseChangeSheafPushforward g).obj Q) :
    lowerShriekEquivariantPullbackUnitNormalized
        j (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) Q
          (pullbackG ≫
            (baseChangeSheafPushforward g).map pullbackF ≫
            (baseChangeSheafPushforwardComp f g).hom.app Q) =
      lowerShriekEquivariantPullbackUnitNormalized
          j g gbar hg Q pullbackG ≫
        (baseChangeSheafPushforward gbar).map
          (lowerShriekEquivariantPullbackUnitNormalized
            j f fbar hf Q pullbackF) ≫
        (baseChangeSheafPushforwardComp fbar gbar).hom.app
          ((lowerShriek j).obj Q) := by
  rw [baseChangeSheafPushforwardComp_eq_normalizedMate f g,
    baseChangeSheafPushforwardComp_eq_normalizedMate fbar gbar]
  unfold lowerShriekEquivariantPullbackUnitNormalized
  rw [lowerShriekEquivariantIsoUnitNormalized_comp
    j f g fbar gbar hf hg]
  unfold lowerShriekEquivariantIsoIteratedUnitNormalized
  simp only [Functor.map_comp, Iso.trans_inv, Iso.symm_inv,
    Functor.isoWhiskerLeft_inv, Functor.isoWhiskerRight_inv,
    Functor.associator_hom_app, Functor.associator_inv_app,
    Functor.whiskerLeft_app, Functor.whiskerRight_app,
    NatTrans.comp_app]
  simp only [Category.assoc]
  slice_lhs 3 4 =>
    rw [← (lowerShriek j).map_comp, Iso.hom_inv_id_app]
    simp
  simp only [Category.comp_id, Category.id_comp]
  slice_lhs 2 3 =>
    exact (lowerShriekEquivariantIsoUnitNormalized
      j g gbar hg).inv.naturality pullbackF
  simp only [Functor.comp_map, Category.assoc]

/-- The normalized compact-support pullback of the rational coefficient
sheaf. -/
noncomputable def qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportSheaf j ell ⟶
      (baseChangeSheafPushforward fbar).obj
        (qEllAdicCompactSupportSheaf j ell) :=
  lowerShriekEquivariantPullbackUnitNormalized j f fbar h
    (qEllAdicSheafAbULift X ell)
    (qEllAdicCoefficientPullbackULift f ell)

theorem qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized_comp
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (ell : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
        j (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc]) ell =
      qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
          j g gbar hg ell ≫
        (baseChangeSheafPushforward gbar).map
          (qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
            j f fbar hf ell) ≫
        (baseChangeSheafPushforwardComp fbar gbar).hom.app
          (qEllAdicCompactSupportSheaf j ell) := by
  unfold qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
  rw [qEllAdicCoefficientPullbackULift_comp]
  exact lowerShriekEquivariantPullbackUnitNormalized_comp
    j f g fbar gbar hf hg (qEllAdicSheafAbULift X ell)
      (qEllAdicCoefficientPullbackULift f ell)
      (qEllAdicCoefficientPullbackULift g ell)


/-- Transport a morphism whose target varies along an equality of indices. -/
theorem dependent_hom_transport
    {C : Type*} [Category C] {α : Type*} (X : C)
    (Y : α → C) (f : (a : α) → (X ⟶ Y a))
    {a b : α} (h : a = b) :
    f b = f a ≫ eqToHom (congrArg Y h) := by
  subst b
  simp

/-- The one-open and four-corner normalized lower-shriek comparisons agree
when the two open immersions are the same. -/
theorem lowerShriekEquivariantIsoUnitNormalized_eq_between
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar) :
    lowerShriekEquivariantIsoUnitNormalized j f fbar h =
      lowerShriekEquivariantIsoBetweenUnitNormalized j j f fbar h := by
  rfl

/-- Composing identity base change on the source with another base change
recovers the explicit identity comparison after sheaf pushforward. -/
theorem baseChangeSheafPushforwardComp_id_left_inv
    {X Y : Scheme.{u}} (f : X ⟶ Y)
    (Q : Sheaf (topology X) Ab) :
    (baseChangeSheafPushforwardComp (𝟙 X) f).inv.app Q =
      (baseChangeSheafPushforward f).map
        ((baseChangeSheafPushforwardId X).inv.app Q) := by
  ext U x
  change (Q.obj.map (((baseChangeComp (𝟙 X) f).inv.app U.unop).op)).hom x =
    (Q.obj.map (((baseChangeId X).hom.app
      ((baseChange f).obj U.unop)).op)).hom x
  congr 2
  apply congrArg Q.obj.map
  congr 1
  apply MorphismProperty.Over.Hom.ext
  apply pullback.hom_ext
  · exact baseChangeCompOfEq_inv_app_left_fst
      (𝟙 X) f ((𝟙 X) ≫ f) rfl U.unop
  · exact (baseChangeCompOfEq_inv_app_left_snd
      (𝟙 X) f ((𝟙 X) ≫ f) rfl U.unop).trans
        (MorphismProperty.Over.w
          ((baseChangeId X).hom.app ((baseChange f).obj U.unop))).symm

/-- Composing another base change with identity base change on the target
recovers the explicit target identity comparison after sheaf pushforward. -/
theorem baseChangeSheafPushforwardComp_id_right_inv
    {X Y : Scheme.{u}} (f : X ⟶ Y)
    (Q : Sheaf (topology X) Ab) :
    (baseChangeSheafPushforwardComp f (𝟙 Y)).inv.app Q =
      (baseChangeSheafPushforwardId Y).inv.app
        ((baseChangeSheafPushforward f).obj Q) := by
  ext U x
  change (Q.obj.map (((baseChangeComp f (𝟙 Y)).inv.app U.unop).op)).hom x =
    (Q.obj.map (((baseChange f).map
      ((baseChangeId Y).hom.app U.unop)).op)).hom x
  congr 2
  apply congrArg Q.obj.map
  congr 1
  apply MorphismProperty.Over.Hom.ext
  apply pullback.hom_ext
  · exact (baseChangeCompOfEq_inv_app_left_fst
      f (𝟙 Y) (f ≫ 𝟙 Y) rfl U.unop).trans
        (baseChange_map_left_fst f
          ((baseChangeId Y).hom.app U.unop)).symm
  · exact (baseChangeCompOfEq_inv_app_left_snd
      f (𝟙 Y) (f ≫ 𝟙 Y) rfl U.unop).trans
        (MorphismProperty.Over.w
          ((baseChange f).map ((baseChangeId Y).hom.app U.unop))).symm

/-- Rational ell-adic coefficient pullback is natural across a commuting
square of scheme isomorphisms, including the chosen composition comparison. -/
theorem qEllAdicCoefficientPullbackULift_commuting_iso
    {X Y : Scheme.{u}} (e : X ≅ Y)
    (fX : X ⟶ X) [IsIso fX] (fY : Y ⟶ Y) [IsIso fY]
    (h : fX ≫ e.hom = e.hom ≫ fY)
    (ell : ℕ) [Fact ell.Prime] :
    let C : qEllAdicSheafAbULift Y ell ≅
        (baseChangeSheafPushforward e.hom).obj
          (qEllAdicSheafAbULift X ell) :=
      (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
        (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
          (baseChangeIsHomeomorph_of_isIso e.hom))
    C.inv ≫ qEllAdicCoefficientPullbackULift fY ell ≫
        (baseChangeSheafPushforward fY).map C.hom ≫
        (baseChangeSheafPushforwardComp e.hom fY).hom.app
          (qEllAdicSheafAbULift X ell) =
      (baseChangeSheafPushforward e.hom).map
          (qEllAdicCoefficientPullbackULift fX ell) ≫
        (baseChangeSheafPushforwardComp fX e.hom).hom.app
          (qEllAdicSheafAbULift X ell) ≫
        eqToHom (congrArg
          (fun k : X ⟶ Y =>
            (baseChangeSheafPushforward k).obj
              (qEllAdicSheafAbULift X ell)) h) := by
  let C : qEllAdicSheafAbULift Y ell ≅
      (baseChangeSheafPushforward e.hom).obj
        (qEllAdicSheafAbULift X ell) :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
        (baseChangeIsHomeomorph_of_isIso e.hom))
  change C.inv ≫ qEllAdicCoefficientPullbackULift fY ell ≫
        (baseChangeSheafPushforward fY).map C.hom ≫
        (baseChangeSheafPushforwardComp e.hom fY).hom.app
          (qEllAdicSheafAbULift X ell) =
      (baseChangeSheafPushforward e.hom).map
          (qEllAdicCoefficientPullbackULift fX ell) ≫
        (baseChangeSheafPushforwardComp fX e.hom).hom.app
          (qEllAdicSheafAbULift X ell) ≫
        eqToHom (congrArg
          (fun k : X ⟶ Y =>
            (baseChangeSheafPushforward k).obj
              (qEllAdicSheafAbULift X ell)) h)
  have hC : C.hom = qEllAdicCoefficientPullbackULift e.hom ell := rfl
  have h1 := qEllAdicCoefficientPullbackULift_comp e.hom fY ell
  have h2 := qEllAdicCoefficientPullbackULift_comp fX e.hom ell
  apply (cancel_epi C.hom).1
  rw [← Category.assoc, Iso.hom_inv_id, Category.id_comp]
  rw [hC]
  rw [← h1]
  slice_rhs 1 3 =>
    rw [← h2]
  exact dependent_hom_transport
    (qEllAdicSheafAbULift Y ell)
    (fun k : X ⟶ Y =>
      (baseChangeSheafPushforward k).obj
        (qEllAdicSheafAbULift X ell))
    (fun k => qEllAdicCoefficientPullbackULift k ell) h

/-- The four-corner compact-support transport intertwines the normalized
Frobenius pullbacks on the two isomorphic open schemes. -/
theorem
    qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized_frobenius
    {X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    [IsOpenImmersion j]
    (fX : X ⟶ X) [IsIso fX]
    (fY : Y ⟶ Y) [IsIso fY]
    (fZ : Z ⟶ Z) [IsIso fZ]
    (hX : fX ≫ (e.hom ≫ j) = (e.hom ≫ j) ≫ fZ)
    (hY : fY ≫ j = j ≫ fZ)
    (hcomm : fX ≫ e.hom = e.hom ≫ fY)
    (ell : ℕ) [Fact ell.Prime] :
    (qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
        e j ell).hom ≫
      qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
        j fY fZ hY ell =
    qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
        (e.hom ≫ j) fX fZ hX ell ≫
      (baseChangeSheafPushforward fZ).map
        (qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
          e j ell).hom := by
  let QX := qEllAdicSheafAbULift X ell
  let QY := qEllAdicSheafAbULift Y ell
  let ux := qEllAdicCoefficientPullbackULift fX ell
  let uy := qEllAdicCoefficientPullbackULift fY ell
  let C : QY ≅ (baseChangeSheafPushforward e.hom).obj QX :=
    (sheafCompose (topology Y) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph e.hom ell
        (baseChangeIsHomeomorph_of_isIso e.hom))
  let BE := lowerShriekEquivariantIsoBetweenUnitNormalized
    (e.hom ≫ j) j e.hom (𝟙 Z) (by simp)
  let BX := lowerShriekEquivariantIsoUnitNormalized
    (e.hom ≫ j) fX fZ hX
  let BY := lowerShriekEquivariantIsoUnitNormalized j fY fZ hY
  let J := baseChangeSheafPushforwardId Z
  change J.inv.app ((lowerShriek (e.hom ≫ j)).obj QX) ≫
        BE.hom.app QX ≫ (lowerShriek j).map C.inv ≫
        (lowerShriek j).map uy ≫ BY.inv.app QY =
      (lowerShriek (e.hom ≫ j)).map ux ≫ BX.inv.app QX ≫
        (baseChangeSheafPushforward fZ).map
          (J.inv.app ((lowerShriek (e.hom ≫ j)).obj QX) ≫
            BE.hom.app QX ≫ (lowerShriek j).map C.inv)
  apply (cancel_mono (BY.hom.app QY)).1
  simp only [Category.assoc, Iso.inv_hom_id_app, Category.comp_id]
  apply (cancel_mono ((lowerShriek j).map
    ((baseChangeSheafPushforward fY).map C.hom))).1
  apply (cancel_mono ((lowerShriek j).map
    ((baseChangeSheafPushforwardComp e.hom fY).hom.app QX))).1
  slice_lhs 4 5 => exact Category.comp_id _
  slice_lhs 3 6 =>
    rw [← (lowerShriek j).map_comp, ← (lowerShriek j).map_comp,
      ← (lowerShriek j).map_comp]
  have hcoef := qEllAdicCoefficientPullbackULift_commuting_iso
    e fX fY hcomm ell
  change C.inv ≫ uy ≫
      (baseChangeSheafPushforward fY).map C.hom ≫
      (baseChangeSheafPushforwardComp e.hom fY).hom.app QX = _ at hcoef
  rw [hcoef]
  simp only [Functor.map_comp]
  have hn := BY.hom.naturality C.inv
  simp only [Functor.comp_map] at hn
  slice_rhs 5 6 => exact hn
  slice_rhs 6 7 =>
    rw [← (lowerShriek j).map_comp,
      ← (baseChangeSheafPushforward fY).map_comp]
    simp
  slice_rhs 6 7 => exact Category.id_comp _
  have hJ := J.inv.naturality ((lowerShriek (e.hom ≫ j)).map ux)
  simp only [Functor.id_obj, Functor.id_map] at hJ
  have hBE := BE.hom.naturality ux
  simp only [Functor.comp_map] at hBE
  slice_lhs 2 3 => rw [← hBE]
  slice_lhs 1 2 => rw [← hJ]
  have hE : e.hom ≫ j = (e.hom ≫ j) ≫ 𝟙 Z := by simp
  have hA := congr_app (congrArg Iso.hom
    (lowerShriekEquivariantIsoBetweenUnitNormalized_comp
      (e.hom ≫ j) j j e.hom fY (𝟙 Z) fZ hE hY)) QX
  have hI : e.hom ≫ j = (e.hom ≫ j) ≫ 𝟙 Z := by simp
  have hB := congr_app (congrArg Iso.hom
    (lowerShriekEquivariantIsoBetweenUnitNormalized_comp
      (e.hom ≫ j) (e.hom ≫ j) j fX e.hom fZ (𝟙 Z) hX hI)) QX
  dsimp only [lowerShriekEquivariantIsoBetweenIteratedUnitNormalized] at hA hB
  simp only [Iso.trans_hom, Iso.symm_hom,
    Functor.isoWhiskerLeft_hom, Functor.isoWhiskerRight_hom,
    Functor.associator_hom_app, Functor.associator_inv_app,
    Functor.whiskerLeft_app, Functor.whiskerRight_app,
    NatTrans.comp_app, Category.assoc] at hA hB
  simp_rw [← baseChangeSheafPushforwardComp_eq_normalizedMate_between] at hA hB
  simp only [Category.id_comp, Category.comp_id,
    Category.comp_id, Category.id_comp] at hA hB
  rw [baseChangeSheafPushforwardComp_id_left_inv] at hA
  rw [baseChangeSheafPushforwardComp_id_right_inv] at hB
  rw [← lowerShriekEquivariantIsoUnitNormalized_eq_between] at hA hB
  change (lowerShriekEquivariantIsoBetweenUnitNormalized
      (e.hom ≫ j) j (e.hom ≫ fY) fZ (by
        rw [Category.assoc, hY, ← Category.assoc, hE])).hom.app QX = _ at hA
  change (lowerShriekEquivariantIsoBetweenUnitNormalized
      (e.hom ≫ j) j (fX ≫ e.hom) fZ hX).hom.app QX = _ at hB
  have hAeq : (e.hom ≫ fY) ≫ j = (e.hom ≫ j) ≫ fZ := by
    rw [Category.assoc, hY, ← Category.assoc]
  let A : {k : X ⟶ Y // IsIso k ∧ k ≫ j = (e.hom ≫ j) ≫ fZ} :=
    ⟨e.hom ≫ fY, inferInstance, hAeq⟩
  let B : {k : X ⟶ Y // IsIso k ∧ k ≫ j = (e.hom ≫ j) ≫ fZ} :=
    ⟨fX ≫ e.hom, inferInstance, hX⟩
  have hBA : B = A := Subtype.ext hcomm
  let D (s : {k : X ⟶ Y // IsIso k ∧
      k ≫ j = (e.hom ≫ j) ≫ fZ}) := by
    letI : IsIso s.1 := s.2.1
    exact (lowerShriekEquivariantIsoBetweenUnitNormalized
      (e.hom ≫ j) j s.1 fZ s.2.2).hom.app QX
  have htransport := dependent_hom_transport
    ((baseChangeSheafPushforward fZ).obj
      ((lowerShriek (e.hom ≫ j)).obj QX))
    (fun s : {k : X ⟶ Y // IsIso k ∧
        k ≫ j = (e.hom ≫ j) ≫ fZ} =>
      (lowerShriek j).obj
        ((baseChangeSheafPushforward s.1).obj QX))
    D hBA
  have hD :
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        (e.hom ≫ j) j (e.hom ≫ fY) fZ hAeq).hom.app QX =
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        (e.hom ≫ j) j (fX ≫ e.hom) fZ hX).hom.app QX ≫
        (lowerShriek j).map (eqToHom (congrArg
          (fun k : X ⟶ Y =>
            (baseChangeSheafPushforward k).obj QX) hcomm)) := by
    simpa only [D, A, B, eqToHom_map] using htransport
  have hBnorm :
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        (e.hom ≫ j) j (fX ≫ e.hom) fZ hX).hom.app QX =
      J.inv.app ((baseChangeSheafPushforward fZ).obj
          ((lowerShriek (e.hom ≫ j)).obj QX)) ≫
        (baseChangeSheafPushforward (𝟙 Z)).map (BX.hom.app QX) ≫
        BE.hom.app ((baseChangeSheafPushforward fX).obj QX) ≫
        (lowerShriek j).map
          ((baseChangeSheafPushforwardComp fX e.hom).hom.app QX) := by
    convert hB using 1 <;> rfl
  have hAnorm :
      (lowerShriekEquivariantIsoBetweenUnitNormalized
        (e.hom ≫ j) j (e.hom ≫ fY) fZ hAeq).hom.app QX =
      (baseChangeSheafPushforward fZ).map
          (J.inv.app ((lowerShriek (e.hom ≫ j)).obj QX)) ≫
        (baseChangeSheafPushforward fZ).map (BE.hom.app QX) ≫
        BY.hom.app ((baseChangeSheafPushforward e.hom).obj QX) ≫
        (lowerShriek j).map
          ((baseChangeSheafPushforwardComp e.hom fY).hom.app QX) := by
    convert hA using 1 <;> rfl
  have htail :
      J.inv.app ((lowerShriek (e.hom ≫ j)).obj
          ((baseChangeSheafPushforward fX).obj QX)) ≫
        BE.hom.app ((baseChangeSheafPushforward fX).obj QX) ≫
        (lowerShriek j).map
          ((baseChangeSheafPushforwardComp fX e.hom).hom.app QX) ≫
        (lowerShriek j).map (eqToHom (congrArg
          (fun k : X ⟶ Y =>
            (baseChangeSheafPushforward k).obj QX) hcomm)) =
      BX.inv.app QX ≫
        (baseChangeSheafPushforward fZ).map
          (J.inv.app ((lowerShriek (e.hom ≫ j)).obj QX)) ≫
        (baseChangeSheafPushforward fZ).map (BE.hom.app QX) ≫
        BY.hom.app ((baseChangeSheafPushforward e.hom).obj QX) ≫
        (lowerShriek j).map
          ((baseChangeSheafPushforwardComp e.hom fY).hom.app QX) := by
    apply (cancel_epi (BX.hom.app QX)).1
    slice_rhs 1 2 => rw [Iso.hom_inv_id_app]
    rw [Category.id_comp]
    have hJB := J.inv.naturality (BX.hom.app QX)
    simp only [Functor.id_map] at hJB
    slice_lhs 1 2 => exact hJB
    slice_lhs 1 4 => exact hBnorm.symm
    slice_lhs 1 2 => exact hD.symm
    slice_rhs 1 4 => exact hAnorm.symm
  simpa only [Category.assoc] using congrArg
    (fun k => (lowerShriek (e.hom ≫ j)).map ux ≫ k) htail

/-- The cohomology endomorphism obtained from normalized extension by zero. -/
noncomputable def qEllAdicCompactSupportCohomologyActionUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    (qEllAdicCompactSupportSheaf j ell).H degree →+
      (qEllAdicCompactSupportSheaf j ell).H degree :=
  sheafCohomologyPullbackEndomorphismOfIso fbar
    (qEllAdicCompactSupportSheaf j ell)
    (qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
      j f fbar h ell) degree

theorem qEllAdicCompactSupportCohomologyActionUnitNormalized_comp
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportCohomologyActionUnitNormalized
        j (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])
          ell degree =
      (qEllAdicCompactSupportCohomologyActionUnitNormalized
        j f fbar hf ell degree).comp
      (qEllAdicCompactSupportCohomologyActionUnitNormalized
        j g gbar hg ell degree) := by
  ext x
  unfold qEllAdicCompactSupportCohomologyActionUnitNormalized
    sheafCohomologyPullbackEndomorphismOfIso
  simp only [AddMonoidHom.comp_apply]
  rw [qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized_comp]
  simp only [Sheaf.H.map_comp_apply]
  change
    (baseChangeSheafCohomologyAddEquivOfIso
      (fbar ≫ gbar) (qEllAdicCompactSupportSheaf j ell) degree).symm
        (Sheaf.H.map ((baseChangeSheafPushforwardComp fbar gbar).hom.app
          (qEllAdicCompactSupportSheaf j ell)) degree
          (Sheaf.H.map ((baseChangeSheafPushforward gbar).map
            (qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
              j f fbar hf ell)) degree
            (Sheaf.H.map
              (qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
                j g gbar hg ell) degree x))) = _
  rw [baseChangeSheafCohomologyAddEquivOfIso_symm_comp]
  rw [baseChangeSheafCohomologyAddEquivOfIso_symm_naturality]
  rfl

theorem lowerShriekEquivariantPullbackUnitNormalized_naturality
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [WeaklyEtale j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (Q : Sheaf (topology X) Ab.{u + 1})
    (pullback : Q ⟶ (baseChangeSheafPushforward f).obj Q)
    (s : Q ⟶ Q)
    (hs : s ≫ pullback =
      pullback ≫ (baseChangeSheafPushforward f).map s) :
    (lowerShriek j).map s ≫
        lowerShriekEquivariantPullbackUnitNormalized
          j f fbar h Q pullback =
      lowerShriekEquivariantPullbackUnitNormalized
          j f fbar h Q pullback ≫
        (baseChangeSheafPushforward fbar).map ((lowerShriek j).map s) := by
  unfold lowerShriekEquivariantPullbackUnitNormalized
  rw [← Category.assoc, ← (lowerShriek j).map_comp, hs,
    (lowerShriek j).map_comp, Category.assoc]
  have hn :
      (lowerShriek j).map
          ((baseChangeSheafPushforward f).map s) ≫
          (lowerShriekEquivariantIsoUnitNormalized
            j f fbar h).inv.app Q =
        (lowerShriekEquivariantIsoUnitNormalized
            j f fbar h).inv.app Q ≫
          (baseChangeSheafPushforward fbar).map
            ((lowerShriek j).map s) := by
    simpa only [Functor.comp_map] using
      (lowerShriekEquivariantIsoUnitNormalized
        j f fbar h).inv.naturality s
  rw [hn]
  rw [Category.assoc]

theorem qEllAdicCompactSupportCohomologyActionUnitNormalized_scalar
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] (r : ℚ_[ell])
    (x : (qEllAdicCompactSupportSheaf j ell).H degree) :
    qEllAdicCompactSupportCohomologyActionUnitNormalized
        j f fbar h ell degree
        (Sheaf.H.map (qEllAdicCompactSupportScalar j ell r) degree x) =
      Sheaf.H.map (qEllAdicCompactSupportScalar j ell r) degree
        (qEllAdicCompactSupportCohomologyActionUnitNormalized
          j f fbar h ell degree x) := by
  unfold qEllAdicCompactSupportCohomologyActionUnitNormalized
  apply sheafCohomologyPullbackEndomorphismOfIso_naturality
  exact lowerShriekEquivariantPullbackUnitNormalized_naturality
    j f fbar h (qEllAdicSheafAbULift X ell)
      (qEllAdicCoefficientPullbackULift f ell)
      (qEllAdicSheafAbScalarULift X ell r)
      (qEllAdicCoefficientPullbackULift_scalar f ell r)

noncomputable def qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    CompactlySupportedQEllAdicCohomology j pbar ell degree →ₗ[ℚ_[ell]]
      CompactlySupportedQEllAdicCohomology j pbar ell degree where
  toFun := qEllAdicCompactSupportCohomologyActionUnitNormalized
    j f fbar h ell degree
  map_add' :=
    (qEllAdicCompactSupportCohomologyActionUnitNormalized
      j f fbar h ell degree).map_add
  map_smul' := by
    intro r x
    exact qEllAdicCompactSupportCohomologyActionUnitNormalized_scalar
      j f fbar h ell degree r x

theorem qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_comp
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar (f ≫ g) (fbar ≫ gbar)
          (by rw [Category.assoc, hg, ← Category.assoc, hf, Category.assoc])
          ell degree =
      (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar f fbar hf ell degree).comp
      (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar g gbar hg ell degree) := by
  ext x
  change
    qEllAdicCompactSupportCohomologyActionUnitNormalized
        j (f ≫ g) (fbar ≫ gbar) _ ell degree x =
      qEllAdicCompactSupportCohomologyActionUnitNormalized
        j f fbar hf ell degree
        (qEllAdicCompactSupportCohomologyActionUnitNormalized
          j g gbar hg ell degree x)
  exact DFunLike.congr_fun
    (qEllAdicCompactSupportCohomologyActionUnitNormalized_comp
      j f g fbar gbar hf hg ell degree) x

/-- Compact-support cohomology transport across an open isomorphism
intertwines the normalized actions attached to a commuting square of
automorphisms. -/
theorem
    qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized_map_action
    {S X Y Z : Scheme.{u}} (e : X ≅ Y) (j : Y ⟶ Z)
    (p : Z ⟶ S) [IsOpenImmersion j] [IsProper p]
    (fX : X ⟶ X) [IsIso fX]
    (fY : Y ⟶ Y) [IsIso fY]
    (fZ : Z ⟶ Z) [IsIso fZ]
    (hX : fX ≫ (e.hom ≫ j) = (e.hom ≫ j) ≫ fZ)
    (hY : fY ≫ j = j ≫ fZ)
    (hcomm : fX ≫ e.hom = e.hom ≫ fY)
    (ell degree : ℕ) [Fact ell.Prime]
    (x : CompactlySupportedQEllAdicCohomology
      (e.hom ≫ j) p ell degree) :
    qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized
        e j p ell degree
        (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
          (e.hom ≫ j) p fX fZ hX ell degree x) =
      qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j p fY fZ hY ell degree
        (qEllAdicCompactSupportCohomologyLinearEquivOfOpenIsoSquareUnitNormalized
          e j p ell degree x) := by
  let E := qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized
    e j ell
  change Sheaf.H.map E.hom degree
      (qEllAdicCompactSupportCohomologyActionUnitNormalized
        (e.hom ≫ j) fX fZ hX ell degree x) =
    qEllAdicCompactSupportCohomologyActionUnitNormalized
      j fY fZ hY ell degree (Sheaf.H.map E.hom degree x)
  exact (sheafCohomologyPullbackEndomorphismOfIso_naturality_between
    fZ
    (qEllAdicCompactSupportSheaf (e.hom ≫ j) ell)
    (qEllAdicCompactSupportSheaf j ell)
    (qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
      (e.hom ≫ j) fX fZ hX ell)
    (qEllAdicCompactSupportPullbackOfEquivariantIsoUnitNormalized
      j fY fZ hY ell)
    E.hom
    (qEllAdicCompactSupportSheafIsoOfOpenIsoSquareUnitNormalized_frobenius
      e j fX fY fZ hX hY hcomm ell)
    degree x).symm

noncomputable def qEllAdicCompactSupportPullbackUnitNormalizedIso
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportSheaf j ell ≅
      (baseChangeSheafPushforward fbar).obj
        (qEllAdicCompactSupportSheaf j ell) := by
  let eCoeff :=
    (sheafCompose (topology X) AddCommGrpCat.uliftFunctor.{u + 1}).mapIso
      (qEllAdicCoefficientComparisonIsoOfHomeomorph f ell
        (baseChangeIsHomeomorph_of_isIso f))
  exact (lowerShriek j).mapIso eCoeff ≪≫
    (lowerShriekEquivariantIsoUnitNormalized j f fbar h).symm.app
      (qEllAdicSheafAbULift X ell)

noncomputable def qEllAdicCompactSupportCohomologyAddEquivUnitNormalized
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    (qEllAdicCompactSupportSheaf j ell).H degree ≃+
      (qEllAdicCompactSupportSheaf j ell).H degree := by
  let pIso := qEllAdicCompactSupportPullbackUnitNormalizedIso
    j f fbar h ell
  let eH : (qEllAdicCompactSupportSheaf j ell).H degree ≃+
      ((baseChangeSheafPushforward fbar).obj
        (qEllAdicCompactSupportSheaf j ell)).H degree :=
    { toFun := Sheaf.H.map pIso.hom degree
      invFun := Sheaf.H.map pIso.inv degree
      left_inv := by
        intro x
        rw [← Sheaf.H.map_comp_apply]
        simp [pIso]
      right_inv := by
        intro x
        rw [← Sheaf.H.map_comp_apply]
        simp [pIso]
      map_add' := (Sheaf.H.map pIso.hom degree).map_add }
  exact eH.trans
    (baseChangeSheafCohomologyAddEquivOfIso fbar
      (qEllAdicCompactSupportSheaf j ell) degree).symm

theorem qEllAdicCompactSupportCohomologyAddEquivUnitNormalized_apply
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime]
    (x : (qEllAdicCompactSupportSheaf j ell).H degree) :
    qEllAdicCompactSupportCohomologyAddEquivUnitNormalized
        j f fbar h ell degree x =
      qEllAdicCompactSupportCohomologyActionUnitNormalized
        j f fbar h ell degree x := by
  rfl

theorem qEllAdicCompactSupportCohomologyActionUnitNormalized_surjective
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    Function.Surjective
      (qEllAdicCompactSupportCohomologyActionUnitNormalized
        j f fbar h ell degree) := by
  intro x
  let e := qEllAdicCompactSupportCohomologyAddEquivUnitNormalized
    j f fbar h ell degree
  exact ⟨e.symm x, by
    rw [← qEllAdicCompactSupportCohomologyAddEquivUnitNormalized_apply]
    exact e.apply_symm_apply x⟩

theorem qEllAdicCompactSupportCohomologyActionUnitNormalized_id
    {X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) [IsOpenImmersion j]
    (ell degree : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportCohomologyActionUnitNormalized
        j (𝟙 X) (𝟙 Xbar) (by simp) ell degree =
      AddMonoidHom.id _ := by
  let A := qEllAdicCompactSupportCohomologyActionUnitNormalized
    j (𝟙 X) (𝟙 Xbar) (by simp) ell degree
  have hcomp : A = A.comp A := by
    simpa only [Category.comp_id] using
      qEllAdicCompactSupportCohomologyActionUnitNormalized_comp
        j (𝟙 X) (𝟙 X) (𝟙 Xbar) (𝟙 Xbar)
          (by simp) (by simp) ell degree
  have hsurj : Function.Surjective A :=
    qEllAdicCompactSupportCohomologyActionUnitNormalized_surjective
      j (𝟙 X) (𝟙 Xbar) (by simp) ell degree
  ext x
  obtain ⟨y, rfl⟩ := hsurj x
  change A (A y) = A y
  exact congrArg (fun F : _ →+ _ => F y) hcomp.symm

theorem qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_surjective
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) [IsIso f]
    (fbar : Xbar ⟶ Xbar) [IsIso fbar]
    (h : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    Function.Surjective
      (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar f fbar h ell degree) :=
  qEllAdicCompactSupportCohomologyActionUnitNormalized_surjective
    j f fbar h ell degree

theorem qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_congr
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (hfg : f = g) (hfgbar : fbar = gbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar f fbar hf ell degree =
      qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar g gbar hg ell degree := by
  subst g
  subst gbar
  rfl

theorem qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_comm_of_comm
    {S X Xbar : Scheme.{u}}
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ S)
    [IsOpenImmersion j] [IsProper pbar]
    (f g : X ⟶ X) [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar) [IsIso fbar] [IsIso gbar]
    (hf : f ≫ j = j ≫ fbar) (hg : g ≫ j = j ≫ gbar)
    (hcomm : f ≫ g = g ≫ f) (hcommbar : fbar ≫ gbar = gbar ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar f fbar hf ell degree).comp
      (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar g gbar hg ell degree) =
    (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar g gbar hg ell degree).comp
      (qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
        j pbar f fbar hf ell degree) := by
  rw [← qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_comp]
  rw [qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_congr
    j pbar (f ≫ g) (g ≫ f) (fbar ≫ gbar) (gbar ≫ fbar) _ _
      hcomm hcommbar]
  exact qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_comp
    j pbar g f gbar fbar hg hf ell degree

noncomputable def
    geometricCompactSupportCohomologyLinearMapUnitNormalized
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (f : X ⟶ X) (hf : f ≫ pX = pX) [IsIso f]
    (fbar : Xbar ⟶ Xbar) (hfbar : fbar ≫ pbar = pbar) [IsIso fbar]
    (hbar : f ≫ j = j ≫ fbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ell degree →ₗ[ℚ_[ell]]
      GeometricCompactlySupportedQEllAdicCohomology
        q pX j pbar hj ell degree :=
  qEllAdicCompactSupportCohomologyLinearMapUnitNormalized
    (geometricCompactificationOpen q pX j pbar hj)
    (geometricCompactificationProjection q pbar)
    (geometricFiberMap q pX pX f hf)
    (geometricFiberMap q pbar pbar fbar hfbar)
    (geometricCompactificationOpen_equivariant
      q pX j pbar hj f hf fbar hfbar hbar) ell degree

theorem geometricCompactSupportCohomologyLinearMapUnitNormalized_comp
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (f g : X ⟶ X) (hf : f ≫ pX = pX) (hg : g ≫ pX = pX)
    [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar)
    (hfbar : fbar ≫ pbar = pbar) (hgbar : gbar ≫ pbar = pbar)
    [IsIso fbar] [IsIso gbar]
    (hbarf : f ≫ j = j ≫ fbar) (hbarg : g ≫ j = j ≫ gbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj (f ≫ g)
          (by rw [Category.assoc, hg, hf]) (fbar ≫ gbar)
          (by rw [Category.assoc, hgbar, hfbar])
          (by rw [Category.assoc, hbarg, ← Category.assoc, hbarf,
            Category.assoc]) ell degree =
      (geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj f hf fbar hfbar hbarf ell degree).comp
      (geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj g hg gbar hgbar hbarg ell degree) := by
  unfold geometricCompactSupportCohomologyLinearMapUnitNormalized
  rw [← qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_comp]
  congr 1
  · exact (geometricFiberMap_comp q pX pX pX f g hf hg).symm
  · exact (geometricFiberMap_comp q pbar pbar pbar fbar gbar
      hfbar hgbar).symm

theorem geometricCompactSupportCohomologyLinearMapUnitNormalized_congr
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (f g : X ⟶ X) (hf : f ≫ pX = pX) (hg : g ≫ pX = pX)
    [IsIso f] [IsIso g]
    (fbar gbar : Xbar ⟶ Xbar)
    (hfbar : fbar ≫ pbar = pbar) (hgbar : gbar ≫ pbar = pbar)
    [IsIso fbar] [IsIso gbar]
    (hbarf : f ≫ j = j ≫ fbar) (hbarg : g ≫ j = j ≫ gbar)
    (hfg : f = g) (hfgbar : fbar = gbar)
    (ell degree : ℕ) [Fact ell.Prime] :
    geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj f hf fbar hfbar hbarf ell degree =
      geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj g hg gbar hgbar hbarg ell degree := by
  subst g
  subst gbar
  rfl

theorem geometricCompactSupportCohomologyLinearMapUnitNormalized_id
    {X Xbar : Scheme.{0}} (q : ℕ) [Fact q.Prime]
    (pX : X ⟶ Spec (.of (ZMod q)))
    (j : X ⟶ Xbar) (pbar : Xbar ⟶ Spec (.of (ZMod q)))
    (hj : j ≫ pbar = pX) [IsOpenImmersion j] [IsProper pbar]
    (ell degree : ℕ) [Fact ell.Prime] :
    geometricCompactSupportCohomologyLinearMapUnitNormalized
        q pX j pbar hj (𝟙 X) (by simp) (𝟙 Xbar) (by simp)
          (by simp) ell degree = LinearMap.id := by
  let A := geometricCompactSupportCohomologyLinearMapUnitNormalized
    q pX j pbar hj (𝟙 X) (by simp) (𝟙 Xbar) (by simp)
      (by simp) ell degree
  have hcomp : A = A.comp A := by
    simpa only [Category.comp_id] using
      geometricCompactSupportCohomologyLinearMapUnitNormalized_comp
        q pX j pbar hj (𝟙 X) (𝟙 X) (by simp) (by simp)
          (𝟙 Xbar) (𝟙 Xbar) (by simp) (by simp)
          (by simp) (by simp) ell degree
  have hsurj : Function.Surjective A := by
    dsimp only [A,
      geometricCompactSupportCohomologyLinearMapUnitNormalized]
    exact qEllAdicCompactSupportCohomologyLinearMapUnitNormalized_surjective
      (geometricCompactificationOpen q pX j pbar hj)
      (geometricCompactificationProjection q pbar)
      (geometricFiberMap q pX pX (𝟙 X) (by simp))
      (geometricFiberMap q pbar pbar (𝟙 Xbar) (by simp))
      (geometricCompactificationOpen_equivariant q pX j pbar hj
        (𝟙 X) (by simp) (𝟙 Xbar) (by simp) (by simp)) ell degree
  ext x
  obtain ⟨y, rfl⟩ := hsurj x
  change A (A y) = A y
  exact congrArg (fun F : _ →ₗ[ℚ_[ell]] _ => F y) hcomp.symm

end AlgebraicGeometry.Scheme.ProEt


namespace Erdos157.SawinSpecialization

/-! Zero-padding lets a varying family of geometric cohomology groups be
placed in common ambient ranks.  The extra Frobenius eigenvalues are zero,
so the trace and every nonzero spectral root are unchanged. -/

/-- Add a zero block of the indicated size to a square complex matrix. -/
noncomputable def matrixPad {r : ℕ} (extra : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) :
    Matrix (Fin (r + extra)) (Fin (r + extra)) ℂ :=
  Matrix.reindex finSumFinEquiv finSumFinEquiv
    (Matrix.fromBlocks A 0 0 0)

theorem matrixPad_trace {r : ℕ} (extra : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) :
    (matrixPad extra A).trace = A.trace := by
  unfold matrixPad Matrix.trace
  rw [← Equiv.sum_comp finSumFinEquiv]
  simp [Matrix.fromBlocks]

theorem matrixPad_charpoly {r : ℕ} (extra : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) :
    (matrixPad extra A).charpoly = A.charpoly * Polynomial.X ^ extra := by
  unfold matrixPad
  rw [Matrix.charpoly_reindex, Matrix.charpoly_fromBlocks_zero₁₂]
  simp

theorem matrixPad_root_norm_le {r : ℕ} (extra : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) (radius : ℝ) (hradius : 0 ≤ radius)
    (hroot : ∀ z, z ∈ A.charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ (matrixPad extra A).charpoly.roots → ‖z‖ ≤ radius := by
  intro z hz
  rw [matrixPad_charpoly,
    Polynomial.roots_mul (mul_ne_zero
      (Matrix.charpoly_monic A).ne_zero
      (pow_ne_zero _ Polynomial.X_ne_zero))] at hz
  rcases Multiset.mem_add.mp hz with hz | hz
  · exact hroot z hz
  · rw [Polynomial.roots_pow] at hz
    have hzX : z ∈ (Polynomial.X : Polynomial ℂ).roots :=
      Multiset.mem_of_mem_nsmul hz
    have hz0 : z = 0 := by simpa using hzX
    subst z
    simpa using hradius

/-- Enlarge either rank in a two-degree Frobenius package by adjoining zero
eigenvalues.  This is the exact linear-algebraic operation needed to replace
point-dependent Betti numbers by a uniform characteristic-cycle envelope. -/
noncomputable def TwoDegreeFrobeniusMatrices.pad
    {error : ℂ} {lowerRank upperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (data : TwoDegreeFrobeniusMatrices error lowerRank upperRank
      lowerRadius upperRadius)
    (lowerExtra upperExtra : ℕ)
    (hlowerRadius : 0 ≤ lowerRadius) (hupperRadius : 0 ≤ upperRadius) :
    TwoDegreeFrobeniusMatrices error
      (lowerRank + lowerExtra) (upperRank + upperExtra)
      lowerRadius upperRadius where
  lowerFrobenius := matrixPad lowerExtra data.lowerFrobenius
  upperFrobenius := matrixPad upperExtra data.upperFrobenius
  error_eq_trace := by
    rw [matrixPad_trace, matrixPad_trace]
    exact data.error_eq_trace
  lower_root_norm_le := matrixPad_root_norm_le lowerExtra _ _
    hlowerRadius data.lower_root_norm_le
  upper_root_norm_le := matrixPad_root_norm_le upperExtra _ _
    hupperRadius data.upper_root_norm_le

/-- Pad a certificate to prescribed larger ranks. -/
noncomputable def TwoDegreeFrobeniusMatrices.padTo
    {error : ℂ} {lowerRank upperRank targetLowerRank targetUpperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (data : TwoDegreeFrobeniusMatrices error lowerRank upperRank
      lowerRadius upperRadius)
    (hlower : lowerRank ≤ targetLowerRank)
    (hupper : upperRank ≤ targetUpperRank)
    (hlowerRadius : 0 ≤ lowerRadius) (hupperRadius : 0 ≤ upperRadius) :
    TwoDegreeFrobeniusMatrices error targetLowerRank targetUpperRank
      lowerRadius upperRadius := by
  convert data.pad (targetLowerRank - lowerRank)
    (targetUpperRank - upperRank) hlowerRadius hupperRadius using 1 <;> omega

/-- Pointwise geometric trace data with bounded, possibly varying Betti
numbers give a single uniform-rank family after adjoining zero summands. -/
noncomputable def TwoDegreeFrobeniusAverageData.ofPointwiseRankBounds
    {ι : Type*} [Fintype ι] (mass : ι → ℂ)
    (targetLowerRank targetUpperRank : ℕ)
    (lowerRadius upperRadius : ℝ)
    (hlowerRadius : 0 ≤ lowerRadius) (hupperRadius : 0 ≤ upperRadius)
    (hdata : ∀ a, ∃ lowerRank upperRank : ℕ,
      lowerRank ≤ targetLowerRank ∧ upperRank ≤ targetUpperRank ∧
        Nonempty (TwoDegreeFrobeniusMatrices (mass a)
          lowerRank upperRank lowerRadius upperRadius)) :
    TwoDegreeFrobeniusAverageData mass targetLowerRank targetUpperRank
      lowerRadius upperRadius where
  traceValue := mass
  centered_eq := fun _ ↦ rfl
  frobeniusMatrices a := by
    obtain ⟨lowerRank, upperRank, hlower, hupper, ⟨data⟩⟩ := hdata a
    exact ⟨data.padTo hlower hupper hlowerRadius hupperRadius⟩

end Erdos157.SawinSpecialization

namespace Erdos157.SawinSpecialization

/-! Replicating a geometric trace by a natural von-Mangoldt multiplicity is
implemented by block-diagonal copies.  This is needed for the proper-pair
stratum: its two ordered root cycles contribute `(2r)^2`, while the ordered
three-factor weight contributes `(2r)^3`. -/

theorem charpoly_blockDiagonal
    {p n R : Type*} [Fintype p] [DecidableEq p]
    [Fintype n] [DecidableEq n] [CommRing R]
    (M : p → Matrix n n R) :
    (Matrix.blockDiagonal M).charpoly = ∏ i, (M i).charpoly := by
  rw [Matrix.charpoly]
  have hch : (Matrix.blockDiagonal M).charmatrix =
      Matrix.blockDiagonal (fun i ↦ (M i).charmatrix) := by
    ext ⟨a, i⟩ ⟨b, j⟩
    by_cases hij : i = j
    · subst j
      by_cases hab : a = b
      · subst b
        simp [Matrix.charmatrix_apply, Matrix.blockDiagonal]
      · simp [Matrix.charmatrix_apply, Matrix.blockDiagonal,
          Matrix.diagonal_apply, hab]
    · simp [Matrix.charmatrix_apply, Matrix.blockDiagonal, hij]
  rw [hch, Matrix.det_blockDiagonal]
  unfold Matrix.charpoly
  apply Finset.prod_congr rfl
  intro i _
  rfl

/-- Tensoring an endomorphism with an identity repeats its characteristic
polynomial once for each basis vector in the identity factor.  This is the
linear-algebra bridge used to transfer Deligne bounds to the dual tensor
appearing in the character projector. -/
theorem charpoly_one_kronecker
    {p n R : Type*} [Fintype p] [DecidableEq p]
    [Fintype n] [DecidableEq n] [CommRing R]
    (A : Matrix n n R) :
    ((1 : Matrix p p R) ⊗ₖ A).charpoly =
      A.charpoly ^ Fintype.card p := by
  rw [Matrix.one_kronecker, Matrix.charpoly_reindex,
    charpoly_blockDiagonal]
  simp

/-- Basis-independent characteristic polynomial of an identity tensor an
endomorphism. -/
theorem charpoly_tensorProduct_map_id
    {K U V : Type*} [Field K]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    (F : Module.End K V) :
    (TensorProduct.map (LinearMap.id : Module.End K U) F).charpoly =
      F.charpoly ^ Module.finrank K U := by
  let bU := Module.finBasis K U
  let bV := Module.finBasis K V
  rw [← LinearMap.charpoly_toMatrix
      (TensorProduct.map (LinearMap.id : Module.End K U) F)
      (bU.tensorProduct bV),
    TensorProduct.toMatrix_map, LinearMap.toMatrix_id,
    charpoly_one_kronecker, Fintype.card_fin,
    LinearMap.charpoly_toMatrix]

/-- The preceding tensor characteristic-polynomial identity after a complex
coefficient embedding, stated in the canonical matrix coordinates used by
the Frobenius packages below. -/
theorem endomorphismMatrix_tensorProduct_map_id_charpoly
    {K U V : Type*} [Field K]
    [AddCommGroup U] [Module K U]
    [AddCommGroup V] [Module K V]
    [FiniteDimensional K U] [FiniteDimensional K V]
    (F : Module.End K V) (σ : K →+* ℂ) :
    ((endomorphismMatrixOfFinrankEq
        (TensorProduct.map (LinearMap.id : Module.End K U) F) rfl).map
      σ).charpoly =
      ((endomorphismMatrixOfFinrankEq F rfl).map σ).charpoly ^
        Module.finrank K U := by
  rw [Matrix.charpoly_map, endomorphismMatrixOfFinrankEq_charpoly,
    charpoly_tensorProduct_map_id, Polynomial.map_pow]
  congr 1
  rw [Matrix.charpoly_map, endomorphismMatrixOfFinrankEq_charpoly]

/-- A square complex matrix repeated in `copies` identical diagonal blocks,
with the product index reindexed by a standard finite ordinal. -/
noncomputable def matrixCopies {r : ℕ} (copies : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) :
    Matrix (Fin (r * copies)) (Fin (r * copies)) ℂ :=
  Matrix.reindex finProdFinEquiv finProdFinEquiv
    (Matrix.blockDiagonal (fun _ : Fin copies ↦ A))

theorem matrixCopies_trace {r : ℕ} (copies : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) :
    (matrixCopies copies A).trace = copies * A.trace := by
  unfold matrixCopies Matrix.trace
  simp only [Matrix.reindex_apply]
  change (∑ i : Fin (r * copies),
      Matrix.blockDiagonal (fun _ : Fin copies ↦ A)
        (finProdFinEquiv.symm i) (finProdFinEquiv.symm i)) = _
  rw [← Equiv.sum_comp finProdFinEquiv]
  simp only [Equiv.symm_apply_apply, Matrix.diag_apply]
  rw [Finset.mul_sum]

theorem matrixCopies_charpoly {r : ℕ} (copies : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) :
    (matrixCopies copies A).charpoly = A.charpoly ^ copies := by
  unfold matrixCopies
  rw [Matrix.charpoly_reindex, charpoly_blockDiagonal]
  simp

theorem matrixCopies_root_norm_le {r : ℕ} (copies : ℕ)
    (A : Matrix (Fin r) (Fin r) ℂ) (radius : ℝ)
    (hroot : ∀ z, z ∈ A.charpoly.roots → ‖z‖ ≤ radius) :
    ∀ z, z ∈ (matrixCopies copies A).charpoly.roots →
      ‖z‖ ≤ radius := by
  intro z hz
  rw [matrixCopies_charpoly, Polynomial.roots_pow] at hz
  exact hroot z (Multiset.mem_of_mem_nsmul hz)

/-- Block-diagonal replication multiplies a two-degree trace certificate and
its ranks by `copies`, without changing either spectral radius. -/
noncomputable def TwoDegreeFrobeniusMatrices.natCopies
    {error : ℂ} {lowerRank upperRank : ℕ}
    {lowerRadius upperRadius : ℝ}
    (data : TwoDegreeFrobeniusMatrices error lowerRank upperRank
      lowerRadius upperRadius)
    (copies : ℕ) :
    TwoDegreeFrobeniusMatrices ((copies : ℂ) * error)
      (lowerRank * copies) (upperRank * copies)
      lowerRadius upperRadius where
  lowerFrobenius := matrixCopies copies data.lowerFrobenius
  upperFrobenius := matrixCopies copies data.upperFrobenius
  error_eq_trace := by
    rw [matrixCopies_trace, matrixCopies_trace]
    calc
      (copies : ℂ) * error =
          (copies : ℂ) *
            (data.lowerFrobenius.trace + data.upperFrobenius.trace) := by
        exact congrArg (fun z : ℂ ↦ (copies : ℂ) * z)
          data.error_eq_trace
      _ = (copies : ℂ) * data.lowerFrobenius.trace +
          (copies : ℂ) * data.upperFrobenius.trace := by ring
  lower_root_norm_le :=
    matrixCopies_root_norm_le copies data.lowerFrobenius lowerRadius
      data.lower_root_norm_le
  upper_root_norm_le :=
    matrixCopies_root_norm_le copies data.upperFrobenius upperRadius
      data.upper_root_norm_le

end Erdos157.SawinSpecialization

