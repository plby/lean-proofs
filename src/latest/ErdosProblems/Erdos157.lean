/-- An invariant closed subscheme inherits an automorphism from any ambient
automorphism preserving its ideal sheaf. -/
theorem invariantSubschemeMap_isIso
    {P : Scheme} (I : P.IdealSheafData) (e : P ⟶ P) [IsIso e]
    (hI : I.map e = I) :
    IsIso (invariantSubschemeMap I e hI) := by
  have hIinv : I.map (inv e) = I := by
    calc
